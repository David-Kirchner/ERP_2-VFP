PROCEDURE get_Pcs_soiteminPackingSlip 
PARAMETERS cSOItem, nConn
*get_Pcs_soiteminPackingSlip(pcSOitem,ThisForm.nConnHandle)
PRIVATE nMaxCode

IF VARTYPE(cSOItem) != "C"
	RETURN 0
ENDIF
IF Proper_SO_Item(cSOItem) = Proper_SO_Item("")
	RETURN 0
ENDIF
IF VARTYPE(nConn) != "N"
	RETURN 0
ENDIF

PRIVATE cAlias 
cAlias = ALIAS()
PRIVATE cSQL, nSQLEXEC 

IF USED("tmpPQSL_cntPc_PS")
