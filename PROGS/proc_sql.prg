	IF pConnHandle > 0
		nConn = pConnHandle
	ELSE
		nConn = get_SQLSTRINGCONNECT()
		lNewConn = .T.
	ENDIF
ELSE
	nConn= get_SQLSTRINGCONNECT()
	lNewConn = .T.
ENDIF
