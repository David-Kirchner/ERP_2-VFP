cSQL = cSQL + " WHERE FormNumber = '"+cForm+"'"

SELECT 0
nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_Tol')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_Tol')
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_Tol')
