PRIVATE lAllowDelete , lStockLst, lBrokerLst, lWIPLst, nMaster_ID
lAllowDelete  = .T.
lStockLst = .F.
lBrokerLst = .F.
lWIPLst	= .F.
nMaster_ID = 0


IF nConn > 0
	
	IF USED('tmpPQSL_cntPOiR_Sr')
		USE IN tmpPQSL_cntPOiR_Sr
	ENDIF
	
	cSQL = "SELECT COUNT(*) AS Cntd "
	cSQL = cSQL +" FROM dbo.Receiving R WITH(NOLOCK) "
