PROCEDURE Total_PO 
PARAMETERS nPO, nConn
*Total_PO(nHPAPO,ThisFormSet.nConnHandle)

IF VARTYPE(nPO) != "N"
	RETURN 0
ENDIF
IF VARTYPE(nConn) != "N"
	RETURN 0
ENDIF
IF nPO < 1
	RETURN 0
ENDIF
nConn = CheckSQLConnection(nConn)

PRIVATE cSQL, nSQLEXEC 
PRIVATE cAlias 
cAlias = ALIAS()

IF USED("tmpPQSL_SumPO")
	USE IN tmpPQSL_SumPO
ENDIF
cSQL = "SELECT "
cSQL = cSQL + " CASE WHEN ISNULL(Lotp,0) > 0 THEN Lotp ELSE "
cSQL = cSQL + " CASE WHEN ISNULL(P_LB,0) > 0 AND ISNULL(Order_Qty,0)>0 THEN Order_Qty*P_LB+ISNULL(OtherP,0) ELSE "
cSQL = cSQL + " CASE WHEN ISNULL(P_PC,0) > 0 AND ISNULL(Order_Qty,0)>0 THEN Order_Qty*P_PC+ISNULL(OtherP,0) ELSE"
cSQL = cSQL + " CASE WHEN ISNULL(P_FT,0) > 0 AND ISNULL(Order_Qty,0)>0 THEN Order_Qty*P_FT+ISNULL(OtherP,0) ELSE 0"
cSQL = cSQL + " END END END END AS POiTotal "
cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
cSQL = cSQL + " WHERE HPAPO="+STR(nPO)
cSQL = cSQL + " AND ISNULL(Reconciled,0) = 0"
cSQL = cSQL + " AND ISNULL(Cancelled,0) = 0"

SELECT 0
nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_SumPO')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_SumPO')
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_SumPO')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ENDIF


PRIVATE nReturn
nReturn = 0

IF USED("tmpPQSL_SumPO")
	PRIVATE cTalk
	cTalk = SET('TALK')
	SET TALK OFF
		
	SUM POiTotal TO nReturn

	IF cTalk = "ON"
		SET TALK ON
	ENDIF

	USE IN tmpPQSL_SumPO
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF


RETURN nReturn
ENDPROC

