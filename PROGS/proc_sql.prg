PROCEDURE SetReceivingID_in_Detail 
PARAMETERS cPOitem ,pnID_Detail, nConn, cTBL, pnReceiveID, lCancel
*SetReceivingID_in_Detail( pPOitem, nID_Detail, ThisForm.ConnHandle, 'StockLst', pnReceiveID, .F. )
*Returns ID_Detail

IF VARTYPE(cPOitem) != "C"
	RETURN 0
ENDIF
IF VARTYPE(pnID_Detail) != "N"
	RETURN 0
ENDIF
IF VARTYPE(cTBL) != "C"
	RETURN 0
ENDIF
IF VARTYPE(nConn) != "N"
	RETURN 0
ENDIF
IF VARTYPE(pnReceiveID) != "N"
	pnReceiveID = 0
ENDIF
IF Proper_PO_Item(cPOItem) = Proper_PO_Item("")
	RETURN 0
ENDIF

DO CASE
CASE cTBL = "S"
CASE UPPER(cTBL) = "STOCKLST"
	cTBL = "S"
CASE cTBL = "B"
CASE UPPER(cTBL) = "BROKERLST"
	cTBL = "B"
CASE cTBL = "W"
CASE UPPER(cTBL) = "WIPLST"
	cTBL = "W"
OTHERWISE
	TrackError("Did not get a TBL","cTBL:"+cTBL+". ","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
ENDCASE

IF pnReceiveID = 0
	PRIVATE cMess
	cMess = "POitem:'"+cPOitem+"', ID_Detail:"+ALLTRIM(STR(pnID_Detail))
	DO CASE
	CASE cTBL = "S"
		TrackError("Did not update StockLst_Detail because ReceivingID = 0"+CHR(13)+cMess+". ","Parameter Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
		*TrackError("Problem","message","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	CASE cTBL = "B"
		TrackError("Did not update BrokerLst_Detail because ReceivingID = 0"+CHR(13)+cMess+". ","Parameter Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	CASE cTBL = "W"
		TrackError("Did not update WIPLst_Detail because ReceivingID = 0 and TBL='W'"+CHR(13)+cMess+". ","Parameter Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	OTHERWISE
		TrackError("Did not update because ReceivingID = 0 and TBL=''"+CHR(13)+cMess+". "+PROGRAM() ,"Parameter Error","Prc_SQL:"+PROGRAM(),LINENO())
	ENDCASE

	RETURN 0
ENDIF

nConn = CheckSQLConnection(nConn)

PRIVATE cSQL, nSQLEXEC
cSQL = " "
IF pnID_Detail > 0
	DO CASE
	CASE cTBL = "S"
		cSQL = cSQL + "UPDATE dbo.StockLst_Detail "
	CASE cTBL = "B"
		cSQL = cSQL + "UPDATE dbo.BrokerLst_Detail "
	CASE cTBL = "W"
		cSQL = cSQL + "UPDATE dbo.WIPLst_Detail "
	OTHERWISE
		TrackError("Did not get a TBL","cTBL:"+cTBL,"Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	ENDCASE
	cSQL = cSQL + "	SET ReceivingID = "+STR(pnReceiveID)
	cSQL = cSQL + "	WHERE ID_Detail = "+ALLTRIM(STR(pnID_Detail))
ELSE
	*by cPOitem, add rem Assume only record
	*"	AND M.Heat = 'Due In'"
	
	DO CASE
	CASE cTBL = "S"
		cSQL = cSQL + "UPDATE dbo.StockLst_Detail "
		cSQL = cSQL + "	SET ReceivingID = "+STR(pnReceiveID)
		cSQL = cSQL + "	FROM dbo.StockLst_Detail D "
		cSQL = cSQL + "	INNER JOIN dbo.StockLst_Master M on D.ID = M.ID "
	CASE cTBL = "B"
		cSQL = cSQL + "UPDATE dbo.BrokerLst_Detail "
		cSQL = cSQL + "	SET ReceivingID = "+STR(pnReceiveID)
		cSQL = cSQL + "	FROM dbo.BrokerLst_Detail D "
		cSQL = cSQL + "	INNER JOIN dbo.BrokerLst_Master M on D.ID = M.ID "
	CASE cTBL = "W"
		cSQL = cSQL + "UPDATE dbo.WIPLst_Detail "
		cSQL = cSQL + "	SET ReceivingID = "+STR(pnReceiveID)
		cSQL = cSQL + "	FROM dbo.WIPLst_Detail D "
		cSQL = cSQL + "	INNER JOIN dbo.WIPLst_Master M on D.ID = M.ID "
	OTHERWISE
		TrackError("Did not get a TBL","cTBL:"+cTBL,"Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	ENDCASE	
	cSQL = cSQL + "	WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
	cSQL = cSQL + "	AND M.Heat = 'DUE IN'"
	
ENDIF
nSQLEXEC = SQLEXEC(nConn, cSQL )

DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL )
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL,nConn,nSQLEXEC )
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ENDIF

IF pnID_Detail = 0
	PRIVATE cAlias 
	cAlias = ALIAS()

	IF USED('tmpPQSL_ID_Detail')
		USE IN tmpPQSL_ID_Detail
	ENDIF
	SELECT 0


	cSQL = "SELECT ID_Detail "
	DO CASE
	CASE cTBL = "S"
		cSQL = cSQL + " FROM dbo.StockLst_Detail WITH(NOLOCK) "
	CASE cTBL = "B"
		cSQL = cSQL + " FROM dbo.BrokerLst_Detail WITH(NOLOCK) "
	CASE cTBL = "W"
		cSQL = cSQL + " FROM dbo.WIPLst_Detail WITH(NOLOCK) "
	ENDCASE
	cSQL = cSQL + "	WHERE ReceivingID = "+STR(pnReceiveID)

	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_ID_Detail' )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_ID_Detail' )
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_ID_Detail')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ENDIF
	
	IF USED('tmpPQSL_ID_Detail')
		IF RECCOUNT('tmpPQSL_ID_Detail') > 0
			PRIVATE nID_Detail
			nID_Detail = 0
			SCAN
				nID_Detail = PrepareSQLnum(tmpPQSL_ID_Detail.ID_Detail,'ID_Detail',-3)
				IF nID_Detail = pnID_Detail
					EXIT
				ENDIF
			ENDSCAN
			*Set ID_Detail to new number
			IF nID_Detail <> pnID_Detail
				IF nID_Detail > 0
					pnID_Detail = nID_Detail
				ENDIF
			ENDIF
		ENDIF
			
		USE IN tmpPQSL_ID_Detail
	ENDIF


	IF NOT EMPTY(cAlias)
		IF USED(cAlias)
			SELECT (cAlias)
		ELSE
			RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
		ENDIF
	ENDIF

ENDIF

RETURN pnID_Detail 
ENDPROC
