*Returns True or False 
*IF Cncld OR Cmplt = .F.
*IF ShopRecv = .T.
*IF NOT ShopRecv AND lPrinted AND lChanging = .T. 
*IF NOT ShopRecv AND lPrinted AND NOT lChanging = .F. ????
			
IF VARTYPE(pSalesNum) != "N"
	RecordError( 0, 'PARAMETERS ', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"VFP message: No salesnum Parameter" )
	RETURN .F.
ENDIF
IF pSalesNum < 1
	RecordError( 0, 'PARAMETERS ', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"VFP message: Bad salesnumParameter" )
	RETURN .F.
ENDIF
IF VARTYPE(nConn) != "N"
	RecordError( 0, 'PARAMETERS ', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"VFP message: No nConn Parameter" )
	RETURN .F.
ENDIF

nConn = CheckSQLConnection(nConn)
PRIVATE cSQL, nSQLEXEC
PRIVATE cAlias 
cAlias = ALIAS()

PRIVATE lCncld, lCmplt, lEverPrint, lPrinted, lChanging, lShopRecv, lOK
lCncld	= .F.
lCmplt	= .F.
lEverPrint = .F.
lPrinted = .F.
lChanging = .F.
lShopRecv = .F.
lOK = .T.

IF USED('procSales_No')
	USE IN procSales_No
ENDIF
SELECT 0

*Check status!
cSQL = "SELECT ISNULL(EverPrint,0) AS EverPrint "
cSQL = cSQL + ",ISNULL(PrintedSO,0) AS PrintedSO "
cSQL = cSQL + ",ISNULL(Changing,0) AS Changing "
cSQL = cSQL + ",ISNULL(ShopRecv,0) AS ShopRecv "
cSQL = cSQL + ",ISNULL(cncld,0) AS Cncld"
cSQL = cSQL + ",ISNULL(cmplt,0) AS Cmplt"
cSQL = cSQL + " FROM dbo.Sales_No WITH(NOLOCK) "
cSQL = cSQL + " WHERE SalesNum = "+STR(pSalesNum)

nSQLEXEC = SQLEXEC( nConn, cSQL, 'procSales_No' )

DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'procSales_No' )
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL, nConn, nSQLEXEC,'procSales_No' )
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	lOK = .F.
ENDIF

IF USED('procSales_No')
	IF RECCOUNT('procSales_No') > 0
		lEverPrint = PrepareSQLlogic(procSales_No.EverPrint,'EverPrint',.F.)
		lPrinted = PrepareSQLlogic(procSales_No.PrintedSO,'PrintedSO',.F.)
		lChanging = PrepareSQLlogic(procSales_No.Changing,'Changing',.F.)
		lShopRecv = PrepareSQLlogic(procSales_No.ShopRecv,'ShopRecv',.F.)
		lCncld = PrepareSQLlogic(procSales_No.Cncld,'Cncld',.F.)
		lCmplt = PrepareSQLlogic(procSales_No.Cmplt,'Cmplt',.F.)
	ENDIF
	
	USE IN procSales_No
ENDIF


IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.", "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

PRIVATE lAllowAmend
lAllowAmend = .F.

*Changing should remove a Printed or ShopRecv
IF lCncld
	*Do not Amend a Cancelled SO
	lAllowAmend = .F.
	RecordTest("Is_Amendment_Allowed SalesNum = "+STR(pSalesNum), "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Ammend Cancelled SO? "+STR(pSalesNum))
	
ELSE
	IF lCmplt 
		*Do not Amend a Complete SO
		lAllowAmend = .F.
		RecordTest("Is_Amendment_Allowed SalesNum = "+STR(pSalesNum)+ ", lAllowAmend = .F. *Do not Amend a Complete SO", "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Ammend Completed SO? "+STR(pSalesNum))
		
	ELSE
		IF lShopRecv 
			*An Sales_No update would require new Amendment number
			lAllowAmend = .T.
		ELSE
			*lEverPrint, lPrinted
			IF lEverPrint AND NOT lPrinted &&testing for Is_Amendment_Allowed and it has been printed 
				*would be marked as Changing=1 and Printed=0 in Set_Sales_No_Changing.
				IF lChanging 
					*has already been in Change mode!
					lAllowAmend = .T.
				ELSE
					*Not Changing after Printed
					lAllowAmend = .F.
				ENDIF
			ELSE
				IF NOT lPrinted 
					* NOT ShopRecv, NOT Printed, nothing to revise
					lAllowAmend = .T.
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF


RETURN lAllowAmend
ENDPROC

