PROCEDURE WhereIsStockNow 
PARAMETERS cStockTable, nID_Master, nReceivingID, nConn
*cStockID = WhereIsStockNow(cStockTable, nID_Master, nReceivingID, ThisForm.nConnHandle)
*RETURNS TableName CHAR(2), ID STR(10), CHR(1), ID_Detail STR(10)

IF VARTYPE(cStockTable) != "C"
	RETURN ''
ENDIF
IF VARTYPE(nID_Master) != "N"
	RETURN ''
ENDIF
IF VARTYPE(nReceivingID) != "N"
	RETURN ''
ENDIF
IF VARTYPE(nConn) != "N"
	RETURN ''
ENDIF
nConn = CheckSQLConnection(nConn)
PRIVATE cAlias 
cAlias = ALIAS()

IF USED('tmpPQSL_CheckTable')
	USE IN tmpPQSL_CheckTable
ENDIF

PRIVATE cCurrTable, nID, nID_Detail, cStockID
cCurrTable	= ''
nID			= 0
nID_Detail	= 0
cStockID	= ''

PRIVATE cSQL, nSQLEXEC


IF nID_Master = 0
	*Forget checking by ID
	*Look for records by ReceivingID only
	IF nReceivingID > 0
	
		cSQL = "            SELECT 'S ' AS [Tbl], ID, ID_Detail FROM dbo.StockLst_Detail WITH(NOLOCK) WHERE ReceivingID ="+STR(nReceivingID)
		cSQL = cSQL+" UNION SELECT 'SH' AS [Tbl], ID, ID_Detail FROM dbo.[AR.StockLst_Detail_History] WITH(NOLOCK) WHERE ReceivingID ="+STR(nReceivingID)
		cSQL = cSQL+" UNION SELECT 'S ' AS [Tbl], ID, ID_Detail FROM dbo.BrokerLst_Detail WITH(NOLOCK) WHERE ReceivingID ="+STR(nReceivingID)
		cSQL = cSQL+" UNION SELECT 'BH' AS [Tbl], ID, ID_Detail FROM dbo.[AR.BrokerLst_Detail_History] WITH(NOLOCK) WHERE ReceivingID ="+STR(nReceivingID)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CheckTable')

		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CheckTable')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,nConn,nSQLEXEC, 'tmpPQSL_CheckTable')	
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF

		IF USED('tmpPQSL_CheckTable')
			IF VARTYPE(tmpPQSL_CheckTable.ID_Detail) = "N"
				LOCATE FOR TBL = "S "
				IF FOUND()
					cCurrTable	= tmpPQSL_CheckTable.TBL
					nID			= tmpPQSL_CheckTable.ID
					nID_Detail	= tmpPQSL_CheckTable.ID_Detail
					USE IN tmpPQSL_CheckTable
					RETURN cCurrTable+STR(nID,10)+"."+STR(nID_Detail,10)
				ENDIF
				LOCATE FOR TBL = "SH"
				IF FOUND()
					cCurrTable	= tmpPQSL_CheckTable.TBL
					nID			= tmpPQSL_CheckTable.ID
					nID_Detail	= tmpPQSL_CheckTable.ID_Detail
					USE IN tmpPQSL_CheckTable
					RETURN cCurrTable+STR(nID,10)+"."+STR(nID_Detail,10)
				ENDIF
				LOCATE FOR TBL = "B "
				IF FOUND()
					cCurrTable	= tmpPQSL_CheckTable.TBL
					nID			= tmpPQSL_CheckTable.ID
					nID_Detail	= tmpPQSL_CheckTable.ID_Detail
					USE IN tmpPQSL_CheckTable
					RETURN cCurrTable+STR(nID,10)+"."+STR(nID_Detail,10)
				ENDIF
				LOCATE FOR TBL = "BH"
				IF FOUND()
					cCurrTable	= tmpPQSL_CheckTable.TBL
					nID			= tmpPQSL_CheckTable.ID
					nID_Detail	= tmpPQSL_CheckTable.ID_Detail
					USE IN tmpPQSL_CheckTable
					RETURN cCurrTable+STR(nID,10)+"."+STR(nID_Detail,10)
				ENDIF
				
			ENDIF
		ENDIF
	ENDIF
ENDIF
IF NOT EMPTY(cCurrTable) AND nID > 0 AND nID_Detail > 0
	RETURN cCurrTable+STR(nID,10)+"."+STR(nID_Detail,10)
ENDIF

IF cStockTable = "S"
	cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.StockLst_Master WHERE ID ="+STR(nID_Master)
	SELECT 0
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CheckTable')

	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CheckTable')
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL,nConn,nSQLEXEC, 'tmpPQSL_CheckTable')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ENDIF

	IF USED('tmpPQSL_CheckTable')
		IF VARTYPE(tmpPQSL_CheckTable.CNTD) = "N"
			IF tmpPQSL_CheckTable.CNTD > 0
				*Found ID live in StockLst
				nID = nID_Master
				
				*Check for Live ID_Detail
				IF USED('tmpPQSL_CheckTable2')
					USE IN tmpPQSL_CheckTable2
				ENDIF
				SELECT 0
				
				cSQL = "SELECT TOP 1 ID_Detail FROM dbo.StockLst_Detail WITH(NOLOCK) WHERE ID ="+STR(nID_Master)+" AND ReceivingID="+STR(nReceivingID) 
				
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CheckTable2')
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CheckTable2')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,nConn,nSQLEXEC, 'tmpPQSL_CheckTable2')
					RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
				ENDIF
				
				IF USED('tmpPQSL_CheckTable2')
					IF VARTYPE(tmpPQSL_CheckTable2.ID_Detail) = "N"
						IF tmpPQSL_CheckTable2.ID_Detail > 0
							nID_Detail = tmpPQSL_CheckTable2.ID_Detail
							cCurrTable = "S "
						ENDIF
					ENDIF
					USE IN tmpPQSL_CheckTable2
				ENDIF
				
				IF nID_Detail = 0
					*Check History
					IF USED('tmpPQSL_CheckTable2')
						USE IN tmpPQSL_CheckTable2
					ENDIF
					SELECT 0
						
					cSQL = "SELECT TOP 1 ID_Detail FROM dbo.[AR.StockLst_Detail_History] WITH(NOLOCK) WHERE ID ="+STR(nID_Master)+" AND ReceivingID="+STR(nReceivingID) 
					
					nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CheckTable2')
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CheckTable2')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,nConn,nSQLEXEC, 'tmpPQSL_CheckTable2')
						RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
					ENDIF
						
					IF USED('tmpPQSL_CheckTable2')
						IF VARTYPE(tmpPQSL_CheckTable2.ID_Detail) = "N"
							IF tmpPQSL_CheckTable2.ID_Detail > 0
								nID_Detail = tmpPQSL_CheckTable2.ID_Detail
								cCurrTable = "SH"
							ENDIF
						ENDIF
						USE IN tmpPQSL_CheckTable2
					ENDIF
					
				ENDIF
				
			ENDIF
		ENDIF
		USE IN tmpPQSL_CheckTable
	ELSE
		*Check History	
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.[AR.StockLst_Master_History] WITH(NOLOCK) WHERE ID ="+STR(nID_Master)
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CheckTable')

		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CheckTable')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,nConn,nSQLEXEC, 'tmpPQSL_CheckTable')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF

		IF USED('tmpPQSL_CheckTable')
			IF VARTYPE(tmpPQSL_CheckTable.CNTD) = "N"
				IF tmpPQSL_CheckTable.CNTD > 0
					*Found ID in StockLst_Master_History
					nID = nID_Master
				
					*Check for ID_Detail
					IF USED('tmpPQSL_CheckTable2')
						USE IN tmpPQSL_CheckTable2
					ENDIF
					SELECT 0
					
					cSQL = "SELECT TOP 1 ID_Detail FROM dbo.[AR.StockLst_Detail_History] WITH(NOLOCK) WHERE ID ="+STR(nID_Master)+" AND ReceivingID="+STR(nReceivingID) 
					
					nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CheckTable2')
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CheckTable2')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,nConn,nSQLEXEC, 'tmpPQSL_CheckTable2')
						RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
					ENDIF
					
					IF USED('tmpPQSL_CheckTable2')
						IF VARTYPE(tmpPQSL_CheckTable2.ID_Detail) = "N"
							IF tmpPQSL_CheckTable2.ID_Detail > 0
								nID_Detail = tmpPQSL_CheckTable2.ID_Detail
								cCurrTable = "SH"
							ENDIF
						ENDIF
						USE IN tmpPQSL_CheckTable2
					ENDIF
				ENDIF
			ENDIF
			USE IN tmpPQSL_CheckTable
		ENDIF
				
				
	ENDIF
ENDIF

IF NOT EMPTY(cCurrTable) AND nID > 0 AND nID_Detail > 0
	RETURN cCurrTable+STR(nID,10)+"."+STR(nID_Detail,10)
