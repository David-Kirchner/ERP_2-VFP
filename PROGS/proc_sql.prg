*************************************
PRIVATE cSQLAcct, nCostValue, nID_Detail
cSQLAcct = "SELECT Dim1, Dim2, Dim3, CostValue, ID_Detail FROM dbo.StockLst_Detail WITH(NOLOCK) WHERE ID_Detail = "+ALLTRIM(STR( pID_Detail ))
nID_Detail = pID_Detail

nCostValue = 1

IF USED("tmpPQSL_Detail_details")
	USE IN tmpPQSL_Detail_details
ENDIF

SELECT 0
nSQLEXEC = SQLEXEC( nConn, cSQLAcct, 'tmpPQSL_Detail_details' )
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC(nConn, cSQLAcct, 'tmpPQSL_Detail_details' )
ENDDO
IF nSQLEXEC < 0 &&Try again!
	nSQLEXEC = SQLEXEC(nConn, cSQLAcct, "tmpPQSL_Detail_details")
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL 2' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQLAcct, "tmpPQSL_Detail_details")

		IF nSQLEXEC < 0
			IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
				nSQLEXEC = 0
			ENDIF
		ENDIF
	ENDDO
ENDIF
IF nSQLEXEC < 0
	IF NOT SQLEXECError(cSQLAcct,nConn,nSQLEXEC, 'tmpPQSL_Detail_details')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQLAcct )
		lWriteOff = .F.
	ENDIF
ENDIF

IF USED("tmpPQSL_Detail_details")
	IF RECCOUNT("tmpPQSL_Detail_details") > 0
		SELECT tmpPQSL_Detail_details
		IF tmpPQSL_Detail_details.ID_Detail = nID_Detail
		
			nDim1 = IIF(ISNULL(tmpPQSL_Detail_details.Dim1),0,tmpPQSL_Detail_details.Dim1)
			nDim2 = IIF(ISNULL(tmpPQSL_Detail_details.Dim2),0,tmpPQSL_Detail_details.Dim2)
			nDim3 = IIF(ISNULL(tmpPQSL_Detail_details.Dim3),0,tmpPQSL_Detail_details.Dim3)
			nCostValue = IIF(ISNULL(tmpPQSL_Detail_details.CostValue),0,tmpPQSL_Detail_details.CostValue)
			
			IF nDim1 = 0 
				MESSAGEBOX("Accounting Costing will not work without a First Dimmention!",16,"AccountingCosting")
				RETURN -3
			ENDIF
			IF nDim2 = 0
				IF usesForm_Dim2(cForm, nConn)
					MESSAGEBOX("Accounting Costing will not work without the Second dimmention!",16,"AccountingCosting")
					RETURN -3
				ENDIF
			ENDIF
			
			*Does Item Have Value?

			IF nCostValue > 0  &&Has a value to Write off
			
				*Get cForm From Master
				*Get cAlloy From Master
				IF cAlloy = "6B" OR cAlloy = "6BH" 
					IF cForm = "10"
						DO CASE
						CASE nDim1 <= 1
							IF nDim2 < 12
								lWriteOff = .T.
							ENDIF
						CASE nDim1 > 1 AND nDim1 <= 6
							IF nDim2 < 3
								lWriteOff = .T.
							ENDIF
						CASE nDim1 > 6
							IF nDim2 < 1
								lWriteOff = .T.
							ENDIF
						ENDCASE
					ENDIF
					IF cForm = "40"
						IF nDim2 < 1 OR nDim3 < 1
							lWriteOff = .T.
						ENDIF
						IF nDim2 * nDim3 < 10
							lWriteOff = .T.
						ENDIF
					ENDIF
				ELSE &&Not 6B or 6BH
					IF cForm = "10"
						DO CASE
						CASE nDim1 <= 1
							IF nDim2 < 48
								lWriteOff = .T.
							ENDIF
						CASE nDim1 > 1 AND nDim1 <= 6
							IF nDim2 < 24
								lWriteOff = .T.
							ENDIF
						CASE nDim1 > 6
							IF nDim2 < 6
								lWriteOff = .T.
							ENDIF
						ENDCASE
						IF NOT lWriteOff 
							*IF Item was Bought for order check to see if drops are to be written against order
							IF NOT ( ISNULL(cPOitem) AND ISNULL(pSOitem) )
								*Check Purchased for this order
								IF Purchased4Order( cPOitem, pSOitem, nConn )
									lWriteOff = PurchasedWriteOff( cAlloy, cForm, nDim1 )
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					IF cForm = "40"
						IF nDim2 < 2 OR nDim3 < 2
							lWriteOff = .T.
						ENDIF
						IF ( nDim2 * nDim3 ) < 144
							lWriteOff = .T.
						ENDIF
						IF NOT lWriteOff 
							IF NOT ISNULL(cPOitem) OR NOT ISNULL(pSOitem) 
								*Check Purchased for this order
								IF Purchased4Order( cPOitem, pSOitem, nConn )
									lWriteOff = PurchasedWriteOff( cAlloy, cForm, nDim1 )
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ELSE &&No value to write Down
				lWriteOff = .F.
			ENDIF
		ELSE
		
			IF USED("tmpPQSL_Detail_details")
				USE IN tmpPQSL_Detail_details
			ENDIF

			*nID_Detail Not Found!
			lWriteOff = .F.
			RETURN -4
		ENDIF
	ELSE
	
		IF USED("tmpPQSL_Detail_details")
			USE IN tmpPQSL_Detail_details
		ENDIF	
	
		*nID_Detail Not Found!
		lWriteOff = .F.
		RETURN -4
	ENDIF
ENDIF


IF USED("tmpPQSL_Detail_details")
	USE IN tmpPQSL_Detail_details
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.", "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

IF lCloseConn
	SQLDISCONNECT( nConn )
ENDIF

IF lWriteOff 
	IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
	ENDIF
	TrackMess( "AccountingCosting: Wrote off Stock. ID:"+ALLTRIM(STR(pID))+" ID_Detail:"+ALLTRIM(STR(pID_Detail))+" CostValue was "+ALLTRIM(STR(nCostValue))+" Alloy:"+cAlloy+" Form:"+cForm+" Dim1:"+ALLTRIM(STR(nDim1))+" Dim2:"+ALLTRIM(STR(nDim2))+" Dim3:"+ALLTRIM(STR(nDim3))+" "+CHR(13)+SYS(16,1) )
	RETURN 0
ELSE
	RETURN 1
ENDIF
ENDPROC

