*********
*Compare Sales Order item to Ship.
* nPastPCs, nPastWeight
* nSoldPCs, nSoldWeight, nSold_QTY
* pnPCs, pnQTY, pnWeight

IF nSold_QTY > 0	&&No PastQTY to use
	IF (nSold_QTY+10)*1.15 >= (pnQTY+nPastQTY +10) AND (pnQTY+nPastQTY +10)*1.15 >= (nSold_QTY+10)
		lis_SOitem_Complete =.T.
	ENDIF
ENDIF
*********
IF NOT lis_SOitem_Complete
	IF (nSoldWeight+10)*1.15 >= (pnWeight+nPastWeight +10) AND (pnWeight+nPastWeight +10)*1.15 >= (nSoldWeight+10)
		lis_SOitem_Complete =.T.
	ENDIF
ENDIF
*********

*********
IF NOT lis_SOitem_Complete
	IF nSoldPCs > 0 AND nPastPCs = 0
		IF (nSoldPCs+10)*1.15 >= (pnPCs+10) AND (pnPCs+10)*1.15 >= (nSoldPCs+10)
			lis_SOitem_Complete =.T.
		ENDIF
	ENDIF
ENDIF
*********
IF NOT lis_SOitem_Complete
	IF nSoldPCs > 0
		IF (nSoldPCs+10)*1.15 >= (pnPCs+nPastPCs +10) AND (pnPCs+nPastPCs +10)*1.15 >= (nSoldPCs+10)
			lis_SOitem_Complete =.T.
		ENDIF
	ENDIF
ENDIF
**********

PRIVATE cMess
cMess = "Proc_SQL:is_SOitem_Complete is "+IIF(lis_SOitem_Complete,'True','False')+" "+CHR(13)
cMess = cMess + "pcSOitem='"+pcSOitem+"' pnPS_No="+STR(pnPS_No)+" "+CHR(13)
cMess = cMess + "nSold_QTY="+STR(nSold_QTY)+" pnQTY="+STR(pnQTY)+" nPastQTY ="+STR(nPastQTY)+" "+CHR(13)
cMess = cMess + "nSoldWeight="+STR(nSoldWeight)+" pnWeight="+STR(pnWeight)+" nPastWeight="+STR(nPastWeight)+" "+CHR(13)
cMess = cMess + "nSoldPCs="+STR(nSoldPCs)+" pnPCs="+STR(pnPCs)+" nPastPCs="+STR(nPastPCs)+" "+CHR(13)
TrackMess(cMess+" "+CHR(13)+SYS(16,1))


RETURN lis_SOitem_Complete 
ENDPROC
