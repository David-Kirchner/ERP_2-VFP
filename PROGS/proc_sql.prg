PROCEDURE UpdateQuotesCustomerID 
PARAMETERS pcCompany, pcCustomerID, pConnHandle

*UpdateQuotesCustomerID(SalesQuote.company,cCustomerID,ThisForm.nConnHandle)  
IF VARTYPE(pcCompany) != "C"
	RETURN .F.
ENDIF
IF VARTYPE(pcCustomerID) != "C"
	RETURN .F.
ENDIF

PRIVATE cCompany, cCustomerID
cCompany	= PrepareSQLtxt(pcCompany,'Company',30)
cCustomerID	= PrepareSQLtxt(pcCustomerID,'CustomerID',20)

IF EMPTY(cCompany) OR EMPTY(cCustomerID)
	RETURN .F.
ENDIF

IF cCustomerID='1STCUT'
	RETURN .F.
ENDIF

IF LEN(pcCompany) < 3
	MESSAGEBOX( "Company name must be at least 3 characters long to be used with CustomerID",0+16,"Bad Company!")
	RETURN .F.
ENDIF

PRIVATE nConn, lNewConn, cSQL, cSQL2, lPass
lNewConn = .F.
lPass = .T.

IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
		nConn = pConnHandle
	ELSE
		nConn = get_SQLSTRINGCONNECT()
		lNewConn = .T.
	ENDIF
ELSE
	nConn = get_SQLSTRINGCONNECT()
	lNewConn = .T.
ENDIF
nConn = CheckSQLConnection(nConn)

IF nConn > 0
	cSQL = "UPDATE dbo.AllQuotes SET CustID='"+cCustomerID+"'"
	cSQL = cSQL + " WHERE Company = '"+cCompany+"'"
	
	nSQLEXEC = SQLEXEC(nConn, cSQL )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn,  cSQL)
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL, nConn, nSQLEXEC )
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		lPass = .F.
	ENDIF
	
	IF lPass
		cSQL2= "UPDATE dbo.QuickCompany SET Customer='"+cCustomerID+"'"
		cSQL2= cSQL2+ " WHERE Company = '"+cCompany+"'"
		
		nSQLEXEC = SQLEXEC(nConn, cSQL2)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn,  cSQL2)
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL2, nConn, nSQLEXEC )
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL2)
			lPass = .F.
		ENDIF
	ENDIF

	IF lNewConn 
		SQLDISCONNECT(nConn )
	ENDIF
ELSE
	*Error on Connection String
	TrackError("Could not Connect to SQL","Error on Connection String","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	lPass = .F.
ENDIF

IF lPass
	RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Proc_SQL:UpdateQuotesCustomerID "+CHR(10)+CHR(13)+cSQL+CHR(10)+CHR(13)+cSQL2) 
ENDIF

RETURN lPass
ENDPROC


