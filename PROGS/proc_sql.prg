*? SOitem_PRCD(' 114212-03')
*Return True if SOitem has a PRCD

IF VARTYPE(cSOitem) != "C"
	RecordError( 0, 'PARAMETERS ', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"VFP message: No cSOitem Parameter" )
	RETURN .F.
ENDIF

IF VARTYPE(nConn) != "N"
	RecordError( 0, 'PARAMETERS ', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"VFP message: No nConn Parameter" )
	RETURN .F.
ENDIF
IF Proper_SO_Item(cSOItem) = Proper_SO_Item("")
	RecordError( 0, 'PARAMETERS ', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"VFP message: Bad cSOitem Parameter" )
	RETURN .F.
ENDIF

nConn = CheckSQLConnection(nConn)
PRIVATE cAlias 
cAlias = ALIAS()
PRIVATE cSQL, nSQLEXEC 

PRIVATE nCntSOitemShipped
nCntSOitemShipped = 0
PRIVATE lReturn
lReturn = .F.

IF USED('tmpPQSL_SOshipped')
	USE IN tmpPQSL_SOshipped
ENDIF

cSQL = "SELECT COUNT(*) AS CNTD "
cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
cSQL = cSQL + " AND ("
cSQL = cSQL + " ISNULL([cmplt],0) = 1"    &&Complete
cSQL = cSQL + " OR ISNULL([pckd],0) = 1"  &&Packaged
cSQL = cSQL + " OR ISNULL([prcd],0) = 1"  &&Processing Done
cSQL = cSQL + " )"

SELECT 0
nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_SOshipped')

DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_SOshipped' )
ENDDO
IF nSQLEXEC < 0
	IF NOT SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_SOshipped' )
		RecordError(nSQLEXEC,"SQL Error" ,"Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(1),cSQL )
	ENDIF
ENDIF

IF USED('tmpPQSL_SOshipped')
	IF tmpPQSL_SOshipped.CNTD > 0
		nCntSOitemShipped = tmpPQSL_SOshipped.CNTD
		*lReturn = .T. &&Not yet
	ENDIF
	USE IN tmpPQSL_SOshipped
ENDIF

IF nCntSOitemShipped > 0
	*Complete or Process Done
	IF USED('tmpPQSL_SOshipped')
		USE IN tmpPQSL_SOshipped
	ENDIF
	
	cSQL = "SELECT [cncld],[cmplt],[pckd],[prcp],[prcd] "
	cSQL = cSQL + " ,RMA_No, RMA_Detail "
	cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
	cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
	
	SELECT 0
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_SOshipped')

	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_SOshipped' )
	ENDDO
	IF nSQLEXEC < 0
		IF NOT SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_SOshipped' )
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		ENDIF
	ENDIF
	
	PRIVATE cMess
	cMess = ''
	PRIVATE nRMA_No, nRMA_Detail
	nRMA_No = 0 
	nRMA_Detail = 0
		
	IF USED('tmpPQSL_SOshipped')
		IF RECCOUNT('tmpPQSL_SOshipped') > 0
			nRMA_No = PrepareSQLnum(tmpPQSL_SOshipped.RMA_No,'RMA_No',-3)
			nRMA_Detail = PrepareSQLnum(tmpPQSL_SOshipped.RMA_Detail,'RMA_Detail',-3)
			IF nRMA_No + nRMA_Detail > 0	&& allow Cancel if RMA
				cMess = "SOitem '"+cSOitem+"' is allowed to be cancelled with "+CHR(13)+"RMA = "+ALLTRIM(STR(nRMA_No))+"  RMA_Detail = "+ALLTRIM(STR(nRMA_Detail))
			ELSE
				cMess = "Cannot change this SOitem:"+cSOitem+CHR(13)
				cMess = cMess + "Cancelled="+IIF(tmpPQSL_SOshipped.cncld,'T','F')+CHR(13)
				cMess = cMess + "Complete="+IIF(tmpPQSL_SOshipped.cmplt,'T','F')+CHR(13)
				cMess = cMess + "Packed="+IIF(tmpPQSL_SOshipped.pckd,'T','F')+CHR(13)
				cMess = cMess + "In Process="+IIF(tmpPQSL_SOshipped.prcp,'T','F')+CHR(13)
				cMess = cMess + "Process Done="+IIF(tmpPQSL_SOshipped.prcd,'T','F')+CHR(13)
			ENDIF
		ENDIF
		USE IN tmpPQSL_SOshipped
	ENDIF

	IF LEN(ALLTRIM(cMess)) = 0
		cMess = "Cannot change this!"+CHR(13)+"SO-item '"+cSOitem+"' "
	ENDIF
	
	*lReturn = .T.	&&Found a PRCD
	IF nRMA_No + nRMA_Detail > 0
		IF MESSAGEBOX("Do you want Cancel because it has an RMA?",4+32,"Cancel?") = 6
			lReturn = .F.
		ELSE
			lReturn = .T.
		ENDIF
	ELSE
		IF HaveSOCancelPermission(VAL(cSOitem))
		*IF HaveSODeletePermission(VAL(cSOitem))
		*	IF MESSAGEBOX("Do you want to use your Administrator rights to force a Cancel?"+CHR(13)+CHR(13)+"Normal users could not cancel this order."+CHR(13)+CHR(13)+cMess,4+32,"Force Cancel?") = 6
				lReturn = .F. &&Did not Find a PRCD, Allow Cancell
		*	ELSE
		*		MESSAGEBOX(cMess,0+48,"Not Allowed to change now!")
		*		lReturn = .T.
		*	ENDIF
		ENDIF
	ENDIF
ENDIF

