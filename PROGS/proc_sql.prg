PROC PurchaseOrder_POitem_Delete 
PARAMETER cPOitem, pConnHandle, cSOitem

*PurchaseOrder_POitem_Delete( cPOitem, ThisForm.nConnhandle, cSOitem ) 

IF VARTYPE(cPOitem) != "C"
	cPOitem = ""
ENDIF
IF EMPTY(cPOitem)
	RETURN .F.
ENDIF
IF Proper_PO_Item(cPOItem) = Proper_PO_Item("")
	RETURN .F.
ENDIF

IF VARTYPE(cSOitem) != "C"
	cSOitem = ""
ENDIF

PRIVATE lDeleteStockLst
lDeleteStockLst = .T.
**Check cSOitem.  What does SOitem have to do with Stock and lDeleteStockLst?
IF Proper_SO_Item(cSOitem) = Proper_SO_Item('')
	IF Proper_PO_Item(cPOItem) = Proper_PO_Item("")
		RETURN .F.
	ENDIF
	IF LEFT(ALLTRIM(cPOitem),2) = '0-'
		RETURN .F.
	ENDIF
ELSE
	*have SOitem
	IF Proper_PO_Item(cPOItem) = Proper_PO_Item('')
		lDeleteStockLst = .F.
	ENDIF
	IF LEFT(ALLTRIM(cPOitem),2) = '0-'
		lDeleteStockLst = .F.
	ENDIF
ENDIF

PRIVATE cSQL, nConn
IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
		nConn = pConnHandle
	ELSE
		nConn = get_SQLSTRINGCONNECT()
	ENDIF
ELSE
	nConn = get_SQLSTRINGCONNECT()
	pConnHandle = 0
ENDIF
nConn = CheckSQLConnection(nConn)

PRIVATE cAlias 
cAlias = ALIAS()

PRIVATE lAllowDelete , lStockLst, lBrokerLst, nMaster_ID
lAllowDelete  = .T.
lStockLst = .F.
lBrokerLst = .F.
nMaster_ID = 0


IF nConn < 1
	*Error on Connection String
	TrackError("Could not Connect to SQL","Error on Connection String","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	lAllowDelete  = .F.
	RETURN lAllowDelete  
ENDIF


IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

*Check to see if person has Permission

IF NOT AllowAdminPODelete()
	PRIVATE cMach_User, cUserName
	cMach_User = SYS(0)
	cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
	PRIVATE cSalesP, cCoverP
	cSalesP = ''
	cCoverP = ''
	
	IF USED('tmpPQSL_POSalesP')
		USE IN tmpPQSL_POSalesP
	ENDIF
	cSQL = "SELECT SalesP, Cover FROM dbo.PurchaseOrder WITH(NOLOCK) "
	cSQL = cSQL + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
	IF NOT Proper_SO_Item(cSOitem) = Proper_SO_Item('')
		cSQL = cSQL + " OR SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
	ENDIF
		

	SELECT 0
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_POSalesP' )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_POSalesP' )
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_POSalesP' )
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		lAllowDelete  = .F.
	ENDIF
	IF USED('tmpPQSL_POSalesP')
		IF RECCOUNT('tmpPQSL_POSalesP') > 0
			cSalesP = PrepareSQLtxt(tmpPQSL_POSalesP.SalesP,'SalesP',1)
			cCoverP = PrepareSQLtxt(tmpPQSL_POSalesP.Cover,'Cover',1)
		ENDIF
		USE IN tmpPQSL_POSalesP
	ENDIF

	PRIVATE cPOUserName, cPOCoverName
	cPOUserName = ALLTRIM(AppSetup_Get_UserName(cSalesP))
	cPOCoverName = ALLTRIM(AppSetup_Get_UserName(cCoverP))
	
	IF LEN(cSalesP) > 0	
		IF cSalesP = '0'
			lAllowDelete  = .T.
			*PO has no owner!
		ELSE
			IF UPPER(cUserName) != UPPER(cPOUserName)
				*Login is not same as PO SalesP
				IF UPPER(cUserName) = UPPER(cPOCoverName)
					*The Cover SalesP is allowed to Delete
				ELSE
					cMess = "PO Item "+ALLTRIM(cPOitem)+" was written by SalesP:"+cSalesP+", "+cPOUserName+"'"
					IF LEN(cPOCoverName) > 0
						cMess = cMess +CHR(13)+" and Covered by:"+cCoverP+", "+cPOCoverName+"'"
					ENDIF

					MESSAGEBOX(cMess+"You are logged in as "+ALLTRIM(cUserName)+" !"+CHR(13)+"You cannot delete!",0+16,"Cannot delete this PO Item")
					lAllowDelete  = .F.
					TrackMess(cMess+CHR(13)+", You are logged in as "+ALLTRIM(cUserName)+", You cannot delete!"+" "+CHR(13)+SYS(16,1))
				ENDIF
			ELSE
				*Login matches PO SalesP - great
			ENDIF
		ENDIF
	ELSE
		*No SalesP
		*PO has no owner!
	ENDIF
ENDIF

IF NOT lAllowDelete  
	*Check to see if received
	PRIVATE nCntPOitemR, nCntSOitemR
	nCntPOitemR = Count_POitem_Receiving( cPOitem, nConn, "NotCancelled" )
	nCntSOitemR = Count_SOitem_Receiving( cSOitem, nConn, "NotCancelled" )

	IF nCntPOitemR > 0
		MESSAGEBOX("PO Item "+ALLTRIM(cPOitem)+" has already been received!"+CHR(13)+"Cannot delete!",0+16,"Cannot delete this PO Item")
		TrackMess("POItem '"+cPOitem+"' has already been received!"+" Cannot delete this PO Item"+" "+CHR(13)+SYS(16,1))
		lAllowDelete  = .F.
	ENDIF
	IF NOT lAllowDelete  
		IF nCntSOitemR > 0
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"SOItem '"+cSOitem+"' is connected to this POitem '"+cPOitem+"' and has already been received! POitem is being Deleted.")
		ENDIF
	ENDIF
ENDIF


IF lDeleteStockLst
	IF lAllowDelete  
		*Check StockLst for PO item
		IF USED('tmpPQSL_CntStk')
			USE IN tmpPQSL_CntStk
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.StockLst_Master WITH(NOLOCK) "
		cSQL = cSQL +" WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_CntStk' )
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		IF USED('tmpPQSL_CntStk')
			IF tmpPQSL_CntStk.Cntd > 0
				*Found in StockLst
				lStockLst = .T.
			ENDIF
			USE IN tmpPQSL_CntStk
		ENDIF	
		
		*Check BrokerLst for PO item
		cSQL = "SELECT COUNT(*) AS Cntd  FROM dbo.BrokerLst_Master WITH(NOLOCK) "
		cSQL = cSQL +" WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_CntStk' )
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		IF USED('tmpPQSL_CntStk')
			IF tmpPQSL_CntStk.Cntd > 0
				*Found in BrokerLst
				lBrokerLst = .T.
			ENDIF
			USE IN tmpPQSL_CntStk
		ENDIF		
	ENDIF
	
	IF lAllowDelete  
		IF lStockLst
			*Remove from StockLst
			*Get nMaster_ID
			
			IF USED('tmpPQSL_MasterID')
				USE IN tmpPQSL_MasterID
			ENDIF
			
			cSQL = "SELECT ID FROM dbo.StockLst_Master WITH(NOLOCK) "
			cSQL = cSQL +" WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_MasterID' )
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
			IF USED('tmpPQSL_MasterID')
				IF VARTYPE(tmpPQSL_MasterID.ID) = "N"
					nMaster_ID = tmpPQSL_MasterID.ID
				ENDIF
			ENDIF
			IF Remove_Lst_ID("S",nMaster_ID,nConn,.T.,"Edit PO","Deleted PO Item '"+cPOitem+"'")
				*Remove StockLst Process
				IF Proper_PO_Item('') != Proper_PO_Item(cPOitem)
					cSQL = "DELETE FROM dbo.StockLst_Process WHERE " 
					cSQL = cSQL + " PO_Item = dbo.f_ProperPOitem('"+cPOitem+"')"
					*cSQL = cSQL + " AND Process_ID = 'SELECTED' " --Delete all because the PO is being deleted
					
					nSQLEXEC = SQLEXEC(nConn, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(nConn, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, nConn, nSQLEXEC )
						RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
					ELSE
						TrackMess(cSQL+" "+CHR(13)+SYS(16,1))
					ENDIF
				ENDIF
			ELSE
				lAllowDelete  = .F.
			ENDIF
		ENDIF
	ENDIF
	IF lAllowDelete 
		IF lBrokerLst 
			*Remove from BrokerLst
			*Get nMaster_ID
			
			IF USED('tmpPQSL_MasterID')
				USE IN tmpPQSL_MasterID
			ENDIF
			
			cSQL = "SELECT ID FROM dbo.BrokerLst_Master WITH(NOLOCK) "
			cSQL = cSQL +" WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_MasterID' )
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
			IF USED('tmpPQSL_MasterID')
				IF VARTYPE(tmpPQSL_MasterID.ID) = "N"
					nMaster_ID = tmpPQSL_MasterID.ID
				ENDIF
			ENDIF
						
			IF Remove_Lst_ID("B",nMaster_ID,nConn,.T.,"Edit PO","Deleted PO Item '"+cPOitem+"'")
				*Remove BrokerLst Process
				IF Proper_PO_Item('') != Proper_PO_Item(cPOitem)
					cSQL = "DELETE FROM dbo.BrokerLst_Process WHERE " 
					cSQL = cSQL + " PO_Item = dbo.f_ProperPOitem('"+cPOitem+"')"
					*cSQL = cSQL + " AND Process_ID = 'SELECTED' " --Delete all because the PO is being deleted
					
					nSQLEXEC = SQLEXEC(nConn, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(nConn, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, nConn, nSQLEXEC )
						RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
					ELSE
						TrackMess(cSQL+" "+CHR(13)+SYS(16,1))
					ENDIF
				ENDIF
			ELSE
				lAllowDelete  = .F.
			ENDIF
		ENDIF
	ENDIF
ENDIF		
	
IF lAllowDelete  
	cSQL = "DELETE FROM dbo.PurchaseOrder "
	cSQL = cSQL + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
*	IF NOT EMPTY(cSOitem)  --Over kill
*		cSQL = cSQL + " AND  SOitem  = dbo.f_ProperSOitem('"+cSOitem+"')"
*	ENDIF
	
	nSQLEXEC = SQLEXEC(nConn, cSQL )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQL )
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL, nConn, nSQLEXEC )
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ELSE
		TrackMess(cSQL+" "+CHR(13)+SYS(16,1))
	ENDIF
	
	
	IF Proper_SO_item(cSOitem) != Proper_SO_item('')
		TrackMess("PO Item '"+ALLTRIM(cPOitem)+"' and SO Item='"+ALLTRIM(cSOitem)+"' was Deleted!"+" "+CHR(13)+SYS(16,1))
	ELSE
		TrackMess("PO Item '"+ALLTRIM(cPOitem)+"' was Deleted!"+" "+CHR(13)+SYS(16,1))
	ENDIF
	
ELSE
	MESSAGEBOX("Could not Delete PO Item '"+cPOitem+"'",0+64,"Delete Failed")
	TrackMess("PO Item '"+ALLTRIM(cPOitem)+" with SO Item '"+ALLTRIM(cSOitem)+"' could NOT be Deleted!"+" "+CHR(13)+SYS(16,1))
ENDIF

*********
IF lAllowDelete  
	IF Proper_PO_Item(cPOItem) != Proper_PO_Item('0-00')
		*also Remove from Allquotes
		cSQL = "UPDATE dbo.AllQuotes "
		cSQL = cSQL + " SET HPAPO=0"
		cSQL = cSQL + ",BuyFrom='' "
		cSQL = cSQL + ",PoItem='' "
		cSQL = cSQL + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
		IF NOT Proper_SO_Item(cSOitem) = Proper_SO_Item('')
			cSQL = cSQL + " AND SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		ENDIF
		cSQL = cSQL + " AND HPAPO="+ALLTRIM(LEFT(cPOitem,AT("-",cPOitem)-1))
		cSQL = cSQL + " --Proc_SQL:PurchaseOrder_POitem_Delete"
		
		nSQLEXEC = SQLEXEC(nConn, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC )
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		
		**** BuyFrom2
		cSQL = "UPDATE dbo.AllQuotes "
		cSQL = cSQL + " SET HPAPO2=0"
		cSQL = cSQL + ",BuyFrom2='' "
		*cSQL = cSQL + " WHERE HPApo2 = dbo.f_ProperPOitem('"+cPOitem+"')"
		*cSQL = cSQL + " WHERE HPApo2 = "+STR(VAL(cPOitem))
		*--- will remove all HPAPo2 for this PO, does not look for Item!!
		cSQL = cSQL + " WHERE HPAPO2="+ALLTRIM(LEFT(cPOitem,AT("-",cPOitem)-1))
		IF NOT Proper_SO_Item(cSOitem) = Proper_SO_Item('')
			cSQL = cSQL + " AND SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		ENDIF
		cSQL = cSQL + " --Proc_SQL:PurchaseOrder_POitem_Delete"
		
		nSQLEXEC = SQLEXEC(nConn, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC )
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
	ENDIF
ENDIF	


IF nConn != pConnHandle
	SQLDISCONNECT( nConn )
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN lAllowDelete  
ENDPROC

