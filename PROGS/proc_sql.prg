PROCEDURE SendPDFEmail    
PARAMETER cEmailTo, cEmailFrom, cLocalFileName, cSubject, cMessage, pnConn, cNewPDFName, lCheckEmailStatus
*****
**
** Also Edit SendPDFEmail.prg
**
****
*SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
*? SendPDFEmail("David.Kirchner@SpaceAlloysUSA.com", "David@SpaceAlloysUSA.com", "E:\SendPDF\D\Visual_FoxPro.pdf","","",0,"NewName.pdf",lCheckEmailStatus )

IF VARTYPE(cEmailTo) != "C"
	RETURN "VFP message: No TO address parameter"
ENDIF
IF VARTYPE(cEmailFrom) != "C"
	RETURN "VFP message: No FROM address parameter"
ENDIF
IF VARTYPE(cLocalFileName) != "C"
	RETURN "VFP message: No File Name parameter"
ENDIF
IF VARTYPE(lCheckEmailStatus) != "L"
	lCheckEmailStatus = .T.
ENDIF

PRIVATE cdoPDFFileName 
cdoPDFFileName = ''

*Give time for System finish writing file
WAIT WINDOW "Waiting for PDF" TIMEOUT 2

IF NOT ( "SENDPDF" $ UPPER(cLocalFileName) OR "EMAIL" $ UPPER(cLocalFileName) )
	*cLocalFileName is local to the SQL Server!!
	*TrackError("File ["+cLocalFileName+"] does not have \Email\ or \SendPDF\ !","Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
ENDIF

m.n = 0
DO WHILE NOT FILE(cLocalFileName)
	m.n = m.n + 1
	IF m.n > 60
		EXIT
	ENDIF
	IF m.n > 3 
		WAIT WINDOW "PDF File not Ready. '"+AllTrim(cLocalFileName)+"' Waiting "+ALLTRIM(STR(m.n))+"/ 60 Seconds" TIMEOUT 1
	ENDIF

	IF NOT FILE(cLocalFileName)
		IF FILE( LEFT(cLocalFileName,LEN(cLocalFileName)-4)+"_frx.pdf" ) 
			*Add _frx
			cLocalFileName = LEFT(cLocalFileName,LEN(cLocalFileName)-4)+"_frx.pdf" 
		ELSE
			IF FILE( LEFT(cLocalFileName,LEN(cLocalFileName)-8)+".pdf" )
				*Remove _frx
				cLocalFileName = LEFT(cLocalFileName,LEN(cLocalFileName)-8)+".pdf" 
			ENDIF
		ENDIF
	ENDIF
	IF NOT FILE(cLocalFileName)
		*Try doPDF
		*C_Program Files_HPA_Reports_faxsalesorder02_frx.pdf
		IF UPPER(RIGHT(cLocalFileName,8)) = "_FRX.PDF" 
			*Remove _frx
			cdoPDFFileName =  LEFT(cLocalFileName,LEN(cLocalFileName)-8)+".pdf" 
		ELSE
			cdoPDFFileName = cLocalFileName
		ENDIF
		
		PRIVATE cdoPDFFileName1
		IF OCCURS('_',cdoPDFFileName) > 1
			TRY
				cdoPDFFileName1 = LEFT(cLocalFileName, AT("\",cLocalFileName,OCCURS("\",cLocalFileName)) ) 
				cdoPDFFileName1 = cdoPDFFileName1 + RIGHT( cdoPDFFileName ,LEN(cdoPDFFileName)-AT('_',cdoPDFFileName,OCCURS('_',cdoPDFFileName)) )
			CATCH TO oErr1
				?[  Error: ] + STR(oErr1.ErrorNo)
		    	?[  LineNo: ] + STR(oErr1.LineNo) 
		    	?[  Message: ] + oErr1.Message 
		    	?[  Procedure: ] + oErr1.Procedure 
		    	?[  Details: ] + oErr1.Details 
		    	?[  StackLevel: ] + STR(oErr1.StackLevel) 
		    	?[  LineContents: ] + oErr1.LineContents 
		    	
		    	cMess =[  Error: ] + STR(oErr1.ErrorNo)+[  LineNo: ] + STR(oErr1.LineNo)+CHR(13)+[  Message: ] + oErr1.Message+[  Procedure: ] + oErr1.Procedure+CHR(13)+[  Details: ] + oErr1.Details+[  StackLevel: ] + STR(oErr1.StackLevel) +CHR(13)+[  LineContents: ] + oErr1.LineContents 
		    	TrackError(cMess,"Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
		  		cdoPDFFileName1 = ""
			ENDTRY
			
			IF FILE(cdoPDFFileName1)
				cLocalFileName = cdoPDFFileName1
			ENDIF
		ENDIF
	ENDIF
	
ENDDO

IF NOT FILE(cLocalFileName)
	TrackError("File ["+cLocalFileName+"] not found!","Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN "VFP message: File "+cLocalFileName+[ not found!]
ENDIF

*cNewPDFName Does not contain Directory info
IF VARTYPE(cNewPDFName) != "C"
	cNewPDFName = "HPA.pdf"
ENDIF

PRIVATE cTestAtServer
cTestAtServer = get_Email_ServerDir()+cNewPDFName
IF cTestAtServer = cLocalFileName 
	*Do not Copy or Delete  --all set
ELSE
	IF FILE(cTestAtServer)
		DELETE FILE get_Email_ServerDir()+cNewPDFName
		WAIT WINDOW "Clear files from Server" TIMEOUT 1
	ENDIF
	
	COPY FILE ["]+cLocalFileName+["] TO get_Email_ServerDir()+cNewPDFName
	WAIT WINDOW "Copying your new file "+cNewPDFName+" to Server." TIMEOUT 1

ENDIF

*!*	****moved to End of Proc.
*!*	IF FILE(get_Email_ServerDir()+cNewPDFName )
*!*		*Delete old file
*!*		DELETE FILE (cLocalFileName)
*!*		WAIT WINDOW "Removing your old file." TIMEOUT 1
*!*	ENDIF

IF VARTYPE(cSubject) != "C"
	cSubject = ""
ENDIF
IF EMPTY(cSubject)
	cSubject = "From Space Alloys USA"
ENDIF

IF VARTYPE(cMessage) != "C"
	cMessage = ""
ENDIF
IF EMPTY(cMessage)
	cMessage = "See the Attached document."+CHR(13)+"From Space Alloys USA"+CHR(13)+CHR(13)+"Headquarters:"+CHR(13)+"1985 E 500 N Windfall, IN 46076"+CHR(13)+"1-800-472-5569    (765)945-8230"+CHR(13)+CHR(13)
	cMessage = cMessage + "Production and Sales:"+CHR(13)+"444 Wilson St, Tipton, IN 46072"+CHR(13)+"765-675-8871"
	
ENDIF

PRIVATE nConn
IF VARTYPE(pnConn) = "N"
	IF pnConn < 1
		pnConn = 0
	ELSE
		nConn = pnConn
	ENDIF
ELSE
	pnConn = 0
ENDIF

IF pnConn = 0
	nConn = get_SQLSTRINGCONNECT() 
ENDIF
nConn = CheckSQLConnection(nConn)


PRIVATE cReturn, m.SendFromEmail, m.SendToEmail, m.MsgSubject, m.MsgNoteText, mNewFile
cReturn = ""

m.SendFromEmail	= PrepareSQLemail(cEmailFrom,"EmailFrom")
m.SendToEmail	= PrepareSQLemail(cEmailTo,"EmailTo")
m.MsgSubject	= PrepareSQLtxt(cSubject,"Subject",8000)
*m.MsgNoteText	= PrepareSQLtxt(cMessage,"Message",8000)
m.MsgNoteText	= PrepareSQLtxt(cMessage,"Message",-1)
m.NewFile 		= STRTRAN(ALLTRIM(cNewPDFName),"'","''")
IF LEN(m.NewFile )>8000
	MESSAGEBOX("New File name is over 8000 Characters long!",0,"Too many Characters!")
	m.NewFile 	= LEFT(m.NewFile ,8000)
ENDIF

PRIVATE cAlias 
cAlias = ALIAS()

*THISFORM.Send_SQL_Email(m.SendFromEmail, m.SendToEmail, m.MsgSubject ,m.MsgNoteText)
IF USED('tmpPQSL_EmailAns')
	USE IN tmpPQSL_EmailAns
ENDIF
SELECT 0
PRIVATE cSQLMess
PRIVATE cSQL, nSQLEXEC
*cSQL = "DECLARE @nReturn INT"+CHR(10)+CHR(13)
*cSQL = cSQL + "EXEC @nReturn = dbo.p_eMail_Send_BCC_File_output "
	cSQL = "EXEC dbo.p_eMail_Send_File_BCC "
	cSQL = cSQL + " @FromEmail='"+ m.SendFromEmail+ "'"
	cSQL = cSQL + ",@ToEmail='"+ m.SendToEmail+ "'" 
	cSQL = cSQL + ",@BCC=N''"
	*cSQL = cSQL + ",@BCC=N'4012785@bcc.hubspot.com'"
	cSQL = cSQL + ",@SubjectEmail='"+ m.MsgSubject + "'"
	cSQL = cSQL + ",@BodyEmail='"+ m.MsgNoteText+ "'"
	cSQL = cSQL + ",@file='"+ m.NewFile+ "'"

*MESSAGEBOX(cSQL+CHR(13)+CHR(13)+" any key to continue...",64,"Testing for Email Server")

IF LEN(MsgSubject) > 8000
	TrackError(cSQL,"MsgSubject String TOO big","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO() )
ENDIF
*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQL )

WAIT WINDOW 'SQL' TIMEOUT 1

nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_EmailAns' )
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL 2' TIMEOUT 2
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_EmailAns' )
ENDDO

IF nSQLEXEC < 0 &&Try again!
	MESSAGEBOX("SQL Server Problem"+CHR(13)+"Could not send Email with PDF from SQL Server."+CHR(13)+"It is up to you, to try and send again."+CHR(13)+CHR(13)+"This used to be done automatically, and then it was found that the email was being sent twice.",0+48,"Error")
	*TrackError(cSQL,"SQL Server did not send email with PDF","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO() )
	lCheckEmailStatus = .F.
ENDIF
	
*!*		nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPQSL_EmailAns")
*!*		DO WHILE nSQLEXEC = 0
*!*			WAIT WINDOW 'SQL 3' TIMEOUT 1
*!*			nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPQSL_EmailAns")

*!*			IF nSQLEXEC < 0
*!*				WAIT WINDOW 'SQL 4' TIMEOUT 1
*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
*!*					nSQLEXEC = 0
*!*				ENDIF
*!*			ENDIF
*!*		ENDDO


IF nSQLEXEC < 0
	IF USED('tmpPQSL_EmailAns')
		IF VARTYPE(tmpPQSL_EmailAns.Output) = "C"
			cSQLMess = LEFT("tmpPQSL_EmailAns.Output:"+ALLTRIM(tmpPQSL_EmailAns.Output)+' '+CHR(13)+cSQL,220)
		ELSE
			cSQLMess = LEFT("'tmpPQSL_EmailAns.Output' was not created. nSQLEXEC="+ALLTRIM(STR(nSQLEXEC))+" "+CHR(13)+cSQL,220)
		ENDIF
		
		TrackError("Error at SQL server: First SendPDFEmail: "+CHR(13)+cSQLMess ,"Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
		MESSAGEBOX("SQL did not report about sending the Email."+CHR(13)+"Check your inbox, Send may have worked.",0+48,"No reply from SQL.")

	ELSE
		*cSQLMess = LEFT("nSQLEXEC="+ALLTRIM(STR(nSQLEXEC))+" No 'tmpPQSL_EmailAns' was created."+CHR(13)+cSQL,220)
		*TrackError("Error at SQL server: First SendPDFEmail: "+CHR(13)+cSQLMess ,"Error","Proc_SQL:SendPDFEmail",LINENO())
		*MESSAGEBOX("SQL did not report about sending the Email."+CHR(13)+"Check your inbox, Send may have worked.",0+48,"No reply from SQL.")
	ENDIF
ENDIF


IF nSQLEXEC = 1
	IF USED('tmpPQSL_EmailAns')
		IF RECCOUNT('tmpPQSL_EmailAns')>0
			IF VARTYPE(tmpPQSL_EmailAns.EXP) = "N"
				IF tmpPQSL_EmailAns.EXP = 2
					cMess = "File does not exists to attach at server:"+ALLTRIM(m.NewFile)
					WAIT WINDOW cMess
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	*lCheckEmailStatus 
	TrackMess(LEFT("SendPDFEmail: nSQLEXEC = 1. "+CHR(13)+cMess+CHR(13)+cSQL,220))
ENDIF


IF nSQLEXEC = 2
	WAIT WINDOW 'Did not get my 3 Answer tables from SQL' NOWAIT
	TrackMess(LEFT("SendPDFEmail: nSQLEXEC = 2. "+CHR(13)+cSQL,220))
	*lCheckEmailStatus = .F.
ENDIF


IF nSQLEXEC = 3
	*AUSED(aEmailTables)
	
	*SELECT tmpPQSL_EmailAns
	*tmpPQSL_EmailAns.Output
	*SELECT tmpPQSL_EmailAns1
	*tmpPQSL_EmailAns1.File_exisits,File_is_a_directory,Parent_
	*SELECT tmpPQSL_EmailAns2
	*tmpPQSL_EmailAns2.Exp
	
	IF USED('tmpPQSL_EmailAns2')
		IF VARTYPE(tmpPQSL_EmailAns2.EXP) = "N"
			IF tmpPQSL_EmailAns2.EXP = 1
				TrackMess(LEFT("SQL reported a good Email send. "+CHR(13)+cSQL,220))
				
				IF MESSAGEBOX("SQL reported a good Email send."+CHR(13)+"Do you want to watch the Email Status?",4+32+256,"Sent Email!")=6
					lCheckEmailStatus = .T.
				ELSE
					lCheckEmailStatus = .F.
				ENDIF
			ELSE
				IF tmpPQSL_EmailAns2.EXP = 2
					TrackMess( LEFT("Could not find file to attach."+CHR(13)+cSQL,220), nConn, nSQLEXEC, 'NORETRY' )
					MESSAGEBOX("SQL reported, could not find file to attach, Email not sent",0+48,"Email not sent")
					lCheckEmailStatus = .F.
				ELSE
					IF tmpPQSL_EmailAns2.EXP = 3
						TrackMess( LEFT("msdb.dbo.sp_send_dbmail Failed."+CHR(13)+cSQL,220), nConn, nSQLEXEC, 'NORETRY' )
						MESSAGEBOX("SQL reported, msdb.dbo.sp_send_dbmail Failed, Email not sent",0+48,"Email not sent")
						lCheckEmailStatus = .F.
					ELSE
						TrackMess( LEFT("Could not finish Email routine."+CHR(13)+cSQL,220), nConn, nSQLEXEC, 'NORETRY' )
						MESSAGEBOX("SQL reported, could not finish Email routine, Email not sent",0+48,"Email not sent")
						lCheckEmailStatus = .F.
					ENDIF
				ENDIF
			ENDIF
		ELSE
			*
			IF NOT SQLEXECError( LEFT("tmpPQSL_EmailAns2.EXP is NOT 'N'."+CHR(13)+cSQL,220), nConn, nSQLEXEC, 'NORETRY' )
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
		ENDIF
		USE IN tmpPQSL_EmailAns2
	ENDIF
ENDIF


IF USED('tmpPQSL_EmailAns')
	USE IN tmpPQSL_EmailAns
ENDIF
IF USED('tmpPQSL_EmailAns1')
	USE IN tmpPQSL_EmailAns1
ENDIF
IF USED('tmpPQSL_EmailAns2')
	USE IN tmpPQSL_EmailAns2
ENDIF

*Remove old file
IF FILE(get_Email_ServerDir()+cNewPDFName )
	WAIT WINDOW 'Delete sent file.' TIMEOUT 1
	DELETE FILE get_Email_ServerDir()+cNewPDFName
ENDIF

****moved to End of Proc.
IF FILE(cLocalFileName )
	*Delete Orig PDF
	TRY
		DELETE FILE (cLocalFileName)
	CATCH
		MESSAGEBOX("Cannot Delete old PDF"+CHR(13)+"Close Any PDF Viewers that may be locking this file."+CHR(13)+cLocalFileName,16,"Cannot Delete PDF")
	ENDTRY
ENDIF


IF nConn != pnConn
	=SQLDISCONNECT(nConn)
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.", "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

IF lCheckEmailStatus
	IF FILE("forms\CheckEmailStatus.SCX")
		DO FORM forms\CheckEmailStatus WITH m.SendToEmail
	ELSE
		DO FORM \forms\CheckEmailStatus WITH m.SendToEmail
	ENDIF
ENDIF


RETURN cReturn 
ENDPROC

