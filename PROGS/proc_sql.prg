PROC PrepareSQLtxt 
PARAMETER cData, cField, nLen, pPad, lQuite
*PrepareSQLtxt("Space Alloys USA'",'Company',25,.F.,.T.)
** Pad .T. to add spaces at end, False Pad to ignore
* -1 is unlimited text *you must add function ALLTRIM() when len is -1 
* Use ShowSQLtxt to just show!!!!

IF VARTYPE(cData) = "N"
	cData = ALLTRIM(STR( cDATA ))
ENDIF
IF VARTYPE(cData) = "Y"
	cData = ALLTRIM(STR(cDATA,18,4))
ENDIF
IF VARTYPE(cData) != "C"
	RETURN ""
ENDIF
IF VARTYPE(cField) != "C"
	WAIT WINDOW [BAD PARAMETERS: PrepareSQLtxt(cText,cFeild,nLen,pPad,lQuite)] NOWAIT
	cField = "Field"
	SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
*	TrackMess( "Proc_Sql:PrepareSQLtxt() has no Field, cData="+LEFT(cData,30) +",Field="+LEFT(cField,30) )
	TrackError("cData="+LEFT(cData,30) +", Field="+LEFT(cField,30)+". ","Proc_Sql:PrepareSQLtxt() has no Field","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	*TrackError("Problem","message","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO()) 
	*RETURN cData
ENDIF
IF VARTYPE(nLen) != "N"
	WAIT WINDOW [BAD PARAMETERS: PrepareSQLtxt(cText,cFeild,nLen,pPad,lQuite)] NOWAIT
	*TrackMess( "Proc_Sql:PrepareSQLtxt() has no Len, cData="+LEFT(cData,30)+", Field="+LEFT(cField,30) )
	SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
	TrackError("cData="+LEFT(cData,30) +", Field="+LEFT(cField,30)+". ","Proc_Sql:PrepareSQLtxt() has no Len","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	*TrackError("Problem","title","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN ""
ENDIF
*nLen = 0 Unlimited Text

PRIVATE lPad
lPad = .F.
IF VARTYPE(pPad) = "C"
	IF UPPER(LEFT(pPad,1)) = "P"
		lPad = .T.
	ENDIF
ENDIF
IF VARTYPE(pPad) = "L"
	lPad = pPad
ENDIF
IF VARTYPE(pPad) = "N"
	IF pPad = 1
		lPad = .T.
	ELSE
		lPad = .F.
	ENDIF
ENDIF
***
IF VARTYPE(lQuite) != "L"
	lQuite = .F.
ENDIF
***
IF cData $ "''"
	*cData = STRTRAN(cData,"''","'")  &&Already escaped!
ELSE
	cData = STRTRAN(cData,"'","''")  &&Escape the single quotemark so SQL does not puke.
ENDIF
***
*cData = STRTRAN(cData,["],[""])  &&Escape the double quotemark so SQL does not puke. Enable 7-20-09. Disabled 8-2-09.
cData = STRTRAN(cData,CHR(0),"")  &&Get rid of NULL
*cData = STRTRAN(cData,CHR(9)," ")  &&change Tab to Space
*cData = STRTRAN(cData,CHR(96)," ")  &&change ` to Space

DO CASE 
CASE nLen = 0
	*just remove waste
	cData = ALLTRIM(cData)
CASE nLen > 0
	cData = ALLTRIM(cData)
		
*!*		*Fix apostrophe as it uses an extra character to escape the single quote '
*!*		PRIVATE nCountApo, nAtPos, nNewLen, cNewData
*!*		nCountApo = 0
*!*		nAtPos = 0
*!*		nNewLen = nLen
*!*		cNewData = cData
*!*		*Count 2 apostrophe in a row as 1 to check for Length limit
*!*		*use "^&" as new escape character
*!*		DO WHILE OCCURS("''", cNewData) > 0
*!*			nCountApo = nCountApo + 1
*!*	*!*		cRetVal = STRTRAN( cSource, cStringToReplace
*!*	*!*	      [, cReplacementString
*!*	*!*	      [, nStartOccurrence
*!*	*!*	      [, nHowMany
*!*	*!*	      [, nFlags ] ] ] ])
*!*			cNewData = STRTRAN( cNewData, "''", "^&" ,1,1 )
*!*			
*!*			
*!*			*****************************
*!*			*fix when PrepareSQLtxt is ran multiple times
*!*			DO WHILE OCCURS("`~'", cNewData)> 0
*!*				cNewData = STRTRAN( cNewData, "^&'", "^&" )
*!*			ENDDO
*!*			*****************************
*!*		ENDDO
*!*		
*!*		IF nCountApo > 0
*!*			*put apostrophe back
*!*			cNewData = STRTRAN( cNewData, "^&", "'" )
*!*			nNewLen = LEN(cNewData)
*!*			
*!*			*Add a 1 for ever apostrophe character 
*!*			* so the String length max check does not exceed the length max by coounting extra apostrophe's
*!*			nLen = nNewLen &&nLen + nCountApo 
*!*			*Escape the apostrophe 
*!*			cData = CHRTRAN(cNewData, "'", "''")
*!*		ENDIF
*!*		
	********************
	IF LEN(cData) > nLen 

		cData = LEFT(cData,nLen)
		
		IF MOD( OCCURS("'", cData) ,2) = 1
			**Found unbalanced apostrophe in string 
			IF RIGHT( cData, 1 ) = "'" AND nLen > 1
				**Found Last character is apostrophe
				cData = LEFT(cData,nLen-1)
				
*!*					IF RIGHT( cData, 1 ) = "'" AND nLen > 1
*!*						**Found Last character is still an apostrophe
*!*						cData = LEFT(cData,nLen-1)
*!*					ENDIF
				IF NOT lQuite
					MESSAGEBOX( cField+" was trimmed to "+ALLTRIM(STR(nLen-1))+" text characters '"+cData+"'"+CHR(13)+"an end quote symbol",0+64,"SQL Data Overflow prevented.")			
				ENDIF
			ELSE
				**
			ENDIF
		ELSE
			IF NOT lQuite
*				IF UPPER(cField)="ALLOY"
*					WAIT WINDOW 'Alloy'
*				ENDIF
				MESSAGEBOX( cField+" was trimmed to "+ALLTRIM(STR(nLen))+" text characters '"+cData+"'",0+64,"SQL Data Overflow prevented.")			
			ENDIF
		ENDIF
	ENDIF
Otherwise
	*Do not Trim unlimited text (-1)
	*nLen = -1
ENDCASE

IF lPad 
	cData = PADR( cData , nLen, " ")
ELSE
	*Remove Ending CHR(10) and CHR(13)
	DO WHILE LEN(cData) > 0 
		IF ASC(SUBSTR(cData,LEN(cData),1))= 10 OR ASC(SUBSTR(cData,LEN(cData),1))= 13
			IF ASC(SUBSTR(cData,LEN(cData),1))= 10 
				cData = LEFT(cData,LEN(cData)-1)
				LOOP
			ENDIF
			IF ASC(SUBSTR(cData,LEN(cData),1))= 13
				cData = LEFT(cData,LEN(cData)-1)
				LOOP
			ENDIF
		ENDIF		
		
		EXIT
	ENDDO
ENDIF

IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
	SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
ENDIF

DO CASE
CASE UPPER(cField) == "SOITEM"
	cData = Proper_SO_Item(cData)
CASE UPPER(cField) == "POITEM"
	cData = Proper_PO_Item(cData)
CASE UPPER(cField) == "PO_ITEM"
	cData = Proper_PO_Item(cData)
CASE UPPER(cField) == "HEAT"
	DO WHILE AT(' -',cData) > 0
		cData = STUFF(cData,AT(' -',cData),2,'-')
	ENDDO
	DO WHILE AT('- ',cData) > 0
		cData = STUFF(cData,AT('- ',cData),2,'-')
	ENDDO

CASE UPPER(cField) == "TBL"
	cData = UPPER(cData)
CASE UPPER(cField) == "INQNUMP"
	cData = Proper_InqNumP(cData)
	*ALWAYS PAD InqNumP
	cData = PADL(ALLTRIM(cData),9,' ')
*CASE UPPER(cField) == "FORM"
*	DO NOT CHANGE FORM 80 to 40 HERE
*	cData = Proper_Form(cData)
*CASE UPPER(cField) == "THK"
*	*THK is only used in dbo.PriceTable
*	cData = Proper_Thk(cData)
CASE UPPER(cField) == "CUSTOMERID"
*	IF LEFT(cData,3)="C00"
		cData = cData
*	ELSE
*		cData = ''
*	ENDIF

ENDCASE

RETURN cData

ENDPROC

