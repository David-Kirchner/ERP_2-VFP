		ENDDO
		
		IF nSQLEXEC < 0  &&Try again.
			nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_rSOiPOi' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_rSOiPOi' )
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_rSOiPOi')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			*lOK = .F.
		ENDIF
		
		IF USED('tmpPQSL_rSOiPOi')
			IF RECCOUNT('tmpPQSL_rSOiPOi') > 0
				IF tmpPQSL_rSOiPOi.CNTD > 0
					lFoundPO_SOdist = .T.
					*MESSAGEBOX("Did not PurchaseOrder '"+cPOitem+"'"+CHR(13)+"with SOitem '"+cSOitem+"'.",16,"Cannot Remove SOi FROM POi!")
					*lOK = .F.
				ENDIF
			ENDIF
			USE IN tmpPQSL_rSOiPOi
		ENDIF
	ENDIF

	IF lOK AND lFoundPO_SOdist
		
		cSQL = "DELETE FROM dbo.PO_SOdist "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "	AND SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"

		nSQLEXEC = SQLEXEC( nConn, cSQL, '' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConn, cSQL, '' )
		ENDDO
		
		IF nSQLEXEC < 0  &&Try again.
			nSQLEXEC = SQLEXEC( nConn, cSQL, '' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConn, cSQL, '' )
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, '')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			lOK = .F.
		ENDIF
		
	ENDIF
	
	***************************
	IF lOK
			
		cSQL = "EXEC dbo.p_Sales_Stock_UPDATE_Sales '"+cSOitem+"'"
		
		nSQLEXEC = SQLEXEC(nConn, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConn, cSQL, '' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,nConn,'')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			*lOK = .F.
		ELSE
			TrackMess("POitem:'"+cPOitem+"' pricing was removed for SOitem:'"+cSOitem+"'"+" "+CHR(13)+SYS(16,1))
		ENDIF
	
	ENDIF
	
	***************************
	IF lOK
		TrackMess("POitem:'"+cPOitem+"' was changed to NOT be used for SOitem:'"+cSOitem+"'"+" "+CHR(13)+SYS(16,1))
		IF NOT lTranAlreadySet
			= SQLCOMMIT(nConn)
		ENDIF
	ELSE	
		IF NOT lTranAlreadySet			
			= SQLROLLBACK(nConn)
		ENDIF
	ENDIF

	IF NOT lTranAlreadySet
		*end the Transaction:
		= SQLSETPROP(nConn, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans
	ENDIF
	
	IF lNewConn
		SQLDISCONNECT( nConn )
	ENDIF


	IF NOT EMPTY(cAlias)
		IF USED(cAlias)
			SELECT (cAlias)
		ELSE
			RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
		ENDIF
	ENDIF
	
ELSE
	*Could not connect
	lOK = .F.
ENDIF



RETURN lOK
ENDPROC

