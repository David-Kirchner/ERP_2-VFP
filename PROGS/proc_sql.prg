cSQL = "SELECT [type],[StandTerms],[CODTerms],[Prepaid],[DueDays],[dtDATE],[CreditLimit]-[CurrentBalance] AS [CreditLeft]"
cSQL = cSQL + ",ST,Resales_Tax "
cSQL = cSQL + "	FROM dbo.CUSTOMER_LIST WITH(NOLOCK) "
cSQL = cSQL + "	WHERE CustomerID = '"+cCustID+"'"
	
SELECT 0
nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CUSTOMER_LIST')

DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CUSTOMER_LIST')
ENDDO
IF nSQLEXEC < 0 &&Try again!
	nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPQSL_CUSTOMER_LIST")
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL 2' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPQSL_CUSTOMER_LIST")

		IF nSQLEXEC < 0
			IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
				nSQLEXEC = 0
			ENDIF
		ENDIF
	ENDDO
ENDIF 
IF nSQLEXEC < 0
	IF NOT SQLEXECError(cSQL,nConn,nSQLEXEC,'tmpPQSL_CUSTOMER_LIST')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ENDIF
ENDIF

PRIVATE lReturn
lReturn = .F.

IF USED('tmpPQSL_CUSTOMER_LIST')
	IF RECCOUNT('tmpPQSL_CUSTOMER_LIST') > 0
	*IF VARTYPE(tmpPQSL_CUSTOMER_LIST.dtDATE) = 'T'
		*Now Check Terms
		PRIVATE nType, cMess, cProgMess
		nType = PrepareSQLnum(tmpPQSL_CUSTOMER_LIST.Type,'Type',1,0)
		cMess		= ''
		cProgMess	= "Found CustomerID = '"+ALLTRIM(cCustID)+"' in dbo.CUSTOMER_LIST "
		IF nType > 0 AND nType < 10
			*Have Proper Type!
			
			DO CASE 
			CASE nType = 1
				*MESSAGEBOX("Standard Terms!"+cProgMess ,64,"Customer Terms")
				cMess = 'Standard Terms'
			CASE nType = 2
				MESSAGEBOX("COD Terms!"+cProgMess ,0+48,"Customer Terms")
				cMess = 'COD Terms'
			CASE nType = 3
				MESSAGEBOX("Prepaid Terms!"+cProgMess ,0+48,"Customer Terms")
				cMess = 'Prepaid Terms'
			CASE nType = 4
				MESSAGEBOX("Canadian Standard Terms!"+cProgMess ,64,"Customer Terms")
				cMess = 'Standard Terms'
			CASE nType = 5
				MESSAGEBOX("Canadian COD Terms!"+cProgMess ,0+48,"Customer Terms")
				cMess = 'COD Terms'
			CASE nType = 6
				MESSAGEBOX("Canadian Prepaid Terms!"+cProgMess ,0+48,"Customer Terms")
				cMess = 'Prepaid Terms'
			CASE nType = 7
				*MESSAGEBOX("Foreign Standard Terms!"+cProgMess ,0+48,"Customer Terms")
				cMess = 'Standard Terms'
			CASE nType = 8
				MESSAGEBOX("COD Terms!"+cProgMess ,0+48,"Customer Terms")
				cMess = 'COD Terms'
			CASE nType = 9
				MESSAGEBOX("Prepaid Terms!"+cProgMess ,0+48,"Customer Terms")
				cMess = 'Prepaid Terms'
			OTHERWISE
				MESSAGEBOX("Report No Terms listed!"+cProgMess ,64,"Customer Terms")
			ENDCASE
		ELSE
			*Use StandTerms...
			PRIVATE StandTerms, lCODTerms, lPrepaid
			lStandTerms	= PrepareSQLchk(tmpPQSL_CUSTOMER_LIST.StandTerms,'StandTerms')
			lCODTerms	= PrepareSQLchk(tmpPQSL_CUSTOMER_LIST.CODTerms,'CODTerms')
			lPrepaid	= PrepareSQLchk(tmpPQSL_CUSTOMER_LIST.Prepaid,'Prepaid')
			
			IF lStandTerms
				MESSAGEBOX("Standard Terms!",0+48,"Customer Terms")
				cMess = "Standard Terms!" +cProgMess
			ELSE
				IF lCODTerms
					MESSAGEBOX("COD Terms!",0+48,"Customer Terms")
					cMess = "COD Terms!" +cProgMess
				ELSE
					IF lPrepaid
						MESSAGEBOX("Prepaid Terms!",0+48,"Customer Terms")
						cMess = "Prepaid Terms!" +cProgMess
					ENDIF
				ENDIF
			ENDIF
		ENDIF 
		
		PRIVATE nCreditLeft
		nCreditLeft = PrepareSQLnum(tmpPQSL_CUSTOMER_LIST.CreditLeft,'CreditLeft',-3)
		IF nCreditLeft < 1
			MESSAGEBOX(cMess+CHR(13)+"OVER Credit Limit!"+CHR(13)+"Currently Over limit by ("+ALLTRIM(STR(nCreditLeft))+")",0+48,"Customer Terms")
		ENDIF
		*****
		
		PRIVATE cST, cResales_Tax
		cST			 = UPPER(PrepareSQLtxt(tmpPQSL_CUSTOMER_LIST.St,'State',20))
		cResales_Tax = PrepareSQLtxt(tmpPQSL_CUSTOMER_LIST.Resales_Tax,'Resales_Tax',50)
		IF cST = "TX" OR cST = "CA"
			IF EMPTY(cResales_Tax)
				WAIT WINDOW ALLTRIM(cCustID) + ": HPA needs their Resales Tax ID for State '"+cST+"'."+" CustID_Terms()" TIMEOUT 2
			ENDIF
		ENDIF

		
		
	ENDIF
ENDIF

IF USED('tmpPQSL_CUSTOMER_LIST')
	USE IN tmpPQSL_CUSTOMER_LIST
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.", "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN lReturn 
