nSO = PrepareSQLnum(cSOitem,'SalesNum',-3)

IF USED('tmpPQSL_Sales')

	IF VARTYPE(tmpPQSL_Sales.cncld) = "L"
		IF tmpPQSL_Sales.cncld
			*Order is cancelled, just let thru
			lValid = .T.
			lPassOver = .T.
		ENDIF
	ENDIF
	
	IF NOT lPassOver &&Default
		IF VARTYPE(tmpPQSL_Sales.cmplt) = "L"
			IF tmpPQSL_Sales.cmplt
				*Order is complete, just let thru
				lValid = .T.
				lPassOver = .T.
			ENDIF
		ENDIF
	ENDIF
	
	IF NOT lPassOver &&Default
		IF VARTYPE(tmpPQSL_Sales.ShipDue) = "D" 
			dShipDueDate = tmpPQSL_Sales.ShipDue
		ELSE
			IF VARTYPE(tmpPQSL_Sales.ShipDue) = "T"
				dShipDueDate = TTOD(tmpPQSL_Sales.ShipDue)
			ELSE
				dShipDueDate = CTOD('')
			ENDIF
		ENDIF
		
		IF NOT EMPTY(dShipDueDate)
			**Order has not been cancelled, order is not complete, order has a ShipDue!
			PRIVATE dShippedDate,cUrgent,lShipon
			*,nQshipped,nQbackorder
			
			IF VARTYPE(tmpPQSL_Sales.Shipped) = "D" 
				dShippedDate = tmpPQSL_Sales.Shipped
			ELSE
				IF VARTYPE(tmpPQSL_Sales.Shipped) = "T"
					dShippedDate = TTOD(tmpPQSL_Sales.Shipped)
				ELSE
					dShippedDate = CTOD('')
				ENDIF
			ENDIF
			
*!*				IF VARTYPE(tmpPQSL_Sales.Qshipped) = "N" OR VARTYPE(tmpPQSL_Sales.Qshipped) = "Y"
*!*					nQshipped = tmpPQSL_Sales.Qshipped
*!*				ELSE
*!*					nQshipped = 0
*!*				ENDIF
*!*				
*!*				IF VARTYPE(tmpPQSL_Sales.Qbackorder) = "N"
*!*					nQbackorder = tmpPQSL_Sales.Qbackorder
*!*				ELSE
*!*					nQbackorder = 0
*!*				ENDIF
			
			IF VARTYPE(tmpPQSL_Sales.Urgent) = "C"
				cUrgent = tmpPQSL_Sales.Urgent
			ELSE
				cUrgent = ''
			ENDIF
			
			IF VARTYPE(tmpPQSL_Sales.Shipon) = "L"
				lShipon = tmpPQSL_Sales.Shipon
			ELSE
				lShipon = .F.
			ENDIF
			
			*Check dShippedDate,cUrgent?
			***************
			IF lShipon 
				IF dShipDueDate <= DATE()
					lValid = .F.
					lPassOver = .T.
				ENDIF
			ELSE
				*using the Ship After
				*No problem
			ENDIF			
						
			IF NOT lPassOver 
				*Check with PO
				***************************************
				IF USED("tmpPQSL_PurchaseOrder")
					USE IN tmpPQSL_PurchaseOrder
				ENDIF
				cSQL = "SELECT Due_Min,Due_Max,Received,Delivered,Cancelled"
				cSQL = cSQL + ",Services,ConvServ,Equipment "
				cSQL = cSQL + ",HPA_Due_Min,HPA_Due_Max,HPAPO,POitem "
				cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) WHERE "
				cSQL = cSQL + " SOItem = dbo.f_ProperSOitem('"+cSOItem+"')"

				SELECT 0
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_PurchaseOrder')

				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_PurchaseOrder' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,nConn, nSQLEXEC, 'tmpPQSL_PurchaseOrder')
					RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
				ENDIF
				
				PRIVATE dDue_Min,dDue_Max,dtReceived,lDelivered,lCancelled
				PRIVATE lServices,lConvServ,lEquipment
				PRIVATE dHPA_Due_Min,dHPA_Due_Max, nHPAPO,cPOitem
				IF USED('tmpPQSL_PurchaseOrder')
					dDue_Min = PrepareSQLdate(tmpPQSL_PurchaseOrder.Due_Min,'Due_Min')
					dDue_Max = PrepareSQLdate(tmpPQSL_PurchaseOrder.Due_Max,'Due_Max')
					dtReceived = PrepareSQLdateTime(tmpPQSL_PurchaseOrder.Received,'Received')
					
					lDelivered	= PrepareSQLlogic(tmpPQSL_PurchaseOrder.Delivered,'Delivered')
					lCancelled	= PrepareSQLlogic(tmpPQSL_PurchaseOrder.Cancelled,'Cancelled')
					lServices	= PrepareSQLlogic(tmpPQSL_PurchaseOrder.Services,'Services')
					lConvServ	= PrepareSQLlogic(tmpPQSL_PurchaseOrder.ConvServ,'ConvServ')
					lEquipment	= PrepareSQLlogic(tmpPQSL_PurchaseOrder.Equipment,'Equipment')
					
					dHPA_Due_Min = PrepareSQLdate(tmpPQSL_PurchaseOrder.HPA_Due_Min,'HPA_Due_Min')
					dHPA_Due_Max = PrepareSQLdate(tmpPQSL_PurchaseOrder.HPA_Due_Max,'HPA_Due_Max')
					
					nHPAPO	= PrepareSQLnum(tmpPQSL_PurchaseOrder.HPAPO,'HPAPO',-3)
					cPOitem = PrepareSQLtxt( tmpPQSL_PurchaseOrder.POitem,'POitem',12)
					
					IF lDelivered OR lCancelled 
						*Let check thru
						lValid = .T.
					ELSE
						lValid = .T.  &&Default to True, change if Salesmen need more controlled.
						
						****************
						PRIVATE cMess, lPassDueMax
						lPassDueMax = .T.
						
						IF dHPA_Due_Max = CTOD("01/01/1900")
							dHPA_Due_Max = CTOD('')
						ENDIF
						IF dHPA_Due_Min = CTOD("01/01/1900")
							dHPA_Due_Min = CTOD('')
						ENDIF
						IF dDue_Max = CTOD("01/01/1900")
							dDue_Max = CTOD('')
						ENDIF
						IF dDue_Min = CTOD("01/01/1900")
							dDue_Min = CTOD('')
						ENDIF
						
						
					
						IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
							SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
						ENDIF 
						PRIVATE cDescript
						cDescript = get_Description_of_SOitem_in_AllQuotes(cSOitem,nConn)
						
						
						IF NOT EMPTY(dHPA_Due_Max)
							IF dHPA_Due_Max > dShipDueDate+1 
								** Added +1 to max on 8/18/15 to get less Emails.
								cMess = "1. Ship Due for SO-Item:"+cSOItem+" is "+DTOC(dShipDueDate)+". "+CHR(10)+CHR(13)
								cMess = cMess +" PO is listed for delivery to HPA by max of "+DTOC(dHPA_Due_Max)+"."
								cMess = cMess +IIF(lServices," -Services ","")+IIF(lConvServ," -Conversion Service ","")+IIF(lEquipment," -Equipment ","")
								cMess = cMess +CHR(13)+CHR(13)+"The PO due in Max date is "+ALLTRIM(STR(dHPA_Due_Max-dShipDueDate))+" days past SO due date."
								
								MESSAGEBOX(cMess,0+48,"SO Could Ship Late!")
								Send_Chatter('SOITEM_LATE',nHPApo,cSOitem,cMess,nConn)
								cMess = cMess +CHR(13)+"SOitem: "+HTML_SOitem(cSOitem,.F.)+CHR(13)+"PO: "+HTML_PO(nHPApo,.F.)
								cMess = cMess +"<br>"+CHR(10)+CHR(13)+ " SO-Item could ship late because of late ERP PO:"+ALLTRIM(STR(nHPAPO))
								
								cMess = cMess +CHR(10)+CHR(13)+ " Salesman:"+SalesRepfromSO(nSO)+"."
								cMess = cMess +CHR(10)+CHR(13)+ "Proc_SQL:validate_Sales_ShipDue()."

								TrackMess("Validate_Sales_ShipDue: "+cMess+" "+CHR(13)+SYS(16,1))
								IF  dHPA_Due_Max > dShipDueDate + 7
									** Added +7 to max on TrackError for less emails on 3/16/16
									TrackError(cMess,"dHPA_Due_Max > dShipDueDate","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
								ENDIF
								cSendersEmail = AppSetup_Get_Email( SalesRepfromSO(nSO))
								Send_HTML_Email( 'QA@SpaceAlloysUSA.com',cSendersEmail ,'Warning! SO could ship late.',cMess,nConn,.T.,.T.)
								lPassDueMax = .F.
							ENDIF	
						ENDIF
						IF lPassDueMax 
							IF NOT EMPTY(dHPA_Due_Min)
								IF dHPA_Due_Min > dShipDueDate AND lPassDueMax 
									*cMess = "2. Ship Due for SO-Item:"+cSOItem+" is "+DTOC(dShipDueDate)+". "+CHR(10)+CHR(13)+"PO is listed for delivery to HPA by min of "+DTOC(dHPA_Due_Min)+"."
									*cMess = cMess +IIF(lServices," -Services ","")+IIF(lConvServ," -Conversion Service ","")+IIF(lEquipment," -Equipment ","")
									*MESSAGEBOX(cMess,0+48,"SO could ship late")
									*cMess = cMess + " SO-Item could ship late! Salesman:"+SalesRepfromSO(nSO)+"."
									*cMess = cMess +CHR(10)+CHR(13)+ cDescript
									*TrackMess(cMess+" "+CHR(13)+SYS(16,1))
									*Send_HTML_Email( 'QA@SpaceAlloysUSA.com','David@SpaceAlloysUSA.com','Bad SO Ship Due Date.',cMess,nConn,.T.,.T.)
								ENDIF					
							ENDIF		
						ENDIF
						
						lPassDueMax = .T.
						IF EMPTY(dHPA_Due_Max) AND EMPTY(dHPA_Due_Min)
							IF NOT EMPTY(dDue_Max)
								IF dDue_Max > dShipDueDate 
									cMess = "3. Ship Due for SO-Item:"+cSOItem+" is "+DTOC(dShipDueDate)+". "+CHR(10)+CHR(13)
									cMess = cMess +IIF(lServices," -Services ","")+IIF(lConvServ," -Conversion Service ","")+IIF(lEquipment," -Equipment ","")
									cMess = cMess + "PO is listed to ship to HPA by max of "+DTOC(dDue_Max)+"."
									cMess = cMess + CHR(13)+CHR(13)+"The PO ship date is "+ALLTRIM(STR(dDue_Max-dShipDueDate))+" days past SO due date."
									
									MESSAGEBOX(cMess,0+48,"SO could ship late.")
									Send_Chatter('SOITEM_LATE',nHPApo,cSOitem,cMess,nConn)
							
									cMess = cMess +CHR(13)+"SOitem: "+HTML_SOitem(cSOitem,.F.)+CHR(13)+"PO: "+HTML_PO(nHPApo,.F.)		
									cMess = cMess +"<br>"+CHR(10)+CHR(13)+ " SO-Item could ship late because of late ERP PO:"+ALLTRIM(STR(nHPAPO))
									cMess = cMess +CHR(10)+CHR(13)+ " Salesman:"+SalesRepfromSO(nSO)+"."
									cMess = cMess +CHR(10)+CHR(13)+ cDescript
									cMess = cMess +CHR(10)+CHR(13)+"Proc_SQL:Validate_Sales_ShipDue()."
									
									TrackMess("Validate_Sales_ShipDue: "+cMess+" "+CHR(13)+SYS(16,1))
									TrackError(cMess,"dDue_Max > dShipDueDate","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
									
									cSendersEmail = AppSetup_Get_Email( SalesRepfromSO(nSO))
									Send_HTML_Email( 'QA@SpaceAlloysUSA.com',cSendersEmail ,'Warning! SO could ship late.',cMess,nConn,.T.,.T.)
									lPassDueMax = .F.
								ENDIF
							ELSE
								lPassDueMax = .T.
								*Set so next sub does not run
							ENDIF
							IF NOT EMPTY(dDue_Min)
								IF dDue_Min > dShipDueDate AND lPassDueMax 
									cMess = "4. Ship Due for SO-Item:"+cSOItem+" is "+DTOC(dShipDueDate)+". "+CHR(10)+CHR(13)
									cMess = cMess +IIF(lServices," -Services ","")+IIF(lConvServ," -Conversion Service ","")+IIF(lEquipment," -Equipment ","")
									cMess = cMess +CHR(10)+CHR(13)+"PO is listed to ship to HPA by min of "+DTOC(dDue_Min)+"."
									cMess = cMess +CHR(10)+CHR(13)+ " SO-Item could ship late because of late ERP PO:"+ALLTRIM(STR(nHPAPO))
									MESSAGEBOX(cMess,0+48,"SO-Item could be late")
									
									cMess = cMess +HTML_SOitem(cSOitem,.F.)+CHR(13)+HTML_PO(nHPApo,.F.)
									Send_Chatter('SOITEM_LATE',nHPApo,cSOitem,cMess,nConn)
									
									cMess = cMess +"<br>"+CHR(10)+CHR(13)+ " Salesman:"+SalesRepfromSO(nSO)+" wrote order knowing purchase was making sale late."
									cMess = cMess +CHR(10)+CHR(13)+ cDescript
									cMess = cMess +CHR(10)+CHR(13)+"Proc_SQL:Validate_Sales_ShipDue()."
									
									TrackMess("Validate_Sales_ShipDue: "+cMess+" "+CHR(13)+SYS(16,1))
									TrackError(cMess,"dDue_Min > dShipDueDate","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
									
									cSendersEmail = AppSetup_Get_Email( SalesRepfromSO(nSO))
									Send_HTML_Email( 'QA@SpaceAlloysUSA.com',cSendersEmail ,'Bad SO Ship Due Date.',cMess,nConn,.T.,.T.)
								ENDIF					
							ENDIF							
						ENDIF
						***************
					ENDIF
										
					USE IN tmpPQSL_PurchaseOrder
				ENDIF
				
			ENDIF
		ENDIF
	ENDIF
	
ENDIF

IF USED('tmpPQSL_Sales')
	USE IN tmpPQSL_Sales
ENDIF

IF lNewConn 
	SQLDISCONNECT(nConn)
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN lValid
ENDPROC

