PROCEDURE Scan_Code_Limits 
PARAMETERS cScanCode, nScanNum, nScanOrderItem, pConnHandle
 
*Create Error Emails when not ibn limits 
*Scan_Code_Limits(cScanCode,nScanNum,nScanOrderItem)

IF VARTYPE(cScanCode) != "C"
	TrackError("Did not get a Scan Code","Scan_Code_Limits(cScanCode,nScanNum,nScanOrderItem)","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	*Cannot work with
	RETURN
ENDIF

IF VARTYPE(nScanNum) != "N"
	TrackError("cScanCode='"+cScanCode+"' Scan_Code_Limits(cScanCode,nScanNum,nScanOrderItem)","Did not get a Scan Number","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN 
ENDIF

PRIVATE nConn, lNewConn
lNewConn = .F.

IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
		nConn = pConnHandle
	ELSE
		nConn = get_SQLSTRINGCONNECT()
		lNewConn = .T.
	ENDIF
ELSE
	nConn = get_SQLSTRINGCONNECT()
	lNewConn = .T.
ENDIF
nConn = CheckSQLConnection(nConn)


PRIVATE cDescript, nMin, nMax, cBase
cDescript = ''
nMin	= 1
nMax	= 2147483647 -1
cBase	= ''

PRIVATE cAlias 
cAlias = ALIAS()

IF USED('tmpPQSL_Scan_Code')
	USE IN tmpPQSL_Scan_Code
ENDIF

PRIVATE nConn  
nConn  = get_SQLSTRINGCONNECT()

PRIVATE cSQL, nSQLEXEC

cSQL = "SELECT Descript, Min, Max, ISNULL(Base,'') AS Base "
cSQL = cSQL + " FROM dbo.Scan_Code WITH(NOLOCK) "
cSQL = cSQL + " WHERE CODE = '"+cScanCode+"'"

SELECT 0
nSQLEXEC = SQLEXEC(nConn , cSQL, 'tmpPQSL_Scan_Code')

DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn , cSQL, 'tmpPQSL_Scan_Code' )
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL,nConn , nSQLEXEC, 'tmpPQSL_Scan_Code')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
*	TrackError(cSQL,"SQLEXECError","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
ENDIF

IF USED('tmpPQSL_Scan_Code')
	IF VARTYPE(tmpPQSL_Scan_Code.Descript) = "C"
		cDescript	= PrepareSQLtxt(tmpPQSL_Scan_Code.Descript,'Descript',30)
		nMin		= PrepareSQLnum(tmpPQSL_Scan_Code.Min,'Min',-3)
		nMax		= PrepareSQLnum(tmpPQSL_Scan_Code.Max,'Max',-3)
		cBase		= PrepareSQLtxt(tmpPQSL_Scan_Code.Base,'Base',2)
	ELSE
		TrackError("cScanCode='"+cScanCode+"' Scan_Code_Limits(cScanCode,nScanNum,nScanOrderItem)","Did not find descript by Code!","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	ENDIF
	USE IN tmpPQSL_Scan_Code
ENDIF

************************************
*Test

IF nScanOrderItem > 0
	IF nScanOrderItem >= nMin AND nScanOrderItem <= nMax
		*nScanOrderItem number passed
		*get nScanNumber for Base
		
		IF LEN(ALLTRIM(cBase))>0
			
			cSQL = "SELECT Min, Max "
			cSQL = cSQL + " FROM dbo.Scan_Code WITH(NOLOCK) "
			cSQL = cSQL + " WHERE CODE = '"+cBase+"'"

			SELECT 0
			nSQLEXEC = SQLEXEC(nConn , cSQL, 'tmpPQSL_Scan_Code')

			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConn , cSQL, 'tmpPQSL_Scan_Code' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,nConn , nSQLEXEC, 'tmpPQSL_Scan_Code')
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
				*TrackError(cSQL,"SQLEXECError","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
			ENDIF

			IF USED('tmpPQSL_Scan_Code')
				IF VARTYPE(tmpPQSL_Scan_Code.Min) = "N"
					nMin		= PrepareSQLnum(tmpPQSL_Scan_Code.Min,'Min',-3)
					nMax		= PrepareSQLnum(tmpPQSL_Scan_Code.Max,'Max',-3)
				ELSE
					TrackError("cScanCode='"+cBase+"' Scan_Code_Limits(cScanCode,nScanNum,nScanOrderItem)","Did not find Min,Max by BaseCode!","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
				ENDIF
				USE IN tmpPQSL_Scan_Code
			ENDIF
		ENDIF		
		
		
	ELSE
		*report error
		IF nScanOrderItem < nMin
			MESSAGEBOX("This '"+cScanCode+"' requires a minimium of "+ALLTRIM(STR(nMin))+" nScanOrderItem="+ALLTRIM(STR(nScanOrderItem))+CHR(13)+"This error will be sent to David",0+48,"Error")
			TrackError("This '"+cScanCode+"' requires a at least of "+ALLTRIM(STR(nScanOrderItem))+" nScanNum="+ALLTRIM(STR(nScanOrderItem)),"Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
		ENDIF
		IF nScanOrderItem > nMax
			MESSAGEBOX("This '"+cScanCode+"' requires a maximium of "+ALLTRIM(STR(nMax))+" nScanNum="+ALLTRIM(nScanNum)+CHR(13)+"This error will be sent to David",0+48,"Error")
			TrackError("This '"+cScanCode+"' requires a limit of "+ALLTRIM(STR(nMax))+" nScanNum="+ALLTRIM(nScanNum),"Over Max","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
		ENDIF	
	ENDIF
ENDIF

*************************************

IF nScanNum >= nMin AND nScanNum <= nMax
	*Scan number passed
ELSE
	IF nScanNum < nMin
		MESSAGEBOX("This '"+cScanCode+"' requires a minimium of "+ALLTRIM(STR(nMin))+" nScanNum="+ALLTRIM(STR(nScanNum))+CHR(13)+"This error will be sent to David",0+48,"Error")
		TrackError("This '"+cScanCode+"' requires a at least of "+ALLTRIM(STR(nMin))+" nScanNum="+ALLTRIM(STR(nScanNum)),"Under Min","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	ENDIF
	IF nScanNum > nMax
		MESSAGEBOX("This '"+cScanCode+"' requires a maximium of "+ALLTRIM(STR(nMax))+" nScanNum="+ALLTRIM(STR(nScanNum))+CHR(13)+"This error will be sent to David",0+48,"Error")
		TrackError("This '"+cScanCode+"' requires a limit of "+ALLTRIM(STR(nMax))+" nScanNum="+ALLTRIM(STR(nScanNum)),"Over Max","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	ENDIF	
ENDIF

*************************************
IF lNewConn 
	IF nConn > 0
		= SQLDISCONNECT(nConn)
	ENDIF
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN 
ENDPROC

