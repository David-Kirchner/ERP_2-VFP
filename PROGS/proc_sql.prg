PROCEDURE Get_Qoute_P 
PARAMETERS nPieces, cAlloy, cForm, nThck, nSz2, nSz3, nWeight, nP_lb, nP_pc, nP_ft, nLotP,cOtherFld,nOtherP, nConn
*nP = Get_Qoute_P (nPieces, cAlloy, cForm, nThck, nSz2, nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConn)

IF VARTYPE(nPieces) != "N"
*	RecordError( 0, 'PARAMETERS ', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"VFP message: No cAlloy Parameter" )
	RETURN 0
ENDIF
IF VARTYPE(cAlloy) != "C"
*	RecordError( 0, 'PARAMETERS ', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"VFP message: No cAlloy Parameter" )
	RETURN 0
ENDIF
IF VARTYPE(cForm) != "C"
	RETURN 0
ENDIF
IF VARTYPE(nThck) != "N"
	nThck = 0
ENDIF
IF VARTYPE(nSz2) != "N"
	nSz2 = 0
ENDIF
IF VARTYPE(nSz3) != "N"
	nSz3 = 0
ENDIF
IF VARTYPE(nWeight) != "N"
	nWeight = 0
ENDIF
IF VARTYPE(nP_lb) != "N"
	nP_lb = 0
ENDIF
IF VARTYPE(nP_pc) != "N"
	nP_pc = 0
ENDIF
IF VARTYPE(nP_ft) != "N"
	nP_ft = 0
ENDIF
IF VARTYPE(nLotP) != "N"
	nLotP = 0
ENDIF

IF VARTYPE(cOtherFld) != "C"
	cOtherFld = ''
ENDIF
IF NOT ( VARTYPE(nOtherP) = "N" OR VARTYPE(nOtherP) = "Y" )
	nOtherP = 0
ENDIF
*------------

PRIVATE lCloseConn

IF VARTYPE(nConn) != "N"
	nConn = 0 
ENDIF
IF nConn < 1
	nConn = get_SQLSTRINGCONNECT() 
	lCloseConn = .T.
ELSE
	lCloseConn = .F.
ENDIF
nConn = CheckSQLConnection(nConn)

PRIVATE nFtLen, nLen, nSigDim
nFtLen = 0
nLen = 0
		
PRIVATE nNew_P, nNew_QTY, n_PU
nNew_P	= 0
nNew_QTY	= 0
n_PU	= GetPUfromForm( cForm, nConn )

*------------
IF nLotP = 0
	* get Universal LotP
	DO CASE
	CASE nP_lb > 0
	
		IF nWeight = 0
			nWeight = CalcWeight(nPieces, cAlloy, cForm, nThck, nSz2, nSz3, nConn )
		ENDIF
		
		IF nWeight > 0
			nLotP = nP_lb * nWeight
			nNew_QTY = nWeight
			nNew_P = nP_Lb
		ELSE
			nLotP = -1
		ENDIF
		
	CASE nP_Ft > 0
	
		nSigDim = getSigDim(cForm, nConn )
		IF nSigDim = 2
			nFtLen = IIF(nPieces<1,1,nPieces) * nSz2/12
		ENDIF
		IF nSigDim = 3 OR nSigDim = 6
			nFtLen = IIF(nPieces<1,1,nPieces) * nSz3/12
		ENDIF	
		IF nFtLen > 0
			nLotP	= nP_Ft * nFtLen
			nNew_QTY = nFtLen
			nNew_P	= nP_Ft
		ELSE
			nLotP = -1
		ENDIF	
		
	CASE nP_Pc > 0
		IF nPieces > 0
			nLotP	= nP_Pc * nPieces
			nNew_QTY = nPieces
			nNew_P	= nP_Pc
		ELSE
			nLotP = -1
		ENDIF
		
	CASE UPPER(cOtherFld) = "PER INCH"

		nSigDim = getSigDim(cForm, nConn )
		IF nSigDim = 2
			nLen = IIF(nPieces<1,1,nPieces) * nSz2
		ENDIF
		IF nSigDim = 3 OR nSigDim = 6
			nLen = IIF(nPieces<1,1,nPieces) * nSz3
		ENDIF	
		IF nLen > 0
			nLotP	= nOtherP * nLen
			nNew_QTY = nLen
			nNew_P	= nOtherP 
		ELSE
			nLotP = -1
		ENDIF	

	CASE UPPER(cOtherFld) = "PER KG"

		IF nOtherP > 0
			nLotP	= nOtherP * nWeight/2.2
			nNew_QTY = nWeight/2.2
			nNew_P	= nOtherP 
		ELSE
			nLotP = -1
		ENDIF
			
	ENDCASE
ENDIF

*------------

DO CASE
CASE n_PU = 1
	* $/Lb
	IF nP_lb = 0 AND nNew_P = 0
		*Convert to $/Lb
		IF nWeight = 0
			nWeight = CalcWeight(nPieces, cAlloy, cForm, nThck, nSz2, nSz3, nConn )
		ENDIF

		IF nWeight > 0
			IF nLotP > 0
				nNew_P = ROUND( nLotP / nWeight, 4)
			ENDIF
		ENDIF
	ENDIF
	
CASE n_PU = 2
	* $/Ft
	IF nP_Ft = 0 AND nNew_P = 0
		*Convert to $/Ft
		IF nFtLen = 0
			nSigDim = getSigDim(cForm, nConn )
			IF nSigDim = 2
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz2/12
			ENDIF
			IF nSigDim = 3 OR nSigDim = 6
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz3/12
			ENDIF	
		ENDIF
		IF nFtLen > 0
			IF nLotP > 0
				nNew_P = ROUND( nLotP / nFtLen, 4)
			ENDIF
		ENDIF
	ENDIF
		
CASE n_PU = 3
	* $/Pc
	IF nP_Pc = 0 AND nNew_P = 0
		IF nPieces > 0
			IF nLotP > 0
				nNew_P = ROUND( nLotP / nPieces, 4)
			ENDIF
		ENDIF
	ENDIF
		
OTHERWISE
	*nNew_P = 0
ENDCASE

*------------

IF lCloseConn
	SQLDISCONNECT( nConn )
ENDIF

* problem at STR(nQ_P,18,8) - Why does it return =******************,

RETURN nNew_P 
ENDPROC

