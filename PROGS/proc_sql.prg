PROC PrepareSQLdate 
PARAMETER uData, cField, plReturnNull, plQuite
*cReturn = PrepareSQLdate('  /  /  ','Date' ,.F.,.T.) &&,.T.,.T.
*Removes Time
*Defaults to Not return NULL and Not Quite
*use PrepareSQLdatetime() to keep time.
*Also see ShowSQLdate('1900-01-01')

IF VARTYPE(cField) != "C"
	WAIT WINDOW "Parameters: PrepareSQLdate('  /  /  ','Date')" NOWAIT
	SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
	TrackError("no Field data. ","Proc_Sql:PrepareSQLdate() was called with no Field Parameter","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	cField = "Field"
*	RETURN uData
ENDIF
PRIVATE lReturnNull
IF VARTYPE(plReturnNull) = "L"
	lReturnNull = plReturnNull
ELSE
	lReturnNull = .F.
ENDIF

IF VARTYPE(uData)="T"
	*Take the Time out
	uData = CTOD( DTOC( uData ) )
ENDIF

PRIVATE lQuite
lQuite = .F.
IF VARTYPE(plQuite) = "L"
	lQuite = plQuite
ELSE
	lQuite = .F.
ENDIF

PRIVATE nMonth, nDay, nYear
IF VARTYPE(uData) <> "D"
	IF VARTYPE(uData) = "C"
		*Change to Date
		*uData = '01-02-24'
		*uData = '2024-02-24'
		DO CASE
		CASE LEN(uData) = 10 AND ( AT('-',uData,1)=5 OR AT('/',uData,1)=5 )
			*first string has 4 charaters like a year
			TRY
				uData = TTOD( uData )
			CATCH
				uData = CTOD( uData )
			ENDTRY
			
		CASE LEN(uData) = 10 AND ( AT('-',uData,2)>1 OR AT('/',uData,2)>1 )
			*has 2 seperators like a date
			nMonth = VAL(LEFT(uData,4))
			nDay = ABS(VAL(SUBSTR(uData,3,3)))
			IF nDay=0 &&VAL found first character was not number
				nDay = VAL(SUBSTR(uData,4,2))
			ENDIF
			nYear = VAL(SUBSTR(uData,7,4))
			*when 7,4 is 24__ then VAL is 0
			*when 7,4 is 2024 then VAL is 2024
			IF nYear < 1900 OR nYear > 2100
				*just check last 2 in 4
				nYear = VAL(SUBSTR(uData,9,2))+2000
			ENDIF
			IF nYear < 1900 OR nYear > 2100
				*just check last 2 of 2
				*uData length is 10, but uses only 8
				nYear = VAL(SUBSTR(uData,7,2))+2000
			ENDIF
			TRY
				uData = DATE(nMonth, nDay, nYear)
			CATCH
				PRIVATE cMess
				cMess = "uData:"+uData+CHR(13)
				cMess = cMess + "Month:"+ALLTRIM(STR(nMonth))+CHR(13)
				cMess = cMess + "  Day:"+ALLTRIM(STR(nDay))+CHR(13)
				cMess = cMess + " Year:"+ALLTRIM(STR(nYear))+CHR(13)
				cMess = cMess + "cField:"+cField
				TrackError(cMess,"PROC_SQL:PrepareSQLdate Failed", PROGRAM(), LINENO(1))
				
				MESSAGEBOX("Your Date entered as a string of characters did not convert to a real Date the computer knows"+CHR(13)+cMess ,0,"This is probably bad")
			ENDTRY
				
			*uData = TTOD( uData )
		
		CASE LEN(uData) = 8 AND ( AT('-',uData,2)>1 OR AT('/',uData,2)>1 )
			*has 2 seperators like a date
			nMonth = VAL(LEFT(uData,4))
			nDay = ABS(VAL(SUBSTR(uData,3,3)))
			IF nDay=0 &&VAL found first character was not number
				nDay = VAL(SUBSTR(uData,4,2))
			ENDIF
			nYear = VAL(SUBSTR(uData,7,2))+2000
			
			IF nMonth  = 0 AND nDay =0 AND nYear = 2000
				*must be empty
			ELSE
				TRY
					uData = DATE(nYear, nMonth, nDay)
				CATCH
					PRIVATE cMess
					cMess = "uData:"+uData+CHR(13)
					cMess = cMess + "Month:"+ALLTRIM(STR(nMonth))+CHR(13)
					cMess = cMess + "  Day:"+ALLTRIM(STR(nDay))+CHR(13)
					cMess = cMess + " Year:"+ALLTRIM(STR(nYear))+CHR(13)
					cMess = cMess + "cField:"+cField
					TrackError(cMess,"PROC_SQL:PrepareSQLdate Failed", PROGRAM(), LINENO(1))
					
					MESSAGEBOX("Your Date entered as a string of characters did not convert to a real Date the computer knows"+CHR(13)+cMess ,0,"This is probably bad")
				
				ENDTRY
			ENDIF				
			*uData = TTOD( uData )

		OTHERWISE
			IF AT(" ",uData) > 1 &&Has time Also
				uData= CTOD( LEFT(uData,AT(" ",uData)-1) )
			ELSE
				uData= CTOD( uData)
			ENDIF
		ENDCASE
		
	ENDIF	
	IF VARTYPE(uData) <> "D"
		*uData= CTOD( "  /  /  " )
		uData = ''
	ENDIF
ENDIF

IF VARTYPE(uData) = "D"
	IF uData = CTOD("01/01/00")
		*uData = ''
		uData = CTOD("00/00/00")
	ENDIF
ENDIF
IF VARTYPE(uData) = "D"
	IF uData = CTOD("01/01/1900")
		*uData = ''
		uData = CTOD("00/00/00")
	ENDIF
ENDIF

IF NOT ( EMPTY(uData) OR ISNULL(uData) )
	*Is Date within 10 years!
	IF uData > DATE() + 3650  OR uData < DATE() - 3650
		IF NOT (UPPER(cField) = "ERRORDATE" ;
				OR UPPER(cField) = "CUSTOMERSINCE" ;
				OR UPPER(cField) = "LASTINVOICE" ;
				OR UPPER(cField) = "LASTEDIT" )
			IF NOT lQuite 
				MESSAGEBOX( "Warning, your date: "+DTOC(uData)+" for field: "+ALLTRIM(cField)+CHR(13)+" is not within 10 years.",0+48,"Bad Date")
				TrackError("Warning, your date: "+DTOC(uData)+" for field: "+ALLTRIM(cField)+CHR(13)+" is not within 10 years"+". ","Proc_Sql:PrepareSQLdate()","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
			ENDIF
		ENDIF
	ENDIF
	IF uData > DATE() + 36500  OR uData < DATE() - 36500
		*more than 100 years out!
		STORE .NULL. TO uData 
	ENDIF
ENDIF

IF lReturnNull
	IF EMPTY(uData)
		STORE .NULL. TO uData 
	ENDIF
ELSE
	IF EMPTY(uData) OR ISNULL(uData)
		*uData = "  /  /  "
		uData = CTOD("")
	ENDIF
ENDIF


RETURN uData

ENDPROC
