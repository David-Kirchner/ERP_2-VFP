PRIVATE cdoPDFFileName, cPDF_Report, cNewFileName
cdoPDFFileName = ''
cPDF_Report	= ''
PRIVATE m.n

IF lUsePDF_Report 
	*Give time for System finish writing file
	WAIT WINDOW "Waiting for PDF" TIMEOUT 2
	
	IF AT(';',cPassedFileNames) > 0
		cPDF_Report = LEFT(cPassedFileNames,AT(';',cPassedFileNames)-1)
	ELSE
		cPDF_Report = cPassedFileNames
	ENDIF
	
	m.n = 0
	DO WHILE NOT FILE(cPDF_Report)
		m.n = m.n + 1
		IF m.n > 60
			EXIT
		ENDIF
		IF m.n > 3 
			WAIT WINDOW "PDF File not Ready. '"+AllTrim(cPDF_Report)+"' Waiting "+ALLTRIM(STR(m.n))+"/ 60 Seconds" TIMEOUT 1
		ENDIF

		IF NOT FILE(cPDF_Report)
			IF FILE( LEFT(cPDF_Report,LEN(cPDF_Report)-4)+"_frx.pdf" ) 
				*Add _frx
				cPDF_Report= LEFT(cPDF_Report,LEN(cPDF_Report)-4)+"_frx.pdf" 
			ELSE
				IF FILE( LEFT(cPDF_Report,LEN(cPDF_Report)-8)+".pdf" )
					*Remove _frx
					cPDF_Report=  LEFT(cPDF_Report,LEN(cPDF_Report)-8)+".pdf" 
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT FILE(cPDF_Report)
			*Try doPDF
			*C_Program Files_HPA_Reports_faxsalesorder02_frx.pdf
			IF UPPER(RIGHT(cPDF_Report,8)) = "_FRX.PDF" 
				*Remove _frx
				cdoPDFFileName =  LEFT(cPDF_Report,LEN(cPDF_Report)-8)+".pdf" 
			ELSE
				cdoPDFFileName = cPDF_Report
			ENDIF
			
			PRIVATE cdoPDFFileName1
			TRY
				cdoPDFFileName1 = LEFT(cPDF_Report, AT("\",cPDF_Report,OCCURS("\",cPDF_Report)) ) 
				cdoPDFFileName1 = cdoPDFFileName1 + RIGHT( cdoPDFFileName ,LEN(cdoPDFFileName)-AT('_',cdoPDFFileName,OCCURS('_',cdoPDFFileName)) )
				cdoPDFFileName = cdoPDFFileName1
			CATCH TO oErr1
				?[  Error: ] + STR(oErr1.ErrorNo)
		    	?[  LineNo: ] + STR(oErr1.LineNo) 
		    	?[  Message: ] + oErr1.Message 
		    	?[  Procedure: ] + oErr1.Procedure 
		    	?[  Details: ] + oErr1.Details 
		    	?[  StackLevel: ] + STR(oErr1.StackLevel) 
		    	?[  LineContents: ] + oErr1.LineContents 
		    	
		    	TrackMess([  Error: ] + STR(oErr1.ErrorNo)+[  LineNo: ] + STR(oErr1.LineNo)+CHR(13)+[  Message: ] + oErr1.Message+[  Procedure: ] + oErr1.Procedure+CHR(13)+[  Details: ] + oErr1.Details+[  StackLevel: ] + STR(oErr1.StackLevel) +CHR(13)+[  LineContents: ] + oErr1.LineContents )
		    	
		  		cdoPDFFileName1 = ""
			ENDTRY
		ELSE
			cdoPDFFileName = cPDF_Report
		ENDIF
		
	ENDDO
	
*	IF FILE(cdoPDFFileName1)
*		cdoPDFFileName = cdoPDFFileName1
*	ENDIF

	IF LEFT(cPDF_Report,2) = "//"
		*already set to SQL share
		cPassedFileNames = cPDF_Report
	ELSE
		IF "\MEM" $ SYS(2003)
			cNewFileName = SYS(5)+SYS(2003)+"\"+cdoPDFFileName
		ELSE
			cNewFileName = SYS(5)+SYS(2003)+"\MEM\"+cdoPDFFileName
		ENDIF	
		*Check local, clean file of same name.
		IF FILE(cNewFileName )
			DELETE FILE cNewFileName 
			WAIT WINDOW "Clear files from Server" TIMEOUT 1
		ENDIF


		COPY FILE ["]+cdoPDFFileName+["] TO cNewFileName 
		WAIT WINDOW "Copying your file "+cdoPDFFileName+" to MEM." TIMEOUT 1

		*use new PDF File name in cPassedFileNames
		cPassedFileNames = STRTRAN( cPassedFileNames, cdoPDFFileName, cNewFileName )
	ENDIF
ENDIF

