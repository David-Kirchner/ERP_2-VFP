PARAMETERS cPOItem, nConn
*IsHaveNew_PO_DueDate ( cPOItem, ThisForm.ConnHandle )

IF VARTYPE(cPOItem) != "C"
	RETURN CTOD('')
ENDIF
IF VARTYPE(nConn) != "N"
	RETURN CTOD('')
ENDIF
IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
	SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
ENDIF
IF Proper_PO_Item(cPOItem) = Proper_PO_Item("")
	RETURN CTOD('')
ENDIF

nConn = CheckSQLConnection(nConn)
PRIVATE cSQL, nSQLEXEC 
PRIVATE cAlias 
cAlias = ALIAS()


IF USED("tmpPQSL_PO_DueDate")
	USE IN tmpPQSL_PO_DueDate
ENDIF

cSQL = "SELECT dbo.f_BestDate(due_Max,due_Min) AS Due, dbo.F_BestDate(HPA_Due_Max,HPA_Due_Min) AS HPA_Due, First_Due_Max "
cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) WHERE "
cSQL = cSQL + " POItem = dbo.f_ProperPOitem('"+cPOItem+"')"

SELECT 0
nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_PO_DueDate')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_PO_DueDate')
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_PO_DueDate')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ENDIF

PRIVATE lIsHaveNew_PO_DueDate, lNoFirst_Due_Date
lIsHaveNew_PO_DueDate = .F.
lNotFirst_Due_Date = .F.

PRIVATE dHPA_Due, dDue, dNew_Due_Max, dFirst_Due_Max,'First_Due_Max')

IF USED("tmpPQSL_PO_DueDate")
	
	IF RECCOUNT("tmpPQSL_PO_DueDate") > 0
		dHPA_Due	= PrepareSQLdate(tmpPQSL_PO_DueDate.HPA_Due,'HPA_Due',.F.,.T.)  &&,.F.,.T.
		dDue		= PrepareSQLdate(tmpPQSL_PO_DueDate.Due,'Due',.F.,.T.)
		dNew_Due_Max = DATE()-720
		dFirst_Due_Max	= PrepareSQLdate(tmpPQSL_PO_DueDate.First_Due_Max,'First_Due_Max',.F.,.T.)
		
		IF dFirst_Due_Max != CTOD('')
			lNotFirst_Due_Date = .F.
			IF dDue != CTOD('')
				IF dDue > dFirst_Due_Max
					lIsHaveNew_PO_DueDate = .T.
				ENDIF
			ENDIF
			IF dHPA_Due != CTOD('')
				IF dHPA_Due > dFirst_Due_Max
					lIsHaveNew_PO_DueDate = .T.
				ENDIF
			ENDIF

		ELSE
			*No First_Due_Date
			lNotFirst_Due_Date = .T.
			lIsHaveNew_PO_DueDate = .F.
		ENDIF
		
		IF NOT ( VARTYPE(tmpPQSL_PO_DueDate.First_Due_Max)='D' OR  VARTYPE(tmpPQSL_PO_DueDate.First_Due_Max)='T' )
			*No First_Due_Max
			lNotFirst_Due_Date = .T.
			lIsHaveNew_PO_DueDate = .F.
		ENDIF
	ELSE
		*No Record
		lNotFirst_Due_Date = .F.
		lIsHaveNew_PO_DueDate = .F.
	ENDIF
			
	USE IN tmpPQSL_PO_DueDate
ENDIF

IF lNotFirst_Due_Date
	IF Proper_PO_item(cPOItem) != Proper_PO_item('')
		*Add First Due Date
