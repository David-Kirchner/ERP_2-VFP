PROCEDURE INSERT_Alloy 
PARAMETER pcAlloy,nConn

IF VARTYPE(pcAlloy) != "C"
	RETURN .F.
ENDIF
IF EMPTY(pcAlloy)
	RETURN .F.
ENDIF
IF VARTYPE(nConn) != "N"
	RETURN .F.
ENDIF
nConn = CheckSQLConnection(nConn)
PRIVATE cAlias 
cAlias = ALIAS()
PRIVATE cSQL, nSQLEXEC
PRIVATE cAlloy
cAlloy = PrepareSQLtxt( pcAlloy, 'Alloy', 12 )

PRIVATE lFoundinAlloy,lFoundinAlloys,lFoundinAlloysAKA
lFoundinAlloy	= .F.
lFoundinAlloys	= .F.
lFoundinAlloysAKA	= .F.

PRIVATE lRollBack
lRollBack = .F.

*****Check for Alloy
IF USED('tmpPQSL_CountAlloy')
	USE IN tmpPQSL_CountAlloy
ENDIF
SELECT 0

cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Alloy WITH(NOLOCK) WHERE Alloy = '"+cAlloy+"'"

nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CountAlloy' )

DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CountAlloy' )
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL,nConn, nSQLEXEC, 'tmpPQSL_CountAlloy')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ENDIF

IF USED('tmpPQSL_CountAlloy')
	IF tmpPQSL_CountAlloy.Cntd > 0
		MESSAGEBOX( "Alloy:"+cAlloy+" already exists.",0+48,"Cannot add to Alloy")
		lFoundinAlloy = .T.
	ENDIF
	USE IN tmpPQSL_CountAlloy
ENDIF

*****Check for Alloys
IF USED('tmpPQSL_CountAlloys')
	USE IN tmpPQSL_CountAlloys
ENDIF
SELECT 0

cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Alloys WITH(NOLOCK) WHERE Alloy = '"+cAlloy+"'"

nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CountAlloys' )

DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CountAlloys' )
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL,nConn, nSQLEXEC, 'tmpPQSL_CountAlloys')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ENDIF

IF USED('tmpPQSL_CountAlloys')
	IF tmpPQSL_CountAlloys.Cntd > 0
		MESSAGEBOX( "Alloy:"+cAlloy+" already exists.",0+48,"Cannot add to Alloys")
		lFoundinAlloys = .T.
	ENDIF
	USE IN tmpPQSL_CountAlloys
ENDIF

*****Check for AlloysAKA
IF USED('tmpPQSL_CountAlloys')
	USE IN tmpPQSL_CountAlloys
ENDIF
SELECT 0

cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Alloys WITH(NOLOCK) WHERE Alloys = '"+cAlloy+"'"

nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CountAlloys' )

DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_CountAlloys' )
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL,nConn, nSQLEXEC, 'tmpPQSL_CountAlloys')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ENDIF

IF USED('tmpPQSL_CountAlloys')
	IF tmpPQSL_CountAlloys.Cntd > 0
		MESSAGEBOX( "Alloy:"+cAlloy+" already exists as AKA.",0+48,"Cannot add to Alloys")
		lFoundinAlloysAKA = .T.
	ENDIF
	USE IN tmpPQSL_CountAlloys
ENDIF

*****
PRIVATE lTranAlreadySet, nProp 
nProp = SQLGETPROP(nConn, 'Transactions')
lTranAlreadySet = (nProp = 2)
		
IF NOT lTranAlreadySet
	SQLSETPROP(nConn, 'Transactions', 2)  && 1AUTO, 2MANUAL Trans
ENDIF

*****
IF NOT lFoundinAlloy
	cSQL = "INSERT INTO dbo.Alloy (Alloy) VALUES "
	cSQL = cSQL + "('"+cAlloy+"')"

	nSQLEXEC = SQLEXEC(nConn, cSQL )

	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC( nConn, cSQL )
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL,nConn, nSQLEXEC, '')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		lRollBack = .T.
	ELSE
		TrackMess( "INSERT_Alloy: "+cSQL +" "+CHR(13)+SYS(16,1))
	ENDIF
ENDIF

*****

IF NOT lRollBack
	IF NOT lFoundinAlloys AND lFoundinAlloysAKA
		*Must remove AKA -It was found leading to another Alloy
		cSQL = "DELETE FROM dbo.Alloys WHERE Alloys = '"+cAlloy+"'"
		
		nSQLEXEC = SQLEXEC(nConn, cSQL )

		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConn, cSQL )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,nConn, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			lRollBack = .T.
			TrackMess( cSQL+": Failed."+" "+CHR(13)+SYS(16,1) )
			TrackError(cSQL,"Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
		ELSE
			TrackMess( cSQL+": Success."+" "+CHR(13)+SYS(16,1) )
		ENDIF
	ENDIF
	
	IF NOT lFoundinAlloys OR NOT lFoundinAlloysAKA
		cSQL = "INSERT INTO dbo.Alloys (Alloy,Alloys) VALUES "
		cSQL = cSQL + "('"+cAlloy+"'"
		cSQL = cSQL + ",'"+cAlloy+"')"

		nSQLEXEC = SQLEXEC(nConn, cSQL )

		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConn, cSQL )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,nConn, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			lRollBack = .T.
			TrackMess( "INSERT_Alloy: "+cSQL+": Failed."+" "+CHR(13)+SYS(16,1) )
			TrackError(cSQL,"Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
		ELSE
			TrackMess( "INSERT_Alloy: "+cSQL+": Success."+" "+CHR(13)+SYS(16,1) )
		ENDIF
	ENDIF
ENDIF
*****

IF lRollBack
	IF NOT lTranAlreadySet
		SQLROLLBACK(nConn)
	ENDIF
ELSE
	IF NOT lTranAlreadySet
		SQLCOMMIT(nConn)
	ENDIF
ENDIF
IF NOT lTranAlreadySet
	SQLSETPROP(nConn, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans
ENDIF

***********
IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

ENDPROC

