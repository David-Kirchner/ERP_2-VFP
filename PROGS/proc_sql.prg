PROC PrepareSQLphone 
PARAMETER cData,cField, nOption
*PrepareSQLphone ("7659458230",'Phone',1)
*strips ()-

IF VARTYPE(cData) = "N"
	cData = STR( cDATA )
ENDIF
IF VARTYPE(cData) != "C"
	RETURN ""
ENDIF
IF VARTYPE(cField) != "C"
	WAIT WINDOW [PARAMETERS: PrepareSQLphone ("7659458230",'Phone',1)] NOWAIT
	TrackError("no Phone Field"+", Data="+LEFT(cData,30)+". ","Bad Phone.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	cField = "Field"
*	RETURN ""
ENDIF
IF VARTYPE(nOption) != "N"
	nOption = 0
ENDIF
DO CASE
CASE nOption = 0
*Strip all but numbers
	cData = STRTRAN( cData, "(", "" )
	cData = STRTRAN( cData, ")", "" )
	cData = STRTRAN( cData, "-", "" )
	cData = STRTRAN( cData, " ", "" )
CASE nOption = 1
*Add '() - 'to numbers
	cData = STRTRAN( cData, "(", "" )
	cData = STRTRAN( cData, ")", "" )
	cData = STRTRAN( cData, "-", "" )
	cData = STRTRAN( cData, " ", "" )
	cData = ALLTRIM( cData )
	IF LEN(cData) = 7
		cData = "   "+cData
	ENDIF
	IF LEN(cData)<10
		cData = PADR( cData, 10, " ")
	ENDIF
	cPhone = "("+LEFT(cData,3)+")"+SUBSTR( cData, 4, 3)+"-"+RIGHT( cData,4)
	cData = cPhone
ENDCASE

RETURN cData

ENDPROC

