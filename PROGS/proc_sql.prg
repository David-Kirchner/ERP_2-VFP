PROC AlertShopof_SOEdit 
PARAMETER pSalesNum, pConnHandle
*AlertShopof_SOEdit( nSalesNum, ThisForm.nConnHandle )

DO CASE
CASE VARTYPE(pSalesNum) = "C"
	pSalesNum= VAL(pSalesNum)
CASE VARTYPE(pSalesNum) = "N"
*	pSalesNum= pSalesNum
OTHERWISE
	pSalesNum = 0
ENDCASE

IF EMPTY(pSalesNum)
	RETURN .F.
ENDIF

*
PRIVATE nConn, lNewConn, nItemPO, cSQL
lNewConn = .F.
nItemPO = 0
IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
		nConn = pConnHandle
