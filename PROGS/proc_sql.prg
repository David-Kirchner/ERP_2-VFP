PROCEDURE GetPipePSI 
PARAMETERS pnThck,pnSz2, nConn
*GetPipePSI( cPOitem, cTBL, ThisForm.nConnHandle )

IF VARTYPE(pnThck) != "N"
	RecordError( 0, 'GetPipePSI', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"No Thck" )
	RETURN 0
ENDIF
IF VARTYPE(pnSz2) != "N"
	RecordError( 0, 'GetPipePSI', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"No Sz2" )
	RETURN 0
ENDIF
IF VARTYPE(nConn) != "N"
	RecordError( 0, 'GetPipePSI', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"No pConn" )
	RETURN 0
ENDIF


PRIVATE nPipe_PSI
nPipe_PSI = 0

PRIVATE cAlias 
cAlias = ALIAS()
PRIVATE cSQL, nSQLEXEC 
**
IF USED("tmp_PSI")
	USE IN tmp_PSI
ENDIF
cSQL = "SELECT TOP 1 [lbs_in] "
cSQL = cSQL + " FROM [dbo].[WPipe] "
cSQL = cSQL + " WHERE [nPipeSize] = "+STR(pnThck,9,4)
cSQL = cSQL + " AND [Schedule] = '"+ALLTRIM( STR(pnSz2) ) +"'"

SELECT 0
nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmp_PSI')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmp_PSI')
ENDDO
IF nSQLEXEC < 0 &&Try again!
	nSQLEXEC = SQLEXEC(nConn, cSQL, "tmp_PSI")
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL 2' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQL, "tmp_PSI")

		IF nSQLEXEC < 0
			IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
				nSQLEXEC = 0
			ENDIF
		ENDIF
	ENDDO
ENDIF
IF nSQLEXEC < 0
	IF SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmp_PSI')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ENDIF
ENDIF

IF USED("tmp_PSI")
	IF VARTYPE(tmp_PSI.lbs_in)="N"
		nPipe_PSI = tmp_PSI.lbs_in
	ENDIF
	USE IN tmp_PSI
ENDIF
**

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.", "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN nPipe_PSI
ENDPROC

