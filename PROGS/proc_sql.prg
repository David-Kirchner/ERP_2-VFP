		IF tmpPQSL_POcnt.CNTD = 0
			*Not Found
			
			cSQLu = "UPDATE dbo.AllQuotes "
			cSQLu=cSQLu+" SET HPAPO = "+ALLTRIM(STR(nHPAPO))
			cSQLu=cSQLu+",BuyFrom='"+cBuyFrom+"'"
			cSQLu=cSQLu+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			nSQLEXEC = SQLEXEC(nConn, cSQLu, '')
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQLu, '' )
			ENDDO
			IF nSQLEXEC < 0
				lOK = .F.
				SQLEXECError(cSQLu, nConn, nSQLEXEC, '')
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQLu )
			ENDIF
			
			lDone = .T.
		ENDIF
		USE IN tmpPQSL_POcnt
	ENDIF
ENDIF

IF NOT lDone
	*does not Already exists
	*HPAPO is already filled, use HPAPO2

	cSQLu = "UPDATE dbo.AllQuotes "
	cSQLu=cSQLu+" SET HPAPO2 = "+ALLTRIM(STR(nHPAPO))
	cSQLu=cSQLu+",BuyFrom2='"+cBuyFrom+"'"
	cSQLu=cSQLu+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
	
	nSQLEXEC = SQLEXEC(nConn, cSQLu, '')
	
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQLu, '' )
	ENDDO
	IF nSQLEXEC < 0
		lOK = .F.
		SQLEXECError(cSQLu, nConn, nSQLEXEC, '')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQLu )
	ENDIF
	
	lDone = .T.
ENDIF

IF nConn != pConnHandle
	 = SQLDISCONNECT(nConn )
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
