PROC Load_PoStatusDef 
PARAMETER pConnHandle

PRIVATE nConn 
IF VARTYPE(pConnHandle) = "N"
	nConn = pConnHandle
ELSE
	nConn = get_SQLSTRINGCONNECT()
	pConnHandle = 0
ENDIF
nConn = CheckSQLConnection(nConn)

	IF USED("postatusdef")
		USE IN postatusdef
	ENDIF
	SELECT 0

	IF nConn > 0
	
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.POStatusDef WITH(NOLOCK) "

		nSQLEXEC = SQLEXEC(nConn, cSQL, 'postatusdef')

		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConn, cSQL, 'postatusdef' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,nConn, nSQLEXEC, 'postatusdef')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF

		IF USED('postatusdef')
			SELECT postatusdef
		ENDIF
		
		IF nConn != pConnHandle
			SQLDISCONNECT( nConn )
		ENDIF
		
	ELSE
		TrackMess( "Proc_Sql:Load_postatusdef() Failed to open connect to SQL"+" "+CHR(13)+SYS(16,1))
	ENDIF

ENDPROC
	
