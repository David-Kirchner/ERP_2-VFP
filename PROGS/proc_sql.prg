	IF Reccount('tmpPQSL_Sales_Hold' )> 0
		SCAN
		
			lSOitem_ON_Hold = PrepareSQLlogic(tmpPQSL_Sales_Hold.Hold,'Hold')		
			
			IF lSOitem_ON_Hold 
				IF NOT lFoundOneTrue 
					lFoundOneTrue = .T.
				ENDIF
				IF cWhat <> "ALL"	&&Atleast one item is on Hold
					lSO_ON_Hold = .T.
				ENDIF
			ELSE
			IF NOT lFoundOneFalse 
