PROCEDURE PO_No_Update_Rev 
PARAMETERS nPO, nConn
*PO_No_Update_Rev(nHPAPO,ThisFormSet.nConnHandle)
*Only updates where Printed and has changed
*use getPO_NO_Rev to get Rev

IF VARTYPE(nPO) != "N"
	RETURN .F.
ENDIF
IF VARTYPE(nConn) != "N"
	RETURN .F.
ENDIF
IF nPO < 1
	RETURN .F.
ENDIF
nConn = CheckSQLConnection(nConn)

*Read PO_No!
PRIVATE cSQL, nSQLEXEC 
PRIVATE cAlias 
cAlias = ALIAS()

IF USED("tmpPQSL_SumPO")
	USE IN tmpPQSL_SumPO
ENDIF
cSQL = "SELECT "
cSQL = cSQL + " PO_Rev, Changing, Printed"
cSQL = cSQL + ",Reconciled, Cancelled "
cSQL = cSQL + " FROM dbo.PO_No WITH(NOLOCK) "
cSQL = cSQL + " WHERE HPAPO="+STR(nPO)

SELECT 0
nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_SumPO')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_SumPO')
ENDDO
IF nSQLEXEC < 0
	SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_SumPO')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ENDIF


PRIVATE lChanging, lPrinted, nPO_Rev, lReconciled, lCancelled
lChanging = .F.
lPrinted = .F.
nPO_Rev = 0
lReconciled = .F.
lCancelled = .F.

IF USED("tmpPQSL_SumPO")
	IF RECCOUNT("tmpPQSL_SumPO") > 0
		
		lChanging 	= PrepareSQLlogic(tmpPQSL_SumPO.Changing,'Changing',.F.)
		lPrinted  	= PrepareSQLlogic(tmpPQSL_SumPO.Printed ,'Printed',.F.)
		nPO_Rev 	= PrepareSQLnum(tmpPQSL_SumPO.PO_Rev,'PO_Rev',-1)
		lReconciled = PrepareSQLlogic(tmpPQSL_SumPO.Reconciled,'Reconciled',.F.)
		lCancelled 	= PrepareSQLlogic(tmpPQSL_SumPO.Cancelled,'Cancelled',.F.)
		
		USE IN tmpPQSL_SumPO
	ELSE
		USE IN tmpPQSL_SumPO
		
		*Did not find the HPAPO
		*Create new PO_No if PO exists in PurchaseOrder
		IF Count_HPAPOinPurchaseOrder(nPO,nConn,"NOTCANCELLED") > 0
			cSQL = "INSERT INTO dbo.PO_No "
			cSQL = cSQL + " (HPAPO, PO_Rev, Changing, Printed, Cancelled)"
			cSQL = cSQL + " VALUES ("
			cSQL = cSQL + STR(nPO)+",0,0,0,0 ) "

			nSQLEXEC = SQLEXEC( nConn, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConn, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, '')
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
			lChanging = .F.
			lPrinted  = .F.
			nPO_Rev = 0
		ENDIF
	ENDIF
ENDIF

*****
IF NOT ( lReconciled OR lCancelled )
	*Only Update Rev if PO has been Printed
	IF lPrinted   


		*Only Update Rev on a Printed, Changing PO
		IF lChanging 
			
			nPO_Rev = nPO_Rev + 1
			
			*UPDATE Current Rev
			cSQL = "UPDATE dbo.PO_No "
			cSQL = cSQL + " SET PO_Rev="+ALLTRIM(STR(nPO_Rev))
			cSQL = cSQL + " ,Changing = 0"
			cSQL = cSQL + " ,Printed = 0"
			cSQL = cSQL + " WHERE HPAPO="+STR(nPO)
			cSQL = cSQL + " AND ISNULL(Reconciled,0) = 0"
			cSQL = cSQL + " AND ISNULL(Cancelled,0) = 0"

			SELECT 0
			nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_SumPO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPQSL_SumPO')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_SumPO')
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
		ELSE
			*Not Changed!
		ENDIF
	ELSE
		*Not printed!
	ENDIF
ELSE
	*Not Active
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF


RETURN .T.
ENDPROC

