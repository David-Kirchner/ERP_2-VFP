				cMess = cMess + "This specific entry has the"+CHR(13)
				cMess = cMess + "Company '"+ctmpPQSL_Company+"'"+CHR(13)
				cMess = cMess + "Name '"+ctmpPQSL_Name +"'"+CHR(13)
				
				nMess = MESSAGEBOX(cMess ,4+48,"Replace the QuickCompany CustomerID?")
					
				IF nMess = 6
					*lReturn = SaveCustID_AllQuotes(cCustID, pnSO, nConn )
					cSQL = "UPDATE dbo.QuickCompany "
					cSQL = cSQL +" SET Customer = '"+cCustID+"'"
					cSQL = cSQL +" WHERE Customer ='"+cOldCustID+"'"
					cSQL = cSQL +" AND Company ='"+ctmpPQSL_Company+"'"
					cSQL = cSQL +" AND Name = '"+ctmpPQSL_Name+"'"

