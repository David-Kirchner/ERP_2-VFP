PROCEDURE SQLExecError 
PARAMETER pSQL, pnConnection, nSQLEXEC, cWorkArea
* Returns True if reconnected.

***********************************
*reference in Proc_ERP
***********************************
*SQLExecError('Sql String',nConnection, nSQLEXEC, cWorkArea )
IF TYPE('pSQL') != "C"
	pSQL = "No Parameter pass to SQLExecError"
ENDIF
IF ISNULL(pSQL)
	pSQL = " "
ENDIF
IF TYPE("pnConnection") = 'L'
	pnConnection = 0
	*Not Passed
ENDIF
IF TYPE("pnConnection") != "N"
	pnConnection = 0
ENDIF
IF VARTYPE(nSQLEXEC) != "N"
	nSQLEXEC = 0
ENDIF
IF VARTYPE(cWorkArea) != "C"
	cWorkArea = ""
ENDIF
pnConnection = CheckSQLConnection(pnConnection)

PRIVATE lWorked
lWorked = .F.

PRIVATE naErrors
naErrors = AERROR(aErrors)  &&Create Array aErrors

PRIVATE cAlias 
cAlias = ALIAS()

PRIVATE lWriteError
lWriteError = .T.

PRIVATE pSQLorig
pSQLorig = pSQL

*IF mess1<>'Record Test Data.'

*!*	*Record Error of Screen
*!*	TRY
*!*	*	cRun = "ErrorCapture.EXE " +["Proc_ERP:RecordError: ]+SYS(0)+[" VFP@SpaceAlloysUSA.com ]
*!*	*	cRun = "ErrorCapture.EXE " +["Proc_ERP:RecordError: ]+SYS(0)+[" David.Kirchner@Windfall.HPA.local ]
*!*		cRun = "ErrorCapture.EXE " +["Proc_ERP:RecordError: ]+SYS(0)+[" VFP@SpaceAlloysUSA.com ]
*!*		RUN /N &cRun

*!*	CATCH
*!*	*	MESSAGEBOX("Error Capture was not run"+CHR(13)+"Proc_ERP:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),16,"Could not run Error Capture.")
*!*	ENDTRY

*IF RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) = "David Kirchner"
IF RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) = "Talkt"
	IF MESSAGEBOX("Error, do you want to Trace?",1,"Trace") = 1
		debug
	    set step on
*	    set echo on
	    activate window debug 
	    activate window Trace
	    ACTIVATE WINDOW watch
	    ACTIVATE WINDOW view
	ENDIF
ENDIF

IF cWorkArea != "NORETRY"
	**See if Connection to SQL is good
	IF USED('TestSQL')
		USE IN testSQL
	ENDIF
	SELECT 0

	PRIVATE lConnection
	IF pnConnection > 0
		*Test Connection!
		lConnection = .T.
		TRY
			SQLEXEC( pnConnection, "SELECT GETDATE() as Today" , "TestSQL")
			
		CATCH 
			*Bad Connection
			lConnection = .F.
			*pnConnection = 0 *try to use the same connection number
		ENDTRY
		
		IF USED("TestSQL")
			IF VARTYPE( TestSQL.today ) = "T"
				*lConnection = .T.
				*lWorked = .T.
			ELSE
				lConnection = .F.
			ENDIF
			USE IN TestSQL
		ELSE
			lConnection = .F.
		ENDIF
		
		IF NOT lConnection 
			TRY 
				SQLDISCONNECT( pnConnection )
			CATCH
				*Can Not Disconnect!
				pnConnection = 0 &&try to use another connection number
			ENDTRY
			
			*Start a new nConnection 
			TRY
				nConnection = 0
				*IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
				*	SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
				*ENDIF
				WAIT WINDOW 'SQL' TIMEOUT 2
				
				DO WHILE nConnection >= 0
					*nConnection < pnConnection 
					*reopen the Connection to Same Connect number if possible!
					nConnection = get_SQLSTRINGCONNECT()
				ENDDO
				
				pSQLorig = pQSL
			
				lWriteError = .F.
				*pSQL = pSQL + CHR(13)+"-- reconnected thou! (TryCatch)"
				
				***retry with nConnection***
				IF pSQL != "No Parameter pass to SQLExecError"
					PRIVATE nSQLEXEC_ReTry
					nSQLEXEC_ReTry = 0
					IF LEN(cWorkArea)=0
						nSQLEXEC_ReTry = SQLEXEC( nConnection, pSQL )
					ELSE
						nSQLEXEC_ReTry = SQLEXEC( nConnection, pSQL , cWorkArea )
					ENDIF				
					IF nSQLEXEC_ReTry > 0
						pSQL = "-- reconnected; " + pSQLorig + CHR(13)+"-- Resent!"
						lWorked = .T.
					ELSE
						pSQL = pSQL + CHR(13)+"-- Retry Failed Proc_SQL:SQLExecError"
					ENDIF
				ENDIF
				
				****************************
				IF nConnection = pnConnection 
					*was able to use the same connection number
					pSQL = pSQL + CHR(13)+"-- SQLExecError() reconnected. Connection "+ALLTRIM(STR(nConnection))+" was kept as the same number."
					lWriteError = .T.
				ELSE
					pSQL = pSQL + CHR(13)+"-- SQLExecError() got a new Connection "+ALLTRIM(STR(nConnection))+" Vs "+ALLTRIM(STR(pnConnection))
					lWriteError = .T.
				ENDIF
				
			CATCH
				*Cannot reconnect
				pSQL = pSQL + CHR(13)+"-- Bad SQL Connection, reopen the Connection to Same Connect number if possible!"+CHR(13)+" CATCH:cannot connect (TryCatch)."
				lWriteError = .T.
				*lWorked = .F.
			ENDTRY
			
		ELSE
		
			*Connection was good, Retry the SQL
			PRIVATE nSQLEXEC_ReTry
			nSQLEXEC_ReTry = 0
			IF LEN(cWorkArea)=0
				TRY 
					nSQLEXEC_ReTry = SQLEXEC( pnConnection, pSQL )
					DO WHILE nSQLEXEC_ReTry = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC_ReTry = SQLEXEC(pnConnection, cSQL )
					ENDDO
				ENDTRY
			ELSE
				TRY 
					nSQLEXEC_ReTry = SQLEXEC( pnConnection, pSQL, cWorkArea )
					DO WHILE nSQLEXEC_ReTry = 0 
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC_ReTry = SQLEXEC(pnConnection, cSQL, cWorkArea )
					ENDDO
				ENDTRY
			ENDIF
					
			IF nSQLEXEC_ReTry > 0
				pSQL = "-- reconnected; " + pSQLorig + CHR(13)+"-- WORKED!"
				lWorked = .T.
			ELSE
				pSQL = pSQL + CHR(13)+"-- Retry Failed"
			ENDIF
				
			*lWriteError = .F.  &&write out this experience
		ENDIF
	ELSE
		*Did not connect!
		pnConnection = 0
	ENDIF
	**end SQL connection test
ENDIF

PRIVATE cLastVersion, cUserVersion, cVerMess
cLastVersion = ''
cUserVersion = ''
cVerMess=''
IF lWriteError
	TRY
		cUserVersion = Get_HPAVersion(.T.)
	CATCH
		cUserVersion= ''
	ENDTRY	
	
	TRY
		cLastVersion = AppSetup_get_LatestVersion()
	CATCH
		cLastVersion = ''
	ENDTRY	
	cVerMess = "Your HPA ver "+cUserVersion+" of Ver "+cLastVersion 
ENDIF

IF lWriteError
	PRIVATE Pnerror, pMessMemo, Pcprogram, Pnlineno, lCloseErrors
	lCloseErrors = .F.

	Pnerror = nSQLEXEC
	*pMessMemo = ALLTRIM(LEFT( pSQL + SPACE(254), 254))
	pMessMemo = pSQL
	Pcprogram = "SQLExecError() " 
	Pnlineno = 0
	
	IF naErrors > 0
		DO CASE
		CASE 'Arithmetic overflow' $ aErrors(1,2)
			RecordError(Pnerror, "SQLExecError() - Arithmetic overflow"+" LINENO(1)="+ALLTRIM(STR(LINENO(1))), "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(), pMessMemo)
			WAIT WINDOW "Arithmetic overflow! " + "Look for a large number type-O error. " + "Any key to continue..."
		CASE 'p_GetFullQuote' $ aErrors(1,2)
			RecordError(Pnerror, "SQLExecError() - No Permission"+" LINENO(1)="+ALLTRIM(STR(LINENO(1))), "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(), pMessMemo)
			WAIT WINDOW "Your account does not have Permission to run this! "  + "Any key to continue..."
		OTHERWISE
			RecordError(Pnerror, "SQL - Bad data! SQLExecError()"+" LINENO(1)="+ALLTRIM(STR(LINENO(1))), "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(), pMessMemo)
			WAIT WINDOW "Wrote SQL Error!" + " Any key to continue..."
		ENDCASE
	ELSE
	
		TRY 
			PRIVATE cPastProg
			cPastProg = PROGRAM(PROGRAM(-1)-1)
			RecordError(Pnerror, "SQL - Bad data! SQLExecError() TRYing RecordError.prg "+" LINENO(1)="+ALLTRIM(STR(LINENO(1))), "Proc_SQL:"+PROGRAM()+" @"+cPastProg, LINENO(), pMessMemo)
			WAIT WINDOW "Recorded Error!" + " Any key to continue..."+CHR(13)+"From: "+cPastProg+CHR(13)+cVerMess+CHR(13)+LEFT(pMessMemo,1000)
		CATCH
			MESSAGEBOX("TRY RecordError() Failed!",48,"Could not record the Error")
			IF SYS(0) = "SUPERMICRO # talkt"
				SET STEP ON
				RecordError(Pnerror, "SQL - Bad data! SQLExecError() TRYing RecordError.prg "+" LINENO(1)="+ALLTRIM(STR(LINENO(1))), "Proc_SQL:"+PROGRAM()+" @"+cPastProg, LINENO(), pMessMemo)
			ENDIF
			
		ENDTRY
		
	ENDIF	
ENDIF

IF lWriteError
	PRIVATE nRet
	PRIVATE nError1, cError1, cError2, cError3, cError
	IF naErrors > 0
		*disp memo like aErr1
		nError1 = aErrors(1,1)
		cError1 = 'Error:'+ALLTRIM(STR(nError1))
		cError2 = 'Mess:'+aErrors(1,2)
		cError3 = IIF(ISNULL(aErrors(1,3)),'','Param:'+aErrors(1,3))
		cError = cError1+CHR(13)+cError2+CHR(13)+cError3
		
		*1466 Connection handle is invalid.
		*1526 Connectivity error: "name".
		IF nError1 = 1466 OR nError1 = 1526
			IF AERROR(aErrorArray) > 0
				nErrorArray1 = IIF(ISNULL(aErrorArray(1)),0 ,aErrorArray(1))
				cErrorArray2 = IIF(ISNULL(aErrorArray(2)),'',aErrorArray(2))
				cErrorArray3 = IIF(ISNULL(aErrorArray(3)),'',aErrorArray(3))
				cErrorArray4 = IIF(ISNULL(aErrorArray(4)),'',aErrorArray(4))
				nErrorArray5 = IIF(ISNULL(aErrorArray(5)),0 ,aErrorArray(5))
				nErrorArray6 = IIF(ISNULL(aErrorArray(6)),0 ,aErrorArray(6))
				
				cSTR = 'Error number: ' + LTRIM(STR(nErrorArray1))+CHR(13)+;
				 'Error: ' + ALLTRIM(cErrorArray2)+CHR(13)+;
				 'ODBC: ' + ALLTRIM(cErrorArray3)+CHR(13)+;
				 'SQL state: ' + ALLTRIM(cErrorArray4)+CHR(13)+;
				 'ODBC Error: ' + ALLTRIM(STR(nErrorArray5 ))+CHR(13)+;
				 'connection handle: ' + ALLTRIM(STR(nErrorArray6 ))
				 
				IF nError1 = 1526 
					nRet=MESSAGEBOX(cSTR+CHR(13)+CHR(13)+;
					 'Do you want to retry?';
					 ,4+16,"ODBC Error, SQLExecError()")
				ELSE
					nRet = 7
				ENDIF
				
				IF nRet = 6
					RETRY
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF	
		
*		IF nError1 != 1526	

			MESSAGEBOX(cError+CHR(13)+CHR(13)+"Your HPA App Version:"+cUserVersion+" the lastest Version:"+cLastVersion+CHR(13)+"Command:"+pSQL,0,"SQL - Bad data! SQLExecError()")
			RecordError(nError1,cError2,"Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(), 'SQL - Bad data! SQLExecError()')
*		ENDIF
	ENDIF
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		IF UPPER(cAlias) != 'ERRORS'
			RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
		ENDIF
	ENDIF
ENDIF

RETURN lWorked
ENDPROC


