PROC PurchaseOrder_POitem_Cancel  
PARAMETER cPOitem, pConnHandle, plUnCancel
*PurchaseOrder_POitem_Cancel( cPOitem, ThisForm.nConnhandle, lUnCancel ) 
*cancels Purchase Order if Allowed
*Removes PO Stock!

IF VARTYPE(cPOitem) != "C"
	cPOitem = ""
ENDIF
IF EMPTY(cPOitem)
	RETURN .F.
ENDIF
IF Proper_PO_Item(cPOItem) = Proper_PO_Item("")
	RETURN .F.
ENDIF

PRIVATE cSQL, nConn
IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
		nConn = pConnHandle
	ELSE
		nConn = get_SQLSTRINGCONNECT()
	ENDIF
ELSE
	nConn = get_SQLSTRINGCONNECT()
	pConnHandle = 0
ENDIF
nConn = CheckSQLConnection(nConn)
PRIVATE lUnCancel
IF VARTYPE(plUnCancel) = "L"
	lUnCancel = plUnCancel
ELSE
	lUnCancel = .F.
ENDIF

PRIVATE cAlias 
cAlias = ALIAS()

PRIVATE lAllowPOCancel 
lAllowPOCancel = PurchaseOrder_Allow_Cancel(cPOitem,pConnHandle)
IF lAllowPOCancel &&PurchaseOrder_POitem_Cancel

	IF nConn > 0
		IF lUnCancel 
			cSQL = "UPDATE dbo.PurchaseOrder SET [Cancelled] = 0 "
			cSQL = cSQL + " WHERE dbo.f_ProperPOitem(PoItem) = dbo.f_ProperPOitem('"+cPOitem+"')"
		ELSE	
			cSQL = "UPDATE dbo.PurchaseOrder SET [Cancelled] = 1 "
			cSQL = cSQL + " ,Hold = 0 "
			cSQL = cSQL + " WHERE dbo.f_ProperPOitem(PoItem) = dbo.f_ProperPOitem('"+cPOitem+"')"
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn , cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC )
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			RETURN .F.
		ENDIF
		
		**************	
		IF lUnCancel 
			TrackMess("PO "+ALLTRIM(cPOitem)+" was UnCancelled"+" "+CHR(13)+SYS(16,1))
		ELSE
			PRIVATE cReturnMess
			cReturnMess= ''
			*DO FORM Forms\GetCancelReason WITH nSO TO cCancelReason
			DO FORM Forms\GetReason WITH "Why are you Cancelling PO item "+ALLTRIM(cPOitem)+"?", "Lost the Sales Order", .T. TO cReturnMess
			
			IF VARTYPE(cReturnMess) = "C"
				IF LEN(cReturnMess) > 1
					TrackMess("PO "+ALLTRIM(cPOitem)+" was Cancelled"+ CHR(13)+cReturnMess+" "+CHR(13)+SYS(16,1))
				ELSE
					TrackMess("PO "+ALLTRIM(cPOitem)+" was Cancelled"+" "+CHR(13)+SYS(16,1))
				ENDIF
			ELSE
				TrackMess("PO "+ALLTRIM(cPOitem)+" was Cancelled"+" "+CHR(13)+SYS(16,1))
			ENDIF
		ENDIF
		
		**************	
		*Remove Stock associated with Cancelled POitem		
		IF NOT lUnCancel 
			*Remove Stock for Cancelled PO!
			IF PurchaseOrder_POitem_Remove_StockLst( cPOitem, nConn ) 
				TrackMess( "Removed Stock associated with Cancelled POitem:"+ALLTRIM(cPOitem)+"."+" "+CHR(13)+SYS(16,1))
			ELSE
				TrackMess( "Did not remove Stock associated with Cancelled POitem:"+ALLTRIM(cPOitem)+"."+" "+CHR(13)+SYS(16,1))
			ENDIF
		ENDIF
		
		*********
		IF NOT lUnCancel	&&Cancel
			IF Proper_PO_Item(cPOItem) != Proper_PO_Item('0-00')
				*also Remove from Allquotes
				cSQL = "UPDATE dbo.AllQuotes "
				cSQL = cSQL + " SET HPAPO=0"
				cSQL = cSQL + ",BuyFrom='' "
				cSQL = cSQL + ",PoItem='' "
				cSQL = cSQL + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				nSQLEXEC = SQLEXEC(nConn, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, nConn, nSQLEXEC )
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
				ENDIF
				
				**** BuyFrom2
				cSQL = "UPDATE dbo.AllQuotes "
				cSQL = cSQL + " SET HPAPO2=0"
				cSQL = cSQL + ",BuyFrom2='' "
				cSQL = cSQL + " WHERE HPApo2 = "+STR(VAL(cPOitem))
				
				nSQLEXEC = SQLEXEC(nConn, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, nConn, nSQLEXEC )
					RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
				ENDIF
			ENDIF
		ENDIF
		
		***************
		IF nConn != pConnHandle
			SQLDISCONNECT( nConn )
		ENDIF
		
	ELSE
		*Error on Connection String
		TrackError("Could not Connect to SQL","Error on Connection String","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	ENDIF
ELSE
	*Not Allowed Permission to Cancel PO.
	*TrackError("Not Allowed Permission to Cancel PO.","Error on Connection String","Proc_SQL:PurchaseOrder_POitem_Cancel",LINENO())
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN .T.
ENDPROC

