PROC CheckSQLdate 
PARAMETER uData, cField, plQuite
*CheckSQLdate('  /  /  ','Date')
*See if within 10 years
*Also see ShowSQLdate('1900-01-01')

IF VARTYPE(cField) != "C"
	WAIT WINDOW "Parameters: CheckSQLdate('  /  /  ','Date')" NOWAIT
	TrackError("Proc_Sql:CheckSQLdate() has no cField Parameter","Proc_Sql:CheckSQLdate() was called with no Field Parameter","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	cField = "Field"
*	RETURN uData
ENDIF

IF VARTYPE(uData) = "T"
	*Take the Time out
	uData = CTOD( DTOC( uData ) )
ENDIF


PRIVATE lQuite
lQuite = .F.
IF VARTYPE(plQuite) = "L"
	lQuite = plQuite
ELSE
	lQuite = .F.
ENDIF


IF VARTYPE(uData) <> "D"
	IF VARTYPE(uData) = "C"
		*Change to Date
		IF LEN(uData) = 10 AND AT('-',uData,2)>1
			uData = DATETIME(VAL(LEFT(uData,4)),VAL(SUBSTR(uData,6,2)),VAL(SUBSTR(uData,9,2)))
			uData = TTOD( uData )
		ELSE
			IF AT(" ",uData) > 1 &&Has time Also
				uData= CTOD( LEFT(uData,AT(" ",uData)-1) )
			ELSE
				uData= CTOD( uData)
			ENDIF
		ENDIF

	ENDIF	
	IF VARTYPE(uData) <> "D"
		*uData= CTOD( "  /  /  " )
		uData = ''
	ENDIF
ENDIF

IF VARTYPE(uData) = "D"
	IF uData = CTOD("01/01/00")
		*uData = ''
		uData = CTOD("00/00/00")
	ENDIF
ENDIF
IF VARTYPE(uData) = "D"
	IF uData = CTOD("01/01/1900")
		*uData = ''
		uData = CTOD("00/00/00")
	ENDIF
ENDIF

IF NOT ( EMPTY(uData) OR ISNULL(uData) )
	*Is Date within 10 years!
	IF uData > DATE() + 3650  OR uData < DATE() - 3650
		IF NOT (UPPER(cField) = "ERRORDATE" ;
			OR UPPER(cField) = "CUSTOMERSINCE" ;
			OR UPPER(cField) = "LASTINVOICE" ;
			OR UPPER(cField) = "LASTEDIT" )
			
			IF NOT lQuiet
				MESSAGEBOX( "Warning, your date: "+DTOC(uData)+" for field: "+ALLTRIM(cField)+CHR(13)+" is not within 10 years.",0+48,"Bad Date")
				RETURN .F.
			ENDIF
					
		ENDIF
	ENDIF

ENDIF


RETURN .T.

ENDPROC

