PARAMETER cData, cField, nLen, pPad, lQuite
*ShowSQLtxt("Space Alloys USA'",'Company',25,.F.,.F.)
** Pad .T. to add spaces at end, Pad empty to ignore
* (-1) unlimited text 

IF VARTYPE(nLen) != "N"
	nLen = 0
ENDIF

PRIVATE lDate, lDateTime
lDate = .F.
lDateTime = .F.

IF VARTYPE(cData) = "Y"
	cData = MTON(cData)
ENDIF
IF VARTYPE(cData) = "N"
	IF nLen > 0
		cData = ALLTRIM(STR( cDATA,nLen ))
	ELSE
		cData = ALLTRIM(STR( cDATA ))
	ENDIF
ENDIF

IF VARTYPE(cData) = "T"
	cData = TTOC(cData)
	lDateTime = .T.
ENDIF
IF VARTYPE(cData) = "D"
	cData = DTOC( cDATA )
	lDate = .T.
ENDIF

IF VARTYPE(cData) != "C"
	RETURN ""
ENDIF

IF VARTYPE(cField) != "C"
	WAIT WINDOW [PARAMETERS: ShowSQLtxt("Space Alloys USA'",'Company',25,.F.)] NOWAIT
	cField = "Field"
	SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
	TrackError("cData="+LEFT(cData,30) +", Field="+LEFT(cField,30)+". ","Proc_Sql:ShowSQLtxt() has no Field","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
*	RETURN ""
ENDIF
*!*	IF VARTYPE(nLen) != "N"
*!*		WAIT WINDOW [PARAMETERS: ShowSQLtxt("Space Alloys USA'",'Company',25,.F.)] NOWAIT

*!*		RETURN ""
*!*	ENDIF


PRIVATE lPad
lPad = .F.
IF VARTYPE(pPad) = "C"
	IF UPPER(LEFT(pPad,1)) = "P"
		lPad = .T.
	ENDIF
ENDIF
IF VARTYPE(pPad) = "L"
	lPad = pPad
ENDIF
IF VARTYPE(pPad) = "N"
	IF pPad = 1
		lPad = .T.
	ELSE
		lPad = .F.
	ENDIF
ENDIF
IF VARTYPE(lQuite) != "L"
	lQuite = .F.
ENDIF

*REMOVE Dual quote mark
DO WHILE AT("''",cData) > 0
	cData = STRTRAN(cData,"''","'") 
ENDDO
 
*******
DO CASE 
CASE nLen = 0
	cData = ALLTRIM(cData)
	*remove waste
	IF lDate 
		*Clean text
		IF AT(" ",cData) > 1
			cData = LEFT(cData,AT(" ",cData)-1)
			*this strips the string to 8 characters unless year is 4 diget, then 10
		ENDIF
	ENDIF
	IF lDateTime 
		*Clean text
		IF AT(" 12:00:00",cData) > 1
			cData = LEFT(cData,AT(" 12:00:00",cData)-1)
			*this strips blank time out
		ENDIF		
	ENDIF
	
CASE nLen > 0
	cData = ALLTRIM(cData)
		
	IF LEN(cData) > nLen 

		cData = LEFT(cData,nLen)
		
		IF MOD( OCCURS("'", cData) ,2) = 1
			**Found unbalanced Quote
			IF RIGHT( cData, 1 ) = "'" AND nLen > 1
				**Found Last charater is Quote
				cData = LEFT(cData,nLen-1)
				IF NOT lQuite
					MESSAGEBOX( cField+" was trimmed to "+ALLTRIM(STR(nLen-1))+" text characters '"+cData+"'",0+64,"SQL Data Overflow prevented.")			
				ENDIF
			ELSE
				**
			ENDIF
		ELSE
			IF NOT lQuite
				MESSAGEBOX( cField+" was trimmed to "+ALLTRIM(STR(nLen))+" text characters '"+cData+"'",0+64,"SQL Data Overflow prevented.")			
			ENDIF
		ENDIF
	ENDIF
Otherwise
	*Do not Trim unlimited text (-1)
	*nLen = -1
ENDCASE

IF lPad 
	IF nLen > 0
		cData = PADR( cData , nLen, " ")
	ENDIF
ENDIF

************
DO CASE
CASE UPPER(cField) = "SOITEM"
	IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
	ENDIF
	cData = Proper_SO_Item(cData)
CASE UPPER(cField) = "POITEM"
