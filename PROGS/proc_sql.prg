PROC PurchaseOrder_POitem_Remove_StockLst 
PARAMETER cPOitem, pConnHandle

*lOK = PurchaseOrder_POitem_Remove_StockLst( cPOitem, ThisForm.nConnhandle ) 
*Check to see if exists in Receiving, if Received - do not Delete!
*Do Delete StockLst and Delete the Process

IF VARTYPE(cPOitem) != "C"
	cPOitem = ""
ENDIF
IF EMPTY(cPOitem)
	RETURN .F.
ENDIF
IF Proper_PO_Item(cPOItem) = Proper_PO_Item("")
	RETURN .F.
ENDIF
IF LEFT(ALLTRIM(cPOitem),2) = '0-'
	RETURN .F.
ENDIF

PRIVATE cSQL, nConn
IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
