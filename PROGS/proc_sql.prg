	RETURN ''
ENDIF

PRIVATE cPayType
cPayType = ''

DO CASE
CASE pPayType = '1'
	cPayType = "STD TERMS"
CASE pPayType = '2'
	cPayType = "COD"
CASE pPayType = '3'
	cPayType = "PREPAID"
CASE pPayType = '4'
	cPayType = "CANADA STD"
CASE pPayType = '5'
	cPayType = "CANADA COD"
CASE pPayType = '6'
	cPayType = "CANADA PP"
CASE pPayType = '7'
	cPayType = "FOREIGNSTD"
CASE pPayType = '8'
	cPayType = "FOREIGNCOD"
CASE pPayType = '9'
	cPayType = "FOREIGN PP"
ENDCASE	


RETURN cPayType 
ENDPROC

