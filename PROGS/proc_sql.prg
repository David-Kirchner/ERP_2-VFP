PROCEDURE getVendCode_Company 
PARAMETER cCompany, pConnHandle
*nVendCode = getVendCode_Company(cCompany,ThisForm.nConnHandle)
*Returns best VendCode from Vendor for Company

IF VARTYPE(cCompany) != "C"
	RETURN 0
ENDIF

PRIVATE nConn, lNewConn
lNewConn = .F.
IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
		nConn = pConnHandle
	ELSE
		nConn = get_SQLSTRINGCONNECT()
		lNewConn = .T.
	ENDIF
ELSE
	nConn = get_SQLSTRINGCONNECT()
	lNewConn = .T.
ENDIF
nConn = CheckSQLConnection(nConn)

PRIVATE nReturnVendCode
nReturnVendCode = 0

PRIVATE cAlias, cSQL 
cAlias = ALIAS()

IF USED('tmpPQSL_PeachID')
	USE IN tmpPQSL_PeachID
ENDIF
SELECT 0

cCompany = PrepareSQLtxt(cCompany,'Company',30)
IF nConn > 0 

	cSQL = "SELECT TOP 1 V1.VendCode FROM dbo.Vendor V1 WITH(NOLOCK) "
	cSQL = cSQL + " INNER JOIN dbo.Vendor V2 WITH(NOLOCK) ON V1.Company = V2.Company "
	cSQL = cSQL + " WHERE V2.Company LIKE '%"+ALLTRIM(cCompany)+"%'"
	cSQL = cSQL + " AND ISNULL(V1.QAApproved,0) > 0 "
*	cSQL = cSQL + " AND ISNULL(V1.Inactive,0) = 0 "
	cSQL = cSQL + " ORDER BY VendCode "
	
	SELECT 0
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_PeachID' )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn,  cSQL, 'tmpPQSL_PeachID' )
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_PeachID')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ENDIF
	
	IF USED('tmpPQSL_PeachID')
		IF VARTYPE(tmpPQSL_PeachID.VendCode) = "N"
			nReturnVendCode = tmpPQSL_PeachID.VendCode 
		ENDIF
		USE IN tmpPQSL_PeachID
	ENDIF
	
	************************
	IF nReturnVendCode  = 0
		*Get Approved, Ignore Inactive
		cSQL = "SELECT TOP 1 V1.VendCode FROM dbo.Vendor V1 WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.Vendor V2 WITH(NOLOCK) ON V1.Company = V2.Company "
		cSQL = cSQL + " WHERE V2.Company LIKE '%"+ALLTRIM(cCompany)+"%'"
		cSQL = cSQL + " AND ISNULL(V1.QAApproved,0) > 0"
		cSQL = cSQL + " ORDER BY VendCode "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_PeachID' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn,  cSQL, 'tmpPQSL_PeachID' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_PeachID')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		
		IF USED('tmpPQSL_PeachID')
			IF VARTYPE(tmpPQSL_PeachID.VendCode) = "N"
				nReturnVendCode = tmpPQSL_PeachID.VendCode 
			ENDIF
			USE IN tmpPQSL_PeachID
		ENDIF
	ENDIF
	************************	

	IF nReturnVendCode  = 0
		*Just Get Code without Approved or Inactive check
		cSQL = "SELECT TOP 1 VendCode FROM dbo.Vendor WITH(NOLOCK) "
		cSQL = cSQL + " WHERE Company LIKE '%"+ALLTRIM(cCompany)+"%'"
		cSQL = cSQL + " ORDER BY VendCode DESC"
		
		SELECT 0		
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_PeachID' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn,  cSQL, 'tmpPQSL_PeachID' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_PeachID')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		
		IF USED('tmpPQSL_PeachID')
			IF VARTYPE(tmpPQSL_PeachID.VendCode) = "N"
				nReturnVendCode = tmpPQSL_PeachID.VendCode 
			ENDIF
			USE IN tmpPQSL_PeachID
		ENDIF
	ENDIF
	************************

	IF lNewConn 
		SQLDISCONNECT( nConn )
	ENDIF

ELSE
	*Error on Connection String
	TrackError("Could not Connect to SQL","Error on Connection String","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN nReturnVendCode
ENDPROC

