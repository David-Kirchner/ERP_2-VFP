PROC Email_PS_SOi_NotComplete 
PARAMETER pcSOitem, pnPCS, pnPackingSlipNo, pConnHandle
*Email_PS_SONotComplete(cSOitem, nPS_No, ConnHandle )
*Alert with Email that PackingSlip did not complete the SOitem shipment!
*

IF VARTYPE(pcSOitem) != "C"
	RETURN .F.
ENDIF

IF VARTYPE(pnPackingSlipNo) != "N"
	RETURN .F.
ENDIF

IF VARTYPE(pnPCS) != "N"
	pnPCS = 0
ENDIF
PRIVATE cSOitem
cSOitem = PrePareSQLtxt(pcSOitem,'SOitem',10)

PRIVATE nConn, lNewConn
lNewConn = .F.

IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
		nConn = pConnHandle
	ELSE
		nConn = get_SQLSTRINGCONNECT()
		lNewConn = .T.
	ENDIF
ELSE
	nConn = get_SQLSTRINGCONNECT()
	lNewConn = .T.
ENDIF

IF nConn > 0
	PRIVATE nCountPCS, nQTY_Sold
	nCountPCS = Count_PCSbySOitem( cSOitem, nConn )
	nQTY_Sold = get_QTYbySOitem( cSOitem, nConn )
	
	IF nCountPCS > 0
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		PRIVATE cPackedDescript
		cPackedDescript = get_Description_of_Packed_in_PackingSlipNo(pnPackingSlipNo, nConn)
		
		PRIVATE cDescript
		cDescript = get_Description_of_SOitem_in_AllQuotes(cSOitem,nConn)
		
		PRIVATE cTitle,cBody,cEmail
		cTitle  = "The PackingSlip did not complete shipment for SOitem:"+ALLTRIM(cSOitem)
		cBody = "PackingSlip did not complete shipment for SOitem:"+ALLTRIM(cSOitem)+CHR(10)+CHR(13)
		cBody = cBody+HTML_SOitem(cSOitem,.F.)+CHR(10)+CHR(13)
		*cBody = cBody+HTML_SOitem(cSOitem,.T.)+CHR(10)+CHR(13)
		cBody = cBody+"The Packing Slip:"+ALLTRIM(STR(pnPackingSlipNo))+" only shipped "+ALLTRIM(STR(pnPCS))+" Pcs."+CHR(10)+CHR(13)
		
		cBody = cBody+HTML_PackingSlipNo(pnPackingSlipNo,.F.)+CHR(10)+CHR(13)
		*cBody = cBody+HTML_PackingSlipNo(pnPackingSlipNo,.T.)+CHR(10)+CHR(13)
		cBody = cBody+cPackedDescript+CHR(10)+CHR(13)
		cBody = cBody+"The Sales Order was for "+ALLTRIM(STR(nCountPCS))+" Pcs and "+ALLTRIM(STR(nQTY_Sold))+" QTY."+CHR(10)+CHR(13)
		cBody = cBody+cDescript+CHR(10)+CHR(13)
		cBody = cBody+'Machin-User = '+SYS(0)+CHR(10)+CHR(13)
		cBody = cBody+"Proc_SQL:Email_PS_SONotComplete()."
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE  &&Needed for AppSetup_Get_Email
		ENDIF 	
		cEmail	= AppSetup_Get_Email( SalesRepfromSO(cSOitem))
		Send_HTML_Email( cEmail,'VFP_Alert@SpaceAlloysUSA.com',cTitle,cBody,nConn,.T.,.T.)	
		
		PRIVATE cTxt
		cTxt = "PackingSlip did not complete shipment for SOitem:'"+cSOitem+"'"
		cTxt= cTxt+CHR(13)+"The Packing Slip:"+ALLTRIM(STR(pnPackingSlipNo))+" only shipped "+ALLTRIM(STR(pnPCS))+" Pcs."
		cTxt= cTxt+CHR(13)+cPackedDescript
		cTxt= cTxt+CHR(13)+"The Sales Order was for "+ALLTRIM(STR(nCountPCS))+" Pcs and "+ALLTRIM(STR(nQTY_Sold))+" QTY."
		cTxt= cTxt+CHR(13)+cDescript
		TrackMess(cTxt+" "+CHR(13)+SYS(16,1))
		
	ELSE
		*Was written as 0 PCs
	ENDIF
ENDIF

IF lNewConn 
	SQLDISCONNECT(nConn)
ENDIF
	
ENDPROC


