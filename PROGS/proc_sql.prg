	SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_PackingSlip')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ENDIF

PRIVATE cSOitem, lComplete 
IF USED('tmpPQSL_PackingSlip')
	SELECT tmpPQSL_PackingSlip
	
	SCAN
		lComplete = PrepareSQLchk(tmpPQSL_PackingSlip.SOitem_cmplt,'Complete',.F.)
		IF lComplete 
			cSOitem = tmpPQSL_PackingSlip.SOitem
			
			cSQL = "DELETE FROM dbo.StockLst_Process WHERE SOitem = '"+cSOitem+"'"
			cSQL = cSQL + " AND NOT "
			cSQL = cSQL + " ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
			** Do not limit to WHERE ProcessID = '' OR Process_ID = 'INCOMING  '
			** remove all!
			
			nSQLEXEC = SQLEXEC( nConn, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConn, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC )
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
			****
			cSQL = "DELETE FROM dbo.BrokerLst_Process WHERE SOitem = '"+cSOitem+"'"
			cSQL = cSQL + " AND NOT "
			cSQL = cSQL + " ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
			** Do not limit to WHERE ProcessID = '' OR Process_ID = 'INCOMING  '
			** remove all!
			
			nSQLEXEC = SQLEXEC( nConn, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConn, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC )
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF

			*SELECT received FROM dbo.Receiving WITH(NOLOCK) WHERE SOitem = cSOitem 
			*IF lDTreceived empty - Write Email!
			
			**Double check Sales, Sales_No and Ship
			TrackMess( "ScavangeAfterPackingSlip: Delete FROM dbo.StockLst_Process/BrokerLst_Process for SOitem:"+ALLTRIM(cSOitem)+"."+" "+CHR(13)+SYS(16,1))
			
		ENDIF
	ENDSCAN
	USE IN tmpPQSL_PackingSlip
ENDIF


