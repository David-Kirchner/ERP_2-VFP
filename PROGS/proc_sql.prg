				ENDIF
				IF cWhat = "ALL"	&&All items have to be on hold to be true
					lSO_ON_Hold = .F.
				ENDIF
			ENDIF
		ENDSCAN
	ENDIF
	USE IN tmpPQSL_Sales_Hold
	
	IF lSO_ON_Hold AND cWhat = "ALL"
		IF lFoundOneFalse 
			*Atleast is on hold, All is not
			lSO_ON_Hold = .F.
		ENDIF
	ENDIF
	IF NOT lSO_ON_Hold AND cWhat <> "ALL"
		*Atleast one is on hold
		IF lFoundOneTrue 
			lSO_ON_Hold = .T.
		ENDIF
	ENDIF
ENDIF

