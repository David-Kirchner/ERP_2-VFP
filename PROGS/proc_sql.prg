		IF tmpPQSL_cntPOiR_Sr.Cntd > 0
			MESSAGEBOX("PO Item "+ALLTRIM(cPOitem)+" has already been received!"+CHR(13)+"Cannot remove!"+CHR(13)+"To fix"+CHR(13)+"Cancel the Receiving Record first.",0+16,"Cannot remove this PO Item from Stock")
			TrackMess("PO Item "+ALLTRIM(cPOitem)+" has already been received!"+" Cannot remove this PO Item from Stock"+" "+CHR(13)+CHR(13)+"Cancel the Receiving Record first."+SYS(16,1))
			
			lAllowDelete  = .F.
		ENDIF
		USE IN tmpPQSL_cntPOiR_Sr
	ENDIF

	IF lAllowDelete  
		IF USED('tmpPQSL_CntStk')
			USE IN tmpPQSL_CntStk
		ENDIF
		
		***
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.StockLst_Master WITH(NOLOCK) "
		cSQL = cSQL +" WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_CntStk' )
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		IF USED('tmpPQSL_CntStk')
			IF tmpPQSL_CntStk.Cntd > 0
				*Found in StockLst
				lStockLst = .T.
			ENDIF
			USE IN tmpPQSL_CntStk
		ENDIF	
		
		***
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.BrokerLst_Master WITH(NOLOCK) "
		cSQL = cSQL +" WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_CntStk' )
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		IF USED('tmpPQSL_CntStk')
			IF tmpPQSL_CntStk.Cntd > 0
				*Found in BrokerLst
				lBrokerLst = .T.
			ENDIF
			USE IN tmpPQSL_CntStk
		ENDIF	
		***
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.WIPLst_Master WITH(NOLOCK) "
		cSQL = cSQL +" WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_CntStk' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_CntStk' )
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		IF USED('tmpPQSL_CntStk')
			IF tmpPQSL_CntStk.Cntd > 0
				*Found in BrokerLst
				lWIPLst = .T.
			ENDIF
			USE IN tmpPQSL_CntStk
		ENDIF				
	ENDIF
	
	************************* Stock
	IF lAllowDelete  
		IF lStockLst
			*Remove from StockLst
			*Get nMaster_ID
			
			IF USED('tmpPQSL_MasterID')
				USE IN tmpPQSL_MasterID
			ENDIF
			
			cSQL = "SELECT ID FROM dbo.StockLst_Master WITH(NOLOCK) "
			cSQL = cSQL +" WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+cPOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_MasterID' )
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
			IF USED('tmpPQSL_MasterID')
				IF VARTYPE(tmpPQSL_MasterID.ID) = "N"
					nMaster_ID = tmpPQSL_MasterID.ID
				ENDIF
			ENDIF
			
			IF Remove_Lst_ID("S",nMaster_ID,nConn,.T.,"Edit PO","Removed PO Item '"+cPOitem+"'")
				*calls:Remove_Lst_Detail_by_ID_Detail
				*create Reason Processes 
				*Calls:Remove_Lst_Process_by_ID_Detail
			
				
				IF Cancel_Detail_Process_POitem(cPOitem,nConn)
					IF Remove_Stock_listed_POitem(cPOitem,nConn)
						*cSQL = "DELETE FROM dbo.StockLst_Process WHERE "  
						*cSQL = cSQL + " PO_Item = dbo.f_ProperPOitem('"+cPOitem+"')"
						
						*TrackMess(cSQL+" "+CHR(13)+SYS(16,1))
					ELSE
					ENDIF
				ENDIF
				
*!*						cSQL = "DELETE FROM dbo.StockLst_Process WHERE "  
*!*						cSQL = cSQL + " PO_Item = dbo.f_ProperPOitem('"+cPOitem+"')"
*!*						*cSQL = cSQL + " AND Process_ID = 'SELECTED' " --11-05-14
*!*						
*!*						nSQLEXEC = SQLEXEC(nConn, cSQL )
*!*						DO WHILE nSQLEXEC = 0
*!*							WAIT WINDOW 'SQL' TIMEOUT 1
*!*							nSQLEXEC = SQLEXEC(nConn, cSQL )
*!*						ENDDO
*!*						IF nSQLEXEC < 0
*!*							SQLEXECError(cSQL, nConn, nSQLEXEC )
*		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
*!*						ELSE	
*!*							TrackMess(cSQL+" "+CHR(13)+SYS(16,1))
*!*						ENDIF

			ELSE
				lAllowDelete  = .F.
			ENDIF
			
		ENDIF
	ENDIF
	
	************************* Broker
	IF lAllowDelete 
		IF lBrokerLst 
			*Remove from BrokerLst
			*Get nMaster_ID
			
			IF USED('tmpPQSL_MasterID')
				USE IN tmpPQSL_MasterID
			ENDIF
			
			cSQL = "SELECT ID FROM dbo.BrokerLst_Master WITH(NOLOCK) "
			cSQL = cSQL +" WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_MasterID' )
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
			IF USED('tmpPQSL_MasterID')
				IF VARTYPE(tmpPQSL_MasterID.ID) = "N"
					nMaster_ID = tmpPQSL_MasterID.ID
				ENDIF
			ENDIF
						
			IF Remove_Lst_ID("B",nMaster_ID,nConn,.T.,"Edit PO","Removed PO Item '"+cPOitem+"'")
				*Remove BrockLst Process
				
				IF Cancel_Detail_Process_POitem(cPOitem,nConn)
					cSQL = "DELETE FROM dbo.BrokerLst_Process WHERE "  
					cSQL = cSQL + " PO_Item = dbo.f_ProperPOitem('"+cPOitem+"')"
					
					TrackMess(cSQL+" "+CHR(13)+SYS(16,1))
				ENDIF

			ELSE
				lAllowDelete  = .F.
			ENDIF
		ENDIF
	ENDIF
	
	************************* WIP
	IF lAllowDelete 
		IF lWIPLst 
			*Remove from WIPLst
			*Get nMaster_ID
			
			IF USED('tmpPQSL_MasterID')
				USE IN tmpPQSL_MasterID
			ENDIF
			
			cSQL = "SELECT ID FROM dbo.WIPLst_Master WITH(NOLOCK) "
			cSQL = cSQL +" WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_MasterID' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_MasterID' )
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
			IF USED('tmpPQSL_MasterID')
				IF VARTYPE(tmpPQSL_MasterID.ID) = "N"
					nMaster_ID = tmpPQSL_MasterID.ID
				ENDIF
			ENDIF
						
			IF Remove_Lst_ID("W",nMaster_ID,nConn,.T.,"Edit PO","Removed PO Item '"+cPOitem+"'")
				*Remove WIPLst Process
			
				IF Cancel_Detail_Process_POitem(cPOitem,nConn)
					cSQL = "DELETE FROM dbo.BrokerLst_Process WHERE "  
					cSQL = cSQL + " PO_Item = dbo.f_ProperPOitem('"+cPOitem+"')"
					
					TrackMess(cSQL+" "+CHR(13)+SYS(16,1))
				ENDIF
			ELSE
				lAllowDelete  = .F.
			ENDIF
		ENDIF
	ENDIF
	
	
	IF lAllowDelete  
		*PurchaseOrder Cancel is handled before now!
		
		IF NOT lStockLst AND NOT lBrokerLst AND NOT lWIPLst 
			TrackMess( "Could not find Stock to remove for POitem '"+ALLTRIM(cPOitem)+"'."+" "+CHR(13)+SYS(16,1))
			PO_Item_Notes( cPOitem, "PurchaseOrder_POitem_Remove_StockLst() 'Did not find Stock'", nConn) 
			*lAllowDelete  = .F.
		ELSE
			PO_Item_Notes( cPOitem, "PurchaseOrder_POitem_Remove_StockLst() 'Removed Stock'", nConn) 
		ENDIF
	ENDIF
	
ELSE
	*Error on Connection String
	TrackError("Could not Connect to SQL","Error on Connection String","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	lAllowDelete  = .F.
ENDIF


IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN lAllowDelete  
ENDPROC

