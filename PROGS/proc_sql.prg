ENDIF


IF USED("tmpPQSL_Tol")
	IF RECCOUNT('tmpPQSL_Tol') > 0
		IF tmpPQSL_Tol.Tol
			lisTol = .T.
		ENDIF
	ENDIF
	USE IN tmpPQSL_Tol
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

IF lNewConn 
	SQLDISCONNECT(nConn )
ENDIF

RETURN lisTol  
ENDPROC

