PROC PrepareSQLnum 
PARAMETER uData, cField, vWholeNumbers, vDecimalLen, vAllowNegative, lQuite
**
*STR(nExpr,nLength,nDeci)
*Decimal(7,3) would be PrepareSQLnum('','',7,3)  *Switched on 8-13-2008 *Matches the SQL info!
* -1 TinyInt, -2 SmallInt, -3 INT, -4 BigInt, -5 Money or 18,4
* Does not need a ShowSQLnum * just run PrepareSQLnum

PRIVATE cData 
cData = ''

IF ISNULL(uData) 
	RETURN 0
ENDIF
IF VARTYPE(cField) != "C"

	PRIVATE cMess
	DIMENSION aProgStack(1,1)
	ASTACKINFO(aProgStack)
	IF ALEN(aProgStack,2) > 1
		PRIVATE naItem 
		FOR naItem = 1 TO ALEN(aProgStack,1)
			cMess = "1 Call Stack Level: "+ALLTRIM(STR(aProgStack(naItem,1) ))+CHR(13)
	 		cMess = cMess + "2 Current program filename: "+ALLTRIM(aProgStack(naItem,2))+CHR(13)
			cMess = cMess + "3 Module or Object name: "+ALLTRIM(aProgStack(naItem,3))+CHR(13)
			cMess = cMess + "4 Module or Object Source filename: "+ALLTRIM(aProgStack(naItem,4))+CHR(13)
			cMess = cMess + "5 Line number in the object source file: "+ALLTRIM(STR(aProgStack(naItem,5) ))+CHR(13)
			cMess = cMess + "6 Source line contents: "+ALLTRIM(aProgStack(naItem,6))+CHR(13)+CHR(13)
		ENDFOR 
	ENDIF
	
	**********
	SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
	TrackError("Program:"+PROGRAM()+" cData="+ALLTRIM(LEFT(cData,30))+CHR(13)+cMess,"Proc_Sql:PrepareSQLnum() has no Field Name parameter!","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	WAIT WINDOW "Parameters: PrepareSQLnum(1234.56,'Number',6,2)" NOWAIT
		
	IF VARTYPE(cField) = "N"
		*No Field, move the rest of the parameters over.
		lQuite			= vAllowNegative
		vAllowNegative	= vDecimalLen
		vDecimalLen		= vWholeNumbers
		vWholeNumbers	= cField
	ENDIF
	
	cField = "Field"
*	RETURN uData
ENDIF

IF VARTYPE(uData) = "Y"
	uData = MTON(uData)
ENDIF

**********
DO CASE
CASE VARTYPE(uData)= "N"
	cData = STR( uData ,15,4)
CASE VARTYPE(uData)= "C"
	cData = uData
	DO CASE
	CASE LEFT(cData,1)="<"
		cData = SUBSTR(cData,2)
		uData = cData
	CASE LEFT(cData,1)=">"
		cData = SUBSTR(cData,2)
		uData = cData
	CASE LEFT(cData,1)="+"
		cData = SUBSTR(cData,2)
		uData = cData
	CASE LEFT(cData,1)="-"
		cData = SUBSTR(cData,2)
		uData = cData
	CASE LEFT(cData,1)="="
		cData = SUBSTR(cData,2)
		uData = cData
	CASE LEFT(cData,1)="*"
		cData = SUBSTR(cData,2)
		uData = cData
	CASE LEFT(cData,1)="/"
		cData = SUBSTR(cData,2)
		uData = cData
	ENDCASE
CASE VARTYPE(uData)= "Y"
*!*		IF VARTYPE(uData) = "Y"
			MESSAGEBOX("Let David know when this message appears"+CHR(13)+"and what your where doing."+CHR(13)+"Money was being checked as a Number!",32,"Allmost an Error!")
*!*		ENDIF
ENDCASE
**********
	
PRIVATE nWholeNumbers
nWholeNumbers = 0

IF VARTYPE(vWholeNumbers) != "N"
	WAIT WINDOW "Parameters Needed: PrepareSQLnum(1234.56,'Number',6,2)" NOWAIT
	SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
	TrackError("vWholeNumbers not a number. ","Proc_Sql:PrepareSQLnum() was called with no Len Parameter","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN uData
ENDIF
IF VARTYPE(nWholeNumbers) = "N"
	nWholeNumbers = vWholeNumbers
ENDIF

PRIVATE nDecimalLen
nDecimalLen = 0
IF VARTYPE(vDecimalLen) = "N"
	nDecimalLen = vDecimalLen
ENDIF

PRIVATE lAllowNegative 
lAllowNegative  = .T.
IF VARTYPE(vAllowNegative) != "L"
	lAllowNegative = .F.
ENDIF

IF VARTYPE(lQuite) != "L"
	lQuite = .F.
ENDIF


PRIVATE nDecimalSet
nDecimalSet = SET('Decimal')

PRIVATE nWholeNumberLen
nWholeNumberLen  = 0

IF nWholeNumbers > 0
	nWholeNumberLen = nWholeNumbers - nDecimalLen
ENDIF
IF nWholeNumberLen < 0
	nWholeNumberLen	= 0
	nWholeNumbers	= 0
ENDIF


IF VARTYPE(uData) = "C"
	IF nDecimalLen > 0
		SET DECIMALS TO nDecimalLen
		uData = VAL( uData )
	ELSE
		SET DECIMALS TO 0
		uData = VAL( uData )
	ENDIF
	SET DECIMALS TO nDecimalSet
ENDIF

IF VARTYPE(uData) != "N" 
	IF VARTYPE(uData) != "Y"
		RETURN 0
	ENDIF
ENDIF

DO CASE
	CASE nWholeNumbers = 0
		*Only Decimals
		
		IF uData >= 1
			*Found problem
			*uData is more than 1!

			SET DECIMALS TO 0
			nWholenumber = VAL( STR( INT(uData) ) )
			
			SET DECIMALS TO nDecimalLen
			uNewData = 	uData - nWholenumber 
			
			IF NOT lQuite 
				IF nDecimalLen > 0
					MESSAGEBOX( cField+" was trimmed to "+ALLTRIM(STR(uNewData,10,nDecimalLen))+" , Nothing above 1 allowed,  '"+ALLTRIM(STR(uData,10,nDecimalLen+1))+"' was too much.",0+64,"SQL Data Overflow prevented.")			
				ELSE
					MESSAGEBOX( cField+" was trimmed to "+ALLTRIM(STR(uNewData,10,10))+" , Nothing above 1 allowed,  '"+ALLTRIM(STR(uData,10,10))+"' was too much.",0+64,"SQL Data Overflow prevented.")			
				ENDIF
			ENDIF
			uData = uNewData 
				
			SET DECIMALS TO nDecimalSet
		ENDIF
		
		*Check Decimal length
		nDecimalAsWhole = ROUND( uData * 10^ nDecimalLen ,0)

		
		SET DECIMALS TO nDecimalLen - 2
		uNewData = nDecimalAsWhole / 10^ nDecimalLen
			
*		MESSAGEBOX( cField+" was trimmed to "+ALLTRIM(STR(uNewData ))+" ,  '"+ALLTRIM(STR(uData))+"' was too much.",0+64,"SQL Data Overflow prevented.")			
		uData = uNewData 
			
		SET DECIMALS TO nDecimalSet
		
		IF uData = 1
			SET DECIMALS TO nDecimalLen-1
			
			uData = 1 - ( 1 / 10^ nDecimalLen )
			
			SET DECIMALS TO nDecimalSet
		ENDIF
	CASE nWholeNumbers = -1
		*TinyInt
		IF uData > 255
			IF NOT lQuite 
				MESSAGEBOX( cField+" was set to 255,  '"+ALLTRIM(STR(uData))+"' was too much.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = 255
		ENDIF
		IF uData < 0
			IF NOT lQuite 
				MESSAGEBOX( cField+" was set to 0,  '"+ALLTRIM(STR(uData))+"' was too small.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = 255
		ENDIF
	CASE nWholeNumbers = -2
		*SmallInt –32768 to 32767
		IF uData > 32767
			IF NOT lQuite 
				MESSAGEBOX( cField+" was set to 32767,  '"+ALLTRIM(STR(uData))+"' was too much.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = 32767
		ENDIF
		IF uData < -32767
			IF NOT lQuite 
				MESSAGEBOX( cField+" was set to -32,67,  '"+ALLTRIM(STR(uData))+"' was too small.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = -32767
		ENDIF	
	CASE nWholeNumbers = -3
		*INT 2147483647
		* 9 full digits, 10th is up to 2
		IF uData > 2147483647
			IF NOT lQuite 
				MESSAGEBOX( cField+" was set to 2,147,483,647,  '"+ALLTRIM(STR(uData))+"' was too much.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = 2147483647
		ENDIF
		IF uData < -2147483647
			IF NOT lQuite 
				MESSAGEBOX( cField+" was set to -2,147,483,647,  '"+ALLTRIM(STR(uData))+"' was too small.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = -2147483647
		ENDIF
	CASE nWholeNumbers = -4
		*Big INT
		IF uData > 9223372036854775807
			IF NOT lQuite 
				MESSAGEBOX( cField+" was set to 9,223,372,036,854,775,807,  '"+ALLTRIM(STR(uData))+"' was too much.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = 9223372036854775807
		ENDIF
		IF uData < -9223372036854775807
			IF NOT lQuite 
				MESSAGEBOX( cField+" was set to -9,223,372,036,854,775,807,  '"+ALLTRIM(STR(uData))+"' was too small.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = -9223372036854775807
		ENDIF
	CASE nWholeNumbers = -5
		*Currency money
		IF VARTYPE(uData ) = "N"
			uData = NTOM( uData ) 
		ENDIF

OTHERWISE
	*Have a length max
	PRIVATE nWholeNumber, nFracDigits, nFracDigitsAsWhole 
	
****	OLD- DO NOT FOLLOW THIS
*!*		IF nDecimalLen > 0 -
*!*			nWholeNumberLen = nWholeNumberLen - nDecimalLen - 1  &&remove one for the decimal point
*!*			*If ColdWork is Decimal(3,3) The Pass in PrepareSQLnum(Value,'Coldwork',3,3) 
*!*		ENDIF

	IF uData > (( 10 ^ nWholeNumberLen ) -1 )
		SET DECIMALS TO nDecimalLen
		
		IF nWholeNumberLen > 1
			IF NOT lQuite 
				MESSAGEBOX( "Number "+cField+" was over Max Length, trimmed to "+ALLTRIM(STR(nWholeNumberLen))+" digits,  '"+ALLTRIM(STR(uData,10,10))+"' was too much.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = (( 10 ^ nWholeNumberLen ) -1 )
		ELSE
			IF NOT lQuite 
				MESSAGEBOX( "Number "+cField+" was trimmed! ",0+64,"SQL Data Overflow prevented.")			
			ENDIF
			uData = 0
		ENDIF
		
		SET DECIMALS TO nDecimalSet
	ENDIF
	
	IF nDecimalLen = 0
		uData = ROUND(uData,0)
	ELSE
		SET DECIMALS TO nDecimalLen
		
		nWholeNumber = ROUND(uData,0) 
		nFracDigits = uData - nWholeNumber 
		nFracDigitsAsWhole = (nFracDigits) * 10 ^ nDecimalLen
		nFracDigitsAsWhole = ROUND(nFracDigitsAsWhole ,0)
*		uData = nWholeNumber + ( nFracDigitsAsWhole / 10 ^ nDecimalLen )
		uData = nWholeNumber + ROUND( (nFracDigitsAsWhole / 10 ^ nDecimalLen ),nDecimalLen )
		
		SET DECIMALS TO nDecimalSet
	ENDIF
	
	IF UPPER(cField) = "RED_AREA"
		IF uData > 100
			IF NOT lQuite 
				uData = 100
				MESSAGEBOX( "Number "+cField+" was trimmed! "+CHR(13)+"100 is max.",0+64,"SQL Data Overflow prevented.")			
			ENDIF
		
		ENDIF
	ENDIF
	
ENDCASE

SET DECIMALS TO nDecimalSet

IF NOT lAllowNegative
	IF uData < 0
		uData = 0
	ENDIF
ENDIF

RETURN uData
ENDPROC

