		lS_Cancelled	= PrepareSQLlogic(tmpPQSL_Scncld.cncld,'cncld',.F.)
	ENDIF
	USE IN tmpPQSL_Scncld
ENDIF


*********************
*Get current PO's in PurchaseOrder related to this SOitem
PRIVATE nP_HPAPo
nP_HPAPo = 0

IF USED('tmpPQSL_POsoitem')
	USE IN tmpPQSL_POsoitem
ENDIF

SELECT 0
cSQL = "SELECT HPAPo,Company,Delivered,Cancelled FROM dbo.PurchaseOrder WITH(NOLOCK) "
cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"


nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_POsoitem')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_POsoitem' )
ENDDO
IF nSQLEXEC < 0
	lOK = .F.
	SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_POsoitem')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ENDIF
IF USED('tmpPQSL_POsoitem')
	IF RECCOUNT('tmpPQSL_POsoitem') > 0
		*Check this collection with what AllQuotes has
		SCAN
			nP_HPAPo	= PrepareSQLnum(tmpPQSL_POsoitem.HPAPo,'HPAPO',-3)
			cP_BuyFrom	= PrepareSQLtxt(tmpPQSL_POsoitem.Company,'Company',30)
			lP_Delivered	= PrepareSQLlogic(tmpPQSL_POsoitem.Delivered,'Delivered',.F.)
			lP_Cancelled	= PrepareSQLlogic(tmpPQSL_POsoitem.Cancelled,'Cancelled',.F.)
			
			DO CASE
			CASE nP_HPAPo = nAQHPAPo
				*IF lS_Cancelled
				*IF lP_Cancelled 

				LOOP
			CASE nP_HPAPo = nAQHPAPo2
				*IF lS_Cancelled
				*IF lP_Cancelled 
				
				LOOP
			OTHERWISE
				IF nAQHPAPo = 0
					**
					cSQLu = "UPDATE dbo.AllQuotes "
					cSQLu = cSQLu +" SET HPAPO = "+ALLTRIM(STR(nP_HPAPo))
					cSQLu = cSQLu +",BuyFrom='"+cP_BuyFrom+"'"
					cSQLu = cSQLu +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					
					nSQLEXEC = SQLEXEC(nConn, cSQLu, '')
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(nConn, cSQLu, '' )
					ENDDO
					IF nSQLEXEC < 0
						lOK = .F.
						SQLEXECError(cSQLu, nConn, nSQLEXEC, '')
						RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQLu )
					ELSE
						nAQHPAPo = nP_HPAPo
						cAQBuyFrom = cP_BuyFrom
					ENDIF
					**							
				ELSE
					IF nAQHPAPo2 = 0
						**
						cSQLu = "UPDATE dbo.AllQuotes "
						cSQLu = cSQLu +" SET HPAPO2 = "+ALLTRIM(STR(nP_HPAPo))
						cSQLu = cSQLu +",BuyFrom2='"+cP_BuyFrom+"'"
						cSQLu = cSQLu +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
						
						nSQLEXEC = SQLEXEC(nConn, cSQLu, '')
						
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(nConn, cSQLu, '' )
						ENDDO
						IF nSQLEXEC < 0
							lOK = .F.
							SQLEXECError(cSQLu, nConn, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQLu )
						ELSE
							nAQHPAPo2 = nP_HPAPo
							cAQBuyFrom2 = cP_BuyFrom
						ENDIF
						**								
					ELSE
						*nAQHPAPo and nAQHPAPo are used!
					ENDIF
				ENDIF
			ENDCASE
		ENDSCAN
	ELSE
		IF nAQHPAPo > 0 OR nAQHPAPo2 > 0
			* Problem
			* the AQ PO not found in PurchaseOrders
		ENDIF
	ENDIF
ELSE
	IF nAQHPAPo > 0 OR nAQHPAPo2 > 0
		* Problem
		* the AQ PO not found in PurchaseOrders
	ENDIF
ENDIF


lDone = .T.


IF nConn != pConnHandle
	 = SQLDISCONNECT(nConn)
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

Return lDone 
ENDPROC


