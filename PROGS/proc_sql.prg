PROC PrepareSQLemail 
PARAMETER cData,cField, nOption
*PrepareSQLemail("David@SpaceAlloysUSA.com",'Email' )
PRIVATE cMess
cMess = ''

IF VARTYPE(cData) != "C"
	RETURN "VFP_Alert@SpaceAlloysUSA.com"
ENDIF
IF VARTYPE(cField) != "C"
	TrackError("Proc_Sql:PrepareSQLemail() has no Email Field Name"+", Data="+LEFT(cData,30)+". ","Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	cField = "Field"
*	RETURN ""
ENDIF
IF VARTYPE(nOption) != "N"
	nOption = 0  &&Not used yet!!
ENDIF

cData = ALLTRIM(cData)
cData = STRTRAN(cData,"'","''")

IF LEN(cData) < 1
	RETURN ""
ENDIF

IF LEN(cData) < 3
	cMess = "The Email too short!"+CHR(13)+"Email is:"+cData
	MESSAGEBOX(cMess,32,"Bad Email address.")
	*TrackError(cMess ,"Bad Email address.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN "VFP_Alert@SpaceAlloysUSA.com"
ENDIF

IF OCCURS("@",cData) = 0
	cMess = "The Email should have an '@' symbol!"+CHR(13)+"Email is:"+cData
	MESSAGEBOX(cMess,32,"Bad Email address.")
	*TrackError(cMess ,"Bad Email address.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN "VFP_Alert@SpaceAlloysUSA.com"
ENDIF

IF RIGHT(cData,1) = ";"
	cData = LEFT(cData,LEN(cData)-1)
ENDIF

IF OCCURS("@",cData) > 0
	IF OCCURS("@",cData) > OCCURS(";",cData)+1
		cMess = "Each Email address should have only one '@' symbol!"+CHR(13)+"Seperate multiple address with ';'"+CHR(13)+"Email is:"+cData
		MESSAGEBOX(cMess,32,"Bad Email address.")
*		TrackError(cMess ,"Bad Email address.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
		RETURN ""
	ENDIF
ENDIF

IF AT(",",cData) > 0
	cMess = "The Email should not have one ',' symbol!"+CHR(13)+"Email is:"+cData
	MESSAGEBOX(cMess,32,"Bad Email address.")
	*TrackMess( "Proc_Sql:PrepareSQLemail() "+cMess +" "+CHR(13)+SYS(16,1))
*	TrackError(,cMess ,"Bad Email address.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN "VFP_Alert@SpaceAlloysUSA.com"
ENDIF

IF OCCURS(";",cData) > 0
	*remove a space before or after the semicolon
	cData = STRTRAN(cData," ;",";")
	cData = STRTRAN(cData,"; ",";")
	*remove more extra space
	cData = STRTRAN(cData," ;",";")
	cData = STRTRAN(cData,"; ",";")
	cData = STRTRAN(cData," ;",";")
	cData = STRTRAN(cData,"; ",";")
	cData = STRTRAN(cData," ;",";")
	cData = STRTRAN(cData,"; ",";")
ENDIF

IF OCCURS(" ",cData) > 0
	cMess = "The Email should not have a blank space ' '!"+CHR(13)+"Email is:"+cData
	MESSAGEBOX(cMess,32,"Bad Email address, blank space.")
*	TrackError(cMess ,"Bad Email address.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN ""
ENDIF

IF LEFT(cData,1) = "."
	cMess = "The Email should not begin with '.' symbol!"+CHR(13)+"Email is:"+cData
	MESSAGEBOX(cMess,32,"Bad Email address.")
*	TrackError( cMess ,"Bad Email address.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN ""
ENDIF

IF RIGHT(cData,1) = "."
	cMess = "The Email should not end with '.' symbol!"+CHR(13)+"Email is:"+cData
	MESSAGEBOX(cMess,32,"Bad Email address.")
*	TrackError(cMess,"Bad Email address.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	RETURN ""
ENDIF

RETURN cData

ENDPROC


