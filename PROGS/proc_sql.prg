	cSQL = cSQL +" WHERE dbo.f_ProperPOitem(R.POitem) = dbo.f_ProperPOitem('"+cPOitem+"') "
	cSQL = cSQL +" AND NOT ( ISNULL(R.Cancelled,0) = 1 OR ISNULL(R.Hold,0) = 1 )"
	*cSQL = cSQL +" AND P.Services = 0 AND P.ConvServ = 0 AND P.Equipment = 0 "
	*Remove Receieved Item if not meant for Stock -Service,Equipement
	
	SELECT 0
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_cntPOiR_Sr' )
