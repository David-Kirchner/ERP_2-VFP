PROC PurchaseOrder_Allow_Cancel 
PARAMETER cPOitem, pConnHandle
*Checks if Admin or the original user is trying to Cancel

IF VARTYPE(cPOitem) != "C"
	cPOitem = ""
ENDIF
IF EMPTY(cPOitem)
	RETURN .F.
ENDIF
IF Proper_PO_Item(cPOItem) = Proper_PO_Item("")
	RETURN .F.
ENDIF

PRIVATE cSQL, nConn
IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
		nConn = pConnHandle
	ELSE
		nConn = get_SQLSTRINGCONNECT()
	ENDIF
ELSE
	nConn = get_SQLSTRINGCONNECT()
	pConnHandle = 0
ENDIF
nConn = CheckSQLConnection(nConn)

PRIVATE cAlias 
cAlias = ALIAS()
*Check to see if person has Permission
PRIVATE lAllowPOCancel
lAllowPOCancel = .F.

*IF HavePermission('EditPOLate')
IF NOT AllowAdminPOCancel()	&&PurchaseOrder_Allow_Cancel
	PRIVATE cMach_User, cUserName
	cMach_User = SYS(0)
	cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
	cUserName = ALLTRIM(cUserName)
	
	PRIVATE cSalesP, cCoverP
	cSalesP = ''
	cCoverP = ''
	
	IF USED('tmpPQSL_POSalesP')
		USE IN tmpPQSL_POSalesP
	ENDIF
	cSQL = "SELECT SalesP,Cover FROM dbo.PurchaseOrder WITH(NOLOCK) WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
	SELECT 0
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_POSalesP' )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_POSalesP' )
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_POSalesP' )
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ENDIF
	IF USED('tmpPQSL_POSalesP')
		IF RECCOUNT('tmpPQSL_POSalesP') > 0
			cSalesP = PrepareSQLtxt(tmpPQSL_POSalesP.SalesP,'SalesP',1)
			cCoverP = PrepareSQLtxt(tmpPQSL_POSalesP.Cover,'Cover',1)
		ENDIF
		USE IN tmpPQSL_POSalesP
	ENDIF

	PRIVATE cPOUserName, cPOCoverName, cMess
	cPOUserName = ALLTRIM( AppSetup_Get_UserName(cSalesP) )
	cPOCoverName = ALLTRIM( AppSetup_Get_UserName(cCoverP) )
	cMess 	= ''
	
	IF NOT LEN(cSalesP)=0
		IF cUserName != cPOUserName
			*UserName login may be just the First name, but PO Username will be Full name!!!
			IF AT(" ",cUserName) = 0
				*Did Not find a SPACE in cUserName
				IF AT(" ",cPOUserName) > 0
					*Found a SPACE in cPOUserName, Just use First Name.
					cPOUserName = LEFT(cPOUserName,AT(" ",cPOUserName)-1)
				ENDIF
			ENDIF
		ENDIF
		IF UPPER(cUserName) != UPPER(cPOUserName)
			IF cSalesP = '0'
				lAllowPOCancel = .T.
			ELSE
			
				IF UPPER(cUserName) = UPPER(cPOCoverName)
					*The Cover SalesP is allowed to Edit
					lAllowPOCancel = .T.
				ELSE
					cMess = "PO Item "+ALLTRIM(cPOitem)+" was written by SalesP:"+cSalesP+", "+cPOUserName+"'"
					IF LEN(cPOCoverName) > 0
						cMess = cMess +CHR(13)+" and Covered by:"+cCoverP+", "+cPOCoverName+"'"
					ENDIF
					
					IF AppSetup_ActiveSales_SalesP(cSalesP)
						*Login is not same as PO SalesP
						MESSAGEBOX(cMess+CHR(13)+"You are logged in as "+ALLTRIM(cUserName)+" !"+CHR(13)+"You cannot Edit/Cancel!"+CHR(13)+CHR(13)+"To see PO, click Print and then just preview!",0+16,"Cannot Edit/Cancel this PO Item")
						lAllowPOCancel = .F.
						TrackMess(cMess+CHR(13)+"You are logged in as "+ALLTRIM(cUserName)+" !"+CHR(13)+"You cannot Edit/Cancel!"+" "+CHR(13)+SYS(16,1))
					ELSE
						*Allowed to cancel Inactive SalesP
						lAllowPOCancel = .T.
						TrackMess(cMess+CHR(13)+cPOUserName+" is not an Active SalesPerson."+CHR(13)+"You are logged in as "+ALLTRIM(cUserName)+CHR(13)+"Allowed to Edit/Cancel!"+" "+CHR(13)+SYS(16,1))
					ENDIF
				ENDIF
			ENDIF
		ELSE
			lAllowPOCancel = .T.
		ENDIF
	ELSE
		*No SalesP	*PO has no owner!
		TrackMess("PO Item '"+ALLTRIM(cPOitem)+" You are logged in as "+ALLTRIM(cUserName)+", You can Edit/Cancel!"+" "+CHR(13)+SYS(16,1))
		lAllowPOCancel = .T.
	ENDIF
ELSE
	*Admin over ride
	lAllowPOCancel = .T.
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN lAllowPOCancel 
ENDPROC
