	IF NOT lTranAlreadySet
		= SQLROLLBACK(nConn)
		*= SQLCOMMIT(nConn)	  -Cancel_SOitem
	ENDIF
	lReturn = .F.
ENDIF

IF NOT lTranAlreadySet
	= SQLSETPROP(nConn, 'Transactions', 1)  && TRANSAUTO
ENDIF

IF lNewConn 
	SQLDISCONNECT(nConn )
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
