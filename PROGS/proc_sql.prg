	ENDIF
ELSE
	nConn = get_SQLSTRINGCONNECT()
	lNewConn = .T.
ENDIF
nConn = CheckSQLConnection(nConn)
PRIVATE cAlias 
cAlias = ALIAS()

IF USED('tmpPQSL_Forms')
	USE IN tmpPQSL_Forms
ENDIF
SELECT 0

IF nConn > 0
	*Check for Printed 
	PRIVATE lEverPrint, lCancl, lCmplt
	lEverPrint = .F.
	lCancl = .F.
	lCmplt = .F.
	
	cSQL = "SELECT cncld, cmplt, EverPrint FROM dbo.Sales_No WITH(NOLOCK) WHERE SalesNum = "+ALLTRIM(STR(pSalesNum))
	
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_Forms' )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn,  cSQL, 'tmpPQSL_Forms' )
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_Forms')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ENDIF
	
	IF USED('tmpPQSL_Forms')
		IF RECCOUNT('tmpPQSL_Forms') > 0
			lEverPrint	= PrepareSQLlogic(tmpPQSL_Forms.EverPrint,'EverPrint')
			lCancl		= PrepareSQLlogic(tmpPQSL_Forms.cncld,'cncld')
			lCmplt		= PrepareSQLlogic(tmpPQSL_Forms.cmplt,'cmplt')
		ENDIF
	ENDIF
	
	***********************************

	cSQL = "SELECT DISTINCT form FROM dbo.AllQuotes WITH(NOLOCK) WHERE SalesNum = "+ALLTRIM(STR(pSalesNum))
	cSQL = cSQL + " AND NOT Form IS Null"
	
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_Forms' )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn,  cSQL, 'tmpPQSL_Forms' )
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_Forms')
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ENDIF
	
	IF USED('tmpPQSL_Forms')
		IF NOT lEverPrint
			PRIVATE lUseWindfall, lUseTipton
			lUseWindfall = .F.
			lUseTipton = .F.
			SELECT tmpPQSL_Forms
			SCAN
				IF tmpPQSL_Forms.Form = '40' OR tmpPQSL_Forms.Form = '12'
					lUseWindfall = .T.
				ENDIF
				IF tmpPQSL_Forms.Form != '40' AND tmpPQSL_Forms.Form != '12'
					lUseTipton = .T.
				ENDIF
			ENDSCAN	
			
			PRIVATE cShopEmail
			DO CASE
			CASE lUseWindfall AND lUseTipton
				cShopEmail = "TiptonShop@SpaceAlloysUSA.com,WindfallShop@SpaceAlloysUSA.com"
			CASE lUseWindfall
				cShopEmail = "TiptonShop@SpaceAlloysUSA.com"
			CASE lUseTipton	
				cShopEmail = "TiptonShop@SpaceAlloysUSA.com"
			OTHERWISE
				cShopEmail = "David.Kirchner@SpaceAlloysUSA.com"
			ENDCASE	
			
			
			PRIVATE cHeader,cBody,cVendor,cCustomer,cSalesRep
			cHeader = "SO:"+ALLTRIM(STR(pSalesNum))+" is being edited after SO was printed."
			
			cBody = "SO:" +HTML_SO(pSalesNum,.F.)
			*cBody = cBody +CHR(10)+CHR(13)+HTML_SO(pSalesNum,.T.)
			cBody = cBody +" is being edited after SO was printed."
			cCustomer = getFromQuotesSO(pSalesNum,'COMPANY',nConn)
			cBody = cBody +CHR(10)+CHR(13)+"Sold to Customer:"+cCustomer 
			cSalesRep =  SalesRepfromSO(pSalesNum)
			
			
			***************************
			IF lCancl
				cBody = cBody +CHR(10)+CHR(13)+"Warning! This Sales Order has been Cancelled."
			ENDIF
			
			IF lCmplt
				cBody = cBody +CHR(10)+CHR(13)+"Warning! This Sales Order is already complete."
			ENDIF
			
			cBody = cBody +CHR(10)+CHR(13)+"SO SalesRep:"+cSalesRep 
			cBody = cBody+CHR(13)+'Machin-User = '+SYS(0)

			*********
			*get Version  -AlertShopof_SOEdit
			PRIVATE nVer, nAmend
			nVer = Get_Ver_Sales_No_Rev( pSalesNum ,nConn )
			nAmend = Get_Amendment_Sales_No( pSalesNum ,nConn )
			
			IF VARTYPE(nVer) = "N"
				cBody = cBody +CHR(10)+CHR(13)+"Sales Order Version:"+ALLTRIM(STR(nVer))
			ENDIF
			*********
			*Add Version Comments  -AlertShopof_SOEdit
			IF USED('tmpPQSL_SN_Rev')
				USE IN tmpPQSL_SN_Rev
			ENDIF
			cSQL = "SELECT RTRIM(CAST(Comment AS CHAR(255))) AS Comnt "
			cSQL = cSQL + " FROM dbo.Sales_No_Rev WITH(NOLOCK) WHERE SalesNum = "+ALLTRIM(STR(pSalesNum))
			SELECT 0
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_SN_Rev' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn,  cSQL, 'tmpPQSL_SN_Rev' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPQSL_SN_Rev')
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
			
			IF USED('tmpPQSL_SN_Rev')
				IF VARTYPE(tmpPQSL_SN_Rev.Comnt) = "C"
					IF NOT EMPTY(tmpPQSL_SN_Rev.Comnt)
						
						cBody = cBody +CHR(10)+CHR(13)+"Revision Comment:<b>"+CHR(10)+CHR(13)+PrepareSQLtxt(tmpPQSL_SN_Rev.Comnt,'Comment',255)+"</b>"
						cBody = cBody+CHR(13)+'Machin-User = '+SYS(0)
						cBody = cBody +CHR(10)+CHR(13)+"Proc_SQL:AlertShopof_SOEdit()."
						Send_HTML_Email( cShopEmail,get_Server_Email(),cHeader,cBody,nConn,.T.,.F.)
						
					ENDIF
				ENDIF
				USE IN tmpPQSL_SN_Rev
			ENDIF
			
			*********
			*Only send if has Comment- see above
			*Send_HTML_Email( cShopEmail,get_Server_Email(),cHeader,cBody,nConn,.T.,.F.)
		ENDIF
		
		USE IN tmpPQSL_Forms
	ENDIF

	IF lNewConn 
		SQLDISCONNECT(nConn )
	ENDIF
ELSE
	*Error on Connection String
	TrackError("Could not Connect to SQL","Error on Connection String","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
ENDIF

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN nItemPO 
ENDPROC

