*********************************	
* Tests if file with a given name is already in use
* Parameter should contain full path to the file
PROCEDURE isFileLocked 
LPARAMETERS tcLocalFileName
LOCAL llLocked, liHandle

llLocked = .F.
IF FILE(tcLocalFileName)
    * File exists, to try to open it
    liHandle = FOPEN(tcLocalFileName, 2)
    IF liHandle = -1
        * File could not be opened
        llLocked = .T.
    ELSE
        * File can be opened exclusive
        FCLOSE(liHandle)
    ENDIF
ENDIF

RETURN llLocked
ENDPROC


