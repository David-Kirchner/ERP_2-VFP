PROC PrepareSQLdatetime 
PARAMETER uData, cField, plReturnNull, plQuite
*cDateTime = PrepareSQLdatetime('  /  /  ','DateTime', .F.,.T.)
*Also see PrepareSQLdate
*Also see ShowSQLdate('1900-01-01')

IF VARTYPE(cField) != "C"
	WAIT WINDOW "Parameters: PrepareSQLdate('  /  /  ','DateTime')" NOWAIT
*	TrackMess( "Proc_Sql:PrepareSQLdatetime() has no Field"+" "+CHR(13)+SYS(16,1) )
	TrackError("Proc_Sql:PrepareSQLdatetime() has no Field. ","PrepareSQLdatetime","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	cField = "Field"
ENDIF
PRIVATE lReturnNull
IF VARTYPE(plReturnNull) = "L"
	lReturnNull = plReturnNull
ELSE
	lReturnNull = .F.
ENDIF

PRIVATE lQuite
lQuite = .F.
IF VARTYPE(plQuite) = "L"
	lQuite = plQuite
ELSE
	lQuite = .F.
ENDIF

IF VARTYPE(uData) = "D"
	*Put 0 hour time on date
*	uData = CTOT( TTOC( DTOT(uData) ) )
	PRIVATE lCentury
	lCentury = SET("CENTURY") = "ON"
	IF NOT lCentury 
		SET CENTURY ON
	ENDIF
	*uData = CTOT( DTOC(uData)+" 12:00:00 AM"  )
	uData = CTOT( DTOC(uData) )
ENDIF

IF VARTYPE(uData) = "C"
	*Change to DateTime
	IF LEN(uData) < 11 OR AT('-',uData,2)=0
	
		*No time found
		PRIVATE nYear, nMonth, nDay, uNewuData

		IF NOT VARTYPE(uData) = "D"	
			*try to get as DATE with function.
			uNewuData = PrepareSQLdate(uData,'Date' ,.F.,.T.) 
			IF VARTYPE(uNewuData) = "D"	
				uData  = uNewuData 
			ELSE
				** bad bad
				IF NOT lQuite 
					MESSAGEBOX( "Warning, your datetime for field: "+ALLTRIM(cField)+CHR(13)+" cannot be used."+CHR(13)+"Tried to check as a just a Date and failed.",0+48,"Bad DateTime")
					TrackError("Warning, your datetime for field: "+ALLTRIM(cField)+CHR(13)+" cannot be used."+CHR(13)+"Tried to check as a just a Date and failed"+". ","Warning","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
				ENDIF

				IF plReturnNull
					RETURN .null.
				ELSE
					RETURN CTOT('')
				ENDIF
			ENDIF
		ENDIF
			
		IF VARTYPE(uData) = "D"	
			nYear	= YEAR(uData)
			nMonth	= MONTH(uData)
			nDay	= DAY(uData)
			
			IF nYear > 0 AND nMonth > 0 AND nDay > 0
				uData = DATETIME(nYear, nMonth, nDay )
			ELSE
				** bad bad
				IF NOT lQuite 
					MESSAGEBOX( "Warning, your datetime for field: "+ALLTRIM(cField)+CHR(13)+" cannot be used."+CHR(13)+"Tried to check as a just a Date and failed.",0+48,"Bad DateTime")
					TrackError("Warning, your datetime for field: "+ALLTRIM(cField)+CHR(13)+" cannot be used."+CHR(13)+"Tried to check as a just a Date and failed."+". ","Warning","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
				ENDIF
				
				IF plReturnNull
					RETURN .null.
				ELSE
					RETURN CTOT('')
				ENDIF
			ENDIF
		ENDIF
		
	ELSE
		uData = CTOD( uData )
	ENDIF
ENDIF

IF VARTYPE(uData) = "T"
	*remove FoxPro empty dates
	IF uData = CTOT("01/01/00 12:00:00 AM")
		uData = CTOT("")
	ENDIF
	IF uData = CTOT("01/01/1900 12:00:00 AM")
		uData = CTOT("")
	ENDIF
ENDIF


IF NOT ( EMPTY(uData) OR ISNULL(uData) )
	*Is Date within 10 years!
	IF uData > DATETIME() + 365*10*24*60*60  OR uData < DATETIME() - 365*10*24*60*60
		IF NOT lQuite
			IF NOT (UPPER(cField) = "CUSTOMERSINCE" OR UPPER(cField) = "ERRORDATE") 
				MESSAGEBOX( "Warning, your date: "+DTOC(uData)+" for field: "+ALLTRIM(cField)+CHR(13)+" is not within the normal 10 years.",0+48,"Bad DateTime")
				TrackError("Warning","Warning, your date: "+DTOC(uData)+" for field: "+ALLTRIM(cField)+CHR(13)+" is not within the normal 10 years."+". "+PROGRAM(),"Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
			ENDIF
		ENDIF
	ENDIF
	
	IF uData > DATETIME() + 365*100*24*60*60  OR uData < DATETIME() - 365*100*24*60*60
		*more than 100 years out!
		STORE .NULL. TO uData 
	ENDIF
ENDIF


IF lReturnNull
	IF EMPTY(uData)
		STORE .NULL. TO uData 
	ENDIF
ELSE
	IF ( EMPTY(uData) OR ISNULL(uData) )
		*uData = "  /  /  "
		uData = CTOT("")
	ENDIF
ENDIF


RETURN uData

ENDPROC
