PROCEDURE chatter_UserID_UserName 
PARAMETERS cUserName, pConnHandle
*nUserID = chatter_UserID_UserName(cUserName,nConn)

IF VARTYPE(cUserName) != "C"
	RecordError( 0, 'PARAMETERS ', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"VFP message: No cUserName parameter" )
	RETURN .F.
ENDIF

IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
	SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
ENDIF 

PRIVATE nConn, lNewConn
lNewConn = .F.
IF VARTYPE(pConnHandle) = "N"
	IF pConnHandle > 0
		nConn = pConnHandle
	ELSE
		nConn = get_SQLSTRINGCONNECT()
		lNewConn = .T.
	ENDIF
ELSE
	nConn = get_SQLSTRINGCONNECT()
	lNewConn = .T.
ENDIF
nConn = CheckSQLConnection(nConn)

PRIVATE nUserID 
nUserID = 0

PRIVATE cAlias, cSQL, cSQLfix 
cAlias = ALIAS()

IF USED('tmpPQSL_cuUn')
	USE IN tmpPQSL_cuUn
ENDIF
SELECT 0

IF LEN(cUserName) > 0
	cSQL = "SELECT TOP(1) [UserID] "
	cSQL = cSQL + " FROM [Messenger].[dbo].[Users] WITH(NOLOCK) "
	cSQL = cSQL + " WHERE [UserName] = '"+cUserName+"'"
	
	cSQLfix = "INSERT INTO [Messenger].[dbo].[Users] ([UserName]) values ('"+cUserName+"')"
	
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_cuUn' )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpPQSL_cuUn' )
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL,nConn,nSQLEXEC, 'tmpPQSL_cuUn' )
		RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
	ENDIF
	
	IF USED('tmpPQSL_cuUn')
		IF RECCOUNT('tmpPQSL_cuUn') = 0
			TrackError("chatter_UserID_UserName(cUserName,nConn) failed to get UserID for UserName='"+ALLTRIM(cUserName)+"'."+CHR(13)+cSQL+CHR(13)+cSQLfix ,"Bad UserName", PROGRAM(), LINENO(1))
		ENDIF
		IF RECCOUNT('tmpPQSL_cuUn') > 0
			nUserID = tmpPQSL_cuUn.UserID 
		ENDIF
		
		USE IN tmpPQSL_cuUn
	ELSE		
		TrackError("chatter_UserID_UserName(cSalesRep,nConn) failed to get UserID for UserName='"+ALLTRIM(cUserName)+"'."+CHR(13)+cSQL+CHR(13)+cSQLfix ,"Bad UserName", PROGRAM(), LINENO(1))
	ENDIF
ENDIF

IF lNewConn
	SQLDISCONNECT(nConn)
ENDIF
	

IF NOT EMPTY(cAlias)
	IF USED(cAlias)
		SELECT (cAlias)
	ELSE
		RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
	ENDIF
ENDIF

RETURN nUserID 
ENDPROC

