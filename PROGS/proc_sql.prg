PROCEDURE UpdateSalesWithRMA_No 
PARAMETERS cSoItem, nRMA_No, lCancelled, nConn
*UpdateSalesWithRMA_No(SoItem, nRMA_No, ThisForm.nConnHandle )

IF VARTYPE(cSOitem) != "C" 
	RETURN .F.
ENDIF
IF Proper_SO_Item(cSOItem) = Proper_SO_Item("")
	RETURN .F.
ENDIF
IF VARTYPE(nRMA_No) != "N"
	RETURN .F.
ENDIF
IF VARTYPE(lCancelled) != "L"
	lCancelled = .F.
ENDIF
IF VARTYPE(nConn) != "N"
	RETURN .F.
ENDIF
nConn = CheckSQLConnection(nConn)
PRIVATE cSQL, nSQLEXEC

cSQL = "UPDATE dbo.Sales SET "
cSQL = cSQL + " [RMA_No] = "+STR(nRMA_No,10,0)
IF lCancelled 
	cSQL = cSQL + " [Cncld] = 1"
ENDIF
cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"

nSQLEXEC = SQLEXEC( nConn, cSQL )

DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( nConn, cSQL )
ENDDO
IF nSQLEXEC < 0 &&Try again!, long triger
	nSQLEXEC = SQLEXEC(nConn, cSQL)
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQL)
	ENDDO
ENDIF
IF nSQLEXEC < 0
	SQLEXECError(cSQL, nConn, nSQLEXEC, '')
	RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
ELSE
	TrackMess( "UpdateSalesWithRMA_No RMA_No="+ALLTRIM(STR(nRMA_No))+" where SOitem='"+cSoItem+"'"+" "+CHR(13)+SYS(16,1) )
	IF lCancelled 
		** Repeat in SOitem_Hrs
		cSQL = "UPDATE dbo.SOitem_Hrs SET "
		cSQL = cSQL + " [Cncld] = 1"
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		nSQLEXEC = SQLEXEC( nConn, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConn, cSQL )
		ENDDO
		
		** Repeat in SOitem_Hrs
		cSQL = "UPDATE dbo.Sales_PS SET "
		cSQL = cSQL + " [Cncld] = 1"
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		nSQLEXEC = SQLEXEC( nConn, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConn, cSQL )
		ENDDO
		**
	ENDIF
ENDIF
ENDPROC

