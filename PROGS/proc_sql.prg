PROC PrepareSQLtime 
PARAMETER uData, cField, plReturnNull, plQuite
*cTime = PrepareSQLtime('  /  /  ','DateTime', .F.,.T.) %%from dateTime field
*Also see PrepareSQLdate
*Also see ShowSQLdate('1900-01-01')

IF VARTYPE(cField) != "C"
	WAIT WINDOW "Parameters: PrepareSQLtime ('  /  /  ','dtDateTime')" NOWAIT
*	TrackMess( "Proc_Sql:PrepareSQLdatetime() has no Field"+" "+CHR(13)+SYS(16,1) )
	TrackError("Proc_Sql:PrepareSQLtime() has no Field. ","PrepareSQLdatetime","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
	cField = "Field"
ENDIF

PRIVATE lReturnNull
IF VARTYPE(plReturnNull) = "L"
	lReturnNull = plReturnNull
ELSE
	lReturnNull = .F.
ENDIF

PRIVATE lQuite
lQuite = .F.
IF VARTYPE(plQuite) = "L"
	lQuite = plQuite
ELSE
	lQuite = .F.
ENDIF

IF VARTYPE(uData) = "T"
	*date Time, Cast as Text
	IF uData = CTOT("01/01/00 12:00:00 AM")
		uData = TTOC("")
	ELSE
		uData = TTOC(uData)
	ENDIF
ENDIF

IF VARTYPE(uData) = "D"
	*is Date, no time
	uData = DTOC(uData)
	uData = ''
ENDIF

IF VARTYPE(uData) = "C"
	*Check String
	IF ( AT('-',uData,2)>0 OR AT('/',uData,2)>0 )
		*Found a Date
		uData = ALLTRIM( RIGHT(uData,12) )
	ENDIF
	IF LEN(uData) > 12
		*Found Time in Text
		*'11:41:30.227' or ' 12:00:00 AM'
		uData = ALLTRIM( RIGHT(uData,12) )
	ENDIF
ENDIF


IF NOT EMPTY(uData)
	*Is time within 24HRS
ENDIF

IF lReturnNull
	IF ( EMPTY(uData) OR ISNULL(uData) )
		STORE .NULL. TO uData 
	ENDIF
ELSE
	IF EMPTY(uData)
		*uData = "  /  /  "	
	ENDIF
ENDIF


RETURN uData

ENDPROC
