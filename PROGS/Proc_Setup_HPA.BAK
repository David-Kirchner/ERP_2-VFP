*!*				ENDTRY

		ENDTRY

*		IF !USED('Errors')
		IF NOT USED('fnERROR')
			PRIVATE cLocation
			cLocation = LOCFILE( "Errors","DBF","Find the Errors table in \MEM")
			
*!*				IF "ERRORS.DBF" $ UPPER(cLocation) 
*!*					IF FILE(cLocation)
*!*						MESSAGEBOX("The 'CollectErrors' Function has been called."+CHR(13)+"The file '"+cLocation+"' was not able to be written to."+CHR(13)+"Why is this file not accessible?",0+16,"Cannot write the error to disk.")
*!*						USE (cLocation) IN 0 ALIAS Errors
