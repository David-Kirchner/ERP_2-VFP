IF nConn > 0
	*Un = cUserName AND SETUP.Prp = "Machine"
	cSQL = "SELECT [UN] FROM dbo.AppSetup WITH(NOLOCK) WHERE [Prp] = 'Machine' AND [ANS] = '"+pMachine+"'"
	     
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpSqlAns' )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
