*!*						SELECT 0
*!*						WAIT WINDOW "Proc_Setup:CollectErrors() CREATE TABLE "+cErrorsFile
*!*						
*!*						CREATE TABLE (cErrorsFile) FREE ( nerror INT, mess1 C(254), cprogram c(254), nlineno Int, errordate DateTime, MACHINE c(254), Revision c(254), Memo1 MEMO)
*!*						*CREATE TABLE (cErrorsFile) ( nerror INT, mess1 C(254), cprogram c(254), nlineno int, errordate DateTime, MACHINE c(254), Revision c(254), Memo1 MEMO)
