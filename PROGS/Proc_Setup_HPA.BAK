	ENDIF
ENDIF

IF NOT lReturn 
	TrackError("Did not find SalesP '"+pSalesP+"'",cSQL,"Proc_Setup:"+PROGRAM()+" @"+PROGRAM(1),LINENO())
ENDIF

RETURN lReturn 
