*!*					*CREATE TABLE (cErrorsFile) ( nerror INT, mess1 C(254), cprogram c(254), nlineno int, errordate DateTime, MACHINE c(254), Revision c(254), Memo1 MEMO)
*!*					USE (cErrorsFile) IN 0 ALIAS Errors
*!*				ENDIF
		ENDIF
		
		*WAIT WINDOW "Proc_Setup:CollectErrors() f"
		
		PRIVATE cNewMess
		*IF USED('Errors')
		IF USED('fnERROR')
			SELECT fnERROR
			SCAN
				IF NOT DELETED()
				
					*Errors Insert trigger sends out SubjectEmail = 'New Error entry.'
					cSQL = "INSERT INTO dbo.Errors ([nerror],[mess1],[cprogram],[nlineno],[errordate],[MACHINE],[Revision],[Memo1]) VALUES ("
					cSQL = cSQL  + ""+STR(PrepareSQLnum(fnERROR.nerror,'nError',-3))+""
					cSQL = cSQL  + ",'"+PrepareSQLtxt(fnERROR.mess1,'Mess1',254,.F.,.T.)+"'"
					cSQL = cSQL  + ",'"+PrepareSQLtxt(fnERROR.cprogram,'cProgram',254,.F.,.T.)+"'"
					cSQL = cSQL  + ","+STR(PrepareSQLnum(fnERROR.nlineno,'nLineo',-3))
					cSQL = cSQL  + ",'"+TTOC(PrepareSQLdateTime(fnERROR.errordate,'ErrorDate'))+"'"
					cSQL = cSQL  + ",'"+PrepareSQLtxt(fnERROR.MACHINE,'Machine',254,.F.,.T.)+"'"
					cSQL = cSQL  + ",'"+PrepareSQLtxt(fnERROR.Revision,'Revision',254,.F.,.T.)+"'"
					cSQL = cSQL  + ",'"+PrepareSQLtxt(fnERROR.Memo1,'Memo',-1,.F.,.T.)+"'"
					cSQL = cSQL  + ")"
					
					*PrepareSQLtxt(Text,'Name',nLEN, lPad, lQuite
					*TRIGGER HPAlloy.dbo.Errors_INSERT Mess1: Memo1: 
					
					*WAIT WINDOW "Proc_Setup:CollectErrors() "+SUBSTR(cSQL,110,100)
					
					*MESSAGEBOX(cSQL,0,"SQL Error")
					
