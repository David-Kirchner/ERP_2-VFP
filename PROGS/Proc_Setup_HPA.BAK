PROCEDURE AppSetup_SalesP_Exists 
PARAMETERS pSalesP
*AppSetup_SalesP_Exists(cSalesP)

IF VARTYPE(pSalesP) != "C"
	pSalesP = " "
	RETURN .F.
ENDIF

PRIVATE lReturn
lReturn = .F.

PRIVATE nConn
nConn = get_SQLSTRINGCONNECT()

PRIVATE cAlias 
cAlias = ALIAS()

PRIVATE cSQL, nSQLEXEC

IF USED('tmpSqlAns')
	USE IN tmpSqlAns
ENDIF
SELECT 0

IF nConn > 0
	*See if LoginUN is in Setup App
	cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.AppSetup WITH(NOLOCK) WHERE [Prp] = 'SalesP' AND [ANS] = '"+pSalesP+"'"
	
	nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpSqlAns' )
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpSqlAns' )
	ENDDO
	IF nSQLEXEC < 0 &&Try again!
		nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSqlAns")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 2' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSqlAns")

			IF nSQLEXEC < 0
				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
					nSQLEXEC = 0
				ENDIF
			ENDIF
		ENDDO
	ENDIF
	IF nSQLEXEC < 0
		SQLEXECError(cSQL ,nConn,nSQLEXEC, 'tmpSqlAns')
		RecordError(nSQLEXEC,"SQL Error" ,"Proc_Setup:"+PROGRAM()+" @"+PROGRAM(1),LINENO(),cSQL )
	ENDIF
	
	IF USED('tmpSqlAns')
		IF tmpSqlAns.Cntd > 0
			lReturn = .T.
		ENDIF

		USE IN tmpSqlAns
	ENDIF
	
	SQLDISCONNECT( nConn )
ELSE
	*Error on Connection String
	TrackError("Could not Connect to SQL","Error on Connection String","Proc_Setup:"+PROGRAM()+" @"+PROGRAM(1),LINENO())
