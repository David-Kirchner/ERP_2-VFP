PARAMETER PTEXT &&M.EXEPROG,M.OBJ
*DO Progs\F2Math

PRIVATE m.MATH,m.MATHFAC,m.METRIC, m.MATHTYPE,m.MATHNAME,m.MATH1,m.MATH2,	m.MATH3,m.MATH4

IF TYPE('pText') = 'C'
	m.MATH = PTEXT
ELSE
	IF NOT WEXIST('INQ_MATH')
		DEFINE WINDOW INQ_MATH FROM 2,0 TO 4,23 TITLE "Ex. 40MM,13',12*5IN"
	ENDIF

	Activate WINDOW INQ_MATH
	ACCEPT TO m.MATH
	Deactivate WINDOW INQ_MATH
ENDIF

IF EMPTY(m.MATH)
	RETURN
ENDIF

*M.METRIC IS LENGTH OF UNIT SMYBOL TO DELETE

DO CASE
CASE "MM" $ UPPER(m.MATH)
	m.MATHFAC = .03937
	m.METRIC = 2
	m.MATHTYPE = "IN"
	m.MATHNAME = "Millimeter="
CASE "CM" $ UPPER(m.MATH)
	m.MATHFAC = .3937
	m.METRIC = 2
	m.MATHTYPE = "IN"
	m.MATHNAME = "Centimeter="
CASE "DM" $ UPPER(m.MATH)
	m.MATHFAC = 3.937
	m.METRIC = 2
	m.MATHTYPE = "IN"
	m.MATHNAME = "Decimeter="
CASE "M" $ UPPER(m.MATH)
	m.MATHFAC = 39.37
	m.METRIC = 1
	m.MATHTYPE = "IN"
	m.MATHNAME = "Meter="
CASE "FT" $ UPPER(m.MATH)
	m.MATHFAC = 12
	m.METRIC = 2
	m.MATHTYPE = "IN"
	m.MATHNAME = "Foot="
CASE "'" $ UPPER(m.MATH)
	m.MATHFAC = 12
	m.METRIC = 1
	m.MATHTYPE = "IN"
	m.MATHNAME = "Foot="
CASE ["] $ UPPER(m.MATH)
	m.MATHFAC = 1
	m.METRIC = 1
	m.MATHTYPE = "IN"
	m.MATHNAME = "Inch="
CASE "IN" $ UPPER(m.MATH)
	m.MATHFAC = 1
	m.METRIC = 2
	m.MATHTYPE = "IN"
	m.MATHNAME = "Inch="
CASE "YARD" $ UPPER(m.MATH)
	m.MATHFAC = 36
	m.METRIC = 4
	m.MATHTYPE = "IN"
	m.MATHNAME = "Yard="
CASE "KG" $ UPPER(m.MATH)
	m.MATHFAC = 2.2046
	m.METRIC = 2
	m.MATHTYPE = "LB"
	m.MATHNAME = "Kilogram="
CASE "HG" $ UPPER(m.MATH)
	m.MATHFAC = .22046
	m.METRIC = 2
	m.MATHTYPE = "IN"
	m.MATHNAME = "Hectogram="
CASE "GRAM" $ UPPER(m.MATH)
	m.MATHFAC = .0022046
	m.METRIC = 4
	m.MATHTYPE = "IN"
	m.MATHNAME = "Gram="
CASE "CG" $ UPPER(m.MATH)
	m.MATHFAC = .000022046
	m.METRIC = 2
	m.MATHTYPE = "IN"
	m.MATHNAME = "Centigram="
CASE "LB" $ UPPER(m.MATH)
	m.MATHFAC = 1
	m.METRIC = 2
	m.MATHTYPE = "LB"
	m.MATHNAME = "Pound="
OTHERWISE
	m.MATHFAC = 1
	m.METRIC = 0
	m.MATHTYPE = "X"
	m.MATHNAME = "Equation="
ENDCASE



DO CASE
CASE "*" $ m.MATH
	m.MATH1 = AT("*",m.MATH)
	m.MATH2 = VAL(LEFT(m.MATH,m.MATH1-1))
	m.MATH3 = VAL(substr(m.MATH,m.MATH1+1,LEN(m.MATH)-m.METRIC))
	m.MATH4 = m.MATH2*m.MATH3*m.MATHFAC
CASE "+" $ m.MATH
	m.MATH1 = AT("+",m.MATH)
	m.MATH2 = VAL(LEFT(m.MATH,m.MATH1-1))
	m.MATH3 = VAL(substr(m.MATH,m.MATH1+1,LEN(m.MATH)-m.METRIC))
	m.MATH4 = m.MATH2+m.MATH3*m.MATHFAC
CASE "/" $ m.MATH
	m.MATH1 = AT("/",m.MATH)
	m.MATH2 = VAL(LEFT(m.MATH,m.MATH1-1))
	m.MATH3 = VAL(substr(m.MATH,m.MATH1+1,LEN(m.MATH)-m.METRIC))
	m.MATH4 = m.MATH2/m.MATH3*m.MATHFAC
CASE "-" $ m.MATH
	m.MATH1 = AT("-",m.MATH)
	m.MATH2 = VAL(LEFT(m.MATH,m.MATH1-1))
	m.MATH3 = VAL(substr(m.MATH,m.MATH1+1,LEN(m.MATH)-m.METRIC))
	m.MATH4 = m.MATH2-m.MATH3*m.MATHFAC
OTHERWISE
	m.MATH4 = VAL(m.MATH)*m.MATHFAC
ENDCASE


