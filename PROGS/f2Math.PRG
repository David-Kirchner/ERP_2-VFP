IF NOT TYPE('pText') = 'C'
	Activate WINDOW INQ_MATH
	? m.MATH4
	WAIT WINDOW m.MATHNAME
	Deactivate WINDOW INQ_MATH
ELSE
	RETURN m.Math4
ENDIF

*ENDCASE
