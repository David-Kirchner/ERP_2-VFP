	PROCEDURE getshoprecv
		*ThisForm.GetShopRecv()
		IF USED('tmpSQL')
			ThisForm.grd.RecordSource = ''
			
			USE IN tmpSQL
		ENDIF
		
		
		PRIVATE cSalesP
		cSalesP = ThisForm.cmbAllEmployees.Value
		PRIVATE lReceived, lPrinted, lShipOn
		lReceived	= IIF( ThisForm.chkReceived.Value=1, .T., .F.)
		lPrinted	= IIF( ThisForm.chkPrinted.Value=1, .T., .F.)
		lShipOn		= IIF( ThisForm.chkShipOn.Value=1, .T., .F.)
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		*SELECT LEFT(items.subject,35) AS Subject, items.last_mod_date, CAST(items.Recipients AS CHAR(31)) AS Recipients, CAST(ISNULL(items.Copy_Recipients,' ') AS CHAR(15)) AS CC, CAST(items.Profile_ID AS CHAR(2)) AS PI, l.description FROM MSDB.dbo.sysmail_faileditems as items JOIN MSDB.dbo.sysmail_event_log AS l ON items.mailitem_id = l.mailitem_id WHERE items.send_request_date > GETDATE()-365 ORDER BY items.last_mod_date DESC
		
		cSQL = "SELECT LEFT(items.subject,35) AS Subject,"
		cSQL = cSQL + " items.last_mod_date,"
		cSQL = cSQL + " CAST(items.Recipients AS CHAR(31)) AS Recipients,"
		cSQL = cSQL + " CAST(ISNULL(items.Copy_Recipients,' ') AS CHAR(15)) AS CC,"
		cSQL = cSQL + " CAST(items.Profile_ID AS CHAR(2)) AS PI,"
		cSQL = cSQL + " l.description"
		cSQL = cSQL + " FROM MSDB.dbo.sysmail_faileditems as items"
		cSQL = cSQL + " JOIN MSDB.dbo.sysmail_event_log AS l"
		cSQL = cSQL + " ON items.mailitem_id = l.mailitem_id"
		cSQL = cSQL + " WHERE items.send_request_date > GETDATE()-365"
		cSQL = cSQL + " ORDER BY items.last_mod_date DESC"
		
		IF lReceived 
		*	cSQL = cSQL + " WHERE ISNULL(SN.ShopRecv,0) = 1 "
		ELSE
		*	cSQL = cSQL + " WHERE ISNULL(SN.ShopRecv,0) = 0 "
		ENDIF
		IF lPrinted 
		*	cSQL = cSQL + " AND ISNULL(SN.PrintedSO,0) = 1 "
		ELSE
		*	cSQL = cSQL + " AND ISNULL(SN.PrintedSO,0) = 0 "
		ENDIF
		IF lShipOn
		*	cSQL = cSQL + " OR NOT IS NULL ShipONDate"
		ENDIF
		
		IF cSalesP <> "(All Employees)" &&"*"
		*	cSQL = cSQL + " AND SN.SalesRep = '"+cSalesP+"'"
		ENDIF
		
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSQL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSQL')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSQL")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSQL")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSQL')
		ENDIF
		IF USED('tmpSQL')
		*	IF VARTYPE(tmpSQL.SalesNum) = "N"
				ThisForm.grd.RecordSource = 'tmpSQL'
				*ThisForm.grd.Column1.DynamicBackColor = "IIF(ISNULL(ShipONDate),RGB(255,255,255),RGB(255,255,0))"
				ThisForm.Edit1.Value = STRTRAN(tmpSQL.description,".","."+CHR(13))
		*	ENDIF
		ENDIF
		
		*!*	IF lReceived 
		*!*		IF lPrinted 
		*!*			IF lShipOn
		*!*				This.Caption = "Shop Received and Printed Report"
		*!*			ELSE
		*!*				This.Caption = "Shop Received and Printed Report"
		*!*			ENDIF
		*!*		ELSE
		*!*			IF lShipOn
		*!*				This.Caption = "Shop Received and NOT Printed Report"
		*!*			ELSE
		*!*				This.Caption = "Shop Received and NOT Printed Report"
		*!*			ENDIF
		*!*		ENDIF
		*!*	ELSE
		*!*		IF lPrinted 
		*!*			IF lShipOn
		*!*				This.Caption = "Shop NOT Received and Printed Report"
		*!*			ELSE
		*!*				This.Caption = "Shop NOT Received and Printed Report"
		*!*			ENDIF
		*!*		ELSE
		*!*			IF lShipOn
		*!*				This.Caption = "Shop NOT Received and NOT Printed Report"
		*!*			ELSE
		*!*				This.Caption = "Shop NOT Received and NOT Printed Report"
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pSalesP
		
		IF VARTYPE(pSalesP) != "C"
			pSalesP = ""
		ENDIF
		IF NOT EMPTY( pSalesP )
			PRIVATE cSalesPD 
			cSalesPD = SalesPDescription(pSalesP,'')
			IF NOT EMPTY( cSalesPD )
				ThisForm.cmbAllEmployees.Value = cSalesPD 
			ENDIF
		ENDIF
		
		PUBLIC aEmployees[1]
		aEmployees(1) = ""
		
		
		ThisForm.GetShopRecv()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_QUOTES ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE Resize
		nNewH = This.Height - 307
		nNewW = This.Width - 770 &&692
		
		*ThisForm.grd.Height = 204 + nNewH
		*ThisForm.grd.Top = 3 + nNewH
		ThisForm.lblSalesPerson.Top = 276 + nNewH
		ThisForm.cmbAllEmployees.Top = 273 + nNewH
		ThisForm.chkReceived.Top = 278 + nNewH
		ThisForm.chkPrinted.Top = 278 + nNewH
		
		ThisForm.cmdTest.Top = 273 + nNewH
		ThisForm.cmdTestPDF.Top = 273 + nNewH
		ThisForm.cmdRefresh.Top = 273 + nNewH
		ThisForm.cmdQuit.Top = 273 + nNewH
		
		ThisForm.grd.Width = 764 + nNewW   &&684
		ThisForm.Edit1.Width = 764 + nNewW
		
		ThisForm.Edit1.Height = 96 + nNewH
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpSQL')
			USE IN tmpSQL
		ENDIF
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

