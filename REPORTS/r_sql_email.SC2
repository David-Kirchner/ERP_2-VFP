	PROCEDURE cmbAllEmployees.Init
		LOCAL cSalesP, nLoopCount
		
		this.clear
		
		IF USED('tmpSalesPInit')
			USE IN tmpSalesPInit
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT SalesRep AS UN,dbo.SalesPInit(SalesRep) AS ANS"
		cSQL = cSQL+" FROM dbo.Sales_No WITH(NOLOCK)"
		cSQL = cSQL+" WHERE LEN( ISNULL(SalesRep,' ') )> 1"
		cSQL = cSQL+" GROUP BY SalesRep"
		cSQL = cSQL+" ORDER BY COUNT(*) DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesPInit')
		ENDIF
		
		IF USED('tmpSalesPInit')
			*SELECT DISTINCT Setup.Un, Setup.Ans FROM tmpSalesPInit WHERE Setup.prp = "SalesP" INTO ARRAY aEmployees
			SELECT Un FROM tmpSalesPInit INTO ARRAY aEmployees
			
			USE IN tmpSalesPInit
			
		ELSE
		ENDIF
		
		This.ColumnCount =ALEN(aEmployees)
		This.NumberOfElements=ALEN(aEmployees)
		This.BoundColumn = 1
		This.ColumnWidths = "115"
		
		
		this.addListitem("(All Employees)",1,1)
		nLoopCount = 1
		
		FOR EACH cSalesRep IN aEmployees
			IF !EMPTY(cSalesRep )
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cSalesRep),nLoopCount,1)
			ENDIF
		ENDFOR
		
		
		THIS.VALUE = "(All Employees)"
		
	ENDPROC

	PROCEDURE cmbAllEmployees.InteractiveChange
		*ThisForm.vSalesFiltered= .F.
		ThisForm.GetShopRecv()
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

