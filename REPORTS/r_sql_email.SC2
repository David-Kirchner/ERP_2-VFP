	PROCEDURE cmdTest.Click
		PRIVATE cEmailFrom
		cEmailFrom = AppSetup_Get_Email()
		IF EMPTY(cEmailFrom)
			cEmailFrom = "David.Kirchner@SpaceAlloysUSA.com"
		ENDIF
		
		Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',cEmailFrom ,'TestEmail',"This is a Test Email from "+cEmailFrom ,ThisForm.nConnHandle,.T.,.T.)
		WAIT WINDOW "Sent Test to David.Kirchner@SpaceAlloysUSA.com" NOWAIT
	ENDPROC

	PROCEDURE cmdTestPDF.Click
		
		
		PRIVATE cEmailFrom
		cEmailFrom = AppSetup_Get_Email()
		IF EMPTY(cEmailFrom)
			*Default
			cEmailFrom = "David@SpaceAlloysUSA.com"
		ENDIF
		WAIT WINDOW "Sending AS "+cEmailFrom  TIMEOUT 3
		
		IF FILE(get_Email_ServerDir()+"TestPage1.pdf")
			WAIT WINDOW "DELETE FILE "+get_Email_ServerDir()+"TestPage1.pdf" TIMEOUT 3
			DELETE FILE (get_Email_ServerDir()+"TestPage1.pdf")
		ENDIF
		
		IF FILE(get_Email_ServerDir()+"TestPage.pdf")
			WAIT WINDOW "COPY FILE "+get_Email_ServerDir()+"TestPage.pdf TO "+get_Email_ServerDir()+"TestPage1.pdf" TIMEOUT 3
			COPY FILE (get_Email_ServerDir()+"TestPage.pdf") TO (get_Email_ServerDir()+"TestPage1.pdf")
			WAIT WINDOW "SendPDFEmail(David.Kirchner@SpaceAlloysUSA.com,"+cEmailFrom+","+get_Email_ServerDir()+"TestPage1.pdf,'','',1,'TestEmail.pdf'" TIMEOUT 3
			SendPDFEmail("David.Kirchner@SpaceAlloysUSA.com", cEmailFrom, get_Email_ServerDir()+"TestPage1.pdf","","",ThisForm.nConnHandle,"TestEmail.pdf" )
			*Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com','David@SpaceAlloysUSA.com','TestEmail',"This is a Test Email.",ThisForm.nConnHandle,.T.,.T.)
			WAIT WINDOW "Sent Test PDF to David.Kirchner@SpaceAlloysUSA.com" NOWAIT
		ELSE
			MESSAGEBOX("Test file at "+get_Email_ServerDir()+"'TestPage.pdf' is missing",0+32,"No file to test on.")
		ENDIF
	ENDPROC

	PROCEDURE grd.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Edit1.Value = STRTRAN(tmpSQL.description,".","."+CHR(13))
	ENDPROC

