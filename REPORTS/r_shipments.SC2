		ENDIF
		
		
		IF lGood
			SELECT T.Year,Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec;
				,Ja1,Fe1,Mr1,Ap1,My1,Jn1,Jl1,Au1,Se1,Oc1,No1,De1;
				,Ja2,Fe2,Mr2,Ap2,My2,Jn2,Jl2,Au2,Se2,Oc2,No2,De2;
				,Ja5,Fe5,Mr5,Ap5,My5,Jn5,Jl5,Au5,Se5,Oc5,No5,De5;
				,Jalb,Felb,M3lb,Aplb,M5lb,J6lb,J7lb,Aulb,Selb,Oclb,Nolb,Delb;
				,JaR,FeR,MrR,AlR,MyR,JnR,JlR,AuR,SeR,OcR,NoR,DeR;
			FROM tmpShipmentsTotal T, tmpShipmentsOnTime OT, tmpShipmentsWithin2Days W2D, ;
				tmpShipmentsWithinWeek WW, tmpShipmentsLBs L, tmpShipmentsRMA R;
			WHERE T.Year = OT.Year AND OT.Year = W2D.Year AND W2D.Year = WW.Year AND WW.Year = L.Year AND L.Year = R.Year;
			INTO CURSOR tmpShipments
			*BROW
			
		*	REPORT FORM reports\r_shipments.frx PREVIEW
			
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getshipmentsmonthprocessdata
		*GetShipmentsMonthProcessData
		
		PRIVATE cSQL0, cSQL1, cSQL2 ,cSQLGFM, cSQL3, cSQLROLL, cSQL4, cSQLPress, cSQL5, cSQL6, cSQL7
		*cSQL0 Shipments
		*cSQL1 No Process 
		*cSQL2 GFM
		*cSQLGFM 
		*cSQL3 Roll
		*cSQLROLL
		*cSQL4 Press
		*cSQLPress
		*cSQL5 Mach
		*cSQL6 CG
		*cSQL7 Plasma
		
		cSQL0="SELECT [Year],[Jan],[Feb],[Mar],[Apr],[May],[Jun],[Jul],[Aug],[Sep],[Oct],[Nov],[Dec]"
		cSQL0=cSQL0+" FROM ( "
		cSQL0=cSQL0+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL0=cSQL0+", CAST([cmplt] AS INT) AS Cmplte"
		cSQL0=cSQL0+", (CASE MONTH(ShipDue)"
		cSQL0=cSQL0+" WHEN 1 THEN 'Jan' WHEN 2 THEN 'Feb' WHEN 3 THEN 'Mar' WHEN 4 THEN 'Apr'"
		cSQL0=cSQL0+" WHEN 5 THEN 'May' WHEN 6 THEN 'Jun' WHEN 7 THEN 'Jul' WHEN 8 THEN 'Aug'"
		cSQL0=cSQL0+" WHEN 9 THEN 'Sep' WHEN 10 THEN 'Oct' WHEN 11 THEN 'Nov' WHEN 12 THEN 'Dec'"
		cSQL0=cSQL0+" END"
		cSQL0=cSQL0+" )AS [Month]"
		cSQL0=cSQL0+" FROM dbo.Sales"
		cSQL0=cSQL0+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQL0=cSQL0+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		cSQL0=cSQL0+") AS ShipmentByMonth"
		cSQL0=cSQL0+" PIVOT( SUM([cmplte]) FOR [Month] IN"
		cSQL0=cSQL0+"([Jan],[Feb],[Mar],[Apr],[May],[Jun],"
		cSQL0=cSQL0+"[Jul],[Aug],[Sep],[Oct],[Nov],[Dec])"
		cSQL0=cSQL0+") AS Total_Shipments"
		cSQL0=cSQL0+" ORDER BY [Year] DESC"
		
		
		
		cSQL1 = "SELECT [Year],[Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],[Jl1],[Au1],[Se1],[Oc1],[No1],[De1]"
		cSQL1=cSQL1+" FROM ("
		cSQL1=cSQL1+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL1=cSQL1+", (CASE "
		cSQL1=cSQL1+" 	WHEN ISNULL(GFM,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(roll,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(Press,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(Mach,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(CG,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(Plasma,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	ELSE 1"
		cSQL1=cSQL1+" 	END) AS [NoProcess]"
		cSQL1=cSQL1+" , (CASE MONTH(ShipDue)"
		cSQL1=cSQL1+" WHEN 1 THEN 'Ja1'"
		cSQL1=cSQL1+" WHEN 2 THEN 'Fe1'"
		cSQL1=cSQL1+" WHEN 3 THEN 'Mr1'"
		cSQL1=cSQL1+" WHEN 4 THEN 'Ap1'"
		cSQL1=cSQL1+" WHEN 5 THEN 'My1'"
		cSQL1=cSQL1+" WHEN 6 THEN 'Jn1'"
		cSQL1=cSQL1+" WHEN 7 THEN 'Jl1'"
		cSQL1=cSQL1+" WHEN 8 THEN 'Au1'"
		cSQL1=cSQL1+" WHEN 9 THEN 'Se1'"
		cSQL1=cSQL1+" WHEN 10 THEN 'Oc1'"
		cSQL1=cSQL1+" WHEN 11 THEN 'No1'"
		cSQL1=cSQL1+" WHEN 12 THEN 'De1'"
		cSQL1=cSQL1+" END"
		cSQL1=cSQL1+"  )AS [MonthGood]"
		cSQL1=cSQL1+" FROM dbo.Sales"
		cSQL1=cSQL1+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQL1=cSQL1+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		cSQL1=cSQL1+" ) AS salesByMonth"
		cSQL1=cSQL1+" PIVOT( SUM([NoProcess]) FOR [MonthGood] IN"
		cSQL1=cSQL1+" ([Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],"
		cSQL1=cSQL1+" [Jl1],[Au1],[Se1],[Oc1],[No1],[De1])"
		cSQL1=cSQL1+" ) AS Shipments_NoProcess "
		cSQL1=cSQL1+" ORDER BY [Year] DESC"
		
		
		
		cSQL2 = "SELECT [Year],[Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],[Jl2],[Au2],[Se2],[Oc2],[No2],[De2]"
		cSQL2=cSQL2+" FROM ("
		cSQL2=cSQL2+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL2=cSQL2+" , (CASE WHEN ISNULL(GFM,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL2=cSQL2+" , (CASE MONTH(ShipDue)"
		cSQL2=cSQL2+" WHEN 1 THEN 'Ja2'"
		cSQL2=cSQL2+" WHEN 2 THEN 'Fe2'"
		cSQL2=cSQL2+" WHEN 3 THEN 'Mr2'"
		cSQL2=cSQL2+" WHEN 4 THEN 'Ap2'"
		cSQL2=cSQL2+" WHEN 5 THEN 'My2'"
		cSQL2=cSQL2+" WHEN 6 THEN 'Jn2'"
		cSQL2=cSQL2+" WHEN 7 THEN 'Jl2'"
		cSQL2=cSQL2+" WHEN 8 THEN 'Au2'"
		cSQL2=cSQL2+" WHEN 9 THEN 'Se2'"
		cSQL2=cSQL2+" WHEN 10 THEN 'Oc2'"
		cSQL2=cSQL2+" WHEN 11 THEN 'No2'"
		cSQL2=cSQL2+" WHEN 12 THEN 'De2'"
		cSQL2=cSQL2+" END"
		cSQL2=cSQL2+"  )AS [Monthwith5]"
		cSQL2=cSQL2+" FROM dbo.Sales"
		cSQL2=cSQL2+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQL2=cSQL2+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		cSQL2=cSQL2+" ) AS salesByMonth"
		cSQL2=cSQL2+" PIVOT( "
		cSQL2=cSQL2+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL2=cSQL2+" ([Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],"
		cSQL2=cSQL2+" [Jl2],[Au2],[Se2],[Oc2],[No2],[De2])"
		cSQL2=cSQL2+" ) AS Within2Days"
		cSQL2=cSQL2+" ORDER BY [Year] DESC"
		
		cSQLGFM = "SELECT [Year],[JaGFM],[FeGFM],[MrGFM],[ApGFM],[MyGFM],[JnGFM],[JlGFM],[AuGFM],[SeGFM],[OcGFM],[NoGFM],[DeGFM]"
		cSQLGFM=cSQLGFM+" FROM ( "
		cSQLGFM=cSQLGFM+"  SELECT YEAR(ShipDue) AS [Year]"
		cSQLGFM=cSQLGFM+" ,ItemSale "
		cSQLGFM=cSQLGFM+" , (CASE MONTH(ShipDue)"
		cSQLGFM=cSQLGFM+" WHEN 1 THEN 'JaGFM'"
		cSQLGFM=cSQLGFM+" WHEN 2 THEN 'FeGFM'"
		cSQLGFM=cSQLGFM+" WHEN 3 THEN 'MrGFM'"
		cSQLGFM=cSQLGFM+" WHEN 4 THEN 'ApGFM'"
		cSQLGFM=cSQLGFM+" WHEN 5 THEN 'MyGFM'"
		cSQLGFM=cSQLGFM+" WHEN 6 THEN 'JnGFM'"
		cSQLGFM=cSQLGFM+" WHEN 7 THEN 'JlGFM'"
		cSQLGFM=cSQLGFM+" WHEN 8 THEN 'AuGFM'"
		cSQLGFM=cSQLGFM+" WHEN 9 THEN 'SeGFM'"
		cSQLGFM=cSQLGFM+" WHEN 10 THEN 'OcGFM'"
		cSQLGFM=cSQLGFM+" WHEN 11 THEN 'NoGFM'"
		cSQLGFM=cSQLGFM+" WHEN 12 THEN 'DeGFM'"
		cSQLGFM=cSQLGFM+" END "
		cSQLGFM=cSQLGFM+"  )AS [MonthwithG]"
		cSQLGFM=cSQLGFM+" FROM dbo.Sales"
		cSQLGFM=cSQLGFM+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQLGFM=cSQLGFM+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		cSQLGFM=cSQLGFM+" AND ISNULL(GFM,0) = 1"
		cSQLGFM=cSQLGFM+" ) AS salesByMonth"
		cSQLGFM=cSQLGFM+" PIVOT( "
		cSQLGFM=cSQLGFM+" SUM([ItemSale]) FOR [MonthwithG] IN"
		cSQLGFM=cSQLGFM+" ([JaGFM],[FeGFM],[MrGFM],[ApGFM],[MyGFM],[JnGFM],"
		cSQLGFM=cSQLGFM+" [JlGFM],[AuGFM],[SeGFM],[OcGFM],[NoGFM],[DeGFM])"
		cSQLGFM=cSQLGFM+" ) AS GFMSales "
		cSQLGFM=cSQLGFM+" ORDER BY [Year] DESC "
		
		
		cSQL3 = "SELECT [Year],[Ja3],[Fe3],[Mr3],[Ap3],[My3],[Jn3],[Jl3],[Au3],[Se3],[Oc3],[No3],[De3]"
		cSQL3=cSQL3+" FROM ("
		cSQL3=cSQL3+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL3=cSQL3+" , (CASE WHEN ISNULL(Roll,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL3=cSQL3+" , (CASE MONTH(ShipDue)"
		cSQL3=cSQL3+" WHEN 1 THEN 'Ja3'"
		cSQL3=cSQL3+" WHEN 2 THEN 'Fe3'"
		cSQL3=cSQL3+" WHEN 3 THEN 'Mr3'"
		cSQL3=cSQL3+" WHEN 4 THEN 'Ap3'"
		cSQL3=cSQL3+" WHEN 5 THEN 'My3'"
		cSQL3=cSQL3+" WHEN 6 THEN 'Jn3'"
		cSQL3=cSQL3+" WHEN 7 THEN 'Jl3'"
		cSQL3=cSQL3+" WHEN 8 THEN 'Au3'"
		cSQL3=cSQL3+" WHEN 9 THEN 'Se3'"
		cSQL3=cSQL3+" WHEN 10 THEN 'Oc3'"
		cSQL3=cSQL3+" WHEN 11 THEN 'No3'"
		cSQL3=cSQL3+" WHEN 12 THEN 'De3'"
		cSQL3=cSQL3+" END"
		cSQL3=cSQL3+"  )AS [Monthwith5]"
		cSQL3=cSQL3+" FROM dbo.Sales"
		cSQL3=cSQL3+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQL3=cSQL3+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		*cSQL3=cSQL3+" AND ISNULL(ROLL,0) = 1"
		cSQL3=cSQL3+" ) AS salesByMonth"
		cSQL3=cSQL3+" PIVOT( "
		cSQL3=cSQL3+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL3=cSQL3+" ([Ja3],[Fe3],[Mr3],[Ap3],[My3],[Jn3],"
		cSQL3=cSQL3+" [Jl3],[Au3],[Se3],[Oc3],[No3],[De3])"
		cSQL3=cSQL3+" ) AS Within2Days"
		cSQL3=cSQL3+" ORDER BY [Year] DESC"
		
		
		cSQLROLL = "SELECT [Year],[JaRl],[FeRl],[MrRl],[ApRl],[MyRl],[JnRl],[JlRl],[AuRl],[SeRl],[OcRl],[NoRl],[DeRl]"
		cSQLROLL=cSQLROLL+" FROM ( "
		cSQLROLL=cSQLROLL+"  SELECT YEAR(ShipDue) AS [Year]"
		cSQLROLL=cSQLROLL+" ,ItemSale "
		cSQLROLL=cSQLROLL+" , (CASE MONTH(ShipDue)"
		cSQLROLL=cSQLROLL+" WHEN 1 THEN 'JaRl'"
		cSQLROLL=cSQLROLL+" WHEN 2 THEN 'FeRl'"
		cSQLROLL=cSQLROLL+" WHEN 3 THEN 'MrRl'"
		cSQLROLL=cSQLROLL+" WHEN 4 THEN 'ApRl'"
		cSQLROLL=cSQLROLL+" WHEN 5 THEN 'MyRl'"
		cSQLROLL=cSQLROLL+" WHEN 6 THEN 'JnRl'"
		cSQLROLL=cSQLROLL+" WHEN 7 THEN 'JlRl'"
		cSQLROLL=cSQLROLL+" WHEN 8 THEN 'AuRl'"
		cSQLROLL=cSQLROLL+" WHEN 9 THEN 'SeRl'"
		cSQLROLL=cSQLROLL+" WHEN 10 THEN 'OcRl'"
		cSQLROLL=cSQLROLL+" WHEN 11 THEN 'NoRl'"
		cSQLROLL=cSQLROLL+" WHEN 12 THEN 'DeRl'"
		cSQLROLL=cSQLROLL+" END "
		cSQLROLL=cSQLROLL+"  )AS [MonthwithR]"
		cSQLROLL=cSQLROLL+" FROM dbo.Sales"
		cSQLROLL=cSQLROLL+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQLROLL=cSQLROLL+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		cSQLROLL=cSQLROLL+" AND ISNULL(ROLL,0) = 1"
		cSQLROLL=cSQLROLL+" ) AS salesByMonth"
		cSQLROLL=cSQLROLL+" PIVOT( "
		cSQLROLL=cSQLROLL+" SUM([ItemSale]) FOR [MonthwithR] IN"
		cSQLROLL=cSQLROLL+" ([JaRl],[FeRl],[MrRl],[ApRl],[MyRl],[JnRl],"
		cSQLROLL=cSQLROLL+" [JlRl],[AuRl],[SeRl],[OcRl],[NoRl],[DeRl])"
		cSQLROLL=cSQLROLL+" ) AS RollSales "
		cSQLROLL=cSQLROLL+" ORDER BY [Year] DESC "
		
		
		cSQL4 = "SELECT [Year],[Ja4],[Fe4],[Mr4],[Ap4],[My4],[Jn4],[Jl4],[Au4],[Se4],[Oc4],[No4],[De4]"
		cSQL4=cSQL4+" FROM ("
		cSQL4=cSQL4+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL4=cSQL4+" , (CASE WHEN ISNULL(Press,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL4=cSQL4+" , (CASE MONTH(ShipDue)"
		cSQL4=cSQL4+" WHEN 1 THEN 'Ja4'"
		cSQL4=cSQL4+" WHEN 2 THEN 'Fe4'"
		cSQL4=cSQL4+" WHEN 3 THEN 'Mr4'"
		cSQL4=cSQL4+" WHEN 4 THEN 'Ap4'"
		cSQL4=cSQL4+" WHEN 5 THEN 'My4'"
		cSQL4=cSQL4+" WHEN 6 THEN 'Jn4'"
		cSQL4=cSQL4+" WHEN 7 THEN 'Jl4'"
		cSQL4=cSQL4+" WHEN 8 THEN 'Au4'"
		cSQL4=cSQL4+" WHEN 9 THEN 'Se4'"
		cSQL4=cSQL4+" WHEN 10 THEN 'Oc4'"
		cSQL4=cSQL4+" WHEN 11 THEN 'No4'"
		cSQL4=cSQL4+" WHEN 12 THEN 'De4'"
		cSQL4=cSQL4+" END"
		cSQL4=cSQL4+"  )AS [Monthwith5]"
		cSQL4=cSQL4+" FROM dbo.Sales"
		cSQL4=cSQL4+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQL4=cSQL4+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		*cSQL4=cSQL4+" AND ISNULL(PRESS,0) = 1"
		cSQL4=cSQL4+" ) AS salesByMonth"
		cSQL4=cSQL4+" PIVOT( "
		cSQL4=cSQL4+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL4=cSQL4+" ([Ja4],[Fe4],[Mr4],[Ap4],[My4],[Jn4],"
		cSQL4=cSQL4+" [Jl4],[Au4],[Se4],[Oc4],[No4],[De4])"
		cSQL4=cSQL4+" ) AS Within2Days"
		cSQL4=cSQL4+" ORDER BY [Year] DESC"
		
		
		cSQLPress = "SELECT [Year],[JaPs],[FePs],[MrPs],[ApPs],[MyPs],[JnPs],[JlPs],[AuPs],[SePs],[OcPs],[NoPs],[DePs]"
		cSQLPress=cSQLPress+" FROM ( "
		cSQLPress=cSQLPress+"  SELECT YEAR(ShipDue) AS [Year]"
		cSQLPress=cSQLPress+" ,ItemSale "
		cSQLPress=cSQLPress+" , (CASE MONTH(ShipDue)"
		cSQLPress=cSQLPress+" WHEN 1 THEN 'JaPs'"
		cSQLPress=cSQLPress+" WHEN 2 THEN 'FePs'"
		cSQLPress=cSQLPress+" WHEN 3 THEN 'MrPs'"
		cSQLPress=cSQLPress+" WHEN 4 THEN 'ApPs'"
		cSQLPress=cSQLPress+" WHEN 5 THEN 'MyPs'"
		cSQLPress=cSQLPress+" WHEN 6 THEN 'JnPs'"
		cSQLPress=cSQLPress+" WHEN 7 THEN 'JlPs'"
		cSQLPress=cSQLPress+" WHEN 8 THEN 'AuPs'"
		cSQLPress=cSQLPress+" WHEN 9 THEN 'SePs'"
		cSQLPress=cSQLPress+" WHEN 10 THEN 'OcPs'"
		cSQLPress=cSQLPress+" WHEN 11 THEN 'NoPs'"
		cSQLPress=cSQLPress+" WHEN 12 THEN 'DePs'"
		cSQLPress=cSQLPress+" END "
		cSQLPress=cSQLPress+"  )AS [MonthwithP]"
		cSQLPress=cSQLPress+" FROM dbo.Sales"
		cSQLPress=cSQLPress+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQLPress=cSQLPress+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		cSQLPress=cSQLPress+" AND ISNULL(PRESS,0) = 1"
		cSQLPress=cSQLPress+" ) AS salesByMonth"
		cSQLPress=cSQLPress+" PIVOT( "
		cSQLPress=cSQLPress+" SUM([ItemSale]) FOR [MonthwithP] IN"
		cSQLPress=cSQLPress+" ([JaPs],[FePs],[MrPs],[ApPs],[MyPs],[JnPs],"
		cSQLPress=cSQLPress+" [JlPs],[AuPs],[SePs],[OcPs],[NoPs],[DePs])"
		cSQLPress=cSQLPress+" ) AS PressSales "
		cSQLPress=cSQLPress+" ORDER BY [Year] DESC "
		
		
		cSQL5 = "SELECT [Year],[Ja5],[Fe5],[Mr5],[Ap5],[My5],[Jn5],[Jl5],[Au5],[Se5],[Oc5],[No5],[De5]"
		cSQL5=cSQL5+" FROM ("
		cSQL5=cSQL5+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL5=cSQL5+" , (CASE WHEN ISNULL(Mach,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL5=cSQL5+" , (CASE MONTH(ShipDue)"
		cSQL5=cSQL5+" WHEN 1 THEN 'Ja5'"
		cSQL5=cSQL5+" WHEN 2 THEN 'Fe5'"
		cSQL5=cSQL5+" WHEN 3 THEN 'Mr5'"
		cSQL5=cSQL5+" WHEN 4 THEN 'Ap5'"
		cSQL5=cSQL5+" WHEN 5 THEN 'My5'"
		cSQL5=cSQL5+" WHEN 6 THEN 'Jn5'"
		cSQL5=cSQL5+" WHEN 7 THEN 'Jl5'"
		cSQL5=cSQL5+" WHEN 8 THEN 'Au5'"
		cSQL5=cSQL5+" WHEN 9 THEN 'Se5'"
		cSQL5=cSQL5+" WHEN 10 THEN 'Oc5'"
		cSQL5=cSQL5+" WHEN 11 THEN 'No5'"
		cSQL5=cSQL5+" WHEN 12 THEN 'De5'"
		cSQL5=cSQL5+" END"
		cSQL5=cSQL5+"  )AS [Monthwith5]"
		cSQL5=cSQL5+" FROM dbo.Sales"
		cSQL5=cSQL5+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQL5=cSQL5+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		cSQL5=cSQL5+" ) AS salesByMonth"
		cSQL5=cSQL5+" PIVOT( "
		cSQL5=cSQL5+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL5=cSQL5+" ([Ja5],[Fe5],[Mr5],[Ap5],[My5],[Jn5],"
		cSQL5=cSQL5+" [Jl5],[Au5],[Se5],[Oc5],[No5],[De5])"
		cSQL5=cSQL5+" ) AS Within2Days"
		cSQL5=cSQL5+" ORDER BY [Year] DESC"
		
		
		cSQL6 = "SELECT [Year],[Ja6],[Fe6],[Mr6],[Ap6],[My6],[Jn6],[Jl6],[Au6],[Se6],[Oc6],[No6],[De6]"
		cSQL6=cSQL6+" FROM ("
		cSQL6=cSQL6+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL6=cSQL6+" , (CASE WHEN ISNULL(CG,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL6=cSQL6+" , (CASE MONTH(ShipDue)"
		cSQL6=cSQL6+" WHEN 1 THEN 'Ja6'"
		cSQL6=cSQL6+" WHEN 2 THEN 'Fe6'"
		cSQL6=cSQL6+" WHEN 3 THEN 'Mr6'"
		cSQL6=cSQL6+" WHEN 4 THEN 'Ap6'"
		cSQL6=cSQL6+" WHEN 5 THEN 'My6'"
		cSQL6=cSQL6+" WHEN 6 THEN 'Jn6'"
		cSQL6=cSQL6+" WHEN 7 THEN 'Jl6'"
		cSQL6=cSQL6+" WHEN 8 THEN 'Au6'"
		cSQL6=cSQL6+" WHEN 9 THEN 'Se6'"
		cSQL6=cSQL6+" WHEN 10 THEN 'Oc6'"
		cSQL6=cSQL6+" WHEN 11 THEN 'No6'"
		cSQL6=cSQL6+" WHEN 12 THEN 'De6'"
		cSQL6=cSQL6+" END"
		cSQL6=cSQL6+"  )AS [Monthwith5]"
		cSQL6=cSQL6+" FROM dbo.Sales"
		cSQL6=cSQL6+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQL6=cSQL6+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		cSQL6=cSQL6+" ) AS salesByMonth"
		cSQL6=cSQL6+" PIVOT( "
		cSQL6=cSQL6+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL6=cSQL6+" ([Ja6],[Fe6],[Mr6],[Ap6],[My6],[Jn6],"
		cSQL6=cSQL6+" [Jl6],[Au6],[Se6],[Oc6],[No6],[De6])"
		cSQL6=cSQL6+" ) AS Within6Days"
		cSQL6=cSQL6+" ORDER BY [Year] DESC"
		
		cSQL7 = "SELECT [Year],[Ja7],[Fe7],[Mr7],[Ap7],[My7],[Jn7],[Jl7],[Au7],[Se7],[Oc7],[No7],[De7]"
		cSQL7=cSQL7+" FROM ("
		cSQL7=cSQL7+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL7=cSQL7+" , (CASE WHEN ISNULL(Plasma,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL7=cSQL7+" , (CASE MONTH(ShipDue)"
		cSQL7=cSQL7+" WHEN 1 THEN 'Ja7'"
		cSQL7=cSQL7+" WHEN 2 THEN 'Fe7'"
		cSQL7=cSQL7+" WHEN 3 THEN 'Mr7'"
		cSQL7=cSQL7+" WHEN 4 THEN 'Ap7'"
		cSQL7=cSQL7+" WHEN 5 THEN 'My7'"
		cSQL7=cSQL7+" WHEN 6 THEN 'Jn7'"
		cSQL7=cSQL7+" WHEN 7 THEN 'Jl7'"
		cSQL7=cSQL7+" WHEN 8 THEN 'Au7'"
		cSQL7=cSQL7+" WHEN 9 THEN 'Se7'"
		cSQL7=cSQL7+" WHEN 10 THEN 'Oc7'"
		cSQL7=cSQL7+" WHEN 11 THEN 'No7'"
		cSQL7=cSQL7+" WHEN 12 THEN 'De7'"
		cSQL7=cSQL7+" END"
		cSQL7=cSQL7+"  )AS [Monthwith5]"
		cSQL7=cSQL7+" FROM dbo.Sales"
		cSQL7=cSQL7+" WHERE Year(ShipDue) > YEAR(GETDATE()-730)"
		cSQL7=cSQL7+" AND Shipped >= GETDATE()-730  AND ISNULL(Cncld,0) < 1"
		cSQL7=cSQL7+" ) AS salesByMonth"
		cSQL7=cSQL7+" PIVOT( "
		cSQL7=cSQL7+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL7=cSQL7+" ([Ja7],[Fe7],[Mr7],[Ap7],[My7],[Jn7],"
		cSQL7=cSQL7+" [Jl7],[Au7],[Se7],[Oc7],[No7],[De7])"
		cSQL7=cSQL7+" ) AS Within2Days"
		cSQL7=cSQL7+" ORDER BY [Year] DESC"
		
		*cSQL0 Shipments Total
