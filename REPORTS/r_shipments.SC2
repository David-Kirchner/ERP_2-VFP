	PROCEDURE getlateshipmentsdata
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpLateShipments')
			USE IN tmpLateShipments
		ENDIF
		
		cSQL = "SELECT Sales.*, Sales_No.SalesRep, SoldAddr.Company, AQ.Form "
		cSQL = cSQL +",ISNULL(Sales_No.PrintedSO,0) AS PrintedSO, ISNULL(Sales_No.ShopRecv,0) AS ShopRecv "
		cSQL = cSQL +",Sales_No.Amendment"
		cSQL = cSQL +" FROM dbo.Sales, dbo.Sales_No, dbo.SoldAddr, dbo.AllQuotes AQ WHERE"
		cSQL = cSQL +" ISNULL(Sales.Cncld,0) < 1 AND ISNULL(Sales.Cmplt,0) < 1 "
		cSQL = cSQL +" AND (( ISNULL(ShipOn,0) = 0 AND Sales.ShipDue < GetDate()-1) OR ( ISNULL(ShipOn,0) > 0 AND Sales.ShipDue < GetDate() ) )"
		cSQL = cSQL +" AND Sales.Salesnum = Sales_No.SalesNum "
		cSQL = cSQL +" AND Sales_No.pSoldAddr = SoldAddr.SoldCode "
		cSQL = cSQL +" AND Sales.SOitem = AQ.SOitem"
		cSQL = cSQL +" ORDER BY SalesNum, PrintedSO, ShopRecv "
		
		  
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLateShipments')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLateShipments')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLateShipments")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLateShipments")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpLateShipments')
		ENDIF
		
		IF !USED('tmpLateShipments')
			lGood = .F.
		ENDIF
		
		
		IF lGood
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getlateshipstatus
		*ThisForm.GetLateShipStatus()
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpLateShipStatus')
			USE IN tmpLateShipStatus
		ENDIF
		
		cSQL = "SELECT S.* "
		cSQL = cSQL +", SN.SalesRep, SoldAddr.Company, AQ.Form "
		cSQL = cSQL +", ISNULL(SN.PrintedSO,0) AS PrintedSO, ISNULL(SN.ShopRecv,0) AS ShopRecv "
		cSQL = cSQL +", SN.Amendment "
		cSQL = cSQL +", SS.[Who],SS.[What],SS.[When],SS.Comment "
		cSQL = cSQL +" FROM dbo.Sales S "
		cSQL = cSQL +" INNER JOIN dbo.Sales_No SN ON SN.Salesnum = S.Salesnum "
		cSQL = cSQL +" INNER JOIN dbo.SoldAddr ON SoldAddr.SoldCode = SN.pSoldAddr "
		cSQL = cSQL +" INNER JOIN dbo.AllQuotes AQ ON AQ.SOitem = S.SOitem "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.Sales_Status SS ON SS.SOitem = S.SOitem "
		cSQL = cSQL +" WHERE ISNULL(S.Cncld,0) < 1 AND ISNULL(S.Cmplt,0) < 1 "
		cSQL = cSQL +" AND (( ISNULL(S.ShipOn,0) = 0 AND S.ShipDue < GetDate()-1) OR ( ISNULL(S.ShipOn,0) > 0 AND S.ShipDue < GetDate() ) )"
		cSQL = cSQL +" ORDER BY S.SOitem, PrintedSO, ShopRecv ,SS.[When] DESC"
		  
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLateShipStatus')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLateShipStatus')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpLateShipStatus')
		ENDIF
		
		IF !USED('tmpLateShipStatus')
			lGood = .F.
		ENDIF
		
		
		IF lGood
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getproductionorderdata
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpProductionOrders')
			USE IN tmpProductionOrders
		ENDIF
		
		cSQL = "SELECT Sales.*"
		cSQL = cSQL +", AQ.Pieces, dbo.f_ItemDescription(AQ.Form,AQ.thck,AQ.Sz2,AQ.Sz3,AQ.Weight,AQ.RandLen) AS Descript"
		cSQL = cSQL +", Sales_No.SalesRep"
		cSQL = cSQL +", AQ.Company, AQ.Form "
		cSQL = cSQL +", ISNULL(Sales_No.PrintedSO,0) AS PrintedSO"
		cSQL = cSQL +", ISNULL(Sales_No.ShopRecv,0) AS ShopRecv "
		cSQL = cSQL +" FROM dbo.Sales, dbo.Sales_No, dbo.AllQuotes AQ "
		cSQL = cSQL +" WHERE ISNULL(Sales.Cncld,0) < 1 "
		cSQL = cSQL +" AND ISNULL(Sales.Cmplt,0) < 1 "
		cSQL = cSQL +" AND AQ.Company LIKE '%Space Alloys USA%'"
		cSQL = cSQL +" AND Sales.Salesnum = Sales_No.SalesNum "
		cSQL = cSQL +" AND Sales.SOitem = AQ.SOitem"
		cSQL = cSQL +" ORDER BY Shipdue, SalesNum "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProductionOrders')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProductionOrders')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpProductionOrders')
		ENDIF
		
		IF !USED('tmpProductionOrders')
			lGood = .F.
		ENDIF
		
		
		IF lGood
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getqtydata
		*ThisForm.GetQTYData()
		
		PRIVATE cSQL0, cSQL1, cSQL5, cSQLlBs, cSQLrma
		*cSQL0, 'tmpShipmentsTotal'
		cSQL0="SELECT [Year],[Jan],[Feb],[Mar],[Apr],[May],[Jun],[Jul],[Aug],[Sep],[Oct],[Nov],[Dec]"
		cSQL0=cSQL0+" FROM ( "
		cSQL0=cSQL0+" SELECT YEAR(Shipped) AS [Year]"
		cSQL0=cSQL0+", CAST(ISNULL(Quoted_QTY,0) AS INT) AS Quoted_QTY"
		cSQL0=cSQL0+",(CASE MONTH(Shipped)"
		cSQL0=cSQL0+" WHEN 1 THEN 'Jan' WHEN 2 THEN 'Feb' WHEN 3 THEN 'Mar' WHEN 4 THEN 'Apr'"
		cSQL0=cSQL0+" WHEN 5 THEN 'May' WHEN 6 THEN 'Jun' WHEN 7 THEN 'Jul' WHEN 8 THEN 'Aug'"
		cSQL0=cSQL0+" WHEN 9 THEN 'Sep' WHEN 10 THEN 'Oct' WHEN 11 THEN 'Nov' WHEN 12 THEN 'Dec'"
		cSQL0=cSQL0+" END"
		cSQL0=cSQL0+" )AS [Month]"
		cSQL0=cSQL0+" FROM dbo.Sales"
		cSQL0=cSQL0+" WHERE YEAR(ShipDue) > 2013"
		cSQL0=cSQL0+" AND  YEAR(Shipped) > 2013"
		cSQL0=cSQL0+" AND ISNULL(Cncld,0) < 1"
		cSQL0=cSQL0+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL0=cSQL0+") AS salesByMonth"
		cSQL0=cSQL0+" PIVOT( SUM([Quoted_QTY]) FOR [Month] IN"
		cSQL0=cSQL0+"([Jan],[Feb],[Mar],[Apr],[May],[Jun],"
		cSQL0=cSQL0+"[Jul],[Aug],[Sep],[Oct],[Nov],[Dec])"
		cSQL0=cSQL0+") AS SUM_QTY "
		cSQL0=cSQL0+" ORDER BY [Year] DESC"
		
		*cSQL1, 'tmpShipmentsOnTime'
		*cSQL1="SELECT [Year],[Jan],[Feb],[Mar],[Apr],[May],[Jun],[Jul],[Aug],[Sep],[Oct],[Nov],[Dec]"
		cSQL1 = "SELECT [Year],[Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],[Jl1],[Au1],[Se1],[Oc1],[No1],[De1]"
		cSQL1=cSQL1+" FROM ( "
		cSQL1=cSQL1+" SELECT YEAR(Shipped) AS [Year]"
		cSQL1=cSQL1+", (CASE "
		cSQL1=cSQL1+" 	WHEN ([Shipped] <= [ShipDue] AND ISNULL(ShipOn,0) = 0) THEN CAST(ISNULL(Quoted_QTY,0) AS INT) "
		cSQL1=cSQL1+" 	WHEN ([Shipped] >= [ShipDue] AND ISNULL(ShipOn,0) = 1) THEN CAST(ISNULL(Quoted_QTY,0) AS INT) "
		cSQL1=cSQL1+" ELSE 0 "
		cSQL1=cSQL1+" END) AS Quoted_QTY "
		cSQL1=cSQL1+",(CASE MONTH(Shipped)"
		cSQL1=cSQL1+" WHEN 1 THEN 'Ja1'"
		cSQL1=cSQL1+" WHEN 2 THEN 'Fe1'"
		cSQL1=cSQL1+" WHEN 3 THEN 'Mr1'"
		cSQL1=cSQL1+" WHEN 4 THEN 'Ap1'"
		cSQL1=cSQL1+" WHEN 5 THEN 'My1'"
		cSQL1=cSQL1+" WHEN 6 THEN 'Jn1'"
		cSQL1=cSQL1+" WHEN 7 THEN 'Jl1'"
		cSQL1=cSQL1+" WHEN 8 THEN 'Au1'"
		cSQL1=cSQL1+" WHEN 9 THEN 'Se1'"
		cSQL1=cSQL1+" WHEN 10 THEN 'Oc1'"
		cSQL1=cSQL1+" WHEN 11 THEN 'No1'"
		cSQL1=cSQL1+" WHEN 12 THEN 'De1'"
		cSQL1=cSQL1+" END"
		cSQL1=cSQL1+" )AS [Month]"
		cSQL1=cSQL1+" FROM dbo.Sales"
		cSQL1=cSQL1+" WHERE YEAR(ShipDue) > 2013"
		cSQL1=cSQL1+" AND  YEAR(Shipped) > 2013"
		cSQL1=cSQL1+" AND ISNULL(Cncld,0) < 1"
		cSQL1=cSQL1+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL1=cSQL1+") AS salesByMonth"
		cSQL1=cSQL1+" PIVOT( SUM([Quoted_QTY]) FOR [Month] IN"
		cSQL1=cSQL1+" ([Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],"
		cSQL1=cSQL1+" [Jl1],[Au1],[Se1],[Oc1],[No1],[De1])"
		cSQL1=cSQL1+" ) AS On_Time_Shipments "
		cSQL1=cSQL1+" ORDER BY [Year] DESC"
		
		*cSQL2, 'tmpShipmentsWithin2Days'
		cSQL2 = "SELECT [Year],[Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],[Jl2],[Au2],[Se2],[Oc2],[No2],[De2]"
		cSQL2 =cSQL2 +" FROM ( "
		cSQL2 =cSQL2 +" SELECT YEAR(Shipped) AS [Year]"
		cSQL2 =cSQL2 +", (CASE "
		cSQL2 =cSQL2 +" 	WHEN ([Shipped] <= [ShipDue]+2 AND ISNULL(ShipOn,0) = 0) THEN CAST(ISNULL(Quoted_QTY,0) AS INT) "
		cSQL2 =cSQL2 +" 	WHEN ([Shipped] >= [ShipDue]-2 AND ISNULL(ShipOn,0) = 1) THEN CAST(ISNULL(Quoted_QTY,0) AS INT) "
		cSQL2 =cSQL2 +" ELSE 0 "
		cSQL2 =cSQL2 +" END) AS Quoted_QTY "
		cSQL2 =cSQL2 +",(CASE MONTH(Shipped)"
		cSQL2=cSQL2+" WHEN 1 THEN 'Ja2'"
		cSQL2=cSQL2+" WHEN 2 THEN 'Fe2'"
		cSQL2=cSQL2+" WHEN 3 THEN 'Mr2'"
		cSQL2=cSQL2+" WHEN 4 THEN 'Ap2'"
		cSQL2=cSQL2+" WHEN 5 THEN 'My2'"
		cSQL2=cSQL2+" WHEN 6 THEN 'Jn2'"
		cSQL2=cSQL2+" WHEN 7 THEN 'Jl2'"
		cSQL2=cSQL2+" WHEN 8 THEN 'Au2'"
		cSQL2=cSQL2+" WHEN 9 THEN 'Se2'"
		cSQL2=cSQL2+" WHEN 10 THEN 'Oc2'"
		cSQL2=cSQL2+" WHEN 11 THEN 'No2'"
		cSQL2=cSQL2+" WHEN 12 THEN 'De2'"
		cSQL2 =cSQL2 +" END"
		cSQL2 =cSQL2 +" )AS [Month]"
		cSQL2 =cSQL2 +" FROM dbo.Sales"
		cSQL2 =cSQL2 +" WHERE YEAR(ShipDue) > 2013"
		cSQL2 =cSQL2 +" AND  YEAR(Shipped) > 2013"
		cSQL2 =cSQL2 +" AND ISNULL(Cncld,0) < 1"
		cSQL2 =cSQL2 +" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL2 =cSQL2 +") AS salesByMonth"
		cSQL2 =cSQL2 +" PIVOT( SUM([Quoted_QTY]) FOR [Month] IN"
		cSQL2=cSQL2+" ([Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],"
		cSQL2=cSQL2+" [Jl2],[Au2],[Se2],[Oc2],[No2],[De2])"
		cSQL2=cSQL2+" ) AS Within2Days"
		cSQL2 =cSQL2 +" ORDER BY [Year] DESC"
		
		*cSQL5, 'tmpShipmentsWithinWeek'
		cSQL5 = "SELECT [Year],[Ja5],[Fe5],[Mr5],[Ap5],[My5],[Jn5],[Jl5],[Au5],[Se5],[Oc5],[No5],[De5]"
		cSQL5=cSQL5+" FROM ( "
		cSQL5=cSQL5+" SELECT YEAR(Shipped) AS [Year]"
		cSQL5=cSQL5+", (CASE "
		cSQL5=cSQL5+" 	WHEN ([Shipped] <= [ShipDue]+7 AND ISNULL(ShipOn,0) = 0) THEN CAST(ISNULL(Quoted_QTY,0) AS INT) "
		cSQL5=cSQL5+" 	WHEN ([Shipped] >= [ShipDue]-7 AND ISNULL(ShipOn,0) = 1) THEN CAST(ISNULL(Quoted_QTY,0) AS INT) "
		cSQL5=cSQL5+" ELSE 0 "
		cSQL5=cSQL5+" END) AS Quoted_QTY "
		cSQL5=cSQL5+",(CASE MONTH(Shipped)"
		cSQL5=cSQL5+" WHEN 1 THEN 'Ja5'"
		cSQL5=cSQL5+" WHEN 2 THEN 'Fe5'"
		cSQL5=cSQL5+" WHEN 3 THEN 'Mr5'"
		cSQL5=cSQL5+" WHEN 4 THEN 'Ap5'"
		cSQL5=cSQL5+" WHEN 5 THEN 'My5'"
		cSQL5=cSQL5+" WHEN 6 THEN 'Jn5'"
		cSQL5=cSQL5+" WHEN 7 THEN 'Jl5'"
		cSQL5=cSQL5+" WHEN 8 THEN 'Au5'"
		cSQL5=cSQL5+" WHEN 9 THEN 'Se5'"
		cSQL5=cSQL5+" WHEN 10 THEN 'Oc5'"
		cSQL5=cSQL5+" WHEN 11 THEN 'No5'"
		cSQL5=cSQL5+" WHEN 12 THEN 'De5'"
		cSQL5=cSQL5+" END"
		cSQL5=cSQL5+" )AS [Month]"
		cSQL5=cSQL5+" FROM dbo.Sales"
		cSQL5=cSQL5+" WHERE YEAR(ShipDue) > 2013"
		cSQL5=cSQL5+" AND  YEAR(Shipped) > 2013"
		cSQL5=cSQL5+" AND ISNULL(Cncld,0) < 1"
		cSQL5=cSQL5+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL5=cSQL5+") AS salesByMonth"
		cSQL5=cSQL5+" PIVOT( SUM([Quoted_QTY]) FOR [Month] IN"
		cSQL5=cSQL5+" ([Ja5],[Fe5],[Mr5],[Ap5],[My5],[Jn5],"
		cSQL5=cSQL5+" [Jl5],[Au5],[Se5],[Oc5],[No5],[De5])"
		cSQL5=cSQL5+" ) AS WithinWeek"
		cSQL5=cSQL5+" ORDER BY [Year] DESC"
		
		
		*cSQLlBs, 'tmpShipmentsLBs'
		cSQLlBs= "SELECT [Year],[Jalb],[Felb],[M3lb],[Aplb],[M5lb],[J6lb],[J7lb],[Aulb],[Selb],[Oclb],[Nolb],[Delb]"
		cSQLlBs=cSQLlBs+" FROM ( "
		cSQLlBs=cSQLlBs+" SELECT YEAR(Shipped) AS [Year]"
		cSQLlBs=cSQLlBs+", CAST(ISNULL(MatlWt,0) AS INT) AS MatlWt"
		cSQLlBs=cSQLlBs+", (CASE MONTH(Shipped) "
		cSQLlBs=cSQLlBs+" WHEN 1 THEN 'Jalb' WHEN 2 THEN 'Felb' WHEN 3 THEN 'M3lb' WHEN 4 THEN 'Aplb' "
		cSQLlBs=cSQLlBs+" WHEN 5 THEN 'M5lb' WHEN 6 THEN 'J6lb' WHEN 7 THEN 'J7lb' WHEN 8 THEN 'Aulb' "
		cSQLlBs=cSQLlBs+" WHEN 9 THEN 'Selb' WHEN 10 THEN 'Oclb' WHEN 11 THEN 'Nolb' WHEN 12 THEN 'Delb' "
		cSQLlBs=cSQLlBs+" END "
		cSQLlBs=cSQLlBs+" )AS [Month] "
		cSQLlBs=cSQLlBs+" FROM dbo.Sales "
		cSQLlBs=cSQLlBs+" WHERE YEAR(ShipDue) > 2013"
		cSQLlBs=cSQLlBs+" AND  YEAR(Shipped) > 2013"
		cSQLlBs=cSQLlBs+" AND ISNULL(Cncld,0) < 1"
		cSQLlBs=cSQLlBs+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQLlBs=cSQLlBs+") AS salesByMonth "
		cSQLlBs=cSQLlBs+" PIVOT( SUM([MatlWt]) FOR [Month] IN "
		cSQLlBs=cSQLlBs+"([Jalb],[Felb],[M3lb],[Aplb],[M5lb],[J6lb],"
		cSQLlBs=cSQLlBs+"[J7lb],[Aulb],[Selb],[Oclb],[Nolb],[Delb]) "
		cSQLlBs=cSQLlBs+") AS Total_lBs "
		cSQLlBs=cSQLlBs+" ORDER BY [Year] DESC "
		
		*cSQLrma, 'tmpShipmentsRMA'
		cSQLrma = "SELECT [Year],[JaR],[FeR],[MrR],[AlR],[MyR],[JnR],[JlR],[AuR],[SeR],[OcR],[NoR],[DeR]"
		cSQLrma=cSQLrma+" FROM ("
		cSQLrma=cSQLrma+" SELECT YEAR(R.Aprv_Date) AS [Year]"
		cSQLrma=cSQLrma+" , (CASE WHEN S.RMA_No > 0 THEN 1 ELSE 0 END) AS [RMA]"
		cSQLrma=cSQLrma+" , (CASE MONTH(R.Aprv_Date)"
		cSQLrma=cSQLrma+" WHEN 1 THEN 'JaR'"
		cSQLrma=cSQLrma+" WHEN 2 THEN 'FeR'"
		cSQLrma=cSQLrma+" WHEN 3 THEN 'MrR'"
		cSQLrma=cSQLrma+" WHEN 4 THEN 'AlR'"
		cSQLrma=cSQLrma+" WHEN 5 THEN 'MyR'"
		cSQLrma=cSQLrma+" WHEN 6 THEN 'JnR'"
		cSQLrma=cSQLrma+" WHEN 7 THEN 'JlR'"
		cSQLrma=cSQLrma+" WHEN 8 THEN 'AuR'"
		cSQLrma=cSQLrma+" WHEN 9 THEN 'SeR'"
		cSQLrma=cSQLrma+" WHEN 10 THEN 'OcR'"
		cSQLrma=cSQLrma+" WHEN 11 THEN 'NoR'"
		cSQLrma=cSQLrma+" WHEN 12 THEN 'DeR'"
		cSQLrma=cSQLrma+" END"
		cSQLrma=cSQLrma+"  )AS [MonthRMA]"
		cSQLrma=cSQLrma+" FROM dbo.Sales S "
		cSQLrma=cSQLrma+" INNER JOIN dbo.RMA_Detail RD ON RD.SO_Item = S.SOitem "
		cSQLrma=cSQLrma+" INNER JOIN dbo.rma R ON R.rma_no = RD.rma_no "
		cSQLrma=cSQLrma+" WHERE YEAR(R.Aprv_Date ) > 2013"
		cSQLrma=cSQLrma+" AND YEAR(R.Aprv_Date) <= YEAR(GETDATE()) "
		 cSQLrma=cSQLrma+" ) AS salesByMonth"
		cSQLrma=cSQLrma+" PIVOT( "
		cSQLrma=cSQLrma+" SUM([RMA]) FOR [MonthRMA] IN"
		cSQLrma=cSQLrma+" ([JaR],[FeR],[MrR],[AlR],[MyR],[JnR],"
		cSQLrma=cSQLrma+" [JlR],[AuR],[SeR],[OcR],[NoR],[DeR])"
		cSQLrma=cSQLrma+" ) AS RMAPivot"
		cSQLrma=cSQLrma+" ORDER BY [Year] DESC"
		
		
		IF USED('tmpShipments')
			USE IN tmpShipments
		ENDIF
		IF USED('tmpShipmentsTotal')
			USE IN tmpShipmentsTotal
		ENDIF
		IF USED('tmpShipmentsOnTime')
			USE IN tmpShipmentsOnTime
		ENDIF
		IF USED('tmpShipmentsWithin2Days')
			USE IN tmpShipmentsWithin2Days
		ENDIF
		IF USED('tmpShipmentsWithinWeek')
			USE IN tmpShipmentsWithinWeek
		ENDIF
		IF USED('tmpShipmentsRMA')
			USE IN tmpShipmentsRMA
		ENDIF
		
		SELECT 0
		PRIVATE nSQLEXEC, lGood
		lGood = .T.
		
		WAIT WINDOW "1 of 5" NOWAIT
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL0, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsTotal')
		ENDIF
		IF !USED('tmpShipmentsTotal')
			lGood = .F.
		ENDIF
		
		WAIT WINDOW "2 of 5" NOWAIT
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsOnTime')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsOnTime')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL1, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsOnTime')
		ENDIF
		IF !USED('tmpShipmentsOnTime')
			lGood = .F.
		ENDIF
		
		WAIT WINDOW "3 of 5" NOWAIT
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsWithin2Days')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsWithin2Days')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL2, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsWithin2Days')
		ENDIF
		IF !USED('tmpShipmentsWithin2Days')
			lGood = .F.
		ENDIF
		
		WAIT WINDOW "4 of 5" NOWAIT
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL5, 'tmpShipmentsWithinWeek')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL5, 'tmpShipmentsWithinWeek')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL5, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsWithinWeek')
		ENDIF
		IF !USED('tmpShipmentsWithinWeek')
			lGood = .F.
		ENDIF
		
		WAIT WINDOW "5 of 5" NOWAIT
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLlBs, 'tmpShipmentsLBs')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLlBs, 'tmpShipmentsLBs')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQLlBs, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsLBs')
		ENDIF
		IF !USED('tmpShipmentsLBs')
			lGood = .F.
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLrma, 'tmpShipmentsRMA')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLrma, 'tmpShipmentsRMA')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQLrma, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsRMA')
		ENDIF
		IF !USED('tmpShipmentsRMA')
			lGood = .F.
		ENDIF
		
		
		IF lGood
			SELECT T.Year,Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec;
				,Ja1,Fe1,Mr1,Ap1,My1,Jn1,Jl1,Au1,Se1,Oc1,No1,De1;
				,Ja2,Fe2,Mr2,Ap2,My2,Jn2,Jl2,Au2,Se2,Oc2,No2,De2;
				,Ja5,Fe5,Mr5,Ap5,My5,Jn5,Jl5,Au5,Se5,Oc5,No5,De5;
				,Jalb,Felb,M3lb,Aplb,M5lb,J6lb,J7lb,Aulb,Selb,Oclb,Nolb,Delb;
				,JaR,FeR,MrR,AlR,MyR,JnR,JlR,AuR,SeR,OcR,NoR,DeR;
			FROM tmpShipmentsTotal T, tmpShipmentsOnTime OT, tmpShipmentsWithin2Days W2D, ;
				tmpShipmentsWithinWeek WW, tmpShipmentsLBs L, tmpShipmentsRMA R;
			WHERE T.Year = OT.Year AND OT.Year = W2D.Year AND W2D.Year = WW.Year AND WW.Year = L.Year AND L.Year = R.Year;
			INTO CURSOR tmpShipments
			*BROW
			
		*	REPORT FORM reports\r_shipments.frx PREVIEW
			
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getsalesmonthprocessdata
		*GetSalesMonthProcessData
		*GetShipmentsMonthProcessData
		
		PRIVATE cSQL0, cSQL1, cSQL2 ,cSQLGFM, cSQL3, cSQLROLL, cSQL4, cSQLPress, cSQL5, cSQL6, cSQL7
		*cSQL0 Shipments
		*cSQL1 No Process 
		*cSQL2 GFM
		*cSQLGFM 
		*cSQL3 Roll
		*cSQLROLL
		*cSQL4 Press
		*cSQLPress
		*cSQL5 Mach
		*cSQL6 CG
		*cSQL7 Plasma
		
		*Total Sales
		cSQL0="SELECT [Year],[Jan],[Feb],[Mar],[Apr],[May],[Jun],[Jul],[Aug],[Sep],[Oct],[Nov],[Dec]"
		cSQL0=cSQL0+" FROM ( "
		cSQL0=cSQL0+" SELECT YEAR(SaleDate) AS [Year]"
		cSQL0=cSQL0+", 1 AS Cmplte"
		cSQL0=cSQL0+", (CASE MONTH(SaleDate)"
		cSQL0=cSQL0+" WHEN 1 THEN 'Jan' WHEN 2 THEN 'Feb' WHEN 3 THEN 'Mar' WHEN 4 THEN 'Apr'"
		cSQL0=cSQL0+" WHEN 5 THEN 'May' WHEN 6 THEN 'Jun' WHEN 7 THEN 'Jul' WHEN 8 THEN 'Aug'"
		cSQL0=cSQL0+" WHEN 9 THEN 'Sep' WHEN 10 THEN 'Oct' WHEN 11 THEN 'Nov' WHEN 12 THEN 'Dec' END"
		cSQL0=cSQL0+" )AS [Month]"
		cSQL0=cSQL0+" FROM dbo.Allquotes"
		cSQL0=cSQL0+" WHERE Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQL0=cSQL0+" AND AllQuotes.SalesNum > 0"
		cSQL0=cSQL0+") AS ShipmentByMonth"
		cSQL0=cSQL0+" PIVOT( SUM([cmplte]) FOR [Month] IN"
		cSQL0=cSQL0+"([Jan],[Feb],[Mar],[Apr],[May],[Jun],"
		cSQL0=cSQL0+"[Jul],[Aug],[Sep],[Oct],[Nov],[Dec])"
		cSQL0=cSQL0+") AS Total_Shipments"
		cSQL0=cSQL0+" ORDER BY [Year] DESC"
		
		*No Process
		cSQL1 = "SELECT [Year],[Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],[Jl1],[Au1],[Se1],[Oc1],[No1],[De1]"
		cSQL1=cSQL1+" FROM ("
		cSQL1=cSQL1+" SELECT YEAR(SaleDate) AS [Year]"
		cSQL1=cSQL1+", (CASE "
		cSQL1=cSQL1+" 	WHEN ISNULL(GFM,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(roll,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(Press,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(Mach,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(CG,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	WHEN ISNULL(Plasma,0) = 1 THEN 0"
		cSQL1=cSQL1+" 	ELSE 1 END) AS [NoProcess]"
		cSQL1=cSQL1+" , (CASE MONTH(SaleDate)"
		cSQL1=cSQL1+" WHEN 1 THEN 'Ja1' WHEN 2 THEN 'Fe1' WHEN 3 THEN 'Mr1' WHEN 4 THEN 'Ap1'"
		cSQL1=cSQL1+" WHEN 5 THEN 'My1' WHEN 6 THEN 'Jn1' WHEN 7 THEN 'Jl1' WHEN 8 THEN 'Au1'"
		cSQL1=cSQL1+" WHEN 9 THEN 'Se1' WHEN 10 THEN 'Oc1' WHEN 11 THEN 'No1' WHEN 12 THEN 'De1' END"
		cSQL1=cSQL1+"  )AS [MonthGood]"
		cSQL1=cSQL1+" FROM dbo.AllQuotes, dbo.Sales"
		cSQL1=cSQL1+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQL1=cSQL1+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQL1=cSQL1+" AND ISNULL(Cncld,0) < 1"
		cSQL1=cSQL1+" ) AS salesByMonth"
		cSQL1=cSQL1+" PIVOT( SUM([NoProcess]) FOR [MonthGood] IN"
		cSQL1=cSQL1+" ([Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],"
		cSQL1=cSQL1+" [Jl1],[Au1],[Se1],[Oc1],[No1],[De1])"
		cSQL1=cSQL1+" ) AS Shipments_NoProcess "
		cSQL1=cSQL1+" ORDER BY [Year] DESC"
		
		
		cSQL2 = "SELECT [Year],[Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],[Jl2],[Au2],[Se2],[Oc2],[No2],[De2]"
		cSQL2=cSQL2+" FROM ("
		cSQL2=cSQL2+" SELECT YEAR(SaleDate) AS [Year]"
		cSQL2=cSQL2+" , (CASE WHEN ISNULL(GFM,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL2=cSQL2+" , (CASE MONTH(SaleDate)"
		cSQL2=cSQL2+" WHEN 1 THEN 'Ja2' WHEN 2 THEN 'Fe2' WHEN 3 THEN 'Mr2'"
		cSQL2=cSQL2+" WHEN 4 THEN 'Ap2' WHEN 5 THEN 'My2' WHEN 6 THEN 'Jn2'"
		cSQL2=cSQL2+" WHEN 7 THEN 'Jl2' WHEN 8 THEN 'Au2' WHEN 9 THEN 'Se2'"
		cSQL2=cSQL2+" WHEN 10 THEN 'Oc2' WHEN 11 THEN 'No2' WHEN 12 THEN 'De2' END"
		cSQL2=cSQL2+"  )AS [Monthwith5]"
		cSQL2=cSQL2+" FROM dbo.AllQuotes, dbo.Sales"
		cSQL2=cSQL2+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQL2=cSQL2+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQL2=cSQL2+" AND ISNULL(Cncld,0) < 1"
		cSQL2=cSQL2+" ) AS salesByMonth"
		cSQL2=cSQL2+" PIVOT( "
		cSQL2=cSQL2+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL2=cSQL2+" ([Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],"
		cSQL2=cSQL2+" [Jl2],[Au2],[Se2],[Oc2],[No2],[De2])"
		cSQL2=cSQL2+" ) AS Within2Days"
		cSQL2=cSQL2+" ORDER BY [Year] DESC"
		 
		*GFM Process
		cSQLGFM = "SELECT [Year],[JaGFM],[FeGFM],[MrGFM],[ApGFM],[MyGFM],[JnGFM],[JlGFM],[AuGFM],[SeGFM],[OcGFM],[NoGFM],[DeGFM]"
		cSQLGFM=cSQLGFM+" FROM ( "
		cSQLGFM=cSQLGFM+"  SELECT YEAR(SaleDate) AS [Year]"
		cSQLGFM=cSQLGFM+" ,ItemSale "
		cSQLGFM=cSQLGFM+" , (CASE MONTH(SaleDate)"
		cSQLGFM=cSQLGFM+" WHEN 1 THEN 'JaGFM' WHEN 2 THEN 'FeGFM' WHEN 3 THEN 'MrGFM'"
		cSQLGFM=cSQLGFM+" WHEN 4 THEN 'ApGFM' WHEN 5 THEN 'MyGFM' WHEN 6 THEN 'JnGFM'"
		cSQLGFM=cSQLGFM+" WHEN 7 THEN 'JlGFM' WHEN 8 THEN 'AuGFM' WHEN 9 THEN 'SeGFM'"
		cSQLGFM=cSQLGFM+" WHEN 10 THEN 'OcGFM' WHEN 11 THEN 'NoGFM' WHEN 12 THEN 'DeGFM' END "
		cSQLGFM=cSQLGFM+"  )AS [MonthwithG]"
		cSQLGFM=cSQLGFM+" FROM dbo.AllQuotes, dbo.Sales"
		cSQLGFM=cSQLGFM+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQLGFM=cSQLGFM+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQLGFM=cSQLGFM+" AND ISNULL(Cncld,0) < 1"
		cSQLGFM=cSQLGFM+" AND ISNULL(GFM,0) = 1"
		cSQLGFM=cSQLGFM+" ) AS salesByMonth"
		cSQLGFM=cSQLGFM+" PIVOT( "
		cSQLGFM=cSQLGFM+" SUM([ItemSale]) FOR [MonthwithG] IN"
		cSQLGFM=cSQLGFM+" ([JaGFM],[FeGFM],[MrGFM],[ApGFM],[MyGFM],[JnGFM],"
		cSQLGFM=cSQLGFM+" [JlGFM],[AuGFM],[SeGFM],[OcGFM],[NoGFM],[DeGFM])"
		cSQLGFM=cSQLGFM+" ) AS GFMSales "
		cSQLGFM=cSQLGFM+" ORDER BY [Year] DESC "
		
		
		
		cSQL3 = "SELECT [Year],[Ja3],[Fe3],[Mr3],[Ap3],[My3],[Jn3],[Jl3],[Au3],[Se3],[Oc3],[No3],[De3]"
		cSQL3=cSQL3+" FROM ("
		cSQL3=cSQL3+" SELECT YEAR(SaleDate) AS [Year]"
		cSQL3=cSQL3+" , (CASE WHEN ISNULL(Roll,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL3=cSQL3+" , (CASE MONTH(SaleDate)"
		cSQL3=cSQL3+" WHEN 1 THEN 'Ja3' WHEN 2 THEN 'Fe3' WHEN 3 THEN 'Mr3'"
		cSQL3=cSQL3+" WHEN 4 THEN 'Ap3' WHEN 5 THEN 'My3' WHEN 6 THEN 'Jn3'"
		cSQL3=cSQL3+" WHEN 7 THEN 'Jl3' WHEN 8 THEN 'Au3' WHEN 9 THEN 'Se3'"
		cSQL3=cSQL3+" WHEN 10 THEN 'Oc3' WHEN 11 THEN 'No3' WHEN 12 THEN 'De3' END"
		cSQL3=cSQL3+"  )AS [Monthwith5]"
		cSQL3=cSQL3+" FROM dbo.AllQuotes, dbo.Sales"
		cSQL3=cSQL3+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQL3=cSQL3+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQL3=cSQL3+"  AND ISNULL(Cncld,0) < 1"
		cSQL3=cSQL3+" ) AS salesByMonth"
		cSQL3=cSQL3+" PIVOT( "
		cSQL3=cSQL3+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL3=cSQL3+" ([Ja3],[Fe3],[Mr3],[Ap3],[My3],[Jn3],"
		cSQL3=cSQL3+" [Jl3],[Au3],[Se3],[Oc3],[No3],[De3])"
		cSQL3=cSQL3+" ) AS Within2Days"
		cSQL3=cSQL3+" ORDER BY [Year] DESC"
		
		
		
		 
		cSQLROLL = "SELECT [Year],[JaRl],[FeRl],[MrRl],[ApRl],[MyRl],[JnRl],[JlRl],[AuRl],[SeRl],[OcRl],[NoRl],[DeRl]"
		cSQLROLL=cSQLROLL+" FROM ( "
		cSQLROLL=cSQLROLL+"  SELECT YEAR(SaleDate) AS [Year]"
		cSQLROLL=cSQLROLL+" ,ItemSale "
		cSQLROLL=cSQLROLL+" , (CASE MONTH(SaleDate)"
		cSQLROLL=cSQLROLL+" WHEN 1 THEN 'JaRl' WHEN 2 THEN 'FeRl' WHEN 3 THEN 'MrRl'"
		cSQLROLL=cSQLROLL+" WHEN 4 THEN 'ApRl' WHEN 5 THEN 'MyRl' WHEN 6 THEN 'JnRl'"
		cSQLROLL=cSQLROLL+" WHEN 7 THEN 'JlRl' WHEN 8 THEN 'AuRl' WHEN 9 THEN 'SeRl'"
		cSQLROLL=cSQLROLL+" WHEN 10 THEN 'OcRl' WHEN 11 THEN 'NoRl' WHEN 12 THEN 'DeRl' END "
		cSQLROLL=cSQLROLL+"  )AS [MonthwithR]"
		cSQLROLL=cSQLROLL+" FROM dbo.AllQuotes, dbo.Sales"
		cSQLROLL=cSQLROLL+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQLROLL=cSQLROLL+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQLROLL=cSQLROLL+" AND ISNULL(Cncld,0) < 1"
		cSQLROLL=cSQLROLL+" AND ISNULL(ROLL,0) = 1"
		cSQLROLL=cSQLROLL+" ) AS salesByMonth"
		cSQLROLL=cSQLROLL+" PIVOT( "
		cSQLROLL=cSQLROLL+" SUM([ItemSale]) FOR [MonthwithR] IN"
		cSQLROLL=cSQLROLL+" ([JaRl],[FeRl],[MrRl],[ApRl],[MyRl],[JnRl],"
		cSQLROLL=cSQLROLL+" [JlRl],[AuRl],[SeRl],[OcRl],[NoRl],[DeRl])"
		cSQLROLL=cSQLROLL+" ) AS RollSales "
		cSQLROLL=cSQLROLL+" ORDER BY [Year] DESC "
		
		
		cSQL4 = "SELECT [Year],[Ja4],[Fe4],[Mr4],[Ap4],[My4],[Jn4],[Jl4],[Au4],[Se4],[Oc4],[No4],[De4]"
		cSQL4=cSQL4+" FROM ("
		cSQL4=cSQL4+" SELECT YEAR(SaleDate) AS [Year]"
		cSQL4=cSQL4+" , (CASE WHEN ISNULL(Press,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL4=cSQL4+" , (CASE MONTH(SaleDate)"
		cSQL4=cSQL4+" WHEN 1 THEN 'Ja4' WHEN 2 THEN 'Fe4' WHEN 3 THEN 'Mr4'"
		cSQL4=cSQL4+" WHEN 4 THEN 'Ap4' WHEN 5 THEN 'My4' WHEN 6 THEN 'Jn4'"
		cSQL4=cSQL4+" WHEN 7 THEN 'Jl4' WHEN 8 THEN 'Au4' WHEN 9 THEN 'Se4'"
		cSQL4=cSQL4+" WHEN 10 THEN 'Oc4' WHEN 11 THEN 'No4' WHEN 12 THEN 'De4' END"
		cSQL4=cSQL4+"  )AS [Monthwith5]"
		cSQL4=cSQL4+" FROM dbo.AllQuotes, dbo.Sales"
		cSQL4=cSQL4+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQL4=cSQL4+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQL4=cSQL4+" AND ISNULL(Cncld,0) < 1"
		cSQL4=cSQL4+" ) AS salesByMonth"
		cSQL4=cSQL4+" PIVOT( "
		cSQL4=cSQL4+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL4=cSQL4+" ([Ja4],[Fe4],[Mr4],[Ap4],[My4],[Jn4],"
		cSQL4=cSQL4+" [Jl4],[Au4],[Se4],[Oc4],[No4],[De4])"
		cSQL4=cSQL4+" ) AS Within2Days"
		cSQL4=cSQL4+" ORDER BY [Year] DESC"
		
		
		
		cSQLPress = "SELECT [Year],[JaPs],[FePs],[MrPs],[ApPs],[MyPs],[JnPs],[JlPs],[AuPs],[SePs],[OcPs],[NoPs],[DePs]"
		cSQLPress=cSQLPress+" FROM ( "
		cSQLPress=cSQLPress+"  SELECT YEAR(SaleDate) AS [Year]"
		cSQLPress=cSQLPress+" ,ItemSale "
		cSQLPress=cSQLPress+" , (CASE MONTH(SaleDate)"
		cSQLPress=cSQLPress+" WHEN 1 THEN 'JaPs' WHEN 2 THEN 'FePs' WHEN 3 THEN 'MrPs'"
		cSQLPress=cSQLPress+" WHEN 4 THEN 'ApPs' WHEN 5 THEN 'MyPs' WHEN 6 THEN 'JnPs'"
		cSQLPress=cSQLPress+" WHEN 7 THEN 'JlPs' WHEN 8 THEN 'AuPs' WHEN 9 THEN 'SePs'"
		cSQLPress=cSQLPress+" WHEN 10 THEN 'OcPs' WHEN 11 THEN 'NoPs' WHEN 12 THEN 'DePs' END "
		cSQLPress=cSQLPress+"  )AS [MonthwithP]"
		cSQLPress=cSQLPress+" FROM dbo.AllQuotes, dbo.Sales"
		cSQLPress=cSQLPress+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQLPress=cSQLPress+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQLPress=cSQLPress+" AND ISNULL(Cncld,0) < 1"
		cSQLPress=cSQLPress+" AND ISNULL(PRESS,0) = 1"
		cSQLPress=cSQLPress+" ) AS salesByMonth"
		cSQLPress=cSQLPress+" PIVOT( "
		cSQLPress=cSQLPress+" SUM([ItemSale]) FOR [MonthwithP] IN"
		cSQLPress=cSQLPress+" ([JaPs],[FePs],[MrPs],[ApPs],[MyPs],[JnPs],"
		cSQLPress=cSQLPress+" [JlPs],[AuPs],[SePs],[OcPs],[NoPs],[DePs])"
		cSQLPress=cSQLPress+" ) AS PressSales "
		cSQLPress=cSQLPress+" ORDER BY [Year] DESC "
		
		
		 
		cSQL5 = "SELECT [Year],[Ja5],[Fe5],[Mr5],[Ap5],[My5],[Jn5],[Jl5],[Au5],[Se5],[Oc5],[No5],[De5]"
		cSQL5=cSQL5+" FROM ("
		cSQL5=cSQL5+" SELECT YEAR(SaleDate) AS [Year]"
		cSQL5=cSQL5+" , (CASE WHEN ISNULL(Mach,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL5=cSQL5+" , (CASE MONTH(SaleDate)"
		cSQL5=cSQL5+" WHEN 1 THEN 'Ja5' WHEN 2 THEN 'Fe5' WHEN 3 THEN 'Mr5'"
		cSQL5=cSQL5+" WHEN 4 THEN 'Ap5' WHEN 5 THEN 'My5' WHEN 6 THEN 'Jn5'"
		cSQL5=cSQL5+" WHEN 7 THEN 'Jl5' WHEN 8 THEN 'Au5' WHEN 9 THEN 'Se5'"
		cSQL5=cSQL5+" WHEN 10 THEN 'Oc5' WHEN 11 THEN 'No5' WHEN 12 THEN 'De5' END"
		cSQL5=cSQL5+"  )AS [Monthwith5]"
		cSQL5=cSQL5+" FROM dbo.AllQuotes, dbo.Sales"
		cSQL5=cSQL5+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQL5=cSQL5+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQL5=cSQL5+" AND ISNULL(Cncld,0) < 1"
		cSQL5=cSQL5+" ) AS salesByMonth"
		cSQL5=cSQL5+" PIVOT( "
		cSQL5=cSQL5+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL5=cSQL5+" ([Ja5],[Fe5],[Mr5],[Ap5],[My5],[Jn5],"
		cSQL5=cSQL5+" [Jl5],[Au5],[Se5],[Oc5],[No5],[De5])"
		cSQL5=cSQL5+" ) AS Within2Days"
		cSQL5=cSQL5+" ORDER BY [Year] DESC"
		
		
		 
		cSQL6 = "SELECT [Year],[Ja6],[Fe6],[Mr6],[Ap6],[My6],[Jn6],[Jl6],[Au6],[Se6],[Oc6],[No6],[De6]"
		cSQL6=cSQL6+" FROM ("
		cSQL6=cSQL6+" SELECT YEAR(SaleDate) AS [Year]"
		cSQL6=cSQL6+" , (CASE WHEN ISNULL(CG,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL6=cSQL6+" , (CASE MONTH(SaleDate)"
		cSQL6=cSQL6+" WHEN 1 THEN 'Ja6' WHEN 2 THEN 'Fe6' WHEN 3 THEN 'Mr6'"
		cSQL6=cSQL6+" WHEN 4 THEN 'Ap6' WHEN 5 THEN 'My6' WHEN 6 THEN 'Jn6'"
		cSQL6=cSQL6+" WHEN 7 THEN 'Jl6' WHEN 8 THEN 'Au6' WHEN 9 THEN 'Se6'"
		cSQL6=cSQL6+" WHEN 10 THEN 'Oc6' WHEN 11 THEN 'No6' WHEN 12 THEN 'De6' END"
		cSQL6=cSQL6+"  )AS [Monthwith5]"
		cSQL6=cSQL6+" FROM dbo.AllQuotes, dbo.Sales"
		cSQL6=cSQL6+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQL6=cSQL6+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQL6=cSQL6+" AND ISNULL(Cncld,0) < 1"
		cSQL6=cSQL6+" ) AS salesByMonth"
		cSQL6=cSQL6+" PIVOT( "
		cSQL6=cSQL6+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL6=cSQL6+" ([Ja6],[Fe6],[Mr6],[Ap6],[My6],[Jn6],"
		cSQL6=cSQL6+" [Jl6],[Au6],[Se6],[Oc6],[No6],[De6])"
		cSQL6=cSQL6+" ) AS Within6Days"
		cSQL6=cSQL6+" ORDER BY [Year] DESC"
		
		
		cSQL7 = "SELECT [Year],[Ja7],[Fe7],[Mr7],[Ap7],[My7],[Jn7],[Jl7],[Au7],[Se7],[Oc7],[No7],[De7]"
		cSQL7=cSQL7+" FROM ("
		cSQL7=cSQL7+" SELECT YEAR(SaleDate) AS [Year]"
		cSQL7=cSQL7+" , (CASE WHEN ISNULL(Plasma,0) = 1 THEN 1 ELSE 0 END ) AS [Good]"
		cSQL7=cSQL7+" , (CASE MONTH(SaleDate)"
		cSQL7=cSQL7+" WHEN 1 THEN 'Ja7' WHEN 2 THEN 'Fe7' WHEN 3 THEN 'Mr7'"
		cSQL7=cSQL7+" WHEN 4 THEN 'Ap7' WHEN 5 THEN 'My7' WHEN 6 THEN 'Jn7'"
		cSQL7=cSQL7+" WHEN 7 THEN 'Jl7' WHEN 8 THEN 'Au7' WHEN 9 THEN 'Se7'"
		cSQL7=cSQL7+" WHEN 10 THEN 'Oc7' WHEN 11 THEN 'No7' WHEN 12 THEN 'De7' END"
		cSQL7=cSQL7+"  )AS [Monthwith5]"
		cSQL7=cSQL7+" FROM dbo.AllQuotes, dbo.Sales"
		cSQL7=cSQL7+" WHERE AllQuotes.SOitem = Sales.SOitem"
		cSQL7=cSQL7+" AND Year(SaleDate) > YEAR(GETDATE()-730)"
		cSQL7=cSQL7+" AND ISNULL(Cncld,0) < 1"
		cSQL7=cSQL7+" ) AS salesByMonth"
		cSQL7=cSQL7+" PIVOT( "
		cSQL7=cSQL7+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL7=cSQL7+" ([Ja7],[Fe7],[Mr7],[Ap7],[My7],[Jn7],"
		cSQL7=cSQL7+" [Jl7],[Au7],[Se7],[Oc7],[No7],[De7])"
		cSQL7=cSQL7+" ) AS Within2Days"
		cSQL7=cSQL7+" ORDER BY [Year] DESC"
		
		
		
		
		
		 
		*cSQL0 Shipments Total
		IF USED('tmpShipmentsTotal')
			USE IN tmpShipmentsTotal
		ENDIF
		*cSQL1 No Process 
		IF USED('tmpShipmentsNoProcess')
			USE IN tmpShipmentsNoProcess
		ENDIF
		*cSQL2 GFM
		IF USED('tmpShipmentsGFM')
			USE IN tmpShipmentsGFM
		ENDIF
		*cSQL3 Roll
		IF USED('tmpShipmentsRoll')
			USE IN tmpShipmentsRoll
		ENDIF
		*cSQL4 Press
		IF USED('tmpShipmentsPress')
			USE IN tmpShipmentsPress
		ENDIF
		*cSQL5 Mach
		IF USED('tmpShipmentsMach')
			USE IN tmpShipmentsMach
		ENDIF
		*cSQL6 CG
		IF USED('tmpShipmentsCG')
			USE IN tmpShipmentsCG
		ENDIF
		*cSQL7 Plasma
		IF USED('tmpShipmentsPlasma')
			USE IN tmpShipmentsPlasma
		ENDIF
		
		SELECT 0
		PRIVATE nSQLEXEC, lGood
		lGood = .T.
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL0, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsTotal')
		ENDIF
		IF !USED('tmpShipmentsTotal')
			lGood = .F.
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsNoProcess')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsNoProcess')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL1, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsNoProcess')
		ENDIF
		IF !USED('tmpShipmentsNoProcess')
			lGood = .F.
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsGFM')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsGFM')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL2, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsGFM')
		ENDIF
		IF !USED('tmpShipmentsGFM')
			lGood = .F.
		ENDIF
		
		*cSQLGFM
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLGFM, 'tmpGFMSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLGFM, 'tmpGFMSales')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQLGFM, ThisForm.nConnHandle, nSQLEXEC, 'tmpGFMSales')
		ENDIF
		IF !USED('tmpGFMSales')
			lGood = .F.
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL3, 'tmpShipmentsRoll')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL3, 'tmpShipmentsRoll')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL3, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsRoll')
		ENDIF
		IF !USED('tmpShipmentsRoll')
			lGood = .F.
		ENDIF
		
		*cSQLROLL
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLROLL, 'tmpRollSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLROLL, 'tmpRollSales')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQLGFM, ThisForm.nConnHandle, cSQLROLL, 'tmpRollSales')
		ENDIF
		IF !USED('tmpRollSales')
			lGood = .F.
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL4, 'tmpShipmentsPress')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL4, 'tmpShipmentsPress')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL4, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsPress')
		ENDIF
		IF !USED('tmpShipmentsPress')
			lGood = .F.
		ENDIF
		
		*cSQLPress
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLPress, 'tmpPressSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLPress, 'tmpPressSales')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQLGFM, ThisForm.nConnHandle, cSQLPress, 'tmpPressSales')
		ENDIF
		IF !USED('tmpPressSales')
			lGood = .F.
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL5, 'tmpShipmentsMach')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL5, 'tmpShipmentsMach')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL5, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsMach')
		ENDIF
		IF !USED('tmpShipmentsMach')
			lGood = .F.
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL6, 'tmpShipmentsCG')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL6, 'tmpShipmentsCG')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL6, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsCG')
		ENDIF
		IF !USED('tmpShipmentsCG')
			lGood = .F.
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL7, 'tmpShipmentsPlasma')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL7, 'tmpShipmentsPlasma')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL7, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsPlasma')
		ENDIF
		IF !USED('tmpShipmentsPlasma')
			lGood = .F.
		ENDIF
		
		*tmpShipmentsTotal
		*tmpShipmentsNoProcess
		*tmpShipmentsGFM
		*tmpShipmentsRoll
		*tmpShipmentsPress
		*tmpShipmentsMach
		*tmpShipmentsCG
		*tmpShipmentsPlasma
		
		IF USED('tmpSalesProcess')
			USE IN tmpSalesProcess
		ENDIF
		
		IF lGood
			SELECT T.Year,Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec;
				,Ja1,Fe1,Mr1,Ap1,My1,Jn1,Jl1,Au1,Se1,Oc1,No1,De1;
				,Ja2,Fe2,Mr2,Ap2,My2,Jn2,Jl2,Au2,Se2,Oc2,No2,De2;
				,JaGFM,FeGFM,MrGFM,ApGFM,MyGFM,JnGFM,JlGFM,AuGFM,SeGFM,OcGFM,NoGFM,DeGFM;
				,Ja3,Fe3,Mr3,Ap3,My3,Jn3,Jl3,Au3,Se3,Oc3,No3,De3;
				,JaRl,FeRl,MrRl,ApRl,MyRl,JnRl,JlRl,AuRl,SeRl,OcRl,NoRl,DeRl;
				,Ja4,Fe4,Mr4,Ap4,My4,Jn4,Jl4,Au4,Se4,Oc4,No4,De4;
				,JaPs,FePs,MrPs,ApPs,MyPs,JnPs,JlPs,AuPs,SePs,OcPs,NoPs,DePs;
				,Ja5,Fe5,Mr5,Ap5,My5,Jn5,Jl5,Au5,Se5,Oc5,No5,De5;
				,Ja6,Fe6,Mr6,Ap6,My6,Jn6,Jl6,Au6,Se6,Oc6,No6,De6;
				,Ja7,Fe7,Mr7,Ap7,My7,Jn7,Jl7,Au7,Se7,Oc7,No7,De7;
			FROM tmpShipmentsTotal T, tmpShipmentsNoProcess NP, tmpShipmentsGFM GFM, tmpGFMSales GFMs;
				, tmpShipmentsRoll Rll, tmpROLLSales Rlls,	tmpShipmentsPress Press, tmpPressSales Presss;
				, tmpShipmentsMach Mach, tmpShipmentsCG CG, tmpShipmentsPlasma PLasma;
			WHERE T.Year = NP.Year AND T.Year = GFM.Year AND T.Year = GFM.Year AND T.Year = GFMs.Year ;
				AND T.Year = Rll.Year AND T.Year = Rlls.Year AND T.Year = Press.Year AND T.Year = Presss.Year;
				AND T.Year = Mach.Year AND T.Year = CG.Year AND T.Year = GFM.Year AND T.Year = PLasma.Year ;
			INTO CURSOR tmpSalesProcess
			*BROW
			
		*	REPORT FORM reports\r_shipments.frx PREVIEW
			
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getshipmentsdata		&& From cmdShowReport.Click
		*ThisForm.GetShipmentsData()
		
		PRIVATE cSQL0, cSQL1, cSQL5, cSQLlBs, cSQLrma
		
		*!*	cSQL0="SELECT [Year],[Jan],[Feb],[Mar],[Apr],[May],[Jun],[Jul],[Aug],[Sep],[Oct],[Nov],[Dec]"
		*!*	cSQL0=cSQL0+" FROM ( "
		*!*	cSQL0=cSQL0+" SELECT YEAR(ShipDue) AS [Year]"
		*!*	cSQL0=cSQL0+", CAST([cmplt] AS INT) AS Cmplte"
		*!*	cSQL0=cSQL0+", (CASE MONTH(ShipDue)"
		*!*	cSQL0=cSQL0+" WHEN 1 THEN 'Jan' WHEN 2 THEN 'Feb' WHEN 3 THEN 'Mar' WHEN 4 THEN 'Apr'"
		*!*	cSQL0=cSQL0+" WHEN 5 THEN 'May' WHEN 6 THEN 'Jun' WHEN 7 THEN 'Jul' WHEN 8 THEN 'Aug'"
		*!*	cSQL0=cSQL0+" WHEN 9 THEN 'Sep' WHEN 10 THEN 'Oct' WHEN 11 THEN 'Nov' WHEN 12 THEN 'Dec'"
		*!*	cSQL0=cSQL0+" END"
		*!*	cSQL0=cSQL0+" )AS [Month]"
		*!*	cSQL0=cSQL0+" FROM dbo.Sales"
		*!*	cSQL0=cSQL0+" WHERE ShipDue > '2002'"
		*!*	cSQL0=cSQL0+" AND Shipped > '2002' AND ISNULL(Cncld,0) < 1"
		*!*	cSQL0=cSQL0+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		*!*	cSQL0=cSQL0+") AS salesByMonth"
		*!*	cSQL0=cSQL0+" PIVOT( SUM([cmplte]) FOR [Month] IN"
		*!*	cSQL0=cSQL0+"([Jan],[Feb],[Mar],[Apr],[May],[Jun],"
		*!*	cSQL0=cSQL0+"[Jul],[Aug],[Sep],[Oct],[Nov],[Dec])"
		*!*	cSQL0=cSQL0+") AS Total_Shipments"
		*!*	cSQL0=cSQL0+" ORDER BY [Year] DESC"
		
		
		cSQL0="SELECT [Year],[Jan],[Feb],[Mar],[Apr],[May],[Jun],[Jul],[Aug],[Sep],[Oct],[Nov],[Dec]"
		cSQL0=cSQL0+" FROM ( "
		cSQL0=cSQL0+" SELECT YEAR(Shipped) AS [Year]"
		cSQL0=cSQL0+", CAST([cmplt] AS INT) AS Cmplte"
		cSQL0=cSQL0+", (CASE MONTH(Shipped)"
		cSQL0=cSQL0+" WHEN 1 THEN 'Jan' WHEN 2 THEN 'Feb' WHEN 3 THEN 'Mar' WHEN 4 THEN 'Apr'"
		cSQL0=cSQL0+" WHEN 5 THEN 'May' WHEN 6 THEN 'Jun' WHEN 7 THEN 'Jul' WHEN 8 THEN 'Aug'"
		cSQL0=cSQL0+" WHEN 9 THEN 'Sep' WHEN 10 THEN 'Oct' WHEN 11 THEN 'Nov' WHEN 12 THEN 'Dec'"
		cSQL0=cSQL0+" END"
		cSQL0=cSQL0+" )AS [Month]"
		cSQL0=cSQL0+" FROM dbo.Sales"
		cSQL0=cSQL0+" WHERE ShipDue > '2002'"
		cSQL0=cSQL0+" AND Shipped > '2002' AND ISNULL(Cncld,0) < 1"
		cSQL0=cSQL0+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL0=cSQL0+") AS salesByMonth"
		cSQL0=cSQL0+" PIVOT( SUM([cmplte]) FOR [Month] IN"
		cSQL0=cSQL0+"([Jan],[Feb],[Mar],[Apr],[May],[Jun],"
		cSQL0=cSQL0+"[Jul],[Aug],[Sep],[Oct],[Nov],[Dec])"
		cSQL0=cSQL0+") AS Total_Shipments"
		cSQL0=cSQL0+" ORDER BY [Year] DESC"
		
		
		*!*	cSQL1 = "SELECT [Year],[Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],[Jl1],[Au1],[Se1],[Oc1],[No1],[De1]"
		*!*	cSQL1=cSQL1+" FROM ("
		*!*	cSQL1=cSQL1+" SELECT YEAR(ShipDue) AS [Year]"
		*!*	cSQL1=cSQL1+", (CASE "
		*!*	cSQL1=cSQL1+" 	WHEN ([Shipped] <= [ShipDue] AND ISNULL(ShipOn,0) = 0) THEN 1"
		*!*	cSQL1=cSQL1+" 	WHEN ([Shipped] >= [ShipDue] AND ISNULL(ShipOn,0) = 1) THEN 1"
		*!*	cSQL1=cSQL1+" ELSE 0"
		*!*	cSQL1=cSQL1+" END) AS [Good]"
		*!*	cSQL1=cSQL1+" , (CASE MONTH(ShipDue)"
		*!*	cSQL1=cSQL1+" WHEN 1 THEN 'Ja1'"
		*!*	cSQL1=cSQL1+" WHEN 2 THEN 'Fe1'"
		*!*	cSQL1=cSQL1+" WHEN 3 THEN 'Mr1'"
		*!*	cSQL1=cSQL1+" WHEN 4 THEN 'Ap1'"
		*!*	cSQL1=cSQL1+" WHEN 5 THEN 'My1'"
		*!*	cSQL1=cSQL1+" WHEN 6 THEN 'Jn1'"
		*!*	cSQL1=cSQL1+" WHEN 7 THEN 'Jl1'"
		*!*	cSQL1=cSQL1+" WHEN 8 THEN 'Au1'"
		*!*	cSQL1=cSQL1+" WHEN 9 THEN 'Se1'"
		*!*	cSQL1=cSQL1+" WHEN 10 THEN 'Oc1'"
		*!*	cSQL1=cSQL1+" WHEN 11 THEN 'No1'"
		*!*	cSQL1=cSQL1+" WHEN 12 THEN 'De1'"
		*!*	cSQL1=cSQL1+" END"
		*!*	cSQL1=cSQL1+"  )AS [MonthGood]"
		*!*	cSQL1=cSQL1+" FROM dbo.Sales"
		*!*	cSQL1=cSQL1+" WHERE ShipDue > '2002'"
		*!*	cSQL1=cSQL1+" AND Shipped > '2002' AND ISNULL(Cncld,0) < 1 AND ISNULL(ShipOn,0) < 1"
		*!*	cSQL1=cSQL1+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		*!*	cSQL1=cSQL1+" ) AS salesByMonth"
		*!*	cSQL1=cSQL1+" PIVOT( SUM([Good]) FOR [MonthGood] IN"
		*!*	cSQL1=cSQL1+" ([Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],"
		*!*	cSQL1=cSQL1+" [Jl1],[Au1],[Se1],[Oc1],[No1],[De1])"
		*!*	cSQL1=cSQL1+" ) AS On_Time_Shipments "
		*!*	cSQL1=cSQL1+" ORDER BY [Year] DESC"
		
		cSQL1 = "SELECT [Year],[Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],[Jl1],[Au1],[Se1],[Oc1],[No1],[De1]"
		cSQL1=cSQL1+" FROM ("
		cSQL1=cSQL1+" SELECT YEAR(Shipped) AS [Year]"
		cSQL1=cSQL1+", (CASE "
		cSQL1=cSQL1+" 	WHEN ([Shipped] <= [ShipDue] AND ISNULL(ShipOn,0) = 0) THEN 1"
		cSQL1=cSQL1+" 	WHEN ([Shipped] >= [ShipDue] AND ISNULL(ShipOn,0) = 1) THEN 1"
		cSQL1=cSQL1+" ELSE 0"
		cSQL1=cSQL1+" END) AS [Good]"
		cSQL1=cSQL1+" , (CASE MONTH(Shipped)"
		cSQL1=cSQL1+" WHEN 1 THEN 'Ja1'"
		cSQL1=cSQL1+" WHEN 2 THEN 'Fe1'"
		cSQL1=cSQL1+" WHEN 3 THEN 'Mr1'"
		cSQL1=cSQL1+" WHEN 4 THEN 'Ap1'"
		cSQL1=cSQL1+" WHEN 5 THEN 'My1'"
		cSQL1=cSQL1+" WHEN 6 THEN 'Jn1'"
		cSQL1=cSQL1+" WHEN 7 THEN 'Jl1'"
		cSQL1=cSQL1+" WHEN 8 THEN 'Au1'"
		cSQL1=cSQL1+" WHEN 9 THEN 'Se1'"
		cSQL1=cSQL1+" WHEN 10 THEN 'Oc1'"
		cSQL1=cSQL1+" WHEN 11 THEN 'No1'"
		cSQL1=cSQL1+" WHEN 12 THEN 'De1'"
		cSQL1=cSQL1+" END"
		cSQL1=cSQL1+"  )AS [MonthGood]"
		cSQL1=cSQL1+" FROM dbo.Sales"
		cSQL1=cSQL1+" WHERE ShipDue > '2002'"
		cSQL1=cSQL1+" AND Shipped > '2002' AND ISNULL(Cncld,0) < 1 AND ISNULL(ShipOn,0) < 1"
		cSQL1=cSQL1+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL1=cSQL1+" ) AS salesByMonth"
		cSQL1=cSQL1+" PIVOT( SUM([Good]) FOR [MonthGood] IN"
		cSQL1=cSQL1+" ([Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],"
		cSQL1=cSQL1+" [Jl1],[Au1],[Se1],[Oc1],[No1],[De1])"
		cSQL1=cSQL1+" ) AS On_Time_Shipments "
		cSQL1=cSQL1+" ORDER BY [Year] DESC"
		
		
		*!*	cSQL2 = "SELECT [Year],[Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],[Jl2],[Au2],[Se2],[Oc2],[No2],[De2]"
		*!*	cSQL2=cSQL2+" FROM ("
		*!*	cSQL2=cSQL2+" SELECT YEAR(ShipDue) AS [Year]"
		*!*	cSQL2=cSQL2+" , (CASE "
		*!*	cSQL2=cSQL2+" 	WHEN ([Shipped] <= [ShipDue]+2 AND ISNULL(ShipOn,0) = 0) THEN 1"
		*!*	cSQL2=cSQL2+" 	WHEN ([Shipped] >= [ShipDue]-2 AND ISNULL(ShipOn,0) = 1) THEN 1"
		*!*	cSQL2=cSQL2+" 	ELSE 0"
		*!*	cSQL2=cSQL2+" 	END) AS [Good]"
		*!*	cSQL2=cSQL2+" , (CASE MONTH(ShipDue)"
		*!*	cSQL2=cSQL2+" WHEN 1 THEN 'Ja2'"
		*!*	cSQL2=cSQL2+" WHEN 2 THEN 'Fe2'"
		*!*	cSQL2=cSQL2+" WHEN 3 THEN 'Mr2'"
		*!*	cSQL2=cSQL2+" WHEN 4 THEN 'Ap2'"
		*!*	cSQL2=cSQL2+" WHEN 5 THEN 'My2'"
		*!*	cSQL2=cSQL2+" WHEN 6 THEN 'Jn2'"
		*!*	cSQL2=cSQL2+" WHEN 7 THEN 'Jl2'"
		*!*	cSQL2=cSQL2+" WHEN 8 THEN 'Au2'"
		*!*	cSQL2=cSQL2+" WHEN 9 THEN 'Se2'"
		*!*	cSQL2=cSQL2+" WHEN 10 THEN 'Oc2'"
		*!*	cSQL2=cSQL2+" WHEN 11 THEN 'No2'"
		*!*	cSQL2=cSQL2+" WHEN 12 THEN 'De2'"
		*!*	cSQL2=cSQL2+" END"
		*!*	cSQL2=cSQL2+"  )AS [Monthwith5]"
		*!*	cSQL2=cSQL2+" FROM dbo.Sales"
		*!*	cSQL2=cSQL2+" WHERE ShipDue > '2002'"
		*!*	cSQL2=cSQL2+" AND Shipped > '2002' AND ISNULL(Cncld,0) < 1 "
		*!*	cSQL2=cSQL2+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		*!*	cSQL2=cSQL2+" ) AS salesByMonth"
		*!*	cSQL2=cSQL2+" PIVOT( "
		*!*	cSQL2=cSQL2+" SUM([Good]) FOR [Monthwith5] IN"
		*!*	cSQL2=cSQL2+" ([Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],"
		*!*	cSQL2=cSQL2+" [Jl2],[Au2],[Se2],[Oc2],[No2],[De2])"
		*!*	cSQL2=cSQL2+" ) AS Within2Days"
		*!*	cSQL2=cSQL2+" ORDER BY [Year] DESC"
		
		cSQL2 = "SELECT [Year],[Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],[Jl2],[Au2],[Se2],[Oc2],[No2],[De2]"
		cSQL2=cSQL2+" FROM ("
		cSQL2=cSQL2+" SELECT YEAR(Shipped) AS [Year]"
		cSQL2=cSQL2+" , (CASE "
		cSQL2=cSQL2+" 	WHEN ([Shipped] <= [ShipDue]+2 AND ISNULL(ShipOn,0) = 0) THEN 1"
		cSQL2=cSQL2+" 	WHEN ([Shipped] >= [ShipDue]-2 AND ISNULL(ShipOn,0) = 1) THEN 1"
		cSQL2=cSQL2+" 	ELSE 0"
		cSQL2=cSQL2+" 	END) AS [Good]"
		cSQL2=cSQL2+" , (CASE MONTH(Shipped)"
		cSQL2=cSQL2+" WHEN 1 THEN 'Ja2'"
		cSQL2=cSQL2+" WHEN 2 THEN 'Fe2'"
		cSQL2=cSQL2+" WHEN 3 THEN 'Mr2'"
		cSQL2=cSQL2+" WHEN 4 THEN 'Ap2'"
		cSQL2=cSQL2+" WHEN 5 THEN 'My2'"
		cSQL2=cSQL2+" WHEN 6 THEN 'Jn2'"
		cSQL2=cSQL2+" WHEN 7 THEN 'Jl2'"
		cSQL2=cSQL2+" WHEN 8 THEN 'Au2'"
		cSQL2=cSQL2+" WHEN 9 THEN 'Se2'"
		cSQL2=cSQL2+" WHEN 10 THEN 'Oc2'"
		cSQL2=cSQL2+" WHEN 11 THEN 'No2'"
		cSQL2=cSQL2+" WHEN 12 THEN 'De2'"
		cSQL2=cSQL2+" END"
		cSQL2=cSQL2+"  )AS [Monthwith5]"
		cSQL2=cSQL2+" FROM dbo.Sales"
		cSQL2=cSQL2+" WHERE ShipDue > '2002'"
		cSQL2=cSQL2+" AND Shipped > '2002' AND ISNULL(Cncld,0) < 1 "
		cSQL2=cSQL2+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL2=cSQL2+" ) AS salesByMonth"
		cSQL2=cSQL2+" PIVOT( "
		cSQL2=cSQL2+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL2=cSQL2+" ([Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],"
		cSQL2=cSQL2+" [Jl2],[Au2],[Se2],[Oc2],[No2],[De2])"
		cSQL2=cSQL2+" ) AS Within2Days"
		cSQL2=cSQL2+" ORDER BY [Year] DESC"
		
		
		
		*!*	cSQL5 = "SELECT [Year],[Ja5],[Fe5],[Mr5],[Ap5],[My5],[Jn5],[Jl5],[Au5],[Se5],[Oc5],[No5],[De5]"
