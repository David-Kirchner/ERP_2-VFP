	PROCEDURE cmdExportShiptypeMonth.Click
		PRIVATE i, m.Typ
		
		FOR i = 1 TO 6
			DO CASE
			CASE i = 1
				m.Typ="I"
			CASE i = 2
				m.Typ="B"
			CASE i = 3
				m.Typ="M"
			CASE i = 4
				m.Typ="P"
			CASE i = 5
				m.Typ="S"
			CASE i = 6
				m.Typ = ""
			ENDCASE
			
			ThisForm.GetShipmentsTypeData(m.Typ)
		
			IF USED('tmpShipments')
				SELECT tmpShipments
				
				PRIVATE cMEM
				cMEM = IIF( "\MEM" $ SYS(2003),'','\MEM')
		
				EXPORT TO SYS(5)+SYS(2003)+cMEM+"\"+"HPA_ShipmentsTyp_"+m.Typ TYPE XLS
		
			*	MESSAGEBOX( "Open 'HPA_Shipments.xls' in Excel"+CHR(13)+"Look in your "+SYS(5)+SYS(2003)+"\ directory.",0+64,"Exported")
				
				LOCAL loExcel
				loExcel = CREATEOBJECT("Excel.Application")
				loExcel.workbooks.open(SYS(5)+SYS(2003)+cMEM+"\"+"HPA_ShipmentsTyp_"+m.Typ+".xls")
				loExcel.visible = .T.
		
			ENDIF
		
		
			IF USED('tmpShipments')
				USE IN tmpShipments
			ENDIF
		
			IF USED('tmpShipmentsTotal')
				USE IN tmpShipmentsTotal
			ENDIF
			IF USED('tmpShipmentsOnTime')
				USE IN tmpShipmentsOnTime
			ENDIF
			IF USED('tmpShipmentsWithin2Days')
				USE IN tmpShipmentsWithin2Days
			ENDIF
			IF USED('tmpShipmentsWithinWeek')
				USE IN tmpShipmentsWithinWeek
			ENDIF
			IF USED('tmpShipmentsRMA')
				USE IN tmpShipmentsRMA
			ENDIF
			
		ENDFOR
	ENDPROC

