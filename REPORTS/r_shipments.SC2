	PROCEDURE get3dayactiveordersdata
		*ThisForm.Get3DayActiveOrdersData()
		
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpActiveOrders')
			USE IN tmpActiveOrders
		ENDIF
		
		cSQL = "SELECT SoldAddr.Company, Sales_No.SalesRep, Sales.* , PN.Notes"
		cSQL = cSQL +" FROM dbo.Sales Sales "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.Sales_No Sales_No ON  Sales.Salesnum = Sales_No.Salesnum "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.SO_ProcessNotes PN ON PN.SOItem = Sales.SOitem "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.SoldAddr SoldAddr ON SoldAddr.SoldCode = Sales_No.pSoldAddr "
		cSQL = cSQL +" WHERE ISNULL(Sales.Cncld,0) < 1 AND ISNULL(Sales.Cmplt,0) < 1 "
		cSQL = cSQL +" AND ISNULL(Sales.ItemTot,0) > 0 "
		cSQL = cSQL +" AND SoldAddr.Company IS NOT NULL"
		cSQL = cSQL +" ORDER BY Sales.ProcLoc, Sales.ShipDue"
		*ProcLoc+DTOC(ShipDue,1)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpActiveOrders')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpActiveOrders')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpActiveOrders')
		ENDIF
		
		
		IF !USED('tmpActiveOrders')
			lGood = .F.
		ENDIF
		
		
		IF lGood
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getactiveordersdata
		*ThisForm.GetActiveOrdersData()
		
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpActiveOrders')
			USE IN tmpActiveOrders
		ENDIF
		
		cSQL = "SELECT SoldAddr.Company, Sales_No.SalesRep, Sales.* , PN.Notes"
		cSQL = cSQL +" FROM dbo.Sales Sales "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.Sales_No Sales_No ON  Sales.Salesnum = Sales_No.Salesnum "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.SO_ProcessNotes PN ON PN.SOItem = Sales.SOitem "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.SoldAddr SoldAddr ON SoldAddr.SoldCode = Sales_No.pSoldAddr "
		cSQL = cSQL +" WHERE ISNULL(Sales.Cncld,0) < 1 AND ISNULL(Sales.Cmplt,0) < 1 "
		cSQL = cSQL +" AND ISNULL(Sales.ItemTot,0) > 0 "
		cSQL = cSQL +" AND SoldAddr.Company IS NOT NULL"
		cSQL = cSQL +" ORDER BY Sales.ProcLoc, Sales.SOitem "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpActiveOrders')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpActiveOrders')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpActiveOrders')
		ENDIF
		
		
		IF !USED('tmpActiveOrders')
			*remove SO_ProcessNotes
			cSQL = "SELECT SoldAddr.Company, Sales_No.SalesRep, Sales.* , 'Notes' AS Notes"
			cSQL = cSQL +" FROM dbo.Sales Sales "
			cSQL = cSQL +" LEFT OUTER JOIN dbo.Sales_No Sales_No ON  Sales.Salesnum = Sales_No.Salesnum "
		*	cSQL = cSQL +" LEFT OUTER JOIN dbo.SO_ProcessNotes PN ON PN.SOItem = Sales.SOitem "
			cSQL = cSQL +" LEFT OUTER JOIN dbo.SoldAddr SoldAddr ON SoldAddr.SoldCode = Sales_No.pSoldAddr "
			cSQL = cSQL +" WHERE ISNULL(Sales.Cncld,0) < 1 AND ISNULL(Sales.Cmplt,0) < 1 "
			cSQL = cSQL +" AND ISNULL(Sales.ItemTot,0) > 0 "
			cSQL = cSQL +" ORDER BY Sales.ProcLoc, Sales.SOitem "
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpActiveOrders')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpActiveOrders')
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpActiveOrders')
			ENDIF
		ENDIF
		
		IF !USED('tmpActiveOrders')
			lGood = .F.
		ENDIF
		
		
		IF lGood
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getactivepodata
		*ThisForm.GetActivePOData()
		
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpActivePO')
			USE IN tmpActivePO
		ENDIF
		
		cSQL = " SELECT * FROM dbo.PurchaseOrder WHERE "
		cSQL = cSQL +" ISNULL(Delivered,0) = 0"
		cSQL = cSQL +" AND ISNULL(Cancelled,0) = 0"
		cSQL = cSQL +" AND ISNULL(Services,0) = 0"
		cSQL = cSQL +" ORDER BY DUE_Min"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpActivePO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpActivePO')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpActivePO')
		ENDIF
		
		IF !USED('tmpActivePO')
			lGood = .F.
		ENDIF
		
		
		IF lGood
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getgfmprocessbackup
		
		PRIVATE cSQL0, lGood, nSQLEXEC 
		lGood = .T.
		PRIVATE nMonth, nYear
		nMonth = MONTH(DATE())
		nYear = YEAR(DATE())
		IF nMonth = 1
			nYear = nYear - 1
			nMonth = 12
		ENDIF
		
		
		cSQL0=      " SELECT S.SOitem "
		cSQL0=cSQL0+" ,CONVERT(CHAR(10), S.ShipDue, 101) AS ShipDue "
		cSQL0=cSQL0+" ,CAST(S.Inv AS INT) AS Inv, CAST(S.GFM AS INT) AS GFM "
		cSQL0=cSQL0+" ,AQ.Alloy+' '+dbo.f_ItemDescription(AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Weight,AQ.RandLen) AS Descr_Sold "
		cSQL0=cSQL0+" ,ISNULL(CAST(PO.Delivered AS INT),0) AS PO_IN "
		cSQL0=cSQL0+" ,ISNULL(dbo.f_ItemDescription(PO.Form,PO.Thck,PO.Sz2,PO.Sz3,PO.Order_Qty,PO.RandLen),'') AS Descr_Buy "
		cSQL0=cSQL0+" ,S.OrderSpec,S.ItemCost,S.ItemSale,ISNULL(S.Urgent,0) AS 'Urgent',S.ShipOn "
		cSQL0=cSQL0+" FROM dbo.Sales S "
		cSQL0=cSQL0+" INNER JOIN dbo.AllQuotes AQ ON S.SOitem=AQ.SOitem "
		cSQL0=cSQL0+" LEFT OUTER JOIN dbo.PurchaseOrder PO ON S.SOitem=PO.SOitem "
		cSQL0=cSQL0+" WHERE ( ISNULL(S.GFM,0)>0 ) "
		cSQL0=cSQL0+" AND ISNULL(S.CNCLD,0)=0 AND ISNULL(S.CMPLT,0)=0 "
		cSQL0=cSQL0+" ORDER BY ISNULL(S.Urgent,0), S.ShipDue "
		
		IF USED('tmpGFMProcessBackup')
			USE IN tmpGFMProcessBackup
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpGFMProcessBackup')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpGFMProcessBackup')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL0, ThisForm.nConnHandle, nSQLEXEC, 'tmpGFMProcessBackup')
		ENDIF
		
		IF !USED('tmpGFMProcessBackup')
			lGood = .F.
		ENDIF
		
		IF lGood
			
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE gethouseprocessbackup
		*GetHouseProcessBackup
		
		PRIVATE cSQL0, lGood, nSQLEXEC 
		lGood = .T.
		PRIVATE nMonth, nYear
		nMonth = MONTH(DATE())
		nYear = YEAR(DATE())
		IF nMonth = 1
			nYear = nYear - 1
			nMonth = 12
		ENDIF
		
		
		cSQL0=      " SELECT SOitem,'Month "+ALLTRIM(STR(nMonth))+"' as 'Ship',CAST(Inv AS INT) AS Inv, CAST(GFM AS INT) AS GFM, CAST(Roll AS INT) AS Roll, CAST(Press AS INT) AS Press "
		cSQL0=cSQL0+" ,OrderSpec,ItemCost,ItemSale,ISNULL(Urgent,0) AS 'Urgent',ShipOn FROM dbo.Sales "
		cSQL0=cSQL0+" WHERE ( ISNULL(GFM,0)>0 or ISNULL(Roll,0)>0 OR ISNULL(Press,0)>0 ) "
		cSQL0=cSQL0+" AND ISNULL(CNCLD,0)=0 AND ISNULL(CMPLT,0)=1 AND Month(ShipDue) = "+STR(nMonth)+" AND YEAR(ShipDue) = "+STR(nYear)
		cSQL0=cSQL0+" UNION ALL "
		cSQL0=cSQL0+" SELECT SOitem,'All Due' as 'Ship',CAST(Inv AS INT) AS Inv, CAST(GFM AS INT) AS GFM, CAST(Roll AS INT) AS Roll, CAST(Press AS INT) AS Press "
		cSQL0=cSQL0+" ,OrderSpec,ItemCost,ItemSale,ISNULL(Urgent,0) AS 'Urgent',ShipOn FROM dbo.Sales "
		cSQL0=cSQL0+" WHERE ( ISNULL(GFM,0)>0 or ISNULL(Roll,0)>0 OR ISNULL(Press,0)>0 ) "
		cSQL0=cSQL0+" AND ISNULL(CNCLD,0)=0 AND ISNULL(CMPLT,0)=0 "
		*cSQL = cSQL +" AND SoldAddr.Company IS NOT NULL"
		
		IF USED('tmpHouseProcessBackup')
			USE IN tmpHouseProcessBackup
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpHouseProcessBackup')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpHouseProcessBackup')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL0, ThisForm.nConnHandle, nSQLEXEC, 'tmpHouseProcessBackup')
		ENDIF
		
		IF !USED('tmpHouseProcessBackup')
			lGood = .F.
		ENDIF
		
		IF lGood
			*BROW
			
		*	REPORT FORM reports\.frx PREVIEW
			
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE geths		&& Get HS Shipments per Alloy
		PARAMETERS pAlloy
		*ThisForm.GetHS()
		
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		
		IF USED('tmpHS')
			USE IN tmpHS
		ENDIF
		
		
		
		cSQL = "SELECT * "
		cSQL = cSQL + "	FROM dbo.AllQuotes AQ "
		cSQL = cSQL + "	,dbo.Sales S "
		cSQL = cSQL + "	WHERE ISNULL(AQ.cc,'1') != '1'"
		cSQL = cSQL + "	AND ISNULL(AQ.salesnum,0) > 0"
		cSQL = cSQL + "	AND AQ.po_num != 'Production'"
		cSQL = cSQL + "	AND LEFT(AQ.po_num,5) != 'Test '"
		cSQL = cSQL + "	AND AQ.po_num != 'Stock'"
		cSQL = cSQL + "	AND AQ.po_num != 'Research'"
		cSQL = cSQL + "	AND LEN(AQ.PO_Num) > 1"
		cSQL = cSQL + "	AND AQ.Alloy = '"+pAlloy+"'"
		cSQL = cSQL + "	AND AQ.soitem = S.SOitem "
		cSQL = cSQL + "	AND ISNULL(S.cncld,0) = 0 "
		cSQL = cSQL + "	ORDER BY S.Shipped DESC "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpHS')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpHS')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpHS')
		ENDIF
		
		
		
		
		IF !USED('tmpHS')
			lGood = .F.
		ENDIF
		
		
		IF lGood
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

