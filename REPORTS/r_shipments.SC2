		*tmpShipmentsPlasma
		
		IF lGood
			SELECT T.Year,Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec;
				,Ja1,Fe1,Mr1,Ap1,My1,Jn1,Jl1,Au1,Se1,Oc1,No1,De1;
				,Ja2,Fe2,Mr2,Ap2,My2,Jn2,Jl2,Au2,Se2,Oc2,No2,De2;
				,JaGFM,FeGFM,MrGFM,ApGFM,MyGFM,JnGFM,JlGFM,AuGFM,SeGFM,OcGFM,NoGFM,DeGFM;
				,Ja3,Fe3,Mr3,Ap3,My3,Jn3,Jl3,Au3,Se3,Oc3,No3,De3;
				,JaRl,FeRl,MrRl,ApRl,MyRl,JnRl,JlRl,AuRl,SeRl,OcRl,NoRl,DeRl;
				,Ja4,Fe4,Mr4,Ap4,My4,Jn4,Jl4,Au4,Se4,Oc4,No4,De4;
				,JaPs,FePs,MrPs,ApPs,MyPs,JnPs,JlPs,AuPs,SePs,OcPs,NoPs,DePs;
				,Ja5,Fe5,Mr5,Ap5,My5,Jn5,Jl5,Au5,Se5,Oc5,No5,De5;
				,Ja6,Fe6,Mr6,Ap6,My6,Jn6,Jl6,Au6,Se6,Oc6,No6,De6;
				,Ja7,Fe7,Mr7,Ap7,My7,Jn7,Jl7,Au7,Se7,Oc7,No7,De7;
			FROM tmpShipmentsTotal T, tmpShipmentsNoProcess NP, tmpShipmentsGFM GFM, tmpGFMSales GFMs;
				, tmpShipmentsRoll Rll, tmpROLLSales Rlls,	tmpShipmentsPress Press, tmpPressSales Presss;
				, tmpShipmentsMach Mach, tmpShipmentsCG CG, tmpShipmentsPlasma PLasma;
			WHERE T.Year = NP.Year AND T.Year = GFM.Year AND T.Year = GFM.Year AND T.Year = GFMs.Year ;
				AND T.Year = Rll.Year AND T.Year = Rlls.Year AND T.Year = Press.Year AND T.Year = Presss.Year;
				AND T.Year = Mach.Year AND T.Year = CG.Year AND T.Year = GFM.Year AND T.Year = PLasma.Year ;
			INTO CURSOR tmpProcessShipments
			*BROW
			
		*	REPORT FORM reports\r_shipments.frx PREVIEW
			
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getshipmentssalespdata
		*ThisForm.GetShipmentsData()
		
		PRIVATE cSQL0, cSQL1, cSQL5
		*Total_Shipments
		cSQL0="SELECT [Year],[Jan],[Feb],[Mar],[Apr],[May],[Jun],[Jul],[Aug],[Sep],[Oct],[Nov],[Dec],[SalesRep]"
		cSQL0=cSQL0+" FROM ( "
		cSQL0=cSQL0+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL0=cSQL0+", CAST([Sales].[cmplt] AS INT) AS [Cmplte]"
		cSQL0=cSQL0+", (CASE MONTH(ShipDue)"
		cSQL0=cSQL0+" WHEN 1 THEN 'Jan' WHEN 2 THEN 'Feb' WHEN 3 THEN 'Mar' WHEN 4 THEN 'Apr' WHEN 5 THEN 'May' WHEN 6 THEN 'Jun' WHEN 7 THEN 'Jul' WHEN 8 THEN 'Aug' WHEN 9 THEN 'Sep' WHEN 10 THEN 'Oct' WHEN 11 THEN 'Nov' WHEN 12 THEN 'Dec' END"
		cSQL0=cSQL0+" )AS [Month]"
		cSQL0=cSQL0+", ISNULL(Sales_No.SalesRep,' ') AS [SalesRep]"
		cSQL0=cSQL0+" FROM dbo.Sales, dbo.Sales_No"
		cSQL0=cSQL0+" WHERE ShipDue > '2002' AND Shipped > '2002' AND ISNULL(Sales.Cncld,0) < 1 AND Sales.SalesNum = Sales_No.SalesNum"
		cSQL0=cSQL0+" AND ShipDue < GETDATE() "
		cSQL0=cSQL0+") AS salesByMonth"
		cSQL0=cSQL0+" PIVOT( SUM([cmplte]) FOR [Month] IN"
		cSQL0=cSQL0+"([Jan],[Feb],[Mar],[Apr],[May],[Jun],"
		cSQL0=cSQL0+"[Jul],[Aug],[Sep],[Oct],[Nov],[Dec])"
		cSQL0=cSQL0+") AS Total_Shipments"
		cSQL0=cSQL0+" ORDER BY [Year] DESC"
		
		*BeforeDue
		cSQLb="SELECT [Year],[JaB],[FbB],[MrB],[ApB],[MyB],[JnB],[JlB],[AuB],[SeB],[OcB],[NoB],[DeB],[SalesRep]"
		cSQLb=cSQLb+" FROM ( "
		cSQLb=cSQLb+" SELECT YEAR(ShipDue) AS [Year]"
		cSQLb=cSQLb+", (CASE WHEN ([Shipped] < [ShipDue] AND ISNULL(ShipOn,0) = 0) THEN 1"
		cSQLb=cSQLb+" 	WHEN ([Shipped] > [ShipDue] AND ISNULL(ShipOn,0) = 1) THEN 1"
		cSQLb=cSQLb+" 	ELSE 0 END) AS [Good]"
		cSQLb=cSQLb+", (CASE MONTH(ShipDue)"
		cSQLb=cSQLb+" WHEN 1 THEN 'JaB' WHEN 2 THEN 'FbB' WHEN 3 THEN 'MrB' WHEN 4 THEN 'ApB' WHEN 5 THEN 'MyB' WHEN 6 THEN 'JnB' WHEN 7 THEN 'JlB' WHEN 8 THEN 'AuB' WHEN 9 THEN 'SeB' WHEN 10 THEN 'OcB' WHEN 11 THEN 'NoB' WHEN 12 THEN 'DeB' END )AS [Month]"
		cSQLb=cSQLb+", ISNULL(Sales_No.SalesRep,' ') AS [SalesRep]"
		cSQLb=cSQLb+" FROM dbo.Sales, dbo.Sales_No"
		cSQLb=cSQLb+" WHERE ShipDue > '2002' AND Shipped > '2002' AND ISNULL(Sales.Cncld,0) < 1 AND Sales.SalesNum = Sales_No.SalesNum"
		cSQLb=cSQLb+" AND ShipDue < GETDATE() "
		cSQLb=cSQLb+") AS salesByMonth"
		cSQLb=cSQLb+" PIVOT( SUM([Good]) FOR [Month] IN"
		cSQLb=cSQLb+"([JaB],[FbB],[MrB],[ApB],[MyB],[JnB],"
		cSQLb=cSQLb+"[JlB],[AuB],[SeB],[OcB],[NoB],[DeB])"
		cSQLb=cSQLb+") AS Total_Shipments"
		cSQLb=cSQLb+" ORDER BY [Year] DESC"
		
		*On_Time_Shipments
		cSQL1="SELECT [Year],[Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],[Jl1],[Au1],[Se1],[Oc1],[No1],[De1],[SalesRep]"
		cSQL1=cSQL1+" FROM ( "
		cSQL1=cSQL1+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL1=cSQL1+",(CASE WHEN ([Shipped] <= [ShipDue] AND ISNULL(ShipOn,0) = 0) THEN 1"
		cSQL1=cSQL1+" 	WHEN ([Shipped] >= [ShipDue] AND ISNULL(ShipOn,0) = 1) THEN 1 ELSE 0 END) AS [Good]"
		cSQL1=cSQL1+", (CASE MONTH(ShipDue)"
		cSQL1=cSQL1+" WHEN 1 THEN 'Ja1' WHEN 2 THEN 'Fe1' WHEN 3 THEN 'Mr1' WHEN 4 THEN 'Ap1' WHEN 5 THEN 'My1' WHEN 6 THEN 'Jn1' WHEN 7 THEN 'Jl1' WHEN 8 THEN 'Au1' WHEN 9 THEN 'Se1' WHEN 10 THEN 'Oc1' WHEN 11 THEN 'No1' WHEN 12 THEN 'De1' END )AS [Month]"
		cSQL1=cSQL1+", ISNULL(Sales_No.SalesRep,' ') AS [SalesRep]"
		cSQL1=cSQL1+" FROM dbo.Sales, dbo.Sales_No"
		cSQL1=cSQL1+" WHERE ShipDue > '2002' AND Shipped > '2002' AND ISNULL(Sales.Cncld,0) < 1 AND Sales.SalesNum = Sales_No.SalesNum"
		cSQL1=cSQL1+" AND ShipDue < GETDATE() "
		cSQL1=cSQL1+") AS salesByMonth"
		cSQL1=cSQL1+" PIVOT( SUM([Good]) FOR [Month] IN"
		cSQL1=cSQL1+"([Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],"
		cSQL1=cSQL1+"[Jl1],[Au1],[Se1],[Oc1],[No1],[De1])"
		cSQL1=cSQL1+") AS Total_Shipments"
		cSQL1=cSQL1+" ORDER BY [Year] DESC"
		
		
		*Within2Days
		cSQL2="SELECT [Year],[Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],[Jl2],[Au2],[Se2],[Oc2],[No2],[De2],[SalesRep]"
		cSQL2=cSQL2+" FROM ( "
		cSQL2=cSQL2+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL2=cSQL2+", (CASE WHEN ([Shipped] <= [ShipDue]+2 AND ISNULL(ShipOn,0) = 0) THEN 1"
		cSQL2=cSQL2+" 	WHEN ([Shipped] >= [ShipDue]-2 AND ISNULL(ShipOn,0) = 1) THEN 1"
		cSQL2=cSQL2+" 	ELSE 0 END) AS [Good]"
		cSQL2=cSQL2+", (CASE MONTH(ShipDue)"
		cSQL2=cSQL2+" WHEN 1 THEN 'Ja2' WHEN 2 THEN 'Fe2' WHEN 3 THEN 'Mr2' WHEN 4 THEN 'Ap2' WHEN 5 THEN 'My2' WHEN 6 THEN 'Jn2' WHEN 7 THEN 'Jl2' WHEN 8 THEN 'Au2' WHEN 9 THEN 'Se2' WHEN 10 THEN 'Oc2' WHEN 11 THEN 'No2' WHEN 12 THEN 'De2' END )AS [Month]"
		cSQL2=cSQL2+", ISNULL(Sales_No.SalesRep,' ') AS [SalesRep]"
		cSQL2=cSQL2+" FROM dbo.Sales, dbo.Sales_No"
		cSQL2=cSQL2+" WHERE ShipDue > '2002' AND Shipped > '2002' AND ISNULL(Sales.Cncld,0) < 1 AND Sales.SalesNum = Sales_No.SalesNum"
		cSQL2=cSQL2+" AND ShipDue < GETDATE() "
		cSQL2=cSQL2+") AS salesByMonth"
		cSQL2=cSQL2+" PIVOT( SUM([Good]) FOR [Month] IN"
		cSQL2=cSQL2+"([Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],"
		cSQL2=cSQL2+"[Jl2],[Au2],[Se2],[Oc2],[No2],[De2])"
		cSQL2=cSQL2+") AS Total_Shipments"
		cSQL2=cSQL2+" ORDER BY [Year] DESC"
		
		
		*WithinWeek
		cSQL7="SELECT [Year],[Ja7],[Fe7],[Mr7],[Ap7],[My7],[Jn7],[Jl7],[Au7],[Se7],[Oc7],[No7],[De7],[SalesRep]"
		cSQL7=cSQL7+" FROM ( "
		cSQL7=cSQL7+" SELECT YEAR(ShipDue) AS [Year]"
		cSQL7=cSQL7+", (CASE WHEN ([Shipped] <= [ShipDue]+7 AND ISNULL(ShipOn,0) = 0) THEN 1"
		cSQL7=cSQL7+" 	WHEN ([Shipped] >= [ShipDue]-7 AND ISNULL(ShipOn,0) = 1) THEN 1"
		cSQL7=cSQL7+" 	ELSE 0 END) AS [Good]"
		cSQL7=cSQL7+", (CASE MONTH(ShipDue)"
		cSQL7=cSQL7+" WHEN 1 THEN 'Ja7' WHEN 2 THEN 'Fe7' WHEN 3 THEN 'Mr7' WHEN 4 THEN 'Ap7' WHEN 5 THEN 'My7' WHEN 6 THEN 'Jn7' WHEN 7 THEN 'Jl7' WHEN 8 THEN 'Au7' WHEN 9 THEN 'Se7' WHEN 10 THEN 'Oc7' WHEN 11 THEN 'No7' WHEN 12 THEN 'De7' END )AS [Month]"
		cSQL7=cSQL7+", ISNULL(Sales_No.SalesRep,' ') AS [SalesRep]"
		cSQL7=cSQL7+" FROM dbo.Sales, dbo.Sales_No"
		cSQL7=cSQL7+" WHERE ShipDue > '2002' AND Shipped > '2002' AND ISNULL(Sales.Cncld,0) < 1 AND Sales.SalesNum = Sales_No.SalesNum"
		cSQL7=cSQL7+" AND ShipDue < GETDATE() "
		cSQL7=cSQL7+") AS salesByMonth"
		cSQL7=cSQL7+" PIVOT( SUM([Good]) FOR [Month] IN"
		cSQL7=cSQL7+"([Ja7],[Fe7],[Mr7],[Ap7],[My7],[Jn7],"
		cSQL7=cSQL7+"[Jl7],[Au7],[Se7],[Oc7],[No7],[De7])"
		cSQL7=cSQL7+") AS Total_Shipments"
		cSQL7=cSQL7+" ORDER BY [Year] DESC"
		
		
		
		IF USED('tmpShipments')
			USE IN tmpShipments
		ENDIF
		IF USED('tmpShipmentsTotal')
			USE IN tmpShipmentsTotal
		ENDIF
		IF USED('tmpShipmentsBefore')
			USE IN tmpShipmentsBefore
		ENDIF
		IF USED('tmpShipmentsOnTime')
			USE IN tmpShipmentsOnTime
		ENDIF
		IF USED('tmpShipmentsWithin2Days')
			USE IN tmpShipmentsWithin2Days
		ENDIF
		IF USED('tmpShipmentsWithinWeek')
			USE IN tmpShipmentsWithinWeek
		ENDIF
		
		
		SELECT 0
		PRIVATE nSQLEXEC, lGood
		lGood = .T.
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, "tmpShipmentsTotal")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, "tmpShipmentsTotal")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL0, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsTotal')
		ENDIF
		IF !USED('tmpShipmentsTotal')
			lGood = .F.
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLb, 'tmpShipmentsBefore')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLb, 'tmpShipmentsBefore')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLb, "tmpShipmentsBefore")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLb, "tmpShipmentsBefore")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQLb, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsBefore')
		ENDIF
		IF !USED('tmpShipmentsBefore')
			lGood = .F.
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsOnTime')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsOnTime')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLExecError(cSQL1, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsOnTime')
		ENDIF
		IF !USED('tmpShipmentsOnTime')
			lGood = .F.
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsWithin2Days')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsWithin2Days')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL2, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsWithin2Days')
		ENDIF
		IF !USED('tmpShipmentsWithin2Days')
			lGood = .F.
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL7, 'tmpShipmentsWithinWeek')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL7, 'tmpShipmentsWithinWeek')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL7, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsWithinWeek')
		ENDIF
		IF !USED('tmpShipmentsWithinWeek')
			lGood = .F.
		ENDIF
		
		
		IF lGood
			SELECT T.Year,t.SalesRep ;
				, NVL(Jan,000000) AS Jan, NVL(Feb,00000) AS Feb, NVL(Mar,00000) AS Mar, NVL(Apr,00000) AS Apr, NVL(May,00000) AS May, NVL(Jun,00000) AS Jun, NVL(Jul,00000) AS Jul, NVL(Aug,00000) AS Aug, NVL(Sep,00000) AS Sep, NVL(Oct,00000) AS Oct, NVL(Nov,00000) AS Nov, NVL(Dec,00000) AS Dec;
				, NVL(JaB,000000) AS JaB, NVL(FbB,00000) AS FbB, NVL(MrB,00000) AS MrB, NVL(ApB,00000) AS ApB, NVL(MyB,00000) AS MyB, NVL(JnB,00000) AS JnB, NVL(JlB,00000) AS JlB, NVL(AuB,00000) AS AuB, NVL(SeB,00000) AS SeB, NVL(OcB,00000) AS OcB, NVL(NoB,00000) AS NoB, NVL(DeB,00000) AS DeB;
				, NVL(Ja1,000000) AS Ja1, NVL(Fe1,00000) AS Fe1, NVL(Mr1,00000) AS Mr1, NVL(Ap1,00000) AS Ap1, NVL(My1,00000) AS My1, NVL(Jn1,00000) AS Jn1, NVL(Jl1,00000) AS Jl1, NVL(Au1,00000) AS Au1, NVL(Se1,00000) AS Se1, NVL(Oc1,00000) AS Oc1, NVL(No1,00000) AS No1, NVL(De1,00000) AS De1;
				, NVL(Ja2,000000) AS Ja2, NVL(Fe2,00000) AS Fe2, NVL(Mr2,00000) AS Mr2, NVL(Ap2,00000) AS Ap2, NVL(My2,00000) AS My2, NVL(Jn2,00000) AS Jn2, NVL(Jl2,00000) AS Jl2, NVL(Au2,00000) AS Au2, NVL(Se2,00000) AS Se2, NVL(Oc2,00000) AS Oc2, NVL(No2,00000) AS No2, NVL(De2,00000) AS De2;
				, NVL(Ja7,000000) AS Ja7, NVL(Fe7,00000) AS Fe7, NVL(Mr7,00000) AS Mr7, NVL(Ap7,00000) AS Ap7, NVL(My7,00000) AS My7, NVL(Jn7,00000) AS Jn7, NVL(Jl7,00000) AS Jl7, NVL(Au7,00000) AS Au7, NVL(Se7,00000) AS Se7, NVL(Oc7,00000) AS Oc7, NVL(No7,00000) AS No7, NVL(De7,00000) AS De7;
			FROM tmpShipmentsTotal T, tmpShipmentsBefore B, tmpShipmentsOnTime OT, tmpShipmentsWithin2Days W2D, ;
				tmpShipmentsWithinWeek WW;
			WHERE T.Year = B.Year AND B.Year = OT.Year AND OT.Year = W2D.Year AND W2D.Year = WW.Year ;
			AND T.SalesRep = B.SalesRep AND B.SalesRep = OT.SalesRep AND OT.SalesRep = W2D.SalesRep AND W2D.SalesRep = WW.SalesRep ;
			AND NOT EMPTY(T.SalesRep);
			AND T.Year+2 >= YEAR(DATE());
			ORDER BY T.SalesRep, T.Year DESC ; 
			INTO CURSOR tmpShipments
		
		
		*		, NVL(Jan,0) AS Jan, NVL(Feb,0) AS Feb, NVL(Mar,0) AS Mar, NVL(Apr,0) AS Apr, NVL(May,0) AS May, NVL(Jun,0) AS Jun, NVL(Jul,0) AS Jul, NVL(Aug,0) AS Aug, NVL(Sep,0) AS Sep, NVL(Oct,0) AS Oct, NVL(Nov,0) AS Nov, NVL(Dec,0) AS Dec;
		*		, NVL(Ja1,0) AS Ja1, NVL(Fe1,0) AS Fe1, NVL(Mr1,0) AS Mr1, NVL(Ap1,0) AS Ap1, NVL(My1,0) AS My1, NVL(Jn1,0) AS Jn1, NVL(Jl1,0) AS Jl1, NVL(Au1,0) AS Au1, NVL(Se1,0) AS Se1, NVL(Oc1,0) AS Oc1, NVL(No1,0) AS No1, NVL(De1,0) AS De1;
		*	, NVL(Ja2,0) AS Ja2, NVL(Fe2,0) AS Fe2, NVL(Mr2,0) AS Mr2, NVL(Ap2,0) AS Ap2, NVL(My2,0) AS My2, NVL(Jn2,0) AS Jn2, NVL(Jl2,0) AS Jl2, NVL(Au2,0) AS Au2, NVL(Se2,0) AS Se2, NVL(Oc2,0) AS Oc2, NVL(No2,0) AS No2, NVL(De2,0) AS De2;
		*		, NVL(Ja7,0) AS Ja7, NVL(Fe7,0) AS Fe7, NVL(Mr7,0) AS Mr7, NVL(Ap7,0) AS Ap7, NVL(My7,0) AS My7, NVL(Jn7,0) AS Jn7, NVL(Jl7,0) AS Jl7, NVL(Au7,0) AS Au7, NVL(Se7,0) AS Se7, NVL(Oc7,0) AS Oc7, NVL(No7,0) AS No7, NVL(De7,0) AS De7;
		*		,Ja1,Fe1,Mr1,Ap1,My1,Jn1,Jl1,Au1,Se1,Oc1,No1,De1;	
		*	,Ja2,Fe2,Mr2,Ap2,My2,Jn2,Jl2,Au2,Se2,Oc2,No2,De2;
		*	,Ja7,Fe7,Mr7,Ap7,My7,Jn7,Jl7,Au7,Se7,Oc7,No7,De7;
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getshipmentstypedata
		PARAMETERS pTyp
		
		*ThisForm.GetShipmentstypeData()
		*IIF(ISNULL(Typ),"UnKnown",IIF(Typ="I","Inventory",IIF(Typ="B","Broker",IIF(Typ="M","Mill",IIF(Typ="P","Production",IIF(Typ="S","Service",""))))))
		
		IF USED('tmpShipments')
			USE IN tmpShipments
		ENDIF
		IF USED('tmpShipmentsTotal')
			USE IN tmpShipmentsTotal
		ENDIF
		IF USED('tmpShipmentsOnTime')
			USE IN tmpShipmentsOnTime
		ENDIF
		IF USED('tmpShipmentsWithin2Days')
			USE IN tmpShipmentsWithin2Days
		ENDIF
		IF USED('tmpShipmentsWithinWeek')
			USE IN tmpShipmentsWithinWeek
		ENDIF
		IF USED('tmpShipmentsLBs')
			USE IN tmpShipmentsLBs
		ENDIF
		IF USED('tmpShipmentsRMA')
			USE IN tmpShipmentsRMA
		ENDIF
		
		PRIVATE cSQL0, cSQL1, cSQL5, cSQLlBs, cSQLrma
		
		
		SELECT 0
		PRIVATE nSQLEXEC, lGood
		lGood = .T.
		
		
		cSQL0="SELECT [Typ],[Year],[Jan],[Feb],[Mar],[Apr],[May],[Jun],[Jul],[Aug],[Sep],[Oct],[Nov],[Dec]"
		cSQL0=cSQL0+" FROM ( "
		cSQL0=cSQL0+" SELECT YEAR(Shipped) AS [Year]"
		cSQL0=cSQL0+", CAST([cmplt] AS INT) AS Cmplte"
		cSQL0=cSQL0+", [Typ]"
		cSQL0=cSQL0+", (CASE MONTH(Shipped)"
		cSQL0=cSQL0+" WHEN 1 THEN 'Jan' WHEN 2 THEN 'Feb' WHEN 3 THEN 'Mar' WHEN 4 THEN 'Apr'"
		cSQL0=cSQL0+" WHEN 5 THEN 'May' WHEN 6 THEN 'Jun' WHEN 7 THEN 'Jul' WHEN 8 THEN 'Aug'"
		cSQL0=cSQL0+" WHEN 9 THEN 'Sep' WHEN 10 THEN 'Oct' WHEN 11 THEN 'Nov' WHEN 12 THEN 'Dec'"
		cSQL0=cSQL0+" END"
		cSQL0=cSQL0+" )AS [Month]"
		cSQL0=cSQL0+" FROM dbo.Sales"
		cSQL0=cSQL0+" WHERE YEAR(ShipDue) >= YEAR(GetDate())-5"
		cSQL0=cSQL0+" AND YEAR(Shipped) >= YEAR(GetDate())-5 AND ISNULL(Cncld,0) < 1"
		cSQL0=cSQL0+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL0=cSQL0+" AND ISNULL(Typ,'')='"+pTyp+"'"
		cSQL0=cSQL0+") AS salesByMonth"
		cSQL0=cSQL0+" PIVOT( SUM([cmplte]) FOR [Month] IN"
		cSQL0=cSQL0+"([Jan],[Feb],[Mar],[Apr],[May],[Jun],"
		cSQL0=cSQL0+"[Jul],[Aug],[Sep],[Oct],[Nov],[Dec])"
		cSQL0=cSQL0+") AS Total_Shipments"
		cSQL0=cSQL0+" ORDER BY [Year] DESC, [Typ]"
		
		WAIT WINDOW "1 of 6" NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL0, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsTotal')
		ENDIF
		IF RECCOUNT('tmpShipmentsTotal')=0
			cSQL0="SELECT '"+pTyp+"' AS [Typ],YEAR(GetDate()) AS [Year],0 AS [Jan],0 AS [Feb],0 AS [Mar],0 AS [Apr],0 AS [May],0 AS [Jun],0 AS [Jul],0 AS [Aug],0 AS [Sep],0 AS [Oct],0 AS [Nov],0 AS [Dec]"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipmentsTotal')
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL0, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsTotal')
			ENDIF
		ENDIF
		IF !USED('tmpShipmentsTotal')
			lGood = .F.
		ELSE
			LOCATE FOR Year = YEAR(DATE())-1
			IF NOT FOUND()
				INSERT INTO tmpShipmentsTotal (Typ,Year) VALUES (pTyp,YEAR(DATE())-1)
			ENDIF
			LOCATE FOR Year = YEAR(DATE())
			IF NOT FOUND()
				INSERT INTO tmpShipmentsTotal (Typ,Year) VALUES (pTyp,YEAR(DATE()))
			ENDIF
		ENDIF
		
		
		cSQL1 = "SELECT [Typ1],[Year],[Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],[Jl1],[Au1],[Se1],[Oc1],[No1],[De1]"
		cSQL1=cSQL1+" FROM ("
		cSQL1=cSQL1+" SELECT YEAR(Shipped) AS [Year]"
		cSQL1=cSQL1+", [Typ] AS Typ1"
		cSQL1=cSQL1+", (CASE "
		cSQL1=cSQL1+" 	WHEN ([Shipped] <= [ShipDue] AND ISNULL(ShipOn,0) = 0) THEN 1"
		cSQL1=cSQL1+" 	WHEN ([Shipped] >= [ShipDue] AND ISNULL(ShipOn,0) = 1) THEN 1"
		cSQL1=cSQL1+" ELSE 0"
		cSQL1=cSQL1+" END) AS [Good]"
		cSQL1=cSQL1+" , (CASE MONTH(Shipped)"
		cSQL1=cSQL1+" WHEN 1 THEN 'Ja1'"
		cSQL1=cSQL1+" WHEN 2 THEN 'Fe1'"
		cSQL1=cSQL1+" WHEN 3 THEN 'Mr1'"
		cSQL1=cSQL1+" WHEN 4 THEN 'Ap1'"
		cSQL1=cSQL1+" WHEN 5 THEN 'My1'"
		cSQL1=cSQL1+" WHEN 6 THEN 'Jn1'"
		cSQL1=cSQL1+" WHEN 7 THEN 'Jl1'"
		cSQL1=cSQL1+" WHEN 8 THEN 'Au1'"
		cSQL1=cSQL1+" WHEN 9 THEN 'Se1'"
		cSQL1=cSQL1+" WHEN 10 THEN 'Oc1'"
		cSQL1=cSQL1+" WHEN 11 THEN 'No1'"
		cSQL1=cSQL1+" WHEN 12 THEN 'De1'"
		cSQL1=cSQL1+" END"
		cSQL1=cSQL1+"  )AS [MonthGood]"
		cSQL1=cSQL1+" FROM dbo.Sales"
		cSQL1=cSQL1+" WHERE YEAR(ShipDue) >= YEAR(GetDate())-5"
		cSQL1=cSQL1+" AND YEAR(Shipped) >= YEAR(GetDate())-5 AND ISNULL(Cncld,0) < 1 AND ISNULL(ShipOn,0) < 1"
		cSQL1=cSQL1+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL1=cSQL1+" AND ISNULL(Typ,'')='"+pTyp+"'"
		cSQL1=cSQL1+" ) AS salesByMonth"
		cSQL1=cSQL1+" PIVOT( SUM([Good]) FOR [MonthGood] IN"
		cSQL1=cSQL1+" ([Ja1],[Fe1],[Mr1],[Ap1],[My1],[Jn1],"
		cSQL1=cSQL1+" [Jl1],[Au1],[Se1],[Oc1],[No1],[De1])"
		cSQL1=cSQL1+" ) AS On_Time_Shipments "
		cSQL1=cSQL1+" ORDER BY [Year] DESC, [Typ1]"
		
		WAIT WINDOW "2 of 6" NOWAIT
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsOnTime')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsOnTime')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL1, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsOnTime')
		ENDIF
		IF RECCOUNT('tmpShipmentsOnTime')=0
			cSQL1 = "SELECT '"+pTyp+"' AS [Typ1],YEAR(GetDate()) AS [Year],0 AS [Ja1],0 AS [Fe1],0 AS [Mr1],0 AS [Ap1],0 AS [My1],0 AS [Jn1],0 AS [Jl1],0 AS [Au1],0 AS [Se1],0 AS [Oc1],0 AS [No1],0 AS [De1]"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsOnTime')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL1, 'tmpShipmentsOnTime')
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL1, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsOnTime')
			ENDIF
		ENDIF
		
		IF !USED('tmpShipmentsOnTime')
			lGood = .F.
		ELSE
			LOCATE FOR Year = YEAR(DATE())-1
			IF NOT FOUND()
				INSERT INTO tmpShipmentsTotal (Typ,Year) VALUES (pTyp,YEAR(DATE())-1)
			ENDIF
			LOCATE FOR Year = YEAR(DATE())
			IF NOT FOUND()
				INSERT INTO tmpShipmentsTotal (Typ,Year) VALUES (pTyp,YEAR(DATE()))
			ENDIF
		ENDIF
		
		cSQL2 = "SELECT [Typ2],[Year],[Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],[Jl2],[Au2],[Se2],[Oc2],[No2],[De2]"
		cSQL2=cSQL2+" FROM ("
		cSQL2=cSQL2+" SELECT YEAR(Shipped) AS [Year]"
		cSQL2=cSQL2+", [Typ] AS Typ2"
		cSQL2=cSQL2+", (CASE "
		cSQL2=cSQL2+" 	WHEN ([Shipped] <= [ShipDue]+2 AND ISNULL(ShipOn,0) = 0) THEN 1"
		cSQL2=cSQL2+" 	WHEN ([Shipped] >= [ShipDue]-2 AND ISNULL(ShipOn,0) = 1) THEN 1"
		cSQL2=cSQL2+" 	ELSE 0"
		cSQL2=cSQL2+" 	END) AS [Good]"
		cSQL2=cSQL2+" , (CASE MONTH(Shipped)"
		cSQL2=cSQL2+" WHEN 1 THEN 'Ja2'"
		cSQL2=cSQL2+" WHEN 2 THEN 'Fe2'"
		cSQL2=cSQL2+" WHEN 3 THEN 'Mr2'"
		cSQL2=cSQL2+" WHEN 4 THEN 'Ap2'"
		cSQL2=cSQL2+" WHEN 5 THEN 'My2'"
		cSQL2=cSQL2+" WHEN 6 THEN 'Jn2'"
		cSQL2=cSQL2+" WHEN 7 THEN 'Jl2'"
		cSQL2=cSQL2+" WHEN 8 THEN 'Au2'"
		cSQL2=cSQL2+" WHEN 9 THEN 'Se2'"
		cSQL2=cSQL2+" WHEN 10 THEN 'Oc2'"
		cSQL2=cSQL2+" WHEN 11 THEN 'No2'"
		cSQL2=cSQL2+" WHEN 12 THEN 'De2'"
		cSQL2=cSQL2+" END"
		cSQL2=cSQL2+"  )AS [Monthwith5]"
		cSQL2=cSQL2+" FROM dbo.Sales"
		cSQL2=cSQL2+" WHERE YEAR(ShipDue) >= YEAR(GetDate())-5"
		cSQL2=cSQL2+" AND YEAR(Shipped) >= YEAR(GetDate())-5 AND ISNULL(Cncld,0) < 1 "
		cSQL2=cSQL2+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL2=cSQL2+" AND ISNULL(Typ,'')='"+pTyp+"'"
		cSQL2=cSQL2+" ) AS salesByMonth"
		cSQL2=cSQL2+" PIVOT( "
		cSQL2=cSQL2+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL2=cSQL2+" ([Ja2],[Fe2],[Mr2],[Ap2],[My2],[Jn2],"
		cSQL2=cSQL2+" [Jl2],[Au2],[Se2],[Oc2],[No2],[De2])"
		cSQL2=cSQL2+" ) AS Within2Days"
		cSQL2=cSQL2+" ORDER BY [Year] DESC, [Typ2]"
		
		WAIT WINDOW "3 of 6" NOWAIT
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsWithin2Days')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsWithin2Days')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL2, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsWithin2Days')
		ENDIF
		IF RECCOUNT('tmpShipmentsWithin2Days')=0
			cSQL2= "SELECT '"+pTyp+"' AS [Typ2],YEAR(GetDate()) AS [Year],0 AS [Ja2],0 AS [Fe2],0 AS [Mr2],0 AS [Ap2],0 AS [My2],0 AS [Jn2],0 AS [Jl2],0 AS [Au2],0 AS [Se2],0 AS [Oc2],0 AS [No2],0 AS [De2]"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsWithin2Days')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL2, 'tmpShipmentsWithin2Days')
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL2, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsWithin2Days')
			ENDIF
		ENDIF
		IF !USED('tmpShipmentsWithin2Days')
			lGood = .F.
		ELSE	
			LOCATE FOR Year = YEAR(DATE())-1
			IF NOT FOUND()
				INSERT INTO tmpShipmentsWithin2Days (Typ2,Year) VALUES (pTyp,YEAR(DATE())-1)
			ENDIF
			LOCATE FOR Year = YEAR(DATE())
			IF NOT FOUND()
				INSERT INTO tmpShipmentsWithin2Days (Typ2,Year) VALUES (pTyp,YEAR(DATE()))
			ENDIF
		ENDIF
		
		cSQL5 = "SELECT [Typ5],[Year],[Ja5],[Fe5],[Mr5],[Ap5],[My5],[Jn5],[Jl5],[Au5],[Se5],[Oc5],[No5],[De5]"
		cSQL5=cSQL5+" FROM ("
		cSQL5=cSQL5+" SELECT YEAR(Shipped) AS [Year]"
		cSQL5=cSQL5+", [Typ] AS Typ5"
		cSQL5=cSQL5+" , (CASE "
		cSQL5=cSQL5+" 	WHEN ([Shipped] <= [ShipDue]+7 AND ISNULL(ShipOn,0) = 0) THEN 1"
		cSQL5=cSQL5+" 	WHEN ([Shipped] >= [ShipDue]-7 AND ISNULL(ShipOn,0) = 1) THEN 1"
		cSQL5=cSQL5+" 	ELSE 0"
		cSQL5=cSQL5+" 	END) AS [Good]"
		cSQL5=cSQL5+" , (CASE MONTH(Shipped)"
		cSQL5=cSQL5+" WHEN 1 THEN 'Ja5'"
		cSQL5=cSQL5+" WHEN 2 THEN 'Fe5'"
		cSQL5=cSQL5+" WHEN 3 THEN 'Mr5'"
		cSQL5=cSQL5+" WHEN 4 THEN 'Ap5'"
		cSQL5=cSQL5+" WHEN 5 THEN 'My5'"
		cSQL5=cSQL5+" WHEN 6 THEN 'Jn5'"
		cSQL5=cSQL5+" WHEN 7 THEN 'Jl5'"
		cSQL5=cSQL5+" WHEN 8 THEN 'Au5'"
		cSQL5=cSQL5+" WHEN 9 THEN 'Se5'"
		cSQL5=cSQL5+" WHEN 10 THEN 'Oc5'"
		cSQL5=cSQL5+" WHEN 11 THEN 'No5'"
		cSQL5=cSQL5+" WHEN 12 THEN 'De5'"
		cSQL5=cSQL5+" END"
		cSQL5=cSQL5+"  )AS [Monthwith5]"
		cSQL5=cSQL5+" FROM dbo.Sales"
		cSQL5=cSQL5+" WHERE YEAR(ShipDue) >= YEAR(GetDate())-5"
		cSQL5=cSQL5+" AND YEAR(Shipped) >= YEAR(GetDate())-5 AND ISNULL(Cncld,0) < 1"
		cSQL5=cSQL5+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQL5=cSQL5+" AND ISNULL(Typ,'')='"+pTyp+"'"
		cSQL5=cSQL5+" ) AS salesByMonth"
		cSQL5=cSQL5+" PIVOT( "
		cSQL5=cSQL5+" SUM([Good]) FOR [Monthwith5] IN"
		cSQL5=cSQL5+" ([Ja5],[Fe5],[Mr5],[Ap5],[My5],[Jn5],"
		cSQL5=cSQL5+" [Jl5],[Au5],[Se5],[Oc5],[No5],[De5])"
		cSQL5=cSQL5+" ) AS WithinWeek"
		cSQL5=cSQL5+" ORDER BY [Year] DESC, [Typ5]"
		
		*IF pTyp = "P"
		*	WAIT "Production"
		*ENDIF
		
		
		WAIT WINDOW "4 of 6" NOWAIT
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL5, 'tmpShipmentsWithinWeek')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL5, 'tmpShipmentsWithinWeek')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL5, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsWithinWeek')
		ENDIF
		IF RECCOUNT('tmpShipmentsWithinWeek')=0
			cSQL5= "SELECT '"+pTyp+"' AS [Typ5],YEAR(GetDate()) AS [Year],0 AS [Ja5],0 AS [Fe5],0 AS [Mr5],0 AS [Ap5],0 AS [My5],0 AS [Jn5],0 AS [Jl5],0 AS [Au5],0 AS [Se5],0 AS [Oc5],0 AS [No5],0 AS [De5]"
						
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL5, 'tmpShipmentsWithinWeek')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL5, 'tmpShipmentsWithinWeek')
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL5, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsWithinWeek')
			ENDIF
		ENDIF
		IF !USED('tmpShipmentsWithinWeek')
			lGood = .F.
		ELSE
			LOCATE FOR Year = YEAR(DATE())-1
			IF NOT FOUND()
				INSERT INTO tmpShipmentsWithinWeek (Typ5,Year) VALUES (pTyp,YEAR(DATE())-1)
			ENDIF
			LOCATE FOR Year = YEAR(DATE())
			IF NOT FOUND()
				INSERT INTO tmpShipmentsWithinWeek (Typ5,Year) VALUES (pTyp,YEAR(DATE()))
			ENDIF
		ENDIF
		
		cSQLlBs= "SELECT [TypLb],[Year],[Jalb],[Felb],[M3lb],[Aplb],[M5lb],[J6lb],[J7lb],[Aulb],[Selb],[Oclb],[Nolb],[Delb]"
		cSQLlBs=cSQLlBs+" FROM ( "
		cSQLlBs=cSQLlBs+" SELECT YEAR(Shipped) AS [Year] "
		cSQLlBs=cSQLlBs+", ISNULL(MatlWt,0) AS MatlWt "
		cSQLlBs=cSQLlBs+", [Typ] AS TypLb"
		cSQLlBs=cSQLlBs+", (CASE MONTH(Shipped) "
		cSQLlBs=cSQLlBs+" WHEN 1 THEN 'Jalb' WHEN 2 THEN 'Felb' WHEN 3 THEN 'M3lb' WHEN 4 THEN 'Aplb' "
		cSQLlBs=cSQLlBs+" WHEN 5 THEN 'M5lb' WHEN 6 THEN 'J6lb' WHEN 7 THEN 'J7lb' WHEN 8 THEN 'Aulb' "
		cSQLlBs=cSQLlBs+" WHEN 9 THEN 'Selb' WHEN 10 THEN 'Oclb' WHEN 11 THEN 'Nolb' WHEN 12 THEN 'Delb' "
		cSQLlBs=cSQLlBs+" END "
		cSQLlBs=cSQLlBs+" )AS [Month] "
		cSQLlBs=cSQLlBs+" FROM dbo.Sales "
		cSQLlBs=cSQLlBs+" WHERE YEAR(ShipDue) >= YEAR(GetDate())-5 "
		cSQLlBs=cSQLlBs+" AND YEAR(Shipped) >= YEAR(GetDate())-5 AND ISNULL(Cncld,0) < 1 "
		cSQLlBs=cSQLlBs+" AND YEAR(ShipDue) <= YEAR(GETDATE()) "
		cSQLlBs=cSQLlBs+" AND ISNULL(Typ,'')='"+pTyp+"'"
		cSQLlBs=cSQLlBs+") AS salesByMonth "
		cSQLlBs=cSQLlBs+" PIVOT( SUM([MatlWt]) FOR [Month] IN "
		cSQLlBs=cSQLlBs+"([Jalb],[Felb],[M3lb],[Aplb],[M5lb],[J6lb],"
		cSQLlBs=cSQLlBs+"[J7lb],[Aulb],[Selb],[Oclb],[Nolb],[Delb]) "
		cSQLlBs=cSQLlBs+") AS Total_lBs "
		cSQLlBs=cSQLlBs+" ORDER BY [Year] DESC, [TypLb]"
		
		WAIT WINDOW "5 of 6" NOWAIT
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLlBs, 'tmpShipmentsLBs')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLlBs, 'tmpShipmentsLBs')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQLlBs, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsLBs')
		ENDIF
		IF RECCOUNT('tmpShipmentsLBs')=0
			cSQLlBs= "SELECT '"+pTyp+"' AS [TypLb],YEAR(GetDate()) AS [Year],0 AS [JaLb],0 AS [FeLb],0 AS [M3Lb],0 AS [ApLb],0 AS [M5Lb],0 AS [J6Lb],0 AS [J7Lb],0 AS [AuLb],0 AS [SeLb],0 AS [OcLb],0 AS [NoLb],0 AS [DeLb]"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLlBs, 'tmpShipmentsLBs')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLlBs, 'tmpShipmentsLBs')
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQLlBs, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsLBs')
			ENDIF
		ENDIF
		IF !USED('tmpShipmentsLBs')
			lGood = .F.
		ELSE
			LOCATE FOR Year = YEAR(DATE())-1
			IF NOT FOUND()
				INSERT INTO tmpShipmentsLBs(TypLb,Year) VALUES (pTyp,YEAR(DATE())-1)
			ENDIF
			LOCATE FOR Year = YEAR(DATE())
			IF NOT FOUND()
				INSERT INTO tmpShipmentsLBs(TypLb,Year) VALUES (pTyp,YEAR(DATE()))
			ENDIF
		ENDIF
		
		cSQLrma = "SELECT [TypR],[Year],[JaR],[FeR],[MrR],[AlR],[MyR],[JnR],[JlR],[AuR],[SeR],[OcR],[NoR],[DeR]"
		cSQLrma=cSQLrma+" FROM ("
		cSQLrma=cSQLrma+" SELECT YEAR(R.Aprv_Date) AS [Year]"
		cSQLrma=cSQLrma+", [Typ] AS TypR"
		cSQLrma=cSQLrma+", (CASE WHEN S.RMA_No > 0 THEN 1 ELSE 0 END) AS [RMA]"
		cSQLrma=cSQLrma+", (CASE MONTH(R.Aprv_Date)"
		cSQLrma=cSQLrma+" WHEN 1 THEN 'JaR'"
		cSQLrma=cSQLrma+" WHEN 2 THEN 'FeR'"
		cSQLrma=cSQLrma+" WHEN 3 THEN 'MrR'"
		cSQLrma=cSQLrma+" WHEN 4 THEN 'AlR'"
		cSQLrma=cSQLrma+" WHEN 5 THEN 'MyR'"
		cSQLrma=cSQLrma+" WHEN 6 THEN 'JnR'"
		cSQLrma=cSQLrma+" WHEN 7 THEN 'JlR'"
		cSQLrma=cSQLrma+" WHEN 8 THEN 'AuR'"
		cSQLrma=cSQLrma+" WHEN 9 THEN 'SeR'"
		cSQLrma=cSQLrma+" WHEN 10 THEN 'OcR'"
		cSQLrma=cSQLrma+" WHEN 11 THEN 'NoR'"
		cSQLrma=cSQLrma+" WHEN 12 THEN 'DeR'"
		cSQLrma=cSQLrma+" END"
		cSQLrma=cSQLrma+"  )AS [MonthRMA]"
		cSQLrma=cSQLrma+" FROM dbo.Sales S "
		cSQLrma=cSQLrma+" INNER JOIN dbo.RMA_Detail RD ON RD.SO_Item = S.SOitem "
		cSQLrma=cSQLrma+" INNER JOIN dbo.rma R ON R.rma_no = RD.rma_no "
		cSQLrma=cSQLrma+" WHERE YEAR(R.Aprv_Date) >= YEAR(GetDate())-5 "
		cSQLrma=cSQLrma+" AND YEAR(R.Aprv_Date) >= YEAR(GetDate())-5 "
		cSQLrma=cSQLrma+" AND YEAR(R.Aprv_Date) <= YEAR(GETDATE()) "
		cSQLrma=cSQLrma+" AND ISNULL(Typ,'')='"+pTyp+"'"
		cSQLrma=cSQLrma+" ) AS salesByMonth"
		cSQLrma=cSQLrma+" PIVOT( "
		cSQLrma=cSQLrma+" SUM([RMA]) FOR [MonthRMA] IN"
		cSQLrma=cSQLrma+" ([JaR],[FeR],[MrR],[AlR],[MyR],[JnR],"
		cSQLrma=cSQLrma+" [JlR],[AuR],[SeR],[OcR],[NoR],[DeR])"
		cSQLrma=cSQLrma+" ) AS RMAPivot"
		cSQLrma=cSQLrma+" ORDER BY [Year] DESC, [TypR]"
		
		WAIT WINDOW "6 of 6" NOWAIT
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLrma, 'tmpShipmentsRMA')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLrma, 'tmpShipmentsRMA')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQLrma, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsRMA')
		ENDIF
		IF RECCOUNT('tmpShipmentsRMA')=0
			cSQLrma= "SELECT '"+pTyp+"' AS [TypR],YEAR(GetDate()) AS [Year],0 AS [JaR],0 AS [FeR],0 AS [MrR],0 AS [AlR],0 AS [MyR],0 AS [JnR],0 AS [JlR],0 AS [AuR],0 AS [SeR],0 AS [OcR],0 AS [NoR],0 AS [DeR]"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLrma, 'tmpShipmentsRMA')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLrma, 'tmpShipmentsRMA')
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQLrma, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipmentsRMA')
			ENDIF
		ENDIF
		IF !USED('tmpShipmentsRMA')
			lGood = .F.
		ELSE
			LOCATE FOR Year = YEAR(DATE())-1
			IF NOT FOUND()
				INSERT INTO tmpShipmentsRMA(TypR,Year) VALUES (pTyp,YEAR(DATE())-1)
			ENDIF
			LOCATE FOR Year = YEAR(DATE())
			IF NOT FOUND()
				INSERT INTO tmpShipmentsRMA(TypR,Year) VALUES (pTyp,YEAR(DATE()))
			ENDIF
		ENDIF
		
		
		
		IF lGood
			SELECT T.Year,Typ,Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec;
				,Ja1,Fe1,Mr1,Ap1,My1,Jn1,Jl1,Au1,Se1,Oc1,No1,De1;
				,Ja2,Fe2,Mr2,Ap2,My2,Jn2,Jl2,Au2,Se2,Oc2,No2,De2;
				,Ja5,Fe5,Mr5,Ap5,My5,Jn5,Jl5,Au5,Se5,Oc5,No5,De5;
				,Jalb,Felb,M3lb,Aplb,M5lb,J6lb,J7lb,Aulb,Selb,Oclb,Nolb,Delb;
				,JaR,FeR,MrR,AlR,MyR,JnR,JlR,AuR,SeR,OcR,NoR,DeR;
			FROM tmpShipmentsTotal T, tmpShipmentsOnTime OT, tmpShipmentsWithin2Days W2D, ;
				tmpShipmentsWithinWeek WW, tmpShipmentsLBs L, tmpShipmentsRMA R;
			WHERE T.Year = OT.Year AND OT.Year = W2D.Year AND W2D.Year = WW.Year AND WW.Year = L.Year AND L.Year = R.Year;
			INTO CURSOR tmpShipments
			*BROW
			
		*	REPORT FORM reports\r_shipments.frx PREVIEW
			
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE gettopcitiessalesp
		*
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpGetTopCitiesSalesP')
			USE IN tmpGetTopCitiesSalesP
		ENDIF
		
		cSQL = "SELECT Sales_No.SalesRep "
		cSQL = cSQL +", COUNT(*) AS '12Month' "
		cSQL = cSQL +", SUM( CASE WHEN Sales.Shipped > GETDATE()-90 THEN 1 ELSE 0 END) AS '3Month' "
		cSQL = cSQL +",SoldAddr.St, SoldAddr.City "
		
		cSQL = cSQL +" FROM dbo.Sales Sales "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.Sales_No Sales_No ON  Sales.Salesnum = Sales_No.Salesnum "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.SoldAddr SoldAddr ON SoldAddr.SoldCode = Sales_No.pSoldAddr "
		cSQL = cSQL +" WHERE ISNULL(Sales.Cncld,0) < 1 AND ISNULL(Sales.Cmplt,0) > 0 "
		cSQL = cSQL +" AND ISNULL(Sales.ItemTot,0) > 0 "
		cSQL = cSQL +" AND Sales.Shipped > GETDATE()-365 "
		cSQL = cSQL +" AND LEN(SoldAddr.St)> 0 "
		cSQL = cSQL +" Group by  Sales_No.SalesRep,SoldAddr.St, SoldAddr.City"
		cSQL = cSQL +" ORDER BY  Sales_No.SalesRep,'12Month' DESC,SoldAddr.St, SoldAddr.City "
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpGetTopCitiesSalesP')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpGetTopCitiesSalesP')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpGetTopCitiesSalesP')
		ENDIF
		
		
		IF !USED('tmpGetTopCitiesSalesP')
			lGood = .F.
		ENDIF
		
		
		IF lGood
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getvendorperformancedata
		*ThisForm.GetVendorPerformanceData()
		
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpVendorPerformance')
			USE IN tmpVendorPerformance
		ENDIF
		
		cSQL = "SELECT Distinct Company "
		cSQL = cSQL +", SUM( CASE WHEN YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate())-1 THEN CAST([Delivered] AS INT) ELSE 0 END ) AS [Past_Del]" 
		*cSQL = cSQL +", SUM( CASE WHEN Received < Due_Min AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate())-1 Then 1 ELSE 0 END ) AS [Past_Early] "
		*cSQL = cSQL +", SUM( CASE WHEN Received >= Due_Min AND Received <= Due_Max AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate())-1 Then 1 ELSE 0 END ) AS [Past_OnTime] "
		*cSQL = cSQL +", SUM( CASE WHEN Received > Due_Max AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate())-1 Then 1 ELSE 0 END) AS [Past_PastDue] "
		cSQL = cSQL +", SUM( CASE WHEN Received < Due_Min AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate())-1 Then 1 ELSE 0 END ) AS [Past_Early] "
		cSQL = cSQL +", SUM( CASE WHEN Received >= ISNULL(Due_Min,Due_Max) AND Received <= ISNULL(Due_Max,Due_Min) AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate())-1 Then 1 ELSE 0 END ) AS [Past_OnTime] "
		cSQL = cSQL +", SUM( CASE WHEN Received > ISNULL(Due_Max,Due_Min) AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate())-1 Then 1 ELSE 0 END) AS [Past_PastDue] "
		
		cSQL = cSQL +", SUM( CASE WHEN YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate()) THEN CAST([Delivered] AS INT) ELSE 0 END ) AS [Curr_Del] "
		*cSQL = cSQL +", SUM( CASE WHEN Received < Due_Min AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate()) Then 1 ELSE 0 END ) AS [Curr_Early] "
		*cSQL = cSQL +", SUM( CASE WHEN Received >= Due_Min AND Received <= Due_Max AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate()) Then 1 ELSE 0 END ) AS [Curr_OnTime] "
		*cSQL = cSQL +", SUM( CASE WHEN Received > Due_Max AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate()) Then 1 ELSE 0 END) AS [Curr_PastDue] "
		cSQL = cSQL +", SUM( CASE WHEN Received < Due_Min AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate()) Then 1 ELSE 0 END ) AS [Curr_Early] "
		cSQL = cSQL +", SUM( CASE WHEN Received >= ISNULL(Due_Min,Due_Max) AND Received <= ISNULL(Due_Max,Due_Min) AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate()) Then 1 ELSE 0 END ) AS [Curr_OnTime] "
		cSQL = cSQL +", SUM( CASE WHEN Received > ISNULL(Due_Max,Due_Min) AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) = Year(GetDate()) Then 1 ELSE 0 END) AS [Curr_PastDue] "
		
		cSQL = cSQL +" FROM dbo.PurchaseOrder "
		cSQL = cSQL +" WHERE YEAR( ISNULL(OrderDate,ISNULL(Due_Max,ISNULL(Due_Min,Received))) ) > Year(GetDate())-2"
		cSQL = cSQL +" AND YEAR( ISNULL(Due_Max,ISNULL(Due_Min,Received)) ) > Year(GetDate())-2"
		cSQL = cSQL +" AND ISNULL(Cancelled,0) < 1 "
		cSQL = cSQL +" AND LEN( [Company] ) >1"
		cSQL = cSQL +" Group By Company "
		cSQL = cSQL +" ORDER BY Company"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendorPerformance')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendorPerformance')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpVendorPerformance')
		ENDIF
		
		IF !USED('tmpVendorPerformance')
			lGood = .F.
		ENDIF
		
		
		IF lGood
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		*ThisForm.GetReportData()
	ENDPROC

	PROCEDURE Unload
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdActivePOexport.Click
		
		ThisForm.GetActivePOData()
		
		IF USED('tmpActivePO')
			SELECT tmpActivePO
			PRIVATE cMEM
