	PROCEDURE Init
		IF USED('tmpSalesOrderItem')
			USE IN tmpSalesOrderItem
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT SOitem, CASE WHEN ISNULL(cmplt,0)=1 OR ISNULL(CnCld,0) = 1 Then 1 ELSE 0 END AS Cmplt FROM dbo.Sales"
		cSQL = cSQL + " ORDER BY SOitem DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesOrderItem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSalesOrderItem' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesOrderItem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesOrderItem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesOrderItem' )
		ENDIF
		
		ThisForm.grdSOitem.RecordSource = 'tmpSalesOrderItem'
		
		ThisForm.RefreshSOiDetail()
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE refreshsoidetail
		PRIVATE cSOitem
		cSOitem = tmpSalesOrderItem.SOitem
		
		IF USED('tmpSOItemDetail')
			ThisForm.grdSOiDetail.RecordSource = ''
			USE IN tmpSOItemDetail
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT LEFT([Who],23) AS [Who],[What],[When],[Comment] FROM dbo.Sales_Status"
		cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
		cSQL = cSQL + " ORDER BY [WHEN] DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOItemDetail')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOItemDetail' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOItemDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOItemDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOItemDetail' )
		ENDIF
		
		ThisForm.grdSOiDetail.RecordSource = 'tmpSOItemDetail'
		ThisForm.grdSOiDetail.Column1.Header1.Caption = "  Who"
		ThisForm.grdSOiDetail.Column1.Width = 140
		ThisForm.grdSOiDetail.Column2.Header1.Caption = " What"
		ThisForm.grdSOiDetail.Column2.Width = 80
		ThisForm.grdSOiDetail.Column3.Header1.Caption = "  When"
		ThisForm.grdSOiDetail.Column3.Width = 130
		
		
		ThisForm.edtComment.Value = tmpSOItemDetail.Comment
		
		
		*********************
		IF USED('tmpSales')
			USE IN tmpSales
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT Cncld,Cmplt,Prcp,Prcd,Pckd,Urgent FROM dbo.Sales"
		cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSales' )
		ENDIF
		IF USED('tmpSales')
			ThisForm.chkCancelled.Visible = .T.
			ThisForm.chkComplete.Visible = .T.
			ThisForm.chkUrgent.Visible = .T.
			
			ThisForm.chkPRCP.Visible = .T.
			ThisForm.chkPRCD.Visible = .T.
			ThisForm.chkPCKD.Visible = .T.
		
		
			ThisForm.chkCancelled.Value = tmpSales.Cncld
			ThisForm.chkComplete.Value = tmpSales.Cmplt
			ThisForm.chkUrgent.Value = IIF(ISNULL(tmpSales.Urgent),0,1)
			
			ThisForm.chkPRCP.Value = tmpSales.PRCP
			ThisForm.chkPRCD.Value = tmpSales.PRCD
			ThisForm.chkPCKD.Value = tmpSales.PCKD
			
		ELSE
			ThisForm.chkCancelled.Visible = .F.
			ThisForm.chkComplete.Visible = .F.
			ThisForm.chkUrgent.Visible = .F.
			
			ThisForm.chkPRCP.Visible = .F.
			ThisForm.chkPRCD.Visible = .F.
			ThisForm.chkPCKD.Visible = .F.
			
			ThisForm.chkCancelled.Value = 0
			ThisForm.chkComplete.Value = 0
			ThisForm.chkUrgent.Value = 0
			
			ThisForm.chkPRCP.Value = 0
			ThisForm.chkPRCD.Value = 0
			ThisForm.chkPCKD.Value = 0
		ENDIF
		
		*******Get from SO_ProcessNotes
		IF USED("tmpProcessNotes")
			USE IN tmpProcessNotes
		ENDIF
		SELECT 0
		
		cSQL = "SELECT Notes FROM dbo.SO_ProcessNotes WHERE "
		cSQL = cSQL + " SOItem = dbo.f_ProperSOitem('"+cSOItem+"')"
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpProcessNotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpProcessNotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessNotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessNotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpProcessNotes')
		ENDIF
		IF USED("tmpProcessNotes")
			IF VARTYPE(tmpProcessNotes.Notes) = "C"
				ThisForm.edtProcessNotes.Value = tmpProcessNotes.Notes
			ELSE
				ThisForm.edtProcessNotes.Value = " "
			ENDIF
			
			USE IN tmpProcessNotes			
		
		ELSE
			ThisForm.edtProcessNotes.Value = " "
		ENDIF
	ENDPROC

	PROCEDURE saveprocessnotes
		PARAMETERS pProcessNotes
		*ThisFormSet.SaveProcessNotes(ThisForm.edtProcessNotes.Value)
		
		IF VARTYPE(pProcessNotes) != "C"
			RETURN .F.
		ENDIF
		
		PRIVATE cCustomerText
		cProcessNotes = PrepareSQLtxt(pProcessNotes,'Process Notes',-1)
		PRIVATE lFound
		lFound  = .F.
		
		PRIVATE cSOitem
		cSOitem = tmpSalesOrderItem.SOitem
		
		IF Proper_PO_Item( cSOitem ) != Proper_PO_Item( '0-00' )
			PRIVATE nSQLEXEC, cSQL
			IF USED('tmpCntPN')
				USE IN tmpCntPN
			ENDIF
			SELECT 0
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.SO_ProcessNotes WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntPN' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCntPN' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntPN")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntPN")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCntPN')
			ENDIF
		
			IF USED('tmpCntPN')
				IF VARTYPE(tmpCntPN.Cntd) = 'N'
					IF tmpCntPN.Cntd > 0
						lFound = .T.
					ENDIf
				ENDIF
				USE IN 'tmpCntPN'
			ENDIF
		
			IF lFound
				IF EMPTY(cProcessNotes)
					cSQL = "DELETE dbo.SO_ProcessNotes WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				ELSE
					cSQL = "UPDATE dbo.SO_ProcessNotes SET Notes = '"+cProcessNotes+"' WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
				ENDIF
			ELSE
				cSQL = "INSERT INTO dbo.SO_ProcessNotes (SOitem,Notes) VALUES ( "
				cSQL = cSQL + "'"+cSOitem+"'"
				cSQL = cSQL + ",'"+cProcessNotes+"'"
				cSQL = cSQL + ")"
										
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
				ENDIF												
			ENDIF
		ELSE
			WAIT WINDOW 'Cannot save without Sales Order Number' NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE chkFilterComplete.Click
		PRIVATE lFilterComplete
		lFilterComplete = ( this.Value = 0 )
		
		SELECT tmpSalesOrderItem
		
		IF lFilterComplete
			SET FILTER TO Cmplt=1 IN tmpSalesOrderItem 
			This.Caption = "Completed"
		ELSE
			SET FILTER TO Cmplt=0 IN tmpSalesOrderItem 
			This.Caption = "Not Complete"
		ENDIF
		
		ThisForm.grdSOitem.Refresh
		ThisForm.grdSOitem.SetFocus()
		
	ENDPROC

	PROCEDURE cmbFilterSalesP.GotFocus
		
		
		This.ColumnCount = ALEN(ArrSalesP,2)
		This.FirstElement  = 1
		This.IncrementalSearch = .F.
		This.NumberOfElements = ALEN(ArrSalesP,1)
		This.RowSource = "ArrSalesP"
		This.RowSourceType = 5
		
		This.Value = Quotes.SalesP
		
		This.Refresh
	ENDPROC

	PROCEDURE cmbFilterSalesP.Init
		PUBLIC ARRAY ArrSalesP(1)
		DIMENSION ArrSalesP(1)
		ArrSalesP(1) = "*"
		
		
		*IF AppSetup_TableofSalesP()
		IF AppSetup_TopTableofSalesP()
			IF USED('tmpSalesP')
				SELECT tmpSalesP
				SELECT ANS,UN FROM tmpSalesP WHERE ANS != " " INTO ARRAY ArrSalesP 
				
				USE IN tmpSalesP
			ENDIF
		ENDIF	
		*ArrAPLen = ALEN(ArrSalesP)
		*DIMENSION ArrSalesP(ArrAPLen +1)
		*ArrSalesP(ArrAPLen +1,1) = "*"
		ArrAPLen = ALEN(ArrSalesP,1)
		DIMENSION ArrSalesP(ArrAPLen +1,2)
		ArrSalesP(ArrAPLen +1,1) = "*"
		ArrSalesP(ArrAPLen +1,2) = "All"
		
	ENDPROC

	PROCEDURE cmbFilterSalesP.Valid
		ThisFormSet.Refreshallquotes(.F.)
		
		
	ENDPROC

	PROCEDURE cmbFilterSalesP.When
		RETURN !ThisFormSet.isediting
	ENDPROC

	PROCEDURE cmdProcessNotesEdit.Click
		IF This.Caption = "Edit"
			*ThisForm.edtProcessNotes.ReadOnly = .F.
			ThisForm.edtProcessNotes.ReadOnly = .F.
			This.Caption = "Save"
			IF EMPTY(ThisForm.edtProcessNotes.Value)
				ThisForm.edtProcessNotes.Value = DTOC(DATE())+" "
			ELSE
				ThisForm.edtProcessNotes.Value = RTRIM(ThisForm.edtProcessNotes.Value)+CHR(10)+DTOC(DATE())+" "
			ENDIF
			
			ThisForm.edtProcessNotes.SetFocus
			
		ELSE
			This.Caption = "Edit"
			ThisForm.edtProcessNotes.ReadOnly = .T.
			
			ThisForm.SaveProcessNotes(ThisForm.edtProcessNotes.Value)	
		
		ENDIF
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSearch.Click
		
		PRIVATE nSO
		nSO = PrepareSQLnum(ThisForm.txtsearch.Value,'Salesnum',-3)
		
		IF nSO > 0
			SELECT tmpSalesOrderItem
			LOCATE FOR VAL(LEFT( SoItem,7)) = nSO
			IF FOUND()
			
				ThisForm.RefreshSOiDetail()
			ELSE
				MESSAGEBOX("Sales Order not Found",16,"Not Found.")	
			ENDIF
		ELSE
			MESSAGEBOX("Nothing to search",64,"No Sales Number")
		ENDIF
		
		ThisForm.grdSOitem.SetFocus
		
	ENDPROC

	PROCEDURE grdSOiDetail.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.edtComment.Value = tmpSOItemDetail.Comment
	ENDPROC

	PROCEDURE grdSOitem.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshSOiDetail()
	ENDPROC

	PROCEDURE lblSO_Item.Click
		PRIVATE cHTML
		PRIVATE nSO,cSOitem
		nSO = PrepareSQLnum(LEFT(tmpSalesOrderItem.SOitem,7),'Salesnum',-3)
		cSOitem = tmpSalesOrderItem.SOitem
		
		cHTML = get_Report_Server()+"%2fHPA+Sales+Reports%2fSalesOrder+SOitem&rs:Command=Render&cSOitem="
		cHTML = cHTML + cSOitem
		
		
		PRIVATE loHyperlink
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(cHTML)
		RELEASE loHyperlink
		
		
		*!*	*FUNCTION GoUrl(tcUrl, tcAction, tcDirectory, tcParms)
		*!*	PRIVATE tcUrl, tcAction, tcDirectory, tcParms
		
		*!*	tcUrl = cHTML
		*!*	IF EMPTY(tcUrl)
		*!*		RETURN -1
		*!*	ENDIF
		*!*	*IF EMPTY(tcAction)
		*!*	   tcAction = "OPEN"
		*!*	*ENDIF
		*!*	*IF EMPTY(tcDirectory)
		*!*	   tcDirectory = SYS(2023)
		*!*	*ENDIF
		*!*	*IF EMPTY(tcParms)
		*!*	   tcParms = ""
		*!*	*ENDIF
		*!*	 
		*!*	DECLARE INTEGER ShellExecute ;
		*!*	    IN SHELL32.dll ;
		*!*	    INTEGER nWinHandle,;
		*!*	    STRING cOperation,;
		*!*	    STRING cFileName,;
		*!*	    STRING cParameters,;
		*!*	    STRING cDirectory,;
		*!*	    INTEGER nShowWindow
		*!*	 
		*!*	DECLARE INTEGER FindWindow ;
		*!*	   IN WIN32API STRING cNull,STRING cWinName
		*!*	 
		*!*	RETURN ShellExecute(FindWindow(0,_SCREEN.caption),;
		*!*	                    tcAction,tcUrl,;
		*!*	                    tcParms, tcDirectory,1)
	ENDPROC

ENDDEFINE
