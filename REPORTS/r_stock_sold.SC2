				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesPInit')
		ENDIF
		
		IF USED('tmpSalesPInit')
			*SELECT DISTINCT Setup.Un, Setup.Ans FROM Setup WHERE Setup.prp = "SalesP" INTO ARRAY aEmployees
			SELECT Un,Ans FROM tmpSalesPInit INTO ARRAY aEmployees
			
			USE IN tmpSalesPInit
			
		ELSE
		ENDIF
		
		This.ColumnCount =ALEN(aEmployees,2)
		This.NumberOfElements=ALEN(aEmployees)
		This.BoundColumn = 2
		This.ColumnWidths = "115,20"
		
		
		this.addListitem("(All Employees)",1,1)
