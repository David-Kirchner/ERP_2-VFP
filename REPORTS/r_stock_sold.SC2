					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(m.cSalesP),nLoopCount,1)
				ELSE
					this.addListitem(ALLTRIM(m.cSalesP),nLoopCount,2)
				ENDIF
			ENDIF
		ENDFOR
		
		
		This.Value = "*"
		
	ENDPROC

