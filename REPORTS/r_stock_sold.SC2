	PROCEDURE Destroy
		IF USED('FilterSQL')
		*	USE IN FilterSQL
		EndIf
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF

	ENDPROC

	PROCEDURE filtersql		&& Run the SQL with the Filtered parameters
		*ThisForm.FilterSQL()
		
		LOCAL cYear, cMonthDigit, cSalesPFilter, cCustomerFilter, cAlloyFilter
		LOCAL cAddAnd
		lResetMonth = .F.
		cMonthDigit = ""
		
		WAIT WINDOW "Getting SQL data. Page tab 'VIEW' will show when query is done !! " NOWAIT
		
		*Alloy
		cAlloyFilter = ""
		cAlloyPara = ""
		IF ThisForm.pgfAll.pgSearch.chkAlloy.VALUE = 1
			cAddAnd = IIF(EMPTY(cYear) AND EMPTY(cMonthDigit) AND EMPTY(cSalesPFilter) ,""," AND")
			cAlloyFilter = cAddAnd +" Alloy = '" +ALLTRIM(ThisForm.pgfAll.pgSearch.cmbAlloy.VALUE)+"'"
			cAlloyPara = ThisForm.pgfAll.pgSearch.cmbAlloy.VALUE
		ENDIF
		
		*Form
		cFormFilter = ""
		cFormPara = ""
		IF ThisForm.pgfAll.pgSearch.chkForm.VALUE = 1
			cAddAnd = IIF(EMPTY(cYear) AND EMPTY(cMonthDigit) AND EMPTY(cSalesPFilter) AND EMPTY(cAlloyFilter) ,""," AND")
			cFormFilter = cAddAnd +" [Form] = '" +ALLTRIM(ThisForm.pgfAll.pgSearch.cmbForm.VALUE)+"'"
			cFormPara = ThisForm.pgfAll.pgSearch.cmbForm.VALUE
		ENDIF
		
		*Employee
		cSalesPFilter= ""
		cSalesPPara = ""
		IF ThisForm.pgfAll.pgSearch.cmbAllEmployees.VALUE <> "*"
			cAddAnd = IIF(EMPTY(cYear) AND EMPTY(cMonthDigit),""," AND")
			cSalesPFilter= cAddAnd +" SalesP = '" +ThisForm.pgfAll.pgSearch.cmbAllEmployees.VALUE+"'"
			cSalesPPara = ThisForm.pgfAll.pgSearch.cmbAllEmployees.VALUE
		ENDIF
		
		ThisForm.pgfAll.pgView.grdView.RECORDSOURCE = ''
		IF USED('FilterSQL')
			USE IN FilterSQL
		ENDIF
		IF USED('FilterSQL1')
			USE IN FilterSQL1
		ENDIF
		SELECT 0
		
		*gvSalesWhere = "LEN(Sales.soitem)>0 AND Sales.Cncld=0 AND " +cYear +cMonthDigit +cSalesPFilter +cAlloyFilter +cFormFilter 
		gvSalesWhere = " WHERE "+cAlloyFilter + cFormFilter + cSalesPFilter
		
		
		cSQL = "EXEC dbo.[P_Show_AllQuote_Sales] "
		cSQL = cSQL +" @cAlloy = '"+cAlloyPara+"'"
		cSQL = cSQL +",@cForm = '"+cFormPara+"'"
		cSQL = cSQL +",@cSalesP = '"+cSalesPPara+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSQL1')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSQL1')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSQL1")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSQL1")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'FilterSQL1')
		ENDIF
		
		IF USED('FilterSQL1')
			SELECT *;
				,(m01+M02+m03+m04+m05+m06+m07+m08+m09+m10+m11+m12) AS YearTotal ;
				,INT((m01+M02+m03+m04+m05+m06+m07+m08+m09+m10+m11+m12)/4) AS Qtr_Ave ;
				, 999999999 AS CurrentStock;
				, 000000000 AS Incoming;
				, 000000000 AS StockSold ;
				FROM FilterSQL1 INTO Cursor FilterSQL NOFILTER READWRITE
			 
			USE IN FilterSQL1
		ENDIF
		
		PRIVATE cAlloy,cForm,cCC,nThck
		IF USED('FilterSQL')
			SELECT FilterSQL
			nRecCount = RECCOUNT('FilterSQL')
			
			IF MESSAGEBOX("Found "+ALLTRIM(STR(nRecCount))+" records!"+CHR(13)+"Do you want to check Stock on these?"+CHR(13)+"Calculates 40 Records per Minute!",4+48,"Compare Stock level for these items?") = 6
				FOR i = 1 TO nRecCount
					WAIT WINDOW "Getting Stock data "+ALLTRIM(STR(i))+" of "+ALLTRIM(STR(nRecCount)) NOWAIT
					SELECT FilterSQL 
					GOTO (i)
					IF FilterSQL.CurrentStock = 999999999  &&Skip years that have already been updated
					
						cAlloy = FilterSQL.Alloy
						cForm = FilterSQL.Form
						cCC = FilterSQL.CC
						nThck = FilterSQL.Thck
						
						getStockLstCurrent(cAlloy,cForm,cCC,nThck,ThisForm.nConnHandle) 
						IF USED( 'tmpStockLstCurrent' )
							nCurrentStock	= tmpStockLstCurrent.CurrentLBS
							nIncoming 		= tmpStockLstCurrent.Incoming 
							nStockSold 		= tmpStockLstCurrent.StockSold
						ELSE
							nCurrentStock = 0
							nIncoming = 0
							nStockSold = 0
						ENDIF
						*nCurrentStock = getStockLstCurrentLbs(cAlloy,cForm,cCC,nThck,ThisForm.nConnHandle) 
						*nIncoming = getStockLstIncomingLbs(cAlloy,cForm,cCC,nThck,ThisForm.nConnHandle) 
						*nStockSold = getStockLstSoldLBS(cAlloy,cForm,cCC,nThck,ThisForm.nConnHandle)
						
						nCurrentStock	= PrePareSQLnum(nCurrentStock,'CurrentStock',-3)
						nIncoming		= PrePareSQLnum(nIncoming ,'Incoming ',-3)
						nStockSold		= PrePareSQLnum(nStockSold ,'StockSold ',-3)
						
						UPDATE FilterSQL SET ;
							CurrentStock = nCurrentStock ;
							,Incoming = nIncoming ;
							,StockSold = nStockSold  ;
							WHERE Alloy = cAlloy AND Form = cForm AND CC= cCC AND Thck = nThck
						
						SELECT FilterSQL 
					ELSE
						*Already Entered! Skip
					ENDIF
				NEXT i
			ELSE
				*Reset CurrentStok to 0 not 99999999999
				UPDATE FilterSQL SET ;
					CurrentStock = 0 ;
					,Incoming = 0 ;
					,StockSold = 0
						
				
			ENDIF
			GO TOP
		ENDIF
		*THIS.PARENT.PARENT.pgView.SETFOCUS
		*THIS.PARENT.PARENT.pgView.grdView.RECORDSOURCETYPE = 1
		*ThisForm.pgfAll.pgView.grdView.RECORDSOURCETYPE = 1
		ThisForm.pgfAll.pgView.grdView.RECORDSOURCE = 'FilterSQL'
		*!*	ThisForm.pgfAll.pgView.grdView.Column1.ControlSource = 'FilterSQL.Alloy'
		*!*	ThisForm.pgfAll.pgView.grdView.Column1.Header1.Caption = 'Alloy'
		*!*	ThisForm.pgfAll.pgView.grdView.Column2.ControlSource = 'FilterSQL.Form'
		*!*	ThisForm.pgfAll.pgView.grdView.Column2.Header1.Caption = 'Form'
		*!*	ThisForm.pgfAll.pgView.grdView.Column3.ControlSource = 'FilterSQL.CC'
		*!*	ThisForm.pgfAll.pgView.grdView.Column3.Header1.Caption = 'CC'
		*!*	ThisForm.pgfAll.pgView.grdView.Column4.ControlSource = 'FilterSQL.Thck'
		*!*	ThisForm.pgfAll.pgView.grdView.Column4.Header1.Caption = 'Thck'
		*!*	*ThisForm.pgfAll.pgView.grdView.Column4.Width = 60
		*!*	*ThisForm.pgfAll.pgView.grdView.Column4.Text1.Width = 60
		*!*	ThisForm.pgfAll.pgView.grdView.Column5.ControlSource = 'FilterSQL.ShipYear'
		*!*	ThisForm.pgfAll.pgView.grdView.Column5.Header1.Caption = 'Year'
		*!*	ThisForm.pgfAll.pgView.grdView.Column6.ControlSource = 'FilterSQL.m01'
		*!*	ThisForm.pgfAll.pgView.grdView.Column6.Header1.Caption = 'Jan'
		*!*	ThisForm.pgfAll.pgView.grdView.Column7.ControlSource = 'FilterSQL.m02'
		*!*	ThisForm.pgfAll.pgView.grdView.Column7.Header1.Caption = 'Feb'
		*!*	ThisForm.pgfAll.pgView.grdView.Column8.ControlSource = 'FilterSQL.m03'
		*!*	ThisForm.pgfAll.pgView.grdView.Column8.Header1.Caption = 'Mar'
		*!*	ThisForm.pgfAll.pgView.grdView.Column9.ControlSource = 'FilterSQL.m04'
		*!*	ThisForm.pgfAll.pgView.grdView.Column9.Header1.Caption = 'Apr'
		*!*	ThisForm.pgfAll.pgView.grdView.Column10.ControlSource = 'FilterSQL.m05'
		*!*	ThisForm.pgfAll.pgView.grdView.Column10.Header1.Caption = 'May'
		*!*	ThisForm.pgfAll.pgView.grdView.Column11.ControlSource = 'FilterSQL.m06'
		*!*	ThisForm.pgfAll.pgView.grdView.Column11.Header1.Caption = 'Jun'
		*!*	ThisForm.pgfAll.pgView.grdView.Column12.ControlSource = 'FilterSQL.m07'
		*!*	ThisForm.pgfAll.pgView.grdView.Column12.Header1.Caption = 'Jul'
		*!*	ThisForm.pgfAll.pgView.grdView.Column13.ControlSource = 'FilterSQL.m08'
		*!*	ThisForm.pgfAll.pgView.grdView.Column13.Header1.Caption = 'Aug'
		*!*	ThisForm.pgfAll.pgView.grdView.Column14.ControlSource = 'FilterSQL.m09'
		*!*	ThisForm.pgfAll.pgView.grdView.Column14.Header1.Caption = 'Sep'
		*!*	ThisForm.pgfAll.pgView.grdView.Column15.ControlSource = 'FilterSQL.m10'
		*!*	ThisForm.pgfAll.pgView.grdView.Column15.Header1.Caption = 'Oct'
		*!*	ThisForm.pgfAll.pgView.grdView.Column16.ControlSource = 'FilterSQL.m11'
		*!*	ThisForm.pgfAll.pgView.grdView.Column16.Header1.Caption = 'Nov'
		*!*	ThisForm.pgfAll.pgView.grdView.Column17.ControlSource = 'FilterSQL.m12'
		*!*	ThisForm.pgfAll.pgView.grdView.Column17.Header1.Caption = 'Dec'
		
		ThisForm.pgfAll.pgView.grdView.Refresh
		
		*MESSAGEBOX( gvSalesWhere )
		
		IF USED('FilterSQL')
			SELECT FilterSQL
			
			IF RECCOUNT('FilterSQL') < 1
		*		WAIT WINDOW 'No Records' NOWAIT
				MESSAGEBOX("No Records found, Try again",0+48,"Nothing to Display")
				THISFORM.vFiltered = .F.
			ELSE
				THISFORM.vFiltered = .T.
				ThisForm.pgfAll.pgView.grdView.RecordSource = 'FilterSQL'
				*THISFORM.RefreshView()
				ThisForm.pgfAll.pgTotals.edtvSalesWhere.Value = gvSalesWhere
				
				ThisForm.pgfAll.pgView.SETFOCUS
				ThisForm.pgfAll.pgView.grdView.SetFocus
			ENDIF
		ELSE
			WAIT WINDOW 'No Records' NOWAIT
			MESSAGEBOX('Bad SQL statement!')
			THISFORM.vFiltered = .F.
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PUBLIC aUcompany[1], aUalloy[1], aUform[1,2]
		aUcompany(1) = "Not Selected"
		aUalloy(1) = "Not Selected"
		aUform(1,1) = '00'
		aUform(1,2) = "Not Selected"
		*ThisForm.pgfAll.pgView.pgfSOitem.pgPackingSlip.grdPackingslip.RecordSource = "SELECT PackingSli,pcs,descript,Packedweight,po_num,Heat,weight,alloy FROM PackingSlip WHERE PackingSlip.SOitem = Sales.SOItem INTO CURSOR tmpPackingSlip"
		PUBLIC gnSales,gnCost,gnProfit,gnAveSale,gnAveCost,gnOrdereItems,gnPounds,gcSalesSalesP
		PUBLIC gvSalesWhere
		gvSalesWhere = ""
		
		*ThisForm.pgfAll.pgView.grdView.RecordSource="FilterSQL"
		
		*ThisForm.ViewAll(1)
		
		ThisForm.pgfAll.pgSearch.chkAlloy.Value = 1
		ThisForm.pgfAll.pgSearch.chkAlloy.Valid()
		
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_QUOTES ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		PUBLIC close_PackingSlip_NO,close_ShipAddr,close_SoldAddr,close_PackingSlip,close_Sales,close_AllQuotes,close_Ship,close_Sales_No
		close_PackingSlip_NO = .F.
		close_ShipAddr		= .F.
		close_SoldAddr		= .F.
		close_PackingSlip	= .F.
		close_Sales			= .F.
		close_Sales_No			= .F.
		close_AllQuotes		= .F.
		close_Ship			= .F.
		
		STORE get_SQLSTRINGCONNECT() TO ThisForm.nConnHandle
		
		PUBLIC aCompany_AllquotesSales[1]
		aCompany_AllquotesSales(1) = " "
		PUBLIC aEmployees[1]
		aEmployees(1) = ""
		
		IF USED('FilterSQL')
			USE IN FilterSQL
		ENDIF
		SELECT 0
			cSQL = "SELECT TOP 1 Alloy, Form, Thck "
			cSQL = cSQL +",YEAR(ShipDate) AS ShipYear"
			cSQL = cSQL +",0 AS [m01],0 AS [m02],0 AS [m03],0 AS [m04],0 AS [m05],0 AS [m06],0 AS [m07],0 AS [m08],0 AS [m09],0 AS [m10],0 AS [m11],0 AS [m12]"
			cSQL = cSQL +" FROM dbo.AllQuotes "
			cSQL = cSQL +" WHERE 0=0 "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSQL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSQL')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSQL")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSQL")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'FilterSQL')
		ENDIF
		
		
	ENDPROC

	PROCEDURE refreshview		&& Refresh View tab after SO row changes
	ENDPROC

	PROCEDURE Resize
		nNewHeight = This.Height - 443
		nNewWidth = This.Width - 648
		
		IF nNewHeight > 0
			ThisForm.pgfAll.Height = 432 + nNewHeight
			ThisForm.pgfAll.pgView.grdView.Height = 348 + nNewHeight
		ELSE
			ThisForm.pgfAll.Height = 432
			ThisForm.pgfAll.pgView.grdView.Height = 348
		ENDIF
		
		IF nNewWidth > 0
			ThisForm.pgfAll.Width = 636 + nNewWidth 
			ThisForm.pgfAll.pgView.grdView.Width = 588 + nNewWidth 
		ELSE
			ThisForm.pgfAll.Width = 636
			ThisForm.pgfAll.pgView.grdView.Width = 588
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

