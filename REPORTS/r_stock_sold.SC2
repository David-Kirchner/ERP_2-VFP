	PROCEDURE pgfAll.pgSearch.chkAlloy.Valid
		IF This.Value = 1
		
			This.Parent.cmbAlloy.ColumnCount = 0
			This.Parent.cmbAlloy.RowSourceType = 0
		
		
			IF USED('dAlloySales')
				USE IN dAlloySales
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT DISTINCT Alloy FROM dbo.Allquotes "
			cSQL = cSQL + " WHERE LEN(SoItem)>0 "
			cSQL = cSQL + " AND LEN(Alloy)>0 "
			cSQL = cSQL + " AND YEAR(ShipDate) >= YEAR(GETDATE())-2"
		*!*		IF THIS.PARENT.cmbYear.VALUE = "Not"
		*!*			cSQL = cSQL + " AND ( Sales.Shipped=>'01/01/2000' )"
		*!*		ELSE
				*SELECT DISTINCT Allquotes.Alloy FROM HPA!Sales LEFT OUTER JOIN hpa!allquotes 
				*ON Sales.soitem = Allquotes.soitem WHERE !EMPTY(Sales.SoItem) AND !EMPTY(Allquotes.Alloy) 
				*AND YEAR(Sales.Shipped)=VAL(THIS.PARENT.cmbYear.VALUE) ORDER BY AllQuotes.Alloy INTO ARRAY aUalloy
		*!*			vYear = THIS.PARENT.cmbYear.VALUE
		*!*			IF VARTYPE(vYear) = "C"
		*!*				cYear = vYear
		*!*			ELSE
		*!*				IF VARTYPE(vYear) = "N"
		*!*					cYear = STR(vYear)
		*!*				ELSE
		*!*					cYear = STR(YEAR(DATE()))
		*!*				ENDIF
		*!*			ENDIF
		*!*			cSQL = cSQL + " AND YEAR(Sales.Shipped)='"+cYear+"'"
		*!*		ENDIF
			cSQL = cSQL + " ORDER BY AllQuotes.Alloy "
			
			WAIT WINDOW 'Selecting Alloys' NOWAIT
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'dAlloySales')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'dAlloySales')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "dAlloySales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "dAlloySales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'dAlloySales')
			ENDIF
			IF USED('dAlloySales')
				SELECT DISTINCT Alloy FROM dAlloySales ORDER BY Alloy INTO ARRAY aUalloy
				USE IN dAlloySales
			ENDIF
			WAIT CLEAR
		
			This.Parent.cmbAlloy.RowSource = "aUalloy"
			This.Parent.cmbAlloy.RowSourceType = 5
			This.Parent.cmbAlloy.NumberOfElements =ALEN(aUalloy)
			This.Parent.cmbAlloy.ColumnCount = 1
			This.Parent.cmbAlloy.ColumnWidths = "50"
			This.Parent.cmbAlloy.Value = aUalloy(1)
			This.Parent.cmbAlloy.Enabled = .T.
		ELSE
			This.Parent.cmbAlloy.Enabled = .F.
			DIMENSION aUalloy[1]
			aUalloy(1) = "Not Selected"
		
		ENDIF
		ThisForm.vFiltered= .F.
	ENDPROC

	PROCEDURE pgfAll.pgSearch.chkForm.Click
		IF This.Value = 1
		
			This.Parent.cmbForm.ColumnCount = 0
			This.Parent.cmbForm.RowSourceType = 0
		
		
			IF USED('dAlloySales')
				USE IN tmpForm
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT DISTINCT FormNumber, FormDescription FROM dbo.Forms "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpForm')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpForm')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpForm")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpForm")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpForm')
			ENDIF
			IF USED('tmpForm')
				SELECT FormNumber, FormDescription FROM tmpForm ORDER BY FormNumber INTO ARRAY aUform
				USE IN tmpForm
			ENDIF
			
			This.Parent.cmbForm.RowSource = "aUform"
			This.Parent.cmbForm.RowSourceType = 5
			This.Parent.cmbForm.NumberOfElements =ALEN(aUform,1)
		*	This.Parent.cmbForm.ColumnCount = 1
			This.Parent.cmbForm.ColumnCount = 2
			This.Parent.cmbForm.ColumnWidths = "50"
		*	This.Parent.cmbForm.Value = aUform(1)
			This.Parent.cmbForm.Value = aUform(1,1)
			This.Parent.cmbForm.Enabled = .T.
		ELSE
			This.Parent.cmbForm.Enabled = .F.
			DIMENSION aUform[1]
			aUform(1) = "Not Selected"
		
		ENDIF
		ThisForm.vFiltered= .F.
	ENDPROC

	PROCEDURE pgfAll.pgSearch.cmbAllEmployees.Init
		LOCAL cSalesP, nLoopCount
		
		this.clear
		IF USED('tmpSalesPInit')
			USE IN tmpSalesPInit
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT SalesRep AS UN,dbo.SalesPInit(SalesRep) AS ANS"
		cSQL = cSQL+" FROM dbo.Sales_No WITH(NOLOCK)"
		cSQL = cSQL+" WHERE LEN( ISNULL(SalesRep,' ') )> 1"
		cSQL = cSQL+" GROUP BY SalesRep"
		cSQL = cSQL+" ORDER BY COUNT(*) DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesPInit')
		ENDIF
		
		IF USED('tmpSalesPInit')
		
			SELECT Un, Ans FROM tmpSalesPInit INTO ARRAY aEmployees
		
			This.ColumnCount =ALEN(aEmployees,2)
			This.NumberOfElements=ALEN(aEmployees)
			This.BoundColumn = 2
			This.ColumnWidths = "115,20"
		
		
			this.addListitem("(All Employees)",1,1)
			this.addListitem("*",1,2)
			nLoopCount = 1
		
			FOR EACH m.cSalesP IN aEmployees
				IF !EMPTY(m.cSalesP)
					IF LEN(ALLTRIM(m.cSalesP)) > 1
						nLoopCount = nLoopCount + 1
						this.addListitem(ALLTRIM(m.cSalesP),nLoopCount,1)
					ELSE
						this.addListitem(ALLTRIM(m.cSalesP),nLoopCount,2)
					ENDIF
				ENDIF
			ENDFOR
		
			This.Value = "*"
			
			USE IN tmpSalesPInit
		ENDIF
		
	ENDPROC

	PROCEDURE pgfAll.pgSearch.cmbAllEmployees.InteractiveChange
		ThisForm.vFiltered= .F.
	ENDPROC

	PROCEDURE pgfAll.pgSearch.cmbAlloy.InteractiveChange
		ThisForm.vFiltered= .F.
	ENDPROC

	PROCEDURE pgfAll.pgSearch.cmbForm.Init
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpForm")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpForm")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		this.clear
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)+1
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		this.addListitem("(All)",1,1)
		this.addListitem("All Forms",1,2)
			
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I+1,1)
			this.addListitem(aFormCode(I, 2),I+1,2)
		ENDFOR
	ENDPROC

	PROCEDURE pgfAll.pgSearch.cmbForm.InteractiveChange
		ThisForm.vFiltered= .F.
	ENDPROC

