		cSQL = "SELECT SalesRep AS UN,dbo.SalesPInit(SalesRep) AS ANS"
		cSQL = cSQL+" FROM dbo.Sales_No WITH(NOLOCK)"
		cSQL = cSQL+" WHERE LEN( ISNULL(SalesRep,' ') )> 1"
		cSQL = cSQL+" GROUP BY SalesRep"
		cSQL = cSQL+" ORDER BY COUNT(*) DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
