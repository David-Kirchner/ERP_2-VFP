	PROCEDURE getshoprecv
		*ThisForm.GetShopRecv()
		IF USED('tmpShopRecv')
			ThisForm.grdShopRecv.RecordSource = ''
			
			USE IN tmpShopRecv
		ENDIF
		
		
		PRIVATE cSalesP
		cSalesP = ThisForm.cmbAllEmployees.Value
		PRIVATE lReceived, lPrinted, lShipOn, lChanging
		lReceived	= IIF( ThisForm.chkReceived.Value=1, .T., .F.)
		lPrinted	= IIF( ThisForm.chkPrinted.Value=1, .T., .F.)
		lShipOn		= IIF( ThisForm.chkShipOn.Value=1, .T., .F.)
		lChanging	= IIF( ThisForm.chkChanging.Value=1, .T., .F.)
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT SN.SalesNum"
		cSQL = cSQL +", ISNULL(SN.Amendment,0) As [Amend]"
		cSQL = cSQL +", SN.SalesRep"
		cSQL = cSQL +", ISNULL(SN.ShopRecv,0) AS [Recv]"
		cSQL = cSQL +", ISNULL(SN.PrintedSO,0) As [Prnt] "
		cSQL = cSQL +", ISNULL(SN.Changing,0) As [Chng] "
		cSQL = cSQL + " , (SELECT TOP 1 Company FROM dbo.AllQuotes Q WHERE Q.SalesNum = SN.SalesNum ) AS [Company] "
		cSQL = cSQL + " , CONVERT(CHAR(10),(SELECT TOP 1 SaleDate FROM dbo.AllQuotes Q WHERE Q.SalesNum = SN.SalesNum ),101) AS [SaleDate] "
		cSQL = cSQL + " , CONVERT(CHAR(10),(SELECT TOP 1 S.ShipDue FROM dbo.Sales S WHERE S.SalesNum = SN.SalesNum ),101) AS [ShipDate]"
		cSQL = cSQL + " , CONVERT(CHAR(10),(SELECT TOP 1 S.ShipDue FROM dbo.Sales S WHERE S.SalesNum = SN.SalesNum AND ISNULL(ShipOn,0) = 1),101) AS [ShipONDate]"
		
		
		cSQL = cSQL + " FROM dbo.Sales_No SN "
		IF lReceived 
			cSQL = cSQL + " WHERE ISNULL(SN.ShopRecv,0) = 1 "
		ELSE
			cSQL = cSQL + " WHERE ISNULL(SN.ShopRecv,0) = 0 "
		ENDIF
		IF lPrinted 
			cSQL = cSQL + " AND ISNULL(SN.PrintedSO,0) = 1 "
		ELSE
			cSQL = cSQL + " AND ISNULL(SN.PrintedSO,0) = 0 "
		ENDIF
		IF lChanging
			cSQL = cSQL + " AND ISNULL(SN.Changing,0) = 1 "
		ELSE
			cSQL = cSQL + " AND ISNULL(SN.Changing,0) = 0 "
		ENDIF
		IF lShipOn
		*	cSQL = cSQL + " OR NOT IS NULL ShipONDate"
		ENDIF
		
		IF cSalesP <> "(All Employees)" &&"*"
			cSQL = cSQL + " AND SN.SalesRep = '"+cSalesP+"'"
		ENDIF
		
		cSQL = cSQL + " AND ISNULL(SN.Cncld,0) = 0 "
		cSQL = cSQL + " AND ISNULL(SN.Cmplt,0) = 0 "
		cSQL = cSQL + " ORDER BY SN.SalesNum"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShopRecv')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShopRecv')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShopRecv")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShopRecv")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShopRecv')
		ENDIF
		IF USED('tmpShopRecv')
			IF VARTYPE(tmpShopRecv.SalesNum) = "N"
				ThisForm.grdShopRecv.RecordSource = 'tmpShopRecv'
				*ShopOnDate White or Yellow
				ThisForm.grdShopRecv.Column1.DynamicBackColor = "IIF(ISNULL(ShipONDate),RGB(255,255,255),RGB(255,255,0))"
				*Shipdate Red or Green
				ThisForm.grdShopRecv.Column9.DynamicBackColor = "IIF(CTOD(ShipDate)<DATE(),RGB(255,0,0),RGB(128,255,128))"
			ENDIF
		ENDIF
		
		IF lReceived 
			IF lPrinted 
				IF lShipOn
					This.Caption = "Shop Received and Printed Report"
				ELSE
					This.Caption = "Shop Received and Printed Report"
				ENDIF
			ELSE
				IF lShipOn
					This.Caption = "Shop Received and NOT Printed Report"
				ELSE
					This.Caption = "Shop Received and NOT Printed Report"
				ENDIF
			ENDIF
		ELSE
			IF lPrinted 
				IF lShipOn
					This.Caption = "Shop NOT Received and Printed Report"
				ELSE
					This.Caption = "Shop NOT Received and Printed Report"
				ENDIF
			ELSE
				IF lShipOn
					This.Caption = "Shop NOT Received and NOT Printed Report"
				ELSE
					This.Caption = "Shop NOT Received and NOT Printed Report"
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pSalesP
		
		IF VARTYPE(pSalesP) != "C"
			pSalesP = ""
		ENDIF
		IF NOT EMPTY( pSalesP )
			PRIVATE cSalesPD 
			cSalesPD = SalesPDescription(pSalesP,'')
			IF NOT EMPTY( cSalesPD )
				ThisForm.cmbAllEmployees.Value = cSalesPD 
			ENDIF
		ENDIF
		
		PUBLIC aEmployees[1]
		aEmployees(1) = ""
		
		
		ThisForm.GetShopRecv()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_Setup" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE Resize
		nNewH = This.Height - 253
		nNewW = This.Width - 770 &&692
		
		ThisForm.grdShopRecv.Height = 201 + nNewH
		ThisForm.lblShipOn.Top = 204 +nNewH
		ThisForm.lblLate.Top = 204 +nNewH
		ThisForm.lblSalesPerson.Top = 222 + nNewH
		ThisForm.cmbAllEmployees.Top = 219 + nNewH
		ThisForm.chkReceived.Top = 224 + nNewH
		ThisForm.chkPrinted.Top = 224 + nNewH
		ThisForm.chkChanging.Top = 224 + nNewH
		ThisForm.chkShipOn.Top = 224 + nNewH
		ThisForm.cmdRefresh.Top = 219 + nNewH
		ThisForm.cmdQuit.Top = 219 + nNewH
		
		ThisForm.grdShopRecv.Width = 764 + nNewW   &&684
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpShopRecv')
			USE IN tmpShopRecv
		ENDIF
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

