	PROCEDURE backcolor_grdmv
		*ThisForm.BackColor_grdMV()
		PRIVATE nVer, cVer
		cVer = tmpMachVersion.Ans
		nVer = VAL(LEFT(cVer ,AT(".",cVer )))*10000000 +VAL(RIGHT(cVer ,LEN(cVer )-AT(".",cVer )))*10000
		IF nVer < ThisForm.nLastVersion
			nDiff = ThisForm.nLastVersion - nVer 
			IF nDiff > 240
				nDiff = 240
			ENDIF
			nColor = 240 - nDiff
			nRGBColor = RGB(255,(nColor),(240-nColor))
			RETURN nRGBColor
		ELSE
			RETURN RGB(255,255,255)
		ENDIF
		
			
			
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		PUBLIC cMachineName
		PRIVATE cVersion, cCaption, nVersion, naVersion
		cVersion = ' '
		cCaption = ' '
		nVersion = 0
		PRIVATE cMach_User, cUserName, cMach
		cMach_User = SYS(0)
		cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		cMach = LEFT( cMach_User, AT("#",cMach_User)-2 )
		
		
		PRIVATE nArraySize, aArrayName, cHPAFile
		nArraySize = 0
		DIMENSION aArrayName(1, 1)
		aArrayName(1, 1) = ''
		IF FILE("C:\Program Files (x86)\HPA\ERP.EXE")
			nArraySize = aGETFILEVERSION(aArrayName, "C:\Program Files (x86)\HPA\ERP.EXE")
		ELSE
			IF FILE("C:\Program Files\HPA\ERP.EXE")
				nArraySize = aGETFILEVERSION(aArrayName, "C:\Program Files\HPA\ERP.EXE")
			ELSE
				IF FILE("ERP.EXE")
					nArraySize = aGETFILEVERSION(aArrayName, "ERP.EXE")
				ELSE
					cHPAFile = ALLTRIM(HOME())+"ERP.EXE"
					IF FILE(cHPAFile)
						nArraySize = aGETFILEVERSION(aArrayName, cHPAFile)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF nArraySize > 0
			cVersion = aArrayName(1, 4)
			nVersion  = VAL(LEFT(cVersion,AT(".",cVersion)))*10000000 +VAL(RIGHT(cVersion,LEN(cVersion)-AT(".",cVersion)))*10000
			naVersion  = VAL(LEFT(cVersion,AT(".",cVersion)))*10000000 +INT(VAL(RIGHT(cVersion,LEN(cVersion)-AT(".",cVersion))))*10000+VAL(RIGHT(cVersion,LEN(cVersion)-AT(".",cVersion,2 )))
			cCaption = "Your version "+cVersion
		ELSE
			* No ERP.EXE — development .APP or missing install
			cVersion = ''
			nVersion  = 0
			naVersion  = 0
			cCaption = "Development (.APP) "+DTOC(DATE())
		ENDIF
		
		ThisForm.lblVersion.Caption = cCaption 
		
		PRIVATE cLastVersion, nLastVersion, naLastVersion
		cLastVersion = AppSetup_get_LatestVersion()
		nLastVersion = 0
		naLastVersion = 0
		IF !EMPTY(ALLTRIM(cLastVersion)) AND "." $ cLastVersion
			nLastVersion = VAL(LEFT(cLastVersion,AT(".",cLastVersion)))*10000000 +VAL(RIGHT(cLastVersion,LEN(cLastVersion)-AT(".",cLastVersion)))*10000
			naLastVersion = VAL(LEFT(cLastVersion,AT(".",cLastVersion)))*10000000 +INT(VAL(RIGHT(cLastVersion,LEN(cLastVersion)-AT(".",cLastVersion))))*10000+VAL(RIGHT(cLastVersion,LEN(cLastVersion)-AT(".",cLastVersion,2 )))
		ENDIF
		ThisForm.nLastVersion  = nLastVersion 
		
		IF naLastVersion > naVersion  
			cCaption = "Version "+cVersion+" of "+cLastVersion 
		ELSE
			IF naLastVersion = naVersion 
				cCaption = "Latest version "+cVersion+" current!"
			ELSE
				*nLastVersion < nVersion
				cCaption = "Version "+cVersion+" current!"
			ENDIF
			ThisForm.lblLatest.Caption = cCaption
		ENDIF
		
		IF USED('tmpMachVersion')
			USE IN tmpMachVersion
		ENDIF
		
		ThisForm.lblMinVer.Caption = "Minimum version "+AppSetup_get_MinVersion()
		
		ThisForm.RefreshSetup() &&tmpMachVersion
		
		ThisForm.grdMV.RecordSource = "tmpMachVersion"
		
		*ThisForm.MachVersionChange()
		
		
		IF RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )= "David Kirchner"
			ThisForm.cmdDelete.Visible = .T.
			ThisForm.cmdMinimum.Visible = .T.
			ThisForm.lblMinVerNote.Visible = .T.
		ENDIF
		ThisForm.grdMV.SetFocus
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_Setup" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		
	ENDPROC

	PROCEDURE machversionchange
		*ThisForm.MachVersionChange()
		
		*PRIVATE cMachineName
		IF USED('tmpMachVersion')
			cMachineName = ALLTRIM(tmpMachVersion.UN)
		ELSE
			cMachineName = ''
		ENDIF
		
		IF USED('tmpUserName')
			ThisForm.grdUser.RecordSource = ''
			USE IN tmpUserName
		ENDIF
		SELECT 0
		
		
		IF VARTYPE(cMachineName) = "C"
			IF NOT EMPTY(cMachineName)
				*cUN = AppSetup_Get_UserName_from_Machine(cMachineName)
				IF AppSetup_IS_UserName_IN_Table_for_Machine(cMachineName)
					SELECT UN FROM tmpUserNameTable INTO CURSOR tmpUserName
				ELSE
					CREATE CURSOR tmpUserName (UN CHAR(10))
					INSERT INTO tmpUserName (UN) VALUES (SPACE(10))
					*SELECT SPACE(10) AS UN FROM tmpTable WHERE 0>0 INTO CURSOR tmpUserName
				ENDIF
			ELSE
				CREATE CURSOR tmpUserName (UN CHAR(10))
				INSERT INTO tmpUserName (UN) VALUES (SPACE(10))
				*SELECT SPACE(10) AS UN FROM tmpTable WHERE 0>0 INTO CURSOR tmpUserName
			ENDIF
		ELSE
			CREATE CURSOR tmpUserName (UN CHAR(10))
			INSERT INTO tmpUserName (UN) VALUES (SPACE(10))
			*SELECT SPACE(10) AS UN FROM tmpTable WHERE 0>0 INTO CURSOR tmpUserName
		ENDIF
		
		ThisForm.grdUser.RecordSource = 'tmpUserName'
		
		IF USED('tmpUserNameTable')
			USE IN tmpUserNameTable 
			
			SELECT tmpMachVersion
		ENDIF
		
	ENDPROC

	PROCEDURE refreshsetup
		*ThisForm.RefreshSetup()
		
		PRIVATE nConn, lReturn
		nConn = get_SQLSTRINGCONNECT()
		lReturn = .F.
		PRIVATE cSQL, nSQLEXEC
		
		
		
		IF USED('tmpSetup')
			USE IN tmpSetup
		ENDIF
		SELECT 0
		
		*use this to clean out old records
		*DELETE FROM dbo.AppSetup WHERE [PRP] = 'Version' AND [UN]!='Latest' AND ANS like '3.0.%'
		
		IF nConn > 0
			cSQL = "SELECT [ANS],[UN] FROM dbo.AppSetup WITH(NOLOCK) WHERE ( [PRP] = 'Version' or [PRP] = 'VersionNew' ) AND [UN]!='Latest'"
			
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpSetup' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpSetup' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSetup")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSetup")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,nConn, nSQLEXEC, 'tmpSetup')
			ENDIF
			
			IF USED('tmpSetup')
				
				SELECT UN,Ans,VAL(LEFT(Ans,AT(".",Ans)))*10000000 +INT(VAL(RIGHT(Ans,LEN(Ans)-AT(".",Ans))))*10000+VAL(RIGHT(Ans,LEN(Ans)-AT(".",Ans,2 ))) AS nVersion FROM tmpSetup INTO CURSOR tmpMachVersion ORDER BY nVersion DESC
		
				USE IN tmpSetup
			ENDIF
			
			SQLDISCONNECT( nConn )
		
		ENDIF
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDeltaH
		nDeltaH = This.Height - 393
		ThisForm.grdMV.Height = 372 + nDeltaH
	ENDPROC

	PROCEDURE Unload
		IF USED('Setup')
			USE IN SETUP
		ENDIF
		
		IF USED('tmpMachVersion')
			USE IN tmpMachVersion
		ENDIF
		
		IF USED('tmpUserName')
			USE IN tmpUserName
		ENDIF
	ENDPROC

	PROCEDURE cmdDelete.Click
		PRIVATE cComputerName
		cComputerName = ALLTRIM(tmpMachVersion.UN)
		
		IF cComputerName = "Newest" OR cComputerName = "Minumum"
			MESSAGEBOX("Cannot Delete '"+cComputerName+"' ?",4+48,"Delete failed")
			RETURN
		ENDIF
		
		IF MESSAGEBOX("Are you Sure you want to Delete '"+cComputerName+"' ?",4+48,"Delete?") = 6
			PRIVATE nConn, lReturn
			nConn = get_SQLSTRINGCONNECT()
		
			PRIVATE cSQL, nSQLEXEC
			
			cSQL = "DELETE FROM dbo.AppSetup "
			cSQL = cSQL +" WHERE ( [PRP] = 'Version' or [PRP] = 'VersionNew' ) "
			cSQL = cSQL +" AND [UN] = '"+cComputerName+"'"
			
			nSQLEXEC = SQLEXEC(nConn, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(nConn, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC)
			ENDIF
			
			ThisForm.grdMV.RecordSource = ""
			IF USED('tmpMachVersion')
				USE IN tmpMachVersion
			ENDIF
			
			IF USED('tmpSetup')
				USE IN tmpSetup
			ENDIF
			SELECT 0
		
			IF nConn > 0
				*cSQL = "SELECT [ANS],[UN] FROM dbo.AppSetup WITH(NOLOCK) WHERE [PRP] = 'Version' AND [UN]!='Latest'"
				cSQL = "SELECT [ANS],[UN] FROM dbo.AppSetup WITH(NOLOCK) WHERE ( [PRP] = 'Version' or [PRP] = 'VersionNew' ) AND [UN]!='Latest'"
				
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpSetup' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpSetup' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSetup")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSetup")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,nConn, nSQLEXEC, 'tmpSetup')
				ENDIF
				
				IF USED('tmpSetup')
					
					SELECT UN,Ans,VAL(LEFT(Ans,AT(".",Ans)))*10000000 +INT(VAL(RIGHT(Ans,LEN(Ans)-AT(".",Ans))))*10000+VAL(RIGHT(Ans,LEN(Ans)-AT(".",Ans,2 ))) AS nVersion FROM tmpSetup INTO CURSOR tmpMachVersion ORDER BY nVersion DESC
		
					USE IN tmpSetup
				ENDIF
				
				SQLDISCONNECT( nConn )
		
			ENDIF
		
		
			ThisForm.grdMV.RecordSource = "tmpMachVersion"
			ThisForm.grdMV.Refresh
			
			ThisForm.MachVersionChange()
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdMinimum.Click
		PRIVATE nConn, lReturn
		nConn = get_SQLSTRINGCONNECT()
		
		IF USED('tmpSetMin')
			USE IN 'tmpSetMin'
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		
		IF This.Caption = 'Edit Minimum'
		
			cSQL = "SELECT ANS, ID FROM dbo.AppSetup "
			cSQL = cSQL +" WHERE UN = 'Minimum' AND PRP='Version' "
		
			SELECT 0
			nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSetMin")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSetMin")
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSetMin")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpSetMin")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC,"tmpSetMin")
			ENDIF
		
			IF USED('tmpSetMin')
				ThisForm.txtMinEntry.Visible = .T.
				ThisForm.txtMinEntry.Value = tmpSetMin.ANS
				ThisForm.nID = tmpSetMin.ID
				
				USE IN tmpSetMin
				
				This.Caption = 'SAVE'
			ENDIF
		ELSE
			*This.Caption = 'SAVE'
			PRIVATE cMinEntry
			cMinEntry = ALLTRIM(ThisForm.txtMinEntry.Value)
			
			cSQL = "UPDATE dbo.AppSetup "
			cSQL = cSQL +" SET [ANS]='"+cMinEntry +"'"
			cSQL = cSQL +" WHERE ID="+STR(ThisForm.nID)
			
			nSQLEXEC = SQLEXEC(nConn, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConn, cSQL, "")
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(nConn, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC,"")
			ENDIF
			
			This.Caption = 'Edit Minimum'
			ThisForm.txtMinEntry.Visible = .F.
			
			ThisForm.grdMV.RecordSource = ""
			ThisForm.RefreshSetup()
			
			ThisForm.grdMV.RecordSource = "tmpMachVersion"
			*ThisForm.grdMV.SetFocus
			
			SELECT tmpMachVersion
			LOCATE FOR UN = 'Minimum'
			
			ThisForm.grdMV.Refresh
			ThisForm.MachVersionChange()
			
		ENDIF
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE grdMV.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.MachVersionChange()
	ENDPROC

	PROCEDURE lblLatest.Click
		MESSAGEBOX("UPDATE dbo.AppSetup SET [Ans] = '3.1.1' WHERE [Prp] = 'Version' AND [UN] = 'Minimum'",64,"SQL")
	ENDPROC

	PROCEDURE lblMinVer.Click
		MESSAGEBOX("UPDATE dbo.AppSetup SET [Ans] = '3.1.1' WHERE [Prp] = 'Version' AND [UN] = 'Minimum'",64,"SQL")
	ENDPROC

ENDDEFINE
