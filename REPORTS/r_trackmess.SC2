	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnection = get_SQLSTRINGCONNECT()
		
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT TOP 1000 * FROM dbo.NR_UserTrack WHERE ErrorDate > '"+DTOC( DATE()-60)+"'"
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnection, cSQL, 'UserTrack' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnection, cSQL, 'UserTrack' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "UserTrack")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "UserTrack")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnection, nSQLEXEC, 'UserTrack' )
		ENDIF
		
		
		
		SELECT UserTrack
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('UserTrack')
			USE IN UserTrack
		ENDIF
		
		SQLDISCONNECT( ThisForm.nConnection )
	ENDPROC

	PROCEDURE Command1.Click
		SELECT UserTrack
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.NR_UserTrack "
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnection, cSQL, 'UserTrack' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnection, cSQL, 'UserTrack' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "UserTrack")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "UserTrack")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnection, nSQLEXEC, 'UserTrack' )
		ENDIF
		
		
		
		SELECT UserTrack
		
		
	ENDPROC

	PROCEDURE Txtbtns1.CMDPRINT.Click
		REPORT FORM Reports\r_TrackMess PREVIEW NOWAIT
		
		IF THISFORM.ShowWindow = 2 
			Activate Window (THISFORM.Name)
		ENDIF
		
	ENDPROC

