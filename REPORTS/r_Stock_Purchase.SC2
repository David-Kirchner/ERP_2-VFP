DEFINE CLASS frmr_stock_purchase AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdQuit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdStartReport" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label3" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Stock Purchase"
		DoCreate = .T.
		Height = 424
		Left = 15
		Name = "frmR_Stock_Purchase"
		nconnhandle = 0
		Top = 14
		Width = 631
	*</PropValue>

	ADD OBJECT 'cmdQuit' AS commandbutton WITH ;
		BackColor = 255,128,128, ;
		Caption = "Quit", ;
		Height = 27, ;
		Left = 516, ;
		Name = "cmdQuit", ;
		Top = 384, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdStartReport' AS commandbutton WITH ;
		BackColor = 128,255,128, ;
		Caption = "Report", ;
		Height = 27, ;
		Left = 408, ;
		Name = "cmdStartReport", ;
		Top = 24, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		Caption = "cAlloy = 'C-276'", ;
		Height = 17, ;
		Left = 24, ;
		Name = "Label1", ;
		Top = 36, ;
		Width = 80
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label2' AS label WITH ;
		Caption = "cForm = '10'", ;
		Height = 17, ;
		Left = 24, ;
		Name = "Label2", ;
		Top = 60, ;
		Width = 80
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label3' AS label WITH ;
		Caption = "cCC = '1'", ;
		Height = 17, ;
		Left = 24, ;
		Name = "Label3", ;
		Top = 84, ;
		Width = 80
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Init
		PRIVATE cUser
		cUser = SYS(0)
		IF "David Kirchner" $ cUser
		*	ThisForm.cmdRenameAlloy.Visible = .T.
		ENDIF
		
		*ThisForm.AlloyChanged()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		*ThisForm.LoadAlloy()
		*ThisForm.LoadAlloys()
		
		*SELECT Alloy
		*SET RELATION TO Alloy INTO Alloys
		*SET SKIP TO Alloys
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdStartReport.Click
		cAlloy = 'C-276'
		cForm = '10'
		cCC = '1'
		*All Thck
		
		PRIVATE cSQL, nSQLEXEC
		*********************************
		WAIT WINDOW 'Getting Quotes' NOWAIT
		
		IF USED('tmpQuotes')
			USE IN tmpQuotes
		ENDIF
		SELECT 0
		cSQL = "SELECT Alloy, Form, cc, CL, pieces, StandardSize AS Thck, sz2, sz3, Weight,p_lb,p_pc,p_ft,cuts"
		cSQL = cSQL + ",OtherFld,otherp,lotp,cweight,cP_lb"
		cSQL = cSQL + " ,MONTH(AQ.InqDate) AS [MNTH], YEAR(AQ.InqDate) AS [Year]"
		cSQL = cSQL + " FROM dbo.AllQuotes AQ"
		cSQL = cSQL + " WHERE AQ.Alloy = '"+cAlloy+"'"
		cSQL = cSQL + " AND AQ.Form = '"+cForm+"'"
		cSQL = cSQL + " AND AQ.CC='"+cCC+"'"
		cSQL = cSQL + " AND AQ.InqDate > GETDATE()-(365*5)"  &&5Yr
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpQuotes')
		ENDIF
		
		*********************************
		WAIT WINDOW 'Getting Sales' NOWAIT
		
		IF USED('tmpSales')
			USE IN tmpSales
		ENDIF
		SELECT 0
		cSQL = "SELECT Alloy, Form, cc, CL, pieces, StandardSize AS Thck, sz2, sz3, Weight,p_lb,p_pc,p_ft,cuts"
		cSQL = cSQL + ",OtherFld,otherp,lotp,cweight,cP_lb"
		cSQL = cSQL + " ,MONTH(AQ.SaleDate) AS [MNTH], YEAR(AQ.SaleDate) AS [Year]"
		cSQL = cSQL + ",Sales.ItemCost,Sales.ItemSale,Sales.GS_Cost,Sales.GS_Sale"
		cSQL = cSQL + ",Sales.Quoted_QTY,Sales.Quoted_P,Sales.Quoted_Total,Sales.Quoted_PU"
		cSQL = cSQL + " FROM dbo.AllQuotes AQ"
		cSQL = cSQL + " JOIN dbo.Sales ON Sales.SOitem = AQ.SOitem"
		cSQL = cSQL + " WHERE AQ.Alloy = '"+cAlloy+"'"
		cSQL = cSQL + " AND AQ.Form = '"+cForm+"'"
		cSQL = cSQL + " AND AQ.CC='"+cCC+"'"
		cSQL = cSQL + " AND AQ.SaleDate > GETDATE()-(365*5)"  &&5Yr
		cSQL = cSQL + " AND Sales.cncld = 0"
		cSQL = cSQL + " AND Sales.cmplt = 1"
		
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSales')
		ENDIF
		*********************************
		
		
		WAIT WINDOW 'Getting Stock levels' NOWAIT
		
		IF USED('tmpStockLst_Level')
			USE IN tmpStockLst_Level
		ENDIF
		SELECT 0
		cSQL = "SELECT "
		cSQL = cSQL + " ST.Alloy"
		cSQL = cSQL + " ,ST.Form "
		cSQL = cSQL + " ,ST.CC"
		cSQL = cSQL + " ,ST.CL"
		cSQL = cSQL + " ,ST.Size"
		cSQL = cSQL + " ,ISNULL(AVG(ST.MWeight),0) AS Stock"
		cSQL = cSQL + " ,ISNULL(AVG(ST.TotalCost),0) AS [Value]"
		cSQL = cSQL + " ,ST.Year"
		cSQL = cSQL + " ,ST.Mnth"
		cSQL = cSQL + " FROM dbo.NR_StockLst_Totals ST"
		cSQL = cSQL + " WHERE ST.Alloy = '"+cAlloy+"'"
		cSQL = cSQL + " 	AND ST.Form = '"+cForm+"'"
		cSQL = cSQL + " 	AND ST.CC = '"+cCC+"'"
		cSQL = cSQL + " 	AND ST.Year >= YEAR(GETDATE()- (365*3))"
		cSQL = cSQL + " Group by ST.Alloy,ST.Form,ST.CC,ST.Size,ST.Year,ST.Mnth"
		cSQL = cSQL + " ORDER BY Year DESC, Mnth DESC "
		
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_Level')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_Level')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Level")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Level")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Level')
		ENDIF
		
		
		************************
		
		WAIT WINDOW 'Getting Current Stock' NOWAIT
		
		IF USED('tmpCurrentStock')
			USE IN tmpCurrentStock
		ENDIF
		SELECT 0
		
		cSQL = "SELECT "
		cSQL = cSQL + "  SM.Alloy"
		cSQL = cSQL + "  ,SM.Form "
		cSQL = cSQL + "  ,SM.CC"
		cSQL = cSQL + "  ,SM.CL"
		cSQL = cSQL + "  ,dbo.f_SizeStandard(SM.Size) AS Thck"
		cSQL = cSQL + "  ,SM.MWeight"
		cSQL = cSQL + "  ,SM.Heat"
		cSQL = cSQL + "  ,SM.Paid"
		cSQL = cSQL + "  ,SM.po_item"
		cSQL = cSQL + "  ,SM.ID"
		cSQL = cSQL + "   FROM dbo.StockLst_Master SM"
		cSQL = cSQL + "    WHERE SM.Alloy = '"+cAlloy+"'"
		cSQL = cSQL + "     AND SM.Form = '"+cForm+"'"
		cSQL = cSQL + "     AND SM.CC = '"+cCC+"'"
		cSQL = cSQL + "     AND SM.MWeight > 0"
		
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCurrentStock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'tmpCurrentStock')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCurrentStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCurrentStock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCurrentStock')
		ENDIF
		
		************************
		
		WAIT WINDOW 'Getting Incoming Stock' NOWAIT
		
		IF USED('tmpIncomingStock')
			USE IN tmpIncomingStock
		ENDIF
		SELECT 0
		
		cSQL = "SELECT POitem,Company, order_qty, First_Due_Max,Alloy,Form,CC,CL,dbo.f_SizeStandard(thck) AS Thck"
		cSQL = cSQL + " FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE Alloy = '"+cAlloy+"'"
		cSQL = cSQL + " AND Form = '"+cForm+"'"
		cSQL = cSQL + " AND CC='"+cCC+"'"
		cSQL = cSQL + " AND (due_min > GETDATE() OR due_max > GETDATE() )"
		cSQL = cSQL + " AND ISNULL(cancelled,0) = 0 "
		cSQL = cSQL + " AND ISNULL(delivered,0) = 0 "
		cSQL = cSQL + " AND ISNULL(Services,0) = 0"
		
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpIncomingStock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'tmpIncomingStock')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpIncomingStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpIncomingStock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpIncomingStock')
		ENDIF
		
		************************
		
		IF USED('tmpReport')
			USE IN tmpReport
		ENDIF
		IF USED('tmpDistinctReport')
			USE IN tmpDistinctReport
		ENDIF
		
		IF "\MEM" $ SYS(2003)
			SELECT Alloy+Form+cc+STR(Thck,10,3) AS AFCT FROM tmpQuotes UNION ALL SELECT Alloy+Form+cc+STR(Thck,10,3) AS AFCT FROM tmpSales INTO TABLE (SYS(5)+SYS(2003) +"\tmpReport")
		ELSE
			SELECT Alloy+Form+cc+STR(Thck,10,3) AS AFCT FROM tmpQuotes UNION ALL SELECT Alloy+Form+cc+STR(Thck,10,3) AS AFCT FROM tmpSales INTO TABLE (SYS(5)+SYS(2003) +"\MEM\tmpReport")
		ENDIF
		
		SELECT 0
		
		IF RECCOUNT('tmpReport') > 0
			IF "\MEM" $ SYS(2003)
				SELECT AFCT FROM tmpReport INTO TABLE (SYS(5)+SYS(2003) +"\tmpDistinctReport") ORDER BY AFCT
			ELSE
				SELECT AFCT FROM tmpReport INTO TABLE (SYS(5)+SYS(2003) +"\MEM\tmpDistinctReport") ORDER BY AFCT
			ENDIF
		
			SELECT tmpDistinctReport
			
			PRIVATE cThck, nThck	
			SCAN
				cThck = RIGHT(tmpDistinctReport.AFCT,10)
				nThck = PrepareSQLnum(cThck,'Thck',10,3)
				SELECT 0
				SELECT * FROM tmpQuotes 	INTO TABLE (SYS(5)+SYS(2003) +"\tmpQuotesThck") 	WHERE Thck = nThck
				SELECT 0
				SELECT * FROM tmpSales 		INTO TABLE (SYS(5)+SYS(2003) +"\tmpSalesThck") 		WHERE Thck = nThck
				SELECT 0
				SELECT * FROM tmpStockLst_Level INTO TABLE (SYS(5)+SYS(2003) +"\tmpStkLvlThck") WHERE Size = nThck
				SELECT 0
				SELECT * FROM tmpCurrentStock INTO TABLE (SYS(5)+SYS(2003) +"\tmpCurStkThck") 	WHERE Thck = nThck
				SELECT 0
				SELECT * FROM tmpIncomingStock INTO TABLE (SYS(5)+SYS(2003) +"\tmpInStkThck") 	WHERE Thck = nThck
				
				*Report
				? tmpDistinctReport.AFCT
				? cThck
				REPORT FORM r_Stock_Purchase
		
		SELECT tmpQuotesThck
		SELECT tmpSalesThck
		SELECT tmpStkLvlThck
		SELECT tmpCurStkThck
		SELECT tmpInStkThck
		
		
				
				IF USED('tmpQuotesThck')
					USE IN tmpQuotesThck
				ENDIF
				IF USED('tmpSalesThck')
					USE IN tmpSalesThck
				ENDIF
				IF USED('tmpStkLvlThck')
					USE IN tmpStkLvlThck
				ENDIF
				IF USED('tmpCurStkThck')
					USE IN tmpCurStkThck
				ENDIF
				IF USED('tmpInStkThck')
					USE IN tmpInStkThck
				ENDIF
				
				SELECT tmpDistinctReport
			ENDSCAN
		ENDIF
		
		
		********************
		
		
		*tmpQuotes			5yr
		*SELECT tmpQuotes
		*BROWSE
		
		*tmpSales 			5yr
		*SELECT tmpSales
		*BROWSE 
		
		*tmpStockLst_Level	3yr
		*SELECT tmpStockLst_Level
		*BROWSE
		
		*tmpCurrentStock
		*SELECT tmpCurrentStock
		*BROWSE
		
		*tmpIncomingStock
		*SELECT tmpIncomingStock
		*BROWSE
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
	ENDPROC

ENDDEFINE
