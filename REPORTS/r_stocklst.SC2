			REPORT FORM reports\r_StockAlloyBar.frx FOR !DELETED() PREVIEW
		ENDIF
		
		IF USED('tmpAlloyBarSum')
			USE IN tmpAlloyBarSum
		ENDIF
		
	ENDPROC

	PROCEDURE cmdShowPlateStock.Click
		ThisForm.GetAlloyPlateData()
		
		IF USED('tmpAlloyPlateSum')
			SELECT tmpAlloyPlateSum
			REPORT FORM reports\r_StockAlloyPlate.frx FOR !DELETED() PREVIEW
		ENDIF
		
		IF USED('tmpAlloyPlateSum')
			USE IN tmpAlloyPlateSum
		ENDIF
		
	ENDPROC

	PROCEDURE cmdShowStockLstSum.Click
		ThisForm.GetAllStockData()
		
		IF USED('tmpAllStockSum')
			SELECT tmpAllStockSum
			REPORT FORM reports\r_StockSum.frx PREVIEW
		ENDIF
		
		IF USED('tmpAllStockSum')
			USE IN tmpAllStockSum
		ENDIF
		
	ENDPROC


	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC
ENDDEFINE
