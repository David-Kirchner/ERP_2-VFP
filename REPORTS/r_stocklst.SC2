	PROCEDURE getalloybardata
		*ThisForm.GetAlloyBarData()
		
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpAlloyBarSum')
			USE IN tmpAlloyBarSum
		ENDIF
		
		cSQL = "SELECT thck, "
		cSQL = cSQL+" (SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'C-276'   AND Form = '10' AND CC = '1') AS [C276]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'Ni 200'  AND Form = '10' AND CC = '1') AS [Ni200]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '400'     AND Form = '10' AND CC = '1') AS [Ni400]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'K500'    AND Form = '10' AND CC = '1') AS [K500]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'K500'    AND Form = '10' AND CC = '3') AS [K500_3]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '601'     AND Form = '10' AND CC = '1') AS [Ni601]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'Hast X'  AND Form = '10' AND CC = '1') AS [HX]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '625'     AND Form = '10' AND CC = '1') AS [_625]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '718'     AND Form = '10' AND CC = '1') AS [_718]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'L605'    AND Form = '10' AND CC = '1') AS [L605]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '6B'      AND Form = '10' AND CC = '1') AS [_6B]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N50' AND Form = '10' AND CC = '1') AS [N50_1]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N50' AND Form = '10' AND CC = '2') AS [N50_2]"
		
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N60' AND Form = '10' AND CC = '1') AS [N60_1]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N60' AND Form = '10' AND CC = '2') AS [N60_2]"
		
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N60' AND Form = '10' AND dbo.f_CC_CLsort(CC,CL)='71') AS [N60_71]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N60' AND Form = '10' AND dbo.f_CC_CLsort(CC,CL)='72') AS [N60_72]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N60' AND Form = '10' AND dbo.f_CC_CLsort(CC,CL)='73') AS [N60_73]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N60' AND Form = '10' AND dbo.f_CC_CLsort(CC,CL)='74') AS [N60_74]"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N60' AND Form = '10' AND dbo.f_CC_CLsort(CC,CL)='75') AS [N60_75]"
		
		cSQL = cSQL+" FROM dbo.StandardSize "
		cSQL = cSQL+" ORDER BY thck "
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyBarSum')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyBarSum')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyBarSum")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyBarSum")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpAlloyBarSum')
		ENDIF
		
		IF !USED('tmpAlloyBarSum')
			lGood = .F.
		ENDIF
		
		
		IF lGood
			SELECT tmpAlloyBarSum
			
			SCAN
				DELETE FOR C276+Ni200+Ni400+K500+K500_3+Ni601+HX+_625+_718+L605+_6B+N50_1+N50_2+N60_1+N60_2+N60_71+N60_72+N60_73+N60_74+N60_75 = 0
				*DELETE FOR C276+Ni200+Ni400+K500+K500_3+Ni601+HX+_625+_718+L605+_6B+N50_1+N50_2+N60_1+N60_2 +N60_1 +N60_2 +N60_7 +N60_8 = 0
			ENDSCAN
			GO TOP
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getalloyplatedata
		*ThisForm.GetAlloyPlateData()
		
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpAlloyPlateSum')
			USE IN tmpAlloyPlateSum
		ENDIF
		
		cSQL = "SELECT thck, "
		cSQL = cSQL+" (SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'C-276'   AND Form = '40') AS 'C276'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'Ni 200'  AND Form = '40') AS 'N200'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '400'     AND Form = '40') AS 'N400'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'K500'    AND Form = '40') AS 'K500'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '601'     AND Form = '40') AS 'N601'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'Hast X'  AND Form = '40') AS 'HX'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '625'     AND Form = '40') AS 'N625'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '718'     AND Form = '40') AS 'N718'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'L605'    AND Form = '40') AS 'L605'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = '6B'      AND Form = '40') AS 'C6B'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N50' AND Form = '40' AND CC = '1') AS 'N50'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N50' AND Form = '40' AND CC = '2') AS 'N50HS'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N60' AND Form = '40' AND CC = '1') AS 'N60'"
		cSQL = cSQL+",(SELECT ISNULL(SUM(mWeight),0) FROM dbo.StockLst_Master WHERE StandardSize.thck = Size AND Alloy = 'HPA N60' AND Form = '40' AND CC <> '1') AS 'N60HS'"
		cSQL = cSQL+" FROM dbo.StandardSize "
		cSQL = cSQL+" ORDER BY thck "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyPlateSum')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyPlateSum')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyPlateSum")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyPlateSum")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpAlloyPlateSum')
		ENDIF
		
		IF !USED('tmpAlloyPlateSum')
			lGood = .F.
		ENDIF
		
		
		IF lGood
			SCAN
				DELETE FOR C276+N200+N400+K500+N601+HX+N625+N718+L605+C6B+N50+N50HS+N60+N60HS = 0
			ENDSCAN
			GO TOP
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE getallstockdata
		*ThisForm.GetAllStockData()
		
		PRIVATE cSQL, lGood, nSQLEXEC 
		lGood = .T.
		
		IF USED('tmpAllStockSum')
			USE IN tmpAllStockSum
		ENDIF
		
		cSQL = "SELECT Alloy,Form,CC,CL, SUM(mWeight) AS TotLBS FROM dbo.StockLst_Master GROUP BY Alloy,Form,CC,CL ORDER BY TotLBS DESC"
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllStockSum')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllStockSum')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAllStockSum")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAllStockSum")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpAllStockSum')
		ENDIF
		
		IF !USED('tmpAllStockSum')
			lGood = .F.
		ENDIF
		
		
		IF lGood
			SELECT tmpAllStockSum
		
		ELSE
			MESSAGEBOX( 'Could not Run Report',0+16,"Error")
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_Setup" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE Unload
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdExportBarStock.Click
		ThisForm.Getalloybardata()
		
		IF USED('tmpAlloyBarSum')
			SELECT tmpAlloyBarSum
			EXPORT TO SYS(5)+SYS(2003)+"\"+"HPA_StockAlloysBar" TYPE XL5 FOR !DELETED()
			
			LOCAL loExcel
			TRY
				loExcel = CREATEOBJECT("Excel.Application")
				loExcel.workbooks.open(SYS(5)+SYS(2003)+"\"+"HPA_StockAlloysBar.xls")
				loExcel.visible = .T.
			CATCH
				MESSAGEBOX( "Open 'HPA_StockAlloysBar.xls' in Excel"+CHR(13)+"Look in your "+SYS(5)+SYS(2003)+"\"+" directory.",0+64,"Exported")
			ENDTRY
		ENDIF
		
		IF USED('tmpAlloyBarSum')
			USE IN tmpAlloyBarSum
		ENDIF
		
	ENDPROC

