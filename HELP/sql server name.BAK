SET PROCEDURE TO Progs\Proc_Setup ADDITIVE HTML_PO()

get_Email_ServerDir()
cFullSQLPath = "\\"+cSQLServer+"\Email\"

get_Server_Email()
cSQLServer+"@HPAlloy.com"

 get_Report_Server()+"
cURL = "https://"+cSQLServer+"/ReportServer/Pages/ReportViewer.aspx?"

PRIVATE loHyperlink
loHyperlink = CREATEOBJECT("Hyperlink")
loHyperlink.navigateto(cText)
RELEASE loHyperlink

get_SQL_Path()
cFullSQLPath = "\\"+cSQLServer+"\HPAData\Quotes\"


APPEND FROM (cFullSQLPath+"HPA SQL GreenSheet.CSV") CSV
 "\\RAPTOR\HPAData\Quotes\CUSTOMER TERMS and List.CSV"