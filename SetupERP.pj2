*--------------------------------------------------------------------------------------------------------------------------------------------------------
* FoxBin2PRG project script — rebuild a SLIM SetupERP.pjx (setup utility only)
* Regenerate binary:  DO tools\FoxBin2Prg.prg WITH "SetupERP.pj2", "PRG2PJX"
* Or run directly:    DO SetupERP.pj2 WITH "E:\VFP\ERP_2"
*--------------------------------------------------------------------------------------------------------------------------------------------------------
*< FOXBIN2PRG: Version="1.21" SourceFile="setuperp.pjx" CPID="1252" />
*
LPARAMETERS tcDir

lcCurdir = SYS(5)+CURDIR()
CD ( EVL( tcDir, JUSTPATH( SYS(16) ) ) )

*<DevInfo>
_Author = "David Kirchner"
_Company = "Space Alloys USA"
_Comments = "ERP Setup utility - minimal project (not full ERP)"
_ProductName = "ERP_Setup"
_MajorVer = "1"
_MinorVer = "0"
_Revision = "0"
*</DevInfo>


*<BuildProj>
*<.HomeDir = 'e:\vfp\erp_2' />

FOR EACH loProject IN _VFP.Projects FOXOBJECT
	loProject.Close()
ENDFOR

STRTOFILE( '', '__newproject_setup.f2b' )
BUILD PROJECT SetupERP.pjx FROM '__newproject_setup.f2b'
FOR EACH loProject IN _VFP.Projects FOXOBJECT
	loProject.Close()
ENDFOR

MODIFY PROJECT 'SetupERP.pjx' NOWAIT NOSHOW NOPROJECTHOOK

loProject = _VFP.Projects('SetupERP.pjx')

WITH loProject.FILES
	.ADD('progs\setuperp_main.prg')		&& *< FileMetadata: Type="P" Cpid="1252" Timestamp="0" ID="0" ObjRev="544" User="" />
	.ADD('progs\load_erp_environment.prg')		&& *< FileMetadata: Type="P" Cpid="1252" Timestamp="0" ID="0" ObjRev="544" User="" />
	.ADD('progs\erp_environment_ui.prg')		&& *< FileMetadata: Type="P" Cpid="1252" Timestamp="0" ID="0" ObjRev="544" User="" />
	.ADD('progs\proc_setup.prg')		&& *< FileMetadata: Type="P" Cpid="1252" Timestamp="0" ID="0" ObjRev="544" User="" />
	.ADD('progs\recorderror.prg')		&& *< FileMetadata: Type="P" Cpid="1252" Timestamp="0" ID="0" ObjRev="544" User="" />
	.ADD('forms\setuperp.scx')		&& *< FileMetadata: Type="K" Cpid="1252" Timestamp="0" ID="0" ObjRev="544" User="" />
	.ADD('forms\setserver.scx')		&& *< FileMetadata: Type="K" Cpid="1252" Timestamp="0" ID="0" ObjRev="544" User="" />
	.ADD('ico\erp_company.ico')		&& *< FileMetadata: Type="x" Cpid="1252" Timestamp="0" ID="0" ObjRev="0" User="" />
	.ADD('graphics\erp_company.ico')		&& *< FileMetadata: Type="x" Cpid="1252" Timestamp="0" ID="0" ObjRev="0" User="" />
	.ADD('menus\setup_erp.mpr')		&& *< FileMetadata: Type="P" Cpid="1252" Timestamp="0" ID="0" ObjRev="544" User="" />
	*</BuildProj>

	.ITEM('__newproject_setup.f2b').Remove()

	*<FileComments>
	*</FileComments>

	*<ExcludedFiles>
	*</ExcludedFiles>

	*<TextFiles>
	*</TextFiles>
ENDWITH

WITH loProject
	*<ProjectProperties>
	.SetMain(lcCurdir + 'progs\SetupERP_main.prg')
	.Debug = .T.
	.Encrypted = .F.
	.ProjectHookLibrary = ''
	.ProjectHookClass = ''
	*</ProjectProperties>
ENDWITH

_VFP.Projects('SetupERP.pjx').Close()
CD (lcCurdir)
RETURN
