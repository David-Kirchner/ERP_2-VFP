<?xml version="1.0" encoding="Windows-1252" standalone="yes"?>
<!-- Active profile and signatures can be overridden in ERP_Environment.local.xml (not in git). -->
<!-- database=ERP_1 is intentional on all profiles (same DB name, different instances). -->
<!-- reportServer: SSRS host for get_Report_Server(); may differ from data server (SuperMicro has no SSRS). -->
<ERPEnvironment>
	<ActiveProfile>Development</ActiveProfile>
	<Profiles>
		<Profile name="Production" server="SuperMicro" database="ERP_1" reportServer="Server26"/>
		<Profile name="Development" server="Server26\Server26" database="ERP_1" reportServer="Server26\Server26"/>
		<Profile name="Windfall" server="RAPTOR" database="ERP_1" reportServer="RAPTOR"/>
	</Profiles>
	<Company>
		<SignaturesRoot>\\SuperMicro\SQL\Company\Signatures</SignaturesRoot>
	</Company>
</ERPEnvironment>
