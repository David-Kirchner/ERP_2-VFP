<?xml version="1.0" encoding="Windows-1252" standalone="yes"?>
<!-- Active profile = server preset only (Production or Development). -->
<!-- Database is chosen independently; override in ERP_Environment.local.xml -->
<!-- reportServer: SSRS host; may differ from data server (SuperMicro has no SSRS). -->
<ERPEnvironment>
	<ActiveProfile>Development</ActiveProfile>
	<Profiles>
		<Profile name="Production" server="Server26" database="ERP_1" reportServer="Server26"/>
		<Profile name="Development" server="SuperMicro" database="ERP_1" reportServer="Server26"/>
	</Profiles>
	<Databases>
		<Database>ERP_1</Database>
		<Database>ERP_2</Database>
	</Databases>
	<Company>
		<SignaturesRoot>\\SuperMicro\SQL\Company\Signatures</SignaturesRoot>
	</Company>
</ERPEnvironment>
