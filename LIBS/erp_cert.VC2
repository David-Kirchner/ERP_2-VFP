		ThisForm.edtCompanies.Top = (156 + nDeltaH)
		ThisForm.edtCompanies.Width = 480 + nDeltaW
		
		
	ENDPROC

	PROCEDURE cmdAdd.Click
		
		IF This.Caption = "Add"
			ThisFormSet.SetCert_CO_Edit(1)
			
			m.ID = ERPCert.ID
			ThisForm.txtCO_ID.Value = 0
			
			ThisFormset.frmCustomer.SalesNum.Value = 0
			*ThisFormset.frmCustomer.txtCO_ID.Value = ERPCert.ID
			*ThisFormset.frmCustomer.ItemSO.Value = 1
			ThisFormset.frmCustomer.ItemSO.Value = 0
			ThisFormset.frmCustomer.Company.Value = ''
			ThisFormset.frmCustomer.POnum.Value = ''
			ThisFormset.frmCustomer.PartNo.Value = ''
			ThisFormset.frmCustomer.Pcs.Value = 1
			ThisFormset.frmCustomer.Description.Value = ''
			ThisFormset.frmCustomer.txtCompanies.Value = ''
			*ThisForm.txtCompanies.Refresh
			ThisFormSet.isediting_co = .T.
			ThisForm.SalesNum.SetFocus
			
		ELSE
			*Save
			PRIVATE nCO_ID,nSalesNum,nItemSO,cCompany,cPONum,cPartNo,nPcs,cDescription,cSOitem
			
			nCO_ID 		= PrepareSQLnum(ThisFormset.frmCustomer.txtCO_ID.Value,'CO_ID',-3)
			nSalesNum	= PrepareSQLnum(ThisFormset.frmCustomer.SalesNum.Value,'SalesNum',-3)
			nItemSO		= PrepareSQLnum(ThisFormset.frmCustomer.ItemSO.Value,'ItemSO',2,0)
			cCompany	= PrepareSQLtxt(ThisFormset.frmCustomer.Company.Value,'Company',50)
			cPONum		= PrepareSQLtxt(ThisFormset.frmCustomer.PONum.Value,'PONum',50)
			cPartNo		= PrepareSQLtxt(ThisFormset.frmCustomer.PartNo.Value,'PartNo',50)
			nPcs		= PrepareSQLnum(ThisFormset.frmCustomer.PCS.Value,'PCS',-3)
			cDescription = PrepareSQLtxt(ThisFormset.frmCustomer.Description.Value,'Description',50)
			
			IF nSalesNum = 0
				MESSAGEBOX("Need SalesNum to Add",0,"No Sales Number")
				RETURN .F.
			ENDIF
			
			IF nSalesNum > 0
				IF Count_SOinSales_No(nSalesNum, ThisFormSet.nConnHandle,'')>0 &&cAndSome = "ShopRecv","Cncld","Cmplt","Changing","trt_lumber"
					MESSAGEBOX("SalesNum "+ALLTRIM(STR(nSalesNum))+" Not Found",0,"Bad Sales Number")
					*RETURN .F.
				ENDIF
			ENDIF
			
			IF nItemSO < 1
				nItemSO = 1
			ENDIF
			
			cSOitem = Proper_SO_Item(STR( m.SalesNum ) +'-'+ STR(nItemSO,2,0))
			
			IF nCO_ID > 0
			
				cSQL = "UPDATE dbo.Cert_Co SET "
				cSQL = cSQL+" SalesNum = "+STR(nSalesNum)
				cSQL = cSQL+", SOitem = '"+cSOitem+"'"
				cSQL = cSQL+", Company = '"+cCompany+"'"
				cSQL = cSQL+", PONum = '"+cPONum+"'"
				cSQL = cSQL+", PartNo = '"+cPartNo+"'"
				cSQL = cSQL+", Pcs = "+STR(nPcs)
				cSQL = cSQL+", [description] = '"+cDescription+"'"
				cSQL = cSQL+" WHERE CO_ID = "+STR(nCO_ID)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL  )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
				ELSE
					WAIT WINDOW 'Updated the Company data' TIMEOUT 1
				ENDIF
				
				
			ELSE
			
				cSQL = "INSERT INTO dbo.Cert_Co (ID,SalesNum,SOitem,Company,PONum,PartNo,Pcs,[description] ) VALUES ("
				cSQL = cSQL +""+STR(ERPCert.ID)
				cSQL = cSQL +","+STR(nSalesNum)
				cSQL = cSQL +",'"+cSOitem+"'"
				cSQL = cSQL +",'"+cCompany+"'"
				cSQL = cSQL +",'"+cPONum+"'"
				cSQL = cSQL +",'"+cPartNo+"'"
				cSQL = cSQL +","+STR(nPcs)
				cSQL = cSQL +",'"+cDescription+"'"
				cSQL = cSQL +")"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL  )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
				ELSE
					WAIT WINDOW 'Inserted this Company data' TIMEOUT 1
				ENDIF
			
				*************************
				*Get the new CO_ID
				
				IF USED('tmpCert_Co')
					USE IN tmpCert_Co 
				ELSE
					SELECT 0
				ENDIF
				
				cSQL = "SELECT CO_ID FROM dbo.Cert_Co WHERE "
				cSQL = cSQL+" SalesNum = "+STR(nSalesNum)
				cSQL = cSQL+"and SOitem = '"+cSOitem+"'"
				cSQL = cSQL+"and Company = '"+cCompany+"'"
				cSQL = cSQL+"and PONum = '"+cPONum+"'"
				cSQL = cSQL+"and PartNo = '"+cPartNo+"'"
				cSQL = cSQL+"and Pcs = "+STR(nPcs)
				cSQL = cSQL+"and [description] = '"+cDescription+"'"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert_Co' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert_Co' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_Co")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_Co")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCert_Co' )
				ENDIF
				
				IF USED('tmpCert_Co')
					IF VARTYPE(tmpCert_Co.CO_ID) = 'N'
						nCO_ID = tmpCert_Co.CO_ID
					ENDIF
					USE IN tmpCert_Co
				ENDIF
				IF nCO_ID = 0
					TrackError("Failed to insert Company data. "+CHR(13)+cSQL,"Save new Company for HPA_Cert failed", PROGRAM(), LINENO(1))
				ENDIF
			ENDIF
				
			ThisFormSet.SetCert_CO_Edit(0)
			ThisFormSet.GetCert_CO(nCO_ID)
		ENDIF
	ENDPROC

	PROCEDURE cmdBlank.Click
		ThisFormSet.ERPCertCoBlank()
		ThisFormSet.SetCert_CO_Edit(1)
	ENDPROC

	PROCEDURE cmdClone.Click
		ThisFormSet.SetCert_CO_Edit(1)
		
		ThisFormset.frmCustomer.txtCO_ID.Value = 0
		ThisFormset.frmCustomer.SalesNum.Refresh
		ThisFormset.frmCustomer.txtCO_ID.Refresh
		ThisFormset.frmCustomer.ItemSO.Refresh
		ThisFormset.frmCustomer.Company.Refresh
		ThisFormset.frmCustomer.POnum.Refresh
		ThisFormset.frmCustomer.PartNo.Refresh
		ThisFormset.frmCustomer.Pcs.Refresh
		ThisFormset.frmCustomer.Description.Refresh
		
		ThisForm.SalesNum.SetFocus
		
	ENDPROC

	PROCEDURE cmdDelete.Click
		PRIVATE nCO_ID
		nCO_ID = ThisFormset.frmCustomer.txtCO_ID.Value
		
		IF nCO_ID > 0
		
			IF MESSAGEBOX("Are you sure you want to 'Delete' This Record "+ALLTRIM(STR(nCO_ID))+"?",4+32,"Delete?") = 6		
				PRIVATE cSQL,nSQLEXEC 
				
				cSQL = "DELETE FROM dbo.Cert_Co WHERE CO_ID ="+STR(nCO_ID)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
				ENDIF
					
				*refresh
				ThisFormSet.SelectCertID(ThisFormset.ERPCert.txtID.Value)
				ThisFormSet.GetCert_CO()
				
			ENDIF
		ELSE
			MESSAGEBOX("No Record to Delete",0+16,"No ID")
		ENDIF
		
		ThisFormSet.SetCert_CO_Edit(0)
		
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			ThisFormSet.SetCert_CO_Edit(1)
			ThisForm.txtCO_ID.Value = ERPCert_CO.CO_ID
			ThisForm.SalesNum.SetFocus
		
		ELSE
			*Abort
			ThisFormSet.SetCert_CO_Edit(0)
			ThisFormSet.RefreshERPCert('ABORT')
		ENDIF
	ENDPROC

	PROCEDURE Company.When
		RETURN ThisFormSet.isediting_co
	ENDPROC

	PROCEDURE Description.When
		RETURN ThisFormSet.isediting_co
	ENDPROC

	PROCEDURE grdCO.AfterRowColChange
		LPARAMETERS nColIndex
		ThisFormSet.RefreshERPCertCo(ERPCert_Co.CO_ID)
	ENDPROC

	PROCEDURE ItemSO.When
		RETURN ThisFormSet.isediting_co
	ENDPROC

	PROCEDURE PartNo.When
		RETURN ThisFormSet.isediting_co
	ENDPROC

	PROCEDURE Pcs.When
		RETURN ThisFormSet.isediting_co
	ENDPROC

	PROCEDURE POnum.When
		RETURN ThisFormSet.isediting_co
	ENDPROC

	PROCEDURE SalesNum.When
		RETURN ThisFormSet.isediting_co
	ENDPROC

	PROCEDURE txtCO_ID.When
		RETURN ThisFormSet.isediting
	ENDPROC

ENDDEFINE

