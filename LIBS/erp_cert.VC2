DEFINE CLASS add_cert AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdExit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdTChem" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtLot" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Commandgroup1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdNChem" UniqueID="" Timestamp="" />

	*<PropValue>
		AlwaysOnTop = .T.
		BackColor = 0,255,255
		Caption = "Add to HPA Cert file."
		Closable = .F.
		ControlBox = .F.
		DoCreate = .T.
		Height = 165
		Left = 0
		MDIForm = .T.
		Name = "frmAddCert"
		ShowTips = .T.
		Top = 6
		Visible = .F.
		Width = 277
	*</PropValue>

	ADD OBJECT 'cmdExit' AS commandbutton WITH ;
		Caption = "Exit", ;
		Height = 27, ;
		Left = 185, ;
		Name = "cmdExit", ;
		TabIndex = 6, ;
		TerminateRead = .T., ;
