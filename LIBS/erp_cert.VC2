	PROCEDURE Init
		ThisForm.Left = 617  &&W484 L206
		ThisForm.Top = 134  &&H171 T213
		ThisFormSet.RefreshERPCert('INIT')
	ENDPROC

	PROCEDURE Resize
		*ThisForm.Left = 617  &&W484 L206
		*ThisForm.Top = 134  &&H171 T213
		*ThisFormSet.RefreshERPCert('INIT')
		
		PRIVATE nDeltaH, nDeltaW
		nDeltaH = ThisForm.Height - 172
		nDeltaW = ThisForm.Width - 484
		
		ThisForm.cmdAdd.Top		= (127 + nDeltaH)
		ThisForm.cmdClone.Top	= (127 + nDeltaH)
		ThisForm.cmdEdit.Top	= (127 + nDeltaH)
		ThisForm.cmdBlank.Top	= (127 + nDeltaH)
		ThisForm.cmdDelete.Top	= (127 + nDeltaH)
		
		
		ThisForm.grdCO.Height	= (104 + nDeltaH)
		ThisForm.grdCO.Width	= (228 + nDeltaW)
		
		ThisForm.txtCO_ID.Left	= (266 + nDeltaW)
		ThisForm.lblNoClose.Left = (317 + nDeltaW)
		ThisForm.lblSO.Left		= (259 + nDeltaW)
		ThisForm.SalesNum.Left	= (294 + nDeltaW)
		ThisForm.ItemSO.Left	= (366 + nDeltaW)
		ThisForm.lblCompany.Left	= (232 + nDeltaW)
		ThisForm.Company.Left	= 292 + nDeltaW
		ThisForm.lblPO.Left		= 261 + nDeltaW
		ThisForm.POnum.Left		= 292 + nDeltaW
		ThisForm.lblPart.Left	= 253 + nDeltaW
		ThisForm.PartNo.Left 	= 292 + nDeltaW
		ThisForm.lblPieces.Left	= 247 + nDeltaW
		ThisForm.Pcs.Left		= 292 + nDeltaW
		ThisForm.lblDescript.Left= 360 + nDeltaW
		ThisForm.Description.Left= 252 + nDeltaW
		
