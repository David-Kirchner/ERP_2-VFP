		Command4.Left = 5, ;
		Command4.Name = "cmdRollLot", ;
		Command4.Top = 93, ;
		Command4.Width = 121, ;
		Command5.Caption = "Lake Erie Press lot", ;
		Command5.Height = 27, ;
		Command5.Left = 5, ;
		Command5.Name = "cmdLakeErieLot", ;
		Command5.Top = 122, ;
		Command5.Width = 122
		*< END OBJECT: BaseClass="commandgroup" />

	ADD OBJECT 'Label1' AS label WITH ;
		Alignment = 1, ;
		BackColor = 0,255,255, ;
		Caption = "Lot#", ;
