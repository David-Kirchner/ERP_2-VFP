	PROTECTED PROCEDURE getvfactor		&& Calculates the vertical factor for the specified font
		LPARAMETERS tvFontNameOrObject, tnFontSize
		
		LOCAL loObject
		
		LOCAL lcFontName
		
		LOCAL lnFontSize
		LOCAL lnFactor
		
		
		IF VARTYPE(tvFontNameOrObject) = 'O'
		*-- Use default report font
			lcFontName = IIF(!EMPTY(tvFontNameOrObject.cFontName), tvFontNameOrObject.cFontName, THIS.cFontName)
			lnFontSize = tvFontNameOrObject.nFontSize
			
		ELSE
		
			lcFontName = tvFontNameOrObject
			lnFontSize = tnFontSize
		
		ENDIF
		
		lnFactor = FONTMETRIC(1, lcFontName, lnFontSize) + FONTMETRIC(5, lcFontName, lnFontSize)
		
		RETURN lnFactor
		
		
		
	ENDPROC

	PROCEDURE getvvalue		&& Calculates a vertical values in the pixels
		LPARAMETERS tnValue, tvFontNameOrObject, tnFontSize
		
		LOCAL lnValue
		
		lnValue = tnValue * THIS.GetVFactor(tvFontNameOrObject, tnFontSize)
		
		RETURN lnValue
		
	ENDPROC

	PROCEDURE hexcolor
		LPARAMETER tnColor
		
		LOCAL lcColor
		
		IF VARTYPE(tnColor) # 'N'
			RETURN ''
		ENDIF
		
		lcColor = TRANSFORM(tnColor, '@0')
		
		RETURN '#' + RIGHT(lcColor, 2) + LEFT(RIGHT(lcColor, 4), 2) + LEFT(RIGHT(lcColor, 6), 2)
		
		
		
	ENDPROC

	PROTECTED PROCEDURE Init
		DODEFAULT()
		
		WITH THIS
		
			.nVFPVersion = VAL(_VFP.VERSION)
		
			SET PROCEDURE TO '..\PRG\GridDefinition' ADDITIVE
		
			.InitGDIPlus()
		
			DIMENSION .aCharts[1]
			.aCharts = .NULL.
		
		ENDWITH
		
	ENDPROC

	PROCEDURE initdataenvironment
		LPARAMETERS tcReportFullName
		
		LOCAL llReturnValue
		LOCAL laUsedTables[1]
		
		LOCAL lnReturn
		
		
		WITH THIS
		
			.nVFPVersion = VAL(_VFP.VERSION)
		
		*-- Create Main File Object
		    lnReturn = .CreateFileObject(tcReportFullName)
		
		    IF !.lFirstPass AND lnReturn = cnOk
		    
		        IF VARTYPE(.oDataEnvironment) = 'O' AND !ISNULL(.oDataEnvironment)
		*-- DE Definition            
		            .oDataEnvironment.DumpDE()
		
		*-- DE Initialiation
		            .oDataEnvironment.InitDE()
		
					IF .oDataEnvironment.nDataSessionType = cnDATASESSION_PRIVATE
		*-- Set up Privat DS
						SET DATASESSION TO .oDataEnvironment.nDataSessionPrivateID
					ENDIF
		
					DO CASE
					CASE AUSED(laUsedTables) > 0
					CASE VARTYPE(.oDataEnvironment.oDE) # 'O' OR ISNULL(.oDataEnvironment.oDE)
		                lnReturn = cnDE_INIT_RETURN_FALSE
		            OTHERWISE
		                lnReturn = cnNO_OPEN_TABLE
		            ENDCASE
				ELSE
		           lnReturn = cnNO_DE_OBJECT
		        ENDIF
		    ENDIF
		ENDWITH
		
		RETURN lnReturn
		
	ENDPROC

	PROCEDURE initgdiplus
		*-- An instance of gdiplusinit should be created before
		*-- and released after using any of gdi+ objects
		WITH THIS
			.oGDIPlus = NEWOBJECT(ccGDIPLUS_CLASS_GDIPLUS_INIT, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME)
		ENDWITH
		
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROTECTED PROCEDURE initreportvariables
		LOCAL ln_MCh_Variables
		LOCAL ln_MCh_Count
		LOCAL lu_MCh_InitValue
		
		LOCAL lo_MCh_Variable
		
		LOCAL lc_MCh_VariableName
		LOCAL lc_MCh_InitValue
		
		WITH THIS
		
			IF !ISNULL(.aVariables[1])
		
				ln_MCh_Variables = ALEN(.aVariables)
		
				FOR ln_MCh_Count = 1 TO ln_MCh_Variables
		
					lo_MCh_Variable = .aVariables[ln_MCh_Count]
		
					WITH lo_MCh_Variable
					
		*-- Calculate init value
						lc_MCh_VariableName    = .cName
						
						lc_MCh_InitValue       = ALLT(.uInitialValue)
						lu_MCh_InitValue       = EVAL(lc_MCh_InitValue)
		
						.nCalculatedValue = lu_MCh_InitValue
						
						&lc_MCh_VariableName   = .nCalculatedValue
						
					ENDWITH
		
				NEXT ln_MCh_Count
		
			ENDIF
		ENDWITH
		
		
		
		
	ENDPROC

	PROTECTED PROCEDURE insertband		&& Inserts the specified band objects into the specified document.
	ENDPROC

	PROTECTED PROCEDURE insertobject		&& Inserts the specified object into the specified document.
		LPARAMETERS toObject
		
		LOCAL lnSurTotal
		LOCAL lnMaxSurValue
		LOCAL lnSurValue
		LOCAL lnSurDelta
		LOCAL lnSurCount
		
		LOCAL loSurObject
		
		lnMaxSurValue 	   = 0
		toObject.nSurDelta = 0
		
		IF !ISNULL(toObject.aSurrounders[1])
			lnSurTotal = ALEN(toObject.aSurrounders, 1)
		
			FOR lnSurCount = 1 TO lnSurTotal
		
				loSurObject = toObject.aSurrounders[lnSurCount]
		
				IF !loSurObject.lRemoved AND (loSurObject.nHeight < loSurObject.nStretchedHeight OR loSurObject.nSurDelta > 0)
		
					lnSurValue  = loSurObject.nVPosition + loSurObject.nNewHeight			
		
					lnSurDelta  = lnSurValue - loSurObject.nSurBottomPosition
		
					IF lnMaxSurValue < lnSurValue + loSurObject.nSurDelta
						lnMaxSurValue      = lnSurValue + loSurObject.nSurDelta	 + loSurObject.nOveredSurDelta
						toObject.nSurDelta = lnSurDelta	+ loSurObject.nSurDelta	 + loSurObject.nOveredSurDelta
					ENDIF
		
				ENDIF
		
			NEXT
		ENDIF
		
	ENDPROC

