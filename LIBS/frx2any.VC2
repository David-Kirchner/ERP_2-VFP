*--------------------------------------------------------------------------------------------------------------------------------------------------------
* (EN) AUTOGENERATED - ATTENTION!! - NOT INTENDED FOR EXECUTION!! USE ONLY FOR MERGING CHANGES AND STORING WITH SCM TOOLS!!
*--------------------------------------------------------------------------------------------------------------------------------------------------------
*< FOXBIN2PRG: Version="1.21" SourceFile="frx2any.vcx" CPID="1252" /> (Solo para binarios VFP 9 / Only for VFP 9 binaries)
*
*
DEFINE CLASS anyband AS anyrecord OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: additem		&& Adds a new report item to the band
		*m: addoveritem		&& Adds  a new report OverItem to the band
		*m: conentry_assign
		*m: conexit_assign
		*m: getreportobjects		&& Returns an array of report objects in this band
		*m: lcalculation_assign
		*m: lconstantheight_assign
		*m: lresetpagenumber_assign
		*m: lstartonnewpage_assign
		*m: nheight_assign
		*m: setbandproperties
		*p: conentry		&& The "on entry" expression for the band
		*p: conexit		&& The "on exit" expression for the band
		*p: lcalculation
		*p: lconstantbandheight
		*p: lconstantheight		&& .T. if the band should be a constant height
		*p: llastband		&& Indicate that printed band is last one
		*p: lprintinfirstwholeband		&& Indicate that band's objects have to be printed on a new page/column of report
		*p: lprintpagefooter		&& Specify if PageFooter will be printed in Summer Band
		*p: lprintpageheader		&& Specify if Page Header will be printed in a Summer Band
		*p: lresetpagenumber
		*p: lstartonnewpage		&& .T. if this band should start on a new page
		*p: nbandid
		*p: nbandtype		&& The band type
		*p: nheight		&& The height of the band
		*p: ntop
		*p: oreport		&& A reference to the Report File object
		*p: ospliter		&& A reference to the Visual Band
		*a: aitems[1,0]		&& An array of report objects in the band
		*a: aoveritems[1,0]		&& An array of report objects in the band that reach the page boundaries and must be printed on the next page
	*</DefinedPropArrayMethod>

	PROTECTED oreport
	*<PropValue>
		conentry = 
		conexit = 
		lconstantheight = .F.
		lprintinfirstwholeband = .T.
		lstartonnewpage = .F.
		Name = "anyband"
		nbandid = 0
		nbandtype = 0
		nheight = 0
		nobjecttype = 9
		ntop = 0
		oreport = .NULL.
		ospliter = .NULL.
	*</PropValue>
	
	PROCEDURE additem		&& Adds a new report item to the band
		*-- Add a new report item to the band.
		LPARAMETERS tcType, tcObjName, tnObjectPosNumber
		
		LOCAL lcType
		LOCAL lcClass
		
		LOCAL loItem
		
		LOCAL laItems
		
		LOCAL lnCount
		LOCAL lnExportFileType
		
		
		loItem  = .NULL.
		lcClass = ''
		
		WITH THIS
			lcType = UPPER(tcType)
		
		
			lnExportFileType = .oReport.GetExportFileType()
		
			DO CASE
				CASE lnExportFileType = cnHTML
					DO CASE
						CASE lcType = ccOBJECT_FIELD
							lcClass = ccOBJ_HTML_FIELD_CLS_NAME
						CASE lcType = ccOBJECT_TEXT
							lcClass = ccOBJ_HTML_TEXT_CLS_NAME
						CASE lcType = ccOBJECT_LINE
							lcClass = ccOBJ_HTML_LINE_CLS_NAME
						CASE lcType = ccOBJECT_IMAGE
							lcClass = ccOBJ_HTML_IMAGE_CLS_NAME
						CASE lcType = ccOBJECT_BOX
							lcClass = ccOBJ_HTML_BOX_CLS_NAME
					ENDCASE
		
				CASE lnExportFileType = cnWORD
					DO CASE
						CASE lcType = ccOBJECT_FIELD
							lcClass = ccOBJ_WORD_FIELD_CLS_NAME
						CASE lcType = ccOBJECT_TEXT
							lcClass = ccOBJ_WORD_TEXT_CLS_NAME
						CASE lcType = ccOBJECT_LINE
							lcClass = ccOBJ_WORD_LINE_CLS_NAME
						CASE lcType = ccOBJECT_IMAGE
							lcClass = ccOBJ_WORD_IMAGE_CLS_NAME
						CASE lcType = ccOBJECT_BOX
							lcClass = ccOBJ_WORD_BOX_CLS_NAME
					ENDCASE
		
		
				CASE lnExportFileType = cnRTF
					DO CASE
						CASE lcType = ccOBJECT_FIELD
							lcClass = ccOBJ_RTF_FIELD_CLS_NAME
						CASE lcType = ccOBJECT_TEXT
							lcClass = ccOBJ_RTF_TEXT_CLS_NAME
						CASE lcType = ccOBJECT_LINE
							lcClass = ccOBJ_RTF_LINE_CLS_NAME
						CASE lcType = ccOBJECT_IMAGE
							lcClass = ccOBJ_RTF_IMAGE_CLS_NAME
						CASE lcType = ccOBJECT_BOX
							lcClass = ccOBJ_RTF_BOX_CLS_NAME
					ENDCASE
		
		
				CASE lnExportFileType = cnEXCEL
		*-- Figure out which class to instantiate based on the report object type.
					DO CASE
						CASE lcType = ccOBJECT_FIELD
							lcClass = ccOBJ_EXCEL_FIELD_CLS_NAME
						CASE lcType = ccOBJECT_TEXT
							lcClass = ccOBJ_EXCEL_TEXT_CLS_NAME
						CASE lcType = ccOBJECT_LINE
							lcClass = ccOBJ_EXCEL_LINE_CLS_NAME
						CASE lcType = ccOBJECT_IMAGE
							lcClass = ccOBJ_EXCEL_IMAGE_CLS_NAME
						CASE lcType = ccOBJECT_BOX
							lcClass = ccOBJ_EXCEL_BOX_CLS_NAME
					ENDCASE
					
				CASE lnExportFileType = cnPREVIEW
		*-- Figure out which class to instantiate based on the report object type.
					DO CASE
						CASE lcType = ccOBJECT_FIELD
							lcClass = ccOBJ_PREVIEW_FIELD_CLS_NAME
						CASE lcType = ccOBJECT_TEXT
							lcClass = ccOBJ_PREVIEW_TEXT_CLS_NAME
						CASE lcType = ccOBJECT_LINE
							lcClass = ccOBJ_PREVIEW_LINE_CLS_NAME
						CASE lcType = ccOBJECT_IMAGE
							lcClass = ccOBJ_PREVIEW_IMAGE_CLS_NAME
						CASE lcType = ccOBJECT_BOX
							lcClass = ccOBJ_PREVIEW_BOX_CLS_NAME
					ENDCASE
		
				CASE lnExportFileType = cnPDF
		*-- Figure out which class to instantiate based on the report object type.
					DO CASE
						CASE lcType = ccOBJECT_FIELD
							lcClass = ccOBJ_PDF_FIELD_CLS_NAME
						CASE lcType = ccOBJECT_TEXT
							lcClass = ccOBJ_PDF_TEXT_CLS_NAME
						CASE lcType = ccOBJECT_LINE
							lcClass = ccOBJ_PDF_LINE_CLS_NAME
						CASE lcType = ccOBJECT_IMAGE
							lcClass = ccOBJ_PDF_IMAGE_CLS_NAME
						CASE lcType = ccOBJECT_BOX
							lcClass = ccOBJ_PDF_BOX_CLS_NAME
					ENDCASE
		
				CASE lnExportFileType = cnXML
		*-- Figure out which class to instantiate based on the report object type.
					DO CASE
						CASE lcType = ccOBJECT_FIELD
							lcClass = ccOBJ_XML_FIELD_CLS_NAME
						CASE lcType = ccOBJECT_TEXT
							lcClass = ccOBJ_XML_TEXT_CLS_NAME
						CASE lcType = ccOBJECT_LINE
							lcClass = ccOBJ_XML_LINE_CLS_NAME
						CASE lcType = ccOBJECT_IMAGE
							lcClass = ccOBJ_XML_IMAGE_CLS_NAME
						CASE lcType = ccOBJECT_BOX
							lcClass = ccOBJ_XML_BOX_CLS_NAME
					ENDCASE
		
				CASE lnExportFileType = cnIMAGE
					DO CASE
						CASE lcType = ccOBJECT_FIELD
							lcClass = ccOBJ_IMAGE_FIELD_CLS_NAME
						CASE lcType = ccOBJECT_TEXT
							lcClass = ccOBJ_IMAGE_TEXT_CLS_NAME
						CASE lcType = ccOBJECT_LINE
							lcClass = ccOBJ_IMAGE_LINE_CLS_NAME
						CASE lcType = ccOBJECT_IMAGE
							lcClass = ccOBJ_IMAGE_IMAGE_CLS_NAME
						CASE lcType = ccOBJECT_BOX
							lcClass = ccOBJ_IMAGE_BOX_CLS_NAME
					ENDCASE
		
			ENDCASE
		
			IF EMPTY(lcClass)
			ELSE
		*-- Instantiate the proper class and add it to the array, then return an obect reference to it.
				lnItem = IIF(ISNULL(.aItems[1]), 1, ALEN(.aItems) + 1)
				DIMENSION .aItems[lnItem]
		
				loItem = NEWOBJECT(lcClass, .CLASSLIBRARY, '', .oReport)
		
				IF !EMPTY(tcObjName)
					loItem.NAME=ALLTRIM(tcObjName)
				ENDIF
		
				IF tnObjectPosNumber = 0
					.aItems[lnItem] = loItem
				ELSE
					DIMENSION laItems[1]
		
					=ACOPY(.aItems, laItems)
					DIMENSION .aItems[1]
					.aItems[1]=.NULL.
		
					lnAdjust = 0
					FOR lnCount = 1 TO ALEN(laItems)
		
						IF !ISNULL(.aItems[1])
							DIMENSION .aItems[ALEN(.aItems)+1]
						ENDIF
		
						IF lnCount # tnObjectPosNumber
							.aItems[ALEN(.aItems)]=laItems[lnCount - lnAdjust]
						ELSE
							.aItems[lnCount] = loItem
							lnAdjust = 1
						ENDIF
					NEXT lnCount
				ENDIF
			ENDIF
		ENDWITH
		
		RETURN loItem
		
		
	ENDPROC

	PROCEDURE addoveritem		&& Adds  a new report OverItem to the band
		*-- Add a new report item to the band.
		LPARAMETERS toDuplicateObj
		
		LOCAL loItem
		
		loItem = .NULL.
		
		WITH THIS
		
			IF TYPE('toDuplicateObj') = 'O'
		
				loItem      = .oReport.CopyObject(toDuplicateObj)
				loItem.NAME = SYS(2015)		
		
				IF TYPE('loItem') = 'O'
				
					lnItem = IIF(ISNULL(.aOverItems[1]), 1, ALEN(.aOverItems) + 1)
					DIMENSION .aOverItems[lnItem]
				
					.aOverItems[lnItem] = loItem
				ENDIF
			ENDIF
		
		ENDWITH
		
		RETURN loItem
		
		
	ENDPROC

	PROCEDURE conentry_assign
		LPARAMETER tcOnEntry
		
		IF VARTYPE(tcOnEntry) <> 'C'
		ELSE
			THIS.cOnEntry = tcOnEntry
		ENDIF
		
	ENDPROC

	PROCEDURE conexit_assign
		LPARAMETER tcOnExit
		
		IF VARTYPE(tcOnExit) <> 'C'
		ELSE
			THIS.cOnExit = tcOnExit
		ENDIF
		
	ENDPROC

	PROCEDURE getreportobjects		&& Returns an array of report objects in this band
		*-- Fill an array of report objects in V and H position order (which is wrong, should use sequence).
		LPARAMETERS taReturn
		
		LOCAL lnObjects
		LOCAL laObjects[1]
		LOCAL lnCount
		
		lnObjects = 0
		
		IF TYPE('taReturn[1]') <> 'U'
		ELSE
			WITH THIS
				lnObjects = IIF(ISNULL(.aItems), 0, ALEN(.aItems))
				IF lnObjects > 0
					DIMENSION laObjects[lnObjects, 2], taReturn[lnObjects]
		
					FOR lnCount = 1 TO lnObjects
						laObjects[lnCount, 1] = STR(.aItems[lnCount].nVPosition) + STR(.aItems[lnCount].nHPosition)
						laObjects[lnCount, 2] = lnCount
					NEXT lnCount
		
					FOR lnCount = 1 TO lnObjects
						taReturn[lnCount] = .aItems[laObjects[lnCount, 2]]
					NEXT lnCount
		
				ENDIF
			ENDWITH
		ENDIF
		
		RETURN lnObjects
		
	ENDPROC

	PROCEDURE Init
		*-- Set the band type to the specified type and blank the report objects array.
		LPARAMETERS tnBandType, toReport
		
		DODEFAULT()
		
		WITH THIS
			.nBandType  = tnBandType
			.oReport    = toReport
			.aItems     = .NULL.
			.aOverItems = .NULL.	
		ENDWITH
		
	ENDPROC

	PROCEDURE lcalculation_assign
		LPARAMETERS tlCalculation
		THIS.lCalculation = tlCalculation
		
	ENDPROC

	PROCEDURE lconstantheight_assign
		LPARAMETER tlConstantHeight
		
		IF VARTYPE(tlConstantHeight) = 'L'
			THIS.lConstantHeight = tlConstantHeight
		ENDIF 
		
	ENDPROC

	PROCEDURE lresetpagenumber_assign
		LPARAMETER tlResetPageNumber
		
		IF VARTYPE(tlResetPageNumber) = 'L'
			THIS.lResetPageNumber = tlResetPageNumber
		ENDIF 
		
	ENDPROC

	PROCEDURE lstartonnewpage_assign
		LPARAMETER tlStartOnNewPage
		
		IF VARTYPE(tlStartOnNewPage) = 'L'
			THIS.lStartOnNewPage = tlStartOnNewPage
		ENDIF 
		
	ENDPROC

	PROCEDURE nheight_assign
		LPARAMETER tnHeight
		
		DO CASE
			CASE NOT VARTYPE(tnHeight) $ 'NFIBY'
			CASE NOT BETWEEN(tnHeight, 0, 99999)
			OTHERWISE
				THIS.nHeight = tnHeight
		ENDCASE
		
	ENDPROC

	PROCEDURE setbandproperties
		LPARAMETERS toRecord
		
		WITH THIS
		*-- Set the band height
			.nHeight = toRecord.HEIGHT * .oReport.GetVConvertFactor()	
		
		*-- Set the OnEntry and OnExit expressions, and whether we should start this band on a new page.
			.cOnEntry 		     = toRecord.TAG
			.cOnExit  		     = toRecord.Tag2
			.lStartOnNewPage     = toRecord.PageBreak
			.lResetPageNumber    = toRecord.ResetPage	
		
			.lConstantBandHeight = toRecord.Plain
			
		*-- Check if we have _PAGETOTAL in expression
			IF .oReport.nVFPVersion >= 8 
		*-- So, we deal with VFP 8 and it is new feature...				
		*-- This will effct only SUMMER Band
				.lPrintPageHeader  = toRecord.EjectBefor
				.lPrintPageFooter  = toRecord.EjectAfter
				
			ENDIF
				
		ENDWITH
		
		
	ENDPROC

	PROCEDURE _releasemembers
		*-- Nuke member objects.
		LOCAL lnCount
		
		FOR lnCount = 1 TO ALEN(THIS.aItems)
			IF VARTYPE(THIS.aItems[lnCount]) = 'O'
				THIS.aItems[lnCount]._RELEASE()
			ENDIF 
		NEXT lnCount
		
		FOR lnCount = 1 TO ALEN(THIS.aOverItems)
			IF VARTYPE(THIS.aOverItems[lnCount]) = 'O'
				THIS.aOverItems[lnCount]._RELEASE()
			ENDIF 
		NEXT lnCount
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anybox AS anyshape OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: cchartname_assign
		*m: lstretchtotallest_assign
		*m: ncurvature_assign
		*p: cchartname
		*p: crtffieldcontentsname
		*p: crtffilecontentsname
		*p: crtfname
		*p: lstretchtotallest		&& .T. to stretch the object relative to the tallest object in the band
		*p: ncurvature		&& The curvature for the shape (0 = none)
		*p: nrectangletype		&& Rectangle type
	*</DefinedPropArrayMethod>

	*<PropValue>
		cchartname = 
		crtffieldcontentsname = 
		crtffilecontentsname = 
		crtfname = 
		lstretchtotallest = .F.
		Name = "anybox"
		nbordersite = 15
		ncurvature = 0
		nobjecttype = 7
		nrectangletype = 0
	*</PropValue>
	
	PROCEDURE cchartname_assign
		LPARAMETER tcChartName
		
		DO CASE
		CASE VARTYPE(tcChartName) <> 'C' 
		CASE EMPTY(tcChartName)
		OTHERWISE
			THIS.cChartName = UPPER(ALLTRIM(tcChartName))
		ENDCASE 
		
	ENDPROC

	PROCEDURE lstretchtotallest_assign
		LPARAMETER tnValue
		
		IF VARTYPE(tnValue) = 'L'
			THIS.lStretchtoTallest = tnValue
		ENDIF 
		
		
	ENDPROC

	PROCEDURE ncurvature_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE NOT BETWEEN(tnValue, 0, 99)
			OTHERWISE
				THIS.nCurvature = tnValue
		ENDCASE
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anycursor AS anyrecord OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: setcursorproperties
		*p: calias		&& Specifies the Alias used for each Table or View associated with a Cursor object.
		*p: cclassname
		*p: ccomment
		*p: ccursorsource		&& Specifies the Name of the Table or View  associated with a Cursor object.
		*p: cdatabase		&& Specifies the Path to the DataBase that contains the Table or View associated with a Cursor object.
		*p: cfilter		&& Excludes recoeds that do not meet the criteria in the specified expression.
		*p: cname
		*p: corder		&& Specifies the controlling Index Tag  for a Cursor object.
		*p: cprocedures
		*p: ctag
		*p: lexclusive
		*p: lnodataonload
		*p: lreadonly
		*p: nbuffermodeoverride
		*p: oreport
	*</DefinedPropArrayMethod>

	PROTECTED oreport
	*<PropValue>
		calias = 
		cclassname = 
		ccomment = 
		ccursorsource = 
		cdatabase = 
		cfilter = 
		cname = 
		corder = 
		cprocedures = 
		ctag = 
		Name = "anycursor"
		nbuffermodeoverride = 1
		nobjecttype = 26
		oreport = .NULL.
	*</PropValue>
	
	PROCEDURE Init
		LPARAMETERS toReport
		
		DODEFAULT()
		
		WITH THIS
			.oReport    = toReport
			.cClassName = SYS(2015)
		ENDWITH
		
	ENDPROC

	PROCEDURE setcursorproperties
		LPARAMETERS toReportRecord
		
		LOCAL lnCount
		LOCAL lnMemoLines
		LOCAL lnOldMemoWidth
		
		LOCAL lcMemoLine
		LOCAL lcExtractedValue
		LOCAL lcDataBase
		LOCAL lcDataBasePath
		LOCAL lcJustPath
		
		WITH THIS
		
			.cProcedures = toReportRecord.Tag
		
			lnOldMemoWidth = SET('MEMOWIDTH')
			SET MEMOWIDTH TO 500
		
			lnMemoLines = MEMLINES(toReportRecord.EXPR)
		
			FOR lnCount = 1 TO lnMemoLines
		
				lcMemoLine       = MLINE(toReportRecord.EXPR, lnCount)
		
				lcExtractedValue = .oReport.ExtractValue(lcMemoLine)		
		
				DO CASE
					CASE ATC('Alias =', lcMemoLine) > 0
						.cAlias = lcExtractedValue
		
					CASE ATC('Name =', lcMemoLine) > 0
						.cName = lcExtractedValue
		
					CASE ATC('Comment =', lcMemoLine) > 0
						.cComment = lcExtractedValue
		
					CASE ATC('Tag =', lcMemoLine) > 0
						.cTag = lcExtractedValue
		
					CASE ATC('CursorSource =', lcMemoLine) > 0
		
						IF EMPTY(.cDataBase)
							lcJustPath = JUSTPATH(lcExtractedValue)			
					
							IF ATCC(':\' , lcJustPath) = 0
		*-- Suppouse that Table is in the same folder as the report...				
								lcExtractedValue = .oReport.cReportPath + lcExtractedValue
							ENDIF
						ENDIF	
		
						.cCursorSource = lcExtractedValue
						
					CASE ATC('DataBase =', lcMemoLine) > 0
		
						lcJustPath = JUSTPATH(lcExtractedValue)
		
						IF ATCC(':\' , lcJustPath) = 0
		*-- Suppouse that DBC is in the same folder as the report...				
							lcExtractedValue = .oReport.cReportPath + lcExtractedValue
						ENDIF
						
						.cDataBase = lcExtractedValue
		
					CASE ATC('Filter =', lcMemoLine) > 0
						.cFilter = lcExtractedValue
		
					CASE ATC('Order =', lcMemoLine) > 0
					
						.cOrder = lcExtractedValue
		
					CASE ATC('Exclusive =', lcMemoLine) > 0
						.lExclusive = lcExtractedValue
		
					CASE ATC('NoDataOnLoad =', lcMemoLine) > 0
						.lNoDataOnLoad = lcExtractedValue
		
					CASE ATC('ReadOnly =', lcMemoLine) > 0
						.lReadOnly = lcExtractedValue
		
					CASE ATC('BufferModeOverride =', lcMemoLine) > 0
						.nBufferModeOverride = lcExtractedValue
						
				ENDCASE
		
			ENDFOR
			
			SET MEMOWIDTH TO lnOldMemoWidth	
			
		
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anycustom AS custom 		&& Base class for Custom objects
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: clearerror
		*m: _about		&& Provides documentation for the class
		*m: _cleanup		&& Cleans up member references when the object is released or destroyed
		*m: _release		&& Releases the object.
		*m: _releasemembers		&& Abstract method to nuke member references
		*p: cdefaulterrormessagetext
		*p: cerrormessageboxtitle
		*p: clasterrormessage
		*p: cstartpath
		*p: ldisplayerrormessagebox
		*p: lfirsterrormessage
		*p: lhaderror
		*p: nerrorcount
		*p: _lrelease		&& .T. as the object is being released
	*</DefinedPropArrayMethod>

	PROTECTED _lrelease
	*<PropValue>
		cdefaulterrormessagetext = 
		cerrormessageboxtitle = 
		clasterrormessage = 
		cstartpath = 
		ldisplayerrormessagebox = .F.
		Name = "anycustom"
		nerrorcount = 0
		Width = 17
		_lrelease = .F.
	*</PropValue>
	
	PROCEDURE clearerror
		WITH THIS
			.lHadError 		   = .F.
			.cLastErrorMessage = ''
		ENDWITH
		
	ENDPROC

	PROCEDURE Destroy
		*-- Cleanup as the object is destroyed.
		This._Cleanup()
		
	ENDPROC

	PROCEDURE Error
		LPARAMETERS tnError, tcMethod, tnLine
		
		
		
		LOCAL lcMessage
		LOCAL lcCodeLine
		LOCAL lcSetSafety
		
		WITH THIS
			IF .nErrorCount <= 10
			
				lcMessage  = MESSAGE()
				
				lcCodeLine = MESSAGE(1)
		
				lcSetSafety = SET("SAFETY")
		
				SET SAFETY OFF
		
				.lHadError = .T.
		
				.cLastErrorMessage = lcMessage;
					+ ccCR + ccLF + .NAME ;
					+ ccCR + ccLF + ccGDIPLUS_ERRNOLABEL_LOC + ALLTRIM(STR(tnError)) ;
					+ ccCR + ccLF + ccGDIPLUS_ERRPROCLABEL_LOC + tcMethod ;
					+ ccCR + ccLF + ccGDIPLUS_ERRLINELABEL_LOC + ALLTRIM(STR(tnLine)) ;
					+ ccCR + ccLF + lcCodeLine ;
					+ ccCR + ccLF + 'Date:'+TTOC(DATETIME()) ;
					+ ccCR + ccLF + REPL('-',60) ;
					+ ccCR + ccLF
		
		
				IF !.lFirstErrorMessage AND .lDisplayErrorMessageBox
				    = MESSAGEBOX(IIF(EMPTY(.cDefaultErrorMessageText), .cLastErrorMessage, .cDefaultErrorMessageText), 16, .cErrorMessageBoxTitle)
				ENDIF    
		
				=STRTOFILE(.cLastErrorMessage, .cStartPath + 'FRX2Any.ERR', .lFirstErrorMessage)
		
				.lFirstErrorMessage = .T.
				
				.nErrorCount		= .nErrorCount + 1
		
				SET SAFETY &lcSetSafety
		
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE Init
		LOCAL lcStartPath
		
		WITH THIS
		
			lcStartPath = SYS(16, 1)
		
			DO CASE
				CASE RIGHT(TRIM(lcStartPath),3) = 'APP'
		
					.cStartPath = JUSTPATH(lcStartPath)
		
				OTHERWISE
		
					lcStartPath = SUBSTR(lcStartPath, AT(":", lcStartPath) - 1)
		
					.cStartPath	= LEFT(lcStartPath, RAT("\", lcStartPath))
					
			ENDCASE
			
			.cStartPath = ADDBS(.cStartPath)
			
			ERASE .cStartPath + 'FRX2Any.ERR'
		
		ENDWITH
		
	ENDPROC

	PROCEDURE _about		&& Provides documentation for the class
	ENDPROC

	PROCEDURE _cleanup		&& Cleans up member references when the object is released or destroyed
		WITH THIS
			IF ._lRelease
				RETURN .F.
			ENDIF
			._lRelease = .T.
			._ReleaseMembers()
		ENDWITH
		
	ENDPROC

	PROCEDURE _release		&& Releases the object.
		IF THIS._lRelease
			NODEFAULT
			RETURN .F.
		ENDIF 
		
		THIS._Cleanup()
		RELEASE THIS
		
	ENDPROC

	PROCEDURE _releasemembers		&& Abstract method to nuke member references
	ENDPROC

ENDDEFINE

DEFINE CLASS anyde AS anycustom OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: dumpde
		*m: initde
		*m: setdeproperties
		*m: writeclasses
		*m: writecursorclasses
		*m: writedeclass
		*m: writerelationclasses
		*p: cclassname
		*p: ccomment
		*p: cdedefinitionfile
		*p: cinitialselectedalias		&& Specifies an Alias associated with a Cursor object as the current Alias when the Data Environment is loaded.
		*p: cname
		*p: cprocedures
		*p: ctag
		*p: lautoclosetables		&& Specifies if the tables specified by the Data Environment are closed when Report is released.
		*p: lautoopentables		&& Specifies if the tables specified by the Data Environment are opend when Report is loaded.
		*p: ndatasessiondefaultid		&& Default DataSession ID
		*p: ndatasessionprivateid		&& Private DataSession ID
		*p: ndatasessiontype		&& DataSession type
		*p: nopenviews		&& Control with views are opend by OpenTable metod
		*p: ode
		*p: oprivatedatasession		&& Referense to Private DataSession
		*p: oreport
		*a: acursors[1,0]		&& An array of Cursor objects
		*a: arelations[1,0]		&& An array of Relation objects
	*</DefinedPropArrayMethod>

	*<PropValue>
		cclassname = 
		ccomment = 
		cdedefinitionfile = 
		cinitialselectedalias = 
		cname = 
		cprocedures = 
		ctag = 
		lautoclosetables = .T.
		lautoopentables = .T.
		Name = "anyde"
		ndatasessiondefaultid = 1
		ndatasessionprivateid = 1
		ndatasessiontype = 1
		nopenviews = 0
		ode = .NULL.
		oprivatedatasession = .NULL.
		oreport = .NULL.
	*</PropValue>
	
	PROCEDURE dumpde
		LOCAL lcOldSafety
		
		WITH THIS
		
		*-- Have to process DE in any cases !
			.cDEDefinitionFile = ADDBS(SYS(2023))+ SYS(2015)+ '.PRG'
		
		*-- Save the SAFETY setting
			lcOldSafety = SET('SAFETY')
			SET SAFETY OFF
		
			.WriteClasses()
		
			SET SAFETY &lcOldSafety
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS toReport
		
		WITH THIS
			.oReport    = toReport
			.cClassName = SYS(2015)
		
			DIMENSION .aCursors[1]
			.aCursors   = .NULL.
			
			DIMENSION .aRelations[1]	
			.aRelations  = .NULL.
			
			
			.lDisplayerrormessagebox  = toReport.lDisplayerrormessagebox
			.cErrorMessageBoxTitle    = toReport.cErrorMessageBoxTitle
			.cDefaultErrorMessageText = toReport.cDefaultErrorMessageText
			
		ENDWITH
		
		
		
		
	ENDPROC

	PROCEDURE initde
		LOCAL lcDEDefinitionFile
		LOCAL loDE
		LOCAL loSession
		
		LOCAL lcCreateDE
		
		loDE = .NULL.
		
		WITH THIS
			IF !EMPTY(.cDEDefinitionFile)
		
				COMPILE (.cDEDefinitionFile)
		
				IF SET('STATUS BAR') $ 'OFF'
		*-- Clean WAIT WINDOW message
					WAIT CLEAR
				ELSE
		*-- Clear Status bar message
					SET MESSAGE TO ''
				ENDIF
		
				lcDEDefinitionFile = FORCEEXT(.cDEDefinitionFile, 'FXP')
		
		*-- Chsck DS type
				IF .nDataSessionType = cnDATASESSION_PRIVATE
		*-- Create Privat DS
		
					.oPrivateDataSession   = NEWOBJECT('Session')
					.nDataSessionPrivateID = .oPrivateDataSession.DATASESSIONID
		
					SET DATASESSION TO .nDataSessionPrivateID
		
				ENDIF
		
				lcCreateDE = 'DO CreateDE IN (lcDEDefinitionFile) WITH loDE'
		
				&lcCreateDE
		
				.oDE = loDE
		
				IF TYPE('.oDE') = 'O'
				ELSE
					.oDE = .NULL.
				ENDIF
			ENDIF
		ENDWITH
		
		
	ENDPROC

	PROCEDURE setdeproperties
		LPARAMETERS toReportRecord
		
		LOCAL lnCount
		LOCAL lnMemoLines
		LOCAL lnFirstStartPos
		LOCAL lnSecondStartPos
		
		LOCAL lcMemoLine
		LOCAL lcExtractedValue
		LOCAL lcTempString
		
		WITH THIS
		
			.nDataSessionType      = IIF(toReportRecord.Environ, cnDATASESSION_PRIVATE,  cnDATASESSION_DEFAULT)
			.nDataSessionDefaultID = SET('DataSession')	
		
			.cProcedures           = toReportRecord.Tag
		
		*--Need to detect Init method and modify it (if it does not exist - create it)
			lnFirstStartPos = ATC('PROCEDURE Init', .cProcedures)
			lnSecondStartPos = ATC('PROCEDURE Init', .cProcedures, 2)	
		
			DO CASE
			CASE lnFirstStartPos = 0
		*-- Init method is not used in this report's DE, so, will add Init method in DE	
				.cProcedures = .cProcedures + CHR(13) + 'PROCEDURE Init' + CHR(13) + 'IF THIS.AUTOOPENTABLES' + CHR(13) + 'THIS.OPENTABLES()' + CHR(13) + 'ENDIF' + CHR(13) + 'ENDPROC'
		
			CASE lnFirstStartPos > 0 AND lnSecondStartPos = 0 
		*-- Init method is used in this report's DE, and it is unique
				.cProcedures = SUBSTR(.cProcedures, 1, lnFirstStartPos + LEN('PROCEDURE Init') - 1) + CHR(13) + 'IF THIS.AUTOOPENTABLES' + CHR(13) + 'THIS.OPENTABLES()' + CHR(13) + 'ENDIF' + CHR(13) + SUBSTR(.cProcedures, lnFirstStartPos +  LEN('PROCEDURE Init'))
		
			OTHERWISE
		*-- Something definately wrong (probably in DE code there is commented line with "PROCEDURE Init" string)	
			ENDCASE
		
			lnMemoLines = MEMLINES(toReportRecord.EXPR)
		
			FOR lnCount = 1 TO lnMemoLines
		
				lcMemoLine       = MLINE(toReportRecord.EXPR, lnCount)
				lcExtractedValue = .oReport.ExtractValue(lcMemoLine)		
		
				DO CASE
					CASE ATC('Name =', lcMemoLine) > 0
		*-- In order to avoid conflict with existing Form DE substitut 'DataEnvironment' to SYS(2015)
						IF UPPER(lcExtractedValue) = 'DATAENVIRONMENT'
							lcExtractedValue = SYS(2015)
						ENDIF
							
						.cName = lcExtractedValue
		
					CASE ATC('Comment =', lcMemoLine) > 0
						.cComment = lcExtractedValue
		
					CASE ATC('Tag =', lcMemoLine) > 0
						.cTag = lcExtractedValue
		
					CASE ATC('InitialSelectedAlias =', lcMemoLine) > 0
						.cInitialSelectedAlias = lcExtractedValue
		
					CASE ATC('AutoOpenTables =', lcMemoLine) > 0
						.lAutoOpenTables = lcExtractedValue
		
					CASE ATC('AutoCloseTables =', lcMemoLine) > 0
						.lAutoCloseTables = lcExtractedValue
		
					CASE ATC('OpenViews =', lcMemoLine) > 0
						.nOpenViews = lcExtractedValue
						
				ENDCASE
		
			ENDFOR
		
		ENDWITH
		
	ENDPROC

	PROCEDURE writeclasses
		LOCAL lcOldCentury
		LOCAL lnObjects
		
		WITH THIS
		
			SET TEXTMERGE TO (.cDEDefinitionFile) NOSHOW
		
		*-- Write the header first
			SET TEXTMERGE ON
			lcOldCentury = SET('CENTURY')
			SET CENTURY ON
		
			\*  Program...........: <<THIS.cDEDefinitionFile>>
			\*  Generated.........: <<MDY(DATE()) + " - " + TIME()>>
			\*  Generated by......: FRX2Any
			\
			\
			\PROCEDURE CreateDE
			\LPARAMETERS toHook
			\	toHook = CREATEOBJECT('<<.cClassName>>')
			\
			\	IF TYPE('toHook') # 'O'
			\		toHook = .NULL.
			\	ENDIF
			\ENDPROC
			\
		
			SET TEXTMERGE OFF
		
			IF !ISNULL(.aCursors[1])
				.WriteCursorClasses()
			ENDIF
		
			IF !ISNULL(.aRelations[1])
				.WriteRelationClasses()
			ENDIF
		
			.WriteDEClass()
		
			SET TEXTMERGE OFF
			SET TEXTMERGE TO
			
			SET CENTURY &lcOldCentury
		
		ENDWITH
		
	ENDPROC

	PROCEDURE writecursorclasses
		LOCAL lnCount
		LOCAL lnObjects
		LOCAL loObjects
		
		
		SET TEXTMERGE ON
		
		WITH THIS
		
			lnObjects = ALEN(.aCursors, 1)
		
			FOR lnCount = 1 TO lnObjects
		
				loObjects = .aCursors[lnCount]
		
				WITH loObjects
		
					\DEFINE CLASS <<.cClassName>> AS CURSOR
					\    Alias 				= '<<.cAlias>>'
					\    CursorSource 		= '<<.cCursorSource>>'
					\    DataBase 			= '<<.cDataBase>>'
					\    Order 				= '<<.cOrder>>'			
					\    Filter 			= '<<.cFilter>>'		
					\    Comment 			= '<<.cComment>>'
					\    Tag		 		= '<<.cTag>>'
					\    Name 				= '<<.cName>>'			
					\    BufferModeOverride	= <<.nBufferModeOverride>>						
					\    Exclusive			= <<.lExclusive>>						
					\    ReadOnly			= <<.lReadOnly>>						
					\    NoDataOnLoad		= <<.lNoDataOnLoad>>												
					\
					\<<.cProcedures>>									
					\
					\ENDDEFINE
					\
					
				ENDWITH
			ENDFOR
		ENDWITH
		
		SET TEXTMERGE OFF
		
		
		
	ENDPROC

	PROCEDURE writedeclass
		LOCAL lnCount
		LOCAL lnObjects
		LOCAL loObjects
		
		SET TEXTMERGE ON
		
		WITH THIS
		
			\DEFINE CLASS <<.cClassName>> AS DataEnvironment
				\    Name 				  = '<<.cName>>'			
				\    Comment 			  = '<<.cComment>>'
				\    InitialSelectedAlias = '<<.cInitialSelectedAlias>>'
				\    Tag		 		  = '<<.cTag>>'		
				\    AutoCloseTables	  = <<.lAutoCloseTables>>								
				\    AutoOpenTables		  = <<.lAutoOpenTables>>										
				\    OpenViews			  = <<.nOpenViews>>								
				\		
		
		
			IF !ISNULL(.aCursors[1])
				lnObjects = ALEN(.aCursors, 1)
		
				FOR lnCount = 1 TO lnObjects
		
					loObjects = .aCursors[lnCount]
		
					WITH loObjects
					\    ADD OBJECT <<.cName>> AS <<.cClassName>>
					ENDWITH
				ENDFOR
			ENDIF
		
			IF !ISNULL(.aRelations[1])
				lnObjects = ALEN(.aRelations, 1)
		
				FOR lnCount = 1 TO lnObjects
		
					loObjects = .aRelations[lnCount]
		
					WITH loObjects
					\    ADD OBJECT <<.cName>> AS <<.cClassName>>
					ENDWITH
				ENDFOR
			ENDIF
			\
			\<<.cProcedures>>
			\
			\ENDDEFINE
			\
		
		ENDWITH
		
		SET TEXTMERGE OFF
		
		
	ENDPROC

	PROCEDURE writerelationclasses
		LOCAL lnCount
		LOCAL lnObjects
		LOCAL loObjects
		
		SET TEXTMERGE ON
		
		WITH THIS
		
			lnObjects = ALEN(.aRelations, 1)
		
			FOR lnCount = 1 TO lnObjects
		
				loObjects = .aRelations[lnCount]
		
				WITH loObjects
		
					\DEFINE CLASS <<.cClassName>> AS RELATION
					\    ChildAlias 	= '<<.cChildAlias>>'
					\    ChildOrder 	= '<<.cChildOrder>>'
					\    Comment 		= '<<.cComment>>'			
					\    Name	 		= '<<.cName>>'						
					\    ParentAlias	= '<<.cParentAlias>>'
					\    RelationalExpr = '<<.cRelationalExpr>>'
					\    Tag			= '<<.cTag>>'			
					\    OneToMany		= <<.lOneToMany>>			
					\
					\<<.cProcedures>>									
					\
					\ENDDEFINE
					\
		
				ENDWITH
		
			ENDFOR
		
		ENDWITH
		
		SET TEXTMERGE OFF
		
	ENDPROC

	PROCEDURE _releasemembers
		*-- Release member objects.
		LOCAL lnCount
		
		LOCAL lcDEDefinitionFile
		LOCAL lcClassName
		
		WITH THIS
		
			FOR lnCount = 1 TO ALEN(.aCursors, 1)
				IF VARTYPE(.aCursors[lnCount]) = 'O'
					
					lcClassName = .aCursors[lnCount].Name
					.aCursors[lnCount]._Release()
					
		*-- Clear a class definition from memory		
					CLEAR CLASS &lcClassName 
					
				ENDIF
			NEXT lnCount
		
			FOR lnCount = 1 TO ALEN(.aRelations, 1)
				IF VARTYPE(.aRelations[lnCount]) = 'O'
		
					lcClassName = .aRelations[lnCount].Name
					.aRelations[lnCount]._Release()
					
		*-- Clear a class definition from memory		
					CLEAR CLASS &lcClassName 
					
				ENDIF
			NEXT lnCount
		
			IF TYPE('.oDE') = 'O' AND !ISNULL(.oDE)	
		
				IF .oDE.AutoCloseTables
					.oDE.CloseTABLES()
				ENDIF
		
				.oDE.DESTROY	
				.oDE = .NULL.		
		
			ENDIF
			
		*-- Chsck DS type
			IF .nDataSessionType = cnDATASESSION_PRIVATE
		*-- Restore Dfault DS
				SET DATASESSION TO .nDataSessionDefaultID
		
				.oPrivateDatasession.DESTROY	
				.oPrivateDatasession = .NULL.		
				
			ENDIF
			
		*-- Clear a class definition from memory		
			lcClassName = .cName
			CLEAR CLASS &lcClassName 
		
			lcDEDefinitionFile = FORCEEXT(.cDEDefinitionFile, 'PRG')
			IF FILE(lcDEDefinitionFile)
				ERASE &lcDEDefinitionFile
			ENDIF
			
			lcDEDefinitionFile = FORCEEXT(.cDEDefinitionFile, 'FXP')
			IF FILE(lcDEDefinitionFile)
				ERASE &lcDEDefinitionFile
			ENDIF
		
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anyfield AS anyobject OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: cdatatype_assign
		*m: cexpression_assign
		*m: cfontname_assign
		*m: cformat_assign
		*m: lfontbold_assign
		*m: lfontitalic_assign
		*m: lfontstrikethru_assign
		*m: lfontunderline_assign
		*m: nfontsize_assign
		*m: nresetat_assign
		*m: ntotaltype_assign
		*p: cdatatype		&& The data type of the expression: "N" for numeric, "D" for date, and "C" for everything else
		*p: cexpression		&& The expression to display
		*p: cfirstcolumn		&& Keeps name of the first column in the range
		*p: cfontname		&& The font to use
		*p: cformat		&& The output format for the field
		*p: cnewstring
		*p: csecondcolumn		&& Keeps name of the second column in the range
		*p: cstring
		*p: csubstring
		*p: lfontbold		&& .T. if the object should be bolded
		*p: lfontitalic		&& .T. if the object should be in italics
		*p: lfontstrikethru
		*p: lfontunderline		&& .T. if the object should be underlined
		*p: naveragevalue
		*p: ncalculatedvalue
		*p: ncellrow		&& Last cell's  row where it was printed
		*p: ncelltop		&& Last top position where sell was printed
		*p: ncellwidth		&& Keeps cell's width for control
		*p: ndivider
		*p: nfontsize		&& The font size to use
		*p: nresetat		&& Specifies where we have to reset the value on. 1 - Report End, 2 - Page End, rest -  group number.
		*p: ntotaltype		&& The total type: 0 for none, 1 for count, 2 for sum, 3 for average, 4 for lowest, 5 for highest, 6 for standard deviation, and 7 for variance
		*p: oreport		&& A reference to the Report File object this object is attached to
		*p: uexpression
		*p: urepeatedvalue
	*</DefinedPropArrayMethod>

	PROTECTED oreport
	*<PropValue>
		cdatatype = C
		cexpression = 
		cfirstcolumn = 
		cfontname = 
		cformat = 
		cnewstring = 
		csecondcolumn = 
		cstring = 
		csubstring = 
		lfontbold = .F.
		lfontitalic = .F.
		lfontunderline = .F.
		Name = "anyfield"
		naveragevalue = 0
		ncalculatedvalue = 0
		ncellrow = 0
		ncelltop = 0
		ncellwidth = 0
		ndivider = 1
		nfontsize = 0
		nobjecttype = 8
		nresetat = 0
		ntotaltype = 0
		oreport = .NULL.
		uexpression = 
		urepeatedvalue = 
	*</PropValue>
	
	PROCEDURE cdatatype_assign
		LPARAMETER tcValue
		DO CASE
			CASE VARTYPE(tcValue) <> 'C'
			CASE NOT INLIST(tcValue, 'C', 'N', 'D')
			OTHERWISE
				THIS.cDataType = tcValue
		ENDCASE
		
	ENDPROC

	PROCEDURE cexpression_assign
		LPARAMETER tcExpression
		
		WITH THIS
		
			DO CASE
				CASE VARTYPE(tcExpression) <> 'C'
				CASE EMPTY(tcExpression) AND !.lStretched
				OTHERWISE
					.cExpression = tcExpression
			ENDCASE
		
		ENDWITH
		
	ENDPROC

	PROCEDURE cfontname_assign
		*-- Ensure that a valid font name was specified.
		LPARAMETER tcValue
		
		LOCAL laFonts[1]
		LOCAL lnFonts
		LOCAL lnCount
		LOCAL lnFont
		LOCAL lnHeight
		
		WITH THIS
			AFONT(laFonts)
			lnFonts = ALEN(laFonts)
			FOR lnCount = 1 TO lnFonts
				laFonts[lnCount] = UPPER(laFonts[lnCount])
			NEXT lnCount
			
			DO CASE
				CASE VARTYPE(tcValue) <> 'C'
				OTHERWISE
					tcValue = IIF(EMPTY(tcValue), .oReport.GetFontName(), tcValue)
		
					lnFont = ASCAN(laFonts, UPPER(tcValue))
					IF lnFont > 0
						lnHeight = .oReport.GetVValue(1, THIS)
						.cFontName = tcValue
						IF .nHeight = lnHeight
							.nHeight = .oReport.GetVValue(1, THIS)
						ENDIF 
					ELSE
					ENDIF 
			ENDCASE
		ENDWITH
		
	ENDPROC

	PROCEDURE cformat_assign
		LPARAMETER tcValue
		
		IF VARTYPE(tcValue) <> 'C'
		ELSE
			THIS.cFormat = tcValue
		ENDIF 
		
	ENDPROC

	PROCEDURE Init
		*-- Set the default height for this object as one "row" high. 
		LPARAMETERS toReport
		
		DODEFAULT()
		  
		WITH THIS
			.oReport   = toReport
		ENDWITH
		
	ENDPROC

	PROCEDURE lfontbold_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lFontBold = tlValue
		ENDIF 
		
	ENDPROC

	PROCEDURE lfontitalic_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lFontItalic = tlValue
		ENDIF 
	ENDPROC

	PROCEDURE lfontstrikethru_assign
		LPARAMETERS vNewVal
		THIS.lfontstrikethru = m.vNewVal
		
	ENDPROC

	PROCEDURE lfontunderline_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lFontUnderline = m.tlValue
		ENDIF
		
	ENDPROC

	PROCEDURE nfontsize_assign
		LPARAMETER tnValue
		
		LOCAL lnHeight
		
		WITH THIS
			DO CASE
				CASE !VARTYPE(tnValue) $ 'NFIBY'
				CASE !BETWEEN(tnValue, 0, 127)
				OTHERWISE
		
					lnHeight = .oReport.GetVValue(1, THIS)
		
					.nFontSize = tnValue
		
					IF .nHeight = lnHeight
						.nHeight = .oReport.GetVValue(1, THIS)
					ENDIF
		
			ENDCASE
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE nresetat_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			OTHERWISE
				THIS.nResetAt = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE ntotaltype_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE INLIST(tnValue, cnTOTAL_NONE, cnTOTAL_COUNT, cnTOTAL_SUM, ;
					cnTOTAL_AVERAGE, cnTOTAL_LOWEST, cnTOTAL_HIGHEST, cnTOTAL_STDDEV, ;
					cnTOTAL_VARIANCE)
		
				THIS.nTotalType = tnValue
			OTHERWISE
		ENDCASE
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anyfile AS anycustom OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: addchart
		*m: addoverobject
		*m: addpage		&& Used by Report Listener
		*m: addproducer
		*m: calculatefactors
		*m: cexportfilename_assign
		*m: cfontname_assign
		*m: cforexpression_assign
		*m: cheadingtext_assign
		*m: checkblacklist
		*m: checklicense
		*m: checklicensekey
		*m: closeapp
		*m: closedocument
		*m: convertpapersize
		*m: copyobject		&& Function that copies an object and all of it child object into a totally new object reference that is not based on a previous reference
		*m: cpassword_assign
		*m: createfileobject
		*m: creportname_assign
		*m: csendcc_assign
		*m: csendto_assign
		*m: csubject_assign
		*m: cunits_assign
		*m: cwhileexpression_assign
		*m: demostamp
		*m: displayversionstatus
		*m: emailoutput		&& E-Mail OutPut File
		*m: encodebase64
		*m: extractvalue
		*m: getalignment
		*m: getalignmentfrompreview
		*m: getbmpfromgenfield
		*m: getbottommargin		&& Return Bottom Margin
		*m: getchart
		*m: getexportfiletype
		*m: getfillpattern
		*m: getfillpatternfrompreview
		*m: getfontname		&& Return system (report's) FontName
		*m: gethfactor		&& Calculates the horizontal factor for the specified font
		*m: gethvalue		&& Calculates a horizontal value in the pixels
		*m: getleftmargin		&& Return Left Paper Margin
		*m: getmoduleid		&& Generte Module ID
		*m: getobjectband		&& Using by FRX2Word
		*m: getorientation		&& Return Paper Orientation
		*m: getoriginalimageheight
		*m: getoriginalimagewidth
		*m: getpapersize		&& Return Paper Size
		*m: getpenpattern
		*m: getpenpatternfrompreview
		*m: getphysicalleftmargin		&& Return Physical Left Margin
		*m: getphysicalpaperleftmargin
		*m: getphysicalpaperlength
		*m: getphysicalpaperlengthwithoutmargin
		*m: getphysicalpapertopmargin
		*m: getphysicalpaperwidth
		*m: getphysicalpaperwidthwithoutmargin
		*m: getrectangletype		&& Return rectangle type
		*m: getrectangletypefrompreview
		*m: getreportband		&& Returns an object reference to the specified band
		*m: getrightmargin		&& Return Right Margin
		*m: getstringheight
		*m: getstringwidth
		*m: gettopmargin		&& Return Top Margin
		*m: gettotalpagestoprint		&& Return numbers of pages that will be printed
		*m: getuserid		&& Genetrate User ID
		*m: getvconvertfactor		&& Get the factor value to convert a vertical report unit to a any unit
		*m: getversion		&& Return FRX2ANY version
		*m: getvfactor		&& Calculates the vertical factor for the specified font
		*m: getvvalue		&& Calculates a vertical values in the pixels
		*m: hexcolor
		*m: initdataenvironment
		*m: initgdiplus
		*m: initreportvariables
		*m: insertband		&& Inserts the specified band objects into the specified document.
		*m: insertobject		&& Inserts the specified object into the specified document.
		*m: insertpreviewobject		&& Insert Preview Report Object into file
