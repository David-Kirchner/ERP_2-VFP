DEFINE CLASS pdffile AS anyfile OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: addpdfpage
		*m: createpdffile
		*m: lcanaddannotation_assign
		*m: lcanassemble_assign
		*m: lcancopyaccess_assign
		*m: lcancopy_assign
		*m: lcanedit_assign
		*m: lcanfillfields_assign
		*m: lcanprintfull_assign
		*m: lcanprint_assign
		*m: lincludefont_assign
		*m: naddtotype_assign
		*m: ncharset_assign
		*m: populatereportcontent
		*m: processfield
		*m: setpassword
		*m: translatefontstyle
		*p: caddto		&& Specify full path to the PDF file to which current PDF file will be added
		*p: cmasterpassword
		*p: creportcontenttable
		*p: lcanaddannotation
		*p: lcanassemble
		*p: lcancopy
		*p: lcancopyaccess
		*p: lcanedit
		*p: lcanfillfields
		*p: lcanprint
		*p: lcanprintfull
		*p: lincludefont		&& Force FRX2Any to include font(s)  into PDF output file
		*p: lreplacespacechar
		*p: ltranslatefontstyle
		*p: naddtotype
		*p: ncharset
		*p: nselecteddocumentid
		*p: nselectedpageid
		*a: ausedfonts[1,2]
		*a: ausedimages[1,2]
	*</DefinedPropArrayMethod>

	*<PropValue>
		cexportfilename = 
		cexportfiletype = 
		cmasterpassword = 
		creportcontenttable = 
		creportname = [None]
		creportpath = 
		csavefolder = 
		cunits = C
		Height = 15
		lreplacespacechar = .T.
		naddtotype = 1
		Name = "pdffile"
		ncharset = 0
		ncolumns = 1
		ncolumnspacing = 0
		nexportfiletype = 0
		nhandleexportfile = 0
		nheight = 0
		nhfactor = 0.0072
		nleftmargin = 0
		npage = 0
		npageheight = 0
		nprintorder = 0
		nselecteddocumentid = 0
		nselectedpageid = 0
		nvfactor = 0.0072
		odetailband = .NULL.
		opagefooterband = .NULL.
		opageheaderband = .NULL.
		osummaryband = .NULL.
		otitleband = .NULL.
		Width = 17
	*</PropValue>
	
	PROCEDURE addpdfpage
		
		LPARAMETERS tlResetPageNumber, tlResetablePageNumber
		
		
		
		LOCAL lnTotalPages
		LOCAL lnResult
		LOCAL lnCount
		
		lnResult = 1
		
		WITH THIS
		
			IF !.lFirstPass
			
		
				IF tlResetablePageNumber
					.lResetablePageNumber = tlResetablePageNumber
				ENDIF
				
				.lResetPageNumber = tlResetPageNumber
			
		
			
				.DemoStamp()
			ENDIF
		
			.nPage        = .nPage + 1
		
		
			.nHeight = .nTopMargin  - .nPhysicalPaperTopMargin
		
			IF !.lFirstPass
				lnResult = .NewPage()
			ELSE
				lnResult = 1
			ENDIF
		
		
		
			IF VARTYPE(.oTitleBand) = 'O'
				.oTitleBand.lPrintInFirstWholeBand = .T.
			ENDIF
		
			IF VARTYPE(.oPageHeaderBand) = 'O'
				.oPageHeaderBand.lPrintInFirstWholeBand = .T.
			ENDIF
		
			IF VARTYPE(.oPageFooterBand) = 'O'
				.oPageFooterBand.lPrintInFirstWholeBand = .T.
			ENDIF
		
			IF VARTYPE(.oDetailBand) = 'O'
				.oDetailBand.lPrintInFirstWholeBand = .T.
			ENDIF
		
			IF VARTYPE(.oSummaryBand) = 'O'
				.oSummaryBand.lPrintInFirstWholeBand = .T.
			ENDIF
		
			FOR lnCount = 1 TO ALEN(.aGroupbands, 1)
				IF VARTYPE(.aGroupbands[lnCount, 1]) = 'O'
					.aGroupbands[lnCount, 1].lPrintInFirstWholeBand = .T.
				ENDIF
				IF VARTYPE(.aGroupbands[lnCount, 2]) = 'O'
					.aGroupbands[lnCount, 2].lPrintInFirstWholeBand = .T.
				ENDIF
		
			NEXT lnCount
		
		
		
		ENDWITH
		
		RETURN (lnResult = 1)
		
	ENDPROC

	PROCEDURE calculatefactors
		LOCAL lnDecimals
		
		lnDecimals = SET('DECIMALS')
		SET DECIMALS TO 9
		
		WITH THIS
			DO CASE
				CASE .cUnits = ccUNITS_CHARACTERS
					
					.nVFactor = cnPOINTS_PER_INCH / cnREPORT_UNITS
					.nHFactor = cnPOINTS_PER_INCH / cnREPORT_UNITS
					
		*-- For an inches scale, use the report units factor.
				CASE .cUnits = ccUNITS_INCHES
		
					.nVFactor = cnPOINTS_PER_INCH / cnREPORT_UNITS
					.nHFactor = cnPOINTS_PER_INCH / cnREPORT_UNITS
		
		*-- For an centimeter scale, use the report units factor divided by the number of centimeters per inch.
				CASE .cUnits = ccUNITS_CENTIMETERS
		
					.nVFactor = cnPOINTS_PER_INCH / cnREPORT_UNITS / 2.54
					.nHFactor = cnPOINTS_PER_INCH / cnREPORT_UNITS / 2.54
		
			ENDCASE
		ENDWITH
		
		SET DECIMALS TO lnDecimals
		
		
	ENDPROC

	PROCEDURE closedocument
		LOCAL lnSelectedDocumentID1
		LOCAL lnSelectedDocumentID2
		LOCAL lnPermissions
		LOCAL lnResult
		
		WITH THIS
		
			FCLOSE(.nHandleExportFile)
		
			IF !.lFirstPass
		
				IF !EMPTY(THIS.aContentsField[1,1])
					THIS.PopulateReportContent()
				ENDIF
		
				lcPDFFile = FORCEEXT(.cSaveFolder + .cExportFileName, ccPDF_EXT)
		
				lnResult = iSEDCompressContent()
				
				IF EMPTY(.cAddTo) OR !FILE(.cAddTo)
					.SetPassword()
				ENDIF
				
				lnResult = iSEDSaveToFile(lcPDFFile)
				lnResult = iSEDRemoveDocument(.nSelectedDocumentID)
		
				IF !EMPTY(.cAddTo) AND FILE(.cAddTo)
					lnResult = iSEDLoadFromFile(lcPDFFile)
					lnSelectedDocumentID1 = iSEDSelectedDocument()
		
					lnResult = iSEDLoadFromFile(.cAddTo)
					lnSelectedDocumentID2 = iSEDSelectedDocument()
		
					IF .nAddToType = cnPDF_ADD_IN_THE_BEGINING
						lnResult = iSEDSelectDocument(lnSelectedDocumentID1)
						lnResult = iSEDMergeDocument(lnSelectedDocumentID2)
		
						.SetPassword()
		
						lnResult = iSEDSaveToFile(lcPDFFile)
						lnResult = iSEDRemoveDocument(lnSelectedDocumentID1)
		
					ELSE
						lnResult = iSEDSelectDocument(lnSelectedDocumentID2)
						lnResult = iSEDMergeDocument(lnSelectedDocumentID1)
		
						.SetPassword()
		
						lnResult = iSEDSaveToFile(lcPDFFile)
						lnResult = iSEDRemoveDocument(lnSelectedDocumentID2)
		
					ENDIF
		
				ENDIF
				
				.nPercentage = 	100
				
			ENDIF
		
		ENDWITH
		
		RETURN lnResult
		
	ENDPROC

	PROCEDURE createpdffile
		DECLARE LONG iSEDUnlockKey           IN iSEDQuickPDF.DLL STRING sRegKey
		DECLARE LONG iSEDNewDocument         IN iSEDQuickPDF.DLL
		DECLARE LONG iSEDSelectDocument      IN iSEDQuickPDF.DLL LONG iDocumentID
		DECLARE LONG iSEDSaveToFile     	 IN iSEDQuickPDF.DLL STRING sFileName
		DECLARE LONG iSEDRemoveDocument 	 IN iSEDQuickPDF.DLL LONG iDocumentID
		DECLARE LONG iSEDSetOrigin           IN iSEDQuickPDF.DLL LONG iOrigin
		DECLARE LONG iSEDCompressContent     IN iSEDQuickPDF.DLL
		
		DECLARE LONG iSEDPageCount           IN iSEDQuickPDF.DLL
		DECLARE LONG iSEDNewPage             IN iSEDQuickPDF.DLL
		DECLARE LONG iSEDSelectPage  	     IN iSEDQuickPDF.DLL LONG iPageNumber
		DECLARE LONG iSEDSetPageDimensions   IN iSEDQuickPDF.DLL DOUBLE dNewPageWidth, DOUBLE dNewPageHeight
		
		DECLARE LONG iSEDDrawImage      	 IN iSEDQuickPDF.DLL DOUBLE dLeft, DOUBLE dTop, DOUBLE dWidth, DOUBLE dHeight
		DECLARE LONG iSEDAddBMPImageFromFile IN iSEDQuickPDF.DLL STRING sFileName
		DECLARE LONG iSEDSelectImage  		 IN iSEDQuickPDF.DLL LONG iImageID
		
		DECLARE LONG iSEDDrawTextBox    	 IN iSEDQuickPDF.DLL DOUBLE dLeft, DOUBLE dTop, DOUBLE dWidth, DOUBLE dHeight, STRING sText, LONG iOptions
		DECLARE LONG iSEDAddLinkToWeb        IN iSEDQuickPDF.DLL DOUBLE dLeft, DOUBLE dTop, DOUBLE dWidth, DOUBLE dHeight, STRING sText, LONG iOptions
		
		DECLARE LONG iSEDSetTextColor   	 IN iSEDQuickPDF.DLL DOUBLE dRed, DOUBLE dGreen, DOUBLE dBlue
		DECLARE LONG iSEDDrawText       	 IN iSEDQuickPDF.DLL DOUBLE dXPos, DOUBLE dYPos, STRING sText
		DECLARE LONG iSEDSetTextSize         IN iSEDQuickPDF.DLL DOUBLE dTextSize
		DECLARE LONG iSEDDrawMultiLineText   IN iSEDQuickPDF.DLL DOUBLE dXPos, DOUBLE dYPos, STRING sDelimiter, STRING sText
		DECLARE LONG iSEDDrawRotatedText     IN iSEDQuickPDF.DLL DOUBLE dXPos, DOUBLE dYPos, DOUBLE dAngle, STRING sText
		DECLARE LONG iSEDDrawSpacedText      IN iSEDQuickPDF.DLL DOUBLE dXPos, DOUBLE dYPos, DOUBLE dSpacing, STRING sText
		DECLARE LONG iSEDSetTextAlign        IN iSEDQuickPDF.DLL LONG iTextAlign
		
		DECLARE LONG iSEDDrawBox             IN iSEDQuickPDF.DLL DOUBLE dLeft, DOUBLE dTop, DOUBLE dWidth, DOUBLE dHeight, LONG iDrawOptions
		DECLARE LONG iSEDDrawRoundedBox      IN iSEDQuickPDF.DLL DOUBLE dLeft, DOUBLE dTop, DOUBLE dWidth, DOUBLE dHeight, DOUBLE dRadius, LONG iDrawOptions
		DECLARE LONG iSEDDrawCircle          IN iSEDQuickPDF.DLL DOUBLE dXPos, DOUBLE dYPos, DOUBLE dRadius, LONG iDrawOptions
		DECLARE LONG iSEDDrawLine            IN iSEDQuickPDF.DLL DOUBLE dStartX, DOUBLE dStartY, DOUBLE dEndX, DOUBLE dEndY
		DECLARE LONG iSEDSetLineColor        IN iSEDQuickPDF.DLL DOUBLE dRed, DOUBLE dGreen, DOUBLE dBlue
		DECLARE LONG iSEDSetFillColor        IN iSEDQuickPDF.DLL DOUBLE dRed, DOUBLE dGreen, DOUBLE dBlue
		DECLARE LONG iSEDSetLineWidth        IN iSEDQuickPDF.DLL DOUBLE dLineWidth
		DECLARE LONG iSEDSetLineDash         IN iSEDQuickPDF.DLL DOUBLE dDashOn , DOUBLE dDashOff
		DECLARE LONG iSEDSetTransparency     IN iSEDQuickPDF.DLL LONG lTransparency
		
		DECLARE LONG iSEDFontCount           IN iSEDQuickPDF.DLL
		DECLARE LONG iSEDFontID              IN iSEDQuickPDF.DLL LONG iIndex
		DECLARE LONG iSEDFontType            IN iSEDQuickPDF.DLL
		DECLARE LONG iSEDSelectFont          IN iSEDQuickPDF.DLL LONG iFontID
		DECLARE LONG iSEDSelectedFont        IN iSEDQuickPDF.DLL
		DECLARE LONG iSEDAddPackagedFont     IN iSEDQuickPDF.DLL STRING sFontPack
		DECLARE LONG iSEDAddStandardFont     IN iSEDQuickPDF.DLL LONG iStandardFontID
		DECLARE LONG iSEDAddTrueTypeFont     IN iSEDQuickPDF.DLL STRING sFontName, LONG iEmbed
		DECLARE STRING iSEDFontName          IN iSEDQuickPDF.DLL
		DECLARE STRING iSEDFontReference     IN iSEDQuickPDF.DLL
		DECLARE LONG iSEDAddStandardFont     IN iSEDQuickPDF.DLL LONG iStandardFontID
		DECLARE LONG iSEDAddSubsettedFont    IN iSEDQuickPDF.DLL STRING sFontName, LONG iCharSet, STRING sSubSetString
		DECLARE STRING iSEDSubsetString      IN iSEDQuickPDF.DLL STRING sSubSetString
		
		DECLARE LONG iSEDNewOutline          IN iSEDQuickPDF.DLL LONG iParent, STRING sTitle, LONG iDestPage, DOUBLE dDestPosition
		
		DECLARE LONG iSEDNewLayer			 IN iSEDQuickPDF.DLL
		DECLARE LONG iSEDSelectLayer 		 IN iSEDQuickPDF.DLL LONG iNewLayer
		DECLARE LONG iSEDMoveLayer 		     IN iSEDQuickPDF.DLL LONG iFromPosition, LONG iToPosition
		DECLARE LONG iSEDLayerCount			 IN iSEDQuickPDF.DLL
		
		DECLARE DOUBLE iSEDGetTextWidth      IN iSEDQuickPDF.DLL STRING sText
		
		DECLARE LONG iSEDMergeDocument       IN iSEDQuickPDF.DLL LONG iDocumentID
		DECLARE LONG iSEDLoadFromFile        IN iSEDQuickPDF.DLL STRING sFileName
		DECLARE LONG iSEDSelectedDocument    IN iSEDQuickPDF.DLL
		
		DECLARE LONG iSEDSetPassword 		 IN iSEDQuickPDF.DLL STRING sPassword
		DECLARE LONG iSEDEncrypt 			 IN iSEDQuickPDF.DLL STRING sOwner, STRING sUser, LONG iStrength, LONG iPermissions
		DECLARE LONG iSEDPermissions 		 IN iSEDQuickPDF.DLL LONG iCanPrint, LONG iCanCopy, LONG iCanChange, LONG iCanAddNotes, LONG iCanFillFields, LONG iCanCopyAccess, LONG iCanAssemble, LONG iCanPrintFull
		
		DECLARE SHORT GetSystemDefaultLangID IN kernel32
		
		DECLARE LONG iSEDDrawBarCode    	 IN iSEDQuickPDF.DLL DOUBLE dLeft, DOUBLE dTop, DOUBLE dWidth, DOUBLE dHeight, STRING sText, LONG iBarCode, LONG iOptions
		
		
		
		LOCAL lnResult
		LOCAL lnLayer
		
		WITH THIS
		
			IF !EMPTY(THIS.aContentsField[1,1])
		
				.cReportContentTable = SYS(2015)
		
				lnSelect = SELECT()
		
				CREATE CURSOR (.cReportContentTable) (;
					cReportObjectName C(10),;
					nPage N(10),;
					nTop N(15,5),;
					mSource M)
		
				SELECT (lnSelect)
			ENDIF
		
			.NEWOBJECT('oPDFUnlock', 'Unlock', ADDBS(JUSTPATH(.CLASSLIBRARY)) +  'Unlock')
		
			lnResult = .oPDFUnlock.PDFUnlock()	
		
			.nSelectedDocumentID = iSEDNewDocument()
		
		
			lnResult = iSEDSelectDocument(.nSelectedDocumentID)
		
			lnResult = iSEDSetOrigin(1)
		
			IF .lPrintableArea
		*-- Use only printable page dimension
				lnResult = iSEDSetPageDimensions(.nPhysicalPaperWidthWithOutMargin, .nPhysicalPaperLengthWithOutMargin)	
			ELSE
				lnResult = iSEDSetPageDimensions(.nPhysicalPaperWidth, .nPhysicalPaperLength)			
			ENDIF	
		
			lnResult = iSEDSelectPage(1)
			lnLayer  = iSEDNewLayer()
		
		ENDWITH
		
		RETURN (lnResult = 1)
		
		
		
		
		
		
	ENDPROC

	PROCEDURE emailoutput
		LOCAL loOutLook
		LOCAL loOutLookItem
		
		LOCAL lcExportFile
		
		LOCAL lnReturn
		LOCAL lnArrayLen
		LOCAL lnCount
		
		lnReturn = cnOk
		
		WITH THIS
		
			.ClearError()
		
			loOutLook = CREATEOBJECT('Outlook.Application')
		
			IF .lHadError OR TYPE('loOutLook') # 'O'
				RETURN cnCANNOT_INSTANCE_OUTLOOK_APP
			ENDIF
		
			loOutLookItem         = loOutLook.CreateItem(0)
			loOutLookItem.Cc      = .cSendCc		
			loOutLookItem.TO      = .cSendTo
			loOutLookItem.Subject = .cSubject
			loOutLookItem.Body   = .cBody
		 
				
			lcExportFile = FORCEEXT(.cSaveFolder + .cExportFileName, ccPDF_EXT)
			
			IF .lAsAttachment
				loOutLookItem.Attachments.ADD(lcExportFile)		
			ELSE
				loOutLookItem.HtmlBody = FILETOSTR(lcExportFile)
			ENDIF
		
			IF .lDisplayBeforeEMail OR EMPTY(.cSendTo)
				loOutLookItem.DISPLAY()
			ELSE
				loOutLookItem.SEND()
			ENDIF
		
		ENDWITH
		
		
		RETURN lnReturn
		
		
	ENDPROC

	PROCEDURE getalignment
		LPARAMETERS tnReportAlignment
		
		LOCAL lnPDFAlignment
		
		DO CASE
		    CASE tnReportAlignment = cnALIGN_RIGHT
		        lnPDFAlignment = cnPDF_ALIGN_RIGHT
		        
		    CASE tnReportAlignment = cnALIGN_CENTER
		        lnPDFAlignment = cnPDF_ALIGN_CENTER
		        
		    OTHER
		        lnPDFAlignment = cnPDF_ALIGN_LEFT
		ENDCASE
		
		RETURN lnPDFAlignment
		
		
	ENDPROC

	PROCEDURE getalignmentfrompreview
		LPARAMETERS tnPreviewAlignment
		
		LOCAL lnPDFAlignment
		
		DO CASE
		    CASE tnPreviewAlignment = cnPREVIEW_ALIGN_RIGHT
		    
		        lnPDFAlignment = cnPDF_ALIGN_RIGHT
		        
		    CASE tnPreviewAlignment = cnPREVIEW_ALIGN_CENTER
		    
		        lnPDFAlignment = cnPDF_ALIGN_CENTER
		        
		    OTHER
		        lnPDFAlignment = cnPDF_ALIGN_LEFT
		ENDCASE
		
		RETURN lnPDFAlignment
		
		
	ENDPROC

	PROCEDURE getfillpattern
		LPARAMETER tnReportFillPattern
		
		LOCAL lnFillPattern
		
		DO CASE
			CASE tnReportFillPattern = cnREPORT_FILL_PATTERN_HORIZONTAL
				lnFillPattern = cnPDF_FILL_PATTERN_HORIZONTAL
				
			CASE tnReportfillPattern = cnREPORT_FILL_PATTERN_VERTICAL
				lnFillPattern = cnPDF_FILL_PATTERN_VERTICAL
				
			CASE tnReportfillPattern = cnREPORT_FILL_PATTERN_DOWNWARD_DIAGONAL
				lnFillPattern = cnPDF_FILL_PATTERN_DOWNWARD_DIAGONAL
				
			CASE tnReportFillPattern = cnREPORT_FILL_PATTERN_UPWARD_DIAGONAL
				lnFillPattern = cnPDF_FILL_PATTERN_UPWARD_DIAGONAL
				
			CASE tnReportFillPattern = cnREPORT_FILL_PATTERN_GRID
				lnFillPattern = cnPDF_FILL_PATTERN_GRID
		
			CASE tnReportFillPattern = cnREPORT_FILL_PATTERN_DIAMOND
				lnFillPattern = cnPDF_FILL_PATTERN_DIAMOND
				
			CASE tnReportFillPattern = cnREPORT_FILL_PATTERN_NO_FILL_ONLY_COLOR
				lnFillPattern = cnPDF_FILL_PATTERN_NO_FILL_ONLY_COLOR
				
			OTHERWISE
				lnFillPattern = cnPDF_FILL_PATTERN_NO_FILL_NO_COLOR
		
		ENDCASE
		
		RETURN lnFillPattern
		
		
	ENDPROC

	PROCEDURE getfillpatternfrompreview
		LPARAMETER tnPreviewFillPattern
		
		LOCAL lnFillPattern
		
		DO CASE
			CASE tnPreviewFillPattern = cnPREVIEW_FILL_PATTERN_HORIZONTAL
			
				lnFillPattern = cnPDF_FILL_PATTERN_HORIZONTAL
				
			CASE tnPreviewfillPattern = cnPREVIEW_FILL_PATTERN_VERTICAL
			
				lnFillPattern = cnPDF_FILL_PATTERN_VERTICAL
				
			CASE tnPreviewfillPattern = cnPREVIEW_FILL_PATTERN_DOWNWARD_DIAGONAL
			
				lnFillPattern = cnPDF_FILL_PATTERN_DOWNWARD_DIAGONAL
				
			CASE tnPreviewFillPattern = cnPREVIEW_FILL_PATTERN_UPWARD_DIAGONAL
			
				lnFillPattern = cnPDF_FILL_PATTERN_UPWARD_DIAGONAL
				
			CASE tnPreviewFillPattern = cnPREVIEW_FILL_PATTERN_GRID
			
				lnFillPattern = cnPDF_FILL_PATTERN_GRID
		
			CASE tnPreviewFillPattern = cnPREVIEW_FILL_PATTERN_DIAMOND
			
				lnFillPattern = cnPDF_FILL_PATTERN_DIAMOND
				
			CASE tnPreviewFillPattern = cnPREVIEW_FILL_PATTERN_NO_FILL_ONLY_COLOR
			
				lnFillPattern = cnPDF_FILL_PATTERN_NO_FILL_ONLY_COLOR
				
			OTHERWISE
				lnFillPattern = cnPDF_FILL_PATTERN_NO_FILL_NO_COLOR
		
		ENDCASE
		
		RETURN lnFillPattern
		
		
	ENDPROC

	PROCEDURE getpenpattern
		LPARAMETER tnReportPenPattern
		
		LOCAL lnPenPattern
		
		DO CASE
			CASE tnReportPenPattern = cnREPORT_PEN_PATTERN_DASHED
				lnPenPattern = cnPDF_PEN_PATTERN_DASHED		
				
			CASE tnReportPenPattern = cnREPORT_PEN_PATTERN_DOTTED
				lnPenPattern = cnPDF_PEN_PATTERN_DOTTED		
				
			CASE tnReportPenPattern = cnREPORT_PEN_PATTERN_DASH_DOT		
				lnPenPattern = cnPDF_PEN_PATTERN_DASH_DOT		
				
			CASE tnReportPenPattern = cnREPORT_PEN_PATTERN_DASH_DOT_DOT	
				lnPenPattern = cnPDF_PEN_PATTERN_DASH_DOT_DOT
				
			CASE tnReportPenPattern = cnREPORT_PEN_PATTERN_NONE
				lnPenPattern = cnPDF_PEN_PATTERN_NONE
		
			OTHERWISE
				lnPenPattern = cnPDF_PEN_PATTERN_NORMAL 	
		ENDCASE
		
		RETURN lnPenPattern
		
		
		
	ENDPROC

	PROCEDURE getpenpatternfrompreview
		LPARAMETER tnPREVIEWPenPattern
		
		LOCAL lnPDFPenPattern
		
		DO CASE
			CASE tnPREVIEWPenPattern = cnPREVIEW_PEN_PATTERN_DASHED
				lnPDFPenPattern = cnPDF_PEN_PATTERN_DASHED
				
			CASE tnPREVIEWPenPattern = cnPREVIEW_PEN_PATTERN_DOTTED
			
				lnPDFPenPattern = cnPDF_PEN_PATTERN_DOTTED		
				
			CASE tnPREVIEWPenPattern = cnPREVIEW_PEN_PATTERN_DASH_DOT
					
				lnPDFPenPattern = cnPDF_PEN_PATTERN_DASH_DOT		
				
			CASE tnPREVIEWPenPattern = cnPREVIEW_PEN_PATTERN_DASH_DOT_DOT
				
				lnPDFPenPattern = cnPDF_PEN_PATTERN_DASH_DOT_DOT
				
			CASE tnPREVIEWPenPattern = cnPREVIEW_PEN_PATTERN_NONE
			
				lnPDFPenPattern = cnPDF_PEN_PATTERN_NONE
		
			OTHERWISE
				lnPDFPenPattern = cnPDF_PEN_PATTERN_NORMAL 	
		ENDCASE
		
		RETURN lnPDFPenPattern
		
	ENDPROC

	PROCEDURE getrectangletype
		LPARAMETERS tnFRXRectangleType
		
		LOCAL lnRectangleType
		
		lnRectangleType = 0
		
		DO CASE
			CASE NOT VARTYPE(tnFRXRectangleType) $ 'NFIBY'
		OTHERWISE
			lnRectangleType = tnFRXRectangleType/2
			lnRectangleType = IIF(lnRectangleType > 20, 20, lnRectangleType)
			
		ENDCASE
		
		RETURN lnRectangleType
		
	ENDPROC

	PROCEDURE getrectangletypefrompreview
		LPARAMETERS tnPreviewRectangleType
		
		LOCAL lnRectangleType
		
		lnRectangleType = 0
		
		DO CASE
			CASE !VARTYPE(tnPreviewRectangleType) $ 'NFIBY'
		OTHERWISE
			lnRectangleType = tnPreviewRectangleType/2
			lnRectangleType = IIF(lnRectangleType > 20, 20, lnRectangleType)	
		ENDCASE
		
		RETURN lnRectangleType
		
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		
		THIS.nExportFileType = cnPDF
		
		
	ENDPROC

	PROCEDURE insertband
		LPARAMETERS toBand, tnGroupNumber, tnCountSkip, tlNewGroup
		
		LOCAL laLinkedToBottom[1]
		
		LOCAL lnObjects
		LOCAL lnCount
		LOCAL lnGroups
		LOCAL lnMaxHeight
		LOCAL lnMaxHeightDelta
		LOCAL lnNewMaxHeight
		LOCAL lnCountRow
		LOCAL lnCountCol
		LOCAL lnTotalRow
		LOCAL lnTotalCol
		LOCAL lnHeightAdjustment
		LOCAL lnPageHeight
		LOCAL lnCountSkip
		LOCAL lnObjectHeight
		LOCAL lnFirstMaxHeight
		LOCAL lnSecondMaxHeight
		LOCAL lnNewHeightOfBand
		
		LOCAL llHaveToReprintHeaders
		LOCAL llNonMultyBandObject
		LOCAL llSkipPrinting
		LOCAL llSkipRecord
		LOCAL llScipStreatcing
		LOCAL llOverItem
		LOCAL llWeAreOnTheSameRecord
		LOCAL llOldFirstOutPutWasDone
		
		LOCAL loObject
		LOCAL loMultyBandObject
		LOCAL loBand
		
		laLinkedToBottom[1] = .NULL.
		
		IF !ISNULL(toBand)
			WITH THIS
				IF toBand.nBandType  = cnBAND_PAGE_HEADER_REPOBJ_CODE AND .lPlain
					IF TYPE('THIS.aMultyBandObject[1, 1]') = 'O'
		
						lnTotalRow = ALEN(.aMultyBandObject, 1)
						lnObjects  = IIF(ISNULL(toBand.aItems), 0, ALEN(toBand.aItems))
		
						FOR lnCount = 1 TO lnObjects
		
							llSkipPrinting = .T.
		
							loObject       = toBand.aItems[lnCount]
		
							IF !EMPTY(loObject.cPrintWhen)
								IF !(EVAL(loObject.cPrintWhen))
									LOOP
								ENDIF
							ENDIF
		
							FOR lnCountRow = 1 TO lnTotalRow
		
								loMultyBandObject = .aMultyBandObject[lnCountRow, 1]
		
								IF loObject.cObjectID = loMultyBandObject.cObjectID
		
									DO CASE
										CASE loObject.nMltBandObjType = cnFROM_PAGE_HEADER_BAND_TO_ANY_BAND
		
											llSkipPrinting = .F.
		
										CASE loObject.nMltBandObjType = cnFROM_PAGE_HEADER_BAND_TO_ANY_BAND_RSZ
		
											llSkipPrinting = .F.
		
											lnHeightAdjustment = .nPageHeight - toBand.nHeight
		
											IF .nPage = 1 AND !ISNULL(.oTitleBand)
												lnHeightAdjustment = lnHeightAdjustment - .oTitleBand.nHeight
											ENDIF
		
											loObject.nHeight = lnHeightAdjustment + loObject.nMltBandObjApndHeight	- cnBAND_HEIGHT * .nVFactor
									ENDCASE
		
									EXIT
		
								ENDIF
		
							NEXT lnCountRow
		
							IF !llSkipPrinting
								llOverItem = .InsertObject(loObject, toBand)
							ENDIF
		
						NEXT lnCount
		
					ENDIF
		
					.nHeight = .nHeight + toBand.nHeight
		
				ELSE
					laLinkedToBottom[1] = .NULL.
					lnCountSkip			= IIF(TYPE('tnCountSkip') = 'N' AND tnCountSkip > 0, tnCountSkip, 1)
		
					DO CASE
						CASE toBand.nBandType = cnBAND_COL_FOOTER_REPOBJ_CODE
		
							.nHeight 			   = .nPageHeight + .nTopMargin 	&&- cnBAND_HEIGHT * .nVFactor
		
							.lDetailLineWasPrinted = .F.
		
						CASE toBand.nBandType = cnBAND_PAGE_FOOTER_REPOBJ_CODE
		
							.nHeight = .nPageHeight
		
							IF 	!ISNULL(.oColumnFooterBand) AND .oColumnFooterBand.nHeight > 0
								.nHeight = .nHeight + .oColumnFooterBand.nHeight
							ENDIF
		
							.lDetailLineWasPrinted = .F.
		
						CASE toBand.lStartOnNewPage AND ;
								toBand.nBandType # cnBAND_TITLE_REPOBJ_CODE AND ;
								toBand.nBandType # cnBAND_SUMMARY_REPOBJ_CODE AND;
								(toBand.nBandType = cnBAND_GROUP_HEADER_REPOBJ_CODE AND toBand.lFirstOutPutWasDone)
		
		
							llSkipRecord = (toBand.nBandType # cnBAND_GROUP_HEADER_REPOBJ_CODE) OR ;
								(toBand.nBandType = cnBAND_GROUP_HEADER_REPOBJ_CODE AND .lDetailLineWasPrinted)
		
		
							llWeAreOnTheSameRecord = .T.
		
							IF llSkipRecord
								llWeAreOnTheSameRecord = BOF()
		
								IF !llWeAreOnTheSameRecord
									SKIP -lnCountSkip
									llWeAreOnTheSameRecord = BOF()
								ENDIF
							ENDIF
		
							.nColumnLeftDelta = 0
							.nCurrentColumn	  = 1
		
							.InsertBand(.oPageFooterBand)
		
							IF llSkipRecord AND !llWeAreOnTheSameRecord
								SKIP lnCountSkip
							ENDIF
							.AddPDFPage(toBand.lResetPageNumber, .T.)
		
							.InsertBand(.oPageHeaderBand)
		
							llHaveToReprintHeaders = .T.
		
						CASE toBand.nBandType = cnBAND_GROUP_HEADER_REPOBJ_CODE AND toBand.lStartInNewColumn AND .nPrintOrder = 0 AND .nColumns <= .nCurrentColumn
		
							llWeAreOnTheSameRecord = BOF()
		
							IF !llWeAreOnTheSameRecord
								SKIP -lnCountSkip
		
								llWeAreOnTheSameRecord = BOF()
		
							ENDIF
		
							.InsertBand(.oColumnFooterBand)
		
							.nColumnLeftDelta = 0
							.nCurrentColumn	  = 1
		
							.InsertBand(.oPageFooterBand)
		
		
							IF !llWeAreOnTheSameRecord
								SKIP lnCountSkip
							ENDIF
		
							.AddPDFPage()
		
		
							.InsertBand(.oPageHeaderBand)
		
							.InsertBand(.oColumnHeaderBand)
		
		
						CASE toBand.nBandType = cnBAND_GROUP_HEADER_REPOBJ_CODE AND toBand.lStartInNewColumn AND .nPrintOrder = 0
		
							IF .nColumns > 1 AND toBand.lFirstOutPutWasDone
		
								llSkipRecord = .lDetailLineWasPrinted
		
								llWeAreOnTheSameRecord = .T.
		
								IF llSkipRecord
									llWeAreOnTheSameRecord = BOF()
		
									IF !llWeAreOnTheSameRecord
										SKIP -lnCountSkip
										llWeAreOnTheSameRecord = BOF()
									ENDIF
								ENDIF
		
								.InsertBand(.oColumnFooterBand)
		
								IF !llWeAreOnTheSameRecord
									SKIP lnCountSkip
								ENDIF
		
		
								.nHeight          = .nColumnTop
		
								.nColumnLeftDelta = (.nColumnWidth + .nColumnSpacing) * .nCurrentColumn
		
								.InsertBand(.oColumnHeaderBand)
		
								.nCurrentColumn   = .nCurrentColumn + 1
		
		
							ENDIF
		
						CASE toBand.nBandType = cnBAND_SUMMARY_REPOBJ_CODE AND;
								THIS.nVFPVersion >= 8 AND;
								toBand.lStartOnNewPage
		
		
							.nColumnLeftDelta = 0
							.nCurrentColumn	  = 1
		
							.InsertBand(.oPageFooterBand)
		
							.AddPDFPage()
		
							.InsertBand(.oPageHeaderBand)
		
		
						CASE toBand.lStartOnNewPage AND toBand.nBandType = cnBAND_SUMMARY_REPOBJ_CODE
		
							.nColumnLeftDelta = 0
							.nCurrentColumn	  = 1
		
							.InsertBand(.oPageFooterBand)
		
							.AddPDFPage
		
						OTHERWISE
		
							IF (.nHeight - .nTopMargin) + toBand.nHeight + IIF(.lWholePage, .nPhysicalPaperTopMargin, 0) > .nPageHeight
		
								IF .nColumns > 1 AND .nCurrentColumn < .nColumns AND .nPrintOrder = 0
		
		
									llWeAreOnTheSameRecord = .T.
		
									IF toBand.nBandType # cnBAND_GROUP_FOOTER_REPOBJ_CODE
										llWeAreOnTheSameRecord = BOF()
		
										IF !llWeAreOnTheSameRecord
											SKIP -lnCountSkip
											llWeAreOnTheSameRecord = BOF()
										ENDIF
									ENDIF
		
									.InsertBand(.oColumnFooterBand)
		
									IF toBand.nBandType # cnBAND_GROUP_FOOTER_REPOBJ_CODE AND !llWeAreOnTheSameRecord
										SKIP lnCountSkip
									ENDIF
		
		
									.nHeight          = .nColumnTop
									.nColumnLeftDelta = (.nColumnWidth + .nColumnSpacing) * .nCurrentColumn
		
									.InsertBand(.oColumnHeaderBand)
		
									.nCurrentColumn   = .nCurrentColumn + 1
		
								ELSE
		
									llWeAreOnTheSameRecord = .T.
		
									IF toBand.nBandType # cnBAND_GROUP_FOOTER_REPOBJ_CODE
										llWeAreOnTheSameRecord = BOF()
		
										IF !llWeAreOnTheSameRecord
											SKIP -lnCountSkip
											llWeAreOnTheSameRecord = BOF()
										ENDIF
									ENDIF
		
									IF .nPrintOrder = 1
		
										lnCurrentHeight = .nHeight
		
										FOR lnCountColumn = 1 TO .nColumns
		
											.nHeight = lnCurrentHeight
		
											.nColumnLeftDelta = (.nColumnWidth + .nColumnSpacing) * (lnCountColumn - 1)
		
											.InsertBand(.oColumnFooterBand)
		
										NEXT
									ELSE
										.InsertBand(.oColumnFooterBand)
									ENDIF
		
									.nColumnLeftDelta = 0
									.nCurrentColumn	  = 1
		
									.InsertBand(.oPageFooterBand)
		
									IF toBand.nBandType # cnBAND_GROUP_FOOTER_REPOBJ_CODE AND !llWeAreOnTheSameRecord
										SKIP lnCountSkip
									ENDIF
		
		
									IF toBand.nBandType = cnBAND_DETAIL_REPOBJ_CODE AND TYPE('tnGroupNumber') = 'N' AND !tlNewGroup AND .lResetPageNumber
										.AddPDFPage(.F.)
									ELSE
										.AddPDFPage(.lResetPageNumber)
									ENDIF
		
									.InsertBand(.oPageHeaderBand)
		
									IF .nPrintOrder = 1
		
										lnCurrentHeight = .nHeight
		
										FOR lnCountColumn = 1 TO .nColumns
		
											.nHeight = lnCurrentHeight
		
											.nColumnLeftDelta = (.nColumnWidth + .nColumnSpacing) * (lnCountColumn - 1)
		
											.InsertBand(.oColumnHeaderBand)
		
										NEXT
									ELSE
										.InsertBand(.oColumnHeaderBand)
									ENDIF
		
		
									llHaveToReprintHeaders = !.llEOF  AND !(toBand.nBandType = cnBAND_GROUP_FOOTER_REPOBJ_CODE)
		
								ENDIF
							ENDIF
					ENDCASE
					IF llHaveToReprintHeaders
		
						lnGroups = IIF(ISNULL(.aGroupBands[1, 1]), 0, ALEN(.aGroupBands, 1))
		
						IF lnGroups > 0
							FOR lnCount = 1 TO lnGroups
		
								loGroupBandHeader = .aGroupBands[lnCount, 1]
		
								IF loGroupBandHeader.NAME == toBand.NAME
									EXIT
								ELSE
									IF loGroupBandHeader.lPrintOnEachPage
		
										llOldFirstOutPutWasDone = loGroupBandHeader.lFirstOutPutWasDone
		
										loGroupBandHeader.lFirstOutPutWasDone = .F.
										.InsertBand(loGroupBandHeader)
		
										loGroupBandHeader.lFirstOutPutWasDone = llOldFirstOutPutWasDone
		
		
									ENDIF
								ENDIF
							NEXT lnCount
						ENDIF
		
					ENDIF
		
					lnMaxHeight = toBand.nHeight
		
					DO CASE
						CASE toBand.nBandType = cnBAND_DETAIL_REPOBJ_CODE
		
							IF .nColumns > 1 AND .nPrintOrder = 1
		
								.nColumnLeftDelta = (.nColumnWidth + .nColumnSpacing) * (.nCurrentColumn - 1)
		
							ENDIF
		
							.ProcessCalculations()
		
							.lDetailLineWasPrinted = .T.
		
						CASE toBand.nBandType = cnBAND_GROUP_HEADER_REPOBJ_CODE AND TYPE('tnGroupNumber') = 'N'
							.ResetCalculations(tnGroupNumber)
					ENDCASE
		
					IF !EMPTY(toBand.cOnEntry)
						EVAL(toBand.cOnEntry)
					ENDIF
		
					DO CASE
						CASE toBand.nBandType = cnBAND_DETAIL_REPOBJ_CODE AND .lSummary
		
						OTHERWISE
		
							lnObjects 		= IIF(ISNULL(toBand.aItems), 0, ALEN(toBand.aItems))
							lnMaxHeightDelta = .ResetRemoveObjects(toBand, , tnGroupNumber, tlNewGroup)
		
							lnMaxHeight      = IIF(.nColumns > 1 AND .nPrintOrder = 1, lnMaxHeight, lnMaxHeight - lnMaxHeightDelta)
		
		
							lnMaxHeight = IIF(lnMaxHeight < 0, 0, lnMaxHeight)
		
		
							lnNewHeightOfBand = lnMaxHeight
		
		
		
							FOR lnCount = 1 TO lnObjects
		
								loObject = toBand.aItems[lnCount]
		
								IF loObject.lDontPrint OR loObject.lRemoved
									LOOP
								ENDIF
		
								IF loObject.nFloat = 3 OR (loObject.lStretch AND (loObject.nObjectType = cnREPOBJ_BOX OR loObject.nObjectType = cnREPOBJ_LINE))
		
									IF !ISNULL(laLinkedToBottom[1])
										DIMENSION laLinkedToBottom[ALEN(laLinkedToBottom) + 1]
									ENDIF
									laLinkedToBottom[ALEN(laLinkedToBottom)] = loObject
		
									LOOP
								ENDIF
		
								llNonMultyBandObject = .T.
		
								IF TYPE('THIS.aMultyBandObject[1, 1]') = 'O'
		
									lnTotalRow = ALEN(.aMultyBandObject, 1)
		
									FOR lnCountRow = 1 TO lnTotalRow
		
										loMultyBandObject = .aMultyBandObject[lnCountRow, 1]
		
										IF loObject.cObjectID = loMultyBandObject.cObjectID
		
											llNonMultyBandObject = .F.
		
											loBelongToBand = .aMultyBandObject[lnCountRow, 3]
		
											DO CASE
												CASE loObject.nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND_RSZ
													llSkipPrinting = .T.
												CASE loObject.nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND
													llSkipPrinting = .T.
												CASE loObject.nMltBandObjType = cnFROM_PAGE_HEADER_BAND_TO_ANY_BAND
												CASE loObject.nMltBandObjType = cnFROM_PAGE_HEADER_BAND_TO_ANY_BAND_RSZ
		
													lnHeightAdjustment = .nPageHeight - loBelongToBand.nHeight
		
													IF .nPage = 1 AND !ISNULL(.oTitleBand)
														lnHeightAdjustment = lnHeightAdjustment - .oTitleBand.nHeight  &&- cnBAND_HEIGHT * .nVFactor
													ENDIF
		
													IF INLIST(loObject.nObjectType, cnREPOBJ_BOX, cnREPOBJ_LINE)
														loObject.nHeight = lnHeightAdjustment + loObject.nMltBandObjApndHeight	- cnBAND_HEIGHT * .nVFactor
													ENDIF
		
												CASE loObject.nMltBandObjType = cnFROM_ANY_BAND_TO_ANY_BAND
											ENDCASE
		
											EXIT
		
										ENDIF
									NEXT
								ENDIF
		
								IF !llSkipPrinting
									llOverItem = .InsertObject(loObject, toBand)
								ELSE
									llSkipPrinting = .F.
								ENDIF
		
								IF llNonMultyBandObject AND !llOverItem
		
									lnNewMaxHeight = loObject.nStretchedHeight + loObject.nVPosition + loObject.nSurDelta  - loObject.nMoveDelta
		
									IF ISNULL(toBand.aOverItems[1]) AND loObject.nHeight < loObject.nStretchedHeight
										lnNewMaxHeight = lnNewMaxHeight +  loObject.nBottomDelta - loObject.nHeight - loObject.nSurBottomDelta
									ENDIF
		
									lnMaxHeight = MAX(lnMaxHeight, lnNewMaxHeight)
		
								ENDIF
							NEXT lnCount
		
							lnFirstMaxHeight  = lnMaxHeight
							lnSecondMaxHeight = 0
		
		
							IF !ISNULL(toBand.aOverItems[1]) AND toBand.nBandType # cnBAND_PAGE_HEADER_REPOBJ_CODE  AND toBand.nBandType # cnBAND_TITLE_REPOBJ_CODE
		
								IF !ISNULL(laLinkedToBottom[1])
		
									llScipStreatcing = .T.
		
									FOR lnCount = 1 TO ALEN(laLinkedToBottom, 1)
		
										loObject = laLinkedToBottom[lnCount]
		
										IF loObject.lStretch AND (loObject.nObjectType = cnREPOBJ_BOX OR loObject.nObjectType = cnREPOBJ_LINE)
		
											IF lnFirstMaxHeight <= toBand.nHeight
												loObject.nStretchedHeight =  lnFirstMaxHeight - loObject.nVPosition + loObject.nMoveDelta &&-(loObject.nBottomDelta - loObject.nHeight)
											ELSE
												loObject.nStretchedHeight =  lnFirstMaxHeight - loObject.nVPosition + loObject.nMoveDelta &&-(loObject.nBottomDelta - loObject.nHeight)
											ENDIF
		
											.InsertObject(loObject, toBand, llScipStreatcing)
		
											loObject.nOveredVPositionDelta = loObject.nVPosition
											loObject.nOveredSurDelta       = loObject.nStretchedHeight
											loObject.nOveredMoveDelta      = loObject.nMoveDelta
											loObject.nVPosition            = 0
											loObject.nMoveDelta            = 0
		
										ENDIF
									NEXT
		
								ENDIF
		
		
								IF .nColumns > 1 AND .nCurrentColumn < .nColumns  AND .nPrintOrder = 0
		
									.InsertBand(.oColumnFooterBand)
		
									.nHeight          = .nColumnTop
									.nColumnLeftDelta = (.nColumnWidth + .nColumnSpacing) * .nCurrentColumn
		
									.InsertBand(.oColumnHeaderBand)
		
									.nCurrentColumn   = .nCurrentColumn + 1
		
								ELSE
									.InsertBand(.oColumnFooterBand)
		
									.nColumnLeftDelta = 0
									.nCurrentColumn	  = 1
		
									.InsertBand(.oPageFooterBand)
		
									.AddPDFPage
		
									.InsertBand(.oPageHeaderBand)
									.InsertBand(.oColumnHeaderBand)
		
								ENDIF
		
								lnObjects = ALEN(toBand.aOverItems, 1)
		
								lnMaxHeight      = 0
								llScipStreatcing = .T.
								llOverItem       = .T.
		
								.ProcessOverObjects(toBand)
		
								FOR lnCount = 1 TO lnObjects
		
									loObject = toBand.aOverItems[lnCount]
		
									.InsertObject(loObject, toBand, llScipStreatcing)
		
									WITH loObject
										lnMaxHeight = MAX(lnMaxHeight, .nStretchedHeight + .nVPosition + .nSurDelta  - .nMoveDelta + ;
											IIF(.nOriginalHeight < .nStretchedHeight, .nBottomDelta - .nOriginalHeight, ;
											IIF(.nOriginalHeight > .nStretchedHeight, .nBottomDelta - .nOriginalHeight + .nOriginalHeight - .nStretchedHeight, 0)))
									ENDWITH
								NEXT
		
								toBand.aOverItems = .NULL.
								lnSecondMaxHeight = lnMaxHeight
		
							ENDIF
		
							IF !ISNULL(laLinkedToBottom[1])
		
								llScipStreatcing = .T.
		
								FOR lnCount = 1 TO ALEN(laLinkedToBottom, 1)
		
									loObject = laLinkedToBottom[lnCount]
		
									IF loObject.lStretch AND (loObject.nObjectType = cnREPOBJ_BOX  OR loObject.nObjectType = cnREPOBJ_LINE)
		
		
		
										IF (lnFirstMaxHeight + lnSecondMaxHeight) < toBand.nHeight
											lnDeltaHeight = lnFirstMaxHeight + lnSecondMaxHeight - loObject.nVPosition - (lnNewHeightOfBand - loObject.nSurBottomPosition)
										ELSE
											lnDeltaHeight = loObject.nHeight +  lnFirstMaxHeight + lnSecondMaxHeight - toBand.nHeight
											IF loObject.lStretch AND (loObject.nObjectType = cnREPOBJ_BOX OR loObject.nObjectType = cnREPOBJ_LINE)
												lnDeltaHeight = lnDeltaHeight + loObject.nSurBottomDelta
											ENDIF
		
										ENDIF
		
										loObject.nStretchedHeight =  lnDeltaHeight;
											+ IIF(loObject.nOveredMoveDelta > 0, loObject.nOveredMoveDelta, loObject.nMoveDelta);
											- loObject.nOveredSurDelta
		
										loObject.nStretchedHeight = IIF(loObject.nStretchedHeight < 0, 0, loObject.nStretchedHeight)
		
		
		
										loObject.nStretchedHeight = IIF(loObject.nStretchedHeight < 0, 0, loObject.nStretchedHeight)
		
		
										.InsertObject(loObject, toBand, llScipStreatcing)
		
										loObject.nVPosition            = IIF(loObject.nOveredVPositionDelta > 0, loObject.nOveredVPositionDelta, loObject.nVPosition)
										loObject.nOveredSurDelta       = 0
										loObject.nOveredMoveDelta      = 0
										loObject.nOveredVPositionDelta = 0
									ELSE
		
										loObject.nVPosition =  lnMaxHeight - loObject.nBottomDelta + IIF(loObject.nMoveDelta < 0, 0, loObject.nMoveDelta)
										.InsertObject(loObject, toBand, llScipStreatcing)
		
									ENDIF
		
								NEXT
		
		
							ENDIF
					ENDCASE
					DO CASE
						CASE toBand.nBandType = cnBAND_TITLE_REPOBJ_CODE AND toBand.lStartOnNewPage
		
		
							IF TYPE('THIS.aMultyBandObject[1, 1]') = 'O'
								lnTotalRow       = ALEN(.aMultyBandObject, 1)
								llScipStreatcing = .T.
		
								FOR lnCountRow = 1 TO lnTotalRow
		
									loObject = .aMultyBandObject[lnCountRow, 1]
		
									DO CASE
										CASE loObject.nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND
		
		
											loObject.nBorderSite = 1
		
											lnObjectHeight   = loObject.nHeight
		
											loObject.nHeight = .nPageHeight + .oPageFooterBand.nHeight - toBand.nHeight + ;
												loObject.nMoveDelta + loObject.nMltBandObjApndHeight - cnBAND_HEIGHT * .nVFactor
		
											.InsertObject(loObject, toBand, llScipStreatcing)
		
											loObject.nHeight = lnObjectHeight
		
										CASE loObject.nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND_RSZ
		
		
											loObject.nHeight = .nPageHeight + .oPageFooterBand.nHeight - ;
												toBand.nHeight  - loObject.nMltBandObjSuffixHeight + ;
												loObject.nMoveDelta + loObject.nMltBandObjApndHeight
		
											.InsertObject(loObject, toBand, llScipStreatcing)
		
											loObject.nBorderSite = 7
											loObject.nHeight     = .nPageHeight + .oPageFooterBand.nHeight
											loObject.nVPosition  = 0
											loObject.nMoveDelta  = 0
		
		
									ENDCASE
								NEXT
							ENDIF
		
							.AddPDFPage
		
						CASE toBand.nBandType = cnBAND_PAGE_FOOTER_REPOBJ_CODE
		
							IF TYPE('THIS.aMultyBandObject[1, 1]') = 'O'
		
								lnTotalRow       = ALEN(.aMultyBandObject, 1)
								llScipStreatcing = .T.
		
								FOR lnCountRow = 1 TO lnTotalRow
		
									loObject       = .aMultyBandObject[lnCountRow, 1]
									loBelongToBand = .aMultyBandObject[lnCountRow, 3]
		
									DO CASE
										CASE loObject.nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND
		
											IF loObject.nBorderSite = 1
		
												loObject.nBorderSite = 7
												loObject.nHeight     = loObject.nHeight - loObject.nMltBandObjApndHeight - loObject.nMoveDelta
												loObject.nVPosition  = 0 &&.nTopMargin
												loObject.nMoveDelta  = 0
		
											ENDIF
		
											.InsertObject(loObject, toBand, llScipStreatcing)
		
											IF loObject.nBorderSite # 7
		
												loObject.nBorderSite = 7
												loObject.nHeight     = loObject.nHeight - loObject.nMltBandObjApndHeight - loObject.nMoveDelta
												loObject.nVPosition  = 0 &&.nTopMargin
												loObject.nMoveDelta  = 0
											ENDIF
		
										CASE loObject.nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND_RSZ
		
		
											IF loObject.nBorderSite # 7
		
												IF toBand.lLastBand AND .nPage < 2
		
												ELSE
													loObject.nHeight = .nPageHeight + .oPageFooterBand.nHeight - ;
														loBelongToBand.nHeight  - loObject.nMltBandObjSuffixHeight + ;
														loObject.nMoveDelta + loObject.nMltBandObjApndHeight
												ENDIF
		
		
		
											ENDIF
		
											.InsertObject(loObject, toBand, llScipStreatcing)
		
											IF loObject.nBorderSite # 7
		
												loObject.nBorderSite = 7
												loObject.nHeight     = .nPageHeight + .oPageFooterBand.nHeight
												loObject.nVPosition  = 0	&&.nTopMargin
												loObject.nMoveDelta  = 0
		
											ENDIF
		
									ENDCASE
								NEXT
							ENDIF
		
							.nHeight = .nHeight + lnMaxHeight
		
						CASE toBand.nBandType = cnBAND_DETAIL_REPOBJ_CODE AND .lSummary
		
						OTHERWISE
		
							.nHeight = .nHeight + lnMaxHeight
					ENDCASE
		
				ENDIF
		
				IF  .nColumns > 1 AND .nPrintOrder = 0 AND toBand.nBandType  = cnBAND_PAGE_HEADER_REPOBJ_CODE
					.nColumnTop = .nHeight
				ENDIF
		
				IF .nColumns > 1 AND .nPrintOrder = 1 AND toBand.nBandType = cnBAND_DETAIL_REPOBJ_CODE
		
					IF .nCurrentColumn < .nColumns
						.nHeight = .nHeight - lnMaxHeight
					ENDIF
		
					.nCurrentColumn   = IIF(.nCurrentColumn < .nColumns, .nCurrentColumn + 1, 1)
		
				ENDIF
		
			ENDWITH
		
			IF !EMPTY(toBand.cOnExit)
				EVAL(toBand.cOnExit)
			ENDIF
		
		ENDIF
		
		
	ENDPROC

	PROCEDURE insertobject
		LPARAMETERS to_MCh_Object, to_MCh_Band, tl_MCh_ScipStreatching
		
		LOCAL lo_MCh_OverObject
		
		LOCAL ll_MCh_OverItem
		LOCAL ll_MCh_ChangeHPosition
		LOCAL ll_MCh_SpetialCharacters
		LOCAL ll_MCh_SpetialCharacters10
		
		LOCAL ln_MCh_LenStringInPx
		LOCAL ln_MCh_NewHeight
		LOCAL ln_MCh_StringHeight
		LOCAL ln_MCh_Count
		LOCAL ln_MCh_WidthDelta
		LOCAL ln_MCh_Decimal
		LOCAL ln_MCh_AT
		LOCAL ln_MCh_ATChr
		LOCAL ln_MCh_LenSubStringInChar
		LOCAL ln_MCh_LenSubStringInPx
		LOCAL ln_MCh_LenNewStringInPx
		LOCAL ln_MCh_PosObjBottom
		LOCAL ln_MCh_PosObjTop
		LOCAL ln_MCh_StringNumber
		LOCAL ln_MCh_VPosition
		LOCAL ln_MCh_HPosition
		LOCAL ln_MCh_RectangleType
		LOCAL ln_MCh_ObjLeft
		LOCAL ln_MCh_ObjTop
		LOCAL ln_MCh_ObjWidth
		LOCAL ln_MCh_ObjHeight
		LOCAL ln_MCh_PosSeparator
		LOCAL ln_MCh_Decimals
		LOCAL ln_MCh_FooterBandHeight
		LOCAL ln_MCh_Result
		LOCAL ln_MCh_XEnd
		LOCAL ln_MCh_YEnd
		LOCAL ln_MCh_TotalParts
		LOCAL ln_MCh_StartOfString
		LOCAL ln_MCh_CharachtersReturned
		
		LOCAL lc_MCh_Separator
		LOCAL lc_MCh_LinePerObject
		LOCAL lc_MCh_Expression
		LOCAL lc_MCh_TypeExpression
		LOCAL lc_MCh_Format
		LOCAL lc_MCh_ImageSource
		LOCAL lc_MCh_LastSetPath
		LOCAL lc_MCh_LastSetDir
		LOCAL lc_MCh_OriginalImageSource
		LOCAL lc_MCh_PartOfString
		LOCAL lc_MCh_FontName
		LOCAL lc_MCh_RestLinePerObject
		
		WITH to_MCh_Object
		
			.nOveredSurDelta   		= 0
		
			ll_MCh_ChangeHPosition  = .F.
			ll_MCh_OverItem         = .F.
		
			IF(.nHPosition + THIS.nColumnLeftDelta) >= THIS.nPageWidth
				RETURN ll_MCh_OverItem
			ENDIF
		
			IF !(.lStretch AND (.nObjectType = cnREPOBJ_BOX OR .nObjectType = cnREPOBJ_LINE))
				.nStretchedHeight  = .nHeight
				.nNewHeight        = .nHeight
			ENDIF
		
			DODEFAULT(to_MCh_Object)
		
			IF !tl_MCh_ScipStreatching
				ln_MCh_PosObjTop    = .nVPosition + .nSurDelta - .nMoveDelta
				ln_MCh_PosObjBottom = .nVPosition + .nSurDelta - .nMoveDelta + .nHeight
		
				ln_MCh_FooterBandHeight = 0
		
				DO CASE
					CASE to_MCh_Band.nBandType = cnBAND_PAGE_FOOTER_REPOBJ_CODE
					
						ln_MCh_FooterBandHeight = THIS.oPageFooterBand.nHeight  
		
		
						IF 	!ISNULL(THIS.oColumnFooterBand) AND THIS.oColumnFooterBand.nHeight > 0
							ln_MCh_FooterBandHeight = ln_MCh_FooterBandHeight + THIS.oColumnFooterBand.nHeight
						ENDIF
		
					CASE to_MCh_Band.nBandType = cnBAND_COL_FOOTER_REPOBJ_CODE
						ln_MCh_FooterBandHeight = THIS.oColumnFooterBand.nHeight
		
				ENDCASE
		
				IF THIS.nHeight + ln_MCh_PosObjTop > THIS.nPageHeight + ln_MCh_FooterBandHeight	+ THIS.nTopMargin 	
		
					IF to_MCh_Band.nBandType	# cnBAND_PAGE_FOOTER_REPOBJ_CODE AND to_MCh_Band.nBandType	# cnBAND_COL_FOOTER_REPOBJ_CODE
		
						lo_MCh_OverObject = to_MCh_Band.AddOverItem(to_MCh_Object)
		
						WITH lo_MCh_OverObject
							.nVPosition         = .nVPosition + .nSurDelta - .nMoveDelta + THIS.nHeight - THIS.nPageHeight
							.nSurDelta	        = 0
							.aSurrounders       = .NULL.
							.nSurBottomPosition = .nVPosition + .nHeight
							.nOriginalHeight    = .nHeight
							.nMoveDelta         = 0
						ENDWITH
					ENDIF
		
					ll_MCh_OverItem = .T.
		
					RETURN ll_MCh_OverItem
				ENDIF
		
			ENDIF
		
			DO CASE
				CASE .nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND_RSZ OR .nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND
					ln_MCh_VPosition  = .nVPosition + .nSurDelta - .nMoveDelta + THIS.nTopMargin
		
				OTHERWISE
		
					ln_MCh_VPosition  = .nVPosition + .nSurDelta - .nMoveDelta + THIS.nHeight
			ENDCASE
		
		
			DO CASE
				CASE .nObjectType = cnREPOBJ_IMAGE AND !THIS.lFirstPass AND !EMPTY(.cImageSource)
					lc_MCh_ImageSource = ''
		
					DO CASE
						CASE .nImageSourceType = cnIMAGE_SOURCE_FILE
							IF FILE(.cImageSource)
								lc_MCh_ImageSource = ADDBS(SYS(2023)) +  FORCEEXT(JUSTSTEM(.cImageSource) + '_' + ALLTRIM(STR(.nHeight)) + '_' + ALLTRIM(STR(.nWidth)) + '_' + ALLTRIM(STR(.nStretch)), JUSTEXT(.cImageSource))
		
								STRTOFILE(FILETOSTR(.cImageSource), lc_MCh_ImageSource)
								
							ENDIF
		
						CASE .nImageSourceType = cnIMAGE_SOURCE_EXPRESSION
							lc_MCh_LastSetPath = SET('PATH')
							lc_MCh_LastSetDir  = SET('DIRECTORY')
		
							CD ADDBS(THIS.cReportPath)
		
							lc_MCh_OriginalImageSource = EVALUATE(.cImageSource)
							lc_MCh_OriginalImageSource = FULLPATH(lc_MCh_OriginalImageSource)
		
							SET PATH TO (lc_MCh_LastSetPath)
							CD (lc_MCh_LastSetDir)
		
							IF FILE(lc_MCh_OriginalImageSource)
								lc_MCh_ImageSource = ADDBS(SYS(2023)) +  FORCEEXT(JUSTSTEM(lc_MCh_OriginalImageSource) + '_' + ALLTRIM(STR(.nHeight)) + '_' + ALLTRIM(STR(.nWidth)) + '_' + ALLTRIM(STR(.nStretch)), JUSTEXT(lc_MCh_OriginalImageSource))
		
								STRTOFILE(FILETOSTR(lc_MCh_OriginalImageSource), lc_MCh_ImageSource)
							ENDIF
		
						CASE .nImageSourceType = cnIMAGE_SOURCE_FIELD
		
		
							lc_MCh_ImageSource = ADDBS(SYS(2023)) +  FORCEEXT(ALLTRIM(STRTRAN(.cImageSource, '.', '_')) + '_' + ALLTRIM(STR(RECNO())) + '_' + ALLTRIM(STR(.nHeight)) + '_' + ALLTRIM(STR(.nWidth)) + '_' + ALLTRIM(STR(.nStretch)), 'BMP')
							lc_MCh_ImageSource = THIS.GetBMPFromGenField(.cImageSource, lc_MCh_ImageSource)
		
					ENDCASE
		
					ln_MCh_HPosition = .nHPosition + THIS.nColumnLeftDelta + THIS.nLeftMargin
		
					IF FILE(lc_MCh_ImageSource)
						THIS.WriteImage(lc_MCh_ImageSource, ln_MCh_VPosition, ln_MCh_HPosition, .nHeight, .nWidth, .nStretch, .cHyperLink)
					ENDIF
		
				CASE .nObjectType = cnREPOBJ_LINE AND !THIS.lFirstPass
		
					ln_MCh_ObjLeft   = .nHPosition + THIS.nColumnLeftDelta  + THIS.nLeftMargin
		
					lnXEnd = IIF(.lVertical, ln_MCh_ObjLeft, ln_MCh_ObjLeft + .nWidth)
					lnYEnd = IIF(.lVertical, IIF(.lStretch, ln_MCh_VPosition + .nStretchedHeight,  ln_MCh_VPosition + .nHeight), ln_MCh_VPosition)
		
					THIS.WriteLine(ln_MCh_VPosition, ln_MCh_ObjLeft, lnYEnd,  lnXEnd, .nPenSize, .nForeColor, .nPenPattern)
		
		
				CASE .nObjectType = cnREPOBJ_BOX AND !THIS.lFirstPass
					ln_MCh_ObjLeft   = .nHPosition + THIS.nColumnLeftDelta  + THIS.nLeftMargin
					
					DO CASE
					CASE !EMPTY(.cChartName)
						THIS.WriteChart(.cChartName, ln_MCh_ObjLeft, ln_MCh_VPosition, .nWidth, .nHeight)
						
					CASE !EMPTY(.cRTFName) AND !THIS.lRTFEngineDemoVersion
						THIS.WriteRTF(.cRTFName, EVAL(.cRTFFieldContentsName), ln_MCh_ObjLeft, ln_MCh_VPosition, .nWidth, .nHeight)				
						
					OTHERWISE
					
						ln_MCh_ObjHeight = IIF(.lStretch, .nStretchedHeight, .nHeight)
		
						THIS.WriteBox(ln_MCh_VPosition, ln_MCh_ObjLeft, ln_MCh_ObjHeight, .nWidth, .nPenSize, .nForeColor, .nPenPattern,;
							.nBackColor, .nBackColor, .nFillPat, .nRectangleType, .cHyperLink, .lStretch)
		
					ENDCASE
				CASE .nObjectType = cnREPOBJ_FIELD	OR .nObjectType = cnREPOBJ_TEXT
		
					lc_MCh_Format = .cFormat
		
					IF !EMPTY(lc_MCh_Format)
						lc_MCh_Format = &lc_MCh_Format
					ENDIF
		
					DO CASE
						CASE .nObjectType = cnREPOBJ_TEXT
							lc_MCh_Expression = to_MCh_Object.cExpression
						OTHERWISE
							lc_MCh_Expression = ALLT(to_MCh_Object.cExpression)
					ENDCASE
		
					IF PEMSTATUS(to_MCh_Object, 'nTotalType', 5) AND ;
							VARTYPE(.nTotalType) $ 'NFIBY' AND ;
							INLIST(.nTotalType, cnTOTAL_COUNT, cnTOTAL_SUM, ;
							cnTOTAL_AVERAGE, cnTOTAL_LOWEST, cnTOTAL_HIGHEST, cnTOTAL_STDDEV, cnTOTAL_VARIANCE)
		
						lcTypeCalculatedValue = VARTYPE(.nCalculatedValue)
		
						DO CASE
							CASE lcTypeCalculatedValue $ 'NFIBY'
								.uExpression = .nCalculatedValue
							CASE lcTypeCalculatedValue = 'L' AND .nTotalType = cnTOTAL_COUNT
								.uExpression = 0
							CASE lcTypeCalculatedValue = 'L' AND .nTotalType = cnTOTAL_SUM
								.uExpression = 0
							OTHERWISE
								.uExpression = '****'
						ENDCASE
		
					ELSE
		
						IF .nObjectType = cnREPOBJ_TEXT  OR .lStretched
							.uExpression = lc_MCh_Expression
						ELSE
							.uExpression = EVAL(lc_MCh_Expression)
						ENDIF
					ENDIF
		
		
					lc_MCh_TypeExpression = VARTYPE(.uExpression)
		
					DO CASE
						CASE .cDataType = 'C' AND lc_MCh_TypeExpression = 'C'
		
							IF LEN(.uExpression) > 255
								.cLinePerObject = .uExpression
							ELSE
								.cLinePerObject = TRANSFORM(.uExpression, lc_MCh_Format)
							ENDIF
							
							.cLinePerObject = STRTRAN(.cLinePerObject, ccTAB, '    ')
							
		
						CASE .cDataType = 'C' AND lc_MCh_TypeExpression = 'N'
							IF EMPTY(lc_MCh_Format)
								.cLinePerObject = ALLTRIM(PADL(.uExpression, 100))
							ELSE
								ln_MCh_Decimal = SET('DECIMAL')
								SET DECIMAL TO 18
								.cLinePerObject = ALLTRIM(TRANSFORM(.uExpression, lc_MCh_Format))
								SET DECIMAL TO ln_MCh_Decimal
							ENDIF
		
						CASE .cDataType = 'N' AND lc_MCh_TypeExpression = 'N'
		
							DO CASE
								CASE EMPTY(lc_MCh_Format)
									.cLinePerObject = ALLTRIM(PADL(.uExpression, 100))
		
								OTHERWISE
									ln_MCh_Decimal = SET('DECIMAL')
		
									IF ATCC('^', lc_MCh_Format) # 0
										SET DECIMAL TO 0
									ELSE
		
										lc_MCh_Separator     = SET('POINT')
										lc_MCh_LinePerObject = ALLTRIM(PADL(.uExpression, 100))
		
										ln_MCh_PosSeparator  = RAT(lc_MCh_Separator, lc_MCh_LinePerObject)
		
										ln_MCh_Decimals      = IIF(ln_MCh_PosSeparator = 0, 0, LEN(lc_MCh_LinePerObject) - ln_MCh_PosSeparator)
		
										SET DECIMAL TO ln_MCh_Decimals
									ENDIF
		
									.cLinePerObject = ALLTRIM(TRANSFORM(.uExpression, lc_MCh_Format))
		
									SET DECIMAL TO ln_MCh_Decimal
							ENDCASE
		
		
							ll_MCh_ChangeHPosition = !.lStretch
		
						OTHERWISE
							
							IF !.lStretched	
								.cLinePerObject = TRANSFORM(.uExpression, lc_MCh_Format)
							ENDIF						
							
					ENDCASE
		
					ln_MCh_ObjLeft   = .nHPosition + THIS.nColumnLeftDelta + THIS.nLeftMargin
					ln_MCh_ObjWidth  = ROUND(.nWidth, 5)
		
					ln_MCh_ObjHeight = .nHeight
		
		
					.cLinePerObject = RTRIM(.cLinePerObject)
		
		
					ln_MCh_StringHeight  = THIS.GetVValue(1, to_MCh_Object) * cnPOINTS_PER_PIXELS
		
		
					DO CASE
						CASE .nObjectType = cnREPOBJ_TEXT
		
							IF AT(ccCR, .cLinePerObject) > 0
								.cLinePerObject   = STRTRAN(.cLinePerObject, ccCR, ccLF)
								to_MCh_Object.lStretch = .T.
							ENDIF
		
						CASE .lStretched
							IF .nHeight  > THIS.nPageHeight
							
								ln_MCh_ObjHeight = THIS.SplitOverObject(to_MCh_Band, to_MCh_Object, .nHeight, ln_MCh_StringHeight)
							
							
		
							ENDIF
		
		
						OTHERWISE
		
		
							.cLinePerObject  = STRTRAN(.cLinePerObject, ccCR + ccLF, ccLF)
							.cLinePerObject  = STRTRAN(.cLinePerObject, ccLF + ccCR, ccLF + ccLF)
							.cLinePerObject  = STRTRAN(.cLinePerObject, ccCR, ccLF)
		
							.cString          = .cLinePerObject
		
		
							ln_MCh_LenStringInPx   = THIS.GetHValue(.cLinePerObject, to_MCh_Object) * cnPOINTS_PER_PIXELS
							ln_MCh_NewHeight       = .nHeight
							ln_MCh_WidthDelta      = ln_MCh_LenStringInPx - .nWidth
		
		
		
							DO CASE
								CASE ln_MCh_WidthDelta => 0 AND ll_MCh_ChangeHPosition
									ln_MCh_ObjLeft  = .nHPosition + THIS.nColumnLeftDelta + THIS.nLeftMargin - ln_MCh_WidthDelta
									ln_MCh_ObjWidth = .nWidth + ln_MCh_WidthDelta
		
								CASE ln_MCh_WidthDelta => 0
		
									.cNewString 	 = ''
									.cSubString	 = ''
		
		
									ln_MCh_NewHeight     = ln_MCh_StringHeight
		
									.cString        = .cLinePerObject
									.cLinePerObject = ''
		
									ll_MCh_SpetialCharacters = .F.
		
									DO WHILE .T.
		
										ln_MCh_AT                 = AT(' ', .cString)
										ln_MCh_ATChr              = AT(ccLF, .cString)
										ln_MCh_AT                 = IIF(ln_MCh_AT = 0, ln_MCh_ATChr, ln_MCh_AT)
										ln_MCh_AT                 = MIN(ln_MCh_AT, IIF(ln_MCh_ATChr = 0, ln_MCh_AT, ln_MCh_ATChr))
		
										.cSubString 	          = IIF(ln_MCh_AT > 0, SUBSTR(.cString, 1, ln_MCh_AT), SUBSTR(.cString, 1))
		
										ln_MCh_LenSubStringInChar = LEN(.cSubString)
										ln_MCh_LenSubStringInPx   = THIS.GetHValue(.cSubString, to_MCh_Object) * cnPOINTS_PER_PIXELS
		
										ln_MCh_LenNewStringInPx   = THIS.GetHValue(.cNewString, to_MCh_Object) * cnPOINTS_PER_PIXELS
		
										DO CASE
											CASE .nWidth < ln_MCh_LenSubStringInPx
		
												IF !ll_MCh_SpetialCharacters
													ln_MCh_NewHeight = ln_MCh_NewHeight + ln_MCh_StringHeight
												ELSE
													ll_MCh_SpetialCharacters = .F.
												ENDIF
		
												ln_MCh_LenSubStringInPx = 0
		
												FOR ln_MCh_Count = 1 TO ln_MCh_LenSubStringInChar
		
													lcChar  = SUBSTR(.cSubString, ln_MCh_Count, 1)
		
													ln_MCh_LenSubStringInPx = ln_MCh_LenSubStringInPx + THIS.GetHValue(lcChar, to_MCh_Object) * cnPOINTS_PER_PIXELS
		
													IF .nWidth <= ln_MCh_LenSubStringInPx
														EXIT
													ENDIF
		
												NEXT
		
												ln_MCh_LenSubStringInChar = IIF(ln_MCh_Count > 1, ln_MCh_Count - 1, 1)
		
												.cSubString 		 = SUBSTR(.cSubString, 1, ln_MCh_LenSubStringInChar)
												.cNewString 		 = IIF(LEN(.cNewString) = 0, .cNewString, .cNewString + ccLF) + .cSubString
		
												.cString = SUBSTR(.cString, ln_MCh_LenSubStringInChar + 1)
		
											CASE .nWidth => ln_MCh_LenSubStringInPx + ln_MCh_LenNewStringInPx
		
												ll_MCh_SpetialCharacters10 = (AT(ccLF, .cSubString) > 0)
												ll_MCh_SpetialCharacters   = ll_MCh_SpetialCharacters10
												.cSubString		   = IIF(ll_MCh_SpetialCharacters10, STRTRAN(.cSubString, ccLF, ''), .cSubString)
												.cNewString           = .cNewString + .cSubString
												.cString	           = SUBSTR(.cString, ln_MCh_LenSubStringInChar + 1)
		
		
												IF LEN(.cString) = 0
													.cLinePerObject = .cLinePerObject + .cNewString
													EXIT
												ELSE
													IF ll_MCh_SpetialCharacters
														ln_MCh_NewHeight     = ln_MCh_NewHeight + ln_MCh_StringHeight
														.cLinePerObject = .cLinePerObject + .cNewString
														.cLinePerObject = .cLinePerObject + ccLF	&&ccCR
														.cNewString     = ''
													ENDIF
												ENDIF
		
											OTHERWISE
		
												ln_MCh_NewHeight     = ln_MCh_NewHeight + ln_MCh_StringHeight
		
												.cLinePerObject = .cLinePerObject + RTRIM(.cNewString)
		
												.cLinePerObject = .cLinePerObject + ccLF	&&ccCR
												.cNewString     = ''
		
										ENDCASE
									ENDDO
		
		
									IF ln_MCh_NewHeight > .nHeight AND .lStretch AND !to_MCh_Band.lConstantBandHeight
										
										.nStretchedHeight = ln_MCh_NewHeight
										.nNewHeight       = ln_MCh_NewHeight
		
										ln_MCh_PosObjBottom = .nStretchedHeight + .nVPosition + .nSurDelta - .nMoveDelta
		
										IF THIS.nHeight + ln_MCh_PosObjBottom > THIS.nPageHeight AND !INLIST(to_MCh_Band.nBandType, cnBAND_PAGE_FOOTER_REPOBJ_CODE, cnBAND_COL_FOOTER_REPOBJ_CODE)								
										
		
											ln_MCh_NewHeight = THIS.AddOverObject(to_MCh_Band, to_MCh_Object, ln_MCh_NewHeight, ln_MCh_PosObjBottom, ln_MCh_StringHeight)
		
											.nStretchedHeight = ln_MCh_NewHeight
		
											IF ln_MCh_NewHeight = 0
												RETURN ll_MCh_OverItem
											ENDIF
		
										ENDIF
										
									ELSE
										ln_MCh_NewHeight = .nHeight
									ENDIF
									
									ln_MCh_AT = AT(ccLF, .cLinePerObject, IIF(ln_MCh_NewHeight < ln_MCh_StringHeight, 1, INT(ln_MCh_NewHeight / ln_MCh_StringHeight))) - 1
		
									IF ln_MCh_AT > 0
										.cLinePerObject = SUBSTR(.cLinePerObject, 1, ln_MCh_AT)
									ENDIF
		
									ln_MCh_ObjHeight = ln_MCh_NewHeight
		
								OTHERWISE
		
									IF SUBSTR(.cLinePerObject, LEN(.cLinePerObject)) = ccLF
										.cLinePerObject = SUBSTR(.cLinePerObject, 1, LEN(.cLinePerObject) - 1)
									ENDIF
		
									ln_MCh_LinesInString = OCCURS(ccLF, .cLinePerObject)
		
		
									ln_MCh_NewHeight     = ln_MCh_StringHeight * (1 + IIF(ln_MCh_LinesInString = 0, 0, ln_MCh_LinesInString))
		
		
									IF ln_MCh_NewHeight > .nHeight AND .lStretch
		
										.nStretchedHeight = ln_MCh_NewHeight
										.nNewHeight       = ln_MCh_NewHeight
		
										ln_MCh_PosObjBottom = .nStretchedHeight + .nVPosition + .nSurDelta - .nMoveDelta
		
										IF THIS.nHeight + ln_MCh_PosObjBottom > THIS.nPageHeight AND !INLIST(to_MCh_Band.nBandType, cnBAND_PAGE_FOOTER_REPOBJ_CODE, cnBAND_COL_FOOTER_REPOBJ_CODE)								
		
											ln_MCh_NewHeight = THIS.AddOverObject(to_MCh_Band, to_MCh_Object, ln_MCh_NewHeight, ln_MCh_PosObjBottom, ln_MCh_StringHeight)
		
											.nStretchedHeight = ln_MCh_NewHeight
		
											IF ln_MCh_NewHeight = 0
												RETURN ll_MCh_OverItem
											ENDIF
										ENDIF
									ELSE
										ln_MCh_NewHeight = .nHeight
		
									ENDIF
		
									ln_MCh_AT = AT(ccLF, .cLinePerObject, IIF(ln_MCh_NewHeight < ln_MCh_StringHeight, 1, INT(ln_MCh_NewHeight / ln_MCh_StringHeight))) - 1
		
		
									IF ln_MCh_AT > 0
										.cLinePerObject = SUBSTR(.cLinePerObject, 1, ln_MCh_AT)
									ENDIF
		
									ln_MCh_ObjHeight = ln_MCh_NewHeight
							ENDCASE
		
					ENDCASE
		
		
				
					IF (!EMPTY(.cLinePerObject) OR THIS.lPrintEmptyField ) AND !THIS.lFirstPass
		
						IF .nObjectType = cnREPOBJ_FIELD AND !EMPTY(THIS.aContentsField[1])
		
							APPEND BLANK IN (THIS.cReportContentTable)
		
							REPLACE nPage WITH THIS.nPage,;
								cReportObjectName WITH .cReportObjectName,;
								nTop WITH ln_MCh_VPosition,;
								mSource WITH RTRIM(.cLinePerObject);
								IN (THIS.cReportContentTable)
		
						ENDIF
		
						.cLinePerObject   = RTRIM(.cLinePerObject)
		
		
						ln_MCh_ObjTop     = ln_MCh_VPosition
						ln_MCh_TotalParts = OCCURS(ccLF, .cLinePerObject)
		
						IF ln_MCh_TotalParts > 0
		
							ln_MCh_TotalParts          = ln_MCh_TotalParts + 1
		
							lc_MCh_RestLinePerObject   = .cLinePerObject
		
		
							FOR ln_MCh_Count = 1 TO ln_MCh_TotalParts
		
								ln_MCh_CharachtersReturned = AT(ccLF, lc_MCh_RestLinePerObject, 1)	&& - 1
		
								DO CASE
									CASE ln_MCh_CharachtersReturned = 1
										lc_MCh_PartOfString = SUBSTR(lc_MCh_RestLinePerObject, 1, ln_MCh_CharachtersReturned)
										ln_MCh_CharachtersReturned = 0
		
									CASE ln_MCh_CharachtersReturned > 1
										ln_MCh_CharachtersReturned = ln_MCh_CharachtersReturned - 1
										lc_MCh_PartOfString = SUBSTR(lc_MCh_RestLinePerObject, 1, ln_MCh_CharachtersReturned)
		
									OTHERWISE
										lc_MCh_PartOfString = SUBSTR(lc_MCh_RestLinePerObject, 1)
								ENDCASE
		
		
								THIS.WriteText(lc_MCh_PartOfString , ln_MCh_ObjTop,ln_MCh_ObjLeft, ln_MCh_StringHeight, ln_MCh_ObjWidth , ;
									.cFontName, .lFontBold, .lFontItalic, .lFontUnderline, .lFontStrikethru, .nFontSize, ;
									.nAlignment, .lTransparent, .nForeColor, .nBackColor, .cHyperLink)
		
		
								ln_MCh_ObjTop            = ln_MCh_ObjTop + ln_MCh_StringHeight
								ln_MCh_StartOfString     = ln_MCh_CharachtersReturned + 2
								lc_MCh_RestLinePerObject = SUBSTR(lc_MCh_RestLinePerObject, ln_MCh_StartOfString)
		
							ENDFOR
		
						ELSE
		
							ln_MCh_LenStringInPx   = ROUND(THIS.GetHValue(.cLinePerObject, to_MCh_Object) * cnPOINTS_PER_PIXELS, 5)
		
							IF (ln_MCh_ObjWidth - ln_MCh_LenStringInPx) <= 0
								ln_MCh_ObjWidth = ln_MCh_ObjWidth + 1.65
							ENDIF
		
		
							THIS.WriteText(.cLinePerObject , ln_MCh_ObjTop,ln_MCh_ObjLeft, ln_MCh_ObjHeight, ln_MCh_ObjWidth , ;
								.cFontName, .lFontBold, .lFontItalic, .lFontUnderline, .lFontStrikethru, .nFontSize, ;
								.nAlignment, .lTransparent, .nForeColor, .nBackColor, .cHyperLink)
		
		
						ENDIF
		
		
					ENDIF
		
			ENDCASE
		ENDWITH
		
		RETURN ll_MCh_OverItem
		
	ENDPROC

	PROCEDURE insertpreviewobject
		LPARAMETERS toObject, tnPageNumber, tnPreviewPageNumber
		
		LOCAL ll_MCh_Transparent
		
		LOCAL lc_MCh_ImageSource
		LOCAL lc_MCh_Old_Exact
		LOCAL lc_MCh_LinePerObject
		LOCAL lc_MCh_FontName
		
		LOCAL ln_MCh_ElementNumber
		LOCAL ln_MCh_Row
		LOCAL ln_MCh_ImageID
		LOCAL ln_MCh_Result
		LOCAL ln_MCh_ForeColor
		LOCAL ln_MCh_Red
		LOCAL ln_MCh_Green
		LOCAL ln_MCh_Blue
		LOCAL ln_MCh_ObjTop
		LOCAL ln_MCh_ObjLeft
		LOCAL ln_MCh_ObjHeight
		LOCAL ln_MCh_ObjWidth
		LOCAL ln_MCh_RectangleType
		LOCAL ln_MCh_OutLine
		LOCAL ln_MCh_FillPattern
		LOCAL ln_MCh_PenPattern
		LOCAL ln_MCh_Alignment
		
		WITH toObject
		
		
			ln_MCh_ObjTop    = (.nTop * cnPOINTS_PER_PIXELS) - IIF(THIS.lPrintableArea, THIS.nPhysicalPaperTopMargin, 0)
			ln_MCh_ObjLeft   = (.nLeft * cnPOINTS_PER_PIXELS) - IIF(THIS.lPrintableArea, THIS.nPhysicalPaperLeftMargin, 0)
			
			
			ln_MCh_ObjHeight = .nHEIGHT * cnPOINTS_PER_PIXELS
			ln_MCh_ObjWidth  = .nWIDTH * cnPOINTS_PER_PIXELS
			
			
			.cHyperLink = IIF(!EMPTY(.cHyperLink), '"' + ALLTRIM(.cHyperLink) + '"' ,'')	
			
		
			DO CASE
				CASE .nObjectType = cnREPOBJ_IMAGE
					IF FILE(.cSource)
				
						lc_MCh_ImageSource = ADDBS(SYS(2023)) +  FORCEEXT(JUSTSTEM(.cSource) + '_' + ALLTRIM(STR(ln_MCh_ObjHeight)) + '_' + ALLTRIM(STR(ln_MCh_ObjWidth)) + '_' + ALLTRIM(STR(.nStretch)), JUSTEXT(.cSource))						
		
						STRTOFILE(FILETOSTR(.cSource), lc_MCh_ImageSource)
					
						THIS.WriteImage(lc_MCh_ImageSource, ln_MCh_ObjTop, ln_MCh_ObjLeft, ln_MCh_ObjHeight, ln_MCh_ObjWidth, .nStretch, .cHyperLink)
					ENDIF
				CASE .nObjectType = cnREPOBJ_LINE
		
					ln_MCh_ForeColor  = IIF(.nBORDERCOLOR < 0, 0, .nBORDERCOLOR)
					ln_MCh_PenPattern = THIS.GetPenpatternfrompreview(.nBorderStyle)
		
					ln_MCh_XEnd = IIF(.lVertical, ln_MCh_ObjLeft, ln_MCh_ObjLeft + ln_MCh_ObjWidth)
					ln_MCh_YEnd = IIF(.lVertical, ln_MCh_ObjTop + ln_MCh_ObjHeight, ln_MCh_ObjTop)
		
					THIS.WriteLine(ln_MCh_ObjTop, ln_MCh_ObjLeft, ln_MCh_YEnd,  ln_MCh_XEnd, .nBorderWidth, ln_MCh_ForeColor, ln_MCh_PenPattern)
		
				CASE .nObjectType = cnREPOBJ_BOX
		
					ln_MCh_PenPattern    = THIS.GetPenpatternfrompreview(.nBorderStyle)
					ln_MCh_FillPattern   = THIS.GetFillPatternFromPreview(.nFillStyle)
					ln_MCh_ForeColor     = IIF(.nBORDERCOLOR < 0, 0, .nBORDERCOLOR)
					ln_MCh_BackColor     = IIF(.nFillColor < 0, RGB(255, 255, 255), .nFillColor)
					ln_MCh_RectangleType = THIS.GetRectangleTypeFromPreview(.nRectangleType)
		
					THIS.WriteBox(ln_MCh_ObjTop, ln_MCh_ObjLeft, ln_MCh_ObjHeight, ln_MCh_ObjWidth, .nBorderWidth, ln_MCh_ForeColor, ln_MCh_PenPattern,;
						ln_MCh_BackColor, ln_MCh_BackColor, ln_MCh_FillPattern, ln_MCh_RectangleType, .cHyperLink, .lStretch)
		
				CASE .nObjectType = cnREPOBJ_RTF
					THIS.WriteRTF(.cRTFID, .cSource, ln_MCh_ObjLeft, ln_MCh_ObjTop, ln_MCh_ObjWidth, ln_MCh_ObjHeight)
		
				CASE .nObjectType = cnREPOBJ_FIELD	OR .nObjectType = cnREPOBJ_TEXT
		
					IF .nObjectType = cnREPOBJ_FIELD AND !EMPTY(THIS.aContentsField[1])
		
						APPEND BLANK IN (THIS.cReportContentTable)
		
						REPLACE nPage WITH tnPageNumber,;
							cReportObjectName WITH .cReportObjectName,;
							nTOP WITH ln_MCh_ObjTop,;
							mSource WITH .cSource;
							IN (THIS.cReportContentTable)
		
					ENDIF
		
					lc_MCh_LinePerObject = .cSource
					
					ll_MCh_Transparent   = IIF(.nBACKSTYLE = 0, .T., .F.)			
		
					ln_MCh_Alignment     = THIS.GetAlignmentFromPreview(.nAlignment)
					ln_MCh_ForeColor     = IIF(.nDisabledForeColor < 0, 0, .nDisabledForeColor)
					ln_MCh_BackColor     = IIF(.nDisabledBackColor < 0, RGB(255, 255, 255), .nDisabledBackColor)
		
					ln_MCh_TotalParts    = OCCURS(ccLF, lc_MCh_LinePerObject)
		
		
					lc_MCh_LinePerObject = STRTRAN(lc_MCh_LinePerObject, ccTAB, '    ')
		
		
					IF ln_MCh_TotalParts > 0
					
						ln_MCh_TotalParts        = ln_MCh_TotalParts + 1
						lc_MCh_RestLinePerObject = lc_MCh_LinePerObject
						ln_MCh_ObjHeight         = .nStringHeight * cnPOINTS_PER_PIXELS
		
						FOR ln_MCh_Count = 1 TO ln_MCh_TotalParts
		
							ln_MCh_CharachtersReturned = AT(ccLF, lc_MCh_RestLinePerObject, 1)
		
							DO CASE
								CASE ln_MCh_CharachtersReturned = 1
									lc_MCh_PartOfString = SUBSTR(lc_MCh_RestLinePerObject, 1, ln_MCh_CharachtersReturned)
									ln_MCh_CharachtersReturned = 0
		
								CASE ln_MCh_CharachtersReturned > 1
									ln_MCh_CharachtersReturned = ln_MCh_CharachtersReturned - 1
									lc_MCh_PartOfString = SUBSTR(lc_MCh_RestLinePerObject, 1, ln_MCh_CharachtersReturned)
		
								OTHERWISE
									lc_MCh_PartOfString = SUBSTR(lc_MCh_RestLinePerObject, 1)
							ENDCASE
		
							THIS.WriteText(lc_MCh_PartOfString, ln_MCh_ObjTop, ln_MCh_ObjLeft, ln_MCh_ObjHeight, ln_MCh_ObjWidth , ;
								.cFontName, .lFontBold, .lFontItalic, .lFontUnderline, .lFontStrikethru, .nFontSize, ;
								ln_MCh_Alignment, ll_MCh_Transparent, ln_MCh_ForeColor, ln_MCh_BackColor, .cHyperLink)
		
							ln_MCh_ObjTop            = ln_MCh_ObjTop + ln_MCh_ObjHeight
							ln_MCh_StartOfString     = ln_MCh_CharachtersReturned + 2
							lc_MCh_RestLinePerObject = SUBSTR(lc_MCh_RestLinePerObject, ln_MCh_StartOfString)
		
						ENDFOR
		
					ELSE
		
						THIS.WriteText(lc_MCh_LinePerObject, ln_MCh_ObjTop, ln_MCh_ObjLeft, ln_MCh_ObjHeight, ln_MCh_ObjWidth , ;
							.cFontName, .lFontBold, .lFontItalic, .lFontUnderline, .lFontStrikethru, .nFontSize, ;
							ln_MCh_Alignment, ll_MCh_Transparent, ln_MCh_ForeColor, ln_MCh_BackColor, .cHyperLink)
		
					ENDIF
		
			ENDCASE
		ENDWITH
		
		
	ENDPROC

