DEFINE CLASS pdfbox AS anybox OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<PropValue>
		Name = "pdfbox"
	*</PropValue>
	
	PROCEDURE npenpattern_assign
		*-- Ensure the pen pattern value is valid.
		LPARAMETER tnValue
		
		IF VARTYPE(tnValue) $ 'NFIBY' AND INLIST(tnValue, ;
				cnPDF_PEN_PATTERN_NORMAL, cnPDF_PEN_PATTERN_DOTTED, cnPDF_PEN_PATTERN_NONE,;
				cnPDF_PEN_PATTERN_DASH_DOT_DOT,cnPDF_PEN_PATTERN_DASHED, cnPDF_PEN_PATTERN_DASH_DOT) 
			THIS.nPenPattern = tnValue
		ELSE
			THIS.nPenPattern = cnPDF_PEN_PATTERN_NORMAL
		ENDIF	
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS pdfcolumn AS pdfband OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: lprintoneachpage_assign
		*m: lresetpage_assign
		*m: lstartinnewcolumn_assign
		*m: nnewpagewhenlessthan_assign
		*p: cexpression		&& The group expression
		*p: lprintoneachpage		&& .T. to print the group header on each page
		*p: lresetpage		&& .T. to reset the page number for each page to 1
		*p: lstartinnewcolumn		&& .T. if each group should start in a new column
		*p: nnewpagewhenlessthan		&& Starts a group on a new page when there is less than this much space left on the current page
	*</DefinedPropArrayMethod>

	*<PropValue>
		cexpression = 
		lprintoneachpage = .F.
		lresetpage = .F.
		lstartinnewcolumn = .F.
		Name = "pdfcolumn"
		nnewpagewhenlessthan = 0
	*</PropValue>
	
	PROCEDURE Init
		LPARAMETERS tcbandtype, toreport, tcGroupHeaderBandID
		
		DODEFAULT(tcbandtype, toreport)
		
		WITH THIS
			IF TYPE('tcGroupHeaderBandID') = 'C'
				.NAME = tcGroupHeaderBandID
			ENDIF
		ENDWITH
		
	ENDPROC

	PROCEDURE lprintoneachpage_assign
		LPARAMETER tlPrintOnEachPage
		
		IF VARTYPE(tlPrintOnEachPage) = 'L'
			THIS.lPrintOnEachPage = tlPrintOnEachPage
		ENDIF
		
	ENDPROC

	PROCEDURE lresetpage_assign
		LPARAMETER tlResetPage
		
		IF VARTYPE(tlResetPage) = 'L'
			THIS.lResetPage = tlResetPage
		ENDIF
	ENDPROC

	PROCEDURE lstartinnewcolumn_assign
		LPARAMETER tlStartInNewColumn
		
		IF VARTYPE(tlStartInNewColumn) = 'L'
			THIS.lStartInNewColumn = tlStartInNewColumn
		ENDIF
		
	ENDPROC

	PROCEDURE nnewpagewhenlessthan_assign
		LPARAMETER tnNewPageWhenLessThan
		
		DO CASE
			CASE NOT VARTYPE(tnNewPageWhenLessThan) $ 'NFIBY'
			CASE NOT BETWEEN(tnNewPageWhenLessThan, 0, 9999)
			OTHERWISE
				THIS.nNewPageWhenLessThan = tnNewPageWhenLessThan
		ENDCASE
		
	ENDPROC

	PROCEDURE setbandproperties
		LPARAMETERS torecord
		
		DODEFAULT(torecord)
		
		WITH THIS
		*-- Set the band height
			.cExpression  = ALLTRIM(torecord.EXPR)
		ENDWITH
		
		
	ENDPROC

ENDDEFINE

