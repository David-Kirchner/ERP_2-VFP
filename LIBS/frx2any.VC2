	PROCEDURE opendocument
		LOCAL loPrinter
		
		LOCAL lnReturn
		
		WITH THIS
		
			lnReturn = cnOk
		
		*-- Just be sure...
			.cExportFileName = IIF(EMPTY(.cExportFileName), SYS(2015), ALLTRIM(.cExportFileName))
		
			.CheckLicense()
		
			IF .nHandleExportFile < 0
				FCLOSE(.nHandleExportFile)
		
				lnReturn = cnERR_CREATING_FILE
		
			ELSE
				=FSEEK(.nHandleExportFile, 0, 2)
		
		*-- Force FRX2ANY to use printable page dimension (W/H) in Image, PDF file creation
				.lPrintableArea = .F.		
		
		*-- Detect all printer's physical characgteristics
				loPrinter = CREATEOBJECT('AnyPrinter')
		
				lnInchesX = 8.5
				lnInchesY = 11
		
		
				IF TYPE('loPrinter') = 'O' AND loPrinter._hDC # 0
		
					lnPhysicalOffsetY = loPrinter._GetPhysicalOffsetY()
					lnPhysicalOffsetX = loPrinter._GetPhysicalOffsetX()
					lnPhysicalHeight  = loPrinter._GetPhysicalHeight()
					lnPrintableHeight = loPrinter._GetPrintableHeight()
					lnPhysicalWidth   = loPrinter._GetPhysicalWidth()
		
					lnTopMargin		  = IIF(lnPhysicalHeight > 0, ((lnInchesY * lnPhysicalOffsetY)/lnPhysicalHeight), 0)
					lnBottomMargin	  = IIF(lnPhysicalHeight > 0, ((lnInchesY * (lnPhysicalHeight - lnPrintableHeight - lnPhysicalOffsetY))/lnPhysicalHeight), 0)
					lnLeftMargin	  = IIF(lnPhysicalWidth > 0, ((lnInchesX *lnPhysicalOffsetX)/lnPhysicalWidth), 0)
		
					lnTopMargin		  = lnTopMargin * cnPIXELS_PER_INCH
					lnBottomMargin	  = lnBottomMargin * cnPIXELS_PER_INCH
					lnLeftMargin	  = lnLeftMargin*cnPIXELS_PER_INCH
		
				ELSE
		
					lnTopMargin		  = cnHTML_TB_MARGIN
					lnBottomMargin	  = cnHTML_TB_MARGIN
					lnLeftMargin	  = cnHTML_LR_MARGIN
		
				ENDIF
		
				.nPhysicalPaperTopMargin  = lnTopMargin
				.nPhysicalPaperBottomMargin = lnBottomMargin
				.nPhysicalPaperLeftMargin = lnLeftMargin
		
		
				.nPhysicalPaperLengthWithOutMargin = .nPhysicalPaperLength - lnTopMargin - lnBottomMargin
				.nPhysicalPaperWidthWithOutMargin  = .nPhysicalPaperWidth - lnLeftMargin*2		
				
		
				DO CASE
					CASE INLIST(.nExportFileType, cnRTF, cnEXCEL, cnPDF, cnWORD)
		
						.nPhysicalPaperWidth 	  = .nPhysicalPaperWidth * cnPOINTS_PER_PIXELS
						.nPhysicalPaperLength 	  = .nPhysicalPaperLength * cnPOINTS_PER_PIXELS
						.nPhysicalPaperLeftMargin = .nPhysicalPaperLeftMargin * cnPOINTS_PER_PIXELS
						.nPhysicalPaperTopMargin  = .nPhysicalPaperTopMargin * cnPOINTS_PER_PIXELS
						.nPhysicalPaperBottomMargin  = .nPhysicalPaperBottomMargin * cnPOINTS_PER_PIXELS
		
						.nPhysicalPaperLengthWithOutMargin = .nPhysicalPaperLengthWithOutMargin * cnPOINTS_PER_PIXELS
						.nPhysicalPaperWidthWithOutMargin  = .nPhysicalPaperWidthWithOutMargin * cnPOINTS_PER_PIXELS
		
				ENDCASE
		
			ENDIF
		
		ENDWITH
		
		RETURN lnReturn
		
	ENDPROC

	PROCEDURE outputto
		WITH THIS
			DO CASE
				CASE .nOutPutType = cnOUTPUT_SCREEN
		
					.ShowOutPut()
		
				CASE .nOutPutType = cnOUTPUT_PRINT
		
					.PrintOutPut()
		
				CASE .nOutPutType = cnOUTPUT_EMAIL
		
					lnReturn = .EMailOutPut()
					
				CASE .nOutPutType = cnOUTPUT_FILE
		
					.CloseApp()			
		
			ENDCASE
		
		ENDWITH
		
	ENDPROC

	PROTECTED PROCEDURE pagesettings
		LPARAMETERS toReportRecord
		
		LOCAL lnCount
		LOCAL lnOrientation
		LOCAL lnPaperSize
		LOCAL lnPaperLength
		LOCAL lnPaperWidth
		LOCAL lcExpr
		LOCAL lcLine
		LOCAL lnInchesX
		LOCAL lnInchesY
		LOCAL lnCustomInchesX
		LOCAL lnCustomInchesY
		
		LOCAL lnPhysicalOffsetY
		LOCAL lnPhysicalHeight
		LOCAL lnPhysicalOffsetX
		LOCAL lnPhysicalWidth
		LOCAL lnPrintableHeight
		
		LOCAL lnTopMargin
		LOCAL lnBottomMargin
		LOCAL lnLeftMargin
		LOCAL lnOldMemoWidth
		
		LOCAL loPrinter
		
		lnOrientation   = 0
		lnCustomInchesX = 0
		lnCustomInchesY = 0
		
		WITH THIS
		
			loPrinter = CREATEOBJECT('AnyPrinter')
		
			lnOldMemoWidth = SET('MEMOWIDTH')
			SET MEMOWIDTH TO 500
		
			lcExpr = toReportRecord.EXPR
		
			FOR lnCount = 1 TO MEMLINES(lcExpr)
		
				lcLine = MLINE(lcExpr, lnCount)
				DO CASE
					CASE ATC('Orientation',lcLine) > 0
						lnOrientation = VAL(.ExtractValue(lcLine))
					CASE ATC('PaperSize',lcLine) > 0
						lnPaperSize = VAL(.ExtractValue(lcLine))
		
					CASE ATC('PaperLength',lcLine) > 0
						lnCustomInchesY = VAL(.ExtractValue(lcLine))/254
						
					CASE ATC('PaperWidth',lcLine) > 0
						lnCustomInchesX = VAL(.ExtractValue(lcLine))/254
						
				ENDCASE
			ENDFOR
		
			.nPaperSize = IIF(EMPTY(lnPaperSize), cnPRTPAPER_LETTER, lnPaperSize)
			
			SET MEMOWIDTH TO lnOldMemoWidth	
			
			.nOrientation = lnOrientation
		
			DO CASE
				CASE .nPaperSize = cnPRTPAPER_LETTER   			  && Letter 8 1/2 x 11 in
					lnInchesX=8.5
					lnInchesY=11
				CASE .nPaperSize = cnPRTPAPER_LETTERSMALL 		  && Letter Small 8 1/2 x 11 in
					lnInchesX=8.5
					lnInchesY=11
				CASE .nPaperSize = cnPRTPAPER_TABLOID     		  && Tabloid 11 x 17 in
					lnInchesX=11
					lnInchesY=17
				CASE .nPaperSize = cnPRTPAPER_LEDGER      		  && Ledger 17 x 11 in
					lnInchesX=17
					lnInchesY=11
				CASE .nPaperSize = cnPRTPAPER_LEGAL       		  && Legal 8 1/2 x 14 in
					lnInchesX=8.5
					lnInchesY=14
				CASE .nPaperSize = cnPRTPAPER_STATEMENT   		  && Statement 5 1/2 x 8 1/2 in
					lnInchesX=5.5
					lnInchesY=8.5
				CASE .nPaperSize = cnPRTPAPER_EXECUTIVE   		  && Executive 7 1/4 x 10 1/2 in
					lnInchesX=7.25
					lnInchesY=10.5
				CASE .nPaperSize = cnPRTPAPER_A3          		  && A3 ISO: 297 x 420 mm, ANSI: 11 3/4 × 16 1/2
					lnInchesX=11.69
					lnInchesY=16.54
				CASE .nPaperSize = cnPRTPAPER_A4          		  && A4 ISO: 210 x 297 mm, ANSI: 8 1/4 × 11 3/4
					lnInchesX=8.267	
					lnInchesY=11.69	
				CASE .nPaperSize = cnPRTPAPER_A4SMALL     		  && A4 Small 210 x 297 mm
					lnInchesX=8.267	
					lnInchesY=11.69	
				CASE .nPaperSize = cnPRTPAPER_A5          		  && A5 148 x 210 mm
					lnInchesX=5.83	
					lnInchesY=8.27	
				CASE .nPaperSize = cnPRTPAPER_B4          		  && B4 250 x 354
					lnInchesX=250/25.4
					lnInchesY=354/25.4
				CASE .nPaperSize = cnPRTPAPER_B5          		  && B5 182 x 257 mm
					lnInchesX=182/25.4
					lnInchesY=257/25.4
				CASE .nPaperSize = cnPRTPAPER_FOLIO       		  && Folio 8 1/2 x 13 in
					lnInchesX=8.5
					lnInchesY=13
				CASE .nPaperSize = cnPRTPAPER_QUARTO      		  && Quarto 215 x 275 mm
					lnInchesX=215/25.4
					lnInchesY=275/25.4
				CASE .nPaperSize = cnPRTPAPER_10X14       		  && 10x14 in
					lnInchesX=10
					lnInchesY=14
				CASE .nPaperSize = cnPRTPAPER_11X17       		  && 11x17 in
					lnInchesX=11
					lnInchesY=17
				CASE .nPaperSize = cnPRTPAPER_NOTE        		  && Note 8 1/2 x 11 in
					lnInchesX=8.5
					lnInchesY=11
				CASE .nPaperSize = cnPRTPAPER_ENV_9       		  && Envelope #9 3 7/8 x 8 7/8
					lnInchesX=3.875
					lnInchesY=8.875
				CASE .nPaperSize = cnPRTPAPER_ENV_10      		  && Envelope #10 4 1/8 x 9 1/2
					lnInchesX=4.125
					lnInchesY=9.5
				CASE .nPaperSize = cnPRTPAPER_ENV_11      		  && Envelope #11 4 1/2 x 10 3/8
					lnInchesX=4.5
					lnInchesY=10.375
				CASE .nPaperSize = cnPRTPAPER_ENV_12      		  && Envelope #12 4 \276 x 11
					lnInchesX=4
					lnInchesY=11
				CASE .nPaperSize = cnPRTPAPER_ENV_14      		  && Envelope #14 5 x 11 1/2
					lnInchesX=5
					lnInchesY=11.5
				CASE .nPaperSize = cnPRTPAPER_ENV_DL      		  && Envelope DL 110 x 220mm
					lnInchesX=110/25.4
					lnInchesY=220/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_C5      		  && Envelope C5 162 x 229 mm
					lnInchesX=162/25.4
					lnInchesY=229/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_C3      		  && Envelope C3  324 x 458 mm
					lnInchesX=324/25.4
					lnInchesY=458/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_C4      		  && Envelope C4  229 x 324 mm
					lnInchesX=229/25.4
					lnInchesY=324/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_C6      		  && Envelope C6  114 x 162 mm
					lnInchesX=114/25.4
					lnInchesY=162/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_C65     		  && Envelope C65 114 x 229 mm
					lnInchesX=114/25.4
					lnInchesY=229/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_B4      		  && Envelope B4  250 x 353 mm
					lnInchesX=250/25.4
					lnInchesY=353/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_B5      		  && Envelope B5  176 x 250 mm
					lnInchesX=176/25.4
					lnInchesY=250/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_B6     		  && Envelope B6  176 x 125 mm
					lnInchesX=176/25.4
					lnInchesY=125/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_ITALY   		  && Envelope 110 x 230 mm
					lnInchesX=110/25.4
					lnInchesY=230/25.4
				CASE .nPaperSize = cnPRTPAPER_ENV_MONARCH 		  && Envelope Monarch 3.875 x 7.5 in
					lnInchesX=3.875
					lnInchesY=7.5
				CASE .nPaperSize = cnPRTPAPER_ENV_PERSONAL		  && 6 3/4 Envelope 3 5/8 x 6 1/2 in
					lnInchesX=3.625
					lnInchesY=6.5
				CASE .nPaperSize = cnPRTPAPER_FANFOLD_US 		  && US Std Fanfold 14 7/8 x 11 in
					lnInchesX=14.875
					lnInchesY=11
				CASE .nPaperSize = cnPRTPAPER_FANFOLD_STD_GERMAN  && German Std Fanfold 8 1/2 x 12 in
					lnInchesX=8.5
					lnInchesY=12
				CASE .nPaperSize = cnPRTPAPER_FANFOLD_LGL_GERMAN  && German Legal Fanfold 8 1/2 x 13 in
					lnInchesX=8.5
					lnInchesY=13
				CASE .nPaperSize = cnPRTPAPER_FANFOLD			  && German Std Fanfold 8 1/2 x 12 in
					lnInchesX=8.5
					lnInchesY=12
				CASE .nPaperSize = cnPRTPAPER_A2          		  && A2 ISO: 420 x 594 mm, ANSI: 16 1/2 × 23 3/8
					lnInchesX=420/25.4
					lnInchesY=594/25.4
				CASE .nPaperSize = cnPRTPAPER_ISO_A4          	  && ISO A4 210 x 297 mm
					lnInchesX=210/25.4
					lnInchesY=297/25.4
				CASE .nPaperSize = cnPRTPAPER_ISO_A3			  && ISO A3 297 x 420 mm
					lnInchesX=297/25.4
					lnInchesY=420/25.4
				CASE .nPaperSize = cnPRTPAPER_ISO_A2         	  && ISO A2 420 x 594 mm
					lnInchesX=420/25.4
					lnInchesY=594/25.4
				CASE .nPaperSize = cnPRTPAPER_ISO_A1         	  && ISO A1 594 x 841 mm
					lnInchesX=594/25.4
					lnInchesY=841/25.4
				CASE .nPaperSize = cnPRTPAPER_ISO_A0         	  && ISO A0 841 x 1189 mm
					lnInchesX=841/25.4
					lnInchesY=1189/25.4
				OTHERWISE  		
		
					IF lnCustomInchesX > 0 AND lnCustomInchesY > 0
						lnInchesX = lnCustomInchesX
						lnInchesY = lnCustomInchesY
					ELSE	
						lnInchesX = 8.5
						lnInchesY = 11
					ENDIF
					
			ENDCASE
		
			DO CASE
				CASE .nExportFileType = cnHTML OR .nExportFileType = cnIMAGE
					lnPaperLength = IIF(.nOrientation = 0, lnInchesY * cnPIXELS_PER_INCH,lnInchesX * cnPIXELS_PER_INCH)
					lnPaperWidth  = IIF(.nOrientation = 0, lnInchesX * cnPIXELS_PER_INCH,lnInchesY * cnPIXELS_PER_INCH)
				CASE .nExportFileType = cnWORD OR .nExportFileType = cnRTF
					lnPaperLength = IIF(.nOrientation = 0, lnInchesY * cnPOINTS_PER_INCH,lnInchesX * cnPOINTS_PER_INCH)
					lnPaperWidth  = IIF(.nOrientation = 0, lnInchesX * cnPOINTS_PER_INCH,lnInchesY * cnPOINTS_PER_INCH)
				CASE .nExportFileType = cnEXCEL
					lnPaperLength = IIF(.nOrientation = 1, lnInchesY * cnPOINTS_PER_INCH,lnInchesX * cnPOINTS_PER_INCH)
					lnPaperWidth  = IIF(.nOrientation = 1, lnInchesX * cnPOINTS_PER_INCH,lnInchesY * cnPOINTS_PER_INCH)
				CASE .nExportFileType = cnPREVIEW
					lnPaperLength = IIF(.nOrientation = 0, lnInchesY * cnPIXELS_PER_INCH,lnInchesX * cnPIXELS_PER_INCH)
					lnPaperWidth  = IIF(.nOrientation = 0, lnInchesX * cnPIXELS_PER_INCH,lnInchesY * cnPIXELS_PER_INCH)
				CASE .nExportFileType = cnPDF OR .nExportFileType = cnXML
					lnPaperLength = IIF(.nOrientation = 0, lnInchesY * cnPOINTS_PER_INCH,lnInchesX * cnPOINTS_PER_INCH)
					lnPaperWidth  = IIF(.nOrientation = 0, lnInchesX * cnPOINTS_PER_INCH,lnInchesY * cnPOINTS_PER_INCH)
			ENDCASE
		
		
		
			.lWholePage = toReportRecord.TOP
		
			IF TYPE('loPrinter') = 'O' AND loPrinter._hDC # 0
		
				lnPhysicalOffsetY = loPrinter._GetPhysicalOffsetY()
				lnPhysicalOffsetX = loPrinter._GetPhysicalOffsetX()
				lnPhysicalHeight  = loPrinter._GetPhysicalHeight()
				lnPrintableHeight = loPrinter._GetPrintableHeight()		
				lnPhysicalWidth   = loPrinter._GetPhysicalWidth()
		
				lnTopMargin		  = IIF(lnPhysicalHeight > 0, ((lnInchesY * lnPhysicalOffsetY)/lnPhysicalHeight), 0)
				lnBottomMargin	  = IIF(lnPhysicalHeight > 0, ((lnInchesY * (lnPhysicalHeight - lnPrintableHeight - lnPhysicalOffsetY))/lnPhysicalHeight), 0)		
				lnLeftMargin	  = IIF(lnPhysicalWidth > 0, ((lnInchesX *lnPhysicalOffsetX)/lnPhysicalWidth), 0)
		
				DO CASE
					CASE .nExportFileType = cnHTML OR .nExportFileType = cnIMAGE
						lnTopMargin		= lnTopMargin * cnPIXELS_PER_INCH
						lnBottomMargin	= lnBottomMargin * cnPIXELS_PER_INCH				
						lnLeftMargin	= lnLeftMargin*cnPIXELS_PER_INCH
						
					CASE .nExportFileType = cnWORD OR .nExportFileType = cnRTF
						lnTopMargin		= lnTopMargin*cnPOINTS_PER_INCH
						lnBottomMargin	= lnBottomMargin * cnPOINTS_PER_INCH
						lnLeftMargin	= lnLeftMargin*cnPOINTS_PER_INCH
						
					CASE .nExportFileType = cnEXCEL
						lnTopMargin		= lnTopMargin * cnPOINTS_PER_INCH
						lnBottomMargin	= lnBottomMargin * cnPOINTS_PER_INCH
						lnLeftMargin	= lnLeftMargin * cnPOINTS_PER_INCH
						
					CASE .nExportFileType = cnPREVIEW
						lnTopMargin		= lnTopMargin * cnPIXELS_PER_INCH
						lnBottomMargin	= lnBottomMargin * cnPIXELS_PER_INCH								
						lnLeftMargin	= lnLeftMargin*cnPIXELS_PER_INCH
						
					CASE .nExportFileType = cnPDF OR .nExportFileType = cnXML
						lnTopMargin		= lnTopMargin*cnPOINTS_PER_INCH
						lnBottomMargin	= lnBottomMargin * cnPOINTS_PER_INCH
						lnLeftMargin	= lnLeftMargin*cnPOINTS_PER_INCH
				ENDCASE
			ELSE
		
				DO CASE
					CASE .nExportFileType = cnHTML OR .nExportFileType = cnIMAGE
						lnTopMargin		= cnHTML_TB_MARGIN
						lnBottomMargin	= cnHTML_TB_MARGIN				
						lnLeftMargin	= cnHTML_LR_MARGIN
					CASE .nExportFileType = cnWORD OR .nExportFileType = cnRTF
						lnTopMargin		= cnWORD_TB_MARGIN
						lnBottomMargin	= cnWORD_TB_MARGIN								
						lnLeftMargin	= cnWORD_LR_MARGIN
					CASE .nExportFileType = cnEXCEL
						lnTopMargin		= cnEXCEL_TB_MARGIN
						lnBottomMargin	= cnEXCEL_TB_MARGIN							
						lnLeftMargin	= cnEXCEL_LR_MARGIN
					CASE .nExportFileType = cnPREVIEW
						lnTopMargin		= cnPREVIEW_TB_MARGIN
						lnBottomMargin	= cnPREVIEW_TB_MARGIN
						lnLeftMargin	= cnPREVIEW_LR_MARGIN
					CASE .nExportFileType = cnPDF OR .nExportFileType = cnXML
						lnTopMargin		= cnPDF_TB_MARGIN
						lnBottomMargin	= cnPDF_TB_MARGIN
						lnLeftMargin	= cnPDF_LR_MARGIN
				ENDCASE
			ENDIF
		
			IF !toReportRecord.TOP
		
				.nPhysicalLeftMargin	= lnLeftMargin
				.nPhysicalTopMargin	    = lnTopMargin
				.nPhysicalBottomMargin	= lnBottomMargin		
		
				.nLeftMargin	= lnLeftMargin + toReportRecord.HPos * .nHFactor
				.nRightMargin	= lnLeftMargin
				.nTopMargin		= lnTopMargin + toReportRecord.TopMargin * .nVFactor
				.nBottomMargin	= lnBottomMargin + toReportRecord.BotMargin * .nVFactor
		
			ELSE
		
				.nPhysicalLeftMargin	= 0	
				.nPhysicalTopMargin	    = 0 
				.nPhysicalBottomMargin  = 0 		
		
				.nLeftMargin	= toReportRecord.HPos * .nHFactor
				.nRightMargin	= 0
				.nTopMargin		= toReportRecord.TopMargin * .nVFactor
				.nBottomMargin	= toReportRecord.BotMargin * .nVFactor
			ENDIF
		
			.nPhysicalPaperLength              = lnPaperLength
			.nPhysicalPaperWidth               = lnPaperWidth
			.nPhysicalPaperLengthWithOutMargin = lnPaperLength - lnTopMargin - lnBottomMargin
			.nPhysicalPaperWidthWithOutMargin  = lnPaperWidth - lnLeftMargin*2
			.nPhysicalPaperTopMargin		   = lnTopMargin 	
			.nPhysicalPaperLeftMargin          = lnLeftMargin
		
		
			.nPageHeight = lnPaperLength - .nTopMargin - .nBottomMargin
		
			.nPrintOrder 	= IIF(toReportRecord.BOTTOM, 1, 0)
			.nColumns 		= toReportRecord.VPos
			.nColumnSpacing	= toReportRecord.HEIGHT * .nHFactor
		
			IF toReportRecord.WIDTH < 0
				.nColumnWidth = lnPaperWidth  - .nLeftMargin - .nRightMargin
		
				.nPageWidth   = (.nColumnWidth * .nColumns) + (.nColumnSpacing * (.nColumns - 1))
		
			ELSE
				.nColumnWidth = toReportRecord.WIDTH * .nHFactor
		
				.nPageWidth   = (.nColumnWidth * .nColumns) + (.nColumnSpacing * (.nColumns - 1))
		
			ENDIF
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE preprocess
		LPARAMETERS tcText, tcFontName, tlFontBold, tlFontItalic, tlFontUnderline, tlFontStrikethrough, tnFontSize, tnWidth, tnHeight, ;
			tnAlignment, tnTrimMode, tnItemType
		
		DECLARE LONG GetDesktopWindow IN Win32API
		
		LOCAL laTextLines[1]
		
		LOCAL loFont
		LOCAL loGraphics
		LOCAL loLayoutArea
		LOCAL loStringFormat
		
		LOCAL lnFontStyle
		LOCAL lnCharsFitted
		LOCAL lnCharsFittedHalf
		LOCAL lnLinesFilled
		LOCAL lnHWND
		LOCAL lnLenPartOfTextToReturn
		LOCAL lnAT
		LOCAL lnATChr
		LOCAL lnCount
		LOCAL lnTotalParts
		
		LOCAL lcText
		LOCAL lcPartOfTextToReturn
		LOCAL lcTextToReturn
		LOCAL lcSubText
		LOCAL lcPartOfSubText
		LOCAL lcSubPartOfSubText
		LOCAL lcWrap
		
		LOCAL llStringTrimming
		LOCAL llWrap
		
		
		IF EMPTY(tcText) AND LEN(tcText) = 0
			RETURN tcText
		ENDIF
		
		lcText = STRTRAN(tcText, ccCR + ccLF, ccCR)
		lcText = STRTRAN(lcText, ccLF, ccCR)
		
		
		lnFontStyle = cnGDIPLUS_FONTSTYLE_REGULAR
		
		IF tlFontBold
			lnFontStyle = BITOR(lnFontStyle, cnGDIPLUS_FONTSTYLE_BOLD)
		ENDIF
		
		IF tlFontItalic
			lnFontStyle = BITOR(lnFontStyle, cnGDIPLUS_FONTSTYLE_ITALIC)
		ENDIF
		
		IF tlFontUnderline
			lnFontStyle = BITOR(lnFontStyle, cnGDIPLUS_FONTSTYLE_UNDERLINE)
		ENDIF
		
		loFont = NEWOBJECT(ccGDIPLUS_CLASS_FONT, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME, '', tcFontName, tnFontSize, lnFontStyle, cnGDIPLUS_UNIT_POINT)
		
		lnHWND = GetDesktopWindow()
		
		*-- Now cerate constant Graphics context
		loGraphics	= NEWOBJECT(ccGDIPLUS_CLASS_GRAPHICS, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME)
		
		*-- Create temporary Graphics context
		loGraphics.CreateFromHWND(lnHWND)
		
		IF tnItemType = cnREPOBJ_TEXT
			lcTextToReturn = lcText
		
		*-- We need to detect one string-line height
			tnHeight = loFont.GetHeight(loGraphics)
		
		ELSE
		
			llStringTrimming = INLIST(tnTrimMode, cnGDIPLUS_STRINGTRIMMING_Character, cnGDIPLUS_STRINGTRIMMING_Word, cnGDIPLUS_STRINGTRIMMING_EllipsisCharacter, cnGDIPLUS_STRINGTRIMMING_EllipsisWord, cnGDIPLUS_STRINGTRIMMING_EllipsisPath)
		
			IF llStringTrimming
		
				loLayoutArea = NEWOBJECT(ccGDIPLUS_CLASS_SIZE, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME, '', tnWidth , tnHeight)
		
		
				loStringFormat = NEWOBJECT(ccGDIPLUS_CLASS_STRINGFORMAT, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME)
		
				loStringFormat.nTrimming = IIF(tnTrimMode = cnGDIPLUS_STRINGTRIMMING_EllipsisPath, cnGDIPLUS_STRINGTRIMMING_EllipsisCharacter, tnTrimMode)
		
		*-- Get the width and height of the text
				loSizeF = loGraphics.MeasureStringA(lcText, loFont, loLayoutArea, loStringFormat, @lnCharsFitted, @lnLinesFilled)
		
				lcTextToReturn = SUBSTR(lcText, 1, lnCharsFitted)
		
				DO CASE
					CASE INLIST(tnTrimMode, cnGDIPLUS_STRINGTRIMMING_EllipsisCharacter, cnGDIPLUS_STRINGTRIMMING_EllipsisWord) AND LEN(lcText) > lnCharsFitted
						lcTextToReturn = lcTextToReturn + '...'
		
		
					CASE INLIST(tnTrimMode, cnGDIPLUS_STRINGTRIMMING_EllipsisPath) AND LEN(lcText) > lnCharsFitted
						lnCharsFittedHalf = INT((lnCharsFitted/lnLinesFilled) * (lnLinesFilled - 0.5))
		
						lcTextToReturn = SUBSTR(lcText, 1, lnCharsFittedHalf) + '...' + RIGHT(lcText, lnCharsFitted - lnCharsFittedHalf - 3)
		
				ENDCASE
		
				llStringTrimming = .F.
		
				lcText = lcTextToReturn
		
			ENDIF
		
		
			IF !llStringTrimming
		
				tnHeight			 = loFont.GetHeight(loGraphics)
				loLayoutArea		 = NEWOBJECT(ccGDIPLUS_CLASS_SIZE, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME, '', tnWidth , tnHeight)
		
				loStringFormat 		 = .NULL.
		
				lcTextToReturn		 = ''
				lcPartOfTextToReturn = ''
				lcSubPartOfSubText   = ''
		
		
				IF THIS.nVfpversion > 6
					lnTotalParts   = ALINES(laTextLines, lcText, .F., ccCR)
				ELSE
					lnTotalParts   = ALINES(laTextLines, lcText, ccCR)
				ENDIF
		
		
				FOR lnCount = 1 TO lnTotalParts
		
		*-- Get the width and height of the text
					loSizeF = loGraphics.MeasureStringA(laTextLines[lnCount], loFont, loLayoutArea, loStringFormat, @lnCharsFitted, @lnLinesFilled)
		
					IF LEN(laTextLines[lnCount]) <= lnCharsFitted
		
						lcTextToReturn = lcTextToReturn  + IIF(EMPTY(lcTextToReturn), '', ccCR) + laTextLines[lnCount]
		
					ELSE
		
						lcSubText = laTextLines[lnCount]
		
						DO WHILE LEN(lcSubText) > 0
		
							lcPartOfSubText = SUBSTR(lcSubText, 1, lnCharsFitted)
		
		
							IF LEN(lcPartOfSubText) < lnCharsFitted OR LEN(lcSubText) = lnCharsFitted
		
								lcSubPartOfSubText = lcPartOfSubText
		
							ELSE
		
								lnAT = RAT(' ', lcPartOfSubText)
		
								lcSubPartOfSubText = IIF(lnAT > 0, SUBSTR(lcPartOfSubText, 1, lnAT), lcPartOfSubText)
		
		
							ENDIF
							lcTextToReturn = lcTextToReturn  + IIF(EMPTY(lcTextToReturn), '', ccCR) +  lcSubPartOfSubText
		
		
							lcSubText = SUBSTR(lcSubText, LEN(lcSubPartOfSubText) + 1)
		
							IF !EMPTY(lcSubText)
		*-- Get the width and height of the SubText. Recalculate lnLinesFilled value for the SubText
								loSizeF = loGraphics.MeasureStringA(lcSubText, loFont, loLayoutArea, loStringFormat, @lnCharsFitted, @lnLinesFilled)
							ENDIF
		
		
						ENDDO
		
					ENDIF
		
				ENDFOR
		
			ENDIF
		
		ENDIF
		
		RETURN lcTextToReturn
		
	ENDPROC

	PROCEDURE printoutput		&& Print output file
	ENDPROC

	PROTECTED PROCEDURE processband
		LPARAMETER toBelongToBand, tnMinValue, tnMaxValue
		
		LOCAL lcCursorOfObjects
		LOCAL lcObjName
		LOCAL lcJustPath
		LOCAL lcReportPath
		LOCAL lcDataFieldName
		LOCAL lcMemoLine
		LOCAL lcExtractMemoLine
		LOCAL lcFolderName
		LOCAL lcPicture
		
		LOCAL loObject
		LOCAL loBelongToBand
		LOCAL loGoThroughtBand
		
		LOCAL lnObjectPosNumber
		LOCAL lnCount
		LOCAL lnCountCol
		LOCAL lnTotalCol
		LOCAL lnObjectHeight
		LOCAL lnStringLen
		LOCAL lnLineWidthDelta
		LOCAL lnLineHeightDelta
		LOCAL lnLineTopDelta
		LOCAL lnLineLeftDelta
		LOCAL lnPenSize
		LOCAL lnMinValue
		LOCAL lnCharPosition
		LOCAL lnMemoLines
		LOCAL lnOldMemoWidth
		
		
		lcCursorOfObjects      = SYS(2015)
		lnObjectPosNumber      = 0
		
		IF toBelongToBand.nBandType  = cnBAND_PAGE_HEADER_REPOBJ_CODE AND !EMPTY(THIS.cHeadingText) AND !THIS.lPlain
		
			lcObjName = SYS(2015)
			loObject  = toBelongToBand.ADDITEM(ccOBJECT_TEXT, lcObjName, lnObjectPosNumber)
		
			WITH loObject
		
				.cExpression 	 = ALLTRIM(THIS.cHeadingText)
				.cFontName  	 = THIS.cFontName
		
				.nFontSize   	 = THIS.nFontSize
				.nBackColor  	 = -1
				.nForeColor      = -1
				.nFloat	         = cnPOSITION_TOP
		
				.nAlignment 	 = THIS.GetAlignment(cnALIGN_CENTER)
		
				.lFontBold   	 = IIF(BITAND(THIS.nFontStyle, cnSTYLE_BOLD) = cnSTYLE_BOLD, .T., .F.)
				.lFontItalic 	 = IIF(BITAND(THIS.nFontStyle, cnSTYLE_ITALIC) = cnSTYLE_ITALIC, .T., .F.)
				.lFontUnderline  = IIF(BITAND(THIS.nFontStyle, cnSTYLE_UNDERLINE) = cnSTYLE_UNDERLINE, .T., .F.)
				.lFontStrikethru = IIF(BITAND(THIS.nFontStyle, cnSTYLE_STRIKETHRU) = cnSTYLE_STRIKETHRU, .T., .F.)
				.lTransparent    = .T.
		
				lcExpression     = EVALUATE('[' + ALLT(.cExpression) + ']')
		
				DO CASE
					CASE THIS.nExportFileType = cnWORD OR THIS.nExportFileType = cnRTF
						lnLineLeftDelta	= - cnWORD_STEP_MEASURE_FACTOR
						.nHeight        = THIS.GetVValue(1, loObject) * cnPOINTS_PER_PIXELS
						.nWidth         = THIS.GetHValue(lcExpression, loObject) * cnPOINTS_PER_PIXELS
		
					CASE THIS.nExportFileType = cnEXCEL
						lnLineLeftDelta =  - cnEXCEL_STEP_MEASURE_FACTOR
						.nHeight        = THIS.GetVValue(1, loObject) * cnPOINTS_PER_PIXELS
						.nWidth         = THIS.GetHValue(lcExpression, loObject) * cnPOINTS_PER_PIXELS
		
					CASE THIS.nExportFileType = cnPDF
						.nHeight        = THIS.GetVValue(1, loObject) * cnPOINTS_PER_PIXELS
						.nWidth         = THIS.GetHValue(lcExpression, loObject) * cnPOINTS_PER_PIXELS
		
					OTHERWISE
						lnLineLeftDelta = 0
						.nHeight        = THIS.GetVValue(1, loObject)
						.nWidth         = THIS.GetHValue(lcExpression, loObject)
				ENDCASE
		
				.nHPosition = ((THIS.nPageWidth - .nWidth)/2)  + lnLineLeftDelta
				.nVPosition = ((tnMaxValue - IIF(tnMinValue = 0, 0, (tnMinValue  + cnBAND_HEIGHT))) * THIS.nVFactor) - .nHeight
		
				IF .nVPosition < 0
					.nVPosition = 0
				ENDIF
			ENDWITH
		
		ENDIF
		
		
		SELECT 0
		SELECT * FROM ReportDBF WHERE INLIST(ObjType, cnREPOBJ_TEXT, cnREPOBJ_LINE, cnREPOBJ_BOX, cnREPOBJ_FIELD, cnREPOBJ_IMAGE);
			AND BETWEEN(VPos, tnMinValue, tnMaxValue) AND PLATFORM = 'WINDOWS';
			INTO CURSOR &lcCursorOfObjects
		
		GO TOP
		DO WHILE !EOF(lcCursorOfObjects)
		
			lnLineHeightDelta = 0
			lnLineWidthDelta  = 0
			lnLineTopDelta    = 0
			lnLineLeftDelta   = 0
		
			lcObjName 		  = SYS(2015)
		
			DO CASE
				CASE &lcCursorOfObjects..ObjType = cnREPOBJ_TEXT
					THIS.nTotalPlainObjects = THIS.nTotalPlainObjects + 1
		
					loObject = toBelongToBand.ADDITEM(ccOBJECT_TEXT, lcObjName, lnObjectPosNumber)
		
					WITH loObject
		
		
						.cExpression 	= &lcCursorOfObjects..EXPR
		
						lnStringLen		= LEN(.cExpression)
		
						.cExpression = SUBSTR(.cExpression, 2, lnStringLen - 2)
		
						IF THIS.nExportFileType = cnXML
						ELSE
		
							.cFontName  	= &lcCursorOfObjects..FONTFACE
							.lFontBold   	= IIF(BITAND(&lcCursorOfObjects..FontStyle, cnSTYLE_BOLD) = cnSTYLE_BOLD, .T., .F.)
							.lFontItalic 	= IIF(BITAND(&lcCursorOfObjects..FontStyle, cnSTYLE_ITALIC) = cnSTYLE_ITALIC, .T., .F.)
							.lFontUnderline = IIF(BITAND(&lcCursorOfObjects..FontStyle, cnSTYLE_UNDERLINE) = cnSTYLE_UNDERLINE, .T., .F.)
							.lFontStrikethru= IIF(BITAND(&lcCursorOfObjects..FontStyle, cnSTYLE_STRIKETHRU) = cnSTYLE_STRIKETHRU, .T., .F.)
							.nFontSize   	= &lcCursorOfObjects..FONTSIZE
							.nBackColor  	= IIF(&lcCursorOfObjects..FillRed = -1, -1, RGB(&lcCursorOfObjects..FillRed, &lcCursorOfObjects..FillGreen, &lcCursorOfObjects..FillBlue))
							.nForeColor     = IIF(&lcCursorOfObjects..PenRed = -1, -1, RGB(&lcCursorOfObjects..PenRed, &lcCursorOfObjects..PenGreen, &lcCursorOfObjects..PenBlue))
		
		
							lcPicture = &lcCursorOfObjects..PICTURE					
		
							DO CASE
								CASE !EMPTY(lcPicture) AND EVALUATE(lcPicture) = "@J"
									.nAlignment = THIS.GetAlignment(cnALIGN_RIGHT)					
		
								CASE !EMPTY(lcPicture) AND EVALUATE(lcPicture) = "@I"
									.nAlignment = THIS.GetAlignment(cnALIGN_CENTER)					
									
								OTHERWISE	
									.nAlignment = THIS.GetAlignment(cnALIGN_LEFT)												
									
							ENDCASE
		
		
							DO CASE
								CASE THIS.nExportFileType = cnWORD OR THIS.nExportFileType = cnRTF
									lnLineLeftDelta	= - cnWORD_STEP_MEASURE_FACTOR
								CASE THIS.nExportFileType = cnEXCEL
									lnLineLeftDelta	= - cnEXCEL_STEP_MEASURE_FACTOR
		
								CASE INLIST(THIS.nExportFileType, cnPREVIEW, cnIMAGE)
									lnLineWidthDelta  = -3
		
							ENDCASE
						ENDIF
		
					ENDWITH
		
				CASE &lcCursorOfObjects..ObjType = cnREPOBJ_LINE
		
					loObject = toBelongToBand.ADDITEM(ccOBJECT_LINE, lcObjName, lnObjectPosNumber)
		
					IF THIS.nExportFileType = cnXML
					ELSE
		
						WITH loObject
							.lVertical		= &lcCursorOfObjects..Offset = 0
							.nForeColor 	= IIF(&lcCursorOfObjects..PenRed = -1, -1, RGB(&lcCursorOfObjects..PenRed, &lcCursorOfObjects..PenGreen, &lcCursorOfObjects..PenBlue))
							.nPenPattern 	= THIS.GetPenPattern(&lcCursorOfObjects..PenPat)
		
							DO CASE
								CASE THIS.nExportFileType = cnWORD OR THIS.nExportFileType = cnRTF
									.nPenSize = &lcCursorOfObjects..PenSize * (1 - cnWORD_LINE_MEASURE_FACTOR)
		
								CASE THIS.nExportFileType = cnEXCEL
		
									.nPenSize = &lcCursorOfObjects..PenSize * (1 - cnEXCEL_LINE_MEASURE_FACTOR)
		
								CASE THIS.nExportFileType = cnPREVIEW
									.nPenSize = &lcCursorOfObjects..PenSize
		
								OTHERWISE
									.nPenSize = IIF(&lcCursorOfObjects..PenSize	= 0, 1, &lcCursorOfObjects..PenSize)
							ENDCASE
		
		
							.lStretch = IIF(THIS.nColumns > 1 AND THIS.nPrintOrder = 1, .F., &lcCursorOfObjects..STRETCH)
		
		
						ENDWITH
					ENDIF
				CASE &lcCursorOfObjects..ObjType = cnREPOBJ_BOX
					loObject = toBelongToBand.ADDITEM(ccOBJECT_BOX, lcObjName, lnObjectPosNumber)
		
					IF THIS.nExportFileType = cnXML
					ELSE
		
						WITH loObject
							DO CASE
								CASE THIS.nExportFileType = cnWORD OR THIS.nExportFileType = cnRTF
		
									lnPenSize		  = IIF(&lcCursorOfObjects..PenPat = 0, 0, &lcCursorOfObjects..PenSize)
									.nPenSize         = lnPenSize * (1 - cnWORD_LINE_MEASURE_FACTOR)
		
									lnLineWidthDelta  = IIF(lnPenSize = 0, (1 - cnWORD_LINE_MEASURE_FACTOR), .nPenSize - cnWORD_LINE_MEASURE_FACTOR)
									lnLineHeightDelta = IIF(lnPenSize = 0, (1 - cnWORD_LINE_MEASURE_FACTOR), .nPenSize + cnWORD_LINE_MEASURE_FACTOR)
		
									lnLineLeftDelta	  = IIF(lnPenSize = 0, 0, ((lnPenSize/2) - 1) * cnWORD_STEP_MEASURE_FACTOR)
									lnLineTopDelta	  = IIF(lnPenSize = 0, 0, (lnPenSize/2) * cnWORD_STEP_MEASURE_FACTOR)
		
		
								CASE THIS.nExportFileType = cnEXCEL
		
		
		
		
									lnPenSize		  = IIF(&lcCursorOfObjects..PenPat = 0, 0, &lcCursorOfObjects..PenSize)
									.nPenSize         = lnPenSize * (1 - cnEXCEL_LINE_MEASURE_FACTOR)
		
									lnLineWidthDelta  = IIF(lnPenSize = 0, (1 - cnEXCEL_LINE_MEASURE_FACTOR), .nPenSize - cnEXCEL_LINE_MEASURE_FACTOR)
									lnLineHeightDelta = IIF(lnPenSize = 0, (1 - cnEXCEL_LINE_MEASURE_FACTOR), .nPenSize + cnEXCEL_LINE_MEASURE_FACTOR)
		
									lnLineLeftDelta	  = IIF(lnPenSize = 0, 0, ((lnPenSize/2) - 1) * cnEXCEL_STEP_MEASURE_FACTOR)
									lnLineTopDelta	  = IIF(lnPenSize = 0, 0, (lnPenSize/2) * cnEXCEL_STEP_MEASURE_FACTOR)
		
		
								OTHERWISE
		
									.nPenSize         = IIF(&lcCursorOfObjects..PenPat = 0, 0, IIF(&lcCursorOfObjects..PenSize = 0, 1, &lcCursorOfObjects..PenSize))
									lnLineWidthDelta  = IIF(.nPenSize = 0, 1, 0)
									lnLineHeightDelta = lnLineWidthDelta
							ENDCASE
		
							.nRectangleType	= THIS.GetRectangleType(&lcCursorOfObjects..Offset)
		
							.nForeColor  	= IIF(&lcCursorOfObjects..PenRed = -1, -1, RGB(&lcCursorOfObjects..PenRed, &lcCursorOfObjects..PenGreen, &lcCursorOfObjects..PenBlue))
							.nBackColor  	= IIF(&lcCursorOfObjects..FillRed = -1, -1, RGB(&lcCursorOfObjects..FillRed, &lcCursorOfObjects..FillGreen, &lcCursorOfObjects..FillBlue))
							.nPenPattern 	= THIS.GetPenPattern(&lcCursorOfObjects..PenPat)
		
							.nFillPat   	= THIS.GetFillPattern(&lcCursorOfObjects..FillPat)
		
							.lStretch	     = IIF(THIS.nColumns > 1 AND THIS.nPrintOrder = 1, .F., &lcCursorOfObjects..STRETCH)
		
		
						ENDWITH
		
					ENDIF
		
				CASE &lcCursorOfObjects..ObjType = cnREPOBJ_FIELD
		
					THIS.nTotalPlainObjects = THIS.nTotalPlainObjects + 1
		
					loObject = toBelongToBand.ADDITEM(ccOBJECT_FIELD, lcObjName, lnObjectPosNumber)
		
					WITH loObject
						.cExpression 	 = &lcCursorOfObjects..EXPR
		
						IF THIS.nVFPVersion >= 8 AND AT('_PAGETOTAL', UPPER(.cExpression)) # 0
							THIS.lPageTotalIsUsed = .T.
		
						ENDIF
		
						.nTotalType     = &lcCursorOfObjects..TotalType
						.nResetAt    	= &lcCursorOfObjects..ResetTotal - cnGROUP_OFFSET + 1
		
						toBelongToBand.lCalculation = IIF(.nTotalType > 0, .T. , toBelongToBand.lCalculation)
		
		
		
		
						IF INLIST(THIS.nExportFileType,  cnXML, cnPREVIEW)
							THIS.nFieldNumber = THIS.nFieldNumber + 1
							lcDataFieldName = 'F'+ALLTRIM(STR(THIS.nFieldNumber))
		
							IF !EMPTY(THIS.aDataTableFields[1])
								DIMENSION THIS.aDataTableFields[ALEN(THIS.aDataTableFields, 1) + 1]
							ENDIF
		
							THIS.aDataTableFields[ALEN(THIS.aDataTableFields, 1)] = lcDataFieldName + ' M '
		
							.cBoundedDataField = lcDataFieldName
							
						ENDIF	
		
						IF THIS.nExportFileType # cnXML
							.cDataType		 = IIF(EMPTY(&lcCursorOfObjects..FillChar), 'C', &lcCursorOfObjects..FillChar)
							.cFontName   	 = &lcCursorOfObjects..FONTFACE
							.cFormat	   	 = &lcCursorOfObjects..PICTURE
							.lFontBold   	 = IIF(BITAND(&lcCursorOfObjects..FontStyle, cnSTYLE_BOLD) = cnSTYLE_BOLD, .T., .F.)
							.lFontItalic 	 = IIF(BITAND(&lcCursorOfObjects..FontStyle, cnSTYLE_ITALIC) = cnSTYLE_ITALIC, .T., .F.)
							.lFontUnderline  = IIF(BITAND(&lcCursorOfObjects..FontStyle, cnSTYLE_UNDERLINE) = cnSTYLE_UNDERLINE, .T., .F.)
							.lFontStrikethru = IIF(BITAND(&lcCursorOfObjects..FontStyle, cnSTYLE_STRIKETHRU)=cnSTYLE_STRIKETHRU, .T., .F.)
		
							.lStretch	     = IIF(THIS.nColumns > 1 AND THIS.nPrintOrder = 1, .F., &lcCursorOfObjects..STRETCH)
		
							.nFontSize   	 = &lcCursorOfObjects..FONTSIZE
							.nBackColor  	 = IIF(&lcCursorOfObjects..FillRed = - 1, -1, RGB(&lcCursorOfObjects..FillRed, &lcCursorOfObjects..FillGreen, &lcCursorOfObjects..FillBlue))
							.nForeColor      = IIF(&lcCursorOfObjects..PenRed = - 1, -1, RGB(&lcCursorOfObjects..PenRed, &lcCursorOfObjects..PenGreen, &lcCursorOfObjects..PenBlue))
							.nAlignment 	 = THIS.GetAlignment(&lcCursorOfObjects..Offset)
		
		
							.cReportObjectName = SYS(2015)
		
						ENDIF
		
					ENDWITH
				CASE &lcCursorOfObjects..ObjType = cnREPOBJ_IMAGE
		
					loObject = toBelongToBand.ADDITEM(ccOBJECT_IMAGE, lcObjName, lnObjectPosNumber)
		
					WITH loObject
						.nImageSourceType = &lcCursorOfObjects..Offset
		
		
						DO CASE
							CASE .nImageSourceType = cnIMAGE_SOURCE_EXPRESSION
								.cImageSource = &lcCursorOfObjects..NAME
		
							CASE .nImageSourceType = cnIMAGE_SOURCE_FILE
		
								.cImageSource = EVAL(&lcCursorOfObjects..PICTURE)
		
								lcJustPath    = ADDBS(JUSTPATH(.cImageSource))
		
								DO CASE
									CASE ATCC('..\' , lcJustPath) # 0
		
										lnOccurs = OCCURS('..\', lcJustPath)
		
										lnCharPosition =  RAT('\', THIS.cReportPath, lnOccurs + 1)
		
										lnCharPosition = IIF(lnCharPosition = 0, RAT('\', THIS.cReportPath, 1), lnCharPosition)
		
										lcReportPath   = SUBSTR(THIS.cReportPath, 1, lnCharPosition)
		
										.cImageSource = lcReportPath + SUBSTR(.cImageSource, 3*lnOccurs + 1)
		
									CASE ATCC(':\' , lcJustPath) = 0
										.cImageSource = THIS.cReportPath + .cImageSource
		
								ENDCASE
		
		
							CASE .nImageSourceType = cnIMAGE_SOURCE_FIELD
								.cImageSource = &lcCursorOfObjects..NAME
		
							OTHERWISE
								.cImageSource = ''
		
						ENDCASE
		
						IF THIS.nExportFileType = cnXML
		
						ELSE
							.nStretch = &lcCursorOfObjects..GENERAL
						ENDIF
		
					ENDWITH
		
			ENDCASE
		
			lnBackStyle	= IIF(&lcCursorOfObjects..Mode = 1, 1, 2)
		
			WITH loObject
		
				.cPrintWhen = &lcCursorOfObjects..SupExpr
		
				IF THIS.nVFPVersion >= 8 AND AT('_PAGETOTAL', UPPER(.cPrintWhen)) # 0
					THIS.lPageTotalIsUsed = .T.
				ENDIF
			
		
				IF THIS.nExportFileType = cnXML
		
				ELSE
		
					.lTransparent     = IIF(lnBackStyle = 1, .T., .F.)
					.nHeight          = &lcCursorOfObjects..HEIGHT * THIS.nVFactor - lnLineHeightDelta
					.nWidth           = &lcCursorOfObjects..WIDTH  * THIS.nHFactor - lnLineWidthDelta
					.nFloat	          = IIF(&lcCursorOfObjects..FLOAT, cnPOSITION_FLOAT, IIF(&lcCursorOfObjects..TOP, cnPOSITION_TOP, IIF(&lcCursorOfObjects..BOTTOM, cnPOSITION_BOTTOM, cnPOSITION_FLOAT)))
		
					lnMinValue        = 0
					DO CASE
						CASE tnMinValue = 0 AND (toBelongToBand.nBandType  = cnBAND_DETAIL_REPOBJ_CODE OR toBelongToBand.nBandType  = cnBAND_GROUP_HEADER_REPOBJ_CODE)
							lnMinValue = cnBAND_HEIGHT
					ENDCASE
		
		
					.nVPosition = (&lcCursorOfObjects..VPos - IIF(tnMinValue = 0, lnMinValue, (tnMinValue  + cnBAND_HEIGHT))) * THIS.nVFactor;
						+ lnLineTopDelta
		
					.nStretchedHeight = .nHeight
		
					.nBottomDelta  = (tnMaxValue - &lcCursorOfObjects..VPos) * THIS.nVFactor
		
					.nHPosition  		    = &lcCursorOfObjects..HPos * THIS.nHFactor + lnLineLeftDelta
					.cComment  	 		    = &lcCursorOfObjects..COMMENT
					.lRemoveLineIfBlank     = &lcCursorOfObjects..NoRepeat
					.nSurBottomPosition     = .nVPosition + .nHeight
					.lPrintInFirstWholeBand = IIF(&lcCursorOfObjects..SuprPCol = 3, .T., .F.)
					.lPrintOnNewPage        = &lcCursorOfObjects..SupOvFlow
					.nPrintOnGroupChange    = &lcCursorOfObjects..SupGroup - cnGROUP_OFFSET + 1
		
					.lPrintRepeats          = &lcCursorOfObjects..SupAlways
		
					lnOldMemoWidth = SET('MEMOWIDTH')
					SET MEMOWIDTH TO 500
		
					lnMemoLines = MEMLINES(&lcCursorOfObjects..COMMENT)
		
					FOR lnCount = 1 TO lnMemoLines
		
						lcMemoLine       = MLINE(&lcCursorOfObjects..COMMENT, lnCount)
		
						IF &lcCursorOfObjects..ObjType = cnREPOBJ_FIELD AND ATC('ReportContents=', lcMemoLine) > 0
							lcFolderName = THIS.ExtractValue(lcMemoLine)
		
							IF !EMPTY(THIS.aContentsField[1,1])
								DIMENSION THIS.aContentsField[ALEN(THIS.aContentsField, 1) + 1, 2]
							ENDIF
		
							THIS.aContentsField[ALEN(THIS.aContentsField, 1), 1] = .cReportObjectName
							THIS.aContentsField[ALEN(THIS.aContentsField, 1), 2] = lcFolderName
		
						ENDIF
		
		
						IF ATC('HyperLink=', lcMemoLine) > 0
							.cHyperLink = THIS.ExtractValue(lcMemoLine)
						ENDIF
		
						IF ATC('ReportLink=', lcMemoLine) > 0
							.cReportLink = THIS.ExtractValue(lcMemoLine)
						ENDIF
		
						IF ATC('ReportLinkParameter=', lcMemoLine) > 0
		
							IF !EMPTY(.aReportLinkParameters[1, 1])
								DIMENSION .aReportLinkParameters[ALEN(.aReportLinkParameters, 1) + 1, 2]
							ENDIF
		
							lcExtractMemoLine = THIS.ExtractValue(lcMemoLine)
		
							.aReportLinkParameters[ALEN(.aReportLinkParameters, 1), 1] = SUBSTR(lcExtractMemoLine, 1, AT(' ', lcExtractMemoLine) - 1)
							.aReportLinkParameters[ALEN(.aReportLinkParameters, 1), 2] = SUBSTR(lcExtractMemoLine, AT(' ', lcExtractMemoLine) + 1)
		
						ENDIF
		
						IF ATC('FormLink=', lcMemoLine) > 0
							.cFormLink = THIS.ExtractValue(lcMemoLine)
						ENDIF
		
						IF ATC('FormLinkParameter=', lcMemoLine) > 0
		
							IF !EMPTY(.aFormLinkParameters[1, 1])
								DIMENSION .aFormLinkParameters[ALEN(.aFormLinkParameters, 1) + 1, 2]
							ENDIF
		
							lcExtractMemoLine = THIS.ExtractValue(lcMemoLine)
		
							.aFormLinkParameters[ALEN(.aFormLinkParameters, 1), 1] = SUBSTR(lcExtractMemoLine, 1, AT(' ', lcExtractMemoLine) - 1)
							.aFormLinkParameters[ALEN(.aFormLinkParameters, 1), 2] = SUBSTR(lcExtractMemoLine, AT(' ', lcExtractMemoLine) + 1)
		
						ENDIF
		
		
						IF &lcCursorOfObjects..ObjType = cnREPOBJ_BOX 
							DO CASE
							CASE ATC('Chart=', lcMemoLine) > 0
								.cChartName = THIS.ExtractValue(lcMemoLine)
								
								
							ENDCASE												
							
							IF ATC('RTFFieldContents=', lcMemoLine) > 0
		
								.cRTFFieldContentsName = THIS.ExtractValue(lcMemoLine)
								.cRTFFileContentsName  = ''
								
								.cRTFName = SYS(2015)						
							
							ENDIF
							
							IF ATC('RTFFileContents=', lcMemoLine) > 0
		
								.cRTFFieldContentsName = ''
								.cRTFFileContentsName  = THIS.ExtractValue(lcMemoLine)
								
								.cRTFName = SYS(2015)						
								
							ENDIF
							
						ENDIF
		
							IF ATC('ColorToBeTransparent=', lcMemoLine) > 0
								.nColorToBeTransparent = EVALUATE(THIS.ExtractValue(lcMemoLine))
							ENDIF
		
					ENDFOR
		
					SET MEMOWIDTH TO lnOldMemoWidth
		
		
		
				ENDIF
		
			ENDWITH
		
			IF THIS.nExportFileType = cnXML
		*-- We dont need rest...
			ELSE
		
				lnObjectHeight = &lcCursorOfObjects..HEIGHT + &lcCursorOfObjects..VPos
		
		
				IF  (&lcCursorOfObjects..ObjType = cnREPOBJ_BOX OR &lcCursorOfObjects..ObjType = cnREPOBJ_LINE OR &lcCursorOfObjects..ObjType = cnREPOBJ_Image) AND;
						lnObjectHeight > tnMaxValue AND (loObject.nHeight - cnBAND_HEIGHT * THIS.nVFactor) > 0
		
					IF TYPE('THIS.aMultyBandObject[1, 1]') = 'O'
						DIMENSION THIS.aMultyBandObject[ALEN(THIS.aMultyBandObject, 1) + 1, ALEN(THIS.aMultyBandObject, 2)]
					ENDIF
		
					THIS.aMultyBandObject[ALEN(THIS.aMultyBandObject, 1), 1] = loObject
					THIS.aMultyBandObject[ALEN(THIS.aMultyBandObject, 1), 2] = lnObjectHeight
					THIS.aMultyBandObject[ALEN(THIS.aMultyBandObject, 1), 3] = toBelongToBand
		
					
					
					loObject.nMltBandObjVPosition = loObject.nVPosition
					loObject.nMltBandObjType      = cnFROM_ANY_BAND_TO_ANY_BAND
		
					DO CASE
						CASE toBelongToBand.nBandType = cnBAND_TITLE_REPOBJ_CODE
		
							loObject.nMltBandObjType       = cnFROM_TITLE_BAND_TO_ANY_BAND
							loObject.nMltBandObjApndHeight = tnMaxValue  * THIS.nVFactor - loObject.nVPosition
		
						CASE toBelongToBand.nBandType = cnBAND_PAGE_HEADER_REPOBJ_CODE
		
							loObject.nMltBandObjType       = cnFROM_PAGE_HEADER_BAND_TO_ANY_BAND
		
							loObject.nMltBandObjApndHeight = (tnMaxValue - tnMinValue) * THIS.nVFactor - loObject.nVPosition
		
						CASE toBelongToBand.nBandType = cnBAND_GROUP_HEADER_REPOBJ_CODE
		
							loObject.nMltBandObjType       = cnFROM_GROUP_HEADER_BAND_TO_ANY_BAND
							loObject.nMltBandObjApndHeight = (tnMaxValue - tnMinValue) * THIS.nVFactor - loObject.nVPosition					
		
						OTHERWISE
		
					ENDCASE
				ENDIF
		
			ENDIF
		
			SKIP IN &lcCursorOfObjects
		ENDDO
		
		USE
		
		IF TYPE('THIS.aMultyBandObject[1, 1]') = 'O' AND THIS.nExportFileType # cnXML
		
			FOR lnCount	= 1 TO ALEN(THIS.aMultyBandObject, 1)
		
				loObject       = THIS.aMultyBandObject[lnCount, 1]
				loBelongToBand = THIS.aMultyBandObject[lnCount, 3]
		
				IF loBelongToBand.nBandType # toBelongToBand.nBandType
		
					lnObjectHeight = THIS.aMultyBandObject[lnCount, 2]
		
					IF lnObjectHeight > tnMaxValue
					ENDIF
		
					IF lnObjectHeight > tnMinValue AND lnObjectHeight < tnMaxValue
		
						DO CASE
							CASE loObject.nMltBandObjType = cnFROM_PAGE_HEADER_BAND_TO_ANY_BAND AND ;
									toBelongToBand.nBandType	   = cnBAND_PAGE_FOOTER_REPOBJ_CODE
		
								loObject.nMltBandObjType       = cnFROM_PAGE_HEADER_BAND_TO_ANY_BAND_RSZ
		
								loObject.nMltBandObjApndHeight = loObject.nMltBandObjApndHeight + (lnObjectHeight - tnMinValue) * THIS.nVFactor						
		
							CASE loObject.nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND AND ;
								toBelongToBand.nBandType 	     = cnBAND_SUMMARY_REPOBJ_CODE
		
								loObject.nMltBandObjType         = cnFROM_TITLE_BAND_TO_ANY_BAND_RSZ
		
								loObject.nMltBandObjSuffixHeight = (lnObjectHeight - tnMinValue) * THIS.nVFactor
														
								loObject.nMltBandObjApndHeight   = loObject.nMltBandObjApndHeight + loObject.nMltBandObjSuffixHeight
		
							CASE loObject.nMltBandObjType = cnFROM_GROUP_HEADER_BAND_TO_ANY_BAND AND ;
									toBelongToBand.nBandType 	   = cnBAND_GROUP_FOOTER_REPOBJ_CODE
		
								loObject.nMltBandObjType       = cnFROM_GROUP_HEADER_BAND_TO_ANY_BAND_RSZ
		
								loObject.nMltBandObjApndHeight = loObject.nMltBandObjApndHeight + (lnObjectHeight - tnMinValue) * THIS.nVFactor
		
						ENDCASE
					ENDIF
				ENDIF
			NEXT
		ENDIF
		
		
		
	ENDPROC

	PROTECTED PROCEDURE processcalculatedfields
		LPARAMETERS toBand
		
		LOCAL lcExpression
		
		LOCAL llResetedValue
		LOCAL llValueIsNull
		
		LOCAL lnObjects
		LOCAL lnCount
		LOCAL lnExpressionValue
		
		LOCAL loObject
		LOCAL loBand
		
		IF !ISNULL(toBand)
			WITH THIS
		
				lnObjects = IIF(ISNULL(toBand.aItems), 0, ALEN(toBand.aItems))
		
				FOR lnCount = 1 TO lnObjects
		
					loObject = toBand.aItems[lnCount]
		
					WITH loObject
						IF PEMSTATUS(loObject, 'nTotalType', 5) AND ;
								VARTYPE(.nTotalType) $ 'NFIBY' AND ;
								INLIST(.nTotalType, cnTOTAL_COUNT, cnTOTAL_SUM, ;
								cnTOTAL_AVERAGE, cnTOTAL_LOWEST, cnTOTAL_HIGHEST, cnTOTAL_STDDEV, cnTOTAL_VARIANCE)
						ELSE
							LOOP
						ENDIF
		
						lcExpression      = ALLT(.cExpression)
						lnExpressionValue = EVAL(lcExpression)
		
						llValueIsNull     = ISNULL(lnExpressionValue)
						lnExpressionValue = IIF(TYPE('lnExpressionValue') $ 'NFIBY' AND !llValueIsNull, lnExpressionValue, 0)
		
		
						llResetedValue = TYPE('.nCalculatedValue') = 'L'
		
						DO CASE
							CASE .nTotalType = cnTOTAL_COUNT
								.nCalculatedValue = IIF(llResetedValue, 0, .nCalculatedValue) + 1
							CASE .nTotalType = cnTOTAL_SUM
								.nCalculatedValue = IIF(llResetedValue, 0, .nCalculatedValue) + lnExpressionValue
		
							CASE .nTotalType = cnTOTAL_LOWEST
		
								IF llResetedValue
									.nCalculatedValue = lnExpressionValue
								ELSE
									IF !llValueIsNull
										.nCalculatedValue = IIF(.nCalculatedValue > lnExpressionValue, lnExpressionValue, .nCalculatedValue)
									ENDIF	
								ENDIF
		
							CASE .nTotalType = cnTOTAL_HIGHEST
		
								IF llResetedValue
									.nCalculatedValue = lnExpressionValue
								ELSE
									IF !llValueIsNull						
										.nCalculatedValue = IIF(.nCalculatedValue < lnExpressionValue, lnExpressionValue, .nCalculatedValue)
									ENDIF								
								ENDIF
		
							CASE .nTotalType = cnTOTAL_STDDEV
							CASE .nTotalType = cnTOTAL_VARIANCE
							CASE .nTotalType = cnTOTAL_AVERAGE
		
								IF !llValueIsNull
								
									IF llResetedValue
										.nAverageValue    = lnExpressionValue
										.nDivider         = 1
									ELSE
										.nAverageValue    = .nAverageValue + lnExpressionValue
										.nDivider         = .nDivider + 1
									ENDIF
		
									.nCalculatedValue     = .nAverageValue/.nDivider
								ENDIF
		
						ENDCASE
		
					ENDWITH
				NEXT lnCount
			ENDWITH
		ENDIF
		
	ENDPROC

	PROTECTED PROCEDURE processcalculations
		LOCAL lnCount
		
		WITH THIS
		
			.ProcessVariables()
		
			IF VARTYPE(.oPageHeaderBand) = 'O'  AND .oPageHeaderBand.lCalculation
				.ProcessCalculatedFields(.oPageHeaderBand)
			ENDIF
		
			IF VARTYPE(.oPageFooterBand) = 'O'   AND .oPageFooterBand.lCalculation
				.ProcessCalculatedFields(.oPageFooterBand)
			ENDIF
		
			IF VARTYPE(.oDetailBand) = 'O' AND .oDetailBand.lCalculation
				.ProcessCalculatedFields(.oDetailBand)
			ENDIF
		
			IF VARTYPE(.oSummaryBand) = 'O' AND .oSummaryBand.lCalculation
				.ProcessCalculatedFields(.oSummaryBand)
			ENDIF
		
			FOR lnCount = 1 TO ALEN(.aGroupbands, 1)
				IF VARTYPE(.aGroupbands[lnCount, 1]) = 'O'  AND .aGroupbands[lnCount, 1].lCalculation
					.ProcessCalculatedFields(.aGroupbands[lnCount, 1])
				ENDIF
				
				IF VARTYPE(.aGroupbands[lnCount, 2]) = 'O'  AND .aGroupbands[lnCount, 2].lCalculation
					.ProcessCalculatedFields(.aGroupbands[lnCount, 2])
				ENDIF
				
			NEXT lnCount
		
		
		ENDWITH
		
	ENDPROC

	PROTECTED PROCEDURE processfieldobjects
		LPARAMETERS toBand
		
		LOCAL laItems[1]
		LOCAL laFieldItems[1, 2]
		
		LOCAL loObject
		
		LOCAL lnObjects
		LOCAL lnCount
		LOCAL lnLenArray
		LOCAL lnFieldItems
		
		lnObjects    = IIF(ISNULL(toBand.aItems), 0, ALEN(toBand.aItems, 1))
		laFieldItems = .NULL.
		laItems      = .NULL.
		
		FOR lnCount = 1 TO lnObjects
		*-- Take Band Object
			loObject = 	toBand.aItems[lnCount]
		
		*-- Process only Objects that must be resorted if Field
			IF VARTYPE(loObject) = 'O' AND loObject.nObjectType = cnREPOBJ_FIELD 
		
				IF !ISNULL(laFieldItems[1, 2])
					DIMENSION laFieldItems[ALEN(laFieldItems, 1) + 1, 2]
				ENDIF
		
				lnLenArray                  = ALEN(laFieldItems,1)
				
				laFieldItems[lnLenArray, 1] = loObject.nHPosition
				laFieldItems[lnLenArray, 2] = loObject
				
			ELSE
		
				IF !ISNULL(laItems[1])
					DIMENSION laItems[ALEN(laItems,1)+1]
				ENDIF
		
				lnLenArray          = ALEN(laItems,1)
				
				laItems[lnLenArray] = loObject
				
			ENDIF
		NEXT
		
		IF !ISNULL(laFieldItems[1, 2])
		
			=ASORT(laFieldItems)
		
			lnFieldItems  = ALEN(laFieldItems,1)	
			
			FOR lnCount = 1 TO lnFieldItems
			
				IF !ISNULL(laItems[1])
					DIMENSION laItems[ALEN(laItems,1)+1]
				ENDIF
		
				lnLenArray          = ALEN(laItems,1)
				
				laItems[lnLenArray] = laFieldItems[lnCount, 2]
			
			ENDFOR
		
		
			DIMENSION toBand.aItems[1]
			toBand.aItems = .NULL.
			
			=ACOPY(laItems, toBand.aItems)
		
		ENDIF	
			
		
		
		
		
		
	ENDPROC

	PROTECTED PROCEDURE processfloatobjects
		LPARAMETERS toBand, tlOverItems
		
		LOCAL laItems[1]
		LOCAL laFloatItems[1, 2]
		
		LOCAL lnObjects
		LOCAL lnCount
		LOCAL lnSurCount
		LOCAL lnSubSurCount
		LOCAL lnSurPosLeft
		LOCAL lnSurPosRight
		LOCAL lnPosLeft
		LOCAL lnPosRight
		LOCAL lnObjectPosition
		LOCAL lnSurObjectVPosition
		LOCAL lnSurObjectHPosition
		LOCAL lnMaxSurObjectVPosition
		LOCAL lnMaxSurObjectHPosition
		LOCAL lnLenArray
		LOCAL lnInsertPosition
		
		LOCAL lcSurObjectID
		LOCAL lcMaxSurObjectID
		
		LOCAL loObject
		LOCAL loSurObject
		LOCAL loSubSurObject
		
		laItems      = .NULL.
		laFloatItems = .NULL.
		
		IF tlOverItems
			lnObjects    = IIF(ISNULL(toBand.aOverItems), 0, ALEN(toBand.aOverItems, 1))
		ELSE
			lnObjects    = IIF(ISNULL(toBand.aItems), 0, ALEN(toBand.aItems, 1))
		ENDIF
		
		FOR lnCount = 1 TO lnObjects
		
			IF tlOverItems
				loObject = 	toBand.aOverItems[lnCount]
			ELSE
				loObject = 	toBand.aItems[lnCount]
			ENDIF
		
			DO CASE
				CASE VARTYPE(loObject) = 'O' AND loObject.nFloat = cnPOSITION_FLOAT
		
					lnPosLeft  = loObject.nHPosition
					lnPosRight = loObject.nHPosition + loObject.nWidth
		
					FOR lnSurCount = 1 TO lnObjects
		
						IF tlOverItems
							loSurObject = toBand.aOverItems[lnSurCount]
						ELSE
							loSurObject = toBand.aItems[lnSurCount]
						ENDIF
		
		
						IF VARTYPE(loSurObject) = 'O' AND;
								(loSurObject.nVPosition + loSurObject.nHeight) < loObject.nVPosition AND;
								loSurObject.nFloat # cnPOSITION_BOTTOM AND;
								!(loSurObject.lStretch AND (loSurObject.nObjectType = cnREPOBJ_BOX OR loSurObject.nObjectType = cnREPOBJ_LINE))
		
							lnSurPosLeft  = loSurObject.nHPosition
							lnSurPosRight = loSurObject.nHPosition + loSurObject.nWidth
		
							IF (lnPosLeft <= lnSurPosLeft AND lnPosRight > lnSurPosLeft) OR;
									(lnPosLeft >= lnSurPosLeft AND lnPosLeft < lnSurPosRight)
		
								lnSurTotal = IIF(ISNULL(loObject.aSurrounders[1]), 1, ALEN(loObject.aSurrounders, 1) + 1)
								DIMENSION loObject.aSurrounders[lnSurTotal]
		
		
								loObject.aSurrounders[lnSurTotal] = loSurObject
		
							ENDIF
		
						ENDIF
					NEXT lnSurCount
				CASE VARTYPE(loObject) = 'O' AND loObject.nFloat = cnPOSITION_BOTTOM
		
			ENDCASE
		NEXT lnCount
		
		FOR lnCount = 1 TO lnObjects
		
			IF tlOverItems
				loObject = 	toBand.aOverItems[lnCount]
			ELSE
				loObject = 	toBand.aItems[lnCount]
			ENDIF
		
			lnMaxSurObjectVPosition = -999999
			lnMaxSurObjectHPosition = -999999
		
			IF !ISNULL(loObject.aSurrounders[1])
		
				lnSurTotal = ALEN(loObject.aSurrounders, 1)
		
				FOR lnSurCount = 1 TO lnSurTotal
		
					loSurObject         = loObject.aSurrounders[lnSurCount]
					lcSurObjectID       = loSurObject.cObjectID
		
					lnSurObjectVPosition = loSurObject.nVPosition + loSurObject.nHeight
					lnSurObjectHPosition = loSurObject.nHPosition + loSurObject.nWidth
		
					IF (lnMaxSurObjectVPosition < lnSurObjectVPosition) OR ;
							(lnMaxSurObjectVPosition = lnSurObjectVPosition AND lnMaxSurObjectHPosition < lnSurObjectHPosition)
		
						lnMaxSurObjectVPosition = lnSurObjectVPosition
						lnMaxSurObjectHPosition = lnSurObjectHPosition
		
						lcMaxSurObjectID        = lcSurObjectID
					ENDIF
		
				NEXT lnSurCount
		
		
				IF !ISNULL(laFloatItems[1])
					DIMENSION laFloatItems[ALEN(laFloatItems, 1) + 1, 2]
				ENDIF
		
				lnLenArray                  = ALEN(laFloatItems,1)
				laFloatItems[lnLenArray, 1] = loObject
				laFloatItems[lnLenArray, 2] = lcMaxSurObjectID
		
			ELSE
		
				IF !ISNULL(laItems[1])
					DIMENSION laItems[ALEN(laItems,1)+1]
				ENDIF
		
				lnLenArray          = ALEN(laItems,1)
				laItems[lnLenArray] = loObject
		
			ENDIF
		
		NEXT lnCount
		
		IF !ISNULL(laFloatItems[1])
		
			lnSurTotal = ALEN(laFloatItems,1)
		
			lnLoopTotal = lnSurTotal
		
			DO WHILE lnLoopTotal > 0
		
				FOR lnSurCount = 1 TO lnSurTotal
					lcMaxSurObjectID = laFloatItems[lnSurCount, 2]
		
					IF EMPTY(lcMaxSurObjectID)
						LOOP
					ENDIF
		
					lnInsertPosition = 0
		
					lnObjects = IIF(ISNULL(laItems), 0, ALEN(laItems, 1))
					FOR lnCount = 1 TO lnObjects
						loObject = laItems[lnCount]
		
						IF loObject.cObjectID == lcMaxSurObjectID
							lnInsertPosition = lnCount
							EXIT
						ENDIF
					NEXT lnObjects
		
					IF lnInsertPosition > 0
		
						DIMENSION laItems[lnObjects + 1]
		
						IF lnInsertPosition > 0 AND lnInsertPosition < lnObjects
							=AINS(laItems, lnInsertPosition +1)
							laItems[lnInsertPosition +1] = laFloatItems[lnSurCount, 1]
						ELSE
							laItems[lnObjects + 1] = laFloatItems[lnSurCount, 1]
						ENDIF
		
						lnLoopTotal = lnLoopTotal - 1
		
						laFloatItems[lnSurCount, 2] = ''
		
					ENDIF
		
				NEXT lnSurCount
		
			ENDDO
		
		ENDIF
		
		
		IF tlOverItems
			DIMENSION toBand.aOverItems[1]
			toBand.aOverItems = .NULL.
		
			=ACOPY(laItems, toBand.aOverItems)
		ELSE
			DIMENSION toBand.aItems[1]
			toBand.aItems = .NULL.
		
			=ACOPY(laItems, toBand.aItems)
		ENDIF
		
	ENDPROC

	PROTECTED PROCEDURE processlinkedtobottomobjects
	ENDPROC

	PROCEDURE processoverobjects
		LPARAMETERS toBand
		
		LOCAL llOverItem
		
		LOCAL lnObjects
		LOCAL lnCount
		LOCAL lnOveredSurDelta
		LOCAL lnMaxOveredSurDelta
		LOCAL lnVPositionDelta
		
		LOCAL loObject
		
		llOverItem          = .T.
		lnMaxOveredSurDelta = 0
		
		THIS.ProcessFloatObjects(toBand, llOverItem)
		
		lnObjects = IIF(ISNULL(toBand.aOverItems), 0, ALEN(toBand.aOverItems, 1))
		
		FOR lnCount = 1 TO lnObjects
		
			loObject = toBand.aOverItems[lnCount]
		
			IF VARTYPE(loObject) = 'O' AND loObject.nOveredSurDelta > 0
		
				lnOveredSurDelta = loObject.nOveredSurDelta
		
				IF lnMaxOveredSurDelta < lnOveredSurDelta
					lnMaxOveredSurDelta = lnOveredSurDelta
				ENDIF
		
			ENDIF
		NEXT lnCount
		
		IF lnMaxOveredSurDelta > 0
			FOR lnCount = 1 TO lnObjects
		
				loObject = toBand.aOverItems[lnCount]
		
				IF VARTYPE(loObject) = 'O'	AND loObject.nOveredSurDelta > 0
		
					lnOveredSurDelta         = loObject.nOveredSurDelta
					loObject.nOveredSurDelta = 0
		
					IF lnOveredSurDelta < lnMaxOveredSurDelta
					
						lnVPositionDelta  			   = lnMaxOveredSurDelta - lnOveredSurDelta			
						
						loObject.nVPosition			   = lnVPositionDelta								
						loObject.nSurBottomPosition	   = loObject.nSurBottomPosition + lnVPositionDelta			
						
						loObject.nOveredVPositionDelta = lnVPositionDelta							
						
					ENDIF
		
				ENDIF
			NEXT lnCount
			
		
			FOR lnCount = 1 TO lnObjects
		
				loObject = toBand.aOverItems[lnCount]
		
				IF !ISNULL(loObject.aSurrounders[1])
					lnSurTotal = ALEN(loObject.aSurrounders, 1)
					
					lnMaxSurValue = 0
		
					FOR lnSurCount = 1 TO 	lnSurTotal
		
						loSurObject = loObject.aSurrounders[lnSurCount]
		
						IF loSurObject.nOveredVPositionDelta > 0 AND loObject.nVPosition < loSurObject.nSurBottomPosition
		
							lnVPositionDelta  = loSurObject.nOveredVPositionDelta 
		
							IF lnMaxSurValue < lnVPositionDelta
								lnMaxSurValue = lnVPositionDelta
							ENDIF
		
						ENDIF
					NEXT
					
					loObject.nVPosition 		= loObject.nVPosition + lnMaxSurValue
					loObject.nSurBottomPosition	= loObject.nSurBottomPosition + lnMaxSurValue
					
				ENDIF
			NEXT	
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE processremoveobjects		&& Process objects that can be remove base on the property .llRemoveLineIfBlank
		LPARAMETERS toBand
		
		LOCAL loObject
		LOCAL loMoveObject
		
		LOCAL lnObjects
		LOCAL lnCount
		LOCAL lnMoveCount
		LOCAL lnMoveTotal
		LOCAL lnPosTop
		LOCAL lnPosBottom
		
		LOCAL lnMinPosTop
		LOCAL lnMaxPosBottom
		LOCAL lnMaxPosDelta
		
		LOCAL llCanBeRemoved
		
		lnObjects = IIF(ISNULL(toBand.aItems), 0, ALEN(toBand.aItems, 1))
		
		FOR lnCount = 1 TO lnObjects
		*-- Take Band Object
			loObject = 	toBand.aItems[lnCount]
		
		*-- Process only Objects that must be removed if blank
			IF VARTYPE(loObject) = 'O' AND loObject.lRemoveLineIfBlank
		
				lcObjectID	   = loObject.cObjectID
		
				lnPosTop       = loObject.nVPosition
				lnPosBottom    = loObject.nVPosition + loObject.nHeight
		
				lnMinPosTop    = lnPosTop
				lnMaxPosBottom = lnPosBottom
				lnMaxPosDelta  = 0
				
		
				llCanBeRemoved = .T.
		*-- Be sure that we can remove line - it is realy blank
				FOR lnMoveCount = 1 TO lnObjects
		
					loMoveObject = toBand.aItems[lnMoveCount]
		
		
					IF VARTYPE(loMoveObject) = 'O' AND ;
							loMoveObject.cObjectID # lcObjectID	AND;
							(BETWEEN(loMoveObject.nVPosition, lnPosTop, lnPosBottom) OR ;
							BETWEEN(loMoveObject.nVPosition + loMoveObject.nHeight,  lnPosTop, lnPosBottom) OR ;
							(loMoveObject.nVPosition <= lnPosTop AND loMoveObject.nVPosition + loMoveObject.nHeight >=lnPosBottom))
		
		*-- Maybe this object is removable?
						IF  !loMoveObject.lRemoveLineIfBlank
		*-- No chance to remove line
							llCanBeRemoved = .F.
		
		*-- Before exit must reset array to .NULL.
							loObject.aBlankObjects = .NULL.
					
							lnMinPosTop    		   = 0
							lnMaxPosBottom 		   = 0
							lnMaxPosDelta          = 0
							
							EXIT
						ELSE
		*-- Add to array all related & removable objects				
							lnBlankTotal = IIF(ISNULL(loObject.aBlankObjects[1]), 1, ALEN(loObject.aBlankObjects, 1) + 1)
							DIMENSION loObject.aBlankObjects[lnBlankTotal]
		
							loObject.aBlankObjects[lnBlankTotal] = loMoveObject
							
							IF !loMoveObject.lDontCalculate
								lnMinPosTop    	= MIN(lnMinPosTop, loMoveObject.nVPosition)
								lnMaxPosBottom 	= MAX(lnMaxPosBottom, loMoveObject.nVPosition + loMoveObject.nHeight)
							ELSE
								lnMaxPosDelta   = lnMaxPosDelta + (loMoveObject.nVPosition + loMoveObject.nHeight - loObject.nVPosition )	
							ENDIF				
							
							loMoveObject.lDontCalculate = IIF(loObject.lDontCalculate, loMoveObject.lDontCalculate, .T.)
		
						ENDIF
					ENDIF
				NEXT
		
				loObject.lCanBeRemoved = llCanBeRemoved
		
				IF llCanBeRemoved
				
					loObject.nReMoveDelta = IIF(loObject.lDontCalculate, 0, lnMaxPosBottom - lnMinPosTop - lnMaxPosDelta)		
		
		*-- Now have to create an array with all objects that will be affected by removing blank line
					FOR lnMoveCount = 1 TO lnObjects
		
						loMoveObject = toBand.aItems[lnMoveCount]
		
						IF VARTYPE(loMoveObject) = 'O' AND loMoveObject.nVPosition > lnPosBottom
		
							lnMoveTotal = IIF(ISNULL(loObject.aRemoveObjects[1]), 1, ALEN(loObject.aRemoveObjects, 1) + 1)
							DIMENSION loObject.aRemoveObjects[lnMoveTotal]
		
							loObject.aRemoveObjects[lnMoveTotal] = loMoveObject
		
						ENDIF
					NEXT
		
		*-- Now have to create an array with all objects that will be affected by removing blank line
					FOR lnMoveCount = 1 TO lnObjects
		
						loMoveObject = toBand.aItems[lnMoveCount]
		
						IF VARTYPE(loMoveObject) = 'O' AND loMoveObject.nVPosition  + loMoveObject.nHeight =< lnPosTop
		
							lnMoveTotal = IIF(ISNULL(loObject.aUpRemoveObjects[1]), 1, ALEN(loObject.aUpRemoveObjects, 1) + 1)
							DIMENSION loObject.aUpRemoveObjects[lnMoveTotal]
		
							loObject.aUpRemoveObjects[lnMoveTotal] = loMoveObject
		
						ENDIF
					NEXT
				ENDIF
			ENDIF
		NEXT
		
	ENDPROC

	PROTECTED PROCEDURE processvariables
		LOCAL ln_MCh_Variables
		LOCAL ln_MCh_Count
		LOCAL ln_MCh_ExpressionResult
		LOCAL ln_MCh_VariableValue
		
		LOCAL lo_MCh_Variable
		
		LOCAL lc_MCh_Expression
		LOCAL lc_MCh_VariableName
		
		WITH THIS
		
			IF !ISNULL(.aVariables[1])
		
				ln_MCh_Variables = ALEN(.aVariables)
		
				FOR ln_MCh_Count = 1 TO ln_MCh_Variables
		
					lo_MCh_Variable = .aVariables[ln_MCh_Count]
		
					WITH lo_MCh_Variable
		
		*-- Calculate variable value
						lc_MCh_VariableName     = .cName
						lc_MCh_Expression       = ALLT(.uValueToStore)
		
						ln_MCh_ExpressionResult = EVAL(lc_MCh_Expression)
						
						ln_MCh_VariableValue	= &lc_MCh_VariableName	
						
						&lc_MCh_VariableName    = IIF(ISNULL(ln_MCh_ExpressionResult), 0, ln_MCh_ExpressionResult)
						
						
		
						IF VARTYPE(.nTotalType) $ 'NFIBY' AND ;
								INLIST(.nTotalType, cnTOTAL_COUNT, cnTOTAL_SUM, ;
								cnTOTAL_AVERAGE, cnTOTAL_LOWEST, cnTOTAL_HIGHEST, cnTOTAL_STDDEV, cnTOTAL_VARIANCE)
						ELSE
							LOOP
						ENDIF
		
		*-- Calculate total value
						DO CASE
							CASE .nTotalType = cnTOTAL_COUNT
		*-- Tak kak znachenie globalnoy peremennoy moget bit' izmeneno gde-to v programme. to nam nado obnovit' properti: 	
								.nCalculatedValue = ln_MCh_VariableValue					
								.nCalculatedValue = .nCalculatedValue + 1
		
							CASE .nTotalType = cnTOTAL_SUM
								.nCalculatedValue = ln_MCh_VariableValue
								.nCalculatedValue = .nCalculatedValue + &lc_MCh_VariableName
		
							CASE .nTotalType = cnTOTAL_LOWEST
							
								IF !ISNULL(ln_MCh_ExpressionResult)
												
									.nCalculatedValue = ln_MCh_VariableValue						
		
						
									DO CASE
									CASE VARTYPE(&lc_MCh_VariableName) = "T" AND VARTYPE(.nCalculatedValue) <> "T"
									
									DO CASE
										CASE VARTYPE(.nCalculatedValue) = "C"
											.nCalculatedValue = CTOT(.nCalculatedValue)
										CASE VARTYPE(.nCalculatedValue) = "D"								
											.nCalculatedValue = DTOT(.nCalculatedValue)								
										CASE VARTYPE(.nCalculatedValue) = "L"								
											.nCalculatedValue = &lc_MCh_VariableName																								
										OTHERWISE
											.nCalculatedValue = &lc_MCh_VariableName															
										ENDCASE
									
									CASE VARTYPE(&lc_MCh_VariableName) = "D" AND VARTYPE(.nCalculatedValue) <> "D"							
		
										DO CASE
										CASE VARTYPE(.nCalculatedValue) = "C"
											.nCalculatedValue = CTOD(.nCalculatedValue)
										CASE VARTYPE(.nCalculatedValue) = "T"								
											.nCalculatedValue = TTOD(.nCalculatedValue)								
										CASE VARTYPE(.nCalculatedValue) = "L"								
											.nCalculatedValue = &lc_MCh_VariableName
										OTHERWISE
											.nCalculatedValue = &lc_MCh_VariableName
										ENDCASE
		
									ENDCASE
									
									.nCalculatedValue = IIF(.nCalculatedValue > &lc_MCh_VariableName, &lc_MCh_VariableName, .nCalculatedValue)
		
								ENDIF
							CASE .nTotalType = cnTOTAL_HIGHEST
							
								IF !ISNULL(ln_MCh_ExpressionResult)
								
									.nCalculatedValue = ln_MCh_VariableValue												
								
									DO CASE
									CASE VARTYPE(&lc_MCh_VariableName) = "T" AND VARTYPE(.nCalculatedValue) <> "T"
									
									DO CASE
										CASE VARTYPE(.nCalculatedValue) = "C"
											.nCalculatedValue = CTOT(.nCalculatedValue)
										CASE VARTYPE(.nCalculatedValue) = "D"								
											.nCalculatedValue = DTOT(.nCalculatedValue)								
										CASE VARTYPE(.nCalculatedValue) = "L"								
											.nCalculatedValue = &lc_MCh_VariableName
										OTHERWISE
											.nCalculatedValue = &lc_MCh_VariableName
										ENDCASE
									
									CASE VARTYPE(&lc_MCh_VariableName) = "D" AND VARTYPE(.nCalculatedValue) <> "D"							
		
										DO CASE
										CASE VARTYPE(.nCalculatedValue) = "C"
											.nCalculatedValue = CTOD(.nCalculatedValue)
										CASE VARTYPE(.nCalculatedValue) = "T"								
											.nCalculatedValue = TTOD(.nCalculatedValue)								
										CASE VARTYPE(.nCalculatedValue) = "L"								
											.nCalculatedValue = &lc_MCh_VariableName																								
										OTHERWISE
											.nCalculatedValue = &lc_MCh_VariableName																
										ENDCASE
		
									
									ENDCASE
		
		
									.nCalculatedValue = IIF(.nCalculatedValue < &lc_MCh_VariableName, &lc_MCh_VariableName, .nCalculatedValue)
		
								ENDIF
		
							CASE .nTotalType = cnTOTAL_STDDEV
							CASE .nTotalType = cnTOTAL_VARIANCE
							CASE .nTotalType = cnTOTAL_AVERAGE
		
								IF !ISNULL(ln_MCh_ExpressionResult)
		
									.nAverageValue    = .nAverageValue + &lc_MCh_VariableName
									.nCalculatedValue = .nAverageValue/.nDivider
		
									.nDivider         = .nDivider + 1
		
								ENDIF
		
						ENDCASE
		
						&lc_MCh_VariableName = .nCalculatedValue
		
					ENDWITH
		
				NEXT ln_MCh_Count
		
			ENDIF
		ENDWITH
		
		
	ENDPROC

	PROCEDURE quitapp
	ENDPROC

	PROCEDURE release		&& Releases a FormSet or Form from memory.
		THIS._Release()
	ENDPROC

	PROCEDURE renderbox		&& Used by Report Listener
		LPARAMETERS tnLeft, tnTop, tnWidth, tnHeight, tnLineWidth, tnLineColor, tnLineStyle, tnTransparent, ;
			tnFillBackColor, tnFillForeColor, tnFillStyle, tnRectangleType, tcComment	&&, tnFRXRecno
		
		
		LOCAL lnLineStyle
		LOCAL lnFillStyle
		LOCAL lnLineColor
		LOCAL lnFillForeColor
		LOCAL lnFillBackColor
		LOCAL lnRectangleType
		
		LOCAL llTransparent
		LOCAL llSkipBackColor
		
		WITH THIS
		
			tnLineWidth   = IIF(tnLineStyle = cnREPORT_PEN_PATTERN_NONE, 0, tnLineWidth)
		
			llTransparent = IIF(tnTransparent = 0, .F., .T.)
			llTransparent = tnFillBackColor < 0  OR llTransparent
		
			lnLineColor   = IIF(tnLineColor < 0, 0, tnLineColor)
		
			DO CASE
				CASE tnFillStyle = cnREPORT_FILL_PATTERN_NO_FILL_NO_COLOR
					lnFillForeColor = RGB(255, 255, 255)
					lnFillBackColor = RGB(255, 255, 255)
		
				CASE tnFillStyle = cnREPORT_FILL_PATTERN_NO_FILL_ONLY_COLOR
					lnFillForeColor = IIF(tnFillForeColor < 0 , RGB(255, 255, 255), tnFillForeColor)
					lnFillBackColor = IIF(tnFillBackColor < 0 , RGB(255, 255, 255), tnFillBackColor)
		
				OTHERWISE
					lnFillForeColor = IIF(tnFillForeColor < 0 , 0, tnFillForeColor)
					lnFillBackColor = RGB(255, 255, 255)
		
			ENDCASE
		
			lnLineStyle     = .GetPenPattern(tnLineStyle)
			lnFillStyle     = .GetFillPattern(tnFillStyle)
		
			lnRectangleType	= .GetRectangleType(tnRectangleType)
		
		
			DO CASE
				CASE .nExportFileType = cnHTML
		
					llSkipBackColor = (llTransparent AND lnFillStyle # 1) OR lnFillStyle # 1
		
					.WriteBox(tnTop - .nPhysicalPaperTopMargin, tnLeft - .nPhysicalPaperLeftMargin, tnHeight, tnWidth, tnLineWidth, ;
						lnLineColor, lnLineStyle, llTransparent, lnFillBackColor, lnFillStyle, '', llSkipBackColor)
		
				CASE .nExportFileType = cnWORD
		*-- Convert Pixels into Points
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
		
					.WriteBox(tnTop, tnLeft, tnHeight, tnWidth, tnLineWidth, lnLineColor, lnLineStyle, llTransparent, lnFillBackColor,;
						lnFillForeColor, lnFillStyle, lnRectangleType)
		
				CASE .nExportFileType = cnRTF
		*-- Convert Pixels into Points
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
					IF .nRTFOutPutType # cnRTF_OUTPUT_PLAIN
						.WriteBox(tnTop, tnLeft, tnHeight, tnWidth, tnLineWidth, lnLineColor, lnLineStyle, llTransparent, lnFillBackColor,;
							lnFillForeColor, lnFillStyle, lnRectangleType)
		
					ELSE
						.AddBoxToCursor(.nCurrentPage, cnREPOBJ_BOX, '', tnWidth, tnHeight, tnTop, tnLeft, lnLineColor, tnLineWidth, ;
							lnLineStyle, llTransparent, lnFillBackColor, lnFillStyle, lnFillForeColor, lnRectangleType)
		
					ENDIF
		
				CASE .nExportFileType = cnEXCEL
		
		*-- Convert Pixels into Points
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
					.AddBoxToCursor(.nCurrentPage, cnREPOBJ_BOX, '', tnWidth, tnHeight, tnTop, tnLeft, lnLineColor, tnLineWidth, ;
						lnLineStyle, llTransparent, -1, -1, lnFillStyle, lnRectangleType)
		
				CASE .nExportFileType = cnPREVIEW
		
		
					.WriteBox(tnTop, tnLeft, tnHeight, tnWidth, tnLineWidth, lnLineColor, lnLineStyle, llTransparent, lnFillBackColor, ;
						lnFillForeColor, lnFillStyle, lnRectangleType, tcComment)
		
				CASE .nExportFileType = cnPDF
		*-- Convert Pixels into Points
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
		
					tnTop    = tnTop - IIF(.lPrintableArea, .nPhysicalPaperTopMargin, 0)
					tnLeft   = tnLeft - IIF(.lPrintableArea, .nPhysicalPaperLeftMargin, 0)
		
		
					.WriteBox(tnTop, tnLeft, tnHeight, tnWidth, tnLineWidth, lnLineColor, lnLineStyle, lnFillBackColor, lnFillForeColor, ;
						lnFillStyle, lnRectangleType)
		
				CASE .nExportFileType = cnXML
		
				CASE .nExportFileType = cnIMAGE
		
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
					.WriteBox(tnTop, tnLeft, tnHeight, tnWidth, tnLineWidth, lnLineColor, lnLineStyle, llTransparent, ;
						lnFillForeColor , lnFillBackColor, lnFillStyle, lnRectangleType)
		
			ENDCASE
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE renderchart
		LPARAMETERS toChart, tnLeft, tnTop, tnWidth, tnHeight
		
		WITH THIS
			DO CASE
				CASE .nExportFileType = cnHTML
					.WriteChart(toChart, tnLeft - .nPhysicalPaperLeftMargin, tnTop - .nPhysicalPaperTopMargin, tnWidth, tnHeight)
		
				CASE .nExportFileType = cnWORD
		*-- Convert Pixels into Points
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
					.WriteChart(toChart, tnLeft, tnTop, tnWidth, tnHeight)
				
				CASE .nExportFileType = cnRTF
		*-- Convert Pixels into Points
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
		
					.WriteChart(toChart, tnLeft, tnTop, tnWidth, tnHeight, .nCurrentPage)						
		
				CASE .nExportFileType = cnEXCEL
		
		*-- Convert Pixels into Points
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
					.WriteChart(toChart, tnLeft, tnTop, tnWidth, tnHeight, .nCurrentPage)			
		
				CASE .nExportFileType = cnPREVIEW
		
					.WriteChart(toChart, tnLeft, tnTop, tnWidth, tnHeight)		
		
				CASE .nExportFileType = cnPDF
		*-- Convert Pixels into Points
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
					tnTop    = tnTop - IIF(.lPrintableArea,.nPhysicalPaperTopMargin, 0)
					tnLeft   = tnLeft - IIF(.lPrintableArea,.nPhysicalPaperLeftMargin, 0)
		
		
					.WriteChart(toChart, tnLeft, tnTop, tnWidth, tnHeight)
		
				CASE .nExportFileType = cnXML
		
				CASE .nExportFileType = cnIMAGE
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
					.WriteChart(toChart, tnLeft, tnTop, tnWidth, tnHeight)
		
			ENDCASE
			
		
		ENDWITH
	ENDPROC

	PROCEDURE renderimage		&& Used by Report Listener
		LPARAMETERS tcImageFileFullName, tnLeft, tnTop, tnWidth, tnHeight, tnScalePicture, tiGDIPlusImage, tcComment
		
		LOCAL loImage
		
		LOCAL lcImageFileFullName
		LOCAL lcImageFolderName
		LOCAL lcOldSafety
		
		LOCAL llTransparent
		LOCAL llIsImageUsed
		
		WITH THIS
		
			IF VARTYPE(tiGDIPlusImage) = 'N' AND tiGDIPlusImage > 0
				tcImageFileFullName = FORCEEXT(ADDBS(SYS(2023)) +  SYS(2015), 'PNG')
		
				loImage = NEWOBJECT(ccGDIPLUS_CLASS_IMAGE, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME, '', tiGDIPlusImage)
		
				IF !loImage.SaveToFile(tcImageFileFullName)
					RETURN
				ENDIF
		
			ENDIF
		
		
			IF FILE(tcImageFileFullName)
		
				DO CASE
					CASE .nExportFileType = cnHTML
		
						llIsImageUsed = .F.
						lcImageFolderName = ADDBS(THIS.cSaveFolder) +  ADDBS(ALLTRIM(THIS.cExportFileName) + '_Images')
		
						lcOldSafety = SET('SAFETY')
						SET SAFETY OFF
		
						THIS.ClearError()
		
						IF !DIRECTORY(lcImageFolderName)
							MD (lcImageFolderName)
						ENDIF
		
						lcImageFileFullName = lcImageFolderName +  FORCEEXT(JUSTSTEM(tcImageFileFullName) + '_' + ALLTRIM(STR(tnHeight)) + '_' + ALLTRIM(STR(tnWidth)) + '_' + ALLTRIM(STR(tnScalePicture)), JUSTEXT(tcImageFileFullName))
		
						llIsImageUsed = .IsImageUsed(lcImageFileFullName)
		
						IF !llIsImageUsed
							COPY FILE (tcImageFileFullName) TO (lcImageFileFullName)
						ENDIF
		
		
						SET SAFETY &lcOldSafety
		
						.WriteImage(lcImageFileFullName, tnTop - .nPhysicalPaperTopMargin, tnLeft - .nPhysicalPaperLeftMargin, tnHeight, tnWidth, tnScalePicture, '', llIsImageUsed)
		
		
					CASE .nExportFileType = cnWORD
						tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
						tnTop    = tnTop * cnPOINTS_PER_PIXELS
						tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
						tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
						tnTop    = tnTop - .nPhysicalPaperTopMargin
						tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
						.WriteImage(tcImageFileFullName,  tnTop, tnLeft, tnHeight, tnWidth, tnScalePicture)
		
					CASE .nExportFileType = cnRTF
						tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
						tnTop    = tnTop * cnPOINTS_PER_PIXELS
						tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
						tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
						tnTop    = tnTop - .nPhysicalPaperTopMargin
						tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
						IF .nRTFOutPutType # cnRTF_OUTPUT_PLAIN
							.WriteImage(tcImageFileFullName,  tnTop, tnLeft, tnHeight, tnWidth, tnScalePicture)
		
						ELSE
							.AddImageToCursor(.nCurrentPage, cnREPOBJ_IMAGE, tcImageFileFullName, cnIMAGE_SOURCE_FILE, '', tnScalePicture, tnWidth, tnHeight, tnTop, tnLeft)
		
						ENDIF
		
					CASE .nExportFileType = cnEXCEL
		
						tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
						tnTop    = tnTop * cnPOINTS_PER_PIXELS
						tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
						tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
						.AddImageToCursor(.nCurrentPage, cnREPOBJ_IMAGE, tcImageFileFullName, cnIMAGE_SOURCE_FILE, '', tnScalePicture, tnWidth, tnHeight, tnTop, tnLeft)
		
					CASE .nExportFileType = cnPREVIEW
		
						.WriteImage(tcImageFileFullName,  tnTop, tnLeft, tnHeight, tnWidth, tnScalePicture)
		
		
					CASE .nExportFileType = cnPDF
		
						tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
						tnTop    = tnTop * cnPOINTS_PER_PIXELS
						tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
						tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
						tnTop    = tnTop - IIF(.lPrintableArea,.nPhysicalPaperTopMargin, 0)
						tnLeft   = tnLeft - IIF(.lPrintableArea,.nPhysicalPaperLeftMargin,0)
		
		
						lcImageFileFullName = ADDBS(SYS(2023)) +  FORCEEXT(JUSTSTEM(tcImageFileFullName) + '_' + ALLTRIM(STR(tnHeight)) + '_' + ALLTRIM(STR(tnWidth)) + '_' + ALLTRIM(STR(tnScalePicture)), JUSTEXT(tcImageFileFullName))
		
						COPY FILE (tcImageFileFullName) TO (lcImageFileFullName)
		
						.WriteImage(lcImageFileFullName,  tnTop, tnLeft, tnHeight, tnWidth, tnScalePicture)
		
					CASE .nExportFileType = cnXML
		
					CASE .nExportFileType = cnIMAGE
		
						tnTop    = tnTop - .nPhysicalPaperTopMargin
						tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
						.WriteImage(tcImageFileFullName, tnTop, tnLeft, tnHeight, tnWidth, tnScalePicture, tcComment)
		
				ENDCASE
		
				IF VARTYPE(tiGDIPlusImage) = 'N' AND tiGDIPlusImage > 0
					ERASE (tcImageFileFullName)
				ENDIF
		
			ENDIF
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE renderline		&& Used by Report Listener
		LPARAMETERS tnLeft, tnTop, tnWidth, tnHeight, tnLineWidth, tnLineColor, tnLineStyle, tnVertical	&&, tnFRXRecno
		
		
		LOCAL lnLineStyle
		LOCAL lnLineColor
		
		LOCAL llVertical
		
		WITH THIS
		
			tnLineWidth   = IIF(tnLineStyle = cnREPORT_PEN_PATTERN_NONE, 0, tnLineWidth) 
		
			lnLineColor = IIF(tnLineColor < 0, 0, tnLineColor)
			llVertical	= IIF(tnVertical = 0, .T., .F.)
		
			lnLineStyle = .GetPenPattern(tnLineStyle)
		
			DO CASE
				CASE .nExportFileType = cnHTML
				
					tnWidth  = IIF(llVertical, 0, tnWidth)
					tnHeight = IIF(llVertical, tnHeight, 0)			
				
		
					.WriteLine(tnTop - .nPhysicalPaperTopMargin, tnLeft - .nPhysicalPaperLeftMargin, tnHeight, tnWidth, tnLineWidth, lnLineColor, lnLineStyle)
		
				CASE .nExportFileType = cnWORD
		
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
					tnTop  = tnTop - .nPhysicalPaperTopMargin
					tnLeft = tnLeft - .nPhysicalPaperLeftMargin
		
		
					tnWidth  = IIF(llVertical, 0, tnWidth)
					tnHeight = IIF(llVertical, tnHeight, 0)			
		
		
					.WriteLine(tnTop, tnLeft, tnTop + tnHeight, tnLeft + tnWidth, tnLineWidth, lnLineColor, lnLineStyle)
				
				
				CASE .nExportFileType = cnRTF
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
		
					tnTop  = tnTop - .nPhysicalPaperTopMargin
					tnLeft = tnLeft - .nPhysicalPaperLeftMargin
		
		
					tnWidth  = IIF(llVertical, 0, tnWidth)
					tnHeight = IIF(llVertical, tnHeight, 0)			
		
		
					IF .nRTFOutPutType # cnRTF_OUTPUT_PLAIN
						.WriteLine(tnTop, tnLeft, tnHeight,  tnWidth, tnLineWidth, lnLineColor, lnLineStyle)
		
					ELSE
						.AddLineToCursor(.nCurrentPage, cnREPOBJ_LINE, '', tnWidth, tnHeight, tnTop, tnLeft, lnLineColor, tnLineWidth, lnLineStyle, llVertical)
		
					ENDIF
		
		
				CASE .nExportFileType = cnEXCEL
		
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
		
					tnWidth  = IIF(llVertical, 0, tnWidth)
					tnHeight = IIF(llVertical, tnHeight, 0)			
		
		
					tnHeight = IIF(llVertical, tnTop + tnHeight, tnTop)
					tnWidth  = IIF(llVertical, tnLeft, tnLeft + tnWidth)
		
		
					.AddLineToCursor(.nCurrentPage, cnREPOBJ_LINE, '', tnWidth, tnHeight, tnTop, tnLeft, lnLineColor, tnLineWidth, lnLineStyle, llVertical)			
		
				CASE .nExportFileType = cnPREVIEW
				
		
					tnWidth  = IIF(llVertical, 0, tnWidth)
					tnHeight = IIF(llVertical, tnHeight, 0)			
		
		
					.WriteLine(tnTop, tnLeft, tnHeight,  tnWidth, tnLineWidth, lnLineColor, lnLineStyle)
				
		
				CASE .nExportFileType = cnPDF
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
		
					tnTop    = tnTop - IIF(.lPrintableArea, .nPhysicalPaperTopMargin, 0)
					tnLeft   = tnLeft - IIF(.lPrintableArea, .nPhysicalPaperLeftMargin, 0)
					
					
					tnWidth  = IIF(llVertical, 0, tnWidth)
					tnHeight = IIF(llVertical, tnHeight, 0)			
					
					
		
					.WriteLine(tnTop, tnLeft, tnTop + tnHeight, tnLeft + tnWidth, tnLineWidth, lnLineColor, lnLineStyle)
		
		
				CASE .nExportFileType = cnXML
		
				CASE .nExportFileType = cnIMAGE
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
		
					tnWidth  = IIF(llVertical, 0, tnWidth)
					tnHeight = IIF(llVertical, tnHeight, 0)			
		
		
					.WriteLine(tnTop, tnLeft, tnTop + tnHeight, tnLeft + tnWidth, tnLineWidth, lnLineColor, lnLineStyle)
		
			ENDCASE
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE rendertext		&& Used by Report Listener
		LPARAMETERS tcText, tcFontName, tlFontBold, tlFontItalic, tlFontUnderline, tlFontStrikethrough, tnFontSize,;
			tnLeft, tnTop, tnWidth, tnHeight, tnAlignment, tnTransparent, tnTrimMode, tnForeColor, tnFillColor, tnItemType, tcComment	&&, tnFRXRecno
		
		LOCAL laTextLines[1]
		
		LOCAL lnAlignment
		LOCAL lnForeColor
		LOCAL lnFillColor
		
		LOCAL lnCount
		LOCAL lnTotalParts
		LOCAL lnTotalParts2
		LOCAL lnCharachtersReturned
		LOCAL lnTop
		LOCAL lnStartOfString
		LOCAL lnStringHeight
		
		LOCAL lcRestLinePerObject
		LOCAL lcPartOfString
		
		LOCAL llTransparent
		LOCAL llWrapText
		
		WITH THIS
		
			IF VARTYPE(tcText)#'C' OR (LEN(tcText) <= 0 AND !THIS.lPrintEmptyField)
				RETURN
			ENDIF
		
			lnStringHeight = tnHeight
		
			tnItemType = IIF(!EMPTY(tnItemType), tnItemType, cnREPOBJ_FIELD)
		
		
			IF tnItemType = cnREPOBJ_FIELD OR (tnItemType = cnREPOBJ_TEXT AND OCCURS(ccLF, tcText) > 0)
		
				tcText = .PreProcess(tcText, tcFontName, tlFontBold, tlFontItalic, tlFontUnderline, tlFontStrikethrough, tnFontSize, tnWidth, @lnStringHeight, tnAlignment, tnTrimMode, tnItemType)
		
				IF tnItemType = cnREPOBJ_FIELD
					tnTop = tnTop - 1
				ENDIF
			ENDIF
		
			lnForeColor = IIF(tnForeColor < 0, 0, tnForeColor)
			lnFillColor = IIF(tnFillColor < 0 , RGB(255, 255, 255), tnFillColor)
		
			llTransparent = IIF(tnTransparent = 0, .F., .T.)
		
			lnAlignment   = .GetAlignment(tnAlignment)
		
			DO CASE
				CASE INLIST(.nExportFileType, cnHTML, cnIMAGE)
		
					tnFontSize  = tnFontSize/cnPOINTS_PER_PIXELS
		
				CASE INLIST(.nExportFileType, cnRTF)
			ENDCASE
		
			DO CASE
				CASE .nExportFileType = cnHTML
		
					.WriteText(tcText, tnTop - .nPhysicalPaperTopMargin, tnLeft - .nPhysicalPaperLeftMargin, tnHeight, tnWidth, lnForeColor, lnFillColor, llTransparent, lnAlignment, tcFontName, tnFontSize, tlFontBold, tlFontItalic, tlFontUnderline)
		
				CASE .nExportFileType = cnWORD
		
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
		
					llWrapText = IIF(EMPTY(tnItemType) OR tnItemType = cnREPOBJ_TEXT, .F., .T.)
		
					.WriteText(tcText, tnTop, tnLeft, tnHeight, tnWidth, tcFontName, tlFontBold, tlFontItalic, tlFontUnderline, tlFontStrikethrough, tnFontSize, lnAlignment, llTransparent, lnForeColor, lnFillColor, llWrapText)
		
		
				CASE .nExportFileType = cnRTF
		
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS &&&- .nPhysicalPaperLeftMargin
					tnTop    = tnTop * cnPOINTS_PER_PIXELS &&&-  .nPhysicalPaperTopMargin
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
					llWrapText = IIF(EMPTY(tnItemType) OR tnItemType = cnREPOBJ_TEXT, .F., .T.)
		
					IF .nRTFOutPutType # cnRTF_OUTPUT_PLAIN
						.WriteText(tcText,;
							tnTop, tnLeft, tnHeight, tnWidth,;
							tcFontName, tlFontBold, tlFontItalic, tlFontUnderline, tlFontStrikethrough, ;
							tnFontSize, lnAlignment, llTransparent, lnForeColor, lnFillColor, llWrapText)
		
					ELSE
		
		
						IF tnItemType = cnREPOBJ_TEXT
							tnLeft   = tnLeft  - (cnWORD_TEXT_WIDTH_MEASURE_FACTOR/2)
							tnWidth  = tnWidth + cnWORD_TEXT_WIDTH_MEASURE_FACTOR
						ENDIF
		
		
		
						lnStringHeight = lnStringHeight * cnPOINTS_PER_PIXELS
		
						lnTotalParts = OCCURS(ccCR, tcText)
		
						IF lnTotalParts > 0
		
							lnTop			    = tnTop
							lnTotalParts        = lnTotalParts + 1
		
							lcRestLinePerObject = tcText
		
							FOR lnCount = 1 TO lnTotalParts
		
								lnCharachtersReturned = AT(ccCR, lcRestLinePerObject, 1)
		
								DO CASE
									CASE lnCharachtersReturned = 1
										lcPartOfString = SUBSTR(lcRestLinePerObject, 1, lnCharachtersReturned)
										lnCharachtersReturned = 0
		
									CASE lnCharachtersReturned > 1
										lnCharachtersReturned = lnCharachtersReturned - 1
										lcPartOfString = SUBSTR(lcRestLinePerObject, 1, lnCharachtersReturned)
		
									OTHERWISE
										lcPartOfString = SUBSTR(lcRestLinePerObject, 1)
								ENDCASE
		
								.AddTextToCursor(.nCurrentPage,;
									tnItemType,;
									tnWidth,;
									lnStringHeight,;
									lnTop,;
									tnLeft,;
									lcPartOfString,;
									lnForeColor,;
									tcFontName,;
									'',;
									tnFontSize,;
									tlFontItalic,;
									tlFontBold,;
									tlFontUnderline,;
									tlFontStrikethrough,;
									llTransparent,;
									.F.,;
									0,;
									lnFillColor,;
									lnAlignment)
		
		
								lnTop               = lnTop + lnStringHeight &&+ 1.3
								lnStartOfString     = lnCharachtersReturned + 2
								lcRestLinePerObject = SUBSTR(lcRestLinePerObject, lnStartOfString)
		
							ENDFOR
		
						ELSE
		
							.AddTextToCursor(.nCurrentPage,;
								tnItemType,;
								tnWidth,;
								tnHeight,;
								tnTop,;
								tnLeft,;
								tcText,;
								lnForeColor,;
								tcFontName,;
								'',;
								tnFontSize,;
								tlFontItalic,;
								tlFontBold,;
								tlFontUnderline,;
								tlFontStrikethrough,;
								llTransparent,;
								.F.,;
								0,;
								lnFillColor,;
								lnAlignment)
						ENDIF
					ENDIF
		
				CASE .nExportFileType = cnEXCEL
		
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
					llWrapText = .T.
		
					tcText     = STRTRAN(tcText, ccCR, ccLF)
		
		
					lnTotalParts   = OCCURS(ccLF, tcText)
		
					IF lnTotalParts > 0
		
						lnTotalParts  = lnTotalParts + 1
						lnTotalParts2 = INT(tnHeight/lnStringHeight)
		
						lnTotalParts  = IIF(lnTotalParts2 > lnTotalParts, lnTotalParts2, lnTotalParts)
		
						tnFontSize    = tnFontSize - IIF(lnStringHeight * lnTotalParts > tnHeight, 1, 0)
		
					ENDIF
		
		
					.AddTextToCursor(.nCurrentPage, tnItemType, tnWidth, tnHeight, tnTop, tnLeft, tcText, lnForeColor, tcFontName, '', ;
						tnFontSize, tlFontItalic, tlFontBold, tlFontUnderline, tlFontStrikethrough, llTransparent, llWrapText, 0, lnFillColor, ;
						IIF(VARTYPE(tcText) = 'N', 0, 1), '', lnAlignment)
		
		
				CASE .nExportFileType = cnPREVIEW
		
		
					tcText  = STRTRAN(tcText, ccCR, ccLF)
		
					.WriteText(tcText, tnTop, tnLeft, tnHeight, tnWidth, lnForeColor, lnFillColor, llTransparent, lnAlignment, tcFontName, tnFontSize, tlFontBold, tlFontItalic, tlFontUnderline, lnStringHeight, tnItemType, tcComment)
		
				CASE .nExportFileType = cnPDF
					tnLeft   = tnLeft * cnPOINTS_PER_PIXELS
					tnTop    = tnTop * cnPOINTS_PER_PIXELS
					tnWidth  = tnWidth * cnPOINTS_PER_PIXELS
					tnHeight = tnHeight * cnPOINTS_PER_PIXELS
		
		
					tnTop    = tnTop - IIF(.lPrintableArea, .nPhysicalPaperTopMargin, 0)
					tnLeft   = tnLeft - IIF(.lPrintableArea, .nPhysicalPaperLeftMargin, 0)
		
		
					lnStringHeight = lnStringHeight * cnPOINTS_PER_PIXELS
		
		
					tcText = STRTRAN(tcText, ccTAB, '    ')
		
		
					IF THIS.nVfpversion > 6
		
						lnTotalParts   = ALINES(laTextLines, tcText, .F., ccCR)
		
					ELSE
		
						lnTotalParts   = ALINES(laTextLines, tcText, ccCR)
		
					ENDIF
		
		
					lnTop		   = tnTop
		
					FOR lnCount = 1 TO lnTotalParts
						.WriteText(laTextLines[lnCount] , lnTop, tnLeft, lnStringHeight, tnWidth, tcFontName, tlFontBold, tlFontItalic, tlFontUnderline, tlFontStrikethrough, tnFontSize, lnAlignment, llTransparent, lnForeColor, lnFillColor)
		
						lnTop = lnTop + lnStringHeight
					ENDFOR
		
				CASE .nExportFileType = cnXML
		
				CASE .nExportFileType = cnIMAGE
		
					tnTop    = tnTop - .nPhysicalPaperTopMargin
					tnLeft   = tnLeft - .nPhysicalPaperLeftMargin
		
					.WriteText(tcText, tnTop, tnLeft, tnHeight, tnWidth, lnForeColor, lnFillColor, llTransparent, lnAlignment, tcFontName, tnFontSize, tlFontBold, tlFontItalic, tlFontUnderline)
		
			ENDCASE
		
		ENDWITH
		
		
		
		
		
		
	ENDPROC

	PROTECTED PROCEDURE replacesysvar		&& Replace some system variables in expression
	ENDPROC

	PROTECTED PROCEDURE resetcalculatedfields
		LPARAMETERS toBand, tnResetAt
		
		LOCAL lnObjects
		LOCAL lnCount
		LOCAL lnResetAt
		
		LOCAL loObject
		
		lnResetAt = tnResetAt
		
		IF !ISNULL(toBand)
			WITH THIS
		
				lnObjects = IIF(ISNULL(toBand.aItems), 0, ALEN(toBand.aItems))
		
				FOR lnCount = 1 TO lnObjects
		
					loObject = toBand.aItems[lnCount]
		
					WITH loObject
						IF PEMSTATUS(loObject, 'nTotalType', 5) AND ;
								VARTYPE(.nTotalType) $ 'NFIBY' AND ;
								INLIST(.nTotalType, cnTOTAL_COUNT, cnTOTAL_SUM, ;
								cnTOTAL_AVERAGE, cnTOTAL_LOWEST, cnTOTAL_HIGHEST, cnTOTAL_STDDEV, cnTOTAL_VARIANCE)
						ELSE
							LOOP
						ENDIF
		
						IF .nResetAt = lnResetAt OR lnResetAt = cnRESET_ON_START_OF_REPORT
							.nCalculatedValue = .F. 
						ENDIF
						
					ENDWITH
		
				NEXT lnCount
		
			ENDWITH
		ENDIF
		
	ENDPROC

	PROTECTED PROCEDURE resetcalculations
		LPARAMETERS tnResetAt
		
		LOCAL lnResetAt
		
		lnResetAt = tnResetAt
		
		WITH THIS
		
			.ResetVariables(lnResetAt)
		
			IF VARTYPE(.oPageHeaderBand) = 'O'
				.oPageHeaderBand.lPrintInFirstWholeBand = .T.
		
				IF .oPageHeaderBand.lCalculation
					.ResetCalculatedFields(.oPageHeaderBand, lnResetAt)
				ENDIF
			ENDIF
		
			IF VARTYPE(.oPageFooterBand) = 'O'
				.oPageFooterBand.lPrintInFirstWholeBand = .T.
		
				IF .oPageFooterBand.lCalculation
					.ResetCalculatedFields(.oPageFooterBand, lnResetAt)
				ENDIF
			ENDIF
		
			IF VARTYPE(.oDetailBand) = 'O'
				.oDetailBand.lPrintInFirstWholeBand = .T.
		
				IF .oDetailBand.lCalculation
					.ResetCalculatedFields(.oDetailBand, lnResetAt)
				ENDIF
			ENDIF
		
			IF VARTYPE(.oSummaryBand) = 'O'
				.oSummaryBand.lPrintInFirstWholeBand = .T.
		
				IF .oSummaryBand.lCalculation
					.ResetCalculatedFields(.oSummaryBand, lnResetAt)
				ENDIF
			ENDIF
		
			FOR lnCount = 1 TO ALEN(.aGroupbands, 1)
				IF VARTYPE(.aGroupbands[lnCount, 1]) = 'O'
		
					.aGroupbands[lnCount, 1].lPrintInFirstWholeBand = .T.
		
					IF .aGroupbands[lnCount, 1].lCalculation
						.ResetCalculatedFields(.aGroupbands[lnCount, 1], lnResetAt)
					ENDIF
				ENDIF
		
				IF VARTYPE(.aGroupbands[lnCount, 2]) = 'O'
		
					.aGroupbands[lnCount, 2].lPrintInFirstWholeBand = .T.
		
					IF .aGroupbands[lnCount, 2].lCalculation
						.ResetCalculatedFields(.aGroupbands[lnCount, 2], lnResetAt)
					ENDIF
				ENDIF
		
			NEXT lnCount
		ENDWITH
		
	ENDPROC

	PROCEDURE resetremoveobjects		&& Detect removable objects
		LPARAMETERS toBand, tlOverItems, tnGroupNumber, tlNewGroup
		
		LOCAL loObject
		LOCAL loMoveObject
		LOCAL loBlankObject
		
		LOCAL lcExpression
		LOCAL lcExpression
		
		LOCAL lnCount
		LOCAL lnObjects
		LOCAL lnMaxHeightDelta
		LOCAL lnMoveTotal
		LOCAL lnMoveCount
		LOCAL lnBlankObjectsCount
		LOCAL lnBlankObjects
		
		LOCAL luExpression
		
		LOCAL llRemovingApprove
		LOCAL llDontPrint
		LOCAL llPrintRepeats
		
		LOCAL luExpressionValue
		
		lnObjects = IIF(ISNULL(toBand.aItems), 0, ALEN(toBand.aItems, 1))
		
		lnMaxHeightDelta        = 0
		
		
		FOR lnCount = 1 TO lnObjects
		
			toBand.aItems[lnCount].nSurBottomDelta = 0
			toBand.aItems[lnCount].nMoveDelta 	   = 0
		
		NEXT
		
		FOR lnCount = 1 TO lnObjects
		
			loObject = toBand.aItems[lnCount]
		
			llPrintRepeats = loObject.lPrintRepeats
		
			IF !llPrintRepeats
		
				IF loObject.nObjectType = cnREPOBJ_FIELD
					lcExpression = ALLT(loObject.cExpression)
		
					IF PEMSTATUS(loObject, 'nTotalType', 5) AND ;
							VARTYPE(loObject.nTotalType) $ 'NFIBY' AND ;
							INLIST(loObject.nTotalType, cnTOTAL_COUNT, cnTOTAL_SUM, ;
							cnTOTAL_AVERAGE, cnTOTAL_LOWEST, cnTOTAL_HIGHEST, cnTOTAL_STDDEV, cnTOTAL_VARIANCE)
		
						lcTypeCalculatedValue = VARTYPE(loObject.nCalculatedValue)
		
						DO CASE
							CASE lcTypeCalculatedValue $ 'NFIBY'
								luExpressionValue = loObject.nCalculatedValue
		
							CASE lcTypeCalculatedValue = 'L' AND loObject.nTotalType = cnTOTAL_COUNT
								luExpressionValue = 0
		
							CASE lcTypeCalculatedValue = 'L' AND loObject.nTotalType = cnTOTAL_SUM
								luExpressionValue = 0
		
							OTHERWISE
								luExpressionValue = '****'
						ENDCASE
		
					ELSE
						luExpressionValue = EVAL(lcExpression)
					ENDIF
		
		
					IF VARTYPE(luExpressionValue) = VARTYPE(loObject.uRepeatedValue)
		
						IF loObject.uRepeatedValue # luExpressionValue
							loObject.uRepeatedValue = luExpressionValue
		
							llPrintRepeats = .T.
						ENDIF
					ELSE
						loObject.uRepeatedValue = luExpressionValue
						llPrintRepeats = .T.
					ENDIF
		
		
				ENDIF
		
				IF !llPrintRepeats
		
					DO CASE
						CASE !EMPTY(tnGroupNumber) AND !EMPTY(loObject.nPrintOnGroupChange) AND tlNewGroup
							llPrintRepeats = IIF(loObject.nPrintOnGroupChange = tnGroupNumber, .T., .F.)
		
						CASE loObject.lPrintInFirstWholeBand
							llPrintRepeats = toBand.lPrintInFirstWholeBand
		
		
						CASE loObject.lPrintOnNewPage
					ENDCASE
		
				ENDIF
		
			ENDIF
		
		
			loObject.lDontPrint = (!EMPTY(loObject.cPrintWhen) AND !(EVAL(loObject.cPrintWhen))) OR !llPrintRepeats
			
		
			IF loObject.lCanBeRemoved
		
				llRemovingApprove = .T.
		
				IF !ISNULL(loObject.aBlankObjects[1])
		
					lnBlankObjects = ALEN(loObject.aBlankObjects, 1)
		
					FOR lnBlankObjectsCount = 1 TO lnBlankObjects
		
						loBlankObject = loObject.aBlankObjects[lnBlankObjectsCount]
		
						llPrintRepeats = loBlankObject.lPrintRepeats
		
						IF !llPrintRepeats
		
							DO CASE
								CASE !EMPTY(tnGroupNumber) AND !EMPTY(loBlankObject.nPrintOnGroupChange) AND tlNewGroup
									llPrintRepeats = IIF(loBlankObject.nPrintOnGroupChange = tnGroupNumber, .T., .F.)
		
								CASE loBlankObject.lPrintInFirstWholeBand
									llPrintRepeats = toBand.lPrintInFirstWholeBand
		
		
								CASE loBlankObject.lPrintOnNewPage
							ENDCASE
		
						ENDIF
		
						llDontPrint = (!EMPTY(loBlankObject.cPrintWhen) AND !(EVAL(loBlankObject.cPrintWhen))) OR !llPrintRepeats
		
						DO CASE
							CASE llDontPrint AND loBlankObject.lCanBeRemoved					 					
							
								llRemovingApprove = .T.
		
							CASE loBlankObject.lCanBeRemoved AND loBlankObject.nObjectType = cnREPOBJ_FIELD AND loBlankObject.nTotalType = cnTOTAL_NONE 					
		
								lcExpression = ALLT(loBlankObject.cExpression)
								luExpression = EVAL(lcExpression)
		
								IF TYPE('luExpression') = 'C' AND EMPTY(luExpression)
									llRemovingApprove = .T.
								ELSE
									llRemovingApprove = .F.
								ENDIF
		
							OTHERWISE
								llRemovingApprove = .F.
						ENDCASE
		
						IF !llRemovingApprove
							EXIT
						ENDIF
					NEXT
				ENDIF
		
				loObject.lRemoved = .F.
		
				IF llRemovingApprove
		
					DO CASE
						CASE loObject.lDontPrint
							loObject.lRemoved = .T.
		
						CASE loObject.nObjectType = cnREPOBJ_FIELD AND loObject.nTotalType = cnTOTAL_NONE
		
							lcExpression = ALLT(loObject.cExpression)
							luExpression = EVAL(lcExpression)
		
							IF TYPE('luExpression') = 'C' AND EMPTY(luExpression)
								loObject.lRemoved = .T.
							ENDIF
		
					ENDCASE
		
					lnMaxHeightDelta = lnMaxHeightDelta + IIF(loObject.lRemoved AND loObject.nReMoveDelta > 0 , loObject.nReMoveDelta, 0)			
		
		
					IF !ISNULL(loObject.aRemoveObjects[1]) AND loObject.nReMoveDelta > 0
		
						lnMoveTotal = ALEN(loObject.aRemoveObjects, 1)
		
						FOR lnMoveCount = 1 TO lnMoveTotal
		
							loMoveObject 			= loObject.aRemoveObjects[lnMoveCount]
		
							loMoveObject.nMoveDelta = loMoveObject.nMoveDelta + IIF(loObject.lRemoved , loObject.nReMoveDelta, 0)
		
						NEXT
					ENDIF
		
		
		
					IF !ISNULL(loObject.aUpRemoveObjects[1]) AND loObject.nReMoveDelta > 0
		
						lnMoveTotal = ALEN(loObject.aUpRemoveObjects, 1)
		
						FOR lnMoveCount = 1 TO lnMoveTotal
		
							loMoveObject 			= loObject.aUpRemoveObjects[lnMoveCount]
		
							loMoveObject.nSurBottomDelta = loMoveObject.nSurBottomDelta + loObject.nReMoveDelta
							
							IF loMoveObject.nFloat = cnPOSITION_BOTTOM
								loMoveObject.nMoveDelta = loMoveObject.nMoveDelta - IIF(loObject.lRemoved , loObject.nReMoveDelta, 0)					
							ENDIF
		
						NEXT
					ENDIF
		
				ENDIF
		
			ENDIF
		NEXT
		
		toBand.lPrintInFirstWholeBand = .F.
		
		RETURN lnMaxHeightDelta
		
		
		
	ENDPROC

	PROTECTED PROCEDURE resetvariables
		LPARAMETERS tn_MCh_ResetAt
		
		LOCAL ln_MCh_Variables
		LOCAL ln_MCh_Count
		LOCAL ln_MCh_ResetAt
		
		LOCAL lo_MCh_Variable
		
		LOCAL lc_MCh_VariableName
		LOCAL lc_MCh_InitValue
		
		LOCAL lu_MCh_InitValue				
		
		ln_MCh_ResetAt = tn_MCh_ResetAt
		
		WITH THIS
		
			IF !ISNULL(.aVariables)
		
				ln_MCh_Variables = ALEN(.aVariables, 1)
		
				FOR ln_MCh_Count = 1 TO ln_MCh_Variables
		
					lo_MCh_Variable = .aVariables[ln_MCh_Count]
		
					WITH lo_MCh_Variable
						IF .nResetAt = ln_MCh_ResetAt
		
							lc_MCh_VariableName  = .cName
						
							lc_MCh_InitValue     = ALLT(.uInitialValue)
							lu_MCh_InitValue     = EVAL(lc_MCh_InitValue)
		
							.nCalculatedValue    = lu_MCh_InitValue
						
							&lc_MCh_VariableName = .nCalculatedValue
							
		*-- For Average calculations					
							.nAverageValue		 = 0
							.nDivider		     = 1
							
						ENDIF
					ENDWITH
		
				NEXT ln_MCh_Count
		
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE save		&& Creates the report file
		LPARAMETERS tcReportFullName
		
		LOCAL loFile
		
		LOCAL laUsedTables[1]
		
		LOCAL lnReturn
		
		LOCAL lcExportFileExt
		LOCAL lcUserName
		LOCAL lcModuleID
		LOCAL lcProgram
		LOCAL lcEntry
		LOCAL lcBuffer
		LOCAL lcMessage
		
		WITH THIS
		
			IF .nExportFileType = cnCHART
		
				.CheckLicense()
		
				IF .nHandleExportFile < 0
					FCLOSE(.nHandleExportFile)
		
					lnReturn = cnERR_CREATING_FILE
					
				ELSE	
				
					lnReturn = cnOk			
					
				ENDIF
		
			ELSE
		
				DO CASE
					CASE .lFirstPass
		
		*-- Init DE
						lnReturn = .InitDataEnvironment(tcReportFullName)
		
					CASE VARTYPE(.oDataEnvironment) # 'O'
						lnReturn = .InitDataEnvironment(tcReportFullName)
		
					CASE AUSED(laUsedTables) <= 0
						lnReturn =  cnNO_OPEN_TABLE
		
					OTHERWISE
						lnReturn = cnOk
		
				ENDCASE
		
		*-- Use Current Alias
				IF lnReturn = cnOk
		
					IF .lFirstPass
		
		*-- Init Report Variables
						.InitReportVariables()
		
		*-- Reset all total value that should be reseted
						.ResetCalculations(cnRESET_ON_START_OF_REPORT)
		
					ELSE
		
						.CheckLicense(tcReportFullName)
		
						DO CASE
		
							CASE .nHandleExportFile < 0
								FCLOSE(.nHandleExportFile)
								lnReturn = cnERR_CREATING_FILE
		
							OTHERWISE
								=FSEEK(.nHandleExportFile, 0, 2)
		
		
		*-- Init Report Variables
								.InitReportVariables()
		
		
		*-- Reset all total value that should be reseted
								.ResetCalculations(cnRESET_ON_START_OF_REPORT)
		
						ENDCASE
		
						IF .nExportFileType = cnXML
						ELSE
						
		*-- Check Height of the PageHeader & Title
							IF .oPageHeaderBand.nHeight > .nPageHeight
								lnReturn = cnPAGEHEADER_BAND_IS_TOO_LARGE
							ENDIF
		
							IF VARTYPE(.oTitleBand) = 'O' AND !ISNULL(.oTitleBand) AND .oTitleBand.nHeight > .nPageHeight
								lnReturn = cnTITLE_BAND_IS_TOO_LARGE
							ENDIF
						ENDIF
		
		*-- Make first pass through the report in order to get total number of pages
						IF THIS.lPageTotalIsUsed
		
		
							IF  THIS.nExportFileType = cnHTML OR THIS.nExportFileType = cnPREVIEW
								loFile = CREATEOBJECT('HTMLFile')
							ELSE
								loFile = CREATEOBJECT('PDFFile')
							ENDIF
		
							IF TYPE('loFile') = 'O'
		
								loFile.lFirstPass         = .T.
								loFile.nScopeClauseType   = .nScopeClauseType
								loFile.nScopeRecords      = .nScopeRecords
								loFile.nScopeRecordNumber = .nScopeRecordNumber
								loFile.cFORExpression     = .cFORExpression
								loFile.cWHILEExpression   = .cWHILEExpression
								loFile.cHeadingText       = .cHeadingText
								loFile.lPlain   		  = .lPlain
								loFile.lSummary           = .lSummary
		
								loFile.SAVE(tcReportFullName)
		
								_PAGETOTAL = _PAGENO
		
		
								loFile.RELEASE()
								loFile = .NULL.
								
		
		*-- Init Report Variables
								.InitReportVariables()
		
		*-- Reset all total value that should be reseted
								.ResetCalculations(cnRESET_ON_START_OF_REPORT)
								
		
							ENDIF
						ENDIF
		
					ENDIF
		
				ENDIF
		
			ENDIF
		
		ENDWITH
		
		RETURN lnReturn
		
	ENDPROC

	PROCEDURE savepreview		&& Save Report Preview into file defined by .nTypeFile property
		LPARAMETERS toPrintPreviewReport, taPagesToPrint, tnCopies, tiCollate, tnWhatToPrint
		
		EXTERNAL ARRAY taPagesToPrint
		
		LOCAL laObjects[1, 2]
		
		LOCAL lcPreviewTable
		LOCAL lcTempCursor
		
		LOCAL lnPreviewPageNumber
		LOCAL lnPageNumber
		LOCAL lnPageCounter
		LOCAL lnReturn
		LOCAL lnTotalPagesToPrint
		LOCAL lnSelect
		
		LOCAL lnSelectedPageID
		LOCAL lnResult
		LOCAL lnObjWidthDelta
		LOCAL lnObjLeftDelta
		
		LOCAL lnArrayLen
		LOCAL lnArrayLenRowColumn
		
		LOCAL lnCurrentPage
		LOCAL lnPageAdjustment
		
		LOCAL lnCountCollateCopies
		LOCAL lnCount
		
		LOCAL llFirstPage
		LOCAL llPrintAllPages
		LOCAL lExcelPagePlacement
		
		lnPageCounter = 0
		
		WITH THIS
		
			IF !EMPTY(taPagesToPrint[1])
		
				IF .nExportFileType = cnEXCEL
		
					DO CASE
						CASE !INLIST(.nExcelOutPutType, cnEXCEL_OUTPUT_DRAFT, cnEXCEL_OUTPUT_FULL_PLAIN)
							.lMultiWorkSheet = .T.
		
						CASE INLIST(.nExcelOutPutType, cnEXCEL_OUTPUT_DRAFT)
							.lMultiWorkSheet = .F.
		
					ENDCASE
		
				ENDIF
		
				lcPagesToPrint = SYS(2015)
				lnSelect = SELECT()
		
				SELECT 0
				CREATE CURSOR &lcPagesToPrint (nPage N(5))
		
				IF taPagesToPrint[1] = -1
					FOR lnPageNumber =1 TO toPrintPreviewReport.nTotalReportPages
						INSERT INTO &lcPagesToPrint (nPage) VALUES (lnPageNumber)
					NEXT
				ELSE
					APPEND FROM ARRAY taPagesToPrint
				ENDIF
		
				SELECT (lnSelect)
		
				lnReturn = cnOk
		
				llFirstPage = .T.
				lExcelPagePlacement = .T.
				lnPageAdjustment = .nphysicalpaperlength - .nphysicalbottommargin  - .nphysicaltopmargin
		
				lnCurrentPage = 0
		
				lnTotalPagesToPrint = .GetTotalPagesToPrint(toPrintPreviewReport, @taPagesToPrint, tnCopies, tiCollate, tnWhatToPrint)
		
				IF VARTYPE(tnWhatToPrint) $ 'NFIBY' AND INLIST(tnWhatToPrint, 1, 2, 3)
					lnWhatToPrint = tnWhatToPrint
				ELSE
					lnWhatToPrint = 1
				ENDIF
		
				lnCopies = IIF(tnCopies < 1, 1, tnCopies)
		
				lnArrayLen = ALEN(taPagesToPrint, 1)
		
				IF lnArrayLen = 1 AND taPagesToPrint[1] = -1
					lnArrayLen      = toPrintPreviewReport.nTotalReportPages
					llPrintAllPages = .T.
				ELSE
					llPrintAllPages = .F.
				ENDIF
		
				IF tiCollate
					lnTotalCollateCopies    = lnCopies
					lnTotalNonCollateCopies = 1
				ELSE
					lnTotalCollateCopies    = 1
					lnTotalNonCollateCopies = lnCopies
				ENDIF
		
				lnPreviewPageNumber = 0
		
				.nPercentage = 1
		
				FOR lnCountCollateCopies = 1 TO lnTotalCollateCopies
		
					FOR lnCount = 1 TO lnArrayLen
		
						lnPageNumber = IIF(llPrintAllPages, lnCount, taPagesToPrint[lnCount])
		
						IF lnPageNumber > 0 AND lnPageNumber <= toPrintPreviewReport.nTotalReportPages
		
							DO CASE
								CASE lnWhatToPrint = 2
									llPrintPage = IIF(MOD(lnPageNumber,2) > 0 , .T., .F.)
								CASE lnWhatToPrint = 3
									llPrintPage = IIF(MOD(lnPageNumber,2) > 0 , .F., .T.)
								OTHERWISE
									llPrintPage = .T.
							ENDCASE
		
							IF llPrintPage
		
								lcTempCursor = SYS(2015)
								lcPreviewTable = toPrintPreviewReport.cPreviewTable
		
								lnSelect = SELECT()
		
								SELECT 0
								SELECT * FROM &lcPreviewTable WHERE nPage = lnPageNumber AND !lDeleted INTO CURSOR &lcTempCursor
		
								IF _TALLY > 0
		
									FOR lnCountNonCollateCopies = 1 TO lnTotalNonCollateCopies
		
										DO CASE
											CASE .nExportFileType = cnHTML
												IF !llFirstPage
		
													lnPageCounter=lnPageCounter+1
		
													.newpage(lnPageCounter)
		
												ELSE
													llFirstPage = .F.
													lnPageCounter=1
		
												ENDIF
											CASE .nExportFileType = cnPDF
		
												IF !llFirstPage
													lnSelectedPageID = iSEDNewPage()
		
													lnResult = iSEDSelectPage(lnSelectedPageID)
		
													lnResult = iSEDNewLayer()
		
		
												ELSE
													llFirstPage = .F.
												ENDIF
											CASE .nExportFileType = cnWORD
												IF !llFirstPage
													.oWordDoc.Sections.ADD
												ELSE
													llFirstPage = .F.
												ENDIF
		
											CASE .nExportFileType = cnRTF
												IF .nRTFOutPutType = cnRTF_OUTPUT_PLAIN
													lnPageCounter = lnPageCounter + 1
		
													.CREATECURSOR()
		
		
													.newpage(lnPageCounter)
		
													.nPrgBottom = 0
		
		
												ELSE
													IF !llFirstPage
														lnPageCounter = lnPageCounter+1
		
														.newpage(lnPageCounter)
													ELSE
														lnPageCounter = 1
														llFirstPage   = .F.
													ENDIF
		
												ENDIF
											CASE .nExportFileType = cnEXCEL
												DO CASE
													CASE .nExcelOutPutType = cnEXCEL_OUTPUT_DRAFT
													CASE .nExcelOutPutType = cnEXCEL_OUTPUT_FULL_PLAIN
		
														IF !llFirstPage AND .lMultiWorkSheet
		
															.oActiveExcelSheet = .oExcelWorkBook.Sheets.ADD(,.oExcelWorkBook.Sheets(.oExcelWorkBook.Sheets.COUNT))
		
															lnCurrentPage = .oExcelWorkBook.Sheets.COUNT
		
															.oActiveExcelSheet.NAME = 'Page ' + ALLTRIM(STR(lnCurrentPage))
		
		
															.SetExcelSheetPageSetup(.oActiveExcelSheet)
		
														ELSE
															llFirstPage = .F.
		
															lnCurrentPage = lnCurrentPage + 1
		
														ENDIF
		
		
														IF lExcelPagePlacement
															lnRowHeight = .oActiveExcelSheet.RANGE('A1').HEIGHT
														ENDIF
		
														IF .lMultiWorkSheet OR lExcelPagePlacement
		
															DIMENSION .anColumn[1]
															.anColumn[1] = .F.
														ENDIF
		
														DIMENSION .anRow[1]
														.anRow[1] = .F.
		
		
														IF .lMultiWorkSheet
		
															SELECT DISTINCT ROUND(nLeft * cnPOINTS_PER_PIXELS - THIS.nLeftMargin,5) FROM (lcTempCursor) ;
																UNION;
																SELECT DISTINCT ROUND(nLeft * cnPOINTS_PER_PIXELS- THIS.nLeftMargin,5) + ROUND(nWidth * cnPOINTS_PER_PIXELS,5) FROM (lcTempCursor) ;
																ORDER BY 1;
																INTO ARRAY THIS.anColumn
		
		
															SELECT DISTINCT ROUND(nTop * cnPOINTS_PER_PIXELS - THIS.nTopMargin,5) FROM (lcTempCursor) ;
																WHERE nObjectType = cnREPOBJ_FIELD OR nObjectType = cnREPOBJ_TEXT ;
																UNION;
																SELECT DISTINCT ROUND(nTop * cnPOINTS_PER_PIXELS - THIS.nTopMargin,5)+ ROUND(nHeight * cnPOINTS_PER_PIXELS,5) FROM (lcTempCursor) ;
																WHERE nObjectType = cnREPOBJ_FIELD OR nObjectType = cnREPOBJ_TEXT ;
																ORDER BY 1;
																INTO ARRAY lanRow
		
														ELSE
		
															IF lExcelPagePlacement
		
																SELECT DISTINCT ROUND(nLeft * cnPOINTS_PER_PIXELS - THIS.nLeftMargin,5) FROM &lcPreviewTable ;
																	WHERE nPage IN (SELECT * FROM &lcPagesToPrint)  AND !lDeleted ;
																	UNION;
																	SELECT DISTINCT ROUND(nLeft * cnPOINTS_PER_PIXELS- THIS.nLeftMargin,5) + ROUND(nWidth * cnPOINTS_PER_PIXELS,5) FROM &lcPreviewTable  ;
																	WHERE nPage IN (SELECT * FROM &lcPagesToPrint) AND !lDeleted ;
																	ORDER BY 1;
																	INTO ARRAY THIS.anColumn
		
		
															ENDIF
		
															SELECT DISTINCT ROUND(nTop * cnPOINTS_PER_PIXELS - THIS.nTopMargin ,5) FROM (lcTempCursor) ;
																WHERE nObjectType = cnREPOBJ_FIELD OR nObjectType = cnREPOBJ_TEXT ;
																UNION;
																SELECT DISTINCT ROUND(nTop * cnPOINTS_PER_PIXELS - THIS.nTopMargin,5)+ ROUND(nHeight * cnPOINTS_PER_PIXELS,5) FROM (lcTempCursor) ;
																WHERE nObjectType = cnREPOBJ_FIELD OR nObjectType = cnREPOBJ_TEXT ;
																ORDER BY 1;
																INTO ARRAY lanRow
		
		
															IF VARTYPE(lanRow[1]) = 'N'
																DIMENSION lanRow[ALEN(lanRow) + 1]
															ENDIF
		
															lanRow[ALEN(lanRow)] = lnPageAdjustment
		
														ENDIF
		
														lnArrayLenRowColumn = ALEN(lanRow)
		
														IF VARTYPE(lanRow[1]) = 'N'
		
															FOR lnCountArray = 1 TO  lnArrayLenRowColumn
		
																lnCellHeight = lanRow[lnCountArray] - IIF(lnCountArray = 1, 0, lanRow[lnCountArray - 1])
		
																IF lnCellHeight > lnRowHeight
		
																	lnNewCells = INT(lnCellHeight/lnRowHeight)
		
																	lnRowHeightTotal = IIF(lnCountArray = 1, 0, lanRow[lnCountArray - 1])
		
																	FOR lnCountNewCells = 1 TO lnNewCells
		
																		IF VARTYPE(.anRow[1]) = 'N'
																			DIMENSION .anRow[ALEN(.anRow) + 1]
																		ENDIF
		
																		.anRow[ALEN(.anRow)] = ROUND(lnRowHeight + lnRowHeightTotal,5)
		
																		lnRowHeightTotal = lnRowHeightTotal + lnRowHeight
		
																	NEXT
		
																	lnCellHeight = MOD(lnCellHeight, lnRowHeight)
		
																	IF lnCellHeight > 0
		
																		IF VARTYPE(.anRow[1]) = 'N'
																			DIMENSION .anRow[ALEN(.anRow) + 1]
																		ENDIF
		
																		.anRow[ALEN(.anRow)] = ROUND(lnCellHeight + lnRowHeightTotal,5)
		
																	ENDIF
		
																ELSE
		
																	IF VARTYPE(.anRow[1]) = 'N'
																		DIMENSION .anRow[ALEN(.anRow) + 1]
																	ENDIF
		
																	.anRow[ALEN(.anRow)] = lanRow[lnCountArray]
		
																ENDIF
		
															ENDFOR
		
														ENDIF
		
														.oActiveExcelSheet.SELECT
		
														lnArrayLenRowColumn = ALEN(.anColumn)
		
														IF VARTYPE(.anColumn[1]) = 'N'
															IF lExcelPagePlacement OR .lMultiWorkSheet
		
																FOR lnCountArray = 1 TO  lnArrayLenRowColumn
		
																	lcColumnName = .GetColumnName(lnCountArray)
		
																	loCell = .oActiveExcelSheet.RANGE(lcColumnName + '1')
		
																	lnCellWidth = .anColumn[lnCountArray] - IIF(lnCountArray = 1, 0, .anColumn[lnCountArray - 1])
		
																	.AdjustWidth(loCell, lnCellWidth)
		
																ENDFOR
															ENDIF
		
														ENDIF
		
														lnArrayLenRowColumn = ALEN(.anRow)
		
														IF VARTYPE(.anRow[1]) = 'N'
		
															FOR lnCountArray = 1 TO  lnArrayLenRowColumn
		
																lnCellHeight = .anRow[lnCountArray] - IIF(lnCountArray = 1, 0, .anRow[lnCountArray - 1])
		
		
																IF .lMultiWorkSheet
																	.oActiveExcelSheet.RANGE('A' + ALLTRIM(STR(lnCountArray))).ROWHEIGHT = lnCellHeight
																ELSE
																	.nCurrentRow = .nCurrentRow + 1
																	.oActiveExcelSheet.RANGE('A' + ALLTRIM(STR(.nCurrentRow))).ROWHEIGHT = lnCellHeight
																ENDIF
		
															ENDFOR
		
														ENDIF
		
														lExcelPagePlacement = .F.
		
												ENDCASE
		
											CASE .nExportFileType = cnIMAGE
												lnPageCounter = lnPageCounter + 1
		
												.nEndPage = lnPageCounter
		
												.newpage(lnPageCounter)
		
										ENDCASE
		
										lnPreviewPageNumber = lnPreviewPageNumber + 1
		
										IF tiCollate
											lnPageSequence = lnCount + (lnCountCollateCopies - 1) * lnArrayLen
										ELSE
											lnPageSequence = lnCount + (lnCountNonCollateCopies - 1) + (lnCount - 1) * (lnTotalNonCollateCopies -1)
										ENDIF
		
		
										GO TOP IN (lcTempCursor)
		
										DO WHILE !EOF(lcTempCursor)
		
											SELECT &lcTempCursor
		
											SCATTER MEMO NAME loObject
		
											IF .nExportFileType = cnEXCEL
												DO CASE
													CASE .nExcelOutPutType = cnEXCEL_OUTPUT_DRAFT
														.InsertDraftPreviewObject(loObject, lcTempCursor, lnPageSequence)
		
													OTHERWISE
		
														.InsertPreviewObject(loObject, lnCurrentPage-1)
		
												ENDCASE
											ELSE
												.InsertPreviewObject(loObject, lnPageSequence, lnPreviewPageNumber)
											ENDIF
		
		
											SKIP IN (lcTempCursor)
		
										ENDDO
		
										DO CASE
											CASE .nExportFileType = cnRTF AND .nRTFOutPutType = cnRTF_OUTPUT_PLAIN
		
												lcPageCursor = SYS(2015)
		
												SELECT * FROM (.cRTFTable) ORDER BY nTop, nLeft INTO CURSOR &lcPageCursor
		
												.PrintRTFPlainPage(lcPageCursor)
		
												IF USED(.cRTFTable)
													USE IN (.cRTFTable)
												ENDIF
		
												IF USED(lcPageCursor)
													USE IN (lcPageCursor)
												ENDIF
		
											OTHERWISE
		
										ENDCASE
		
										.nPercentage = 	ROUND((lnPreviewPageNumber/lnTotalPagesToPrint)*100, 2)
		
									ENDFOR
		
								ENDIF
		
								USE IN (lcTempCursor)
		
								SELECT (lnSelect)
		
							ENDIF
		
						ENDIF
					ENDFOR
				ENDFOR
		
				.nPercentage = 100
		
				USE IN (lcPagesToPrint)
		
			ENDIF
		
		ENDWITH
		
		RETURN lnReturn
		
		
		
	ENDPROC

	PROCEDURE showoutput		&& Display Output file
	ENDPROC

	PROCEDURE splitcolortorgb
		LPARAMETERS tnForeColor, tnRed, tnGreen, tnBlue, tlNotDivided
		
		tnRed       = BITAND(tnForeColor, 255)
		tnGreen     = BITRSHIFT(BITAND(tnForeColor, 256^2 - 1), 8)
		tnBlue      = BITRSHIFT(BITAND(tnForeColor, 256^3 - 1), 16)
		
		IF !tlNotDivided
		*-- Special case only for PDF module
			tnRed       = tnRed/255
			tnGreen     = tnGreen/255
			tnBlue      = tnBlue/255
		ENDIF
		
	ENDPROC

	PROCEDURE splitoverobject
		LPARAMETERS toBand, toObject, tnNewHeight, tnStringHeight
		
		LOCAL lnPosObjBottom
		LOCAL lnNewHeight
		LOCAL lnAT
		
		WITH toObject
		
			.nStretchedHeight = tnNewHeight
			.nNewHeight       = tnNewHeight
		
			lnPosObjBottom    = .nStretchedHeight + .nVPosition + .nSurDelta - .nMoveDelta
		
			IF THIS.nHeight + lnPosObjBottom > THIS.nPageHeight
		
				lnNewHeight = THIS.AddOverObject(toBand, toObject, .nHeight, lnPosObjBottom, tnStringHeight)
		
				.nStretchedHeight = lnNewHeight
		
			ENDIF
		
			lnAT = AT(IIF(INLIST(THIS.nExportFileType, cnPREVIEW, cnEXCEL, cnPDF), ccLF, ccCR), .cLinePerObject, IIF(lnNewHeight < tnStringHeight, 1, INT(lnNewHeight / tnStringHeight))) - 1
		
			IF lnAT > 0
				.cLinePerObject = SUBSTR(.cLinePerObject, 1, lnAT)
			ENDIF
		
		ENDWITH
		
		RETURN lnNewHeight
		
	ENDPROC

	PROCEDURE unlock
		LPARAMETERS tcLicenseKey
		
		WITH THIS
			.cLicenseKey = tcLicenseKey
		ENDWITH
		
	ENDPROC

