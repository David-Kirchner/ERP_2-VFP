	PROCEDURE ncharset_assign
		LPARAMETERS tnCharSet
		
		IF VARTYPE(tnCharSet) $ 'NFIBY' AND INLIST(tnCharSet, cnPDF_CHARSET_ANSI,;
				cnPDF_CHARSET_DEFAULT,;
				cnPDF_CHARSET_SYMBOL,;
				cnPDF_CHARSET_SHIFTJIS,;
				cnPDF_CHARSET_HUNGEUL,;
				cnPDF_CHARSET_GB2312,;
				cnPDF_CHARSET_CHINESEBIG5,;
				cnPDF_CHARSET_OEM,;
				cnPDF_CHARSET_JOHAB,;
				cnPDF_CHARSET_HEBREW,;
				cnPDF_CHARSET_ARABIC,;
				cnPDF_CHARSET_GREEK,;
				cnPDF_CHARSET_TURKISH,;
				cnPDF_CHARSET_VIETNAMESE,;
				cnPDF_CHARSET_THAI,;
				cnPDF_CHARSET_EASTEUROPE,;
				cnPDF_CHARSET_RUSSIAN,;
				cnPDF_CHARSET_MAC,;
				cnPDF_CHARSET_BALTIC)
			THIS.nCharSet = tnCharSet
		ELSE
			THIS.nCharSet = 0
		ENDIF
		
	ENDPROC

	PROCEDURE newpage
		LPARAMETERS tnPage
		
		LOCAL lnPage
		LOCAL lnResult
		LOCAL lnTotalPages
		LOCAL lnLayer
		
		WITH THIS
		
			IF !EMPTY(tnPage) AND (VARTYPE(tnPage) = 'N')
				lnPage = tnPage
			ELSE
				lnPage = .nPage
			ENDIF
		
			lnTotalPages = iSEDPageCount()
		
			IF lnTotalPages < lnPage
		
				.nSelectedPageID = iSEDNewPage()
		
				lnResult = iSEDSelectPage(.nSelectedPageID)
		
				IF .lPrintableArea
		*-- Use only printable page dimension
					lnResult = iSEDSetPageDimensions(.nPhysicalPaperWidthWithOutMargin, .nPhysicalPaperLengthWithOutMargin)	
				ELSE
					lnResult = iSEDSetPageDimensions(.nPhysicalPaperWidth, .nPhysicalPaperLength)			
				ENDIF	
		
		*--Add second layer
				lnLayer = iSEDNewLayer()
			ENDIF
		
		ENDWITH
		
		RETURN lnResult
		
		
	ENDPROC

	PROCEDURE opendocument
		LOCAL lnReturn
		
		WITH THIS
		
		lnReturn = DODEFAULT()
		
		IF lnReturn # cnOk OR !.CreatePDFFile()
		
			FCLOSE(.nHandleExportFile)
		
			lnReturn = cnCANNOT_INSTANCE_PDF_FILE
		ELSE
			lnReturn = cnOk
		
		ENDIF
		
		ENDWITH
		
		
		RETURN lnReturn
		
		
	ENDPROC

	PROCEDURE pagesettings
		LPARAMETERS toReportRecord
		
		DODEFAULT(toReportRecord)
		
		
	ENDPROC

	PROCEDURE populatereportcontent
		LOCAL lcFieldAlias
		LOCAL lcButtonsCaption
		LOCAL lcFolderKey
		LOCAL lcFolderName 
		LOCAL lcReportContentTable
		
		LOCAL lnArrayLen
		LOCAL lnCount
		LOCAL lnSelect
		
		LOCAL lnResult
		LOCAL lnFolderID
		
		lcFieldAlias = SYS(2015)
		
		
		IF !EMPTY(THIS.aContentsField[1])
		
			lnSelect   = SELECT()
		
			lnArrayLen = ALEN(THIS.aContentsField, 1)
		
			lnArrayLen = IIF(lnArrayLen > 8, 8, lnArrayLen)	
			
			lcReportContentTable = THIS.cReportContentTable
			
			FOR lnCount = 1 TO lnArrayLen
		
				
				lcFolderKey  = THIS.aContentsField[lnCount,1]				
				lcFolderName = THIS.aContentsField[lnCount,2]	
		
		*-- Have to add "Folder"
				lnFolderID = iSEDNewOutline(0, lcFolderName, 1, 0)  
		
				IF lnFolderID > 0
		
		*-- Delaem viborku vseh znachniy dannogo FIELD iz resul'tiruuhey tablicy dannogo reporta
		
					SELECT THIS.ProcessField(mSource) AS mSource, nPage, nTop FROM (lcReportContentTable) ;
					WHERE cReportObjectName = lcFolderKey ;
					ORDER BY 1;
					INTO CURSOR &lcFieldAlias
		
					GO TOP IN &lcFieldAlias
		
					DO WHILE !EOF(lcFieldAlias)
		
						lcButtonsCaption = RTRIM(&lcFieldAlias..mSource)
		
		*-- Add "Buttons" into "Folder" 
						lnResult = iSEDNewOutline(lnFolderID, lcButtonsCaption, &lcFieldAlias..nPage, &lcFieldAlias..nTop)  
		
						SKIP IN  (lcFieldAlias)
					ENDDO
		
					USE IN (lcFieldAlias)
		
				ENDIF
		
			ENDFOR
		
			SELECT (lnSelect)
		
		ENDIF
		
		
	ENDPROC

	PROCEDURE printoutput
		LOCAL lcExportFile
		
		DECLARE INTEGER ShellExecute IN SHELL32.DLL INTEGER nWinHandle, STRING cOperation, STRING cFileName, STRING cParameters,;
			STRING cDirectory, INTEGER nShowWindow
		
		lcExportFile = FORCEEXT(THIS.cSaveFolder + THIS.cExportFileName, ccPDF_EXT)
		
		ShellExecute(0, 'Print', lcExportFile, '', '', 1)
		
	ENDPROC

	PROCEDURE processfield
		LPARAMETERS tcSource
		
		LOCAL lcSource
		
		lcSource = PADR(SUBSTR(tcSource, 1, 254), 254)
		
		lcSource = STRTRAN(lcSource, ccCR + ccLF, ' ')
		lcSource = STRTRAN(lcSource, ccCR, ' ')
		lcSource = STRTRAN(lcSource, ccLF, ' ')
		
		RETURN lcSource
		
	ENDPROC

	PROCEDURE save
		LPARAMETERS tcReportFullName
		
		LOCAL loGroupBandHeader
		LOCAL loGroupBandFooter
		LOCAL loObject
		
		LOCAL lcPreviewFile
		LOCAL lcPDFFile
		
		LOCAL lnCount
		LOCAL lnGroups
		LOCAL lnStartGroupNumber
		LOCAL lnCurGroupNumber
		LOCAL lnTotalRow
		LOCAL lnCountRow
		LOCAL lnCountUpLevel
		LOCAL lnReturn
		LOCAL lnLenOfPage
		LOCAL lnArrayLen
		LOCAL lnCountProcessedRecords
		LOCAL lnStartRecord
		LOCAL lnCurrentRecord
		LOCAL lnCountSkip
		LOCAL lnDefaultPage
		LOCAL lnCurrentHeight
		LOCAL lnCountColumn
		LOCAL lnPercentProcessedRecords
		
		LOCAL llInsertTitleAndPageHeaderBands
		LOCAL llFORPrintRecord
		LOCAL llWHILEPrintRecord
		LOCAL llNewGroup
		LOCAL llNewSubGroup
		LOCAL llScipStreatcing
		LOCAL llExistFileCfg
		
		LOCAL luCurrentGroupVal
		LOCAL luNextGroupVal
		LOCAL luCurrentGroupUpLevelVal
		LOCAL luNextGroupUpLevelVal
		
		WITH THIS
		
			lnReturn = DODEFAULT(tcReportFullName)
		
			IF lnReturn = cnOk
		
				IF !.lFirstPass AND !.CreatePDFFile()
		
					FCLOSE(.nHandleExportFile)
		
					lnReturn = cnCANNOT_INSTANCE_PDF_FILE
				ELSE
		
					DO CASE
						CASE EOF() AND BOF()
							lnPercentCurrentRecord = -1
						CASE EOF()
							lnPercentCurrentRecord = -1
						CASE BOF()
							GO TOP
							lnPercentCurrentRecord = RECNO()
						OTHERWISE
							lnPercentCurrentRecord = RECNO()
					ENDCASE
		
					lnPercentTotalRecords = RECCOUNT()
		
					IF  lnPercentCurrentRecord > 0
						GOTO lnPercentCurrentRecord
					ENDIF
		
					lnPercentProcessedRecords = 0
		
					.nPage   = 1
					.nHeight = .nTopMargin - .nPhysicalPaperTopMargin
					.nHeight = IIF(.nHeight < 0, 0, .nHeight)
		
					DO CASE
						CASE .nScopeClauseType = cnSCOPE_CLAUSE_RECORD
		
							DO CASE
								CASE EOF() AND BOF()
									lnCurrentRecord = -1
								CASE EOF()
									lnCurrentRecord = -1
								CASE BOF()
									GO TOP
									lnCurrentRecord = RECNO()
								OTHERWISE
									lnCurrentRecord = RECNO()
							ENDCASE
		
							LOCATE FOR  RECNO() = .nScopeRecordNumber
		
							IF !EOF()
								lnCurrentRecord = RECNO()
							ENDIF
		
						CASE .nScopeClauseType = cnSCOPE_CLAUSE_NEXT
						CASE .nScopeClauseType = cnSCOPE_CLAUSE_REST
						OTHERWISE
							GO TOP
					ENDCASE
		
					DO CASE
						CASE EOF() AND BOF()
							lnStartRecord = -1
						CASE EOF()
							lnStartRecord = -1
						CASE BOF()
							GO TOP
							lnStartRecord = RECNO()
						OTHERWISE
							lnStartRecord = RECNO()
					ENDCASE
		
					DO CASE
						CASE lnStartRecord < 0
						CASE .nScopeClauseType = cnSCOPE_CLAUSE_NEXT AND .nScopeRecords <= 0
						OTHERWISE
		
							lnCountProcessedRecords         = 1
							lnCountSkip                     = 1
							lnStartGroupNumber 				= 1
							lnGroups           				= IIF(ISNULL(.aGroupBands[1, 1]), 0, ALEN(.aGroupBands, 1))
		
							llInsertTitleAndPageHeaderBands = .T.
							llNewGroup 	  	   				= .T.
		
							DO WHILE !EOF();
									AND IIF(.nScopeClauseType = cnSCOPE_CLAUSE_NEXT, lnCountProcessedRecords <= .nScopeRecords, .T.);
									AND IIF(.nScopeClauseType = cnSCOPE_CLAUSE_RECORD, lnCountProcessedRecords = 1, .T.)
		
		
								lnPercentProcessedRecords = lnPercentProcessedRecords + 1
		
								.nPercentage = 	ROUND((lnPercentProcessedRecords/lnPercentTotalRecords)*100, 2)
		
								.ClearError()
		
		
								llWHILEPrintRecord = IIF(EMPTY(.cWHILEExpression), .T., EVALUATE(.cWHILEExpression))
								llWHILEPrintRecord = IIF(TYPE('llWHILEPrintRecord') = 'L', llWHILEPrintRecord, .F.)
		
								IF !llWHILEPrintRecord OR .lHadError
									EXIT
								ENDIF
		
								.ClearError()
		
								llFORPrintRecord   = IIF(EMPTY(.cFORExpression), .T., EVALUATE(.cFORExpression))
								llFORPrintRecord   = IIF(TYPE('llFORPrintRecord') = 'L', llFORPrintRecord, .F.)
		
								IF !llFORPrintRecord OR .lHadError
									SKIP
									lnCountProcessedRecords = lnCountProcessedRecords + 1
		
									LOOP
								ENDIF
		
								IF llInsertTitleAndPageHeaderBands
		
									.InsertBand(.oTitleBand)
									.InsertBand(.oPageHeaderBand)
		
		
									IF .nPrintOrder = 1
		
										lnCurrentHeight = .nHeight
		
										FOR lnCountColumn = 1 TO .nColumns
		
											.nHeight = lnCurrentHeight
		
											.nColumnLeftDelta = (.nColumnWidth + .nColumnSpacing) * (lnCountColumn - 1)
		
											.InsertBand(.oColumnHeaderBand)
		
										NEXT
									ELSE
										.InsertBand(.oColumnHeaderBand)
									ENDIF
		
									llInsertTitleAndPageHeaderBands = .F.
								ENDIF
		
								IF llNewGroup AND lnGroups > 0
		
									FOR lnCount = lnStartGroupNumber TO lnGroups
										loGroupBandHeader = .aGroupBands[lnCount, 1]
		
										.InsertBand(loGroupBandHeader, lnCount, lnCountSkip, llNewGroup)
		
										.aGroupBands[lnCount, 3] = EVAL(loGroupBandHeader.cExpression)
		
										loGroupBandHeader.lFirstOutPutWasDone = .T.
		
										lnCurGroupNumber = lnCount
		
									NEXT lnCount
								ENDIF
		
		
								.InsertBand(.oDetailBand,lnCurGroupNumber, lnCountSkip, llNewGroup)
		
								SKIP
								lnCountProcessedRecords = lnCountProcessedRecords + 1
								lnCountSkip 			= 1
		
								.ClearError()
		
								llWHILEPrintRecord = IIF(EMPTY(.cWHILEExpression), .T., EVALUATE(.cWHILEExpression))
								llWHILEPrintRecord = IIF(TYPE('llWHILEPrintRecord') = 'L', llWHILEPrintRecord, .F.)
		
								IF !llWHILEPrintRecord OR .lHadError
								ELSE
									llFORPrintRecord = IIF(EMPTY(.cFORExpression), .T., EVALUATE(.cFORExpression))
									llFORPrintRecord = IIF(TYPE('llFORPrintRecord') = 'L', llFORPrintRecord, .F.)
		
									DO WHILE (!llFORPrintRecord  OR .lHadError) AND !EOF()
		
										SKIP
										lnCountProcessedRecords = lnCountProcessedRecords + 1
										lnCountSkip 			= lnCountSkip + 1
		
										llWHILEPrintRecord = IIF(EMPTY(.cWHILEExpression), .T., EVALUATE(.cWHILEExpression))
										llWHILEPrintRecord = IIF(TYPE('llWHILEPrintRecord') = 'L', llWHILEPrintRecord, .F.)
										IF !llWHILEPrintRecord OR .lHadError
											EXIT
										ELSE
											llFORPrintRecord = EVALUATE(.cFORExpression)
											llFORPrintRecord = IIF(TYPE('llFORPrintRecord') = 'L', llFORPrintRecord, .F.)
											LOOP
										ENDIF
									ENDDO
								ENDIF
		
								.llEOF = EOF();
									OR IIF(.nScopeClauseType = cnSCOPE_CLAUSE_NEXT, lnCountProcessedRecords > .nScopeRecords, .F.);
									OR IIF(.nScopeClauseType = cnSCOPE_CLAUSE_RECORD, lnCountProcessedRecords > 1, .F.);
									OR !llWHILEPrintRecord
		
								IF lnGroups > 0
		
									lnStartGroupNumber = lnCurGroupNumber
									llNewGroup         = .F.
		
									FOR lnCount = lnCurGroupNumber TO 1 STEP -1
		
										llNewSubGroup      = .F.
										loGroupBandFooter  = .aGroupBands[lnCount, 2]
										luCurrentGroupVal  = .aGroupBands[lnCount, 3]
										luNextGroupVal     = EVAL(.aGroupBands[lnCount, 1].cExpression)
		
										IF (VARTYPE(luNextGroupVal) = VARTYPE(luCurrentGroupVal)) OR .llEOF
		
											DO CASE
												CASE luNextGroupVal # luCurrentGroupVal
													llNewSubGroup = .T.
												CASE .llEOF
													llNewSubGroup = .T.
												OTHERWISE
		
													FOR lnCountUpLevel = lnCount - 1 TO 1 STEP -1
		
														luNextGroupUpLevelVal     = .aGroupBands[lnCountUpLevel, 3]
														luCurrentGroupUpLevelVal  = EVAL(.aGroupBands[lnCountUpLevel, 1].cExpression)
		
														IF VARTYPE(luNextGroupUpLevelVal) = VARTYPE(luCurrentGroupUpLevelVal)
															IF luNextGroupUpLevelVal # luCurrentGroupUpLevelVal
																llNewSubGroup = .T.
															ENDIF
														ELSE
															llNewSubGroup = .T.
														ENDIF
		
														IF llNewSubGroup
															EXIT
														ENDIF
													NEXT
											ENDCASE
										ELSE
											llNewSubGroup = .T.
										ENDIF
		
										IF llNewSubGroup
		
											SKIP -lnCountSkip
		
											.InsertBand(loGroupBandFooter, lnCount, , llNewSubGroup)
		
											SKIP lnCountSkip
		
											llNewGroup = .T.
		
											.aGroupBands[lnStartGroupNumber, 1].lFirstOutPutWasDone = .F.
		
											IF .aGroupBands[lnStartGroupNumber, 1].lStartOnNewPage
		
												.aGroupBands[lnCount, 1].lStartOnNewPage     = .T.
												.aGroupBands[lnCount, 1].lFirstOutPutWasDone = .T.
											ENDIF
		
		
											IF .aGroupBands[lnStartGroupNumber, 1].lStartInNewColumn
												.aGroupBands[lnCount, 1].lFirstOutPutWasDone = .T.
											ENDIF
		
		
											lnStartGroupNumber = lnCount
		
										ENDIF
		
									NEXT lnCount
		
								ENDIF
		
							ENDDO
		
		
							.nPercentage = 	100
		
		
							IF !llInsertTitleAndPageHeaderBands
		
								SKIP -lnCountSkip
		
								IF !ISNULL(.oSummaryBand)
		
									.InsertBand(.oSummaryBand)
		
									lnLenOfPage = IIF(.oSummaryBand.lStartOnNewPage, 0, THIS.nHeight - .oSummaryBand.nHeight - IIF(THIS.lWholePage, 0, THIS.nPhysicalPaperTopMargin))
		
									llScipStreatcing  = .T.
									IF TYPE('THIS.aMultyBandObject[1, 1]') = 'O'
										lnTotalRow = ALEN(THIS.aMultyBandObject, 1)
		
										FOR lnCountRow = 1 TO lnTotalRow
		
											loObject = THIS.aMultyBandObject[lnCountRow, 1]
		
											IF loObject.nMltBandObjType = cnFROM_TITLE_BAND_TO_ANY_BAND_RSZ
		
												loObject.nHeight     = loObject.nMltBandObjSuffixHeight + lnLenOfPage
												loObject.nVPosition  = IIF(.nPage > 1, 0, loObject.nVPosition)
												loObject.nMoveDelta  = IIF(.nPage > 1, 0, loObject.nMoveDelta)
		
		
												IF .oSummaryBand.lStartOnNewPage
													.InsertObject(loObject, .oSummaryBand,	llScipStreatcing)
												ENDIF
		
		
											ENDIF
										NEXT
									ENDIF
		
		
									DO CASE
										CASE !.oSummaryBand.lStartOnNewPage
		
											IF .nPrintOrder = 1
		
												lnCurrentHeight = .nHeight
		
												FOR lnCountColumn = 1 TO .nColumns
		
													.nHeight = lnCurrentHeight
		
													.nColumnLeftDelta = (.nColumnWidth + .nColumnSpacing) * (lnCountColumn - 1)
		
													.InsertBand(.oColumnFooterBand)
		
												NEXT
											ELSE
												.InsertBand(.oColumnFooterBand)
											ENDIF
		
											.nColumnLeftDelta = 0
		
											.oPageFooterBand.lLastBand = .T.
		
											.InsertBand(.oPageFooterBand)
		
		
										CASE .nVFPVersion >= 8 AND .oSummaryBand.lStartOnNewPage AND .oSummaryBand.lPrintPageFooter
		
											.nColumnLeftDelta          = 0
											.oPageFooterBand.lLastBand = .T.
		
											.InsertBand(.oPageFooterBand)
		
									ENDCASE
		
								ELSE
		
									IF .nPrintOrder = 1
		
										lnCurrentHeight = .nHeight
		
										FOR lnCountColumn = 1 TO .nColumns
		
											.nHeight = lnCurrentHeight
		
											.nColumnLeftDelta = (.nColumnWidth + .nColumnSpacing) * (lnCountColumn - 1)
		
											.InsertBand(.oColumnFooterBand)
		
										NEXT
									ELSE
										.InsertBand(.oColumnFooterBand)
									ENDIF
		
									.nColumnLeftDelta = 0
		
									.oPageFooterBand.lLastBand = .T.
		
									.InsertBand(.oPageFooterBand)
								ENDIF
		
							ENDIF
					ENDCASE
		
					IF !.lFirstPass
						THIS.DemoStamp()
					ENDIF
		
					lnResult = .CloseDocument()
		
					IF !.lFirstPass
		
						IF (lnResult # 1)
							lnReturn = cnCANNOT_INSTANCE_PDF_FILE
						ELSE
							.OutPutTo()
						ENDIF
		
					ENDIF
		
					DO CASE
						CASE .nScopeClauseType = cnSCOPE_CLAUSE_RECORD
							IF  lnCurrentRecord > 0
								GOTO lnCurrentRecord
							ENDIF
						OTHERWISE
							IF lnStartRecord > 0
								GOTO lnStartRecord
							ENDIF
					ENDCASE
		
		
				ENDIF
		
			ENDIF
		
		ENDWITH
		
		RETURN lnReturn
		
		
		
	ENDPROC

	PROCEDURE savepreview
		LPARAMETERS toPrintPreviewForm, taPagesToPrint, tnCopies, tiCollate, tnWhatToPrint
		
		EXTERNAL ARRAY taPagesToPrint
		
		LOCAL loPrintPreviewReport
		
		LOCAL lnReturn
		LOCAL lnArrayLen
		
		LOCAL llExistFileCfg
		
		WITH THIS
		
			IF  PEMSTATUS(toPrintPreviewForm, 'cSaveFolder', 5)
		        loPrintPreviewReport = toPrintPreviewForm
		    ELSE
				loPrintPreviewReport = toPrintPreviewForm.oPrintPreviewReport
		    ENDIF    
		
			lnReturn = cnOK
			
			.cLicenseKey = loPrintPreviewReport.cLicenseKey	
			
			.CheckLicense()
		
			IF .nHandleExportFile < 0
		
				FCLOSE(.nHandleExportFile)
		
				lnReturn = cnERR_CREATING_FILE
			ELSE
		
				.lPrintableArea		  = loPrintPreviewReport.lPrintableArea
		
				.nPaperSize           = loPrintPreviewReport.GetPaperSize()
		
				.cReportPath		  = loPrintPreviewReport.cReportPath
		
				.nPhysicalPaperWidth  = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetPhysicalPaperWidth()
		
				.nPhysicalPaperLength = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetPhysicalPaperLength()
				.nPhysicalLeftMargin  = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetPhysicalLeftMargin()
				.nLeftMargin		  = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetLeftMargin()
				.nRightMargin		  = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetRightMargin()
				.nTopMargin			  = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetTopMargin()
				.nBottomMargin        = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetBottomMargin()
		
			    .nPhysicalPaperTopMargin 		   = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetPhysicalPaperTopMargin()
			    .nPhysicalPaperLeftMargin  		   = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetPhysicalPaperLeftMargin()
		
				.nPhysicalPaperWidthWithOutMargin  = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetPhysicalPaperWidthWithOutMargin()
				.nPhysicalPaperLengthWithOutMargin = cnPOINTS_PER_PIXELS * loPrintPreviewReport.GetPhysicalPaperLengthWithOutMargin()
		
				lnArrayLen = ALEN(loPrintPreviewReport.aContentsField, 1)
		
				DIMENSION THIS.aContentsField(lnArrayLen, 2)
		
				ACOPY(loPrintPreviewReport.aContentsField, THIS.aContentsField)
		
				IF !.CreatePDFFile()
					FCLOSE(.nHandleExportFile)
					lnReturn = cnCANNOT_INSTANCE_PDF_FILE
				ELSE
		
					DODEFAULT(loPrintPreviewReport, @taPagesToPrint, tnCopies, tiCollate, tnWhatToPrint)
		
					lnResult = .CloseDocument()
		
					IF (lnResult # 1)
						lnReturn = cnCANNOT_INSTANCE_PDF_FILE
					ELSE
					
						.OutPutTo()					
					
					ENDIF
		
				ENDIF
			ENDIF
		
		ENDWITH
		
		RETURN lnReturn
		
	ENDPROC

	PROCEDURE setpassword
		LOCAL lnPermissions
		LOCAL lnResult
		
		LOCAL lnCanPrint
		LOCAL lnCanCopy
		LOCAL lnCanEdit
		LOCAL lnCanAddAnnotation
		LOCAL lnCanFillFields
		LOCAL lnCanCopyAccess
		LOCAL lnCanAssemble
		LOCAL lnCanPrintFull
		
		WITH THIS
			IF !EMPTY(.cPassword) OR !EMPTY(.cMasterPassword)
		
				lnCanPrint			= IIF(.lCanPrint, 1, 0)
				lnCanCopy			= IIF(.lCanCopy, 1, 0)
				lnCanEdit			= IIF(.lCanEdit, 1, 0)
				lnCanAddAnnotation	= IIF(.lCanAddAnnotation, 1, 0)
				lnCanFillFields		= IIF(.lCanFillFields, 1, 0)
				lnCanCopyAccess		= IIF(.lCanCopyAccess, 1, 0)
				lnCanAssemble		= IIF(.lCanAssemble, 1, 0)
				lnCanPrintFull		= IIF(.lCanPrintFull, 0, 1)
		
				lnPermissions = iSEDPermissions(lnCanPrint, lnCanCopy, lnCanEdit, lnCanAddAnnotation, lnCanFillFields, lnCanCopyAccess, lnCanAssemble, lnCanPrintFull)
		
				lnResult	  = iSEDEncrypt(.cMasterPassword, .cPassword, 1, lnPermissions)
		
			ENDIF
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE showoutput
		LOCAL lcExportFile
		
		DECLARE INTEGER ShellExecute IN SHELL32.DLL INTEGER nWinHandle, STRING cOperation, STRING cFileName, STRING cParameters,;
			STRING cDirectory, INTEGER nShowWindow
		
		lcExportFile = FORCEEXT(THIS.cSaveFolder + THIS.cExportFileName, ccPDF_EXT)
		
		ShellExecute(0, 'Open', lcExportFile, '', '', 1)
		
	ENDPROC

	PROCEDURE translatefontstyle
		LPARAMETERS tcFontStyle
		
		LOCAL lcTranslatedFontStyle
		
		LOCAL lnLangID
		LOCAL lnPrimaryLangID
		
		lcTranslatedFontStyle = ''
		
		IF VARTYPE(tcFontStyle) <> 'C'
			RETURN lcTranslatedFontStyle
		ENDIF
		
		tcFontStyle = UPPER(tcFontStyle)
		
		IF !INLIST(tcFontStyle,'BOLD','ITALIC')
			RETURN PROPER(lcTranslatedFontStyle)
		ENDIF
		
		lnLangID = GetSystemDefaultLangID()
		lnPrimaryLangID = lnLangID % 0x100
		
		DO CASE
			CASE !THIS.lTranslateFontStyle
				lcTranslatedFontStyle = tcFontStyle
		
			CASE lnPrimaryLangID = 0x07 && LANG_GERMAN
				lcTranslatedFontStyle = IIF(tcFontStyle = 'BOLD', 'FETT', 'KURSIV')
				
			CASE lnPrimaryLangID = 0x0c && LANG_FRENCH
				lcTranslatedFontStyle = IIF(tcFontStyle = 'BOLD', 'GRAS', 'ITALIQUE')
				
			CASE lnPrimaryLangID = 0x10 && LANG_ITALIAN
				lcTranslatedFontStyle = IIF(tcFontStyle = 'BOLD', 'GRASSETTO', 'CORSIVO')
				
			CASE lnPrimaryLangID = 0x0a &&LANG_SPANISH 		
				lcTranslatedFontStyle = IIF(tcFontStyle = 'BOLD', 'NEGRITA', 'CURSIVA')
				
			CASE lnPrimaryLangID = 0x16 &&LANG_PORTUGUESE
				lcTranslatedFontStyle = IIF(tcFontStyle = 'BOLD', 'NEGRITO', 'ITÁLICO')		
			
			CASE lnPrimaryLangID = 0x13 &&LANG_DUTCH
				lcTranslatedFontStyle = IIF(tcFontStyle = 'BOLD', 'VET', 'SCHUIN')			
				
			OTHERWISE
				lcTranslatedFontStyle = tcFontStyle
				
		ENDCASE
		
		RETURN PROPER(lcTranslatedFontStyle)
		
		
		
		
	ENDPROC

	PROCEDURE writebox
		LPARAMETERS tnTop, tnLeft, tnHeight, tnWidth, tnLineWidth, tnLineColor, tnLineStyle, tnFillBackColor, tnFillForeColor, tnFillStyle, tnRectangleType, tcHyperLink, tlPlaceInBack
		
		LOCAL lnForeColor
		LOCAL lnBackColor
		LOCAL lnResult
		
		LOCAL lnRed
		LOCAL lnGreen
		LOCAL lnBlue
		
		LOCAL lnOutLine
		
		*-- Set Transparency
		DO CASE
			CASE tnFillStyle = cnPDF_FILL_PATTERN_NO_FILL_NO_COLOR
				lnOutLine = 0
		
			CASE tnFillStyle = cnPDF_FILL_PATTERN_NO_FILL_ONLY_COLOR
				lnOutLine = 2
		
			OTHERWISE
		*-- So far iSEDQuickPDF does not support Patternity, we can use only Transparency
				lnOutLine = 0
		
		ENDCASE
		
		
		IF  tnFillStyle = cnPDF_FILL_PATTERN_NO_FILL_NO_COLOR AND tnLineWidth = 0
		*--Nothing to draw
		ELSE
		
			IF tlPlaceInBack
				lnResult = iSEDSelectLayer(2)
				lnResult = iSEDMoveLayer(2, 1)
			ENDIF
		
			DO CASE
				CASE INLIST(tnLineStyle, cnPDF_PEN_PATTERN_DASHED, cnPDF_PEN_PATTERN_DASH_DOT, cnPDF_PEN_PATTERN_DASH_DOT_DOT)
					lnResult = iSEDSetLineDash(10, 4)
		
				CASE tnLineStyle = cnPDF_PEN_PATTERN_DOTTED
					lnResult = iSEDSetLineDash(2, 2)
		
				OTHERWISE
					lnResult = iSEDSetLineDash(0, 0)
		
			ENDCASE
		
			lnResult    = iSEDSetLineWidth(tnLineWidth)
		
			lnBackColor = IIF(tnFillBackColor < 0, RGB(255, 255, 255), tnFillBackColor)
			lnForeColor = IIF(tnLineColor < 0, 0, tnLineColor)
		
			lnForeColor = IIF(tnLineWidth > 0, lnForeColor, lnBackColor)
		
		
			THIS.SplitColorToRGB(lnForeColor, @lnRed, @lnGreen, @lnBlue)
		
			lnResult    = iSEDSetLineColor(lnRed, lnGreen, lnBlue)
		
			DO CASE
				CASE tnFillStyle = cnPDF_FILL_PATTERN_NO_FILL_ONLY_COLOR
		
					THIS.SplitColorToRGB(lnBackColor, @lnRed, @lnGreen, @lnBlue)
		
					lnResult    = iSEDSetFillColor(lnRed, lnGreen, lnBlue)
		
			ENDCASE
		
			lnResult = iSEDDrawRoundedBox(tnLeft, tnTop, tnWidth, tnHeight, tnRectangleType, lnOutLine)
		
		*-- Add HyperLink
			IF !EMPTY(tcHyperLink)
				lnResult = iSEDAddLinkToWeb(tnLeft, tnTop, tnWidth, tnHeight, EVALUATE(tcHyperLink), 0)
			ENDIF
		
			IF tlPlaceInBack
				lnResult = iSEDSelectLayer(1)
				lnResult = iSEDMoveLayer(1, 2)
			ENDIF
		
		ENDIF
		
		
	ENDPROC

	PROCEDURE writeimage
		LPARAMETERS tcImageSource, tnTop, tnLeft, tnHeight, tnWidth, tnScalePicture, tcHyperLink
		
		LOCAL lcHyperLink
		LOCAL lcOldExact
		
		LOCAL lnElementNumber
		LOCAL lnRow
		LOCAL lnImageID
		LOCAL lnResult
		
		LOCAL llDontReturnResult
		
		WITH THIS
		
			IF tnScalePicture = 2
			ELSE
				llDontReturnResult = .T.
				lcImage = DODEFAULT(tcImageSource, @tnHeight, @tnWidth, tnScalePicture, llDontReturnResult)
		
				IF UPPER(JUSTEXT(tcImageSource)) <> 'PNG'
					ERASE (tcImageSource)
				ENDIF
		
				tcImageSource = FORCEEXT(tcImageSource, 'PNG')
		
		
			ENDIF
		
			tcImageSource   = UPPER(tcImageSource)
		
			lcOldExact = SET('EXACT')
			SET EXACT ON
		
			lnElementNumber = ASCAN(.aUsedImages, tcImageSource)
		
			SET EXACT &lcOldExact
		
			IF lnElementNumber > 0
				lnRow = ASUBSCRIPT(.aUsedImages, lnElementNumber, 1)
				lnImageID = .aUsedImages(lnRow, 2)
			ELSE
				IF FILE(tcImageSource)
					IF !EMPTY(.aUsedImages(1, 1))
						DIMENSION .aUsedImages(ALEN(.aUsedImages, 1) + 1, 2)
					ENDIF
					lnImageID = iSEDAddBMPImageFromFile(tcImageSource)
		
					.aUsedImages(ALEN(.aUsedImages, 1), 1) = tcImageSource
					.aUsedImages(ALEN(.aUsedImages, 1), 2) = lnImageID
				ENDIF
			ENDIF
		
			lnResult  = iSEDSelectImage(lnImageID)
			lnResult  = iSEDDrawImage(tnLeft, tnTop, tnWidth, tnHeight)
		
			IF !EMPTY(tcHyperLink)
				lnResult = iSEDAddLinkToWeb(tnLeft, tnTop, tnWidth, tnHeight, EVALUATE(tcHyperLink), 0)
			ENDIF
		
			ERASE (tcImageSource)
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE writeline
		LPARAMETERS tnTop, tnLeft, tnBottom, tnRight, tnLineWidth, tnLineColor, tnLineStyle
		
		LOCAL lnForeColor
		LOCAL lnResult
		
		LOCAL lnRed
		LOCAL lnGreen
		LOCAL lnBlue
		
		LOCAL lnXEnd
		LOCAL lnYEnd
		
		DO CASE
			CASE INLIST(tnLineStyle, cnPDF_PEN_PATTERN_DASHED, cnPDF_PEN_PATTERN_DASH_DOT, cnPDF_PEN_PATTERN_DASH_DOT_DOT)
				lnResult = iSEDSetLineDash(10, 4)
		
			CASE tnLineStyle = cnPDF_PEN_PATTERN_DOTTED
				lnResult = iSEDSetLineDash(2, 2)
		
			OTHERWISE
				lnResult = iSEDSetLineDash(0, 0)
		
		ENDCASE
		
		lnResult = iSEDSetLineWidth(tnLineWidth)
		
		lnForeColor = IIF(tnLineColor < 0, 0, tnLineColor)
		
		THIS.SplitColorToRGB(lnForeColor, @lnRed, @lnGreen, @lnBlue)
		
		lnResult    = iSEDSetLineColor(lnRed, lnGreen, lnBlue)
		lnResult    = iSEDDrawLine(tnLeft, tnTop, tnRight, tnBottom)
		
	ENDPROC

	PROCEDURE writertf
		LPARAMETERS tcRTFID,  tcTextRTF, tnLeft, tnTop, tnWidth, tnHeight
		
		LOCAL loRTFTree
		LOCAL loRTFTextCollection
		LOCAL loRTFTextProperties
		
		LOCAL lnPos
		LOCAL lnCurElementRow
		LOCAL lnTotal
		
		WITH THIS
		
			loRTFTextCollection = NEWOBJECT(ccOBJ_RTF_NODE_COLLECTION_CLS_NAME, ADDBS(JUSTPATH(.CLASSLIBRARY)) + ccRTF_CLASS_NAME)
		
			loRTFTree = NEWOBJECT(ccOBJ_RTF_TREE_CLS_NAME, ADDBS(JUSTPATH(.CLASSLIBRARY)) + ccRTF_CLASS_NAME)
		
			loRTFTree.LoadRtfText(tcTextRTF)
		
			lcTextRTF = loRTFTree.ToObjectRTFEx(loRTFTree.oRootNode, @loRTFTextCollection, THIS)
		
			.WriteBox(tnTop, tnLeft, tnHeight, tnWidth, 0, RGB(255, 255, 255), cnREPORT_PEN_PATTERN_NONE, RGB(255, 255, 255), RGB(255, 255, 255), cnREPORT_FILL_PATTERN_NO_FILL_ONLY_COLOR, 0)
		
		
			FOR lnCount = 1 TO loRTFTextCollection.COUNT
		
				loRTFTextProperties = loRTFTextCollection.ITEM(lnCount)
		
				WITH loRTFTextProperties
		
					THIS.WriteText(.cText, tnTop + .nTop, tnLeft + .nLeft, .nHeight, .nWidth, .cFontName, .lFontBold, .lFontItalic, .lFontUnderline, .lFontStrikethru, .nFontSize, cnALIGN_LEFT, .T., .nForeColor, RGB(255, 255, 255))
		
				ENDWITH
		
			ENDFOR
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE writetext
		LPARAMETERS tcText, tnTop, tnLeft, tnHeight, tnWidth, tcFontName, tlFontBold, tlFontItalic, ;
			tlFontUnderline, tlFontStrikethru, tnFontSize, tnAlignment, tlTransparent, tnForeColor, tnFillColor, tcHyperLink
		
		LOCAL lcFontName
		LOCAL lcOldExact
		
		LOCAL lnElementNumber
		LOCAL lnRow
		LOCAL lnFontID
		LOCAL lnForeColor
		LOCAL lnFillColor
		
		LOCAL lnRed
		LOCAL lnGreen
		LOCAL lnBlue
		
		
		lcFontName = PROPER(tcFontName)
		
		IF	tlFontBold
			lcFontName = lcFontName + ' ' + THIS.TranslateFontStyle('Bold')
		ENDIF
		
		IF tlFontItalic
			lcFontName = lcFontName + ' ' + THIS.TranslateFontStyle('Italic')
		ENDIF
		
		lcFontName = lcFontName + ' {' + ALLTRIM(STR(THIS.nCodePage))  + '} '
		
		lcOldExact = SET('EXACT')
		SET EXACT ON
		
		lnElementNumber = ASCAN(THIS.aUsedFonts, lcFontName)
		
		SET EXACT &lcOldExact
		
		IF lnElementNumber > 0
			lnRow = ASUBSCRIPT(THIS.aUsedFonts, lnElementNumber, 1)
			lnFontID = THIS.aUsedFonts(lnRow, 2)
		ELSE
		
			IF !EMPTY(THIS.aUsedFonts(1, 1))
				DIMENSION THIS.aUsedFonts(ALEN(THIS.aUsedFonts, 1) + 1, 2)
			ENDIF
		
			DO CASE
				CASE 'COURIER' $ UPPER(lcFontName) AND THIS.nCodePage = 1252
					DO CASE
						CASE 'BOLD'  $ UPPER(lcFontName) AND 'ITALIC'  $ UPPER(lcFontName)
							lnFontID = iSEDAddStandardFont(2)
		
						CASE 'BOLD'  $ UPPER(lcFontName)
							lnFontID = iSEDAddStandardFont(1)
		
						CASE 'ITALIC'  $ UPPER(lcFontName)
							lnFontID = iSEDAddStandardFont(3)
		
						OTHERWISE
							lnFontID = iSEDAddStandardFont(0)
		
					ENDCASE
		
				OTHERWISE
						lnFontID = iSEDAddTrueTypeFont(lcFontName, IIF(THIS.lIncludefont, 1, 0))
			ENDCASE
		
			THIS.aUsedFonts(ALEN(THIS.aUsedFonts, 1), 1) = lcFontName
			THIS.aUsedFonts(ALEN(THIS.aUsedFonts, 1), 2) = lnFontID
		ENDIF
		
		IF .lReplaceSpaceChar
			tcText = STRTRAN(tcText, ' ', CHR(160))
		ENDIF
		
		
		lnResult = iSEDSelectFont(lnFontID)
		
		lnForeColor = IIF(tnForeColor < 0, 0, tnForeColor)
		
		THIS.SplitColorToRGB(lnForeColor, @lnRed, @lnGreen, @lnBlue)
		
		lnResult = iSEDSetTextColor(lnRed, lnGreen, lnBlue)
		
		lnResult = iSEDSetTextAlign(tnAlignment)
		
		lnResult = iSEDSetTextSize(tnFontSize * 0.910)
		
		IF !tlTransparent
			lnFillColor = IIF(tnFillColor < 0 , RGB(255, 255, 255), tnFillColor)
		
			THIS.SplitColorToRGB(lnFillColor, @lnRed, @lnGreen, @lnBlue)
		
			lnResult = iSEDSetFillColor(lnRed, lnGreen, lnBlue)
			lnResult = iSEDDrawBox(tnLeft, tnTop, tnWidth, tnHeight, 1)
		
		ENDIF
		
		
		IF 'CODE 128' $ UPPER(lcFontName) 
			tcText = STRTRAN(tcText, CHR(160), ' ')
		ENDIF
		
		lnResult = iSEDDrawTextBox(tnLeft, tnTop, tnWidth, tnHeight, tcText, 4)
		
		*-- Add HyperLink
		IF !EMPTY(tcHyperLink)
			lnResult = iSEDAddLinkToWeb(tnLeft, tnTop, tnWidth, tnHeight, EVALUATE(tcHyperLink), 0)
		ENDIF
		
		
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS pdfgroup AS pdfband OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: lprintoneachpage_assign
		*m: lresetpage_assign
		*m: lstartinnewcolumn_assign
		*m: nnewpagewhenlessthan_assign
		*p: cexpression		&& The group expression
		*p: lfirstoutputwasdone
		*p: lprintoneachpage
		*p: lresetpage
		*p: lstartinnewcolumn
		*p: nnewpagewhenlessthan
	*</DefinedPropArrayMethod>

	*<PropValue>
		cexpression = 
		Name = "pdfgroup"
	*</PropValue>
	
	PROCEDURE Init
		LPARAMETERS tcBandType, toReport, tcGroupHeaderBandID
		
		DODEFAULT(tcBandType, toReport)
		
		WITH THIS
			IF TYPE('tcGroupHeaderBandID') = 'C'
				.NAME = tcGroupHeaderBandID
			ELSE
				.NAME = SYS(2015)
			ENDIF
		ENDWITH
		
	ENDPROC

	PROCEDURE lprintoneachpage_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lPrintOnEachPage = tlValue
		ENDIF
		
	ENDPROC

	PROCEDURE lresetpage_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lResetPage = tlValue
		ENDIF 
		
	ENDPROC

	PROCEDURE lstartinnewcolumn_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lStartInNewColumn = tlValue
		ENDIF 
		
	ENDPROC

	PROCEDURE nnewpagewhenlessthan_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE NOT BETWEEN(tnValue, 0, 9999)
			OTHERWISE
				THIS.nNewPageWhenLessThan = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE setbandproperties
		LPARAMETERS torecord
		
		DODEFAULT(torecord)
		
		WITH THIS
		*-- Set the band Expression
			.cExpression  	  = ALLTRIM(torecord.EXPR)
			.lPrintOnEachPage = toRecord.NoRepeat 	
			
			.lStartInNewColumn   = toRecord.ColBreak	
			
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS pdfimage AS anyimage OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<PropValue>
		cimagesource = 
		limagefile = .T.
		Name = "pdfimage"
		nobjecttype = 17
		nstretch = 0
	*</PropValue>
	
	PROCEDURE cimagesource_assign
		LPARAMETER tcValue
		
		IF VARTYPE(tcValue) <> 'C'
		ELSE
			THIS.cImageSource = tcValue
		ENDIF 
		
	ENDPROC

	PROCEDURE limagefile_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lImageFile = tlValue
		ENDIF
		
	ENDPROC

	PROCEDURE nstretch_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE NOT BETWEEN(tnValue, 0, 2)
			OTHERWISE
				THIS.nStretch = tnValue
		ENDCASE
		
	ENDPROC

ENDDEFINE

DEFINE CLASS pdfline AS anyline OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<PropValue>
		Height = 16
		lvertical = .F.
		Name = "pdfline"
		nobjecttype = 6
		Width = 17
	*</PropValue>
	
	PROCEDURE lvertical_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lVertical = tlValue
		ENDIF
		
	ENDPROC

	PROCEDURE npenpattern_assign
		*-- Ensure the pen pattern value is valid.
		LPARAMETER tnValue
		
		IF VARTYPE(tnValue) $ 'NFIBY' AND INLIST(tnValue, ;
				cnPDF_PEN_PATTERN_NONE, cnPDF_PEN_PATTERN_NORMAL, cnPDF_PEN_PATTERN_DOTTED, cnPDF_PEN_PATTERN_NONE,;
				cnPDF_PEN_PATTERN_DASH_DOT_DOT,cnPDF_PEN_PATTERN_DASHED, cnPDF_PEN_PATTERN_DASH_DOT) 
			THIS.nPenPattern = tnValue
		ELSE
			THIS.nPenPattern = cnPDF_PEN_PATTERN_NORMAL
		ENDIF	
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS pdftext AS pdffield OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<PropValue>
		Name = "pdftext"
		nobjecttype = 5
	*</PropValue>

ENDDEFINE
