	PROCEDURE copyobject		&& Function that copies an object and all of it child object into a totally new object reference that is not based on a previous reference
		LPARAMETER toInput
		
		LOCAL loObject
		
		LOCAL laFields[1]
		LOCAL laPropertiesToSkip[18]
		
		LOCAL lcField
		LOCAL lcType
		
		LOCAL llClass
		
		LOCAL lnTotalMembers
		LOCAL lnLength
		LOCAL lnCount
		LOCAL lnCount2
		
		laPropertiesToSkip[01] = '<classlibrary>'
		laPropertiesToSkip[02] = '<baseclass>'
		laPropertiesToSkip[03] = '<comment>'
		laPropertiesToSkip[04] = '<controls>'
		laPropertiesToSkip[05] = '<objects>'
		laPropertiesToSkip[06] = '<class>' 
		laPropertiesToSkip[07] = '<name>'
		laPropertiesToSkip[08] = '<helpcontextid>'
		laPropertiesToSkip[09] = '<whatsthishelpid>'
		laPropertiesToSkip[10] = '<tag>'
		laPropertiesToSkip[11] = '<picture>'
		laPropertiesToSkip[12] = '<onetomany>'
		laPropertiesToSkip[13] = '<childalias>'
		laPropertiesToSkip[14] = '<childorder>'
		laPropertiesToSkip[15] = '<parent>'
		laPropertiesToSkip[16] = '<parentclass>'
		laPropertiesToSkip[17] = '<relationalexpr>'
		laPropertiesToSkip[18] = '<controlcount>'
		
		
		loObject = .NULL.
		
		*-- Check if we can instantiate input object class
		IF TYPE('toInput.Class') = 'C'
		*-- If we have a class create it
			loObject      = NEWOBJECT(toInput.CLASS, .CLASSLIBRARY, '', THIS)   
			loObject.NAME = SYS(2015)
		   
		ELSE
			RETURN loObject
		ENDIF
		
		*-- Grab member properties and loop through them
		lnTotalMembers = AMEMBERS(laFields, toInput)
		
		FOR lnCount = 1 TO lnTotalMembers
		   lcField = LOWER(laFields[lnCount])
		   
		*-- Ignore stock properties
			IF ASCAN(laPropertiesToSkip, '<' + lcField + '>') > 0
			    LOOP
			ENDIF
		   
		*-- Grab the type
		   lcType = TYPE('toInput.' + lcField)
		
		   DO CASE
		*-- Must check for array properties first
		      CASE TYPE([ALEN(toInput.] + lcField + [)]) = 'N'
		*-- Add property if it doesn't exist
				IF !PEMSTATUS( loObject, lcField, 5)
		            loObject.ADDPROPERTY(lcField + '[1]')
		         ENDIF
		
		*-- Create the array then run through
		         lnLength = ALEN(toInput.&lcField, 1)
		         
		         DIMENSION loObject.&lcField[lnLength]
		         FOR lnCount2 = 1 TO lnLength
		            IF TYPE('toInput.' +lcField + '[lnCount2]') = 'O'
		            ELSE
		               loObject.&lcField[lnCount2] = EVAL('toInput.' + lcField + '[lnCount2]')
		            ENDIF
		         ENDFOR
		         
		*-- Recursive calls for objects
		      CASE lcType = 'O'
		      
				IF !PEMSTATUS( loObject, lcField, 5)      
		            loObject.ADDPROPERTY(lcField)
		         ENDIF
		
		         loObject.&lcField = THIS.CopyObject(EVAL('toInput.' + lcField))
		      OTHERWISE
		*-- Check if property exists
				IF !PEMSTATUS( loObject, lcField, 5)         
		            loObject.ADDPROPERTY(lcField)
		         ENDIF
		
		*-- Straight Assignment
		         loObject.&lcField = EVAL('toInput.' + lcField)
		   ENDCASE
		ENDFOR
		
		RETURN loObject
		
	ENDPROC

