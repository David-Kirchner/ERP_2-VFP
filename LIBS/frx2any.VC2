	PROTECTED PROCEDURE getobjectband		&& Using by FRX2Word
		LPARAMETERS  tVPos, taBandHeight
		
		EXTERNAL ARRAY taBandHeight
		
		LOCAL lnTopOfObject
		LOCAL lnCount
		LOCAL lnMinValue
		LOCAL lnMaxValue
		LOCAL loObjectBand
		
		loObjectBand = .NULL.
		
		*-- Find witch Band this object belong to
		lnTopOfObject=0
		FOR lnCount = 1 TO ALEN(taBandHeight, 1)
			DO CASE
				CASE lnCount = 1
					lnMinValue = 0
					lnMaxValue = taBandHeight(lnCount, 1)
				OTHERWISE
					lnMinValue = taBandHeight(lnCount - 1, 1)
					lnMaxValue = taBandHeight(lnCount, 1)
			ENDCASE
		
			IF BETWEEN(tVPos, lnMinValue, lnMaxValue)
				EXIT
			ENDIF
		ENDFOR
		
		RETURN loObjectBand
		
	ENDPROC

