	PROCEDURE getchart
		LPARAMETERS tvChartNameOrRecordObject
		
		LOCAL loChart
		
		LOCAL lnArrayLen
		LOCAL lnCount
		LOCAL lnOldMemoWidth
		LOCAL lnMemoLines
		
		LOCAL lcChartName
		LOCAL lcMemoLine
		
		
		WITH THIS
		
			loChart = .NULL.
		
			DO CASE
				CASE VARTYPE(tvChartNameOrRecordObject) = 'C'
					lcChartName = tvChartNameOrRecordObject
		
				CASE VARTYPE(tvChartNameOrRecordObject) = 'O'
		
					lnOldMemoWidth = SET('MEMOWIDTH')
					SET MEMOWIDTH TO 500
		
					lnMemoLines = MEMLINES(tvChartNameOrRecordObject.COMMENT)
		
					FOR lnCount = 1 TO lnMemoLines
		
						lcMemoLine = MLINE(tvChartNameOrRecordObject.COMMENT, lnCount)
		
						IF ATC('Chart=', lcMemoLine) > 0
							lcChartName = .ExtractValue(lcMemoLine)
		
							EXIT
						ENDIF
		
					ENDFOR
		
					SET MEMOWIDTH TO lnOldMemoWidth
		
			ENDCASE
		
			IF !EMPTY(lcChartName)
		
				lnArrayLen = ALEN(.aCharts, 1)
		
				FOR lnCount = 1 TO lnArrayLen
		
					loChart = .aCharts[lnCount]
		
					IF !ISNULL(loChart)
		
						IF UPPER(loChart.cChartName) == &lcChartName
							EXIT
						ENDIF
		
					ENDIF
		
				ENDFOR
		
			ENDIF
		
		ENDWITH
		
		RETURN loChart
		
		
	ENDPROC

