	PROCEDURE encodebase64
		LPARAMETER tcString
		
		LOCAL lcEncodedString
		LOCAL lcTmpFile0
		LOCAL lcTmpFile1
		LOCAL lcTmpFile2
		
		LOCAL lnFile0
		LOCAL lnFile1
		LOCAL lnFile2
		
		LOCAL lnVar
		LOCAL lnMask
		LOCAL ln64
		LOCAL ln64Masked
		LOCAL lnCount
		
		WITH THIS
		
			IF .nVFPVersion >= 8
				lcEncodedString = STRCONV(tcString, 13)
		
			ELSE
				lcTmpFile0 = FORCEEXT(ADDBS(SYS(2023)) +  SYS(2015), 'TXT')
		
				STRTOFILE(tcString, lcTmpFile0)
				lnFile0    = FOPEN(lcTmpFile0)
		
		
				lcTmpFile1 = FORCEEXT(ADDBS(SYS(2023)) +  SYS(2015), 'TXT')
		
				STRTOFILE('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/', lcTmpFile1)
				lnFile1    = FOPEN(lcTmpFile1)
		
		
				lcTmpFile2 = FORCEEXT(ADDBS(SYS(2023)) +  SYS(2015), 'TXT')
				lnFile2    = FCREATE(lcTmpFile2)
		
				lnVar = 0
		
				DO WHILE !FEOF(lnFile0)
		
					lnMask = 0xFC0000
		
					ln64   = BITOR(BITOR(ASC(FREAD(lnFile0, 1))*65536, ASC(FREAD(lnFile0, 1))*256), ASC(FREAD(lnFile0, 1)))
		
					FOR lnCount = 3 TO 0 STEP -1
		
						ln64Masked = BITRSHIFT(BITAND(ln64, lnMask), lnCount * 6)
		
						FSEEK(lnFile1, ln64Masked)
						FWRITE(lnFile2, FREAD(lnFile1, 1))
		
						lnMask = BITRSHIFT(lnMask, 6)
		
					ENDFOR
		
					lnVar = lnVar + 1
		
					IF lnVar % 18 = 0
						FWRITE(lnFile2, CHR(10))
					ENDIF
		
				ENDDO
		
				lnVar = FSEEK(lnFile0, 0, 2)
				lnVar = FSEEK(lnFile2, 0, 2) - CEILING(lnVar/3*4 + INT(lnVar/54) * 2)
		
				FSEEK(lnFile2, -lnVar, 2)
				FWRITE(lnFile2, '===', lnVar)
		
				FCLOSE(lnFile0)
				FCLOSE(lnFile1)
				FCLOSE(lnFile2)
		
				lcEncodedString = FILETOSTR(lcTmpFile2)
		
		
				IF FILE(lcTmpFile0)
					ERASE (lcTmpFile0)
				ENDIF
		
				IF FILE(lcTmpFile1)
					ERASE (lcTmpFile1)
				ENDIF
		
				IF FILE(lcTmpFile2)
					ERASE (lcTmpFile2)
				ENDIF
		
		
			ENDIF
		
		ENDWITH
		
		RETURN lcEncodedString
		
	ENDPROC

	PROCEDURE extractvalue
		PARAMETER tcLine
		
		IF ATC('"', tcLine) > 0
			lcLine = ALLTRIM(SUBSTR(tcLine, ATC('=', tcLine) + 1))
			
			IF ATC('"', lcLine) = 1
				lcLine = SUBSTR(tcLine, ATC('"', tcLine, 1) + 1, ATC('"', tcLine,2) - ATC('"', tcLine,1) - 1)
			ELSE	
				lcLine = EVALUATE(lcLine) 
			ENDIF	
		ELSE
			lcLine = ALLTRIM(SUBSTR(tcLine, ATC('=', tcLine) + 1))
		ENDIF
		
		RETURN lcLine
		
	ENDPROC

