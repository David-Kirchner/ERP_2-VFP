	ENDPROC

	PROTECTED PROCEDURE createfileobject
		LPARAMETERS tcReportFullName
		
		LOCAL loBelongToBand
		
		LOCAL lcBandClassName
		LOCAL lcGroupBandClassName
		
		LOCAL lcObjectName
		LOCAL lcMemoLine
		
		LOCAL lObject
		
		LOCAL laTempMultyBandObject[1,3]
		
		LOCAL lnMinValue
		LOCAL lnMaxValue
		LOCAL lnGroup
		LOCAL lnVariable
		LOCAL lnSelect
		
		*--Keep current alias (Just in case it is the good one)
		lnSelect = SELECT()
		
		*-- Must check intigrety of FRX.
		IF PARAMETER() < 1 OR EMPTY(tcReportFullName) OR !INLIST(THIS.nExportFileType, cnHTML, cnPDF, cnWORD, cnEXCEL, cnPREVIEW, cnXML, cnRTF, cnIMAGE)
			RETURN cnNO_PARAMETERS
		ENDIF
		
		tcReportFullName = FORCEEXT(tcReportFullName, ccREPORT_EXT)
		
		IF !FILE(tcReportFullName)
			RETURN cnREP_FILE_NOT_FOUND
		ENDIF
		
		DO CASE
			CASE THIS.nExportFileType = cnHTML
				lcBandClassName      = ccOBJ_HTML_BAND_CLS_NAME
				lcGroupBandClassName = ccOBJ_HTML_GROUP_CLS_NAME
		
			CASE THIS.nExportFileType = cnWORD
				lcBandClassName      = ccOBJ_WORD_BAND_CLS_NAME
				lcGroupBandClassName = ccOBJ_WORD_GROUP_CLS_NAME
		
			CASE THIS.nExportFileType = cnRTF
				lcBandClassName      = ccOBJ_RTF_BAND_CLS_NAME
				lcGroupBandClassName = ccOBJ_RTF_GROUP_CLS_NAME
		
			CASE THIS.nExportFileType = cnEXCEL
				lcBandClassName      = ccOBJ_EXCEL_BAND_CLS_NAME
				lcGroupBandClassName = ccOBJ_EXCEL_GROUP_CLS_NAME
		
			CASE THIS.nExportFileType = cnPREVIEW
				lcBandClassName      = ccOBJ_PREVIEW_BAND_CLS_NAME
				lcGroupBandClassName = ccOBJ_PREVIEW_GROUP_CLS_NAME
		
			CASE THIS.nExportFileType = cnPDF
				lcBandClassName      = ccOBJ_PDF_BAND_CLS_NAME
				lcGroupBandClassName = ccOBJ_PDF_GROUP_CLS_NAME
		
			CASE THIS.nExportFileType = cnXML
				lcBandClassName      = ccOBJ_XML_BAND_CLS_NAME
				lcGroupBandClassName = ccOBJ_XML_GROUP_CLS_NAME
		
			CASE THIS.nExportFileType = cnIMAGE
				lcBandClassName      = ccOBJ_IMAGE_BAND_CLS_NAME
				lcGroupBandClassName = ccOBJ_IMAGE_GROUP_CLS_NAME
		
			OTHERWISE
				RETURN cnWRONG_EXPORT_FILE_TYPE
		ENDCASE
		
		lnMinValue = 0
		lnMaxValue = 0
		
		WITH THIS
			.cReportName = tcReportFullName
			.cReportPath = ADDBS(JUSTPATH(tcReportFullName))
		
			IF EMPTY(.cReportPath)
		*-- Take Path that is by default
				.cReportPath  = ADDBS(JUSTPATH(SYS(16, 0)))
			ENDIF
		
		*-- Create the objects representing bands in every report.
			.oPageHeaderBand  = NEWOBJECT(lcBandClassName, .CLASSLIBRARY, '', cnBAND_PAGE_HEADER_REPOBJ_CODE, THIS)
			.oDetailBand      = NEWOBJECT(lcBandClassName, .CLASSLIBRARY, '', cnBAND_DETAIL_REPOBJ_CODE, THIS)
			.oPageFooterBand  = NEWOBJECT(lcBandClassName, .CLASSLIBRARY, '', cnBAND_PAGE_FOOTER_REPOBJ_CODE, THIS)
		
			IF !.lFirstPass
				.oDataEnvironment = NEWOBJECT(ccOBJ_ANY_DE_CLS_NAME, .CLASSLIBRARY, '', THIS)
			ENDIF
		
			DIMENSION .aGroupBands[1, 3]
			.aGroupBands = .NULL.
			.aVariables  = .NULL.
		
		*-- Calculate the factors to convert Report units into Any pixels.
		*-- Hope that report is done for Characters
			.cUnits = ccUNITS_CHARACTERS
			.CalculateFactors()
		
		*-- Process Report table
			USE (.cReportName) IN 0 ALIAS ReportDBF NOUPDATE
			SELECT ReportDBF
		
			LOCATE FOR ReportDBF.ObjType = cnREPOBJ_HEADER AND ReportDBF.Platform = 'WINDOWS'
		
		
			IF !EOF('ReportDBF')
				SCATTER NAME loReportRecord MEMO
		
				.PageSettings(loReportRecord)
		
		*-- Set Default Font
				.cFontName = IIF(!EMPTY(loReportRecord.FontFace), loReportRecord.FontFace, .cFontName)
		
		*-- Set Default Font Size
				.nFontSize = loReportRecord.FONTSIZE
		
		*-- Set Default Font Style
				.nFontStyle = loReportRecord.FontStyle
		
			ELSE
				USE IN ReportDBF
				RETURN cnNO_HEADER_RECORD
			ENDIF
		
			GOTO 2 IN ReportDBF
		
			DO WHILE .NOT. EOF('ReportDBF')
		
				IF ReportDBF.Platform = 'WINDOWS'
		
					DO CASE
						CASE ReportDBF.ObjType = cnREPOBJ_BAND
		
							SELE ReportDBF
							SCATTER NAME loReportRecord MEMO
		
							loBelongToBand = .NULL.
		
							DO CASE
								CASE ReportDBF.ObjCode = cnBAND_TITLE_REPOBJ_CODE
		
									IF ISNULL(.oTitleBand)
										.oTitleBand = NEWOBJECT(lcBandClassName, .CLASSLIBRARY, '', cnBAND_TITLE_REPOBJ_CODE, THIS)
									ENDIF
									loBelongToBand = .oTitleBand
		
								CASE ReportDBF.ObjCode = cnBAND_PAGE_HEADER_REPOBJ_CODE
		
									loBelongToBand = .oPageHeaderBand
		
								CASE ReportDBF.ObjCode = cnBAND_COL_HEADER_REPOBJ_CODE
		
									IF ISNULL(.oColumnHeaderBand)
										.oColumnHeaderBand = NEWOBJECT(lcBandClassName, .CLASSLIBRARY, '', cnBAND_COL_HEADER_REPOBJ_CODE, THIS)
									ENDIF
									loBelongToBand = .oColumnHeaderBand
		
								CASE ReportDBF.ObjCode = cnBAND_GROUP_HEADER_REPOBJ_CODE
									lnGroup = IIF(ISNULL(.aGroupBands[1, 1]), 1, ALEN(.aGroupBands, 1) + 1)
									DIMENSION .aGroupBands[lnGroup, 3]
									.aGroupBands[lnGroup, 1] = NEWOBJECT(lcGroupBandClassName, .CLASSLIBRARY, '', cnBAND_GROUP_HEADER_REPOBJ_CODE, THIS)
									loBelongToBand = .aGroupBands[lnGroup, 1]
		
								CASE ReportDBF.ObjCode=cnBAND_DETAIL_REPOBJ_CODE
									loBelongToBand = .oDetailBand
		
								CASE ReportDBF.ObjCode=cnBAND_GROUP_FOOTER_REPOBJ_CODE
		
									.aGroupBands[lnGroup, 2] = NEWOBJECT(lcGroupBandClassName, .CLASSLIBRARY, '', cnBAND_GROUP_FOOTER_REPOBJ_CODE, THIS)
									loBelongToBand = .aGroupBands[lnGroup, 2]
									lnGroup = lnGroup - 1
		
								CASE ReportDBF.ObjCode = cnBAND_COL_FOOTER_REPOBJ_CODE
									IF ISNULL(.oColumnFooterBand)
										.oColumnFooterBand = NEWOBJECT(lcBandClassName, .CLASSLIBRARY, '', cnBAND_COL_FOOTER_REPOBJ_CODE, THIS)
									ENDIF
									loBelongToBand = .oColumnFooterBand
		
								CASE ReportDBF.ObjCode=cnBAND_PAGE_FOOTER_REPOBJ_CODE
									loBelongToBand = .oPageFooterBand
		
								CASE ReportDBF.ObjCode=cnBAND_SUMMARY_REPOBJ_CODE
									IF 	ISNULL(.oSummaryBand)
										.oSummaryBand = NEWOBJECT(lcBandClassName, .CLASSLIBRARY, '', cnBAND_SUMMARY_REPOBJ_CODE, THIS)
									ENDIF
									loBelongToBand = .oSummaryBand
							ENDCASE
		
							IF !ISNULL(loBelongToBand)
		
								IF THIS.nExportFileType = cnXML
								ELSE
									IF TYPE('THIS.aMultyBandObject[1, 1]') = 'O'
		
										lnTotalRow = ALEN(THIS.aMultyBandObject, 1)
										lnTotalCol = ALEN(THIS.aMultyBandObject, 2)
		
										DIMENSION laTempMultyBandObject[lnTotalRow, lnTotalCol + 1]
										laTempMultyBandObject = .F.
		
										FOR lnCountRow = 1 TO lnTotalRow
											FOR lnCountCol = 1 TO lnTotalCol
												laTempMultyBandObject[lnCountRow, lnCountCol] = THIS.aMultyBandObject[lnCountRow, lnCountCol]
											NEXT
										NEXT
		
										DIMENSION THIS.aMultyBandObject[lnTotalRow, lnTotalCol + 1]
										=ACOPY(laTempMultyBandObject, THIS.aMultyBandObject)
		
									ENDIF
								ENDIF
		
								lnMaxValue = lnMaxValue + loReportRecord.HEIGHT
		*-- Restore objects
								loBelongToBand.SetBandProperties(loReportRecord)
								.ProcessBand(loBelongToBand, lnMinValue, lnMaxValue)
		
								lnMinValue = lnMaxValue
								lnMaxValue = lnMaxValue + cnBAND_HEIGHT
		
		
								IF THIS.nExportFileType = cnEXCEL AND .nExcelOutPutType = cnEXCEL_OUTPUT_PLAIN &&PlainExcel
		*-- If we are dealing with Plain Excel Output, we must to sort all FIELD objects by their Horisontal position
									.ProcessFieldObjects(loBelongToBand)
								ENDIF
		
								.ProcessFloatObjects(loBelongToBand)
								.ProcessRemoveObjects(loBelongToBand)
		
							ENDIF
		
						CASE ReportDBF.ObjType = cnREPOBJ_VARIABLE
		
							SELE ReportDBF
							SCATTER NAME loReportRecord MEMO
		
							lnVariable = IIF(ISNULL(.aVariables[1]), 1, ALEN(.aVariables, 1) + 1)
		
							DIMENSION .aVariables[lnVariable]
		
							.aVariables[lnVariable] = NEWOBJECT(ccOBJ_ANY_VARIABLE_CLS_NAME, .CLASSLIBRARY, '', THIS)
							loObject 			    = .aVariables[lnVariable]
		
							loObject.SetVariableProperties(loReportRecord)
		
						CASE ReportDBF.ObjType = cnREPOBJ_DE AND !.lFirstPass
		
							SELE ReportDBF
							SCATTER NAME loReportRecord MEMO
		
							.oDataEnvironment.SetDEProperties(loReportRecord)
		
						CASE ReportDBF.ObjType = cnREPOBJ_DE_OBJ AND !.lFirstPass
		
							SELE ReportDBF
							SCATTER NAME loReportRecord MEMO
		
							DO CASE
								CASE ALLTRIM(UPPER(ReportDBF.NAME)) = ccOBJECT_CURSOR
		
									lnObjects = IIF(ISNULL(.oDataEnvironment.aCursors[1]), 1, ALEN(.oDataEnvironment.aCursors, 1) + 1)
									DIMENSION .oDataEnvironment.aCursors[lnObjects]
		
									.oDataEnvironment.aCursors[lnObjects] = NEWOBJECT(ccOBJ_ANY_CURSOR_CLS_NAME, .CLASSLIBRARY, '', THIS)
		
									loObject = .oDataEnvironment.aCursors[lnObjects]
									loObject.SetCursorProperties(loReportRecord)
		
								CASE ALLTRIM(UPPER(ReportDBF.NAME)) = ccOBJECT_RELATION
		
									lnObjects = IIF(ISNULL(.oDataEnvironment.aRelations[1]), 1, ALEN(.oDataEnvironment.aRelations, 1) + 1)
									DIMENSION .oDataEnvironment.aRelations[lnObjects]
		
									.oDataEnvironment.aRelations[lnObjects] = NEWOBJECT(ccOBJ_ANY_RELATION_CLS_NAME, .CLASSLIBRARY, '', THIS)
		
									loObject = .oDataEnvironment.aRelations[lnObjects]
									loObject.SetRelationProperties(loReportRecord)
		
							ENDCASE
					ENDCASE
		
				ENDIF
		
				SKIP IN ReportDBF
			ENDDO
		
		
			IF 	.oPageFooterBand.nHeight > 0
				.nPageHeight = .nPageHeight - .oPageFooterBand.nHeight
		
			ENDIF
		
			IF 	!ISNULL(.oColumnFooterBand) AND .oColumnFooterBand.nHeight > 0
				.nPageHeight = .nPageHeight - .oColumnFooterBand.nHeight
			ENDIF
		
			.nPageHeight = .nPageHeight - IIF(INLIST(THIS.nExportFileType,cnHTML), .nPhysicalPaperTopMargin, 0)
		
			IF USED('ReportDBF')
				USE IN ReportDBF
			ENDIF
		
			SELECT (lnSelect)
		ENDWITH
		
		RETURN cnOk
		
		
		
	ENDPROC

