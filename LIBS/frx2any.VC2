	PROCEDURE addchart
		LPARAMETERS tcChartName
		
		LOCAL loChartFile
		
		LOCAL lnItem
		
		WITH THIS
		
		*--Create ChartFile object.
		
			loChartFile = NEWOBJECT(ccCHART_CLASS_CHARTFILE, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccCHART_CLASS_NAME)
		
			IF ISNULL(loChartFile)
				RETURN .NULL.
			ELSE
		*-- Unlock FRX2Any Chart Engine
				loChartFile.UNLOCK(.cLicenseKey)
		
				lnItem = IIF(ISNULL(.aCharts[1]), 1, ALEN(.aCharts) + 1)
				DIMENSION .aCharts[lnItem]
		
		
				loChartFile.cChartName = ALLTRIM(tcChartName)
		
				.aCharts[lnItem] = loChartFile
		
			ENDIF
		
			RETURN loChartFile
		
		ENDWITH
		
		
		
		
		
	ENDPROC

	PROCEDURE addoverobject
		LPARAMETERS toBand, toObject, tnNewHeight, tnPosObjBottom, tnStringHeight
		
		LOCAL loOverObject
		
		LOCAL lnStringNumber
		
		
		toObject.nNewHeight = tnNewHeight
		
		
		*-- Add this object into .aOverItems[]
		loOverObject = toBand.AddOverItem(toObject)
		
		WITH loOverObject
			.nVPosition   = 0
			.nSurDelta	  = 0
			.nMoveDelta	  = 0
			.aSurrounders = .NULL.
		*-- We don't need stretch stretched item any more
			.lStretched   = .T.
		ENDWITH
		
		lnStringNumber = 0
		DO WHILE THIS.nHeight + tnPosObjBottom > THIS.nPageHeight
		
			tnPosObjBottom = tnPosObjBottom - tnStringHeight
			tnNewHeight    = tnNewHeight - tnStringHeight
		
			lnStringNumber = lnStringNumber + 1
		
		ENDDO
		
		WITH loOverObject
		
			.nOriginalHeight    = .nHeight
			.nHeight            = .nStretchedHeight - tnNewHeight
			.nStretchedHeight   = .nHeight
			
			IF THIS.nExportFileType = cnPREVIEW OR THIS.nExportFileType = cnEXCEL OR THIS.nExportFileType = cnPDF
				.cExpression = SUBSTR(.cLinePerObject, RAT(ccLF, .cLinePerObject, lnStringNumber) + 1)
			ELSE
				.cExpression = SUBSTR(.cLinePerObject, RAT(ccCR, .cLinePerObject, lnStringNumber) + 1)			
			ENDIF
			
			.nSurBottomPosition = loOverObject.nVPosition + loOverObject.nHeight - loOverObject.nMoveDelta
			.nOveredSurDelta 	= THIS.nPageHeight - tnPosObjBottom - THIS.nHeight
		ENDWITH
		
		toObject.nOveredSurDelta = loOverObject.nOveredSurDelta
		
		RETURN tnNewHeight
		
		
	ENDPROC

	PROCEDURE addpage		&& Used by Report Listener
		WITH THIS
		
			.nCurrentPage = .nCurrentPage + 1
		
			.NewPage(.nCurrentPage)
		
		ENDWITH
		
	ENDPROC

