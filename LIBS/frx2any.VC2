		ENDIF 
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anyobject AS anyrecord OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: cprintwhen_assign
		*m: lprintinfirstwholeband_assign
		*m: lprintonnewpage_assign
		*m: lprintrepeats_assign
		*m: lremovelineifblank_assign
		*m: lstretch_assign
		*m: ltransparent_assign
		*m: nalignment_assign
		*m: nbackcolor_assign
		*m: nfloat_assign
		*m: nforecolor_assign
		*m: nheight_assign
		*m: nhposition_assign
		*m: noveredsurdelta_assign
		*m: nprintongroupchange_assign
		*m: nstretchedheight_assign
		*m: nvposition_assign
		*m: nwidth_assign
		*p: cboundeddatafield
		*p: ccomment		&& The comment to display
		*p: chyperlink
		*p: clineperobject
		*p: cprintwhen		&& The Print When expression
		*p: creportlink
		*p: creportobjectname		&& Keeps unique Report Object name
		*p: lcanberemoved		&& .T. if  line can be removed from Report
		*p: ldontcalculate
		*p: ldontprint		&& Shows  print object or skip it
		*p: lprintinfirstwholeband		&& .T. to print in the first whole band of a new page
		*p: lprintonnewpage		&& .T. to print when the detail band overflows to a new page
		*p: lprintrepeats		&& .T. to print repeated values
		*p: lremoved		&& Shows that object removed from report because of blank line
		*p: lremovelineifblank		&& .T. to remove a line if there are no objects on it
		*p: lstretch		&& .T. if the object can stretch
		*p: lstretched		&& Indicates that object is already stretched
		*p: ltransparent		&& .T. if the object is transparent, .F. for opaque
		*p: nalignment		&& The alignment for the word object: "left", "center", or "right"
		*p: nbackcolor		&& The object's background color (-1 = default)
		*p: nbottomdelta
		*p: nfloat		&& 1 if the object should float in its band, 2 if it should be positioned relative to the top of the band, or 3 if it should be relative to the bottom of the band
		*p: nforecolor		&& The object's foreground color (-1 = default)
		*p: nheight		&& The height of the object
		*p: nhposition		&& The horizontal position for the object
		*p: nmltbandobjapndheight
		*p: nmltbandobjsuffixheight
		*p: nmltbandobjtype
		*p: nmltbandobjvposition
		*p: nmovedelta		&& Move Delta
		*p: nnewheight		&& Original Height of stretched object (as it is)
		*p: noriginalheight		&& Original height of the overed object
		*p: noveredmovedelta
		*p: noveredsurdelta		&& Additional SurDelt value for Stretched & Overed object
		*p: noveredvpositiondelta
		*p: nprintongroupchange		&& The group number if this object should print on a group change
		*p: nremovedelta
		*p: nstretchedheight		&& The height of the stretched object
		*p: nsurbottomdelta
		*p: nsurbottomposition
		*p: nsurdelta
		*p: nvposition		&& The vertical position for the object relative to the top of the band
		*p: nwidth		&& The width of the object
		*a: ablankobjects[1,0]
		*a: aformlinkparameters[1,2]
		*a: aremoveobjects[1,0]
		*a: areportlinkparameters[1,2]
		*a: asurrounders[1,0]
		*a: aupremoveobjects[1,0]
	*</DefinedPropArrayMethod>

	*<PropValue>
		cboundeddatafield = 
		ccomment = 
		chyperlink = 
		clineperobject = 
		cprintwhen = 
		creportlink = 
		creportobjectname = 
		ldontprint = .T.
		lprintinfirstwholeband = .F.
		lprintonnewpage = .F.
		lprintrepeats = .T.
		lremovelineifblank = .F.
		lstretch = .F.
		ltransparent = .T.
		nalignment = 0
		Name = "anyobject"
		nbackcolor = -1
		nbottomdelta = 0
		nfloat = 1
		nforecolor = -1
		nheight = 0
		nhposition = 0
		nmltbandobjapndheight = 0
		nmltbandobjsuffixheight = 0
		nmltbandobjtype = -1
		nmltbandobjvposition = 0
		nmovedelta = 0
		nnewheight = 0
		noriginalheight = 0
		noveredmovedelta = 0
		noveredsurdelta = 0
		noveredvpositiondelta = 0
		nprintongroupchange = 0
		nremovedelta = 0
		nstretchedheight = 0
		nsurbottomdelta = 0
		nsurbottomposition = 0
		nsurdelta = 0
		nvposition = 0
		nwidth = 0
	*</PropValue>
	
	PROCEDURE cprintwhen_assign
		PARAMETER tcValue
		
		IF VARTYPE(tcValue) = 'C'
			THIS.cPrintWhen = tcValue
		ENDIF 
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS toReport
		
		WITH THIS
			DIMENSION .aSurrounders[1]
			.aSurrounders = .NULL.
			
			DIMENSION .aRemoveObjects[1]
			.aRemoveObjects = .NULL.
			
			DIMENSION .aBlankObjects[1]
			.aBlankObjects = .NULL.
		
			DIMENSION .aUpRemoveObjects[1]
			.aUpRemoveObjects = .NULL.
		
		ENDWITH	
		
		DODEFAULT()
	ENDPROC

	PROCEDURE lprintinfirstwholeband_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lPrintInFirstWholeBand = tlValue
		ENDIF 
		
	ENDPROC

	PROCEDURE lprintonnewpage_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lPrintOnNewPage = tlValue
		ENDIF
		
	ENDPROC

	PROCEDURE lprintrepeats_assign
		LPARAMETER tlValue
		
		
		WITH THIS
		
			IF VARTYPE(tlValue) = 'L'
		
				.lPrintRepeats = tlValue
		
				IF tlValue
					.lPrintInFirstWholeBand = .T.
					.nPrintOnGroupChange    = 0
					.lPrintOnNewPage        = .F.
				ENDIF tlValue
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE lremovelineifblank_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lRemoveLineIfBlank = tlValue
		ENDIF 
		
	ENDPROC

	PROCEDURE lstretch_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lStretch = tlValue
		ENDIF
		
	ENDPROC

	PROCEDURE ltransparent_assign
		LPARAMETER tlValue
		
		IF VARTYPE(tlValue) = 'L'
			THIS.lTransparent = tlValue
		ENDIF 
		
	ENDPROC

	PROCEDURE nalignment_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE VARTYPE(tnValue) <> 'N'
			OTHERWISE
				THIS.nAlignment = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE nbackcolor_assign
		LPARAMETER tnValue
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE NOT BETWEEN(tnValue, -1, RGB(255, 255, 255))
			OTHERWISE
				THIS.nBackColor = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE nfloat_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE NOT BETWEEN(tnValue, 1, 3)
			OTHERWISE
				THIS.nFloat = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE nforecolor_assign
		LPARAMETER tnValue
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE NOT BETWEEN(tnValue, -1, RGB(255, 255, 255))
			OTHERWISE
				THIS.nForeColor = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE nheight_assign
		LPARAMETER tnValue
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			OTHERWISE
				THIS.nHeight = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE nhposition_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE NOT BETWEEN(tnValue, 0, 99999)
			OTHERWISE
				THIS.nHPosition = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE noveredsurdelta_assign
		LPARAMETERS vNewVal
		THIS.noveredsurdelta = m.vNewVal
		
	ENDPROC

	PROCEDURE nprintongroupchange_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE NOT BETWEEN(tnValue, 0, 99)
			OTHERWISE
				THIS.nPrintOnGroupChange = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE nstretchedheight_assign
		LPARAMETERS vNewVal
		THIS.nstretchedheight = m.vNewVal
		
	ENDPROC

	PROCEDURE nvposition_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			OTHERWISE
				THIS.nVPosition = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE nwidth_assign
		LPARAMETER tnValue
		
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			CASE NOT BETWEEN(tnValue, 0, 99999)
			OTHERWISE
				THIS.nWidth = tnValue
		ENDCASE
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anyprinter AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: _about
		*m: _buf2dword
		*m: _getdefaultprintername
		*m: _getphysicalheight		&& Return physical height o the page in device units.
		*m: _getphysicaloffsetx		&& Return distance from the left edge of the physical page to the left edge of the printable area, in device units.
		*m: _getphysicaloffsety		&& Return distance from the top edge of the physical page to the top edge of the printable area, in device units.
		*m: _getphysicalwidth		&& Return width of the physical page, in device units.
		*m: _getprintableheight
		*m: _getscalingfactorx		&& Return scaling factor for the x-axis of the printer.
		*m: _getscalingfactory		&& Return scaling factor for the y-axis of the printer.
		*m: _getstring
		*m: _hdc_assign
		*m: _num2dword
		*m: _num2word
		*p: _hdc		&& The device context for the selected printer
		*p: _nphysicaloffsetx		&& Printer Pageoffset
		*p: _nphysicaloffsety		&& Printer Pageoffset
	*</DefinedPropArrayMethod>

	*<PropValue>
		Height = 14
		Name = "anyprinter"
		Width = 22
		_hdc = 0
		_nphysicaloffsetx = 0
		_nphysicaloffsety = 0
	*</PropValue>
	
	PROCEDURE Destroy
		DECLARE INTEGER DeleteDC IN Win32API INTEGER hdc
		DeleteDC(this._hDC)
		
		
		
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tlShowDialog
		
		DECLARE INTEGER CreateDC IN Win32API AS CreatePrinterDC STRING, STRING, STRING, STRING
		
		LOCAL lcPrinter
		LOCAL lcLastOnError
		LOCAL lcDriver
		
		LOCAL llError
		
		LOCAL loForm
		
		THIS._hDC = 0
		
		IF tlShowDialog
		
			loForm = CREATEOBJECT('BaseForm')
			loForm.ADDOBJECT('oDialog', 'BaseCommonDialogBox')
		
			lcLastOnError = ON("ERROR")
		
			IF !ISNULL(loForm) AND !ISNULL(loForm.oDialog)
		
				WITH loForm.oDialog
					.CancelError = .T.
		
					ON ERROR llError = .T.
		
		*-- Get printer hDC
					.Flags = 0x100
		
					.ShowPrinter()
		
					THIS._hDC = IIF(llError, 0, .hDC)
				ENDWITH
		
			ENDIF
		
			ON ERROR &lcLastOnError
		ELSE
		*-- Better to use native VFP command	
			lcPrinter = SET('PRINTER', 3)
		*-- This function was developed in order to avoid error message from DLL 	
		
			IF '5.0' $ OS()
		*-- If the OS is 5.0, the driver is either DISPLAY or WINSPOOL
				lcDriver = 'WINSPOOL'
			ELSE
		*-- If the OS is Windows 9x, the driver is NULL
				lcDriver = NULL
			ENDIF
		
			IF !EMPTY(lcPrinter)
				THIS._hDC = INT(CreatePrinterDC(lcDriver, lcPrinter, NULL, NULL))
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE _about
	ENDPROC

	PROCEDURE _buf2dword
		LPARAMETER tcBuffer
		
		LOCAL lnReturn
		
		lnReturn = ASC(SUBSTR(tcBuffer, 1,1)) + ASC(SUBSTR(tcBuffer, 2,1)) * 256 + ASC(SUBSTR(tcBuffer, 3,1)) * 65536 + ASC(SUBSTR(tcBuffer, 4,1)) * 16777216
		
		RETURN lnReturn
		
	ENDPROC

	PROCEDURE _getdefaultprintername
		LOCAL lcBuffer
		LOCAL lcPrinterName
		LOCAL lcSubStr
		LOCAL lcVersion
		LOCAL lcReturnedString
		
		LOCAL lnNeeded
		LOCAL lnReturned
		LOCAL lnCount
		LOCAL lnAddressName
		LOCAL lnVersion
		LOCAL lnSize
		LOCAL lnResult
		LOCAL lnPos
		
		lcPrinterName = ''
		
		lcVersion = OS()
		
		IF '5.0' $ lcVersion
		*-- OS is Windows NT/2000/XP
			lnVersion = VAL(SUBSTR(lcVersion, AT('5', lcVersion), 4))
		
			IF 	lnVersion >= 5
		*-- OS is Windows 2000 or later
				DECLARE INTEGER GetDefaultPrinter IN WinSpool.drv STRING @lpReturnedString, INTEGER @lpnSize
		
				lnSize 			 = 4096
				lcReturnedString = REPLICATE(CHR(0), lnSize)
				lnResult 		 = GetDefaultPrinter(@lcReturnedString, @lnSize)
		
				lnPos    		 = AT(CHR(0), lcReturnedString) - 1
		
				IF lnPos > 0
					lcPrinterName = SUBSTR(lcReturnedString, 1, lnPos)
				ENDIF
		
			ELSE
		*-- OS is Windows NT 4.0 or earlier
				DECLARE INTEGER GetProfileString IN kernel32 STRING pAppName, STRING lpKeyName, STRING lpDefault, STRING @lpReturnedString, INTEGER nSize
		
				lnSize 			 = 4096
				lcReturnedString = REPLICATE(CHR(0), lnSize)
				lnResult 		 = GetProfileString('windows', 'device', '#empty#', @lcReturnedString, lnSize)
		
				lnPos			 = AT(',', lcReturnedString) - 1
		
				IF lnPos > 0
					lcPrinterName = LEFT(lcReturnedString, lnPos)
				ENDIF
			ENDIF
		ELSE
		*-- OS is Windows 9x/ME
			DECLARE INTEGER EnumPrinters IN WinSpool.drv INTEGER Flags, INTEGER NAME, INTEGER LEVEL, STRING @pPrinterEnum, INTEGER cbBuf,;
				INTEGER @pcbNeeded, INTEGER @pcReturned
		
			lnNeeded   = 0
			lnReturned = 0
		
			lnResult   = EnumPrinters(cnPRINTER_ENUM_DEFAULT, 0, 1, NULL, 0, @lnNeeded, @lnReturned)
		
			IF lnNeeded # 0
				lcBuffer = REPLICATE(CHR(0),lnNeeded)
				lnResult = EnumPrinters(cnPRINTER_ENUM_DEFAULT, 0, 1, @lcBuffer, lnNeeded, @lnNeeded, @lnReturned)
		
		*-- Will take only first Default Printer
				lnReturned = IIF(lnReturned > 1, 1, lnReturned)
		
				FOR lnCount = 1 TO lnReturned
					lcSubStr      = SUBSTR(lcBuffer, (lnCount - 1) * 16 + 1, 16)
		
					lnAddressName = THIS._Buf2DWORD(SUBSTR(lcSubStr, 9, 4))
					lcPrinterName = THIS._GetString(lnAddressName)
				ENDFOR
			ENDIF
		ENDIF
		
		RETURN lcPrinterName
		
		
		
		
	ENDPROC

	PROCEDURE _getphysicalheight		&& Return physical height o the page in device units.
		IF THIS._hDC # 0
			DECLARE INTEGER GetDeviceCaps IN Win32API INTEGER hDC, INTEGER nIndex
		
			RETURN GetDeviceCaps(THIS._hDC, cnPHYSICALHEIGHT)
		ELSE
			RETURN 0
		ENDIF	
		
	ENDPROC

	PROCEDURE _getphysicaloffsetx		&& Return distance from the left edge of the physical page to the left edge of the printable area, in device units.
		IF THIS._hDC # 0
			DECLARE INTEGER GetDeviceCaps IN Win32API INTEGER hDC, INTEGER nIndex
		
			RETURN GetDeviceCaps(THIS._hDC, cnPHYSICALOFFSETX)
		ELSE
			RETURN 0
		ENDIF
		
	ENDPROC

	PROCEDURE _getphysicaloffsety		&& Return distance from the top edge of the physical page to the top edge of the printable area, in device units.
		IF THIS._hDC # 0
			DECLARE INTEGER GetDeviceCaps IN Win32API INTEGER hDC, INTEGER nIndex
		
			RETURN GetDeviceCaps(THIS._hDC, cnPHYSICALOFFSETY)
		
		ELSE
			RETURN 0
		ENDIF
		
	ENDPROC

	PROCEDURE _getphysicalwidth		&& Return width of the physical page, in device units.
		IF THIS._hDC # 0
			DECLARE INTEGER GetDeviceCaps IN Win32API INTEGER hDC, INTEGER nIndex
		
			RETURN GetDeviceCaps(THIS._hDC, cnPHYSICALWIDTH)
		ELSE
			RETURN 0
		ENDIF
		
	ENDPROC

	PROCEDURE _getprintableheight
		IF THIS._hDC # 0
			DECLARE INTEGER GetDeviceCaps IN Win32API INTEGER hDC, INTEGER nIndex
		
			RETURN GetDeviceCaps(THIS._hDC, cnVERTRES)
		ELSE
			RETURN 0
		ENDIF	
		
	ENDPROC

	PROCEDURE _getscalingfactorx		&& Return scaling factor for the x-axis of the printer.
	ENDPROC

	PROCEDURE _getscalingfactory		&& Return scaling factor for the y-axis of the printer.
	ENDPROC

	PROCEDURE _getstring
		LPARAMETER tnMemoryAddress
		
		DECLARE RtlMoveMemory IN kernel32 AS CopyMemory STRING @, INTEGER, INTEGER
		DECLARE SHORT StrTrim IN Shlwapi  AS StrTrim STRING @, STRING
		
		LOCAL lcBuffer
		
		lcBuffer = REPLICATE(CHR(0), 1024)
		
		=CopyMemory(@lcBuffer, tnMemoryAddress, LEN(lcBuffer))
		=StrTrim (@lcBuffer, CHR(0))
		
		IF AT(CHR(0), lcBuffer) <> 0
			lcBuffer = SUBSTR(lcBuffer, 1, AT(CHR(0), lcBuffer) - 1)
		ENDIF
		
		RETURN lcBuffer
		
	ENDPROC

	PROCEDURE _hdc_assign
		LPARAMETERS vNewVal
		THIS._hdc = m.vNewVal
		
	ENDPROC

	PROCEDURE _num2dword
		LPARAMETER tnValue
		
		LOCAL lnFirstQuota
		LOCAL lnSecondQuota
		LOCAL lnThirdQuota
		LOCAL lnForthQuota
		
		lnForthQuota = INT(tnValue/16777216)
		lnThirdQuota = INT((tnValue - lnForthQuota*16777216)/65536)
		lnSecondQuota = INT((tnValue - lnForthQuota*16777216 - lnThirdQuota*65536)/256)
		lnFirstQuota = MOD(tnValue, 256)
		
		RETURN CHR(lnFirstQuota)+CHR(lnSecondQuota)+CHR(lnThirdQuota)+CHR(lnForthQuota)
		
	ENDPROC

	PROCEDURE _num2word
		LPARAMETER tnValue
		
		RETURN CHR(MOD(tnValue,256)) + CHR(INT(tnValue/256))
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anyrecord AS anycustom OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*p: cobjectid
		*p: nobjecttype		&& The object type code
	*</DefinedPropArrayMethod>

	*<PropValue>
		cobjectid = 
		Name = "anyrecord"
		nobjecttype = 0
	*</PropValue>
	
	PROCEDURE Init
		THIS.cObjectID = SYS(2015)
	ENDPROC

ENDDEFINE

DEFINE CLASS anyrelation AS anyrecord OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: setrelationproperties
		*p: cchildalias
		*p: cchildorder
		*p: cclassname
		*p: ccomment
		*p: cname
		*p: cparentalias
		*p: cprocedures
		*p: crelationalexpr
		*p: ctag
		*p: lonetomany
		*p: oreport
	*</DefinedPropArrayMethod>

	PROTECTED oreport
	*<PropValue>
		cchildalias = 
		cchildorder = 
		cclassname = 
		ccomment = 
		cname = 
		cparentalias = 
		cprocedures = 
		crelationalexpr = 
		ctag = 
		Name = "anyrelation"
		nobjecttype = 26
		oreport = .NULL.
	*</PropValue>
	
	PROCEDURE Init
		LPARAMETERS toReport
		
		DODEFAULT()
		
		WITH THIS
			.oReport    = toReport
			.cClassName = SYS(2015)
		ENDWITH
		
		
	ENDPROC

	PROCEDURE setrelationproperties
		LPARAMETERS toReportRecord
		
		LOCAL lnCount
		LOCAL lnMemoLines
		LOCAL lnOldMemoWidth
		
		LOCAL lcMemoLine
		LOCAL lcExtractedValue
		
		
		WITH THIS
		
			.cProcedures = toReportRecord.TAG
		
			lnMemoLines = MEMLINES(toReportRecord.EXPR)
		
		
			lnOldMemoWidth = SET('MEMOWIDTH')
			SET MEMOWIDTH TO 500
		
		
		
			FOR lnCount = 1 TO lnMemoLines
		
				lcMemoLine       = MLINE(toReportRecord.EXPR, lnCount)
				lcExtractedValue = .oReport.ExtractValue(lcMemoLine)
		
				DO CASE
					CASE ATC('RelationalExpr =', lcMemoLine) > 0
						.cRelationalExpr = lcExtractedValue
		
					CASE ATC('ParentAlias =', lcMemoLine) > 0
						.cParentAlias = lcExtractedValue
		
					CASE ATC('ChildAlias =', lcMemoLine) > 0
						.cChildAlias = lcExtractedValue
		
					CASE ATC('Name =', lcMemoLine) > 0
						.cName = lcExtractedValue
		
					CASE ATC('Comment =', lcMemoLine) > 0
						.cComment = lcExtractedValue
		
					CASE ATC('ChildOrder =', lcMemoLine) > 0
						.cChildOrder = lcExtractedValue
		
					CASE ATC('Tag =', lcMemoLine) > 0
						.cTag = lcExtractedValue
		
					CASE ATC('OneToMany =', lcMemoLine) > 0
						.lOneToMany = lcExtractedValue
		
				ENDCASE
		
			ENDFOR
		
		
			SET MEMOWIDTH TO lnOldMemoWidth
		
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anyshape AS anyobject OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: nbordersite_assign
		*m: nfillpat_assign
		*m: npenpattern_assign
		*m: npensize_assign
		*p: nbordersite
		*p: nfillpat
		*p: npenpattern		&& The pen pattern for the object: 0 = none, 1 = dotted, 2 = dashed, 3 = dash-dot, 4 = dash-dot-dot, 8 = normal
		*p: npensize		&& The pen size for the line: 0, 1, 2, 4, or 6
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "anyshape"
		nbordersite = 15
		nfillpat = 0
		nheight = 0
		npenpattern = 8
		npensize = 1
	*</PropValue>
	
	PROCEDURE nbordersite_assign
		LPARAMETERS vNewVal
		THIS.nBorderSite = m.vNewVal
		
	ENDPROC

	PROCEDURE nfillpat_assign
		LPARAMETER tnValue
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			OTHERWISE
				THIS.nFillPat = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE nforecolor_assign
		*--If the value was saved, update nBackColor to the same color.
		LPARAMETERS tnValue
		
		DODEFAULT(tnValue)
		IF VARTYPE(tnValue) $ 'NFIBY' AND THIS.nForeColor = tnValue
			THIS.nBackColor = tnValue
		ENDIF VARTYPE(tnValue) $ 'NFIBY' ...
		
	ENDPROC

	PROCEDURE npenpattern_assign
		*-- Ensure the pen pattern value is valid.
		LPARAMETER tnValue
		DO CASE
		CASE NOT VARTYPE(tnValue) $ 'NFIBY'
		CASE NOT BETWEEN(tnValue, 0, 4) AND tnValue <> 8
		OTHERWISE
			THIS.nPenPattern = tnValue
		ENDCASE
		
	ENDPROC

	PROCEDURE npensize_assign
		*-- Ensure the pen size value is valid.
		LPARAMETER tnValue
		DO CASE
			CASE NOT VARTYPE(tnValue) $ 'NFIBY'
			OTHERWISE
				THIS.nPenSize = tnValue
		ENDCASE
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anyvariable AS anyrecord OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: cname_assign
		*m: lpredefinedvariable_assign
		*m: lreleaseatend_assign
		*m: nresetat_assign
		*m: ntotaltype_assign
		*m: setvariableproperties
		*m: uinitialvalue_assign
		*m: uvaluetostore_assign
		*p: cname
		*p: lpredefinedvariable		&& Shows if Variable is already defined
		*p: lreleaseatend
		*p: lsomthingwrong
		*p: naveragevalue		&& Average value accumulator
		*p: ncalculatedvalue
		*p: ndivider		&& Use in Average calculation
		*p: nresetat
		*p: ntotaltype
		*p: oreport
		*p: uinitialvalue
		*p: uvaluetostore
	*</DefinedPropArrayMethod>

	PROTECTED lsomthingwrong
	*<PropValue>
		cname = 
		Name = "anyvariable"
		naveragevalue = 0
		ncalculatedvalue = 0
		ndivider = 1
		nobjecttype = 18
		nresetat = 0
		ntotaltype = 0
		oreport = .NULL.
		uinitialvalue = 0
		uvaluetostore = 0
	*</PropValue>
	
	PROCEDURE cname_assign
		LPARAMETERS vNewVal
		THIS.cname = m.vNewVal
		
	ENDPROC

	PROCEDURE Error
		LPARAMETERS tnError, tcMethod, tnLine
		
		DO CASE
			CASE tnError = 12
				THIS.lSomthingWrong = .T.
		ENDCASE
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS toReport
		
		DODEFAULT()
		
		WITH THIS
			.oReport = toReport
		ENDWITH
		
	ENDPROC

	PROCEDURE lpredefinedvariable_assign
		LPARAMETERS vNewVal
		THIS.lPreDefinedVariable = m.vNewVal
		
	ENDPROC

	PROCEDURE lreleaseatend_assign
		LPARAMETERS vNewVal
		THIS.lReleaseAtEnd = m.vNewVal
		
	ENDPROC

	PROCEDURE nresetat_assign
		LPARAMETERS vNewVal
		THIS.nresetat = m.vNewVal
		
	ENDPROC

	PROCEDURE ntotaltype_assign
		LPARAMETERS vNewVal
		THIS.ntotaltype = m.vNewVal
		
	ENDPROC

	PROCEDURE setvariableproperties
		LPARAMETER toReportRecord
		
		LOCAL lcOldErrorHandler
		
		LOCAL llSomthingWrong
		
		LOCAL luEvaluatedValue
		
		WITH THIS
		
			.cName 			= toReportRecord.NAME
			.uValueToStore 	= toReportRecord.EXPR
			.uInitialValue 	= toReportRecord.TAG
			.lReleaseAtEnd 	= toReportRecord.UNIQUE
			.nTotalType 	= toReportRecord.TotalType
			.nResetAt 		= toReportRecord.ResetTotal - cnGROUP_OFFSET + 1
		
		*-- Declaire Report variable as Global
			IF !EMPTY(.cName)
		
				.lSomthingWrong = .F.	
			
				luEvaluatedValue = EVAL(.cName)
		
				IF .lSomthingWrong
					PUBLIC (.cName)	
					
					.lPreDefinedVariable = .F.
				ELSE
					.lPreDefinedVariable = .T.			
				ENDIF
				
			ENDIF
			
		ENDWITH
		
		
		
		
	ENDPROC

	PROCEDURE uinitialvalue_assign
		LPARAMETERS vNewVal
		THIS.uinitialvalue = m.vNewVal
		
	ENDPROC

	PROCEDURE uvaluetostore_assign
		LPARAMETERS vNewVal
		THIS.uvaluetostore = m.vNewVal
		
	ENDPROC

	PROCEDURE _releasemembers
		WITH THIS
		*-- Release Report Global variable 
			IF !EMPTY(.cName) AND !.lPreDefinedVariable
				RELEASE (.cName)	
			ENDIF
		ENDWITH	
		
	ENDPROC

ENDDEFINE

