	PROCEDURE writechart
		LPARAMETERS tvChartNameOrChartObject, tnLeft, tnTop, tnWidth, tnHeight, tnCurrentPage
		
		LOCAL loChart
		
		LOCAL lnCount
		LOCAL lnHeightInPx
		LOCAL lnWidthInPx
		LOCAL lnPixelsPerPoint
		
		LOCAL lcContents
		
		lnPixelsPerPoint = 96/72
		
		
		WITH THIS
		
			DO CASE
				CASE VARTYPE(tvChartNameOrChartObject) = 'C'
					loChart = .GetChart(tvChartNameOrChartObject)
				CASE  VARTYPE(tvChartNameOrChartObject) = 'O'
					loChart = tvChartNameOrChartObject
				OTHERWISE
					loChart = .NULL.
			ENDCASE
		
			IF !ISNULL(loChart)
		
				DO CASE
		
					CASE INLIST(.nExportFileType, cnRTF, cnPDF, cnExcel, cnWord)
						lnHeightInPx = tnHeight * lnPixelsPerPoint
						lnWidthInPx  = tnWidth  * lnPixelsPerPoint
		
					OTHERWISE
						lnHeightInPx = tnHeight
						lnWidthInPx = tnWidth
		
				ENDCASE
		
		
				WITH loChart
		
					.cSaveFolder	 = ADDBS(SYS(2023))
					.cExportFileName = SYS(2015)
		
					.nImageFileType  = cnIMAGE_OUTPUT_FILE_FORMAT_PNG
		
					lcContents = FORCEEXT(.cSaveFolder + .cExportFileName, 'PNG')
		
					WITH .oPanel
						.nWidth  = lnWidthInPx
						.nHeight = lnHeightInPx
		
					ENDWITH
		
					.SAVE()
		
				ENDWITH
		
				DO CASE
					CASE INLIST(.nExportFileType, cnExcel)
						IF .nExcelOutPutType # cnEXCEL_OUTPUT_FULL_PLAIN
							.WriteImage(lcContents, tnTop, tnLeft, tnHeight, tnWidth, cnIMAGE_SCALE_STRETCH)
		
						ELSE
							.AddImageToCursor(tnCurrentPage, cnREPOBJ_IMAGE, lcContents, cnIMAGE_SOURCE_FILE, '', cnIMAGE_SCALE_STRETCH, ROUND(tnWidth, 5), ROUND(tnHeight, 5), ROUND(tnTop, 5), ROUND(tnLeft, 5))
		
						ENDIF
		
					CASE INLIST(.nExportFileType, cnRTF)
		
		
						IF .nRTFOutPutType # cnRTF_OUTPUT_PLAIN
							.WriteImage(lcContents, tnTop, tnLeft, tnHeight, tnWidth, cnIMAGE_SCALE_STRETCH)
		
						ELSE
							.AddImageToCursor(tnCurrentPage, cnREPOBJ_IMAGE, lcContents, cnIMAGE_SOURCE_FILE, '', cnIMAGE_SCALE_STRETCH, ROUND(tnWidth, 5), ROUND(tnHeight, 5), ROUND(tnTop, 5), ROUND(tnLeft, 5))
		
						ENDIF
		
					CASE INLIST(.nExportFileType, cnHTML, cnPDF, cnImage, cnWORD)
						.WriteImage(lcContents, tnTop, tnLeft, tnHeight, tnWidth, cnIMAGE_SCALE_STRETCH)
		
				ENDCASE
		
		
				IF INLIST(.nExportFileType, cnPDF, cnImage, cnWORD) OR ;
						(INLIST(.nExportFileType, cnExcel) AND .nExcelOutPutType # cnEXCEL_OUTPUT_FULL_PLAIN) OR ;
						(INLIST(.nExportFileType, cnRTF) AND .nRTFOutPutType # cnRTF_OUTPUT_PLAIN) ;
		
					ERASE (lcContents)
		
				ENDIF
		
			ENDIF
		ENDWITH
		
		RETURN lcContents
		
		
		
		
		
	ENDPROC

	PROCEDURE writeimage
		LPARAMETERS tcImageFileFullName, tnHeight, tnWidth, tnScalePicture, tlDontReturnResult
		
		LOCAL loDstBitmap
		LOCAL loCroppedBitmap
		LOCAL loCroppedPicture
		LOCAL loRectangle
		
		LOCAL lcFile
		LOCAL lcImage
		LOCAL lcStr
		
		LOCAL lnCount
		LOCAL lnSizeRate
		LOCAL lnHeightInPx
		LOCAL lnWidthInPx
		LOCAL lnPixelsPerPoint
		LOCAL lnPointsPerPixel
		LOCAL lnImageFileHandle
		LOCAL lnChar
		LOCAL lnCharFirstPart
		LOCAL lnCharSecondPart
		
		lnPixelsPerPoint = 96 / 72
		lnPointsPerPixel = 72 / 96
		
		lcImage = ""
		
		*-- Convert Points to Pixels
		DO CASE
			CASE INLIST(.nExportFileType, cnRTF, cnPDF, cnWord, cnEXCEL)
				lnHeightInPx = tnHeight*lnPixelsPerPoint
				lnWidthInPx = tnWidth*lnPixelsPerPoint
		
			OTHERWISE
		*-- HTML
				lnHeightInPx = tnHeight
				lnWidthInPx = tnWidth
		
		ENDCASE
		
		*-- Must check if Picture file exist and after do rest
		IF FILE(tcImageFileFullName) Then
		*-- Creating destination Bitmap object,
			loDstBitmap = NEWOBJECT(ccGDIPLUS_CLASS_BITMAP, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME, '', tcImageFileFullName)
		
			IF VARTYPE(loDstBitmap) == 'O'
		
		*-- Correct Width/Height according to the nScalePicture
				DO CASE
					CASE tnScalePicture = 1
		*-- Create the rectangle object for "ScalePictureRetainShape"
		
						lnSizeRate = MIN(lnHeightInPx / loDstBitmap.nImageHeight, lnWidthInPx / loDstBitmap.nImageWidth)
		
		
						lnHeightInPx = loDstBitmap.nImageHeight * lnSizeRate
						lnWidthInPx = loDstBitmap.nImageWidth * lnSizeRate
		
					CASE tnScalePicture = 0
		*-- Create the rectangle object for "ClipPicture"
		
						lnWidthInPx = IIF(lnWidthInPx > loDstBitmap.nImageWidth, loDstBitmap.nImageWidth, lnWidthInPx)
						lnHeightInPx = IIF(lnHeightInPx > loDstBitmap.nImageHeight, loDstBitmap.nImageHeight, lnHeightInPx)
		
					OTHERWISE
				ENDCASE
		
		*-- Return changed value of tnHeight and tnWidth
				DO CASE
					CASE INLIST(.nExportFileType, cnRTF, cnPDF, cnWord, cnEXCEL)
						tnHeight = lnHeightInPx * lnPointsPerPixel
						tnWidth  = lnWidthInPx * lnPointsPerPixel
		
					OTHERWISE
		*-- HTML
						tnHeight = lnHeightInPx
						tnWidth  = lnWidthInPx
		
				ENDCASE
		
		
		*-- Create a rectangle defined by the lnWidth and lnHeight
				loRectangle = NEWOBJECT(ccGDIPLUS_CLASS_RECT, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME, '', 0, 0, lnWidthInPx, lnHeightInPx)
		
		*-- Create a new (copy of original), Bitmap on which we will draw the cropped image.
				loCroppedBitmap = NEWOBJECT(ccGDIPLUS_CLASS_BITMAP, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME, '', lnWidthInPx, lnHeightInPx)
		
		*-- Get a Graphics object from the Bitmap for drawing.
				loCroppedPicture = NEWOBJECT(ccGDIPLUS_CLASS_GRAPHICS, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME)
				loCroppedPicture.CreateFromImage(loCroppedBitmap)
		
		*-- Draw the image on the Bitmap anchored at the upper left corner.
				IF tnScalePicture = 0
					loCroppedPicture.DrawImagePortionAt(loDstBitmap, 0, 0, loRectangle, cnGDIPLUS_Unit_Pixel)
				ELSE
					loCroppedPicture.DrawImageScaled(loDstBitmap, loRectangle)
				ENDIF
		
				loDstBitmap = .NULL.
		
		*-- Convert any kind of image into JPEG file
				IF tlDontReturnResult
					lcFile = FORCEEXT(tcImageFileFullName, '.PNG')
				ELSE
					lcFile = ADDBS(SYS(2023))+ SYS(2015)+ '.PNG'
				ENDIF
		
		
		*-- Save newly crated Image into file
				loCroppedBitmap.SaveToFile(lcFile)
		
		*-- 'Convert' JPEG file into string
				IF FILE(lcFile) AND !tlDontReturnResult
		
					lnImageFileHandle = FOPEN(lcFile, 10)
		
					DO WHILE !FEOF(lnImageFileHandle)
						lcStr = FREAD(lnImageFileHandle, 64)
		
		
						FOR lnCount = 1 TO LEN(lcStr)
		
							lnChar = ASC(SUBSTR(lcStr, lnCount, 1))
		
							lnCharFirstPart = INT(lnChar/16)
							lnCharSecondPart = MOD(lnChar, 16)
		
							IF lnCharFirstPart < 10
								lcImage = lcImage + ALLTRIM(STR(lnCharFirstPart))
							ELSE
								lnCharFirstPart = lnCharFirstPart - 10
								lcImage = lcImage + CHR(ASC('a') + lnCharFirstPart)
							ENDIF
		
							IF lnCharSecondPart<10
								lcImage = lcImage + ALLTRIM(STR(lnCharSecondPart))
							ELSE
								lnCharSecondPart = lnCharSecondPart - 10
								lcImage = lcImage + CHR(ASC('a')+lnCharSecondPart)
							ENDIF
						ENDFOR
		
					ENDDO
		
					= FCLOSE(lnImageFileHandle)
		
					ERASE (lcFile)
		
				ENDIF
		
			ENDIF
		
		ENDIF
		
		RETURN lcImage
		
		
		
	ENDPROC

