	PROTECTED PROCEDURE checklicense
		LPARAMETERS tcReportFullName
		
		LOCAL lcExportFileExt
		LOCAL lcExportFile
		LOCAL lcDefaultPath
		
		WITH THIS
		
			.cExportFileName = IIF(EMPTY(.cExportFileName), IIF(EMPTY(tcReportFullName), SYS(2015), JUSTSTEM(tcReportFullName)), ALLTRIM(.cExportFileName))
		
			lcDefaultPath    = JUSTPATH(SYS(16, 1))
			.cSaveFolder	 = IIF(EMPTY(.cSaveFolder), IIF(!EMPTY(tcReportFullName), ADDBS(JUSTPATH(tcReportFullName)), ADDBS(lcDefaultPath)), ADDBS(ALLTRIM(.cSaveFolder)))
		
			DO CASE
				CASE .nExportFileType = cnHTML
		
					IF .lEmbedImage
						lcExportFileExt = ccMHT_EXT
					ELSE
						lcExportFileExt = ccHTML_EXT
					ENDIF
		
				CASE .nExportFileType = cnWORD
					lcExportFileExt = ccWORD_EXT
		
				CASE .nExportFileType = cnRTF
					lcExportFileExt = ccRTF_EXT
		
				CASE .nExportFileType = cnEXCEL
		
					IF .nExcelOutPutType = cnEXCEL_OUTPUT_XMLSPREADSHEET
		*-- In this case we don't need Excel object
						lcExportFileExt = ccXML_EXT
					ELSE
						lcExportFileExt = ccEXCEL_EXT
					ENDIF
		
				CASE .nExportFileType = cnPREVIEW
					lcExportFileExt = ccPREVIEW_EXT
		
				CASE .nExportFileType = cnPDF
					lcExportFileExt = ccPDF_EXT
		
				CASE .nExportFileType = cnXML
					lcExportFileExt = ccXML_EXT
					
				CASE .nExportFileType = cnIMAGE
					lcExportFileExt = .cImageFileExt
					
				CASE .nExportFileType = cnCHART
					lcExportFileExt = .cImageFileExt
		
			ENDCASE
		
			lcExportFile       = .cSaveFolder + .cExportFileName + '.' + lcExportFileExt
		
			IF .nExportFileType # cnIMAGE
		*-- We don't need to create file (place holder) for image output, because it is multi files output 	
				.nHandleExportFile = FCREATE(lcExportFile)
			ENDIF	
		ENDWITH
		
	ENDPROC

