	PROTECTED PROCEDURE npage_assign
		LPARAMETERS tnPage
		
		WITH THIS 
		
			IF .nPage < tnPage
				.ResetCalculations(cnRESET_ON_PAGE)
			ENDIF
		
			.nPage  = tnPage
		
			IF !.lFirstpass AND .lResetablePageNumber
			
				IF .lResetPageNumber
					_PAGENO = 1
				ELSE
					_PAGENO = _PAGENO + 1		
				ENDIF	
				
			ELSE
				_PAGENO = tnPage
			ENDIF	
		
		
		ENDWITH
		
	ENDPROC

