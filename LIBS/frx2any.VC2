	PROTECTED PROCEDURE _releasemembers
		*-- Release member objects.
		LOCAL lnCount
		
		WITH THIS
		
			IF VARTYPE(.oDataEnvironment) = 'O'
				.oDataEnvironment._Release()
			ENDIF
		
			IF VARTYPE(.oTitleBand) = 'O'
				.oTitleBand._Release()
			ENDIF
		
			IF VARTYPE(.oPageHeaderBand) = 'O'
				.oPageHeaderBand._Release()
			ENDIF
		
			IF VARTYPE(.oPageFooterBand) = 'O'
				.oPageFooterBand._Release()
			ENDIF
		
			IF VARTYPE(.oDetailBand) = 'O'
				.oDetailBand._Release()
			ENDIF
		
			IF VARTYPE(.oSummaryBand) = 'O'
				.oSummaryBand._Release()
			ENDIF
		
			FOR lnCount = 1 TO ALEN(.aGroupbands, 1)
				IF VARTYPE(.aGroupbands[lnCount, 1]) = 'O'
					.aGroupbands[lnCount, 1]._Release()
				ENDIF
				IF VARTYPE(.aGroupbands[lnCount, 2]) = 'O'
					.aGroupbands[lnCount, 2]._Release()
				ENDIF
				
			NEXT lnCount
		
			FOR lnCount = 1 TO ALEN(.aVariables)
				IF VARTYPE(.aVariables[lnCount]) = 'O'
					.aVariables[lnCount]._Release()
				ENDIF
			NEXT lnCount
			
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anyimage AS anyobject OF "frx2any.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: cimagesource_assign
		*m: limagefile_assign
		*m: ncolortobetransparent_assign
		*m: nstretch_assign
		*p: cimagesource		&& The name of the image file or General field that's the source for the image
		*p: limagefile		&& .T. if the image comes from a file; .F. if it comes from a General field
		*p: ncolortobetransparent
		*p: nimagesourcetype		&& Shows type of the Image source
		*p: nstretch		&& How to scale the image: 0 = clip, 1 = isometric, 2 = stretch
	*</DefinedPropArrayMethod>

	*<PropValue>
		cimagesource = 
		limagefile = .T.
		Name = "anyimage"
		ncolortobetransparent = (RGB(255,255,255))
		nimagesourcetype = 0
		nobjecttype = 17
		nstretch = 0
	*</PropValue>
	
	PROCEDURE cimagesource_assign
		LPARAMETER tcImageSource
		
		IF VARTYPE(tcImageSource) = 'C'
			THIS.cImageSource = tcImageSource
		ENDIF 
		
	ENDPROC

	PROCEDURE limagefile_assign
		LPARAMETER tlImageFile
		
		IF VARTYPE(tlImageFile) = 'L'
			THIS.lImageFile = tlImageFile
		ENDIF 
		
	ENDPROC

	PROCEDURE ncolortobetransparent_assign
		LPARAMETER tnColorToBeTransparent
		
		DO CASE
			CASE !VARTYPE(tnColorToBeTransparent) $ 'NFIBY'
			CASE tnColorToBeTransparent < 0
			OTHERWISE
				THIS.tnColorToBeTransparent = tnColorToBeTransparent
		ENDCASE
		
	ENDPROC

	PROCEDURE nstretch_assign
		LPARAMETER tnStretch
		
		DO CASE
			CASE !VARTYPE(tnStretch) $ 'NFIBY'
			CASE !BETWEEN(tnStretch, 0, 2)
			OTHERWISE
				THIS.nStretch = tnStretch
		ENDCASE
		
	ENDPROC

ENDDEFINE

DEFINE CLASS anyline AS anyshape OF "frx2any.vcx" 
