	PROTECTED PROCEDURE getbmpfromgenfield
		LPARAMETERS tcGenFldName, tcImageFileName
		
		LOCAL lnFileLen
		
		LOCAL lcTmpFile
		LOCAL lcBmpFile
		LOCAL lcString
		LOCAL lcOldSafety
		
		
		lcOldSafety = SET('SAFETY')
		SET SAFETY OFF
		
		lcTmpFile = ADDBS(SYS(2023)) + SYS(2015)
		
		IF !EMPTY(tcImageFileName)
			lcBmpFile  = tcImageFileName
		ELSE
			lcBmpFile = ADDBS(THIS.cSaveFolder) + SYS(2015) + '.BMP'
		ENDIF
		
		COPY TO (lcTmpFile) FIELDS (tcGenFldName) NEXT 1
		
		lcString  = FILETOSTR(lcTmpFile + '.FPT')
		lcString  = RIGHT(lcString, LEN(lcString) - 599)
		
		IF FILE(lcTmpFile + '.FPT')
			DELETE FILE (lcTmpFile + '.*')
		ENDIF
		
		IF !EMPTY(lcString)
			lnFileLen = STRTOFILE(lcString, lcBmpFile)
		ELSE
		*-- No Image in General field
			lcBmpFile = ''
		ENDIF
		
		
		SET SAFETY &lcOldSafety
		
		RETURN lcBmpFile
		
	ENDPROC

