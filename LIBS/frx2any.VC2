	PROTECTED PROCEDURE gethfactor		&& Calculates the horizontal factor for the specified font
		LPARAMETERS toObject, tcChar, tcStyle
		
		LOCAL lnMax
		LOCAL lnAvg
		LOCAL lnFactor
		LOCAL lnFontSize
		
		LOCAL lcStyle
		LOCAL lcFontName
		
		*-- Use default report font
		lcFontName = IIF(!EMPTY(toObject.cFontName), toObject.cFontName, THIS.cFontName)
		lnFontSize = toObject.nFontSize
		
		lnMax    = FONTMETRIC(7, lcFontName, lnFontSize, tcStyle)
		lnAvg    = FONTMETRIC(6, lcFontName, lnFontSize, tcStyle)
		
		lcStyle  = IIF(TYPE('lcStyle') = 'L', 'N', lcStyle)
		
		IF lnMax - lnAvg => 1
			DO CASE
				CASE TYPE('tcChar') = 'L'
					lnFactor = TXTWIDTH(ccAVG_CHAR, lcFontName, lnFontSize, tcStyle) * lnAvg
				OTHERWISE
					lnFactor = TXTWIDTH(tcChar, lcFontName, lnFontSize, tcStyle) * lnAvg
			ENDCASE
		ELSE
			lnFactor = lnMax
		ENDIF
		
		RETURN lnFactor
		
	ENDPROC

	PROTECTED PROCEDURE gethvalue		&& Calculates a horizontal value in the pixels
		LPARAMETERS tcValue, toObject
		
		LOCAL loObject
		LOCAL loFont
		LOCAL loGraphics
		LOCAL loLayoutArea
		LOCAL loSizeF
		LOCAL loStringFormat
		
		LOCAL lnValue
		LOCAL lnCount
		LOCAL lnLenString
		LOCAL lnMax
		LOCAL lnAvg
		LOCAL lnCharWidth
		
		LOCAL lnFontStyle
		LOCAL lnHWND
		LOCAL lnHeight
		LOCAL lnCharsFitted
		LOCAL lnLinesFilled
		
		LOCAL lnhFont
		LOCAL lnhFontOld
		LOCAL lnHDC
		
		LOCAL lcChar
		LOCAL lcStyle
		LOCAL lcBuffer
		LOCAL lcAvgBuffer
		
		
		lnLenString = LEN(tcValue)
		loObject    = IIF(TYPE('toObject.cFontName') = 'C' AND !EMPTY(toObject.cFontName) AND toObject.nFontSize > 0, toObject, THIS)
		
		lnValue     = 0
		
		lcStyle     = ''
		lcStyle     = IIF(loObject.lFontBold, 'B', '') + IIF(loObject.lFontItalic, 'I', '') + ;
			IIF(loObject.lFontUnderline, 'U', '') + IIF(loObject.lFontStrikethru, '-', '')
		
		lcStyle     = IIF(EMPTY(lcStyle), 'N', lcStyle)
		
		*-- Use .T. for DLL mode
		IF .F.
		
			DECLARE LONG GetDesktopWindow IN Win32API
		
		*-- Create Font Object
			lnFontStyle = cnGDIPLUS_FONTSTYLE_REGULAR
		
			IF loObject.lFontBold
				lnFontStyle = BITOR(lnFontStyle, cnGDIPLUS_FONTSTYLE_BOLD)
			ENDIF
		
			IF loObject.lFontItalic
				lnFontStyle = BITOR(lnFontStyle, cnGDIPLUS_FONTSTYLE_ITALIC)
			ENDIF
		
			IF loObject.lFontUnderline
				lnFontStyle = BITOR(lnFontStyle, cnGDIPLUS_FONTSTYLE_UNDERLINE)
			ENDIF
		
			loFont = NEWOBJECT(ccGDIPLUS_CLASS_FONT, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME, '', loObject.cFontName, loObject.nFontSize, lnFontStyle, cnGDIPLUS_Unit_Point)
		
			lnHWND = GetDesktopWindow()
		
		*-- Now cerate constant Graphics context
			loGraphics	= NEWOBJECT(ccGDIPLUS_CLASS_GRAPHICS, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME)
		
		*-- Create temporary Graphics context
			loGraphics.CreateFromHWND(lnHWND)
		
		*-- Get the width and height of the text
			loSizeF = loGraphics.MeasureStringA(tcValue, loFont, , , @lnCharsFitted, @lnLinesFilled)
			
			lnValue = loSizeF.nWidth
			
			RELEASE loGraphics, loFont, loSize
		
		ELSE
		
			lnAvg = FONTMETRIC(6, loObject.cFontName, loObject.nFontSize, lcStyle)
		
			FOR lnCount = 1 TO lnLenString
		
				lcChar  = SUBSTR(tcValue, lnCount, 1)
		
				IF lcChar # ccLF AND lcChar # ccCR
					lnValue = lnValue +  TXTWIDTH(lcChar, loObject.cFontName, loObject.nFontSize, lcStyle) * lnAvg
				ENDIF
			NEXT
		
		ENDIF
		
		RETURN lnValue
		
		
		
	ENDPROC

