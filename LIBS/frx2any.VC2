	PROCEDURE norientation_assign
		LPARAMETERS tnOrientation
		
		LOCAL lnOrientation
		
		WITH THIS
		
			DO CASE
				CASE .nExportFileType = cnWORD OR .nExportFileType = cnRTF
					DO CASE
						CASE tnOrientation = 0
							lnOrientation = cnWORD_PAGE_ORIENTATION_PORTRAIT
						OTHERWISE
							lnOrientation = cnWORD_PAGE_ORIENTATION_LANDSCAPE
					ENDCASE
		
				CASE .nExportFileType = cnEXCEL
					DO CASE
						CASE tnOrientation = 0
							lnOrientation = cnEXCEL_PAGE_ORIENTATION_PORTRAIT
						OTHERWISE
							lnOrientation = cnEXCEL_PAGE_ORIENTATION_LANDSCAPE
					ENDCASE
		
				CASE .nExportFileType = cnPDF OR .nExportFileType = cnXML  
					DO CASE
						CASE tnOrientation = 0
							lnOrientation = cnPDF_PAGE_ORIENTATION_PORTRAIT
						OTHERWISE
							lnOrientation = cnPDF_PAGE_ORIENTATION_LANDSCAPE
					ENDCASE
		
				OTHERWISE
					lnOrientation = IIF(EMPTY(tnOrientation), 0, tnOrientation)
			ENDCASE
		
			.nOrientation = lnOrientation
		
		ENDWITH
	ENDPROC

