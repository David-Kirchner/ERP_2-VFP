DEFINE CLASS answerform AS form 		&& Pass Question return Answer
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: creturn
	*</DefinedPropArrayMethod>

	*<PropValue>
		ALWAYSONTOP = .T.
		AUTOCENTER = .T.
		BORDERSTYLE = 0
		CAPTION = ""
		CLIPCONTROLS = .F.
		CLOSABLE = .F.
		CONTROLBOX = .F.
		creturn = 
		DOCREATE = .T.
		HEIGHT = 87
		NAME = "answerform"
		WIDTH = 254
		WINDOWTYPE = 1
	*</PropValue>

	ADD OBJECT 'cmdCancel' AS commandbutton WITH ;
		CAPTION = "OK", ;
		HEIGHT = 27, ;
		LEFT = 24, ;
		NAME = "cmdCancel", ;
		TOP = 48, ;
		WIDTH = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		CAPTION = "Cancel", ;
		HEIGHT = 27, ;
		LEFT = 144, ;
		NAME = "Command2", ;
		TOP = 48, ;
		WIDTH = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Text1' AS textbox WITH ;
		HEIGHT = 23, ;
		LEFT = 12, ;
		NAME = "Text1", ;
		TOP = 12, ;
		WIDTH = 228
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE INIT
			PARAMETER pQuestion, pAns, nAnsLen
		
			IF TYPE("pQuestion")= "C"
				THIS.CAPTION = pQuestion
			ENDIF
			IF EMPTY(THIS.CAPTION)
				THIS.CAPTION = "Need statement"
			ENDIF
		
			IF TYPE("pAns")= "C"
				THISFORM.Text1.VALUE = pAns
			ENDIF
		
			IF TYPE("nAnsLen") = "N"
				THISFORM.Text1.MAXLENGTH = nAnsLen
			ELSE
				THISFORM.Text1.MAXLENGTH = 0
			ENDIF
	ENDPROC

	PROCEDURE UNLOAD
			RETURN THISFORM.creturn
	ENDPROC

	PROCEDURE cmdCancel.CLICK
			THISFORM.creturn = THISFORM.Text1.VALUE
		
			THISFORM.RELEASE
		
	ENDPROC

	PROCEDURE Command2.CLICK
			THISFORM.creturn = ""
			THISFORM.RELEASE
		
	ENDPROC

ENDDEFINE

