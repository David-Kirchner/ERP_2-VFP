DEFINE CLASS quote_alloy AS embossedfield OF "wizstyle.vcx" 		&& Validate the Alloy
 	*< CLASSDATA: Baseclass="textbox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		BACKSTYLE = 0
		CONTROLSOURCE = "quotes.alloy"
		ENABLED = .T.
		FORMAT = ""
		HEIGHT = 21
		INPUTMASK = "XXXXXXXXXXXX"
		NAME = "quote_alloy"
		SELECTONENTRY = .T.
		TABINDEX = 27
		VISIBLE = .T.
		WIDTH = 106
	*</PropValue>
	
	PROCEDURE VALID
			PRIVATE pCurAlloy,cAlloyStandard
			pCurAlloy= ALLTRIM(THIS.VALUE)
		
			IF NOT EMPTY(pCurAlloy)
				cAlloyStandard = GetAlloyStandard( pCurAlloy )
		
				IF NOT EMPTY(cAlloyStandard)
					THIS.VALUE = cAlloyStandard
					THIS.FORECOLOR = RGB(0,0,0)
					RETURN .T.
				ELSE
					THIS.FORECOLOR = RGB(255,128,128)
					RETURN .F.
				ENDIF
		
			ENDIF
		
	ENDPROC

	PROCEDURE WHEN
			IF THISFORMSET.isediting
				THISFORMSET.metricgotfocus  = "ALLOY1"
				THISFORMSET.gotfocuslast  = "ALLOY1"
			ENDIF
			RETURN THISFORMSET.isediting
	ENDPROC

ENDDEFINE

DEFINE CLASS quote_form AS combobox 
	*<ClassComment>
		*Validate Form
	*</ClassComment>
 	*< CLASSDATA: Baseclass="combobox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		COLUMNCOUNT = 2
		COLUMNWIDTHS = "20,70"
		CONTROLSOURCE = "Quotes.Form"
		FIRSTELEMENT = 1
		HEIGHT = 219
		NAME = "quote_form"
		NUMBEROFELEMENTS = 0
		ROWSOURCE = "10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,71,Coupling,72,Flange,75,Fastener,80,Disk,90,Machined"
		ROWSOURCETYPE = 1
		STYLE = 2
		TABINDEX = 29
		WIDTH = 436
	*</PropValue>
	
	PROCEDURE VALID
			THISFORMSET.RefreshForms()
			*10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,71,Coupling,72,Flange,75,Fastener,80,Disk,90,Machined
			* ALSO FOUND IN PurchaseOrder Screen
			IF THISFORMSET.Quotes.THCK1.VALUE * THISFORMSET.Quotes.SZ21.VALUE > 0
				IF NOT THISFORMSET.Quotes.SZ31.VISIBLE
					*		IF ThisFormset.QUOTES.SZ21.Value > 0
					THISFORMSET.calcinv(2)
					*		ENDIF
				ELSE
					IF THISFORMSET.Quotes.SZ31.VALUE > 0
						THISFORMSET.calcinv(3)
					ENDIF
				ENDIF
			ENDIF
		
	ENDPROC

	PROCEDURE WHEN
			IF THISFORMSET.isediting
				THISFORMSET.metricgotfocus  = "cmbForm"
				THISFORMSET.gotfocuslast  = "cmbForm"
			ENDIF
			RETURN THISFORMSET.isediting
	ENDPROC

ENDDEFINE

