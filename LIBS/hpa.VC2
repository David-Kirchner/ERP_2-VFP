	PROCEDURE cmgGfm_calc.Valid
			*FIND L2 BY DIA'S AND L1
		
			PRIVATE m.cutfctr,m.Tflength
			PRIVATE nSlength,nSsize,nGFMsize,nFlength
			PRIVATE ncutfctr, nFpiece, nSpiece, nColdWork
		
			nSlength = THISFORM.txtSlength.VALUE
			nSsize = THISFORM.txtSsize.VALUE
			nGFMsize = THISFORM.txtGFMSize.VALUE
			nFlength  = THISFORM.txtFlength.VALUE
		
			nFpiece = THISFORM.txtFpiece.VALUE
			nSpiece = THISFORM.txtSpiece.VALUE
			nColdWork = THISFORM.txtColdWork.VALUE
		
			*SELECT GFMlog
			IF nSlength > 0 AND nSsize > 0 AND nGFMsize >0 AND nFlength = 0
				m.Tflength=nSsize*nSsize*nSlength/(nGFMsize*nGFMsize)
				*REPLACE flength WITH VAL( STR( m.Tflength ,8,0) )
				THISFORM.txtFlength.VALUE = VAL( STR( m.Tflength ,8,0) )
				IF (nSpiece > 0 AND nFpiece > 0) AND (nSpiece <> nFpiece)
					ncutfctr = nFpiece / nSpiece
					IF INT(ncutfctr) = ncutfctr
						*REPLACE flength WITH  flength / ncutfctr
						THISFORM.txtFlength.VALUE =  nFlength / ncutfctr
					ELSE
						WAIT WINDOW 'Length is based on no cuts'
					ENDIF
				ENDIF
				*  ThisForm.flength.Refresh
			ENDIF
			*FIND RA BY DIA'S
			IF nSsize > 0 AND nGFMsize >0 AND nColdWork = 0
				PRIVATE na1, na2
				na1= 3.14156*nSsize*nSsize/4
				na2= 3.14156*nGFMsize*nGFMsize/4
		
				nColdWork = (na1-na2)/na1
				IF nColdWork < 1
					THISFORM.txtColdWork.VALUE = nColdWork
				ENDIF
			ENDIF
			THISFORM.REFRESH()
	ENDPROC

	PROCEDURE cmgGfm_calc.When
			RETURN THISFORM.isediting
	ENDPROC

