	PROCEDURE LBLDESCRIPT1.Click
			PRIVATE cText
			*cText = ThisFormSet.QuotesDescription( Starting_Stock.Form, Starting_Stock.thck, Starting_Stock.sz2, Starting_Stock.sz3 )
			*IF EMPTY(cText)
			*	cText = "No description Detail to show!"
			*ENDIF
			*MESSAGEBOX( cText,0+64,"Description" )
		
		
			cText = ItemDescriptionMetric(Starting_Stock.FORM, Starting_Stock.Thck, Starting_Stock.sz2, Starting_Stock.sz3, Starting_Stock.Weight, Starting_Stock.RandLen, Starting_Stock.Metric)
			IF EMPTY(cText)
				MESSAGEBOX( "No description Detail to show!", 64)
			ELSE
				IF THISFORMSET.iseditingSS
					IF MESSAGEBOX( cText+CHR(13)+CHR(13)+"Do you want to copy to Description line?",4+32,"Description" ) = 6
						THISFORM.DESCRIPT1.VALUE = cText
					ENDIF
				ELSE
					MESSAGEBOX( cText,0+64,"Description" )
				ENDIF
			ENDIF
	ENDPROC

