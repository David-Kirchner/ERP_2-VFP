	ADD OBJECT 'txtSearch' AS textbox WITH ;
		Alignment = 3, ;
		Height = 23, ;
		InputMask = "999999", ;
		Left = 252, ;
		MaxLength = 6, ;
		Name = "txtSearch", ;
