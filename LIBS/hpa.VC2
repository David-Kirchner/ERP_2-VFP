				USE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuoteAttach) EXCL ALIAS QuoteAttach
			ENDIF
		ELSE
			IF FILE(SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuoteAttach) &&Clean the file
				SELECT 0
				USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuoteAttach) EXCL ALIAS QuoteAttach
				IF USED('QuoteAttach')
					ZAP
				ENDIF
			ELSE &&Create file
				SELECT 0
