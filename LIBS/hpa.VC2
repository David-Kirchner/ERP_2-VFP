		TabIndex = 2, ;
		Top = 13, ;
		Value = 0, ;
		Width = 132
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
			IF USED('tmpQuotes')
				USE IN tmpQuotes
			ENDIF
	ENDPROC

	PROCEDURE Init
			PARAMETER pnSO
		
			THISFORM.cmbSWhere.VALUE = "Sales Order"
			THISFORM.cReturnKey=''
			THISFORM.txtSearch.SETFOCUS
		
			IF TYPE("pnSO")= "N"
				IF pnSO > 0
					THISFORM.txtSearch.VALUE = ALLTRIM(STR(pnSO))
					THISFORM.cmdSearch.CLICK
				ENDIF
			ENDIF
		
	ENDPROC

	PROCEDURE Load
			PRIVATE nconnhandle,cSQL,nSQLEXEC
			IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
				SET PROCEDURE TO Progs\PROC_SQL ADDITIVE
			ENDIF
		
			STORE get_SQLSTRINGCONNECT() TO nconnhandle
			IF nconnhandle < 0
				= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
				QUIT
			ENDIF
			SELECT 0
			cSQL = "SELECT Company,Name,po_Num,Alloy,Form,Pieces,Thck,Sz2,Sz3,weight,Descript,' ' AS comment,inqdate,SalesP,SalesNum,SoItem,SaleDate FROM DBO.AllQuotes WHERE 1 <> 1"
			nSQLEXEC = SQLEXEC(nconnhandle, cSQL, 'tmpQuotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nconnhandle, cSQL, 'tmpQuotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(nConnHandle, cSQL, "tmpQuotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConnHandle, cSQL, "tmpQuotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nconnhandle, "tmpQuotes")
			ENDIF
		
			THISFORM.nconnhandle = nconnhandle
		
	ENDPROC

	PROCEDURE Unload
		
			RETURN THIS.cReturnKey
	ENDPROC

	PROCEDURE cmbSWhere.InteractiveChange
			DO CASE
			CASE THIS.VALUE = "Sales Order"
				THISFORM.txtSearch.VALUE = 0
				THISFORM.txtSearch.INPUTMASK = "99999"
				THISFORM.txtSearch.MAXLENGTH = 6
			CASE THIS.VALUE = "Customers PO"
				THISFORM.txtSearch.VALUE = ""
				THISFORM.txtSearch.INPUTMASK = ""
				THISFORM.txtSearch.MAXLENGTH = 17
			CASE THIS.VALUE = "Company Name"
				THISFORM.txtSearch.VALUE = ""
				THISFORM.txtSearch.INPUTMASK = ""
				THISFORM.txtSearch.MAXLENGTH = 30
			CASE THIS.VALUE = "Packing Slip Number"
				THISFORM.txtSearch.VALUE = 0
				THISFORM.txtSearch.INPUTMASK = "999999"
				THISFORM.txtSearch.MAXLENGTH = 6
			ENDCASE
			THISFORM.txtSearch.REFRESH
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		
			THISFORM.RELEASE
	ENDPROC

	PROCEDURE cmdReturn.Click
		SELECT tmpQuotes
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(tmpQuotes.Soitem,'SOitem',10)
		
		GO TOP
		PRIVATE lFoundDel
		lFoundDel = .F.
		
		SCAN
			IF DELETED('tmpQuotes')
				lFoundDel = .T.
				IF EMPTY(THISFORM.cReturnKey)
					THISFORM.cReturnKey = tmpQuotes.Soitem
				ELSE
					THISFORM.cReturnKey = THISFORM.cReturnKey + ";" + tmpQuotes.Soitem
				ENDIF
			ENDIF
		ENDSCAN
		
		IF NOT lFoundDel
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				THISFORM.cReturnKey = cSOitem
			ELSE
				MESSAGEBOX("No records found marked to return!"+CHR(13)+"Use Cancel if you do not wont any records returned.")
				RETURN
			ENDIF
		ELSE
			THISFORM.RELEASE
		ENDIF
	ENDPROC

	PROCEDURE cmdSearch.Click
			PRIVATE vSearchFor, cSQL
			vSearchFor = THISFORM.txtSearch.VALUE
		
			PRIVATE nconnhandle, cSearchFor, vSearchFor
			nconnhandle = THISFORMSET.nconnhandle
			*nConnHandle = ThisForm.nConnHandle
		
			IF EMPTY(THISFORM.txtSearch.VALUE)
				MESSAGEBOX("Nothing to Search for!",0,"Empty")
				RETURN .F.
			ENDIF
		
			IF TYPE("vSearchFor") = "N"
				cSearchFor = ALLTRIM(STR(vSearchFor))
			ELSE
				cSearchFor = ALLTRIM(vSearchFor)
			ENDIF
		
			THISFORM.grdSQL.RECORDSOURCE = ""
		
			cSQL = "SELECT Company,Name,po_Num,Alloy,Form,Pieces,Thck,Sz2,Sz3,weight,Descript,'' AS comment,inqdate,SalesP,SalesNum,SoItem,SaleDate FROM DBO.AllQuotes  "
		
			DO CASE
			CASE THISFORM.cmbSWhere.VALUE = "Sales Order"
		
				cSQL = cSQL + "WHERE SalesNum = "+ cSearchFor
		
			CASE THISFORM.cmbSWhere.VALUE = "Customers PO"
		
				cSQL = cSQL + "WHERE PO_Num = '" + cSearchFor + "'"
		
			CASE THISFORM.cmbSWhere.VALUE = "Company Name"
		
				cSQL = cSQL + "WHERE Company LIKE '%" + cSearchFor + "%'"
		
				*CASE ThisForm.cmbSWhere.Value = "Packing Slip Number"
		
			ENDCASE
		
			IF USED('tmpQuotes')
				USE IN tmpQuotes
			ENDIF
			SELECT 0
			cSQL = cSQL + " ORDER BY SaleDate DESC"
			nSQLEXEC = SQLEXEC(nconnhandle, cSQL, 'tmpQuotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nconnhandle, cSQL, 'tmpQuotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(nConnHandle, cSQL, "tmpQuotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConnHandle, cSQL, "tmpQuotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nconnhandle, "tmpQuotes")
			ENDIF
		
			THISFORM.grdSQL.RECORDSOURCE = "tmpQuotes"
		
	ENDPROC

	PROCEDURE txtSearch.Valid
			IF !EMPTY(THIS.VALUE)
				THISFORM.cmdSearch.CLICK()
			ENDIF
	ENDPROC

ENDDEFINE

DEFINE CLASS select4order AS form 		&& Select records to post SO and PO
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="lblItems" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdPrev4Order" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdNext4Order" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSelect4Order" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdDone4Order" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAbort4Order" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblSN" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtSN" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtPO" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lbl_" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblItem" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdGetNextSO" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblInstructHowto" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdViewPO" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblTotalItems" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblCompany" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblInqNumP" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: nextitemnumber		&& SQL max (item)
		*m: prep_quote_salesorder		&& Corrects Quote Data before being Sold
		*m: reload		&& Simulates a load when form was a new window
		*m: selectcolor		&& Make the Select button change color.
		*p: newso		&& Logical NEW SO or a USED SO being added to.
		*p: nsalesnum
		*p: nsnitems
	*</DefinedPropArrayMethod>

	*<PropValue>
		AlwaysOnTop = .T.
		AutoCenter = .F.
		BackColor = 200,0,0
		BorderStyle = 1
		Caption = "Select Quotes for this Sales Order."
		Closable = .F.
		ControlBox = .F.
		DoCreate = .T.
		HalfHeightCaption = .T.
		Height = 120
		Left = 37
		MDIForm = .T.
		Name = "select4order"
		newso = .T.
		nsalesnum = 0
		nsnitems = 0
		Top = 56
		Width = 416
		WindowState = 0
		WindowType = 1
	*</PropValue>

