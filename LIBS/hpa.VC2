DEFINE CLASS po_alloy AS embossedfield OF "wizembss.vcx" 		&& Validate Alloy, PO Style
 	*< CLASSDATA: Baseclass="textbox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		BACKSTYLE = 0
		CONTROLSOURCE = "m.alloy"
		ENABLED = .T.
		FORMAT = "K"
		HEIGHT = 20
		INPUTMASK = "XXXXXXXXXXXX"
		NAME = "po_alloy"
		SELECTONENTRY = .T.
		TABINDEX = 18
		VISIBLE = .T.
		WIDTH = 106
	*</PropValue>
	
	PROCEDURE INTERACTIVECHANGE
			PRIVATE lnInsertionPt, lcSearchStr
			lnInsertionPt = THIS.SELSTART
			lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		
			PRIVATE lCloseAlloy
			lCloseAlloy = .F.
			IF !USED('Alloy')
				lCloseAlloy= .T.
				USE HPA!Alloy IN 0 ORDER UppAlloy SHARED NOUPDATE&&EXCLUSIVE
			ENDIF
		
			IF !EMPTY(lcSearchStr)
				=SEEK(UPPER(lcSearchStr),"Alloy","UppAlloy")
				IF FOUND("Alloy")
					THIS.VALUE=Alloy.Alloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					**No replacement
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
				THIS.VALUE=SPACE(0)
			ENDIF
			THIS.SELSTART = lnInsertionPt
		
		
			IF lCloseAlloy
				IF USED('Alloy')
					USE IN Alloy
				ENDIF
			ENDIF
	ENDPROC

	PROCEDURE LOSTFOCUS
			=INSMODE(.T.)
	ENDPROC

	PROCEDURE VALID
			PRIVATE pCurAlloy,cAlloyStandard
			pCurAlloy= ALLTRIM(THIS.VALUE)
		
			IF NOT EMPTY(pCurAlloy)
				cAlloyStandard = GetAlloyStandard( pCurAlloy )
		
				IF NOT EMPTY(cAlloyStandard)
					THIS.VALUE = cAlloyStandard
					THIS.FORECOLOR = RGB(0,0,0)
					RETURN .T.
				ELSE
					THIS.FORECOLOR = RGB(255,128,128)
					RETURN .F.
				ENDIF
		
			ENDIF
		
	ENDPROC

ENDDEFINE

