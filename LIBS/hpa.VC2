		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'cmbFormSS' AS combobox WITH ;
		ColumnCount = 2, ;
		ColumnWidths = "20,70", ;
		ControlSource = "Starting_Stock.form", ;
		FirstElement = 1, ;
		Height = 23, ;
		Left = 176, ;
		Name = "cmbFormSS", ;
		NumberOfElements = 0, ;
		RowSource = "10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,71,Coupling,72,Flange,75,Fastener,80,Disk,90,Machined", ;
		RowSourceType = 1, ;
		Style = 2, ;
		TabIndex = 29, ;
		Top = 13, ;
		Width = 44
		*< END OBJECT: BaseClass="combobox" />

	ADD OBJECT 'cmdEdit' AS commandbutton WITH ;
		Caption = "Edit", ;
		Height = 27, ;
		Left = 36, ;
		Name = "cmdEdit", ;
		Top = 108, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdReturn' AS commandbutton WITH ;
		Caption = "Return", ;
		Height = 27, ;
		Left = 192, ;
		Name = "cmdReturn", ;
		Top = 108, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'CommentsSS' AS editbox WITH ;
		ControlSource = "Starting_Stock.comments", ;
		Enabled = .T., ;
		Height = 53, ;
		Left = 272, ;
		Name = "CommentsSS", ;
		TabIndex = 41, ;
		TabStop = .T., ;
		Top = 48, ;
		Width = 342
		*< END OBJECT: BaseClass="editbox" />

	ADD OBJECT 'DESCRIPT1SS' AS embossedfield WITH ;
		ControlSource = "Starting_Stock.descript", ;
		Enabled = .T., ;
		Format = "K", ;
		Height = 21, ;
		InputMask = "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX", ;
		Left = -1, ;
		Name = "DESCRIPT1SS", ;
		SelectOnEntry = .T., ;
		TabIndex = 39, ;
		Top = 49, ;
		Visible = .T., ;
		Width = 269
		*< END OBJECT: ClassLib="wizstyle.vcx" BaseClass="textbox" />

	ADD OBJECT 'LBLALLOY1' AS embossedlabel WITH ;
		Alignment = 1, ;
		Caption = "Alloy:", ;
