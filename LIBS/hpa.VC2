		Enabled = .T., ;
		Format = "", ;
		Height = 21, ;
		InputMask = "XXXXXXXXXXXX", ;
		Left = 32, ;
		Name = "ALLOY1SS", ;
		SelectOnEntry = .T., ;
		TabIndex = 27, ;
		Top = 14, ;
		Visible = .T., ;
		Width = 106
		*< END OBJECT: ClassLib="wizstyle.vcx" BaseClass="textbox" />

	ADD OBJECT 'ChkMetricSS' AS checkbox WITH ;
		Alignment = 0, ;
		BackStyle = 0, ;
		Caption = "Metric", ;
		ControlSource = "Starting_Stock.metric", ;
		FontBold = .T., ;
		FontSize = 8, ;
		Height = 17, ;
		Left = 504, ;
