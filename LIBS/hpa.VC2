	PROCEDURE Activate
			THISFORM.cmbTables.VALUE = "PackingSlip"
	ENDPROC

	PROCEDURE getsql_field
			DO CASE
			CASE THISFORM.ogPackingSlip.VISIBLE
				DO CASE
				CASE THISFORM.ogPackingSlip.VALUE = 1
					cSQL_field = "PACKINGSLIP.HEAT"
				CASE THISFORM.ogPackingSlip.VALUE = 2
					cSQL_field = "PACKINGSLIP.SOITEM"
				ENDCASE
			CASE THISFORM.ogPackingSlip_No.VISIBLE
				DO CASE
				CASE THISFORM.ogPackingSlip_No.VALUE = 1
					cSQL_field = "PackingSlip_No.PACKINGSLI"
				CASE THISFORM.ogPackingSlip_No.VALUE = 2
					cSQL_field = "PackingSlip_No.TRACKING"
				ENDCASE
			CASE THISFORM.ogSoldAddr.VISIBLE
				DO CASE
				CASE THISFORM.ogSoldAddr.VALUE = 1
					cSQL_field = "SoldAddr.COMPANY"
				CASE THISFORM.ogSoldAddr.VALUE = 2
					cSQL_field = "SoldAddr.ADDR1"
				CASE THISFORM.ogSoldAddr.VALUE = 3
					cSQL_field = "SoldAddr.ADDR2"
				CASE THISFORM.ogSoldAddr.VALUE = 4
					cSQL_field = "SoldAddr.CITY"
				CASE THISFORM.ogSoldAddr.VALUE = 5
					cSQL_field = "SoldAddr.ST"
				CASE THISFORM.ogSoldAddr.VALUE = 6
					cSQL_field = "SoldAddr.CONTACT"
				CASE THISFORM.ogSoldAddr.VALUE = 7
					cSQL_field = "SoldAddr.TELEPHONE"
				CASE THISFORM.ogSoldAddr.VALUE = 8
					cSQL_field = "SoldAddr.FAX_NUMBER"
				ENDCASE
			CASE THISFORM.ogShipAddr.VISIBLE
				DO CASE
				CASE THISFORM.ogShipAddr.VALUE = 1
					cSQL_field = "ShipAddr.COMPANY"
				CASE THISFORM.ogShipAddr.VALUE = 2
					cSQL_field = "ShipAddr.ADDR1"
				CASE THISFORM.ogShipAddr.VALUE = 3
					cSQL_field = "ShipAddr.ADDR2"
				CASE THISFORM.ogShipAddr.VALUE = 4
					cSQL_field = "ShipAddr.CITY"
				CASE THISFORM.ogShipAddr.VALUE = 5
					cSQL_field = "ShipAddr.ST"
				CASE THISFORM.ogShipAddr.VALUE = 6
					cSQL_field = "ShipAddr.CONTACT"
				CASE THISFORM.ogShipAddr.VALUE = 7
					cSQL_field = "ShipAddr.TELEPHONE"
				CASE THISFORM.ogShipAddr.VALUE = 8
					cSQL_field = "ShipAddr.FAX_NUMBER"
				ENDCASE
			CASE THISFORM.ogAllQuotes.VISIBLE
				DO CASE
				CASE THISFORM.ogAllQuotes.VALUE = 1
					cSQL_field = "AllQuotes.COMPANY"
				CASE THISFORM.ogAllQuotes.VALUE = 2
					cSQL_field = "AllQuotes.NAME"
				CASE THISFORM.ogAllQuotes.VALUE = 3
					cSQL_field = "AllQuotes.INQNUMP"
				CASE THISFORM.ogAllQuotes.VALUE = 4
					cSQL_field = "AllQuotes.HPAPO"
				CASE THISFORM.ogAllQuotes.VALUE = 5
					cSQL_field = "AllQuotes.BUYFROM"
				CASE THISFORM.ogAllQuotes.VALUE = 6
					cSQL_field = "AllQuotes.SALESP"
				CASE THISFORM.ogAllQuotes.VALUE = 7
					cSQL_field = "AllQuotes.PO_NUM"
				ENDCASE
			CASE THISFORM.ogSales.VISIBLE
				DO CASE
				CASE THISFORM.ogSales.VALUE = 1
					cSQL_field = "Sales.SALESNUM"
				ENDCASE
			ENDCASE
		
			RETURN cSQL_field
		
	ENDPROC

	PROCEDURE getsql_table
			PRIVATE cReturn_Table
			cReturn_Table=""
		
			DO CASE
			CASE THISFORM.ogPackingSlip.VISIBLE
				cReturn_Table = "PackingSlip"
			CASE THISFORM.ogPackingSlip_No.VISIBLE
				cReturn_Table = "PackingSlip_No"
			CASE THISFORM.ogSoldAddr.VISIBLE
				cReturn_Table = "SoldAddr"
			CASE THISFORM.ogShipAddr.VISIBLE
				cReturn_Table = "ShippAddr"
			CASE THISFORM.ogAllQuotes.VISIBLE
				cReturn_Table = "AllQuotes"
			CASE THISFORM.ogSales.VISIBLE
				cReturn_Table = "Sales"
			ENDCASE
		
			RETURN 	cReturn_Table
	ENDPROC

	PROCEDURE getsql_where
			*PARAMETER plIsNumber, pSQL_Field, plIsFoxTable
		
			PRIVATE  cSQL_field, cSQL_table, lIsNumber, lIsFoxTable
			cSQL_field  = THISFORM.GetSQL_field()
			cSQL_table  = THISFORM.GetSQL_Table()
			lIsNumber   = THISFORM.IsFieldNumber( cSQL_field )
			lIsFoxTable = THISFORM.IsFoxTable( cSQL_table )
		
			PRIVATE cSearchText,cSearchMax
			cSearchText = ALLTRIM(THISFORM.txt_search_text.VALUE)
			cSearchMax	= ALLTRIM(THISFORM.txt_search_max.VALUE)
		
			PRIVATE nSearch_how, cSQL_where
			nSearch_how = THISFORM.oGrp_search_how.VALUE
		
			IF lIsFoxTable
				IF plIsNumber
					DO CASE
					CASE nSearch_how = 1
						cSQL_where = cSQL_field + " = " + cSearchText
					CASE nSearch_how = 2
						cSQL_where = cSearchText + " $ " + cSQL_field
					CASE  nSearch_how = 3
						cSQL_where = cSQL_field + " >= " + cSearchText + " AND " + cSQL_field + " <= " + cSearchMax
					ENDCASE
				ELSE
					DO CASE
					CASE nSearch_how = 1
						cSQL_where = " " + cSQL_field + " = '" + cSearchText +"'"
					CASE nSearch_how = 2
						cSQL_where = '"' + cSearchText + '" $ UPPER(' + cSQL_field + ")"
					CASE  nSearch_how = 3
						cSQL_where = cSQL_field + " >= '" + cSearchText + "' AND "+ cSQL_field + " <= '" + cSearchMax + "'"
					ENDCASE
				ENDIF
		
			ELSE
				IF plIsNumber
					DO CASE
					CASE nSearch_how = 1
						cSQL_where = cSQL_field + " = " + cSearchText
					CASE nSearch_how = 2
						cSQL_where = cSQL_field + " LIKE " + cSearchText + "%"
					CASE  nSearch_how = 3
						cSQL_where = cSQL_field + " >= " + cSearchText + " AND " + cSQL_field + " <= " + cSearchMax
					ENDCASE
				ELSE
					DO CASE
					CASE nSearch_how = 1
						cSQL_where = " " + cSQL_field + " LIKE '" + cSearchText +"%'"
					CASE nSearch_how = 2
						cSQL_where = " " + cSQL_field + " LIKE '%" + cSearchText +"%'"
					CASE  nSearch_how = 3
						cSQL_where = cSQL_field + " >= '" + cSearchText + "' AND "+ cSQL_field + " <= '" + cSearchMax + "'"
					ENDCASE
				ENDIF
			ENDIF
			RETURN cSQL_where
		
	ENDPROC

	PROCEDURE isfieldnumber
			PARAMETER pSQL_Field
		
			lIsNumber = .F.
			cSQL_field = UPPER( pSQL_Field )
			DO CASE
			CASE cSQL_field = "SALES.SALESNUM"  &&UPPER
				lIsNumber = .T.
			CASE cSQL_field = "PACKINGSLIP_NO.PACKINGSLI"  &&UPPER
				lIsNumber = .T.
			ENDCASE
		
			RETURN lIsNumber
	ENDPROC

	PROCEDURE isfoxtable
			PARAMETER pcSQL_table
			PRIVATE lIsFoxTable
			lIsFoxTable = .T.
		
			cSQL_table = UPPER( pcSQL_table )
			DO CASE
			CASE cSQL_table = "PACKINGSLIP"
				lIsFoxTable = .F.
			CASE cSQL_table = "PACKINGSLIP_NO"
				lIsFoxTable = .F.
			CASE cSQL_table = "SOLDADDR"
				lIsFoxTable = .F.
			CASE cSQL_table = "SHIPADDR"
				lIsFoxTable = .F.
			CASE cSQL_table = "ALLQUOTES"
				lIsFoxTable = .F.
			CASE cSQL_table = "SALES"
				lIsFoxTable = .F.
			ENDCASE
		
		
			RETURN lIsFoxTable
	ENDPROC

	PROCEDURE istrimable
			PARAMETER pSQL_Field
			PRIVATE lIsTrimable
			lIsTrimable = .T.
			cSQL_field = UPPER( pSQL_Field )
			DO CASE
			CASE cSQL_field = "SOITEM"
				lIsTrimable = .F.
			ENDCASE
		
			RETURN lIsTrimable
		
		
	ENDPROC

	PROCEDURE Load
			IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
				SET PROCEDURE TO Progs\PROC_SQL ADDITIVE
			ENDIF
		
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
	ENDPROC

	PROCEDURE searchnow
			PRIVATE  cSQL_field, cSQL_table, lIsNumber, lIsTrimable, lIsFoxTable
			cSQL_field  = THISFORM.GetSQL_field()
			cSQL_table  = THISFORM.GetSQL_Table()
			lIsNumber   = THISFORM.IsFieldNumber( cSQL_field )
			lIsTrimable = THISFORM.IsTrimable( cSQL_field )
			lIsFoxTable = THISFORM.IsFoxTable( cSQL_table )
		
			PRIVATE vSearchText,vSearchMax,cSearchText,cSearchMax
		
			vSearchText = THISFORM.txt_search_text.VALUE
			IF TYPE("vSearchText") = "N"
				cSearchText = STR( vSearchText )
			ELSE
				cSearchText = vSearchText
			ENDIF
		
			vSearchMax	= THISFORM.txt_search_max.VALUE
			IF TYPE("vSearchMax") = "N"
				cSearchMax = STR( vSearchMax )
			ELSE
				cSearchMax = vSearchMax
			ENDIF
		
		
			IF lIsTrimable
				cSearchText = ALLTRIM(cSearchText)
				cSearchMax	= ALLTRIM(cSearchMax)
			ENDIF
		
			PRIVATE nSO,nItem
			IF UPPER(cSQL_field) = "PACKINGSLIP.SOITEM"
				*	nSO = VAL( LEFT( cSearchText,7 ))
				*	nItem = VAL( RIGHT( cSearchText,2 ))
				cSearchText = Proper_SO_Item( STR(VAL( LEFT( cSearchText,7 )))+"-"+STR(VAL( RIGHT( cSearchText,2 )),2,0) )
				*STR(nSO,7,0)+"-"+IIF(nItem<10,"0"+STR(nItem,1,0), STR(nItem,2,0) )
		
				*	nSO = VAL( LEFT( cSearchMax,7 ))
				*	nItem = VAL( RIGHT( cSearchMax,2 ))
				cSearchMax = Proper_SO_Item( STR(VAL( LEFT( cSearchMax,7 )))+"-"+STR(VAL( RIGHT( cSearchMax,2 )),2,0) )
				*STR(nSO,7,0)+"-"+IIF(nItem<10,"0"+STR(nItem,1,0), STR(nItem,2,0) )
			ENDIF
		
		
			PRIVATE cSearchTextOrig
			cSearchTextOrig = cSearchText
		
			IF EMPTY(cSearchText)
				MESSAGEBOX("Please enter someting to search for!",0,"No data.")
				RETURN .F.
			ENDIF
		
			PRIVATE nSearch_how, cSQL_where
			nSearch_how = THISFORM.oGrp_search_how.VALUE
		
			DIMENSION APACKINGSLI(1)
		
			IF lIsFoxTable
				IF lIsNumber
					DO CASE
					CASE nSearch_how = 1
						cSQL_where = cSQL_field + " = " + cSearchText
					CASE nSearch_how = 2
						cSQL_where = cSearchText + " $ " + cSQL_field
					CASE  nSearch_how = 3
						cSQL_where = cSQL_field + " >= " + cSearchText + " AND " + cSQL_field + " <= " + cSearchMax
					ENDCASE
				ELSE
					DO CASE
					CASE nSearch_how = 1
						cSQL_where = " " + cSQL_field + " LIKE '" + cSearchText +"%'"
					CASE nSearch_how = 2
						cSQL_where = '"' + cSearchText + '" $ UPPER(' + cSQL_field + ")"
					CASE  nSearch_how = 3
						cSQL_where = cSQL_field + " >= '" + cSearchText + "' AND "+ cSQL_field + " <= '" + cSearchMax + "'"
					ENDCASE
				ENDIF
		
			ELSE
				IF lIsNumber
					DO CASE
					CASE nSearch_how = 1
						cSQL_where = cSQL_field + " = " + cSearchText
					CASE nSearch_how = 2
						cSQL_where = cSQL_field + " LIKE " + cSearchText + "%"
					CASE  nSearch_how = 3
						cSQL_where = cSQL_field + " >= " + cSearchText + " AND " + cSQL_field + " <= " + cSearchMax
					ENDCASE
				ELSE
					DO CASE
					CASE nSearch_how = 1
						cSQL_where = " " + cSQL_field + " LIKE '" + cSearchText +"%'"
					CASE nSearch_how = 2
						cSQL_where = " " + cSQL_field + " LIKE '%" + cSearchText +"%'"
					CASE  nSearch_how = 3
						cSQL_where = cSQL_field + " >= '" + cSearchText + "' AND "+ cSQL_field + " <= '" + cSearchMax + "'"
					ENDCASE
				ENDIF
			ENDIF
		
		
		
			IF NOT EMPTY(THISFORM.editHoldAnd.VALUE)
				*	cSQL_where = cSQL_where + ThisForm.editHoldAnd.Value
			ENDIF
		
			PRIVATE cPS_Where
			cPS_Where = ""
		
			PRIVATE cSQL
			PRIVATE nSQLEXEC
		
			SELECT 0
			DO CASE
			CASE UPPER(cSQL_table) = "PACKINGSLIP_NO"
				IF cSQL_field = "PACKINGSLI"
					SELECT PackingSlip_No
					LOCATE FOR &cSQL_where
					IF FOUND()
						*			SET FILTER TO &cSQL_Where
						WAIT WINDOW 'Found' NOWAIT
					ELSE
						SKIP -1
					ENDIF
				ENDIF
				IF cSQL_field = "TRACKING"
					SELECT DISTINCT PackingSli FROM PackingSlip_No WHERE &cSQL_where INTO ARRAY APACKINGSLI
					IF TYPE("aPackingSli") = "N"
						FOR i = 1 TO ALEN(APACKINGSLI)
							IF i = 1
								cPS_Where = "PackingSli="+ALLTRIM(STR( APACKINGSLI(i) ))
							ELSE
								IF i > 80
									MESSAGEBOX("Too Many Records, Only Showing first 80")
									EXIT
								ELSE
									cPS_Where = cPS_Where + " OR  PackingSli="+ALLTRIM(STR( APACKINGSLI(i) ))
								ENDIF
							ENDIF
						ENDFOR
						SELECT PackingSlip_No
						SET FILTER TO &cPS_Where
					ELSE
						*WAIT WINDOW 'No Find !!!' NOWAIT
						MESSAGEBOX("Not Found!",0+64)
						SELECT PackingSlip_No
						SET FILTER TO
					ENDIF
				ENDIF
		
			CASE UPPER(cSQL_table) = "PACKINGSLIP"
				cSQL= "SELECT DISTINCT PackingSli FROM dbo.PackingSlip WHERE "+cSQL_where
				IF USED('cntPackingSli')
					USE IN cntPackingSli
				ENDIF
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPackingSli')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPackingSli')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPackingSli")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPackingSli")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle)
				ENDIF
				lFound = .F.
		
				IF USED('cntPackingSli')
					IF VARTYPE(cntPackingSli.PackingSli) = "N"
						IF NOT EMPTY(cntPackingSli.PackingSli)
							SELECT PackingSlip_No
							*SELECT DISTINCT PackingSli FROM cntPackingSli INTO ARRAY aPackingSli
							LOCATE FOR PackingSli =  cntPackingSli.PackingSli
							IF FOUND("PackingSlip_NO")
								lFound = .T.
							ENDIF
						ENDIF
					ENDIF
				ENDIF
		
				IF lFound
					IF USED('cntPackingSli')
						SELECT cntPackingSli
						GO TOP
						IF VARTYPE(cntPackingSli.PackingSli) = "N"
							*FOR i = 1 TO RECCOUNT(cntPackingSli)
							i = 0
							SCAN
								i = i +1
		
								IF i = 1
									cPS_Where = "PackingSli="+ALLTRIM(STR( cntPackingSli.PackingSli ))
								ELSE
									IF i > 80
										MESSAGEBOX("Too Many Records, Only Showing first 80")
										EXIT
									ELSE
										cPS_Where = cPS_Where + " OR  PackingSli="+ALLTRIM(STR( cntPackingSli.PackingSli ))
									ENDIF
								ENDIF
								*ENDFOR
							ENDSCAN
		
							SELECT PackingSlip_No
							SET FILTER TO &cPS_Where
						ENDIF
						USE IN cntPackingSli
					ENDIF
				ELSE
					WAIT WINDOW 'No Find !!!' NOWAIT
					SELECT PackingSlip_No
					SET FILTER TO
				ENDIF
			CASE UPPER(cSQL_table) = "SALES"
				cSO7 = STR(VAL(cSearchText),7,0)
				cSO7 = ALLTRIM(cSO7)
		
				cSO7Max = STR(VAL(cSearchMax),7,0)
				cSO7Max = ALLTRIM(cSO7Max)
		
				DO CASE
				CASE nSearch_how = 1
					*cSQL_where = " SalesNum = " + cSO7 + ""
					cSQL_where = " SOitem LIKE '%" + cSO7 + "-%'"
				CASE nSearch_how = 2
					*cSQL_where = " SalesNum = " + cSO7 + "" &&"'"+ cSO7 + "' $ " + " SOItem "
					cSQL_where = " SOitem LIKE '%" + cSO7 + "-%'"
				CASE  nSearch_how = 3
					cSQL_where = " CAST(SOitem AS INT) >= " + cSO7 + " AND " + " CAST(SOitem AS INT) <= " + cSO7Max + ""
				ENDCASE
		
		
		
				cSQL= "SELECT DISTINCT PackingSli FROM dbo.PackingSlip WHERE "+cSQL_where
				IF USED('cntPackingSli')
					USE IN cntPackingSli
				ENDIF
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPackingSli')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPackingSli')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPackingSli")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPackingSli")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle)
				ENDIF
				lFound = .F.
		
				IF USED('cntPackingSli')
					IF VARTYPE(cntPackingSli.PackingSli) = "N"
		
						SELECT PackingSlip_No
						*SELECT DISTINCT PackingSli FROM cntPackingSli INTO ARRAY aPackingSli
						LOCATE FOR PackingSli =  cntPackingSli.PackingSli
						IF FOUND("PackingSlip_NO")
							lFound = .T.
						ENDIF
					ENDIF
				ENDIF
		
				IF lFound
					IF USED('cntPackingSli')
						SELECT cntPackingSli
						GO TOP
						IF VARTYPE(cntPackingSli.PackingSli) = "N"
							*FOR i = 1 TO RECCOUNT(cntPackingSli)
							i = 0
							SCAN
								i = i +1
		
								IF i = 1
									cPS_Where = "PackingSli="+ALLTRIM(STR( cntPackingSli.PackingSli ))
								ELSE
									IF i > 80
										MESSAGEBOX("Too Many Records, Only Showing first 80")
										EXIT
									ELSE
										cPS_Where = cPS_Where + " OR  PackingSli="+ALLTRIM(STR( cntPackingSli.PackingSli ))
									ENDIF
								ENDIF
								*ENDFOR
							ENDSCAN
		
							SELECT PackingSlip_No
							SET FILTER TO &cPS_Where
						ENDIF
						USE IN cntPackingSli
					ENDIF
				ELSE
					WAIT WINDOW 'No Find !!!' NOWAIT
					SELECT PackingSlip_No
					SET FILTER TO
				ENDIF
		
			CASE UPPER(cSQL_table) = "SOLDADDR"
		
				cSQL = "SELECT SOLDADDR.Soldcode FROM dbo.SOLDADDR SOLDADDR RIGHT OUTER JOIN dbo.PACKINGSLIP_NO PACKINGSLIP_NO "
				cSQL = cSQL + " ON SOLDADDR.SOLDCODE = PACKINGSLIP_NO.SOLDCODE WHERE "+cSQL_where
				**INTO ARRAY aPackingSli
		
				*cSQL= "SELECT DISTINCT PackingSli FROM dbo.PackingSlip WHERE "+cSQL_Where
				IF USED('tmpSOLDADDRPackingSli')
					USE IN tmpSOLDADDRPackingSli
				ENDIF
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOLDADDRPackingSli')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOLDADDRPackingSli')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOLDADDRPackingSli")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOLDADDRPackingSli")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle)
				ENDIF
				lFound = .F.
		
				IF USED('tmpSOLDADDRPackingSli')
					IF VARTYPE(tmpSOLDADDRPackingSli.SoldCode) = "N"
		
						SELECT PackingSlip_No
						*SELECT DISTINCT PackingSli FROM cntPackingSli INTO ARRAY aPackingSli
						LOCATE FOR PackingSli =  tmpSOLDADDRPackingSli.SoldCode
						IF FOUND("PackingSlip_NO")
							lFound = .T.
						ENDIF
					ENDIF
				ENDIF
		
				IF lFound
					IF USED('tmpSOLDADDRPackingSli')
						SELECT tmpSOLDADDRPackingSli
						GO TOP
						IF VARTYPE(tmpSOLDADDRPackingSli.SoldCode) = "N"
							*FOR i = 1 TO RECCOUNT(cntPackingSli)
							i = 0
							SCAN
								i = i +1
		
								IF i = 1
									cPS_Where = "PackingSli="+ALLTRIM(STR( tmpSOLDADDRPackingSli.SoldCode ))
								ELSE
									IF i > 80
										MESSAGEBOX("Too Many Records, Only Showing first 80")
										EXIT
									ELSE
										cPS_Where = cPS_Where + " OR  PackingSli="+ALLTRIM(STR( tmpSOLDADDRPackingSli.SoldCode ))
									ENDIF
								ENDIF
								*ENDFOR
							ENDSCAN
		
							SELECT PackingSlip_No
							SET FILTER TO &cPS_Where
						ENDIF
						USE IN tmpSOLDADDRPackingSli
					ENDIF
				ELSE
					WAIT WINDOW 'No Find !!!' NOWAIT
					SELECT PackingSlip_No
					SET FILTER TO
				ENDIF
		
				*********************
		
		
				*SELECT DISTINCT SoldCode FROM SoldAddr WHERE &cSQL_Where INTO ARRAY aPackingSli
				IF TYPE("aPackingSli") = "N"
					FOR i = 1 TO ALEN(APACKINGSLI)
						IF i = 1
							cPS_Where = "SoldCode="+ALLTRIM(STR( APACKINGSLI(i) ))
						ELSE
							IF i > 80
								MESSAGEBOX("Too Many Records, Only Showing first 80")
								EXIT
							ELSE
								cPS_Where = cPS_Where + " OR SoldCode="+ALLTRIM(STR( APACKINGSLI(i) ))
							ENDIF
						ENDIF
					ENDFOR
		
					SELECT PackingSlip_No
					SET FILTER TO &cPS_Where
				ELSE
					WAIT WINDOW 'No Find !!!' NOWAIT
					SELECT PackingSlip_No
					SET FILTER TO
				ENDIF
		
			CASE UPPER(cSQL_table) = "SHIPADDR"
				SELECT ShipAddr.ShipCode FROM HPA!ShipAddr ShipAddr ;
					RIGHT OUTER JOIN HPA!PackingSlip_No PackingSlip_No ;
					ON ShipAddr.ShipCode = PackingSlip_No.ShipCode WHERE &cSQL_where INTO ARRAY APACKINGSLI
		
				*SELECT DISTINCT SoldCode FROM SoldAddr WHERE &cSQL_Where INTO ARRAY aPackingSli
				IF TYPE("aPackingSli") = "N"
					FOR i = 1 TO ALEN(APACKINGSLI)
						IF i = 1
							cPS_Where = "ShipCode="+ALLTRIM(STR( APACKINGSLI(i) ))
						ELSE
							IF i > 80
								MESSAGEBOX("Too Many Records, Only Showing first 80")
								EXIT
							ELSE
								cPS_Where = cPS_Where + " OR ShipCode="+ALLTRIM(STR( APACKINGSLI(i) ))
							ENDIF
						ENDIF
					ENDFOR
		
					SELECT PackingSlip_No
					SET FILTER TO &cPS_Where
				ELSE
					WAIT WINDOW 'No Find !!!' NOWAIT
					SELECT PackingSlip_No
					SET FILTER TO
				ENDIF
			CASE UPPER(cSQL_table) = "ALLQUOTES"
				SELECT AllQuotes.Soitem FROM AllQuotes ;
					RIGHT OUTER JOIN HPA!PACKINGSLIP PACKINGSLIP ;
					ON AllQuotes.Soitem = PACKINGSLIP.Soitem WHERE &cSQL_where INTO ARRAY APACKINGSLI
				IF TYPE("aPackingSli") = "C"
					FOR i = 1 TO ALEN(APACKINGSLI)
						IF i = 1
							cPS_Where = "SOItem='" + APACKINGSLI(i) + "'"
						ELSE
							IF i > 80
								MESSAGEBOX("Too Many Records, Only Showing first 80")
								EXIT
							ELSE
								cPS_Where = cPS_Where + " OR  SOItem='" + APACKINGSLI(i) +"'"
							ENDIF
						ENDIF
					ENDFOR
		
					SELECT DISTINCT PackingSli FROM PACKINGSLIP WHERE &cPS_Where INTO ARRAY APACKINGSLI
		
					IF TYPE("aPackingSli") = "N"
						FOR i = 1 TO ALEN(APACKINGSLI)
							IF i = 1
								cPS_Where = "PackingSli=" + ALLTRIM(STR( APACKINGSLI(i) ))
							ELSE
								IF i > 80
									MESSAGEBOX("Too Many Records, Only Showing first 80")
									EXIT
								ELSE
									cPS_Where = cPS_Where + " OR PackingSli=" + ALLTRIM(STR( APACKINGSLI(i) ))
								ENDIF
							ENDIF
						ENDFOR
		
						SELECT PackingSlip_No
						SET FILTER TO &cPS_Where
					ENDIF
				ELSE
					WAIT WINDOW 'No Find !!!' NOWAIT
					SELECT PackingSlip_No
					SET FILTER TO
				ENDIF
			ENDCASE
		
		
	ENDPROC

	PROCEDURE Unload
			= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmbTables.InteractiveChange
			THISFORM.ogPackingSlip.VISIBLE = .F.
			THISFORM.ogPackingSlip_No.VISIBLE = .F.
			THISFORM.ogSoldAddr.VISIBLE = .F.
			THISFORM.ogShipAddr.VISIBLE = .F.
			THISFORM.ogAllQuotes.VISIBLE = .F.
			THISFORM.ogSales.VISIBLE = .F.
		
			*PackingSlip,PackingSlip Number,Sold Address,Ship Address,Sales,All Quotes
		
			THISFORM.txt_search_text.VALUE = ""
			THISFORM.txt_search_max.VALUE  = ""
		
		
		
			**Also Sets Default Mask!, Check Interactive Change for Each og
			DO CASE
			CASE THIS.VALUE = "PackingSlip Number"
				THISFORM.ogPackingSlip_No.VISIBLE = .T.
				*PackingSli
				THISFORM.txt_search_text.INPUTMASK = "99999999"
				THISFORM.txt_search_max.INPUTMASK  = "99999999"
			CASE THIS.VALUE = "PackingSlip"
				THISFORM.ogPackingSlip.VISIBLE = .T.
				*Heat
				THISFORM.txt_search_text.INPUTMASK = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
				THISFORM.txt_search_max.INPUTMASK  = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
			CASE THIS.VALUE = "Sold Address"
				THISFORM.ogSoldAddr.VISIBLE = .T.
				*Company
				THISFORM.txt_search_text.INPUTMASK = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
				THISFORM.txt_search_max.INPUTMASK  = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
			CASE THIS.VALUE = "Ship Address"
				THISFORM.ogShipAddr.VISIBLE = .T.
				*Company
				THISFORM.txt_search_text.INPUTMASK = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
				THISFORM.txt_search_max.INPUTMASK  = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
			CASE THIS.VALUE = "All Quotes"
				THISFORM.ogAllQuotes.VISIBLE = .T.
				*Company
				THISFORM.txt_search_text.INPUTMASK = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
				THISFORM.txt_search_max.INPUTMASK  = "!!!!!!!!!!!!!!!!!!!!!!!!!!!"
			CASE THIS.VALUE = "Sales"
				THISFORM.ogSales.VISIBLE = .T.
				*SalesNum
				THISFORM.txt_search_text.INPUTMASK = "999999"
				THISFORM.txt_search_max.INPUTMASK  = "999999"
			ENDCASE
	ENDPROC

	PROCEDURE cmdAddAnd.Click
			PRIVATE lIsNumber
		
		
			cSearchText = ALLTRIM(THISFORM.txt_search_text.VALUE)
			IF EMPTY(cSearchText)
				WAIT WINDOW "Enter the text to search for!"
				RETURN
			ENDIF
		
			nSearch_in = THISFORM.oGrp_search_in.VALUE
			nSearch_how = THISFORM.oGrp_search_how.VALUE
		
		
			cSQL_field = THISFORM.GetSQL_field()
			lIsNumber = THISFORM.IsFieldNumber( cSQL_field )
			cSQL_Add = " AND " + THISFORM.getsql_where( lIsNumber, cSQL_field )
		
			THISFORM.editHoldAnd.VALUE = THISFORM.editHoldAnd.VALUE + cSQL_Add
			THISFORM.txt_search_text.VALUE = ''
			THISFORM.txt_search_max.VALUE = ''
	ENDPROC

	PROCEDURE cmdClearHold.Click
			THISFORM.editHoldAnd.VALUE = ""
			THISFORM.editHoldAnd.REFRESH()
	ENDPROC

	PROCEDURE cmdORadd.Click
			PRIVATE lIsNumber
		
		
			cSearchText = ALLTRIM(THISFORM.txt_search_text.VALUE)
			IF EMPTY(cSearchText)
				WAIT WINDOW "Enter the text to search for!"
				RETURN
			ENDIF
		
			nSearch_in = THISFORM.oGrp_search_in.VALUE
			nSearch_how = THISFORM.oGrp_search_how.VALUE
		
		
			cSQL_field = THISFORM.GetSQL_field()
			lIsNumber = THISFORM.IsFieldNumber( cSQL_field )
			cSQL_Add = " OR " + THISFORM.getsql_where( lIsNumber, cSQL_field )
		
			THISFORM.editHoldAnd.VALUE = THISFORM.editHoldAnd.VALUE + cSQL_Add
			THISFORM.txt_search_text.VALUE = ''
			THISFORM.txt_search_max.VALUE = ''
	ENDPROC

	PROCEDURE cmdReturn.Click
			THISFORM.VISIBLE = .F.
