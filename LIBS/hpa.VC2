	PROCEDURE unopen		&& Remove the open mark.
			*ThisForm.UnOpen()
		
			PRIVATE crecnum,curdbf
			IF USED("Quotes")
				curdbf = ALIAS()
				SELECT Quotes
				crecnum = RECNO()
		
				FOR i = 1 TO THISFORM.qrecn
					*SEEK AQrecN(i) ORDER InqNum IN Quotes
					IF i <= ALEN(aQrecN)
						LOCATE FOR InqNum = aQrecN(i)
						IF FOUND('Quotes')
							REPLACE Quotes.Open_ WITH .F.
							REPLACE Quotes.QuoteDate WITH DATETIME()
		
							IF CloseQuote(Quotes.ID,gnConnHandle,.F.)
		
							ELSE
								MESSAGEBOX("Could not Close 'mark' this Quote",16,"Error")
							ENDIF
						ENDIF
					ENDIF
				NEXT i
		
				IF crecnum < RECCOUNT()
					GOTO crecnum
				ELSE
					GO BOTTOM
				ENDIF
		
				IF NOT EMPTY(curdbf)
					IF USED (curdbf)
						SELECT (curdbf)
					ENDIF
				ENDIF
		
			ENDIF
		
	ENDPROC

	PROTECTED PROCEDURE winfax
			PRIVATE printfax,PAGENO,plineno,Q_faxnm ,qrfaxnum, ckoutput,m.sub ,m.v7,m.rcc,CNT,crecnum
		
			THISFORM.loadquote_no()
		
			CLEAR TYPEAHEAD
			WAIT WINDOW "Do you also want a printed copy (Y)" TO BLANK
			IF UPPER(BLANK) = "Y"
				THISFORM.printout()
			ENDIF
			Q_faxnm=qdbsendto.Fax
		
			IF TYPE('Q_Faxnm') = 'U'
				Q_faxnm=Quotes.Fax
			ENDIF
		
			PRIVATE nLenFaxNum , cFirst3Num
			nLenFaxNum = LEN(ALLTRIM(Q_faxnm))
			cFirst3Num = LEFT(Q_faxnm,3)
			DO CASE
			CASE !EMPTY(qdbsendto.CountryC)
				Q_faxnm="011"+ALLTRIM(qdbsendto.CountryC)+Q_faxnm
			CASE nLenFaxNum = 7 AND ( cFirst3Num ="675" OR cFirst3Num ="945" OR cFirst3Num ="552" OR cFirst3Num ="947" OR cFirst3Num ="963" OR cFirst3Num ="292" OR cFirst3Num ="984" )
				*LOCAL - Leave Alone
			CASE LEFT(Q_faxnm,3)="317" OR LEFT(Q_faxnm,3)="765" OR LEFT(Q_faxnm,3)="219" OR LEFT(Q_faxnm,3)="812"
				*	Q_faxnm="10102881"+Q_faxnm
				Q_faxnm="1"+Q_faxnm
			OTHERWISE
				Q_faxnm="1"+Q_faxnm
			ENDCASE
		
			Q_faxnm = Q_faxnm+SPACE(19-LEN(ALLTRIM(Q_faxnm)))
		
		
			IF FILE('\REPORTS\quote09.FRX')
				SELECT qdb
				GO TOP
				DO Progs\wfxpara.PRG WITH Q_faxnm,TIME(),DATE(),qdbsendto.NAME,qdbsendto.Company,"Quotation","FAX",STR(qdbsendto.InqNum,8),"quote",.T.,.T.
				*PARAMETER xnum,xtime,xdate,xname,xcomp,xsubj,xkeyw,xbill,filename,highsres,prntsetup
			ELSE
				WAIT WINDOW 'Report form not found' NOWAIT
			ENDIF
		
			*DO WFXPARA WITH Q_faxnm,m.delytime,m.delydate,'',ZCMP,'Quote','','',Fnamedcx,.T.,.T.
		
			THISFORM.unopen()
		
			WAIT WINDOW 'Fax routine done' NOWAIT
		
	ENDPROC

	PROTECTED PROCEDURE winfax32
			PRIVATE printfax,PAGENO,plineno,Q_faxnm ,qrfaxnum, ckoutput,m.sub ,m.v7,m.rcc,CNT,crecnum
			PRIVATE lcSalesP
		
			THISFORM.loadquote_no()
		
			CLEAR TYPEAHEAD
		
		
			PRIVATE mLinesLeft, mGotoLine
			SELECT qdb
			SET INDEX TO && use stand order - no index
			*CREATE TABLE (SYS(5)+SYS(2003)+"\"+THISFORM.quote0 ) FREE (LINE C(80), recnum N(8) )
		
			mLinesLeft = RECCOUNT('QDB')
			mGotoLine = 35
		
			IF mLinesLeft > 35 &&Add Blanks
				GOTO (mGotoLine)
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				mGotoLine = mGotoLine + 38
				mLinesLeft = mLinesLeft  - 35
			ENDIF
		
		
			DO WHILE mLinesLeft > 35
				GOTO (mGotoLine)
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				mLinesLeft = mLinesLeft - 35
				mGotoLine = mGotoLine + 38
			ENDDO
		
			Q_faxnm=qdbsendto.Fax
		
			IF TYPE('Q_Faxnm') = 'U'
				Q_faxnm=Quotes.Fax
			ENDIF
			IF EMPTY(Q_faxnm)
				MESSAGEBOX("No Fax Number!",0,"No fax Number")
				RETURN .F.
			ENDIF
			Q_faxnm = FaxProper( Q_faxnm, Quotes.CountryC)
		
		
			lcSalesP = ""
			IF TYPE("gcSalesP") = "C"
				lcSalesP = gcSalesP
			ELSE
				IF USED("Quotes")
					lcSalesP = qdbsendto.SalesP
				ENDIF
			ENDIF
			xBill = STR(qdbsendto.InqNum,8)
			xSubj = "Quotation"
			xComp = qdbsendto.Company
			xName = qdbsendto.NAME
			xtime	= TIME()
			xdate	= DATE()
			xkeyw	= ' '
			highsres	= .T.
			prntsetup	= .F.
		
			DO Progs\wfxPara32 WITH Q_faxnm ,xtime,xdate,xName,xComp,xSubj,xkeyw,xBill,"quote",highsres,prntsetup
		
			THISFORM.unopen()
		
			RETURN
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE cmdAdd.Click
		*This code is not run since the Quotes form does.
		
		PRIVATE m.cmp
		THISFORM.qbody()
		
		THISFORM.qrecn=THISFORM.qrecn+1
		DIMENSION aQrecN(THISFORM.qrecn)
		aQrecN(THISFORM.qrecn)=Quotes.InqNum
		
		WAIT WINDOW "past record was ADDED - this record is ready to be accepted" NOWAIT
		
		SELECT Quotes
		
		m.cmp = Quotes.Company
		IF NOT EOF()
			SKIP 1
			IF NOT EOF()
				IF M.cmp <> Quotes.Company
					WAIT WINDOW "record was ADDED - last of this company" NOWAIT
					SKIP -1
				ELSE
					*			SHOW GETS LEVEL 1
				ENDIF
			ELSE
				WAIT WINDOW "record was ADDED - LAST RECORD!" NOWAIT
				SKIP -1
			ENDIF
		ELSE
			WAIT WINDOW "record was ADDED - LAST RECORD!" NOWAIT
		ENDIF
		
		IF THISFORM.txtQuote_No_ID.VALUE = 0
			THISFORM.add_check_quote_no()
		ENDIF
		
		THISFORM.setbtnadd()
		THISFORM.REFRESH
		THISFORMSET.Quotes.REFRESH
	ENDPROC

	PROCEDURE cmdAddAll.Click
			PRIVATE nRecn, cCompany, dInqDate
			WAIT WINDOW "PLEASE WAIT" NOWAIT
		
			IF THISFORM.txtQuote_No_ID.VALUE = 0
				THISFORM.add_check_quote_no()
			ENDIF
		
		
			SELECT Quotes
			nRecn = RECNO()
			cCompany = Quotes.Company
			dInqDate = Quotes.InqDate
		
			SET FILTER TO Company=cCompany AND TTOD(InqDate)=TTOD(dInqDate) AND NOT ISNULL(Alloy)
			GO TOP
		
		
			DO WHILE NOT EOF()
				IF NOT ISNULL(Alloy)
					THISFORM.qbody()
		
					THISFORM.qrecn=THISFORM.qrecn+1
					DIMENSION aQrecN(THISFORM.qrecn)
					aQrecN(THISFORM.qrecn)=Quotes.InqNum
		
					SELECT Quotes
					SKIP
				ENDIF
			ENDDO
		
			SET FILTER TO
			WAIT WINDOW "All Inquires for this Company that also match this DAY were added." NOWAIT
		
			SELECT Quotes
			GOTO nRecn
		
			THISFORM.setbtnadd
			THISFORM.cmdEdit.ZORDER
			THISFORM.REFRESH
			THISFORMSET.Quotes.REFRESH
	ENDPROC

	PROCEDURE cmdAttachFile.Click
		
			THISFORM.VISIBLE = .F.
			DO FORM FORMS\QuoteAttach
			THISFORM.VISIBLE = .T.
		
			IF USED('QuoteAttach')
		
				THISFORM.lstAttach.CLEAR
				THISFORM.lstAttach.VISIBLE = .F.
		
				SELECT QuoteAttach
				SCAN
					IF NOT EMPTY(QuoteAttach.UNCFile)
						THISFORM.lstAttach.VISIBLE = .T.
						THISFORM.lstAttach.ADDITEM(QuoteAttach.FileName)
					ENDIF
				ENDSCAN
				THISFORM.lstAttach.REFRESH
			ENDIF
	ENDPROC

	PROCEDURE cmdAttachFile.OLECompleteDrag
			LPARAMETERS nEffect
	ENDPROC

	PROCEDURE cmdAttachFile.OLEDragDrop
			LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord
		
			LOCAL cFile, afiles[ 1 ]
		
			IF oDataObject.GETFORMAT( 15 )
				oDataObject.GETDATA( 15, @afiles )
				FOR EACH cFile IN afiles
					** Do something with the file
		
					PRIVATE cUNC, cFileName, nFileSize
					PRIVATE nLastSlash, nAtLastSlash
					nLastSlash = OCCURS("\",cFile)
					nAtLastSlash = AT("\",cFile,nLastSlash)
		
					IF nLastSlash = 0
						cFileName = cFile
						cUNC = ""
					ELSE
						cFileName = RIGHT(cFile,LEN(cFile)-nAtLastSlash)
						cUNC = LEFT(cFile,LEN(cFile)-LEN(cFileName))
					ENDIF
		
					nFileSize = PrepareSQLnum( FSEEK(FOPEN(cFile),0,2) / 1000000 ,'FileSize',8,2)
					*nMeg = nFileSize / 1000000
		
					SELECT QuoteAttach
					INSERT INTO QuoteAttach (UNCFile, FileName, FileSize ) VALUES (cUNC, cFileName, nFileSize )
		
					THISFORM.lstAttach.VISIBLE = .T.
					THISFORM.lstAttach.ADDITEM(cFileName)
					THISFORM.lstAttach.REFRESH
		
		
				NEXT
			ENDIF
		
		
		
	ENDPROC

	PROCEDURE cmdAttachFile.OLEDragOver
			LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord, nState
		
			IF oDataObject.GETFORMAT(15)
				THIS.OLEDROPHASDATA = 1
			ENDIF
	ENDPROC

	PROCEDURE cmdEdit.Click
			PRIVATE mLinesLeft, mGotoLine
		
			SELECT qdb
			SET INDEX TO && use stand order - no index
		
			mLinesLeft = RECCOUNT('QDB')
			mGotoLine = 35
			DO WHILE mLinesLeft > 35
				GOTO (mGotoLine)
				INSERT BLANK
				REPLACE LINE WITH "***** Page Break *****     This line will be deleted"
				DELETE
				mLinesLeft = mLinesLeft - 36
				mGotoLine = mGotoLine + 36
			ENDDO
		
			THISFORM.VISIBLE = .F.
		
			GO TOP
			ON KEY LABEL CTRL+i INSERT BLANK
			BROW WIDTH 76 TITLE "Ctrl+W SAVE. Esc NOT SAVE. Ctrl+T DELETE. Ctrl+I INSERT. Only Comments changed here will show on HTML version." WINDOW Quotes
			ON KEY LABEL CTRL+i
		
			THISFORM.VISIBLE = .T.
			PRIVATE cDescript,cInqNumP
		
			IF USED('QDB')
				*HTML Quotes uses Quote21
				SELECT qdb
				GO TOP
		
				SELECT DISTINCT InqNumP FROM qdb WHERE DESCRIPT = 'Form' OR DESCRIPT = 'Alloy' OR DESCRIPT = 'Descript' OR DESCRIPT = 'Amount' INTO ARRAY aInqNumP1
		
				PACK
		
				SCAN
					*Copy QDB.Comment to Quote21
					IF qdb.DESCRIPT = "Comments"
						cDescript	= ShowSQLtxt(qdb.LINE,'Line',80)
						cInqNumP	= qdb.InqNumP
						UPDATE Quote21 SET Cmnt = cDescript WHERE InqNumP = cInqNumP
					ENDIF
				ENDSCAN
		
				SELECT DISTINCT InqNumP FROM qdb WHERE DESCRIPT = 'Form' OR DESCRIPT = 'Alloy' OR DESCRIPT = 'Descript' OR DESCRIPT = 'Amount' INTO ARRAY aInqNumP2
		
				IF VARTYPE(aInqNumP1(1) )= "C"
					IF VARTYPE(aInqNumP1(1) )= "C"
						FOR i = 1 TO ALEN(aInqNumP1,1)
							IF ASCAN(aInqNumP2,aInqNumP1(i) ) = 0
								*Not Found in 2
								SELECT Quote21
								DELETE FOR InqNumP = aInqNumP1(i) IN Quote21
								*
							ENDIF
						NEXT
					ELSE
						*No records after QDB PACK
						SELECT Quote21
						DELETE ALL
					ENDIF
				ENDIF
		
				SELECT qdb
				GO BOTTOM
			ENDIF
		
			SELECT Quote21
			PACK
			GO BOTTOM
		
			SELECT Quotes
	ENDPROC

