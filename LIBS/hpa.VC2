		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord
		
	ENDPROC

	PROCEDURE printout		&& Print out the Quote.
		
			SELECT qdb
		
			IF FILE('\REPORTS\quote09.FRX')
				REPORT FORM \Reports\Quote09 NOCONSOLE TO PRINTER
				WAIT WINDOW 'PRINTED' NOWAIT
				addQuoteMemo( "Print", gnConnHandle )
			ELSE
				IF FILE('REPORTS\quote09.FRX')
					REPORT FORM Reports\Quote09 NOCONSOLE TO PRINTER
					WAIT WINDOW 'PRINTED' NOWAIT
					addQuoteMemo( "Print", gnConnHandle )
				ELSE
					WAIT WINDOW 'Report form not found' NOWAIT
				ENDIF
			ENDIF
		
			SELECT Quotes
		
	ENDPROC

	PROCEDURE qbody		&& Builds the body of the Quote.
		**********************************************************
		* Edites here should match the code used in Proc_Quotes:CreateHTML_Quote
		* 2 Tables are used: QDB and Quote21
		
		* Quote21 table is used by HTML Quote
		PRIVATE UNIT1,Unit2,Unit3
		PRIVATE M.T1,M.S2,M.S3,cZAmount,cZPieces,cZAlloy,cZCC
		PRIVATE nMessAns
		
		IF NOT USED('QDBsendto')
			THISFORM.qdbsendto() &&INIT IF NOT OPENED- IF USED, MUST BE CURRENT!?
		ENDIF
		
		
		IF USED('QDB')
			SELECT qdb
		ELSE
			MESSAGEBOX("The file that holds the body of the Quote 'QDB' is missing!",48,"No file")
			TrackMess("The file that holds the body of the Quote 'QDB' is missing!")
			RETURN .F.
		ENDIF
		
		
		PRIVATE cZForm
		cZForm = ""
		*DO FormDescription IN Progs\PROC_Quotes WITH cFormNumber, Zform
		cZForm = FormDescription(Quotes.FORM,Quotes.Thck)   &&Proc_Quotes
		
		SELECT qdb
		APPEND BLANK
		REPLACE LINE WITH REPLICATE("_",65)
		REPLACE InqNumP WITH Quotes.InqNumP
		REPLACE DESCRIPT WITH "line"
		
		
		APPEND BLANK
		IF FCOUNT() > 1
			REPLACE RecNum WITH RECNO("Quotes")
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "RecNum"
			REPLACE ID WITH Quotes.ID
		ELSE
			WAIT WINDOW "UPDATE QUOTEFM.DBF"
		ENDIF
		
		
		*Form: "+cZForm
		*Alloy: "+cZalloy
		*Condition Code:"+cZCC
		*cZPieces+" "+ItemDescription
		*Total Est. Weight
		*"Price Per Pound $","Price Per Foot $","Lot Price $","Price per Piece "
		*"Ship "
		*PO# "+Quotes.PO_NUM+ SPACE(10)+ "HPA SO# "
		*Metric
		*"Service Only, No material cost involved."
		*Description
		
		***
		IF Quotes.FORM != "0"
			**From '0' happens when a suply or service is purchase this not metal
			REPLACE LINE WITH "Form: "+cZForm
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "Form"
		ENDIF
		***
		
		***************************************************************
		****************************************************************
		
		****************************************************************
		****************************************************************
		IF EMPTY(Quotes.cc)
			cZCC = ''
		ELSE
			IF EMPTY(ALLTRIM(Quotes.cl))
				cZCC = ConditionCodeText(Quotes.cc)+" "
			ELSE
				cZCC = ConditionLevelText(Quotes.cc,Quotes.cl)+" "
			ENDIF
		ENDIF
		*IF NOT EMPTY(cZCC)
		*	APPEND BLANK
		*	REPLACE LINE WITH cZCC
		*	REPLACE InqNumP WITH Quotes.InqNumP
		*	REPLACE Descript WITH "Condition"
		*ENDIF
		
		***
		*cZAlloy= ''
		IF EMPTY(Quotes.Alloy)
			cZAlloy = ''+" "+cZCC+" "
		ELSE
			cZAlloy = "Alloy: "+Quotes.Alloy+" "+cZCC+" "
			IF Quotes.TN
				cZAlloy = cZAlloy + BrandName( Quotes.Alloy )
			ELSE
				cZAlloy =  cZAlloy + UniversalName( Quotes.Alloy )
			ENDIF
		ENDIF
		
		IF NOT EMPTY(Quotes.Alloy)
			IF ISNULL(cZAlloy)
				cZAlloy = cZAlloy = "Alloy: "+Quotes.Alloy
			ENDIF
			
			APPEND BLANK
			REPLACE LINE WITH cZAlloy
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "Alloy"
		ELSE
			cZAlloy= ''
		ENDIF
		
		***
		PRIVATE nPieces
		IF Quotes.Pieces > 0
			nPieces = Quotes.Pieces
			cZPieces = LTRIM(STR(Quotes.Pieces,7,0))+"Pc "
			IF Quotes.Pieces > 1
				cZPieces = LTRIM(STR(Quotes.Pieces,7,0))+"PCs "
			ENDIF
		ELSE
			nPieces = 1
			IF Quotes.Weight > 0 
				IF Quotes.FORM = "51"
					cZPieces = " " &&?!?!?!?
				ELSE
					cZPieces = " "+ALLTRIM(STR( Quotes.Weight ,9,1))+ " Pounds "
				ENDIF
			ELSE
				cZPieces = " "
			ENDIF
		ENDIF
		
		PRIVATE cItemDescriptionMetric
		cItemDescriptionMetric = ""
		cItemDescriptionMetric = ItemDescriptionMetric(Quotes.FORM, Quotes.Thck, Quotes.sz2, Quotes.sz3, Quotes.Weight, Quotes.RandLen, Quotes.Metric, Quotes.Sz1orig, Quotes.Sz2orig, Quotes.Sz3orig)
		
		PRIVATE cCutName
		IF NOT ISNULL(Quotes.Cut)
			cCutName = " "+GetCut_Name_Letter(Quotes.Cut)+""
		ELSE
			cCutName = ''
		ENDIF
		
		PRIVATE cCutTolerance
		cCutTolerance = ''
		IF NOT ISNULL(Quotes.CutOptions)
			IF cCutName = 'W' OR cCutName = 'P'
				cCutTolerance = " "+ParseCutOptionsTol(Quotes.CutOptions)+" "
			ENDIF
		ENDIF
		
		**
		DO CASE
		CASE Quotes.FORM = "75"
			SELECT qdb
			APPEND BLANK
			REPLACE LINE WITH cZPieces+" "+cItemDescriptionMetric + cCutName + cCutTolerance + "."
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "Descript"
		
			IF !EMPTY(Quotes.DESCRIPT)
				WAIT WINDOW "The fastener description line was marked for removal as default!" NOWAIT
				DELETE
			ENDIF
		CASE Quotes.FORM = "90"
			*No Description
			SELECT qdb
			APPEND BLANK
			REPLACE LINE WITH cZPieces+" "+cItemDescriptionMetric +" Machined." + cCutName + cCutTolerance + "."
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "Descript"
		OTHERWISE
			*IF Quotes.Form
			IF cItemDescriptionMetric + cCutName + cCutTolerance != [0" x " x " ]
				SELECT qdb
				APPEND BLANK
				REPLACE LINE WITH cZPieces+" "+cItemDescriptionMetric + cCutName + cCutTolerance + "."
				REPLACE InqNumP WITH Quotes.InqNumP
				REPLACE DESCRIPT WITH "Descript"
			ENDIF
		ENDCASE
		***
		PRIVATE cOtherFldP
		cOtherFldP = ''
		IF NOT EMPTY(Quotes.OtherFld) OR NOT EMPTY(Quotes.OtherP)
			SELECT qdb
			APPEND BLANK
			IF NOT EMPTY(Quotes.OtherFld)
				cOtherFldP = ALLTRIM(Quotes.OtherFld)
			ELSE
				cOtherFldP = "Additional charge "
			ENDIF
			IF NOT EMPTY(Quotes.OtherP)
				cOtherFldP = cOtherFldP + " $" + ALLTRIM( STR(Quotes.OtherP,8,2) )
			ENDIF
			REPLACE LINE WITH cOtherFldP
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "OtherFld"
		ENDIF
		***
		IF !EMPTY(Quotes.Weight)
			SELECT qdb
			APPEND BLANK
			REPLACE LINE WITH "Total Est. Weight "+Remove0(Quotes.Weight,8,1,.F.)+"#"
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "Tot Weight"
		ENDIF
		***
		
		****************************************************************************
		PRIVATE nUnitP, nTotalP, nUnitQty
		nUnitP = 0
		cZAmount = " "
		nTotalP = 0
		nUnitQty = 0
		
		*TRY PU Accounting Standard
		PRIVATE nQ_PU, nQ_P, nQ_TY, cUnit, cPUstr 
		nQ_PU 	= PrepareSQLnum(Quotes.Q_PU,'Q_PU',-1)
		nQ_P	= PrepareSQLnum(Quotes.Q_P,'Q_P',-3)
		nQ_QTY	= PrepareSQLnum(Quotes.Q_QTY,'Q_QTY',-3)
		cUnit = SUBSTR(get_Unit_PU(nQ_PU, gnConnHandle),2)  &&Drop $
		cPUstr = Get_Label_from_nPU(nQ_PU, gnConnHandle)  &&uses SQL return CHAR(7) 'Pounds,Feet,Peices..
		
		IF nQ_PU > 0 AND nQ_QTY > 0
			*cZAmount = "Price Per "+ALLTRIM(cPUstr)+":  $"+LTRIM(STR(nQ_P,8,2))+' '+cUnit
			cZAmount = "Price Per "+ALLTRIM(cPUstr)+":  $"+LTRIM(Remove0(nQ_P,12,2,.T.))+' '+cUnit
		
			nUnitP = nQ_P	
			nTotalP = nQ_QTY * nQ_P	&&do otherP get added here?
			nUnitQty = nQ_QTY 
		
		ELSE
			*run oldschool
			IF !EMPTY(Quotes.P_Lb)
		
				cZAmount = "Price Per Pound $"+LTRIM(STR(Quotes.P_Lb,8,2))
				nUnitP = Quotes.P_Lb
				cUnit = "/Lb"
				nTotalP = nUnitP * Quotes.Weight
		
				nUnitQty = GetUnitQty(nPieces,Quotes.Alloy,Quotes.FORM,Quotes.Thck,Quotes.sz2,Quotes.sz3,gnConnHandle)
			ENDIF
			IF !EMPTY(Quotes.P_Ft)
		
				cZAmount = "Price Per Foot $"+LTRIM(STR(Quotes.P_Ft,8,2))
				nUnitP = Quotes.P_Ft
				cUnit = "/Ft"
				IF NOT EMPTY(Quotes.sz3)
					nTotalP = nUnitP * (Quotes.sz3 / 12) * nPieces
					nUnitQty = (Quotes.sz3 / 12) * nPieces
				ELSE
					*Could Be Bar priced per foot.
					IF NOT Uses3rdDim( Quotes.FORM )
						nTotalP = nUnitP * (Quotes.sz2 / 12) * nPieces
						nUnitQty = (Quotes.sz2 / 12) * nPieces
					ENDIF
				ENDIF
				*	WAIT WINDOW "nUnitQty (FT)="+STR(nUnitQty,10,3)
		
			ENDIF
			IF !EMPTY(Quotes.LotP)
		
				cZAmount = "Lot Price $"+Remove0(Quotes.LotP,9,2,.T.)
				nUnitP = Quotes.LotP
				cUnit = "Lot"
				nTotalP = nUnitP
				nUnitQty = 1
			ENDIF
			IF !EMPTY(Quotes.P_Pc)
		
				cZAmount = "Price per Piece $"+LTRIM(STR(Quotes.P_Pc,8,2))
				nUnitP = Quotes.P_Pc
				cUnit = "/Pc"
				nTotalP = nUnitP * nPieces
				nUnitQty = nPieces
			ENDIF
		ENDIF
		
		PRIVATE nCutCharge
		nCutCharge = 0
		IF !EMPTY(Quotes.Cuts)
			cZAmount = cZAmount + "  +Total cut charge $" + STR(Quotes.Cuts,4,0)
			nCutCharge = Quotes.Cuts
		ENDIF
		
		SELECT qdb
		APPEND BLANK
		REPLACE LINE WITH cZAmount
		REPLACE InqNumP WITH Quotes.InqNumP
		REPLACE DESCRIPT WITH "Amount"
		
		IF !EMPTY(Quotes.LeadTime)
			SELECT qdb
			APPEND BLANK
			REPLACE LINE WITH "Ship "+ALLTRIM(Quotes.LeadTime)
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "LeadTime"
		ENDIF
		***
		PRIVATE nComLine, nForLoop, c70Chars, nSpaceLocation
		IF !EMPTY(Quotes.Comments)
			nComLine = ALINES(aComments, Quotes.Comments, .T. )
			FOR nForLoop = 1 TO nComLine
		
				cAllChars = aComments(nForLoop)
				DO WHILE LEN( cAllChars ) > 0
					IF LEN(cAllChars) <= 72
						c70Chars = cAllChars
						cAllChars = ""
					ELSE
						nSpaceLocation = 72
						nSpaceLocation = ATCC( " ",SUBSTRC(cAllChars,58,14) )
						IF nSpaceLocation = 0
							nSpaceLocation = 72
						ELSE
							nSpaceLocation = 57 + nSpaceLocation
						ENDIF
						c70Chars = LEFT( cAllChars ,nSpaceLocation)
						cAllChars = RIGHT( cAllChars, LEN( cAllChars) - LEN(c70Chars) )
					ENDIF
		
					SELECT qdb
					APPEND BLANK
					REPLACE LINE WITH c70Chars
					REPLACE InqNumP WITH Quotes.InqNumP
					REPLACE DESCRIPT WITH "Comments"
				ENDDO
			ENDFOR
		ELSE
			*No Comment: Enter Blank Comment SO HTML Edit can use it.
			SELECT qdb
			APPEND BLANK
			REPLACE LINE WITH ''
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "Comments"
		ENDIF
		
		PRIVATE cPO_Num, nSalesNum
		cPO_Num = PrepareSQLtxt(Quotes.PO_Num,'PO_num',20)
		nSalesNum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		
		SELECT qdb
		APPEND BLANK
		IF NOT EMPTY(Quotes.PO_Num)
		
			IF NOT THISFORM.ConfirmOrder
				nMessAns = MESSAGEBOX("Do you want to send as an 'Order Confirmation'?", 4+32)
				IF nMessAns = 6
					REPLACE LINE WITH "PO# "+cPO_Num+ SPACE(10)+ "HPA SO# "+LTRIM(STR(nSalesNum,7))
		
					REPLACE InqNumP WITH Quotes.InqNumP
					REPLACE DESCRIPT WITH "SO Conf"
					THISFORM.ConfirmOrder = .T.
				ENDIF
			ELSE
				REPLACE LINE WITH "PO# "+cPO_Num+ SPACE(10)+ "HPA SO# "+LTRIM(STR(nSalesNum,7))
				REPLACE InqNumP WITH Quotes.InqNumP
				REPLACE DESCRIPT WITH "SO Conf"
			ENDIF
		ENDIF
		
		PRIVATE cReturnM
		IF Quotes.Metric
			cSZ3Orig = PrepareSQLtxt(Quotes.Sz3orig,'Sz3Orig',20)
			cReturnM = IIF( EMPTY(Quotes.Sz1orig+Quotes.Sz2orig+Quotes.Sz3orig),"", "Metric Size : " ;
				+ IIF( EMPTY(Quotes.Sz1orig),"",       ALLTRIM(Quotes.Sz1orig)) ;
				+ IIF( EMPTY(Quotes.Sz2orig),""," x "+ ALLTRIM(Quotes.Sz2orig)) ;
				+ IIF( EMPTY(cSZ3Orig) OR cSZ3Orig="0",""," x "+ ALLTRIM(Quotes.Sz3orig)) ;
				+ IIF( PrepareSQLlogic(Quotes.RandLen,'RandLen',.F.)," R/L","" ) ;
				)
		
			SELECT qdb
			APPEND BLANK
			REPLACE LINE WITH cReturnM
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "Metric"
		ENDIF
		
		IF Quotes.Regret
			SELECT qdb
			APPEND BLANK
			REPLACE LINE WITH "Regret, not able to quote."
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "Regret"
			*See in HTML Quote for Quotes.Regret
		ENDIF
		
		IF Quotes.Services
			SELECT qdb
			APPEND BLANK
			REPLACE LINE WITH "Service Only, No material cost involved."
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "Service"
		ENDIF
		
		IF !EMPTY(ALLTRIM(Quotes.DESCRIPT))
			SELECT qdb
			APPEND BLANK
			REPLACE LINE WITH Quotes.DESCRIPT
			REPLACE InqNumP WITH Quotes.InqNumP
			REPLACE DESCRIPT WITH "QDescript"
		ENDIF
		
		*IF EMPTY(cUnit)
		*	*cUnit = "/"+FormUnitPrice( Quotes.FORM, gnConnHandle )
		*	cUnit = get_Unit_PU(nQ_PU, gnConnHandle)
		*ENDIF
		************************************************
		*** Quote21 Table is used by HTML Quote
		************************************************
		PRIVATE cCmnt
		PRIVATE cQ12_PC_Desc
		
		IF USED('Quote21')
			SELECT Quote21
			*(Pieces N(10,2),UnitQty N(10,2), Descript M, LBS N(10,1), UnitP N(12,4), Unit C(3), TotalP N(12,4),Cmnt M, recnum N(8) )
			APPEND BLANK
		
			cQ12_PC_Desc = ''
			IF Quotes.Pieces > 0
				IF nPieces = 1
					cQ12_PC_Desc = ALLTRIM(STR(nPieces))+" Pc " + cItemDescriptionMetric
				ELSE
					cQ12_PC_Desc = ALLTRIM(STR(nPieces))+" Pcs " + cItemDescriptionMetric
				ENDIF
			ELSE
				cQ12_PC_Desc = cItemDescriptionMetric
			ENDIF
		
			IF cItemDescriptionMetric + cCutName = [0" x " x " ]
				*Do not store cItemDescriptionMetric
				REPLACE DESCRIPT WITH cZAlloy + " "
			ELSE
				REPLACE DESCRIPT WITH cZAlloy + cQ12_PC_Desc
			ENDIF
		
		
			cCmnt = cCutName+" "+cCutTolerance
		
			cCmnt = cCmnt ;
				+IIF(EMPTY(Quotes.Cuts),'',CHR(13)+"  +Total cut charge $" + STR(Quotes.Cuts,4,0) );
				+IIF(EMPTY(Quotes.LeadTime),'',CHR(13)+"Ship "+ALLTRIM(Quotes.LeadTime));
				+IIF(EMPTY(Quotes.DESCRIPT),'',CHR(13)+Quotes.DESCRIPT);
				+IIF(EMPTY(Quotes.Comments),'',CHR(13)+Quotes.Comments);
				+IIF(THISFORM.ConfirmOrder, CHR(13)+"PO# "+cPO_Num+ SPACE(10)+ "HPA SO# "+LTRIM(STR(nSalesNum,7)),'');
				+IIF(Quotes.Metric,CHR(13)+cReturnM ,'')
		
			*	 +IIF(Quotes.Services,CHR(13)+"Service Only, No material cost involved.",'')
		
			cCmnt = ALLTRIM(cCmnt)
			IF LEFT(cCmnt,1) = CHR(13)
				cCmnt = RIGHT( cCmnt, LEN(cCmnt)-1)
			ENDIF
			IF LEFT(cCmnt,1) = CHR(13)
				cCmnt = RIGHT( cCmnt, LEN(cCmnt)-1)
			ENDIF
			IF LEFT(cCmnt,1) = CHR(13)
				cCmnt = RIGHT( cCmnt, LEN(cCmnt)-1)
			ENDIF
			REPLACE Cmnt 	 WITH cCmnt
		
			*REPLACE UnitQty WITH PrepareSQLnum(nUnitQty,'UnitQty',10,2)
			REPLACE Q_Qty WITH PrepareSQLnum(nUnitQty,'UnitQty',10,2)
			REPLACE OtherP WITH cOtherFldP
		
			PRIVATE nLBS
			nLBS = PrepareSQLnum(Quotes.Weight,'Weight',9,1)
			IF nLBS = 0
				nLBS = getweight(nPieces,Quotes.Alloy,Quotes.FORM,Quotes.Thck,Quotes.sz2,Quotes.sz3,gnConnHandle)
			ENDIF
			REPLACE LBS 	WITH nLBS
			*	REPLACE LBS 	WITH Quotes.Weight
		
			*REPLACE UnitP	WITH nUnitP IN Quote21
			REPLACE Q_P	WITH nUnitP IN Quote21
		
			REPLACE PU 	WITH nQ_PU
			
			REPLACE TotalP 	WITH nTotalP
			*	REPLACE CutCharge WITH nCutCharge
			REPLACE RecNum	WITH RECNO("Quotes")
		
			PRIVATE lRegret
			lRegret = PrepareSQLlogic(Quotes.Regret,'Regret',.F.)
			REPLACE Regret  WITH lRegret
		
			PRIVATE lServices
			lServices = PrepareSQLlogic(Quotes.Services,'Services',.F.)
			REPLACE Services WITH lServices
		ENDIF
		************************************************
		
		SELECT qdb
		
		RETURN
		
	ENDPROC

	PROCEDURE qdbsendto		&& Stores Information for SendQuote.
		*QDBsendTo
		
		IF USED('QDBsendto')
			USE IN QDBsendto
		ENDIF
		
		ThisForm.fnQDBsendto = UniqDBF(ThisForm.fnQDBsendto)
		
		SELECT 0
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQDBsendto) FREE ;
				(NAME C(25), Company C(30), Phone C(11), Phone_Ext C(6), Fax C(11), Email C(60), PO_Num C(17);
				, SalesP C(1), InqNum N(7,0), InqNumP C(8), CountryC C(10), CustDisc N(3,2) )
			USE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQDBsendto) EXCL ALIAS QDBsendto
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQDBsendto) FREE ;
				(NAME C(25), Company C(30), Phone C(11), Phone_Ext C(6), Fax C(11), Email C(60), PO_Num C(17);
				, SalesP C(1), InqNum N(7,0), InqNumP C(8), CountryC C(10), CustDisc N(3,2) )
			USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQDBsendto) EXCL ALIAS QDBsendto
		ENDIF
		
		IF NOT USED('QDBsendto')
			MESSAGEBOX("You may have another session open that has locked the 'QDB send to' file.",16,"Could not create temp file")
			RETURN
		ENDIF
		
		PRIVATE cSafety
		cSafety = SET('SAFETY')
		SET SAFETY OFF
		
		SELECT qdbsendto
		ZAP IN qdbsendto
		APPEND BLANK
		REPLACE NAME		WITH PrepareSQLtxt(Quotes.NAME,'Name',25)
		REPLACE	Company 	WITH PrepareSQLtxt(Quotes.Company,'Company',30)
		REPLACE	Phone 		WITH PrepareSQLphone(Quotes.Phone,'Phone',10)
		REPLACE	Phone_Ext	WITH PrepareSQLtxt(Quotes.Phone_Ext,'Phone_Ext',6)
		REPLACE Fax			WITH PrepareSQLphone(Quotes.Fax,'Fax')
		REPLACE	PO_Num		WITH PrepareSQLtxt(Quotes.PO_Num,'PO_num',20)
		REPLACE	SalesP		WITH PrepareSQLtxt(Quotes.SalesP,'SalesP',1)
		REPLACE	InqNum		WITH PrepareSQLnum(Quotes.InqNum,'InqNum',-3)
		REPLACE	InqNumP		WITH ALLTRIM(STR(qdbsendto.InqNum))+qdbsendto.SalesP
		REPLACE Email 		WITH PrepareSQLemail(Quotes.Email,'Email',60)
		REPLACE CountryC	WITH PrepareSQLtxt(Quotes.CountryC,'CountryC',10)
		REPLACE CustDisc 	WITH PrepareSQLnum(Quotes.CustDisc,'CustDisc',3,2)
		
		SET SAFETY &cSafety
		
		SELECT Quotes
		
	ENDPROC

	PROCEDURE qdbtoquote		&& Look for QDB edit to copy to Quote12
			*ThisForm.QDBtoQuote()
			*Find QDB edits to apply to Quote21
		
			IF NOT USED('QDB')
				RETURN .F.
			ENDIF
			RETURN .T.
		
			PRIVATE cSQL, nSQLEXEC
		
			SELECT qdb
		
			IF nQuote_No_ID = 0
		
				cSQL = "SELECT 0 AS ID "
				cSQL = cSQL + ",0 AS Revision "
				cSQL = cSQL + ",getdate() AS ExpireDate "
				cSQL = cSQL + ",CAST(0 AS BIT) AS ProdReqDefine "
				cSQL = cSQL + ",CAST(0 AS BIT) AS DiffResolved "
				cSQL = cSQL + ",CAST(0 AS BIT) AS HPAcapable "
				cSQL = cSQL + ",'' AS Comments "
				*	cSQL = cSQL + " FROM [dbo].[Quote_No] QN"
				*	cSQL = cSQL + " WHERE 0 > 0"
			ELSE
				cSQL = "SELECT QN.ID "
				cSQL = cSQL + ",Revision "
				cSQL = cSQL + ",ExpireDate "
				cSQL = cSQL + ",ProdReqDefine "
				cSQL = cSQL + ",DiffResolved "
				cSQL = cSQL + ",HPAcapable "
				cSQL = cSQL + ",Comments "
				cSQL = cSQL + " FROM [dbo].[Quote_No] QN"
				cSQL = cSQL + " WHERE QN.ID = "+STR(nQuote_No_ID)
			ENDIF
		
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quote_No' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quote_No' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "Quote_No")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "Quote_No")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle,nSQLEXEC,'Quote_No' )
			ENDIF
		
			IF NOT USED('Quote_No')
				MESSAGEBOX("Could not load the 'Quote_No' table data!",0+16,"Report will not print!")
			ENDIF
		
		
	ENDPROC

	PROCEDURE reload
		IF Quotes.SalesP ="Z" OR Quotes.SalesP ="X" OR Quotes.SalesP ="0" OR Quotes.SalesP ="1"
			IF NOT EMPTY(Quotes.COVER)
				THISFORM.SalesP = Quotes.COVER
			ELSE
				THISFORM.SalesP = Quotes.SalesP
			ENDIF
		ELSE
			THISFORM.SalesP = Quotes.SalesP
			IF VARTYPE(Quotes.COVER) = "C"
				IF NOT EMPTY(Quotes.COVER)
					*Why is there a Cover
					*			IF MESSAGEBOX("Do you want to use the Cover SalesP?",4,"Use Cover?") = 6
					THISFORM.SalesP = Quotes.COVER
					*			ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		THISFORM.quote	= THISFORM.SalesP+SYS(3)
		THISFORM.quote0 = ALLTRIM(UPPER(THISFORM.quote))+".DBF"
		
		IF USED('QDB')
			USE IN qdb
		ENDIF
		
		IF USED(THISFORM.quote0)
			SELECT (THISFORM.quote0)
			USE
		ENDIF
		
		PRIVATE cSafety
		cSafety = SET('SAFETY')
		SET SAFETY OFF
		
		SELECT 0
		
		IF "\MEM" $ SYS(2003)	
			CREATE TABLE ( SYS(5)+SYS(2003)+"\"+THISFORM.quote0 ) FREE (LINE C(80), RecNum N(8), InqNumP C(9), DESCRIPT C(10), ID i )
			USE (SYS(5)+SYS(2003)+"\"+THISFORM.quote0) EXCL ALIAS qdb
		ELSE
			CREATE TABLE ( SYS(5)+SYS(2003)+"\MEM\"+THISFORM.quote0 ) FREE (LINE C(80), RecNum N(8), InqNumP C(9), DESCRIPT C(10), ID i )
			USE (SYS(5)+SYS(2003)+"\MEM\"+THISFORM.quote0) EXCL ALIAS qdb
		ENDIF
		
		*******************
		
		ThisForm.fnQuote = UniqDBF(ThisForm.fnQuote)
		
		IF USED('Quote12')
			*Old temp file
			USE IN Quote12
		ENDIF
		
		IF USED('Quote21')
			USE IN Quote21
		ENDIF
		IF "\MEM" $ SYS(2003)	
			IF FILE(SYS(5)+SYS(2003)+"\"+ThisForm.fnQuote) &&Clean the file
				SELECT 0
				USE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuote) EXCL ALIAS Quote21
				IF USED('Quote21')
					ZAP
				ENDIF
			ELSE &&Create file
				*Replicate changes in QuoteBody.scx
				SELECT 0
				
				*CREATE TABLE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuote) FREE (Pieces N(10,2), UnitQty N(10,2), DESCRIPT C(254), LBS N(10,1), UnitP N(12,4), Unit C(3), TotalP N(12,4),Cmnt m, RecNum N(8), Regret L, Services L, InqNumP C(9), OtherP m )
				CREATE TABLE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuote) FREE (Pieces N(10,2), Q_QTY N(12,4), DESCRIPT C(254), LBS N(9,1), Q_P N(12,4), PU N(2), TotalP N(12,4),Cmnt m, RecNum N(8), Regret L, Services L, InqNumP C(9), OtherP m )
				USE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuote) EXCL ALIAS Quote21
			ENDIF
		ELSE
			IF FILE(SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuote) &&Clean the file
				SELECT 0
				USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuote) EXCL ALIAS Quote21
				IF USED('Quote21')
					ZAP
				ENDIF
			ELSE &&Create file
				*Replicate changes in QuoteBody.scx
				SELECT 0
				
				*CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuote) FREE (Pieces N(10,2), UnitQty N(10,2), DESCRIPT C(254), LBS N(10,1), UnitP N(12,4), Unit C(3), TotalP N(12,4),Cmnt m, RecNum N(8), Regret L, Services L, InqNumP C(9), OtherP m )
				*CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuote) FREE (Pieces N(10,2), UnitQty N(10,2), DESCRIPT C(254), LBS N(10,1), UnitP N(12,4), Unit C(3), TotalP N(12,4),Cmnt m, RecNum N(8), Regret L, Services L, InqNumP C(9), OtherP m )
				CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuote) FREE (Pieces N(10,2), Q_QTY N(12,4), DESCRIPT C(254), LBS N(9,1), Q_P N(12,4), PU N(2), TotalP N(12,4),Cmnt m, RecNum N(8), Regret L, Services L, InqNumP C(9), OtherP m )
				USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuote) EXCL ALIAS Quote21
			ENDIF	
		ENDIF
		
		
		*******************
		*Remove Old files
		IF FILE(SYS(5)+SYS(2003)+"\QuoteTerms.DBF")
			IF USED("QuoteTerms")
				USE IN QuoteTerms
			ENDIF
			DELETE FILE (SYS(5)+SYS(2003)+"\QuoteTerms.DBF")
		ENDIF
		
		ThisForm.fnQuoteTerms = UniqDBF(ThisForm.fnQuoteTerms)
		
		
		IF FILE(SYS(5)+SYS(2003)+"\"+ThisForm.fnQuoteTerms) &&Remove if old Edition
			SELECT 0
			USE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuoteTerms) EXCL ALIAS QuoteTerms
			IF USED('QuoteTerms')
				PRIVATE lNewVersion
				lNewVersion = .F.
		
				FOR gnCount = 1 TO FCOUNT( )  && Loop for number of fields
					IF FIELD(gnCount) = "DOMESTIC"
						lNewVersion = .T.
					ENDIF
				NEXT
		
		*!*			IF NOT lNewVersion
		*!*				USE IN QuoteTerms
		*!*				DELETE FILE (SYS(5)+SYS(2003)+"\QuoteTerms.DBF")
		*!*			ENDIF
			ENDIF
		ENDIF
		
		IF USED('QuoteTerms')
			USE IN QuoteTerms
		ENDIF
		
		
		IF "\MEM" $ SYS(2003)
			IF FILE(SYS(5)+SYS(2003)+"\"+ThisForm.fnQuoteTerms) &&Clean the file
				SELECT 0
				USE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuoteTerms) EXCL ALIAS QuoteTerms
				IF USED('QuoteTerms')
					SELECT QuoteTerms
					ZAP
				ENDIF
			ELSE &&Create file
				SELECT 0
				*CREATE TABLE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuoteTerms) FREE (terms C(254),PriorSale L, FedEx_Exp L, CCards L, USDollars L, CutPack L, FOBT L, FOBW L, FOBEXW L,EXW C(254),Survey L, AdvWJet L, SumTotal L, DFARS L, DOMESTIC L, RFQ C(254))
				CREATE TABLE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuoteTerms) FREE (terms C(254),PriorSale L, FedEx_Exp L, CCards L, USDollars L, CutPack L, FOBT L, FOBW L, FOBEXW L,EXW C(254),Survey L, AdvWJet L, HDPlasma L, SumTotal L, DFARS L, DOMESTIC L, RFQ C(254))
				USE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuoteTerms) EXCL ALIAS QuoteTerms
			ENDIF
		ELSE
			IF FILE(SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuoteTerms) &&Clean the file
				SELECT 0
