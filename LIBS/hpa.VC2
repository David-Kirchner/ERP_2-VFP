	PROCEDURE remove0		&& Removes the 0 when using STR().
			PARAMETER M.NUMW0,M.TN,M.TD
			PRIVATE M.CHAR, M.NUMW0,M.TN,M.TD
			***remove0
		
			IF TYPE('TD') = 'L'
				WAIT WINDOW 'Decimals may have been dropped'
				RETURN LTRIM(STR(M.NUMW0))
			ENDIF
		
			m.CHAR = STR(M.NUMW0,M.TN,M.TD)
		
			IF M.TD > 1
				*EX: LIST .040 WITH THE ZERO
				IF VAL(RIGHT(M.CHAR,2)) > 0
					RETURN LTRIM(M.CHAR)
				ENDIF
			ENDIF
		
			DO WHILE .T.
				DO CASE
				CASE RIGHT(M.CHAR,1) = '0'
					m.CHAR=LEFT(M.CHAR,LEN(M.CHAR)-1)
				CASE RIGHT(M.CHAR,1) = '.'
					m.CHAR=LEFT(M.CHAR,LEN(M.CHAR)-1)
					RETURN LTRIM(M.CHAR)
				OTHERWISE
					RETURN LTRIM(M.CHAR)
				ENDCASE
			ENDDO
	ENDPROC

	PROCEDURE saveqa		&& Saves and updates QA Quote.
			*ThisForm.SaveQA()
			*Check for Record, Save first if needed.
		
			PRIVATE lJustExit
			lJustExit = .T.
		
			PRIVATE nQIDArrayCount ,nArrayCount, cContents, nQuotesMatch
			cContents = ''
			nQuotesMatch = 0
		
			PRIVATE nCurrentRec
			SELECT Quotes
			nCurrentRec = RECNO('Quotes')
		
			PRIVATE cSQL, nSQLEXEC
		
			PRIVATE nQNRev, cInqNumP, nInqNum, nAQID, nQuote_No_ID, nRecnumArrayCount
			cInqNumP = ''
			nInqNum = 0
			nAQID = 0
			nRecnumArrayCount = 0
		
			IF USED('QDB')
				SELECT qdb
		
				*************
				DIMENSION aQuoteRecnums (1)
				aQuoteRecnums(1) = 0
		
				nQIDArrayCount = 0
				PRIVATE lDeleteOld
				lDeleteOld = .F.
		
				SELECT DISTINCT qdb.RecNum FROM qdb INTO ARRAY aQuoteRecnums WHERE NOT DELETED() AND NOT EMPTY(RecNum) ORDER BY [RecNum]
		
				IF VARTYPE(aQuoteRecnums(1)) = 'N'
					nRecnumArrayCount = ALEN(aQuoteRecnums,1)
					IF nRecnumArrayCount  = 1
						**ALEN comes back as 1 even when empty
						IF aQuoteRecnums(1) = 0
							nRecnumArrayCount  = 0
						ENDIF
					ENDIF
		
					**
					IF nRecnumArrayCount > 0
						SELECT Quotes
						*nCurrentRec = RECNO()
		
						SELECT InqNumP,InqNum,ID FROM Quotes WHERE RECNO() = aQuoteRecnums(1) INTO ARRAY aQRecNo
		
						IF VARTYPE(aQRecNo) = "C"
							IF VARTYPE(aQRecNo(1)) = "C"
								cInqNumP = aQRecNo(1)
								nInqNum = aQRecNo(2)
								nAQID = aQRecNo(3)
							ENDIF
						ENDIF
		
		
						SELECT Quotes
						IF nCurrentRec <= RECCOUNT()
							GOTO (nCurrentRec)
						ELSE
							IF  aQuoteRecnums(1) <= RECCOUNT()
								GOTO ( aQuoteRecnums(1) )
							ELSE
								GO TOP				
							ENDIF
						ENDIF
		
		
						**
						*Check for Valid QuoteNumber before Deleteting old
		
						IF aQuoteRecnums(1) > 0
							lDeleteOld = .T.
		
							nQuote_No_ID = get_Quote_No_ID(InqNumP, gnConnHandle )
							cInqNumP = get_Quote_No_InqNumP(nAQID , gnConnHandle )
							nQNRev = get_Quote_No_Revision(nAQID , gnConnHandle )
		
						ELSE
							nQuote_No_ID = 0
							cInqNumP = ''
							nQNRev = 0
						ENDIF
		
						IF lDeleteOld
							IF VARTYPE(cInqNumP) = "C"
								IF NOT EMPTY(cInqNumP)
									cSQL = "DELETE FROM [dbo].[Quote_No] WHERE InqNumP = '"+cInqNumP+"'"
		
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
									ENDDO
									IF nSQLEXEC < 0 &&Try again!
										nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL 2' TIMEOUT 1
											nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
											
											IF nSQLEXEC < 0
												IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
													nSQLEXEC = 0
												ENDIF
											ENDIF
										ENDDO
									ENDIF 
									IF nSQLEXEC < 0
										SQLEXECError(cSQL,gnConnHandle,nSQLEXEC)
									ENDIF
								ELSE
									*MESSAGEBOX("InqNumP is Empty!"+CHR(13)+"Problem with InqNum or SalesP.",16,"Error")
								ENDIF
							ELSE
								*MESSAGEBOX("InqNumP is Empty!"+CHR(13)+"Problem with InqNum or SalesP.",16,"Error")
							ENDIF
						ENDIF
		
		
						IF VARTYPE(nQNRev) != 'N'
							nQNRev = 0
						ENDIF
						nQNRev = nQNRev + 1
		
					ELSE
		
						*			MESSAGEBOX('Nothing to save!',0+64,"Cannot Save.")
						RETURN .F.
					ENDIF
				ENDIF
		
				*************
				PRIVATE nOldQuote_No_id
				nOldQuote_No_id = nQuote_No_ID
		
		
				PRIVATE cSalesp, cAllQuotes_IDs
				cSalesp = THISFORM.SalesP
				cAllQuotes_IDs  = ''
		
				*	cSalesP = Quotes.SalesP
				IF EMPTY(cInqNumP)
					cInqNumP = Proper_InqNumP( nInqNum, cSalesp )
				ENDIF
		
				DIMENSION aQuotes_IDs [1]
				STORE 0 TO aQuotes_IDs(1)
		
				IF nRecnumArrayCount  > 0
					SELECT Quotes
					*nCurrentRec = RECNO()
		
					*nRecnumArrayCount = ALEN(aQuoteRecnums,1) &&Refresh the Count
					FOR i = 1 TO ALEN(aQuoteRecnums,1)
		
						SELECT ID FROM Quotes WHERE RECNO() = aQuoteRecnums(i) INTO ARRAY aQuotes_IDs
						IF ALEN(aQuotes_IDs,1) > 0
							IF aQuotes_IDs(1) > 0
		
								IF i > 1
									cAllQuotes_IDs = cAllQuotes_IDs + ","
								ENDIF
		
								cAllQuotes_IDs = cAllQuotes_IDs + ALLTRIM(STR( aQuotes_IDs(1) ))
							ENDIF
						ENDIF
					NEXT i
		
					SELECT Quotes
					IF nCurrentRec <= RECCOUNT()
						GOTO (nCurrentRec)
					ELSE
		*				IF  aQuoteRecnums(1) <= RECCOUNT()
		*					GOTO ( aQuoteRecnums(1) )
		*				ELSE
							GO TOP				
		*				ENDIF
					ENDIF
					
				ELSE
					cAllQuotes_IDs = ''
				ENDIF
		
				DIMENSION aQuoteLines(1)
				aQuoteLines(1) = ''
				nArrayCount = 0
		
				IF nRecnumArrayCount  > 0
					SELECT LINE FROM qdb INTO ARRAY aQuoteLines WHERE NOT DELETED()
					IF VARTYPE(aQuoteLines(1)) = 'C'
						nArrayCount = ALEN(aQuoteLines,1)
						FOR i = 1 TO nArrayCount
							cContents = cContents + PrepareSQLtxt( aQuoteLines( i ),'Quote Line',80)+CHR(13)
						NEXT i
		
						IF nInqNum > 0
		
							cSQL="INSERT INTO dbo.Quote_No (InqNum,InqNumP,SalesP,Revision,Contents,AllQuotes_IDs) VALUES ("
							cSQL = cSQL + ""+STR(nInqNum)+""
							cSQL = cSQL + ",'"+cInqNumP+"'"
							cSQL = cSQL + ",'"+cSalesp+"'"
							cSQL = cSQL + ","+STR(nQNRev)+""
							cSQL = cSQL + ",'"+cContents+"'"
							cSQL = cSQL + ",'"+cAllQuotes_IDs+"'"
							cSQL = cSQL + ") "
		
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,gnConnHandle,nSQLEXEC)
							ENDIF
		
						ENDIF
					ENDIF
				ENDIF
		
				*************
		
				IF nRecnumArrayCount  > 0
					**
					IF nOldQuote_No_id > 0
						cSQL = "DELETE FROM dbo.Quote_No_AQID WHERE Quote_No_id = "+STR(nOldQuote_No_id )
		
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,gnConnHandle,nSQLEXEC)
						ENDIF
					ENDIF
					**
		
					nQuote_No_ID = get_Quote_No_ID(cInqNumP, gnConnHandle )
		
					THISFORM.txtQuote_No_ID.VALUE = nQuote_No_ID
		
		
					FOR i = 1 TO nRecnumArrayCount
						nQuotesMatch = 0
						SELECT Quotes
						COUNT FOR RECNO() = aQuoteRecnums(i) TO nQuotesMatch
		
						IF nQuotesMatch > 0
		
							SELECT ID FROM Quotes WHERE RECNO() = aQuoteRecnums(i) INTO ARRAY anID_Quote
		
							IF anID_Quote > 0 AND nQuote_No_ID > 0
		
								cSQL="INSERT INTO dbo.Quote_No_AQID (AllQuotes_ID ,Quote_No_id) VALUES ("
								cSQL = cSQL + ""+STR(anID_Quote)+""
								cSQL = cSQL + ","+STR(nQuote_No_ID)+""
								cSQL = cSQL + ") "
		
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,gnConnHandle,nSQLEXEC)
		
								ENDIF
							ELSE
								MESSAGEBOX("Missing ID_Quote OR Quote_No_ID!",16,"Error")
							ENDIF
						ENDIF
					NEXT i
				ENDIF
		
			ELSE
				*	MESSAGEBOX("No DATA to save",0,"Table QDB not found!")
			ENDIF
		
			SELECT Quotes
			*GOTO (nCurrentRec)
			IF nCurrentRec <= RECCOUNT('Quotes')
				GOTO (nCurrentRec)
			ELSE
				GO TOP				
			ENDIF
			
			RETURN .T.
	ENDPROC

