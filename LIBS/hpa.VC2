	PROCEDURE tempfield.GotFocus
			IF THISFORMSET.gotfocuslast = THISFORMSET.metricgotfocus+"F"
				KEYBOARD '{DNARROW}' CLEAR
			ELSE
				IF THISFORMSET.gotfocuslast = THISFORMSET.metricgotfocus+"B"
					KEYBOARD '{UPARROW}' CLEAR
				ELSE
					***
				ENDIF
			ENDIF
		
	ENDPROC

	PROCEDURE tempfield.KeyPress
			LPARAMETERS nKeyCode, nShiftAltCtrl
			PRIVATE cOldSelect, MetricValue
		
			cOldSelect = ALIAS()
			MetricValue = THIS.VALUE
			THISFORMSET.gotfocusnow = THISFORMSET.metricgotfocus
		
			PRIVATE lnReturnVal
			IF INLIST(nKeyCode, 9, 13, 10, 24, 145, 160 )
				*Down Arrow 24 50 145 160
				*TAB 9
				*ENTER  13 13 10
				*RIGHT ARROW 4 54 2
				*Key that makes you go to next object
		
				lnReturnVal = THISFORMSET.convertthis(THIS.VALUE,"FORWARD")
				THISFORMSET.gotfocuslast = THISFORMSET.metricgotfocus+"F"
				SELECT Quotes
				DO CASE
				CASE THISFORMSET.metricgotfocus = "THCK1"
					IF EMPTY(Starting_Stock.Sz1orig)
						REPLACE Starting_Stock.Sz1orig WITH THIS.VALUE IN Quotes
					ELSE
						IF "M" $ UPPER(THIS.VALUE)
							REPLACE Starting_Stock.Sz1orig WITH MetricValue IN Quotes
							REPLACE Starting_Stock.Metric WITH .T. IN Quotes
						ENDIF
					ENDIF
					THISFORM.THCK1.VALUE = lnReturnVal
				CASE THISFORMSET.metricgotfocus = "SZ21"
					IF EMPTY(Starting_Stock.Sz2orig)
						REPLACE Starting_Stock.Sz2orig WITH THIS.VALUE IN Quotes
					ELSE
						IF "M" $ UPPER(THIS.VALUE)
							REPLACE Starting_Stock.Sz2orig WITH MetricValue IN Quotes
							REPLACE Starting_Stock.Metric WITH .T. IN Quotes
						ENDIF
					ENDIF
					THISFORM.SZ21.VALUE = lnReturnVal
					THISFORMSET.calcinv(2)
				CASE THISFORMSET.metricgotfocus = "SZ31"
					IF EMPTY(Starting_Stock.Sz3orig)
						REPLACE Starting_Stock.Sz3orig WITH THIS.VALUE IN Quotes
					ELSE
						IF "M" $ UPPER(THIS.VALUE)
							REPLACE Starting_Stock.Sz3orig WITH MetricValue IN Quotes
							REPLACE Starting_Stock.Metric WITH .T. IN Quotes
						ENDIF
					ENDIF
					THISFORM.SZ31.VALUE = lnReturnVal
		
					IF Starting_Stock.FORM = "51" OR Starting_Stock.FORM = "20"
						REPLACE Starting_Stock.Weight WITH lnReturnVal IN Quotes
						THISFORM.WEIGHT1.REFRESH
					ENDIF
					THISFORMSET.calcinv(3)
				CASE THISFORMSET.metricgotfocus = "WEIGHT1"
					THISFORM.WEIGHT1.VALUE = lnReturnVal
		
					IF Starting_Stock.FORM = "51" OR Starting_Stock.FORM = "20"
						REPLACE Starting_Stock.sz3 WITH lnReturnVal IN Quotes
						THISFORM.SZ31.REFRESH
					ENDIF
				CASE THISFORMSET.metricgotfocus = "P_LB1"
					THISFORM.P_LB1.VALUE = lnReturnVal
				CASE THISFORMSET.metricgotfocus = "P_PC1"
					THISFORM.P_PC1.VALUE = lnReturnVal
				CASE THISFORMSET.metricgotfocus = "P_FT1"
					THISFORM.P_FT1.VALUE = lnReturnVal
				CASE THISFORMSET.metricgotfocus = "CUTS1"
					THISFORM.CUTS1.VALUE = lnReturnVal
				CASE THISFORMSET.metricgotfocus = "OtherP1"
					THISFORM.OtherP1.VALUE = lnReturnVal
				CASE THISFORMSET.metricgotfocus = "LOTP1"
					THISFORM.LOTP1.VALUE = lnReturnVal
				ENDCASE
				THIS.VALUE = '`'
				IF !EMPTY(cOldSelect)
					IF USED(cOldSelect)
						SELECT (cOldSelect)
					ENDIF
				ENDIF
				*ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast
		
			ENDIF
		
			IF INLIST(nKeyCode, 15, 5, 141, 152)
				THISFORMSET.gotfocuslast = THISFORMSET.metricgotfocus+"B"
				*Keys that make you goto PREV object
				*TAB Shift 15
				*left 19 52 26
				*up 5 56 141 152
				lnReturnVal = THISFORMSET.convertthis(THIS.VALUE,"BACKWARD")
		
				DO CASE
				CASE THISFORMSET.metricgotfocus = "THCK1"
					THISFORM.THCK1.VALUE = lnReturnVal
					THISFORM.THCK1.REFRESH()
				CASE THISFORMSET.metricgotfocus = "SZ21"
					THISFORM.SZ21.VALUE = lnReturnVal
					THISFORM.SZ21.REFRESH()
				CASE THISFORMSET.metricgotfocus = "SZ31"
					THISFORM.SZ31.VALUE = lnReturnVal
					THISFORM.SZ31.REFRESH()
				CASE THISFORMSET.metricgotfocus = "WEIGHT1"
					THISFORM.WEIGHT1.VALUE = lnReturnVal
					THISFORM.WEIGHT1.REFRESH()
				CASE THISFORMSET.metricgotfocus = "P_LB1"
					THISFORM.P_LB1.VALUE = lnReturnVal
					THISFORM.P_LB1.REFRESH()
				CASE THISFORMSET.metricgotfocus = "P_PC1"
					THISFORM.P_PC1.VALUE = lnReturnVal
					THISFORM.P_PC1.REFRESH()
				CASE THISFORMSET.metricgotfocus = "P_FT1"
					THISFORM.P_FT1.VALUE = lnReturnVal
					THISFORM.P_FT1.REFRESH()
				CASE THISFORMSET.metricgotfocus = "CUTS1"
					THISFORM.CUTS1.VALUE = lnReturnVal
					THISFORM.CUTS1.REFRESH()
				CASE THISFORMSET.metricgotfocus = "OtherP1"
					THISFORM.OtherP1.VALUE = lnReturnVal
					THISFORM.OtherP1.REFRESH()
				CASE THISFORMSET.metricgotfocus = "LOTP1"
					THISFORM.LOTP1.VALUE = lnReturnVal
					THISFORM.LOTP1.REFRESH()
				ENDCASE
				THIS.VALUE = '`'
		
				*ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast
		
			ENDIF
		
	ENDPROC

	PROCEDURE tempfield.LostFocus
			IF THIS.VALUE="`"
				THIS.VALUE = ''
			ELSE
				*IF NOT EMPTY(ALLTRIM(This.Value))
				PRIVATE lnReturnVal
				lnReturnVal = THISFORMSET.convertthis(THIS.VALUE,"FORWARD")
				*	ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"F"
				*	ThisFormSet.GotFocusNow = ThisFormSet.MetricGotFocus
				DO CASE
				CASE THISFORMSET.gotfocusnow = "THCK1"
					THISFORM.THCK1.VALUE = lnReturnVal
				CASE THISFORMSET.gotfocusnow = "SZ21"
					THISFORM.SZ21.VALUE = lnReturnVal
					THISFORMSET.calcinv(2)
				CASE THISFORMSET.gotfocusnow = "SZ31"
					THISFORM.SZ31.VALUE = lnReturnVal
					THISFORMSET.calcinv(3)
				CASE THISFORMSET.gotfocusnow = "WEIGHT1"
					THISFORM.WEIGHT1.VALUE = lnReturnVal
				CASE THISFORMSET.gotfocusnow = "P_LB1"
					THISFORM.P_LB1.VALUE = lnReturnVal
				CASE THISFORMSET.gotfocusnow = "P_PC1"
					THISFORM.P_PC1.VALUE = lnReturnVal
				CASE THISFORMSET.gotfocusnow = "P_FT1"
					THISFORM.P_FT1.VALUE = lnReturnVal
				CASE THISFORMSET.gotfocusnow = "CUTS1"
					THISFORM.CUTS1.VALUE = lnReturnVal
				CASE THISFORMSET.gotfocusnow = "OtherP1"
					THISFORM.OtherP1.VALUE = lnReturnVal
				CASE THISFORMSET.gotfocusnow = "LOTP1"
					THISFORM.LOTP1.VALUE = lnReturnVal
				ENDCASE
				THIS.VALUE = ''
			ENDIF
		
			THISFORMSET.gotfocusnow = ''
		
			THIS.VISIBLE = .F.
		
	ENDPROC

	PROCEDURE THCK1SS.GotFocus
			WITH THISFORM.tempfield
				.ALIGNMENT = 2
				.HEIGHT = THIS.HEIGHT
				.LEFT = THIS.LEFT
				.WIDTH = THIS.WIDTH
				.VALUE = STR(THIS.VALUE,10,4)
				.TOP = THIS.TOP
				.ENABLED = .T.
				.VISIBLE = .T.
				.TABINDEX = THIS.TABINDEX
			ENDWITH
		
			*ThisFormSet.MetricGOTFocus  = "THCK1SS"
		
			THISFORM.tempfield.SETFOCUS()
	ENDPROC

	PROCEDURE THCK1SS.Init
			THIS.INPUTMASK="99,999.9999"
	ENDPROC

	PROCEDURE THCK1SS.MouseUp
			LPARAMETERS nButton, nShift, nXCoord, nYCoord
			THISFORMSET.gotfocuslast = THIS.NAME
	ENDPROC

	PROCEDURE THCK1SS.When
			IF THISFORMSET.iseditingSS
				THISFORMSET.metricgotfocus  = "THCK1SS"
			ENDIF
			RETURN THISFORMSET.iseditingSS
		
		
	ENDPROC

	PROCEDURE WEIGHT1SS.GotFocus
			WITH THISFORM.tempfield
				.ALIGNMENT = 2
				.HEIGHT = THIS.HEIGHT
				.LEFT = THIS.LEFT
				.WIDTH = THIS.WIDTH
				.VALUE = STR(THIS.VALUE,8,1)
				.TOP = THIS.TOP
				.ENABLED = .T.
				.VISIBLE = .T.
				.TABINDEX = THIS.TABINDEX
			ENDWITH
		
			*ThisFormSet.MetricGOTFocus  = "WEIGHT1SS"
		
			THISFORM.tempfield.SETFOCUS()
		
	ENDPROC

	PROCEDURE WEIGHT1SS.MouseUp
			LPARAMETERS nButton, nShift, nXCoord, nYCoord
		
			THISFORMSET.gotfocuslast = "WEIGHT1SS"
			*ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast
	ENDPROC

	PROCEDURE WEIGHT1SS.When
			IF THISFORMSET.iseditingSS
				THISFORMSET.metricgotfocus  = "WEIGHT1SS"
				*	ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast
			ENDIF
			RETURN THISFORMSET.iseditingSS
		
	ENDPROC

ENDDEFINE

DEFINE CLASS userinfo AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: setuserinfo
		*p: dsn
		*p: email		&& Global Email Name
		*p: homedir
		*p: machine		&& Global Maschine
		*p: peachinv
		*p: salesp
		*p: serverdir
		*p: username		&& Global User Name
	*</DefinedPropArrayMethod>

	*<PropValue>
		dsn = ""
		Email = ""
		HEIGHT = 130
		HOMEDIR = ""
		Machine = ""
		NAME = "userinfo"
		peachinv = ""
		SalesP = ""
		serverdir = ""
		username = ""
		WIDTH = 166
	*</PropValue>
	
	PROCEDURE setuserinfo
			PARAMETER pSP
		
			IF TYPE('pSP') = "C"
				IF NOT EMPTY(pSP)
					PRIVATE aUn
					DIMENSION aUn(1)
		
					SELECT UN FROM SETUP WHERE SETUP.PRP = "SalesP" AND SETUP.ANS = pSP INTO ARRAY aUn
					IF TYPE('aUN(1)') = "C"
						IF NOT EMPTY(aUn(1))
							cUserName = aUn(1)
							THIS.username = cUserName
							THIS.SalesP =  pSP
		
							PRIVATE aMachine
							DIMENSION aMachine(1)
							SELECT ANS FROM SETUP WHERE SETUP.UN = cUserName AND SETUP.PRP = "Machine" INTO ARRAY aMachine
		
							IF TYPE('aMachine(1)') = "C"
								IF NOT EMPTY(aMachine(1))
									THIS.Machine = aMachine(1)
								ENDIF
							ENDIF
		
		
							PRIVATE aServer
							DIMENSION aServer(1)
							SELECT ANS FROM SETUP WHERE SETUP.UN = cUserName AND SETUP.PRP = "Server" INTO ARRAY aServer
		
							IF TYPE('aServer(1)') = "C"
								IF NOT EMPTY(aServer(1))
									THIS.serverdir = aServer(1)
								ENDIF
							ENDIF
		
							PRIVATE aHome
							DIMENSION aHome(1)
							SELECT ANS FROM SETUP WHERE SETUP.UN = cUserName AND SETUP.PRP = "Home" INTO ARRAY aHome
		
							IF TYPE('aHome(1)') = "C"
								IF NOT EMPTY(aHome(1))
									THIS.HOMEDIR = aHome(1)
								ENDIF
							ENDIF
		
		
							PRIVATE aPeachInv
							DIMENSION aPeachInv(1)
							SELECT ANS FROM SETUP WHERE SETUP.UN = cUserName AND SETUP.PRP = "PeachInv" INTO ARRAY aPeachInv
		
							IF TYPE('aPeachInv(1)') = "C"
								IF NOT EMPTY(aPeachInv(1))
									THIS.peachinv = aPeachInv(1)
								ENDIF
							ENDIF
		
		
		
							PRIVATE aEmail
							DIMENSION aEmail(1)
							SELECT ANS FROM SETUP WHERE SETUP.UN = cUserName AND SETUP.PRP = "E-mail" INTO ARRAY aEmail
		
							IF TYPE('aEmail(1)') = "C"
								IF NOT EMPTY(aEmail(1))
									THIS.Email = aEmail(1)
								ENDIF
							ENDIF
		
							PRIVATE aDSN
							DIMENSION aDSN(1)
							SELECT ANS FROM SETUP WHERE SETUP.UN = cUserName AND SETUP.PRP = "DSN" INTO ARRAY aDSN
		
							IF TYPE('aDSN(1)') = "C"
								IF NOT EMPTY(aDSN(1))
									THIS.dsn = aDSN(1)
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			RETURN .T.
		
			**************************************************************
		
	ENDPROC

ENDDEFINE
