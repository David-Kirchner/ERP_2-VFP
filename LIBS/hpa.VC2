	PROCEDURE DESTROY
		
		
			IF THIS.PARENT.OpenedHPA AND DBUSED('HPA')
				SET DATABASE TO HPA
				CLOSE DATABASES
			ENDIF
		
	ENDPROC

	PROCEDURE INIT
			PUBLIC m.Text1
		
			m.sD1 = 0
			m.sL1 = 0
			m.sL1f = 0
			m.sD2 = 0
			m.sL2 = 0
			m.sL2f = 0
		
			m.sRA = 0
		
			m.D1 = 0
			m.L1 = 0
			m.L1f = 0
			m.D2 = 0
			m.L2 = 0
			m.L2f = 0
		
			m.RA1 = 0
		
			m.Text1 = ""
		
			THISFORMSET.tTabindex=THISFORM.txtD123.TABINDEX
			*ThisForm.txtD123.SetFocus
		
		
			PUBLIC lcLastSetDecimal
			lcLastSetDecimal=SET("DECIMAL")
			SET DECIMAL TO 3
		
		
		
	ENDPROC

	PROCEDURE UNLOAD
			IF NOT EMPTY(lcLastSetDecimal)
				SET DECIMAL TO (lcLastSetDecimal)
			ENDIF
		
	ENDPROC

	PROCEDURE cmdCalc.CLICK
			=THISFORMSET.calcs()
			THISFORM.REFRESH
		
	ENDPROC

	PROCEDURE cmdClose.CLICK
			THISFORM.RELEASE
	ENDPROC

	PROCEDURE cmdReset.CLICK
			m.sD1 = 0
			m.sL1 = 0
			m.sL1f = 0
			m.sD2 = 0
			m.sL2 = 0
			m.sL2f = 0
			m.sRA = 0
			m.D1 = 0
			m.L1 = 0
		
			m.D2 = 0
			m.L2 = 0
		
			m.RA1 = 0
			THISFORM.REFRESH
			THISFORM.txtD123.SETFOCUS
	ENDPROC

	PROCEDURE cmdSave2Quotes.CLICK
		
	ENDPROC

	PROCEDURE Text1.LOSTFOCUS
			PRIVATE m.cntrlsrc
			m.cntrlsrc = THISFORMSET.tControlSource
			DO CASE
			CASE m.cntrlsrc = "M.D1"
				THISFORM.txtL124.SETFOCUS()
			CASE m.cntrlsrc = "M.L1"
				THISFORM.txtD225.SETFOCUS()
			CASE m.cntrlsrc = "M.D2"
				THISFORM.txtL226.SETFOCUS()
			CASE m.cntrlsrc = "M.L2"
				THISFORM.cmdCalc.SETFOCUS()
			ENDCASE
	ENDPROC

	PROCEDURE Text1.VALID
			*ThisFormSet.tValueReturn=ThisFormSet.RED_MATH(This.Value)
			PRIVATE m.cntrlsrc
			m.cntrlsrc = THISFORMSET.tControlSource
			IF NOT EMPTY(THIS.VALUE)
				STORE THISFORMSET.red_math(THIS.VALUE) TO (m.cntrlsrc)
			ENDIF
			THIS.ENABLED = .F.
			THIS.VISIBLE = .F.
			THISFORM.REFRESH
		
		
	ENDPROC

	PROCEDURE txtD123.INTERACTIVECHANGE
			THISFORMSET.tControlSource = THIS.CONTROLSOURCE
			THISFORMSET.tTabindex      = THIS.TABINDEX
			WITH THISFORMSET.RedArea.Text1
				.ENABLED = .T.
				.VISIBLE = .T.
				.VALUE   = Remove0(THIS.VALUE,2,3,.F.)
				.TOP     = THIS.TOP
				.LEFT    = THIS.LEFT
				.WIDTH   = THIS.WIDTH+2
				.SELSTART= THIS.SELSTART
			ENDWITH
			THISFORMSET.RedArea.Text1.SETFOCUS()
	ENDPROC

	PROCEDURE txtD225.INTERACTIVECHANGE
			THISFORMSET.tControlSource = THIS.CONTROLSOURCE
			THISFORMSET.tTabindex      = THIS.TABINDEX
			WITH THISFORMSET.RedArea.Text1
				.ENABLED = .T.
				.VISIBLE = .T.
				.VALUE   = Remove0(THIS.VALUE,2,3,.F.)
				.TOP     = THIS.TOP
				.LEFT    = THIS.LEFT
				.WIDTH   = THIS.WIDTH+2
				.SELSTART= THIS.SELSTART
			ENDWITH
			THISFORMSET.RedArea.Text1.SETFOCUS()
	ENDPROC

	PROCEDURE txtL124.INTERACTIVECHANGE
			THISFORMSET.tControlSource = THIS.CONTROLSOURCE
			THISFORMSET.tTabindex      = THIS.TABINDEX
			WITH THISFORMSET.RedArea.Text1
				.ENABLED = .T.
				.VISIBLE = .T.
				.VALUE   = Remove0(THIS.VALUE,5,1,.F.)
				.TOP     = THIS.TOP
				.LEFT    = THIS.LEFT
				.WIDTH   = THIS.WIDTH+2
				.SELSTART= THIS.SELSTART
			ENDWITH
			THISFORMSET.RedArea.Text1.SETFOCUS()
	ENDPROC

	PROCEDURE txtL226.INTERACTIVECHANGE
			THISFORMSET.tControlSource = THIS.CONTROLSOURCE
			THISFORMSET.tTabindex      = THIS.TABINDEX
			WITH THISFORMSET.RedArea.Text1
				.ENABLED = .T.
				.VISIBLE = .T.
				.VALUE   = Remove0(THIS.VALUE,6,1,.F.)
				.TOP     = THIS.TOP
				.LEFT    = THIS.LEFT
				.WIDTH   = THIS.WIDTH+2
				.SELSTART= THIS.SELSTART
			ENDWITH
			THISFORMSET.RedArea.Text1.SETFOCUS()
	ENDPROC

ENDDEFINE

