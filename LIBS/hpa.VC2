	PROCEDURE cmbFormSS.Valid
			THISFORMSET.RefreshForms()
			*10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,71,Coupling,72,Flange,75,Fastener,80,Disk,90,Machined
			* ALSO FOUND IN PurchaseOrder Screen
			IF THISFORMSET.Quotes.THCK1.VALUE * THISFORMSET.Quotes.SZ21.VALUE > 0
				IF NOT THISFORMSET.Quotes.SZ31.VISIBLE
					*		IF ThisFormset.QUOTES.SZ21.Value > 0
					THISFORMSET.calcinv(2)
					*		ENDIF
				ELSE
					IF THISFORMSET.Quotes.SZ31.VALUE > 0
						THISFORMSET.calcinv(3)
					ENDIF
				ENDIF
			ENDIF
		
	ENDPROC

