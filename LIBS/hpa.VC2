	PROCEDURE Destroy
		IF VARTYPE(aQrecN) != "U"
			RELEASE aQrecN
		ENDIF
		IF VARTYPE(aQrecNitem) != "U"
			RELEASE aQrecNitem
		ENDIF
		IF VARTYPE(aQrecNPO) != "U"
			RELEASE aQrecNPO
		ENDIF
	ENDPROC

	PROCEDURE Init
		PUBLIC aQrecN,aQrecNitem,aQrecNPO,aQuotesID
		
		ThisForm.nSalesNum = 0
		ThisForm.nSNitems = 0
		ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
		ThisForm.lblInqNumP.Caption = Quotes.InqNumP 
		
		DIMENSION aQrecN(1)
		DIMENSION aQrecNitem(1)
		DIMENSION aQrecNPO(1)
		DIMENSION aQuotesID(1)
		
		
		
	ENDPROC

	PROCEDURE nextitemnumber		&& SQL max (item)
		PRIVATE aMaxSoItem, lnCurrRec
		DIMENSION aMaxSoItem(1)
		
		SELECT Quotes
		lnCurrRec = RECNO("Quotes")
		
		SELECT MAX(ITEM) FROM Quotes WHERE SalesNum = ThisForm.nSalesNum INTO ARRAY aMaxSoItem
		
		IF ISNULL(aMaxSoItem(1))
			aMaxSoItem(1)=0
		ENDIF
		
		*IF Count_SOIteminSales(ThisForm.nSalesNum, gnConnHandle) = 0 AND aMaxSOitem(1) = 1
		*	*** This was put in when SO was deleted from dbo.Sales
		*	MESSAGEBOX("Since Sales Number was not found in dbo.Sales"+CHR(13)+"The Item is reset to 1",0,"Reset")
		*	aMaxSOitem(1) = 0
		*ENDIF
		
		
		IF lnCurrRec < RECCOUNT("Quotes") AND lnCurrRec > 0
			SELECT Quotes
			GOTO (lnCurrRec)
		ENDIF
		
		RETURN aMaxSoItem(1)+1
	ENDPROC

	PROCEDURE prep_quote_salesorder		&& Corrects Quote Data before being Sold
		*ThisForm.Prep_Quote_SalesOrder()
		IF NOT USED('Quotes')
			TrackError("No Quotes table.","No Quotes table.", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		SELECT Quotes
		****
		PRIVATE cCustomer, cNoNoiseName, cNewNoNoiseName, lUpdateNoNoise
		cCustomer = PrepareSQLtxt(Quotes.Company,'Company',30)
		lUpdateNoNoise = .F.
		IF LEN(cCustomer) = 0
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No Company name")
		ELSE
			cNoNoiseName = PrepareSQLtxt(Quotes.NoNoiseName,'NoNoiseName',30)
			IF LEN(cNoNoiseName) = 0
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No cNoNoiseName for Company "+cCustomer )
				*cSQL = "SELECT dbo.f_NoNoiseName('"+cName+"') AS NoNoiseName "
				cNewNoNoiseName = get_NoNoiseName(cCustomer, gnConnHandle)
				REPLACE NoNoiseName WITH cNewNoNoiseName IN Quotes
				lUpdateNoNoise = .T.
			ENDIF
		ENDIF
		
		****
		PRIVATE nQ_P, nQ_QTY, nQ_PU, nQ_Total, lUpdateQ, nNewQ_P, nNewQ_QTY
		lUpdateQ = .F.
		nQ_P	= PrepareSQLnum(Quotes.Q_P,'Q_P',-5)
		nQ_QTY	= PrepareSQLnum(Quotes.Q_QTY,'Q_QTY',-5)
		nQ_PU	= PrepareSQLnum(Quotes.Q_PU,'Q_PU',-1)
		nQ_Total =PrepareSQLnum(Quotes.Q_Total,'Q_Total',-5)
		*nNewQ_P	= Get_Qoute_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
		*nNewQ_QTY	= Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld, gnConnHandle )
		
		IF nQ_Total < 1
			*nQ_Total 
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No Q_Total on the Sales Order "+ STR(PrepareSQLnum(ThisForm.txtSN.Value,'SalesNum',-3)) )
		ENDIF
		
		****
		PRIVATE nStandardSize, lUpdateSTD, nNewStandSize
		nStandardSize =	PrepareSQLnum( Quotes.StandardSize,'StandardSize',9,3)
		*nNewStandSize =	PrepareSQLnum( getStandardSize_Common_CC_CL( Quotes.Thck, Quotes.Alloy, Quotes.Form, Quotes.CC, Quotes.CL, gnConnHandle) ,'StandSize',9,3)
		*IF nStandardSize = nNewStandSize 
			lUpdateSTD = .F.
		*ELSE
		*	RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No Stand Size was changed" )
		*	REPLACE StandardSize WITH nNewStandSize IN Quotes
		*	lUpdateSTD = .T.
		*ENDIF
		
		
		****
		PRIVATE lOpen_, lUpdate_Open
		lOpen_		= PrepareSQLlogic(Quotes.Open_,'Open_',.F.)
		IF lOpen_
			lUpdate_Open = .T.
			REPLACE Open_ WITH .F. IN Quotes
		ELSE
			lUpdate_Open = .F.
		ENDIF
		
		
		*************************************************
		IF lUpdateNoNoise OR lUpdateQ OR lUpdateSTD OR lUpdate_Open
			PRIVATE cSQLu, nSQLEXEC 
		
			cSQLu = "UPDATE dbo.AllQuotes SET "
			IF lUpdateNoNoise 
				cSQLu = cSQLu + " NoNoiseName = '"+cNewNoNoiseName+"'"
			ENDIF
			IF lUpdateQ
				IF lUpdateNoNoise 
					cSQLu = cSQLu + ","
				ELSE
					cSQLu = cSQLu + " "
				ENDIF
			ENDIF
			IF lUpdateSTD
				IF lUpdateNoNoise OR lUpdateQ
					cSQLu = cSQLu + ",StandardSize= "+STR(nNewStandSize,9,3)+""
				ELSE
					cSQLu = cSQLu + " StandardSize= "+STR(nNewStandSize,9,3)+""
				ENDIF
			ENDIF
			IF lUpdate_Open
				IF lUpdateNoNoise OR lUpdateQ OR lUpdateSTD
					cSQLu = cSQLu + " ,Open_ = 0"
				ELSE
					cSQLu = cSQLu + " Open_ = 0"
				ENDIF
			ENDIF
			
			cSQLu = cSQLu + " WHERE AllQuotes.ID = " + ALLTRIM(STR(Quotes.ID))
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQLu, gnConnHandle,nSQLEXEC )
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu)
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Refresh
			THISFORM.selectcolor()
	ENDPROC

	PROCEDURE reload		&& Simulates a load when form was a new window
		THISFORMSET.Quotes.ENABLED = .F.
		THISFORM.cmdViewPO.VISIBLE = .F.
		THISFORM.cmdViewPO.ENABLED = .F.
		
		ThisForm.cmdGetNextSO.Enabled = .T.
		ThisForm.txtSN.Enabled = .T.
		ThisForm.cmdSelect4Order.Enabled = .T.
		ThisForm.cmdDone4Order.Enabled = .F.
		ThisForm.cmdAbort4Order.Enabled = .T.
	ENDPROC

	PROCEDURE selectcolor		&& Make the Select button change color.
		PRIVATE lPrevSelect, lnItemNumber, iInqsc
		lPrevSelect = .F.
		IF ThisForm.Visible = .T.
		
			FOR iInqsc = 1 TO ThisForm.nSNitems
				IF VARTYPE(aQrecN(iInqsc)) = "N"
					IF aQrecN(iInqsc) = RECNO("Quotes")
						*Already Selected
						lPrevSelect = .T.
						lnItemNumber = iInqsc
					ENDIF
				ENDIF
			NEXT iInqsc
		
			IF lPrevSelect
				THISFORM.lblItem.CAPTION = STR(aQrecNitem(lnItemNumber),2)
				THISFORM.cmdSelect4Order.FORECOLOR=RGB(255,0,0)
				THISFORM.cmdSelect4Order.Caption = '\<Selected'
				THISFORM.cmdSelect4Order.FONTBOLD = .T.
			ELSE
				IF Quotes.SalesNum = ThisForm.nSalesNum
					THISFORM.lblItem.CAPTION = STR(Quotes.ITEM,2)
				ELSE
					THISFORM.lblItem.CAPTION = '00'
				ENDIF
				THISFORM.cmdSelect4Order.FORECOLOR=RGB(0,0,0)
				THISFORM.cmdSelect4Order.Caption = '\<Select'
				THISFORM.cmdSelect4Order.FONTBOLD = .F.
			ENDIF
		
			IF ThisForm.nSNitems > 0
				THISFORM.cmdDone4Order.ENABLED = .T.
			ELSE
				THISFORM.cmdDone4Order.ENABLED = .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdAbort4Order.Click
		*ThisForm.Release
		
		ThisForm.nSalesNum = 0
		ThisForm.nSNitems = 0
		ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
		
		THISFORM.txtSn.ENABLED = .T.
		THISFORM.txtSn.VALUE = 0
		THISFORM.lblItem.CAPTION = "00"
		THISFORM.lblItems.CAPTION = "00"
		THISFORM.txtPO.ENABLED = .T.
		THISFORM.txtPO.VALUE = ""
		THISFORM.cmdSelect4Order.FORECOLOR=RGB(0,0,0)
		THISFORM.cmdSelect4Order.Caption = '\<Select'
		
		THISFORM.newso = .T.
		
		SELECT Quotes
		THISFORMSET.Quotes.ENABLED = .T.
		
		THISFORM.ENABLED = .F.
		THISFORM.VISIBLE = .F.
		
		ThisForm.lblCompany.Caption =""
	ENDPROC

	PROCEDURE cmdDone4Order.Click
		PRIVATE m.atlt, m.rLeadTime, mltval, m.dLTDate
		
		IF ThisForm.nSalesNum < 100000
			MESSAGEBOX("The Sales Number is too small "+ALLTRIM(STR(ThisForm.nSalesNum)),16,"Cannot Save")
			TrackError("Problem Memo: The Sales Number is too small "+ALLTRIM(STR(ThisForm.nSalesNum)),"Bad SalesNum", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE nMAXSales_No
		nMAXSales_No = get_MAXSales_No()
		IF nMAXSales_No > 1000
			IF ThisForm.nSalesNum > nMAXSales_No + 1000
				MESSAGEBOX("The Sales Number is too high "+ALLTRIM(STR(ThisForm.nSalesNum))+CHR(13)+"Max "+ALLTRIM(STR(nMAXSales_No )),16,"Cannot Save")
				TrackError("Problem Memo: The Sales Number is too high "+ALLTRIM(STR(ThisForm.nSalesNum))+CHR(10)+"get_MAXSales_No()="+ALLTRIM(nMAXSales_No),"Bad SalesNum", PROGRAM(), LINENO(1))
				RETURN .F.
			ENDIF
		ELSE
			TrackError("Problem Memo: The Sales Number cannot be checked "+ALLTRIM(STR(ThisForm.nSalesNum))+CHR(10)+"get_MAXSales_No()="+ALLTRIM(nMAXSales_No),"Bad SalesNum", PROGRAM(), LINENO(1))
		ENDIF
		
		
		PRIVATE lOK
		lOK = .T.
		
		*!*	IF ThisForm.nSNitems < 1
		*!*		*lOK = .F.
		*!*		
		*!*		*This Routine failed to do as much as the Select botton does.
		*!*		*Just fail here so Select be run.
		*!*		**********************
		*!*		PRIVATE nlblItem
		*!*		nlblItem = PrepareSQLnum( ThisForm.lblItem.Caption,'Item_SO',2,0)
		*!*		IF nlblItem > 0
		*!*			TrackError("Problem Memo: The Sales Number has no items in ThisForm.nSNitems, using lblItem "+STR(nlblItem,2),"Bad item match", PROGRAM(), LINENO(1))
		*!*		
		*!*			ThisForm.nSNitems = nlblItem 
		*!*			ThisForm.lblItems.Caption = STR(nlblItem,2)
		*!*			
		*!*			PRIVATE nArrayCount 
		*!*			nArrayCount = ALEN(aQrecN,1)
		*!*			IF nArrayCount < ThisForm.nSNitems
		*!*				
		*!*				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"re Dimension aQrecN to "+ALLTRIM(STR(nArrayCount))+" items." )
		*!*				
		*!*				DIMENSION aQrecN(ThisForm.nSNitems)
		*!*				DIMENSION aQrecNitem(ThisForm.nSNitems)
		*!*				DIMENSION aQrecNPO(ThisForm.nSNitems)
		*!*				
		*!*				STORE RECNO("Quotes") TO aQrecN(ThisForm.nSNitems)					
		*!*				STORE ThisForm.nSNitems		TO aQrecNitem(ThisForm.nSNitems)
		*!*				STORE THISFORM.txtPO.VALUE	TO aQrecNPO(ThisForm.nSNitems)
		*!*			ENDIF		
		*!*		ENDIF
		*!*	ENDIF
		
		IF ThisForm.nSNitems < 1
			MESSAGEBOX("The Sales Number has no items "+ALLTRIM(STR(ThisForm.nSNitems ))+" Selected"+CHR(13)+"Abort if you do not want to select a record.",16,"Cannot Save")
			TrackError("Problem Memo: The Sales Number has no items "+ALLTRIM(STR(ThisForm.nSNitems )),"Bad item", PROGRAM(), LINENO(1))
			ThisForm.nSNitems = 0
			RETURN .F.
		ENDIF
		
		WAIT WINDOW "Saving to Sales" NOWAIT
		
		
		****Sales_No
		PRIVATE m.nCountSNinSales_No
		m.nCountSNinSales_No = Count_SOinSales_No(ThisForm.nSalesNum,gnConnHandle)
		
		IF ThisForm.nSNitems < m.nCountSNinSales_No
			ThisForm.nSNitems = m.nCountSNinSales_No
		ENDIF
		*m.nCountSNinSales_No is Current count SAVED in Sales_No
		
		PRIVATE m.lcSalesman
		m.lcSalesman = SalesPDescription(Quotes.SalesP,Quotes.COVER)
		
		IF m.nCountSNinSales_No > 0
		
			*IF m.nCountSNinSales_No <> ThisForm.nSNitems
			*	ThisForm.nSNitems = m.nCountSNinSales_No
			*	ThisForm.lblItems.Caption = STR(m.nCountSNinSales_No)
			*ENDIF
		
			*Already had a Sales_No record. update it.
			cSQLu = "UPDATE dbo.Sales_No SET "
			cSQLu = cSQLu + " ItemTot = "+STR( ThisForm.nSNitems )+""
			cSQLu = cSQLu + " ,EmailConf=1"	&& Added Default on 2018/07/16
			cSQLu = cSQLu + " ,ShopRecv=0"	&& Added this reset on 2019/04/26
			cSQLu = cSQLu + " ,Changing=1"	&& Added this reset on 2019/04/26
			cSQLu = cSQLu + " ,cncld=0"	&& Added this reset on 2023/02/13
			cSQLu = cSQLu + " ,cmplt=0"	&& Added this reset on 2023/02/13
			cSQLu = cSQLu + " WHERE SalesNum = "+STR(ThisForm.nSalesNum)
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQLu, gnConnHandle,nSQLEXEC )
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu)
					lOK = .F.
				ENDIF
			ENDIF
			
			IF lOK
				TrackMess("Sales Order "+ALLTRIM(STR(ThisForm.nSalesNum))+" has been UPDATED. New Item Total is '"+ALLTRIM(STR(ThisForm.nSNitems))+"' Items. set ShopRecv=0" )
				
		*!*			*-- not sure why this is being sent. 2020-04-30
		*!*			PRIVATE cSubject,cBody,cEmailTo
		*!*			cSubject = 'Updated SalesOrder:'+ALLTRIM(STR(ThisForm.nSalesNum))+" for "+ALLTRIM(Quotes.Company)
		*!*			
		*!*			cBody = cSubject+CHR(13)
		*!*			cBody = cBody+ HTML_CompanyInfo(ThisForm.nSalesNum,.T.)+CHR(10)+CHR(13)
		*!*			cBody = cBody+ " SalesRep:"+m.lcSalesman+CHR(10)+CHR(13)
		*!*			cBody = cBody+ HTML_SO(ThisForm.nSalesNum,.T.)+CHR(10)+CHR(13)
		*!*			cBody = cBody+ " Item added to SO. ItemTot now is "+ALLTRIM(STR( ThisForm.nSNitems ))+""+CHR(13)
		*!*			cBody = cBody+ " set ShopRecv=0"	
		*!*			
		*!*			cEmailTo = AppSetup_Get_Email(m.lcSalesman)
		*!*			IF UPPER(cEmailTo) $ "SALES"
		*!*				cEmailTo = get_Server_Email()
		*!*			ENDIF
		*!*			Send_HTML_Email( cEmailTo,'David.Kirchner@SpaceAlloysUSA.com',cSubject,cBody,gnConnHandle,.T.,.T.)
			ENDIF
			
		ELSE
		
			cSQLi = "INSERT INTO dbo.Sales_No "
			cSQLi = cSQLi + "(SalesNum, ItemTot, SalesRep ) VALUES "
			cSQLi = cSQLi + "("+STR(ThisForm.nSalesNum)+","+STR(ThisForm.nSNitems)+",'"+m.lcSalesman+"')"
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQLi )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQLi )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQLi, gnConnHandle,nSQLEXEC )
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
					lOK = .F.
				ELSE
					TrackMess("Sales Order "+ALLTRIM(STR(ThisForm.nSalesNum))+" has been Added, '"+ALLTRIM(STR(ThisForm.nSNitems))+"' Items." )
				ENDIF
			ELSE
				TrackMess("Sales Order "+ALLTRIM(STR(ThisForm.nSalesNum))+" has been Added, '"+ALLTRIM(STR(ThisForm.nSNitems))+"' Items." )
			ENDIF
		ENDIF
		
		
		IF NOT lOK 
			RETURN .F.
		ENDIF
		
		***************************************************************
		PRIVATE lMil, nItemPrice, lcInqNumP 
		lMil = ".MIL" $ UPPER(Quotes.Email)
		nItemPrice = 0
		
		**loop thru all items of Quotes
		FOR iInq = 1 TO ThisForm.nSNitems
		*FOR iInq = 1 TO m.nCountSNinSales_No
			SELECT Quotes
			PRIVATE nALEN
			nALEN = ALEN(aQrecN,1)
			**aQrecN is set as Public in INIT
			IF NOT VARTYPE(aQrecN(iInq))="N"
				*Does the array have values?
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"NOT VARTYPE(aQrecN(iInq))='N'.  "+ALLTRIM(STR(nALen))+" = ALEN(aQrecN,1).  iInq = "+ALLTRIM(STR(iInq))+".  RecNo('Quotes') = "+ALLTRIM(STR(RecNo('Quotes')))  )
			ELSE
				IF aQrecN(iInq) <= RECCOUNT('Quotes')
					GOTO aQrecN(iInq) IN Quotes
				ELSE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Go where? Cannot got to record aQrecN(iInq)="+ALLTRIM(STR(aQrecN(iInq) ))+".  "+ALLTRIM(STR(nALen))+" = ALEN(aQrecN,1).  iInq = "+ALLTRIM(STR(iInq))+".  RecNo('Quotes') = "+ALLTRIM(STR(RecNo('Quotes')))  )
					
					*Go where?
				ENDIF
			ENDIF
			
			lcInqNumP = Quotes.InqNumP 
			
			IF NOT EMPTY(Quotes.LeadTime)
				m.atlt = AT("-",Quotes.LeadTime)
				m.rLeadTime = IIF(m.atlt > 0,SUBSTR(Quotes.LeadTime,m.atlt+1),ALLTRIM(Quotes.LeadTime))
				m.dLTDate=CTOD('')
				
				m.ltval = VAL(m.rLeadTime)
				IF "WK" $ UPPER(M.rLeadTime) OR "WEEK" $ UPPER(M.rLeadTime)
					IF m.ltval > 0
						m.dLTDate = DATE()+ (m.ltval * 7) && num * 7Days/week
					ELSE
						m.dLTDate = DATE()+ 7 &&1wk
					ENDIF
				ELSE
					IF m.ltval > 0
						m.dLTDate = DATE() + (m.ltval) && num of days
					ELSE
						m.dLTDate = DATE()+1 && could not parse data
					ENDIF
				ENDIF
		
				IF AT( "/", m.rLeadTime, 2 )>0 OR AT( "-", m.rLeadTime, 2 )>0
					PRIVATE m.dLTDateTest
					m.dLTDateTest = CTOD(m.rLeadTime)
					IF VARTYPE(m.dLTDateTest) = "T" OR VARTYPE(m.dLTDateTest) = "D"
						**Overwrite, found a specific DATE!
						m.dLTDate = m.dLTDateTest
					ENDIF
				ENDIF
			ELSE
				m.dLTDate = DATE()+1
			ENDIF
		
			IF NOT VARTYPE(m.dLTDate) = "T" OR VARTYPE(m.dLTDate) = "D"
				m.dLTDate = DATE()+2
			ENDIF
				
			&&--Added 2020-02-14 because EMPTY(m.dLTDate) is not clear enough.
			*IF m.dLTDate=CTOD('')
			*IF m.dLTDate = CTOD('')
			*	*m.dLTDate = DATE()+2
			*ENDIF
			***********************
			**Correct for Holiday
			IF Is_Holiday( m.dLTDate )
				ldLTDate = m.dLTDate+ 1
			ENDIF
			IF Is_Holiday( m.dLTDate ) &&Black Friday
				ldLTDate = m.dLTDate + 1
			ENDIF
		
			**Correct for weekends
			DO CASE
			CASE DOW(m.dLTDate) = 7 &&Saterday
				m.dLTDate = m.dLTDate + 2
				IF Is_Holiday( m.dLTDate )
					m.dLTDate = m.dLTDate + 1
				ENDIF
			CASE DOW(m.dLTDate) = 1 &&Sun
				m.dLTDate = m.dLTDate + 1
				IF Is_Holiday( m.dLTDate )
					m.dLTDate = m.dLTDate + 1
				ENDIF
			ENDCASE
			*************************
			PRIVATE m.lnSO_item, m.cPO_Num, m.cSOitem 
			m.lnSO_item = aQrecNitem(iInq)	&&Make sure it is not +1
			m.cPO_Num = PrepareSQLtxt(aQrecNPO(iInq),'PO_Num',20)
			*m.cSOitem = STR(ThisForm.nSalesNum,7,0)+"-"+IIF(m.lnSO_item<10,"0"+STR(m.lnSO_item,1,0), STR(m.lnSO_item,2,0) )
			m.cSOitem = Proper_SO_Item( STR(ThisForm.nSalesNum,7)+"-"+STR(m.lnSO_item,2) )
			
			IF m.lnSO_item = 0
				MESSAGEBOX("No Item Selected."+CHR(13)+"Nothing to Save.",16,"Not Saved!")
				lOK = .F.
			ENDIF
			
			IF lOK
				*Update Sales
					
				IF USED('tmpCountSales')
					USE IN tmpCountSales
				ENDIF
		
				*Count SO in Sales
				PRIVATE M.nCntd_SOIteminSales
				m.nCntd_SOIteminSales = Count_SOIteminSales(m.cSOitem,gnConnHandle)
		
				IF m.nCntd_SOIteminSales > 0
					PRIVATE cSQLu
		
					cSQLu = "UPDATE dbo.Sales SET "
					cSQLu = cSQLu + " SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
					cSQLu = cSQLu + ",SalesNum = "+STR(ThisForm.nSalesNum)
					cSQLu = cSQLu + ",Item = "+STR(m.lnSO_item)
					cSQLu = cSQLu + ",ItemTot = "+STR(ThisForm.nSNitems)
					cSQLu = cSQLu + ",ShipDue = '"+IIF(m.dLTDate=CTOD(''), '', DTOC(m.dLTDate))+"'"
					IF NOT ISNULL(Quotes.Cut)
						IF Quotes.Cut = "W"
							cSQLu = cSQLu + ",Wjet = 1"
						ELSE
							IF Quotes.Cut = "P"
								cSQLu = cSQLu + ",Plasma = 1"
							ENDIF
						ENDIF
					ENDIF
					cSQLu = cSQLu + ",InqNumP='"+lcInqNumP+"'"
					cSQLu = cSQLu + ",ID_AllQuotes="+STR(Quotes.ID)
					cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
					cSQLu = cSQLu + " AND cncld=0 "
					cSQLu = cSQLu + " AND cmplt=0 "
					
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu,gnConnHandle, nSQLEXEC)
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
							lOK = .F.
						ENDIF
					ENDIF
				ELSE
					PRIVATE cSQLi
		
					cSQLi = "INSERT INTO dbo.Sales "
					cSQLi = cSQLi + "(SOitem,SalesNum,Item,ItemTot,ShipDue,InqNumP,ID_AllQuotes) VALUES "
					cSQLi = cSQLi + "( dbo.f_ProperSOitem('"+m.cSOitem+"'),"+STR(ThisForm.nSalesNum)+","+STR(m.lnSO_item)+","
					cSQLi = cSQLi + STR(ThisForm.nSNitems)+",'"+IIF(m.dLTDate=CTOD('') ,'', DTOC(m.dLTDate))+"'"
					cSQLi = cSQLi + ",'"+lcInqNumP+"',"+STR(Quotes.ID)+")"
		
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQLi )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQLi )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLi, gnConnHandle, nSQLEXEC)
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
							lOK = .F.
						ELSE
							Save_SOitem_Status( m.cSOitem, ThisForm.nSalesNum, 'Add', 'Created SO-Item ID:'+ALLTRIM(STR(Quotes.ID)), gnConnHandle )
						ENDIF
					ELSE
						Save_SOitem_Status( m.cSOitem, ThisForm.nSalesNum, 'Add', 'Created SO-Item ID:'+ALLTRIM(STR(Quotes.ID)), gnConnHandle )
					ENDIF
					
					IF lOK 
						*Save Cut as Update
						IF NOT ISNULL(Quotes.Cut)
							IF Quotes.Cut = "W" OR Quotes.Cut = "P"
		
								PRIVATE cSQLu
								cSQLu = "UPDATE dbo.Sales SET "
								IF NOT ISNULL(Quotes.Cut)
									IF Quotes.Cut = "W"
										cSQLu = cSQLu + " Wjet = 1"
									ELSE
										IF Quotes.Cut = "P"
											cSQLu = cSQLu + " Plasma = 1"
										ENDIF
									ENDIF
								ENDIF
								cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
		
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu )
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									IF NOT SQLEXECError(cSQLu,gnConnHandle, nSQLEXEC)
										RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		
			***********************
			IF lOK 
				*		REPLACE Quotes.SOitem_b WITH m.cSOitem
				*		REPLACE Quotes.ItemTot  WITH m.nCountSNinSales_No
				*		REPLACE Quotes.ShipDue  WITH m.dLTDate
				SELECT Quotes
		
				REPLACE Quotes.SalesNum WITH ThisForm.nSalesNum
				REPLACE Quotes.ITEM     WITH m.lnSO_item
				REPLACE Quotes.Soitem   WITH m.cSOitem
				REPLACE Quotes.Open_    WITH .F.
				REPLACE Quotes.Regret   WITH .F.
				REPLACE Quotes.SaleDate WITH DATETIME()
				REPLACE Quotes.PO_Num WITH m.cPO_Num
				
				cUpdateSQL = "UPDATE dbo.AllQuotes SET SalesNum = "
				cUpdateSQL = cUpdateSQL + ALLTRIM(STR(ThisForm.nSalesNum))+""
				cUpdateSQL = cUpdateSQL + ",Item ="+ALLTRIM(STR(m.lnSO_item))+""
				cUpdateSQL = cUpdateSQL + ",SOitem = '"+m.cSOitem+"'"
				cUpdateSQL = cUpdateSQL + ",Open_ =0"
				cUpdateSQL = cUpdateSQL + ",Regret =0"
				cUpdateSQL = cUpdateSQL + ",SaleDate = '"+TTOC(DATETIME())+"'"
				cUpdateSQL = cUpdateSQL + ",PO_Num ='"+ALLTRIM(m.cPO_Num)+"'"
				cUpdateSQL = cUpdateSQL + " WHERE ID="+ALLTRIM(STR(Quotes.ID))
		
				nSQLEXEC = SQLEXEC( gnConnHandle, cUpdateSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cUpdateSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cUpdateSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cUpdateSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cUpdateSQL , gnConnHandle, nSQLEXEC)
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdateSQL )
						CloseQuote(Quotes.ID,gnConnHandle)
						lOK = .F.
					ENDIF
				ENDIF
		
				IF lOK 
					*** save to ship database
					PRIVATE nCount
					nCount = Count_ShipbySOitem( m.cSOitem, gnConnHandle,'')
					IF nCount = 0
						*INSERT
						cSQL = "INSERT INTO dbo.SHIP (SalesNum, ITEM, SOitem, SalesP, Company, PO_Num, Alloy, DueDate, OrderDate, Program) "
						cSQL = cSQL + " VALUES ("+STR(ThisForm.nSalesNum)+","+STR(Quotes.ITEM,2,0)+",'"+m.cSOitem+"'"
						cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.SalesP,'SalesP',1)+"'"
						cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.Company,'Company',30)+"'"
						cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.PO_Num,'PO_Num',20)
						cSQL = cSQL +"','"+PrepareSQLtxt(Quotes.Alloy,'Alloy',12)+"','"
						cSQL = cSQL +IIF(m.dLTDate=CTOD(''), '', DTOC(m.dLTDate))
						cSQL = cSQL +"','"+DTOC(DATE())+"'"
						cSQL = cSQL +",'Select4Order'"
						cSQL = cSQL +")"
		
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "" )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "" )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,gnConnHandle,nSQLEXEC )
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							ENDIF
						ENDIF
						*
					ELSE
						*Update
						cSQL = "UPDATE dbo.SHIP "
						cSQL = cSQL + " SET SalesP = '"+PrepareSQLtxt(Quotes.SalesP,'SalesP',1)+"'"
						cSQL = cSQL + ",Company = '"+PrepareSQLtxt(Quotes.Company,'Company',30)+"'"
						cSQL = cSQL + ",PO_Num = '"+PrepareSQLtxt(Quotes.PO_Num,'PO_Num',20)+"'"
						cSQL = cSQL + ",Alloy = '"+PrepareSQLtxt(Quotes.Alloy,'Alloy',12)+"'"
						cSQL = cSQL + ",DueDate = '"+IIF(m.dLTDate=CTOD(''), '', DTOC(m.dLTDate))+"'"
						cSQL = cSQL + ",OrderDate = '"+DTOC(DATE())+"'"
						cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
		
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,gnConnHandle,nSQLEXEC )
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				
				*******
				*** save to SOitem_Hrs table
				*		PRIVATE nCount
				*		nCount = Count_SOitem( m.cSOitem, gnConnHandle)
				*		IF nCount = 0
				*INSERT
				IF lOK
					IF USED('tmpSOitemHRS')
						USE IN tmpSOitemHRS
					ENDIF
					SELECT 0
		
					cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.SOitem_HRS "
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
		
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL,'tmpSOitemHRS' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOitemHRS")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOitemHRS")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,gnConnHandle,nSQLEXEC,'tmpSOitemHRS' )
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							*lOK = .F.
						ENDIF
					ENDIF
				ENDIF
				******
				IF lOK
					IF USED('tmpSOitemHRS')
						IF RECCOUNT('tmpSOitemHRS') > 0
							IF tmpSOitemHRS.Cntd = 0
		
								cSQL = "INSERT INTO dbo.SOitem_Hrs "
								cSQL = cSQL + "(SOitem,Salesnum) VALUES (dbo.f_ProperSOitem('"+m.cSOitem+"',"+STR(ThisForm.nSalesNum)+")"
		
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									IF NOT SQLEXECError(cSQL,gnConnHandle,nSQLEXEC )
										RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
										*lOK = .F.
									ENDIF
								ENDIF
		
							ENDIF
						ENDIF
		
						USE IN tmpSOitemHRS
					ENDIF
				ENDIF
				****
		
		
			ELSE
				=MESSAGEBOX("Keep trying to save!",16,"Could not save")
			ENDIF
			
			IF lOK
				***********************
				*Millitary 5,000 warning!
				IF NOT lMil
					lMil = ".MIL" $ UPPER(PrepareSQLtxt(Quotes.Email,'Email',60))
				ENDIF
				IF lMil
					nItemPrice = PrepareSQLnum(Quotes.Q_P,'Q_P',-5) * PrepareSQLnum(Quotes.Q_QTY,'Q_QTY',-5)
					IF nItemPrice > 5000
						PRIVATE cMess
						cMess = "Government order over $5,000."+CHR(13)
						cMess = cMess+"Check on how HPA gets paid."+CHR(13)
						cMess = cMess+" SOitem: "+PrepareSQLtxt(Quotes.Soitem,'SOitem',10)+CHR(13)
						cMess = cMess+"Company: "+PrepareSQLtxt(Quotes.Company,'Company',30)+CHR(13)
						cMess = cMess+"   Name: "+PrepareSQLtxt(Quotes.NAME,'Name',25)+CHR(13)
						cMess = cMess+"  Phone: "+PrepareSQLtxt(Quotes.Phone,'Phone',10)+" "+PrepareSQLtxt(Quotes.Phone_Ext,'Phone_Ext',6)+CHR(13)
						cMess = cMess+"    Fax: "+PrepareSQLtxt(Quotes.Fax,'Fax',10)+CHR(13)
						cMess = cMess+"  Email: "+PrepareSQLtxt(Quotes.Email,'Email',60)+CHR(13)
						cMess = cMess+" PO Num: "+PrepareSQLtxt(Quotes.PO_Num,'PO_Num',20)+CHR(13)
						cMess = cMess+" SalesP: "+PrepareSQLtxt(Quotes.SalesP,'SalesP',1)+CHR(13)
						cMess = cMess+"  Price: $"+ALLTRIM(STR(PrepareSQLnum(nItemPrice,'ItemPrice',-3)))+CHR(13)
						cMess = cMess+"Collection issues with Government Orders over $5K"
		
						MESSAGEBOX(cMess,32,"Government Sell Warning")
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
						
					ENDIF
				ENDIF
			ENDIF
			
			SELECT Quotes
			
			IF NOT lOK
				*FOR iInq = 1 TO ThisForm.nSNitems
				EXIT
			ENDIF
			
		NEXT iInq
		
		***********************
		IF lOK	
			DECLARE aCountSO(1)
			aCountSO(1) = 0
		
			IF NOT THISFORM.newso
				*	need to adjust itemtot in sales
		
				IF USED('tmpCountSales')
					USE IN tmpCountSales
				ENDIF
				*Count SO in Sales
				SELECT 0
				cSQL = "SELECT COUNT(*) AS Countd FROM dbo.Sales WITH(NOLOCK) "
				cSQL = cSQL+" WHERE SalesNum = "+STR(ThisForm.nSalesNum)
				
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpCountSales' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpCountSales' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCountSales")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCountSales")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,gnConnHandle,nSQLEXEC )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ELSE
					IF USED('tmpCountSales')
						SELECT tmpCountSales
						PRIVATE m.nCountedItems
						m.nCountedItems = PrepareSQLnum(tmpCountSales.Countd,'CountedItems',-3)
						*IF VARTYPE(tmpCountSales.Countd) = "N"
						IF m.nCountedItems > ThisForm.nSNitems 
							cSQLu = "UPDATE dbo.Sales SET "
							*cSQLu = cSQLu + " ItemTot = "+STR(ThisForm.nSNitems)
							cSQLu = cSQLu + " ItemTot = "+STR(m.nCountedItems)
							cSQLu = cSQLu + " WHERE SalesNum = "+STR(ThisForm.nSalesNum)
		
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu, "" )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu, "" )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQLu,gnConnHandle,nSQLEXEC )
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
								ENDIF
							ENDIF
							
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"[Item] m.nCountedItems is bigger than ThisForm.nSNitems "+STR(m.nCountedItems)+" > "+STR(ThisForm.nSNitems)+" for SalesNum "+STR(ThisForm.nSalesNum))
						ELSE
							*m.nCountedItems > ThisForm.nSNitems
							IF m.nCountedItems < ThisForm.nSNitems
								RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"[Item] m.nCountedItems is LESS than ThisForm.nSNitems "+STR(m.nCountedItems)+" < "+STR(ThisForm.nSNitems)+" for SalesNum "+STR(ThisForm.nSalesNum))
							ENDIF
						ENDIF
					ELSE
						*Could not update ItemTot
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
					ENDIF
				ENDIF
				
				IF USED('tmpCountSales')
					USE IN tmpCountSales
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT lOK
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Select4Order Done Failed. ThisForm.nSNitems "+ALLTRIM(STR(ThisForm.nSNitems))+" for Sales Number "+ALLTRIM(STR(ThisForm.nSalesNum)))
		ENDIF
		
		*****************************
		*re Query AllQuotes with gcSQL
		SELECT Quotes
		nCurInqNum = Quotes.InqNumP
		USE IN Quotes
		nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(gcSQL, gnConnHandle, nSQLEXEC )
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),gcSQL )
			ENDIF
		ENDIF
		
		IF USED('Quotes')
			SELECT Quotes
			LOCATE FOR InqNumP = nCurInqNum
		
			WAIT CLEAR
		
			*thisform.Release  DO NOTE RELEASE THIS FORM. IT IS A PART OF Quotes98 now.
			ThisForm.nSalesNum = 0
			ThisForm.nSNitems = 0
			ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
		
			THISFORM.txtSn.ENABLED = .T.
			THISFORM.txtSn.VALUE = 0
			THISFORM.lblItem.CAPTION = "00"
			THISFORM.lblItems.CAPTION = "00"
			THISFORM.txtPO.ENABLED = .T.
			THISFORM.txtPO.VALUE = ""
			THISFORM.cmdSelect4Order.FORECOLOR=RGB(0,0,0)
			THISFORM.cmdSelect4Order.Caption = '\<Select'
			
			THISFORM.newso = .T.
		
			THISFORMSET.Quotes.pf1.PageSales.REFRESH()
			THISFORMSET.Quotes.pf1.PageSold.REFRESH()
			THISFORMSET.Quotes.pf1.PageStatus.REFRESH()
		
			THISFORMSET.Quotes.pf1.PageSales.SALESNUM1.REFRESH()
			THISFORMSET.Quotes.pf1.PageSales.Item1.REFRESH()
			THISFORMSET.Quotes.pf1.PageSales.PO_Num1.REFRESH()
		
			THISFORM.ENABLED = .F.
			THISFORM.VISIBLE = .F.
			THISFORMSET.Quotes.ENABLED = .T.
			
		ENDIF
		
		IF lOK
			ThisForm.lblCompany.Caption =""
		ENDIF
	ENDPROC

	PROCEDURE cmdGetNextSO.Click
		SELECT Quotes
		IF RECNO() > RECCOUNT()
			MESSAGEBOX("Lost placement in Quotes table!"+CHR(13)+"Cannot continue!",0,"Error")
			ThisForm.cmdAbort4Order.Click
			RETURN
		ENDIF
		
		THISFORM.txtSn.VALUE = SO_Get_Next() &&Proc_HPA
		
		THISFORM.lblItem.CAPTION = STR(1)
		*THISFORM.lblItems.CAPTION = STR(0)
		
		THISFORM.txtSn.REFRESH
		IF THISFORM.txtSn.VALID()
			ThisForm.txtSn.Enabled = .F.
			This.Enabled = .F.
		ENDIF
		
		****************
		
		*Do not place 1 here, let Select do it
		ThisForm.nSNitems = 0
		ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
		ThisForm.lblInqNumP.Caption = Quotes.InqNumP 
		
		DIMENSION aQrecN(1)
		DIMENSION aQrecNitem(1)
		DIMENSION aQrecNPO(1)
		
		STORE 0  TO aQrecN(1)			
		STORE 0	 TO aQrecNitem(1)
		STORE '' TO aQrecNPO(1)
		
		
		THISFORM.txtPO.SETFOCUS()
	ENDPROC

	PROCEDURE cmdNext4Order.Click
			SELECT Quotes
			IF !EOF()
				SKIP 1 IN Quotes
			ENDIF
			IF EOF()
				WAIT WINDOW 'End of File' NOWAIT
				GO BOTTOM IN Quotes
			ENDIF
			THISFORMSET.Quotes.REFRESH
			ThisForm.lblInqNumP.Caption = Quotes.InqNumP 
			
			THISFORM.REFRESH
	ENDPROC

	PROCEDURE cmdPrev4Order.Click
			SELECT Quotes
			IF !BOF()
				SKIP -1 IN Quotes
			ENDIF
			IF BOF()
				WAIT WINDOW 'Top of file' NOWAIT
				GO TOP IN Quotes
			ENDIF
			THISFORMSET.Quotes.REFRESH
			ThisForm.lblInqNumP.Caption = Quotes.InqNumP 
			
			THISFORM.REFRESH
	ENDPROC

	PROCEDURE cmdSelect4Order.Click
		PRIVATE m.lSelect4Order, m.lPrevSelectd
		m.lSelect4Order = .F.
		m.lPrevSelectd = .F.
		PRIVATE nCount_SOIteminSales, m.nCount_SOinSales, m.nCount_SOinSales_No
		m.nCount_SOIteminSales = 0
		m.nCount_SOinSales = 0
		m.nCount_SOinSales_No = 0
		PRIVATE m.nTotItems 
		
		*m.nTotItems = ThisForm.nSNitems = PrepareSQLnum(ThisForm.lblItems.Caption,'Items',2,0)
		
		*************************
		*Check Data *************
		*ThisForm.nSNitems=0 till Selected
		
		DO CASE
		CASE ThisForm.nSalesNum = 0
			MESSAGEBOX("You can not use 0 for the Sales Number!")
			m.lSelect4Order = .F.
			
		CASE Quotes.SalesNum = ThisForm.nSalesNum
			*All Ready there. Do nothing???
			
			m.nCount_SOinSales = Count_SOinSales(ThisForm.nSalesNum, gnConnHandle)
			m.nCount_SOinSales_No = Count_SOinSales_No(ThisForm.nSalesNum, gnConnHandle)
			
			IF m.nCount_SOinSales > 0 OR m.nCount_SOinSales_No > 0
				MESSAGEBOX("You can not use this quote again for this Sales Order",16,"This Quotes is already assigned to a Sales Order")
				m.lSelect4Order = .F.
			ELSE
				m.lSelect4Order = .T.
			ENDIF
			
		CASE PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)>0
			MESSAGEBOX("This already belongs to Order#"+ALLTRIM(STR( Quotes.SalesNum )),16,"Cannot select")
			m.lSelect4Order = .F.
		OTHERWISE
			m.lSelect4Order = .T.
			m.nCount_SOIteminSales = ThisForm.nSNitems
		ENDCASE
		
		******
		*Check All Quote ID
		PRIVATE nAllQ_ID, nCountQ_ID
		nAllQ_ID = PrepareSQLnum(Quotes.ID,'ID',-3)
		nCountQ_ID = Count_Quote_ID(nAllQ_ID,ThisForm.nSalesNum, gnConnHandle) && > 0 *10/16/2024 - Brandon - This changes the value from a number to a boolean
		IF nCountQ_ID >= 1
			*Found Quote ID
			IF nCountQ_ID >= 3
				*Found ID But SO Does not match
				MESSAGEBOX("This Quotes record has already been chosen by a SO",16,"Cannot reselect")
				m.lSelect4Order = .F.
				m.lPrevSelectd = .T.
			ENDIF
			IF nCountQ_ID = 2
				*Found ID and SO
				MESSAGEBOX("This Quotes record has already been chosen by this SO",16,"Cannot reselect")
				m.lSelect4Order = .F.
				m.lPrevSelectd = .T.
			ELSE
				*Found ID -not SO
			ENDIF
		ELSE
			*Not Found
		ENDIF
		
		******
		*Check InqNumP
		PRIVATE cInqNumP, nFoundP
		cInqNumP = PrepareSQLtxt(Quotes.InqNumP,'InqNumP',9)
		nFoundP = ASCAN( aQuotesID, cInqNumP )
		
		IF nFoundP > 0
			*Found ID
			MESSAGEBOX("This Quotes record has already been choosen.",16,"Cannot reselect")
			m.lSelect4Order = .F.
			m.lPrevSelectd = .T.
		ENDIF
		
		******
		PRIVATE nMess
		nMess = 0
		
		IF LEN(ALLTRIM( Quotes.Company ))=0
			MESSAGEBOX("Fill in Company name before selecting for Sales Order.",16,"Cannot select")
			m.lSelect4Order = .F.
			ThisForm.lblCompany.Caption = ''	
		ENDIF
		
		******
		IF PrepareSQLnum(Quotes.Q_P,'Q_P',-5) = 0
			IF PrepareSQLnum(Quotes.Q_PU,'Q_PU',-2) <= 7
				nMess = MESSAGEBOX("The Quoted Price caclulated to $0."+CHR(13)+"if this is NOT correct"+CHR(13)+"Stop, Abort and fix the Quote now."+CHR(13)+"Select (N) if for charity work.",4+16,"Bad Price")
				IF nMess = 6
					m.lSelect4Order = .F.
				ENDIF
			ELSE
			* 8Hrs 9Days 10RMA/Free can be filled later
			ENDIF
		ENDIF
		
		
		
		*!*	IF m.lSelect4Order
		*!*		*ThisForm.nSNitems = m.nCount_SOIteminSales 
		*!*		m.lPrevSelectd = .F.
		*!*		IF VARTYPE(aQrecN) != "U"
		*!*			m.lSelect4Order = .F.
		*!*		ELSE
		*!*			IF VARTYPE( aQrecN(1) )="N"
		*!*				IF ALEN(aQrecN,1) = 0
		*!*					m.lSelect4Order = .F.
		*!*				ELSE
		*!*					FOR iInq = 1 TO ALEN(aQrecN,1)
		*!*						IF aQrecN(iInq) = RECNO("Quotes")
		*!*							*Already Selected
		*!*							m.lPrevSelectd = .T.
		*!*						ENDIF
		*!*					NEXT iInq
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*	ENDIF
		
		IF m.lSelect4Order
			IF NOT m.lPrevSelectd
				*Advance the Items
				*IF PrepareSQLnum(ThisForm.nSNitems,'SNitems',2,0) < 1
				IF ThisForm.nSNitems < 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The Sales Number has no items in ThisForm.nSNitems")
					ThisForm.nSNitems = 0
				ENDIF
				***
				*Check in Sales for last Item.
				*Query Only works after the items are Done and the code is retried.
		
				***
				ThisForm.nSNitems = ThisForm.nSNitems +1
				ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
				
				
				DIMENSION aQrecN(ThisForm.nSNitems)
				DIMENSION aQrecNitem(ThisForm.nSNitems)
				DIMENSION aQrecNPO(ThisForm.nSNitems)
				
				STORE RECNO("Quotes") 		TO aQrecN(ThisForm.nSNitems)					
				STORE ThisForm.nSNitems		TO aQrecNitem(ThisForm.nSNitems)
				STORE THISFORM.txtPO.VALUE	TO aQrecNPO(ThisForm.nSNitems)
				
				*************************************
				THIS.FORECOLOR=RGB(255,0,0)
				THIS.FONTBOLD = .T.
				THISFORM.lblItem.CAPTION = STR(ThisForm.nSNitems,2)
				
				ThisForm.lblCompany.Caption = PrepareSQLtxt(Quotes.Company,'Company',30)
				*PrepareSQLtxt(getFromQuotesSO(ThisForm.nSalesNum,"COMPANY",gnConnHandle),'Company',30)
				
				ThisForm.Prep_Quote_SalesOrder()
				
			ELSE
				PRIVATE m.cMesAns
				m.cMesAns = MESSAGEBOX("Do you want to remove this quote"+CHR(13)+"   from this sales order?",16+4+256,"Item is already in the selected list")
				IF m.cMesAns = 6 &&Yes
					IF ThisForm.nSNitems <= 1
						*only one record to remove
						ThisForm.nSNitems = 0
						ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
					ELSE
						*Find record to remove, then readjust rest
						PRIVATE m.lnMaxItemNumber
						DIMENSION QrecN2(ThisForm.nSNitems-1)
						DIMENSION QrecNitem2(ThisForm.nSNitems-1)
						DIMENSION QrecNPO2(ThisForm.nSNitems-1)
						
						iInq2 = 1
						FOR iInq = 1 TO ThisForm.nSNitems
							IF aQrecN(iInq) = RECNO("Quotes")
								*Selected to be removed
							ELSE
								QrecN2(iInq2) = aQrecN(iInq)
								QrecNitem2(iInq2) = aQrecNitem(iInq)
								QrecNPO2(iInq2) = aQrecNPO(iInq)
								
								iInq2 = iInq2 + 1
							ENDIF
						NEXT iInq
						
						*Overwrite orig Array
						ThisForm.nSNitems = ALEN(QrecN2,1)
						IF PrepareSQLnum(ThisForm.nSNitems,'SNitems',2,0) < 1
							*ALEN() can return -1
							ThisForm.nSNitems = 0
						ENDIF
						ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
						
						m.lnMaxItemNumber = THISFORM.nextitemnumber()
						FOR i = 1 TO ThisForm.nSNitems
							STORE m.lnMaxItemNumber+ThisForm.nSNitems TO aQrecNitem(ThisForm.nSNitems)
						NEXT i
						
						ACOPY(QrecN2,aQrecN)
						ACOPY(QrecNitem2,aQrecNitem2)
						ACOPY(QrecNPO2,aQrecNPO)
						
						THISFORM.lblItem.CAPTION = STR(Quotes.item,2)
					ENDIF
				ELSE
					*ThisForm.nSNitems
					PRIVATE cSQLMemo
					cSQLMemo = "This SO Item "+PrepareSQLnum(ThisForm.nSNitems,Item,3,0)+" is already in the selected list."+CHR(10)+CHR(13)+""
					RecordError( 0, "Item is already in the selected list", PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(), cSQLMemo )
				ENDIF &&MesAns
			ENDIF
		
		ENDIF
		
		*****************************
		IF m.lSelect4Order
			THISFORM.cmdDone4Order.ENABLED = .T.
		ELSE
			*IF NOT m.lPrevSelectd
			*	THISFORM.cmdDone4Order.ENABLED = .F.
			*ENDIF
		ENDIF
		
		THISFORM.REFRESH()
		
	ENDPROC

	PROCEDURE cmdSelect4Order.When
		
		IF THIS.FORECOLOR=RGB(255,0,0)
			WAIT WINDOW 'This Quote number has already been selected' TIMEOUT 1
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE cmdViewPO.Click
		*Show Dups
		IF USED("tempDupPOs")
			USE IN tempDupPOs
		ENDIF
		
		PRIVATE cLastSelected
		cLastSelected = ALIAS()
		
		PRIVATE cPO_Num
		cPO_Num = PrepareSQLtxt(THISFORM.txtPO.VALUE,'PO_Num',20,.T.)
		
		IF EMPTY(cPO_Num)
			MESSAGEBOX("PO not Found",16,"No PO to view")
		ELSE
			SELECT 0
			PRIVATE nSQLEXEC, cSQL
			cSQL = "SELECT InqNumP,SalesNum,SaleDate,Company,Alloy,Form,Pieces,Thck,Sz2,Sz3,Descript "
			cSQL=cSQL+" FROM dbo.AllQuotes "
			cSQL=cSQL+" WHERE AllQuotes.PO_Num = '"+cPO_Num+"'"
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "tempDupPOs" )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "tempDupPOs" )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tempDupPOs")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tempDupPOs")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, gnConnHandle, nSQLEXEC)
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('tempDupPOs')
				SELECT tempDupPOs
				BROWSE NOAPPEND NODELETE NOEDIT TITLE "Orders with a PO of "+cPO_Num+" -  Press ESC when done.  -"
		
				USE IN tempDupPOs
			ENDIF
		ENDIF
		
		IF USED(cLastSelected)
			SELECT (cLastSelected)
		ENDIF
		
		
	ENDPROC

	PROCEDURE lblSN.Click
		IF NOT ThisForm.txtSN.Enabled
			MESSAGEBOX("The Sales Number field is not enabled"+CHR(13)+"Cannot change",0,"Cannot change")
			RETURN .F.
		ENDIF
		
		IF ThisForm.nSalesNum > 0
			MESSAGEBOX("The Sales Number is "+ALLTRIM(STR(ThisForm.nSalesNum))+"."+CHR(13)+"Cannot change",0,"Cannot change")
			RETURN .F.
		ENDIF
		
		PRIVATE vnSO
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM Forms\ChooseSO WITH "ChooseSO" TO vnSO
		*DO FORM Forms\Select_SO-item WITH nSO TO vcSOitem
		ThisForm.AlwaysOnTop = .T.
		
		IF VARTYPE(vnSO) != "N"
			RETURN
		ENDIF
		
		TrackMess( "User is Adding an Item to SO "+ALLTRIM(STR(vnSO)) )
		
		ThisForm.nSalesNum = PrepareSQLnum(vnSO,'SalesNum',-3)
		
		IF ThisForm.nSalesNum > 0
			****************
			*Check in Sales for last Item.
			*Query Only works after the items are Done and the Save is run.
		
			PRIVATE cSQL, nSQLEXEC, nReturn 
			PRIVATE cAlias 
			cAlias = ALIAS()
			nReturn  = 0
			
			IF USED("tmpMax_Item")
				USE IN tmpMax_Item
			ENDIF
		
			cSQL = "SELECT MAX(Item) AS MaxItem "
			cSQL = cSQL+" FROM dbo.Sales WITH(NOLOCK) WHERE SalesNum = "+STR(ThisForm.nSalesNum)
		
			SELECT 0
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpMax_Item')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpMax_Item')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tmpMax_Item')
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
		
			IF USED("tmpMax_Item")
				IF RECCOUNT("tmpMax_Item") > 0
					nReturn = PrepareSQLnum(tmpMax_Item.MaxItem ,'MaxItem',-5)
					
					IF m.nTotItems < nReturn
						ThisForm.nSNitems = nReturn
						ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
					ENDIF
				ENDIF 
		
				USE IN tmpMax_Item
			ENDIF
		
			IF NOT EMPTY(cAlias)
				IF USED(cAlias)
					SELECT (cAlias)
				ELSE
					RecordTest("Record Test Data.","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
				ENDIF
			ENDIF
			
			****
			IF nReturn > 0
				*** get Company
				ThisForm.lblCompany.Caption = PrepareSQLtxt(getFromQuotesSO(ThisForm.nSalesNum,"COMPANY",gnConnHandle),'Company',30)
				
		
			****		
			ENDIF
		ENDIF
		
		***
		*ThisForm.nSNitems = ThisForm.nSNitems +1
		*ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
		
		
		THISFORM.txtSN.SETFOCUS()
	ENDPROC

	PROCEDURE txtPO.Valid
		PRIVATE nSQLEXEC
		
		IF NOT EMPTY(THIS.VALUE)
			PRIVATE nCount
			*cPO_Num = ALLTRIM(THIS.VALUE)
			*cPO_Num = cPO_Num + SPACE(20 - LEN(cPO_Num) )
			PRIVATE cPO_Num
			cPO_Num = PrepareSQLtxt(THIS.VALUE,'PO_Num',20,.T.)
		
		
		
			IF USED('tmpAQ_PO')
				USE IN tmpAQ_PO
			ENDIF
			SELECT 0
		
			cSQL = "SELECT Distinct Company FROM dbo.AllQuotes "
			cSQL = cSQL + " WHERE ( PO_Num LIKE '"+ALLTRIM(cPO_Num)+"'"
			cSQL = cSQL + " OR PO_Num LIKE '"+ALLTRIM(cPO_Num)+"-__"+"'"  &&Adds -00 to search
			cSQL = cSQL + " ) "
			cSQL = cSQL + " AND LEN(Company) > 1 "
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpAQ_PO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpAQ_PO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpAQ_PO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpAQ_PO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, gnConnHandle, 'tmpAQ_PO' )
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
		
			IF nSQLEXEC > 0
				IF USED('tmpAQ_PO')
					IF RECCOUNT('tmpAQ_PO') > 0
						THISFORM.cmdViewPO.VISIBLE = .T.
						THISFORM.cmdViewPO.ENABLED = .T.
						*MESSAGEBOX( "Counted "+ALLTRIM(STR(nCount))+" records with the PO of "+ALLTRIM(cPO_Num)+" !"+CHR(13)+" Do not duplicate their ORDER!.",48,"PO has been used before.")
						PRIVATE cComp, cRecs
						cComp = PrepareSQLtxt(tmpAQ_PO.Company,'Company',20)
						cRecs = ALLTRIM(STR(RECCOUNT('tmpAQ_PO')))
						
						MESSAGEBOX( "PO Num "+cPO_Num+" was found with: "+cComp+CHR(13)+"PO found "+cRecs+" Times."+CHR(13)+"Make sure you are not duplicating an ORDER!."+CHR(13)+CHR(13)+"PS, if you just clicked the [Select] button,"+CHR(13)+"you must click [Select] button AGAIN."+CHR(13)+CHR(13)+"This message could have interrupted your select click before it ran the SELECT part of the code.!"+CHR(13)+CHR(13)+"This is Warning"+CHR(13)+"Really, you will now have to decide click Select button."+CHR(13)+CHR(13)+"The program could guess that this is the record you want to be Selected."+" But this program code was run just to warn you about finding that PO already was used as you just left the PO field,"+" it would be a guess that this record is the one to be selected."+" This is a feature of the program as it does not GUESS that validating "+"the PO means that the correct record is also the intending record to be selected.",48,"That PO number has been used before.") 
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"PO Num "+cPO_Num+" was found with: "+cComp+" while selecting Quotes to be turned into an Order.")
					ENDIF
		
					USE IN tmpAQ_PO
				ENDIF
			ENDIF
		
		ENDIF
		
		***************************************
		IF ThisForm.nSNitems > 0
			THISFORM.cmdDone4Order.ENABLED = .T.
		ELSE
			THISFORM.cmdDone4Order.ENABLED = .F.
		ENDIF
		
	ENDPROC

	PROCEDURE txtSN.Valid
		
		
		PRIVATE currecn
		ThisForm.nSalesNum = PrepareSQLnum(THIS.VALUE,'SalesNum',-3)
		
		
		PRIVATE lcSalesP
		IF ThisForm.nSalesNum = 0
			RETURN
		ENDIF
		
		SELECT MAX(SalesNum) FROM Quotes INTO ARRAY aMaxSalesNum  &&Only checks the current table
		
		PRIVATE cText
		IF aMaxSalesNum(1) = 0
			PRIVATE m.lcSalesman
			m.lcSalesman = SalesPDescription(Quotes.SalesP,Quotes.COVER)
		
			cText = "The SO you entered is "+ALLTRIM(STR(ThisForm.nSalesNum))+"."
			cText = cText+CHR(13)+"This is the FIRST Sales Order you have Entered."
			cText = cText+CHR(13)+"Congratulations "+ALLTRIM(m.lcSalesman)+"!"
			MESSAGEBOX(cText,0+64,"Sales number is the first.")
			TrackError(cText,"SO is new to Sales Rep "+Quotes.SalesP, PROGRAM(), LINENO(1))
		
		ELSE
			IF !BETWEEN(ThisForm.nSalesNum, aMaxSalesNum(1) - 200, aMaxSalesNum(1) + 200 )
				
				cText = "The SO you entered is "+ALLTRIM(STR(ThisForm.nSalesNum))+"."
				cText = cText+CHR(13)+"The last SO was "+ALLTRIM(STR(aMaxSalesNum(1) ))+"."
				cText = cText+CHR(13)+"Difference of "+ALLTRIM(STR(aMaxSalesNum(1)-ThisForm.nSalesNum))+"."
				cText = cText+CHR(13)+CHR(13)+"Are you sure this SO number is correct? "+ALLTRIM(STR(ThisForm.nSalesNum))
				cText = cText+CHR(13)+CHR(13)+"** Abort to start over. **"
				MESSAGEBOX(cText,0+64,"Sales number is wrong.")
				TrackError(cText,"SO is out of Order", PROGRAM(), LINENO(1))
				
			ENDIF
		ENDIF
			
		*******
		PRIVATE nMaxSalesNum
		nMaxSalesNum = 0
		
		IF USED('tmpMaxSalesNum')
			USE IN tmpMaxSalesNum
		ENDIF
		
		*PRIVATE nConnection 
		*nConnection = get_SQLSTRINGCONNECT()
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT MAX(SalesNum) AS Cntd FROM dbo.Sales_No " &&NOTMAX WITH(NOLOCK)
		
		SELECT 0
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpMaxSalesNum')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpMaxSalesNum' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'tmpMaxSalesNum')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		
		IF USED('tmpMaxSalesNum')
			IF tmpMaxSalesNum.Cntd > 0
				nMaxSalesNum = tmpMaxSalesNum.Cntd
			ENDIF
		ENDIF
		
		IF USED('tmpMaxSalesNum')
			USE IN tmpMaxSalesNum
		ENDIF
		*IF nConnection>0
		*	=SQLDISCONNECT(nConnection)
		*ENDIF
		
		IF nMaxSalesNum = 0
			*Did not get Max 
		ELSE
			IF !BETWEEN(ThisForm.nSalesNum, nMaxSalesNum  - 10000, nMaxSalesNum + 10000 )
				
				PRIVATE cText
				cText = "This Sales number will NOT be allowed to be saved."+CHR(13)
				cText = cText+ "This Sales number more than 10,000 off MAX Sales number"+CHR(13)
				cText = cText+ "This SO is "+ALLTRIM(STR(ThisForm.nSalesNum))+CHR(13)
				cText = cText+ "The lastest SO is "+ALLTRIM(STR(nMaxSalesNum))+CHR(13)
				cText = cText+"Have a SQL tech help you."
				
				MESSAGEBOX(cText ,0+64,"Abort")
				TrackError(cText,"SO is not in limit", PROGRAM(), LINENO(1))
				
				ThisForm.nSalesNum = 0
				THIS.Value = 0
				RETURN .F.
				
			ENDIF
		ENDIF
		** End Check
		
		
		******* Get InqNumP build temp Array with ID,InqNumP,SOitem
		
		*Also grab PO_num
		PRIVATE cOld_PO_num = ''
		
		IF USED('tmpInqNumPSOi')
			USE IN tmpInqNumPSOi
		ENDIF
		
		*PRIVATE nConnection 
		*nConnection = get_SQLSTRINGCONNECT()
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT [ID],InqNumP, SOitem, PO_num FROM dbo.AllQuotes WHERE SalesNum = "+STR(ThisForm.nSalesNum)
		
		SELECT 0
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpInqNumPSOi')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpInqNumPSOi' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'tmpInqNumPSOi')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		
		IF USED('tmpInqNumPSOi')
			IF RECCOUNT('tmpInqNumPSOi') > 0
				*SELECT [ID],InqNumP,SOitem FROM tmpInqNumPSOi INTO ARRAY aInqNumPSOi
				SELECT [ID] FROM tmpInqNumPSOi INTO ARRAY aQuotesID
				cOld_PO_num = PrepareSQLtxt(tmpInqNumPSOi.PO_num,'PO_num',20)
			ELSE
				*SELECT 0 AS [ID] INTO ARRAY aQuotesID
				aQuotesID(1) = 0
			ENDIF
		ENDIF
		
		IF USED('tmpInqNumPSOi')
			USE IN tmpInqNumPSOi
		ENDIF
		
		
		
		
		
		****
		IF nMaxSalesNum = 0
			*Did not get Max 
		ELSE
			IF !BETWEEN(ThisForm.nSalesNum, nMaxSalesNum  - 10000, nMaxSalesNum + 10000 )
				
				PRIVATE cText
				cText = "This Sales number will NOT be allowed to be saved."+CHR(13)
				cText = cText+ "This Sales number more than 10,000 off MAX Sales number"+CHR(13)
				cText = cText+ "This SO is "+ALLTRIM(STR(ThisForm.nSalesNum))+CHR(13)
				cText = cText+ "The lastest SO is "+ALLTRIM(STR(nMaxSalesNum))+CHR(13)
				cText = cText+"Have a SQL tech help you."
				
				MESSAGEBOX(cText ,0+64,"Abort")
				TrackError(cText,"SO is not in limit", PROGRAM(), LINENO(1))
				
				ThisForm.nSalesNum = 0
				THIS.Value = 0
				RETURN .F.
				
			ENDIF
		ENDIF
		
		
		
		
		
		THISFORM.cmdSelect4Order.ENABLED = .T.
		THIS.ENABLED = .F.
		*ThisForm.txtSn.Enabled = .F.
		
		PRIVATE cAns, nCntSO 
		cAns =  Whos_Sales_Order(ThisForm.nSalesNum)
		nCntSO = Count_ItemsinSales (ThisForm.nSalesNum, gnConnHandle, '')
		
		IF nCntSO = 0
			THISFORM.newso = .T.
			*ThisForm.nSNitems = 1
			*ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
		ELSE
			lcSalesP = RIGHT( cAns,1 )
		
			IF lcSalesP != Quotes.SalesP AND NOT ( Quotes.SalesP = "Z" OR Quotes.SalesP = "X" OR Quotes.SalesP = "0" OR Quotes.SalesP = "1" )
		
				MESSAGEBOX("This SO was entered by "+CHR(13)+"SalesP '"+lcSalesP+"'"+CHR(13)+"You can not add to thier order."+CHR(13)+"Retry the correct SO#.",0+64,"Sales number already taken.")
				THIS.VALUE = 0
				ThisForm.nSalesNum = 0
				ThisForm.nSNitems = 0
				ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)
				
				THISFORM.cmdSelect4Order.ENABLED = .F.
				THIS.ENABLED = .T.
		
				RETURN .F.
			ENDIF
			
			**************
			WAIT WINDOW "Adding more records!, SO# already in use!" NOWAIT
			**************
			
			ThisForm.nSNitems = nCntSO 
			ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)		
			*THISFORM.lblItem.CAPTION = STR(ThisForm.nSNitems,2)
			
			PRIVATE m.nCurrRec, m.cCurrPO
			m.nCurrRec = RECNO("Quotes")
			
			*THISFORM.lblItem.CAPTION = ALLTRIM(STR( nCntSO + 1 ))
			
			*back Fill Array		
			DIMENSION aQrecN(ThisForm.nSNitems)
			DIMENSION aQrecNitem(ThisForm.nSNitems)
			DIMENSION aQrecNPO(ThisForm.nSNitems)
		
			SELECT Quotes
			SET FILTER TO SalesNum = ThisForm.nSalesNum
			INDEX ON Item TAG SNitem
			SET ORDER TO SNitem
			SCAN
				IF Quotes.item > ThisForm.nSNitems
					ThisForm.nSNitems = Quotes.item
					ThisForm.lblItems.Caption = STR(ThisForm.nSNitems,2)	
					DIMENSION aQrecN(Quotes.item)
					DIMENSION aQrecNitem(Quotes.item)
					DIMENSION aQrecNPO(Quotes.item)
				ENDIF	
				STORE RECNO("Quotes") TO aQrecN(Quotes.Item)
				STORE Quotes.Item TO aQrecNitem(Quotes.Item)
				STORE Quotes.PO_Num TO aQrecNPO(Quotes.Item)		
			ENDSCAN
			
			SET FILTER TO
			SET INDEX TO 
			 
			GOTO RECORD (m.nCurrRec)
			THISFORM.lblItem.CAPTION = STR(Quotes.item,2)
			
			ThisForm.lblCompany.Caption = PrepareSQLtxt(getFromQuotesSO(ThisForm.nSalesNum,"COMPANY",gnConnHandle),'Company',30)
			THISFORM.newso = .F.
			
			IF MESSAGEBOX("Does this Sales Order Item still use their PO "+cOld_PO_num+" ?",3+32,"Keep their Purchase Order number?") = 6
				ThisForm.txtPO.Value = cOld_PO_num 
				
				* Cannot ThisForm.cmdSelect4Order.SetFocus
				
			ENDIF
		ENDIF
		
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS sendquotes AS form 		&& Select records to send as Quote
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="shpEmail" UniqueID="" Timestamp="" />
