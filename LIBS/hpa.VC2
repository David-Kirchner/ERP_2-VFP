	PROCEDURE getbyid		&& Display Fields after finding data by ID in AllQuotes table
			PARAMETER pnID
			PRIVATE nID
			PRIVATE cSQL,nSQLEXEC
		
			IF TYPE("pnID") = "N"
				nID = pnID
			ELSE
				MESSAGEBOX("Starting_Stock GetByID needs the AllQuotes ID",0,"Error")
				RETURN -1
			ENDIF
			IF USED('Starting_Stock')
				USE IN Starting_Stock
			ENDIF
			
			SELECT 0
			cSQL = "SELECT * FROM dbo.Starting_Stock WHERE [AllQuotes_ID] = "+STR(nID)
			
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'Starting_Stock')
				
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Starting_Stock')
			ENDDO
		
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Starting_Stock")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Starting_Stock")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'Starting_Stock')
			ENDIF 
		
			IF nSQLEXEC < 1
				SQLEXECError(cSQL)
				RETURN -1
			ENDIF
			THISFORM.VISIBLE = .T.
		
			THISFORM.ALLOY1SS.REFRESH
			THISFORM.cmdEdit.SETFOCUS
		
		
	ENDPROC

	PROCEDURE ALLOY1SS.Valid
			PRIVATE pCurAlloy,cAlloyStandard
			pCurAlloy= ALLTRIM(THIS.VALUE)
			*pcuralloy = ALLTRIM(Starting_Stock.alloy)
		
			IF NOT EMPTY(pCurAlloy)
				cAlloyStandard = GetAlloyStandard( pCurAlloy )
		
				IF NOT EMPTY(cAlloyStandard)
					THIS.VALUE = cAlloyStandard
					THIS.FORECOLOR = RGB(0,0,0)
					RETURN .T.
				ELSE
					THIS.FORECOLOR = RGB(255,128,128)
					RETURN .F.
				ENDIF
		
			ENDIF
		
	ENDPROC

	PROCEDURE ALLOY1SS.When
			IF THISFORMSET.iseditingSS
				THISFORMSET.metricgotfocus  = "ALLOY1ss"
				THISFORMSET.gotfocuslast  = "ALLOY1ss"
			ENDIF
			RETURN THISFORMSET.iseditingSS
	ENDPROC

