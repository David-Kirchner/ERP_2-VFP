	ADD OBJECT 'txtDescription' AS textbox WITH ;
		Height = 23, ;
		Left = 105, ;
		Name = "txtDescription", ;
		ReadOnly = .T., ;
		TabIndex = 3, ;
		Top = 252, ;
		Width = 196
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE dynamicbackcolor_grid
			PRIVATE nColor
			*DynamicBackColor_Grid()
		
			*nColor = RGB( 0, 0, 0 )  &&Black
			*nColor = RGB( 128, 128, 128 )  &&Grey
			*nColor = RGB( 255, 0, 0 ) &&RED
			*nColor = RGB( 192, 220, 192 )  &&GREEN
			*nColor = RGB( 255,128,64 ) &&ORANGE
			*nColor = RGB( 255, 255, 128 ) &&YELLOW
			*nColor = RGB( 255, 255, 255 ) &&WHITE
		
			*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
			*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
			DO CASE
			CASE tmpPOitems.Cancelled
				nColor = RGB( 255, 0, 0 ) &&RED
			CASE tmpPOitems.delivered
				nColor = RGB( 128, 128, 128 )  &&Grey
			OTHERWISE
				nColor = RGB( 255, 255, 255 ) &&WHITE
			ENDCASE
		
			RETURN nColor
	ENDPROC

	PROCEDURE Init
			PARAMETER pnHpaPo
		
		
		
			IF USED("tmpPOitems")
				USE IN tmpPOitems
			ENDIF
		
			*SELECT * FROM PurchaseOrders WHERE HpaPo = pnHpaPo INTO CURSOR tmpPOitems
			IF TYPE("pnHpaPo") = "N"
				THISFORM.CAPTION = THISFORM.CAPTION+" for PO#"+ALLTRIM(STR( pnHpaPo ))
		
				SELECT PoItem,Soitem,SalesPDescription(SalesP,COVER) AS SalesMan,Company,Alloy,Pieces,;
					LEFT(ItemDescriptionMetric(FORM,Thck,sz2,sz3,Order_Qty,.F.,.F.,'','',''),40) AS DESCRIPTION,Cond_Spec,Heat,OrderDate,;
					Received,delivered,Cancelled FROM PurchaseOrders INTO CURSOR tmpPOitems;
					WHERE HPAPO = pnHpaPo
			ELSE
				*SELECT All
				SELECT PoItem,Soitem,SalesPDescription(SalesP,COVER) AS SalesMan,Company,Alloy,Pieces,;
					LEFT(ItemDescriptionMetric(FORM,Thck,sz2,sz3,Order_Qty,.F.,.F.,'','',''),40) AS DESCRIPTION,Cond_Spec,Heat,OrderDate,;
					Received,delivered,Cancelled FROM PurchaseOrders INTO CURSOR tmpPOitems
			ENDIF
		
			THISFORM.GRID.RECORDSOURCE = "tmpPOitems"
			*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
			THISFORM.txtAlloy.VALUE = tmpPOitems.Alloy
			THISFORM.txtDescription.VALUE = tmpPOitems.DESCRIPTION
		
		
	ENDPROC

	PROCEDURE Load
		
		
		IF NOT "PROC_QUOTES.PRG" $ SET("PROCEDURE")
			SET PROCEDURE TO Quotes\Progs\PROC_QUOTES.PRG ADDITIVE
		ENDIF
		
		THISFORM.OrigTable = ALIAS()
		
		THISFORM.ClosePurchaseOrders = .F.
		IF USED("PurchaseOrders")
			SELECT PurchaseOrders
		ELSE
			SELECT 0
			USE PurchaseOrders SHARED NOUPDATE
			THISFORM.ClosePurchaseOrders = .T.
		ENDIF
		
		
	ENDPROC

	PROCEDURE Unload
			IF THISFORM.ClosePurchaseOrders
				IF USED('PurchaseOrders')
					USE IN PurchaseOrders
				ENDIF
			ENDIF
		
		
			IF USED('tmpPOitems')
				USE IN tmpPOitems
			ENDIF
		
			cOrigTable = THISFORM.OrigTable
			IF NOT EMPTY(cOrigTable)
				IF USED(cOrigTable)
					SELECT (cOrigTable)
				ENDIF
			ENDIF
		
		
			RETURN THISFORM.holdnumber
	ENDPROC

	PROCEDURE cmdCancel.Click
			PRIVATE cHoldNumber
			cHoldNumber = ""
			THISFORM.holdnumber = cHoldNumber
		
			THISFORM.RELEASE
	ENDPROC

	PROCEDURE cmdSelect.Click
			PRIVATE cHoldNumber
			*cHoldNumber = ""
			cHoldNumber = tmpPOitems.PoItem
			THISFORM.holdnumber = cHoldNumber
		
			THISFORM.RELEASE
	ENDPROC

	PROCEDURE grid.AfterRowColChange
			LPARAMETERS nColIndex
		
			THISFORM.txtAlloy.VALUE = tmpPOitems.Alloy
			THISFORM.txtDescription.VALUE = tmpPOitems.DESCRIPTION
	ENDPROC

	PROCEDURE grid.BeforeRowColChange
			LPARAMETERS nColIndex
	ENDPROC

	PROCEDURE grid.Column8.Text1.Init
			PARAMETER pnHpaPo
		
		
		
			IF USED("tmpPOitems")
				USE IN tmpPOitems
			ENDIF
		
			*SELECT * FROM PurchaseOrders WHERE HpaPo = pnHpaPo INTO CURSOR tmpPOitems
			IF TYPE("pnHpaPo") = "N"
				THISFORM.CAPTION = THISFORM.CAPTION+" for PO#"+ALLTRIM(STR( pnHpaPo ))
		
				SELECT PoItem,Soitem,SalesPDescription(SalesP,COVER) AS SalesMan,Company,Alloy,Pieces,;
					LEFT(ItemDescriptionMetric(FORM,Thck,sz2,sz3,Order_Qty,.F.,.F.,'','',''),40) AS DESCRIPTION,Cond_Spec,Heat,OrderDate,;
					Received,delivered,Cancelled FROM PurchaseOrders INTO CURSOR tmpPOitems;
					WHERE HPAPO = pnHpaPo
			ELSE
				*SELECT All
				SELECT PoItem,Soitem,SalesPDescription(SalesP,COVER) AS SalesMan,Company,Alloy,Pieces,;
					LEFT(ItemDescriptionMetric(FORM,Thck,sz2,sz3,Order_Qty,.F.,.F.,'','',''),40) AS DESCRIPTION,Cond_Spec,Heat,OrderDate,;
					Received,delivered,Cancelled FROM PurchaseOrders INTO CURSOR tmpPOitems
			ENDIF
		
			THISFORM.GRID.RECORDSOURCE = "tmpPOitems"
			*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
			THISFORM.txtAlloy.VALUE = tmpPOitems.Alloy
			THISFORM.txtDescription.VALUE = tmpPOitems.DESCRIPTION
		
		
	ENDPROC

ENDDEFINE

