	PROTECTED PROCEDURE activefax
			IF NOT USED('QdbSendTo')
				=MESSAGEBOX('Addresse Table not loaded',16,'No E-Mail address')
				RETURN
			ENDIF
		
			SELECT qdbsendto
			GO TOP
		
			IF EMPTY(qdbsendto.Fax)
				DO FORM FORMS\qdbsendto.scx
			ENDIF
		
			IF EMPTY(qdbsendto.Fax)
				=MESSAGEBOX('Addresse table does not have Fax.',16,'No Fax')
				RETURN
			ENDIF
		
			*MAKE SURE ActiveFAX IS THE PRINTER
			nPrinters=APRINTERS(aaprinters)
			IF nPrinters= 0
				WAIT WINDOW "No Printers!!"
				RETURN .F.
			ENDIF
		
			lActiveFax = .F.
			FOR CT = 1 TO nPrinters
				IF aaprinters(CT,1)="ActiveFax"
					lActiveFax = .T.
					EXIT
				ENDIF
			NEXT CT
		
			IF NOT lActiveFax
				WAIT WINDOW "No ActiveFax printer!!"
				RETURN .F.
			ENDIF
			*******
		
		
			IF USED('ActvFax')
				USE IN ActvFax
			ENDIF
			PRIVATE cSafety
			cSafety = SET('SAFETY')
			SET SAFETY OFF
		
			IF FILE("ActvFax.DBF") &&Clean the file
				SELECT 0
				USE ActvFax EXCL
				IF USED('ActvFax')
					ZAP
				ENDIF
			ELSE &&Create file
				SELECT 0
				IF "\MEM" $ SYS(2003)
					CREATE TABLE ( SYS(5)+SYS(2003)+"\"+"ActvFax" ) FREE (LINE80 C(80))
				ELSE
					CREATE TABLE ( SYS(5)+SYS(2003)+"\MEM\"+"ActvFax" ) FREE (LINE80 C(80))
				ENDIF
				*USE ActvFax EXCL
			ENDIF
			SET SAFETY &cSafety
		
			***
			PRIVATE m.Unsp, closesetup
			PRIVATE m.SendFromEmail, m.RecipDisplayName, m.MsgSubject ,m.MsgNoteText
		
		
			*CREATE TABLE c:\QDBsendto FREE (name C(25), company C(30), phone C(11), phone_ext C(4), fax C(11), email C(60), po_num C(17);
			*, salesP C(1), inqnum N(7,0), countryc C(10), CustDisc N(3,2) )
		
			SELECT ActvFax
		
		
			APPEND BLANK
			REPL LINE80 WITH  "@F101 HPAlloy@"+" "
			APPEND BLANK
			REPL LINE80 WITH  "@F110 17656757051@"+" "
			APPEND BLANK
			REPL LINE80 WITH  "@F201 "+ALLTRIM(qdbsendto.NAME)+"@"+" "
			APPEND BLANK
			REPL LINE80 WITH  "@F211 "+ALLTRIM(qdbsendto.CountryC+qdbsendto.Fax)+"@"+" "
			APPEND BLANK
			REPL LINE80 WITH  "@F307 Quote from HP Alloy #"+ALLTRIM(STR(Quotes.InqNum))+"@"+" "
			*txt = txt + "@F606 E:\Quotes\SendPDF\D\ .pdf D@"
		
			APPEND BLANK
			REPL LINE80 WITH  " "
			APPEND BLANK
			REPL LINE80 WITH  " "
		
			APPEND BLANK
			REPL LINE80 WITH  "Quote from HP Alloy #"+ALLTRIM(Quotes.InqNumP)
			APPEND BLANK
			REPL LINE80 WITH "Space Alloys USA "
			APPEND BLANK
			REPL LINE80 WITH "444 Wilson Street, PO Box 40"
			APPEND BLANK
			REPL LINE80 WITH "Tipton, IN 46072 USA"
			APPEND BLANK
			REPL LINE80 WITH "Phone (765)675-8871                https://www.SpaceAlloysUSA.com"
			APPEND BLANK
			REPL LINE80 WITH "      (800) HPALLOY "
			APPEND BLANK
			REPL LINE80 WITH "      (800) 4725569 "
			APPEND BLANK
			REPL LINE80 WITH "  Fax (765)675-7051  "
			APPEND BLANK
			REPL LINE80 WITH " "
		
			closesetup = .F.
		
		
			SELECT qdb
			SCAN
		
				SELECT ActvFax
				APPEND BLANK
				REPL LINE80 WITH qdb.LINE
		
				SELECT qdb
			ENDSCAN
		
			**Print
			SET PRINTER TO NAME 'ActiveFax'
			SELECT ActvFax
			REPORT FORM Reports\LINE80 TO PRINTER NOCONSOLE
		
		
		
			SET PRINTER TO DEFAULT
		
			IF USED('Quotes')
				SELECT Quotes
			ENDIF
		
			PRIVATE cSafety
			cSafety = SET('SAFETY')
			SET SAFETY OFF
		
			IF USED("ActvFax")
				SELECT ActvFax
				ZAP
				USE IN ActvFax
			ENDIF
		
			SET SAFETY &cSafety
		
			THISFORM.unopen()
		
	ENDPROC

	PROCEDURE add_check_quote_no		&& cmdAdd.Click - Check Quote for to see if Quote.ID already in a QA save.
			*ADD_Check_Quote_No()
			PRIVATE nQuotes_ID
			nQuotes_ID = Quotes.ID
		
		
			IF USED('Quote_No_ID')
				USE IN Quote_No_ID
			ENDIF
		
		
			PRIVATE cSQL, nSQLEXEC
		
			SELECT 0
			cSQL = "SELECT QN.ID "
			cSQL = cSQL + " FROM [dbo].[Quote_No] QN, [Quote_No_AQID] AQID "
			cSQL = cSQL + " WHERE QN.ID = AQID.Quote_No_ID "
			cSQL = cSQL + " AND AQID.AllQuotes_ID = "+STR(nQuotes_ID)
		
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quote_No_ID' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quote_No_ID' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "Quote_No_ID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "Quote_No_ID")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle,nSQLEXEC,'Quote_No_ID' )
			ENDIF
		
			THISFORM.txtQuote_No_ID.VALUE = 0
			IF USED('Quote_No_ID')
				IF VARTYPE(Quote_No_ID.ID) = "N"
					IF Quote_No_ID.ID > 0
						IF MESSAGEBOX("Do you want to continue?"+CHR(13)+CHR(13)+"This Quote ID has already been saved to QA as Quote#"+ALLTRIM(STR(Quote_No_ID.ID))+CHR(13)+"This action will amend the QA of the previous QA quote, not create a new QA quote."+CHR(13)+"Use a cloned record if you do not want to amend the Previous QA qoute.",4+32,"Save as Amendment to QA?") = 7
							THISFORM.txtQuote_No_ID.VALUE = 0
						ELSE
							THISFORM.txtQuote_No_ID.VALUE = Quote_No_ID.ID
						ENDIF
					ENDIF
				ENDIF
				USE IN Quote_No_ID
			ENDIF
		
	ENDPROC

	PROTECTED PROCEDURE faxman
			PRIVATE printfax,PAGENO,plineno,Q_faxnm ,qrfaxnum, ckoutput,m.sub ,m.v7,m.rcc,CNT,crecnum
			PRIVATE lSalesP
		
			CLEAR TYPEAHEAD
			*WAIT WINDOW "Do you also want a printed copy (Y)" TO BLANK
			*IF UPPER(BLANK) = "Y"
			*	thisform.PrintOut()
			*ENDIF
		
			PRIVATE mLinesLeft, mGotoLine
			SELECT qdb
			SET INDEX TO && use stand order - no index
		
			mLinesLeft = RECCOUNT('QDB')
			mGotoLine = 35
		
			IF mLinesLeft > 35 &&Add Blanks
				GOTO (mGotoLine)
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				mGotoLine = mGotoLine + 38
				mLinesLeft = mLinesLeft  - 35
			ENDIF
		
		
			DO WHILE mLinesLeft > 35
				GOTO (mGotoLine)
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				INSERT BLANK
				REPLACE LINE WITH " "
				DELETE
				mLinesLeft = mLinesLeft - 35
				mGotoLine = mGotoLine + 38
			ENDDO
		
		
		
			Q_faxnm=qdbsendto.Fax
		
			IF TYPE('Q_Faxnm') = 'U'
				Q_faxnm=Quotes.Fax
			ENDIF
			IF EMPTY(Q_faxnm)
				MESSAGEBOX("No Fax Number!",0,"No fax Number")
				RETURN .F.
			ENDIF
			Q_faxnm = FaxProper( Q_faxnm, Quotes.CountryC)
		
		
			lSalesP = ""
			IF VARTYPE(gcSalesP) = "C"
				lSalesP = gcSalesP
			ELSE
				IF USED("Quotes")
					lSalesP = Quotes.SalesP
				ENDIF
			ENDIF
		
			xBill = STR(qdbsendto.InqNum,8)
			xSubj = "Quotation"
			xComp = qdbsendto.Company
			xName = qdbsendto.NAME
			xtime	= TIME()
			xdate	= DATE()
			xkeyw	= ' '
			highsres	= .T.
			prntsetup	= .F.
		
		
			DO FORM FORMS\faxman WITH 'PRINT',Q_faxnm,xName,xComp,xSubj,xBill,'Quote',.T.,'QDB'
		
			RETURN
		
	ENDPROC

	PROCEDURE Init
			PRIVATE ISBLANK, Isunique, qoutedb, quote
		
			PUBLIC M.Q_faxnm, Zsalesp, ZCMP, aQrecN
			m.Q_faxnm = ""
		
			PRIVATE qfile,qfiledb,M.Recn,M.cmp,crecnum,QEDIT,printfax,Z,Zfax
			PRIVATE UNIT1,Unit2,Unit3 ,M.T1,M.S2,M.S3 ,zAmount
			DIMENSION aQrecN(1)
			STORE .F. TO ISBLANK,Isunique
			THISFORM.firstadd =.T.
			THISFORM.ConfirmOrder = .F.
	ENDPROC

	PROCEDURE loadquote_no
			*LoadQuote_No()
		
			PRIVATE nQuote_No_ID
			nQuote_No_ID = PrepareSQLnum(THISFORM.txtQuote_No_ID.VALUE,'ID',-3)
		
		
			IF USED('Quote_No')
				USE IN Quote_No
			ENDIF
		
		
			PRIVATE cSQL, nSQLEXEC
		
			SELECT 0
		
			IF nQuote_No_ID = 0
		
				cSQL = "SELECT 0 AS ID "
				cSQL = cSQL + ",0 AS Revision "
				cSQL = cSQL + ",getdate() AS ExpireDate "
				cSQL = cSQL + ",CAST(0 AS BIT) AS ProdReqDefine "
				cSQL = cSQL + ",CAST(0 AS BIT) AS DiffResolved "
				cSQL = cSQL + ",CAST(0 AS BIT) AS HPAcapable "
				cSQL = cSQL + ",'' AS Comments "
				*	cSQL = cSQL + " FROM [dbo].[Quote_No] QN"
				*	cSQL = cSQL + " WHERE 0 > 0"
			ELSE
				cSQL = "SELECT QN.ID "
				cSQL = cSQL + ",Revision "
				cSQL = cSQL + ",ExpireDate "
				cSQL = cSQL + ",ProdReqDefine "
				cSQL = cSQL + ",DiffResolved "
				cSQL = cSQL + ",HPAcapable "
				cSQL = cSQL + ",Comments "
				cSQL = cSQL + " FROM [dbo].[Quote_No] QN"
				cSQL = cSQL + " WHERE QN.ID = "+STR(nQuote_No_ID)
			ENDIF
		
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL,'Quote_No' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL,'Quote_No' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "Quote_No")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "Quote_No")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle,nSQLEXEC,'Quote_No' )
			ENDIF
		
			IF NOT USED('Quote_No')
				MESSAGEBOX("Could not load the 'Quote_No' table data!",0+16,"Report will not print!")
			ENDIF
		
		
	ENDPROC

	PROCEDURE not_add_check_quote_no		&& Check other form for this function
		*add_check_quote_no
	ENDPROC

