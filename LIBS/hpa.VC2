	PROCEDURE cmdExit.Click
			*Save QA Quote.
			*Check for QA Records, Save/Update if needed.
			THISFORM.saveqa()
		
			*********************
			PRIVATE cSafety
			cSafety = SET('SAFETY')
			SET SAFETY OFF
		
			IF USED('QDB')
				SELECT qdb
				ZAP IN qdb
				USE IN qdb
				IF THISFORM.quote0 = THISFORM.quote + ".DBF"
					*THE DEFAULT NAME WAS USED
					*WAIT WINDOW 'DELETING YOUR QUOTE FILE' NOWAIT
					IF FILE(THISFORM.quote0)
						DELETE FILE (THISFORM.quote0)
					ELSE
						*WAIT WINDOW 'YOUR QUOTE FILE WAS NOT FOUND - NOT DELETED'
					ENDIF
					QUOBAK = LEFT(THISFORM.quote0,LEN(THISFORM.quote0)-3)+"BAK"
					IF FILE(QUOBAK)
						DELETE FILE (QUOBAK)
					ENDIF
				ENDIF
			ENDIF
		
			THISFORM.qrecn = 0
			DIMENSION aQrecN(1)
		
			ISBLANK = .F.
			Isunique = .F.
			THISFORM.firstadd = .T.
			THISFORM.ConfirmOrder = .F.
		
			THISFORM.lstAttach.CLEAR
			THISFORM.lstAttach.VISIBLE = .F.
		
			IF USED('QDB')
				ZAP IN qdb
				USE IN qdb
			ENDIF
			IF USED('QDBsendTo')
				SELECT qdbsendto
				ZAP
				USE IN qdbsendto
			ENDIF
			IF USED('Quote21')
				SELECT Quote21
				ZAP IN Quote21
				USE IN Quote21
			ENDIF
			IF USED('QuoteTerms')
				SELECT QuoteTerms
				ZAP IN QuoteTerms
				USE IN QuoteTerms
			ENDIF
			IF USED('QuoteAttach')
				SELECT QuoteAttach
				ZAP IN QuoteAttach
				USE IN QuoteAttach
			ENDIF
			SET SAFETY &cSafety
		
			SELECT Quotes
			*ThisForm.Release
		
			THISFORM.VISIBLE = .F.
			THISFORM.ENABLED = .F.
			THISFORMSET.Quotes.ENABLED = .T.
	ENDPROC

	PROCEDURE cmdINV.Click
		IF USED('Quotes')
			PRIVATE cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPOitem
			cTBL	= "S"
			cAlloy		= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
			cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
			cCC			= PrepareSQLtxt(Quotes.CC,'CC',1)
			cCL			= PrepareSQLtxt(Quotes.CL,'CL',1)
			nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
			nThck		= PrepareSQLnum(Quotes.Thck,'Thck',10,4)
			nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
			nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
			
			cSOitem		= PrepareSQLtxt(Quotes.SOItem,'SOitem',10)
			nSalesNum	= PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
			
			nLBS		= PrepareSQLnum(Quotes.Weight,'Weight',8,1)
			cHeatLot	= ''
			nQTY		= PrepareSQLnum(Quotes.Q_QTY,'Q_QTY',-5)
			lRL			= PrepareSQLlogic(Quotes.RandLen,'RandLen',.F.)
			cPOitem		= PrepareSQLtxt(Quotes.POItem,'POitem',12)
			
			DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPieces,nLBS,cHeatLot,nQTY,lRL,cPOitem
			*cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPOitem
		
		ENDIF
	ENDPROC

	PROCEDURE cmdNewHTML.Click
			IF NOT USED('QdbSendTo')
				=MESSAGEBOX('Addresse Table not loaded',16,'No E-Mail address')
				RETURN
			ENDIF
		
			THISFORM.loadquote_no()
			THISFORM.qdbtoquote()
		
		
			SELECT qdbsendto
			GO TOP
		
			IF EMPTY(qdbsendto.Email)
				DO FORM FORMS\qdbsendto.scx
			ENDIF
		
			PRIVATE m.SendFromEmail, m.ReciptEmail
			m.ReciptEmail   = PrepareSQLemail( qdbsendto.Email,"EmailTo")
			m.SendFromEmail = PrepareSQLemail( SalesPEmail(THISFORM.SalesP,''), "EmailFrom")
		
			IF EMPTY(m.ReciptEmail)
				=MESSAGEBOX('No Recipient Email.',16,'No E-Mail address')
				RETURN
			ENDIF
		
			PRIVATE lcFromWorker, lcCoveredSP
			lcFromWorker = PrepareSQLemail( SalesPEmail(Quotes.SalesP,''), "EmailFrom")
			lcCoveredSP  = PrepareSQLemail( SalesPEmail(Quotes.COVER,''), "EmailFrom")
			IF NOT EMPTY(lcFromWorker)
				IF lcFromWorker <> m.SendFromEmail
					IF MESSAGEBOX("Do you want to Add "+ALLTRIM(lcFromWorker)+CHR(13)+"to the receipt list?"+CHR(13)+"From is listed as "+ALLTRIM(m.SendFromEmail)+CHR(13)+"Receipt is listed as "+ALLTRIM(m.ReciptEmail),4+32,"Add to Receipt list?") = 6
						*Add the Worker to the send to list
						m.ReciptEmail = m.ReciptEmail + "; " + lcFromWorker
					ENDIF
				ENDIF
			ENDIF
			IF NOT EMPTY(lcCoveredSP)
				IF lcCoveredSP <> m.SendFromEmail
					IF MESSAGEBOX("Do you want to Add Covered "+ALLTRIM(lcCoveredSP)+CHR(13)+"to the receipt list?"+CHR(13)+"From is listed as "+ALLTRIM(m.SendFromEmail)+CHR(13)+"Receipt is listed as "+ALLTRIM(m.ReciptEmail),4+32,"Add Covered to Receipt list?") = 6
						*Add the Worker to the send to list
						m.ReciptEmail = m.ReciptEmail + "; " + lcCoveredSP
					ENDIF
				ENDIF
			ENDIF
		
		
			PRIVATE m.MsgNoteHTML
			*In Proc_Quotes
			m.MsgNoteHTML = CreateHTML_Quote(qdbsendto.InqNumP, m.ReciptEmail)  &&Progs\Proc_Quotes
			*CreateHTML_Quote calls CreateHTML_Header that uses PrepareSQLtxt()
			*calls CreateHTML_Quote_Footer -- CREATEOBJECT("Hyperlink")
			PRIVATE m.MsgSubject
			m.MsgSubject = "Quote from HPAlloy #"+ALLTRIM(qdbsendto.InqNumP)
			m.MsgSubject= STRTRAN(ALLTRIM(m.MsgSubject),"'","''")
		
			IF MESSAGEBOX("An Internet Explorer opened to show you what will be sent."+CHR(13)+"Do you still want to Email this HTML?",4,"Send Email?") = 6
				PRIVATE sql_sp, nSQLEXEC
				PRIVATE cSQL, lUseAttach
				lUseAttach = .F.
		
				IF USED('QuoteAttach')
					IF RECCOUNT('QuoteAttach') > 0
						lUseAttach = .T.
					ENDIF
				ENDIF
		
				IF lUseAttach
		
					PRIVATE m.File_Attach
					m.File_Attach = ""
		
					*Find file
					PRIVATE cLocation, cFileName, cFile
					SELECT QuoteAttach
					SCAN
						*UNCFile C(254), FileName C(254)
						cLocation = ALLTRIM(QuoteAttach.UNCFile)
						IF RIGHT(cLocation,1)!="\"
							IF LEN(cLocation) > 1
								cLocation = cLocation + "\"
							ENDIF
						ENDIF
						cFileName = ALLTRIM(QuoteAttach.FileName)
						cFile = cLocation + cFileName
						cFullSQLPath = get_Email_ServerDir()
						
						IF FILE(cFile)
							*look for same file name on Server
							DO WHILE FILE(cFullSQLPath+cFileName)
								IF MESSAGEBOX("File '"+cFileName+"' is already on the Server."+CHR(13)+"Please wait for other user to finish sending file."+CHR(13)+"If you are sure this file can be removed,"+CHR(13)+"answer Yes, default is No.",4+32+256,"Delete old file?") = 6
									DELETE FILE cFullSQLPath+cFileName
								ELSE
									WAIT WINDOW "Waiting to see if file gets deleted." TIMEOUT 5
								ENDIF
							ENDDO
		
							IF FILE(cFullSQLPath+cFileName)
								WAIT WINDOW "File '"+cFileName+"' is still on the Server." TIMEOUT 5
								DELETE FILE cFullSQLPath+cFileName
							ENDIF
		
							IF FILE(cFullSQLPath+cFileName)
								WAIT WINDOW "File '"+cFileName+"' is still on the Server." TIMEOUT 5
								DELETE FILE cFullSQLPath+cFileName
							ENDIF
		
							*Copy to server
							*COPY FILE ["]+cFile+["] TO cFullSQLPath+cFileName
							*COPY FILE ["]+cFile+["] TO ["]+cFullSQLPath+cFileName+["]
							COPY FILE ["]+cFile+["] TO get_Email_ServerDir()+cFileName
		
							WAIT WINDOW "copy file" TIMEOUT 1
		
							IF FILE(cFullSQLPath+cFileName)
								*Add to serverlist
								*Use ; to indicate End of filename in SQL program
								*					IF EMPTY(File_Attach)
								*						m.File_Attach = cFileName +";"
								*					ELSE
								m.File_Attach = m.File_Attach + cFileName +";"  &&Use ; to indicate End of filename in SQL program
								*					ENDIF
							ELSE
								MESSAGEBOX( "File did not copy to server!"+CHR(13)+"COPY FILE "+cFile+" TO "+cFullSQLPath+cFileName+".",16,"Copy file Error")
		
							ENDIF
						ELSE
							MESSAGEBOX("File:"+ALLTRIM(cFile)+" was not found!",64,"No file")
						ENDIF
					ENDSCAN
		
		
					IF EMPTY(File_Attach)
						MESSAGEBOX("Did not get any files to send."+CHR(13)+"Aborting the [p_eMail_Send_Attachments] procedure.",16,"Cannot continue.")
						RETURN .F.
					ENDIF
					*Execute SQL procedure
		
					cSQL = "EXEC dbo.p_eMail_Send_Attachments "
					cSQL = cSQL + " @FromEmail=N'"+ m.SendFromEmail +"'"
					cSQL = cSQL + ",@ToEmail=N'"+ m.ReciptEmail +"'"
					cSQL = cSQL + ",@BCC=N''"
					*cSQL = cSQL + ",@BCC=N'4012785@bcc.hubspot.com'"
					cSQL = cSQL + ",@SubjectEmail=N'"+ m.MsgSubject +"'"
					cSQL = cSQL + ",@BodyEmail=N'"+ m.MsgNoteHTML + "'"
					cSQL = cSQL + ",@Body_Format=N'HTML'"
					cSQL = cSQL + ",@File_Attach=N'"+ m.File_Attach  +"'"
		
					*		IF LEN(cSQL) >= 8000
					*			TrackError("cSQL String TOO big",cSQL,"HPA:SendQuotes:cmdNewHTML.Click",LINENO() )
					*		ENDIF
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
		
					*DO WHILE nSQLEXEC = 0
					*	WAIT WINDOW 'SQL' TIMEOUT 1
					*	nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
					*ENDDO
					*IF nSQLEXEC < 0 &&Try again!
					*	nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
					*	DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
					*		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
					*		
					*		IF nSQLEXEC < 0
					*			IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
					*				nSQLEXEC = 0
					*			ENDIF
					*		ENDIF
					*	ENDDO
					*ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, gnConnHandle,nSQLEXEC)
						STRTOFILE(cSQL,"SQLError.TXT")
						*TrackMess(cSQL)
						TrackError("Error in SQLEXECError(cSQL, gnConnHandle,nSQLEXEC)",cSQL,"HPA:SendQuotes:cmdNewHTML.Click",LINENO() )
					ELSE
						WAIT WINDOW "SENT E-mail to "+m.ReciptEmail NOWAIT
						addQuoteMemo( "Email Color HTML", gnConnHandle )
					ENDIF
		
					****
					*Remove files from server
					SELECT QuoteAttach
					SCAN
						cFileName = ALLTRIM(QuoteAttach.FileName)
		
						IF FILE(cFullSQLPath+cFileName)
							DELETE FILE (cFullSQLPath+cFileName)
						ENDIF
					ENDSCAN
		
					SELECT QuoteAttach
					DELETE IN QuoteAttach
					PACK
		
				ELSE
					*No Files to Attach
					cSQL = "EXEC dbo.p_eMail_Send_BCC "
					cSQL = cSQL + " @FromEmail=N'"+ m.SendFromEmail +"'"
					cSQL = cSQL + ",@ToEmail=N'"+ m.ReciptEmail +"'"
					cSQL = cSQL + ",@BCC=N''"
					*cSQL = cSQL + ",@BCC=N'4012785@bcc.hubspot.com'"
					cSQL = cSQL + ",@SubjectEmail=N'"+ m.MsgSubject +"'"
					cSQL = cSQL + ",@BodyEmail=N'"+ m.MsgNoteHTML + "'"
					cSQL = cSQL + ",@BodyType=N'HTML'"
		
					*IF LEN(cSQL) >= 8000
					*	TrackError("cSQL String TOO big",cSQL,"HPA:SendQuotes:cmdNewHTML.Click",LINENO(1) )
					*ENDIF
		
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
		
					*DO WHILE nSQLEXEC = 0
					*	WAIT WINDOW 'SQL' TIMEOUT 1
					*	nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
					*ENDDO
					*IF nSQLEXEC < 0 &&Try again!
					*	nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
					*	DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
					*		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "")
					*		
					*		IF nSQLEXEC < 0
					*			IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
					*				nSQLEXEC = 0
					*			ENDIF
					*		ENDIF
					*	ENDDO
					*ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, gnConnHandle,nSQLEXEC)
						*		WAIT WINDOW cSQL
						STRTOFILE(cSQL,"SQLError.TXT")
						TrackMess(cSQL)
					ELSE
						WAIT WINDOW "SENT E-mail to "+m.ReciptEmail NOWAIT
						addQuoteMemo( "Email Color HTML", gnConnHandle )
					ENDIF
				ENDIF
			ENDIF
			***
		
			THISFORM.unopen()
		
	ENDPROC

