	PROCEDURE txtfTBL.Click
		PRIVATE nfID_Detail,cTBL
		nfID_Detail = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfID_Detail.Value,'ID_Detail',-3)
		cfTBL = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfTBL.Value,'TBL',-1)
