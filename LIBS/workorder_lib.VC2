	PROCEDURE cmdAddSOitem.Click
		PRIVATE cSOItem, nSalesNum, lSelectedTheOnlySOitem
		cSOItem = Proper_SO_item('')
		nSalesNum = 0
		lSelectedTheOnlySOitem = .F.
		
		DO FORM Forms\ChooseSO WITH "ChooseSO" TO nSalesNum
		IF nSalesNum > 0
			IF Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle, '') = 1
				lSelectedTheOnlySOitem = .T.		
				cSOItem = Proper_SO_item(STR(nSalesNum,7)+"-01")
			ENDIF
			IF NOT lSelectedTheOnlySOitem
				DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSOItem
			ENDIF
		ENDIF
		
		PRIVATE nQTY, nID_D_P 
		nQTY = 0
		nID_D_P = 0
		
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			nQTY 	= get_QTYbySOitem( cSOitem, ThisForm.nConnHandle, '' )
			IF nQTY=0
				*Calc before S_Qty was avaiable
				nQTY	= Get_QTYinSales( cSOItem, ThisForm.nConnHandle)
			ENDIF
			
			*Check to see if SOitem has a Process
			nID_D_P = get_ID_D_PbySOitem( cSOitem, ThisForm.nConnHandle, 'SELECTED' )
			*GET_ID_Detail_Process_with_ID_Detail_PO_SO(nID_Detail,cTableName,cSOItem,cPOitem,nConn)
			
			
			PRIVATE cSQL, nSQLEXEC 
		
			SELECT 0
			cSQL = "INSERT INTO dbo.WOD_Orders "
			cSQL=cSQL+"([WO_Detail],[SOitem],[QTY],[ID_Detail_Process]) Values"
			cSQL=cSQL+"("+STR(ThisForm.nWO_Detail)
			cSQL=cSQL+",'"+cSOitem+"'"
			cSQL=cSQL+","+ALLTRIM(STR(nQTY,7,1))
			cSQL=cSQL+","+STR(nID_D_P)
			cSQL=cSQL+" )"
		
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOTrackINS')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOTrackINS')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOTrackINS")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOTrackINS")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpOTrackINS')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		
		ENDIF
		ThisForm.Get_Orders_Track()
		
	ENDPROC

	PROCEDURE cmdAddWO_Detail.Click
		
		*Is this needed???
		
		PRIVATE nWO_Detail, nID_D_P
		nWO_Detail = ThisForm.nWO_Detail
		*nID_D_P	= tmpOrders_Sel.ID_Detail_Process
		nID_D_P	= PrepareSQLnum(ThisForm.lblID_D_P.Caption,'ID_D_P',-3)
		
		IF nID_D_P > 0
			PRIVATE cSQL, nSQLEXEC 
			SELECT 0
			cSQL = "UPDATE dbo.StockLst_Process SET WO_Detail = "+STR(nWO_Detail)
			cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_D_P)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				SELECT tmpOrders_Sel
				REPLACE WO_Detail WITH nWO_Detail IN tmpOrders_Sel
				ThisForm.txtWOD_Sel.Value = tmpOrders_Sel.WO_Detail
				ThisForm.cmdRemoveWOD_Proc.Visible = .T.
				This.Visible = .F.
				*ThisForm.get_Orders_Selected()
			ENDIF
		ENDIF		
	ENDPROC

	PROCEDURE cmdCopy2Proc.Click
		PRIVATE cSOitem, nQTY, nID_Detail_Process
		cSOitem= PrepareSQLtxt(ThisForm.txtSOitemT.Value,'SOitem',10)
		nQTY	= PrepareSQLnum(ThisForm.txtQTY0.Value,'QTY',7,1)
		nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_D_P.Value,'ID_D_P',-3)
		
		PRIVATE cWhat, cSOItem, cSalesP, pSalesDate, pPounds, pQTY
		cWhat = 'ADD_WOD'
		cSOItem = ''
		cSalesP = '' 
		pSalesDate = ''
		pPounds = 0
		pQTY = 0
		PRIVATE cComment, pShipDue, cTBL, cPOitem, nWO, nID_Detail, cInqNumP 
		cComment= ''
		pShipDue = ''
		cTBL = 'S'
		cPOitem = ''
