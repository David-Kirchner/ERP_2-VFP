	PROCEDURE chkStkListed.Click
		IF ThisFormSet.frmStock_Produced.Visible
			ThisFormSet.frmStock_Produced.Visible = .F.
		ELSE
			PRIVATE nWO_Detail
			nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
			
			ThisFormSet.Show_frmStock_Produced(nWO_Detail)
			
			IF USED('tmpStock_Produced')
				*ThisFormSet.RefreshStockWOD()
				ThisFormSet.RefreshStock_Produced()
				ThisFormSet.frmStock_Produced.Visible = .T.
			ELSE
				MESSAGEBOX("No STK is listed to be made from this WO!",16,"Nothing to Show.")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmbFcc.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'ConditionCode')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		*This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE cmbFcc.InteractiveChange
		PRIVATE cCC
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		
