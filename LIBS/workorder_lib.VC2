	PROCEDURE Destroy
		*!*	IF USED("tmpWO_Detail")
		*!*		USE IN tmpWO_Detail
		*!*	ENDIF
		
		IF USED('tmpOrders_Track')	
			USE IN tmpOrders_Track
		ENDIF
		
		IF USED('tmpOrders_Sel')	
			USE IN tmpOrders_Sel
		ENDIF
		
		IF USED('tmpWOD_PO')	
			USE IN tmpWOD_PO
		ENDIF
	ENDPROC

	PROCEDURE getwod_po
	ENDPROC

	PROCEDURE get_orders_selected
		
		*ThisForm.Get_Orders_Selected()
		IF USED('tmpOrders_Sel')	
			ThisForm.grd_Orders_Sel.RecordSource = ''
			USE IN tmpOrders_Sel
		ENDIF
		ThisForm.txtSelQty.Value = 0
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT SP.SOitem, CAST(SP.QTY AS Numeric(9,1)) AS QTY1, SP.Comment, SP.DueDate, SP.ID_Detail_Process, SP.* "
		cSQL = cSQL +" FROM dbo.StockLst_Process SP "
		cSQL = cSQL +" WHERE SP.ID_Detail IN "
		cSQL = cSQL +" (SELECT DISTINCT ID_Detail FROM dbo.StockLst_Process "
		cSQL = cSQL +" WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)+" )"
		cSQL = cSQL +" AND SP.Process_ID = 'SELECTED' ORDER BY SP.ID_Detail, SP.SOitem "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrders_Sel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrders_Sel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Sel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Sel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpOrders_Sel')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpOrders_Sel')
				IF RECCOUNT('tmpOrders_Sel') > 0
					lFound_WOD = .T.
					PRIVATE nSelQty
					SET TALK OFF
					SUM QTY1 TO nSelQty FOR Process_ID = 'SELECTED' 
					ThisForm.txtSelQty.Value = ROUND(nSelQty,1)
					IF ThisForm.txtSelQty.Value > PrepareSQLnum(ThisForm.txtFWeight.Value,'Weight',9,1)
						ThisForm.txtSelQty.BackColor = RGB(255,0,10)				
						ThisForm.txtSelQty.DisabledBackColor = RGB(255,0,10)				
					ENDIF
					GO TOP
				ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('tmpOrders_Sel') AND lFound_WOD 
			ThisForm.grd_Orders_Sel.RecordSource = 'tmpOrders_Sel'
			*ThisForm.grd_Orders_Sel.Visible = .T.
			ThisForm.RefreshOrder_Sel()
			
		ENDIF
				
	ENDPROC

	PROCEDURE get_orders_track
		
		*ThisForm.Get_Orders_Track()
		IF USED('tmpOrders_Track')	
			ThisForm.grd_Orders_Track.RecordSource = ''
			USE IN tmpOrders_Track
		ENDIF
		ThisForm.txtTrackQTY.Value = 0
		
		PRIVATE lFound_WOD 
		lFound_WOD = .F.
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT [SOitem],CAST([QTY] as Numeric(7,1)) AS QTY,[ID_Detail_Process],ISNULL([DPAS],0) AS DPAS,[ID] "
		cSQL = cSQL +" FROM dbo.[WOD_Orders] "
		cSQL = cSQL +" WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)
		cSQL = cSQL +" AND ISNULL(canc,0) < 1"
		cSQL = cSQL +" ORDER BY SOitem "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrders_Track')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpOrders_Track')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Track")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Track")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpOrders_Track')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpOrders_Track')
				IF RECCOUNT('tmpOrders_Track') > 0
					lFound_WOD = .T.
					PRIVATE nTrackQty
					SET TALK OFF
					SUM QTY TO nTrackQty &&FOR Process_ID = 'SELECTED' 
					ThisForm.txtTrackQTY.Value = ROUND(nTrackQty ,1)
					IF ThisForm.txtTrackQTY.Value > ThisForm.txtFWeight.Value
						ThisForm.txtTrackQTY.BackColor = RGB(255,0,10)			
						ThisForm.txtTrackQTY.DisabledBackColor = RGB(255,0,10)
					ENDIF
					GO TOP
				ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('tmpOrders_Track') AND lFound_WOD 
			ThisForm.grd_Orders_Track.RecordSource = 'tmpOrders_Track'
		*	ThisForm.RefreshOrder_Track()
		ENDIF
		
		ThisForm.RefreshOrder_Track()
				
	ENDPROC

	PROCEDURE get_wod_po
		*ThisForm.Get_WOD_PO()
		
		IF USED('tmpWOD_PO')	
			ThisForm.grd_WOD_PO.RecordSource = ''
			USE IN tmpWOD_PO
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT [WO_Detail],[POitem],[Company] "
		cSQL = cSQL +" ,dbo.f_BestDate( [Due_Min],[Due_Max]) AS DueDate "
		cSQL = cSQL +" ,dbo.f_BestDate( [HPA_Due_Min],[HPA_Due_Max]) AS HPADueDate "
		cSQL = cSQL +" ,[Received],Cmplt "
		cSQL = cSQL +" ,(case when SOitem = 'LabService' then 1 else 0 end ) AS Testing "
		cSQL = cSQL +" ,(case when SOitem = 'ConvertSVC' then 1 else 0 end ) AS ConvertSVC "
		cSQL = cSQL +" FROM dbo.[PurchaseOrder] "
		cSQL = cSQL +" WHERE ISNULL(WO_Detail,0) = "+STR(ThisForm.nWO_Detail)
		cSQL = cSQL +" AND Cancelled = 0 "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWOD_PO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWOD_PO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWOD_PO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWOD_PO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpWOD_PO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOD_PO')
				*IF RECCOUNT('tmpWOD_PO') > 0
					
				*ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('tmpWOD_PO') 
			ThisForm.grd_WOD_PO.RecordSource = 'tmpWOD_PO'
			*ThisForm.grd_WOD_PO.Visible = .T.
			ThisForm.RefreshWOD_PO()
			
		ENDIF
				
	ENDPROC

	PROCEDURE Load
		
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		
	ENDPROC

	PROCEDURE refreshforms
		PARAMETERS pForm
		*ThisForm.RefreshForms()
		
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		
		IF NOT EMPTY(pForm) OR LEN(pForm) > 0
			IF GetFormCaptions(pForm,ThisForm.nConnHandle)
				IF USED('tmpFormCaptions')
					ThisForm.lblFThck.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisForm.lblFSz2.Caption 	= RTRIM(tmpFormCaptions.txt2)
					ThisForm.lblFSz2.Visible 	= tmpFormCaptions.lblSz2Vis
					ThisForm.lblFSz3.Caption 	= RTRIM(tmpFormCaptions.txt3)
					ThisForm.lblFSz3.Visible 	= tmpFormCaptions.lblSz3Vis
					ThisForm.txtFSz3.Visible 	= tmpFormCaptions.use3rdDim
					ThisForm.lblFSz3.Enabled 	= tmpFormCaptions.Sz3Enable
					ThisForm.lblFSz4.Caption	= RTRIM(tmpFormCaptions.txt4)
					ThisForm.lblFSz4.Visible 	= tmpFormCaptions.lblSz4Vis
		
					
					USE IN tmpFormCaptions
				ELSE
					TrackMess( "tmpFormCaptions is not used!")
					TrackError("Table tmpFormCaptions is not open!","tmpFormCaptions is not used!", PROGRAM(), LINENO(1))
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT EMPTY(lCurrentTable)
			IF USED(lCurrentTable)
				SELECT (lCurrentTable)
			ENDIF
		ENDIF
		
		
		
		
		
	ENDPROC

	PROCEDURE refreshorder_sel
		
		*ThisForm.RefreshOrder_Sel()
		ThisForm.lblID_D_P.Caption = STR(tmpOrders_Sel.ID_Detail_Process)
		Thisform.txtSOitem.Value = tmpOrders_Sel.SOitem
		ThisForm.txtQTY1.Value	= tmpOrders_Sel.QTY1
		ThisForm.txtDueDate.Value = tmpOrders_Sel.DueDate
		ThisForm.chkSub.Value = IIF(tmpOrders_Sel.AllowSub = 'Y',.T.,.F.)
		
		ThisForm.txtWOD_Sel.Value = tmpOrders_Sel.WO_Detail
		*Do not store to ThisForm.nWO_Detail
		
		IF tmpOrders_Sel.WO_Detail = 0
			ThisForm.cmdAddWO_Detail.Visible = .T.
			ThisForm.cmdRemoveWOD_Proc.Visible = .F.
		ELSE
			ThisForm.cmdAddWO_Detail.Visible = .F.
			ThisForm.cmdRemoveWOD_Proc.Visible = .T.
		ENDIF
	ENDPROC

	PROCEDURE refreshorder_track
		*Thisform.RefreshOrder_Track()
		
		
		Thisform.txtSOitemT.Value = tmpOrders_Track.SOitem
		ThisForm.txtQTY0.Value	= tmpOrders_Track.QTY
		ThisForm.txtID_D_P.Value = tmpOrders_Track.ID_Detail_Process
		ThisForm.chkDPAS.Value = tmpOrders_Track.DPAS
		ThisForm.lblID.Caption = STR(tmpOrders_Track.ID)
		
		*ThisForm.chkSub.Value = IIF(tmpOrders_Track.AllowSub = 'Y',.T.,.F.)
	ENDPROC

	PROCEDURE refreshwod_po
		*ThisForm.RefreshWOD_PO()
		
		ThisForm.txtPOitem.Value	= tmpWOD_PO.POitem
		ThisForm.txtVendor.Value	= tmpWOD_PO.Company
		ThisForm.chkPO_Testing.Value = tmpWOD_PO.Testing
		ThisForm.chkPO_SVC.Value 	= tmpWOD_PO.ConvertSVC
		ThisForm.txtPO_DueDate.Value 	= tmpWOD_PO.DueDate
		ThisForm.txtPO_Received.Value	= tmpWOD_PO.Received
		ThisForm.chkPO_Complete.Value	= tmpWOD_PO.Cmplt 
	ENDPROC

	PROCEDURE refreshwo_detail_so
		PARAMETER pnWO_Detail
		*DO FORM Forms\WO_Detail_SO WITH nWO_Detail 
		
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pnWO_Detail,'WO_Detail',-3)
		ThisForm.nWO_Detail = nWO_Detail
		****
		*!*	IF VARTYPE(nTop) = "N"
		*!*		ThisForm.Top = nTop
		*!*	ENDIF
		*!*	IF VARTYPE(nLeft) = "N"
		*!*		ThisForm.Left = nLeft + 15
		*!*	ENDIF
		
		
		
		****
		PRIVATE lFound_WOD 
		lFound_WOD = .F.
		
		IF USED('tmpWOD_Orders')	
			USE IN tmpWOD_Orders
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT WOD.*"
		cSQL = cSQL +" FROM dbo.WorkOrder_Detail WOD "
		cSQL = cSQL +" WHERE WOD.WO_Detail ="+STR(nWO_Detail)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWOD_Orders')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpWOD_Orders')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWOD_Orders")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWOD_Orders")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpWOD_Orders')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOD_Orders')
				IF RECCOUNT('tmpWOD_Orders') > 0
					SELECT tmpWOD_Orders
					LOCATE FOR WO_Detail = nWO_Detail
					IF FOUND()
						lFound_WOD = .T.
					ELSE
						GO TOP
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('tmpWOD_Orders') AND lFound_WOD 
			IF FOUND('tmpWOD_Orders')
				
				ThisForm.Visible =.T.
				
				ThisForm.txtWO_Detail.Value = nWO_Detail
				
				ThisForm.txtWO.Value = PrepareSQLnum(tmpWOD_Orders.WO,'WO',-3)
				
				ThisForm.txtFPieces.Value	= PrepareSQLnum(tmpWOD_Orders.fPieces,'Pieces',-3)
				ThisForm.txtFAlloy.Value	= PrepareSQLtxt(tmpWOD_Orders.fAlloy,'Alloy',12)
				ThisForm.cmbFForm.Value		= PrepareSQLtxt(tmpWOD_Orders.fForm,'Form',2)
				*ThisFormSet.RefreshFForms(tmpWOD_Orders.fForm)
				ThisForm.cmbFcc.Value		= PrepareSQLtxt(tmpWOD_Orders.fCC,'CC',1)
				*ThisFormSet.InitcmbFCL()
		
				ThisForm.cmbFCL.Value		= PrepareSQLtxt(tmpWOD_Orders.fCL,'CL',1)
				ThisForm.txtFThck.Value		= PrepareSQLnum(tmpWOD_Orders.fThck,'Thck',10,4)
				ThisForm.txtFSz2.Value		= PrepareSQLnum(tmpWOD_Orders.fSz2,'Sz2',9,3)
				ThisForm.txtFSz3.Value		= PrepareSQLnum(tmpWOD_Orders.fSz3,'Sz3',9,3)
		*		ThisForm.chkPinFWeight.Value	= PrepareSQLchk(tmpWOD_Orders.pinFWeight,'pinFWeight')
				ThisForm.txtFWeight.Value 	= PrepareSQLnum(tmpWOD_Orders.fWeight,'Weight',9,1)
		
				ThisForm.txtFSpec.Value		= PrepareSQLtxt(tmpWOD_Orders.fSpec,'FSpec',50)
		
		*		ThisForm.txtStock_Projected_ID.Value = PrepareSQLnum(tmpWOD_Orders.Stock_Projected_ID,'Stock_Projected_ID',-3)
				*ThisFormSet.Refresh_Projected()
				
				ThisForm.txtFID_Detail.Value = PrepareSQLnum(tmpWOD_Orders.fID_Detail,'ID_Detail',-3)
				IF PrepareSQLnum(tmpWOD_Orders.fID_Detail,'ID_Detail',-3) > 0
					ThisForm.txtFID_Detail.BackColor = RGB(0,128,255)
				ELSE
					ThisForm.txtFID_Detail.BackColor = RGB(240,240,240)
				ENDIF	
				ThisForm.txtFID_Detail_Process.Value = PrepareSQLnum(tmpWOD_Orders.fID_Detail_Process,'ID_Detail_Process',-3)
				ThisForm.txtfTBL.Value 			= PrepareSQLtxt(tmpWOD_Orders.fTBL,'TBL',1)
		
		*		ThisForm.txtfReceivingID.Value 	= PrepareSQLnum(tmpWOD_Orders.fReceivingID,'ReceivingID',-3)
		*		ThisForm.txtAC_ID_WOD.Value	= PrepareSQLnum(tmpWOD_Orders.AC_ID_WOD,'AC_ID',-3)
				
		*		ThisForm.txtFSOitem.Value	= PrepareSQLtxt(tmpWOD_Orders.fSOitem,'SOitem',10)
		*		ThisForm.txtFPOitem.Value	= PrepareSQLtxt(tmpWOD_Orders.fPOitem,'POitem',12)
				
				ThisForm.txtFDescript.Value	= PrepareSQLtxt(tmpWOD_Orders.fDescript,'Descript',100)
				ThisForm.txtfCondLevel.Value= PrepareSQLtxt(tmpWOD_Orders.fCondLevel,'fCondLevel',30)
				
				ThisForm.cmbFollowM.Value	= PrepareSQLtxt(tmpWOD_Orders.FollowM,'FollowM',20)
				ThisForm.txtFollowLot.Value	= PrepareSQLnum(tmpWOD_Orders.FollowLot,'FollowLot',-3)
				ThisForm.cmbFinishM.Value	= PrepareSQLtxt(tmpWOD_Orders.FinishM,'FinishM',20)
				ThisForm.txtFinishLot.Value	= PrepareSQLnum(tmpWOD_Orders.FinishLot,'FinishLot',-3)
				
		*		ThisForm.txtTestPO.Value	= PrepareSQLtxt(tmpWOD_Orders.TestPO,'POitem',12)
				
		*		ThisForm.txtStartSize.Value	= PrepareSQLnum(tmpWOD_Orders.StartSize,'StartSize',8,3)
		*		ThisForm.txtCW.Value		= PrepareSQLnum(tmpWOD_Orders.CW,'CW',-1)
		*		ThisForm.txtRoughSize.Value = PrepareSQLnum(tmpWOD_Orders.RoughSize,'RoughSize',8,3)
		*		ThisForm.txtOverSize.Value	= PrepareSQLnum(tmpWOD_Orders.OverSize,'OverSize',5,3)
				
		*		ThisForm.edtfNotes.Value	= PrepareSQLtxt(tmpWOD_Orders.fNotes,'Notes',-1)
				
			
				ThisForm.txtFDueDate.Value	= PrepareSQLdate(tmpWOD_Orders.fDueDate,'DueDate')
		*		ThisForm.cmbNextCode.Value	= PrepareSQLtxt(tmpWOD_Orders.NextCode,'NextCode',3)
		*		ThisForm.txtNextNumber.Value = PrepareSQLtxt(tmpWOD_Orders.NextNumber,'NextNumber',10)
		
				
				ThisForm.chkfCmplt.Value 	= PrepareSQLchk(tmpWOD_Orders.fCmplt,'fCmplt')
				ThisForm.chkfCncld.Value	= PrepareSQLchk(tmpWOD_Orders.fCncld,'fCncld')
				
				ThisForm.chkStkListed.Value = PrepareSQLchk(tmpWOD_Orders.StkListed,'StkListed')
				
				*************************************		
				*ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWOD_Orders.fPOitem)
		
				*IF ThisFormSet.CheckFinish_ID_Detail()
				*ENDIF
				*IF ThisFormSet.CheckFinish_ID_Detail_Process()
				*ENDIF
				
				**********
				*ThisForm.lstWO_Detail.Value = RECNO('tmpWOD_Orders')
				*ThisForm.lstWO_Detail.Value = ASCAN(gaWO_Detail, nWO_Detail)  &&gaWO_Detail was empty!!
				
				*ThisForm.lstWO_Detail.Visible = .T.
				
				*ThisFormSet.Show_frmStock_Produced(nWO_Detail)
				
				
			ELSE
				MESSAGEBOX("Could not find WO_Detail:"+ALLTRIM(STR(nWO_Detail)),0,"Error")
			ENDIF
			
		ENDIF
			
		
		************
		ThisForm.Visible = .T.
		ThisForm.Get_Orders_Track()
		ThisForm.Get_Orders_Selected()
		
	ENDPROC

	PROCEDURE Unload
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		*RETURN ThisForm.nHoldNumber
	ENDPROC

