		nID_Detail = 0
		cInqNumP = ''
		
		DO FORM Forms\StockLst_Process WITH cWhat, nID_Detail_Process, cSOItem, cSalesP, pSalesDate,pPounds,pQTY, cComment, pShipDue ,cTBL, cPOitem, nWO, nID_Detail, cInqNumP TO nID_Detail_Process
		
		*PARAMTER                         cWhatDo, pID_D_P           , pSOItem, pSalesP,          pSalesDate,            pLBS,         pQTY,                            pComment,         pShipDue,      pLst, pPoItem, pWO, pID_Detail         , pInqNumP
		*PARAMETER cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue,'StockLst',nWO
		
	ENDPROC

	PROCEDURE cmdCopy2Track.Click
		
		*INSERT into dbo.[WOD_Orders]
		* ([WO_Detail],[SOitem],[QTY],[ID_Detail_Process]) Values
		* (2312,' 127932-04' ,240  ,250606)
		
		PRIVATE cSOitem, nQTY
		cSOitem = PrepareSQLtxt(tmpOrders_Sel.SOitem,'SOitem',10)
		nQTY	= PrepareSQLnum(tmpOrders_Sel.QTY,'QTY',7,1)
		nID_D_P = PrepareSQLnum(tmpOrders_Sel.ID_Detail_Process,'ID_D_P',-3)
		
		IF nID_D_P > 0
		PRIVATE cSQL, nSQLEXEC 
		**see if exists
		
		SELECT 0
		
		cSQL = " IF NOT EXISTS(SELECT * FROM dbo.WOD_Orders "
			cSQL=cSQL+" WHERE [WO_Detail] = "+STR(ThisForm.nWO_Detail)
			cSQL=cSQL+" AND [SOitem] = '"+cSOitem+"'"
			cSQL=cSQL+" AND [QTY] = "+ALLTRIM(STR(nQTY,7,1))
			*cSQL=cSQL+" AND ISNULL([DPAS],0) = 0"
			cSQL=cSQL+" AND [ID_Detail_Process] = "+STR(nID_D_P)
			cSQL=cSQL+" AND ISNULL([canc],0) = 0" 
			cSQL=cSQL+" ) "
		
			cSQL=cSQL+" INSERT INTO dbo.WOD_Orders "
			cSQL=cSQL+"([WO_Detail],[SOitem],[QTY],[ID_Detail_Process]) Values"
			cSQL=cSQL+"("+STR(ThisForm.nWO_Detail)
			cSQL=cSQL+",'"+cSOitem+"'"
			cSQL=cSQL+","+ALLTRIM(STR(nQTY,7,1))
			cSQL=cSQL+","+STR(nID_D_P)+" )"
			cSQL=cSQL+";"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOTrackINS')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpOTrackINS')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOTrackINS")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOTrackINS")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpOTrackINS')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		
			ThisForm.Get_Orders_Track()
		ENDIF
		
	ENDPROC

	PROCEDURE cmdDel_Track.Click
		PRIVATE cSOitem, nQTY, nID_D_P 
		cSOitem= PrepareSQLtxt(ThisForm.txtSOitemT.Value,'SOitem',10)
		nQTY	= PrepareSQLnum(ThisForm.txtQTY0.Value,'QTY',7,1)
		nID_D_P = PrepareSQLnum(ThisForm.txtID_D_P.Value,'ID_D_P',-3)
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "DELETE FROM dbo.WOD_Orders WHERE "
		cSQL=cSQL+" [WO_Detail] ="+STR(ThisForm.nWO_Detail)
		cSQL=cSQL+" AND [SOitem]='"+cSOitem+"'"
		cSQL=cSQL+" AND [QTY]="+ALLTRIM(STR(nQTY,7,1))
		cSQL=cSQL+" AND [ID_Detail_Process]="+STR(nID_D_P)
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		ThisForm.Get_Orders_Track()
	ENDPROC

	PROCEDURE cmdEditQTY.Click
		IF This.Caption = "<--Edit"
			ThisForm.txtQTY0.ReadOnly = .F.
			
			This.Caption ="<--Save"
		ELSE
			*Save the QTY
			ThisForm.txtQTY0.ReadOnly = .T.
			PRIVATE nQTY
			nQTY = PREPARESQLnum(ThisForm.txtQTY0.Value,'QTY',-5)
				
			PRIVATE cSOitem, nID
			*cSOitem= PrepareSQLtxt(ThisForm.txtSOITEMT.Value,'SOitem',10)
			*nID = tmpOrders_Track.ID
			nID = PrepareSQLnum(ThisForm.lblID.Caption,'ID',-3)
			
			PRIVATE cSQL, nSQLEXEC 
		
			SELECT 0
			cSQL = "UPDATE dbo.[WOD_Orders] SET "
			cSQL = cSQL +" QTY = "+ALLTRIM(STR(nQTY,7,1))
			cSQL = cSQL +" WHERE ID ="+STR(nID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrders_Track')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpOrders_Track')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Track")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrders_Track")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpOrders_Track')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			
			ThisForm.Get_Orders_Track()
			*CALLS:ThisForm.RefreshOrder_Track()
			
			This.Caption = "<--Edit"
		ENDIF
	ENDPROC

	PROCEDURE cmdFinishshow.Click
		PRIVATE cMach, nLot, cLot, cAlloy,nfThick 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'Mach',20)
		nLot	= PrepareSQLnum(ThisForm.txtFinishLot.Value,'Lot',-3)
		cLot	= PrepareSQLtxt(ThisForm.txtFinishLot.Value,'Lot',10)
		*cAlloy	= PrepareSQLtxt(ThisForm.txtfAlloy.Value,'Alloy',12)
		*nfThick = PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',10,4)
		
		IF EMPTY(cMach)
			MESSAGEBOX("You must Declare the Maching before inserting a new LOT",16,"Unknown machine")
			RETURN .F.
		ENDIF
		*!*	IF nfThick=0 OR EMPTY(cAlloy)
		*!*		MESSAGEBOX("Please fill in more the 'Finish' WO_Detail so a good insert log can be made.",16,"Unknown machine")
		*!*		RETURN .F.
		*!*	ENDIF
		
		DO CASE
		*Conversion_Log
		*Draw_Log
		CASE UPPER(LEFT(cMach,1)) = "D"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		*GFMLog
		CASE UPPER(LEFT(cMach,1)) = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		*HT_Lot
		*LakeErie_log
		CASE UPPER(LEFT(cMach,1)) = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		*Roll_log
		CASE UPPER(LEFT(cMach,1)) = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		*Swage_log	
		CASE UPPER(LEFT(cMach,1)) = "S"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		*Wire_log
		CASE UPPER(LEFT(cMach,1)) = "W"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		OTHERWISE
			MESSAGEBOX("Unknown Machine",16,"Unknown machine")
			RETURN .F.
		ENDCASE
		
		
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_MFG_Log(cMach,nLot,.T.)
		
		IF NOT EMPTY(m.cHyperLink)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			WAIT WINDOW "No Report to display" NOWAIT
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE cmdFollowShow.Click
		PRIVATE cMach, nLot, cLot, cAlloy,nfThick 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFollowM.Value,'Mach',20)
		nLot	= PrepareSQLnum(ThisForm.txtFollowLot.Value,'Lot',-3)
		cLot	= PrepareSQLtxt(ThisForm.txtFollowLot.Value,'Lot',10)
		*cAlloy	= PrepareSQLtxt(ThisForm.txtfAlloy.Value,'Alloy',12)
		*nfThick = PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',10,4)
		
		IF EMPTY(cMach)
			MESSAGEBOX("You must Declare the Maching before inserting a new LOT",16,"Unknown machine")
			RETURN .F.
		ENDIF
		
		DO CASE
		*Conversion_Log
		
		*Draw_Log
		CASE UPPER(cMach) = "DRAW BENCH"  
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "D"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		*GFMLog
		CASE UPPER(cMach) = "GFM" 
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		CASE UPPER(cMach) = "HEAT TREAT" 
		*HT_Lot
		
		*LakeErie_log
		CASE UPPER(cMach) = "OPEN DIE" 
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		*Roll_log
		CASE UPPER(cMach) = "ROLLING"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		*Swage_log	
		CASE UPPER(cMach) = "SWAGE"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "S"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		*Wire_log
		CASE UPPER(cMach) = "WIRE DRAW" 
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "W"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		OTHERWISE
			MESSAGEBOX("Unknown Machine",16,"Unknown machine")
			RETURN .F.
		ENDCASE
		
		
			
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_MFG_Log(cMach,nLot,.T.)
		
		IF NOT EMPTY(m.cHyperLink)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			WAIT WINDOW "No Report to display" NOWAIT
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdRemoveWOD_Proc.Click
		PRIVATE nWO_Detail, nID_D_P
		nWO_Detail = ThisForm.nWO_Detail
		*nID_D_P	= tmpOrders_Sel.ID_Detail_Process
		nID_D_P	= PrepareSQLnum(ThisForm.lblID_D_P.Caption,'ID_D_P',-3)
		
		PRIVATE cSQL, nSQLEXEC 
		SELECT 0
		cSQL = "UPDATE dbo.StockLst_Process SET WO_Detail = 0"
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_D_P)
		cSQL = cSQL +" AND Process_ID = 'SELECTED' "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			SELECT tmpOrders_Sel
			REPLACE WO_Detail WITH 0 IN tmpOrders_Sel
			ThisForm.txtWOD_Sel.Value = 0
			
			ThisForm.Get_Orders_Selected()
			
			ThisForm.cmdAddWO_Detail.Visible = .T.
			This.Visible = .F.
		ENDIF
		
		**************************************************************
		*!*				&&REMOVE Process
		*!*				
		*!*				cSQLd = "DELETE "
		*!*				cSQLd = cSQLd + " FROM dbo.StockLst_Process "
		*!*				cSQLd = cSQLd + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_D_P))
		*!*				
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd)
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0
		*!*					IF NOT SQLEXECError(cSQLd,ThisForm.nConnHandle,nSQLEXEC, '')
		*!*						lOK = .F.
		*!*						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLd )
		*!*					ENDIF
		*!*				ELSE
		*!*					WAIT WINDOW "DELETED Process from StockLst!" NOWAIT
		*!*				ENDIF
	ENDPROC

