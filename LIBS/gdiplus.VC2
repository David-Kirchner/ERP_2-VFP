	ENDPROC

	PROCEDURE drawellipse		&& Draw outlined ellipse specified by its bounding rectangle
		LPARAMETERS toPen, tvXOrRect, tnY, tnWidth , tnHeight
		
		*-- Parameters either (pen, x, y, width ,height) or (pen, rect)
		
		DECLARE INTEGER GdipDrawEllipse IN gdiplus.DLL INTEGER nGraphics, INTEGER nPen, SINGLE, SINGLE, SINGLE, SINGLE
		
		WITH THIS
		
			IF VARTYPE(tvXOrRect)='O'
		
				.nGDIPStatus = GdipDrawEllipse(.nGDIPHandle, toPen.GetHandle(), tvXOrRect.nX, tvXOrRect.Y, tvXOrRect.nWidth, tvXOrRect.nHeight)
			ELSE
				.nGDIPStatus = GdipDrawEllipse(.nGDIPHandle, toPen.GetHandle(), tvXOrRect, tnY, tnWidth, tnHeight)
			ENDIF
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE drawimageat		&& Draw image at the specified location, using its original physical size
	ENDPROC

	PROCEDURE drawimageportionat		&& Draw portion of an image at the specified location, using its original size
		LPARAMETERS toImage, tnX, tnY, toSrcRect, tnSrcUnit
		
		DECLARE INTEGER GdipDrawImageRectRect IN GDIPLUS.DLL INTEGER Graphics, INTEGER nImage, SINGLE dstx, SINGLE dsty, SINGLE dstwidth, SINGLE dstheight, SINGLE srcx, SINGLE srcy, SINGLE srcwidth, SINGLE srcheight, INTEGER srcUnit, INTEGER imageAttributes, INTEGER Callback, INTEGER CallbackData
		
		WITH THIS
		
			.nGDIPStatus = GdipDrawImageRectRect(.nGDIPHandle, toImage.GetHandle(), ;
				tnX, tnY, toSrcRect.nWidth, toSrcRect.nHeight, ;
				0, 0, toSrcRect.nWidth, toSrcRect.nHeight, ;
				cnGDIPLUS_Unit_PIXEL, toImage.nImageAttributes, 0, 0)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE drawimageportionatpoint		&& Draw portion of an image at the specified location, using its original size
	ENDPROC

	PROCEDURE drawimageportionscaled		&& Draw portion of an image at the specified location and with the specified size
	ENDPROC

	PROCEDURE drawimagescaled		&& Draw image at the specified location with the specified size.
		LPARAMETERS toImage, tvDestRectOrX, tnDestY, tnDestW, tnDestH
		
		DECLARE INTEGER GdipDrawImageRect IN gdiplus.DLL INTEGER nGraphics, INTEGER nImage, SINGLE,SINGLE,SINGLE,SINGLE
		DECLARE INTEGER GdipDrawImageRectRect IN gdiplus.DLL INTEGER Graphics, INTEGER nImage, SINGLE dstx, SINGLE dsty, SINGLE dstwidth, SINGLE dstheight, SINGLE srcx, SINGLE srcy, SINGLE srcwidth, SINGLE srcheight, INTEGER srcUnit, INTEGER imageAttributes, INTEGER Callback, INTEGER CallbackData
		
		LOCAL lnDestX
		LOCAL lnDestY
		LOCAL lnDestW
		LOCAL lnDestH
		
		WITH THIS
		
			DO CASE
				CASE VARTYPE(tvDestRectOrX) + VARTYPE(tnDestY) + VARTYPE(tnDestW) + VARTYPE(tnDestH) = 'NNNN'
		*-- Passed separate coordinates
					lnDestX = tvDestRectOrX
					lnDestY = tnDestY
					lnDestW = tnDestW
					lnDestH = tnDestH
		
				CASE VARTYPE(tvDestRectOrX) + VARTYPE(tnDestY) + VARTYPE(tnDestW) + VARTYPE(tnDestH)='OLLL'	AND pemstatus(tvDestRectOrX,'nX',5) AND pemstatus(tvDestRectOrX,'nWidth',5)
		*-- Passed a Rect object
					lnDestX = tvDestRectOrX.nX
					lnDestY = tvDestRectOrX.nY
					lnDestW = tvDestRectOrX.nWidth
					lnDestH = tvDestRectOrX.nHeight
				OTHERWISE
					THIS.nGDIPStatus = cnGDIPLUS_STATUS_InvalidParameter
		
					RETURN .F.
			ENDCASE
		
			IF toImage.lPartiallyTransparent
				.nGDIPStatus = GdipDrawImageRectRect(.nGDIPHandle, toImage.GetHandle(), ;
					lnDestX, lnDestY, lnDestW, lnDestH, ;
					0, 0, toImage.nImageWidth, toImage.nImageHeight, ;
					cnGDIPLUS_Unit_PIXEL, toImage.nImageAttributes, 0, 0)
			ELSE
				.nGDIPStatus = GdipDrawImageRect(.nGDIPHandle, toImage.GetHandle(), lnDestX, lnDestY, lnDestW, lnDestH )
			ENDIF
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

