	PROCEDURE drawcurve		&& Draw a smooth curve given a 2-column array of coordinates
		LPARAMETERS toPen, taPoints, tnFirstCol
		
		DECLARE INTEGER GdipDrawCurve IN gdiplus.DLL INTEGER nGraphics, INTEGER nPen, STRING cPoints, INTEGER nCount
		
		EXTERNAL ARRAY taPoints
		
		LOCAL lcPoints
		
		WITH THIS
		
			lcPoints = .MakeGDIPArrayF(@taPoints, 2, tnFirstCol)
		
			.nGDIPStatus = GdipDrawCurve(.nGDIPHandle, toPen.GetHandle(), lcPoints, LEN(lcPoints)/8 )
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

