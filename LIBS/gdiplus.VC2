	ENDPROC

	PROCEDURE drawbezier		&& Draw a Bézier spline from 4 control points
		LPARAMETERS toPen, tnX1, tnY1, tnX2, tnY2, tnX3, tnY3, tnX4, tnY4
		
		DECLARE INTEGER GdipDrawBezier IN gdiplus.DLL INTEGER nGraphics, INTEGER nPen, SINGLE,SINGLE,SINGLE,SINGLE,SINGLE,SINGLE,SINGLE,SINGLE
		
		WITH THIS
			.nGDIPStatus = GdipDrawBezier(.nGDIPHandle, toPen.GetHandle() , tnX1, tnY1, tnX2, tnY2, tnX3, tnY3, tnX4, tnY4)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

