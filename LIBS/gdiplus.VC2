DEFINE CLASS gdibitmap AS gdiimage OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: create
		*m: createfromgraphics		&& Create from a GpGraphics object
		*m: getpixel		&& Get the colour value of an individual pixel
		*m: makecolormap
		*m: makepartiallytransparent
		*m: remapcolortable
		*m: setpixel		&& Set an individual pixel in this image to a specific colour value
		*p: lpartiallytransparent
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdibitmap"
		nflags = 0
		nimageheight = 0
		nimagetype = 0
		nimagewidth = 0
		nrawformat = 0
	*</PropValue>
	
	PROCEDURE create
		LPARAMETERS tnWidth, tnHeight, tnPixelFormat
		
		DECLARE INTEGER GdipCreateBitmapFromScan0 IN gdiplus.DLL INTEGER nWidth, INTEGER nHeight, INTEGER nStride,INTEGER nPixelFormat, STRING @ cScan0, INTEGER @ nImage
		
		LOCAL lnHandle
		
		WITH THIS
		
			lnHandle = 0
		
			.DESTROY()
		
			.nGDIPStatus = GdipCreateBitmapFromScan0(tnWidth, tnHeight, 0, IIF(VARTYPE(tnPixelFormat)='N', tnPixelFormat, cnGDIPLUS_PIXELFORMAT_32bppARGB), 0, @lnHandle)	
			
			.SetHandle(lnHandle,.T.)
		
			RETURN .nGDIPStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE createfromfile
		LPARAMETERS tcFilename, tlUseEmbeddedColorMgmt
		
		DECLARE INTEGER GdipCreateBitmapFromFileICM IN gdiplus.DLL STRING wFilename, INTEGER @ nImage
		DECLARE INTEGER GdipCreateBitmapFromFile IN gdiplus.DLL STRING wFilename, INTEGER @ nImage
		
		LOCAL lnHandle
		
		WITH THIS
		
			lnHandle = 0
		
			.DESTROY()
		
			IF tlUseEmbeddedColorMgmt
				.nGDIPStatus = GdipCreateBitmapFromFileICM(STRCONV(tcFilename + CHR(0),5),@lnHandle)
			ELSE
				.nGDIPStatus = GdipCreateBitmapFromFile(STRCONV(tcFilename+CHR(0),5),@lnHandle)
			ENDIF
		
			.SetHandle(lnHandle, .T.)
		
			RETURN .nGDIPStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE createfromgraphics		&& Create from a GpGraphics object
		LPARAMETERS tvGraphics, tnWidth, tnHeight
		
		DECLARE INTEGER GdipCreateBitmapFromGraphics IN gdiplus.DLL INTEGER nWidth, INTEGER nHeight, INTEGER nGraphics, INTEGER @ nImage
		
		LOCAL lnHandle
		
		WITH THIS
		
			lnHandle = 0
		
			.DESTROY()
			.nGDIPStatus = GdipCreateBitmapFromGraphics(tnWidth, tnHeight, IIF(VARTYPE(tvGraphics)='O',tvGraphics.GetHandle(),tvGraphics),@lnHandle)
		
			.SetHandle(lnHandle,.T.)
		
			RETURN .nGDIPStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE getpixel		&& Get the colour value of an individual pixel
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tvParam1, tvParam2, tvParam3		&&, tvParam4, tvParam5, tvParam6
		
		DO CASE
		CASE VARTYPE(tvParam1)+VARTYPE(tvParam2) == 'NN'
		*-- Width and height
			RETURN THIS.CREATE( tvParam1, tvParam2, tvParam3 )
			
		CASE VARTYPE(tvParam1) =='C'	
		
			RETURN THIS.CreateFromFile(tvParam1)	
			
		OTHERWISE
			RETURN DODEFAULT(tvParam1,tvParam2)
		ENDCASE
		
	ENDPROC

	PROCEDURE makecolormap
		LPARAMETERS taColorMap
		
		EXTERNAL ARRAY taColorMap
		
		LOCAL lcColorMap
		
		LOCAL lnCount
		LOCAL lnArgbOld
		LOCAL lnArgbNew
		
		WITH THIS
		
		    lcColorMap = ''
		
		    FOR lnCount = 1 TO ALEN(taColorMap, 1)
		
		        lnArgbOld = .FoxRGB2ARB(taColorMap(lnCount, 1), taColorMap(lnCount, 3))
		        lnArgbNew = .FoxRGB2ARB(taColorMap(lnCount, 2), taColorMap(lnCount, 4))
		
		        lcColorMap = lcColorMap + .Num2DWord(lnArgbOld) + .Num2DWord(lnArgbNew)
		
		    ENDFOR
		
		ENDWITH
		
		RETURN lcColorMap
		
	ENDPROC

	PROCEDURE makepartiallytransparent
		LPARAMETERS tnColorToTransparent
		
		LOCAL lnOldColor
		LOCAL lnNewColor
		LOCAL lnOldAlpha
		LOCAL lnNewAlpha
		
		WITH THIS
		
			lnOldColor = IIF(VARTYPE(tnColorToTransparent) = 'N' AND tnColorToTransparent => 0, tnColorToTransparent, RGB(255, 255, 255))
		
			lnNewColor = lnOldColor
			lnOldAlpha = 255
			lnNewAlpha = 0
		
			IF .RemapColorTable(lnOldColor, lnNewColor, lnOldAlpha, lnNewAlpha)
				.lPartiallyTransparent = .T.
			ENDIF	
		
		ENDWITH
		
	ENDPROC

	PROCEDURE remapcolortable
		LPARAMETERS tvOldColorOrArrayOfOldColors, tnNewColor, tnOldAlpha, tnNewAlpha
		
		DECLARE INTEGER GdipCreateImageAttributes IN gdiplus.DLL INTEGER @ImageAttributes
		DECLARE INTEGER GdipSetImageAttributesRemapTable IN gdiplus.DLL INTEGER imageattr, INTEGER ColorAdjustType, INTEGER enableFlag, INTEGER mapsize, STRING colorMap
		
		LOCAL lcColorMap
		
		LOCAL lnARGBOld
		LOCAL lnARGBNew
		LOCAL lnImageAttr
		LOCAL lnImageAttributes
		
		WITH THIS
		
			IF PCOUNT() = 1 AND VARTYPE(tvOldColorOrArrayOfOldColors) = 'N'
				lcColorMap = .MakeColorMap(@tvOldColorOrArrayOfOldColors)
			ELSE
				IF PCOUNT() = 2
					tnOldAlpha = 255
					tnNewAlpha = 255
				ENDIF
		
				IF VARTYPE(tvOldColorOrArrayOfOldColors) + VARTYPE(tnNewColor) <> 'NN'
		*-- Do Nothing
					RETURN
				ENDIF
		
				lnARGBOld  = .FoxRGB2ARGB(tvOldColorOrArrayOfOldColors, tnOldAlpha)
				lnARGBNew  = .FoxRGB2ARGB(tnNewColor, tnNewAlpha)
		
				lcColorMap = .Num2DWord(lnARGBOld) + .Num2DWord(lnARGBNew)
			ENDIF
		
			IF .nImageAttributes # 0
				.DisposeImageAttributes()
			ENDIF
		
			lnImageAttributes = 0
		
			.nGDIPStatus = GdipCreateImageAttributes(@lnImageAttributes)
		
			.nImageAttributes = lnImageAttributes
		
			.nGDIPStatus = GdipSetImageAttributesRemapTable(lnImageAttributes, 0 ,1, (LEN(lcColorMap)/4), lcColorMap)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE setpixel		&& Set an individual pixel in this image to a specific colour value
	ENDPROC

ENDDEFINE

