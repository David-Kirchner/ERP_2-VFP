	PROCEDURE fillpath
		LPARAMETER toBrush, toGraphicsPath
		*-- The FillPath method uses a brush to fill the interior of a path. If a figure in the
		*-- path is not closed, this method treats the nonclosed figure as if it were closed by a
		*-- straight line that connects the figure's starting and ending points.
		
		DECLARE GdipFillPath IN gdiplus.DLL LONG graphics, LONG brush, LONG PATH
		
		WITH THIS
			RETURN GdipFillPath(.GetHandle(), toBrush.GetHandle(), toGraphicsPath.GetHandle())
		ENDWITH
		
		
		
		
		
	ENDPROC

	PROCEDURE fillpie		&& Draw filled pie slice in specified pen and start/stop angles
		LPARAMETERS toBrush, tnXOroRect,tnYOrnStart,tnWOrnSweep,tnH, tnStart, tnSweep
		
		DECLARE INTEGER GdipFillPie IN gdiplus.DLL INTEGER nGraphics, INTEGER nBrush, SINGLE x, SINGLE Y, SINGLE w,SINGLE h, SINGLE fStart, SINGLE fSweep
		
		WITH THIS
		
			IF VARTYPE(tnXOroRect)='O'
				.nGDIPStatus = GdipFillPie(.nGDIPHandle, toBrush.GetHandle(), tnXOroRect.nX, tnXOroRect.nY, tnXOroRect.nWidth, tnXOroRect.nHeight, tnYOrnStart, tnWOrnSweep)
			ELSE
				.nGDIPStatus = GdipFillPie(.nGDIPHandle, toBrush.GetHandle(), tnXOroRect, tnYOrnStart, tnWOrnSweep, tnH, tnStart, tnSweep)
			ENDIF
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		
		ENDWITH
		
	ENDPROC

	PROCEDURE fillpolygon		&& Filll a polygon defined by a 2-column array of coordinates
		LPARAMETERS toBrush, taPoints, tnFirstCol, tnFillMode
		
		DECLARE INTEGER GdipFillPolygon IN gdiplus.DLL INTEGER nGraphics, INTEGER nBrush, STRING cPoints, INTEGER nCount, INTEGER nFillMode
		
		EXTERNAL ARRAY taPoints
		
		LOCAL lcPoints
		
		WITH THIS
		
			lcPoints = .MakeGdipArrayF(@taPoints, 2, tnFirstCol)
		
			.nGDIPStatus = GdipFillPolygon(.nGDIPHandle, toBrush.GetHandle(), lcPoints, LEN(lcPoints)/8, tnFillMode)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE fillpolygonfromcursor		&& Fill a polygon from a cursor defining coordinates
	ENDPROC

	PROCEDURE fillrectangle		&& Fill a rectangle
		LPARAMETERS toBrush, tvXOrRect, tnY, tnWidth, tnHeight
		
		*-- Parameters either ( brush, x,y,w,h )
		*-- or ( brush, rect )
		
		DECLARE INTEGER GdipFillRectangle IN gdiplus.DLL INTEGER nGraphics, INTEGER nBrush, SINGLE,SINGLE,SINGLE,SINGLE
		
		WITH THIS
		
			IF VARTYPE(tvXOrRect)='O'
				.nGDIPStatus = GdipFillRectangle(.nGDIPHandle, toBrush.GetHandle(), tvXOrRect.nX, tvXOrRect.nY, tvXOrRect.nWidth, tvXOrRect.nHeight)
			ELSE
				.nGDIPStatus = GdipFillRectangle(.nGDIPHandle, toBrush.GetHandle(), tvXOrRect, tnY, tnWidth, tnHeight)
			ENDIF
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE fillrectangles		&& Fill a series of rectangles defined by a 4-column array of coordinates
	ENDPROC

	PROCEDURE fillrectanglesfromcursor		&& Fill a series of rectangles defined by a cursor containing x,y,w,h values
	ENDPROC

	PROCEDURE flush		&& Force execution of all pending graphics operations
	ENDPROC

	PROCEDURE gethdc		&& Get handle to device context associated with this Graphics object.
		DECLARE INTEGER GdipGetDC IN gdiplus.DLL INTEGER, INTEGER @
		
		LOCAL lnHDC
		
		WITH THIS
		
			lnHDC = 0
		
			.nGDIPStatus = GdipGetDC(.nGDIPHandle, @lnHDC )
		
			IF .nGDIPStatus = cnGDIPLUS_STATUS_OK
				RETURN lnHDC
			ELSE
				RETURN -1
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE measurestringa		&& Measures ANSI text string when drawn with the specified Font and formatting
		LPARAMETERS tcAnsiString, toFont, tvLayoutArea, toStringFormat, trnCharsFitted, trnLinesFilled
		
		DECLARE INTEGER GdipMeasureString IN gdiplus.DLL INTEGER nGraphics,STRING cUnicode,INTEGER nLength ,INTEGER nFont,STRING cLayoutRect,INTEGER nStringFormat, STRING @cRectOut, INTEGER @nChars, INTEGER @nLines
		
		LOCAL lcRectF	&& layout rectangle
		LOCAL lcBoundingBox
		
		LOCAL lnCharsFitted
		LOCAL lnLinesFilled
		
		WITH THIS
		
			DO CASE
				CASE VARTYPE(tvLayoutArea)$'CQ' && String or varbinary
					DO CASE
						CASE LEN(tvLayoutArea)==8 && sizeF
							lcRectF = REPLICATE(CHR(0),8) + tvLayoutArea
		
						CASE LEN(tvLayoutArea)==16 && rect
							lcRectF = tvLayoutArea
		
						OTHERWISE
							lcRectF = REPLICATE(CHR(0),16)
		
					ENDCASE
		
				CASE VARTYPE(tvLayoutArea) == 'O'
					DO CASE
						CASE pemstatus(tvLayoutArea,'cgdipRectF',5)	&& Rect
							lcRectF = tvLayoutArea.cGdipRectF
		
						CASE pemstatus(tvLayoutArea,'cGdipSizeF',5)	&& Size
							lcRectF = REPLICATE(CHR(0),8) + tvLayoutArea.cGdipSizeF
		
						OTHERWISE
							THIS.ngdipStatus = cnGDIPLUS_STATUS_InvalidParameter
							RETURN NULL
					ENDCASE
		
				CASE VARTYPE(tvLayoutArea) == 'N'	&& Width only
					lcRectF = REPLICATE(CHR(0),8) + bintoc(tvLayoutArea) + REPLICATE(CHR(0),4)
				OTHERWISE
		*-- Not given
					lcRectF = REPLICATE(CHR(0),16)
			ENDCASE
		
			lcBoundingBox = REPLICATE(CHR(0),16) && empty rectangle
			lnCharsFitted = 0
			lnLinesFilled = 0
		
			.nGDIPStatus = GdipMeasureString( ;
				.nGDIPHandle ;
				, STRCONV(tcAnsiString,5)	;
				, LEN(tcAnsiString) ;
				, IIF(VARTYPE(toFont)='O',toFont.GetHandle(),0) ;
				, lcRectF ;
				, IIF(VARTYPE(toStringFormat) = 'O', toStringFormat.GetHandle(), 0) ;
				, @lcBoundingBox ;
				, @lnCharsFitted, @lnLinesFilled ;
				)
		
			IF .nGDIPStatus = cnGDIPLUS_STATUS_OK
		*-- Return result
				trnCharsFitted = lnCharsFitted
				trnLinesFilled = lnLinesFilled
		
		*-- Return size - the SECOND 8 bytes of the rectF structure
				RETURN NEWOBJECT(ccGDIPLUS_CLASS_SIZE, ccGDIPLUS_CLASS_LIBRARY, '', SUBSTR(lcBoundingBox,9) )
			ELSE
				RETURN NULL	&& Failed
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE measurestringw		&& Measures Unicode text string when drawn with the specified Font and formatting
		LPARAMETERS tcUnicodeString, toFont, tvLayoutArea, toStringFormat, trnCharsFitted, trnLinesFilled
		
		DECLARE INTEGER GdipMeasureString IN gdiplus.DLL INTEGER nGraphics,STRING cUnicode,INTEGER nLength,INTEGER nFont,STRING cLayoutRect,INTEGER nStringFormat, STRING @cRectOut, INTEGER @nChars, INTEGER @nLines
		
		LOCAL lcRectF	&& layout rectangle
		LOCAL lcBoundingBox
		LOCAL lnCharsFitted
		LOCAL lnLinesFilled
		
		WITH THIS
		
			DO CASE
				CASE VARTYPE(tvLayoutArea)$'CQ' && String or varbinary
					DO CASE
						CASE LEN(tvLayoutArea)==8 && sizeF
							lcRectF = REPLICATE(CHR(0),8) + tvLayoutArea
		
						CASE LEN(tvLayoutArea)==16 && rect
							lcRectF = tvLayoutArea
		
						OTHERWISE
							lcRectF = REPLICATE(CHR(0),16)
		
					ENDCASE
		
				CASE VARTYPE(tvLayoutArea) == 'O'
		*-- Assume GpiSize object
					lcRectF = REPLICATE(CHR(0),8) + tvLayoutArea.cGdipSizeF
		
				CASE VARTYPE(tvLayoutArea) == 'N'	&& Width only
					lcRectF = REPLICATE(CHR(0),8) + bintoc(tvLayoutArea)+ REPLICATE(CHR(0),4)
		
				OTHERWISE
		*-- Not given
					lcRectF = REPLICATE(CHR(0),16)
			ENDCASE
		
			lcBoundingBox = REPLICATE(CHR(0),16) && empty rectangle
			lnCharsFitted = 0
			lnLinesFilled = 0
		
			.ngdipStatus = GdipMeasureString( ;
				.ngdipHandle ;
				, tcUnicodeString ;
				, LEN(tcUnicodeString)/2 ;
				, IIF(VARTYPE(m.toFont)='O',toFont.GetHandle(),0) ;
				, lcRectF ;
				, IIF(VARTYPE(toStringFormat)='O',toStringFormat.GetHandle(),0) ;
				, @lcBoundingBox ;
				, @lnCharsFitted ;
				, @lnLinesFilled ;
				)
		
			IF .ngdipStatus == cnGDIPLUS_STATUS_OK
		*-- Return result
				trnCharsFitted = lnCharsFitted
				trnLinesFilled = lnLinesFilled
		
		*-- return size - the SECOND 8 bytes of the rectF structure
				RETURN NEWOBJECT(ccGDIPLUS_CLASS_SIZE, ccGDIPLUS_CLASS_LIBRARY, '',  SUBSTR(lcBoundingBox,9) )
			ELSE
				RETURN NULL	&& Failed
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE ndpix_access
		DECLARE INTEGER GdipGetDpiX IN gdiplus.DLL INTEGER nGraphics, SINGLE @ nDPI
		
		LOCAL lnDPI
		
		WITH THIS
		
			lnDPI = 0.0
		
			.nGDIPStatus = GdipGetDpiX(.nGDIPHandle, @lnDPI)
		
			RETURN IIF(.nGDIPStatus = cnGDIPLUS_STATUS_OK, lnDPI, 96)	
		
		ENDWITH
		
	ENDPROC

	PROCEDURE ndpix_assign
	ENDPROC

	PROCEDURE ndpiy_access
		DECLARE INTEGER GdipGetDpiY IN gdiplus.DLL INTEGER nGraphics, SINGLE @ nDPI
		
		LOCAL lnDPI
		
		WITH THIS
		
			lnDPI = 0.0
		
			.nGDIPStatus = GdipGetDpiY(.nGDIPHandle, @lnDPI)
		
			RETURN IIF(.nGDIPStatus = cnGDIPLUS_STATUS_OK, lnDPI, 96)	
		
		ENDWITH
		
	ENDPROC

	PROCEDURE ndpiy_assign
	ENDPROC

	PROCEDURE ninterpolationmode_access
	ENDPROC

	PROCEDURE ninterpolationmode_assign
	ENDPROC

	PROCEDURE npagescale_access
	ENDPROC

	PROCEDURE npagescale_assign
	ENDPROC

	PROCEDURE releasehdc		&& Release device context previously obtained with GetHdc()
		LPARAMETERS tnHDC
		
		DECLARE INTEGER GdipReleaseDC IN gdiplus.DLL INTEGER, INTEGER
		
		THIS.nGDIPStatus = GdipReleaseDC( THIS.nGDIPHandle, tnHDC )
		
		RETURN THIS.nGDIPStatus == cnGDIPLUS_STATUS_OK
		
	ENDPROC

	PROCEDURE resettransform		&& Reset the world transform matrix (to no transformation)
	ENDPROC

	PROCEDURE restore		&& Restore previously saved state
		LPARAMETERS tnGraphicsState
		
		DECLARE INTEGER GdipRestoreGraphics IN gdiplus.DLL INTEGER, INTEGER
		
		WITH THIS
		
			.nGDIPStatus = GdipRestoreGraphics(.nGDIPHandle, tnGraphicsState)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE rotatetransform		&& Prepend rotation by specified angle to this object's transformation matrix
		LPARAMETERS tnAngle, tnMatrixOrder
		
		DECLARE INTEGER GdipRotateWorldTransform IN gdiplus.DLL INTEGER nGraphics, SINGLE nAngle, INTEGER nMatrixOrder
		
		WITH THIS
		
			.nGDIPStatus = GdipRotateWorldTransform(.nGDIPHandle, tnAngle, IIF(EMPTY(tnMatrixOrder), cnGDIPLUS_MatrixOrder_Prepend, tnMatrixOrder))
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE save		&& Save current state and return token (for later restore)
		LPARAMETERS trnGraphicsState
		
		DECLARE INTEGER GdipSaveGraphics IN gdiplus.DLL INTEGER, INTEGER @
		
		LOCAL lnState
		
		WITH THIS
		
			lnState = 0
		
			.nGDIPStatus = GdipSaveGraphics(.nGDIPHandle, @lnState )
		
			IF .nGDIPStatus = cnGDIPLUS_STATUS_OK
				trnGraphicsState = lnState
		
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE scaletransform		&& Apply scaling to transformation matrix for this graphics object
	ENDPROC

	PROCEDURE translatetransform		&& Add translate by (x,y) to this graphics object's transformation matrix
		LPARAMETERS tnOffsetX, tnOffsetY, tnMatrixOrder
		
		*-- Now move the 0,0 point to where we'd like it to be, so that when we rotate we're rotating around the appropriate point
		
		DECLARE INTEGER GdipTranslateWorldTransform IN gdiplus.DLL INTEGER nGraphics, SINGLE nOffsetX, SINGLE nOffsetY, INTEGER nMatrixOrder
		
		WITH THIS
		
			.nGDIPStatus = GDIPTranslateWorldTransform(.nGDIPHandle, tnOffsetX, tnOffsetY, IIF(EMPTY(tnMatrixOrder), cnGDIPLUS_MatrixOrder_Prepend, tnMatrixOrder))
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
		
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS gdihatchbrush AS gdibrush OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: nbackgroundcolor_access
		*m: nbackgroundcolor_assign
		*m: nforegroundcolor_access
		*m: nforegroundcolor_assign
		*m: nhatchstyle_access
		*m: nhatchstyle_assign
		*p: nbackgroundcolor		&& Color of space between hatch lines
		*p: nforegroundcolor		&& Color of hatch lines
		*p: nhatchstyle		&& Hatch style of this brush object
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdihatchbrush"
	*</PropValue>
	
	PROCEDURE create
		LPARAMETERS tnStyle, tvForeColor, tvBackColor
		*-- tnStyle must be HatchStyle constant
		
		DECLARE INTEGER GdipCreateHatchBrush IN GDIPlus.DLL INTEGER nHatchStyle, INTEGER nForeColor, INTEGER nBackColor, INTEGER @nBrush
		
		LOCAL lnHandle
		
		WITH THIS
		
			lnHandle = 0
		
			THIS.DESTROY()
		
			THIS.nGDIPStatus = GdipCreateHatchBrush( ;
				tnStyle, ;
				IIF(VARTYPE(tvForeColor)='O', tvForeColor.nARGB, IIF(VARTYPE(tvForeColor)='N', tvForeColor, 0xFF000000)), ;
				IIF(VARTYPE(tvBackColor)='O', tvBackColor.nARGB, IIF(VARTYPE(tvBackColor)='N', tvBackColor, 0xFFFFFFFF)), ;
				@lnHandle)
		
			THIS.SetHandle(lnHandle, .T.)
		
			RETURN THIS.nGDIPStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tnStyle, tvForeColor, tvBackColor
		
		IF pcount()>0
			RETURN THIS.CREATE(tnStyle, tvForeColor, tvBackColor)
		ENDIF
		
	ENDPROC

	PROCEDURE nbackgroundcolor_access
	ENDPROC

	PROCEDURE nbackgroundcolor_assign
	ENDPROC

	PROCEDURE nforegroundcolor_access
	ENDPROC

	PROCEDURE nforegroundcolor_assign
	ENDPROC

	PROCEDURE nhatchstyle_access
	ENDPROC

	PROCEDURE nhatchstyle_assign
	ENDPROC

ENDDEFINE

DEFINE CLASS gdiimage AS gdiobject OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: addtomultipagetifffile
		*m: clonefromgdibitmap1
		*m: clonefromgdibitmap2
		*m: createfromfile		&& Create Image object from a file on disk
		*m: createfromhandle
		*m: disposeimageattributes
		*m: getbounds		&& Get a bounding rectangle in the specified units
		*m: gethbitmap
		*m: makecolormatrix
		*m: nflags_access
		*m: nflags_assign
		*m: nimageheight_access
		*m: nimageheight_assign
		*m: nimagetype_access
		*m: nimagetype_assign
		*m: nimagewidth_access
		*m: nimagewidth_assign
		*m: nrawformat_access
		*m: nrawformat_assign
		*m: savetofile
		*m: savetomultipagetifffile
		*m: setcolormatrix
		*m: setpredefcolormatrix
		*m: stringtoclsid
		*p: nflags		&& Attribute flags for this image
		*p: nimageattributes
		*p: nimageheight		&& Height of this image
		*p: nimagetype
		*p: nimagewidth		&& Width of this image
		*p: nrawformat		&& Get the format of this image (as a GUID)
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdiimage"
		nflags = 0
		nimageattributes = 0
		nimageheight = 0
		nimagetype = 0
		nimagewidth = 0
		nrawformat = 0
	*</PropValue>
	
	PROCEDURE addtomultipagetifffile
		LPARAMETERS tnGDIPHandle
		
		DECLARE LONG GdipSaveAddImage IN GDIPLUS.DLL LONG GpImage, LONG newImage, STRING @encoderParams
		
		
		LOCAL loEncoderParameter
		
		LOCAL lcEncoderParameters
		
		LOCAL lnParameterCount
		
		LOCAL llReturn
		
		WITH THIS
		
			loEncoderParameter = NEWOBJECT(ccGDIPLUS_CLASS_ENCODERPARAMETER, ccGDIPLUS_CLASS_LIBRARY, '', .StringToCLSID(cnGUID_SaveFlag), cnEncoderValueFrameDimensionPage)
		
			lcEncoderParameters = loEncoderParameter.cEncoderParameter
		
			lnParameterCount = 1
		
			lcEncoderParameters = .Num2DWord(lnParameterCount) + lcEncoderParameters
		
			.nGDIPStatus = GdipSaveAddImage(.nGDIPHandle, tnGDIPHandle, @lcEncoderParameters)
		
			llReturn = IIF(.nGDIPStatus = cnGDIPLUS_STATUS_OK, .T., .F.)
		
		ENDWITH
		
		RETURN llReturn
		
		
		
		
	ENDPROC

	PROCEDURE clonefromgdibitmap1
		LPARAMETERS tnSrcHBitmap, tlOwnsHandle
		
		
		DECLARE INTEGER GdipCreateBitmapFromHBITMAP IN GDIPLUS INTEGER hbm, INTEGER hpal, INTEGER @hbitmap
		
		LOCAL lnDstHImage
		
		WITH THIS
		
			IF tnSrcHBitmap <> 0
		
				lnDstHImage = 0
		
				.nGDIPStatus  = GdipCreateBitmapFromHBITMAP(tnSrcHBitmap, 0, @lnDstHImage)
		
				IF .nGDIPStatus = cnGDIPLUS_STATUS_OK
					RETURN .CreateFromHandle(lnDstHImage, tlOwnsHandle)
					
				ENDIF
			ENDIF
		
			RETURN .F.
		
		ENDWITH
		
	ENDPROC

	PROCEDURE clonefromgdibitmap2
	ENDPROC

	PROCEDURE createfromfile		&& Create Image object from a file on disk
		LPARAMETERS tcFilename, tlUseEmbeddedColorMgmt
		
		DECLARE INTEGER GdipLoadImageFromFileICM IN gdiplus.DLL STRING wFilename, INTEGER @ nImage
		DECLARE INTEGER GdipLoadImageFromFile IN gdiplus.DLL STRING wFilename, INTEGER @ nImage
		
		
		LOCAL lnHandle
		
		WITH THIS
		
			.DESTROY()
		
			lnHandle = 0
		
			IF tlUseEmbeddedColorMgmt
		
				.nGDIPStatus = GdipLoadImageFromFileICM(STRCONV(tcFilename + CHR(0), 5), @lnHandle)
		
			ELSE
		
				.nGDIPStatus = GdipLoadImageFromFile(STRCONV(tcFilename + CHR(0), 5), @lnHandle)
		
			ENDIF
		
			.SetHandle(lnHandle, .T.)
			
		
			RETURN .nGDIPStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
		
		
		
		
	ENDPROC

	PROCEDURE createfromhandle
		LPARAMETERS tvNewHandle, tlOwnsHandle
		
		WITH THIS
		
			.SetHandle(tvNewHandle, tlOwnsHandle)
		
		ENDWITH
		
		
		
		
	ENDPROC

	PROCEDURE Destroy
		WITH THIS
		
			IF .nGDIPHandle # 0 AND .lGDIPOwnsThisHandle
				DECLARE INTEGER GdipDisposeImage IN GDIPlus.DLL INTEGER nImage
		
				GdipDisposeImage(.nGdipHandle)
		
			ENDIF
		
			.nGDIPHandle         = 0
			.lGDIPOwnsThisHandle = .F.
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE disposeimageattributes
		DECLARE INTEGER GdipDisposeImageAttributes IN GdiPlus.dll INTEGER imageattr
		
		WITH THIS
		
			.nGDIPStatus = GdipDisposeImageAttributes(tnImgAttributes)
		
			.nImageAttributes = 0
		
		
			RETURN .nGDIPStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE getbounds		&& Get a bounding rectangle in the specified units
	ENDPROC

	PROCEDURE gethbitmap
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tvParam1, tvParam2, tvParam3, tvParam4, tvParam5, tvParam6
		
		WITH THIS
			DO CASE
				CASE VARTYPE(tvParam1) = 'N'
		*-- Handle
					RETURN .CreateFromHandle(tvParam1, tvParam2)
		
				CASE VARTYPE(tvParam1) = 'C'
		*-- Filename, no second param
					RETURN .CreateFromFile(tvParam1, tvParam2)
		
				CASE VARTYPE(tvParam1) = 'L'
		*-- Do nothing
		
				OTHERWISE
					.nGDIPStatus = cnGDIPLUS_STATUS_InvalidParameter
		
					RETURN .F.
			ENDCASE
		
			RETURN .T.
		
		ENDWITH
		
	ENDPROC

	PROCEDURE makecolormatrix
		LPARAMETERS taColMatrix
		
		EXTERNAL ARRAY taColMatrix
		
		LOCAL lcColorMatrix
		
		LOCAL lnRow
		LOCAL lnCol
		
		lcColorMatrix = ''
		
		FOR lnRow = 1 TO 5
			FOR lnCol = 1 TO 5
				lcColorMatrix = lcColorMatrix + .Num2DWord(.Int2Float(taColMatrix(lnRow, lnCol)))
			ENDFOR
		ENDFOR
		
		RETURN lcColorMatrix
		
		
		
		
	ENDPROC

	PROCEDURE nflags_access
		DECLARE INTEGER GdipGetImageFlags IN gdiplus.DLL INTEGER nImage, INTEGER @ nValue
		
		LOCAL lnValue
		
		lnValue = 0
		
		THIS.nGDIPStatus = GdipGetImageFlags( THIS.nGDIPHandle, @lnValue)
		
		RETURN IIF(THIS.nGDIPStatus == cnGDIPLUS_STATUS_OK, lnValue, 0)
		
	ENDPROC

	PROCEDURE nflags_assign
		LPARAMETERS tnFlags
		
		THIS.nFlags = tnFlags
		
	ENDPROC

	PROCEDURE nimageheight_access
		DECLARE INTEGER GdipGetImageHeight IN gdiplus.DLL INTEGER nImage, INTEGER @ nValue
		
		LOCAL lnValue
		
		lnValue = 0
		
		THIS.nGDIPStatus = GdipGetImageHeight( THIS.nGDIPHandle, @lnValue)
		
		RETURN IIF(THIS.nGDIPStatus = cnGDIPLUS_STATUS_OK, lnValue, 0)
		
	ENDPROC

	PROCEDURE nimageheight_assign
		LPARAMETERS vNewVal
		THIS.nImageHeight = m.vNewVal
		
	ENDPROC

	PROCEDURE nimagetype_access
		DECLARE INTEGER GdipGetImageType IN gdiplus	INTEGER img, INTEGER @imgtype
		
		LOCAL lnValue
		
		lnValue = 0
		
		THIS.nGDIPStatus = GdipGetImageType(.nGDIPHandle, @lnValue)
		
		RETURN IIF(THIS.nGDIPStatus = cnGDIPLUS_STATUS_OK, lnValue, 0)
		
	ENDPROC

	PROCEDURE nimagetype_assign
	ENDPROC

	PROCEDURE nimagewidth_access
		DECLARE INTEGER GdipGetImageWidth IN gdiplus.DLL INTEGER nPen, INTEGER @ nValue
		
		LOCAL lnValue
		
		lnValue = 0
		
		THIS.nGDIPStatus = GdipGetImageWidth( THIS.nGDIPHandle, @lnValue)
		
		RETURN IIF(THIS.nGDIPStatus = cnGDIPLUS_STATUS_OK, lnValue, 0)
		
	ENDPROC

	PROCEDURE nimagewidth_assign
		LPARAMETERS tnImageWidth
		
		THIS.nImageWidth = tnImageWidth
		
	ENDPROC

	PROCEDURE nrawformat_access
		DECLARE INTEGER GdipGetImageRawFormat IN gdiplus.DLL INTEGER nImage, STRING @ sGUID
		
		LOCAL lsGUID
		
		lsGUID = REPLICATE(CHR(0),16)
		
		THIS.nGDIPStatus = GdipGetImageRawFormat( THIS.nGDIPHandle, @lsGUID)
		
		RETURN IIF(THIS.nGDIPStatus = cnGDIPLUS_STATUS_OK, lsGUID, '')
		
	ENDPROC

	PROCEDURE nrawformat_assign
	ENDPROC

	PROCEDURE savetofile
		LPARAMETERS tcFileName
		
		DECLARE INTEGER GdipSaveImageToFile IN GDIPLUS.DLL INTEGER nImage, STRING wFilename, STRING qEncoder, INTEGER nEncoderParamsPtr
		
		LOCAL lcFileType
		LOCAL lcEncoder
		
		LOCAL llReturn
		
		WITH THIS
		
			lcFileType = UPPER(JUSTEXT(tcFileName))
		
			DO CASE
				CASE lcFileType == "BMP"
					lcEncoder = .StringToCLSID(ccEncoder_Bitmap)
		
				CASE lcFileType == "JPG" OR lcFileType == "JPEG"
					lcEncoder = .StringToCLSID(ccEncoder_Jpeg)
		
				CASE lcFileType == "GIF"
					lcEncoder = .StringToCLSID(ccEncoder_Gif)
		
				CASE lcFileType == "TIF" OR lcFileType == "TIFF"
					lcEncoder = .StringToCLSID(ccEncoder_Tiff)
		
				CASE lcFileType == "PNG"
					lcEncoder = .StringToCLSID(ccEncoder_Png)
		
				OTHERWISE
					lcEncoder = .StringToCLSID(ccEncoder_Jpeg)
		
			ENDCASE
		
			.nGDIPStatus = GdipSaveImageToFile(.nGDIPHandle, STRCONV(tcFileName,5) + CHR(0), lcEncoder, 0)
		
			llReturn = IIF(.nGDIPStatus = cnGDIPLUS_STATUS_OK, .T., .F.)
		
		ENDWITH
		
		RETURN llReturn
		
		
	ENDPROC

	PROCEDURE savetomultipagetifffile
		LPARAMETERS tcFileName, tnCompress, tnColorDepth
		
		DECLARE LONG GdipSaveImageToFile IN GDIPLUS.DLL LONG GpImage, STRING FileName, STRING @ encoderClsid, STRING @ encoderParams
		
		LOCAL loEncoderParameter
		
		LOCAL lcEncoder
		LOCAL lcSaveFlag
		LOCAL lcCompress
		LOCAL lcColorDepth
		LOCAL lcEncoderParameters
		
		LOCAL lnParameterCount
		
		LOCAL llReturn
		
		WITH THIS
		
			lcEncoder  = .StringToCLSID(ccEncoder_Tiff)
			
			lcSaveFlag = .StringToCLSID(cnGUID_SaveFlag)
		
			loEncoderParameter = NEWOBJECT(ccGDIPLUS_CLASS_ENCODERPARAMETER, ccGDIPLUS_CLASS_LIBRARY, '', lcSaveFlag, cnEncoderValueMultiFrame)
		
			lcEncoderParameters = loEncoderParameter.cEncoderParameter
			lnParameterCount = 1
		
			IF VARTYPE(tnCompress) = 'N'
		
				lcCompress = .StringToCLSID(cnGUID_Compress)
		
				loEncoderParameter = NEWOBJECT(ccGDIPLUS_CLASS_ENCODERPARAMETER, ccGDIPLUS_CLASS_LIBRARY, '', lcCompress, tnCompress)
		
				lcEncoderParameters = lcEncoderParameters + loEncoderParameter.cEncoderParameter
		
				lnParameterCount = lnParameterCount + 1
				
			ENDIF
		
			IF VARTYPE(tnColorDepth) = 'N'
		
				lcColorDepth = .StringToCLSID(cnGUID_ColorDepth)
		
				loEncoderParameter = NEWOBJECT(ccGDIPLUS_CLASS_ENCODERPARAMETER, ccGDIPLUS_CLASS_LIBRARY, '', lcColorDepth, tnColorDepth)
		
				lcEncoderParameters = lcEncoderParameters + loEncoderParameter.cEncoderParameter
		
				lnParameterCount = lnParameterCount + 1
		
			ENDIF
		
			lcEncoderParameters = .Num2DWord(lnParameterCount) + lcEncoderParameters
		
			.nGDIPStatus = GdipSaveImageToFile(.nGDIPHandle, STRCONV(tcFileName,5) + CHR(0), @lcEncoder, @lcEncoderParameters)
		
			llReturn = IIF(.nGDIPStatus = cnGDIPLUS_STATUS_OK, .T., .F.)
		
		
		ENDWITH
		
		RETURN llReturn
		
	ENDPROC

	PROCEDURE setcolormatrix
		LPARAMETERS taColMatrix
		
		DECLARE INTEGER GdipCreateImageAttributes IN gdiplus.dll INTEGER @ImageAttributes
		DECLARE INTEGER GdipSetImageAttributesColorMatrix IN gdiplus.dll INTEGER ImageAttributes, INTEGER ColorAdjustType, INTEGER enableFlag, STRING  colorMatrix, INTEGER grayMatrix, INTEGER ColorMatrixFlags
		
		
		LOCAL lcColorMatrix
		
		LOCAL lnImageAttributes
		
		WITH THIS 
		
			lcColorMatrix = .MakeColorMatrix(@taColMatrix)
		
			IF .nImageAttributes # 0
				.DisposeImageAttributes()
			ENDIF
			
			lnImageAttributes = 0
			
			.nGDIPStatus = GdipCreateImageAttributes(@lnImageAttributes)
			
			.nImageAttributes = lnImageAttributes
		
			.nGDIPStatus = GdipSetImageAttributesColorMatrix(lnImageAttributes, 0, 1, lcColorMatrix, 0, 0)
				
			
			RETURN .nGDIPStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE setpredefcolormatrix
		LPARAMETERS tnRed, tnGreen, tnBlue, tnAlpha
		
		LOCAL laBW
		LOCAL laNEGATIVE
		LOCAL laCUSTOM
		
		LOCAL lnR 
		LOCAL lnG 
		LOCAL lnB 
		LOCAL lnA 
		
		WITH THIS
		
			IF PCOUNT() = 1
		*-- Predefined
		
				IF tnRed = 1 
		*-- BLACK AND WHITE IMAGE
					DIMENSION laBW(5,5)
		
					laBW(1,1) = 0.299
					laBW(1,2) = 0.299
					laBW(1,3) = 0.299
					laBW(1,4) = 0
					laBW(1,5) = 0
		
					laBW(2,1) = 0.587
					laBW(2,2) = 0.587
					laBW(2,3) = 0.587
					laBW(2,4) = 0
					laBW(2,5) = 0
		
					laBW(3,1) = 0.114
					laBW(3,2) = 0.114
					laBW(3,3) = 0.114
					laBW(3,4) = 0
					laBW(3,5) = 0
		
					laBW(4,1) = 0
					laBW(4,2) = 0
					laBW(4,3) = 0
					laBW(4,4) = 1
					laBW(4,5) = 0
		
					laBW(5,1) = 0
					laBW(5,2) = 0
					laBW(5,3) = 0
					laBW(5,4) = 0
					laBW(5,5) = 1
					
					.SetColorMatrix(@laBW)
					
				ENDIF
		
				IF tnRed = 2 
		*-- NEGATIVE IMAGE
					DIMENSION laNEGATIVE(5,5)
					
					laNEGATIVE(1,1) = -1
					laNEGATIVE(1,2) = 0
					laNEGATIVE(1,3) = 0
					laNEGATIVE(1,4) = 0
					laNEGATIVE(1,5) = 0
		
					laNEGATIVE(2,1) = 0
					laNEGATIVE(2,2) = -1
					laNEGATIVE(2,3) = 0
					laNEGATIVE(2,4) = 0
					laNEGATIVE(2,5) = 0
		
					laNEGATIVE(3,1) = 0
					laNEGATIVE(3,2) = 0
					laNEGATIVE(3,3) = -1
					laNEGATIVE(3,4) = 0
					laNEGATIVE(3,5) = 0
		
					laNEGATIVE(4,1) = 0
					laNEGATIVE(4,2) = 0
					laNEGATIVE(4,3) = 0
					laNEGATIVE(4,4) = 1
					laNEGATIVE(4,5) = 0
		
					laNEGATIVE(5,1) = 0
					laNEGATIVE(5,2) = 0
					laNEGATIVE(5,3) = 0
					laNEGATIVE(5,4) = 0
					laNEGATIVE(5,5) = 1
					
					.SetColorMatrix(@laNEGATIVE)
					
				ENDIF
		
			ELSE
		
		*-- CHANGE COLORS
				lnR = tnRed / 100
				lnG = tnGreen / 100
				lnB = tnBlue / 100
				lnA = tnAlpha / 100
		
		*-- Create the color matrix
				DIMENSION laCUSTOM(5,5)
				
				laCUSTOM(1,1) = 1
				laCUSTOM(1,2) = 0
				laCUSTOM(1,3) = 0
				laCUSTOM(1,4) = 0
				laCUSTOM(1,5) = 0
		
				laCUSTOM(2,1) = 0
				laCUSTOM(2,2) = 1
				laCUSTOM(2,3) = 0
				laCUSTOM(2,4) = 0
				laCUSTOM(2,5) = 0
		
				laCUSTOM(3,1) = 0
				laCUSTOM(3,2) = 0
				laCUSTOM(3,3) = 1
				laCUSTOM(3,4) = 0
				laCUSTOM(3,5) = 0
		
				laCUSTOM(4,1) = 0
				laCUSTOM(4,2) = 0
				laCUSTOM(4,3) = 0
				laCUSTOM(4,4) = 1
				laCUSTOM(4,5) = 0
		
				laCUSTOM(5,1) = lnR
				laCUSTOM(5,2) = lnG
				laCUSTOM(5,3) = lnB
				laCUSTOM(5,4) = lnA
				laCUSTOM(5,5) = 1
				
				.SetColorMatrix(@laCUSTOM)
				
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE stringtoclsid
		LPARAMETERS  tcString
		
		DECLARE INTEGER CLSIDFromString IN ole32 STRING lpsz, STRING @pclsid
		
		LOCAL lcBuffer
		
		lcBuffer=REPLICATE(CHR(0),16)
		
		=CLSIDFromString(STRCONV(tcString + CHR(0), 5), @lcBuffer)
		
		RETURN lcBuffer
		
	ENDPROC

ENDDEFINE

DEFINE CLASS gdilineargradientbrush AS gdibrush OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<PropValue>
		Name = "gdilineargradientbrush"
		ntype = 4
	*</PropValue>
	
	PROCEDURE create
		LPARAMETER tcRect, tvColor1, tvColor2, tnDirection
		
		DECLARE LONG GdipCreateLineBrushFromRect IN gdiplus.DLL STRING RECT, LONG color1, LONG color2, LONG mode, LONG wrapMode, LONG @lineGradient
		
		LOCAL lnHandle
		
		WITH THIS
		
			.DESTROY()
		
			lnHandle = 0
		
			.nGDIPStatus = GdipCreateLineBrushFromRect(tcRect, IIF(VARTYPE(tvColor1)='O', tvColor1.nARGB, IIF(VARTYPE(tvColor1)='N', tvColor1, 0xFF000000)), IIF(VARTYPE(tvColor2)='O', tvColor2.nARGB, IIF(VARTYPE(tvColor2)='N', tvColor2, 0xFF000000)), tnDirection, 0, @lnHandle)
		
			.SetHandle(lnHandle, .T.)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE Init
		LPARAMETER toRect, tvColor1, tvColor2, tnDirection, tnAlpha, tlARGB
		
		*-- The LinearGradientBrush class defines a brush that paints a color gradient in which the
		*-- color changes evenly from the starting boundary line of the linear gradient brush to
		*-- the ending boundary line of the linear gradient brush.
		
		LOCAL lcRect
		
		WITH THIS
		
			DO CASE
				CASE Pcount() = 5
		
					IF VARTYPE(toRect) = 'O'
						DO CASE
							CASE pemstatus(toRect, 'cGDIPRectF', 5)	&& Rect
								lcRect = toRect.cGDIPRectF
		
							OTHERWISE
								.nGDIPStatus = cnGDIPLUS_STATUS_InvalidParameter
		
								RETURN .F.
						ENDCASE
		
					ENDIF
		
					IF VARTYPE(tvColor1) $ 'NFIBY' &&AND !tlARGB
						tvColor1 = .FoxRGB2ARGB(tvColor1, tnAlpha)
					ENDIF
		
					IF VARTYPE(tvColor2) $ 'NFIBY' &&AND !tlARGB
						tvColor2 = .FoxRGB2ARGB(tvColor2, tnAlpha)
					ENDIF
		
		
					IF !INLIST(tnDirection, cnGDIPLUS_LinearGradientMode_Horizontal, cnGDIPLUS_LinearGradientMode_Vertical, cnGDIPLUS_LinearGradientMode_ForwardDiagonal, cnGDIPLUS_LinearGradientMode_BackwardDiagonal)
						tnDirection = cnGDIPLUS_LinearGradientMode_Horizontal
					ENDIF
		
					RETURN .CREATE(lcRect, tvColor1, tvColor2, tnDirection)
		
			ENDCASE
		
		ENDWITH
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS gdiobject AS gdiplus OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: gethandle		&& Return the underlying GDI+ handle for this object
		*m: getstatus		&& Return the status code from the last GDI+ function called on this object
		*m: ngdipstatus_assign
		*m: sethandle		&& Set the native GDI+ handle if this has been obtained from an outside source
		*p: lgdipownsthishandle		&& True if this VFP object owns the corresponding GDI+ object (and thus should dispose of it in its Destroy Event)
		*p: ngdiphandle		&& Underlying GDI+ handle for this object
		*p: ngdipstatus		&& Status code returned from last GDI+ function called (see Status enumeration)
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdiobject"
		ngdiphandle = 0
		ngdipstatus = 0
	*</PropValue>
	
	PROCEDURE gethandle		&& Return the underlying GDI+ handle for this object
		RETURN THIS.nGDIPHandle
		
	ENDPROC

	PROCEDURE getstatus		&& Return the status code from the last GDI+ function called on this object
		RETURN THIS.nGDIPStatus
		
	ENDPROC

	PROCEDURE ngdipstatus_assign
		LPARAMETERS tnGDIPStatus
		
		THIS.nGDIPStatus = tnGDIPStatus
		
		DO CASE
			CASE tnGDIPStatus = cnGDIPLUS_STATUS_GdiplusNotInitialized
				ERROR  cnGDIPLUS_GDIPLUSNOTINIT_LOC
		ENDCASE
		
	ENDPROC

	PROCEDURE sethandle		&& Set the native GDI+ handle if this has been obtained from an outside source
		LPARAMETERS tvNewHandle, tlOwnsHandle
		
		*-- Assume if we came through this function that we do NOT own the graphics handle
		*-- Thus destroy must not call GdipDelete..() on this handle
		*-- This can be overridden by passing tlOwnsHandle=.T.
		WITH THIS
			.nGDIPHandle = tvNewHandle
			.lGDIPOwnsThisHandle = tlOwnsHandle
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS gdipath AS gdiobject OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: addcurve
		*m: addellipse
		*m: addline		&& Adds a line to the current figure of this path
		*m: addlines
		*m: closefigure
		*m: create
		*m: startfigure
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdipath"
	*</PropValue>
	
	PROCEDURE addcurve
		LPARAMETERS toraphics, taPoints, tnSmoothTension
		
		DECLARE INTEGER GdipAddPathCurve2 IN gdiplus.DLL INTEGER nGraphics, STRING cPoints, INTEGER nCount, SINGLE nTension
		
		EXTERNAL ARRAY taPoints
		
		LOCAL lcPoints
		
		WITH THIS
		
			lcPoints = .MakeGdipArrayF(@taPoints)
		
			.nGDIPStatus = GdipAddPathCurve2(.GetHandle(), lcPoints, LEN(lcPoints)/8, tnSmoothTension)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
		
		
		
	ENDPROC

	PROCEDURE addellipse
		LPARAMETERS tnX, tnY, tnWidth, tnHeight
		*-- The AddEllipse method adds an Ellipse to the current figure of this path.
		
		DECLARE LONG GdipAddPathEllipse IN gdiplus.DLL	LONG PATH, SINGLE x, SINGLE y, SINGLE width, SINGLE height
		
		WITH THIS
			.nGDIPStatus = GdipAddPathEllipse(.GetHandle(), tnX, tnY, tnWidth, tnHeight)	
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE addline		&& Adds a line to the current figure of this path
		LPARAMETERS tnFirstX, tnFirstY, tnSecondX, tnSecondY
		*-- The AddLine method adds a line to the current figure of this path.
		
		DECLARE LONG GdipAddPathLine IN gdiplus.DLL	LONG PATH, SINGLE x1, SINGLE y1, SINGLE x2, SINGLE y2
		
		WITH THIS
			.nGDIPStatus = GdipAddPathLine(.GetHandle(), tnFirstX, tnFirstY, tnSecondX, tnSecondY)	
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE addlines
	ENDPROC

	PROCEDURE closefigure
		*-- The CloseFigure method closes the current figure of this path.
		
		DECLARE LONG GdipClosePathFigure IN gdiplus.DLL LONG PATH
		
		WITH THIS
			.nGDIPStatus = GdipClosePathFigure(.GetHandle())
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE create
		LPARAMETERS tnFillMode
		
		DECLARE LONG GdipCreatePath IN gdiplus.DLL LONG brushMode, LONG @PATH
		
		LOCAL lnHandle
		
		WITH THIS
		
			.DESTROY()
		
			lnHandle = 0
		
			.nGDIPStatus = GdipCreatePath(tnFillMode, @lnHandle)
		
			.SetHandle(lnHandle, .T.)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE Init
		LPARAMETER tnFillMode
		
		*-- A GraphicsPath object stores a sequence of lines, curves, and shapes. You can draw the
		*-- entire sequence by calling the DrawPath method of a Graphics object.
		*-- Creates a GraphicsPath object and initializes the fill mode.
		
		LOCAL lnFillMode
		
		WITH THIS
		
			IF VARTYPE(tnFillMode) = 'N' AND INLIST(tnFillMode, cnGDIPLUS_FillMode_Alternate, cnGDIPLUS_FillMode_Winding)
				lnFillMode = tnFillMode
			ELSE
				lnFillMode = cnGDIPLUS_FillMode_Alternate
			ENDIF
		
			.CREATE(lnFillMode)
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE startfigure
		*-- The StartFigure method starts a new figure without closing the current figure.
		*-- Subsequent points added to this path are added to the new figure.
		
		DECLARE LONG GdipStartPathFigure IN gdiplus.DLL LONG PATH
		
		WITH THIS
			.nGDIPStatus = GdipStartPathFigure(.GetHandle())
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS gdipen AS gdiobject OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: create
		*m: createfrombrush		&& Create pen from an existing  gdiplus brush object
		*m: nalignment_access
		*m: nalignment_assign
		*m: ndashstyle_access
		*m: ndashstyle_assign
		*m: npencolor_access
		*m: npencolor_assign
		*m: npentype_access
		*m: npentype_assign
		*m: npenunit_access
		*m: npenunit_assign
		*m: npenwidth_access
		*m: npenwidth_assign
		*p: nalignment		&& The alignment of this pen
		*p: ndashstyle		&& The style used for dashed lines
		*p: npencolor		&& The color of this Pen object.
		*p: npentype		&& The style of lines drawn with this Pen object
		*p: npenunit		&& The unit for measuring width etc,
		*p: npenwidth		&& Width of the pen object
	*</DefinedPropArrayMethod>

	*<PropValue>
		nalignment = 0
		Name = "gdipen"
		ndashstyle = 0
		npencolor = 0
		npentype = 0
		npenunit = 0
		npenwidth = 0
	*</PropValue>
	
	PROCEDURE create
		LPARAMETERS tvColor, tnWidth, tnDashStyle, tnUnit
		*-- tvColor may be ARGB or a Color object
		
		DECLARE INTEGER GdipCreatePen1 IN GDIPlus.DLL INTEGER nColor, SINGLE fWidth,INTEGER nUnit, INTEGER @nPen
		
		WITH THIS
		
			.DESTROY()
		
			LOCAL lnHandle
		
			lnHandle = 0
		
			.nGDIPStatus = GdipCreatePen1(;
				IIF(VARTYPE(tvColor)='O', tvColor.nARGB, IIF(VARTYPE(tvColor) = 'N', tvColor, 0xFF000000)) ;
				,IIF(VARTYPE(tnWidth)='N', tnWidth, 1.0) ;
				,IIF(VARTYPE(tnUnit)='N', tnUnit,0) ;
				,@lnHandle)
		
			.SetHandle(lnHandle, .T.)
		
			.nDashStyle = tnDashStyle
		
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE createfrombrush		&& Create pen from an existing  gdiplus brush object
	ENDPROC

	PROCEDURE Destroy
		WITH THIS
		
			IF .nGdipHandle # 0 AND .lgdipOwnsThisHandle
				DECLARE INTEGER GdipDeletePen IN GDIPlus.DLL INTEGER nPen
		
				GdipDeletePen(.nGdipHandle)
		
			ENDIF
		
			.nGdipHandle		 = 0
			.lgdipOwnsThisHandle = .F.
		
		ENDWITH
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tvColor, tnWidth, tnDashStyle, tnUnit, tlARGB
		
		WITH THIS
		
			IF pcount()>0
		
				IF VARTYPE(tvColor) $ 'NFIBY' AND !tlARGB
					tvColor = .FoxRGB2ARGB(tvColor)
				ENDIF
		
				RETURN .CREATE(tvColor, tnWidth, tnDashStyle, tnUnit)
			ENDIF
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE nalignment_access
	ENDPROC

	PROCEDURE nalignment_assign
	ENDPROC

	PROCEDURE ndashstyle_access
	ENDPROC

	PROCEDURE ndashstyle_assign
		LPARAMETERS tnDashStyle
		
		DECLARE INTEGER GdipSetPenDashStyle IN gdiplus.DLL INTEGER nPen, INTEGER nValue
		
		WITH THIS
			.nGDIPStatus = GdipSetPenDashStyle(.nGDIPHandle, tnDashStyle)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE npencolor_access
	ENDPROC

	PROCEDURE npencolor_assign
	ENDPROC

	PROCEDURE npentype_access
	ENDPROC

	PROCEDURE npentype_assign
	ENDPROC

	PROCEDURE npenunit_access
	ENDPROC

	PROCEDURE npenunit_assign
	ENDPROC

	PROCEDURE npenwidth_access
		DECLARE INTEGER GdipGetPenWidth IN gdiplus.DLL INTEGER nPen, SINGLE @ fWidth
		
		LOCAL lnWidth
		
		
		WITH THIS
			lnWidth = 0
		
			.nGDIPStatus = GdipGetPenWidth(.nGDIPHandle, @lnWidth)
		
			RETURN IIF(.nGDIPStatus = cnGDIPLUS_STATUS_OK, lnWidth, 0)
		
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE npenwidth_assign
	ENDPROC

ENDDEFINE

DEFINE CLASS gdiplus AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: clearerror		&& Resets the object's error status
		*m: dword2num
		*m: float2int
		*m: foxrgb2argb
		*m: geterrorstatus		&& Has an error occurred?
		*m: getlasterrormessage		&& Get information about the last error to occur
		*m: guidtostring		&& Convert GUID value from binary form to string representation
		*m: int2float
		*m: makegdiparrayf		&& Convert VFP array to a binary string (array of floats)
		*m: makegdippointf		&& Create GDI+ PointF structure as string, from separate x,y parameters
		*m: makegdiprectf		&& Create GDI+ RectF structure as string, from separate x,y,w,h parameters
		*m: makegdipsizef		&& Create GDI+ SizeF structure as string, from separate width,height parameters
		*m: num2dword
		*m: setstartpath
		*m: stringtoguid		&& Convert string representation of a GUID or CLSID to binary form (16 bytes)
		*p: clasterrormessage		&& Last error message (formatted)
		*p: cstartpath
		*p: lhaderror		&& Flag indicating whether an error has occured - you can also check return value from most functions.
		*p: nerrorcount
	*</DefinedPropArrayMethod>

	*<PropValue>
		clasterrormessage = 
		cstartpath = 
		Height = 17
		Name = "gdiplus"
		nerrorcount = 0
		Width = 24
	*</PropValue>
	
	PROCEDURE clearerror		&& Resets the object's error status
		WITH THIS
			.lHadError = .F.
			.cLastErrorMessage = ''
		ENDWITH
		
	ENDPROC

	PROCEDURE dword2num
		LPARAMETERS tcDWORD
		
		*-- Converts DWORD string buffer to FoxPro numeric
		
		RETURN ASC(SUBSTR(tcDWORD, 1,1)) + ;
			BITLSHIFT(ASC(SUBSTR(tcDWORD, 2,1)),  8) +;
			BITLSHIFT(ASC(SUBSTR(tcDWORD, 3,1)), 16) +;
			BITLSHIFT(ASC(SUBSTR(tcDWORD, 4,1)), 24)
		
	ENDPROC

	PROCEDURE Error
		LPARAMETERS tnError, tcMethod, tnLine
		
		LOCAL lcMessage
		LOCAL lcCodeLine
		LOCAL lcSetSafety
		
		WITH THIS
		
			IF EMPTY(.cStartPath)
				.SetStartPath()
			ENDIF	
		
			IF .nErrorCount <= 10
		
				lcMessage  = MESSAGE()
				lcCodeLine = MESSAGE(1)
		
				lcSetSafety = SET("SAFETY")
		
				SET SAFETY OFF
		
				.lHadError = .T.
		
				.cLastErrorMessage = lcMessage;
					+ ccCR + ccLF + .NAME ;
					+ ccCR + ccLF + ccGDIPLUS_ERRNOLABEL_LOC + ALLTRIM(STR(tnError)) ;
					+ ccCR + ccLF + ccGDIPLUS_ERRPROCLABEL_LOC + tcMethod ;
					+ ccCR + ccLF + ccGDIPLUS_ERRLINELABEL_LOC + ALLTRIM(STR(tnLine)) ;
					+ ccCR + ccLF + lcCodeLine ;
					+ ccCR + ccLF + 'Date:'+TTOC(DATETIME()) ;
					+ ccCR + ccLF + REPL('-',60) ;
					+ ccCR + ccLF
		
		*    = MESSAGEBOX(.cLastErrorMessage, 16, 'GDI+')
		
				=STRTOFILE(.cLastErrorMessage, .cStartPath + '\FRX2Any.ERR', .T.)
		
				.nErrorCount = .nErrorCount + 1
		
				SET SAFETY &lcSetSafety
		
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE float2int
		LPARAMETERS tnFLOAT
		
		*-- Converts 32-bit float form to FoxPro numeric
		LOCAL lnSgn
		LOCAL lnExponent
		LOCAL lnMantissa
		
		lnSgn = IIF(BITTEST(tnFLOAT,31), -1,1)
		
		lnExponent = BITRSHIFT(BITAND(tnFLOAT, 0x7F800000), 23) - 127
		lnMantissa = BITAND(tnFLOAT, 0x7FFFFF) / 2^(23 - lnExponent)
		
		RETURN (2 ^ lnExponent + lnMantissa) * lnSgn
		
	ENDPROC

	PROCEDURE foxrgb2argb
		LPARAMETERS tnFOXRGB, tnAlpha
		
		LOCAL lnARGB
		
		IF vartype(tnAlpha)='L' or (vartype(tnAlpha)='N' and !between(tnAlpha, 0, 255))
			tnAlpha = 255
		ENDIF
		
		lnARGB = BITOR(BITOR(0x1000000 * tnAlpha, BITLSHIFT(BITAND(tnFOXRGB,0xFF),16)), BITOR(BITAND(tnFOXRGB,0x0000FF00), BITRSHIFT(BITAND(tnFOXRGB,0x00FF0000),16)))
		
		
		RETURN lnARGB
		
	ENDPROC

	PROCEDURE geterrorstatus		&& Has an error occurred?
	ENDPROC

	PROCEDURE getlasterrormessage		&& Get information about the last error to occur
	ENDPROC

	PROCEDURE guidtostring		&& Convert GUID value from binary form to string representation
		LPARAMETERS tqGUID
		
		*-- Note - this is Unicode
		DECLARE INTEGER StringFromGUID2 IN ole32.DLL STRING @cCLSID, STRING @cUnicodeString, INTEGER nLen
		
		
		LOCAL lcUnicodeString
		LOCAL lnResult
		
		*-- Should be big enough for anything
		lcUnicodeString = REPLICATE(CHR(0),80)
		
		lnResult = StringFromGUID2(tqGUID, @lcUnicodeString, 40 )
		
		IF lnResult == 0
			ERROR ccGDIPLUS_INTERNALBUFTOOSMALL_LOC
		
			RETURN ''
		ELSE
			RETURN STRCONV(LEFT(lcUnicodeString, (lnResult - 1) * 2), 6)
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE int2float
		LPARAMETERS tnNumber
		*-- Converts FoxPro numeric to 32-bit float form
		
		LOCAL lnSign
		LOCAL lnExponent
		LOCAL lnMantissa
		
		DO CASE
			CASE tnNumber< 0
				lnSign = 0x80000000
				tnNumber = -tnNumber
		
			CASE tnNumber > 0
				lnSign = 0
		
			OTHERWISE
				RETURN 0
		
		ENDCASE
		
		lnExponent = FLOOR(LOG(tnNumber)/LOG(2))
		
		lnMantissa = (tnNumber - 2^lnExponent)* 2^(23 - lnExponent)
		
		lnExponent = BITLSHIFT(lnExponent + 127, 23)
		
		RETURN BITOR(BITOR(lnSign, lnExponent), lnMantissa)
		
		
	ENDPROC

	PROCEDURE makegdiparrayf		&& Convert VFP array to a binary string (array of floats)
		LPARAMETERS taArray, tnCols, tnFirstCol
		
		
		EXTERNAL ARRAY taArray
		
		LOCAL loPointPair
		
		LOCAL lcStruct
		LOCAL lnRows
		LOCAL lnRow
		LOCAL lnCol
		LOCAL lnFirstCol
		LOCAL lnColsMinusOne
		
		lnRows         = ALEN(taArray,1)
		lcStruct 	   = ''
		
		IF VARTYPE(taArray[1, 1]) # 'O'
		
			lnFirstCol     = IIF(EMPTY(tnFirstCol), 1, tnFirstCol)
		
			lnColsMinusOne = IIF(EMPTY(tnCols), ALEN(taArray, 2) - lnFirstCol, tnCols - 1)
		
			IF !(BETWEEN(lnFirstCol, 1, ALEN(taArray, 2)) AND BETWEEN(lnColsMinusOne, 0, ALEN(taArray,2) - lnFirstCol))
				RETURN lcStruct
			ENDIF
		
			FOR lnRow = 1 TO lnRows
				FOR lnCol = lnFirstCol TO lnFirstCol + lnColsMinusOne
					lcStruct = lcStruct + .NUM2DWORD(.INT2Float(taArray[lnRow, lnCol]))
				ENDFOR
			ENDFOR
		
		
		ELSE
		
			FOR lnRow = 1 TO lnRows
		
				loPointPair = taArray[lnRow]
		
				IF VARTYPE(loPointPair) = 'O'
		
					lcStruct = lcStruct + .NUM2DWORD(.INT2Float(loPointPair.nX))
					lcStruct = lcStruct + .NUM2DWORD(.INT2Float(loPointPair.nY))
		
				ENDIF
		
			ENDFOR
		
		
		ENDIF
		
		RETURN lcStruct
		
	ENDPROC

	PROCEDURE makegdippointf		&& Create GDI+ PointF structure as string, from separate x,y parameters
	ENDPROC

	PROCEDURE makegdiprectf		&& Create GDI+ RectF structure as string, from separate x,y,w,h parameters
	ENDPROC

	PROCEDURE makegdipsizef		&& Create GDI+ SizeF structure as string, from separate width,height parameters
	ENDPROC

	PROCEDURE num2dword
		LPARAMETER tnNumber
		*-- Converts FoxPro numeric to DWORD string buffer
		
		LOCAL lnByte0
		LOCAL lnByte1
		LOCAL lnByte2
		LOCAL lnByte3
		
		LOCAL lnMask0
		LOCAL lnMask1
		LOCAL lnMask2
		
		lnMask0 = 256
		lnMask1 = 65536
		lnMask2 = 16777216
		
		IF tnNumber < 0
		    tnNumber = 0x100000000 + tnNumber
		ENDIF
		
		lnByte3 = INT(tnNumber/lnMask2)
		lnByte2 = INT((tnNumber - lnByte3 * lnMask2)/lnMask1)
		lnByte1 = INT((tnNumber - lnByte3 * lnMask2 - lnByte2 * lnMask1)/lnMask0)
		lnByte0 = MOD(tnNumber, lnMask0)
		
		RETURN CHR(lnByte0)+CHR(lnByte1)+CHR(lnByte2)+CHR(lnByte3)
		
	ENDPROC

	PROCEDURE setstartpath
		LOCAL lcStartPath
		
		WITH THIS
		
			lcStartPath = SYS(16)
		
			DO CASE
				CASE RIGHT(TRIM(lcStartPath),3) = 'APP'
		
					.cStartPath = JUSTPATH(lcStartPath)
		
				OTHERWISE
		
					lcStartPath = SUBSTR(lcStartPath, AT(":", lcStartPath) - 1)
		
					.cStartPath	= LEFT(lcStartPath, RAT("\", lcStartPath))
		
			ENDCASE
			
			.cStartPath = ADDBS(.cStartPath)
			
		
		ENDWITH
		
	ENDPROC

	PROCEDURE stringtoguid		&& Convert string representation of a GUID or CLSID to binary form (16 bytes)
		LPARAMETERS tcString
		
		DECLARE INTEGER CLSIDFromString IN ole32.DLL STRING cString, STRING @cCLSID
		
		LOCAL lcCLSID
		LOCAL lnResult
		
		lcCLSID = REPLICATE(CHR(0),16)
		
		lnResult = CLSIDFromString(STRCONV(tcString,5), @lcCLSID)
		
		IF lnResult = 0
			RETURN lcCLSID
		
		ELSE
			ERROR ccGDIPLUS_STRINGTOGUID_LOC
		
			RETURN ''
		ENDIF
		
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS gdiplusinit AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: releasegdiplus
		*p: ngdiplustoken
	*</DefinedPropArrayMethod>

	*<PropValue>
		Height = 16
		Name = "gdiplusinit"
		ngdiplustoken = 0
		Width = 23
	*</PropValue>
	
	PROCEDURE Destroy
		THIS.ReleaseGDIPlus
	ENDPROC

	PROCEDURE Init
		DECLARE LONG GdiplusStartup IN GdiPlus.DLL LONG @ token, STRING @ INPUT, LONG @ OUTPUT
		
		LOCAL lnToken
		LOCAL lcGDIPlusStartupInput
		
		WITH THIS
		
		*-- GdiplusStartupInput structure (sizeof = 16)
			lcGDIPlusStartupInput = CHR(1) + REPLICATE(CHR(0), 15)
		
		*-- Initialize GDI+.
			lnToken = 0
		
			IF GdiplusStartup(@lnToken, @lcGDIPlusStartupInput, 0) # 0
				.nGDIPlusToken = 0
			ELSE
				.nGDIPlusToken = lnToken
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE releasegdiplus
		DECLARE LONG GdiplusShutdown IN GdiPlus.DLL LONG token
		
		WITH THIS
		
			IF .nGDIPlusToken # 0
				GdiplusShutdown(.nGDIPlusToken)
				
				.nGDIPlusToken = 0
			ENDIF
		
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS gdipoint AS gdiplus OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: cgdippointf_access
		*m: cgdippointf_assign
		*m: cgdippoint_access
		*m: cgdippoint_assign
		*m: clone
		*m: create
		*m: set
		*p: cgdippoint		&& String representing the GDI+ Point structure (2 x 32bit integers)
		*p: cgdippointf		&& String representing the GDI+ PointF structure (2 x 32bit single-precision floats)
		*p: nx		&& x-coordinate of point
		*p: ny		&& y-coordinate of point
	*</DefinedPropArrayMethod>

	*<PropValue>
		cgdippoint = 
		cgdippointf = 
		Name = "gdipoint"
		nx = 0
		ny = 0
	*</PropValue>
	
	PROCEDURE cgdippointf_access
		WITH THIS
			RETURN .Num2DWORD(.INT2Float(.nX)) + .Num2DWORD(.INT2Float(.nY))	
		ENDWITH
		
	ENDPROC

	PROCEDURE cgdippointf_assign
	ENDPROC

	PROCEDURE cgdippoint_access
	ENDPROC

	PROCEDURE cgdippoint_assign
	ENDPROC

	PROCEDURE clone
		LPARAMETERS toOtherPoint
		
		THIS.nX = toOtherPoint.nX
		THIS.nY = toOtherPoint.nY
		
		
	ENDPROC

	PROCEDURE create
		LPARAMETERS tnx,tny
		
		THIS.nX = tnx
		THIS.nY = tny
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tvXOrPoint,tny
		
		DO CASE
			CASE pcount()=1 AND VARTYPE(tvXOrPoint)='O'
		*-- Passed an object - presumably an existing Point object
				THIS.CLONE(tvXOrPoint)
		
			CASE pcount()=1 AND VARTYPE(tvXOrPoint)='C'
		*-- Passed a string (structure)
		*-- Assume PointF as this is preferred format
				THIS.cgdipPointF = tvXOrPoint
			CASE pcount()>=2
		*-- Separate components
				THIS.CREATE(tvXOrPoint,tny)
		ENDCASE
		
	ENDPROC

	PROCEDURE set
	ENDPROC

ENDDEFINE

DEFINE CLASS gdirectangle AS gdiplus OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: cgdippointf_access
		*m: cgdippointf_assign
		*m: cgdippoint_access
		*m: cgdippoint_assign
		*m: cgdiprectf_access
		*m: cgdiprectf_assign
		*m: cgdiprect_access
		*m: cgdiprect_assign
		*m: cgdipsizef_access
		*m: cgdipsizef_assign
		*m: cgdipsize_access
		*m: cgdipsize_assign
		*m: cgdirect_access
		*m: cgdirect_assign
		*m: clone
		*m: create		&& Set rectangle from individual coordinates
		*m: createfrompointsize		&& Set rectangle from separate point and size objects
		*m: inflate
		*m: nx2_access
		*m: nx2_assign
		*m: ny2_access
		*m: ny2_assign
		*m: ogdippoint_access
		*m: ogdippoint_assign
		*m: ogdipsize_access
		*m: ogdipsize_assign
		*m: set		&& Set rectangle coordinates from individual components
		*p: cgdippoint		&& GDI+ Point (integers) structure for the x,y position of this rectange
		*p: cgdippointf		&& GDI+ PointF structure for the x,y position of this rectange
		*p: cgdiprect		&& String representing the GDI+ Rect structure (4 x 32bit integers)
		*p: cgdiprectf		&& String representing the GDI+ RectF structure (4 x 32bit single-precision floats)
		*p: cgdipsize		&& GDI+ Size (integers) structure for the width and height of this rectange
		*p: cgdipsizef		&& GDI+ SizeF structure for the width and height of this rectange
		*p: cgdirect		&& GDI "RECT" structure (integers, x1,y1,x2,y2)
		*p: nheight		&& Height of rectangle
		*p: nwidth		&& Width of rectangle
		*p: nx		&& x-coordinate of upper-left corner of rectangle
		*p: nx2		&& X-Coordinate of bottom right corner of rectangle
		*p: ny		&& y-coordinate of upper-left corner of rectangle
		*p: ny2		&& Y-Coordinate of bottom right corner of rectangle
		*p: ogdippoint		&& Origin of the rectange (x,y) as a GDIpPoint object
		*p: ogdipsize		&& Width and Height of the rectangle as a GDIpSize object
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdirectangle"
		nheight = 0
		nwidth = 0
		nx = 0
		nx2 = 0
		ny = 0
		ny2 = 0
		ogdippoint = .NULL.
		ogdipsize = .NULL.
	*</PropValue>
	
	PROCEDURE cgdippointf_access
	ENDPROC

	PROCEDURE cgdippointf_assign
	ENDPROC

	PROCEDURE cgdippoint_access
	ENDPROC

	PROCEDURE cgdippoint_assign
	ENDPROC

	PROCEDURE cgdiprectf_access
		WITH THIS
		    RETURN .Num2DWORD(.INT2Float(.nX)) + .Num2DWORD(.INT2Float(.nY)) + .Num2DWORD(.INT2Float(.nWidth)) + .Num2DWORD(.INT2Float(.nHeight))
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE cgdiprectf_assign
	ENDPROC

	PROCEDURE cgdiprect_access
	ENDPROC

	PROCEDURE cgdiprect_assign
	ENDPROC

	PROCEDURE cgdipsizef_access
	ENDPROC

	PROCEDURE cgdipsizef_assign
	ENDPROC

	PROCEDURE cgdipsize_access
	ENDPROC

	PROCEDURE cgdipsize_assign
	ENDPROC

	PROCEDURE cgdirect_access
	ENDPROC

	PROCEDURE cgdirect_assign
	ENDPROC

	PROCEDURE clone
		LPARAMETERS tvOtherRect
		
		DO CASE
			CASE VARTYPE(tvOtherRect)='O'
				THIS.nX = toOtherRect.nX
				THIS.nY = toOtherRect.nY
				THIS.nWidth = toOtherRect.nWidth
				THIS.nHeight = toOtherRect.nHeight
		
			CASE VARTYPE(tvOtherRect)='C'
		*-- Assume RectF
				THIS.cGDIPRectF = tvOtherRect
		
			OTHERWISE
				RETURN .F.
		
		ENDCASE
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE create		&& Set rectangle from individual coordinates
		LPARAMETERS tnX,tnY,tnWidth,tnHeight
		
		THIS.nX = tnX
		THIS.nY = tnY
		THIS.nWidth = IIF(EMPTY(tnWidth),0, tnWidth)
		THIS.nHeight = IIF(EMPTY(tnHeight),0, tnHeight)
		
	ENDPROC

	PROCEDURE createfrompointsize		&& Set rectangle from separate point and size objects
	ENDPROC

	PROCEDURE inflate
		LPARAMETERS tnX, tnY
		
		WITH THIS
		
				.nX  = .nX  - tnX
				.nX2 = .nX2 + 2*tnX
				
				.nY  = .nY  - tnY
				.nY2 = .nY2 + 2*tnY
				
		ENDWITH
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tvXorRectorPoint, tvYorSize, tnW, tnH
		
		DO CASE
			CASE pcount()=0
		*-- empty constructor - rectangle will be empty
		
			CASE pcount()=1 AND VARTYPE(tvXorRectorPoint)='O'
		*-- Passed an object - presumably an existing Rect object
				THIS.CLONE(tvXorRectorPoint)
		
			CASE pcount()=1 AND VARTYPE(tvXorRectorPoint)='C'
		*-- Passed a string (structure)
		*-- Rect or RectF? Assume RectF as this is preferred format
				THIS.cgdipRectF = tvXorRectorPoint
		
			CASE pcount()=2 AND VARTYPE(tvXorRectorPoint)$'OC' AND VARTYPE(tvYorSize)$'OC'
		*-- Passed separate point and size objects?
				THIS.CreateFromPointSize(tvXorRectorPoint, tvYorSize)
		
			CASE pcount()>=4 ;
					AND VARTYPE(tvXorRectorPoint)='N' AND VARTYPE(tvYorSize)='N' ;
					AND VARTYPE(tnw)='N' AND VARTYPE(tnh)='N'
		*-- Separate components
				THIS.CREATE(tvXorRectorPoint,tvYorSize,tnw,tnh)
			OTHERWISE
				RETURN .F.
		ENDCASE
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE nx2_access
		WITH THIS
			RETURN .nX + .nWidth
		ENDWITH
		
		
	ENDPROC

	PROCEDURE nx2_assign
		LPARAMETERS tX2
		
		WITH THIS
			.nWidth = tX2 - .nX
		ENDWITH
		
		
	ENDPROC

	PROCEDURE ny2_access
		WITH THIS
			RETURN .nY + .nHeight
		ENDWITH
		
		
	ENDPROC

	PROCEDURE ny2_assign
		LPARAMETERS tnY2
		
		WITH THIS
			.nHeight = tnY2 - .nY
		ENDWITH
		
	ENDPROC

	PROCEDURE ogdippoint_access
	ENDPROC

	PROCEDURE ogdippoint_assign
	ENDPROC

	PROCEDURE ogdipsize_access
	ENDPROC

	PROCEDURE ogdipsize_assign
	ENDPROC

	PROCEDURE set		&& Set rectangle coordinates from individual components
	ENDPROC

ENDDEFINE

DEFINE CLASS gdisize AS gdiplus OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: cgdipsizef_access
		*m: cgdipsizef_assign
		*m: cgdipsize_access
		*m: cgdipsize_assign
		*m: clone
		*m: create
		*m: set
		*p: cgdipsize		&& String representing the GDI+ Size structure (2 x 32bit integers)
		*p: cgdipsizef		&& String representing the GDI+ SizeF structure (2 x 32bit single-precision floats)
		*p: nheight		&& Height value
		*p: nwidth		&& Width value
	*</DefinedPropArrayMethod>

	*<PropValue>
		cgdipsize = 
		cgdipsizef = 
		Name = "gdisize"
		nheight = 0
		nwidth = 0
	*</PropValue>
	
	PROCEDURE cgdipsizef_access
		WITH THIS
		    RETURN .Num2DWORD(.INT2Float(.nWidth)) + .Num2DWORD(.INT2Float(.nHeight))
		ENDWITH
		
		
	ENDPROC

	PROCEDURE cgdipsizef_assign
		LPARAMETERS tcGdipSizeF
		
		WITH THIS
		
			THIS.nWidth = .FLOAT2Int(.DWORD2Num(SUBSTR(tcGdipSizeF,1,4)))
			THIS.nHeight = .FLOAT2Int(.DWORD2Num(SUBSTR(tcGdipSizeF,5,4)))
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE cgdipsize_access
	ENDPROC

	PROCEDURE cgdipsize_assign
	ENDPROC

	PROCEDURE clone
		LPARAMETERS toOtherSize
		
		THIS.nWidth = toOtherSize.nWidth
		THIS.nHeight = toOtherSize.nHeight
		
		
	ENDPROC

	PROCEDURE create
		LPARAMETERS tnWidth,tnHeight
		
		THIS.nWidth = tnWidth
		THIS.nHeight = tnHeight
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tvWorSize,tnHeight
		
		DO CASE
			CASE pcount()=1 AND VARTYPE(tvWorSize)='O'
		*-- Passed an object - presumably an existing Size object
				THIS.CLONE(tvWorSize)
			CASE pcount()=1 AND VARTYPE(tvWorSize)='C'
		*-- Passed a string (structure)
		*-- Assume SizeF as this is preferred format
				THIS.cgdipSizeF = tvWorSize
				
			CASE pcount()>=2
		*-- Separate components
				THIS.CREATE(tvWorSize,tnHeight)
		ENDCASE
		
	ENDPROC

	PROCEDURE set
	ENDPROC

ENDDEFINE

DEFINE CLASS gdisolidbrush AS gdibrush OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: nbrushcolor_access
		*m: nbrushcolor_assign
		*p: nbrushcolor		&& Get or set color of a SolidBrush object
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdisolidbrush"
	*</PropValue>
	
	PROCEDURE create
		LPARAMETERS tvColor
		*-- tvColor may be ARGB or a Color object
		
		DECLARE INTEGER GdipCreateSolidFill IN GDIPlus.DLL INTEGER nColor, INTEGER @nBrush
		
		LOCAL lnHandle
		
		WITH THIS
		
			.DESTROY()
		
			lnHandle = 0
		
			.nGDIPStatus = GdipCreateSolidFill(IIF(VARTYPE(tvColor)='O', tvColor.nARGB, IIF(VARTYPE(tvColor)='N', tvColor, 0xFF000000)), @lnHandle)
		
			.SetHandle(lnHandle, .T.)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tvColor, tnAlpha, tlARGB
		
		WITH THIS
		
			IF pcount() > 0
		
				IF VARTYPE(tvColor) $ 'NFIBY' AND !tlARGB
					tvColor = .FoxRGB2ARGB(tvColor, tnAlpha)
				ENDIF
		
				RETURN .CREATE(tvColor)
				
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE nbrushcolor_access
	ENDPROC

	PROCEDURE nbrushcolor_assign
	ENDPROC

ENDDEFINE

DEFINE CLASS gdistringformat AS gdiobject OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: clone
		*m: create
		*m: getgenericdefault		&& Get generic default string format (.NET: SystemDrawing.StringFormat.GenericDefault)
		*m: getgenerictypographic		&& Get generic typographic StringFormat
		*m: nalignment_access
		*m: nalignment_assign
		*m: nformatflags_access
		*m: nformatflags_assign
		*m: nhotkeyprefix_access
		*m: nhotkeyprefix_assign
		*m: nlinealignment_access
		*m: nlinealignment_assign
		*m: ntrimming_access
		*m: ntrimming_assign
		*p: nalignment		&& Text alignment information.
		*p: nformatflags		&& Formatting Information (StringFormatFlags enumeration)
		*p: nhotkeyprefix		&& Set GpHotkeyPrefix object (write-only?)
		*p: nlinealignment		&& Line alignment
		*p: ntrimming		&& String trimming
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdistringformat"
	*</PropValue>
	
	PROCEDURE clone
	ENDPROC

	PROCEDURE create
		LPARAMETERS tnFlags, tnLangID
		
		DECLARE INTEGER GdipCreateStringFormat IN GDIPlus.DLL INTEGER,INTEGER,INTEGER @nHandle
		
		LOCAL lnHandle
		
		
		WITH THIS
		
			lnHandle = 0
		
			.DESTROY()
		
			.nGDIPStatus = GdipCreateStringFormat (IIF(EMPTY(tnFlags),0,tnFlags) , IIF(EMPTY(tnLangID),0,tnLangID), @lnHandle)
			.SetHandle(lnHandle,.T.)
		
			RETURN .nGDIPStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE Destroy
		WITH THIS
		
			IF .nGdipHandle # 0 AND .lgdipOwnsThisHandle
				DECLARE INTEGER GdipDeleteStringFormat IN GDIPlus.DLL INTEGER nStringFormat
		
				GdipDeleteStringFormat(.nGdipHandle)
		
			ENDIF
		
			.nGDIPHandle		 = 0
			.lGDIPOwnsThisHandle = .F.
		
		ENDWITH
		
	ENDPROC

	PROCEDURE getgenericdefault		&& Get generic default string format (.NET: SystemDrawing.StringFormat.GenericDefault)
	ENDPROC

	PROCEDURE getgenerictypographic		&& Get generic typographic StringFormat
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tnFlags, tnLangID
		
		RETURN THIS.CREATE(tnFlags, tnLangID)
		
	ENDPROC

	PROCEDURE nalignment_access
	ENDPROC

	PROCEDURE nalignment_assign
		LPARAMETERS tnAlignment
		
		DECLARE INTEGER GdipSetStringFormatAlign IN gdiplus.DLL INTEGER nGraphics, INTEGER
		
		THIS.ngdipStatus = GdipSetStringFormatAlign( THIS.ngdipHandle,tnAlignment)
		
		RETURN cnGDIPLUS_STATUS_OK == THIS.ngdipStatus
		
	ENDPROC

	PROCEDURE nformatflags_access
	ENDPROC

	PROCEDURE nformatflags_assign
		LPARAMETERS tnFormatFlags
		
		DECLARE INTEGER GdipSetStringFormatFlags IN gdiplus.DLL INTEGER nGraphics, INTEGER
		
		THIS.nGDIPStatus = GdipSetStringFormatFlags( THIS.nGDIPHandle,tnFormatFlags)
		
		RETURN cnGDIPLUS_STATUS_OK == THIS.ngdipStatus
		
	ENDPROC

	PROCEDURE nhotkeyprefix_access
	ENDPROC

	PROCEDURE nhotkeyprefix_assign
	ENDPROC

	PROCEDURE nlinealignment_access
	ENDPROC

	PROCEDURE nlinealignment_assign
	ENDPROC

	PROCEDURE ntrimming_access
		DECLARE INTEGER GdipGetStringFormatTrimming IN gdiplus.DLL INTEGER nGraphics, INTEGER @
		
		LOCAL lnTrimming
		
		lnTrimming = 0
		
		THIS.nGDIPStatus = GdipGetStringFormatTrimming(THIS.nGDIPHandle, @lnTrimming)
		
		RETURN IIF(THIS.nGDIPStatus = cnGDIPLUS_STATUS_OK, lnTrimming, cnGDIPLUS_STRINGTRIMMING_None)
		
	ENDPROC

	PROCEDURE ntrimming_assign
		LPARAMETERS tnTrimming
		
		DECLARE INTEGER GdipSetStringFormatTrimming IN gdiplus.DLL INTEGER nGraphics, INTEGER
		
		THIS.nGDIPStatus = GdipSetStringFormatTrimming(THIS.nGDIPHandle, tnTrimming)
		
		RETURN cnGDIPLUS_STATUS_OK = THIS.nGDIPStatus
		
	ENDPROC

ENDDEFINE
