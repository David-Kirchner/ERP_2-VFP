		LOCAL lcPoints
		
		WITH THIS
		
			lcPoints = .MakeGdipArrayF(@taPoints, 2, tnFirstCol)
		
			.nGDIPStatus = GdipFillClosedCurve(.nGDIPHandle, toBrush.GetHandle(), lcPoints, LEN(lcPoints)/8, tnFillMode)
		
			RETURN .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

