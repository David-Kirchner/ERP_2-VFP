	PROCEDURE drawstringa		&& Draw a string in specified font and position (ANSI Version)
		LPARAMETERS tcAnsiString, toFont, tvRectPoint, toStringFormat, toBrush
		
		DECLARE INTEGER GdipDrawString IN gdiplus.DLL INTEGER,STRING,INTEGER,INTEGER,STRING,INTEGER,INTEGER
		
		LOCAL lcRect
		
		WITH THIS
		
			DO CASE
				CASE VARTYPE(tvRectPoint)$'CQ' && String or varbinary
					DO CASE
						CASE LEN(tvRectPoint)==8 && point
							lcRect = tvRectPoint + REPLICATE(CHR(0),8)
		
						CASE LEN(tvRectPoint)==16 && rect
							lcRect = tvRectPoint
		
						OTHERWISE
							THIS.ngdipStatus = cnGDIPLUS_STATUS_InvalidParameter
		
							RETURN .F.
					ENDCASE
		
				CASE VARTYPE(tvRectPoint) == 'O'
					DO CASE
						CASE pemstatus(tvRectPoint,'cGDIPRectF',5)	&& Rect
							lcRect = tvRectPoint.cGDIPRectF
		
						CASE pemstatus(tvRectPoint,'cGDIPPointF',5)	&& Point
							lcRect = tvRectPoint.cGDIPPointF + REPLICATE(CHR(0),8)
		
						OTHERWISE
							.ngdipStatus = cnGDIPLUS_STATUS_InvalidParameter
		
							RETURN .F.
					ENDCASE
		
				OTHERWISE
					.ngdipStatus = cnGDIPLUS_STATUS_InvalidParameter
		
					RETURN .F.
			ENDCASE
		
			.ngdipStatus = GdipDrawString( ;
				.nGDIPHandle ;
				, STRCONV(tcAnsiString, 5)	;
				, LEN(tcAnsiString) ;
				, IIF(VARTYPE(toFont) = 'O', toFont.GetHandle(), 0) ;
				, lcRect ;
				, IIF(VARTYPE(toStringFormat) = 'O', toStringFormat.GetHandle(), 0) ;
				, IIF(VARTYPE(toBrush) = 'O', toBrush.GetHandle(), 0) ;
				)
		
			RETURN .nGDIPStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE drawstringw		&& Draw a string in specified font and position (Unicode Version)
		LPARAMETERS tcUnicodeString, toFont, tvRectPoint, toStringFormat, toBrush
		
		DECLARE INTEGER GdipDrawString IN gdiplus.DLL INTEGER,STRING,INTEGER,INTEGER,STRING,INTEGER,INTEGER
		
		LOCAL lcRect
		
		WITH THIS
		
			DO CASE
				CASE VARTYPE(tvRectPoint)$'CQ' && String or varbinary
					DO CASE
						CASE LEN(tvRectPoint)==8 && point
							lcRect = tvRectPoint + REPLICATE(CHR(0),8)
		
						CASE LEN(tvRectPoint)==16 && rect
							lcRect = tvRectPoint
		
						OTHERWISE
							.ngdipStatus = cnGDIPLUS_STATUS_InvalidParameter
		
							RETURN .F.
					ENDCASE
		
				CASE VARTYPE(tvRectPoint) == 'O'
					DO CASE
						CASE pemstatus(tvRectPoint,'cGDIPRectF',5)	&& Rect
							lcRect = tvRectPoint.cGdipRectF
		
						CASE pemstatus(tvRectPoint,'cgdipPointF',5)	&& Point
							lcRect = tvRectPoint.cGdipPointF + REPLICATE(CHR(0),8)
		
						OTHERWISE
							.ngdipStatus = cnGDIPLUS_STATUS_InvalidParameter
		
							RETURN .F.
					ENDCASE
		
				OTHERWISE
					.ngdipStatus = cnGDIPLUS_STATUS_InvalidParameter
		
					RETURN .F.
			ENDCASE
		
			.ngdipStatus = GdipDrawString( ;
				.ngdipHandle ;
				, tcUnicodeString ;
				, LEN(tcUnicodeString)/2 ;
				, IIF(VARTYPE(toFont)='O',toFont.GetHandle(),0) ;
				, lcRect ;
				, IIF(VARTYPE(toStringFormat)='O',toStringFormat.GetHandle(),0) ;
				, IIF(VARTYPE(toBrush)='O',toBrush.GetHandle(),0) ;
				)
		
			RETURN .ngdipStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

