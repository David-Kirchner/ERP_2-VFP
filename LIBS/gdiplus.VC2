	ENDPROC

ENDDEFINE

DEFINE CLASS gdicolor AS gdiplus OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: nalpha_access
		*m: nalpha_assign
		*m: nblue_access
		*m: nblue_assign
		*m: nfoxrgb_access
		*m: nfoxrgb_assign
		*m: ngreen_access
		*m: ngreen_assign
		*m: nred_access
		*m: nred_assign
		*m: nrgb_access
		*m: nrgb_assign
		*m: set		&& Set colour value using separate R,G,B,Alpha components
		*p: nalpha		&& Alpha (transparency) component, value 0-255 (255=completely opaque)
		*p: nargb		&& Color in ARGB form (GDI+ native format), bits 24-31=alpha, 16-23=red, 8-15=green, 0-7=blue
		*p: nblue		&& Blue component, value 0-255
		*p: nfoxrgb		&& Color in Foxpro RGB form (bits 0-7=red, 8-15=green, 16-23=blue, no transparency)
		*p: ngreen		&& Green component, value 0-255
		*p: nred		&& Green component, value 0-255
		*p: nrgb		&& Color in Foxpro RGB form (bits 0-7=red, 8-15=green, 16-23=blue, no transparency)
	*</DefinedPropArrayMethod>

	*<PropValue>
		nalpha = 0
		Name = "gdicolor"
		nargb = -16777216
		nblue = 0
		nfoxrgb = 0
		ngreen = 0
		nred = 0
		nrgb = 0
	*</PropValue>
	
	PROCEDURE Init
		LPARAMETERS tnRedOrARGB, tnGreen, tnBlue, tnAlpha
		
		WITH THIS
			DO CASE
				CASE pcount()=1
					.nARGB = INT(tnRedOrARGB)
		
				CASE pcount()>=3
					.SET(tnRedOrARGB, tnGreen, tnBlue, tnAlpha )
		
			ENDCASE
		ENDWITH
		
	ENDPROC

	PROCEDURE nalpha_access
	ENDPROC

	PROCEDURE nalpha_assign
		LPARAMETERS tnAlpha
		
		WITH THIS
			.nARGB = BITOR(BITAND(.nARGB, 0xFF00FFFF), BITLSHIFT(tnAlpha, 24))
		ENDWITH
		
	ENDPROC

	PROCEDURE nblue_access
	ENDPROC

	PROCEDURE nblue_assign
	ENDPROC

	PROCEDURE nfoxrgb_access
	ENDPROC

	PROCEDURE nfoxrgb_assign
		LPARAMETERS tnFOXRGB
		
		THIS.nARGB = BITOR(BITOR(0xFF000000, BITLSHIFT(BITAND(tnFOXRGB,0xFF),16)), BITOR(BITAND(tnFOXRGB,0x0000FF00), BITRSHIFT(BITAND(tnFOXRGB,0x00FF0000),16)))
		
		
		
	ENDPROC

	PROCEDURE ngreen_access
	ENDPROC

	PROCEDURE ngreen_assign
	ENDPROC

	PROCEDURE nred_access
	ENDPROC

	PROCEDURE nred_assign
	ENDPROC

	PROCEDURE nrgb_access
	ENDPROC

	PROCEDURE nrgb_assign
	ENDPROC

	PROCEDURE set		&& Set colour value using separate R,G,B,Alpha components
		LPARAMETERS tnRed, tnGreen, tnBlue, tnAlpha
		
		WITH THIS
		
			IF VARTYPE(tnAlpha) <> "N"
				tnAlpha = 0xFF000000
			ENDIF
			
			.nARGB = BITOR(BITOR(BITLSHIFT(tnAlpha, 24) , BITLSHIFT(tnRed, 16)) , BITOR(BITLSHIFT(tnGreen, 8) , tnBlue))
		
		ENDWITH
		
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS gdiencoderparameter AS gdiplus OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*p: cencoderparameter
		*p: nallocation
	*</DefinedPropArrayMethod>

	*<PropValue>
		cencoderparameter = 
		Height = 16
		nallocation = 0
		Name = "gdiencoderparameter"
		Width = 26
	*</PropValue>
	
	PROCEDURE Destroy
		DECLARE LONG LocalFree IN Win32API LONG HMEM
		
		WITH THIS
			LocalFree(.nAllocation)
		ENDWITH
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tcGuid, tnValue
		
		DECLARE LONG LocalAlloc IN Win32API LONG uFlags, LONG uBytes
		DECLARE RtlMoveMemory IN Win32API AS RtlCopyData LONG DestNum, LONG @ pVoidSource, INTEGER nLength
		
		WITH THIS
			.nAllocation = LocalAlloc(0x0040, 4)
		
			RtlCopyData(.nAllocation, tnValue, 4)
		
			.cEncoderParameter = tcGuid + .Num2DWord(1) + .Num2DWord(4)
			.cEncoderParameter = .cEncoderParameter + .Num2DWord(.nAllocation)
		
		ENDWITH
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS gdifont AS gdiobject OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: cfontname_access
		*m: cfontname_assign
		*m: create		&& Create font using specified font family, size and style
		*m: getheight		&& Get line spacing for a given Graphics object (in the units of that graphics object)
		*m: getheightgivendpi		&& Get line spacing of this font, for specified DPI
		*m: nsize_access
		*m: nsize_assign
		*m: nstyle_access
		*m: nstyle_assign
		*m: nunit_access
		*m: nunit_assign
		*p: cfontname		&& Font name eg "Arial"
		*p: nsize		&& Get the em size in the unit of this Font object
		*p: nstyle		&& Get style information for this font
		*p: nunit		&& The unit of measure used by this font
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdifont"
		nsize = 0
		nstyle = 0
		nunit = 0
	*</PropValue>
	
	PROCEDURE cfontname_access
	ENDPROC

	PROCEDURE cfontname_assign
	ENDPROC

	PROCEDURE create		&& Create font using specified font family, size and style
		LPARAMETERS tvFontNameOrFamily, tnSize, tnStyle, tnUnit
		
		*-- tvFontNameOrFamily - Font name or Fontfamily (created separately)
		*-- tnSize 			   - Size in units (default points)
		*-- tnStyle 		   - See GDIPLUS_FontStyle_xxx values (default Normal)
		*-- tnUnit 			   - See GDIPLUS_Unit_xxx values (default points)
		
		DECLARE INTEGER GdipCreateFont IN GDIPlus.DLL INTEGER nFontFamily, SINGLE FSIZE, INTEGER nStyle, INTEGER nUnit, INTEGER @nHandle
		DECLARE INTEGER GdipGetGenericFontFamilySansSerif IN gdiplus.DLL INTEGER @
		
		LOCAL loFamily
		
		LOCAL lnStyle
		LOCAL lnUnit
		LOCAL lnHandle
		LOCAL lnFamily
		
		WITH THIS
		
			lnStyle  = IIF(EMPTY(tnStyle), cnGDIPLUS_FontStyle_Regular, tnStyle)
			lnUnit   = IIF(EMPTY(tnUnit), cnGDIPLUS_Unit_World, tnUnit)
			lnHandle = 0
		
			IF VARTYPE(tvFontnameOrFamily)='O'
				lnFamily = tvFontNameOrFamily.GetHandle()
			ELSE
		*-- Must create ourselves
				loFamily = NEWOBJECT(ccGDIPLUS_CLASS_FONTFAMILY, ccGDIPLUS_CLASS_LIBRARY, '', tvFontNameOrFamily)
				lnFamily = IIF(VARTYPE(loFamily) = 'O', loFamily.GetHandle(), 0)
			ENDIF
		
			.DESTROY()
		
			IF lnFamily # 0
		*-- Try creating font
				.nGDIPStatus = GdipCreateFont(lnFamily, tnSize, lnStyle, lnUnit, @lnHandle)
		
				IF .nGDIPStatus == cnGDIPLUS_STATUS_OK
		*-- That worked
					.SetHandle(lnHandle, .T.)
		
					RETURN .T.
				ENDIF
			ENDIF
		
		*-- If here, either font family is invalid or font creation failed
		*-- Try from Generic family
			lnFamily = 0
			GdipGetGenericFontFamilySansSerif( @lnFamily )
		
			.nGDIPStatus = GdipCreateFont( lnFamily, tnSize, lnStyle, lnUnit, @lnHandle)
			.SetHandle(lnHandle, .T.)
		
			RETURN .nGdipStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE Destroy
		WITH THIS
		
			IF .nGDIPHandle # 0 AND .lGDIPOwnsThisHandle
				DECLARE INTEGER GdipDeleteFont IN GDIPlus.DLL INTEGER nFont
		
				GdipDeleteFont(.nGDIPHandle)
			ENDIF
			
			.nGDIPHandle 		 = 0
			.lGDIPOwnsThisHandle = .F.
		
		ENDWITH
		
	ENDPROC

	PROCEDURE getheight		&& Get line spacing for a given Graphics object (in the units of that graphics object)
		LPARAMETERS tvGraphics
		
		DECLARE INTEGER GdipGetFontHeight IN gdiplus.DLL INTEGER nFont, INTEGER nGraphics, SINGLE @ fHeight
		
		LOCAL lnGraphics
		LOCAL lnHeight
		
		lnHeight = 0.0
		
		WITH THIS
		
			DO CASE
				CASE VARTYPE(tvGraphics)='N'
					lnGraphics = tvGraphics
					
				CASE VARTYPE(tvGraphics)='O'
					lnGraphics = tvGraphics.GetHandle()
					
				OTHERWISE
				
					ERROR 11
					.nGDIPStatus = cnGDIPLUS_STATUS_InvalidParameter
		
					RETURN 0
			ENDCASE
		
			.nGDIPStatus = GdipGetFontHeight(.nGDIPHandle, lnGraphics, @lnHeight)
		
			RETURN IIF(.nGDIPStatus = cnGDIPLUS_STATUS_OK, lnHeight, 0)
		
		ENDWITH
		
	ENDPROC

	PROCEDURE getheightgivendpi		&& Get line spacing of this font, for specified DPI
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tvFontNameOrFamily, tnSize, tnStyle, tnUnit
		
		*--	tvFontNameOrFamily - Font name, or Fontfamily (created separately)
		*--	tnSize 			   - Size in units (default points)
		*--	tnStyle 		   - See GDIPLUS_FontStyle_xxx values (default Normal)
		*--	tnUnit 			   - See GDIPLUS_Unit_xxx values (default points)
		
		IF pcount()>0
			RETURN THIS.CREATE(tvFontNameOrFamily, tnSize, tnStyle, tnUnit)
		ENDIF
		
		
	ENDPROC

	PROCEDURE nsize_access
	ENDPROC

	PROCEDURE nsize_assign
	ENDPROC

	PROCEDURE nstyle_access
	ENDPROC

	PROCEDURE nstyle_assign
	ENDPROC

	PROCEDURE nunit_access
	ENDPROC

	PROCEDURE nunit_assign
	ENDPROC

ENDDEFINE

DEFINE CLASS gdifontfamily AS gdiobject OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: cfontname_access
		*m: cfontname_assign
		*m: create		&& Create font family with specified name
		*m: getcellascent		&& Get cell ascent in design units, of this font family in the specified  style
		*m: getcelldescent		&& Get cell descent in design units, of this font family in the specified  style
		*m: getemheight		&& Get the height in design units, of this font family in the specified  style
		*m: getgenericmonospace		&& Gets a generic monospace FontFamily
		*m: getgenericsansserif		&& Gets a generic sans serif FontFamily
		*m: getgenericserif		&& Gets a generic serif FontFamily
		*m: getlinespacing		&& Get line spacing in design units, of this font family in the specified  style
		*m: getname		&& Get name of this font family, in the specified language
		*m: isstyleavailable		&& Indicates whether the specified Font Style enumeration is available
		*p: cfontname		&& Font name eg "Arial"
		*p: ngdipfontcollectionhandle		&& Handle to GDI+ FontCollection object. This class does not manage this handle at all, it merely uses it. Normally it will refer to the collection of installed fonts.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdifontfamily"
	*</PropValue>
	
	PROCEDURE cfontname_access
	ENDPROC

	PROCEDURE cfontname_assign
	ENDPROC

	PROCEDURE create		&& Create font family with specified name
		LPARAMETERS tcName
		
		DECLARE INTEGER GdipCreateFontFamilyFromName IN GDIPlus.DLL STRING cUnicodeName, INTEGER nFontCollection ,INTEGER @nHandle
		
		LOCAL lnHandle
		
		WITH THIS
		
			.DESTROY()
		
			lnHandle = 0
		
			.nGDIPStatus = GdipCreateFontFamilyFromName (STRCONV(tcName, 5) + CHR(0), .nGDIPFontCollectionHandle, @lnHandle)
		
			.SetHandle(lnHandle, .T.)
		
			RETURN .nGdipStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
	ENDPROC

	PROCEDURE Destroy
		WITH THIS
		
			IF .nGDIPHandle # 0 AND .lGDIPOwnsThisHandle
		
				DECLARE INTEGER GdipDeleteFontFamily IN GDIPlus.DLL INTEGER nFontFamily
		
				GdipDeleteFontFamily(.nGDIPHandle)
		
			ENDIF
		
			.nGDIPHandle         = 0
			.lGDIPOwnsThisHandle = .F.
		
		ENDWITH
		
	ENDPROC

	PROCEDURE getcellascent		&& Get cell ascent in design units, of this font family in the specified  style
	ENDPROC

	PROCEDURE getcelldescent		&& Get cell descent in design units, of this font family in the specified  style
	ENDPROC

	PROCEDURE getemheight		&& Get the height in design units, of this font family in the specified  style
	ENDPROC

	PROCEDURE getgenericmonospace		&& Gets a generic monospace FontFamily
	ENDPROC

	PROCEDURE getgenericsansserif		&& Gets a generic sans serif FontFamily
	ENDPROC

	PROCEDURE getgenericserif		&& Gets a generic serif FontFamily
	ENDPROC

	PROCEDURE getlinespacing		&& Get line spacing in design units, of this font family in the specified  style
	ENDPROC

	PROCEDURE getname		&& Get name of this font family, in the specified language
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tcName
		*-- Get the Installed Font collection
		
		WITH THIS
		
		    .nGDIPFontCollectionHandle = 0
		
		    IF pcount() = 1
		        RETURN .CREATE(tcName)
		    ENDIF
		
		    RETURN .T.
		
		ENDWITH
		
	ENDPROC

	PROCEDURE isstyleavailable		&& Indicates whether the specified Font Style enumeration is available
	ENDPROC

ENDDEFINE

DEFINE CLASS gdigraphics AS gdiobject OF "gdiplus.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\frx2any.h"
	*<DefinedPropArrayMethod>
		*m: changecolors
		*m: changetomonochrome
		*m: clear		&& Clear entire drawing surface and fill with specified background color
		*m: createfromhdc		&& Create Graphics object for a given device context (HDC)
		*m: createfromhwnd		&& Create GDI+ Graphics object for a given window (HWND)
		*m: createfromimage		&& Create graphics object from the specified GpImage object (to draw on that image's surface)
		*m: drawarc		&& Draws an arc representing a portion of an ellipse, given bounding rectangle of elllipse, start and sweep angles.
		*m: drawbezier		&& Draw a Bézier spline from 4 control points
		*m: drawbeziers		&& Draw a Bézier spline given a 2-column array of coordinates
		*m: drawbeziersfromcursor		&& Draw a Bézier spline given a cursor containing coordinates
		*m: drawcachedbitmap		&& Draw cached bitamp at the specified position
		*m: drawclosedcurve		&& Draw a closed curve given a 2-column array of coordinates
		*m: drawclosedcurvefromcursor		&& Draw a closed curve given a cursor containing coordinates
		*m: drawcurve		&& Draw a smooth curve given a 2-column array of coordinates
		*m: drawcurvefromcursor		&& Draw a smooth curve given a cursor containing coordinates
		*m: drawellipse		&& Draw outlined ellipse specified by its bounding rectangle
		*m: drawimageat		&& Draw image at the specified location, using its original physical size
		*m: drawimageportionat		&& Draw portion of an image at the specified location, using its original size
		*m: drawimageportionatpoint		&& Draw portion of an image at the specified location, using its original size
		*m: drawimageportionscaled		&& Draw portion of an image at the specified location and with the specified size
		*m: drawimagescaled		&& Draw image at the specified location with the specified size.
		*m: drawline		&& Draw a line that connects two points, in the specified pen.
		*m: drawlines		&& Draw sequence of connected lines, given array of coordinates
		*m: drawlinesfromcursor		&& Draw sequence of connected lines, given cursor containing coordinates
		*m: drawpath
		*m: drawpie		&& Draw outlined pie slice in specified pen and start/stop anagles
		*m: drawpolygon		&& Draw a polygon given a 2-column array of coordinates
		*m: drawpolygonfromcursor		&& Draw a polygon given a cursor containing coordinates
		*m: drawrectangle		&& Draw a rectangle
		*m: drawrectangles		&& Draw a series of rectangles given a 4-column array (each row x,y,w,h)
		*m: drawrectanglesfromcursor		&& Draw a series of rectangles given a cursor containing x,y,w,h values
		*m: drawstringa		&& Draw a string in specified font and position (ANSI Version)
		*m: drawstringw		&& Draw a string in specified font and position (Unicode Version)
		*m: fillclosedcurve		&& Fill a closed curve defined by a 2-column array of coordinates
		*m: fillclosedcurvefromcursor		&& Fill a closed curve from a cursor defining coordinates
		*m: fillellipse		&& Draw filled ellipse specified by its bounding rectangle
		*m: fillpath
		*m: fillpie		&& Draw filled pie slice in specified pen and start/stop angles
		*m: fillpolygon		&& Filll a polygon defined by a 2-column array of coordinates
		*m: fillpolygonfromcursor		&& Fill a polygon from a cursor defining coordinates
		*m: fillrectangle		&& Fill a rectangle
		*m: fillrectangles		&& Fill a series of rectangles defined by a 4-column array of coordinates
		*m: fillrectanglesfromcursor		&& Fill a series of rectangles defined by a cursor containing x,y,w,h values
		*m: flush		&& Force execution of all pending graphics operations
		*m: gethdc		&& Get handle to device context associated with this Graphics object.
		*m: measurestringa		&& Measures ANSI text string when drawn with the specified Font and formatting
		*m: measurestringw		&& Measures Unicode text string when drawn with the specified Font and formatting
		*m: ndpix_access
		*m: ndpix_assign
		*m: ndpiy_access
		*m: ndpiy_assign
		*m: ninterpolationmode_access
		*m: ninterpolationmode_assign
		*m: npagescale_access
		*m: npagescale_assign
		*m: releasehdc		&& Release device context previously obtained with GetHdc()
		*m: resettransform		&& Reset the world transform matrix (to no transformation)
		*m: restore		&& Restore previously saved state
		*m: rotatetransform		&& Prepend rotation by specified angle to this object's transformation matrix
		*m: save		&& Save current state and return token (for later restore)
		*m: scaletransform		&& Apply scaling to transformation matrix for this graphics object
		*m: translatetransform		&& Add translate by (x,y) to this graphics object's transformation matrix
		*p: ndpix		&& Horizontal resolution of drawing surface
		*p: ndpiy		&& Vertical resolution of drawing surface
		*p: ninterpolationmode
		*p: npagescale		&& The scaling between world units and page units
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "gdigraphics"
		ndpix = 96
		ndpiy = 96
		ninterpolationmode = 0
		npagescale = 0
	*</PropValue>
	
	PROCEDURE changecolors
		LPARAMETERS toImage, tnRed, tnGreen, tnBlue, tnAlpha
		
		
		DECLARE INTEGER GdipDrawImageRectRect IN gdiplus.DLL ;
			INTEGER nGraphics, INTEGER nImage ;
			, SINGLE,SINGLE,SINGLE,SINGLE ;
			, SINGLE,SINGLE,SINGLE,SINGLE ;
			, INTEGER nSrcUnit ;
			, INTEGER nImgAttribs ;
			, INTEGER nCallback, INTEGER nCallbackData
		
		
		LOCAL lnWidth
		LOCAL lnHeight
		
		
		WITH THIS
		
			IF PCOUNT() = 2
				IF VARTYPE(tnRed) <> "N"
					RETURN .F.
				ENDIF
			ELSE
				IF (VARTYPE(tnRed) + VARTYPE(tnGreen) + VARTYPE(tnBlue) <> "NNN") OR (NOT VARTYPE(tnAlpha) $ "NL")
					RETURN .F.
				ENDIF
			ENDIF
		
			IF VARTYPE(tnAlpha) = "L"
				tnAlpha = 0
			ENDIF
		
			IF PCOUNT() = 2
				toImage.SetPredefColorMatrix(tnRed)
			ELSE
				toImage.SetPredefColorMatrix(tnRed, tnGreen, tnBlue, tnAlpha)
			ENDIF
		
		
			lnWidth  = toImage.nImageWidth
			lnHeight = toImage.nImageHeight
		
		
			lnSrcUnit = cnGDIPLUS_Unit_PIXEL
		
			.nGDIPStatus = GdipDrawImageRectRect(.nGDIPHandle, toImage.GetHandle() ;
				, 0, 0, lnWidth, lnHeight ;
				, 0, 0, lnWidth, lnHeight  ;
				, lnSrcUnit ;
				, toImage.nImageAttributes ;
				, 0, 0 )
		
			RETURN .ngdipStatus == cnGDIPLUS_STATUS_OK
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE changetomonochrome
		LPARAMETERS toBitmap
		
		DECLARE LONG CopyImage IN Win32API LONG hImage, LONG uType, LONG cx, LONG cy, LONG uFlags
		DECLARE LONG GdipCreateHBITMAPFromBitmap IN GDIPLUS.DLL LONG nativeImage, LONG @ hbmReturn, LONG argb
		DECLARE INTEGER DeleteObject IN gdi32 INTEGER hObject 
		
		LOCAL loBitmapToReturn
		
		LOCAL lnhReturnBmp
		LOCAL lnhCopyBitmap
		
		LOCAL llOwnsHandle
		LOCAL llReturn
		
		WITH THIS
		
			.nGDIPStatus = GdipCreateHBITMAPFromBitmap(toBitmap.GetHandle(), @lnhReturnBmp, 0xFFFFFFFF)
			
			
			IF .nGDIPStatus = cnGDIPLUS_STATUS_OK
		
				lnhCopyBitmap = CopyImage(lnhReturnBmp, 0, 0, 0, cnCOPYIMAGE_Flag_Monochrome)
			
				DeleteObject(lnhReturnBmp)
		
				IF lnhCopyBitmap <> 0 
					loBitmapToReturn = NEWOBJECT(ccGDIPLUS_CLASS_BITMAP, ADDBS(JUSTPATH(THIS.CLASSLIBRARY)) + ccGDIPLUS_CLASS_NAME)
					
					llOwnsHandle = .T.
					
					llReturn = loBitmapToReturn.CloneFromGDIBitmap1(lnhCopyBitmap, llOwnsHandle) 
		
				    DeleteObject(lnhCopyBitmap) 
				    
				ENDIF
			
			ENDIF
		
		ENDWITH
		
		RETURN loBitmapToReturn
		
		
		
	ENDPROC

	PROCEDURE clear		&& Clear entire drawing surface and fill with specified background color
	ENDPROC

	PROCEDURE createfromhdc		&& Create Graphics object for a given device context (HDC)
	ENDPROC

	PROCEDURE createfromhwnd		&& Create GDI+ Graphics object for a given window (HWND)
		LPARAMETERS tnhWND, tlICM
		
		LOCAL lnHandle
		
		WITH THIS
		
			THIS.DESTROY()
		
			lnHandle = 0
		
			IF tlICM
				DECLARE INTEGER GdipCreateFromHWNDICM IN gdiplus.DLL INTEGER HWND, INTEGER @ nGraphics
		
				THIS.nGDIPStatus = GdipCreateFromHWNDICM(tnhWND, @lnHandle)
			ELSE
				DECLARE INTEGER GdipCreateFromHWND IN gdiplus.DLL INTEGER HWND, INTEGER @ nGraphics
		
				THIS.nGDIPStatus = GdipCreateFromHWND(tnhWND, @lnHandle)
			ENDIF
		
			IF THIS.nGDIPStatus = cnGDIPLUS_STATUS_OK
				THIS.SetHandle(lnHandle, .T.)
		
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE createfromimage		&& Create graphics object from the specified GpImage object (to draw on that image's surface)
		LPARAMETERS toImage
		
		DECLARE INTEGER GdipGetImageGraphicsContext IN gdiplus.DLL INTEGER nImage, INTEGER @ nGraphics
		
		LOCAL lnHandle
		
		WITH THIS
		
			.DESTROY()
		
			lnHandle = 0
		
			.ngdipStatus = GdipGetImageGraphicsContext (toImage.GetHandle(), @lnHandle)
		
			IF .ngdipStatus = cnGDIPLUS_STATUS_OK
				.SetHandle(lnHandle, .T.)
		
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE Destroy
		WITH THIS
		
			IF .nGDIPHandle > 0 AND .lGDIPOwnsThisHandle
				DECLARE INTEGER GdipDeleteGraphics IN gdiplus.DLL INTEGER
		
				GdipDeleteGraphics(.nGDIPHandle)
		
			ENDIF
		
			.nGDIPHandle 		 = 0
			.lGDIPOwnsThisHandle = .F.
		
		ENDWITH
		
	ENDPROC

