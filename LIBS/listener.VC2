*--------------------------------------------------------------------------------------------------------------------------------------------------------
* (EN) AUTOGENERATED - ATTENTION!! - NOT INTENDED FOR EXECUTION!! USE ONLY FOR MERGING CHANGES AND STORING WITH SCM TOOLS!!
*--------------------------------------------------------------------------------------------------------------------------------------------------------
*< FOXBIN2PRG: Version="1.21" SourceFile="listener.vcx" CPID="1251" /> (Solo para binarios VFP 9 / Only for VFP 9 binaries)
*
*
DEFINE CLASS listener AS reportlistener 
 	*< CLASSDATA: Baseclass="reportlistener" Timestamp="" Scale="Pixels" Uniqueid="" />

	#INCLUDE "..\include\listener.h"
	*<DefinedPropArrayMethod>
		*m: dpi2pixel		&& Convert DPI to Pixel
		*m: getfrxrecord
		*m: getstylescursor
		*m: setcurrentdatasession
		*m: setfrxdatasession
		*m: setprogressbar
		*p: clasterrormessage
		*p: cstylescursor
		*p: lhaderror
		*p: lnewpagewasadded
		*p: lnopageeject
		*p: ncurrentpage
		*p: nscreendpi		&& Screen DPI resolution
		*p: ofrx2any
	*</DefinedPropArrayMethod>

	*<PropValue>
		cstylescursor = 
		FRXDataSession = -1
		Height = 23
		Name = "listener"
		ncurrentpage = 0
		nscreendpi = 0
		ofrx2any = .NULL.
		SendGDIPlusImage = 1
		Width = 23
	*</PropValue>
	
	PROCEDURE AfterReport
		WITH THIS
		
			WAIT CLEAR
		
			IF  !.lHadError
		
				IF (VARTYPE(.COMMANDCLAUSES) = 'O' AND  .COMMANDCLAUSES.NOPAGEEJECT)
					.lNoPageEject = .T.
		
				ELSE
					.lNoPageEject = .F.
		
					.oFRX2Any.CloseDocument()
					.oFRX2Any.OutputTo()
					.oFRX2Any.QuitApp()			
		
					IF .oFRX2Any.nExportFileType # cnPREVIEW
						.oFRX2Any = .NULL.
					ENDIF	
		
				ENDIF
			ELSE
		
				.oFRX2Any.CloseDocument()
				.oFRX2Any.OutputTo()
				.oFRX2Any.QuitApp()		
		
				IF .oFRX2Any.nExportFileType # cnPREVIEW
					.oFRX2Any = .NULL.
				ENDIF	
		
			ENDIF
		
			DODEFAULT()
		
		ENDWITH
		
	ENDPROC

	PROCEDURE BeforeBand
		LPARAMETERS tnBandObjCode, tnFRXRecno
		
		
		LOCAL loFRXRecord
		
		
		WITH THIS
		
			DO CASE
				CASE .TwoPassProcess AND .CURRENTPASS = 0
		*-- Skip first pass. Do nothing 
			
		
				CASE tnBandObjCode = cnBAND_SUMMARY_REPOBJ_CODE
				
					IF  .nCurrentPage # _PAGENO
			
						.oFRX2Any.AddPage()
		
						.nCurrentPage = .nCurrentPage + 1
					ENDIF
		
				CASE tnBandObjCode = cnBAND_TITLE_REPOBJ_CODE
		
					.lNewPageWasAdded = .T.
		
					.oFRX2Any.AddPage()
		
					.nCurrentPage = .nCurrentPage + 1
		
		
					loFRXRecord = .GetFRXRecord(tnFRXRecno)
					
				
					IF loFRXRecord.PageBreak
						.lNewPageWasAdded = .F.
		
					ENDIF
		
		
				CASE tnBandObjCode = cnBAND_PAGE_HEADER_REPOBJ_CODE
		
					IF .lNewPageWasAdded
						.lNewPageWasAdded = .F.
					ELSE
						.oFRX2Any.AddPage()
		
						.nCurrentPage = .nCurrentPage + 1
					ENDIF
			ENDCASE
		
		ENDWITH
		
		
		
		
	ENDPROC

	PROCEDURE BeforeReport
		LOCAL loFRXRecord
		
		LOCAL lnLine
		LOCAL lcLine
		
		WITH THIS
		
			IF !.lNoPageEject
		
				loFRXRecord = .GetFRXRecord(1)
		
				lnLine = ATCLINE('ORIENTATION', loFRXRecord.EXPR)
				IF lnLine > 0
					lcLine = MLINE(loFRXRecord.EXPR, lnLine)
		
					.oFRX2Any.nOrientation = VAL(GETWORDNUM(lcLine, 2, '='))
				ELSE
					.oFRX2Any.nOrientation = 0
				ENDIF
		
				lnLine = ATCLINE('PAPERSIZE', loFRXRecord.EXPR)
				IF lnLine > 0
					lcLine = MLINE(loFRXRecord.EXPR, lnLine)
		
					.oFRX2Any.nPaperSize = VAL(GETWORDNUM(lcLine, 2, '='))
				ELSE
					.oFRX2Any.nPaperSize = 1
				ENDIF
		
		
		*--Convert page size to pixels
				.oFRX2Any.nPhysicalPaperLength = .DPI2Pixel(.GETPAGEHEIGHT())
				.oFRX2Any.nPhysicalPaperWidth  = .DPI2Pixel(.GETPAGEWIDTH())
		
				IF EMPTY(.oFRX2Any.cExportFileName)
		*-- NOTE: .cExportFileName should not include file extension. For example: loFile.cExportFileName = "ReportOutput"
					.oFRX2Any.cExportFileName = JUSTSTEM(.COMMANDCLAUSES.FILE)
				ENDIF
		
				IF EMPTY(.oFRX2Any.cSaveFolder)
		*-- NOTE: .cSaveFolder should contain only path to the output file. For example: loFile.cSaveFolder = "c:\MyApp\MyOutPut\"
					.oFRX2Any.cSaveFolder     = ADDBS(JUSTPATH(.COMMANDCLAUSES.FILE))
				ENDIF
		
				.oFRX2Any.cReportPath = ADDBS(JUSTPATH(.COMMANDCLAUSES.FILE))
		
				.oFRX2Any.OpenDocument()
		
			ENDIF
			
			.SetProgressBar()	
		
			.GetStylesCursor()
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE CancelReport
		DODEFAULT()
		
		WITH THIS
			.oFRX2Any.CloseDocument()
			.oFRX2Any.QuitApp()	
			.oFRX2Any = .NULL.
		ENDWITH
		
	ENDPROC

	PROCEDURE dpi2pixel		&& Convert DPI to Pixel
		LPARAMETERS tnDPI
		
		RETURN THIS.nScreenDPI * tnDPI / 960
		
	ENDPROC

	PROCEDURE Error
		LPARAMETERS tnError, tcMethod, tnLine
		
		LOCAL lcMessage
		LOCAL lcCodeLine
		
		lcMessage = MESSAGE()
		lcCodeLine = MESSAGE(1)
		
		WITH THIS
		
		    .lHadError = .T.
		
		    .cLastErrorMessage = lcMessage;
		        + CHR(13) + CHR(13) + .NAME ;
		        + CHR(13) + 'Error :' + ALLTRIM(STR(tnError)) ;
		        + CHR(13) + 'Method:' + tcMethod ;
		        + CHR(13) + 'Line  :' + ALLTRIM(STR(tnLine)) ;
		        + CHR(13) + lcCodeLine
		
		    = MESSAGEBOX(.cLastErrorMessage, 16, 'FRX2Any')
		
		ENDWITH
		
	ENDPROC

	PROCEDURE getfrxrecord
		LPARAMETERS tnFRXRecordNumber
		
		LOCAL loFRXRecord
		
		LOCAL lnSelect
		
		WITH THIS
			.SetFRXDataSession()
		
			lnSelect = SELECT()
		
			SELECT FRX
			
			GO tnFRXRecordNumber 
			SCATTER NAME loFRXRecord MEMO
		
			SELECT (lnSelect)
			
			.SetCurrentDataSession()
		
		ENDWITH
		
		RETURN loFRXRecord
		
		
	ENDPROC

	PROCEDURE getstylescursor
		WITH THIS
		
			.cStylesCursor = SYS(2015)
		
			.SetFRXDataSession()
		
			SELECT ObjCode, ObjType, RECNO() AS FRXRecno, Platform, NAME,  ;
				EXPR, OffSet, VPos, HPos, HEIGHT, WIDTH,  ;
				STYLE, PICTURE, ORDER, COMMENT, USER,  ;
				FillChar, PenRed, PenGreen, PenBlue, FillRed,  ;
				FillGreen, FillBlue, PenSize, PenPat, FillPat,  ;
				FontFace, GENERAL, BITTEST(FontStyle, 0) AS FONTBOLD,  ;
				BITTEST(FontStyle, 1) AS FONTITALIC, BITTEST(FontStyle,  ;
				3) AS FONTUNDERLINE, BITTEST(FontStyle, 7) AS  ;
				FontStrikethrough, FontStyle, FONTSIZE, Mode,  ;
				IIF(DOUBLE, Resoid, 1) AS FONTCHARSET, UniqueID AS  ;
				ObjID, RulerLines AS TrimMode FROM FRX ORDER BY FRXRecno INTO CURSOR (.cStylesCursor)
		
			.SetCurrentDataSession()
		
		ENDWITH
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE Init
		DECLARE INTEGER GetDeviceCaps IN WIN32API INTEGER HDC, INTEGER ITEM
		DECLARE INTEGER GetDC IN WIN32API INTEGER HWND
		
		THIS.nScreenDPI = GetDeviceCaps(GetDC(0), 88)
		
		
	ENDPROC

	PROCEDURE Render
		LPARAMETERS tnFRXRecno, tnLeft, tnTop, tnWidth, tnHeight, tnObjectContinuationType, tcContentsToBeRendered, tvGDIPlusImage
		
		#DEFINE cnALIGN_LEFT                				0
		#DEFINE cnALIGN_RIGHT               				1
		#DEFINE cnALIGN_CENTER              				2
		
		
		LOCAL loStyle
		LOCAL loChart
		LOCAL loChartCurve
		
		LOCAL lcContents
		LOCAL lcPicture
		
		LOCAL llTextType
		
		LOCAL lnCount
		LOCAL lnAlignment
		
		WITH THIS
		
			IF .TWOPASSPROCESS AND .CURRENTPASS = 0
				RETURN
			ENDIF
		
			.SetFRXDataSession()
		
			GOTO tnFRXRecno IN (.cStylesCursor)
		
			SELECT (.cStylesCursor)
			SCATTER MEMO NAME loStyle
		
			.SetCurrentDataSession()
		
			tnLeft   = .DPI2Pixel(tnLeft)
			tnTop    = .DPI2Pixel(tnTop)
			tnWidth  = .DPI2Pixel(tnWidth)
			tnHeight = .DPI2Pixel(tnHeight)
		
			llTextType = INLIST(loStyle.ObjType,  cnREPOBJ_TEXT, cnREPOBJ_FIELD)
		
			IF llTextType
				lcContents = STRCONV(TRANSFORM(tcContentsToBeRendered), cnSTRCONV_UNICODE_DBCS)
			ELSE
				lcContents = TRANSFORM(tcContentsToBeRendered)
			ENDIF
		
		
			IF INLIST(tnObjectContinuationType, 2, 3) AND .nCurrentPage # _PAGENO
			
				.oFRX2Any.AddPage()
		
				.nCurrentPage = .nCurrentPage + 1
		
			ENDIF
		
		
			DO CASE
				CASE INLIST(loStyle.ObjType,  cnREPOBJ_TEXT, cnREPOBJ_FIELD)
		
					IF 	loStyle.ObjType = cnREPOBJ_TEXT
		
						lcPicture = loStyle.PICTURE
		
						DO CASE
							CASE !EMPTY(lcPicture) AND EVALUATE(lcPicture) = "@J"
								lnAlignment = cnALIGN_RIGHT
		
							CASE !EMPTY(lcPicture) AND EVALUATE(lcPicture) = "@I"
								lnAlignment = cnALIGN_CENTER
		
							OTHERWISE
								lnAlignment = cnALIGN_LEFT
		
						ENDCASE
		
		
					ELSE
						lnAlignment = loStyle.Offset
		
					ENDIF
		
		
					.oFRX2Any.RenderText(lcContents, ;
						loStyle.FontFace, ;
						loStyle.FONTBOLD, ;
						loStyle.FONTITALIC, ;
						loStyle.FONTUNDERLINE, ;
						loStyle.FontStrikethrough, ;
						loStyle.FONTSIZE, ;
						tnLeft, ;
						tnTop, ;
						tnWidth, ;
						tnHeight, ;
						lnAlignment, ;
						loStyle.Mode , ;
						loStyle.TrimMode, ;
						IIF(loStyle.PenRed = -1, -1, RGB(loStyle.PenRed, loStyle.PenGreen, loStyle.PenBlue)), ;
						IIF(loStyle.FillRed = -1, -1, RGB(loStyle.FillRed, loStyle.FillGreen, loStyle.FillBlue)), ;
						loStyle.ObjType,;
						loStyle.Comment)
						
		
				CASE loStyle.ObjType = cnREPOBJ_LINE
		
					.oFRX2Any.RenderLine(tnLeft, ;
						tnTop, ;
						tnWidth, ;
						tnHeight, ;
						loStyle.PenSize, ;
						IIF(loStyle.PenRed = -1, -1, RGB(loStyle.PenRed, loStyle.PenGreen, loStyle.PenBlue)), ;
						loStyle.PenPat,;
						loStyle.Offset)
		
				CASE loStyle.ObjType = cnREPOBJ_BOX
		
					loChart = .oFRX2Any.GetChart(loStyle)
		
					IF !ISNULL(loChart)
		
						WITH loChart
		
		*-- Specify Chart's properties
		*-- For description of all Chart's properties and methods, please see FRX2Any help file.
							WITH .oPanel
		*-- Make up some random data points
								DIMENSION laY[8]
		
								FOR lnCount = 8 TO 1 STEP -1
									laY[lnCount]  = tnHeight * RAND()
								ENDFOR
		
								DIMENSION laX[8]
		
								laX[1]  = 1998
								laX[2]  = 1999
								laX[3]  = 2000
								laX[4]  = 2001
								laX[5]  = 2002
								laX[6]  = 2003
								laX[7]  = 2004
								laX[8]  = 2005
		
		*-- Generate a red bar with 'Sales' label in the Legend.
								loChartCurve = .AddBar('Sales', @laX, @laY, RGB(255, 0 , 0))
		
							ENDWITH
		
						ENDWITH
		
						.oFRX2Any.RenderChart(loChart, tnLeft, tnTop, tnWidth, tnHeight)
		
					ELSE
		
		
						.oFRX2Any.RenderBox(tnLeft, ;
							tnTop, ;
							tnWidth, ;
							tnHeight, ;
							loStyle.PenSize, ;
							IIF(loStyle.PenRed = -1, -1, RGB(loStyle.PenRed, loStyle.PenGreen, loStyle.PenBlue)), ;
							loStyle.PenPat,;
							loStyle.Mode , ;
							IIF(loStyle.FillRed = -1, -1, RGB(loStyle.FillRed, loStyle.FillGreen, loStyle.FillBlue)), ;
							IIF(loStyle.FillRed = -1, -1, RGB(loStyle.FillRed, loStyle.FillGreen, loStyle.FillBlue)), ;
							loStyle.FillPat, ;
							loStyle.Offset,;
							loStyle.Comment)
		
					ENDIF
		
				CASE loStyle.ObjType = cnREPOBJ_IMAGE
		
					.oFRX2Any.RenderImage(lcContents, tnLeft, tnTop, tnWidth, tnHeight, loStyle.GENERAL, tvGDIPlusImage, loStyle.Comment)
		
			ENDCASE
		
		
		*-- Progres bar
			IF INLIST(loStyle.ObjType, cnREPOBJ_TEXT, cnREPOBJ_FIELD, cnREPOBJ_IMAGE, cnREPOBJ_BOX, cnREPOBJ_LINE)
				.oFRX2Any.nTotalProcessedItems = .oFRX2Any.nTotalProcessedItems + 1
		
				.oFRX2Any.nPercentage   = ROUND((.oFRX2Any.nTotalProcessedItems/.oFRX2Any.nTotalOutputItems)*100, 2)
				
			ENDIF
			
			
		ENDWITH
		
		
		
		
		
		
	ENDPROC

	PROCEDURE setcurrentdatasession
		WITH THIS
		
			IF (.CURRENTDATASESSION # SET("DATASESSION"))
				TRY
					SET DATASESSION TO (.CURRENTDATASESSION)
				CATCH WHEN .T.
					.RESETTODEFAULT("CurrentDataSession")
				ENDTRY
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE setfrxdatasession
		WITH THIS
		
			IF (.FRXDATASESSION > -1) AND (.FRXDATASESSION # SET("DATASESSION"))
		
				TRY
					SET DATASESSION TO (.FRXDATASESSION)
				CATCH WHEN .T.
					.RESETTODEFAULT("FRXDataSession")
				ENDTRY
		
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE setprogressbar
		LOCAL lnTotalReportItems
		LOCAL lnTotalDataRecords
		
		WITH THIS
		
			.SetFRXDataSession()
		
			lnTotalReportItems = RECCOUNT()
		
			.SetCurrentDataSession()
		
			lnTotalDataRecords = RECCOUNT()	
			
			.oFRX2Any.nTotalOutputItems = lnTotalDataRecords * lnTotalReportItems 
		
			.oFRX2Any.nTotalProcessedItems = 0
		
		ENDWITH
		
		
		
	ENDPROC

ENDDEFINE
