			TrackMess(cUserTrack)
		**
			cSQL = "INSERT INTO dbo.GFMlog "
			cSQL = cSQL + "(AlloyName, [Date], Heat, Lot"
			cSQL = cSQL + ",Spiece,Fpiece,Ssize,GFMsize,Slength,[Fsize],Sweight,Flength"
			cSQL = cSQL + ",Condition,ColdWork,Spec,HTreat,SalesNum,ItemSO,SOitem"
			cSQL = cSQL + ",OvenTemp,PO,Notes,SrvcPO,TestPO,TestItemPO,TestPoItem,TestSent,Lab"
			cSQL = cSQL + ",[Minutes]"   &&,GFMp,Ovenp,CGp"
			cSQL = cSQL + ",Tensile,Yield,Elongation,Red_Area,Rockwell,BHN,tLoc"
