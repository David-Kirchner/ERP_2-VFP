	PROCEDURE checksave
		*ThisForm.CheckSave()
		PRIVATE nLot, cAlloyName, cLotAlloy, nID
		nLot		= PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		cAlloyName	= PrepareSQLtxt(ThisForm.txtAlloyName.Value,'AlloyName',12)
		nID			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		IF nID = 0
			*Add
			IF nLot > 0
				*Check Alloy
				cLotAlloy = GetAlloyName_fromLot(nLot,"G",ThisForm.nConnHandle)
				cLotAlloy = PrepareSQLtxt(cLotAlloy,'AlloyName',12)
				IF cAlloyName != cLotAlloy 
					MESSAGEBOX("This Lot:"+ALLTRIM(STR(nLot))+" for Alloy:'"+ALLTRIM(cLotAlloy)+"'."+CHR(13)+"This LOT cannot be saved with alloy name of '"+ALLTRIM(cAlloyName)+"'.",0+16,"Cannot have different Alloys on same LOT Number!")
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			*Update!	
		ENDIF
		
		
		***** Test PO
		PRIVATE nSrvcPO, cLab
		nSrvcPO		= PrepareSQLnum(ThisForm.txtSrvcPO.Value,'SrvcPO',-3)
		*nTestPO		= PrepareSQLnum(ThisForm.txtTestPO.Value,'TestPO',-3)
		*nTestitemPO	= PrepareSQLnum(ThisForm.txtTestItemPO.Value,'TestItemPO',2,0)
		cLab	= PrepareSQLtxt(ThisForm.txtLab.Value,'Lab',12)
		
		IF nSrvcPO > 0
			IF Count_HPAPOinPurchaseOrder(nSrvcPO, ThisForm.nConnHandle) = 0
				MESSAGEBOX("Srvc PO:"+ALLTRIM(STR(nSrvcPO))+" was not found."+CHR(13)+"Change Test PO.",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		
		***
		PRIVATE cTestPOitem
		*Check for POitem
		cTestPOitem	= PrepareSQLtxt(ThisForm.txtTestPOitem.Value,'POitem',12)
		
		IF VAL(cTestPOitem) > 0
			IF VAL(RIGHT(cTestPOitem,2)) = 0
				*No Item!  from old days
				*use Item 1
				cTestPOitem = STUFF(cTestPOitem, 12, 1, '1')
			ENDIF
		ENDIF
		
		IF Proper_PO_Item(cTestPOitem) != Proper_PO_Item('')
			*Only check POitem if entered
			IF Count_POIteminPurchaseOrder( cTestPOitem, ThisForm.nConnHandle) = 0
				MESSAGEBOX("Test POitem:"+ALLTRIM(cTestPOitem)+" was not found."+CHR(13)+"Change Test PO or item.",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE cLab, dOrderDate 
		cLab = PrepareSQLtxt(ThisForm.txtLab.Value,'Company',12)
		dOrderDate = PrepareSQLdate(ThisForm.txtTestsent.Value,'TestSent')
		
		IF Proper_PO_Item(cTestPOitem) != Proper_PO_Item('') AND ( EMPTY(cLab) OR EMPTY(dOrderDate) )
			IF USED('tmpCompanyPO')
				USE IN tmpCompanyPO
			ENDIF
			SELECT 0
		
		
			cSQL = "SELECT Company,OrderDate FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE HPApo = "+STR(VAL(cTestPOitem))
		
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCompanyPO' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCompanyPO' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCompanyPO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCompanyPO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpCompanyPO' )
			ENDIF
			
			
			IF USED('tmpCompanyPO')
				IF RECCOUNT('tmpCompanyPO') > 0
					IF NOT EMPTY(tmpCompanyPO.Company)
						ThisForm.txtLab.Value = tmpCompanyPO.Company
					ENDIF
					ThisForm.txtTestSent.Value = PrepareSQLdate(tmpCompanyPO.OrderDate,'OrderDate')
				ENDIF
				USE IN tmpCompanyPO
			ENDIF
				
		ENDIF
		
		
		
		******************
		PRIVATE ctLoc1, ctLoc2, ctLoc3, ctLoc4, ctLoc5, ctLoc6, ctLoc7
		ctLoc1	= PrepareSQLtxt(ThisForm.txttLoc.Value,'tLoc',1)
		ctLoc2	= PrepareSQLtxt(ThisForm.txttLoc2.Value,'tLoc',1)
		ctLoc3	= PrepareSQLtxt(ThisForm.txttLoc3.Value,'tLoc',1)
		ctLoc4	= PrepareSQLtxt(ThisForm.txttLoc4.Value,'tLoc',1)
		ctLoc5	= PrepareSQLtxt(ThisForm.txttLoc5.Value,'tLoc',1)
		ctLoc6	= PrepareSQLtxt(ThisForm.txttLoc6.Value,'tLoc',1)
		ctLoc7	= PrepareSQLtxt(ThisForm.txttLoc7.Value,'tLoc',1)
		
		IF NOT EMPTY(ctLoc1)
			*Must be C M O
			IF UPPER(ctLoc1) = "C" OR UPPER(ctLoc1) = "M" OR UPPER(ctLoc1) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 1 is entered as:"+ctLoc1+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 1 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc2)
			*Must be C M O
			IF UPPER(ctLoc2) = "C" OR UPPER(ctLoc2) = "M" OR UPPER(ctLoc2) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 2 is entered as:"+ctLoc2+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 2 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc3)
			*Must be C M O
			IF UPPER(ctLoc3) = "C" OR UPPER(ctLoc3) = "M" OR UPPER(ctLoc3) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 3 is entered as:"+ctLoc3+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 3 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc4)
			*Must be C M O
			IF UPPER(ctLoc4) = "C" OR UPPER(ctLoc4) = "M" OR UPPER(ctLoc4) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 4 is entered as:"+ctLoc4+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 4 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc5)
			*Must be C M O
			IF UPPER(ctLoc5) = "C" OR UPPER(ctLoc5) = "M" OR UPPER(ctLoc5) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 5 is entered as:"+ctLoc5+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 5 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc6)
			*Must be C M O
			IF UPPER(ctLoc6) = "C" OR UPPER(ctLoc5) = "M" OR UPPER(ctLoc5) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 6 is entered as:"+ctLoc6+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 6 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		IF NOT EMPTY(ctLoc7)
			*Must be C M O
			IF UPPER(ctLoc7) = "C" OR UPPER(ctLoc7) = "M" OR UPPER(ctLoc7) = "O" 
				*Good data
			ELSE
				MESSAGEBOX("Test Location 7 is entered as:"+ctLoc5+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 7 to a space or acceptable leter.",0,+"Cannot Save!")
				RETURN .F.	
			ENDIF
		ENDIF
		********************************
		
		PRIVATE nTensile1,nYield1,nTensile2,nYield2,nTensile3,nYield3
		nTensile1	= PrepareSQLnum(ThisForm.txtTensile.Value,'Tensile',6,0)
		nYield1		= PrepareSQLnum(ThisForm.txtYield.Value,'Yield',6,0)
		nTensile2	= PrepareSQLnum(ThisForm.txtTensile2.Value,'Tensile',6,0)
		nYield2		= PrepareSQLnum(ThisForm.txtYield2.Value,'Yield',6,0)
		nTensile3	= PrepareSQLnum(ThisForm.txtTensile3.Value,'Tensile',6,0)
		nYield3		= PrepareSQLnum(ThisForm.txtYield3.Value,'Yield',6,0)
		
		PRIVATE nTensile4,nYield4,nTensile5,nYield5
		nTensile4	= PrepareSQLnum(ThisForm.txtTensile4.Value,'Tensile',6,0)
		nYield4		= PrepareSQLnum(ThisForm.txtYield4.Value,'Yield',6,0)
		nTensile5	= PrepareSQLnum(ThisForm.txtTensile5.Value,'Tensile',6,0)
		nYield5		= PrepareSQLnum(ThisForm.txtYield5.Value,'Yield',6,0)
		
		PRIVATE nTensile6,nYield6,nTensile7,nYield7
		nTensile6	= PrepareSQLnum(ThisForm.txtTensile6.Value,'Tensile',6,0)
		nYield6		= PrepareSQLnum(ThisForm.txtYield6.Value,'Yield',6,0)
		nTensile7	= PrepareSQLnum(ThisForm.txtTensile7.Value,'Tensile',6,0)
		nYield7		= PrepareSQLnum(ThisForm.txtYield7.Value,'Yield',6,0)
		
		**********************
		IF nTensile4+nYield4 >0
			IF NOT ( UPPER(ctLoc4) = "C" OR UPPER(ctLoc4) = "M" OR UPPER(ctLoc4) = "O" )
				MESSAGEBOX("Test Location 4 is entered as:'"+ctLoc5+"'"+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 4 to an acceptable leter."+CHR(13)+"Location is required on Test 4,5,6 and 7",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		IF nTensile5+nYield5 >0
			IF NOT ( UPPER(ctLoc5) = "C" OR UPPER(ctLoc5) = "M" OR UPPER(ctLoc5) = "O" )
				MESSAGEBOX("Test Location 5 is entered as:'"+ctLoc5+"'"+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 5 to an acceptable leter."+CHR(13)+"Location is required on Test 4,5,6 and 7",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		IF nTensile6+nYield6 >0
			IF NOT ( UPPER(ctLoc6) = "C" OR UPPER(ctLoc6) = "M" OR UPPER(ctLoc6) = "O" )
				MESSAGEBOX("Test Location 6 is entered as:'"+ctLoc6+"'"+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 6 to an acceptable leter."+CHR(13)+"Location is required on Test 4,5,6 and 7",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		IF nTensile7+nYield7 >0
			IF NOT ( UPPER(ctLoc7) = "C" OR UPPER(ctLoc7) = "M" OR UPPER(ctLoc7) = "O" )
				MESSAGEBOX("Test Location 7 is entered as:'"+ctLoc7+"'"+CHR(13)+"The acceptable values are C,M,O"+CHR(13)+"Change Test Location 7 to an acceptable leter."+CHR(13)+"Location is required on Test 4,5,6 and 7",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		**********************
		IF nTensile1 < nYield1
			MESSAGEBOX("Test 1"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile1))+" is LESS than Yield "+ALLTRIM(STR(nYield1))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile2 < nYield2
			MESSAGEBOX("Test 2"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile2))+" is LESS than Yield "+ALLTRIM(STR(nYield2))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile3 < nYield3
			MESSAGEBOX("Test 3"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile3))+" is LESS than Yield "+ALLTRIM(STR(nYield3))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile4 < nYield4
			MESSAGEBOX("Test 4"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile4))+" is LESS than Yield "+ALLTRIM(STR(nYield4))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile5 < nYield5
			MESSAGEBOX("Test 5"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile5))+" is LESS than Yield "+ALLTRIM(STR(nYield5))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile6 < nYield6
			MESSAGEBOX("Test 6"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile6))+" is LESS than Yield "+ALLTRIM(STR(nYield6))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		IF nTensile7 < nYield7
			MESSAGEBOX("Test 7"+CHR(13)+"Tensile "+ALLTRIM(STR(nTensile7))+" is LESS than Yield "+ALLTRIM(STR(nYield7))+CHR(13)+"Check for type error",16,+"Cannot Save!")
			RETURN .F.
		ENDIF
		
		********************************
		
		RETURN .T.
	ENDPROC

	PROCEDURE Destroy
		IF USED('GFMlog')
			USE IN GFMLog
		ENDIF
		
		IF USED('GFMLabs')
			USE IN GFMlabs
		ENDIF
		
		*!*	IF ThisForm.OpenedERPCert AND DBUSED('ERPCert')
		*!*		SET DATABASE TO ERPCert
		*!*		CLOSE DATABASES 
		*!*	ENDIF
		
		IF WEXIST("frmLog_Detail")
			RELEASE WINDOWS frmLog_Detail
		ENDIF
		
		IF ThisForm.lOpenShip AND USED('Ship')
			USE IN Ship
		ENDIF
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE duplots		&& Count the number of within this lot
		*ThisForm.DupLots()
		
		
		PRIVATE nLot
		*nLot = GFMlog.Lot
		nLot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpCountLot')	
			USE IN tmpCountLot
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.GFMLog WHERE LOT ="+ALLTRIM(STR(nLot))
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
		ELSE
			IF USED('tmpCountLot')
		*		IF tmpCountLot.Cntd > 0
					ThisForm.Lots.Caption = ALLTRIM(STR(tmpCountLot.Cntd))
		*		ENDIF
				USE IN tmpCountLot 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getallrecords
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('GFMLog')	
			USE IN GFMLog
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.GFMLog ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'GFMLog')
			RETURN .F.
		ELSE
			*MESSAGEBOX("All records are now loaded",0+64,"See All GFMlog records!")
			WAIT WINDOW 'Loading All records' NOWAIT
			SELECT GFMLog
			INDEX ON LOT TAG LOT
			SET ORDER TO TAG LOT
			ThisForm.lSeeAll = .T.
			WAIT CLEAR
		ENDIF
		
		RETURN .T.
	ENDPROC

