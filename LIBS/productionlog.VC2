	PROCEDURE txtROLLsize.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE txtSalesnum.Valid
		SELECT LakeErie_log
		PRIVATE nSalesNum,nItemSO
		nSalesNum = This.Value
		nItemSO = ThisForm.txtItemSO.Value
		
		IF nSalesNum > 0 AND nItemSO > 0
			SELECT LakeErie_log
			REPLACE SOItem WITH Proper_So_Item( STR(nSalesNum)+"-"+ STR(nItemSO) )
		ENDIF
	ENDPROC

	PROCEDURE txtSalesnum.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE txtShipdate.Refresh
		This.Visible = !EMPTY(This.Value)
	ENDPROC

	PROCEDURE txtSlength.When
		RETURN ThisForm.isediting
	ENDPROC

