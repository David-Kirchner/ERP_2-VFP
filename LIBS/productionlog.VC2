	PROCEDURE cmdSO.Valid
		PRIVATE cSOitem, nSalesNum, nItemSO
		nSalesNum	= ThisForm.txtSalesNum.Value
		nItemSO		= ThisForm.txtItemSO.Value
		
		cSOitem = Proper_SO_Item( STR(nSalesNum)+"-"+STR(nItemSO) )
		IF NOT EMPTY('cSOitem')
			DO FORM Forms\ShowvSOitem WITH cSOitem
		ENDIF
		Return
		
		*!*	PRIVATE m.psalesnum, M.CREC
		*!*	m.CREC = RECNO()
		*!*	  IF NOT USED('INQSOLD')
		*!*	    SELECT 0
		*!*	    USE  HPA!inqsold NOUPDATE shared
		*!*	  ELSE
		*!*	    SELECT inqsold
		*!*	  ENDIF
		*!*	  IF USED('INQSOLD')
		*!*	    &&may be locked by another
		*!*	    SELECT gfmlog
		*!*	    GO TOP
		*!*	    DO WHILE NOT EOF()
		*!*	      IF gfmlog.salesnum > 0 
		*!*	      *AND EMPTY(gfmlog.company)
		*!*	      *IF gfmlog.salesnum > 0
		*!*	        m.psalesnum = gfmlog.salesnum
		
		*!*	        SELECT inqsold
		
		*!*	        LOCATE FOR salesnum = gfmlog.salesnum
		*!*	        IF FOUND()
		*!*	          m.company  = inqsold.company
		*!*	          m.shipped  = inqsold.shipped
		*!*	          m.shipdate = inqsold.shipdate
		*!*	          m.SALESP   = inqsold.salesp
		*!*	          M.PO_NUM   = INQSOLD.PO_NUM
		*!*	          M.SALEDATE = INQSOLD.SALEDATE
		
		*!*	          SELECT gfmlog
		*!*	          SHOW GETS
		*!*	          REPLACE gfmlog.company  WITH m.company
		*!*	          REPLACE gfmlog.shipped  WITH m.shipped
		*!*	          REPLACE gfmlog.shipdate WITH m.shipdate
		*!*	          REPLACE gfmlog.SALESP   WITH m.SALESP
		*!*	          REPLACE gfmlog.PO_NUM   WITH M.PO_NUM
		*!*	          REPLACE gfmlog.SALEDATE WITH M.SALEDATE
		*!*	        ELSE
		*!*	          WAIT WINDOW 'DID NOT FIND SALES NUMBER'+STR(m.psalesnum) NOWAIT
		*!*	        ENDIF
		*!*	      ELSE
		*!*	        *WAIT WINDOW 'NO SALES NUMBER!!' NOWAIT
		*!*	        IF gfmlog.salesnum = 0 AND NOT EMPTY(gfmlog.company)
		*!*	          SELECT gfmlog
		*!*	          REPLACE gfmlog.company  WITH ""
		*!*	          REPLACE gfmlog.shipped  WITH .F.
		*!*	          REPLACE gfmlog.shipdate WITH CTOD("  /  /  ")
		*!*	          REPLACE gfmlog.SALESP   WITH " "
		*!*	        ENDIF
		*!*	      ENDIF
		*!*	      SELECT gfmlog
		*!*	      SKIP
		*!*	    ENDDO
		*!*	  ELSE
		*!*	    WAIT WINDOW 'COULD NOT OPEN INQSOLD' NOWAIT
		*!*	  ENDIF
		
		
		*!*	IF USED('INQSOLD')
		*!*	  USE IN Inqsold
		*!*	ENDIF
		*!*	SELECT gfmlog
		
		*!*	GOTO M.CREC
		*!*	ThisForm.Refresh
	ENDPROC

