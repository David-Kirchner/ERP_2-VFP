	PROCEDURE Init
		PARAMETERS pLot
		*DO FORM Forms\GFMlog WITH nLot
		
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('GFMLog')	
			USE IN GFMLog
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.GFMLog WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'GFMLog')
			RETURN
		ELSE
			*Code is also used in RefreshReceiving and Reload
			SELECT GFMLog
			INDEX ON LOT TAG LOT
		ENDIF
		SET ORDER TO TAG LOT
		
		
		
		SELECT GFMlog
		*pCurRec = MIN( Recno(),RECCOUNT() )
		*SET ORDER TO TAG Lot
		
		GO BOTTOM
		
		IF VARTYPE(pLot) = 'N'
			IF pLot > 0
				LOCATE FOR Lot = pLot
				IF NOT FOUND()
					GO BOTTOM
				ENDIF
			ENDIF
		ENDIF
		
		
		ThisForm.spnSpnlot.Value = GFMLog.Lot
		ThisForm.RefreshGFMlog()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 1
			*try again
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
	ENDPROC

	PROCEDURE loadgfmlabs		&& Used in InteractiveChange of Lab
		PRIVATE cSQL, nSQLEXEC
		*LoadGFMLab()
		
		cSQL = "SELECT DISTINCT [LAB] FROM dbo.GFMlog WITH(NOLOCK) ORDER BY Lab "
		
		IF USED("GFMLabs")
			SELECT GFMLabs
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLabs')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLabs')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLabs")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLabs")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'GFMLabs')
		ENDIF
		
		
		IF USED("GFMLabs")
			SELECT GFMlabs
			INDEX ON UPPER(LAB) TAG UppLAB
		ENDIF
		
	ENDPROC

	PROCEDURE loadlog
		PARAMETERS pID
		*ThisForm.LoadLog(ID)
		
		
		IF VARTYPE(pID)!="N"
			pID = 0
		ENDIF
		
		IF USED('GFMLog')	
			USE IN GFMLog
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.GFMLog WITH(NOLOCK) WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLog")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'GFMLog')
			RETURN
		ELSE
			SELECT GFMLog
			INDEX ON LOT TAG LOT
			SET ORDER TO TAG LOT
			ThisForm.lSeeAll = .F.
		ENDIF
		
		IF pID = 0
			GO BOTTOM
		ELSE
			LOCATE FOR ID = pID
		ENDIF
		
		ThisForm.RefreshGFMlog()
	ENDPROC

	PROCEDURE lothighvalue		&& Returns the highest Lot number for Lot spinner.
		
		PRIVATE nMaxLot 
		nMaxLot = 0
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpMaxLot')	
			USE IN tmpMaxLot
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT MAX(LOT) AS MaxLot FROM dbo.GFMLog "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMaxLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMaxLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMaxLot')
		ELSE
			IF USED('tmpMaxLot')
				nMaxLot = tmpMaxLot.MaxLot
				USE IN tmpMaxLot
				RETURN nMaxLot
			ENDIF
		ENDIF
		 
	ENDPROC

	PROCEDURE refreshgfmlog		&& Prints Screen
		*ThisForm.RefreshGFMlog()
		SELECT GFMLog
		
		**Edits here also need to be done in GetLatestData()
		ThisForm.txtAlloyName.Value = GFMLog.AlloyName
		ThisForm.txtDate.Value 		= TTOD(GFMLog.Date)
		ThisForm.txtHeat.Value 		= GFMLog.Heat
		ThisForm.txtLot.Value 		= GFMLog.Lot
		ThisForm.txtSpiece.Value 	= GFMLog.sPiece
		ThisForm.txtFpiece.Value 	= GFMLog.fPiece
		ThisForm.txtSsize.Value 	= GFMLog.sSize
		ThisForm.txtGFMSize.Value 	= GFMLog.GFMSize
		ThisForm.txtSlength.Value 	= GFMLog.sLength
		ThisForm.txtFsize.Value 	= GFMLog.fSize
		ThisForm.txtSweight.Value 	= GFMLog.sWeight
		ThisForm.txtFlength.Value 	= GFMLog.fLength
		ThisForm.txtCondition.Value = GFMLog.Condition
		ThisForm.txtColdWork.Value 	= GFMLog.ColdWork
		ThisForm.txtSpec.Value 		= GFMLog.Spec
		ThisForm.txtHTreat.Value 	= GFMLog.Htreat
		ThisForm.txtSalesNum.Value 	= GFMLog.SalesNum
		ThisForm.txtItemSO.Value 	= GFMLog.ItemSO
		ThisForm.txtOvenTemp.Value 	= GFMLog.OvenTemp
		ThisForm.txtPO.Value 		= GFMLog.PO
		ThisForm.txtWO_Detail.Value = GFMLog.WO_Detail
		ThisForm.txtProjID.Value	= GFMlog.ProjID
		ThisForm.edtNotes.Value 	= GFMLog.Notes
		ThisForm.txtSrvcPO.Value 	= GFMLog.SrvcPO
		*ThisForm.txtTestPO.Value 	= GFMLog.TestPO
		*ThisForm.txtTestPoItem.Value= GFMLog.TestPOitem
		ThisForm.txtTestPO.Value	= VAL(FixPOitem(GFMLog.TestPO, GFMLog.TestItemPO, GFMLog.TestPOitem))
		ThisForm.txtTestItemPO.Value= PrepareSQLnum(GFMLog.TestItemPO,'ItemPO',2,0)
		IF Proper_PO_item(GFMLog.TestPOitem) != Proper_PO_item('')
			ThisForm.txtTestPoItem.Value= ShowSQLtxt(GFMLog.TestPOitem,'POitem',12)
			
			IF ThisForm.txtTestPO.Value > 0
				IF ThisForm.txtTestItemPO.Value = 0
					ThisForm.txtTestItemPO.Value = VAL(RIGHT(GFMLog.TestPOitem,2))
				ENDIF
			ENDIF
		ELSE
			IF ThisForm.txtTestPO.Value > 0
				IF ThisForm.txtTestItemPO.Value = 0
					ThisForm.txtTestItemPO.Value = VAL(RIGHT(GFMLog.TestPOitem,2))
				ENDIF
				ThisForm.txtTestPoItem.Value = FixPOitem(GFMLog.TestPO, GFMLog.TestItemPO, GFMLog.TestPOitem)
			ELSE
				ThisForm.txtTestPoItem.Value = ''
			ENDIF
		ENDIF
					
		ThisForm.txtTestSent.Value 	= IIF(GFMLog.TestSent=CTOD('12/30/1899'), CTOD("  /  /  "),TTOD(GFMLog.TestSent))
		ThisForm.txtLab.Value		= GFMLog.Lab
		ThisForm.txtMinutes.Value 	= GFMLog.Minutes
		ThisForm.cmbMachine.Value	= GFMLog.Machine
		*ThisForm.txtGFMp.Value 		= GFMLog.GFMp
		*ThisForm.txtOvenp.Value 	= GFMLog.Ovenp
		*ThisForm.txtCGp.Value 		= GFMLog.CGp
		
		ThisForm.txtTensile.Value 	= PrepareSQLnum(GFMLog.Tensile,'Tensile',6,0)
		ThisForm.txtYield.Value 	= PrepareSQLnum(GFMLog.Yield,'Yield',6,0)
		ThisForm.txtElongation.Value= PrepareSQLnum(GFMLog.Elongation,'Elongation',4,1)
		ThisForm.txtRed_area.Value 	= PrepareSQLnum(GFMLog.Red_Area,'Red_Area',4,1)
		ThisForm.txtRockwell.Value 	= PrepareSQLtxt(GFMLog.Rockwell,'Rockwell',4)
		ThisForm.txtBHN.Value 		= PrepareSQLnum(GFMLog.BHN,'BHN',3,0)
		ThisForm.txttLoc.Value 		= PrepareSQLtxt(GFMLog.tLoc,'tLoc',1)
		
		ThisForm.txtTensile2.Value 		= PrepareSQLnum(GFMLog.Tensile2,'Tensile',6,0)
		ThisForm.txtYield2.Value 		= PrepareSQLnum(GFMLog.Yield2,'Yield',6,0)
		ThisForm.txtElongation2.Value	= PrepareSQLnum(GFMLog.Elongation2,'Elongation',4,1)
		ThisForm.txtRed_area2.Value 	= PrepareSQLnum(GFMLog.Red_Area2,'Red_Area',4,1)
		ThisForm.txtRockwell2.Value 	= PrepareSQLtxt(GFMLog.Rockwell2,'Rockwell',4)
		ThisForm.txtBHN2.Value 			= PrepareSQLnum(GFMLog.BHN2,'BHN',3,0)
		ThisForm.txttLoc2.Value 		= PrepareSQLtxt(GFMLog.tLoc2,'tLoc',1)
		
		ThisForm.txtTensile3.Value 		= PrepareSQLnum(GFMLog.Tensile3,'Tensile',6,0)
		ThisForm.txtYield3.Value 		= PrepareSQLnum(GFMLog.Yield3,'Yield',6,0)
		ThisForm.txtElongation3.Value	= PrepareSQLnum(GFMLog.Elongation3,'Elongation',4,1)
		ThisForm.txtRed_area3.Value 	= PrepareSQLnum(GFMLog.Red_Area3,'Red_Area',4,1)
		ThisForm.txtRockwell3.Value 	= PrepareSQLtxt(GFMLog.Rockwell3,'Rockwell',4)
		ThisForm.txtBHN3.Value 			= PrepareSQLnum(GFMLog.BHN3,'BHN',3,0)
		ThisForm.txttLoc3.Value 		= PrepareSQLtxt(GFMLog.tLoc3,'tLoc',1)
		
		ThisForm.txtTensile4.Value 		= PrepareSQLnum(GFMLog.Tensile4,'Tensile',6,0)
		ThisForm.txtYield4.Value 		= PrepareSQLnum(GFMLog.Yield4,'Yield',6,0)
		ThisForm.txtElongation4.Value	= PrepareSQLnum(GFMLog.Elongation4,'Elongation',4,1)
		ThisForm.txtRed_area4.Value 	= PrepareSQLnum(GFMLog.Red_Area4,'Red_Area',4,1)
		*ThisForm.txtRockwell4.Value 	= PrepareSQLtxt(GFMLog.Rockwell4,'Rockwell',4)
		*ThisForm.txtBHN4.Value 			= PrepareSQLnum(GFMLog.BHN4,'BHN',3,0)
		ThisForm.txttLoc4.Value 		= PrepareSQLtxt(GFMLog.tLoc4,'tLoc',1)
		
		ThisForm.txtTensile5.Value 		= PrepareSQLnum(GFMLog.Tensile5,'Tensile',6,0)
		ThisForm.txtYield5.Value 		= PrepareSQLnum(GFMLog.Yield5,'Yield',6,0)
		ThisForm.txtElongation5.Value	= PrepareSQLnum(GFMLog.Elongation5,'Elongation',4,1)
		ThisForm.txtRed_area5.Value 	= PrepareSQLnum(GFMLog.Red_Area5,'Red_Area',4,1)
		*ThisForm.txtRockwell5.Value 	= PrepareSQLtxt(GFMLog.Rockwell5,'Rockwell',4)
		*ThisForm.txtBHN5.Value 			= PrepareSQLnum(GFMLog.BHN5,'BHN',3,0)
		ThisForm.txttLoc5.Value 		= PrepareSQLtxt(GFMLog.tLoc5,'tLoc',1)
		
		ThisForm.txtTensile6.Value 		= PrepareSQLnum(GFMLog.Tensile6,'Tensile',6,0)
		ThisForm.txtYield6.Value 		= PrepareSQLnum(GFMLog.Yield6,'Yield',6,0)
		ThisForm.txtElongation6.Value	= PrepareSQLnum(GFMLog.Elongation6,'Elongation',4,1)
		ThisForm.txtRed_area6.Value 	= PrepareSQLnum(GFMLog.Red_Area6,'Red_Area',4,1)
		*ThisForm.txtRockwell6.Value 	= PrepareSQLtxt(GFMLog.Rockwell5,'Rockwell',4)
		*ThisForm.txtBHN6.Value 			= PrepareSQLnum(GFMLog.BHN5,'BHN',3,0)
		ThisForm.txttLoc6.Value 		= PrepareSQLtxt(GFMLog.tLoc6,'tLoc',1)
		
		ThisForm.txtTensile7.Value 		= PrepareSQLnum(GFMLog.Tensile7,'Tensile',6,0)
		ThisForm.txtYield7.Value 		= PrepareSQLnum(GFMLog.Yield7,'Yield',6,0)
		ThisForm.txtElongation7.Value	= PrepareSQLnum(GFMLog.Elongation7,'Elongation',4,1)
		ThisForm.txtRed_area7.Value 	= PrepareSQLnum(GFMLog.Red_Area7,'Red_Area',4,1)
		*ThisForm.txtRockwell7.Value 	= PrepareSQLtxt(GFMLog.Rockwell7,'Rockwell',4)
		*ThisForm.txtBHN7.Value 			= PrepareSQLnum(GFMLog.BHN7,'BHN',3,0)
		ThisForm.txttLoc7.Value 		= PrepareSQLtxt(GFMLog.tLoc7,'tLoc',1)
		
		ThisForm.txtAC_ID.Value			= PrepareSQLnum(GFMlog.AC_ID,'AC_ID',-3)
		
		ThisForm.chkPassed.Value 		= IIF(ISNULL(GFMLog.Passed),.F.,GFMLog.Passed)
		ThisForm.chkCustomerMat.Value 	= IIF(ISNULL(GFMLog.CustomerMat),.F.,GFMLog.CustomerMat)
		ThisForm.chkChart.Value 		= IIF(ISNULL(GFMLog.Chart),.F.,GFMLog.Chart)
		ThisForm.txtHTRockwell.Value 	= IIF(ISNULL(GFMLog.HTRockwell),'',GFMLog.HTRockwell)
		ThisForm.txtHTBHN.Value 		= IIF(ISNULL(GFMLog.HTBHN),0,GFMLog.HTBHN)
		ThisForm.txtID.Value			= GFMLog.ID
		ThisForm.txtOper.Value			= PrepareSQLtxt(GFMLog.Oper,'Oper',10)
		ThisForm.txtLMA_Practice.Value	= PrepareSQLtxt(GFMLog.LMA_Practice,'LMA_Practice',7)
		ThisForm.txtLMA_Procedure.Value	= PrepareSQLtxt(GFMLog.LMA_Procedure,'LMA_Procedure',12)
		
		
		IF ISNULL(gfmlog.ChartData) 
			ThisForm.cmdChartData.Caption = "Add"
		ELSE
			IF gfmlog.ChartData
				ThisForm.cmdChartData.Caption = "Export"
			ELSE
				ThisForm.cmdChartData.Caption = "Add"
			ENDIF
		ENDIF
		
		IF USED('tmpShip')
			USE IN tmpShip
		ENDIF
		
		IF NOT ISNULL( GFMlog.SOitem )
			IF VAL(RIGHT( GFMlog.SOitem,2 ))>1
				
				cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+GFMlog.SOitem+"')"
				SELECT 0
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip' )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShip' )
				ENDIF
					
				IF USED('tmpShip')
					ThisForm.txtCompany.Value	= tmpShip.Company
					ThisForm.txtSalesP.Value	= tmpShip.SalesP
					IF tmpShip.DueDate > CTOD('12/30/1900')
						ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
					ELSE
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ENDIF
					
					IF tmpShip.ShipDate > CTOD('12/30/1900')
						ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
					ELSE
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
					USE IN tmpShip
				ELSE &&USED('tmpShip')
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&Not Item Number
				IF GFMlog.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(GFMlog.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&GFMlog.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			
			ENDIF
		ELSE  &&ISNULL( GFMlog.SOitem )
			IF NOT ISNULL(GFMlog.SalesNum)
				IF GFMlog.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(GFMlog.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&GFMlog.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&ISNULL(GFMlog.SalesNum)
				ThisForm.txtCompany.Value	= ''
				ThisForm.txtSalesP.Value	= ''
				ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
				ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
			ENDIF
		ENDIF
		
		PRIVATE lnUT
		lnUT = UTresult( GFMLog.ID ,"GFMLog", ThisForm.nConnHandle)
		IF EMPTY(lnUT)
			*Null
			ThisForm.lblUTpass.Visible = .F.
		ELSE
			IF lnUT > 0
				*True
				ThisForm.lblUTpass.Caption = "Pass"
				ThisForm.lblUTpass.Visible = .T.
				ThisForm.lblUTpass.ForeColor = RGB(0,0,0)
				ThisForm.lblUTpass.BackColor = RGB(0,191,96)
		
			ELSE
				IF lnUT <0 
					*False
					ThisForm.lblUTpass.Caption = "Fail"
					ThisForm.lblUTpass.Visible = .T.
					ThisForm.lblUTpass.ForeColor = RGB(0,0,0)
					ThisForm.lblUTpass.BackColor = RGB(255,0,0)
				ENDIF
			ENDIF
		ENDIF
		
		
		ThisForm.DupLots()
		
		SELECT GFMLog
		
		********
		IF WEXIST("frmLog_Detail")
			RELEASE WINDOWS frmLog_Detail
		ENDIF
		
		PRIVATE nTop, nLeft
		nTop = ThisForm.Top
		nLeft = ThisForm.Width
		DO FORM Forms\Log_Detail WITH "GFMLOG", GFMLog.ID, ThisForm.nConnHandle, nTop, nLeft
		
		*
		********
		IF WEXIST("frmGFM_Hard_Prof")
			RELEASE WINDOWS frmGFM_Hard_Prof
		ENDIF
		
		PRIVATE nTop, nLeft
		nTop = ThisForm.Top+250
		nLeft = ThisForm.Width
		*DO FORM Forms\GFM_Hard_Prof WITH GFMLog.ID, ThisForm.nConnHandle, nTop, nLeft
		
		*********
	ENDPROC

	PROCEDURE savegfmlog
		*ThisForm.SaveGFMlog()
		
		PRIVATE cAlloyName, dDate, cHeat, nLot
		PRIVATE nSpiece,nFpiece,nSsize,nGFMsize,nSlength,nFsize,nSweight,nFlength
		PRIVATE cCondition,nColdWork,cSpec,cHTreat,nSalesNum,nItemSO,cSOitem
		PRIVATE nOvenTemp,cPO,nWO_Detail,nProjID,cNotes,nSrvcPO,nTestPO,nTestItemPO,dTestSent,cLab
		PRIVATE nMinutes,cMachine  &&,nGFMp,nOvenp,nCGp
		PRIVATE nTensile,nYield,nElongation,nRed_Area,cRockwell,nBHN,ctLoc
		PRIVATE nTensile2,nYield2,nElongation2,nRed_Area2,cRockwell2,nBHN2,ctLoc2
		PRIVATE nTensile3,nYield3,nElongation3,nRed_Area3,cRockwell3,nBHN3,ctLoc3
		
		PRIVATE nTensile4,nYield4,nElongation4,nRed_Area4,ctLoc4
		PRIVATE nTensile5,nYield5,nElongation5,nRed_Area5,ctLoc5
		PRIVATE nTensile6,nYield6,nElongation6,nRed_Area6,ctLoc6
