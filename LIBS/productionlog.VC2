	PROCEDURE Unload
		
		IF USED("tmpProjStk")	
			USE IN tmpProjStk
		ENDIF
		
	ENDPROC

	PROCEDURE chkOrderByLBS.Click
		IF USED('tmpProjStk')
			SELECT tmpProjStk
			IF This.Value = 1
		
				INDEX ON LBS_Needed DESCENDING TAG 'LBS_Needed' OF tmpProjStk
				** DESCENDING
				TRY	
					SET ORDER TO TAG 'LBS_Needed' OF tmpProjStk
					WAIT WINDOW "SET ORDER TO 'LBS_Needed'" TIMEOUT 1
					GO TOP
				CATCH
					MESSAGEBOX("Error with tmpProjStk Index LBS_Needed",0+16,"Error")
				ENDTRY
				
			ELSE
				SET ORDER TO
				WAIT WINDOW "ORDER SET TO ID" NOWAIT
			ENDIF
			
			ThisForm.grdProStk.Refresh
			ThisForm.ProjStk_Refresh()
			
		ELSE
			TrackMess( "tmpProjStk is not used!")
		ENDIF
	ENDPROC

	PROCEDURE cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		*This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE cmbCC.Valid
		ThisForm.InitcmbCL()
		
		
	ENDPROC

	PROCEDURE cmbCL.Init
		**ThisForm.InitcmbCL()
		
		*INIT with every type of CC
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		*This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE cmbForm.Valid
		*10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,71,Coupling,72,Flange,75,Fastener,80,Disk,90,Machined
		
		*ThisForm.RefreshForms(This.Value)
		* ALSO FOUND IN Quotes,PurchaseOrder Screen
		
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			*Edit
			
			ThisForm.SetStock_Projected('EDIT')
			ThisForm.InitcmbCL(ThisForm.cmbCL.Value)	&&populate cmbCL
			
			ThisForm.cmdNew.Caption = "Abort"	
			ThisForm.cmdReportProj.Visible = .F.
			ThisForm.cmdQuit.Visible = .F.
			This.Caption = "Save"
			
			ThisForm.txtCompany.SetFocus
			
		ELSE
			*Save
			*PRIVATE nID
			*nID	= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
				
			IF ThisForm.CheckStock_Projected()
				ThisForm.SaveStock_Projected()
			
				ThisForm.SetStock_Projected('NOEDIT')
				
				ThisForm.cmdNew.Caption = "New"
				ThisForm.cmdReportProj.Visible = .T.
				ThisForm.cmdQuit.Visible = .T.
				This.Caption = "Edit"
			ELSE
			
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdNew.Click
		IF This.Caption = "New"
			*Add
			ThisForm.SetStock_Projected('EDIT')	
			
			PRIVATE nMess, cMess	
			nMess = 0
			cMess = ''
			nMess = MESSAGEBOX("Do you want to Clone off the current data?"+CHR(13)+"Answer NO to Add as blank.",4+32,"Clone?")
			IF nMess = 6
				ThisForm.Stock_Projected_Init('CLONE')
			ELSE
				ThisForm.Stock_Projected_Init('ADD')
			ENDIF
			
			ThisForm.cmdEdit.Caption = "Save"	
			ThisForm.cmdReportProj.Visible = .F.
			ThisForm.cmdQuit.Visible = .F.
			This.Caption = "Abort"
			
			ThisForm.txtCompany.SetFocus
			
		ELSE
			*Abort
			
		
			ThisForm.SetStock_Projected('NOEDIT')
		
			ThisForm.grdProStk.Refresh
			ThisForm.ProjStk_Refresh()
				
			ThisForm.cmdEdit.Caption = "Edit"
			ThisForm.cmdReportProj.Visible = .T.
			ThisForm.cmdQuit.Visible = .T.
			This.Caption = "New"
		ENDIF
	ENDPROC

	PROCEDURE cmdQuit.Click
		
		ThisForm.Visible = .F.
		*ThisForm.Release
		*ThisFormSet.Release
		
	ENDPROC

	PROCEDURE cmdReportProj.Click
		
		SELECT tmpProjStk
		PRIVATE nID
		nID =  PrepareSQLnum(tmpProjStk.ID,'ID',-3)
		
		REPORT FORM Reports\Stock_Projected FOR ID=nID PREVIEW
		*TO PRINTER PROMPT NOCONSOLE
		
		SELECT tmpProjStk
		LOCATE FOR ID = nID
		ThisForm.grdProStk.SetFocus
	ENDPROC

	PROCEDURE grdProStk.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.ProjStk_Refresh()
		
	ENDPROC

	PROCEDURE lblSThck.Click
		PRIVATE nFinishThck, nCW, cForm, nStartThck
		nFinishThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3) + PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-3)
		cForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'From',2)
		nStartThck	= getStartThck_RA( nFinishThck, nCW, cForm )
		ThisForm.txtSThck.Value = PrepareSQLnum(nStartThck,'StartThck',5,3)
				
	ENDPROC

	PROCEDURE lblYearPounds.Click
		*Calculate LBS per Year from Inches.
		
		PRIVATE cAlloy, cForm, nThck
		PRIVATE nYearInches, nYearPounds
		
		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3)
		nYearInches	= PrepareSQLnum(ThisForm.txtYearInches.Value,'YearInches',-3)
		nYearPounds	= 0 &&PrepareSQLnum(ThisForm.txtYearPounds.Value,'YearPounds',-3)
		
		IF nYearInches= 0
			MESSAGEBOX("Need Year Inches for this",0+48,"Cannot Calculate")
			RETURN .F.
		ENDIF
		
		PRIVATE nPieces, nSize2, nSize3
		nPieces	= 1
		nSize2	= nYearInches
		nSize3	= 0
		
		nYearPounds = CalcWeight(nPieces, cAlloy, cForm, nThck, nSize2, nSize3, ThisFormSet.nConnHandle)
		
		ThisForm.txtYearPounds.Value =  PrepareSQLnum(nYearPounds,'YearPounds',-3)
		
	ENDPROC

	PROCEDURE lblYrInches.Click
		*Calculate Inches per Year from Pounds.
		
		PRIVATE cAlloy, cForm, nThck
		PRIVATE nYearInches, nYearPounds
		
		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3)
		nYearInches	= 0 &&PrepareSQLnum(ThisForm.txtYearInches.Value,'YearInches',-3)
		nYearPounds	= PrepareSQLnum(ThisForm.txtYearPounds.Value,'YearPounds',-3)
		
		IF nYearPounds = 0
			MESSAGEBOX("Need Year Pounds for this",0+48,"Cannot Calculate")
			RETURN .F.
		ENDIF
		
		PRIVATE nPieces, nSize2, nSize3
		nPieces	= 1
		nSize2	= 1000
		nSize3	= 0
		
		nLBS = CalcWeight(nPieces, cAlloy, cForm, nThck, nSize2, nSize3, ThisFormSet.nConnHandle)
		
		nYearInches = 1000 * nYearPounds / nLBS
		ThisForm.txtYearInches.Value =  ROUND(PrepareSQLnum(nYearInches ,'YearInches ',-5),0) &&return Integer
	ENDPROC

	PROCEDURE txtAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisFormSet.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisFormSet.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE txtSpec_CC.Valid
		ThisForm.Refresh_FSpec()
	ENDPROC

	PROCEDURE txtSpec_CL.Valid
		ThisForm.Refresh_FSpec()
	ENDPROC

ENDDEFINE
