	PROCEDURE txtTestsent.When
		PRIVATE nID
		nID = ThisForm.txtID.Value
		
		IF NOT USED('GFMLog')
			ThisForm.LoadLog(nID)
		ENDIF
		
		SELECT GFMlog
		IF ThisForm.isediting
			IF NOT EMPTY(GFMLog.testpo) AND EMPTY(GFMLog.testsent)
				REPLACE GFMLog.Testsent WITH DATE()
			ENDIF
			RETURN .T.
		ELSE	
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE txttLoc.Valid
		PRIVATE ctLoc
		ctLoc = UPPER(ShowSQLtxt(This.Value,'tLoc',1))
		IF ctLoc = "C" OR ctLoc = "M" OR ctLoc = "O" OR EMPTY(ctLoc)
			RETURN .T.
		ELSE
			MESSAGEBOX("Test Location must be blank, Center, MidRadius or Outer"+CHR(13)+"'','C','M','O'"+CHR(13)+"cannot be '"+ctLoc+"'.",16,"Cannot Continue")
			RETURN .F.
		ENDIF
		
	ENDPROC

