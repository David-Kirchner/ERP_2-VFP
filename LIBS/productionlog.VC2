			cSQL = cSQL + ",LMA_Practice,LMA_Procedure,WO_Detail,ProjID"
			cSQL = cSQL + ",Machine,Oper"
			cSQL = cSQL + ") VALUES "
			cSQL = cSQL + "('"+cAlloyName+"','"+IIF(EMPTY(dDate),'',DTOC(dDate))+"','"+cHeat+"',"+STR(nLot,11,0)
			cSQL = cSQL + ","+STR(nSpiece,6,1)+","+STR(nFpiece,5,0)+","+STR(nSsize,10,3)+","+STR(nGFMsize,10,3)+","+STR(nSlength,10,3)+","+STR(nFsize,10,3)+","+STR(nSweight,8,1)+","+STR(nFlength,10,3)
			cSQL = cSQL + ",'"+cCondition+"',"+STR(nColdWork,4,3)+",'"+cSpec+"','"+cHTreat+"',"+STR(nSalesNum)+","+STR(nItemSO,2,0)+",'"+cSOitem+"'"
			cSQL = cSQL + ","+STR(nOvenTemp,4,0)+",'"+cPO+"','"+cNotes+"',"+STR(nSrvcPO,10,0)+","+STR(nTestPO,10,0)+","+STR(nTestItemPO,2,0)+",'"+cTestPoItem+"','"+IIF(EMPTY(dTestSent),'',DTOC(dTestSent))+"'"+",'"+cLab+"'"
			cSQL = cSQL + ","+STR(nMinutes,4,0)   &&+","+STR(nGFMp,9,2)+","+STR(nOvenp,9,2)+","+STR(nCGp,9,2)
			cSQL = cSQL + ","+STR(nTensile,6,0)+","+STR(nYield,6,0)+","+STR(nElongation,5,1)+","+STR(nRed_Area,5,1)+",'"+cRockwell+"',"+STR(nBHN,4,1)+",'"+ctLoc+"'"
			cSQL = cSQL + ","+STR(nTensile2,6,0)+","+STR(nYield2,6,0)+","+STR(nElongation2,4,1)+","+STR(nRed_Area2,4,1)+",'"+cRockwell2+"',"+STR(nBHN2,4,1)+",'"+ctLoc2+"'"
			cSQL = cSQL + ","+STR(nTensile3,6,0)+","+STR(nYield3,6,0)+","+STR(nElongation3,4,1)+","+STR(nRed_Area3,4,1)+",'"+cRockwell3+"',"+STR(nBHN3,4,1)+",'"+ctLoc3+"'"
			
			cSQL = cSQL + ","+STR(nTensile4,6,0)+","+STR(nYield4,6,0)+","+STR(nElongation4,4,1)+","+STR(nRed_Area4,4,1)+",'"+ctLoc4+"'"
			cSQL = cSQL + ","+STR(nTensile5,6,0)+","+STR(nYield5,6,0)+","+STR(nElongation5,4,1)+","+STR(nRed_Area5,4,1)+",'"+ctLoc5+"'"
			cSQL = cSQL + ","+STR(nTensile6,6,0)+","+STR(nYield6,6,0)+","+STR(nElongation6,4,1)+","+STR(nRed_Area6,4,1)+",'"+ctLoc6+"'"
			cSQL = cSQL + ","+STR(nTensile7,6,0)+","+STR(nYield7,6,0)+","+STR(nElongation7,4,1)+","+STR(nRed_Area7,4,1)+",'"+ctLoc7+"'"
			cSQL = cSQL + ",'"+cHTRockwell+"',"+STR(nHTBHN,3,1)
			cSQL = cSQL + ","+IIF(lPassed,'1','0')+","+IIF(lCustomerMat,'1','0')+","+IIF(lChart,'1','0')
			cSQL = cSQL + ",'"+cLMA_Practice+"','"+cLMA_Procedure+"',"+STR(nWO_Detail)+","+STR(nProjID)
			cSQL = cSQL + ",'"+cMachine+"','"+cOper+"'"
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
