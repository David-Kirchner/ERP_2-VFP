	PROCEDURE lblAcctCosting.Click
		PRIVATE lPassed
		lPassed		= PrepareSQLchk(ThisForm.chkPassed.Value,'Passed',.F.)
		PRIVATE nAC_ID
		nAC_ID = PrepareSQLnum(ThisForm.txtAC_ID.Value,'AC_ID',-3)
		
		IF nAC_ID > 0
			MESSAGEBOX("The 'Accounting Costing' has already begun.",0,"Return")
			RETURN 
		ENDIF
		
		IF lPassed
			nAC_ID = AcctCosting_Start() &&"GFM",nLot,nWO_Detail,cSOitem)
		ELSE
			PRIVATE nMess
			nMess = MESSAGEBOX("This lot is not listed as 'Passed'"+CHR(13)+"Are you sure you want to mark this"+CHR(13)+"as ready for Accouting Costing?",4+32,"Ready for Accounting Costing?")
			IF nMess = 6
				nAC_ID = AcctCosting_Start()
			ENDIF
		ENDIF
		
		IF nAC_ID > 0
			ThisForm.txtAC_ID.Value = nAC_ID
		*	ThisForm.txtAC.Value = AcctCosting_get_dtCreate_ID(nAC_ID,ThisForm.nConnhandle)
			
			SELECT GFMLog
		*	REPLACE AC_ID WITH ThisForm.txtAC_ID.Value
			REPLACE AC_ID WITH nAC_ID
			
			WAIT WINDOW 'Sent to Accounting' NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE lblLot.Click
		IF NOT THISFORM.isediting
			RETURN .F.
		ENDIF
		
		
		PRIVATE nLot
		
		nLot = ThisForm.txtLot.Value
		IF nLot > 0
			MESSAGEBOX("Lot already has a value"+CHR(13)+"Zero out Lot and try again!",0+48,'Cannot overwrite Lot')
			RETURN
		ENDIF
		IF NOT THISFORM.isediting
			RETURN .F.
		ENDIF
		
		  
		IF USED('tmpCountLot')	
			USE IN tmpCountLot
		ENDIF
		
		cSQL = "SELECT MAX(Lot) AS MaxLot FROM dbo.GFMLog"
				
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
		ELSE
			IF USED('tmpCountLot')
				IF tmpCountLot.MaxLot > 0
				
					ThisForm.txtLot.Value = tmpCountLot.MaxLot+1
					ThisForm.Lots.Caption = '1'
					
				ENDIF
				USE IN tmpCountLot 
			ENDIF
		ENDIF
		
	ENDPROC

