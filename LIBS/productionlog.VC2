	PROCEDURE cmdChartData.Click
		
		PRIVATE nID, nLot, nLotID, cLotID
		nID	= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		IF nID < 1
			MESSAGEBOX("Did not find the ID to Update")
			RETURN
		ENDIF
		nLot = PrepareSQLnum(ThisForm.txtLot.Value,'ID',-3)
		nLotID = PrepareSQLnum(ThisForm.Lots.Caption,'Lots',-3)
		IF nLot > 0
			IF nLotID = 0
				cLotID = ALLTRIM(STR(nLot))
			ELSE
				IF nLotID = 1
					cLotID = ALLTRIM(STR(nLot))
				ELSE
					cLotID = ALLTRIM(STR(nLot))+"-"+ALLTRIM(STR(nLotID))
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Did not find the Lot to Update")
			RETURN
		ENDIF
		
		PRIVATE cFileName, cFileContents
		cFileName = ''
		
		IF This.Caption = "Add"
			*Get File
			***breaks over 240 Character!!
			cFileName = GETFILE("CSV" , "Find the Chart Data", "Find", 0 , "Chart Data as CSV")
			IF VARTYPE(cFileName) = "C"
				IF NOT ".CSV" $ cFileName
					MESSAGEBOX("No CSV file")
					RETURN
				ENDIF
				IF FILE(cFileName)
		
					Local nFileHandle,nSize,cString
					nFileHandle = FOPEN(cFileName)
					* Seek to end of file to determine number of bytes in the file.
					nSize =  FSEEK(nFileHandle, 0, 2)     && Move pointer to EOF
					IF nSize <= 0
						* If file is empty, display an error message.
						WAIT WINDOW "This file is empty!" NOWAIT
						RETURN
					ELSE
						* If file is not empty, store the file's contents in memory
						* and display the text in the main Visual FoxPro window.
						= FSEEK(nFileHandle, 0, 0)      && Move pointer to BOF
						cFileContents = FREAD(nFileHandle, nSize)
					ENDIF
					= FCLOSE(nFileHandle)         && Close the file
		
					cFileContents  = STRTRAN(cFileContents ,"'","''")
					
					PRIVATE cSQL
					cSQL = "UPDATE dbo.LakeErie_Log SET "
					cSQL = cSQL + " ChartData = '1'"
					cSQL = cSQL + " WHERE ID="+STR(nID)
		
		
					nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC )
					ELSE
						cSQL = "INSERT INTO dbo.Log_Charts ([Log],[LogID],[Lot],[LotID],[ChartData]) VALUES ("
						cSQL = cSQL + "'L'"
						cSQL = cSQL + ","+ALLTRIM(STR(nID))
						cSQL = cSQL + ","+ALLTRIM(STR(nLot))
						cSQL = cSQL + ","+ALLTRIM(STR(nLotID))
						cSQL = cSQL + ",'"+cFileContents+"'"
						cSQL = cSQL + " )"
						
						nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC )
						ELSE
							WAIT WINDOW 'Updated!' NOWAIT
							This.Caption = "Export"
							UPDATE GFMlog SET ChartData = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		
		ELSE
			* This.Caption = "Export"
			*Get File
		
			***breaks over 240 Character!!
			Local nFileHandle
		
			cFileName = "LakeErie_log"+cLotID
			cFileName = SYS(5)+SYS(2003) +"\"+cFileName + ".CSV"
		
			IF FILE(cFileName)
				IF MESSAGEBOX("File '"+cFileName+"'"+CHR(13)+"already exits."+CHR(10)+"Do you want to add this data to the file?",0+4+32+256,"Append to file?") != 6
					DELETE FILE (cFileName) RECYCLE
				ENDIF
			ENDIF		
					
					
			IF FILE(cFileName)
				nFileHandle = FOPEN(cFileName,11)
				IF nFileHandle < 0
					WAIT 'Cannot open or create output file' WINDOW 
				ELSE
					IF USED('Log_Charts')
						USE IN Log_Charts
					ENDIF
					SELECT 0
					
					cSQL = "SELECT [ChartData] FROM dbo.Log_Charts WHERE "
					cSQL = cSQL + "[Log]='L'"
					cSQL = cSQL + " AND [LogID]="+ALLTRIM(STR(nID))
					cSQL = cSQL + " AND [Lot]="+ALLTRIM(STR(nLot))
					cSQL = cSQL + " AND [LotID]="+ALLTRIM(STR(nLotID))
		
					nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL,'Log_Charts' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL,'Log_Charts'  )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC,'Log_Charts' )
					ELSE
						IF USED('Log_Charts')
							IF VARTYPE(Log_Charts.ChartData) = "C"
								= FWRITE(nFileHandle, Log_Charts.ChartData )
							ENDIF
							USE IN Log_Charts
						ENDIF
					ENDIF
					
					= FCLOSE(nFileHandle)         && Close the file
					WAIT WINDOW "File is Ready '"+cFileName+"'" NOWAIT
		
					RUN ["EXPLORER.exe "]+SYS(5)+SYS(2003)+[\"]  /N
					
				ENDIF
			ELSE
				
				nFileHandle= FCREATE(cFileName,0)
				IF nFileHandle < 0
					WAIT WINDOW 'Cannot open or create output file' 
				ELSE
					IF USED('Log_Charts')
						USE IN Log_Charts
					ENDIF
					SELECT 0
					
					cSQL = "SELECT [ChartData] FROM dbo.Log_Charts WHERE "
					*[ChartData]
					cSQL = cSQL + "[Log]='L'"
					cSQL = cSQL + " AND [LogID]="+ALLTRIM(STR(nID))
					cSQL = cSQL + " AND [Lot]="+ALLTRIM(STR(nLot))
					cSQL = cSQL + " AND [LotID]="+ALLTRIM(STR(nLotID))
		
					nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL,'Log_Charts' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL,'Log_Charts'  )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC,'Log_Charts' )
					ELSE
						IF USED('Log_Charts')
							IF VARTYPE(Log_Charts.ChartData) = "C"
								= FWRITE(nFileHandle, Log_Charts.ChartData )
							ENDIF
							USE IN Log_Charts
						ENDIF
					ENDIF
					
					= FCLOSE(nFileHandle)         && Close the file
					WAIT WINDOW "Created File '"+cFileName+"'" NOWAIT
					RUN ["EXPLORER.exe "]+SYS(5)+SYS(2003)+[\"]  /N
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE cmdClone.Valid
		SELECT LakeErie_log
		IF !ThisForm.isediting &&add record
			ThisForm.isediting=.T.
			ThisForm.IsAdding=.T.
			ThisForm.cmdEdit.Caption="Save"
			ThisForm.cmdDel.Caption="Abort"
