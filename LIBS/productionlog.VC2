		** STR(nColdWork,4,3) Returns ****  ????
		IF VAL(STR(nColdWork,4,3))=0
			nColdWork=0.000
		ENDIF
		
		
		IF nID = 0
			*Add
			
			IF nLot = 0
				*get Lot
				  
				IF USED('tmpCountLot')	
					USE IN tmpCountLot
				ENDIF
		
				cSQL = "SELECT MAX(Lot) AS MaxLot FROM dbo.GFMLog"
						
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
				ELSE
					IF USED('tmpCountLot')
						IF tmpCountLot.MaxLot > 0
						
							nLot = tmpCountLot.MaxLot+1
							ThisForm.txtLot.Value = nLot
							ThisForm.Lots.Caption = '1'
						ENDIF
						USE IN tmpCountLot 
					ENDIF
				ENDIF
			ENDIF
		
		
			PRIVATE cUserTrack 
			cUserTrack = "INSERT INTO dbo.GFMlog ColdWork:"
			cUserTrack = cUserTrack+" STR as 4,3:"+STR(nColdWork,4,3)
			cUserTrack = cUserTrack+" STR as 5,3:"+STR(nColdWork,5,3)
