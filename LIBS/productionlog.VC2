DEFINE CLASS lakeerielog AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label34" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label33" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="shpHT" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label23" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="linLine1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtAlloyname" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtDate" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtHeat" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtLot" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtSpiece" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtSsize" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtSlength" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtSweight" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtFpiece" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtROLLsize" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtFsize" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmgGfm_calc" UniqueID="" Timestamp="" />
