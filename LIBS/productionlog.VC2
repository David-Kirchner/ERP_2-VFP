			cSQL = cSQL + ",Tensile4,Yield4,Elongation4,Red_Area4,tLoc4"
			cSQL = cSQL + ",Tensile5,Yield5,Elongation5,Red_Area5,tLoc5"
			cSQL = cSQL + ",Tensile6,Yield6,Elongation6,Red_Area6,tLoc6"
