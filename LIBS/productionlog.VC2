	PROCEDURE initcmbcl
		PARAMETERS pCLorig
		*ThisForm.InitcmbCL()
		
		PRIVATE cCLorig
		IF VARTYPE(pCLorig) = "C"
			cCLorig = pCLorig
		ELSE
			cCLorig = ''
		ENDIF
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		ThisForm.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		ThisForm.cmbCL.ColumnCount = 2
		ThisForm.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		ThisForm.cmbCL.BoundColumn = 1
		ThisForm.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					ThisForm.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					ThisForm.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		IF EMPTY(cCLorig)
			ThisForm.cmbCL.Value = cCL1
		ELSE
			ThisForm.cmbCL.Value = cCLorig
		ENDIF
		
		IF ThisForm.CC != PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
			ThisForm.CC = PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		*	This.Parent.cmbCL.Value = ''
			ThisForm.cmbCL.Value = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
			ThisForm.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE initprojstock
		PARAMETERS pID
		*ThisForm.InitProjStock()
		
		PRIVATE nID
		IF VARTYPE(pID) = 'N'
			nID = pID
		ELSE
			nID = 0
		ENDIF
		
		
		IF USED("tmpProjStk")	
			USE IN tmpProjStk
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT SP.* "
		cSQL = cSQL+",ISNULL(PT.CWCnt,0) AS CWCnt, ISNULL(PT.CWMin,0) AS CWMin, ISNULL(PT.CWAvg,0) AS CWAvg "
		cSQL = cSQL+",ISNULL(PT.CWMedian,0) AS CWMedian, ISNULL(PT.CWMax,0) AS CWMax, ISNULL(PT.StartDia,0) AS StartDia "
		cSQL = cSQL+",ISNULL(CL.Text,'') AS CLText "
		cSQL = cSQL+",ISNULL(CL.Spec,'') AS FSpec "
		
		cSQL = cSQL+" ,(SELECT ISNULL(SUM(fWeight),0) "
		cSQL = cSQL+" 	 FROM dbo.WorkOrder WO "
		cSQL = cSQL+" 	 INNER JOIN dbo.WorkOrder_Detail WOD ON WO.WO = WOD.WO "
		cSQL = cSQL+" 	 WHERE WOD.Stock_Projected_ID = SP.ID "
		cSQL = cSQL+" 	 AND ISNULL(WOD.fCmplt,0) = 0 "
		cSQL = cSQL+" 	 AND ISNULL(WOD.fCncld,0) = 0 "
		cSQL = cSQL+" 	 AND ISNULL(SP.Cncld,0) = 0 "
		cSQL = cSQL+" 	 ) AS fWeight "
		
		cSQL = cSQL+" ,( YearPounds - (SELECT ISNULL(SUM(fWeight),0) "
		cSQL = cSQL+" 	 FROM dbo.WorkOrder WO "
		cSQL = cSQL+" 	 INNER JOIN dbo.WorkOrder_Detail WOD ON WO.WO = WOD.WO "
		cSQL = cSQL+" 	 WHERE WOD.Stock_Projected_ID = SP.ID "
		cSQL = cSQL+" 	 AND ISNULL(WOD.fCmplt,0) = 0 "
		cSQL = cSQL+" 	 AND ISNULL(WOD.fCncld,0) = 0 "
		cSQL = cSQL+" 	 AND ISNULL(SP.Cncld,0) = 0 "
		cSQL = cSQL+" 	 ) ) AS LBS_Needed "
		
		cSQL = cSQL+" ,(SELECT TOP 1 fStartDate  "
		cSQL = cSQL+" 	 FROM dbo.WorkOrder_Detail "
		cSQL = cSQL+" 	 WHERE Stock_Projected_ID = SP.ID "
		cSQL = cSQL+" 	 AND ISNULL(SP.Cncld,0) = 0 "
		cSQL = cSQL+" 	 AND NOT fStartDate IS NULL "
		cSQL = cSQL+" 	 ORDER BY fStartDate ) AS PDate "
		
		cSQL = cSQL+",dbo.f_Calc_Stock_QTY(SP.Alloy,SP.Form,SP.Thck) AS StockQTY "
		
		cSQL = cSQL+" FROM dbo.Stock_Projected SP "
		cSQL = cSQL+" LEFT OUTER JOIN dbo.ConditionLevel CL ON CL.CC=SP.Spec_CC AND CL.CL=SP.Spec_CL "
		cSQL = cSQL+" LEFT OUTER JOIN dbo.PriceTable PT ON SP.Alloy=PT.Alloy "
		cSQL = cSQL+"	AND SP.Form = PT.Form AND SP.Thck=PT.Size AND SP.CC= PT.CC AND SP.CL=PT.CL "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProjStk')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpProjStk')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjStk")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjStk")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProjStk')
		ELSE
			*See INIT
		*	ThisFormSet.pgf.pgBrowse.grdtmpProjStk.RecordSource = "tmpProjStk"
			ThisForm.grdProStk.RecordSource = "tmpProjStk"
		ENDIF
		
		IF USED('tmpProjStk')
			SELECT tmpProjStk
			IF nID > 0
				LOCATE FOR ID = nID
			ENDIF
			IF nID = -1
				GO BOTTOM
			ENDIF
			
			ThisForm.ProjStk_Refresh()
		ELSE
			MESSAGEBOX("No tmpProjStk TABLE",16,"Cannot Continue.")
		ENDIF
	ENDPROC

	PROCEDURE projstk_refresh		&& ProjStk_Refresh
		*.ProjStk_Refresh()
		
		IF USED('tmpProjStk')
			
			ThisForm.grdProStk.Refresh
			
			ThisForm.txtCompany.Value 	= PrepareSQLtxt(tmpProjStk.Company,'Company',30)
			ThisForm.txtID.Value 		= PrepareSQLnum(tmpProjStk.ID,'ID',-3)
			ThisForm.txtAlloy.Value 	= PrepareSQLtxt(tmpProjStk.Alloy,'Alloy',12)
			ThisForm.cmbForm.Value 		= PrepareSQLtxt(tmpProjStk.Form,'Form',2)
			ThisForm.cmbCC.Value 		= PrepareSQLtxt(tmpProjStk.CC,'CC',1)
			Thisform.cmbCL.Init()		&&Reset cmb array to inclube every type of CC
			ThisForm.cmbCL.Value 		= PrepareSQLtxt(tmpProjStk.CL,'CL',1)
			ThisForm.txtThck.Value 		= PrepareSQLnum(tmpProjStk.thck,'Thck',9,3)
			ThisForm.txtOverSize.Value 	= PrepareSQLnum(tmpProjStk.OverSize,'OverSize',5,3)
			
			ThisForm.txtYearInches.Value 	= PrepareSQLnum(tmpProjStk.YearInches,'YearInches',-3)
			ThisForm.txtYearPounds.Value 	= PrepareSQLnum(tmpProjStk.YearPounds,'YearPounds',-3)
			ThisForm.txtMinPounds.Value 	= PrepareSQLnum(tmpProjStk.MinPounds,'MinPounds',-3)
			ThisForm.txtPoundsTaken.Value 	= PrepareSQLnum(tmpProjStk.PoundsTaken,'PoundsTaken',-3)
			
			ThisForm.txtSDate.Value 		= PrepareSQLtxt(tmpProjStk.SDate,'SDate',10)
			ThisForm.txtPDate.Value 		= PrepareSQLtxt(tmpProjStk.PDate,'PDate',10)
			ThisForm.txtLastEdit.Value 		= PrepareSQLdate(tmpProjStk.LastEdit,'LastEdit')
			
			ThisForm.txtSThck.Value 		= PrepareSQLnum(tmpProjStk.SThck,'SThck',9,3)
			ThisForm.txtSNomThck.Value 		= PrepareSQLnum(tmpProjStk.SNomThck,'SNomThck',9,3)
			ThisForm.txtStockQTY.Value 		= PrepareSQLnum(tmpProjStk.StockQTY,'StockQTY',-3)
			
			ThisForm.txtCW.Value 			= PrepareSQLnum(tmpProjStk.CW,'CW',-1)
			ThisForm.chkUT.Value 			= PrepareSQLchk(tmpProjStk.UT,'UT')
			ThisForm.chkCncld.Value			= PrepareSQLchk(tmpProjStk.Cncld,'Cncld')
			
			ThisForm.txtFSpec.Value		= PrepareSQLtxt(tmpProjStk.FSpec,'FSpec',50)
			ThisForm.txtSpec_CC.Value	= PrepareSQLtxt(tmpProjStk.Spec_CC,'Spec_CC',1)
			ThisForm.txtSpec_CL.Value	= PrepareSQLtxt(tmpProjStk.Spec_CL,'Spec_CL',1)
		
			ThisForm.txtFollowM.Value	= PrepareSQLtxt(tmpProjStk.FollowM,'FollowM',20)
			ThisForm.txtFollowLot.Value	= PrepareSQLnum(tmpProjStk.FollowLot,'FollowLot',-3)
		
			ThisForm.txtLBS_Prod.Value 	= PrepareSQLnum(tmpProjStk.fWeight,'fWeight',-3)   &&ThisFormSet.ProjStk_In_Production()
			ThisForm.txtLBS_Need.Value	= PrepareSQLnum(tmpProjStk.LBS_Needed,'LBS_Needed',-3) && ThisForm.txtLBS_Prod.Value - ThisForm.txtMinPounds.Value
			
			ThisForm.txtCWcnt.Value		= PrepareSQLnum(tmpProjStk.CWcnt,'CWcnt',-1)
			ThisForm.txtCWmin.Value		= PrepareSQLnum(tmpProjStk.CWmin,'CWmin',-1)
			ThisForm.txtCWavg.Value		= PrepareSQLnum(tmpProjStk.CWavg,'CWavg',-1)
			ThisForm.txtCWmedian.Value	= PrepareSQLnum(tmpProjStk.CWmedian,'CWmedian',-1)
			ThisForm.txtCWmax.Value		= PrepareSQLnum(tmpProjStk.CWmax,'CWmax',-1)
			ThisForm.txtCLText.Value	= PrepareSQLtxt(tmpProjStk.CLText,'CLText',15)
				
			*PT.StartDia 
		
		ENDIF	
		
	ENDPROC

	PROCEDURE refresh_fspec
		*ThisForm.Refresh_FSpec()
		PRIVATE cSpec_CC, cSpec_CL, cFSpec
		cSpec_CC	= PrepareSQLtxt(ThisForm.txtSpec_CC.Value,'CC',1)
		cSpec_CL	= PrepareSQLtxt(ThisForm.txtSpec_CL.Value,'CL',1)
		cFSpec = ''
		
		IF USED("tmpFSpec")	
			USE IN tmpFSpec
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT Spec AS FSpec "
		cSQL = cSQL + " FROM dbo.ConditionLevel "
		cSQL = cSQL + " WHERE CC='"+cSpec_CC+"'"
		cSQL = cSQL + " AND CL='"+cSpec_CL+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpFSpec')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpFSpec')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFSpec")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFSpec")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpFSpec')
		ELSE
			IF USED('tmpFSpec')
				IF RECCOUNT('tmpFSpec') > 0
					cFSpec = PrepareSQLtxt(tmpFSpec.FSpec,'FSpec',50)
				ENDIF
				USE IN tmpFSpec
			ENDIF
		ENDIF
		
		ThisForm.txtFSpec.Value = cFSpec
		
		*Reload_CL
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		ThisForm.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		
	ENDPROC

