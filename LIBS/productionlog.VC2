	PROCEDURE checksave
		*ThisForm.CheckSave()
		PRIVATE nLot, cAlloyName, cLotAlloy, nID
		nLot		= PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		cAlloyName	= PrepareSQLtxt(ThisForm.txtAlloyName.Value,'AlloyName',12)
		nID			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		IF nID = 0
			*Add
			IF nLot > 0
				*Check Alloy
				cLotAlloy = GetAlloyName_fromLot(nLot,"G",THISFORM.ConnHandle)
				cLotAlloy = PrepareSQLtxt(cLotAlloy,'AlloyName',12)
				IF cAlloyName != cLotAlloy 
					MESSAGEBOX("This Lot:"+ALLTRIM(STR(nLot))+" for Alloy:'"+ALLTRIM(cLotAlloy)+"'."+CHR(13)+"This LOT cannot be saved with alloy name of '"+ALLTRIM(cAlloyName)+"'.",0+16,"Cannot have different Alloys on same LOT Number!")
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			*Update!	
		ENDIF
		
		
		***** Test PO
		PRIVATE nSrvcPO, nTestPO, nTestitemPO, cLab
		nSrvcPO		= PrepareSQLnum(ThisForm.txtSrvcPO.Value,'SrvcPO',-3)
		nTestPO		= PrepareSQLnum(ThisForm.txtTestPO.Value,'TestPO',-3)
		nTestitemPO	= PrepareSQLnum(ThisForm.txtTestItemPO.Value,'TestItemPO',2,0)
		cLab		= PrepareSQLtxt(ThisForm.txtLab.Value,'Lab',12)
		
		PRIVATE cPOitem, cCountPOItem 
		*Check for POitem
		IF nTestitemPO > 0
			cPOitem = Proper_PO_Item( STR(nTestPO)+"-"+STR(nTestitemPO,2,0) )
			IF cPOitem <> Proper_PO_Item('')
				cCountPOItem = Count_POIteminPurchaseOrder( cPoItem, ThisForm.ConnHandle)
				IF cCountPOItem = 0
					MESSAGEBOX("Test POitem:"+ALLTRIM(cPOitem)+" was not found."+CHR(13)+"Change Test PO or item.",0,+"Cannot Save!")
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		
		IF nTestPO > 0
			IF Count_HPAPOinPurchaseOrder(nTestPO, ThisForm.ConnHandle) = 0
				MESSAGEBOX("Test PO:"+ALLTRIM(STR(nTestPO))+" was not found."+CHR(13)+"Change Test PO.",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		
		IF nSrvcPO > 0
			IF Count_HPAPOinPurchaseOrder(nSrvcPO, ThisForm.ConnHandle) = 0
				MESSAGEBOX("Srvc PO:"+ALLTRIM(STR(nSrvcPO))+" was not found."+CHR(13)+"Change Test PO.",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		
		
		
		
		
		
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE Destroy
		IF USED('LakeErie_log')
			USE IN LakeErie_log
		ENDIF
		
		IF USED('GFMLabs')
			USE IN GFMlabs
		ENDIF
		
		IF WEXIST("frmLog_Detail")
			RELEASE WINDOWS frmLog_Detail
		ENDIF
		
		IF ThisForm.lOpenShip AND USED('Ship')
			USE IN Ship
		ENDIF
	ENDPROC

	PROCEDURE duplots		&& Count the number of within this lot
		*ThisForm.DupLots()
		
		
		PRIVATE nLot
		*nLot = LakeErie_log.Lot
		nLot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpCountLot')	
			USE IN tmpCountLot
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.LakeErie_log WHERE LOT ="+ALLTRIM(STR(nLot))
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpCountLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpCountLot')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.ConnHandle, nSQLEXEC, 'tmpCountLot')
		ELSE
			IF USED('tmpCountLot')
		*		IF tmpCountLot.Cntd > 0
					ThisForm.Lots.Caption = ALLTRIM(STR(tmpCountLot.Cntd))
		*		ENDIF
				USE IN tmpCountLot 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getallrecords
		*ThisForm.getAllRecords()
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('LakeErie_log')	
			USE IN LakeErie_log
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.LakeErie_log ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'LakeErie_log')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'LakeErie_log')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.ConnHandle, nSQLEXEC, 'LakeErie_log')
			RETURN .F.
		ELSE
			*MESSAGEBOX("All records are now loaded",0+64,"See All LakeErie_log records!")
			WAIT WINDOW 'Loading All records' NOWAIT
			SELECT LakeErie_log
			INDEX ON LOT TAG LOT
			SET ORDER TO TAG LOT
			ThisForm.lSeeAll = .T.
			WAIT CLEAR
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE getlatestdata
		*ThisForm.getLatestData()
		PRIVATE nID
		
		nID = PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpLatestData')	
			USE IN tmpLatestData
		ENDIF
		
		cSQL = "SELECT * FROM dbo.LakeErie_log WHERE ID ="+ALLTRIM(STR(nID))
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpLatestData')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpLatestData')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.ConnHandle, nSQLEXEC, 'tmpLatestData')
		ELSE
			IF USED('tmpLatestData')
				IF RECCOUNT('tmpLatestData')>0
					*Show
								
					ThisForm.txtAlloyName.Value = tmpLatestData.AlloyName
					ThisForm.txtDate.Value 		= TTOD(tmpLatestData.Date)
					ThisForm.txtHeat.Value 		= tmpLatestData.Heat
					ThisForm.txtLot.Value 		= tmpLatestData.Lot
					ThisForm.txtSpiece.Value 	= tmpLatestData.sPiece
					ThisForm.txtFpiece.Value 	= tmpLatestData.fPiece
					ThisForm.txtSsize.Value 	= tmpLatestData.sSize
					ThisForm.txtSwidth.Value 	= tmpLatestData.sWidth
					ThisForm.txtRollSize.Value 	= tmpLatestData.RollSize
					ThisForm.txtSlength.Value 	= tmpLatestData.sLength
					ThisForm.txtFsize.Value 	= tmpLatestData.fSize
					ThisForm.txtFwidth.Value 	= tmpLatestData.fWidth
					ThisForm.txtSweight.Value 	= tmpLatestData.sWeight
					ThisForm.txtFlength.Value 	= tmpLatestData.fLength
					ThisForm.txtCondition.Value = tmpLatestData.Condition
					ThisForm.txtColdWork.Value 	= tmpLatestData.ColdWork
					ThisForm.txtSpec.Value 		= tmpLatestData.Spec
					ThisForm.txtHTreat.Value 	= tmpLatestData.Htreat
					ThisForm.txtSalesNum.Value 	= tmpLatestData.SalesNum
					ThisForm.txtItemSO.Value 	= tmpLatestData.ItemSO
					ThisForm.txtOvenTemp.Value 	= tmpLatestData.OvenTemp
					ThisForm.txtPO.Value 		= tmpLatestData.PO
					ThisForm.edtNotes.Value 	= tmpLatestData.Notes
					ThisForm.txtTestPO.Value 	= tmpLatestData.TestPO
					ThisForm.txtTestPoItem.Value= tmpLatestData.TestPOitem
					ThisForm.txtTestSent.Value 	= IIF(tmpLatestData.TestSent=CTOD('12/30/1899'), CTOD("  /  /  "),TTOD(tmpLatestData.TestSent))
					ThisForm.txtLab.Value		= tmpLatestData.Lab
					ThisForm.txtMinutes.Value 	= tmpLatestData.Minutes
					ThisForm.txtLaborP.Value 		= tmpLatestData.LaborP
					ThisForm.txtOvenp.Value 	= tmpLatestData.Ovenp
					ThisForm.txtCGp.Value 		= tmpLatestData.CGp
					ThisForm.txtTensile.Value 	= IIF(ISNULL(tmpLatestData.Tensile),0,tmpLatestData.Tensile)
					ThisForm.txtYield.Value 	= IIF(ISNULL(tmpLatestData.Yield),0,tmpLatestData.Yield)
					ThisForm.txtElongation.Value= IIF(ISNULL(tmpLatestData.Elongation),0,tmpLatestData.Elongation)
					ThisForm.txtRed_area.Value 	= IIF(ISNULL(tmpLatestData.Red_Area),0,tmpLatestData.Red_Area)
					ThisForm.txtRockwell.Value 	= IIF(ISNULL(tmpLatestData.Rockwell),'',tmpLatestData.Rockwell)
					ThisForm.txtBHN.Value 		= IIF(ISNULL(tmpLatestData.BHN),0,tmpLatestData.BHN)
					ThisForm.txtTensile2.Value 		= IIF(ISNULL(tmpLatestData.Tensile2),0,tmpLatestData.Tensile2)
					ThisForm.txtYield2.Value 		= IIF(ISNULL(tmpLatestData.Yield2),0,tmpLatestData.Yield2)
					ThisForm.txtElongation2.Value	= IIF(ISNULL(tmpLatestData.Elongation2),0,tmpLatestData.Elongation2)
					ThisForm.txtRed_area2.Value 	= IIF(ISNULL(tmpLatestData.Red_Area2),0,tmpLatestData.Red_Area2)
					ThisForm.txtRockwell2.Value 	= IIF(ISNULL(tmpLatestData.Rockwell2),'',tmpLatestData.Rockwell2)
					ThisForm.txtBHN2.Value 			= IIF(ISNULL(tmpLatestData.BHN2),0,tmpLatestData.BHN2)
					ThisForm.txtTensile3.Value 		= IIF(ISNULL(tmpLatestData.Tensile3),0,tmpLatestData.Tensile3)
					ThisForm.txtYield3.Value 		= IIF(ISNULL(tmpLatestData.Yield3),0,tmpLatestData.Yield3)
					ThisForm.txtElongation3.Value	= IIF(ISNULL(tmpLatestData.Elongation3),0,tmpLatestData.Elongation3)
					ThisForm.txtRed_area3.Value 	= IIF(ISNULL(tmpLatestData.Red_Area3),0,tmpLatestData.Red_Area3)
					ThisForm.txtRockwell3.Value 	= IIF(ISNULL(tmpLatestData.Rockwell3),'',tmpLatestData.Rockwell3)
					ThisForm.txtBHN3.Value 			= IIF(ISNULL(tmpLatestData.BHN3),0,tmpLatestData.BHN3)
					ThisForm.chkPassed.Value 		= IIF(ISNULL(tmpLatestData.Passed),.F.,tmpLatestData.Passed)
					ThisForm.chkCustomerMat.Value 	= IIF(ISNULL(tmpLatestData.CustomerMat),.F.,tmpLatestData.CustomerMat)
					ThisForm.chkChart.Value 		= IIF(ISNULL(tmpLatestData.Chart),.F.,tmpLatestData.Chart)
					ThisForm.txtHTRockwell.Value 	= IIF(ISNULL(tmpLatestData.HTRockwell),'',tmpLatestData.HTRockwell)
					ThisForm.txtHTBHN.Value 		= IIF(ISNULL(tmpLatestData.HTBHN),0,tmpLatestData.HTBHN)
					ThisForm.txtID.Value			= tmpLatestData.ID
		
				ENDIF
				USE IN tmpLatestData 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pLot
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('LakeErie_log')	
			USE IN LakeErie_log
		ENDIF
		
		cSQL = "SELECT * FROM dbo.LakeErie_log WITH(NOLOCK) WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'LakeErie_log')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'LakeErie_log')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'LakeErie_log')
			RETURN
		ELSE
			*Code is also used in RefreshReceiving and Reload
			SELECT LakeErie_log
			INDEX ON LOT TAG LOT
		ENDIF
		SET ORDER TO TAG LOT
		
		
		
		
		SELECT LakeErie_log
		*pCurRec = MIN( Recno(),RECCOUNT() )
		*SET ORDER TO TAG Lot
		
		GO BOTTOM
		IF VARTYPE(pLot) = 'N'
			IF pLot > 0
				LOCATE FOR Lot = pLot
				IF NOT FOUND()
					GO BOTTOM
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.spnSpnlot.Value = LakeErie_log.Lot
		ThisForm.Refresh_log()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisForm.ConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE loadgfmlabs		&& Used in InteractiveChange of Lab
		PRIVATE cSQL, nSQLEXEC
		*LoadGFMLab()
		
		cSQL = "SELECT DISTINCT [LAB] FROM dbo.LakeErie_log ORDER BY Lab "
		
		IF USED("GFMLabs")
			SELECT GFMLabs
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'GFMLabs')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL , 'GFMLabs')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'GFMLabs')
		ENDIF
		
		
		IF USED("GFMLabs")
			SELECT GFMlabs
			INDEX ON UPPER(LAB) TAG UppLAB
		ENDIF
		
	ENDPROC

	PROCEDURE load_log
		PARAMETERS pID
		*ThisForm.load_log()
		
		IF VARTYPE(pID)!="N"
			pID = 0
		ENDIF
		
		IF USED('LakeErie_log')	
			USE IN LakeErie_log
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.LakeErie_log WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'LakeErie_log')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'LakeErie_log')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.ConnHandle, nSQLEXEC, 'LakeErie_log')
			RETURN
		ELSE
			SELECT LakeErie_log
			INDEX ON LOT TAG LOT
			SET ORDER TO TAG LOT
			ThisForm.lSeeAll = .F.
		ENDIF
		
		IF pID = 0
			GO BOTTOM
		ELSE
			LOCATE FOR ID = pID
		ENDIF
		
		ThisForm.Refresh_log()
	ENDPROC

	PROCEDURE lothighvalue		&& Returns the highest Lot number for Lot spinner.
		*!*	Private maxlot, pTalk, pCurRec
		*!*	SELECT LakeErie_log
		*!*	pCurRec = RECNO()
		*!*	pTalk = SET('TALK')
		*!*	SET TALK OFF
		*!*	CALCULATE MAX(Lot) to maxlot
		*!*	IF pTalk = "ON"
		*!*		SET TALK ON
		*!*	ENDIF
		*!*	GOTO pCurRec
		*!*	RETURN maxlot
		
		
		PRIVATE nMaxLot 
		nMaxLot = 0
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpMaxLot')	
			USE IN tmpMaxLot
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT MAX(LOT) AS MaxLot FROM dbo.LakeErie_log "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpMaxLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpMaxLot')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.ConnHandle, nSQLEXEC, 'tmpMaxLot')
		ELSE
			IF USED('tmpMaxLot')
				nMaxLot = tmpMaxLot.MaxLot
				USE IN tmpMaxLot
				RETURN nMaxLot
			ENDIF
		ENDIF
		 
	ENDPROC

	PROCEDURE refresh_log		&& Prints Screen
		*ThisForm.Refresh_log()
		SELECT LakeErie_log
		
		ThisForm.txtAlloyName.Value = LakeErie_log.AlloyName
		ThisForm.txtDate.Value 		= TTOD(LakeErie_log.Date)
		ThisForm.txtHeat.Value 		= LakeErie_log.Heat
		ThisForm.txtLot.Value 		= LakeErie_log.Lot
		ThisForm.txtSpiece.Value 	= LakeErie_log.sPiece
		ThisForm.txtFpiece.Value 	= LakeErie_log.fPiece
		ThisForm.txtSsize.Value 	= LakeErie_log.sSize
		ThisForm.txtSwidth.Value 	= LakeErie_log.sWidth
		ThisForm.txtRollSize.Value 	= LakeErie_log.RollSize
		ThisForm.txtSlength.Value 	= LakeErie_log.sLength
		ThisForm.txtFsize.Value 	= LakeErie_log.fSize
		ThisForm.txtFwidth.Value 	= LakeErie_log.fWidth
		ThisForm.txtSweight.Value 	= LakeErie_log.sWeight
		ThisForm.txtFlength.Value 	= LakeErie_log.fLength
		ThisForm.txtCondition.Value = LakeErie_log.Condition
		ThisForm.txtColdWork.Value 	= LakeErie_log.ColdWork
		ThisForm.txtSpec.Value 		= LakeErie_log.Spec
		ThisForm.txtHTreat.Value 	= LakeErie_log.Htreat
		ThisForm.txtSalesNum.Value 	= LakeErie_log.SalesNum
		ThisForm.txtItemSO.Value 	= LakeErie_log.ItemSO
		ThisForm.txtOvenTemp.Value 	= LakeErie_log.OvenTemp
		ThisForm.txtPO.Value 		= LakeErie_log.PO
		ThisForm.edtNotes.Value 	= LakeErie_log.Notes
		ThisForm.txtTestPO.Value 	= LakeErie_log.TestPO
		ThisForm.txtTestPoItem.Value= LakeErie_log.TestPOitem
		ThisForm.txtTestSent.Value 	= IIF(LakeErie_log.TestSent=CTOD('12/30/1899'), CTOD("  /  /  "),TTOD(LakeErie_log.TestSent))
		ThisForm.txtLab.Value		= LakeErie_log.Lab
		ThisForm.txtMinutes.Value 	= LakeErie_log.Minutes
		ThisForm.txtLaborP.Value 		= LakeErie_log.LaborP
		ThisForm.txtOvenp.Value 	= LakeErie_log.Ovenp
		ThisForm.txtCGp.Value 		= LakeErie_log.CGp
		ThisForm.txtTensile.Value 	= IIF(ISNULL(LakeErie_log.Tensile),0,LakeErie_log.Tensile)
		ThisForm.txtYield.Value 	= IIF(ISNULL(LakeErie_log.Yield),0,LakeErie_log.Yield)
		ThisForm.txtElongation.Value= IIF(ISNULL(LakeErie_log.Elongation),0,LakeErie_log.Elongation)
		ThisForm.txtRed_area.Value 	= IIF(ISNULL(LakeErie_log.Red_Area),0,LakeErie_log.Red_Area)
		ThisForm.txtRockwell.Value 	= IIF(ISNULL(LakeErie_log.Rockwell),'',LakeErie_log.Rockwell)
		ThisForm.txtBHN.Value 		= IIF(ISNULL(LakeErie_log.BHN),0,LakeErie_log.BHN)
		ThisForm.txtTensile2.Value 		= IIF(ISNULL(LakeErie_log.Tensile2),0,LakeErie_log.Tensile2)
		ThisForm.txtYield2.Value 		= IIF(ISNULL(LakeErie_log.Yield2),0,LakeErie_log.Yield2)
		ThisForm.txtElongation2.Value	= IIF(ISNULL(LakeErie_log.Elongation2),0,LakeErie_log.Elongation2)
		ThisForm.txtRed_area2.Value 	= IIF(ISNULL(LakeErie_log.Red_Area2),0,LakeErie_log.Red_Area2)
		ThisForm.txtRockwell2.Value 	= IIF(ISNULL(LakeErie_log.Rockwell2),'',LakeErie_log.Rockwell2)
		ThisForm.txtBHN2.Value 			= IIF(ISNULL(LakeErie_log.BHN2),0,LakeErie_log.BHN2)
		ThisForm.txtTensile3.Value 		= IIF(ISNULL(LakeErie_log.Tensile3),0,LakeErie_log.Tensile3)
		ThisForm.txtYield3.Value 		= IIF(ISNULL(LakeErie_log.Yield3),0,LakeErie_log.Yield3)
		ThisForm.txtElongation3.Value	= IIF(ISNULL(LakeErie_log.Elongation3),0,LakeErie_log.Elongation3)
		ThisForm.txtRed_area3.Value 	= IIF(ISNULL(LakeErie_log.Red_Area3),0,LakeErie_log.Red_Area3)
		ThisForm.txtRockwell3.Value 	= IIF(ISNULL(LakeErie_log.Rockwell3),'',LakeErie_log.Rockwell3)
		ThisForm.txtBHN3.Value 			= IIF(ISNULL(LakeErie_log.BHN3),0,LakeErie_log.BHN3)
		
		ThisForm.txtAC_ID.Value		= PrepareSQLnum(LakeErie_log.AC_ID,'AC_ID',-3)
		
		ThisForm.chkPassed.Value 		= IIF(ISNULL(LakeErie_log.Passed),.F.,LakeErie_log.Passed)
		ThisForm.chkCustomerMat.Value 	= IIF(ISNULL(LakeErie_log.CustomerMat),.F.,LakeErie_log.CustomerMat)
		ThisForm.chkChart.Value 		= IIF(ISNULL(LakeErie_log.Chart),.F.,LakeErie_log.Chart)
		ThisForm.txtHTRockwell.Value 	= IIF(ISNULL(LakeErie_log.HTRockwell),'',LakeErie_log.HTRockwell)
		ThisForm.txtHTBHN.Value 		= IIF(ISNULL(LakeErie_log.HTBHN),0,LakeErie_log.HTBHN)
		ThisForm.txtID.Value			= LakeErie_log.ID
		
		IF ISNULL(LakeErie_log.ChartData) 
			ThisForm.cmdChartData.Caption = "Add"
		ELSE
			IF LakeErie_log.ChartData
				ThisForm.cmdChartData.Caption = "Export"
			ELSE
				ThisForm.cmdChartData.Caption = "Add"
			ENDIF
		ENDIF
		
		IF USED('tmpShip')
			USE IN tmpShip
		ENDIF
		
		IF NOT ISNULL( LakeErie_log.SOitem )
			IF VAL(RIGHT( LakeErie_log.SOitem,2 ))>1
				
				cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+LakeErie_log.SOitem+"')"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpShip' )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL, 'tmpShip' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'tmpShip' )
				ENDIF
					
				IF USED('tmpShip')
					ThisForm.txtCompany.Value	= tmpShip.Company
					ThisForm.txtSalesP.Value	= tmpShip.SalesP
					IF tmpShip.DueDate > CTOD('12/30/1900')
						ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
					ELSE
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ENDIF
					
					IF tmpShip.ShipDate > CTOD('12/30/1900')
						ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
					ELSE
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
					USE IN tmpShip
				ELSE &&USED('tmpShip')
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&Not Item Number
				IF LakeErie_log.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(LakeErie_log.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&LakeErie_log.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			
			ENDIF
		ELSE  &&ISNULL( LakeErie_log.SOitem )
			IF NOT ISNULL(LakeErie_log.SalesNum)
				IF LakeErie_log.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(LakeErie_log.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&LakeErie_log.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&ISNULL(LakeErie_log.SalesNum)
				ThisForm.txtCompany.Value	= ''
				ThisForm.txtSalesP.Value	= ''
				ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
				ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
			ENDIF
		ENDIF
		
		ThisForm.DupLots()
		
		SELECT LakeErie_log
		
	ENDPROC

	PROCEDURE save_log
		*ThisForm.Save_log()
		
		PRIVATE cAlloyName, dDate, cHeat, nLot
		PRIVATE nSpiece,nFpiece,nSsize,nRollsize,nSlength,nFsize,nSweight,nFlength
		PRIVATE cCondition,nColdWork,cSpec,cHTreat,nSalesNum,nItemSO,cSOitem
		PRIVATE nOvenTemp,cPO,cNotes,nSrvcPO,nTestPO,nTestItemPO,dTestSent,cLab
		PRIVATE nMinutes,nLaborP,nOvenp,nCGp
		PRIVATE nTensile,nYield,nElongation,nRed_Area,cRockwell,nBHN
		PRIVATE nTensile2,nYield2,nElongation2,nRed_Area2,cRockwell2,nBHN2
		PRIVATE nTensile3,nYield3,nElongation3,nRed_Area3,cRockwell3,nBHN3
		PRIVATE lPassed,lCustomerMat,lChart,cHTRockwell,nHTBHN,nID
		PRIVATE nSwidth, nFwidth
		
		cAlloyName	= PrepareSQLtxt(ThisForm.txtAlloyName.Value,'AlloyName',12)
		dDate		= PrepareSQLdate(ThisForm.txtDate.Value,'Date')
		cHeat		= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		nLot		= PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		nSpiece		= PrepareSQLnum(ThisForm.txtSpiece.Value,'sPiece',5,1)
		nFpiece		= PrepareSQLnum(ThisForm.txtFpiece.Value,'fPiece',5,0)
		nSsize		= PrepareSQLnum(ThisForm.txtSsize.Value,'sSize',9,3)
		nSwidth		= PrepareSQLnum(ThisForm.txtSWidth.Value,'sWidth',9,3)
		nRollsize	= PrepareSQLnum(ThisForm.txtRollSize.Value,'Rollsize',9,3)
		nSlength	= PrepareSQLnum(ThisForm.txtSlength.Value,'sLength',9,3)
		nFsize		= PrepareSQLnum(ThisForm.txtFsize.Value,'fSize',9,3)
		nFwidth		= PrepareSQLnum(ThisForm.txtFWidth.Value,'fWidth',9,3)
		nSweight	= PrepareSQLnum(ThisForm.txtSweight.Value,'sWeight',8,1)
		nFlength	= PrepareSQLnum(ThisForm.txtFlength.Value,'fLength',9,3)	
		cCondition	= PrepareSQLtxt(ThisForm.txtCondition.Value,'Condition',10)
		nColdWork	= PrepareSQLnum(ThisForm.txtColdWork.Value,'ColdWork',0,3)	
		cSpec		= PrepareSQLtxt(ThisForm.txtSpec.Value,'Spec',50)		
		cHTreat		= PrepareSQLtxt(ThisForm.txtHTreat.Value,'Heat Treat',16)
		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		nItemSO		= PrepareSQLnum(ThisForm.txtItemSO.Value,'Item SO',2,0)
		IF nItemSO < 1
			cSOitem		= ' 0-00'
		ELSE
			cSOitem		= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSO))
		ENDIF
		nOvenTemp	= PrepareSQLnum(ThisForm.txtOvenTemp.Value,'OvenTemp',4,0)
		cPO			= PrepareSQLtxt(ThisForm.txtPO.Value,'PO',50)
		cNotes		= PrepareSQLtxt(ThisForm.edtNotes.Value,'Notes',-1)
		nSrvcPO		= PrepareSQLnum(ThisForm.txtSrvcPO.Value,'SrvcPO',-3)
		nTestPO		= PrepareSQLnum(ThisForm.txtTestPO.Value,'TestPO',-3)
		nTestitemPO	= PrepareSQLnum(ThisForm.txtTestItemPO.Value,'TestItemPO',2,0)
		dTestSent	= PrepareSQLdate(ThisForm.txtTestSent.Value,'TestSent')
		cLab		= PrepareSQLtxt(ThisForm.txtLab.Value,'Lab',12)
		nMinutes	= PrepareSQLnum(ThisForm.txtMinutes.Value,'Minutes',4,0)
		nLaborP		= PrepareSQLnum(ThisForm.txtLaborP.Value,'LaborP',8,2)
		nOvenp		= PrepareSQLnum(ThisForm.txtOvenp.Value,'Ovenp',8,2)
		nCGp		= PrepareSQLnum(ThisForm.txtCGp.Value,'CGp',8,2)
		nTensile	= PrepareSQLnum(ThisForm.txtTensile.Value,'Tensile',6,0)
		nYield		= PrepareSQLnum(ThisForm.txtYield.Value,'Tensile',6,0)
		nElongation	= PrepareSQLnum(ThisForm.txtElongation.Value,'Elongation',4,1)
		nRed_Area	= PrepareSQLnum(ThisForm.txtRed_area.Value,'Red_Area',4,1)
		cRockwell	= PrepareSQLtxt(ThisForm.txtRockwell.Value,'Rockwell',4)
		nBHN		= PrepareSQLnum(ThisForm.txtBHN.Value,'BHN',3,0)
		
		nTensile2	= PrepareSQLnum(ThisForm.txtTensile2.Value,'Tensile2',6,0)
		nYield2		= PrepareSQLnum(ThisForm.txtYield2.Value,'Tensile2',6,0)
		nElongation2= PrepareSQLnum(ThisForm.txtElongation2.Value,'Elongation2',4,1)
		nRed_Area2	= PrepareSQLnum(ThisForm.txtRed_area2.Value,'Red_Area2',4,1)
		cRockwell2	= PrepareSQLtxt(ThisForm.txtRockwell2.Value,'Rockwell2',4)
		nBHN2		= PrepareSQLnum(ThisForm.txtBHN2.Value,'BHN2',3,0)
		
		nTensile3	= PrepareSQLnum(ThisForm.txtTensile3.Value,'Tensile3',6,0)
		nYield3		= PrepareSQLnum(ThisForm.txtYield3.Value,'Tensile3',6,0)
		nElongation3= PrepareSQLnum(ThisForm.txtElongation3.Value,'Elongation3',4,1)
		nRed_Area3	= PrepareSQLnum(ThisForm.txtRed_area3.Value,'Red_Area3',4,1)
		cRockwell3	= PrepareSQLtxt(ThisForm.txtRockwell3.Value,'Rockwell3',4)
		nBHN3		= PrepareSQLnum(ThisForm.txtBHN3.Value,'BHN3',3,0)
		
		PRIVATE nAC_ID 
		nAC_ID = PrepareSQLnum(ThisForm.txtAC_ID.Value,'AC_ID',-3)
		
		lPassed		= PrepareSQLchk(ThisForm.chkPassed.Value,'Passed',.F.)
		lCustomerMat = PrepareSQLchk(ThisForm.chkCustomerMat.Value,'Customers Mat',.F.)
		lChart		= PrepareSQLchk(ThisForm.chkChart.Value,'Chart',.F.)
		
		cHTRockwell	= PrepareSQLtxt(ThisForm.txtHTRockwell.Value,'HT Rockwell',4)
		nHTBHN		= PrepareSQLnum(ThisForm.txtHTBHN.Value,'HT BHN',3,0)
		
		nID			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		*************************
		*Test Data
		IF VARTYPE(nColdWork) <> "N"
			MESSAGEBOX("Reduction of Area needs to be less than 1.",48,"Cannot save!")
			RETURN .F.
		ENDIF
		IF nColdWork >= 1
			MESSAGEBOX("Reduction of Area needs to be a Decimal, less than 1.",48,"Cannot save!")
			RETURN .F.
		ENDIF
		** STR(nColdWork,4,3) Returns ****  ????
		IF VAL(STR(nColdWork,4,3))=0
			nColdWork=0.000
		ENDIF
		
		*************************
		
		IF nID = 0
			*Add
			
			IF nLot = 0
				*get Lot
				  
				IF USED('tmpCountLot')	
					USE IN tmpCountLot
				ENDIF
		
				cSQL = "SELECT MAX(Lot) AS MaxLot FROM dbo.LakeErie_log"
						
				SELECT 0
				nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpCountLot')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpCountLot')
				ENDDO
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,THISFORM.ConnHandle, nSQLEXEC, 'tmpCountLot')
				ELSE
					IF USED('tmpCountLot')
						IF tmpCountLot.MaxLot > 0
						
							nLot = tmpCountLot.MaxLot+1
							ThisForm.txtLot.Value = nLot
							ThisForm.Lots.Caption = '1'
						ENDIF
						USE IN tmpCountLot 
					ENDIF
				ENDIF
			ENDIF
		
		
			cSQL = "INSERT INTO dbo.LakeErie_log "
			cSQL = cSQL + "(AlloyName, [Date], Heat, Lot"
			cSQL = cSQL + ",Spiece,Fpiece,Ssize,Swidth,Rollsize,Slength,[Fsize],Fwidth,Sweight,Flength"
			cSQL = cSQL + ",Condition,ColdWork,Spec,HTreat,SalesNum,ItemSO,SOitem"
			cSQL = cSQL + ",OvenTemp,PO,Notes,SrvcPO,TestPO,TestItemPO,TestSent,Lab"
			cSQL = cSQL + ",Minutes,LaborP,Ovenp,CGp"
			cSQL = cSQL + ",Tensile,Yield,Elongation,Red_Area,Rockwell,BHN"
			cSQL = cSQL + ",Tensile2,Yield2,Elongation2,Red_Area2,Rockwell2,BHN2"
			cSQL = cSQL + ",Tensile3,Yield3,Elongation3,Red_Area3,Rockwell3,BHN3"
			cSQL = cSQL + ",Passed,CustomerMat,Chart,HTRockwell,HTBHN"
			cSQL = cSQL + ") VALUES "
			cSQL = cSQL + "('"+cAlloyName+"','"+IIF(EMPTY(dDate),'',DTOC(dDate))+"','"+cHeat+"',"+STR(nLot,11,0)
			cSQL = cSQL + ","+STR(nSpiece,6,1)+","+STR(nFpiece,5,0)+","+STR(nSsize,10,3)+","+STR(nSwidth,10,3)+","+STR(nRollsize,10,3)+","+STR(nSlength,10,3)+","+STR(nFsize,10,3)+","+STR(nFwidth,10,3)+","+STR(nSweight,8,1)+","+STR(nFlength,10,3)
			cSQL = cSQL + ",'"+cCondition+"',"+STR(nColdWork,4,3)+",'"+cSpec+"','"+cHTreat+"',"+STR(nSalesNum)+","+STR(nItemSO,2,0)+",'"+cSOitem+"'"
			cSQL = cSQL + ","+STR(nOvenTemp,4,0)+",'"+cPO+"','"+cNotes+"',"+STR(nSrvcPO,10,0)+","+STR(nTestPO,10,0)+","+STR(nTestItemPO,2,0)+",'"+IIF(EMPTY(dTestSent),'',DTOC(dTestSent))+"'"+",'"+cLab+"'"
			cSQL = cSQL + ","+STR(nMinutes,4,0)+","+STR(nLaborP,9,2)+","+STR(nOvenp,9,2)+","+STR(nCGp,9,2)
			cSQL = cSQL + ","+STR(nTensile,6,0)+","+STR(nYield,6,0)+","+STR(nElongation,5,1)+","+STR(nRed_Area,5,1)+",'"+cRockwell+"',"+STR(nBHN,4,1)
			cSQL = cSQL + ","+STR(nTensile2,6,0)+","+STR(nYield2,6,0)+","+STR(nElongation2,5,1)+","+STR(nRed_Area2,5,1)+",'"+cRockwell2+"',"+STR(nBHN2,4,1)
			cSQL = cSQL + ","+STR(nTensile3,6,0)+","+STR(nYield3,6,0)+","+STR(nElongation3,5,1)+","+STR(nRed_Area3,5,1)+",'"+cRockwell3+"',"+STR(nBHN3,4,1)
			cSQL = cSQL + ","+IIF(lPassed,'1','0')+","+IIF(lChart,'1','0')+","+IIF(lCustomerMat,'1','0')+",'"+cHTRockwell+"',"+STR(nHTBHN,4,1)
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC )
			ELSE
				WAIT WINDOW 'Saved!' NOWAIT
			ENDIF
			
		ELSE
			*Update
			PRIVATE cSQLu
			cSQL = "UPDATE dbo.LakeErie_log SET "
			cSQL = cSQL + "AlloyName='"+cAlloyName+"'"
			cSQL = cSQL +",[Date]='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
			cSQL = cSQL +",Heat='"+cHeat+"'"
			cSQL = cSQL +",Lot="+STR(nLot,11,0)
			cSQL = cSQL +",sPiece="+STR(nSpiece,6,1)
			cSQL = cSQL +",fPiece="+STR(nFpiece,5,0)
			cSQL = cSQL +",sSize="+STR(nSsize,10,3)
			cSQL = cSQL +",sWidth="+STR(nSwidth,10,3)
			cSQL = cSQL +",Rollsize="+STR(nRollsize,10,3)
			cSQL = cSQL +",sLength="+STR(nSlength,10,3)
			cSQL = cSQL +",fSize="+STR(nFsize,10,3)
			cSQL = cSQL +",fWidth="+STR(nFwidth,10,3)
			cSQL = cSQL +",sWeight="+STR(nSweight,8,1)
			cSQL = cSQL +",fLength="+STR(nFlength,10,3)
			cSQL = cSQL +",Condition='"+cCondition+"'"
			cSQL = cSQL +",ColdWork="+STR(nColdWork,4,3)+""
			cSQL = cSQL +",Spec='"+cSpec+"'"
			cSQL = cSQL +",HTreat='"+cHTreat+"'"
			cSQL = cSQL +",SalesNum="+STR(nSalesNum)
			cSQL = cSQL +",ItemSO="+STR(nItemSO,2,0)
			cSQL = cSQL +",SOitem='"+cSOitem+"'"
			cSQL = cSQL +",OvenTemp="+STR(nOvenTemp,4,0)
			cSQL = cSQL +",PO='"+cPO+"'"
			cSQL = cSQL +",Notes='"+cNotes+"'"
			cSQL = cSQL +",SrvcPO="+STR(nSrvcPO,10,0)
			cSQL = cSQL +",TestPO="+STR(nTestPO,10,0)
			cSQL = cSQL +",TestItemPO="+STR(nTestItemPO,2,0)
			cSQL = cSQL +",TestSent='"+IIF(EMPTY(dTestSent),'',DTOC(dTestSent))+"'"
			cSQL = cSQL +",Lab='"+cLab+"'"
			cSQL = cSQL +",Minutes="+STR(nMinutes,4,0)
			cSQL = cSQL +",LaborP="+STR(nLaborP,9,2)
			cSQL = cSQL +",Ovenp="+STR(nOvenp,9,2)
			cSQL = cSQL +",CGp="+STR(nCGp,9,2)
			cSQL = cSQL +",Tensile="+STR(nTensile,6,0)
			cSQL = cSQL +",Yield="+STR(nYield,6,0)
			cSQL = cSQL +",Elongation="+STR(nElongation,5,1)
			cSQL = cSQL +",Red_area="+STR(nRed_Area,5,1)
			cSQL = cSQL +",Rockwell='"+cRockwell+"'"
			cSQL = cSQL +",BHN="+STR(nBHN,4,1)
			cSQL = cSQL +",Tensile2="+STR(nTensile2,6,0)
			cSQL = cSQL +",Yield2="+STR(nYield2,6,0)
			cSQL = cSQL +",Elongation2="+STR(nElongation2,5,1)
			cSQL = cSQL +",Red_area2="+STR(nRed_Area2,5,1)
			cSQL = cSQL +",Rockwell2='"+cRockwell2+"'"
			cSQL = cSQL +",BHN2="+STR(nBHN2,4,1)
			cSQL = cSQL +",Tensile3="+STR(nTensile3,6,0)
			cSQL = cSQL +",Yield3="+STR(nYield3,6,0)
			cSQL = cSQL +",Elongation3="+STR(nElongation3,5,1)
			cSQL = cSQL +",Red_area3="+STR(nRed_Area3,5,1)
			cSQL = cSQL +",Rockwell3='"+cRockwell3+"'"
			cSQL = cSQL +",BHN3="+STR(nBHN3,4,1)
			cSQL = cSQL +",Passed="+IIF(lPassed,'1','0')
			cSQL = cSQL +",CustomerMat="+IIF(lCustomerMat,'1','0')
			cSQL = cSQL +",Chart="+IIF(lChart,'1','0')
			cSQL = cSQL +",HTRockwell='"+cHTRockwell+"'"
			cSQL = cSQL +",HTBHN="+STR(nHTBHN,4,1)
			cSQL = cSQL + " WHERE ID="+STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC )
			ELSE
				WAIT WINDOW 'Updated!' NOWAIT
			ENDIF
			
		ENDIF
		
		PRIVATE cUserTrack 
		cUserTrack = "INSERT INTO dbo.LakeErie_log ColdWork:"
		cUserTrack = cUserTrack+" STR as 4,3:"+STR(nColdWork,4,3)
		cUserTrack = cUserTrack+" STR as 5,3:"+STR(nColdWork,5,3)
		cUserTrack = cUserTrack+" STR as 9,4:"+STR(nColdWork,9,4)
		cUserTrack = cUserTrack+" TXT as C10:"+PrepareSQLtxt(nColdWork,'ColdWork',10)
		cUserTrack = cUserTrack +" VarType="+VARTYPE(nColdWork)
		cUserTrack = cUserTrack +" nLot="+ALLTRIM(STR(nLot))
		cUserTrack = cUserTrack +" --used to find the ColdWork='****' error"
		TrackMess(cUserTrack)
		**
		
		ThisForm.UpDatePO()
		
		********************************
		*Update dbo.AcctCosting
		
		IF nAC_ID > 0
			AcctCost_MachineLot_Update(nAC_ID, "LAKEERIE", nLot)
		ENDIF
		
		*Refresh LakeErie_log data
		ThisForm.Load_Log(nID)
		
		RETURN .T.
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.ConnHandle)
		
	ENDPROC

	PROCEDURE updatepo		&& Update the Purchase Order database
		*UpdatePO()
		
		*SELECT LakeErie_log
		*IF !EMPTY(LakeErie_log.TestPO)
		*!*	IF !EMPTY(ThisForm.txtTestpo.Value)
		*!*		PRIVATE nHPAPO, nItemPo, cPOitem, cCompany, dOrderdate, cSalesp
		*!*		nHPAPO		= PrepareSQLnum(ThisForm.txtTestpo.Value,'HPAPO',-3)
		*!*		nItemPO		= PrepareSQLnum(ThisForm.txtTestItemPO.Value,'Item PO',2,0)
		*!*		IF nItemPO = 0
		*!*			nItemPO = 1
		*!*		ENDIF
		*!*		cPOitem		= Proper_PO_Item(STR(nHPAPO)+"-"+STR(nItemPO,2,0))
		*!*		cCompany	= PrepareSQLtxt(ThisForm.txtLab.Value,'Company',30)
		*!*		dOrderdate	= PrepareSQLdate(ThisForm.txtTestsent.Value,'OrderDate')
		*!*		dOrderdate	= IIF(EMPTY(dOrderdate),DATE(),dOrderdate)
		*!*		cSalesp 	= ' '
		*!*		PRIVATE nSalesNum, nItemSO, cSOitem
		*!*		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesnum.Value,'SalesNum',-3)
		*!*		nItemSO		= PrepareSQLnum(ThisForm.txtItemSO.Value,'Item SO',2,0)
		*!*		cSOitem		= Proper_SO_Item(STR(nSalesNum)+"-"+STR(nItemSO))
		*!*		PRIVATE cAlloy, cForm, nFsize, nRollsize, nSsize, nThck
		*!*		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloyName.Value,'AlloyName',12)
		*!*		cForm		= '10'
		*!*		nFsize		= PrepareSQLnum(ThisForm.txtFsize.Value,'Fsize',9,4)
		*!*		nRollsize	= PrepareSQLnum(ThisForm.txtRollSize.Value,'RollSize',9,4)
		*!*		nSsize		= PrepareSQLnum(ThisForm.txtSsize.Value,'Ssize',9,4)
		*!*		nThck		= IIF(EMPTY(nFsize),IIF(EMPTY(nRollsize),nSsize,nRollsize),nFsize)
		*!*		PRIVATE nTensile, nYield, nElongation, nRed_Area, cRockwell, nBHN, lPassed, lComplete, nPieces
		*!*		nTensile	= PrepareSQLnum(ThisForm.txtTensile.Value,'Tensile',6,0)
		*!*		nYield		= PrepareSQLnum(ThisForm.txtYield.Value,'Yield',6,0)
		*!*		nElongation	= PrepareSQLnum(ThisForm.txtElongation.Value,'Elongation',4,1)
		*!*		nRed_Area	= PrepareSQLnum(ThisForm.txtRed_Area.Value,'Red_Area',4,1)
		*!*		cRockwell	= PrepareSQLtxt(ThisForm.txtRockwell.Value,'Rockwell',4)
		*!*		nBHN 		= PrepareSQLnum(ThisForm.txtBHN.Value,'BHN',3,0)
		*!*		lPassed		= PrepareSQLchk(ThisForm.chkPassed.Value,'Passed',.T.)
		*!*		lComplete 	= !EMPTY(nTensile) OR !EMPTY(nYield) OR !EMPTY(nElongation) OR !EMPTY(nRed_Area) OR !EMPTY(cRockwell) OR !EMPTY(nBHN) OR lPassed
		*!*		nPieces		= 1
		*!*		PRIVATE nSz2,nSz3,nP_lb,nP_pc,nP_ft, nLotP,cOtherFld,nOtherP,nOrder_Qty
		*!*		nSz2		= 0
		*!*		nSz3		= 0
		*!*		nP_lb		= 0
		*!*		nP_pc		= 0
		*!*		nP_ft		= 0
		*!*		nLotP		= 0
		*!*		cOtherFld	= ''
		*!*		nOtherP		= 0
		*!*		nOrder_Qty	= 0
		*!*		PRIVATE cShipVia,cJobNumber,dDue_Min,dDue_Max
		*!*		cShipVia	= ''
		*!*		cJobNumber	= ''
		*!*		dDue_Min	= dOrderdate + 1
		*!*		dDue_Max	= dOrderdate + 7
		*!*		Private cPOSalesP
		*!*		cPOSalesP 	= PrepareSQLtxt(ThisForm.txtSalesp.Value,'SalesP',1)
		*!*	*	cCompany 	= PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		*!*		PRIVATE cCond_Spec, cSpec, cMisc_Purch, lServicesPO, cStock, lSheet_pk, nRoll_lot
		*!*		nRoll_lot	= PrepareSQLnum(ThisForm.txtLot.Value,'Roll Lot',-3)
		*!*		cCond_Spec	= 'Roll Log:'+ALLTRIM(STR(nRoll_lot))
		*!*		cSpec		= PrepareSQLtxt(ThisForm.txtSpec.Value,'Spec',50)
		*!*		cMisc_Purch	= "Testing:"+cSpec
		*!*		lServicesPO	= .T.
		*!*		cStock		= ''
		*!*		lSheet_pk	= .F.
		*!*		PRIVATE nShipWhere,nPOShipAddr,nPOPayAddr,cDispAlloy,lRandLen
		*!*		nShipWhere	= 0
		*!*		nPOShipAddr	= 0
		*!*		nPOPayAddr	= 0
		*!*		cDispAlloy	= cAlloy
		*!*		lRandLen	= .F.
		*!*		
		*!*		********
		*!*		PRIVATE nCntPOitem 
		*!*		nCntPOitem = Count_POIteminPurchaseOrder( cPOitem, ThisForm.ConnHandle )
		*!*		
		*!*		IF nCntPOitem = 0
		*!*	*!*				INSERT INTO PurchaseOrder ;
		*!*	*!*					(HpaPO,poItem,itempo ,SalesNum, SOItem, ITEM,  company, orderdate, Due_Max, alloy, FORM, Thck, misc_purch, Delivered, Salesp,company) VALUES ;
		*!*	*!*					(nHPAPO, cPOitem, 1, nSalesNum,cSOitem,nItemSO,cCompany,dOrderdate,dDue_Max,cAlloy,cForm,nThck,cMisc_Purch,lComplete,cPOSalesP,cCompany)
		*!*			PRIVATE cSQLi
		*!*			cSQLi = "INSERT INTO dbo.PurchaseOrder "
		*!*			cSQLi = cSQLi + "(HPApo,poItem,itempo,SalesNum,soItem,ITEM,Salesp,orderdate,company,alloy,FORM,Pieces,Thck,Sz2,Sz3,P_lb,P_pc,P_ft,LotP,OtherFld,OtherP,Order_Qty"
		*!*			cSQLi = cSQLi + ",Delivered,POSalesP,ShipVia,JobNumber,Due_Min,Due_Max,Cond_Spec,Misc_Purch,Services,Stock,Sheet_Pk,ShipWhere,POShipAddr,POPayAddr,DispAlloy,RandLen) VALUES "
		*!*			cSQLi = cSQLi + "("+STR(nHPApo)+",'"+cPOItem+"',"+STR(nItemPo,2,0)+","+STR(nSalesNum)+",'"+cSOItem+"',"+STR(nItemSO,2,0)+",'"+cSalesp+"'"
		*!*			cSQLi = cSQLi + ",'"+DTOC(dOrderdate)+"','"+cCompany+"','"+cAlloy+"','"+cForm+"'"
		*!*			cSQLi = cSQLi + ","+STR(nPieces,6,0)+","+STR(nThck,10,4)+","+STR(nSz2,9,3)+","+STR(nSz3,9,3)+","+STR(nP_lb,8,2)+","+STR(nP_pc,9,2)+","+STR(nP_ft,8,2)
		*!*			cSQLi = cSQLi + ","+STR(nLotP,9,2)+",'"+cOtherFld+"',"+STR(nOtherP,8,2)+","+STR(nOrder_Qty,12,3)+","+IIF(lComplete,'1','0')+""
		*!*			cSQLi = cSQLi + ",'"+cPOSalesP+"','"+cShipVia+"','"+cJobNumber+"','"+DTOC(dDue_Min)+"','"+DTOC(dDue_Max)+"'"
		*!*			cSQLi = cSQLi + ",'"+cCond_Spec+"','"+cMisc_Purch+"',"+IIF(lServicesPO,'1','0')+",'"+cStock+"',"+IIF(lSheet_pk,'1','0')
		*!*			cSQLi = cSQLi + ","+STR(nShipWhere,1,0)+","+STR(nPOShipAddr)+","+STR(nPOPayAddr)+",'"+cDispAlloy+"',"+IIF(lRandLen,'1','0')+")"
		
		*!*			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQLi )
		*!*			
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQLi )
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLi, ThisForm.ConnHandle, nSQLEXEC )
		*!*			ELSE
		*!*				TrackMess( "Roll Log:"+ALLTRIM(STR(nRoll_lot))+" added POitem:"+ALLTRIM(cPOitem)+" to PurchaseOrder table.")
		*!*				lPOSaveLst = .T.
		*!*			ENDIF
		
		*!*		ELSE
		*!*			*	IF MESSAGEBOX("PO Number-Item:"+ALLTRIM(m.poItem)+" already exist."+CHR(13)+"Cancel/Clear this save and Edit!"+CHR(13)+"If want to overwrite the old values with these, "+CHR(13)+"Answer YES, and Update the values.",4+16,"Can not add this PO as new, Update old record?") = 6
		*!*			nCntPOitem = Count_POIteminPurchaseOrder( cPOitem, ThisForm.ConnHandle, "Delivered" )
		*!*			IF nCntPOitem = 0
		*!*				IF MESSAGEBOX( "Did you just save new properties from a test lab?"+CHR(13)+"Can the PO be marked as Complete?",4+32,"Complete the PO")=6
		*!*					dDate = DATE()
		*!*					lDelivered = .T.
		*!*					PRIVATE cSQLu
		*!*					cSQLu = "UPDATE dbo.PurchaseOrder SET "
		*!*					cSQLu = cSQLu + " Received='"+IIF( EMPTY(dDate),'',DTOC(dDate) )+"'"
		*!*					cSQLu = cSQLu + ",Delivered="+IIF(lDelivered,'1','0')
		*!*					cSQLu = cSQLu + " WHERE PurchaseOrder.poItem = dbo.f_ProperPOitem('"+cPOItem+"')"
		
		*!*					nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQLu )
		
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQLu )
		*!*					ENDDO
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQLu, ThisForm.ConnHandle, nSQLEXEC )
		*!*					ELSE
		*!*						lPOSaveLst = .T.
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		
		*!*	ENDIF
		SELECT LakeErie_log
	ENDPROC

	PROCEDURE chkChart.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE chkCustomerMat.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE chkPassed.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE cmdAdd.Valid
		SELECT LakeErie_log
		
		ThisForm.isediting=.T.
		ThisForm.IsAdding=.T.
		ThisForm.cmdEdit.Caption="Save"
		ThisForm.cmdDel.Caption="Abort"
		ThisForm.cmdTop.enabled = .F.
		ThisForm.cmdPrev.enabled = .F.
		ThisForm.cmdNext.enabled = .F.
		ThisForm.cmdEnd.enabled = .F.
		ThisForm.cmdSeeAll.enabled = .F.
		ThisForm.cmdCert.enabled = .F.
		ThisForm.cmdSO.enabled = .F.
		ThisForm.cmdRA.enabled = .F.
		*ThisForm.cmdSsheet.enabled = .F.
		ThisForm.cmdBrow.enabled = .F.
		ThisForm.cmdReport.enabled = .F.	
		ThisForm.cmdBalloy.enabled = .F.	
		ThisForm.cmdClone.enabled = .F.	
		ThisForm.cmdAdd.enabled = .F.	
		ThisForm.cmdPrint.enabled = .F.	
		ThisForm.cmdClose.enabled = .F.	
		ThisForm.cmdStockLst.Enabled = .F.
		ThisForm.cmdPDF.Enabled = .F.
		
		*	SCATTER MEMVAR MEMO BLANK
		*	INSERT INTO LakeErie_log FROM MEMVAR
		
		ThisForm.txtAlloyName.Value = ''
		ThisForm.txtDate.Value 		= DATE()
		ThisForm.txtHeat.Value 		= ''
		ThisForm.txtLot.Value 		= 0
		ThisForm.txtSpiece.Value 	= 0
		ThisForm.txtFpiece.Value 	= 0
		ThisForm.txtSsize.Value 	= 0
		ThisForm.txtRollSize.Value 	= 0
		ThisForm.txtSlength.Value 	= 0
		ThisForm.txtFsize.Value 	= 0
		ThisForm.txtFwidth.Value 	= 0
		ThisForm.txtSweight.Value 	= 0
		ThisForm.txtFlength.Value 	= 0
		ThisForm.txtFwidth.Value 	= 0
		ThisForm.txtCondition.Value = ''
		ThisForm.txtColdWork.Value 	= 0
		ThisForm.txtSpec.Value 		= ''
		ThisForm.txtHTreat.Value 	= ''
		ThisForm.txtSalesNum.Value 	= 0
		ThisForm.txtItemSO.Value 	= 0
		ThisForm.txtOvenTemp.Value 	= 0
		ThisForm.txtPO.Value 		= ''
		ThisForm.edtNotes.Value 	= ''
		ThisForm.txtTestPO.Value 	= 0
		ThisForm.txtSrvcPO.Value 	= 0
		ThisForm.txtTestItemPO.Value= 1
		ThisForm.txtTestSent.Value 	= CTOD("  /  /  ")
		ThisForm.txtLab.Value 		= ''
		ThisForm.txtMinutes.Value 	= 0
		ThisForm.txtLaborP.Value 		= 0
		ThisForm.txtOvenp.Value 	= 0
		ThisForm.txtCGp.Value 		= 0
		ThisForm.txtTensile.Value 	= 0
		ThisForm.txtYield.Value 	= 0
		ThisForm.txtElongation.Value= 0
		ThisForm.txtRed_area.Value 	= 0
		ThisForm.txtRockwell.Value 	= ''
		ThisForm.txtBHN.Value 		= 0
		ThisForm.txtTensile2.Value 	= 0
		ThisForm.txtYield2.Value 	= 0
		ThisForm.txtElongation2.Value= 0
		ThisForm.txtRed_area2.Value 	= 0
		ThisForm.txtRockwell2.Value 	= ''
		ThisForm.txtBHN2.Value 		= 0
