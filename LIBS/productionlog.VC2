	PROCEDURE cmdStock.Click
		
		PRIVATE cAlloy, nThck, nWidth
		cAlloy	= PrepareSQLtxt(ThisForm.txtR_alloy33.Value,'Alloy',12)
		nThck	= PrepareSQLnum(ThisForm.txtD123.Value,'Thck',10,3)
		nWidth	= PrepareSQLnum(ThisForm.txtWd1.Value,'Sz2',9,3)
		DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE",'S',cAlloy,"10","1"," ",nThck,nWidth,0,'',0,1,0,'',0,.T.,''
		*PARAMETER pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem
	ENDPROC

	PROCEDURE cmdView.Click
		PRIVATE ctxt
		
		*IF ThisForm.nConnHandle = 0
		*	ThisForm.Load_ReductionArea()
		*ENDIF
		
		IF NOT USED("ReductionArea")
			ThisForm.Load_ReductionArea()
		ENDIF
		
		IF USED("ReductionArea")
			PRIVATE cTxt
			PRIVATE m.D1, m.D2, m.L1, m.sL1, m.L2, m.sL2, m.sD1, m.sD2, m.sWid
			m.D1	= PrepareSQLnum(ThisForm.txtD123.Value,'D1',9,3)
			m.D2	= PrepareSQLnum(ThisForm.txtD225.Value,'D2',9,3)
			m.L1	= PrepareSQLnum(ThisForm.txtL124.Value,'L1',9,3)
			m.sL1	= PrepareSQLnum(ThisForm.txtM_sl129.Value,'sL1',9,3)
			m.L2	= PrepareSQLnum(ThisForm.txtL126.Value,'L2',9,3)
			m.sL2	= PrepareSQLnum(ThisForm.txtM_sl231.Value,'sL2',9,3)
			m.sD1	= PrepareSQLnum(ThisForm.txtM_sd127.Value,'sD1',9,3)
			m.sD2	= PrepareSQLnum(ThisForm.txtM_sd228.Value,'sD2',9,3)
			m.sWid	= PrepareSQLnum(ThisForm.txtWd1.Value,'sWid',9,3)
			
			PRIVATE m.Alloy, m.W1, m.sW1, m.RA, m.sRA
			m.Alloy	= PrepareSQLtxt(ThisForm.txtR_alloy33.Value,'Alloy',12)
			m.W1	= PrepareSQLnum(ThisForm.txtW134.Value,'W1',7,1)
			m.sW1	= PrepareSQLnum(Thisform.txtM_sW135.Value,'sW1',7,1)
			m.RA	= PrepareSQLnum(ThisForm.txtRA36.Value,'RA',0,3)
			m.sRA	= PrepareSQLnum(Thisform.txtM_sRA37.Value,'sRA',0,3)
			
			SELECT ReductionArea
			ctxt = "  START    Entered     Calc                FINISH    entered     calc"
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = "  Thick "+STR(m.d1,9,3)+" "+STR(m.sd1,9,3)+SPACE(15)+"  Thick "+STR(m.D2,9,3)+" "+STR(m.sD2,9,3)
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			IF m.sWid > 0
				ctxt = "   Width "+STR(m.sWid,9,3)
				INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ENDIF
			ctxt = " Length "+STR(m.L1,9,3)+" "+STR(m.sL1,9,3)+SPACE(15)+" Length "+STR(m.L2,9,3)+" "+STR(m.sL2,9,3)
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = " "
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = "   ALLOY "+m.Alloy +SPACE(30)+"WEIGHT "+STR(m.W1,9,1)+"  "+STR(m.sW1,9,1)
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = " "
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = "         RA "+STR(m.ra,8,6)+"       "+STR(m.sRA,8,6)
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = " "
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
		
			INSERT INTO ReductionArea (txt) VALUES (REPLICATE("-",80))
		ENDIF
		
	ENDPROC

	PROCEDURE txtR_alloy33.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle)
		*	SEEK UPPER(lcSearchStr) ORDER TAG UppAlloys IN Alloys
		*	IF FOUND("Alloys")
			IF NOT EMPTY(lcTryAlloy)		
			
		*		IF UPPER(lcSearchStr) = SUBSTR(Alloys.Alloy,1,lnInsertionPt)
		*			THIS.VALUE=Alloys.Alloy
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtR_alloy33.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtR_alloy33.Valid
		IF ThisForm.nConnHandle = 0
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard(pCurAlloy, ThisForm.nConnHandle)
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
		*		IF 6 = MESSAGEBOX( "Is this a new alloy to be added ?"+CHR(13)+"'No' to try again"+CHR(13)+CHR(13)+"Otherwise erase Alloy to save record."+CHR(13)+"You can fix alloy name in 'AlloyStandard' of Quote menu.",4+32,"Alloy not found! ")
		*			INSERT_Alloy( pCurAlloy, gnConnHandle )
		*			RETURN .T.
		*		ELSE
					THIS.FORECOLOR = RGB(255,128,128)
					RETURN .F.
		*		ENDIF
			ENDIF
			
		ENDIF
		
	ENDPROC

ENDDEFINE

