	PROCEDURE savestock_projected
		*ThisForm.SaveStock_Projected()
		
		PRIVATE nID, cCompany, cAlloy, cForm, cCC, cCL, nThck
		PRIVATE cSpec_CC, cSpec_CL, nYearInches, nYearPounds, nMinPounds
		PRIVATE nOverSize, nSThck, nSNomThck, nCW ,dSdate
		PRIVATE lUT, lCncld, cSpec_CC, cSpec_CL, cFollowM, nFollowLot
		      
		nID			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		cCompany	= PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3)
		cSpec_CC	= PrepareSQLtxt(ThisForm.txtSpec_CC.Value,'Spec_CC',1)
		cSpec_CL	= PrepareSQLtxt(ThisForm.txtSpec_CL.Value,'Spec_CL',1)
		nYearInches	= PrepareSQLnum(ThisForm.txtYearInches.Value,'YearInches',-3)
		nYearPounds	= PrepareSQLnum(ThisForm.txtYearPounds.Value,'YearPounds',-3)
		nMinPounds	= PrepareSQLnum(ThisForm.txtMinPounds.Value,'MinPounds',-3)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		nSThck		= PrepareSQLnum(ThisForm.txtSThck.Value,'SThck',9,3)
		nSNomThck	= PrepareSQLnum(ThisForm.txtSNomThck.Value,'SNomThck',9,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		*dSdate		= PrepareSQLdate(ThisForm.txtSDate.Value,'SDate')
		*nPoundsTaken	= PrepareSQLnum(ThisForm.txtPoundsTaken.Value,'PoundsTaken',-3)
		lUT			= PrepareSQLchk(ThisForm.chkUT.Value,'UT')
		lCncld		= PrepareSQLchk(ThisForm.chkCncld.Value,'Cncld')
		cSpec_CC	= PrepareSQLtxt(ThisForm.txtSpec_CC.Value,'CC',1)
		cSpec_CL	= PrepareSQLtxt(ThisForm.txtSpec_CL.Value,'CL',1)
		cFollowM	= PrepareSQLtxt(ThisForm.txtFollowM.Value,'FollowM',20)
		nFollowLot	= PrepareSQLnum(ThisForm.txtFollowLot.Value,'FollowLot',-3)
		
		
		IF nID = 0
			*INSERT
			
			cSQL = "INSERT INTO dbo.Stock_Projected ("
			cSQL = cSQL + " Company,Alloy,Form,CC,CL,Thck "
			cSQL = cSQL + ",YearInches,YearPounds "
			cSQL = cSQL + ",MinPounds,OverSize,SThck,SNomThck,CW "
			cSQL = cSQL + ",UT, Spec_CC, Spec_CL, FollowM,FollowLot "
			cSQL = cSQL + ",LastEdit, Cncld "
			cSQL = cSQL + ") Values ("
			cSQL = cSQL + " '"+cCompany+"'"
			cSQL = cSQL + ",'"+cAlloy+"'"
			cSQL = cSQL + ",'"+cForm+"'"
			cSQL = cSQL + ",'"+cCC+"'"
			cSQL = cSQL + ",'"+cCL+"'"
			cSQL = cSQL + ","+STR(nThck,9,3)
			cSQL = cSQL + ","+STR(nYearInches,10)
			cSQL = cSQL + ","+STR(nYearPounds,10)
			cSQL = cSQL + ","+STR(nMinPounds,10)
			cSQL = cSQL + ","+STR(nOverSize,5,3)
			cSQL = cSQL + ","+STR(nSThck,9,3)
			cSQL = cSQL + ","+STR(nSNomThck,9,3)
			cSQL = cSQL + ","+STR(nCW,4,0)
		
			cSQL = cSQL + ","+IIF(lUT,'1','0')
			cSQL = cSQL + ",'"+cSpec_CC+"'"
			cSQL = cSQL + ",'"+cSpec_CL+"'"
			cSQL = cSQL + ",'"+cFollowM+"'"
			cSQL = cSQL + ","+STR(nFollowLot,10)
			cSQL = cSQL + ",GetDate()"
			cSQL = cSQL + ","+IIF(lCncld,'1','0')
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC )
			ELSE
				ThisForm.InitProjStock(-1)
			ENDIF
		
		ELSE
			*UPDATE
			cSQL = "UPDATE dbo.Stock_Projected SET "
			cSQL = cSQL + " Company = '"+cCompany+"'"
			cSQL = cSQL + ",Alloy='"+cAlloy+"'"
			cSQL = cSQL + ",Form='"+cForm+"'"
			cSQL = cSQL + ",CC='"+cCC+"'"
			cSQL = cSQL + ",CL='"+cCL+"'"
			cSQL = cSQL + ",Thck="+STR(nThck,9,3)
			cSQL = cSQL + ",YearInches="+STR(nYearInches,10)
			cSQL = cSQL + ",YearPounds="+STR(nYearPounds,10)
			cSQL = cSQL + ",MinPounds="+STR(nMinPounds,10)
			cSQL = cSQL + ",OverSize="+STR(nOverSize,5,3)
			cSQL = cSQL + ",SThck="+STR(nSThck,9,3)
			cSQL = cSQL + ",SNomThck="+STR(nSNomThck,9,3)
			cSQL = cSQL + ",CW="+STR(nCW,4,0)
		*	cSQL = cSQL + ",Sdate='"+DTOC(dSdate)+"'"
		*	cSQL = cSQL + ",PoundsTaken="+STR(nPoundsTaken,10)
			cSQL = cSQL + ",UT="+IIF(lUT,'1','0')
		
			cSQL = cSQL + ",Spec_CC='"+cSpec_CC+"'"
			cSQL = cSQL + ",Spec_CL='"+cSpec_CL+"'"
		
			cSQL = cSQL + ",FollowM='"+cFollowM+"'"
			cSQL = cSQL + ",FollowLot="+STR(nFollowLot,10)
			cSQL = cSQL + ",LastEdit = GetDate() "
			cSQL = cSQL + ",Cncld="+IIF(lCncld,'1','0')
			cSQL = cSQL + " WHERE ID ="+STR(nID)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC )
			ELSE
				ThisForm.InitProjStock(nID)
			ENDIF
			
		ENDIF
		
	ENDPROC

