	PROCEDURE txtDuerdate.Refresh
		
		PRIVATE dShipDate, dDueDate
		dShipDate	= ThisForm.txtShipdate.Value
		dDueDate	= ThisForm.txtDuerdate.Value
		
		This.Visible = !EMPTY(dDueDate)
		
		
		IF !EMPTY(dDueDate) AND EMPTY(dShipDate) AND DATE() > dDueDate
		* If there is a due date and no shipdate
		* and the date is greater than the duedate
			This.DisabledBackColor = RGB(255,0,0)
			This.DisabledForeColor = RGB(255,255,255)
		ELSE
		 	This.DisabledBackColor = RGB(0,191,96)
		 	This.DisabledForeColor = RGB(64,0,64)
		ENDIF
	ENDPROC

