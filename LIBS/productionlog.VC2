	PROCEDURE cmdClose.Valid
		IF WEXIST("frmLog_Detail")
			RELEASE WINDOWS frmLog_Detail
		ENDIF
		
		IF WEXIST("frmGFM_Hard_Prof")
			RELEASE WINDOWS frmGFM_Hard_Prof
		ENDIF
		
		THISFORM.Release
		
			m.bailout=.T.	&&this is needed if used with FoxApp
		*!*		WAIT WINDOW 'BACKING UP' NOWAIT
		*!*		IF USED('gfmlog')
		*!*			SELECT GFMLOG
		*!*			m.cursafe = set('safety')
		*!*			set safety off
		*!*			IF IIF(FILE('C:\GFMlog.DBF'),FDATE('C:\GFMlog.dbf'),DATE()-1) <DATE()
		*!*				COPY TO c:\gfmlog.dbf
		*!*			ENDIF
		*!*			DO CASE
		*!*			CASE NOT FILE('gfmlog Backup.dbf')
		*!*				COPY TO "gfmlog Backup.dbf"
		*!*			CASE FDATE('gfmlog Backup.dbf') < FDATE("c:\gfmlog.DBF")
		*!*				COPY TO "gfmlog Backup.dbf"
		*!*			CASE FDATE('gfmlog Backup.dbf') = FDATE("c:\gfmlog.DBF") AND FTIME("c:\gfmlog.DBF") > FTIME("gfmlog Backup.dbf")
		*!*				COPY TO "gfmlog Backup.dbf"
		*!*			ENDCASE
		*!*			set safety &cursafe
		*!*			USE
		*!*		ENDIF
		*!*		WAIT CLEAR
		*	m.salesp = m.salespp
			*replace the m.salesp value
		*!*		
		*!*		CLEAR READ
		*!*		IF USED('inquire')
		*!*			RETURN
		*!*		ELSE
		*!*			return
		*!*		ENDIF
		
	ENDPROC

	PROCEDURE cmdDel.Valid
		SELECT GFMLOG
		IF ThisForm.isediting 	&&cancel record
			IF ThisForm.IsAdding
		*		=TABLEREVERT()
				GO BOTTOM 
				ThisForm.RefreshGFMlog()
				ThisForm.Refresh
			ENDIF
			ThisForm.edtNotes.ReadOnly = .T.
			
			ThisForm.isediting=.F.
			ThisForm.IsAdding=.F.
		*	UNLOCK
		
			this.Caption="\<Delete"
			ThisForm.cmdEdit.Caption="\<Edit"
			ThisForm.cmdTop.enabled = .T.
			ThisForm.cmdPrev.enabled = .T.
			ThisForm.cmdNext.enabled = .T.
			ThisForm.cmdEnd.enabled = .T.
			ThisForm.cmdSeeAll.enabled = .T.
			ThisForm.cmdCert.enabled = .T.
			ThisForm.cmdSO.enabled = .T.
			ThisForm.cmdRA.enabled = .T.
		*	ThisForm.cmdSsheet.enabled = .T.
			ThisForm.cmdBrow.enabled = .T.
			ThisForm.cmdReport.enabled = .T.
			ThisForm.cmdBalloy.enabled = .T.
			ThisForm.cmdClone.enabled = .T.
			ThisForm.cmdAdd.enabled = .T.
			ThisForm.cmdPrint.enabled = .T.
			ThisForm.cmdClose.enabled = .T.
			ThisForm.cmdPDF.Enabled = .T.
			ThisForm.cmdStockLst.Enabled = .T.
		
			WAIT WINDOW 'Cancelled' NOWAIT
			thisform.Refresh
		
		ELSE
			SELECT GFMLOG 
			
			IF MESSAGEBOX("Are you sure you want to Delete?",32,"Delete LOT") !=6
				RETURN -1
			ENDIF
			
			IF NOT HavePermission('DeleteMFGlog',.T.)
				MESSAGEBOX('You are not allowed to Delete')
				RETURN -1
			ENDIF
			
			
			PRIVATE nID, cSQL, nSQLEXEC 
			nID = ThisForm.txtID.Value
			
			IF nID > 0
				cSQL = "DELETE FROM dbo.GFMLog WHERE ID ="+STR(nID)
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC )
				ELSE
					WAIT WINDOW 'Deleted record!' NOWAIT
					ThisForm.LoadLog()			
				ENDIF
				
			ENDIF
		
		*		IF EOF()
		*			WAIT WINDOW 'End of file.' NOWAIT
		*			GO BOTTOM
		*		ENDIF
			
		
			
			thisform.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE cmdEdit.Valid
		*SELECT GFMLOG
		
		IF !ThisForm.isediting &&edit record
			*Start Editing
			IF EOF() OR BOF()
				WAIT WINDOW 'End of File' NOWAIT
				RETURN
			ENDIF
			
			ThisForm.edtNotes.ReadOnly = .F.
			ThisForm.GetLatestData()
			
			ThisForm.isediting=.T.
			this.Caption="Save"
			ThisForm.cmdDel.Caption="Abort"
			ThisForm.cmdTop.enabled = .F.
			ThisForm.cmdPrev.enabled = .F.
			ThisForm.cmdNext.enabled = .F.
			ThisForm.cmdEnd.enabled = .F.
			ThisForm.cmdSeeAll.enabled = .F.
			ThisForm.cmdCert.enabled = .F.
			ThisForm.cmdSO.enabled = .F.
			ThisForm.cmdRA.enabled = .F.
		*		ThisForm.cmdSsheet.enabled = .F.
			ThisForm.cmdBrow.enabled = .F.
			ThisForm.cmdReport.enabled = .F.
			ThisForm.cmdBalloy.enabled = .F.
			ThisForm.cmdClone.enabled = .F.
			ThisForm.cmdAdd.enabled = .F.
			ThisForm.cmdPrint.enabled = .F.
			ThisForm.cmdClose.enabled = .F.
			ThisForm.cmdPDF.Enabled = .F.
			ThisForm.cmdStockLst.Enabled = .F.
			ThisForm.txtAlloyname.SetFocus
			thisform.Refresh
			RETURN
		
		ELSE
			*SAVE!
			
		
			IF ThisForm.CheckSave()
				IF ThisForm.SaveGFMlog()
					*calls ThisForm.LoadLog(nID)
						*calls ThisForm.RefreshGFMlog()
							*calls DO FORM Forms\Log_Detail WITH "GFMLOG", GFMLog.ID, ThisForm.nConnHandle, nTop, nLeft
				
					ThisForm.edtNotes.ReadOnly = .T.
					
					This.Caption="Ed\<it"
					ThisForm.cmdDel.Caption="\<Delete"
					ThisForm.cmdTop.enabled = .T.
					ThisForm.cmdPrev.enabled = .T.
					ThisForm.cmdNext.enabled = .T.
					ThisForm.cmdEnd.enabled = .T.
					ThisForm.cmdSeeAll.enabled = .T.
					ThisForm.cmdCert.enabled = .T.
					ThisForm.cmdSO.enabled = .T.
					ThisForm.cmdRA.enabled = .T.
				*	ThisForm.cmdSsheet.enabled = .T.
					ThisForm.cmdBrow.enabled = .T.
					ThisForm.cmdReport.enabled = .T.
					ThisForm.cmdBalloy.enabled = .T.
					ThisForm.cmdClone.enabled = .T.
					ThisForm.cmdAdd.enabled = .T.
					ThisForm.cmdPrint.enabled = .T.
					ThisForm.cmdClose.enabled = .T.
					ThisForm.cmdPDF.Enabled = .T.
					ThisForm.cmdStockLst.Enabled = .T.
						
					ThisForm.isediting=.F.
					ThisForm.IsAdding=.F.
					
					Thisform.Refresh
					
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdEnd.Click
		=ThisForm.DupLots()
	ENDPROC

	PROCEDURE cmdEnd.Message
		RETURN 'Go to last record.'
	ENDPROC

	PROCEDURE cmdEnd.Valid
		IF USED('GFMLog')
			SELECT GFMLOG
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened.",0+48,"Reload table")
			ThisForm.LoadLog()
		ENDIF
		
		GO BOTTOM
		WAIT WINDOW 'End of File' NOWAIT
		
		ThisForm.RefreshGFMLog()
		ThisForm.Refresh
	ENDPROC

	PROCEDURE cmdHardProf.Click
		*RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE cmdNext.Valid
		IF USED('GFMLog')
			SELECT GFMLOG
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened at End.",0+48,"Reload table")
			ThisForm.LoadLog()
		ENDIF
		
		IF !EOF()
			SKIP 1
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM
		ENDIF
		ThisForm.RefreshGFMLog()
		*ThisForm.DupLots()
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmdPDF.Valid
		SELECT GFMLog
		PRIVATE curgrec
		curgrec = RECNO('GFMLog')
		PRIVATE nLot
		nLot = IIF(ISNULL(GFMLog.Lot),0,GFMLog.Lot)
		
		*LOCAL loFile, loOutPutOptions, loPreviewOptions, lcReportFullName, lcReportFile, lcExportPath, lcErrorMessage, lcVersion
		
		PRIVATE lcReportFullName
		lcReportFullName = FULLPATH('reports\GFMLog.FRX')
		*lcReportFile	= "GFMLog"+ALLTRIM(STR(nLot,10,0))
		*lcExportPath	= SYS(5)+SYS(2003)+"\"
		
		
			*****************************
			Local loListener As "PdfListener" Of "Pdfx.vcx"
		
			loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
			loListener.cCodePage="CP1252" &&CodePage
			loListener.cTargetFileName = cFileName
			loListener.QuietMode=.F.
			loListener.lCanPrint=.T.
			loListener.lCanEdit=.F.
			loListener.lCanCopy=.T.
			loListener.lCanAddNotes=.F.
			loListener.lEncryptDocument=.F.
			loListener.cMasterPassword=''
			loListener.cUserPassword=''
			loListener.lOpenViewer=.F.
		
			ThisForm.Visible = .F.
		
			SELECT SalesQuote
			IF FILE('\reports\ROLL_Log.FRX')
				*REPORT FORM \reports\ConfSalesOrder Object loListener
				*REPORT FORM \reports\ROLL_Log RECORD (curgrec) TO PRINT PROMPT NOCONSOLE
				REPORT FORM \reports\ROLL_Log RECORD (curgrec) Object loListener
				WAIT WINDOW "REPORT FORM \reports\ROLL_Log Object loListener" TIMEOUT 1
			ELSE
				IF FILE('reports\ROLL_Log.FRX')
					REPORT FORM reports\ROLL_Log Object loListener
					WAIT WINDOW "REPORT FORM reports\ROLL_Log Object loListener" TIMEOUT 1
				ELSE
					WAIT WINDOW "Report form '\reports\ROLL_Log' not found" TIMEOUT 4
					TrackError("Send Email Error","Report form '\reports\ROLL_Log' not found","ROLL_Log:cmdPDF.Valid",LINENO(1))
				ENDIF
			ENDIF
		
			ThisForm.Visible = .T.
			RELEASE loListener
		
		
			PRIVATE nCount
			nCount = 0
			DO WHILE NOT FILE(cFileName) AND nCount < 3
				WAIT WINDOW "Waiting for file:"+cFileName+" to be made." TIMEOUT 1
				nCount = nCount + 1
			ENDDO
		
			SET PRINTER OFF
			SET PRINTER TO DEFAULT
			GO TOP IN SalesQuote
		
			cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName )
			WAIT WINDOW "Finished Send routine" TIMEOUT 2
		
			DO CASE
			CASE "Mail queued" $ cAns
				WAIT WINDOW "Mail queued." NOWAIT
				TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was Emailed to ("+cQouteEmail+") on ("+DTOC(DATE())+")"+" EditOrder.cmdConfirmSO.Click()")
				Save_Sales_Status( ThisFormSet.SalesNum, 'Email', 'Email Sales Order Confirmation', ThisFormSet.nConnHandle )
			CASE NOT EMPTY(cAns)
				MESSAGEBOX( cANS,0,"SQL Returned Message!")
			OTHERWISE
				WAIT WINDOW "Email Complete" NOWAIT
				TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was Emailed to ("+cQouteEmail+") on ("+DTOC(DATE())+")"+" EditOrder.cmdConfirmSO.Click()")
				Save_Sales_Status( ThisFormSet.SalesNum, 'Email', 'Email Sales Order Confirmation', ThisFormSet.nConnHandle )
			ENDCASE
		*ENDIF
		
		***********************************************
		
		SELECT GFMLog
		GO curgrec
		RETURN
		
	ENDPROC

	PROCEDURE cmdPrev.Valid
		IF USED('GFMLog')
			SELECT GFMLOG
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened at End.",0+48,"Reload table")
			ThisForm.LoadLog()
		ENDIF
		
		IF !BOF()
			SKIP -1
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file - Use See All for more!' NOWAIT
			GO TOP
		ENDIF
		ThisForm.RefreshGFMLog()
		*ThisForm.DupLots()
		Thisform.refresh
	ENDPROC

	PROCEDURE cmdPrint.Valid
		IF USED('GFMLog')
			SELECT GFMLOG
			PRIVATE curgrec
			curgrec = RECNO('gfmlog')
			IF curgrec <= RECCOUNT('GFMLOG')
				REPORT FORM reports\gfmlog RECORD (curgrec) TO PRINT PROMPT NOCONSOLE
				SELECT gfmlog
				GO curgrec
			ELSE
				MESSAGEBOX('Record pointer off!'+CHR(13)+'Try to go prev and next to fix.',0+16,"Not on a record.")
			ENDIF
		ELSE
			MESSAGEBOX('Record pointer off!'+CHR(13)+'Try to go prev and next to fix.',0+16,"Not on a record.")
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdRA.Valid
		SELECT GFMLOG
		DO CASE
		*CASE FILE('\program files\VFP\GFM\Forms\RedArea.scx')
		*	DO FORM '\program files\VFP\GFM\Forms\RedArea'
		*CASE FILE('\program files\VFP\GFM\RedArea.EXE')
		*	DO '\program files\VFP\GFM\RedArea.EXE'
		CASE FILE('Forms\RedArea.SCX')
			DO FORM Forms\RedArea
		OTHERWISE
			redarea=LOCFILE("redarea","EXE","Find Reduction of Area")
			IF "REDAREA" $ UPPER(redarea)
				DO FORM (redarea)
			ELSE
				WAIT WINDOW 'Reduction of Area Program not found' NOWAIT
			ENDIF
		ENDCASE
		SELECT gfmlog
		
	ENDPROC

