	PROCEDURE show_rtr_detail
		*ThisForm.Show_RTR_Detail()
		ThisForm.txtDetail.Value 		= tmpRTR_Detail.Detail
		ThisForm.txtDetail_StartDate.Value = PrepareSQLdate(tmpRTR_Detail.StartDate,'StartDate',.F.)
		ThisForm.txtDetail_StartTime.Value = PrepareSQLtime(tmpRTR_Detail.StartDate,'StartDate',.F.)
		ThisForm.txtJobType.Value 		= tmpRTR_Detail.JobType
		ThisForm.chkD_Started.Value 	= PrepareSQLlogic(tmpRTR_Detail.Started,'Started')
		ThisForm.chkD_Finished.Value 	= PrepareSQLlogic(tmpRTR_Detail.Finished,'Finished')
		ThisForm.chkD_Cncld.Value		= PrepareSQLlogic(tmpRTR_Detail.Cncld,'Cncld')
		ThisForm.txtOper_ID.Value		= tmpRTR_Detail.Oper_ID
		ThisForm.txtDetail_FinishDate.Value = PrepareSQLdateTime(tmpRTR_Detail.FinishDate,'FinishDate',.F.)
		ThisForm.txtOperation.Value		= tmpRTR_Detail.Operation
		ThisForm.txtJobClass.Value		= tmpRTR_Detail.jobClass
		ThisForm.edtOper_Note.Value		= tmpRTR_Detail.Oper_Note
	ENDPROC

