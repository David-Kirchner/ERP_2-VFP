	PROCEDURE check_for_needs		&& Look at Sales for GFM or CG
		PARAMETERS pType 
		*ThisForm.Check_for_Needs()
		
		IF pType != 'ROUTER'
			*Came in with rtr, hide other controls
			ThisForm.grdRTR.Visible = .F.
			ThisForm.cmdPrintID.Visible = .F.
			ThisForm.og.Visible = .F.
			ThisForm.lblFiltered.Visible = .F.
			ThisForm.cmbOrderType.Visible = .F.
			ThisForm.cmbJobClass.Visible = .F.
			
			ThisForm.lblFind.Visible = .F.
			ThisForm.txtFind.Visible = .F.
			ThisForm.cmdFind.Visible = .F.	
		ENDIF
		
		
		DO CASE
		CASE pType = "ROUTER"
		CASE pType = "SOitem"
		CASE pType = "POitem"  
		CASE pType = "WorkOrder"
		CASE pType = "WO_Detail"
		CASE pType = "PURCHASE ORDER"
		CASE pType = "SALES ORDER"
		CASE pType = "QUOTE"
		*CASE pType = "InqNumP"
		ENDCASE
		
	ENDPROC

	PROCEDURE Destroy
		IF USED('tmpRTR_Detail')
			USE IN tmpRTR_Detail
		ENDIF
		
		IF USED("tmpRTR_DetailS")	
			USE IN tmpRTR_DetailS
		ENDIF
		
		IF USED("tmpRTR_ID")	
			USE IN tmpRTR_ID
		ENDIF
		
		IF USED("tmpRTR_Orders")	
			USE IN tmpRTR_Orders
		ENDIF
		
		IF USED('tmpOrderType')
			USE IN tmpOrderType
		ENDIF
		
		IF USED('tmpJobClass')
			USE IN tmpJobClass
		ENDIF
		
		
		
		*IF "ROUTER" $ SET("CLASSLIB")
		*	RELEASE CLASSLIB "LIBS\ROUTER"
		*ENDIF
		
		
		
	ENDPROC

	PROCEDURE dynamicbackcolor_rtr		&& grdRTR
		PRIVATE nColor
		*ThisForm.DynamicBackColor_RTR()
		
		*Called from grdRTR.Column1.DynamicBackColor()
		*Place most important color first!
		
		DO CASE
		CASE tmpRTR_ID.Finished
			nColor = RGB( 255,128,64 ) &&ORANGE
		CASE tmpRTR_ID.Started
			nColor = RGB( 192, 220, 192 )  &&GREEN
		OTHERWISE
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		*IIF(tmpRTR_ID.Finished,RGB( 255,128,64 ), IIF(tmpRTR_ID.Started,RGB( 192, 220, 192 ),RGB( 255, 255, 255 )))
		RETURN nColor
	ENDPROC

	PROCEDURE dynamicbackcolor_rtrd		&& grdRTR_Detail
		*ThisForm.DynamicBackColor_rtrD()
		
		PRIVATE nColor
		
		
		*Called from grdRTR_Detail.Column1.DynamicBackColor()
		*Place most important color first!
		
		DO CASE
		CASE tmpRTR_Detail.Cncld_D
			nColor = RGB( 255, 0, 0 ) &&RED
		CASE tmpRTR_Detail.Finished
			nColor = RGB( 128, 128, 128 )  &&Grey
		CASE tmpRTR_Detail.Started
			nColor = RGB( 192, 220, 192 )  &&GREEN
			*Packed
			
		
		*	nColor = RGB( 255,128,64 ) &&ORANGE
		*	nColor = RGB( 255, 255, 128 ) &&YELLOW
		*	nColor = RGB( 128, 255, 255 ) &&Lt Blue
			
		OTHERWISE
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		*	
		*	nColor = RGB( 128, 128, 128 )  &&Grey
		*	nColor = RGB( 255,128,64 ) &&ORANGE
		*	nColor = RGB( 255, 255, 128 ) &&YELLOW
		
		IIF(tmpRTR_Detail.Cancelled, RGB( 255, 0, 0 ), IIF( tmpRTR_Detail.Finished, RGB( 128, 128, 128 ), IIF( tmpRTR_Detail.Started, RGB( 192, 220, 192 ),RGB( 255, 255, 255 ))))
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE Load
		*"tmpRTR_ID"
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		*IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*	SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		*ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE loadrtr		&& Load RTR
		PARAMETERS pID
		*ThisForm.LoadRTR(rtrID)
		*called from another screen, only show this ID
		PRIVATE biID
		biID = 0
		
		IF VARTYPE(pID) = 'N'
			biID = pID
		ENDIF
		
		PRIVATE lFoundRTR
		lFoundRTR = .F.
		
		*****************************************
		IF USED("tmpRTR_ID")	
			ThisForm.grdRTR.RecordSource = ''
			USE IN tmpRTR_ID
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT ID "
		cSQL = cSQL + ",dbo.f_rtr_Min_Started (ID,MIN(rtrD.Detail)) AS [Started] "
		cSQL = cSQL + ",dbo.f_rtr_Max_Finished (ID,Max(rtrD.Detail)) AS [Finished] "
		*cSQL = cSQL + ",MIN(rtrD.Detail) AS MinD "
		*cSQL = cSQL + ",Max(rtrD.Detail) AS MaxD "
		cSQL = cSQL + " ,rtr.cncld AS cncld_ID "
		cSQL = cSQL + " FROM dbo.rtr "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.rtr_Detail rtrD ON rtr.ID = rtrD.rtr_ID "
		cSQL = cSQL + " WHERE rtr.ID = "+STR(biID,19,0)
		*cSQL = cSQL + " WHERE rtrD.Cncld = 0 "
		cSQL = cSQL + " GROUP BY rtr.ID, rtr.cncld "
		cSQL = cSQL + " ORDER BY rtr.ID DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_ID')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpRTR_ID')
		ELSE
			IF USED('tmpRTR_ID')
				IF RECCOUNT('tmpRTR_ID') > 0
					IF (biID) > 0
						SELECT tmpRTR_ID
						LOCATE FOR ID = STR(biID)
					ENDIF
					
					ThisForm.grdRTR.RecordSource = 'tmpRTR_ID'
					*ThisForm.grdRTR.Column1.DynamicBackColor = ThisForm.DynamicBackColor_rtr()
					*ThisForm.grdRTR.SetAll("dynamicbackcolor", "ThisForm.DynamicBackColor_rtr()", "Column")
					ThisForm.grdRTR.SetAll("dynamicbackcolor", "IIF(tmpRTR_ID.Finished,RGB( 255,128,64 ), IIF(tmpRTR_ID.Started,RGB( 192, 220, 192 ),RGB( 255, 255, 255 )))", "Column")
					lFoundRTR = .T.
				ENDIF
		
			ENDIF
		ENDIF
		
		IF NOT lFoundRTR
			ThisForm.cmdAdd.Caption = "Add" &&Sets screen for adding!!
			ThisForm.cmdAdd.Click()
		
			*MESSAGEBOX("No rtr_Detail data",16,"Could not load Router")
			*RecordError( nSQLEXEC, 'Could not load Router', PROGRAM(), LINENO(1),cSQL )
		
			*RETURN .F.
		ENDIF
		
		ThisForm.Refresh_RTR()
		
		
		
		
	ENDPROC

	PROCEDURE loadrtr_detail		&& Load RTR_Detail
		PARAMETERS pDetail
		*ThisForm.LoadRTR_Detail()
		
		PRIVATE biID, nDetail
		biID = PrepareSQLnum(tmpRTR_ID.ID,'rtr_ID',-4)
		
		IF VARTYPE(pDetail) = 'N'
			nDetail = pDetail
		ELSE
			nDetail = 0
		ENDIF
		
		PRIVATE lFoundRTR_Detail
		lFoundRTR_Detail = .F.
		
		*****************************************
		IF USED("tmpRTR_Detail")	
			ThisForm.grdRTR_Detail.RecordSource = ''
			USE IN tmpRTR_Detail
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT Detail "
		cSQL = cSQL + ",ISNULL(Started,0) AS Started "
		cSQL = cSQL + ",ISNULL(Finished,0) AS Finished "
		cSQL = cSQL + ",Cncld AS Cncld_D "
		cSQL = cSQL + " FROM dbo.rtr_Detail "
		cSQL = cSQL + " WHERE rtr_ID = "+ALLTRIM(STR(biID))
		cSQL = cSQL + " ORDER BY Detail"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_Detail')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpRTR_Detail')
		ELSE
			IF USED('tmpRTR_Detail')
				IF RECCOUNT('tmpRTR_Detail') > 0
				
					SELECT tmpRTR_Detail
					DELETE FOR Cncld_D = .T.
					
					SELECT tmpRTR_Detail
					IF nDetail > 0
						LOCATE FOR Detail = nDetail
						IF NOT FOUND()
							GO TOP
							nDetail = tmpRTR_Detail.Detail
						ENDIF
					ELSE
						GO TOP
						nDetail = tmpRTR_Detail.Detail
					ENDIF
					
					ThisForm.grdRTR_Detail.RecordSource = 'tmpRTR_Detail'
					*ThisForm.grdRTR_Detail.Column1.DynamicBackColor = ThisForm.DynamicBackColor_rtrD()
					*ThisForm.grdRTR_Detail.SetAll("dynamicbackcolor", "ThisForm.DynamicBackColor_rtrD()", "Column")
					ThisForm.grdRTR_Detail.SetAll("dynamicbackcolor", "IIF(tmpRTR_Detail.Cncld_D, RGB( 255, 0, 0 ), IIF( tmpRTR_Detail.Finished, RGB( 128, 128, 128 ), IIF( tmpRTR_Detail.Started, RGB( 192, 220, 192 ),RGB( 255, 255, 255 ))))", "Column")
					
					lFoundRTR_Detail = .T.
				ENDIF
		
			ENDIF
		ENDIF
		
		IF NOT lFoundRTR_Detail
			*MESSAGEBOX("Could not load Router Detail.",16,"No Data")
			nDetail = 0
			*RETURN .F.
		ENDIF
		
		ThisForm.Refresh_RTR_Detail(nDetail)
		
	ENDPROC

	PROCEDURE refresh_rtr		&& Refresh RTR
		*ThisForm.Refresh_RTR()
		
		ThisForm.txtSOitem.Value	= ''
		ThisForm.txtWO.Value		= 0
		ThisForm.txtWO_Detail.Value	= 0
		ThisForm.lblWO2.Caption		= ''
		ThisForm.txtQuote_ID.Value	= 0
		ThisForm.txtID.Value		= 0
		ThisForm.chkCncld_ID.Value	= 0	&&tmpRTR_Orders has the Cancelled data
		
		*ThisForm.chkCncl_RTR.Value  = PrepareSQLchk(tmpRTR_Orders.Cncld,'Cncld')
		PRIVATE biID
		biID = PrepareSQLnum(tmpRTR_ID.ID,'rtr_ID',-4)
		IF (biID) < 0
			MESSAGEBOX("No ID",16,"Could not Refresh")
			RETURN .F.
		ENDIF
		
		
		*****************************************
		IF USED("tmpRTR_Orders")	
			USE IN tmpRTR_Orders
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT * "
		cSQL = cSQL + ", 0 AS WO2 " 
		cSQL = cSQL + " FROM dbo.rtr "
		cSQL = cSQL + " WHERE ID = "+ALLTRIM(STR(biID))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_Orders')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpRTR_Orders')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpRTR_Orders')
		ELSE
			IF USED('tmpRTR_Orders')
				IF RECCOUNT('tmpRTR_Orders') > 0
					ThisForm.txtSOitem.Value	= PrepareSQLtxt(tmpRTR_Orders.SOitem,'SOitem',10)
					ThisForm.txtWO.Value		= PrepareSQLnum(tmpRTR_Orders.WO,'WO',-3) 
					ThisForm.lblWO2.Caption		= ''
					ThisForm.txtWO_Detail.Value	= PrepareSQLnum(tmpRTR_Orders.WO_Detail,'WO_Detail',-3)
					ThisForm.txtQuote_ID.Value	= PrepareSQLnum(tmpRTR_Orders.Quote_ID,'Quote ID',-3) 
					ThisForm.txtID.Value		= PrepareSQLnum(tmpRTR_Orders.ID,'ID',-4)
					ThisForm.txtOType_Num.Value = PrepareSQLtxt(tmpRTR_Orders.OType_Num,'OType_Num',15)
					
					ThisForm.chkCncld_ID.Value	= PrepareSQLchk(tmpRTR_Orders.Cncld,'Cncld')
					
					ThisForm.LoadRTR_Detail()
					
				ENDIF
				*USE IN tmpRTR_Orders  -keep open for printing reports
			ELSE
				
				* Do not LoadRTR_Detail, just refresh screen
				ThisForm.Refresh_RTR_Detail(0)
		
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE refresh_rtr_detail		&& Refresh RTR_Detail
		PARAMETERS pDetail
		*ThisForm.Refresh_RTR_Detail()
		
		ThisForm.chkCncld_D.Value 		= .F.
		
		ThisForm.txtDetail.Value		= 0
		ThisForm.txtEstStart.Value		= ''
		ThisForm.txtStartDate.Value		= ''
		ThisForm.chkStarted.Value		= 0
		
		ThisForm.txtEstFinish.Value		= ''
		ThisForm.txtFinishDate.Value	= ''
		ThisForm.chkFinished.Value		= 0
		
		ThisForm.txtOper_ID.Value		= 0
		ThisForm.txtOperation.Value		= ''
		ThisForm.edtOper_Note.Value		= ''
		Thisform.txtPoitem.Value		= ''
		ThisForm.lblPOCompany.Caption	= ''
		ThisForm.lblTBL_Prc.Caption 	= ''
		ThisForm.lblWO2.Caption			= ''
		
		ThisForm.txtRely_On.Value		= 0
		ThisForm.txtNext_Up.Value		= 0
		ThisForm.txtSynchro.Value		= 0
		
		ThisForm.txtEstTime.Value		= 0
		ThisForm.txtActTime.Value		= 0
		
		PRIVATE biID, nDetail
		biID	= PrepareSQLnum(tmpRTR_ID.ID,'rtr_ID',-4)
		nDetail = PrepareSQLnum(tmpRTR_Detail.Detail,'Detail',-3)
		
		IF VARTYPE(pDetail) = 'N'
			nDetail = pDetail
		ENDIF
		
		IF VARTYPE(nDetail)="U"
			MESSAGEBOX("No Detail",16,"Could not refresh Detail")
			RETURN .F.
		ENDIF
		
		IF nDetail < -1 
			MESSAGEBOX("No Detail",16,"Could not refresh Detail")
			RETURN .F.
		ENDIF
		
		IF nDetail = 0
			*Just leave
			*MESSAGEBOX("No rtr_detail",0,"Nothing to show")
			RETURN .T.
		ENDIF
		
		*****************************************
		IF USED("tmpRTR_DetailS")	
			USE IN tmpRTR_DetailS
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT * "
		cSQL = cSQL + ", ISNULL( ( "
		cSQL = cSQL + " SELECT TOP 1 WOD.WO "
		cSQL = cSQL + " FROM dbo.WorkOrder_Detail WOD "
		cSQL = cSQL + " INNER JOIN dbo.rtr ON WOD.WO_Detail = rtr.WO_Detail "
		cSQL = cSQL + " WHERE WOD.WO_Detail = rtr.WO_Detail "
		cSQL = cSQL + " AND rtr.ID = rtr_Detail.rtr_ID ),0) AS WO2 "
		cSQL = cSQL + ",ISNULL((SELECT PO.Company FROM dbo.PurchaseOrder PO WHERE PO.POitem = rtr_Detail.POitem ),'') AS POCompany "
		cSQL = cSQL + ",( SELECT OP.Operation FROM dbo.rtr_Operation OP WHERE OP.Oper_ID = rtr_Detail.Oper_ID ) AS Opera "
		cSQL = cSQL + " FROM dbo.rtr_Detail "
		
		IF nDetail = -1		&&All- used in print report
			cSQL = cSQL + " WHERE rtr_ID = "+ALLTRIM(STR(biID))
		ELSE
			cSQL = cSQL + " WHERE rtr_ID = "+ALLTRIM(STR(biID))
			cSQL = cSQL + " AND Detail = "+ALLTRIM(STR(nDetail))
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_DetailS')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_DetailS')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpRTR_DetailS')
		ELSE
			IF USED('tmpRTR_DetailS')
				IF RECCOUNT('tmpRTR_DetailS') > 0
					IF nDetail = -1	
					
					ELSE
						ThisForm.chkCncld_D.Value 		= PrepareSQLlogic(tmpRTR_DetailS.Cncld,'Cncld')
						
						ThisForm.txtDetail.Value		= PrepareSQLnum(tmpRTR_DetailS.Detail,'Detail',-3)
						ThisForm.txtEstStart.Value		= PrepareSQLdate(tmpRTR_DetailS.EstStart,'EstStart') 
						ThisForm.txtStartDate.Value		= PrepareSQLdate(tmpRTR_DetailS.StartDate,'StartDate')
						ThisForm.chkStarted.Value		= PrepareSQLchk(tmpRTR_DetailS.Started,'Started')
						
						ThisForm.txtEstFinish.Value		= PrepareSQLdate(tmpRTR_DetailS.EstFinish,'EstFinish') 
						ThisForm.txtFinishDate.Value	= PrepareSQLdate(tmpRTR_DetailS.FinishDate,'FinishDate')
						ThisForm.chkFinished.Value		= PrepareSQLchk(tmpRTR_DetailS.Finished,'Finished')
						
						ThisForm.txtOper_ID.Value		= PrepareSQLnum(tmpRTR_DetailS.Oper_ID,'Oper_ID',-3) 
		*				ThisForm.txtOperation.Value		= PrepareSQLtxt(tmpRTR_DetailS.Operation,'Operation',20)
						ThisForm.txtOperation.Value 	= Operations_Text(ThisForm.txtOper_ID.Value)
						
						ThisForm.edtOper_Note.Value		= PrepareSQLtxt(tmpRTR_DetailS.Oper_Note,'Oper_Note',-1)
						Thisform.txtPoitem.Value		= PrepareSQLtxt(tmpRTR_DetailS.Poitem,'Poitem',12)
						ThisForm.lblPOCompany.Caption	= PrepareSQLtxt(tmpRTR_DetailS.POcompany,'Company',30)
						ThisForm.lblTBL_Prc.Caption		= PrepareSQLtxt(tmpRTR_DetailS.TBL,'TBL',1)+"_"+PrepareSQLtxt(tmpRTR_DetailS.ID_Detail_Process,'ID_Detail_Process',10)
						
						IF PrepareSQLnum(tmpRTR_DetailS.WO2,'WO',-3) > 0
							ThisForm.lblWO2.Caption		= "WO "+ALLTRIM(PrepareSQLtxt(tmpRTR_DetailS.WO2,'WO',10))
						ELSE
							ThisForm.lblWO2.Caption		= ""
						ENDIF
						ThisForm.txtRely_On.Value		= PrepareSQLnum(tmpRTR_DetailS.Rely_On,'Rely_On',-3) 
						ThisForm.txtNext_Up.Value		= PrepareSQLnum(tmpRTR_DetailS.Next_Up,'Next_Up',-3) 
						ThisForm.txtSynchro.Value		= PrepareSQLnum(tmpRTR_DetailS.Synchro,'Synchro',-3) 
						
						ThisForm.txtEstTime.Value		= PrepareSQLnum(tmpRTR_DetailS.EstTime,'EstTime',-3) 
						ThisForm.txtActTime.Value		= PrepareSQLnum(tmpRTR_DetailS.ActTime,'ActTime',-3) 
					ENDIF
				ENDIF
				*USE IN tmpRTR_DetailS
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE router_init
		PARAMETERS pWhat,pType,pOrderNum
		*ThisForm.router_init(pWhat,pType,pOrderNum)
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ''
		ENDIF
		IF VARTYPE(pType) != "C"
			pType= ''
		ENDIF
		IF VARTYPE(pOrderNum) != "N"
			pOrderNum = 0
		ENDIF
		
		
		DO CASE
		CASE pType = "ROUTER"
			IF pWhat = "ADD"
			ENDIF
			*********
			IF pWhat = "EDIT"
				IF NOT USED("tmpRTR_ID")
					ThisForm.Loadrtr(pOrderNum)
				ENDIF
				IF USED("tmpRTR_ID")
					SELECT tmpRTR_ID
					LOCATE FOR ID = pOrderNum
					IF FOUND()
						ThisForm.Refresh_RTR()
					ELSE
					
					ENDIF
				ENDIF
			ENDIF
		CASE pType = "SOitem"
			IF pWhat = "ADD"
			ENDIF
			********
			IF pWhat = "EDIT"
				ThisForm.Search_RTR_Order("SO ITEM",pOrderNum)
				ThisForm.Check_for_Needs(pType)
			ENDIF
		
		CASE pType = "QUOTE"
			IF pWhat = "ADD"
			*Done at Quotes Screen
			*rtr_ID = Create_rtr_QID (nQoute_ID, pConnHandle)
			ENDIF
			********
			IF pWhat = "EDIT"
				ThisForm.Search_RTR_Order("QUOTE",pOrderNum)
				ThisForm.Check_for_Needs(pType)
			ENDIF
		
		*!*	CASE pType = "InqNumP"
		*!*		IF pWhat = "ADD"
		*!*			*Create_rtr_InqNumP(cInqNumP
		*!*			ThisForm.Search_RTR_Order("InqNumP",pOrderNum)
		*!*			ThisForm.Check_for_Needs(pType)
		
		*!*		ENDIF
		*!*		********
		*!*		IF pWhat = "EDIT"
		*!*			ThisForm.Search_RTR_Order("InqNumP",pOrderNum)
		*!*			ThisForm.Check_for_Needs(pType)
		*!*		ENDIF
			
		CASE pType = "POitem"  
			IF pWhat = "ADD"
			ENDIF
			********
			IF pWhat = "EDIT"
				ThisForm.Search_RTR_Order("PO ITEM",pOrderNum)
				ThisForm.Check_for_Needs(pType)
			ENDIF
		CASE pType = "WorkOrder"
			IF pWhat = "ADD"
			ENDIF
			********
			IF pWhat = "EDIT"
				ThisForm.Search_RTR_Order("WORKORDER",pOrderNum)
				ThisForm.Check_for_Needs(pType)
			ENDIF
		CASE pType = "WO_Detail"
			IF pWhat = "ADD"
			ENDIF
			********
			IF pWhat = "EDIT"
				ThisForm.Search_RTR_Order("WO DETAIL",pOrderNum)
				ThisForm.Check_for_Needs(pType)
			ENDIF
			
		CASE pType = "PURCHASE ORDER"
			*cSQL = cSQL + " WHERE dbo.f_ProperPO(rtrD.POitem) = "+STR(nOrderNum)
			IF pWhat = "ADD"
			ENDIF
			********
			IF pWhat = "EDIT"
				ThisForm.Search_RTR_Order("PURCHASE ORDER",pOrderNum)
				ThisForm.Check_for_Needs(pType)
			ENDIF
		CASE pType = "SALES ORDER"
		*	cSQL = cSQL + " WHERE dbo.f_ProperSO(rtr.SOitem) = "+STR(nOrderNum)
			IF pWhat = "ADD"
			ENDIF
			********
			IF pWhat = "EDIT"
				ThisForm.Search_RTR_Order("SALES ORDER",pOrderNum)
				ThisForm.Check_for_Needs(pType)
			ENDIF	
		ENDCASE
		
	ENDPROC

	PROCEDURE search_rtr_class
		PARAMETERS cJobClass,cJob
		*ThisForm.Search_RTR_Class(cJobClass,cJob)
		
		IF VARTYPE(cJobClass)!="C"
			RETURN .F.
		ENDIF
		IF EMPTY(cJob)
			RETURN .F.
		ENDIF
		
		*cJobClass = UPPER(cJobClass)
		*cJob = UPPER(cJob)
		
		*****************************************
		IF USED("tmpRTR_ID")	
			ThisForm.grdRTR.RecordSource = ''
			USE IN tmpRTR_ID
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT ID "
		cSQL = cSQL + ",dbo.f_rtr_Min_Started (ID,MIN(rtrD.Detail)) AS [Started] "
		cSQL = cSQL + ",dbo.f_rtr_Max_Finished (ID,Max(rtrD.Detail)) AS [Finished] "
		cSQL = cSQL + " ,rtr.cncld AS cncld_ID "
		cSQL = cSQL + " FROM dbo.rtr "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.rtr_Detail rtrD ON rtr.ID = rtrD.rtr_ID "
		cSQL = cSQL + " INNER JOIN rtr_Operation rtrO ON rtrD.Oper_ID = rtrO.Oper_ID"
		*cSQL = cSQL + " WHERE rtrD.Cncld = 0 "
		
		cSQL = cSQL + " AND rtrO.jobClass = '"+ cJobClass +"'"
		cSQL = cSQL + " AND rtrO.jobType = '"+ cJob +"'"  
		 
		cSQL = cSQL + " GROUP BY rtr.ID, rtr.cncld "
		cSQL = cSQL + " ORDER BY rtr.ID DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_ID')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpRTR_ID')
		ELSE
			IF USED('tmpRTR_ID')
				IF RECCOUNT('tmpRTR_ID') > 0
					ThisForm.grdRTR.RecordSource = 'tmpRTR_ID'
					*ThisForm.grdRTR.Column1.DynamicBackColor = ThisForm.DynamicBackColor_rtr()
					*ThisForm.grdRTR.SetAll("dynamicbackcolor", "ThisForm.DynamicBackColor_rtr()", "Column")
					ThisForm.grdRTR.SetAll("dynamicbackcolor", "IIF(tmpRTR_ID.Finished,RGB( 255,128,64 ), IIF(tmpRTR_ID.Started,RGB( 192, 220, 192 ),RGB( 255, 255, 255 )))", "Column")
					lFoundRTR = .T.
				ENDIF
			ELSE
				ThisForm.LoadRTR()
			ENDIF
		ENDIF
		
			
		ThisForm.Refresh_RTR()
	ENDPROC

	PROCEDURE search_rtr_order
		PARAMETERS cOrderType,pOrderNum
		*ThisForm.Search_RTR_Order(cOrderType,cOrderNumber)
		
		IF VARTYPE(cOrderType)!="C"
			RETURN .F.
		ENDIF
		IF EMPTY(pOrderNum)
			RETURN .F.
		ENDIF
		
		PRIVATE cOrderNum,nOrderNum
		cOrderNum = PrepareSQLtxt(pOrderNum,cOrderType,12)
		nOrderNum = PrepareSQLnum(pOrderNum,cOrderType,-3)
		cOrderType = UPPER(cOrderType)
		
		*****************************************
		IF USED("tmpRTR_ID")	
			ThisForm.grdRTR.RecordSource = ''
			USE IN tmpRTR_ID
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT ID "
		cSQL = cSQL + ",dbo.f_rtr_Min_Started (ID,MIN(rtrD.Detail)) AS [Started] "
		cSQL = cSQL + ",dbo.f_rtr_Max_Finished (ID,Max(rtrD.Detail)) AS [Finished] "
		cSQL = cSQL + " FROM dbo.rtr "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.rtr_Detail rtrD ON rtr.ID = rtrD.rtr_ID "
		
		DO CASE
		*CASE cOrderType = "MAINTENANCE"
		CASE cOrderType = "PO ITEM"
			cSQL = cSQL + " AND ISNULL(rtrD.POitem,'') = dbo.f_ProperPOitem("+cOrderNum+")"
		CASE cOrderType = "PURCHASE ORDER"
			cSQL = cSQL + " WHERE dbo.f_ProperPO(rtrD.POitem) = "+STR(nOrderNum)
			
		CASE cOrderType = "SALES ORDER"
			cSQL = cSQL + " WHERE dbo.f_ProperSO(rtr.SOitem) = "+STR(nOrderNum)
		CASE cOrderType = "SO ITEM"
			cSQL = cSQL + " WHERE ISNULL(rtr.SOitem,'') = dbo.f_ProperSOitem("+cOrderNum+")"
		CASE cOrderType = "WO DETAIL"
			cSQL = cSQL + " WHERE ISNULL(rtr.WO_Detail,0) = "+STR(nOrderNum)
		CASE cOrderType = "WORKORDER"
			cSQL = cSQL + " WHERE ISNULL(rtr.WO,0) = "+STR(nOrderNum)
		CASE cOrderType = "ROUTER ID"
			cSQL = cSQL + " WHERE rtr.ID = "+STR(nOrderNum)
		CASE cOrderType = "QUOTE"
			cSQL = cSQL + " WHERE rtr.Quote_ID = "+STR(nOrderNum)
		ENDCASE
		
		*cSQL = cSQL + " AND rtrD.Cncld = 0 "
		cSQL = cSQL + " GROUP BY rtr.ID "
		cSQL = cSQL + " ORDER BY rtr.ID DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_ID')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpRTR_ID')
		ELSE
			IF USED('tmpRTR_ID')
				IF RECCOUNT('tmpRTR_ID') > 0
					ThisForm.grdRTR.RecordSource = 'tmpRTR_ID'
					*ThisForm.grdRTR.Column1.DynamicBackColor = ThisForm.DynamicBackColor_rtr()
					*ThisForm.grdRTR.SetAll("dynamicbackcolor", "ThisForm.DynamicBackColor_rtr()", "Column")
					ThisForm.grdRTR.SetAll("dynamicbackcolor", "IIF(tmpRTR_ID.Finished,RGB( 255,128,64 ), IIF(tmpRTR_ID.Started,RGB( 192, 220, 192 ),RGB( 255, 255, 255 )))", "Column")
					lFoundRTR = .T.
					ThisForm.Refresh_RTR()
				ENDIF
			ELSE
				lOK = ThisForm.LoadRTR()
				*CALLS: ThisForm.Refresh_RTR() is works
			ENDIF
		ENDIF
		
			
		
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
	ENDPROC

