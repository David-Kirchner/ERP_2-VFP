		Name = "Label9", ;
		Top = 158, ;
		Width = 180
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Init
		ThisForm.Edit1.Value = "The Router Detail number is for order of operation.  ";
		+"The begining detail are around 100 where final details are in the 900''s. ";
		+"Align the detail number to when it should happen.  The Operations number (Oper_ID) can be generic like ''Forge'' to specific like ''GFM A''. ";
		+"When the shop reads the operation and it generic, they choose the machine.  ";
		+"ex If the order calls for a ''cold cut'' then bandsaw to cold saw and be operated. "
		
		
		
		
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Visible = .F.
		
	ENDPROC

	PROCEDURE Command1.Click
		PRIVATE cMess
		cMess = "  .OperID. "+CHR(13)
		cMess = cMess + "100. 523. Select Material"+CHR(13)
		cMess = cMess + "200. 000. PO Conversion"+CHR(13)
		cMess = cMess + "300. 525. Radial Forge"+CHR(13)
		cMess = cMess + "400. 000"+CHR(13)
		cMess = cMess + "500. 000"+CHR(13)
		cMess = cMess + "600. 506."+CHR(13)
		cMess = cMess + "700. 520. Straighten and CG"+CHR(13)
		cMess = cMess + "750. 521. Cut of Cups"+CHR(13)
		cMess = cMess + "800. 000"+CHR(13)
		cMess = cMess + "900. 514. Final Inspection"+CHR(13)
		cMess = cMess + "910. 000. Packing Slip"
		
		MESSAGEBOX(cMess,64,"Common Details")
	ENDPROC

ENDDEFINE

