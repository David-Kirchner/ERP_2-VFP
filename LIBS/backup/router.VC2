	PROCEDURE checksave		&& CheckSave
		PARAMETERS nDetail, nOper_ID, cOperation, cPOitem
		*ThisForm.CheckSave
		
		PRIVATE lPassed
		lPassed = .T.
		
		IF NOT nDetail > 0
			lPassed = .F.
		ENDIF
		IF nDetail >= 1000
			lPassed = .F.
		ENDIF
		
		IF nOper_ID >= 1000
			lPassed = .F.
		ENDIF
		
		IF Proper_PO_item(cPOitem) != Proper_PO_item('')
			IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, '' ) > 0
				*
			ELSE
				MESSAGEBOX("POitem '"+cPOitem+"' does not exists."+CHR(13)+"Please Edit and [Get PO]",48,"Caution")
			ENDIF
		ELSE
			DO CASE
			CASE nDetail = 200
				MESSAGEBOX("The 'PO Conversion' does not have a POitem!"+CHR(13)+"Please Edit and [Get PO]",48,"Caution")
			CASE nDetail = 600
				MESSAGEBOX("The 'Testing' does not have a POitem!"+CHR(13)+"Please Edit and [Get PO]",48,"Caution")	
			CASE cOperation = "PO Conversion"
				*cAndSome = "CONVSERV"
				MESSAGEBOX("The 'PO Conversion' does not have a POitem!"+CHR(13)+"Please Edit and [Get PO]",48,"Caution")
			CASE cOperation = "Testing"
				*cAndSome = "SERVICES"
				MESSAGEBOX("The 'Testing' does not have a POitem!"+CHR(13)+"Please Edit and [Get PO]",48,"Caution")
			ENDCASE
			*OK to be ''
		ENDIF
		
		
		RETURN lPassed 
	ENDPROC

	PROCEDURE Destroy
		IF USED('tmpRTR_Detail')
			USE IN tmpRTR_Detail
		ENDIF
		
		*IF "ROUTERDETAILORDER" $ SET("CLASSLIB")
		*	RELEASE CLASSLIB "LIBS\ROUTERDETAILORDER"
		*ENDIF
		
	ENDPROC

	PROCEDURE detail_allowtochange		&& Detail_AllowToChange
		PARAMETERS nDetail, lSave
		*ThisForm.Detail_AllowToChange()
		
		PRIVATE lReturn
		lReturn = .T.
		
		IF VARTYPE(nDetail)!="N"
			nDetail = 0
		ENDIF
		IF VARTYPE(lSave) != "L"
			TrackError("Did not get a Parameter nDetail or lSave","nDetail, lSave","routerdetailorder:Detail_AllowToChange",LINENO(1) )
			RETURN .F.
		ENDIF
		
		IF USED('tmpTest_Detail')
			USE IN tmpTest_Detail
		ENDIF
		
		PRIVATE biRTR_ID 
		biRTR_ID = PrepareSQLnum(ThisForm.rtr_ID,'rtr_ID',-4)
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT CNCLD,Finished,Started "
		cSQL = cSQL + " FROM dbo.rtr_Detail "
		cSQL = cSQL + " WHERE rtr_ID = "+ALLTRIM(STR(biRTR_ID))
		cSQL = cSQL + " AND Detail = "+ALLTRIM(STR(nDetail))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTest_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTest_Detail')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTest_Detail')
			RETURN .F.
		ELSE
			IF USED('tmpTest_Detail')
				IF RECCOUNT('tmpTest_Detail') > 0
					IF PrepareSQLlogic(tmpTest_Detail.CNCLD,'CNCLD')
						MESSAGEBOX("This Detail "+ALLTRIM(STR(nDetail))+" is Cancelled."+CHR(13)+"No Change Allowed.",48,"No Change")
						 lReturn = .F.
					ENDIF
					IF lReturn 
						IF PrepareSQLlogic(tmpTest_Detail.Finished,'Finished')
							MESSAGEBOX("This Detail "+ALLTRIM(STR(nDetail))+" has already been Finished."+CHR(13)+"No Change Allowed.",48,"No Change")
							 lReturn = .F.
						ENDIF
					ENDIF
					IF lReturn 			
						IF PrepareSQLlogic(tmpTest_Detail.Started,'Started')
							MESSAGEBOX("This Detail "+ALLTRIM(STR(nDetail))+" has already been Started."+CHR(13)+"No Change Allowed.",48,"No Change")
							 lReturn = .F.
						ENDIF
					ENDIF
				ENDIF
				USE IN tmpTest_Detail
			ENDIF
		ENDIF
		
		IF lReturn
			IF nDetail = 100
				
				IF NOT lSave
					*then DELETE
					PRIVATE nID_Detail_Process
					IF USED('tmpRTR_Detail')
						nID_Detail_Process = PrepareSQLnum(tmpRTR_Detail.ID_D_Prc,'ID_Detail_Process',-3)
					ELSE
						IF USED('tmpRTR_Detail_Remote')
							nID_Detail_Process = PrepareSQLnum(tmpRTR_Detail_Remote.ID_D_Prc,'ID_Detail_Process',-3)
						ELSE
							*PRIVATE cMess
							*cMess = "tmpRTR_Detail or tmpRTR_Detail_Remote Table not found."+CHR(13)
							*cMess = cMess + "nID_Detail_Process will be set to 0."+CHR(13)
							*cMess = cMess + "Return .F."+CHR(13)
							*cMess = cMess + "rtr_ID = " +ALLTRIM((biRTR_ID))+CHR(13)
							*cMess = cMess + cSQL
							*TrackError("tmpRTR_Detail Table not found. ",cMess,"RouterDetailOrder.vcx. Detail_AllowToChange()",LINENO(1))
							nID_Detail_Process = 0
							lReturn = .F.
						ENDIF
					ENDIF
					
					IF nID_Detail_Process > 0
						nMess = MESSAGEBOX("Are you sure you want to DELETE this 'Select Material'?"+CHR(13)+"This Detail has a Selected Process process."+CHR(13)+CHR(13)+"If you delete this, the Selected Process will be Deleted also!",4+32,"Delete Detail and Process?")
						IF nMess = 7
							lReturn = .T.
						ELSE
							lReturn = .F.
						ENDIF
					ENDIF
				ENDIF
		*		ThisForm.cmdGetPOitem.Enabled = .T.
			ENDIF
		
			IF nDetail = 200
		*		ThisForm.cmdGetPOitem.Enabled = .T.
			ENDIF
			IF nDetail = 600
		*		ThisForm.cmdGetPOitem.Enabled = .T.
			ENDIF
		ENDIF
		RETURN lReturn
	ENDPROC

	PROCEDURE detail_show
		PARAMETERS nDetail
		*ThisForm.Detail_Show(nDetail)
		
		IF VARTYPE(nDetail) != "N"
			nDetail = 0
		ENDIF
		
		IF USED('tmpRTR_Detail')
			*Reset the Check Boxes.
			ThisForm.chk100.Value = 0
			ThisForm.chk150.Value = 0
			ThisForm.chk200.Value = 0
			ThisForm.chk300.Value = 0
			ThisForm.chk400.Value = 0
			ThisForm.chk500.Value = 0
			ThisForm.chk600.Value = 0
			ThisForm.chk700.Value = 0
			ThisForm.chk750.Value = 0
			ThisForm.chk800.Value = 0
			ThisForm.chk900.Value = 0
			
			SELECT tmpRTR_Detail 
			SCAN
				*set the Check Boxes.
				DO CASE
				CASE tmpRTR_Detail.Detail = 100
					ThisForm.chk100.Value = 1
				CASE tmpRTR_Detail.Detail = 150
					ThisForm.chk150.Value = 1
				CASE tmpRTR_Detail.Detail = 200
					ThisForm.chk200.Value = 1
				CASE tmpRTR_Detail.Detail = 300
					ThisForm.chk300.Value = 1
				CASE tmpRTR_Detail.Detail = 400
					ThisForm.chk400.Value = 1
				CASE tmpRTR_Detail.Detail = 500
					ThisForm.chk500.Value = 1
				CASE tmpRTR_Detail.Detail = 600
					ThisForm.chk600.Value = 1
				CASE tmpRTR_Detail.Detail = 700
					ThisForm.chk700.Value = 1
				CASE tmpRTR_Detail.Detail = 750
					ThisForm.chk750.Value = 1
				CASE tmpRTR_Detail.Detail = 800
					ThisForm.chk800.Value = 1
				CASE tmpRTR_Detail.Detail = 900
					ThisForm.chk900.Value = 1
				ENDCASE	
			ENDSCAN
			
			SELECT tmpRTR_Detail 
			GO TOP
			
			ThisForm.grd_Details.Refresh
			
			IF nDetail > 0
				SELECT tmpRTR_Detail 
				LOCATE FOR DETAIL = nDetail
			ENDIF
			
			ThisForm.grd_Details.Refresh
			
			ThisForm.txtDetail.Value	= PrepareSQLnum(tmpRTR_Detail.Detail,'Detail',4,0)
			ThisForm.txtOperation.Value	= PrepareSQLtxt(tmpRTR_Detail.Operation,'Operation',20)
			ThisForm.txtOper_ID.Value	= PrepareSQLnum(tmpRTR_Detail.Oper_ID,'Oper_ID',4,0)
			
			ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpRTR_Detail.TBL,'TBL',1)
			ThisForm.txtID_Detail_Process.Value	= PrepareSQLtxt(tmpRTR_Detail.ID_D_Prc,'ID_Detail_Process',-3)
		
		ENDIF
	ENDPROC

	PROCEDURE foundduplicatedetail		&& FoundDuplicateDetail
		PARAMETERS nDetail,nOper_ID,cOperation,cPoitem
		*ThisForm.FoundDuplicateDetail
		*Pass nOper_ID as Numeric to test
		
		PRIVATE lReturn
		lReturn = .F.
		
		SELECT tmpRTR_Detail
		LOCATE FOR Detail = nDetail
		IF FOUND('tmpRTR_Detail')
			lReturn = .T.
		ENDIF
		
		IF lReturn AND VARTYPE(nOper_ID) = "N"
			LOCATE FOR Detail = nDetail AND Oper_ID = nOper_ID AND Operation = cOperation
			IF FOUND('tmpRTR_Detail')
				IF Proper_PO_item(tmpRTR_Detail.POitem) = Proper_PO_item(cPoitem)
					lReturn = .T.
				ENDIF
			ENDIF
			
		ENDIF
		
		RETURN lReturn 
	ENDPROC

	PROCEDURE Load
		*Load
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE load_rtr		&& Load rtr
		PARAMETERS biRTR_ID
		*ThisForm.Load_rtr(biRTR_D)
		*Could use Loadrtr_Detail, but this method uses the parameter rtr_ID
		IF VARTYPE(biRTR_ID) = "C"
			biRTR_ID = PrepareSQLnum(biRTR_ID,'rtr_ID',-4)
		ELSE
			IF VARTYPE(biRTR_ID)="N"
				*biRTR_ID = (biRTR_ID)
			ELSE
				biRTR_ID = 0
			ENDIF
		ENDIF
		ThisForm.rtr_ID = biRTR_ID
		ThisForm.txtRTR_ID.Value = biRTR_ID
		
		PRIVATE lFoundRTR_Detail
		lFoundRTR_Detail = .F.
		
		*****************************************
		IF USED('tmpRTR_Detail')
			ThisForm.grd_Details.RecordSource = ''
			USE IN tmpRTR_Detail
		ENDIF
		
		IF USED("tmpRTR_Detail_Remote")	
			USE IN tmpRTR_Detail_Remote
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT Detail,Oper_ID"
		cSQL = cSQL + ",( SELECT OP.Operation FROM dbo.rtr_Operation OP WHERE OP.Oper_ID = rtr_Detail.Oper_ID ) AS Operation "
		cSQL = cSQL + ",POitem"
		cSQL = cSQL + ",CNCLD,Finished,Started "
		cSQL = cSQL + ",ISNULL(TBL,'N') AS [TBL], ISNULL(ID_Detail_Process,0) AS [ID_Detail_Process] "
		cSQL = cSQL + " FROM dbo.rtr_Detail "
		cSQL = cSQL + " WHERE rtr_ID = "+ALLTRIM(STR(biRTR_ID))
		cSQL = cSQL + " ORDER BY Detail"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_Detail_Remote')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_Detail_Remote')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpRTR_Detail_Remote')
		ELSE
			IF USED('tmpRTR_Detail_Remote')
				IF RECCOUNT('tmpRTR_Detail_Remote') > 0
					*tmpRTR_Detail_Remote
					*Make local table
					PRIVATE cSafety
					cSafety = SET('SAFETY')
					SET SAFETY OFF
					
					PRIVATE cFileName
					cFileName = SYS(3)
					
					SELECT 0
		
					CREATE TABLE ( SYS(5)+SYS(2003)+"\"+cFileName ) FREE ( Detail N(3),Operation C(20),Oper_ID N(3),POitem C(12),Started L, Finished L ,cncld L, TBL C(1), ID_D_Prc N(10) )
		
					USE (SYS(5)+SYS(2003)+"\"+cFileName) EXCL ALIAS tmpRTR_Detail
		
					SELECT tmpRTR_Detail
		*			APPEND FROM tmpRTR_Detail_Remote
					INSERT INTO tmpRTR_Detail (Detail,Operation,Oper_ID,POitem,Started,Finished,cncld, TBL,ID_D_Prc ) ;
						SELECT Detail,Operation,Oper_ID,POitem,Started,Finished,cncld,TBL,ID_Detail_Process FROM tmpRTR_Detail_Remote
								
					SET SAFETY &cSafety
					
					SELECT tmpRTR_Detail
					*DELETE FOR Cancelled = .T.
								
					INDEX ON Detail TO RTR_Detail
				 	*INDEX ON Detail TAG RTR_Detail
					 
					SELECT tmpRTR_Detail
					GO TOP
					
					ThisForm.grd_Details.RecordSource = 'tmpRTR_Detail'
					ThisForm.grd_Details.Visible = .T.
					ThisForm.grd_Details.SetAll("dynamicbackcolor", "IIF(tmpRTR_Detail.CNCLD, RGB( 255, 0, 0 ), IIF( tmpRTR_Detail.Finished, RGB( 128, 128, 128 ), IIF( tmpRTR_Detail.Started, RGB( 192, 220, 192 ),RGB( 255, 255, 255 ))))", "Column")
					
					lFoundRTR_Detail = .T.
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("tmpRTR_Detail_Remote")	
			USE IN tmpRTR_Detail_Remote
		ENDIF
		
		IF NOT lFoundRTR_Detail
			MESSAGEBOX("ERROR",16,"Could not load Router Details.")
			RETURN .F.
		ENDIF
		
		ThisForm.cmdReturn.SetFocus
		
		
		ThisForm.Detail_Show(0)
		*ThisForm.Refresh_RTR_Detail(nDetail)
		
	ENDPROC

