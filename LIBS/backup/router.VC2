	PROCEDURE cmdPrintDetail.Click
		PRIVATE nDetail
		nDetail = PrepareSQLnum(tmpRTR_DetailS.Detail,'Detail',-2)
		
		IF nDetail < 0
			MESSAGEBOX("No nDetail Found",16,"Cannot Print")
			RETURN .F.
		ENDIF
		
		IF NOT USED("tmpRTR_Orders")
			MESSAGEBOX("Table tmpRTR_Orders not opened.",16,"Cannot Print")
			RETURN .F.
		ENDIF
			
		IF NOT USED("tmpRTR_DetailS")	
			MESSAGEBOX("Table tmpRTR_DetailS not opened.",16,"Cannot Print")
			RETURN .F.
		ENDIF
		
		
		SELECT tmpRTR_DetailS
		REPORT FORM reports\Router PREVIEW
		
		
		
	ENDPROC

	PROCEDURE cmdPrintDetail.When
		RETURN NOT ThisForm.isediting
		
	ENDPROC

	PROCEDURE cmdPrintID.Click
		PRIVATE biID
		biID = PrepareSQLnum(tmpRTR_ID.ID,'rtr_ID',-4)
		
		IF (biID) < 0
			MESSAGEBOX("No ID Found",16,"Cannot Print")
			RETURN .F.
		ENDIF
		
		IF NOT USED("tmpRTR_Orders")
			MESSAGEBOX("Table tmpRTR_Orders not opened.",16,"Cannot Print")
			RETURN .F.
		ENDIF
			
		IF NOT USED("tmpRTR_DetailS")	
			MESSAGEBOX("Table tmpRTR_DetailS not opened.",16,"Cannot Print")
			RETURN .F.
		ENDIF
		
		PRIVATE nDetail
		nDetail = PrepareSQLnum(tmpRTR_Detail.Detail,'Detail',-2)
		
		IF nDetail = 0
			MESSAGEBOX("Detail not found",0,"Cannot Print")
			RETURN .F.
		ENDIF
		
		ThisForm.Refresh_RTR_Detail(-1)	&&All Detail for ID
		
		SELECT tmpRTR_DetailS
		REPORT FORM reports\Router PREVIEW
		
		ThisForm.Refresh_RTR_Detail(nDetail)
		
		
		
	ENDPROC

	PROCEDURE cmdPrintID.When
		RETURN NOT ThisForm.isediting
		
	ENDPROC

	PROCEDURE cmdQuit.Click
		IF THIS.Caption = "Return"
			ThisForm.Release
			*ThisFormSet.Release
		ELSE
			*Abort Save or Add
			This.Caption = "Return"
			ThisForm.cmdEdit.Caption = "Edit"
			ThisForm.cmdAdd.Caption = "Add"
			
			*take out of Edit Mode
			ThisForm.chkCncld_D.ReadOnly = .T.
			Thisform.txtDetail.ReadOnly = .T.
			
			ThisForm.txtEstStart.ReadOnly = .T.
			ThisForm.txtStartDate.ReadOnly = .T.
			ThisForm.chkStarted.ReadOnly = .T.
			ThisForm.txtEstFinish.ReadOnly = .T.
			ThisForm.txtFinishDate.ReadOnly = .T.
			ThisForm.chkFinished.ReadOnly = .T.
			
			ThisForm.cmdGetOper.Enabled = .F.
			ThisForm.edtOper_Note.ReadOnly = .T.
			
			ThisForm.cmdGetPO.Enabled = .F.
			ThisForm.txtPOitem.ReadOnly = .T.
			
			ThisForm.txtRely_On.ReadOnly = .T.
			ThisForm.txtNext_Up.ReadOnly = .T.
			ThisForm.txtSynchro.ReadOnly = .T.
			ThisForm.txtEstTime.ReadOnly = .T.
			ThisForm.txtActTime.ReadOnly = .T.	
			
			ThisForm.cmdFind.Visible = ThisForm.txtFind.Visible  &&Set to Visible if txtFind is
			*refresh Screen
			ThisForm.Refresh_rtr_Detail()
			
		ENDIF
	ENDPROC

	PROCEDURE cmdQuit.When
		*RETURN ThisForm.isediting
		
	ENDPROC

