	PROCEDURE cmbJobClass.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpJobClass')
			USE IN tmpJobClass
		ENDIF
		
		SELECT 0
		
		*this.clear
		cSQL="SELECT DISTINCT [jobClass]"
		cSQL = cSQL + " ,[jobType] "
		cSQL = cSQL + " FROM dbo.rtr_Operation "
		cSQL = cSQL + " WHERE [jobClass] IS NOT NULL "
		cSQL = cSQL + " ORDER BY [jobClass] "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpJobClass')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpJobClass')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpJobClass')
		ENDIF
		
		DIMENSION aCombo(1,2)
		
		IF USED('tmpJobClass')
			IF RECCOUNT('tmpJobClass') = 0
				SELECT '' AS jobClass,jobType FROM tmpJobClass INTO ARRAY aCombo
			ELSE
				SELECT jobClass,jobType FROM tmpJobClass INTO ARRAY aCombo
			ENDIF
			
			USE IN tmpJobClass
		ENDIF
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aCombo,1)
		
		This.ColumnCount = 2
		This.NumberOfElements = nArrayCount
		This.BoundColumn = 2
		This.ColumnWidths = "70,115"
		
		FOR I = 1 TO nArrayCount
			this.addListitem(aCombo(I, 1),I,1)
			this.addListitem(aCombo(I, 2),I,2)
		ENDFOR
		
		This.Value = aCombo(1, 2)
	ENDPROC

	PROCEDURE cmbJobClass.Valid
		ThisForm.txtFind.Value = This.Value
		*ThisForm.cmdFind.SetFocus
		
	ENDPROC

	PROCEDURE cmbJobClass.When
		RETURN NOT ThisForm.isediting
		
	ENDPROC

	PROCEDURE cmbOrderType.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpOrderType')
			USE IN tmpOrderType
		ENDIF
		
		SELECT 0
		
		*this.clear
		cSQL="SELECT [OrderTypeName] "
		cSQL = cSQL + " FROM [dbo].[NR_OrderTrackingOrderType] "
		cSQL = cSQL + " WHERE [OrderTypeName] IS NOT NULL "
		cSQL = cSQL + " AND NOT [OrderTypeName] = 'Maintenance'"		&&MAINTENANCE
		cSQL = cSQL + " ORDER BY [OrderTypeName]"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrderType')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpOrderType')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpOrderType')
		ENDIF
		
		
		***
		
		DIMENSION aComboOT(1),aComboOT_A(1)
		
		PRIVATE nArrayCount
		
		IF USED('tmpOrderType')
			IF RECCOUNT('tmpOrderType') = 0
				SELECT '' AS OrderTypeName FROM tmpOrderType INTO ARRAY aComboOT_A
			ELSE
				SELECT OrderTypeName FROM tmpOrderType INTO ARRAY aComboOT_A
			ENDIF
			
			nArrayCount = ALEN(aComboOT_A,1)
			DIMENSION aComboOT(nArrayCount +1)
			ACOPY(aComboOT_A,aComboOT,1,nArrayCount )
			aComboOT(nArrayCount+1) = 'Router ID'
		
			USE IN tmpOrderType 
		ELSE
			DIMENSION aComboOT(7)
			*OrderTypeName
			aComboOT(1) = 'PO Item'
			aComboOT(2) = 'Purchase Order'
			aComboOT(3) = 'Sales Order'
			aComboOT(4) = 'SO Item'
			aComboOT(5) = 'WO Detail'
			aComboOT(6) = 'WorkOrder'
			aComboOT(7) = 'Router ID'
		ENDIF
		*!*	***
		
		nArrayCount = ALEN(aComboOT,1)
		
		This.ColumnCount = 1
		This.NumberOfElements = nArrayCount
		This.BoundColumn = 1
		*This.ColumnWidths = "115"
		
		FOR I = 1 TO nArrayCount
			this.addListitem(aComboOT(I),I)
			
			*this.addListitem(aComboOT(I, 2),I,2)
		ENDFOR
		
		
		This.Value = aComboOT(1)
	ENDPROC

	PROCEDURE cmbOrderType.Valid
		*ThisForm.txtFind.SetFocus
		*ThisForm.cmdFind.SetFocus
	ENDPROC

	PROCEDURE cmbOrderType.When
		RETURN NOT ThisForm.isediting
		
	ENDPROC

	PROCEDURE cmdAdd.Click
		IF This.Caption = "Add"
			*put in Edit Mode
			ThisForm.isediting = .T.
			
			ThisForm.chkCncld_D.ReadOnly = .F.
			Thisform.txtDetail.ReadOnly = .F.
			
			ThisForm.txtEstStart.ReadOnly = .F.
			ThisForm.txtStartDate.ReadOnly = .F.
			ThisForm.chkStarted.ReadOnly = .F.
			ThisForm.txtEstFinish.ReadOnly = .F.
			ThisForm.txtFinishDate.ReadOnly = .F.
			ThisForm.chkFinished.ReadOnly = .F.
			
			ThisForm.cmdGetOper.Enabled = .T.
			ThisForm.edtOper_Note.ReadOnly = .F.
			
			ThisForm.cmdGetPO.Enabled = .T.
			ThisForm.txtPOitem.ReadOnly = .F.
			
			ThisForm.txtRely_On.ReadOnly = .F.
			ThisForm.txtNext_Up.ReadOnly = .F.
			ThisForm.txtSynchro.ReadOnly = .F.
			ThisForm.txtEstTime.ReadOnly = .F.
			ThisForm.txtActTime.ReadOnly = .F.	
			
			This.Caption = "Save"
			ThisForm.cmdEdit.Visible = .F.
			ThisForm.cmdQuit.Caption = "Abort"
			
			ThisForm.cmdFind.Visible = .F.
			ThisForm.txtFind.Enabled = .F.
			
			PRIVATE nNextDetail
			nNextDetail	= PrepareSQLnum(ThisForm.txtRely_On.Value,'Rely_On',-3)
			IF nNextDetail = 0
				nNextDetail = PrepareSQLnum(ThisForm.txtNext_Up.Value,'Next_Up',-3)
			ENDIF
			IF nNextDetail = 0
				nNextDetail = PrepareSQLnum(ThisForm.txtSynchro.Value,'Synchro',-3)
			ENDIF
			IF nNextDetail = 0
				nNextDetail = PrepareSQLnum(ThisForm.txtDetail.Value,'Detail',-3) +100
			ENDIF
			
			*ThisForm.txtID.Value,'rtr_ID',-4)
			ThisForm.txtDetail.Value	= nNextDetail 
		
			ThisForm.chkCncld_D.Value 	= PrepareSQLchk(ThisForm.chkCncld_D.Value,'Cncld')
			
			ThisForm.txtEstStart.Value 	= DATE()
			ThisForm.txtStartDate.Value = ''
			ThisForm.chkStarted.Value	= 0
			ThisForm.txtEstFinish.Value	= ''
			ThisForm.txtFinishDate.Value= ''
			ThisForm.chkFinished.Value	= 0
				
			ThisForm.txtOper_ID.Value	= 0
			ThisForm.txtOperation.Value	= ''
			ThisForm.edtOper_Note.Value	= ''
			ThisForm.txtPOitem.Value	= ''
				
			ThisForm.txtRely_On.Value	= 0
			ThisForm.txtNext_Up.Value	= 0
			ThisForm.txtSynchro.Value	= 0
			ThisForm.txtEstTime.Value	= 0
			ThisForm.txtActTime.Value	= 0
			
		ELSE
			*Save, Insert the Add
			PRIVATE lCncld, dEstStart,dtStartDate,lStarted
			PRIVATE dEstFinish,dtFinishDate,lFinished, nOper_ID ,cOper_Note,cPoitem
			PRIVATE nRely_On,nNext_Up,nSynchro,nEstTime,nActTime
			
			lCncld		= PrepareSQLlogic(ThisForm.chkCncld_D.Value,'Cncld')
			dEstStart	= PrepareSQLdate(ThisForm.txtEstStart.Value,'EstStart')
			dtStartDate	= PrepareSQLdateTime(ThisForm.txtStartDate.Value,'StartDate')
			lStarted	= PrepareSQLlogic(ThisForm.chkStarted.Value,'Started')
			dEstFinish	= PrepareSQLdate(ThisForm.txtEstFinish.Value,'EstFinish', .F.,.T.)
			dtFinishDate= PrepareSQLdateTime(ThisForm.txtFinishDate.Value,'FinishDate', .F.,.T.)
			lFinished	= PrepareSQLlogic(ThisForm.chkFinished.Value,'Finished')
			
			nOper_ID	= PrepareSQLnum(ThisForm.txtOper_ID.Value,'Oper_ID',-3)
		*	cOperation	= PrepareSQLtxt(ThisForm.txtOperation.Value,'Operation',20)
			cOper_Note	= PrepareSQLtxt(ThisForm.edtOper_Note.Value,'Oper_Note',-1)
			cPoitem		= PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
			*cPOCompany	= PrepareSQLtxt(ThisForm.lblPOcompany.Caption,'Company',30)
			*nWO2		= PrepareSQLtxt(ThisForm.lblWO2.Caption)
			
			nRely_On	= PrepareSQLnum(ThisForm.txtRely_On.Value,'Rely_On',-3)
			nNext_Up	= PrepareSQLnum(ThisForm.txtNext_Up.Value,'Next_Up',-3)
			nSynchro	= PrepareSQLnum(ThisForm.txtSynchro.Value,'Synchro',-3)
			nEstTime	= PrepareSQLnum(ThisForm.txtEstTime.Value,'EstTime',-3)
			nActTime	= PrepareSQLnum(ThisForm.txtActTime.Value,'ActTime',-3)
			
			PRIVATE biID, nDetail
			biID	= PrepareSQLnum(ThisForm.txtID.Value,'rtr_ID',-4)
			nDetail	= PrepareSQLnum(ThisForm.txtDetail.Value,'Detail',-3)
		
			*** Check before Insert	Detail
			IF nDetail < 1
				MESSAGEBOX("Need a detail Number.",16,"Cannot Add")
				RETURN .F.
			ENDIF
			IF nOper_ID < 1
				MESSAGEBOX("Need an Operations Number.",16,"Cannot Add")
				RETURN .F.
			ENDIF
			
			IF biID = 0 
				*Check biID and cSOitem, nWO, nWO_Detail, nQuote_ID, may need to Insert
				** dbo.p_rtr_ins()
				PRIVATE cSOitem, nWO, nWO_Detail, nQuote_ID
				cSOitem	= PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
				nWO		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
				nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
				nQuote_ID	= PrepareSQLnum(ThisForm.txtQuote_ID.Value,'Quote_ID',-3)
				IF VAL(cSOitem) + nWO + nWO_Detail + nQuote_ID = 0
					* dbo.p_rtr_ins(cSOitem, nWO, nWO_Detail, nQuote_ID)
					
					
					
				ENDIF
			ENDIF
			
			*Does Detail already exits.
			IF USED('tmpCNT_Detail')
				USE IN 'tmpCNT_Detail'
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.rtr_Detail "
			cSQL = cSQL + " WHERE rtr_ID = "+STR(biID)
			cSQL = cSQL + " AND Detail = "+STR(nDetail)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_Detail')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCNT_Detail')
				RETURN .F.
			ELSE
				IF USED('tmpCNT_Detail')	
					IF PrepareSQLnum(tmpCNT_Detail.CNT,'ID',-3) > 0
						MESSAGEBOX("This Detail "+ALLTRIM(STR(nDeatil))+" already exist!"+CHR(13)+"You cannot add another record with the same detail number.",48,"Cannot Add.")
						ThisForm.txtID.Value = nDeatil +10
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
			*** End Check
			
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "INSERT INTO dbo.rtr_Detail ("
			cSQL = cSQL + " Cncld"
			cSQL = cSQL + ",EstStart" 
			cSQL = cSQL + ",StartDate"
			cSQL = cSQL + ",Started"
			cSQL = cSQL + ",EstFinish"
			cSQL = cSQL + ",FinishDate"
			cSQL = cSQL + ",Finished"
			
			cSQL = cSQL + ",Oper_ID"
		*	cSQL = cSQL + ",Operation"
			cSQL = cSQL + ",Oper_Note"
			cSQL = cSQL + ",POitem"
			
			cSQL = cSQL + ",Rely_On"
			cSQL = cSQL + ",Next_UP"
			cSQL = cSQL + ",Synchro"
			cSQL = cSQL + ",EstTime"
			cSQL = cSQL + ",ActTime"
			cSQL = cSQL + ",rtr_ID"
			cSQL = cSQL + ",Detail"
			cSQL = cSQL + " ) VALUES ("
			cSQL = cSQL + " "+IIF(lCncld,"1","0")+""
			cSQL = cSQL + ",'"+IIF(EMPTY(dEstStart),'',DTOC(dEstStart))+"'"
			cSQL = cSQL + ",'"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),DTOC(dtStartDate))+"'"
			cSQL = cSQL + ","+IIF(lStarted,"1","0")+""
			cSQL = cSQL + ",'"+IIF(EMPTY(dEstFinish),'',DTOC(dEstFinish))+"'"
			cSQL = cSQL + ",'"+IIF(EMPTY(dtFinishDate),'',DTOC(dtFinishDate))+"'"
			cSQL = cSQL + ","+IIF(lFinished,"1","0")+""
			
			cSQL = cSQL + ","+STR(nOper_ID)
		*	cSQL = cSQL + ",'"+cOperation+"'"
			cSQL = cSQL + ",'"+cOper_Note+"'"
			cSQL = cSQL + ",dbo.f_ProperPOitem('"+cPoitem+"')"
			cSQL = cSQL + ","+STR(nRely_On)
			cSQL = cSQL + ","+STR(nNext_Up)
			cSQL = cSQL + ","+STR(nSynchro)
			cSQL = cSQL + ","+STR(nEstTime)
			cSQL = cSQL + ","+STR(nActTime)
			cSQL = cSQL + ","+STR(biID)
			cSQL = cSQL + ","+STR(nDetail)
			cSQL = cSQL + ")"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, '')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ELSE
				
			
				*take out of Edit Mode
				ThisForm.isediting = .F.
				
				Thisform.txtDetail.ReadOnly = .T.		
				ThisForm.chkCncld_D.ReadOnly = .T.
				
				ThisForm.txtEstStart.ReadOnly = .T.
				ThisForm.txtStartDate.ReadOnly = .T.
				ThisForm.chkStarted.ReadOnly = .T.
				ThisForm.txtEstFinish.ReadOnly = .T.
				ThisForm.txtFinishDate.ReadOnly = .T.
				ThisForm.chkFinished.ReadOnly = .T.
				
				ThisForm.cmdGetOper.Enabled = .F.
				ThisForm.edtOper_Note.ReadOnly = .T.
				
				ThisForm.cmdGetPO.Enabled = .F.
				ThisForm.txtPOitem.ReadOnly = .T.
			
				ThisForm.txtRely_On.ReadOnly = .T.
				ThisForm.txtNext_Up.ReadOnly = .T.
				ThisForm.txtSynchro.ReadOnly = .T.
				ThisForm.txtEstTime.ReadOnly = .T.
				ThisForm.txtActTime.ReadOnly = .T.	
				
				This.Caption = "Add"
				ThisForm.cmdEdit.Visible = .T.
				ThisForm.cmdQuit.Caption = "Return"
			
				ThisForm.cmdFind.Visible = .T.
				ThisForm.txtFind.Enabled = .T.
		
				ThisForm.LoadRTR_Detail(nDetail)
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			*put in Edit Mode
			ThisForm.isediting = .T.
			
			ThisForm.chkCncld_D.ReadOnly = .F.
			ThisForm.txtEstStart.ReadOnly = .F.
			ThisForm.txtStartDate.ReadOnly = .F.
			ThisForm.chkStarted.ReadOnly = .F.
			ThisForm.txtEstFinish.ReadOnly = .F.
			ThisForm.txtFinishDate.ReadOnly = .F.
			ThisForm.chkFinished.ReadOnly = .F.
			
			ThisForm.cmdGetOper.Enabled = .T.
			ThisForm.edtOper_Note.ReadOnly = .F.
			
			ThisForm.cmdGetPO.Enabled = .T.
			ThisForm.txtPOitem.ReadOnly = .F.
			
			ThisForm.txtRely_On.ReadOnly = .F.
			ThisForm.txtNext_Up.ReadOnly = .F.
			ThisForm.txtSynchro.ReadOnly = .F.
			ThisForm.txtEstTime.ReadOnly = .F.
			ThisForm.txtActTime.ReadOnly = .F.	
			
			ThisForm.cmdFind.Visible = .F.
			
			This.Caption = "Save"
			ThisForm.cmdAdd.Visible = .F.
			ThisForm.cmdQuit.Caption = "Abort"
			
		ELSE
			*Save the Edit
			PRIVATE lCncld, dEstStart,dtStartDate,lStarted
			PRIVATE dEstFinish,dtFinishDate,lFinished, nOper_ID,cOper_Note,cPOitem
			PRIVATE nRely_On,nNext_Up,nSynchro,nEstTime,nActTime
			
			lCncld		= PrepareSQLlogic(ThisForm.chkCncld_D.Value,'Cncld')
			dEstStart	= PrepareSQLdate(ThisForm.txtEstStart.Value,'EstStart')
			dtStartDate	= PrepareSQLdateTime(ThisForm.txtStartDate.Value,'StartDate')
			lStarted	= PrepareSQLlogic(ThisForm.chkStarted.Value,'Started')
			dEstFinish	= PrepareSQLdate(ThisForm.txtEstFinish.Value,'EstFinish')
			dtFinishDate= PrepareSQLdateTime(ThisForm.txtFinishDate.Value,'FinishDate')
			lFinished	= PrepareSQLlogic(ThisForm.chkFinished.Value,'Finished')
			
			nOper_ID	= PrepareSQLnum(ThisForm.txtOper_ID.Value,'Oper_ID',-3)
		*	cOperation	= PrepareSQLtxt(ThisForm.txtOperation.Value,'Operation',20)
			cOper_Note	= PrepareSQLtxt(ThisForm.edtOper_Note.Value,'Oper_Note',-1)
			cPOitem		= PrepareSQLtxt(ThisForm.txtPOitem.Value,'Poitem',12)
			*cPOCompany	= PrepareSQLtxt(ThisForm.lblPOcompany.Caption,'Company',30)
			*nWO2		= ThisForm.lblWO2.Caption	
			nRely_On	= PrepareSQLnum(ThisForm.txtRely_On.Value,'Rely_On',-3)
			nNext_Up	= PrepareSQLnum(ThisForm.txtNext_Up.Value,'Next_Up',-3)
			nSynchro	= PrepareSQLnum(ThisForm.txtSynchro.Value,'Synchro',-3)
			nEstTime	= PrepareSQLnum(ThisForm.txtEstTime.Value,'EstTime',-3)
			nActTime	= PrepareSQLnum(ThisForm.txtActTime.Value,'ActTime',-3)
			
			PRIVATE biID, nDetail
			biID	= PrepareSQLnum(ThisForm.txtID.Value,'rtr_ID',-4)
			nDetail	= PrepareSQLnum(ThisForm.txtDetail.Value,'Detail',-3)
			
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "UPDATE dbo.rtr_Detail SET "
			cSQL = cSQL + " Cncld="+IIF(lCncld,"1","0")+""
			cSQL = cSQL + ",EstStart='"+IIF(EMPTY(dEstStart),'',DTOC(dEstStart))+"'"
			cSQL = cSQL + ",StartDate='"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),DTOC(dtStartDate))+"'"
			cSQL = cSQL + ",Started="+IIF(lStarted,"1","0")+""
			cSQL = cSQL + ",EstFinish='"+IIF(EMPTY(dEstFinish),'',DTOC(dEstFinish))+"'"
			cSQL = cSQL + ",FinishDate='"+IIF(EMPTY(dtFinishDate),'',DTOC(dtFinishDate))+"'"
			cSQL = cSQL + ",Finished="+IIF(lFinished,"1","0")+""
			
			cSQL = cSQL + ",Oper_ID='"+STR(nOper_ID)+"'"
		*	cSQL = cSQL + ",Operation='"+cOperation+"'"
			cSQL = cSQL + ",Oper_Note='"+cOper_Note+"'"
			cSQL = cSQL + ",POitem=dbo.f_ProperPOitem('"+cPOitem+"')"
			
			cSQL = cSQL + ",Rely_On="+STR(nRely_On)
			cSQL = cSQL + ",Next_UP="+STR(nNext_Up)
			cSQL = cSQL + ",Synchro="+STR(nSynchro)
			cSQL = cSQL + ",EstTime="+STR(nEstTime)
			cSQL = cSQL + ",ActTime="+STR(nActTime)
			cSQL = cSQL + " WHERE rtr_ID = "+STR(biID)
			cSQL = cSQL + " AND Detail = "+STR(nDetail)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, '')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ELSE
				
				This.Caption = "Edit"
				ThisForm.cmdAdd.Visible = .T.
				ThisForm.cmdQuit.Caption = "Return"
			
				*take out of Edit Mode
				ThisForm.isediting = .F. 
				
				ThisForm.chkCncld_D.ReadOnly = .T.
				ThisForm.txtEstStart.ReadOnly = .T.
				ThisForm.txtStartDate.ReadOnly = .T.
				ThisForm.chkStarted.ReadOnly = .T.
				ThisForm.txtEstFinish.ReadOnly = .T.
				ThisForm.txtFinishDate.ReadOnly = .T.
				ThisForm.chkFinished.ReadOnly = .T.
				
				ThisForm.cmdGetOper.Enabled = .F.
				ThisForm.edtOper_Note.ReadOnly = .T.
				
				ThisForm.cmdGetPO.Enabled = .T.
				ThisForm.txtPOitem.ReadOnly = .F.
				
				ThisForm.txtRely_On.ReadOnly = .T.
				ThisForm.txtNext_Up.ReadOnly = .T.
				ThisForm.txtSynchro.ReadOnly = .T.
				ThisForm.txtEstTime.ReadOnly = .T.
				ThisForm.txtActTime.ReadOnly = .T.	
				
				ThisForm.cmdFind.Visible = .T.
				
				ThisForm.LoadRTR_Detail(nDetail)
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdFind.Valid
		DO CASE
		CASE ThisForm.og.Value = 1
			*Reload All and refresh Option1 Code  -Should not be needed.
			ThisForm.LoadRTR()
			ThisForm.og.Option1.GotFocus
		CASE ThisForm.og.Value = 2
			*Search Order Number
			PRIVATE cOrderType, cOrderNum
			cOrderType = ThisForm.cmbOrderType.Value
			cOrderNum = ThisForm.txtFind.Value
			
			IF NOT EMPTY(cOrderType) AND NOT EMPTY(cOrderNum)
				ThisForm.Search_RTR_Order(cOrderType,cOrderNum)
			ELSE
				MESSAGEBOX("Could not get Search Criteria",48,"Nothing to Search")
			ENDIF
			
		CASE ThisForm.og.Value = 3
			*Show next for job Class
			PRIVATE cJobClass, cJob
			cJobClass	= ThisForm.cmbJobclass.Text
			cJob		= ThisForm.txtFind.Value
			
			IF NOT EMPTY(cJobClass) AND NOT EMPTY(cJob)
				ThisForm.Search_RTR_Class(cJobClass,cJob)
			ELSE
				MESSAGEBOX("Could not get Search Criteria",48,"Nothing to Search")
			ENDIF
		
		ENDCASE 
	ENDPROC

	PROCEDURE cmdFind.When
		RETURN NOT ThisForm.isediting
		
	ENDPROC

	PROCEDURE cmdGetOper.Click
		PRIVATE nOper_ID, nReturnOper_ID
		nOper_ID	= PrepareSQLnum(ThisForm.txtOper_ID.Value,'Oper_ID',-3)
		nReturnOper_ID = 0
		
		DO FORM Forms\Select_Operations WITH nOper_ID TO nReturnOper_ID
		
		IF VARTYPE(nReturnOper_ID) = 'N'
			ThisForm.txtOper_ID.Value = PrepareSQLnum(nReturnOper_ID,'Oper_ID',-3)
			ThisForm.txtOperation.Value = Operations_Text(PrepareSQLnum(nReturnOper_ID,'Oper_ID',-3))
		ENDIF
	ENDPROC

	PROCEDURE cmdGetOper.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE cmdGetPO.Click
		IF ThisForm.isediting
			*Get POitem
			PRIVATE cPOitem 
			cPOitem = PrepareSQLtxt(ThisForm.txtPOItem.Value,'POitem',12)
			PRIVATE vcPOitem
			vcPOitem = ''
		
			DO FORM Forms\SelectPO_Item WITH cPOitem TO vcPOitem
		
			PRIVATE cText
			cText = ''
			IF VARTYPE(vcPOitem) = "C"
				IF Proper_PO_item(vcPOitem) != Proper_PO_item('')
					IF vcPOitem != cPOitem
						IF Proper_PO_item(cPOitem) = Proper_PO_item('')
							ThisForm.txtPOItem.Value = vcPOitem
							*ThisForm.lblPOCompany.Caption	= PrepareSQLtxt(tmpRTR_DetailS.POcompany,'Company',30)					
						ELSE
							vcPOitem = CheckPoTest_Pass( vcPOitem, ThisForm.nConnHandle)
							ThisForm.edtOper_Note.Value = ThisForm.edtOper_Note.Value + vcPOitem
		
							cText = "New POitem="+ALLTRIM(vcPOitem)+"!"
							cText = cText +CHR(13)+"Old POitem="+ALLTRIM(cPOitem)+"!"
							IF MESSAGEBOX("Do you wish to replace the POitem?"+CHR(13)+cText,4+32,"Change PO data") = 6
								*needs Permission , verified.
								
								ThisForm.txtPOItem.Value = vcPOitem
								*ThisForm.lblPOCompany.Caption	= PrepareSQLtxt(tmpRTR_DetailS.POcompany,'Company',30)
								
				*				TrackError("Info","User wished to replace the POitem. "+cText,"StockLst_Process",LINENO(1))
				*				TrackMess( "User wished to replace the POitem. "+cText )
							ENDIF
						ENDIF
					ELSE
						vcPOitem = CheckPoTest_Pass( vcPOitem, ThisForm.nConnHandle)
						IF MESSAGEBOX("Do you want to add"+CHR(13)+vcPOitem+CHR(13)+"to the Notes?",4+32,"Add to Notes?" ) = 6			
							ThisForm.edtOper_Note.Value = ThisForm.edtOper_Note.Value + vcPOitem
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ELSE 
			WAIT WINDOW "Must be in Edit Mode." NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE cmdGetPO.When
		IF NOT ThisForm.isEditing
			WAIT WINDOW "Not in Edit Mode." TIMEOUT 1
		ELSE
			RETURN ThisForm.isEditing
		ENDIF
		
	ENDPROC

