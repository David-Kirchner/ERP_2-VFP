	PROCEDURE lblEstFinish.Click
		IF This.Parent.cmdQuit.Caption = "Return"
			WAIT WINDOW "Must be in Edit Mode" NOWAIT
			RETURN .F.
		ELSE
		
			PRIVATE dDate1,dDate2
		
			dDate1 = This.Parent.txtEstFinish.Value
		
			PRIVATE lAllWaysOnTop
			lAllWaysOnTop = ThisForm.AlWaysOnTop
			IF lAllWaysOnTop
				ThisForm.AlwaysOnTop =.F.
			ENDIF
		
			DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
			IF lAllWaysOnTop
				ThisForm.AlwaysOnTop =.T.
			ENDIF
		
			IF VARTYPE(dDate2) = "T"
				dDate2 = TTOD(dDate2)
			ENDIF
			IF VARTYPE(dDate2) != "D"
				dDate2 = CTOD('')
			ENDIF
		
			This.Parent.txtEstFinish.Value = dDate2
		ENDIF
	ENDPROC

	PROCEDURE lblEstStart.Click
		IF This.Parent.cmdQuit.Caption = "Return"
			WAIT WINDOW "Must be in Edit Mode" NOWAIT
			RETURN .F.
		ELSE
			
			PRIVATE dDate1,dDate2
		
			dDate1 = This.Parent.txtEstStart.Value
		
			PRIVATE lAllWaysOnTop
			lAllWaysOnTop = ThisForm.AlWaysOnTop
			IF lAllWaysOnTop
				ThisForm.AlwaysOnTop =.F.
			ENDIF
		
			DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
			IF lAllWaysOnTop
				ThisForm.AlwaysOnTop =.T.
			ENDIF
		
			IF VARTYPE(dDate2) = "T"
				dDate2 = TTOD(dDate2)
			ENDIF
			IF VARTYPE(dDate2) != "D"
				dDate2 = CTOD('')
			ENDIF
		
			This.Parent.txtEstStart.Value = dDate2
		ENDIF
	ENDPROC

	PROCEDURE lblFinishDate.Click
		IF This.Parent.cmdQuit.Caption = "Return"
			WAIT WINDOW "Must be in Edit Mode" NOWAIT
			RETURN .F.
		ELSE
			
			PRIVATE dDate1,dDate2
		
			dDate1 = This.Parent.txtFinishDate.Value
		
			PRIVATE lAllWaysOnTop
			lAllWaysOnTop = ThisForm.AlWaysOnTop
			IF lAllWaysOnTop
				ThisForm.AlwaysOnTop =.F.
			ENDIF
		
			DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
			IF lAllWaysOnTop
				ThisForm.AlwaysOnTop =.T.
			ENDIF
			
			*uses DateTime
			IF VARTYPE(dDate2) = "D"
				dDate2 = DTOT(dDate2)
			ENDIF
			IF VARTYPE(dDate2) != "T"
				dDate2 = CTOT('')
			ENDIF
		
			This.Parent.txtFinishDate.Value = dDate2
		ENDIF
	ENDPROC

	PROCEDURE lblStartDate.Click
		IF This.Parent.cmdQuit.Caption = "Return"
			WAIT WINDOW "Must be in Edit Mode" NOWAIT
			RETURN .F.
		ELSE
			
			PRIVATE dDate1,dDate2
		
			dDate1 = This.Parent.txtStartDate.Value
		
			PRIVATE lAllWaysOnTop
			lAllWaysOnTop = ThisForm.AlWaysOnTop
			IF lAllWaysOnTop
				ThisForm.AlwaysOnTop =.F.
			ENDIF
		
			DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
			IF lAllWaysOnTop
				ThisForm.AlwaysOnTop =.T.
			ENDIF
			
			*uses DateTime
			IF VARTYPE(dDate2) = "D"
				dDate2 = DTOT(dDate2)
			ENDIF
			IF VARTYPE(dDate2) != "T"
				dDate2 = CTOT('')
			ENDIF
		
			This.Parent.txtStartDate.Value = dDate2
		ENDIF
	ENDPROC

	PROCEDURE og.Option1.GotFocus
		ThisForm.cmbOrderType.Visible = .F.
		ThisForm.cmbJobClass.Visible = .F.
		ThisForm.lblFiltered.Visible = .F.
		ThisForm.lblFind.Visible = .F.
		ThisForm.lblFind.Caption = " "
		
		ThisForm.txtFind.Visible = .F.
		ThisForm.cmdFind.Visible = .F.
		
		*ThisForm.cmbOrderType.Top = ThisForm.txtFind.Top
		
		ThisForm.LoadRTR(tmpRTR_ID.ID)
		
	ENDPROC

	PROCEDURE og.Option2.GotFocus
		ThisForm.cmbOrderType.Visible = .T.
		ThisForm.cmbJobClass.Visible = .F.
		ThisForm.lblFind.Visible = .T.
		ThisForm.lblFind.Caption = "Search "
		*+ThisForm.cmbJobClass.
		ThisForm.txtFind.Visible = .T.
		ThisForm.cmdFind.Visible = .T.
		
		ThisForm.cmbOrderType.Top = ThisForm.txtFind.Top
		
		ThisForm.cmbOrderType.SetFocus
		
		
	ENDPROC

	PROCEDURE og.Option2.Valid
		ThisForm.lblFiltered.Visible = .T.
		ThisForm.cmbOrderType.SetFocus
		
		
	ENDPROC

	PROCEDURE og.Option3.GotFocus
		ThisForm.cmbOrderType.Visible = .F.
		ThisForm.cmbJobClass.Visible = .T.
		ThisForm.lblFind.Visible = .T.
		ThisForm.lblFind.Caption = "Next "
		*+ThisForm.cmbJobClass.
		ThisForm.txtFind.Visible = .T.
		ThisForm.cmdFind.Visible = .T.
		
		ThisForm.cmbJobClass.SetFocus
		
		
	ENDPROC

	PROCEDURE og.Option3.Valid
		ThisForm.lblFiltered.Visible = .T.
		ThisForm.cmbJobClass.SetFocus
		
	ENDPROC

	PROCEDURE og.When
		RETURN NOT ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtActTime.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtDetail.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtEstFinish.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtEstStart.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtEstTime.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtFind.When
		RETURN NOT ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtFinishDate.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtID.When
		
		
	ENDPROC

	PROCEDURE txtNext_Up.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtOperation.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtOper_ID.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtOType_Num.DblClick
		PRIVATE m.cOType_Num
		m.cOType_Num = This.Value
		IF WEXIST("frmProduction")
			ACTIVATE WINDOW frmProduction
			MESSAGEBOX("Production Schedule Window already open.",16,"Cannot open")
		ELSE
			DO FORM "forms\production.scx" WITH m.cOType_Num
		ENDIF
		
		
	ENDPROC

	PROCEDURE txtPOitem.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtRely_On.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtStartDate.When
		RETURN ThisForm.isediting
		
	ENDPROC

	PROCEDURE txtSynchro.When
		RETURN ThisForm.isediting
		
	ENDPROC

ENDDEFINE

