	PROCEDURE Unload
		
		IF ThisForm.nConnhandle > 0
			SQLDISCONNECT(ThisForm.nConnhandle)
		ENDIF
	ENDPROC

	PROCEDURE chk100.Click
		PRIVATE lAllow
		lAllow = ThisForm.Detail_AllowToChange(100,PrepareSQLlogic(This.Value,'chk'))
		
		
		IF PrepareSQLlogic(This.Value,'chk')
			IF lAllow
				*Save
				This.Parent.grd_Details.RecordSource = ''
				SELECT tmpRTR_Detail
				APPEND BLANK IN tmpRTR_Detail
				REPLACE Detail WITH 100
				REPLACE Operation WITH Operations_Text(523) &&"Select Material     "
				REPLACE Oper_ID WITH 523
				REPLACE POitem WITH ''
				REPLACE CNCLD WITH .F.
				REPLACE Finished WITH .F.
				REPLACE Started WITH .F.
				
				REPLACE TBL WITH ''
				REPLACE ID_D_Prc WITH 0
				
				INDEX ON Detail TO RTR_Detail
				This.Parent.grd_Details.RecordSource = 'tmpRTR_Detail'
				ThisForm.Detail_Show(100)
				
				
				IF ThisForm.cmdEditDetail.Caption = "Edit"
					*Place in Edit mode so record can be saved.
					ThisForm.cmdEditDetail.Caption = "Save"
					ThisForm.cmdDeleteDetail.Caption = "Abort"
					ThisForm.cmdAddDetail.Visible	= .F.
				ENDIF
		*	ELSE
		*		This.Value = 0
			ENDIF
		ELSE
			IF lAllow		
				*Delete
				
				PRIVATE cTBL, nID_Detail_Process
				cTBL 				= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
				nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
				
				IF nID_Detail_Process > 0
					*take care of nID_Detail_Process first
					PRIVATE pOrderType, pOrderNumber, pWhat
					pOrderType	= ""
					pOrderNumber= ""
					pWhat = "CORRECTION"
					IF Remove_ID_Detail_Process(nID_Detail_Process, pOrderType, pOrderNumber, cTbl,ThisForm.nConnHandle, pWhat)
						
						This.Parent.grd_Details.RecordSource = ''
						SELECT tmpRTR_Detail
						DELETE FOR Detail = 100
						PACK
						
						INDEX ON Detail TO RTR_Detail
						This.Parent.grd_Details.RecordSource = 'tmpRTR_Detail'
						ThisForm.Detail_Show()
					ELSE
						*Failed to Delete
					ENDIF		
				ELSE
					*delete the Detail because there is no Process		
					This.Parent.grd_Details.RecordSource = ''
					SELECT tmpRTR_Detail
					DELETE FOR Detail = 100
					PACK
						
					INDEX ON Detail TO RTR_Detail
					This.Parent.grd_Details.RecordSource = 'tmpRTR_Detail'
					ThisForm.Detail_Show()
						
				ENDIF
			ELSE
				This.Value = 1
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE chk100.When
		RETURN ThisForm.Detail_AllowToChange(100,PrepareSQLlogic(This.Value,'chk')) AND NOT ThisForm.isEditing
		
	ENDPROC

	PROCEDURE chk150.Click
		PRIVATE lAllow
		lAllow = ThisForm.Detail_AllowToChange(150,PrepareSQLlogic(This.Value,'chk'))
		
		
		IF PrepareSQLlogic(This.Value,'chk')
			IF lAllow
				*Save
				This.Parent.grd_Details.RecordSource = ''
				SELECT tmpRTR_Detail
