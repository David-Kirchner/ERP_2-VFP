	PROCEDURE cmdAddDetail.Click
		ThisForm.cmdEditDetail.Caption = "Save"
		ThisForm.cmdDeleteDetail.Caption = "Abort"
		
		ThisForm.txtDetail.Value = 0
		ThisForm.txtDetail.Enabled = .T.
		
		ThisForm.cmdGetOper.Enabled = .T.
		
		ThisForm.txtOperation.Value	= ''
		ThisForm.txtOper_ID.Value	= 0
		ThisForm.cmdGetPOitem.Enabled = .T.
		*ThisForm.txtPOitem.Enabled = .T.
		ThisForm.txtPOitem.Value	= ''
		ThisForm.txtTBL.Value		= ''
		ThisForm.txtID_Detail_Process.Value		= 0
		
		
		This.Visible = .F.
		
		ThisForm.isEditing = .T.
		
		ThisForm.old_Detail		= 0
		ThisForm.old_Oper_ID	= 0
		ThisForm.old_Operation	= ''
		ThisForm.old_POitem		= ''
			
		ThisForm.txtDetail.SetFocus()
	ENDPROC

	PROCEDURE cmdDeleteDetail.Click
		IF This.Caption = "Delete"
			IF PrepareSQLlogic(tmpRTR_Detail.Finished,'Finished')
				MESSAGEBOX("This Detail has already been Finished."+CHR(13)+"No Delete Allowed.",48,"No Delete")
				RETURN .F.
			ENDIF
		
			IF PrepareSQLlogic(tmpRTR_Detail.Started,'Started')
				MESSAGEBOX("This Detail has already been Started."+CHR(13)+"No Delete Allowed.",48,"No Delete")
				RETURN .F.
			ENDIF
			
			*Allowed to Delete
			PRIVATE nDetail
			nDetail		= PrepareSQLnum(ThisForm.txtDetail.Value,'Detail',3,0)
			IF NOT ThisForm.Detail_AllowToChange(nDetail,.F.)	&& T is edit, F is Delete
				MESSAGEBOX("Not Allowed to Delete.",48,"No Delete")
				RETURN .F.	
			ENDIF
			
			PRIVATE cTBL, nID_Detail_Process
			cTBL 				= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
			nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
				
			IF nID_Detail_Process > 0
				*take care of nID_Detail_Process first
				PRIVATE pOrderType, pOrderNumber, pWhat
				pOrderType	= ""
				pOrderNumber= ""
				pWhat = "CORRECTION"
				IF Remove_ID_Detail_Process(nID_Detail_Process,pOrderType, pOrderNumber,cTBL,ThisForm.nConnHandle,pWhat)
					
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
			
		
			ThisForm.old_Detail = PrepareSQLnum(ThisForm.txtDetail.Value,'Detail',3,0)
			PRIVATE nOldDetail 
			nOldDetail = PrepareSQLnum(ThisForm.old_Detail,'Detail',3,0)
			
			*remove Check mark
			DO CASE
			CASE nOldDetail = 100
				ThisForm.chk100.Value = 0
			CASE nOldDetail = 200
				ThisForm.chk200.Value = 0
			CASE nOldDetail = 300
				ThisForm.chk300.Value = 0
			CASE nOldDetail = 400
				ThisForm.chk400.Value = 0
			CASE nOldDetail = 500
				ThisForm.chk500.Value = 0
			CASE nOldDetail = 600
				ThisForm.chk600.Value = 0
			CASE nOldDetail = 700
				ThisForm.chk700.Value = 0
			CASE nOldDetail = 750
				ThisForm.chk750.Value = 0
			CASE nOldDetail = 800
				ThisForm.chk800.Value = 0
			CASE nOldDetail = 900
				ThisForm.chk900.Value = 0	
			ENDCASE
			
			*Delete
			SELECT tmpRTR_Detail
			DELETE FOR Detail = nDetail
			PACK
			
			INDEX ON Detail TO RTR_Detail
			ThisForm.Detail_Show()
			
		ELSE
			*Abort
			This.Caption = "Delete"
			
			ThisForm.txtDetail.Enabled = .F.
			*ThisForm.cmdGetOper.Enabled = .F.
			*ThisForm.cmdGetPOitem.Enabled = .F.
			*ThisForm.txtPOitem.Enabled = .F.
		
			ThisForm.cmdAddDetail.Visible = .T.
			ThisForm.cmdEditDetail.Visible = .T.
			
			ThisForm.isEditing = .F.
			
			SELECT tmpRTR_Detail
			GO BOTTOM
			ThisForm.grd_Details.Refresh
			
			ThisForm.Detail_Show()
		ENDIF
		
		*After Delete or Abort --refresh these
		ThisForm.txtDetail.Value	= PrepareSQLnum(tmpRTR_Detail.Detail,'Detail',3,0)
		ThisForm.txtOperation.Value	= PrepareSQLtxt(tmpRTR_Detail.Operation,'Operation',20)
		ThisForm.txtOper_ID.Value	= PrepareSQLnum(tmpRTR_Detail.Oper_ID,'Oper_ID',3,0)
		ThisForm.txtPOitem.Value	= PrepareSQLtxt(tmpRTR_Detail.POitem,'POitem',12)
		ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpRTR_Detail.TBL,'TBL',1)
		ThisForm.txtID_Detail_Process.Value	= PrepareSQLtxt(tmpRTR_Detail.ID_D_Prc,'ID_Detail_Process',-3)
		
	ENDPROC

	PROCEDURE cmdEditDetail.Click
		IF This.Caption = "Edit"
			IF PrepareSQLlogic(tmpRTR_Detail.Finished,'Finished')
				MESSAGEBOX("This Detail has already been Finished."+CHR(13)+"No Edit Allowed.",48,"No Edit")
				RETURN .F.
			ENDIF
		
			IF PrepareSQLlogic(tmpRTR_Detail.Started,'Started')
				MESSAGEBOX("This Detail has already been Started."+CHR(13)+"No Edit Allowed.",48,"No Edit")
				RETURN .F.
			ENDIF
			
			PRIVATE nDetail, nOper_ID, cOperation, cPOitem
			nDetail		= PrepareSQLnum(ThisForm.txtDetail.Value,'Detail',3,0)
			nOper_ID	= PrepareSQLnum(ThisForm.txtOper_ID.Value,'Oper_ID',3,0)
			cOperation	= PrepareSQLtxt(ThisForm.txtOperation.Value,'Operation',20)
			cPOitem		= PrepareSQLtxt(Thisform.txtPOitem.Value,'POitem',12)
			*cTBL		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
			*nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
			IF NOT ThisForm.Detail_AllowToChange(nDetail,.T.)
				MESSAGEBOX("Not Allowed to Edit.",48,"No Edit")
				*ThisForm.Detail_Show()
				RETURN .F.	
			ENDIF
			
			ThisForm.old_Detail		= nDetail
			ThisForm.old_Oper_ID	= nOper_ID
			ThisForm.old_Operation	= cOperation
			ThisForm.old_POitem		= cPOitem
			
			This.Caption = "Save"
			ThisForm.cmdDeleteDetail.Caption = "Abort"
			ThisForm.txtDetail.Enabled = .T.
			ThisForm.cmdGetOper.Enabled = .T.
			ThisForm.cmdGetPOitem.Enabled = .T.
			*ThisForm.txtPOitem.Enabled = .T.
		
			ThisForm.cmdAddDetail.Visible	= .F.
			ThisForm.isEditing = .T.
			ThisForm.txtDetail.SetFocus()
			
		ELSE
			PRIVATE nMess, cMess
			*Save
			PRIVATE nOrigDetail
			nOrigDetail = tmpRTR_Detail.Detail
			
			PRIVATE nDetail, nOper_ID, cOperation, cPoitem
			nDetail		= PrepareSQLnum(ThisForm.txtDetail.Value,'Detail',3,0)
			nOper_ID	= PrepareSQLnum(ThisForm.txtOper_ID.Value,'Oper_ID',3,0)
			cOperation	= PrepareSQLtxt(ThisForm.txtOperation.Value,'Operation',20)
			cPOitem		= PrepareSQLtxt(Thisform.txtPOitem.Value,'POitem',12)
			*cTBL		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
			*nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		
			PRIVATE lAllow
			lAllow = ThisForm.Detail_AllowToChange(nDetail,.T.)
			
			IF NOT lAllow
				MESSAGEBOX("Not Allowed to Update Detail.",48,"No Save")
				ThisForm.Detail_Show(nDetail)
			ELSE
				IF ThisForm.CheckSave(nDetail, nOper_ID, cOperation, cPOitem)
					*Save --Insert or Update
					PRIVATE lSaveDone
					lSaveDone = .F.
					
					IF ThisForm.FoundDuplicateDetail(nDetail,.F.,.F.,.F.)
						IF ThisForm.FoundDuplicateDetail(nDetail,nOper_ID,cOperation,cPoitem)
							*Already the Same.
							lSaveDone = .T.
						ELSE
							cMess = "The Detail number '"+ALLTRIM(STR(nDetail))+"' was found."+CHR(13)
							cMess = cMess+"Do you want to update:"+CHR(13)
							cMess = cMess+"Operation:'"+ALLTRIM(tmpRTR_Detail.Operation)+"' with "+CHR(13)
							cMess = cMess+"Operation:'"+ALLTRIM(cOperation)+"' ?"+CHR(13)+CHR(13)
							cMess = cMess+"Oper ID:'"+ALLTRIM(STR(tmpRTR_Detail.Oper_ID))+"' with "+CHR(13)
							cMess = cMess+"Oper ID:'"+ALLTRIM(STR(nOper_ID))+"' ?"+CHR(13)+CHR(13)
							
							cMess = cMess+"POitem:'"+ALLTRIM(STR(tmpRTR_Detail.POitem))+"' with "+CHR(13)
							cMess = cMess+"POitem:'"+ALLTRIM(STR(cPOitem))+"' ?"+CHR(13)+CHR(13)
							
							cMess = cMess+"Continue to Update this Detail?"
							
							nMess = MESSAGEBOX(cMess,32+4,"Update, not Add.")
							IF nMess = 6
								*Do Save the update		
								SELECT tmpRTR_Detail
								LOCATE FOR Detail = nDetail
								IF FOUND('tmpRTR_Detail')
									*REPLACE Detail WITH nDetail
									REPLACE Operation WITH cOperation
									REPLACE Oper_ID WITH nOper_ID
									REPLACE POitem WITH cPoitem
									
									lSaveDone = .T.
								ENDIF
							ELSE
								lSaveDone = .T.
							ENDIF
						ENDIF				
					ELSE
						IF ThisForm.old_Detail != nDetail AND;
							ThisForm.old_Oper_ID = nOper_ID AND ;
							ThisForm.old_Operation = cOperation AND;
							ThisForm.old_POitem = cPOitem
							
							*Only the Detail number was Changed.
							
							cMess = "Do you want to update Detail number"+CHR(13)
							cMess = cMess+"to '"+ALLTRIM(STR(nDetail))+CHR(13)
							cMess = cMess+""+CHR(13)
							cMess = cMess+"Operation is still '"+ALLTRIM(cOperation)+"' "+CHR(13)
							cMess = cMess+"AND Oper ID is still'"+ALLTRIM(STR(nOper_ID))+"' "+CHR(13)+CHR(13)
							cMess = cMess+"Answer Yes to renumber Detail."+CHR(13)
							cMess = cMess+"Answer No to try to Add this new Detail."
							nMess = MESSAGEBOX(cMess,32+4,"Update Detail number.")
							IF nMess = 6
								*Save the new Detail number
								SELECT tmpRTR_Detail
								LOCATE FOR Detail = nDetail
								IF FOUND('tmpRTR_Detail')
									REPLACE Detail WITH nDetail
									lSaveDone = .T.
								ENDIF
							ELSE
							ENDIF
						ENDIF
						
						IF NOT lSaveDone
							*Insert
							SELECT tmpRTR_Detail
							APPEND BLANK IN tmpRTR_Detail
							REPLACE Detail WITH nDetail
							REPLACE Operation WITH cOperation
							REPLACE Oper_ID WITH nOper_ID
							REPLACE POitem WITH cPOitem
							REPLACE CNCLD WITH .F.
							REPLACE Finished WITH .F.
							REPLACE Started WITH .F.
							REPLACE TBL WITH ''
							REPLACE ID_D_Prc WITH 0
				
						ENDIF
							
					ENDIF
					
					INDEX ON Detail TO RTR_Detail
					IF lSaveDone
						ThisForm.Detail_Show(nDetail)
					ELSE
						ThisForm.Detail_Show(nOrigDetail )
					ENDIF
					
				ENDIF	
			ENDIF
			
			This.Caption = "Edit"
			ThisForm.cmdDeleteDetail.Caption = "Delete"
			
			ThisForm.txtDetail.Enabled = .F.
			ThisForm.cmdGetOper.Enabled = .F.
			ThisForm.cmdGetPOitem.Enabled = .F.
			*ThisForm.txtPoitem.Enabled = .F.
			
			ThisForm.cmdAddDetail.Visible	= .T.
			ThisForm.isEditing = .F.
		ENDIF
	ENDPROC

	PROCEDURE cmdGetOper.Click
		PRIVATE nDetail
		nDetail		= PrepareSQLnum(ThisForm.txtDetail.Value,'Detail',3,0)
		IF NOT ThisForm.Detail_AllowToChange(nDetail,.T.)
			MESSAGEBOX("Not Allowed to Edit.",48,"No Edit")
			*ThisForm.Detail_Show()
			RETURN .F.	
		ENDIF
		*****************************************
		
		
		PRIVATE nOper_ID, nReturnOper_ID
		nOper_ID	= PrepareSQLnum(ThisForm.txtOper_ID.Value,'Oper_ID',-3)
		nReturnOper_ID = 0
		
		DO FORM Forms\Select_Operations WITH nOper_ID TO nReturnOper_ID
		
		IF VARTYPE(nReturnOper_ID) = 'N'
			ThisForm.txtOper_ID.Value = PrepareSQLnum(nReturnOper_ID,'Oper_ID',-3)
			ThisForm.txtOperation.Value = Operations_Text(ThisForm.txtOper_ID.Value)
			
			IF ThisForm.cmdEditDetail.Caption = "Edit"
				*Place in Edit mode so record can be saved.
				ThisForm.cmdEditDetail.Caption = "Save"
				ThisForm.cmdDeleteDetail.Caption = "Abort"
				ThisForm.cmdAddDetail.Visible	= .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdGetOper.When
		*!*	RETURN ThisForm.isEditing
		
	ENDPROC

	PROCEDURE cmdGetPOitem.Click
		PRIVATE nDetail
		nDetail		= PrepareSQLnum(ThisForm.txtDetail.Value,'Detail',3,0)
		IF NOT ThisForm.Detail_AllowToChange(nDetail,.T.)
			MESSAGEBOX("Not Allowed to Edit.",48,"No Edit")
			*ThisForm.Detail_Show()
			RETURN .F.	
		ENDIF
		*****************************************
		
		PRIVATE cPOitem 
		cPOitem = PrepareSQLtxt(ThisForm.txtPOItem.Value,'POitem',12)
		PRIVATE vcPOitem
		vcPOitem = ''
		
		DO FORM Forms\SelectPO_Item WITH cPOitem TO vcPOitem
		
		PRIVATE cText
		cText = ''
		IF VARTYPE(vcPOitem) = "C"
			IF Proper_PO_item(vcPOitem) != Proper_PO_item('')
				IF vcPOitem != cPOitem
					IF Proper_PO_item(cPOitem) = Proper_PO_item('')
						ThisForm.txtPOItem.Value = vcPOitem
					ELSE
						cText = "New POitem="+ALLTRIM(vcPOitem)+"!"
						cText = cText +CHR(13)+"Old POitem="+ALLTRIM(cPOitem)+"!"
						IF MESSAGEBOX("Do you wish to replace the POitem?"+CHR(13)+cText,4+32,"Change PO data") = 6
							*needs permission , verified.
							
							ThisForm.txtPOItem.Value = vcPOitem
							
			*				TrackError("Info","User wished to replace the POitem. "+cText,"StockLst_Process",LINENO(1))
			*				TrackMess( "User wished to replace the POitem. "+cText )
						ENDIF
					ENDIF
				ENDIF
				IF ThisForm.cmdEditDetail.Caption = "Edit"
					*Place in Edit mode so record can be saved.
					ThisForm.cmdEditDetail.Caption = "Save"
					ThisForm.cmdDeleteDetail.Caption = "Abort"
					ThisForm.cmdAddDetail.Visible	= .F.
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdGetPOitem.When
		*!*	IF NOT ThisForm.isEditing
		*!*		WAIT WINDOW "Not in Edit Mode." TIMEOUT 2
		*!*	ELSE
		*!*		RETURN ThisForm.isEditing
		*!*	ENDIFThisForm.nConnHandle
	ENDPROC

	PROCEDURE cmdReturn.Click
		
		
		*IF THIS.Caption = "Return"
			ThisForm.Release
			*ThisForm.Release
		*ELSE
			*Abort Save or Add
			
		*ENDIF
		
	ENDPROC

	PROCEDURE cmdSave_Details.Valid
		*SELECT tmpRTR_Detail
		
		*Retrieve current SQL data
		IF USED("tmp_Detail_cur")	
			USE IN tmp_Detail_cur
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT Detail"
		*cSQL = cSQL + ",Operation "
		cSQL = cSQL + ",( SELECT OP.Operation FROM dbo.rtr_Operation OP WHERE OP.Oper_ID = rtr_Detail.Oper_ID ) AS Operation "
		cSQL = cSQL + ",Oper_ID,POitem "
		cSQL = cSQL + ",ISNULL(Started,0) AS Started "
		cSQL = cSQL + ",ISNULL(Finished,0) AS Finished "
		cSQL = cSQL + ",cncld "
		cSQL = cSQL + ",1 AS [DeleteMe] "
		cSQL = cSQL + " FROM dbo.rtr_Detail "
		cSQL = cSQL + " WHERE rtr_ID = "+ALLTRIM(STR(ThisForm.rtr_ID))
		cSQL = cSQL + " ORDER BY Detail"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_Detail_cur')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_Detail_cur')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmp_Detail_cur')
		ELSE
			IF USED('tmp_Detail_cur')
				IF RECCOUNT('tmp_Detail_cur') > 0
				
				ENDIF
			ENDIF
		ENDIF
		
		****************************************
		PRIVATE cDetails
		cDetails = ''
		
		SELECT tmpRTR_Detail
		SCAN
			IF EMPTY(cDetails)
				cDetails = PrepareSQLtxt(tmpRTR_Detail.Detail,'Detail',3)
			ELSE
				cDetails = cDetails + "," + PrepareSQLtxt(tmpRTR_Detail.Detail,'Detail',3)
			ENDIF
		ENDSCAN
		
		****************************************
		*Retrieve COMMON Details
		IF USED("tmp_Detail_Common")	
			USE IN tmp_Detail_Common
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT Detail"
		*cSQL = cSQL + ",Operation"
		cSQL = cSQL + ",( SELECT OP.Operation FROM dbo.rtr_Operation OP WHERE OP.Oper_ID = rtr_Detail.Oper_ID ) AS Operation "
		cSQL = cSQL + ",Oper_ID,POitem "
		cSQL = cSQL + ",ISNULL(Started,0) AS Started "
		cSQL = cSQL + ",ISNULL(Finished,0) AS Finished "
		cSQL = cSQL + ",cncld "
		cSQL = cSQL + ",0 AS [DeleteMe] "
		cSQL = cSQL + " FROM dbo.rtr_Detail "
		cSQL = cSQL + " WHERE rtr_ID = "+ALLTRIM(STR(ThisForm.rtr_ID))
		cSQL = cSQL + " AND Detail IN ("+cDetails+")"
		cSQL = cSQL + " ORDER BY Detail"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_Detail_Common')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_Detail_Common')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmp_Detail_Common')
		ELSE
			IF USED('tmp_Detail_Common')
				IF RECCOUNT('tmp_Detail_Common') > 0
				
				ENDIF
			ENDIF
		ENDIF
		
		
		****************************************
		*Mark
		*Curr defaulted to DeleteMe
		*Common defaulted to NOT DeleteMe
		*Delete out Curr that are still marked as DeleteMe
		
			
		***********************************************************************************************
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		***********************************************************************************************
		
		****************************************
		*Scan thru current table, save changes to SQL
		PRIVATE nDetail,nOper_ID,cPOitem
		PRIVATE lSaved, lRollBack 
		lRollBack = .F.
		
		SELECT tmpRTR_Detail
		SCAN
			lSaved = .F.
			nDetail		= PrepareSQLnum(tmpRTR_Detail.Detail,'Detail',4,0)
			nOper_ID	= PrepareSQLnum(tmpRTR_Detail.Oper_ID,'Oper_ID',4,0)
			cPOitem		= PrepareSQLtxt(tmpRTR_Detail.POitem,'POitem',12)
			
			IF USED('tmp_Detail_cur')
				SELECT tmp_Detail_cur
				LOCATE FOR Detail = nDetail AND Oper_ID = nOper_ID	
				IF FOUND('tmp_Detail_cur')
					IF Proper_PO_Item(tmp_Detail_cur.POitem) = Proper_PO_Item(cPOitem)
						*Nothing to Change, do not Delete.
						REPLACE DeleteMe WITH 0 IN tmp_Detail_cur
						lSaved = .T.
					ENDIF
				ENDIF
				
				IF NOT lSaved 
					LOCATE FOR Detail = nDetail 
					IF FOUND('tmp_Detail_cur')
						*Found a changed with Detail that needs updated
						cSQL = "UPDATE dbo.rtr_Detail SET "
						*cSQL = cSQL + " Operation = '"+cOperation+"'"
						cSQL = cSQL + " Oper_ID = "+STR(nOper_ID)	
						cSQL = cSQL + ",Poitem = dbo.f_ProperPOitem('"+cPOitem+"')"
						cSQL = cSQL + "	WHERE [rtr_ID]="+ALLTRIM((ThisForm.rtr_ID))	
						cSQL = cSQL + " AND Detail = "+STR(nDetail)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
							lRollBack = .T.
						ELSE
							lSaved = .T.
							*Updated Changes, do not Delete.
							SELECT tmp_Detail_cur
							REPLACE DeleteMe WITH 0 IN tmp_Detail_cur
						ENDIF
						
					ENDIF
				ENDIF
			ENDIF
			
			IF NOT lSaved 
				cSQL = "INSERT INTO dbo.rtr_Detail "
				cSQL = cSQL + "	( [rtr_ID]"
				cSQL = cSQL + ",Detail"
				cSQL = cSQL + ",[Started]"
				*cSQL = cSQL + ",Operation "
				cSQL = cSQL + ",Oper_ID "	
				cSQL = cSQL + ",Poitem "	
				cSQL = cSQL + ") VALUES ("
				cSQL = cSQL + ALLTRIM((ThisForm.rtr_ID))
				cSQL = cSQL + ","+STR(nDetail)
				cSQL = cSQL + ",0 " &&keep as a default
				*cSQL = cSQL + ",'"+cOperation+"'"
				cSQL = cSQL + ","+STR(nOper_ID)
				cSQL = cSQL + ",dbo.f_ProperPOitem('"+cPoitem+"')"
				cSQL = cSQL + ")"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					lRollBack = .T.
				ELSE
					lSaved = .T.
					*Detail was not found in Curr SQL
				ENDIF
			
			ENDIF
			
			IF lRollBack 
				EXIT
			ENDIF
			SELECT tmp_Detail_cur
		ENDSCAN
		
		**********
		IF lRollback 
			MESSAGEBOX("SQL Transaction Rolled Back",0,"Could not save!")
			=SQLROLLBACK(ThisForm.nConnHandle)
			TrackError("RouterDetailOrder.vcx Save_Details: Could not save!","SQL Transaction Rolled Back","RouterDetailOrder.vcx.Save_Detail.Valid()",LINENO(1))
			
		ELSE
			WAIT WINDOW "Saved!" NOWAIT
			=SQLCOMMIT(ThisForm.nConnHandle)
		ENDIF
		
		***********************************************************************************************
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		***********************************************************************************************
		
		
		
	ENDPROC

	PROCEDURE cmdSave_Details.When
		RETURN NOT ThisForm.isEditing
	ENDPROC

	PROCEDURE grd_Details.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.txtDetail.Value	= PrepareSQLnum(tmpRTR_Detail.Detail,'Detail',4,0)
		ThisForm.txtOperation.Value	= PrepareSQLtxt(tmpRTR_Detail.Operation,'Operation',20)
		ThisForm.txtOper_ID.Value	= PrepareSQLnum(tmpRTR_Detail.Oper_ID,'Oper_ID',4,0)
		ThisForm.txtPOitem.Value	= PrepareSQLtxt(tmpRTR_Detail.POitem,'POitem',12)
		
		ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpRTR_Detail.TBL,'TBL',1)
		ThisForm.txtID_Detail_Process.Value	= PrepareSQLnum(tmpRTR_Detail.ID_D_Prc,'ID_Detail_Process',-3)
		
		
	ENDPROC

	PROCEDURE grd_Details.When
		RETURN NOT ThisForm.isEditing 
	ENDPROC

	PROCEDURE txtDetail.GotFocus
		ThisForm.OldDetail = This.Value
	ENDPROC

	PROCEDURE txtDetail.Valid
		PRIVATE nDetail
		nDetail = PrepareSQLnum(This.Value,'Detail',3,0)
		
		IF NOT ThisForm.Detail_AllowToChange(nDetail,.T.)
			This.Value = 0
			RETURN .F.
		ELSE
			DO CASE
			CASE nDetail = 100
				ThisForm.txtOper_ID.Value = 523
				ThisForm.txtOperation.Value = Operations_Text(523) &&"Select Material     "
				ThisForm.chk100.Value = 1
			CASE nDetail = 150
				ThisForm.txtOper_ID.Value = 522
				ThisForm.txtOperation.Value = Operations_Text(522) &&"Pull Material     "
				ThisForm.chk150.Value = 1
			CASE nDetail = 200
				ThisForm.txtOper_ID.Value = 0
				ThisForm.txtOperation.Value = "PO Conversion     "
				ThisForm.chk200.Value = 1
			CASE nDetail = 300
				ThisForm.txtOper_ID.Value = 525
				ThisForm.txtOperation.Value = Operations_Text(525) &&"Radial Forge "
				ThisForm.chk300.Value = 1
			CASE nDetail = 400
				ThisForm.txtOper_ID.Value = 0
				ThisForm.txtOperation.Value = "Modify Stock"
				ThisForm.chk400.Value = 1
			CASE nDetail = 500
				ThisForm.txtOper_ID.Value = 0
				ThisForm.txtOperation.Value = "Machining  "
				ThisForm.chk500.Value = 1
			CASE nDetail = 600
				ThisForm.txtOper_ID.Value = 506
				ThisForm.txtOperation.Value = Operations_Text(506) &&"Testing "
				ThisForm.chk600.Value = 1
			CASE nDetail = 700
				ThisForm.txtOper_ID.Value = 520
				ThisForm.txtOperation.Value = Operations_Text(520) &&"Straighten and CG "
				ThisForm.chk700.Value = 1
			CASE nDetail = 750
				ThisForm.txtOper_ID.Value = 521
				ThisForm.txtOperation.Value = Operations_Text(521) &&"Cut ends Square "
				ThisForm.chk750.Value = 1
			CASE nDetail = 800
				ThisForm.txtOper_ID.Value = 501
				ThisForm.txtOperation.Value = Operations_Text(523) &&"Packaging "
				ThisForm.chk800.Value = 1
			CASE nDetail = 900
				ThisForm.txtOper_ID.Value = 503
				ThisForm.txtOperation.Value = Operations_Text(503) &&"Inspection \ Receive "
				ThisForm.chk900.Value = 1
			*OTHERWISE
			ENDCASE
		
			PRIVATE nOldDetail 
			nOldDetail = PrepareSQLnum(ThisForm.OldDetail,'Detail',3,0)
			*remove Check mark
			DO CASE
			CASE nOldDetail = 100
				ThisForm.chk100.Value = 0
			CASE nOldDetail = 200
				ThisForm.chk200.Value = 0
			CASE nOldDetail = 300
				ThisForm.chk300.Value = 0
			CASE nOldDetail = 400
				ThisForm.chk400.Value = 0
			CASE nOldDetail = 500
				ThisForm.chk500.Value = 0
			CASE nOldDetail = 600
				ThisForm.chk600.Value = 0
			CASE nOldDetail = 700
				ThisForm.chk700.Value = 0
			CASE nOldDetail = 750
				ThisForm.chk750.Value = 0
			CASE nOldDetail = 800
				ThisForm.chk800.Value = 0
			CASE nOldDetail = 900
				ThisForm.chk900.Value = 0		
			ENDCASE
				
		ENDIF
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS rtr_detail_browse AS form 		&& Browse or Select Detail
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="shpRTR_ID" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdRefreshSQL" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdExit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtRTR_ID" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtCreateDate" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtCreateTime" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtOrderType" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkStarted" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkFinished" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtNextDetail" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtOrderNum" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkcncld" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblDetail" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtDetail" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtJobType" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtDetail_StartDate" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtDetail_StartTime" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtOper_ID" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkD_Started" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkD_Finished" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkD_Cncld" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtOperation" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtJobClass" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="edtOper_Note" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtDetail_FinishDate" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblDetailFinishDate" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRTR_Detail" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblJobType" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdReturnSelect" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: formsrefresh
		*m: init_router_detail
		*m: init_router_detail_select
		*m: init_router_ordertype		&& Find Order Type with Order Number parametes
		*m: load_rtr
		*m: load_rtr_detail
		*m: showwo_wodetail
		*m: showwo_wod_window
		*m: show_rtr_detail
		*m: show_wo
		*m: show_wod
		*p: birtr_id		&& Router ID
		*p: nconnhandle
		*p: nholdreturn
