*************** Proc:
nPU = nPU_Acct_Form( cForm, nConn ) uses SQL
nPU = GetPUfromForm(pForm, pConnHandle) uses SQL
nPU = GetPUfromFormSvc( cForm, lLabServices,lConvServ, lEquipment) --Return a 4 'Lot' if Svc is True
nPU = Get_PUfromText(cPUtext)  - hard coded, use SQL instead
nPU = GetPUfrom_SOitem(pcSOitem,ThisForm.nConnHandle)   	-HPA Acct
nPU = GetPUfrom_POitem(pcPOitem,ThisForm.nConnHandle)   	-HPA Acct (Services, ConvServ, Equipment is /Pc )
nPU = GetOrder_PUfrom_POitem(pcPOitem,ThisForm.nConnHandle)  -Vendor PU
nPU = Get_PUinSales(cSOItem, ThisForm.nConnHandle)
nPU = GetPUfromForm( cForm, nConn )

nMax_P = get_Max_P_fromPU (nPU, pConnHandle) -- used to check data MAX

cUnit = GetPRICEUNITfromFORM (pForm, pConnHandle)
cUnit = getPricingUnitbyID( nID, cTBL, pConnHandle )
cUnit = GetUNITfromFORM(cForm, nConn)
cUnit = get_Unit_PU( nPU, nConn )  			uses SQL return 1,2,3
cUnit = Get_cPUfrom_nPU(nPU, pConnHandle)  	uses SQL returns '$/Lb'
cUnit = Get_PUtext(nPU)   - old hard coded
cUnit = Get_PUstr_from_nPU(nPU, pConnHandle)  uses SQL return '$/#'
cUnit = Get_PU_Price_String(Order_PU, Order_Qty, Order_P)   &&Remove0(pQTY,18,0,.F.) + ' Lbs '
cCaption = Get_PriceU_from_nPU(nPU)  --hard coded

lOK = IsPriceUnitAllowed( cForm, cUnit, nConn )
lOK = Is_InvoiceValue_Valid(nInvoiceValue,nS_PU,pConnHandle)  --Compare to PU MAX

lOK = Get_Quote_Pricing(nPieces, cAlloy, cForm, nThck, nSz2, nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
opens CURSOR tmpQuote_Pricing (P N(18,4), PU N(1), QTY N(18,4), Total N(18,4) )

nQTY = Get_QTYinSales(cSOItem, ThisForm.nConnHandle)				--Replace with getQTY_SOitem()
nTotalCost = Calc_StockCost(D.CostValue, P.Pounds, P.PFt, nPPc, P.PU)  DEPRICATED
nQTY = Calc_QTY(Alloy,Form,Pieces,Thck,Sz2,Sz3,cOtherFld,ThisForm.nConnHandle)  -calls SQL
nQTY = get_QTYbySOitem( pcSOitem, nConn, cAndSome )  				--Replace with getQTY_SOitem()
nQTY = getQTY_SOitem(cSOitem,ThisFormSet.nConnHandle)  				--starts with PT_Qty otherwise uses S_QTY
nCustomer_QTY = getQTY_SOitem(cSOitem,ThisFormSet.nConnHandle)
nProcessSelectedQTY = get_PartialPick_QTY(cSOitem,nWO,ThisFormSet.nConnHandle)


nP = Get_Qoute_P (nPieces, cAlloy, cForm, nThck, nSz2, nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConn)  -old school

nItemSale = Get_ItemSaleinSales(cSOItem, ThisForm.nConnHandle)   changed to gs_Sale, (S_QTY*S_P), Quoted_Total then ItemSale
nItemSale = getSale_SOitem(cSOitem,ThisFormSet.nConnHandle)

nLBS = Get_LBSinSales(cSOItem, ThisForm.nConnHandle)
nLBS = GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,pConnHandle)
nLBS = GetWeight(tS.Pieces,tS.Alloy,tS.Form,tS.Thck,tS.Sz2,tS.Sz3,nConn)
nLBS = CalcWeight(nPieces, cAlloy, cForm, nThickness, nSize2, nSize3, pConnHandle)  uses SQL

nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 

nQShipped = get_SOitem_PCs_Complete( pcSOitem, pnPCs, pnPS_No, nConn )  --needs work.
nQShipped = get_SOitem_QTY_Complete( pcSOitem, pnPCs, pnPS_No, nConn )  --needs work
lComplete = IS_SOitem_Complete( pcSOitem, pnPCs, pnQTY, pnWeight, pnPS_No, nConn )  --needs work


nPOCost = getPOCost_PO(nHPAPO,ThisFormSet.nConnHandle, cAndSome)
nStkCost = getStkCost_SOitem(cSOitem,ThisFormSet.nConnHandle)
nStkPaid = getStkPaid_SOitem(cSOitem,ThisFormSet.nConnHandle)

