ThisForm.lblPO_PU.Caption	= Get_cPUfrom_nPU( nCust_PU, ThisForm.nConnHandle)
ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( nCust_PU, ThisForm.nConnHandle)


*nPU = nPU_Acct_Form( cForm, nConn )
