cSQL= cSQL+",StockLst_QTY, StockLst_P, StockLst_PU "
cSQL= cSQL+",ISNULL(StockLst_Total,dbo.f_GetPOItem_Total(P.POItem)) AS StockLst_Total "

cLabel = Get_Label_from_nPU(nPU, pConnHandle)  uses SQL return CHAR(7) 'Pounds,Feet,Peices..

ThisForm.txtAcct_Qty.Value	= PrepareSQLnum(tmpSDSOiHeat.Orig_QTY,'S_QTY',-5)	
PRIVATE nAcct_PU
ThisForm.lblAcct_PU.Caption = Get_cPUfrom_nPU( PrepareSQLnum(tmpSDSOiHeat.Orig_PU,'S_PU',-1), ThisForm.nConnHandle)
ThisForm.lblAcct_PUstr.Caption = Get_PUstr_from_nPU( PrepareSQLnum(tmpSDSOiHeat.Orig_PU,'S_PU',-1), ThisForm.nConnHandle)									
*
