Proc_SQL:SQLExecError 			:4 Parameter, Retries Query!, then Sends to RecordError()
 --SQLExecError( pSQL, pnConnection, nSQLEXEC, cWorkArea )
 

Main.PRG: ON ERROR DO (SYS(5)+SYS(2003)+"\Progs\ErrorHandlerLog.prg") WITH ERROR(),MESSAGE(1),MESSAGE(),PROGRAM(),LINENO() --ErrorHandlerLog.prg has a diferent parameter order then RecordError
RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
INSERT INTO dbo.Errors ([nerror],[mess1],[cprogram],[nlineno],[errordate],[MACHINE],[Revision],[Memo1])

