-----------------------------------------------------			
--Proc_Setup:CollectErrors(lSkipPackDB,lQuite)
--on SQL 2017, no longer build VFP table to send to SQL, Send if can!
--no longer using CollectErrors 2019-05-20.  Errors.dbf



PRIVATE lTranAlreadySet, nProp 
nProp = SQLGETPROP(nConn, 'Transactions')
lTranAlreadySet = (nProp = 2)
		
IF NOT lTranAlreadySet
	= SQLSETPROP(nConn, 'Transactions', 2)  && Manual transactions
ENDIF

IF NOT lTranAlreadySet
	= SQLCOMMIT(nConn)
	= SQLROLLBACK(nConn)
	= SQLSETPROP(nConn, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans
ENDIF


nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
ENDDO
IF nSQLEXEC < 0 &&Try again!
	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL 2' TIMEOUT 1
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
	ENDDO
ENDIF
IF nSQLEXEC < 0
	SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
	RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
ENDIF
		
cUser = RIGHT(SYS(0),LEN(SYS(0))-AT("#",SYS(0))-1 )
