SELECT 0
nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpPriceTbl')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpPriceTbl')
ENDDO
IF nSQLEXEC < 0 &&Try again!
	nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPriceTbl")
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL 2' TIMEOUT 1
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPriceTbl")
		
		IF nSQLEXEC < 0
			IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
				nSQLEXEC = 0
			ENDIF
		ENDIF
	ENDDO
ENDIF
IF nSQLEXEC < 0
	SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'tmpPriceTbl')
ENDIF

IF USED('tmpPriceTbl')
	IF RECCOUNT('tmpPriceTbl') > 0
	
	ENDIF
ENDIF