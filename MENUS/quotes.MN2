*<Procedures>
PROCEDURE BAR_1_OF_Applicatio_FB2P
	IF FILE('Forms\REDAREA.SCX')
		DO FORM 'Forms\REDAREA.SCX'
	ELSE
		WAIT WINDOW "Did not find the RedArea.SCX;  'L' to Locate" to BLANK
		IF UPPER(BLANK) = "L"
			DO FORM LOCFILE('REDAREA','SCX','Find RedArea in VFP\GFM\Forms')
		ENDIF
	ENDIF
ENDPROC && BAR_1_OF_Applicatio_FB2P

PROCEDURE BAR_2_OF_Applicatio_FB2P
	IF FILE('forms\SPEC_EDIT.SCX')
		DO FORM 'forms\SPEC_EDIT'
	ELSE
		WAIT WINDOW "Did not find the SPEC_EDIT.scx;  'L' to Locate" to BLANK
		IF UPPER(BLANK) = "L"
			DO FORM LOCFILE('SPEC_EDIT','SCX','Find SPEC_EDIT in \Forms\')
		ENDIF
	ENDIF
ENDPROC && BAR_2_OF_Applicatio_FB2P

PROCEDURE BAR_2_OF_Quotes_FB2P
	DO FORM forms\FindQuotes
	_VFP.ActiveForm.ReFresh
ENDPROC && BAR_2_OF_Quotes_FB2P

PROCEDURE BAR_3_OF_Quotes_FB2P
	SELECT Quotes
	browse
ENDPROC && BAR_3_OF_Quotes_FB2P

*</Procedures>
