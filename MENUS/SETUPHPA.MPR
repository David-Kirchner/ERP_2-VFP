*

SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _7cq10wx3f OF _MSYSMENU PROMPT "\<File" COLOR SCHEME 3 ;
	KEY ALT+F, ""
DEFINE PAD _7cq10wx3g OF _MSYSMENU PROMPT "\<Edit" COLOR SCHEME 3 ;
	KEY ALT+E, ""
DEFINE PAD _7cq10wx3h OF _MSYSMENU PROMPT "\<Help" COLOR SCHEME 3 ;
	KEY ALT+H, ""
ON PAD _7cq10wx3f OF _MSYSMENU ACTIVATE POPUP file
ON PAD _7cq10wx3g OF _MSYSMENU ACTIVATE POPUP edit
ON PAD _7cq10wx3h OF _MSYSMENU ACTIVATE POPUP help

DEFINE POPUP file MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR _mfi_close OF file PROMPT "\<Close" ;
	MESSAGE "Closes the current file"
DEFINE BAR 2 OF file PROMPT "\-"
DEFINE BAR _mfi_quit OF file PROMPT "E\<xit" ;
	MESSAGE "Quits Visual FoxPro"

DEFINE POPUP edit MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR _med_undo OF edit PROMPT "\<Undo" ;
	KEY CTRL+Z, "Ctrl+Z" ;
	MESSAGE "Undoes the last command or action"
DEFINE BAR 2 OF edit PROMPT "\-"
DEFINE BAR _med_cut OF edit PROMPT "Cu\<t" ;
	KEY CTRL+X, "Ctrl+X" ;
	MESSAGE "Removes the selection and places it onto the Clipboard"
DEFINE BAR _med_copy OF edit PROMPT "\<Copy" ;
	KEY CTRL+C, "Ctrl+C" ;
	MESSAGE "Copies the selection onto the Clipboard"
DEFINE BAR _med_paste OF edit PROMPT "\<Paste" ;
	KEY CTRL+V, "Ctrl+V" ;
	MESSAGE "Pastes the contents of the Clipboard"
DEFINE BAR _med_clear OF edit PROMPT "Cle\<ar" ;
	MESSAGE "Removes the selection and does not place it onto the Clipboard"
DEFINE BAR 7 OF edit PROMPT "\-"
DEFINE BAR _med_slcta OF edit PROMPT "Se\<lect All" ;
	KEY CTRL+A, "Ctrl+A" ;
	MESSAGE "Selects all text or items in the current window"

DEFINE POPUP help MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR _mst_about OF help PROMPT "\<About Microsoft Visual FoxPro..." ;
	MESSAGE "Displays version and copyright information about Visual FoxPro"
DEFINE BAR _mst_hpsch OF help PROMPT "Microsoft \<Visual FoxPro Help Topics" ;
	KEY F1, "F1" ;
	MESSAGE "Locates Help topics based on keywords you enter"
DEFINE BAR 3 OF help PROMPT "\-"
DEFINE BAR _mwi_clear OF help PROMPT "Clea\<r" ;
	MESSAGE "Clears text from the application workspace or the current output window"
