cInsert = cInsert + "InqNumP,"
cInsert = cInsert + "SalesP,"
*new line
cInsert = cInsert + "SalesNum,SOitem,Item,HPApo,SaleDate,BuyFrom,"
cInsert = cInsert + "BuyCost,BuyFrom2,HPApo2,"
*new line
cInsert = cInsert + "CustID,"
cInsert = cInsert + "QuoteMemo,"
cInsert = cInsert + "Comments,"
cInsert = cInsert + "CountryC,"
cInsert = cInsert + "Country,"
cInsert = cInsert + "Services,"
cInsert = cInsert + "RandLen,"
cInsert = cInsert + "Metric,"
*cInsert = cInsert + "StartStock,"
cInsert = cInsert + "SZ1Orig,"
cInsert = cInsert + "SZ2Orig,"
cInsert = cInsert + "SZ3Orig,"
*new line
cInsert = cInsert + "CWeight,"
cInsert = cInsert + "CP_LB,"
cInsert = cInsert + "CP_PC,"
cInsert = cInsert + "CP_PCc,"
cInsert = cInsert + "CThk,"
cInsert = cInsert + "CLotP,"
cInsert = cInsert + "CLotCP,"
cInsert = cInsert + "CCut,"
