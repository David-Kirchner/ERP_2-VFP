DEFINE POPUP shortcut SHORTCUT RELATIVE FROM MROW(),MCOL()
DEFINE BAR 1 OF shortcut PROMPT "Clone Inquire to SalesP"
DEFINE BAR 2 OF shortcut PROMPT "Clone Order"
DEFINE BAR 3 OF shortcut PROMPT "Reset Open Quotes"
DEFINE BAR 4 OF shortcut PROMPT "Move Quote"
DEFINE BAR 5 OF shortcut PROMPT "Reduction of Area"
ON SELECTION BAR 1 OF shortcut ;
	DO _7cq10wwlc ;
	IN LOCFILE("ERP\MENUS\QUOTESC" ,"MPX;MPR|FXP;PRG" ,"WHERE is QUOTESC?")
ON SELECTION BAR 2 OF shortcut ;
	DO _7cq10wwld ;
	IN LOCFILE("ERP\MENUS\QUOTESC" ,"MPX;MPR|FXP;PRG" ,"WHERE is QUOTESC?")
ON SELECTION BAR 3 OF shortcut ;
	DO _7cq10wwle ;
	IN LOCFILE("ERP\MENUS\QUOTESC" ,"MPX;MPR|FXP;PRG" ,"WHERE is QUOTESC?")
ON SELECTION BAR 4 OF shortcut ;
	DO _7cq10wwlf ;
	IN LOCFILE("ERP\MENUS\QUOTESC" ,"MPX;MPR|FXP;PRG" ,"WHERE is QUOTESC?")
ON SELECTION BAR 5 OF shortcut ;
	DO _7cq10wwlg ;
	IN LOCFILE("ERP\MENUS\QUOTESC" ,"MPX;MPR|FXP;PRG" ,"WHERE is QUOTESC?")

ACTIVATE POPUP shortcut

*       *********************************************************
*       *                                                         
*       * _7CQ10WWLC  ON SELECTION BAR 1 OF POPUP shortcut        
*       *                                                         
*       * Procedure Origin:                                       
*       *                                                         
*       * From Menu:  QUOTESC.MPR,            Record:    5        
*       * Called By:  ON SELECTION BAR 1 OF POPUP shortcut        
*       * Prompt:     Clone Inquire to SalesP                     
*       * Snippet:    1                                           
*       *                                                         
*       *********************************************************
*
PROCEDURE _7cq10wwlc
PRIVATE m.nINQMAX,m.cUseThisSP

*!*	PRIVATE m.nUseThisID, m.cOldName, m.cCurInqNumP
*!*	SELECT Quotes
*!*	m.nUseThisID = Quotes.ID
*!*	m.cOldName = RIGHT(Quotes.InqNumP, 1)
*!*	IF NOT BOF()
*!*		SKIP -1
*!*		m.cCurInqNumP = Quotes.InqNumP
*!*		SKIP 1
*!*	ENDIF

*!*	PRIVATE lClone2Self
*!*	lClone2Self = .F.


PRIVATE m.cOrigInqnumP
m.cOrigInqnumP  = Quotes.InqNumP

m.cUseThisSP = ''
WAIT WINDOW "Copy to Whom? (Use Initial)" TO m.cUseThisSP
IF TYPE("m.cUseThisSP") <> "C"
	RETURN .f.
ENDIF
m.cUseThisSP = UPPER(m.cUseThisSP)

IF EMPTY('m.cUseThisSP')
	RETURN.F.
ENDIF

IF m.cUseThisSP != "D"
	IF NOT AppSetup_ActiveSales_SalesP(m.cUseThisSP)
		IF EMPTY(m.cUseThisSP)
			MESSAGEBOX("Bad User Name ''" ,0,"Not Active in Sales!")
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Bad User Name ''")
		ELSE
			MESSAGEBOX("Bad User Name '"+m.cUseThisSP+"'" ,0,"Not Active in Sales!")
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Bad User Name '"+m.cUseThisSP+"'")
		ENDIF
		RETURN .F.
	ENDIF
ENDIF

*!*	IF m.cOldName = m.cUseThisSP
*!*		lClone2Self = .T.
*!*	ENDIF

IF NOT AppSetup_SalesP_Exists(m.cUseThisSP)
	MESSAGEBOX("Initial '"+m.cUseThisSP+"', is not for a Sales Person!",0,"Unknown Initail")
	RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Initial '"+m.cUseThisSP+"', is not for a Sales Person!")
	RETURN
ENDIF

WAIT WINDOW "Please Wait.." NOWAIT
m.cUseThisSP = ALLTRIM(UPPER(m.cUseThisSP))

**************************************
PRIVATE cCOMPANY,cName,cPhone,cPhone_Ext,cFax,cEmail,cAlloy,cForm
PRIVATE cCC,nPieces,nThck,nSz2,nSz3,nWeight,cDescript,nP_lb,nP_pc,nP_ft
PRIVATE nCuts,cOtherFld,nOtherP,nLotP,LotCost,cLeadTime
PRIVATE cCustID,cQuoteMemo,cComments,cCountryC,cCountry,lServices,lRandLen,lMetric,cSZ1Orig,cSZ2Orig,cSZ3Orig
PRIVATE nCWeight,nCP_LB,nCP_PC,nCP_PCc,cCThk,nCLotP,nCLotCP,nCCut,lOpen_,nBracket,lStartStock,lTN,nSurCharge
PRIVATE cCut,cCutOptions,cNoNoiseName,nCutHR,nQ_P,nQ_QTY,nStandardSize

cCOMPANY		= PrepareSQLtxt(Quotes.Company,'Company',30)
cName			= PrepareSQLtxt(Quotes.Name,'Name',25)
cPhone	 		= PrepareSQLtxt(Quotes.Phone,'Phone',10)
cPhone_Ext		= PrepareSQLtxt(Quotes.Phone_ext,'Phone_ext',6)
cFax			= PrepareSQLtxt(Quotes.Fax,'Fax',10)
cEmail			= PrepareSQLtxt(Quotes.Email,'Email',60)
cAlloy			= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
cForm			= PrepareSQLtxt(Quotes.Form,'Form',2)
cCC				= PrepareSQLtxt(Quotes.CC,'CC',1)
nPieces			= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
nThck			= PrepareSQLnum(Quotes.Thck,'Thck',10,4)
nSz2			= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
nSz3			= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
nWeight			= PrepareSQLnum(Quotes.Weight,'Weight',8,1)
cDescript		= PrepareSQLtxt(Quotes.Descript,'Descript',50)
nP_lb			= PrepareSQLnum(Quotes.P_lb,'P_lb',8,2)
nP_pc			= PrepareSQLnum(Quotes.P_pc,'P_pc',9,2)
nP_ft			= PrepareSQLnum(Quotes.P_ft,'P_ft',8,2)
nCuts			= PrepareSQLnum(Quotes.Cuts,'Cuts',6,0)
cOtherFld		= PrepareSQLtxt(Quotes.OtherFld,'OtherFld',10)
nOtherP			= PrepareSQLnum(Quotes.OtherP,'OtherP',8,2)
nLotP			= PrepareSQLnum(Quotes.LotP,'LotP',8,2)
nLotCost		= PrepareSQLnum(Quotes.LotCost,'LotCost',8,2)
cLeadTime		= PrepareSQLtxt(Quotes.LeadTime,'LeadTime',15)
*	cLine1			= PrepareSQLtxt(Quotes.Line1,'Line1',60)
cCustID			= PrepareSQLtxt(Quotes.CustID,'CustID',20)
*	cQuoteMemo		= PrepareSQLtxt(Quotes.QuoteMemo,'QuoteMemo',-1)
cQuoteMemo		= " "
cComments		= ALLTRIM(PrepareSQLtxt(Quotes.Comments,'Comments',-1))
cCountryC		= PrepareSQLtxt(Quotes.CountryC,'CountryC',10)
cCountry		= PrepareSQLtxt(Quotes.Country,'Country',20)
lServices		= PrepareSQLchk(Quotes.Services,'Services')
lRandLen		= PrepareSQLchk(Quotes.RandLen,'RandLen')
lMetric			= PrepareSQLchk(Quotes.Metric,'Metric')
cSZ1Orig		= PrepareSQLtxt(Quotes.SZ1Orig,'SZ1Orig',20)
cSZ2Orig		= PrepareSQLtxt(Quotes.SZ2Orig,'SZ2Orig',20)
cSZ3Orig		= PrepareSQLtxt(Quotes.SZ3Orig,'SZ3Orig',20)

nCWeight		= PrepareSQLnum(Quotes.CWeight,'CWeight',-5)
nCP_LB			= PrepareSQLnum(Quotes.CP_LB,'CP_LB',-5)
nCP_PC			= PrepareSQLnum(Quotes.CP_PC,'CP_PC',-5)
nCP_PCc			= PrepareSQLnum(Quotes.CP_PCc,'CP_PCc',-5)
cCThk			= PrepareSQLtxt(Quotes.CThk,'CThk',9)
nCLotP			= PrepareSQLnum(Quotes.CLotP,'CLotP',-5)
nCLotCP			= PrepareSQLnum(Quotes.CLotCP,'CLotCP',-5)
nCCut			= PrepareSQLnum(Quotes.CCut,'CCut',-5)
lOpen_			= .T.
nBracket		= PrepareSQLnum(Quotes.Bracket,'Bracket',-1)
lStartStock		= PrepareSQLchk(Quotes.StartStock,'StartStock')
lTN				= PrepareSQLchk(Quotes.TN,'TN')
nSurCharge		= PrepareSQLnum(Quotes.SurCharge,'SurCharge',-5)

cCut			= PrepareSQLtxt(Quotes.Cut,'Cut',1)
cCutOptions		= PrepareSQLtxt(Quotes.CutOptions,'CutOptions',75)
cNoNoiseName	= PrepareSQLtxt(Quotes.NoNoiseName,'NoNoiseName',30)
nCutHR			= PrepareSQLnum(Quotes.CutHR,'CutHR',-2)
nQ_P			= PrepareSQLnum(Quotes.Q_P,'Q_P',-5)
nQ_QTY			= PrepareSQLnum(Quotes.Q_QTY,'Q_QTY',-5)

nQ_PU		= PrepareSQLnum(Quotes.Q_PU,'Q_PU',-1)
nQ_Total	= PrepareSQLnum(Quotes.Q_Total,'Q_Total',10,2)
nS_QTY		= PrepareSQLnum(Quotes.S_QTY,'S_QTY',-5)
nS_P		= PrepareSQLnum(Quotes.S_P,'S_P',-5)
nS_PU		= PrepareSQLnum(Quotes.S_PU,'S_PU',-1)
IF nS_PU < 1
 	nS_PU	= nPU_Acct_Form( cForm, gnConnHandle)
ENDIF
nS_Total 	= PrepareSQLnum(Quotes.S_Total,'Total',-5)

nStandardSize	= PrepareSQLnum(Quotes.StandardSize,'StandardSize',9,3)


*********
m.nINQMAX = 0

IF USED('MaxInqNum')
	USE IN MaxInqNum
ENDIF

SELECT 0

PRIVATE cSQLMaxInqNum
cSQLMaxInqNum = "SELECT MAX(inqnum) FROM dbo.AllQuotes WHERE SalesP = '"+m.cUseThisSP+"'"
nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
ENDDO
IF nSQLEXEC < 0
	SQLExecError(cSQLMaxInqNum,gnConnHandle,nSQLEXEC, 'MaxInqNum')
	m.nINQMAX=1000
ELSE
	IF USED('MaxInqNum')
		m.nINQMAX = MaxInqNum.EXP
		USE IN MaxInqNum
	ENDIF
ENDIF

IF m.nINQMAX=1000
	*Second Try
	cSQLMaxInqNum = "SELECT MAX(inqnum) FROM dbo.AllQuotes WHERE SalesP = '"+m.cUseThisSP+"'"
	nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
	ENDDO
	IF nSQLEXEC < 0
		SQLExecError(cSQLMaxInqNum,gnConnHandle,nSQLEXEC, 'MaxInqNum')
		m.nINQMAX=1000
	ELSE
		IF USED('MaxInqNum')
			m.nINQMAX = MaxInqNum.EXP
			USE IN MaxInqNum
		ENDIF
	ENDIF
ENDIF

*THISFORMSET.Quotes.LOCKSCREEN = .T.
m.nINQMAX = m.nINQMAX + 1
PRIVATE m.cInqnumP
m.cInqnumP = STR(m.nINQMAX,8,0)+m.cUseThisSP

PRIVATE cInsert
cInsert = "INSERT INTO dbo.AllQuotes ("
cInsert = cInsert + "COMPANY,"
cInsert = cInsert + "NAME,"
cInsert = cInsert + "PHONE,"
cInsert = cInsert + "PHONE_EXT,"
