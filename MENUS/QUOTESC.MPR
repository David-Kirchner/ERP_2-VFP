cInsert = cInsert + ","+STR(nStandardSize,9,3)

cInsert = cInsert + ")"


nSQLEXEC = SQLEXEC(gnConnHandle,cInsert)
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( gnConnHandle, cInsert)
ENDDO
IF nSQLEXEC < 0
	SQLExecError(cInsert,gnConnHandle,nSQLEXEC,'')
ELSE
*	IF SQLCOMMIT(gnConnHandle) < 1
*		SQLExecError("Cannot commit."+CHR(13)+cInsert,gnConnHandle)
*	ELSE
		TrackMess("Quote was cloned from '"+ALLTRIM(m.cOrigInqnumP)+"' to '"+ALLTRIM(m.cInqnumP)+"'"  )
		MESSAGEBOX("Quote was cloned from '"+ALLTRIM(m.cOrigInqnumP)+CHR(13)+"' to '"+ALLTRIM(m.cInqnumP)+"'"+CHR(13)+"Company '"+ALLTRIM(cCOMPANY)+"'" ,0,"Clone Quote")
		RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Quote was cloned from '"+ALLTRIM(m.cOrigInqnumP)+"' to '"+ALLTRIM(m.cInqnumP)+"'" )
*	ENDIF
ENDIF




*       *********************************************************
*       *                                                         
*       * _7CQ10WWLD  ON SELECTION BAR 2 OF POPUP shortcut        
*       *                                                         
*       * Procedure Origin:                                       
*       *                                                         
*       * From Menu:  QUOTESC.MPR,            Record:    6        
*       * Called By:  ON SELECTION BAR 2 OF POPUP shortcut        
*       * Prompt:     Clone Order                                 
*       * Snippet:    2                                           
*       *                                                         
*       *********************************************************
*
PROCEDURE _7cq10wwld
PRIVATE INQMAX,RC,m.next_inq,cUseThisName,cOldName,nSalesNum
PRIVATE cCurInqNumP

nSalesNum = PrepareSQLnum(Quotes.SalesNum,'Salesnum',-3)

IF nSalesnum = 0
	MESSAGEBOX("You must select a previos Order to clone!",64,"Not Order")
	RETURN
ENDIF

SELECT Quotes
*IF NOT BOF()
*	SKIP -1
	cCurInqNumP = Quotes.InqNumP
*	SKIP 1
*ENDIF

PRIVATE lClone2Self
lClone2Self = .F.

cOldName = RIGHT(Quotes.InqNumP, 1)
PRIVATE cOrigInqnumP
cOrigInqnumP  = Quotes.InqNumP

*WAIT WINDOW "Copy to Whom? (Use Initial)" TO cUseThisName
cUseThisName = cOldName &&Just limit Clone Order to same SalesP

IF TYPE("cUseThisName") <> "C"
	RETURN .F.
ENDIF
IF EMPTY('cUseThisName')
	RETURN .F.
ENDIF
IF NOT AppSetup_ActiveSales_SalesP(cUseThisName)
	MESSAGEBOX("Bad User Name '"+cCurrSalesP+"'" ,0,"Not Active in Sales!")
	RETURN .F.
ENDIF

IF cOldName = cUseThisName
	lClone2Self = .T.
ENDIF

WAIT WINDOW "Please Wait.." NOWAIT
cUseThisName = ALLTRIM(UPPER(cUseThisName))

IF NOT AppSetup_SalesP_Exists(cUseThisName)
	=MESSAGEBOX("Initial '"+cUseThisName+"', is not for a Sales Person!",0,"Unknown Initail")
	RETURN
ENDIF

SELECT Quotes
SET FILTER TO SalesNum = nSalesNum
GO TOP

**************************************
PRIVATE cCOMPANY,cName,cPhone,cPhone_Ext,cFax,cEmail,cAlloy,cForm
PRIVATE cCC,cCL,nPieces,nThck,nSz2,nSz3,nWeight,cDescript,nP_lb,nP_pc,nP_ft
PRIVATE nCuts,cOtherFld,nOtherP,nLotP,LotCost,cLeadTime
PRIVATE cCustID,cQuoteMemo,cComments,cCountryC,cCountry,lServices,lRandLen,lMetric,cSZ1Orig,cSZ2Orig,cSZ3Orig
PRIVATE cCut,cCutOptions,cNoNoiseName,nCutHR,nQ_P,nQ_QTY, nQ_PU
PRIVATE nS_P, nS_QTY, nS_PU, cInqNumP, nFeet, nStandardSize

DO WHILE NOT EOF()
	WAIT WINDOW Quotes.InqNumP NOWAIT
	
	cCOMPANY		= PrepareSQLtxt(Quotes.Company,'Company',30)
	cName			= PrepareSQLtxt(Quotes.Name,'Name',25)
	cPhone	 		= PrepareSQLtxt(Quotes.Phone,'Phone',10)
	cPhone_Ext		= PrepareSQLtxt(Quotes.Phone_ext,'Phone_ext',6)
	cFax			= PrepareSQLtxt(Quotes.Fax,'Fax',10)
	cEmail			= PrepareSQLtxt(Quotes.Email,'Email',60)
	cAlloy			= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
	cForm			= PrepareSQLtxt(Quotes.Form,'Form',2)
	cCC				= PrepareSQLtxt(Quotes.CC,'CC',1)
	cCL				= PrepareSQLtxt(Quotes.CL,'CL',1)
	nPieces			= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
	nThck			= PrepareSQLnum(Quotes.Thck,'Thck',10,4)
	nSz2			= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
	nSz3			= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
	nWeight			= PrepareSQLnum(Quotes.Weight,'Weight',8,1)
	cDescript		= PrepareSQLtxt(Quotes.Descript,'Descript',50)
	nP_lb			= PrepareSQLnum(Quotes.P_lb,'P_lb',8,2)
	nP_pc			= PrepareSQLnum(Quotes.P_pc,'P_pc',9,2)
	nP_ft			= PrepareSQLnum(Quotes.P_ft,'P_ft',8,2)
	nCuts			= PrepareSQLnum(Quotes.Cuts,'Cuts',6,0)
	cOtherFld		= PrepareSQLtxt(Quotes.OtherFld,'OtherFld',10)
	nOtherP			= PrepareSQLnum(Quotes.OtherP,'OtherP',8,2)
	nLotP			= PrepareSQLnum(Quotes.LotP,'LotP',8,2)
	
	nLotCost		= PrepareSQLnum(Quotes.LotCost,'LotCost',8,2)
	cLeadTime		= PrepareSQLtxt(Quotes.LeadTime,'LeadTime',15)
	*	cLine1			= PrepareSQLtxt(Quotes.Line1,'Line1',60)
	cCustID			= PrepareSQLtxt(Quotes.CustID,'CustID',20)
	*	cQuoteMemo		= PrepareSQLtxt(Quotes.QuoteMemo,'QuoteMemo',-1)
	cQuoteMemo		= " "
	cComments		= ALLTRIM(PrepareSQLtxt(Quotes.Comments,'Comments',-1))
	cCountryC		= PrepareSQLtxt(Quotes.CountryC,'CountryC',10)
	cCountry		= PrepareSQLtxt(Quotes.Country,'Country',20)
	*lServices		= PrepareSQLchk(Quotes.Services,'Services')
	lServices		= .F.
	*lRandLen		= PrepareSQLchk(Quotes.RandLen,'RandLen')
	lRandLen		= .F.
	*lMetric		= PrepareSQLchk(Quotes.Metric,'Metric')
	lMetric			= .F.
	cSZ1Orig		= PrepareSQLtxt(Quotes.SZ1Orig,'SZ1Orig',20)
	cSZ2Orig		= PrepareSQLtxt(Quotes.SZ2Orig,'SZ2Orig',20)
	cSZ3Orig		= PrepareSQLtxt(Quotes.SZ3Orig,'SZ3Orig',20)


	cCut			= PrepareSQLtxt(Quotes.Cut,'Cut',1)
	cCutOptions		= PrepareSQLtxt(Quotes.CutOptions,'CutOptions',75)
	cNoNoiseName	= PrepareSQLtxt(Quotes.NoNoiseName,'NoNoiseName',30)
	nCutHR			= PrepareSQLnum(Quotes.CutHR,'CutHR',-2)
	nQ_P			= PrepareSQLnum(Quotes.Q_P,'Q_P',-5)
	nQ_QTY			= PrepareSQLnum(Quotes.Q_QTY,'Q_QTY',-5)
	
	nQ_PU			= PrepareSQLnum(Quotes.Q_PU,'Q_PU',-1)
	nS_P		= PrepareSQLnum(Quotes.S_P,'S_P',-5)
	nS_QTY		= PrepareSQLnum(Quotes.S_QTY,'S_QTY',-5)
	nS_PU		= PrepareSQLnum(Quotes.S_PU,'S_PU',-1)
	cInqNumP	= PrepareSQLtxt(Quotes.InqNumP,'InqNumP',9)
	nFeet = 0

	nStandardSize	= PrepareSQLnum(Quotes.StandardSize,'StandardSize',9,3)
	
	IF USED('MaxInqNum')
		USE IN MaxInqNum
	ENDIF

	SELECT 0

	PRIVATE cSQLMaxInqNum
	cSQLMaxInqNum = "SELECT MAX(inqnum) FROM dbo.AllQuotes WHERE SalesP = '"+cUseThisName+"'"
	nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
	ENDDO
	IF nSQLEXEC < 0
		SQLExecError(cSQLMaxInqNum,gnConnHandle,nSQLEXEC, 'MaxInqNum')
		INQMAX=1000
	ELSE
		IF USED('MaxInqNum')
			INQMAX = MaxInqNum.EXP
			USE IN MaxInqNum
		ENDIF
	ENDIF

	IF INQMAX=1000
		*Second Try
		cSQLMaxInqNum = "SELECT MAX(inqnum) FROM dbo.AllQuotes WHERE SalesP = '"+cUseThisName+"'"
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQLMaxInqNum,gnConnHandle,nSQLEXEC, 'MaxInqNum')
			INQMAX=1000
		ELSE
			IF USED('MaxInqNum')
				INQMAX = MaxInqNum.EXP
				USE IN MaxInqNum
			ENDIF
		ENDIF
	ENDIF
	
	
	***************************
	*New_Acct_Stnd
	*IF nS_P <= 0
	*		nS_P	= IIF(nS_PU=1,nP_lb+(nOtherP/nWeight), IIF(nS_PU=2,nP_Ft+(nOtherP/nFeet),nP_Pc+(nOtherP/nPieces) ))
	*	ENDIF
	*****
	IF nQ_P <= 0
		MESSAGEBOX("Converting from old Quote Number to new Accting Standard",0,"Convert")
		
		*Record was still using P_LB..
		nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
		cAlloy		= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
		cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
		nThck		= PrepareSQLnum(Quotes.Thck,'Thck',10,4)
		nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
		nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
				
		nFeet 		= Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle)
		
		*nQ_P = Get_Qoute_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
		
		*Use old School Calc
		****************************************************
		*Use this Function to return a table with the Quoted Answers
		*This overwrite typical units and uses Units found in OtherFld and OtherP
		IF Get_Quote_Pricing(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
			IF USED('tmpQuote_Pricing')
				*nQ_P		= Get_Quote_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
				nQ_P	= PrepareSQLnum(tmpQuote_Pricing.P,'Q_P',-5)
				nQ_PU	= PrepareSQLnum(tmpQuote_Pricing.PU,'Q_PU',-1)
				nQ_QTY	= PrepareSQLnum(tmpQuote_Pricing.QTY,'Q_QTY',-5)
				nQ_Total= PrepareSQLnum(tmpQuote_Pricing.Total,'Q_Total',-5)

				USE IN tmpQuote_Pricing
			ENDIF
		ENDIF
		SELECT Quotes
		
		*lUpdateQuotes = .T.
	ENDIF
	
	*****
	IF nQ_Total = 0
		IF ( nQ_P * nQ_QTY ) > 0
			nQ_Total = nQ_P * nQ_QTY
			*lUpdateQuotes = .T.
			
		ENDIF
	ENDIF
	
	*****
	*Check Values
	*nQ_P, nQ_QTY	
	DO CASE
	CASE nQ_PU = 1
		*Weight must match QTY
		IF ROUND(nWeight,0) <> ROUND(nQ_QTY,0)
			ncWeight	= PrepareSQLnum(Quotes.cWeight,'Weight',8,1)
			IF ROUND(nWeight,0) <> ROUND(ncWeight,0) AND ROUND(ncWeight,0) = ROUND(nQ_QTY,0)
				cMess = "Weight on Quote "+ALLTRIM(STR(nWeight,10,0))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY,10,0))+CHR(13)+" or match Calculated Pounds "+ALLTRIM(STR(nWeight,10,0))+CHR(13)+"and Pricing Units is Per Pound!"+CHR(13)+" for InqNumP="+cInqNumP
				nMess = MESSAGEBOX(cMess+CHR(13)+"Do you want to Replace Weight with QTY Weight?",4+32,"Do you want to Replace?")
				IF nMess = 6
					nWeight = nQ_QTY
				ENDIF
			ENDIF
		ENDIF
		IF ROUND(nWeight,0) <> ROUND(nQ_QTY,0)	
			cMess = "Weight on Quote "+ALLTRIM(STR(nWeight,10,0))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY,10,0))+CHR(13)+"and Pricing Units is Per Pound!"+CHR(13)+" for InqNumP="+cInqNumP
			MESSAGEBOX(cMess,16,"Fix before proceding")
			TrackError(cMess,"Weight and QTY do not match when PU=1", PROGRAM(), LINENO(1))
			*lUpdateQuotes = .F.
			*lExitScan = .T.
		ENDIF
		
	CASE nQ_PU = 2
		*Feet must match QTY
		IF nFeet = 0
			nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
			cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
			nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
			nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)

			nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle)
		ENDIF
		IF nFeet <> nQ_QTY
			cMess = "Length of Feet on Quote "+ALLTRIM(STR(nFeet ))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY))+CHR(13)+"and Pricing Units is Per Foot!"+CHR(13)+" for InqNumP="+cInqNumP
			MESSAGEBOX(cMess,16,"Fix before proceding")
			TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
			*lUpdateQuotes = .F.
			*lExitScan = .T.
		ENDIF
				
	CASE nQ_PU = 3
		*Pieces must match Q_TY
		nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
		IF nQ_QTY <> nPieces
			cMess = "Pieces on Quote "+ALLTRIM(STR(nPieces))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY))+CHR(13)+"and Pricing Units is Per PC!"+CHR(13)+" for InqNumP="+cInqNumP
			MESSAGEBOX(cMess,16,"Fix before proceding")
			TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
			*lUpdateQuotes = .F.
			*lExitScan = .T.
		ENDIF
		
	CASE nQ_PU = 4
		*nLot
		IF nQ_QTY <> 1
			cMess = "QTY is not 1 "+ALLTRIM(STR(nQ_QTY))+CHR(13)+"and Pricing Units is Per LOT!"+CHR(13)+" for InqNumP="+cInqNumP
			MESSAGEBOX(cMess,16,"Fix before proceding")
			TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
			*lUpdateQuotes = .F.
			*lExitScan = .T.
		ENDIF
		
	CASE nQ_PU = 5
		*Inched must match QTY
		IF nFeet = 0
			nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
			cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
			nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
			nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)

			nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle)
		ENDIF
		
		nInches = ROUND(nFeet/12,0)
		IF ROUND(nInches,0) <> ROUND(nQ_QTY,0)
			cMess = "Length of Inches on Quote "+ALLTRIM(STR(ROUND(nInches,0)))+CHR(13)+" does not match QTY "+ALLTRIM(STR(ROUND(nQ_QTY,0)))+CHR(13)+"and Pricing Units is Per Inch!"+CHR(13)+" for InqNumP="+cInqNumP
			MESSAGEBOX(cMess,16,"Fix before proceding")
			TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
			*lUpdateQuotes = .F.
			*lExitScan = .T.
		ENDIF
			
	CASE nQ_PU = 6
		*Weight in Kg must match QTY
		nKg = nWeight / 2.205
		IF ROUND(nKg ,0) <> ROUND(nQ_QTY,0)
			cMess = "Weight in Kg on Quote "+ALLTRIM(STR(nKg ,10,0))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY,10,0))+CHR(13)+"and Pricing Units is Per Kg!"+CHR(13)+" for InqNumP="+cInqNumP
			MESSAGEBOX(cMess,16,"Fix before proceding")
			TrackError(cMess,"Weight and QTY do not match when PU=1", PROGRAM(), LINENO(1))
			*lUpdateQuotes = .F.
			*lExitScan = .T.
		ENDIF
		
	CASE nQ_PU = 7
		*MTR must match QTY
		IF nFeet = 0
			nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
			cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
			nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
			nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)

			nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle)
		ENDIF
		
		nMeters = ROUND(nFeet/ 3.281,0)
		IF ROUND(nMeters ,0) <> ROUND(nQ_QTY,0)
			cMess = "Length of Meters on Quote "+ALLTRIM(STR(ROUND(nMeters,0)))+CHR(13)+" does not match QTY "+ALLTRIM(STR(ROUND(nQ_QTY,0)))+CHR(13)+"and Pricing Units is Per Meter!"+CHR(13)+" for InqNumP="+cInqNumP
			MESSAGEBOX(cMess,16,"Fix before proceding")
			TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
			*lUpdateQuotes = .F.
			*lExitScan = .T.
		ENDIF				
		
	ENDCASE
	*****

	
	*THISFORMSET.Quotes.LOCKSCREEN = .T.
	m.next_inq = INQMAX + 1
	PRIVATE m.cInqnumP
	m.cInqnumP = STR(m.next_inq,8,0)+cUseThisName

	PRIVATE cInsert
	cInsert = "INSERT INTO dbo.AllQuotes ("
	cInsert = cInsert + "COMPANY,"
	cInsert = cInsert + "NAME,"
	cInsert = cInsert + "PHONE,"
	cInsert = cInsert + "PHONE_EXT,"
	cInsert = cInsert + "FAX,"
	cInsert = cInsert + "EMAIL,"
	cInsert = cInsert + "PO_NUM,"
	cInsert = cInsert + "ALLOY,"
	cInsert = cInsert + "FORM,"
	cInsert = cInsert + "CC,"
	cInsert = cInsert + "CL,"
	cInsert = cInsert + "PIECES,"
	cInsert = cInsert + "THCK,"
	cInsert = cInsert + "SZ2,"
	cInsert = cInsert + "SZ3,"
	cInsert = cInsert + "Weight,"
	cInsert = cInsert + "DESCRIPT,"
	cInsert = cInsert + "P_lb,"
	cInsert = cInsert + "P_pc,"
	cInsert = cInsert + "P_ft,"
	cInsert = cInsert + "cuts,"
	cInsert = cInsert + "OtherFld,"
	cInsert = cInsert + "OtherP,"
	*new line
	cInsert = cInsert + "LotP,"
	cInsert = cInsert + "LotCost,"
	cInsert = cInsert + "LeadTime,"
	cInsert = cInsert + "cWeight,"
	cInsert = cInsert + "cP_lb,"
	cInsert = cInsert + "cP_pc,"
	cInsert = cInsert + "cP_Pcc,"
	cInsert = cInsert + "cTHK,"
	cInsert = cInsert + "cLotP,"
	cInsert = cInsert + "cLotCp,"
	cInsert = cInsert + "cCut,"
	*	cInsert = cInsert + "Line1,"
	*new line
	*	cInsert = cInsert + "InqDate,"
	cInsert = cInsert + "InqNum,"
	cInsert = cInsert + "InqNumP,"
	cInsert = cInsert + "SalesP,"
	*new line
	cInsert = cInsert + "SalesNum,"
	cInsert = cInsert + "SOitem,"
	cInsert = cInsert + "Item,"
	cInsert = cInsert + "HPApo,"
	cInsert = cInsert + "SaleDate,"
	cInsert = cInsert + "BuyFrom,"
	*	cInsert = cInsert + "ShipDate,"
	cInsert = cInsert + "BuyCost,"
	cInsert = cInsert + "BuyFrom2,"
	cInsert = cInsert + "HPApo2,"
	cInsert = cInsert + "Open_,"
	cInsert = cInsert + "Bracket,"
	*new line
	cInsert = cInsert + "CustID,"
	cInsert = cInsert + "QuoteMemo,"
	cInsert = cInsert + "Comments,"
	cInsert = cInsert + "CountryC,"
	cInsert = cInsert + "Country,"
	cInsert = cInsert + "Services,"
	cInsert = cInsert + "RandLen,"
	cInsert = cInsert + "Metric,"
	cInsert = cInsert + "SZ1Orig,"
	cInsert = cInsert + "SZ2Orig,"
	cInsert = cInsert + "SZ3Orig,"
	*new line
	cInsert = cInsert + "Cut,"
	cInsert = cInsert + "CutOptions,"
	cInsert = cInsert + "NoNoiseName,"
	cInsert = cInsert + "CutHR,"
	cInsert = cInsert + "Q_P,"
	cInsert = cInsert + "Q_QTY,"
	
	cInsert = cInsert + "Q_PU,"
	cInsert = cInsert + "Q_Total,"
	cInsert = cInsert + "S_QTY,"
	cInsert = cInsert + "S_P,"
	cInsert = cInsert + "S_PU,"
	
	cInsert = cInsert + "StandardSize"

	cInsert = cInsert + ") VALUES ("
	cInsert = cInsert + "'" +cCOMPANY+"'"
	cInsert = cInsert + ",'"+cName+"'"
	cInsert = cInsert + ",'"+cPhone+"'"
	cInsert = cInsert + ",'"+cPhone_Ext+"'"
	cInsert = cInsert + ",'"+cFax+"'"
	cInsert = cInsert + ",'"+cEmail+"'"
	cInsert = cInsert + ",''"
	cInsert = cInsert + ",'"+cAlloy+"'"
	cInsert = cInsert + ",'"+cForm+"'"
	cInsert = cInsert + ",'"+cCC+"'"
	cInsert = cInsert + ",'"+cCL+"'"
	cInsert = cInsert + ","+STR(nPieces,7,0)
	cInsert = cInsert + ","+STR(nThck,10,4)
	cInsert = cInsert + ","+STR(nSz2,9,3)
	cInsert = cInsert + ","+STR(nSz3,9,3)
	cInsert = cInsert + ","+STR(nWeight,8,1)
	cInsert = cInsert + ",'"+cDescript+"'"
	cInsert = cInsert + ","+STR(nP_lb,8,2)
	cInsert = cInsert + ","+STR(nP_pc,9,2)
	cInsert = cInsert + ","+STR(nP_ft,8,2)
	cInsert = cInsert + ","+STR(nCuts,6,0)
	cInsert = cInsert + ",'"+cOtherFld+"'"
	cInsert = cInsert + ","+STR(nOtherP,8,2)
	cInsert = cInsert + ","+STR(nLotP,9,2)
	cInsert = cInsert + ","+STR(nLotCost,9,2)
	cInsert = cInsert + ",'"+cLeadTime+"'"
	cInsert = cInsert + ",0,0,0,0,'',0,0,0"  &&cWeight,cP_lb,cP_pc,cP_Pcc,cTHK,cLotP,cLotCp,cCut
	*	cInsert = cInsert + ",'"+cLine1+"'"
	cInsert = cInsert + ","+STR(m.next_inq)+",'"+m.cInqnumP+"','"+cUseThisName+"',"
	cInsert = cInsert + "0,'',0,0,'',''"  &&SalesNum,SOitem,Item,HPApo,SaleDate,BuyFrom
	*	cInsert = cInsert + ",''"  &&ShipDate
	cInsert = cInsert + ",0,'',0,1,0"
	cInsert = cInsert + ",'"+cCustID+"'"
	cInsert = cInsert + ",'"+cQuoteMemo+"'"
	cInsert = cInsert + ",'"+cComments+"'"
	cInsert = cInsert + ",'"+cCountryC+"'"
	cInsert = cInsert + ",'"+cCountry+"'"
	cInsert = cInsert + ","+IIF(lServices,'1','0')
	cInsert = cInsert + ","+IIF(lRandLen,'1','0')
	cInsert = cInsert + ","+IIF(lMetric,'1','0')
	cInsert = cInsert + ",'"+IIF(lMetric, cSZ1Orig, "" )+"'"
	cInsert = cInsert + ",'"+IIF(lMetric, cSZ2Orig, "" )+"'"
	cInsert = cInsert + ",'"+IIF(lMetric, cSZ3Orig, "" )+"'"
	*new line
	cInsert = cInsert + ",'"+cCut+"'"
	cInsert = cInsert + ",'"+cCutOptions+"'"
	cInsert = cInsert + ",'"+cNoNoiseName+"'"
	cInsert = cInsert + ","+STR(nCutHR)
	cInsert = cInsert + ","+STR(nQ_P,18,4)
	cInsert = cInsert + ","+STR(nQ_QTY,18,4)
	
	cInsert = cInsert + ","+STR(nQ_PU)
	cInsert = cInsert + ","+STR(nQ_Total)
	cInsert = cInsert + ","+STR(nS_QTY)
	cInsert = cInsert + ","+STR(nS_P)
	cInsert = cInsert + ","+STR(nS_PU)


	cInsert = cInsert + ","+STR(nStandardSize,9,3)
	cInsert = cInsert + ")"


	nSQLEXEC = SQLEXEC(gnConnHandle,cInsert)
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC( gnConnHandle, cInsert)
	ENDDO
	IF nSQLEXEC < 0
		SQLExecError(cInsert,gnConnHandle,nSQLEXEC,'')
	ELSE
*		IF SQLCOMMIT(gnConnHandle) < 1
*			SQLExecError("Cannot commit."+CHR(13)+cInsert,gnConnHandle)
*		ELSE
			TrackMess("Quote was cloned from '"+ALLTRIM(cOrigInqnumP)+"' to '"+ALLTRIM(m.cInqnumP)+"'"  )
*		ENDIF
	ENDIF
	
	SELECT Quotes
	SKIP
ENDDO

SELECT Quotes
SET FILTER TO
LOCATE FOR InqNumP = cCurInqNumP


*       *********************************************************
*       *                                                         
*       * _7CQ10WWLE  ON SELECTION BAR 3 OF POPUP shortcut        
*       *                                                         
*       * Procedure Origin:                                       
*       *                                                         
*       * From Menu:  QUOTESC.MPR,            Record:    7        
*       * Called By:  ON SELECTION BAR 3 OF POPUP shortcut        
*       * Prompt:     Reset Open Quotes                           
*       * Snippet:    3                                           
*       *                                                         
*       *********************************************************
*
PROCEDURE _7cq10wwle
PRIVATE INQMAX,RC,m.next_inq,cUseThisName,cOldName,nSalesNum
PRIVATE cCurInqNumP

SELECT Quotes

cUseThisName= RIGHT(Quotes.InqNumP, 1)
PRIVATE cOrigInqnumP
cCurInqNumP = Quotes.InqNumP

WAIT WINDOW "Please Wait.. '"+cUseThisName+"'" NOWAIT

PRIVATE cSQL
cSQL= "UPDATE dbo.AllQuotes "
cSQL = cSQL + " SET open_ = 0 "
cSQL = cSQL + " WHERE SalesP = '"+cUseThisName+"'"
cSQL = cSQL + " AND ISNULL(open_,1) = 1 "
cSQL = cSQL + " AND InqDate+30 < GetDate() "

nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
ENDDO
IF nSQLEXEC < 0
	SQLExecError(cSQL,gnConnHandle,nSQLEXEC )
ENDIF

**********
IF USED("Quotes")
	USE IN Quotes
ENDIF
SELECT 0
nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
ENDDO
IF nSQLEXEC < 0
	SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
ENDIF

LOCATE FOR InqNumP = cCurInqNumP
**********
WAIT CLEAR

MESSAGEBOX("Reset Open Quotes to just last 30 days",64,"Done")


*       *********************************************************
*       *                                                         
*       * _7CQ10WWLF  ON SELECTION BAR 4 OF POPUP shortcut        
*       *                                                         
*       * Procedure Origin:                                       
*       *                                                         
*       * From Menu:  QUOTESC.MPR,            Record:    8        
*       * Called By:  ON SELECTION BAR 4 OF POPUP shortcut        
*       * Prompt:     Move Quote                                  
*       * Snippet:    4                                           
*       *                                                         
*       *********************************************************
*
PROCEDURE _7cq10wwlf
*Move Quote.

IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
	SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
ENDIF

PRIVATE INQMAX,RC,m.next_inq,TALKPROP,cUseThisName,nUseThisID, cOldInqNumP, cNewInqNumP
PRIVATE cPrevInqNumP, cCurrSalesP

SELECT Quotes
nUseThisID = Quotes.ID
cCurrSalesP = PrepareSQLtxt(Quotes.SalesP,'SalesP',1)

IF Quotes.SalesNum > 0
	MESSAGEBOX( "This is an Order!",0,"Cannot move as an Order!" )
	RETURN .F.
ENDIF

IF NOT BOF()
	SKIP -1
	cPrevInqNumP = PrepareSQLtxt(Quotes.InqNumP,'SalesP',1)
	SKIP 1
ENDIF

WAIT WINDOW "Send to Whom? (use Initial)" TO cUseThisName
IF TYPE("cUseThisName") <> "C"
	MESSAGEBOX("SalesP not found!",0,"Failed to Move.")
	RETURN .F.
ENDIF
IF EMPTY(cUseThisName)
	MESSAGEBOX("SalesP not found!",0,"Failed to Move.")
	RETURN .F.
ENDIF

IF cUseThisName = cCurrSalesP
	MESSAGEBOX("Same User name '"+cCurrSalesP+"'"+CHR(13)+"No new name",0,"Failed to Move.")
	RETURN .F.
ENDIF

IF NOT AppSetup_ActiveSales_SalesP(cUseThisName)
	MESSAGEBOX("Bad User '"+cUseThisName+"'"+CHR(13)+"Cannot continue."+CHR(13)+"Not Active in Sales!",0,"Failed to Move.")
	RETURN .F.
ENDIF

cOldInqNumP = PrepareSQLtxt(Quotes.InqNumP,'InqNumP',9)

****************************
IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
	SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
ENDIF


cUseThisName = ALLTRIM(UPPER(cUseThisName))

IF NOT AppSetup_SalesP_Exists(cUseThisName)
	=MESSAGEBOX("Initial '"+cUseThisName+"', is not for a Sales Person!",0,"Unknown Initail")
	RETURN
ENDIF

PRIVATE cNewSalesRep
cNewSalesRep = AppSetup_Get_SalesRep_SalesP(cUseThisName)

IF EMPTY(cNewSalesRep)
	MESSAGEBOX("SalesP (salesRep) not found!"+CHR(13)+cNewSalesRep+CHR(13)+"Failed to Move.")
	RETURN .F.
ENDIF

WAIT WINDOW "Moving quote to "+cNewSalesRep+". Please Wait..." NOWAIT

****************************

PRIVATE cSQLMaxInqNum, nSQLEXEC
cSQLMaxInqNum = "SELECT MAX(inqnum) FROM dbo.AllQuotes WHERE SalesP = '"+cUseThisName+"'"
nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
ENDDO
IF nSQLEXEC > 0
	IF USED('MaxInqNum')
		INQMAX = PrepareSQLnum(MaxInqNum.EXP,'ID',-3)
		USE IN MaxInqNum
	ENDIF
ELSE
	INQMAX=1000
ENDIF
IF ISNULL(INQMAX)
	INQMAX = 1000
ENDIF

IF InqMAX = 1000
	cSQLMaxInqNum = "SELECT MAX(inqnum) FROM dbo.AllQuotes WHERE SalesP = '"+cUseThisName+"'"
	nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
	ENDDO
	IF nSQLEXEC > 0
		IF USED('MaxInqNum')
			IF VARTYPE( MaxInqNum.EXP ) = "N"
				INQMAX = PrepareSQLnum(MaxInqNum.EXP,'ID',-3)
			ENDIF
			USE IN MaxInqNum
		ENDIF
	ELSE
		INQMAX=1000
	ENDIF
ENDIF

WAIT CLEAR



IF InqMAX < 1000
	TrackError("InqMAX < 1000.","Error.","QuotesC:Move Inquire",LINENO(1))
	InqMAX = 1000
ENDIF

m.next_inq = INQMAX + 1
cNewInqNumP = STR(m.Next_Inq,8,0)+cUseThisName

cSQLUpdate = "UPDATE dbo.AllQuotes SET SalesP = '"+cUseThisName+"'"
cSQLUpdate = cSQLUpdate + ",InqNum = "+ALLTRIM(STR(m.Next_Inq))
cSQLUpdate = cSQLUpdate + ",InqNumP = '"+cNewInqNumP+"'"
cSQLUpdate = cSQLUpdate + ",InqDate = GetDate()"
cSQLUpdate = cSQLUpdate + " WHERE ID = "+ALLTRIM(STR(nUseThisID))

nSQLEXEC = SQLEXEC(gnConnHandle, cSQLUpdate )
DO WHILE nSQLEXEC = 0
	WAIT WINDOW 'SQL' TIMEOUT 1
	nSQLEXEC = SQLEXEC(gnConnHandle, cSQLUpdate )
ENDDO
	
IF nSQLEXEC < 0
	MESSAGEBOX("Not Moved!")
	TrackError("Not Moved!",cSQLUpdate,"QuotesSC:Move Quote Procedure",LINENO(1) )
ELSE

	*Update SupplierQuotes
	cSQL = "UPDATE dbo.SupplierQuotes SET "
	cSQL = cSQL + " InqNumP='"+cNewInqNumP+"'"
	cSQL = cSQL + " WHERE InqNumP ='"+cOldInqNumP+"'"
	
	nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, '')
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, '')
	ENDDO
	IF nSQLEXEC < 0
		SQLEXECError(cSQL ,nConn,nSQLEXEC, '')
	ENDIF
	
	************
	
	*Update the view
*		ThisFormSet.Quotes.LockScreen = .T.
	SELECT Quotes
	USE IN Quotes
	nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
	DO WHILE nSQLEXEC = 0
		WAIT WINDOW 'SQL' TIMEOUT 1
		nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
	ENDDO
	*SET RELATION TO InqNumP INTO RFQ ADDITIVE
*	LOCATE FOR InqNumP = cCurInqNumP
*		ThisFormSet.Quotes.LockScreen = .F.
	MESSAGEBOX ("This Record has been moved to "+ALLTRIM(STR(m.Next_Inq,8,0))+cUseThisName+"'",0,"Moved!")
	
	************
	TrackMess("Moved Quote "+ALLTRIM(cOldInqNumP)+" from '"+cCurrSalesP+"' to '"+cUseThisName+"' InqNum is now "+ALLTRIM(STR(m.Next_Inq)) )
ENDIF


SELECT Quotes
*UPDATE Quotes
LOCATE FOR Quotes.ID = nUseThisID
IF Quotes.ID = nUseThisID
	REPLACE SalesP WITH cUseThisName
	REPLACE Cover WITH cCurrSalesP
	REPLACE InqNum WITH m.Next_Inq
	REPLACE InqNumP WITH cNewInqNumP
ENDIF
	

LOCATE FOR InqNumP = cPrevInqNumP


