     SET SKIP OF BAR 5 OF (a_menupops[3]) .T.
  ENDIF


ELSE

  * if you prefer

  IF EMPTY(APP_GLOBAL.cOptionsDialogClass)
     RELEASE BAR 4 OF (a_menupops[3])
  ENDIF

  IF EMPTY(APP_GLOBAL.cAboutBoxClass)
     RELEASE BAR 3 OF (a_menupops[9])
  ENDIF

