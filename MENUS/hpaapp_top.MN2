  IF NOT APP_GLOBAL.lUserPreferences
     RELEASE BAR 13 OF (a_menupops[1])
     RELEASE BAR 14 OF (a_menupops[1])
     RELEASE BAR 5 OF (a_menupops[3])
  ENDIF

  IF EMPTY(APP_GLOBAL.cStartupFormClass) ;
     OR NOT (APP_GLOBAL.lStartupForm)
