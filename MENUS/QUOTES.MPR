*       * _7IT0PQIBY  ON SELECTION BAR 1 OF POPUP applicatio      
*       *                                                         
*       * Procedure Origin:                                       
*       *                                                         
*       * From Menu:  QUOTES.MPR,            Record:   35         
*       * Called By:  ON SELECTION BAR 1 OF POPUP applicatio      
*       * Prompt:     Reduction of Area                           
*       * Snippet:    1                                           
*       *                                                         
*       *********************************************************
*
PROCEDURE _7it0pqiby
IF FILE('Forms\REDAREA.SCX')
	DO FORM 'Forms\REDAREA.SCX'
ELSE
	WAIT WINDOW "Did not find the RedArea.SCX;  'L' to Locate" to BLANK
	IF UPPER(BLANK) = "L"
		DO FORM LOCFILE('REDAREA','SCX','Find RedArea in VFP\GFM\Forms')
	ENDIF
ENDIF



