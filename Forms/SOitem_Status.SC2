			IF LEN(cComment) > 0
				cComment = cComment + CHR(13)
			ENDIF
			ThisForm.edtComment.Value = cComment + "QA placed On Hold"
		ELSE
			ThisForm.edtComment.Value = ALLTRIM(ThisForm.edtComment.Value) + CHR(13)+ "Order Off QA Hold"
