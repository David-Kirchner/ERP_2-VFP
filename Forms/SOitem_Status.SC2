	PROCEDURE Init
		PARAMETERS cSOitem, pConnHandle
		
		*DO FORM Forms\SOitem_Status WITH cSOitem,Conn
		*-*- This is at the Item Level.
		
		
		IF VARTYPE(cSOitem) != "C"
		*	MESSAGEBOX("No SO.",16,'')
		*	RETURN ''
		*	nSO = 64606
			cSOitem = ' 109630-02'
		ENDIF
		
		IF VARTYPE(cSOitem) != "C"
			RETURN ''
		ENDIF
		ThisForm.cSOitem = PrepareSQLtxt(cSOitem,'SOitem',10)
		
		PRIVATE nSO
		nSO = VAL(cSOitem)
		ThisForm.nSO = VAL(cSOitem)
		
		
		IF TYPE("pConnHandle") = "N"
			IF pConnHandle > 0
				ThisForm.nConnHandle = pConnHandle
			ELSE
				ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
				IF ThisForm.nConnHandle > 0
					ThisForm.CloseConn = .T.
				ELSE
					MESSAGEBOX("Could not connect to SQL")
					RETURN ''
				ENDIF
			ENDIF		
		ELSE
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			IF ThisForm.nConnHandle > 0
				ThisForm.CloseConn = .T.
			ELSE
				MESSAGEBOX("Could not connect to SQL")
				RETURN ''
			ENDIF
		ENDIF
		
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		
		****************************
		
		ThisForm.Load_Sales_Status(0)
		*Calls:ThisForm.Load_Sales_Hold_Status(0)
		
		
		IF NOT USED('tmpSales_Status')
			MESSAGEBOX( "Could not loading the table.",16,"Program Error")
			RETURN ""
		ENDIF
		
		SELECT tmpSales_Status
		
		ThisForm.grdSales_Status.RecordSource = "tmpSales_Status"
		ThisForm.grdSales_Status.Column1.ControlSource = 'tmpSales_Status.ID'
		ThisForm.grdSales_Status.Column2.ControlSource = 'tmpSales_Status.SOitem'
		
		ThisForm.grdSales_Status.AfterRowColChange
		
		ThisForm.grdSales_Status.SetFocus
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE load_sales_hold_status		&& tmpSales_Hold_Status
		PARAMETERS nRecNo
		*ThisForm.Load_Sales_Hold_Status(0)
		
		IF VARTYPE(nRecNo) != 'N'
			nRecNo = 0
		ENDIF
		
		IF USED('tmpSales_Hold_Status')
			ThisForm.grdSales_Hold_Status.RecordSource=''
			USE IN tmpSales_Hold_Status
		ENDIF
		
		SELECT 0
		cSQL = "SELECT [ID],[SOitem],[SalesNum]"
		cSQL = cSQL + ",[Hold_Type],[Hold_Value] "
		cSQL = cSQL + ",[Who],[What],[When],[Comment] "
		cSQL = cSQL + ",LEFT([Comment],100) AS [txtComment] "
		cSQL = cSQL + " FROM dbo.Sales_Hold_Status"
		*cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisForm.nSO))
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisForm.cSOitem+"')"
		cSQL = cSQL + " ORDER BY [WHEN] "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales_Hold_Status")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Hold_Status')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Hold_Status")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Hold_Status")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Hold_Status')
		ENDIF
		
		IF USED('tmpSales_Hold_Status')
			IF RECCOUNT('tmpSales_Hold_Status') > 0
				*EQP, INV, AR, QA, PO, CSTR
				SCAN
					DO CASE
					CASE tmpSales_Hold_Status.Hold_Type = "QA"
						ThisForm.chkQA.Value = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'QA')
						ThisForm.lQA = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'QA')
					CASE tmpSales_Hold_Status.Hold_Type = "AR"
						ThisForm.chkAR.Value = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'AR')
						ThisForm.lAR = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'AR')
					CASE tmpSales_Hold_Status.Hold_Type = "INV"
						ThisForm.chkINV.Value = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'INV')
						ThisForm.lINV = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'INV')
					CASE tmpSales_Hold_Status.Hold_Type = "EQP"
						ThisForm.chkEQP.Value = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'EQP')
						ThisForm.lEQP = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'EQP')
					CASE tmpSales_Hold_Status.Hold_Type = "CSTR"
						ThisForm.chkCSTR.Value = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'CSTR')
						ThisForm.lCSTR = PrepareSQLchk(tmpSales_Hold_Status.Hold_Value,'CSTR')
					OTHERWISE
						*not programmed!
					ENDCASE
				ENDSCAN
		
			ENDIF
			thisForm.Visible = .t.
			
			SELECT tmpSales_Hold_Status
			GO TOP
			
			ThisForm.grdSales_Hold_Status.RecordSource='tmpSales_Hold_Status'
			ThisForm.grdSales_Hold_Status.Column1.ControlSource = 'tmpSales_Hold_Status.What'
			ThisForm.grdSales_Hold_Status.Column2.ControlSource = 'tmpSales_Hold_Status.txtComment'
		
			*USE IN tmpSales_Hold_Status
		ENDIF
	ENDPROC

	PROCEDURE load_sales_status
		PARAMETERS nRecNo
		*ThisForm.Load_Sales_Status(0)
		
		IF VARTYPE(nRecNo) != 'N'
			nRecNo = 0
		ENDIF
		
		
		IF USED('tmpSales_Status')
			ThisForm.grdSales_Status.RecordSource = ""
			USE IN tmpSales_Status
		ENDIF
		
		SELECT 0
		cSQL = "SELECT [ID],[SOitem],[SalesNum],[Who],[What],[When],[Comment] "
		cSQL = cSQL + " FROM dbo.Sales_Status "
		*cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisForm.nSO))
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisForm.cSOitem+"')"
		cSQL = cSQL + " ORDER BY [WHEN] DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales_Status")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Status')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Status")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Status")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Status')
		ENDIF
		
		SELECT tmpSales_Status
		GO TOP
		
		
		ThisForm.Load_Sales_Hold_Status(ThisForm.cSOitem)
		
		
		
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		IF USED('CustomerID')
			USE IN CustomerID
		ENDIF
		
		RETURN THISFORM.cReturnValue
	ENDPROC

	PROCEDURE chkAR.Click
		IF PrepareSQLlogic(THIS.Value,'AR')
			PRIVATE cComment
			cComment = ALLTRIM(ThisForm.edtComment.Value)
			IF LEN(cComment) > 0
				cComment = cComment + CHR(13)
			ENDIF
			ThisForm.edtComment.Value = cComment + "AR placed Order On Hold for payment"
		ELSE
			ThisForm.edtComment.Value = ALLTRIM(ThisForm.edtComment.Value) + CHR(13)+ "Order Off AR payment Hold"
		ENDIF
	ENDPROC

