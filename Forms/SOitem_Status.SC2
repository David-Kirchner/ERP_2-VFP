	PROCEDURE cmdAbortHold.Click
		*Reset screen
		ThisForm.edtComment.Value = ""
		ThisForm.edtComment.Visible = .F.
		ThisForm.edtComment.ReadOnly = .T.
		ThisForm.chkQA.Enabled = .F.
		ThisForm.chkAR.Enabled = .F.
		ThisForm.chkINV.Enabled = .F.
		ThisForm.chkEQP.Enabled = .F.
		ThisForm.chkCSTR.Enabled = .F.
		
			
		ThisForm.cmdEditHold.Caption = "Edit Hold"
		ThisForm.cmdCancel.Enabled = .T.
		
		ThisForm.cmdAddComment.Visible = .F.
		This.Visible = .F.
		
		ThisForm.lblHoldComm.Visible = .F.
		
		ThisForm.grdSales_Hold_Status.Visible = .T.
		
	ENDPROC

	PROCEDURE cmdAddComment.Click
		IF THIS.Caption = "Add Comment"
			*Add 
			ThisForm.grdSales_Hold_Status.Visible = .F.
			ThisForm.edtComment.Visible = .T.
			ThisForm.edtComment.ReadOnly = .F.
			ThisForm.edtComment.Value = ""
			ThisForm.cmdAddComment.Visible = .T.
			ThisForm.cmdAbortHold.Visible = .T.
			ThisForm.lblHoldComm.Visible = .T.
			
			THIS.Caption = "Save Comment"
		ELSE
			*Save
			ThisForm.edtComment.Visible = .F.
			ThisForm.edtComment.ReadOnly = .T.
		
			PRIVATE cComment,cSOitem,nSO,cWhat
			cComment = PrepareSQLtxt(ThisForm.edtComment.Value,'Comment',255)
			cSOitem	= ThisForm.txtSOitem.Value
			nSO		= ThisForm.txtSalesnum.Value
			cWhat	= "Edited SO"
			
			Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, ThisForm.nConnHandle )
				
			THIS.Caption = "Add Comment"
			
			ThisForm.Load_Sales_Status(0)
			
			IF NOT USED('tmpSales_Status')
				MESSAGEBOX( "Could not loading the table.",16,"Program Error")
				RETURN ""
			ENDIF
		
			SELECT tmpSales_Status
			GO BOTTOM
		
			ThisForm.grdSales_Status.RecordSource = "tmpSales_Status"
			*ThisForm.grdSales_Status.Column1.ControlSource = tmpSales_Status.ID
			*ThisForm.grdSales_Status.Column1.Text1.ControlSource = tmpSales_Status.ID
		
			ThisForm.grdSales_Status.AfterRowColChange
		
		ENDIF
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdEditHold.Click
		IF THIS.Caption = "Edit Hold"
			*EDIT 
			ThisForm.cmdCancel.Enabled = .F.
			ThisForm.cmdAddComment.Visible = .T.
			ThisForm.cmdAbortHold.Visible = .T.
			
			ThisForm.grdSales_Hold_Status.Visible = .F.
			ThisForm.edtComment.Visible = .T.
			ThisForm.edtComment.ReadOnly = .F.
			ThisForm.lblHoldComm.Visible = .T.
			
			PRIVATE cComment
			cComment = PrepareSQLtxt(ThisForm.edtComment.Value,'Comment',255)
			IF "HOLD" $ UPPER(cComment)
				*Do not clear if a HOLD is in comment.
				*ThisForm.edtComment.Value = ""
			ELSE
				ThisForm.edtComment.Value = ""
			ENDIF
			
			
			ThisForm.chkQA.Enabled = .T.
			ThisForm.chkAR.Enabled = .T.
			ThisForm.chkINV.Enabled = .T.
			ThisForm.chkEQP.Enabled = .T.
			ThisForm.chkCSTR.Enabled = .T.
			
			THIS.Caption = "Save Hold"
			
			IF ThisForm.lQA
			ENDIF
			IF ThisForm.lAR
			ENDIF
			IF ThisForm.lINV 
			ENDIF
			IF ThisForm.lEQP
			ENDIF
			IF ThisForm.lCSTR
			ENDIF
			
		ELSE
		
			*Save
			PRIVATE cComment
			cComment = PrepareSQLtxt(ThisForm.edtComment.Value,'Comment',255)
			IF LEN(ALLTRIM(cComment)) = 0
				MESSAGEBOX("The comment field must be used."+CHR(13)+"No changes will be recorded!",16,"No SAVE")
				
				ThisForm.edtComment.SetFocus()
				RETURN .F.
			ENDIF
			
			PRIVATE lOK
			lOK = .T.
			*Reset screen
			ThisForm.cmdAddComment.Visible = .F.
			ThisForm.cmdAbortHold.Visible = .F.
		
			ThisForm.edtComment.Visible = .F.
			ThisForm.edtComment.ReadOnly = .T.
			ThisForm.lblHoldComm.Visible = .F.
			ThisForm.grdSales_Hold_Status.Visible = .T.
				
			ThisForm.chkQA.Enabled = .F.
			ThisForm.chkAR.Enabled = .F.
			ThisForm.chkINV.Enabled = .F.
			ThisForm.chkEQP.Enabled = .F.
			ThisForm.chkCSTR.Enabled = .F.
			
			PRIVATE lQA, lAR, lINV, lEQP, lCSTR
			lQA  = PrepareSQLlogic(ThisForm.chkQA.Value,'QA')
			lAR  = PrepareSQLlogic(ThisForm.chkAR.Value,'AR')
			lINV = PrepareSQLlogic(ThisForm.chkINV.Value,'INV')
			lEQP = PrepareSQLlogic(ThisForm.chkEQP.Value,'EQP')
			lCSTR = PrepareSQLlogic(ThisForm.chkCSTR.Value,'CSTR')
			
			PRIVATE cSOitem,nSO,cWhat
			cSOitem	= ThisForm.txtSOitem.Value
			nSO		= ThisForm.txtSalesnum.Value
			cWhat	= PrepareSQLtxt("Edit Hold ",'What',20)
			
			********************
			*look for changes.
			
			******************************
			IF lOK
				IF ThisForm.lQA <> lQA
					IF lQA
						cWhat	= "QA On Hold"
					ELSE
						cWhat	= "QA OFF Hold"
					ENDIF
					
					lOK = Save_SOitem_Hold_Status( cSOitem, nSO, "QA", lQA, cWhat, cComment, ThisForm.nConnHandle )
					lOK = Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, ThisForm.nConnHandle )
					ThisForm.lQA = lQA
				ENDIF
			ENDIF
			
			******************************
			IF lOK	
				IF ThisForm.lAR <> lAR
					IF lAR
						cWhat	= "AR On Hold"
					ELSE
						cWhat	= "AR OFF Hold"
					ENDIF
					
					lOK = Save_SOitem_Hold_Status( cSOitem, nSO, "AR", lAR, cWhat, cComment, ThisForm.nConnHandle )
					lOK = Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, ThisForm.nConnHandle )
					ThisForm.lAR = lAR
				ENDIF
			ENDIF
			
			******************************
			IF lOK	
				IF ThisForm.lINV <> lINV
					IF lINV
						cWhat	= "INV On Hold"
					ELSE
						cWhat	= "INV OFF Hold"
					ENDIF
					
					lOK = Save_SOitem_Hold_Status( cSOitem, nSO, "INV", lINV, cWhat, cComment, ThisForm.nConnHandle )
					lOK = Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, ThisForm.nConnHandle )
					ThisForm.lINV = lINV
				ENDIF
			ENDIF
			
			******************************
			IF lOK
				IF ThisForm.lEQP <> lEQP
					IF lEQP
						cWhat	= "Eqp Hold"
					ELSE
						cWhat	= "Eqp OFF Hold"
					ENDIF
					
					lOK = Save_SOitem_Hold_Status( cSOitem, nSO, "EQP", lEQP, cWhat, cComment, ThisForm.nConnHandle )
					lOK = Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, ThisForm.nConnHandle )
					ThisForm.lEQP = lEQP
				ENDIF
			ENDIF
		
			******************************
			IF lOK
				IF ThisForm.lCSTR <> lCSTR
					IF lCSTR
						cWhat	= "Customer put ON Hold"
					ELSE
						cWhat	= "Custmr took OFF Hold"
					ENDIF
					
					lOK = Save_SOitem_Hold_Status( cSOitem, nSO, "CSTR", lCSTR, cWhat, cComment, ThisForm.nConnHandle )
					lOK = Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, ThisForm.nConnHandle )
					ThisForm.lCSTR = lCSTR
				ENDIF
			ENDIF
			
			******************************
			IF lOK
				lOK = Calc_SOitem_Hold_Status( cSOitem, ThisForm.nConnHandle)
			ELSE
				MESSAGEBOX( "Could not SAVE.",16,"Program Error")
				TrackError("Problem "+cWhat+". "+cComment,"Failed to save a SO Status change", PROGRAM(), LINENO(1))
			ENDIF
			
			*****************************
			*Refresh screen after save.
			*
				
			THIS.Caption = "Edit Hold"
			ThisForm.cmdCancel.Enabled = .T.
			
			ThisForm.Load_Sales_Status(0)
		
			IF NOT USED('tmpSales_Status')
				MESSAGEBOX( "Could not loading the table.",16,"Program Error")
				RETURN ""
			ENDIF
		
			SELECT tmpSales_Status
			GO BOTTOM
		
			ThisForm.grdSales_Status.RecordSource = "tmpSales_Status"
			*ThisForm.grdSales_Status.Column1.ControlSource = tmpSales_Status.ID
			*ThisForm.grdSales_Status.Column1.Text1.ControlSource = tmpSales_Status.ID
		
			ThisForm.grdSales_Status.AfterRowColChange
		
		ENDIF
	ENDPROC

	PROCEDURE grdSales_Status.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.txtsalesNum.Value = tmpSales_Status.SalesNum
		ThisForm.txtSOitem.Value = tmpSales_Status.Soitem
		ThisForm.txtWho.Value = tmpSales_Status.Who
		ThisForm.txtWhat.Value = tmpSales_Status.What
		ThisForm.txtWhen.Value = tmpSales_Status.When
		ThisForm.edtComment.Value = tmpSales_Status.Comment
		
	ENDPROC

ENDDEFINE
