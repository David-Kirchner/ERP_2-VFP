	PROCEDURE cmdSO.Valid
		PRIVATE cSOitem, nSalesNum, nItemSO
		nSalesNum	= ThisForm.txtSalesNum.Value
		nItemSO		= ThisForm.txtItemSO.Value
		
		cSOitem = Proper_SO_Item( STR(nSalesNum)+"-"+STR(nItemSO) )
		IF NOT EMPTY('cSOitem')
			DO FORM Forms\ShowvSOitem WITH cSOitem
		ENDIF
		Return
		
		*!*	PRIVATE m.psalesnum, M.CREC
		*!*	m.CREC = RECNO()
		*!*	  IF NOT USED('INQSOLD')
		*!*	    SELECT 0
		*!*	    USE  HPA!inqsold NOUPDATE shared
		*!*	  ELSE
		*!*	    SELECT inqsold
		*!*	  ENDIF
		*!*	  IF USED('INQSOLD')
		*!*	    &&may be locked by another
		*!*	    SELECT LakeErie_log
		*!*	    GO TOP
		*!*	    DO WHILE NOT EOF()
		*!*	      IF LakeErie_log.salesnum > 0 
		*!*	      *AND EMPTY(LakeErie_log.company)
		*!*	      *IF LakeErie_log.salesnum > 0
		*!*	        m.psalesnum = LakeErie_log.salesnum
		
		*!*	        SELECT inqsold
		
		*!*	        LOCATE FOR salesnum = LakeErie_log.salesnum
		*!*	        IF FOUND()
		*!*	          m.company  = inqsold.company
		*!*	          m.shipped  = inqsold.shipped
		*!*	          m.shipdate = inqsold.shipdate
		*!*	          m.SALESP   = inqsold.salesp
		*!*	          M.PO_NUM   = INQSOLD.PO_NUM
		*!*	          M.SALEDATE = INQSOLD.SALEDATE
		
		*!*	          SELECT LakeErie_log
		*!*	          SHOW GETS
		*!*	          REPLACE LakeErie_log.company  WITH m.company
		*!*	          REPLACE LakeErie_log.shipped  WITH m.shipped
		*!*	          REPLACE LakeErie_log.shipdate WITH m.shipdate
		*!*	          REPLACE LakeErie_log.SALESP   WITH m.SALESP
		*!*	          REPLACE LakeErie_log.PO_NUM   WITH M.PO_NUM
		*!*	          REPLACE LakeErie_log.SALEDATE WITH M.SALEDATE
		*!*	        ELSE
		*!*	          WAIT WINDOW 'DID NOT FIND SALES NUMBER'+STR(m.psalesnum) NOWAIT
		*!*	        ENDIF
		*!*	      ELSE
		*!*	        *WAIT WINDOW 'NO SALES NUMBER!!' NOWAIT
		*!*	        IF LakeErie_log.salesnum = 0 AND NOT EMPTY(LakeErie_log.company)
		*!*	          SELECT LakeErie_log
		*!*	          REPLACE LakeErie_log.company  WITH ""
		*!*	          REPLACE LakeErie_log.shipped  WITH .F.
		*!*	          REPLACE LakeErie_log.shipdate WITH CTOD("  /  /  ")
		*!*	          REPLACE LakeErie_log.SALESP   WITH " "
		*!*	        ENDIF
		*!*	      ENDIF
		*!*	      SELECT LakeErie_log
		*!*	      SKIP
		*!*	    ENDDO
		*!*	  ELSE
		*!*	    WAIT WINDOW 'COULD NOT OPEN INQSOLD' NOWAIT
		*!*	  ENDIF
		
		
		*!*	IF USED('INQSOLD')
		*!*	  USE IN Inqsold
		*!*	ENDIF
		*!*	SELECT LakeErie_log
		
		*!*	GOTO M.CREC
		*!*	ThisForm.Refresh
	ENDPROC

