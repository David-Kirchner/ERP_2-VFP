	PROCEDURE txtLot.Valid
		PRIVATE nCurlot, cCurheat
		nCurlot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		cCurheat = PrepareSQLtxt(ThisForm.txtHEAT.Value,'Heat',50)
		
		IF nCurlot > 0 
		  *LOCATE FOR LakeErie_log.lot = m.curlot AND NOT LakeErie_log.heat = m.curheat
		  
			IF USED('tmpCountLot')	
				USE IN tmpCountLot
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.LakeErie_log WHERE Lot ="+STR(nCurLot)+" AND Heat NOT LIKE '"+ALLTRIM(cCurHeat)+"%'"
			cSQL = cSQL + " AND LEN(Heat) > 0 "
			
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountLot')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountLot')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpCountLot')
			ELSE
				IF USED('tmpCountLot')
					IF tmpCountLot.Cntd > 0
						MESSAGEBOX( 'You can not have the same Lot# for different Heats -any key',0+48,"Bad Lot Number")
						USE IN tmpCountLot 
						RETURN .F.
					ENDIF
					USE IN tmpCountLot 
				ENDIF
			ENDIF
		
		ENDIF
		
	ENDPROC

	PROCEDURE txtLot.When
		RETURN ThisForm.isediting
		
		*!*	PRIVATE M.TALKPROP
		*!*	PRIVATE m.mxlot, m.currec
		
		*!*	SELECT LakeErie_log
		*!*	IF lot=0
		*!*		m.currec = RECNO()
		*!*		m.TALKPROP = SET('TALK')
		*!*		SET TALK OFF
		*!*		CALC MAX(lot) TO M.mxlot
		*!*		IF M.TALKPROP = "ON"
		*!*			SET TALK ON
		*!*		ENDIF
		*!*		WAIT WINDOW "The last Lot# is "+LTRIM(STR(M.mxlot)) NOWAIT
		*!*		GOTO m.currec
		*!*	ENDIF
		
	ENDPROC

