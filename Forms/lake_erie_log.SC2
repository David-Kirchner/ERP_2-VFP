					ThisForm.txtID.Value			= tmpLatestData.ID
		
				ENDIF
				USE IN tmpLatestData 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pLot
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('LakeErie_log')	
			USE IN LakeErie_log
		ENDIF
		
		cSQL = "SELECT * FROM dbo.LakeErie_log WITH(NOLOCK) "
		*cSQL = cSQL + " WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'LakeErie_log')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'LakeErie_log')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "LakeErie_log")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "LakeErie_log")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'LakeErie_log')
			RETURN
		ELSE
			*Code is also used in RefreshReceiving and Reload
			SELECT LakeErie_log
			INDEX ON LOT TAG LOT
		ENDIF
		SET ORDER TO TAG LOT
		
		
		
		
		SELECT LakeErie_log
		*pCurRec = MIN( Recno(),RECCOUNT() )
		*SET ORDER TO TAG Lot
		
		GO BOTTOM
		IF VARTYPE(pLot) = 'N'
			IF pLot > 0
				LOCATE FOR Lot = pLot
				IF NOT FOUND()
					GO BOTTOM
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.spnSpnlot.Value = LakeErie_log.Lot
		ThisForm.Refresh_log()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE loadgfmlabs		&& Used in InteractiveChange of Lab
		PRIVATE cSQL, nSQLEXEC
		*LoadGFMLab()
		
		cSQL = "SELECT DISTINCT [LAB] FROM dbo.LakeErie_log ORDER BY Lab "
		
		IF USED("GFMLabs")
			SELECT GFMLabs
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLabs')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'GFMLabs')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLabs")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "GFMLabs")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'GFMLabs')
		ENDIF
		
		
		IF USED("GFMLabs")
			SELECT GFMlabs
			INDEX ON UPPER(LAB) TAG UppLAB
		ENDIF
		
	ENDPROC

	PROCEDURE load_log
		PARAMETERS pID
		*ThisForm.load_log()
		
		IF VARTYPE(pID)!="N"
			pID = 0
		ENDIF
		
		IF USED('LakeErie_log')	
			USE IN LakeErie_log
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.LakeErie_log WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'LakeErie_log')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'LakeErie_log')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "LakeErie_log")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "LakeErie_log")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'LakeErie_log')
			RETURN
		ELSE
			SELECT LakeErie_log
			INDEX ON LOT TAG LOT
			SET ORDER TO TAG LOT
			ThisForm.lSeeAll = .F.
		ENDIF
		
		IF pID = 0
			GO BOTTOM
		ELSE
			LOCATE FOR ID = pID
		ENDIF
		
		ThisForm.Refresh_log()
	ENDPROC

	PROCEDURE lothighvalue		&& Returns the highest Lot number for Lot spinner.
		*!*	Private maxlot, pTalk, pCurRec
		*!*	SELECT LakeErie_log
		*!*	pCurRec = RECNO()
		*!*	pTalk = SET('TALK')
		*!*	SET TALK OFF
		*!*	CALCULATE MAX(Lot) to maxlot
		*!*	IF pTalk = "ON"
		*!*		SET TALK ON
		*!*	ENDIF
		*!*	GOTO pCurRec
		*!*	RETURN maxlot
		
		
		PRIVATE nMaxLot 
		nMaxLot = 0
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpMaxLot')	
			USE IN tmpMaxLot
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT MAX(LOT) AS MaxLot FROM dbo.LakeErie_log "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpMaxLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpMaxLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpMaxLot')
		ELSE
			IF USED('tmpMaxLot')
				nMaxLot = tmpMaxLot.MaxLot
				USE IN tmpMaxLot
				RETURN nMaxLot
			ENDIF
		ENDIF
		 
	ENDPROC

