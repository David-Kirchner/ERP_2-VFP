	ENDPROC

	PROCEDURE lblAcctCosting.Click
		PRIVATE lPassed
		lPassed		= PrepareSQLchk(ThisForm.chkPassed.Value,'Passed',.F.)
		PRIVATE nAcctCosting_ID
		nAcctCosting_ID = 0
		
		IF lPassed
			nAcctCosting_ID = AcctCosting_Start() 
		ELSE
			PRIVATE nMess
			nMess = MESSAGEBOX("This lot is not listed as 'Passed'"+CHR(13)+"Are you sure you want to mark this"+CHR(13)+"as ready for Accouting Costing?",4+32,"Ready for Accounting Costing?")
			IF nMess = 6
				nAcctCosting_ID = AcctCosting_Start()
			ENDIF
		ENDIF
		
		IF nAcctCosting_ID > 0
			ThisForm.txtAC_ID.Value = nAcctCosting_ID
		*	ThisForm.txtAcctCosting.Value = AcctCosting_get_dtCreate_ID(nAcctCosting_ID,ThisForm.nConnhandle)
			
			SELECT LakeErie_log
		*	REPLACE AcctCosting WITH ThisForm.txtAcctCosting.Value
			REPLACE AC_ID WITH nAcctCosting_ID
			
			WAIT WINDOW 'Sent to Accounting' NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE lblLot.Click
		IF NOT THISFORM.isediting
			RETURN .F.
		ENDIF
		
		
		PRIVATE nLot
		
		nLot = ThisForm.txtLot.Value
		IF nLot > 0
			MESSAGEBOX("Lot already has a value"+CHR(13)+"Zero out Lot and try again!",0+48,'Cannot overwrite Lot')
			RETURN
		ENDIF
		IF NOT THISFORM.isediting
			RETURN .F.
		ENDIF
		
		  
		IF USED('tmpCountLot')	
			USE IN tmpCountLot
		ENDIF
		
		cSQL = "SELECT MAX(Lot) AS MaxLot FROM dbo.LakeErie_log"
				
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpCountLot')
		ELSE
			IF USED('tmpCountLot')
				IF tmpCountLot.MaxLot > 0
				
					ThisForm.txtLot.Value = tmpCountLot.MaxLot+1
					ThisForm.Lots.Caption = '1'
					
				ENDIF
				USE IN tmpCountLot 
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE lblTestPOSentDate.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(ThisForm.txtTestsent.Value)
			dDate1 = ThisForm.txtTestsent.Value 
		ELSE
			dDate1 = DATE()+10
		ENDIF
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.txtTestsent.Value = dDate2
		
	ENDPROC

	PROCEDURE lblWO_Detail.Click
		PRIVATE nWOD
		nWOD = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWOD > 0
			DO FORM Forms\WorkOrder WITH "EDIT",0,nWOD,'','',''
		ELSE
			MESSAGEBOX("No WO_Detail number.",0,"Cannot show 'WorkOrder' window.")
		ENDIF
		
		
	ENDPROC

	PROCEDURE spnSpnlot.Valid
		PRIVATE nID,nSPNLOT
		nID = ThisForm.txtID.Value
		nSPNLOT = This.Value
		
		IF NOT USED('LakeErie_log')
			ThisForm.Load_Log()
		ENDIF
		
		SELECT LakeErie_log
		LOCATE FOR LOT = nSPNLOT 
		IF FOUND()	
			ThisForm.Refresh_log()
		ELSE
			IF ThisForm.lSeeAll
				WAIT WINDOW 'LOT # NOT FOUND' NOWAIT
			ELSE
				IF ThisForm.getAllrecords()
					SELECT LakeErie_log
					LOCATE FOR LOT = nSPNLOT 
					IF FOUND()	
						ThisForm.Refresh_log()
					ELSE
						MESSAGEBOX("Lot number not found",48,"Missing record")
					ENDIF
				ELSE
					MESSAGEBOX("Lot number not found",48,"Missing record")
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE spnSpnlot.When
		RETURN !ThisForm.isediting
		
		PRIVATE nLot
		nLot = ThisForm.txtLot.Value
		
		IF nLot > 0
			This.Value = nLot
		ELSE
			This.Value = 1
		ENDIF
	ENDPROC

	PROCEDURE txtAlloyname.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtAlloyname.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtAlloyname.Valid
		PRIVATE cCurAlloy,cAlloyStandard
		cCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(cCurAlloy)
			cAlloyStandard = GetAlloyStandard( cCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

