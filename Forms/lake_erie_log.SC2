				REPLACE LakeErie_log.Testsent WITH DATE()
			ENDIF
			RETURN .T.
		ELSE	
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE txtWO_Detail.DblClick
		PRIVATE nWO_Detail 
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWO_Detail > 0
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO_Detail(nWO_Detail,.T.)
		
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
			
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		
		ENDIF
	ENDPROC

	PROCEDURE txtWO_Detail.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE txtYield.GotFocus
		This.InputMask = ""
	ENDPROC

	PROCEDURE txtYield.LostFocus
		This.InputMask = "999,999"
	ENDPROC

	PROCEDURE txtYield.When
		RETURN ThisForm.isediting
	ENDPROC

