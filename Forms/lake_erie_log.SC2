		cLot = "L"+ALLTRIM(STR(ThisForm.txtLot.Value,10,0))
		
		DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSELot",'S',LakeErie_log.AlloyName, '40','1','',LakeErie_log.fSize,LakeErie_log.fLength,0,LakeErie_log.SOitem,LakeErie_log.SalesNum,LakeErie_log.fPiece,0,cLot,0,.F.,''
	ENDPROC

