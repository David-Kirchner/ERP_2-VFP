	PROCEDURE cmdTop.Valid
		IF USED('LakeErie_log')
			SELECT LakeErie_log
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened.",0+48,"Reload table")
			ThisForm.load_log()
		ENDIF
		
		GO TOP
		WAIT WINDOW 'Top of File' NOWAIT
		
		ThisForm.Refresh_log()
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmgGfm_calc.Valid
		*FIND L2 BY DIA'S AND L1
		private m.cutfctr,m.Tflength
		PRIVATE nslength,nssize,nRollsize,nrollsize,nflength 
		PRIVATE ncutfctr, nfpiece, nspiece, nColdwork
		PRIVATE nswidth, nfwidth
		
		nslength = ThisForm.txtSlength.Value
		nssize = ThisForm.txtSsize.Value
		nRollsize = ThisForm.txtRollsize.Value
		nrollsize= ThisForm.txtRollsize.Value
		nflength  = ThisForm.txtFlength.Value
		
		nfpiece = ThisForm.txtFpiece.Value
		nspiece = ThisForm.txtSpiece.Value
		ncoldwork = ThisForm.txtColdWork.Value
		
		nswidth = ThisForm.txtSwidth.Value
		nfwidth = ThisForm.txtFwidth.Value
		
		*!*	IF nslength > 0 AND ssize > 0 AND rollsize >0 AND flength = 0 AND ( form="10" or form="20" )
		*!*	  m.Tflength=ssize*ssize*slength/(rollsize*rollsize)
		*!*	  REPLACE flength WITH VAL( STR( m.Tflength ,8,0) )
		*!*	  IF (spiece > 0 AND fpiece > 0) AND (spiece <> fpiece)
		*!*	    cutfctr = fpiece / spiece
		*!*	    IF INT(cutfctr) = cutfctr
		*!*	      REPLACE flength WITH  flength / cutfctr
		*!*	    ELSE
		*!*	 *     WAIT WINDOW 'Length is based on no cuts'
		*!*	    ENDIF
		*!*	  ENDIF
		*!*	ENDIF
		IF nslength > 0 AND nssize > 0 AND nrollsize >0 AND nflength = 0 &&AND ( form="40" or form="51" )
		  m.Tflength=(nssize*nslength)/(nrollsize)
		  *REPLACE flength WITH VAL( STR( m.Tflength ,8,0) )
		  nflength = VAL( STR( m.Tflength ,8,0) )
		  ThisForm.txtFlength.Value = nflength
		  IF (nspiece > 0 AND nfpiece > 0) AND (nspiece <> nfpiece)
		    cutfctr = nfpiece / nspiece
		    IF INT(cutfctr) = cutfctr
		      *REPLACE flength WITH  flength / cutfctr
		      ThisForm.txtFlength.Value =  nflength / cutfctr
		    ELSE
		*      WAIT WINDOW 'Length is based on no cuts'
		    ENDIF
		  ENDIF
		ENDIF
		
		*!*	*FIND RA BY DIA'S
		*!*	IF ssize > 0 AND rollsize >0 AND coldwork = 0 AND ( form="10" or form="20" )
		*!*	  PRIVATE m.a1, m.a2
		*!*	  m.a1= 3.14156*ssize*ssize/4
		*!*	  m.a2= 3.14156*rollsize*rollsize/4
		*!*	  REPLACE coldwork WITH (m.a1-m.a2)/m.a1
		*!*	ENDIF
		
		*Find RA by Thk
		IF nssize > 0 AND nrollsize >0 AND ncoldwork = 0 &&AND ( form="40" or form="51" )
			PRIVATE nOrigA, nFinalA
			nOrigA  = nssize*nswidth
			nFinalA = nrollsize*nswidth
		*	REPLACE coldwork WITH (nOrigA - nFinalA)/nOrigA
			nColdWork = (nOrigA - nFinalA)/nOrigA
			IF nColdWork < 1
				ThisForm.txtColdwork.Value = nColdWork
			ENDIF
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE cmgGfm_calc.When
		RETURN ThisForm.isediting
	ENDPROC

