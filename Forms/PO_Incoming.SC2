	PROCEDURE Load
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT() 
		*-- &&Done in INIT
	ENDPROC

	PROCEDURE porecvstock_calc
		*ThisForm.POrecvStock_Calc
		
		PRIVATE lcAlloy, lcForm, lnPiece
		PRIVATE lnDim1,lnDim2,lnDim3 
		
		lcAlloy		= PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		lcForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		lnPiece		= PrepareSQLnum(ThisForm.PC1.Value,'Pieces',-3)
		lnDim1		= PrepareSQLnum(ThisForm.Dim11.Value,'Dim1',10,4)
		lnDim2		= PrepareSQLnum(ThisForm.Dim21.Value,'Dim2',9,3)
		lnDim3		= PrepareSQLnum(ThisForm.Dim31.Value,'Dim3',9,3)
		
		IF lcAlloy = "" OR lcForm = "" OR lnDim1 = 0 OR lnDim2 = 0
			RETURN
		ENDIF
		
		nCalc_QTY	 = Calc_QTY( lcAlloy, lcForm, lnPiece, lnDim1,lnDim2,lnDim3,'', ThisForm.nConnHandle)
		nCalc_Weight = Calc_Weight( lcAlloy, lcForm, lnPiece, lnDim1,lnDim2,lnDim3, ThisForm.nConnHandle)
		
		IF lcForm = '80'
			nCalc_Weight = CalcWeightDisk(lnPiece, lcAlloy, lcForm, lnDim1,lnDim2,lnDim3, ThisForm.nConnHandle)
		ENDIF
		
		ThisForm.Pounds.Value	= nCalc_Weight 
		ThisForm.txtQTY.Value	= nCalc_QTY
	ENDPROC

	PROCEDURE recvstockchangelst
		*ThisForm.RecvStockChangeLst()
		
		PRIVATE cTbl, cWhatDo, nReceivingID, cTblNew, cStockTableInit
		
		cTbl = ThisForm.txtTableName1.Value
		cWhatDo = ThisForm.txtWhatDo.Value
		nReceivingID = ThisForm.txtReceivingID.Value
		
		IF VARTYPE( cTbl ) != "C"
			MESSAGEBOX("Lost Table Name")
			RETURN
		ENDIF
		DO CASE
		CASE UPPER(cTBL)="STOCK" 
			cTBL ="STOCKLST"
			cTblNew = "BrokerLst"
			cStockTableInit = "B"
		CASE UPPER(cTBL)="BROKER"
			cTBL ="BROKERLST"
			cTblNew = "StockLst"
			cStockTableInit = "S"
		CASE UPPER(cTBL)="STOCKLST" 
			cTblNew = "BrokerLst"
			cStockTableInit = "B"
		CASE UPPER(cTBL)="BROKERLST"
			cTblNew = "StockLst"
			cStockTableInit = "S"
		OTHERWISE
			MESSAGEBOX("Lost Table Name")
			RETURN
		ENDCASE
		
		IF VARTYPE( cWhatDo ) != "C"
			MESSAGEBOX("'What' must be ADD")
			RETURN
		ENDIF
		IF UPPER(cWhatDo) != "ADD"
			MESSAGEBOX("'What' must be ADD")
			RETURN
		ENDIF
		
		IF VARTYPE(nReceivingID) = "C"
			nReceivingID = VAL(nReceivingID)
		ENDIF
		
		IF VARTYPE(nReceivingID) != "N"
			nReceivingID = 0
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = ThisForm.PO_ITEM1.Value
		IF VARTYPE(cPOitem) != "C"
			MESSAGEBOX("need a POitem")
			RETURN
		ENDIF
		IF EMPTY(cPOitem)
			MESSAGEBOX("need a POitem")
			RETURN
		ENDIF
		
		IF MESSAGEBOX("Are you sure you want to change to Table "+cTblNew+" ?",4+32,"Receive was to be "+cTbl ) != 6
			RETURN
		ENDIF
		
		PRIVATE lSave, nID_Master
		lSave = .T.
		
		IF UPPER(cTBL)="STOCKLST" 
			MESSAGEBOX("Sorry, Cannot change StockLst to BrokerLst."+CHR(13)+"Receive to Stock and consume all to customer!",16,"Not Programmed.")
			lSave = .F.
		ENDIF
		
		PRIVATE nCntPOitem ,nCntDueIn 
		
		IF lSave
			*Change PO ***************
			nCntPOitem = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle )
			
			IF USED('cntPO')
				USE IN cntPO
			ENDIF
			
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem +"')"
			cSQL = cSQL + " AND Delivered = 1"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPO')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPO' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntPO' )
			ENDIF
			
			IF USED('cntPO')
				nCntDueIn = cntPO.CNTD
				USE IN cntPO
			ENDIF
		
		
			IF nCntPOitem > 99
				MESSAGEBOX("POitem is incorrect:"+cPOitem,16,"Error, found too many!")
				RETURN
			ENDIF
			IF nCntPOitem > 0
				*Found POitem
				IF nCntDueIn = 0
					*Not Delivered
					*UPDATE PurchaseOrder SET STOCK = "Some Stock   " WHERE POitem = cPOitem
					PRIVATE cSQLu
					cSQLu = "UPDATE dbo.PurchaseOrder SET "
					cSQLu = cSQLu + " [Stock]='Some Stock   '"
					cSQLu = cSQLu + " WHERE PurchaseOrder.poItem = dbo.f_ProperPOitem('"+cPOItem+"')"
				
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
					
				ELSE
					*Delivered
					*UPDATE PurchaseOrder SET STOCK = "Some Stock   " WHERE POitem = cPOitem
					PRIVATE cSQLu
					cSQLu = "UPDATE dbo.PurchaseOrder SET "
					cSQLu = cSQLu + " [Stock]='Some Stock   '"
					cSQLu = cSQLu + " WHERE PurchaseOrder.poItem = dbo.f_ProperPOitem('"+cPOItem+"')"
				
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
				ENDIF
			ELSE
				*Did not find POitem
			ENDIF
		ENDIF
		
		PRIVATE nID,nID_Detail,nID_Detail_Process
		nID = 0
		nID_Detail = 0
		nID_Detail_Process = 0
		IF lSave
			*Get Master,Detail and Process
			IF USED('tmpID_ID_Detail')
				USE IN tmpID_ID_Detail
			ENDIF
			SELECT 0
			
			*nID,nID_Detail,nID_Detail_Process
			cSQL = "Select ID, ID_Detail FROM dbo.BrokerLst_Detail WHERE ReceivingID = "+STR( nReceivingID )
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_ID_Detail' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_ID_Detail' )
			ENDDO
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_ID_Detail')
				*\Progs\ErrorHandlerlog(0,"SQL Error:"+STR(nSQLEXEC),"Could not get ID, ID_Detail from 'tmpID_ID_Detail'",'frmPORecvStock.ReceivingSaveID_Master',119)
				TrackError("SQL Error:"+STR(nSQLEXEC),"Could not get ID, ID_Detail with "+cSQL,'frmPORecvStock.RecvStockChangeLst',LINENO())
			ELSE 
				IF USED('tmpID_ID_Detail')
					IF VARTYPE(tmpID_ID_Detail.ID) = "N"
						nID = tmpID_ID_Detail.ID
					ENDIF
					IF VARTYPE(tmpID_ID_Detail.ID_Detail) = "N"
						nID_Detail = tmpID_ID_Detail.ID_Detail
					ENDIF
					
					USE IN tmpID_ID_Detail
				ENDIF
			ENDIF
			
			*GET Process # by BrokerLst_Process_Detail WHERE ID_Detail
			IF nID_Detail > 0
				IF USED('tmpID_DetailPrc')
					USE IN tmpID_DetailPrc
				ENDIF
				SELECT 0
				cSQL = "SELECT ID_Detail_Process FROM dbo.BrokerLst_Process_Detail WHERE ID_Detail = "+STR(nID_Detail)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_DetailPrc')
					*\Progs\ErrorHandlerlog(0,"SQL Error:"+STR(nSQLEXEC),"Could not get ID, ID_Detail from 'tmpID_DetailPrc'",'frmPORecvStock.ReceivingSaveID_Master',179)
					TrackError("SQL Error:"+STR(nSQLEXEC),"Could not get ID, ID_Detail with "+cSQL ,'frmPORecvStock.RecvStockChangeLst',LINENO())
				ELSE 
					IF USED('tmpID_DetailPrc')
						IF VARTYPE(tmpID_DetailPrc.ID_Detail_Process) = "N"
							nID_Detail_Process = tmpID_DetailPrc.ID_Detail_Process
						ENDIF
					 	USE IN tmpID_DetailPrc
					ENDIF
				ENDIF
			ENDIF
			
			*GET Process # by BrokerLst_Process WHERE ID_Detail
			IF nID_Detail > 0
				IF USED('tmpID_DetailPrc')
					USE IN tmpID_DetailPrc
				ENDIF
				SELECT 0
				cSQL = "SELECT ID_Detail_Process FROM dbo.BrokerLst_Process WHERE ID_Detail = "+STR(nID_Detail)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_DetailPrc')
					*\Progs\ErrorHandlerlog(0,"SQL Error:"+STR(nSQLEXEC),"Could not get ID, ID_Detail from 'tmpID_DetailPrc'",'frmPORecvStock.ReceivingSaveID_Master',205)
					TrackError("SQL Error:"+STR(nSQLEXEC),"Could not get ID, ID_Detail with "+cSQL,'frmPORecvStock.RecvStockChangeLst',LINENO())
				ELSE 
					IF USED('tmpID_DetailPrc')
						IF VARTYPE(tmpID_DetailPrc.ID_Detail_Process) = "N"
							nID_Detail_Process = tmpID_DetailPrc.ID_Detail_Process
						ENDIF
					 	USE IN tmpID_DetailPrc
					ENDIF
				ENDIF
			ENDIF
			
			*Move SQL Lst-Master,Detail,Process ***************
			
			IF nID = 0 AND  nID_Detail > 0
				*Get nID
				nID = ThisForm.id1.Value
			ENDIF
			
			IF nID > 0 AND nID_Detail > 0
				nID_Master = Move_BrokerLst_StockLst( nID,nID_Detail,ThisForm.nConnHandle )
			ELSE
				*\Progs\ErrorHandlerlog(0,"Did not find IDs, ID="+STR(nID)+" nID_Detail="+STR(nID_Detail),"Could not run Move_BrokerLst_StockLst",'frmPORecvStock.ReceivingSaveID_Master',221)
				TrackError("Could not run Move_BrokerLst_StockLst","Did not have IDs to Move_BrokerLst_StockLst: ID="+STR(nID)+" nID_Detail="+STR(nID_Detail)+" POitem="+cPoitem,'frmPORecvStock.RecvStockChangeLst',LINENO() )
			ENDIF
			
		ENDIF
		
		IF lSave
			*Save to Receiving ***************
			IF nID_Master > 0
				cSQLu = "UPDATE dbo.Receiving SET"
				cSQLu = cSQLu +" ID_Master = "+STR(nID_Master)+""
				cSQLu = cSQLu +", StockTable = '"+cStockTableInit+"'"
				cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'')
					*lSaved = .F.
					*RETURN
					*\Progs\ErrorHandlerlog(0,"SQL Error:"+STR(nSQLEXEC),"Could not update dbo.Receiving",'frmPORecvStock.ReceivingSaveID_Master',116)
					TrackError("SQL Error:"+STR(nSQLEXEC),"Could not update dbo.Receiving. "+cSQLu ,'frmPORecvStock.RecvStockChangeLst',LINENO())
				ELSE 
					*lSaved = .T.
				ENDIF
			ENDIF
		ENDIF
		
		
		IF lSave
			DO CASE
			CASE UPPER(cTBL)="STOCKLST"
				ThisForm.txtTableName1.Value = 	"BrokerLst"
			CASE UPPER(cTBL)="BROKERLST"
				ThisForm.txtTableName1.Value = 	"StockLst"
			ENDCASE
		ENDIF
		
		
	ENDPROC

	PROCEDURE recvstockmovebroker2stock
		
		*ThisForm.RecvStockMoveBroker2Stock
		PRIVATE cTbl, cWhatDo, nReceivingID, cTblNew, cPOitem, nID_Detail, cStockTableInit
		cTbl = ThisForm.txtTableName1.Value
		cWhatDo = ThisForm.txtWhatDo.Value
		nReceivingID = ThisForm.txtReceivingID.Value
		cPOitem = ThisForm.PO_ITEM1.Value
		nID_Detail = ThisForm.ID_DETAIL1.Value
		
		IF nID_Detail = 0
			IF ThisForm.ID_detail > 0
			
				PRIVATE cMess	
				cMess = "Trouble" +CHR(13)
				*cMess = cMess + "Table:"+cTbl +CHR(13)
				cMess = cMess + "WhatDo:"+cWhatDo +", move left over Broker to Stock."+CHR(13)
				
				cMess = cMess + "POitem:"+cPOitem +CHR(13)
				
				cMess = cMess + STR(nReceivingID)+"ReceivingID"+CHR(13)
				cMess = cMess + STR(ThisForm.ID_DETAIL1.Value)+"ThisForm.ID_DETAIL1.Value"+CHR(13)
				cMess = cMess + STR(ThisForm.ID_detail)+"ThisForm.ID_detail"+CHR(13)
		
				cMess = cMess + STR(ThisForm.ID1.Value)+"ThisForm.ID1.Value of BrokerLst"+CHR(13)
				cMess = cMess + "ID_Detail was replaced by ThisForm.ID_Detail "+CHR(13)
				
				nID_Detail = ThisForm.ID_detail
				TrackError(cMess,"ID_Detail was replaced by ThisForm.ID_Detail instead of Parameter","POrecvStock:RecvStockMoveBroker2Stock",LINENO())
			ENDIF
		ENDIF
		
		IF VARTYPE( cTbl ) != "C"
			MESSAGEBOX("Lost Table Name")
			RETURN
		ENDIF
		DO CASE
		CASE UPPER(cTBL)="STOCK" 
			cTBL ="STOCKLST"
			cTblNew = "BrokerLst"
			cStockTableInit = "S"
		CASE UPPER(cTBL)="BROKER"
			cTBL ="BROKERLST"
			cTblNew = "StockLst"
			cStockTableInit = "B"
		CASE UPPER(cTBL)="STOCKLST" 
			cTblNew = "BrokerLst"
			cStockTableInit = "S"
		CASE UPPER(cTBL)="BROKERLST"
			cTblNew = "StockLst"
			cStockTableInit = "B"
		OTHERWISE
			MESSAGEBOX("Lost Table Name")
			RETURN
		ENDCASE
		
		IF VARTYPE( cWhatDo ) != "C"
			MESSAGEBOX("'What' must be EDIT")
			RETURN
		ENDIF
		IF UPPER(cWhatDo) != "EDIT"
			MESSAGEBOX("'What' must be EDIT")
			RETURN
		ENDIF
		
		IF VARTYPE(nReceivingID) = "C"
			nReceivingID = VAL(nReceivingID)
		ENDIF
		
		IF VARTYPE(nReceivingID) != "N"
			nReceivingID = 0
		ENDIF
		
		*IF UPPER(cWhatDo) != "EDIT"
		
		
		IF VARTYPE(cPOitem) != "C"
			MESSAGEBOX("need a POitem")
			RETURN
		ENDIF
		IF EMPTY(cPOitem)
			MESSAGEBOX("need a POitem")
			RETURN
		ENDIF
		
		*IF MESSAGEBOX("Are you sure you want to change to "+cTblNew+" ?",4+32,"Receive was to be "+cTbl ) != 6
		*	RETURN
		*ENDIF
		
		PRIVATE lSave, nID_Master
		lSave = .T.
		nID_Master = 0
		
		*IF UPPER(cTBL)="STOCKLST" 
		*	MESSAGEBOX("Sorry, Cannot change StockLst to BrokerLst."+CHR(13)+"Receive to Stock and consume all to customer!",16,"Not Programmed.")
		*	lSave = .F.
		*ENDIF
		
		IF lSave
			*Change PO ***************
			nCntPOitem = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle )
			nCntDueIn  = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, 'Delivered')
			
			IF nCntPOitem  > 99
				MESSAGEBOX("POitem is incorrect:"+cPOitem,16,"Error, found too many!")
				RETURN
			ENDIF
			IF nCntPOitem > 0
				*Found POitem
				IF nCntDueIn = 0
					*Not Delivered
					*UPDATE PurchaseOrder SET STOCK = "Some Stock   " WHERE POitem = cPOitem
					PRIVATE cSQLu
					cSQLu = "UPDATE dbo.PurchaseOrder SET "
					cSQLu = cSQLu + " [Stock]='Some Stock   '"
					cSQLu = cSQLu + " WHERE PurchaseOrder.poItem = dbo.f_ProperPOitem('"+cPOItem+"')"
				
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
					
				ELSE
					*Delivered
					*UPDATE PurchaseOrder SET STOCK = "Some Stock   " WHERE POitem = cPOitem
					PRIVATE cSQLu
					cSQLu = "UPDATE dbo.PurchaseOrder SET "
					cSQLu = cSQLu + " [Stock]='Some Stock   '"
					cSQLu = cSQLu + " WHERE PurchaseOrder.poItem = dbo.f_ProperPOitem('"+cPOItem+"')"
				
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
				ENDIF
			ELSE
				*Did not find POitem
			ENDIF
		ENDIF
		
		PRIVATE nID,nID_Detail_Process
		nID = 0
		nID_Detail_Process = 0
		
		IF VARTYPE(nID_Detail) != "N"
			nID_Detail = 0
		ENDIF
		
		IF lSave
			*Get Master,Detail and Process
			IF USED('tmpID_ID_Detail')
				USE IN tmpID_ID_Detail
			ENDIF
			SELECT 0
			
			IF nID_Detail = 0
				*Get nID,nID_Detail,nID_Detail_Process
		
				cSQL = "Select [ID], [ID_Detail] FROM dbo.StockLst_Detail WHERE ReceivingID = "+STR( nReceivingID )
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_ID_Detail' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_ID_Detail')
					\Progs\ErrorHandlerlog(0,"SQL Error:"+STR(nSQLEXEC),"Could not get ID, ID_Detail from 'tmpID_ID_Detail'",'frmPORecvStock.ReceivingSaveID_Master',119)
				ELSE 
					IF USED('tmpID_ID_Detail')
						IF VARTYPE(tmpID_ID_Detail.ID) = "N"
							nID = tmpID_ID_Detail.ID
						ENDIF
						IF VARTYPE(tmpID_ID_Detail.ID_Detail) = "N"
							nID_Detail = tmpID_ID_Detail.ID_Detail
						ENDIF
						
						USE IN tmpID_ID_Detail
					ENDIF
				ENDIF
			ENDIF
			
			*GET Process # by BrokerLst_Process WHERE ID_Detail
			IF nID_Detail > 0
				IF USED('tmpID_DetailPrc')
					USE IN tmpID_DetailPrc
				ENDIF
				SELECT 0
				cSQL = "SELECT ID_Detail_Process FROM dbo.StockLst_Process WHERE ID_Detail = "+STR(nID_Detail)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_DetailPrc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpID_DetailPrc')
					\Progs\ErrorHandlerlog(0,"SQL Error:"+STR(nSQLEXEC),"Could not get ID, ID_Detail from 'tmpID_DetailPrc'",'frmPORecvStock.ReceivingSaveID_Master',205)
				ELSE 
					IF USED('tmpID_DetailPrc')
						IF VARTYPE(tmpID_DetailPrc.ID_Detail_Process) = "N"
							nID_Detail_Process = tmpID_DetailPrc.ID_Detail_Process
						ENDIF
					 	USE IN tmpID_DetailPrc
					ENDIF
				ENDIF
			ENDIF
			
			*Move SQL Lst-Master,Detail,Process ***************
			
			IF nID = 0 AND  nID_Detail > 0
				*Get nID
				nID = ThisForm.id1.Value
			ENDIF
			
			IF nID > 0 AND nID_Detail > 0
		
				nID_Master = Move_BrokerLst_StockLst( nID,nID_Detail,ThisForm.nConnHandle )
						
				IF nID_Master > 0
					*Now StockLst!
					cStockTableInit = "S"
				ELSE
					RETURN -1
				ENDIF
			ELSE
				TrackError("Did not find IDs, ID="+STR(nID)+", nID_Detail="+STR(nID_Detail)+" cPOItem='"+cPOItem+"'","Could not run Move_BrokerLst_StockLst","frmPORecvStock.RecvStockMoveBroker2Stock",LINENO())
			ENDIF
			
				
		ENDIF
		
		IF lSave
			*Save to Receiving ***************
			IF nID_Master > 0
				cSQLu = "UPDATE dbo.Receiving SET"
				cSQLu = cSQLu +" ID_Master = "+STR(nID_Master)+""
				cSQLu = cSQLu + ", ID_Detail = "+STR(nID_Detail)+""
				cSQLu = cSQLu +", StockTable = '"+cStockTableInit+"'"
				cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'')
					*lSaved = .F.
					*RETURN
		*			\Progs\ErrorHandlerlog(0,"SQL Error:"+STR(nSQLEXEC),"Could not update dbo.Receiving",'frmPORecvStock.ReceivingSaveID_Master',LINENO())
					TrackError("Could not update dbo.Receiving.",cSQLu,"frmPORecvStock.RecvStockMoveBroker2Stock",LINENO())
				ELSE 
					*lSaved = .T.
				ENDIF
			ELSE
				MESSAGEBOX("Move_BrokerLst_StockLst did not return a master 'ID'",0+48,"No Receiving record was changed by the RecvStockMoveBroker2Stock() function.")
				TrackError("Move_BrokerLst_StockLst(ID="+STR(nID)+",nID_Detail="+STR(nID_Detail),"Did not return a new StockLst Master ID.","frmPORecvStock.RecvStockMoveBroker2Stock",LINENO())
			ENDIF
		ENDIF
		
		IF lSave
			RETURN nID_Master
		ELSE
			RETURN -1
		ENDIF
		
		
	ENDPROC

	PROCEDURE saveadd
		*ThisForm.SaveAdd
		
		PRIVATE lDelivered, lCert 
		PRIVATE cSQL, nSQLEXEC, lOK, cSQLi, lRollBack
		lOK = .T.
		lRollBack = .F.
		
		PRIVATE m.lcAlloy,m.lcForm,m.lcCC,m.lcCL,m.lcCond,m.lnSize,m.lnPAID,m.lnMWeight
		PRIVATE m.lcSpecs,m.lcHeat,m.lcLot,m.lcPO_Item
		PRIVATE m.ldPODueDate,m.lcHistory,m.lcMill,m.ldStkDate 
		PRIVATE m.lnNum,m.lnFrom_ID,m.lnID_Detail,m.lnPC
		PRIVATE m.lnSize_H,m.lnDim1,m.lnSize_L,m.lnDim2,m.lnDim3 
		PRIVATE m.lnWeight, m.lnS_QTY, m.lnS_P, m.lcDescript,m.lcLength  
		PRIVATE m.lnCostValue, m.lcFloorStatus, m.lcClass
		PRIVATE m.lcBrandName, m.lcLocation, m.lcMelt
		PRIVATE m.lcReceipt, m.lcReceivedBy 
		PRIVATE m.llDelivered, m.llCert, m.lnDelivered,m.lnCert		
		PRIVATE m.lnRandLen, m.llRandLen, m.lnPrime, m.llPrime, m.nReceivingID
		PRIVATE cStockTableInit, llMarkInvDate
		PRIVATE m.lnS_Total, m.lnS_PU
		
		m.lcAlloy		= PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		m.lcForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		m.lcCC			= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1,.T.)
		m.lcCL			= PrepareSQLtxt(ThisForm.cmbCC.Value,'CL',1,.T.)
		m.lcCond		= PrepareSQLtxt(ThisForm.Cond1.Value,'Condition',30)
		m.lnSize		= PrepareSQLnum(ThisForm.Size1.Value,'Size',9,3)
		m.lnPAID		= PrepareSQLnum(ThisForm.PAID1.Value,'Paid',9,2)
		m.lnMWeight		= PrepareSQLnum(ThisForm.Weight1.Value,'Weight',9,2)
		m.lcSpecs		= PrepareSQLtxt(ThisForm.specs1.Value,'Specs',160)
		m.lcHeat		= PrepareSQLtxt(ThisForm.Heat1.Value,'Heat',50)
		m.lcLot			= PrepareSQLtxt(ThisForm.Lot1.Value,'Lot',10)
		m.lcPO_Item		= Proper_PO_Item(ThisForm.PO_Item1.Value)
		m.ldPODueDate	= PrepareSQLdate(ThisForm.PODueDate1.Value,'PODueDate')
		m.lcHistory		= PrepareSQLtxt(ThisForm.History1.Value,'History',20,.F.,.T.)
		m.lcMill		= PrepareSQLtxt(ThisForm.Mill1.Value,'Mill',10)
		m.ldStkDate		= PrepareSQLdate(ThisForm.StkDate1.Value,'StkDate')
		m.lnNum			= PrepareSQLnum(ThisForm.Num1.Value,'Num',8,0)
		m.lcBrandName	= PrepareSQLtxt(ThisForm.BrandName1.Value,'BrandName',20)
		m.lnFrom_ID		= PrepareSQLnum(ThisForm.From_ID1.Value,'From_ID',-3)
		m.lnID_Detail	= PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
		
		m.lnPC			= PrepareSQLnum(ThisForm.PC1.Value,'Pieces',-3)
		m.lnSize_H		= PrepareSQLnum(ThisForm.Size_H1.Value,'Tol HIGH',9,4)
		m.lnDim1		= PrepareSQLnum(ThisForm.Dim11.Value,'Dim1',18,4)
		m.lnSize_L		= PrepareSQLnum(ThisForm.Size_L1.Value,'Tol LOW',9,4)
		m.lnDim2		= PrepareSQLnum(ThisForm.Dim21.Value,'Dim2',18,4)
		m.lnDim3		= PrepareSQLnum(ThisForm.Dim31.Value,'Dim3',18,4)
		m.lnWeight		= PrepareSQLnum(ThisForm.Weight1.Value,'Weight',9,2)
		m.lnS_QTY		= PrepareSQLnum(ThisForm.S_QTY.Value,'S_QTY',-5)
		m.lnS_P			= PrepareSQLnum(ThisForm.S_P.Value,'S_P',-5)
		m.lcDescript	= PrepareSQLtxt(ThisForm.Descript1.Value,'Description',20,.F.,.T.)
		
		m.lcLength		= PrepareSQLtxt(ThisForm.Length1.Value,'Length',160)
		m.lnCostValue	= PrepareSQLnum(ThisForm.CostValue1.Value,'CostValue',15,4)
		m.lcFloorStatus	= PrepareSQLtxt(ThisForm.FloorStatus1.Value,'FloorStatus',1)
		m.lcClass		= PrepareSQLtxt(ThisForm.Class1.Value,'Class',1)
		m.lcLocation	= PrepareSQLtxt(ThisForm.cmbLocation1.Value,'Location',10)
		m.lcMelt		= PrepareSQLtxt(ThisForm.cmbMelt.Value,'Melt',7)
		m.lcReceipt		= PrepareSQLtxt(ThisForm.edtReceipt.Value,'Receipt',-1)
		m.lcReceivedBy	= PrepareSQLtxt(ThisForm.ReceivedBy1.Value,'ReceivedBy',10)
		
		m.llDelivered	= PrepareSQLlogic(ThisForm.chkComplete.Value,'Complete')
		m.lnDelivered	= PrepareSQLbit(ThisForm.chkComplete.Value,'Complete')
		m.llCert		= PrepareSQLlogic(ThisForm.chkCert.Value,'Cert')
		m.lnCert		= PrepareSQLbit(ThisForm.chkCert.Value,'Cert')
		lnRandLen		= PrepareSQLbit(ThisForm.chkRandLen.Value,'RandLen')
		llRandLen		= PrepareSQLlogic(ThisForm.chkRandLen.Value,'RandLen')
		lnPrime			= PrepareSQLbit(ThisForm.chkPrime.Value,'Prime')
		llPrime			= PrepareSQLlogic(ThisForm.chkPrime.Value,'Prime')
		
		PRIVATE m.lnID			&& Int
		m.lnID			= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID < 1
			nReceivingID = ThisForm.ReceivingID
		ENDIF
		
		llMarkInvDate = PrepareSQLchk( ThisForm.chkMarkInvCheck.Value,'MarkInvCheck',.T.)
		
		PRIVATE nRMA
		nRMA = PrepareSQLnum(ThisForm.nRMA,'RMA',-3)
		IF nRMA > 0
			ThisForm.txtWhatDo.Value = "ADD"
		ENDIF
		
		IF EMPTY( m.lcForm )
			ThisForm.cmbForm.Value = "10"
			m.lcForm = '10'
		ENDIF
		
		PRIVATE cPUnit, cUnitByForm, cPriceUnitByForm
		cPUnit  = GetPUfromForm(lcForm, ThisForm.nConnHandle)
		cUnitByForm	= GetUNITfromFORM(m.lcForm, ThisForm.nConnHandle)
		cPriceUnitByForm = GetPRICEUNITfromFORM(m.lcForm, ThisForm.nConnHandle)
		
		m.lnS_Total	= m.lnS_P * m.lnS_QTY
		m.lnS_PU	= GetPUfromForm(lcForm, ThisForm.nConnHandle)
		
		
		***********************************
		
		IF UPPER(ThisForm.txtTableName1.Value) = "BROKERLST"
			cStockTableInit = "B"
		ELSE
			cStockTableInit = "S" 
		ENDIF
		
		
		PRIVATE m.llcPOStatus
		m.lcPOStatus = "P" &&Partial
		IF m.lldelivered
			*Complete
			m.lcPOStatus = "W" &&Waiting for Bill - ACCOUNTANTS
		ENDIF
		
		**************************************************
		IF m.lnID = 0 OR  nRMA > 0
			*** Insert or Update?
			
			*Check ReceivingID
			PRIVATE cSQL 
			*dbo.StockLst_Detail dbo.BrokerLst_Detail
			cSQL = "SELECT COUNT(*) AS [CNTD] FROM "
			IF cStockTableInit = "S"
				cSQL = cSQL + " dbo.StockLst_Detail "
			ELSE
				cSQL = cSQL + " dbo.BrokerLst_Detail "
			ENDIF
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR(nReceivingID))
			*cSQL = cSQL + " AND HEAT = '"+ALLTRIM(IIF(ISNULL(m.lcHeat)," ",m.lcHeat))+"'"
			  
			IF USED("tmpC_Master")
				SELECT tmpC_Master
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Master')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpC_Master')
			ELSE
				IF tmpC_Master.CNTD = 0
					*Not Found
					ThisForm.txtWhatDo.Value = "ADD"
				ELSE
					*Found
					IF UPPER(ALLTRIM(ThisForm.txtWhatDo.Value)) = "EDIT"
						*Allready Edit
					ELSE
						*Might Wish to Edit instead of ADD?
						
			*			IF MESSAGEBOX("Are you sure you want to ADD this?"+CHR(13)+"This POitem "+ALLTRIM(m.lcPO_Item)+" and Heat# "+m.lcHeat+" allready exist!"+CHR(13)+"Answer Yes if this PO has mutiple receives and you need mutiple stock entries."+CHR(13)+"Answer No to Update/Overwrite the current record.",4+32,"Found Similiar") = 6
							*Allready set to Add
							*ThisForm.txtWhatDo.Value = "ADD"				
			*			ELSE
							ThisForm.txtWhatDo.Value = "EDIT"
			*			ENDIF
					ENDIF
				ENDIF
			ENDIF
		ELSE
			IF ThisForm.txtWhatDo.Value = ""
				ThisForm.txtWhatDo.Value = "EDIT"
			ENDIF
		ENDIF
		
		*********************
		*		cSQL = "SELECT COUNT(*) FROM dbo."+ALLTRIM(ThisForm.txtTableName1.Value)
		*		cSQL = cSQL + "_Master WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+ThisFormSet.RecvStockPOitem+"')"
		*********************
		*=SQLCOMMIT(ThisForm.nConnHandle)
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		*********************
		
		IF THISFORM.txtWhatDo.Value = "EDIT"
			m.lnID = ThisForm.ID1.Value
			IF m.lnID = 0
				IF MESSAGEBOX("This Save is set to EDIT."+CHR(13)+"There is no ID to Edit!"+CHR(13)+"Do you want to set to Add?"+CHR(13)+"Edit will fail to save any data.",4+32,"Create new since cannot Edit?")=7 THEN
					ThisForm.txtWhatDo.Value = "ADD"
					TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+" EDIT was Changed to ADD. "+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+"!")
				ELSE
					*edit  
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE lInsertStock, lOverRideAdd
		lInsertStock = .F.
		lOverRideAdd = .F.
		
		IF UPPER(ALLTRIM(ThisForm.txtWhatDo.Value)) = "ADD"
			*Double check, PO may be edited, but Stock has been deleted - PO not found in StockLst.
			*If found in Received and Deleted in History- Do not Add back to StockLst!
			
			IF USED("tmpStockLst_MasterH")
				SELECT tmpStockLst_MasterH
			ELSE
				SELECT 0
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS CNTD FROM "
			IF cStockTableInit = "S"
				cSQL = cSQL + "dbo.[Ar.Stocklst_Detail_History] "
			ELSE
				cSQL = cSQL + "dbo.[Ar.BrokerLst_Detail_History] "
			ENDIF
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR(nReceivingID))
			*cSQL = cSQL + " AND [WHAT]='DELETE'"
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_MasterH')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_MasterH')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpStockLst_MasterH')
				*MESSAGEBOX("Could not Check Master History."+CHR(13)+"Cannot Save to "+ALLTRIM(ThisForm.txtTableName1.Value),0+16,"SQL Error")
				ThisForm.txtWhatDo.Value = "NoADD"
			ELSE
				IF USED('tmpStockLst_MasterH')
					
					IF tmpStockLst_MasterH.Cntd = 0
						lInsertStock = .T.
					ELSE
						IF MESSAGEBOX("This save wants to ADD to the "+IIF(cStockTableInit="S","StockLst","BrokerLst")+"."+CHR(13)+"But the history shows this has allready been saved!"+CHR(13)+CHR(13)+"Do you want to ADD anyways?",4+32+256,"You can force a StockLst ADD") = 6
							lInsertStock = .T.
							lOverRideAdd = .T.
							TrackMess("User Overide to PO Receive:"+ALLTRIM(m.lcPO_Item)+", Added to StockTable='"+cStockTableInit+"'"+" Receiving ID="+ALLTRIM(STR(nReceivingID))+" when history allready exists." )
						ELSE
							lInsertStock = .F.
							THISFORM.txtWhatDo.Value = "NoADD"
						ENDIF
					ENDIF
					
					IF lInsertStock
						*Insert
						*p_StockLst_Master_Ins p_BrockerLst_Master_Ins
						
						PRIVATE nOldID_Master, nOldID_Detail
						nOldID_Master = PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
						nOldID_Detail = PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
						
						IF ThisForm.lblDeleted.Visible
							IF nOldID_Master > 0
								*Check for permision to bring back DELETED record!.
								IF HavePermision('ReReceiveSTK')
									*INSERT INTO dbo.AppSetup (UN,PRP,ANS) VALUES ('David Kirchner','YES','ReReceiveSTK')
									TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+" for DELETED rec is now reADDed. "+", Deleted ID="+ALLTRIM(STR(nOldID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item)+"!")
									THISFORM.txtWhatDo.Value = "ReADD"
								ELSE
									*bad news
									MESSAGEBOX("You are not allowed to Receive in Stock that has been received and now DELETED."+;
										"Have David Receive this in.",16,"Not allowed!")
										
									= SQLROLLBACK(ThisForm.nConnHandle)
									= SQLSETPROP(THISFORM.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		
									RETURN .F.
									
								ENDIF
							ENDIF
						ENDIF
						
						IF cStockTableInit = "S"
							cSQLi = "EXEC dbo.p_StockLst_Master_ins "
						ELSE
							cSQLi = "EXEC dbo.p_BrokerLst_Master_ins "
						ENDIF
						cSQLi = cSQLi+ " @Alloy ='"+m.lcAlloy+"'"   &&NOT NULL
						cSQLi = cSQLi+ ",@Form ='"+m.lcForm+"'"   &&NOT NULL
						cSQLi = cSQLi+ ",@cc ='"+ALLTRIM(IIF(ISNULL(m.lcCC),'1',m.lcCC))+"'"   &&NOT NULL	
						**CL is on the insert update
						cSQLi = cSQLi+ ",@Cond ='"+m.lcCond+"'"   &&NOT NULL
						cSQLi = cSQLi+ ",@Size ="+STR(m.lnSize,9,3)+""   &&NOT NULL
						cSQLi = cSQLi+ ",@PAID ="+STR(m.lnPAID,9,2)+""
						cSQLi = cSQLi+ ",@MWeight ="+"0"+""   && INIT 0, Detail Trigger will fill!
						cSQLi = cSQLi+ ",@specs ='"+m.lcSpecs+"'"
						cSQLi = cSQLi+ ",@Heat ='"+m.lcHeat+"'"   &&NOT NULL
						cSQLi = cSQLi+ ",@Lot ='"+m.lcLot+"'"
						cSQLi = cSQLi+ ",@PO_Item ='"+m.lcPO_Item+"'"
						cSQLi = cSQLi+ ",@PODueDate ='"+IIF(EMPTY(m.ldPODueDate),'',DTOC(m.ldPODueDate))+"'"
						cSQLi = cSQLi+ ",@History ='"+m.lcHistory+"'"
						cSQLi = cSQLi+ ",@Mill ='"+m.lcMill+"'"
						cSQLi = cSQLi+ ",@StkDate ='"+IIF(EMPTY(m.ldStkDate),'',DTOC(m.ldStkDate))+"'"
						cSQLi = cSQLi+ ",@Num ="+STR(m.lnNum,8,0)+""
						cSQLi = cSQLi+ ",@POStatus ='"+m.lcPOStatus+"'"
						cSQLi = cSQLi+ ",@BrandName ='"+m.lcBrandName+"'"
						cSQLi = cSQLi+ ",@From_ID ="+STR(nOldID_Master)+""
						cSQLi = cSQLi+ ",@Melt ='"+m.lcMelt+"'"
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Master')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpID_Master')
							lRollBack = .T.
						ELSE
		*					=SQLCOMMIT(ThisForm.nConnHandle)
							IF USED("tmpID_Master")
								m.lnID = tmpID_Master.EXP
								ThisForm.ID1.Value = m.lnID
								ThisForm.ID1.Refresh
								USE IN tmpID_Master 
								
								********************************
								*Now Update what does not fit in sp
								
								IF cStockTableInit = "S"
									cSQL = "UPDATE dbo.StockLst_Master SET "
								ELSE
									cSQL = "UPDATE dbo.BrokerLst_Master SET "
								ENDIF
								cSQL = cSQL+ " CL='"+IIF(ISNULL(m.lcCL),"1",m.lcCL)+"'"
								cSQL = cSQL+ " WHERE ID="+STR(m.lnID)
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
									lOK = .F.
									lRollBack = .T.
								ELSE
									
								ENDIF
								
								********************************
								
								IF nReceivingID > 0 AND m.lnID > 0
									TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+" for DELETED rec is now reADDed. "+", Deleted ID="+ALLTRIM(STR(nOldID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item)+"!"+CHR(13)+" New ID:"+ALLTRIM(STR(m.lnID))+" of Table:"+cStockTableInit )
									
									cSQLu = "UPDATE dbo.Receiving SET ID_Master = "+STR(m.lnID)
									IF m.lnID_Detail > 0
										cSQLu = cSQLu + ", ID_Detail = "+STR(m.lnID_Detail)
									ENDIF
									cSQLu = cSQLu + ", StockTable = '"+cStockTableInit+"'"
									cSQLu = cSQLu + " WHERE ID = "+STR(nReceivingID)
		
									nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLu )	
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
									ENDDO
									IF nSQLEXEC < 0 &&Try again!, long trigger
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL' TIMEOUT 1
											nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
										ENDDO
									ENDIF
									IF nSQLEXEC < 0
										SQLEXECError(cSQLu, ThisForm.nConnHandle)
									ELSE
										TrackMess("PO Receive:"+ALLTRIM(m.lcPO_Item)+", Added to StockTable='"+cStockTableInit+"'"+" ID_Master="+ALLTRIM(STR(m.lnID))+" Receiving ID="+ALLTRIM(STR(nReceivingID)) )
									ENDIF
								ENDIF
							ENDIF
							
						ENDIF
					ELSE
						*Remove "ADD" so Detail is not Added!
						ThisForm.txtWhatDo.Value = "NoADD"
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE lDoNotUpdateStockLst 
		lDoNotUpdateStockLst = .F.
		
		**********************************************
		IF UPPER(ALLTRIM(THISFORM.txtWhatDo.Value)) = "EDIT"
		
			****check for a Broker that adds stock
			IF ThisForm.txtTableName1.Value = "BrokerLst"
				IF MESSAGEBOX("Was there any stock left over to add to StockLst?",4+32+256,"BrokerLst receive is complete.")=6
					
					*Change Broker status to StockLst - leaving a good Stock History
					PRIVATE nNewID_Master
					nNewID_Master = ThisForm.RecvStockMoveBroker2Stock()
					
					IF nNewID_Master > 0
						*Success, make sure the Add is to StockLst
						
						ThisForm.txtTableName1.Value = "StockLst"
						cStockTableInit = "S"
						ThisForm.ID1.Value = nNewID_Master 
						ThisForm.ID_DETAIL1.Value = 0
						m.lnID_Detail	=  0
						m.lnID = nNewID_Master
		
					ELSE
						lOK = .F.
						lRollBack = .T.
					ENDIF
				ENDIF
			ENDIF
				
			IF m.lnID < 1
				PRIVATE cSQL3
				*dbo.StockLst_Detail dbo.BrokerLst_Detail
				cSQL3 = "SELECT [ID] FROM "
				IF cStockTableInit = "S"
					cSQL3 = cSQL3 + " dbo.StockLst_Detail "
				ELSE
					cSQL3 = cSQL3 + " dbo.BrokerLst_Detail "
				ENDIF
				cSQL3 = cSQL3 + " WHERE ReceivingID = "+ALLTRIM(STR(nReceivingID))
				
				IF USED("tmpC_Master3")
					SELECT tmpC_Master3
				ELSE
					SELECT 0
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL3, 'tmpC_Master3')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL3, 'tmpC_Master3')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL3,ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Master3')
				ELSE
					m.lnID = tmpC_Master3.ID
					ThisForm.id1.Value = m.lnID
				ENDIF
			ENDIF
			
			*****************************
			*Make Sure Master has not been Changed- Do not over write changed stock. !?!?
			
			IF USED("tmpStockLst_MasterH")
				SELECT tmpStockLst_MasterH
			ELSE
				SELECT 0
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS CNTD FROM ( "
			cSQL = cSQL + " SELECT DISTINCT ProcessValue "
			IF cStockTableInit = "S"
				cSQL = cSQL +" FROM dbo.[Ar.Stocklst_Detail_History] "
			ELSE
				cSQL = cSQL +" FROM dbo.[Ar.BrokerLst_Detail_History] "
			ENDIF	
			cSQL = cSQL+ " WHERE ReceivingID = "+ALLTRIM(STR(nReceivingID))
			cSQL = cSQL + " AND [WHAT]='BEFOREEDIT'"
			cSQL = cSQL + " AND ProcessValue <> 0 "
			cSQL = cSQL + " ) t "
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_MasterH')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_MasterH')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpStockLst_MasterH')
		
				ThisForm.txtWhatDo.Value = "NoADD"
				lDoNotUpdateStockLst = .T.
				TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Did NOT Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+"Found Process in History!")
			ELSE
				IF USED('tmpStockLst_MasterH')
					IF tmpStockLst_MasterH.Cntd < 2
			
				
						********************************
						IF cStockTableInit = "S"
							cSQL = "UPDATE dbo.StockLst_Master SET "
						ELSE
							cSQL = "UPDATE dbo.BrokerLst_Master SET "
						ENDIF
						cSQL = cSQL+ "Alloy='"+m.lcAlloy+"'"   &&NOT NULL
						cSQL = cSQL+ ",Form='"+m.lcForm+"'"   &&NOT NULL
						cSQL = cSQL+ ",CC='"+IIF(ISNULL(m.lcCC),"1",m.lcCC)+"'"   &&NOT NULL
						cSQL = cSQL+ ",CL='"+IIF(ISNULL(m.lcCL),"1",m.lcCL)+"'"
						cSQL = cSQL+ ",Cond='"+m.lcCond+"'"   &&NOT NULL
						cSQL = cSQL+ ",Size="+STR(m.lnSize,9,3)+""   &&NOT NULL
						cSQL = cSQL+ ",PAID="+STR(m.lnPAID,9,2)+""
					*	cSQL = cSQL+ ",MWeight="+STR(m.lnMWeight,9,2)+" "
						cSQL = cSQL+ ",specs='"+m.lcSpecs+"'"
						cSQL = cSQL+ ",Heat='"+m.lcHeat+"'"   &&NOT NULL
						cSQL = cSQL+ ",Lot='"+m.lcLot+"'"
						cSQL = cSQL+ ",PO_Item='"+m.lcPO_Item+"'"
						IF NOT EMPTY(m.ldPODueDate)
							cSQL = cSQL+ ",PODueDate='"+DTOC(m.ldPODueDate)+"'"
						ENDIF
						cSQL = cSQL+ ",History='"+m.lcHistory+"'"
						cSQL = cSQL+ ",Mill='"+m.lcMill+"'"
						cSQL = cSQL+ ",StkDate='"+IIF(EMPTY(m.ldStkDate),'',DTOC(m.ldStkDate))+"'"
						cSQL = cSQL+ ",Num="+STR(m.lnNum)+""
						cSQL = cSQL+ ",POStatus='"+m.lcPOStatus+"'"
						cSQL = cSQL+ ",BrandName='"+m.lcBrandName+"'"
						cSQL = cSQL+ ",From_ID="+STR(IIF(ISNULL(m.lnFrom_ID),0,m.lnFrom_ID))+""	
						cSQL = cSQL+ ",Melt='"+m.lcMelt+"'"
						cSQL = cSQL+ " WHERE ID="+STR(m.lnID)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
							lOK = .F.
							lRollBack = .T.
						ELSE
							TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item))
						ENDIF
					ELSE
						*Found a process in the History!
						MESSAGEBOX(ALLTRIM(ThisForm.txtTableName1.Value)+" will not be changed with this edit."+CHR(13)+"Use StockLst Edit to make changes if needed!"+CHR(13)+"Found a process in the History!"+CHR(13)+"Cannot automatically update when item has a history!",48,"Found History.")
						lDoNotUpdateStockLst = .T.
						TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Did NOT Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+"Found Process in History!")
					ENDIF
				ELSE
					lDoNotUpdateStockLst = .T.
					TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Did NOT Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+"Found Process in History!")
				ENDIF
			ENDIF
			*****	
			
			IF nReceivingID > 0 AND m.lnID > 0
				cSQLu = "UPDATE dbo.Receiving SET ID_Master = "+STR(m.lnID)
				IF m.lnID_Detail > 0
					cSQLu = cSQLu + ", ID_Detail = "+STR(m.lnID_Detail)
				ENDIF
				cSQLu = cSQLu + ", StockTable = '"+cStockTableInit+"'"
				cSQLu = cSQLu + " WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLu )	
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC)
				ENDIF
			ENDIF
		
		ENDIF
		
		***************************
		IF USED("tmpC_Master")
			USE IN tmpC_Master
		ENDIF
		IF USED("tmpC_Master2")
			USE IN tmpC_Master2
		ENDIF
		IF USED("tmpC_Master3")
			USE IN tmpC_Master3
		ENDIF
		******************************
		
		IF m.lnID = 0
			m.lnID = ThisForm.ID1.Value
		ENDIF
		
		PRIVATE m.ID_Detail_process
		m.ID_Detail_process = ThisForm.GetID_Detail_process(m.lnID,ThisForm.txtTableName1.Value)
		
		IF nRMA > 0
			*Check for StockLst ID, Master must exist
			*m.lnID
		ENDIF
		
		***************************************************************
		PRIVATE lFound_ID_RID
		lFound_ID_RID = .F.
		
		IF UPPER(ALLTRIM(THISFORM.txtWhatDo.Value)) = "EDIT" AND m.lnID_Detail > 0
			
			*IF m.lnID_Detail < 1
			IF nReceivingID > 0
				
				*Get the lnID_Detail From ID and ReceivingID
				cSQL = "SELECT [ID_Detail] FROM "
				IF cStockTableInit = "S"
					cSQL = cSQL + " dbo.StockLst_Detail "
				ELSE
					cSQL = cSQL + " dbo.BrokerLst_Detail "
				ENDIF
				cSQL = cSQL + " WHERE ID = "+STR(m.lnID)
				cSQL = cSQL + " AND ReceivingID = "+ALLTRIM(STR(nReceivingID))
				
				IF USED("tmpC_Detail")
					SELECT tmpC_Detail
				ELSE
					SELECT 0
				ENDIF
			
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Detail')
				ELSE
					IF RECCOUNT('tmpC_Detail')>0
						lFound_ID_RID =.T.
					ENDIF
		*!*				m.lnID_Detail = tmpC_Detail.ID_Detail
		*!*				IF m.lnID_Detail > 0
		*!*					ThisForm.id_Detail1.Value = m.lnID_Detail
		*!*				ELSE
		*!*					ThisForm.id_Detail1.Value = 0
		*!*					RecordError(1, "Trouble!"+CHR(13)+cSQL, 'frmShop_stockLst_Edit:PORecvStockSaveAdd 455', 455, "ID_Detail was set to 0")
		*!*				ENDIF
				ENDIF
			ENDIF
			
			********************************
			IF lDoNotUpdateStockLst 
				*Do not Update StockLst
			ELSE
				*Update StockLst		
				IF NOT lFound_ID_RID
				
					IF cStockTableInit = "S"
						*stockLst many have many Detail, Auto select if only one!
						cSQL = "SELECT [ID_Detail] FROM "
						cSQL = cSQL + " dbo.StockLst_Detail "
						cSQL = cSQL + " WHERE ID = "+STR(m.lnID)
					
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Detail')
						ELSE
							IF RECCOUNT('tmpC_Detail')=1
								lFound_ID_RID =.T.
							ENDIF
						ENDIF
					ELSE
						*Broker only has only one ID_Detail
						cSQL = "SELECT [ID_Detail] FROM "
						cSQL = cSQL + " dbo.BrokerLst_Detail "
						cSQL = cSQL + " WHERE ID = "+STR(m.lnID)
					
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Detail')
						ELSE
							IF RECCOUNT('tmpC_Detail')=1
								lFound_ID_RID =.T.
							ENDIF
						ENDIF
					ENDIF					
				ENDIF
				
				IF lFound_ID_RID
					m.lnID_Detail = PrepareSQLnum(tmpC_Detail.ID_Detail,'ID_Detail',-3)
					IF m.lnID_Detail > 0
						ThisForm.ID_Detail1.Value = m.lnID_Detail
					ELSE
						ThisForm.ID_Detail1.Value = 0
						TrackError("ID_Detail was set to 0","No ID_Detail."+CHR(13)+cSQL+CHR(13)+": THISFORM.txtWhatDo.Value = 'EDIT'","POrecvStock:SaveAdd",LINENO())
						IF MESSAGEBOX("Cannot Save as an Edit!"+CHR(13)+"Did not find Detail ID to Edit/Update"+CHR(13)+CHR(13)+"Do you want to Add as 'NEW'?",4+32,"Add to "+ALLTRIM(ThisForm.txtTableName1.Value)) = 6 
							THISFORM.txtWhatDo.Value = "ADD" 
							TrackError("WhatDo was changed to 'ADD'","No ID_Detail for Edit."+CHR(13)+"User changed THISFORM.txtWhatDo.Value = 'ADD'","POrecvStock:SaveAdd",LINENO())
						ENDIF
					ENDIF
				ELSE
					ThisForm.ID_Detail1.Value = 0
					TrackError("ID_Detail was set to 0","No ID_Detail."+CHR(13)+cSQL+CHR(13)+": THISFORM.txtWhatDo.Value = 'EDIT'","POrecvStock:SaveAdd",LINENO())
					IF MESSAGEBOX("Cannot Save as an Edit!"+CHR(13)+"Did not find Detail ID to Edit/Update"+CHR(13)+CHR(13)+"Do you want to Add as 'NEW'?",4+32,"Add to "+ALLTRIM(ThisForm.txtTableName1.Value)) = 6 
						THISFORM.txtWhatDo.Value = "ADD" 
						TrackError("WhatDo was changed to 'ADD'","No ID_Detail for Edit."+CHR(13)+"User changed THISFORM.txtWhatDo.Value = 'ADD'","POrecvStock:SaveAdd",LINENO())
					ENDIF
				ENDIF
			ENDIF	
			
			********************************
			IF lDoNotUpdateStockLst 
				*Do not Update StockLst
			ELSE
				*Update StockLst
				IF m.lnID_Detail > 0
		
					IF cStockTableInit = "S"
						cSQL = "UPDATE dbo.StockLst_Detail SET "
					ELSE
						cSQL = "UPDATE dbo.BrokerLst_Detail SET "
					ENDIF
					cSQL = cSQL+ "ID="+STR(lnID)+","
					cSQL = cSQL+ "PC="+STR(m.lnPC)+","
					cSQL = cSQL+ "Size_H="+STR(m.lnSize_H,9,4)+","
					cSQL = cSQL+ "Dim1="+STR(m.lnDim1,18,4)+","
					cSQL = cSQL+ "Size_L="+STR(m.lnSize_L,9,4)+","
					cSQL = cSQL+ "Dim2="+STR(m.lnDim2,18,4)+","
					cSQL = cSQL+ "Dim3="+STR(m.lnDim3,18,4)+","
					cSQL = cSQL+ "Weight="+STR(m.lnWeight,9,2)+","
					cSQL = cSQL+ "Descript='"+ALLTRIM(m.lcDescript)+"',"
					cSQL = cSQL+ "Length='"+ALLTRIM(m.lcLength)+"',"
					cSQL = cSQL+ "CostValue="+STR(m.lnCostValue,9,4)+","
				*	cSQL = cSQL+ "Unit='"+ALLTRIM(cUnitByForm)+"',"
					cSQL = cSQL+ "FloorStatus='"+ALLTRIM(m.lcFloorStatus)+"',"
					cSQL = cSQL+ "class='"+ALLTRIM(m.lcClass)+"',"
					cSQL = cSQL+ "Location='"+ALLTRIM(m.lcLocation)+"',"
					cSQL = cSQL+ "RandLen="+IIF(llRandLen,'1','0')+","
					cSQL = cSQL+ "Prime="+IIF(llPrime,'1','0')+","
					cSQL = cSQL+ "ReceivingID="+STR(nReceivingID)
					IF llMarkInvDate
						cSQL = cSQL+ ","+"InvCheck=GetDate()"
					ENDIF
					cSQL = cSQL+",S_QTY = " + STR(m.lnS_QTY,18,4) + ""
					cSQL = cSQL+",S_P 	= " + STR(m.lnS_P,18,4) + ""
					cSQL = cSQL+",S_Total = " + STR(m.lnS_Total,18,4) + ""
					cSQL = cSQL+",S_PU = " + STR(m.lnS_PU) + ""
					cSQL = cSQL+ " WHERE ID_Detail="+STR(m.lnID_Detail)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
						
						lOK = .F.
						lRollBack = .T.
					ELSE
				*		=SQLCOMMIT(ThisForm.nConnHandle)
		
						IF VARTYPE( m.lcPO_Item ) != "C"
							lcPO_Item = " "
						ENDIF
						TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Update Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+" Detail, ID_Detail="+ALLTRIM(STR(m.lnID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item))
					ENDIF
				ELSE
					TrackMess("PO ReceivingID="+ALLTRIM(STR(nReceivingID))+", Did NOT Updated Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+", ID="+ALLTRIM(STR(m.lnID))+" for PO:"+ALLTRIM(m.lcPO_Item)+", ID_Detail=0")
				ENDIF
			ENDIF
		ENDIF
		
		***************************************************************
		IF THISFORM.txtWhatDo.Value = "ADD" 
		*OR THISFORM.txtWhatDo.Value = "ReADD" --No ID_Detail yet!!
		
			*Check for a PO that has Added to StockLst
			*Change lnID_Detail if found!
			
			cSQL = "SELECT [ID_Detail] "
			IF ALLTRIM(UPPER(ThisForm.txtTableName1.Value)) = "STOCKLST"
				cSQL = cSQL + "FROM dbo.StockLst_Detail"
			ELSE
				cSQL = cSQL + "FROM dbo.BrokerLst_Detail"
			ENDIF
			cSQL = cSQL + " WHERE ID = "+STR(m.lnID)
			IF lOverRideAdd 
				cSQL = cSQL + " AND ISNULL(ReceivingID,0) = 0"
				*Do not use the Length
			ELSE
				cSQL = cSQL + " AND ISNULL(ReceivingID,0) = 0"
				cSQL = cSQL + " AND Length = 'Listing created from new PO'"
			ENDIF	
			
			IF USED("tmpC_Detail")
				SELECT tmpC_Detail
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpC_Detail')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpC_Detail')
			ELSE
				m.lnID_Detail = tmpC_Detail.ID_Detail
				IF m.lnID_Detail > 0
					ThisForm.Id_Detail1.Value = m.lnID_Detail
				ENDIF
			ENDIF
			IF m.lnID_Detail > 0
				*dbo.StockLst_Detail dbo.BrokerLst_Detail
				IF ThisForm.txtTableName1.Value = "StockLst"
					cSQL = "UPDATE dbo.StockLst_Detail SET "
				ELSE
					cSQL = "UPDATE dbo.BrokerLst_Detail SET "
				ENDIF
				cSQL = cSQL+ "ID="+STR(lnID)+","
				cSQL = cSQL+ "PC="+STR(m.lnPC)+","
				cSQL = cSQL+ "Size_H="+STR(m.lnSize_H,9,4)+","
				cSQL = cSQL+ "Dim1="+STR(m.lnDim1,18,4)+","
				cSQL = cSQL+ "Size_L="+STR(m.lnSize_L,9,4)+","
				cSQL = cSQL+ "Dim2="+STR(m.lnDim2,18,4)+","
				cSQL = cSQL+ "Dim3="+STR(m.lnDim3,18,4)+","
				cSQL = cSQL+ "Weight="+STR(m.lnWeight,9,2)+","
				cSQL = cSQL+ "Descript='"+ALLTRIM(m.lcDescript)+"',"
				cSQL = cSQL+ "Length='"+ALLTRIM(m.lcLength)+"',"
				cSQL = cSQL+ "CostValue="+STR(m.lnCostValue,9,4)+","
			*	cSQL = cSQL+ "Unit='"+ALLTRIM(cUnitByForm)+"',"
				cSQL = cSQL+ "FloorStatus='"+ALLTRIM(m.lcFloorStatus)+"',"
				cSQL = cSQL+ "class='"+ALLTRIM(m.lcClass)+"',"
				cSQL = cSQL+ "Location='"+ALLTRIM(m.lcLocation)+"',"
				cSQL = cSQL+ "RandLen="+IIF(llRandLen,'1','0')+","
				cSQL = cSQL+ "Prime="+IIF(llPrime,'1','0')+","
				cSQL = cSQL+ "ReceivingID="+STR(nReceivingID)
				IF llMarkInvDate
					cSQL = cSQL+ ","+"InvCheck=GetDate()"
				ENDIF
				cSQL = cSQL+",S_QTY = " + STR(m.lnS_QTY,18,4) + ""
				cSQL = cSQL+",S_P 	= " + STR(m.lnS_P,18,4) + ""
				cSQL = cSQL+",S_Total = " + STR(m.lnS_Total,18,4) + ""
				cSQL = cSQL+",S_PU = " + STR(m.lnS_PU) + ""
				cSQL = cSQL+ " WHERE ID_Detail="+STR(m.lnID_Detail)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					
					lOK = .F.
					lRollBack = .T.
				ELSE
			*		=SQLCOMMIT(ThisForm.nConnHandle)
		
					IF VARTYPE( m.lcPO_Item ) != "C"
						lcPO_Item = " "
					ENDIF
					TrackMess("PO Receive, Update Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+" Detail, ID_Detail="+ALLTRIM(STR(m.lnID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item))
		
				ENDIF
			ENDIF
		ENDIF
		
		***************************************************************
		*!*	IF ( THISFORM.txtWhatDo.Value = "ADD" OR THISFORM.txtWhatDo.Value = "ReADD" ) AND m.lnID_Detail = 0
		*!*		
		*!*		IF THISFORM.txtWhatDo.Value = "ReADD" 
		*!*		ENDIF
		*!*	ENDIF
		
		***************************************************************
		IF ThisForm.txtWhatDo.Value = "ADD" OR m.lnID_Detail = 0
			*Add Detail
			IF UPPER(ALLTRIM(ThisForm.txtTableName1.Value))="STOCKLST"
				cSQLi = "EXEC dbo.p_StockLst_Detail_insRid5 "
			ELSE
				cSQLi = "EXEC dbo.p_BrokerLst_Detail_insRid5 "
			ENDIF
			cSQLi = cSQLi+ " @size_h	= "+STR(m.lnSize_H,9,4)	&&decimal(9, 4),
			cSQLi = cSQLi+ ",@size_l = "+STR(m.lnSize_L,9,4)	&&decimal(9, 4),
			cSQLi = cSQLi+ ",@pc = "+STR(m.lnPC)				&&INT,
			cSQLi = cSQLi+ ",@dim1 = "+STR(m.lnDim1,18,4)		&&decimal(18, 4),
			cSQLi = cSQLi+ ",@dim2 = "+STR(m.lnDim2,18,4)		&&decimal(18, 4),
			cSQLi = cSQLi+ ",@dim3 = "+STR(m.lnDim3,18,4)		&&decimal(18, 4),
			cSQLi = cSQLi+ ",@length ='"+m.lcLength+"'"		&&varchar(160),
			cSQLi = cSQLi+ ",@weight = "+STR(m.lnWeight,9,2)		&&decimal(9, 2),
			cSQLi = cSQLi+ ",@costvalue	= "+STR(m.lnCostValue,9,4)	&&money
			cSQLi = cSQLi+ ",@descript ='"+m.lcDescript+"'"	&&varchar(20),
			cSQLi = cSQLi+ ",@location ='"+m.lcLocation+"'"	&&varchar(10),
			cSQLi = cSQLi+ ",@floorstatus ='"+m.lcFloorStatus+"'"	&&char(1),
			cSQLi = cSQLi+ ",@class	 ='"+m.lcClass+"'"		&&char(1),
			cSQLi = cSQLi+ ",@RandLen = "+IIF(m.llRandLen,'1','0')+""	&&BIT
			cSQLi = cSQLi+ ",@ID ="+STR(m.lnID)		&&int
			cSQLi = cSQLi+ ",@ID_Detail_Process ="+STR(m.ID_Detail_Process)		&&int
			cSQLi = cSQLi+ ",@ReceivingID ="+STR(m.nReceivingID)		&&int
			cSQLi = cSQLi+ ",@S_QTY="+STR(m.lnS_QTY,18,4)
			cSQLi = cSQLi+ ",@S_P="+STR(m.lnS_P,18,4)
			cSQLi = cSQLi+ ",@S_TOTAL="+STR(m.lnS_Total,18,4)
			cSQLi = cSQLi+ ",@S_PU="+STR(m.lnS_PU)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_ins')
				lOK = .F.
				lRollBack = .T.
			ELSE
				m.lnID_Detail = StockLst_Detail_ins.EXP	
		
				IF USED("StockLst_Detail_ins")
					USE IN StockLst_Detail_ins
				ENDIF
				IF VARTYPE( m.lcPO_Item ) != "C"
					lcPO_Item = " "
				ENDIF
				
				IF m.lnID_Detail > 0
					ThisForm.ID_Detail = m.lnID_Detail
					ThisForm.ID_Detail1.Value =  m.lnID_Detail
				ELSE
					ThisForm.ID_Detail = 0
					ThisForm.ID_Detail1.Value =  0
					TrackError("ID_Detail was set to 0","Trouble"+CHR(13)+cSQLi,"POrecvStock:SaveAdd",LINENO())
				ENDIF
				
				TrackMess("PO Receive, Add Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+" Detail, ID_Detail="+ALLTRIM(STR(m.lnID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item))
			ENDIF
		ENDIF
		
		***************************************************************
		*Check for Incoming Process
		PRIVATE cSQLn, cSQLd, nID_Detail
		nID_Detail = m.lnID_Detail
		
		cSQLn = "SELECT COUNT(*) AS counted FROM "
		IF cStockTableInit = "S"
			cSQLn = cSQLn + " dbo.StockLst_Process "
		ELSE
			cSQLn = cSQLn + " dbo.BrokerLst_Process "
		ENDIF
		cSQLn = cSQLn + " WHERE ID_Detail = " + ALLTRIM(STR(nID_Detail))
		cSQLn = cSQLn + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
		*" AND Process_ID = 'INCOMING'"
		
		IF USED("StockLst_Detail_Count")
			SELECT StockLst_Detail_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQLn,ThisForm.nConnHandle,nSQLEXEC, 'StockLst_Detail_Count')
		ELSE
			IF USED('StockLst_Detail_Count')
				IF StockLst_Detail_Count.Counted = 0
					*Add Incoming Process
				
				ENDIF
				USE IN StockLst_Detail_Count
			ENDIF
		ENDIF
		
		***************************************************************
		IF m.lnID_Detail > 0
			*Update the rest of the Detail table
			
			IF cStockTableInit = "S"
				cSQL = "UPDATE dbo.StockLst_Process "
			ELSE
				cSQL = "UPDATE dbo.BrokerLst_Process "
			ENDIF
			cSQL = cSQL+ " SET "	
			cSQL = cSQL+ " QTY="+STR(m.lnS_QTY,18,4)
			cSQL = cSQL+ ",PU="+STR(m.lnS_PU,3,0)
			cSQL = cSQL+ " WHERE ID_Detail="+STR(m.lnID_Detail)
			*cSQL = cSQL+ " AND Process_ID = 'INCOMING'"
			cSQL = cSQL + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				
				lOK = .F.
				lRollBack = .T.
			ELSE
				IF VARTYPE( m.lcPO_Item ) != "C"
					lcPO_Item = " "
				ENDIF
		*		TrackMess("PO Receive, Update Inv:"+ALLTRIM(ThisForm.txtTableName1.Value)+" Detail, ID_Detail="+ALLTRIM(STR(m.lnID_Detail))+" for PO:"+ALLTRIM(m.lcPO_Item))
		
			ENDIF
		ENDIF
		
		***************************************************************
		*Remove Incoming Process, Change History to Received
		*PRIVATE cSQLn, cSQLd, nID_Detail
		nID_Detail = m.lnID_Detail
		
		*check to see if a process is for this SOitem
		*dbo.StockLst_Process dbo.BrokerLst_Process
		cSQLn = "SELECT COUNT(*) AS counted FROM "
		IF cStockTableInit = "S"
			cSQLn = cSQLn + " dbo.StockLst_Process "
		ELSE
			cSQLn = cSQLn + " dbo.BrokerLst_Process "
		ENDIF
		cSQLn = cSQLn + " WHERE ID_Detail = " + ALLTRIM(STR(nID_Detail))
		*" AND Process_ID = 'INCOMING'"
		cSQLn = cSQLn + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
		
		IF USED("StockLst_Detail_Count")
			SELECT StockLst_Detail_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQLn,ThisForm.nConnHandle,nSQLEXEC, 'StockLst_Detail_Count')
		ELSE
			IF StockLst_Detail_Count.Counted > 0
				*Remove old Process
				*dbo.StockLst_Process dbo.BrokerLst_Process
				cSQLd = "DELETE FROM "
				IF cStockTableInit = "S"
					cSQLd = cSQLd + " dbo.StockLst_Process "
				ELSE
					cSQLd = cSQLd + " dbo.BrokerLst_Process "
				ENDIF
				cSQLd = cSQLd + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
				*" AND Process_ID = 'INCOMING'"
				cSQLd = cSQLd + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
				ENDDO
				IF nSQLEXEC < 0
					*Could not Delete
					SQLEXECError(cSQLd,ThisForm.nConnHandle,nSQLEXEC,'')
				ELSE
					cSQLd = "UPDATE "
					IF cStockTableInit = "S"
						cSQLd = cSQLd + " dbo.[Ar.StockLst_Process_History] "
					ELSE
						cSQLd = cSQLd + " dbo.[Ar.BrokerLst_Process_History] "
					ENDIF
					cSQLd = cSQLd+" SET [WHAT]='RECEIVED', [ReceivingID]="+STR(nReceivingID)
					cSQLd = cSQLd+" WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
					cSQLd = cSQLd+" AND [What] = 'DELETE' "
					*" AND Process_ID = 'INCOMING'"
					cSQLd = cSQLd + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'PARTRECV' )"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLd,ThisForm.nConnHandle,nSQLEXEC,'')
					ENDIF
		
					WAIT WINDOW "Deleted 'INCOMING' or 'PARTRECV' process." NOWAIT
				ENDIF
			ELSE
				*ADD Receive Process to History
				IF USED('tmpID_Detail_Process')
					USE IN tmpID_Detail_Process
				ENDIF
		
				PRIVATE m.cSalesPerson, m.dStartDate, m.dDueDate
				PRIVATE m.cAllowSub, m.nWeight, m.nPc, m.cSOitem
				PRIVATE m.cProcess_ID, m.cProcessor, m.cComment
		
				*		nID_Detail
				m.cSalesPerson	= ''
				m.dStartDate	= DATE()
				m.dDueDate		= DATE()
				m.cAllowSub		= 'N'
				m.nWeight		= 0
				m.nPc			= 0
				m.cSOitem		= ''
				m.cProcess_ID	= "RECEIVED"
				m.cProcessor 	= SYS(0)
				*m.cProcessor 	= RIGHT( m.cProcessor , LEN(m.cProcessor ) - AT('#',m.cProcessor ) - 1 )
				*m.cProcessor 	= RIGHT( RIGHT(SYS(0),AT("#",SYS(0)))- AT('#',m.cProcessor ) - 1 )
				*m.cProcessor 	= RIGHT(SYS(0),AT("#",SYS(0)))
				m.cProcessor 	= PrepareSQLtxt(RIGHT(SYS(0),AT("#",SYS(0))),'Processor',20)
				m.cComment		= "Received new Heat"
				
				IF USED('StockLst_Detail_Count')
					USE IN StockLst_Detail_Count
				ENDIF
				SELECT 0
				*dbo.StockLst_Detail dbo.BrokerLst_Detail
				cSQL = "SELECT Weight, PC FROM "
				IF UPPER(ALLTRIM(ThisForm.txtTableName1.Value)) = "STOCKLST"
					cSQL = cSQL + " dbo.StockLst_Detail "
				ELSE
					cSQL = cSQL + " dbo.BrokerLst_Detail "
				ENDIF
				cSQL = cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail_Count')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail_Count')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_Count')
				ELSE
					IF !EOF('StockLst_Detail_Count')
						m.nWeight = StockLst_Detail_Count.Weight
						m.nPc = StockLst_Detail_Count.PC
					ENDIF
				ENDIF
				IF USED('StockLst_Detail_Count')
					USE IN StockLst_Detail_Count
				ENDIF	
				
				*dbo.[Ar.StockLst_Process_History] dbo.[Ar.BrokerLst_Process_History]		
				cSQLi = "INSERT INTO "
				IF UPPER(ALLTRIM(ThisForm.txtTableName1.Value)) = "STOCKLST"
					cSQLi = cSQLi + " dbo.[Ar.StockLst_Process_History] "
				ELSE
					cSQLi = cSQLi + " dbo.[Ar.BrokerLst_Process_History] "
				ENDIF
				cSQLi = cSQLi + "(What,SOitem,PO_Item,salesperson,startdate"
				cSQLi = cSQLi + ",duedate,comment,process_id,processor,AllowSub,pWeight,pPc,ID_Detail,Validated,ReceivingID) VALUES ("
				cSQLi = cSQLi + "'RECEIVED'"
				cSQLi = cSQLi + ",'"+m.cSOitem+"'"
				cSQLi = cSQLi + ",'"+m.lcPO_Item+"'"
				cSQLi = cSQLi + ",'"+m.cSalesPerson+"'"
				cSQLi = cSQLi + ",'"+IIF(EMPTY(m.dStartDate),'',DTOC(m.dStartDate))+"'"
				cSQLi = cSQLi + ",'"+IIF(EMPTY(m.dDueDate),'',DTOC(m.dDueDate))+"'"
				cSQLi = cSQLi + ",'"+m.cComment+"'"
				cSQLi = cSQLi + ",'"+m.cProcess_ID+"'"
				cSQLi = cSQLi + ",'"+m.cProcessor+"'"
				cSQLi = cSQLi + ",'"+m.cAllowSub+"'"
				cSQLi = cSQLi + ","+STR(m.nWeight,9,1)
				cSQLi = cSQLi + ","+STR(m.nPc)
				cSQLi = cSQLi + ","+ALLTRIM(STR(nID_Detail))+""
				cSQLi = cSQLi + ",'F'"
				cSQLi = cSQLi + ","+ALLTRIM(STR(nReceivingID))+""
				cSQLi = cSQLi + ")"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC,'')
					lRollBack = .T.
				ELSE
					*
				ENDIF
			ENDIF
		ENDIF
		
		**********************************
		*  Redundant
		*!*	IF lOK 
		*!*		IF Proper_PO_item(lcPO_Item) <> Proper_PO_item('')
		*!*		  	PRIVATE cSQLu
		*!*			cSQLu = "UPDATE dbo.PurchaseOrder SET "
		*!*			cSQLu = cSQLu + " Receipt = '"+m.lcReceipt+"'"
		*!*			cSQLu = cSQLu + ",Received = '"+IIF(EMPTY(m.ldStkDate),'',DTOC(m.ldStkDate))+"'"
		*!*			cSQLu = cSQLu + ",ReceivedBy = '"+m.lcReceivedBy+"'"
		*!*			cSQLu = cSQLu + ",Heat = '"+m.lcHeat+"'"
		*!*			cSQLu = cSQLu + ",Delivered="+IIF(m.llDelivered,'1','0')
		*!*			cSQLu = cSQLu + ",Cert = "+IIF(m.llCert,'1','0')
		*!*			cSQLu = cSQLu + " WHERE PoItem = dbo.f_ProperPOitem('"+m.lcPO_Item+"')"
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		*!*			
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
		*!*				lRollBack = .T.
		*!*			ELSE
		*!*				TrackMess( "Updateded POitem:"+ALLTRIM(m.lcPO_Item)+" ReceivedBy = '"+m.lcReceivedBy+"' from Shop_StockLst_Edit screen.")
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		**********************************
		*Partial Receive
		
		
		**********************************
		IF lRollBack 
			=SQLROLLBACK(ThisForm.nConnHandle)
			lOK  = .F.
			MESSAGEBOX('Nothing has been saved!',0+16,"Rollback")
		ELSE
			=SQLCOMMIT(ThisForm.nConnHandle)
		ENDIF
		
		= SQLSETPROP(THISFORM.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		
		**********************************
		RETURN lOK
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConnection 
			= SQLDISCONNECT( ThisForm.nConnHandle )
		ENDIF
		
		
		IF USED("tmpHistory")
			USE IN tmpHistory
		ENDIF
		
		IF USED("tmpReceivedBy")
			USE IN tmpReceivedBy
		ENDIF
		
		IF USED("tmpMills")
			USE IN tmpMills
		ENDIF
		
	ENDPROC

	PROCEDURE ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle)
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle)
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE BrandName1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, cAlloy, cBrandName
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		cAlloy = ThisForm.ALLOY1.Value
		cBrandName = ""
		
		IF USED('tmpBrandName')
			SELECT tmpBrandName
		ELSE
			SELECT 0
		ENDIF
		
		IF !EMPTY(lcSearchStr)
			cSQL = "SELECT DISTINCT [BrandName] FROM dbo.StockLst_Master WHERE Alloy = '"+cAlloy+"'"
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpBrandName')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'tmpBrandName')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpBrandName')
			ENDIF
		
		
			IF USED("tmpBrandName")
				SELECT tmpBrandName
				IF NOT ISNULL(tmpBrandName.BrandName)
					cBrandName = tmpBrandName.BrandName
					LOCATE FOR UPPER(BrandName) = UPPER(lcSearchStr)
					IF FOUND('tmpBrandName')
						cBrandName = tmpBrandName.BrandName
					ENDIF
				ENDIF
				USE IN tmpBrandName
			ENDIF
		
			IF NOT EMPTY(cBrandName)
			
				IF UPPER(lcSearchStr) = SUBSTR(cBrandName,1,lnInsertionPt)
					THIS.VALUE=cBrandName
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
		
		
	ENDPROC

	PROCEDURE BrandName1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE cmbCC.Destroy
		RELEASE aConditionCode
	ENDPROC

	PROCEDURE cmbCC.GotFocus
		ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisForm.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		
	ENDPROC

	PROCEDURE cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		cSQL = cSQL + " WHERE ISNULL(inActive,0) = 0"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Value = "1"
		
	ENDPROC

	PROCEDURE cmbCC.InteractiveChange
		PRIVATE cCC
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		
		This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
		ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisForm.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
	ENDPROC

	PROCEDURE cmbCC.LostFocus
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		This.Parent.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		This.Parent.cmbCL.ColumnCount = 2
		This.Parent.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		This.Parent.cmbCL.BoundColumn = 1
		This.Parent.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Parent.cmbCL.Value = cCL1
		
		IF ThisForm.CC != PrepareSQLtxt(This.Value,'CC',1)
			ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		*	This.Parent.cmbCL.Value = ''
			This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
			This.Parent.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE cmbCL.Destroy
		RELEASE aConditionCode
	ENDPROC

