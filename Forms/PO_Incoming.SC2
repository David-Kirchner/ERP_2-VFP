	PROCEDURE HISTORY1.Init
		**Initialize History
		cSQL = "SELECT DISTINCT History FROM dbo.StockLst_Master WHERE LEFT(History,1) NOT LIKE '[0-9]'"
		
		IF USED("tmpHistory")
			SELECT tmpHistory
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpHistory')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpHistory')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpHistory')
		ELSE
			SELECT tmpHistory
			INDEX ON History TAG History
		ENDIF
	ENDPROC

	PROCEDURE HISTORY1.InteractiveChange
		IF USED('tmpHistory')
			PRIVATE lnInsertionPt, lcSearchStr 
			lnInsertionPt = IIF(this.SelStart=0,1,this.SelStart)
			lcSearchStr = substr(this.value,1,lnInsertionPt)
			IF !empty(lcSearchStr)
					=seek(upper(lcSearchStr),"tmpHistory","History")
					IF found("tmpHistory")
						this.VALUE=LEFT(tmpHistory.History,20)
						=insmode(.f.)
					ELSE
						this.value=lcSearchStr
						=insmode(.t.)
					ENDIF
			ELSE &&ThisValue is empty
				this.value=space(0)
			ENDIF
			this.selstart = lnInsertionPt
		ENDIF
	ENDPROC

