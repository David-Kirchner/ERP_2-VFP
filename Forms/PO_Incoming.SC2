	PROCEDURE cmbForm.Destroy
		RELEASE aFormCode
	ENDPROC

	PROCEDURE cmbForm.Init
		*Done in frmPORecvStock.INIT
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		This.clear
		cSQL = "SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT FormNumber,FormDescription FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			This.addListitem(aFormCode(I, 1),I,1)
			This.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
		
		This.Value = '10'
		ThisForm.FormCaptions()
		
	ENDPROC

	PROCEDURE cmbForm.InteractiveChange
		ThisForm.FormCaptions()
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdRequestStandard.Click
		PRIVATE pcEmailTo, pcEmailFrom, pcEmailSubject, pcEmailText, lQuiet, lNoHeadder
		
		pcEmailTo	= "David.Kirchner@hpalloy.com"
		pcEmailFrom	= "Admin@hpalloy.com"
		pcEmailSubject= "New price table entry needed."
		
		lQuiet		= .F.
		lNoHeadder	= .T.
		
		PRIVATE m.lcAlloy,m.lcForm,m.lcCC,m.lcCL,m.lcCond,m.lnSize
		m.lcAlloy		= PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		m.lcForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		m.lcCC			= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1,.T.)
		m.lcCL			= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1,.T.)
		m.lcCond		= PrepareSQLtxt(ThisForm.Cond1.Value,'Condition',30)
		m.lnSize		= PrepareSQLnum(ThisForm.Size1.Value,'Size',9,3)
		
		pcEmailText	= "New price table entry needed for"+CHR(13)
		pcEmailText	= pcEmailText + "Alloy:"+m.lcAlloy+CHR(13)
		pcEmailText	= pcEmailText + "Form:"+m.lcForm+CHR(13)
		pcEmailText	= pcEmailText + "CC:"+m.lcCC+CHR(13)
		pcEmailText	= pcEmailText + "CL:"+m.lcCL+CHR(13)
		pcEmailText	= pcEmailText + "Cond:"+m.lcCond+CHR(13)
		pcEmailText	= pcEmailText + "Size:"+ALLTRIM(STR(m.lnSize,9,3))+CHR(13)
		
		Send_HTML_Email(pcEmailTo, pcEmailFrom, pcEmailSubject, pcEmailText, ThisForm.nConnHandle, lQuiet, lNoHeadder)
	ENDPROC

	PROCEDURE cmdSave.Click
		PRIVATE lOK, lSave
		lOK = .F.
		lSave = ThisForm.CheckSave()
		
		IF lSave
			lOK = ThisForm.SaveAdd()
			IF lOK 
				THISFORM.RELEASE
			ELSE
				MESSAGEBOX("The save FAILED."+CHR(13)+"Abort or retry the save.",0,"Not Saved")
			ENDIF
		ELSE
			WAIT WINDOW "Go back and Edit" NoWait
		ENDIF
	ENDPROC

