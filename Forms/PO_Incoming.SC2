	PROCEDURE WEIGHT1.DblClick
		PRIVATE nWeight, nUnits
		nWeight = PrepareSQLnum(This.Value,'Weight',7,1)
		nUnits  = PrepareSQLnum(ThisForm.S_QTY.Value,'StockLst_QTY',18,4)
		
		IF nWeight > 0
			IF nUnits <= 0
				ThisForm.S_QTY.Value = nWeight
			ELSE
				IF MESSAGEBOX("Do you want to replace the UNITS bought "+ALLTRIM(STR(nUnits ,7,1))+CHR(13)+"with weight "+ALLTRIM(STR(nWeight,7,1))+" ?",4+32,"Replace?") = 6
					ThisForm.S_QTY.Value = nWeight
				ENDIf
			ENDIF
		ENDIF
		
		ThisForm.S_QTY.Refresh
	ENDPROC

	PROCEDURE WEIGHT1.Valid
		ThisForm.POrecvStock_Calc()  &&Calcs Weight and QTY
	ENDPROC

