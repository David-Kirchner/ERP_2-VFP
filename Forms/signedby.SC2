DEFINE CLASS frmsignedby AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdSave" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblUser" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblDate" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmbSignBy" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: rettext		&& Hold the return Text.
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Sign Cert"
		DoCreate = .T.
		Height = 141
		Icon = graphics\earth-globe.ico
		Left = 0
		Name = "frmSignedBy"
		rettext = " "
		Top = 0
		Width = 356
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmbSignBy' AS combobox WITH ;
		ColumnCount = 2, ;
		ColumnWidths = "0,115", ;
		FirstElement = 1, ;
		Height = 24, ;
		IncrementalSearch = .F., ;
		Left = 120, ;
		Name = "cmbSignBy", ;
		NumberOfElements = 0, ;
		RowSource = "", ;
		RowSourceType = 1, ;
		Top = 12, ;
		Width = 120
		*< END OBJECT: BaseClass="combobox" />

	ADD OBJECT 'cmdCancel' AS commandbutton WITH ;
		Caption = "Cancel", ;
		Height = 25, ;
		Left = 228, ;
		Name = "cmdCancel", ;
		Top = 108, ;
		Width = 96
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSave' AS commandbutton WITH ;
		Caption = "Save", ;
		Height = 25, ;
		Left = 36, ;
		Name = "cmdSave", ;
		Top = 108, ;
		Width = 96
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'lblDate' AS label WITH ;
		Caption = "lblDate", ;
		Height = 17, ;
		Left = 24, ;
		Name = "lblDate", ;
		Top = 60, ;
		Width = 300
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblUser' AS label WITH ;
		Caption = "lblUser", ;
		Height = 17, ;
		Left = 24, ;
		Name = "lblUser", ;
		Top = 84, ;
		Width = 324
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Init
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "CERT_SIG" $ UPPER(SET("PROCEDURE"))
			IF FILE("PROGS\cert_sig.prg")
				SET PROCEDURE TO PROGS\cert_sig.prg ADDITIVE
			ENDIF
		ENDIF
		
		ThisForm.lblUser.Caption = SYS(0)
		ThisForm.lblDate.Caption = DTOC(DATE()) &&DMY(DATE())
		
		PRIVATE cMachineID, cUser, lnMySig
		cMachineID = ID()
		cUser = RIGHT(cMachineID, LEN(cMachineID)-AT('#',cMachineID)-1 )
		
		lnMySig = Cert_Sig_LookupForCurrentUser(0)
		IF lnMySig > 0
			ThisForm.cmbSignBy.Value = lnMySig
		ENDIF
		
		*!*	DO CASE 
		*!*	CASE 'RUSSELL' $ UPPER(SYS(0))
		*!*		ThisForm.cmbSignBy.Value = 'rustykirch'
		*!*	CASE 'ROGER HOBBS' $ UPPER(SYS(0)) 
		*!*		ThisForm.cmbSignBy.Value = 'rogerhobbs'
		*!*	*!*	CASE 'RUSS KIRCHNER' $ UPPER(SYS(0))  
		*!*	*!*		ThisForm.cmbSignBy.Value = 'russkir2'
		*!*	CASE 'DAVID KIRCHNER' $ UPPER(SYS(0))  
		*!*		ThisForm.cmbSignBy.Value = 'davidkirchner'
		*!*	CASE 'JEFF KIRCHNER' $ UPPER(SYS(0))  
		*!*		ThisForm.cmbSignBy.Value = 'jeffkirchner'
		*!*	CASE 'DAN MCMAHON' $ UPPER(SYS(0))  
		*!*		ThisForm.cmbSignBy.Value = 'danmcmahon'
		*!*	CASE 'DAVE MORROW' $ UPPER(SYS(0))  
		*!*		ThisForm.cmbSignBy.Value = 'DaveMorrow'
		*!*	ENDCASE
		
		
	ENDPROC

	PROCEDURE Unload
		RETURN THISFORM.RetText
	ENDPROC

	PROCEDURE cmbSignBy.AddItem
		LPARAMETERS cItem
		
	ENDPROC

	PROCEDURE cmbSignBy.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount, nConnHandle, nIndex
		
		IF NOT "CERT_SIG" $ UPPER(SET("PROCEDURE"))
			IF FILE("PROGS\cert_sig.prg")
				SET PROCEDURE TO PROGS\cert_sig.prg ADDITIVE
			ENDIF
		ENDIF
		
		this.clear
		
		cSQL = "SELECT cs.Sig_ID, cs.PersonName "
		cSQL = cSQL + "FROM dbo.Cert_Sig cs WITH(NOLOCK) "
		cSQL = cSQL + "INNER JOIN dbo.AppSetup ap WITH(NOLOCK) ON ap.[UN] = cs.PersonName "
		cSQL = cSQL + "WHERE cs.IsActive = 1 "
		cSQL = cSQL + "AND ap.[PRP] = 'Sign Cert' AND ap.[ANS] = 'YES' "
		cSQL = cSQL + "ORDER BY cs.PersonName"
		
		nConnHandle = get_SQLSTRINGCONNECT()
		nSQLEXEC = SQLEXEC(nConnHandle, cSQL, 'tmpAllowSign')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( nConnHandle, cSQL, 'tmpAllowSign')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC( nConnHandle, cSQL, "tmpAllowSign")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConnHandle, cSQL, "v")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,nConnHandle,nSQLEXEC, 'tmpAllowSign')
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements = 0
		This.BoundColumn = 1
		This.ColumnWidths = "0,140"
		
		IF USED('tmpAllowSign')
			SELECT tmpAllowSign
			nIndex = 0
			SCAN
				nIndex = nIndex + 1
				This.AddListItem(ALLTRIM(STR(tmpAllowSign.Sig_ID)), nIndex, 1)
				This.AddListItem(ALLTRIM(tmpAllowSign.PersonName), nIndex, 2)
			ENDSCAN
			USE IN tmpAllowSign
		ENDIF
		SQLDISCONNECT(nConnHandle)
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.RetText = " "
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSave.Click
		PRIVATE lSave
		lSave = .F.
		
		lSave = Sign_Cert_Check(ThisForm.cmbSignBy.Value)
		
		IF NOT lSave
			MESSAGEBOX("Not Allowed to sign as "+ALLTRIM(ThisForm.cmbSignBy.Value),0,"Prohibited!")
		ENDIF
		*!*	*rogerhobbs,Roger Hobbs,rustykirch,'Rusty' Kirchner 3rd
		*!*	DO CASE ThisForm.cmbSignBy.Value 
		*!*	CASE ThisForm.cmbSignBy.Value = 'rustykirch'
		*!*		IF NOT ( 'RUSSELL' $ UPPER(SYS(0)) )
		*!*			MESSAGEBOX("Not Allowed to sign as 'Rusty' Kirchner 3rd",0,"Prohibited!")
		*!*			lSave = .f.
		*!*		ENDIF
		*!*	CASE ThisForm.cmbSignBy.Value = 'rogerhobbs'
		*!*		IF NOT ('ROGER HOBBS' $ UPPER(SYS(0)) )
		*!*			MESSAGEBOX("Not Allowed to sign as 'Roger Hobbs'.",0,"Prohibited!")
		*!*			lSave = .f.
		*!*		ENDIF
		*!*	*!*	CASE ThisForm.cmbSignBy.Value = 'russkir2'
		*!*	*!*		IF NOT (  'RUSS KIRCHNER' $ UPPER(SYS(0)) )
		*!*	*!*			MESSAGEBOX("Not Allowed to sign as Russ Kirchner",0,"Prohibited!")
		*!*	*!*			lSave = .f.
		*!*	*!*		ENDIF
		*!*	CASE ThisForm.cmbSignBy.Value = 'davidkirchner'
		*!*		IF NOT ('DAVID KIRCHNER' $ UPPER(SYS(0)) )
		*!*			MESSAGEBOX("Not Allowed to sign as 'David Kirchner'.",0,"Prohibited!")
		*!*			lSave = .f.
		*!*		ENDIF
		*!*	CASE ThisForm.cmbSignBy.Value = 'jeffkirchner'
		*!*		IF NOT ('JEFF KIRCHNER' $ UPPER(SYS(0)) )
		*!*			MESSAGEBOX("Not Allowed to sign as 'Jeff Kirchner'.",0,"Prohibited!")
		*!*			lSave = .f.
		*!*		ENDIF
		*!*	CASE ThisForm.cmbSignBy.Value = 'danmcmahon'
		*!*		IF NOT ('DAN MCMAHON' $ UPPER(SYS(0)) )
		*!*			MESSAGEBOX("Not Allowed to sign as 'Dan McMahon'.",0,"Prohibited!")
		*!*			lSave = .f.
		*!*		ENDIF
		*!*	CASE ThisForm.cmbSignBy.Value = 'DaveMorrow'
		*!*		IF NOT ('DAVE MORROW' $ UPPER(SYS(0)) )
		*!*			MESSAGEBOX("Not Allowed to sign as 'Dave Morrow'.",0,"Prohibited!")
		*!*	*		lSave = .f.
		*!*		ENDIF
		*!*	ENDCASE
		
		IF lSave
			ThisForm.RetText = sys(0)+"|"+DTOC(DATE())+"|"+ALLTRIM(STR(VAL(TRANSFORM(ThisForm.cmbSignBy.Value))))
			ThisForm.Release
		Else
			ThisForm.RetText = " "
		ENDIF
			
	ENDPROC

ENDDEFINE
