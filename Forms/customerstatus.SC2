		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtSoldCode' AS textbox WITH ;
		Height = 23, ;
		Left = 366, ;
		Name = "txtSoldCode", ;
		ReadOnly = .T., ;
		Top = 36, ;
		Visible = .F., ;
		Width = 58
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETER pcCustomerID, pcCompany , pnSoldAddr, pConnHandle
		*DO FORM forms\CustomerStatus WITH SalesQuote.CustomerID, SalesQuote.Company, ThisForm.SoldAddr, ThisForm.nConnHandle 
		
		ThisForm.lblStandardTerms.Visible = .F.
		ThisForm.lblCOD.Visible = .F.
		ThisForm.lblPrePaid.Visible = .F.
		ThisForm.lblPayType.Visible = .F.
		
		PRIVATE cPayType
		cPayType = ''
		IF VARTYPE(pcCustomerID) != "C"
			pcCustomerID =  ''
		ENDIF
		
		PRIVATE cCustomerID
		cCustomerID = PrepareSQLtxt(pcCustomerID,'CustomerID',20)
		ThisForm.txtCustomerID.Value = ShowSQLtxt(cCustomerID,'CustomerID',20)
		*ThisForm.txtCustomerID.Value = PrepareSQLtxt(pcCustomerID,'CustomerID',20)
		
		PRIVATE cCompany  
		IF VARTYPE(pcCompany) != "C"
			pcCompany =  ''
		ENDIF
		cCompany  				  = PrepareSQLtxt(pcCompany,"Company",30)
		ThisForm.txtCompany.Value = ShowSQLtxt(cCompany,'Company',30)
		
		IF VARTYPE(pnSoldAddr) != "N"
			pnSoldAddr = 0
		ENDIF
		
		IF LEN(cCustomerID)=0 AND LEN(cCompany)=0 AND pnSoldAddr = 0
			RETURN ''
		ENDIF
		
		PRIVATE lNewConn, nConn
		lNewConn  =.F.
		IF VARTYPE(pConnHandle) = "N"
			IF pConnHandle > 0
				nConn = pConnHandle
			ELSE
				nConn = get_SQLSTRINGCONNECT()
				lNewConn = .T.
			ENDIF
		ELSE
			nConn= get_SQLSTRINGCONNECT()
			lNewConn = .T.
		ENDIF
		
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		IF USED("tmpPayType")
			USE IN tmpPayType
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC 
		
		***
		PRIVATE cUseCustomerID
		cUseCustomerID = ''
		PRIVATE nCntCustomerID
		nCntCustomerID = 0 
		IF NOT EMPTY(cCustomerID)
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.[CUSTOMER_LIST] WHERE "
			cSQL = cSQL + " [CustomerID] = '"+cCustomerID+"'"
			
			nSQLEXEC = SQLEXEC( nConn, cSQL, 'nConn')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPayType')
			ENDIF
			IF USED('tmpPayType')
				IF RECCOUNT('tmpPayType') > 0
					nCntCustomerID = tmpPayType.Cntd
					cUseCustomerID = cCustomerID
				ENDIF
				USE IN tmpPayType
			ENDIF
		ENDIF
		***
		PRIVATE nCtndCompany
		nCntdCompany = 0
		
		IF nCntCustomerID = 0
			IF NOT EMPTY(cCompany)
			
				*Get CustomerID from Company Name
				
				cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.[CUSTOMER_LIST] WHERE "
				cSQL = cSQL + " [CustomerName] = '"+cCompany+"'"
				
				nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPayType')
				ENDIF
				IF USED('tmpPayType')
					IF RECCOUNT('tmpPayType') > 0
						nCntdCompany = tmpPayType.Cntd
					ENDIF
					USE IN tmpPayType
				ENDIF
		
				IF nCntdCompany = 1
					*Get CustomerID
					
					cSQL = "SELECT [CustomerID] AS CustomerID FROM dbo.[CUSTOMER_LIST] WHERE "
					cSQL = cSQL + " [CustomerName] = '"+cCompany+"'"
					
					nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPayType')
					ENDIF
					IF USED('tmpPayType')
						IF RECCOUNT('tmpPayType') > 0
							nCntCustomerID = 1
							cUseCustomerID = PrepareSQLtxt(tmpPayType.CustomerID,'CustomerID',20)
							ThisForm.lblCustIDFound.Caption = "Customer ID '"+ALLTRIM(cCustomerID)+"' was found!"
							ThisForm.lblCustIDFound.Visible = .T.
						ENDIF
						USE IN tmpPayType
					ENDIF
				ENDIF
				
				IF nCntdCompany = 0 &&Try Like
					cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.[CUSTOMER_LIST] WHERE "
					cSQL = cSQL + " [CustomerName] LIKE '%"+cCompany+"%'"
					
					nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPayType')
					ENDIF
					IF USED('tmpPayType')
						nCntdCompany = tmpPayType.Cntd
						USE IN tmpPayType
					ENDIF
					
					IF nCntdCompany = 1   &&Get it
						cSQL = "SELECT [CustomerID] AS CustomerID FROM dbo.[CUSTOMER_LIST] WHERE "
						cSQL = cSQL + " [CustomerName] LIKE '%"+cCompany+"%'"
						
						nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPayType')
						ENDIF
						IF USED('tmpPayType')
							IF RECCOUNT('tmpPayType') > 0
								nCntCustomerID = 1
								cUseCustomerID = PrepareSQLtxt(tmpPayType.CustomerID,'CustomerID',20)
								ThisForm.lblCustIDFound.Caption = "Customer ID '"+ALLTRIM(cCustomerID)+"' was not found!"
								ThisForm.lblCustIDFound.Visible = .T.
							ENDIF
							USE IN tmpPayType
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		***
		IF nCntCustomerID = 0
			IF pnSoldAddr > 0
		
				*Get SoldAddr Company Name
		
				PRIVATE nCtndSoldAddr
				nCtndSoldAddr= 0
		
				cSQL = "SELECT Customer FROM dbo.[SoldAddr] WHERE "
				cSQL = cSQL + " [SoldCode] = "+STR(pnSoldAddr)
				
				nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPayType')
				ENDIF
				IF USED('tmpPayType')
					IF RECCOUNT('tmpPayType') > 0
						IF VARTYPE(tmpPayType.customer) = "C"
							nCntCustomerID = 1
							cUseCustomerID = PrepareSQLtxt(tmpPayType.Customer,'CustomerID',20)
							
							ThisForm.txtCustomerID.Value = cUseCustomerID 
							ThisForm.lblSoldCode.Visible = .T.
							ThisForm.txtSoldCode.Visible = .T.
							ThisForm.txtSoldCode.Value = PrepareSQLnum(pnSoldAddr,'SoldAddr',-3)
							
							IF LEN(cUseCustomerID) <= 1
								ThisForm.lblCustIDFound.Caption = "Customer ID '"+ALLTRIM(cCustomerID)+"' was not found!"
								ThisForm.lblCustIDFound.Visible = .T.
							ENDIF
						ENDIF
					ENDIF
					USE IN tmpPayType
				ENDIF
		
			ENDIF
		ENDIF
		
		IF NOT EMPTY(cUseCustomerID)
			ThisForm.lblNotFound.Visible = .F.
			
			cSQL = " SELECT [Type] AS CustType, [StandTerms] AS StndTerm, [CODTerms] AS CODTerm, [Prepaid] AS Prepaid, [CreditLimit] AS Limit, [CurrentBalance] AS BAL"
			cSQL = cSQL + " FROM dbo.[CUSTOMER_LIST] WHERE "
			cSQL = cSQL + " [CustomerID] = '"+cUseCustomerID+"'"
		
			SELECT 0
			nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( nConn, cSQL, 'tmpPayType')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpPayType")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpPayType')
			ENDIF
		
			IF USED('tmpPayType')
				****Standard Terms
				IF VARTYPE(tmpPayType.StndTerm) = "L"
					IF tmpPayType.StndTerm
						*cPayType = '1'
						ThisForm.lblStandardTerms.Visible = .T.
					ENDIF
				ENDIF
				IF VARTYPE(tmpPayType.StndTerm) = "C"
					IF UPPER(tmpPayType.StndTerm) = "TRUE"
						*cPayType = '1'
						ThisForm.lblStandardTerms.Visible = .T.
					ENDIF
				ENDIF		
				*IF cPayType = '1'
				*	ThisForm.lblStandardTerms.Visible = .T.
				*ENDIF
				****COD
				IF VARTYPE(tmpPayType.CODTerm) = "L"
					IF tmpPayType.CODTerm
						*cPayType = '2'
						ThisForm.lblCOD.Visible = .T.
					ENDIF
				ENDIF
				IF VARTYPE(tmpPayType.CODTerm) = "C"
					IF UPPER(tmpPayType.CODTerm) = "TRUE"
						*cPayType = '2'
						ThisForm.lblCOD.Visible = .T.
					ENDIF
				ENDIF
				*IF cPayType = '2'
				*	ThisForm.lblCOD.Visible = .T.
				*ENDIF
				****Prepaid
				IF VARTYPE(tmpPayType.Prepaid) = "L"
					IF tmpPayType.Prepaid
						*cPayType = '3'
						ThisForm.lblPrePaid.Visible = .T.
					ENDIF
				ENDIF
				IF VARTYPE(tmpPayType.Prepaid) = "C"
					IF UPPER(tmpPayType.Prepaid) = "TRUE"
						*cPayType = '3'
						ThisForm.lblPrePaid.Visible = .T.
					ENDIF
				ENDIF	
				*IF cPayType = '3'
				*	ThisForm.lblPrePaid.Visible = .T.
				*ENDIF
				*****Customer Type
				
				PRIVATE cPayType1 
				IF VARTYPE(tmpPayType.CustType) = "C"
					cPayType1 = LEFT(tmpPayType.CustType,1)
					IF VAL(cPayType1) > 0
						cPayType = cPayType1 
						ThisForm.lblPayType.Visible = .T.
						ThisForm.lblPayType.Caption = ShowPaymentTypeText(cPayType1)
						
						ThisForm.lblnPayType.Caption = cPayType1
						ThisForm.lblnPayType.Visible = .T.
					ENDIF
				ENDIF
				
				***** Check for Overdrawn
				nLimit = PrepareSQLnum( tmpPayType.Limit,'Limit',-3)
				nBal  =  PrepareSQLnum( tmpPayType.Bal,'Balance',-3)
				
				ThisForm.txtBalance.Value = nBal
				ThisForm.txtLimit.Value = nLimit
				ThisForm.txtDiff.Value = nLimit - nBal
				
				IF nBal > nLimit
					cPayType = ALLTRIM(cPayType)+'OverLimit'
				ENDIF
				USE IN tmpPayType
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
	ENDPROC

	PROCEDURE Unload
		*!*	IF USED("CustomerTerms")
		*!*		USE IN CustomerTerms
		*!*	ENDIF
		
		*!*	 = SQLDISCONNECT(ThisForm.ConnHandle )
		*!*	 
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
	ENDPROC

ENDDEFINE
