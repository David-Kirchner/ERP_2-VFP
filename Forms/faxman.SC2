	PROCEDURE Activate
		application.AutoYield=(.F.)
		thisform.FmPrint1.appid = "FaxMan"
	ENDPROC

	PROCEDURE faxfinder
		PRIVATE i, oDesc, nDvc, cAlias
		
		cAlias = ALIAS()
		
		*!*	nDvc = ThisForm.FaxFinder1.DeviceCount
		*!*	For i = 1 TO nDvc
		*!*		oDesc = ThisForm.FaxFinder1(i - 1) &&This is a zero-based enumeration
		*!*		*1.7 FaxFinder
		*!*		*FaxMan Jr | 13
		*!*		ThisForm.Edit1.SelText = "Port " + Str(oDesc.Port) +CHR(13)
		*!*		ThisForm.Edit1.SelText = "Supports: "
		
		*!*		If oDesc.bClass1 Then
		*!*			ThisForm.Text1.SelText = "Class 1 "
		*!*		ENDIF
		*!*		If oDesc.bClass2 Then
		*!*			ThisForm.Text1.SelText = "Class 2 "
		*!*		ENDIF
		*!*		If oDesc.bClass20 Then
		*!*			ThisForm.Text1.SelText = "Class 2.0 "
		*!*		ENDIF
		*!*		ThisForm.Text1.SelText = CHR(13)+CHR(13)
		*!*	Next i
		
		WAIT WINDOW "Fax Finder" NOWAIT
		
		PRIVATE cFaxPort, cFaxClass, cFaxPrefix
		cFaxPort = '1'
		cFaxClass = '1'
		cFaxPrefix = "9,"
		
		PRIVATE i, oDesc
		FOR i = 1 TO THISFORM.FaxFinder1.DeviceCount
			oDesc = THISFORM.FaxFinder1.ITEM(i -1)
		*Thisform.faxjr.port = oDesc.port
			cFaxPort = ALLTRIM(STR( oDesc.port ))
		
			IF oDesc.bClass2 = 1 THEN
				THISFORM.FaxManJr1.OBJECT.CLASS = 2
			ENDIF
		
			IF oDesc.bClass20 = 1 THEN
				THISFORM.FaxManJr1.OBJECT.CLASS = 3
			ENDIF
		
			IF oDesc.bclass1 = 1 THEN
				THISFORM.FaxManJr1.OBJECT.CLASS = 1
			ENDIF
		
		*	Thisform.text3.Value = 'Class'+Str(Thisform.faxjr.Object.Class,1)+' device on Com'+Str(Thisform.faxjr.port,1)
		
		NEXT i
		
		IF i =1 THEN
			cFaxPort = '0'
		ENDIF
		
		
		
		PRIVATE cMachine
		cMachine = SYS(0)
		IF AT('#',cMachine) > 0
			cMachine = LEFT(cMachine, AT('#',cMachine)-2 )
		ENDIF
		cMachine = LEFT( cMachine ,20 )  &&max 20
		
		IF VAL(cFaxPort) > 0
		
			SELECT SETUP
			LOCATE FOR UN = cMachine AND PRP = "FaxPort"
			IF FOUND()
				UPDATE SETUP SET ANS = cFaxPort WHERE UN = cMachine AND PRP = "FaxPort"
			ELSE
				INSERT INTO SETUP (UN,PRP,ANS) VALUES (cMachine,"FaxPort",cFaxPort)
			ENDIF
		
			LOCATE FOR UN = cMachine AND PRP = "FaxClass"
			IF FOUND()
				UPDATE SETUP SET ANS = cFaxClass WHERE UN = cMachine AND PRP = "FaxClass"
			ELSE
				INSERT INTO SETUP (UN,PRP,ANS) VALUES (cMachine,"FaxClass",cFaxClass)
			ENDIF
		
			LOCATE FOR UN = cMachine AND PRP = "FaxPrefix"
			IF FOUND()
				UPDATE SETUP SET ANS = cFaxPrefix WHERE UN = cMachine AND PRP = "FaxPrefix"
			ELSE
				INSERT INTO SETUP (UN,PRP,ANS) VALUES (cMachine,"FaxPrefix",cFaxPrefix)
			ENDIF
		ELSE
			MESSAGEBOX("Unable to find FaxPort!",0+16,"Error: no comm port")
			RETURN .F.
		ENDIF
		
		THISFORM.FaxPort = cFaxPort
		THISFORM.FaxClass = cFaxClass
		THISFORM.FaxPrefix = cFaxPrefix
		
		IF ThisForm.CloseSetup
			IF USED("Setup")
				USE IN SETUP
			ENDIF
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED("cAlias")
				SELECT cAlias
			ENDIF
		ENDIF
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE Init
		PARAMETER pFaxFiles,pFaxNumber,pFaxName,pFaxCompany,pFaxSubject,pInquireP,pReportType,pHighRes,pTable
		*DO FORM "c:\program files\hpa\forms\faxman.scx" WITH 'C:\Program Files\HPA\FaxMan\test.pdf','6757051','David','HPA','Test','1D','Quote',.T.
		*DO FORM Forms\FaxMan WITH 'PRINT',Q_faxnm,xname,xcomp,xsubj,xBill,'sndQuote',.T.
		
		IF TYPE("pFaxFiles") = "C"
			IF pFaxFiles = "PRINT"
				ThisForm.FaxFiles = "PRINT"
				WAIT WINDOW 'Setting up fax...' NOWAIT
			ELSE
				ThisForm.FaxFiles = pFaxFiles
				
				IF ".PDF" $ UPPER(pFaxFiles)
					IF FILE("C:\Program Files\HPA\FaxMan\Fax.fmf")
						DELETE FILE ("C:\Program Files\HPA\FaxMan\Fax.fmf")
					ENDIF
					IF FILE(ThisForm.FaxFiles)
						ThisForm.FaxManJr1.ImportFiles( "C:\Program Files\HPA\FaxMan\Fax.fmf", ThisForm.FaxFiles )
						ThisForm.FaxFiles = "C:\Program Files\HPA\FaxMan\Fax.fmf"
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		
		IF TYPE("pFaxNumber") = "N"
			ThisForm.FaxNumber = ALLTRIM(STR( pFaxNumber ))
		ENDIF
		IF TYPE("pFaxNumber") = "C"
			ThisForm.FaxNumber = pFaxNumber
		ENDIF
		IF EMPTY(pFaxNumber)
			ThisForm.FaxNumber = "6757051"
		ENDIF
		*ptime,pdate,
		
		IF TYPE("pFaxName") = "C"
			ThisForm.FaxName = pFaxName
		ENDIF
		IF EMPTY(pFaxName)
			ThisForm.FaxName = "test Name"
		ENDIF
		
		IF TYPE("pFaxCompany") = "C"
			ThisForm.FaxCompany = pFaxCompany
		ENDIF
		IF EMPTY(pFaxCompany)
			ThisForm.FaxCompany = "test Company"
		ENDIF
		
		IF TYPE("pFaxSubject") = "C"
			ThisForm.FaxSubject = pFaxSubject
		ENDIF
		IF EMPTY(pFaxSubject)
			ThisForm.FaxSubject = "test Subject"
		ENDIF
		
		
		IF TYPE("pReportType") = "C"
			ThisForm.ReportType = UPPER(pReportType)
		ENDIF
		
		*pKeywd,pBill,,pHighRes,pPrntSetup
		
		IF TYPE("pTable") = "C"
			ThisForm.cTable= UPPER(pTable)
		ENDIF
		
		
		
		*ThisForm.UserName
		*ThisForm.FaxManJr1.UserName = ThisForm.UserName &&name of person sending the fax
		*ThisForm.FaxManJr1.UserCompany 		= "Space Alloys USA" &&name of company sending the fax
		*ThisForm.FaxManJr1.UserFaxNumber 	= "765-675-7051" &&fax number of sender
		*ThisForm.FaxManJr1.UserVoiceNumber 	= "765-675-8871" &&voice phone number of sender
		
		*UN  c 20
		*PRP c 20
		*ANS c 30
		PRIVATE cMachine, cFaxPort, cFaxClass 
		cMachine = SYS(0)
		IF AT('#',cMachine) > 0
			cMachine = LEFT(cMachine, AT('#',cMachine)-2 )
		ENDIF
		cMachine = LEFT( cMachine ,20 )  &&max 20
		
		IF NOT ThisForm.FaxFinder()
			RETURN
			ThisForm.Release
		ENDIF
		
		*!*	SELECT SETUP
		*!*	LOCATE FOR UN = cMachine AND PRP = "FaxPort"
		*!*	IF FOUND()
		*!*		IF VAL(ANS) < 1
		*!*			ThisForm.FaxFinder()
		*!*		ELSE
		*!*			cFaxPort = ANS
		*!*			ThisForm.FaxPort = ANS
		*!*		ENDIF
		*!*	ELSE
		*!*		ThisForm.FaxFinder()
		*!*	ENDIF
		
		*!*	LOCATE FOR UN = cMachine AND PRP = "FaxClass"
		*!*	IF FOUND()
		*!*		cFaxClass = ANS
		*!*		ThisForm.FaxClass = ANS
		*!*	ELSE
		*!*		INSERT INTO SETUP (UN,PRP,ANS) VALUES (cMachine,"FaxClass","1")
		*!*		ThisForm.FaxClass = '1'
		*!*	ENDIF
		
		
		*!*	LOCATE FOR UN = cMachine AND PRP = "FaxPrefix"
		*!*	IF FOUND()
		*!*		cFaxPrefix = ANS
		*!*		ThisForm.FaxPrefix = ANS
		*!*	ELSE
		*!*		INSERT INTO SETUP (UN,PRP,ANS) VALUES (cMachine,"FaxPrefix","9,")
		*!*		ThisForm.FaxPrefix= '9,'
		*!*	ENDIF
		ThisForm.faxManJr1.DeviceInit = "AT&F&C1&D2E0V1S0=0"
		
		ThisForm.lblFaxPort.Caption = "Port:"+ThisForm.FaxPort
		ThisForm.lblFaxClass.Caption = "Class:"+ThisForm.FaxClass
		ThisForm.lblFaxPrefix.Caption = "Dial:"+ThisForm.FaxPrefix
		
		ThisForm.Edit1.SelText = "Fax to:"+ThisForm.FaxNumber + CHR(13)
		ThisForm.Edit1.SelText = ThisForm.Edit1.SelText + ThisForm.FaxName + CHR(13)
		ThisForm.Edit1.SelText = ThisForm.Edit1.SelText + ThisForm.FaxCompany + CHR(13)
		ThisForm.Edit1.SelText = ThisForm.Edit1.SelText + ThisForm.FaxSubject + CHR(13)
		ThisForm.Edit1.SelText = ThisForm.Edit1.SelText + ThisForm.FaxFiles + CHR(13)
		
		IF ThisForm.FaxFiles = "PRINT"
		*	ThisForm.cmdSend.Enabled =.F.
		*	ThisForm.cmdPrintReport.Enabled =.F.
			
			ThisForm.cmdPrintReport.Click
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		*!*	IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*!*		SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		*!*	ENDIF
		
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		IF NOT EMPTY("cAlias")
			ThisForm.pAlias = cAlias 
		ENDIF
		
		*!*	IF "\MEM" $ SYS(2003)
		*!*		IF FILE(SYS(5)+SYS(2003)+"\ERPSetup.mem")
		*!*			RESTORE FROM (SYS(5)+SYS(2003)+"\ERPSetup.mem") ADDITIVE
		*!*		ENDIF
		*!*	ELSE
		*!*		IF FILE(SYS(5)+SYS(2003)+"\MEM\ERPSetup.mem")
		*!*			RESTORE FROM (SYS(5)+SYS(2003)+"\MEM\ERPSetup.mem") ADDITIVE
		*!*		ENDIF
		*!*	ENDIF
		*ThisForm.CloseSetup = .T.
		ThisForm.CloseSetup = .f.
		
		
		IF FILE("C:\Program Files\HPA\FaxMan\Fax001.fmf")
			DELETE FILE "C:\Program Files\HPA\FaxMan\Fax001.fmf"
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseSetup
			IF USED("Setup")
				USE IN SETUP
			ENDIF
		ENDIF
		
		
		PRIVATE cAlias 
		cAlias = ThisForm.pAlias
		IF NOT EMPTY("cAlias")
			IF USED("cAlias")
				SELECT (cAlias)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdCancelFax.Click
		
		ThisForm.FaxManJr1.CancelFax
		
	ENDPROC

	PROCEDURE cmdPrintReport.Click
		PRIVATE nPrinters
		nPrinters=APRINTERS(aaprinters)
		IF nPrinters= 0
			Wait Window "No Printers!!"
			RETURN .F.
		ENDIF
		PRIVATE lFaxMan, lWinFax, lMSFax, CT
		
		lFaxMan = .F.
		lWinFax = .F.
		lMSFax = .F.
		FOR CT = 1 TO nPrinters
			IF aaPrinters(ct,1)="VFP FaxMan"
				lFaxMan = .T.
			ENDIF
			IF aaPrinters(ct,1)="WinFax"
				lWinFax = .T.
			ENDIF
			IF aaPrinters(ct,1)="Fax"
				lMSFax = .T.
			ENDIF
		NEXT CT
		
		IF NOT lFaxMan
			IF FILE( "C:\Program Files\HPA\FaxMan\FaxInstall.Bat" )
				RUN "C:\Program Files\HPA\FaxMan\FaxInstall.Bat"
			ELSE
				MESSAGEBOX(" You need to install the FacMan Print driver."+CHR(13)+"Usually at C:\Program Files\HPA\FaxMan\FaxInstall.Bat",0,"No Fax Print Device 'FaxMan'")
				RETURN .F.
			ENDIF
		ENDIF
		
		IF NOT EMPTY(ThisForm.cTable)
			IF USED( ThisForm.cTable )
				SELECT (ThisForm.cTable)
			ENDIF
		ENDIF
		
		SET PRINTER TO NAME "VFP FaxMan"
		
		DO CASE
		CASE ThisForm.ReportType = "QUOTE"
			REPORT FORM reports\Quote09 NOCONSOLE TO PRINTER
		CASE ThisForm.ReportType = "SNDINQUIRE"
			REPORT FORM reports\sndinquire NOCONSOLE TO PRINTER
		OTHERWISE
			*REPORT FORM test\FaxManJr7\accounts.frx NOCONSOLE TO PRINTER
		ENDCASE
		
		SET PRINTER TO DEFAULT
		
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdSend.Click
		IF EMPTY(ThisForm.FaxPort)
			MESSAGEBOX("Fax comm Port is Empty!",0+16)
			RETURN
		ENDIF
		
		*use the number of your comm port here
		ThisForm.FaxManJr1.Port = ThisForm.FaxPort
		*ThisForm.FaxManJr1.Class = ThisForm.FaxClass
		
		*ThisForm.FaxManJr1.FxCoverPage = "cover1.pg"
		
		*be sure to specify the complete path to
		*the file to send
		IF NOT EMPTY(ThisForm.FaxFiles)
			IF ThisForm.FaxFiles = "PRINT"
				ThisForm.FaxManJr1.FaxFiles = "C:\Program Files\HPA\FaxMan\Fax001.fmf"  &&Set in FMPrint1.PrintStart
			ELSE
				ThisForm.FaxManJr1.FaxFiles = ThisForm.FaxFiles
			ENDIF
		ELSE
			ThisForm.FaxManJr1.FaxFiles = "C:\Program Files\HPA\FaxMan\Fax0.fmf"
		ENDIF
		
		IF NOT EMPTY(ThisForm.UserName)
			ThisForm.FaxManJr1.UserName = ThisForm.UserName &&name of person sending the fax
		ENDIF
		
		ThisForm.FaxManJr1.UserCompany 		= "Space Alloys USA" &&name of company sending the fax
		ThisForm.FaxManJr1.UserFaxNumber 	= "765-675-7051" &&fax number of sender
		ThisForm.FaxManJr1.UserVoiceNumber 	= "765-675-8871" &&voice phone number of sender
		
		IF NOT EMPTY(ThisForm.FaxName)
			ThisForm.FaxManJr1.FaxName = ThisForm.FaxName &&name of the person you�re faxing to
		ENDIF
		IF NOT EMPTY(ThisForm.FaxSubject)
			ThisForm.FaxManJr1.FaxSubject = ThisForm.FaxSubject &&subject of the fax
		ENDIF
		IF NOT EMPTY(ThisForm.FaxCompany)
			ThisForm.FaxManJr1.FaxCompany = ThisForm.FaxCompany &&name of company you�re sending the fax to
		ENDIF
		*put your own phone number in here
		ThisForm.FaxManJr1.FaxNumber = " "+ALLTRIM(ThisForm.FaxPrefix) +" "+ ALLTRIM(ThisForm.FaxNumber)
		*ThisForm.FaxManJr1.FaxCoverPage = "c:\FaxMan Jr.\server\cover2.pg"
		
		ThisForm.FaxManJr1.SendFax
		
		WAIT WINDOW "Send Fax" NOWAIT
		
		*******************************
		
		*!*	Set faxstat = FaxManJr1.StatusObject
		*!*	DO WHILE .T.
		*!*		ThisForm.FaxManJr1.WaitForEvent = 1000 &&Wait for 1 second
		*!*		DO Case 
		*!*		Case faxstat.LastEventType='EVENT_STATUS'
		*!*		i = 0
		*!*			ThisForm.Text1.SelText = "Status" + CHR(13)
		*!*		Case faxstat.LastEventType='EVENT_NEGOTIATION'
		*!*			ThisForm.Text1.SelText = "Negotiation" + CHR(13)
		*!*		Case faxstat.LastEventType='EVENT_STARTTIME'
		*!*			ThisForm.Text1.SelText = "StartTime" + CHR(13)
		*!*		Case faxstat.LastEventType='EVENT_ENDTIME'
		*!*			ThisForm.Text1.SelText = "EndTime" + CHR(13)
		*!*		Case faxstat.LastEventType'EVENT_COMPLETE'
		*!*			ThisForm.Text1.SelText = "Complete" + CHR(13)
		*!*		Case faxstat.LastEventType='EVENT_TIMEOUT'
		*!*			i = i + 1
		*!*			ThisForm.Text1.SelText = "Timeout" + CHR(13)
		*!*		ENDCASE
		*!*		
		*!*		IF (faxstat.LastEventType = 'EVENT_COMPLETE') Or (i = 9 ) && 90 idle seconds
		*!*			LOOP 
		*!*		ENDIF
		*!*		EXIT
		*!*	ENDDO
	ENDPROC

ENDDEFINE
