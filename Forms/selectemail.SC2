DEFINE CLASS frmselectemail AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdSelect" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkEmail1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtEmail1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtName1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkEmail2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtEmail2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtName2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkEmail3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtEmail3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtName3" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: closeconn
		*p: creturnvalue		&& Value to be returned ( Selected source Company)
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		AlwaysOnTop = .T.
		AutoCenter = .T.
		Caption = "Select Email Address to Send to"
		closeconn = .F.
		ControlBox = .F.
		creturnvalue = ""
		DataSession = 2
		DoCreate = .T.
		Height = 117
		Icon = graphics\earth-globe.ico
		LockScreen = .F.
		MDIForm = .T.
		Name = "frmSelectEmail"
		nconnhandle = 0
		Width = 377
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'chkEmail1' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "Send", ;
		Height = 17, ;
		Left = 4, ;
		Name = "chkEmail1", ;
		TabIndex = 1, ;
		Top = 9, ;
		Width = 60
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'chkEmail2' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "Send", ;
		Height = 17, ;
		Left = 4, ;
		Name = "chkEmail2", ;
		TabIndex = 4, ;
		Top = 35, ;
		Width = 60
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'chkEmail3' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "Send", ;
		Height = 17, ;
		Left = 5, ;
		Name = "chkEmail3", ;
		TabIndex = 7, ;
		Top = 62, ;
		Width = 60
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'cmdCancel' AS commandbutton WITH ;
		Caption = "Cancel", ;
		Height = 27, ;
		Left = 256, ;
		Name = "cmdCancel", ;
		TabIndex = 11, ;
		TerminateRead = .T., ;
		Top = 86, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSelect' AS commandbutton WITH ;
		Caption = "Select", ;
		Default = .T., ;
		Height = 27, ;
		Left = 2, ;
		Name = "cmdSelect", ;
		TabIndex = 10, ;
		Top = 86, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'txtEmail1' AS textbox WITH ;
		Height = 23, ;
		Left = 56, ;
		MaxLength = 50, ;
		Name = "txtEmail1", ;
		TabIndex = 2, ;
		Top = 6, ;
		Width = 150
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtEmail2' AS textbox WITH ;
		Height = 23, ;
		Left = 56, ;
		MaxLength = 50, ;
		Name = "txtEmail2", ;
		TabIndex = 5, ;
		Top = 32, ;
		Width = 150
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtEmail3' AS textbox WITH ;
		Height = 23, ;
		Left = 57, ;
		MaxLength = 50, ;
		Name = "txtEmail3", ;
		TabIndex = 8, ;
		Top = 59, ;
		Width = 150
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtName1' AS textbox WITH ;
		Enabled = .F., ;
		Height = 23, ;
		Left = 217, ;
		Name = "txtName1", ;
		ReadOnly = .T., ;
		TabIndex = 3, ;
		Top = 6, ;
		Width = 150
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtName2' AS textbox WITH ;
		Enabled = .F., ;
		Height = 23, ;
		Left = 217, ;
		Name = "txtName2", ;
		ReadOnly = .T., ;
		TabIndex = 6, ;
		Top = 32, ;
		Width = 150
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtName3' AS textbox WITH ;
		Enabled = .F., ;
		Height = 23, ;
		Left = 218, ;
		Name = "txtName3", ;
		ReadOnly = .T., ;
		TabIndex = 9, ;
		Top = 59, ;
		Width = 150
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS cEmail1,cName1,cEmail2,cName2,cEmail3,cName3
		*DO FORM Forms\SelectEmail WITH cQouteEmail,cQuoteName,cEmail,cContact,'',''  TO cNewEmail
		
		IF VARTYPE(cEmail1) = "C"
			ThisForm.chkEmail1.Value = 1
			ThisForm.txtEmail1.Value = cEmail1
		ENDIF
		IF VARTYPE(cName1) = "C"
			ThisForm.txtName1.Value = cName1
		ENDIF
		
		
		IF VARTYPE(cEmail2) = "C"
			ThisForm.txtEmail2.Value = cEmail2
		ENDIF
		IF VARTYPE(cName2) = "C"
			ThisForm.txtName2.Value = cName2
		ENDIF
		
		
		IF VARTYPE(cEmail3) = "C"
			ThisForm.txtEmail3.Value = cEmail3
		ENDIF
		IF VARTYPE(cName3) = "C"
			ThisForm.txtName3.Value = cName3
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		*!*	ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
	ENDPROC

	PROCEDURE Unload
		RETURN THISFORM.cReturnValue
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE lEmail1,cEmail1,lEmail2,cEmail2,lEmail3,cEmail3
		
		PRIVATE cReturnEmail
		cReturnEmail = ''
		
		PRIVATE nAT, nDot, cErrorMess
		cErrorMess = ''
		
		lEmail1	= PrepareSQLlogic(ThisForm.chkEmail1.Value,'SendEmail')
		IF lEmail1
			cEmail1	= PrepareSQLtxt(ThisForm.txtEmail1.Value,'Email',50)
			IF NOT EMPTY(cEmail1)
				nAT = AT("@",cEmail1)
				IF nAT > 0
					nDot = AT(".",RIGHT(cEmail1, LEN(cEmail1)-nAT))
					IF nDot > 0
						cReturnEmail = ALLTRIM(cEmail1)
					ELSE
						lEmail1 = .F.
						cErrorMess = cErrorMess + "No dot in Email 1:"+cEmail1+CHR(13)
					ENDIF
				ELSE
					lEmail1 = .F.
					cErrorMess = cErrorMess + "No @ in Email 1:"+cEmail1+CHR(13)
				ENDIF
			ELSE
				lEmail1 = .F.
				cErrorMess = cErrorMess + "Email 1 is Empty"
			ENDIF
		ENDIF
		
		lEmail2	= PrepareSQLlogic(ThisForm.chkEmail2.Value,'SendEmail')
		IF lEmail2
			cEmail2	= PrepareSQLtxt(ThisForm.txtEmail2.Value,'Email',50)
		
			IF NOT EMPTY(cEmail2)
				nAT = AT("@",cEmail2)
				IF nAT > 0
					nDot = AT(".",RIGHT(cEmail2, LEN(cEmail2)-nAT))
					IF nDot > 0
						IF lEmail1
							cReturnEmail = cReturnEmail +"; "+ ALLTRIM(cEmail2)
						ELSE
							cReturnEmail = ALLTRIM(cEmail2)
						ENDIF
					ELSE
						lEmail2 = .F.
						cErrorMess = cErrorMess + "No dot in Email 2:"+cEmail2+CHR(13)
					ENDIF
				ELSE
					lEmail2 = .F.
					cErrorMess = cErrorMess + "No @ in Email 2:"+cEmail2+CHR(13)
				ENDIF
			ELSE
				lEmail2 = .F.
				cErrorMess = cErrorMess + "Email 2 is Empty"+CHR(13)
			ENDIF
		ENDIF
		
		lEmail3	= PrepareSQLlogic(ThisForm.chkEmail3.Value,'SendEmail')
		IF lEmail3
			cEmail3	= PrepareSQLtxt(ThisForm.txtEmail3.Value,'Email',50)
			IF NOT EMPTY(cEmail3)
				nAT = AT("@",cEmail3)
				IF nAT > 0
					nDot = AT(".",RIGHT(cEmail3, LEN(cEmail3)-nAT))
					IF nDot > 0
						IF lEmail1 OR lEmail2
							cReturnEmail = cReturnEmail +"; "+ ALLTRIM(cEmail3)
						ELSE
							cReturnEmail = ALLTRIM(cEmail3)
						ENDIF
					ELSE
						cErrorMess = cErrorMess + "No dot in Email 3:"+cEmail3+CHR(13)
					ENDIF
				ELSE
					cErrorMess = cErrorMess + "No @ in Email 3:"+cEmail3+CHR(13)
				ENDIF
			ELSE
				cErrorMess = cErrorMess + "Email 3 is Empty"+CHR(13)
			ENDIF
		ENDIF
		
		
		IF EMPTY(cReturnEmail)
			cErrorMess = "No Email Address chosen." +CHR(13)+CHR(13)+ cErrorMess 
			MESSAGEBOX(cErrorMess,48,"Cancel or Select an Email to Send.")
			RETURN .F.
		ELSE
			IF NOT EMPTY(cErrorMess)
				IF MESSAGEBOX("Do you still want to Correct?"+CHR(13)+CHR(13)+cErrorMess,4+48,"Found Address Error.") = 6
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		
		
		THISFORM.cReturnValue = cReturnEmail
		
		ThisForm.Release
	ENDPROC

ENDDEFINE
