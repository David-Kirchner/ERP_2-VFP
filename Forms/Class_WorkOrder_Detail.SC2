	PROCEDURE formsrefresh
		*ThisFormSet.FormsRefresh()
		
		PRIVATE cForm
		cForm = '10'
		
		IF ThisFormSet.frmWO.Visible
			cForm = PrepareSQLtxt(ThisFormSet.frmWO.txtForm.Value,'Form',2)	
			
			IF NOT LEN(ALLTRIM(cForm))=0
				IF GetFormCaptions(cForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
						
						ThisFormSet.frmWO.lblThck1.Caption	= RTRIM(tmpFormCaptions.txt1)
						ThisFormSet.frmWO.lblSz21.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormSet.frmWO.lblSz21.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormSet.frmWO.lblSz31.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormSet.frmWO.lblSz31.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormSet.frmWO.txtSz3.Visible 		= tmpFormCaptions.use3rdDim
						ThisFormSet.frmWO.txtSz3.Enabled 		= tmpFormCaptions.Sz3Enable
						ThisFormSet.frmWO.lblsz41.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormSet.frmWO.lblsz41.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ENDIF
				ENDIF
			ENDIF
			***************************************
			cForm = PrepareSQLtxt(ThisFormSet.frmWO.txtFForm.Value,'Form',2)	
			
			IF NOT LEN(ALLTRIM(cForm))=0
				IF GetFormCaptions(cForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
						
						ThisFormSet.frmWO.lblFThck.Caption	= RTRIM(tmpFormCaptions.txt1)
						ThisFormSet.frmWO.lblFSz2.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormSet.frmWO.lblFSz2.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormSet.frmWO.lblFSz3.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormSet.frmWO.lblFSz3.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormSet.frmWO.txtFSz3.Visible 		= tmpFormCaptions.use3rdDim
						ThisFormSet.frmWO.txtFSz3.Enabled 		= tmpFormCaptions.Sz3Enable
						ThisFormSet.frmWO.lblFSz4.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormSet.frmWO.lblFSz4.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		********
		********
		********
		********
		IF ThisFormSet.frmWOD.Visible
			cForm = PrepareSQLtxt(ThisFormSet.frmWOD.txtForm.Value,'Form',2)	
			
			IF NOT LEN(ALLTRIM(cForm))=0
				IF GetFormCaptions(cForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
						
						ThisFormSet.frmWOD.lblThck1.Caption	= RTRIM(tmpFormCaptions.txt1)
						ThisFormSet.frmWOD.lblSz21.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormSet.frmWOD.lblSz21.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormSet.frmWOD.lblSz31.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormSet.frmWOD.lblSz31.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormSet.frmWOD.txtSz3.Visible 	= tmpFormCaptions.use3rdDim
						ThisFormSet.frmWOD.txtSz3.Enabled 	= tmpFormCaptions.Sz3Enable
						ThisFormSet.frmWOD.lblsz41.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormSet.frmWOD.lblsz41.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ENDIF
				ENDIF
			ENDIF
			***************************************
			cForm = PrepareSQLtxt(ThisFormSet.frmWOD.txtFForm.Value,'Form',2)	
			
			IF NOT LEN(ALLTRIM(cForm))=0
				IF GetFormCaptions(cForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
						
						ThisFormSet.frmWOD.lblFThck.Caption	= RTRIM(tmpFormCaptions.txt1)
						ThisFormSet.frmWOD.lblFSz2.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormSet.frmWOD.lblFSz2.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormSet.frmWOD.lblFSz3.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormSet.frmWOD.lblFSz3.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormSet.frmWOD.txtFSz3.Visible 		= tmpFormCaptions.use3rdDim
						ThisFormSet.frmWOD.txtFSz3.Enabled 		= tmpFormCaptions.Sz3Enable
						ThisFormSet.frmWOD.lblFSz4.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormSet.frmWOD.lblFSz4.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
				
		RETURN
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_RTR ADDITIVE
		ENDIF
		
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT() 
	ENDPROC

	PROCEDURE showwo_wodetail
		PARAMETERS nWO_Detail
		*ThisFormSet.ShowWO_WODetail(tmpWO.WO_Detail)
		
		IF VARTYPE(nWO_Detail) != "N"
			MESSAGEBOX("Bad Parameter",0,"No nWO_Detail")
			RETURN .F.
		ENDIF
		
		
		*Get WOs from Choose
		
		
		IF USED('tmpWO_Detail')
		
			SELECT tmpWO_Detail
			LOCATE FOR WO_Detail = nWO_Detail
			
			IF FOUND('tmpWO_Detail')
				ThisFormSet.frmWO.txtWO_Detail.Value = nWO_Detail
				
				ThisFormset.frmWO.txtFPieces.Value	= PrepareSQLnum(tmpWO_Detail.fPieces,'Pieces',-3)
				ThisFormset.frmWO.txtFAlloy.Value	= ShowSQLtxt(tmpWO_Detail.fAlloy,'Alloy',12)
				ThisFormset.frmWO.txtFForm.Value	= ShowSQLtxt(tmpWO_Detail.fForm,'Form',2)
				*ThisFormSet.RefreshFForms(tmpWO_Detail.fForm)
				ThisFormset.frmWO.txtFcc.Value		= ShowSQLtxt(tmpWO_Detail.fCC,'CC',1)
				ThisFormset.frmWO.txtFThck.Value	= PrepareSQLnum(tmpWO_Detail.fThck,'Thck',10,4)
				ThisFormset.frmWO.txtFSz2.Value		= PrepareSQLnum(tmpWO_Detail.fSz2,'Sz2',9,3)
				ThisFormset.frmWO.txtFSz3.Value		= PrepareSQLnum(tmpWO_Detail.fSz3,'Sz3',9,3)
				ThisFormset.frmWO.txtFWeight.Value 	= PrepareSQLnum(tmpWO_Detail.fWeight,'Weight',9,1)
				
				ThisFormSet.frmWO.txtTotFinishW.Value = ThisFormSet.TotalFinishWeight(tmpWO_Detail.WO)
				
				ThisFormSet.frmWO.txtFID_Detail.Value 	= PrepareSQLnum(tmpWO_Detail.fID_Detail,'ID_Detail',-3)
				ThisFormSet.frmWO.txtFID_Detail_Process.Value = PrepareSQLnum(tmpWO_Detail.fID_Detail_Process,'ID_Detail_Process',-3)
				ThisFormSet.frmWO.txtFSOitem.Value		= PrepareSQLtxt(tmpWO_Detail.fSOitem,'SOitem',10)
				ThisFormSet.frmWO.txtFPOitem.Value		= PrepareSQLtxt(tmpWO_Detail.fPOitem,'POitem',12)
				ThisFormSet.frmWO.txtFDescript.Value	= ShowSQLtxt(tmpWO_Detail.fDescript,'Descript',100)
				ThisFormSet.frmWO.txtFDueDate.Value		= PrepareSQLdate(tmpWO_Detail.fDueDate,'DueDate')
				ThisFormSet.frmWO.chkDetail_Complete.Value	= PrepareSQLchk(tmpWO_Detail.fCmplt,'Cmplt')
				
		
		*!*		IF ThisFormSet.CheckFinish_ID_Detail()
		*!*		ENDIF
		*!*		IF ThisFormSet.CheckFinish_ID_Detail_Process()
		*!*		ENDIF
					
			ELSE
				MESSAGEBOX("Could not find WO_Detail:"+ALLTRIM(STR(nWO_Detail)),0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showwo_wod_window
		*ThisFormSet.ShowWO_WOD_Window()
		ThisFormSet.ShowWOD('WONotVisible')
		ThisFormSet.ShowWOD('WODNotVisible')
		ThisFormSet.ShowWO('WONotVisible')
		
		PRIVATE nWO, nWO_Detail, cSOitem
		nWO			= PrepareSQLnum(SalesQuote.WO,'WO',-3) &&Quote.WO, Sales.WO = WO1
		nWO_Detail	= PrepareSQLnum(SalesQuote.WO_Detail,'WO_Detail',-3)  
		cSOItem 	= PrepareSQLtxt(SalesQuote.SoItem_A,'SOitem',10)
		
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item("")
			TrackError("Lost the SOitem","Proper_SO_Item(cSOitem) = Proper_SO_Item('')"+CHR(13)+":"+cSOitem+".",PROGRAM(),LINENO(1))
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF nWO+nWO_Detail = 0
			*Reverse Check, See if WorkOrder has SO 
			*or WorkOrder_Detail has SO
			
			
			
			IF USED('tmpWO_SOitem')
				USE IN tmpWO_SOitem
			ENDIF
		
			cSQL = "SELECT WO FROM dbo.WorkOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOitem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_SOitem')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_SOitem')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF USED('tmpWO_SOitem')
					IF RECCOUNT('tmpWO_SOitem') > 0
						nWO = PrepareSQLnum(tmpWO_SOitem.WO,'WO',-3)
						IF nWO > 0
		*!*						cSQL = "UPDATE dbo.Sales SET WO="+STR(nWO)+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
		*!*						ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
		*!*					
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF 
		*!*						IF nSQLEXEC < 0
		*!*							SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*						ENDIF
							SELECT SalesQuote
							REPLACE SalesQuote.WO WITH nWO
							
						ENDIF
					ENDIF
					USE IN tmpWO_SOitem
				ENDIF
			ENDIF
			
			***************************
			IF USED('tmpWO_SOitem')
				USE IN tmpWO_SOitem
			ENDIF
			
			cSQL = "SELECT WO_Detail FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL + " WHERE fSOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOitem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_SOitem')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_SOitem')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('tmpWO_SOitem')
				IF RECCOUNT('tmpWO_SOitem') > 0
					nWO_Detail = PrepareSQLnum(tmpWO_SOitem.WO_Detail,'WO_Detail',-3)
					IF nWO_Detail > 0
		*!*						cSQL = "UPDATE dbo.Sales SET WO_Detail="+STR(nWO_Detail)+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
		*!*						ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
		*!*					
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF 
		*!*						IF nSQLEXEC < 0
		*!*							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*						ENDIF
						SELECT SalesQuote
						REPLACE SalesQuote.WO_Detail WITH nWO_Detail
		
					ENDIF
		
				ENDIF
				USE IN tmpWO_SOitem
		
			ENDIF
		ENDIF
		************************************
		
		IF nWO > 0
			IF USED('tmpWO')
				USE IN tmpWO
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC 
		
			cSQL = "SELECT * FROM dbo.WorkOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO = "+STR(nWO)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
		
			IF USED('tmpWO')
				ThisFormSet.ShowWO('WOVisible')
				
				ThisFormset.frmWO.txtWO.Value 		= tmpWO.WO
				*ThisFormset.frmWO.txtWO_Detail.Value 		= &&Filled later ShowWO_WODetail(nWO_Detail)
				*WO_Detail not found in WorkOrder table
				ThisFormset.frmWO.txtPieces.Value	= tmpWO.sPieces
				ThisFormset.frmWO.txtAlloy.Value	= tmpWO.sAlloy
				ThisFormset.frmWO.txtForm.Value		= tmpWO.sForm
				*ThisFormSet.RefreshForms(tmpWO.sForm)
				ThisFormset.frmWO.txtCC.Value		= tmpWO.sCC
				ThisFormset.frmWO.txtThck.Value		= tmpWO.sThck
				ThisFormset.frmWO.txtSz2.Value		= tmpWO.sSz2
				ThisFormset.frmWO.txtSz3.Value		= tmpWO.sSz3
				ThisFormset.frmWO.txtWeight.Value	= tmpWO.sWeight
				ThisFormSet.frmWO.txtID_Detail.Value = tmpWO.sID_Detail
				ThisFormSet.frmWO.txtID_Detail_Process.Value = tmpWO.sID_Detail_Process
				ThisFormset.frmWO.txtStartDate.Value	= tmpWO.StartDate
				ThisFormset.frmWO.txtDescript.Value	= tmpWO.Descript
				ThisFormSet.frmWO.txtSOitem.Value	= PrepareSQLtxt(tmpWO.SOitem,'SOitem',10)
				*ThisFormSet.frmWO.txtPOitem.Value	= PrepareSQLtxt(tmpWO.POitem,'POitem',12)
				ThisFormset.frmWO.txtSalesRep.Value	= tmpWO.SalesRep
				
				ThisFormset.frmWO.txtFPieces.Value	= 0
				ThisFormset.frmWO.txtFAlloy.Value	= ''
				ThisFormset.frmWO.txtFForm.Value	= ''
				ThisFormset.frmWO.txtFcc.Value		= ''
				ThisFormset.frmWO.txtFThck.Value	= 0
				ThisFormset.frmWO.txtFSz2.Value		= 0
				ThisFormset.frmWO.txtFSz3.Value		= 0
				
				ThisFormSet.frmWO.txtTotFinishW.Value = 0
				ThisFormset.frmWO.txtFWeight.Value 	= 0
		
				ThisFormSet.frmWO.txtFID_Detail.Value 	= 0
				ThisFormSet.frmWO.txtFID_Detail_Process.Value = 0
				ThisFormSet.frmWO.txtFSOitem.Value		= ''
				ThisFormSet.frmWO.txtFPOitem.Value		= ''
				
				ThisFormSet.frmWO.txtFDescript.Value	= ''
				ThisFormSet.frmWO.txtFDueDate.Value		= CTOD('')
				ThisFormSet.frmWO.chkDetail_Complete.Value	= 0
				
				************************
				PRIVATE nCurrentWOD 
				nCurrentWOD  = 0
				
				IF USED('tmpWO_Detail')
					nCurrentWOD = PrepareSQLnum(tmpWO_Detail.WO_Detail,'WO_Detail',-3)
				ENDIF
		
				PRIVATE cSQL, nSQLEXEC 
		
				IF USED("tmpWO_Detail")	
					USE IN tmpWO_Detail
				ENDIF
				
				cSQL = "SELECT * FROM dbo.WorkOrder_Detail WITH(NOLOCK) WHERE WO="+ALLTRIM(STR(nWO))
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_Detail')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Detail')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
				
				IF USED('tmpWO_Detail')
					IF RECCOUNT('tmpWO_Detail') > 0
						IF nCurrentWOD > 0
							LOCATE FOR WO_Detail = nCurrentWOD 
							IF FOUND('tmpWO_Detail')
								*ThisFormset.frmWO.txtWO_Detail.Value  = PrepareSQLnum(tmpWO_Detail.WO_Detail,'WO_Detail',-3)
							ELSE
								*nCurrentWOD not in table tmpWO_Detail, get top
								GO TOP
								nCurrentWOD = tmpWO_Detail.WO_Detail 
							ENDIF
						ENDIF
					ENDIF
				ELSE
					RETURN
				ENDIF
		
		
				DIMENSION gaWOD_EditSO(1)
				gaWOD_EditSO(1) = 0
				****************************
				IF PrepareSQLnum(tmpWO_Detail.WO_Detail,'WO_Detail',-3) > 0
				
		
					SELECT WO_Detail FROM tmpWO_Detail INTO ARRAY gaWOD_EditSO
					*ThisFormSet.frmWO.lstWO.NumberOfElements = ALEN(gaWOD_EditSO,1)
					ThisFormSet.frmWO.lstWO_Detail.NumberOfElements = ALEN(gaWOD_EditSO,1)
		
					SELECT tmpWO_Detail 				
					IF nCurrentWOD  > 0
						LOCATE FOR WO_Detail = nCurrentWOD 
						IF FOUND()
							*ThisFormset.frmWO.txtWO_Detail.Value  = PrepareSQLnum(tmpWO_Detail.WO_Detail,'WO_Detail',-3)
						ELSE
							GO TOP	
						ENDIF
					ELSE 
						GO TOP
					ENDIF
		
				
					ThisFormSet.frmWO.lstWO_Detail.Value = tmpWO_Detail.WO_Detail 
					ThisFormSet.frmWO.txtWO_Detail.Value = tmpWO_Detail.WO_Detail 
					
					ThisFormSet.ShowWO_WODetail(tmpWO_Detail.WO_Detail)
				ELSE
					ThisFormSet.frmWO.lstWO_Detail.NumberOfElements = 0
				ENDIF
				
				USE IN tmpWO
		
			ENDIF
		ENDIF
		
		IF nWO_Detail > 0
			ThisFormSet.frmWOD.Visible = .T.								
		
		
			IF USED("tmpWO_Detail")	
				USE IN tmpWO_Detail
			ENDIF
			
			cSQL = "SELECT * FROM dbo.WorkOrder_Detail WOD WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.WorkOrder WO WITH(NOLOCK) ON WO.WO = WOD.WO "
			cSQL = cSQL + " WHERE WOD.WO_Detail="+ALLTRIM(STR(nWO_Detail))
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Detail')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
		
			*Get WOs from Choose
			IF USED('tmpWO_Detail')
				IF RECCOUNT('tmpWO_Detail') > 0
					ThisFormSet.ShowWOD('WOVisible')
					
					ThisFormset.frmWOD.txtWO.Value 			= tmpWO_Detail.WO
					ThisFormset.frmWOD.txtWO_Detail.Value 	= tmpWO_Detail.WO_Detail
					ThisFormset.frmWOD.txtPieces.Value		= tmpWO_Detail.sPieces
					ThisFormset.frmWOD.txtAlloy.Value		= tmpWO_Detail.sAlloy
					ThisFormset.frmWOD.txtForm.Value		= tmpWO_Detail.sForm
					*ThisFormSet.RefreshForms(tmpWO_Detail.sForm)
					ThisFormset.frmWOD.txtCC.Value			= tmpWO_Detail.sCC
					ThisFormset.frmWOD.txtThck.Value		= tmpWO_Detail.sThck
					ThisFormset.frmWOD.txtSz2.Value			= tmpWO_Detail.sSz2
					ThisFormset.frmWOD.txtSz3.Value			= tmpWO_Detail.sSz3
					ThisFormset.frmWOD.txtWeight.Value		= tmpWO_Detail.sWeight
					
					ThisFormSet.frmWOD.txtTotFinishW.Value = ThisFormSet.TotalFinishWeight(tmpWO_Detail.WO)
					
					ThisFormSet.frmWOD.txtID_Detail.Value 	= tmpWO_Detail.sID_Detail
					ThisFormSet.frmWOD.txtID_Detail_Process.Value = tmpWO_Detail.sID_Detail_Process
					ThisFormset.frmWOD.txtStartDate.Value	= tmpWO_Detail.StartDate
					ThisFormset.frmWOD.txtDescript.Value	= tmpWO_Detail.Descript
					ThisFormSet.frmWOD.txtSOitem.Value		= PrepareSQLtxt(tmpWO_Detail.SOitem,'SOitem',10)
					ThisFormSet.frmWOD.txtPOitem.Value		= PrepareSQLtxt(tmpWO_Detail.POitem,'POitem',12)
					ThisFormset.frmWOD.txtSalesRep.Value	= tmpWO_Detail.SalesRep
					***
					ThisFormSet.ShowWOD('WODVisible')
					
					ThisFormset.frmWOD.txtFPieces.Value		= PrepareSQLnum(tmpWO_Detail.fPieces,'Pieces',-3)
					ThisFormset.frmWOD.txtFAlloy.Value		= ShowSQLtxt(tmpWO_Detail.fAlloy,'Alloy',12)
					ThisFormset.frmWOD.txtFForm.Value		= ShowSQLtxt(tmpWO_Detail.fForm,'Form',2)
					ThisFormset.frmWOD.txtFcc.Value			= ShowSQLtxt(tmpWO_Detail.fCC,'CC',1)
					ThisFormset.frmWOD.txtFThck.Value		= PrepareSQLnum(tmpWO_Detail.fThck,'Thck',10,4)
					ThisFormset.frmWOD.txtFSz2.Value		= PrepareSQLnum(tmpWO_Detail.fSz2,'Sz2',9,3)
					ThisFormset.frmWOD.txtFSz3.Value		= PrepareSQLnum(tmpWO_Detail.fSz3,'Sz3',9,3)
					ThisFormset.frmWOD.txtFWeight.Value 	= PrepareSQLnum(tmpWO_Detail.fWeight,'Weight',9,1)
		
					ThisFormSet.frmWOD.txtFID_Detail.Value 	= PrepareSQLnum(tmpWO_Detail.fID_Detail,'ID_Detail',-3)
					ThisFormSet.frmWOD.txtFID_Detail_Process.Value = PrepareSQLnum(tmpWO_Detail.fID_Detail_Process,'ID_Detail_Process',-3)
					ThisFormSet.frmWOD.txtFSOitem.Value		= PrepareSQLtxt(tmpWO_Detail.fSOitem,'SOitem',10)
					ThisFormSet.frmWOD.txtFPOitem.Value		= PrepareSQLtxt(tmpWO_Detail.fPOitem,'POitem',12)
		
					ThisFormSet.frmWOD.txtFDescript.Value	= ShowSQLtxt(tmpWO_Detail.fDescript,'Descript',100)
					ThisFormSet.frmWOD.txtFDueDate.Value		= PrepareSQLdate(tmpWO_Detail.fDueDate,'DueDate')
					ThisFormSet.frmWOD.chkDetail_Complete.Value	= PrepareSQLchk(tmpWO_Detail.fCmplt,'Cmplt')
					
				ENDIF
				USE IN tmpWO_Detail
			ENDIF
		ENDIF
		
		ThisFormSet.FormsRefresh()
	ENDPROC

	PROCEDURE show_wod
		PARAMETERS pWhat
		*ThisFormSet.ShowWOD('WOVisible')
		IF pWhat = 'WONotVisible'
			ThisFormset.frmWOD.txtWO.Value 			= 0
			ThisFormset.frmWOD.txtWO_Detail.Value 	= 0
			ThisFormset.frmWOD.txtPieces.Value		= 0
			ThisFormset.frmWOD.txtAlloy.Value		= ''
			ThisFormset.frmWOD.txtForm.Value		= ''
			ThisFormset.frmWOD.txtCC.Value			= ''
			ThisFormset.frmWOD.txtThck.Value		= 0
			ThisFormset.frmWOD.txtSz2.Value			= 0
			ThisFormset.frmWOD.txtSz3.Value			= 0
			ThisFormset.frmWOD.txtWeight.Value		= 0
			ThisFormSet.frmWOD.txtTotFinishW.Value	= 0
			
			ThisFormSet.frmWOD.txtID_Detail.Value 	= 0
			ThisFormSet.frmWOD.txtID_Detail_Process.Value = 0
			ThisFormset.frmWOD.txtStartDate.Value	= CTOD('')
			ThisFormset.frmWOD.txtDescript.Value	= ''
			ThisFormSet.frmWOD.txtSOitem.Value		= ''
			ThisFormSet.frmWOD.txtPOitem.Value		= ''
			ThisFormset.frmWOD.txtSalesRep.Value	= ''
		ENDIF
		
		IF pWhat = 'WODNotVisible'
			ThisFormset.frmWOD.txtFPieces.Value	= 0
			ThisFormset.frmWOD.txtFAlloy.Value	= ''
			ThisFormset.frmWOD.txtFForm.Value	= ''
			ThisFormset.frmWOD.txtFcc.Value		= ''
			ThisFormset.frmWOD.txtFThck.Value	= 0
			ThisFormset.frmWOD.txtFSz2.Value		= 0
			ThisFormset.frmWOD.txtFSz3.Value		= 0
			ThisFormset.frmWOD.txtFWeight.Value 	= 0
		
			ThisFormSet.frmWOD.txtFID_Detail.Value 	= 0
			ThisFormSet.frmWOD.txtFID_Detail_Process.Value = 0
			ThisFormSet.frmWOD.txtFSOitem.Value		= ''
			ThisFormSet.frmWOD.txtFPOitem.Value		= ''
		
			ThisFormSet.frmWOD.txtFDescript.Value	= ''
			ThisFormSet.frmWOD.txtFDueDate.Value		= CTOD('')
			ThisFormSet.frmWOD.chkDetail_Complete.Value	= 0
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpValue')
			USE IN tmpValue
		ENDIF
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		*UniqDBFdel(ThisFormSet.fnSalesTotal)
		
		*IF "WORKORDER" $ SET("CLASSLIB")
		*	RELEASE CLASSLIB libs\WorkOrder
		*ENDIF
	ENDPROC

	PROCEDURE cmdEditWO.Click
		*!*	PRIVATE nWO_Detail,nWO,cPOitem,cSOitem,cInqNumP,lReturn
		*!*	nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		*!*	nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		*!*	cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		*!*	cSOitem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		*!*	cInqNumP = ''
		
		*!*	*DO FORM Forms\WorkOrder WITH "EDIT",nWO,nWO_Detail,cPOitem,cSOitem,cInqNumP 
		
		
		PRIVATE nWO,nWO_D,cPOitem,cSOitem,cInqNumP,lReturn
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_D = 0
		cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)	&&form is frmWOD
		cSOitem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		cInqNumP = ''
		
		IF nWO	> 0
			ThisForm.AlwaysOnTop = .F.
			ThisFormSet.frmEO.AlwaysOnTop = .F.
			
			DO FORM Forms\WorkOrder WITH "EDIT",nWO,nWO_D,cPOitem,cSOitem,'' 
		
			*ThisForm.AlwaysOnTop = .T.
			ThisFormSet.frmEO.AlwaysOnTop = .T.
		ENDIF
	ENDPROC

	PROCEDURE cmdEditWOD.Click
		PRIVATE nWO_Detail,nWO,cPOitem,cSOitem,cInqNumP,lReturn
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		cSOitem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		cInqNumP = ''
		
		IF nWO_Detail > 0
			ThisForm.AlwaysOnTop = .F.
			ThisFormSet.frmEO.AlwaysOnTop = .F.
			
			DO FORM Forms\WorkOrder WITH "EDIT",nWO,nWO_Detail,cPOitem,cSOitem,'' 
		
			*ThisForm.AlwaysOnTop = .T.
			ThisFormSet.frmEO.AlwaysOnTop = .T.
		ENDIF
	ENDPROC

	PROCEDURE lblChooseF_SOitem.Click
		*!*	PRIVATE nSalesNum, cSOItem
		*!*	cSOItem = PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		*!*	nSalesNum = VAL(cSoItem)
		
		*!*	PRIVATE lSelectedTheOnlySOitem
		*!*	lSelectedTheOnlySOitem = .F.
		
		*!*	IF nSalesNum = 0
		*!*		DO FORM Forms\SalesOrder_Select WITH "ChooseSO" TO nSalesNum
		*!*		IF nSalesNum > 0
		*!*			IF Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle, '') = 1
		*!*				lSelectedTheOnlySOitem = .T.		
		*!*				cSOItem = Proper_SO_item(STR(nSalesNum,7)+"-01")
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF nSalesNum > 0 AND NOT lSelectedTheOnlySOitem
		*!*		DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSOItem
		*!*	ENDIF
		
		*!*	IF VARTYPE(cSoItem) = "C"
		*!*		IF Proper_SO_item(cSoItem) = Proper_SO_item('')
		*!*			ThisForm.txtFSOitem.Value = ''
		*!*		ELSE
		*!*			ThisForm.txtFSOitem.Value = cSOItem
		*!*		ENDIF
		*!*	ELSE
		*!*		ThisForm.txtFSOitem.Value = ''
		*!*	ENDIF
	ENDPROC

	PROCEDURE lblChooseS_SOitem.Click
		*!*	PRIVATE cSOItem
		*!*	cSOItem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		
		*!*	PRIVATE lSelectedTheOnlySOitem
		*!*	lSelectedTheOnlySOitem = .F.
		
		*!*	IF ThisFormSet.SalesNum = 0
		*!*		DO FORM Forms\SalesOrder_Select WITH "ChooseSO" TO ThisFormSet.SalesNum
		*!*		IF ThisFormSet.SalesNum> 0
		*!*			IF Count_ItemsinSales (ThisFormSet.SalesNum, ThisFormSet.nConnHandle, '') = 1
		*!*				lSelectedTheOnlySOitem = .T.		
		*!*				cSOItem = Proper_SO_item(STR(ThisFormSet.SalesNum,7)+"-01")
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF NOT lSelectedTheOnlySOitem
		*!*		DO FORM Forms\ChooseSOitem WITH ThisFormSet.SalesNum TO cSOItem
		*!*	ENDIF
		
		*!*	IF VARTYPE(cSoItem) = "C"
		*!*		IF Proper_SO_item(cSoItem) = Proper_SO_item('')
		*!*			ThisForm.txtSOitem.Value = ''
		*!*		ELSE
		*!*			ThisForm.txtSOitem.Value = cSOItem
		*!*		ENDIF
		*!*	ELSE
		*!*		ThisForm.txtSOitem.Value = ''
		*!*	ENDIF
	ENDPROC

	PROCEDURE txtFID_Detail.Click
		PRIVATE nID_Detail,cTBL
		nID_Detail = PrepareSQLnum(ThisForm.txtFID_Detail.Value,'ID_Detail',-3)
		cTBL = "S"
		
		IF nID_Detail > 0
			DO FORM Forms\StockLst_Detail_History WITH nID_Detail,cTBL
		ELSE
			MESSAGEBOX("No Number",16,"Cannot show Detail History")
		ENDIF
	ENDPROC

	PROCEDURE txtFID_Detail_Process.Click
		PRIVATE nID_Detail,cTBL
		nID_Detail = PrepareSQLnum(ThisForm.txtFID_Detail.Value,'ID_Detail',-3)
		cTBL = "S"
		
		IF nID_Detail > 0
			DO FORM Forms\ShowProcess WITH nID_Detail,cTBL
		ELSE
			MESSAGEBOX("No Process Number",16,"Cannot show Detail History")
		ENDIF
	ENDPROC

	PROCEDURE txtID_Detail.Click
		PRIVATE nID_Detail,cTBL
		nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		cTBL = "S"
		
		IF nID_Detail > 0
			DO FORM Forms\StockLst_Detail_History WITH nID_Detail,cTBL
		ELSE
			MESSAGEBOX("No ID_Detail Number",16,"Cannot show Detail History")
		ENDIF
	ENDPROC

	PROCEDURE txtID_Detail_Process.Click
		PRIVATE nID_Detail,cTBL
		nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		cTBL = "S"
		
		IF nID_Detail > 0
			DO FORM Forms\ShowProcess WITH nID_Detail,cTBL
		ELSE
			MESSAGEBOX("No Process Number",16,"Cannot show Detail History")
		ENDIF
	ENDPROC

ENDDEFINE
