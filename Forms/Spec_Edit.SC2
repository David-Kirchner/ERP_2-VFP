		ENDIF
		IF NOT EMPTY(Spec_Check.YMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.YMax,6,3))+' Y Max. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.CbTaMin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CbTaMin,6,3))+' Cb+Ta Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.CbTaMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CbTaMax,6,3))+' Cb+Ta Max. ')
		ENDIF
		
		
		**Check Percentage of NiCo
		******State Chemistry
		
		*Check program exceptions	
		IF NOT EMPTY( Spec_check.Memo )
			INSERT INTO SpecText (SpecText) VALUES ( Spec_check.Memo ) 
			INSERT INTO SpecText (SpecText) VALUES ( REPLICATE(' -',30) )
		ENDIF
		IF NOT EMPTY( Spec_check.exception )
			INSERT INTO SpecText (SpecText) VALUES ( Spec_check.exception ) 
			INSERT INTO SpecText (SpecText) VALUES ( REPLICATE(' -',30) )
		ENDIF
		
		*INSERT INTO SpecText (SpecText) VALUES ( " END "+REPLICATE('. ',27) )
		
		SELECT SpecText
		GO TOP IN SpecText
		
		DO FORM Forms\SpecText
		
		IF USED('SpecText')
			USE IN SpecText
		ENDIF
		
		ThisForm.AlwaysOnTop = .T.
		ThisForm.Refresh
	ENDPROC

