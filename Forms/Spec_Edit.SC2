		ENDIF
		IF NOT EMPTY(Spec_Check.WMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.WMax,6,3))+' W Max. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.WRem)
