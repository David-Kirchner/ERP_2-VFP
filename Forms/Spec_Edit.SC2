	PROCEDURE calcbalance
		PARAMETER m.balelement
		*Thisformset.CalcBalance()
		
		IF TYPE('m.balelement') = 'U'
			=MESSAGEBOX('Need to pass the Element you need the balance to',16,'No parameter')
			RETURN .f.
		ELSE
			m.balelement = ALLTRIM(m.balelement)
			m.balelement = UPPER(LEFT(m.balelement,1))+LOWER(RIGHT(m.balelement,LEN(m.balelement)-1))
		ENDIF
		
		IF !USED('ERPCert')
			=MESSAGEBOX('Data table not in use!',16,'ERPCert not opened.')
			RETURN .f.
		ENDIF
		
		m.eltot = 0
		
		IF m.balelement <> "Al"
			m.eltot = m.eltot + VAL(ERPCert.Al)
		ELSE
			IF VAL(ERPCert.Al) > 0
				=MESSAGEBOX('Al already has a value of '+ERPCert.Al,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Al)
				=MESSAGEBOX('Al is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(ERPCert.B)
		m.eltot = m.eltot + VAL(ERPCert.Be)
		m.eltot = m.eltot + VAL(ERPCert.C)
		m.eltot = m.eltot + VAL(ERPCert.Ca)
		m.eltot = m.eltot + VAL(ERPCert.Cb)
		m.eltot = m.eltot + VAL(ERPCert.Cd)
		m.eltot = m.eltot + VAL(ERPCert.Cl)
		IF m.balelement <> "Co"
			m.eltot = m.eltot + VAL(ERPCert.Co)
		ELSE
			IF VAL(ERPCert.Co) > 0
				=MESSAGEBOX('Co already has a value of '+ERPCert.Co,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Co)
				=MESSAGEBOX('Co is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(ERPCert.Cr)
		IF m.balelement <> "Cu"
			m.eltot = m.eltot + VAL(ERPCert.Cu)
		ELSE
			IF VAL(ERPCert.Cr) > 0
				=MESSAGEBOX('Cr already has a value of '+ERPCert.Cr,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Cr)
				=MESSAGEBOX('Cr is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		IF m.balelement <> "Fe"
			m.eltot = m.eltot + VAL(ERPCert.Fe)
		ELSE
			IF VAL(ERPCert.Fe) > 0
				=MESSAGEBOX('Fe already has a value of '+ERPCert.Fe,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Fe)
				=MESSAGEBOX('Fe is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(ERPCert.H)
		m.eltot = m.eltot + VAL(ERPCert.Hf)
		IF m.balelement <> "Mg"
			m.eltot = m.eltot + VAL(ERPCert.Mg)
		ELSE
			IF VAL(ERPCert.Mg) > 0
				=MESSAGEBOX('Mg already has a value of '+ERPCert.Mg,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Mg)
				=MESSAGEBOX('Mg is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(ERPCert.Mn)
		IF m.balelement <> "Mo"
			m.eltot = m.eltot + VAL(ERPCert.Mo)
		ELSE
			IF VAL(ERPCert.Mo) > 0
				=MESSAGEBOX('Mo already has a value of '+ERPCert.Mo,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Mo)
				=MESSAGEBOX('Mo is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(ERPCert.N)
		m.eltot = m.eltot + VAL(ERPCert.Na)
		IF m.balelement <> "Ni"
			m.eltot = m.eltot + VAL(ERPCert.Ni)
		ELSE
			IF VAL(ERPCert.Ni) > 0
				=MESSAGEBOX('Ni already has a value of '+ERPCert.Ni,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Ni)
				=MESSAGEBOX('Ni is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(ERPCert.O)
		m.eltot = m.eltot + VAL(ERPCert.P)
		IF m.balelement <> "Pb"
			m.eltot = m.eltot + VAL(ERPCert.Pb)
		ELSE
			IF VAL(ERPCert.Pb) > 0
				=MESSAGEBOX('Pb already has a value of '+ERPCert.Pb,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Pb)
				=MESSAGEBOX('Pb is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(ERPCert.S)
		m.eltot = m.eltot + VAL(ERPCert.Si)
		m.eltot = m.eltot + VAL(ERPCert.Sn)
		IF m.balelement <> "Ta"
			m.eltot = m.eltot + VAL(ERPCert.Ta)
		ELSE
			IF VAL(ERPCert.Ta) > 0
				=MESSAGEBOX('Ta already has a value of '+ERPCert.Ta,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Ta)
				=MESSAGEBOX('Ta is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		IF m.balelement <> "Ti"
			m.eltot = m.eltot + VAL(ERPCert.Ti)
		ELSE
			IF VAL(ERPCert.Ti) > 0
				=MESSAGEBOX('Ti already has a value of '+ERPCert.Ti,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.Ti)
				=MESSAGEBOX('Ti is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(ERPCert.U)
		m.eltot = m.eltot + VAL(ERPCert.V)
		IF m.balelement <> "W"
			m.eltot = m.eltot + VAL(ERPCert.W)
		ELSE
			IF VAL(ERPCert.W) > 0
				=MESSAGEBOX('W already has a value of '+ERPCert.W,16,'Cert has the percentage.')
			ENDIF
			IF EMPTY(ERPCert.W)
				=MESSAGEBOX('W is not listed as REM !',16,'Cert field is empty.')
			ENDIF
		ENDIF
		m.eltot = m.eltot + VAL(ERPCert.Y)
		m.eltot = m.eltot + VAL(ERPCert.Zr)
		m.eltot = m.eltot + VAL(ERPCert.CbandTa)
		m.eltot = m.eltot + VAL(ERPCert.NiandCo)
		
		m.eltot = m.eltot + VAL(ERPCert.Other)
		
		
		*=MESSAGEBOX("Balance of "+CHR(13)+m.balelement+" is "+STR((100-m.eltot),5,2)+"%",48,'Found Balance.')
		RETURN 100-m.eltot
		
	ENDPROC

	PROCEDURE checkdata
		*ThisForm.CheckData()
		
		RETURN .T.
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisFormSet.Load_Spec_Check()
		
		SELECT Spec_Check
		
	ENDPROC

	PROCEDURE load_spec_check
		PARAMETERS pWhat
		*ThisFormSet.Load_Spec_Check("REFRESH")
		
		IF VARTYPE(pWhat) = "N"
			nID = pWhat
			pWhat = "GOTO"
		ELSE
			IF VARTYPE(pWhat) != "C"
				pWhat = ""
			ENDIF
		ENDIF
		
		IF UPPER(pWhat) ="REFRESH" OR pWhat = "GOTO"
		*	ThisForm.frmRMA.pf1.pgEdit.Grid1.RecordSource = ''
		*	ThisForm.frmRMA.pf1.pgBrowse.GridBR.RecordSource = ''
			
			IF USED('Spec_Check')
				USE IN Spec_Check
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('Spec_Check')
			SELECT 0
			
			cSQL = "SELECT * FROM dbo.Spec_Check "
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Spec_Check')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Spec_Check')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Spec_check")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Spec_check")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'Spec_Check' )
			ENDIF
		
		ENDIF
		
		IF USED('Spec_Check')
			
			SELECT Spec_Check
			IF UPPER(pWhat) ="REFRESH"
				GO BOTTOM
				ThisFormSet.Spec_Edit.Refresh
			ELSE
				IF pWhat = "GOTO" AND nID > 0
					LOCATE FOR ID=nID
					ThisFormSet.Spec_Edit.Refresh
				ENDIF
			ENDIF
			
			
		ELSE
			MESSAGEBOX('Failed to load Spec_Check',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

	PROCEDURE refreshfind_group
		*ThisFormSet.RefreshFind_Group()
		PRIVATE cGroup, cSpec, cRev
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpSpec_Check_Group')
			SELECT tmpSpec_Check_Group
		ELSE
			SELECT 0
		ENDIF
		
		ThisformSet.frmFind.cmbGroup.Clear
		
		cSQL="SELECT DISTINCT [Group] FROM dbo.Spec_Check "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSpec_Check_Group')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSpec_Check_Group')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSpec_Check_Group")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSpec_Check_Group")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSpec_Check_Group')
		ENDIF
		
		DIMENSION aGroup(1)
		IF USED('tmpSpec_Check_Group')
			SELECT * FROM tmpSpec_Check_Group INTO ARRAY aGroup
			
			USE IN tmpSpec_Check_Group
		ENDIF
		
		ThisformSet.frmFind.cmbGroup.ColumnCount = 1
		ThisformSet.frmFind.cmbGroup.NumberOfElements=ALEN(aGroup)
		ThisformSet.frmFind.cmbGroup.BoundColumn = 1
		
		PRIVATE nLoopCount, cc1
		nLoopCount = 0
		
		FOR EACH cc1 IN aGroup
			IF !EMPTY(cc1)
				ThisformSet.frmFind.cmbGroup.addListitem(ALLTRIM(cc1),nLoopCount,1)
			ENDIF
		ENDFOR
		
		ThisformSet.frmFind.Visible = .T.
		cGroup = Spec_Check.Group
		ThisformSet.frmFind.cmbGroup.Value = Spec_Check.Group
		ThisformSet.frmFind.cmbGroup.Refresh
		
		*******************************************************
		
		ThisFormSet.RefreshFind_Spec()
		
	ENDPROC

	PROCEDURE refreshfind_locate
		*ThisFormSet.RefreshFind_Locate()
		
		PRIVATE cGroup, cSpec, cRev
		cGroup	= ShowSQLtxt(ThisformSet.frmFind.cmbGroup.Value,'Group',10)
		cSpec	= ShowSQLtxt(ThisformSet.frmFind.cmbSpec.Value,'Spec',30)
		cRev	= ShowSQLtxt(ThisformSet.frmFind.cmbRev.Value,'Rev',10)
		
		
		IF EMPTY(cSpec)
		*	MESSAGEBOX("No Spec Selected",48,"Cannot Find")
			RETURN 
		ENDIF
		
		
		SELECT Spec_Check
		LOCATE FOR Group = cGroup AND Spec = cSpec
		
		IF FOUND()
			IF NOT EMPTY(cRev)
				LOCATE FOR Group = cGroup AND Spec = cSpec AND Rev = cRev
				IF FOUND()
					ThisFormSet.Spec_Edit.Refresh
					
		*			ThisformSet.frmFind.cmbSpec.Value = cSpec
		*			ThisformSet.frmFind.cmbRev.Value = cRev
				ELSE
					WAIT WINDOW 'Did not find this Group+Spec+Rev' NOWAIT
					LOCATE FOR Group = cGroup AND Spec = cSpec AND Rev = cRev
					ThisFormSet.Spec_Edit.Refresh
					
		*			Thisform.cmbSpec.Value = cSpec
				ENDIF
			ENDIF
			ThisFormSet.Spec_Edit.Refresh
			
		*	Thisform.cmbSpec.Value = cSpec
		ELSE
			WAIT window 'Did not find this Group+Spec'
			LOCATE FOR Group = cGroup 
			ThisFormSet.Spec_Edit.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE refreshfind_rev
		*ThisFormSet.RefreshFind_Rev()
		PRIVATE cGroup, cSpec, cRev
		cGroup	= ThisformSet.frmFind.cmbGroup.Value 
		cSpec	= ThisFormSet.frmFind.cmbSpec.Value
		
		DIMENSION aRev(1)
		SELECT DISTINCT Spec_check.rev;
		 FROM spec_check;
		 WHERE Spec_check.Group = cGroup;
		 AND Spec_check.Spec = cSpec;
		 ORDER BY Spec_check.Rev;
		 INTO ARRAY aRev
		 
		ThisformSet.frmFind.cmbRev.NumberOfElements = ALEN(aRev)
		
		ThisFormSet.frmFind.cmbRev.Value = Spec_Check.Rev
		ThisFormSet.frmFind.cmbRev.Refresh
		
		*******************************
		
		ThisFormSet.frmFind.grdSpecRev.RecordSource='' 
		
		SELECT DISTINCT Spec_Check.Spec, Spec_Check.Rev;
		 FROM Spec_Check;
		 WHERE Spec_Check.group = cGroup;
		 ORDER BY Spec_Check.Spec, Spec_Check.Rev;
		 INTO CURSOR cursorSpec
		 
		ThisFormSet.frmFind.grdSpecRev.RecordSource = 'cursorSpec'
		
		
	ENDPROC

	PROCEDURE refreshfind_spec
		*ThisFormSet.RefreshFind_Spec()
		PRIVATE cGroup, cSpec, cRev
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		cGroup = ThisformSet.frmFind.cmbGroup.Value 
		
		DIMENSION aSpec(1)
		SELECT DISTINCT Spec_check.spec, Spec_check.rev;
		 FROM spec_check;
		 WHERE Spec_check.group = cGroup;
		 ORDER BY Spec_check.spec, Spec_check.rev;
		 INTO ARRAY aSpec
		 
		ThisFormSet.frmFind.cmbSpec.NumberOfElements = ALEN(aSpec)
		
		cSpec = Spec_Check.Spec
		ThisFormSet.frmFind.cmbSpec.Value = Spec_Check.Spec
		ThisFormSet.frmFind.cmbSpec.Refresh
		
		*******************************************************
		ThisFormSet.RefreshFind_Rev()
		
	ENDPROC

