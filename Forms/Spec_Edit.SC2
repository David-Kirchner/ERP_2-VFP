					cSQL = cSQL + ",Memo='"+cMemo1+"'"
					cSQL = cSQL + ",Exception='"+cException+"'"
					cSQL = cSQL + ",[Who]=(suser_sname())"
					cSQL = cSQL + ",[When]=(getdate())"
					cSQL = cSQL + " WHERE ID = "+STR(nID)
					
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle )
					ELSE
						MESSAGEBOX("Saved to Spec_Check",0,"Update")
						lSpec_Check_saved = .T.
					ENDIF
		
				ENDIF
			ENDIF
		
			IF lSpec_Check_saved
				IF nNewID > 0
					SELECT Spec_Check
					REPLACE ID WITH nNewID 
					
				ENDIF
			ENDIF
		ELSE
			RETURN .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE setediting
		ThisFormSet.isediting=.T.
		ThisFormSet.Spec_Edit.cmdEdit.caption = 'Save'
		ThisFormSet.Spec_Edit.cmdDelete.caption = 'Abort'
		ThisFormSet.Spec_Edit.cmdDelete.enabled = .T.
		ThisFormSet.Spec_Edit.cmdAdd.enabled = .F.
		ThisFormSet.Spec_Edit.cmdClone.enabled = .F.
		ThisFormSet.Spec_Edit.cmdBrowse.enabled = .F.
		ThisFormSet.Spec_Edit.cmdPrint.enabled = .F.
		ThisFormSet.Spec_Edit.cmdClose.enabled = .F.
		ThisFormSet.Spec_Edit.cmdNext.enabled = .F.
		ThisFormSet.Spec_Edit.cmdPrev.enabled = .F.
		ThisFormSet.Spec_Edit.Refresh
		
	ENDPROC

	PROCEDURE setnormal		&& Sets buttons to Normal -Not edit mode.
		ThisFormSet.isediting=.F.
		ThisFormSet.Spec_Edit.cmdEdit.caption = 'Edit'
		ThisFormSet.Spec_Edit.cmdDelete.caption = 'Delete'
		ThisFormSet.Spec_Edit.cmdDelete.enabled = .T.
		ThisFormSet.Spec_Edit.cmdAdd.enabled = .T.
		ThisFormSet.Spec_Edit.cmdClone.enabled = .T.
		ThisFormSet.Spec_Edit.cmdBrowse.enabled = .T.
		ThisFormSet.Spec_Edit.cmdPrint.enabled = .T.
		ThisFormSet.Spec_Edit.cmdClose.enabled = .T.
		ThisFormSet.Spec_Edit.cmdNext.enabled = .T.
		ThisFormSet.Spec_Edit.cmdPrev.enabled = .T.
		ThisFormSet.Spec_Edit.Refresh
		
	ENDPROC

