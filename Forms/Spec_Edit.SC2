	ENDPROC

	PROCEDURE frmFind.cmbGroup.InteractiveChange
		PRIVATE cGroup, cSpec, cRev
		cGroup	= ShowSQLtxt(This.Value,'Group',10)
		cSpec	= ShowSQLtxt(ThisForm.cmbSpec.Value,'Spec',30)
		cRev	= ShowSQLtxt(ThisForm.cmbRev.Value,'Rev',10)
		
		IF EMPTY(cGroup)
			RETURN .F.
		ENDIF
		
		IF EMPTY(cSpec)
			RETURN .F.
		ENDIF
		
		
		SELECT Spec_Check
		LOCATE FOR Group = cGroup AND Spec = cSpec
		
		IF FOUND()
			IF NOT EMPTY(cRev)
				LOCATE FOR Group = cGroup AND Spec = cSpec AND Rev = cRev
				
				IF FOUND()
					ThisFormSet.Spec_Edit.Refresh
				ELSE
		*			WAIT WINDOW 'Did not find this Group+Spec+Rev' NOWAIT
					LOCATE FOR Group = cGroup AND Spec = cSpec AND Rev = cRev
					ThisFormSet.Spec_Edit.Refresh
				ENDIF
			ENDIF
			ThisFormSet.Spec_Edit.Refresh
		ELSE
		*	WAIT window 'Did not find this Group+Spec'
			LOCATE FOR Group = cGroup 
			ThisFormSet.Spec_Edit.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE frmFind.cmbGroup.Valid
