			cMemo1	 	= PrepareSQLtxt(ThisFormSet.Spec_Edit.Memo1.Value,'Memo',-1)
			cexception	= PrepareSQLtxt(ThisFormSet.Spec_Edit.Exception1.Value,'exception',-1)
		
			nID 	= PrepareSQLnum(ThisFormSet.Spec_Edit.txtID.Value,'ID',-3)
			
			
			PRIVATE cSQL, nSQLEXEC 
			IF nID = 0
				*INSERT INTO Spec_Check;
		
				cSQL = "INSERT INTO dbo.Spec_Check "
				cSQL = cSQL + "(ALLOY,[GROUP],SPEC,REV,DESCRIPTION"
				cSQL = cSQL + ",DIAMAX,DIAMIN,UTSMAX,UTSMIN,YLDMAX,YLDMIN,ELMIN,RAMIN"
				cSQL = cSQL + ",BHNMAX,BHNMIN,RCMAX,RCMIN,RBMAX,RBMIN"
				cSQL = cSQL + ",GRAINMAX,GRAINMIN,ALMIN,ALMAX,ALREM"
				cSQL = cSQL + ",BMIN,BMAX,BeMIN,BeMAX,CMIN,CMAX,CbMIN,CbMAX,CoMIN,CoMAX,CoREM"
				cSQL = cSQL + ",CrMIN,CrMAX,CuMIN,CuMAX,CuREM"
				cSQL = cSQL + ",FeMIN,FeMAX,FeREM"
				cSQL = cSQL + ",HMIN,HMAX,MgMIN,MgMAX,MgREM"
				cSQL = cSQL + ",MnMIN,MnMAX,MoMIN,MoMAX,MoREM"
