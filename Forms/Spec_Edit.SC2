		IF NOT EMPTY(Spec_Check.NaMin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.NaMin,6,3))+' Na Min. ')
			ENDIF
		IF NOT EMPTY(Spec_Check.NaMax)
