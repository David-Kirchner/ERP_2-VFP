	PROCEDURE SPEC_EDIT.cmbGroup.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpSpec_Check_Group')
			SELECT tmpSpec_Check_Group
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT DISTINCT [Group] FROM dbo.Spec_Check "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSpec_Check_Group')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSpec_Check_Group')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSpec_Check_Group")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSpec_Check_Group")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSpec_Check_Group')
		ENDIF
		
		DIMENSION aGroup(1)
		*aGroup(1,1) = "1"
		*aGroup(1,2) = "Anneal"
		
		IF USED('tmpSpec_Check_Group')
			SELECT * FROM tmpSpec_Check_Group INTO ARRAY aGroup
			
			USE IN tmpSpec_Check_Group
		ENDIF
		
		This.ColumnCount = 1
		This.NumberOfElements=ALEN(aGroup)
		This.BoundColumn = 1
		*This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		PRIVATE nLoopCount, cc1
		nLoopCount = 0
		*nLoopCount = 0
		
		FOR EACH cc1 IN aGroup
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
		*		IF LEN(ALLTRIM(cc1)) > 1
		*			
		*			this.addListitem(ALLTRIM(cc1),nLoopCount,2)
		*		ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
		*		ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		This.Value = Spec_Check.Group
		
	ENDPROC

	PROCEDURE SPEC_EDIT.cmbGroup.When
		RETURN ThisFormSet.isediting
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdAdd.Valid
		SELECT Spec_Check
		IF NOT HavePermission('EditCert')
			IF NOT HavePermission('EditSpec')
				MESSAGEBOX("You do not have Permission!",0+48,"Cannot Change")
				RETURN
			ENDIF
		ENDIF
		
		ThisFormSet.Spec_Edit.txtID.Value = 0
		ThisFormSet.ResetAddVars()
		
		ThisFormSet.Spec_Edit.Refresh
		WAIT WINDOW 'Ready to edit' NOWAIT
		ThisFormSet.isadding = .T.
		ThisFormSet.SetEditing()
		
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdBrowse.Click
		SELECT Spec_Check
		BROWSE NOEDIT NOAPPEND NODEL
		ThisFormSet.Spec_Edit.Refresh
		
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdClone.Valid
		SELECT Spec_Check
		IF NOT HavePermission('EditCert')
			IF NOT HavePermission('EditSpec')
				MESSAGEBOX("You do not have Permission!",0+48,"Cannot Change")
				RETURN
			ENDIF
		ENDIF
		
		ThisFormSet.Spec_Edit.txtID.Value = 0
		
		ThisFormSet.Spec_Edit.Refresh
		WAIT WINDOW 'Ready to edit' NOWAIT
		ThisFormSet.isadding =.T.
		ThisFormSet.SetEditing() &&cmdEdit.caption = 'Save'
		
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdClose.Click
		ThisForm.Release
		ThisFormSet.Release
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdDelete.Valid
		PRIVATE currec
		IF ThisFormSet.isediting 	&&Do not SAVE
		*	ABORT
			ThisFormSet.isadding = .F.
			ThisFormSet.isediting = .F.
			
			ThisFormSet.SetNormal()
			ThisFormSet.Load_Spec_Check("REFRESH")
			WAIT WINDOW 'Cancelled' NOWAIT	
			
		ELSE   &&do the record delete/recall
			SELECT Spec_Check
			IF EOF() OR BOF()
				WAIT WINDOW 'End of File.' NOWAIT
				RETURN
			ENDIF
		
			PRIVATE nMess
			nMess = MESSAGEBOX("Are you sure you want to Delete this Spec?",4+32,"Delete")
			IF nMess != 6
				RETURN
			ENDIF
			
			IF NOT HavePermission('EditCert')
				IF NOT HavePermission('EditSpec')
					MESSAGEBOX("You do not have Permission!",0+48,"Cannot Change")
					RETURN
				ENDIF
			ENDIF
			
			PRIVATE nID
			nID = PrepareSQLnum(ThisFormSet.Spec_Edit.txtID.Value,'ID',-1)
			
			cSQL = "DELETE FROM dbo.Spec_Check WHERE "
			cSQL = cSQL + " ID = "+STR(nID)
			
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle )
			ENDIF
			
			
			ThisFormSet.Load_spec_check("REFRESH")
			
			
		*	IF !EOF() 
		*		Skip 1
		*	ENDIF
		*	IF EOF()
		*		WAIT WINDOW 'End of file.' NOWAIT
		*		GO BOTTOM
		*	ENDIF
			
			SELECT Spec_Check
			LOCATE FOR ID = nID-1
			
			IF NOT FOUND()
				GOTO RECNO(0)
			ENDIF
			
			ThisFormSet.Spec_Edit.Refresh
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdEdit.Click
		IF ThisFormSet.isediting
		*	SAVE THIS
				
			IF NOT ThisFormSet.SaveAdd()
				=MESSAGEBOX("Record could not be saved, you can edit and try to save again.",16)
			ELSE
				ThisFormSet.isadding =.F.
				ThisFormSet.SetNormal()
				ThisFormSet.Load_spec_check(ThisForm.txtID.Value)
			ENDIF
		ELSE
		*	Start Editting
			SELECT Spec_Check
			IF EOF() OR BOF()
				=MESSAGEBOX('End of File',16)
				RETURN
			ENDIF
		
			IF NOT HavePermission('EditCert')
				IF NOT HavePermission('EditSpec')
					MESSAGEBOX("You do not have Permission!",0+48,"Cannot Change")
					RETURN
				ENDIF
			ENDIF
			
			ThisFormSet.SetEditing()
		
		
		ENDIF
		
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdEdit.Valid
		IF ThisFormSet.isediting
			ThisFormSet.Spec_Edit.ALLOY1.SetFocus()
		ENDIF
		ThisFormSet.Spec_Edit.Refresh
		
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdFind.Click
		ThisFormSet.RefreshFind_Group()
		
		ThisFormSet.frmFind.Visible = .T.
		
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdNext.Click
		SELECT Spec_Check
		IF !EOF()
			SKIP 1
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM
		ENDIF
		ThisFormSet.Spec_Edit.Refresh
		
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdPrev.Click
		SELECT Spec_Check
		IF !BOF()
			SKIP -1
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file' NOWAIT
			GO TOP
		ENDIF
		ThisFormSet.Spec_Edit.Refresh
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdPrint.Valid
		SELECT Spec_Check
		
		PRIVATE nCurrntrecrd
		nCurrntrecrd = recno()
		REPORT FORM Spec_Check RECORD nCurrntrecrd  TO PRINTER PROMPT NOCONSOLE
		GOTO nCurrntrecrd 
	ENDPROC

	PROCEDURE SPEC_EDIT.cmdReview.Valid
		
		IF USED('SpecText')
			USE IN SpecText
		ENDIF
		
		PRIVATE cSafety
		cSafety = SET('Safety')
		SET SAFETY OFF
		
		PRIVATE cFileName
		cFileName = SYS(3)
		SELECT 0
		
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+(cFileName) ) FREE ( SpecText CHAR(60) )
			USE (SYS(5)+SYS(2003)+"\"+cFileName) EXCL ALIAS SpecText
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(cFileName) ) FREE ( SpecText CHAR(60) )
			USE (SYS(5)+SYS(2003)+"\MEM\"+cFileName) EXCL ALIAS SpecText
		ENDIF 
		
		IF cSafety = "ON"
			SET SAFETY ON
		ENDIF
		
		PRIVATE cGroup, cSpec, cRev
		cGroup	= ShowSQLtxt(Spec_Check.Group,'Group',10)
		cSpec	= ShowSQLtxt(Spec_Check.Spec,'Spec',30)
		cRev	= ShowSQLtxt(Spec_Check.Rev,'Rev',10)
		
		PRIVATE m.ChemPass
		PRIVATE m.CertDia,m.CertDiaPass
		PRIVATE m.CertUTS,m.CertUTSPass
		PRIVATE m.CertYLD,m.CertYLDPass
		PRIVATE m.CertEL,m.CertELPass
		PRIVATE m.CertRA,m.CertRAPass
		PRIVATE m.CertBHN,m.CertBHNPass
		PRIVATE m.CertRB,m.CertRBPass
		PRIVATE m.CertRC,m.CertRCPass
		PRIVATE m.CertGrainPass
		PRIVATE m.MechPass
		PRIVATE m.CertAlPass, m.CertAl
		PRIVATE m.CertBPass, m.CertB
		PRIVATE m.CertBePass, m.CertBe
		PRIVATE m.CertCPass, m.CertC
		PRIVATE m.CertCbPass, m.CertCb
		PRIVATE m.CertCoPass, m.CertCo
		PRIVATE m.CertCrPass, m.CertCr
		PRIVATE m.CertCuPass, m.CertCu
		PRIVATE m.CertFePass, m.CertFe
		PRIVATE m.CertHPass, m.CertH
		PRIVATE m.CertMgPass, m.CertMg
		PRIVATE m.CertMoPass, m.CertMo
		PRIVATE m.CertMnPass, m.CertMn
		PRIVATE m.CertNPass, m.CertN
		PRIVATE m.CertNaPass, m.CertNa
		PRIVATE m.CertNbPass, m.CertNb
		PRIVATE m.CertNiPass, m.CertNi
		PRIVATE m.CertOPass, m.CertO
		PRIVATE m.CertPPass, m.CertP
		PRIVATE m.CertSPass, m.CertS
		PRIVATE m.CertSiPass, m.CertSi
		PRIVATE m.CertTaPass, m.CertTa
		PRIVATE m.CertTiPass, m.CertTi
		PRIVATE m.CertVPass, m.CertV
		PRIVATE m.CertWPass, m.CertW
		PRIVATE m.CertYPass, m.CertY
		PRIVATE m.CertCbTaPass, m.CertCbTa
		PRIVATE m.CertNiCoPass, m.CertNiCo
		PRIVATE m.CertFeCrNiPass, m.CertFeCrNi
		
		
		SELECT Spec_Check
		
		m.MechPass = .T.
		
		INSERT INTO SpecText (SpecText) VALUES ( 'Specification: '+ALLTRIM(Spec_Check.Group)+' '+ALLTRIM(Spec_Check.Spec)+' '+ALLTRIM(Spec_Check.Rev) )
		IF NOT EMPTY(Spec_Check.DiaMin)
			INSERT INTO SpecText (SpecText) VALUES ( '   -Spec states Dia '+STR(Spec_Check.DiaMin,8,3)+' Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.DiaMax)
			INSERT INTO SpecText (SpecText) VALUES ( '   -Spec states Dia '+STR(Spec_Check.DiaMax,8,3)+' Max.' )
		ENDIF
		
		IF NOT EMPTY(Spec_Check.UTSMin) 
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.UTSMin))+' UTS Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.UTSMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.UTSMax))+' UTS Max.')
		ENDIF
		IF NOT EMPTY(Spec_Check.YLDMin) 
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.YLDMin))+' Yield Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.YLDMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.YLDMax))+' Yield Max.')
		ENDIF
		IF NOT EMPTY(Spec_Check.ELMin) 
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.ELMin))+' Elongation Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.RAMin) 
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.RAMin))+' RA Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.BHNmin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BHNmin))+' BHN Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.BHNmax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BHNmax))+' BHN Max.')
		ENDIF
		
		IF NOT EMPTY(Spec_Check.Rbmin) 
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rbmin))+' Rb Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.Rbmax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rbmax))+' Rb Max.')
		ENDIF
		IF NOT EMPTY(Spec_Check.Rcmin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rcmin))+' Rc Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.Rcmax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.Rcmax))+' Rc Max.')
		ENDIF
		IF NOT EMPTY(Spec_Check.GrainMin)
			INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Minimum Grain Size of "+ALLTRIM(Spec_Check.GrainMin) )
		ENDIF
		IF NOT EMPTY(Spec_Check.GrainMax)
			INSERT INTO SpecText (SpecText) VALUES ( "Spec requires Maximum Grain Size of "+ALLTRIM(Spec_Check.GrainMax) )
		ENDIF
		******************************************
		******State Mechanicals
		************************&&Check Chemistry*******************************************
		
		INSERT INTO SpecText (SpecText) VALUES ( REPLICATE(' -',30) )
		
		IF NOT EMPTY(Spec_Check.AlMin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.AlMin,6,3))+' Al Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.AlMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.AlMax,6,3))+' Al Max. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.Alrem)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires BALANCE of Al. ")
		ENDIF
		IF NOT EMPTY(Spec_Check.BMin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BMin,6,3))+' B Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.BMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BMax,6,3))+' B Max. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.BeMin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BeMin,6,3))+' Be Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.BeMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.BeMax,6,3))+' Be Max. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.CMin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CMin,6,3))+' C Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.CMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CMax,6,3))+' C Max. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.CbMin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CbMin,6,3))+' Cb Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.CbMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CbMax,6,3))+' Cb Max. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.CoMin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CoMin,6,3))+' Co Min. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.CoMax)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CoMax,6,3))+' Co Max. ')
		ENDIF
		IF NOT EMPTY(Spec_Check.CrMin)
			INSERT INTO SpecText (SpecText) VALUES ( "   -Spec. requires "+ALLTRIM(STR(Spec_Check.CrMin,6,3))+' Cr Min. ')
		ENDIF
