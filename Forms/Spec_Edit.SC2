	PROCEDURE frmFind.grdSpecRev.AfterRowColChange
		LPARAMETERS nColIndex
		
		PRIVATE cGroup, cSpec, cRev
		cGroup	= ThisformSet.frmFind.cmbGroup.Value
		cSpec	= ShowSQLtxt(cursorSpec.Spec,'Spec',30)
		cRev	= ShowSQLtxt(cursorSpec.Rev,'Rev',10)
		
		DIMENSION aRev(1)
		SELECT DISTINCT Spec_check.rev;
		 FROM spec_check;
		 WHERE Spec_check.Group = cGroup;
		 AND Spec_check.Spec = cSpec;
		 ORDER BY Spec_check.Rev;
		 INTO ARRAY aRev
		 
		ThisformSet.frmFind.cmbRev.NumberOfElements = ALEN(aRev)
		
		ThisFormSet.frmFind.cmbRev.Value = Spec_Check.Rev
		ThisFormSet.frmFind.cmbRev.Refresh
		
		****************************
		Thisform.cmbSpec.Value = cSpec
		ThisForm.cmbRev.Value = cRev
		
		ThisFormSet.RefreshFind_Locate()
		
		
	ENDPROC

	PROCEDURE frmFind.Init
		ThisForm.Top = 10
		ThisForm.Left = 10
		
		
		Public ARRAY aGroup(1)
		SELECT DISTINCT Spec_check.group;
		 FROM spec_check;
		 ORDER BY Spec_check.group;
		 INTO ARRAY aGroup
		ThisForm.cmbGroup.Value = aGroup(aLen(aGroup))
		 
		PUBLIC ARRAY aSpec(1)
		SELECT DISTINCT Spec_check.spec;
		 FROM spec_check;
		 WHERE Spec_check.group = ThisForm.cmbGroup.Value;
		 ORDER BY Spec_check.spec;
		 INTO ARRAY aSpec
		ThisForm.cmbSpec.Value = aSpec(aLen(aSpec)) 
		
		PUBLIC ARRAY aRev(1)
		SELECT DISTINCT Spec_check.Rev;
		 FROM spec_check;
		 WHERE Spec_check.group = ThisForm.cmbGroup.Value;
		 AND Spec_Check.Spec = ThisForm.cmbSpec.Value;
		 ORDER BY Spec_check.Rev;
		 INTO ARRAY aSpec
		ThisForm.cmbSpec.Value = aSpec(aLen(aSpec)) 
		
		*!*	PUBLIC ARRAY aRev(1)
		*!*	SELECT DISTINCT Spec_check.Rev;
		*!*	 FROM spec_check;
		*!*	 WHERE Spec_check.group = ThisForm.cmbGroup.Value;
		*!*	 AND Spec_check.Spec = ThisForm.cmbSpec.Value;
		*!*	 ORDER BY Spec_check.Rev;
		*!*	 INTO ARRAY aRev
		*!*	ThisForm.cmbRev.Value = aSpec(aLen(aSpec)) 
		
		IF USED('ERPCert')
			ThisForm.txtAlloy.Value = ShowSQLtxt(ERPCert.Alloy,'Alloy',12)
			ThisForm.txtHeatLot.Value = ALLTRIM(ShowSQLtxt(ERPCert.Heat,'Heat',50))
			IF ERPCert.Lot > 0
				ThisForm.txtHeatLot.Value = ALLTRIM(ERPCert.Heat)+' HPA '+STR(ERPCert.Lot,4,0)
			ENDIF
			ThisForm.txtSpec.Value 	= ShowSQLtxt(ERPCert.Spec,'Spec',-1)
			ThisForm.txtSpec2.Value = ShowSQLtxt(ERPCert.Spec2,'Spec',50)
			
			IF EMPTY(ThisForm.txtSpec2.Value)
				ThisForm.txtSpec2.Value	= ShowSQLtxt(ERPCert.SpecLMA,'SpecLMA',40)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmFind.Load
		
		IF NOT used('Spec_check')
		*	USE Spec_Check SHARED IN 0
			
			IF USED('Spec_check')	
				USE IN Spec_check
			ENDIF
			
			cSQL = "SELECT * FROM dbo.Spec_Check WITH(NOLOCK) "
				
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Spec_check')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Spec_check')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Spec_check")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Spec_check")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'Spec_check')
				RETURN
			ENDIF
		
		
			IF NOT used('Spec_check')
				=MESSAGEBOX('File Spec_Check not loadded !',16,'Fatal ERROR')
				return .f.
			ENDIF
			
		ELSE
			
		ENDIF
		SELECT Spec_Check
		
		
	ENDPROC

	PROCEDURE SPEC_EDIT.Activate
		SELECT Spec_Check
	ENDPROC

	PROCEDURE SPEC_EDIT.ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisFormSet.nConnHandle)
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE SPEC_EDIT.ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE SPEC_EDIT.ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy,  ThisFormSet.nConnHandle)
			
			IF NOT EMPTY(cAlloyStandard)
				
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				MESSAGEBOX("Use Quotes-Alloys Standard program to add a new Alloy.",0+64,"Unkown Alloy.")
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

