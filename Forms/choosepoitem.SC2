	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		CASE tmpPOitems.cancelled
			nColor = RGB( 255, 0, 0 ) &&RED	
		CASE tmpPOitems.delivered
			nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pnHpaPo
		*DO FORM Forms\ChoosePOitem WITH 502770 TO cPoItem
		*DO FORM Forms\ChoosePOitem WITH '' TO cPoItem  &&Pass as Character to Select All
		*ALSO TRY
		*DO FORM Forms\SelectPO_item TO cPOItem
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF USED("tmpPOitems")
			USE IN tmpPOitems
		ENDIF
		
		IF TYPE("pnHpaPo") = "N"
			ThisForm.Caption = ThisForm.Caption+" for PO#"+ALLTRIM(STR( pnHpaPo ))
			
			IF USED('tmpPOitems')
				USE IN tmpPOitems
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT POitem,SoItem,dbo.f_SalesPDescription(SalesP,Cover) AS SalesMan,Company,Alloy,Pieces"
			cSQL = cSQL + ",LEFT(dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Order_Qty,RandLen),40) AS Description,Cond_Spec,heat,OrderDate"
			cSQL = cSQL + ",Received,delivered,cancelled,Due_Min,Due_Max,Cmplt "
			cSQL = cSQL + " FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE HpaPo = "+STR(pnHpaPo)+""
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOitems')
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitems")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitems")
				ENDDO
			ENDIF
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOitems' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitems")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitems")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOitems' )
			ENDIF
		
		*!*		IF USED('tmpPOitems')
		*!*		  GO BOTTOM
		*!*		  IF RECCOUNT('tmpPOitems') > 10
		*!*		  	SKIP -10
		*!*		  ENDIF 
		*!*		ENDIF
		*!*		
		ELSE
			*****
			IF USED('tmpPOitems')
				USE IN tmpPOitems
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT TOP 1000 POitem,SoItem,dbo.f_SalesPDescription(SalesP,Cover) AS SalesMan,Company,Alloy,Pieces,"
			cSQL = cSQL + " LEFT(dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Order_Qty,RandLen),40) AS Description,Cond_Spec,heat,OrderDate,"
			cSQL = cSQL + ",Received,delivered,cancelled,Due_Min,Due_Max,Cmplt "
			cSQL = cSQL + " FROM dbo.PurchaseOrder "
			cSQL = cSQL + " ORDER BY HPApo DESC " && Go to Bottom!
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOitems')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOitems' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitems")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitems")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOitems' )
			ENDIF
		
			IF USED('tmpPOitems')
			  GO TOP
			ENDIF
		ENDIF
		
		*ThisForm.grid.RecordSource = "tmpPOitems"
		ThisForm.grdSOitem.RecordSource = "tmpPOitems"
		*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		********************************
		ThisForm.grdSOitem.Column1.Controlsource = "tmpPOitems.POitem"
		ThisForm.grdSOitem.Column2.Controlsource = "tmpPOitems.SoItem"
		ThisForm.grdSOitem.Column3.Controlsource = "tmpPOitems.SalesMan"
		ThisForm.grdSOitem.Column4.Controlsource = "tmpPOitems.Company"
		ThisForm.grdSOitem.Column5.Controlsource = "tmpPOitems.Alloy"
		ThisForm.grdSOitem.Column6.Controlsource = "tmpPOitems.Pieces"
		ThisForm.grdSOitem.Column7.Controlsource = "tmpPOitems.Description"
		ThisForm.grdSOitem.Column8.Controlsource = "tmpPOitems.Cond_Spec"
		ThisForm.grdSOitem.Column9.Controlsource = "tmpPOitems.Heat"
		ThisForm.grdSOitem.Column10.Controlsource = "tmpPOitems.OrderDate"
		ThisForm.grdSOitem.Column11.Controlsource = "tmpPOitems.Received"
		ThisForm.grdSOitem.Column12.Controlsource = "tmpPOitems.Delivered"
		ThisForm.grdSOitem.Column13.Controlsource = "tmpPOitems.Cancelled"
		
		ThisForm.grdSOitem.Column1.Header1.Caption = "POitem"
		ThisForm.grdSOitem.Column2.Header1.Caption= "SoItem"
		ThisForm.grdSOitem.Column3.Header1.Caption= "SalesMan"
		ThisForm.grdSOitem.Column4.Header1.Caption= "Company"
		ThisForm.grdSOitem.Column5.Header1.Caption= "Alloy"
		ThisForm.grdSOitem.Column6.Header1.Caption= "Pieces"
		ThisForm.grdSOitem.Column7.Header1.Caption= "Description"
		ThisForm.grdSOitem.Column8.Header1.Caption= "Cond_Spec"
		ThisForm.grdSOitem.Column9.Header1.Caption= "Heat"
		ThisForm.grdSOitem.Column10.Header1.Caption= "OrderDate"
		ThisForm.grdSOitem.Column11.Header1.Caption= "Received"
		ThisForm.grdSOitem.Column12.Header1.Caption= "Delivered"
		ThisForm.grdSOitem.Column13.Header1.Caption= "Cancelled"
			
		********************************
		
		ThisForm.Refresh_POitem()
		
		
		
		IF RECCOUNT("tmpPOitems") = 1
		*	ThisForm.cmdSelect.Click()  *Does Not Work here
		*	ThisForm.HoldNumber = tmpPOitems.PoItem
		*	ThisForm.Release    
		*	RETURN ThisForm.HoldNumber
			
		*	RETURN ThisForm.HoldNumber
			
			*RETURN .F.
			*CANCEL				&&Does not send the Return cPOitem
			
		ELSE
			IF RECCOUNT("tmpPOitems") = 0
				*MESSAGEBOX("Sorry, PO number not Found",32,"No records to Show!")
				WAIT WINDOW "Sorry, PO number not Found" NOWAIT
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVEF
		ENDIF 
		
		ThisForm.OrigTable = ALIAS()
		
	ENDPROC

	PROCEDURE refreshscreen
	ENDPROC

	PROCEDURE refresh_poitem
		*ThisForm.Refresh_POitem
		
		ThisForm.txtAlloy.Value			= tmpPOitems.Alloy
		ThisForm.txtDescription.Value	= tmpPOitems.Description
		ThisForm.txtHeat.Value			= tmpPOitems.Heat
		
		ThisForm.txtDue_Min.Value	= PrepareSQLdate(tmpPOitems.Due_Min,'Due_Min',.T.,.T.)
		ThisForm.txtDue_Max.Value	= PrepareSQLdate(tmpPOitems.Due_Max,'Due_Max',.T.,.T.)
		ThisForm.txtReceived.Value	= PrepareSQLdate(tmpPOitems.Received,'Received',.T.,.T.)
		ThisForm.lblCmplt.Visible	= PrepareSQLlogic(tmpPOitems.Cmplt,'Cmplt')
		ThisForm.lblCancelled.Visible	= PrepareSQLlogic(tmpPOitems.Cancelled,'Cancelled')
		
	ENDPROC

	PROCEDURE Resize
		PRIVATE nHigh, nWidth
		
		nHigh = ThisForm.Height - 281
		nWidth = ThisForm.Width - 592
		
		ThisForm.grdSOitem.Width = 580 + nWidth
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmpPOitems')
			USE IN tmpPOitems
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE cHoldNumber
		*cHoldNumber = ""
		cHoldNumber = tmpPOitems.PoItem
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE grdSOitem.AfterRowColChange
		LPARAMETERS nColIndex
		*ThisForm.RefreshScreen()
		ThisForm.Refresh_POitem()
		
		
		
	ENDPROC

ENDDEFINE
