	ADD OBJECT 'cmdSave' AS commandbutton WITH ;
		Caption = "Save && sync", ;
		Height = 27, ;
		Left = 380, ;
		Name = "cmdSave", ;
		Top = 478, ;
		Width = 100
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grdRole' AS grid WITH ;
		ColumnCount = 4, ;
		DeleteMark = .F., ;
		Height = 410, ;
		Left = 12, ;
		Name = "grdRole", ;
		RecordMark = .F., ;
		RecordSource = "", ;
		ScrollBars = 3, ;
		Top = 48, ;
		Width = 752, ;
		Column1.ControlSource = "", ;
		Column1.Name = "clmArea", ;
		Column1.ReadOnly = .T., ;
		Column1.Width = 110, ;
		Column2.ControlSource = "", ;
		Column2.Name = "clmDisplay", ;
		Column2.ReadOnly = .T., ;
		Column2.Width = 280, ;
		Column3.ControlSource = "", ;
		Column3.Name = "clmAccess", ;
		Column3.ReadOnly = .T., ;
		Column3.Width = 70, ;
		Column4.ControlSource = "", ;
		Column4.CurrentControl = "chkGranted", ;
		Column4.Name = "clmGranted", ;
		Column4.ReadOnly = .F., ;
		Column4.Sparse = .F., ;
		Column4.Width = 70
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'grdRole.clmAccess.Header1' AS header WITH ;
		Caption = "Access", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdRole.clmAccess.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1", ;
		ReadOnly = .T.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdRole.clmArea.Header1' AS header WITH ;
		Caption = "Area", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdRole.clmArea.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1", ;
		ReadOnly = .T.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdRole.clmDisplay.Header1' AS header WITH ;
		Caption = "SQL role", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdRole.clmDisplay.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1", ;
