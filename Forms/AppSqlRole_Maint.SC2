	*< OBJECTDATA: ObjPath="grdRole" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRole.clmArea.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRole.clmArea.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRole.clmDisplay.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRole.clmDisplay.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRole.clmAccess.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRole.clmAccess.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRole.clmGranted.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRole.clmGranted.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdRole.clmGranted.chkGranted" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAll" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdNone" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdReload" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSave" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdClose" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: cselectedlogin
		*p: nappuserid
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		Caption = "SQL Database Roles (ERP_* Layer 1)"
		cselectedlogin = ""
		DoCreate = .T.
		Height = 540
		Icon = graphics\earth-globe.ico
		Name = "frmAppSqlRole_maint"
		nappuserid = 0
		nconnhandle = 0
		Width = 780
		WindowType = 1
	*</PropValue>

