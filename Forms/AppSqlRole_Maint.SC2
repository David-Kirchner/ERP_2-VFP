	ADD OBJECT 'grdRole.clmGranted.chkGranted' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "", ;
		Name = "chkGranted", ;
		ReadOnly = .F.
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'grdRole.clmGranted.Header1' AS header WITH ;
		Caption = "Member", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdRole.clmGranted.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1", ;
		ReadOnly = .T., ;
		Visible = .F.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'lblUser' AS label WITH ;
		Caption = "Windows login:", ;
		Height = 17, ;
		Left = 12, ;
		Name = "lblUser", ;
		Top = 14, ;
		Width = 92
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE ConfigureGrid
		WITH This.grdRole
			.clmArea.ControlSource = "csrSqlRole.area"
			.clmDisplay.ControlSource = "csrSqlRole.display"
			.clmAccess.ControlSource = "csrSqlRole.accesslvl"
			WITH .clmGranted
				.ControlSource = "granted"
				.Sparse = .F.
				.ReadOnly = .F.
				.CurrentControl = "chkGranted"
				.Text1.Visible = .F.
				.chkGranted.Caption = ""
			ENDWITH
		ENDWITH
	ENDPROC

	PROCEDURE Destroy
		IF USED("csrSqlRole")
			USE IN csrSqlRole
		ENDIF
		IF USED("csrAppUsers")
			USE IN csrAppUsers
		ENDIF
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		
	ENDPROC

	PROCEDURE EnsureRoleCursor
		IF USED("csrSqlRole")
			IF TYPE("csrSqlRole.granted") # "L"
				USE IN csrSqlRole
			ENDIF
		ENDIF
		IF NOT USED("csrSqlRole")
			CREATE CURSOR csrSqlRole (rolename C(128), area C(50), display C(120), accesslvl C(10), granted L)
		ENDIF
	ENDPROC

	PROCEDURE Init
		This.EnsureRoleCursor()
		This.nConnHandle = get_SQLSTRINGCONNECT()
		IF NOT This.TableExists("AppSqlRole")
			MESSAGEBOX("Run MEM\SQL\Config\05_AppSqlRole_Schema.sql on this server first.", 48, "SQL Database Roles")
			RETURN .F.
		ENDIF
		This.LoadUserList()
		This.LoadRoleCatalog()
		This.grdRole.RecordSource = "csrSqlRole"
		This.ConfigureGrid()
		IF This.cboUser.ListCount > 0
			This.cboUser.ListIndex = 1
			This.UserPicked()
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO PROGS\proc_setup ADDITIVE
		ENDIF
		This.EnsureRoleCursor()
	ENDPROC

	PROCEDURE LoadRoleCatalog
		LOCAL lcSQL, lnRet
		This.EnsureRoleCursor()
		SELECT csrSqlRole
		ZAP
		lcSQL = "SELECT RoleName, AreaName, DisplayName, AccessLevel "
		lcSQL = lcSQL + "FROM dbo.AppSqlRole WITH (NOLOCK) "
		lcSQL = lcSQL + "WHERE Active = 1 "
		lcSQL = lcSQL + "ORDER BY SortOrder, RoleName"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpSqlRoleCat")
		IF NOT This.SqlOk(lnRet, lcSQL)
			RETURN
		ENDIF
		IF NOT USED("tmpSqlRoleCat")
			RETURN
		ENDIF
		SELECT tmpSqlRoleCat
		GO TOP
		SCAN
			INSERT INTO csrSqlRole (rolename, area, display, accesslvl, granted) ;
				VALUES (ALLTRIM(tmpSqlRoleCat.RoleName), ;
				ALLTRIM(tmpSqlRoleCat.AreaName), ;
				ALLTRIM(tmpSqlRoleCat.DisplayName), ;
				ALLTRIM(tmpSqlRoleCat.AccessLevel), .F.)
		ENDSCAN
		USE IN tmpSqlRoleCat
		SELECT csrSqlRole
		GO TOP
	ENDPROC

	PROCEDURE LoadUserGrants
		LOCAL lcLogin, lcSQL, lnRet, lcRole
		lcLogin = ALLTRIM(This.cSelectedLogin)
		IF EMPTY(lcLogin) OR NOT USED("csrSqlRole")
			RETURN
		ENDIF
		SELECT csrSqlRole
		REPLACE ALL granted WITH .F.
		lcSQL = "SELECT RoleName FROM dbo.AppSqlRoleGrant WITH (NOLOCK) "
		lcSQL = lcSQL + "WHERE LTRIM(RTRIM(WindowsLogin)) = "+This.SqlQuote(lcLogin)+" "
		lcSQL = lcSQL + "AND Granted = 1"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpSqlRoleGrant")
		IF lnRet > 0 AND USED("tmpSqlRoleGrant")
			SELECT tmpSqlRoleGrant
			GO TOP
			SCAN
				lcRole = UPPER(ALLTRIM(tmpSqlRoleGrant.RoleName))
				SELECT csrSqlRole
				GO TOP
				LOCATE FOR UPPER(ALLTRIM(rolename)) == lcRole
				IF FOUND()
					REPLACE granted WITH .T.
				ENDIF
			ENDSCAN
			USE IN tmpSqlRoleGrant
		ENDIF
		SELECT csrSqlRole
		GO TOP
		This.grdRole.RecordSource = ""
		This.grdRole.RecordSource = "csrSqlRole"
		This.ConfigureGrid()
		This.grdRole.Refresh()
	ENDPROC

	PROCEDURE LoadUserList
		LOCAL lcSQL, lnRet, lcDisp, lcLogin
		lcSQL = "SELECT Id, WindowsLogin, ISNULL(DisplayName, WindowsLogin) AS DisplayName "
		lcSQL = lcSQL + "FROM dbo.AppUsers WITH (NOLOCK) "
		lcSQL = lcSQL + "WHERE Active = 1 "
		lcSQL = lcSQL + "ORDER BY WindowsLogin"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "csrAppUsers")
		IF NOT This.SqlOk(lnRet, lcSQL)
			RETURN
		ENDIF
		This.cboUser.Clear()
		SELECT csrAppUsers
		GO TOP
		SCAN
			lcLogin = ALLTRIM(csrAppUsers.WindowsLogin)
			lcDisp = ALLTRIM(csrAppUsers.DisplayName)
			lnRow = This.cboUser.ListCount + 1
			This.cboUser.AddListItem(lcLogin, lnRow, 1)
			This.cboUser.AddListItem(lcDisp, lnRow, 2)
		ENDSCAN
	ENDPROC

	PROCEDURE SaveUserGrants
		LOCAL lcLogin, lcSQL, lnRet, lcRole, lcModBy, lnSync, lcMsg
		lcLogin = ALLTRIM(This.cSelectedLogin)
		IF EMPTY(lcLogin)
			MESSAGEBOX("Select a Windows login first.", 48, "SQL Database Roles")
			RETURN
		ENDIF
		IF This.nConnHandle < 1
			This.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		lcModBy = ALLTRIM(RIGHT(SYS(0), LEN(SYS(0)) - AT("#", SYS(0)) - 1))
		lcSQL = "DELETE FROM dbo.AppSqlRoleGrant WHERE WindowsLogin = "
		lcSQL = lcSQL + This.SqlQuote(lcLogin)
		lnRet = SQLEXEC(This.nConnHandle, lcSQL)
		IF lnRet < 0
			SQLEXECError(lcSQL, This.nConnHandle, lnRet, "AppSqlRole_maint")
			RETURN
		ENDIF
		SELECT csrSqlRole
		SCAN FOR granted
			lcRole = ALLTRIM(csrSqlRole.rolename)
			lcSQL = "INSERT INTO dbo.AppSqlRoleGrant (AppUserId, WindowsLogin, RoleName, Granted, ModifiedBy) "
			lcSQL = lcSQL + "VALUES ("
			IF This.nAppUserId > 0
				lcSQL = lcSQL + ALLTRIM(STR(This.nAppUserId))+", "
			ELSE
				lcSQL = lcSQL + "NULL, "
			ENDIF
			lcSQL = lcSQL + This.SqlQuote(lcLogin)+", "
			lcSQL = lcSQL + This.SqlQuote(lcRole)+", 1, "
			lcSQL = lcSQL + This.SqlQuote(lcModBy)+")"
			lnRet = SQLEXEC(This.nConnHandle, lcSQL)
			IF lnRet < 0
				SQLEXECError(lcSQL, This.nConnHandle, lnRet, "AppSqlRole_maint")
				RETURN
			ENDIF
		ENDSCAN
		lcSQL = "EXEC dbo.usp_AppSqlRole_SyncLogin "
		lcSQL = lcSQL + This.SqlQuote(lcLogin)+", "
		lcSQL = lcSQL + This.SqlQuote(lcModBy)
		lnSync = SQLEXEC(This.nConnHandle, lcSQL)
		IF lnSync < 0
			SQLEXECError(lcSQL, This.nConnHandle, lnSync, "AppSqlRole_maint")
			lcMsg = "Grants saved to AppSqlRoleGrant but SQL role sync failed."+CHR(13)
			lcMsg = lcMsg + "Ensure the Windows login exists on this SQL instance."
			MESSAGEBOX(lcMsg, 48, "SQL Database Roles")
			RETURN
		ENDIF
		MESSAGEBOX("Saved and synced SQL role membership for:"+CHR(13)+lcLogin, 64, "SQL Database Roles")
		This.LoadUserGrants()
	ENDPROC

	PROCEDURE SqlOk
		LPARAMETERS tnRet, tcSQL
		IF tnRet < 1
			SQLEXECError(tcSQL, This.nConnHandle, tnRet, "AppSqlRole_maint")
			RETURN .F.
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE SqlQuote
		LPARAMETERS tcVal
		IF VARTYPE(tcVal) # "C"
			tcVal = TRANSFORM(tcVal)
		ENDIF
		RETURN "N'" + STRTRAN(ALLTRIM(tcVal), "'", "''") + "'"
	ENDPROC

	PROCEDURE TableExists
		LPARAMETERS tcTable
		LOCAL lnRet, lcSQL
		lcSQL = "SELECT OBJECT_ID('dbo."+tcTable+"','U') AS ObjId"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpSqlRoleObj")
		IF lnRet > 0 AND USED("tmpSqlRoleObj") AND !ISNULL(tmpSqlRoleObj.ObjId)
			USE IN tmpSqlRoleObj
			RETURN .T.
		ENDIF
		IF USED("tmpSqlRoleObj")
			USE IN tmpSqlRoleObj
		ENDIF
		RETURN .F.
	ENDPROC

	PROCEDURE UserPicked
		LOCAL lcLogin
		lcLogin = ALLTRIM(Thisform.cboUser.Value)
		Thisform.cSelectedLogin = lcLogin
		Thisform.nAppUserId = 0
		IF USED("csrAppUsers")
			SELECT csrAppUsers
			LOCATE FOR ALLTRIM(WindowsLogin) == lcLogin
			IF FOUND()
				Thisform.nAppUserId = csrAppUsers.Id
			ENDIF
		ENDIF
		Thisform.LoadUserGrants()
	ENDPROC

	PROCEDURE cboUser.InteractiveChange
		Thisform.UserPicked()
	ENDPROC

	PROCEDURE cboUser.Valid
		Thisform.UserPicked()
		RETURN .T.
	ENDPROC

	PROCEDURE cmdAll.Click
		SELECT csrSqlRole
		REPLACE ALL granted WITH .T.
		GO TOP
		Thisform.grdRole.Refresh()
	ENDPROC

	PROCEDURE cmdClose.Click
		IF USED("csrSqlRole")
			USE IN csrSqlRole
		ENDIF
		IF USED("csrAppUsers")
			USE IN csrAppUsers
		ENDIF
		Thisform.Release()
	ENDPROC

	PROCEDURE cmdNewUser.Click
		LOCAL lcLogin, lcDisp, lcSQL, lnRet
		lcLogin = ALLTRIM(INPUTBOX("Windows login (ComputerName\user):", "New AppUsers row", ""))
		IF EMPTY(lcLogin)
			RETURN
		ENDIF
		lcDisp = ALLTRIM(INPUTBOX("Display name:", "New AppUsers row", lcLogin))
		IF EMPTY(lcDisp)
			lcDisp = lcLogin
		ENDIF
		lcSQL = "IF NOT EXISTS (SELECT 1 FROM dbo.AppUsers WHERE WindowsLogin = "
		lcSQL = lcSQL + Thisform.SqlQuote(lcLogin)+") "
		lcSQL = lcSQL + "INSERT INTO dbo.AppUsers (WindowsLogin, AppRole, DisplayName, Active) "
		lcSQL = lcSQL + "VALUES ("+Thisform.SqlQuote(lcLogin)+", N'ReadOnly', "
		lcSQL = lcSQL + Thisform.SqlQuote(lcDisp)+", 1)"
		lnRet = SQLEXEC(Thisform.nConnHandle, lcSQL)
		IF lnRet < 0
			SQLEXECError(lcSQL, Thisform.nConnHandle, lnRet, "AppSqlRole_maint")
			RETURN
		ENDIF
		Thisform.LoadUserList()
		Thisform.cboUser.Value = lcLogin
		Thisform.UserPicked()
	ENDPROC

	PROCEDURE cmdNone.Click
		SELECT csrSqlRole
		REPLACE ALL granted WITH .F.
		GO TOP
		Thisform.grdRole.Refresh()
	ENDPROC

	PROCEDURE cmdReload.Click
		Thisform.LoadRoleCatalog()
		Thisform.LoadUserGrants()
	ENDPROC

	PROCEDURE cmdSave.Click
		IF MESSAGEBOX("Save role membership for "+ALLTRIM(Thisform.cSelectedLogin)+ ;
			" and apply to SQL Server?", 4+32, "SQL Database Roles") = 6
			Thisform.SaveUserGrants()
		ENDIF
	ENDPROC

ENDDEFINE
