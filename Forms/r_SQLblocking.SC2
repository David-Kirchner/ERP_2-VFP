DEFINE CLASS frmsqlblocking AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdQuit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdDATA" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdKill" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: getsqldata
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Locks and Blocking Process"
		DataSession = 2
		DoCreate = .T.
		Height = 253
		Left = 0
		MinHeight = 253
		MinWidth = 692
		Name = "frmSQLblocking"
		nconnhandle = 0
		Top = 0
		Width = 872
	*</PropValue>

	ADD OBJECT 'cmdKill' AS commandbutton WITH ;
		Caption = "Kill", ;
		Height = 27, ;
		Left = 569, ;
		Name = "cmdKill", ;
		TabIndex = 6, ;
		Top = 216, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdQuit' AS commandbutton WITH ;
		Caption = "Quit", ;
		Height = 27, ;
		Left = 655, ;
		Name = "cmdQuit", ;
		TabIndex = 7, ;
		Top = 216, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grdDATA' AS grid WITH ;
		BackColor = 255,255,255, ;
		DeleteMark = .F., ;
		Height = 201, ;
		Left = 1, ;
		Name = "grdDATA", ;
		TabIndex = 1, ;
		Top = 3, ;
		Width = 863
		*< END OBJECT: BaseClass="grid" />
	
	PROCEDURE getsqldata
		*ThisForm.GetSQLData()
		
		IF USED('tmpData')
			ThisForm.grdDATA.RecordSource = ''
			
			USE IN tmpData
		ENDIF
		
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL="SELECT db.name DBName,"
		cSQL=cSQL+" tl.request_session_id,"
		cSQL=cSQL+" wt.blocking_session_id,"
		cSQL=cSQL+" OBJECT_NAME(p.OBJECT_ID) BlockedObjectName,"
		cSQL=cSQL+" tl.resource_type,"
		cSQL=cSQL+" h1.TEXT AS RequestingText,"
		cSQL=cSQL+" h2.TEXT AS BlockingTest,"
		cSQL=cSQL+" tl.request_mode "
		cSQL=cSQL+" FROM sys.dm_tran_locks AS tl "
		cSQL=cSQL+" INNER JOIN sys.databases db ON db.database_id = tl.resource_database_id "
		cSQL=cSQL+" INNER JOIN sys.dm_os_waiting_tasks AS wt ON tl.lock_owner_address = wt.resource_address "
		cSQL=cSQL+" INNER JOIN sys.partitions AS p ON p.hobt_id = tl.resource_associated_entity_id "
		cSQL=cSQL+" INNER JOIN sys.dm_exec_connections ec1 ON ec1.session_id = tl.request_session_id "
		cSQL=cSQL+" INNER JOIN sys.dm_exec_connections ec2 ON ec2.session_id = wt.blocking_session_id "
		cSQL=cSQL+" CROSS APPLY sys.dm_exec_sql_text(ec1.most_recent_sql_handle) AS h1 "
		cSQL=cSQL+" CROSS APPLY sys.dm_exec_sql_text(ec2.most_recent_sql_handle) AS h2 "
		
		WAIT WINDOW "Please Wait. (90 seconds on Peregrine) " NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpData')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpData')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpData")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpData")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpData')
		ENDIF
		IF USED('tmpData')
			IF RECCOUNT('tmpData') > 0
				ThisForm.grdDATA.RecordSource = 'tmpData'
		*		ThisForm.grdDATA.Column1.DynamicBackColor = "IIF(ISNULL(ShipONDate),RGB(255,255,255),RGB(255,255,0))"
		*		ThisForm.grdDATA.Column9.DynamicBackColor = "IIF(CTOD(ShipDate)<DATE(),RGB(255,255,255),RGB(255,0,0))"
				ThisForm.cmdKill.Enabled  = .T.
			ELSE
				MESSAGEBOX("Did not find a Block",0+48,"No Data")
				ThisForm.cmdKill.Enabled  = .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		*PARAMETERS pSalesP
		
		
		ThisForm.GetSQLData()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_Setup" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE Resize
		nNewH = This.Height - 253
		nNewW = This.Width - 770 &&692
		
		ThisForm.grdDATA.Height = 204 + nNewH
		ThisForm.cmdKill.Top = 216 + nNewH
		ThisForm.cmdQuit.Top = 216 + nNewH
		
		ThisForm.grdDATA.Width = 764 + nNewW   &&684
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpData')
			USE IN tmpData
		ENDIF
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdKill.Click
		PRIVATE nBlocking_Session_ID
		
		nBlocking_Session_ID = tmpDATA.blocking_session_id
		
		IF MESSAGEBOX(" Are you sure you want to KILL "+ALLTRIM(STR(nBlocking_Session_ID))+" ?",4+32,"Kill Blocking Process") = 6
			cSQL = "KILL "+ALLTRIM(STR(nBlocking_Session_ID))
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				MESSAGEBOX( cSQL, 0+64,"Complete")
				
				ThisForm.GetSQLData()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

ENDDEFINE
