					ThisForm.txtElongation6.Value	= PrepareSQLnum(tmpNEW.Elongation6,'Elongation',4,1)
					ThisForm.txtRed_area6.Value 	= PrepareSQLnum(tmpNEW.Red_Area6,'Red_Area',4,1)
