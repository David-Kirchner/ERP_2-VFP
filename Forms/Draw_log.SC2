	PROCEDURE txtLot.Valid
		PRIVATE nCurlot, cCurheat
		nCurlot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		cCurheat = PrepareSQLtxt(ThisForm.txtHEAT.Value,'Heat',50)
		
		IF nCurlot > 0 
		  *LOCATE FOR Draw_log.lot = m.curlot AND NOT Draw_log.heat = m.curheat
		  
			IF USED('tmpCountLot')	
				USE IN tmpCountLot
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Draw_log "
			cSQL = cSQL + " WHERE Lot ="+STR(nCurLot)
			cSQL = cSQL + " AND Heat NOT LIKE '"+ALLTRIM(cCurHeat)+"%'"
			cSQL = cSQL + " AND LEN(Heat) > 0 "
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
			ELSE
				IF USED('tmpCountLot')
					IF tmpCountLot.Cntd > 0
					
						MESSAGEBOX( 'You can not have the same Lot# for different Heats -any key',0+48,"Bad Lot Number")
						USE IN tmpCountLot 
						RETURN .F.
					ENDIF
					USE IN tmpCountLot 
				ENDIF
			ENDIF
		
		ENDIF
		
	ENDPROC

