	PROCEDURE txtLab.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		
		IF NOT USED('Draw_Labs')
			ThisForm.Load_Draw_labs()
		ENDIF
		
		IF !EMPTY(lcSearchStr)
			SEEK UPPER(lcSearchStr) ORDER TAG UppLAB IN Draw_Labs
		
			IF FOUND("Draw_Labs")
			
		*	lcSearchStr2 =SUBSTR(Alloys.Alloy,1,lnInsertionPt)
			
				IF UPPER(lcSearchStr) = SUBSTR(Draw_Labs.LAB,1,lnInsertionPt)
					THIS.VALUE=Draw_Labs.LAB
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

