	PROCEDURE lblUTpass.Click
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpUTlog")
			USE IN tmpUTlog
		ENDIF
		cSQL = "SELECT UTpass,[Operator],[comment],[Who],[When] FROM dbo.UTlog "
		cSQL = cSQL + " WHERE LogType = 'Draw_log'"
		cSQL = cSQL + " AND LogID = "+STR(Draw_log.ID)
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUTlog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUTlog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpUTlog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpUTlog")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpUTlog')
		ENDIF
		
		
		IF USED("tmpUTlog")
			IF VARTYPE(tmpUTlog.UTPass)='L'
				PRIVATE cUTmess
				cUTmess =           "UT Pass:"+IIF(tmpUTlog.UTpass,'Yes','No')+CHR(13)
				cUTmess = cUTmess + "Operator:"+tmpUTlog.Operator+CHR(13)
				cUTmess = cUTmess + "Whose PC:"+tmpUTlog.Who+CHR(13)
				cUTmess = cUTmess + "Date :"+TTOC(tmpUTlog.When)+CHR(13)
				cUTmess = cUTmess + "Comment:"+LEFT(tmpUTlog.Comment,100)
				MESSAGEBOX(cUTmess,0+64,'UT Details')
			ELSE
				MESSAGEBOX('No details.',0+64,'UT Details')
			ENDIF
			USE IN tmpUTlog
		ELSE
			MESSAGEBOX('No details.',0+64,'UT Details')
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		
	ENDPROC

