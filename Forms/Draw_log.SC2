	PROCEDURE txtHeat.Valid
		PRIVATE nCurlot, cCurheat, nID
		nCurlot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		cCurheat = PrepareSQLtxt(This.Value,'Heat',50)
		nID		= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		IF nCurlot > 0 AND LEN(cCurheat) > 0 AND nID > 0
		  *LOCATE FOR Draw_log.lot = m.curlot AND NOT Draw_log.heat = m.curheat
		  
			IF USED('tmpCountLot')	
				USE IN tmpCountLot
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Draw_log "
			cSQL = cSQL + " WHERE Lot ="+STR(nCurLot)
			cSQL = cSQL + " AND Heat NOT LIKE '"+ALLTRIM(cCurHeat)+"%'"
			*cSQL = cSQL + " AND ID="+STR(nID)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
			ELSE
				IF USED('tmpCountLot')
					IF tmpCountLot.Cntd > 0
						*Save new Heat
						*MESSAGEBOX( )
						PRIVATE nMess
						nMess = MESSAGEBOX("Do you want to SAVE changes to heat? (Y)"+CHR(13)+"Heat "+cCurHeat+CHR(13)+"Answer (No) if this was a mistake.",4+32,"Found change in Heat")
						IF nMess = 6
							PRIVATE cSQL
							cSQL = "UPDATE dbo.Draw_log SET "
							cSQL = cSQL +" Heat='"+cCurHeat+"'"
							cSQL = cSQL + " WHERE ID="+STR(nID)
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
							ELSE
								WAIT WINDOW 'Updated Heat!' NOWAIT
							ENDIF
							
						ENDIF				
						
					ENDIF
					USE IN tmpCountLot 
				ENDIF
			ENDIF
		
		ENDIF
		
	ENDPROC

