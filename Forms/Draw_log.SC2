	PROCEDURE cmdWODrtr.Click
		IF ThisForm.isediting
			MESSAGEBOX("Please Save your Edit, then go to RTR",16,"Cannot continue")
			RETURN
		ENDIF
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF nWO_Detail = 0
			MESSAGEBOX("The Router needs a WO Detail number!",48,"Cannot get to Router")
			RETURN .F.
		ENDIF
		
		PRIVATE biRTR_ID
		biRTR_ID = PrepareSQLnum(ThisForm.lblRTR_ID.Caption,'rtr_ID',-4)
		
		PRIVATE cCaption, biRTR_ID
		biRTR_ID = PrepareSQLnum(ThisForm.lblRTR_ID.Caption,'rtr_ID',-4)
		cCaption = "for Draw lot "+ALLTRIM(STR( PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3) ))
		
		IF biRTR_ID > 0
			DO FORM Forms\Router WITH "EDIT","WO_Detail",nWO_Detail, ThisForm.Top, ThisForm.Left+10+ThisForm.Width, cCaption
		ELSE
			DO FORM Forms\Router WITH "ADD","WO_Detail",nWO_Detail
		ENDIF
		
		
		
		
		
	ENDPROC

	PROCEDURE cmgGfm_calc.Valid
		*FIND L2 BY DIA'S AND L1
		
		private m.cutfctr,m.Tflength
		PRIVATE nslength,nssize,nDrawSize,nflength 
		PRIVATE ncutfctr, nfpiece, nspiece, nColdwork
		
		nslength = ThisForm.txtSlength.Value
		nssize = ThisForm.txtSsize.Value
		nDrawSize = ThisForm.txtDrawSize.Value
		nflength  = ThisForm.txtFlength.Value
		
		nfpiece = ThisForm.txtFpiece.Value
		nspiece = ThisForm.txtSpiece.Value
		ncoldwork = ThisForm.txtColdWork.Value
		
		*SELECT Draw_log 
		IF nslength > 0 AND nssize > 0 AND nDrawSize >0 AND nflength = 0
		  m.Tflength=nssize*nssize*nslength/(nDrawSize*nDrawSize)
		  *REPLACE flength WITH VAL( STR( m.Tflength ,8,0) )
		  ThisForm.txtfLength.Value = VAL( STR( m.Tflength ,8,0) )
		  IF (nspiece > 0 AND nfpiece > 0) AND (nspiece <> nfpiece)
		    ncutfctr = nfpiece / nspiece
		    IF INT(ncutfctr) = ncutfctr
		      *REPLACE flength WITH  flength / ncutfctr
		      ThisForm.txtfLength.Value =  nFlength / ncutfctr
		    ELSE
		      WAIT WINDOW 'Length is based on no cuts'
		    ENDIF
		  ENDIF
		*  ThisForm.flength.Refresh
		ENDIF
		*FIND RA BY DIA'S
		IF nssize > 0 AND nDrawSize >0 AND ncoldwork = 0
			PRIVATE na1, na2
			na1= 3.14156*nssize*nssize/4
			na2= 3.14156*nDrawSize*nDrawSize/4
		
			nColdWork = (na1-na2)/na1
		  	IF nColdWork < 1
				ThisForm.txtColdwork.Value = nColdWork
			ENDIF
		ENDIF
		ThisForm.Refresh()
	ENDPROC

