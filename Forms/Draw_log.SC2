	PROCEDURE txtSalesnum.Valid
		PRIVATE nSalesNum, nItemSO
		nSalesNum	= ThisForm.txtSalesNum.Value
		nItemSO		= ThisForm.txtItemSO.Value
		
		SELECT Draw_log
		IF nSalesNum > 0 AND nItemSO > 0
			SELECT Draw_log
			cSOItem = Proper_So_Item( STR(nSalesNum)+"-"+IIF(nItemSO<10,"0"+STR(nItemSO,1,0), STR(nItemSO,2,0) ))
		*	ThisForm.txtItemSO.Value = cSOitem
		ENDIF
	ENDPROC

	PROCEDURE txtSalesnum.When
