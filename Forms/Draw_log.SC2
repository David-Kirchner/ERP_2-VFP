					ThisForm.txtRed_area.Value 	= PrepareSQLnum(tmpNEW.Red_Area,'Red_Area',4,1)
					ThisForm.txtRockwell.Value 	= ShowSQLtxt(tmpNEW.Rockwell,'Rockwell',4)
					ThisForm.txtBHN.Value 		= PrepareSQLnum(tmpNEW.BHN,'BHN',3,0)
					ThisForm.txttLoc.Value		= ShowSQLtxt(tmpNEW.tLoc,'tLoc',1)
					
					ThisForm.txtTensile2.Value 		= PrepareSQLnum(tmpNEW.Tensile2,'Tensile',6,0)
					ThisForm.txtYield2.Value 		= PrepareSQLnum(tmpNEW.Yield2,'Yield',6,0)
					ThisForm.txtElongation2.Value	= PrepareSQLnum(tmpNEW.Elongation2,'Elongation',4,1)
