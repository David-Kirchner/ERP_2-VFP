		*ThisForm.txtTestPO.Value 	= Draw_log.TestPO
		*ThisForm.txtTestPoItem.Value= Draw_log.TestPOitem
		ThisForm.txtTestPO.Value	= VAL(FixPOitem(Draw_log.TestPO, Draw_log.TestItemPO, Draw_log.TestPOitem))
		ThisForm.txtTestItemPO.Value= PrepareSQLnum(Draw_log.TestItemPO,'ItemPO',2,0)
		IF Proper_PO_item(Draw_log.TestPOitem) != Proper_PO_item('')
			ThisForm.txtTestPoItem.Value= ShowSQLtxt(Draw_log.TestPOitem,'POitem',12)
			
			IF ThisForm.txtTestPO.Value > 0
				IF ThisForm.txtTestItemPO.Value = 0
					ThisForm.txtTestItemPO.Value = VAL(RIGHT(Draw_log.TestPOitem,2))
				ENDIF
			ENDIF
		ELSE
			IF ThisForm.txtTestPO.Value > 0
				IF ThisForm.txtTestItemPO.Value = 0
					ThisForm.txtTestItemPO.Value = VAL(RIGHT(Draw_log.TestPOitem,2))
				ENDIF
				ThisForm.txtTestPoItem.Value = FixPOitem(Draw_log.TestPO, Draw_log.TestItemPO, Draw_log.TestPOitem)
			ELSE
				ThisForm.txtTestPoItem.Value = ''
			ENDIF
		ENDIF
					
		ThisForm.txtTestSent.Value 	= IIF(Draw_log.TestSent=CTOD('12/30/1899'), CTOD("  /  /  "),TTOD(Draw_log.TestSent))
		ThisForm.txtLab.Value		= Draw_log.Lab
		ThisForm.txtMinutes.Value 	= Draw_log.Minutes
		ThisForm.cmbMachine.Value	= Draw_log.Machine
		
		ThisForm.txtTensile.Value 	= PrepareSQLnum(Draw_log.Tensile,'Tensile',6,0)
		ThisForm.txtYield.Value 	= PrepareSQLnum(Draw_log.Yield,'Yield',6,0)
		ThisForm.txtElongation.Value= PrepareSQLnum(Draw_log.Elongation,'Elongation',4,1)
		ThisForm.txtRed_area.Value 	= PrepareSQLnum(Draw_log.Red_Area,'Red_Area',4,1)
		ThisForm.txtRockwell.Value 	= PrepareSQLtxt(Draw_log.Rockwell,'Rockwell',4)
		ThisForm.txtBHN.Value 		= PrepareSQLnum(Draw_log.BHN,'BHN',3,0)
		ThisForm.txttLoc.Value 		= PrepareSQLtxt(Draw_log.tLoc,'tLoc',1)
		
		ThisForm.txtTensile2.Value 		= PrepareSQLnum(Draw_log.Tensile2,'Tensile',6,0)
		ThisForm.txtYield2.Value 		= PrepareSQLnum(Draw_log.Yield2,'Yield',6,0)
		ThisForm.txtElongation2.Value	= PrepareSQLnum(Draw_log.Elongation2,'Elongation',4,1)
		ThisForm.txtRed_area2.Value 	= PrepareSQLnum(Draw_log.Red_Area2,'Red_Area',4,1)
		ThisForm.txtRockwell2.Value 	= PrepareSQLtxt(Draw_log.Rockwell2,'Rockwell',4)
		ThisForm.txtBHN2.Value 			= PrepareSQLnum(Draw_log.BHN2,'BHN',3,0)
		ThisForm.txttLoc2.Value 		= PrepareSQLtxt(Draw_log.tLoc2,'tLoc',1)
		
		ThisForm.txtTensile3.Value 		= PrepareSQLnum(Draw_log.Tensile3,'Tensile',6,0)
		ThisForm.txtYield3.Value 		= PrepareSQLnum(Draw_log.Yield3,'Yield',6,0)
		ThisForm.txtElongation3.Value	= PrepareSQLnum(Draw_log.Elongation3,'Elongation',4,1)
		ThisForm.txtRed_area3.Value 	= PrepareSQLnum(Draw_log.Red_Area3,'Red_Area',4,1)
		ThisForm.txtRockwell3.Value 	= PrepareSQLtxt(Draw_log.Rockwell3,'Rockwell',4)
		ThisForm.txtBHN3.Value 			= PrepareSQLnum(Draw_log.BHN3,'BHN',3,0)
		ThisForm.txttLoc3.Value 		= PrepareSQLtxt(Draw_log.tLoc3,'tLoc',1)
		
		ThisForm.txtTensile4.Value 		= PrepareSQLnum(Draw_log.Tensile4,'Tensile',6,0)
		ThisForm.txtYield4.Value 		= PrepareSQLnum(Draw_log.Yield4,'Yield',6,0)
		ThisForm.txtElongation4.Value	= PrepareSQLnum(Draw_log.Elongation4,'Elongation',4,1)
		ThisForm.txtRed_area4.Value 	= PrepareSQLnum(Draw_log.Red_Area4,'Red_Area',4,1)
		*ThisForm.txtRockwell4.Value 	= PrepareSQLtxt(Draw_log.Rockwell4,'Rockwell',4)
		*ThisForm.txtBHN4.Value 			= PrepareSQLnum(Draw_log.BHN4,'BHN',3,0)
		ThisForm.txttLoc4.Value 		= PrepareSQLtxt(Draw_log.tLoc4,'tLoc',1)
		
		ThisForm.txtTensile5.Value 		= PrepareSQLnum(Draw_log.Tensile5,'Tensile',6,0)
		ThisForm.txtYield5.Value 		= PrepareSQLnum(Draw_log.Yield5,'Yield',6,0)
		ThisForm.txtElongation5.Value	= PrepareSQLnum(Draw_log.Elongation5,'Elongation',4,1)
		ThisForm.txtRed_area5.Value 	= PrepareSQLnum(Draw_log.Red_Area5,'Red_Area',4,1)
		*ThisForm.txtRockwell5.Value 	= PrepareSQLtxt(Draw_log.Rockwell5,'Rockwell',4)
		*ThisForm.txtBHN5.Value 			= PrepareSQLnum(Draw_log.BHN5,'BHN',3,0)
		ThisForm.txttLoc5.Value 		= PrepareSQLtxt(Draw_log.tLoc5,'tLoc',1)
		
		ThisForm.txtTensile6.Value 		= PrepareSQLnum(Draw_log.Tensile6,'Tensile',6,0)
		ThisForm.txtYield6.Value 		= PrepareSQLnum(Draw_log.Yield6,'Yield',6,0)
		ThisForm.txtElongation6.Value	= PrepareSQLnum(Draw_log.Elongation6,'Elongation',4,1)
		ThisForm.txtRed_area6.Value 	= PrepareSQLnum(Draw_log.Red_Area6,'Red_Area',4,1)
		*ThisForm.txtRockwell6.Value 	= PrepareSQLtxt(Draw_log.Rockwell5,'Rockwell',4)
		*ThisForm.txtBHN6.Value 			= PrepareSQLnum(Draw_log.BHN5,'BHN',3,0)
		ThisForm.txttLoc6.Value 		= PrepareSQLtxt(Draw_log.tLoc6,'tLoc',1)
		
		ThisForm.txtTensile7.Value 		= PrepareSQLnum(Draw_log.Tensile7,'Tensile',6,0)
		ThisForm.txtYield7.Value 		= PrepareSQLnum(Draw_log.Yield7,'Yield',6,0)
		ThisForm.txtElongation7.Value	= PrepareSQLnum(Draw_log.Elongation7,'Elongation',4,1)
		ThisForm.txtRed_area7.Value 	= PrepareSQLnum(Draw_log.Red_Area7,'Red_Area',4,1)
		*ThisForm.txtRockwell7.Value 	= PrepareSQLtxt(Draw_log.Rockwell7,'Rockwell',4)
		*ThisForm.txtBHN7.Value 			= PrepareSQLnum(Draw_log.BHN7,'BHN',3,0)
		ThisForm.txttLoc7.Value 		= PrepareSQLtxt(Draw_log.tLoc7,'tLoc',1)
		
		ThisForm.txtAC_ID.Value = PrepareSQLnum(Draw_log.AC_ID,'AC_ID',-3)
		
		ThisForm.chkPassed.Value 		= IIF(ISNULL(Draw_log.Passed),.F.,Draw_log.Passed)
		ThisForm.chkCustomerMat.Value 	= IIF(ISNULL(Draw_log.CustomerMat),.F.,Draw_log.CustomerMat)
		ThisForm.chkChart.Value 		= IIF(ISNULL(Draw_log.Chart),.F.,Draw_log.Chart)
		ThisForm.txtHTRockwell.Value 	= IIF(ISNULL(Draw_log.HTRockwell),'',Draw_log.HTRockwell)
		ThisForm.txtHTBHN.Value 		= IIF(ISNULL(Draw_log.HTBHN),0,Draw_log.HTBHN)
		ThisForm.txtID.Value			= Draw_log.ID
		ThisForm.txtOper.Value			= PrepareSQLtxt(Draw_log.Oper,'Oper',10)
		ThisForm.txtLMA_Practice.Value	= PrepareSQLtxt(Draw_log.LMA_Practice,'LMA_Practice',7)
		ThisForm.txtLMA_Procedure.Value	= PrepareSQLtxt(Draw_log.LMA_Procedure,'LMA_Procedure',12)
		
		
		IF ISNULL(Draw_log.ChartData) 
			ThisForm.cmdChartData.Caption = "Add"
		ELSE
			IF Draw_log.ChartData
				ThisForm.cmdChartData.Caption = "Export"
			ELSE
				ThisForm.cmdChartData.Caption = "Add"
			ENDIF
		ENDIF
		
		*This is a common 'Bad SQL Connetion' initiation point
		ThisForm.nConnHandle = CheckSQLConnection(ThisForm.nConnHandle)
		
		IF USED('tmpShip')
			USE IN tmpShip
		ENDIF
		
		IF NOT ISNULL( Draw_log.SOitem )
			IF VAL(RIGHT( Draw_log.SOitem,2 ))>1
				
				cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+Draw_log.SOitem+"')"
				SELECT 0
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShip' )
				ENDIF
					
				IF USED('tmpShip')
					ThisForm.txtCompany.Value	= tmpShip.Company
					ThisForm.txtSalesP.Value	= tmpShip.SalesP
					IF tmpShip.DueDate > CTOD('12/30/1900')
						ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
					ELSE
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ENDIF
					
					IF tmpShip.ShipDate > CTOD('12/30/1900')
						ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
					ELSE
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
					USE IN tmpShip
				ELSE &&USED('tmpShip')
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&Not Item Number
				IF Draw_log.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(Draw_log.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&Draw_log.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			
			ENDIF
		ELSE  &&ISNULL( Draw_log.SOitem )
			IF NOT ISNULL(Draw_log.SalesNum)
				IF Draw_log.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(Draw_log.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&Draw_log.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&ISNULL(Draw_log.SalesNum)
				ThisForm.txtCompany.Value	= ''
				ThisForm.txtSalesP.Value	= ''
				ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
				ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
			ENDIF
		ENDIF
		
		PRIVATE lnUT
		lnUT = UTresult( Draw_log.ID ,"Draw_log", ThisForm.nConnHandle)
		IF EMPTY(lnUT)
			*Null
			ThisForm.lblUTpass.Visible = .F.
		ELSE
			IF lnUT > 0
				*True
				ThisForm.lblUTpass.Caption = "Pass"
				ThisForm.lblUTpass.Visible = .T.
				ThisForm.lblUTpass.ForeColor = RGB(0,0,0)
				ThisForm.lblUTpass.BackColor = RGB(0,191,96)
		
			ELSE
				IF lnUT <0 
					*False
					ThisForm.lblUTpass.Caption = "Fail"
					ThisForm.lblUTpass.Visible = .T.
					ThisForm.lblUTpass.ForeColor = RGB(0,0,0)
					ThisForm.lblUTpass.BackColor = RGB(255,0,0)
				ENDIF
			ENDIF
		ENDIF
		
		
		ThisForm.DupLots()
		
		SELECT Draw_log
		
		********
		IF WEXIST("frmLog_Detail")
			RELEASE WINDOWS frmLog_Detail
		ENDIF
		
		PRIVATE nTop, nLeft
		nTop = ThisForm.Top
		nLeft = ThisForm.Left + ThisForm.Width 
		DO FORM Forms\Log_Detail WITH "Draw_log", Draw_log.ID, ThisForm.nConnHandle, nTop, nLeft
		
		*
		********
		IF WEXIST("frmDraw_Hard_Prof")
			RELEASE WINDOWS frmDraw_Hard_Prof
		ENDIF
		
		PRIVATE nTop, nLeft
		nTop = ThisForm.Top+250
		nLeft = ThisForm.Width
		*DO FORM Forms\Draw_Hard_Prof WITH Draw_log.ID, ThisForm.nConnHandle, nTop, nLeft
		
		*********
		
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		ThisForm.lblRTR_ID.Caption = "rtr ID"
		IF nWO_Detail > 0
		
			cSQL = "SELECT ID FROM dbo.rtr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO_Detail = "+STR(nWO_Detail)
		
			IF USED("tmpRTRidWO")	
				USE IN tmpRTRidWO
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTRidWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTRidWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRTRidWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRTRidWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRTRidWO')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpRTRidWO')
				IF RECCOUNT('tmpRTRidWO') > 0
					biRTR_ID = PrepareSQLnum(tmpRTRidWO.ID,'rtr_ID',-4)
					ThisForm.lblRTR_ID.Caption = STR(biRTR_ID)
				ENDIF
				USE IN tmpRTRidWO
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refresh_draw_log
		*ThisForm.Refresh_Draw_log()
		SELECT Draw_log
		
		**Edits here also need to be done in GetLatestData()
		ThisForm.txtAlloyName.Value = Draw_log.AlloyName
		ThisForm.txtDate.Value 		= TTOD(Draw_log.Date)
		ThisForm.txtHeat.Value 		= Draw_log.Heat
		ThisForm.txtLot.Value 		= Draw_log.Lot
		ThisForm.txtSpiece.Value 	= Draw_log.sPiece
		ThisForm.txtFpiece.Value 	= Draw_log.fPiece
		ThisForm.txtSsize.Value 	= Draw_log.sSize
		ThisForm.txtDrawSize.Value 	= Draw_log.DrawSize
		ThisForm.txtSlength.Value 	= Draw_log.sLength
		ThisForm.txtFsize.Value 	= Draw_log.fSize
		ThisForm.txtSweight.Value 	= Draw_log.sWeight
		ThisForm.txtFlength.Value 	= Draw_log.fLength
		ThisForm.txtCondition.Value = Draw_log.Condition
		ThisForm.txtColdWork.Value 	= Draw_log.ColdWork
		ThisForm.txtSpec.Value 		= Draw_log.Spec
		ThisForm.txtHTreat.Value 	= Draw_log.Htreat
		ThisForm.txtSalesNum.Value 	= Draw_log.SalesNum
		ThisForm.txtItemSO.Value 	= Draw_log.ItemSO
		ThisForm.txtOvenTemp.Value 	= Draw_log.OvenTemp
		ThisForm.txtPO.Value 		= Draw_log.PO
		ThisForm.txtWO_Detail.Value = Draw_log.WO_Detail
		ThisForm.txtProjID.Value	= Draw_log.ProjID
		ThisForm.edtNotes.Value 	= Draw_log.Notes
		ThisForm.txtSrvcPO.Value 	= Draw_log.SrvcPO
		*ThisForm.txtTestPO.Value 	= Draw_log.TestPO
		*ThisForm.txtTestPoItem.Value= Draw_log.TestPOitem
		ThisForm.txtTestPO.Value	= VAL(FixPOitem(Draw_log.TestPO, Draw_log.TestItemPO, Draw_log.TestPOitem))
		ThisForm.txtTestItemPO.Value= PrepareSQLnum(Draw_log.TestItemPO,'ItemPO',2,0)
		IF Proper_PO_item(Draw_log.TestPOitem) != Proper_PO_item('')
			ThisForm.txtTestPoItem.Value= ShowSQLtxt(Draw_log.TestPOitem,'POitem',12)
			
			IF ThisForm.txtTestPO.Value > 0
				IF ThisForm.txtTestItemPO.Value = 0
					ThisForm.txtTestItemPO.Value = VAL(RIGHT(Draw_log.TestPOitem,2))
				ENDIF
			ENDIF
		ELSE
			IF ThisForm.txtTestPO.Value > 0
				IF ThisForm.txtTestItemPO.Value = 0
					ThisForm.txtTestItemPO.Value = VAL(RIGHT(Draw_log.TestPOitem,2))
				ENDIF
				ThisForm.txtTestPoItem.Value = FixPOitem(Draw_log.TestPO, Draw_log.TestItemPO, Draw_log.TestPOitem)
			ELSE
				ThisForm.txtTestPoItem.Value = ''
			ENDIF
		ENDIF
					
		ThisForm.txtTestSent.Value 	= IIF(Draw_log.TestSent=CTOD('12/30/1899'), CTOD("  /  /  "),TTOD(Draw_log.TestSent))
		ThisForm.txtLab.Value		= Draw_log.Lab
		ThisForm.txtMinutes.Value 	= Draw_log.Minutes
		ThisForm.cmbMachine.Value	= Draw_log.Machine
		
		ThisForm.txtTensile.Value 	= PrepareSQLnum(Draw_log.Tensile,'Tensile',6,0)
		ThisForm.txtYield.Value 	= PrepareSQLnum(Draw_log.Yield,'Yield',6,0)
		ThisForm.txtElongation.Value= PrepareSQLnum(Draw_log.Elongation,'Elongation',4,1)
		ThisForm.txtRed_area.Value 	= PrepareSQLnum(Draw_log.Red_Area,'Red_Area',4,1)
		ThisForm.txtRockwell.Value 	= PrepareSQLtxt(Draw_log.Rockwell,'Rockwell',4)
		ThisForm.txtBHN.Value 		= PrepareSQLnum(Draw_log.BHN,'BHN',3,0)
		ThisForm.txttLoc.Value 		= PrepareSQLtxt(Draw_log.tLoc,'tLoc',1)
		
		ThisForm.txtTensile2.Value 		= PrepareSQLnum(Draw_log.Tensile2,'Tensile',6,0)
		ThisForm.txtYield2.Value 		= PrepareSQLnum(Draw_log.Yield2,'Yield',6,0)
		ThisForm.txtElongation2.Value	= PrepareSQLnum(Draw_log.Elongation2,'Elongation',4,1)
		ThisForm.txtRed_area2.Value 	= PrepareSQLnum(Draw_log.Red_Area2,'Red_Area',4,1)
		ThisForm.txtRockwell2.Value 	= PrepareSQLtxt(Draw_log.Rockwell2,'Rockwell',4)
		ThisForm.txtBHN2.Value 			= PrepareSQLnum(Draw_log.BHN2,'BHN',3,0)
		ThisForm.txttLoc2.Value 		= PrepareSQLtxt(Draw_log.tLoc2,'tLoc',1)
		
		ThisForm.txtTensile3.Value 		= PrepareSQLnum(Draw_log.Tensile3,'Tensile',6,0)
		ThisForm.txtYield3.Value 		= PrepareSQLnum(Draw_log.Yield3,'Yield',6,0)
		ThisForm.txtElongation3.Value	= PrepareSQLnum(Draw_log.Elongation3,'Elongation',4,1)
		ThisForm.txtRed_area3.Value 	= PrepareSQLnum(Draw_log.Red_Area3,'Red_Area',4,1)
		ThisForm.txtRockwell3.Value 	= PrepareSQLtxt(Draw_log.Rockwell3,'Rockwell',4)
		ThisForm.txtBHN3.Value 			= PrepareSQLnum(Draw_log.BHN3,'BHN',3,0)
		ThisForm.txttLoc3.Value 		= PrepareSQLtxt(Draw_log.tLoc3,'tLoc',1)
		
		ThisForm.txtTensile4.Value 		= PrepareSQLnum(Draw_log.Tensile4,'Tensile',6,0)
		ThisForm.txtYield4.Value 		= PrepareSQLnum(Draw_log.Yield4,'Yield',6,0)
		ThisForm.txtElongation4.Value	= PrepareSQLnum(Draw_log.Elongation4,'Elongation',4,1)
		ThisForm.txtRed_area4.Value 	= PrepareSQLnum(Draw_log.Red_Area4,'Red_Area',4,1)
		*ThisForm.txtRockwell4.Value 	= PrepareSQLtxt(Draw_log.Rockwell4,'Rockwell',4)
		*ThisForm.txtBHN4.Value 			= PrepareSQLnum(Draw_log.BHN4,'BHN',3,0)
		ThisForm.txttLoc4.Value 		= PrepareSQLtxt(Draw_log.tLoc4,'tLoc',1)
		
		ThisForm.txtTensile5.Value 		= PrepareSQLnum(Draw_log.Tensile5,'Tensile',6,0)
		ThisForm.txtYield5.Value 		= PrepareSQLnum(Draw_log.Yield5,'Yield',6,0)
		ThisForm.txtElongation5.Value	= PrepareSQLnum(Draw_log.Elongation5,'Elongation',4,1)
		ThisForm.txtRed_area5.Value 	= PrepareSQLnum(Draw_log.Red_Area5,'Red_Area',4,1)
		*ThisForm.txtRockwell5.Value 	= PrepareSQLtxt(Draw_log.Rockwell5,'Rockwell',4)
		*ThisForm.txtBHN5.Value 			= PrepareSQLnum(Draw_log.BHN5,'BHN',3,0)
		ThisForm.txttLoc5.Value 		= PrepareSQLtxt(Draw_log.tLoc5,'tLoc',1)
		
		ThisForm.txtTensile6.Value 		= PrepareSQLnum(Draw_log.Tensile6,'Tensile',6,0)
		ThisForm.txtYield6.Value 		= PrepareSQLnum(Draw_log.Yield6,'Yield',6,0)
		ThisForm.txtElongation6.Value	= PrepareSQLnum(Draw_log.Elongation6,'Elongation',4,1)
		ThisForm.txtRed_area6.Value 	= PrepareSQLnum(Draw_log.Red_Area6,'Red_Area',4,1)
		*ThisForm.txtRockwell6.Value 	= PrepareSQLtxt(Draw_log.Rockwell5,'Rockwell',4)
		*ThisForm.txtBHN6.Value 			= PrepareSQLnum(Draw_log.BHN5,'BHN',3,0)
		ThisForm.txttLoc6.Value 		= PrepareSQLtxt(Draw_log.tLoc6,'tLoc',1)
		
		ThisForm.txtTensile7.Value 		= PrepareSQLnum(Draw_log.Tensile7,'Tensile',6,0)
		ThisForm.txtYield7.Value 		= PrepareSQLnum(Draw_log.Yield7,'Yield',6,0)
		ThisForm.txtElongation7.Value	= PrepareSQLnum(Draw_log.Elongation7,'Elongation',4,1)
		ThisForm.txtRed_area7.Value 	= PrepareSQLnum(Draw_log.Red_Area7,'Red_Area',4,1)
		*ThisForm.txtRockwell7.Value 	= PrepareSQLtxt(Draw_log.Rockwell7,'Rockwell',4)
		*ThisForm.txtBHN7.Value 			= PrepareSQLnum(Draw_log.BHN7,'BHN',3,0)
		ThisForm.txttLoc7.Value 		= PrepareSQLtxt(Draw_log.tLoc7,'tLoc',1)
		
		ThisForm.txtAC_ID.Value = PrepareSQLnum(Draw_log.AC_ID,'AC_ID',-3)
		
		ThisForm.chkPassed.Value 		= IIF(ISNULL(Draw_log.Passed),.F.,Draw_log.Passed)
		ThisForm.chkCustomerMat.Value 	= IIF(ISNULL(Draw_log.CustomerMat),.F.,Draw_log.CustomerMat)
		ThisForm.chkChart.Value 		= IIF(ISNULL(Draw_log.Chart),.F.,Draw_log.Chart)
		ThisForm.txtHTRockwell.Value 	= IIF(ISNULL(Draw_log.HTRockwell),'',Draw_log.HTRockwell)
		ThisForm.txtHTBHN.Value 		= IIF(ISNULL(Draw_log.HTBHN),0,Draw_log.HTBHN)
		ThisForm.txtID.Value			= Draw_log.ID
		ThisForm.txtOper.Value			= PrepareSQLtxt(Draw_log.Oper,'Oper',10)
		ThisForm.txtLMA_Practice.Value	= PrepareSQLtxt(Draw_log.LMA_Practice,'LMA_Practice',7)
		ThisForm.txtLMA_Procedure.Value	= PrepareSQLtxt(Draw_log.LMA_Procedure,'LMA_Procedure',12)
		
		ThisForm.txtSched.Value			= PrepareSQLnum(Draw_log.Sched,'Sched',-3)
		
		IF ISNULL(Draw_log.ChartData) 
			ThisForm.cmdChartData.Caption = "Add"
		ELSE
			IF Draw_log.ChartData
				ThisForm.cmdChartData.Caption = "Export"
			ELSE
				ThisForm.cmdChartData.Caption = "Add"
			ENDIF
		ENDIF
		
		*This is a common 'Bad SQL Connetion' initiation point
		ThisForm.nConnHandle = CheckSQLConnection(ThisForm.nConnHandle)
		
		IF USED('tmpShip')
			USE IN tmpShip
		ENDIF
		
		IF NOT ISNULL( Draw_log.SOitem )
			IF VAL(RIGHT( Draw_log.SOitem,2 ))>1
				
				cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+Draw_log.SOitem+"')"
				SELECT 0
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShip' )
				ENDIF
					
				IF USED('tmpShip')
					ThisForm.txtCompany.Value	= tmpShip.Company
					ThisForm.txtSalesP.Value	= tmpShip.SalesP
					IF tmpShip.DueDate > CTOD('12/30/1900')
						ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
					ELSE
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ENDIF
					
					IF tmpShip.ShipDate > CTOD('12/30/1900')
						ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
					ELSE
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
					USE IN tmpShip
				ELSE &&USED('tmpShip')
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&Not Item Number
				IF Draw_log.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(Draw_log.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&Draw_log.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			
			ENDIF
		ELSE  &&ISNULL( Draw_log.SOitem )
			IF NOT ISNULL(Draw_log.SalesNum)
				IF Draw_log.SalesNum > 0
					cSQL = "SELECT Company,SalesP,DueDate,ShipDate FROM dbo.Ship "
					cSQL = cSQL + " WHERE SalesNum = "+STR(Draw_log.SalesNum)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShip' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpShip' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShip")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShip' )
					ENDIF
						
					IF USED('tmpShip')
						ThisForm.txtCompany.Value	= tmpShip.Company
						ThisForm.txtSalesP.Value	= tmpShip.SalesP
						IF tmpShip.DueDate > CTOD('12/30/1900')
							ThisForm.txtDueRdate.Value	= TTOD(tmpShip.DueDate)
						ELSE
							ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ENDIF
						
						IF tmpShip.ShipDate > CTOD('12/30/1900')
							ThisForm.txtShipDate.Value	= TTOD(tmpShip.ShipDate)
						ELSE
							ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
						ENDIF
						USE IN tmpShip
					ELSE &&USED('tmpShip')
						ThisForm.txtCompany.Value	= ''
						ThisForm.txtSalesP.Value	= ''
						ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
						ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
					ENDIF
				ELSE &&Draw_log.SalesNum > 0
					ThisForm.txtCompany.Value	= ''
					ThisForm.txtSalesP.Value	= ''
					ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
					ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
				ENDIF
			ELSE  &&ISNULL(Draw_log.SalesNum)
				ThisForm.txtCompany.Value	= ''
				ThisForm.txtSalesP.Value	= ''
				ThisForm.txtDueRdate.Value	= CTOD("  /  /  ")
				ThisForm.txtShipDate.Value	= CTOD("  /  /  ")
			ENDIF
		ENDIF
		
		PRIVATE lnUT
		lnUT = UTresult( Draw_log.ID ,"Draw_log", ThisForm.nConnHandle)
		IF EMPTY(lnUT)
			*Null
			ThisForm.lblUTpass.Visible = .F.
		ELSE
			IF lnUT > 0
				*True
				ThisForm.lblUTpass.Caption = "Pass"
				ThisForm.lblUTpass.Visible = .T.
				ThisForm.lblUTpass.ForeColor = RGB(0,0,0)
				ThisForm.lblUTpass.BackColor = RGB(0,191,96)
		
			ELSE
				IF lnUT <0 
					*False
					ThisForm.lblUTpass.Caption = "Fail"
					ThisForm.lblUTpass.Visible = .T.
					ThisForm.lblUTpass.ForeColor = RGB(0,0,0)
					ThisForm.lblUTpass.BackColor = RGB(255,0,0)
				ENDIF
			ENDIF
		ENDIF
		
		
		*ThisForm.DupLots()
		
		SELECT Draw_log
		
		********
		IF WEXIST("frmLog_Detail")
			RELEASE WINDOWS frmLog_Detail
		ENDIF
		
		PRIVATE nTop, nLeft
		nTop = ThisForm.Top
		nLeft = ThisForm.Left + ThisForm.Width 
		DO FORM Forms\Log_Detail WITH "DRAW_LOG", Draw_log.ID, ThisForm.nConnHandle, nTop, nLeft
		
		*
		********
		IF WEXIST("frmDraw_Hard_Prof")
			RELEASE WINDOWS frmDraw_Hard_Prof
		ENDIF
		
		PRIVATE nTop, nLeft
		nTop = ThisForm.Top+250
		nLeft = ThisForm.Width
		*DO FORM Forms\Draw_Hard_Prof WITH Draw_log.ID, ThisForm.nConnHandle, nTop, nLeft
		
		
		*********
		
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF WEXIST("frmWO_Detail_View_Notes")
			RELEASE WINDOWS frmWO_Detail_View_Notes
			*-* Not WO_Detail_Notes  *-*
		ENDIF
		
		IF nWO_Detail > 0
		
			PRIVATE nTop, nLeft
			nTop = ThisForm.Top+100
			nLeft = ThisForm.Left + ThisForm.Width 
			
			IF WEXIST("frmLog_Detail")
				nTop = nTop+100
			ENDIF
		
			*DO FORM Forms\WO_Detail_Notes WITH nWO_Detail, ThisForm.nConnHandle, nTop, nLeft LINKED
			DO FORM Forms\WO_Detail_View_Notes WITH nWO_Detail, ThisForm.nConnHandle, nTop, nLeft 
		ENDIF
		
		***********************************************************
		ThisForm.lblRTR_ID.Caption = "rtr ID"
		IF nWO_Detail > 0
		
			cSQL = "SELECT ID FROM dbo.rtr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO_Detail = "+STR(nWO_Detail)
		
			IF USED("tmpRTRidWO")	
				USE IN tmpRTRidWO
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTRidWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTRidWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRTRidWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRTRidWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRTRidWO')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpRTRidWO')
				IF RECCOUNT('tmpRTRidWO') > 0
					biRTR_ID = PrepareSQLnum(tmpRTRidWO.ID,'rtr_ID',-4)
					ThisForm.lblRTR_ID.Caption = STR(biRTR_ID)
				ENDIF
				USE IN tmpRTRidWO
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE save_draw_log
		*ThisForm.Save_Draw_log()
		
		PRIVATE cAlloyName, dDate, cHeat, nLot
		PRIVATE nSpiece,nFpiece,nSsize,nDrawSize,nSlength,nFsize,nSweight,nFlength
		PRIVATE cCondition,nColdWork,cSpec,cHTreat,nSalesNum,nItemSO,cSOitem
		PRIVATE nOvenTemp,cPO,nWO_Detail,nProjID,cNotes,nSrvcPO,nTestPO,nTestItemPO,dTestSent,cLab
		PRIVATE nMinutes,cMachine 
		PRIVATE nTensile,nYield,nElongation,nRed_Area,cRockwell,nBHN,ctLoc
		PRIVATE nTensile2,nYield2,nElongation2,nRed_Area2,cRockwell2,nBHN2,ctLoc2
		PRIVATE nTensile3,nYield3,nElongation3,nRed_Area3,cRockwell3,nBHN3,ctLoc3
		
		PRIVATE nTensile4,nYield4,nElongation4,nRed_Area4,ctLoc4
		PRIVATE nTensile5,nYield5,nElongation5,nRed_Area5,ctLoc5
		PRIVATE nTensile6,nYield6,nElongation6,nRed_Area6,ctLoc6
		PRIVATE nTensile7,nYield7,nElongation7,nRed_Area7,ctLoc7
		
		PRIVATE lPassed,lCustomerMat,lChart,cHTRockwell,nHTBHN,nID
		PRIVATE cOper,cLMA_Practice, cLMA_Procedure
		
		cAlloyName	= PrepareSQLtxt(ThisForm.txtAlloyName.Value,'AlloyName',12)
		dDate		= PrepareSQLdate(ThisForm.txtDate.Value,'Date')
		cHeat		= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		nLot		= PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		nSpiece		= PrepareSQLnum(ThisForm.txtSpiece.Value,'sPiece',5,1)
		nFpiece		= PrepareSQLnum(ThisForm.txtFpiece.Value,'fPiece',5,0)
		nSsize		= PrepareSQLnum(ThisForm.txtSsize.Value,'sSize',9,3)
		nDrawSize	= PrepareSQLnum(ThisForm.txtDrawSize.Value,'DrawSize',9,3)
		nSlength	= PrepareSQLnum(ThisForm.txtSlength.Value,'sLength',9,3)
		nFsize		= PrepareSQLnum(ThisForm.txtFsize.Value,'fSize',9,3)
		nSweight	= PrepareSQLnum(ThisForm.txtSweight.Value,'sWeight',8,1)
		nFlength	= PrepareSQLnum(ThisForm.txtFlength.Value,'fLength',9,3)	
		cCondition	= PrepareSQLtxt(ThisForm.txtCondition.Value,'Condition',10)
		nColdWork	= PrepareSQLnum(ThisForm.txtColdWork.Value,'ColdWork',0,3)	
		cSpec		= PrepareSQLtxt(ThisForm.txtSpec.Value,'Spec',50)		
		cHTreat		= PrepareSQLtxt(ThisForm.txtHTreat.Value,'Heat Treat',16)
		
		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		nItemSO		= PrepareSQLnum(ThisForm.txtItemSO.Value,'Item SO',2,0)
		IF nItemSO < 1
			cSOitem		= ' 0-00'
		ELSE
			cSOitem		= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSO))
		ENDIF
		
		nOvenTemp	= PrepareSQLnum(ThisForm.txtOvenTemp.Value,'OvenTemp',4,0)
		cPO			= PrepareSQLtxt(ThisForm.txtPO.Value,'PO',50)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nProjID		= PrepareSQLnum(ThisForm.txtProjID.Value,'ProjID',-3)
		cNotes		= PrepareSQLtxt(ThisForm.edtNotes.Value,'Notes',-1)
		nSrvcPO		= PrepareSQLnum(ThisForm.txtSrvcPO.Value,'SrvcPO',-3)
		nTestPO		= PrepareSQLnum(ThisForm.txtTestPO.Value,'TestPO',-3)
		nTestitemPO	= PrepareSQLnum(ThisForm.txtTestItemPO.Value,'TestItemPO',2,0)
		
		cTestPoItem = PrepareSQLtxt(ThisForm.txtTestPOitem.Value,'POitem',12)
		
		dTestSent	= PrepareSQLdate(ThisForm.txtTestSent.Value,'TestSent')
		cLab		= PrepareSQLtxt(ThisForm.txtLab.Value,'Lab',12)
		nMinutes	= PrepareSQLnum(ThisForm.txtMinutes.Value,'Minutes',4,0)
		cMachine	= PrepareSQLtxt(ThisForm.cmbMachine.Value,'Machine',1)
		
		nTensile	= PrepareSQLnum(ThisForm.txtTensile.Value,'Tensile',6,0)
		nYield		= PrepareSQLnum(ThisForm.txtYield.Value,'Yield',6,0)
		nElongation	= PrepareSQLnum(ThisForm.txtElongation.Value,'Elongation',4,1)
		nRed_Area	= PrepareSQLnum(ThisForm.txtRed_area.Value,'Red_Area',4,1)
		cRockwell	= PrepareSQLtxt(ThisForm.txtRockwell.Value,'Rockwell',4)
		nBHN		= PrepareSQLnum(ThisForm.txtBHN.Value,'BHN',3,0)
		ctLoc		= PrepareSQLtxt(ThisForm.txttLoc.Value,'tLoc',1)
		
		nTensile2	= PrepareSQLnum(ThisForm.txtTensile2.Value,'Tensile',6,0)
		nYield2		= PrepareSQLnum(ThisForm.txtYield2.Value,'Yield',6,0)
		nElongation2= PrepareSQLnum(ThisForm.txtElongation2.Value,'Elongation',4,1)
		nRed_Area2	= PrepareSQLnum(ThisForm.txtRed_area2.Value,'Red_Area',4,1)
		cRockwell2	= PrepareSQLtxt(ThisForm.txtRockwell2.Value,'Rockwell',4)
		nBHN2		= PrepareSQLnum(ThisForm.txtBHN2.Value,'BHN',3,0)
		ctLoc2		= PrepareSQLtxt(ThisForm.txttLoc2.Value,'tLoc',1)
		
		nTensile3	= PrepareSQLnum(ThisForm.txtTensile3.Value,'Tensile',6,0)
		nYield3		= PrepareSQLnum(ThisForm.txtYield3.Value,'Yield',6,0)
		nElongation3= PrepareSQLnum(ThisForm.txtElongation3.Value,'Elongation',4,1)
		nRed_Area3	= PrepareSQLnum(ThisForm.txtRed_area3.Value,'Red_Area',4,1)
		cRockwell3	= PrepareSQLtxt(ThisForm.txtRockwell3.Value,'Rockwell',4)
		nBHN3		= PrepareSQLnum(ThisForm.txtBHN3.Value,'BHN',3,0)
		ctLoc3		= PrepareSQLtxt(ThisForm.txttLoc3.Value,'tLoc',1)
		
		nTensile4	= PrepareSQLnum(ThisForm.txtTensile4.Value,'Tensile',6,0)
		nYield4		= PrepareSQLnum(ThisForm.txtYield4.Value,'Yield',6,0)
		nElongation4= PrepareSQLnum(ThisForm.txtElongation4.Value,'Elongation',4,1)
		nRed_Area4	= PrepareSQLnum(ThisForm.txtRed_area4.Value,'Red_Area',4,1)
		*cRockwell4	= PrepareSQLtxt(ThisForm.txtRockwell4.Value,'Rockwell',4)
		*nBHN4		= PrepareSQLnum(ThisForm.txtBHN4.Value,'BHN',3,0)
		ctLoc4		= PrepareSQLtxt(ThisForm.txttLoc4.Value,'tLoc',1)
		
		nTensile5	= PrepareSQLnum(ThisForm.txtTensile5.Value,'Tensile',6,0)
		nYield5		= PrepareSQLnum(ThisForm.txtYield5.Value,'Yield',6,0)
		nElongation5= PrepareSQLnum(ThisForm.txtElongation5.Value,'Elongation',4,1)
		nRed_Area5	= PrepareSQLnum(ThisForm.txtRed_area5.Value,'Red_Area',4,1)
		*cRockwell5	= PrepareSQLtxt(ThisForm.txtRockwell5.Value,'Rockwell',4)
		*nBHN5		= PrepareSQLnum(ThisForm.txtBHN5.Value,'BHN',3,0)
		ctLoc5		= PrepareSQLtxt(ThisForm.txttLoc5.Value,'tLoc',1)
		
		nTensile6	= PrepareSQLnum(ThisForm.txtTensile6.Value,'Tensile',6,0)
		nYield6		= PrepareSQLnum(ThisForm.txtYield6.Value,'Yield',6,0)
		nElongation6= PrepareSQLnum(ThisForm.txtElongation6.Value,'Elongation',4,1)
		nRed_Area6	= PrepareSQLnum(ThisForm.txtRed_area6.Value,'Red_Area',4,1)
		*cRockwell6	= PrepareSQLtxt(ThisForm.txtRockwell6.Value,'Rockwell',4)
		*nBHN6		= PrepareSQLnum(ThisForm.txtBHN6.Value,'BHN',3,0)
		ctLoc6		= PrepareSQLtxt(ThisForm.txttLoc6.Value,'tLoc',1)
		
		nTensile7	= PrepareSQLnum(ThisForm.txtTensile7.Value,'Tensile',6,0)
		nYield7		= PrepareSQLnum(ThisForm.txtYield7.Value,'Yield',6,0)
		nElongation7= PrepareSQLnum(ThisForm.txtElongation7.Value,'Elongation',4,1)
		nRed_Area7	= PrepareSQLnum(ThisForm.txtRed_area7.Value,'Red_Area',4,1)
		*cRockwell7	= PrepareSQLtxt(ThisForm.txtRockwell7.Value,'Rockwell',4)
		*nBHN7		= PrepareSQLnum(ThisForm.txtBHN7.Value,'BHN',3,0)
		ctLoc7		= PrepareSQLtxt(ThisForm.txttLoc7.Value,'tLoc',1)
		
		lPassed		= PrepareSQLchk(ThisForm.chkPassed.Value,'Passed',.F.)
		lCustomerMat = PrepareSQLchk(ThisForm.chkCustomerMat.Value,'Customers Mat',.F.)
		lChart		= PrepareSQLchk(ThisForm.chkChart.Value,'Chart',.F.)
		
		cHTRockwell	= PrepareSQLtxt(ThisForm.txtHTRockwell.Value,'HT Rockwell',4)
		nHTBHN		= PrepareSQLnum(ThisForm.txtHTBHN.Value,'HT BHN',3,0)
		
		nID			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		cOper		= PrepareSQLtxt(ThisForm.txtOper.Value,'Oper',10)
		cLMA_Practice	= PrepareSQLtxt(ThisForm.txtLMA_Practice.Value,'LMA_Practice',7)
		cLMA_Procedure	= PrepareSQLtxt(ThisForm.txtLMA_Procedure.Value,'LMA_Procedure',13)
		
		PRIVATE nAC_ID 
		nAC_ID = PrepareSQLnum(ThisForm.txtAC_ID.Value,'AC_ID',-3)
		PRIVATE nSched
		nSched	 	= PrepareSQLnum(ThisForm.txtSched.Value,'Sched',-3)		&&	= PrepareSQLnum(Draw_log.Sched,'Sched',-3)
		
		*************************
		*Test Data
		IF nColdWork >= 1
			MESSAGEBOX("Reduction of Area needs to be less than 1.",48,"Cannot save!")
			RETURN .F.
		ENDIF
		*************************
		** STR(nColdWork,4,3) Returns ****  ????
		IF VAL(STR(nColdWork,4,3))=0
			nColdWork=0.000
		ENDIF
		
		
		IF nID = 0
			*Add
			
			IF nLot = 0
				*get Lot
				  
				IF USED('tmpCountLot')	
					USE IN tmpCountLot
				ENDIF
		
				cSQL = "SELECT MAX(Lot) AS MaxLot FROM dbo.Draw_log"
						
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
				ELSE
					IF USED('tmpCountLot')
						IF tmpCountLot.MaxLot > 0
						
							nLot = tmpCountLot.MaxLot+1
							ThisForm.txtLot.Value = nLot
							ThisForm.Lots.Caption = '1'
						ENDIF
						USE IN tmpCountLot 
					ENDIF
				ENDIF
			ENDIF
		
		
			PRIVATE cUserTrack 
			cUserTrack = "INSERT INTO dbo.Draw_log ColdWork:"
			cUserTrack = cUserTrack+" STR as 4,3:"+STR(nColdWork,4,3)
			cUserTrack = cUserTrack+" STR as 5,3:"+STR(nColdWork,5,3)
			cUserTrack = cUserTrack+" STR as 9,4:"+STR(nColdWork,9,4)
			cUserTrack = cUserTrack +" nLot="+ALLTRIM(STR(nLot))
			cUserTrack = cUserTrack +" -used to find ColdWork='****' error"
			TrackMess(cUserTrack)
		**
			cSQL = "INSERT INTO dbo.Draw_log "
			cSQL = cSQL + "(AlloyName, [Date], Heat, Lot"
			cSQL = cSQL + ",Spiece,Fpiece,Ssize,DrawSize,Slength,[Fsize],Sweight,Flength"
			cSQL = cSQL + ",Condition,ColdWork,Spec,HTreat,SalesNum,ItemSO,SOitem"
			cSQL = cSQL + ",OvenTemp,PO,Notes,SrvcPO,TestPO,TestItemPO,TestPoItem,TestSent,Lab"
			cSQL = cSQL + ",[Minutes]"  
			cSQL = cSQL + ",Tensile,Yield,Elongation,Red_Area,Rockwell,BHN,tLoc"
			cSQL = cSQL + ",Tensile2,Yield2,Elongation2,Red_Area2,Rockwell2,BHN2,tLoc2"
			cSQL = cSQL + ",Tensile3,Yield3,Elongation3,Red_Area3,Rockwell3,BHN3,tLoc3" 
		
			cSQL = cSQL + ",Tensile4,Yield4,Elongation4,Red_Area4,tLoc4"
			cSQL = cSQL + ",Tensile5,Yield5,Elongation5,Red_Area5,tLoc5"
			cSQL = cSQL + ",Tensile6,Yield6,Elongation6,Red_Area6,tLoc6"
			cSQL = cSQL + ",Tensile7,Yield7,Elongation7,Red_Area7,tLoc7"
			cSQL = cSQL + ",HTRockwell,HTBHN"
			cSQL = cSQL + ",Passed,CustomerMat,Chart"
			cSQL = cSQL + ",LMA_Practice,LMA_Procedure,WO_Detail,ProjID"
			cSQL = cSQL + ",Machine,Oper,Sched"
			cSQL = cSQL + ") VALUES "
			cSQL = cSQL + "('"+cAlloyName+"','"+IIF(EMPTY(dDate),'',DTOC(dDate))+"','"+cHeat+"',"+STR(nLot,11,0)
			cSQL = cSQL + ","+STR(nSpiece,6,1)+","+STR(nFpiece,5,0)+","+STR(nSsize,10,3)+","+STR(nDrawSize,10,3)+","+STR(nSlength,10,3)+","+STR(nFsize,10,3)+","+STR(nSweight,8,1)+","+STR(nFlength,10,3)
			cSQL = cSQL + ",'"+cCondition+"',"+STR(nColdWork,4,3)+",'"+cSpec+"','"+cHTreat+"',"+STR(nSalesNum)+","+STR(nItemSO,2,0)+",'"+cSOitem+"'"
			cSQL = cSQL + ","+STR(nOvenTemp,4,0)+",'"+cPO+"','"+cNotes+"',"+STR(nSrvcPO,10,0)+","+STR(nTestPO,10,0)+","+STR(nTestItemPO,2,0)+",'"+cTestPoItem+"','"+IIF(EMPTY(dTestSent),'',DTOC(dTestSent))+"'"+",'"+cLab+"'"
			cSQL = cSQL + ","+STR(nMinutes,4,0)   
			cSQL = cSQL + ","+STR(nTensile,6,0)+","+STR(nYield,6,0)+","+STR(nElongation,5,1)+","+STR(nRed_Area,5,1)+",'"+cRockwell+"',"+STR(nBHN,4,1)+",'"+ctLoc+"'"
			cSQL = cSQL + ","+STR(nTensile2,6,0)+","+STR(nYield2,6,0)+","+STR(nElongation2,4,1)+","+STR(nRed_Area2,4,1)+",'"+cRockwell2+"',"+STR(nBHN2,4,1)+",'"+ctLoc2+"'"
			cSQL = cSQL + ","+STR(nTensile3,6,0)+","+STR(nYield3,6,0)+","+STR(nElongation3,4,1)+","+STR(nRed_Area3,4,1)+",'"+cRockwell3+"',"+STR(nBHN3,4,1)+",'"+ctLoc3+"'"
			
			cSQL = cSQL + ","+STR(nTensile4,6,0)+","+STR(nYield4,6,0)+","+STR(nElongation4,4,1)+","+STR(nRed_Area4,4,1)+",'"+ctLoc4+"'"
			cSQL = cSQL + ","+STR(nTensile5,6,0)+","+STR(nYield5,6,0)+","+STR(nElongation5,4,1)+","+STR(nRed_Area5,4,1)+",'"+ctLoc5+"'"
			cSQL = cSQL + ","+STR(nTensile6,6,0)+","+STR(nYield6,6,0)+","+STR(nElongation6,4,1)+","+STR(nRed_Area6,4,1)+",'"+ctLoc6+"'"
			cSQL = cSQL + ","+STR(nTensile7,6,0)+","+STR(nYield7,6,0)+","+STR(nElongation7,4,1)+","+STR(nRed_Area7,4,1)+",'"+ctLoc7+"'"
			cSQL = cSQL + ",'"+cHTRockwell+"',"+STR(nHTBHN,3,1)
			cSQL = cSQL + ","+IIF(lPassed,'1','0')+","+IIF(lCustomerMat,'1','0')+","+IIF(lChart,'1','0')
			cSQL = cSQL + ",'"+cLMA_Practice+"','"+cLMA_Procedure+"',"+STR(nWO_Detail)+","+STR(nProjID)
			cSQL = cSQL + ",'"+cMachine+"','"+cOper+"'"+","+STR(nSched)
			cSQL = cSQL + " )"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				WAIT WINDOW 'Saved!' NOWAIT
			ENDIF
			
		ELSE
			*Update
			
			
			
			PRIVATE cSQL
			cSQL = "UPDATE dbo.Draw_log SET "
			cSQL = cSQL + "AlloyName='"+cAlloyName+"'"
			cSQL = cSQL +",[Date]='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
			cSQL = cSQL +",Heat='"+cHeat+"'"
			cSQL = cSQL +",Lot="+STR(nLot,11,0)
			cSQL = cSQL +",sPiece="+STR(nSpiece,6,1)
			cSQL = cSQL +",fPiece="+STR(nFpiece,5,0)
			cSQL = cSQL +",sSize="+STR(nSsize,10,3)
			cSQL = cSQL +",DrawSize="+STR(nDrawSize,10,3)
			cSQL = cSQL +",sLength="+STR(nSlength,10,3)
			cSQL = cSQL +",fSize="+STR(nFsize,10,3)
			cSQL = cSQL +",sWeight="+STR(nSweight,8,1)
			cSQL = cSQL +",fLength="+STR(nFlength,10,3)
			cSQL = cSQL +",Condition='"+cCondition+"'"
			cSQL = cSQL +",ColdWork="+STR(nColdWork,4,3)+""
			cSQL = cSQL +",Spec='"+cSpec+"'"
			cSQL = cSQL +",HTreat='"+cHTreat+"'"
			cSQL = cSQL +",SalesNum="+STR(nSalesNum)
			cSQL = cSQL +",ItemSO="+STR(nItemSO,2,0)
			cSQL = cSQL +",SOitem='"+cSOitem+"'"
			cSQL = cSQL +",OvenTemp="+STR(nOvenTemp,4,0)
			cSQL = cSQL +",PO='"+cPO+"'"
			cSQL = cSQL +",WO_Detail="+STR(nWO_Detail)
			cSQL = cSQL +",ProjID="+STR(nProjID)
			cSQL = cSQL +",Notes='"+cNotes+"'"
			cSQL = cSQL +",SrvcPO="+STR(nSrvcPO,10,0)
			cSQL = cSQL +",TestPO="+STR(nTestPO,10,0)
			cSQL = cSQL +",TestItemPO="+STR(nTestItemPO,2,0)
			cSQL = cSQL +",TestPoItem='"+cTestPoItem+"'"
			cSQL = cSQL +",TestSent='"+IIF(EMPTY(dTestSent),'',DTOC(dTestSent))+"'"
			cSQL = cSQL +",Lab='"+cLab+"'"
			cSQL = cSQL +",[Minutes]="+STR(nMinutes,4,0)
			cSQL = cSQL +",Machine='"+cMachine+"'"
		
			cSQL = cSQL +",Tensile="+STR(nTensile,6,0)
			cSQL = cSQL +",Yield="+STR(nYield,6,0)
			cSQL = cSQL +",Elongation="+STR(nElongation,5,1)
			cSQL = cSQL +",Red_area="+STR(nRed_Area,5,1)
			cSQL = cSQL +",Rockwell='"+cRockwell+"'"
			cSQL = cSQL +",BHN="+STR(nBHN,4,1)
			cSQL = cSQL +",tLoc='"+ctLoc+"'"
		
			cSQL = cSQL +",Tensile2="+STR(nTensile2,6,0)
			cSQL = cSQL +",Yield2="+STR(nYield2,6,0)
			cSQL = cSQL +",Elongation2="+STR(nElongation2,5,1)
			cSQL = cSQL +",Red_area2="+STR(nRed_Area2,5,1)
			cSQL = cSQL +",Rockwell2='"+cRockwell2+"'"
			cSQL = cSQL +",BHN2="+STR(nBHN2,4,1)
			cSQL = cSQL +",tLoc2='"+ctLoc2+"'"
		
			cSQL = cSQL +",Tensile3="+STR(nTensile3,6,0)
			cSQL = cSQL +",Yield3="+STR(nYield3,6,0)
			cSQL = cSQL +",Elongation3="+STR(nElongation3,5,1)
			cSQL = cSQL +",Red_area3="+STR(nRed_Area3,5,1)
			cSQL = cSQL +",Rockwell3='"+cRockwell3+"'"
			cSQL = cSQL +",BHN3="+STR(nBHN3,4,1)
			cSQL = cSQL +",tLoc3='"+ctLoc3+"'"
			
			cSQL = cSQL +",Tensile4="+STR(nTensile4,6,0)
			cSQL = cSQL +",Yield4="+STR(nYield4,6,0)
			cSQL = cSQL +",Elongation4="+STR(nElongation4,5,1)
			cSQL = cSQL +",Red_area4="+STR(nRed_Area4,5,1)
		*	cSQL = cSQL +",Rockwell4='"+cRockwell4+"'"
		*	cSQL = cSQL +",BHN4="+STR(nBHN4,4,1)
			cSQL = cSQL +",tLoc4='"+ctLoc4+"'"
		
			cSQL = cSQL +",Tensile5="+STR(nTensile5,6,0)
			cSQL = cSQL +",Yield5="+STR(nYield5,6,0)
			cSQL = cSQL +",Elongation5="+STR(nElongation5,5,1)
			cSQL = cSQL +",Red_area5="+STR(nRed_Area5,5,1)
		*	cSQL = cSQL +",Rockwell5='"+cRockwell5+"'"
		*	cSQL = cSQL +",BHN5="+STR(nBHN5,4,1)
			cSQL = cSQL +",tLoc5='"+ctLoc5+"'"
		
			cSQL = cSQL +",Tensile6="+STR(nTensile6,6,0)
			cSQL = cSQL +",Yield6="+STR(nYield6,6,0)
			cSQL = cSQL +",Elongation6="+STR(nElongation6,5,1)
			cSQL = cSQL +",Red_area6="+STR(nRed_Area6,5,1)
		*	cSQL = cSQL +",Rockwell6='"+cRockwell6+"'"
		*	cSQL = cSQL +",BHN6="+STR(nBHN6,4,1)
			cSQL = cSQL +",tLoc6='"+ctLoc6+"'"
		
			cSQL = cSQL +",Tensile7="+STR(nTensile7,6,0)
			cSQL = cSQL +",Yield7="+STR(nYield7,6,0)
			cSQL = cSQL +",Elongation7="+STR(nElongation7,5,1)
			cSQL = cSQL +",Red_area7="+STR(nRed_Area7,5,1)
		*	cSQL = cSQL +",Rockwell7='"+cRockwell7+"'"
		*	cSQL = cSQL +",BHN7="+STR(nBHN7,4,1)
			cSQL = cSQL +",tLoc7='"+ctLoc7+"'"
		
			cSQL = cSQL +",Passed="+IIF(lPassed,'1','0')
			cSQL = cSQL +",CustomerMat="+IIF(lCustomerMat,'1','0')
			cSQL = cSQL +",Chart="+IIF(lChart,'1','0')
			cSQL = cSQL +",HTRockwell='"+cHTRockwell+"'"
			cSQL = cSQL +",HTBHN="+STR(nHTBHN,4,1)
			cSQL = cSQL +",Oper='"+cOper+"'"
			cSQL = cSQL +",LMA_Practice='"+cLMA_Practice+"'"
			cSQL = cSQL +",LMA_Procedure='"+cLMA_Procedure+"'"
			cSQL = cSQL +",Sched="+STR(nSched)
			cSQL = cSQL + " WHERE ID="+STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				WAIT WINDOW 'Updated!' NOWAIT
			ENDIF
			
		ENDIF
		
		********************************
		*Update WO
		IF nWO_Detail > 0
			IF lPassed
				cSQL = "UPDATE dbo.WorkOrder_Detail SET "
				cSQL = cSQL + " PassTest = 1 "
				cSQL = cSQL + ",fFinishDate = CASE WHEN fFinishDate IS NULL THEN GetDate() ELSE fFinishDate END "
				cSQL = cSQL + " WHERE WO_Detail ="+STR(nWO_Detail)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
				ELSE
		*			WAIT WINDOW 'Updated!' NOWAIT
				ENDIF
				
			ELSE
			ENDIF
		ENDIF
		
		********************************
		*Update PO
		ThisForm.UpDatePO()
		
		********************************
		*Update dbo.AcctCosting
		
		IF nAC_ID > 0
			AcctCost_MachineLot_Update(nAC_ID, "Draw", nLot)
		ENDIF
		
		*********************************
		*Refresh Draw_log data
		ThisForm.LoadLog(nID)
		
		RETURN .T.
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle)
		
		IF WEXIST("frmLog_Detail")
			RELEASE WINDOWS frmLog_Detail
		ENDIF
		
		IF WEXIST("frmWO_Detail_View_Notes")
			RELEASE WINDOWS frmWO_Detail_View_Notes
		ENDIF
		
		
	ENDPROC

	PROCEDURE updatepo		&& Update the Purchase Order database
		*ThisForm.UpdatePO()
		
		*SELECT Draw_log
		
		*!*	IF !EMPTY(ThisForm.txtTestpo.Value)
		*!*		PRIVATE nHPAPO, nItemPo, cPOitem, cCompany, dOrderdate, cSalesp
		*!*		nHPAPO		= PrepareSQLnum(ThisForm.txtTestpo.Value,'HPAPO',-3)
		*!*		nItemPO		= PrepareSQLnum(ThisForm.txtTestItemPO.Value,'Item PO',2,0)
		*!*		IF nItemPO = 0
		*!*			nItemPO = 1
		*!*		ENDIF
		*!*		cPOitem		= Proper_PO_Item(STR(nHPAPO)+"-"+STR(nItemPO,2,0))
		*!*		cCompany	= PrepareSQLtxt(ThisForm.txtLab.Value,'Company',30)
		*!*		dOrderdate	= PrepareSQLdate(ThisForm.txtTestsent.Value,'OrderDate')
		*!*		dOrderdate	= IIF(EMPTY(dOrderdate),DATE(),dOrderdate)
		*!*		cSalesp 	= ' '
		*!*		PRIVATE nSalesNum, nItemSO, cSOitem
		*!*		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesnum.Value,'SalesNum',-3)
		*!*		nItemSO		= PrepareSQLnum(ThisForm.txtItemSO.Value,'Item SO',2,0)
		*!*		cSOitem		= Proper_SO_Item(STR(nSalesNum)+"-"+STR(nItemSO))
		*!*		PRIVATE cAlloy, cForm, nFsize, nDrawSize, nSsize, nThck
		*!*		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloyName.Value,'AlloyName',12)
		*!*		cForm		= '10'
		*!*		nFsize		= PrepareSQLnum(ThisForm.txtFsize.Value,'Fsize',9,4)
		*!*		nDrawSize	= PrepareSQLnum(ThisForm.txtDrawSize.Value,'DrawSize',9,4)
		*!*		nSsize		= PrepareSQLnum(ThisForm.txtSsize.Value,'Ssize',9,4)
		*!*		nThck		= IIF(EMPTY(nFsize),IIF(EMPTY(nDrawSize),nSsize,nDrawSize),nFsize)
		*!*		PRIVATE nTensile, nYield, nElongation, nRed_Area, cRockwell, nBHN, lPassed, lComplete, nPieces
		*!*		nTensile	= PrepareSQLnum(ThisForm.txtTensile.Value,'Tensile',6,0)
		*!*		nYield		= PrepareSQLnum(ThisForm.txtYield.Value,'Yield',6,0)
		*!*		nElongation	= PrepareSQLnum(ThisForm.txtElongation.Value,'Elongation',4,1)
		*!*		nRed_Area	= PrepareSQLnum(ThisForm.txtRed_Area.Value,'Red_Area',4,1)
		*!*		cRockwell	= PrepareSQLtxt(ThisForm.txtRockwell.Value,'Rockwell',4)
		*!*		nBHN 		= PrepareSQLnum(ThisForm.txtBHN.Value,'BHN',3,0)
		*!*		lPassed		= PrepareSQLchk(ThisForm.chkPassed.Value,'Passed',.T.)
		*!*		lComplete 	= !EMPTY(nTensile) OR !EMPTY(nYield) OR !EMPTY(nElongation) OR !EMPTY(nRed_Area) OR !EMPTY(cRockwell) OR !EMPTY(nBHN) OR lPassed
		*!*		nPieces		= 1
		*!*		PRIVATE nSz2,nSz3,nP_lb,nP_pc,nP_ft, nLotP,cOtherFld,nOtherP,nOrder_Qty
		*!*		nSz2		= 0
		*!*		nSz3		= 0
		*!*		nP_lb		= 0
		*!*		nP_pc		= 0
		*!*		nP_ft		= 0
		*!*		nLotP		= 0
		*!*		cOtherFld	= ''
		*!*		nOtherP		= 0
		*!*		nOrder_Qty	= 0
		*!*		PRIVATE cShipVia,cJobNumber,dDue_Min,dDue_Max
		*!*		cShipVia	= ''
		*!*		cJobNumber	= ''
		*!*		dDue_Min	= dOrderdate + 1
		*!*		dDue_Max	= dOrderdate + 7
		*!*		Private cPOSalesP
		*!*		cPOSalesP 	= PrepareSQLtxt(ThisForm.txtSalesp.Value,'SalesP',1)
		*!*	*	cCompany 	= PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		*!*		PRIVATE cCond_Spec, cSpec, cMisc_Purch, lServicesPO, cStock, lSheet_pk, nDrawlot
		*!*		nDrawLot		= PrepareSQLnum(ThisForm.txtLot.Value,'Draw Lot',-3)
		*!*		cCond_Spec	= 'Draw Log:'+ALLTRIM(STR(nDrawLot))
		*!*		cSpec		= PrepareSQLtxt(ThisForm.txtSpec.Value,'Spec',50)
		*!*		cMisc_Purch	= "Testing:"+cSpec
		*!*		lServicesPO	= .T.
		*!*		cStock		= ''
		*!*		lSheet_pk	= .F.
		*!*		PRIVATE nShipWhere,nPOShipAddr,nPOPayAddr,cDispAlloy,lRandLen
		*!*		nShipWhere	= 0
		*!*		nPOShipAddr	= 0
		*!*		nPOPayAddr	= 0
		*!*		cDispAlloy	= cAlloy
		*!*		lRandLen	= .F.
		*!*		
		*!*		********
		*!*		PRIVATE nCntPOitem 
		*!*		nCntPOitem = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle )
		*!*		
		*!*		IF nCntPOitem = 0
		*!*			
		*!*			PRIVATE cSQLi
		*!*			cSQLi = "INSERT INTO dbo.PurchaseOrder "
		*!*			cSQLi = cSQLi + "(HPApo,poItem,itempo,SalesNum,soItem,ITEM,Salesp,orderdate,company,alloy,FORM,Pieces,Thck,Sz2,Sz3,P_lb,P_pc,P_ft,LotP,OtherFld,OtherP,Order_Qty"
		*!*			cSQLi = cSQLi + ",Delivered,POSalesP,ShipVia,JobNumber,Due_Min,Due_Max,Cond_Spec,Misc_Purch,Services,Stock,Sheet_Pk,ShipWhere,POShipAddr,POPayAddr,DispAlloy,RandLen) VALUES "
		*!*			cSQLi = cSQLi + "("+STR(nHPApo)+",'"+cPOItem+"',"+STR(nItemPo,2,0)+","+STR(nSalesNum)+",'"+cSOItem+"',"+STR(nItemSO,2,0)+",'"+cSalesp+"'"
		*!*			cSQLi = cSQLi + ",'"+DTOC(dOrderdate)+"','"+cCompany+"','"+cAlloy+"','"+cForm+"'"
		*!*			cSQLi = cSQLi + ","+STR(nPieces,6,0)+","+STR(nThck,10,4)+","+STR(nSz2,9,3)+","+STR(nSz3,9,3)+","+STR(nP_lb,8,2)+","+STR(nP_pc,9,2)+","+STR(nP_ft,8,2)
		*!*			cSQLi = cSQLi + ","+STR(nLotP,9,2)+",'"+cOtherFld+"',"+STR(nOtherP,8,2)+","+STR(nOrder_Qty,12,3)+","+IIF(lComplete,'1','0')+""
		*!*			cSQLi = cSQLi + ",'"+cPOSalesP+"','"+cShipVia+"','"+cJobNumber+"','"+DTOC(dDue_Min)+"','"+DTOC(dDue_Max)+"'"
		*!*			cSQLi = cSQLi + ",'"+cCond_Spec+"','"+cMisc_Purch+"',"+IIF(lServicesPO,'1','0')+",'"+cStock+"',"+IIF(lSheet_pk,'1','0')
		*!*			cSQLi = cSQLi + ","+STR(nShipWhere,1,0)+","+STR(nPOShipAddr)+","+STR(nPOPayAddr)+",'"+cDispAlloy+"',"+IIF(lRandLen,'1','0')+")"
		
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		*!*			
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi )
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
		
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC )
		*!*			ELSE
		*!*				TrackMess( "Draw Log:"+ALLTRIM(STR(nDrawlot))+" added POitem:"+ALLTRIM(cPOitem)+" to PurchaseOrder table.")
		*!*				lPOSaveLst = .T.
		*!*			ENDIF
		
		*!*		ELSE
		*!*			*	IF MESSAGEBOX("PO Number-Item:"+ALLTRIM(m.poItem)+" already exist."+CHR(13)+"Cancel/Clear this save and Edit!"+CHR(13)+"If want to overwrite the old values with these, "+CHR(13)+"Answer YES, and Update the values.",4+16,"Can not add this PO as new, Update old record?") = 6
		*!*			nCntPOitem = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, "Delivered" )
		*!*			IF nCntPOitem = 0
		*!*				IF MESSAGEBOX( "Did you just save new properties from a test lab?"+CHR(13)+"Can the PO be marked as Complete?",4+32,"Complete the PO")=6
		*!*					dDate = DATE()
		*!*					lDelivered = .T.
		*!*					PRIVATE cSQLu
		*!*					cSQLu = "UPDATE dbo.PurchaseOrder SET "
		*!*					cSQLu = cSQLu + " Received='"+IIF( EMPTY(dDate),'',DTOC(dDate) )+"'"
		*!*					cSQLu = cSQLu + ",Delivered="+IIF(lDelivered,'1','0')
		*!*					cSQLu = cSQLu + " WHERE PurchaseOrder.poItem = dbo.f_ProperPOitem('"+cPOItem+"')"
		
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
		*!*					ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
		
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
		*!*					ELSE
		*!*						lPOSaveLst = .T.
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		
		*!*	ENDIF
		*SELECT Draw_log
	ENDPROC

