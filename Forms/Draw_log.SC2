					ThisForm.txtElongation4.Value	= PrepareSQLnum(tmpNEW.Elongation4,'Elongation',4,1)
					ThisForm.txtRed_area4.Value 	= PrepareSQLnum(tmpNEW.Red_Area4,'Red_Area',4,1)
		*			ThisForm.txtRockwell4.Value 	= ShowSQLtxt(tmpNEW.Rockwell4,'Rockwell',4)
		*			ThisForm.txtBHN4.Value 			= PrepareSQLnum(tmpNEW.BHN4,'BHN',3,0)
					ThisForm.txttLoc4.Value			= ShowSQLtxt(tmpNEW.tLoc4,'tLoc',1)
					
					ThisForm.txtTensile5.Value 		= PrepareSQLnum(tmpNEW.Tensile5,'Tensile',6,0)
