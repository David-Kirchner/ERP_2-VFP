	PROCEDURE cmdSO.Valid
		PRIVATE cSOitem, nSalesNum, nItemSO
		nSalesNum	= ThisForm.txtSalesNum.Value
		nItemSO		= ThisForm.txtItemSO.Value
		
		cSOitem = Proper_SO_Item( STR(nSalesNum)+"-"+STR(nItemSO) )
		IF NOT EMPTY('cSOitem')
			DO FORM Forms\ShowvSOitem WITH cSOitem
		ENDIF
		Return
		
		*!*	PRIVATE m.psalesnum, M.CREC
		*!*	m.CREC = RECNO()
		*!*	  IF NOT USED('INQSOLD')
		*!*	    SELECT 0
		*!*	    USE  HPA!inqsold NOUPDATE shared
		*!*	  ELSE
		*!*	    SELECT inqsold
		*!*	  ENDIF
		*!*	  IF USED('INQSOLD')
		*!*	    &&may be locked by another
		*!*	    SELECT Draw_log
		*!*	    GO TOP
		*!*	    DO WHILE NOT EOF()
		*!*	      IF Draw_log.salesnum > 0 
		*!*	      *AND EMPTY(Draw_log.company)
		*!*	      *IF Draw_log.salesnum > 0
		*!*	        m.psalesnum = Draw_log.salesnum
		
		*!*	        SELECT inqsold
		
		*!*	        LOCATE FOR salesnum = Draw_log.salesnum
		*!*	        IF FOUND()
		*!*	          m.company  = inqsold.company
		*!*	          m.shipped  = inqsold.shipped
		*!*	          m.shipdate = inqsold.shipdate
		*!*	          m.SALESP   = inqsold.salesp
		*!*	          M.PO_NUM   = INQSOLD.PO_NUM
		*!*	          M.SALEDATE = INQSOLD.SALEDATE
		
		*!*	          SELECT Draw_log
		*!*	          SHOW GETS
		*!*	          REPLACE Draw_log.company  WITH m.company
		*!*	          REPLACE Draw_log.shipped  WITH m.shipped
		*!*	          REPLACE Draw_log.shipdate WITH m.shipdate
		*!*	          REPLACE Draw_log.SALESP   WITH m.SALESP
		*!*	          REPLACE Draw_log.PO_NUM   WITH M.PO_NUM
		*!*	          REPLACE Draw_log.SALEDATE WITH M.SALEDATE
		*!*	        ELSE
		*!*	          WAIT WINDOW 'DID NOT FIND SALES NUMBER'+STR(m.psalesnum) NOWAIT
		*!*	        ENDIF
		*!*	      ELSE
		*!*	        *WAIT WINDOW 'NO SALES NUMBER!!' NOWAIT
		*!*	        IF Draw_log.salesnum = 0 AND NOT EMPTY(Draw_log.company)
		*!*	          SELECT Draw_log
		*!*	          REPLACE Draw_log.company  WITH ""
		*!*	          REPLACE Draw_log.shipped  WITH .F.
		*!*	          REPLACE Draw_log.shipdate WITH CTOD("  /  /  ")
		*!*	          REPLACE Draw_log.SALESP   WITH " "
		*!*	        ENDIF
		*!*	      ENDIF
		*!*	      SELECT Draw_log
		*!*	      SKIP
		*!*	    ENDDO
		*!*	  ELSE
		*!*	    WAIT WINDOW 'COULD NOT OPEN INQSOLD' NOWAIT
		*!*	  ENDIF
		
		
		*!*	IF USED('INQSOLD')
		*!*	  USE IN Inqsold
		*!*	ENDIF
		*!*	SELECT Draw_log
		
		*!*	GOTO M.CREC
		*!*	ThisForm.Refresh
	ENDPROC

