					ThisForm.txtElongation5.Value	= PrepareSQLnum(tmpNEW.Elongation5,'Elongation',4,1)
					ThisForm.txtRed_area5.Value 	= PrepareSQLnum(tmpNEW.Red_Area5,'Red_Area',4,1)
		*			ThisForm.txtRockwell5.Value 	= ShowSQLtxt(tmpNEW.Rockwell5,'Rockwell',4)
		*			ThisForm.txtBHN5.Value 			= PrepareSQLnum(tmpNEW.BHN5,'BHN',3,0)
					ThisForm.txttLoc5.Value			= ShowSQLtxt(tmpNEW.tLoc5,'tLoc',1)
					
					ThisForm.txtTensile6.Value 		= PrepareSQLnum(tmpNEW.Tensile6,'Tensile',6,0)
