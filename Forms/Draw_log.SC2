			ThisForm.txtAlloyname.SetFocus
			thisform.Refresh
			RETURN
		
		ELSE
			*SAVE!
			
		
			IF ThisForm.CheckSave()
				IF ThisForm.Save_Draw_log()
					*calls ThisForm.LoadLog(nID)
						*calls ThisForm.Refresh_Draw_log()
							*calls DO FORM Forms\Log_Detail WITH "Draw_log", Draw_log.ID, ThisForm.nConnHandle, nTop, nLeft
				
					ThisForm.edtNotes.ReadOnly = .T.
					
					This.Caption="Ed\<it"
