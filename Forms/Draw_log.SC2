		*			ThisForm.txtBHN6.Value 			= PrepareSQLnum(tmpNEW.BHN6,'BHN',3,0)
					ThisForm.txttLoc6.Value			= ShowSQLtxt(tmpNEW.tLoc6,'tLoc',1)
		
					ThisForm.txtTensile7.Value 		= PrepareSQLnum(tmpNEW.Tensile7,'Tensile',6,0)
