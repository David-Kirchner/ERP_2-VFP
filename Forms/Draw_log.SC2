	PROCEDURE spnSpnlot.Valid
		PRIVATE nID,nSPNLOT
		nID = ThisForm.txtID.Value
		nSPNLOT = This.Value
		
		IF NOT USED('Draw_log')
			ThisForm.LoadLog()
		ENDIF
		
		SELECT Draw_log
		LOCATE FOR LOT = nSPNLOT 
		IF FOUND('Draw_log')	
			ThisForm.Refresh_Draw_log()
		ELSE
			IF ThisForm.lSeeAll
				WAIT WINDOW 'LOT # NOT FOUND' NOWAIT
			ELSE
				IF ThisForm.getAllrecords()
					SELECT Draw_log
					LOCATE FOR LOT = nSPNLOT 
					IF FOUND()	
						ThisForm.Refresh_Draw_log()
					ELSE
						MESSAGEBOX("Lot number not found",48,"Missing record")
					ENDIF
				ELSE
					MESSAGEBOX("Lot number not found",48,"Missing record")
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE spnSpnlot.When
		RETURN !ThisForm.isediting
		
		PRIVATE nLot
		nLot = ThisForm.txtLot.Value
		
		IF nLot > 0
			This.Value = nLot
		ELSE
			This.Value = 1
		ENDIF
	ENDPROC

	PROCEDURE txtAlloyname.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtAlloyname.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtAlloyname.Valid
		PRIVATE cCurAlloy,cAlloyStandard
		cCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(cCurAlloy)
			cAlloyStandard = GetAlloyStandard( cCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

