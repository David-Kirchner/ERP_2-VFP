					ThisForm.txtRed_area7.Value 	= PrepareSQLnum(tmpNEW.Red_Area7,'Red_Area',4,1)
		*			ThisForm.txtRockwell7.Value 	= ShowSQLtxt(tmpNEW.Rockwell7,'Rockwell',4)
		*			ThisForm.txtBHN7.Value 			= PrepareSQLnum(tmpNEW.BHN7,'BHN',3,0)
					ThisForm.txttLoc7.Value			= ShowSQLtxt(tmpNEW.tLoc7,'tLoc',1)
					
					ThisForm.txtAC_ID.Value 		= PrepareSQLnum(tmpNEW.AC_ID,'AC_ID',-3)
					
					ThisForm.chkPassed.Value 		= PrepareSQLchk(tmpNEW.Passed,'Passed')
					ThisForm.chkCustomerMat.Value 	= PrepareSQLchk(tmpNEW.CustomerMat,'CustomerMat')
					ThisForm.chkChart.Value 		= PrepareSQLchk(tmpNEW.Chart,'Chart')
					ThisForm.txtHTRockwell.Value 	= ShowSQLtxt(tmpNEW.HTRockwell,'HTRockwell',4)
					ThisForm.txtHTBHN.Value 		= PrepareSQLnum(tmpNEW.HTBHN,'HTBHN',3)
					
					ThisForm.txtMinutes.Value 	= tmpNEW.Minutes
					ThisForm.cmbMachine.Value	= tmpNew.Machine
		
					ThisForm.txtID.Value			= tmpNEW.ID
					ThisForm.txtOper.Value			= ShowSQLtxt(tmpNEW.Oper,'Oper',10)
					ThisForm.txtLMA_Practice.Value	= ShowSQLtxt(tmpNEW.LMA_Practice,'LMA_Practice',7)
					ThisForm.txtLMA_Procedure.Value	= ShowSQLtxt(tmpNEW.LMA_Procedure,'LMA_Procedure',12)
					
					
				ENDIF
				USE IN tmpNEW 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pLot
		*DO FORM Forms\Draw_log WITH nLot
		
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('Draw_log')	
			USE IN Draw_log
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.Draw_log "
		*cSQL = cSQL + " WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Draw_log')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Draw_log')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Draw_log")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Draw_log")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Draw_log')
			RETURN
		ELSE
			*Code is also used in RefreshReceiving and Reload
			SELECT Draw_log
			INDEX ON LOT TAG LOT
			SET ORDER TO TAG LOT
			ThisForm.lSeeAll = .F.
			
		ENDIF
		
		*ThisForm.TableDetailName = "Draw_log_Detail"
		
		
		SELECT Draw_log
		*pCurRec = MIN( Recno(),RECCOUNT() )
		*SET ORDER TO TAG Lot
		
		GO BOTTOM
		
		IF VARTYPE(pLot) = 'N'
			IF pLot > 0
				LOCATE FOR Lot = pLot
				IF NOT FOUND()
					GO BOTTOM
				ENDIF
			ENDIF
		ENDIF
		
		
		ThisForm.spnSpnlot.Value = Draw_log.Lot
		ThisForm.Refresh_Draw_log()
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 1
			*try again
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
	ENDPROC

	PROCEDURE loadlog
		PARAMETERS pID
		*ThisForm.LoadLog(ID)
		
		
		IF VARTYPE(pID)!="N"
			pID = 0
		ENDIF
		
		IF USED('Draw_log')	
			USE IN Draw_log
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.Draw_log WITH(NOLOCK) WHERE DATE >= GETDATE()-365 ORDER BY LOT "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Draw_log')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Draw_log')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Draw_log")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Draw_log")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Draw_log')
			RETURN
		ELSE
			SELECT Draw_log
			INDEX ON LOT TAG LOT
			SET ORDER TO TAG LOT
			ThisForm.lSeeAll = .F.
			
			*BROWSE
			
		ENDIF
		
		IF pID = 0
			GO BOTTOM
		ELSE
			LOCATE FOR ID = pID
		ENDIF
		
		ThisForm.Refresh_Draw_log()
	ENDPROC

	PROCEDURE load_draw_labs		&& Used in InteractiveChange of Lab
		PRIVATE cSQL, nSQLEXEC
		*Loa_Draw_Lab()
		
		cSQL = "SELECT DISTINCT [LAB] FROM dbo.Draw_log WITH(NOLOCK) ORDER BY Lab "
		
		IF USED("Draw_Labs")
			SELECT Draw_Labs
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Draw_Labs')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Draw_Labs')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Draw_Labs")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Draw_Labs")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Draw_Labs')
		ENDIF
		
		
		IF USED("Draw_Labs")
			SELECT Draw_Labs
			INDEX ON UPPER(LAB) TAG UppLAB
		ENDIF
		
	ENDPROC

	PROCEDURE lothighvalue		&& Returns the highest Lot number for Lot spinner.
		
		PRIVATE nMaxLot 
		nMaxLot = 0
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpMaxLot')	
			USE IN tmpMaxLot
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT MAX(LOT) AS MaxLot FROM dbo.Draw_log "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMaxLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMaxLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMaxLot")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMaxLot')
		ELSE
			IF USED('tmpMaxLot')
				nMaxLot = tmpMaxLot.MaxLot
				USE IN tmpMaxLot
				RETURN nMaxLot
			ENDIF
		ENDIF
		 
	ENDPROC

	PROCEDURE Move
		LPARAMETERS nLeft, nTop, nWidth, nHeight
		
		IF WEXIST("frmLog_Detail")
			*does not work!!!
			frmLog_Detail.Top = ThisForm.Top
			frmLog_Detail.Left = ThisForm.Left + ThisForm.Width + 5
			*width 565
		ENDIF
		
		IF WEXIST("frmWO_Detail_View_Notes")
			*does not work!!!
			*frmWO_Detail_View_Notes.Top = ThisForm.Top
			*frmLog_Detail.Left = ThisForm.Left + ThisForm.Width + 5
		ENDIF
	ENDPROC

	PROCEDURE refreshlablog		&& Prints Screen
		*ThisForm.RefreshLabLog()
		SELECT Draw_log
		
		**Edits here also need to be done in GetLatestData()
		ThisForm.txtAlloyName.Value = Draw_log.AlloyName
		ThisForm.txtDate.Value 		= TTOD(Draw_log.Date)
