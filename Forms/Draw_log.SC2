	PROCEDURE cmdClose.Valid
		IF WEXIST("frmLog_Detail")
			RELEASE WINDOWS frmLog_Detail
		ENDIF
		
		IF WEXIST("frmDraw_Hard_Prof")
			RELEASE WINDOWS frmDraw_Hard_Prof
		ENDIF
		
		THISFORM.Release
		
			m.bailout=.T.	&&this is needed if used with FoxApp
		*!*		WAIT WINDOW 'BACKING UP' NOWAIT
		*!*		IF USED('Draw_log')
		*!*			SELECT Draw_log
		*!*			m.cursafe = set('safety')
		*!*			set safety off
		*!*			IF IIF(FILE('C:\Draw_log.DBF'),FDATE('C:\Draw_log.dbf'),DATE()-1) <DATE()
		*!*				COPY TO c:\Draw_log.dbf
		*!*			ENDIF
		*!*			DO CASE
		*!*			CASE NOT FILE('Draw_log Backup.dbf')
		*!*				COPY TO "Draw_log Backup.dbf"
		*!*			CASE FDATE('Draw_log Backup.dbf') < FDATE("c:\Draw_log.DBF")
		*!*				COPY TO "Draw_log Backup.dbf"
		*!*			CASE FDATE('Draw_log Backup.dbf') = FDATE("c:\Draw_log.DBF") AND FTIME("c:\Draw_log.DBF") > FTIME("Draw_log Backup.dbf")
		*!*				COPY TO "Draw_log Backup.dbf"
		*!*			ENDCASE
		*!*			set safety &cursafe
		*!*			USE
		*!*		ENDIF
		*!*		WAIT CLEAR
		*	m.salesp = m.salespp
			*replace the m.salesp value
		*!*		
		*!*		CLEAR READ
		*!*		IF USED('inquire')
		*!*			RETURN
		*!*		ELSE
		*!*			return
		*!*		ENDIF
		
	ENDPROC

	PROCEDURE cmdDel.Valid
		SELECT Draw_log
		IF ThisForm.isediting 	&&cancel record
			IF ThisForm.IsAdding
		*		=TABLEREVERT()
				GO BOTTOM 
				ThisForm.Refresh_Draw_log()
				ThisForm.Refresh
			ENDIF
			ThisForm.edtNotes.ReadOnly = .T.
			
			ThisForm.isediting=.F.
			ThisForm.IsAdding=.F.
		*	UNLOCK
		
			this.Caption="\<Delete"
			ThisForm.cmdEdit.Caption="\<Edit"
			ThisForm.cmdTop.enabled = .T.
			ThisForm.cmdPrev.enabled = .T.
			ThisForm.cmdNext.enabled = .T.
			ThisForm.cmdEnd.enabled = .T.
			ThisForm.cmdSeeAll.enabled = .T.
			ThisForm.cmdCert.enabled = .T.
			ThisForm.cmdSO.enabled = .T.
			ThisForm.cmdRA.enabled = .T.
		*	ThisForm.cmdSsheet.enabled = .T.
			ThisForm.cmdBrow.enabled = .T.
			ThisForm.cmdReport.enabled = .T.
			ThisForm.cmdBalloy.enabled = .T.
			ThisForm.cmdClone.enabled = .T.
			ThisForm.cmdAdd.enabled = .T.
			ThisForm.cmdPrint.enabled = .T.
			ThisForm.cmdClose.enabled = .T.
			ThisForm.cmdPDF.Enabled = .T.
			ThisForm.cmdStockLst.Enabled = .T.
		*	ThisForm.cmdDrawSched.Enabled = .T.
		
			WAIT WINDOW 'Cancelled' NOWAIT
			thisform.Refresh
		
		ELSE
			SELECT Draw_log 
			
			IF MESSAGEBOX("Are you sure you want to Delete?",32,"Delete LOT") !=6
				RETURN -1
			ENDIF
			
			IF NOT HavePermission('DeleteMFGlog',.T.)
				MESSAGEBOX('You are not allowed to Delete')
				RETURN -1
			ENDIF
			
			
			PRIVATE nID, cSQL, nSQLEXEC 
			nID = ThisForm.txtID.Value
			
			IF nID > 0
				cSQL = "DELETE FROM dbo.Draw_log WHERE ID ="+STR(nID)
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC )
				ELSE
					WAIT WINDOW 'Deleted record!' NOWAIT
					ThisForm.LoadLog()			
				ENDIF
				
			ENDIF
		
		*		IF EOF()
		*			WAIT WINDOW 'End of file.' NOWAIT
		*			GO BOTTOM
		*		ENDIF
			
		
			
			thisform.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE cmdDrawSched.Click
		PRIVATE pinID, pMach, pLot, poutID
		pinID = PrepareSQLnum(ThisForm.txtSched.Value,'Sched',-3)
		pMach = 'Draw Bench'
		pLot  = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		
		DO FORM Forms\Draw_Sched WITH pinID, pMach, pLot TO poutID
		*TO poutID
		
		IF VARTYPE(poutID) = "N"
			IF poutID > 0
				IF pinID = 0
					ThisForm.txtSched.Value = poutID
				ELSE
					IF pinID <> poutID
						IF MESSAGEBOX("Do you want to store Draw Sched ID:"+STR(poutID)+" to this log?",0+4,"Save Schedule number")
							ThisForm.txtSched.Value = poutID
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdEdit.Valid
