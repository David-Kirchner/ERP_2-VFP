			PRIVATE curgrec
			curgrec = RECNO('Draw_log')
			IF curgrec <= RECCOUNT('Draw_log')
				REPORT FORM reports\Draw_log RECORD (curgrec) TO PRINT PROMPT NOCONSOLE
				SELECT Draw_log
				GO curgrec
			ELSE
				MESSAGEBOX('Record pointer off!'+CHR(13)+'Try to go prev and next to fix.',0+16,"Not on a record.")
			ENDIF
		ELSE
			MESSAGEBOX('Record pointer off!'+CHR(13)+'Try to go prev and next to fix.',0+16,"Not on a record.")
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdRA.Valid
		SELECT Draw_log
		DO CASE
		CASE FILE('Forms\RedArea.SCX')
			DO FORM Forms\RedArea
		OTHERWISE
			redarea=LOCFILE("redarea","EXE","Find Reduction of Area")
			IF "REDAREA" $ UPPER(redarea)
				DO FORM (redarea)
			ELSE
				WAIT WINDOW 'Reduction of Area Program not found' NOWAIT
			ENDIF
		ENDCASE
		SELECT Draw_log
		
	ENDPROC

