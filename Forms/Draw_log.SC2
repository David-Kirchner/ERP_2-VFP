	PROCEDURE lblLot.Click
		IF NOT THISFORM.isediting
			RETURN .F.
		ENDIF
		
		
		PRIVATE nLot
		
		nLot = ThisForm.txtLot.Value
		IF nLot > 0
			MESSAGEBOX("Lot already has a value"+CHR(13)+"Zero out Lot and try again!",0+48,'Cannot overwrite Lot')
			RETURN
		ENDIF
		IF NOT THISFORM.isediting
			RETURN .F.
		ENDIF
		
		  
		IF USED('tmpCountLot')	
			USE IN tmpCountLot
		ENDIF
		
		cSQL = "SELECT MAX(Lot) AS MaxLot FROM dbo.Draw_log"
				
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
		ELSE
			IF USED('tmpCountLot')
				IF tmpCountLot.MaxLot > 0
				
					ThisForm.txtLot.Value = tmpCountLot.MaxLot
					ThisForm.Lots.Caption = '1'
					
				ENDIF
				USE IN tmpCountLot 
			ENDIF
		ENDIF
		
	ENDPROC

