	ENDPROC

	PROCEDURE txtSched.Valid
		PRIVATE nCurlot, cCurheat
		nCurlot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		*cCurheat = PrepareSQLtxt(ThisForm.txtHEAT.Value,'Heat',50)
		
		IF nCurlot > 0 
		  *LOCATE FOR Draw_log.lot = m.curlot AND NOT Draw_log.heat = m.curheat
		  
			IF USED('tmpCountLot')	
				USE IN tmpCountLot
			ENDIF
		*SELECT dbo.f_GetMachine_Table( dbo.f_GetMachine_init('GFM') )
		*SELECT dbo.f_GetMachine_Caption('G')
			cSQL = "SELECT ID FROM dbo.Draw_Sched "
			cSQL = cSQL + " WHERE Lot ="+STR(nCurLot)
			cSQL = cSQL + " AND Machine = dbo.f_GetMachine_Caption('D')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
			ELSE
				IF USED('tmpCountLot')
					IF tmpCountLot.ID > 0
						
					ENDIF
					USE IN tmpCountLot 
				ENDIF
			ENDIF
		
		ENDIF
		
	ENDPROC

