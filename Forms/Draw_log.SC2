	PROCEDURE lblTestPO.Click
		IF ThisForm.isediting
			PRIVATE cPOItem, cSQL, nSQLEXEC 
			
			cPOItem = PrepareSQLtxt(ThisForm.txtTestPoItem.Value,'POitem',12)
			IF Proper_PO_item_PO(cPOitem) > 0
				DO FORM Forms\ChoosePOitem WITH Proper_PO_item_PO(cPOitem) TO cPOItem
			ENDIF
			
			IF Proper_PO_item(cPOItem) != Proper_PO_item('')
				ThisForm.txtTestPoItem.Value = cPOItem
				
				PRIVATE nHPApo
				nHPApo = VAL(cPOitem)
				
				IF USED('tmpCompanyPO')
					USE IN tmpCompanyPO
				ENDIF
				SELECT 0
		
			
				cSQL = "SELECT Company,OrderDate FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE HPApo = "+STR(nHPApo)
		
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCompanyPO' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCompanyPO' )
				ENDDO
				IF nSQLEXEC < 0  &&Try again. Problem query
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCompanyPO' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,  cSQL, 'tmpCompanyPO' )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpCompanyPO' )
				ENDIF
				
				
				IF USED('tmpCompanyPO')
					IF RECCOUNT('tmpCompanyPO') > 0
						IF NOT EMPTY(tmpCompanyPO.Company)
							ThisForm.txtLab.Value = tmpCompanyPO.Company
						ENDIF
						ThisForm.txtTestSent.Value = PrepareSQLdate(tmpCompanyPO.OrderDate,'OrderDate')
					ENDIF
					USE IN tmpCompanyPO
				ENDIF
				
			ENDIF
		ENDIF
	ENDPROC

