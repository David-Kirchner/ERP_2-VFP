	PROCEDURE lblAcctCosting.Click
		PRIVATE lPassed
		lPassed		= PrepareSQLlogic(ThisForm.chkPassed.Value,'Passed',.F.)
		PRIVATE nAcctCosting_ID, lAC_cmplt
		nAcctCosting_ID = PrepareSQLnum(ThisForm.txtAC_ID.Value,'AC_ID',-3)
		lAC_cmplt	= PrepareSQLlogic(ThisForm.chkAC_cmplt.Value,'AC_cmplt',.F.)
		
		PRIVATE nID
		nID	= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
			
			
		IF nAcctCosting_ID > 0
			IF lAC_cmplt
				WAIT WINDOW "Accounting Costing is Complete" NOWAIT
				RETURN
			ELSE
				IF MESSAGEBOX("The 'Accounting Costing' has already begun."+CHR(13)+" Do you want to resend Email to Accoutning?",3+32+256,"reEmail or Return") = 6
					AcctCosting_Alert(nAcctCosting_ID,"Draw_log",nID,ThisForm.nConnHandle)
				ENDIF
			ENDIF
			
			RETURN 
		ENDIF
		
		IF lPassed
			*SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
			nAcctCosting_ID = AcctCosting_Start() 
		ELSE
			PRIVATE nMess
			nMess = MESSAGEBOX("This lot is not listed as 'Passed'"+CHR(13)+"Are you sure you want to mark this"+CHR(13)+"as ready for Accouting Costing?",4+32,"Ready for Accounting Costing?")
			IF nMess = 6
				nAcctCosting_ID = AcctCosting_Start()
			ENDIF
		ENDIF
		
		IF nAcctCosting_ID > 0
			ThisForm.txtAC_ID.Value = nAcctCosting_ID
		*	ThisForm.txtAcctCosting.Value = AcctCosting_get_dtCreate_ID(nAcctCosting_ID,ThisForm.nConnhandle)
			
			SELECT Draw_log
		*	REPLACE AcctCosting WITH ThisForm.txtAcctCosting.Value
			REPLACE AC_ID WITH nAcctCosting_ID
			
			
			PRIVATE cSQL
			cSQL = "UPDATE dbo.Draw_log SET "
			cSQL = cSQL + " AC_ID="+STR(nAcctCosting_ID)
			cSQL = cSQL + " WHERE ID="+STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				IF AcctCosting_Alert(nAcctCosting_ID,"Draw_log",nID,ThisForm.nConnHandle)
					WAIT WINDOW 'Updated Log!' NOWAIT
				ENDIF
			ENDIF
			
			WAIT WINDOW 'Sent to Accounting' NOWAIT
		ENDIF
	ENDPROC

