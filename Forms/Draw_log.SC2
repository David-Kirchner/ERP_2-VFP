	PROCEDURE cmdAddTC.Click
		PRIVATE nID, nLot, nLotID, cLotID
		nID	= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		IF nID < 1
			MESSAGEBOX("Did not find the ID to Update")
			RETURN
		ENDIF
		nLot = PrepareSQLnum(ThisForm.txtLot.Value,'ID',-3)
		nLotID = PrepareSQLnum(ThisForm.Lots.Caption,'Lots',-3)
		IF nLot > 0
			IF nLotID = 0
				cLotID = ALLTRIM(STR(nLot))
			ELSE
				IF nLotID = 1
					cLotID = ALLTRIM(STR(nLot))
				ELSE
					cLotID = ALLTRIM(STR(nLot))+"-"+ALLTRIM(STR(nLotID))
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Did not find the Lot to Update")
			RETURN
		ENDIF
		
		
		DO FORM Forms\ThermalCoupleUseAdd.scx WITH 'G',nID,nLot,nLotID
		
		SELECT Draw_log
		
	ENDPROC

	PROCEDURE cmdBalloy.Message
		RETURN 'Locate a record of the same alloy.'
	ENDPROC

	PROCEDURE cmdBalloy.Valid
		SELECT Draw_log
		Private cAlloyName
		cAlloyName = Draw_log.Alloyname
		
		BROWSE FOR alloyname = cAlloyName
		SCATTER MEMO MEMVAR
		
		ThisForm.Refresh_Draw_log()
		
	ENDPROC

	PROCEDURE cmdBrow.Message
		RETURN 'Browse for records.'
	ENDPROC

	PROCEDURE cmdBrow.Valid
		SELECT Draw_log
		browse
		ThisForm.Refresh_Draw_log()
		
	ENDPROC

	PROCEDURE cmdCert.Valid
		SELECT Draw_log
		*DO CASE
		*CASE FILE('\program files\VFP\ERPCert\Forms\ERPCert3.scx')
		*!*		IF SET('SAFETY') = "ON"
		*!*			SET SAFETY OFF
		*!*		ENDIF
		*!*		RELEASE ALL LIKE STOR*
		*!*		STORheat = Draw_log.Heat
		*!*		STORlot  = Draw_log.Lot
		*!*		SAVE ALL LIKE STOR* TO C:\HEATLOT.MEM
		*!*		SET SAFETY ON
		*	ThisForm.AlwaysOnTop = .F.
		*	ThisForm.AlwaysOnBottom = .T.
			DO FORM 'Forms\ERP_CERTS' WITH Draw_log.Heat, Draw_log.Lot, "DRAW"
		*	ThisForm.AlwaysOnTop = .T.
		*	ThisForm.AlwaysOnBottom = .F.
		*!*	RELEASE ALL LIKE STOR*
		
		
		IF USED('Draw_log')
			SELECT Draw_log
		ELSE
			*Refresh Data
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "SELECT * FROM dbo.Draw_log ORDER BY LOT "
				
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Draw_log')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Draw_log')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Draw_log")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Draw_log")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Draw_log')
				RETURN
			ELSE
				MESSAGEBOX("All records are now loaded",0+64,"See All Draw_log records!")
				SELECT Draw_log
				INDEX ON LOT TAG LOT
				SET ORDER TO TAG LOT
			ENDIF
		
			GO BOTTOM
			ThisForm.Refresh_Draw_log()
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdChartData.Click
		PRIVATE nID, nLot, nLotID, cLotID
		nID	= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		IF nID < 1
			MESSAGEBOX("Did not find the ID to Update")
			RETURN
		ENDIF
		nLot = PrepareSQLnum(ThisForm.txtLot.Value,'ID',-3)
		nLotID = PrepareSQLnum(ThisForm.Lots.Caption,'Lots',-3)
		IF nLot > 0
			IF nLotID = 0
				cLotID = ALLTRIM(STR(nLot))
			ELSE
				IF nLotID = 1
					cLotID = ALLTRIM(STR(nLot))
				ELSE
					cLotID = ALLTRIM(STR(nLot))+"-"+ALLTRIM(STR(nLotID))
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Did not find the Lot to Update")
			RETURN
		ENDIF
		
		PRIVATE cFileName, cFileContents
		cFileName = ''
		
		IF This.Caption = "Add"
			*Get File
			***breaks over 240 Character!!
			cFileName = GETFILE("CSV" , "Find the Chart Data", "Find", 0 , "Chart Data as CSV")
			IF VARTYPE(cFileName) = "C"
				IF NOT ".CSV" $ cFileName
					MESSAGEBOX("No CSV file")
					RETURN
				ENDIF
				IF FILE(cFileName)
		
					Local nFileHandle,nSize,cString
					nFileHandle = FOPEN(cFileName)
					* Seek to end of file to determine number of bytes in the file.
					nSize =  FSEEK(nFileHandle, 0, 2)     && Move pointer to EOF
					IF nSize <= 0
						* If file is empty, display an error message.
						WAIT WINDOW "This file is empty!" NOWAIT
						RETURN
					ELSE
						* If file is not empty, store the file's contents in memory
						* and display the text in the main Visual FoxPro window.
						= FSEEK(nFileHandle, 0, 0)      && Move pointer to BOF
						cFileContents = FREAD(nFileHandle, nSize)
					ENDIF
					= FCLOSE(nFileHandle)         && Close the file
		
					cFileContents  = STRTRAN(cFileContents ,"'","''")
					
					PRIVATE cSQL
					cSQL = "UPDATE dbo.Draw_log SET "
					cSQL = cSQL + " ChartData = '1'"
					cSQL = cSQL + " WHERE ID="+STR(nID)
		
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
					ELSE
						cSQL = "INSERT INTO dbo.Log_Charts ([Log],[LogID],[Lot],[LotID],[ChartData]) VALUES ("
						cSQL = cSQL + "'G'"
						cSQL = cSQL + ","+ALLTRIM(STR(nID))
						cSQL = cSQL + ","+ALLTRIM(STR(nLot))
						cSQL = cSQL + ","+ALLTRIM(STR(nLotID))
						cSQL = cSQL + ",'"+cFileContents+"'"
						cSQL = cSQL + " )"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
						ELSE
							WAIT WINDOW 'Updated!' NOWAIT
							This.Caption = "Export"
							UPDATE Draw_log SET ChartData = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		
		ELSE
			* This.Caption = "Export"
			*Get File
		
			***breaks over 240 Character!!
			Local nFileHandle
		
			cFileName = "Draw_log "+cLotID
			IF "\MEM" $ SYS(2003)
				cFileName = SYS(5)+SYS(2003) +"\"+cFileName + ".CSV"
			ELSE
				cFileName = SYS(5)+SYS(2003) +"\MEM\"+cFileName + ".CSV"
			ENDIF
		
			IF FILE(cFileName)
				IF MESSAGEBOX("File '"+cFileName+"'"+CHR(13)+"already exits."+CHR(10)+"Do you want to add this data to the file?",0+4+32+256,"Append to file?") != 6
					DELETE FILE (cFileName) RECYCLE
				ENDIF
			ENDIF		
					
					
			IF FILE(cFileName)
				nFileHandle = FOPEN(cFileName,11)
				IF nFileHandle < 0
					WAIT 'Cannot open or create output file' WINDOW 
				ELSE
					IF USED('Log_Charts')
						USE IN Log_Charts
					ENDIF
					SELECT 0
					
					cSQL = "SELECT [ChartData] FROM dbo.Log_Charts WHERE "
					cSQL = cSQL + "[Log]='G'"
					cSQL = cSQL + " AND [LogID]="+ALLTRIM(STR(nID))
					cSQL = cSQL + " AND [Lot]="+ALLTRIM(STR(nLot))
					cSQL = cSQL + " AND [LotID]="+ALLTRIM(STR(nLotID))
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'Log_Charts' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL,'Log_Charts'  )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF	
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'Log_Charts' )
					ELSE
						IF USED('Log_Charts')
							IF VARTYPE(Log_Charts.ChartData) = "C"
								= FWRITE(nFileHandle, Log_Charts.ChartData )
							ENDIF
							USE IN Log_Charts
						ENDIF
					ENDIF
					
					= FCLOSE(nFileHandle)         && Close the file
					WAIT WINDOW "File is Ready '"+cFileName+"'" NOWAIT
					
					IF "\MEM" $ SYS(2003)
						RUN ["EXPLORER.exe "]+SYS(5)+SYS(2003)+[\"]  /N
					ELSE
						RUN ["EXPLORER.exe "]+SYS(5)+SYS(2003)+[\MEM\"]  /N
					ENDIF
					
				ENDIF
			ELSE
				
				nFileHandle= FCREATE(cFileName,0)
				IF nFileHandle < 0
					WAIT WINDOW 'Cannot open or create output file' 
				ELSE
					IF USED('Log_Charts')
						USE IN Log_Charts
					ENDIF
					SELECT 0
					
					cSQL = "SELECT [ChartData] FROM dbo.Log_Charts WHERE "
					*[ChartData]
					cSQL = cSQL + "[Log]='G'"
					cSQL = cSQL + " AND [LogID]="+ALLTRIM(STR(nID))
					cSQL = cSQL + " AND [Lot]="+ALLTRIM(STR(nLot))
					cSQL = cSQL + " AND [LotID]="+ALLTRIM(STR(nLotID))
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'Log_Charts' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL,'Log_Charts'  )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'Log_Charts' )
					ELSE
						IF USED('Log_Charts')
							IF VARTYPE(Log_Charts.ChartData) = "C"
								= FWRITE(nFileHandle, Log_Charts.ChartData )
							ENDIF
							USE IN Log_Charts
						ENDIF
					ENDIF
					
					= FCLOSE(nFileHandle)         && Close the file
					WAIT WINDOW "Created File '"+cFileName+"'" NOWAIT
					IF "\MEM" $ SYS(2003)
						RUN ["EXPLORER.exe "]+SYS(5)+SYS(2003)+[\"]  /N
					ELSE
						RUN ["EXPLORER.exe "]+SYS(5)+SYS(2003)+[\MEM\"]  /N
					ENDIF
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

