		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS nSO, pConnHandle
		
		*DO FORM Forms\AddEditDOdetails WITH nSO,Conn
		
		IF VARTYPE(nSO) != "N"
		*	MESSAGEBOX("No SO.",16,'')
		*	RETURN ''
			nSO = 64606
		ENDIF
		
		
		IF TYPE("pConnHandle") = "N"
			IF pConnHandle > 0
				ThisForm.nConnHandle = pConnHandle
			ELSE
				ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
				IF ThisForm.nConnHandle > 0
					ThisForm.CloseConn = .T.
				ELSE
					MESSAGEBOX("Could not connect to SQL")
					RETURN ''
				ENDIF
			ENDIF		
		ELSE
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			IF ThisForm.nConnHandle > 0
				ThisForm.CloseConn = .T.
			ELSE
				MESSAGEBOX("Could not connect to SQL")
				RETURN ''
			ENDIF
		ENDIF
		
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF USED('tmpSales_Status')
			USE IN tmpSales_Status
		ENDIF
		
		SELECT 0
		cSQL = "SELECT [ID],[SOitem],[SalesNum],[Who],[What],[When],[Comment] "
		cSQL = cSQL + " FROM dbo.Sales_Status "
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(nSO))
		cSQL = cSQL + " ORDER BY [WHEN] "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales_Status")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Status')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Status')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Status')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Status')
		ENDIF
		
		IF NOT USED('tmpSales_Status')
			MESSAGEBOX( "Could not loading the table.",16,"Program Error")
			RETURN ""
		ENDIF
		
		SELECT tmpSales_Status
		
		
		ThisForm.grid1.RecordSource = "tmpSales_Status"
		*ThisForm.Grid1.Column1.ControlSource = tmpSales_Status.ID
		*ThisForm.Grid1.Column1.Text1.ControlSource = tmpSales_Status.ID
		
		ThisForm.Grid1.AfterRowColChange
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		IF USED('CustomerID')
			USE IN CustomerID
		ENDIF
		
		RETURN THISFORM.cReturnValue
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF THIS.Caption = "Add"
			*Add 
			ThisForm.edtComment.ReadOnly = .F.
			ThisForm.edtComment.Value = ""
			
			THIS.Caption = "Save"
		ELSE
			*Save
			ThisForm.edtComment.ReadOnly = .T.
			PRIVATE cComment,cSOitem,nSO,cWhat
			cComment = PrepareSQLtxt(ThisForm.edtComment.Value,'Comment',255)
			cSOitem	= ThisForm.txtSOitem.Value
			nSO		= ThisForm.txtSalesnum.Value
			cWhat	= "Edited SO"
			
			Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, ThisForm.nConnHandle )
				
			THIS.Caption = "Add"
				
			ThisForm.grid1.RecordSource = ""
			
			IF USED('tmpSales_Status')
				USE IN tmpSales_Status
			ENDIF
		
			SELECT 0
			cSQL = "SELECT [ID],[SOitem],[SalesNum],[Who],[What],[When],[Comment] "
			cSQL = cSQL + " FROM dbo.Sales_Status "
			cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(nSO))
			cSQL = cSQL + " ORDER BY [WHEN] "
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales_Status")
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Status')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Status')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Status')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Status')
			ENDIF
		
			IF NOT USED('tmpSales_Status')
				MESSAGEBOX( "Could not loading the table.",16,"Program Error")
				RETURN ""
			ENDIF
		
			SELECT tmpSales_Status
			GO BOTTOM
		
			ThisForm.grid1.RecordSource = "tmpSales_Status"
			*ThisForm.Grid1.Column1.ControlSource = tmpSales_Status.ID
			*ThisForm.Grid1.Column1.Text1.ControlSource = tmpSales_Status.ID
		
			ThisForm.Grid1.AfterRowColChange
		
		ENDIF
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.txtsalesNum.Value = tmpSales_Status.SalesNum
		ThisForm.txtSOitem.Value = tmpSales_Status.Soitem
		ThisForm.txtWho.Value = tmpSales_Status.Who
		ThisForm.txtWhat.Value = tmpSales_Status.What
		ThisForm.txtWhen.Value = tmpSales_Status.When
		ThisForm.edtComment.Value = tmpSales_Status.Comment
		
	ENDPROC

ENDDEFINE
