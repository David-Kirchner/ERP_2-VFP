	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pCompany
		
		IF VARTYPE(pCompany) = "C"
			IF NOT EMPTY(pCompany)
				IF USED('Qcompany')
					SELECT Qcompany
					LOCATE FOR Company = pCompany
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF USED('Qcompany')
			USE IN Qcompany
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer "
		cSQL = cSQL + " ,Xcomp, [Status], Home, Car, [Notes], Customer, PU, ID "
		cSQL = cSQL + " FROM dbo.QuickCompany "
		cSQL = cSQL + " ORDER BY Company,Name"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Qcompany' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Qcompany' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Qcompany")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Qcompany")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Qcompany')
		ENDIF
		
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETERS pWhat
		*ThisForm.SaveAdd()  'Add' 'Save'
		
		*QuickCompany
		PRIVATE cCustomer,cCompany,cName
		PRIVATE cCountryc,cPhone,cPhone_ext,cFax,cEmail
		PRIVATE	cStatus,cHome,cCar,cNotes,dLastEdit,nID
		
		*!*	[customer] [char](20) NULL,
		*!*	[company] [varchar](30) NOT NULL,
		*!*	[name] [varchar](25) NULL,
		*!*	[countryc] [varchar](10) NULL,
		*!*	[phone] [varchar](10) NULL,
		*!*	[phone_ext] [varchar](6) NULL,
		*!*	[fax] [varchar](10) NULL,
		*!*	[email] [varchar](60) NULL,
		*!*	[xcomp] [char](14) NOT NULL,
		*!*	[xCompName] [char](18) NOT NULL,
		*!*	[status] [varchar](10) NULL,
		*!*	[home] [varchar](10) NULL,
		*!*	[car] [varchar](10) NULL,
		*!*	[notes] [text] NULL,
		*!*	[LastEdit] [smalldatetime] NULL,
		*!*	[ID]
		
		
		cCompany	= PrepareSQLtxt(ThisForm.COMPANY1.Value,'Company',20)
		cName		= PrepareSQLtxt(ThisForm.NAME1.Value,'Name',25)
		cCountryc	= PrepareSQLtxt(ThisForm.Countryc1.Value,'Countryc',10)
		cPhone		= PrepareSQLtxt(ThisForm.Phone1.Value,'Phone',10)
		cPhone_ext	= PrepareSQLtxt(ThisForm.phone_ext1.Value,'Phone_Ext',6)
		cFax		= PrepareSQLtxt(ThisForm.fax1.Value,'Fax',10)
		cEmail		= PrepareSQLtxt(ThisForm.email1.Value,'Email',60)
		cStatus		= PrepareSQLtxt(ThisForm.status1.Value,'status',10)
		cHome		= PrepareSQLtxt(ThisForm.home1.Value,'home',10)
		cCar		= PrepareSQLtxt(ThisForm.home1.Value,'home',10)
		cNotes		= PrepareSQLtxt(ThisForm.notes1.Value,'notes',-1)
		cPU			= PrepareSQLtxt(ThisForm.PU1.Value,'PU',1)
		*nID			= PrepareSQLnum(ThisForm.email1.Value,'ID',-3)
		*cCustomer	= PrepareSQLtxt(ThisForm.CUSTOMER1.Value,'Customer',20)
		nID			= Qcompany.ID
		cCustomer	= Qcompany.Customer
		
		IF VARTYPE( pWhat ) != 'C'
			pWhat = ''
		ENDIF
		
		IF EMPTY(pWhat)
			RETURN .F.
		ENDIF
		
		IF UPPER(pWhat) = "ADD"
			cSQL = "INSERT INTO dbo.QuickCompany ("
			cSQL = cSQL + "Customer,Company,Name,Countryc,Phone,Phone_ext,Fax,Email,Status,Home,Car,Notes,PU"
			cSQL = cSQL + ") VALUES ("
			cSQL = cSQL + " '"+cCustomer+"'"
			cSQL = cSQL + ",'"+cCompany+"'"
			cSQL = cSQL + ",'"+cName+"'"
			cSQL = cSQL + ",'"+cCountryc+"'"
			cSQL = cSQL + ",'"+cPhone+"'"
			cSQL = cSQL + ",'"+cPhone_ext+"'"
			cSQL = cSQL + ",'"+cFax+"'"
			cSQL = cSQL + ",'"+cEmail+"'"
			cSQL = cSQL + ",'"+cStatus+"'"
			cSQL = cSQL + ",'"+cHome+"'"
			cSQL = cSQL + ",'"+cCar+"'"
			cSQL = cSQL + ",'"+cNotes+"'"
			cSQL = cSQL + ",'"+cPU+"'"
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC )
			ENDIF
			
		ENDIF
		IF UPPER(pWhat) = "SAVE"
			IF nID < 1
				MESSAGEBOX("No Control ID",0+16,"Cannot Update")
				RETURN
			ENDIF
		
			IF USED('Qcompany')
				USE IN Qcompany
			ENDIF
			
			cSQL = "UPDATE dbo.QuickCompany "
			cSQL = cSQL + "SET "
			cSQL = cSQL + " Customer = '"+cCustomer+"'"
			cSQL = cSQL + ",Company='"+cCompany+"'"
			cSQL = cSQL + ",Name='"+cName+"'"
			cSQL = cSQL + ",Countryc='"+cCountryc+"'"
			cSQL = cSQL + ",Phone='"+cPhone+"'"
			cSQL = cSQL + ",Phone_ext='"+cPhone_ext+"'"
			cSQL = cSQL + ",Fax='"+cFax+"'"
			cSQL = cSQL + ",Email='"+cEmail+"'"
			cSQL = cSQL + ",Status='"+cStatus+"'"
			cSQL = cSQL + ",Home='"+cHome+"'"
			cSQL = cSQL + ",Car='"+cCar+"'"
			cSQL = cSQL + ",Notes='"+cNotes+"'"
			cSQL = cSQL + ",PU='"+cPU+"'"
			cSQL = cSQL + " WHERE ID = "+STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle ,nSQLEXEC )
			ENDIF	
			
		ENDIF
		
		*Refresh table
		cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer "
		cSQL = cSQL + " ,Xcomp, [Status], Home, Car, [Notes], Customer, PU, ID "
		cSQL = cSQL + " FROM dbo.QuickCompany "
		cSQL = cSQL + " ORDER BY Company,Name"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Qcompany' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Qcompany' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Qcompany")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Qcompany")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Qcompany')
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('Qcompany')
			USE IN Qcompany
		ENDIF
		
		SQLDISCONNECT( ThisForm.nConnHandle )
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdAdd.Click
		IF THIS.Caption = "\<Save"
			ThisForm.SaveAdd("Save")
		
			ThisForm.xComp1.Enabled = .F.
		ELSE
			*Add
			ThisForm.SaveAdd("Add")
			*MESSAGEBOX("Cannot add here.",0+48,"No Add")
			
		ENDIF
		
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE BUTTONSET1.cmdDelete.Click
		#DEFINE MSGBOX_YES		6
		#DEFINE C_MSGBOX1		36
		C_DELETE_LOC = "Do you want to delete this record?"
		C_DELETE_LOC2 = "Remove work?"
		#DEFINE C_NOLOCK_LOC	"Record could not be deleted because it is being used by someone else."
		
		* Note: Cascading deletes should be handled via RI triggers in DBC!
		IF EMPTY(ALIAS())
			RETURN
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL, nID
		IF ThisForm.CloneMode
			C_DELETE_LOC = "Are you sure you want to remove this record?"
		ENDIF
		IF MESSAGEBOX(C_DELETE_LOC,C_MSGBOX1,C_DELETE_LOC2 ) = MSGBOX_YES
			*DELETE
		
			*See if a filter was used to refilter.
			PRIVATE m.cGetExpr
			m.cGetExpr = ""
			cGetExpr = SET('FILTER')
				
			nID = Qcompany.ID
				
			IF VARTYPE(nID) = "C"
				nID = VAL(nID)
			ENDIF
			IF nID < 1
				MESSAGEBOX("No Control ID",0+16,"Cannot Delete")
				RETURN
			ENDIF
		
			IF USED('Qcompany')
				USE IN Qcompany
			ENDIF
			
			cSQL = "DELETE FROM dbo.QuickCompany WHERE ID = "+STR(nID)
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle ,nSQLEXEC )
			ENDIF	
			
			cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer "
			cSQL = cSQL + " ,Xcomp, [Status], Home, Car, [Notes], Customer, PU, ID "
			cSQL = cSQL + " FROM dbo.QuickCompany "
			cSQL = cSQL + " ORDER BY Company,Name"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Qcompany' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Qcompany' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Qcompany")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Qcompany")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Qcompany')
			ENDIF
			
			**ThisForm.PriceTableReLoad(RECNO("PriceTable"))
			
			IF !EMPTY(m.cGetExpr)
				SET FILTER TO &cGetExpr
				LOCATE
				IF EOF() &&Last of Filter!
					SET FILTER TO
				ENDIF
			ENDIF
		
			THIS.Parent.ButtonRefresh()
			THIS.Parent.NavRefresh()
		ENDIF
		
		IF THISFORM.ShowWindow = 2 
			Activate Window (THISFORM.Name)
		ENDIF
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdEdit.Click
		IF THIS.Caption = "\<Edit"
		ELSE
			*Revert
		ENDIF
		
		** Reverting record
		IF THIS.Parent.EditMode
			* Go back to original place
			SELECT (THIS.Parent.OldAlias)
			IF RECCOUNT() < THIS.Parent.OldRec	&&added record at EOF()
				GO TOP
			ELSE
				GO THIS.Parent.OldRec
			ENDIF
		ELSE
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
		ENDIF
		
		** Editing record
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		THISFORM.LockScreen = .F.
		
		ThisForm.xComp1.Enabled = .F.
	ENDPROC

	PROCEDURE BUTTONSET1.cmdPrint.Click
		SELECT Vendor
		
		PRIVATE nVendCode
		nVendCode = qcompany.VendCode
		
		IF NOT EMPTY(nVendCode)
			ThisForm.Visible = .F.
		*	REPORT FORM \Reports\Vendor FOR VendCode = nVendCode Preview
			ThisForm.Visible = .T.
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdPeach.Click
		PRIVATE cCompany, cCustID
		cCompany= PrepareSQLtxt(Thisform.Company1.Value,'Company',50)
		cCustID = PrepareSQLtxt(ThisForm.Customer1.Value,'Customer',20)
		
		
		DO FORM forms\MatchCustomerID WITH cCustID, cCompany
		
		IF USED('Qcompany')
			USE IN Qcompany
		ENDIF
		SELECT 0
			
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer "
		cSQL = cSQL + " ,Xcomp, [Status], Home, Car, [Notes], Customer, PU, ID "
		cSQL = cSQL + " FROM dbo.QuickCompany "
		cSQL = cSQL + " ORDER BY Company,Name"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Qcompany' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Qcompany' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Qcompany")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Qcompany")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Qcompany')
		ENDIF
		
		SELECT Qcompany
		LOCATE FOR Company = cCompany
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE Command1.Click
		PRIVATE cCompany
		cCompany = PrepareSQLtxt(ThisForm.COMPANY1.Value,'Company',50)
		
		
		*cHyperLink = HTML_CompanyInfo(cCompany,.T.)
		
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_CompanyInfo(cCompany,.T.)
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(m.cHyperLink)
		RELEASE loHyperlink
	ENDPROC

	PROCEDURE XCOMP1.When
		This.Value=phone+SOUNDEX(name)
