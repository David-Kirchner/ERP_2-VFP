	PROCEDURE frmPORecvStock.SIZE_H1.Valid
		PRIVATE nTol, nDim1
		nTol = PrepareSQLnum(This.Value,'Size_H1',9,4)
		nDim1 = PrepareSQLnum(ThisForm.DIM11.Value,'Dim1',18,4)
		
		
		IF nTol > 0
			IF nDim1 > 0
				IF nDim1 > nTol
					*MESSAGEBOX( "The High Tolerence is usually higher than the DIM 1",0,"Caution")
					WAIT WINDOW "The High Tolerence is usually higher than the DIM 1" NOWAIT
				ENDIF
				IF  nTol - nDim1 > 1
					MESSAGEBOX( "The High Tolerence is usually closer to the DIM 1"+CHR(13)+"Dim1 = "+ALLTRIM(STR(nDim1))+CHR(13)+"Tol = "+ALLTRIM(STR(nTol)),0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF nTol < 0
				MESSAGEBOX( "The High Tolerence is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPORecvStock.SIZE_L1.GotFocus
		This.InputMask = "999999.9999"
	ENDPROC

	PROCEDURE frmPORecvStock.SIZE_L1.LostFocus
		This.InputMask = "999,999.9999"
	ENDPROC

	PROCEDURE frmPORecvStock.SIZE_L1.Valid
		PRIVATE nTol, nDim1
		nTol = PrepareSQLnum(This.Value,'Size_L1',9,4)
		nDim1 = PrepareSQLnum(ThisForm.DIM11.Value,'Dim1',18,4)
		
		IF nTol > 0
			IF nDim1 > 0
				IF nDim1 < nTol
					*MESSAGEBOX( "The Low Tolerence is usually below the DIM 1",0,"Caution")
					WAIT WINDOW "The Low Tolerence is usually below the DIM 1" NOWAIT
				ENDIF
			ENDIF
		ELSE
			IF nTol  < 0
				MESSAGEBOX( "The Low Tolerence is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

