	PROCEDURE frmReceive_Edit.cmdAdd.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		lReady2Save = ThisForm.CheckSave()
		
		
		IF lReady2Save
			IF nReceivingID = 0
				IF ThisForm.SaveAdd("ADD")
					ThisForm.Release
				ELSE
					RETURN .F.
				ENDIF
			ELSE
				IF ThisForm.SaveAdd("EDIT")
					ThisForm.Release
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			RETURN .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmReceive_Edit.cmdClear.Click
		ThisForm.ResetAddVars()	
		ThisForm.lClone = .F.
		*This.Parent.cmdAdd.Caption = "\<Save"
		
		*This.Parent.txtHpapo.Enabled = .T.
		*This.Parent.txtItempo.Enabled = .T.
		
		ThisForm.Refresh
		ThisForm.txtHpaPONum.SetFocus
	ENDPROC

	PROCEDURE frmReceive_Edit.cmdClear.Valid
		ThisForm.ResetAddVars()
		ThisForm.txtHeat.Value = '*'
		ThisForm.txtReceivingID.Value = 0
	ENDPROC

	PROCEDURE frmReceive_Edit.cmdClone.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		lReady2Save = ThisForm.CheckSave()
		
		
		IF lReady2Save
			IF nReceivingID = 0
				IF ThisForm.SaveAdd("ADDCLONE")
					IF NOT ThisForm.txtHeat.Value = '*'
						ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
					ENDIF
					ThisForm.txtReceivingID.Value = 0
					ThisForm.txtID_Master.Value = 0
					ThisForm.txtID_Detail.Value = 0
					ThisForm.txtID_Detail_Process.Value = 0
		
					MESSAGEBOX("Receive Saved."+CHR(13)+"This NEW ClONE screen is now ready"+CHR(13)+"to Edit and Save.",0,"Saved")
					
				ELSE
					RETURN .F.
				ENDIF
			ELSE
				IF ThisForm.SaveAdd("EDIT")
					IF NOT ThisForm.txtHeat.Value = '*'
						ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
					ENDIF
					ThisForm.txtReceivingID.Value = 0
					MESSAGEBOX("Edited Saved."+CHR(13)+"This is screen is now ready.",0,"Saved")
				ELSE
					RETURN .F.
				ENDIF		
			ENDIF
		ELSE
			IF MESSAGEBOX("Could not Save"+CHR(13)+"Do you want still need to clone (Y)"+CHR(13)+"a new receive?",4+32,"Clone NEW") = 6
				IF NOT ThisForm.txtHeat.Value = '*'
					ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
				ENDIF
		
				ThisForm.txtReceivingID.Value = 0
				ThisForm.txtID_Master.Value = 0
				ThisForm.txtID_Detail.Value = 0
				ThisForm.txtID_Detail_Process.Value = 0
				
				MESSAGEBOX("New receive Saved."+CHR(13)+"This is screen is now ready.",0,"Saved")
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.Init
		*!*	PARAMETERS pcWhat, pValue, pcHeat
		*!*	*DO FORM Forms\Receive_Edit WITH 'EDIT',nRID,''
		*!*	*DO FORM Forms\Receive_Edit WITH 'ADD','','' --create RID
		*!*	*DO FORM Forms\Receive_Edit WITH 'B_Process', pnID_Detail_process ,cHeat
		*!*	*DO FORM Forms\Receive_Edit WITH 'WO_Detail', nWO_Detail ,"ADD"  --Pass create to not just edit, force ADD
		*!*	*pcWhat = "ADD "EDIT "RMA "POitem "SOitem" tk_Detail "Brk_Detail "S_Process "B_Process" W_Process "WO_Detail "WO"
		
		*!*	IF VARTYPE(pcWhat)!="C"
		*!*		pcWhat=''
		*!*	ENDIF
		
		*!*	IF NOT ( VARTYPE(pValue)="C" OR VARTYPE(pValue)="N" )
		*!*		pValue=''
		*!*	ENDIF
		
		*!*	ThisForm.cWhat = pcWhat
		
		*!*	IF VARTYPE(pcHeat)!="C"
		*!*		pcHeat=''
		*!*	ENDIF
		*!*	ThisForm.cHeat = PrepareSQLtxt(pcHeat,'HEAT',50)
		*!*	IF ALLTRIM(UPPER(ThisForm.cHeat)) = "DUE IN"
		*!*		ThisForm.cHeat	= ""
		*!*	ENDIF
		
		*!*	ThisForm.txtReceivingID.Value = 0
		*!*	ThisForm.txtTBL.Value = ''
		
		*!*	DO CASE 
		*!*	CASE pcWhat = "ADD"
		*!*		ThisForm.ResetAddVars()
		*!*		ThisForm.cHeat = PrepareSQLtxt(pcHeat,'HEAT',50)	&&put Heat back in after ResetAddVars()
		*!*		
		*!*	CASE pcWhat = "EDIT"
		*!*		*ThisForm.txtReceivingID.Value = PrepareSQLtxt(pValue,'ReceivingID',-3)
		*!*		ThisForm.txtReceivingID.Value = PrepareSQLnum(pValue,'ReceivingID',-3)
		*!*		ThisForm.getBy_ReceivingID()
		*!*		
		*!*	CASE pcWhat = "RMA"
		*!*		ThisForm.nRMA = PrepareSQLnum(pValue,'RMA_No',-3)
		*!*		ThisForm.txtRMA_No.Value = PrepareSQLtxt(pValue,'RMA_No',-3)
		*!*		ThisForm.RMA_Receive()
		*!*		
		*!*	CASE pcWhat = "POitem"
		*!*		ThisForm.cPOitem = PrepareSQLtxt(pValue,'POitem',12)
		*!*		IF UPPER(pcHeat) = "ADD"
		*!*			ThisForm.cHeat = ""
		*!*			ThisForm.cWhat = "ADD"
		*!*		ENDIF
		*!*		ThisForm.GetPOitemDetail()
		
		*!*	CASE pcWhat = "SOitem"
		*!*		ThisForm.cSOitem = PrepareSQLtxt(pValue,'SOitem',10)
		*!*		IF UPPER(pcHeat) = "ADD"
		*!*			ThisForm.cHeat = ""
		*!*			ThisForm.cWhat = "ADD"
		*!*		ENDIF
		*!*		ThisForm.GetSoItemDetail()
		
		*!*	CASE pcWhat = "Stk_Detail"
		*!*		ThisForm.txtID_Detail.Value = PrepareSQLnum(pValue,'ID_Detail',-3)
		*!*		ThisForm.txtTBL.Value = "S"
		*!*		IF UPPER(pcHeat) = "ADD"
		*!*			ThisForm.cHeat = ""
		*!*			ThisForm.cWhat = "ADD"
		*!*		ENDIF
		*!*		ThisForm.GetBy_STK_Detail()
		*!*		
		*!*	CASE pcWhat = "Brk_Detail"
		*!*		ThisForm.txtID_Detail.Value = PrepareSQLnum(pValue,'ID_Detail',-3)
		*!*		ThisForm.txtTBL.Value = "B"
		*!*		IF UPPER(pcHeat) = "ADD"
		*!*			ThisForm.cHeat = ""
		*!*			ThisForm.cWhat = "ADD"
		*!*		ENDIF
		*!*		ThisForm.GetBy_STK_Detail()
		
		*!*	CASE pcWhat = "S_Process"
		*!*		ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(pValue,'ID_Detail_Process',-3)
		*!*	*	ThisForm.txtID_Detail.Value = 
		*!*	*	ThisForm.txtID_Master.Value = 
		*!*		ThisForm.txtTBL.Value = "S"
		*!*		IF UPPER(pcHeat) = "ADD"
		*!*			ThisForm.cHeat = ""
		*!*			ThisForm.cWhat = "ADD"
		*!*		ENDIF
		*!*		ThisForm.GetBy_STK_Detail_Process()
		*!*		
		*!*	CASE pcWhat = "B_Process"
		*!*		ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(pValue,'ID_Detail_Process',-3)
		*!*	*	ThisForm.txtID_Detail.Value = 
		*!*	*	ThisForm.txtID_Master.Value = 
		*!*		ThisForm.txtTBL.Value = "B"
		*!*		IF UPPER(pcHeat) = "ADD"
		*!*			ThisForm.cHeat = ""
		*!*			ThisForm.cWhat = "ADD"
		*!*		ENDIF
		*!*		ThisForm.GetBy_STK_Detail_Process()
		*!*		
		*!*	CASE pcWhat = "W_Process"
		*!*		ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(pValue,'ID_Detail_Process',-3)
		*!*	*	ThisForm.txtID_Detail.Value = 
		*!*	*	ThisForm.txtID_Master.Value = 
		*!*		ThisForm.txtTBL.Value = "W"
		*!*		IF UPPER(pcHeat) = "ADD"
		*!*			ThisForm.cHeat = ""
		*!*			ThisForm.cWhat = "ADD"
		*!*		ENDIF
		*!*		ThisForm.GetBy_STK_Detail_Process()
		
		*!*	CASE pcWhat = "WO_Detail"
		*!*		ThisForm.txtWO_Detail.Value = PrepareSQLtxt(pValue,'WO_Detail',-3)
		*!*		IF UPPER(pcHeat) = "ADD"
		*!*			ThisForm.cHeat = ""
		*!*			ThisForm.cWhat = "ADD"
		*!*		ENDIF
		*!*		ThisForm.GetBy_nWO_Detail()
		*!*		
		*!*	CASE pcWhat = "WO"
		*!*		ThisForm.txtWO.Value = PrepareSQLtxt(pValue,'WO',-3)
		*!*		IF UPPER(pcHeat) = "ADD"
		*!*			ThisForm.cHeat = ""
		*!*			ThisForm.cWhat = "ADD"
		*!*		ENDIF
		*!*		ThisForm.GetBy_nWO()
		*!*			
		*!*	OTHERWISE
		*!*		MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Receive_Edit WITH 'pcWhat', pValue, 'pcHeat'",16,"Bad Parameters")
		*!*		TrackError("Did not get a proper pcWhat. '"+pcWhat+"'"+CHR(13)+"\Receive_Edit WITH 'pcWhat', pValue, 'pcHeat'","Parameter error!",PROGRAM(), LINENO(1))
		*!*	ENDCASE
		
		*!*	PRIVATE nWO, nWO_Detail, nReceivingID
		*!*	nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		*!*	nWO_Detail 	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		*!*	nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		*!*	PRIVATE cPOitem, nHpaPo, nItemPo
		*!*	nHpaPo		= PrePareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		*!*	nItemPo		= PrePareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		*!*	IF nItemPo	= 0
		*!*		nItemPo = 1
		*!*	ENDIF
		*!*	cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		*!*	********************************
		*!*	IF EMPTY(ThisForm.txtTBL.Value) OR ThisForm.txtTBL.Value = "N"
		*!*		*Check POitem
		*!*		IF nHpaPo > 0
		*!*			ThisForm.txtTBL.Value = getTBL_Poitem(cPOitem, ThisForm.nConnhandle) 
		*!*		ENDIF
		*!*	ENDIF
		
		
		*!*	********************************
		*!*	IF EMPTY(ThisForm.txtTBL.Value) OR ThisForm.txtTBL.Value = "N"
		*!*		*Find TBL
		*!*		DO CASE
		*!*		CASE pcWhat = "WO" AND nWO > 0
		*!*			ThisForm.txtTBL.Value = getTBL_WO(nWO, ThisForm.nConnhandle) 
		*!*		CASE pcWhat = "WO_Detail" AND nWO_Detail > 0
		*!*			ThisForm.txtTBL.Value = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
		
		*!*		CASE nReceivingID > 0
		*!*			ThisForm.txtTBL.Value = getTBL_ReceivingID(nReceivingID, ThisForm.nConnhandle) 
		*!*			
		*!*		CASE nWO > 0
		*!*			ThisForm.txtTBL.Value = getTBL_WO(nWO, ThisForm.nConnhandle) 	
		*!*		CASE nWO_Detail > 0
		*!*			ThisForm.txtTBL.Value = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
		*!*			
		*!*		ENDCASE
		*!*	ENDIF
		
		
		*!*	********************************
		*!*	IF EMPTY(ThisForm.txtTBL.Value)
		*!*		IF PrepareSQLnum(ThisForm.txtID_Detail.Value,"ID_Detail",-3) > 0 OR PrepareSQLnum(ThisForm.txtID_Master.Value,"ID",-3) > 0
		*!*		 	IF VARTYPE(pValue) = 'N'
		*!*				TrackError("Did not find TBL. '"+pcWhat+"'"+CHR(13)+"\Receive_Edit WITH pcWhat='"+pcWhat+"', pValue="+STR(pValue)+", pcHeat='"+pcHeat+"'","Parameter error!",PROGRAM(), LINENO(1))
		*!*			ELSE
		*!*				TrackError("Did not find TBL. '"+pcWhat+"'"+CHR(13)+"\Receive_Edit WITH pcWhat='"+pcWhat+"', pValue='"+pValue+"', pcHeat='"+pcHeat+"'","Parameter error!",PROGRAM(), LINENO(1))
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.lblChooseReceivingID.Click
		PRIVATE cPOitem, nHpaPo, nItemPo, nReceiveID, nWO
		nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(This.Parent.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo = 0
			nItemPo = 1
		ENDIF
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO 	= PrepareSQLnum(This.Parent.txtWO.Value,'WO',-3)
		
		nReceiveID = 0
		PRIVATE nMess
		IF ( cPOitem != Proper_PO_Item(cPOitem) AND nWO=0 )
			MESSAGEBOX("Did not find a POitem or WO to use to look up for an Receive",16,"Fail")
			RETURN .F.
		ENDIF
		
		nMess = MESSAGEBOX("Do you wish to reset Receiving ID to 0? (Y)"+CHR(13)+"Reseting to 0 will allow you to receive another heat!"+CHR(13)+CHR(13)+"Answer (N) to open a window to choose a Receiving ID to Edit.",4+32,"Create new Receiving Record?")
		IF nMess = 6
			This.Parent.txtReceivingID.Value =0
			*This.Parent.txtID_Detail.Value	= 0
			This.Parent.cmdEdit.Visible = .F.
			RETURN .T.
		ENDIF
		
		IF nHPAPO > 0
			DO FORM Forms\ChooseReceivingID WITH cPOitem, "POitem" TO nReceiveID
			IF nReceiveID > 0
		
				nMess = MESSAGEBOX("Here is a chance to Edit the Receive."+CHR(13)+"Do you want to Edit this data?",4+32+256,"Edit Data") 
				IF nMess = 6
					This.Parent.txtReceivingID.Value = nReceiveID
					ThisForm.GetBy_ReceivingID()
				ENDIF
			ELSE
				WAIT WINDOW "No Change to Receiving ID" NOWAIT
			ENDIF	
		ELSE
			MESSAGEBOX("Please enter the HPA PO / POitem to start!",0+48,"No PO number!")
		ENDIF
		
		IF PrepareSQLnum(This.Parent.txtReceivingID.Value,'ReceivingID',-3) > 0
			This.Parent.cmdEdit.Visible = .T.
		ELSE
			This.Parent.cmdEdit.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.lblDate.Click
		*ThisForm.txtDate.Value = DATE()
		
		PRIVATE dDate1,dDate2
		
		dDate1 = PrepareSQLdate(ThisForm.txtDate.Value,'DueDate',.F.,.T.)
		
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		dDate2 = PrepareSQLdate(dDate2,'DueDate',.F.,.T.)
		
		ThisForm.txtDate.Value = dDate2
		ThisForm.txtDate.Refresh
	ENDPROC

	PROCEDURE frmReceive_Edit.lblHpaPOnum.Click
		PRIVATE nHpaPo
		nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HPApo',-3)
		
		IF nHpaPo > 0
			*Choose a HPApo
			ThisForm.ChoosePOitemLoad(nHPApo)
		ELSE
			ThisForm.ChoosePOitemLoad(0)
		ENDIF
		
		*Do again
		*Refresh
		PRIVATE nHpaPo, nItemPo, cPOitem, cHeat
		nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(This.Parent.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		cHeat	= ALLTRIM(PrepareSQLtxt(This.Parent.txtHeat.Value,'Heat',50))	
		
		
		IF nItemPo = 0 AND nHpaPo > 0
			ThisForm.ChoosePOitemLoad(nHpaPo)
		ELSE
			IF nHpaPo > 0 AND nItemPo > 0
				ThisForm.cPOitem = cPOitem
				IF EMPTY(cHeat) 
					ThisForm.GetPoItemDetail(cPOitem)
				ELSE
					ThisForm.GetFromReceiving(cPOitem,cHeat)
				ENDIF
			ENDIF
		ENDIF
		***
			
		
		*!*	IF nItemPo = 0
		*!*		ThisForm.ChoosePOitemLoad(nHpaPo)
		*!*		RETURN
		*!*	ELSE
		*!*		IF nHpaPo > 0 AND EMPTY(cHeat) 
		*!*			ThisForm.cPOitem = cPOitem
		*!*			ThisForm.GetPoItemDetail(cPOitem)
		*!*		ELSE
		*!*			ThisForm.cPOitem = cPOitem
		*!*			ThisForm.GetFromReceiving(cPOitem,cHeat)
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE frmReceive_Edit.lblOrderdate.Click
		PRIVATE m.dDate1,m.dDate2
		
		m.dDate1 = ThisForm.txtReceived.Value
		DO FORM "forms\popupdate.scx" WITH m.dDate1 TO m.dDate2
		
		ThisForm.txtReceived.Value = m.dDate2
		ThisForm.txtReceived.Refresh
		ThisForm.txtReceived.SetFocus
		
		
	ENDPROC

