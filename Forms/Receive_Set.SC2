	PROCEDURE getby_receivingid
		*ThisForm.GetBy_ReceivingID()
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID < 1
			TrackError("bad variable","ReceivingID is not a NUMBER",PROGRAM(),LINENO(1))
			MESSAGEBOX("No ReceivingID for GetBy_ReceivingID( )",0,"Error")
			RecordError(0,"No ReceivingID for GetBy_ReceivingID( )" ,PROGRAM(),LINENO(1),"No ReceivingID for GetBy_ReceivingID( )" )
			RETURN .F.
		ENDIF
		
		
		
		
		IF USED('tmpReceivingPOitem')
			USE IN tmpReceivingPOitem
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT * FROM dbo.Receiving WITH (NOLOCK) "
		cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOitem')
		ENDDO
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpReceivingPOitem')
			RETURN
		ENDIF
		
		
		IF USED('tmpReceivingPOitem')
			*ThisForm.txtReceivingID.Value = 
			
			ThisForm.txtWO.Value		= PrepareSQLnum(tmpReceivingPOitem.WO,'WO',-3)
			ThisForm.txtWO_Detail.Value	= PrepareSQLnum(tmpReceivingPOitem.WO_Detail,'WO_Detail',-3)
			
			ThisForm.txtReceived.Value = PrepareSQLDate(tmpReceivingPOitem.Received,'Received')
			
			ThisForm.cPOitem 			= PrepareSQLtxt(tmpReceivingPOitem.POitem,'POitem',12)
			ThisForm.txtHpaPONum.Value 	= Proper_PO_Item_PO(ThisForm.cPOitem)
			ThisForm.txtHpaPOItem.Value = Proper_PO_Item_Item(ThisForm.cPOitem)
			ThisForm.cSOitem			= PrepareSQLtxt(tmpReceivingPOitem.SOitem,'SOitem',10)
			ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(ThisForm.cSOitem)
			ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(ThisForm.cSOitem)
						
			ThisForm.txtAlloy.Value		= tmpReceivingPOitem.Alloy
			ThisForm.txtHeat.Value		= tmpReceivingPOitem.Heat
			ThisForm.chkCert.Value		= IIF(tmpReceivingPOitem.Cert,1,0)
			ThisForm.txtPieces.Value	= tmpReceivingPOitem.Pieces
			ThisForm.edtDescription.Value = tmpReceivingPOitem.Description
			ThisForm.edtSpecs.Value		= tmpReceivingPOitem.Specs
			ThisForm.edtComments.Value 	= tmpReceivingPOitem.Comments
			ThisForm.txtInit.Value		= tmpReceivingPOitem.Init
			ThisForm.txtDate.Value		= DTOC(tmpReceivingPOitem.Date)
			ThisForm.chkPass.Value		= IIF(tmpReceivingPOitem.Pass,1,0)
			ThisForm.chkGoodPapers.Value = IIF(tmpReceivingPOitem.GoodPapers,1,0)
			ThisForm.txtActualW.Value	= tmpReceivingPOitem.ActualW
			ThisForm.txtBillW.Value		= tmpReceivingPOitem.BillW
			ThisForm.txtVendor.Value	= tmpReceivingPOitem.Vendor
			*tmpReceivingPOitem.Cancelled
			*tmpReceivingPOitem.WhoAdd
			*tmpReceivingPOitem.WhenAdd
			
			ThisForm.txtRejectPC.Value		= tmpReceivingPOitem.RejectPC
			ThisForm.txtRejectReason.Value	= tmpReceivingPOitem.RejectReason
			ThisForm.txtRMA_No.Value		= tmpReceivingPOitem.RMA_No
			
			ThisForm.txtID_Master.Value	= PrepareSQLnum(tmpReceivingPOitem.ID_Master,'ID_Master',-3)
			ThisForm.txtID_Detail.Value	= PrepareSQLnum(tmpReceivingPOitem.ID_Detail,'ID_Detail',-3)
			ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpReceivingPOitem.StockTable,'TBL',1)
			*ThisForm.StockLst_TBL		= PrepareSQLtxt(tmpReceivingPOitem.StockTable,'TBL',1)
		
		*	ThisForm.nRMA = PrepareSQLnum(tmpReceivingPOitem.RMA_No,'RMA',-3)
			
			IF USED('tmpReceivingPOitem')
				USE IN tmpReceivingPOitem
			ENDIF
				
		ENDIF
	ENDPROC

	PROCEDURE getby_stk_detail
		*ThisForm.GetBy_STK_Detail()
		
		*See if this ID_Detail can get the correct ReceivingID
		PRIVATE nID_Detail, cTBL, nReceivingID 
		nID_Detail = ThisForm.txtID_Detail.Value
		cTBL = PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		IF EMPTY(cTBL)
			cTBL = PrepareSQLtxt(ThisForm.StockLst_TBL,'TBL',1)
		ENDIF
		nReceivingID = 0
		
		PRIVATE cSQL, nSQLExec
		IF USED("tmpRcv_ID_Detail")
			USE IN tmpRcv_ID_Detail
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ReceivingID "
		IF cTBL = 'S'
			cSQL = cSQL + " FROM dbo.StockLst_Detail "
		ELSE
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
		ENDIF
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail )
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRcv_ID_Detail')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRcv_ID_Detail' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRcv_ID_Detail' )
		ENDIF
		
		IF USED('tmpRcv_ID_Detail')
			IF RECCOUNT('tmpRcv_ID_Detail') > 0	
				nReceivingID = tmpRcv_ID_Detail.ReceivingID 
			ENDIF
			USE IN tmpRcv_ID_Detail
		ENDIF
		
		IF nReceivingID > 0
		
			*Read in by the ReceivingID
			ThisForm.txtReceivingID.Value = nReceivingID 
			ThisForm.GetBy_ReceivingID()
			RETURN .T.
		
		ENDIF
		
		*******************************
		*** New Add, No ReceiveID
		
		PRIVATE lFoundIncoming 
		lFoundIncoming = .F.
		
		*Look for 'INCOMING' or 'PartRecv' as Process_ID
		IF USED('tmpStk')
			USE IN tmpStk
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT * "
		DO CASE
		CASE cTBL = 'S'
			cSQL = cSQL + " FROM dbo.StockLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail"
		CASE cTBL = 'B'
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail"
		CASE cTBL = 'W'
			cSQL = cSQL + " FROM dbo.WIPLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail"
		ENDCASE
		cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail )
		cSQL = cSQL + " AND (P.Process_ID = 'INCOMING' OR P.Process_ID = 'NOT2HPA' OR P.Process_ID = 'PARTRECV')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk')
		ENDDO
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStk')
			RETURN .F.
			lFoundIncoming = .T.
		ENDIF
		
		
		
		
		**********************************************
		* General search
		*nID_Detail, cTBL
		IF NOT lFoundIncoming 
			IF USED('tmpStk')
				USE IN tmpStk
			ENDIF
		
			PRIVATE nSQLEXEC, cSQL
			cSQL = "SELECT * "
			DO CASE
			CASE cTBL = 'S'
				cSQL = cSQL + " FROM dbo.StockLst_Master M "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail"
			CASE cTBL = 'B'
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail"
			CASE cTBL = 'W'
				cSQL = cSQL + " FROM dbo.WIPLst_Master M "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail"
			ENDCASE
			cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail )
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk')
			ENDDO
			IF nSQLEXEC < 1
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStk')
				RETURN .F.
			ENDIF
		ENDIF
		
		********************************
		*See what records where found
		PRIVATE nRecCount, nRecNum, nMess
		
		IF USED('tmpStk')
			nRecCount = RECCOUNT('tmpStk')
			
			ThisForm.txtReceivingID.Value = PrepareSQLnum(tmpStk.ReceivingID,'ReceivingID',-3)
			
			ThisForm.txtWO.Value		= PrepareSQLnum(tmpStk.WO,'WO',-3)
			ThisForm.txtWO_Detail.Value	= PrepareSQLnum(tmpStk.WO_Detail,'WO_Detail',-3)
			
			*ThisForm.txtReceived.Value = PrepareSQLDate(tmpStk.Received,'Received')
			ThisForm.txtReceived.Value = PrepareSQLDate(DATE(),'Received')
			
			PRIVATE cPOitem 
			cPOitem = PrepareSQLtxt(tmpStk.PO_item,'POitem',12)
			IF Proper_PO_item(cPOitem) != Proper_PO_item('')
				ThisForm.cPOitem 		= cPOitem
				ThisForm.txtHpaPONum.Value 	= Proper_PO_Item_PO(cPOitem) &&LEFT(ThisForm.cPOitem,AT("-",ThisForm.cPOitem)-1)
				ThisForm.txtHpaPOItem.Value = Proper_PO_Item_Item(cPOitem)  &&ALLTRIM(STR(VAL(RIGHT(ThisForm.cPOitem,LEN(ThisForm.cPOitem)-AT("-",ThisForm.cPOitem)))))
				ThisForm.ChecknHpaPO = ThisForm.txtHpaPONum.Value
				ThisForm.ChecknItemPO = ThisForm.txtHpaPOItem.Value
			ELSE
				ThisForm.cPOitem 		= Proper_PO_item('')
				ThisForm.txtHpaPONum.Value 	= 0
				ThisForm.txtHpaPOItem.Value = 0
				ThisForm.ChecknHpaPO = 0
				ThisForm.ChecknItemPO = 0
			ENDIF
			
			PRIVATE cSOitem 
			cSOitem = PrepareSQLtxt(tmpStk.SOitem,'SOitem',10)
			IF Proper_SO_item(cSOitem) != Proper_SO_item("")
				ThisForm.cSOitem			= cSOitem
				ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
				ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
			ELSE
				ThisForm.cSOitem			= Proper_SO_item("")
				ThisForm.txtSOnum.Value		= 0
				ThisForm.txtSOitem.Value	= 0
			ENDIF
							
			ThisForm.txtAlloy.Value		= PrepareSQLtxt(tmpStk.Alloy,'Alloy',12)
			ThisForm.txtHeat.Value		= PrepareSQLtxt(tmpStk.Heat,'Heat',50)
			*ThisForm.chkCert.Value		= IIF(tmpStk.Cert,1,0)
			ThisForm.chkCert.Value		= 0
			
			ThisForm.txtPieces.Value	= PrepareSQLnum(tmpStk.PC,'PC',-3)
			ThisForm.edtDescription.Value = PrepareSQLtxt(tmpStk.Descript,'Decript',20)
			ThisForm.edtSpecs.Value		= PrepareSQLtxt(tmpStk.Specs,'Specs',160)
			*ThisForm.edtComments.Value 	= tmpStk.Comments,
			ThisForm.edtComments.Value 	= ''
			
			*ThisForm.txtInit.Value		= tmpStk.Init
			ThisForm.txtInit.Value		= ''
			
			*ThisForm.txtDate.Value		= DTOC(tmpStk.Date)
			ThisForm.txtDate.Value 		= PrepareSQLDate(DATE(),'DATE')
			
			*ThisForm.chkPass.Value		= IIF(tmpStk.Pass,1,0)
			ThisForm.chkPass.Value		= 0
			
			*ThisForm.chkGoodPapers.Value = IIF(tmpStk.GoodPapers,1,0)
			ThisForm.chkGoodPapers.Value = 0
			
			ThisForm.txtActualW.Value	= PrepareSQLnum(tmpStk.S_QTY,'S_QTY',-5)
			ThisForm.txtBillW.Value		= PrepareSQLnum(tmpStk.Weight,'Weight',9,1)
			*ThisForm.txtVendor.Value	= tmpStk.Vendor
			ThisForm.txtVendor.Value	= ''
				
			*ThisForm.txtRejectPC.Value		= tmpStk.RejectPC
			ThisForm.txtRejectPC.Value		= 0
			
			*ThisForm.txtRejectReason.Value	= tmpStk.RejectReason
			ThisForm.txtRejectReason.Value	= ''
			
			*ThisForm.txtRMA_No.Value		= tmpStk.RMA_No
			ThisForm.txtRMA_No.Value		= 0
			
			ThisForm.txtID_Master.Value	= PrepareSQLnum(tmpStk.ID,'ID_Master',-3)
			ThisForm.txtID_Detail.Value	= PrepareSQLnum(tmpStk.ID_Detail,'ID_Detail',-3)
		
			ThisForm.txtTBL.Value		= cTBL
			*ThisForm.StockLst_TBL		= PrepareSQLtxt(tmpStk.StockTable,'TBL',1)
			
			IF USED('tmpStk')
				USE IN tmpStk
			ENDIF
			*******
			IF Proper_PO_item(PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)) != Proper_PO_item('')
				*Get Vendor Company name, Description
				
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				cSQL = "SELECT Company, Alloy, Form, Order_Qty, Pieces, Thck, Sz2, Sz3, Cond_Spec, Heat, RandLen "
		*		cSQL = cSQl + ",StockLst_QTY,StockLst_P,Pounds,Order_PU "
		*		cSQL = cSQL + " ,dbo.f_Descript(Alloy,CC,CL,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen) AS Descript "
				cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(Pieces,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen,0,'','','') AS Descript "
				cSQL = cSQL + " FROM dbo.PurchaseOrder WHERE PoItem = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF RECCOUNT('tmpPOp') > 0
						ThisForm.txtVendor.Value = PrepareSQLtxt(tmpPOp.Company,'Company',30)
						*ThisForm.edtDescription.Value = ALLTRIM(PrepareSQLtxt(tmpPOp.Descript,'Descript',-1))+"  "+ALLTRIM(ThisForm.edtComments.Value)
						PRIVATE cDesc,cDesc2
						cDesc = ALLTRIM(PrepareSQLtxt(ThisForm.edtDescription.Value,'Descript',-1))
						cDesc2 = ALLTRIM(PrepareSQLtxt(tmpPOp.Descript,'Descript',-1))
						IF EMPTY(cDesc)
							ThisForm.edtDescription.Value = cDesc2
						ELSE
							IF MESSAGEBOX("Add PO Description"+CHR(13)+cDesc2+","+CHR(13)+"before Process Description"+CHR(13)+cDesc+CHR(13)+"Answer No to just use Process Description.",4,"Add PO Description, before Process Description")=6
								ThisForm.edtDescription.Value = cDesc2+". "+cDesc
							ENDIF
						ENDIF
		
					ENDIF
					USE IN tmpPOp
				ENDIF
		
			ENDIF
			********
			RETURN .T.
		ELSE
			RETURN .F.		
		ENDIF
		
		
	ENDPROC

	PROCEDURE getby_stk_detail_process
		*ThisForm.GetBy_STK_Detail()
		
		*See if this ID_Detail can get the correct ReceivingID
		PRIVATE nID_Detail_Process, cTBL, nReceivingID 
		nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process.Value',-3)
		cTBL = PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		nReceivingID = 0
		
		PRIVATE cSQL, nSQLExec
		PRIVATE lFoundProcess
		lFoundProcess = .F.
		
		
		IF USED("tmpRcv_ID_Detail_P")
			USE IN tmpRcv_ID_Detail_P
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * "
		DO CASE
		CASE cTBL = 'S'
			cSQL = cSQL + " FROM dbo.StockLst_Process P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
		CASE cTBL = 'B'
			cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
		CASE cTBL = 'W'
			cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRcv_ID_Detail_P')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRcv_ID_Detail_P' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRcv_ID_Detail_P' )
		ENDIF
		
		IF USED('tmpRcv_ID_Detail_P')
			IF RECCOUNT('tmpRcv_ID_Detail_P') > 0	
				lFoundProcess = .T.
			ENDIF
			*USE IN tmpRcv_ID_Detail_P
		ENDIF
		
		*******************************
		
		*IF NOT lFoundProcess 
		
		
		********************************
		*See what records where found
		PRIVATE nRecCount, nRecNum, nMess
		
		IF USED('tmpRcv_ID_Detail_P')
			nRecCount = RECCOUNT('tmpRcv_ID_Detail_P')
			
			ThisForm.txtReceivingID.Value = PrepareSQLnum(tmpRcv_ID_Detail_P.ReceivingID,'ReceivingID',-3)
			
			ThisForm.txtWO.Value		= PrepareSQLnum(tmpRcv_ID_Detail_P.WO,'WO',-3)
			*ThisForm.txtWO_Detail.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.WO_Detail,'WO_Detail',-3)
			ThisForm.txtWO_Detail.Value = 0
			
			*ThisForm.txtReceived.Value = PrepareSQLDate(tmpRcv_ID_Detail_P.Received,'Received')
			ThisForm.txtReceived.Value = PrepareSQLDate(DATE(),'Received')
			
			PRIVATE cPOitem 
			cPOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.PO_item,'POitem',12)
			IF Proper_PO_item(cPOitem) != Proper_PO_item('')
				ThisForm.cPOitem 		= cPOitem
				ThisForm.txtHpaPONum.Value 	= Proper_PO_Item_PO(cPOitem) &&LEFT(ThisForm.cPOitem,AT("-",ThisForm.cPOitem)-1)
				ThisForm.txtHpaPOItem.Value = Proper_PO_Item_Item(cPOitem)  &&ALLTRIM(STR(VAL(RIGHT(ThisForm.cPOitem,LEN(ThisForm.cPOitem)-AT("-",ThisForm.cPOitem)))))
				ThisForm.ChecknHpaPO = ThisForm.txtHpaPONum.Value
				ThisForm.ChecknItemPO = ThisForm.txtHpaPOItem.Value
			ELSE
				ThisForm.cPOitem 		= Proper_PO_item('')
				ThisForm.txtHpaPONum.Value 	= 0
				ThisForm.txtHpaPOItem.Value = 0
				ThisForm.ChecknHpaPO = ThisForm.txtHpaPONum.Value
				ThisForm.ChecknItemPO = ThisForm.txtHpaPOItem.Value
			ENDIF
			
			PRIVATE cSOitem 	
			cSOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.SOitem,'SOitem',10)
			IF Proper_SO_item(cSOitem) != Proper_SO_item("")
				ThisForm.cSOitem			= cSOitem
				ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
				ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
			ELSE
				ThisForm.cSOitem			= Proper_SO_item("")
				ThisForm.txtSOnum.Value		= 0
				ThisForm.txtSOitem.Value	= 0
			ENDIF
							
			ThisForm.txtAlloy.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.Alloy,'Alloy',12)
			*ThisForm.txtAlloy.Value		= ''
			
			ThisForm.txtHeat.Value		= ThisForm.cHeat
			IF NOT EMPTY(PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50))
				IF EMPTY(PrepareSQLtxt(ThisForm.cHeat,'Heat',50))
					ThisForm.txtHeat.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50)
				ELSE
					IF ALLTRIM(UPPER(PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50))) = ALLTRIM(UPPER(ThisForm.cHeat))
						ThisForm.txtHeat.Value = ThisForm.cHeat
					ELSE
						nMess = MESSAGEBOX("Heat was passed in as"+CHR(13)+ThisForm.cHeat+CHR(13)+"the Process ID Heat is"+CHR(13)+PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50)+CHR(13)+CHR(13)+"Do you want to keep the Passed in Heat?",4+32,"Keep the Passed in Heat")
						IF nMess = 6
							ThisForm.txtHeat.Value = ThisForm.cHeat
						ENDIF
						IF nMess = 7
							ThisForm.txtHeat.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF ALLTRIM(UPPER(ThisForm.txtHeat.Value)) = "DUE IN"
				ThisForm.txtHeat.Value = ""
			ENDIF
		
			*ThisForm.chkCert.Value		= IIF(tmpRcv_ID_Detail_P.Cert,1,0)
			ThisForm.chkCert.Value		= 0
			
			ThisForm.txtPieces.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.PC,'PC',-3)
		*	ThisForm.edtDescription.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Descript,'Decript',20)  &&Do not use Descript from here!
			ThisForm.edtSpecs.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.Specs,'Specs',160)
			*ThisForm.edtComments.Value 	= tmpRcv_ID_Detail_P.Comment,
			ThisForm.edtComments.Value 	= ''
			
			*ThisForm.txtInit.Value		= tmpRcv_ID_Detail_P.Init
			ThisForm.txtInit.Value		= ''
			
			*ThisForm.txtDate.Value		= DTOC(tmpRcv_ID_Detail_P.Date)
			ThisForm.txtDate.Value 		= PrepareSQLDate(DATE(),'DATE')
			
			*ThisForm.chkPass.Value		= IIF(tmpRcv_ID_Detail_P.Pass,1,0)
			ThisForm.chkPass.Value		= 0
			
			*ThisForm.chkGoodPapers.Value = IIF(tmpRcv_ID_Detail_P.GoodPapers,1,0)
			ThisForm.chkGoodPapers.Value = 0
			
			ThisForm.txtActualW.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.QTY,'S_QTY',-5)
			ThisForm.txtBillW.Value		= PrepareSQLnum(tmpRcv_ID_Detail_P.Pounds,'Weight',9,1)
			*ThisForm.txtVendor.Value	= tmpRcv_ID_Detail_P.Vendor
			ThisForm.txtVendor.Value	= ''
				
			*ThisForm.txtRejectPC.Value		= tmpRcv_ID_Detail_P.RejectPC
			ThisForm.txtRejectPC.Value		= 0
			
			*ThisForm.txtRejectReason.Value	= tmpRcv_ID_Detail_P.RejectReason
			ThisForm.txtRejectReason.Value	= ''
			
			*ThisForm.txtRMA_No.Value		= tmpRcv_ID_Detail_P.RMA_No
			ThisForm.txtRMA_No.Value		= 0
			
			ThisForm.txtID_Master.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.ID,'ID_Master',-3)
			ThisForm.txtID_Detail.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.ID_Detail,'ID_Detail',-3)
			*ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.StockTable,'TBL',1)
			*IF EMPTY(ThisForm.txtTBL.Value)
			*	ThisForm.txtTBL.Value		= PrepareSQLtxt(ThisForm.StockLst_TBL,'TBL',1)
			*ENDIF
		
			
			IF USED('tmpRcv_ID_Detail_P')
				USE IN tmpRcv_ID_Detail_P
			ENDIF
			*******
			IF Proper_PO_item(PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)) != Proper_PO_item('')
				*Get Vendor Company name, Description
				
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				cSQL = "SELECT Company, Alloy"
		*		cSQL = cSQl + ", Form, Order_Qty, Pieces, Thck, Sz2, Sz3, Cond_Spec, Heat, RandLen "
		*		cSQL = cSQl + ",StockLst_QTY,StockLst_P,Pounds,Order_PU "
		*		cSQL = cSQL + " ,dbo.f_Descript(Alloy,CC,CL,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen) AS Descript "
				cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(Pieces,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen,0,'','','') AS Descript "
				cSQL = cSQL + " FROM dbo.PurchaseOrder WHERE PoItem = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF RECCOUNT('tmpPOp') > 0
						ThisForm.txtVendor.Value	= PrepareSQLtxt(tmpPOp.Company,'Company',30)
						ThisForm.txtAlloy.Value		= PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
						PRIVATE cDesc,cDesc2
						cDesc = ALLTRIM(PrepareSQLtxt(ThisForm.edtDescription.Value,'Descript',-1))
						cDesc2 = ALLTRIM(PrepareSQLtxt(tmpPOp.Descript,'Descript',-1))
						IF EMPTY(cDesc)
							ThisForm.edtDescription.Value = cDesc2
						ELSE
							IF MESSAGEBOX("Add PO Description"+CHR(13)+cDesc2+","+CHR(13)+"before Process Description"+CHR(13)+cDesc+CHR(13)+"Answer No to just use Process Description.",4,"Add PO Description, before Process Description")=6
								ThisForm.edtDescription.Value = cDesc2+". "+cDesc
							ENDIF
						ENDIF
					ENDIF
					USE IN tmpPOp
				ENDIF
		
			ENDIF
			********
			RETURN .T.
		ELSE
			RETURN .F.		
		ENDIF
		
		
	ENDPROC

	PROCEDURE getfromreceiving
		PARAMETER pcPoItem, pcHeat
		*ThisForm.GetFromReceiving(cPOitem,cHeat)
		*returns .F. if did not get a receiving record.
		
		IF TYPE("pcPoItem") != "C"
			RETURN
			*pHPAPo = ''
		ENDIF
		
		PRIVATE cAndHeat, nID
		IF TYPE("pcHeat") != "C"
			cAndHeat = ""
		ELSE
			IF NOT EMPTY(pcHeat)
			 	cAndHeat = " AND HEAT = '"+ALLTRIM(pcHeat)+"' "
			 ELSE
			 	cAndHeat = ""
			 ENDIF
		ENDIF
		nID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ID',-3,0)
		
		***********************************
		*** FROM RecStockGetByPOitem
		*** GetPOitemDetail
		***********************************
		IF USED('tmpReceivingPOitem')
			USE IN tmpReceivingPOitem
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		*cSQL = "SELECT Heat,Cert,Pieces,Description,Specs,Comments,Init,Date,ActualW,BillW,Vendor,pass,ID FROM dbo.Receiving "
		cSQL = "SELECT * FROM dbo.Receiving WITH (NOLOCK) "
		cSQL = cSQL + " WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+pcPoItem+"')"
		cSQL = cSQL + cAndHeat
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOitem')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpReceivingPOitem')
			RETURN .F.
		ENDIF
		PRIVATE cDescription, lFoundOnetoEdit, nCurRec, nRecords, nRID 
		cDescription = ''
		lFoundOnetoEdit = .F.
		nCurRec = 0
		nRecords = 0
		
		IF USED('tmpReceivingPOitem')
			GO TOP
			IF VARTYPE(tmpReceivingPOitem.Description) = "C"
				cDescription = ALLTRIM(LEFT(tmpReceivingPOitem.Description, 40))
			ENDIF
			
			IF TYPE("tmpReceivingPOitem.Heat")="C" &&Heat
				IF !EMPTY(tmpReceivingPOitem.Heat)
					IF !EMPTY(pcHeat)
						IF nID > 0
							PRIVATE nMess
							nMess = MESSAGEBOX("There is already a receiving record with this"+CHR(13)+"Heat= '"+ALLTRIM(pcHeat)+"'"+CHR(13)+cDescription+CHR(13)+CHR(13)+"Do you want to load this data?",4,"Overwrite current Data?") 
							IF nMess = 7
								*NO, do not overwrite
								ThisForm.ResetAddVars()
								
								RETURN .F.
							ENDIF
						ELSE
							*ID is 0, NEW
						ENDIF
					ELSE
						PRIVATE cEditNextRecord 
						cEditNextRecord = CHR(13)+"edit the next RECORD or"
						
						SELECT tmpReceivingPOitem
						nRecords = RECCOUNT()
						SCAN
						nCurRec = RECNO()
						cDescription = ALLTRIM(STR(tmpReceivingPOitem.Pieces))+"Pc "
						cDescription = cDescription + ALLTRIM(LEFT(tmpReceivingPOitem.Description, 40))
						cDescription = cDescription + " Heat:"+tmpReceivingPOitem.Heat
						
						nRID = tmpReceivingPOitem.ID
						IF nRecords > nCurRec
							cEditNextRecord = CHR(13)+"edit the next RECORD or"
						ELSE
							cEditNextRecord = ""
						ENDIF
						PRIVATE cMess, nMess
						nMess = 0
						cMess = "There is already a receiving record. "
						IF nCurRec < nRecords 
							cMess = cMess + "Record "+ALLTRIM(STR(nCurRec))+"/"+ALLTRIM(STR(nRecords))+"."+CHR(13)
						ENDIF
						cMess = cMess + cDescription+CHR(13)+CHR(13)+"Do you want to edit this data?"+CHR(13)+CHR(13)
						IF nCurRec < nRecords 
							cMess = cMess +"Answer No and you will get a chance to edit the next RECORD"+CHR(13)
						ENDIF
						*cMess = cMess +"Create a new Receiving record."
						
						nMess = MESSAGEBOX(cMess,4,"Edit old Data?")
						IF nMess = 6
							*Edit this one
							lFoundOnetoEdit = .T.
							EXIT
						ELSE
							*IF nRecords = nCurRec
								nMess = MESSAGEBOX("This is a chance to 'Create' a receive."+CHR(13)+"Are you sure you want to create"+CHR(13)+"another receiving record"+CHR(13)+"for this same PO item?"+CHR(13)+" ",4,"Create new receiving record?")
								IF nMess = 6
									ThisForm.txtReceivingID.Value = 0
									RETURN .F.
								ENDIF
							*ENDIF
						ENDIF
						ENDSCAN
						
						IF lFoundOnetoEdit 
							IF MESSAGEBOX("Found a Receiving Record for this PO item '"+pcPoItem++"'"+CHR(13)+"Receiving ID: "+ALLTRIM(STR(nRID))+CHR(13)+CHR(13)+"Do you want to Edit this old receive?"+CHR(13)+"Answer No to be able to ADD another receive to this Po item.",4+32,"Edit old Receive?")=6
								ThisForm.txtReceivingID.Value = PrepareSQLnum(nRID,'ReceivingID',-3)
								ThisForm.GetBy_ReceivingID()
								RETURN .T.
							ELSE
								ThisForm.txtReceivingID.Value = 0			
							ENDIF
						ELSE
							ThisForm.txtReceivingID.Value = 0
							ThisForm.ResetAddVars()
							RETURN .F.
						ENDIF
		
					ENDIF
				ENDIF
			ENDIF
			
			*****
			PRIVATE cPOitem, nHpaPo, nItemPo
			cPOitem	=	 PrepareSQLtxt(tmpReceivingPOitem.POitem,'POitem',12)
			IF Proper_PO_item(cPOitem) != Proper_PO_item("")
				ThisForm.cPOitem				= cPOitem
				ThisForm.txtHPAPONum.Value		= Proper_PO_Item_PO(cPOitem)
				ThisForm.txtHPAPOItem.Value		= Proper_PO_Item_Item(cPOitem)
				ThisForm.ChecknHpaPO 		= Proper_PO_Item_PO(cPOitem)
				ThisForm.ChecknItemPO		= Proper_PO_Item_Item(cPOitem)
			ELSE
				ThisForm.cPOitem			= Proper_PO_item("")
				ThisForm.txtHPAPONum.Value	= 0
				ThisForm.txtHPAPOItem.Value	= 0
				ThisForm.ChecknHpaPO 		= 0
				ThisForm.ChecknItemPO		= 0
			ENDIF
		
			PRIVATE cSOitem, nSalesNum, nItemSO
			cSOitem	=	 PrepareSQLtxt(tmpReceivingPOitem.SOitem,'SOitem',10)
			IF Proper_SO_item(cSOitem) != Proper_SO_item("")
				ThisForm.cSOitem			= cSOitem
				ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
				ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
			ELSE
				ThisForm.cSOitem			= Proper_SO_item("")
				ThisForm.txtSOnum.Value		= 0
				ThisForm.txtSOitem.Value	= 0
			ENDIF
				
			ThisForm.txtHeat.Value = PrepareSQLtxt(tmpReceivingPOitem.Heat,'Heat',30)
			ThisForm.chkCert.Value = PrepareSQLchk(tmpReceivingPOitem.Cert,'Cert')
			ThisForm.txtPieces.Value = PrepareSQLnum(tmpReceivingPOitem.Pieces,'Pieces',-3)
			ThisForm.edtDescription.Value = PrepareSQLtxt(tmpReceivingPOitem.Description,'Description',-1)
			ThisForm.edtSpecs.Value = PrepareSQLtxt(tmpReceivingPOitem.Specs,'Specs',-1)
			ThisForm.edtComments.Value = PrepareSQLtxt(tmpReceivingPOitem.Comments,'Comments',-1)
			ThisForm.txtInit.Value = PrepareSQLtxt(tmpReceivingPOitem.Init,'Init',10)
			ThisForm.txtDate.Value = DTOC(PrepareSQLdate(tmpReceivingPOitem.Date,'Date'))
			ThisForm.chkPass.Value = PrepareSQLchk(tmpReceivingPOitem.Pass,'Pass')
			ThisForm.chkGoodPapers.Value = PrepareSQLchk(tmpReceivingPOitem.GoodPapers,'GoodPapers')
		
			PRIVATE nActualW
			nActualW = PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)
			IF PrepareSQLnum(tmpReceivingPOitem.ActualW,'ActualW',9,1) > 0 AND nActualW < 2
				ThisForm.txtActualW.Value = PrepareSQLnum(tmpReceivingPOitem.ActualW,'ActualW',9,1)
			ENDIF
			PRIVATE nBillW
			nBillW = PrepareSQLnum(ThisForm.txtBillW.Value,'BillW',9,1)
			IF PrepareSQLnum(tmpReceivingPOitem.BillW,'BillW',9,1) > 0 AND nBillW < 2
				ThisForm.txtBillW.Value = PrepareSQLnum(tmpReceivingPOitem.BillW,'BillW',9,1)
			ENDIF
		
			ThisForm.txtVendor.Value = PrepareSQLtxt(tmpReceivingPOitem.Vendor,'Vendor',30,.F.,.T.)
			
			ThisForm.txtReceivingID.Value = PrepareSQLnum(tmpReceivingPOitem.ID,'ID',-3)
			
			ThisForm.txtID_Master.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Master,'ID_Master',-3)
			ThisForm.txtID_Detail.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Detail,'ID_Detail',-3)
			ThisForm.txtTBL.Value = PrepareSQLtxt(tmpReceivingPOitem.StockTable,'StockTable',1)
			*ThisForm.StockLst_TBL = PrepareSQLtxt(tmpReceivingPOitem.StockTable,'StockTable',1)
			
			*ID_Detail_Process is not stored in Receiving!
			*ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Detail_Process,'ID_Detail_Process',-3)
				
			IF USED('tmpReceivingPOitem')
				USE IN tmpReceivingPOitem
			ENDIF
			
			*ThisForm.Edit1.Value = ThisForm.Edit1.Value+CHR(13)+"Retrieved PO item "+pcPoItem+" for edit."
			ThisForm.Refresh	
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE getpoitemdetail
		PARAMETERS pPOitem
		*ThisForm.GetPOitemDetail()
		
		IF Proper_PO_item(PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)) = Proper_PO_item('')
			IF Proper_PO_item(PrepareSQLtxt(pPOitem,'POitem',12)) = Proper_PO_item('')
				ThisForm.cPOitem = pPOitem
				cPoitem = pPOitem
			ELSE
		*		TrackError("Need PO Item","Need SO Item",PROGRAM(),LINENO(1) )
				MESSAGEBOX("Need Po Item",0,"getPoItemDetail()" )
				RETURN
			ENDIF
		ENDIF
		
		**check HpaPO
		PRIVATE nItemPO, nHpaPo, cPOitem
		cPOitem = Proper_PO_Item(PrepareSQLtxt(ThisForm.cPOitem,'POitem',12))
		nItemPO = Proper_PO_Item_Item(cPOitem)
		nHpaPo	= Proper_PO_Item_PO(cPOitem)
		
		IF nHpaPo = 0
			MESSAGEBOX("No PO to show!",0,"No PO")
			RETURN .F.
		ENDIF
		
		IF NOT EMPTY(ThisForm.cHeat)
			ThisForm.txtHeat.Value = ThisForm.cHeat
		ENDIF
		
		PRIVATE nPOcnt 
		nPOcnt = 0
		
		IF nItemPo = 0
			*Guess at Item
			ThisForm.ChecknItemPO = 0
			nPOcnt = Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle )
			IF nPOcnt = 0
				MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
				RETURN .F.
			ENDIF
			IF Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle, "FORSTOCK" ) = 0
				*Not for Stock!!!
			ENDIF
			IF nPOcnt = 1
				*Must be only one
				nItemPo = GetMaxItemforPO( nHpaPo, ThisForm.nConnHandle )  &&nItemPO started as 0!
		
				ThisForm.txtHPAPOitem.Value = nItemPO
				ThisForm.ChecknItemPO = nItemPO
			ENDIF
			IF nPOcnt > 1
				*Show list of Item to Choose
				PRIVATE cPoItem
				DO FORM Forms\ChoosePOitem WITH nHpaPo TO cPoItem
				IF TYPE("cPoItem") = "C"
					IF Proper_PO_Item(cPoItem) != Proper_PO_Item('')
						nItemPo = Proper_PO_Item_Item(cPOitem)
						ThisForm.txtHpaPOItem.Value = nItemPo
						ThisForm.ChecknItemPO = nItemPO
						ThisForm.cPOitem = cPOitem
					ELSE
						MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
						RETURN	
					ENDIF		
				ELSE
					MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
					RETURN	
				ENDIF
			ENDIF
		ENDIF
		*****
		*Check Process
		
		IF USED('tmpPO_Process')
			USE IN 'tmpPO_Process'
		ENDIF
		
		cSQL = "SELECT D.ReceivingID, D.InvoiceValue, M.Heat, 'S' AS TBL, M.PO_Item  "
		cSQL = cSQL + " ,D.WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.S_QTY, D.Weight, M.ID, D.ID_Detail "
		cSQL = cSQL + " ,P.SOitem, P.PO_Item AS PPOItem, P.DueDate, P.Process_ID, P.PWeight, P.QTY, P.ReceivingID AS PReceivingID"
		cSQL = cSQL + " FROM dbo.StockLst_Master M WITH (NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH (NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH (NOLOCK) ON D.ID_Detail = P.ID_Detail "
		cSQL = cSQL + " WHERE ( M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
		cSQL = cSQL + " OR (P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') )"
		cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' ))"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT D.ReceivingID, D.InvoiceValue, M.Heat, 'B' AS TBL, M.PO_Item "
		cSQL = cSQL + " ,0 AS WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.S_QTY, D.Weight, M.ID, D.ID_Detail "
		cSQL = cSQL + " ,P.SOitem, P.PO_Item AS PPOitem, P.DueDate, P.Process_ID, P.PWeight, P.QTY, P.ReceivingID AS PReceivingID"
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH (NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH (NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P WITH (NOLOCK) ON D.ID_Detail = P.ID_Detail "
		cSQL = cSQL + " WHERE ( M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
		cSQL = cSQL + " OR ( P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') )"
		cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' ))"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT D.ReceivingID, D.InvoiceValue, M.Heat, 'B' AS TBL, M.PO_Item "
		cSQL = cSQL + " ,0 AS WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.S_QTY, D.Weight, M.ID, D.ID_Detail "
		cSQL = cSQL + " ,P.SOitem, P.PO_Item AS PPOitem, P.DueDate, P.Process_ID, P.PWeight, P.QTY, P.ReceivingID AS PReceivingID"
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH (NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH (NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P WITH (NOLOCK) ON D.ID_Detail = P.ID_Detail "
		cSQL = cSQL + " WHERE ( M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
		cSQL = cSQL + " OR (P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') )"
		cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' ))"
		cSQL = cSQL + " ORDER BY P.Process_ID "
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_Process' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_Process' )
		ENDIF
		
		PRIVATE nMess 
		nMess = 6
		PRIVATE cHeat
		cHeat = ''
		
		IF USED('tmpPO_Process')
			IF RECCOUNT('tmpPO_Process') > 0
				PRIVATE nRecCount, nRecNum, nMess
				nRecCount = RECCOUNT('tmpPO_Process')
				PRIVATE nReceivingID, nInvoiceValue, cTBL
				PRIVATE cPO_Item, cSOitem, cPPOItem, dDueDate, cProcess_ID, nPWeight, nQTY, nReceivingID
				cHeat = '*'
				SCAN
					IF ThisForm.lClone 
						nReceivingID 	= 0
						nInvoiceValue	= 0
						*cHeat		 	= '*'   &&This is the Heat of the Process!
					ELSE
						nReceivingID	= PrepareSQLnum(tmpPO_Process.ReceivingID,'ReceivingID',-3)
						IF nReceivingID > 0
							PRIVATE cMess, nNum
							nNum = 4+32
							cMess = "Found a record with that PO item"+CHR(13)
							cMess = cMess + "POitem '"+cPOitem+"'"+CHR(13)
							cMess = cMess + "Receiving ID = "+ALLTRIM(STR(nReceivingID))+CHR(13)
							
							cHeat = "Heat "+ALLTRIM(PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50))
							IF LEN(cHeat)>0
								cMess = cMess +CHR(13)+cHeat+CHR(13)+CHR(13)
							ENDIF
							cMess = cMess +"Answer (Y) to edit this Receive ID."+CHR(13)
							IF ThisForm.cWhat = "ADD"
								cMess = cMess + "But, this was to be an Add, not an Edit."+CHR(13)
								nNum = 4+32+256
							ENDIF
							IF RECNO('tmpPO_Process') < RECCOUNT('tmpPO_Process')
								cMess = cMess+CHR(13)+ "Record "+ALLTRIM(STR(RECNO('tmpPO_Process')))+" of "+ALLTRIM(STR(RECCOUNT('tmpPO_Process')))+" Records."
								cMess = cMess+CHR(13)+"Answer (N) to see next heat."
							ELSE
								cMess = cMess+CHR(13)+"Answer (N) to ADD another Heat."
							ENDIF
							
							nMess = MESSAGEBOX(cMess,nNum,"Edit this heat?")
							IF nMess = 6
								nInvoiceValue	= PrepareSQLnum(tmpPO_Process.InvoiceValue,'InvoiceValue',-5)
								cHeat			= PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50)
							ELSE
								nReceivingID 	= 0
								nInvoiceValue	= 0
								cHeat			= '*'   &&This is the Heat of the Process!
								
							ENDIF
						ELSE
							nReceivingID	= 0
							nInvoiceValue	= 0
							*cHeat			= '*'   &&This is the Heat of the Process!
						ENDIF					
					ENDIF
					
					cTBL		= PrepareSQLtxt(tmpPO_Process.TBL,'TBL',1)
					cPO_Item	= PrepareSQLtxt(tmpPO_Process.PO_Item,'PO_Item',12)
					cSOitem		= PrepareSQLtxt(tmpPO_Process.SOitem,'SOitem',10)
					cPPOItem	= PrepareSQLtxt(tmpPO_Process.PPOItem,'POItem',12)
					dDueDate	= PrepareSQLdate(tmpPO_Process.DueDate,'DueDate')
					cProcess_ID	= PrepareSQLtxt(tmpPO_Process.Process_ID,'Process_ID',10)
					nPWeight	= PrepareSQLnum(tmpPO_Process.PWeight,'PWeight',-5)
					nQTY		= PrepareSQLnum(tmpPO_Process.QTY,'QTY',-5)
					nPReceivingID	= PrepareSQLnum(tmpPO_Process.PReceivingID,'ReceivingID',-3)
					nRecNum		= RECNO('tmpPO_Process')
					
					*Find best POitem
					IF Proper_PO_item(cPPOItem) != Proper_PO_item('')
						IF Proper_PO_item(cPO_item) != Proper_PO_item('')
							cPOitem = cPPOItem
						ELSE
							cPOitem = cPO_item
						ENDIF
					ELSE
						IF Proper_PO_item(cPO_item) != Proper_PO_item('')
							cPOitem = cPO_item
						ELSE
							*cPOitem = ''
						ENDIF
					ENDIF
		
					IF nRecCount = 1
						*Only 1 Record found
						DO CASE
						CASE nReceivingID = 0
							IF LEN(cHeat)=0 OR cHeat = '*'
								* No need to Ask, just use this one record.
								IF cProcess_ID = "SELECTED"
									*cProcess_ID = "INCOMING" "NOT2HPA" "PARTRECV"
								ELSE
									nMess = 6
								ENDIF
							ELSE
								IF cHeat = 'Due In'
									IF UPPER(cProcess_ID) = "INCOMING"
										nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "NOT2HPA"
										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "PARTRECV"
										nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
								ENDIF
							ENDIF
						CASE nPReceivingID = 0
							IF EMPTY(cHeat) OR cHeat = '*'
								IF UPPER(cProcess_ID) = "INCOMING"
									nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
								IF UPPER(cProcess_ID) = "NOT2HPA"
									nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
								IF UPPER(cProcess_ID) = "PARTRECV"
									nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
							ELSE
								IF cHeat = 'Due In'
									IF UPPER(cProcess_ID) = "INCOMING"
										nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "NOT2HPA"
										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "PARTRECV"
										nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
								ENDIF
							ENDIF
						CASE nReceivingID > 0
							IF EMPTY(cHeat) OR cHeat = '*'
								IF UPPER(cProcess_ID) = "INCOMING"
									nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
								IF UPPER(cProcess_ID) = "NOT2HPA"
									nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Edit?"+CHR(13)+"Process_ID:NOT2HPA"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
								IF UPPER(cProcess_ID) = "PARTRECV"
									nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Edit?"+CHR(13)+"Process_ID:PARTRECV"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
							ELSE
								IF cHeat = 'Due In'
									IF UPPER(cProcess_ID) = "INCOMING"
										nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "NOT2HPA"
										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Edit?"+CHR(13)+"Process_ID:NOT2HPA"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "PARTRECV"
										nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Edit?"+CHR(13)+"Process_ID:PARTRECV"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF					
								ENDIF
							ENDIF
						CASE nPReceivingID > 0
							IF EMPTY(cHeat) OR cHeat = '*'
								IF UPPER(cProcess_ID) = "INCOMING"
									nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
								IF UPPER(cProcess_ID) = "NOT2HPA"
									nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
								IF UPPER(cProcess_ID) = "PARTRECV"
									nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Edit?"+CHR(13)+"Process_ID:PARTRECV"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
								ENDIF
							ELSE
								IF cHeat = 'Due In'
									IF UPPER(cProcess_ID) = "INCOMING"
										nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Edit?"+CHR(13)+"Process_ID:INCOMING"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "NOT2HPA"
										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Edit?"+CHR(13)+"Process_ID:NOT2HPA"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "PARTRECV"
										nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Edit?"+CHR(13)+"Process_ID:PARTRECV"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPWeight)+CHR(13)+"QTY:"+STR(nQTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
								ENDIF
							ENDIF
						ENDCASE
					ENDIF
					****
					
					IF nMess = 6	&&Correct record
						IF ThisForm.lClone
							ThisForm.txtReceivingID.Value = ''
							*ThisForm.txtID_Master.Value	= 0
							*ThisForm.txtID_Detail.Value	= 0
							*ThisForm.txtTBL.Value		= ''
						ELSE
							ThisForm.txtReceivingID.Value = PrepareSQLnum(tmpPO_Process.ReceivingID,'ReceivingID',-3)
						ENDIF
						
						ThisForm.txtID_Master.Value	= PrepareSQLnum(tmpPO_Process.ID,'ID_Master',-3)
						ThisForm.txtID_Detail.Value	= PrepareSQLnum(tmpPO_Process.ID_Detail,'ID_Detail',-3)
						ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpPO_Process.TBL,'TBL',1)
						
						ThisForm.txtWO.Value		= PrepareSQLnum(tmpPO_Process.WO,'WO',-3)
						*WO is not used for Receiving
						ThisForm.txtWO_Detail.Value	= 0
						
						*ThisForm.txtReceived.Value = PrepareSQLDate(tmpPO_Process.Received,'Received')
						ThisForm.txtReceived.Value = PrepareSQLDate(DATE(),'Received')
						
						ThisForm.cPOitem 			= PrepareSQLtxt(cPOitem,'POitem',12)
						ThisForm.txtHpaPONum.Value 	= Proper_PO_Item_PO(ThisForm.cPOitem)
						ThisForm.txtHpaPOItem.Value = Proper_PO_Item_Item(ThisForm.cPOitem)
						
						PRIVATE cSOitem
						cSOitem = Proper_SO_item(PrepareSQLtxt(tmpPO_Process.SOitem,'SOitem',10))
						
						ThisForm.cSOitem			= ''
						ThisForm.txtSOnum.Value		= 0
						ThisForm.txtSOitem.Value	= 0
		
						IF cSOitem != Proper_SO_item("")	
							*Do not use a SOitem if it is Cancelled.
							IF Count_SOIteminSales(cSOitem, ThisForm.nConnHandle ) > 0
								IF Count_SOIteminSales(cSOitem, ThisForm.nConnHandle, "CANCEL") < 1
									ThisForm.cSOitem			= PrepareSQLtxt(tmpPO_Process.SOitem,'SOitem',10)
									ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(ThisForm.cSOitem)
									ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(ThisForm.cSOitem)
								ENDIF
							ENDIF
						ENDIF
						
						*******
										
						ThisForm.txtAlloy.Value		= PrepareSQLtxt(tmpPO_Process.Alloy,'Alloy',12)
						IF NOT ThisForm.lClone
							IF NOT EMPTY(ThisForm.cHeat)
								* ThisForm.cHeat was passed in as a Parameter.
							ELSE
								ThisForm.txtHeat.Value		= PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50)
							ENDIF
						ENDIF
						*ThisForm.chkCert.Value		= IIF(tmpPO_Process.Cert,1,0)
						ThisForm.chkCert.Value		= 0
						
						ThisForm.txtPieces.Value	= PrepareSQLnum(tmpPO_Process.PC,'PC',-3)
						ThisForm.edtDescription.Value = PrepareSQLtxt(tmpPO_Process.Descript,'Decript',20)
						ThisForm.edtSpecs.Value		= PrepareSQLtxt(tmpPO_Process.Specs,'Specs',160)
						*ThisForm.edtComments.Value 	= tmpPO_Process.Comments,
						ThisForm.edtComments.Value 	= ''
						
						*ThisForm.txtInit.Value		= tmpPO_Process.Init
						ThisForm.txtInit.Value		= ''
						
						*ThisForm.txtDate.Value		= DTOC(tmpPO_Process.Date)
						ThisForm.txtDate.Value 		= PrepareSQLDate(DATE(),'DATE')
						
						*ThisForm.chkPass.Value		= IIF(tmpPO_Process.Pass,1,0)
						ThisForm.chkPass.Value		= 0
						
						*ThisForm.chkGoodPapers.Value = IIF(tmpPO_Process.GoodPapers,1,0)
						ThisForm.chkGoodPapers.Value = 0
						
						ThisForm.txtActualW.Value	= PrepareSQLnum(tmpPO_Process.S_QTY,'S_QTY',-5)
						ThisForm.txtBillW.Value		= PrepareSQLnum(tmpPO_Process.Weight,'Weight',9,1)
						
						*ThisForm.txtVendor.Value	= tmpPO_Process.Vendor
						*ThisForm.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisForm.nConnHandle ) &&Do not need seperate call
						ThisForm.txtVendor.Value	= ''   &&Company is filled in with the next PurchaseOrder Select
						
						*ThisForm.txtRejectPC.Value		= tmpPO_Process.RejectPC
						ThisForm.txtRejectPC.Value		= 0
						
						*ThisForm.txtRejectReason.Value	= tmpPO_Process.RejectReason
						ThisForm.txtRejectReason.Value	= ''
						
						*ThisForm.txtRMA_No.Value		= tmpPO_Process.RMA_No
						ThisForm.txtRMA_No.Value		= 0
						
						*ThisForm.StockLst_TBL		= PrepareSQLtxt(tmpPO_Process.TBL,'TBL',1)
						
						EXIT  &&SCAN
					ENDIF
				ENDSCAN
			ENDIF
			USE IN tmpPO_Process
		ENDIF
		************************************************
		
		***Look at PurchaseOrder to back fill ThisForm.frmReceiving-Not PO RecvStock
		PRIVATE cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, lRandLen, cDispAlloy, nStandSize, cMisc_purch
		PRIVATE nSalesNum, nItemSo, cDescription, nWeight
		PRIVATE cSOitem, cHeatCurr
		
		IF USED('tmpPOp')
			USE IN tmpPOp
		ENDIF
		
		cSQL = "SELECT ItemPO, SOitem, Company, Alloy, Form, Order_Qty, Pieces"
		cSQL = cSQl + ",Thck, Sz2, Sz3, Cond_Spec, Heat, RandLen, DispAlloy, StandSize, misc_purch "
		cSQL = cSQl + ",StockLst_QTY,StockLst_P,Pounds,Order_PU "
		cSQL = cSQl + ",Services,Convserv,Equipment,Stock"
		cSQL = cSQl + " FROM dbo.PurchaseOrder WITH (NOLOCK) "
		cSQL = cSQl + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
		ENDIF
		
		IF USED('tmpPOp')
			IF RECCOUNT('tmpPOp') > 0
				*get PO Item data
				ThisForm.txtHPAPOItem.Value = PrepareSQLnum(tmpPOp.ItemPO,'ItemPO',2)
				ThisForm.cPOitem		=  cPOitem
				ThisForm.txtHPAPONum.Value = VAL(cPOitem)
				ThisForm.ChecknItemPO	= ThisForm.txtHPAPOItem.Value
				ThisForm.ChecknHPApo	= VAL(cPOitem)
				
				cSOitem = Proper_SO_Item(tmpPOp.SOitem)
				IF !EMPTY(cSOitem) AND Proper_SO_Item(cSOitem) != Proper_SO_Item('')
				
					IF Count_SOIteminSales(cSOitem, ThisForm.nConnHandle ) > 0
						IF Count_SOIteminSales(cSOitem, ThisForm.nConnHandle, "CANCEL") < 1
							*Do not use if Cancelled
							ThisForm.cSOitem			= PrepareSQLtxt(tmpPOp.SOitem,'SOitem',10)
							ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(ThisForm.cSOitem)
							ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(ThisForm.cSOitem)
						ENDIF
					ENDIF
				ENDIF
				
				*
				*Only ask only if a Service or Conv or Service PO ??? removed 01/16/19
				*IF PO_POitem_Cnt( cPOitem, ThisForm.nConnHandle, 'SERVICECONVSERV' ) > 0 removed 01/16/19
					cCompany = PrepareSQLtxt(tmpPOp.Company,'Company',30)
					IF !EMPTY(cCompany)
						IF !EMPTY(ThisForm.txtVendor.Value)
							IF ALLTRIM(UPPER(get_NoNoiseName(ThisForm.txtVendor.Value,ThisForm.nConnHandle))) != ALLTRIM(UPPER(get_NoNoiseName(cCompany,ThisForm.nConnHandle)))
		*						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Vendor '"+ALLTRIM(ThisForm.txtVendor.Value)+"' with '"+Alltrim(cCompany)+"?"+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Vendor listed differently.") = 6
									ThisForm.txtVendor.Value = cCompany
		*						ENDIF
							ENDIF
						ELSE
							ThisForm.txtVendor.Value = ShowSQLtxt(cCompany,'Company',30)
						ENDIF
					ENDIF
				*ENDIF
				*
				cAlloy = PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
				IF !EMPTY(cAlloy)
					IF !EMPTY(ThisForm.txtAlloy.Value)
						IF ThisForm.txtAlloy.Value != cAlloy
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Alloy '"+ALLTRIM(ThisForm.txtAlloy.Value)+"' with '"+Alltrim(cAlloy)+"?"+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Alloy listed differently.") = 6
								ThisForm.txtAlloy.Value = cAlloy
							ENDIF
						ENDIF
					ELSE
						ThisForm.txtAlloy.Value = cAlloy
					ENDIF
				ENDIF
				*
				cForm = PrepareSQLtxt(tmpPOp.Form,'form',2)
				nPieces = PrepareSQLnum(tmpPOp.Pieces,'Pieces',11,3)
				IF nPieces > 0
					IF !EMPTY(ThisForm.txtPieces.Value)
						IF ROUND(ThisForm.txtPieces.Value,0) != ROUND(nPieces,0)
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Pieces '"+ALLTRIM(STR(ThisForm.txtPieces.Value))+"' with '"+Alltrim(STR(nPieces))+"?"+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Pieces listed differently.") = 6
								ThisForm.txtPieces.Value = nPieces
							ENDIF
						ENDIF
					ELSE
						ThisForm.txtPieces.Value = nPieces
					ENDIF
				ENDIF
				*
				nThck = PrepareSQLnum(tmpPOp.Thck,'Thck',10,4)
				nSz2 = PrepareSQLnum(tmpPOp.Sz2,'Sz2',10,3)
				nSz3 = PrepareSQLnum(tmpPOp.Sz3,'Sz3',10,3)
				cCond_Spec = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-1)
				IF !EMPTY(cCond_Spec)
					IF !EMPTY(ThisForm.edtSpecs.Value)
						IF ALLTRIM(UPPER(ThisForm.edtSpecs.Value)) != ALLTRIM(UPPER(cCond_Spec))
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Specs '"+ALLTRIM(ThisForm.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cCond_Spec)+"?"+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Specs listed differently.") = 6
								ThisForm.edtSpecs.Value = cCond_Spec
							ENDIF
						ENDIF
					ELSE
						ThisForm.edtSpecs.Value = cCond_Spec
					ENDIF
				ENDIF
				*
		*!*			cHeat = PrepareSQLtxt(tmpPOp.Heat,'Heat',40)
		*!*			IF !EMPTY(cHeat)
		*!*				IF !EMPTY( ALLTRIM(ThisForm.txtHeat.Value ))
		*!*					*IF ALLTRIM(UPPER(ThisForm.txtHeat.Value)) != ALLTRIM(UPPER(cHeat))
		*!*					
		*!*						*CHOOSE Receiving Details if different heat
		*!*		
		*!*					*ENDIF
		*!*				ELSE
		*!*					ThisForm.txtHeat.Value = cHeat
		*!*				ENDIF
		*!*			ENDIF
				*
				lRandLen = PrepareSQLlogic(tmpPOp.RandLen,'RandLen')
				nStandSize = PrepareSQLnum(tmpPOp.StandSize,'StandSize',10,4)
				**
				PRIVATE nOrder_PU
				nOrder_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
				IF nOrder_PU = 0
					*Use old way
					nOrder_PU = GetPUfromForm( cForm, ThisForm.nConnHandle )
				ENDIF
				
				*FormUnitPrice('10') FormUnitCaption('10')
				PRIVATE cPriceUnit
				cPriceUnit = FormUnitPrice(cForm)
				ThisForm.lblPriceUnit.Caption = cPriceUnit
				
				PRIVATE nStockLst_Qty
				nStockLst_Qty	= PrepareSQLnum(tmpPOp.StockLst_Qty,'StockLst_QTY',-5)
				PRIVATE nBillW
				nBillW			= PrepareSQLnum(ThisForm.txtBillW.Value,'BillW',-5)
				IF nStockLst_Qty > 0
					IF nBillW > 0
						IF ROUND(nBillW,-1) != ROUND(nStockLst_Qty,-1)
							IF ThisForm.cWhat = "ADD"
								*no need to ask on ADD.
								nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
								ThisForm.txtBillW.Value = nStockLst_Qty
							ELSE
								IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(nBillW))+"'"+CHR(13)+" with '"+Alltrim(STR(nStockLst_Qty))+"' ?"+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Bill Weight listed differently.") = 6
									ThisForm.txtBillW.Value = nStockLst_Qty
								ELSE 
									nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
								ENDIF
							ENDIF
						ENDIF
					ELSE
						ThisForm.txtBillW.Value = nStockLst_Qty
					ENDIF
				ENDIF
				*
				PRIVATE nPounds 
				nPounds = PrepareSQLnum(tmpPOp.Pounds,'Pounds',9,1)
				IF nPounds > 0
					IF cPriceUnit = "LB"
						IF nBillW > 0
							IF ROUND(nBillW,-1) != ROUND(nPounds,-1)
								IF ThisForm.cWhat = "ADD"
									*no need to ask on ADD.
									nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
									ThisForm.txtBillW.Value = nStockLst_Qty
								ELSE
									IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(nBillW))+"'"+CHR(13)+" with '"+Alltrim(STR(nPounds))+"?"+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Bill Weight listed differently.") = 6
										ThisForm.txtBillW.Value = nPounds
									ENDIF
								ENDIF
							ENDIF
						ELSE
							ThisForm.txtBillW.Value = nPounds
						ENDIF
					ENDIF
				ENDIF
				*	
				*
				cMisc_purch = PrepareSQLtxt(tmpPOp.misc_purch,'Misc_Purch',-1)
				IF !EMPTY(cMisc_purch)
					IF !EMPTY(ThisForm.edtSpecs.Value)
						IF ALLTRIM(UPPER(ThisForm.edtSpecs.Value)) != ALLTRIM(UPPER(cMisc_purch))
							*IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Spec '"+ALLTRIM(ThisForm.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cMisc_purch)+"?",4+32,"Purchase Order Table has Spec listed differently.") = 6
							*	ThisForm.edtSpecs.Value = cMisc_purch
							*ELSE
								*IF EMPTY(ThisForm.edtComments.Value)
								*	IF MESSAGEBOX("Do you want to save this line "+CHR(13)+Alltrim(cMisc_purch)+CHR(13)+" to the Comment field? ",4+32,"Save info") = 6
								*		ThisForm.edtComments.Value = cMisc_purch
								*	ENDIF
								*ENDIF
							*ENDIF
						ENDIF
					ELSE
						ThisForm.edtSpecs.Value = cMisc_purch
					ENDIF
				ENDIF
				*
				cDescription = ''
				IF !EMPTY(cAlloy) AND !EMPTY(cForm) AND nThck > 0
					cDescription = ItemDescriptionMetric(cForm, nThck, nSZ2, nSZ3, nPounds, lRandLen, .F.,'','','' ) 
				*	ItemDescriptionMetric(Quotes.Form, Quotes.Thck, Quotes.SZ2, Quotes.SZ3, Quotes.Weight, Quotes.RandLen, Quotes.Metric, Quotes.Sz1orig, Quotes.Sz2orig, Quotes.Sz3orig) 
				ENDIF
				IF !EMPTY(cDescription)
					IF !EMPTY(ThisForm.edtDescription.Value)
						IF ALLTRIM(UPPER(ThisForm.edtDescription.Value)) != ALLTRIM(UPPER(cDescription))
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Description '"+ALLTRIM(ThisForm.edtDescription.Value)+"'"+CHR(13)+" with '"+Alltrim(cDescription)+"?"+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Description listed differently.") = 6
								ThisForm.edtDescription.Value = cDescription
							ENDIF
						ENDIF
					ELSE
						ThisForm.edtDescription.Value = cDescription
					ENDIF
				ENDIF
				*
				*Table
				
				IF PrepareSQLtxt(tmpPOp.Stock,'Stock',13) = 'No Stock'
					PRIVATE nID_Master, nID_Detail
					nID_Master = PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
					nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
					
					IF LEN(cTBL) > 0 AND nID_Master > 0 AND nID_Detail > 0
						ThisForm.txtTBL.Value = cTBL
						MESSAGEBOX("Ignoring the POitem 'No Stock' line."+CHR(13)+"listing as Stock in TBL="+cTBL+", ID="+ALLTRIM(STR(nID_Master))+", ID_Detail="+ALLTRIM(STR(nID_Detail))+" on a Receive.",64,"Found problem.")
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Ignoring POitem 'No Stock' and listing as TBL="+cTBL+", ID="+ALLTRIM(STR(nID_Master))+", ID_Detail="+ALLTRIM(STR(nID_Detail))+" on a Receive." )
					ELSE			
						ThisForm.txtTBL.Value = 'N'
					ENDIF
				ENDIF
				IF PrepareSQLchk(tmpPOp.Services,'Services') OR PrepareSQLchk(tmpPOp.Convserv,'ConServ') OR PrepareSQLchk(tmpPOp.Equipment,'Equipment')
					ThisForm.txtTBL.Value = 'N'
				ENDIF
			ENDIF
		ENDIF
		
		
		IF ThisForm.cWhat != "ADD"
			***********************************
			*** FROM RecStockGetByPOitem
			*** GetFromReceiving
			*************************************************
		
			IF USED("cntReceiving2")
				USE IN cntReceiving2
			ENDIF
		
			cSQL = "SELECT ID, Heat "
			cSQL = cSQL + " FROM dbo.Receiving WITH (NOLOCK) "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			SELECT 0  
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntReceiving2')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntReceiving2')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntReceiving2')
				RETURN
			ENDIF
			IF USED('cntReceiving2')
				IF RECCOUNT('cntReceiving2') > 0
		
					*CHOOSE Receiving Details if different heat
					PRIVATE nReceivingID, lDiffHeat
					nReceivingID = 0
					lDiffHeat = .F.
					
					IF VARTYPE(cntReceiving2.Heat)="C"
						cHeat = ShowSQLtxt(cntReceiving2.Heat,'HEAT',50)
					ENDIF
					cHeatCurr = ShowSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
					
					IF LEN(cHeatCurr) > 1 AND LEN(cHeat) > 1
						IF NOT cHeatCurr $ cHeat
							lDiffHeat = .T.
						ENDIF
					ENDIF
					
					IF lDiffHeat
						DO FORM Forms\ChooseReceivingDetails WITH cPOitem,cHeat TO nReceivingID
						nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
						IF TYPE("nReceivingID")="N"
							IF nReceivingID > 0
								*ThisForm.ReceivingID = nReceivingID
								
								ThisForm.txtReceivingID.Value = nReceivingID
								ThisForm.txtReceivingID.refresh
								
								IF USED("tmpReceivingPOi")
									USE IN tmpReceivingPOi
								ENDIF
		
								cSQL = "SELECT * "
								cSQL = cSQL + " FROM dbo.Receiving WITH (NOLOCK) "
								cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
								
								
								SELECT 0  
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOi')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOi')
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpReceivingPOi')
									RETURN
								ENDIF
								IF USED('tmpReceivingPOi')
									ThisForm.txtHeat.Value		= ShowSQLtxt(tmpReceivingPOi.Heat,'Heat',50,.F.,.T.)
									ThisForm.chkCert.Value		= PrepareSQLchk(tmpReceivingPOi.Cert,'Cert')
									ThisForm.txtPieces.Value	= PrepareSQLnum(tmpReceivingPOi.Pieces,'Pieces',-3)
									ThisForm.edtDescription.Value = ShowSQLtxt(tmpReceivingPOi.Description,'Descript',20,.F.,.T.)
									ThisForm.edtSpecs.Value		= ShowSQLtxt(tmpReceivingPOi.Specs,'Specs',160)
									ThisForm.edtComments.Value	= ShowSQLtxt(tmpReceivingPOi.Comments,'Receipt',-1)
									ThisForm.txtInit.Value		= ShowSQLtxt(tmpReceivingPOi.Init,'INIT',10)
									ThisForm.txtDate.Value		= ShowSQLdate(tmpReceivingPOi.Date,'Date')
									ThisForm.chkPass.Value		= PrepareSQLchk(tmpReceivingPOi.Pass,'Pass')
									ThisForm.chkGoodPapers.Value	= PrepareSQLchk(tmpReceivingPOi.GoodPapers,'GoodPapers')
									
									ThisForm.txtActualW.Value	= PrepareSQLnum(tmpReceivingPOi.ActualW,'Weight',9,1)
									ThisForm.txtBillW.Value		= PrepareSQLnum(tmpReceivingPOi.BillW,'Weight',9,1)
									
									ThisForm.txtVendor.Value	= ShowSQLtxt(tmpReceivingPOi.Vendor,'Vendor',30)
									ThisForm.txtRMA_No.Value	= PrepareSQLnum(tmpReceivingPOi.RMA_No,'RMA_No',-3)
									ThisForm.txtRejectPC.Value	= PrepareSQLnum(tmpReceivingPOi.RejectPC,'RejectPC',-3)
									ThisForm.txtRejectReason.Value	= ShowSQLtxt(tmpReceivingPOi.RejectReason,'RejectReason',255)
									
									*ThisForm.txtAlloy.SetFocus()
									
									USE IN tmpReceivingPOi
									
								ENDIF
		
							ENDIF
						ENDIF
					ENDIF
				ENDIF	
				
				USE IN cntReceiving2
			ENDIF	
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE getsoitemdetail
		*ThisForm.GetSoItemDetail()
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrePareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrePareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
		IF Proper_SO_item(cSOitem) = Proper_SO_item('')
			IF Proper_SO_item(ThisForm.cSOitem) <> Proper_SO_item('')
				cSOitem = ThisForm.cSOitem 
			ENDIF
		ELSE
			IF Proper_SO_item(ThisForm.cSOitem) = Proper_SO_item('')
				ThisForm.cSOitem = cSOitem
			ENDIF
		ENDIF
		
		
		PRIVATE cSQL, nSQLExec
		IF USED("tmpSOitem")
			USE IN tmpSOitem
		ENDIF
		
		PRIVATE cSOitem, cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, lRandLen, cDispAlloy , nOrder_Qty, cMisc_purch
		PRIVATE nSalesNum, nItemSo, cDescription, nPounds
		
		cSQL = "SELECT "
		cSQL = cSQL + "AQ.SOitem, AQ.Company, AQ.Alloy, AQ.Pieces, AQ.Weight "
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS DescriptM "
		
		cSQL = cSQL + ",SS.Alloy AS SSAlloy, SS.Pieces AS SSPieces, SS.Weight AS SSWeight"
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.Pieces, SS.Form, SS.Thck, SS.SZ2, SS.SZ3, SS.Weight, SS.RandLen, SS.Metric, '', '', '') AS SSDescriptM "
		
		cSQL = cSQL + " FROM dbo.AllQuotes AQ WITH (NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StartingStock SS WITH (NOLOCK) ON SS.AllQuotes_ID = AQ.ID "
		cSQL = cSQL + " WHERE AQ.SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitem' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitem' )
		ENDIF
		
		IF USED('tmpSOitem')
			IF RECCOUNT('tmpSOitem') > 0	
				IF TYPE("tmpSOitem.SOitem") = "C"
					cSOitem = tmpSOitem.SOitem
				ELSE
					cSOitem = ''
				ENDIF
		
				nSalesNum	= Proper_SO_item_SO(cSOitem)
				nItemSo		= Proper_SO_Item_Item(cSOitem)
		*		ThisForm.txtSOitem.Value = nItemSO
				
				*Only ask only if a Service or ConvService PO
				*IF PO_POitem_Cnt( cPOitem, ThisForm.nConnHandle, 'SERVICECONVSERV' ) >
				
		*!*			cCompany = ShowSQLtxt(tmpSOitem.Company,'Company',30)
		*!*			IF !EMPTY(cCompany)
		*!*				IF !EMPTY(ThisForm.txtVendor.Value)
		*!*					IF ALLTRIM(UPPER(ThisForm.txtVendor.Value)) != ALLTRIM(UPPER(cCompany))
		*!*						*IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Vendor '"+ALLTRIM(ThisForm.txtVendor.Value)+"'"+CHR(13)+"with '"+Alltrim(cCompany)+"?"+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Vendor listed differently.") = 6
		*!*							ThisForm.txtVendor.Value = cCompany
		*!*						*ENDIF
		*!*					ENDIF
		*!*				ELSE
		*!*					ThisForm.txtVendor.Value = cCompany
		*!*				ENDIF
		*!*			ENDIF
				
				PRIVATE lHasSS
				lHasSS = .F.
				IF NOT EMPTY(tmpSOitem.SSDescriptM)
					lHasSS = .T.
				ENDIF
				
				IF lHasSS 
					cAlloy = PrepareSQLtxt(tmpSOitem.SSAlloy,'Alloy',12)
				ELSE
					cAlloy = PrepareSQLtxt(tmpSOitem.Alloy,'Alloy',12)
				ENDIF
		
				IF !EMPTY(cAlloy)
					IF !EMPTY(ThisForm.txtAlloy.Value)
						IF ThisForm.txtAlloy.Value != cAlloy
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Alloy '"+ALLTRIM(ThisForm.txtAlloy.Value)+"'"+CHR(13)+"with '"+Alltrim(cAlloy)+"?"+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Alloy listed differently.") = 6
								ThisForm.txtAlloy.Value = cAlloy
							ENDIF
						ENDIF
					ELSE
						ThisForm.txtAlloy.Value = cAlloy
					ENDIF
				ENDIF
				***
				
				IF lHasSS 
					nPieces = PrepareSQLnum(tmpSOitem.SSPieces,'SSPieces',-3)
				ELSE
					nPieces = PrepareSQLnum(tmpSOitem.Pieces,'Pieces',-3)
				ENDIF
				
				IF nPieces > 0
					IF !EMPTY(ThisForm.txtPieces.Value)
						IF ThisForm.txtPieces.Value != nPieces 
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Pieces '"+ALLTRIM(STR(ThisForm.txtPieces.Value))+"'"+CHR(13)+"with '"+Alltrim(STR(nPieces))+"?"+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Alloy listed differently.") = 6
								ThisForm.txtPieces.Value = nPieces
							ENDIF
						ENDIF
					ELSE
						ThisForm.txtPieces.Value = nPieces
					ENDIF
				ENDIF
				***
				
				IF lHasSS 
					nOrder_Qty = PrepareSQLnum(tmpSOitem.SSWeight,'SSWeight',9,1)
				ELSE
					nOrder_Qty = PrepareSQLnum(tmpSOitem.Weight,'Weight',9,1)
				ENDIF
				
				IF nOrder_Qty > 0
					IF ThisForm.txtBillW.Value > 0
						IF ThisForm.txtBillW.Value != nOrder_Qty
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisForm.txtBillW.Value))+"'"+CHR(13)+"with '"+Alltrim(STR(nOrder_Qty))+"?"+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Heat listed differently.") = 6
								ThisForm.txtBillW.Value = nOrder_Qty
							ENDIF
						ENDIF
					ELSE
						ThisForm.txtBillW.Value = nOrder_Qty
					ENDIF
				ENDIF
				
				***
				IF lHasSS
					nPounds = PrepareSQLnum(tmpSOitem.SSWeight,'SSWeight',9,1)
				ELSE
					nPounds = PrepareSQLnum(tmpSOitem.Weight,'Weight',9,1)
				ENDIF
				
		
				IF nPounds > 0
					IF ThisForm.txtBillW.Value > 0
						IF ThisForm.txtBillW.Value != nPounds 
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisForm.txtBillW.Value))+"'"+CHR(13)+"with '"+Alltrim(STR(nPounds ))+"?"+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Heat listed differently.") = 6
								ThisForm.txtBillW.Value = nPounds 
							ENDIF
						ENDIF
					ELSE
						ThisForm.txtBillW.Value = nPounds 
					ENDIF
				ENDIF
				***
				IF lHasSS
					cDescription = PrepareSQLtxt(tmpSOitem.SSDescriptM,'SSDescriptM',-1)
				ELSE
					cDescription = PrepareSQLtxt(tmpSOitem.DescriptM,'DescriptM',-1)
				ENDIF
				
		
				IF !EMPTY(cDescription)
					IF !EMPTY(ThisForm.edtDescription.Value)
						IF ALLTRIM(UPPER(ThisForm.edtDescription.Value)) != ALLTRIM(UPPER(cDescription))
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Description '"+ALLTRIM(ThisForm.edtDescription.Value)+"'"+CHR(13)+"with '"+Alltrim(cDescription)+"?"+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Description listed differently.") = 6
								ThisForm.edtDescription.Value = cDescription
							ENDIF
						ENDIF
					ELSE
						ThisForm.edtDescription.Value = cDescription
					ENDIF
				ENDIF
				***
		
				PRIVATE cHeat, cMess
				cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		
				IF USED("tmpSDitem")
					USE IN tmpSDitem
				ENDIF
				
				cSQL = "SELECT Heat "
				cSQL = cSQL + " FROM dbo.Sales_Stock WITH (NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
				IF NOT EMPTY(cHeat)
					cSQL = cSQL + " AND Heat = '"+cHeat+"'"
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSDitem')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSDitem' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSDitem' )
				ENDIF
		
				IF USED('tmpSDitem')
					IF RECCOUNT('tmpSDitem') > 0 
						IF RECCOUNT('tmpSDitem') > 1 
							cMess = ''
							SCAN
								IF EMPTY(cMess)
									cMess = ALLTRIM(PrepareSQLtxt(tmpSDitem.Heat,'Heat',50))
								ELSE
									cMess = cMess + ", "+ALLTRIM(PrepareSQLtxt(tmpSDitem.Heat,'Heat',50))
								ENDIF
							ENDSCAN
							MESSAGEBOX("More than 1 Heat was found"+CHR(13)+"for this SOitem."+CHR(13)+cMess,0+64,"Mulitple Heats")
							SCAN
								IF MESSAGEBOX("Do you want to use Heat:"+ALLTRIM(PrepareSQLtxt(tmpSDitem.Heat,'Heat',50)),4+32,"Choose Heat") = 6
									ThisForm.txtHeat.Value = PrepareSQLtxt(tmpSDitem.Heat,'Heat',50)
									EXIT
								ENDIF
							ENDSCAN
						ELSE
							ThisForm.txtHeat.Value = PrepareSQLtxt(tmpSDitem.Heat,'Heat',50)
						ENDIF
					ENDIF
					
					USE IN tmpSDitem
					
					*Get Detail of this Heat.
					cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
					
					IF USED("tmpSDSOiHeat")
						USE IN tmpSDSOiHeat
					ENDIF
					
					cSQL = "SELECT StockLst_ID,StockLst_ID_Detail,TBL,ID "  &&Quoted_PU
					cSQL = cSQL + " ,StockLst_QTY,StockLst_P,StockLst_Total "
					cSQL = cSQL + " ,StockLst_PU,StockLst_PC,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3, StockLst_LBS"
					cSQL = cSQL + " FROM dbo.Sales_Stock WITH (NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
					cSQL = cSQL + " AND Heat = '"+cHeat+"'"
				
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSDSOiHeat')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSDSOiHeat' )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSDSOiHeat' )
					ENDIF
		
					IF USED('tmpSDSOiHeat')
						IF RECCOUNT('tmpSDSOiHeat') > 0 
							ThisForm.txtID_Master.Value	= PrepareSQLnum(tmpSDSOiHeat.StockLst_ID,'Master_ID',-3)
							ThisForm.txtID_Detail.Value	= PrepareSQLnum(tmpSDSOiHeat.StockLst_ID_Detail,'ID_Detail',-3)
							ThisForm.txtTBL.Value 		= PrepareSQLtxt(tmpSDSOiHeat.TBL,'TBL',1)
							*ThisForm.StockLst_TBL		= PrepareSQLtxt(tmpSDSOiHeat.TBL,'TBL',1)
							ThisForm.lblPriceUnit.Caption = ALLTRIM(STR(PrepareSQLnum(tmpSDSOiHeat.StockLst_PU,'PU',1),1))
							ThisForm.RMA_Sales_Detail_ID = PrepareSQLnum(tmpSDSOiHeat.ID,'ID',-3)
							ThisForm.txtActualW.Value	= PrepareSQLnum(tmpSDSOiHeat.StockLst_QTY,'QTY',9,1)
							ThisForm.txtBillW.Value		= PrepareSQLnum(tmpSDSOiHeat.StockLst_LBS,'LBS',9,1)
							*StockLst_P
							*StockLst_Total
							ThisForm.txtPieces.Value 	= PrepareSQLnum(tmpSDSOiHeat.StockLst_PC,'PC',-3)
							* StockLst_Dim1
							IF RECCOUNT('tmpSDSOiHeat') > 1
								MESSAGEBOX("Caution, more than one HEAT record was found!",0+64,"Multiple records found")
							ENDIF	 
						ENDIF
						USE IN tmpSDSOiHeat
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pcWhat, pValue, pcHeat
		*DO FORM Forms\Receive_Set WITH 'EDIT',nRID,''
		*DO FORM Forms\Receive_Set WITH 'ADD','','' --create RID
		*DO FORM Forms\Receive_Set WITH 'B_Process', pnID_Detail_process ,cHeat
		*DO FORM Forms\Receive_Set WITH 'WO_Detail', nWO_Detail ,"ADD"  --Pass create to not just edit, force ADD
		*pcWhat = "ADD "EDIT "RMA "POitem "SOitem" tk_Detail "Brk_Detail "S_Process "B_Process" W_Process "WO_Detail "WO"
		
		IF VARTYPE(pcWhat)!="C"
			pcWhat=''
		ENDIF
		
		IF NOT ( VARTYPE(pValue)="C" OR VARTYPE(pValue)="N" )
			pValue=''
		ENDIF
		
		ThisForm.cWhat = pcWhat
		
		IF VARTYPE(pcHeat)!="C"
			pcHeat=''
		ENDIF
		ThisForm.cHeat = PrepareSQLtxt(pcHeat,'HEAT',50)
		IF ALLTRIM(UPPER(ThisForm.cHeat)) = "DUE IN"
			ThisForm.cHeat	= ""
		ENDIF
		
		ThisForm.txtReceivingID.Value = 0
		ThisForm.txtTBL.Value = ''
		
		DO CASE 
		CASE pcWhat = "ADD"
			ThisForm.ResetAddVars()
			ThisForm.cHeat = PrepareSQLtxt(pcHeat,'HEAT',50)	&&put Heat back in after ResetAddVars()
			
		CASE pcWhat = "EDIT"
			*ThisForm.txtReceivingID.Value = PrepareSQLtxt(pValue,'ReceivingID',-3)
			ThisForm.txtReceivingID.Value = PrepareSQLnum(pValue,'ReceivingID',-3)
			ThisForm.getBy_ReceivingID()
			
		CASE pcWhat = "RMA"
			ThisForm.nRMA = PrepareSQLnum(pValue,'RMA_No',-3)
			ThisForm.txtRMA_No.Value = PrepareSQLtxt(pValue,'RMA_No',-3)
			ThisForm.RMA_Receive()
			
		CASE pcWhat = "POitem"
			ThisForm.cPOitem = PrepareSQLtxt(pValue,'POitem',12)
			IF UPPER(pcHeat) = "ADD"
				ThisForm.cHeat = ""
				ThisForm.cWhat = "ADD"
			ENDIF
			ThisForm.GetPOitemDetail()
		
		CASE pcWhat = "SOitem"
			ThisForm.cSOitem = PrepareSQLtxt(pValue,'SOitem',10)
			IF UPPER(pcHeat) = "ADD"
				ThisForm.cHeat = ""
				ThisForm.cWhat = "ADD"
			ENDIF
			ThisForm.GetSoItemDetail()
		
		CASE pcWhat = "Stk_Detail"
			ThisForm.txtID_Detail.Value = PrepareSQLnum(pValue,'ID_Detail',-3)
			ThisForm.txtTBL.Value = "S"
			IF UPPER(pcHeat) = "ADD"
				ThisForm.cHeat = ""
				ThisForm.cWhat = "ADD"
			ENDIF
			ThisForm.GetBy_STK_Detail()
			
		CASE pcWhat = "Brk_Detail"
			ThisForm.txtID_Detail.Value = PrepareSQLnum(pValue,'ID_Detail',-3)
			ThisForm.txtTBL.Value = "B"
			IF UPPER(pcHeat) = "ADD"
				ThisForm.cHeat = ""
				ThisForm.cWhat = "ADD"
			ENDIF
			ThisForm.GetBy_STK_Detail()
		
		CASE pcWhat = "S_Process"
			ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(pValue,'ID_Detail_Process',-3)
		*	ThisForm.txtID_Detail.Value = 
		*	ThisForm.txtID_Master.Value = 
			ThisForm.txtTBL.Value = "S"
			IF UPPER(pcHeat) = "ADD"
				ThisForm.cHeat = ""
				ThisForm.cWhat = "ADD"
			ENDIF
			ThisForm.GetBy_STK_Detail_Process()
			
		CASE pcWhat = "B_Process"
			ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(pValue,'ID_Detail_Process',-3)
		*	ThisForm.txtID_Detail.Value = 
		*	ThisForm.txtID_Master.Value = 
			ThisForm.txtTBL.Value = "B"
			IF UPPER(pcHeat) = "ADD"
				ThisForm.cHeat = ""
				ThisForm.cWhat = "ADD"
			ENDIF
			ThisForm.GetBy_STK_Detail_Process()
			
		CASE pcWhat = "W_Process"
			ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(pValue,'ID_Detail_Process',-3)
		*	ThisForm.txtID_Detail.Value = 
		*	ThisForm.txtID_Master.Value = 
			ThisForm.txtTBL.Value = "W"
			IF UPPER(pcHeat) = "ADD"
				ThisForm.cHeat = ""
				ThisForm.cWhat = "ADD"
			ENDIF
			ThisForm.GetBy_STK_Detail_Process()
		
		CASE pcWhat = "WO_Detail"
			ThisForm.txtWO_Detail.Value = PrepareSQLtxt(pValue,'WO_Detail',-3)
			IF UPPER(pcHeat) = "ADD"
				ThisForm.cHeat = ""
				ThisForm.cWhat = "ADD"
			ENDIF
			ThisForm.GetBy_nWO_Detail()
			
		CASE pcWhat = "WO"
			ThisForm.txtWO.Value = PrepareSQLtxt(pValue,'WO',-3)
			IF UPPER(pcHeat) = "ADD"
				ThisForm.cHeat = ""
				ThisForm.cWhat = "ADD"
			ENDIF
			ThisForm.GetBy_nWO()
				
		OTHERWISE
			MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Receive_Set WITH 'pcWhat', pValue, 'pcHeat'",16,"Bad Parameters")
			TrackError("Did not get a proper pcWhat. '"+pcWhat+"'"+CHR(13)+"\Receive_Set WITH 'pcWhat', pValue, 'pcHeat'","Parameter error!",PROGRAM(), LINENO(1))
		ENDCASE
		
		PRIVATE nWO, nWO_Detail, nReceivingID
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail 	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		nHpaPo		= PrePareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrePareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		********************************
		IF EMPTY(ThisForm.txtTBL.Value) OR ThisForm.txtTBL.Value = "N"
			*Check POitem
			IF nHpaPo > 0
				ThisForm.txtTBL.Value = getTBL_Poitem(cPOitem, ThisForm.nConnhandle) 
			ENDIF
		ENDIF
		
		
		********************************
		IF EMPTY(ThisForm.txtTBL.Value) OR ThisForm.txtTBL.Value = "N"
			*Find TBL
			DO CASE
			CASE pcWhat = "WO" AND nWO > 0
				ThisForm.txtTBL.Value = getTBL_WO(nWO, ThisForm.nConnhandle) 
			CASE pcWhat = "WO_Detail" AND nWO_Detail > 0
				ThisForm.txtTBL.Value = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
		
			CASE nReceivingID > 0
				ThisForm.txtTBL.Value = getTBL_ReceivingID(nReceivingID, ThisForm.nConnhandle) 
				
			CASE nWO > 0
				ThisForm.txtTBL.Value = getTBL_WO(nWO, ThisForm.nConnhandle) 	
			CASE nWO_Detail > 0
				ThisForm.txtTBL.Value = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
				
			ENDCASE
		ENDIF
		
		
		********************************
		IF EMPTY(ThisForm.txtTBL.Value)
			IF PrepareSQLnum(ThisForm.txtID_Detail.Value,"ID_Detail",-3) > 0 OR PrepareSQLnum(ThisForm.txtID_Master.Value,"ID",-3) > 0
			 	IF VARTYPE(pValue) = 'N'
					TrackError("Did not find TBL. '"+pcWhat+"'"+CHR(13)+"\Receive_Set WITH pcWhat='"+pcWhat+"', pValue="+STR(pValue)+", pcHeat='"+pcHeat+"'","Parameter error!",PROGRAM(), LINENO(1))
				ELSE
					TrackError("Did not find TBL. '"+pcWhat+"'"+CHR(13)+"\Receive_Set WITH pcWhat='"+pcWhat+"', pValue='"+pValue+"', pcHeat='"+pcHeat+"'","Parameter error!",PROGRAM(), LINENO(1))
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "PROC_HPA" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_HPA.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE markasrmareceived
		*ThisForm.MarkAsRMAreceived()
		
		PRIVATE cSQL, nSQLEXEC, nRMA_Detail
		nRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		
		IF nRMA_Detail > 0
			*Update RMA_Detail with Date
			
			PRIVATE dReceived
			dReceived = PrepareSQLdate(ThisForm.txtReceived.Value,'Received')
			IF NOT EMPTY(dReceived)
				cSQL= "UPDATE dbo.RMA_Detail SET"
				cSQL= cSQL+" Returned ='"+DTOC(dReceived)+"'"
				cSQL= cSQL+" WHERE RMA_Detail_ID = "+STR(nRMA_Detail)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update. "+CHR(13)+cSQL )
				ENDIF
			ENDIF	
			
			PRIVATE nID_Master, nID_Detail, nID_Detail_Process
			nID_Master	= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
			nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
			nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
			
			IF nID_Master >0 AND nID_Detail > 0 AND nID_Detail_Process >0
				*Update Sales_Stock
				IF ThisForm.RMA_Sales_Detail_ID > 0	
					cSQL = "UPDATE dbo.Sales_Stock SET "
					cSQL= cSQL+" Returned = 1"
					cSQL= cSQL+",RMA_Detail_ID="+STR(nRMA_Detail)
					*cSQL= cSQL+" WHERE ID = "+STR(ThisForm.RMA_Sales_Detail_ID)
					cSQL= cSQL+" WHERE StockLst_ID = "+STR(nID_Master)
					cSQL= cSQL+" AND StockLst_ID_Detail = "+STR(nID_Detail)
					cSQL= cSQL+" AND ID_Detail_Process = "+STR(nID_Detail_Process)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 1
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
						*RETURN
						RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update. "+CHR(13)+cSQL )
					ENDIF
				ENDIF
			ELSE
				MESSAGEBOX("Did not get full details"+CHR(13)+STR(nID_Master)+" ID_Master"+CHR(13)+STR(nID_Detail)+" ID_Detail"+CHR(13)+STR(nID_Detail_Process)+" ID_Detail_Process",64,"RMA _Detail not Saved")
				
			ENDIF
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE receivedtoordered
		PARAMETER pcPOitem
		*THISFORM.ReportReceivedtoOrdered(cPOitem)
		
		*-* Check Received to Ordered and display difference
		
		IF TYPE("pcPOitem") != "C"
			MESSAGEBOX("No POitem for ReportReceivedtoOrdered(pcPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No POitem for ReportReceivedtoOrdered(pcPOitem)" )
			RETURN
		ENDIF
		
		IF Proper_PO_item(pcPOitem)=Proper_PO_item('')
			MESSAGEBOX("No POitem for ReportReceivedtoOrdered(pcPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No POitem for ReportReceivedtoOrdered(pcPOitem)" )
			RETURN
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item( pcPOitem )
		PRIVATE nDec
		nDec = SET("DECIMAL")
		SET DECIMAL TO 0
		PRIVATE nItemPO, nPO
		nItemPO = VAL( RIGHT( cPOitem,2 ) )
		nPO		= VAL( LEFT(  cPOitem,9 ) )
		SET DECIMAL TO nDec
		
		IF nPO > 0 AND nItemPO > 0
			IF USED("tmpSumPO")
				USE IN tmpSumPO
			ENDIF
			PRIVATE nT_Pc, nT_Weight, nT_Count
			PRIVATE cSQL
			cSQL = "SELECT SUM(d.PC) AS T_pc, SUM(d.Weight) AS T_Weight, COUNT(d.ID) AS T_Count FROM dbo.BrokerLst_Detail d, dbo.BrokerLst_Master m "
			cSQL = cSQL + " WHERE dbo.f_ProperPOitem(m.PO_item) = dbo.f_ProperPOitem('" + cPOitem + "') AND m.ID = d.ID"
		
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumPO')
			
			IF nSQLEXEC < 0
				*retry
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumPO' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumPO' )
				ENDDO
			ENDIF
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSumPO')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSumPO')
				nT_Pc		= 0
				nT_Weight	= 0
				nT_Count	= 0
			ELSE
				nT_Pc		= tmpSumPO.T_Pc
				nT_Weight	= tmpSumPO.T_Weight
				nT_Count	= tmpSumPO.T_Count
			ENDIF
			
			IF USED("tmpSumPO")
				USE IN tmpSumPO
			ENDIF
			
			IF nT_Count = 0 &&Try StockLst
			
				cSQL = "SELECT SUM(d.PC) AS T_pc, SUM(d.Weight) AS T_Weight, COUNT(d.ID) AS T_Count FROM dbo.StockLst_Detail d, dbo.StockLst_Master m "
				cSQL = cSQL + " WHERE dbo.f_ProperPOitem(m.PO_item) = dbo.f_ProperPOitem('" + cPOitem + "') AND m.ID = d.ID"
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumPO')
				
				IF nSQLEXEC < 0
					*retry
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumPO' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumPO' )
					ENDDO
				ENDIF
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSumPO')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSumPO')
					nT_Pc		= 0
					nT_Weight	= 0
					nT_Count	= 0
				ELSE
					nT_Pc		= tmpSumPO.T_Pc
					nT_Weight	= tmpSumPO.T_Weight
					nT_Count	= tmpSumPO.T_Count
				ENDIF
				
				IF USED("tmpSumPO")
					USE IN tmpSumPO
				ENDIF
			
			ENDIF
			
			IF nT_Count = 0
				nT_Pc		= 0
				nT_Weight	= 0
			ENDIF
					
			PRIVATE nT_pcR, nT_ActualR, nT_BillR, nT_CountR 
			nT_pcR		= 0
			nT_ActualR	= 0
			nT_BillR	= 0
			nT_CountR 	= 0
					
			DIMENSION aTotalW(1,4)
			cSQL = "SELECT SUM(Pieces) AS T_pc, SUM(ActualW) AS T_Actual, SUM(BillW) AS T_Bill, COUNT(*) AS T_CountR FROM dbo.Receiving WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			IF USED("tmpReceiving")
				USE IN tmpReceiving
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceiving')
			
				
			IF nSQLEXEC < 0
				*retry
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpReceiving' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpReceiving' )
				ENDDO
			ENDIF
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceiving')
			ENDDO
			
			IF nSQLEXEC < 1
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpReceiving')
			ELSE
				IF !EOF("tmpReceiving")
					IF TYPE("tmpReceiving.T_pc") = "N" OR VARTYPE(tmpReceiving.T_pc)="Y"
						nT_pcR = tmpReceiving.T_pc
					ENDIF
					IF TYPE("tmpReceiving.T_Actual") = "N" OR VARTYPE(tmpReceiving.T_Actual)="Y"
						nT_ActualR = tmpReceiving.T_Actual
					ENDIF
					IF TYPE("tmpReceiving.T_Bill") = "N" OR VARTYPE(tmpReceiving.T_Bill)="Y"
						nT_BillR = tmpReceiving.T_Bill
					ENDIF
					IF TYPE("tmpReceiving.T_CountR") = "N" OR VARTYPE(tmpReceiving.T_CountR)="Y"
						nT_CountR = tmpReceiving.T_CountR
						*Do not keep doubling when their are muliple receiveing records
						IF nT_CountR > 1 AND nT_BillR > 0
							nT_BillR = nT_BillR / nT_CountR 
						ENDIF
					ENDIF
				
				ENDIF
			ENDIF
			
		*	MESSAGEBOX(SPACE(15)+"-Ordered-"+SPACE(7)+"-Received-"  +CHR(13)+;
					   "        PC:"+PADL(STR(nT_Pc),10)    +SPACE(12)+PADL(STR(nT_pcR),10)+CHR(13)+;
					   "  Weight:"+PADL(STR(nT_Weight),10)+SPACE(10)+PADL(STR(nT_ActualR),10)+CHR(13)+;
					   "Billed W:"+PADL(STR(nT_BillR),10) +SPACE(10)+" "+CHR(13)+;
					   "       ID's:"+PADL(STR(nT_Count),10) +SPACE(11)+PADL(STR(nT_CountR),10);
					   ,0+64,"Report Purchase Order Summary for PO-item '"+ALLTRIM(cPOitem)+"'")
					   
		*	DO FORM Forms\ReportReceived_Ordered WITH nT_Pc,nT_pcR,nT_Weight,nT_ActualR,nT_BillR,nT_Count,nT_CountR,cPOitem
		*	DO FORM Forms\ShowReceived_Ordered WITH cPOitem, cAlloy,cHeat,nPieces,nActualW,cDescription,nReceivingID 
		
		
		ENDIF
		
		SELECT Receiving
	ENDPROC

	PROCEDURE receivepostocklst
		PARAMETER pPOitem, pnReceivingID, cHeat, nRMA_Detail, cSOitem, nWO_Detail
		*Thisform.ReceivePOStockLst( purchaseorder.poitem ,pnReceivingID, cHeat, nRMA_Detail, cSOitem, nWO_Detail ) 
		*Calls DO FORM Forms\PORecvStock
		*Relays pReceivingID 
		
		IF VARTYPE(pnReceivingID) != "N"
			TrackError("Parameter pnReceivingID is not a NUMBER","bad variable",PROGRAM(),LINENO(1))
			pnReceivingID = 0
		ENDIF
		
		IF VARTYPE(pPoItem) != "C"
			pPoItem = ""
		ENDIF
		PRIVATE cPOitem
		cPOitem = pPoItem
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ""
		ENDIF
		cHeat = ALLTRIM(cHeat)
		
		IF VARTYPE(nRMA_Detail) != "N"
			nRMA_Detail = 0
		ENDIF
		PRIVATE lRMA
		lRMA = .F.
		IF nRMA_Detail > 0
			lRMA = RMA_Detail_Exists( nRMA_Detail, ThisForm.nConnHandle)	
		ENDIF
		
		IF VARTYPE(cSOitem) != "C"
			cSOitem = ''
		ENDIF
		
		IF VARTYPE(nWO_Detail) != "N"
			nWO_Detail= 0
		ENDIF
		
		*Update StockLst
		************************** StockLst SQL
		
		PRIVATE cSQL_Master_PO, nID_Master, nID_Detail
		nID_Master = 0
		nID_Detail = 0
		PRIVATE nBkrMastCnt, nBkrMastCntRid
		nStkMastCntRid = 0
		nBkrMastCntRid = 0
		PRIVATE nStkMastCnt, nBkrMastCnt 
		nStkMastCnt = 0
		nBkrMastCnt = 0
		PRIVATE cTBL 
		cTBL = "N"
		
		IF pnReceivingID = 0
			pnReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		ENDIF
		
		IF pnReceivingID > 0
			********************* Check History, never overwrite when it has history
			PRIVATE lFoundStockHistory 
			lFoundStockHistory = .F.
			
			IF USED("tmpHistCnt")
				USE IN tmpHistCnt
			ENDIF
			
			cSQL =		  " SELECT COUNT(ID) AS Cntd "
			cSQL = cSQL + " FROM dbo.[Ar.Stocklst_Detail_History] "
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR( pnReceivingID ))
			cSQL = cSQL + " AND [WHAT] = 'BEFOREEDIT' "
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT COUNT(ID) AS Cntd "
			cSQL = cSQL + " FROM dbo.[Ar.BrokerLst_Detail_History] "
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR( pnReceivingID ))
			cSQL = cSQL + " AND [WHAT] = 'BEFOREEDIT' "
			
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpHistCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpHistCnt')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpHistCnt')
				nStkMastCntRid = 0
			ELSE
				IF RECCOUNT('tmpHistCnt') > 0
					IF tmpHistCnt.CNTD > 0
						lFoundStockHistory = .T.
					ENDIF
				ENDIF
			ENDIF
			IF USED("tmpHistCnt")
				USE IN tmpHistCnt
			ENDIF
		
			IF lFoundStockHistory 
				MESSAGEBOX("Found historic Edits on this Receive."+CHR(13)+"PO stock Edit window will NOT show."+CHR(13)+"If you still need to edit StockLst"+CHR(13)+"Use StockLst Maintenance.",0+48,"Not allowed to edit stock.")
				RETURN .T.
			ENDIF
		
			********************* Check StockLst_Detail for Receiving ID
			*Could be used for RMA
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
			
			cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Detail "
			cSQL_S_Master_PO = cSQL_S_Master_PO + " WHERE ReceivingID = "+ALLTRIM(STR( pnReceivingID ))
		
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_S_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'StkMastCnt')
				nStkMastCntRid = 0
			ELSE
				nStkMastCntRid = StkMastCnt.Cntd
				IF nStkMastCntRid > 0
					*ReceivingID is not stored to Stock untill PORecvStock is run
					nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,'StockLst',ThisForm.nConnHandle)
					nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,'StockLst',ThisForm.nConnHandle)  
					IF nID_Master > 0
						cTBL = "S"
					ENDIF
				ENDIF
			ENDIF
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
			
			********************* Check BrokerLst_Detail for Receiving ID	
			IF USED("BkrMastCnt")
				USE IN BkrMastCnt
			ENDIF
		
			cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.BrokerLst_Detail "
			cSQL_S_Master_PO = cSQL_S_Master_PO + " WHERE ReceivingID = "+ALLTRIM(STR( pnReceivingID ))
				
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_S_Master_PO, ThisForm.nConnHandle, nSQLEXEC, 'BkrMastCnt')
				nBkrMastCntRid = 0
			ELSE
				nBkrMastCntRid = BkrMastCnt.Cntd
				IF nBkrMastCntRid > 0
					*ReceivingID is not stored to Stock untill PORecvStock is run
					nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,'BrokerLst',ThisForm.nConnHandle)
					nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,'BrokerLst',ThisForm.nConnHandle)
					IF nID_Master > 0
						cTBL = "B"
					ENDIF
				ENDIF
			ENDIF
		
			IF USED("BkrMastCnt")
				USE IN BkrMastCnt
			ENDIF
		ELSE
			*Why is there no pnReceivingID!!!!
			TrackError("pnReceivingID = 0","No pnReceivingID!",PROGRAM(),LINENO(1))
			*RMA has no
		ENDIF
		
		***********************
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCntRid + nBkrMastCntRid = 0
				*Not in Detail record for ReceivingID
				*Look by POitem - 
				
				IF Proper_PO_Item(pPoItem) != Proper_PO_Item("")
					*Lst_Detail Does not have ReceivingID
					cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL_S_Master_PO = cSQL_S_Master_PO +" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_S_Master_PO = cSQL_S_Master_PO +" AND ( POStatus LIKE 'D' OR POStatus LIKE 'P' OR POStatus IS NULL )"
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_S_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd
						IF nStkMastCnt > 0
							*ReceivingID is not stored to Stock untill PORecvStock is run
		
							nID_Detail = get_ID_Detail_by_ReceivingID(pnReceivingID,'StockLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'StockLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisForm.nConnHandle)
							ENDIF
							IF nID_Master > 0
								cTBL = "S"
							ENDIF
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL_B_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.BrokerLst_Master "
					cSQL_B_Master_PO = cSQL_B_Master_PO +" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_B_Master_PO = cSQL_B_Master_PO+" AND ( POStatus LIKE 'D' OR POStatus LIKE 'P' OR POStatus IS NULL )"
					*OR POStatus IS NULL )"
					
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_B_Master_PO, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_B_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd
						IF nBkrMastCnt > 0
							*ReceivingID is not stored to Stock untill PORecvStock is run
							nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,'BrokerLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'BrokerLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisForm.nConnHandle)
							ENDIF
							IF nID_Master > 0
								cTBL = "b"
							ENDIF
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
				ENDIF
			ELSE
				IF pnReceivingID = 0
					*Why is there no pnReceivingID!!!!
					TrackError("No pnReceivingID!","No pnReceivingID",PROGRAM(),LINENO(1))		
				ENDIF
			ENDIF
		ENDIF
		
		***********************
		
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCnt + nBkrMastCnt + nStkMastCntRid + nBkrMastCntRid= 0
				*No Detail record have ReceivingID
				*Look by POitem - 
		
				IF Proper_PO_Item(pPoItem) != Proper_PO_Item("") 
					*Lst_Detail Does not have ReceivingID
					cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL_S_Master_PO = cSQL_S_Master_PO+" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_S_Master_PO = cSQL_S_Master_PO+" AND ( POStatus NOT LIKE 'A' AND Heat='Due In' )"
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_S_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd 
						IF nStkMastCnt > 0
							*ReceivingID is not stored to Stock untill PORecvStock is run
							nID_Detail = get_ID_Detail_by_ReceivingID(pnReceivingID,'StockLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'StockLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisForm.nConnHandle)
							ENDIF
							IF nID_Master > 0
								cTBL = "S"
							ENDIF
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL_B_Master_PO = "SELECT COUNT(ID) AS Cntd  FROM dbo.BrokerLst_Master "
					cSQL_B_Master_PO = cSQL_B_Master_PO+" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_B_Master_PO = cSQL_B_Master_PO+" AND ( POStatus NOT LIKE 'A' AND Heat='Due In' )"
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_B_Master_PO, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_B_Master_PO, ThisForm.nConnHandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd 
						IF nBkrMastCnt > 0
							*ReceivingID is not stored to Stock untill PORecvStock is run
							nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,'BrokerLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'BrokerLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisForm.nConnHandle)
							ENDIF
							IF nID_Master > 0
								cTBL = "B"
							ENDIF
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
				ENDIF
			ELSE
				IF pnReceivingID = 0
					*Why is there no pnReceivingID!!!!
					TrackError("No pnReceivingID!"+" , nStkMastCnt="+STR(nStkMastCnt)+", nBkrMastCnt="+STR(nBkrMastCnt)+", nStkMastCntRid="+STR(nStkMastCntRid)+", nBkrMastCntRid="+STR(nBkrMastCntRid),"No pnReceivingID",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
		ENDIF
		***********************
		
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCnt + nBkrMastCnt + nStkMastCntRid + nBkrMastCntRid = 0
				*No Detail record have ReceivingID
				*Look by WO_Detail
		
				*IF Proper_PO_Item(pPoItem) = Proper_PO_Item("") 
				IF nWO_Detail > 0
					*Lst_Detail Does not have ReceivingID
					cSQL = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL = cSQL+" WHERE WO_Detail="+STR(nWO_Detail)
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL , 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL , 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd 
						IF nStkMastCnt > 0
							*ReceivingID is not stored to Stock untill PORecvStock is run
							nID_Master = get_ID_Master_with_WO_Detail(nWO_Detail,'StockLst',ThisForm.nConnHandle)
							nID_Detail = get_ID_Detail_by_ReceivingID(pnReceivingID,'StockLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_WO_Detail(nWO_Detail,'StockLst',ThisForm.nConnHandle)
							ENDIF
							IF nID_Detail > 0 AND nID_Master = 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisForm.nConnHandle)
								IF nID_Master > 0
									cTBL = "S"
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL = "SELECT COUNT(ID) AS Cntd  FROM dbo.BrokerLst_Master "
					cSQL = cSQL +" WHERE WO_Detail="+STR(nWO_Detail)
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd 
						IF nBkrMastCnt > 0
							*ReceivingID is not stored to Stock untill PORecvStock is run
							nID_Master = get_ID_Master_with_WO_Detail(nWO_Detail,'BrokerLst',ThisForm.nConnHandle)
							nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,'BrokerLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_WO_Detail(nWO_Detail,'BrokerLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0 AND nID_Master = 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisForm.nConnHandle)
								IF nID_Master > 0
									cTBL = "B"
								ENDIF
							ENDIF
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
		**************************
		
		IF NOT lRMA 
			DO CASE 
			CASE nStkMastCntRid > 0
				DO FORM Forms\PORecvStock WITH pPOitem, 'StockLst', pnReceivingID, nRMA_Detail, nID_Detail, cHeat, nID_Master 
				*					PARAMETER  pPOitem,    pLst,    pnReceivingID, pnRMA_Detail, pnID_Detail, cHeat, pnID_Master 
				*		ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'StockLst ', pnReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
			CASE nBkrMastCntRid > 0
				DO FORM Forms\PORecvStock WITH pPOitem, 'BrokerLst', pnReceivingID, nRMA_Detail, nID_Detail, cHeat, nID_Master 
				*ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'BrokerLst', pnReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
				
			CASE nStkMastCnt > 0
				* SetReceivingID_in_Detail( cPOitem ,pnID_Detail, nConn, cTBL, pnReceiveID, lCancel )
				nID_Detail = SetReceivingID_in_Detail( pPOitem, nID_Detail, ThisForm.nConnHandle, 'StockLst', pnReceivingID, .F. )
				IF nID_Detail > 0 AND nID_Master = 0
					nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisForm.nConnHandle)
				ENDIF
				
				DO FORM Forms\PORecvStock WITH pPOitem, 'StockLst', pnReceivingID, nRMA_Detail, nID_Detail, cHeat, nID_Master 
				*ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'StockLst ', pnReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
			CASE nBkrMastCnt > 0
				* SetReceivingID_in_Detail( cPOitem ,pnID_Detail, nConn, cTBL, pnReceiveID, lCancel )
				nID_Detail = SetReceivingID_in_Detail( pPOitem, nID_Detail, ThisForm.nConnHandle, 'BrokerLst', pnReceivingID, .F. )
				IF nID_Detail > 0 AND nID_Master = 0
					nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisForm.nConnHandle)
				ENDIF
					
				DO FORM Forms\PORecvStock WITH pPOitem, 'BrokerLst', pnReceivingID, nRMA_Detail, nID_Detail, cHeat, nID_Master 
				*ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'BrokerLst', pnReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
			OTHERWISE
					
				*Is this a Lab Test?
				PRIVATE nCountPOitem 
				nCountPOitem = PO_POitem_Cnt( cPOitem, ThisForm.nConnHandle, "NOTRECEIVE" )
				*Only counts if Services = 0 AND ConvServ = 0 AND Equipment = 0 
				IF nCountPOitem > 0
					*ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'StockLst ', pnReceivingID, nRMA_Detail, nID_Detail, cHeat, nID_Master  )
					
					cMess = "ReceivePOStockLst(POitem,ReceivingID,Heat,RMA)."+CHR(13)
					cMess = cMess+"Could not find a Master with ( POStatus NOT LIKE 'A' OR POStatus IS NULL ) "
					cMess = cMess+CHR(13)+"or Detail WHERE ReceivingID="
					cMess = cMess+STR(pnReceivingID)+CHR(13)
					cMess = cMess+" POitem='"+pPOitem+"'"
					cMess = cMess+", Heat='"+ALLTRIM(cHeat)+"'"
					cMess = cMess+", RMA_Detail"+ALLTRIM(STR(nRMA_Detail))
					cMess = cMess+", TBL='"+cTBL+"'"
					*TrackError(cMess,"nStkMastCntRid Not Found",PROGRAM(),LINENO(1) )
					TrackMess(cMess)
		
					*DO FORM Forms\PORecvStock WITH pPOitem, 'StockLst', pnReceivingID, nRMA_Detail, 0, cHeat, 0,'',0
					
					PRIVATE cTableName 
					cTableName = 'StockLst'
					*Probably not the First receive, Check to see if for StockLst
					IF Count_POitem_StockLst ( cPOitem, 'S', ThisForm.nConnHandle ) > 0
						cTableName = 'StockLst'
						cTBL = "S"
					ELSE
						IF Count_POitem_StockLst ( cPOitem, 'B', ThisForm.nConnHandle ) > 0
							cTableName = 'BrokerLst'
							cTBL = "B"
						ENDIF
					ENDIF
					
					nMess = MESSAGEBOX("The PO item 'INCOMING' or 'NOT2HPA' or 'PARTRECV' mark is missing."+CHR(13)+CHR(13)+"This is most like a receive for '"+cTableName+"' table."+CHR(13)+"Just double checking!"+CHR(13)+"Is this correct ? (Y)",3+32,"Save to "+cTableName )
					IF nMess != 6 &&No,Canc
					
						cTableName = IIF(cTableName = 'StockLst', 'BrokerLst', 'StockLst' )
						nMess = MESSAGEBOX("Would you rather receive to '"+cTableName+"' table?",3+32,"Save to "+cTableName )
						
						IF nMess!= 6
							*Must cancel!
							RETURN .F.
						ENDIF
						
					ENDIF
					*                             pPOitem, 'StockLst', pnReceivingID, nRMA_Detail, nID_Detail, cHeat, nID_Master 
					DO FORM Forms\PORecvStock WITH pPOitem, cTableName, pnReceivingID, nRMA_Detail, 0        , cHeat, 0
					
					*Retrieve Detail by ReceivingID
					nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,cTableName,ThisForm.nConnHandle)
					nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,cTableName,ThisForm.nConnHandle) 
					ThisForm.txtID_Master.Value = PrepareSQLnum(nID_Master,'ID',-3)
					ThisForm.txtID_Detail.Value = PrepareSQLnum(nID_Detail,'ID_Detail',-3)
					ThisForm.txtTBL.Value		= cTBL
					
				ELSE
					* Services OR ConvServ OR Equipment
					*Do not add to stock
				ENDIF
			ENDCASE
			
		ENDIF
		IF nRMA_Detail > 0
			*ThisForm.frmRecvStock.txtWhatDo.Value = "Add"
			*Check for RMA **
			*Check Process to see if PO found in Broker or StockLst
			*********************
			*
			*Will this Returned Stock be listed on Inventory?
			IF MESSAGEBOX("Will this Returned Material need to be relisted on Stock List?",4,"Open Stock Receive screen?") = 6
				*
				*Is Master ID Still in Stock.
				*return needs a new ID_Detail
				*
				nID_Master = PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
				nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
				
				IF nID_Master = 0
					*Search of ID
					IF USED('tmpHist')
						USE IN tmpHist
					ENDIF
					
					SELECT 0
					cSQL = "SELECT Distinct M.ID,D.ID_Detail,M.Heat "
					cSQL = cSQL + " FROM dbo.[Ar.StockLst_Process_History] P "
					cSQL = cSQL + " INNER JOIN dbo.[Ar.Stocklst_Detail_History] D ON D.ID_Detail = P.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.[Ar.Stocklst_Master_History] M ON M.ID = D.ID "
					cSQL = cSQL + " WHERE P.SOitem = '"+cSOitem+"'"
					cSQL = cSQL + " AND M.Heat = '"+ALLTRIM(cHeat)+"'"
					*Broker does not record Heat
					
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL , 'tmpHist')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL , 'tmpHist')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL , ThisForm.nConnHandle, nSQLEXEC, 'tmpHist')
					ENDIF
					IF USED('tmpHist')
						IF RECCOUNT('tmpHist') > 0
							nID_Master = PrepareSQLnum(tmpHist.ID,'ID_Master',-3)
							ThisForm.txtID_Master.Value = nID_Master
							*nID_Detail = tmpHist.ID_Detail
						ENDIF
						USE IN tmpHist
					ENDIF
				ENDIF		
				*
				*ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'StockLst ', pnReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
				DO FORM Forms\PORecvStock WITH pPOitem, 'StockLst', pnReceivingID, nRMA_Detail, nID_Detail, cHeat, nID_Master 
			ENDIF
		ENDIF
		
		RETURN .T.
		
		
		
	ENDPROC

	PROCEDURE receivingsaveid_master
		PARAMETERS pReceivingID, pSOitem, pPOitem, nWO_Detail, cHeat, nPieces, nRMA, nActualW
		*ThisForm.ReceivingSaveID_Master( nReceivingID, cSOitem, cPOitem, cHeat, nPieces, nRMA )
		
		***Update ID_Master and StockTable in Receiving
		*a new receive should not have stock marked!
		*RecordID_Master to Receiving.
			
		IF VARTYPE(pReceivingID) != "N"
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		IF pReceivingID < 1
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(pReceivingID,'ReceivingID',-3)
		
		IF VARTYPE(pSOitem) != "C"
			pSOitem = ""
		ENDIF
		
		IF VARTYPE(pPOitem) != "C"
			pPOitem = ""
		ENDIF
		IF pSOitem = Proper_SO_Item("")
			pSOitem = ''
		ENDIF
		
		IF VARTYPE(nWO_Detail) != "N"
			nWO_Detail = 0
		ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem)
			MESSAGEBOX("No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)" )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPieces) != "N"
			nPieces = 0
		ENDIF
		
		IF VARTYPE(nWO_Detail) != "N"
			nWO_Detail = 0
		ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem) AND EMPTY(nWO_Detail)
			MESSAGEBOX("No SO, PO, or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, nWO_Detail)",0,"Parameter Error")
			TrackError("Parameter Error","No SO, PO or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, nWO_Detail)",PROGRAM(),LINENO(1) )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPieces) != "N"
			nPieces = 0
		ENDIF
		
		IF VARTYPE(nRMA) != "N"
			nRMA = 0
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC 
		
		**Find StockLst or BrokerLst and store ID to Receiving
		*Check for Process
		
		PRIVATE nID, nID_Detail, cTBL, nID_Detail_Process
		nID			= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		IF cTBL = "N"
			cTBL = " "
		ENDIF
		
		***********************************
		PRIVATE nTableID_Master, nTableID_Detail
		nTableID_Master = 0
		nTableID_Detail = 0
		
		********
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableName_ReceivingID("+STR(nReceivingID)+") AS TblName"  &&Returns Init
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						SCAN
							IF EMPTY(PrepareSQLtxt(tmpTable.TblName,'TblName',1))
								LOOP
							ELSE
								cTBL = PrepareSQLtxt(tmpTable.TblName,'TblName',1)
								ThisForm.txtTBL.Value = cTBL
								EXIT
							ENDIF
						ENDSCAN
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ENDIF
		
		********
		
		IF nID_Detail < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_Detail_ReceivingID("+STR(nReceivingID)+") AS TableID_Detail"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
		
					IF RECCOUNT('tmpTable') > 0
						nTableID_Detail = PrepareSQLnum(tmpTable.TableID_Detail,'TableID_Detail',-3)
						ThisForm.txtID_Detail.Value = nTableID_Detail 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Detail = nID_Detail
		ENDIF
		
		***********************************
		
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" ) AND nID_Detail > 0
		
			*try for TBL using 'Listing created from %'
			IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
				IF nID > 0 AND nID_Detail > 0
					*Find TBL
					IF USED("tmpTBL")
						USE IN tmpTBL
					ENDIF
					SELECT 0
					
					cSQL =        " SELECT 'S' AS TBL"	
					cSQL = cSQL + " FROM dbo.StockLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'B' AS TBL"	
					cSQL = cSQL + " FROM dbo.BrokerLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'W' AS TBL"	
					cSQL = cSQL + " FROM dbo.WIPLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
					ELSE
						IF USED('tmpTBL')
		
							IF RECCOUNT('tmpTBL') > 0
								cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							ENDIF
							USE IN 'tmpTBL'
						ENDIF
					ENDIF
				ENDIF	
			ENDIF
		
		ENDIF
		
		***********************************
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" ) AND nID_Detail > 0	
			&&*Process is updated with ReceivingId, not Set _Detail with ReceivingId
			DO CASE
			CASE cTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Detail "
			CASE cTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Detail "
			CASE cTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
			
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		********
		
		IF nID < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_ReceivingID("+STR(nReceivingID)+") AS TableID"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						nTableID_Master = PrepareSQLnum(tmpTable.TableID,'TableID',-3)
						ThisForm.txtID_Master.Value = nTableID_Master 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Master = nID
		ENDIF
		
		
		***********************************
		
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			IF nTableID_Master = 0
				IF nRMA = 0
					IF nWO_Detail > 0
						*Consider a WO_Detail for Stock.
						cTBL = 'S'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************************
		*recheck for ID,ID_Detail, ID_Detail_Process by POitem
		PRIVATE lFoundProcess
		lFoundProcess = .F.
		
		IF Proper_PO_Item(pPOitem) != Proper_PO_Item('')
			IF nID = 0 AND nID_Detail = 0 AND nID_Detail_Process = 0
			
				*Check for a Process with that SOitem\WO_Detail and Heat
				nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"S",cHeat,ThisForm.nConnhandle)
				IF nID_Detail_Process = 0
					*Try Broker
					nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"B",cHeat,ThisForm.nConnhandle)
					IF nID_Detail_Process > 0
						cTBL = "B"
					ELSE
					
						*Try WIP WO_Detail
						nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(nWO_Detail,"W",cHeat,ThisForm.nConnhandle)
						IF nID_Detail_Process > 0
							cTBL = "W"
						ELSE
						
							*Try S WO_Detail
							nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(nWO_Detail,"S",cHeat,ThisForm.nConnhandle)
							IF nID_Detail_Process > 0
								cTBL = "S"
							ELSE
								*Try B WO_Detail
								nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(nWO_Detail,"B",cHeat,ThisForm.nConnhandle)
								IF nID_Detail_Process > 0
									cTBL = "B"
								ELSE
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ELSE
					cTBL = "S"
				ENDIF
				
				IF nID_Detail_Process > 0
					*FOUND IT, Get ID_Detail, ID
					DO CASE
					CASE cTBL = "S"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF
					CASE cTBL = "B"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF			
					CASE cTBL = "W"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF				
					ENDCASE
					
					IF lFoundProcess
						ThisForm.txtID_Master.Value = nID
						nTableID_Master = nID
						ThisForm.txtID_Detail.Value = nID_Detail
						nTableID_Detail = nID_Detail
						ThisForm.txtID_Detail_Process.Value = nID_Detail_Process
						ThisForm.txtTBL.Value = cTBL
					
						ThisForm.Stocklst_ID		= nTableID_Master 
						ThisForm.Stocklst_ID_Detail	= nTableID_Detail 
						ThisForm.StockLst_TBL		= UPPER(cTBL)
					ENDIF
				ELSE
					*ADD to Stock?		
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Recheck for TBL
		IF cTBL!= "S" AND cTBL!= "B" AND cTBL!= "W" 
			IF nID > 0 AND nID_Detail > 0
				*Find TBL
				
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				SELECT 0
				cSQL =        " SELECT 'S' AS TBL"	
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'B' AS TBL"	
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'W' AS TBL"	
				cSQL = cSQL + " FROM dbo.WIPLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
		
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
		
						IF RECCOUNT('tmpTBL') > 0
							cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
		*					TrackError("Found ID and ID_Detail in table '"+cTBL+"'.","Change in TBL!",PROGRAM(),LINENO(1))
						ELSE
							PRIVAT cMess
							cMess = "Stocklst ID = "+STR(nID)+CHR(13)
							cMess = cMess +"Stocklst ID_Detail = "+STR(nID_Detail)+CHR(13)
							cMess = cMess +"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +"TBL Could not be Identified"
							TrackError(cMess,"No TBL!",PROGRAM(),LINENO(1))
							
						ENDIF
						USE IN 'tmpTBL'
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		***********************************
		*Get nID_Detail_Process 
		
		IF nID > 0 AND nID_Detail > 0 AND nID_Detail_Process = 0
			IF cTBL!= "S" AND cTBL!= "B" AND cTBL!= "W" 
				IF USED("tmpID_D_P")
					USE IN tmpID_D_P
				ENDIF
				SELECT 0
				cSQL = " SELECT * FROM "	
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Process "
				CASE cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Process "
				CASE cTBL = "S"
					cSQL = cSQL + " dbo.WIPLst_Process "
				ENDCASE
				cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
				IF nReceivingID > 0
					cSQL = cSQL + " AND ReceivingID = "+STR(nReceivingID)
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_D_P')
				ELSE
					IF USED('tmpID_D_P')
		
						IF RECCOUNT('tmpID_D_P') > 0
							SCAN
								nID_Detail_Process = PrepareSQLnum(tmpID_D_P.ID_Detail_Process,'ID_Detail_Process',-3)
							ENDSCAN
						ENDIF
						
						USE IN tmpID_D_P
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Create Receive Process if have Table, ID_Detail AND no ID_Detail_Proc, BUT not found in History!
		IF nID_Detail_Process = 0
			IF NOT EMPTY(cTBL)
				IF nTableID_Detail > 0
					*Add a Receiving record to History, Only one that shows the ReceivingID
					THISFORM.Create_Receive_Process(cTBL,nTableID_Detail,pSOitem,pPOitem,nReceivingID, nActualW, nID_Detail_Process)
				ENDIF
			ENDIF		
		ENDIF
		
		
		***********************************
		IF nID_Detail_Process > 0 AND nReceivingID > 0
			IF NOT EMPTY(cTBL)
				*Update Process with ReceivingID
				DO CASE
				CASE cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Process SET"
				CASE cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Process SET"
				CASE cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Process SET"
				ENDCASE
				cSQLu = cSQLu +" ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail_Process = "+STR(nID_Detail_Process )
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update"+CHR(13)+"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		
		***********************************
		IF nID_Detail > 0
			IF NOT EMPTY(cTBL)
				*Update Detail with Receiving ID
				DO CASE
				CASE cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Detail "
				CASE cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Detail "
				CASE cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Detail "
				ENDCASE
				cSQLu = cSQLu +" SET ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail = "+STR(nID_Detail )
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"Could not update" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		***********************************
		
		IF nTableID_Master > 0
			IF NOT EMPTY(cTBL)
				*Check for Heat match
				
				IF USED("tmpMasterHeat")
					USE IN tmpMasterHeat
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS CTND "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +" FROM dbo.StockLst_Master "
				CASE cTBL = "B"
					cSQL = cSQL +" FROM dbo.BrokerLst_Master "
				CASE cTBL = "W"
					cSQL = cSQL +" FROM dbo.WIPLst_Master "
				ENDCASE
				cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
				cSQL = cSQL +" AND Heat = '"+cHeat+"'"
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterHeat')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMasterHeat')
				ELSE
					IF USED('tmpMasterHeat')
						IF VARTYPE(tmpMasterHeat.CTND)='N'
							*********
							IF tmpMasterHeat.CTND = 0			
								*Did not Find Correct Heat!
								*look for 'Due in'
								
								IF USED("tmpMasterDueIn")
									USE IN tmpMasterDueIn
								ENDIF
								
								cSQL = "SELECT COUNT(*) AS CTND "
								DO CASE
								CASE cTBL = "S"
									cSQL = cSQL +" FROM dbo.StockLst_Master "
								CASE cTBL = "B"
									cSQL = cSQL +" FROM dbo.BrokerLst_Master "
								CASE cTBL = "W"
									cSQL = cSQL +" FROM dbo.WIPLst_Master "
								ENDCASE
								cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
								cSQL = cSQL +" AND Heat = 'Due In'" 
		
								SELECT 0
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterDueIn')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterDueIn')
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMasterDueIn')
								ELSE
									IF USED('tmpMasterDueIn')
										IF VARTYPE(tmpMasterDueIn.CTND)='N'
											IF tmpMasterDueIn.CTND = 0
												*Did not Find Correct Heat or 'Due In'!
												nTableID_Master = 0
											ENDIF
										ENDIF
										USE IN tmpMasterDueIn
									ENDIF				
								ENDIF
							*********					
							ENDIF
						ENDIF
						USE IN tmpMasterHeat
					ENDIF				
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		
		PRIVATE lSaved
		lSaved = .F.
		
		IF nTableID_Master = 0
			IF nID > 0
				nTableID_Master = nID
			ENDIF
			IF nID_Master > 0
				nTableID_Master = nID_Master
			ENDIF	
		ENDIF
		
		IF nTableID_Master > 0
			
			cSQLu = "UPDATE dbo.Receiving SET"
			cSQLu = cSQLu +" ID_Master = "+STR(nTableID_Master)+""
			cSQLu = cSQLu +",ID_Detail = "+STR(nID_Detail)+""
			cSQLu = cSQLu +",StockTable = '"+cTBL+"'"
			cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not update dbo.Receiving" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
			ELSE 
				lSaved = .T.
			ENDIF
		ELSE
			lSaved = .F.
		
		*	PRIVATE cText
		*	cText = "Not in StockLst or BrokerLst!"+CHR(13)+"Did not save StockLst ID to Receiving table! No ID_Master for StockTable = '"+cTBL+"' AND Receiving ID = "+STR(nReceivingID)
		*	MESSAGEBOX( cText ,0+48,"ReceivingID "+ALLTRIM(STR(nReceivingID)) )
		*	TrackMess(cText)
		ENDIF
		
		***********************************
		
		IF nTableID_Master > 0
			IF NOT ( ThisForm.Stocklst_ID = nTableID_Master AND ThisForm.Stocklst_ID_Detail = nTableID_Detail AND ThisForm.StockLst_TBL = UPPER(cTBL) )
				IF EMPTY(cTBL) OR ThisForm.Stocklst_ID>0
					PRIVAT cMess
					cMess = "Stocklst_ID = "+STR(ThisForm.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
					cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisForm.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
					cMess = cMess +"StockLst_TBL = '"+ThisForm.StockLst_TBL+"' 		TBL1 = '"+UPPER(cTBL)+"'"+CHR(13)
					cMess = cMess +"ReceivingID="+STR(nReceivingID)
					TrackError(cMess,"Change in ID, ID_Detail, or TBL!",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
			
			IF ThisForm.Stocklst_ID = 0
				ThisForm.Stocklst_ID		= nTableID_Master 
				ThisForm.Stocklst_ID_Detail	= nTableID_Detail 
				*ThisForm.ID_Detail_process
			ENDIF
		ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			IF ThisForm.Stocklst_ID > 0 AND ThisForm.Stocklst_ID_Detail > 0
			
				*What Table has ID and ID_Detail combo
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				
				cSQL = "SELECT 'S' AS TBL FROM dbo.Stocklst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID) 
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'B' AS TBL FROM dbo.BrokerLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'W' AS TBL FROM dbo.WIPLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
						IF RECCOUNT('tmpTBL')>0
							cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							PRIVAT cMess
							cMess = "Stocklst_ID = "+STR(ThisForm.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
							cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisForm.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
							cMess = cMess +"StockLst_TBL = '"+ThisForm.StockLst_TBL+"' 		TBL1 = ''"
							cMess = cMess +CHR(13)+"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +CHR(13)+"TBL1 now= '"+UPPER(cTBL)+"'"
		*					TrackError(cMess+CHR(13)+CHR(13)+cSQL,"Change TBL!",PROGRAM(),LINENO(1))
						ENDIF
						USE IN tmpTBL
					ENDIF
				ENDIF	
			ENDIF
		ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			*Found a TBL, Show it on screen
			ThisForm.StockLst_TBL = UPPER(cTBL)
			ThisForm.txtTBL.Value = UPPER(cTBL)
			ThisForm.txtTBL.Refresh
		ENDIF
		
		IF USED('Receiving')
			SELECT Receiving
		ENDIF
		
		RETURN lSaved
	ENDPROC

	PROCEDURE refresh_rma_detail
		*ThisForm.Refresh_RMA_Detail()
		
		PRIVATE nRMA_Detail, nRMA, cHeat
		nRMA_Detail= PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		nRMA 	= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		
		PRIVATE cMess
		PRIVATE cSQL, nSQLExec
		
		IF nRMA_Detail > 0
			IF USED("tmpRcvRMA")
				USE IN tmpRcvRMA
			ENDIF
		
			cSQL = "SELECT ID "
			cSQL = cSQL + " FROM dbo.Receiving "
			cSQL = cSQL + " WHERE RMA_Detail = "+STR(nRMA_Detail)
					
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRcvRMA')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRcvRMA' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRcvRMA' )
			ENDIF
						
			IF USED('tmpRcvRMA')
				IF RECCOUNT('tmpRcvRMA') > 0	
					nReceivingID = PrepareSQLnum(tmpRcvRMA.ID,'ReceiveID',-3)
					PRIVATE nMess
					nMess =  MESSAGEBOX("Found a Receive with this RMA Detail: "+ALLTRIM(STR(nRMA_Detail))+CHR(13)+"Receiving ID: "+ALLTRIM(STR(nReceivingID))+CHR(13)+"Do you want to Edit this Receive? (Y)"+CHR(13)+"Here is a chance to edit the Receive."+CHR(13)+CHR(13)+"Answer No to be able to ADD another receive to this RMA.",4+32,"Edit Data") 
					IF nMess = 6
						ThisForm.txtReceivingID.Value = nReceivingID 
						ThisForm.GetBy_ReceivingID()
						RETURN
					ENDIF
					IF nMess <> 7
						RETURN
					ENDIF
				ENDIF
				USE IN tmpRcvRMA
			ENDIF
		ENDIF
		
		************************************************************************
		IF nRMA_Detail > 0
			IF USED("tmpRMA")
				USE IN tmpRMA
			ENDIF
		
			cSQL = "SELECT Money,Reason,Aprv_By,SO_item "
			cSQL = cSQL + ",RMA.RMA_No, RMA_Detail.RMA_Detail_ID"
			cSQL = cSQL + ",StockLst_ID,StockLst_ID_Detail,TBL,ID "  &&Quoted_PU
			cSQL = cSQL + ",StockLst_QTY,StockLst_P,StockLst_Total "
			cSQL = cSQL + ",StockLst_PU,StockLst_PC,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3, StockLst_LBS"
		*	cSQL = cSQL + ",SD.PackingSli, SD.Reconciled,SD.Returned, SD.Alloy "
		*	*cSQL = cSQL + ",dbo.f_Descript(SD.Alloy,SD.CC,SD.CL,SD.Form,SD.StockLst_Dim1,SD.StockLst_Dim2,SD.StockLst_Dim3,SD.StockLst_QTY,0) AS Descript"	
		*	cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SD.StockLst_PC, SD.Form,SD.StockLst_Dim1,SD.StockLst_Dim2,SD.StockLst_Dim3,SD.StockLst_QTY, 0, 0, '', '', '') AS Descript"
			cSQL = cSQL + ",SS.PackingSli, SS.Reconciled,SS.Returned, SS.Alloy "
			cSQL = cSQL + ",dbo.f_DescriptCL(SS.Alloy,SS.CC,SS.CL,SS.Form,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3,SS.StockLst_QTY,0) AS Descript"	
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.StockLst_PC, SS.Form,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3,SS.StockLst_QTY, 0, 0, '', '', '') AS Descript"
			cSQL = cSQL + " FROM dbo.RMA RMA"
			cSQL = cSQL + " INNER JOIN dbo.RMA_Detail ON RMA.RMA_No = RMA_Detail.RMA_NO "
			*cSQL = cSQL + " INNER JOIN dbo.Sales_Detail SD ON RMA_Detail.So_item = SD.SOitem "
			cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SS WITH (NOLOCK) ON RMA_Detail.So_item = SS.SOitem "
			cSQL = cSQL + " WHERE RMA_Detail.RMA_Detail_ID = "+STR(nRMA_Detail)
			IF NOT EMPTY(cHeat)	
				cSQL = cSQL + " AND SS.Heat = '"+cHeat+"'"
			ENDIF
					
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMA')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA' )
			ENDIF
		
			IF NOT USED('tmpRMA') OR RECCOUNT('tmpRMA') = 0	
				*try without HEAT
				cSQL = "SELECT Money,Reason,Aprv_By,SO_item "
				cSQL = cSQL + ",RMA.RMA_No, RMA_Detail.RMA_Detail_ID"
				cSQL = cSQL + ",StockLst_ID,StockLst_ID_Detail,TBL,ID "  &&Quoted_PU
				cSQL = cSQL + ",StockLst_QTY,StockLst_P,StockLst_Total "
				cSQL = cSQL + ",StockLst_PU,StockLst_PC,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3, StockLst_LBS"
				cSQL = cSQL + ",SS.PackingSli, SS.Reconciled, SS.Returned, SS.Alloy "
				*cSQL = cSQL + ",dbo.f_Descript(SD.Alloy,SD.CC,SD.CL,SD.Form,SD.StockLst_Dim1,SD.StockLst_Dim2,SD.StockLst_Dim3,SD.StockLst_QTY,0) AS Descript"
				cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.StockLst_PC,SS.Form,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3,SS.StockLst_QTY, 0, 0, '', '', '') AS Descript"
				cSQL = cSQL + " FROM dbo.RMA "
				cSQL = cSQL + " INNER JOIN dbo.RMA_Detail ON RMA.RMA_No = RMA_Detail.RMA_NO "
				*cSQL = cSQL + " INNER JOIN dbo.Sales_Detail SD ON RMA_Detail.So_item = SD.SOitem "
				cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SS WITH (NOLOCK) ON RMA_Detail.So_item = SS.SOitem "
				cSQL = cSQL + " WHERE RMA_Detail.RMA_Detail_ID = "+STR(nRMA_Detail)
						
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMA')
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA' )
				ENDIF
				
			ENDIF	
				
				
			IF USED('tmpRMA')
				IF RECCOUNT('tmpRMA') > 0	
					PRIVATE cSOitem, nRecCount, nRecNo, nMess, cMess
					nRecCount = RECCOUNT()
					nRecNo	= RECNO()
					cSOitem = Proper_SO_item(ThisForm.cSOitem)
					
					*SCAN
					
						IF Proper_SO_item(tmpRMA.SO_item) <> Proper_SO_item('')
							IF Proper_SO_item(tmpRMA.SO_item) <> cSOitem
								MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem ="+Proper_SO_item(tmpRMA.SO_item),16,"Does not Match")
								*EXIT
								IF USED('tmpRMA')
									USE IN tmpRMA
								ENDIF
								RETURN
							ENDIF
						ENDIF
						
						IF nRecNo < nRecCount
							cMess = "Record: "+ALLTRIM(STR(nRecNo))+" of "+ALLTRIM(STR(nRecCount))+" records."+CHR(13)
						ENDIF
						cMess = cMess + "Description: "+tmpRMA.Descript+CHR(13)+CHR(13)
						cMess = cMess + ALLTRIM(PrepareSQLtxt(tmpRMA.Money,'Money',-3))+CHR(13)+CHR(13)
						cMess = cMess + ALLTRIM(PrepareSQLtxt(tmpRMA.Reason,'Reason',-3))+CHR(13)+CHR(13)
						cMess = cMess + "Is this the RMA Item you want to return?"
						*cMess = cMess + "Approved By:"+ALLTRIM(PrepareSQLtxt(tmpRMA.Aprv_By,'Appv_By',-3))
						
						nMess = MESSAGEBOX(cMess,4+32,"RMA Description") 
						
						IF nMess = 6
							ThisForm.edtComments.Value = PrepareSQLtxt(tmpRMA.Reason,'Reason',-3)
							ThisForm.txtReceived.Value = DATE()
							Thisform.txtDate.Value = DATE()
							ThisForm.txtRMA_No.Value= PrepareSQLnum(tmpRMA.RMA_No,'RMA_No',-3)
							ThisForm.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail_ID',-3)
						
							ThisForm.txtAlloy.Value = PrepareSQLtxt(tmpRMA.Alloy,'Alloy',12)
							ThisForm.edtDescription.Value = PrepareSQLtxt(tmpRMA.Descript,'Descript',-1)
							
							PRIVATE nStockLst_QTY
							nStockLst_QTY = PrepareSQLnum(tmpRMA.StockLst_QTY,'StockLst_QTY',9,1)
							IF nStockLst_QTY > 0
								ThisForm.txtActualW.Value = nStockLst_QTY
								ThisForm.txtBillW.Value = nStockLst_QTY
							ENDIF
		
							ThisForm.txtID_Master.Value = PrepareSQLnum(tmpRMA.StockLst_ID,'Master_ID',-3)
							ThisForm.txtID_Detail.Value = PrepareSQLnum(tmpRMA.StockLst_ID_Detail,'ID_Detail',-3)
							
							ThisForm.txtTBL.Value	= PrepareSQLtxt(tmpRMA.TBL,'TBL',1)
							ThisForm.lblPriceUnit.Caption = ALLTRIM(STR(PrepareSQLnum(tmpRMA.StockLst_PU,'PU',1),1))
						ENDIF
					*ENDSCAN			
				ENDIF
				USE IN tmpRMA
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE resetaddvars
		*ThisForm.ResetAddVars
		
		ThisForm.txtReceivingID.Value = 0
		ThisForm.txtWO.Value			= 0
		ThisForm.txtWO_Detail.Value	= 0
		ThisForm.txtReceived.Value	= DtoC(DATE())
		
		ThisForm.cPOitem 			= ''
		ThisForm.txtHpaPONum.Value	= 0
		ThisForm.txtHpaPOitem.Value	= 0
		
		ThisForm.cSOitem			= ''
		ThisForm.txtSONum.Value		= 0
		ThisForm.txtSOitem.Value	= 0
		
		ThisForm.txtAlloy.Value	= ''
		ThisForm.txtHeat.Value	= ''
		ThisForm.chkCert.Value	= 0
		ThisForm.txtPieces.Value	= 0
		ThisForm.edtDescription.Value	= ''
		ThisForm.edtSpecs.Value	= ''
		ThisForm.edtComments.Value= ''
		ThisForm.txtInit.Value	= ''
		ThisForm.txtDate.Value	= DtoC(DATE())
		ThisForm.chkPass.Value	= 0
		ThisForm.chkGoodPapers.Value	= 1
		ThisForm.txtActualW.Value	= 0
		ThisForm.txtBillW.Value	= 0
		ThisForm.txtVendor.Value	= ''
		ThisForm.txtRejectPC.Value	= 0
		ThisForm.txtRejectReason.Value = ''
		ThisForm.txtRMA_No.Value = ''
		
		ThisForm.txtID_Master.Value	= 0
		ThisForm.txtID_Detail.Value	= 0
		ThisForm.txtTBL.Value		= ''
		*ThisForm.StockLst_TBL		= ''
		*!*	ThisForm.txtID_Detail_Process.Value = 0
		ThisForm.cHeat = ''
		
	ENDPROC

	PROCEDURE rma_receive
		*PARAMETERS pcSOitem
		*ThisForm.RMA_Receive()
		
		PRIVATE nRMA
		nRMA = ThisForm.nRMA
		
		PRIVATE cPOitem, cSOitem
		cPOitem = PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)
		cSOitem = ThisForm.cSOitem
		
		
		IF EMPTY(cSOitem)
			MESSAGEBOX("Cannot process RMA return without the SOitem!"+CHR(13)+"RMA:"+ALLTRIM(STR(nRMA))+".",0+32,"No SO-item")
			RETURN .F.
		ENDIF
		
		PRIVATE nDec, nItemSo, nSalesNum 
		nSalesNum = Proper_SO_Item_SO(cSoItem)
		nItemSo = Proper_SO_Item_Item(cSOitem)
		
		ThisForm.txtSOnum.Value = nSalesNum 
		ThisForm.txtSOnum.Refresh
		ThisForm.txtSOitem.Value = nItemSo 
		ThisForm.txtSOitem.Refresh	
		
		
		*Get ID_Detail
		IF USED('tmpStockLst_Process_History')
			USE IN tmpStockLst_Process_History
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT ID_Detail FROM dbo.[Ar.StockLst_Process_History] "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ([WHAT] = 'SUBED     ' OR [WHAT] = 'DELETE    ')"
		cSQL = cSQL + " ORDER BY [WHAT] DESC "
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT ID_Detail FROM dbo.[Ar.BrokerLst_Process_History] "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ([WHAT] = 'SUBED     ' OR [WHAT] = 'DELETE    ')"
		cSQL = cSQL + " ORDER BY [WHAT] DESC "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Process_History')
			MESSAGEBOX("Cannot process RMA return.",0+32,"No ID_Detail")
			RETURN .F.
		ENDIF
		
		PRIVATE nID_Detail 
		nID_Detail = 0
		IF USED('tmpStockLst_Process_History')
			IF VARTYPE(tmpStockLst_Process_History.ID_Detail) = "N"
				nID_Detail = tmpStockLst_Process_History.ID_Detail
			ENDIF
			USE IN tmpStockLst_Process_History
		ENDIF
		
		PRIVATE cTBL
		IF nID_Detail > 0
			cTBL = "S"
		ELSE
			*Check BrokerLst
			cSQL = "SELECT ID_Detail FROM dbo.[Ar.BrokerLst_Process_History] "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND [WHAT] = 'DELETE    '"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Process_History')
				MESSAGEBOX("Cannot process RMA return.",0+32,"No ID_Detail")
				RETURN .F.
			ENDIF
			IF USED('tmpStockLst_Process_History')
				IF VARTYPE(tmpStockLst_Process_History.ID_Detail) = "N"
					nID_Detail = tmpStockLst_Process_History.ID_Detail
					cTBL = "B"
				ENDIF
				USE IN tmpStockLst_Process_History
			ELSE
				MESSAGEBOX("Could not retrieve ID_Detail.",0+32,"No StockLst info")
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE nStockLst_ID
		nStockLst_ID = Get_ID_with_ID_Detail(nID_Detail,cTBL,ThisForm.nConnHandle)
		
		
		**************** StockLst_Master 
		IF nStockLst_ID = 0
			MESSAGEBOX("Could not retrieve ID.",0+32,"No StockLst info")
			*RETURN .F.
		ENDIF
		
		IF cTBL = "S"
			cSQL = "SELECT Alloy,Heat,Specs,Mill FROM dbo.StockLst_Master WHERE ID = "+STR(nStockLst_ID)
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT Alloy,Heat,Specs,Mill FROM dbo.[Ar.Stocklst_Master_History] WHERE ID = "+STR(nStockLst_ID)
		ELSE
			cSQL = "SELECT Alloy,Heat,Specs,Mill FROM dbo.BrokerLst_Master WHERE ID = "+STR(nStockLst_ID)
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT Alloy,Heat,Specs,Mill FROM dbo.[Ar.BrokerLst_Master_history] WHERE ID = "+STR(nStockLst_ID)
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstID')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstID')
			MESSAGEBOX("Could not retrieve ID Info.",0+32,"No StockLst info")
		ENDIF
		
		
		IF USED('tmpStockLstID')
			IF VARTYPE(tmpStockLstID.Alloy)="C" &&Alloy
				IF !EMPTY(tmpStockLstID.Alloy)
					ThisForm.txtAlloy.Value = tmpStockLstID.Alloy
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Heat)="C" &&Heat
				IF !EMPTY(tmpStockLstID.Heat)
					ThisForm.txtHeat.Value = tmpStockLstID.Heat
				ENDIF
			ENDIF
			
			IF VARTYPE(tmpStockLstID.Specs)="C"  &&Specs
				IF !EMPTY(tmpStockLstID.Specs)
					ThisForm.edtSpecs.Value = tmpStockLstID.Specs
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Mill)="C"  &&Mill 
				IF !EMPTY(tmpStockLstID.Mill)
					ThisForm.txtVendor.Value = tmpStockLstID.Mill 
				ENDIF
			ENDIF
		
			USE IN tmpStockLstID
		ENDIF
		
		*************** StockLst_Detail 
		
		IF USED('tmpStockLstDetail')
			USE IN tmpStockLstDetail
		ENDIF
		
		IF cTBL = "S"
			cSQL = "SELECT PC, dbo.f_ItemDescription(dbo.StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.StockLst_Detail WHERE ID_Detail ="+STR(nID_Detail)
			cSQL = cSQL + " Union "
			cSQL = cSQL + "SELECT PC, dbo.f_ItemDescription(dbo.StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.[Ar.Stocklst_Detail_History] WHERE ID_Detail ="+STR(nID_Detail)
		ELSE
			cSQL = "SELECT PC, dbo.f_ItemDescription(dbo.BrokerLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.BrokerLst_Detail WHERE ID_Detail ="+STR(nID_Detail)
			cSQL = cSQL + " Union "
			cSQL = cSQL + "SELECT PC, dbo.f_ItemDescription(dbo.BrokerLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.[Ar.BrokerLst_Detail_History] WHERE ID_Detail ="+STR(nID_Detail)
		ENDIF
		*SELECT PC, dbo.f_ItemDescription(dbo.StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.StockLst_Detail WHERE ID_Detail = 5657
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstDetail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstDetail')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstDetail')
			MESSAGEBOX("Could not retrieve ID Detail Info.",0+32,"No StockLst info")
		ENDIF
		
		IF USED('tmpStockLstDetail')
			GO TOP
			IF VARTYPE(tmpStockLstDetail.PC)="N"  &&Pieces
				IF tmpStockLstDetail.PC > 0
					ThisForm.txtPieces.Value = tmpStockLstDetail.PC
				ENDIF
			ENDIF
			IF VARTYPE(tmpStockLstDetail.Description)="C"  &&Description
				IF !EMPTY(tmpStockLstDetail.Description)
					ThisForm.edtDescription.Value = tmpStockLstDetail.Description
				ENDIF
			ENDIF
			
			USE IN tmpStockLstDetail
			
			ThisForm.Edit1.Value = ThisForm.Edit1.Value+CHR(13)+"Retrieved: receive again after RMA."
			ThisForm.Refresh	
			ThisForm.txtReceivingID.Value = 0
		ENDIF
		
		********** Sales
		
		ThisForm.txtActualW.Value		= 0
		ThisForm.txtBillW.Value 		= 0
		
		cSQL = "SELECT matlwt FROM dbo.Sales WHERE SOitem = '"+cSOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesWt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesWt')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesWt')
			MESSAGEBOX("Could not retrieve Sales Weight.",0+32,"No info")
		ENDIF
		
		IF USED('tmpSalesWt')
			GO TOP
			IF VARTYPE(tmpSalesWt.matlwt)="N"  &&Pieces
				IF tmpSalesWt.matlwt > 0
					ThisForm.txtActualW.Value = tmpSalesWt.matlwt 
					ThisForm.txtBillW.Value = tmpSalesWt.matlwt 
				ENDIF
			ENDIF
			
			USE IN tmpSalesWt
		ENDIF
		
		*************** AllQuotes
		IF USED('tmpAllQuotes')
			USE IN tmpAllQuotes
		ENDIF
		
		cSQL = "SELECT Alloy,Pieces,dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Weight,RandLen) AS Description,Weight FROM dbo.AllQuotes WHERE SOitem ='"+cSOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllQuotes')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpAllQuotes')
			MESSAGEBOX("Could not retrieve AllQuotes Info.",0+32,"No StockLst info")
		ENDIF
		
		IF USED('tmpAllQuotes')
			GO TOP
			IF VARTYPE(tmpAllQuotes.Alloy)="C" &&Alloy
				IF !EMPTY(tmpAllQuotes.Alloy)
					ThisForm.txtAlloy.Value = tmpAllQuotes.Alloy
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Pieces)="N"  &&Pieces
				IF tmpAllQuotes.Pieces > 0
					ThisForm.txtPieces.Value = tmpAllQuotes.Pieces
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Description)="C"  &&Description
				IF !EMPTY(tmpAllQuotes.Description)
					ThisForm.edtDescription.Value = tmpAllQuotes.Description
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Weight)="N"  &&Weight 
				IF tmpAllQuotes.Weight > 0
					ThisForm.txtActualW.Value = tmpAllQuotes.Weight 
					ThisForm.txtBillW.Value = tmpAllQuotes.Weight 
				ENDIF
			ENDIF
			USE IN tmpAllQuotes
		ENDIF
			
		SELECT Receiving
		
		ThisForm.chkCert.Value		= 1
		ThisForm.edtComments.Value	= ''
		ThisForm.txtInit.Value 		= ''
		ThisForm.txtDate.Value 		= DTOC(DATE())
		ThisForm.chkPass.Value		= 1
		ThisForm.chkGoodPapers.Value		= 1
		
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETER pSaveType
		*ThisForm.SaveAdd(pSaveType)	ADD	ADDCLONE	EDIT
		
		IF TYPE("pSaveType") != "C"
			MESSAGEBOX("No pSaveType for SaveAdd(pSaveType)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No pSaveType for SaveAdd(pSaveType)" )
			RETURN
		ENDIF
		
		PRIVATE lSQLgood, lNeedSave, lSaved, lAllready_Saved, lRMA
		lSQLgood = .T.
		lNeedSave = .T.
		lSaved = .F.
		lAllready_Saved = .F.
		lRMA = .F.
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		nHpaPo		= PrePareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrePareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSONum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		*!*	IF EMPTY(cTBL)
		*!*		cTBL = PrepareSQLtxt(ThisForm.StockLst_TBL,'TBL',1)
		*!*	ENDIF
		
		PRIVATE nWO_Detail, nWO
		nWO_Detail	= PrePareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nWO		= PrePareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		PRIVATE nRMA, nRMA_Detail
		nRMA = PrepareSQLnum(ThisForm.nRMA,'RMA',-3)
		nRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		IF nRMA > 0
			IF RMA_Exists(nRMA,ThisForm.nConnhandle)
				lRMA = .T.
				ThisForm.StockLst_TBL = "S"
				RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"RMA > 0 and RMA Exists, so StockLst_TBL is set to 'S' ." )
			ENDIF
		ENDIF
		
		PRIVATE nID_Master, nID_Detail,cTBL
		nID_Master = PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3)
		nID_Detail = PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
		cTBL 		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		
		*!*	IF pSaveType = "MAKECLONE"
		*!*	* Change item number
		*!*		ThisForm.Edit1.VALUE = "Clone !"+CHR(13)+"Last PO Number :"+CHR(13)+cPoItem+CHR(13)+"Last Company :"+CHR(13)+cVendor
		*!*		ThisForm.Edit1.REFRESH
		*!*		WAIT WINDOW "New PO-Item Ready to edit and save!" NOWAIT
		*!*		RETURN
		*!*	ENDIF
		
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		
		PRIVATE dReceived, cAlloy, cHeat, lCert, nPieces, cDescription
		PRIVATE cSpecs, cComments, cInit, dDate, lPass, lGoodPapers, nActualW, nBillW, cVendor, nRMA_No, nRMA_Detail
		PRIVATE nRejectPC, cRejectReason
		dReceived	= PrepareSQLdate(ThisForm.txtReceived.Value,'Received')
		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',30,.f.)
		lCert		= PrepareSQLchk(ThisForm.chkCert.Value,'Cert')
		nPieces		= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
		cDescription= PrepareSQLtxt(ThisForm.edtDescription.Value,'Description',-1,.F.)
		cSpecs		= PrepareSQLtxt(ThisForm.edtSpecs.Value,'Specs',-1)
		cComments	= PrepareSQLtxt(ThisForm.edtComments.Value,'Comments',-1,.F.)
		cInit		= PrepareSQLtxt(ThisForm.txtInit.Value,'Init',10 )
		dDate		= PrepareSQLdate(ThisForm.txtDate.Value,'Date')
		lPass		= PrepareSQLchk(ThisForm.chkPass.Value,'Pass')
		lGoodPapers	= PrepareSQLchk(ThisForm.chkGoodPapers.Value,'GoodPapers')
		nActualW	= PrepareSQLnum(ThisForm.txtActualW.Value,'Actual',9,1)
		nBillW		= PrepareSQLnum(ThisForm.txtBillW.Value,'BillW',9,1)
		cVendor		= PrepareSQLtxt(ThisForm.txtVendor.Value,'Vendor',30,.F.,.T. )
		nRMA_No		= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		nRMA_Detail	= PrepareSQLnum(ThisForm.txtRMA_detail.Value,'RMA_Detail',-3)
		nRejectPC	= PrepareSQLnum(ThisForm.txtRejectPC.Value,'RejectPC',-3)
		cRejectReason= PrepareSQLtxt(ThisForm.txtRejectReason.Value,'RejectReason',255,.f. )
		
		
		IF nRejectPC < 1
			nRejectPC = 0
		ENDIF
		
		
		*!*	IF nReceivingID = 0
		*!*		IF nRMA_No = 0
		*!*			*Could be a new Add and nReceivingID has not been set
		*!*			PRIVATE cMess
		*!*			cMess = "SOitem "+ALLTRIM(ShowSQLtxt(cSOitem,'SOitem',12))+CHR(13)
		*!*			cMess = cMess + "POitem "+ALLTRIM(ShowSQLtxt(cPOitem,'POitem',12))+CHR(13)
		*!*			cMess = cMess + "WO_Detail "+ALLTRIM(STR(nWO_Detail))+CHR(13)
		*!*			cMess = cMess + "RMA "+ALLTRIM(ShowSQLtxt(nRMA_No,'RMA',10))+CHR(13)
		*!*			cMess = cMess + "Alloy "+ALLTRIM(ShowSQLtxt(cAlloy,'Alloy',12))+CHR(13)
		*!*			cMess = cMess + "Heat "+ALLTRIM(ShowSQLtxt(cHeat,'Heat',30))+CHR(13)
		*!*			cMess = cMess + "Desc "+ALLTRIM(ShowSQLtxt(cDescription,'Desc',20,.F.,.T.))+CHR(13)
		*!*			cMess = cMess + "Could be a new Add and nReceivingID has not been set."+CHR(13)
		*!*			
		*!*			cMess = cMess + "pSaveType = '"+pSaveType+"'"
		*!*			
		*!*			*TrackError(cMess,"nReceivingID is 0",PROGRAM(),LINENO(1))
		*!*			*TrackMess("nReceivingID is 0."+CHR(13)+ShowSQLtxt(cMess,'mess',-1) )
		*!*			RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"Could be a new Add and nReceivingID has not been set." )
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
		
		PRIVATE nReceivingIDOld 
		nReceivingIDOld = 0
		
		**********************
		IF USED('tmpCountPOitem')
			USE IN tmpCountPOitem
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, cSQLu
		PRIVATE lSaveByOldMethod
		lSaveByOldMethod = .T.
		cSQLu = ''
		IF nReceivingID > 0 
			**Check for Existing Record
			nReceivingIDOld = nReceivingID
			
			cSQL = "SELECT Count(*) AS Cntd FROM dbo.Receiving WITH (NOLOCK) WHERE ID ="+STR(nReceivingID)
			IF USED("tmpCountRid")
				USE IN tmpCountRid
			ENDIF
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountRid')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountRid')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountRid')
				*TrackMess("Error with Add Receiving ID:"+ALLTRIM(STR(nReceivingID)) )
				TrackError("Check for Existing Record. "+CHR(13)+cSQL ,"bad select",PROGRAM(),LINENO(1))
			ELSE
				IF tmpCountRid.Cntd > 0
					*Update Receiving by ReceivingID
					lAllready_Saved = .T.
					
					cSQLu = "UPDATE dbo.Receiving SET"
					cSQLu = cSQLu +" Received='"+IIF(EMPTY(dReceived),'',DTOC(dReceived)) +"'"
					cSQLu = cSQLu +",POitem=dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQLu = cSQLu +",SOitem=dbo.f_ProperSOitem('"+cSOitem+"')"
					cSQLu = cSQLu +",WO="+STR(nWO)
					cSQLu = cSQLu +",WO_Detail="+STR(nWO_Detail)
					cSQLu = cSQLu +",Alloy='"+cAlloy+"'"
					cSQLu = cSQLu +",Heat='"+cHeat+"'"
					cSQLu = cSQLu +",Cert="+IIF(lCert,'1','0')+""	&&BIT
					cSQLu = cSQLu +",Pieces="+STR(nPieces)
					cSQLu = cSQLu +",Description='"+cDescription+"'"
					cSQLu = cSQLu +",Specs='"+cSpecs+"'"
					cSQLu = cSQLu +",Comments='"+cComments+"'"
					cSQLu = cSQLu +",Init='"+cInit+"'"
					cSQLu = cSQLu +",[Date]='"+IIF(EMPTY(dDate),'',DTOC(dDate)) +"'"
					cSQLu = cSQLu +",Pass="+IIF(lPass,'1','0')
					cSQLu = cSQLu +",GoodPapers="+IIF(lGoodPapers,'1','0')
					cSQLu = cSQLu +",ActualW="+STR(nActualW)
					cSQLu = cSQLu +",BillW="+STR(nBillW)
					cSQLu = cSQLu +",Vendor='"+cVendor+"'"
		*--			cSQLu = cSQLu +",Cancelled=0"
					cSQLu = cSQLu +",ID_Master="+STR(nID_Master)
					cSQLu = cSQLu +",ID_Detail="+STR(nID_Detail)
					cSQLu = cSQLu +",StockTable='"+cTBL+"'"
					
					cSQLu = cSQLu +",RejectPC="+STR(nRejectPC)
					cSQLu = cSQLu +",RejectReason='"+cRejectReason+"'"
					cSQLu = cSQLu +",RMA_No="+STR(nRMA_No)
					cSQLu = cSQLu +",RMA_Detail="+STR(nRMA_Detail)
					cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
						lSaved = .F.
						TrackError("Update Receiving by ReceivingID. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
						*RETURN
					ELSE 
						lSaved = .T.
						lSaveByOldMethod = .F.
						TrackMess("Updated Receiving ID:"+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(cPOitem)+", SO:"+ALLTRIM(cSOitem) )
						IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
							Save_SOitem_Status( cSOitem, VAL(cSOitem), "RecvUpdate", "Update the Receiving ID:"+ALLTRIM(STR(nReceivingID)), ThisForm.nConnHandle)
						ENDIF
					ENDIF
					
				ELSE
					*ReceivingID was not found in dbo.Receiving !!
					
					nReceivingIDOld = nReceivingID 
					*Insert INTO dbo.Receiving
					cSQLi = "EXEC dbo.p_Receiving_ins3 "
					cSQLi = cSQLi +" @Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
					cSQLi = cSQLi +",@POitem = '"+cPOitem+"'"
					cSQLi = cSQLi +",@SOitem = '"+cSOitem+"'"
					cSQLi = cSQLi +",@WO_Detail = "+STR(nWO_Detail)
					cSQLi = cSQLi +",@Alloy ='"+cAlloy+"'"
					cSQLi = cSQLi +",@Heat ='"+cHeat+"'"
					cSQLi = cSQLi +",@Cert ="+IIF(lCert,'1','0')+""	&&BIT
					cSQLi = cSQLi +",@Pieces ="+STR(nPieces)
					cSQLi = cSQLi +",@Description ='"+cDescription+"'"
					cSQLi = cSQLi +",@Specs ='"+cSpecs+"'"
					cSQLi = cSQLi +",@Comments ='"+cComments+"'"
					cSQLi = cSQLi +",@Init ='"+cInit+"'"
					cSQLi = cSQLi +",@Date ='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
					cSQLi = cSQLi +",@Pass ="+IIF(lPass,'1','0')
					cSQLi = cSQLi +",@GoodPapers ="+IIF(lGoodPapers,'1','0')
					cSQLi = cSQLi +",@ActualW ="+STR(nActualW)
					cSQLi = cSQLi +",@BillW ="+STR(nBillW)
					cSQLi = cSQLi +",@Vendor ='"+cVendor+"'"
					cSQLi = cSQLi +",@RejectPC="+STR(nRejectPC)
					cSQLi = cSQLi +",@RejectReason ='"+cRejectReason+"'"
					cSQLi = cSQLi +",@RMA_No="+STR(nRMA_No)
					
					IF USED("tmpIDReceiving")
						USE IN tmpIDReceiving
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpIDReceiving')
						TrackError("Insert INTO dbo.Receiving. "+CHR(13)+cSQLi ,"bad update",PROGRAM(),LINENO(1))
					ELSE &&IF nSQLEXEC < 1
						lSaved = .T.
						
						IF USED("tmpIDReceiving")
							nReceivingID = PrepareSQLnum(tmpIDReceiving.EXP,'RID',-3)
							
							IF nReceivingID > 0
								*UPDATE the rest of table dbo.Receiving
								
								cSQLu = "UPDATE dbo.Receiving SET "
								cSQLu = cSQLu + " RMA_Detail="+STR(nRMA_Detail)
								cSQLu = cSQLu + " WHERE ID="+STR(nReceivingID)
								
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, '')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, '')
								ENDDO
								IF nSQLEXEC < 0
									SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
									TrackError("UPDATE the rest of table dbo.Receiving. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
								ENDIF
								
								
								cMess = "Added Receiving ID:"+ALLTRIM(STR(nReceivingID))
								cMess = cMess + ", WAS Receiving ID:"+ALLTRIM(STR(nReceivingIDOld))
								cMess = cMess + ", PO:"+ALLTRIM(cPOitem)
								cMess = cMess + ", SO:"+ALLTRIM(cSOitem)
								cMess = cMess + ", WO_Detail:"+ALLTRIM(STR(WO_Detail))
								cMess = ShowSQLtxt(cMess,'Mess',-1)
								*TrackMess(cMess)
								TrackError(cMess,"nReceivingID is not 0, but is a new Receive!",PROGRAM(),LINENO(1))
								RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"nReceivingID is not 0, but was not found in Receiving table!"+CHR(13)+cMess+" "+CHR(13)+cSQL  )
								
								lSaveByOldMethod = .F.
								
								IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
									Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+CHR(13)+", WAS Receiving ID:"+ALLTRIM(STR(nReceivingIDOld)), ThisForm.nConnHandle)
								ENDIF
								
								USE IN tmpIDReceiving 
								ThisForm.txtReceivingID.Value = nReceivingID 
								ThisForm.txtReceivingID.Refresh
							ENDIF						
						ENDIF
						TrackMess("Added Receiving ID:"+ALLTRIM(STR(nReceivingID)) )
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		*Is nReceivingID still 0
		PRIVATE nMess ,lSaveRMAtoStock 
		nMess = 6
		lSaveRMAtoStock = .T.
		
		IF nReceivingID = 0 
			*NO nReceivingID Found! -must be NewAdd Save
			nReceivingIDOld = 0
			*IF nRMA_No < 1
			IF lRMA
				nMess = MESSAGEBOX("Is this material worth stocking?",4+32,"Found RMA number!")
				IF nMess = 6
					lSaveRMAtoStock = .T.
				ELSE
					lSaveRMAtoStock = .F.
				ENDIF
			ENDIF
			
		*	IF nMess = 6
				*Insert as new and get ReceivingID
				*Insert INTO dbo.Receiving
				cSQLi = "EXEC dbo.p_Receiving_ins3 "
				cSQLi = cSQLi +" @Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
				cSQLi = cSQLi +",@POitem = '"+cPOitem+"'"
				cSQLi = cSQLi +",@SOitem = '"+cSOitem+"'"
				cSQLi = cSQLi +",@WO_Detail = "+STR(nWO_Detail)
				cSQLi = cSQLi +",@Alloy ='"+cAlloy+"'"
				cSQLi = cSQLi +",@Heat ='"+cHeat+"'"
				cSQLi = cSQLi +",@Cert ="+IIF(lCert,'1','0')+""	&&BIT
				cSQLi = cSQLi +",@Pieces ="+STR(nPieces)
				cSQLi = cSQLi +",@Description ='"+cDescription+"'"
				cSQLi = cSQLi +",@Specs ='"+cSpecs+"'"
				cSQLi = cSQLi +",@Comments ='"+cComments+"'"
				cSQLi = cSQLi +",@Init ='"+cInit+"'"
				cSQLi = cSQLi +",@Date ='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
				cSQLi = cSQLi +",@Pass ="+IIF(lPass,'1','0')
				cSQLi = cSQLi +",@GoodPapers ="+IIF(lGoodPapers,'1','0')
				cSQLi = cSQLi +",@ActualW ="+STR(nActualW)
				cSQLi = cSQLi +",@BillW ="+STR(nBillW)
				cSQLi = cSQLi +",@Vendor ='"+cVendor+"'"
				cSQLi = cSQLi +",@RejectPC="+STR(nRejectPC)
				cSQLi = cSQLi +",@RejectReason ='"+cRejectReason+"'"
				cSQLi = cSQLi +",@RMA_No="+STR(nRMA_No)
				
				IF USED("tmpIDReceiving")
					USE IN tmpIDReceiving
				ENDIF
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
				ENDDO
				
				IF nSQLEXEC < 0
					SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpIDReceiving')
					TrackError("Insert as new and get ReceivingID. "+CHR(13)+cSQLi ,"bad update",PROGRAM(),LINENO(1))
				ELSE &&IF nSQLEXEC < 1
					lSaved = .T.
					
					IF USED("tmpIDReceiving")
						nReceivingID = PrepareSQLnum(tmpIDReceiving.EXP,'ReceivingID',-3)
		*				TrackMess("Added Receiving ID:"+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(cPOitem)+", SO:"+ALLTRIM(cSOitem))
						
						lSaveByOldMethod = .F.
						USE IN tmpIDReceiving 
						
						ThisForm.txtReceivingID.Value = nReceivingID 
						ThisForm.txtReceivingID.Refresh
						
						IF VARTYPE(nReceivingID) != "N"		
							TrackError("nReceivingID is not a NUMBER"+CHR(13)+cSQLi,"SaveAdd(INSERT) failed.",PROGRAM(),LINENO(1))
						ELSE
							*MESSAGEBOX("Added Receive.",64,"Success")
							MESSAGEBOX("Added Receive to Database."+CHR(13)+"This data is now in the Receive table.",64,"Successful Insert")
							*TrackMess(LEFT("Added Receiving ID:"+STR(nReceivingID)+CHR(13)+" Did not find a Receiving ID."+CHR(13)+cSQLi ,254))	
							
							IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID)), ThisForm.nConnHandle)
							ENDIF
							
						ENDIF
						
						IF nReceivingID > 0
							*UPDATE the rest of table dbo.Receiving
							
							cSQL = "UPDATE dbo.Receiving SET "
							cSQL = cSQL + " RMA_Detail="+STR(nRMA_Detail)
							cSQL = cSQL + " WHERE ID="+STR(nReceivingID)
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
								TrackError("UPDATE the rest of table dbo.Receiving. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
							ENDIF
						ENDIF
					ENDIF	
					
				ENDIF
				
				IF nReceivingID = 0
					IF nRMA_No = 0
						*Could be a new Add and nReceivingID has not been set
						TrackError("nReceivingID is 0, Should have been set by EXEC dbo.p_Receiving_ins3 ."+CHR(13)+cSQL,"bad variable",PROGRAM(),LINENO(1))
						*TrackMess("nReceivingID is 0, Should have been set by EXEC dbo.p_Receiving_ins3 ."+CHR(13)+"bad variable"+CHR(13)+"Shop_StockLst_Edit:ReceivingSaveAdd")
					ENDIF
				ENDIF
			*ENDIF
		ENDIF
		IF USED("tmpCountRid")
			USE IN tmpCountRid
		ENDIF
		***
		
		
		PRIVATE lFoundStockUpdateReceiving 
		lFoundStockUpdateReceiving = .F.
		
		
		********************
		PRIVATE nPOcomplete
		nPOcomplete = 0
		
		IF nHPApo > 0
			IF nReceivingID > 0 AND NOT lRMA
				PRIVATE nReceivingIDnow
				IF nReceivingIDOld = 0
					*New Add, Invert nReceivingID to Show as an Add
					nReceivingIDnow = -nReceivingID  
				ELSE
					nReceivingIDnow = nReceivingID  
				ENDIF
				
				DO FORM Forms\ShowReceived_Ordered WITH cPOitem, cAlloy,cHeat,nPieces,nActualW,cDescription,nReceivingIDnow TO nPOcomplete
				IF VARTYPE(nPOcomplete) = 'N'
					nPOcomplete = PrepareSQLnum(nPOcomplete,'nPOcomplete',-1)
					*nPOcomplete = 0 no Choice, 1 Not Complete, 2 Complete
					DO CASE
					CASE nPOcomplete = 0
						RETURN .F.
					CASE nPOcomplete = 1
						*Done in ShowReceived_Ordered 
					CASE nPOcomplete = 2
						*Done in ShowReceived_Ordered 
					ENDCASE
				ELSE
					TrackError("DO FORM Forms\ShowReceived_Ordered returned nPOcomplete that was not 0,1,2"+CHR(13)+"nReceivingID > 0 AND NOT lRMA" ,"bad return",PROGRAM(),LINENO(1))
					*RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"DO FORM Forms\ShowReceived_Ordered returned nPOcomplete that was not 0,1,2"+CHR(13)+"nReceivingID > 0 AND NOT lRMA")
					RETURN .F.
				ENDIF
				
			ENDIF
		ENDIF
		
		*****************************
		IF nWO_Detail > 0
			IF nReceivingID > 0
				PRIVATE nReceivingIDnow
				IF nReceivingIDOld = 0
					*New Add, Invert nReceivingID to Show as an Add
					nReceivingIDnow = -nReceivingID  
				ELSE
					nReceivingIDnow = nReceivingID  
				ENDIF
				
				PRIVATE cWOD
				cWOD = "WOD"+STR(nWO_Detail)
				DO FORM Forms\ShowReceived_Ordered WITH cWOD, cAlloy,cHeat,nPieces,nActualW,cDescription,nReceivingIDnow TO nPOcomplete
				IF VARTYPE(nPOcomplete) = 'N'
					nPOcomplete = PrepareSQLnum(nPOcomplete,'nPOcomplete',-1)
					*nPOcomplete = 0 no Choice, 1 Not Complete, 2 Complete
					DO CASE
					CASE nPOcomplete = 0
						RETURN .F.
					CASE nPOcomplete = 1
						*Done in ShowReceived_Ordered 
					CASE nPOcomplete = 2
						*Done in ShowReceived_Ordered 
					ENDCASE
				ELSE
					TrackError("DO FORM Forms\ShowReceived_Ordered returned nPOcomplete that was not 0,1,2"+CHR(13)+cWOD ,"bad return",PROGRAM(),LINENO(1))
					*RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"DO FORM Forms\ShowReceived_Ordered returned nPOcomplete that was not 0,1,2"+CHR(13)+cWOD )
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		
		
		**********************	
		IF nReceivingID > 0
			***Update ID_Master and StockTable in Receiving  
			*a new receive should not have stock marked!
			*--Record ID,ID_Detail,TBL back to Receiving in POrecvStock Save
			*lFoundStockUpdateReceiving = ThisForm.ReceivingSaveID_Master( nReceivingID, cSOitem, cPOitem, nWO_Detail, cHeat, nPieces, nRMA_No, nActualW )
		
			IF NOT lRMA
				lFoundStockUpdateReceiving = ThisForm.ReceivingSaveID_Master(nReceivingID, cSOitem, cPOitem, nWO_Detail, cHeat, nPieces, nRMA, nActualW)
			ENDIF
		ELSE
			IF NOT lRMA
				TrackError("bad variable","nReceivingID is 0, Could not run ReceivingSaveID_Master(nReceivingID)",PROGRAM(),LINENO(1))
			ENDIF
		ENDIF
		
		
		********************
		PRIVATE lRollBack
		lRollBack = .F.
		
		IF NOT lRMA
			IF lSaved 
				IF cPOitem != Proper_PO_Item('')
		
					IF ThisForm.UpdatePurchaseOrder(dReceived,cPOitem) &&Double check Receiving Add.
					ENDIF
				
					PRIVATE nCntPOitem
					nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle)
					
					IF nCntPOitem > 0
						lSaved = ThisForm.SaveAdd_PurchaseOrder(nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAllready_Saved,nActualW,lFoundStockUpdateReceiving,nPOcomplete )
						IF lSaved
							nID_Master	= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID',-3)
							nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
						ENDIF
					ELSE
						IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle,"NOT SERVICES CONVSERV EQUIPMENT") = 0
							*SaveAdd_PurchaseOrder Calls Remove_Incoming_Process
							IF NOT Remove_Incoming_Process(cPOitem,nPieces,nActualW,ThisForm.nConnHandle,nPOcomplete,nReceivingID,'')
								PRIVATE cMess
								cMess = "Remove_Incoming_Process("
								cMess = cMess + " cPOitem="+ShowSQLtxt(cPOitem,'POitem',12)
								cMess = cMess + ",nPieces="+ALLTRIM(STR(nPieces))
								cMess = cMess + ",nActualW="+ALLTRIM(STR(nActualW))
								cMess = cMess + ",WO_Detail="+ALLTRIM(STR(nWO_Detail))
								
								TrackError(cMess,"Bad variable or Fail",PROGRAM(),LINENO(1))
								TrackMess("Remove_Incoming_Process"+CHR(13)+"Bad variable or Fail"+CHR(13)+"Receiving:SaveAdd(Remove_Incoming_Process)")
							ENDIF
						ENDIF
					ENDIF
					
					IF pSaveType == "ADD"
						* not "ADDCLONE"
						ThisForm.ResetAddVars()
					ELSE
						IF pSaveType = "ADDCLONE"
							ThisForm.lClone = .T.
							ThisForm.txtReceivingID.Value = 0
							ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
						ENDIF
					ENDIF
				ENDIF
				*Called in SaveAdd_PurchaseOrder
				*lSaved = ThisForm.ReceivePOStockLst( cPOitem, nReceivingID, cHeat, 0, cSOitem, nWO_Detail ) 
			ENDIF
		
			IF lSaved 			
				IF pSaveType == "ADD"
					* not "ADDCLONE"
					ThisForm.ResetAddVars()
				ENDIF
				IF pSaveType = "ADDCLONE"
					ThisForm.lClone = .T.
					ThisForm.txtReceivingID.Value = 0
					IF NOT LEFT(ThisForm.txtHeat.Value,1) = '*'
						ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF lRMA
			*RMA
			IF NOT lRollBack
				*RMA does not have a Process!
				*IF NOT Remove_Incoming_Process(cPOitem,nPieces,nActualW,ThisForm.nConnHandle,nPOcomplete,nReceivingID,'')
				*	TrackError("Bad variable or Fail","Remove_Incoming_Process",PROGRAM(),LINENO(1))
				*ENDIF
				
				IF ThisForm.MarkAsRMAreceived()
				
				ENDIF
				
				*Add RMA to StockLst
				lSaved = ThisForm.ReceivePOStockLst( cPOitem, nReceivingID, cHeat, nRMA_Detail, cSOitem, nWO_Detail ) 
				
				IF lSaved 
					IF pSaveType == "ADD"
						THISFORM.ResetAddVars()
					ELSE
						IF pSaveType = "ADDCLONE"
							ThisForm.lClone = .T.
							ThisForm.txtReceivingID.Value = 0
							IF NOT LEFT(ThisForm.txtHeat.Value,1) = '*'					
								ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF	
		
		IF NOT lRollBack AND lSaved
			IF nID_Detail= 0 AND nID_Master = 0
				*********************************
				*Check History to see if a StockLst Add is needed
				
				PRIVATE lFoundHistory 
				lFoundHistory = .F.
		
				*IGNORE, If there is history
				IF USED('cntMDP_History')
					USE IN cntMDP_History
				ENDIF
		
				cSQL = "SELECT DISTINCT 'S' AS TBL, P.ID_Detail, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.[Ar.StockLst_Process_History] P "
				cSQL = cSQL + " INNER JOIN dbo.[Ar.Stocklst_Detail_History] D ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.[Ar.Stocklst_Master_History] M ON D.ID = M.ID "
				cSQL = cSQL + " WHERE ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'NOT2HPA' OR P.Process_ID = 'PARTRECV' )"
				cSQL = cSQL + " --AND P.WHAT = 'DELETE' "
				IF cPOitem <> Proper_PO_item('')
					cSQL = cSQL + " AND P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				ENDIF
				IF nWO_Detail > 0
					cSQL = cSQL + " AND P.WO_Detail = "+ALLTRIM(STR(nWO_Detail))
				ENDIF
		
				IF LEN(ThisForm.cHeat) > 0
					cSQL = cSQL + " AND M.Heat = '"+ThisForm.cHeat+"'"
				ENDIF
		
		
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntMDP_History')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntMDP_History')
				ENDDO
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntMDP_History')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('cntMDP_History')	
					IF RECCOUNT('cntMDP_History') > 0
						lFoundHistory = .T.
					ENDIF
					USE IN cntMDP_History
				ENDIF
		
				IF NOT lFoundHistory 
				
					nMess = MESSAGEBOX("The Heat# "+ThisForm.cHeat+" was not found in History."+CHR(13)+"Do you want to run StockLst now to Add?",4+32,"Add to Stock?")
					IF nMess = 6
						*Add this to the StockLst  --Usually called in Thisform.ReceivePOStockLst() --ThisForm.SaveAdd_PurchaseOrder()
						DO FORM Forms\PORecvStock WITH cPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, nID_Master 
					ENDIF		
				ENDIF
			ENDIF
		ENDIF
		
		*********************************
		
		*Alert proper department of this receive
		IF NOT lRollBack AND lSaved
			PRIVATE lImportant
			lImportant = .T.
			
			IF pSaveType = "EDIT"
				*check for an important edit or reason to notify users.
				*lImportant = .F.
			ENDIF
			
			IF lImportant
			
				IF cSOitem != Proper_SO_Item('')
					IF lRMA 
						ThisForm.Alert_Receive_Email('SOitem_RMA',cSOitem,nReceivingID) &&,nRMA, nRMA_Detail
					ELSE
						ThisForm.Alert_Receive_Email('SOitem',cSOitem,nReceivingID )
					ENDIF
				ENDIF
				IF cPOitem != Proper_PO_Item('')
					ThisForm.Alert_Receive_Email('POitem',cPOitem,nReceivingID )
				ENDIF
				IF nWO_Detail > 0
					ThisForm.Alert_Receive_Email('WO_Detail',nWO_Detail,nReceivingID )
				ENDIF
				IF nWO > 0
					ThisForm.Alert_Receive_Email('WO',nWO,nReceivingID )
				ENDIF
		
			ENDIF	 
		ENDIF
		
		*********************************
		
		RETURN lSaved 
		
		
		
	ENDPROC

	PROCEDURE saveadd_purchaseorder
		PARAMETERS nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA,   lAllready_Saved,nActualW,lFoundStockUpdateReceiving,nPOcomplete 
		*          nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAllready_Saved,nActualW,lFoundStockUpdateReceiving,nPOcomplete )
		*ThisForm.SaveAdd_PurchaseOrder
		
		IF VARTYPE(nReceivingID) != "N"		
			*TrackError("bad parameter","nReceivingID is not a NUMBER",PROGRAM(),LINENO(1))
			nReceivingID = 0
		ELSE
			IF nReceivingID = 0
				*TrackError("Bad Parameter","nReceivingID is 0",PROGRAM(),LINENO(1))
				TrackMess("nReceivingID is 0"+CHR(13)+"Bad Parameter"+CHR(13)+"Receiving:SaveAdd_PurchaseOrder")
			ENDIF
		ENDIF
			
		IF VARTYPE(lFoundStockUpdateReceiving) != "L"
			lFoundStockUpdateReceiving = .F.
		ENDIF
		
		PRIVATE nItemPO,nHPAPO,nSalesNum,nItemSo
		nItemPO	= VAL(RIGHT(cPOitem,2))
		nHPAPO	= VAL(LEFT(cPOitem,AT('-',cPOitem)-1 ))
		nSalesNum	= VAL(LEFT(cSOitem,AT('-',cSOitem)-1 ))
		nItemSo	= VAL(RIGHT(cSOitem,2))
		
		*Mark PO
		PRIVATE lRollBack
		lRollBack = .F.
		
		PRIVATE nCntPOitem,nCntSOitem 
		nCntPOitem = 0
		nCntSOitem = 0
		
		*****************
		IF USED('cntPO')
			USE IN cntPO
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POitem = '"+cPOItem+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPO' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntPO' )
		ENDIF
		
		IF USED('cntPO')
			nCntPOitem = cntPO.CNTD
			USE IN cntPO
		ENDIF
		*****************
		PRIVATE cHeatCombined
		cHeatCombined = cHeat
		
		IF nCntPOitem > 0	
			*Add new heat to heat list
			IF USED('tmpPOHeat')
				USE IN tmpPOHeat
			ENDIF
		
			SELECT 0
			cSQL = "SELECT Heat FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = '"+cPOItem+"'"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOHeat')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOHeat' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOHeat' )
			ENDIF
		
			IF USED('tmpPOHeat')
				IF VARTYPE(tmpPOHeat.Heat) = "C"
					IF NOT EMPTY(tmpPOHeat.Heat)
						IF NOT UPPER(cHeat) $ UPPER(tmpPOHeat.Heat)
							IF EMPTY(cHeat)
								cHeatCombined = PrepareSQLtxt(tmpPOHeat.Heat,'Heat',50,.F.,.T.)
							ELSE
								cHeatCombined = ALLTRIM(cHeat)+","+ALLTRIM(PrepareSQLtxt(tmpPOHeat.Heat,'Heat',50,.F.,.T.))
							ENDIF
						ENDIF
					ENDIF
				ELSE
					*Null Heat found!
				ENDIF
				USE IN tmpPOHeat
			ENDIF
		ENDIF
		
		********************
		IF nCntPOitem = 0	
			*Check for SO- Allow if has SO
			IF USED('tmpCountSO')
				USE IN tmpCountSO
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS cntd FROM dbo.Sales "
			cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountSO')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCountSO' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCountSO' )
			ENDIF
		
			IF USED('tmpCountSO')
				IF NOT EOF('tmpCountSO')
					IF tmpCountSO.cntd > 0
						nCntSOitem = tmpCountSO.cntd
					ENDIF
				ENDIF
				USE IN tmpCountSO
			ENDIF	
			
			IF nCntSOitem = 0
				*Did not find that PO in PurchaseOrder!
				*And now, did not find a SO!  RollBack
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" or SOitem:"+ALLTRIM(cSOitem)+" -Cound not find either! #Rollback")
				MESSAGEBOX("Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" or SOitem:"+ALLTRIM(cSOitem)+" -Cound not find either! #Rollback"+CHR(13)+"Please check that you typed the right PO or SO!",0,"PO or SO item not found!")
				*Do not add to PurchaseOrder
				*POitem is check early in receiving
				lRollBack = .T.
			ENDIF
		ENDIF
		
		********************
		IF nCntPOitem > 0	
		
			PRIVATE cSQLu
			cSQLu = "UPDATE dbo.PurchaseOrder SET "
			cSQLu = cSQLu + " Receipt ='"+cComments+"'"
			cSQLu = cSQLu + ",Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"		
			cSQLu = cSQLu + ",ReceivedBy ='"+cInit+"'"
			cSQLu = cSQLu + ",Heat ='"+PrepareSQLtxt(cHeatCombined,'Heat',50,.F.,.T.)+"'"
			cSQLu = cSQLu + ",Delivered=1"
			cSQLu = cSQLu + ",Cert="+IIF(lCert,'1','0')
			cSQLu = cSQLu + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOItem+"')"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				lPOSaveLst = .T.
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" updated POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrders to Delivered.")
			ENDIF
		ENDIF	
		
		********************
		IF NOT lRollBack
			*Done in ReceivingSaveAdd where nReceivingID can be used.
			*Remove_Incoming_Process(cPOitem,nPieces,nActualW,ThisForm.nConnHandle,1)
		ENDIF
		
		********************
		IF lRollBack
			RETURN .F.
		ENDIF
		
		*ThisForm.RefreshReceiving()
		
		********************		
		IF nCntPOitem > 0	
		*	ThisForm.ReportReceivedtoOrdered(cPOitem)
			*ThisForm.ReceivingRefreshReceiving()
			PRIVATE nWO, nWO_Detail 
			nWO 		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
			nWO_Detail  = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
			
		*	IF lAlready_Saved
				IF lFoundStockUpdateReceiving 
					ThisForm.ReceivePOStockLst( cPOitem, nReceivingID, cHeat, 0, cSOitem, nWO_Detail ) 
				ELSE
					ThisForm.ReceivePOStockLst( cPOitem, nReceivingID, cHeat, 0, cSOitem, nWO_Detail ) 
				ENDIF
		*	ELSE
		*		ThisForm.ReceivePOStockLst( cPOitem, nReceivingID, cHeat, 0, cSOitem, nWO_Detail ) 
		*	ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE save_po
		PARAMETERS nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA,lAllready_Saved,nActualW,lFoundStockUpdateReceiving,nPOcomplete
		*ThisForm.Save_PO()  --- NOT USED ---
		
		*!*	*Called From View/Edit tab, cmdEditStockLst.Click()
		*!*	*Called From ThisForm.SaveAdd() if NOT RMA and other Saves passed.
		*!*	*Saves Combined Heat to PurchaseOrder and opens PO Receive to StockLst
		
		*!*	IF VARTYPE(nReceivingID) != "N"
		*!*		TrackError("bad parameter","PARAMETER nReceivingID is not a NUMBER",PROGRAM(),LINENO(1))
		*!*		nReceivingID = 0
		*!*	ENDIF
		*!*	IF nReceivingID = 0
		*!*		TrackError("bad parameter","nReceivingID is 0",PROGRAM(),LINENO(1))
		*!*	ENDIF
		
		*!*	IF VARTYPE(lFoundStockUpdateReceiving) != "L"
		*!*		lFoundStockUpdateReceiving = .F.
		*!*	ENDIF
		*!*	IF VARTYPE(nPOcomplete) != "N"
		*!*		nPOcomplete = 0  &&*nPOcomplete = 0 unknown, 1 Not Complete, 2 Complete
		*!*	ENDIF
		
		*!*	PRIVATE nItemPO,nHPAPO,nSalesNum,nItemSo
		*!*	nItemPO	= VAL(RIGHT(cPOitem,2))
		*!*	nHPAPO	= VAL(LEFT(cPOitem,AT('-',cPOitem)-1 ))
		*!*	nSalesNum	= VAL(LEFT(cSOitem,AT('-',cSOitem)-1 ))
		*!*	nItemSo	= VAL(RIGHT(cSOitem,2))
		
		*!*	PRIVATE nWO_Detail
		*!*	nWO_Detail	= PrePareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		
		*!*	*Mark PO
		*!*	PRIVATE lRollBack
		*!*	lRollBack = .F.
		
		*!*	PRIVATE nCntPOitem,nCntSOitem 
		*!*	*nCntPOitem = 0
		*!*	nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle )
		*!*	*nCntSOitem = 0
		*!*	nCntSOitem = Count_SOIteminSales( cSOItem, ThisForm.nConnHandle)
		
		
		*!*	*****************
		*!*	PRIVATE cHeatCombined
		*!*	cHeatCombined = cHeat
		
		*!*	IF nCntPOitem > 0	
		*!*		*Add new heat to heat list
		*!*		IF USED('tmpPOHeat')
		*!*			USE IN tmpPOHeat
		*!*		ENDIF
		
		*!*		SELECT 0
		*!*		cSQL = "SELECT Heat FROM dbo.PurchaseOrder "
		*!*		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOItem+"')"
		*!*		cSQL = cSQL + " AND Heat Not like '%"+ALLTRIM(cHeat)+"%'"
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOHeat')
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOHeat' )
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOHeat' )
		*!*		ENDIF
		
		*!*		IF USED('tmpPOHeat')
		*!*			IF VARTYPE(tmpPOHeat.Heat) = "C"
		*!*				IF NOT EMPTY(tmpPOHeat.Heat)
		*!*					IF NOT UPPER(cHeat) $ UPPER(tmpPOHeat.Heat)
		*!*						IF EMPTY(cHeat)
		*!*							cHeatCombined = ALLTRIM(PrepareSQLtxt(tmpPOHeat.Heat,'Heat',30,.F.,.T.))
		*!*						ELSE
		*!*							*cHeatCombined = ALLTRIM(PrepareSQLtxt(tmpPOHeat.Heat,'Heat',30,.F.,.T.))+","+ALLTRIM(cHeat)
		*!*							cHeatCombined = ALLTRIM(cHeat)+","+ALLTRIM(PrepareSQLtxt(tmpPOHeat.Heat,'Heat',30,.F.,.T.))
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*			USE IN tmpPOHeat
		*!*		ENDIF											
		*!*	ENDIF
		
		*!*	********************
		*!*	IF nCntPOitem = 0	
		*!*		*Check for SO- Allow if has SO
		*!*		
		*!*		IF nCntSOitem = 0
		*!*			*Did not find that PO in PurchaseOrder!
		*!*			*And now, did not find a SO!  RollBack
		*!*			TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" or SOitem:"+ALLTRIM(cSOitem)+" -Cound not find either! #Rollback")
		*!*			MESSAGEBOX("Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" or SOitem:"+ALLTRIM(cSOitem)+" -Cound not find either! #Rollback"+CHR(13)+"Please check that you typed the right PO or SO!",0,"PO or SO item not found!")
		*!*			*Do not add to PurchaseOrder
		*!*			*POitem is check early in receiving
		*!*			lRollBack = .T.
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	********************
		*!*	IF nCntPOitem > 0	
		
		*!*		PRIVATE cSQLu
		*!*		cSQLu = "UPDATE dbo.PurchaseOrder SET "
		*!*		cSQLu = cSQLu + "Receipt ='"+cComments+"'"
		*!*		*In Receiving, dDate is date at HPA, dReceived is when record added to
		*!*		cSQLu = cSQLu + ",Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"		
		*!*		*In PurchaseOrder, dReceived is date at HPA
		*!*		cSQLu = cSQLu + ",ReceivedBy ='"+cInit+"'"
		*!*		cSQLu = cSQLu + ",Heat ='"+LEFT(cHeatCombined,50)+"'"
		*!*		cSQLu = cSQLu + ",Delivered=1"
		*!*		cSQLu = cSQLu + ",Cert="+IIF(lCert,'1','0')
		*!*		cSQLu = cSQLu + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOItem+"')"
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
		*!*		ELSE
		*!*			lPOSaveLst = .T.
		*!*			TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" updated POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrders to Delivered.")
		*!*		ENDIF
		*!*	ENDIF	
		
		*!*	********************
		*!*	IF NOT lRollBack
		*!*		*IF NOT Remove_Incoming_Process(cPOitem,nPieces,nActualW,ThisForm.nConnHandle)
		*!*		IF NOT Remove_Incoming_Process(cPOItem,nPieces,nActualW,ThisForm.nConnHandle, nPOcomplete, nReceivingID )
		*!*			TrackError("Bad variable or Fail","Remove_Incoming_Process",PROGRAM(),LINENO(1))
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	********************
		*!*	IF lRollBack
		*!*		RETURN .F.
		*!*	ENDIF
		
		*!*	********************		
		
		*!*	IF nCntPOitem > 0				
		*!*		IF lAllready_Saved
		*!*			IF lFoundStockUpdateReceiving 
		*!*				ThisForm.ReceivePOStockLst( cPOitem , nReceivingID, cHeat, 0, cSOitem, nWO_Detail ) 
		*!*			ELSE
		*!*				ThisForm.ReceivePOStockLst( cPOitem , nReceivingID, cHeat, 0, cSOitem, nWO_Detail ) 
		*!*			ENDIF
		*!*		ELSE
		*!*			ThisForm.ReceivePOStockLst( cPOitem , nReceivingID, cHeat, 0, cSOitem, nWO_Detail ) 
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	********************
		*!*			
		*!*	IF nCntPOitem > 0	
		*!*		ThisForm.ReportReceivedtoOrdered(cPOitem)
		*!*		*ThisForm.ReceivingRefreshReceiving()
		*!*	ENDIF
		
		
		*!*	ThisForm.ReceivingRefreshReceiving()
		
		
		*!*	RETURN .T.
		
	ENDPROC

	PROCEDURE showpoitem
		PARAMETERS pcPOitem
		*ThisForm.ShowPOitem(cPOitem)
		
		PRIVATE cPOitem, cSOitem
		cPOitem = ''
		
		IF VARTYPE(pcPOitem) = "C"
			cPOitem = Proper_PO_Item( pcPOitem )
		ENDIF
		
		IF EMPTY(cPOitem )
			MESSAGEBOX("Cannot get PO.",0+32,"No PO-item")
			RETURN .F.
		ENDIF
		
		PRIVATE lnText2Find  
		lnText2Find  = VAL(LEFT(cPOitem,AT("-",cPOitem)-1))
		
		ThisForm.txtFindText.Value = STR(lnText2Find)
		
		SELECT Receiving
		*POitem
		SET ORDER TO TAG HPAPO
		SEEK lnText2Find  IN 'Receiving' ORDER HPAPO
		
		IF NOT FOUND('Receiving')
			IF Count_HPAPOinPurchaseOrder( lnText2Find, ThisForm.nConnHandle ) = 0
				MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" has not been entered!"+CHR(13)+"Have this PO added in PurchaseOrder screen",0+16,"PO Not Found, Stop receiving and enter PO first!")
			ELSE
				IF Count_HPAPOinStockLst( lnText2Find, ThisForm.nConnHandle ) = 0
					MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" was not found in StockLst\BrokerLst list."+CHR(13)+"Have this PO edited in PurchaseOrder screen"+CHR(13)+"so ALL PO related tables are updated!",0+16,"PO Not Found, Stop receiving and enter PO first!")
				ELSE
					MESSAGEBOX(	"Po ="+ALLTRIM(STR(lnText2Find))+" was not found."+CHR(13)+CHR(13)+"But was found in PurchaseOrder and StockLst/BrokerLst!.",0+64,"Not found in Receiving.")
				ENDIF
			ENDIF
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE Unload
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
	ENDPROC

	PROCEDURE updatepurchaseorder
		PARAMETERS dReceived, cPOitem
		*ThisForm.UpdatePurchaseOrder(dReceived,cPOitem)
		
		IF ( VARTYPE(dReceived) = "D" OR VARTYPE(dReceived) = "T" )
			*good
		ELSE
			RETURN .F.
		ENDIF
		
		IF VARTYPE(cPOitem) != "C"
			RETURN .F.
		ENDIF
		
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item("0-00")
			RETURN .F.
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC, lSaved 
		lSaved = .T.
		
		cSQLu = "IF EXISTS (SELECT * FROM dbo.PurchaseOrder "
		cSQLu = cSQLu +" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"	
		cSQLu = cSQLu +" AND Received IS NULL) "
		
		cSQLu = cSQLu +"UPDATE dbo.PurchaseOrder SET"
		cSQLu = cSQLu +" Received = '"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"	
		cSQLu = cSQLu +" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		ENDDO
		IF nSQLEXEC < 1
			SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
			lSaved = .F.
			*RETURN
			RecordError(0,"Could not update dbo.PurchaseOrder " ,PROGRAM(),LINENO(1), "SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
		ELSE 
			lSaved = .T.
		ENDIF
		
		RETURN lSaved 
	ENDPROC

	PROCEDURE frmPORecvStock.ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle)
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE frmPORecvStock.ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE frmPORecvStock.ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle)
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPORecvStock.BrandName1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, cAlloy, cBrandName
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		cAlloy = ThisForm.ALLOY1.Value
		cBrandName = ""
		
		IF USED('tmpBrandName')
			SELECT tmpBrandName
		ELSE
			SELECT 0
		ENDIF
		
		IF !EMPTY(lcSearchStr)
			cSQL = "SELECT DISTINCT [BrandName] FROM dbo.StockLst_Master WHERE Alloy = '"+cAlloy+"'"
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpBrandName')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'tmpBrandName')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpBrandName')
			ENDIF
		
		
			IF USED("tmpBrandName")
				SELECT tmpBrandName
				IF NOT ISNULL(tmpBrandName.BrandName)
					cBrandName = tmpBrandName.BrandName
					LOCATE FOR UPPER(BrandName) = UPPER(lcSearchStr)
					IF FOUND('tmpBrandName')
						cBrandName = tmpBrandName.BrandName
					ENDIF
				ENDIF
				USE IN tmpBrandName
			ENDIF
		
			IF NOT EMPTY(cBrandName)
			
				IF UPPER(lcSearchStr) = SUBSTR(cBrandName,1,lnInsertionPt)
					THIS.VALUE=cBrandName
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
		
		
	ENDPROC

	PROCEDURE frmPORecvStock.BrandName1.LostFocus
		=insmode(.T.)
	ENDPROC

