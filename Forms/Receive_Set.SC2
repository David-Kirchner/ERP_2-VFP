	PROCEDURE frmReceive_Edit.Resize
		*PRIVATE nHeight, nWidth
		*nHeight	= This.Height - 300
		*nWidth	= This.Width - 631
		
	ENDPROC

	PROCEDURE frmReceive_Edit.txtAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE frmReceive_Edit.txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmReceive_Edit.txtDate.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE("dDate") = "C"
				dDate = CtoD(ALLTRIM(This.Value))
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
				This.Value = DATE()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.txtHeat.Valid
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat, cAlloy
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cHeat = PrepareSQLtxt(This.Value,'Heat',50)
		IF UPPER(cHeat)  = "DUE IN"
			cHeat = ""	&&Do not check for Due In
		ENDIF
		
		PRIVATE nReceivingID
		nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		
		IF NOT EMPTY(cHeat) 
			IF nItemPo < 1 OR nHpaPo < 1
				*Only run here if bad POitem
				IF MESSAGEBOX("Do you want to look for a PO that used this heat number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
					*nReceivingID	= Receiving.ID
					
					IF nItemPo = 0
						ThisForm.ChoosePOitemLoad(nHpaPo)
					ELSE
						IF nHpaPo > 0 AND EMPTY(cHeat) 
							ThisForm.cPOitem = cPOitem
							ThisForm.GetPoItemDetail(cPOitem)
						ELSE
							ThisForm.cPOitem = cPOitem
							ThisForm.GetFromReceiving(cPOitem,cHeat)
						ENDIF
					ENDIF
					
					IF USED('Receiving')
						SELECT Receiving
						LOCATE FOR ID = nReceivingID
					ENDIF
						
				ENDIF
			ELSE
		*!*			*nReceiveID could be 0 untill the PO Receive Stock is done.
		*!*			IF nReceivingID = 0
		*!*				ThisForm.txtID_Master.Value = 0
		*!*				ThisForm.txtID_Detail.Value = 0
		*!*				ThisForm.txtTBL.Value = ''
		*!*				ThisForm.txtID_Detail_Process.Value = 0
		*!*			ENDIF
			ENDIF
			
			IF NOT EMPTY(cAlloy)
				********************************	
				*Warn if that Heat is NOT Unique
				
				
				IF USED("tmpOtherHeat")
					USE IN tmpOtherHeat
				ENDIF
		
		
				cSQL = "SELECT ID, POitem, SOitem, WhenAdd,Description"
				cSQL = cSQL + " FROM dbo.Receiving "
				cSQL = cSQL + " WHERE Heat = '"+cHeat+"'"
				cSQL = cSQL + " AND Alloy = '"+cAlloy+"'"
				cSQL = cSQL + " AND ID<>"+STR(nReceivingID)
				cSQL = cSQL + " AND ISNULL(Cancelled,0)=0 "  
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOtherHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOtherHeat')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpOtherHeat')
				ENDIF
		
				IF USED("tmpOtherHeat")
					IF RECCOUNT("tmpOtherHeat") > 0
						PRIVATE cPOitem, cSOitem, dWhenAdd,cDescription, cMess
						cPOitem	= PrepareSQLtxt(tmpOtherHeat.POitem,'POitem',12)
						cSOitem	= PrepareSQLtxt(tmpOtherHeat.SOitem,'SOitem',10)
						dWhenAdd	= PrepareSQLdate(tmpOtherHeat.WhenAdd,'WhenAdd')
						cDescription = PrepareSQLtxt(tmpOtherHeat.Description,'Description',80)
						IF Proper_PO_Item(cPoItem) != Proper_PO_Item('')
						ENDIF
						cMess = "This Heat '"+ALLTRIM(cHeat)+"' was also found"+CHR(13)
						cMess = cMess +"on Receiving ID:"+ALLTRIM(STR(tmpOtherHeat.ID))+CHR(13)
						cMess = cMess +"and Alloy '"+ALLTRIM(cAlloy)+"'"+CHR(13)
						IF Proper_PO_Item(cPoItem) != Proper_PO_Item('')
							cMess = cMess +"and POitem '"+cPoItem+"'"+CHR(13)
						ENDIF
						IF Proper_SO_Item(cSoItem) != Proper_SO_Item('')
							cMess = cMess +"and SOitem '"+cSoItem+"'"+CHR(13)
						ENDIF
						cMess = cMess +cDescription +CHR(13)
						IF VARTYPE(dWhenAdd)='D'
							cMess = cMess +"and When Added is "+DTOC(dWhenAdd)+"."+CHR(13)+CHR(13)
						ENDIF
						IF VARTYPE(dWhenAdd)='T'
							cMess = cMess +"and When Added is "+TTOC(dWhenAdd)+"."+CHR(13)+CHR(13)
						ENDIF
						
						cMess = cMess +"Do not duplicate."
						cMess = cMess +CHR(13)+CHR(13)+"Edit with Receiving program to fix Heat."
						MESSAGEBOX(cMess,48,"Do not duplicate.")
					ENDIF
					USE IN tmpOtherHeat
				ENDIF
				
			ENDIF		
		ENDIF
		
	ENDPROC

	PROCEDURE frmReceive_Edit.txtHpaPOItem.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID > 0
			*DONE!!!
			RETURN .T.
		ENDIF
		
		
		
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat 
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		cHeat 	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		
		IF nItemPo = 0
			ThisForm.ChecknItemPO = 0
		ENDIF
		
		****
		IF nItemPo = 0 AND nHpaPo > 0
			*Choose a HPApo
			ThisForm.ChoosePOitemLoad(nHPApo)
			*Refresh
			nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
			nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
			cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		ELSE
			IF ThisForm.ChecknItemPO = nItemPo
				IF nItemPo > 0
					WAIT WINDOW "Already retrieved this PO item:"+ALLTRIM(STR(nItemPO)) NOWAIT
				ENDIF
			ELSE
				IF nHpaPo > 0 AND nItemPo > 0
					IF ThisForm.ChecknHpaPO <> nHpaPo OR ThisForm.ChecknItemPO <> nItemPo
						IF EMPTY(cHeat) 
							ThisForm.cPOitem = cPOitem
							ThisForm.GetPoItemDetail(cPOitem)
						ELSE
							ThisForm.cPOitem = cPOitem
							ThisForm.GetFromReceiving(cPOitem,cHeat)
						ENDIF
					ELSE
						*Do not Recheck
					ENDIF
				ENDIF
			ENDIF
		ENDIF	
		
	ENDPROC

	PROCEDURE frmReceive_Edit.txtHpaPONum.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID > 0
			RETURN .T.
		ENDIF
		
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat
		nHpaPo  = PrepareSQLnum(This.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50))
		
		PRIVATE nCntPO,nCntPOitem 
		nCntPO = 0
		
		IF nItemPo = 0
			nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle )
			IF nCntPO = 1
				cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-01" )
				nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle,'' )
				IF nCntPOitem < 1
					ThisForm.ChoosePOitemLoad(nHpaPo)
				ELSE
					*have the correct cPOitem!
					nItemPo = 1
				ENDIF
			ELSE
				ThisForm.ChoosePOitemLoad(nHpaPo)
			ENDIF
		ENDIF
		
		IF nItemPo > 0
			IF nHpaPo > 0
				IF ThisForm.ChecknHpaPO <> nHpaPo OR ThisForm.ChecknItemPO <> nItemPo
					ThisForm.cPOitem = cPOitem
					IF EMPTY(cHeat) 
						ThisForm.GetPoItemDetail(cPOitem)
					ELSE
						ThisForm.GetFromReceiving(cPOitem,cHeat)
					ENDIF
				ELSE
					*Do not Recheck
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.txtReceived.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE('dDate') = "C"
				dDate = CtoD(ALLTRIM(This.Value))
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
				This.Value = DATE()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.txtReceivingID.DblClick
		PRIVATE nMess
		nMess = MESSAGEBOX("Do you wish to reset Receiving ID to 0? (Y)"+CHR(13)+"Reseting to 0 will allow you to receive another heat!",4+32,"Create new Receiving Record?")
		IF nMess = 6
			This.Parent.txtReceivingID.Value =0
			*This.Parent.txtID_Detail.Value	= 0
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.txtRejectPC.Valid
		*!*	PRIVATE cSOitem, nSalesNum, nItemSo
		*!*	PRIVATE nDec
		*!*	nDec = SET("DECIMAL")
		*!*	SET DECIMAL TO 0
		
		*!*	nSalesNum = This.Value
		*!*	IF TYPE("nSalesNum") = "C"
		*!*		nSalesNum = VAL(nSalesNum)
		*!*	ENDIF
		
		*!*	nItemSo = ThisForm.txtSOItem.Value
		*!*	IF TYPE("nItemSo") = "C"
		*!*		nItemSo = VAL(nItemSo)
		*!*	ENDIF
		*!*	cSOitem = STR(nSalesNum,7,0)+"-"+IIF(nItemSo<10,"0"+STR(nItemSo,1,0),+STR(nItemSo,2,0))
		*!*	cSOitem	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		
		*!*	PRIVATE nHpaPo, nItemPo
		*!*	nHpaPo = ThisForm.txtHpaPONum.Value
		
		*!*	IF TYPE("nHpaPo") = "C"
		*!*		nHpaPo = VAL(nHpaPo)
		*!*	ENDIF
		*!*	nItemPo = ThisForm.txtHpaPOItem.Value
		*!*	IF TYPE("nItemPo") = "C"
		*!*		nItemPo = VAL(nItemPo)
		*!*	ENDIF
		*!*	SET DECIMAL TO nDec
		
		*!*	IF nSalesNum > 0 AND nHpaPo=0 AND nItemPo=0
		*!*		ThisForm.GetSoItemDetail()
		*!*	ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.txtRMA_Detail.Valid
		PRIVATE nRMA_Detail
		nRMA_Detail= PrepareSQLnum(This.Value,'RMA_Detail',-3)
		
		IF nRMA_Detail > 0
			ThisForm.Refresh_RMA_Detail()
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.txtRMA_No.Valid
		*RMA_No Receive
		PRIVATE nRMA_Detail, nRMA, cHeat
		nRMA_Detail= PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		nRMA 	= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		
		IF nRMA > 0
			PRIVATE cSQL, nSQLExec
			IF USED("tmpRMA")
				USE IN tmpRMA
			ENDIF
		
			PRIVATE cMess
		
			cSQL = "SELECT Money,Reason,Aprv_By,SO_item "
			cSQL = cSQL + ",RMA.RMA_No, RMA_Detail.RMA_Detail_ID"
			cSQL = cSQL + ",StockLst_ID,StockLst_ID_Detail,TBL,ID "  &&Quoted_PU
			cSQL = cSQL + ",StockLst_QTY,StockLst_P,StockLst_Total "
			cSQL = cSQL + ",StockLst_PU,StockLst_PC,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3, StockLst_LBS"
			cSQL = cSQL + ",SS.PackingSli, SS.Reconciled,SS.Returned, SS.Alloy "
		*	cSQL = cSQL + ",dbo.f_Descript(SD.Alloy,SD.CC,SD.CL,SD.Form,SD.StockLst_Dim1,SD.StockLst_Dim2,SD.StockLst_Dim3,SD.StockLst_QTY,0) AS Descript"	
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.StockLst_PC, SS.Form,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3,SS.StockLst_QTY, 0, 0, '', '', '') AS Descript"
			cSQL = cSQL + " FROM dbo.RMA "
			cSQL = cSQL + " INNER JOIN dbo.RMA_Detail ON RMA.RMA_No = RMA_Detail.RMA_NO "
		*	cSQL = cSQL + " INNER JOIN dbo.Sales_Detail SD ON RMA_Detail.So_item = SD.SOitem "
			cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SS WITH (NOLOCK) ON RMA_Detail.So_item = SS.SOitem "
			cSQL = cSQL + " WHERE RMA.RMA_No = "+STR(nRMA)
			IF NOT EMPTY(cHeat)	
				cSQL = cSQL + " AND SS.Heat = '"+cHeat+"'"
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMA')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA' )
			ENDIF
		
			IF NOT USED('tmpRMA') OR RECCOUNT('tmpRMA') = 0	
				*try without HEAT
				cSQL = "SELECT Money,Reason,Aprv_By,SO_item "
				cSQL = cSQL + ",RMA.RMA_No, RMA_Detail.RMA_Detail_ID"
				cSQL = cSQL + ",StockLst_ID,StockLst_ID_Detail,TBL,ID " &&Quoted_PU
				cSQL = cSQL + ",StockLst_QTY,StockLst_P,StockLst_Total "
				cSQL = cSQL + ",StockLst_PU,StockLst_PC,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3, StockLst_LBS"
				cSQL = cSQL + ",SS.PackingSli,SS.Reconciled,SS.Returned, SS.Alloy "
				*cSQL = cSQL + ",dbo.f_Descript(SD.Alloy,SD.CC,SD.CL,SD.Form,SD.StockLst_Dim1,SD.StockLst_Dim2,SD.StockLst_Dim3,SD.StockLst_QTY,0) AS Descript"
				cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.StockLst_PC,SS.Form,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3,SS.StockLst_QTY, 0, 0, '', '', '') AS Descript"
				cSQL = cSQL + " FROM dbo.RMA "
				cSQL = cSQL + " INNER JOIN dbo.RMA_Detail ON RMA.RMA_No = RMA_Detail.RMA_NO "
		*		cSQL = cSQL + " INNER JOIN dbo.Sales_Detail SD ON RMA_Detail.So_item = SD.SOitem "
				cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SS WITH (NOLOCK) ON RMA_Detail.So_item = SS.SOitem "
				cSQL = cSQL + " WHERE RMA.RMA_No = "+STR(nRMA)
						
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMA')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA' )
				ENDIF
		
			ENDIF	
		
		
			IF USED('tmpRMA')
				IF RECCOUNT('tmpRMA') > 0
					PRIVATE cSOitem
					cSOitem = Proper_SO_item(ThisForm.cSOitem)
					IF Proper_SO_item(tmpRMA.SO_item) <> Proper_SO_item('')
						IF Proper_SO_item(tmpRMA.SO_item) <> cSOitem
							MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem ="+Proper_SO_item(tmpRMA.SO_item),16,"Does not Match")
						ENDIF
					ENDIF
				ENDIF
				
				DO CASE
				CASE RECCOUNT('tmpRMA') = 1
					ThisForm.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail',-3)
					ThisForm.Refresh_RMA_Detail()
					
				CASE RECCOUNT('tmpRMA') > 1	
					
					PRIVATE cSOitem, nRecCount, nRecNo, nMess, cMess
					nRecCount = RECCOUNT()
					nRecNo	= RECNO()
					cSOitem = Proper_SO_item(ThisForm.cSOitem)
					
					SCAN
					
						IF Proper_SO_item(tmpRMA.SO_item) <> Proper_SO_item('')
							IF Proper_SO_item(tmpRMA.SO_item) <> cSOitem
								MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem ="+Proper_SO_item(tmpRMA.SO_item),16,"Does not Match")
								EXIT
							ENDIF
						ENDIF
						cMess = "Record: "+ALLTRIM(STR(nRecNo))+" of "+ALLTRIM(STR(nRecCount))+" records."+CHR(13)
						cMess = cMess + "Description: "+tmpRMA.Descript+CHR(13)+CHR(13)
						cMess = cMess + ALLTRIM(PrepareSQLtxt(tmpRMA.Money,'Money',-3))+CHR(13)+CHR(13)
						cMess = cMess + ALLTRIM(PrepareSQLtxt(tmpRMA.Reason,'Reason',-3))+CHR(13)+CHR(13)
						cMess = cMess + "Is this the RMA Detail Item you want to return?"
						*cMess = cMess + "Approved By:"+ALLTRIM(PrepareSQLtxt(tmpRMA.Aprv_By,'Appv_By',-3))
						
						nMess = MESSAGEBOX(cMess,4+32,"RMA Description") 
						
						IF nMess = 6
							PRIVATE nStockLst_QTY
							ThisForm.edtComments.Value = PrepareSQLtxt(tmpRMA.Reason,'Reason',-3)
							ThisForm.txtReceived.Value = DATE()
							Thisform.txtDate.Value = DATE()
							ThisForm.txtRMA_No.Value= PrepareSQLnum(tmpRMA.RMA_No,'RMA_No',-3)
							ThisForm.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail_ID',-3)
							
							ThisForm.txtAlloy.Value = PrepareSQLtxt(tmpRMA.Alloy,'Alloy',12)
							ThisForm.edtDescription.Value = PrepareSQLtxt(tmpRMA.Descript,'Descript',-1)
							nStockLst_QTY = PrepareSQLnum(tmpRMA.StockLst_QTY,'StockLst_QTY',9,1)
							IF nStockLst_QTY > 0
								ThisForm.txtActualW.Value = nStockLst_QTY
								ThisForm.txtBillW.Value = nStockLst_QTY
							ENDIF
							
							ThisForm.txtID_Master.Value = PrepareSQLnum(tmpRMA.StockLst_ID,'Master_ID',-3)
							ThisForm.txtID_Detail.Value = PrepareSQLnum(tmpRMA.StockLst_ID_Detail,'ID_Detail',-3)
							ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpRMA.TBL,'TBL',1)
							ThisForm.lblPriceUnit.Caption = ALLTRIM(STR(PrepareSQLnum(tmpRMA.StockLst_PU,'PU',1)))
						ELSE			
							ThisForm.edtComments.Value = PrepareSQLtxt(tmpRMA.Reason,'Reason',-3)
							ThisForm.txtReceived.Value = DATE()
							Thisform.txtDate.Value = DATE()
							ThisForm.txtRMA_No.Value= PrepareSQLnum(tmpRMA.RMA_No,'RMA_No',-3)
				*			ThisForm.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail_ID',-3)
						ENDIF
						
					ENDSCAN
					USE IN tmpRMA
				ENDCASE
		
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.txtSOitem.Valid
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrePareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrePareSQLnum(This.Value,'SOitem',2,0)
		
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem 	= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
					ThisForm.cSOitem = cSOitem
				ENDIF
				ThisForm.GetSoItemDetail()
			ELSE
				DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSOItem
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
					ThisForm.cSOitem = cSOitem
					This.Value = Proper_SO_item_item(cSOitem)
					ThisForm.GetSoItemDetail()
				ENDIF
			ENDIF
		ELSE
			*do not have full SOitem
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.txtSOnum.Valid
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrePareSQLnum(This.Value,'SalesNum',-3)
		nItemSo 	= PrePareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		
		IF nSalesNum > 0 AND nItemSo > 0
		
			cSOitem 	= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				ThisForm.cSOitem = cSOitem
			ENDIF
			*PRIVATE cPOitem, nHpaPo, nItemPo
			*nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
			*nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
			*cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
			*IF nSalesNum > 0 AND nHpaPo=0 AND nItemPo=0
				ThisForm.GetSoItemDetail()
			*ENDIF
		ELSE
			*do not have full SOitem
		ENDIF
	ENDPROC

	PROCEDURE frmReceive_Edit.Unload
		IF USED('Receiving')	
			USE IN Receiving 
		ENDIF
		
		IF USED('poStatusDef')
			USE IN poStatusDef
		ENDIF
		
		IF USED("tmpStockLst_Master")
			USE IN tmpStockLst_Master
		ENDIF
		*Private Data
		
	ENDPROC

	PROCEDURE frmShowReceived_Ordered.cmdCancel.Valid
		IF MESSAGEBOX("Are you sure you want to Abort this receive?",4+32,"Cancel")=6
			ThisForm.lReturn = 0
			ThisForm.Release
		ENDIF
		
	ENDPROC

	PROCEDURE frmShowReceived_Ordered.cmdGood.Valid
		**Not Complete
		*PRIVATE cTBL
		*cTBL =
		
		PRIVATE nQTY_Diff, nOrder_QTY, nPastTotal, nActualW
		nQTY_Diff 	= PrepareSQLnum(ThisForm.txtQTY_Diff.Value,'QTY_Diff',9,1)
		nOrder_QTY 	= PrepareSQLnum(ThisForm.txtOrder_QTY.Value,'Order_QTY',9,1)
		nPastTotal 	= PrepareSQLnum(ThisForm.txtPastTotal.Value,'PastTotal',9,1)
		nActualW	= PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)
		PRIVATE nMess
		
		IF (( nPastTotal + nActualW +100 ) < (nOrder_QTY+100) * 1.2 ) AND (( nPastTotal + nActualW + 100 ) > (nOrder_QTY+100) / 1.2)
			nMess = MESSAGEBOX("The quantity Received is about the same as the quantity Ordered!"+CHR(13)+CHR(13)+;
			"Are you sure you DO NOT want to mark this"+CHR(13)+"as a COMPLETE Receive?"+CHR(13)+CHR(13)+;
			"Answer No here to go back and then mark as COMPLETE."+CHR(13)+;
			"Answer Yes to continue as 'UN COMPLETE'."+CHR(13),4+32,"Order Not Completed?")
			IF nMess != 6
				RETURN .F.
			ELSE
				IF ThisForm.nWO_Detail = 0
					TrackMess("The POitem: '"+ThisForm.cPOitem+"' was for a QTY of "+ALLTRIM(STR(nOrder_QTY))+"."+CHR(13)+"The QTY this Received is "+ALLTRIM(STR(nActualW))+"."+CHR(13)+"The total QTY Received is "+ALLTRIM(STR(nPastTotal))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisForm.nReceivingID))+"." +CHR(13)+"User override the 15% 'looks complete' message and saved as NOT complete.")
				ELSE
					TrackMess("The WO Detail: '"+ALLTRIM(STR(ThisForm.nWO_Detail))+"' was for a QTY of "+ALLTRIM(STR(nOrder_QTY))+"."+CHR(13)+"The QTY this Received is "+ALLTRIM(STR(nActualW))+"."+CHR(13)+"The total QTY Received is "+ALLTRIM(STR(nPastTotal))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisForm.nReceivingID))+"." +CHR(13)+"User override the 15% 'looks complete' message and saved as NOT complete.")
				ENDIF
			ENDIF
		ENDIF
		
		
		*****************************
		PRIVATE lClearIncomingProcess
		*update current process with POStatus of 'W' for 'Waiting for Bill'
		lClearIncomingProcess = ThisForm.Update_POStatus(.F.)  && .F. instructs to not Complete the Process 
		
		*****************************
		*ThisForm.Check_PartRecv("DONE")
		
		*****************************
		
		PRIVATE nPO_OrigQTY, nPrc_QTY
		nPO_OrigQTY = 0
		nPrc_QTY	= 0
		PRIVATE lNOT2HPA, lPARTRECV
		lNOT2HPA = .F.
		PARTRECV = .F.
		
		*Create a new Master, Detail, Process for remaining Stock
		*keep PARTail check in till no more exits!
		
		PRIVATE nSQLEXEC, cSQL
		
		IF USED('tmpStkProc')	
			USE IN tmpStkProc
		ENDIF
		
		*could Union all Tables with where PO_item ???
		
		cSQL = " SELECT QTY, Prc_QTY, ReceivingID, Process_ID, 'Partail' AS Process "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH (NOLOCK) "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH (NOLOCK) "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WITH (NOLOCK) "
		ENDCASE
		cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		cSQL = cSQL + " AND Process_ID = 'PARTRECV' "
		
		cSQL = cSQL + " UNION"
		cSQL = cSQL + " SELECT QTY, Prc_QTY, ReceivingID, Process_ID, 'Original' AS Process "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH (NOLOCK) "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH (NOLOCK) "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WITH (NOLOCK) "
		ENDCASE
		cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		cSQL = cSQL+" AND ( Process_ID='INCOMING' OR Process_ID = 'NOT2HPA' )"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOStat')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpStkProc')
			IF RECCOUNT('tmpStkProc') > 0
				***************************
				SCAN	&& NOT sure if multiple exists ???
					
					DO CASE
					CASE tmpStkProc.Process = 'Original'
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_QTY 	= PrepareSQLnum(tmpStkProc.Prc_QTY,'Prc_QTY',-5)
						
					CASE tmpStkProc.Process_ID = 'INCOMING' 
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_QTY 	= PrepareSQLnum(tmpStkProc.Prc_QTY,'Prc_QTY',-5)
						
					CASE tmpStkProc.Process_ID = 'NOT2HPA' 
						lNOT2HPA = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_QTY 	= PrepareSQLnum(tmpStkProc.Prc_QTY,'Prc_QTY',-5)
		
					CASE tmpStkProc.Process_ID = 'PARTRECV' 
						lPARTRECV = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_QTY 	= PrepareSQLnum(tmpStkProc.Prc_QTY,'Prc_QTY',-5)
					ENDCASE
		
				ENDSCAN
		
			ENDIF
			USE IN tmpStkProc
		ENDIF
		
		****************************************************************************
		*get PO QTY and PU from POitem here
		
		PRIVATE nPO_QTY, nPO_P, nPU
		nPO_QTY = 0
		nPO_P = 0
		nPU = 0
		
		IF USED('tmpPOqty')	
			USE IN tmpPOqty
		ENDIF
		
		cSQL = " SELECT Order_QTY, Order_P, Order_PU "
		cSQL = cSQL + " FROM dbo.PurchaseOrder WITH (NOLOCK) "
		cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOqty')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOqty')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOqty')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpPOqty')
			IF RECCOUNT('tmpPOqty') > 0
				nPO_QTY = PrepareSQLnum(tmpPOqty.Order_QTY,'Order_QTY',-5)
				nPO_P	= PrepareSQLnum(tmpPOqty.Order_P,'Order_P',-5)
				nPU 	= PrepareSQLnum(tmpPOqty.Order_PU,'Order_PU',-1)
			ENDIF
			USE IN tmpPOqty
		ENDIF
		
		****************************************************************************
		*recheck data
		*nQTY_Diff, nOrder_QTY, nPastTotal, nActualW
		*nPO_OrigQTY, nPrc_QTY
		*nPO_QTY, nPU
		
		
		****************************************************************************
		*before Deleteing the Process, collect data to Create new Master, Detail, Process for remaining QTY
		
		PRIVATE cSOitem,cPOitem,cSalesPerson,dtStartDate,dDueDate,cComment,cProcess_ID,nReceivingID
		cSOitem = Proper_SO_item(ThisForm.cSOitem)
		cPOitem = Proper_PO_item(ThisForm.cPOitem)
		cSalesPerson = ''
		dtStartDate = DATE()
		dDueDate = DATE()+2 
		cComment = ''
		cProcess_ID	= "INCOMING"
		nReceivingID = ThisForm.nReceivingID
		
		PRIVATE cProcessor,cAllowSub
		cProcessor = RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
		cAllowSub	= 'N'
		
		PRIVATE cForm,nPU
		cForm = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nPU =  GetPUfromForm(cForm, ThisForm.nConnHandle)  
		cUnit = GetUNITfromFORM(cForm, ThisForm.nConnHandle)
		
		PRIVATE nQTY_P,nQTY,nPounds
		nQTY_P	= 0
		nQTY	= 0
		nPounds = nQTY_Diff
		
		*!*	********************
		*!*	*Get Pounds
		*!*	DO CASE
		*!*	CASE nPU = 1
		*!*		nPounds = PrepareSQLnum(nQTY_Diff,'Pounds',9,1)
		*!*	CASE nPU = 2
		*!*		*QTY is Feet
		*!*		nPounds = 0
		*!*	CASE nPU = 3
		*!*		*QTY is PC
		*!*		nPounds = 0
		*!*	ENDCASE
		
		PRIVATE nID_Detail, nID_Detail_Process
		nID_Detail = 0
		nID_Detail_Process = 0
		
		PRIVATE nWO, nWO_Detail
		nWO			= 0
		nWO_Detail	= ThisForm.nWO_Detail
		PRIVATE lFoundOldPrc
		lFoundOldPrc = .F.
		
		*Retrieve INCOMING Process Detail before Delete
		IF USED('tmpStkProc')	
			USE IN tmpStkProc
		ENDIF
		
		cSQL = "SELECT * "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH (NOLOCK) "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH (NOLOCK) "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WITH (NOLOCK) "
		ENDCASE
		cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		cSQL = cSQL + " AND ( [Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PARTRECV' )"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStkProc')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpStkProc')	
			IF RECCOUNT('tmpStkProc') > 0
				lFoundOldPrc = .T.
				
				cSOitem	= PrepareSQLtxt(tmpStkProc.SOitem,'SOitem',10)
				ThisForm.cSOitem = cSOitem
				cPOitem	= PrepareSQLtxt(tmpStkProc.PO_item,'POitem',12)
				cSalesPerson = PrepareSQLtxt(tmpStkProc.SalesPerson,'SalesPerson',20)
				dtStartDate = PrepareSQLdateTime(tmpStkProc.StartDate,'StartDate')
				dDueDate = PrepareSQLdate(tmpStkProc.DueDate,'DueDate')
				cComment = PrepareSQLtxt( tmpStkProc.Comment,'Comment',100)
				cProcess_ID	= PrepareSQLtxt(tmpStkProc.Process_ID,'Process_ID',10)
				
				nPU		= PrepareSQLnum(tmpStkProc.PU,'PU',-1)
				*nQTY_P	= PrepareSQLnum(tmpStkProc.QTY_P,'QTY_P',-5)	&&Could implement S_P (Price per Unit)
				nQTY	= PrepareSQLnum(tmpStkProc.Prc_QTY,'Prc_QTY',-5)
				IF nQTY = 0	&&Prc_Quantity (Process QTY, not Ordered QTY)
					nQTY	= PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
				ENDIF
				nPounds = PrepareSQLnum(tmpStkProc.Pounds,'Pounds',9,1)		&&use calculated
				nID_Detail			= PrepareSQLnum(tmpStkProc.ID_Detail,'ID_Detail',-3)
				nID_Detail_Process	= PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_Detail_Process',-3)
				nReceivingID		= PrepareSQLnum(tmpStkProc.ReceivingID,'ReceivingID',-3)
				nWO			= PrepareSQLnum(tmpStkProc.WO,'WO',-3)
				nWO_Detail	= PrepareSQLnum(tmpStkProc.WO_Detail,'WO_Detail',-3)
				
				IF RECCOUNT('tmpStkProc') > 1
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Many results "+ALLTRIM(RECCOUNT('tmpStkProc'))+CHR(13)+cSQL )
				ENDIF
			
			ENDIF
			USE IN tmpStkProc
		ENDIF
		
		
		****************************************
		IF NOT lFoundOldPrc
			*MESSAGEBOX("Could not find data"+CHR(13)+"for [Process_ID]='INCOMING'"+CHR(13)+"Cannot create the new Process!"+CHR(13)+"This procedure will not continue.",0+16,"Error")
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not find data"+CHR(13)+"for [Process_ID]='INCOMING'"+CHR(13)+"Create the Process!"+CHR(13)+cSQL)
		*	RETURN .F.
		
			IF ThisForm.nReceivingID > 0
				*get from Receiving!
				IF USED('tmpReceiving2')	
					USE IN tmpReceiving2
				ENDIF
		
				cSQL = "SELECT * "
				cSQL = cSQL + " FROM dbo.Receiving "
				cSQL = cSQL + " WHERE ID = "+STR(ThisForm.nReceivingID)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceiving2')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceiving2')
				ENDDO
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpReceiving2')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('tmpReceiving2')	
					IF RECCOUNT('tmpReceiving2') > 0
						*lFoundOldPrc = .T.
						
						cSOitem	= PrepareSQLtxt(tmpReceiving2.SOitem,'SOitem',10)
						ThisForm.cSOitem = cSOitem
						cPOitem	= PrepareSQLtxt(tmpReceiving2.POitem,'POitem',12)
						cSalesPerson = PrepareSQLtxt(cProcessor ,'SalesPerson',20)
						dtStartDate = PrepareSQLdateTime(tmpReceiving2.Date,'StartDate')
						dDueDate = PrepareSQLdate(tmpReceiving2.Received,'DueDate')
						cComment = PrepareSQLtxt( tmpReceiving2.Comments,'Comment',100)
		
						cProcess_ID	= "INCOMING"
						cProcessor	= RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
						cAllowSub	= 'N'
						*nPU		= PrepareSQLnum(tmpReceiving2.PU,'PU',-1) &&Use from Screen
						*nQTY_P	= PrepareSQLnum(tmpReceiving2.QTY_P,'QTY_P',-5)	&&Could implement S_P (Price per Unit)
						
						**QTY needs to be by PU!
						DO CASE
						CASE nPU = 1
							nQTY = PrepareSQLnum(tmpReceiving2.ActualW,'ActualW',9,1)	
						CASE nPU = 2	&&FT
							nQTY = 1	&& --- NOT PROGRAMED YET !!!
						CASE nPU = 3	&&PC
							nQTY = PrepareSQLnum(tmpReceiving2.Pieces,'Pieces',10,0)
						ENDCASE
						
						nQTY_Diff = nQTY
						
						nPounds		= PrepareSQLnum(tmpReceiving2.ActualW,'ActualW',9,1)
						nID_Detail			= PrepareSQLnum(tmpReceiving2.ID_Detail,'ID_Detail',-3)
						nID_Detail_Process	= 0
						nReceivingID		= PrepareSQLnum(tmpReceiving2.ID,'ReceivingID',-3)
				
						nWO			= PrepareSQLnum(tmpReceiving2.WO,'WO',-3)
						nWO_Detail	= PrepareSQLnum(tmpReceiving2.WO_Detail,'WO_Detail',-3)
						
					ENDIF
					USE IN tmpReceiving2
				ENDIF
						
			ENDIF
		ENDIF
			
			
		***********************************************************************************************
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		* Manual transactions
		***********************************************************************************************
		
		PRIVATE lRollback, lOK
		lRollback = .F.
		lOK = .T.
		
		************************
		IF lFoundOldPrc
			IF lClearIncomingProcess
				ThisForm.Del_IncomProc()
			ENDIF
		ENDIF
		
		***************************************************************************************
		*Create new Stock, Broker or WIP records for new balance after Receive!
		
		
		*get Old ID to Clone
		PRIVATE nOld_ID	
		PRIVATE nOld_ID_Detail  &&get Old ID_Detail to Clone
		nOld_ID = 0
		nOld_ID_Detail = 0
		
		IF lFoundOldPrc
			IF USED('tmpOldID')	
				USE IN tmpOldID
			ENDIF
		
			cSQL = "SELECT D.ID, D.ID_Detail "
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL + " FROM dbo.StockLst_Process P WITH (NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail"
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH (NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail"
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH (NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail"
			ENDCASE
			cSQL = cSQL + " WHERE ( P.[Process_ID]='INCOMING' OR P.[Process_ID]='NOT2HPA' OR P.[Process_ID]='PARTRECV' )"
			IF ThisForm.nWO_Detail > 0
				cSQL = cSQL + " AND P.WO_Detail = "+STR(ThisForm.nWO_Detail)
			ENDIF
			IF ThisForm.cPOitem <> Proper_PO_item('')
				cSQL = cSQL + " AND P.PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOldID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOldID')
			ENDDO
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpOldID')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
			ENDIF
		
			IF USED('tmpOldID')	
				IF RECCOUNT('tmpOldID') > 0
					nOld_ID			= PrepareSQLnum(tmpOldID.ID,'ID',-3)
					nOld_ID_Detail	= PrepareSQLnum(tmpOldID.ID_Detail,'ID_Detail',-3)
					IF RECCOUNT('tmpOldID') > 1
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Many results "+ALLTRIM(RECCOUNT('tmpOldID'))+CHR(13)+cSQL )
					ENDIF
				ENDIF
				USE IN tmpOldID
			ENDIF
		
			IF nOld_ID = 0
				MESSAGEBOX("Could not retrieve old data"+CHR(13)+"Cannot create the new Master/Detail!"+CHR(13)+"This procedure will not continue.",0+16,"Error")
				*RETURN .F.
				lFoundOldPrc = .F.
			ENDIF
		ENDIF
		
		*************************************
		
		IF NOT lFoundOldPrc
			*No INCOMING process
			*get an Old ID to Clone by POitem in Master
			IF ThisForm.cPOitem <> Proper_PO_item('')
				IF USED('tmpOldID')	
					USE IN tmpOldID
				ENDIF
		
				cSQL = "SELECT M.ID, 'S' AS TBL "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH (NOLOCK) "
				cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT M.ID, 'B' AS TBL "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH (NOLOCK) "
				cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT M.ID, 'W' AS TBL "
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH (NOLOCK) "
				cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOldID')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOldID')
				ENDDO
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpOldID')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('tmpOldID')	
					IF RECCOUNT('tmpOldID') > 0
						SCAN 
							IF ThisForm.cTBL = PrepareSQLtxt(tmpOldID.TBL,'TBL',1)
								nOld_ID	= PrepareSQLnum(tmpOldID.ID,'ID',-3)
								cTBL 	= PrepareSQLtxt(tmpOldID.TBL,'TBL',1)
								EXIT
							ENDIF
						ENDSCAN
						
						nOld_ID_Detail	= 0
						IF RECCOUNT('tmpOldID') > 1
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Many results "+ALLTRIM(STR(RECCOUNT('tmpOldID')))+CHR(13)+cTBL+CHR(13)+cSQL )
						ENDIF
						
					ENDIF
					USE IN tmpOldID
				ENDIF
		
				IF nOld_ID = 0
					MESSAGEBOX("Could not retrieve old data"+CHR(13)+"Cannot create the new Master/Detail!"+CHR(13)+"This procedure will not continue.",0+16,"Error")
					*RETURN .F.
					lFoundOldPrc = .F.
				ENDIF		
			
			ENDIF
		ENDIF
		
		********************
		PRIVATE nNewID, nNewID_Detail
		nNewID = 0
		nNewID_Detail = 0
		
		********************
		IF NOT lFoundOldPrc
			*No INCOMING process
			IF nOld_ID > 0 AND ThisForm.nReceivingID > 0
				*Create new MASTER Stock record for new balance for Receive without 'INCOMING' from OLD_ID
				
				nNewID = ThisForm.Lst_Master_Clone(nOld_ID,nQTY_Diff)
				IF nNewID > 0
					PRIVATE cHeat
					cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
					DO CASE
					CASE ThisForm.cTBL = "S"
						cSQL = "UPDATE dbo.StockLst_Master SET "
					CASE ThisForm.cTBL = "B"
						cSQL = "UPDATE dbo.BrokerLst_Master SET "
					CASE ThisForm.cTBL = "W"
						cSQL = "UPDATE dbo.WIPLst_Master SET "
					ENDCASE
					cSQL = cSQL+" Heat = '"+cHeat+"'"
					IF ThisForm.cPOitem <> Proper_PO_item('')
						cSQL = cSQL+", PO_item= '"+ThisForm.cPOitem+"'"
					ENDIF
					IF ThisForm.nWO_Detail > 0
						cSQL = cSQL+", WO_Detail="+STR(ThisForm.nWO_Detail)+""
					ENDIF
					*cSQL = cSQL+",Paid,Mill
					cSQL = cSQL+", From_ID = "+STR(nOld_ID)+""
					cSQL = cSQL+" WHERE ID ="+STR(nNewID)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						
						lRollback = .T.
					ENDDO
					IF nSQLEXEC < 0
						SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
						lRollback = .T.
						lOK = .F.
					ENDIF
					
					IF lOK 
						nOld_ID_Detail = getHighestID_DetailbyID(nOld_ID,ThisForm.cTBL,ThisForm.nConnHandle)
						nNewID_Detail = ThisForm.Lst_Detail_Clone(nNewID, nOld_ID_Detail, nQTY_Diff)
					ENDIF
					
					IF nNewID_Detail > 0	
					
						*UPDATE ID_Detail with the current data!  
						DO CASE
						CASE ThisForm.cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Detail SET "
						CASE ThisForm.cTBL = "B"
							cSQL = "UPDATE dbo.BrokerLst_Detail SET "
						CASE ThisForm.cTBL = "W"
							cSQL = "UPDATE dbo.WIPLst_Detail SET "
						ENDCASE
						
						PRIVATE nPieces
						nPieces	= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
						cSQL = cSQL+ " PC="+STR(nPieces)+""
						
						PRIVATE nDim1,nDim2,nDim3
						nDim1	= PrepareSQLnum(ThisForm.txtThck.Value,'Dim1',18,4)
						nDim2	= PrepareSQLnum(ThisForm.txtSz2.Value,'Dim2',18,4)
						nDim3	= PrepareSQLnum(ThisForm.txtSz3.Value,'Dim3',18,4)
				
						*cSQL = cSQL+ "Size_H="+STR(nSize_H,9,4)+""
						cSQL = cSQL+ ",Dim1="+STR(nDim1,18,4)+""
						*cSQL = cSQL+ ",Size_L="+STR(nSize_L,9,4)+""
						cSQL = cSQL+ ",Dim2="+STR(nDim2,18,4)+""
						cSQL = cSQL+ ",Dim3="+STR(nDim3,18,4)+""
						cSQL = cSQL+ ",Weight="+STR(nPounds,18,4)+""
						*cSQL = cSQL+ ",Descript='"+cDescript+"'"
						*cSQL = cSQL+ ",Length='"+cLength+"'"
						*cSQL = cSQL+ ",CostValue="+STR(nCostValue,18,4)+""
						*cSQL = cSQL+ ",FloorStatus='"+cFloorStatus+"'"
						*cSQL = cSQL+ ",class='"+cClass+"'"
						cSQL = cSQL+ ",Unit='"+cUnit+"'"
						*cSQL = cSQL+ ",[Location]='"+cLocation+" "
						cSQL = cSQL+ ",ReceivingID="+STR(nReceivingID)+""
						*cSQL = cSQL+ ",InvoiceValue="+STR(nInvoiceValue,18,4)+""
						*IF lMarkInvCheck
							cSQL = cSQL+ ",InvCheck=GetDate()"
						*ENDIF
						PRIVATE nStockLst_QTY, nStockLst_P, nS_Total
						**QTY needs to be by PU!
						DO CASE
						CASE nPU = 1
							nStockLst_QTY = PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)	
						CASE nPU = 2	&&FT
							nStockLst_QTY = 1	&& --- NOT PROGRAMED YET !!!
						CASE nPU = 3	&&PC
							nStockLst_QTY = PrepareSQLnum(thisForm.txtPieces.Value,'Pieces',10,0)
						ENDCASE
						*nStockLst_P
						*nS_Total
						
						cSQL = cSQL+",S_QTY = " + STR(nStockLst_QTY,18,4) + ""
						*cSQL = cSQL+",S_P = " + STR(nStockLst_P,18,4) + ""
						*cSQL = cSQL+",S_Total = " + STR(nS_Total,18,4) + ""
						cSQL = cSQL+",S_PU = " + STR(nPU) + ""
						cSQL = cSQL+",Prime = 1"
						
						cSQL  = cSQL+ " WHERE ID_Detail="+STR(nNewID_Detail)
					
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							
							lRollback = .T.
						ENDDO
						IF nSQLEXEC < 0
							SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
							lRollback = .T.
							lOK = .F.
						ENDIF
					
						IF lOK
							*Receive this Process.
							*
							*
							*
							*
							*
							*
							*
							*
							*
							*
							
						ENDIF
								
					ENDIF
				ENDIF
				
				**************************************
				IF lOK 
					*now Calculate missing QTY for next routine!
					*
					*
					*
					*
					*
					*
					*
					*
					
					*
					*
					*
					
					*
				ENDIF
			ENDIF
		ENDIF
		********************
		******************************
		********************
		PRIVATE lCommit 
		lCommit = .T.
		
		********************
		*Create new MASTER Stock, Broker or WIP record for new balance after Receive!
		*nOld_ID
		nNewID = ThisForm.Lst_Master_Clone(nOld_ID,nQTY_Diff)
		
		IF nNewID = 0
			MESSAGEBOX("Could not retreive old data"+CHR(13)+"Cannot create the new Master/Detail!"+CHR(13)+"This procedure will not continue.",0+16,"Error")
			lCommit = .F.
			RETURN .F.
		ENDIF
		
		********************
		*Create new DETAIL Stock, Broker or WIP record for new balance after Receive!
		IF lCommit 
			*nOld_ID_Detail
			nOld_ID_Detail = getHighestID_DetailbyID(nOld_ID,ThisForm.cTBL,ThisForm.nConnHandle)
			nNewID_Detail = ThisForm.Lst_Detail_Clone(nNewID, nOld_ID_Detail, nQTY_Diff)
			
			IF nNewID_Detail = 0
				MESSAGEBOX("Could not retrieve old data"+CHR(13)+"Cannot create the new Master/Detail!"+CHR(13)+"This procedure will not continue.",0+16,"Error")
				lCommit = .F.
				RETURN .F.
			ENDIF
		ENDIF
		
		****
		IF nNewID_Detail > 0
			*UPDATE ID_Detail with current data!  
			*Clone was with old data
		*!*				DO CASE
		*!*				CASE ThisForm.cTBL = "S"
		*!*					cSQL = "UPDATE dbo.StockLst_Detail SET "
		*!*				CASE ThisForm.cTBL = "B"
		*!*					cSQL = "UPDATE dbo.BrokerLst_Detail SET "
		*!*				CASE ThisForm.cTBL = "W"
		*!*					cSQL = "UPDATE dbo.WIPLst_Detail SET "
		*!*				ENDCASE
		*!*					
		*!*				cSQL = cSQL+ "ID="+STR(m.nID1)+","
		*!*				cSQL = cSQL+ "PC="+STR(nPC)+","
		*!*				cSQL = cSQL+ "Size_H="+STR(nSize_H,9,4)+","
		*!*				cSQL = cSQL+ "Dim1="+STR(nDim1,18,4)+","
		*!*				cSQL = cSQL+ "Size_L="+STR(nSize_L,9,4)+","
		*!*				cSQL = cSQL+ "Dim2="+STR(nDim2,18,4)+","
		*!*				cSQL = cSQL+ "Dim3="+STR(nDim3,18,4)+","
		*!*				cSQL = cSQL+ "Weight="+STR(nWeight,18,4)+","
		*!*				cSQL = cSQL+ "Descript='"+cDescript+"',"
		*!*				cSQL = cSQL+ "Length='"+cLength+"',"
		*!*				cSQL = cSQL+ "CostValue="+STR(nCostValue,18,4)+","
		*!*				cSQL = cSQL+ "FloorStatus='"+cFloorStatus+"',"
		*!*				cSQL = cSQL+ "class='"+cClass+"',"
		*!*				cSQL = cSQL+ "[Location]='"+cLocation+"' "
		*!*				cSQL = cSQL+ ",ReceivingID="+STR(nReceivingID)
		*!*				cSQL = cSQL+ ",InvoiceValue="+STR(nInvoiceValue,18,4)
		*!*				IF lMarkInvCheck
		*!*					cSQL = cSQL+ ",InvCheck=GetDate()"
		*!*				ENDIF
		*!*				cSQL = cSQL+",S_QTY = " + STR(nStockLst_QTY,18,4) + ""
		*!*				cSQL = cSQL+",S_P = " + STR(nStockLst_P,18,4) + ""
		*!*				cSQL = cSQL+",S_Total = " + STR(nS_Total,18,4) + ""
		*!*				cSQL = cSQL+",S_PU = " + STR(nS_PU) + ""
		*!*				cSQL = cSQL+",Prime = "+IIF(lPrime,'1','2')
		*!*				
		*!*				cSQL  = cSQL+ " WHERE ID_Detail="+STR(m.nID_Detail)
		*!*			
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		*!*					
		*!*					lRollback = .T.
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0
		*!*					SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
		*!*					lRollback = .T.
		*!*					lOK = .F.
		*!*				ENDIF
					
		ENDIF
		
		
		********************
		*Create new INCOMING PROCESS Stock, Broker or WIP record for new balance after Receive!
		IF lCommit 
		
			IF USED('tmpID_Detail_Process')
				USE IN tmpID_Detail_Process
			ENDIF
			SELECT 0
		
			cSQLi = "EXEC dbo.p_Lst_Process_ins "	
			cSQLi = cSQLi + " @TBL = '"+ThisForm.cTBL+"'"
			cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
			cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
			cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
			cSQLi = cSQLi + ",@StartDate = '"+IIF(EMPTY(dtStartDate),'',TTOC(dtStartDate))+"'"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
			cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"   &&cProcess_ID	= "INCOMING"
			cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"	
			cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"		&&cAllowSub = 'N'
			cSQLi = cSQLi + ",@PU = "+STR(nPU)
			cSQLi = cSQLi + ",@QTY = "+STR(nQTY_Diff,18,4)
			cSQLi = cSQLi + ",@Pounds= "+STR(nPounds,9,1)
			cSQLi = cSQLi + ",@ID_Detail = "+STR(nNewID_Detail)+""
			cSQLi = cSQLi + ",@ReceivingID = 0"		&&Should be 0
			cSQLi = cSQLi + ",@WO = "+STR(nWO)+""
			cSQLi = cSQLi + ",@WO_Detail = "+STR(nWO_Detail)+""
			cSQLi = cSQLi + ",@Prc_QTY = "+STR(nQTY_Diff,18,4)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		
			IF nSQLEXEC < 0
				*retry
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				*TrackError(cSQLi,"p_Lst_Process_ins",PROGRAM(),LINENO(1))
				RecordError(nSQLEXEC,"p_Lst_Process_insFailed" ,PROGRAM(),LINENO(1),cSQL1 )
				lCommit = .F.
			ELSE
				IF USED('tmpID_Detail_Process')
					IF RECCOUNT('tmpID_Detail_Process') > 0
						nProcessID = PrepareSQLnum(tmpID_Detail_Process.EXP,'ProcessID',-3)
						IF nProcessID > 0
		
							PRIVATE cText
							cText = "INFO: Created Process for ReceivingID "+ALLTRIM(STR(ThisForm.nReceivingID))+' Receive_Edit.ReceivingSaveID_Master'+"ProcessID="+STR(nProcessID)+" StockTable="+ThisForm.cTBL+" PO item="+cPOitem
							MESSAGEBOX( "Created new Process"+CHR(13)+"ProcessID="+STR(nProcessID )+CHR(13)+"StockTable="+ThisForm.cTBL+CHR(13)+"PO item="+cPoItem,0+48,"INFO: Created Process for ReceivingID "+ALLTRIM(STR(nReceivingID)) )
							TrackMess(cText)
						ENDIF
					ENDIF
				ENDIF
				*\Progs\ErrorHandlerlog(0,"ProcessID="+STR(nProcessID)+" StockTable="+ThisForm.cTBL+" PO item="+pPOitem,"INFO Created Process for ReceivingID "+ALLTRIM(STR(ThisForm.nReceivingID)),'Receive_Edit.cmdGood.Valid',277)
			ENDIF
		ENDIF
		
		******************************************
		IF lCommit 
			*	MESSAGEBOX("Inserted new Balance of Partial Receive screen here.")
			*Create PartRecv process with new QTY Balance and New ID_Detail.
			 	*Calls THISFORM.Create_Incoming_Process(cTableName,nTableID_Detail,nPounds)
		
		ELSE
		
		ENDIF
		
		*!*	IF lRollback 
		*!*		MESSAGEBOX("SQL Transaction Rolled Back",0,"Could not save!")
		*!*		=SQLROLLBACK(ThisForm.nConnHandle)
		*!*		TrackError("Shop_StockLst_Edit-Modify StockLst_Detail-Save: Could not save!","SQL Transaction Rolled Back",PROGRAM(),LINENO(1))
		*!*		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1) 
		*!*		RETURN .F.
		*!*	ELSE
		*!*		WAIT WINDOW "Saved!" NOWAIT
		*!*		=SQLCOMMIT(ThisForm.nConnHandle)
		*!*		
		*!*	ENDIF
		
		***************************************************************************************
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		***************************************************************************************
		
		
		
		
		 
		ThisForm.lReturn = 1
		ThisForm.Release
		
	ENDPROC

	PROCEDURE frmShowReceived_Ordered.cmdGoodCmplt.Valid
		PRIVATE nQTY_Diff, nOrder_QTY, nMess, nPastTotal, nActualW
		nQTY_Diff	= PrepareSQLnum(ThisForm.txtQTY_Diff.Value,'QTY_Diff',9,1)
		nOrder_QTY 	= PrepareSQLnum(ThisForm.txtOrder_QTY.Value,'Order_QTY',9,1)
		nPastTotal 	= PrepareSQLnum(ThisForm.txtPastTotal.Value,'PastTotal',9,1)
		nActualW	= PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)
		
		IF (( nPastTotal + nActualW +100) * 1.2 < (nOrder_QTY+100) ) OR (( nPastTotal + nActualW + 100 ) > (nOrder_QTY+100) * 1.2 )
			nMess = MESSAGEBOX("The Quantity Ordered to Quantity Received is more the 15% off!"+CHR(13)+CHR(13)+"Are you sure you want to make this as a COMPLETE receive?",4+32,"Complete?")
			IF nMess != 6
				RETURN .F.
			ELSE
				TrackMess("The POitem: '"+ThisForm.cPOitem+"' was for a QTY of "+ALLTRIM(STR(nOrder_QTY))+"."+CHR(13)+"The QTY this Received is "+ALLTRIM(STR(nActualW))+"."+CHR(13)+"The total QTY Received is "+ALLTRIM(STR(nPastTotal))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisForm.nReceivingID))+"." +CHR(13)+"User override the 15% Error message and saved as complete.")
			ENDIF
		ENDIF
		
		*****************************
		PRIVATE lClearIncomingProcess
		lClearIncomingProcess = ThisForm.Update_POStatus(.T.)  &&Complete POitem
		
		*****************************
		ThisForm.Check_PartRecv("CMPLT")
		
		*****************************
		IF lClearIncomingProcess
			ThisForm.Del_IncomProc()
		ENDIF
		
		*****************************
		ThisForm.lReturn = 2
		ThisForm.Release
		
	ENDPROC

	PROCEDURE frmShowReceived_Ordered.cmdJustEdit.Valid
		
		*****************************
		PRIVATE lClearIncomingProcess
		lClearIncomingProcess = ThisForm.Update_POStatus(.F.)
		
		*****************************
		ThisForm.Check_PartRecv("EDIT")
		
		
		*Check to see if the Receive made it to StockLst
		*-- This is done in Receive_Edit.SaveAdd()
		
		*******************
		ThisForm.lReturn = 1
		ThisForm.Release
		
	ENDPROC

	PROCEDURE frmShowReceived_Ordered.grdReceive.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.edtAllDescription.Value = tmpReceive.Description
	ENDPROC

	PROCEDURE frmShowReceived_Ordered.grdReceive.Init
		*This.SetAll("dynamicbackcolor","IIF(cancelled, RGB(255,220,220), RGB(255,255,255))", "Column")
	ENDPROC

