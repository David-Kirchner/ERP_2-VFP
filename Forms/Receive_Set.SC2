	PROCEDURE frmPORecvStock.DIM11.Valid
		PRIVATE m.num
		m.Num = PrepareSQLNum(This.Value,'Dim1',18,4)
		IF TYPE("m.num") = "C"
			m.num = VAL(m.num)
		ENDIF
		IF m.num > 0
			PRIVATE nSize_H1, nSize_L1 
			nSize_H1 = PrepareSQLNum(ThisForm.Size_H1.Value,'Size_H1',9,4)
			nSize_L1 = PrepareSQLNum(ThisForm.Size_L1.Value,'Size_L1',9,4)
			IF nSize_H1 > 0
				IF nSize_H1  < This.Value
					*MESSAGEBOX( "The High Tolerence is usually above the DIM 1.",0,"Caution")
					WAIT WINDOW "The High Tolerence is usually above the DIM 1" NOWAIT
				ENDIF
			ENDIF
			IF nSize_L1 > 0
				IF nSize_L1 > PrepareSQLnum(This.Value,'DIM1',10,4)
					*MESSAGEBOX( "The Low Tolerence is usually below the DIM 1.",0,"Caution")
					WAIT WINDOW "The High Tolerence is usually below the DIM 1" NOWAIT
				ENDIF
			ENDIF
		ELSE
			IF m.num < 0
				MESSAGEBOX( "The DIM 1 is not be be negative.",0,"Error")
			ENDIF
		ENDIF
		ThisForm.POrecvStock_Calc()  &&Calcs Weight and QTY
	ENDPROC

