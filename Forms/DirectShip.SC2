DEFINE CLASS frmdirectship AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Command1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Quit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblSOitem" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtSOitem" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblPOitem" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtPOitem" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblWO" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtWO" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Command4" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: cpoitem
		*p: csoitem
		*p: ctbl
		*p: nid_detail_process
		*p: nwo
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		Caption = "Direct Ship"
		ControlBox = .F.
		cpoitem = ''
		csoitem = .F.
		ctbl = ''
		DataSession = 2
		Desktop = .T.
		DoCreate = .T.
		Icon = graphics\earth-globe.ico
		MDIForm = .T.
		Name = "frmDirectShip"
		nid_detail_process = 0
		nwo = 0
		ShowTips = .T.
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Command1' AS commandbutton WITH ;
		Caption = "Command1", ;
		Height = 1, ;
		Left = 36, ;
		Name = "Command1", ;
		Top = 12, ;
		Visible = .F., ;
		Width = 13
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command2' AS commandbutton WITH ;
		Caption = "Print", ;
		Enabled = .F., ;
		Height = 27, ;
		Left = 180, ;
		Name = "Command2", ;
		Top = 216, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command3' AS commandbutton WITH ;
		Caption = "Yes", ;
		Enabled = .F., ;
		Height = 27, ;
		Left = 12, ;
		Name = "Command3", ;
		Top = 180, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Command4' AS commandbutton WITH ;
		Caption = "No", ;
		Enabled = .F., ;
		Height = 27, ;
		Left = 108, ;
		Name = "Command4", ;
		Top = 180, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		Caption = "Does this match the Vendors Invoice?", ;
		Height = 17, ;
		Left = 4, ;
		Name = "Label1", ;
		Top = 166, ;
		Width = 216
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label2' AS label WITH ;
		Caption = "was Direct Shipped to", ;
		Height = 17, ;
		Left = 8, ;
		Name = "Label2", ;
		Top = 51, ;
		Width = 124
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label3' AS label WITH ;
		Caption = "at", ;
		Height = 17, ;
		Left = 9, ;
		Name = "Label3", ;
		Top = 66, ;
		Width = 27
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblPOitem' AS label WITH ;
		Caption = "PO item ", ;
		Height = 17, ;
		Left = 115, ;
		Name = "lblPOitem", ;
		Top = 6, ;
		Visible = .F., ;
		Width = 89
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblSOitem' AS label WITH ;
		Caption = "SO item ", ;
		Height = 17, ;
		Left = 7, ;
		Name = "lblSOitem", ;
		Top = 6, ;
		Visible = .F., ;
		Width = 89
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblWO' AS label WITH ;
		Caption = "Work Order", ;
		Height = 17, ;
		Left = 241, ;
		Name = "lblWO", ;
		Top = 6, ;
		Visible = .F., ;
		Width = 77
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Quit' AS commandbutton WITH ;
		Caption = "Return", ;
		Height = 27, ;
		Left = 276, ;
		Name = "Quit", ;
		Top = 216, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'txtPOitem' AS textbox WITH ;
		Height = 23, ;
		Left = 108, ;
		Name = "txtPOitem", ;
		Top = 24, ;
		Visible = .F., ;
		Width = 84
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtSOitem' AS textbox WITH ;
		Height = 23, ;
		Left = 0, ;
		Name = "txtSOitem", ;
		Top = 24, ;
		Visible = .F., ;
		Width = 84
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtWO' AS textbox WITH ;
		Height = 23, ;
		Left = 240, ;
		Name = "txtWO", ;
		Top = 24, ;
		Visible = .F., ;
		Width = 84
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS pSOitem, pPOitem, pWO, pTBL, pID_Detail_Process
		*PARAMETERS pTBL, pID_Detail, pID_Detail_Process, pSOitem, pPOitem, pWO, pWO_Detail, pRID, pHeat
		
		*DO FORM Forms\DirectShip WITH cSOitem, ThisForm.cPOitem, nWO, cTBL, nID_Detail_Process
		
		IF VARTYPE(pSOitem) = "C"
			ThisForm.cSOitem = Proper_SO_item(pSOitem)
			ThisForm.txtSOitem.Value = ThisForm.cSOitem
			
			ThisForm.txtSOitem.Visible = .T.
			ThisForm.lblSOitem.Visible = .T.
		ENDIF
		
		IF VARTYPE(pPOitem) = "C"
			ThisForm.cPOitem = Proper_PO_item(pPOitem)
			ThisForm.txtPOitem.Value = ThisForm.cPOitem
			
			ThisForm.txtPOitem.Visible = .T.
			ThisForm.lblPOitem.Visible = .T.
		ENDIF
		
		IF VARTYPE(pWO) = "N"
			ThisForm.nWO = PrepareSQLnum(pWO,'WO',-3)
			ThisForm.txtWO.Value = ThisForm.nWO
			
			ThisForm.txtWO.Visible = .T.
			ThisForm.lblWO.Visible = .T.
		ENDIF
		
		IF VARTYPE(pTBL) = "C"
			ThisForm.cTBL = PrepareSQLtxt(pTBL,'TBL',1)
		ELSE
			TrackError("Error","TableName parameter Not Found","DirectShip:Init",LINENO(1))
			RETURN .F.
		ENDIF
		
		IF VARTYPE(pID_Detail_Process) = "N"
			ThisForm.nID_Detail_Process = PrepareSQLnum(pID_Detail_Process,'ID_Detail_Process',-3)
		ELSE
			TrackError("Error","pID_Detail_Process parameter Not Found","DirectShip:Init",LINENO(1))
			RETURN .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_QUOTES ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpStkSum')
			USE IN tmpStkSum
		ENDIF 
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
	ENDPROC

	PROCEDURE Command2.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE Command3.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE Command4.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE Quit.Click
		ThisForm.Release
	ENDPROC

ENDDEFINE
