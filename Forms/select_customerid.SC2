	ADD OBJECT 'txtSoldTo' AS textbox WITH ;
		Height = 23, ;
		Left = 128, ;
		Name = "txtSoldTo", ;
		Top = 276, ;
		Width = 127
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS cTable, pcCompany, pnAddrCode, pConnHandle
		*DO FORM Forms\select_CustomerID WITH "SoldAddr", SalesQuote.company, ThisForm.SoldAddr, ThisForm.nConnHandle  TO cCustomerID
		*DO FORM Forms\select_CustomerID WITH "SoldAddr", "COMPANY", 12354, 0  TO cCustomerID
		
		IF TYPE("cTable") = "L"
			MESSAGEBOX("No table name parameter.")
			cTable = ""
		ENDIF
		
		
		IF TYPE("pConnHandle") = "N"
			IF pConnHandle > 0
				ThisForm.nConnHandle = pConnHandle
			ELSE
				ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
				IF ThisForm.nConnHandle > 0
					ThisForm.CloseConn = .T.
				ELSE
					MESSAGEBOX("Could not connect to SQL")
					RETURN ''
				ENDIF
			ENDIF		
		ELSE
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			IF ThisForm.nConnHandle > 0
				ThisForm.CloseConn = .T.
			ELSE
				MESSAGEBOX("Could not connect to SQL")
				RETURN ''
			ENDIF
		ENDIF
		
		PRIVATE cCompany
		cCompany = ''
		IF VARTYPE(pcCompany) = "C"
			IF NOT EMPTY(pcCompany)
				ThisForm.txtCompany.Value = pcCompany
				ThisForm.lblPCompany.Caption = pcCompany
				cCompany = pcCompany
			ENDIF
		ENDIF
		
		PRIVATE nAddrCode
		nAddrCode = 0
		
		IF VARTYPE(pnAddrCode) = "N"
			IF NOT EMPTY(pnAddrCode)
				PRIVATE cSoldToCompany
				cSoldToCompany = GetCompanyfromSoldAddr(pnAddrCode,ThisForm.nConnHandle)
				IF NOT EMPTY(cSoldToCompany)
					ThisForm.txtSoldTo.Value = cSoldToCompany 
					cCompany = cSoldToCompany 
				ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('CustomerID')
			USE IN CustomerID
		ENDIF
		
		SELECT 0
		cSQL = "SELECT * FROM dbo.Customer_List ORDER BY CustomerID"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"CustomerID")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'CustomerID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CustomerID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CustomerID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'CustomerID')
		ENDIF
		
		IF NOT USED('CustomerID')
			MESSAGEBOX( "Could not loading the table.","Program Error")
			RETURN ""
		ENDIF
		
		SELECT CustomerID
		*SET ORDER TO Company
		
		**Load Customer ID
		IF NOT EMPTY(pcCompany)
			LOCATE FOR CustomerName = cCompany 
			IF NOT FOUND('CustomerID')
				LOCATE FOR CustomerName = LEFT(cCompany ,10)
				IF NOT FOUND('CustomerID')
					LOCATE FOR CustomerName = LEFT(cCompany ,5)
					IF NOT FOUND('CustomerID')
						LOCATE FOR CustomerName = LEFT(cCompany ,3)
						IF NOT FOUND('CustomerID')
							LOCATE FOR CustomerName = LEFT(cCompany ,2)
							IF NOT FOUND('CustomerID')
								LOCATE FOR CustomerName = LEFT(cCompany ,1)
							ENDIF	
						ENDIF	
					ENDIF	
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.grid1.RecordSource = "CustomerID"
		ThisForm.Refresh_Resales_Tax()
		
		MESSAGEBOX("Please Select a Accounting CutomerID for your SalesOrder",0+48,"Relate Accounting to Quotes records.")
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
	ENDPROC

	PROCEDURE loadcustomerid
		PARAMETERS pHow
		*ThisForm.LoadCustomerID()
		
		IF VARTYPE(pHow) != 'C'
			pHow = ''
		ENDIF
		PRIVATE cCompany, cSoldTo
		cCompany = PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		cSoldTo = PrepareSQLtxt(ThisForm.txtSoldTo.Value,'SoldTo',30)
		
		IF USED('CustomerID')
			ThisForm.grid1.RecordSource = ""
			USE IN CustomerID
		ENDIF
		
		SELECT 0
		cSQL = "SELECT * FROM dbo.Customer_List "
		IF pHow = "COMPANY"
			cSQL = cSQL + " WHERE CustomerName LIKE '%"+cCompany+"%'"
		ENDIF
		IF pHow = "SOLDTO"
			cSQL = cSQL + " WHERE CustomerName LIKE '%"+cSoldTo+"%'"
		ENDIF
		cSQL = cSQL +" ORDER BY CustomerID"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"CustomerID")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'CustomerID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CustomerID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CustomerID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'CustomerID')
		ENDIF
		
		IF NOT USED('CustomerID')
			MESSAGEBOX( "Could not loading the table.","Program Error")
			RETURN ""
		ENDIF
		
		SELECT CustomerID
		
		ThisForm.grid1.RecordSource = "CustomerID"
		ThisForm.Refresh_Resales_Tax()
	ENDPROC

	PROCEDURE refresh_resales_tax
		*ThisForm.Refresh_Resales_Tax()
		
		PRIVATE cST, cResales_Tax
		*cST			= UPPER(PrepareSQLtxt(CustomerID.St,'State',2))
		cResales_Tax = PrepareSQLtxt(CustomerID.Resales_Tax,'Resales_Tax',50)
		
		*IF cST = "TX" OR cST = "CA"
		IF NOT EMPTY(cResales_Tax)
			ThisForm.lblResales_Tax.Visible = .T.
		ELSE
			ThisForm.lblResales_Tax.Visible = .F.
		ENDIF
		
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDWidth,nDHeight
		nDWidth = This.Width - 464
		nDHeight = This.Height - 307
		
		ThisForm.grid1.Width = 462 +nDWidth 
		*ThisForm.grid1.Height = 219 +nDHeight
		
		
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		IF USED('CustomerID')
			USE IN CustomerID
		ENDIF
		
		RETURN THISFORM.cReturnValue
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSearchCode.Click
		ThisForm.LoadCustomerID("SOLDTO")
	ENDPROC

	PROCEDURE cmdSearchCompany.Click
		ThisForm.LoadCustomerID("COMPANY")
		
	ENDPROC

	PROCEDURE cmdSeeAll.Click
		ThisForm.LoadCustomerID("")
		
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE cCompany,cCustomerID,cOldCompany
		cCompany	= PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		cCustomerID	= PrepareSQLtxt(CustomerID.CustomerID,'CustomerID',20)
		cOldCompany	= PrepareSQLtxt(CustomerID.CustomerName,'Company',30)
		
		ThisForm.cReturnValue = cCustomerID
		
		IF UPPER(ALLTRIM(cCompany)) != UPPER(ALLTRIM(cOldCompany))
			IF MESSAGEBOX("The Company name is differrent!"+CHR(13)+"Are you sure you want Company:"+ALLTRIM(cCompany)+" to be linked the the CustomerID that is already listed as company:"+ALLTRIM(cOldCompany)+"?",4+48,"Link to Accounting?")=6
				IF UpdateQuotesCustomerID(cCompany,cCustomerID,ThisForm.nConnHandle)
					MESSAGEBOX("Customer:"+ALLTRIM(cCompany)+" was linked to Accounting ID:"+ALLTRIM(cCustomerID),0+64,"Made Relation!")
				ELSE
					WAIT WINDOW "Customer is not related to a Accounting ID!" NOWAIT
				ENDIF
			ELSE
			
			ENDIF
		ELSE
			IF UpdateQuotesCustomerID(cCompany,cCustomerID,ThisForm.nConnHandle)
				MESSAGEBOX("Customer:"+ALLTRIM(cCompany)+" was linked to Accounting ID:"+ALLTRIM(cCustomerID),0+64,"Made Relation!")
			ELSE
				WAIT WINDOW "Customer is not related to a Accounting ID!" NOWAIT
			ENDIF
		ENDIF
		
		
		ThisForm.Release
	ENDPROC

	PROCEDURE Combo1.Valid
		PRIVATE nNearestRecord
		
		SELECT SourcePH 
		LOCATE FOR Company = This.Value
		*SEEK (This.Value) IN SourcePH &&ORDER 'Company'
		nNearestRecord = RECNO()
		
		IF nNearestRecord <= RECCOUNT()
			GOTO (nNearestRecord)
		ELSE 
			GOTO BOTTOM
		ENDIF
		
		ThisForm.grdSourceCompany.Refresh()
		*ThisForm.grdSourceCompany.SetFocus()
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Refresh_Resales_Tax()
	ENDPROC

ENDDEFINE
