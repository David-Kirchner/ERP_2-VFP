	PROCEDURE frmSales_Review.pf.pgStock.chkService.Click
		PRIVATE nRecNum
		nRecNum = RECNO('SalesQuote')
		
		PRIVATE lServices
		IF SalesQuote.Inv AND SalesQuote.Services
			MESSAGEBOX("You cannot have 'Inv' and 'Service' selected on same item.",48,"Please choose only one!")
			*Reverse Services
			SELECT SalesQuote
			REPLACE Services WITH .f.
			IF nRecNum > 0 AND nRecNum <= RECCOUNT('SalesQuote')
				GOTO (nRecNum)
			ENDIF
			RETURN .F.
		ELSE
			*Save
			lServices	= PrepareSQLlogic(This.Value,'Service',.F.)
			
			PRIVATE cUpdate
			cUpdate = "UPDATE dbo.AllQuotes SET "
			cUpdate = cUpdate + " Services="+IIF(lServices,"1","0")+""
			cUpdate = cUpdate + " WHERE ID = " + ALLTRIM(STR(SalesQuote.ID))
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL'  TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			
			IF nSQLEXEC > 0
				ThisFormSet.frmEO.pf1.pgQuote.chkServices.Value = lServices
				
				SELECT SalesQuote
				REPLACE Services WITH lServices IN SalesQuote
				IF nRecNum > 0 AND nRecNum <= RECCOUNT('SalesQuote')
					GOTO (nRecNum)
				ENDIF
				*****************************************	
				PRIVATE cTyp 
				cTyp	= ''
				
				IF lServices
					cTyp	= 'S'
					SELECT SalesQuote
					REPLACE TYP WITH cTyp IN SalesQuote
				ENDIF
				
			ENDIF
		ENDIF
		
		This.parent.parent.pgQuote.ChkServices.Refresh
	ENDPROC

