		*rtr_pgVerify
	ENDPROC

	PROCEDURE save_pgprod
		*ThisFormSet.Save_pgProd()
		
		PRIVATE lService, lDraw, lGFM, lRoll, lMach, lCG, cTol 
		lService  = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgProd.chkService.Value,'Service',.F.)
		lDraw = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgProd.chkDraw.Value,'Draw',.F.)
		lGFM = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgProd.chkGFM.Value,'GFM',.F.)
		lRoll = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgProd.chkRoll.Value,'Roll',.F.)
		lPress = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgProd.chkPress.Value,'Press',.F.)
		lMach = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgProd.chkMach.Value,'Mach',.F.)
		lCG	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgProd.chkCG.Value,'CG',.F.)
		cTol = PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgProd.txtTol.Value,'Tolerance',20)
		IF lCG AND LEN(ALLTRIM(cTol))=0
			MESSAGEBOX("Please enter a CG Tolerance on SO-Item:"+ThisFormSet.cSoItem+"!",0+64,"Found CG job with no Tolerance.")
		ENDIF
		
		************************************************
		*Set Router p_rtr_Oper
		*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"INV",lInv,lCncld,ThisFormSet.nConnHandle)
		PRIVATE lCncld, lCmplt
		lCncld = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkCncld.Value,'Cncld',.F.)
		lCmplt = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkCmplt.Value,'Cmplt',.F.)
		
		IF NOT ( lCncld OR lCmplt )
			*Not Cancelled, make sure POitem work is scheduled.
			IF lService
				*Toll Service
				*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Toll Service",lInv,ThisFormSet.nConnHandle)
			ENDIF
		
			IF lGFM
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Radial Forge",lGFM,ThisFormSet.nConnHandle)
				*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Testing", ,ThisFormSet.nConnHandle)
			ENDIF
			IF lDraw
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Draw",lDraw,ThisFormSet.nConnHandle)
				*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Testing", ,ThisFormSet.nConnHandle)
			ENDIF
			IF lPress
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Open Die Forge",lPress,ThisFormSet.nConnHandle)
				*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Testing", ,ThisFormSet.nConnHandle)
			ENDIF
			IF lRoll
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Roll",lRoll,ThisFormSet.nConnHandle)
				*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Testing", ,ThisFormSet.nConnHandle)
			ENDIF
			IF lMach
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Machine Shop",lMach,ThisFormSet.nConnHandle)
			ENDIF
			IF lCG
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Centerless Grinder",lCG,ThisFormSet.nConnHandle)
			ENDIF
		
			*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Peel", ,ThisFormSet.nConnHandle)
		
		ENDIF		
		
		***************************************************
		PRIVATE cSQLu
		
		cSQLu = "UPDATE dbo.Sales SET "
		*cSQLu = cSQLu + " OrderSpec='"+ALLTRIM(cOrderSpec)+"'"
		*cSQLu = cSQLu + ",S_Instrct='"+ALLTRIM(cS_Instrct)+"'"
		*cSQLu = cSQLu + ",Inv="+IIF(lInv,"1","0")
		*cSQLu = cSQLu + ",BRK="+IIF(lBRK,"1","0")
		cSQLu = cSQLu + ",GFM="+IIF(lGFM,"1","0")
		cSQLu = cSQLu + ",Draw="+IIF(lDraw,"1","0")
		cSQLu = cSQLu + ",Roll="+IIF(lRoll,"1","0")
		cSQLu = cSQLu + ",Press="+IIF(lPress,"1","0")
		cSQLu = cSQLu + ",Mach="+IIF(lMach,"1","0")
		cSQLu = cSQLu + ",CG="+IIF(lCG,"1","0")
		cSQLu = cSQLu + ",Tol='"+cTol+"'"
		*cSQLu = cSQLu + ",Plasma="+IIF(lPlasma,"1","0")
		*cSQLu = cSQLu + ",WJet="+IIF(lWJet,"1","0")
		*cSQLu = cSQLu + ",ColdSaw="+IIF(lColdSaw,"1","0")
		*cSQLu = cSQLu + ",Cert="+STR(nCert)
		*cSQLu = cSQLu + ",ShipON="+IIF(llShipOn,"1","0")
		*IF NOT EMPTY(dShipDue)
		*	cSQLu = cSQLu + ",ShipDue='"+DTOC(dShipDue)+"'"
		*ENDIF
		*IF NOT EMPTY(dShipped)
		*	cSQLu = cSQLu + ",Shipped='"+DTOC(dShipped)+"'"
		*ENDIF
		*cSQLu = cSQLu + ",MatlWt="+STR(nMatlWt,9,1)
		*cSQLu = cSQLu + ",Cncld="+IIF(lcncld,"1","0")
		*cSQLu = cSQLu + ",Cmplt="+IIF(lCmplt,"1","0")
		*cSQLu = cSQLu + ",PartNo='"+ALLTRIM(cPartNo)+"'"
		*cSQLu = cSQLu + ",ItemCost="+STR(nItemCost,9,2)
		*cSQLu = cSQLu + ",ItemSale="+STR(nItemSale,9,2)
		
		*cSQLu = cSQLu + ",StkPaid= "+STR(PrepareSQLnum(nStkPaid,'StkPaid',9,2),9,2)
		*cSQLu = cSQLu + ",StkCost= "+STR(PrepareSQLnum(nSTKCost,'StkCost',9,2),9,2)
		*cSQLu = cSQLu + ",POCost= "+STR(PrepareSQLnum(nPOCost,'POCost',9,2),9,2)
		
		*cSQLu = cSQLu + ",Quoted_QTY = "+STR(nQuoted_QTY,18,4)
		*cSQLu = cSQLu + ",Quoted_P = "+STR(nQuoted_P,18,4)
		*cSQLu = cSQLu + ",Quoted_Total = "+STR(nQuoted_Total,18,4)
		*cSQLu = cSQLu + ",Quoted_PU = "+STR(nQuoted_PU)
		
		*,[gs_cost],[gs_sale],[gs_cmplt]
		
		*cSQLu = cSQLu + ",RMA_No="+ALLTRIM(STR(nRMA_No))
		*cSQLu = cSQLu + ",RMA_Detail="+ALLTRIM(STR(nRMA_Detail))
		
		*,[QA],[CofC],[Merc],[pPo],[pPn],[pHeat],[pSpec],[pDesc],[pOther],[Other]
		*,[prcp],[prcd],[pckd]
		*cSQLu = cSQLu + ",[ShipOn]="+IIF(lShipOn,"1","0")
		*cSQLu = cSQLu + ",Urgent='"+cUrgent+"'"
		
		cSQLu = cSQLu + ",Tol='"+ALLTRIM(cTol)+"'"
		*cSQLu = cSQLu + ",JobHours="+STR(nJobHours)+""
		*cSQLu = cSQLu + ",ProcLoc='"+cProcLoc+"'"
		
		*,[S_PU],[S_QTY],[S_P],[S_Total]
		*,[Quoted_OtherP],[Quoted_CutsP]
		*cSQLu = cSQLu + ",DShip="+IIF(lDShip,"1","0") 	
		*cSQLu = cSQLu + ",TYP='"+cTYP+"'"  
		*,[WO],[WO_Detail],[ProductionWO]
		*cSQLu = cSQLu + ",[Export]="+IIF(lExport,"1","0")
		*,[RcvdE],[RMA_E]
		
		cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.csoitem+"')"
		
		WAIT WINDOW "Saved to dbo.Sales table" NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
				lReturn = .F.
				lRollBack = .T.
			ENDIF
		ENDIF
		
		**************************************************
	ENDPROC

	PROCEDURE save_pgquality
		*ThisFormSet.Save_pgQuality()
		
		PRIVATE lQA, lCofC, lMerc
		lQA		= PrepareSQLlogic( ThisFormSet.frmSales_Review.pf.pgQuality.chkQA.Value,'QA',.F.)
		lCofC	= PrepareSQLlogic( ThisFormSet.frmSales_Review.pf.pgQuality.chkCofC.Value,'CofC',.F.)
		lMerc	= PrepareSQLlogic( ThisFormSet.frmSales_Review.pf.pgQuality.chkMercury.Value,'Merc',.F.)
		
		PRIVATE lpPO, lpPN, lpHeat, lpSpec, lpDesc, lpOther, cOther
		lpPO		= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkpPO.Value,'pPO',.F.)
		lpPN		= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkpPN.Value,'pPN',.F.)
		lpHeat		= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkpHeat.Value,'pHeat',.F.)
		lpSpec		= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkpSpec.Value,'pSpec',.F.)
		lpDesc		= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkpDesc.Value,'pDesc',.F.)
		lpOther		= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkpOther.Value,'pOther',.F.)
		cOther		= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgQuality.txtOther,'Other',50)
		
		PRIVATE lExport, lShipOn, dShipDue, cUrgent
		lExport	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkExport.Value,'Export',.F.)
		lShipOn	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkShipOn.Value,'ShipOn',.F.)
		dShipDue= PrepareSQLdate(ThisFormSet.frmSales_Review.pf.pgQuality.txtShipDue.Value,'ShipDue',)
		cUrgent	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgQuality.cmbUrgent.Value,'Urgent',1)
		
		PRIVATE lEmailConf, lPrintedSO, lRecvSO, lEverPrint
		lEmailConf	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkEmailConf.Value,'kEmailConf',.F.)
		lPrintedSO	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkPrintedSO.Value,'kPrintedSO',.F.)
		lRecvSO		= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkShopRecvSO.Value,'kShopRecvSO',.F.)
		lEverPrint	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkEverPrint.Value,'EverPrint',.F.)
		
		PRIVATE nAmendment, lSOchanging, cBillInstrct
		nAmendment	= PrepareSQLnum(ThisFormSet.frmSales_Review.pf.pgQuality.txtAmendment.Value,'Amendment',-1)
		lSOchanging	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgQuality.chkSOchanging.Value,'SOchanging',.F.)
		cBillInstrct	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgQuality.txtBillInstrct.Value,'BillInstrct',255)
		
		PRIVATE lCncld, lCmplt
		lCncld = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkCncld.Value,'Cncld',.F.)
		lCmplt = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkCmplt.Value,'Cmplt',.F.)
		
		
		***************************************************
		PRIVATE cSQLu
		
		cSQLu = "UPDATE dbo.Sales SET "
		*cSQLu = cSQLu + " OrderSpec='"+ALLTRIM(cOrderSpec)+"'"
		*cSQLu = cSQLu + ",S_Instrct='"+ALLTRIM(cS_Instrct)+"'"
		*cSQLu = cSQLu + ",Inv="+IIF(lInv,"1","0")
		*cSQLu = cSQLu + ",BRK="+IIF(lBRK,"1","0")
		*cSQLu = cSQLu + ",GFM="+IIF(lGFM,"1","0")
		*cSQLu = cSQLu + ",Draw="+IIF(lDraw,"1","0")
		*cSQLu = cSQLu + ",Roll="+IIF(lRoll,"1","0")
		*cSQLu = cSQLu + ",Press="+IIF(lPress,"1","0")
		*cSQLu = cSQLu + ",Mach="+IIF(lMach,"1","0")
		*cSQLu = cSQLu + ",CG="+IIF(lCG,"1","0")
		*cSQLu = cSQLu + ",Tol='"+cTol+"'"
		*cSQLu = cSQLu + ",Plasma="+IIF(lPlasma,"1","0")
		*cSQLu = cSQLu + ",WJet="+IIF(lWJet,"1","0")
		*cSQLu = cSQLu + ",ColdSaw="+IIF(lColdSaw,"1","0")
		*cSQLu = cSQLu + ",Cert="+STR(nCert)
		cSQLu = cSQLu + " ShipON="+IIF(lShipOn,"1","0")
		IF NOT EMPTY(dShipDue)
			cSQLu = cSQLu + ",ShipDue='"+DTOC(dShipDue)+"'"
		ENDIF
		*IF NOT EMPTY(dShipped)
		*	cSQLu = cSQLu + ",Shipped='"+DTOC(dShipped)+"'"
		*ENDIF
		*cSQLu = cSQLu + ",MatlWt="+STR(nMatlWt,9,1)
		*cSQLu = cSQLu + ",Cncld="+IIF(lcncld,"1","0")
		*cSQLu = cSQLu + ",Cmplt="+IIF(lCmplt,"1","0")
		*cSQLu = cSQLu + ",PartNo='"+ALLTRIM(cPartNo)+"'"
		*cSQLu = cSQLu + ",ItemCost="+STR(nItemCost,9,2)
		*cSQLu = cSQLu + ",ItemSale="+STR(nItemSale,9,2)
		
		*cSQLu = cSQLu + ",StkPaid= "+STR(PrepareSQLnum(nStkPaid,'StkPaid',9,2),9,2)
		*cSQLu = cSQLu + ",StkCost= "+STR(PrepareSQLnum(nSTKCost,'StkCost',9,2),9,2)
		*cSQLu = cSQLu + ",POCost= "+STR(PrepareSQLnum(nPOCost,'POCost',9,2),9,2)
		
		*cSQLu = cSQLu + ",Quoted_QTY = "+STR(nQuoted_QTY,18,4)
		*cSQLu = cSQLu + ",Quoted_P = "+STR(nQuoted_P,18,4)
		*cSQLu = cSQLu + ",Quoted_Total = "+STR(nQuoted_Total,18,4)
		*cSQLu = cSQLu + ",Quoted_PU = "+STR(nQuoted_PU)
		
		*,[gs_cost],[gs_sale],[gs_cmplt]
		*cSQLu = cSQLu + ",RMA_No="+ALLTRIM(STR(nRMA_No))
		*cSQLu = cSQLu + ",RMA_Detail="+ALLTRIM(STR(nRMA_Detail))
		
		cSQLu = cSQLu + ",[QA]="+IIF(lQA,"1","0")
		cSQLu = cSQLu + ",[CofC]="+IIF(lCofC,"1","0")
		cSQLu = cSQLu + ",[Merc]="+IIF(lMerc,"1","0")
		
		cSQLu = cSQLu + ",[pPo]="+IIF(lpPO,"1","0")
		cSQLu = cSQLu + ",[pPn]="+IIF(lpPN,"1","0")
		cSQLu = cSQLu + ",[pHeat]="+IIF(lpHeat,"1","0")
		cSQLu = cSQLu + ",[pSpec]="+IIF(lpSpec,"1","0")
		cSQLu = cSQLu + ",[pDesc]="+IIF(lpDesc,"1","0")
		cSQLu = cSQLu + ",[pOther]="+IIF(lpOther,"1","0")
		cSQLu = cSQLu + ",[Other]='"+cOther+"'"
		
		*,[prcp],[prcd],[pckd]
		
		cSQLu = cSQLu + ",Urgent='"+cUrgent+"'"
		
		*cSQLu = cSQLu + ",Tol='"+ALLTRIM(cTol)+"'"
		*cSQLu = cSQLu + ",JobHours="+STR(nJobHours)+""
		*cSQLu = cSQLu + ",ProcLoc='"+cProcLoc+"'"
		
		*,[S_PU],[S_QTY],[S_P],[S_Total]
		*,[Quoted_OtherP],[Quoted_CutsP]
		*cSQLu = cSQLu + ",DShip="+IIF(lDShip,"1","0") 	
		*cSQLu = cSQLu + ",TYP='"+cTYP+"'"  
		*,[WO],[WO_Detail],[ProductionWO]
		cSQLu = cSQLu + ",[Export]="+IIF(lExport,"1","0")
		*,[RcvdE],[RMA_E]
		
		cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.csoitem+"')"
		
		WAIT WINDOW "Saved to dbo.Sales table" NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
				lReturn = .F.
				lRollBack = .T.
			ENDIF
		ENDIF
		
		***************************************
		
		
		cSQL = "UPDATE dbo.Sales_No SET "
		*cSQL = cSQL + ",[SalesRep]= '"+cCalesRep+"'"*,[]
		*cSQL = cSQL + " [instrct]= '"+cS_Instrct+"'"
		*,[itemtot]
		*cSQL = cSQL + ",[pSoldAddr]= "+STR(pSoldAddr)
		*cSQL = cSQL + ",[pShipAddr]= "+STR(pShipAddr)
		*cSQL = cSQL + ",[ShipRoute]= '"+cShipRoute+"'"
		*cSQL = cSQL + ",[ShipPay]= '"+cShipPay+"'"
		*cSQL = cSQL + ",[PayType]= '"+cPayType+"'"
		*,[CustID]
		cSQL = cSQL + " [Paper_PO]= "+IIF(lRecvSO,'1','0')+""
		*cSQL = cSQL + ",Cncld="+IIF(lCancelSO,'1','0')+"" **Do not change Cncld here!!
		*,[cmplt]
		*cSQL = cSQL + ",[Blind]= "+IIF(lblind,'1','0')+""
		*cSQL = cSQL + " [EmailConf]= "+IIF(lEmailConf,'1','0')+""
		*cSQL = cSQL + ",[nFreightEst]= "+STR(nFreightEst)
		*,[EverPrint]
		cSQL = cSQL + ",[PrintedSO]= "+IIF(lPrintedSO,'1','0')+""
		*,[emailedps]
		*,[faxedps]
		*,[addr_ref]
		*,[trt_lumber]
		*cSQL = cSQL + ",[TarfBill]= '"+cTarfBill+"'"
		*cSQL = cSQL + ",USA= "+IIF(llUSA,'1','0')+""
		*cSQL = cSQL + ",ECPC= "+IIF(lECPC,'1','0')+""
		cSQL = cSQL + ",Amendment= "+STR(nAmendment,2,0)+""
		*,[ShopRecv]
		cSQL = cSQL + ",Changing="+IIF(lSOChanging,'1','0')+""
		*,[webnum]
		*cSQL = cSQL + ",DPAS= "+IIF(lDPAS,'1','0')+""
		*cSQL = cSQL + ",FCI= "+IIF(lFCI,'1','0')+""
		*cSQL = cSQL + ",GOV= "+IIF(lGOV,'1','0')+""
		*cSQL = cSQL + ",[BillInstrct]= '"+cBillInstrct+"'"
		
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.nSalesNum))
				
		WAIT WINDOW "UPDATE dbo.Sales_No " NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				lReturn = .F.
				*lRollBack = .T.
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		***********************
		
		
		***** ...Lst_Process
		IF NOT EMPTY(dShipDue) OR dShipDue = CTOD("01/01/1900")
			IF NOT ISNULL(dShipDue)
				PRIVATE cSQLUpdate
				cSQLUpdate = "UPDATE dbo.StockLst_Process "
				cSQLUpdate = cSQLUpdate + " SET DueDate = '"+IIF(EMPTY(dShipDue),'',DTOC(dShipDue))+"'"
				cSQLUpdate = cSQLUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
				cSQLUpdate = cSQLUpdate + " AND ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
				
				WAIT WINDOW "UPDATE dbo.StockLst_Process " NOWAIT
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLUpdate)
		
			ENDIF
		ENDIF
		
		***********************
		
		
		***** ...Lst_Process
		IF NOT EMPTY(dShipDue) OR dShipDue = CTOD("01/01/1900")
			IF NOT ISNULL(dShipDue)
				PRIVATE cSQLUpdate
				cSQLUpdate = "UPDATE dbo.StockLst_Process "
				cSQLUpdate = cSQLUpdate + " SET DueDate = '"+IIF(EMPTY(dShipDue),'',DTOC(dShipDue))+"'"
				cSQLUpdate = cSQLUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
				cSQLUpdate = cSQLUpdate + " AND ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
				
				WAIT WINDOW "UPDATE dbo.StockLst_Process " NOWAIT
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLUpdate)
		
			ENDIF
		ENDIF
		
		***********************
		
	ENDPROC

	PROCEDURE save_pgship
		*ThisFormSet.Save_pgShip()
		
		*!*	ThisFormSet.frmSales_Review.pf.pgShip.chkReceivedPO.Enabled = .T.
		*!*	ThisFormSet.frmSales_Review.pf.pgShip.chkBlindSO.Enabled = .T.
		*!*	ThisFormSet.frmSales_Review.pf.pgShip.cmbPayment.Enabled = .T.
		PRIVATE lPaper_PO, lBlind, cShipPay
		lPaper_PO 	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgShip.chkReceivedPO.Value,'ReceivedPO',.F.)
		lBlind 		= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgShip.chkBlindSO.Value,'Blind',.F.)
		cShipPay	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgShip.cmbPayment.Value,'ShipPay',12)
		
		PRIVATE pShipAddr, pSoldAddr, nRMA_No, nRMA_Detail
		pShipAddr	= PrepareSQLnum(ThisFormSet.frmSales_Review.pf.pgShip.txtpShipAddr.Value,'pShipAddr',-3)
		pSoldAddr	= PrepareSQLnum(ThisFormSet.frmSales_Review.pf.pgShip.txtpSoldAddr.Value,'pSoldAddr',-3)
		nRMA_No		= PrepareSQLnum(ThisFormSet.frmSales_Review.pf.pgShip.txtRMA_No.Value,'RMA_No',-3)
		nRMA_Detail	= PrepareSQLnum(ThisFormSet.frmSales_Review.pf.pgShip.txtRMA_Detail.Value,'RMA_Detail',-3)
		
		PRIVATE cPayType, cTarfBill
		cPayType	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgShip.cmbFrtPayment.Value,'PayType',10)
		cTarfBill	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgShip.cmbTarfBill.Value,'TarfBill',10)
		
		PRIVATE lUSA, lECPC, lGOV, lDPAS, lFCI
		lUSA	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgShip.chkUSA.Value,'USA',.F.)
		lECPC	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgShip.chkECPC.Value,'ECPC',.F.)
		lGOV	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgShip.chkGOV.Value,'GOV',.F.)
		lDPAS	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgShip.chkDPAS.Value,'DPAS',.F.)
		lFCI	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgShip.chkFCI.Value,'FCI',.F.)
		
		PRIVATE cShipRoute, nFreightEst, cS_Instrct
		cShipRoute	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgShip.txtShipRoute.Value,'ShipRoute',20)
		nFreightEst	= PrepareSQLnum(ThisFormSet.frmSales_Review.pf.pgShip.txtFreightEst.Value,'FreightEst',8,2)
		cS_Instrct	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgShip.txtInstrct.Value,'txtInstrct',-1)
		
		PRIVATE lCncld, lCmplt
		lCncld = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkCncld.Value,'Cncld',.F.)
		lCmplt = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkCmplt.Value,'Cmplt',.F.)
		***************************************
		
		
		
		***************************************************
		PRIVATE cSQLu
			
		cSQLu = "UPDATE dbo.Sales SET "
		*cSQLu = cSQLu + " OrderSpec='"+ALLTRIM(cOrderSpec)+"'"
		*cSQLu = cSQLu + ",S_Instrct='"+ALLTRIM(cS_Instrct)+"'"
		*cSQLu = cSQLu + ",Inv="+IIF(lInv,"1","0")
		*cSQLu = cSQLu + ",BRK="+IIF(lBRK,"1","0")
		*cSQLu = cSQLu + ",GFM="+IIF(lGFM,"1","0")
		*cSQLu = cSQLu + ",Draw="+IIF(lDraw,"1","0")
		*cSQLu = cSQLu + ",Roll="+IIF(lRoll,"1","0")
		*cSQLu = cSQLu + ",Press="+IIF(lPress,"1","0")
		*cSQLu = cSQLu + ",Mach="+IIF(lMach,"1","0")
		*cSQLu = cSQLu + ",CG="+IIF(lCG,"1","0")
		*cSQLu = cSQLu + ",Tol='"+cTol+"'"
