	PROCEDURE frmSales_Review.pf.pgQuality.cmdCancQuality.Click
		ThisFormSet.Set_pgQuality('Save')
		This.Parent.cmdEditQuality.Caption = "Edit"
		This.Visible = .F.
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgQuality.cmdEditQuality.Click
		IF This.Caption = "Edit"
			ThisFormSet.Set_pgQuality('Edit')
			This.Parent.cmdCancQuality.Visible = .T.
			This.Caption = "Save"
		ELSE
			*"Save"
			IF ThisFormSet.Save_pgQuality()
				ThisFormSet.Set_pgQuality('Save')
				This.Parent.cmdCancQuality.Visible = .F.
				This.Caption = "Edit"
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgQuality.cmdMark_RVW_Stock.Click
		PRIVATE lComplete
		lComplete = ThisForm.lblComplete.Visible
		
		IF lComplete 
			MESSAGEBOX("This SOitem is COMPLETED, you are not allowed to modify now",0,"Cannot")
			RETURN .F.
		ENDIF
		
		ThisFormSet.Save_RVW_Prod()
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgQuality.lblNotBefore.Click
		This.Parent.chkShipOn.Click()
		
	ENDPROC

