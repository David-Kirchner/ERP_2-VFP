	PROCEDURE frmSales_Review.pf.pgShip.cmbPayment.Valid
		********************************
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE lcPayType
		lcPayType	= PrepareSQLtxt( This.Value,'PayType',10)
		
		*Do not Allow This.Value = "STD TERMS" if CustId Does not Allow!
		IF lcPayType = "STD TERMS" 
			*Check to see if allowed
		
			IF LEN(ALLTRIM(PrepareSQLtxt(SalesQuote.CustID,'CustID',20)))=0
				MESSAGEBOX("You must have an Accounting 'CustomerID' before you can select 'STD TERMS' as a Payment Type.",16,"Cannot choose 'STD Terms'")
				This.Value = ''
				* , Not Entered,STD TERMS,Standard Terms,COD,COD,PREPAID,Prepay/Credit Card,CANADA STD, Canada Standard,CANADA COD, Canada COD,CANADA PP, Canada Prepay,FOREIGNSTD, Foreign Standard,FOREIGNCOD, Foreign COD,FOREIGN PP, Foreign PrePay
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
		SELECT Sales_No	&&Sales_No does not have items detail
		REPLACE PayType WITH lcPayType IN Sales_No
				
		ThisFormSet.cPaymentType	= lcPayType
		********************************
		
		*ShowPaymentTypeText('1')
		* , Not Entered,STD TERMS,Standard Terms,COD,COD,PREPAID,Prepay/Credit Card,CANADA STD, Canada Standard,CANADA COD, Canada COD,CANADA PP, Canada Prepay,FOREIGNSTD, Foreign Standard,FOREIGNCOD, Foreign COD,FOREIGN PP, Foreign PrePay
		
		*WIRE TRANS,Wire Transfer,
		*HOLD 4 PAY,Hold for Payment
		
		IF This.Value = "STD TERMS" 
			*Show the Current Status.
			
			PRIVATE cCompany
			IF NOT LEN(ALLTRIM(This.Parent.Parent.pgBillTo.txtCompany.Value))=0
				cCompany = ALLTRIM(This.Parent.Parent.pgBillTo.txtCompany.Value)
			ELSE
				cCompany = AllTrim(SalesQuote.Company)
			ENDIF
			
			PRIVATE cCustID
			cCustID = PrepareSQLtxt(SalesQuote.CustID,'CustID',20)
			IF LEN(ALLTRIM(cCustID))=0
				*Not sure why SalesQuote.CustID is lost, replace here
				cCustID = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)
				IF NOT LEN(ALLTRIM(cCustID))=0
					SELECT SalesQuote
					REPLACE CustID WITH cCustID IN SalesQuote
				ENDIF
			ENDIF
		
			IF LEN(cCustID)=0 OR VAL(cCustID) > 1000
				MESSAGEBOX("Because 'STD TERMS' was selected."+CHR(13)+"Next, you will be shown a currect accounting status window."+CHR(13)+"The computer sees a problem with the Customer ID."+CHR(13)+"The Accountants use the first couple of letters of the Company for the Customer ID."+CHR(13)+"You will need to fix CustomerID."+CHR(13)+"Your CustID is'"+cCustID+"'",48,"Problem with CustID")
			ENDIF
		
			***************************************************
			*Show the Current CustID Status.
			
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
		
			*DO FORM forms\CustomerTerms WITH cCompany, cCustomerID 
			DO FORM forms\CustomerStatus WITH cCustID, cCompany, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle 
		
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		
		ENDIF
		
		SELECT Sales_No	&&This was added to see if this Valid code accidentally closed the 'Sales_No' table
		
	ENDPROC

