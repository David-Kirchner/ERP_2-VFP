		PRIVATE cSQL, nSQLEXEC 
		PRIVATE cBillInstrct
		cBillInstrct = PrepareSQLtxt( This.Value,'BillInstrct',255)
		
		*!*	cSQL = "UPDATE dbo.Sales_No SET "
		*!*	cSQL = cSQL + " instrct= '"+cInstrct+"'"
		*!*	cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.nSalesNum ))
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL 1' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*	ELSE
			
			IF NOT USED('Sales_No')
				TrackError("Lost table Sales_No","Lost table Sales_No",Program(),LINENO(1))
			ENDIF
		
			SELECT Sales_No	&&Sales_No does not have items detail
			REPLACE BillInstrct WITH cBillInstrct IN Sales_No
			
			WAIT WINDOW "Updated Billing Instructions" NOWAIT
		*ENDIF
	ENDPROC

