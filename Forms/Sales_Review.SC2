		ThisFormSet.FormsRefresh()
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpPOitems')
			USE IN tmpPOitems
		ENDIF
		
		
		= SQLDISCONNECT( ThisFormSet.nConnHandle )
		
		IF "ROUTER" $ SET("CLASSLIB")
			RELEASE CLASSLIB libs\Router
		ENDIF
		
		IF "WORKORDER" $ SET("CLASSLIB")
			RELEASE CLASSLIB libs\WorkOrder
		ENDIF
		IF "WORKORDER" $ SET("CLASSLIB")
			RELEASE CLASSLIB libs\WorkOrder
		ENDIF
		
		IF "WIZEMBSS" $ SET("CLASSLIB")
			RELEASE CLASSLIB libs\WIZEMBSS
		ENDIF
		*RETURN ThisFormSet.HoldNumber
	ENDPROC

	PROCEDURE frmRouterDetailOrder.load_rtr
		PARAMETERS biRTR_ID
		DODEFAULT(biRTR_ID)
	ENDPROC

	PROCEDURE frmSales_Review.cmdClearReview.Click
		PRIVATE cSOitem
		cSOitem = ThisFormSet.cSOItem
		
		PRIVATE nMess
		nMess = MESSAGEBOX("Are you sure you want to mark this SOitem "+cSOitem+" as needing REVIEW?",4+32,"Un Reviewed")
		IF nMess = 6 &&yes
			
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "UPDATE dbo.Sales SET "
			cSQL = cSQL + " Review = 0 "
			cSQL = cSQL + ",RVW_Prod = 0 "
			cSQL = cSQL + ",RVW_Stock = 0 "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
		
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				ThisForm.chkReview.Value = .F.
				ThisForm.chkRVW_Stock.Value = .F.
				ThisForm.chkRVW_Prod.Value = .F.
			
				ThisFormSet.frmQuote.chkReview.Value = 0
				ThisFormSet.frmQuote.txtReview_Date.Value = ''  &&DTOC(DATE())
					
				This.Visible = .F.
		
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmSales_Review.cmdReturn.Click
		*ThisForm.Release
		ThisFormSet.Release
	ENDPROC

	PROCEDURE frmSales_Review.cmdShowRouter.Click
		IF ThisFormSet.frmRouter.Visible
			ThisFormSet.frmRouter.grdRTR_Detail.SetFocus
		ELSE
			
				PRIVATE biRTR_ID
				biRTR_ID = 0
				
				IF Proper_SO_item(ThisFormSet.cSOItem) != Proper_SO_item('')
					cSQL = "SELECT ID FROM dbo.rtr WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
					
					IF USED("tmpCountRTR")	
						USE IN tmpCountRTR
					ENDIF
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpCountRTR')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountRTR')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
					IF USED('tmpCountRTR')
						IF RECCOUNT('tmpCountRTR') > 0
							biRTR_ID = PrepareSQLnum(tmpCountRTR.ID,'rtr_ID',-4)
						ENDIF
						USE IN tmpCountRTR
					ENDIF
				ENDIF
		
				IF biRTR_ID = 0
					MESSAGEBOX("This Sales Order does not have an entry in the Router Table."+CHR(13)+"Select Stock to create a rtr to show!",0+48,"No record to show.")
					*Could run CREATE_RTR_SOITEM()
					*Reads Sales and add all Operations quoted to the router.
				ENDIF
				
				IF biRTR_ID > 0
					*WAIT WINDOW 'Router Loaded' NOWAIT
		
					ThisFormSet.frmRouter.Visible = .T.
					ThisFormSet.frmRouter.Top = ThisForm.Top + 20
					ThisFormSet.frmRouter.Left = ThisForm.Left +ThisForm.Width + 300
		
					ThisFormSet.frmRouter.LoadRTR(biRTR_ID)
					*ThisFormSet.frmRouter.router_init(pWhat, pType, pID , nTop, nLeft, cCaption)
		
					ThisFormSet.frmRouter.grdRTR.SetFocus()
					
				ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE frmSales_Review.cmdShow_Router_Detail.Click
		PRIVATE biRTR_ID
		biRTR_ID = PrepareSQLnum(ThisFormSet.nrtr_ID,'rtr_ID',-4)
		IF biRTR_ID > 0
		*	ThisForm.Visible = .F.
			*ThisForm.AlwaysOnTop = .F.
			ThisFormSet.frmRouterDetailOrder.Visible = .T.
			*ThisFormSet.frmRtrDetail.Load_rtr(biRTR_ID)
			ThisFormSet.frmRouterDetailOrder.Load_RTR(biRTR_ID)
			ThisFormSet.frmRouterDetailOrder.Left = ThisForm.Left +ThisForm.Width + 10
			ThisFormSet.frmRouterDetailOrder.Top = ThisForm.Top 
			
			ThisFormSet.frmRouterDetailOrder.AlwaysOnTop = .T.
			
		ELSE
		
		ENDIF
		
		RETURN
		
		*!*	IF Thisformset.frmRouterDetailOrder.Visible
		*!*		MESSAGEBOX("Close the 'Router Detail Order'"+CHR(13)+"window first.",16,"Another Window is Open")
		*!*		ThisFormSet.frmRouterDetailOrder.cmdReturn.SetFocus
		*!*	ELSE
		*!*		IF Thisformset.frmRouter.Visible
		*!*			Thisformset.frmRouter.grdRTR.SetFocus()
		*!*		ELSE
		*!*		
		*!*			
		*!*			PRIVATE biRTR_ID
		*!*			biRTR_ID = 0
		*!*			
		*!*			IF Proper_SO_item(ThisFormSet.cSOItem) != Proper_SO_item('')
		*!*				cSQL = "SELECT ID FROM dbo.rtr WITH(NOLOCK) "
		*!*				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
		*!*				
		*!*				IF USED("tmpCountRTR")	
		*!*					USE IN tmpCountRTR
		*!*				ENDIF
		*!*				
		*!*				SELECT 0
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpCountRTR')
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
		*!*							
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO
		*!*				ENDIF 
		*!*				IF nSQLEXEC < 0
		*!*					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountRTR')
		*!*						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*					ENDIF
		*!*				ENDIF
		*!*				IF USED('tmpCountRTR')
		*!*					IF RECCOUNT('tmpCountRTR') > 0
		*!*						biRTR_ID = PrepareSQLnum(tmpCountRTR.ID,'rtr_ID',-4)
		*!*					ENDIF
		*!*					USE IN tmpCountRTR
		*!*				ENDIF
		*!*			ENDIF
		
		*!*			IF biRTR_ID = 0
		*!*				MESSAGEBOX("This Sales Order does not have an entry in the Router Table."+CHR(13)+"Select Stock to create a rtr to show!",0+48,"No record to show.")
		*!*				*Could run CREATE_RTR_SOITEM()
		*!*				*Reads Sales and add all Operations quoted to the router.
		*!*			ENDIF
		*!*			
		*!*			IF biRTR_ID > 0
		*!*				*WAIT WINDOW 'Router Loaded' NOWAIT
		
		*!*				ThisFormSet.frmRouter.Visible = .T.
		*!*				ThisFormSet.frmRouter.Top = ThisForm.Top + 20
		*!*				ThisFormSet.frmRouter.Left = ThisForm.Left + 300
		
		*!*				ThisFormSet.frmRouter.LoadRTR(biRTR_ID)
		*!*				*ThisFormSet.frmRouter.router_init(pWhat, pType, pID , nTop, nLeft, cCaption)
		
		*!*				ThisFormSet.frmRouter.grdRTR.SetFocus()
		*!*				
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

