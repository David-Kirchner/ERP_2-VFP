	PROCEDURE frmSales_Review.pf.pgProd.txtTol.Valid
		PRIVATE cTol
		cTol	= PrepareSQLtxt(This.Value,'Tol',20)
		
		*!*	PRIVATE cUpdate
		*!*	cUpdate = "UPDATE dbo.Sales SET "
		*!*	cUpdate = cUpdate + " TOL='"+cTol+"'"
		*!*	cUpdate = cUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_A+"')"
		*!*		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL'  TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQpo")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQpo")
		*!*					
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF 
		*!*	IF nSQLEXEC < 0
		*!*		IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
		*!*		RETURN .F.
		*!*	ELSE
			
			SELECT SalesQuote
			REPLACE TOL WITH cTOL IN SalesQuote
			*WAIT WINDOW "Saved!" NOWAIT
		*ENDIF
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgProd.txtWO_Detail.Valid
		PRIVATE cTol
		cTol	= PrepareSQLtxt(This.Value,'Tol',20)
		
		*!*	PRIVATE cUpdate
		*!*	cUpdate = "UPDATE dbo.Sales SET "
		*!*	cUpdate = cUpdate + " TOL='"+cTol+"'"
		*!*	cUpdate = cUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_A+"')"
		*!*		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL'  TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQpo")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQpo")
		*!*					
