	PROCEDURE frmSales_Review.pf.pgShip.cmdCustomerTerms.Click
		PRIVATE cCompany
		IF NOT LEN(ALLTRIM(This.Parent.Parent.pgBillTo.txtCompany.Value))=0
			cCompany = ALLTRIM(This.Parent.Parent.pgBillTo.txtCompany.Value)
		ELSE
			cCompany = AllTrim(SalesQuote.Company)
		ENDIF
		
		IF FILE("forms\CustomerTerms.scx")
		
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
		
			DO FORM forms\CustomerTerms WITH cCompany 
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		ELSE
			MESSAGEBOX("FILE CustomerTerms.scx NOT FOUND!",0,'')
		ENDIF
		
		SELECT Sales_No	&&This was added to see if this Click code accidentally closed the 'Sales_No' table
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgShip.cmdEditShip.Click
		IF This.Caption = "Edit"
			ThisFormSet.Set_pgShip('Edit')
			This.Parent.cmdCancShip.Visible = .T.
			This.Caption = "Save"
		ELSE
			*"Save"
			IF ThisFormSet.Save_pgShip()
				ThisFormSet.Set_pgShip('Save')
				This.Parent.cmdCancShip.Visible = .F.
				This.Caption = "Edit"
			ENDIF
		ENDIF
		
		
	ENDPROC

