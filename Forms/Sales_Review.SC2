	PROCEDURE frmSales_Review.pf.pgShip.txtShipRoute.InteractiveChange
		PRIVATE nInsertionPt , lcSearchStr, cSearchStrOrig 
		
		nInsertionPt  = IIF(this.SelStart=0,20,this.SelStart)
		cSearchStrOrig = UPPER(substr(this.value,1,nInsertionPt ))
		lcSearchStr = ShowSQLtxt(cSearchStrOrig,'ShipRoute',20)
		
		
		IF NOT LEN(ALLTRIM(lcSearchStr))=0
			*Global Position for Array aShipRoutes
			gnPos = ASCAN(aShipRoutes, lcSearchStr ) 
			IF gnPos != 0
				this.VALUE=aShipRoutes(gnPos)
			ELSE
				this.value=cSearchStrOrig 
			ENDIF
		ELSE
			this.value=space(0)
		ENDIF
		this.selstart = nInsertionPt 
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgShip.txtShipRoute.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgShip.txtShipRoute.Valid
		PRIVATE cShipRoute, cUPSStandShipRoute, lOK
		lOK = .F.
		
		cShipRoute = ALLTRIM(ShowSQLtxt(This.Value,'ShipRoute',20))
		IF NOT LEN(ALLTRIM(cShipRoute))=0
		
			IF UPPER(LEFT(cShipRoute ,3)) = "UPS"
				*RETURN CheckUPSroute(cShipRoute)
				
				cUPSStandShipRoute = GetUPSStandShiproute(cShipRoute, ThisFormSet.nConnHandle )
				IF LEN(ALLTRIM( cUPSStandShipRoute ))=0
					lOK = .F.
					WAIT WINDOW "UPS Ship Route is misspelled, try again." NOWAIT
					RETURN .F.
				ELSE
					This.Value = cUPSStandShipRoute
					lOK = .T.
				ENDIF
			ELSE
				*IF NOT LEN(ALLTRIM(cShipRoute))=0
					lOK = .T.
				*ENDIF
			ENDIF
		ELSE 
			lOK = .F.
		ENDIF
		
		PRIVATE nSalesNum
		nSalesNum = PrepareSQLnum(ThisFormSet.nSalesNum,'SalesNum',-3)
		IF nSalesNum = 0
			lOK = .F.
		ENDIF
			
		IF NOT USED('Sales_No')
			TrackError("Lost table Sales_No","Lost table Sales_No",Program(),LINENO(1))
		ENDIF
			
		IF lOK
		
			SELECT Sales_No	&&Sales_No does not have items detail
			REPLACE ShipRoute WITH cShipRoute IN Sales_No
		
			WAIT WINDOW "Updated Ship Route" NOWAIT
		*	ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.chkBRK.Valid
		PRIVATE nDecimal, lMarkTypI
		lMarkTypI = .F.
		
		IF SalesQuote.Inv
			PRIVATE nBuyCost 
			nBuyCost = PrepareSQLnum(This.Parent.Parent.pgQuote.txtItemCost.Value,'ItemCost',9,2)
			*SalesQuote.ItemCost
			
		*	SELECT SalesQuote
		*	REPLACE SalesQuote.INV WITH .T. IN SalesQuote
			
			IF LEN(ALLTRIM(ShowSQLtxt(SalesQuote.Typ,'TYP',1)))=0
				*Typ is empty
				SELECT SalesQuote
				REPLACE SalesQuote.Typ WITH 'I'
				lMarkTypI = .T.
			ENDIF
			
			IF !EMPTY(nBuyCost)
				SELECT SalesQuote
				REPLACE SalesQuote.ItemCost WITH nBuyCost IN SalesQuote
			ENDIF
			
			SELECT SalesQuote
			IF lMarkTypI
				REPLACE SalesQuote.Typ WITH 'I' IN SalesQuote
			ENDIF
		
		ENDIF
		
		IF SalesQuote.Inv AND SalesQuote.Services
			MESSAGEBOX("You cannot have 'Inv' and 'Service' selected on same item.",48,"Please choose only one!")
		ENDIF
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.chkCancelItem.Click
		PRIVATE lCancel
		lCancel = PrepareSQLlogic( This.Value, 'Cancel',.F.)
		
		PRIVATE cSOitem, nSalesNum
		cSOitem = SalesQuote.SoItem_A
		nSalesNum = ThisFormSet.nSalesNum
		
		PRIVATE nMess
		IF lCancel 
			nMess = MESSAGEBOX("Are you sure you want to Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Cancel?")
			IF nMess != 6
				RETURN .F.
			ENDIF
		ELSE
			nMess = MESSAGEBOX("Are you sure you want to UN Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"UN Cancel?")
			IF nMess != 6
				RETURN .F.
			ENDIF
		ENDIF
		
		******************************************
		*Check to see if Invoiced
		IF SO_Invoiced( nSalesNum, ThisFormSet.nConnHandle )
			MESSAGEBOX("Cannot change this SO!"+CHR(13)+"SO has been Invoiced.",32,"Cannot Cancel?") 
			RETURN .F.
		ENDIF
		
		******************************************
		*Check to see if has been Processed!
		IF SOitem_PRCD( cSOitem, ThisFormSet.nConnHandle )
			MESSAGEBOX("Cannot change this SO!"+CHR(13)+"SO item has a Process History Recorded.",32,"Cannot Cancel?") 
			RETURN .F.
		ENDIF
		
		*IF SO_Complete(nSalesNum, ThisFormSet.nConnHandle) 
		
		**********************
		*IF lCancel 	
			*MESSAGEBOX("You are allowed to Cancel SOitem:"+ALLTRIM(cSOitem)+" ",4+32,"Cancel?")
		*	WAIT WINDOW "You are allowed to Cancel SOitem:"+ALLTRIM(cSOitem) NOWAIT
		*ENDIF
		
		PRIVATE nMess
		*********************
		IF lCancel 
			*Check for Allow PO Cancel AND then Cancel POitem
			PRIVATE nCntPOitem 
			nCntPOitem = 0
		
		*	nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnHandle )
			IF USED('tmpPOp')
				USE IN tmpPOp
			ENDIF
			
			cSQL = "SELECT PoItem, Reconciled, [cancelled] "
			cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			*cSQL = cSQL + " AND [cancelled] = 0"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOp')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOp' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOp")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOp")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOp' )
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('tmpPOp')
				IF RECCOUNT('tmpPOp') > 0
					SCAN
						
						cPOitem = tmpPOp.POitem
						IF NOT PrepareSQLlogic(tmpPOp.Reconciled,'Reconciled',.F.)
						
							IF NOT PrepareSQLlogic(tmpPOp.Cancelled,'Cancelled',.F.)
								
								nMess = MESSAGEBOX("Do you want to Cancel this POitem? "+cPOitem+" was to be used for this SOitem",4+32,"Cancel POitem?") 
								IF nMess = 6
									lOK = PurchaseOrder_Allow_Cancel(cPOitem,ThisFormSet.nConnHandle)
									IF lOK
										lOK = PurchaseOrder_POitem_Cancel(cPOitem, ThisFormSet.nConnHandle, .F.)
									ENDIF
								ELSE
									PO_Item_Notes(cPOitem,"EditSalesOrder:chkCancelItem Cancelled SOitem='"+cSOitem+"' and user choose not to Cancel POitem='"+cPOitem+"'")
									TrackMess("EditSalesOrder:chkCancelItem Cancelled SOitem='"+cSOitem+"' and user choose not to Cancel POitem='"+cPOitem+"'")
								ENDIF		
							ENDIF
						ENDIF
									
					ENDSCAN
					
				ENDIF
				USE IN tmpPOp
			ENDIF
		ENDIF
		
		*End checks
		***********************
		*Run Cancel or Uncancel code
		*
		*
			
		PRIVATE nWO, nWOD, cMess
		nWO = 0
		nWOD = 0
		
		IF lCancel
			********************************
			*Still in Cancel mode
			*
			*Cancel SO Item **SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
			IF Cancel_SOitem( cSOitem, .T., ThisFormSet.nConnHandle )  && .T. to Amend
				*now marks PrintedSO as 0  -still need new amendment
				*Calls: Amend_Sales_No_Ver()
				*Calls: Is_SOitem_OnHold()
				******************
				*Remove SOitem from WO
				PRIVATE nCntWO
				nCntWO = 0
		
				IF USED('tmpWOp')
					USE IN tmpWOp
				ENDIF
				
				cSQL = "SELECT WO, cncld FROM dbo.WorkOrder WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				*cSQL = cSQL + " AND [cncld] = 0"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOp")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOp' )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
				IF USED('tmpWOp')
					IF RECCOUNT('tmpWOp') > 0
						SCAN
					
							nWO = PrepareSQLnum(tmpWOp.WO,'WO',-3)
							IF nWO > 0				
								cSQL = "UPDATE dbo.WorkOrder SET SOitem = '' "
								cSQL = cSQL + " WHERE WO = "+STR(nWO)
								
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
											
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '' )
										RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
									ENDIF
								ENDIF
								
								cMess = "Cancelled SOitem '"+cSOitem+"' and removed SOitem from WO "+STR(nWO)
								TrackMess(cMess)
							ENDIF
						ENDSCAN
						
					ENDIF
					USE IN tmpWOp
				ENDIF
		
		
				***********************
				*Remove WO_Detail from SOitem
				
				PRIVATE nCntWOD
				nCntWOD = 0
		
				IF USED('tmpWODp')
					USE IN tmpWODp
				ENDIF
				
				cSQL = "SELECT WO_Detail, fCmplt FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
				cSQL = cSQL + " WHERE fSOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				*cSQL = cSQL + " AND [fCmplt] = 0"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWODp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWODp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWODp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWODp")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWODp' )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
				IF USED('tmpWODp')
					IF RECCOUNT('tmpWODp') > 0
						SCAN			
							nWOD = PrepareSQLnum(tmpWODp.WO_Detail,'WO_Detail',-3)
							
							cSQL = "UPDATE dbo.WorkOrder_Detail SET fSOitem = '' "
							cSQL = cSQL + " WHERE WO_Detail = "+STR(nWOD)
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
										
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '' )
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								ENDIF
							ENDIF
							
							cMess = "Cancelled SOitem '"+cSOitem+"' and removed SOitem from WO_Detail "+STR(nWOD)
							TrackMess(cMess)
		
						ENDSCAN
					ENDIF
					USE IN tmpWODp
				ENDIF
		
				************************************
				SELECT SalesQuote
				PRIVATE nCurrSalesNumRec 
				nCurrSalesNumRec = RECNO('SalesQuote')
				
				SELECT SalesTotal
				UPDATE SalesTotal SET Cncld = .T. WHERE Item = SalesTotal.item
				
				*****
				IF Count_SOIteminSales(cSOItem, ThisFormSet.nConnHandle, "NOTCANCEL") = 0
					*All are Cancelled
					IF NOT PrepareSQLLogic(This.parent.parent.pgBillTo.chkCancelSO.Value,'Cancel SO')
						
						SELECT Sales_No	&&Sales_No does not have items details
						REPLACE Cncld  WITH .T. IN Sales_No
						This.parent.parent.pgBillTo.chkCancelSO.Refresh
						
					ENDIF
				ENDIF
				
				************************************
				*Cancel_SOitem Increase the Amendment or Ver num!!
				*cSQL = "SELECT Amendment FROM  WHERE SalesNum = "+STR(nSO)
				nAmendment = Get_Amendment_Sales_No (nSalesNum, ThisFormSet.nConnHandle)
				
				SELECT Sales_No	
				*REPLACE Cncld  WITH .F. IN Sales_No
				
				REPLACE Amendment WITH nAmendment IN Sales_No
				ThisFormSet.nAmendment = nAmendment 
				ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value = nAmendment 
				
				REPLACE ShopRecv WITH .F. IN Sales_No
				ThisFormSet.lShopRecvSO = .F.
				ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
				ThisFormSet.frmEO.pf1.pgQA.chkShopRecv.Value		= ThisFormSet.lShopRecvSO
				
				
				This.Parent.Parent.pgOrder.chkCancelItem.Refresh
				
				************************************
				SELECT SalesQuote
				REPLACE Cncld WITH .T. IN SalesQuote
				
				SELECT SalesQuote
				GOTO (nCurrSalesNumRec)
				
			
				************************************		
				ThisFormSet.Set_Sales_No_Chng()
				
				
				*MESSAGEBOX( "You must click 'SAVE' to make this 'SO Item' change permanent."+CHR(13)+"All other tables have been updated!",0+64,"Remember to click Save.")			
				MESSAGEBOX("The Sales Order has changed and needs to be printed."+CHR(13)+"Per ISO, HPA needs the paper trail of this cancel!",0+64,"Remember to Print.")			
				
				TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been marked as 'Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
				*send to messenger
				IF nWO > 0 OR nWOD > 0
					 IF nWO > 0
					 	TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been removed ("+DTOC(DATE())+")" +" from WO="+ALLTRIM(STR(nWO)) )
					 ENDIF
					 IF nWOD > 0
					 	TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been removed ("+DTOC(DATE())+")" +" from WO_Detail="+ALLTRIM(STR(nWOD)) )
					 ENDIF
				ENDIF
			ENDIF
		
			*end cancel mode
		ELSE
			*uncancel -------------------------------
			
			*UNCancel SO Item
			IF UNCancel_SOitem( cSOitem, .T., ThisFormSet.nConnHandle ) && .T. to Amend
				
				SELECT SalesQuote
				PRIVATE nCurrSalesNumRec 
				nCurrSalesNumRec = RECNO('SalesQuote')
				
				SELECT SalesTotal
				UPDATE SalesTotal SET Cncld = .F. WHERE Item = SalesTotal.item
				
				**********************
				SELECT SalesQuote
				REPLACE Cncld WITH .F. IN SalesQuote
				
				SELECT SalesQuote
				GOTO (nCurrSalesNumRec)
				
				ThisFormSet.Set_Sales_No_Chng()
		
				TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
			ENDIF
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.chkCg.Valid
		
		PRIVATE lCG
		lCG	= PrepareSQLlogic(This.Value,'CG',.F.)
		
		*!*	PRIVATE cUpdate
		*!*	cUpdate = "UPDATE dbo.Sales SET "
		*!*	cUpdate = cUpdate + " CG="+IIF(lCG,"1","0")+""
		*!*	cUpdate = cUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_A+"')"
		*!*		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL'  TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
		*!*				
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
		*!*		RETURN .F.
		*!*	ELSE
			SELECT SalesQuote
			REPLACE CG WITH lCG IN SalesQuote
			*WAIT WINDOW "Saved!" NOWAIT
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.chkInv.Valid
		PRIVATE nDecimal, lMarkTypI
		lMarkTypI = .F.
		
		IF SalesQuote.Inv
			PRIVATE cSoItem, nBuyCost 
			cSOitem	= ThisFormSet.cSOItem
			nBuyCost = PrepareSQLnum(This.Parent.Parent.pgQuote.txtItemCost.Value,'ItemCost',9,2)
			*SalesQuote.ItemCost
			
		*	SELECT SalesQuote
		*	REPLACE SalesQuote.INV WITH .T. IN SalesQuote
			
			IF LEN(ALLTRIM(ShowSQLtxt(SalesQuote.Typ,'TYP',1)))=0
				*Typ is empty
				SELECT SalesQuote
				REPLACE SalesQuote.Typ WITH 'I'
				lMarkTypI = .T.
			ENDIF
			
			IF !EMPTY(nBuyCost)
				SELECT SalesQuote
				REPLACE SalesQuote.ItemCost WITH nBuyCost IN SalesQuote
			ENDIF
			
			SELECT SalesQuote
			IF lMarkTypI
				REPLACE SalesQuote.Typ WITH 'I' IN SalesQuote
			ENDIF
		
		ENDIF
		
		IF SalesQuote.Inv AND SalesQuote.Services
			MESSAGEBOX("You cannot have 'Inv' and 'Service' selected on same item.",48,"Please choose only one!")
		ENDIF
		
	ENDPROC

