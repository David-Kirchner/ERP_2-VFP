		*	cSQLu = cSQLu + ",ShipDue='"+DTOC(dShipDue)+"'"
		*ENDIF
		*IF NOT EMPTY(dShipped)
		*	cSQLu = cSQLu + ",Shipped='"+DTOC(dShipped)+"'"
		*ENDIF
		
		*cSQLu = cSQLu + ",MatlWt="+STR(nMatlWt,9,1)
		*cSQLu = cSQLu + ",Cncld="+IIF(lcncld,"1","0")
		*cSQLu = cSQLu + ",Cmplt="+IIF(lCmplt,"1","0")
		
		*cSQLu = cSQLu + ",PartNo='"+ALLTRIM(cPartNo)+"'"
		*cSQLu = cSQLu + ",ItemCost="+STR(nItemCost,9,2)
		*cSQLu = cSQLu + ",ItemSale="+STR(nItemSale,9,2)
		
		*cSQLu = cSQLu + ",StkPaid= "+STR(PrepareSQLnum(nStkPaid,'StkPaid',9,2),9,2)
		*cSQLu = cSQLu + ",StkCost= "+STR(PrepareSQLnum(nSTKCost,'StkCost',9,2),9,2)
		*cSQLu = cSQLu + ",POCost= "+STR(PrepareSQLnum(nPOCost,'POCost',9,2),9,2)
		
		*cSQLu = cSQLu + ",Quoted_QTY = "+STR(nQuoted_QTY,18,4)
		*cSQLu = cSQLu + ",Quoted_P = "+STR(nQuoted_P,18,4)
		*cSQLu = cSQLu + ",Quoted_Total = "+STR(nQuoted_Total,18,4)
		*cSQLu = cSQLu + ",Quoted_PU = "+STR(nQuoted_PU)
		
		*,[gs_cost],[gs_sale],[gs_cmplt]
		cSQLu = cSQLu + " RMA_No="+ALLTRIM(STR(nRMA_No))
		cSQLu = cSQLu + ",RMA_Detail="+ALLTRIM(STR(nRMA_Detail))
		
		*,[QA],[CofC],[Merc],[pPo],[pPn],[pHeat],[pSpec],[pDesc],[pOther],[Other]
		*,[prcp],[prcd],[pckd]
		*cSQLu = cSQLu + ",[ShipOn]="+IIF(lShipOn,"1","0")
		*cSQLu = cSQLu + ",Urgent='"+cUrgent+"'"
		
		*cSQLu = cSQLu + ",Tol='"+ALLTRIM(cTol)+"'"
		*cSQLu = cSQLu + ",JobHours="+STR(nJobHours)+""
		*cSQLu = cSQLu + ",ProcLoc='"+cProcLoc+"'"
		
		*,[Quoted_OtherP],[Quoted_PT_CutsP]
		*cSQLu = cSQLu + ",DShip="+IIF(lDShip,"1","0") 	
		*cSQLu = cSQLu + ",TYP='"+cTYP+"'"  
		*[ProductionWO]
		*cSQLu = cSQLu + ",[WO]="+STR(nWO)+""
		*cSQLu = cSQLu + ",[WO_Detail]="+STR(nWO_Detail)+""
		*cSQLu = cSQLu + ",[Export]="+IIF(lExport,"1","0")
		*,[RcvdE],[RMA_E]
		
		cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.csoitem+"')"
		
		WAIT WINDOW "Saved to dbo.Sales table" NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
				lReturn = .F.
				lRollBack = .T.
			ENDIF
		ENDIF
		
		
		
		
		***************************************
		
		cSQL = "UPDATE dbo.Sales_No SET "
		*cSQL = cSQL + ",[SalesRep]= '"+cCalesRep+"'"*,[]
		cSQL = cSQL + " [instrct]= '"+cS_Instrct+"'"
		*,[itemtot]
		cSQL = cSQL + ",[pSoldAddr]= "+STR(pSoldAddr)
		cSQL = cSQL + ",[pShipAddr]= "+STR(pShipAddr)
		cSQL = cSQL + ",[ShipRoute]= '"+cShipRoute+"'"
		cSQL = cSQL + ",[ShipPay]= '"+cShipPay+"'"
		cSQL = cSQL + ",[PayType]= '"+cPayType+"'"
		*,[CustID]
		cSQL = cSQL + ",[Paper_PO]= "+IIF(lPaper_PO,'1','0')+""
		*cSQL = cSQL + ",Cncld="+IIF(lCancelSO,'1','0')+"" **Do not change Cncld here!!
		*,[cmplt]
		cSQL = cSQL + ",[Blind]= "+IIF(lblind,'1','0')+""
		*,[emailconf]
		cSQL = cSQL + ",[FreightEst]= "+STR(nFreightEst)
		*,[EverPrint]
		*,[printedso]
		*,[emailedps]
		*,[faxedps]
		*,[addr_ref]
		*,[trt_lumber]
		cSQL = cSQL + ",[TarfBill]= '"+cTarfBill+"'"
		*cSQL = cSQL + ",USA= "+IIF(llUSA,'1','0')+""
		*cSQL = cSQL + ",ECPC= "+IIF(lECPC,'1','0')+""
		*cSQL = cSQL + ",Amendment= "+STR(lnAmendment,2,0)+""
		*,[ShopRecv]
		*cSQL = cSQL + ",Changing=1 "+" "		&&mark as Changing
		*,[webnum]
		*cSQL = cSQL + ",DPAS= "+IIF(lDPAS,'1','0')+""
		*cSQL = cSQL + ",FCI= "+IIF(lFCI,'1','0')+""
		*cSQL = cSQL + ",GOV= "+IIF(lGOV,'1','0')+""
		*,[BillInstrct]
		
		
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.nSalesNum))
				
		WAIT WINDOW "UPDATE dbo.Sales_No " NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				lReturn = .F.
				*lRollBack = .T.
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE save_pgstock
		*ThisFormSet.Save_pgStock()
		
		*!*	*ThisFormSet.frmSales_Review.pf.pgStock.txtPT_Total.Enabled = .T.
		
		PRIVATE nCert,cProcLoc,cTYP,lExport, lService
		nCert	= PrepareSQLnum(ThisFormSet.frmSales_Review.pf.pgStock.cmbCert.Value,'Cert',1,0)
		cProcLoc = PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgStock.cmbProcLoc.Value,'ProcLoc',1)
		cTYP	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgStock.cmbTYP.Value,'TYP',1)
		*lExport	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkExport.Value,'Export',.F.)
		
		PRIVATE  lService,lInv, lBRK, lMach, lCG, cTol, lPlasma, lWJet
		lService=  PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkService.Value,'Service',.F.)
		lInv	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkInv.Value,'INV',.F.)
		lBRK	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkBRK.Value,'BRK',.F.)
		lMach	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkMach.Value,'Mach',.F.)
		lCG		= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkCG.Value,'CG',.F.)
		cTol	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgStock.txtTol.Value,'Tolerance',20)
		lPlasma	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkPlasma.Value,'Plasma',.F.)
		lWJet	= PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkWJet.Value,'WJet',.F.)
		
		PRIVATE cPartNo, cOrderSpec, cS_Instrct
		cPartNo		= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgStock.txtPartNo.Value,'Part Number',100,.F.)
		cOrderSpec	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgStock.txtOrderSpec.Value,'Order Spec',60,.F.)
		cS_Instrct	= PrepareSQLtxt(ThisFormSet.frmSales_Review.pf.pgStock.edtQuote_S_Instrct.Value,'Special Instructions',0,.f.)
		
		*nItemCost = PrepareSQLnum(SalesQuote.ItemCost,'ItemCost',9,2)
		*nItemSale = PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',9,2)
		
		************************************************
		*Set Router p_rtr_Oper
		*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"INV",lInv,lCncld,ThisFormSet.nConnHandle)
		PRIVATE lCncld, lCmplt
		lCncld = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkCncld.Value,'Cncld',.F.)
		lCmplt = PrepareSQLlogic(ThisFormSet.frmSales_Review.pf.pgStock.chkCmplt.Value,'Cmplt',.F.)
		
		IF NOT ( lCncld OR lCmplt )
			*Not Cancelled, make sure POitem work is scheduled.
		
			IF cTYP='S' &&lService
				*Toll Service
				*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Toll Service",lInv,ThisFormSet.nConnHandle)
			ENDIF	 
			IF lInv
				*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Pull Material",lInv,ThisFormSet.nConnHandle) --Done in Select Stock
			ENDIF
			IF lBRK
				*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Pull Material",lBRK,ThisFormSet.nConnHandle) --Done in Select Stock
			ENDIF
		
			IF lMach
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Machine Shop",lMach,ThisFormSet.nConnHandle)
			ENDIF
			IF lCG
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Centerless Grinder",lCG,ThisFormSet.nConnHandle)
			ENDIF
			IF lPlasma
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Plasma Cut",lPlasma,ThisFormSet.nConnHandle)
			ENDIF
			IF lWJet
				rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Waterjet",lWJet,ThisFormSet.nConnHandle)
			ENDIF
			*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Testing", ,ThisFormSet.nConnHandle)
			*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Peel", ,ThisFormSet.nConnHandle)
		
		ENDIF		
		
		***************************************************
		PRIVATE cSQLu
			
		cSQLu = "UPDATE dbo.Sales SET "
		cSQLu = cSQLu + " OrderSpec='"+ALLTRIM(cOrderSpec)+"'"
		cSQLu = cSQLu + ",S_Instrct='"+ALLTRIM(cS_Instrct)+"'"
		cSQLu = cSQLu + ",Inv="+IIF(lInv,"1","0")
		cSQLu = cSQLu + ",BRK="+IIF(lBRK,"1","0")
		*cSQLu = cSQLu + ",GFM="+IIF(lGFM,"1","0")
		*cSQLu = cSQLu + ",Draw="+IIF(lDraw,"1","0")
		*cSQLu = cSQLu + ",Roll="+IIF(lRoll,"1","0")
		*cSQLu = cSQLu + ",Press="+IIF(lPress,"1","0")
		cSQLu = cSQLu + ",Mach="+IIF(lMach,"1","0")
		cSQLu = cSQLu + ",CG="+IIF(lCG,"1","0")
		cSQLu = cSQLu + ",Tol='"+cTol+"'"
		cSQLu = cSQLu + ",Plasma="+IIF(lPlasma,"1","0")
		cSQLu = cSQLu + ",WJet="+IIF(lWJet,"1","0")
		*cSQLu = cSQLu + ",ColdSaw="+IIF(lColdSaw,"1","0")
		
		cSQLu = cSQLu + ",Cert="+STR(nCert)
		*cSQLu = cSQLu + ",ShipON="+IIF(lShipOn,"1","0")
		
		*IF NOT EMPTY(dShipDue)
		*	cSQLu = cSQLu + ",ShipDue='"+DTOC(dShipDue)+"'"
		*ENDIF
		*IF NOT EMPTY(dShipped)
		*	cSQLu = cSQLu + ",Shipped='"+DTOC(dShipped)+"'"
		*ENDIF
		
		*cSQLu = cSQLu + ",MatlWt="+STR(nMatlWt,9,1)
		*cSQLu = cSQLu + ",Cncld="+IIF(lcncld,"1","0")
		*cSQLu = cSQLu + ",Cmplt="+IIF(lCmplt,"1","0")
		
		cSQLu = cSQLu + ",PartNo='"+ALLTRIM(cPartNo)+"'"
		*cSQLu = cSQLu + ",ItemCost="+STR(nItemCost,9,2)
		*cSQLu = cSQLu + ",ItemSale="+STR(nItemSale,9,2)
		
		*cSQLu = cSQLu + ",StkPaid= "+STR(PrepareSQLnum(nStkPaid,'StkPaid',9,2),9,2)
		*cSQLu = cSQLu + ",StkCost= "+STR(PrepareSQLnum(nSTKCost,'StkCost',9,2),9,2)
		*cSQLu = cSQLu + ",POCost= "+STR(PrepareSQLnum(nPOCost,'POCost',9,2),9,2)
		
		*cSQLu = cSQLu + ",Quoted_QTY = "+STR(nQuoted_QTY,18,4)
		*cSQLu = cSQLu + ",Quoted_P = "+STR(nQuoted_P,18,4)
		*cSQLu = cSQLu + ",Quoted_Total = "+STR(nQuoted_Total,18,4)
		*cSQLu = cSQLu + ",Quoted_PU = "+STR(nQuoted_PU)
		
		*,[gs_cost],[gs_sale],[gs_cmplt]
		
		*cSQLu = cSQLu + ",RMA_No="+ALLTRIM(STR(nRMA_No))
		*cSQLu = cSQLu + ",RMA_Detail="+ALLTRIM(STR(nRMA_Detail))
		
		*,[QA],[CofC],[Merc],[pPo],[pPn],[pHeat],[pSpec],[pDesc],[pOther],[Other]
		*,[prcp],[prcd],[pckd]
		*cSQLu = cSQLu + ",[ShipOn]="+IIF(lShipOn,"1","0")
		*cSQLu = cSQLu + ",Urgent='"+cUrgent+"'"
		
		*cSQLu = cSQLu + ",JobHours="+STR(nJobHours)+""
		cSQLu = cSQLu + ",ProcLoc='"+cProcLoc+"'"
		
		*[Quoted_OtherP],[Quoted_CutsP]
		*cSQLu = cSQLu + ",DShip="+IIF(lDShip,"1","0") 	
		cSQLu = cSQLu + ",TYP='"+cTYP+"'"  
		*,[WO],[WO_Detail],[ProductionWO]
		*cSQLu = cSQLu + ",[Export]="+IIF(lExport,"1","0")
		*,[RcvdE],[RMA_E]
		
		cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.csoitem+"')"
		
		WAIT WINDOW "Saved to dbo.Sales table" NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
				lReturn = .F.
				lRollBack = .T.
			ENDIF
		ENDIF
		
		
		*!*	IF lCncld 
		*!*		*Remove Cancelled process from StockLst and BrokerLst
		*!*		
		*!*		*Remove_ID_Detail_Process(m.ID_Detail_Process,"SOitem",ThisFormSet.cSOItem,cTbl,pConnHandle,"CANCELLED")
		*!*		IF Cancel_Detail_Process_SOitem(ThisFormSet.cSOItem,ThisFormSet.nConnHandle)
		*!*			
		*!*		ENDIF
		*!*		
		*!*	ENDIF
		
		***************************************
		***************************************
		
		
		cSQL = "UPDATE dbo.Sales_No SET "
		*cSQL = cSQL + ",[SalesRep]= '"+cCalesRep+"'"*,[]
		cSQL = cSQL + " [instrct]= '"+cS_Instrct+"'"
		*,[itemtot]
		*cSQL = cSQL + ",[pSoldAddr]= "+STR(pSoldAddr)
		*cSQL = cSQL + ",[pShipAddr]= "+STR(pShipAddr)
		*cSQL = cSQL + ",[ShipRoute]= '"+cShipRoute+"'"
		*cSQL = cSQL + ",[ShipPay]= '"+cShipPay+"'"
		*cSQL = cSQL + ",[PayType]= '"+cPayType+"'"
		*,[CustID]
		*cSQL = cSQL + " [Paper_PO]= "+IIF(lRecvSO,'1','0')+""
		*cSQL = cSQL + ",Cncld="+IIF(lCancelSO,'1','0')+"" **Do not change Cncld here!!
		*,[cmplt]
		*cSQL = cSQL + ",[Blind]= "+IIF(lblind,'1','0')+""
		*cSQL = cSQL + " [EmailConf]= "+IIF(lEmailConf,'1','0')+""
		*cSQL = cSQL + ",[nFreightEst]= "+STR(nFreightEst)
		*,[EverPrint]
		*cSQL = cSQL + ",[PrintedSO]= "+IIF(lPrintedSO,'1','0')+""
		*,[emailedps]
		*,[faxedps]
		*,[addr_ref]
		*,[trt_lumber]
		*cSQL = cSQL + ",[TarfBill]= '"+cTarfBill+"'"
		*cSQL = cSQL + ",USA= "+IIF(llUSA,'1','0')+""
		*cSQL = cSQL + ",ECPC= "+IIF(lECPC,'1','0')+""
		*cSQL = cSQL + ",Amendment= "+STR(nAmendment,2,0)+""
		*,[ShopRecv]
		*cSQL = cSQL + ",Changing=1 "+IIF(lSOChanging,'1','0')+""
		*,[webnum]
		*cSQL = cSQL + ",DPAS= "+IIF(lDPAS,'1','0')+""
		*cSQL = cSQL + ",FCI= "+IIF(lFCI,'1','0')+""
		*cSQL = cSQL + ",GOV= "+IIF(lGOV,'1','0')+""
		*cSQL = cSQL + ",[BillInstrct]= '"+cBillInstrct+"'"
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.nSalesNum))
				
		WAIT WINDOW "UPDATE dbo.Sales_No " NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				lReturn = .F.
				*lRollBack = .T.
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		***********************
		
		
				***** ...Lst_Process
				IF NOT EMPTY(SalesQuote.ShipDue) OR SalesQuote.ShipDue = CTOD("01/01/1900")
					IF NOT ISNULL(SalesQuote.ShipDue)
						PRIVATE cSQLUpdate
						cSQLUpdate = "UPDATE dbo.StockLst_Process "
						cSQLUpdate = cSQLUpdate + " SET DueDate = '"+IIF(EMPTY(SalesQuote.ShipDue),'',DTOC(SalesQuote.ShipDue))+"'"
						cSQLUpdate = cSQLUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
						cSQLUpdate = cSQLUpdate + " AND ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
						
						WAIT WINDOW "UPDATE dbo.StockLst_Process " NOWAIT
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLUpdate)
			
					ENDIF
				ENDIF
		*ENDSCAN
		
		
		
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE save_pgverify
		*ThisFormSet.Save_pgVerify()
	ENDPROC

	PROCEDURE save_rvw_prod
		*ThisForm.Save_RVW_Prod()
		
		PRIVATE lCancel, lComplete
		lCancel	= ThisFormSet.frmSales_Review.lblCancelled.Visible
		lComplete = ThisFormSet.frmSales_Review.lblComplete.Visible
		
		
		PRIVATE nMess
		nMess = MESSAGEBOX("Are you sure you want to mark this SOitem "+ThisFormSet.cSOItem+" as REVIEWED?",4+32,"Reviewed")
		IF nMess = 6 &&yes
			PRIVATE cType
			cType = ThisFormSet.frmSales_Review.lblTyp.Caption
			
			IF cType = "P" OR cType = "S" OR cType = "C"	
				PRIVATE cSQL, nSQLEXEC 
				cSQL = "UPDATE dbo.Sales "
				cSQL = cSQL + " SET RVW_Prod = 1 "
			*	ELSE
			*		cSQL = cSQL + " SET Review = 1 "
			*		cSQL = cSQL + ",Review_Date = GETDATE() "
			*		cSQL = cSQL + ",RVW_Prod = 1 "
			*		cSQL = cSQL + ",RVW_Stock = 1 "
				ENDIF
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
		
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
						ThisFormSet.frmSales_Review.pf.pgProd.chkRVW_Prod.Value = .F.
					ELSE
						nSQLEXEC = 1
					ENDIF
				ENDIF
				IF nSQLEXEC > 0
					ThisFormSet.frmSales_Review.pf.pgProd.chkRVW_Prod.Value = .T.
		*!*				IF cType = "PROD"
		*!*					ThisForm.chkRVW_Stock.Value = .T.
		*!*				ELSE
		*!*					ThisForm.chkReview.Value = .T.
		*!*					ThisForm.chkRVW_Stock.Value = .T.
		*!*					ThisForm.chkRVW_Prod.Value = .T.
		*!*					
		*!*					ThisFormSet.frmQuote.chkReview.Value = 1
		*!*				ENDIF	
					
					ThisFormSet.frmSales_Review.cmdClearReview.Visible = .T.
		
				ENDIF
		*	ENDIF
		ENDIF
	ENDPROC

	PROCEDURE save_rvw_stock
		*ThisFormSet.Save_RVW_Stock()
		
		
		PRIVATE lCancel, lComplete
		lCancel	= ThisFormSet.frmSales_Review.lblCancelled.Visible
		lComplete = ThisFormSet.frmSales_Review.lblComplete.Visible
		
		
		PRIVATE lRVW_Stock
		lRVW_Stock = .T.
		
		PRIVATE cType
		cType = ThisFormSet.frmSales_Review.lblTyp.Caption
		PRIVATE nMess
		nMess = MESSAGEBOX("Are you sure you want to mark this SOitem "+ThisFormSet.cSOItem+" as REVIEWED?",4+32,"Reviewed")
		IF nMess = 6 &&yes
			
			IF cType = "I" OR cType = "M"	
				PRIVATE cSQL, nSQLEXEC 
				cSQL = "UPDATE dbo.Sales "
				cSQL = cSQL + " SET RVW_Stock = 1 "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
		
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
						ThisFormSet.frmSales_Review.pf.pgStock.chkRVW_Stock.Value = .F.
						ThisFormSet.frmSales_Review.pf.pgProd.chkRVW_Stock.Value = .F.
					ELSE
						nSQLEXEC = 1
					ENDIF
				ENDIF
				IF nSQLEXEC > 0
					ThisFormSet.frmSales_Review.pf.pgStock.chkRVW_Stock.Value = .T.
					ThisFormSet.frmSales_Review.pf.pgProd.chkRVW_Stock.Value = .T.
					
			*!*				ThisForm.chkRVW_Stock.Value = .T.
			*!*				ThisForm.chkReview.Value = .T.
		
			*!*				ThisForm.chkRVW_Stock.Value = .T.
			*!*				ThisForm.chkRVW_Prod.Value = .T.
			*!*				
			*!*				ThisFormSet.frmQuote.chkReview.Value = 1
			*!*			ENDIF	
					
					ThisFormSet.frmSales_Review.cmdClearReview.Visible = .T.
		
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE save_salesquote
		*ThisFormSet.Save_SalesQuote()
		
		PRIVATE cOrderSpec, cS_Instrct, lInv, lBRK, lGFM, lDraw, lRoll, lPress, lMach, lCG, cTol, lPlasma, lWJet
		PRIVATE nCert,cProcLoc,cTYP,lExport, cUrgent
		*PRIVATE nConverPO,cConverter,cConversion,cConverFrt,dConverSent,dConverRetu
		PRIVATE llShipOn ,dShipDue,dShipped,lDShip, lPODShip
		PRIVATE nMatlWt
		PRIVATE lcncld,lcmplt,cPartNo,nRMA_No
		PRIVATE nItemCost, nItemSale
		PRIVATE	lST_FoundCost, nST_ItemSale, nST_ItemCost, nST_StkCost, nST_StkPaid, nST_POCost
		lST_FoundCost	= .F.
		nST_ItemSale	= 0
		nST_ItemCost	= 0
		nST_StkCost		= 0
		nST_StkPaid		= 0
		nST_POCost		= 0
		
			
		SELECT SalesQuote
		SCAN
			IF NOT lRollBack 
						
				cOrderSpec = PrepareSQLtxt(SalesQuote.OrderSpec,'Order Spec',60,.F.)
				cS_Instrct = PrepareSQLtxt(SalesQuote.S_Instrct,'Special Instructions',0,.f.)
				lInv = PrepareSQLlogic(SalesQuote.Inv,'INV',.F.)
				lBRK = PrepareSQLlogic(SalesQuote.BRK,'BRK',.F.)
				lGFM = PrepareSQLlogic(SalesQuote.GFM,'GFM',.F.)
				lDraw = PrepareSQLlogic(SalesQuote.Draw,'Draw',.F.)
				lRoll = PrepareSQLlogic(SalesQuote.Roll,'Roll',.F.)
				lPress = PrepareSQLlogic(SalesQuote.Press,'Press',.F.)
				lMach = PrepareSQLlogic(SalesQuote.MACH,'Mach',.F.)
				lCG	= PrepareSQLlogic(SalesQuote.CG,'CG',.F.)
				cTol = PrepareSQLtxt(SalesQuote.Tol,'Tolerance',20)
				IF lCG AND LEN(ALLTRIM(cTol))=0
					MESSAGEBOX("Please enter a CG Tolerance on SO-Item:"+ALLTRIM(SalesQuote.SoItem_a)+"!",0+64,"Found CG job with no Tolerance.")
				ENDIF
				lPlasma = PrepareSQLlogic(SalesQuote.Plasma,'Plasma',.F.)
				lWJet = PrepareSQLlogic(SalesQuote.WJet,'WJet',.F.)
				nCert = PrepareSQLnum(SalesQuote.Cert,'Cert',1,0)
				cProcLoc = PrepareSQLtxt(SalesQuote.ProcLoc,'ProcLoc',1)
				lExport	= PrepareSQLlogic(SalesQuote.Export,'Export',.F.)
				cUrgent	= PrepareSQLtxt(SalesQuote.Urgent,'Urgent',1)
		
				llShipOn = PrepareSQLlogic( SalesQuote.ShipOn,'ShipOn',.F.)
				*llShipOn = PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgQuote.chkShipOn.Value,'ShipOn',.F.)
				dShipDue = PrepareSQLdate(SalesQuote.ShipDue,'Ship Due',.T.)
				dShipped = PrepareSQLdate(SalesQuote.Shipped,'Shipped')
				
				lPODShip = SO_have_PO_DShip( ThisFormSet.cSOItem, ThisFormSet.nConnHandle ) && ShipWhere = 2 OR ShipWhere = 4 OR ShipWhere = 6
				lDShip   = lPODShip
				*lDShip	 = PrepareSQLlogic(SalesQuote.DShip,'DShip',.F.)
				
				nMatlWt = PrepareSQLnum(SalesQuote.matlWt,'Material Weight',9,1)
				lCncld = PrepareSQLlogic(SalesQuote.cncld,'Cancelled',.F.)
		
				cPartNo = PrepareSQLtxt(SalesQuote.PartNo,'Part Number',100,.F.)
				nItemCost = PrepareSQLnum(SalesQuote.ItemCost,'ItemCost',9,2)
				nItemSale = PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',9,2)
				nRMA_No = PrepareSQLnum(SalesQuote.RMA_No,'RMA No',-3)
				
				cTYP = PrepareSQLtxt(SalesQuote.TYP,'TYP',1)
		
		*!*			IF USED('SalesTotal')
		*!*				SELECT SalesTotal
		*!*				LOCATE FOR Item = SalesQuote.Item
		*!*				IF FOUND('SalesTotal')
		*!*					lFoundCost	= .T.
		*!*					nItemCost	= PrepareSQLnum(SalesTotal.ItemCost  ,'ItemCost',9,2)
		*!*					nStkCost	= PrepareSQLnum(SalesTotal.ItemSkCost,'StkCost',9,2)
		*!*					nStkPaid	= PrepareSQLnum(SalesTotal.ItemSKPaid,'StkPaid',9,2)
		*!*					nPOCost		= PrepareSQLnum(SalesTotal.ItemPOCost,'POCost',9,2)
		*!*				ENDIF
		*!*				
		*!*				SELECT SalesQuote
		*!*			ENDIF
		
		
				PRIVATE nQuoted_PU, nQuoted_QTY, nQuoted_P, nQuoted_Total
				
				PRIVATE nCuts, nOtherP
				nQuoted_PU = PrepareSQLnum(SalesQuote.Q_PU,'PU',1)
				IF nQuoted_PU = 0
					*Old data, find PU Standard from Form
					nQuoted_PU = GetPUfromForm( SalesQuote.Form, ThisFormSet.nConnHandle )
				ENDIF
				***
				nQuoted_QTY	= PrepareSQLnum(SalesQuote.Q_QTY,'Q_QTY',-5)
				IF nQuoted_QTY = 0
					nQuoted_QTY	= get_QTYwithWeight( SalesQuote.Form,SalesQuote.Pieces,SalesQuote.Thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.Weight, nQuoted_PU, ThisFormSet.nConnHandle)
				ENDIF
				***
				nQuoted_P = PrepareSQLnum(SalesQuote.Q_P,'Q_P',-5)
				IF nQuoted_P = 0
					nQuoted_P = PrepareSQLnum(SalesQuote.Quoted_P,'Quoted_P',-5)
				ENDIF
				***
				
				nQ_Total = PrepareSQLnum(SalesQuote.Q_P*SalesQuote.Q_QTY,'Quoted_Total',-5)
				nCuts	= PrepareSQLnum(SalesQuote.Cuts,'Cuts',8,2)
				nOtherP	= PrepareSQLnum(SalesQuote.OtherP,'OtherP',8,2)
		
				nQuoted_Total = PrepareSQLnum(SalesQuote.Quoted_Total,'Quoted_Total',-5)
				
				IF nQuoted_Total = 0
					nQ_Total = PrepareSQLnum((nQuoted_QTY*nQuoted_P),'Quoted_Total',-5)
					nQuoted_Total = nQ_Total
					IF Quoted_Total = 0
						nQuoted_Total = PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',9,2)
					ENDIF
				ENDIF
				
				***
				IF nQ_Total > 0 
					*make sure there is a P and QTY
					IF nQuoted_QTY = 0 AND nQuoted_P > 0
						nQ_Total = nQuoted_QTY / nQuoted_P
						IF nItemSale # (nQ_Total +nCuts +nOtherP)
							nItemSale = nQ_Total +nCuts +nOtherP		
						ENDIF
					ENDIF
					IF nQuoted_QTY > 0 AND nQuoted_P = 0
						nQuoted_P = nQ_Total / nQuoted_QTY
						IF nItemSale # (nQ_Total +nCuts +nOtherP)
							nItemSale = nQ_Total +nCuts +nOtherP
						ENDIF
					ENDIF
					
					IF nItemSale = 0
						nItemSale = nQuoted_Total +nCuts +nOtherP
					ENDIF
				ENDIF
				
				IF ROUND(nQuoted_Total/10,0) <> ROUND(nItemSale/10,0)
					PRIVATE cMess 
					cMess = "SO item '"+ThisFormSet.cSOItem+"' has a mismatch on nQuoted_Total("+ALLTRIM(STR(ROUND(nQuoted_Total,0)))+") to nItemSale(" +ALLTRIM(STR(ROUND(nItemSale,0)))+")" 
					cMess = cMess + CHR(13)+HTML_SOitem(ThisFormSet.cSOItem,.T.)
					
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
		
				ENDIF
				
				************************************************
				*Set Router p_rtr_Oper
				*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"INV",lInv,lCncld,ThisFormSet.nConnHandle)
				
				IF NOT lCncld
					*Not Cancelled, make sure POitem work is scheduled.
					 
					IF lInv
						*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Pull Material",lInv,ThisFormSet.nConnHandle) --Done in Select Stock
					ENDIF
					IF lBRK
						*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Pull Material",lBRK,ThisFormSet.nConnHandle) --Done in Select Stock
					ENDIF
					IF lGFM
						rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Radial Forge",lGFM,ThisFormSet.nConnHandle)
					ENDIF
					IF lDraw
						rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Draw",lDraw,ThisFormSet.nConnHandle)
					ENDIF
					IF lPress
						rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Open Die Forge",lPress,ThisFormSet.nConnHandle)
					ENDIF
					IF lMach
						rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Machine Shop",lMach,ThisFormSet.nConnHandle)
					ENDIF
					IF lCG
						rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Centerless Grinder",lCG,ThisFormSet.nConnHandle)
					ENDIF
					IF lMach
						rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Machine Shop",lMach,ThisFormSet.nConnHandle)
					ENDIF
					IF lPlasma
						rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Plasma Cut",lPlasma,ThisFormSet.nConnHandle)
					ENDIF
					IF lWJet
						rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Waterjet",lWJet,ThisFormSet.nConnHandle)
					ENDIF
					IF lRoll
						rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Roll",lRoll,ThisFormSet.nConnHandle)
					ENDIF
					*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Testing", ,ThisFormSet.nConnHandle)
					*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Peel", ,ThisFormSet.nConnHandle)
				ELSE
					*UN-SCHEDULE
					
				ENDIF		
		
				cSQLu = "UPDATE dbo.Sales SET "
				cSQLu = cSQLu + " OrderSpec='"+ALLTRIM(cOrderSpec)+"'"
				cSQLu = cSQLu + ",S_Instrct='"+ALLTRIM(cS_Instrct)+"'"
				cSQLu = cSQLu + ",Inv="+IIF(lInv,"1","0")
				cSQLu = cSQLu + ",BRK="+IIF(lBRK,"1","0")
				cSQLu = cSQLu + ",GFM="+IIF(lGFM,"1","0")
				cSQLu = cSQLu + ",Draw="+IIF(lDraw,"1","0")
				cSQLu = cSQLu + ",Roll="+IIF(lRoll,"1","0")
				cSQLu = cSQLu + ",Press="+IIF(lPress,"1","0")
				cSQLu = cSQLu + ",Mach="+IIF(lMach,"1","0")
				cSQLu = cSQLu + ",CG="+IIF(lCG,"1","0")
		*!*	,[Plasma],[WJet],[ColdSaw]		
				cSQLu = cSQLu + ",Plasma="+IIF(lPlasma,"1","0")
				cSQLu = cSQLu + ",WJet="+IIF(lWJet,"1","0")
				*cSQLu = cSQLu + ",ColdSaw="+IIF(lColdSaw,"1","0")
				
		*!*	,[Cert]
				cSQLu = cSQLu + ",Cert="+STR(nCert)
				cSQLu = cSQLu + ",ShipON="+IIF(llShipOn,"1","0")
		
		*!*	,[ItemTot],[ShipDue],[Shipped]
		*!*	,[MatlWt],[cncld],[cmplt],[PartNo]
		
				IF NOT EMPTY(dShipDue)
					cSQLu = cSQLu + ",ShipDue='"+DTOC(dShipDue)+"'"
				ENDIF
				IF NOT EMPTY(dShipped)
					cSQLu = cSQLu + ",Shipped='"+DTOC(dShipped)+"'"
				ENDIF
				cSQLu = cSQLu + ",MatlWt="+STR(nMatlWt,9,1)
				cSQLu = cSQLu + ",Cncld="+IIF(lcncld,"1","0")
		
				cSQLu = cSQLu + ",PartNo='"+ALLTRIM(cPartNo)+"'"
		
		*!*	,[ItemCost],[ItemSale]
				
				cSQLu = cSQLu + ",ItemCost="+STR(nItemCost,9,2)
				cSQLu = cSQLu + ",ItemSale="+STR(nItemSale,9,2)
		*!*	,[StkPaid],[StkCost],[POCost]
				IF lFoundCost
					cSQLu = cSQLu + ",StkPaid= "+STR(PrepareSQLnum(nStkPaid,'StkPaid',9,2),9,2)
					cSQLu = cSQLu + ",StkCost= "+STR(PrepareSQLnum(nSTKCost,'StkCost',9,2),9,2)
					cSQLu = cSQLu + ",POCost= "+STR(PrepareSQLnum(nPOCost,'POCost',9,2),9,2)
				ENDIF		
		
		*!*	,[Quoted_QTY],[Quoted_P],[Quoted_Total],[Quoted_PU]	
				cSQLu = cSQLu + ",Quoted_QTY = "+STR(nQuoted_QTY,18,4)
				cSQLu = cSQLu + ",Quoted_P = "+STR(nQuoted_P,18,4)
				cSQLu = cSQLu + ",Quoted_Total = "+STR(nQuoted_Total,18,4)
				cSQLu = cSQLu + ",Quoted_PU = "+STR(nQuoted_PU)
				
				cSQLu = cSQLu + ",S_Total = "+STR(nQuoted_Total,18,4)
				
		*!*	,[gs_cost],[gs_sale],[gs_cmplt]
		*!*	,[Rma_No]
				cSQLu = cSQLu + ",RMA_No="+ALLTRIM(STR(nRMA_No))
				
		*!*	,[QA],[CofC],[Merc],[pPo],[pPn],[pHeat],[pSpec],[pDesc],[pOther],[Other]
		*!*	,[prcp],[prcd],[pckd]
		*!*	,[Urgent],[ShipOn]
			cSQLu = cSQLu + ",Urgent='"+cUrgent+"'"
		*!*,[Tol],[JobHours],[ProcLoc]
				cSQLu = cSQLu + ",Tol='"+ALLTRIM(cTol)+"'"
				cSQLu = cSQLu + ",ProcLoc='"+cProcLoc+"'"
		
		*!*	,[Quoted_OtherP],[Quoted_CutsP]
		*!*	,[dShip],[Typ]
				cSQLu = cSQLu + ",DShip="+IIF(lDShip,"1","0") 	
				cSQLu = cSQLu + ",TYP='"+cTYP+"'"  
		
		*!*	,[WO],[WO_Detail],[ProductionWO]
		*!*	,[IntP]
		*!*	,[Export]
				cSQLu = cSQLu + ",Export="+IIF(lExport,"1","0")
		*!*	,[RcvdE],[RMA_E]
		
			
				*RVW_Stock, RVW_Prod, Review_Date
				cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
				
				WAIT WINDOW "Saved to dbo.Sales table" NOWAIT
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
						lReturn = .F.
						lRollBack = .T.
					ENDIF
				ENDIF
				
				
				IF lCncld 
					*Remove Cancelled process from StockLst and BrokerLst
					
					*Remove_ID_Detail_Process(m.ID_Detail_Process,"SOitem",ThisFormSet.cSOItem,cTbl,pConnHandle,"CANCELLED")
					IF Cancel_Detail_Process_SOitem(ThisFormSet.cSOItem,ThisFormSet.nConnHandle)
						
					ENDIF
					
				ENDIF
				
			ELSE
				*lRollBack
			ENDIF
		ENDSCAN
		
		*************************************
		*PRIVATE lSOisListedAsChanging 
		*lSOisListedAsChanging = IsSales_No_Changing(ThisFormSet.nSalesNum,ThisFormSet.nConnHandle)
		IF NOT lRollBack 
			IF lAmendVer 
				IF Is_Amendment_Allowed(ThisFormSet.nSalesNum,ThisFormSet.nConnHandle)
					lnAmendment = Amend_Sales_No_Ver( ThisFormSet.nSalesNum, ThisFormSet.cReprintSOreason, ThisFormSet.nConnHandle)
					IF ThisFormSet.nAmendment <> lnAmendment 
						*TrackError("Check Admendment info"+CHR(13)+"ThisFormSet.nAmendment="+STR(ThisFormSet.nAmendment)+CHR(13)+"lnAmendment="+STR(lnAmendment)+CHR(13)+"lnAmendment = Amend_Sales_No_Ver( ThisFormSet.nSalesNum, ThisFormSet.cReprintSOreason, ThisFormSet.nConnHandle)"+CHR(13)+"ThisFormSet.nSalesNum="+STR(ThisFormSet.nSalesNum)+CHR(13)+"ThisFormSet.cReprintSOreason="+ThisFormSet.cReprintSOreason+CHR(13)+"Useing the lnAmendment value" ,"Check Admendment info", PROGRAM(), LINENO(1))
						*Confimed 6/13/2023: Needs ThisFormSet.nAmendment = lnAmendment 
						ThisFormSet.nAmendment = lnAmendment 
					ENDIF
				ELSE
					TrackMess("SO "+ALLTRIM(STR(ThisFormSet.nSalesNum))+" lnAmendment NOT allowed in Is_Amendment_Allowed ("+DTOC(DATE())+")" +" "+PROGRAM()+" New Amendment was NOT ALLOWED. Amendment:"+ALLTRIM(STR(ThisFormSet.nAmendment)) )
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"SO "+ALLTRIM(STR(ThisFormSet.nSalesNum))+"  lnAmendment NOT allowed in Is_Amendment_Allowed  ("+DTOC(DATE())+")" +" New Amendment was NOT ALLOWED. Amendment:"+ALLTRIM(STR(ThisFormSet.nAmendment))+CHR(13)+HTML_SO(ThisFormSet.nSalesNum,.T.))
					lnAmendment = ThisFormSet.nAmendment
				ENDIF
				
				IF lnAmendment >= 0
					ThisFormSet.nAmendment = lnAmendment 
					SELECT Sales_No
					REPLACE Amendment WITH ThisFormSet.nAmendment IN Sales_No					
		*			ThisFormset.frmEO.pf1.pgBillTo.txtAmendment.Value = ThisFormSet.nAmendment
		*			ThisFormSet.frmEO.pf1.pgQA.txtVersion.Value = ThisFormSet.nAmendment
				ELSE
					MESSAGEBOX("Could not get next SO Version!",0+64,"No REV recorded, so Nothing print")
					TrackError("Could not get next SO Version!"+CHR(13)+"ThisFormSet.nSalesNum="+ALLTRIM(STR(ThisFormSet.nSalesNum))+CHR(13)+"No REV recorded, so Nothing print","Could not get next SO Version!", PROGRAM(), LINENO(1))
		
					*RETURN .F.
					lRollBack = .T.
				ENDIF
			ENDIF
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE save_soitem_hrs
		*ThisForm.Save_SOitem_Hrs()
		*Also see Refresh_pgQA()  Check_SOitem_Hrs()
		PRIVATE nINVhrs, nBRKhrs, nRecvHrs, nMachHrs, nCGhrs,nPackHrs,nGFMhrs,nDrawHrs,nRollHrs,nPressHrs
		PRIVATE nHeatHrs,nTestHrs,nAbrsvHrs,nBSawHrs,nShearHrs,nPlasmaHrs,nWJetHrs,nHrs
		PRIVATE dDateEst
		
		
		nINVhrs 	= ThisFormSet.frmSales_Review.pf.pgProd.spnINV.Value	
		*nBRKhrs 	= ThisFormSet.frmSales_Review.pf.pgProd.spnINV.Value	
		nRecvHrs 	= ThisFormSet.frmSales_Review.pf.pgProd.spnRecv.Value	
		nMachHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnMach.Value	
		nCGhrs		= ThisFormSet.frmSales_Review.pf.pgProd.spnCG.Value	
		nPackHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnPack.Value	
		nGFMhrs		= ThisFormSet.frmSales_Review.pf.pgProd.spnGFM.Value	
		nDrawHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnDraw.Value	
		nRollHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnRoll.Value
		nPressHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnPress.Value
		nHeatHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnHeat.Value
		nTestHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnTest.Value
		nAbrsvHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnAbrsv.Value
		nBSawHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnBSaw.Value
		nShearHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnShear.Value
		nPlasmaHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnPlasma.Value
		nWJetHrs	= ThisFormSet.frmSales_Review.pf.pgProd.spnWJet.Value
		
		nHrs = nINVhrs + nRecvHrs + nMachHrs + nCGhrs + nPackHrs + nGFMhrs + nDrawHrs + nRollHrs + nPressHrs 
		nHrs = nHrs + nHeatHrs + nTestHrs + nAbrsvHrs + nBSawHrs + nShearHrs +nPlasmaHrs + nWJetHrs
		nHrs = nHrs + 1
		
		*ThisFormSet.frmSales_Review.pf
		ThisFormSet.frmSales_Review.pf.pgProd.lblHRS.Caption = STR(nHrs)
		
		dDateEst = Get_ShipDateinSales(ThisFormSet.cSOitem ,ThisFormSet.nConnHandle )
		
		cSQL = "UPDATE dbo.SOitem_Hrs "
		cSQL = cSQL + "SET INV="+STR(nINVhrs)
		cSQL = cSQL + ",Recv="+STR(nRecvHrs)
		cSQL = cSQL + ",[Mach]="+STR(nMachHrs)
		cSQL = cSQL + ",[CG]="+STR(nCGhrs)
		cSQL = cSQL + ",[Pack]="+STR(nPackHrs)
		cSQL = cSQL + ",[GFM]="+STR(nGFMhrs)
		cSQL = cSQL + ",[Draw]="+STR(nDrawHrs)
		cSQL = cSQL + ",[Roll]="+STR(nRollHrs)
		cSQL = cSQL + ",Press="+STR(nPressHrs)
		cSQL = cSQL + ",Heat="+STR(nHeatHrs)
		cSQL = cSQL + ",Test="+STR(nTestHrs)
		cSQL = cSQL + ",Abrsv="+STR(nAbrsvHrs)
		cSQL = cSQL + ",BSaw="+STR(nBSawHrs)
		cSQL = cSQL + ",Shear="+STR(nShearHrs)
		cSQL = cSQL + ",Plasma="+STR(nPlasmaHrs)
		cSQL = cSQL + ",WJet="+STR(nWJetHrs)
		cSQL = cSQL + ",Hrs="+STR(nHrs)
		cSQL = cSQL + ",DateEst='"+DTOC(dDateEst)+"'"
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"tmpSOitem_Hrs")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitem_Hrs')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Hrs")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Hrs")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSOitem_Hrs')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				RETURN .F.
			ENDIF
		ENDIF
		
		RETURN .T.
		
	ENDPROC

