	PROCEDURE showwo_wod_window
		*ThisFormSet.ShowWO_WOD_Window()
		ThisFormSet.Show_WOD('WONotVisible')
		ThisFormSet.Show_WOD('WODNotVisible')
		ThisFormSet.Show_WO('WONotVisible')
		
		PRIVATE nWO, nWO_Detail
		nWO			= PrepareSQLnum(SalesQuote.WO,'WO',-3) &&Quote.WO, Sales.WO = WO1
		nWO_Detail	= PrepareSQLnum(SalesQuote.WO_Detail,'WO_Detail',-3)  
		
		IF Proper_SO_Item(ThisFormSet.cSOItem) = Proper_SO_Item("")
			TrackError("Lost the SOitem","Proper_SO_Item(ThisFormSet.cSOItem) = Proper_SO_Item('')"+CHR(13)+":"+ThisFormSet.cSOItem+".",PROGRAM(),LINENO(1))
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF nWO+nWO_Detail = 0
			*Reverse Check, See if WorkOrder has SO 
			*or WorkOrder_Detail has SO
			
			
			
			IF USED('tmpWO_SOitem')
				USE IN tmpWO_SOitem
			ENDIF
		
			cSQL = "SELECT WO FROM dbo.WorkOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOitem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_SOitem')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOitem")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
