	PROCEDURE frmSales_Review.Init
		*!*	PARAMETER pSOitem
		*!*	*DO FORM Forms\Sales_Review WITH ' 140275-01'
		
		*!*	IF VARTYPE(pSOitem)<>"C"
		*!*		pSOitem = ' 140275-01'
		*!*	ENDIF
		*!*	IF Proper_SO_Item(pSOitem) = Proper_SO_Item('')
		*!*		RETURN .F.
		*!*	ENDIF
		
		*!*	ThisFormSet.cSOitem = Proper_SO_Item(pSOitem)
		
		*!*	ThisFormSet.Load_Sales()
		
		*!*	IF NOT USED('tmpSOitemRV')
		*!*		MESSAGEBOX("Could not load 'Sales'",0,"SQL Error")
		*!*		RETURN TO MASTER
		*!*	ENDIF
		
		
		*!*	ThisFormSet.frmWO.Left	= ThisFormSet.frmEO.Left+ThisFormSet.frmEO.Width +15
		*!*	ThisFormSet.frmWO.Top	= ThisFormSet.frmEO.Top - 2
		
		*!*	ThisFormSet.frmWOD.Left	= ThisFormSet.frmEO.Left+ThisFormSet.frmEO.Width +15
		*!*	ThisFormSet.frmWOD.Top	= ThisFormSet.frmEO.Top + ThisFormSet.frmWO.Height + 20
		
		*!*	ThisFormSet.frmEoP.Visible = .F.
		
		*!*	*ThisFormSet.frmPO.AlwaysOnTop = .T.
		*!*	*ThisFormSet.frmEO.AlwaysOnTop = .F.
		*!*	*
		*!*	ThisFormSet.ShowWO_WOD_Window()
		
		
	ENDPROC

	PROCEDURE frmSales_Review.Load
		*!*	IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*!*		SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		*!*	ENDIF
		*!*	IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
		*!*		SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		*!*	ENDIF
		*!*	IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*!*		SET PROCEDURE TO Progs\Proc_Setup ADDITIVEF
		*!*	ENDIF 
		*!*	IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*!*		SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		*!*	ENDIF
		*!*	IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*!*		SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		*!*	ENDIF
		
		*!*	ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgProd.chkCg.Valid
		
		PRIVATE lCG
		lCG	= PrepareSQLlogic(This.Value,'CG',.F.)
		
		*!*	PRIVATE cUpdate
		*!*	cUpdate = "UPDATE dbo.Sales SET "
		*!*	cUpdate = cUpdate + " CG="+IIF(lCG,"1","0")+""
		*!*	cUpdate = cUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_A+"')"
		*!*		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL'  TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
		*!*				
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
		*!*		RETURN .F.
		*!*	ELSE
			SELECT SalesQuote
			REPLACE CG WITH lCG IN SalesQuote
			*WAIT WINDOW "Saved!" NOWAIT
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgProd.chkDraw.Valid
		IF ThisForm.check_Prod_TYP('chkDraw', This.Value)
			REPLACE [Draw] WITH PrepareSQLlogic(This.Value,'Draw',.F.) IN SalesQuote
		ELSE
			This.Value = !This.Value
		ENDIF
		
