	PROCEDURE frmSales_Review.pf.pgStock.cmbProcLoc.Valid
		PRIVATE cProcLoc
		cProcLoc	= PrepareSQLtxt(This.Value,'ProcLoc',1)
		
		*!*	PRIVATE cUpdate
		*!*	cUpdate = "UPDATE dbo.Sales SET "
		*!*	cUpdate = cUpdate + " ProcLoc='"+cProcLoc+"'"
		*!*	cUpdate = cUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_A+"')"
		*!*		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL'  TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
		*!*	ENDDO
		
		*!*	IF nSQLEXEC < 0
		*!*		IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*		RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
		*!*		RETURN .F.
		*!*	ELSE
			
			SELECT SalesQuote
			REPLACE ProcLoc WITH cProcLoc IN SalesQuote
			This.Refresh
			*
			*cmbProcLoc.Value SalesQuote.ProcLoc 
			
			*WAIT WINDOW "Saved!" NOWAIT
		*ENDIF
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.cmbTyp.Valid
		*Inv,I,Broker,B,Mill,M,Production,P,Service,S,Conversion,C
		PRIVATE cTyp
		cTyp	= PrepareSQLtxt(This.Value,'Typ',1)
		
			
			SELECT SalesQuote
			REPLACE Typ WITH cTyp IN SalesQuote
			This.Refresh
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.cmdEditHoldStatus.Click
		*ThisFormSet.SalesHistory()
		
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE nSalesNum,cSOitem
		cSOitem 	= PrepareSQLtxt(SalesQuote.SOitem,'SOitem',10)
		nSalesNum	= PrepareSQLnum(SalesQuote.SalesNum,'SalesNum',-3)
		
		IF nSalesNum > 0
			PRIVATE nItem_A, nRecNo 
			nItem_A = PrepareSQLnum( SalesQuote.Item_A,'Item',2,0)
			nRecNo = RECNO('SalesQuote')
			
			DO FORM Forms\SOitem_Status WITH cSOitem,ThisFormSet.nConnHandle
			
			PRIVATE lHold 
			lHold = Is_SOitem_Hold(cSOitem,ThisFormSet.nConnHandle)
			
			SELECT SalesQuote
			REPLACE HOLD WITH lHold IN SalesQuote FOR Item_A = nItem_A 
			
			IF nRecNo <= RECCOUNT('SalesQuote')
				GOTO nRecNo IN SalesQuote
			ELSE
				GO BOTTOM
			ENDIF
			
			This.Parent.chkHold.Value = lHold
		*	This.Parent.chkHold.Refresh
			
		ENDIF
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.cmdEditHoldStatus.When
		*!*	IF ThisFormSet.isQuoteEditing
		*!*		WAIT WINDOW "Save first" nowait
		*!*		RETURN .F.
		*!*	ENDIF
		*!*	IF ISNULL(Quotes.salesnum)
		*!*		WAIT WINDOW "No Sales Number!" NOWAIT
		*!*		RETURN .F.
		*!*	ELSE
		*!*		IF EMPTY(Quotes.Salesnum)
		*!*			WAIT WINDOW "No Sales Number!" NOWAIT
		*!*			RETURN .F.
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.cmdEditStock.Click
		IF This.Caption = "Edit"
			ThisFormSet.Set_pgStock('EDIT')
			This.Parent.cmdStockCanc.Visible = .T.
			This.Caption = "Save"
		ELSE
			*"Save"
			IF ThisFormSet.Save_pgStock()
				ThisFormSet.Set_pgStock('SAVE')
				This.Parent.cmdStockCanc.Visible = .F.
				This.Caption = "Edit"
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.cmdMark_RVW_Stock.Click
		PRIVATE lComplete
		lComplete = ThisForm.lblComplete.Visible
		
		IF lComplete 
			MESSAGEBOX("This SOitem is COMPLETED, you are not allowed to modify now",0,"Cannot")
			RETURN .F.
		ENDIF
		
		ThisFormSet.Save_RVW_Stock()
		
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgStock.cmdSelectInv.Click
		PRIVATE lcInvForm, nReturnPrice, nWeight, nPieces, nFeet
		PRIVATE nSalesQuoteID 
		nSalesQuoteID = PrepareSQLnum(SalesQuote.ID,'ID',-3)
		
		*lcInvForm = ThisFormSet.InventoryForm( SalesQuote.Form )
		*lcInvForm = ThisFormSet.InventoryForm( Quotes.Form )
		
		nWeight = PrepareSQLnum(SalesQuote.Weight,'Weight',8,1)
		IF nWeight = 0
			*Calc Weight
		*	nWeight = ThisFormSet.CalcWeight( SalesQuote.Pieces, SalesQuote.Alloy, SalesQuote.Form, SalesQuote.Thck, SalesQuote.Sz2, SalesQuote.Sz3 )
		ENDIF
		PRIVATE nQTY
		nQTY = 0
		
		PRIVATE lStartStock 
		lStartStock = PrepareSQLlogic(SalesQuote.StartStock,'StartStock',.F.)
		
		IF lStartStock 
			PRIVATE nMess
			nMess = MESSAGEBOX("Found Starting Stock."+CHR(13)+"Do you wish to SELECT Inventory for this Starting Stock?",4+32,"Use Starting Stock?")
			IF nMess = 7
				lStartStock = .F.
			ENDIF
		ENDIF
		
		IF lStartStock 
			PRIVATE cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			cssAlloy	= ''
			cssForm		= ''
			cssCC		= ''
			cssCL		= ''
			nssPieces	= 0
			nssThck		= 0
			nssSz2		= 0
			nssSz3		= 0
			nssWeight	= 0
			DO GetStartingStock WITH SalesQuote.ID,ThisFormSet.nConnHandle,cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			
			nQTY = Calc_QTY(cssAlloy,cssForm,nssPieces,nssThck,nssSz2,nssSz3,'',ThisFormSet.nConnHandle)
			
			
		*	PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		*	lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		*	IF lEOAllWaysOnTop
		*		ThisFormSet.frmEO.AlwaysOnTop =.F.
		*	ENDIF
		*	lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		*	IF lPOAllWaysOnTop
		*		ThisFormSet.frmPO.AlwaysOnTop =.F.
		*	ENDIF
		
		*Forms\StockLst_SQL_Browse 	*Use Browse if you are not looking for a Selection.
		*Forms\StockLst_SQL_Modal	*Use Modal if you are waiting for a Selection.
		*Forms\StockLst_SQL_Quotes
		
		*old DO FORM Forms\StockLst_SQL_Quotes WITH "SEL_SS",'S',cssAlloy,cssForm,cssCC,cssCL,nssThck,nssSz2,nssSz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,nssPieces,nssWeight,'',nQTY,.F.,''		
			DO FORM Forms\StockLst_SQL_Modal WITH "SEL_SS",'S',cssAlloy,cssForm,cssCC,cssCL,nssThck,nssSz2,nssSz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,nssPieces,nssWeight  ,'',nQTY,.F.,''		
			*                          PARAMETER pFunction,pTBL,  pAlloy,  pForm,  pCC,  pCL,  pThck,  pSz2,  pSz3,          pSOItem             ,pSalesNum       ,pPC, pLBS,pHeatLot,pQTY,pRL,pPOitem
		*	IF lEOAllWaysOnTop
		*		ThisFormSet.frmEO.AlwaysOnTop =.T.
		*	ENDIF
		*	IF lPOAllWaysOnTop
		*		ThisFormSet.frmPO.AlwaysOnTop =.T.
		*	ENDIF
		
		ELSE
			nQTY = Calc_QTY(SalesQuote.alloy,SalesQuote.Form,SalesQuote.Pieces,SalesQuote.thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.OtherFld,ThisFormSet.nConnHandle)
			
		*	PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		*	lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		*	IF lEOAllWaysOnTop
		*		ThisFormSet.frmEO.AlwaysOnTop =.F.
		*	ENDIF
		*	lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		*	IF lPOAllWaysOnTop
		*		ThisFormSet.frmPO.AlwaysOnTop =.F.
		*	ENDIF
		*Forms\StockLst_SQL_Browse 	*Use Browse if you are not looking for a Selection.
		*Forms\StockLst_SQL_Modal	*Use Modal if you are waiting for a Selection.
		*Forms\StockLst_SQL_Quotes
			*DO FORM Forms\StockLst_SQL_Quotes WITH "SELECT",'S',SalesQuote.alloy,SalesQuote.Form,SalesQuote.CC,SalesQuote.CL,SalesQuote.thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,SalesQuote.Pieces,SalesQuote.weight,'',nQTY,SalesQuote.RandLen,''
			DO FORM Forms\StockLst_SQL_Modal WITH "SELECT",'S',SalesQuote.alloy,SalesQuote.Form,SalesQuote.CC,SalesQuote.CL,SalesQuote.thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,SalesQuote.Pieces,SalesQuote.weight,'',nQTY,SalesQuote.RandLen,''
		*	IF lEOAllWaysOnTop
		*		ThisFormSet.frmEO.AlwaysOnTop =.T.
		*	ENDIF
		*	IF lPOAllWaysOnTop
		*		ThisFormSet.frmPO.AlwaysOnTop =.T.
		*	ENDIF
		
		ENDIF
		
		*DO FORM Forms\ShowSelectedProcess WITH SalesQuote.SOItem_A
		********************************************************
		
		IF nSalesQuoteID > 0
			IF PrepareSQLnum(SalesQuote.ID,'ID',-3) != nSalesQuoteID 
				
				MESSAGEBOX("Let 'David Kirchner' know that your SalesQuote table has moved off its record!",64,"TEST")
				
				PRIVATE cMess
				cMess = "SalesQuote table has moved off its original record."+CHR(13)
				cMess = cMess+ "Current table is listed is '"+ALIAS()+"'."+CHR(13)
				cMess = cMess+ "Last SalesQuote.ID was "+STR(nSalesQuoteID)+"."+CHR(13)
				cMess = cMess+ "Current SalesQuote.ID is "+STR(PrepareSQLnum(SalesQuote.ID,'ID',-3))+"."+CHR(13)
				cMess = cMess+ "EOF('SalesQuote') is "+IIF(EOF('SalesQuote'),'True','False')+"."+CHR(13)
				cMess = cMess+ "BOF('SalesQuote') is "+IIF(BOF('SalesQuote'),'True','False')+"."+CHR(13)
				cMess = cMess+ "RECCOUNT('SalesQuote') is "+STR(RECCOUNT('SalesQuote'))+"."+CHR(13)
				TrackError("Select Inventory",cMess,PROGRAM(),LINENO(1))
					
				SELECT SalesQuote
				LOCATE FOR ID = nSalesQuoteID 	
				
			ENDIF
		ENDIF
		***************************
		ThisFormSet.sumStockLstCost()
		ThisFormSet.didSOitem_UseStock()
		
		
		
		
		ThisFormSet.frmEO.pf1.pgOrder.chkInv.REFRESH  &&SalesQuote.inv
		
		lVis = WVISIBLE('frmEO')
		IF lVis
		*	MESSAGEBOX( "If you did not just leave the 'Select from Inventory' window,"+CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+" AND remember what was done before this message appearred."+CHR(13)+CHR(13)+"Thank you for helping debug this program.",32,"frmEO is Visible")
		ELSE	
			MESSAGEBOX( "frmEO has not been activated, has been hidden, has been deactivated, or doesn't exist"+CHR(13)+CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+" AND remember what was done before this message appearred."+CHR(13)+CHR(13)+"Thank you for helping debug this program.",16,"frmEO is Visible")
		ENDIF
		ACTIVATE WINDOW frmEO TOP
		
		
		
		
	ENDPROC

