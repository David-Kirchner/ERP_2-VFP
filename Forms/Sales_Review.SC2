	PROCEDURE frmSales_Review.pf.pgShip.cmdPaymentStatus.Click
		IF FILE("forms\CustomerStatus.scx")
		
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
			
			PRIVATE cCustID
			cCustID = PrepareSQLtxt(SalesQuote.CustID,'CustID',20)
			IF LEN(ALLTRIM(cCustID))=0
				*Not sure why SalesQuote.CustID is lost
				cCustID = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)
				IF NOT LEN(ALLTRIM(cCustID))=0
					SELECT SalesQuote
					REPLACE CustID WITH cCustID IN SalesQuote
				ENDIF
			ENDIF
			*This.Parent.cmdCustomerID.Caption = cCustID
			
			DO FORM forms\CustomerStatus WITH cCustID, SalesQuote.Company, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle 
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		
		ELSE
			MESSAGEBOX("FILE CustomerStatus.scx NOT FOUND!",0,'')
		ENDIF
		
		
		SELECT Sales_No	&&This was added to see if this Click code accidentally closed the 'Sales_No' table
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgShip.cmdRMA.Click
		*********************************************
		*check to see if a rtr has been made.
		
		
		PRIVATE cSOitem, nRMA_No, nRecNo
		cSOitem = PrepareSQLtxt(SalesQuote.SOItem_A,'SOitem',10)
		nRMA_No = PrepareSQLnum(SalesQuote.RMA_No,'RMA_No',-3)
		nRecNo = RECNO('SalesQuote')
		
		IF nRMA_No > 0
			MESSAGEBOX("This SOitem already has a RMA that has been started."+CHR(13)+"Use HPA App \Main Menu \Sales \RMA "+CHR(13)+CHR(13)+"Double click the RMA Number to review report page.",0+48,"Already has RMA")
			RETURN
		ENDIF
		
		PRIVATE nCntSOitem
		nCntSOitem = Count_ItemsinSales (ThisFormSet.nSalesNum, ThisFormSet.nConnHandle, 'RMA')
		IF nCntSOitem > 0
			*Get the RMA
			SELECT SalesQuote
			LOCATE FOR RMA_No > 0
			IF FOUND()
				nRMA_No = PrepareSQLnum(SalesQuote.RMA_No,'RMA_No',-3)
				IF nRMA_No > 0
					PRIVATE nMess
					nMess = MESSAGEBOX("This SalesNumber has a RMA on a different Item"+CHR(13)+"Do you want to add this Item to that RMA?"+CHR(13)+"RMA "+ALLTRIM(STR(nRMA_No))+CHR(13)+"Answer (N)o to get a another RMA number.",4+32,"Add to RMA")
					IF nMess <> 6
						nRMA_No = 0
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		DO FORM Forms\RMA_Start WITH nRMA_No, cSOitem
		
		IF nRecNo > 0 AND nRecNo <= RECCOUNT('SalesQuote')
			ThisFormSet.Refresh_SalesQuote( nRecNo )
		ELSE
			ThisFormSet.Refresh_SalesQuote( 1 )
		ENDIF
	ENDPROC

