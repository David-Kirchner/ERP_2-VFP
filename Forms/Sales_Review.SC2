					ThisFormset.frmWOD.txtFSz3.Value		= PrepareSQLnum(tmpWO_Detail.fSz3,'Sz3',9,3)
					ThisFormset.frmWOD.txtFWeight.Value 	= PrepareSQLnum(tmpWO_Detail.fWeight,'Weight',9,1)
		
					ThisFormSet.frmWOD.txtFID_Detail.Value 	= PrepareSQLnum(tmpWO_Detail.fID_Detail,'ID_Detail',-3)
