	PROCEDURE frmSales_Review.pf.pgStock.lblType.Click
		MESSAGEBOX("IF HPA has this on StockLst it is type 'Inv'";
			+" ('Inv' can be broken down further as using CG, Plasma and Waterjet cut.)"+CHR(13)+CHR(13);
			+"A Purchase Order for material may be a stock 'Broker' or a 'Mill' run."+CHR(13)+CHR(13);
			+"'Production' is when you have to wait for an HPA forging operation before shipping Order.";
			+" (Production can be divided further by GFM, Roll and Press Checkmarks.)";
			+" (GFM, Roll and Press Checkmarks are only needed if material still needs production.)"+CHR(13)+CHR(13);
			+"'Service' Order is CUSTOMERS MATERIAL using HPA Cutting, Straightening, Machining Service."+CHR(13)+CHR(13);
			+"'Conversion' Order is CUSTOMERS MATERIAL being Converted on Forging/Rolling Equipment.",0+64,"Type Definition")
	ENDPROC

