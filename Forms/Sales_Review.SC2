			ENDIF
		ENDIF
		************************************
		
		IF nWO > 0
			IF USED('tmpWO')
				USE IN tmpWO
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC 
		
			cSQL = "SELECT * FROM dbo.WorkOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO = "+STR(nWO)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
