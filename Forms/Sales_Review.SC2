		*!*	ELSE
			
			SELECT SalesQuote
			REPLACE TOL WITH cTOL IN SalesQuote
			*WAIT WINDOW "Saved!" NOWAIT
		*ENDIF
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgQuality.chkCancelSO.Click
		PRIVATE lnSalesNum
		lnSalesNum	= ThisFormSet.nSalesNum
		PRIVATE nItem
		nItem = SalesQuote.Item
		
		PRIVATE lCancel
		lCancel = PrepareSQLlogic( This.Value, 'Cancel',.F.)
		
		PRIVATE nSOItemTot, nMess
		nSOItemTot	= PrepareSQLnum(SalesQuote.ItemTot,'ItemTot',-1)
		
		nMess = MESSAGEBOX("Cancelling the Sales Number will cancel all Items"+CHR(13)+" ("+ALLTRIM(STR(nSOItemTot))+") Items"+CHR(13)+CHR(13)+"Are you sure you want to cancel?",4,"Cancel Sales Order")
		IF nMess = 6
			IF lCancel 
				
				TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.nSalesNum))+" All "+ALLTRIM(STR(nSOItemTot))+" Items is to be marked as 'Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
				
				IF Cancel_SO(lnSalesNum, ThisFormSet.nConnHandle,'CANCEL')
					
					PRIVATE nAmendment, nVer, nAmendVer 
					nAmendment	= Get_Amendment_Sales_No( lnSalesNum, ThisFormSet.nConnHandle)
		
					UPDATE SalesQuote SET ;
						Cncld = .T.;
						WHERE SalesNum_a = lnSalesNum
						
					SELECT SalesTotal
					UPDATE SalesTotal SET Cncld = .T. 
					
					SELECT Sales_No	&&Sales_No does not have items details
					REPLACE Cncld  WITH .T. IN Sales_No
					REPLACE ShopRecv WITH .F. IN Sales_No
					REPLACE Amendment WITH nAmendment IN Sales_No
					
					ThisFormSet.nAmendment = nAmendment 
					ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value = nAmendment 
					
					ThisFormSet.SaveSO("CANCEL",.F.)
					*Calls: Amend_Sales_No_Ver( but the .F. prevents another Amendment
					
					PRIVATE cMess
					IF ThisFormSet.lPrintedSO
						cMess = "Please call shop to get paperwork stopped."+CHR(13)+"Reprint SalesOrder now as Cancelled."
					ELSE 
						cMess = "Please call shop to get paperwork stopped."+CHR(13)+"Reprint SalesOrder now as Cancelled."+CHR(13)+"Shop does not have the latest Print."
					ENDIF
					
					Track_Sales_No_Chng( "Edit_SalesOrder.CancelSO CANCEL(success) ",ThisFormSet.nSalesNum,.F.,ThisFormSet.nAmendment )
					
					MESSAGEBOX(cMess,0+64,"Inform shop of this Cancel!")
					TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.nSalesNum))+" is marked as 'Cancelled'. Reprint SalesOrder now as Cancelled." )
						
				ELSE
		*			IF HaveSODeletePermission(0)  -Now inside Calcel_SO proc
		*				IF MESSAGEBOX("Do you want to use your Administrator rights to force a Cancel?"+CHR(13)+CHR(13)+"Normal users could not cancel this order.",4+32,"Force Cancel?") = 6
							*No code needed
		*				ELSE
							TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.nSalesNum))+" was NOT marked as 'Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
							This.Value = 0
							RETURN .F.
		*				ENDIF
		*			ENDIF
		*		ELSE
					This.Value = 0	
				ENDIF
				
			ELSE
				********************************************************************************************************
				TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.nSalesNum))+" is to be marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
				*UN CANCEL
				IF Update_Ship_Cncld(.F.,ThisFormSet.nSalesNum,ThisFormSet.nConnHandle)
					
					PRIVATE nAmendment, nVer, nAmendVer 
					nAmendment	= Get_Amendment_Sales_No( ThisFormSet.nSalesNum, ThisFormSet.nConnHandle)
		
					SELECT SalesTotal
					UPDATE SalesQuote SET Cncld = .F.			
					
					SELECT Sales_No	&&Sales_No does not have items details
					REPLACE Cncld  WITH .F. IN Sales_No
					REPLACE ShopRecv WITH .F. IN Sales_No
					REPLACE Amendment WITH nAmendment IN Sales_No
					
					ThisFormSet.nAmendment = nAmendment 
					ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value = nAmendment 
					
					
					* KEEP SQL UPDATE Active here
					cSQLu = "UPDATE dbo.Sales_No SET "
					cSQLu = cSQLu + " Cncld = 0 "
					cSQLu = cSQLu + ",ShopRecv = 0 "&& Shop does not have this new Cancelled SO
					cSQLu = cSQLu + " WHERE SalesNum = "+STR(ThisFormSet.nSalesNum)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLu )
						ELSE
							nSQLEXEC = 1
						ENDIF
					ENDIF
					IF nSQLEXEC > 0
					
						Track_Sales_No_Chng( "Edit_SalesOrder.CancelSO UNCANCEL(success) ",ThisFormSet.nSalesNum,.F.,ThisFormSet.nAmendment )
										
						ThisFormSet.lShopRecvSO = .F.
						ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
						ThisFormSet.frmEO.pf1.pgQA.chkShopRecv.Value		= ThisFormSet.lShopRecvSO
		
					ENDIF
					
					********************
					* KEEP SQL UPDATE Active here
					
					cSQLu = "UPDATE dbo.Sales SET "
					cSQLu = cSQLu + " Cncld = '0'"
					cSQLu = cSQLu + " WHERE SalesNum = "+STR(ThisFormSet.nSalesNum)
					*RVW_Stock, RVW_Prod, Review_Date
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLu )
						ELSE
							nSQLEXEC = 1
						ENDIF
					ENDIF
					IF nSQLEXEC > 0
						SELECT SalesQuote
						REPLACE Cncld WITH .F. FOR SalesNum = ThisFormSet.nSalesNum IN SalesQuote
					ENDIF
					
					***************************************
					** Repeat in SOitem_Hrs
					cSQL = "UPDATE dbo.SOitem_Hrs SET "
					cSQL = cSQL + " [Cncld] = 0"
					*DateEst
					cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.nSalesNum)
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
							RETURN
						ELSE
							nSQLEXEC = 1
						ENDIF
					ENDIF
					**
					
					***********************
					*Record the change.
					cSQL= "INSERT INTO dbo.Sales_No_Rev ([SalesNum],[VER],[Comment]) VALUES ("
					cSQL = cSQL +""+STR(ThisFormSet.nSalesNum)
					cSQL = cSQL +","+STR(ThisFormSet.nAmendment)
					cSQL = cSQL +",'"+"The Cancelled mark has been removed for Sales Order." +"')"
					
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
							*RETURN
						ELSE
							nSQLEXEC = 1
						ENDIF
					ENDIF
					***********************
		
					MESSAGEBOX("The 'Cancelled' mark has been removed for Sales Order #"+ALLTRIM(STR(ThisFormSet.nSalesNum))+CHR(13)+CHR(13)+"This SO is also considered 'Not Received' by shop"+CHR(13)+"Please call and confirm about 'Sales Order print Receiving' with shop if you do not reprint this.",0+48,'Un Cancelled')
					
					TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.nSalesNum))+" has been marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
					
					Save_Sales_Status( ThisFormSet.nSalesNum, 'UNCancel', 'UN-Cancelled Sales Order.', ThisFormSet.nConnHandle )
					*calls: GetCancelReason if "CANCEL or REMOVE"
					
					ThisFormSet.SaveSO("CANCEL",.F.)
					MESSAGEBOX("Please call shop to get paperwork started."+CHR(13)+"Reprint SalesOrder now.",0+64,"Inform shop of this order!")
					*send to messenger
				ELSE
					*Failed Update_Ship_Cncld
					MESSAGEBOX("The 'Cancelled' mark was NOT removed for Sales Order #"+ALLTRIM(STR(ThisFormSet.nSalesNum))+CHR(13)+CHR(13)+""+CHR(13)+"Please call IT and Fix.",0+16,"Error")
					TrackError("The 'Cancelled' mark was NOT removed for Sales Order #"+ALLTRIM(STR(ThisFormSet.nSalesNum)),"Failed Update_Ship_Cncld", PROGRAM(), LINENO(1))
					TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.nSalesNum))+" was NOT marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
					THIS.VALUE = 1
				ENDIF
				
				This.Parent.Parent.pgOrder.chkCancelItem.Refresh
			ENDIF
		ELSE
			*unClick, this was an Error
			IF PrepareSQLlogic(THIS.Value,'Cncl',.F.)
				THIS.VALUE = 0
			ELSE
				THIS.VALUE = 1
			ENDIF
		
		ENDIF
		
		SELECT SalesQuote
		IF nItem > 0 AND nItem <= RECCOUNT('SalesQuote')
			LOCATE FOR Item = nItem
		ELSE
			GO TOP
		ENDIF
	ENDPROC

