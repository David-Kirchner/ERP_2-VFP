	PROCEDURE frmSales_Review.pf.pgProd.cmdCancProd.Click
		ThisFormSet.Set_pgProd_('Save')
		This.Parent.cmdEditProd.Caption = "Edit"
		This.Visible = .F.
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgProd.cmdCreateWO.Click
		PRIVATE nWO,nWOD,cPOitem, cWhatEver, lReturn
		nWO		= 0
		nWOD	= 0
		cPOitem	= ''
		
		cWhatEver = ''  &&not used yet
		
		DO FORM Forms\WorkOrder WITH "ADD",nWO,nWOD,cPOitem,ThisFormSet.cSOItem,cWhatEver TO lReturn
		*CALLS:ThisFormSet.AddbySOitem(cPOitem, cSOitem, pWhatEver)
		
		*lReturn ?
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgProd.cmdEditProd.Click
		IF This.Caption = "Edit"
			ThisFormSet.Set_pgProd('Edit')
			This.Parent.cmdCancProd.Visible = .T.
			This.Caption = "Save"
		ELSE
			*"Save"
			IF ThisFormSet.Save_pgStock()
				ThisFormSet.Set_pgProd('Save')
				This.Parent.cmdCancProd.Visible = .F.
				This.Caption = "Edit"
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmSales_Review.pf.pgProd.cmdMark_RVW_Stock.Click
		PRIVATE lComplete
		lComplete = ThisForm.lblComplete.Visible
		
		IF lComplete 
			MESSAGEBOX("This SOitem is COMPLETED, you are not allowed to modify now",0,"Cannot")
			RETURN .F.
		ENDIF
		
		ThisFormSet.Save_RVW_Prod()
		
	ENDPROC

