	PROCEDURE rtr_pgstock
		*ThisFormSet.rtr_pgStock()
		return
		
		*IF lInv
			*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Pull Material",lInv,ThisFormSet.nConnHandle) --Done in Select Stock
			
		*IF lBRK
			*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Pull Material",lBRK,ThisFormSet.nConnHandle) --Done in Select Stock
		
		*IF lGFM
			rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Radial Forge",lGFM,ThisFormSet.nConnHandle)
		
		*IF lDraw
			rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Draw",lDraw,ThisFormSet.nConnHandle)
		
		*IF lPress
			rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Open Die Forge",lPress,ThisFormSet.nConnHandle)
		
		*IF lMach
			rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Machine Shop",lMach,ThisFormSet.nConnHandle)
		
		*IF lCG
			rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Centerless Grinder",lCG,ThisFormSet.nConnHandle)
		
		*IF lMach
			rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Machine Shop",lMach,ThisFormSet.nConnHandle)
		
		*IF lPlasma
			rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Plasma Cut",lPlasma,ThisFormSet.nConnHandle)
		
		*IF lWJet
			rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Waterjet",lWJet,ThisFormSet.nConnHandle)
		
		*IF lRoll
			rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Roll",lRoll,ThisFormSet.nConnHandle)
		
		*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Testing", ,ThisFormSet.nConnHandle)
		*rtr_Oper_Sched('SOitem',ThisFormSet.cSOItem,"Peel", ,ThisFormSet.nConnHandle)
		
	ENDPROC

