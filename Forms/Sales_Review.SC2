	PROCEDURE frmSales_Review.pf.pgProd.spnAbrsv.LostFocus
		PRIVATE nAbrsvHrs
		nAbrsvHrs= PrepareSQLnum(This.Value,'AbrsvHrs',-2)
		
		cSQL = "UPDATE dbo.SOitem_Hrs "
		cSQL = cSQL + "SET [Abrsv]="+STR(nAbrsvHrs)
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
