	PROCEDURE check_prod_typ
		PARAMETERS cField, pValue
		*ThisFormSet.check_Prod_TYP('chkDraw', This.Value)
		
		PRIVATE cTYP 
		
		
		DO CASE
		CASE cField = "cmbTyp"
			DO CASE
			CASE pValue = "I"
			*Inventory, Stock found on the Inventory List, IF Heat is Due In, should be TYP 'M' for Mill
				IF SalesQuote.Services
					MESSAGEBOX("You cannot have 'Inventory' and 'Service' selected on same item."+CHR(13)+"A Service does not use ERP Stock"+CHR(13)+"ERP Stock with an added Service is a SALE of Inventory",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.INV
				ELSE
					REPLACE INV WITH .T. IN SalesQuote
				ENDIF
				IF SalesQuote.BRK
					MESSAGEBOX("You cannot have 'Inventory' and 'Broker' selected on same item."+CHR(13)+"Broker means needs to bring in Stock"+CHR(13)+"that means it not Inventory",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.GFM
					MESSAGEBOX("You cannot have 'Inventory' and 'GFM' selected on same item."+CHR(13)+"The GFM will Produce Material for the Sale"+CHR(13)+"that is not in Inventory",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Draw
					MESSAGEBOX("You cannot have 'Inventory' and 'Draw' selected on same item."+CHR(13)+"The Draw will Produce Material for the Sale"+CHR(13)+"that is not in Inventory",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Roll
					MESSAGEBOX("You cannot have 'Inventory' and 'Roll' selected on same item."+CHR(13)+"The Rolling Mill will Produce Material for the Sale"+CHR(13)+"that is not in Inventory",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Press
					MESSAGEBOX("You cannot have 'Inventory' and 'Press' selected on same item."+CHR(13)+"The Open Die Press will Produce Material for the Sale"+CHR(13)+"that is not in Inventory",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Mach
				ENDIF
				IF SalesQuote.CG
				ENDIF
				IF SalesQuote.Plasma
				ENDIF
				IF SalesQuote.WJet
				ENDIF
		
			CASE pValue = "B"
			*Broker, HPA is bringing in Material for Order with an ERP PO
				IF SalesQuote.Services
					MESSAGEBOX("You cannot have 'Broker' and 'Service' selected on same item."+CHR(13)+"Could be a broker Sale with Service work",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.INV
					MESSAGEBOX("You cannot have 'Broker' and 'Inventory' selected on same item.",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.BRK
				ELSE
					REPLACE BRK WITH .T. IN SalesQuote
				ENDIF
		
				IF SalesQuote.GFM
					MESSAGEBOX("You cannot have 'Broker' and 'GFM' selected on same item."+CHR(13)+"The GFM will Produce Material for the Sale"+CHR(13)+"Bringing in Stock to work on is OK"+CHR(13)+", but it is still a Production order",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Draw
					MESSAGEBOX("You cannot have 'Broker' and 'Draw' selected on same item."+CHR(13)+"The Draw will Produce Material for the Sale"+CHR(13)+"Bringing in Stock to work on is OK"+CHR(13)+", but it is still a Production order",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Roll
					MESSAGEBOX("You cannot have 'Broker' and 'Roll' selected on same item."+CHR(13)+"The Rolling Mill will Produce Material for the Sale"+CHR(13)+"Bringing in Stock to work on is OK"+CHR(13)+", but it is still a Production order",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Press
					MESSAGEBOX("You cannot have 'Broker' and 'Press' selected on same item."+CHR(13)+"The Open Die Press will Produce Material for the Sale"+CHR(13)+"Bringing in Stock to work on is OK"+CHR(13)+", but it is still a Production order",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Mach
				ENDIF
				IF SalesQuote.CG
				ENDIF
				IF SalesQuote.Plasma
				ENDIF
				IF SalesQuote.WJet
				ENDIF
			
			CASE pValue = "M"
			*Mill, Stock with Long due dates
				IF SalesQuote.Services
					MESSAGEBOX("You cannot have 'Mill' and 'Service' selected on same item."+CHR(13)+"Could be a Mill Sale and the Service is just Value Added ",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.INV
					WAIT WINDOW "Inv listed as 'Due In' is a Mill Order"+CHR(13)+"Mill Typ is used to explain why it took soo long to ship Stock to the customer" TIMEOUT 1
				ENDIF
				IF SalesQuote.BRK
				ELSE
					REPLACE BRK WITH .T. IN SalesQuote
				ENDIF
		
				IF SalesQuote.GFM
					MESSAGEBOX("You cannot have 'Mill' and 'GFM' selected on same item."+CHR(13)+"The GFM will Produce Material for the Sale"+CHR(13)+"Bringing in Stock to work on is OK"+CHR(13)+", but it is still a Production order",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Draw
					MESSAGEBOX("You cannot have 'Mill' and 'Draw' selected on same item."+CHR(13)+"The Draw will Produce Material for the Sale"+CHR(13)+"Bringing in Stock to work on is OK"+CHR(13)+", but it is still a Production order",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Roll
					MESSAGEBOX("You cannot have 'Mill' and 'Roll' selected on same item."+CHR(13)+"The Rolling Mill will Produce Material for the Sale"+CHR(13)+"Bringing in Stock to work on is OK"+CHR(13)+", but it is still a Production order",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Press
					MESSAGEBOX("You cannot have 'Mill' and 'Press' selected on same item."+CHR(13)+"The Open Die Press will Produce Material for the Sale"+CHR(13)+"Bringing in Stock to work on is OK"+CHR(13)+", but it is still a Production order",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF SalesQuote.Mach
				ENDIF
				IF SalesQuote.CG
				ENDIF
				IF SalesQuote.Plasma
				ENDIF
				IF SalesQuote.WJet
				ENDIF
				
			
			CASE pValue = "P"
			*Production work is rquired make make properties of the Sales
				IF SalesQuote.Services
					MESSAGEBOX("You cannot have 'Production' and 'Toll Work Service' selected on same item."+CHR(13)+"Production is on HPA material"+CHR(13)+"Toll Work is production on Customers Material",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			
			CASE pValue = "S"
			*Service Order/Toll Work on Customers Material
				IF NOT SalesQuote.Services
				
				ENDIF
			CASE pValue = "C"
			*Conversion without useing Big Production Equipment on Customers Material
			
			ENDCASE
			
		************************************
		CASE cField = "chkINV"
			IF pValue AND SalesQuote.Services
				MESSAGEBOX("You cannot have 'Inventory' and 'Service' selected on same item."+CHR(13)+"A Service does not use ERP Stock"+CHR(13)+"ERP Stock with an added Service is a SALE of Inventory",48,"Please choose only one!")
				RETURN .F.
			ENDIF
			
		CASE cField = "chkBRK"
			IF pValue AND SalesQuote.Services
				MESSAGEBOX("You cannot have 'Broker' and 'Service' selected on same item."+CHR(13)+"A Service does not use stock HPA must buy"+CHR(13)+"Stock with an added Service is a Value Added SALE ",48,"Please choose only one!")
				RETURN .F.
			ENDIF
			
		CASE cField = "chkService"
			*Toll Work Service Order
			IF pValue AND SalesQuote.INV
				MESSAGEBOX("You cannot have 'Inventory' and 'Service' selected on same item."+CHR(13)+"A Service does not use ERP Stock"+CHR(13)+"ERP Stock with an added Service is a SALE of Inventory",48,"Please choose only one!")
				RETURN .F.
			ENDIF
			IF pValue AND SalesQuote.BRK
				MESSAGEBOX("You cannot have 'Broker' and 'Service' selected on same item."+CHR(13)+"A Service does not use stock HPA must buy"+CHR(13)+"Stock with an added Service is a Value Added SALE ",48,"Please choose only one!")
				RETURN .F.
			ENDIF
			
		CASE cField = "chkDraw"
			IF SalesQuote.TYP == '' OR SalesQuote.TYP = 'P' OR SalesQuote.TYP = 'S' OR SalesQuote.TYP = 'C'
				*good
			ELSE
				IF pValue 
					cTYP = 	SalesQuote.TYP
					MESSAGEBOX("You cannot have 'Draw' and TYP '"+cTYP+"' selected on same item."+CHR(13)+"This is usually Production",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			ENDIF
		
		CASE cField = "chkGFM"
			IF SalesQuote.TYP == '' OR SalesQuote.TYP = 'P' OR SalesQuote.TYP = 'S' OR SalesQuote.TYP = 'C'
				*good
			ELSE
				IF pValue 
					cTYP = SalesQuote.TYP
					MESSAGEBOX("You cannot have 'GFM' and TYP '"+cTYP+"' selected on same item."+CHR(13)+"This is usually Production",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			ENDIF
			
		CASE cField = "chkRoll"
			IF SalesQuote.TYP == '' OR SalesQuote.TYP = 'P' OR SalesQuote.TYP = 'S' OR SalesQuote.TYP = 'C'
				*good
			ELSE
				IF pValue 
					cTYP = SalesQuote.TYP
					MESSAGEBOX("You cannot have 'Roll' and TYP '"+cTYP+"' selected on same item."+CHR(13)+"This is usually Production",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			ENDIF
		
		CASE cField = "chkPress"
			IF SalesQuote.TYP == '' OR SalesQuote.TYP = 'P' OR SalesQuote.TYP = 'S' OR SalesQuote.TYP = 'C'
				*good
			ELSE
				IF pValue 
					cTYP = 	SalesQuote.TYP
					MESSAGEBOX("You cannot have 'Press' and TYP '"+cTYP+"' selected on same item."+CHR(13)+"This is usually Production",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			ENDIF
		
		CASE cField = "chkMach"
		
		CASE cField = "chkCG"
		*	IF VAL(ThisFormSet.frmEO.pF1.pgOrder.txtForm.Value) > 25
		*		WAIT WINDOW "Centerless Grinder is normally done on Rounds" TIMEOUT 1
		*	ENDIF
		
		CASE cField = "chkPlasma"
			*check Form 40
		*	IF ThisFormSet.frmEO.pF1.pgOrder.txtForm.Value <> "40"
		*		WAIT WINDOW "Plasma is normally done on Plate" TIMEOUT 1
		*	ENDIF
		CASE cField = "chkWJet"
			*Check form 40
		*	IF ThisFormSet.frmEO.pF1.pgOrder.txtForm.Value <> "40"
		*		WAIT WINDOW "Water Jet is normally done on Plate" TIMEOUT 1
		*	ENDIF
		OTHERWISE
			TrackError("ThisFormSet.check_Prod_TYP(cField, )"+CHR(13)+"cField not Found","Bad Parameter", PROGRAM(), LINENO(1))
		ENDCASE
	ENDPROC

	PROCEDURE check_soitem_hrs
		PARAMETER lShowScreen
		*ThisFormSet.Check_SOitem_Hrs()
		
		IF VARTYPE(lShowScreen) != "L"
			lShowScreen = .F.
			*No Show also Saves!
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.cSOItem
		
		PRIVATE nINVhrs, nRecvHrs, nMachHrs, nCGhrs,nPackHrs,nGFMhrs,nDrawHrs,nRollHrs,nPressHrs
		PRIVATE nHeatHrs,nTestHrs,nAbrsvHrs,nBSawHrs,nShearHrs,nPlasmaHrs,nWJetHrs,nHrs
		IF lShowScreen
			nINVhrs 	= ThisFormset.frmSales_Review.pf.pgProd.spnINV.Value	
			nRecvHrs 	= ThisFormset.frmSales_Review.pf.pgProd.spnRecv.Value	
			nMachHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnMach.Value	
			nCGhrs		= ThisFormset.frmSales_Review.pf.pgProd.spnCG.Value	
			nPackHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnPack.Value	
			nGFMhrs		= ThisFormset.frmSales_Review.pf.pgProd.spnGFM.Value	
			nDrawHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnDraw.Value	
			nRollHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnRoll.Value
			nPressHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnPress.Value
			nHeatHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnHeat.Value
			nTestHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnTest.Value
			nAbrsvHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnAbrsv.Value
			nBSawHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnBSaw.Value
			nShearHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnShear.Value
			nPlasmaHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnPlasma.Value
			nWJetHrs	= ThisFormset.frmSales_Review.pf.pgProd.spnWJet.Value
		ELSE
			nINVhrs 	= 0
			nRecvHrs 	= 0
			nMachHrs	= 0
			nCGhrs		= 0
			nPackHrs	= 0
			nGFMhrs		= 0
			nDrawHrs	= 0
			nRollHrs	= 0
			nPressHrs	= 0
			nHeatHrs	= 0
			nTestHrs	= 0
			nAbrsvHrs	= 0
			nBSawHrs	= 0
			nShearHrs	= 0
			nPlasmaHrs	= 0
			nWJetHrs	= 0
		
			IF USED('tmp_Hrs')
				USE IN tmp_Hrs
			ENDIF
			
			cSQL = "SELECT * FROM dbo.SOitem_Hrs WITH(NOLOCK) "
			*cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"tmp_Hrs")
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmp_Hrs')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmp_Hrs")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmp_Hrs")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmp_Hrs')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('tmp_Hrs')
				IF RECCOUNT('tmp_Hrs') > 0
					nINVhrs 	= PrepareSQLnum(tmp_Hrs.INV,'INV',-2)
					nRecvHrs 	= PrepareSQLnum(tmp_Hrs.Recv,'Recv',-2)
					nMachHrs	= PrepareSQLnum(tmp_Hrs.Mach,'Mach',-2)
					nCGhrs		= PrepareSQLnum(tmp_Hrs.CG,'CG',-2)
					nPackHrs	= PrepareSQLnum(tmp_Hrs.Pack,'Pack',-2)
					nGFMhrs		= PrepareSQLnum(tmp_Hrs.GFM,'GFM',-2)
					nDrawHrs	= PrepareSQLnum(tmp_Hrs.Draw,'Draw',-2)
					nRollHrs	= PrepareSQLnum(tmp_Hrs.Roll,'Roll',-2)
					nPressHrs	= PrepareSQLnum(tmp_Hrs.Press,'Press',-2)
					nHeatHrs	= PrepareSQLnum(tmp_Hrs.Heat,'Heat',-2)
					nTestHrs	= PrepareSQLnum(tmp_Hrs.Test,'Test',-2)
					nAbrsvHrs	= PrepareSQLnum(tmp_Hrs.Abrsv,'Abrsv',-2)
					nBSawHrs	= PrepareSQLnum(tmp_Hrs.BSaw,'BSaw',-2)
					nShearHrs	= PrepareSQLnum(tmp_Hrs.Shear,'Shear',-2)
					nPlasmaHrs	= PrepareSQLnum(tmp_Hrs.Plasma,'Plasma',-2)
					nWJetHrs	= PrepareSQLnum(tmp_Hrs.Wjet,'Wjet',-2)
				ENDIF
				USE IN tmp_Hrs
			ENDIF
		ENDIF
		
		SELECT SalesQuote
		IF SalesQuote.Inv
			IF nINVhrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnINV.Value = 1
				ENDIF
				nINVhrs = 1
			ENDIF
		ENDIF
		
		IF PrepareSQLnum(SalesQuote.HPAPo,'HPAPO',-3) > 0
			IF nRecvHrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnRecv.Value = 1	
				ENDIF
				nRecvHrs = 3
			ENDIF
		ENDIF
		**
		IF SalesQuote.Mach
			IF nMachHrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnMach.Value = 1
				ENDIF
				nMachHrs = 1
			ENDIF
		ENDIF
		**
		IF SalesQuote.CG
			IF nCGhrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnCG.Value = 4
				ENDIF
				nCGhrs = 4
			ENDIF
		ENDIF
		**
		*IF nPackHrs = 0
		*	ThisFormset.frmSales_Review.pf.pgProd.spnPack.Value = 1
		*	nPackHrs = 1
		*ENDIF
		**
		IF SalesQuote.GFM
			IF nGFMhrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnGFM.Value = 20
				ENDIF
				nGFMhrs = 20
			ENDIF
		ENDIF
		**
		IF SalesQuote.Draw
			IF nDrawHrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnDraw.Value = 2
				ENDIF
				nDrawHrs = 2
			ENDIF
		ENDIF
		**
		IF SalesQuote.Roll
			IF nRollHrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnRoll.Value = 20
				ENDIF
				nRollHrs = 20
			ENDIF
		ENDIF
		**
		IF SalesQuote.Press
			IF nPressHrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnPress.Value = 20
				ENDIF
				nPressHrs = 20
			ENDIF
		ELSE
			nPressHrs = 0
		ENDIF
		**
		IF SalesQuote.GFM OR SalesQuote.Roll OR SalesQuote.Press
			IF nHeatHrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnHeat.Value = 8
				ENDIF
				nHeatHrs = 8
			ENDIF
		ENDIF
		**
		IF SalesQuote.GFM OR SalesQuote.Draw OR SalesQuote.Roll OR SalesQuote.Press
			IF nTestHrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnTest.Value = 40
				ENDIF
				nTestHrs = 40
			ENDIF
		ENDIF
		**
		*IF nAbrsvHrs = 0
		*	nAbrsvHrs = 0
		*	nAbrsvHrs 
		*ENDIF
		**
		*IF nBSawHrs = 0
		*	nBSawHrs = 0
		*	nBSawHrs 
		*ENDIF
		**
		IF SalesQuote.Plasma
			IF nPlasmaHrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnPlasma.Value = 2
				ENDIF
				nPlasmaHrs = 2
			ENDIF
		ENDIF
		**
		IF SalesQuote.Plasma
			IF nWJetHrs = 0
				IF lShowScreen
					ThisFormset.frmSales_Review.pf.pgProd.spnWJet.Value = 2
				ENDIF
				nWJetHrs = 2
			ENDIF
		ENDIF
		
		*******************
		PRIVATE nCutHR
		nCutHR = PrepareSQLnum(SalesQuote.CutHR,'CutHR',-2)
		******
		*Override with Sales.CutHR
		IF VARTYPE(SalesQuote.Cut) = "C"
			DO CASE
			CASE SalesQuote.Cut = 'N'
			*-	not specified
			CASE SalesQuote.Cut = 'A'
			*	-abrasive
			CASE SalesQuote.Cut = 'B'
			*	-band saw
			CASE SalesQuote.Cut = 'S'
			*	-shear
			CASE SalesQuote.Cut = 'P'
			*	-plasma
				ThisFormset.frmSales_Review.pf.pgProd.spnPlasma.Value = nCutHR 
				nPlasmaHrs = nCutHR 
			CASE SalesQuote.Cut = 'W'
			*	-waterjet
				ThisFormset.frmSales_Review.pf.pgProd.spnWJet.Value = nCutHR 
				nWJetHrs = nCutHR 
			ENDCASE
		ENDIF
		**
		
		
		nHrs = nINVhrs + nRecvHrs + nMachHrs + nCGhrs + nPackHrs + nGFMhrs + nDrawHrs + nRollHrs + nPressHrs 
		nHrs = nHrs + nHeatHrs + nTestHrs + nAbrsvHrs + nBSawHrs + nShearHrs +nPlasmaHrs + nWJetHrs
		nHrs = nHrs + 1
		
		
		IF lShowScreen
			ThisFormset.frmSales_Review.pf.pgProd.lblHRS.Caption = STR(nHrs)
		ELSE
			IF USED('tmpSOi_Hrs')
				USE IN tmpSOi_Hrs
			ENDIF
			
			cSQL = "UPDATE dbo.SOitem_Hrs "
			cSQL = cSQL + "SET INV="+STR(nINVhrs)
			cSQL = cSQL + ",Recv="+STR(nRecvHrs)
			cSQL = cSQL + ",[Mach]="+STR(nMachHrs)
			cSQL = cSQL + ",CG="+STR(nCGhrs)
			cSQL = cSQL + ",[Pack]="+STR(nPackHrs)
			cSQL = cSQL + ",[GFM]="+STR(nGFMhrs)
			cSQL = cSQL + ",[Draw]="+STR(nDrawHrs)
			cSQL = cSQL + ",[Roll]="+STR(nRollHrs)
			cSQL = cSQL + ",Press="+STR(nPressHrs)
			cSQL = cSQL + ",Heat="+STR(nHeatHrs)
			cSQL = cSQL + ",Test="+STR(nTestHrs)
			cSQL = cSQL + ",Abrsv="+STR(nAbrsvHrs)
			cSQL = cSQL + ",BSaw="+STR(nBSawHrs)
			cSQL = cSQL + ",Shear="+STR(nShearHrs)
			cSQL = cSQL + ",Plasma="+STR(nPlasmaHrs)
			cSQL = cSQL + ",WJet="+STR(nWJetHrs)
			cSQL = cSQL + ",Hrs="+STR(nHrs)
			*cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOItem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"tmpSOi_Hrs")
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOi_Hrs')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOi_Hrs")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOi_Hrs")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSOi_Hrs')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					RETURN .F.
				ENDIF
			ENDIF
		
		ENDIF
		
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ThisFormSet.frmWOD) = "O"  &&
			ThisFormSet.frmWOD.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmWO) = "O"
			ThisFormSet.frmWO.Release
		ENDIF
		
		IF VARTYPE(ThisFormSet.frmRouter) = "O"
			ThisFormSet.frmRouter.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmRouterDetailOrder) = "O"
			ThisFormSet.frmRouterDetailOrder.Release
		ENDIF
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		
	ENDPROC

	PROCEDURE didsoitem_usestock
		*ThisFormSet.didSOitem_UseStock()
		
		IF USED('tmpUseINV')
			USE IN tmpUseINV
		ENDIF
		
		cSQL="SELECT TBL FROM ( "
		cSQL = cSQL + " SELECT 'S' AS TBL FROM dbo.StockLst_Process "
		cSQL = cSQL + " 	WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOitem+"')"
		cSQL = cSQL + " AND Process_ID='SELECTED  '"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT 'B' AS TBL FROM dbo.BrokerLst_Process "
		cSQL = cSQL + " 	WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOitem+"')"
		cSQL = cSQL + " AND Process_ID='SELECTED  '"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT 'W' AS TBL FROM dbo.WIPLst_Process "
		cSQL = cSQL + " 	WHERE SOitem = dbo.f_ProperSOitem('"+ThisFormSet.cSOitem+"')"
		cSQL = cSQL + " AND Process_ID='SELECTED  '"
		cSQL = cSQL + " ) t "
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUseINV')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUseINV')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUseINV")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUseINV")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpUseINV')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		PRIVATE cTyp
		cTyp = ALLTRIM(PrepareSQLtxt(SalesQuote.Typ,'TYP',1))
		
		IF USED('tmpUseINV')
			IF RECCOUNT('tmpUseINV') > 0
				SCAN
					IF tmpUseINV.TBL="S"
						*Found a Inventory selected process!
						SELECT SalesQuote
						REPLACE SalesQuote.INV WITH .T.
						IF LEN(ALLTRIM(cTyp))=0
							REPLACE SalesQuote.Typ WITH 'I'
						ELSE
							IF SalesQuote.Typ != 'I'
								WAIT WINDOW "Found Marked Inventory, it is wrong that Sales 'Type' is listed as: "+SalesQuote.Typ TIMEOUT 1
							ENDIF
						ENDIF
					ENDIF
					IF tmpUseINV.TBL="B"
						*Found a Inventory selected process!
						SELECT SalesQuote
						REPLACE SalesQuote.BRK WITH .T.
						IF LEN(ALLTRIM(cTyp))=0
							REPLACE SalesQuote.Typ WITH 'B'
						ELSE
							IF SalesQuote.Typ != 'B'
								WAIT WINDOW "Found Marked Brokered Stock, it is wrong that Sales 'Type' is listed as: "+SalesQuote.Typ TIMEOUT 1
							ENDIF
						ENDIF
					ENDIF
		
				ENDSCAN
			ENDIF
			USE IN tmpUseINV
		ENDIF
		
		*ThisFormSet.frmEO.pf1.pgOrder.chkInv.Refresh
		*ThisFormSet.frmEO.pf1.pgOrder.cmbTyp.Refresh
	ENDPROC

	PROCEDURE Init
		PARAMETER pSOitem
		*DO FORM Forms\Sales_Review WITH ' 140275-01'
		
		IF VARTYPE(pSOitem)<>"C"
			pSOitem = ' 140275-01'
			PRIVATE nSO, cSOitem
			DO FORM Forms\ChooseSO WITH "ReviewSO" TO nSO
			IF VARTYPE(nSO) = "N"
				DO FORM Forms\ChooseSOitem WITH nSO TO cSOItem
			ELSE
				IF VARTYPE(nSO) = "C"
					cSOitem = nSO
				ENDIF
			ENDIF
			
			pSOitem = cSOitem
		ENDIF
		
		IF Proper_SO_Item(pSOitem) = Proper_SO_Item('')
			RETURN .F.
		ENDIF
		
		ThisFormSet.cSOitem = Proper_SO_Item(pSOitem)
		ThisFormSet.nSalesNum = Proper_SO(pSOitem)
		
		ThisFormSet.Load_Sales()
		
		IF NOT USED('tmpSOitemRV')
			MESSAGEBOX("Could not load 'Sales'",0,"SQL Error")
			RETURN TO MASTER
		ENDIF
		
		
		*ThisFormSet.frmWO.Left	= ThisFormSet.frmEO.Left+ThisFormSet.frmEO.Width +15
		*ThisFormSet.frmWO.Top	= ThisFormSet.frmEO.Top - 2
		
		*ThisFormSet.frmWOD.Left	= ThisFormSet.frmEO.Left+ThisFormSet.frmEO.Width +15
		*ThisFormSet.frmWOD.Top	= ThisFormSet.frmEO.Top + ThisFormSet.frmWO.Height + 20
		
		*ThisFormSet.frmEoP.Visible = .F.
		
		*ThisFormSet.frmPO.AlwaysOnTop = .T.
		*ThisFormSet.frmEO.AlwaysOnTop = .F.
		*
		*ThisFormSet.ShowWO_WOD_Window()
		ThisFormSet.Refresh_SalesQuote(1)
		ThisFormSet.didSOitem_UseStock()
		
		
		ThisFormSet.nrtr_ID = get_rtr_ID('SOitem',ThisFormSet.cSOitem, ThisFormSet.nConnhandle)
		*ThisFormSet.rtr_pgStock()
		ThisFormSet.rtr_Browse_Detail()
		
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVEF
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_RTR ADDITIVE
		ENDIF
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE load_sales
		*ThisForm.Load_Sales()
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpSOitemRV")
			*ThisForm.grd_SOitem.RecordSource = ''
			
			USE IN tmpSOitemRV
		ENDIF
		SELECT 0
		
		cSQL="SELECT S.* "
		cSQL=cSQL+" ,dbo.f_DescriptCL(AQ.Alloy,AQ.CC,AQ.CL,AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen) AS DescriptCL "
		cSQL=cSQL+" ,SN.* "
		cSQL=cSQL+" ,AQ.Services, AQ.Metric "
		cSQL=cSQL+" FROM dbo.Sales S WITH(NOLOCK) "
		cSQL=cSQL+" inner join dbo.AllQuotes AQ WITH(NOLOCK) ON S.SOitem = AQ.SOitem "
		cSQL=cSQL+" inner join dbo.Sales_No SN WITH(NOLOCK) ON S.SalesNum = SN.SalesNum "
		cSQL=cSQL+" WHERE S.SOitem = '"+ThisFormSet.cSOitem+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitemRV')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitemRV')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitemRV")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitemRV")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitemRV' )
		ENDIF
		
		
		IF USED('tmpSOitemRV')
			SELECT tmpSOitemRV
		*	ThisForm.grd_SOitem.RecordSource = 'tmpSOitemRV'
		*	ThisForm.grd_SOitem.Refresh
			
			ThisFormSet.Refresh_SOitem()
			
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE refresh_salesquote
		PARAMETERS nRecNo
		*ThisFormSet.Refresh_SalesQuote(1)
		*worksheet22.frx uses this data - Also used in Shop_StockLst_Edit
		
		IF VARTYPE(nRecNo) != "N"
			nRecNo = 1
		ENDIF
		
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		cSQL = " SELECT "
		cSQL = cSQL + "  A.Company,A.name,A.phone,A.phone_ext,A.fax,A.phone_ext,A.email,A.PO_num,A.alloy,a.form,A.cc,A.CL,A.pieces,A.thck,A.Sz2,A.sz3,A.weight,A.descript"
		cSQL = cSQL + " ,a.p_lb,A.p_pc,A.p_ft,a.cuts,A.otherfld,A.otherp,A.lotp,A.lotcost,A.leadtime,A.cweight,A.cp_lb,A.cp_lb,A.cp_pcc,A.cthk"
		cSQL = cSQL + " ,A.clotcp,A.clotp,A.ccut,A.Inqdate,A.Inqnum,A.InqNumP,A.SalesP"
		cSQL = cSQL + " ,A.HPApo,A.POitem,A.saledate,A.shipdate,A.buyfrom,A.buycost,A.buyfrom2,A.HPApo2,A.open_,A.Bracket,A.CustID,A.QuoteMemo,A.Comments"
		cSQL = cSQL + " ,A.CountryC,A.Country,A.Services,A.RandLen,A.Metric,A.StartStock,A.TN,A.sz1orig,A.sz2orig,A.sz3orig,A.QuoteDate"
		cSQL = cSQL + " ,A.Cover,A.ID,A.line1"
		*--,A.WO
		cSQL = cSQL + " ,A.CutOptions,A.Cut,A.CutHR "
		cSQL = cSQL + " ,A.SalesNum AS SalesNum_a, A.SOitem AS SOitem_a, A.Item AS Item_a "
		
		cSQL = cSQL + " ,S.SOitem,S.SalesNum,S.item,S.OrderSpec,S.S_instrct,S.Inv,S.BRK,S.GFM,S.Draw,S.Roll,S.Press,S.Mach,S.CG,S.Plasma,S.WJet,S.Cert"
		*cSQL = cSQL + " ,S.converpo,S.converter,S.conversion,S.converfrt,S.conversent,S.converretu"
		cSQL = cSQL + " ,S.itemtot,S.shipdue,S.shipped,S.matlwt "
		cSQL = cSQL + " ,S.cncld,S.cmplt,S.partno,S.itemcost,S.itemsale,S.gs_cost,S.gs_sale,S.gs_cmplt,S.rma_no,S.qa,S.cofc,s.merc,S.ppo,S.ppn,S.pheat,S.pspec,S.pdesc,S.pother,S.other "
		cSQL = cSQL + " ,S.prcp,S.prcd,S.pckd,S.Urgent,S.shipon,S.Tol,S.JobHours,S.ProcLoc,S.DShip,S.Typ "
		cSQL = cSQL + " ,S.WO,S.StkPaid,S.WO_Detail "
		cSQL = cSQL + " ,S.ProductionWO, S.IntP, S.Export, S.StkCost, S.POCost "
		cSQL = cSQL + " ,S.Quoted_QTY, S.Quoted_P, S.Quoted_Total, S.Quoted_PU, S.RMA_No "
		cSQL = cSQL + " ,A.Q_P, A.Q_QTY, A.Q_PU, A.Q_Total" &&Q_QTY is Customer
		cSQL = cSQL + " ,A.S_QTY, A.S_P, A.S_PU"	&& S_QTY is Acct Stnd
		cSQL = cSQL + " ,A.StandardSize, A.CustDisc, ISNULL(S.Hold,0) AS Hold " 
		cSQL = cSQL + " ,S.S_P, S.S_QTY, S.S_PU "  &&ERP Acct Stnd (PriceTable)
		*&&Use AllQuote A.S_QTY,A.S_PU over this Sales Data.
		*S.RVW_Stock, S.RVW_Prod, S.Review_Date
		cSQL = cSQL + " FROM dbo.AllQuotes A "
		cSQL = cSQL + " INNER JOIN dbo.Sales S ON A.SOitem = S.SOitem "
		*cSQL = cSQL + " INNER JOIN dbo.Sales_No SN ON A.SalesNum = SN.SalesNum "	
		cSQL = cSQL + " WHERE A.SOitem = '"+ThisFormSet.cSOitem+"'"
		cSQL = cSQL + " ORDER BY A.Item "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'SalesQuote')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'SalesQuote')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SalesQuote")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SalesQuote")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'SalesQuote')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		
		IF nRecNo <= RECCOUNT('SalesQuote')
			GOTO nRecNo IN SalesQuote
		ENDIF
		
		*!*	*These use the ControlSource SalesQuote.
		*!*	ThisFormSet.frmEO.pf1.pgOrder.Refresh
		*!*	*WO_Production
		*!*	*IntP
		
		
	ENDPROC

	PROCEDURE refresh_soitem
		*ThisForm.Refresh_SOitem()
		
		ThisFormSet.frmSales_Review.lblCancelled.Visible = PrepareSQLlogic(tmpSOitemRV.cncld,'cncld',.F.)
		ThisFormSet.frmSales_Review.lblComplete.Visible = PrepareSQLlogic(tmpSOitemRV.cmplt,'cmplt',.F.)
		
		ThisFormSet.frmSales_Review.SOitem.Value = ThisFormSet.cSOitem &&PrepareSQLtxt(tmpSOitemRV.SOitem,'SOitem',10)
		
		
		IF PrepareSQLlogic(tmpSOitemRV.INV,'INV',.F.)
			ThisFormSet.frmSales_Review.lblINV.Visible = .T.
		ELSE
			ThisFormSet.frmSales_Review.lblINV.Visible = .F.
		ENDIF
			
		PRIVATE cTYP
		cTYP = PrepareSQLtxt(tmpSOitemRV.TYP,'TYP',1)
		DO CASE
		CASE cTYP = "I"
			ThisFormSet.frmSales_Review.lblTyp.Caption = "INV"
		CASE cTYP = "B"
			ThisFormSet.frmSales_Review.lblTyp.Caption = "Brokr"
		CASE cTYP = "M"
			ThisFormSet.frmSales_Review.lblTyp.Caption = "Mill"
		CASE cTYP = "P"
			ThisFormSet.frmSales_Review.lblTyp.Caption = "PROD"
		CASE cTYP = "S"
			ThisFormSet.frmSales_Review.lblTyp.Caption = "SRVC"
		CASE cTYP = "C"
			ThisFormSet.frmSales_Review.lblTyp.Caption = "TOLL"
			
		OTHERWISE
			ThisFormSet.frmSales_Review.lblTyp.Caption = ""
		ENDCASE
			
		PRIVATE lReviewMark, lRVW_Stock, lRVW_Prod
		lReviewMark = PrepareSQLlogic(tmpSOitemRV.Review,'Review',.F.)
		lRVW_Stock  = PrepareSQLlogic(tmpSOitemRV.RVW_Stock,'RVW_Stock',.F.)
		lRVW_Prod	= PrepareSQLlogic(tmpSOitemRV.RVW_Prod,'RVW_Prod',.F.)
		
		ThisFormSet.frmSales_Review.chkReview.Value = lReviewMark 
		ThisFormSet.frmSales_Review.cmdClearReview.Visible = PrepareSQLlogic(tmpSOitemRV.Review,'Review',.F.)
		
		ThisFormSet.frmSales_Review.pf.pgStock.chkRVW_Stock.Value = lRVW_Stock  
		ThisFormSet.frmSales_Review.pf.pgProd.chkRVW_Prod.Value = lRVW_Prod
		*ThisFormSet.frmSales_Review.pf.pgQuality.chk
		*ThisFormSet.frmSales_Review.pf.pgShip.chk
		ThisFormSet.frmSales_Review.pf.pgVerify.chkRVW_Stock.Value = lRVW_Stock  
		ThisFormSet.frmSales_Review.pf.pgVerify.chkRVW_Prod.Value = lRVW_Prod
		ThisFormSet.frmSales_Review.pf.pgVerify.chkReview.Value = lReviewMark 
		ThisFormSet.frmSales_Review.pf.pgVerify.txtReview_Date.Value = PrepareSQLtxt(tmpSOitemRV.Review_Date,'Review_Date',12)
		
		*********************
		ThisFormSet.frmSales_Review.pf.pgStock.lblSOitem.Caption = tmpSOitemRV.SOitem
		ThisFormSet.frmSales_Review.pf.pgStock.txtSalesRep.Value = tmpSOitemRV.SalesRep
		
		ThisFormSet.frmSales_Review.pf.pgStock.txtDescript.Value = tmpSOitemRV.DescriptCL
		ThisFormSet.frmSales_Review.pf.pgStock.chkRVW_Stock.Value	= PrepareSQLchk(tmpSOitemRV.RVW_Stock,'Review',.F.)
		*ThisFormSet.frmSales_Review.pf.pgStock.chkRVW_Prod.Value	= PrepareSQLchk(tmpSOitemRV.RVW_Prod,'Review',.F.)
		
		ThisFormSet.frmSales_Review.pf.pgStock.txtPT_Total.Value = PrepareSQLnum(tmpSOitemRV.PT_Total,'Total',9,2)
		
		ThisFormSet.frmSales_Review.pf.pgStock.cmbCert.Value = tmpSOitemRV.Cert
		ThisFormSet.frmSales_Review.pf.pgStock.cmbProcLoc.Value = tmpSOitemRV.ProcLoc
		ThisFormSet.frmSales_Review.pf.pgStock.cmbTyp.Value		= tmpSOitemRV.TYP
		
		ThisFormSet.frmSales_Review.pf.pgStock.chkService.Value = tmpSOitemRV.Services
		ThisFormSet.frmSales_Review.pf.pgStock.chkInv.Value = tmpSOitemRV.INV
		ThisFormSet.frmSales_Review.pf.pgStock.chkMach.Value = tmpSOitemRV.Mach
		ThisFormSet.frmSales_Review.pf.pgStock.chkCG.Value = tmpSOitemRV.CG
		ThisFormSet.frmSales_Review.pf.pgStock.chkPLasma.Value = tmpSOitemRV.Plasma
		ThisFormSet.frmSales_Review.pf.pgStock.chkWJet.Value = tmpSOitemRV.Wjet
		
		ThisFormSet.frmSales_Review.pf.pgStock.chkCncld.Value = PrepareSQLchk(tmpSOitemRV.cncld,'cncld',.F.)
		ThisFormSet.frmSales_Review.pf.pgStock.chkCmplt.Value = PrepareSQLchk(tmpSOitemRV.cmplt,'cmplt',.F.)
		
		ThisFormSet.frmSales_Review.pf.pgStock.txtPartNo.Value	= tmpSOitemRV.PartNo
		ThisFormSet.frmSales_Review.pf.pgStock.txtOrderSpec.Value	= tmpSOitemRV.OrderSpec
		ThisFormSet.frmSales_Review.pf.pgStock.edtQuote_S_Instrct.Value	= tmpSOitemRV.S_Instrct
		
		*ThisFormSet.frmSales_Review.pf.pgStock.chkCancelItem.Value	= tmpSOitemRV
		
		****************
		ThisFormSet.frmSales_Review.pf.pgProd.chkRVW_Prod.Value	= PrepareSQLchk(tmpSOitemRV.RVW_Prod,'Review',.F.)
		ThisFormSet.frmSales_Review.pf.pgProd.lblSOitem.Caption = tmpSOitemRV.SOitem
		
