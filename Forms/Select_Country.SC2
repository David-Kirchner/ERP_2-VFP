DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="2" />

	*<PropValue>
		DataSource = .NULL.
		Height = 200
		Left = 1
		Name = "Dataenvironment"
		Top = 220
		Width = 520
	*</PropValue>

ENDDEFINE

DEFINE CLASS frmselectpo_item AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdSelect" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Grid1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: closeconn
		*p: country
		*p: creturnvalue		&& Value to be returned ( Selected source Company)
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Country"
		closeconn = .F.
		country = ''
		creturnvalue = ""
		DataSession = 2
		DoCreate = .T.
		Height = 282
		Icon = graphics\earth-globe.ico
		Left = 4
		LockScreen = .F.
		MDIForm = .T.
		Name = "frmSelectPO_item"
		nconnhandle = 0
		Top = 5
		Width = 243
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdCancel' AS commandbutton WITH ;
		Caption = "Cancel", ;
		Height = 27, ;
		Left = 132, ;
		Name = "cmdCancel", ;
		TerminateRead = .T., ;
		Top = 240, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSelect' AS commandbutton WITH ;
		Caption = "Select", ;
		Default = .T., ;
		Height = 27, ;
		Left = 12, ;
		Name = "cmdSelect", ;
		Top = 240, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Grid1' AS grid WITH ;
		Height = 216, ;
		Left = 12, ;
		Name = "Grid1", ;
		Top = 12, ;
		Width = 216
		*< END OBJECT: BaseClass="grid" />
	
	PROCEDURE Init
		PARAMETERS cCurrCountry
		*DO FORM Forms\Select_Country WITH cCurrCountry TO cNewCountry
		
		IF VARTYPE(cCurrCountry) = "C"
			ThisForm.Country = cCurrCountry 
		ELSE
			ThisForm.Country = ''
		ENDIF
		
		IF USED("tmpCountries")
			USE IN tmpCountries
		ENDIF
		cSQL ="SELECT CountryCode AS CC, Restricted AS R, CountryDesc FROM dbo.Countries"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountries')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCountries')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountries")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountries")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpCountries')
		ENDIF
		
		IF NOT USED('tmpCountries')
			MESSAGEBOX( "Could not loading the table.","Program Error")
			RETURN ""
		ENDIF
		
		SELECT tmpCountries
		IF NOT EMPTY(ThisForm.Country)
			LOCATE FOR CC = ThisForm.Country
		ENDIF
		ThisForm.grid1.RecordSource = "tmpCountries"
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		*IF VARTYPE(gnConnHandle) = "N"
		*	ThisForm.CloseConn = .F.
		*	ThisForm.nConnHandle = gnConnHandle
		*ELSE
			ThisForm.CloseConn = .T.
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		*ENDIF
		
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		IF USED('tmpCountries')
			USE IN tmpCountries
		ENDIF
		
		RETURN THISFORM.cReturnValue
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF USED("tmpCountries")
			IF VARTYPE(tmpCountries.CC) = "C"
				IF tmpCountries.R 
					MESSAGEBOX("Cannot Select a Restricted Country",48,"Restricted Country!")
					RETURN .F.
				ENDIF
				ThisForm.cReturnValue = tmpCountries.CC
			ELSE
				MESSAGEBOX( "No Country Selected",0+48,"Nothing will be returned.")
			ENDIF
		ELSE
			MESSAGEBOX("No Country Selected"+CHR(13)+"Did not find 'tmpCountries' table.",0+48,"Nothing will be returned.")
		ENDIF
		ThisForm.Release
	ENDPROC

ENDDEFINE
