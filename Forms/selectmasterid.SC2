	PROCEDURE Init
		PARAMETERS pSQL
		
		IF TYPE('pSQL') != "C"
			WAIT WINDOW "No parameter"
			pSQL = "SELECT DISTINCT ID FROM dbo.Ar_Stocklst_Master_History  WHERE Alloy = 'C-276' AND Form = '10' AND Size=1.875 AND [WHAT] = 'DELETE'"
		ENDIF
		
		PUBLIC cCurrentDBF
		cCurrentDBF = ALIAS()
		
		IF NOT "QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make SQL connection', 16, 'SQL Connect Error')
		ENDIF
		
			
		IF TYPE('pSQL') = 'C'
			ThisForm.cSQL = pSQL
			ThisForm.cmdSearch.Click
		ENDIF
		
		*IF USED('tmpSearch')
		*	ThisForm.Grid1.RecordSource = 'tmpSearch'
		*ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
	ENDPROC

	PROCEDURE Resize
		*ThisForm.Grid1.Height = This.Height - 137 &&252 - 389 = 137
		*ThisForm.Grid1.Width = This.Width - 29 &&588 - 617 = 29
	ENDPROC

	PROCEDURE searchnow
		PRIVATE cSQL_field, cSQL_where
		
		cSQL_field = ThisForm.GetSQL_field()
		cSQL_where = ThisForm.GetSQL_where( cSQL_field )  
		
		IF NOT EMPTY(ThisForm.editHoldAnd.Value)
			cSQL_where = cSQL_where + ThisForm.editHoldAnd.Value
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		SELECT 0
		DO CASE
		CASE UPPER(ThisForm.cSearchTable) = "ALLQUOTES"
			ThisForm.Grid1.RecordSource = ''
			cSQL ="SELECT * FROM dbo.AllQuotes WHERE " + cSQL_where + " ORDER BY " + cSQL_field + ",InqDate DESC "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'')
			ENDIF
			ThisForm.Grid1.Enabled = .T.
			ThisForm.Grid1.RecordSourceType = 1
			ThisForm.SetSortOrder()
			ThisForm.Grid1.RecordSource = 'tmpSearch'
			ThisForm.Grid1.Enabled = .T.
			ThisForm.Grid1.Visible = .T.
			ThisForm.Grid1.Refresh()
		
		CASE UPPER(ThisForm.cSearchTable) = "QUOTES"
			ThisForm.Grid1.RecordSource = ''
			IF EMPTY(gcSalesp)
				WAIT WINDOW "Enter your Inital!" TO gcSalesp
			ENDIF
			cSQL ="SELECT * FROM dbo.AllQuotes WHERE SalesP = '"+ALLTRIM(gcSalesp)+"' AND " + cSQL_where + " ORDER BY " + cSQL_field + ",InqDate DESC "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'')
			ENDIF
			ThisForm.Grid1.Enabled = .T.
			ThisForm.Grid1.RecordSourceType = 1
			ThisForm.SetSortOrder()
			ThisForm.Grid1.RecordSource = 'tmpSearch'
			ThisForm.Grid1.Enabled = .T.
			ThisForm.Grid1.Visible = .T.
			ThisForm.SetSortOrder()
			ThisForm.Grid1.Refresh()
		
		OTHERWISE
			cSQL_statement = "SELECT * FROM HPA!" + ThisForm.cSearchTable + " WHERE " + cSQL_where + " ORDER BY " + cSQL_field + ",InqDate DESC" + " NOCONSOLE INTO CURSOR tmpSearch"
			ThisForm.Grid1.Enabled = .T.
			ThisForm.Grid1.rECORDsOURCEtYPE = 4
			ThisForm.SetSortOrder()
			ThisForm.Grid1.RecordSource = cSQL_statement
			ThisForm.Grid1.Enabled = .T.
			ThisForm.Grid1.Visible = .T.
			ThisForm.SetSortOrder()
			ThisForm.Grid1.Refresh()
		ENDCASE
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		
		IF NOT EMPTY(cCurrentDBF)
			SELECT (cCurrentDBF)
		ENDIF
		
		IF VARTYPE(ThisForm.nConnHandle) = "N"
			=SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		
		RETURN ThisForm.nReturnKey
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.nReturnKey = 0
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSearch.Click
		*Reset Selected row
		*THISFORM.SelectRecordDisplay("OFF")
		
		*ThisForm.Grid1.RecordSource = ''
		
		PRIVATE cHoldID
		cHoldID = ''
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('tmpID')
			USE IN tmpID
		ENDIF
		SELECT 0
		
		cSQL = ThisForm.cSQL
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID')
		ENDIF
		
		PRIVATE cSQL
		
		
		IF USED('tmpID')
			SELECT tmpID
			SCAN 
				
				IF USED('tmpID_History')
					SELECT tmpID_History
				ELSE
					SELECT 0
				ENDIF
				
				cSQL= "SELECT TOP 1 ID_History FROM dbo.Ar_Stocklst_Master_History WHERE ID = "+ALLTRIM(STR(tmpID.ID))+" AND [WHAT] = 'DELETE    ' ORDER BY ID_History DESC"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_History')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_History')
				ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpID_History')
				ENDIF
		
				IF USED('tmpID_History')
					IF VARTYPE(tmpID_History.ID_History) = "N"
						IF tmpID_History.ID_History > 0
										
							IF EMPTY(cHoldID)
								cHoldID = " WHERE ID_History="+ALLTRIM(STR(tmpID_History.ID_History))
							ELSE
								cHoldID = cHoldID + " OR ID_History="+ALLTRIM(STR(tmpID_History.ID_History))
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				
				SELECT tmpID
				LOOP
			ENDSCAN
			USE IN tmpID
		
		ENDIF
		
		IF !EMPTY(cHoldID)
		
			IF USED('tmpSearch')
				SELECT tmpSearch
			ELSE
				SELECT 0
			ENDIF
			
			cSQL = "SELECT Alloy,Form,CC,CL,Size,Cond,Specs,Heat,Lot,PO_item,Mill,StkDate,BrandName,ID_History FROM dbo.Ar_Stocklst_Master_History "+cHoldID+""
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpSearch')
			ENDIF
		
			ThisForm.txtAlloy.Value		= tmpSearch.Alloy
			ThisForm.txtForm.Value		= tmpSearch.Form
			ThisForm.txtCC.Value		= tmpSearch.CC
			ThisForm.txtCL.Value		= tmpSearch.CL
			ThisForm.txtSize.Value		= tmpSearch.Size
			ThisForm.txtCond.Value		= tmpSearch.Cond
			ThisForm.txtSpecs.Value		= tmpSearch.Specs
			ThisForm.txtHeat.Value		= tmpSearch.Heat
			ThisForm.txtLot.Value		= tmpSearch.Lot
			ThisForm.txtPO_Item.Value	= tmpSearch.PO_item
			ThisForm.txtMill.Value		= tmpSearch.Mill
			ThisForm.txtStkDate.Value		= tmpSearch.StkDate
			ThisForm.txtBrandName.Value		= tmpSearch.BrandName
			
			ThisForm.Grid1.Enabled = .T.
			ThisForm.Grid1.RecordSourceType = 1
			*ThisForm.SetSortOrder()
			ThisForm.Grid1.RecordSource = 'tmpSearch'
			ThisForm.Grid1.Enabled = .T.
			ThisForm.Grid1.Visible = .T.
			ThisForm.Grid1.Refresh()
		ENDIF
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		
		WAIT WINDOW ThisForm.nReturnKey NOWAIT
		
		ThisForm.Release
		
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		If Used('tmpSearch')
		*	ThisForm.SelectRecordDisplay("ON")
			ThisForm.nReturnKey = tmpSearch.ID_History
			
			ThisForm.txtAlloy.Value		= tmpSearch.Alloy
			ThisForm.txtForm.Value		= tmpSearch.Form
			ThisForm.txtCC.Value		= tmpSearch.CC
			ThisForm.txtCL.Value		= tmpSearch.CL
			ThisForm.txtSize.Value		= tmpSearch.Size
			ThisForm.txtCond.Value		= tmpSearch.Cond
			ThisForm.txtSpecs.Value		= tmpSearch.Specs
			ThisForm.txtHeat.Value		= tmpSearch.Heat
			ThisForm.txtLot.Value		= tmpSearch.Lot
			ThisForm.txtPO_Item.Value	= tmpSearch.PO_item
			ThisForm.txtMill.Value		= tmpSearch.Mill
			ThisForm.txtStkDate.Value		= tmpSearch.StkDate
			ThisForm.txtBrandName.Value		= tmpSearch.BrandName
		
		EndIF	
	ENDPROC

ENDDEFINE
