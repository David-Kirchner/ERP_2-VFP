	ADD OBJECT 'txtTotalWeight' AS textbox WITH ;
		BackStyle = 1, ;
		Height = 23, ;
		Left = 34, ;
		Name = "txtTotalWeight", ;
		Top = 238, ;
		Visible = .F., ;
		Width = 48
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE calctotalfilesize
		*ThisForm.CalcTotalFileSize() 
		
		SELECT QuoteAttach
		PRIVATE nCurrRec, nSizeTotal
		nCurrRec = RECNO('QuoteAttach')
			
		SUM FileSize TO nSizeTotal
			
		ThisForm.txtTotalWeight.Value = PrepareSQLnum(nSizeTotal,'FileSize',8,2)
		
		IF nCurrRec <= RECCOUNT('QuoteAttach')
			GOTO nCurrRec 
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		
		ThisForm.ShowGrid()
		
		ThisForm.CalcTotalFileSize() 
		
		SELECT QuoteAttach
		GO TOP
		
		
		
		
	ENDPROC

	PROCEDURE Load
		IF USED('QuoteAttach')
			USE IN QuoteAttach
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\QuoteAttach.DBF") &&Clean the file
			SELECT 0
			USE (SYS(5)+SYS(2003)+"\QuoteAttach.DBF") EXCL 
			IF USED('QuoteAttach')
		*		ZAP
				SELECT QuoteAttach
				*DELETE FROM QuoteAttach WHERE ALLTRIM(UNCFile)=""
				DELETE FROM QuoteAttach WHERE LEN(ALLTRIM(FileName)) = 0
				PACK
			ENDIF
		ELSE &&Create file
			SELECT 0
			CREATE TABLE (SYS(5)+SYS(2003)+"\QuoteAttach.DBF") FREE (UNCFile C(254), FileName C(254), FileSize N(8,2))
			
			USE (SYS(5)+SYS(2003)+"\QuoteAttach.DBF") EXCL 
		ENDIF
		
		IF USED('QuoteAttach')
			SELECT QuoteAttach
		*	INSERT INTO QuoteAttach (UNCFile) VALUES ("")
		ENDIF
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDeltaH, nDeltaW
		
		nDeltaH = This.Height - 260
		nDeltaW = This.Width - 344
		
		This.grdAttach.Width = 320 + nDeltaW
		This.grdAttach.Height = 200 + nDeltaH
	ENDPROC

	PROCEDURE showgrid
		*thisForm.ShowGrid
		
		
		*IF NOT USED('QuoteAttach')
		*	CREATE TABLE (SYS(5)+SYS(2003)+"\QuoteAttach.DBF") FREE (UNCFile C(254), FileName C(254), FileSize N(8,2) )
		*	USE (SYS(5)+SYS(2003)+"\QuoteAttach.DBF") EXCL 
		*ENDIF
		
		
		ThisForm.grdAttach.RecordSource = ""
		
		SELECT QuoteAttach
		*DELETE FROM QuoteAttach WHERE ALLTRIM(UNCFile)=""
		DELETE FROM QuoteAttach WHERE LEN(ALLTRIM(FileName)) = 0
		PACK
		
		IF RECCOUNT('QuoteAttach') = 0
		*	INSERT INTO QuoteAttach (UNCFile) VALUES ("")
		ENDIF
		
		ThisForm.grdAttach.RecordSource = "QuoteAttach"
		ThisForm.grdAttach.Column1.ControlSource = "QuoteAttach.Filename"
		*ThisForm.grdAttach.Column1.Text1.Alignment = 1
		ThisForm.grdAttach.Column2.ControlSource = "QuoteAttach.UNCFile"
		*ThisForm.grdAttach.Column2.Text1.Alignment = 1
		ThisForm.grdAttach.Column3.ControlSource = "QuoteAttach.FileSize"
		ThisForm.grdAttach.Refresh
		
		
	ENDPROC

	PROCEDURE cmdAdd.Click
		PRIVATE cFile
		cFile = GETFILE("","Get File","Attach",0,"Attach File to Email")
		
		*\\Turkey\CERTIFICATION.RAP\...TIF
		
		IF EMPTY(cFile)
			RETURN
		ENDIF
		
		cFile = ALLTRIM(cFile)
		IF FILE(cFile)
		
			PRIVATE cUNC, cFileName, nFileSize 
			PRIVATE nLastSlash, nAtLastSlash 
			nLastSlash = OCCURS("\",cFile)
			nAtLastSlash = AT("\",cFile,nLastSlash)
			nFileSize = 0
			IF nLastSlash = 0
				cFileName = cFile
				cUNC = ""
			ELSE
				cFileName = RIGHT(cFile,LEN(cFile)-nAtLastSlash)
				cUNC = LEFT(cFile,LEN(cFile)-LEN(cFileName))
			ENDIF
			
		*	nFileSize = PrepareSQLnum( FSEEK(FOPEN(cFile),0,2) / 1000000 ,'FileSize',8,2)
			*nMeg = nFileSize / 1000000
		
			INSERT INTO QuoteAttach (UNCFile, FileName, FileSize ) VALUES (cUNC, cFileName, nFileSize )
			
			ThisForm.CalcTotalFileSize() 
			
		ENDIF
		
		ThisForm.ShowGrid()
		
		
	ENDPROC

	PROCEDURE cmdAdd.OLEDragDrop
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord
		
		
		LOCAL cFile, afiles[ 1 ]
		 
		IF oDataObject.GETFORMAT( 15 )
		   oDataObject.GETDATA( 15, @afiles )
		   
		   FOR EACH cFile IN afiles
		      ** Do something with the file
		      
		        PRIVATE cUNC, cFileName, nFileSize 
				PRIVATE nLastSlash, nAtLastSlash 
				nLastSlash = OCCURS("\",cFile)
				nAtLastSlash = AT("\",cFile,nLastSlash)
				nFileSize = 0
				
				IF nLastSlash = 0
					cFileName = cFile
					cUNC = ""
				ELSE
					cFileName = RIGHT(cFile,LEN(cFile)-nAtLastSlash)
					cUNC = LEFT(cFile,LEN(cFile)-LEN(cFileName))
				ENDIF
				
				nFileSize = 0
				*nFileSize = PrepareSQLnum( FSEEK(FOPEN(cFile),0,2) / 1000000 ,'FileSize',8,2)
				*nMeg = nFileSize / 1000000
				
				SELECT QuoteAttach
				INSERT INTO QuoteAttach (UNCFile, FileName, FileSize ) VALUES (cUNC, cFileName, nFileSize )
				
				*This.Refresh
				ThisForm.grdAttach.Refresh
						
				ThisForm.CalcTotalFileSize() 
			NEXT
		ENDIF
	ENDPROC

	PROCEDURE cmdAdd.OLEDragOver
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord, nState
		IF oDataObject.GETFORMAT(15)
		   THIS.OLEDROPHASDATA = 1
		ENDIF
	ENDPROC

	PROCEDURE cmdRemove.Click
		
		ThisForm.ShowGrid()
		
		ThisForm.CalcTotalFileSize() 
	ENDPROC

	PROCEDURE cmdReturn.Click
		*SELECT QuoteAttach 
		*BROWSE
		
		ThisForm.Release
		
	ENDPROC

	PROCEDURE grdAttach.OLEDragDrop
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord
		
		LOCAL cFile, afiles[ 1 ]
		 
		IF oDataObject.GETFORMAT( 15 )
		   oDataObject.GETDATA( 15, @afiles )
		   
		   FOR EACH cFile IN afiles
		      ** Do something with the file
		      
		        PRIVATE cUNC, cFileName, nFileSize 
				PRIVATE nLastSlash, nAtLastSlash 
				nLastSlash = OCCURS("\",cFile)
				nAtLastSlash = AT("\",cFile,nLastSlash)
		
				IF nLastSlash = 0
					cFileName = cFile
					cUNC = ""
				ELSE
					cFileName = RIGHT(cFile,LEN(cFile)-nAtLastSlash)
					cUNC = LEFT(cFile,LEN(cFile)-LEN(cFileName))
				ENDIF
				
				nFileSize = 0
		*		nFileSize = PrepareSQLnum( FSEEK(FOPEN(cFile),0,2) / 1000000 ,'FileSize',8,2)
				*nMeg = nFileSize / 1000000
				
				SELECT QuoteAttach
				INSERT INTO QuoteAttach (UNCFile, FileName, FileSize ) VALUES (cUNC, cFileName, nFileSize )
				
				This.Refresh
						
				ThisForm.CalcTotalFileSize() 
			NEXT
		ENDIF
	ENDPROC

	PROCEDURE grdAttach.OLEDragOver
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord, nState
		
		
		IF oDataObject.GETFORMAT(15)
		   THIS.OLEDROPHASDATA = 1
		ENDIF
	ENDPROC

