	PROCEDURE checkscan		&& Check Scanned info.
		PARAMETERS pSO
		
		PRIVATE nNumber,cText,cItem 
		nNumber = 0
		cText = ''
		cItem = ''
		
		PRIVATE cScanStandardResults
		IF VARTYPE(pSO) = "C"
			
			cScanStandardResults = getScanStandard( pSO )
			*Proc_ERP
			
			DO CASE
			CASE LEFT(cScanStandardResults,20) = "Sales Order Number"
				nNumber = getScannedInt(cScanStandardResults)
				ThisForm.lblInstructions.Caption = "Scanned Sales Order Number"
				ThisForm.ScannedSO(nNumber)
				
			CASE LEFT(cScanStandardResults,20) = "Sales Order Item"
				cItem = getScannedItem(cScanStandardResults)
				ThisForm.lblInstructions.Caption = "Scanned Sales Order Item"
				ThisForm.ScannedSI(cItem)		
		
			CASE LEFT(cScanStandardResults,20) = "PurchaseOrder Number"
				nNumber = getScannedInt(cScanStandardResults)
				ThisForm.lblInstructions.Caption = "Scanned Purchase Order Number"
				ThisForm.ScannedPO(nNumber)
				
			CASE LEFT(cScanStandardResults,20) = "Purchase Order Item"
				cItem = getScannedItem(cScanStandardResults)
				ThisForm.lblInstructions.Caption = "Scanned Purchase Order Item"
				ThisForm.ScannedPI(cItem)		
			
			CASE LEFT(cScanStandardResults,20) = "Employee"
				cText = getScannedText(cScanStandardResults)
				ThisForm.lblInstructions.Caption = "Scanned Employee"
				ThisForm.ScannedEM(cText)
				
			CASE LEFT(cScanStandardResults,20) = "Process"
				cText = getScannedText(cScanStandardResults)
				ThisForm.lblInstructions.Caption = "Scanned Process"
				ThisForm.ScannedPR(cText)		
		
		*	CASE LEFT(cScanStandardResults,20) = "PackingSlip PU"
		*		nNumber = getScannedInt(cScanStandardResults)
		*		ThisForm.lblInstructions.Caption = "Scanned PackingSlip"
		*		ThisForm.ScannedPS(nNumber)
		*Name change, PUdate is never scanned but computed as gone from ReadyShipOut RSU
		
			CASE LEFT(cScanStandardResults,20) = "PackingSlip RSO"
				nNumber = getScannedInt(cScanStandardResults)
				*                                   123456789012345678901234567890
				ThisForm.lblInstructions.Caption = "Scanned PS RSO (Ready Ship Out)"
				ThisForm.ScannedPS(nNumber)
											
			OTHERWISE
				*Not positive this scan is for this procedure
		*		MESSAGEBOX("Did not find a scan standard.",0+16,"Not Programmed.")
				ThisForm.lblInstructions.Caption = "Keyboard Entry"
				*pSO = VAL(pSO)
			ENDCASE
		ENDIF
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS nPassIn
		
		IF VARTYPE(nPassIn) = "N"
			IF nPassIn = 1
				This.BorderStyle = 1
				This.WindowType = 1
			ENDIF
		ENDIF
		ThisForm.txtScan.Value = "*AA9999999999*"
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE scannedem
		PARAMETERS pText
		*ThisForm.ScannedEM(pText)
		
		PRIVATE cText
		
		IF VARTYPE(pText) = "C"
			cText = pText
		ELSE
			cText = ''
		ENDIF
		
		IF EMPTY(cText) 
			MESSAGEBOX("Need an Employee name",0+48,"No name")
			THISFORM.lblPast.CAPTION = "Not a good Employee name"
			ThisForm.lblInstructions.Caption = "Start Scan"
			RETURN
		ENDIF
		
		*Only choice for EM
		
		
		
				THISFORM.lblPast.CAPTION = "Employee Name "+ALLTRIM(cText)+""
		*	ENDIF
			
		*ENDIF
		ThisForm.lblInstructions.Caption = "Start Scan"
		
	ENDPROC

	PROCEDURE scannedpi
		PARAMETERS cItem 
		*ThisForm.ScannedPI(nSO)
		*PurchaseOrder Item
		
		
		*Only choice for PI is 
		
		
		
				THISFORM.lblPast.CAPTION = "Purchase Order Item "+ALLTRIM(cItem)+" Scan!"
		*	ENDIF
		*ENDIF
		ThisForm.lblInstructions.Caption = "Start Scan"
	ENDPROC

	PROCEDURE scannedpo
		PARAMETERS pPO
		*ThisForm.ScannedPO(nPO)
		*Purchase Order
		
		IF VARTYPE(pPO) != "N"
			nPO = 0
		ELSE
			nPO = pPO
		ENDIF
		
		IF nSO < 100000
			MESSAGEBOX("Need a Purchase Order Number",0+48,"Number too small")
			THISFORM.lblPast.CAPTION = "Not a good PO#"
			ThisForm.lblInstructions.Caption = "Start Scan"
			RETURN
		ENDIF
		
		*Only choice for PO
		
		
		
				THISFORM.lblPast.CAPTION = "Purchase Order "+ALLTRIM(STR(nPO))+" Scan!"
		*	ENDIF
		*ENDIF
		ThisForm.lblInstructions.Caption = "Start Scan"
	ENDPROC

	PROCEDURE scannedpr
		PARAMETERS cItem 
		*ThisForm.ScannedPR(cItem)
		
		
		PRIVATE cText
		
