	ENDPROC

	PROCEDURE scannedps
		PARAMETERS pPS
		*ThisForm.ScannedPS(nPS)
		
		PRIVATE nPS
		IF VARTYPE(pPS) != "N"
			nPS= 0
		ELSE
			nPS = pPS
		ENDIF
		
		*!*	PRIVATE nMinNum, nMaxNum
		*!*	nMinNum = getScannedMin('PS',ThisForm.nConnHandle)  --need to create function first
		*!*	nMaxNum = getScannedMax('PS',ThisForm.nConnHandle)
		
		*!*	IF nPS < nMinNum
		*!*		MESSAGEBOX("Need a Packing Slip Number",0+48,"Number too small")
		*!*		THISFORM.lblPast.CAPTION = "Not a good PS#"
		*!*		ThisForm.lblInstructions.Caption = "Start Scan"
		*!*		RETURN
		*!*	ENDIF
		
		*Only choice for PS is mark PS RSO_Date Ready to Ship Out *PickUpDate -old, now
		
		
		PRIVATE nCount
		nCount = Count_PackingSliinPackingSlip_No( nPS, ThisForm.nConnHandle)
		
		
		
		IF nCount = 0
			MESSAGEBOX( "Did not Find the PS:"+ALLTRIM(STR(nPS)),0+48,"Not Found!")
			THISFORM.lblPast.CAPTION = "PS "+ALLTRIM(STR(nPS))+" not found!"
		
		ELSE
		
			IF PackingSlipPickUp(nPS, ThisForm.nConnHandle )
		*				TrackMess( "PackingSlip#"+ALLTRIM(STR(nPackingSlipNo))+" was updated!"+CHR(13)+"Old date was '"+TTOC(dPickUpDate)+"'")
				THISFORM.lblPast.CAPTION = "PS "+ALLTRIM(STR(nPS))+"PS Ready to Ship Out 'RSO'!"
			ELSE
				MESSAGEBOX("Error updating PackingSlip_No table",0,"Did not save!")
				THISFORM.lblPast.CAPTION = "PS "+ALLTRIM(STR(nPS))+" Error!"
			ENDIF
		
		
		ENDIF
		ThisForm.lblInstructions.Caption = "Start Scan"
	ENDPROC

	PROCEDURE scannedsi
		PARAMETERS cItem 
		*ThisForm.ScannedSI(nSO)
		
		
		
		*Only choice for SI is 
		
		
		
				THISFORM.lblPast.CAPTION = "Sales Order Item "+ALLTRIM(cItem)+" Scan!"
		*	ENDIF
		*!*	cSQL = "INSERT INTO dbo.Sales_Status (SOitem,SalesNum,[What],[Comment]) VALUES ("
		*!*	cSQL = cSQL +" '  -  ',"+STR(nSO)+",'SO Received','Shop marked as Received' )"
		
		*!*	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		*!*	ENDIF
		*ENDIF
		ThisForm.lblInstructions.Caption = "Start Scan"
	ENDPROC

	PROCEDURE scannedso
		PARAMETERS pSO
		*ThisForm.ScannedSO(nSO)
		
		PRIVATE nSO
		IF VARTYPE(pSO) != "N"
			nSO = 0
		ELSE
			nSO = pSO
		ENDIF
		
		IF nSO < 100000
			MESSAGEBOX("Need a Sales Order Number",0+48,"Number too small")
			THISFORM.lblPast.CAPTION = "Not a good SO#"
			ThisForm.lblInstructions.Caption = "Start Scan"
			RETURN
		ENDIF
		
		*Only choice for SO is Mark as Recived!
		
		
		PRIVATE nCountSO
		nCountSO = 0
		
		IF nSO > 1
			nCountSO = Count_SOinSales_No( nSO, ThisForm.nConnHandle)
		ENDIF
		
		
		IF nCountSO = 0
			MESSAGEBOX( "Did not Find the SO:"+ALLTRIM(STR(nSO)),0+48,"Not Found!")
			THISFORM.lblPast.CAPTION = "SO "+ALLTRIM(STR(nSO))+" not found!"
		
		ELSE
			
			THISFORM.lblPast.CAPTION = "Sales Order "+ALLTRIM(cItem)+" Scan!"
					
			PRIVATE nCountSOr
			*Check to See if Already Marked as ShopRecv
			nCountSOr = Count_SOinSales_No(nSO, ThisForm.nConnHandle,'ShopRecv')
		
			PRIVATE nAmendmentinSales_No
			nAmendmentinSales_No = Get_Amendment_Sales_No( nSO, ThisForm.nConnHandle )
		
			IF nCountSOr = 0
				*Found SalesNo, not marked.
				*Get SO info to Display
		
				cSQL = "SELECT Company, SalesP, SaleDate FROM dbo.AllQuotes WHERE SalesNum = "+STR(nSO)
		
				IF USED("AllQuotesSO")
					SELECT AllQuotesSO
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AllQuotesSO')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL , 'AllQuotesSO')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'AllQuotesSO')
				ENDIF
		
				PRIVATE cCompany, cSalesP, dSaleDate
				cCompany = ""
				cSalesP = ""
				dSaleDate = CTOD("  /  /  ")
		
				IF USED("AllQuotesSO")
					IF VARTYPE(AllQuotesSO.Company) = "C"
						cCompany = ALLTRIM(AllQuotesSO.Company)
					ENDIF
					IF VARTYPE(AllQuotesSO.SalesP) = "C"
						cSalesP = ALLTRIM(AllQuotesSO.SalesP)
					ENDIF
					IF VARTYPE(AllQuotesSO.SaleDate) = "D" OR VARTYPE(AllQuotesSO.SaleDate) = "T"
						dSaleDate = AllQuotesSO.SaleDate
					ENDIF
		
					USE IN AllQuotesSO
				ENDIF
		
				PRIVATE cText
				cText = "Are you sure you want to mark as Receive?"+CHR(13)
				cText = cText + CHR(13) +   "            SO:"+ALLTRIM(STR(nSO))
				IF NOT EMPTY(cCompany)
					cText = cText + CHR(13)+"    Company:"+cCompany
				ENDIF
				IF NOT EMPTY(cSalesP)
					cText = cText + CHR(13)+"       SalesP:"+cSalesP
				ENDIF
				IF NOT EMPTY(dSaleDate)
					cText = cText + CHR(13)+"   SaleDate:"+DTOC(dSaleDate )
				ENDIF
				IF nAmendmentinSales_No > 0
					cText = cText + CHR(13)+CHR(13)+"SO Revision:"+ALLTRIM(STR(nAmendmentinSales_No ))
				ELSE
					cText = cText + CHR(13)+CHR(13)+"SO Revision: 0"
				ENDIF
		
				CLEAR TYPEAHEAD
				IF MESSAGEBOX(cText,4+32,"Found unmarked SO")=6 &&Yes
					*Mark SO
		
					cSQL = "UPDATE dbo.Sales_No SET ShopRecv = 1 WHERE SalesNum = "+STR(nSO)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
					ELSE
						PRIVATE nAmendment
						nAmendment = Get_Amendment_Sales_No( nSO, ThisForm.nConnHandle)
						Track_Sales_No_Chng( "Scan ShopRecv", nSO, .T., nAmendment )
					ENDIF
		
					cSQL = "INSERT INTO dbo.Sales_Status (SOitem,SalesNum,[What],[Comment]) VALUES ("
					cSQL = cSQL +" '  -  ',"+STR(nSO)+",'SO Received','Shop marked as Received' )"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
					ENDIF
					
		
					THISFORM.txtScan.VALUE = 0
					THISFORM.lblPast.CAPTION = "Marked SO "+ALLTRIM(STR(nSO))+" as Received by shop!"
					
		
					TrackMess("Marked SO "+ALLTRIM(STR(nSO))+", Amendment "+ALLTRIM(STR(nAmendmentinSales_No))+" as Received by Shop.")
		
				ENDIF
			
				
			ELSE
				CLEAR TYPEAHEAD
				*Found SalesNo and already marked!
				MESSAGEBOX("  Found SO:"+ALLTRIM(STR(nSO))+CHR(13)+"Amendment:"+ALLTRIM(STR(nAmendmentinSales_No))+CHR(13)+"But it is already marked as Received by shop.",0+64,"Already marked")
				THISFORM.lblPast.CAPTION = "SO "+ALLTRIM(STR(nSO))+" was already received!"
			ENDIF
		ENDIF
		ThisForm.lblInstructions.Caption = "Start Scan"
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
	ENDPROC

	PROCEDURE cmbScanType.Init
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		This.ColumnCount = 2
		This.NumberOfElements = 8
		This.BoundColumn = 1
		This.ColumnWidths = "20,120"
		
		
		this.addListitem('  ',1,1)
		this.addListitem(' ',1,2)
		this.addListitem('SO',2,1)
		this.addListitem('Sales Order Number',2,2)
		this.addListitem('SI',3,1)
		this.addListitem('Sales Order Item',3,2)
		this.addListitem('PO',4,1)
		this.addListitem('PurchaseOrder Number',4,2)
		this.addListitem('PI',5,1)
		this.addListitem('Purchase Order Item',5,2)
		this.addListitem('EM',6,1)
		this.addListitem('Employee',6,2)
		this.addListitem('PR',7,1)
		this.addListitem('Process',7,2)
		this.addListitem('PS',8,1)
		this.addListitem('Packing Slip Pickup',8,2)
		
		
		This.Value = "  "
		
	ENDPROC

	PROCEDURE cmdEnter.Click
		PRIVATE vText, cScanType
		vText = ThisForm.txtScan.Value
		cScanType = ThisForm.cmbScanType.Value
		
		IF VARTYPE(vText) = "U"
			MESSAGEBOX("No text to process",0+48,"Retry")
			ThisForm.lblPast.Caption = "No text."
			RETURN
		ENDIF
		
		
		IF VARTYPE(cScanType) = "U"
			MESSAGEBOX("No text to process",0+48,"Retry")
			ThisForm.lblPast.Caption = "No Scan Type."
			RETURN
		ENDIF
		
		IF (VARTYPE(vText) = "C" OR VARTYPE(vText) = "N") 
			IF VARTYPE(cScanType) = "C"
				IF EMPTY(vText)
					MESSAGEBOX("Empty Scan.",0+48,"Retry")
					ThisForm.lblPast.Caption = "No text."
					RETURN
				ENDIF
				
				IF EMPTY(cScanType)
					MESSAGEBOX("Empty Scan type.",0+48,"Retry")
					ThisForm.lblPast.Caption = "No Scan type."
					RETURN
				ENDIF
				
				
				ThisForm.CheckScan(cScanType+vText)
				
				ThisForm.lblInstructions.Caption = "Start Scan"
				
			ELSE
				MESSAGEBOX("Choose a scan type.",0+16,"No Scan type.")
				ThisForm.lblPast.Caption = "No scan type."
			ENDIF		
		ELSE
			MESSAGEBOX("Not a programmed scan type: "+VARTYPE(vText),0+16,"Bad text")
			ThisForm.lblPast.Caption = "Not a programmed scan type: "+VARTYPE(vText)
		ENDIF
		
		
		ThisForm.txtScan.SetFocus
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		IF ThisForm.BorderStyle = 0
			QUIT
		ENDIF
	ENDPROC

	PROCEDURE txtScan.Valid
		PRIVATE cText
		cText = This.Value
		
		IF NOT EMPTY(cText)
			IF cText = "*AA9999999999*"
				This.Value = ''
			ELSE
				ThisForm.CheckScan(cText)
				*ThisForm.cmdReceived.Click
				IF ThisForm.lblInstructions.Caption = "Keyboard Entry"
					*Do not blank this txt line!
				ELSE
					This.Value = ' '
				ENDIF
		*		RETURN 0
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE
