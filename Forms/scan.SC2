	ADD OBJECT 'txtScan' AS textbox WITH ;
		Alignment = 3, ;
		Height = 23, ;
		Left = 5, ;
		MaxLength = 14, ;
		Name = "txtScan", ;
		SelectOnEntry = .T., ;
