ENDDEFINE

DEFINE CLASS sources AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtAlloy" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label4" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdOK" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdReturn" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkAutoAlloy" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		BackColor = 255,128,64
		Caption = "Sources"
		DoCreate = .T.
		Height = 112
		Name = "SOURCES"
		nconnhandle = 0
		Width = 217
	*</PropValue>

	ADD OBJECT 'chkAutoAlloy' AS checkbox WITH ;
		Alignment = 0, ;
		BackStyle = 0, ;
		Caption = "Auto Alloy", ;
		ControlSource = "m.AutoCheck", ;
		Height = 17, ;
		Left = 122, ;
		Name = "chkAutoAlloy", ;
		Top = 84, ;
		Value = .T., ;
		Width = 80
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'cmdOK' AS commandbutton WITH ;
		Caption = "Search", ;
		Default = .T., ;
		Height = 27, ;
		Left = 120, ;
		Name = "cmdOK", ;
		TerminateRead = .T., ;
		Top = 12, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdReturn' AS commandbutton WITH ;
		Caption = "Exit", ;
		Height = 27, ;
		Left = 120, ;
		Name = "cmdReturn", ;
		TerminateRead = .T., ;
		Top = 48, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		BackColor = 255,128,64, ;
		Caption = "Enter the alloy:", ;
		FontBold = .T., ;
		Height = 13, ;
		Left = 12, ;
		Name = "Label1", ;
		Top = 11, ;
		Width = 84
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label3' AS label WITH ;
		BackColor = 255,128,64, ;
		Caption = "UNS X999999", ;
		Height = 17, ;
		Left = 14, ;
		Name = "Label3", ;
		Top = 60, ;
		Width = 96
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label4' AS label WITH ;
		BackColor = 255,128,64, ;
		Caption = "SPEC 9999", ;
		Height = 17, ;
		Left = 15, ;
		Name = "Label4", ;
		Top = 78, ;
		Width = 96
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'txtAlloy' AS textbox WITH ;
		Format = "K", ;
		Height = 23, ;
		Left = 12, ;
		Name = "txtAlloy", ;
		Top = 31, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS m.ia	
		IF TYPE('m.ia') = "L"
			ThisForm.txtAlloy.VALUE = SPACE(12)
		ELSE
			ThisForm.txtAlloy.VALUE = LEFT(m.ia+SPACE(12),12)
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
	ENDPROC

	PROCEDURE cmdOK.Click
		PRIVATE pcurdbf
		pcurdbf = ALIAS()
		
		PRIVATE cAlloy, cUNS
		cAlloy = ALLTRIM(ThisForm.txtAlloy.VALUE)
		
		PRIVATE lAutoCheck
		lAutoCheck = ThisForm.chkAutoAlloy.Value
		
		IF lAutoCheck
			IF UPPER(LEFT(ALLTRIM(cAlloy),3)) = "UNS"
				m.IAA = ALLTRIM(cAlloy)
				m.SUNS = UPPER(RIGHT(M.IAA,LEN(M.IAA)-4))
		
				*SEEK M.SUNS ORDER TAG UNS IN Sources
			cSQL = "SELECT Alloy FROM dbo.Sources WHERE UNS = '"+cUNS+"'"
				
				IF USED("UnsSources")
					SELECT UnsSources
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'UnsSources')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'UnsSources')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "UnsSources")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "UnsSources")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'UnsSources')
				ENDIF
		
				IF USED('UnsSources')
					IF VARTYPE(UnsSources.Alloy) = "C"
						cAlloy = UnsSources.Alloy
					ELSE
						WAIT WINDOW 'UNS not found!!!!!!' NOWAIT
					ENDIF
					USE IN UnsSources
				ELSE
					WAIT WINDOW 'UNS not found!!!!!!' NOWAIT
				ENDIF
				
			ENDIF
		
			IF UPPER(LEFT(ALLTRIM(cAlloy),4)) = "SPEC"
				m.IAA = UPPER(ALLTRIM(cAlloy))
				cUNS = RIGHT(M.IAA,LEN(M.IAA)-5)
		
				*LOCATE FOR cUNS$SPEC
				cSQL = "SELECT Alloy FROM dbo.Sources WHERE SPEC LIKE '%"+cUNS+"%'"
				
				IF USED("SpecSources")
					SELECT SpecSources
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SpecSources')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SpecSources')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SpecSources")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SpecSources")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'SpecSources')
				ENDIF
		
				IF USED('SpecSources')
					IF VARTYPE(SpecSources.Alloy) = "C"
						cAlloy = SpecSources.Alloy
					ELSE
						WAIT WINDOW 'SPECIFICATION not found!!!!!!' NOWAIT
					ENDIF
				
					USE IN SpecSources
				ELSE
					WAIT WINDOW 'SPECIFICATION not found!!!!!!' NOWAIT
				ENDIF
			ENDIF
		ENDIF
		
		
		cSQL = "SELECT Sources.Company,Alloy,Alloy_AKA,UNS,Spec,f10,f20,f30,f40,f60,f65,f70,f75,Stk,MK,Sources.Notes,Sourceph.Company,Phone,Fax,Person,Email "
		cSQL = cSQL + " FROM dbo.sources, dbo.sourceph "
		cSQL = cSQL + " WHERE Sources.ID = Sourceph.ID "
		cSQL = cSQL + " AND Sources.Alloy = '"+cAlloy+"'"
		cSQL = cSQL + " ORDER BY Sources.alloy, Sources.company"
		
		IF USED("vSources")
			SELECT vSources
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'vSources')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'vSources')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "vSources")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "vSources")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'vSources')
		ENDIF
		
		IF !USED('vSources')
			=MESSAGEBOX('vSources data not found.',16,"No Data")
		*	WAIT WINDOW 'Returning to program' NOWAIT
			RETURN
		ENDIF
		IF VARTYPE(vSources.Alloy) != "C"
			=MESSAGEBOX('vSources data not found.',16,"No Data")
		*	WAIT WINDOW 'Returning to program' NOWAIT
			RETURN
		ENDIF
		
		*SET ORDER TO TAG Alloy
		SELECT vSources
		Activate SCREEN
		MODIFY MEMO notes NOWAIT
		BROW LAST NOEDIT NOAPP NODELETE TITLE 'Sources' 
		*BROW NORMAL FOR Alloy=M.IA TIMEOUT 240  &&Alloy is the clean field
		*PREF SRC FIELD COMPANY,ALLOY,ALLOY_AKA:H="ALY#",F10:1:H="B",F20:1:H="W",F30:1:H="E",F40:H="P/S",F60:1:H="T",F65:2:H="Pp",F70:3:H="Fit",F75:3:H="Fst",NOTES:4,STK,MK,UNS,SPEC,Q.COMPANY,Q.PHONE,Q.FAX,Q.PERSON FOR Alloy=M.IA TIMEOUT 240
		
		*Q.COMPANY,Q.PHONE,Q.FAX,Q.PERSON
		
		IF USED('vSources')
			USE IN vSources
		ENDIF
		
		IF NOT EMPTY(pcurdbf) AND USED(pcurdbf)
			SELECT (pcurdbf)
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE txtAlloy.Valid
		
		PRIVATE lAutoCheck
		lAutoCheck = ThisForm.chkAutoAlloy.Value
		
		IF lAutoCheck
		
			PRIVATE cAlloy, pLoop
			cAlloy = ALLTRIM(This.Value)
			pLoop = .F.
		
			IF USED('tmpALLOYS')
				USE IN tmpALLOYS
			ENDIF
			
			cSQL = "SELECT Alloy FROM dbo.Alloys WHERE ALLOYS = '"+cAlloy+"'"
			*SEEK UPPER(pcuralloy) ORDER TAG UPPAlloys
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpALLOYS')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL , 'tmpALLOYS')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloys")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloys")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpALLOYS')
			ENDIF
		
			IF USED('tmpALLOYS')
				IF VARTYPE(tmpALLOYS.Alloy) = "C"
					this.VALUE = tmpALLOYS.alloy
					this.refresh
				ELSE
					=MESSAGEBOX('tmpALLOYS data not found.',16,"No Data")
					RETURN
				ENDIF
			ELSE
				=MESSAGEBOX('tmpALLOYS data not found.',16,"No Data")
				RETURN
			ENDIF
		
		ENDIF
		
	ENDPROC

ENDDEFINE
