	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisForm.Load_HardWood()
		
	ENDPROC

	PROCEDURE load_hardwood
		*ThisForm.LoadHardwood()
		
		PRIVATE cSQL,nSQLEXEC 
		
		IF USED('HardWood')
			SELECT HardWood
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT [ID],[country]"
		cSQL = cSQL + " ,[abv]"
		cSQL = cSQL + " ,[summary]"
		cSQL = cSQL + " ,[webpage]"
		cSQL = cSQL + " ,[printout]"
		cSQL = cSQL + " ,[inactive]"
		cSQL = cSQL + " FROM [dbo].[hardwood] WITH(NOLOCK)"
		  		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'HardWood')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'HardWood')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "HardWood")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "HardWood")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'HardWood')
		ENDIF
		
		SELECT HardWood
		INDEX ON Country TAG Country
		*INDEX ON ABV TAG ABV
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETERS pWhat
		
		IF VARTYPE( pWhat ) != 'C'
			pWhat = ''
		ENDIF
		
		IF EMPTY(pWhat)
			RETURN .F.
		ENDIF
		
		*!*	[country] [char](15) NOT NULL,
		*!*	[abv] [char](2) NOT NULL,
		*!*	[summary] [varchar](max) NOT NULL,
		*!*	[webpage] [char](250) NOT NULL,
		*!*	[printout] [varchar](max) NOT NULL,
		*!*	[inactive] [bit] NOT NULL
		
		PRIVATE nID,cCountry,cABV,cSummary,cWebpage,cPrintout,lInactive
		nID			= PrepareSQLnum(ThisForm.ID.Value,'ID',-3)
		cCountry	= PrepareSQLtxt(ThisForm.Country1.Value,'Country',15)
		cABV		= PrepareSQLtxt(ThisForm.ABV.Value,'ABV',2)
		cSummary	= PrepareSQLtxt(ThisForm.Summary1.Value,'Summary',-1)
		cWebpage	= PrepareSQLtxt(ThisForm.WebPage1.Value,'WebPage',250)
		cPrintout	= PrepareSQLtxt(ThisForm.PrintOut1.Value,'PrintOut',-1)
		lInactive	= PrepareSQLchk(ThisForm.Inactive1.Value,'Inactive')
		
		IF USED('Hardwood')
			USE IN Hardwood
		ENDIF
			
		IF UPPER(pWhat) = "ADD"
			cSQL = "INSERT INTO dbo.hardwood("
			cSQL = cSQL + "Country,ABV,Summary,Webpage,Printout,inactive"
			cSQL = cSQL + ") VALUES ("
			cSQL = cSQL + " '"+cCountry+"'"
			cSQL = cSQL + ",'"+cABV+"'"
			cSQL = cSQL + ",'"+cSummary+"'"
			cSQL = cSQL + ",'"+cWebpage+"'"
			cSQL = cSQL + ",'"+cPrintout+"'"
			cSQL = cSQL + ","+IIF(lInactive,'1','0')+""
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC )
			ENDIF
			
			SELECT 0
			*Get ID
			cSQL = "SELECT ID FROM dbo.hardwood WHERE "
			cSQL = cSQL + " Country='"+cCountry+"'"
			cSQL = cSQL + " AND ABV='"+cABV+"'"
			cSQL = cSQL + " AND Summary='"+cSummary+"'"
			cSQL = cSQL + " AND Webpage='"+cWebpage+"'"
			cSQL = cSQL + " AND Printout='"+cPrintout+"'"
			cSQL = cSQL + " AND inactive="+IIF(lInactive,'1','0')+""
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpHardwoodID' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpHardwoodID' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpHardwoodID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpHardwoodID")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpHardwoodID' )
			ENDIF
			
			IF USED('tmpHardwoodID')
				IF VARTYPE(tmpHardwoodID.ID) = "N"
					ThisForm.ID.Value = tmpHardwoodID.ID
				ELSE
					ThisForm.ID.Value = 0
				ENDIF
				USE IN tmpHardwoodID
			ELSE
				ThisForm.ID.Value = 0
			ENDIF
			
		ENDIF
		IF UPPER(pWhat) = "SAVE"
			IF nID < 1
				MESSAGEBOX("No Control ID to Update to!",0+16,"Cannot Update")
				RETURN
			ENDIF
			
			cSQL = "UPDATE dbo.hardwood SET"
			cSQL = cSQL + " Country='"+cCountry+"'"
			cSQL = cSQL + ",ABV='"+cABV+"'"
			cSQL = cSQL + ",Summary='"+cSummary+"'"
			cSQL = cSQL + ",Webpage='"+cWebpage+"'"
			cSQL = cSQL + ",Printout='"+cPrintout+"'"
			cSQL = cSQL + ",inactive="+IIF(lInactive,'1','0')+""
			cSQL = cSQL + " WHERE ID = "+STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle ,nSQLEXEC )
			ENDIF	
			
		ENDIF
		
		*Refresh table
		cSQL = "SELECT ID,Country,ABV,Summary,Webpage,Printout,inactive "
		cSQL = cSQL + " FROM dbo.Hardwood "
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Hardwood' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Hardwood' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Hardwood")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Hardwood")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Hardwood')
		ENDIF
		
		SELECT HardWood
		INDEX ON Country TAG Country
		
	ENDPROC

	PROCEDURE Unload
		IF USED('HardWood')
			USE IN HardWood
		ENDIF
		
		SQLDISCONNECT( ThisForm.nConnHandle )
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdAdd.Click
		IF THIS.Caption = "\<Save"
			ThisForm.SaveAdd("Save")
		
			THIS.Parent.EditMode = !THIS.Parent.EditMode
			THIS.Parent.AddMode = .F.
			THISFORM.LockScreen = .T.
			THIS.Parent.ButtonRefresh()
			THIS.Parent.NavRefresh()
			THISFORM.LockScreen = .F.
		ELSE
			*Add
			*Data will be cloned!
			ThisForm.ID.Value = 0
			*ThisForm.SaveAdd("Add")
			THIS.Parent.EditMode = !THIS.Parent.EditMode
			THIS.Parent.AddMode = .F.
			THISFORM.LockScreen = .T.
			THIS.Parent.ButtonRefresh()
			THIS.Parent.NavRefresh()
			THISFORM.LockScreen = .F.
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdDelete.Click
		#DEFINE MSGBOX_YES		6
		#DEFINE C_MSGBOX1		36
		C_DELETE_LOC = "Do you want to delete this record?"
		C_DELETE_LOC2 = "Remove work?"
		#DEFINE C_NOLOCK_LOC	"Record could not be deleted because it is being used by someone else."
		
		* Note: Cascading deletes should be handled via RI triggers in DBC!
		IF EMPTY(ALIAS())
			RETURN
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL, nID
		IF ThisForm.CloneMode
			C_DELETE_LOC = "Are you sure you want to remove this record?"
		ENDIF
		PRIVATE cCountry
		IF MESSAGEBOX(C_DELETE_LOC,C_MSGBOX1,C_DELETE_LOC2 ) = MSGBOX_YES
			*DELETE
		
			*See if a filter was used to refilter.
			PRIVATE m.cGetExpr
			m.cGetExpr = ""
			cGetExpr = SET('FILTER')
			
			nID = Hardwood.ID
		
			IF EMPTY(nID)
				MESSAGEBOX("No ID!",0+16,"Cannot Delete")
				RETURN
			ENDIF
		
			IF USED('HardWood')
				USE IN HardWood
			ENDIF
			
			cSQL = "DELETE FROM dbo.HardWood WHERE ID = "+ STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle ,nSQLEXEC )
			ENDIF	
			
			cSQL = "SELECT * "
			cSQL = cSQL + " FROM dbo.HardWood "
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'HardWood' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'HardWood' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Hardwood")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Hardwood")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'HardWood')
			ENDIF
			
			IF !EMPTY(m.cGetExpr)
				SET FILTER TO &cGetExpr
				LOCATE
				IF EOF() &&Last of Filter!
					SET FILTER TO
				ENDIF
			ENDIF
		
		
			SELECT HardWood
			INDEX ON Country TAG Country
			
			THIS.Parent.ButtonRefresh()
			THIS.Parent.NavRefresh()
		ENDIF
		
		IF THISFORM.ShowWindow = 2 
			Activate Window (THISFORM.Name)
		ENDIF
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdEdit.Click
		IF THIS.Caption = "\<Edit"
				
			** Editing record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
					
			THIS.Parent.EditMode = !THIS.Parent.EditMode
			THIS.Parent.AddMode = .F.
			THISFORM.LockScreen = .T.
			THIS.Parent.ButtonRefresh()
			THIS.Parent.NavRefresh()
			THISFORM.LockScreen = .F.
		
		ELSE
			*Revert
				** Reverting record
			IF THIS.Parent.EditMode
				* Go back to original place
				SELECT (THIS.Parent.OldAlias)
				IF RECCOUNT() < THIS.Parent.OldRec	&&added record at EOF()
					GO TOP
				ELSE
					GO THIS.Parent.OldRec
				ENDIF
				
				THIS.Parent.EditMode = !THIS.Parent.EditMode
				THIS.Parent.AddMode = .F.
				THISFORM.LockScreen = .T.
				THIS.Parent.ButtonRefresh()
				THIS.Parent.NavRefresh()
				THISFORM.LockScreen = .F.
				
			ELSE
				THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
				THIS.Parent.OldRec = RECNO()	&&save record in case reverting
			ENDIF
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdPrint.Click
		SELECT HardWood
		
		PRIVATE cCountry
		cCountry = HardWood.Country
		
		IF NOT EMPTY(cCountry)
			ThisForm.Visible = .F.
			REPORT FORM \Reports\HardWood FOR Country = cCountry Preview
			ThisForm.Visible = .T.
		ENDIF
		
		
	ENDPROC

	PROCEDURE LBLWEBPAGE1.Click
		PRIVATE cText
		
		cText = ThisForm.WEBPAGE1.Value
		
		PRIVATE loHyperlink 
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(cText)
		RELEASE loHyperlink 
	ENDPROC

ENDDEFINE
