DEFINE CLASS frmordertasks AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lstSource" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lstSelected" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAdd" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAddAll" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdRemove" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdRemoveAll" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Combo1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSave" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAbort" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: load_tasks
		*m: selectall
		*p: candropicon
		*p: dragthreshold
		*p: mousex
		*p: mousey
		*p: nconnhandle
		*p: nodropicon
	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth.ico
		candropicon = DragMove.cur
		Caption = "Order tasks"
		DoCreate = .T.
		dragthreshold = 0
		Height = 345
		Left = 0
		mousex = 0
		mousey = 0
		Name = "frmOrderTasks"
		nconnhandle = 0
		nodropicon = ''
		Top = 0
		Width = 581
	*</PropValue>

	ADD OBJECT 'cmdAbort' AS commandbutton WITH ;
		Caption = "Abort", ;
		Height = 27, ;
		Left = 240, ;
		Name = "cmdAbort", ;
		Top = 276, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdAdd' AS commandbutton WITH ;
		Caption = ">", ;
		Height = 27, ;
		Left = 188, ;
		Name = "cmdAdd", ;
		Top = 80, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdAddAll' AS commandbutton WITH ;
		Caption = ">>", ;
		Height = 27, ;
		Left = 188, ;
		Name = "cmdAddAll", ;
		Top = 128, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdRemove' AS commandbutton WITH ;
		Caption = "<", ;
		Height = 27, ;
		Left = 192, ;
		Name = "cmdRemove", ;
		Top = 180, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdRemoveAll' AS commandbutton WITH ;
		Caption = "<<", ;
		Height = 27, ;
		Left = 188, ;
		Name = "cmdRemoveAll", ;
		Top = 224, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSave' AS commandbutton WITH ;
		Caption = "Save / Done", ;
		Height = 27, ;
		Left = 372, ;
		Name = "cmdSave", ;
		Top = 276, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Combo1' AS combobox WITH ;
		Height = 24, ;
		Left = 36, ;
		Name = "Combo1", ;
		Top = 24, ;
		Width = 100
		*< END OBJECT: BaseClass="combobox" />

	ADD OBJECT 'Label1' AS label WITH ;
		Caption = "Tasks", ;
		Height = 17, ;
		Left = 31, ;
		Name = "Label1", ;
		Top = 56, ;
		Width = 40
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label2' AS label WITH ;
		Caption = "Selected", ;
		Height = 17, ;
		Left = 324, ;
		Name = "Label2", ;
		Top = 60, ;
		Visible = .F., ;
		Width = 52
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lstSelected' AS listbox WITH ;
		Height = 170, ;
		Left = 308, ;
		Name = "lstSelected", ;
		Top = 80, ;
		Width = 100
		*< END OBJECT: BaseClass="listbox" />

	ADD OBJECT 'lstSource' AS listbox WITH ;
		Height = 170, ;
		Left = 32, ;
		Name = "lstSource", ;
		Top = 80, ;
		Width = 100
		*< END OBJECT: BaseClass="listbox" />
	
	PROCEDURE Init
		*PARAMETER pAlloy,pForm,pCC,pThck
		*DO FORM Forms\OrderTasks WITH 
		
		
		ThisForm.CanDropIcon = ("dragmove.cur")
		*ThisForm.CanDropIcon = ("GRAPHICS\dragmove.cur")
		*ThisForm.CanDropIcon = ("\GRAPHICS\dragmove.cur")
		ThisForm.NoDropIcon = ("nodrop01.cur")
		*ThisForm.NoDropIcon = ("GRAPHICS\nodrop01.cur")
		*ThisForm.NoDropIcon = ("\GRAPHICS\nodrop01.cur")
		ThisForm.lstSource.DragIcon = ThisForm.CanDropIcon
		ThisForm.lstSelected.DragIcon = ThisForm.CanDropIcon
		
		
		Thisform.Dragthreshold = IIF( Thisform.Width > ThisForm.Height, Thisform.Width, ThisForm.Height )
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE load_tasks
		PARAMETERS pWhat
		*ThisForm.Load_Tasks()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		
		IF UPPER(pWhat) ="REFRESH"
			
			IF USED('tmpTasks')
				USE IN tmpTasks
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('tmpTasks')
			SELECT 0
			
			cSQL = "SELECT * "
		    cSQL = cSQL+" FROM dbo.NR_OT_Job "
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpTasks')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpTasks')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpTasks' )
			ENDIF
		
		ENDIF
		
		IF USED('tmpTasks')
			SELECT tmpTasks
		
		*	INDEX ON alloy+form+CC TAG 'alloyformC' OF PriceTable 
		*	TRY	
		*		SET ORDER TO TAG 'PriceT' OF PriceTable 
		*	CATCH
		*		MESSAGEBOX("Error with Index",0+16,"Error")
		*	ENDTRY
			
			GO TOP
			IF UPPER(pWhat) ="REFRESH"
			
			ENDIF
		
		ELSE
			MESSAGEBOX('Failed to load Tasks',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

	PROCEDURE Resize
		Thisform.Dragthreshold = IIF( Thisform.Width > ThisForm.Height, Thisform.Width, ThisForm.Height )
	ENDPROC

	PROCEDURE selectall
		LPARAMETERS oList
		LOCAL lnCnt
		FOR lnCnt = 1 to oList.ListCount
			oList.Selected(lnCnt) = .T.
		ENDFOR
	ENDPROC

	PROCEDURE cmdAbort.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdAdd.Click
		THISFORM.LockScreen = .T.
		* The ListCount value changes whenever the RemoveItem method is called
		nCnt = 1
		DO WHILE nCnt <= ThisForm.lstSource.ListCount
			IF ThisForm.lstSource.Selected(nCnt)
				ThisForm.lstSelected.AddItem(ThisForm.lstSource.List(nCnt))
				ThisForm.lstSource.RemoveItem(nCnt)
			ELSE
				nCnt = nCnt + 1
			ENDIF
		ENDDO
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE cmdAddAll.Click
		THISFORM.LockScreen = .T.
		FOR i = 1 to ThisForm.lstSource.ListCount
			ThisForm.lstSelected.AddItem(ThisForm.lstSource.List(i))
		ENDFOR
		ThisForm.lstSource.Clear
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE cmdRemove.Click
		THISFORM.LockScreen = .T.
		nCnt = 1
		DO WHILE nCnt <= ThisForm.lstSelected.ListCount
			IF ThisForm.lstSelected.Selected(nCnt)
				ThisForm.lstSource.AddItem(ThisForm.lstSelected.List(nCnt))
				ThisForm.lstSelected.RemoveItem(nCnt)
			ELSE
				nCnt = nCnt + 1
			ENDIF
		ENDDO
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE cmdRemoveAll.Click
		THISFORM.LockScreen = .T.
		FOR i = 1 to ThisForm.lstSelected.ListCount
			ThisForm.lstSource.AddItem(ThisForm.lstSelected.List(i))
		ENDFOR
		ThisForm.lstSelected.Clear
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE cmdSave.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE lstSelected.DblClick
		
		ThisForm.lstSource.AddItem(This.List(This.ListIndex))
		This.RemoveItem(This.ListIndex)
		
	ENDPROC

	PROCEDURE lstSelected.DragDrop
		
		LPARAMETERS oSource, nXCoord, nYCoord
		IF oSource.Name != THIS.Name
			ThisForm.cmdAdd.Click
		ENDIF
		
	ENDPROC

	PROCEDURE lstSelected.DragOver
		LPARAMETERS oSource, nXCoord, nYCoord, nState
		DO CASE
			CASE nState = 0 && Enter
				oSource.DragIcon = ThisForm.CanDropIcon
			CASE nState = 1 && Leave
				oSource.DragIcon = ThisForm.NoDropIcon
		ENDCASE
		
		
	ENDPROC

	PROCEDURE lstSelected.Init
		This.DragIcon = ThisForm.CanDropIcon
		
	ENDPROC

	PROCEDURE lstSelected.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode = 63 AND nShiftAltCtrl = 1
			ThisForm.SelectAll(THIS)
		ENDIF
	ENDPROC

	PROCEDURE lstSelected.MouseDown
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		ThisForm.MouseX = nXCoord
		ThisForm.MouseY = nYCoord
		
	ENDPROC

	PROCEDURE lstSelected.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		IF nButton = 1 && Left Mouse
			IF ABS(nXCoord - ThisForm.MouseX) > ThisForm.DragThreshold OR ;
					ABS(nYCoord - ThisForm.MouseY) > ThisForm.DragThreshold
				THIS.Drag
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE lstSource.DblClick
		ThisForm.lstSelected.AddItem(This.List(This.ListIndex))
		This.RemoveItem(This.ListIndex)
		
		
	ENDPROC

	PROCEDURE lstSource.DragDrop
		LPARAMETERS oSource, nXCoord, nYCoord
		IF oSource.Name != THIS.Name
			ThisForm.cmdRemove.Click
		ENDIF
		
	ENDPROC

	PROCEDURE lstSource.DragOver
		LPARAMETERS oSource, nXCoord, nYCoord, nState
		DO CASE
			CASE nState = 0 && Enter
				oSource.DragIcon = ThisForm.CanDropIcon
			CASE nState = 1 && Leave
				oSource.DragIcon = ThisForm.NoDropIcon
		ENDCASE
		
		
	ENDPROC

	PROCEDURE lstSource.Init
		This.DragIcon = ThisForm.CanDropIcon
	ENDPROC

	PROCEDURE lstSource.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode = 63 AND nShiftAltCtrl = 1
			THISForm.SelectAll(THIS)
		ENDIF
	ENDPROC

	PROCEDURE lstSource.MouseDown
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		ThisForm.MouseX = nXCoord
		ThisForm.MouseY = nYCoord
		
	ENDPROC

	PROCEDURE lstSource.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		IF nButton = 1 && Left Mouse
			IF ABS(nXCoord - ThisForm.MouseX) > ThisForm.DragThreshold OR ;
					ABS(nYCoord - ThisForm.MouseY) > ThisForm.DragThreshold
				THIS.Drag
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE
