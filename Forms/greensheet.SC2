	PROCEDURE checkdata
		PRIVATE lSave
		lSave = .T.
		
		
		*!*	dARDate = PrepareSQLdate(ThisForm.Pageframe1.pgAdd.txtARDate.Value,'ARDate')
		*!*	IF EMPTY(dARDate)
		*!*		MESSAGEBOX( "You need an 'AR' date!"+CHR(13)+"I set to todays date.")
		*!*		dARDate = DATE()
		*!*		ThisForm.Pageframe1.pgAdd.txtARDate.Value = dARDate
		*!*		RETURN .F.
		*!*	ENDIF
		
		
		
		
		RETURN lSave
	ENDPROC

	PROCEDURE initsoitems
		*ThisFormSet.InitSOitems()
		PRIVATE nSalesNum
		nSalesnum = PrepareSQLnum(ThisFormset.frmStockLst.txtSalesNum.Value,"SalesNum",-3)
		IF nSalesNum = 0
			nSalesnum = PrepareSQLnum(ThisFormset.frmAddInvoice.txtSalesNum.Value,"SalesNum",-3)
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpSOitems')
			USE IN tmpSOitems
		ENDIF
		ThisFormset.frmStockLst.lstSOitems.Clear
		*ThisFormset.frmStockLst.lstSOitems.AddItem('All')
		
		SELECT 0
		
		cSQL = "SELECT SOitem FROM dbo.Sales WHERE SalesNum = "+STR(nSalesNum)
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitems')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitems')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitems")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpSOitems')
		ENDIF
		
		
		PRIVATE cFirtstSOitem
		*DIMENSION aSoItems[1]
		IF USED('tmpSOitems')
			cFirtstSOitem = tmpSOitems.SOitem
		*	SELECT SOitem FROM tmpSOitems INTO ARRAY aSoItems
			SELECT tmpSOitems
			SCAN
				ThisFormset.frmStockLst.lstSOitems.additem(tmpSOitems.SOitem)
			ENDSCAN
			
		*	ThisFormset.frmStockLst.lstSOitems.RowSource		= "aSoItems"
		*	ThisFormset.frmStockLst.lstSOitems.NumberOfElements	= ALEN(aSoItems,1)
			
		*	ThisFormset.frmStockLst.lstSOitems.Value = aSoItems(1)
			ThisFormset.frmStockLst.lstSOitems.Refresh
			
			GO TOP
			ThisFormSet.InitStockLst(cFirtstSOitem)
		*	ThisFormSet.InitStockLst(aSoItems(1))
			
			USE IN tmpSOitems	
		ENDIF
		
	ENDPROC

	PROCEDURE initstocklst
		PARAMETERS pcSOitem
		*ThisFormSet.InitStockLst(SOitem)
		IF VARTYPE(pcSOitem) != "C"
			MESSAGEBOX("ThisFormSet.InitStockLst(SOitem) - did not receive SOitem!",0+16,"Error")
			RETURN
		ENDIF
		
		IF EMPTY(pcSOitem)
			MESSAGEBOX("ThisFormSet.InitStockLst(SOitem) - did not receive SOitem!",0+16,"Error")
			RETURN
		ENDIF
		
		IF USED('tmpStockModified')
			USE IN tmpStockModified
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpStockModified')
			ThisFormset.frmStockLst.grdProHistory.RecordSource = ''
			USE IN tmpStockModified
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT 'B' AS [Tbl],BPH.What,ProcessValue,weight,CostValue,Size_H,PC,Dim1,Dim2,Dim3,Length,BPH.ID_Detail_Process "
		*cSQL = cSQL + " ,BPH.Validated"
		cSQL = cSQL + " ,BPH.SOitem,BDH.ID_Detail_History"
		cSQL = cSQL + " FROM dbo.[AR.BrokerLst_Detail_History] BDH WITH(NOLOCK) INNER JOIN dbo.[AR.BrokerLst_Process_History] WITH(NOLOCK) BPH ON BDH.ID_Detail_Process = BPH.ID_Detail_Process"
		cSQL = cSQL + " WHERE BPH.SOitem = dbo.f_ProperSOitem('"+pcSOitem+"')"
		cSQL = cSQL + " AND BPH.[What] = 'DELETE'"
		*cSQL = cSQL + " AND ( BPH.[What] = 'BeforeEdit' OR BPH.[What] = 'After Edit' )"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT 'S' AS [Tbl],SPH.What,ProcessValue,weight,CostValue,Size_H,PC,Dim1,Dim2,Dim3,Length,sph.ID_Detail_Process "
		*cSQL = cSQL + " ,SPH.Validated"
		cSQL = cSQL + " ,SPH.SOitem,SDH.ID_Detail_History"
		cSQL = cSQL + " FROM dbo.[AR.StockLst_Detail_History] SDH WITH(NOLOCK) INNER JOIN dbo.[AR.StockLst_Process_History] WITH(NOLOCK) SPH ON SDH.ID_Detail_Process = SPH.ID_Detail_Process"
		cSQL = cSQL + " WHERE SPH.SOitem = dbo.f_ProperSOitem('"+pcSOitem+"')"
		cSQL = cSQL + " AND SPH.[What] = 'DELETE'"
		*cSQL = cSQL + " AND ( SPH.[What] = 'BeforeEdit' OR SPH.[What] = 'After Edit' )"
		cSQL = cSQL + " ORDER BY ID_Detail_History "
		
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpStockModified')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpStockModified')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockModified")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockModified")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpStockModified' )
		ENDIF
		
		IF USED('tmpStockModified')
		*	PUBLIC ARRAY aProcessVerified()
			* 1 ID_Detail_Process, 2 Validated
			RELEASE aProcessVerified
			PUBLIC ARRAY aProcessVerified( INT(RECCOUNT('tmpStockModified')/2), 2)
			GO TOP
			SCAN
				IF MOD(RECNO('tmpStockModified'),2) = 0
				
				ELSE
					aProcessVerified(INT(RECNO('tmpStockModified')/2)+1,1) = ID_Detail_Process
					aProcessVerified(INT(RECNO('tmpStockModified')/2)+1,2) = Validated 
				ENDIF
			ENDSCAN
			GO TOP
			
			ThisFormset.frmStockLst.grdProHistory.Visible = .T.
			ThisFormset.frmStockLst.grdProHistory.RecordSource = 'tmpStockModified'
			
			ThisFormSet.SumStockLstDetail()
			ThisFormSet.SumStockLstTotal()
			
			IF RECCOUNT('tmpStockModified') > 2
				ThisFormset.frmStockLst.cmdPrev.Visible = .T.
				ThisFormset.frmStockLst.cmdNext.Visible = .T.
			ELSE
				ThisFormset.frmStockLst.cmdPrev.Visible = .F.
				ThisFormset.frmStockLst.cmdNext.Visible = .F.
			ENDIF
			
		ENDIF
		
		
		*pcSOitem
		
	ENDPROC

	PROCEDURE Load
		SET TALK OFF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE load_greensheet
		PARAMETERS pWhat
		*ThisFormSet.Load_GreenSheet()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		
		IF UPPER(pWhat) ="REFRESH"
			ThisFormSet.frmGreenSheet.grdInvoice.RecordSource = ''	
			
			IF USED('GreenSheet')
				USE IN GreenSheet
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('GreenSheet')
			SELECT 0
			
			cSQL = "SELECT [ID],[Vendor_Invoice],[HPAPO],[InvoiceDate],[subtotal],[freight],[TotalAmount]"
		    cSQL = cSQL +" FROM dbo.Vendor_Invoice" 
			*cSQL = "SELECT [InvoiceNum],[SalesNum],CONVERT( CHAR(12), [ShipDate],101 ) AS ShipDate,[Company],[Cost],[Sale] "
			
		*[ID],[Vendor_Invoice],[HPAPO],[InvoiceDate],[subtotal],[freight],[TotalAmount]
		*SELECT [Vendor_Invoice_ID],[SOitem],[Recv_Qty],[P_Qty],[itemTotal] FROM [dbo].[Vendor_Invoice_Detail]
		*SELECT [Soitem],[SalesNum],[item],[ID_Detail],[TBL],[UnitPrice],[Units],[Total] FROM [dbo].[Sales_Value]
		
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'GreenSheet')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'GreenSheet')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "GreenSheet")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "GreenSheet")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'GreenSheet' )
			ENDIF
		
		ENDIF
		
		IF USED('GreenSheet')
			
			SELECT GreenSheet
			INDEX ON [ID] TAG [ID]
			SET ORDER TO [ID]
			GO BOTTOM
			
			IF UPPER(pWhat) ="REFRESH"
				GO BOTTOM
				ThisFormSet.frmGreenSheet.grdInvoice.RecordSource = 'GreenSheet'
			ENDIF
		ELSE
			MESSAGEBOX('Failed to load GreenSheet',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETER pSaveType
		PRIVATE m.shipcomplete, lActionRequestsaved
		PRIVATE nCurrRec
		PRIVATE lnSalesNum
		PRIVATE lActionRequest, nSalesNum, cCustomer, dARdate
		
		lActionRequestsaved = .F.
		lActionRequest = .T.
		
		SELECT GreenSheet
		
		IF ThisFormSet.CheckData()
		
			nPOnum		= PrepareSQLnum(ThisForm.Pageframe1.pgAdd.txtPOnum.Value,'PONum',10,0)
			cCustomer	= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.txtCustomer.Value,'Customer',30)
			
			cSource		= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.cmbSource.Value,'Source',1)
			cRisk		= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.cmbRisk.Value,'Risk',1)
			dARDate		= PrepareSQLdate(ThisForm.Pageframe1.pgAdd.txtARDate.Value,'ARdate')
			lCAR		= PrepareSQLchk(ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.chkCAR.Value,'CAR')
			
		*!*		
		*!*			cSQL = "INSERT INTO dbo.ActionRequest "
		*!*			cSQL = cSQL + "( AR_No, RMA, SalesNum, POnum, Customer, Source, Risk, ARDate, DueDate, ARPerson, Disposition, Problem, Instruction, Rework_Date, CAR, DeterCause, CauseProb, Solution, SolBy, SolDate, VerifySol, VeriBy, VeriDate) VALUES ("
		*!*			cSQL = cSQL + " "+STR(nAR_No)
		*!*			cSQL = cSQL + ","+STR(nRMA)
		*!*			cSQL = cSQL + ","+STR(nSalesNum)
		*!*			cSQL = cSQL + ","+STR(nPOnum)
		*!*			cSQL = cSQL + ",'"+cCustomer+"'"
		*!*			cSQL = cSQL + ",'"+cSource+"'"
		*!*			cSQL = cSQL + ",'"+cRisk+"'"
		*!*			cSQL = cSQL + ",'"+IIF(EMPTY(dARDate),'',DTOC(dARDate))+"'"
		*!*			cSQL = cSQL + ",'"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		*!*			cSQL = cSQL + ",'"+cARPerson+"'"
		*!*			cSQL = cSQL + ",'"+cDisposition+"'"
		*!*			cSQL = cSQL + ",'"+cProblem+"'"
		*!*			cSQL = cSQL + ",'"+cInstruction+"'"
		*!*			cSQL = cSQL + ",'"+IIF(EMPTY(dRework_Date),'',DTOC(dRework_Date))+"'"
		*!*			cSQL = cSQL + ","+IIF(lCAR,'0','1')
		*!*			cSQL = cSQL + ",'"+cDeterCause+"'"
		*!*			cSQL = cSQL + ",'"+cCauseProb+"'"
		*!*			cSQL = cSQL + ",'"+cSolution+"'"
		*!*			cSQL = cSQL + ",'"+cSolBy+"'"
		*!*			cSQL = cSQL + ",'"+IIF(EMPTY(dSolDate),'',DTOC(dSolDate))+"'"
		*!*			cSQL = cSQL + ",'"+cVerifySol+"'"
		*!*			cSQL = cSQL + ",'"+cVeriBy+"'"
		*!*			cSQL = cSQL + ",'"+IIF(EMPTY(dVeriDate),'',DTOC(dVeriDate))+"'"
		*!*			cSQL = cSQL + ")"
		*!*				  
		
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "GreenSheet")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "GreenSheet")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
		*!*			ELSE
		*!*				lActionRequestsaved = .T.
		*!*			ENDIF
		*!*		
		*!*		ELSE
		*!*			IF MESSAGEBOX("ActionRequest #"+STR(nAR_No)+" already exist."+CHR(13)+CHR(13)+"Do you want to Update?.",0,"Update?") = 6
		*!*				
		*!*				cSQL = "UPDATE DBO.ActionRequest SET "
		*!*				cSQL = cSQL + " AR_No="+STR(nAR_No)
		*!*				cSQL = cSQL + ",RMA="+STR(nRMA)
		*!*				cSQL = cSQL + ",SalesNum="+STR(nSalesNum)
		*!*				cSQL = cSQL + ",POnum="+STR(nPOnum)
		*!*				cSQL = cSQL + ",Customer='"+cCustomer+"'"
		*!*				cSQL = cSQL + ",Source='"+cSource+"'"
		*!*				cSQL = cSQL + ",Risk='"+cRisk+"'"
		*!*				cSQL = cSQL + ",ARDate='"+IIF(EMPTY(dARDate),'',DTOC(dARDate))+"'"
		*!*				cSQL = cSQL + ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		*!*				cSQL = cSQL + ",ARPerson='"+cARPerson+"'"
		*!*				cSQL = cSQL + ",Disposition='"+cDisposition+"'"
		*!*				cSQL = cSQL + ",Problem='"+cProblem+"'"
		*!*				cSQL = cSQL + ",Instruction='"+cInstruction+"'"
		*!*				cSQL = cSQL + ",Rework_Date='"+IIF(EMPTY(dRework_Date),'',DTOC(dRework_Date))+"'"
		*!*				cSQL = cSQL + ",CAR="+IIF(lCAR,'0','1')
		*!*				cSQL = cSQL + ",DeterCause='"+cDeterCause+"'"
		*!*				cSQL = cSQL + ",CauseProb='"+cCauseProb+"'"
		*!*				cSQL = cSQL + ",Solution='"+cSolution+"'"
		*!*				cSQL = cSQL + ",SolBy='"+cSolBy+"'"
		*!*				cSQL = cSQL + ",SolDate='"+IIF(EMPTY(dSolDate),'',DTOC(dSolDate))+"'"
		*!*				cSQL = cSQL + ",VerifySol='"+cVerifySol+"'"
		*!*				cSQL = cSQL + ",VeriBy='"+cVeriBy+"'"
		*!*				cSQL = cSQL + ",VeriDate='"+IIF(EMPTY(dVeriDate),'',DTOC(dVeriDate))+"'"
		*!*				cSQL = cSQL + "	WHERE AR_No = "+STR(nAR_No)+""
		*!*	*			cSQL = cSQL + " AND RMA = "+STR(nRMA)
		*!*	*			cSQL = cSQL + " AND SalesNum = "+STR(nSalesNum)
		*!*	*			cSQL = cSQL + " AND POnum = "+STR(nPOnum)
		
		
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
		*!*				ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "GreenSheet")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "GreenSheet")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
		*!*				ELSE
		*!*					lActionRequestsaved = .T.
		*!*				ENDIF
		*!*				
					
		ENDIF
	ENDPROC

	PROCEDURE sumstocklstdetail
		*ThisFormSet.SumStockLstDetail
		PRIVATE nRecNum
		nRecNum = RECNO('tmpStockModified')
		
		SELECT tmpStockModified
		PRIVATE cSOitem
		cSOitem = tmpStockModified.SOitem
		
		SELECT ID_Detail_History FROM tmpStockModified WHERE SOitem = cSOitem ORDER BY ID_Detail_History INTO ARRAY aID_Detail_History 
		
		IF aID_Detail_History(1)>0
			
		ELSE
			MESSAGEBOX('Could not get Detail Summary!',0+16,"Error")
			RETURN
		ENDIF
		
		*Get Stock Description
		*ID_Detail_History
		PRIVATE nIDstk, nID_DetailStk, nIDbrk, nID_DetailBrk
		nIDstk		= 0
		nID_DetailStk = 0
		nIDbrk		= 0
		nID_DetailBrk = 0
		
		IF USED('tmpID_IDDetail')
			USE IN tmpID_IDDetail
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE cAlloy,cForm,cCC,cCL,nSize,cHeat,cPO_Item
		cAlloy	= ''
		cForm	= ''
		cCC		= ''
		cCL		= ''
		cHeat	= ''
		cPO_Item= ''
		
		SELECT 0
		cSQL = "SELECT ID,ID_Detail FROM dbo.StockLst_Process_Detail_History WITH(NOLOCK) WHERE ID_Detail_Process = "+STR(tmpStockModified.ID_Detail_Process)
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpID_IDDetail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpID_IDDetail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_IDDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_IDDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpID_IDDetail' )
		ENDIF
		
		
		IF USED('tmpID_IDDetail')
			IF VARTYPE(tmpID_IDDetail.ID) = "N"
				nIDstk= tmpID_IDDetail.ID
				nID_DetailStk = tmpID_IDDetail.ID_Detail
			ENDIF
			USE IN tmpID_IDDetail
		ENDIF
		
		
		IF nIDstk > 0
			*Get Alloy from ID
			IF USED('tmpAlloyForm')
				USE IN tmpAlloyForm
			ENDIF
			SELECT 0
			 
			cSQL = "SELECT Alloy,Form,CC,CL,Size,Heat,PO_Item FROM dbo.StockLst_Master WHERE ID = "+STR(nIDstk)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAlloyForm')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAlloyForm')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloyForm")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloyForm")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpAlloyForm' )
			ENDIF
			
			IF USED('tmpAlloyForm')
				IF VARTYPE(tmpAlloyForm.Alloy) = "C"
					cAlloy	= tmpAlloyForm.Alloy
					cForm	= tmpAlloyForm.Form
					cCC		= tmpAlloyForm.CC
					cCL		= tmpAlloyForm.CL
					nSIZE	= tmpAlloyForm.Size
					cHeat	= tmpAlloyForm.Heat
					cPO_Item= tmpAlloyForm.PO_Item
				ENDIF
				USE IN tmpAlloyForm
			ENDIF
			
			IF EMPTY(cAlloy)
				*Check History
				IF USED('tmpAlloyForm')
					USE IN tmpAlloyForm
				ENDIF
				SELECT 0
				 	 
				cSQL = "SELECT Alloy,Form,CC,CL,Size,Heat,PO_Item FROM dbo.[AR.StockLst_Master_History] WITH(NOLOCK) WHERE ID = "+STR(nIDstk)
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAlloyForm')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAlloyForm')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloyForm")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloyForm")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpAlloyForm' )
				ENDIF
				
				IF USED('tmpAlloyForm')
					IF VARTYPE(tmpAlloyForm.Alloy) = "C"
						cAlloy	= tmpAlloyForm.Alloy
						cForm	= tmpAlloyForm.Form
						cCC		= tmpAlloyForm.CC
						cCL		= tmpAlloyForm.CL
						nSIZE	= tmpAlloyForm.Size
						cHeat	= tmpAlloyForm.Heat
						cPO_Item= tmpAlloyForm.PO_Item
					ENDIF
					USE IN tmpAlloyForm
				ENDIF
				
			ENDIF
		ENDIF
		
		IF nIDstk = 0
			*Check Broker side
				
			SELECT 0
			cSQL = "SELECT ID,ID_Detail FROM dbo.[Ar.BrokerLst_Process_Detail_History] WITH(NOLOCK) WHERE ID_Detail_Process = "+STR(tmpStockModified.ID_Detail_Process)
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpID_IDDetail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpID_IDDetail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_IDDetail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_IDDetail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpID_IDDetail' )
			ENDIF
		
		
			IF USED('tmpID_IDDetail')
				IF VARTYPE(tmpID_IDDetail.ID) = "N"
					nIDbrk = tmpID_IDDetail.ID
					nID_DetailBrk = tmpID_IDDetail.ID_Detail
				ENDIF
				USE IN tmpID_IDDetail
			ENDIF
		ENDIF
		
		IF nIDbrk > 0
			*Get Alloy from ID
			IF USED('tmpAlloyForm')
				USE IN tmpAlloyForm
			ENDIF
			SELECT 0
			 
			cSQL = "SELECT Alloy,Form,CC,CL,Size,Heat,PO_Item FROM dbo.BrokerLst_Master WHERE ID = "+STR(nIDbrk)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAlloyForm')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAlloyForm')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloyForm")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloyForm")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpAlloyForm' )
			ENDIF
			
			IF USED('tmpAlloyForm')
				IF VARTYPE(tmpAlloyForm.Alloy) = "C"
					cAlloy	= tmpAlloyForm.Alloy
					cForm	= tmpAlloyForm.Form
					cCC		= tmpAlloyForm.CC
					cCL		= tmpAlloyForm.CL
					nSIZE	= tmpAlloyForm.Size
					cHeat	= tmpAlloyForm.Heat
					cPO_Item= tmpAlloyForm.PO_Item
				ENDIF
				USE IN tmpAlloyForm
			ENDIF
			
			IF EMPTY(cAlloy)
				*Check History
				IF USED('tmpAlloyForm')
					USE IN tmpAlloyForm
				ENDIF
				SELECT 0
				 	 
				cSQL = "SELECT Alloy,Form,CC,CL,PC,Size,Heat,PO_Item FROM dbo.[AR.BrokerLst_Master_History] WITH(NOLOCK) WHERE ID = "+STR(nIDbrk)
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAlloyForm')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAlloyForm')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloyForm")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloyForm")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpAlloyForm' )
				ENDIF
				
				IF USED('tmpAlloyForm')
					IF VARTYPE(tmpAlloyForm.Alloy) = "C"
						cAlloy	= tmpAlloyForm.Alloy
						cForm	= tmpAlloyForm.Form
						cCC		= tmpAlloyForm.CC
						cCL		= tmpAlloyForm.CL
						nSIZE	= tmpAlloyForm.Size
						cHeat	= tmpAlloyForm.Heat
						cPO_Item= tmpAlloyForm.PO_Item
					ENDIF
					USE IN tmpAlloyForm
				ENDIF
				
			ENDIF
		ENDIF
		
		
		PRIVATE nPC, nSZ1, nSZ2, nSZ3, nWeight, lRL
		nPC = 0
		nSZ1 = 0
		nWeight = 0
		
		IF nID_DetailStk > 0
			*Get Size from ID_Detail
			IF USED('tmpSz')
				USE IN tmpSz
			ENDIF
			SELECT 0
			 
			cSQL = "SELECT PC,Dim1,Dim2,Dim3,Weight,RandLen FROM dbo.StockLst_Detail WHERE ID_Detail = "+STR(nID_Detailstk)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSz')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSz')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSz")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSz")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpSz' )
			ENDIF
			
			IF USED('tmpSz')
				IF VARTYPE(tmpSz.Dim1) = "N"
					nPC		= tmpSz.PC
					nSZ1	= tmpSz.Dim1
					nSZ2	= tmpSz.Dim2
					nSZ3	= tmpSz.Dim3
					nWeight	= tmpSz.Weight
					lRL		= tmpSz.RandLen
				ENDIF
				USE IN tmpSz
			ENDIF
			
			IF EMPTY(nSZ1)
				*Check History
				IF USED('tmpSz')
					USE IN tmpSz
				ENDIF
				SELECT 0
				 	 
				cSQL = "SELECT PC,Dim1,Dim2,Dim3,Weight,RandLen FROM dbo.[AR.StockLst_Detail_History] WITH(NOLOCK) WHERE ID_Detail = "+STR(nID_Detailstk)
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSz')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSz')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSz")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSz")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpSz' )
				ENDIF
				
				IF USED('tmpSz')
					IF VARTYPE(tmpSz.Dim1) = "N"
						nPC		= tmpSz.PC
						nSZ1	= tmpSz.Dim1
						nSZ2	= tmpSz.Dim2
						nSZ3	= tmpSz.Dim3
						nWeight	= tmpSz.Weight
						lRL		= tmpSz.RandLen
		
					ENDIF
					USE IN tmpSz
				ENDIF
				
			ENDIF
		ENDIF
		
		IF nID_DetailBrk > 0
			*Get Size from ID_Detail Broker
			IF USED('tmpSz')
				USE IN tmpSz
			ENDIF
			SELECT 0
			 
			cSQL = "SELECT PC,Dim1,Dim2,Dim3,Weight,RandLen FROM dbo.BrokerLst_Detail WHERE ID_Detail = "+STR(nID_Detailstk)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSz')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSz')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSz")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSz")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpSz' )
			ENDIF
			
			IF USED('tmpSz')
				IF VARTYPE(tmpSz.Dim1) = "N"
					nPC		= tmpSz.PC
					nSZ1	= tmpSz.Dim1
					nSZ2	= tmpSz.Dim2
					nSZ3	= tmpSz.Dim3
					nWeight	= tmpSz.Weight
					lRL		= tmpSz.RandLen
				ENDIF
				USE IN tmpSz
			ENDIF
			
			IF EMPTY(nSZ1)
				*Check History
				IF USED('tmpSz')
					USE IN tmpSz
				ENDIF
				SELECT 0
				 	 
				cSQL = "SELECT PC,Dim1,Dim2,Dim3,Weight,RandLen FROM dbo.[AR.BrokerLst_Detail_History WITH(NOLOCK) WHERE ID_Detail = "+STR(nID_Detailstk)
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSz')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSz')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSz")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSz")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpSz' )
				ENDIF
				
				IF USED('tmpSz')
					IF VARTYPE(tmpSz.Dim1) = "N"
						nPC		= tmpSz.PC
						nSZ1	= tmpSz.Dim1
						nSZ2	= tmpSz.Dim2
						nSZ3	= tmpSz.Dim3
						nWeight	= tmpSz.Weight
						lRL		= tmpSz.RandLen
					ENDIF
					USE IN tmpSz
				ENDIF
				
			ENDIF
		ENDIF
		
		
		
		PRIVATE cStockDescript, cItemDescript
		cStockDescript = ''
		cItemDescript = ''
		
		IF NOT EMPTY(cAlloy) 
			cStockDescript = ALLTRIM(cAlloy)+" "+cForm+" cc:"+cCC
		
			IF LEN(ALLTRIM(cCL))>1
				cStockDescript = cStockDescript +" cl:"+cCL
			ENDIF
			cStockDescript = cStockDescript+"  Pc:"+ALLTRIM(STR(nPC))+" Sz:"+ALLTRIM(STR(nSize,9,4))+" Lbs:"+ALLTRIM(STR(nWeight))
			*Pc:"+ALLTRIM(STR(nPieces))+" Sz:"+ALLTRIM(STR(nThck,9,4))+" Lbs:"+ALLTRIM(STR(nWeight))
		ENDIF
		IF NOT EMPTY(nSz1)
			IF EMPTY(cForm)
				cForm = ''
			ENDIF
			cItemDescript = ItemDescriptionMetric(cForm, nSZ1, nSZ2, nSZ3,Weight, lRL, .f.,'','','')
		ENDIF
		
		IF NOT EMPTY(cItemDescript )
			IF NOT EMPTY(cStockDescript)
				ThisFormset.frmStockLst.txtDescriptStock.Value = cStockDescript+" - "+cItemDescript +" Ht:"+ALLTRIM(cHeat)+" PO:"+ALLTRIM(cPO_Item)
			ELSE
				ThisFormset.frmStockLst.txtDescriptStock.Value = cItemDescript 
			ENDIF
		ELSE
			IF NOT EMPTY(cStockDescript)
				ThisFormset.frmStockLst.txtDescriptStock.Value = cStockDescript +" Ht:"+ALLTRIM(cHeat)+" PO:"+ALLTRIM(cPO_Item)
			ENDIF
		ENDIF
		
		
		SELECT tmpStockModified
		PRIVATE nID_Detail_History
		nID_Detail_History = tmpStockModified.ID_Detail_History
		
		*SELECT 'S' AS [Tbl],What,ProcessValue,weight,CostValue,Size_H,PC,Dim1,Dim2,Dim3,Length,ID_Detail_Process
		
		PRIVATE BProcessValue,m.AProcessValue,m.Bweight,m.Aweight,m.BCostValue,m.ACostValue
		PRIVATE m.BPC,m.APC,m.BDim2,m.ADim2,m.BDim3,m.ADim3
		
		SUM ProcessValue FOR ID_Detail_History = aID_Detail_History(1) TO m.BProcessValue
		SUM ProcessValue FOR ID_Detail_History = aID_Detail_History(2) TO m.AProcessValue
		ThisFormset.frmStockLst.txtProcessValueD.Value = m.BProcessValue - m.AProcessValue
		
		SUM weight FOR ID_Detail_History = aID_Detail_History(1) TO m.Bweight
		SUM weight FOR ID_Detail_History = aID_Detail_History(2) TO m.Aweight
		ThisFormset.frmStockLst.txtWeightD.Value = m.Bweight - m.Aweight
		
		SUM CostValue FOR ID_Detail_History = aID_Detail_History(1) TO m.BCostValue
		SUM CostValue FOR ID_Detail_History = aID_Detail_History(2) TO m.ACostValue
		ThisFormset.frmStockLst.txtCostD.Value = m.BCostValue - m.ACostValue
		
		SUM PC FOR ID_Detail_History = aID_Detail_History(1) TO m.BPC
		SUM PC FOR ID_Detail_History = aID_Detail_History(2) TO m.APC
		ThisFormset.frmStockLst.txtPCD.Value = m.BPC - m.APC
		
		ThisFormset.frmStockLst.txtDim1D.Value = tmpStockModified.Dim1
		
		SUM Dim2 FOR ID_Detail_History = aID_Detail_History(1) TO m.BDim2
		SUM Dim2 FOR ID_Detail_History = aID_Detail_History(2) TO m.ADim2
		ThisFormset.frmStockLst.txtDim2D.Value = m.BDim2 - m.ADim2
		
		SUM Dim3 FOR ID_Detail_History = aID_Detail_History(1) TO m.BDim3
		SUM Dim3 FOR ID_Detail_History = aID_Detail_History(2) TO m.ADim3
		ThisFormset.frmStockLst.txtDim3D.Value = m.BDim3 - m.ADim3
		
		GOTO (nRecNum)
		cVerified = aProcessVerified(INT(RECNO('tmpStockModified')/2)+1,2)
		IF cVerified = 'F'
			ThisFormset.frmStockLst.chkReconcile.Value = 0
		ELSE
			ThisFormset.frmStockLst.chkReconcile.Value = 1
		ENDIF
		
		*****Get Stock Pricing
		PRIVATE nWeight,nCostValue,cUnit,lFoundUnits
		nWeight		= 0
		nCostValue	= 0
		cUnit		= ''
		lFoundUnits = .F.
		
		IF nID_DetailStk = 0 AND nID_DetailBrk = 0
			*Detail not Found!
		ELSE
			IF nID_DetailStk > 0
				*Search StockLst
				
				IF USED('tmpUnit')
					USE IN tmpUnit
				ENDIF
				SELECT 0
				 	 
				cSQL = "SELECT Weight,CostValue,Unit FROM dbo.StockLst_Detail WHERE ID_Detail = "+STR(nID_Detailstk)
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnit')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnit')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnit")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnit")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpUnit' )
				ENDIF
				
				IF USED('tmpUnit')
					IF VARTYPE(tmpUnit.Weight) = "N"
						nWeight		= tmpUnit.Weight
						nCostValue	= tmpUnit.CostValue
						cUnit		= tmpUnit.Unit
						lFoundUnits = .T.
					ENDIF
					
					USE IN tmpUnit
				ENDIF
				
				IF NOT lFoundUnits
					*Look in History
								
					IF USED('tmpUnit')
						USE IN tmpUnit
					ENDIF
					SELECT 0
					 	 
					cSQL = "SELECT Weight,CostValue,Unit FROM dbo.[AR.StockLst_Detail_History] WITH(NOLOCK) WHERE ID_Detail = "+STR(nID_Detailstk)
					cSQL = cSQL + " ORDER BY [When] DESC"
					
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnit')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnit')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnit")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnit")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpUnit' )
					ENDIF
					
					IF USED('tmpUnit')
						IF VARTYPE(tmpUnit.Weight) = "N"
							nWeight		= tmpUnit.Weight
							nCostValue	= tmpUnit.CostValue
							cUnit		= tmpUnit.Unit
							lFoundUnits = .T.
						ENDIF
						
						USE IN tmpUnit
					ENDIF
				ENDIF	
			ENDIF
				
			IF nID_DetailBrk > 0
				*Search BrokerLst
				
				IF USED('tmpUnit')
					USE IN tmpUnit
				ENDIF
				SELECT 0
				 	 
				cSQL = "SELECT Weight,CostValue,Unit FROM dbo.BrokerLst_Detail WHERE ID_Detail = "+STR(nID_DetailBrk)
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnit')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnit')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnit")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnit")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpUnit' )
				ENDIF
				
				IF USED('tmpUnit')
					IF VARTYPE(tmpUnit.Weight) = "N"
						nWeight		= tmpUnit.Weight
						nCostValue	= tmpUnit.CostValue
						cUnit		= tmpUnit.Unit
						lFoundUnits = .T.
					ENDIF
					
					USE IN tmpUnit
				ENDIF
				
				IF NOT lFoundUnits
					*Look in History
								
					IF USED('tmpUnit')
						USE IN tmpUnit
					ENDIF
					SELECT 0
					 	 
					cSQL = "SELECT Weight,CostValue,Unit FROM dbo.[AR.BrokerLst_Detail_History] WITH(NOLOCK) WHERE ID_Detail = "+STR(nID_DetailBrk)
					cSQL = cSQL + " ORDER BY [When] DESC"
					
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnit')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnit')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnit")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnit")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpUnit' )
					ENDIF
					
					IF USED('tmpUnit')
						IF VARTYPE(tmpUnit.Weight) = "N"
							nWeight		= tmpUnit.Weight
							nCostValue	= tmpUnit.CostValue
							cUnit		= tmpUnit.Unit
							lFoundUnits = .T.
						ENDIF
						
						USE IN tmpUnit
					ENDIF
				ENDIF
			ENDIF
		ENDIF
			
		IF lFoundUnits 
			ThisFormset.frmStockLst.txtUnitPrice.Value	= nCostValue
			ThisFormset.frmStockLst.txtUnits.Value		= cUnit
			ThisFormset.frmStockLst.txtMatlCost.Value	= nWeight * nCostValue
		*	ThisFormset.frmStockLst.txtSellPrice.Value	= 
		ENDIF
		
		
	ENDPROC

	PROCEDURE sumstocklsttotal
		*ThisFromSet.SumStockLstTotal
		*ID_Detail_Process
		PRIVATE cAlloy,cForm,cCC,cCL,nPieces,nThck, nSZ2, nSZ3, lRandLen, lMetric
		cAlloy = ''
		cForm = ''
		nThck= 0
		
		PRIVATE cSOitem
		cSOitem = tmpStockModified.SOitem
		
		IF USED('tmpQuoteDescript')
			USE IN tmpQuoteDescript
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT Alloy,Form,CC,CL,Pieces,thck,SZ2,SZ3,[Weight],RandLen,Metric FROM dbo.AllQuotes WHERE SOitem = '"+cSOitem+"'"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpQuoteDescript')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpQuoteDescript')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuoteDescript")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuoteDescript")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpQuoteDescript' )
		ENDIF
		
		IF USED('tmpQuoteDescript')
			IF VARTYPE(tmpQuoteDescript.Alloy) = "C"
				cAlloy	= tmpQuoteDescript.Alloy
				cForm	= tmpQuoteDescript.Form
				cCC		= tmpQuoteDescript.CC
				cCL		= tmpQuoteDescript.CL
				nPieces	= tmpQuoteDescript.Pieces
				nThck	= tmpQuoteDescript.Thck
				nSZ2	= tmpQuoteDescript.SZ2
				nSZ3	= tmpQuoteDescript.SZ3
				nWeight	= tmpQuoteDescript.Weight
				lRandLen= tmpQuoteDescript.RandLen
				lMetric	= tmpQuoteDescript.Metric
			ENDIF
		ENDIF
		
		PRIVATE cStockDescript, cItemDescript
		cStockDescript = ''
		cItemDescript = ''
		
		IF NOT EMPTY(cAlloy) 
			cStockDescript = ALLTRIM(cAlloy)+" "+cForm+" cc:"+cCC
			IF LEN(ALLTRIM(cCL))>1
				cStockDescript = cStockDescript +" cl:"+cCL
			ENDIF
			cStockDescript = cStockDescript+" Pc:"+ALLTRIM(STR(nPieces))+" Sz:"+ALLTRIM(STR(nThck,9,4))+" Lbs:"+ALLTRIM(STR(nWeight))
		ENDIF
		IF NOT EMPTY(nThck)
			IF EMPTY(cForm)
				cForm = ''
			ENDIF
			cItemDescript = ItemDescriptionMetric(cForm, nThck, nSZ2, nSZ3,Weight, lRandLen, lMetric,'','','')
		ENDIF
		
		IF NOT EMPTY(cItemDescript )
			IF NOT EMPTY(cStockDescript)
				ThisFormset.frmStockLst.txtDescriptSold.Value = cStockDescript+" - "+cItemDescript 
			ELSE
				ThisFormset.frmStockLst.txtDescriptSold.Value = cItemDescript 
			ENDIF
		ELSE
			IF NOT EMPTY(cStockDescript)
				ThisFormset.frmStockLst.txtDescriptSold.Value = cStockDescript
			ENDIF
		ENDIF
		
		
		
		SELECT tmpStockModified
		PRIVATE cSOitem
		cSOitem = tmpStockModified.SOitem
		
		SELECT ID_Detail_History FROM tmpStockModified WHERE SOitem = cSOitem ORDER BY ID_Detail_History INTO ARRAY aID_Detail_History 
		
		IF aID_Detail_History(1)>0
			
		ELSE
			MESSAGEBOX('Could not get SO item Summary!',0+16,"Error")
			RETURN
		ENDIF
		*SELECT 'B' AS [Tbl],BPH.What,ProcessValue,weight,CostValue,Size_H,PC,Dim1,Dim2,Dim3,Length,BPH.ID_Detail_Process 
		*,BPH.Validated,BPH.SOitem,BDH.ID_Detail_History"
		*WHERE SPH.[What] = 'DELETE'"
		
		PRIVATE BProcessValue,m.AProcessValue,m.Bweight,m.Aweight,m.BCostValue,m.ACostValue
		PRIVATE m.BPC,m.APC,m.BDim2,m.ADim2,m.BDim3,m.ADim3
		PRIVATE cAstring, cBstring
		cAstring = ''
		cBstring = ''
		*SUM ProcessValue FOR ID_Detail_History = aID_Detail_History(1) TO m.BProcessValue
		FOR i = 1 TO ALEN(aID_Detail_History)
			IF i = 1
				cBstring = " ID_Detail_History = "+STR(aID_Detail_History(1))
				LOOP
			ENDIF
			IF i = 2
				cAstring = " ID_Detail_History = "+STR(aID_Detail_History(2))
				LOOP
			ENDIF
			
			IF MOD(i,2) = 0
				cBstring = cBstring + " AND ID_Detail_History = "+STR(aID_Detail_History(i))
				LOOP
			ELSE
				cAstring = cAstring + " AND ID_Detail_History = "+STR(aID_Detail_History(i))
				LOOP
			ENDIF
		ENDFOR
		
		SUM ProcessValue FOR &cBstring TO m.BProcessValue
		SUM ProcessValue FOR &cAstring TO m.AProcessValue
		ThisFormset.frmStockLst.txtProcessValueT.Value = m.BProcessValue - m.AProcessValue
		
		SUM weight FOR &cBstring TO m.Bweight
		SUM weight FOR &cAstring TO m.Aweight
		ThisFormset.frmStockLst.txtWeightT.Value = m.Bweight - m.Aweight
		
		SUM CostValue FOR &cBstring TO m.BCostValue
		SUM CostValue FOR &cAstring TO m.ACostValue
		ThisFormset.frmStockLst.txtCostT.Value = m.BCostValue - m.ACostValue
		
		SUM PC FOR &cBstring TO m.BPC
		SUM PC FOR &cAstring TO m.APC
		ThisFormset.frmStockLst.txtPCT.Value = m.BPC - m.APC
		
		ThisFormset.frmStockLst.txtDim1T.Value = tmpStockModified.Dim1
		
		SUM Dim2 FOR &cBstring TO m.BDim2
		SUM Dim2 FOR &cAstring TO m.ADim2
		ThisFormset.frmStockLst.txtDim2T.Value = m.BDim2 - m.ADim2
		
		SUM Dim3 FOR &cBstring TO m.BDim3
		SUM Dim3 FOR &cAstring TO m.ADim3
		ThisFormset.frmStockLst.txtDim3T.Value = m.BDim3 - m.ADim3
		
		GO TOP
	ENDPROC

	PROCEDURE frmAddInvoice.cmdClear.Click
		ThisFormSet.frmAddInvoice.Visible = .F.
		ThisFormSet.frmStockLst.Visible = .F.
		ThisFormSet.frmGreenSheet.Visible = .T.
		ThisFormSet.frmGreenSheet.grdInvoice.SetFocus
		
		
	ENDPROC

	PROCEDURE frmAddInvoice.cmdReconcilePg.Click
		
		ThisFormSet.frmGreenSheet.Visible = .F.
		
		IF ThisForm.cmdSave.Caption = 'Add'
			ThisFormSet.frmStockLst.Visible = .T.
			ThisFormSet.InitSOitems()
		
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE frmAddInvoice.cmdSave.Click
		ThisForm.Visible = .F
		ThisFormSet.frmStockLst.Visible = .F.
		ThisFormSet.frmGreenSheet.Visible = .T.
		ThisFormSet.frmGreenSheet.grdInvoice.SetFocus
		
		
	ENDPROC

	PROCEDURE frmAddInvoice.lblDate.Click
		PRIVATE dDate1,dDate2
		
		dDate1 = ThisForm.txtShipDate.Value
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		ThisForm.txtShipDate.Value = dDate2
		ThisForm.txtShipDate.Refresh
		ThisForm.txtShipDate.SetFocus
	ENDPROC

	PROCEDURE frmAddInvoice.txtInvoiceNum.Valid
		PRIVATE nInvoiceNum
		
		nInvoiceNum = PrepareSQLnum(This.Value,"InvoiceNum",-3)
		
		IF nInvoiceNum < 0
			This.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE frmAddInvoice.txtSalesNum.Valid
		PRIVATE nInvoiceNum, nSalesNum, cCompany
		PRIVATE cSQL, nSQLEXEC 
		nsalesNum	= PrepareSQLnum(This.Value,"SalesNum",-3)
		 
		IF nSalesNum < 0
			This.Value = 0
		ELSE
			nInvoiceNum = PrepareSQLnum(ThisForm.txtInvoiceNum.Value,"InvoiceNum",-3)
		
			IF nSalesNum > 0 AND nInvoiceNum > 0
				*look up SalesNumber
				IF EMPTY(ThisForm.txtcompany.Value)
					*Get Company from SO
							
					IF USED('tmpCompany')
						USE IN tmpCompany
					ENDIF
					SELECT 0
					
					cSQL = "SELECT TOP 1 Company FROM dbo.AllQuotes WHERE SalesNum = "+STR(nSalesNum)
						  
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCompany' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL, 'tmpCompany' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompany")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompany")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCompany' )
					ENDIF
					
					IF USED('tmpCompany')
						SELECT tmpCompany
						ThisForm.txtcompany.Value = tmpCompany.Company
						USE IN tmpCompany
					ENDIF
				ENDIF
				***get Date
				IF EMPTY(ThisForm.txtShipDate.Value)
					IF USED('tmpShipDate')
						USE IN tmpShipDate
					ENDIF
					SELECT 0
					
					cSQL = "SELECT TOP 1 CONVERT(CHAR(12),SDH.[WHEN],101) AS ShipDate"
					cSQL = cSQL + " FROM dbo.[AR.StockLst_Detail_History] SDH WITH(NOLOCK) INNER JOIN dbo.[AR.StockLst_Process_History] WITH(NOLOCK) SPH WITH(NOLOCK) ON SDH.ID_Detail_Process = SPH.ID_Detail_Process "
					cSQL = cSQL + " WHERE SPH.SOitem = dbo.f_ProperSOitem('"+STR(nSalesNum)+"-01') AND SDH.[What] = 'After Edit'"
						  
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpShipDate' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL, 'tmpShipDate' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpShipDate")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpShipDate")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpShipDate' )
					ENDIF
					
					IF USED('tmpShipDate')
						SELECT tmpShipDate
						ThisForm.txtShipDate.Value = tmpShipDate.ShipDate
						USE IN tmpShipDate
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmGreenSheet.cmdAdd.Click
		*!*	ThisFormSet.FrmAddInvoice.Visible = .T.
		*!*	ThisFormset.frmAddInvoice.txtInvoiceNum.Value = 0
		*!*	ThisFormset.frmAddInvoice.txtSalesNum.Value = 0
		*!*	ThisFormset.frmAddInvoice.txtShipDate.Value = ''
		*!*	ThisFormset.frmAddInvoice.txtCompany.Value = ''
		*!*	ThisFormset.frmAddInvoice.txtCost.Value = 0
		*!*	ThisFormset.frmAddInvoice.txtSale.Value = 0
		*!*	ThisFormset.frmAddInvoice.cmdSave.Caption = 'Add'
		*!*	ThisFormset.frmAddInvoice.txtInvoiceNum.SetFocus
		*!*	ThisFormSet.FrmAddInvoice.Visible = .F.
		
		*******************************************************
		ThisFormset.frmStockLst.txtInvoiceNum.Value = 0
		ThisFormset.frmStockLst.txtSalesNum.Value = 0
		ThisFormset.frmStockLst.txtShipDate.Value = ''
		ThisFormset.frmStockLst.txtCompany.Value = ''
		ThisFormset.frmStockLst.txtCost.Value = 0
		ThisFormset.frmStockLst.txtSale.Value = 0
		ThisFormset.frmStockLst.cmdSave.Caption = 'Add'
		ThisFormset.frmStockLst.txtInvoiceNum.SetFocus
		
		ThisFormSet.frmStockLst.Visible = .T.
		
	ENDPROC

	PROCEDURE frmGreenSheet.cmdEdit.Click
		ThisFormSet.FrmAddInvoice.Visible = .T.
		
		ThisFormset.frmAddInvoice.txtInvoiceNum.Value = GreenSheet.InvoiceNum
		ThisFormset.frmAddInvoice.txtSalesNum.Value = GreenSheet.SalesNum
		ThisFormset.frmAddInvoice.txtShipDate.Value = GreenSheet.Shipdate
		ThisFormset.frmAddInvoice.txtCompany.Value = GreenSheet.Company
		ThisFormset.frmAddInvoice.txtCost.Value = GreenSheet.Cost
		ThisFormset.frmAddInvoice.txtSale.Value = GreenSheet.Sale
		
		ThisFormset.frmAddInvoice.cmdSave.Caption = 'Save'
		
		ThisFormset.frmAddInvoice.txtInvoiceNum.SetFocus
	ENDPROC

