	ENDPROC

	PROCEDURE frmStockLst.cmdClose.Click
		
		ThisFormSet.frmStockLst.Visible = .F.
		ThisFormSet.frmAddInvoice.Visible = .F.
		ThisFormSet.frmGreenSheet.Visible = .T.
		ThisFormSet.frmGreenSheet.grdInvoice.SetFocus
	ENDPROC

	PROCEDURE frmStockLst.cmdNext.Click
		PRIVATE nID_Detail_Process
		nID_Detail_Process = tmpStockModified.ID_Detail_Process
		
		IF NOT EOF('tmpStockModified')
			SELECT tmpStockModified
			SKIP 1 IN tmpStockModified
			
			IF nID_Detail_Process = tmpStockModified.ID_Detail_Process
				IF NOT EOF('tmpStockModified')
					*Still on same Process
					SKIP 1 IN tmpStockModified
					IF EOF('tmpStockModified')
						GO TOP
					ENDIF
				ELSE
					MESSAGEBOX('You are already at the End of the File!"',0+64,"End of File")
					GO TOP
				ENDIF
			ENDIF
			ThisFormSet.SumStockLstDetail()
		ELSE
			MESSAGEBOX('You are already at the End of the File!"',0+64,"End of File")
		ENDIF
	ENDPROC

	PROCEDURE frmStockLst.cmdPrev.Click
		PRIVATE nID_Detail_Process
		nID_Detail_Process = tmpStockModified.ID_Detail_Process
		
		IF NOT BOF('tmpStockModified')
			SELECT tmpStockModified
			SKIP -1 IN tmpStockModified
			
			IF nID_Detail_Process = tmpStockModified.ID_Detail_Process
				IF NOT BOF('tmpStockModified')
					*Still on same Process
					SKIP -1 IN tmpStockModified
					IF BOF('tmpStockModified')
						GO BottOM
					ENDIF
				ELSE
					GO BOTTOM
					MESSAGEBOX('You are already at the beging of the File!"',0+64,"Begging of File")
				ENDIF
			ENDIF
			ThisFormSet.SumStockLstDetail()
		ELSE
			MESSAGEBOX('You are already at the beging of the File!"',0+64,"Begging of File")
		ENDIF
	ENDPROC

	PROCEDURE frmStockLst.cmdSave.Click
		MESSAGEBOX("Do Something to SAVE here")
		
		
		
		ThisFormSet.frmStockLst.Visible = .F.
		ThisFormSet.frmAddInvoice.Visible = .F.
		ThisFormSet.frmGreenSheet.Visible = .T.
		ThisFormSet.frmGreenSheet.grdInvoice.SetFocus
		
		
	ENDPROC

	PROCEDURE frmStockLst.cmdZeroCost.Click
		MESSAGEBOX("Zero out cost here")
		
	ENDPROC

	PROCEDURE frmStockLst.lblDate.Click
		PRIVATE dDate1,dDate2
		
		dDate1 = ThisForm.txtShipDate.Value
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		ThisForm.txtShipDate.Value = dDate2
		ThisForm.txtShipDate.Refresh
		ThisForm.txtShipDate.SetFocus
	ENDPROC

