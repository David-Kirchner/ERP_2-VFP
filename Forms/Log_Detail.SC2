	PROCEDURE collectcurrentdetails
		*CollectCurrentDetails()
		PRIVATE cLabel, nData, cPOitem
		
		cLabel	= UPPER(ThisForm.pLabel)
		nData	= ThisForm.pData
		
		*This is a common 'Bad SQL Connetion' initiation point
		ThisForm.nConnHandle = CheckSQLConnection(ThisForm.nConnHandle)
		
		IF USED('tmpDetails')
			USE IN tmpDetails
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT TestPO,SrvcPO FROM "+ThisForm.TableName
		cSQL = cSQL +" WHERE ID="+ALLTRIM(STR(nData))
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpDetails')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpDetails')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetails")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetails")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpDetails' )
		ENDIF
		
		PRIVATE nTestPO, nSrvcPO 
		nTestPO = 0
		nSrvcPO = 0
		
		IF USED('tmpDetails')
			IF RECCOUNT('tmpDetails') > 0
				nTestPO = tmpDetails.TestPO
				nSrvcPO = tmpDetails.SrvcPO 
			ENDIF
			USE IN tmpDetails
		ENDIF
		
		
		****************************
		IF nTestPO > 0
			*Check to see if TestPO Detail already exits
			IF USED('tmpDetails')
				USE IN tmpDetails
			ENDIF
		
			SELECT 0
			cSQL = "SELECT ID,ID2 FROM "+ThisForm.TableDetailName
			cSQL = cSQL +" WHERE [Data]="+ALLTRIM(STR(nTestPO))
			cSQL = cSQL +" AND [Label]='TestPO'"
			
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpDetails')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpDetails')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetails")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetails")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpDetails' )
			ENDIF
		
			IF USED('tmpDetails')
				IF RECCOUNT('tmpDetails') = 0
					*INSERT
					cSQL = "INSERT INTO "+ThisForm.TableDetailName 
					cSQL = cSQL +" ([ID],[Label],[Data]) VALUES ("
					cSQL = cSQL + ALLTRIM(STR(nData))
					cSQL = cSQL +",'TestPO'"
					cSQL = cSQL +","+ALLTRIM(STR(nTestPO))
					cSQL = cSQL +")"
					
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle )
					ENDIF
		
				ENDIF
				USE IN tmpDetails		
			ENDIF
		ENDIF
		
		*************
		IF nSrvcPO > 0
			*Check to see if SrvcPO Detail already exits
			IF USED('tmpDetails')
				USE IN tmpDetails
			ENDIF
		
			SELECT 0
		
			cSQL = "SELECT ID,ID2 FROM "+ThisForm.TableDetailName
			cSQL = cSQL +" WHERE [Data]="+ALLTRIM(STR(nSrvcPO))
			cSQL = cSQL +" AND [Label]='SrvcPO'"
			
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpDetails')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpDetails')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetails")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetails")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpDetails' )
			ENDIF
		
			IF USED('tmpDetails')
				IF RECCOUNT('tmpDetails') = 0
					*INSERT
					cSQL = "INSERT INTO "+ThisForm.TableDetailName
					cSQL = cSQL +" ([ID],[Label],[Data]) VALUES ("
					cSQL = cSQL + ALLTRIM(STR(nData))
					cSQL = cSQL +",'SrvcPO'"
					cSQL = cSQL +","+ALLTRIM(STR(nSrvcPO))
					cSQL = cSQL +")"
					
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle )
					ENDIF
		
				ENDIF
				USE IN tmpDetails		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Destroy
		IF USED('Log_Details')
			USE IN Log_Details
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pLabel, pData, pConn, nTop, nLeft
		*DO FORM Forms\Log_Detail WITH "GFMLOG", GFMLog.ID, ThisForm.ConnHandle, nTop, nLeft
		*"DRAW_LOG"
		ThisForm.OrigTable = ALIAS()
		
		IF VARTYPE(pLabel) = "C"
			ThisForm.pLabel = pLabel
		ELSE
			ThisForm.pLabel = ''
		ENDIF
		
		IF VARTYPE(pData) = "N"
			ThisForm.pData = pData
		ELSE
			ThisForm.pData = 0
		ENDIF
		
		IF VARTYPE(pConn) = "N"
			ThisForm.nConnHandle = pConn
		ENDIF
		IF EMPTY(ThisForm.nConnHandle)
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		
		*****	
		*Test Connection!
		lConnection = .T.
		TRY
			SQLEXEC( ThisForm.nConnHandle, "SELECT GETDATE() as Today" , "TestSQL")
			
		CATCH 
			*Bad Connection
			lConnection = .F.
		ENDTRY
		IF NOT lConnection 
			PRIVATE nBadConn
			nBadConn = ThisForm.nConnHandle
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			TrackError("Bad Conn","Log_Detail.INIT L39. BadConn:"+ALLTRIM(STR(nBadConn))+" nConnHandle:"+ALLTRIM(STR(ThisForm.nConnHandle)),"Log_Detail.Init",LINENO(1) )
		ENDIF
		
		****
		IF VARTYPE(nTop) = "N"
			ThisForm.Top = nTop
		ENDIF
		IF VARTYPE(nLeft) = "N"
			ThisForm.Left = nLeft + 15
		ENDIF
		
		
		************************
		PRIVATE cTableName, cTableDetailName
		cTableName = ""
		cTableDetailName = ""
		DO CASE
		CASE ThisForm.pLabel = "GFMLOG"
			cTableName = "dbo.GFMLog"
			cTableDetailName = "dbo.GFMLog_Detail"
			This.Caption = "GFM Log Detail"
		CASE UPPER(ThisForm.pLabel) = "SWAGE_LOG"
			cTableName = "dbo.Swage_Log"
			cTableDetailName = "dbo.Swage_Log_Detail"
			This.Caption = "Swage Log Detail"
			
		CASE UPPER(ThisForm.pLabel) = "DRAW_LOG"
			cTableName = "dbo.Draw_log"
			cTableDetailName = "dbo.Draw_Log_Detail"
			This.Caption = "Draw Log Detail"
		
		
		
		ENDCASE
		
		
		ThisForm.TableName = cTableName
		ThisForm.TableDetailName = cTableDetailName
		
		************************
		IF USED('Log_Details')
			USE IN Log_Details
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT ID,Label,Data,POitem,ID2 FROM "+ThisForm.TableDetailName 
		cSQL = cSQL +" WHERE ID="+ALLTRIM(STR(ThisForm.pData))
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Log_Details')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Log_Details')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Details")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Details")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'Log_Details' )
		ENDIF
		
		ThisForm.grdLog_Details.RecordSource = ''
		ThisForm.grdLog_Details.RecordSource = 'Log_Details'
		
		ThisForm.InitLabel()
	ENDPROC

	PROCEDURE initlabel
		*ThisForm.InitLabel
		IF EMPTY(ThisForm.TableDetailName)
			RETURN .F.
		ENDIF
		
		IF USED('tmpLabel')
			USE IN tmpLabel
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL="SELECT DISTINCT [Label] FROM "+ThisForm.TableDetailName
		cSQL=cSQl+" WHERE LEN([LABEL]) > 0 "
		cSQL=cSQl+" UNION SELECT 'TestPO' AS [Label]"
		cSQL=cSQl+" UNION SELECT 'SrvcPO' AS [Label]"
		cSQL=cSQl+" UNION SELECT 'HT_Log' AS [Label]"
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpLabel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpLabel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLabel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLabel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpLabel' )
		ENDIF
		
		IF USED('tmpLabel')
			IF RECCOUNT('tmpLabel')>0
				ThisForm.cmbLabel.Clear
				ThisForm.cmbLabel.NumberOfElements = RECCOUNT('tmpLabel')
				SCAN
					ThisForm.cmbLabel.addListitem(tmpLabel.Label)
				ENDSCAN
			ENDIF
			USE IN 'tmpLabel'
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
	ENDPROC

	PROCEDURE refreshlog_detail
		*ThisForm.RefreshLog_Detail()
		*This is a common 'Bad SQL Connetion' initiation point
		ThisForm.nConnHandle = CheckSQLConnection(ThisForm.nConnHandle)
		
		IF USED('Log_Details')
			ThisForm.grdLog_Details.RecordSource = ''
			USE IN Log_Details
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT ID,Label,Data,POitem,ID2 FROM "+ThisForm.TableDetailName 
		cSQL = cSQL +" WHERE ID="+ALLTRIM(STR(ThisForm.pData))
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Log_Details')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Log_Details')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Details")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Details")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'Log_Details' )
		ENDIF
		
		IF USED('Log_Details')
			IF RECCOUNT('Log_Details') > 0
				ThisForm.grdLog_Details.RecordSource = 'Log_Details'
			ELSE
				ThisForm.grdLog_Details.RecordSource = ''
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdAdd.Click
		ThisForm.CollectCurrentDetails()
		
		ThisForm.grdLog_Details.Visible = .F.
		ThisForm.cmdAdd.Visible = .F.
		ThisForm.cmdGoTo.Visible = .F.
		ThisForm.cmdEdit.Caption = "Save"
		ThisForm.cmdDelete.Caption = "Abort"
		
		ThisForm.lblLabel.Visible = .T.
		ThisForm.cmbLabel.Visible = .T.
		ThisForm.lblNumber.Visible = .T.
		ThisForm.txtData.Visible = .T.
		ThisForm.lblPOitem.Visible = .T.
		ThisForm.txtPOitem.Visible = .T.
		***Add
		
		ThisForm.cmbLabel.Enabled = .T.
		ThisForm.txtData.Enabled = .T.
		
		ThisForm.txtID2.Value = 0
		
		*ThisForm.cmbLabel.Value = 
		*ThisForm.txtData.Value = Log_Details.Data
		
		ThisForm.RefreshLog_Detail()
	ENDPROC

	PROCEDURE cmdClose.Valid
		THISFORM.Release
		
	ENDPROC

	PROCEDURE cmdDelete.Click
		IF This.Caption = "Abort"
			ThisForm.grdLog_Details.Visible = .T.
			ThisForm.cmdAdd.Visible = .T.
			ThisForm.cmdGoTo.Visible = .T.
			This.Caption = "Delete"
			ThisForm.cmdEdit.Caption = "Edit"
			
			ThisForm.lblLabel.Visible = .F.
			ThisForm.cmbLabel.Visible = .F.
			ThisForm.lblNumber.Visible = .F.
			ThisForm.txtData.Visible = .F.
			ThisForm.lblPOitem.Visible = .F.
			ThisForm.txtPOitem.Visible = .F.
		
			RETURN
		ENDIF
		
		*ELSE **Delete
		
		IF USED('Log_Details')
			PRIVATE nID, cLabel, nData, cPOitem, nID2
			nID		= Log_Details.ID
			cLabel	= Log_Details.Label
			nData	= Log_Details.Data
			cPOitem = PrepareSQLtxt(Log_Details.POitem,'POitem',12)
			nID2	= PrepareSQLnum(Log_Details.ID2,'ID2',-3)
			IF nID2 > 0
			
				IF MESSAGEBOX("Are you sure you want to Delete this Detail link?"+CHR(13)+"Label='"+cLabel+"'"+CHR(13)+"Data="+ALLTRIM(STR(nData)),4+32,"Delete") = 6
		
					cSQL = "DELETE FROM "+ThisForm.TableDetailName
					cSQL = cSQL +" WHERE [ID]="+ALLTRIM(STR(nID))
					cSQL = cSQL +" AND [Label]='"+cLabel+"'"
					cSQL = cSQL +" AND [Data]="+ALLTRIM(STR(nData))
					cSQL = cSQL +" AND [ID2]="+ALLTRIM(STR(nID2))
					IF Proper_PO_item(cPOitem) != Proper_PO_item('')
						cSQL = cSQL +" AND [POitem]='"+cPOitem+"'"
					ENDIF
					
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle )
					ENDIF
							
					ThisForm.RefreshLog_Detail()
				ENDIF
			ELSE
				WAIT WINDOW "No ID to Delete!" NOWAIT
			ENDIF
		ELSE
			MESSAGEBOX("No 'Log_Details' in use to delete from'",48,'Error')
		ENDIF
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			IF NOT USED('Log_Details')
				TrackError("Log_Details table is not in USE.","Lost Table", PROGRAM(), LINENO(1))
				MESSAGEBOX("Log_Details table is not in USE."+CHR(13)+"The rest of this code block will fail.",16,"Lost Table")
			ENDIF
			
			PRIVATE nID, cLabel, nData, cPOitem, nID2
			nID		= PrepareSQLnum(Log_Details.ID,'ID',-3)
			cLabel	= PrepareSQLtxt(Log_Details.Label,'Label',25)
			nData	= PrepareSQLnum(Log_Details.Data,'Data',-3)
			cPOitem	= PrepareSQLtxt(Log_Details.POitem,'POitem',12)
			nID2	= PrepareSQLnum(Log_Details.ID2,'ID2',-3)
			
			IF nID > 0
		
				ThisForm.grdLog_Details.Visible = .F.
				ThisForm.cmdAdd.Visible = .F.
				ThisForm.cmdGoTo.Visible = .F.
				This.Caption = "Save"
				ThisForm.cmdDelete.Caption = "Abort"
				
				ThisForm.cmbLabel.Enabled = .F.
				ThisForm.txtData.Enabled = .T.
				
				ThisForm.lblLabel.Visible = .T.
				ThisForm.cmbLabel.Visible = .T.
				ThisForm.lblNumber.Visible = .T.
				ThisForm.txtData.Visible = .T.
				ThisForm.lblPOitem.Visible = .T.
				ThisForm.txtPOitem.Visible = .T.
				
				ThisForm.cmbLabel.Value = cLabel
				ThisForm.txtData.Value = nData
				ThisForm.txtPOitem.Value = cPOitem
				ThisForm.txtID2.Value = nID2
				
			ELSE
				WAIT WINDOW "No ID to Edit, Add first!" NOWAIT
			ENDIF
		ELSE
			*Save
			PRIVATE cLabel, nData, cPOitem, nID2
			cLabel = ALLTRIM(ThisForm.cmbLabel.Value)
			nData = PrepareSQLnum(ThisForm.txtData.Value,'Data',-3)
			cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
			nID2	= PrepareSQLnum(ThisForm.txtID2.Value,'ID2',-3)
			
			PRIVATE cTableName,cIDName
			DO CASE
			CASE cLabel = "TestPO"
				cTableName = "PurchaseOrder"
				cIDName = "HPAPO"
			CASE cLabel = "SrvcPO"
				cTableName = "PurchaseOrder"
				cIDName = "HPAPO"
			CASE cLabel = "HT_Log"
				cTableName = "HT_Log"
				cIDName = "Lot"
			OTHERWISE
				cTableName = cLabel 
				cIDName = "ID"
			ENDCASE
			
			*Check Data
			PRIVATE lOKtoSave
			lOKtoSave = .F.
			
			IF EMPTY(cTableName)
				MESSAGEBOX("No Label!",0,"Cannot save.")
				RETURN .F.
			ENDIF
			IF NOT EMPTY(cPOitem)
				IF nData < 1
					nData = VAL(cPOitem)
				ENDIF
			ENDIF
			IF LEN(cPOitem)<10
				cPOitem = Proper_PO_item('')
			ENDIF
			IF nData < 1 AND Proper_PO_item(cPOitem) != Proper_PO_item('')
				MESSAGEBOX("No Number or POitem!"+CHR(13)+"Click the  box [PO item] to correct.",0,"Bad POitem, cannot save.")
				RETURN .F.
			ENDIF
			
			*Does this number belong with this Label
			IF USED('tmpTestInsert')
				USE IN tmpTestInsert
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC 
		
			SELECT 0
			cSQL="SELECT COUNT(*) AS Cnt FROM dbo."+cTableName 
			
			IF nData > 0 AND Proper_PO_item(cPOitem) != Proper_PO_item('')
				cSQL=cSQL+" WHERE "+cIDName+" = "+ALLTRIM(STR(nData))
				cSQL=cSQL+" AND POitem = '"+cPOitem+"'"
			ELSE
				IF nData > 0
					cSQL=cSQL+" WHERE "+cIDName+" = "+ALLTRIM(STR(nData))
				ENDIF
				IF Proper_PO_item(cPOitem) != Proper_PO_item('')
					cSQL=cSQL+" WHERE POitem = '"+cPOitem+"'"
				ENDIF
			ENDIF
			
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpTestInsert')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpTestInsert')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTestInsert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTestInsert")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpTestInsert' )
			ENDIF
		
			IF USED('tmpTestInsert')
				IF RECCOUNT('tmpTestInsert')>0
					IF tmpTestInsert.Cnt > 0
						lOKtoSave = .T.
					ENDIF
				ENDIF
			ENDIF
			
		**************************************	
			IF ThisForm.cmbLabel.Enabled = .T.
				*Insert, from Add
							
				IF lOKtoSave
					cSQL = "INSERT INTO "+ThisForm.TableDetailName 
					cSQL = cSQL +" ([ID],[Label],[Data],[POitem]) VALUES ("
					cSQL = cSQL + ALLTRIM(STR(ThisForm.pData))
					cSQL = cSQL +",'"+cLabel+"'"
					cSQL = cSQL +","+ALLTRIM(STR(nData))
					cSQL = cSQL +",'"+cPOitem+"'"
					cSQL = cSQL +")"
					*ID2 is automatic
					
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle )
					ENDIF
					
				ELSE
					MESSAGEBOX("Table="+cTableName+" does not have a"+CHR(13)+cIDName+" = "+ALLTRIM(STR(nData)),16,"Cannot save.")
					RETURN .F.
				ENDIF
			ELSE
				*Update, from Edit		
				IF lOKtoSave
					cSQL = "UPDATE "+ThisForm.TableDetailName 
					cSQL = cSQL +" SET [Data] = "+ALLTRIM(STR(nData))
					cSQL = cSQL + ", POitem='"+cPOitem+"'"
					cSQL = cSQL + " WHERE [ID] = "+ALLTRIM(STR(ThisForm.pData))
					cSQL = cSQL + " AND [Label]='"+cLabel+"'"
					cSQL = cSQL + " AND ID2="+STR(nID2)
					
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle )
					ENDIF
				ELSE
					MESSAGEBOX("Table="+cTableName+" does not have a"+CHR(13)+cIDName+" = "+ALLTRIM(STR(nData)),16,"Cannot save.")
					RETURN .F.
				ENDIF
			ENDIF
			
			ThisForm.grdLog_Details.Visible = .T.
			ThisForm.cmdAdd.Visible = .T.
			ThisForm.cmdGoTo.Visible = .T.
			This.Caption = "Edit"
			ThisForm.cmdDelete.Caption = "Delete"
			
			ThisForm.lblLabel.Visible = .F.
			ThisForm.cmbLabel.Visible = .F.
			ThisForm.lblNumber.Visible = .F.
			ThisForm.txtData.Visible = .F.
			ThisForm.lblPOitem.Visible = .F.
			ThisForm.txtPOitem.Visible = .F.
			
		
		ENDIF
		
		ThisForm.RefreshLog_Detail()
	ENDPROC

	PROCEDURE cmdGoTo.Click
		IF USED('Log_Details')
			PRIVATE nID, cLabel, nData, cPOitem, nID2
			nID		= PrepareSQLnum(Log_Details.ID,'ID',-3)
			cLabel	= PrepareSQLtxt(Log_Details.Label,'Label',25)
			nData	= PrepareSQLnum(Log_Details.Data,'Data',-3)
			cPOitem	= PrepareSQLtxt(Log_Details.POitem,'POitem',12)
			nID2		= PrepareSQLnum(Log_Details.ID2,'ID2',-3)
			
			IF nData = 0
				nData = VAL(cPOitem)
			ENDIF
			
			DO CASE 
			CASE cLabel = 'TestPO'
				DO FORM Forms\purchaseorder WITH nData
			CASE cLabel = 'SrvcPO'
				DO FORM Forms\purchaseorder WITH nData
			CASE cLabel = 'HT_Log'
				DO FORM\Forms\HT_Log WITH nData
			*CASE cLabel = 'UT_Log'
		
			OTHERWISE
			ENDCASE
		ELSE
			MESSAGEBOX("No 'Log_Details' in use for 'Go To'.",48,'Error')
		ENDIF
		
	ENDPROC

	PROCEDURE lblPOitem.Click
		
		PRIVATE cPOItem, nData, cSQL, nSQLEXEC 
		cPOItem = PrepareSQLtxt(ThisForm.txtPoItem.Value,'POitem',12)
		nData = PrepareSQLnum(ThisForm.txtData.Value,'POnum',-3)
		
		IF Proper_PO_item_PO(cPOitem) > 0
			DO FORM Forms\ChoosePOitem WITH Proper_PO_item_PO(cPOitem) TO cPOItem
		ENDIF
		*!*	IF Proper_PO_item(cPOItem) = Proper_PO_item('')
		*!*		IF nData > 0
		*!*			DO FORM Forms\ChoosePOitem WITH nData TO cPoItem
		*!*		ELSE
		*!*			DO FORM Forms\SelectPO_item TO cPOItem
		*!*		ENDIF
		*!*	ELSE
		*!*		IF VAL(cPOitem) > 0
		*!*			DO FORM Forms\ChoosePOitem WITH VAL(cPOitem) TO cPoItem
		*!*		ELSE
		*!*			IF nData > 0
		*!*				DO FORM Forms\ChoosePOitem WITH nData TO cPoItem
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		IF Proper_PO_item(cPOItem) != Proper_PO_item('')
			ThisForm.txtPoItem.Value = cPOItem
			ThisForm.txtData.Value = VAL(cPOItem)
		ENDIF		
		
	ENDPROC

ENDDEFINE
