	PROCEDURE Init
		ThisForm.Load_rtr_Operation(0)
		
	ENDPROC

	PROCEDURE Load
		SET TALK OFF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE load_rtr_operation
		PARAMETERS pNum
		*ThisForm.Load_rtr_Operation(0)&& if pNum=0 then INIT
		
		
		IF USED('rtr_Operation')
			USE IN rtr_Operation
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		*cSQL = "SELECT * FROM dbo.rtr_Operation ORDER BY Customer"
		cSQL = "SELECT [Oper_ID],[Operation] "
		cSQL = cSQL + " ,[jobClassID],[jobClass],[jobType] "
		cSQL = cSQL + " ,[StdDetail] "
		cSQL = cSQL + " FROM dbo.rtr_Operation "
		cSQL = cSQL + " ORDER BY Oper_ID"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'rtr_Operation')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'rtr_Operation' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'rtr_Operation')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'rtr_Operation')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'rtr_Operation' )
		ENDIF
		
		IF USED('rtr_Operation')
			
			IF pNum > 0
				LOCATE FOR Oper_ID = pNum
			ENDIF
			
		*	INDEX ON Customer TAG Customer
			ThisForm.grd_Operation.RecordSource = 'rtr_Operation'
			ThisForm.grd_Operation.Visible = .T.
			
			*ThisForm.grd_Operation.SetAll("dynamicbackcolor", "IIF(ISNULL(rtr_Operation.CustomerID),RGB( 255, 255, 255 ),RGB( 128,255,128 ))", "Column")
			
			ThisForm.Refresh_Operation()
			
		ELSE
			ThisForm.grd_Operation.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE refresh_operation
		*ThisForm.Refresh_Operation()
		
		ThisForm.txtOper_ID.Value	= PrepareSQLnum(rtr_Operation.Oper_ID,'Oper_ID',-3)
		ThisForm.txtOperation.Value	= ShowSQLtxt(rtr_Operation.Operation,'Operation',20)
		ThisForm.txtJobClass.Value	= ShowSQLtxt(rtr_Operation. JobClass,'JobClass',11)
		ThisForm.txtJobClassID.Value= PrepareSQLnum(rtr_Operation.jobClassID,'jobClassID',-1)
		ThisForm.txtJobType.Value	= ShowSQLtxt(rtr_Operation.JobType,'JobType',50)
		ThisForm.txtStdDetail.Value	= PrepareSQLnum(rtr_Operation.StdDetail,'StdDetail',-2)
	ENDPROC

	PROCEDURE refresh_shipaddr
	ENDPROC

	PROCEDURE save_operation
		*ThisForm.Save_Operation()
		PRIVATE cOper_ID, nOper_ID
		cOper_ID = PrepareSQLtxt(ThisForm.txtOper_ID,'Oper_ID',10)
		nOper_ID = PrepareSQLnum(ThisForm.txtOper_ID,'Oper_ID',-3)
		
		
		PRIVATE nOper_ID, cOperation,cJobClass,nJobClassID,cJobType,nStdDetail
		
		nOper_ID	= PrepareSQLnum(ThisForm.txtOper_ID.Value,'Oper_ID',-3)
		cOperation	= PrepareSQLtxt(ThisForm.txtOperation.Value,'Operation',20)
		cJobClass	= PrepareSQLtxt(ThisForm.txtJobClass.Value,'JobClass',11)
		nJobClassID = PrepareSQLnum(ThisForm.txtJobClassID.Value,'jobClassID',-1)
		cJobType	= PrepareSQLtxt(ThisForm.txtJobType.Value,'JobType',50)
		nStdDetail	= PrepareSQLnum(ThisForm.txtStdDetail.Value,'StdDetail',-2)
		
		IF cOper_ID = "new"
			*Insert
			cSQL = "INSERT dbo.rtr_Operation "
			cSQL =cSQL+"(Operation,JobClassID,JobType,StdDetail)"
			cSQL =cSQL+" VALUES ("
			cSQL =cSQL+"'"+cOperation
			
			cSQL =cSQL+","+STR(nJobClassID)
			cSQL =cSQL+",'"+cJobType+"'"
			cSQL =cSQL+","+STR(nStdDetail)
			cSQL =cSQL+" )"
						
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
				lOK = .F.
			ENDIF	
		ELSE
			IF nOper_ID  > 0
				*Update
				cSQL = "UPDATE dbo.rtr_Operation SET "
				cSQL =cSQL+" Operation='"+cOperation+"'"
				*cSQL =cSQL+",JobClass='"+cJobClass+"'"
				cSQL =cSQL+",JobClassID="+STR(nJobClassID)
				cSQL =cSQL+",JobType='"+cJobType+"'"
				cSQL =cSQL+",StdDetail="+STR(nStdDetail)
		
				cSQL=cSQL+" WHERE Oper_ID ="+STR(nOper_ID)
						
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
					lOK = .F.
				ENDIF		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE show_operation
		PARAMETERS pText
		*Show_Operation('BeginEdit')
		
		IF pText = 'BeginEdit'
		*	ThisForm.txtOper_ID.ReadOnly = .F.
			ThisForm.txtOperation.ReadOnly = .F.
			*ThisForm.txtJobClass.ReadOnly = .F.
			ThisForm.txtJobClassID.ReadOnly = .F.
			ThisForm.txtJobType.ReadOnly = .F.
			ThisForm.txtStdDetail.ReadOnly = .F.
			
			ThisForm.txtOper_ID.SetFocus()
		
		ELSE
			IF pText = 'EndEdit'
		*		ThisForm.txtOper_ID.ReadOnly = .T.
				ThisForm.txtOperation.ReadOnly = .T.
				*ThisForm.txtJobClass.ReadOnly = .T.
				ThisForm.txtJobClassID.ReadOnly = .T.
				ThisForm.txtJobType.ReadOnly = .T.
				ThisForm.txtStdDetail.ReadOnly = .T.
				
			ENDIF	
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF USED('SoldAddr')
			USE IN SoldAddr
		ENDIF
		
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdDone.Click
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			ThisForm.Show_Operation('BeginEdit')
			
			This.Caption = "Save"
			ThisForm.cmdNew.Caption = "Cancel"
			
		ELSE
			*This.Caption = "Save"
			ThisForm.Show_Operation('EndEdit')
			
			ThisForm.Save_Operation()
			
			This.Caption = "Edit"
			ThisForm.cmdNew.Caption = "New"
		ENDIF
	ENDPROC

	PROCEDURE cmdNew.Click
		IF This.Caption = "New"
			ThisForm.Show_Operation('BeginEdit')
			ThisForm.txtOper_ID.Value = 'new'
			
			ThisForm.cmdEdit.Caption = "Save"
			This.Caption = "Cancel"
		ELSE
			*This.Caption = "Cancel"
			ThisForm.Show_Operation('EndEdit')
			
			ThisForm.Refresh_Operation()
			
			This.Caption = "New"
			ThisForm.cmdEdit.Caption = "Edit"
		ENDIF
		
	ENDPROC

	PROCEDURE grd_Operation.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Refresh_Operation()
	ENDPROC

ENDDEFINE
