	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Show Vendor Invoice"
		DoCreate = .T.
		Height = 471
		Left = 0
		Name = "frmVendor_Invoice"
		nconnhandle = 0
		ndecimals = 0
		Top = 0
		Width = 795
	*</PropValue>

	ADD OBJECT 'cmdReturn' AS commandbutton WITH ;
		Caption = "Return", ;
		Height = 27, ;
		Left = 576, ;
		Name = "cmdReturn", ;
		Top = 420, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grdDetail' AS grid WITH ;
		Height = 108, ;
		Left = 12, ;
		Name = "grdDetail", ;
		Top = 240, ;
		Width = 780
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'grdInvoice' AS grid WITH ;
		Height = 200, ;
		Left = 12, ;
		Name = "grdInvoice", ;
		Top = 24, ;
		Width = 780
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'Label1' AS label WITH ;
		Caption = "see FORM Sales_Detail", ;
		Height = 17, ;
		Left = 84, ;
		Name = "Label1", ;
		Top = 408, ;
		Width = 144
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE getvendor_invoice_detail
		*thisform.getVendor_Invoice_Detail()
		
		ThisForm.grdDetail.RecordSource = ''
			
		PRIVATE cSQL, nSQLEXEC 
		IF USED('Vendor_Invoice_Detail')
			USE IN Vendor_Invoice_Detail
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.Vendor_Invoice_Detail WHERE Vendor_Invoice_ID="+STR(Vendor_Invoice.ID)
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Vendor_Invoice_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Vendor_Invoice_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor_Invoice_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor_Invoice_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'Vendor_Invoice_Detail' )
		ENDIF
		
		IF USED('Vendor_Invoice_Detail')
			SELECT Vendor_Invoice_Detail
			
			ThisForm.grdDetail.RecordSource = 'Vendor_Invoice_Detail'
			
		ELSE
			MESSAGEBOX('Failed to load SO',0+16,"Error")
			RETURN .F.	
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		ThisForm.nDecimals = SET('DECIMALS')
		SET DECIMALS TO 4
		
		ThisForm.GetVendor_Invoice_Detail()
	ENDPROC

	PROCEDURE Load
		SET TALK OFF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisForm.Load_Vendor_Invoice()
		
		IF USED('Vendor_Invoice')
			SELECT Vendor_Invoice
		ELSE
			MESSAGEBOX("You were not able to load data."+CHR(10)+"Quiting now...",16,"No Data")
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE load_vendor_invoice
		PARAMETERS pWhat
		*Load_Vendor_Invoice
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		
		IF UPPER(pWhat) ="REFRESH"
			ThisForm.grdInvoice.RecordSource = ''	
			
			IF USED('Vendor_Invoice')
				USE IN Vendor_Invoice
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('Vendor_Invoice')
			SELECT 0
			
			cSQL = "SELECT * FROM dbo.Vendor_Invoice WITH(nolock)"
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Vendor_Invoice')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Vendor_Invoice')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor_Invoice")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor_Invoice")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'Vendor_Invoice' )
			ENDIF
		
		ENDIF
		
		IF USED('Vendor_Invoice')
			SELECT Vendor_Invoice
			
			IF UPPER(pWhat) ="REFRESH"
				GO TOP
				ThisForm.grdInvoice.RecordSource = 'Vendor_Invoice'
				ThisForm.GetVendor_Invoice_Detail()
			ENDIF
				
			
		ELSE
			MESSAGEBOX('Failed to load SO',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Release
		SET DECIMALS TO (ThisForm.nDecimals)
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE grdInvoice.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.GetVendor_Invoice_Detail()
	ENDPROC

ENDDEFINE
