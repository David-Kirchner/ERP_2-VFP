		IF USED("tmpSourcePH_Company")
			USE IN tmpSourcePH_Company
		ENDIF
	ENDPROC

	PROCEDURE ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle)
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy = ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy,  ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
			
				*ThisFormSet.CheckCompanyAlloyDuplicate(cAlloyStandard)
				
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				*MESSAGEBOX("Use Quotes-Alloys Standard program to add a new Alloy.",0+64,"Unkown Alloy.")
				*RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE ALLOY_AKA1.Valid
		PRIVATE cAlloyAKA, cAlloy
		cAlloyAKA = THIS.VALUE
		
		
		IF TYPE("cAlloyAKA") = "C"
		
			cAlloy = THISFORM.Alloy1.VALUE
			
			IF EMPTY('cAlloy')
				RETURN .T.
			ENDIF
			
			IF TYPE("cAlloy") = "C"
			
			
				PRIVATE cAlloyStandard
		
				IF NOT EMPTY(cAlloyAKA)
					cAlloyStandard = GetAlloyStandard( cAlloyAKA, ThisForm.nConnHandle )
					
					IF EMPTY(cAlloyStandard)
					*	IF MESSAGEBOX("Do you want to save this Alloy AKA:"+cAlloyAKA+CHR(10)+"to Alloy:"+cAlloy ,3+32,"AKA not found!") = 6
					*		*save
					*		INSERT_AlloyAKA( cAlloy, cAlloyAKA, ThisForm.nConnHandle )
					*	ENDIF
					ELSE
						* Have AlloyAKA
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdAlloyAdd.Click
		This.Enabled = .F.
		ThisForm.cmdAlloyEdit.Caption = "Save"
		ThisForm.cmdAlloyDelete.Caption = "Abort"
		
		*Clear Contacts
		ThisForm.clearAlloyInfo()
		
		ThisForm.Sources_Enabled(.T.)
		
	ENDPROC

	PROCEDURE cmdAlloyDelete.Click
		IF This.Caption = "Delete"
			*Delete
			PRIVATE nID_Sources, lGood
			nID_Sources = tmpSources_Alloys.ID_Sources
			lGood = .T.
			
			cSQL = "DELETE FROM dbo.Sources "
			cSQL = cSQL + " WHERE ID_Sources ="+STR(nID_Sources )
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				lGood = .F.
			ENDIF
		
			IF lGood 
				SELECT tmpSources_Alloys
				IF NOT EOF()
					SKIP 1
				ELSE
					SKIP -1
				ENDIF
				
				IF NOT EOF() AND NOT BOF()
					nID_Sources = tmpSources_Alloys.ID_Sources
					
					Thisform.getSourceAlloys()
					
					SELECT tmpSources_Alloys
					LOCATE FOR ID_Sources = nID_Sources
					
					ThisForm.getAlloyInfo()
				ELSE
					ThisForm.ClearAlloyInfo()
				ENDIF
			ENDIF
		ELSE
			*Abort
			Thisform.getSourceAlloys()
			
			ThisForm.cmdAlloyAdd.Enabled = .T.
			ThisForm.cmdAlloyEdit.Caption = "Edit"
			This.Caption = "Delete"
			
			ThisForm.Sources_Enabled(.F.)
		ENDIF
	ENDPROC

	PROCEDURE cmdAlloyEdit.Click
		IF This.Caption = "Edit"
			*Edit the Alloy Info
			
			ThisForm.cmdAlloyAdd.Enabled = .F.
			This.Caption = "Save"
			ThisForm.cmdAlloyDelete.Caption = "Abort"
			
			ThisForm.Sources_Enabled(.T.)
			
		ELSE
			*Save Alloy Info
			PRIVATE cAlloy, cAlloy_AKA, cUNS, cSpec
			PRIVATE lF10, lF20, lF30, lF40, lF60, lF65, lF70, lF75, lSTK, lMK
			PRIVATE cNotes, nID
				
			cAlloy	=  PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
			cAlloy_AKA	=  PrepareSQLtxt(ThisForm.Alloy_AKA1.Value,'Alloy_AKA',12)
			cUNS	=  PrepareSQLtxt(ThisForm.UNS1.Value,'UNS',6)
			cSpec	=  PrepareSQLtxt(ThisForm.Spec1.Value,'Spec',50)
			
			lF10	= PrepareSQLlogic(ThisForm.chkF101.Value,'F10')
			lF20	= PrepareSQLlogic(ThisForm.chkF201.Value,'F20')
			lF30	= PrepareSQLlogic(ThisForm.chkF301.Value,'F30')
			lF40	= PrepareSQLlogic(ThisForm.chkF401.Value,'F40')
			lF60	= PrepareSQLlogic(ThisForm.chkF601.Value,'F60')
			lF65	= PrepareSQLlogic(ThisForm.chkF651.Value,'F65')
			lF70	= PrepareSQLlogic(ThisForm.chkF701.Value,'F70')
			lF75	= PrepareSQLlogic(ThisForm.chkF751.Value,'F75')
			
			lSTK	= PrepareSQLlogic(ThisForm.chkSTK1.Value,'STK')
			lMK 	= PrepareSQLlogic(ThisForm.chkMK1.Value,'Make')
			
			cNotes	=  PrepareSQLtxt(ThisForm.Notes1.Value,'Notes',-1)
			nID 	= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
			
			PRIVATE nID_Sources
			nID_Sources	= PrepareSQLnum(ThisForm.ID_Sources1.Value ,'ID_Sources',-3)
			
			IF EMPTY( cAlloy + cAlloy_AKA + cUNS + cSpec )
				MESSAGEBOX("Need Alloy, UNS or Spec to save.",48,"Cannot Save")
				RETURN .F.
			ENDIF
			
			IF nID_Sources = 0
				*INSERT
				cSQL = "INSERT INTO dbo.Sources "
				cSQL = cSQL + "(Alloy, Alloy_AKA, UNS, Spec"
				cSQL = cSQL + ",F10, F20, F30, F40, F60, F65, F70, F75, STK, MK"
				cSQL = cSQL + ",Notes,ID) VALUES ("
		
				cSQL = cSQL + "'"+cAlloy+"'"
				cSQL = cSQL + ",'"+cAlloy_AKA+"'"
				cSQL = cSQL + ",'"+cUNS+"'"
				cSQL = cSQL + ",'"+cSpec+"'"
				
				cSQL = cSQL + ","+IIF(lF10,"1","0")
				cSQL = cSQL + ","+IIF(lF20,"1","0")
				cSQL = cSQL + ","+IIF(lF30,"1","0")
				cSQL = cSQL + ","+IIF(lF40,"1","0")
				cSQL = cSQL + ","+IIF(lF60,"1","0")
				cSQL = cSQL + ","+IIF(lF65,"1","0")
				cSQL = cSQL + ","+IIF(lF70,"1","0")
				cSQL = cSQL + ","+IIF(lF75,"1","0")
				cSQL = cSQL + ","+IIF(lSTK,"1","0")
				cSQL = cSQL + ","+IIF(lMK, "1","0")
				
				cSQL = cSQL + ",'"+cNotes+"'"
				cSQL = cSQL + ","+STR(nID)
				cSQL = cSQL + ")"
			ELSE
				*Update
				cSQL = "UPDATE dbo.Sources SET "
				cSQL = cSQL + " Alloy='"+cAlloy+"'"
				cSQL = cSQL + ",Alloy_AKA ='"+cAlloy_AKA+"'"
				cSQL = cSQL + ",UNS ='"+cUNS+"'"
				cSQL = cSQL + ",Spec ='"+cSpec+"'"
				
				cSQL = cSQL + ",F10 ="+IIF(lF10,"1","0")
				cSQL = cSQL + ",F20 ="+IIF(lF20,"1","0")
				cSQL = cSQL + ",F30 ="+IIF(lF30,"1","0")
				cSQL = cSQL + ",F40 ="+IIF(lF40,"1","0")
				cSQL = cSQL + ",F60 ="+IIF(lF60,"1","0")
				cSQL = cSQL + ",F65 ="+IIF(lF65,"1","0")
				cSQL = cSQL + ",F70 ="+IIF(lF70,"1","0")
				cSQL = cSQL + ",F75 ="+IIF(lF75,"1","0")
				cSQL = cSQL + ",STK ="+IIF(lSTK,"1","0")
				cSQL = cSQL + ",MK  ="+IIF(lMK, "1","0")
				
				cSQL = cSQL + ",Notes='"+ALLTRIM(cNotes)+"'"
				cSQL = cSQL + ",ID="+STR(nID)
				
				cSQL = cSQL + " WHERE ID_Sources ="+STR(nID_Sources)
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		
		
			ThisForm.cmdAlloyAdd.Enabled = .T.
			This.Caption = "Edit"
			ThisForm.cmdAlloyDelete.Caption = "Delete"
			
			Thisform.getSourceAlloys()
			SELECT tmpSources_Alloys
			LOCATE FOR Alloy = cAlloy
			ThisForm.getAlloyInfo()
			ThisForm.grdAlloys.Refresh
		
			
			ThisForm.Sources_Enabled(.F.)
			
		ENDIF
	ENDPROC

	PROCEDURE cmdContactAdd.Click
		This.Enabled = .F.
		ThisForm.cmdContactEdit.Caption = "Save"
		ThisForm.cmdContactDelete.Caption = "Abort"
		ThisForm.cmdDeDupe.Enabled = .F.
		
		*Clear Contacts
		ThisForm.ID1.Value	= 0
		ThisForm.Company1.Value	= ''
		ThisForm.Phone1.Value	= ''
		ThisForm.Fax1.Value	= ''
		ThisForm.Person1.Value	= ''
		ThisForm.Email.Value	= ''
		ThisForm.Email2.Value	= ''
		ThisForm.chkInActive.Value = 0
		
		ThisForm.SourcePH_Enabled(.T.)
	ENDPROC

	PROCEDURE cmdContactDelete.Click
		IF This.Caption = "Delete"
			*Delete
			PRIVATE nID, lGood
			nID = tmpSourcePH_Company.ID
			lGood = .T.
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.Sources "
			cSQL = cSQL + " WHERE ID="+STR(nID)
		
			IF USED("tmpCntSources")
				SELECT tmpCntSources
			ELSE
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntSources')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntSources')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSources")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSources")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCntSources')
				lGood = .F.
			ELSE
				IF USED("tmpCntSources")
					IF RECCOUNT('tmpCntSources') > 0
						PRIVATE nMess
						nMess = MESSAGEBOX("Found related records used in dbo.Sources!"+CHR(13)+"Do you still want to delete ALL?",4,"Delete?")
						IF nMess = 6
							cSQL = "DELETE FROM dbo.Sources "
							cSQL = cSQL + " WHERE ID="+STR(nID)
		
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
								lGood = .F.
							ELSE
		
		
							ENDIF
						ENDIF
					ENDIF
					USE IN tmpCntSources
					
				ENDIF			
			ENDIF
			
			IF lGood
				cSQL = "DELETE FROM dbo.SourcePH "
				cSQL = cSQL + " WHERE ID ="+STR(nID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					lGood = .F.
				ELSE
					*Good
				ENDIF
				
			ENDIF
		
			IF lGood 
				SELECT tmpSourcePH_Company
				IF NOT EOF()
					SKIP 1
				ELSE
					SKIP -1
				ENDIF
				
				PRIVATE cCompany
				cCompany = tmpSourcePH_Company.Company
				
				Thisform.getSourceCompanies()
				
				SELECT tmpSourcePH_Company
				LOCATE FOR Company = cCompany
				
				ThisForm.grdCompany.Refresh
				ThisForm.getSourceContact()
			ENDIF
		ELSE
			*Abort
			ThisForm.getSourceContact()
			
			ThisForm.cmdContactAdd.Enabled = .T.
			ThisForm.cmdContactEdit.Caption = "Edit"
			This.Caption = "Delete"
			ThisForm.cmdDeDupe.Enabled = .T.
			
			ThisForm.SourcePH_Enabled(.F.)
		ENDIF
	ENDPROC

	PROCEDURE cmdContactEdit.Click
		IF This.Caption = "Edit"
			*Edit the Contact
			
			ThisForm.cmdContactAdd.Enabled = .F.
			This.Caption = "Save"
			ThisForm.cmdContactDelete.Caption = "Abort"
			ThisForm.cmdDeDupe.Enabled = .F.
			
			ThisForm.SourcePH_Enabled(.T.)
		ELSE
			*Save Contact
			PRIVATE nID, cCompany, cPhone, cFax, cPerson, cEmail, cEmail2, lInActive
				
			nID 	= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
			cCompany=  PrepareSQLtxt(ThisForm.Company1.Value,'Company',30)
			cPhone	= PrepareSQLtxt(ThisForm.Phone1.Value,'Phone',10)
			cFax	= PrepareSQLtxt(ThisForm.Fax1.Value,'Fax',10)
			cPerson	= PrepareSQLtxt(ThisForm.Person1.Value,'Person',15)
			cEmail	= PrepareSQLtxt(ThisForm.Email.Value,'Email',60)
			cEmail2	= PrepareSQLtxt(ThisForm.Email2.Value,'Email2',60)
			lInActive = PrepareSQLlogic(ThisForm.chkINACTIVE.Value,'InActive')
			
			IF EMPTY( cCompany + cPerson + cEmail )
				MESSAGEBOX("Need Company, Person or Email to save.",48,"Cannot Save")
				RETURN .F.
			ENDIF
		
		
			IF nID = 0
				*INSERT
				cSQL = "INSERT INTO dbo.SourcePH "
				cSQL = cSQL + "(Company, Phone, Fax, Person, Email, Email2, InActive) VALUES "
				cSQL = cSQL + "("
				cSQL = cSQL + "'"+cCompany+"'"
				cSQL = cSQL + ",'"+cPhone+"'"
				cSQL = cSQL + ",'"+cFax+"'"
				cSQL = cSQL + ",'"+cPerson+"'"
				cSQL = cSQL + ",'"+cEmail+"'"
				cSQL = cSQL + ",'"+cEmail2+"'"
				cSQL = cSQL + ","+IIF(lInActive,"1","0")
				cSQL = cSQL + ")"
			ELSE
				*Update
				cSQL = "UPDATE dbo.SourcePH SET "
				cSQL = cSQL + " Company ='"+cCompany+"'"
				cSQL = cSQL + ",Phone ='"+cPhone+"'"
				cSQL = cSQL + ",Fax ='"+cFax+"'"
				cSQL = cSQL + ",Person ='"+cPerson+"'"
				cSQL = cSQL + ",Email ='"+cEmail+"'"
				cSQL = cSQL + ",Email2 ='"+cEmail2+"'"
				cSQL = cSQL + ",InActive ="+IIF(lInActive,"1","0")
				cSQL = cSQL + " WHERE ID ="+STR(nID)
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		
		
			ThisForm.cmdContactAdd.Enabled = .T.
			This.Caption = "Edit"
			ThisForm.cmdContactDelete.Caption = "Delete"
			ThisForm.cmdDeDupe.Enabled = .T.	
			
			ThisForm.SourcePH_Enabled(.F.)
			
			IF nID = 0
				*Added SourcePH
				IF USED('tmpSourcePHID')	
					USE IN tmpSourcePHID
				ENDIF
				
				SELECT 0
				
				cSQL = "SELECT ID FROM dbo.SourcePH WHERE "
				cSQL = cSQL + " Company ='"+cCompany+"'"
				cSQL = cSQL + " AND Phone ='"+cPhone+"'"
				cSQL = cSQL + " AND Fax ='"+cFax+"'"
				cSQL = cSQL + " AND Person ='"+cPerson+"'"
				cSQL = cSQL + " AND Email ='"+cEmail+"'"
				cSQL = cSQL + " AND Email2 ='"+cEmail2+"'"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSourcePHID')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSourcePHID')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSourcePHID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSourcePHID")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSourcePHID')
				ENDIF
				
				IF USED('tmpSourcePHID')	
					IF RECCOUNT('tmpSourcePHID') > 0
						PRIVATE nID
						nID = tmpSourcePHID.ID
						
						IF nID > 0
							ThisForm.getSourceCompanies()
							
							SELECT tmpSourcePH_Company
							LOCATE FOR ID = nID
							
							ThisForm.getSourceContact()
							
							Thisform.getSourceAlloys()
							ThisForm.grdCompany.Refresh					
						ENDIF 
					ENDIF
					USE IN tmpSourcePHID
				ENDIF
		
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdSearchCompany.Click
		PRIVATE cSearchCompany, nLen
		cSearchCompany = PrepareSQLtxt(ThisForm.txtSearchCompany.Value,'Company',30)
		cSearchCompany = ALLTRIM( cSearchCompany )
		nLen = LEN(cSearchCompany)
		
		IF NOT EMPTY(cSearchCompany) AND nLen > 0
			SELECT tmpSourcePH_Company
			
			PRIVATE nCurrRec
			nCurrRec = RECNO()
			
			LOCATE FOR UPPER(LEFT(cSearchCompany,nLen)) = UPPER(LEFT(Company,nLen))
			
			IF FOUND()
				ThisForm.grdCompany.Refresh
				ThisForm.getSourceContact()
			ELSE
				LOCATE FOR LEFT(UPPER(cSearchCompany),3) = LEFT(UPPER(ALLTRIM(Company)),3)
				
				IF FOUND()
					ThisForm.grdCompany.Refresh
					ThisForm.getSourceContact()
					WAIT WINDOW 'Not Found' NOWAIT
				ELSE
					WAIT WINDOW 'Not Found' NOWAIT
				ENDIF
			ENDIF
		ELSE
			WAIT WINDOW 'No Company' NOWAIT
		ENDIF
			
		
	ENDPROC

	PROCEDURE cmdViewAlloys.Click
		DO FORM Forms\AlloyStandard
	ENDPROC

	PROCEDURE cmdViewVendor.Click
		PRIVATE nID, cCompany, nVendCode
		nID 	= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		cCompany= PrepareSQLtxt(Thisform.Company1.Value,'Company',30)
		nVendCode = 0
		
		IF USED("tmpSourcePH_Contact")
			nVendCode = PrepareSQLnum(tmpSourcePH_Contact.VendCode,'VendCode',-3)
		ENDIF
		
			
		IF nVendCode > 0
			DO FORM Forms\Vendor WITH nVendCode, nID
		ELSE
			DO FORM Forms\Vendor WITH cCompany, nID
		ENDIF
		
		
		ThisForm.getVendorCompany()
		
		
	ENDPROC

	PROCEDURE grdAlloys.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.getAlloyInfo()
	ENDPROC

	PROCEDURE grdCompany.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.getSourceContact()
	ENDPROC

	PROCEDURE grdCompany.Valid
		ThisForm.getSourceContact()
	ENDPROC

	PROCEDURE txtSearchCompany.Valid
		IF NOT EMPTY( This.Value )
			ThisForm.cmdSearchCompany.Click
		ENDIF
		
	ENDPROC

ENDDEFINE
