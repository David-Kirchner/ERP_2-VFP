	PROCEDURE clearalloyinfo
		*ThisForm.clearAlloyInfo()
		ThisForm.ID_Sources1.Value = 0
		ThisForm.Alloy1.Value = ''
		ThisForm.Alloy_AKA1.Value = ''
		ThisForm.UNS1.Value = ''
		ThisForm.Spec1.Value = ''
		
		ThisForm.chkF101.Value	= 0
		ThisForm.chkF201.Value	= 0
		ThisForm.chkF301.Value	= 0
		ThisForm.chkF401.Value	= 0
		ThisForm.chkF601.Value	= 0
		ThisForm.chkF651.Value	= 0
		ThisForm.chkF701.Value	= 0
		ThisForm.chkF751.Value	= 0
		
		ThisForm.chkSTK1.Value	= 0
		ThisForm.chkMK1.Value	= 0
		
		ThisForm.Notes1.Value = ''
	ENDPROC

	PROCEDURE getalloyinfo
		*ThisForm.getAlloyInfo()
		
		PRIVATE nID_Sources
		nID_Sources	= tmpSources_Alloys.ID_Sources
		ThisForm.ID_Sources1.Value = nID_Sources
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.Sources "
		cSQL = cSQL + " WHERE ID_Sources = "+STR(nID_Sources)
		
		IF USED("tmpAlloy_Info")
			SELECT tmpAlloy_Info
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloy_Info')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloy_Info')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloy_Info")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloy_Info")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpAlloy_Info')
		ELSE
			IF USED("tmpAlloy_Info")
				IF RECCOUNT('tmpAlloy_Info') > 0
					ThisForm.ID_Sources1.Value	= tmpAlloy_Info.ID_Sources
					ThisForm.Alloy1.Value 		= tmpAlloy_Info.Alloy
					ThisForm.Alloy_AKA1.Value 	= tmpAlloy_Info.Alloy_AKA
					ThisForm.UNS1.Value 	= tmpAlloy_Info.UNS
					ThisForm.Spec1.Value 	= tmpAlloy_Info.Spec
					
					ThisForm.chkF101.Value	= tmpAlloy_Info.F10
					ThisForm.chkF201.Value	= tmpAlloy_Info.F20
					ThisForm.chkF301.Value	= tmpAlloy_Info.F30
					ThisForm.chkF401.Value	= tmpAlloy_Info.F40
					ThisForm.chkF601.Value	= tmpAlloy_Info.F60
					ThisForm.chkF651.Value	= tmpAlloy_Info.F65
					ThisForm.chkF701.Value	= tmpAlloy_Info.F70
					ThisForm.chkF751.Value	= tmpAlloy_Info.F75
					
					ThisForm.chkSTK1.Value	= tmpAlloy_Info.Stk
					ThisForm.chkMK1.Value	= tmpAlloy_Info.MK
					
					ThisForm.Notes1.Value 	= tmpAlloy_Info.Notes
					
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getsourcealloys
		*Thisform.getSourceAlloys()
		ThisForm.grdAlloys.RecordSource = ''
		
		PRIVATE nID
		nID	= tmpSourcePH_Company.ID
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT Alloy,ID_Sources FROM dbo.Sources "
		cSQL = cSQL + " WHERE ID = "+STR(nID)
		cSQL = cSQL + " ORDER BY Alloy"
		
		IF USED("tmpSources_Alloys")
			SELECT tmpSources_Alloys
			TABLEREVERT(.T.,'tmpSources_Alloys')  &&CURSORSETPROP is not used!, rewrite so this old command can be dropped
			*Table buffer for alias "" contains uncommitted changes..
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSources_Alloys')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSources_Alloys')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSources_Alloys")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSources_Alloys")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSources_Alloys')
			Thisform.clearAlloyInfo()
		ELSE
			IF USED("tmpSources_Alloys")
				IF RECCOUNT('tmpSources_Alloys') > 0
					ThisForm.grdAlloys.RecordSource = 'tmpSources_Alloys'
					ThisForm.getAlloyInfo()
				ELSE
					Thisform.clearAlloyInfo()
				ENDIF
			ELSE
				Thisform.clearAlloyInfo()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getsourcecompanies
		*Thisform.getSourceCompanies()
		ThisForm.grdCompany.RecordSource = ''
		*TrackMess( "Marked as 'Service Only' for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT Company,ID FROM dbo.SourcePH "
		cSQL = cSQL + " ORDER BY Company"
		
		IF USED("tmpSourcePH_Company")
			SELECT tmpSourcePH_Company
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSourcePH_Company')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSourcePH_Company')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSourcePH_Company")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSourcePH_Company")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSourcePH_Company')
		ELSE
			IF USED("tmpSourcePH_Company")
				IF RECCOUNT('tmpSourcePH_Company') > 0
					ThisForm.grdCompany.RecordSource = 'tmpSourcePH_Company'
					
					ThisForm.getSourceContact()
					
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getsourcecontact
		*ThisForm.getSourceContact()
		PRIVATE cCompany, nID
		cCompany = tmpSourcePH_Company.Company
		nID	= tmpSourcePH_Company.ID
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.SourcePH "
		cSQL = cSQL + " WHERE ID="+STR(nID)
		
		IF USED("tmpSourcePH_Contact")
			SELECT tmpSourcePH_Contact
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSourcePH_Contact')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSourcePH_Contact')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSourcePH_Company")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSourcePH_Company")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSourcePH_Contact')
		ELSE
			IF USED("tmpSourcePH_Contact")
				IF RECCOUNT('tmpSourcePH_Contact') > 0
				
					ThisForm.ID1.Value		= PrepareSQLnum(tmpSourcePH_Contact.ID,'ID',-3)
					ThisForm.Company1.Value	= PrepareSQLtxt(tmpSourcePH_Contact.Company,'Company',30)
					ThisForm.Phone1.Value	= PrepareSQLtxt(tmpSourcePH_Contact.Phone,'Phone',10)
					ThisForm.Fax1.Value		= PrepareSQLtxt(tmpSourcePH_Contact.Fax,'Fax',10)
					ThisForm.Person1.Value	= PrepareSQLtxt(tmpSourcePH_Contact.Person,'Person',15)
					ThisForm.Email.Value	= PrepareSQLtxt(tmpSourcePH_Contact.Email,'Email',60)
					ThisForm.Email2.Value	= PrepareSQLtxt(tmpSourcePH_Contact.Email2,'Email2',60)
					ThisForm.chkINACTIVE.Value = PrepareSQLchk(tmpSourcePH_Contact.InActive,'InActive')
					
					ThisForm.getVendorCompany()
					ThisForm.getSourceAlloys()
					
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getvendorcompany
		*ThisForm.getVendorCompany
		
		ThisForm.vCompany.Value = ''
		PRIVATE nVendCode
		nVendCode = PrepareSQLnum(tmpSourcePH_Contact.VendCode,'VendCode',-3)
		
		IF nVendCode > 0
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT Company FROM dbo.Vendor "
			cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode )
		
			IF USED("tmpVendComp")
				SELECT tmpVendComp
			ELSE
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendComp')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendComp')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendComp")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendComp")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpVendComp')
			ELSE
				IF USED("tmpVendComp")
					IF RECCOUNT('tmpVendComp') > 0
						ThisForm.vCompany.Value = PrepareSQLtxt(tmpVendComp.Company,'Company',30)		
					ENDIF
					USE IN tmpVendComp
				ENDIF
			ENDIF
			
		ENDIF	
	ENDPROC

	PROCEDURE Init
		*Init
		*DO FORM Forms\SourceCompany
		ThisForm.getSourceCompanies()
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		
	ENDPROC

