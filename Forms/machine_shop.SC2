	PROCEDURE frmSelectSOitem.cmdAddSOitm.Click
		PRIVATE cSOitem,cHPAlot,cHeat 
		cSOitem = ThisForm.txtSOitem.Value
		cHPAlot	= "" &&tmpSOshop.
		cHeat = tmpSOshop.Heat
		
		PRIVATE nHPAlot,cHeat,cAlloy,nAllQuotes_ID
		PRIVATE cStart_Form,cStart_CC,nStart_PC,nStart_Sz1,nStart_Sz2,nStart_Sz3,nStart_Pounds
		PRIVATE cFinish_Form,cFinish_CC,nFinish_PC,nFinish_Sz1,nFinish_Sz2,nFinish_Sz3,nFinish_Pounds
		PRIVATE lStart, lComplete, lCancelled
		
		nAllQuotes_ID = 0
		cAlloy		= ''
		cStart_Form	= ''
		cStart_CC	= '1'
		nStart_PC	= 0
		nStart_Sz1	= 0
		nStart_Sz2	= 0
		nStart_Sz3	= 0
		nStart_Pounds = 0
				
		cFinish_CC	= '1'
		cFinish_Form = ''
		nFinish_PC	= 0
		nFinish_Sz1	= 0
		nFinish_Sz2	= 0
		nFinish_Sz3	= 0
		nFinish_Pounds = 0
		
		lStart = .F.
		lComplete = .F.
		lCancelled = .F.
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpAQ')
			USE IN tmpAQ
		ENDIF
		
		SELECT 0
		cSQL = "SELECT Alloy, ID, Form, CC, Pieces, Thck, Sz2, Sz3, Weight "
		cSQL = cSQL + " FROM dbo.AllQuotes WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAQ')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAQ')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpAQ')
		ENDIF
		IF USED('tmpAQ')
			IF RECCOUNT('tmpAQ') > 0
				cAlloy		= PrepareSQLtxt(tmpAQ.Alloy,'Alloy',12)
				nAllQuotes_ID = PrepareSQLnum(tmpAQ.ID,'AllQuotes_ID',-3)
				cStart_Form	= PrepareSQLtxt(tmpAQ.Form,'Form',2)
				cStart_CC	= PrepareSQLtxt(tmpAQ.CC,'CC',1)
				nStart_PC	= PrepareSQLnum(tmpAQ.Pieces,'Pieces',-3)
				nStart_Sz1	= PrepareSQLnum(tmpAQ.Thck,'Thck',10,4)
				nStart_Sz2	= PrepareSQLnum(tmpAQ.Sz2,'Sz2',9,4)
				nStart_Sz3	= PrepareSQLnum(tmpAQ.Sz3,'Sz3',9,4)
				nStart_Pounds = PrepareSQLnum(tmpAQ.Weight,'Weight',7,1)
				
				cFinish_Form= PrepareSQLtxt(tmpAQ.Form,'Form',2)
				cFinish_CC	= PrepareSQLtxt(tmpAQ.CC,'CC',1)
				nFinish_PC	= PrepareSQLnum(tmpAQ.Pieces,'Pieces',-3)
				nFinish_Sz1	= PrepareSQLnum(tmpAQ.Thck,'Thck',10,4)
				nFinish_Sz2	= PrepareSQLnum(tmpAQ.Sz2,'Sz2',9,4)
				nFinish_Sz3	= PrepareSQLnum(tmpAQ.Sz3,'Sz3',9,4)
				nFinish_Pounds = PrepareSQLnum(tmpAQ.Weight,'Weight',7,1)
			ENDIF
			USE IN tmpAQ
		ENDIF
		
		IF nAllQuotes_ID = 0
			MESSAGEBOX("Could not retrieve the quote!",0,"Error")
			RETURN .f.
		ENDIF
		
		IF nAllQuotes_ID  > 0
			IF USED('tmpAQss')
				USE IN tmpAQss
			ENDIF
		
			SELECT 0
			cSQL = "SELECT Alloy, Form, CC, Pieces, Thck, Sz2, Sz3, Weight "
			cSQL = cSQL + " FROM dbo.StartingStock WHERE AllQuotes_ID ="+ALLTRIM(STR(nAllQuotes_ID))
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAQss')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAQss')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpAQss')
			ENDIF
			
			IF USED('tmpAQss')
				IF RECCOUNT('tmpAQss') > 0
		*			cAlloy		= PrepareSQLtxt(tmpAQss.Alloy,'Alloy',12)
		*			nAllQuotes_ID = PrepareSQLnum(tmpAQss.AllQuotes_ID,'AllQuotes_ID',-3)
					cStart_Form	= PrepareSQLtxt(tmpAQss.Form,'Form',2)
					cStart_CC	= PrepareSQLtxt(tmpAQss.CC,'CC',1)
					nStart_PC	= PrepareSQLnum(tmpAQss.Pieces,'Pieces',-3)
					nStart_Sz1	= PrepareSQLnum(tmpAQss.Thck,'Thck',10,4)
					nStart_Sz2	= PrepareSQLnum(tmpAQss.Sz2,'Sz2',9,4)
					nStart_Sz3	= PrepareSQLnum(tmpAQss.Sz3,'Sz3',9,4)
					nStart_Pounds = PrepareSQLnum(tmpAQss.Weight,'Weight',7,1)
		
				ENDIF
				USE IN tmpAQss
			ENDIF
			
		ENDIF
		
		
		
		IF USED('tmpMach_Shop')
			USE IN tmpMach_Shop
		ENDIF
		
		SELECT 0
		
		cSQL = "INSERT INTO dbo.Mach_Shop "
		cSQL = cSQL + "("
		cSQL = cSQL + "SOitem"
		cSQL = cSQL + ",HPAlot"
		cSQL = cSQL + ",Heat"
		cSQL = cSQL + ",Alloy"
		cSQL = cSQL + ",AllQuotes_ID"
		cSQL = cSQL + ",Start_Form"
		cSQL = cSQL + ",Start_CC"
		cSQL = cSQL + ",Start_PC"
		cSQL = cSQL + ",Start_Sz1"
		cSQL = cSQL + ",Start_Sz2"
		cSQL = cSQL + ",Start_Sz3"
		cSQL = cSQL + ",Start_Pounds"
		cSQL = cSQL + ",Finish_Form"
		cSQL = cSQL + ",Finish_CC"
		cSQL = cSQL + ",Finish_PC"
		cSQL = cSQL + ",Finish_Sz1"
		cSQL = cSQL + ",Finish_Sz2"
		cSQL = cSQL + ",Finish_Sz3"
		cSQL = cSQL + ",Finish_Pounds"
		cSQL = cSQL + ",[Start]"
		cSQL = cSQL + ",[Complete]"
		cSQL = cSQL + ",[Cancelled]"
		      
		cSQL = cSQL + ") VALUES ("
		
		cSQL = cSQL + " '"+cSOitem+"'"
		cSQL = cSQL + ",'"+cHPAlot+"'"
		cSQL = cSQL + ",'"+cHeat+"'"
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ","+STR(nAllQuotes_ID)
		
		cSQL = cSQL + ",'"+cStart_Form+"'"
		cSQL = cSQL + ",'"+cStart_CC+"'"
		cSQL = cSQL + ","+STR(nStart_PC)
		cSQL = cSQL + ","+STR(nStart_Sz1,10,4)
		cSQL = cSQL + ","+STR(nStart_Sz2,9,3)
		cSQL = cSQL + ","+STR(nStart_Sz3,9,3)
		cSQL = cSQL + ","+STR(nStart_Pounds,7,1)
		
		cSQL = cSQL + ",'"+cFinish_Form+"'"
		cSQL = cSQL + ",'"+cStart_CC+"'"
		cSQL = cSQL + ","+STR(nFinish_PC)
		cSQL = cSQL + ","+STR(nFinish_Sz1,10,4)
		cSQL = cSQL + ","+STR(nFinish_Sz2,9,3)
		cSQL = cSQL + ","+STR(nFinish_Sz3,9,3)
		cSQL = cSQL + ","+STR(nFinish_Pounds,7,1)
		
		cSQL = cSQL + ","+IIF(lStart,"1","0")
		cSQL = cSQL + ","+IIF(lComplete,"1","0")
		cSQL = cSQL + ","+IIF(lCancelled,"1","0")
		
		cSQL = cSQL + ")"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMach_Shop')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpMach_Shop')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpMach_Shop')
		ELSE	
			ThisForm.Visible = .F.
			ThisFormset.frmProduction.Visible = .T.
			
			*ThisForm.Refresh_SO(1)
			ThisFormSet.Refresh_ProdSchd(cSOitem)
		ENDIF
		
	ENDPROC

	PROCEDURE frmSelectSOitem.cmdQuit.Click
		ThisForm.Visible = .F.
		
	ENDPROC

	PROCEDURE frmSelectSOitem.grdSOshop.AfterRowColChange
		LPARAMETERS nColIndex
		ThisFormSet.SOShopRefresh()
		
	ENDPROC

	PROCEDURE frmSelectSOitem.grdSOshopRemove.AfterRowColChange
		LPARAMETERS nColIndex
		ThisFormSet.SOShopRefresh()
		
	ENDPROC

ENDDEFINE
