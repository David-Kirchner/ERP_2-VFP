		ThisFormset.frmEditDetail.txtFinish_PC.ReadOnly = .T.
		ThisFormset.frmEditDetail.txtFinish_LBS.ReadOnly = .T.
		
		ThisFormSet.frmEditDetail.txtFinish_Sz1.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtFinish_Sz2.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtFinish_Sz3.ReadOnly = .T.
		
		ThisFormSet.frmEditDetail.cmdAdd.Visible = .T.
		ThisFormSet.frmEditDetail.cmdEdit.Caption = "Edit"
		ThisFormSet.frmEditDetail.cmdDelete.Caption = "Delete"
		ThisFormSet.frmEditDetail.cmdClose.Visible = .T.
		ThisFormSet.frmEditDetail.lstMSDetail.Visible = .T.
		
		
	ENDPROC

	PROCEDURE prodschdrefresh		&& Move in Grd
		*ProdSchdRefresh()
		
		IF USED('tmpProdSchd')
			ThisFormset.frmProduction.txtMach_Shop_ID.Value	= PrepareSQLnum(tmpProdSchd.ID,'ID',-3)
			ThisFormset.frmProduction.txtSOitem.Value		= PrepareSQLtxt(tmpProdSchd.SOitem,'SOitem',10)
			ThisFormset.frmProduction.txtAlloy.Value		= PrepareSQLtxt(tmpProdSchd.Alloy,'Alloy',12)
			ThisFormset.frmProduction.txtCompany.Value		= PrepareSQLtxt(tmpProdSchd.Company,'Company',30)
			
			ThisFormset.frmProduction.txtHeat.Value			= PrepareSQLtxt(tmpProdSchd.Heat,'Heat',50)
			ThisFormset.frmProduction.txtHPAlot.Value		= PrepareSQLtxt(tmpProdSchd.HPAlot,'HPAlot',11)
			
		*!*	*AllQuotes_ID
			ThisFormset.frmProduction.txtStart_CC.Value		= PrepareSQLtxt(tmpProdSchd.Start_CC,'CC',1)
			ThisFormset.frmProduction.txtStart_Form.Value	= PrepareSQLtxt(tmpProdSchd.Start_Form,'Form',2)
			ThisFormset.frmProduction.txtStart_PC.Value		= PrepareSQLnum(tmpProdSchd.Start_PC,'PC',-3)
			ThisFormset.frmProduction.txtStart_LBS.Value	= PrepareSQLnum(tmpProdSchd.Start_Pounds,'Pounds',7,1)
			
			ThisFormset.frmProduction.txtStart_Desc.Value	= PrepareSQLtxt(tmpProdSchd.Start_Desc,'Desc',-1)
		
		*!*	Start_Sz1
		*!*	Start_Sz2
		*!*	Start_Sz3
			ThisFormset.frmProduction.txtFinish_CC.Value	= PrepareSQLtxt(tmpProdSchd.Finish_CC,'CC',1)
			ThisFormset.frmProduction.txtFinish_Form.Value	= PrepareSQLtxt(tmpProdSchd.Finish_Form,'Form',2)
			ThisFormset.frmProduction.txtFinish_PC.Value	= PrepareSQLnum(tmpProdSchd.Finish_PC,'PC',-3)
			ThisFormset.frmProduction.txtFinish_LBS.Value	= PrepareSQLnum(tmpProdSchd.Finish_Pounds,'Pounds',7,1)
		
			ThisFormset.frmProduction.txtFinish_Desc.Value	= PrepareSQLtxt(tmpProdSchd.Finish_Desc,'Desc',-1)
		*!*	Finish_Sz1
		*!*	Finish_Sz2
		*!*	Finish_Sz3
			
			ThisFormSet.frmProduction.chkStart.Value		= PrepareSQLchk(tmpProdSchd.Start,'Start')
			ThisFormSet.frmProduction.chkComplete.Value		= PrepareSQLchk(tmpProdSchd.Complete,'Complete')
			ThisFormSet.frmProduction.chkCancelled.Value	= PrepareSQLchk(tmpProdSchd.Cancelled,'Cancelled')
		
			ThisFormSet.Refresh_lstMSDetail()
				
		ENDIF
		
	ENDPROC

	PROCEDURE refresh_lstmsdetail
		*ThisFormSet.Refresh_lstMSDetail()
		
		*Fills lstMSDetail
		ThisFormSet.frmProduction.lstMSDetail.Clear
		ThisFormSet.frmEditDetail.lstMSDetail.Clear
		
		PRIVATE nMach_Shop_ID
		nMach_Shop_ID	= tmpProdSchd.ID
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpMSDetail')
			USE IN  tmpMSDetail
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT ProcNum, Mach_Type"
		*cSQL = cSQL + ",Machine,Start,Finish"
		cSQL = cSQL + ",ID_Detail "
		cSQL = cSQL + " FROM dbo.Mach_Detail "
		cSQL = cSQL + " WHERE Mach_Shop_ID = "+STR(nMach_Shop_ID)
		*cSQL = cSQL + " WHERE ISNULL(Mach_Shop.Cancelled,0)=0 "
		*cSQL = cSQL + " AND ISNULL(Mach_Shop.Complete,0)=0 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMSDetail')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpMSDetail')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpMSDetail')
		ENDIF
		
		ThisFormSet.frmProduction.lstMSDetail.Visible = .F.	
		
		IF USED('tmpMSDetail')
			IF RECCOUNT('tmpMSDetail') > 0
				ThisFormSet.frmProduction.lstMSDetail.Visible = .T.	
				ThisFormSet.frmEditDetail.lstMSDetail.Visible = .T.	
				
				PRIVATE nProcNum
				nProcNum = tmpMSDetail.ProcNum
				
				SCAN
				
					ThisFormSet.frmProduction.lstMSDetail.AddItem(STR(tmpMSDetail.ProcNum))
					ThisFormSet.frmProduction.lstMSDetail.List[ThisFormSet.frmProduction.lstMSDetail.NewIndex, 2] = (tmpMSDetail.Mach_Type)
					ThisFormSet.frmProduction.lstMSDetail.List[ThisFormSet.frmProduction.lstMSDetail.NewIndex, 3] = STR(tmpMSDetail.ID_Detail)
					
					ThisFormSet.frmEditDetail.lstMSDetail.AddItem(STR(tmpMSDetail.ProcNum))
					ThisFormSet.frmEditDetail.lstMSDetail.List[ThisFormSet.frmProduction.lstMSDetail.NewIndex, 2] = (tmpMSDetail.Mach_Type)
					ThisFormSet.frmEditDetail.lstMSDetail.List[ThisFormSet.frmProduction.lstMSDetail.NewIndex, 3] = STR(tmpMSDetail.ID_Detail)
					
				ENDSCAN
				
				ThisFormSet.frmProduction.lstMSDetail.Value = STR(nProcNum)
				ThisFormSet.frmEditDetail.lstMSDetail.Value = STR(nProcNum)
				
				ThisFormSet.Refresh_Machine_Detail()
				
				ThisFormSet.frmProduction.txtMach_Detail_ID.Value = STR(nProcNum)
			ENDIF
				
			USE IN tmpMSDetail
		ENDIF
		
		
	ENDPROC

	PROCEDURE refresh_machine_detail
		*ThisFormSet.Refresh_Machine_Detail()
		PRIVATE nMach_Shop_ID
		nMach_Shop_ID = PrepareSQLnum(ThisFormSet.frmProduction.txtMach_Shop_ID.Value,'Mach_Shop_ID',-3)
		ThisFormSet.frmEditDetail.txtMach_Shop_ID.Value = nMach_Shop_ID 
		
		IF nMach_Shop_ID = 0
			RETURN .F.
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpMach_Detail')
			USE IN tmpMach_Detail
		ENDIF
		
		SELECT 0
		
		cSQL = " SELECT "
		cSQL = cSQL + "  * "
		cSQL = cSQL + ",dbo.f_ItemDescription(Start_Form ,Start_Sz1 ,Start_Sz2 ,Start_Sz3 ,Start_Pounds ,0) AS Start_Desc"
		cSQL = cSQL + ",dbo.f_ItemDescription(Finish_Form,Finish_Sz1,Finish_Sz2,Finish_Sz3,Finish_Pounds,0) AS Finish_Desc"
		cSQL = cSQL + " FROM dbo.Mach_Detail "
		cSQL = cSQL + " WHERE Mach_Shop_ID = "+STR(nMach_Shop_ID)
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMach_Detail')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpMach_Detail')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpMach_Detail')
		ENDIF
		
		IF USED('tmpMach_Detail')
			IF RECCOUNT('tmpMach_Detail') > 0
				*ThisFormSet.frmEditDetail.lstMSDetail.Value
				*Start_Date,Start_Who
						
				ThisFormSet.frmEditDetail.txtID_Detail.Value	= PrepareSQLnum(tmpMach_Detail.ID_Detail,'ID_Detail',-3)
				ThisFormSet.frmEditDetail.txtMach_Shop_ID.Value	= PrepareSQLnum(tmpMach_Detail.Mach_Shop_ID,'Mach_Shop_ID',-3)
				ThisFormSet.frmEditDetail.txtSOitem.Value		= PrepareSQLtxt(tmpMach_Detail.SOitem,'SOitem',10)
				ThisFormSet.frmEditDetail.txtProcNum.Value		= PrepareSQLnum(tmpMach_Detail.ProcNum,'ProcNum',-2)
