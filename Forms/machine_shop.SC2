	PROCEDURE frmProduction.cmdEditDetail.Click
		
		PRIVATE nMach_Shop_ID
		nMach_Shop_ID = PrepareSQLnum(ThisFormSet.frmProduction.txtMach_Shop_ID.Value,'Mach_Shop_ID',-3)
		PRIVATE lReturn
		lReturn = .t.
		
		IF nMach_Shop_ID > 0
		
			PRIVATE cSQL, nSQLEXEC 
		
			IF USED('cntMach_Detail')
				USE IN cntMach_Detail
			ENDIF
		
			SELECT 0
		
			cSQL = " SELECT COUNT(*) AS CNT "
			cSQL = cSQL + " FROM dbo.Mach_Detail "
			cSQL = cSQL + " WHERE Mach_Shop_ID = "+STR(nMach_Shop_ID)
		
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntMach_Detail')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntMach_Detail')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntMach_Detail')
			ENDIF
		
			IF USED('cntMach_Detail')
				IF RECCOUNT('cntMach_Detail') > 0
					IF cntMach_Detail.Cnt = 0
						
						lReturn = ThisFormSet.Mach_Detail_Add()
		
					ENDIF
				ENDIF
				USE IN cntMach_Detail
			ENDIF
		ELSE
			lReturn = ThisFormSet.Mach_Detail_Add()
		ENDIF
		
		ThisFormSet.Refresh_Machine_Detail()
		ThisFormSet.frmEditDetail.Visible = .T.
		ThisForm.Visible = .F.
		ThisformSet.frmEditDetail.lstMSDetail.SetFocus
	ENDPROC

	PROCEDURE frmProduction.cmdQuit.Click
		ThisForm.Visible = .F.
		
	ENDPROC

