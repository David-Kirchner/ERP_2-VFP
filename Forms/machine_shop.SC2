	ENDPROC

	PROCEDURE refresh_prodschd
		PARAMETERS cSOitem
		*Refresh_ProdSchd()
		
		
		PRIVATE cSQL, nSQLEXEC 
		ThisFormset.frmProduction.grdMach_Shop.RecordSource = ''
		
		IF USED('tmpProdSchd')
			USE IN tmpProdSchd
		ENDIF
		
		SELECT 0
		
		cSQL = " SELECT "
		cSQL = cSQL + " Mach_Shop.ID"
		cSQL = cSQL + ",Mach_Shop.SOitem"
		cSQL = cSQL + ",Mach_Shop.HPAlot"
		cSQL = cSQL + ",AQ.Company"
		cSQL = cSQL + ",dbo.f_ItemDescription(Start_Form,Start_Sz1,Start_Sz2,Start_Sz3,Start_Pounds,0) AS Start_Desc"
		cSQL = cSQL + ",dbo.f_ItemDescription(Finish_Form,Finish_Sz1,Finish_Sz2,Finish_Sz3,Finish_Pounds,0) AS Finish_Desc"
		
		cSQL = cSQL + ",Mach_Shop.Start"
		cSQL = cSQL + ",Mach_Shop.Complete"
		cSQL = cSQL + ",Mach_Shop.Cancelled"
		
		cSQL = cSQL + ",Start_Form,Start_CC,Start_PC"
		cSQL = cSQL + ",Start_Sz1"
		cSQL = cSQL + ",Start_Sz2"
		cSQL = cSQL + ",Start_Sz3"
		cSQL = cSQL + ",Start_Pounds"
		
		cSQL = cSQL + ",Finish_Form,Finish_CC,Finish_PC"
		cSQL = cSQL + ",Finish_Sz1"
		cSQL = cSQL + ",Finish_Sz2"
		cSQL = cSQL + ",Finish_Sz3"
		cSQL = cSQL + ",Finish_Pounds"
		
		cSQL = cSQL + ",Mach_Shop.Heat"
		cSQL = cSQL + ",Mach_Shop.Alloy"
		cSQL = cSQL + ",AllQuotes_ID"
		
		cSQL = cSQL + " FROM dbo.Mach_Shop "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AllQuotes AQ ON AQ.ID = Mach_Shop.AllQuotes_ID"
		cSQL = cSQL + " WHERE ISNULL(Mach_Shop.Cancelled,0)=0 "
		cSQL = cSQL + " AND ISNULL(Mach_Shop.Complete,0)=0 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProdSchd')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpProdSchd')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProdSchd')
		ENDIF
		
		IF USED('tmpProdSchd')
			*GOTO nRecNo IN tmpSOshop
			IF VARTYPE(cSOitem)="C"
				IF cSOitem = Proper_SO_Item(cSOitem)
					LOCATE FOR SOitem = cSOitem 
				ENDIF
			ENDIF
			ThisFormSet.frmProduction.grdMach_Shop.RecordSource= 'tmpProdSchd'
			
			ThisFormSet.ProdSchdRefresh()
		
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE refresh_so
		PARAMETERS nRecNo
		*ThisFormSet.Refresh_SO
		
		*INIT passes 0, Insert passes 1, others are exact RecNo
		
		PRIVATE cSQL, nSQLEXEC 
		IF VARTYPE(nRecNo) != "N"
			nRecNo = 1
		ENDIF
		
		IF nRecNo > 0
			ThisFormset.frmSelectSOitem.grdSOshop.RecordSource = ''
		ENDIF
		
		IF USED('tmpSOshop')
			USE IN tmpSOshop
		ENDIF
		
		SELECT 0
		
		cSQL = " SELECT "
		cSQL = cSQL + "  A.Soitem, A.Alloy, A.ID, A.Company"
		cSQL = cSQL + " ,S.inv,S.gfm,S.roll,S.press,S.mach,S.cg,S.plasma,S.WJet,S.cert"
		
		cSQL = cSQL + " ,S.shipdue,S.shipped "
		
		cSQL = cSQL + ",S.matlwt "
		cSQL = cSQL + " ,S.cncld,S.cmplt"
		cSQL = cSQL + " FROM dbo.AllQuotes A "
		cSQL = cSQL + " INNER JOIN dbo.Sales S ON A.SOitem = S.SOitem "
		cSQL = cSQL + " WHERE ( ISNULL(S.GFM,0)=1" 
		cSQL = cSQL + " OR ISNULL(S.Roll,0)=1"
		cSQL = cSQL + " OR ISNULL(S.Press,0)=1"
		cSQL = cSQL + " OR ISNULL(S.Mach,0)=1"
		cSQL = cSQL + " OR ISNULL(S.CG,0)=1"
		*cSQL = cSQL + " OR ISNULL(S.Plasma,0)=1"
		*cSQL = cSQL + " OR ISNULL(S.WJ,0)=1 "
		cSQL = cSQL + ")"
		cSQL = cSQL + " AND ISNULL(S.Cncld,0)=0 "
		cSQL = cSQL + " AND ISNULL(S.Cmplt,0)=0 "
		cSQL = cSQL + " AND A.SOitem NOT IN (SELECT SOitem FROM dbo.Mach_Shop WHERE [Complete] = 0 AND [Cancelled]=0 )"
		cSQL = cSQL + " ORDER BY A.SalesNum, A.Item "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOshop')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOshop')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOshop')
		ENDIF
		
		IF USED('tmpSOshop')
			IF nRecNo <= RECCOUNT('tmpSOshop')
				IF nRecNo = 0
					nRecNo = 1
				ENDIF
				GOTO nRecNo IN tmpSOshop
			ENDIF
			ThisFormset.frmSelectSOitem.grdSOshop.RecordSource = 'tmpSOshop'
			
			ThisFormSet.SOShopRefresh()
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE soshoprefresh
		*ThisFormSet.SOShopRefresh
		
		IF USED('tmpSOshop')
			ThisFormset.frmSelectSOitem.txtSOitem.Value = tmpSOshop.SOitem
			ThisFormset.frmSelectSOitem.txtAlloy.Value	= tmpSOshop.Alloy
			ThisFormset.frmSelectSOitem.txtCompany.Value = tmpSOshop.Company
			
		ENDIF
	ENDPROC

	PROCEDURE Unload
		
		IF USED("PurchaseOrder")
			USE IN PurchaseOrder
		ENDIF
		
		= SQLDISCONNECT(ThisFormSet.nConnHandle)
	ENDPROC

	PROCEDURE frmEditDetail.cmbFinish_CC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		*this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = Quotes.CC
		
		
	ENDPROC

	PROCEDURE frmEditDetail.cmbFinish_CC.Valid
		*!*	*RowSource=10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
		*!*	PRIVATE nTHCK, cForm
		*!*	nTHCK = This.parent.txtThck.Value
		*!*	cForm = This.Value
		
		*!*	*IF TYPE('nthck') = "N" AND TYPE('cForm')="C"
		*!*	*	IF nthck > 0 AND nthck < .125 AND cForm = "40"
		*!*	*		This.Parent.chkSPS1.Value = 1
		*!*	*	ENDIF
		*!*	*ENDIF
		
		*!*	ThisFormSet.RefreshQuotesForms( This.Value )
	ENDPROC

	PROCEDURE frmEditDetail.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			USE IN FormCode
		ENDIF
		
		SELECT 0
		
		*this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
		
			IF RECCOUNT('FormCode') = 0
				*Load again
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
				ENDDO
			ENDIF
			
			IF RECCOUNT('FormCode') = 0
				SELECT '' AS FormNumber,'' AS FormDescription FROM FormCode INTO ARRAY aFormCode
			ELSE
				SELECT FormNumber,FormDescription FROM FormCode INTO ARRAY aFormCode
			ENDIF
				
			
			USE IN FormCode
		ENDIF
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		
		This.ColumnCount = 2
		This.NumberOfElements = nArrayCount
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE frmEditDetail.cmbForm.Valid
		*!*	*RowSource=10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
		*!*	PRIVATE nTHCK, cForm
