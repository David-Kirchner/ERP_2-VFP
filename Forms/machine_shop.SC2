		ThisFormSet.frmEditDetail.chkStart.ReadOnly = .T.
		
		ThisFormset.frmEditDetail.cmbStart_CC.Visible = .F.
		ThisFormset.frmEditDetail.txtStart_CC.ReadOnly = .T.
		ThisFormset.frmEditDetail.txtStart_Form.ReadOnly = .T.
		ThisFormset.frmEditDetail.txtStart_PC.ReadOnly = .T.
		ThisFormset.frmEditDetail.txtStart_LBS.ReadOnly = .T.
		
		ThisFormSet.frmEditDetail.txtStart_Sz1.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtStart_Sz2.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtStart_Sz3.ReadOnly = .T.
		
