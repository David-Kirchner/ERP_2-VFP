	PROCEDURE Init
		PARAMETER cSOitem
		*Do Form Forms\Forge WITH '  80522-01'
		
		SET PRINTER TO DEFAULT
		
		
		************************************************************
		
		ThisFormSet.Refresh_SO(0)
		
		
		*****************************************************************
		PRIVATE cSQL, nSQLEXEC 
		IF USED("tmpMach_Type")
			USE IN tmpMach_Type
		ENDIF
		SELECT 0
		cSQL = "SELECT DISTINCT Mach_Type FROM dbo.Mach_Type ORDER BY Mach_Type"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMach_Type')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpMach_Type')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSales_No')
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF USED('tmpMach_Type')
			SELECT tmpMach_Type
			*COPY TO ARRAY aShipRoutes FIELDS ShipRoute
			*SELECT ShipRoute FROM aSales_No INTO ARRAY aShipRoutes
			USE IN tmpMach_Type
		ELSE
			aShipRoutes(1) = ""
		ENDIF
		
		
		*WAIT WINDOW "Get from Sales_No" NOWAIT
		
		*!*	IF USED("aSalesNum")
		*!*		USE IN aSalesNum
		*!*	ENDIF
		*!*	SELECT 0
		*!*	cSQL = "SELECT * FROM dbo.Sales_No WHERE Salesnum = "+STR(nSalesnum)
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSalesNum')
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSalesNum')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSalesNum')
		*!*	ENDIF
		
		
		*ThisFormSet.ItemNumber = SalesQuote.ITEM_A
		
		*ThisFormSet.frmPO.Visible = .F.
		*ThisFormSet.frmPO.Left	= ThisFormSet.frmEO.Left+6
		*ThisFormSet.frmPO.Top	= ThisFormSet.frmEO.Top + 60
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisForm.ConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.ConnHandle < 1
			*try again
			ThisForm.ConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		
	ENDPROC

	PROCEDURE mach_detail_abort
		*lReturn = ThisFormSet.Mach_Detail_Abort()
		
		*ThisFormSet.frmEditDetail.txtID_Detail
		*ThisFormSet.frmEditDetail.txtMach_Shop_ID
		*ThisFormSet.frmEditDetail.txtSOitem
		ThisFormSet.frmEditDetail.txtProcNum.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtMachine.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtMach_Type.ReadOnly = .T.
		
		ThisFormSet.frmEditDetail.chkStart.ReadOnly = .T.
		ThisFormset.frmEditDetail.cmbStart_CC.Visible = .F.
		*ThisFormset.frmEditDetail.txtStart_CC.ReadOnly = .T.   &&Always ReadOnly
		ThisFormset.frmEditDetail.txtStart_Form.ReadOnly = .T.
		ThisFormset.frmEditDetail.txtStart_PC.ReadOnly = .T.
		ThisFormset.frmEditDetail.txtStart_LBS.ReadOnly = .T.
		
		ThisFormSet.frmEditDetail.txtStart_Sz1.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtStart_Sz2.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtStart_Sz3.ReadOnly = .T.
		
		ThisFormSet.frmEditDetail.chkFinish.ReadOnly = .T.
		ThisFormset.frmEditDetail.cmbFinish_CC.Visible = .F.
		*ThisFormset.frmEditDetail.txtFinish_CC.ReadOnly = .T.  &&Always ReadOnly
		ThisFormset.frmEditDetail.txtFinish_Form.ReadOnly = .T.
		ThisFormset.frmEditDetail.txtFinish_PC.ReadOnly = .T.
		ThisFormset.frmEditDetail.txtFinish_LBS.ReadOnly = .T.
		
		ThisFormSet.frmEditDetail.txtFinish_Sz1.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtFinish_Sz2.ReadOnly = .T.
		ThisFormSet.frmEditDetail.txtFinish_Sz3.ReadOnly = .T.
		
		ThisFormSet.frmEditDetail.cmdAdd.Visible = .T.
		ThisFormSet.frmEditDetail.cmdEdit.Caption = "Edit"
		ThisFormSet.frmEditDetail.cmdDelete.Caption = "Delete"
		ThisFormSet.frmEditDetail.cmdClose.Visible = .T.
		ThisFormSet.frmEditDetail.lstMSDetail.Visible = .T.
		
	ENDPROC

	PROCEDURE mach_detail_add
		*lReturn = ThisFormSet.Mach_Detail_Add()
		
		PRIVATE nMach_Shop_ID,nID_Detail 
		PRIVATE cSOitem,nProcNum,cMachine,cMach_Type,lStart,cStart_Form,nStart_PC,nStart_Sz1,nStart_Sz2,nStart_Sz3,nStart_Pounds
		PRIVATE lFinish,cFinish_CC,cFinish_Form,nFinish_PC,nFinish_Sz1,nFinish_Sz2,nFinish_Sz3
		
		nMach_Shop_ID = ThisFormSet.frmProduction.txtMach_Shop_ID.Value
		nID_Detail = 0
		
		
		*Get Data from Master
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpMach_Shop_ID')
			USE IN tmpMach_Shop_ID
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM dbo.Mach_Shop "
		cSQL = cSQL + " WHERE ID = "+STR(nMach_Shop_ID)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMach_Shop_ID')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpMach_Shop_ID')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpMach_Shop_ID')
			RETURN .F.
		ENDIF
		
		PRIVATE nLastProcNum, nProcNum
		nLastProcNum = 0
		nProcNum = 100
		
		IF USED('tmpMach_Shop_ID')
		
			cSOitem			= PrepareSQLtxt(tmpMach_Shop_ID.SOitem,'SOitem',10)
			*nProcNum		= 100
			cMachine		= ''
			cMach_Type		= ''
			lStart			= .F.
			cStart_Form		= PrepareSQLtxt(tmpMach_Shop_ID.Start_Form,'Form',2)
			nStart_PC		= PrepareSQLnum(tmpMach_Shop_ID.Start_PC,'PC',-3)
			nStart_Sz1		= PrepareSQLnum(tmpMach_Shop_ID.Start_Sz1,'Sz1',-5)
			nStart_Sz2		= PrepareSQLnum(tmpMach_Shop_ID.Start_Sz2,'Sz2',-5)
			nStart_Sz3		= PrepareSQLnum(tmpMach_Shop_ID.Start_Sz3,'Sz3',-5)
			nStart_Pounds	= PrepareSQLnum(tmpMach_Shop_ID.Start_Pounds,'LBS',7,1)
			*,[Start_Date]
			*,[Start_Who]
			lFinish			= .F.
			cFinish_CC		= PrepareSQLtxt(tmpMach_Shop_ID.Finish_CC,'CC',1)
			cFinish_Form	= PrepareSQLtxt(tmpMach_Shop_ID.Finish_Form,'Form',2)
			nFinish_PC		= PrepareSQLnum(tmpMach_Shop_ID.Finish_PC,'PC',-3)
			nFinish_Sz1		= PrepareSQLnum(tmpMach_Shop_ID.Finish_Sz1,'Sz1',-5)
			nFinish_Sz2		= PrepareSQLnum(tmpMach_Shop_ID.Finish_Sz2,'Sz2',-5)
			nFinish_Sz3		= PrepareSQLnum(tmpMach_Shop_ID.Finish_Sz3,'Sz3',-5)
			nFinish_Pounds	= PrepareSQLnum(tmpMach_Shop_ID.Finish_Pounds,'LBS',7,1)
			
			************************************************************************
			*Look for Last ProcNum
			
			IF USED('tmpDetail_ProcNum')
				USE IN tmpDetail_ProcNum
			ENDIF
		
			SELECT 0
		
			cSQL = "SELECT TOP 1 ProcNum "
			cSQL = cSQL + " FROM dbo.Mach_Detail "
			cSQL = cSQL + " WHERE Mach_Shop_ID = "+STR(nMach_Shop_ID)
			cSQL = cSQL + " ORDER BY ProcNum Desc "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpDetail_ProcNum')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpDetail_ProcNum')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpDetail_ProcNum')
				RETURN .F.
			ENDIF
			
			IF USED('tmpDetail_ProcNum')
				IF RECCOUNT('tmpDetail_ProcNum') > 0
					nLastProcNum = tmpDetail_ProcNum.ProcNum
				ENDIF
				USE IN tmpDetail_ProcNum
			ENDIF
			
			IF nLastProcNum > 0
				nProcNum = ( ROUND(nLastProcNum/100,0) * 100 ) + 100
			ENDIF
			
			*******************************************************************
			IF nLastProcNum > 0
				*Get last data
				IF USED('tmpMach_Detail_ProcNum')
					USE IN tmpMach_Detail_ProcNum
				ENDIF
		
				SELECT 0
		
				cSQL = "SELECT * "
				cSQL = cSQL + " FROM dbo.Mach_Detail "
				cSQL = cSQL + " WHERE Mach_Shop_ID = "+STR(nMach_Shop_ID)
				cSQL = cSQL + " AND ProcNum ="+STR(nLastProcNum )
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMach_Detail_ProcNum')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpMach_Detail_ProcNum')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpMach_Detail_ProcNum')
					RETURN .F.
				ENDIF
				
				IF USED('tmpMach_Detail_ProcNum')
					IF RECCOUNT('tmpMach_Detail_ProcNum') > 0
						*Start where last Proc Finished
						cStart_Form		= PrepareSQLtxt(tmpMach_Detail_ProcNum.Finish_Form,'Form',2)
						nStart_PC		= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_PC,'PC',-3)
						nStart_Sz1		= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_Sz1,'Sz1',-5)
						nStart_Sz2		= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_Sz2,'Sz2',-5)
						nStart_Sz3		= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_Sz3,'Sz3',-5)
						nStart_Pounds	= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_Pounds,'LBS',7,1)
						*,[Start_Date]
						*,[Start_Who]
						cFinish_CC		= PrepareSQLtxt(tmpMach_Detail_ProcNum.Finish_CC,'CC',1)
						cFinish_Form	= PrepareSQLtxt(tmpMach_Detail_ProcNum.Finish_Form,'Form',2)
						nFinish_PC		= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_PC,'PC',-3)
						nFinish_Sz1		= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_Sz1,'Sz1',-5)
						nFinish_Sz2		= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_Sz2,'Sz2',-5)
						nFinish_Sz3		= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_Sz3,'Sz3',-5)
						nFinish_Pounds	= PrepareSQLnum(tmpMach_Detail_ProcNum.Finish_Pounds,'LBS',7,1)
					ENDIF
					USE IN tmpMach_Detail_ProcNum
				ELSE
					MESSAGEBOX("Could not get the Last Proc to Start this Proc",64,"Data error")
				ENDIF
					
			ENDIF
			
			********************************
			*Create Detail
			IF USED('ins_Mach_Shop')
				USE IN ins_Mach_Shop
			ENDIF
		
			SELECT 0
		
			cSQL = "EXEC dbo.p_INS_Mach_Detail "
			cSQL = cSQL + " @Mach_Shop_ID="+STR(nMach_Shop_ID)
			cSQL = cSQL + ",@SOitem='"+cSOitem+"'"
			cSQL = cSQL + ",@ProcNum="+STR(nProcNum)
			cSQL = cSQL + ",@Machine='"+cMachine+"'"
			cSQL = cSQL + ",@Mach_Type='"+cMach_Type+"'"
			cSQL = cSQL + ",@Start="+IIF(lStart,'1','0')
			cSQL = cSQL + ",@Start_Form='"+cStart_Form+"'"
			cSQL = cSQL + ",@Start_PC="+STR(nStart_PC)
			cSQL = cSQL + ",@Start_Sz1="+STR(nStart_Sz1,18,4)
			cSQL = cSQL + ",@Start_Sz2="+STR(nStart_Sz2,18,4)
			cSQL = cSQL + ",@Start_Sz3="+STR(nStart_Sz3,18,4)
			cSQL = cSQL + ",@Start_Pounds="+STR(nStart_Pounds,7,1)
			cSQL = cSQL + ",@Finish="+IIF(lFinish,'1','0')
			cSQL = cSQL + ",@Finish_CC='"+cFinish_CC+"'"
			cSQL = cSQL + ",@Finish_Form='"+cFinish_Form+"'"
			cSQL = cSQL + ",@Finish_PC="+STR(nFinish_PC)
			cSQL = cSQL + ",@Finish_Sz1="+STR(nFinish_Sz1,18,4)
			cSQL = cSQL + ",@Finish_Sz2="+STR(nFinish_Sz2,18,4)
			cSQL = cSQL + ",@Finish_Sz3="+STR(nFinish_Sz3,18,4)
			cSQL = cSQL + ",@Finish_Pounds="+STR(nFinish_Pounds,7,1)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ins_Mach_Shop')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ins_Mach_Shop')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'ins_Mach_Shop')
				RETURN .F.
			ENDIF
			
			IF USED('ins_Mach_Shop')
				IF RECCOUNT('ins_Mach_Shop') > 0
					nID_Detail = ins_Mach_Shop.ID
					
					ThisFormSet.Refresh_lstMSDetail()
					
				ENDIF
				USE IN ins_Mach_Shop
			ENDIF
			
			USE IN tmpMach_Shop_ID
		ELSE
			MESSAGEBOX("Could not find dbo.Mach_Shop ID = "+ALLTRIM(STR(nMach_Shop_ID)),16,'Cannot add detail record')
			RETURN .F.
		ENDIF
		
		IF nID_Detail > 0
			*Fill Detail form 			
			ThisFormSet.frmEditDetail.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
			ThisFormSet.frmEditDetail.txtMach_Shop_ID.Value	= PrepareSQLnum(nMach_Shop_ID,'Mach_Shop_ID',-3)
			ThisFormSet.frmEditDetail.txtSOitem.Value		= PrepareSQLtxt(cSOitem,'SOitem',10)
			ThisFormSet.frmEditDetail.txtProcNum.Value		= PrepareSQLnum(nProcNum,'ProcNum',-2)
			ThisFormSet.frmEditDetail.txtMachine.Value		= PrepareSQLtxt(cMachine,'Machine',10)
			ThisFormSet.frmEditDetail.txtMach_Type.Value	= PrepareSQLtxt(cMach_Type,'Mach_Type',5)
			
			ThisFormSet.frmEditDetail.chkStart.Value		= PrepareSQLchk(lStart,'Start')
			ThisFormset.frmEditDetail.cmbStart_CC.Value		= PrepareSQLtxt(cStart_CC,'CC',1)
			ThisFormset.frmEditDetail.txtStart_CC.Value		= PrepareSQLtxt(cStart_CC,'CC',1)
		
			ThisFormset.frmEditDetail.txtStart_Form.Value	= PrepareSQLtxt(cStart_Form,'Form',2)
			ThisFormset.frmEditDetail.txtStart_PC.Value		= PrepareSQLnum(nStart_PC,'PC',-3)
			ThisFormset.frmEditDetail.txtStart_LBS.Value	= PrepareSQLnum(nStart_Pounds,'Pounds',7,1)
			
			ThisFormSet.frmEditDetail.txtStart_Sz1.Value	= PrepareSQLnum(nStart_Sz1,'Sz1',-5)
			ThisFormSet.frmEditDetail.txtStart_Sz2.Value	= PrepareSQLnum(nStart_Sz2,'Sz2',-5)
			ThisFormSet.frmEditDetail.txtStart_Sz3.Value	= PrepareSQLnum(nStart_Sz3,'Sz3',-5)
			
			ThisFormSet.frmEditDetail.chkFinish.Value		= PrepareSQLchk(lFinish,'Finish')
			ThisFormset.frmEditDetail.cmbFinish_CC.Value	= PrepareSQLtxt(cFinish_CC,'CC',1)
			ThisFormset.frmEditDetail.txtFinish_CC.Value	= PrepareSQLtxt(cFinish_CC,'CC',1)
			ThisFormset.frmEditDetail.txtFinish_Form.Value	= PrepareSQLtxt(cFinish_Form,'Form',2)
			ThisFormset.frmEditDetail.txtFinish_PC.Value	= PrepareSQLnum(nFinish_PC,'PC',-3)
			ThisFormset.frmEditDetail.txtFinish_LBS.Value	= PrepareSQLnum(nFinish_Pounds,'Pounds',7,1)
			
			ThisFormSet.frmEditDetail.txtFinish_Sz1.Value	= PrepareSQLnum(nFinish_Sz1,'Sz1',-5)
			ThisFormSet.frmEditDetail.txtFinish_Sz2.Value	= PrepareSQLnum(nFinish_Sz2,'Sz2',-5)
			ThisFormSet.frmEditDetail.txtFinish_Sz3.Value	= PrepareSQLnum(nFinish_Sz3,'Sz3',-5)
			
			lReturn = ThisFormSet.Mach_Detail_Edit()
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE mach_detail_edit
		*lReturn = ThisFormSet.Mach_Detail_Edit()
		
		*ThisFormSet.frmEditDetail.txtID_Detail
		*ThisFormSet.frmEditDetail.txtMach_Shop_ID
		*ThisFormSet.frmEditDetail.txtSOitem
		ThisFormSet.frmEditDetail.txtProcNum.ReadOnly = .F.
		ThisFormSet.frmEditDetail.txtMachine.ReadOnly = .F.
		ThisFormSet.frmEditDetail.txtMach_Type.ReadOnly = .F.
		
		ThisFormSet.frmEditDetail.chkStart.ReadOnly = .F.
		ThisFormSet.frmEditDetail.cmbStart_CC.Visible = .T.
		ThisFormSet.frmEditDetail.cmbStart_CC.Enable = .T.
		ThisFormset.frmEditDetail.txtStart_CC.Visible = .F.
		
		ThisFormset.frmEditDetail.txtStart_Form.ReadOnly = .F.
		ThisFormset.frmEditDetail.txtStart_PC.ReadOnly = .F.
		ThisFormset.frmEditDetail.txtStart_LBS.ReadOnly = .F.
		
		ThisFormSet.frmEditDetail.txtStart_Sz1.ReadOnly = .F.
		ThisFormSet.frmEditDetail.txtStart_Sz2.ReadOnly = .F.
		ThisFormSet.frmEditDetail.txtStart_Sz3.ReadOnly = .F.
		
		ThisFormSet.frmEditDetail.chkFinish.ReadOnly = .F.
		
		ThisFormSet.frmEditDetail.cmbFinish_CC.Visible = .T.
		ThisFormSet.frmEditDetail.cmbFinish_CC.Enable = .T.
		ThisFormset.frmEditDetail.txtFinish_CC.Visible = .F.
		
		ThisFormset.frmEditDetail.txtFinish_Form.ReadOnly = .F.
		ThisFormset.frmEditDetail.txtFinish_PC.ReadOnly = .F.
		ThisFormset.frmEditDetail.txtFinish_LBS.ReadOnly = .F.
		
		ThisFormSet.frmEditDetail.txtFinish_Sz1.ReadOnly = .F.
		ThisFormSet.frmEditDetail.txtFinish_Sz2.ReadOnly = .F.
		ThisFormSet.frmEditDetail.txtFinish_Sz3.ReadOnly = .F.
		
		ThisFormSet.frmEditDetail.cmdAdd.Visible = .F.
		ThisFormSet.frmEditDetail.cmdEdit.Caption = "Save"
		ThisFormSet.frmEditDetail.cmdDelete.Caption = "Abort"
		ThisFormSet.frmEditDetail.cmdClose.Visible = .F.
		ThisFormSet.frmEditDetail.lstMSDetail.Visible = .F.
		
		
	ENDPROC

