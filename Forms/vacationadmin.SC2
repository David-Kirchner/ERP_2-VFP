	PROCEDURE addvactiondate
		PARAMETER pDay,pMonth,pYear,pEmployee
		*AddVactionDate(gDay,gMonth,gYear,ThisForm.cmbAllEmployees.Value)
		
		*pDay,pMonth,pYear,pEmployee
		PRIVATE lnAdd, lnVacationID, ldVacationDate, lcVacationDate
		PRivate lcDisplayName, lcHoliday, lnVacationLeft
		
		
		IF IsNull(pDay) OR IsNull(pMonth) OR IsNull(pYear) 
			messagebox("Select a date first!",0,"No Date")
			RETURN -1
		ENDIF
		ldVacationDate = CTOD(STR(pMonth)+"/"+STR(pDay)+"/"+STR(pYear))
		lcVacationDate = DTOC(ldVacationDate)
		
		
		IF IsNull(pEmployee) 
			MESSAGEBOX("No Employee.",0,"No Employee")
			RETURN -1
		ENDIF
		
		IF (pEmployee) = "(Select Employee)"
			*ALLEMPLOYEE_LOC = "(Select Employee)"
			MESSAGEBOX("Select Employee First.",0,"No Employee.")
			RETURN -1
		ENDIF
		lcDisplayName = ALLTRIM(pEmployee)
		
		*Validate Holiday
		lcHoliday = ThisForm.IsHoliday(ldVacationDate)
		DO CASE
		CASE lcHoliday = "NO"
		CASE lcHoliday = "NoDate"
		OTHERWISE
			MESSAGEBOX( lcDisplayName+" can not take off holiday "+lcHoliday+".",0,"This date is already listed as a company holiday.")
			RETURN -1
		ENDCASE
		
		*Validate Vacation Time left *DaysVacationLeft
		lnVacationLeft = DaysVacationLeft( ldVacationDate, pEmployee )
		IF lnVacationLeft < 1
			MESSAGEBOX( lcDisplayName+" can not take off more vacation days.",0,"No vacation time left to give.")
			RETURN -1
		ENDIF
		
		*Validate on Vacation
		lcVacationAns = ThisForm.IsVacationDay(ldVacationDate,pEmployee)
		DO CASE
		CASE lcVacationAns = "NO"
		OTHERWISE && lcVacationAns = "YES"
			MESSAGEBOX( lcDisplayName+" can not take off this day "+lcVacationDate +".",0,"Date is already being used as vacation.")
			RETURN -1
		ENDCASE
		*Validate Add
		*lnAdd = MESSAGEBOX("Mark "+lcDisplayName+CHR(10)+CHR(13)+" for vacation on "+CHR(10)+CHR(13);
		*+lcVacationDate +".",4+32,"Confirm")
		*+ALLTRIM(STR(pMonth))+"/"+ALLTRIM(STR(pDay))+"/"+ALLTRIM(STR(pYear))+".",4+32,"Confirm")
		
		*IF lnAdd = 6
			*Add
			
			lnVacationID = ThisForm.NextVacationID()
			
			DO FORM Forms\VacationSet WITH lnVacationID, lcDisplayName, ldVacationDate
			
			*INSERT INTO Vacation (id,DispName,vacadate,hours) VALUES (lnVacationID ,lcDisplayName,ldVacationDate, 8)
		
			*ThisForm.lstVacation.rowsourcetype = 0
			ThisForm.lstVacation.ReQuery
		*	ThisForm.lstVacation.rowsource = "SELECT DTOC(vacadate) AS DaysOff FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = UPPER(ALLTRIM(THIS.Value)) AND YEAR(vacadate) = YEAR(DATE()) INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.Refresh
			
		*ENDIF
		
		RETURN 0
	ENDPROC

	PROCEDURE Destroy
		IF USED('tempHoliday')
			USE IN tempHoliday
		ENDIF
		
		IF USED('TempVacationDays')
			USE IN TempVacationDays
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PUBLIC gDate, gDay, gMonth, gYear
		SET PROCEDURE TO Quotes\Progs\Vacation ADDITIVE
		
		gDate = DATE()
		gDay   = DAY(gDATE)
		gMonth = MONTH(gDATE)
		gYear  = YEAR(gDATE)
		
		ThisForm.OleDatePicker.Day = gDay
		ThisForm.OleDatePicker.Month = gMonth
		ThisForm.OleDatePicker.Year  = gYear
		
		ThisForm.lstHolidays.RowSourceType = 3
		ThisForm.lstHolidays.RowSource = "SELECT DtoC(holidate) AS dayoff, holiday FROM holiday WHERE MONTH(holidate) = gMONTH AND YEAR(holidate) = gYEAR AND !DELETED() ORDER BY holidate INTO CURSOR tempHoliday" 
		
		
		ThisForm.lstVacation.rowsourcetype = 3
		ThisForm.lstVacation.rowsource = "SELECT DISTINCT DTOC(vacadate) AS DaysOff, VacaType AS T, DispName FROM vacation  WHERE MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
		
		
		
	ENDPROC

	PROCEDURE isholiday		&& Pass Date/Return -1,0,1
		Parameter pDate
		PRIVATE aMaxID
		
		IF IsNull(pDate)
			Wait window 'IsHoliday() id not Receive Date' 
			RETURN "NoDate"
		ENDIF
		IF TYPE('pDate') <> "D"
			Wait window 'IsHoliday() id not Receive Date' 
			RETURN "NoDate"
		ENDIF
		
		SELECT Holiday FROM Holiday WHERE HoliDate = pDate INTO ARRAY aMaxID
		
		IF TYPE('aMaxID') = "C"
			RETURN aMaxID(1)
		ENDIF
		
		RETURN "NO"
	ENDPROC

	PROCEDURE isvacationday		&& Return -1 error, 0 no, 1 yes
		Parameter pDate,pEmployee
		PRIVATE aMaxID
		
		IF IsNull(pDate)
			Wait window 'IsHoliday() id not Receive Date' 
			RETURN "NoDate"
		ENDIF
		IF TYPE('pDate') <> "D"
			Wait window 'IsHoliday() id not Receive Date' 
			RETURN "NoDate"
		ENDIF
		
		IF IsNull(pEmployee)
			Wait window 'IsHoliday() id not Receive Employee' 
			RETURN "NoEmployee"
		ENDIF
		IF TYPE('pEmployee') <> "C"
			Wait window 'IsHoliday() id not Receive Employee' 
			RETURN "NoEmployee"
		ENDIF
		
		SELECT DispName FROM Vacation WHERE VacaDate = pDate AND DispName = pEmployee INTO ARRAY aMaxID
		
		IF TYPE('aMaxID') = "C"
			RETURN "YES"
		ENDIF
		
		RETURN "NO"
	ENDPROC

	PROCEDURE Load
		set safety off
		
		m.currdbc = IIF(EMPTY(DBC()),"",DBC())
		
	ENDPROC

	PROCEDURE nextvacationid
		PRIVATE aMaxID, lnMaxID
		lnMaxID = 0
		
		SELECT MAX(id) FROM VACATION INTO ARRAY aMaxID
		
		IF TYPE('aMaxID') = 'N'
			lnMaxID = aMaxID(1)
		ENDIF
		lnMaxID = lnMaxID + 1
		
		RETURN lnMaxID
	ENDPROC

	PROCEDURE refreshdays
		PRIVATE pDate, pEmployee
		pDate = DATE()
		pEmployee = ThisForm.cmbAllEmployees.Value
		
		IF EMPTY(pEmployee) OR pEmployee = "(Select Employee)"
			ThisForm.lblDays.Visible = .F.
			ThisForm.lblAvail.Visible = .F.
			ThisForm.txtAvailable.Visible = .F.
			ThisForm.lblTaken.Visible = .F.
			ThisForm.txtTaken.Visible = .F.
			ThisForm.lblLeft.Visible = .F.
			ThisForm.txtLeft.Visible = .F.
			ThisForm.lblPersonal.Visible = .F.
			ThisForm.txtPersonal.Visible = .F.
			ThisForm.lblSick.Visible = .F.
			ThisForm.txtSick.Visible = .F.
			
			ThisForm.txtAvailable.Caption = ""
			ThisForm.txtTaken.Caption = ""
			ThisForm.txtLeft.Caption = ""
			ThisForm.txtSick.Caption = ""
		ELSE
			ThisForm.lblDays.Visible = .T.
			ThisForm.lblAvail.Visible = .T.
			ThisForm.txtAvailable.Visible = .T.
			ThisForm.lblTaken.Visible = .T.
			ThisForm.txtTaken.Visible = .T.
			ThisForm.lblLeft.Visible = .T.
			ThisForm.txtLeft.Visible = .T.
			ThisForm.lblPersonal.Visible = .T.
			ThisForm.txtPersonal.Visible = .T.
			ThisForm.lblSick.Visible = .T.
			ThisForm.txtSick.Visible = .T.
			
			ThisForm.txtAvailable.Caption = VacationTimeAllowed(pDate, pEmployee)
			ThisForm.txtTaken.Caption = VacationTimeUsed(pDate, pEmployee)
			ThisForm.txtLeft.Caption = ALLTRIM(STR( DaysVacationLeft(pDate, pEmployee) ))
			ThisForm.txtPersonal.Caption = PersonalTimeUsed(pDate, pEmployee)
			ThisForm.txtSick.Caption = SickTimeUsed(pDate, pEmployee)
		ENDIF
		
	ENDPROC

	PROCEDURE setcalendar
		gMonth = ThisForm.oleDatePicker.Month
		gYEAR  = ThisForm.oleDatePicker.Year
		gDay = ThisForm.oleDatePicker.Day
		
		ThisForm.lstVacation.Requery
		ThisForm.lstHolidays.Requery
		
	ENDPROC

	PROCEDURE setlstcavation
		IF ThisForm.cmbAllEmployees.Value = "(Select Employee)"
			ThisForm.lstVacation.rowsourcetype = 0
			ThisForm.lstVacation.rowsource = "SELECT DISTINCT DTOC(vacadate) AS DaysOff, VacaType AS T, DispName FROM vacation  WHERE MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.rowsourcetype = 3
		ELSE
			ThisForm.lstVacation.rowsourcetype = 0
			mSQL = "SELECT DTOC(vacadate) AS DaysOff, VacaType AS T, DispName FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = '"
			mSQL = mSQL + UPPER(ALLTRIM(THIS.Value))
			mSQL = mSQL + "' AND MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.rowsource = mSQL
		    *SELECT STR(1/ 1-DayFraction)+' '+DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = UPPER(ALLTRIM(THIS.Value)) AND YEAR(vacadate) = gYEAR INTO CURSOR TempVacationDays
			ThisForm.lstVacation.rowsourcetype = 3
		ENDIF
	ENDPROC

	PROCEDURE cmbAllEmployees.Init
		this.clear
		this.additem("(Select Employee)")
		
		LOCAL aEmployees,cEmployee
		DIMENSION aEmployees[1]
		
		SELECT dispname FROM employees WHERE Active1 AND !DELETED() INTO array aEmployees
		
		FOR EACH m.cEmployee IN aEmployees
			IF !EMPTY(m.cEmployee)
				this.additem(m.cEmployee)
			ENDIF
		ENDFOR
		
		THIS.VALUE = "(Select Employee)"
	ENDPROC

	PROCEDURE cmbAllEmployees.InteractiveChange
		LOCAL cDisplayValue, mSQL, mValue
		THISFORM.LockScreen = .T.
		IF THIS.Value = "(Select Employee)"
			*This section also used in cmdEditEmp.click
			ThisForm.lstVacation.rowsourcetype = 0
			ThisForm.lstVacation.rowsource = "SELECT DISTINCT DTOC(vacadate) AS DaysOff, VacaType AS T, DispName FROM vacation  WHERE MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.rowsourcetype = 3
		ELSE
			ThisForm.lstVacation.rowsourcetype = 0
			mSQL = "SELECT DTOC(vacadate) AS DaysOff, VacaType AS T, DispName FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = '"
			mValue = UPPER(ALLTRIM(THIS.Value))
			mSQL = mSQL + (mValue)
			mSQL = mSQL + "' AND MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
		
			ThisForm.lstVacation.rowsource = mSQL
		*	ThisForm.lstVacation.rowsource = "SELECT DTOC(vacadate) AS DaysOff FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = UPPER(ALLTRIM(THIS.Value)) AND YEAR(vacadate) = YEAR(DATE()) INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.rowsourcetype = 3
		ENDIF
		ThisForm.RefreshDays()
		THISFORM.LockScreen = .F.
		
	ENDPROC

	PROCEDURE cmdAddVaca.Click
		ThisForm.AddVactionDate(gDay,gMonth,gYear,ThisForm.cmbAllEmployees.Value)
		
	ENDPROC

	PROCEDURE cmdBackup.Click
		*!*	IF USED('Employees')
		*!*		SELECT Employees
		*!*		COPY TO c:\Employees
		*!*	ENDIF
		
		*!*	IF USED('Holiday')
		*!*		SELECT Holiday
		*!*		COPY TO C:\Holiday
		*!*	ENDIF
		
		*!*	IF USED('Vacation')
		*!*		SELECT Vacation
		*!*		COPY TO C:\Vacation
		*!*	ENDIF
		
		*!* WAIT WINDOW 'Saved...' NOWAIT
	ENDPROC

	PROCEDURE cmdEditEmp.Click
		DO FORM Forms\EmployeeMaint WITH ThisForm.cmbAllEmployees.Value
		
		ThisForm.cmbAllEmployees.clear
		ThisForm.cmbAllEmployees.additem("(Select Employee)")
		
		LOCAL aEmployees,cEmployee
		DIMENSION aEmployees[1]
		
		SELECT dispname FROM employees WHERE Active1 AND !DELETED() INTO array aEmployees
		
		FOR EACH m.cEmployee IN aEmployees
			IF !EMPTY(m.cEmployee)
					ThisForm.cmbAllEmployees.additem(m.cEmployee)
			ENDIF
		ENDFOR
		
		ThisForm.cmbAllEmployees.VALUE = "(Select Employee)"
		ThisForm.lstVacation.rowsourcetype = 0
		ThisForm.lstVacation.rowsource = "SELECT DISTINCT DTOC(vacadate) AS DaysOff, VacaType AS T, DispName FROM vacation  WHERE MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
		ThisForm.lstVacation.rowsourcetype = 3
		
	ENDPROC

	PROCEDURE cmdEditHoli.Click
		DO FORM Forms\Holiday
	ENDPROC

	PROCEDURE cmdEditVaca.Click
		DO FORM Forms\VacationMaint WITH ThisForm.cmbAllEmployees.Value
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdPrintEmp.Click
		PRIVATE lcEmployee
		
		IF NOT USED('Vacation')
			USE Vacation IN 0
		ENDIF
		SELECT Vacation
		SET ORDER TO Wizard_1
		lcEmployee = ThisForm.cmbAllEmployees.Value
		*lcEmployee = "(Select Employee)"
		IF IsEmployee(lcEmployee)
			REPORT FORM Reports\Vacation-AllEmployees FOR Vacation.DispName = lcEmployee AND YEAR(vacation.vacadate) = gYear PREVIEW
			*TO PRINTER PROMPT 
		ELSE
			MESSAGEBOX("No Employee")
		ENDIF
	ENDPROC

	PROCEDURE cmdPrintMonth.Click
		IF NOT USED('Vacation')
			USE Vacation IN 0
		ENDIF
		SELECT Vacation
		
		SET ORDER TO Wizard_2
		REPORT FORM Reports\Vacation-AllEmployees FOR MONTH(Vacation.vacadate) = gMonth AND YEAR(vacation.vacadate) = gYear PREVIEW
		*TO PRINTER PROMPT 
		
	ENDPROC

	PROCEDURE OleDatePicker.Click
		*** ActiveX Control Event **
	ENDPROC

	PROCEDURE OleDatePicker.DateClick
		*** ActiveX Control Event ***
		LPARAMETERS dateclicked
		gYEAR = This.Year
		gMonth = This.Month
		gDay = This.Day
		
		ThisForm.lstVacation.Requery
		ThisForm.lstVacation.Refresh
		
		ThisForm.lstHolidays.Requery
		ThisForm.lstHolidays.Refresh
	ENDPROC

	PROCEDURE OleDatePicker.DateDblClick
		*** ActiveX Control Event ***
		LPARAMETERS datedblclicked
		ThisForm.AddVactionDate(gDay,gMonth,gYear,ThisForm.cmbAllEmployees.Value)
	ENDPROC

	PROCEDURE OleDatePicker.SelChange
		*** ActiveX Control Event ***
		LPARAMETERS startdate, enddate, cancel
		gYEAR = This.Year
		gMonth = This.Month
		gDay = This.Day
		
		ThisForm.lstVacation.Requery
		ThisForm.lstVacation.Refresh
		
		ThisForm.lstHolidays.Requery
		ThisForm.lstHolidays.Refresh
	ENDPROC

ENDDEFINE
