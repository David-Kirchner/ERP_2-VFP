		Name = "txtStockDetail", ;
		ReadOnly = .T., ;
		Top = 215, ;
		Width = 155
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETER pID_Detail, pLst
		*DO FORM forms\Stocklst_Process_Review WITH pID_Detail, pLst
		
		PRIVATE nID_Detail, cTBL
		nID_Detail = PrepareSQLnum(pID_Detail,'ID_Detail',-3)
		cTBL	= PrepareSQLtxt(pLST,'TBL',1)
		
		IF cTBL = "S" OR cTBL = "B" OR cTBL = "W"
			*Correct TBL
		ELSE
			MESSAGEBOX("Parameter pLst was unknow",16,"Csnnot show")
			TrackError("Parameter pLst was unknow","Parameter pLst was unknow", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = ""
		DO CASE
		CASE pLst = "S"
			cSQL =        "SELECT SP.SOitem,SP.PO_Item,CAST(StartDate AS DATE) AS StartDate,CAST(DueDate AS DATE) as DueDate,SP.Comment"
			cSQL = cSQL + " ,SP.Process_ID,'S' AS Stk,SP.ID_Detail_Process,SP.QTY "
			cSQL = cSQL + " ,SD.Dim1,SD.Dim2,SD.Dim3 "
			cSQL = cSQL + " ,S.Cmplt,S.Cncld "
			cSQL = cSQL + " ,PO.Cancelled,PO.Delivered,PO.Cancelled,PO.Reconciled "
		
			cSQL = cSQL + ",CASE WHEN (SP.Process_ID = 'INCOMING' OR SP.Process_ID = 'PARTRECV' ) and ISNULL(PO.SalesNum,0)>0 THEN 1 ELSE 0 END AS SObad "
			cSQL = cSQL + ",CASE WHEN (SP.Process_ID = 'SELECTED' OR SP.Process_ID='PARTSELECT' ) AND ISNULL(PO.HPAPO,0)>0 THEN 1 ELSE 0 END AS PObad "
		
			cSQL = cSQL + " FROM dbo.StockLst_Process SP "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Detail SD WITH(NOLOCK) ON SP.ID_Detail = SD.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales S WITH(NOLOCK) ON S.SOitem = SP.SOitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON PO.POitem = SP.PO_item "
		
		CASE pLst = "B"
			*cSQL = cSQL + " Union "
			cSQL = cSQL + " SELECT SP.SOitem,SP.PO_Item,CAST(StartDate AS DATE) AS StartDate,CAST(DueDate AS DATE) as DueDate,SP.Comment"
			cSQL = cSQL + " ,SP.Process_ID,'B' AS Stk,SP.ID_Detail_Process,SP.QTY  "
			cSQL = cSQL + " ,SD.Dim1,SD.Dim2,SD.Dim3 "
			cSQL = cSQL + " ,S.Cmplt,S.Cncld "
			cSQL = cSQL + " ,PO.Cancelled,PO.Delivered,PO.Cancelled,PO.Reconciled "
		
			cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'INCOMING' OR SP.Process_ID = 'PARTRECV' ) and ISNULL(PO.SalesNum,0)>0 THEN 1 ELSE 0 END AS SObad "
			cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'SELECTED' OR SP.Process_ID='PARTSELECT' ) and ISNULL(PO.HPAPO,0)>0 THEN 1 ELSE 0 END AS PObad "
		
			cSQL = cSQL + " FROM dbo.BrokerLst_Process SP "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Detail SD WITH(NOLOCK) ON SP.ID_Detail = SD.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales S WITH(NOLOCK) ON S.SOitem = SP.SOitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON PO.POitem = SP.PO_item "
		
		CASE pLst = "W"
			*cSQL = cSQL + " Union "
			cSQL = cSQL + " SELECT SP.SOitem,SP.PO_Item,CAST(StartDate AS DATE) AS StartDate,CAST(DueDate AS DATE) as DueDate,SP.Comment"
			cSQL = cSQL + " ,SP.Process_ID,'B' AS Stk,SP.ID_Detail_Process,SP.QTY  "
			cSQL = cSQL + " ,SD.Dim1,SD.Dim2,SD.Dim3 "
			cSQL = cSQL + " ,S.Cmplt,S.Cncld "
			cSQL = cSQL + " ,PO.Cancelled,PO.Delivered,PO.Cancelled,PO.Reconciled "
		
			cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'INCOMING' OR SP.Process_ID = 'PARTRECV' ) and ISNULL(PO.SalesNum,0)>0 THEN 1 ELSE 0 END AS SObad "
			cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'SELECTED' OR SP.Process_ID='PARTSELECT' ) and ISNULL(PO.HPAPO,0)>0 THEN 1 ELSE 0 END AS PObad "
		
			cSQL = cSQL + " FROM dbo.WIPLst_Process SP WITH(NOLOCK) "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Detail SD WITH(NOLOCK) ON SP.ID_Detail = SD.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales S WITH(NOLOCK) ON S.SOitem = SP.SOitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON PO.POitem = SP.PO_item "
		ENDCASE
		
		cSQL = cSQL + " WHERE SP.ID_Detail = "+STR(nID_Detail)
		cSQL = cSQL + " Order By StartDate "
		
		IF USED("tmpStockLst_Process")
			SELECT tmpStockLst_Process
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpStockLst_Process')
		ELSE
			IF USED("tmpStockLst_Process")
				ThisForm.lblRecCount.Caption = STR( RECCOUNT('tmpStockLst_Process') )
				ThisForm.grdStockLst_Process.RecordSource = 'tmpStockLst_Process'
				ThisForm.StockLst_Process_Change()
			ENDIF
		ENDIF
		
		IF HavePermission('Admin')
			Thisform.cmdAdminRemove.Visible = .T.
			ThisForm.cmdSavePO.Enabled = .T.
		ELSE
			Thisform.cmdAdminRemove.Visible = .F.
			ThisForm.cmdSavePO.Enabled = .F.
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "PROC_QUOTES" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\PROC_QUOTES ADDITIVE
		ENDIF
		
	ENDPROC

	PROCEDURE reloadstocklst_process
		*ReloadStockLst_Process
		PRIVATE nCurrRecNo
		nCurrRecNo = RECNO('tmpStockLst_Process')
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL =        "SELECT SP.SOitem,SP.PO_Item,CAST(StartDate AS DATE) AS StartDate,CAST(DueDate AS DATE) as DueDate,SP.Comment"
		cSQL = cSQL + " ,SP.Process_ID,'S' AS Stk,SP.ID_Detail_Process "
		cSQL = cSQL + " ,SD.Dim1,SD.Dim2,SD.Dim3 "
		cSQL = cSQL + " ,S.Cmplt,S.Cncld "
		cSQL = cSQL + " ,PO.Cancelled,PO.Delivered,PO.Cancelled,PO.Reconciled "
		
		cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'INCOMING' OR SP.Process_ID = 'PARTRECV' ) and ISNULL(PO.SalesNum,0)>0 THEN 1 ELSE 0 END AS SObad "
		cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'SELECTED' OR SP.Process_ID='PARTSELECT' ) and ISNULL(PO.HPAPO,0)>0 THEN 1 ELSE 0 END AS PObad "
		
		cSQL = cSQL + " FROM dbo.StockLst_Process SP WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Detail SD WITH(NOLOCK) ON SP.ID_Detail = SD.ID_Detail "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales S WITH(NOLOCK) ON S.SOitem = SP.SOitem "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON PO.POitem = SP.PO_item "
		
		cSQL = cSQL + " Union "
		cSQL = cSQL + " SELECT SP.SOitem,SP.PO_Item,CAST(StartDate AS DATE) AS StartDate,CAST(DueDate AS DATE) as DueDate,SP.Comment"
		cSQL = cSQL + ",SP.Process_ID,'B' AS Stk,SP.ID_Detail_Process "
		cSQL = cSQL + " ,SD.Dim1,SD.Dim2,SD.Dim3 "
		cSQL = cSQL + " ,S.Cmplt,S.Cncld "
		cSQL = cSQL + " ,PO.Cancelled,PO.Delivered,PO.Cancelled,PO.Reconciled "
		
		cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'INCOMING' OR SP.Process_ID = 'PARTRECV' ) and ISNULL(PO.SalesNum,0)>0 THEN 1 ELSE 0 END AS SObad "
		cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'SELECTED' OR SP.Process_ID='PARTSELECT' ) and ISNULL(PO.HPAPO,0)>0 THEN 1 ELSE 0 END AS PObad "
		
		cSQL = cSQL + " FROM dbo.BrokerLst_Process SP WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Detail SD WITH(NOLOCK) ON SP.ID_Detail = SD.ID_Detail "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales S WITH(NOLOCK) ON S.SOitem = SP.SOitem "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON PO.POitem = SP.PO_item "
		
		cSQL = cSQL + " Union "
		cSQL = cSQL + " SELECT SP.SOitem,SP.PO_Item,CAST(StartDate AS DATE) AS StartDate,CAST(DueDate AS DATE) as DueDate,SP.Comment"
		cSQL = cSQL + ",SP.Process_ID,'B' AS Stk,SP.ID_Detail_Process "
		cSQL = cSQL + " ,SD.Dim1,SD.Dim2,SD.Dim3 "
		cSQL = cSQL + " ,S.Cmplt,S.Cncld "
		cSQL = cSQL + " ,PO.Cancelled,PO.Delivered,PO.Cancelled,PO.Reconciled "
		
		cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'INCOMING' OR SP.Process_ID = 'PARTRECV' ) and ISNULL(PO.SalesNum,0)>0 THEN 1 ELSE 0 END AS SObad "
		cSQL = cSQL + ",CASE WHEN ( SP.Process_ID = 'SELECTED' OR SP.Process_ID='PARTSELECT' ) and ISNULL(PO.HPAPO,0)>0 THEN 1 ELSE 0 END AS PObad "
		
		cSQL = cSQL + " FROM dbo.WIPLst_Process SP "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Detail SD WITH(NOLOCK) ON SP.ID_Detail = SD.ID_Detail "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales S WITH(NOLOCK) ON S.SOitem = SP.SOitem "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON PO.POitem = SP.PO_item "
		
		cSQL = cSQL + " Order By StartDate "
		
		
		ThisForm.grdStockLst_Process.RecordSource = ""
		
		IF USED("tmpStockLst_Process")
			SELECT tmpStockLst_Process
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStockLst_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpStockLst_Process')
		ELSE
			IF USED("tmpStockLst_Process")
				ThisForm.grdStockLst_Process.RecordSource = 'tmpStockLst_Process'
				IF nCurrRecNo > 0
					*record may be gone, but user will be back in neighborhood.
					GOTO nCurrRecNo 
				ENDIF
				
				ThisForm.StockLst_Process_Change()
				ThisForm.grdStockLst_Process.SetFocus()
		
		
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDeltaH, nDeltaW
		
		nDeltaH = This.Height - 407
		nDeltaW = This.Width  - 505
		
		*ThisForm.grdStockLst_Process.Height = 200 + nDeltaH 
		ThisForm.grdStockLst_Process.Width = 504  + nDeltaW 
		
		Thisform.edtComment.Width = 468 + nDeltaW 
	ENDPROC

	PROCEDURE stocklstpro_duedate_backcolor
		PRIVATE nColor
		*ThisForm.StocklstPro_DueDate_BackColor()
		*grd.clm.DynamicBackColor = ThisForm.StocklstPro_BackColor()
		
		nColor = RGB( 255, 255, 255 ) &&WHITE
		
		IF CTOD(tmpStockLst_Process.DueDate) < DATE()
			nColor = RGB( 255, 255, 128 ) &&YELLOW
		ENDIF
		
		RETURN nColor
	ENDPROC

	PROCEDURE stocklstpro_lst_backcolor
		PRIVATE nColor
		*ThisForm.StocklstPro_LST_BackColor()
		
		nColor = RGB( 128, 255, 128 ) &&Lite green
		
		IF tmpStockLst_Process.STK = "S"
			nColor = RGB( 128, 255, 255 ) &&lite Blue
			
		ENDIF
		
		RETURN nColor
	ENDPROC

	PROCEDURE stocklstpro_poitem_backcolor
		PRIVATE nColor
		*ThisForm.StocklstPro_POitem_BackColor()
		
		
		nColor = RGB( 240, 240, 240 ) &&Grey
		PRIVATE cPOitem	
		cPOitem	= PrepareSQLtxt( tmpStockLst_Process.PO_item, 'POitem', 12 )
		
		IF cPOitem != Proper_PO_Item("")
			cSQL = "SELECT * FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		
			IF USED("tmpPOitem")
				SELECT tmpPOitem
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPOitem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPOitem')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitem")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpPOitem')
			ELSE
				IF USED("tmpPOitem")
					IF RECCOUNT("tmpPOitem")>0
						nColor = RGB( 255, 255, 255 ) &&White
						*nColor = RGB( 255,0,0 ) &&Red	
					ELSE
						*nColor = RGB( 240, 240, 240 ) &&Grey
						nColor = RGB( 255,0,0 ) &&Red	
					ENDIF				
					USE IN tmpPOitem
				ENDIF
			ENDIF
		ENDIF
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE stocklstpro_process_backcolor
		PRIVATE nColor
		*ThisForm.StocklstPro_Process_BackColor()
		
		nColor = RGB( 128, 255, 128 ) &&Lite 255,128,128
		
		IF tmpStockLst_Process.Process_ID = "SELECTED" OR tmpStockLst_Process.Process_ID = "PARTSELECT"
			nColor = RGB( 128,128,255 ) &&lite violet
		ELSE
			IF tmpStockLst_Process.Process_ID = "INCOMING" OR tmpStockLst_Process.Process_ID = "PARTRECV"
				nColor = RGB( 255,128,0 ) &&Orange
			ENDIF
		ENDIF
		
		RETURN nColor
	ENDPROC

	PROCEDURE stocklstpro_soitem_backcolor
		PRIVATE nColor
		*ThisForm.StocklstPro_SOitem_BackColor()
		
		nColor = RGB( 255, 255, 255 ) &&Lite 255,128,128
		
		IF PrepareSQLLogic(tmpStockLst_Process.Cmplt,'Cmplt')
			nColor = RGB( 255,0,0 ) &&red
			RETURN nColor
		ENDIF
		IF PrepareSQLLogic(tmpStockLst_Process.Cncld,'Cncld')
			nColor = RGB( 255,0,0 ) &&red
			RETURN nColor
		ENDIF
		IF PrepareSQLLogic(tmpStockLst_Process.Cancelled,'Cancelled')
			nColor = RGB( 255,0,0 ) &&red
			RETURN nColor
		ENDIF
		IF PrepareSQLLogic(tmpStockLst_Process.Delivered,'Delivered')
			nColor = RGB( 255,0,0 ) &&red
			RETURN nColor
		ENDIF
		IF PrepareSQLLogic(tmpStockLst_Process.Cancelled,'Cancelled')
			nColor = RGB( 255,0,0 ) &&red
			RETURN nColor
		ENDIF
		IF PrepareSQLLogic(tmpStockLst_Process.Reconciled,'Reconciled')
			nColor = RGB( 255,0,0 ) &&red
			RETURN nColor
		ENDIF
		
		IF ISNULL(tmpStockLst_Process.DIM1)
			nColor = RGB( 255,0,0 ) &&red
			RETURN nColor
		ENDIF
		
		IF tmpStockLst_Process.SObad = 1
			nColor = RGB( 255,125,125 ) &&
			RETURN nColor
		ENDIF
		IF tmpStockLst_Process.PObad = 1
			nColor = RGB( 255,125,0 ) &&
			RETURN nColor
		ENDIF
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE stocklst_process_change
		*ThisForm.StockLst_Process_Change()
		
		PRIVATE cStocKDetail
		IF ISNULL(tmpStockLst_Process.DIM1)
			cStocKDetail = 'Stock is Gone!'
			ThisForm.txtStockDetail.ForeColor=RGB(255,0,0)
		ELSE
			ThisForm.txtStockDetail.ForeColor=RGB(0,0,0)
			cStocKDetail = Remove0(tmpStockLst_Process.DIM1,10,4)
			IF NOT ISNULL(tmpStockLst_Process.DIM2)
		*		IF tmpStockLst_Process.DIM2 > 0
					cStocKDetail = ALLTRIM(cStocKDetail) + " X " +ALLTRIM(Remove0(tmpStockLst_Process.DIM2,10,4))
		*		ENDIF
			ENDIF
			IF NOT ISNULL(tmpStockLst_Process.DIM3)
				IF tmpStockLst_Process.DIM3 > 0
					cStocKDetail = ALLTRIM(cStocKDetail) + " X " +ALLTRIM(Remove0(tmpStockLst_Process.DIM3,10,4))
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.txtStockDetail.Value	= cStocKDetail
		
		
		
		*ThisForm.txtStartDate.Value	= DTOC(tmpStockLst_Process.StartDate)
		ThisForm.txtStartDate.Value	= tmpStockLst_Process.StartDate
		*ThisForm.txtDueDate.Value	= DTOC(tmpStockLst_Process.DueDate)
		ThisForm.txtDueDate.Value	= tmpStockLst_Process.DueDate
		ThisForm.txtDueDate.BackColor = ThisForm.StocklstPro_DueDate_BackColor()
		
		*ThisForm.txtComment.Value	= tmpStockLst_Process.Comment
		ThisForm.edtComment.Value	= tmpStockLst_Process.Comment
		ThisForm.txtProcess_ID.Value	= tmpStockLst_Process.Process_ID
		ThisForm.txtProcess_ID.BackColor = ThisForm.StocklstPro_Process_BackColor()
		ThisForm.txtStk.Value		= IIF(tmpStockLst_Process.Stk="S","STK","BRK")
		ThisForm.txtStk.BackColor = ThisForm.StocklstPro_LST_BackColor()
		
		ThisForm.txtProcess_QTY.Value = PrepareSQLnum(tmpStockLst_Process.QTY,'QTY',-5)
		
		***********************
		PRIVATE cSOitem, cPOitem
		cSOitem	= PrepareSQLtxt( tmpStockLst_Process.SOitem, 'SOitem', 10 )
		cPOitem	= PrepareSQLtxt( tmpStockLst_Process.PO_item, 'POitem', 12 )
		
		PRIVATE cSQL, nSQLEXEC 
		
		ThisForm.lblSOitem.Visible = .F.
		ThisForm.txtSOitem.Visible = .F.
		
		ThisForm.chkSOCmplt.Value = 0
		ThisForm.chkSOCncld.Value = 0
		
		ThisForm.chkSOCmplt.Visible = .F.
		ThisForm.chkSOCncld.Visible = .F.
		
		ThisForm.txtProcess_Qty.Value = 0
		ThisForm.txtPO_Qty.Value = 0
		ThisForm.txtSO_Qty.Value = 0
		
		cSOitem = Proper_SO_Item(cSOitem)
		IF cSOitem != Proper_SO_Item("")
			cSQL = "SELECT Sales.*,AQ.Company, SN.SalesRep "
			cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.AllQuotes AQ WITH(NOLOCK) ON Sales.SOitem = AQ.SOitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales_No SN WITH(NOLOCK) ON Sales.SalesNum = SN.SalesNum"
			cSQL = cSQL + " WHERE Sales.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		
			IF USED("tmpSOitem")
				SELECT tmpSOitem
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSOitem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSOitem')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitem")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpSOitem')
			ELSE
				IF USED("tmpSOitem")
					IF RECCOUNT("tmpSOitem")>0
						ThisForm.lblSOitem.Visible = .T.
						ThisForm.txtSOitem.Visible = .T.
						ThisForm.chkSOCmplt.Visible = .T.
						ThisForm.chkSOCncld.Visible = .T.
							
						ThisForm.txtCompany.Value	= PrepareSQLtxt(tmpSOitem.Company,'Company',30)
						ThisForm.txtSalesRep.Value	= PrepareSQLtxt(tmpSOitem.SalesRep,'SalesRep',20)
						ThisForm.txtSOitem.Value	= cSOitem
		
						ThisForm.chkSOCmplt.Value = PrepareSQLchk(tmpSOitem.Cmplt,'Cmplt')
						ThisForm.chkSOCncld.Value = PrepareSQLchk(tmpSOitem.Cncld,'Cncld')
						
						ThisForm.txtSO_Qty.Value = PrepareSQLnum(tmpSOitem.S_QTY,'QTY',-5)
					ENDIF			
					USE IN tmpSOitem
				ENDIF
			ENDIF
		ENDIF
		**********************************
		
		
		ThisForm.lblPOitem.Visible = .F.
		ThisForm.txtPOitem.Visible = .F.
		
		ThisForm.chkPODelivered.Value = 0
		ThisForm.chkPOCancelled.Value = 0
		ThisForm.chkPOReconciled.Value = 0
		
		ThisForm.chkPODelivered.Visible = .F.
		ThisForm.chkPOCancelled.Visible = .F.
		ThisForm.chkPOService.Visible = .F.
		ThisForm.chkPOConvServ.Visible = .F.
		ThisForm.chkPOEquipment.Visible = .F.
		ThisForm.chkPOReconciled.Visible = .F.
		ThisForm.txtPOCompany.Visible = .F.
		ThisForm.txtPODue.Visible = .F.
		ThisForm.shpPO.Visible = .F.
		ThisForm.cmdSavePO.Visible = .F.
		
		cPOitem = Proper_PO_Item(cPOitem)
		IF cPOitem != Proper_PO_Item("")
			cSQL = "SELECT * FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		
			IF USED("tmpPOitem")
				SELECT tmpPOitem
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPOitem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPOitem')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitem")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpPOitem')
			ELSE
				IF USED("tmpPOitem")
					IF RECCOUNT("tmpPOitem")>0
						ThisForm.lblPOitem.Visible = .T.
						ThisForm.txtPOitem.Visible = .T.
						ThisForm.chkPODelivered.Visible = .T.
						ThisForm.chkPOCancelled.Visible = .T.
						ThisForm.chkPOService.Visible = .T.
						ThisForm.chkPOConvServ.Visible = .T.
						ThisForm.chkPOEquipment.Visible = .T.
						ThisForm.chkPOReconciled.Visible = .T.
						ThisForm.txtPOCompany.Visible = .T.
						ThisForm.txtPODue.Visible = .T.
						ThisForm.shpPO.Visible = .T.
						ThisForm.cmdSavePO.Visible = .T.
							
						ThisForm.txtPOItem.Value	= cPOItem
						
						ThisForm.chkPODelivered.Value = PrepareSQLchk(tmpPOitem.Delivered,'Delivered')
						ThisForm.chkPOCancelled.Value = PrepareSQLchk(tmpPOitem.Cancelled,'Cancelled')
						
						ThisForm.chkPOService.Value = PrepareSQLchk(tmpPOitem.Services,'Services')
						ThisForm.chkPOConvServ.Value = PrepareSQLchk(tmpPOitem.ConvServ,'ConvServ')
						ThisForm.chkPOEquipment.Value = PrepareSQLchk(tmpPOitem.Equipment,'Equipment')
						ThisForm.chkPOReconciled.Value = PrepareSQLchk(tmpPOitem.Reconciled,'Reconciled')
						
						ThisForm.txtPOCompany.Value = PrepareSQLtxt(tmpPOitem.Company,'Company',30)
						ThisForm.txtPOCompany.DisabledBackColor = RGB(240,240,240)
						
						ThisForm.txtPODue.Value = tmpPOitem.Due_Min
						
						ThisForm.txtPO_QTY.Value = PrepareSQLnum(tmpPOitem.StockLst_QTY,'StockLst_QTY',-5)
						
					ELSE
						ThisForm.lblPOitem.Visible = .T.
						ThisForm.txtPOitem.Visible = .T.
						ThisForm.txtPOItem.Value	= cPOItem
						ThisForm.txtPOCompany.Visible = .T.
						ThisForm.txtPOCompany.Value = "No PO!"
						ThisForm.txtPOCompany.DisabledBackColor = RGB(255,0,0)
						
						ThisForm.txtPO_QTY.Value = 0
						
					ENDIF				
					USE IN tmpPOitem
				ENDIF
			ENDIF
		ENDIF
		
		**********************************
		PRIVATE lCmplt,lCncld,cProcess_ID 
		lCmplt	= PrepareSQLlogic(ThisForm.chkSOCmplt.Value,"Cmplt")
		lCncld	= PrepareSQLlogic(ThisForm.chkSOCncld.Value,"Cncld")
		cProcess_ID = PrepareSQLtxt(ThisForm.txtProcess_ID.Value,'Process_ID',10)
		
		IF lCmplt OR lCncld OR ( cProcess_ID ='CANCELLED' OR cProcess_ID ='CORRECTION')
			ThisForm.cmdSORemove.Visible = .T.
		ELSE
			ThisForm.cmdSORemove.Visible = .F.
		ENDIF
		
		**********************************
		PRIVATE lPOdelivered,lPOCncld, lPOReconciled
		lPOdelivered	= PrepareSQLlogic(ThisForm.chkPODelivered.Value,"Delivered")
		lPOCncld		= PrepareSQLlogic(ThisForm.chkPOCancelled.Value,"Cncld")
		lPOReconciled	= PrepareSQLlogic(ThisForm.chkPOReconciled.Value,"Reconciled")
		
		IF lPOdelivered OR lPOCncld OR lPOReconciled
			ThisForm.cmdPORemove.Visible = .T.
		ELSE
			ThisForm.cmdPORemove.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF USED("tmpStockLst_Process")
			USE IN tmpStockLst_Process
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
	ENDPROC

	PROCEDURE cmdAdminRemove.Click
		PRIVATE nStockLst_ProcessID_Detail_Process
		nStockLst_ProcessID_Detail_Process= PrepareSQLnum(tmpStockLst_Process.ID_Detail_Process,'ID_Detail_Process',-3)
		
		
		IF nStockLst_ProcessID_Detail_Process < 1
			MESSAGEBOX("No StockLst_Process.ID_Detail_Process",16,"Process=0")
			RETURN .F.
		ENDIF
		
		PRIVATE cTBL
		DO CASE
		CASE tmpStockLst_Process.Stk="S"
			cTBL = "S"
		CASE tmpStockLst_Process.Stk="B"
			cTBL = "B"
		CASE tmpStockLst_Process.Stk="W"
			cTBL = "W"
		OTHERWISE
			MESSAGEBOX("No StockLst ",16,"Unknown Table")
			
			RETURN .F.
		ENDCASE
		
		PRIVATE pOrderType, pOrderNumber, pWhat
		pOrderType	= ""
		pOrderNumber = ""
		pWhat	= "CORRECTION"
		
		PRIVATE lReturn
		lReturn = .T.
		
		lReturn = Remove_ID_Detail_Process(nStockLst_ProcessID_Detail_Process, pOrderType, pOrderNumber, cTbl, ThisForm.nConnHandle, pWhat)
		
		********************************
		ThisForm.ReloadStockLst_Process()
		
		RETURN lReturn
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdNext.Click
		SELECT tmpStockLst_Process
		IF !EOF()
			SKIP 1 IN tmpStockLst_Process
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN tmpStockLst_Process
		ENDIF
		
		ThisForm.StockLst_Process_Change()
		
		ThisForm.grdStockLst_Process.Refresh
		
	ENDPROC

	PROCEDURE cmdPORemove.Click
		PRIVATE nStockLst_ProcessID_Detail_Process
		nStockLst_ProcessID_Detail_Process= PrepareSQLnum(tmpStockLst_Process.ID_Detail_Process,'ID_Detail_Process',-3)
		
		IF nStockLst_ProcessID_Detail_Process < 1
			MESSAGEBOX("No StockLst_Process.ID_Detail_Process",16,"Process=0")
			RETURN .F.
		ENDIF
		
		PRIVATE cTBL
		DO CASE
		CASE tmpStockLst_Process.Stk="S"
			cTBL = "S"
		CASE tmpStockLst_Process.Stk="B"
			cTBL = "B"
		CASE tmpStockLst_Process.Stk="W"
			cTBL = "W"
		OTHERWISE
			MESSAGEBOX("No StockLst ",16,"Unknown Table")
			
			RETURN .F.
		ENDCASE
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,"POitem",12)
		
		IF Proper_PO_item(cPOitem) = Proper_PO_item("")
			MESSAGEBOX("No POitem ",16,"Unknown PO item")
			RETURN .F.	
		ENDIF
		
		PRIVATE pOrderType, pOrderNumber, pWhat
		pOrderType	= "POitem"
		pOrderNumber = cPOitem
		pWhat	= "CANCELLED"
		
		PRIVATE lReturn
		lReturn = .T.
		
		PRIVATE lPOdelivered,lPOCncld,lPOReconciled
		lPOdelivered	= PrepareSQLlogic(ThisForm.chkPODelivered.Value,"Delivered")
		lPOCncld		= PrepareSQLlogic(ThisForm.chkPOCancelled.Value,"Cncld")
		lPOReconciled	= PrepareSQLlogic(ThisForm.chkPOReconciled.Value,"Reconciled")
		
		
		lReturn = Remove_ID_Detail_Process(nStockLst_ProcessID_Detail_Process, pOrderType, pOrderNumber, cTbl, ThisForm.nConnHandle, pWhat)
		
		*!*	PRIVATE cSQL, nSQLEXEC 
		
		
		*!*		
		*!*		*Remove Cancelled process from StockLst and BrokerLst
		*!*		*Remove_ID_Detail_Process(nStockLst_ProcessID_Detail_Process,"SOitem",cSOitem,cTBL,ThisForm.nConnHandle,'CANCELLED')
		*!*		
		*!*		cSQL = "DELETE FROM "
		*!*		DO CASE
		*!*		CASE cTBL = "S"
		*!*			cSQL = cSQL + " dbo.StockLst_Process "
		*!*		CASE cTBL = "B"
		*!*			cSQL = cSQL + " dbo.BrokerLst_Process "
		*!*		CASE cTBL = "W"
		*!*			cSQL = cSQL + " dbo.WIPLst_Process "
		*!*		ENDCASE
		*!*		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nStockLst_ProcessID_Detail_Process)
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0 &&Try again!, long triger
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*			ENDDO
		*!*		ENDIF
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
		*!*			lReturn = .F.
		*!*		ENDIF
		
		*!*	ENDIF
		
		*!*	************************
		
		*!*	IF lPOdelivered AND NOT lPOCncld
		*!*		*Add Reason to StockLst Process
		*!*		IF cLST = "STK"
		*!*			cSQL = "UPDATE dbo.StockLst_Process "
		*!*		ELSE
		*!*			cSQL = "UPDATE dbo.BrokerLst_Process "
		*!*		ENDIF
		*!*		cSQL = cSQL+" SET [comment]="+"'Completed PO, using StockLst Process Review'"
		*!*		cSQL = cSQL+",[process_id] ='CANCELLED'"
		*!*		cSQL = cSQL+",[processor]=SUBSTRING(suser_sname(),CHARINDEX('\',suser_sname() )+1 ,20 )"
		*!*		cSQL = cSQL+" WHERE ID_Detail_Process="+STR(nStockLst_ProcessID_Detail_Process)
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		*!*		ELSE
		*!*			lReturn = .F.
		*!*		ENDIF
		*!*				
		*!*		
		*!*		*Remove Complete process from StockLst and BrokerLst
		*!*		IF cLST = "STK"
		*!*			cSQL = "DELETE FROM dbo.StockLst_Process "
		*!*		ELSE
		*!*			cSQL = "DELETE FROM dbo.BrokerLst_Process "
		*!*		ENDIF
		*!*		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nStockLst_ProcessID_Detail_Process)
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
		*!*			lReturn = .F.
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	************************
		
		*!*	IF lPOReconciled AND NOT lPOdelivered AND NOT lPOCncld
		*!*		*Add Reason to StockLst Process
		*!*		IF cLST = "STK"
		*!*			cSQL = "UPDATE dbo.StockLst_Process "
		*!*		ELSE
		*!*			cSQL = "UPDATE dbo.BrokerLst_Process "
		*!*		ENDIF
		*!*		cSQL = cSQL+" SET [comment]="+"'Completed PO, using StockLst Process Review'"
		*!*		cSQL = cSQL+",[process_id] ='CANCELLED'"
		*!*		cSQL = cSQL+",[processor]=SUBSTRING(suser_sname(),CHARINDEX('\',suser_sname() )+1 ,20 )"
		*!*		cSQL = cSQL+" WHERE ID_Detail_Process="+STR(nStockLst_ProcessID_Detail_Process)
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		*!*		ENDDO
		*IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		*!*		ELSE
		*!*			lReturn = .F.
		*!*		ENDIF
		*!*				
		*!*		
		*!*		*Remove Complete process from StockLst and BrokerLst
		*!*		IF cLST = "STK"
		*!*			cSQL = "DELETE FROM dbo.StockLst_Process "
		*!*		ELSE
		*!*			cSQL = "DELETE FROM dbo.BrokerLst_Process "
		*!*		ENDIF
		*!*		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nStockLst_ProcessID_Detail_Process)
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
		*!*			lReturn = .F.
		*!*		ENDIF
		*!*		
		*!*		
		*!*		**Update PurchaseOrder
		*!*		*If Reconciled, then it is Complete!
		*!*		PRIVATE cPOitem	
		*!*		cPOitem	= PrepareSQLtxt( tmpStockLst_Process.PO_item, 'POitem', 12 )
		*!*		cPOitem = Proper_PO_Item(cPOitem)
		*!*		
		*!*		cSQL = "UPDATE dbo.PurchaseOrder "
		*!*		cSQL = cSQL + " SET Delivered = 1 "
		*!*		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
		*!*			lReturn = .F.
		*!*		ENDIF
		*!*	ENDIF
		
		
		********************************
		ThisForm.ReloadStockLst_Process()
		
		RETURN lReturn
		
	ENDPROC

	PROCEDURE cmdPrev.Click
		
		SELECT tmpStockLst_Process
		IF !BOF()
			SKIP -1 IN tmpStockLst_Process
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file' NOWAIT
			GO TOP IN tmpStockLst_Process
		ENDIF
		
		ThisForm.StockLst_Process_Change()
		
		ThisForm.grdStockLst_Process.Refresh
	ENDPROC

	PROCEDURE cmdSavePO.Click
		*Only Visible if Admin
		
		PRIVATE cPOitem
		cPOitem	= PrepareSQLtxt( tmpStockLst_Process.PO_item, 'POitem', 12 )
		
		IF cPOitem = Proper_PO_Item('')
			RETURN .F.
		ENDIF
		
		PRIVATE lDelivered,lCancelled,lServices,lConvServ,lEquipment
		lDelivered = PrepareSQLlogic(ThisForm.chkPODelivered.Value,'Delivered')
		lCancelled = PrepareSQLlogic(ThisForm.chkPOCancelled.Value,'Cancelled')
					
		lServices = PrepareSQLlogic(ThisForm.chkPOService.Value,'Services')
		lConvServ = PrepareSQLlogic(ThisForm.chkPOConvServ.Value,'ConvServ')
		lEquipment = PrepareSQLlogic(ThisForm.chkPOEquipment.Value,'Equipment')
		
		PRIVATE cMess
		cMess= "UPDATE dbo.PurchaseOrder "
		cMess= cMess+ " SET "+CHR(13)
		cMess= cMess+ " Delivered="+IIF(lDelivered,'1','0')+CHR(13)
		cMess= cMess+ ",Cancelled="+IIF(lCancelled,'1','0')+CHR(13)
		cMess= cMess+ ",Services="+IIF(lServices,'1','0')+CHR(13)
		cMess= cMess+ ",ConvServ="+IIF(lConvServ,'1','0')+CHR(13)
		cMess= cMess+ ",Equipment="+IIF(lEquipment,'1','0')+CHR(13)
		cMess= cMess+ " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"+CHR(13)
		
		IF MESSAGEBOX(cMess+CHR(13)+" Are your sure you want to update?",4+32,"Update PorchaseOrder?")= 6
			*
		ELSE
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "UPDATE dbo.PurchaseOrder "
		cSQL = cSQL + " SET "
		cSQL = cSQL + " Delivered="+IIF(lDelivered,'1','0')
		cSQL = cSQL + ",Cancelled="+IIF(lCancelled,'1','0')
		cSQL = cSQL + ",Services="+IIF(lServices,'1','0')
		cSQL = cSQL + ",ConvServ="+IIF(lConvServ,'1','0')
		cSQL = cSQL + ",Equipment="+IIF(lEquipment,'1','0')
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC,'')
			lReturn = .F.
		ENDIF
		
		********************************
		ThisForm.ReloadStockLst_Process()
		
		
	ENDPROC

	PROCEDURE cmdSORemove.Click
		PRIVATE nStockLst_ProcessID_Detail_Process
		nStockLst_ProcessID_Detail_Process= PrepareSQLnum(tmpStockLst_Process.ID_Detail_Process,'ID_Detail_Process',-3)
		
		IF nStockLst_ProcessID_Detail_Process < 1
			MESSAGEBOX("No StockLst_Process.ID_Detail_Process",16,"Process=0")
			RETURN .F.
		ENDIF
		
		PRIVATE cTBL
		DO CASE
		CASE tmpStockLst_Process.Stk="S"
			cTBL = "S"
		CASE tmpStockLst_Process.Stk="B"
			cTBL = "B"
		CASE tmpStockLst_Process.Stk="W"
			cTBL = "W"
		OTHERWISE
			MESSAGEBOX("No StockLst ",16,"Unknown Table")
			
			RETURN .F.
		ENDCASE
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(ThisForm.txtSOitem.Value,"SOitem",10)
		
		IF Proper_SO_item(cSOitem) = Proper_SO_item("")
			MESSAGEBOX("No SOitem ",16,"Unknown SO item")
			RETURN .F.	
		ENDIF
		
		PRIVATE pOrderType, pOrderNumber, pWhat
		pOrderType	= "SOitem"
		pOrderNumber = cSOitem
		pWhat	= "CANCELLED"
		
		PRIVATE lReturn
		lReturn = .T.
		
		lReturn = Remove_ID_Detail_Process(nStockLst_ProcessID_Detail_Process, pOrderType, pOrderNumber, cTbl, ThisForm.nConnHandle, pWhat)
		
		PRIVATE lCncld
		lCncld	= PrepareSQLlogic(ThisForm.chkSOCncld.Value,"Cncld")
		PRIVATE lCmplt
		lCmplt	= PrepareSQLlogic(ThisForm.chkSOCmplt.Value,"Cmplt")
		
		PRIVATE cProcess_ID
		cProcess_ID = PrepareSQLtxt(tmpStockLst_Process.Process_ID,'Process_ID',10)
		
		* cProcess_ID ='CANCELLED' OR cProcess_ID ='CORRECTION')
		
		********************************
		ThisForm.ReloadStockLst_Process()
		
		RETURN lReturn
		
	ENDPROC

	PROCEDURE grdStockLst_Process.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.StockLst_Process_Change()
	ENDPROC

	PROCEDURE lblPOitem.Click
		PRIVATE cHPAPOItem
		cHPAPOItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',13)
		
		PRIVATE cParameters
		cParameters = "&"+"cHPAPOItem="+(cHPAPOItem)
		cParameters = STRTRAN(cParameters,' ','%20')
		
		PRIVATE cURL
		cURL = get_Report_Server()+"%2fHPA+Purchasing+Reports%2fPurchaseOrders+POitem&rs:Command=Render"+cParameters
		
		PRIVATE loHyperlink
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(cURL)
		RELEASE loHyperlink
		
		*!*	DECLARE INTEGER ShellExecute IN shell32.dll ;
		*!*	   INTEGER hndWin, STRING cAction, STRING cFileName, ;
		*!*	   STRING cParams, STRING cDir, INTEGER nShowWin
		*!*	ShellExecute(0,"open",cURL,"","",1)
		
	ENDPROC

	PROCEDURE lblSOitem.Click
		PRIVATE cSOItem
		cSOItem= PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		
		PRIVATE cParameters
		cParameters = "&"+"cSOitem="+(cSOItem)
		
		cParameters = STRTRAN(cParameters,' ','%20')
		
		PRIVATE cURL
		cURL = get_Report_Server()+"%2fHPA+Sales+Reports%2fSalesOrder+SOitem&rs:Command=Render"+cParameters
		
		PRIVATE loHyperlink
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(cURL)
		RELEASE loHyperlink
		
		
	ENDPROC

ENDDEFINE
