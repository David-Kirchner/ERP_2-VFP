	PROCEDURE frmShowDup.cmdEditOrig.Click
		IF This.Caption = "Edit"
			ThisFormset.frmShowDup.txtCompany.ReadOnly = .F.
			ThisFormset.frmShowDup.txtCustomer.ReadOnly = .F.
			ThisFormset.frmShowDup.txtAddr1.ReadOnly = .F.
			ThisFormset.frmShowDup.txtAddr2.ReadOnly = .F.
			ThisFormset.frmShowDup.txtCity.ReadOnly = .F.
			ThisFormset.frmShowDup.txtST.ReadOnly = .F.
			ThisFormset.frmShowDup.txtZip.ReadOnly = .F.
			ThisFormset.frmShowDup.txtCountry.ReadOnly = .F.
			ThisFormset.frmShowDup.txtContact.ReadOnly = .F.
			ThisFormset.frmShowDup.txtTelephone.ReadOnly = .F.
			ThisFormset.frmShowDup.txtFax_Number.ReadOnly = .F.
			ThisFormset.frmShowDup.txtEmail.ReadOnly = .F.
			ThisFormset.frmShowDup.chkInActive.ReadOnly = .F.
			
			ThisForm.cmdCancelEdit.Visible = .T.
			ThisFormSet.frmRemoveDup.Visible = .F.
			ThisForm.grdSold.ReadOnly = .T.
			ThisForm.chkOrig.ReadOnly = .T.
			ThisForm.chkDup.ReadOnly = .T.	
			ThisForm.cmdRemoveDup.Visible = .F.	
			ThisForm.cmdExit.Visible = .F.	
			
			This.Caption = "Save"
		ELSE
			*Save
			*company,customer,addr1,addr2,city,st,zip,country,contact,telephone,fax_number,email,soldcode AS AddrCode,inactive,lastedit
			PRIVATE	nAddrCode
			PRIVATE lcCompany,lcCustomer,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,lcContact
			PRIVATE lcPhone,lcFax,lcEmail,lInActive
						
			*PrepareSQLtxt("Space Alloys USA'",'Company',25)
			
			lcCompany  =PrepareSQLtxt(ThisForm.txtCompany.VALUE,'Company',100)
			lcCustomer = PrepareSQLtxt(ThisForm.txtCustomer.VALUE,'Customer',100)
			lcAddr1 = PrepareSQLtxt(ThisForm.txtAddr1.VALUE,'Addr1',100)
			lcAddr2 = PrepareSQLtxt(ThisForm.txtAddr2.VALUE,'Addr2',100)
			lcCity  = PrepareSQLtxt(ThisForm.txtCity.VALUE,'City',50)
			lcST    = PrepareSQLtxt(ThisForm.txtST.VALUE,'State',50)
			lcZip   = PrepareSQLtxt(ThisForm.txtZip.VALUE,'Zip',50)
			lcCountry = PrepareSQLtxt(ThisForm.txtCountry.VALUE,'Country',50)
			lcContact = PrepareSQLtxt(ThisForm.txtContact.VALUE,'Contact',100)
			lcPhone   = PrepareSQLtxt(ThisForm.txtTelePhone.VALUE,'Phone',50)
			lcFax	  = PrepareSQLtxt(ThisForm.txtFax_Number.VALUE,'Fax',12)
			lcEmail   = PrepareSQLtxt(ThisForm.txtEmail.VALUE,'Email',60)
			nAddrCode = PrepareSQLnum(THISFORM.txtCode.Value,'ShipAddr',-3,0)
		
		
		
		
			PRIVATE cTable
			DO CASE
			CASE ThisFormset.frmRemoveDup.opgTable.Value = 1
				cTABLE = 'SOLDADDR'
			CASE ThisFormset.frmRemoveDup.opgTable.Value = 2
				cTABLE = 'SHIPADDR'
			ENDCASE
		
		
			PRIVATE cSQLu
			cSQLu= "UPDATE "
			DO CASE
			CASE cTABLE = 'SOLDADDR'
				cSQLu= cSQLu+ "dbo.SoldAddr"
			CASE cTABLE = 'SHIPADDR'
				cSQLu= cSQLu+ "dbo.ShipAddr"
			ENDCASE
			cSQLu= cSQLu+" SET "
			cSQLu= cSQLu+" Company='"+lcCompany+"'"
			cSQLu= cSQLu+",Customer='"+lcCustomer+"'"
			cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
			cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
			cSQLu= cSQLu+",City='"+lcCity+"'"
			cSQLu= cSQLu+",ST='"+lcST+"'"
			cSQLu= cSQLu+",Zip='"+lcZip+"'"
			cSQLu= cSQLu+",Country='"+lcCountry+"'"
			cSQLu= cSQLu+",Contact='"+lcContact+"'"
			cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
			cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
			cSQLu= cSQLu+",Email='"+lcEmail+"'"
			cSQLu= cSQLu+",LastEdit='"+DTOC(DATE())+"'"
			DO CASE
			CASE cTABLE = 'SOLDADDR'
				cSQLu= cSQLu+ " WHERE SoldCode = "+STR(nAddrCode)
			CASE cTABLE = 'SHIPADDR'
				cSQLu= cSQLu+ " WHERE ShipCode = "+STR(nAddrCode)
			ENDCASE
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu ,ThisFormSet.nConnHandle, nSQLEXEC, '')
			ELSE
				WAIT WINDOW 'Saved' NOWAIT
				
				ThisFormSet.GetDuplicateAddr(ThisFormset.frmRemoveDup.lstCompany.Value)
			ENDIF
							
			
			
			ThisFormset.frmShowDup.txtCompany.ReadOnly = .T.
			ThisFormset.frmShowDup.txtCustomer.ReadOnly = .T.
			ThisFormset.frmShowDup.txtAddr1.ReadOnly = .T.
			ThisFormset.frmShowDup.txtAddr2.ReadOnly = .T.
			ThisFormset.frmShowDup.txtCity.ReadOnly = .T.
			ThisFormset.frmShowDup.txtST.ReadOnly = .T.
			ThisFormset.frmShowDup.txtZip.ReadOnly = .T.
			ThisFormset.frmShowDup.txtCountry.ReadOnly = .T.
			ThisFormset.frmShowDup.txtContact.ReadOnly = .T.
			ThisFormset.frmShowDup.txtTelephone.ReadOnly = .T.
			ThisFormset.frmShowDup.txtFax_Number.ReadOnly = .T.
			ThisFormset.frmShowDup.txtEmail.ReadOnly = .T.
			ThisFormset.frmShowDup.chkInActive.ReadOnly = .T.
			
			ThisForm.cmdCancelEdit.Visible = .F.
			ThisFormSet.frmRemoveDup.Visible = .T.
			ThisForm.grdSold.ReadOnly = .F.
			ThisForm.chkOrig.ReadOnly = .F.
			ThisForm.chkDup.ReadOnly = .F.	
			ThisForm.cmdRemoveDup.Visible = .T.	
			ThisForm.cmdExit.Visible = .T.
			
			This.Caption = "Edit"
		ENDIF
	ENDPROC

	PROCEDURE frmShowDup.cmdExit.Click
		ThisForm.Visible = .F.
		ThisFormSet.Release
	ENDPROC

	PROCEDURE frmShowDup.cmdRemoveDup.Click
		
		SELECT tmpduplicates 
		PRIVATE nNumOrig, nNumDup,cTalk
		cTalk = SET('TALK')
		SET TALK OFF
		CALCULATE COUNT(Orig) FOR Orig = 1 TO nNumOrig
		CALCULATE COUNT(Dup) FOR Dup = 1 TO nNumDup
		SET TALK &cTalk
		
		
		PRIVATE lOK
		lOK = .T.
		DO CASE
		CASE nNumOrig = 0
			MESSAGEBOX("No 'Orig' Address marked!",48,"Cannot process")
			lOK = .f.
		CASE nNumOrig = 1
			lOK = .T.
		OTHERWISE
			MESSAGEBOX("Only one Address can be marked 'Orig'!",48,"Cannot process")
			lOK = .F.
		ENDCASE
		
		IF lOK 
			IF nNumDup < 1
				MESSAGEBOX("No 'Duplicate' was Check for removal",48,"Cannot process")
				lOK=.F.
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		
		IF lOK
			SELECT tmpduplicates 
			*Get the Orig AddrCode
			LOCATE FOR Orig = 1
			IF FOUND()
				nAddrCode = tmpduplicates.AddrCode
			ELSE
				nAddrCode = ThisForm.txtCode.Value
			ENDIF
			
			IF nAddrCode < 1
				MESSAGEBOX("Bad 'Orig' Address Code.",16,"Abort")
				lOK = .F.
			ENDIF
		ENDIF
		
		PRIVATE cTable	
		IF lOK
			DO CASE
			CASE ThisFormset.frmRemoveDup.opgTable.Value = 1
				cTable = 'SOLDADDR'
			CASE ThisFormset.frmRemoveDup.opgTable.Value = 2
				cTable = 'SHIPADDR'
			OTHERWISE
				lOK  = .F.
			ENDCASE
		ENDIF
		
		PRIVATE lRollBack
		IF lOK
			SELECT tmpduplicates 
			SCAN FOR Dup = 1
				lRollBack = .F.
				= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2)  && Manual transactions
		
				nRemoveCode = tmpduplicates.AddrCode
				********************************************************dbo.Sales_No_History
				*Replace the Duplicate AddrCode in Sales with the Orig
				DO CASE
				CASE cTable = 'SOLDADDR'
					*Sales_No pSoldAddr
					cSQL = "UPDATE dbo.Sales_No SET pSoldAddr = "+ALLTRIM(STR(nAddrCode))+" WHERE pSoldAddr = "+ALLTRIM(STR(nRemoveCode))
				CASE cTable = 'SHIPADDR'
					*Sales_No pShipAddr
					cSQL = "UPDATE dbo.Sales_No SET pShipAddr = "+ALLTRIM(STR(nAddrCode))+" WHERE pShipAddr = "+ALLTRIM(STR(nRemoveCode))	
				OTHERWISE
					lOK  = .F.	
					lRollBack = .T.
				ENDCASE
				
				IF lOK
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
						lRollBack = .T.
					ENDIF
				ENDIF
						
				********************************************************
				IF NOT lRollBack 
					*Replace the Duplicate AddrCode in Sales with the Orig IN HISTORY
					DO CASE
					CASE cTable = 'SOLDADDR'
						*Sales_No pSoldAddr
						cSQL = "UPDATE dbo.Ar_Sales_No_History SET pSoldAddr = "+ALLTRIM(STR(nAddrCode))+" WHERE pSoldAddr = "+ALLTRIM(STR(nRemoveCode))
					CASE cTable = 'SHIPADDR'
						*Sales_No pShipAddr
						cSQL = "UPDATE dbo.Ar_Sales_No_History SET pShipAddr = "+ALLTRIM(STR(nAddrCode))+" WHERE pShipAddr = "+ALLTRIM(STR(nRemoveCode))		
					OTHERWISE
						lOK  = .F.
						lRollBack = .T.
					ENDCASE
					
					IF lOK
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							lRollBack = .T.
						ENDIF		
					ENDIF
				ENDIF
						
				********************************************************
				IF NOT lRollBack 
					*Remove the duplicate AddrCode
					DO CASE
					CASE cTable = 'SOLDADDR'
						cSQL = "DELETE FROM dbo.SoldAddr WHERE SoldCode = "+ALLTRIM(STR(nRemoveCode))
					CASE cTable = 'SHIPADDR'
						cSQL = "DELETE FROM dbo.ShipAddr WHERE ShipCode = "+ALLTRIM(STR(nRemoveCode))
					OTHERWISE
						lOK  = .F.
						lRollBack = .T.
					ENDCASE		
					
					
					
					IF lOK
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							lRollBack = .T.
						ENDIF
					ENDIF			
		
				ENDIF
				
				********************************************************
				IF lRollBack
					= SQLROLLBACK(ThisFormSet.nConnHandle)
					= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans				
					MESSAGEBOX("Removal of Duplicates Failed"+CHR(13)+"for Duplicate AddrCode="+ALLTRIM(STR(nRemoveCode)),48,"Table Rolled Back")
				ELSE
					= SQLCOMMIT(ThisFormSet.nConnHandle)
					= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans				
				ENDIF
				
				SELECT tmpduplicates 
			ENDSCAN
			
			ThisFormSet.GetDuplicateAddr(ThisFormset.frmRemoveDup.lstCompany.Value)
			ThisFormSet.OrigAddr('HIDE')
			ThisForm.grdSold.SetFocus
			
		ELSE
			*Did not find record to 	
		ENDIF
	ENDPROC

	PROCEDURE frmShowDup.grdSold.AfterRowColChange
		LPARAMETERS nColIndex
		ThisFormSet.DuplicatesChanged()
	ENDPROC

	PROCEDURE frmShowDup.grdSold.clmDup.Check1.Valid
		
		
		This.parent.parent.Refresh
	ENDPROC

	PROCEDURE frmShowDup.grdSold.clmDup.Check1.When
		IF tmpDuplicates.Inactive
			RETURN .F.
		ENDIF
		IF tmpDuplicates.Orig = 1
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE frmShowDup.grdSold.clmOrig.Check1.Valid
		PRIVATE nAddrCode, nRecno, nOrig
		nAddrCode = tmpDuplicates.AddrCode
		nRecno = RECNO('tmpDuplicates')
		nOrig = This.Value
		
		IF nOrig=1
			UPDATE tmpDuplicates SET Orig = 0 WHERE AddrCode != nAddrCode
			GOTO (nRecNo)
			REPLACE tmpDuplicates.Dup WITH 0
			
			ThisFormSet.OrigAddr("SHOW")
		ELSE
		*	UPDATE tmpDuplicates SET Orig = 1 WHERE AddrCode != nAddrCode
			UPDATE tmpDuplicates SET Orig = 0 WHERE AddrCode = nAddrCode
			GOTO (nRecNo)
			REPLACE tmpDuplicates.Dup WITH 0
			
			ThisFormSet.OrigAddr("HIDE")
		ENDIF
		This.parent.parent.Refresh
	ENDPROC

	PROCEDURE frmShowDup.grdSold.clmOrig.Check1.When
		RETURN !tmpDuplicates.Inactive
	ENDPROC

	PROCEDURE frmShowDup.grdSold.Column16.Check1.Valid
		This.parent.parent.Refresh
	ENDPROC

ENDDEFINE
