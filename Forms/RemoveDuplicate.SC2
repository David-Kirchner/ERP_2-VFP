			ThisFormset.frmShowDup.txtCustomer.ReadOnly = .T.
			ThisFormset.frmShowDup.txtAddr1.ReadOnly = .T.
			ThisFormset.frmShowDup.txtAddr2.ReadOnly = .T.
			ThisFormset.frmShowDup.txtCity.ReadOnly = .T.
			ThisFormset.frmShowDup.txtST.ReadOnly = .T.
			ThisFormset.frmShowDup.txtZip.ReadOnly = .T.
			ThisFormset.frmShowDup.txtCountry.ReadOnly = .T.
			ThisFormset.frmShowDup.txtContact.ReadOnly = .T.
			ThisFormset.frmShowDup.txtTelephone.ReadOnly = .T.
			ThisFormset.frmShowDup.txtFax_Number.ReadOnly = .T.
			ThisFormset.frmShowDup.txtEmail.ReadOnly = .T.
