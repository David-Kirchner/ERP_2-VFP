			ThisFormset.frmShowDup.txtContact.Visible = .T.
			ThisFormset.frmShowDup.txtTelephone.Visible = .T.
			ThisFormset.frmShowDup.txtFax_Number.Visible = .T.
			ThisFormset.frmShowDup.txtEmail.Visible = .T.
