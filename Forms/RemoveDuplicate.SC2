	PROCEDURE duplicateschanged
		*ThisForm.DuplicatesChanged()
		
		ThisFormset.frmShowDup.chkOrig.refresh
		ThisFormset.frmShowDup.chkDup.Refresh
		
		ThisFormset.frmShowDup.txtCode.Value = tmpDuplicates.AddrCode
		ThisFormset.frmShowDup.txtLastEdit.Value = tmpDuplicates.LastEdit
		
		
	ENDPROC

	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(SOitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpSOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpSOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		CASE tmpDuplicates.Orig
			nColor = RGB( 192, 220, 192 )  &&GREEN
		CASE tmpDuplicates.Dup
			nColor = RGB( 255, 0, 0 ) &&RED	
		CASE tmpDuplicates.Inactive
			nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE getdupdata
		PARAMETERS nAddrCode
		*ThisFormSet.getDupData()
		
		IF VARTYPE(nAddrCode) != 'N'
			nAddrCode = 0
		ENDIF
		
		PRIVATE cTable
		DO CASE
		CASE ThisFormset.frmRemoveDup.opgTable.Value = 1
			cTABLE = 'SOLDADDR'
		CASE ThisFormset.frmRemoveDup.opgTable.Value = 2
			cTABLE = 'SHIPADDR'
		ENDCASE
			
			
			
		ThisFormset.frmRemoveDup.lstCompany.RowSource = ''
		
		PRIVATE cSQL
		IF nAddrCode > 0
			cSQL = "SELECT DISTINCT LEFT(S.Company, 10) AS Company "
			cSQL = cSQL + ",( SELECT COUNT(*) AS CNTD FROM dbo."
			cSQL = cSQL + cTABLE 
			cSQL = cSQL + " S2 WHERE LEFT(S.Company,10) = LEFT(S2.Company,10) ) AS Cntd "
			cSQL = cSQL + " FROM dbo."
			cSQL = cSQL + cTABLE 
			cSQL = cSQL + " S "
			cSQL = cSQL + " WHERE "
			DO CASE
			CASE cTABLE = 'SOLDADDR'
				cSQL = cSQL + "SoldCode = "+STR(nAddrCode)
			CASE cTABLE = 'SHIPADDR'
				cSQL = cSQL + "ShipCode = "+STR(nAddrCode)
			ENDCASE
			cSQL = cSQL + " AND LEN(LEFT(S.Company, 10)) > 5 "
			cSQL = cSQL + " ORDER BY CNTD DESC "
		ELSE
			cSQL = "SELECT DISTINCT LEFT(S.Company, 10) AS Company "
			cSQL = cSQL + ",( SELECT COUNT(*) AS CNTD FROM dbo."
			cSQL = cSQL + cTABLE 
			cSQL = cSQL + " S2 WHERE LEFT(S.Company,10) = LEFT(S2.Company,10) ) AS Cntd "
			cSQL = cSQL + " FROM dbo."
			cSQL = cSQL + cTABLE 
			cSQL = cSQL + " S "
			cSQL = cSQL + " WHERE LEN(LEFT(S.Company, 10)) > 5 "
			cSQL = cSQL + " ORDER BY CNTD DESC "
		ENDIF
		*cSQL = "SELECT 'COPPER & B' AS Company "
		
		PRIVATE nSQLEXEC
		IF USED('tmpDupAddr')	
			USE IN tmpDupAddr
		ENDIF
		
		WAIT WINDOW "Please wait, the most duplicated company names will show top down, takes forever..." NOWAIT
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpDupAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpDupAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpDupAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpDupAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpDupAddr')
		ENDIF
		
		IF USED('tmpDupAddr')
			ThisFormset.frmRemoveDup.lstCompany.RowSource = 'tmpDupAddr'
			ThisFormset.frmRemoveDup.lstCompany.Refresh
			
			ThisFormSet.GetDuplicateAddr(tmpDupAddr.Company)
		ENDIF
		
		WAIT CLEAR
		
	ENDPROC

	PROCEDURE getduplicateaddr
		PARAMETERS cCompany10
		*ThisFormSet.GetDuplicateAddr(Company)
		
		IF VARTYPE(cCompany10) != 'C'
			RETURN .F.
		ENDIF
		IF EMPTY(cCompany10)
			RETURN .F.
		ENDIF
		cCompany10 = PrepareSQLtxt(cCompany10,'Company10',10)	&&use could add a ' that needs ESCAPED
		
		ThisFormset.frmShowDup.grdSold.RecordSource = ""
		IF USED('tmpDuplicates')	
			USE IN tmpDuplicates
		ENDIF
		
		
		PRIVATE cTable
		DO CASE
		CASE ThisFormset.frmRemoveDup.opgTable.Value = 1
			cTABLE = 'SOLDADDR'
		CASE ThisFormset.frmRemoveDup.opgTable.Value = 2
			cTABLE = 'SHIPADDR'
		ENDCASE
		
		PRIVATE cSQL
		cSQL = "SELECT 0 AS Orig, 0 AS Dup "
		cSQL = cSQL + ",company,customer,addr1,addr2,city,st,zip,country,contact,telephone,fax_number,email,"
		DO CASE
		CASE cTABLE = 'SOLDADDR'
			cSQL = cSQL + "SoldCode AS AddrCode"
		CASE cTABLE = 'SHIPADDR'
			cSQL = cSQL + "ShipCode AS AddrCode"
		ENDCASE
		cSQL = cSQL + ",ISNULL(inactive,0) AS Inactive,lastedit"
		cSQL = cSQL + " FROM dbo."+cTABLE 
		cSQL = cSQL + " WHERE LEFT(Company,10) = '"+cCompany10+"'"
		cSQL = cSQL + " ORDER BY ST, City "
		
		
		PRIVATE nSQLEXEC
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpDuplicates')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpDuplicates')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpDuplicates")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpDuplicates")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpDuplicates')
		ENDIF
		
		IF USED('tmpDuplicates')
			ThisFormset.frmShowDup.grdSold.RecordSource = "tmpDuplicates"
			ThisFormset.frmShowDup.grdSold.SetAll("dynamicbackcolor","IIF(tmpDuplicates.Orig=1,RGB(192,220,192),IIF(tmpDuplicates.Dup=1,RGB(255,128,128),IIF(tmpDuplicates.Inactive,RGB(128,128,128),RGB(255,255,255))))", "Column")
			
			ThisFormset.frmShowDup.grdSold.clmCompany.Text1.ReadOnly = .T.
			ThisFormset.frmShowDup.grdSold.clmCustomer.Text1.ReadOnly = .T.
			ThisFormset.frmShowDup.grdSold.clmAddr1.Text1.ReadOnly = .T.
			
			
			ThisFormset.frmShowDup.grdSold.Refresh
		
			ThisFormset.frmShowDup.lblMarkOrig.Visible = .T.
			ThisFormSet.DuplicatesChanged()
			ThisFormset.frmShowDup.grdSold.Visible = .T.
			
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS cTable, nAddrCode
		
		IF VARTYPE(cTable) = "C"
			cTable = UPPER(ALLTRIM(cTable))
			DO CASE
			CASE cTable = 'SOLDADDR'
				ThisFormset.frmRemoveDup.opgTable.Value = 1
			CASE cTable = 'SHIPADDR'
				ThisFormset.frmRemoveDup.opgTable.Value = 2
			OTHERWISE
			
			ENDCASE
		ENDIF
			
		
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF VARTYPE(nAddrCode) = 'N'
			
			ThisFormSet.getDupData(nAddrCode)
			
			
			**************************
			PRIVATE cCompany
			cCompany = ""
			
			PRIVATE cSQL
			cSQL = "SELECT LEFT(Company, 10) AS Company "
			cSQL = cSQL + " FROM dbo."+cTABLE 
			cSQL = cSQL + " WHERE "
			DO CASE
			CASE cTABLE = 'SOLDADDR'
				cSQL = cSQL + "SoldCode = "+STR(nAddrCode)
			CASE cTABLE = 'SHIPADDR'
				cSQL = cSQL + "ShipCode = "+STR(nAddrCode)
			ENDCASE
		
			PRIVATE nSQLEXEC
			IF USED('tmpCodeCompany')	
				USE IN tmpCodeCompany
			ENDIF
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCodeCompany')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCodeCompany')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCodeCompany")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCodeCompany")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCodeCompany')
			ENDIF
		
			IF USED('tmpCodeCompany')
				IF VARTYPE(tmpCodeCompany.Company) = "C"
					cCompany = tmpCodeCompany.Company
					ThisFormset.frmRemoveDup.lstCompany.Value = cCompany
				ENDIF
				USE IN tmpCodeCompany
			ENDIF
		
			
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		
		
		PRIVATE nConnHandle
		nConnHandle = get_SQLSTRINGCONNECT()
		*ThisFormSet.nConnHandle
		
		PRIVATE cSQL
		cSQL = "SELECT  CAST(0 AS bit) AS Orig, CAST(0 AS bit) AS Dup "
		cSQL = cSQL + ",0 AS AddrCode, CAST(0 AS bit) AS Inactive, '' AS LastEdit"
		PRIVATE nSQLEXEC
		
		IF USED('tmpDupAddr')
			USE IN tmpDupAddr
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConnHandle, cSQL, 'tmpDupAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConnHandle, cSQL, 'tmpDupAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(nConnHandle, cSQL, "tmpDupAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConnHandle, cSQL, "tmpDupAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConnHandle, nSQLEXEC, 'tmpDupAddr')
		ENDIF
		
		********************
		IF USED('tmpDuplicates')	
			USE IN tmpDuplicates
		ENDIF
		
		PRIVATE cSQL
		
		cSQL = "SELECT 0 AS Orig, 0 AS Dup "
		cSQL = cSQL + ",company,customer,addr1,addr2,city,st,zip,country,contact,telephone,fax_number,email,soldcode AS AddrCode,inactive,lastedit"
		cSQL = cSQL + " FROM dbo.SoldAddr WITH(NOLOCK) "
		*cSQL = cSQL + ",shipcode,inactive,lastedit,company,customer,addr1,addr2,city,st,zip,country,contact,telephone,fax_number,email,ShipPay,ShipRoute,Blind"
		*cSQL = cSQL + " FROM dbo.ShipAddr "
		cSQL = cSQL + " WHERE 0>0"
		
		
		PRIVATE nSQLEXEC
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConnHandle, cSQL, 'tmpDuplicates')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConnHandle, cSQL, 'tmpDuplicates')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(nConnHandle, cSQL, "tmpDuplicates")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(nConnHandle, cSQL, "tmpDuplicates")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConnHandle, nSQLEXEC, 'tmpDuplicates')
		ENDIF
		
		= SQLDISCONNECT(nConnHandle)
		
		*****************************
		
		
	ENDPROC

	PROCEDURE origaddr
		PARAMETERS pShow
		*ThisFormSet.OrigAddr()
		*SHOW or HIDE
