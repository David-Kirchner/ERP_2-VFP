	PROCEDURE Init
		IF USED('Quote21')
			SELECT Quote21
			*(Pieces N(10,2), Q_QTY N(12,4), DESCRIPT C(254), LBS N(9,1), Q_P N(12,4), PU N(2), TotalP N(12,4),Cmnt m
			*, RecNum N(8), Regret L, Services L, InqNumP C(9), OtherP m )
		ELSE
			MESSAGEBOX("Lost Quote Table",16,"Cannot continue.")
			TrackError("Lost Quote Table"+CHR(13)+"No Quote21 table on INIT","Lost Quote Table", PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(1))
		ENDIF
		
		ThisForm.grdRecNum.Column1.ControlSource = Quote21.RecNum
		
		ThisForm.grdRecNum.Column1.SetFocus
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		IF NOT USED('Quote21')
			USE "C:\Program Files (x86)\HPA\MEM\Quote21.dbf"
		ENDIF
		IF NOT USED('Quote21')
			MESSAGEBOX("Cannot Access 'Quote21' table",16,"error")
			TrackError("'Quote21' table was to be opened in libs\hpa.vcx :SendQuote. ","Cannot Access 'Quote21' table", PROGRAM(), LINENO(1))
			ThisForm.Release
		ENDIF
		
		
		*COPY TO "C:\Program Files (x86)\HPA\MEM\Quote21.dbf"
		SELECT Quote21
		GO TOP
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE refreshform
		*ThisForm.RefreshForm()
		ThisForm.txtRecNum.Refresh
		ThisForm.txtPieces.Refresh
		ThisForm.txtUnitQty.Refresh
		ThisForm.EdtDescript.Refresh
		ThisForm.txtLBS.Refresh
		ThisForm.txtUnitPrice.Refresh
		
		ThisForm.txtPU.Refresh
		ThisForm.txtPrice.Refresh
		ThisForm.edtComment.Refresh
		ThisForm.edtOtherP.Refresh
		
		IF DELETED('Quote21')
			ThisForm.BackColor = RGB(255,0,0)
			ThisForm.cmdRemove.Caption = "Recall"
		ELSE
			ThisForm.BackColor = RGB(240,240,240)
			ThisForm.cmdRemove.Caption = "Remove"
		ENDIF
		
		ThisForm.grdRecNum.Column1.SetFocus
		
	ENDPROC

	PROCEDURE saveedit
		*ThisForm.SaveEdit()
		
		*CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuote21) FREE (Pieces N(10,2), UnitQty N(10,2), DESCRIPT C(254), LBS N(10,1), UnitP N(12,4), Unit C(3), TotalP N(12,4),Cmnt m, RecNum N(8), Regret L, Services L, InqNumP C(9), OtherP m )
		*USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fnQuote21) EXCL ALIAS Quote21
		*
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+ThisForm.fnQuote) FREE (Pieces N(10,2), Q_QTY N(12,4), DESCRIPT C(254), LBS N(9,1), Q_P N(12,4), PU N(2), TotalP N(12,4),Cmnt m, RecNum N(8), Regret L, Services L, InqNumP C(9), OtherP m )
		PRIVATE nPieces, nUnitQty, cDescript, nLBS, nUnitP, cUnit, nTotalP, cCmnt, nRecnum, cOtherP
		
		nPieces		= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',10,2)
		nUnitQty	= PrepareSQLnum(ThisForm.txtUnitQty.Value,'UnitQty',10,2)
		cDescript	= PrepareSQLtxt(ThisForm.edtDescript.Value,'Descript',254)
		nLBS		= PrepareSQLnum(ThisForm.txtLBS.Value,'LBS',10,1)
		nUnitP		= PrepareSQLnum(ThisForm.txtUnitPrice.Value,'UnitP',12,4)
		
		nPU 		= PrepareSQLnum(ThisForm.txtPU.Value,'PU',-1)
		nTotalP		= PrepareSQLnum(ThisForm.txtPrice.Value,'TotalP',12,4)
		cCmnt		= PrepareSQLtxt(ThisForm.EdtComment.Value,'Cmnt',-1)
		nRecnum		= PrepareSQLnum(ThisForm.txtRecNum.Value,'RecNum',8,0)
		cOtherP 	= PrepareSQLtxt(ThisForm.edtOtherP.Value,'OtherP',254)
		
		UPDATE Quote21 SET ;
			  Pieces = nPieces ;
			, Q_Qty=nUnitQty;
			, Descript=cDescript;
			, LBS=nLBS ;
			, Q_P=nUnitP ;
			, PU=nPU ;
			, TotalP=nTotalP ;
			, Cmnt=cCmnt ;
			, OtherP=cOtherP ;
			WHERE RecNum = nRecnum
		
			
		
		RETURN .T.
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			* open for Edit
			ThisForm.isEditing = .T.
			ThisForm.txtPieces.Enabled = .T.
			ThisForm.txtUnitQty.Enabled = .T.
			ThisForm.EdtDescript.Enabled = .T.
			ThisForm.txtLBS.Enabled = .T.
			ThisForm.txtUnitPrice.Enabled = .T.
		
			ThisForm.txtPU.Enabled = .T.
			ThisForm.txtprice.Enabled = .T.
			ThisForm.edtComment.Enabled = .T.
			ThisForm.edtOtherP.Enabled = .T.
			
			ThisForm.cmdTop.Enabled = .F.
			ThisForm.cmdprev.Enabled = .F.
			ThisForm.cmdnext.Enabled = .F.
			ThisForm.cmdLast.Enabled = .F.
			ThisForm.cmdPreview.Enabled = .F.
			ThisForm.cmdRemove.Caption = "Cancel"
			ThisForm.cmdExit.Enabled = .F.
			
			
			This.Caption = "Save"
		ELSE
			PRIVATE nRecNum 
			nRecNum = Quote21.Recnum
			
			IF ThisForm.SaveEdit()
				
				ThisForm.isEditing = .F.
				ThisForm.txtPieces.Enabled = .F.
				ThisForm.txtUnitQty.Enabled = .F.
				ThisForm.EdtDescript.Enabled = .F.
				ThisForm.txtLBS.Enabled = .F.
				ThisForm.txtUnitPrice.Enabled = .F.
		
				ThisForm.txtPU.Enabled = .F.
				ThisForm.txtprice.Enabled = .F.
				ThisForm.edtComment.Enabled = .F.
				ThisForm.edtOtherP.Enabled = .F.
		
				ThisForm.cmdTop.Enabled = .T.
				ThisForm.cmdprev.Enabled = .T.
				ThisForm.cmdnext.Enabled = .T.
				ThisForm.cmdLast.Enabled = .T.
				ThisForm.cmdPreview.Enabled = .T.
				ThisForm.cmdRemove.Caption = "Remove"
				ThisForm.cmdExit.Enabled = .T.
		
				This.Caption = "Edit"
				
				SELECT Quote21
				LOCATE FOR RecNum = nRecNum
				
				ThisForm.grdRecNum.Column1.SetFocus
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdLast.Click
		SELECT Quote21
		GO BOTTOM IN Quote21
		WAIT WINDOW 'End of File' NOWAIT
		ThisForm.RefreshForm()
		
	ENDPROC

	PROCEDURE cmdNext.Click
		SELECT Quote21
		IF !EOF()
			SKIP 1 IN Quote21
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN Quote21
		ENDIF
		ThisForm.RefreshForm()
		
	ENDPROC

	PROCEDURE cmdPrev.Click
		SELECT Quote21
		IF !BOF()
			SKIP -1 IN Quote21
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file' NOWAIT
			GO TOP IN Quote21
		ENDIF
		ThisForm.RefreshForm()
		
	ENDPROC

	PROCEDURE cmdPreview.Click
		SELECT Quote21
		GO BOTTOM IN Quote21
		
		PRIVATE cInqnumP, cReciptEmail
		cInqnumP	= ''
		cReciptEmail = ''
		
		*In Proc_Quotes
		CreateHTML_Quote(cInqnumP, cReciptEmail)
	ENDPROC

	PROCEDURE cmdRemove.Click
		
		SELECT Quote21
		
		PRIVATE nRecNum
		nRecNum = Quote21.RecNum
		
		IF This.Caption = "Remove"
		
			IF NOT DELETED()
				DELETE FROM Quote21 WHERE RecNum = nRecNum
			ENDIF
		
			LOCATE FOR RecNum = nRecNum 
		
			ThisForm.RefreshForm()
		
		ELSE
			IF This.Caption = "Cancel"
				ThisForm.isEditing = .F.
				ThisForm.txtPieces.Enabled = .F.
				ThisForm.txtUnitQty.Enabled = .F.
				ThisForm.EdtDescript.Enabled = .F.
				ThisForm.txtLBS.Enabled = .F.
				ThisForm.txtUnitPrice.Enabled = .F.
		
				ThisForm.txtPU.Enabled = .F.
				ThisForm.txtprice.Enabled = .F.
				ThisForm.edtComment.Enabled = .F.
				ThisForm.edtOtherP.Enabled = .F.
		
		
				ThisForm.cmdTop.Enabled = .T.
				ThisForm.cmdprev.Enabled = .T.
				ThisForm.cmdnext.Enabled = .T.
				ThisForm.cmdPreview.Enabled = .T.
				ThisForm.cmdLast.Enabled = .T.
				ThisForm.cmdExit.Enabled = .T.
				
				This.Caption = "Remove"
				ThisForm.cmdEdit.Caption = "Edit"
				
			ELSE
				*Recall
				
				IF DELETED()
					RECALL FOR RecNum = nRecNum
				ENDIF
				
				LOCATE FOR RecNum = nRecNum 
		
				ThisForm.RefreshForm()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdTerms.Click
		DO FORM \FORMS\QuoteTerms
		
	ENDPROC

	PROCEDURE cmdTop.Click
		SELECT Quote21
		GO TOP IN Quote21
		WAIT WINDOW 'Top of File' NOWAIT
		ThisForm.RefreshForm()
	ENDPROC

	PROCEDURE grdRecNum.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshForm()
	ENDPROC

	PROCEDURE lblPrice.Click
		PRIVATE nUnitPrice, nPU, nTotalPrice, nOrderQty, nUnitQty, nNewTotalPrice 
		*(Pieces N(10,2), UnitQty N(10,2), Descript C(254), LBS N(10,1), UnitP N(12,4), Unit C(3), TotalP N(12,4),Cmnt M, recnum N(8) )
		nUnitPrice	= PrepareSQLnum(ThisForm.txtUnitPrice.Value,'UnitP',12,4)
		
		nPU			= PrepareSQLnum(ThisForm.txtPU.Value,'PU',-1)
		nTotalPrice	= PrepareSQLnum(ThisForm.txtPrice.Value,'TotalP',12,4)
		nUnitQty	= PrepareSQLnum(ThisForm.txtUnitQty.Value,'UnitQty',10,2)
		
		IF nTotalPrice = 0
			nTotalPrice = nUnitPrice * nUnitQty
			ThisForm.txtPrice.Value = nTotalPrice 
		ELSE
			nNewTotalPrice = nUnitPrice * nUnitQty
			IF nTotalPrice*1.1 >  nNewTotalPrice OR nTotalPrice/1.1 <  nNewTotalPrice
				IF MESSAGEBOX("Do you want to replace the Total Price with the new Value "+ALLTRIM(STR(nNewTotalPrice,14,4)),4+48,"New Total Price") = 6
					ThisForm.txtPrice.Value = nNewTotalPrice
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtUnitPrice.Valid
		PRIVATE nUnitPrice, nPU, nTotalPrice, nOrderQty, nUnitQty, nNewTotalPrice 
		*(Pieces N(10,2), UnitQty N(10,2), Descript C(254), LBS N(10,1), UnitP N(12,4), Unit C(3), TotalP N(12,4),Cmnt M, recnum N(8) )
		nUnitPrice	= PrepareSQLnum(This.Value,'UnitP',12,4)
		
		nPU			= PrepareSQLnum(ThisForm.txtPU.Value,'PU',-1)
		nTotalPrice	= PrepareSQLnum(ThisForm.txtPrice.Value,'TotalP',12,4)
		nUnitQty	= PrepareSQLnum(ThisForm.txtUnitQty.Value,'UnitQty',10,2)
		
		IF nTotalPrice = 0
			nTotalPrice = nUnitPrice * nUnitQty
			ThisForm.txtPrice.Value = nTotalPrice 
		ELSE
			nNewTotalPrice = nUnitPrice * nUnitQty
			IF nTotalPrice*1.1 >  nNewTotalPrice OR nTotalPrice/1.1 <  nNewTotalPrice
				IF MESSAGEBOX("Do you want to replace the Total Price with the new Value "+ALLTRIM(STR(nNewTotalPrice,14,4)),4+48,"New Total Price") = 6
					ThisForm.txtPrice.Value = nNewTotalPrice
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

ENDDEFINE
