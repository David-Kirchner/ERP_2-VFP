	*< OBJECTDATA: ObjPath="lblSalesP" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAdd2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblCurrSalesP" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblCustID" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: ctable
		*p: holdnumber		&& Return selection
		*p: ncode
		*p: nconnhandle
