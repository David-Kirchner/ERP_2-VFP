	ADD OBJECT 'lblCurrSalesP' AS label WITH ;
		Alignment = 2, ;
		BackStyle = 0, ;
		Caption = "SalesP", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 80, ;
		Name = "lblCurrSalesP", ;
		ToolTipText = "Your SalesP", ;
		Top = 92, ;
		Visible = .F., ;
		Width = 64
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblCustID' AS label WITH ;
		BackStyle = 0, ;
		Caption = "CustID", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 8, ;
		Name = "lblCustID", ;
		ToolTipText = "Sage Cust ID", ;
		Top = 34, ;
