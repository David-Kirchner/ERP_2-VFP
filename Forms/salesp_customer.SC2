		Top = 92, ;
		Visible = .F., ;
		Width = 64
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblSalesPs' AS label WITH ;
		Alignment = 1, ;
		BackColor = 255,255,128, ;
		BackStyle = 0, ;
		Caption = "lblSalesP_Customer", ;
		FontSize = 9, ;
		ForeColor = 0,0,255, ;
		Height = 14, ;
		Left = 8, ;
		Name = "lblSalesPs", ;
		TabIndex = 38, ;
		ToolTipText = "List of SalesP", ;
		Top = 116, ;
		Width = 60
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblSoldCode' AS label WITH ;
		BackStyle = 0, ;
		Caption = "SoldCode", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 7, ;
		Name = "lblSoldCode", ;
		ToolTipText = "the SoldCode", ;
		Top = 51, ;
		Width = 77
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Init
		PARAMETER nCode, cSalesP, pCompany, pCustID
		*DO FORM Forms\SalesP_Customer WITH 10010,'D',cCompany, cCustID
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF USED("tmpSalesP_C")
			USE IN tmpSalesP_C
		ENDIF
		
		IF TYPE("nCode") != "N"
			MESSAGEBOX("Bad Parameter - No Address Code",16,"Error")
			RETURN .F.
		ELSE
			ThisForm.nCode = nCode
		ENDIF
		
		ThisForm.cTable = "SOLDADDR"
		*******************
		IF VARTYPE(pCompany) = "C"
			cCompany = pCompany
		ELSE
			cCompany = GetCompanyfromSoldAddr(nCode,ThisForm.nConnHandle)
		ENDIF
		
		ThisForm.lblCompany.Caption = cCompany
		
		********************
		IF VARTYPE(pCustID) = "C"
			ThisForm.lblCustID.Caption = pCustID
		ELSE
			*Get CustID
			IF USED('tmpSalesNAddr')
				USE IN tmpSalesNAddr
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT TOP 1 CustID FROM dbo.QuickCompany "
			cSQL = cSQL + " WHERE Company = '"+cCompany+"'"
			cSQL = cSQL + " AND LEN(CustID)>0 "
			cSQL = cSQL + " ORDER BY LastEdit DESC "
		
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSalesNAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSalesNAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesNAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesNAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSalesNAddr')
			ENDIF
			IF USED('tmpSalesNAddr')
				IF RECCOUNT('tmpSalesNAddr') > 0
					cCustID = tmpSalesNAddr.CustID
				ENDIF
				USE IN tmpSalesNAddr
			ENDIF
			
			IF NOT EMPTY(cCustID)
				ThisForm.lblCustID.Caption = cCustID
			ENDIF
		ENDIF
		
		********************
		PRIVATE cNoNoiseName
		cNoNoiseName = ''
		
		IF USED('tmpNoNoiseName')
			USE IN tmpNoNoiseName
		ENDIF
		SELECT 0
		
		PRIVATE cSQL,nSQLEXEC
		cSQL = "SELECT NoNoiseName FROM dbo.SoldAddr WHERE SoldCode = "+STR(nCode)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNoNoiseName' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNoNoiseName' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpNoNoiseName")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpNoNoiseName")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpNoNoiseName')
		ENDIF
		
		IF USED('tmpNoNoiseName')
			IF NOT EOF('tmpNoNoiseName')
				IF VARTYPE(tmpNoNoiseName.NoNoiseName) = "C"
					cNoNoiseName= tmpNoNoiseName.NoNoiseName
				ENDIF		
			ENDIF
			USE IN tmpNoNoiseName
		ENDIF
			
		
		ThisForm.lblNoNoiseName.Caption = cNoNoiseName
		*********************
		ThisForm.lblSoldCode.Caption = STR(nCode)
		*********************
		ThisForm.lblSalesP.Caption = ''
		IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			ThisForm.lblSalesP.Caption = m.SalesP
			ThisForm.cmdAdd.Caption = "Add '"+m.SalesP+"'"
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
				ThisForm.lblSalesP.Caption = m.SalesP
				ThisForm.cmdAdd.Caption = "Add '"+m.SalesP+"'"
			ELSE
				ThisForm.lblSalesP.Caption = ''
				ThisForm.cmdAdd.Enabled = .F.
			ENDIF
		ENDIF
		*********************	
		IF VARTYPE(cSalesP) = "C"
			ThisForm.lblCurrSalesP.Caption = cSalesP
			ThisForm.cmdAdd2.Caption = "Add '"+cSalesP+"'"
		ELSE	
			ThisForm.lblCurrSalesP.Caption = ''
			ThisForm.cmdAdd2.Enabled = .F.
		ENDIF
		
		*********************
		PRIVATE cSalesPs
		cSalesPs = getSalesP_Customer( nCode ,ThisForm.nConnHandle)
		ThisForm.lblSalesPs.Caption = cSalesPs
			
		**********************
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		
		ThisForm.OrigTable = ALIAS()
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpSalesP_C')
			USE IN tmpSalesP_C
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdAdd.Click
		PRIVATE pConn, lNewConn
		lNewConn = .F.
		
		PRIVATE nSoldCode
		nSoldCode = ThisForm.nCode
		PRIVATE cNoNoiseName,cCustomer,cCustID,cSalesP,nSoldCode
		cNoNoiseName	= PrepareSQLtxt(ThisForm.lblNoNoiseName.Caption,'NoNoiseName',30)
		cCustomer		= PrepareSQLtxt(thisForm.lblCompany.Caption,'Customer',30)
		cCustID			= PrepareSQLtxt(thisForm.lblCustID.Caption,'CustID',20)
		cSalesP			= PrepareSQLtxt(ThisForm.lblSalesP.Caption,'SalesP',1)
		cSalesPs		= PrepareSQLtxt(ThisForm.lblSalesPs.Caption,'SalesP',1)
		nSoldCode		= ThisForm.nCode
		
		IF nSoldCode < 1
			MESSAGEBOX("No SoldCode, Cannot Save!",0+16,"error")
			RETURN .F.
		ENDIF
		IF EMPTY(cSalesP)
			MESSAGEBOX("No SalesP, Cannot Save!",0+16,"error")
			RETURN .F.
		ENDIF
		
		IF cSalesP $ cSalesPs
			MESSAGEBOX("SalesP "+cSalesP+" is already in list "+ALLTRIM(cSalesPs)+", Cannot Save!",0+16,"error")
			RETURN .F.
		ENDIF
		
		
		IF MESSAGEBOX("Are you sure you want to save SalesP:"+cSalesP+" to "+cCustomer,4+48,"Save") != 6
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "INSERT dbo.SalesP_Customer "
		cSQL = cSQL +"(SoldCode,SalesP,NoNoiseName,Customer,CustID) VALUES ("
		cSQL = cSQL +STR(nSoldCode)
		cSQL = cSQL +",'"+cSalesP+"'"
		cSQL = cSQL +",'"+cNoNoiseName+"'"
		cSQL = cSQL +",'"+cCustomer+"'"
		cSQL = cSQL +",'"+cCustID+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		ELSE
			WAIT WINDOW "Successfully Saved" TIMEOUT 1
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE cmdAdd2.Click
		PRIVATE pConn, lNewConn
		lNewConn = .F.
		
		PRIVATE nSoldCode
		nSoldCode = ThisForm.nCode
		PRIVATE cNoNoiseName,cCustomer,cCustID,cSalesP,nSoldCode
		cNoNoiseName	= PrepareSQLtxt(ThisForm.lblNoNoiseName.Caption,'NoNoiseName',30)
		cCustomer		= PrepareSQLtxt(thisForm.lblCompany.Caption,'Customer',30)
		cCustID			= PrepareSQLtxt(thisForm.lblCustID.Caption,'CustID',20)
		cSalesP			= PrepareSQLtxt(ThisForm.lblCurrSalesP.Caption,'SalesP',1)
		cSalesPs		= PrepareSQLtxt(ThisForm.lblSalesPs.Caption,'SalesP',1)
		nSoldCode		= ThisForm.nCode
		
		IF nSoldCode < 1
			MESSAGEBOX("No SoldCode, Cannot Save!",0+16,"error")
			RETURN .F.
		ENDIF
		IF EMPTY(cSalesP)
			MESSAGEBOX("No SalesP, Cannot Save!",0+16,"error")
			RETURN .F.
		ENDIF
		
		IF cSalesP $ cSalesPs
			MESSAGEBOX("SalesP "+cSalesP+" is already in list "+ALLTRIM(cSalesPs)+", Cannot Save!",0+16,"error")
			RETURN .F.
		ENDIF
		
		
		IF MESSAGEBOX("Are you sure you want to save SalesP:"+cSalesP+" to "+cCustomer,4+48,"Save") != 6
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "INSERT dbo.SalesP_Customer "
		cSQL = cSQL +"(SoldCode,SalesP,NoNoiseName,Customer,CustID) VALUES ("
		cSQL = cSQL +STR(nSoldCode)
		cSQL = cSQL +",'"+cSalesP+"'"
		cSQL = cSQL +",'"+cNoNoiseName+"'"
		cSQL = cSQL +",'"+cCustomer+"'"
		cSQL = cSQL +",'"+cCustID+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		ELSE
			WAIT WINDOW "Successfully Saved" TIMEOUT 1
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE cmdCancel.Click
		*PRIVATE cHoldNumber
		*cHoldNumber = ""
		*ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

ENDDEFINE
