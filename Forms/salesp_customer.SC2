	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth.ico
		AutoCenter = .T.
		BackColor = 1,255,230
		BorderStyle = 0
		Caption = "SalesP to Customer"
		ClipControls = .F.
