		ctable = ''
		DoCreate = .T.
		Height = 140
		holdnumber = ""
		LockScreen = .F.
		MDIForm = .T.
		Name = "frmSalesP_Customer"
		ncode = 0
		nconnhandle = 0
		origtable = ""
		ShowTips = .T.
		Width = 150
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdAdd' AS commandbutton WITH ;
		Caption = "Add", ;
		ForeColor = 0,0,0, ;
		Height = 24, ;
		Left = 2, ;
		Name = "cmdAdd", ;
		TabIndex = 4, ;
		TerminateRead = .T., ;
		Top = 65, ;
		Width = 70
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdAdd2' AS commandbutton WITH ;
		Caption = "Add", ;
		ForeColor = 0,0,0, ;
		Height = 24, ;
		Left = 78, ;
		Name = "cmdAdd2", ;
		TabIndex = 4, ;
		TerminateRead = .T., ;
		Top = 65, ;
		Width = 70
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdCancel' AS commandbutton WITH ;
		BackColor = 255,128,128, ;
		Caption = "Exit", ;
		ForeColor = 0,0,0, ;
		Height = 24, ;
		Left = 84, ;
		Name = "cmdCancel", ;
		TabIndex = 5, ;
		TerminateRead = .T., ;
