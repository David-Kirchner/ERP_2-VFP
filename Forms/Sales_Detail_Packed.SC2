	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmp_SD_PS.cancelled,,RGB( 255, 0, 0 ),IIF(tmp_SD_PS.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		
		*!*	DO CASE
		*!*	CASE tmp_SD_PS.cancelled
		*!*		nColor = RGB( 255, 0, 0 ) &&RED	
		*!*	CASE tmp_SD_PS.delivered
		*!*		nColor = RGB( 128, 128, 128 )  &&Grey
		*!*	OTHERWISE 
				nColor = RGB( 255, 255, 255 ) &&WHITE
		*!*	ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pcSOitem, pcHeat
		*DO FORM Forms\Sales_Detail_Packed WITH cSOitem, cHeat 
		*DO FORM Forms\Sales_Detail_Packed WITH ' 128842-01','64092-4RAA'
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF USED("tmp_SD_PS")
			USE IN tmp_SD_PS
		ENDIF
		
		IF VARTYPE("pcSOitem") != "C"
			RETURN
		ENDIF
		
		IF Proper_SO_Item(pcSOitem) = Proper_SO_Item('')
			RETURN
		ENDIF
		
		IF VARTYPE(pcHeat) != "C"
			RETURN
		ENDIF
		
		PRIVATE cSOitem, cHeat
		cSOitem = Proper_SO_Item(pcSOitem)
		cHeat	= PrepareSQLtxt(pcHeat,'Heat',50,.f.)
		
		*ThisForm.nSales_Detail_ID = pnSales_Detail_ID
		
		*************************
		
		ThisForm.Caption = ThisForm.Caption+" for SO item '"+pcSOitem+"'"
		
		IF USED('tmp_SD_PS')
			USE IN tmp_SD_PS
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM dbo.Sales_Detail_PackingSlip "
		cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
		
		cSQL = cSQL +" OR ( "
		cSQL = cSQL +" Heat LIKE '"+ALLTRIM(cHeat)+"%'"
		cSQL = cSQL +" AND [When] > GETDATE()-90 "
		*IF LEN(cLot)> 0	&&Lot is combined into heat at packingSlip
		*	cSQL = cSQL +" AND LOT = '"+cLot+"'"
		*ENDIF
		cSQL = cSQL +" ) "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_SD_PS')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmp_SD_PS' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_SD_PS")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_SD_PS")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmp_SD_PS' )
		ENDIF
		
		IF NOT USED('tmp_SD_PS')
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmp_SD_PS') = 0
			RETURN .F.
		ENDIF
			
		ThisForm.grd.RecordSource = "tmp_SD_PS"
		*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		********************************
		ThisForm.grd.Column1.Controlsource = "tmp_SD_PS.PackingSli"
		ThisForm.grd.Column2.Controlsource = "tmp_SD_PS.SOitem"
		ThisForm.grd.Column3.Controlsource = "tmp_SD_PS.Descript"
		ThisForm.grd.Column4.Controlsource = "tmp_SD_PS.QTY"
		ThisForm.grd.Column5.Controlsource = "tmp_SD_PS.Pieces"
		ThisForm.grd.Column6.Controlsource = "tmp_SD_PS.Pounds"
		ThisForm.grd.Column7.Controlsource = "tmp_SD_PS.Heat"
		ThisForm.grd.Column8.Controlsource = "tmp_SD_PS.When"
		
		ThisForm.grd.Column1.Header1.Caption = "PackingSli"
		ThisForm.grd.Column2.Header1.Caption= "SoItem"
		ThisForm.grd.Column3.Header1.Caption= "Descript"
		ThisForm.grd.Column4.Header1.Caption= "QTY"
		ThisForm.grd.Column5.Header1.Caption= "Pieces"
		ThisForm.grd.Column6.Header1.Caption= "Pounds"
		ThisForm.grd.Column7.Header1.Caption= "Heat"
		ThisForm.grd.Column8.Header1.Caption= "When"
			
		********************************
		ThisForm.txtPackingSli.Value = PrepareSQLnum(tmp_SD_PS.PackingSli,'PackingSli',-3)
		ThisForm.txtHeat.Value		= tmp_SD_PS.Heat
		ThisForm.txtDescription.Value = tmp_SD_PS.Descript
		Thisform.txtPieces.Value	= PrepareSQLnum(tmp_SD_PS.Pieces,'Pieces',-3)
		ThisForm.txtQTY.Value		= PrepareSQLnum(tmp_SD_PS.QTY,'QTY',-5)
		Thisform.txtPounds.Value 	= PrepareSQLnum(tmp_SD_PS.Pounds,'Pounds',-3)
		ThisForm.txtWhen.Value 		= tmp_SD_PS.When
		
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		ThisForm.OrigTable = ALIAS()
		
	ENDPROC

	PROCEDURE Resize
		PRIVATE nHigh, nWidth
		
		nHigh = ThisForm.Height - 281
		nWidth = ThisForm.Width - 592
		
		ThisForm.grd.Width = 580 + nWidth
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmp_SD_PS')
			USE IN tmp_SD_PS
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		*RETURN ThisForm.HoldNumber
		RETURN
	ENDPROC

	PROCEDURE cmdCancel.Click
		*!*	PRIVATE cHoldNumber
		*!*	cHoldNumber = ""
		*!*	ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

ENDDEFINE
