	PROCEDURE Init
		LPARAMETERS toFormSet
		IF VARTYPE(toFormSet) = "O"
			ThisForm.oCertFormSet = toFormSet
			* Share cert formset private data session (ERPCert_Co, ERPCert, etc.)
			* DataSession = 2 is set at design time (read-only at runtime)
			This.DataSessionID = toFormSet.DataSessionID
		ENDIF
		*ThisForm.Left = 224  &&W484 L206
		*ThisForm.Top = 420  &&H171 T213
	ENDPROC

	PROCEDURE cmdAdd.Click
		
		IF This.Caption = "Add"
			*Check Permision
			MESSAGEBOX("Only Users with Cert Permision"+CHR(13)+"will be allowed to Save this Edit.",0+48,"Must have Permision")
			
			ThisForm.oCertFormSet.SetCert_CO_Edit(1)
			
			m.ID = ERPCert.ID
			ThisForm.txtCO_ID.Value = 0
			
			ThisForm.SalesNum.Value = 0
			*ThisForm.txtCO_ID.Value = ERPCert.ID
			*ThisForm.ItemSO.Value = 1
			ThisForm.ItemSO.Value = 0
			ThisForm.Company.Value = ''
			ThisForm.POnum.Value = ''
			ThisForm.PartNo.Value = ''
			ThisForm.Pcs.Value = 1
			ThisForm.Description.Value = ''
			ThisForm.oCertFormSet.isediting_co = .T.
			ThisForm.SalesNum.SetFocus
		ELSE
			*Save
			PRIVATE nCertID,nCO_ID,nSalesNum,nItemSO,cCompany,cPONum,cPartNo,nPcs,cDescription,cSOitem
			nCertID		= PrepareSQLnum(ThisForm.oCertFormSet.ERPCert.PF1.pgCert.txtID.Value,'CertID',-3)
			nCO_ID 		= PrepareSQLnum(ThisForm.txtCO_ID.Value,'CO_ID',-3)
			nSalesNum	= PrepareSQLnum(ThisForm.SalesNum.Value,'SalesNum',-3)
			nItemSO		= PrepareSQLnum(ThisForm.ItemSO.Value,'ItemSO',2,0)
			cCompany	= PrepareSQLtxt(ThisForm.Company.Value,'Company',50)
			cPONum		= PrepareSQLtxt(ThisForm.PONum.Value,'PONum',50)
			cPartNo		= PrepareSQLtxt(ThisForm.PartNo.Value,'PartNo',50)
			nPcs		= PrepareSQLnum(ThisForm.PCS.Value,'PCS',-3)
			cDescription = PrepareSQLtxt(ThisForm.Description.Value,'Description',50)
		
			IF nSalesNum > 0
				cSOitem = Proper_SO_Item(STR( m.SalesNum ) +'-'+ STR(nItemSO,2,0))
			ELSE
				cSOitem = SPACE(10)
			ENDIF
			
			TRY
				IF nCO_ID > 0
				
					cSQL = "UPDATE dbo.Cert_Co SET "
					cSQL = cSQL+" SalesNum = "+STR(nSalesNum)
					cSQL = cSQL+", SOitem = '"+cSOitem+"'"
					cSQL = cSQL+", Company = '"+cCompany+"'"
					cSQL = cSQL+", PONum = '"+cPONum+"'"
					cSQL = cSQL+", PartNo = '"+cPartNo+"'"
					cSQL = cSQL+", Pcs = "+STR(nPcs)
					cSQL = cSQL+", [description] = '"+cDescription+"'"
					cSQL = cSQL+" WHERE CO_ID = "+STR(nCO_ID)
		
					nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL  )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.oCertFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					
				ELSE
				
					cSQL = "INSERT INTO dbo.Cert_Co (ID,SalesNum,SOitem,Company,PONum,PartNo,Pcs,[description] ) VALUES ("
					cSQL = cSQL +""+STR(ERPCert.ID)
					cSQL = cSQL +","+STR(nSalesNum)
					cSQL = cSQL +",'"+cSOitem+"'"
					cSQL = cSQL +",'"+cCompany+"'"
					cSQL = cSQL +",'"+cPONum+"'"
					cSQL = cSQL +",'"+cPartNo+"'"
					cSQL = cSQL +","+STR(nPcs)
					cSQL = cSQL +",'"+cDescription+"'"
					cSQL = cSQL +")"
					
					nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL  )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.oCertFormSet.nConnHandle, nSQLEXEC )
					ENDIF
				
					*************************
					
					IF USED('tmpCert_Co')
						USE IN tmpCert_Co 
					ELSE
						SELECT 0
					ENDIF
					
					cSQL = "SELECT CO_ID FROM dbo.Cert_Co WHERE "
					cSQL = cSQL+" SalesNum = "+STR(nSalesNum)
					cSQL = cSQL+"and SOitem = '"+cSOitem+"'"
					cSQL = cSQL+"and Company = '"+cCompany+"'"
					cSQL = cSQL+"and PONum = '"+cPONum+"'"
					cSQL = cSQL+"and PartNo = '"+cPartNo+"'"
					cSQL = cSQL+"and Pcs = "+STR(nPcs)
					cSQL = cSQL+"and [description] = '"+cDescription+"'"
		
					nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, 'tmpCert_Co' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, 'tmpCert_Co' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, "tmpCert_Co")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, "tmpCert_Co")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.oCertFormSet.nConnHandle, nSQLEXEC, 'tmpCert_Co' )
					ENDIF
					
					IF USED('tmpCert_Co')
						IF VARTYPE(tmpCert_Co.CO_ID) = 'N'
							nCO_ID = tmpCert_Co.CO_ID
						ENDIF
						USE IN tmpCert_Co
					ENDIF
				
				ENDIF
		
			CATCH
				MESSAGEBOX("User NOT allowed"+CHR(13)+"No Write Permision",0+16,"User NOT allowed")		
			ENDTRY
				
			ThisForm.oCertFormSet.SetCert_CO_Edit(0)
			ThisForm.oCertFormSet.GetCert_CO(nCertID)
			
		ENDIF
	ENDPROC

	PROCEDURE cmdBlank.Click
		ThisForm.oCertFormSet.ERPCertCoBlank()
		ThisForm.oCertFormSet.SetCert_CO_Edit(1)
	ENDPROC

	PROCEDURE cmdClone.Click
		ThisForm.oCertFormSet.SetCert_CO_Edit(1)
		
		ThisForm.txtCO_ID.Value = 0
		ThisForm.SalesNum.Refresh
		ThisForm.txtCO_ID.Refresh
		ThisForm.ItemSO.Refresh
		ThisForm.Company.Refresh
		ThisForm.POnum.Refresh
		ThisForm.PartNo.Refresh
		ThisForm.Pcs.Refresh
		ThisForm.Description.Refresh
		
		ThisForm.SalesNum.SetFocus
		
	ENDPROC

	PROCEDURE cmdDelete.Click
		PRIVATE nCO_ID, cCompany
		nCO_ID = ThisForm.txtCO_ID.Value
		cCompany = ThisForm.company.Value
		IF nCO_ID > 0
		
			IF MESSAGEBOX("Are you sure you want to 'Delete'"+CHR(13)+cCompany+CHR(13)+"This Record ID "+ALLTRIM(STR(nCO_ID))+"?",4+32,"Delete?") = 6		
				PRIVATE cSQL,nSQLEXEC 
				
				cSQL = "DELETE FROM dbo.Cert_Co WHERE CO_ID ="+STR(nCO_ID)
		
				nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.oCertFormSet.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.oCertFormSet.nConnHandle, nSQLEXEC )
				ENDIF
					
				*refresh
				ThisForm.oCertFormSet.SelectCertID(ThisForm.oCertFormSet.ERPCert.PF1.pgCert.txtID.Value)
				ThisForm.oCertFormSet.GetCert_CO()
				
			ENDIF
		ELSE
			MESSAGEBOX("No Record to Delete",0+16,"No ID")
		ENDIF
		
		ThisForm.oCertFormSet.SetCert_CO_Edit(0)
		
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			ThisForm.oCertFormSet.SetCert_CO_Edit(1)
			ThisForm.txtCO_ID.Value = ERPCert_CO.CO_ID
			ThisForm.SalesNum.SetFocus
		
		ELSE
			*Abort
			ThisForm.oCertFormSet.SetCert_CO_Edit(0)
			ThisForm.oCertFormSet.Refresh_ERPCert('ABORT')
		ENDIF
	ENDPROC

	PROCEDURE Company.When
		RETURN VARTYPE(ThisForm.oCertFormSet) = "O" AND ThisForm.oCertFormSet.isediting_co
	ENDPROC

	PROCEDURE Description.When
		RETURN VARTYPE(ThisForm.oCertFormSet) = "O" AND ThisForm.oCertFormSet.isediting_co
	ENDPROC

	PROCEDURE grdCO.AfterRowColChange
		LPARAMETERS nColIndex
		IF VARTYPE(ThisForm.oCertFormSet) = "O"
			ThisForm.oCertFormSet.RefreshERPCertCo(ERPCert_Co.CO_ID)
		ENDIF
	ENDPROC

	PROCEDURE ItemSO.Valid
		PRIVATE nSalesNum, nItem, cSOitem
		nSalesNum	= PrepareSQLnum(ThisForm.SalesNum.Value,'SalesNum',-3)
		nItem		= PrepareSQLnum(This.Value,'item',-1)
		
		IF nSalesNum > 0 AND nItem > 0
			*check
			cSOitem		= PrepareSQLtxt(STR(nSalesNum,7)+"-"+STR(nItem,2),'SOitem',10)
			
			*nCount = Count_ItemTot_SalesNum( nSalesNum, ThisForm.nConnHandle )
			IF Count_SOIteminSales (cSOitem, ThisForm.oCertFormSet.nConnHandle,'') = 0
				MESSAGEBOX("This SO item number was not found"+CHR(13)+STR(nSalesNum),0+16,"bad SO")
			ELSE
				PRIVATE cPO_Num,cPartNo,cPcs,cDescr
				cPO_Num	= ''
				cPartNo	= ''
				cPcs	= ''
				cDescr	= ''
			
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE ItemSO.When
		RETURN VARTYPE(ThisForm.oCertFormSet) = "O" AND ThisForm.oCertFormSet.isediting_co
	ENDPROC

	PROCEDURE PartNo.When
		RETURN VARTYPE(ThisForm.oCertFormSet) = "O" AND ThisForm.oCertFormSet.isediting_co
	ENDPROC

	PROCEDURE Pcs.When
		RETURN VARTYPE(ThisForm.oCertFormSet) = "O" AND ThisForm.oCertFormSet.isediting_co
	ENDPROC

	PROCEDURE POnum.When
		RETURN VARTYPE(ThisForm.oCertFormSet) = "O" AND ThisForm.oCertFormSet.isediting_co
	ENDPROC

	PROCEDURE Resize
		*ThisForm.Left = 224  &&W484 L206
		*ThisForm.Top = 420  &&H171 T213
		*ThisForm.oCertFormSet.Refresh_ERPCert('INIT')
		
		PRIVATE nDeltaH, nDeltaW
		nDeltaH = ThisForm.Height - 172
		nDeltaW = ThisForm.Width - 484
		
		ThisForm.cmdAdd.Top		= (130 + nDeltaH)
		ThisForm.cmdClone.Top	= (130 + nDeltaH)
		ThisForm.cmdEdit.Top	= (130 + nDeltaH)
		ThisForm.cmdBlank.Top	= (130 + nDeltaH)
		ThisForm.cmdDelete.Top	= (130 + nDeltaH)
		
		ThisForm.lblDescript.Top = 126 + nDeltaH
		ThisForm.Description.Top = 139 + nDeltaH
		
		ThisForm.edtCoComp.Top 	= 157 + nDeltaH
		**********
		
		ThisForm.grdCO.Height	= (120 + nDeltaH)
		ThisForm.grdCO.Width	= (228 + nDeltaW)
		
		ThisForm.txtCO_ID.Left	= (264 + nDeltaW)
		ThisForm.lblSO.Left		= (253 + nDeltaW)
		ThisForm.SalesNum.Left	= (288 + nDeltaW)
		ThisForm.ItemSO.Left	= (360 + nDeltaW)
		ThisForm.lblCompany.Left	= (232 + nDeltaW)
		ThisForm.Company.Left	= 292 + nDeltaW
		ThisForm.lblPO.Left		= 261 + nDeltaW
		ThisForm.POnum.Left		= 292 + nDeltaW
		ThisForm.lblPart.Left	= 253 + nDeltaW
		ThisForm.PartNo.Left 	= 292 + nDeltaW
		ThisForm.lblPieces.Left	= 247 + nDeltaW
		ThisForm.Pcs.Left		= 292 + nDeltaW
		
		ThisForm.lblDescript.Left= 360 + nDeltaW
		ThisForm.Description.Left= 252 + nDeltaW
		
		
	ENDPROC

	PROCEDURE SalesNum.Valid
		PRIVATE nSalesNum
		nSalesNum	= PrepareSQLnum(This.Value,'SalesNum',-3)
		
		IF nSalesNum > 0
			*check
			*nCount = Count_ItemTot_SalesNum( nSalesNum, ThisForm.nConnHandle )
			IF Count_SOinSales_No(nSalesNum, ThisForm.oCertFormSet.nConnHandle,'') = 0
				MESSAGEBOX("This Sales Order was not found"+CHR(13)+STR(nSalesNum),0+16,"bad SO")
			ELSE
				*get Comany name 
				PRIVATE cCompany
				cCompany = getFromQuotesSO(nSalesNum ,"COMPANY",ThisForm.oCertFormSet.nConnHandle)
				IF LEN(cCompany)>0
					ThisForm.COMPANY.Value = cCompany
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE SalesNum.When
		RETURN VARTYPE(ThisForm.oCertFormSet) = "O" AND ThisForm.oCertFormSet.isediting_co
	ENDPROC

	PROCEDURE txtCO_ID.When
		RETURN VARTYPE(ThisForm.oCertFormSet) = "O" AND ThisForm.oCertFormSet.isediting
	ENDPROC

ENDDEFINE
