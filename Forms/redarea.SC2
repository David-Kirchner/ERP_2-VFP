	PROCEDURE calcs		&& Main Calc Engine.
		PRIVATE lnArea1,lnArea2, lnsD1b
		*Calcs()
		*ThisFormSet.InitCalcVal()
		PRIVATE lnD1,lnWide,lnL1,lnD2,lnL2
		
		lnD1	= PrepareSQLnum(ThisFormset.REDAREA.txtD123.Value,'D1',9,3)
		lnWide	= PrepareSQLnum(ThisFormSet.REDAREA.txtWd1.Value,'WD1',9,3)
		lnL1	= PrepareSQLnum(ThisFormset.REDAREA.txtL124.Value,'L1',9,3)
		lnD2	= PrepareSQLnum(ThisFormset.REDAREA.txtD225.Value,'D2',9,3)
		lnL2	= PrepareSQLnum(ThisFormset.REDAREA.txtL226.Value,'L2',9,3)
		
		PRIVATE lnWeight1,lnWcalc,lnsRA,lnsRACalc,lnL1calc,lnL2calc
		lnWeight1	= PrepareSQLnum(ThisFormset.REDAREA.txtW134.Value,'W1',7,1)
		lnWcalc		= PrepareSQLnum(ThisFormset.REDAREA.txtM_sl231.Value,'W2',7,1)
		lnsRA		= PrepareSQLnum(ThisFormset.REDAREA.txtRa36.Value,'RA',4,3)
		lnsRACalc	= PrepareSQLnum(ThisFormset.REDAREA.txtRa36.Value,'RA',4,3)
		lnL1calc	= PrepareSQLnum(ThisFormset.REDAREA.txtM_sl129.Value,'L1',9,3)
		lnL2calc	= PrepareSQLnum(ThisFormSet.REDAREA.txtM_sl231.Value,'L2',9,3)
		
		
		*!*	lnD1=m.D1
		*!*	lnL1=m.L1
		*!*	lnL1calc=M.sL1
		*!*	lnL2calc=M.sL2
		*!*	lnD2=m.D2
		*!*	lnL2=m.L2
		*!*	lnD1calc=M.sD1
		*!*	lnD2calc=M.sD2
		*!*	lnWeight1=m.W1
		*!*	lnsRA=m.RA
		
		
		*FIND D1 BY D2 AND LENGTHS
		IF lnD2 > 0 AND lnL1 > 0 AND lnL2 > 0 AND lnD1 = 0
			IF lnWide > 0
				lnArea2 = lnWide * lnD2
				lnArea1 = lnArea2*lnL2 / lnL1
				lnD1 = lnArea1 / lnWide
			ELSE
				lnArea2= 3.14156*lnD2*lnD2/4
				lnArea1 = lnArea2*lnL2 / lnL1
				lnD1 = SQRT(lnArea1*4/3.14156)
			ENDIF
			ThisFormset.REDAREA.txtM_sd127.Value = lnD1
		ENDIF
		
		*FIND D2 BY D1 AND LENGTHS
		IF lnD1 > 0 AND lnL1 > 0 AND lnL2 > 0 AND lnD2 = 0
			IF lnWide > 0
				lnArea1= lnD1*lnWide
				lnArea2 = lnArea1*lnL1 / lnL2
				lnD2 = lnArea2/lnWide
			ELSE
				lnArea1= 3.14156*lnD1*lnD1/4
				lnArea2 = lnArea1*lnL1 / lnL2
				lnD2 = SQRT(lnArea2*4/3.14156)
			ENDIF
			ThisFormset.REDAREA.txtM_sd228.Value = lnD2
		ENDIF
		
		*FIND RA BY DIA'S    (ORIG-FINAL)/ORIG=%
		IF lnD1 > 0 AND lnD2 >0 AND lnsRA = 0
			IF lnWide > 0
				lnArea1= lnD1*lnWide
				lnArea2= lnD2*lnWide
				lnsRA = (lnArea1-lnArea2)/lnArea1
			ELSE
				lnArea1= 3.14156*lnD1*lnD1/4
				lnArea2= 3.14156*lnD2*lnD2/4
				lnsRA = (lnArea1-lnArea2)/lnArea1
			ENDIF
			ThisFormset.REDAREA.txtM_sra37.Value = lnsRA
		ENDIF
		
		*FIND L2 BY DIA'S AND L1
		IF lnL1 > 0 AND lnD1 > 0 AND lnD2 >0 AND lnL2 = 0	
			IF lnWide > 0
				lnL2=lnD1*lnWide*lnL1/(lnD2*lnWide)
			ELSE
				lnL2=lnD1*lnD1*lnL1/(lnD2*lnD2)
			ENDIF
			ThisFormset.REDAREA.txtM_sl231.Value = lnL2
		ENDIF
		
		*FIND L1 BY DIA'S AND L2
		IF lnL2 > 0 AND lnD1 > 0 AND lnD2 >0 AND lnL1 = 0
			IF lnWide > 0
				lnL1=lnD2*lnWide*lnL2/(lnD1*lnWide)
			ELSE
				lnL1=lnD2*lnD2*lnL2/(lnD1*lnD1)
			ENDIF
			ThisFormset.REDAREA.txtM_sl129.Value = lnL1
		ENDIF
		
		
		*FIND D2 BY D1 AND RA
		IF lnD1 > 0 AND lnsRA > 0 AND lnD2 = 0
			IF lnWide > 0
				lnArea1= lnD1*lnWide
				lnArea2 = lnArea1 - ( lnArea1 * lnsRA)
				lnD2 = lnArea2/lnWide
			ELSE
				lnArea1= 3.14156*lnD1*lnD1/4
				lnArea2 = lnArea1 - ( lnArea1 * lnsRA)
				lnD2 = SQRT(lnArea2*4/3.14156)
				*,SQRT(((3.14156*(thck+OverSize)*(thck+OverSize)/4)/(1-(CAST(CW AS Numeric(4,2))/100)))*4/3.14156) CalcD11
				*,(Thck+OverSize)/SQRT(1-(CAST(CW AS Numeric(4,2))/100)) AS Ds1
			ENDIF
			ThisFormset.REDAREA.txtM_sd228.Value = lnD2
		ENDIF
		
		*FIND D1 BY D2 AND RA
		IF lnD2 > 0 AND lnsRA > 0 AND lnD1 = 0
			IF lnWide > 0	
				*lnArea2= lnD2*lnWide
				*lnArea1 = lnArea2/(1-lnsRA)
				*lnD1 = lnArea1/lnWide
				lnD1b = (1-lnsRA)/lnD2
				lnD1 = 1/lnD1b
			ELSE
				lnArea2= 3.14156*lnD2*lnD2/4
				lnArea1 = lnArea2/(1-lnsRA)
				lnD1 = SQRT(lnArea1*4/3.14156)
			ENDIF
			ThisFormset.REDAREA.txtM_sd127.Value = lnD1
		ENDIF
		*****
		*FIND L2 BY DIA'S AND L1
		IF lnL1 > 0 AND lnD1 > 0 AND lnD2 >0 AND lnL2 = 0	
			IF lnWide > 0	
				lnL2=lnD1*lnL1/(lnD2)
			ELSE
				lnL2=lnD1*lnD1*lnL1/(lnD2*lnD2)
			ENDIF
			ThisFormset.REDAREA.txtM_sl231.Value = lnL2
		ENDIF
		
		*****
		*FIND L1 BY DIA'S AND L2
		IF lnL2 > 0 AND lnD1 > 0 AND lnD2 >0 AND lnL1 = 0
			IF lnWide > 0	
				lnL1=lnD2*lnL2/(lnD1)
			ELSE
				lnL1=lnD2*lnD2*lnL2/(lnD1*lnD1)
			ENDIF
			ThisFormset.REDAREA.txtM_sl129.Value = lnL1
		ENDIF
		*****
		*FIND D1 by RA AND D2
		
		*****
		IF lnL1 > 0
			ThisFormSet.REDAREA.txtM_sl129.Value = lnL1
			m.sL1f = lnL1/12
			ThisFormSet.REDAREA.txtM_sl1_1230.Value = m.sL1f	
		ENDIF
		IF lnL2 > 0
			ThisFormSet.REDAREA.txtM_sl231.Value = lnL2
			m.sL2f = lnL2/12
			ThisFormSet.REDAREA.txtM_sl2_1232.Value = m.sL2f
		ENDIF
		
		ThisFormSet.GetWeight()
		
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		
		IF ThisFormSet.nConnHandle > 0
			SQLDISCONNECT( ThisFormSet.nConnHandle )
		ENDIF
	ENDPROC

	PROCEDURE fdensity		&& Calulate Weight
		PARAMETER pcAlloy
		
		PRIVATE nDens
		IF VARTYPE(pcAlloy) = 'C'
			nDens = GetAlloyDensity(pcAlloy)
		ELSE
			WAIT WINDOW "USING .290 DENSITY" NOWAIT
			nDens = .290
		ENDIF
		RETURN nDens 
		
		
		
	ENDPROC

	PROCEDURE getweight
		*getWeight()
		PRIVATE lnDuse,lnLuse,lnZdens
		lnDuse = 0
		lnLuse = 0
		lnZdens = 0
		
		PRIVATE lnD1,lnWide,lnL1,lnD2,lnL2
		lnD1	= PrepareSQLnum(ThisFormset.REDAREA.txtD123.Value,'D1',9,3)
		lnWide	= PrepareSQLnum(ThisFormSet.REDAREA.txtWd1.Value,'WD1',9,3)
		lnL1	= PrepareSQLnum(ThisFormset.REDAREA.txtL124.Value,'L1',9,3)
		lnD2	= PrepareSQLnum(ThisFormset.REDAREA.txtD225.Value,'D2',9,3)
		lnL2	= PrepareSQLnum(ThisFormset.REDAREA.txtL226.Value,'L2',9,3)
		
		PRIVATE lnWeight1,lnsRA,lnL1calc,lnL2calc
		*lnWeight1	= PrepareSQLnum(ThisFormset.REDAREA.txtW134.Value,'W1',7,1)
		*lnsRA	= PrepareSQLnum(ThisFormset.REDAREA.txtRa36.Value,'RA',4,3)
		lnL1calc = PrepareSQLnum(ThisFormset.REDAREA.txtM_sl129.Value,'L1',9,3)
		lnL2calc = PrepareSQLnum(ThisFormSet.REDAREA.txtM_sl231.Value,'L2',9,3)
		PRIVATE lnD1calc,lnD2calc
		lnD1calc	= PrepareSQLnum(ThisFormSet.REDAREA.txtM_sd127.Value,'D1',9,3)
		lnD2calc	= PrepareSQLnum(ThisFormSet.REDAREA.txtM_sd228.Value,'D2',9,3)
		
		*!*	lnD1=m.D1
		*!*	lnL1=lnL2
		*!*	lnL1calc=M.sL1
		*!*	lnL2calc=M.sL2
		*!*	lnD2=m.D2
		*!*	lnL2=m.L2
		*!*	lnD1calc=M.sD1
		*!*	lnD2calc=M.sD2
		*!*	lnWeight1=m.W1
		*!*	lnsRA=m.RA
		
		IF lnD1>0 AND lnL1>0
			lnDuse = lnD1
			lnLuse = lnL1
		ELSE
			IF lnD2>0 AND lnL2>0
				lnDuse = lnD2
				lnLuse = lnL2
			ELSE
		***		MUST USE A COMPUTED VALUE on length
				IF lnD1>0 AND lnL1calc>0
					lnDuse = lnD1
					lnLuse = lnL1calc
				ELSE
					IF lnD2>0 AND lnL2calc>0
						lnDuse = lnD2
						lnLuse = lnL2calc
					ELSE
		***		MUST USE A COMPUTED VALUE on Dia
						IF lnD1calc>0 AND lnL1>0
							lnDuse = lnD1calc
							lnLuse = lnL1
						ELSE
							IF lnD2calc>0 AND lnL2>0
								lnDuse = lnD2calc
								lnLuse = lnL2
							ELSE
								lnDuse = 0
								lnLuse = 0
								WAIT WINDOW 'could not figure Dia and Length'
							ENDIF
						ENDIF
					ENDIF
				ENDIF		
			ENDIF
		ENDIF
		
		PRIVATE cAlloy
		cAlloy = PrepareSQLtxt(ThisFormSet.REDAREA.txtR_alloy33.Value,'Alloy',12)
		lnZdens = ThisFormSet.FDENSITY(cAlloy)
		lnWcalc = ROUND( ((lnDuse+.005)^2* 3.14159 * lnZdens* lnLuse /4) ,1)
		ThisFormSet.REDAREA.txtM_sw135.Value = lnWcalc
		
		
	ENDPROC

	PROCEDURE initcalcval		&& Initiate Calculated Values.
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		PRIVATE lcSafety, cFileName
		cFileName = "RA"+SYS(2015)+".DBF"
		
		IF USED("ReductionArea")
			USE IN ReductionArea
		ENDIF
		
		IF FILE(SYS(5)+SYS(2003)+"\"+cFileName) 
			DELETE FILE (SYS(5)+SYS(2003)+"\"+cFileName)
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\MEM\"+cFileName) 
			DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+cFileName)
		ENDIF
		
		SELECT 0
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+cFileName) FREE (txt C(80)) 
			USE (SYS(5)+SYS(2003)+"\"+cFileName) EXCL ALIAS ReductionArea
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+cFileName) FREE (txt C(80)) 
			USE (SYS(5)+SYS(2003)+"\MEM\"+cFileName) EXCL ALIAS ReductionArea
		ENDIF
		
		
		
		*!*	IF FILE(SYS(5)+SYS(2003)+"\"+quotedb ) &&Clean the file
		*!*		SELECT 0
		*!*		USE SYS(5)+SYS(2003)+"\"+quotedb  EXCL ALIAS ReductionArea
		
		*!*		IF USED('ReductionArea')
		*!*			lcSafety = SET("SAFETY")
		*!*			SET SAFETY OFF
		*!*			ZAP
		*!*			SET SAFETY &lcSafety
		*!*		ELSE
		*!*			DELETE FILE (SYS(5)+SYS(2003)+"\"+"ReductionArea.DBF")
		*!*			CREATE TABLE (SYS(5)+SYS(2003)+"\"+"ReductionArea") FREE (txt C(80))
		*!*			*USE ReductionArea EXCL 
		*!*		ENDIF
		*!*	ELSE &&Create file
		*!*		SELECT 0
		*!*		CREATE TABLE (SYS(5)+SYS(2003)+"\"+"ReductionArea") FREE (txt C(80))
		*!*		*USE ReductionArea EXCL 
		*!*	ENDIF
		
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		
	ENDPROC

	PROCEDURE red_math		&& Procedure for all math Calculations
		PARAMETER PTEXT &&M.EXEPROG,M.OBJ
		
		PRIVATE m.MATH,m.MATHFAC,m.METRIC, m.MATHTYPE,m.MATHNAME,m.MATH1,m.MATH2,	m.MATH3,m.MATH4
		
		IF TYPE('pText') = 'C'
			m.MATH = PTEXT
		ELSE
			IF NOT WEXIST('INQ_MATH')
				DEFINE WINDOW INQ_MATH FROM 2,0 TO 4,23 TITLE "Ex. 40MM,13',12*5IN"
			ENDIF
		
			Activate WINDOW INQ_MATH
			ACCEPT TO m.MATH
			Deactivate WINDOW INQ_MATH
		ENDIF
		
		IF EMPTY(m.MATH)
			RETURN
		ENDIF
		
		*M.METRIC IS LENGTH OF UNIT SMYBOL TO DELETE
		
		DO CASE
		CASE "MM" $ UPPER(m.MATH)
			m.MATHFAC = .03937
			m.METRIC = 2
			m.MATHTYPE = "IN"
			m.MATHNAME = "Millimeter="
		CASE "CM" $ UPPER(m.MATH)
			m.MATHFAC = .3937
			m.METRIC = 2
			m.MATHTYPE = "IN"
			m.MATHNAME = "Centimeter="
		CASE "DM" $ UPPER(m.MATH)
			m.MATHFAC = 3.937
			m.METRIC = 2
			m.MATHTYPE = "IN"
			m.MATHNAME = "Decimeter="
		CASE "M" $ UPPER(m.MATH)
			m.MATHFAC = 39.37
			m.METRIC = 1
			m.MATHTYPE = "IN"
			m.MATHNAME = "Meter="
		CASE "FT" $ UPPER(m.MATH)
			m.MATHFAC = 12
			m.METRIC = 2
			m.MATHTYPE = "IN"
			m.MATHNAME = "Foot="
		CASE "'" $ UPPER(m.MATH)
			m.MATHFAC = 12
			m.METRIC = 1
			m.MATHTYPE = "IN"
			m.MATHNAME = "Foot="
		CASE ["] $ UPPER(m.MATH)
			m.MATHFAC = 1
			m.METRIC = 1
			m.MATHTYPE = "IN"
			m.MATHNAME = "Inch="
		CASE "IN" $ UPPER(m.MATH)
			m.MATHFAC = 1
			m.METRIC = 2
			m.MATHTYPE = "IN"
			m.MATHNAME = "Inch="
		CASE "YARD" $ UPPER(m.MATH)
			m.MATHFAC = 36
			m.METRIC = 4
			m.MATHTYPE = "IN"
			m.MATHNAME = "Yard="
		CASE "KG" $ UPPER(m.MATH)
			m.MATHFAC = 2.2046
			m.METRIC = 2
			m.MATHTYPE = "LB"
			m.MATHNAME = "Kilogram="
		CASE "HG" $ UPPER(m.MATH)
			m.MATHFAC = .22046
			m.METRIC = 2
			m.MATHTYPE = "IN"
			m.MATHNAME = "Hectogram="
		CASE "GRAM" $ UPPER(m.MATH)
			m.MATHFAC = .0022046
			m.METRIC = 4
			m.MATHTYPE = "IN"
			m.MATHNAME = "Gram="
		CASE "CG" $ UPPER(m.MATH)
			m.MATHFAC = .000022046
			m.METRIC = 2
			m.MATHTYPE = "IN"
			m.MATHNAME = "Centigram="
		CASE "LB" $ UPPER(m.MATH)
			m.MATHFAC = 1
			m.METRIC = 2
			m.MATHTYPE = "LB"
			m.MATHNAME = "Pound="
		OTHERWISE
			m.MATHFAC = 1
			m.METRIC = 0
			m.MATHTYPE = "X"
			m.MATHNAME = "Equation="
		ENDCASE
		
		
		
		DO CASE
		CASE "*" $ m.MATH
			m.MATH1 = AT("*",m.MATH)
			m.MATH2 = VAL(LEFT(m.MATH,m.MATH1-1))
			m.MATH3 = VAL(substr(m.MATH,m.MATH1+1,LEN(m.MATH)-m.METRIC))
			m.MATH4 = m.MATH2*m.MATH3*m.MATHFAC
		CASE "+" $ m.MATH
			m.MATH1 = AT("+",m.MATH)
			m.MATH2 = VAL(LEFT(m.MATH,m.MATH1-1))
			m.MATH3 = VAL(substr(m.MATH,m.MATH1+1,LEN(m.MATH)-m.METRIC))
			m.MATH4 = m.MATH2+m.MATH3*m.MATHFAC
		CASE "/" $ m.MATH
			m.MATH1 = AT("/",m.MATH)
			m.MATH2 = VAL(LEFT(m.MATH,m.MATH1-1))
			m.MATH3 = VAL(substr(m.MATH,m.MATH1+1,LEN(m.MATH)-m.METRIC))
			m.MATH4 = m.MATH2/m.MATH3*m.MATHFAC
		CASE "-" $ m.MATH
			m.MATH1 = AT("-",m.MATH)
			m.MATH2 = VAL(LEFT(m.MATH,m.MATH1-1))
			m.MATH3 = VAL(substr(m.MATH,m.MATH1+1,LEN(m.MATH)-m.METRIC))
			m.MATH4 = m.MATH2-m.MATH3*m.MATHFAC
		OTHERWISE
			m.MATH4 = VAL(m.MATH)*m.MATHFAC
		ENDCASE
		
		
		*DO CASE
		*CASE M.OBJ $ "W1" AND m.mathtype = "LB"
		*	M.W1 =  M.MATH4
		*	SHOW GET M.W1
		*	WAIT WINDOW m.mathname NOWAIT
		*CASE UPPER(M.OBJ) $ "L1 L2 D1 D2" AND (m.mathtype = "IN" OR m.mathtype = "X" )
		*	DO CASE
		*	CASE M.OBJ = "D1"
		*		M.D1 = M.MATH4
		*		SHOW GET M.D1
		*	CASE M.OBJ = "D2"
		*		M.D2 = M.MATH4
		*		SHOW GET M.D2
		*	CASE M.OBJ = "L1"
		*		lnL1 = M.MATH4
		*		SHOW GET lnL1
		*	CASE M.OBJ = "L2"
		*		M.L2 = M.MATH4
		*		SHOW GET M.L2
		*	ENDCASE
		*	WAIT WINDOW m.mathname NOWAIT
		*OTHERWISE
		*	IF TYPE('SALESP') = "C"
		*		IF SALESP = "D"
		*			WAIT WINDOW 'M.OBJ = '+M.OBJ
		*		ENDIF
		*	ENDIF
		
		
		This.Refresh
		
		IF NOT TYPE('pText') = 'C'
			Activate WINDOW INQ_MATH
			? m.MATH4
			WAIT WINDOW m.MATHNAME
			Deactivate WINDOW INQ_MATH
		ELSE
			RETURN m.Math4
		ENDIF
		
		*ENDCASE
		
	ENDPROC

	PROCEDURE remove0		&& Removes useless 0's
		PARAMETER M.NUMW0,M.TN,M.TD
		*Remove0()
		PRIVATE M.CHAR  &&Charatec number returned
		PRIVATE M.NUMW0 &&Number with 0's
		PRIVATE M.TN  &&Total Intager digits
		PRIVATE M.TD  &&Total Decimal digits
		***remove0
		
		IF TYPE('TD') = 'L'
			WAIT WINDOW 'Decimals may have been dropped' noWait
			RETURN LTRIM(STR(M.NUMW0))
		ENDIF
		
		M.CHAR = STR(M.NUMW0,M.TN,M.TD)
		
		IF M.TD > 1
			*EX: LIST .040 WITH THE ZERO
			IF VAL(RIGHT(M.CHAR,2)) > 0
				RETURN LTRIM(M.CHAR)	
			ENDIF
		ENDIF
		
		DO WHILE .T.
			DO CASE
			CASE RIGHT(M.CHAR,1) = '0'
				M.CHAR=LEFT(M.CHAR,LEN(M.CHAR)-1)
			CASE RIGHT(M.CHAR,1) = '.'
				M.CHAR=LEFT(M.CHAR,LEN(M.CHAR)-1)
				RETURN LTRIM(M.CHAR)
			OTHERWISE
				RETURN LTRIM(M.CHAR)
			ENDCASE
		ENDDO
	ENDPROC

	PROCEDURE replacemath		&& Replaces field with math solution.
		PRIVATE M.MATH,M.MATHFAC,m.metric, m.mathtype,m.mathname,m.math1,m.math2,	m.math3,m.math4
		*ReplaceMath()
		IF !WEXIST('ReplaceMath')
			DEFINE WINDOW ReplaceMath FROM 2,0 TO 4,23 TITLE "Ex. 40MM,13',12*5IN"
		ENDIF
		
		ACTIVATE WINDOW ReplaceMath
		ACCEPT TO m.math
		DEACTIVATE WINDOW ReplaceMath
		 
		
		IF EMPTY(m.math)
			RETURN
		ENDIF
		
		*M.METRIC IS LENGTH OF UNIT SMYBOL TO DELETE
		
		DO CASE
		CASE "MM" $ UPPER(m.math)
				M.MATHFAC = .03937
				m.metric = 2
				m.mathtype = "IN"
				m.mathname = "Millimeter="
		CASE "CM" $ UPPER(m.math)
				M.MATHFAC = .3937
				m.metric = 2		
				m.mathtype = "IN"		
				m.mathname = "Centimeter="
		CASE "DM" $ UPPER(m.math)
				M.MATHFAC = 3.937
				m.metric = 2		
				m.mathtype = "IN"
				m.mathname = "Decimeter="
		CASE "M" $ UPPER(m.math)
				M.MATHFAC = 39.37
				m.metric = 1	
				m.mathtype = "IN"
				m.mathname = "Meter="
		CASE "FT" $ UPPER(m.math)
				M.MATHFAC = 12
				m.metric = 2	
				m.mathtype = "IN"
				m.mathname = "Foot="	
		CASE "'" $ UPPER(m.math)
				M.MATHFAC = 12
				m.metric = 1	
				m.mathtype = "IN"
				m.mathname = "Foot="	
		CASE ["] $ UPPER(m.math)
				M.MATHFAC = 1
				m.metric = 1	
				m.mathtype = "IN"
				m.mathname = "Inch="	
		CASE "IN" $ UPPER(m.math)
				M.MATHFAC = 1
				m.metric = 2	
				m.mathtype = "IN"
				m.mathname = "Inch="	
		CASE "YARD" $ UPPER(m.math)
				M.MATHFAC = 36
				m.metric = 4
				m.mathtype = "IN"
				m.mathname = "Yard="
		CASE "KG" $ UPPER(m.math)
				M.MATHFAC = 2.2046
				m.metric = 2
				m.mathtype = "LB"
				m.mathname = "Kilogram="
		CASE "HG" $ UPPER(m.math)
				M.MATHFAC = .22046
				m.metric = 2        
				m.mathtype = "IN"  
				m.mathname = "Hectogram="
		CASE "GRAM" $ UPPER(m.math)
				M.MATHFAC = .0022046
				m.metric = 4        
				m.mathtype = "IN"
				m.mathname = "Gram="
		CASE "CG" $ UPPER(m.math)
				M.MATHFAC = .000022046
				m.metric = 2           
				m.mathtype = "IN"
				m.mathname = "Centigram="
		CASE "LB" $ UPPER(m.math)
				M.MATHFAC = 1
				m.metric = 2	
				m.mathtype = "LB"
				m.mathname = "Pound="	
		OTHERWISE                         
				M.MATHFAC = 1
				m.metric = 0
				m.mathtype = "X"
				m.mathname = "Equation="
		ENDCASE
		
		
		
		DO CASE
		CASE "*" $ m.math
			m.math1 = AT("*",m.math)
			m.math2 = VAL(LEFT(m.math,m.math1-1))
			m.math3 = VAL(substr(m.math,m.math1+1,LEN(m.math)-m.metric))
			m.math4 = m.math2*m.math3*m.mathfac
		CASE "+" $ m.math
			m.math1 = AT("+",m.math)
			m.math2 = VAL(LEFT(m.math,m.math1-1))
			m.math3 = VAL(substr(m.math,m.math1+1,LEN(m.math)-m.metric))
			m.math4 = m.math2+m.math3*m.mathfac
		CASE "/" $ m.math
			m.math1 = AT("/",m.math)
			m.math2 = VAL(LEFT(m.math,m.math1-1))
			m.math3 = VAL(substr(m.math,m.math1+1,LEN(m.math)-m.metric))
			m.math4 = m.math2/m.math3*m.mathfac
		CASE "-" $ m.math
			m.math1 = AT("-",m.math)
			m.math2 = VAL(LEFT(m.math,m.math1-1))
			m.math3 = VAL(substr(m.math,m.math1+1,LEN(m.math)-m.metric))
			m.math4 = m.math2-m.math3*m.mathfac
		OTHERWISE
			m.math4 = VAL(m.math)*m.mathfac
		ENDCASE
		
		
		*DO CASE
		*CASE M.OBJ $ "W1" AND m.mathtype = "LB"
		*	M.W1 =  M.MATH4
		*	SHOW GET M.W1
		*	WAIT WINDOW m.mathname NOWAIT
		*CASE UPPER(M.OBJ) $ "L1 L2 D1 D2" AND (m.mathtype = "IN" OR m.mathtype = "X" )
		*	DO CASE
		*	CASE M.OBJ = "D1"
		*		M.D1 = M.MATH4
		*		SHOW GET M.D1
		*	CASE M.OBJ = "D2"
		*		M.D2 = M.MATH4
		*		SHOW GET M.D2
		*	CASE M.OBJ = "L1"
		*		lnL2 = M.MATH4
		*		SHOW GET lnL2
		*	CASE M.OBJ = "L2"
		*		M.L2 = M.MATH4
		*		SHOW GET M.L2
		*	ENDCASE
		*	WAIT WINDOW m.mathname NOWAIT
		*OTHERWISE
		*	IF TYPE('SALESP') = "C"
		*		IF SALESP = "D"
		*			WAIT WINDOW 'M.OBJ = '+M.OBJ 
		*		ENDIF
		*	ENDIF
			ACTIVATE WINDOW ReplaceMath
			? M.MATH4
		 	WAIT WINDOW m.mathname 
			DEACTIVATE WINDOW ReplaceMath
		*ENDCASE
		
	ENDPROC

