	PROCEDURE REDAREA.cmdStock.Click
		
		PRIVATE cAlloy, nThck, nWidth
		cAlloy	= PrepareSQLtxt(ThisForm.txtR_alloy33.Value,'Alloy',12)
		nThck	= PrepareSQLnum(ThisForm.txtD123.Value,'Thck',10,3)
		nWidth	= PrepareSQLnum(ThisForm.txtWd1.Value,'Sz2',9,3)
		DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE",'S',cAlloy,"10","1"," ",nThck,nWidth,0,'',0,1,0,'',0,.T.,''
		*PARAMETER pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem
	ENDPROC

	PROCEDURE REDAREA.cmdView.Click
		PRIVATE ctxt
		
		IF USED("ReductionArea")
			SELECT ReductionArea
			
			PRIVATE lnD1,lnWide,lnL1,lnD2,lnL2
			PRIVATE lnCalcD1, lnCalcL1, lnCalcD2, lnCalcL2
			
			lnD1	= PrepareSQLnum(ThisFormset.REDAREA.txtD123.Value,'D1',9,3)
			lnCalcD1	= PrepareSQLnum(ThisFormset.REDAREA.txtM_sd127.Value,'D1',9,3)
		
			lnWide	= PrepareSQLnum(ThisFormSet.REDAREA.txtWd1.Value,'WD1',9,3)
			
			lnL1	= PrepareSQLnum(ThisFormset.REDAREA.txtL124.Value,'L1',9,3)
			lnCalcL1	= PrepareSQLnum(ThisFormset.REDAREA.txtM_sl129.Value,'L1',9,3)
			IF lnL1 > 0 AND lnL1=lnCalcL1
				**Calc Length 1 is being filed but does not need to be.
				lnCalcL1 = 0
			ENDIF
			
			lnD2	= PrepareSQLnum(ThisFormset.REDAREA.txtD225.Value,'D2',9,3)
			lnCalcD2	= PrepareSQLnum(ThisFormset.REDAREA.txtM_sd228.Value,'D2',9,3)
		
			lnL2	= PrepareSQLnum(ThisFormset.REDAREA.txtL226.Value,'L2',9,3)
			lnCalcL2	= PrepareSQLnum(ThisFormset.REDAREA.txtM_sl231.Value,'L2',9,3)
		
			PRIVATE lnWeight1,lnWcalc,lnsRA,lnsRACalc
			lnWeight1	= PrepareSQLnum(ThisFormset.REDAREA.txtW134.Value,'W1',7,1)
			lnWcalc		= PrepareSQLnum(ThisFormset.REDAREA.txtM_sw135.Value,'W2',7,1)
			*lnWeight1	= IIF(lnWeight1>0, lnWeight1, lnWcalc)
		
			lnsRA		= PrepareSQLnum(ThisFormset.REDAREA.txtRa36.Value,'RA',4,3)
			lnsRACalc	= PrepareSQLnum(ThisFormset.REDAREA.txtM_sra37.Value,'RA',4,3)
		
		
			ctxt = "  START    Entered     Calc                FINISH    entered     calc"
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = "  Thick "+STR(lnD1,9,3)+" "+STR(lnCalcD1,9,3)+SPACE(15)+"  Thick "+STR(lnD2,9,3)+" "+STR(lnCalcD2,9,3)
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			IF lnWide > 0
				ctxt = "   Width "+STR(lnWide,9,3)
				INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ENDIF
			ctxt = " Length "+STR(lnL1,9,3)+" "+STR(lnCalcL1,9,3)+SPACE(15)+" Length "+STR(lnL2,9,3)+" "+STR(lnCalcL2,9,3)
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = " "
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = "   ALLOY "+ThisForm.txtR_alloy33.Value +SPACE(15)+"WEIGHT "+STR(lnWeight1,9,1)+"  "+STR(lnWcalc,9,1)
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = " "
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = "         RA "+STR(lnsRA,8,6)+"       "+STR(lnsRACalc,8,6)
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
			ctxt = " "
			INSERT INTO ReductionArea (txt) VALUES (ctxt)
		
			INSERT INTO ReductionArea (txt) VALUES (REPLICATE("-",80))
			
			WAIT WINDOW "This data has been added to Report" NOWAIT
		ENDIF
		
	ENDPROC

	PROCEDURE REDAREA.Destroy
		
		RELEASE lcLastSetDecimal
		
		
	ENDPROC

	PROCEDURE REDAREA.Init
		PUBLIC m.Text1
		
		m.sD1 = 0
		m.sL1 = 0
		m.sL1f = 0
		m.sD2 = 0
		m.sL2 = 0
		m.sL2f = 0
		m.sW1 = 0
		m.sRA = 0
		
		m.D1 = 0
		m.L1 = 0
		m.L1f = 0
		m.D2 = 0
		m.L2 = 0
		m.L2f = 0
		m.W1 = 0
		m.sWid = 0
		m.RA = 0
		
		m.Text1 = ""
		M.R_alloy = ''
		
		ThisFormSet.tTabindex=ThisForm.txtD123.Tabindex
		ThisForm.txtD123.SetFocus
		
		
		ThisFormSet.nlastsetdecimal = SET("DECIMAL")
		IF ThisFormSet.nlastsetdecimal < 3
			SET DECIMAL TO 3
		ENDIF
		
		
		ON KEY LABEL F2 DO Prog\F2Math
		*ON KEY LABEL F5 DO Prog\Calculate
		
	ENDPROC

	PROCEDURE REDAREA.lblWeight10.Click
		ThisForm.Parent.Getweight()
	ENDPROC

	PROCEDURE REDAREA.txtRa36.Valid
		PRIVATE lnRA
		lnRA = PrepareSQLnum(This.Value,'RA',8,6)
		IF lnRA > 0
			ThisFormSet.Calcs()
		ENDIF
	ENDPROC

	PROCEDURE REDAREA.txtR_alloy33.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisFormSet.nConnHandle)
		*	SEEK UPPER(lcSearchStr) ORDER TAG UppAlloys IN Alloys
		*	IF FOUND("Alloys")
			IF NOT EMPTY(lcTryAlloy)		
			
		*		IF UPPER(lcSearchStr) = SUBSTR(Alloys.Alloy,1,lnInsertionPt)
		*			THIS.VALUE=Alloys.Alloy
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE REDAREA.txtR_alloy33.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE REDAREA.txtR_alloy33.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard(pCurAlloy, ThisFormSet.nConnHandle)
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				
				ThisFormSet.Getweight()
				
				RETURN .T.
			ELSE
					THIS.FORECOLOR = RGB(255,128,128)
					RETURN .F.
		
			ENDIF
			
		ENDIF
		
	ENDPROC

	PROCEDURE REDAREA.Unload
		
		IF ThisFormSet.nlastsetdecimal > 0
			SET DECIMALS TO ThisFormSet.nlastsetdecimal
		ENDIF
	ENDPROC

ENDDEFINE
