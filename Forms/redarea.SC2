	PROCEDURE useweight		&& Calculate from input weight.
		PRIVATE M.CUI,Zdens
		*UseWeight()
		PRIVATE cAlloy
		cAlloy = PrepareSQLtxt(ThisFormSet.REDAREA.txtR_alloy33.Value,'Alloy',12)
		Zdens = ThisFormSet.FDENSITY(cAlloy)
		M.CUI = lnWide * 1/Zdens
		
		IF lnD1>0 AND lnL1=0
		*!*		lnL1calc = M.CUI / (3.14 * lnD1 * lnD1 / 4)
		ENDIF
		IF lnD2>0 AND lnL2=0
			lnL2calc = M.CUI / (3.14 * lnD2 * lnD2 / 4)
		ENDIF
		IF lnD1=0 AND lnL1>0
			lnL1 = M.CUI / lnL1
		ENDIF
		IF lnD2=0 AND lnL2>0
			lnL2calc = M.CUI / lnL2
		ENDIF
		
	ENDPROC

