DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="1" />

	*<PropValue>
		DataSource = .NULL.
		Height = 0
		Left = 0
		Name = "Dataenvironment"
		Top = 0
		Width = 0
	*</PropValue>

ENDDEFINE

DEFINE CLASS frmenterorder AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*<PropValue>
		Caption = "Form1"
		DoCreate = .T.
		Height = 429
		Left = 0
		MDIForm = .T.
		Name = "frmEnterOrder"
		Top = 0
		Width = 653
		WindowType = 1
	*</PropValue>
	
	PROCEDURE Init
		PARAMETER nSalesnum, lNoSave
		
		*Do Form Forms\EditOrder WITH 48383, NoSave
		
		PUBLIC glTrt_lumber
		glTrt_lumber = .F.
		
		PRIVATE cSQL,cSQLu, nSQLEXEC
		
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF	
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		SET PRINTER TO DEFAULT
		
		
		IF NOT TYPE("nSalesnum") = "N"
			=MESSAGEBOX("Enter Salesnumber in your quote page first",16,"Did not find Parameter Sales Number")
			RETURN .F.
		ENDIF
		THISFORM.Salesnum = nSalesnum
		
		IF VARTYPE(lNoSave) = "L"
			IF lNoSave
				ThisForm.cmdEdit.Visible = .F.
			ENDIF
		ENDIF
		
		IF USED("QuotesSO")
			USE IN QuotesSO
		ENDIF
		IF USED("SalesQuote")
			USE IN SalesQuote
		ENDIF
		
		************************************************************
		WAIT WINDOW "Open SalesQuote" NOWAIT
		
		ThisForm.Refresh_SalesQuote(1)
		ThisForm.didSOitemUseStock()
		
		*****************************************************************
		
		SELECT SalesQuote
		IF RECCOUNT('SalesQuote') < 1
			MESSAGEBOX('No Records found!',0,"INIT")
			RETURN
		ENDIF
		
		
		SELECT SalesQuote
		GO TOP IN SalesQuote
		
		ThisForm.Pageframe1.pgOrder.chkService.Refresh
		ThisForm.Pageframe1.pgOrder.chkInv.Refresh
		ThisForm.Pageframe1.pgOrder.chkGFM.Refresh
		ThisForm.Pageframe1.pgOrder.chkRoll.Refresh
		ThisForm.Pageframe1.pgOrder.chkPress.Refresh
		ThisForm.Pageframe1.pgOrder.chkMach.Refresh
		ThisForm.Pageframe1.pgOrder.chkCg.Refresh
		ThisForm.Pageframe1.pgOrder.txtTol.Refresh
		ThisForm.Pageframe1.pgOrder.chkPlasma.Refresh
		ThisForm.Pageframe1.pgOrder.chkWJet.refresh
		ThisForm.Pageframe1.pgOrder.cmbCert.Refresh
		
		IF ISNULL(SalesQuote.ProcLoc)
			IF SalesQuote.Form = '40'
				REPLACE SalesQuote.ProcLoc WITH "W"
			ELSE
				REPLACE SalesQuote.ProcLoc WITH "T"
			ENDIF
		ENDIF
		ThisForm.Pageframe1.pgOrder.cmbProcLoc.Refresh
		
		ThisForm.Pageframe1.pgOrder.chkCancelItem.Refresh
		
		
		IF VARTYPE(SalesQuote.QA) = "L"
			ThisForm.Pageframe1.pgBillTo.chkQA.VALUE = IIF(SalesQuote.QA,1,0)
		ELSE
			ThisForm.Pageframe1.pgBillTo.chkQA.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.CofC) = "L"
			ThisForm.Pageframe1.pgBillTo.chkCofC.VALUE = IIF(SalesQuote.CofC,1,0)
		ELSE
			ThisForm.Pageframe1.pgBillTo.chkCofC.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.Merc) = "L"
			ThisForm.Pageframe1.pgBillTo.chkMercury.VALUE = IIF(SalesQuote.Merc,1,0)
		ELSE
			ThisForm.Pageframe1.pgBillTo.chkMercury.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pPO) = "L"
			ThisForm.Pageframe1.pgBillTo.chkpPO.VALUE = IIF(SalesQuote.pPO,1,0)
		ELSE
			ThisForm.Pageframe1.pgBillTo.chkpPO.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pPN) = "L"
			ThisForm.Pageframe1.pgBillTo.chkpPN.VALUE = IIF(SalesQuote.pPN,1,0)
		ELSE
			ThisForm.Pageframe1.pgBillTo.chkpPN.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pHeat) = "L"
			ThisForm.Pageframe1.pgBillTo.chkpHeat.VALUE = IIF(SalesQuote.pHeat,1,0)
		ELSE
			ThisForm.Pageframe1.pgBillTo.chkpHeat.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pSpec) = "L"
			ThisForm.Pageframe1.pgBillTo.chkpSpec.VALUE = IIF(SalesQuote.pSpec,1,0)
		ELSE
			ThisForm.Pageframe1.pgBillTo.chkpSpec.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pDesc) = "L"
			ThisForm.Pageframe1.pgBillTo.chkpDesc.VALUE = IIF(SalesQuote.pDesc,1,0)
		ELSE
			ThisForm.Pageframe1.pgBillTo.chkpDesc.VALUE = 0
		ENDIF
		
		IF VARTYPE(SalesQuote.pOther) = "L"
			ThisForm.Pageframe1.pgBillTo.chkpOther.VALUE = IIF(SalesQuote.pOther,1,0)
			ThisForm.Pageframe1.pgBillTo.txtOther.VALUE = SalesQuote.Other
		ELSE
			ThisForm.Pageframe1.pgBillTo.chkpOther.VALUE = 0
			ThisForm.Pageframe1.pgBillTo.txtOther.VALUE = ""
		ENDIF
		
		*SalesQuote.ItemCost
		IF VARTYPE(SalesQuote.ItemCost) = "N"
			ThisForm.Pageframe1.pgQuote.txtItemCost.Value = SalesQuote.ItemCost
		ELSE
			ThisForm.Pageframe1.pgQuote.txtItemCost.Value = 0
		ENDIF
		IF VARTYPE(SalesQuote.ItemSale) = "N"
			ThisForm.Pageframe1.pgQuote.txtItemSale.Value = SalesQuote.ItemSale
		ELSE
			ThisForm.Pageframe1.pgQuote.txtItemSale.Value = 0
		ENDIF
		IF VARTYPE(SalesQuote.ShipON) = "L"
			ThisForm.Pageframe1.pgQuote.chkShipOn.Value = IIF(SalesQuote.ShipON,1,0)
		ELSE
			ThisForm.Pageframe1.pgQuote.chkShipOn.Value = 0
		ENDIF
		*!*	IF SalesQuote.EmailConf
		*!*		THISFORM.Pageframe1.pgBillTo.ChkEmail.VALUE = 1
		*!*	ELSE
		*!*		THISFORM.Pageframe1.pgBillTo.ChkEmail.VALUE = 0
		*!*	ENDIF
		
		*!*	IF SalesQuote.FaxConf
		*!*		THISFORM.Pageframe1.pgBillTo.ChkFax.VALUE = 1
		*!*	ELSE
		*!*		THISFORM.Pageframe1.pgBillTo.ChkFax.VALUE = 0
		*!*	ENDIF
		
		ThisForm.SoldAddr = 0
		ThisForm.ShipAddr = 0
		ThisForm.POShipAddr = 0
		
		WAIT WINDOW "Get Ship Route from Sales_No" NOWAIT
		PUBLIC aShipRoutes(1)
		DIMENSION aShipRoutes(1)
		
		*SELECT Sales_No
		*SET ORDER TO TAG UppShipRt
		
		
		IF USED("aSales_No")
			USE IN aSales_No
		ENDIF
		cSQL = "SELECT DISTINCT UPPER(ShipRoute) AS ShipRoute FROM dbo.Sales_No ORDER BY ShipRoute"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSales_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSales_No')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSales_No')
		ENDIF
		*SELECT DISTINCT UPPER(ShipRoute) FROM Sales_No INTO ARRAY aShipRoutes
		IF USED('aSales_No')
			SELECT aSales_No
			*COPY TO ARRAY aShipRoutes FIELDS ShipRoute
			SELECT ShipRoute FROM aSales_No INTO ARRAY aShipRoutes
			USE IN aSales_No
		ELSE
			aShipRoutes(1) = ""
		ENDIF
		
		
		WAIT WINDOW "Get from Sales_No" NOWAIT
		
		IF USED("aSalesNum")
			USE IN aSalesNum
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Sales_No WHERE Salesnum = "+STR(nSalesnum)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSalesNum')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSalesNum')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSalesNum')
		ENDIF
		
		
		IF USED('aSalesNum')
			*SalesRep
			IF TYPE("aSalesNum.Instrct") = "C"
				IF ISNULL(aSalesNum.pShipAddr)
					ThisForm.Pageframe1.pgShipto.txtInstrct.Value	= ""
				ELSE
					ThisForm.Pageframe1.pgShipto.txtInstrct.Value	= aSalesNum.Instrct
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.txtInstrct.Value	= ""
			ENDIF
			
			IF TYPE("aSalesNum.pSoldAddr") = "N"
				IF ISNULL(aSalesNum.pShipAddr)
					ThisForm.SoldAddr = 0
				ELSE
					ThisForm.SoldAddr = aSalesNum.pSoldAddr
				ENDIF
			ELSE
				ThisForm.SoldAddr = 0
			ENDIF
			
			IF TYPE("aSalesNum.pShipAddr") = "N"
				IF ISNULL(aSalesNum.pShipAddr)
					ThisForm.ShipAddr = 0
				ELSE
					ThisForm.ShipAddr = aSalesNum.pShipAddr
				ENDIF
			ELSE
				ThisForm.ShipAddr = 0
			ENDIF
			
			IF TYPE("aSalesNum.ShipRoute")="C"
				IF ISNULL(aSalesNum.PayType)
					ThisForm.Pageframe1.pgShipto.txtShipRoute.Value	= ' '
				ELSE
					ThisForm.Pageframe1.pgShipto.txtShipRoute.Value	= aSalesNum.ShipRoute
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.txtShipRoute.Value	= ' '
			ENDIF
			
			IF TYPE("aSalesNum.ShipPay") = "C"
				IF ISNULL(aSalesNum.PayType)
					ThisForm.Pageframe1.pgShipto.cmbFrtPayment.Value= ' '
				ELSE
					*Not Entered,STD TERMS,Standard Terms,COD,COD,CREDIT CRD,Credit Card,WIRE TRANS,Wire Transfer,HOLD 4 PAY,Hold for Payment,LINKPOINT,LinkPoint,PAYPAL,PayPal,PREPAID,Prepaid
					ThisForm.Pageframe1.pgShipto.cmbFrtPayment.Value= aSalesNum.ShipPay
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.cmbFrtPayment.Value= ' '
			ENDIF
				
			IF TYPE("aSalesNum.PayType") = "C"
				IF ISNULL(aSalesNum.PayType)
					ThisForm.Pageframe1.pgShipto.cmbPayment.Value	= ' '
					ThisForm.PaymentType							= ' '
				ELSE
					* , Not Entered,FRT COLLECT,Freight Collect,ADD FREIGHT,Add Freight to bill,FRT PREPAY,Freight covered in Sale Price,3RD PARTY,3rd Party Billing
					ThisForm.Pageframe1.pgShipto.cmbPayment.Value	= aSalesNum.PayType
					ThisForm.PaymentType							= aSalesNum.PayType
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.cmbPayment.Value	= ' '
				ThisForm.PaymentType							= ' '
			ENDIF
			
			IF EMPTY(ThisForm.PaymentType)
				PRIVATE cPaymentTypeNumber
				cPaymentTypeNumber = GetPayType( SalesQuote.CustID, SalesQuote.Company, ThisForm.SoldAddr, ThisForm.nConnHandle )
				IF cPaymentTypeNumber $ "OverLimit"
					MESSAGEBOX("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!",64,"Warning, Allready over credit Limit!")
					Trackmess("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!, before adding SO "+ALLTRIM(STR(nSalesnum))+" frmEnterOrder.Init()")
					cPaymentTypeNumber = LEFT(cPaymentTypeNumber,1)
				ENDIF
				ThisForm.PaymentType = ShowPaymentTypeText(cPaymentTypeNumber)
				ThisForm.Pageframe1.pgShipto.cmbPayment.Value	= ThisForm.PaymentType
			ENDIF
			
			
			IF TYPE("aSalesNum.Paper_PO")= "L"
				IF ISNULL(aSalesNum.Blind)
					ThisForm.Pageframe1.pgShipto.chkReceivedPO.Value = 0
				ELSE
					ThisForm.Pageframe1.pgShipto.chkReceivedPO.Value = IIF(aSalesNum.Paper_PO,1,0)
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.chkReceivedPO.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.Blind")= "L"
				IF ISNULL(aSalesNum.Blind)
					ThisForm.Pageframe1.pgShipto.chkBlindSO.Value	= 0
				ELSE
					ThisForm.Pageframe1.pgShipto.chkBlindSO.Value	= IIF(aSalesNum.Blind,1,0)
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.chkBlindSO.Value	= 0
			ENDIF
			
			IF TYPE("aSalesNum.FaxConf") = "L"
				IF ISNULL(aSalesNum.FaxConf)
					THISFORM.Pageframe1.pgBillTo.ChkFax.VALUE = 0
				ELSE
					THISFORM.Pageframe1.pgBillTo.ChkFax.VALUE = IIF(aSalesNum.FaxConf,1,0)
				ENDIF
			ELSE
				THISFORM.Pageframe1.pgBillTo.ChkFax.VALUE = 0
			ENDIF
			
			IF TYPE("aSalesNum.EmailConf") = "L"
				IF ISNULL(aSalesNum.EmailConf)
					THISFORM.Pageframe1.pgBillTo.ChkEmail.VALUE = 0
				ELSE
					THISFORM.Pageframe1.pgBillTo.ChkEmail.VALUE = IIF(aSalesNum.EmailConf,1,0)
				ENDIF
			ELSE
				THISFORM.Pageframe1.pgBillTo.ChkEmail.VALUE = 0
			ENDIF
			
			IF TYPE("aSalesNum.FreightEst") = "N"
				IF ISNULL(aSalesNum.FreightEst)
					ThisForm.Pageframe1.pgShipto.txtFreightEst.Value = 0
				ELSE
					ThisForm.Pageframe1.pgShipto.txtFreightEst.Value = aSalesNum.FreightEst
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.txtFreightEst.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.PrintedSO") = "L"
				IF ISNULL(aSalesNum.PrintedSO)
					THISFORM.nPrintedSO = 0
				ELSE
					THISFORM.nPrintedSO = IIF(aSalesNum.PrintedSO,1,0)
				ENDIF
			ELSE
				THISFORM.nPrintedSO = 0
			ENDIF
			
			IF TYPE("aSalesNum.Addr_Ref") = "C"
				IF ISNULL(aSalesNum.Addr_Ref)
					ThisForm.Pageframe1.pgShipto.txtAddr_Ref.Value = ''
				ELSE
					ThisForm.Pageframe1.pgShipto.txtAddr_Ref.Value = aSalesNum.Addr_Ref
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.txtAddr_Ref.Value = ''
			ENDIF
			
			IF TYPE("aSalesNum.cncld")= "L"
				IF ISNULL(aSalesNum.cncld)
					ThisForm.Pageframe1.pgBillTo.chkCancel.Value = 0
				ELSE
					ThisForm.Pageframe1.pgBillTo.chkCancel.Value = IIF(aSalesNum.cncld,1,0)
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgBillTo.chkCancel.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.TarfBill")= "C"
				IF ISNULL(aSalesNum.TarfBill)
					ThisForm.Pageframe1.pgShipto.cmbTarfBill.Value = ''
				ELSE
					ThisForm.Pageframe1.pgShipto.cmbTarfBill.Value = aSalesNum.TarfBill
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.cmbTarfBill.Value = ''
			ENDIF
			
			IF TYPE("aSalesNum.USA") = "L"
				ThisForm.Pageframe1.pgShipto.chkUSA.Value = IIF(aSalesNum.USA,1,0)
			ELSE
				ThisForm.Pageframe1.pgShipto.chkUSA.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.ECPC") = "L"
				IF ISNULL(aSalesNum.ECPC)
					ThisForm.Pageframe1.pgShipto.chkECPC.Value = 0
				ELSE
					ThisForm.Pageframe1.pgShipto.chkECPC.Value = IIF(aSalesNum.ECPC,1,0)
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgShipto.chkECPC.Value = 0
			ENDIF
			
			IF TYPE("aSalesNum.Amendment") = "N"
				IF ISNULL(aSalesNum.Amendment) 
					ThisForm.Pageframe1.pgBillTo.txtAmendment.Value = 0
					ThisForm.Pageframe1.pgQA.txtVersion.Value = 0
					*ThisForm.Pageframe1.pgBillTo.txtAmendment.Visible = .F.
					*ThisForm.Pageframe1.pgBillTo.lblAmendment.Visible = .F.	
				ELSE
					ThisForm.Pageframe1.pgBillTo.txtAmendment.Value = aSalesNum.Amendment
					ThisForm.Pageframe1.pgQA.txtVersion.Value = aSalesNum.Amendment
					IF aSalesNum.Amendment > 0
						ThisForm.Pageframe1.pgBillTo.txtAmendment.Visible = .T.
						ThisForm.Pageframe1.pgBillTo.lblAmendment.Visible = .T.
					ELSE
						*ThisForm.Pageframe1.pgBillTo.txtAmendment.Visible = .F.
						*ThisForm.Pageframe1.pgBillTo.lblAmendment.Visible = .F.	
					ENDIF
				ENDIF
			ELSE
				ThisForm.Pageframe1.pgBillTo.txtAmendment.Value = 0
				ThisForm.Pageframe1.pgQA.txtVersion.Value = 0
				*ThisForm.Pageframe1.pgBillTo.txtAmendment.Visible = .F.
				*ThisForm.Pageframe1.pgBillTo.lblAmendment.Visible = .F.
			ENDIF
			
			IF TYPE("aSalesNum.Changing") = "L"
				IF aSalesNum.Changing
					MESSAGEBOX("This Order has been changed and the Version number has not been updated."+CHR(13)+"Save or Print this order to refresh the Version number!",0+64,"SO has changed!")
				ENDIF
			ENDIF
				
			USE IN aSalesNum
		
		ELSE
			*No record exists - INIT
			ThisForm.Pageframe1.pgShipto.cmbTarfBill.Value = "RECEPIENT"
			ThisForm.Pageframe1.pgShipto.chkUSA.Value = 1
		ENDIF
		***** End Sales_No
		
		IF ThisForm.ShipAddr > 0
			ThisForm.Pageframe1.pgShipto.txtShipCode.Value = ThisForm.ShipAddr
			
		*!*		IF NOT USED('ShipAddr')
		*!*			USE ShipAddr IN 0 ORDER TAG Shipcode
		*!*		ENDIF
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			SELECT 0
		
			cSQL = "SELECT * FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE ShipCode = "+STR(ThisForm.ShipAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
			ENDIF
			SELECT aShipAddr
		*	IF SEEK(ThisForm.ShipAddr,"ShipAddr","ShipCode" ) &&Found the record
			IF USED('aShipAddr')
				ThisForm.Pageframe1.pgShipto.txtCompany.Value 	= aShipAddr.Company
				ThisForm.Pageframe1.pgShipto.txtAddr1.Value		= aShipAddr.Addr1	
				ThisForm.Pageframe1.pgShipto.txtAddr2.Value		= aShipAddr.Addr2
				ThisForm.Pageframe1.pgShipto.txtCity.Value 		= aShipAddr.City	
				ThisForm.Pageframe1.pgShipto.txtST.Value		= aShipAddr.ST
				ThisForm.Pageframe1.pgShipto.txtZip.Value		= aShipAddr.Zip
				ThisForm.Pageframe1.pgShipto.txtCountry.Value	= aShipAddr.Country
				ThisForm.Pageframe1.pgShipto.txtContact.Value	= aShipAddr.Contact
				ThisForm.Pageframe1.pgShipto.txtPhone.Value		= aShipAddr.Telephone
				ThisForm.Pageframe1.pgShipto.txtFax.Value		= aShipAddr.Fax_Number
				ThisForm.Pageframe1.pgShipto.txtEmail.Value		= aShipAddr.Email
				ThisForm.Pageframe1.pgShipto.txtLastEdit.Value	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
					
				ThisForm.AddressScreen("ShipToEdit")
				
				USE IN aShipAddr
			ENDIF
		ENDIF
		IF ThisForm.SoldAddr > 0
			ThisForm.Pageframe1.pgBillto.txtSoldCode.Value = ThisForm.SoldAddr
			
		*!*		IF NOT USED('SoldAddr')
		*!*			USE SoldAddr IN 0 ORDER TAG soldcode
		*!*		ENDIF
			IF USED( 'SoldAddr' )
				USE IN SoldAddr
			ENDIF
			SELECT 0
			cSQL = "SELECT * FROM dbo.SoldAddr "
			cSQL = cSQL + " WHERE SoldCode = "+STR(ThisForm.SoldAddr)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldAddr')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
			ENDIF
		
		*	SELECT SoldAddr
			IF USED('SoldAddr')
			*IF SEEK(ThisForm.SoldAddr,"SoldAddr","SoldCode" ) &&Found the record
				ThisForm.Pageframe1.pgBillto.txtCompany.Value 	= SoldAddr.Company
				ThisForm.Pageframe1.pgBillto.txtAddr1.Value		= SoldAddr.Addr1	
				ThisForm.Pageframe1.pgBillto.txtAddr2.Value		= SoldAddr.Addr2
				ThisForm.Pageframe1.pgBillto.txtCity.Value 		= SoldAddr.City	
				ThisForm.Pageframe1.pgBillto.txtST.Value		= SoldAddr.ST
				ThisForm.Pageframe1.pgBillto.txtZip.Value		= SoldAddr.Zip
				ThisForm.Pageframe1.pgBillto.txtCountry.Value	= SoldAddr.Country
				ThisForm.Pageframe1.pgBillto.txtContact.Value	= SoldAddr.Contact
				ThisForm.Pageframe1.pgBillto.txtPhone.Value		= SoldAddr.Telephone
				ThisForm.Pageframe1.pgBillto.txtFax.Value		= SoldAddr.Fax_Number
				ThisForm.Pageframe1.pgBillto.txtEmail.Value		= SoldAddr.Email
				ThisForm.Pageframe1.pgBillto.txtLastEdit.Value	= IIF(EMPTY(PrepareSQLdate(SoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(SoldAddr.LastEdit,'LastEdit'))
						
				thisform.AddressScreen("SoldToEdit")
				
				USE IN SoldAddr
			ENDIF
		ENDIF
		
		
		*****
		SELECT SalesQuote
		PRIVATE lnATlt, lcrLeadTime, ldLTDate, lnLTVal
		lcrLeadTime = ''
		SCAN
		*	IF VARTYPE(SalesQuote.ShipDue) = "T"
		*		SalesQuote.ShipDue = TTOD(SalesQuote.ShipDue)
		*	ENDIF
			IF EMPTY(SalesQuote.ShipDue) OR SalesQuote.ShipDue = CTOD("01/01/1900")
				IF NOT EMPTY(SalesQuote.LeadTime)
					
					*Duplicate changes here with select4order.cmdDone4Order.Click
					IF CTOD(SalesQuote.LeadTime) != CTOD("  /  /  ")
						*Allready in Date Format
						ldLTDate = CTOD(SalesQuote.LeadTime)
					ELSE
						lnATlt = AT("-",SalesQuote.LeadTime)
						lcrLeadTime  = IIF(lnATlt > 0,SUBSTR(SalesQuote.LeadTime,lnATlt+1) ,SalesQuote.LeadTime)
						lnLTVal = VAL(lcrLeadTime )
			
						IF "WK" $ UPPER(lcrLeadTime ) OR  "WEEK" $ UPPER(lcrLeadTime )
							IF lnLTVal > 0
								ldLTDate = DATE()+ (lnLTVal * 7) && num * 7Days/week
							ELSE
								ldLTDate = DATE()+ 7 &&1wk
							ENDIF
						ELSE
							IF lnLTVal > 0
								ldLTDate = DATE() + (lnLTVal) && num of days
							ELSE
								ldLTDate = DATE()+1	 && could not parse data
							ENDIF
						ENDIF
					ENDIF
					
					IF AT( "/", lcrLeadTime  , 2 )>0 OR AT( "-", lcrLeadTime  , 2 )>0 
						**MUST BE A DATE!
						ldLTDate = CTOD(lcrLeadTime)
					ENDIF
					
				ELSE
					ldLTDate = DATE()+1
					
				ENDIF
		
		
				**Correct for weekends
				DO CASE
				CASE DOW(ldLTDate) = 7 &&Saterday
					ldLTDate = ldLTDate + 2
				CASE DOW(ldLTDate ) = 1 &&Sun
					ldLTDate = ldLTDate + 1
				ENDCASE
				
				IF NOT EMPTY(ldLTDate)
					REPLACE ShipDue WITH ldLTDate IN SalesQuote
				
					cSQLu = "UPDATE dbo.Sales SET "
					cSQLu = cSQLu + "ShipDue='"+IIF(EMPTY(ldLTDate),'',DTOC(ldLTDate))+"'"
					cSQLu = cSQLu + " WHERE SOitem = dbo.ProperSO('"+SalesQuote.SoItem_a+"')"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!, long triger
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC,'')
					ENDIF	
				ENDIF
			ENDIF
		
			IF EMPTY(SalesQuote.ItemSale) OR VARTYPE(SalesQuote.ItemSale)="X" 
				SELECT SalesQuote
				PRIVATE nCalcLotP 
				nCalcLotP = THISFORM.CalcLotp()
				ThisForm.UpdtItemSale(nCalcLotP)
			ENDIF
			
		ENDSCAN  &&Salesnum
		
		PUBLIC ARRAY gaPoItems(1)
		gaPoItems(1) = ''
		PUBLIC ARRAY gaContactIDs(1)
		gaContactIDs(1) = 0
		PUBLIC ARRAY gaPOcompany(1)
		gaPOcompany(1) = ""
		
		
		GO TOP
		WAIT CLEAR
		
		IF USED( 'aShipAddr' )
			USE IN aShipAddr
		ENDIF
		ThisForm.VendCode = 0
	ENDPROC

	PROCEDURE Load
		IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		IF VARTYPE(gnConnHandle) = "N"
			IF gnConnHandle > 0
				ThisForm.nConnhandle = gnConnHandle
			ELSE
				STORE get_SQLSTRINGCONNECT() TO ThisForm.nConnHandle &&gnSOch
			ENDIF
		ELSE
			STORE get_SQLSTRINGCONNECT() TO ThisForm.nConnHandle
		ENDIF
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpValue')
			USE IN tmpValue
		ENDIF
		IF USED('Graph')
			USE IN Graph
		ENDIF
		IF USED('SalesNum2')
			USE IN SalesNum2
		ENDIF
		IF USED('SalesNum')
			USE IN SalesNum
		ENDIF
		IF USED("PurchaseOrder")
			USE IN PurchaseOrder
		ENDIF
		
		
		IF USED("SalesQuote")
			USE IN SalesQuote
		ENDIF
		IF USED("QuotesSO")
			USE IN QuotesSO
		ENDIF
		IF USED("tmpPoItemDetail")
			USE IN tmpPoItemDetail
		ENDIF
		IF USED("CreditCd")	
			USE IN CreditCd
		ENDIF
		
		IF ThisForm.nConnHandle > -1
		IF VARTYPE(gnConnHandle) = "N"
			IF gnConnHandle = ThisForm.nConnhandle
				* Do not close!
			ELSE
				= SQLDISCONNECT(ThisForm.nConnHandle)
			ENDIF
		ELSE
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		ENDIF
		
		*!*	IF ThisForm.Close_Ship
		*!*		IF USED('SHIP')
		*!*			USE IN SHIP
		*!*		ENDIF
		*!*	ELSE
		*!*		IF USED('SHIP')
		*!*			SELECT SHIP
		*!*			USE SHIP NOUPDATE
		*!*		ENDIF
		*!*	ENDIF
		
		IF ThisForm.Close_Sales
			IF USED('SALES')
				USE IN SALES 
			ENDIF
		ELSE
			IF USED('SALES')
				SELECT Sales
		*		USE SALES NOUPDATE
			ENDIF
		ENDIF
		IF USED('Sales_No')
			USE IN Sales_No
		ENDIF
		
		IF USED('HardWood')
			USE IN HardWood
		ENDIF
		
		IF USED('VendorContacts')
			USE IN VendorContacts
		ENDIF
		
		IF USED('Vendor')
			USE IN Vendor
		ENDIF
		
		
		IF USED('SalesTotal')
			USE IN SalesTotal
		ENDIF
	ENDPROC

ENDDEFINE
