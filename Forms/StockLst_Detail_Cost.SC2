	PROCEDURE pf.pgSales_Invoice.txtQuantity.Valid
		PRIVATE nQuantity, nID, nPrevQuantity, nAmount
		nQuantity = This.Value
		nID = tmpInvoice.ID
		nPrevQuantity = tmpInvoice.Quantity
		
		UPDATE tmpInvoice SET Quantity = nQuantity WHERE ID = nID
		
		SELECT tmpInvoice
		LOCATE FOR ID=nID
		
	ENDPROC

	PROCEDURE pf.pgSales_Stock.cmdStkHistory.Click
		PRIVATE nTBL,cTBL, nID, nID_Detail
		nTBL = ThisForm.ogTBL.Value
		DO CASe
		CASE nTBL = 1
			cTBL = 'S'
		CASE nTBL = 2
			cTBL = 'B'
		CASE nTBL = 3
			cTBL = 'W'
		OTHERWISE
			cTBL = ''
		ENDCASE
		
		nID = 0
		nID_Detail = ThisForm.ID_Detail
		
		
		DO FORM Forms\StockLst_History.scx WITH cTBL,nID, nID_Detail
	ENDPROC

	PROCEDURE pf.pgSales_Stock.grdSales_Stock.AfterRowColChange
		LPARAMETERS nColIndex
		
		*Thisform.Refresh_Sales_Stock()
		
		
		WAIT WINDOW "Refreshed." NOWAIT
	ENDPROC

	PROCEDURE pf.pgSales_Stock.grdSales_Stock.DblClick
		IF USED('tmpSales_Stock')
			IF RECCOUNT('tmpSales_Stock') > 0
				SELECT tmpSales_Stock
				DEFINE WINDOW wBrowse FROM 1, 1 TO 10, 100 TITLE "Browse" CLOSE FLOAT GROW ZOOM FONT 'Arial', 9
				BROWSE WINDOW wBrowse NOWAIT
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pf.pgSales_Stock.grdSales_Stock.Deleted
		LPARAMETERS nRecNo
	ENDPROC

	PROCEDURE pf.pgSales_Stock.grdSales_Stock.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
	ENDPROC

	PROCEDURE pf.pgSales_Stock.lblPOitem.Click
		PRIVATE nPO
		nPO = Proper_PO_item_PO(ThisForm.txtStockLst_POitem.Value)
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_PO(nPO,.T.) &&lReturnURL --not URL is an HTML code.
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		
		
		WAIT WINDOW "Look for a blinking Internet Explorer to view the PO!" NOWAIT
		
		
	ENDPROC

	PROCEDURE pf.pgSales_Stock.LBLSOITEM1.Click
		PRIVATE nSO
		nSO = Proper_SO_item_SO(ThisForm.txtSOitem.Value)
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_SO(nSO,.T.) &&lReturnURL --not URL is an HTML code.
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		
		
		WAIT WINDOW "Look for a blinking Internet Explorer to view the SO!" NOWAIT
		
	ENDPROC

	PROCEDURE txtID_Detail.Valid
		PRIVATE nID_Detail
		nID_Detail = PrepareSQLnum(This.Value,'ID_Detail',10)
		IF nID_Detail > 0
			This.Parent.cmdSearchID_Detail.Click
		ENDIF
	ENDPROC

ENDDEFINE
