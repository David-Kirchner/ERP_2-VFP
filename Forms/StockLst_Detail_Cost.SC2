	PROCEDURE dynamic_back_color_who
		*ThisForm.Dynamic_Back_Color_Who()
		PRIVATE nColor, nN
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		nN = RIGHT(StockLst_Master_HISTORY.WHO,11)
		nN = SOUNDEX(nN)
		nN = RIGHT(nN,3)
		nN = VAL(nN)
		*IF nN > 255
			nN = nN/4
		*ENDIF
		nN = ROUND(nN,0)
		
		nR = nN
		*nG = ABS(255- nN/10)
		nG = 200
		nB = ABS(255- nN)
		
		nColor = RGB( nR,nG,nB ) 
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamic_back_color_who_detail
		*ThisForm.Dynamic_Back_Color_Who_Detail()Process_History
		PRIVATE nColor
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		nN = RIGHT(StockLst_Detail.WHO,11)
		nN = SOUNDEX(nN)
		nN = RIGHT(nN,3)
		nN = VAL(nN)
		nN = nN/4
		nN = ROUND(nN,0)
		
		nR = nN
		nG = 200
		nB = ABS(255- nN)
		
		nColor = RGB( nR,nG,nB ) 
		
		RETURN nColor
	ENDPROC

	PROCEDURE getidfromid_detail
		PARAMETER pID_Detail
		
		PRIVATE nID_Detail
		nID_Detail = 0
		
		
		IF TYPE("pID_Detail") = "C"
			pID_Detail = VAL(pID_Detail)
		ENDIF
		
		IF TYPE("pID_Detail") = "N"
			nID_Detail = pID_Detail
		ELSE
			nID_Detail = 0
		ENDIF
		
		IF nID_Detail = 0
			RETURN
		ENDIF
		
		PRIVATE cSQL_ID, nSQLEXEC 
		cSQL_ID=        "SELECT ID FROM "
		DO CASE
		CASE ThisForm.ogTBL.Value=1
			cSQL_ID=cSQL_ID+"dbo.StockLst_Detail"
		CASE ThisForm.ogTBL.Value=2
			cSQL_ID=cSQL_ID+"dbo.BrokerLst_Detail"
		CASE ThisForm.ogTBL.Value=3
			cSQL_ID=cSQL_ID+"dbo.WIPLst_Detail"
		ENDCASE
		
		cSQL_ID=cSQL_ID+" WHERE ID_Detail = "+STR(nID_Detail)+" UNION "
		cSQL_ID=cSQL_ID+"SELECT ID FROM "
		DO CASE
		CASE ThisForm.ogTBL.Value=1
			cSQL_ID=cSQL_ID+"dbo.StockLst_Detail"
		CASE ThisForm.ogTBL.Value=2
			cSQL_ID=cSQL_ID+"dbo.BrokerLst_Detail"
		CASE ThisForm.ogTBL.Value=3
			cSQL_ID=cSQL_ID+"dbo.WIPLst_Detail"
		ENDCASE
		
		cSQL_ID=cSQL_ID+" WHERE ID_Detail = "+STR(nID_Detail)
		
		IF USED("StockLst_ID")
			SELECT StockLst_ID
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ID, 'StockLst_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ID, 'StockLst_ID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ID, "StockLst_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ID, "StockLst_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_ID,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_ID')
		ELSE
			IF RECNO("StockLst_ID") > 0
				SELECT StockLst_ID
				IF StockLst_ID.ID > 0
					ThisForm.txtMaster_ID.Value = StockLst_ID.ID
				ELSE
					ThisForm.txtMaster_ID.Value = 0
				ENDIF
			ELSE
				*NO ID
				ThisForm.txtMaster_ID.Value = 0
			ENDIF
		ENDIF
		
		IF USED("StockLst_ID")
			USE IN StockLst_ID
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS nID_Detail, nCostValue, mS_P, cTBL
		*DO FORM Forms\StockLst_Detail_Cost.scx WITH 32179, 0,0, 'S'
		*DO FORM Forms\StockLst_Detail_Cost.scx WITH nID_Detail, nCostValue, mS_P, cTBL
		
		IF VARTYPE(nID_Detail) != "N"
			nID_Detail = 0
			**Use dummy numbers
			nID_Detail = 32179
			cTBL = 'S'
		ENDIF
		ThisForm.txtID_Detail.Value = nID_Detail
		
		IF VARTYPE(cTBL) = "C"
			DO CASE
			CASE UPPER(cTBL) = "S"
				ThisForm.ogTBL.Value = 1
				ThisForm.cTBL = "S"
			CASE UPPER(cTBL) = "B"
				ThisForm.ogTBL.Value = 2
				ThisForm.cTBL = "B"
			CASE UPPER(cTBL) = "W"
				ThisForm.ogTBL.Value = 3
				ThisForm.cTBL = "W"
			ENDCASE
			
		ENDIF
		
		IF VARTYPE(nCostValue) != "N" AND VARTYPE(nCostValue) != "Y"
			nCostValue = 0
		ELSE
			*Show
			ThisForm.lblCostValue.Visible = .T.
			ThisForm.txtCostValue.Visible = .T.
			ThisForm.txtCostValue.Value = nCostValue
		ENDIF 
		
		IF VARTYPE(mS_P) != "N" AND VARTYPE(mS_P) != "Y"
			mS_P= 0
		ELSE
			*Show
			ThisForm.lblStock_P.Visible = .T.
			ThisForm.txtStock_P.Visible = .T.
			ThisForm.txtStock_P.Value = mS_P
		ENDIF 
		
		*Get Master Info.
		****************
		cSQL = "SELECT TOP 1 MH.alloy,MH.form,MH.cc,MH.size,MH.cond,MH.specs,MH.heat,MH.lot,MH.Paid,MH.po_item"
		cSQL = cSQL + " ,CAST(MH.[poduedate] AS DATE) AS poduedate,MH.[mill]"
		cSQL = cSQL + " ,CAST(MH.[stkdate] AS DATE) AS stkdate,MH.ID "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History MH "
			cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History "
			cSQL = cSQL + " ON MH.ID = StockLst_Detail_History.ID "
			cSQL = cSQL + " WHERE StockLst_Detail_History.ID_Detail ="+STR(nID_Detail)
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.Ar_BrokerLst_Master_history MH "
			cSQL = cSQL + " INNER JOIN dbo.Ar_BrokerLst_Detail_History "
			cSQL = cSQL + " ON MH.ID = BrokerLst_Detail_History.ID "
			cSQL = cSQL + " WHERE BrokerLst_Detail_History.ID_Detail ="+STR(nID_Detail)
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.Ar_WIPLst_Master_History MH "
			cSQL = cSQL + " INNER JOIN dbo.Ar_WIPlst_Detail_History "
			cSQL = cSQL + " ON MH.ID = WIPLst_Detail_History.ID "
			cSQL = cSQL + " WHERE WIPLst_Detail_History.ID_Detail ="+STR(nID_Detail)
		ENDCASE
		
		
		IF USED("StockLst_Master_HISTORY")
			SELECT StockLst_Master_HISTORY
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_HISTORY')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_HISTORY')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master_HISTORY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master_HISTORY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Master_HISTORY')
		ENDIF
		
		IF USED("StockLst_Master_HISTORY")
			IF RECCOUNT("StockLst_Master_HISTORY") > 0
				*Show Master
				*alloy,form,cc,size,cond,specs,heat,lot,Paid,po_item,[poduedate],[mill],[stkdate]
				ThisForm.txtMaster_ID.Value = StockLst_Master_HISTORY.ID
				ThisForm.txtPaid.Value = StockLst_Master_HISTORY.Paid
				ThisForm.txtPO_Item.Value = StockLst_Master_HISTORY.po_item
				ThisForm.txtMill.Value = StockLst_Master_HISTORY.mill
				ThisForm.txtAlloy.Value = StockLst_Master_HISTORY.alloy
				ThisForm.txtForm.Value = StockLst_Master_HISTORY.form
				ThisForm.txtCC.Value = StockLst_Master_HISTORY.cc
				ThisForm.txtSize.Value = StockLst_Master_HISTORY.size
				ThisForm.txtHeat.Value = StockLst_Master_HISTORY.heat
				ThisForm.txtLot.Value = StockLst_Master_HISTORY.lot
				ThisForm.txtPODueDate.Value = StockLst_Master_HISTORY.poduedate
				ThisForm.txtStockDate.Value = StockLst_Master_HISTORY.stkdate
				ThisForm.txtCond.Value = StockLst_Master_HISTORY.cond
				ThisForm.txtSpecs.Value = StockLst_Master_HISTORY.specs
			ENDIF
		ENDIF
		
		*Get Sales_Detail
		****************
		cSQL = "SELECT  * "
		cSQL = cSQL + " FROM dbo.Sales_Detail SD"
		cSQL = cSQL + " WHERE SD.StockLst_ID_Detail ="+STR(nID_Detail)
		cSQL = cSQL + " AND ISNULL(SD.Cancelled,0) = 0"
		
		IF USED("tmpSales_Detail")
			SELECT tmpSales_Detail
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSales_Detail')
		ENDIF
		
		IF USED("tmpSales_Detail")
			IF RECCOUNT("tmpSales_Detail") > 0
				*Show Sales Detail
				*grd
				ThisForm.pf.PGSales_Detail.grdSales_Detail.RecordSource = 'tmpSales_Detail'
				ThisForm.Show_Sales_Detail()
			ENDIF
		ENDIF
		
		*Get Sales_Invoice 
		****************
		cSQL = "SELECT  * "
		cSQL = cSQL + " FROM dbo.Sales_Invoice SI"
		cSQL = cSQL + " WHERE SI.Sales_Detail_ID="+STR(nID_Detail)
		
		
		IF USED("tmpSales_Invoice")
			SELECT tmpSales_Invoice
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Invoice')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Invoice')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Invoice")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Invoice")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSales_Invoice')
		ENDIF
		
		IF USED("tmpSales_Invoice")
			IF RECCOUNT("tmpSales_Invoice") > 0
				*Show Sales Invoice
				*grd
				ThisForm.pf.PGSales_Detail.grdSales_Detail.RecordSource = 'tmpSales_Invoice'
				ThisForm.Show_Sales_Invoice()
			ENDIF
		ENDIF
		
		*Get Sales_Stock
		****************
		cSQL = "SELECT  * "
		cSQL = cSQL + " FROM dbo.Sales_Stock SS WITH(NOLOCK)"
		cSQL = cSQL + " WHERE SS.StockLst_ID_Detail ="+STR(nID_Detail)
		
		
		IF USED("tmpSales_Stock")
			SELECT tmpSales_Stock
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Stock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Stock')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Stock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Stock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSales_Stock')
		ENDIF
		
		IF USED("tmpSales_Stock")
			IF RECCOUNT("tmpSales_Stock") > 0
				*Show Sales Detail
				*grd
				*ThisForm.pf.PGSales_Detail.grdSales_Detail.RecordSource = 'tmpSales_Stock'
				ThisForm.Show_Sales_Stock()
			ENDIF
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
