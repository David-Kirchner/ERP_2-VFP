			ENDIF
			**************************************
			
		*!*		cSQL = "SELECT S.*,Q.Pieces,Q.Thck,Q.Weight "
		*!*		cSQL = cSQL +" ,dbo.f_Descript(Q.Alloy,Q.CC,Q.Form,Q.Thck,Q.Sz2,Q.Sz3,Q.Weight,Q.RandLen) AS Descript "
		*!*		cSQL = cSQL +" FROM dbo.Sales S"
		*!*		cSQL = cSQL +" INNER JOIN dbo.AllQuotes Q ON S.Soitem = Q.SOitem "
		*!*		IF EMPTY( cSOitem )
		*!*			cSQL = cSQL +" WHERE 0>0 "
		*!*		ELSE
		*!*			cSQL = cSQL +" WHERE S.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*		ENDIF
		
		*!*		IF USED('tmpSales')
		*!*			USE IN tmpSales
		*!*		ENDIF
		*!*		SELECT 0
		
		*!*		nSQLEXEC = SQLEXEC(Thisform.nConnHandle, cSQL, 'tmpSales')
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( Thisform.nConnHandle, cSQL, 'tmpSales' )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL, Thisform.nConnHandle, nSQLEXEC, 'tmpSales' )
		*!*		ENDIF
		
		*!*		IF USED('tmpSales')
		*!*			IF RECCOUNT('tmpSales') > 0
		*!*				Thisform.frmSales_Reconcile.txtSales_QTY.Value 	= PrepareSQLnum(tmpSales.Quoted_QTY,'Quoted_QTY',-5)
		*!*				Thisform.frmSales_Reconcile.txtSales_PU.Value 	= PrepareSQLnum( tmpSales.Quoted_PU,'StockLst_PU',-1)
		*!*				Thisform.frmSales_Reconcile.txtSales_PUstr.Value 	= PrepareSQLtxt( Get_PUtext( tmpSales.Quoted_PU ) ,'StockLst_PU',6)
		*!*				Thisform.frmSales_Reconcile.txtSales_P.Value 	= PrepareSQLnum(tmpSales.Quoted_P,'Quoted_P',-5)
		*!*				Thisform.frmSales_Reconcile.txtSales_Total.Value= PrepareSQLnum(tmpSales.Quoted_Total,'Quoted_Total',-5)
		*!*				
		*!*				Thisform.frmSales_Reconcile.txtSales_PC.Value 	= PrepareSQLnum(tmpSales.Pieces,'Pieces',-3)
		*!*				*Thisform.frmSales_Reconcile.txtSales_Dim1.Value	= PrepareSQLnum(tmpSales.Thck,'Thck',10,4)
		*!*				Thisform.frmSales_Reconcile.txtSales_Descript.Value	= PrepareSQLtxt(tmpSales.Descript,'Descript',-1)
		*!*				Thisform.frmSales_Reconcile.txtSales_LBS.Value 	= PrepareSQLnum(tmpSales.Weight ,'Weight ',7,2)
		*!*			ELSE
		*!*				Thisform.frmSales_Reconcile.txtSales_QTY.Value 	= 0
		*!*				Thisform.frmSales_Reconcile.txtSales_PU.Value 	= 0
		*!*				Thisform.frmSales_Reconcile.txtSales_PUstr.Value = Get_PUtext(0)
		*!*				Thisform.frmSales_Reconcile.txtSales_P.Value 	= 0
		*!*				Thisform.frmSales_Reconcile.txtSales_Total.Value = 0
		*!*				
		*!*				Thisform.frmSales_Reconcile.txtSales_PC.Value 	= 0
		*!*				*Thisform.frmSales_Reconcile.txtSales_Dim1.Value	= 0
		*!*				Thisform.frmSales_Reconcile.txtSales_Descript.Value	= ''
		*!*				Thisform.frmSales_Reconcile.txtSales_LBS.Value 	= 0		
		*!*			ENDIF
		*!*			USE IN tmpSales
		*!*		ENDIF
		*!*			
		*!*		**************************************
		*!*		Thisform.Show_lstSales_Detail_ID()
		*!*		
		*!*		*Sum Stock
		*!*		Thisform.ShowSumStock()
		*!*		
		*!*		*Sum PackingSlip
		*!*		Thisform.ShowSumPackingSlip()
		
		*!*		*Sum Invoice
		*!*		Thisform.ShowSumInvoice()
		*!*		
		*!*		*Show Quoted
		*!*		Thisform.ShowQuotedTotal()
		*!*			
		*!*		*AllQuote
		*!*		Thisform.Show_Quote()		
		*!*		
		*!*		*Add up SO item
		*!*		Thisform.ShowSumTotal()
		*!*		
		ELSE
			*Thisform.frmSales_Reconcile.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE show_sales_invoice
		*ThisForm.Show_Sales_Invoice()
		
		IF USED('tmpSales_Invoice')
			IF RECCOUNT('tmpSales_Invoice') > 0
				*ThisForm.pf.pgSales_Invoice.Visible = .T.
				
				ThisForm.pf.pgSales_Invoice.txtCustomerID.Value 	= tmpSales_Invoice.CustomerID
				ThisForm.pf.pgSales_Invoice.txtCustomerName.Value= tmpSales_Invoice.CustomerName
				ThisForm.pf.pgSales_Invoice.chkReconciled.Value	= PrepareSQLchk(tmpSales_Invoice.Reconciled,'Reconciled')
				ThisForm.pf.pgSales_Invoice.txtInvoice.Value 	= tmpSales_Invoice.Invoice
				ThisForm.pf.pgSales_Invoice.txtInvoiceDate.Value = tmpSales_Invoice.InvoiceDate
				ThisForm.pf.pgSales_Invoice.txtCustomer_PO.Value = tmpSales_Invoice.Customer_PO
				ThisForm.pf.pgSales_Invoice.txtShip_Via.Value 	= tmpSales_Invoice.Ship_Via
				ThisForm.pf.pgSales_Invoice.txtSales_Rep.Value 	= tmpSales_Invoice.Sales_Rep
				ThisForm.pf.pgSales_Invoice.txtAR_Amount.Value 	= tmpSales_Invoice.AR_Amount
		*!*			IF PrepareSQLnum(tmpSales_Invoice.Paid,'Paid',-5) = 0
		*!*				*ThisForm.pf.pgSales_Invoice.txtPaid.Value 	= ABS(tmpSales_Invoice.AR_Amount)
		*!*				ThisForm.pf.pgSales_Invoice.txtPaid.Value 	= ABS(tmpSales_Invoice.Amount)
		*!*				SELECT tmpSales_Invoice
		*!*				nID = tmpSales_Invoice.ID
		*!*				*UPDATE tmpSales_Invoice SET Paid = ABS(tmpSales_Invoice.AR_Amount) WHERE ID = nID
		*!*				UPDATE tmpSales_Invoice SET Paid = ABS(tmpSales_Invoice.Amount) WHERE ID = nID
		*!*				LOCATE FOR ID = nID
		*!*			ELSE
		*!*				ThisForm.pf.pgSales_Invoice.txtPaid.Value 	= tmpSales_Invoice.Paid
		*!*			ENDIF
				ThisForm.pf.pgSales_Invoice.txtAmount.Value 		= (tmpSales_Invoice.Amount)
				ThisForm.pf.pgSales_Invoice.txtDisc_Amount.Value = tmpSales_Invoice.Disc_Amount
				ThisForm.pf.pgSales_Invoice.txtItem.Value 		= tmpSales_Invoice.Item
				ThisForm.pf.pgSales_Invoice.txtItemTot.Value 	= tmpSales_Invoice.ItemTot
				ThisForm.pf.pgSales_Invoice.txtGL_Account.Value 	= tmpSales_Invoice.GL_Account
				ThisForm.pf.pgSales_Invoice.txtInvoice_Note.Value= tmpSales_Invoice.Invoice_Note
				ThisForm.pf.pgSales_Invoice.txtSOitem.Value 		= tmpSales_Invoice.SOitem
				ThisForm.pf.pgSales_Invoice.txtQuantity.Value 	= tmpSales_Invoice.Quantity
				ThisForm.pf.pgSales_Invoice.txtUnitPrice.Value 	= tmpSales_Invoice.UnitPrice
				ThisForm.pf.pgSales_Invoice.txtTrans_Period.Value = tmpSales_Invoice.Trans_Period
				ThisForm.pf.pgSales_Invoice.txtTrans_No.Value 	= tmpSales_Invoice.Trans_No
				ThisForm.pf.pgSales_Invoice.txtReturnAuth.Value 	= tmpSales_Invoice.ReturnAuth
				ThisForm.pf.pgSales_Invoice.txtDescription.Value	= tmpSales_Invoice.Description
				ThisForm.pf.pgSales_Invoice.txtShip_Date.Value 	= tmpSales_Invoice.Ship_Date
				ThisForm.pf.pgSales_Invoice.txtDate_Due.Value 	= tmpSales_Invoice.Date_Due
				
		*!*			IF PrepareSQLlogic(tmpSales_Invoice.Reconciled,'Reconciled',.F.)
		*!*				ThisForm.pf.pgSales_Invoice.cmdSave.Caption = 'Update'
		*!*			ELSE
		*!*				ThisForm.pf.pgSales_Invoice.cmdSave.Caption = 'Save'
		*!*			ENDIF
				
				
				
				IF DELETED('tmpSales_Invoice') 
					ThisForm.pf.pgSales_Invoice.BackColor = RGB(255,128,128)
				ELSE
					ThisForm.pf.pgSales_Invoice.BackColor = RGB(240,240,240)
				ENDIF
		
			ELSE
		*		ThisForm.pf.pgSales_Invoice.Visible = .F.
		
			ENDIF
		ELSE
		*	ThisForm.pf.pgSales_Invoice.Visible = .F.
		ENDIF
	ENDPROC

