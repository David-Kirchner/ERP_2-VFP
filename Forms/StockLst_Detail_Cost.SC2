				Thisform.pf.pgSales_Detail.txtStkPaid_P.Value 		= 0
				Thisform.pf.pgSales_Detail.txtStockLst_Total.Value	= 0
				Thisform.pf.pgSales_Detail.txtStkPaid_Total.Value 	= 0
