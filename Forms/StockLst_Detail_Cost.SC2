	PROCEDURE Resize
		PRIVATE nDeltaH, nDeltaW
		
		nDeltaH = This.Height - 500
		nDeltaW = This.Width  - 750
		
		IF This.Height > 415
			ThisForm.pf.Height = 300 + nDeltaH 
		ENDIF
		IF This.Width >  750
			ThisForm.pf.Width = 740 + nDeltaW
		ENDIF
		
	ENDPROC

	PROCEDURE show_sales_detail
		*ThisForm.Show_Sales_Detail()
		
		IF USED('tmpSales_Detail')
			IF RECCOUNT('tmpSales_Detail') > 0
		
				*ThisFormset.frmSales_Reconcile.Visible = .T.
				
				Thisform.pf.pgSales_Detail.txtID.Value 			= tmpSales_Detail.ID
		*		Thisform.pf.pgSales_Detail.txtID.Value			= ThisForm.Sales_Detail_ID
		
		*		Thisform.pf.pgSales_Detail.txtSOitem.Value 		= ThisForm.SOitem
				Thisform.pf.pgSales_Detail.txtSOitem.Value 		= tmpSales_Detail.SOitem
				Thisform.pf.pgSales_Detail.txtStockEdit.Value 	= tmpSales_Detail.StockEdit
				Thisform.pf.pgSales_Detail.txtPS_Date.Value 	= tmpSales_Detail.Shipped
				Thisform.pf.pgSales_Detail.txtInvoiceDate.Value	= tmpSales_Detail.InvoiceDate
				
				Thisform.pf.pgSales_Detail.txtAlloy.Value	= tmpSales_Detail.Alloy
				Thisform.pf.pgSales_Detail.txtForm.Value	= tmpSales_Detail.Form
				Thisform.pf.pgSales_Detail.txtCC.Value		= tmpSales_Detail.CC
				
				
				Thisform.pf.pgSales_Detail.txtQuoted_QTY.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_QTY,'Quoted_QTY',-5)
				Thisform.pf.pgSales_Detail.txtQuoted_PU.Value 	= PrepareSQLnum( tmpSales_Detail.Quoted_PU,'Quoted_PU',-1)
				Thisform.pf.pgSales_Detail.txtQuoted_PUstr.Value = PrepareSQLtxt( Get_PUtext( tmpSales_Detail.Quoted_PU ),'Quoted_PU',6)
				Thisform.pf.pgSales_Detail.txtQuoted_P.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_P,'Quoted_P',-5)
				Thisform.pf.pgSales_Detail.txtQuoted_Total.Value= PrepareSQLnum(tmpSales_Detail.Quoted_Total,'Quoted_Total',-5)
				Thisform.pf.pgSales_Detail.txtQuoted_PC.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_PC,'Quoted_PC',-3)
				Thisform.pf.pgSales_Detail.txtQuoted_Dim1.Value	= PrepareSQLnum(tmpSales_Detail.Quoted_Dim1,'Quoted_Dim1',10,4)
				Thisform.pf.pgSales_Detail.txtQuoted_LBS.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_LBS,'Quoted_LBS',7,2)
				
				Thisform.pf.pgSales_Detail.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpSales_Detail.StockLst_QTY,'StockLst_QTY',-5)
				Thisform.pf.pgSales_Detail.txtStockLst_PU.Value 	= PrepareSQLnum( tmpSales_Detail.StockLst_PU,'StockLst_PU',-1)
				Thisform.pf.pgSales_Detail.txtStockLst_PUstr.Value	= Get_PUtext( PrepareSQLtxt( tmpSales_Detail.StockLst_PU,'StockLst_PU',6) )
				Thisform.pf.pgSales_Detail.txtStockLst_P.Value 		= PrepareSQLnum(tmpSales_Detail.StockLst_P,'StockLst_P',-5)
				
				Thisform.pf.pgSales_Detail.txtStkPaid_P.Value 		= PrepareSQLnum(tmpSales_Detail.StkPaid_P,'StkPaid_P',-5)
