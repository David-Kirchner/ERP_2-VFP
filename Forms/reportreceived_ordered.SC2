	*< OBJECTDATA: ObjPath="txtBilledWeight" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtOrdered_Cnt" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtReceived_Cnt" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdQuit" UniqueID="" Timestamp="" />

	*<PropValue>
