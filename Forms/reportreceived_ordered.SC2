		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS nT_Pc,nT_pcR,nT_Weight,nT_ActualR,nT_BillR,nT_Count,nT_CountR,cPOitem
		
		IF VARTYPE(nT_Pc) != "N"
			nT_Pc = 0
		ENDIF
		IF VARTYPE(nT_pcR) != "N"
			nT_pcR= 0
		ENDIF
		IF VARTYPE(nT_Weight) != "N"
			nT_Weight= 0
		ENDIF
		IF VARTYPE(nT_ActualR) != "N"
			nT_ActualR = 0
		ENDIF
		IF VARTYPE(nT_BillR) != "N"
			nT_BillR = 0
		ENDIF
		IF VARTYPE(nT_Count) != "N"
			nT_Count = 0
		ENDIF
		IF VARTYPE(nT_CountR) != "N"
			nT_CountR = 0
		ENDIF
		
		IF VARTYPE(cPOitem) != "C"
			cPOitem = ''
		ENDIF
		
		ThisForm.lblSummary.Caption = "Purchase Order Summary for PO-item: "+ALLTRIM(cPOitem)
		ThisForm.txtOrdered_PC.Value = nT_Pc
		ThisForm.txtReceived_PC.Value = nT_pcR
		ThisForm.txtOrdered_QTY.Value = nT_Weight
		ThisForm.txtReceived_QTY.Value = nT_ActualR
		ThisForm.txtBilledWeight.Value = nT_BillR
		ThisForm.txtOrdered_Cnt.Value = nT_Count
		ThisForm.txtReceived_Cnt.Value = nT_CountR
		
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item('')
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
	ENDPROC

ENDDEFINE
