	PROCEDURE Init
		RELEASE m.gncmbFind, m.gShipFindText
		PUBLIC  m.gncmbFind, m.gShipFindText
		m.gncmbFind = 1
		m.gShipFindText = 0
		
		ThisForm.OleDate = DATE()
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		*ThisForm.Pageframe1.pgEdit.Grid1.RecordSource = ''
		*ThisForm.Pageframe1.pgBrowse.GridBR.RecordSource = ''
		
		*ThisForm.Pageframe1.ActivePage = 2
		ThisForm.Pageframe1.pgEdit.SetFocus
		ThisForm.Pageframe1.pgEdit.Grid1.SetFocus
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF USED('Ship')
			USE IN Ship
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.Ship"
		cSQL = cSQL + " WHERE OrderDate >= '"+DTOC( DATE()-720 )+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Ship')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Ship' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Ship' )
		ENDIF
		
		SET SAFETY OFF
		
		SELECT SHIP
		INDEX ON SOitem TAG SOitem
		INDEX ON SalesNum TAG SalesNum
		INDEX ON UPPER(Company) TAG UppCompany
		SET ORDER TO Salesnum
		GO BOTTOM
		SKIP -5
		
		
		
		
	ENDPROC

	PROCEDURE refreshedittab
		ThisForm.Pageframe1.pgEdit.txtSoitem.Refresh
		ThisForm.Pageframe1.pgEdit.txtCompany.Refresh
		ThisForm.Pageframe1.pgEdit.txtShipDate.Refresh
		ThisForm.Pageframe1.pgEdit.txtShipVia.Refresh
		ThisForm.Pageframe1.pgEdit.txtQshipped.Refresh
		
		ThisForm.Pageframe1.pgEdit.chkCancel.Value = PrepareSQLchk(ship.cncld,'Cncld')
		ThisForm.Pageframe1.pgEdit.chkComplete.Value = PrepareSQLchk(ship.complete,'complete')
		
		*ThisForm.Pageframe1.pgEdit.chkDeleted.Value = DELETED()
		*ThisForm.Pageframe1.pgEdit.chkDeleted.Refresh()
		
		ThisForm.Pageframe1.pgEdit.Vcr1.EnableDisableButtons()
		
	ENDPROC

	PROCEDURE reloadship
		PARAMETERS pLOAD
		*ThisForm.ReLoadShip()
		
		IF VARTYPE(pLoad) != "C"
			pLoad = ""
		ENDIF
		IF ThisForm.AllRecords 
			pLoad = "ALL"
		ENDIF
		
		ThisForm.Pageframe1.pgEdit.Grid1.RecordSource = ""
		ThisForm.Pageframe1.pgBrowse.GridBR.RecordSource = ""
		
		
		IF USED('Ship')
			USE IN Ship
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.Ship"
		IF pLoad = "ALL"
			*
		ELSE
			cSQL = cSQL + " WHERE OrderDate >= '"+DTOC( DATE()-720 )+"'"
			IF !EMPTY(pLoad)
				cSQL = cSQL + " "+pLoad
			ENDIF
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Ship')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Ship' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Ship' )
		ENDIF
		
		IF !USED('SHIP')
			*Try again
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Ship')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Ship' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Ship' )
			ENDIF
		
		ENDIF
		
		IF USED('Ship')
			ThisForm.Pageframe1.pgEdit.Grid1.RecordSource = "SHIP"
			ThisForm.Pageframe1.pgBrowse.GridBR.RecordSource = "SHIP"
		
			SELECT SHIP
			INDEX ON SOitem TAG SOitem
			INDEX ON UPPER(Company) TAG UppCompany
			INDEX ON SalesNum TAG SalesNum
			SET ORDER TO Salesnum
			GO BOTTOM
		ELSE
			TrackError("Error",'Ship.ReloadShip: Could not load ship table.',"SHIP.ReloadShip",LINENO(1))
			MESSAGEBOX("Could not load ship table.",16,"Error")
			RETURN .f.
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		
		IF ThisForm.Close_Ship
			IF USED('SHIP')
				USE IN SHIP
			ENDIF
		ENDIF
		
		*!*	IF USED('Customer')
		*!*		USE IN Customer
		*!*	ENDIF
		
		IF USED('Sales')	
			USE IN Sales 
		ENDIF
		
		IF USED('Sales_No')	
			use in Sales_No
		ENDIF
		
		 = SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdEdit.Click
		ThisForm.Pageframe1.pgEdit.Grid1.ReadOnly = .F.
		ThisForm.Pageframe1.pgBrowse.GridBR.ReadOnly = .F.
	ENDPROC

	PROCEDURE cmdPackingSlipHistory.Click
		PRIVATE nSO
		nSO = Ship.SalesNum
		
		IF nSO > 0
			DO FORM Forms\packingsliphistory  WITH nSO
		ELSE
			WAIT WINDOW "NO Sales Number." NOWAIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSeeAll.Click
		ThisForm.AllRecords = .T.
		ThisForm.ReloadShip('ALL')
	ENDPROC

	PROCEDURE cmdView.cmdPastDue.Click
		PRIVATE currec1
		WAIT WINDOW 'Please wait while selecting records.' NOWAIT
		SELECT Ship
		currec1 = 0
		currec1 = RECNO()
		SET DELETED ON
		REPORT FORM Reports\ShipPastDue PREVIEW FOR shipdate>CTOD('12/30/1980') AND NOT EMPTY(Ship.duedate) AND Ship.duedate < DATE() AND NOT Ship.cncld AND NOT COMPLETE 
		SET DELETED OFF
		** If no shipdate entered and the due date is present
		** and duedate is past (less than) todays date
		** and Not Cancelled AND NOT DELETED()
		IF currec1 < 1 
			currec1 = 1
		ENDIF
		SELECT Ship
		GOTO (currec1)
		
	ENDPROC

	PROCEDURE cmdView.cmdVDue.Click
		PRIVATE currec1
		WAIT WINDOW 'Please wait while selecting records.' NOWAIT
		SELECT Ship
		currec1 = 0
		currec1 = RECNO()
		*SET DELETED ON
		REPORT FORM Reports\ShipDue PREVIEW FOR Ship.shipdate>CTOD('12/30/1980') AND SalesNum > 0 AND NOT cncld AND NOT COMPLETE 
		
		SET DELETED OFF
		** SHOW records that have not shipped 
		** AND not cancelled AND NOT DELETED()
		IF currec1 < 1 
			currec1 = 1
		ENDIF
		GOTO (currec1)
	ENDPROC

	PROCEDURE Pageframe1.Destroy
		RELEASE m.item,m.soitem,m.Salesp,m.company,m.po_num,m.alloy,m.duedate,m.OrderDate
		
		RELEASE m.gShipFindText, m.gncmbFind
		
		
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.Click
		PRIVATE recb4,Ordrb4
		SELECT SHIP
		recb4 = 0
		recb4 = RECNO("SHIP")
		Ordrb4 = ORDER()
		SET ORDER TO SOitem
		GO BOTTOM
		This.Edit1.Value = "Last Salesnum :"+CHR(13)+SHIP.SOitem+CHR(13)+"Last Company :"+CHR(13)+Ship.Company
		
		IF NOT EMPTY(Ordrb4)
			SET ORDER TO (Ordrb4)
		ELSE
			SET ORDER TO
		ENDIF
		
		IF recb4 > 0 AND recb4 <= RECCOUNT("SHIP")
			GOTO recb4
		ENDIF
		
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.cmdAdd.Click
		PRIVATE m.shipcomplete, m.savethis 
		m.savethis = .T.
		
		PRIVATE nSalesNum,nItem,cSoItem,cSalesp,cCompany,cPo_num,cAlloy,dDuedate,dOrderDate,nQshipped,lComplete
		nSalesNum	= PrepareSQLnum(This.parent.txtSalesnum.Value,'SalesNum',-3)
		nItem 		= PrepareSQLnum(This.parent.txtItem.Value,'Item',2,0)
		*cSoItem
		cSalesp		= PrepareSQLtxt(This.parent.txtSalesp.Value,'SalesP',1)
		dOrderDate	= PrepareSQLdate(This.parent.txtOrderDate.Value,'OrderDate')
		cCompany	= PrepareSQLtxt(This.parent.txtCompany.Value,'Company',30)
		cPo_num		= PrepareSQLtxt(This.parent.txtPo_num.Value,'PO_num',20)
		cAlloy		= PrepareSQLtxt(This.parent.txtAlloy.Value,'Alloy',12)
		dDuedate	= PrepareSQLdate(This.parent.txtDuedate.Value,'DueDate')
		nQshipped	= PrepareSQLnum(This.parent.txtQshipped.Value,'Q Shipped',10,0)
		lComplete	= PrepareSQLchk(This.parent.chkComplete.Value,'Complete',.F.)
		
		
		
		IF TYPE('nSalesNum') != "N"
			=MESSAGEBOX("Sales Num is not a number",0,"Can not save.")
			m.savethis = .F.
			RETURN
		ENDIF
		IF nSalesNum < 1
			=MESSAGEBOX("SalesNum is not a number",0,"Can not save.")
			m.savethis = .F.
			RETURN
		ENDIF
		IF TYPE('nItem') = "C"
			nItem= VAL(nItem)
		ENDIF
		IF TYPE('nItem') != "N"
			=MESSAGEBOX("Item is not a number",0,"Can not save.")
			m.savethis = .F.
			RETURN
		ENDIF
		IF nItem < 1
			=MESSAGEBOX("Item is not a number",0,"Can not save.")
			m.savethis = .F.
			RETURN
		ENDIF
		
		IF TYPE("dOrderdate") = "C"
			dOrderdate = CTOD(dOrderdate)
		ENDIF
		IF TYPE("dOrderdate") = "T"
			dOrderdate = CTOD(TTOC(dOrderdate))
		ENDIF
		IF TYPE("dOrderdate") != "D"
			dOrderdate = CTOD("  /  /  ")
		ENDIF
		
		IF TYPE("dDuedate") = "C"
			dDuedate= CTOD(dDuedate)
		ENDIF
		IF TYPE("dDuedate") = "T"
			dDuedate = CTOD(TTOC(dDuedate))
		ENDIF
		IF TYPE("dDuedate") != "D"
			dDuedate= CTOD("  /  /  ")
		ENDIF
		
		IF TYPE('nQshipped') = "C"
			nQshipped= VAL(nQshipped)
		ENDIF
		IF TYPE('nQshipped') != "N"
			nQshipped = 0
		ENDIF
		
		IF TYPE("lComplete")= "N"
			lComplete = (lComplete = 1)
		ENDIF
		
		cSoItem = Proper_SO_Item(STR(nSalesNum)+"-"+IIF(nitem<10,"0"+STR(nitem,1,0),+STR(nitem,2,0)))
		*cSoItem = STR(nSalesNum,7,0)+"-"+IIF(nitem<10,"0"+STR(nitem,1,0),+STR(nitem,2,0))
		
		IF m.savethis
		
			*Keep values in Sales Table- eventually remove Ship table
			*SELECT COUNT(SOItem) FROM SALES WHERE Sales.SoItem = cSoItem INTO ARRAY anSoItems
			IF Count_SOIteminSales(cSOItem, ThisForm.nConnHandle) > 0
				
				cSQL = "UPDATE dbo.Sales SET "
				cSQL = cSQL+" Salesnum = "+STR(nSalesNum)
				cSQL = cSQL+",Qshipped = "+STR(nQshipped,10,0)
				cSQL = cSQL+" WHERE Sales.soItem = dbo.f_ProperSOitem('"+cSoItem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
		
			ELSE
				cSQL = "INSERT INTO dbo.Sales ( SOitem, SalesNum, qshipped ) VALUES ("
				cSQL = cSQL + " dbo.f_ProperSOitem('"+m.cSOitem+"')"
				cSQL = cSQL + ","+STR(m.SalesNum)
				cSQL = cSQL + ","+STR(nQshipped)+")"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
		
			ENDIF
				
			IF Count_ShipbySOitem(cSOItem, ThisForm.nConnHandle, '') = 0
				cSQL = "INSERT INTO dbo.SHIP (Salesnum, Salesp, orderdate, company, po_num, alloy, duedate, soItem, item, qshipped, cncld, complete) VALUES ("
				cSQL = cSQL + STR(nSalesNum,9,0)+",'"+cSalesp+"','"+IIF(!EMPTY(dOrderDate),DTOC(dOrderdate),'')+"','"+cCompany+"'"
				cSQL = cSQL + ",'"+cPo_num+"','"+cAlloy+"','"+IIF(!EMPTY(dOrderDate),DTOC(dDuedate),'')+"','"+cSoItem+"',"+STR(nItem,2,0)+","+STR(nQshipped,10,0)
				cSQL = cSQL + ","+"'0'"+","+IIF(lComplete,'1','0')+" )"
			ELSE
				cSQL = "UPDATE dbo.Ship SET "
				cSQL = cSQL + " OrderDate= '"+IIF(!EMPTY(dOrderDate),DTOC(dOrderdate),'')+"'"
				cSQL = cSQL + ",Company= '"+cCompany+"'"
				cSQL = cSQL + ",PO_Num= '"+cPo_num+"'"
				cSQL = cSQL + ",Alloy= '"+cAlloy+"'"
				cSQL = cSQL + ",DueDate='"+IIF(!EMPTY(dOrderDate),DTOC(dDuedate),'')+"'"
				cSQL = cSQL + ",qShipped='"+STR(nQshipped,10,0)+"'"
				cSQL = cSQL + ",complete='"+IIF(lComplete,'1','0')+"'"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF	
				
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
			ENDIF
			
			Update_Ship_SOitem( cSoItem, ThisForm.nConnHandle)
			
			This.parent.txtSalesnum.Value	= 0
			This.parent.txtItem.Value		= 1
			This.parent.txtSalesp.Value	= " "
			This.parent.txtOrderDate.Value	= DATE()
			This.parent.txtCompany.Value	= SPACE(30)
			This.parent.txtPo_num.Value		= SPACE(30)
			This.parent.txtAlloy.Value		= SPACE(12)
			This.parent.txtDuedate.Value	= DATE()+1
			This.parent.txtQshipped.Value	= 0
			This.parent.chkComplete.Value	= 0
		
		*		UNLOCK IN SHIP
			ThisForm.ReLoadShip()
		*		SET ORDER TO SOitem
		*		GO BOTTOM
		
			This.Parent.Edit1.Value = "Last Salesnum :"+CHR(13)+cSOitem+CHR(13)+"Last Company :"+CHR(13)+cCompany
			This.Parent.Edit1.refresh
			this.Parent.Refresh
		*!*		ELSE
		*!*			=MESSAGEBOX("Ship Table can not be locked right now !",16,"Try Again later")
		*!*		ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.cmdAdd.When
		PRIVATE nSalesNum, nItem, cCompany, cAlloy
		nSalesNum = This.parent.txtSalesnum.Value	
		IF EMPTY(nSalesNum)
			WAIT WINDOW 'Enter Salesnumber first' NOWAIT
			RETURN .F.
		ENDIF
		
		nItem = This.parent.txtItem.Value
		IF nItem < 1
			=MESSAGEBOX("Item must be larger than 0",16,"Invalid input")
			RETURN .F.
		ENDIF
		
		cCompany = This.parent.txtCompany.Value	
		cAlloy	= This.parent.txtAlloy.Value		
		
		IF EMPTY(ALLTRIM(cCompany+cAlloy))
			WAIT WINDOW 'Do not add this record with out a Company name or even an alloy' NOWAIT
			RETURN .F.
		ENDIF
			
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.cmdClear.Click
		This.parent.txtSalesnum.Value	= 0
		This.parent.txtItem.Value		= 1
		This.parent.txtSalesp.Value	= " "
		This.parent.txtOrderDate.Value	= DATE()
		This.parent.txtCompany.Value	= SPACE(30)
		This.parent.txtPo_num.Value	= SPACE(30)
		This.parent.txtAlloy.Value		= SPACE(12)
		This.parent.txtDuedate.Value	= DATE()+1
		This.parent.txtQshipped.Value	= 0
		This.parent.chkComplete.Value	= 0
		This.Parent.Refresh
		
		PRIVATE recb4,Ordrb4
		SELECT SHIP
		recb4 = RECNO("SHIP")
		Ordrb4 = ORDER()
		SET ORDER TO SOitem
		GO BOTTOM
		This.Parent.Edit1.Value = "Last Salesnum :"+CHR(13)+SHIP.SOitem+CHR(13)+"Last Company :"+CHR(13)+Ship.Company
		
		IF NOT EMPTY(Ordrb4)
			SET ORDER TO (Ordrb4)
		ELSE
			SET ORDER TO
		ENDIF
		
		GO recb4
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.cmdClone.Click
		PRIVATE m.shipcomplete, m.savethis 
		m.savethis = .T.
		
		PRIVATE nSalesNum,nItem,cSoItem,cSalesp,cCompany,cPo_num,cAlloy,dDuedate,dOrderDate,nQshipped,lComplete
		nSalesNum	= PrepareSQLnum(This.parent.txtSalesnum.Value,'SalesNum',-3)
		nItem 		= PrepareSQLnum(This.parent.txtItem.Value,'Item',2,0)
		*cSoItem
		cSalesp		= PrepareSQLtxt(This.parent.txtSalesp.Value,'SalesP',1)
		dOrderDate	= PrepareSQLdate(This.parent.txtOrderDate.Value,'OrderDate')
		cCompany	= PrepareSQLtxt(This.parent.txtCompany.Value,'Company',30)
		cPo_num		= PrepareSQLtxt(This.parent.txtPo_num.Value,'PO_num',20)
		cAlloy		= PrepareSQLtxt(This.parent.txtAlloy.Value,'Alloy',12)
		dDuedate	= PrepareSQLdate(This.parent.txtDuedate.Value,'DueDate')
		nQshipped	= PrepareSQLnum(This.parent.txtQshipped.Value,'Q Shipped',10,0)
		lComplete	= PrepareSQLchk(This.parent.chkComplete.Value,'Complete',.F.)
		
		
		SELECT SHIP
		IF TYPE('nSalesNum') = "C"
			nSalesNum = VAL(nSalesNum)
		ENDIF
		IF TYPE('nSalesNum') != "N"
			=MESSAGEBOX("Sales Num is not a number",0,"Can not save.")
			m.savethis = .F.
			RETURN
		ENDIF
		IF nSalesNum < 1
			=MESSAGEBOX("SalesNum is not a number",0,"Can not save.")
			m.savethis = .F.
			RETURN
		ENDIF
		IF TYPE('nItem') = "C"
			nItem= VAL(nItem)
		ENDIF
		IF TYPE('nItem') != "N"
			=MESSAGEBOX("Item is not a number",0,"Can not save.")
			m.savethis = .F.
			RETURN
		ENDIF
		IF nItem < 1
			=MESSAGEBOX("Item is not a number",0,"Can not save.")
			m.savethis = .F.
			RETURN
		ENDIF
		
		IF TYPE("dOrderdate") = "C"
			dOrderdate = CTOD(dOrderdate)
		ENDIF
		IF TYPE("dOrderdate") != "D"
			dOrderdate = CTOD("  /  /  ")
		ENDIF
		
		IF TYPE("dDuedate") = "C"
			dDuedate= CTOD(dDuedate)
		ENDIF
		IF TYPE("dDuedate") != "D"
			dDuedate= CTOD("  /  /  ")
		ENDIF
		
		IF TYPE('nQshipped') = "C"
			nQshipped= VAL(nQshipped)
		ENDIF
		IF TYPE('nQshipped') != "N"
			nQshipped = 0
		ENDIF
		
		IF TYPE("lComplete")= "N"
			lComplete = (lComplete = 1)
		ENDIF
		cSoItem = Proper_SO_Item(STR(nSalesNum)+"-"+IIF(nitem<10,"0"+STR(nitem,1,0),+STR(nitem,2,0)))
		*cSoItem = STR(nSalesNum,7,0)+"-"+IIF(nitem<10,"0"+STR(nitem,1,0),+STR(nitem,2,0))
		
		IF m.savethis
		
			*Keep values in Sales Table- eventually remove Ship table
			*SELECT COUNT(SOItem) FROM SALES WHERE Sales.soItem = cSoItem INTO ARRAY anSoItems
			IF Count_SOIteminSales(m.cSOItem, ThisForm.nConnHandle) > 0
				*UPDATE SALES SET soItem = cSoItem, Salesnum = nSalesNum, Qshipped = nQshipped WHERE Sales.soItem = cSoItem
				cSQL = "UPDATE dbo.Sales SET "
				cSQL = cSQL+" Salesnum = "+STR(nSalesNum)
				cSQL = cSQL+",Qshipped = "+STR(nQshipped,10,0)
				cSQL = cSQL+" WHERE Sales.soItem = dbo.f_ProperSOitem('"+cSoItem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
			ELSE
				*INSERT INTO SALES (soItem, Salesnum, qshipped ) VALUES (csoItem,nSalesNum,nQshipped)
				cSQL = "INSERT INTO dbo.Sales ( SOitem, SalesNum, qshipped ) VALUES ("
				cSQL = cSQL + " dbo.f_ProperSOitem('"+m.cSOitem+"')"
				cSQL = cSQL + ","+STR(m.SalesNum)
				cSQL = cSQL + ","+STR(nQshipped)+")"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
		
			ENDIF
			
			
			IF USED('tmpCountSales')
				USE IN tmpCountSales
			ENDIF
			
			SELECT 0
			cSQL = "SELECT COUNT(*) AS CntSO FROM dbo.Sales WHERE SOitem =dbo.f_ProperSOitem('"+cSOitem+"')"
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCountSales' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountSales' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountSales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountSales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
			ELSE
				SELECT tmpCountSales
				IF tmpCountSales.CntSO > 0
					cSQLu = "UPDATE dbo.Sales SET "
					cSQLu = cSQLu + "SOitem	 = dbo.f_ProperSOitem('"+cSOitem+"'),"
					cSQLu = cSQLu + "SalesNum = "+STR(nSalesNum)+","
					cSQLu = cSQLu + "Qshipped = "+STR(nQshipped,10,0)+""
					cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC )
					ENDIF
				ELSE
					cSQLi = "INSERT INTO dbo.Sales "
					cSQLi = cSQLi + "(soItem, Salesnum, qshipped ) VALUES "
					cSQLi = cSQLi + "( dbo.f_ProperSOitem('"+cSOitem+"'),"+STR(nSalesNum)+","+STR(nQshipped)+")"
		
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC )
					ENDIF
				ENDIF
			ENDIF
			IF USED('tmpCountSales')
				USE IN tmpCountSales
			ENDIF	
		
		*	SELECT SHIP
		*	IF FLOCK()
		
				*INSERT INTO SHIP (Salesnum, Salesp, orderdate, company, po_num, alloy, duedate, soItem, item, qshipped, complete) VALUES;
				 *(nSalesNum,cSalesp,dOrderdate,cCompany,cPo_num,cAlloy,dDuedate,cSoItem,nItem,nQshipped,lComplete )
						
				cSQL = "INSERT INTO dbo.SHIP (Salesnum, Salesp, orderdate, company, po_num, alloy, duedate, soItem, item, qshipped, cncld, complete) VALUES ("
				cSQL = cSQL + STR(nSalesNum,9,0)+",'"+cSalesp+"','"+IIF(!EMPTY(dOrderDate),DTOC(dOrderdate),'')+"','"+cCompany+"'"
				cSQL = cSQL + ",'"+cPo_num+"','"+cAlloy+"','"+IIF(!EMPTY(dOrderDate),DTOC(dDuedate),'')+"','"+cSoItem+"',"+STR(nItem,2,0)+","+STR(nQshipped,10,0)
				cSQL = cSQL + ","+"'0'"+","+IIF(lComplete,'1','0')+" )"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
				
				WAIT WINDOW "Data entered, Ready to Add again" nowait
				
				nitem = nitem + 1
				This.parent.txtItem.Value = nItem
				
				*UNLOCK IN SHIP
				ThisForm.ReLoadShip()
				*SET ORDER TO SOitem
				*GO BOTTOM
				
				This.Parent.Edit1.Value = "Clone !"+CHR(13)+"Last Salesnum :"+CHR(13)+cSOitem+CHR(13)+"Last Company :"+CHR(13)+cCompany
				This.Parent.Edit1.refresh
				This.Parent.txtItem.Refresh
		*	ELSE
		*		=MESSAGEBOX("Ship Table can not be locked right now !",16,"Try Again later")
		*	ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.cmdClone.When
		PRIVATE nSalesNum, nItem, cCompany, cAlloy
		nSalesNum = This.parent.txtSalesnum.Value	
		IF EMPTY(nSalesNum)
			WAIT WINDOW 'Enter Salesnumber first' NOWAIT
			RETURN .F.
		ENDIF
		
		nItem = This.parent.txtItem.Value
		IF nItem < 1
			=MESSAGEBOX("Item must be larger than 0",16,"Invalid input")
			RETURN .F.
		ENDIF
		
		cCompany = This.parent.txtCompany.Value	
		cAlloy	= This.parent.txtAlloy.Value		
		
		IF EMPTY(ALLTRIM(cCompany+cAlloy))
			WAIT WINDOW 'Do not add this record with out a Company name or even an alloy' NOWAIT
			RETURN .F.
		ENDIF
			
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.Init
		*Public m.item,m.soitem,m.Salesp,m.company,m.po_num,m.alloy,m.duedate,m.OrderDate
		
		This.txtSalesnum.Value	= 0
		This.txtItem.Value		= 1
		This.txtSalesp.Value	= " "
		This.txtOrderDate.Value	= DATE()
		This.txtCompany.Value	= SPACE(30)
		This.txtPo_num.Value	= SPACE(30)
		This.txtAlloy.Value		= SPACE(12)
		This.txtDuedate.Value	= DATE()+1
		This.txtQshipped.Value	= 0
		This.chkComplete.Value	= 0
		
		PRIVATE recb4,Ordrb4
		SELECT SHIP
		recb4 = RECNO("SHIP")
		Ordrb4 = ORDER()
		SET ORDER TO SOitem
		
		GO BOTTOM
		This.Edit1.Value = "Last Salesnum :"+CHR(13)+SHIP.SOitem+CHR(13)+"Last Company :"+CHR(13)+Ship.Company
		
		IF NOT EMPTY(Ordrb4)
			SET ORDER TO (Ordrb4)
		ELSE
			SET ORDER TO
		ENDIF
		
		GO recb4
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtAlloy.InteractiveChange
		
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtCompany.GotFocus
		*ThisFormSet.ICompany = m.Company
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtCompany.InteractiveChange
		lnInsertionPt = IIF(this.SelStart=0,30,this.SelStart)
		lcSearchStr = substr(this.value,1,lnInsertionPt)
		IF !empty(lcSearchStr)
				=seek(upper(lcSearchStr),"SHIP","UPPCOMPANY")
				IF found("SHIP")
					this.VALUE=SHIP.Company
					=insmode(.f.)
				ELSE
					this.value=lcSearchStr
		*			REPLACE quotes.custid with Ship.Customer
					=insmode(.t.)
				ENDIF
		ELSE &&ThisValue is empty
			this.value=space(0)
		ENDIF
		this.selstart = lnInsertionPt
		
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtCompany.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtCompany.Valid
		RETURN .T.
		
		
		
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtItem.Valid
		PRIVATE currec, cSOItem
		currec = 0
		
		PRIVATE nSalesNum, nItemSO, cSOitem
		nSalesNum	= This.parent.txtSalesnum.Value
		nItemSO		= This.Value
		
		IF USED('SHIP')
			IF NOT EMPTY(nSalesNum)
				cSOItem = Proper_SO_Item( STR(nSalesNum)+"-"+STR(nItemSO,2,0) )
			
				SEEK cSOItem IN SHIP2 ORDER SOItem
		
				IF FOUND('SHIP2')
					This.Parent.Edit1.Value = "Item already entered"+CHR(13)+"Try a larger number"+CHR(13)+"Salesnum :"+CHR(13)+SHIP.SOitem+CHR(13)+"Company :"+CHR(13)+Ship.Company
					This.Parent.Edit1.refresh
					=MESSAGEBOX("Salesnum - Item already entered"+CHR(13)+"Item number '"+STR(nItemSO,2,0)+"' cannot be used again." ,16,"Can not enter twice")
					DIMENSION aMaxSoItem(1) 
					SELECT MAX(Item) FROM SHIP2 INTO ARRAY aMaxSoItem WHERE SHIP2.SalesNum = nSalesNum
					nItemSO = aMaxSoItem(1)+1 
					This.Value = nItemSO
					This.Refresh
					*RETURN .F.
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtSalesnum.Valid
		
		IF This.Value < 0
			=MESSAGEBOX("Salesnumber must be larger than 0",16,"Invalid input")
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE Pageframe1.pgAdd.txtSalesp.Valid
		PRIVATE m.cSalesP
		m.cSalesP = This.Value
		
		IF USED('SHIP2')
			SEEK m.cSalesP IN SHIP2 ORDER Salesp
			IF NOT FOUND('SHIP2')
				? CHR(7)
				? CHR(7)
				WAIT WINDOW 'Did NOT find this initail before  -any key to continue'
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgBrowse.Click
		SELECT SHIP
		SET ORDER TO SOitem
		This.GridBR.RecordSourceType = 1
		This.GridBR.RecordSource = "SHIP"
		This.GridBR.Refresh
		This.GridBR.setfocus
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.chkCancel.Valid
		MESSAGEBOX("Please use the Edit Shipping",0,"No Change")
		This.Value = !( This.Value )
		
		RETURN -1
		
		
		**********************************************
		PRIVATE cSOitem, cSQL, nSQLEXEC
		cSOitem = Ship.SOitem
		PRIVATE lCancelled
		*lCancelled = PrepareSQLchk( This.Value, 'Cancel')
		lCancelled = PrepareSQLchk(Ship.cncld,'Cancel')
		PRIVATE nSalesNum
		nSalesNum = Ship.SalesNum
		
		IF NOT lCancelled 
			IF NOT SOitem_PRCD(cSOitem, ThisForm.nConnHandle)
			*Check to see if Shipped!
		
				*Check for PO
				PRIVATE nCntPOitem 
				nCntPOitem = 0
		
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				SELECT 0
				cSQL = "SELECT COUNT(poItem) AS CNTD FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem +"')"
				cSQL = cSQL + " AND [cancelled] = 0"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF tmpPOp.CNTD > 0
						nCntPOitem = tmpPOp.CNTD
					ENDIF
					USE IN tmpPOp
				ENDIF
		
				IF nCntPOitem > 0
					MESSAGEBOX( "Found "+ALLTRIM(STR(nCntPOitem))+" Purchase Order item"+IIF(nCntPOitem>1,"s","")+" for this Sales Order item."+CHR(13)+;
					  "Check to see if this PO needs to be cancelled also."+;
					  "These cannot be automatically cancelled, you must check yourself!",0,"Item is still on Order!")
					  
					  *PurchaseOrder_POitem_Cancel( cPOitem, ThisForm.nConnhandle )
				ENDIF
					
		
				IF MESSAGEBOX("Are you sure you want to Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Cancel?") = 6
					
					IF Cancel_SOitem(cSOitem, .T., ThisForm.nConnHandle) 	&& .T. to Amend Ver
						ThisForm.ReLoadShip()
						LOCATE FOR SOitem = cSoItem
					ENDIF
					
					This.parent.Grid1.Refresh
					
					*Send the SalesRep an Email!
					PRIVATE cSalesRep, nSalesNum, cSendEmail
					nSalesNum = VAL(cSOitem)
					cSalesRep = SalesRepfromSO(nSalesNum)
					cSendEmail = AppSetup_Get_Email( cSalesRep )
					
					
					PRIVATE cSubject
					cSubject = "Sales Order:"+ALLTRIM(STR(nSalesNum))+" was just marked as CANCELLED by the Ship program!"
					cSubject = cSubject + CHR(13) + "Sales Order report:"+ HTML_SO(nSalesNum,.F.)
					cSubject = cSubject + CHR(13) + "Sales Rep: "+cSalesRep 
					cSubject = cSubject + CHR(13) + "Company: "+getFromQuotesSO(nSalesNum,'COMPANY',ThisForm.nConnHandle)
					*cSubject = cSubject + CHR(13) + "Packing slip report:"+HTML_PackingSlip_SO(nSalesNum,.F.)
					cSubject = cSubject + CHR(13) + SYS(0)
					Send_HTML_Email( cSendEmail, get_Server_Email(), 'SO marked as CANCELLED after last Packing Slip.',cSubject,ThisForm.nConnHandle,.T.,.T.)	
						
					
					
					RETURN .T.
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			*try to UNcancel
			IF MESSAGEBOX("Are you sure you want to UNCancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"UNCancel?") = 6
				PRIVATE lOK
				lOK = .T.
				
				cSQL = "UPDATE dbo.SHIP SET "
				cSQL = cSQL + " [Cncld] = 0"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
					lOK = .F.
				ELSE
					TrackMess( "UNCancelled SOitem="+ALLTRIM(cSOitem)+" in Ship" )
				ENDIF
				
				IF lOK
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL + " [Cncld] = 0"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
						lOK = .F.
					ELSE
						TrackMess( "UNCancelled SOitem="+ALLTRIM(cSOitem)+" in Sales table, Ship Screen, chkCancel.Valid()" )
					ENDIF
				ENDIF
				
				IF lOK
					* IF at least one item is uncancelled, then the SalesNum is UNCancelled 
					cSQL = "UPDATE dbo.Sales_No SET "
					cSQL = cSQL + " [Cncld] = 0"
					cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
						lOK = .F.
					ELSE
						PRIVATE nAmendment
						nAmendment = Get_Amendment_Sales_No( nSalesNum, ThisForm.nConnHandle)
						Track_Sales_No_Chng( "Ship.Cancel UNCancel", nSalesNum, .F., nAmendment )
		
						TrackMess( "UNCancelled SaleNum for "+ALLTRIM(cSOitem)+" in Sales_No table, Ship Screen, chkCancel.Valid()" )
					ENDIF
				ENDIF
				
				IF lOK
					** Repeat in SOitem_Hrs
					cSQL = "UPDATE dbo.SOitem_Hrs SET "
					cSQL = cSQL + " [Cncld] = 0"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
						lOK = .F.
					ELSE
						TrackMess( "UNCancelled SOitem="+ALLTRIM(cSOitem)+" in SOitem_Hrs table, Ship Screen, chkCancel.Valid()" )
					ENDIF
				ENDIF
				
				This.parent.Grid1.Refresh
				
				ThisForm.ReLoadShip()
				
				LOCATE FOR SOitem = cSoItem
						
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.chkComplete.Valid
		MESSAGEBOX("Please use the Edit Shipping",0,"No Change")
		This.Value = !( This.Value )
		
		RETURN -1
		
		
		***************
		*Change Similar code in Receiving-PO complete
		
		PRIVATE lComplete, cSOitem, cSQL, nSQLEXEC
		*lComplete2 = PrepareSQLchk(This.Value,'Complete')
		*lComplete = PrepareSQLchk(Ship.Complete,'Complete')
		lComplete = PrepareSQLchk(Ship.Complete,'Complete')
		cSOitem = Ship.SOitem
		
		IF ISNULL(lComplete)
			lComplete = .F.
		ENDIF
		IF NOT lComplete 
			
			IF MESSAGEBOX("Are you sure you want to mark SOitem:"+ALLTRIM(cSOitem)+" as Complete?",4+32,"Mark as Complete?") = 6
		
				cSQL = "UPDATE dbo.SHIP SET "
				cSQL = cSQL + " [Complete] = 1"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ELSE
					TrackMess( "Marked as Complete for SOitem="+ALLTRIM(cSOitem)+" in Ship" )
					
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL + " [Cmplt] = 1"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
					ELSE
						TrackMess( "Marked as Complete for SOitem="+ALLTRIM(cSOitem)+" in Sales table, ship screen, chkComplete.Valid() L35" )
						
						** Repeat in SOitem_Hrs
						cSQL = "UPDATE dbo.SOitem_Hrs SET "
						cSQL = cSQL + " [Cmplt] = 1"
						cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
						ENDIF 
						
						Save_SOitem_Status( cSOitem, VAL(cSOitem),'Complete  ', 'SOitem was changed to Complete in SHIP.', ThisForm.nConnHandle )
		
						
						PRIVATE nShipID
						nShipID = Ship.ID
						
						ThisForm.ReLoadShip()
						
						IF nShipID > 0
							LOCATE FOR ID = nShipID
						ENDIF
						
						This.parent.Grid1.Refresh
					ENDIF
				ENDIF
				
				*Send the SalesRep an Email!
				PRIVATE cSalesRep, nSalesNum, cSendEmail
				nSalesNum = VAL(cSOitem)
				cSalesRep = SalesRepfromSO(nSalesNum)
				cSendEmail = AppSetup_Get_Email( cSalesRep )
				
				
				PRIVATE cSubject
				cSubject = "Sales Order:"+ALLTRIM(STR(nSalesNum))+" SOitem '"+cSoItem+"' was just marked as COMPLETE by the Ship program!"
				cSubject = cSubject + CHR(13) + "Sales Order report:"+ HTML_SO(nSalesNum,.F.)
				cSubject = cSubject + CHR(13) + "Sales Rep: "+cSalesRep 
				cSubject = cSubject + CHR(13) + "Company: "+getFromQuotesSO(nSalesNum,'COMPANY',ThisForm.nConnHandle)
				cSubject = cSubject + CHR(13) + "Packing slip report:"+HTML_PackingSlip_SO(nSalesNum,.F.)
				cSubject = cSubject + CHR(13) + SYS(0)
				Send_HTML_Email( cSendEmail, get_Server_Email(), 'SO marked as COMPLETE in Ship.',cSubject,ThisForm.nConnHandle,.T.,.T.)	
				
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		********************************************
		ELSE
		********************************************
			MESSAGEBOX("Please do not use this Ship screen to REDO a PackingSlip!"+CHR(13)+"Use Packingslip history screen to "+CHR(13)+" cancel the old packing slip number."+CHR(13)+"Packing Slip History has the correct code to update the correct tables."+CHR(13)+CHR(13)+"This ship screen assumes other PackingSlips tables are correct, and only edits THIS Ship table.",48,'Please Read')
			IF MESSAGEBOX("Are you sure you want to UNmark "+CHR(13)+"SOitem:"+ALLTRIM(cSOitem)+" as Complete?",4+32,"Mark as NOT Complete?") = 6
		
				cSQL = "UPDATE dbo.SHIP SET "
				cSQL = cSQL + " [Complete] = 0"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ELSE
					TrackMess( "Marked as NOT Complete "+CHR(13)+"for SOitem="+ALLTRIM(cSOitem)+" in Ship table, Ship screen" )
					
					** Repeat in SOitem_Hrs
					cSQL = "UPDATE dbo.SOitem_Hrs SET "
					cSQL = cSQL + " [Cmplt] = 1"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
					ENDIF 
					
					
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL + " [Cmplt] = 0"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
					ELSE
						TrackMess( "Marked as NOT Complete for SOitem="+ALLTRIM(cSOitem)+" in Sales table, ship screen, chkComplete.Valid() L74" )
						MESSAGEBOX("Marked as NOT Complete "+CHR(13)+"for SOitem="+ALLTRIM(cSOitem)+CHR(13)+"Please check 'Qty', as a new Packing slip will add to current Qty!",0+48,"Not Complete")
						Save_SOitem_Status( cSOitem, VAL(cSOitem),'INComplete', 'SOitem was changed to INComplete in SHIP.', ThisForm.nConnHandle)
					ENDIF
					
					**Save record location
					*PRIVATE nShipID
					*nShipID = Ship.ID
					
					ThisForm.ReLoadShip()
					
					*Get back to original record.
					*IF nShipID > 0
					*	LOCATE FOR ID = nShipID
					*ENDIF
					LOCATE FOR SOitem = cSoItem
					
					This.parent.Grid1.Refresh
				ENDIF
				
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
	ENDPROC

