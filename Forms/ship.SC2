	ENDPROC

	PROCEDURE Pageframe1.pgFind.cmbFind.Valid
		PRIVATE IntcmbFind
		IntcmbFind = This.Value
		IF TYPE("IntcmbFind") = "C"
			IntcmbFind = VAL(IntcmbFind)
		ENDIF
		
		DO CASE
		CASE IntcmbFind = 1
			*Salesnum n,7
			m.gShipFindText = 0
			This.Parent.txtFindText.InputMask =	"9999999"
		CASE IntcmbFind = 2
			*Company c,30
			m.gShipFindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 3
			*PO_Num c,17
			m.gShipFindText = SPACE(17)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 4
			*SOitem c,10
			m.gShipFindText = SPACE(10)
			This.Parent.txtFindText.InputMask =	"99999-99"
		ENDCASE
		This.Parent.txtFindText.Refresh
		*This.parent.txtFindText.SetFocus
	ENDPROC

	PROCEDURE Pageframe1.pgFind.cmdFindcmbText.Valid
		PRIVATE IntcmbFind,ncomp, cLoad
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace m.gShipFindText
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		IF TYPE('laText2Find') = "N"
			lnText2Find = laText2Find
			lcText2Find = ALLTRIM(STR(laText2Find))
		ENDIF
		IF TYPE('laText2Find') = "C"
			lcText2Find = ALLTRIM(laText2Find)
			lnText2Find = VAL(laText2Find)
		ENDIF
		IntcmbFind = INT(m.gncmbFind)
		SELECT SHIP
		*SET EXACT OFF
		DO CASE
		CASE IntcmbFind = 1
			*Salesnum n,7
			lnText2Find = PrepareSQLnum(This.Parent.txtFindText.Value,'SalesNum',-3)
			cLoad = " OR SalesNum = "+STR( lnText2Find )
			ThisForm.ReLoadShip(cLoad)
			
			SET ORDER TO Salesnum
			BROW for Salesnum = lnText2Find
		CASE IntcmbFind = 2
			*Company c,30
			COUNT TO ncomp for UPPER(Company) = UPPER(lcText2Find)
			IF ncomp > 0
				BROW for UPPER(Company) = UPPER(lcText2Find) TITLE "Click X to close this find window."
			ELSE
				COUNT TO ncomp for LEFT(UPPER(Company),4) = LEFT(UPPER(lcText2Find ),4)
				IF ncomp > 0
					BROW for LEFT(UPPER(Company),4) = LEFT(UPPER(lcText2Find ),4) TITLE "Click X to close. Matched first 4 letters."
				ELSE
				COUNT TO ncomp for LEFT(UPPER(Company),2) = LEFT(UPPER(lcText2Find ),2)
				IF ncomp > 0
					BROW for LEFT(UPPER(Company),2) = LEFT(UPPER(lcText2Find ),2) TITLE "Click X to close. Matched first 2 letters."
				ELSE
					BROW for LEFT(UPPER(Company),1) = LEFT(UPPER(lcText2Find ),1) TITLE "Click X to close. Matched first 1 letter only."
				ENDIF
				ENDIF
			ENDIF
		CASE IntcmbFind = 3
			*PO_Num c,17
			lcText2Find = PrepareSQLtxt(This.Parent.txtFindText.Value,'PO_num',20)
			cLoad = " OR PO_Num = '"+lcText2Find+"'"
			ThisForm.ReLoadShip(cLoad)
			
			BROWSE for UPPER(PO_Num) = UPPER(lcText2Find) TITLE "Click X to close this find window."
		CASE IntcmbFind = 4
			*SOitem c,10
			PRIVATE cSOitem
			cSOitem = Proper_SO_item( lcText2Find )
			
			cLoad = " OR SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ThisForm.ReLoadShip(cLoad)
			
			SET ORDER TO SOitem
			BROWSE for SOitem = cSOitem TITLE "Click X to close this find window."
		ENDCASE
		*SET EXACT ON
		
		*This.Parent.Grid1.Setfocus
	ENDPROC

	PROCEDURE Pageframe1.pgFind.txtFindText.Valid
		IF NOT EMPTY(This.Value)
			This.parent.cmdFindcmbText.Valid
		*	This.Parent.Grid1.Setfocus
		ENDIF
	ENDPROC

ENDDEFINE
