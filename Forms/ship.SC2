	ENDPROC

	PROCEDURE Pageframe1.pgEdit.Click
		SELECT SHIP
		SET ORDER TO Salesnum
		ThisForm.Refresh
		This.Grid1.SetFocus
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmbFind.Valid
		PRIVATE IntcmbFind
		IntcmbFind = INT(This.Value)
		DO CASE
		CASE IntcmbFind = 1
			*Salesnum n,7
			m.gShipFindText = 0
			This.Parent.txtFindText.InputMask =	"9999999"
		CASE IntcmbFind = 2
			*Company c,30
			m.gShipFindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 3
			*PO_Num c,17
			m.gShipFindText = SPACE(17)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 4
			*SOitem c,10
			m.gShipFindText = SPACE(10)
			This.Parent.txtFindText.InputMask =	"99999-99"
		ENDCASE
		This.Parent.txtFindText.Refresh
		*This.parent.txtFindText.SetFocus
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmdFindcmbText.Valid
		PRIVATE IntcmbFind, recb4find, nBestFind, cLoad
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace m.gShipFindText
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		IF TYPE('laText2Find') = "N"
			lnText2Find = laText2Find
			lcText2Find = ALLTRIM(STR(laText2Find))
		ENDIF
		IF TYPE('laText2Find') = "C"
			lcText2Find = ALLTRIM(laText2Find)
			lnText2Find = VAL(laText2Find)
		ENDIF
		
		IF NOT USED('Ship')
			ThisForm.ReLoadShip( "ALL" )
		ENDIF
		
		IntcmbFind = INT(m.gncmbFind)
		recb4find = 0
		recb4find = RECNO('SHIP')
		
		SELECT Ship
		DO CASE
		CASE IntcmbFind = 1
			*Salesnum n,7
			lnText2Find = PrepareSQLnum(This.Parent.txtFindText.Value,'SalesNum',-3)
			cLoad = " OR SalesNum = "+STR( lnText2Find )
			ThisForm.ReLoadShip(cLoad)
			
			SET ORDER TO Salesnum
			SEEK lnText2Find IN 'SHIP' ORDER Salesnum
		CASE IntcmbFind = 2
			*Company c,30
			INDEX ON UPPER(Company) TAG UppCompany
			SET ORDER TO UppCompany
			SEEK UPPER(lcText2Find) IN 'SHIP' ORDER UppCompany
		CASE IntcmbFind = 3
			*PO_Num c,17
			lcText2Find = PrepareSQLtxt(This.Parent.txtFindText.Value,'PO_num',20)
			cLoad = " OR PO_Num = '"+lcText2Find+"'"
			ThisForm.ReLoadShip(cLoad)
			
			INDEX ON UPPER(PO_Num) TAG UppPO_Num
			SET ORDER TO UppPO_Num
			SEEK UPPER(lcText2Find) IN 'SHIP' ORDER UppPO_Num
		CASE IntcmbFind = 4
			*SOitem c,10
			SET ORDER TO SOitem
			PRIVATE cSOitem
			cSOitem = Proper_SO_item( lcText2Find )
			
			cLoad = " OR SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ThisForm.ReLoadShip(cLoad)
			SET ORDER TO SOitem
			
			SEEK cSOitem IN 'SHIP' ORDER SOitem
		ENDCASE
		
		IF NOT FOUND('Ship')
			nBestFind = RECNO(0)
			IF nBestFind > 0 AND nBestFind <= RECCOUNT("SHIP")
				GOTO nBestFind 
			ENDIF
			IF EOF('SHIP')
				WAIT WINDOW 'Not Found' NOWAIT
				IF recb4find > 0 AND recb4find <= RECCOUNT("SHIP")
					GO recb4find
				ENDIF
			ELSE
				WAIT WINDOW 'closest match' NOWAIT
			ENDIF
		ENDIF
		
		This.Parent.Grid1.Refresh
		
		ThisForm.RefreshEditTab()
		
		*This.Parent.Grid1.Setfocus
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmdFindcmbText.When
		IF EMPTY(This.parent.txtFindText.Value)
		*	=MESSAGEBOX("Enter text first",16,"No text")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmdReviewShipping.Click
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(ship.SOitem,'SOitem',10)
		
		DO FORM Forms\SOitem_Shipped WITH cSOitem, ThisForm.nConnHandle
		
		WAIT WINDOW "Refreshing Table" NOWAIT
		ThisForm.ReLoadShip()
		*Update_Ship_SOitem( cSoItem, ThisForm.nConnHandle )
		IF USED('Ship')
			LOCATE FOR SOitem = cSOitem
			IF FOUND('Ship')
				This.parent.Grid1.Refresh
				ThisForm.RefreshEditTab()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmdSave.Click
		PRIVATE dShipDate,cShipVia,nQshipped,lComplete,lCncld
		dShipDate	= PrepareSQLdate(This.parent.txtShipdate.Value,'ShipDate')
		cShipVia	= PrepareSQLtxt(This.parent.txtShipVia.Value,'ShipVia',20)
		nQshipped	= PrepareSQLnum(This.parent.txtQshipped.Value,'Q Shipped',10,0)
		lComplete	= PrepareSQLchk(This.parent.chkComplete.Value,'Complete',.F.)
		lCncld		= PrepareSQLchk(This.parent.chkCancel.Value,'Cancel',.F.)
		PRIVATE lCmplt, lCncld, nqShipped
		lCmplt = PrepareSQLchk(This.parent.chkComplete.Value,'Complete',.T.)
		lCncld = PrepareSQLchk(This.parent.chkCancel.Value,'Cancel',.F.)
		nQShipped = PrepareSQLnum(This.parent.txtQshipped.Value,'Qshipped',-3)
		
		PRIVATE cSOitem, nSalesNum, cSOItem, cShipRoute
		IF USED('Ship')
			cShipRoute	= PrepareSQLtxt(Ship.ShipVia,'ShipVia',20)
			cSOitem		= PrepareSQLtxt(Ship.soItem,'SOitem',10)
			nSalesNum	= PrepareSQLnum(Ship.Salesnum,'SalesNum',-3)
		ELSE
			MESSAGEBOX("Could not open Ship table",0+48,"Error, cannot save")
			RETURN -1
			cShipRoute = ''
			cSOItem		= Proper_SO_item('')
			nSalesNum	= 0
		ENDIF
		
		***test for Valid Data
		
		IF EMPTY(cSOItem)  &&Do not spread the error
			MESSAGEBOX("SO Item is empty."+CHR(13)+"Correct this first!",0+16,"ERROR")
			RETURN -1
		ENDIF
		
		cSO = LEFT(cSOItem,7)
		cItem = RIGHT(cSOitem,2)
		IF EMPTY(cSO) 
			MESSAGEBOX("SALESORDER of SO Item is empty."+CHR(13)+"Correct this first!",0+16,"ERROR")
			RETURN -1
		ENDIF
		IF EMPTY(cItem)
			MESSAGEBOX("ITEM NUMBER of SO Item is empty."+CHR(13)+"Correct this first!",0+16,"ERROR")
			RETURN -1
		ENDIF
		IF VAL(cSO)=0
			MESSAGEBOX("SALESORDER is Zero."+CHR(13)+;
			ALLTRIM(cSO)+" <> "+ALLTRIM(STR(nSalesNum,7,0))+CHR(13)+"Correct this first!",0+16,"ERROR")
			RETURN -1
		ENDIF
		IF VAL(cSO)<>nSalesNum
			MESSAGEBOX("SALESORDER of SO Item does not match SalesNum."+CHR(13)+;
			ALLTRIM(cSO)+" <> "+ALLTRIM(STR(nSalesNum,7,0))+CHR(13)+"Correct this first!",0+16,"ERROR")
			RETURN -1
		ENDIF
		
		
		*************************************************
		cSQL = "UPDATE dbo.SHIP SET "
		cSQL = cSQL + "ShipDate = '"+IIF(!EMPTY(dShipDate),DTOC(dShipDate),'')+"'"
		cSQL = cSQL + ", ShipVia = '"+cShipVia+"'"
		cSQL = cSQL + ", Qshipped = "+STR(nQshipped,10,0)
		*cSQL = cSQL + ", [Complete] = "+IIF(lComplete,'1','0')
		*cSQL = cSQL + ", [Cncld] = "+IIF(lCncld,'1','0')
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
		ELSE
			WAIT WINDOW 'Saved!' NOWAIT
			This.Parent.Grid1.Refresh
			This.Parent.Grid1.Setfocus
		ENDIF
		
		***********************************************
		* Save in Sales, Sales_No
		*SELECT COUNT(soItem) FROM SALES WHERE SALES.soItem = Ship.soItem INTO ARRAY anSoItems
		IF Count_SOIteminSales(cSOItem, ThisForm.nConnHandle) = 0
		*	INSERT INTO SALES(  soItem, Salesnum, shipped,  qshipped,   cncld,  cmplt) VALUES ;
		*		(Ship.soItem, nSalesNum, dShipdate, nqShipped, lCncld, lCmplt)
			cSQL = "INSERT INTO dbo.Sales ( SOitem, SalesNum, shipped, qshipped, cncld, cmplt) VALUES ("
			cSQL = cSQL + " dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + ","+STR(nSalesNum)
			cSQL = cSQL + ",'"+IIF(EMPTY(dShipdate),'',DTOC(dShipdate))+"'"
			cSQL = cSQL + ","+STR(nQshipped)
			cSQL = cSQL + ","+IIF(lCncld,'1','0')
			cSQL = cSQL + ","+IIF(lCmplt,'1','0')
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
			ENDIF
			TrackMess("SOitem:"+cSOitem+" was added in Sales and Complete was saved as "+IIF(lCmplt,'1','0')+" in Ship Screen, Grid1.Valid() L64")
		ELSE
			IF NOT EMPTY(cSOItem)
				IF cSOItem!=Proper_SO_item('')
			*	UPDATE SALES SET shipped=dShipDate, qshipped=nqShipped, ;
			*		cncld=lCncld, cmplt=lCmplt WHERE SALES.soItem = Ship.soItem
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL+" shipped = '"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate) )+"'"
					cSQL = cSQL+" ,Qshipped = "+STR(nQshipped,10,0)
					cSQL = cSQL+" WHERE soItem = dbo.f_ProperSOitem('"+cSOItem+"')"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
					ENDIF
		
				ENDIF
			ENDIF
		ENDIF
		
		********************************************
		*Sales_No
		
		PRIVATE nCountSO
		nCountSO = 0
		IF nSalesNum > 0
			nCountSO = Count_SOinSales_No(nSalesNum , ThisForm.nConnHandle)
		ENDIF
		
		IF nCountSO  > 0
			cSQLu = "UPDATE dbo.Sales_no SET "
			cSQLu = cSQLu + " shiproute='"+ cShipRoute +"'"
			cSQLu = cSQLu + " WHERE SalesNum = "+STR(nSalesNum)
			
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC )
			ELSE
				Save_Sales_Status( nSalesNum, "Add", "Changed Ship Route in Ship.cmdSave", ThisForm.nConnHandle)
			ENDIF
		ELSE
			cSQLi = "INSERT INTO dbo.Sales_No "
			cSQLi = cSQLi + "(SalesNum,shiproute) VALUES "
			cSQLi = cSQLi + "( "+STR(nSalesNum)+",'"+cShipRoute+"')"
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC )
			ELSE
				Save_Sales_Status( nSalesNum, "Add", "Changed Ship Route in Ship.cmdSave", ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		***********************************************
		* Save in AllQuotes
		IF NOT EMPTY(cSOItem)
			IF cSOItem!=Proper_SO_item('')
			
				cSQL = "UPDATE dbo.AllQuotes SET "
				cSQL = cSQL+" ShipDate = '"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate) )+"'"
				cSQL = cSQL+" WHERE SoItem = dbo.f_ProperSOitem('"+cSOItem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ENDIF
		
			ENDIF
		ENDIF
		
		
		***********************************************
		* Save in Sales_Detail
		IF NOT EMPTY(cSOItem)
			IF cSOItem!=Proper_SO_item('')
			
				*Open Sales_Detail_Shipped screen	
				DO FORM Forms\chooseSales_Detail_Ship WITH cSOitem, 0
				
		
		
			ENDIF
		ENDIF
		
		********************************************
		
		ThisForm.ReLoadShip()
		
		
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.RefreshEditTab()
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.Grid1.Init
		This.SetAll("dynamicbackcolor","IIF(DELETED(), RGB(255,0,0),IIF(cncld, RGB(255,220,220), IIF(PrepareSQLchk(Ship.Complete,'Complete'), RGB(200,208,200), RGB(255,255,255))))", "Column")
		
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.lblShipDate.Click
		PRIVATE dDate1,dDate2
		
		dDate1 = This.Parent.txtShipdate.Value
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		This.Parent.txtShipdate.Value = dDate2
		
		*!*	This.Parent.txtShipdate.Value = DATE()
		*!*	This.Parent.txtShipdate.Refresh
		*!*	This.Parent.txtShipdate.SetFocus
	ENDPROC

