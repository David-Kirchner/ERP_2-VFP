	PROCEDURE Pageframe1.pgEdit.Vcr1.recordpointermoved
		This.Parent.txtSoitem.Refresh
		This.Parent.txtCompany.Refresh
		This.Parent.txtShipDate.Refresh
		This.Parent.txtShipVia.Refresh
		This.Parent.chkCancel.Refresh
		This.Parent.Parent.pgAdd.chkComplete.Refresh
		This.Parent.txtQshipped.Refresh
		
		*This.Parent.chkDeleted.Value = DELETED()
		*This.Parent.chkDeleted.Refresh
		
		This.Parent.Grid1.REFRESH
		This.Parent.Grid1.SetFocus
	ENDPROC

