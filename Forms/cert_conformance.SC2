	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpCoC')	
			USE IN tmpCoC
		ENDIF
		
		Thisform.fntmpCoC = UniqDBF(ThisForm.fntmpCoC)
		
		
		SELECT 0
		
		SET SAFETY OFF
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+Thisform.fntmpCoC) FREE (;
				SOitem CHAR(10), PO CHAR(17), Alloy CHAR(12), Heat CHAR(30), Descript CHAR(80), Spec CHAR(160), PartNo CHAR(100) )
			USE (SYS(5)+SYS(2003)+"\"+Thisform.fntmpCoC) EXCL ALIAS tmpCoC
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+Thisform.fntmpCoC) FREE (;
				SOitem CHAR(10), PO CHAR(17), Alloy CHAR(12), Heat CHAR(30), Descript CHAR(80), Spec CHAR(160), PartNo CHAR(100) )
			USE (SYS(5)+SYS(2003)+"\MEM\"+Thisform.fntmpCoC) EXCL ALIAS tmpCoC
		ENDIF
		IF NOT USED('tmpCoC')
			MESSAGEBOX("Table error:"+CHR(13)+"Is program running twice?",16,"Could not load table")
			TrackError("Could not load table", "CREATE TABLE (SYS(5)+SYS(2003)+'\tmpCoC') FREE", "frmCofC.Load()", LINENO(1) )
			ThisForm.Release
			EXIT
		ENDIF
		
		SELECT tmpCoC
		APPEND BLANK
		
		INDEX ON SOItem TAG SOitem
		
		***
		
		IF USED('tmpCoC_No')	
			USE IN tmpCoC_No
		ENDIF
		
		
		ThisForm.fntmpCoC_No = UniqDBF(Thisform.fntmpCoC_No)
		
		
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+ThisForm.fntmpCoC_No ) FREE (Company CHAR(30),Addr1 CHAR(30),Addr2 CHAR(30),City CHAR(20),St CHAR(2),Zip CHAR(12),Country CHAR(20);
				, Misc MEMO, MFC L, NWR L, DFARS L, PartNo CHAR(100), [Who] CHAR(254) )
			USE (SYS(5)+SYS(2003)+"\"+ThisForm.fntmpCoC_No) EXCL ALIAS tmpCoC_No	
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fntmpCoC_No ) FREE (Company CHAR(30),Addr1 CHAR(30),Addr2 CHAR(30),City CHAR(20),St CHAR(2),Zip CHAR(12),Country CHAR(20);
				, Misc MEMO, MFC L, NWR L, DFARS L, PartNo CHAR(100), [Who] CHAR(254) )
			USE (SYS(5)+SYS(2003)+"\MEM\"+ThisForm.fntmpCoC_No) EXCL ALIAS tmpCoC_No
		ENDIF
		IF NOT USED('tmpCoC_No')
			MESSAGEBOX("Table error:"+CHR(13)+"Is program running trice?",16,"Could not load table")
			EXIT
		ENDIF
		
		SELECT tmpCoC_No
		APPEND BLANK
		
		**
		
		SELECT tmpCoC
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpCoC')	
			USE IN tmpCoC
		ENDIF
		IF USED('tmpCoC_No')	
			USE IN tmpCoC_No
		ENDIF
		
		
		UniqDBFdel(ThisForm.fntmpCoC)
		UniqDBFdel(ThisForm.fntmpCoC_No)
		
	ENDPROC

	PROCEDURE cmdDelete.Click
		SELECT tmpCoC
		IF DELETED()
			RECALL
		ELSE
			DELETE
		ENDIF
		ThisForm.grdCoC.SetFocus
		
	ENDPROC

	PROCEDURE cmdDone.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdNew.Click
		SELECT tmpCoC
		APPEND BLANK
		
		*ThisForm.txtSOitem.Value	= ''
		ThisForm.txtPO.Value		= ''
		ThisForm.txtAlloy.Value		= ''
		ThisForm.txtHeat.Value		= ''
		ThisForm.txtDescript.Value	= ''
		ThisForm.txtSpec.Value		= ''
		ThisForm.txtPN.Value		= ''
	ENDPROC

	PROCEDURE cmdPrint.Click
		*ThisForm.grdCoC.RecordSource = ''
		
		SELECT tmpCoC
		PACK
		
		SELECT tmpCoC_No
		REPLACE Company WITH PrepareSQLtxt(ThisForm.COMPANY1.Value,"Company",30)
		REPLACE Addr1	WITH PrepareSQLtxt(ThisForm.Addr11.Value,"Addr1",30)
		REPLACE Addr2	WITH PrepareSQLtxt(ThisForm.Addr21.Value,"Addr2",30)
		REPLACE City	WITH PrepareSQLtxt(ThisForm.City1.Value,"City",20)
		REPLACE ST		WITH PrepareSQLtxt(ThisForm.ST1.Value,"ST",2)
		REPLACE Zip		WITH PrepareSQLtxt(ThisForm.Zip1.Value,"Zip",12)
		REPLACE Country	WITH PrepareSQLtxt(ThisForm.Country1.Value,"Country",15)
		REPLACE Misc	WITH PrepareSQLtxt(ThisForm.edtMisc.Value,'Misc',-1)
		*(suser_sname())
		REPLACE Who		WITH LEFT( "WINDFALL\"+RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) ,254)
		
		REPLACE MFC		WITH PrepareSQLlogic(ThisForm.chkMFC.Value,'MFC')
		REPLACE NWR		WITH PrepareSQLlogic(ThisForm.chkNWR.Value,'NWR')
		REPLACE DFARS	WITH PrepareSQLlogic(ThisForm.chkDFARS.Value,'DFARS')
		
		WAIT WINDOW "USER: "+ALLTRIM( RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) ) +CHR(13)+"Press any key.."
		
		? ALLTRIM( RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) )='Hailey'
		*WAIT WINDOW "USER: ='Hailey'"+ALLTRIM( RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) )='Hailey' +CHR(13)+"Press any key.."
		
		SELECT tmpCoC
		REPORT FORM Reports\Cert_Conf TO PRINTER PROMPT NOCONSOLE
		
		WAIT WINDOW 'Sent to Printer' NOWAIT
		*BROWSE LAST
		
		*********************************************
		*Save to SQL
		*Cert_Conf_No
		*Cert_Conf
		************************************
		
		IF USED('tmpCert_Conf_ID')
			USE IN tmpCert_Conf_ID
		ENDIF
		SELECT 0
		PRIVATE nCert_Conf_No_ID
		nCert_Conf_No_ID = 0
		
		PRIVATE cCompany,cAddr1,cAddr2,cCity,cSt,cZip,cCountry,cMisc
		cCompany	= PrepareSQLtxt(ThisForm.COMPANY1.Value,"Company",30)
		cAddr1		= PrepareSQLtxt(ThisForm.Addr11.Value,"Addr1",30)
		cAddr2		= PrepareSQLtxt(ThisForm.Addr21.Value,"Addr2",30)
		cCity		= PrepareSQLtxt(ThisForm.City1.Value,"City",20)
		cST			= PrepareSQLtxt(ThisForm.ST1.Value,"ST",2)
		cZip		= PrepareSQLtxt(ThisForm.Zip1.Value,"Zip",12)
		cCountry	= PrepareSQLtxt(ThisForm.Country1.Value,"Country",15)
		cMisc		= PrepareSQLtxt(ThisForm.edtMisc.Value,'Misc',-1)
		
		PRIVATE lMFC,lNWR,lDFARS
		lMFC	= PrepareSQLlogic(ThisForm.chkMFC.Value,'MFC')
		lNWR	= PrepareSQLlogic(ThisForm.chkNWR.Value,'NWR')
		lDFARS	= PrepareSQLlogic(ThisForm.chkDFARS.Value,'DFARS')
		
		
						
		PRIVATE cSQL,nSQLEXEC 
		cSQL = "EXEC dbo.p_Cert_Conf_No_ins2 "
		cSQL = cSQL + "@Company='"+cCompany+"'"
		cSQL = cSQL + ",@Addr1='"+cAddr1+"'"
		cSQL = cSQL + ",@Addr2='"+cAddr2+"'"
		cSQL = cSQL + ",@City='"+cCity+"'"
		cSQL = cSQL + ",@St='"+cSt+"'"
		cSQL = cSQL + ",@Zip='"+cZip+"'"
		cSQL = cSQL + ",@Country='"+cCountry+"'"
		cSQL = cSQL + ",@MFC="+IIF(lMFC,'1','0')
		cSQL = cSQL + ",@NWR="+IIF(lNWR,'1','0')
		cSQL = cSQL + ",@DFARS="+IIF(lDFARS,'1','0')
		cSQL = cSQL + ",@Misc='"+cMisc+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpCert_Conf_ID' )
										
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL,'tmpCert_Conf_ID' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_Conf_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_Conf_ID")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCert_Conf_ID')
		ENDIF			
		
		IF USED('tmpCert_Conf_ID')
			SELECT tmpCert_Conf_ID
			nCert_Conf_No_ID = tmpCert_Conf_ID.exp	
			USE IN tmpCert_Conf_ID
		ENDIF
		
		IF nCert_Conf_No_ID > 0
			PRIVATE nSO
			nSO = PrepareSQLnum(ThisForm.txtSO.Value,'SO',9,0)
			TrackMess("Printed 'Certificate of Conformance' for SO:"+ALLTRIM(STR(nSO,9,0))+",  Cert_Conf_No_ID:"+ALLTRIM(STR(nCert_Conf_No_ID)) )
			
			PRIVATE cSOitem, cPO_Num, cAlloy, cHeat, cDescript, cSpec, cPartNo
			SELECT tmpCoC
			SCAN
				cSOitem		= PrepareSQLtxt(tmpCoc.SOitem,'SOitem',10)
				cSOitem		= Proper_SO_Item(cSOitem)
				cPO_num		= PrepareSQLtxt(tmpCoC.PO,'PO_Num',20)
				cPO_num		= Proper_PO_Item(cPO_num)
				cAlloy		= PrepareSQLtxt(tmpCoC.Alloy,'Alloy',12)
				cHeat		= PrepareSQLtxt(tmpCoC.Heat,'Heat',40)
				cDescript	= PrepareSQLtxt(tmpCoC.Descript,'Descript',80)
				cSpec		= PrepareSQLtxt(tmpCoC.Spec,'Spec',80)
				cPartNo		= PrepareSQLtxt(tmpCoC.PartNo,'PartNo',100)
				
				cSQL = "INSERT dbo.Cert_Conf ("
				cSQL = cSQL +"Cert_Conf_No_ID,SOitem,PO_Num,Alloy,Heat,Descript,Spec,PartNo) VALUES ("
				cSQL = cSQL +STR(nCert_Conf_No_ID)
				cSQL = cSQL +",'"+cSOitem+"'"
				cSQL = cSQL +",'"+cPO_Num+"'"
				cSQL = cSQL +",'"+cAlloy+"'"
				cSQL = cSQL +",'"+cHeat+"'"
				cSQL = cSQL +",'"+cDescript+"'"
				cSQL = cSQL +",'"+cSpec+"'"
				cSQL = cSQL +",'"+cPartNo+"'"
				cSQL = cSQL +")"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpCert_Conf_ID' )
												
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL,'tmpCert_Conf_ID' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_Conf_ID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_Conf_ID")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCert_Conf_ID')
				ELSE
					WAIT WINDOW 'Recorded to dbo.Cert_Conf' NOWAIT
				ENDIF	
						
			ENDSCAN
		ENDIF
		**********************************************
		
		
		SELECT tmpCoC
		GO TOP
		
		WAIT WINDOW 'Done' TIMEOUT 1
		
		*!*	ThisForm.txtSOitem.Value	= ''
		*!*	ThisForm.txtPO.Value		= tmpCoC.PO
		*!*	ThisForm.txtAlloy.Value		= tmpCoC.Alloy
		*!*	ThisForm.txtHeat.Value		= tmpCoC.Heat
		*!*	ThisForm.txtDescript.Value	= tmpCoC.Descript
		*!*	ThisForm.txtSpec.Value		= tmpCoC.Spec
		*!*	ThisForm.txtPN.Value		= tmpCoC.PartNo
		
		*!*	ThisForm.grdCoC.RecordSource = 'tmpCoC'
		*!*	ThisForm.grdCoC.Column1.ControlSource 	= 'tmpCoC.PO'
		*!*	ThisForm.grdCoC.Column2.ControlSource	= 'tmpCoC.Alloy'
		*!*	ThisForm.grdCoC.Column3.ControlSource	= 'tmpCoC.Heat'
		*!*	ThisForm.grdCoC.Column4.ControlSource	= 'tmpCoC.Descript'
		*!*	ThisForm.grdCoC.Column5.ControlSource	= 'tmpCoC.Spec'
		*!*	ThisForm.grdCoC.Column6.ControlSource	= 'tmpCoC.PartNo'
	ENDPROC

	PROCEDURE cmdSearchSoldTo.Click
		Private matchCodes, nNewSoldToCode, lcCurrTable 
		nNewSoldToCode = 0
		matchCodes = 0
		
		lcCurrTable = ALIAS()
		PRIVATE cCompany
		cCompany = ThisForm.COMPANY1.Value
		
		DO FORM Forms\SearchForm WITH "SoldAddr",cCompany ,ThisForm.nConnHandle  TO nNewSoldToCode
		*DO FORM SearchForm WITH "SoldAddr",Quotes.company  TO nNewSoldToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF nNewSoldToCode > 0
			IF USED( 'aSoldAddr' )
				USE IN aSoldAddr
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr"
			cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(nNewSoldToCode)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aSoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aSoldAddr')
			ENDIF
			IF USED( 'aSoldAddr' )
				ThisForm.Company1.VALUE= aSoldAddr.Company
				ThisForm.Company1.FORECOLOR = RGB(0,0,0)
				ThisForm.ADDR11.Value 	= aSoldAddr.Addr1
				ThisForm.ADDR21.Value 	= aSoldAddr.Addr2
				ThisForm.CITY1.Value 	= aSoldAddr.City
				ThisForm.ST1.Value	 	= aSoldAddr.St
				ThisForm.ZIP1.Value 	= aSoldAddr.Zip
				ThisForm.COUNTRY1.Value = aSoldAddr.Country
		*!*			THISFORM.SoldAddr = aSoldAddr.SoldCode
		*!*			THIS.PARENT.txtSoldCode.VALUE = aSoldAddr.SoldCode
		*!*			THIS.PARENT.txtCompany.VALUE = aSoldAddr.Company
		*!*			THIS.PARENT.txtAddr1.VALUE = aSoldAddr.Addr1
		*!*			THIS.PARENT.txtAddr2.VALUE = aSoldAddr.Addr2
		*!*			THIS.PARENT.txtCity.VALUE = aSoldAddr.City
		*!*			THIS.PARENT.txtST.VALUE = aSoldAddr.ST
		*!*			THIS.PARENT.txtZip.VALUE = aSoldAddr.Zip
		*!*			THIS.PARENT.txtCountry.VALUE = aSoldAddr.Country
		*!*			THIS.PARENT.txtContact.VALUE = aSoldAddr.Contact
		*!*			THIS.PARENT.txtPhone.VALUE = aSoldAddr.TelePhone
		*!*			THIS.PARENT.txtFax.VALUE = aSoldAddr.Fax_Number
		*!*			THIS.PARENT.txtEmail.VALUE = aSoldAddr.Email
		*!*			THIS.PARENT.txtLastEdit.VALUE = IIF(EMPTY(PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit'))
				
		*		thisform.AddressScreen("SoldToEdit")
							
				*****************
				PRIVATE nSO
				nSO = PrepareSQLnum(ThisForm.txtSO.Value,'SO',9,0)
				IF nSO > 0
					IF Count_SOinPackingSlip_No( nSO,ThisForm.nConnHandle ) > 0
						MESSAGEBOX("This Order has been Packed for shipping!"+CHR(13)+;
						"The Packing Slip database will be updated with this new address.",0+48,;
						"A Packing Slip with the old address has already been Printed!")
						
						Update_SoldCodeinPackingSlip_No(nNewSoldToCode, nSO, ThisForm.nConnHandle )
					ENDIF
				ENDIF		
				******************
				USE IN aSoldAddr
				
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE COMPANY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpSoldAddr')	
			USE IN tmpSoldAddr
		ENDIF
		
		lcSearchStr = PrepareSQLtxt( lcSearchStr, 'Company', 30)
		
		IF !EMPTY(lcSearchStr)
		
			cSQL = "SELECT TOP 1 Company FROM dbo.SoldAddr WHERE Company Like '"+lcSearchStr+"%'"
				
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSoldAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSoldAddr")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpSoldAddr')
			ENDIF
			IF USED('tmpSoldAddr')
		
				IF UPPER(lcSearchStr) = SUBSTR(tmpSoldAddr.Company,1,lnInsertionPt)
					THIS.VALUE=tmpSoldAddr.Company
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
		
		
	ENDPROC

	PROCEDURE COMPANY1.Valid
		PRIVATE lcSearchStr
		lcSearchStr = THIS.VALUE
		
		IF EMPTY(ThisForm.ADDR11.Value) AND EMPTY(ThisForm.CITY1.Value)
			*Try to Fill Addr, Addr2, City
		
			PRIVATE nSQLEXEC, cSQL
			IF USED('tmpSoldAddr')	
				USE IN tmpSoldAddr
			ENDIF
		
			lcSearchStr = PrepareSQLtxt( lcSearchStr, 'Company', 30)
			IF !EMPTY(lcSearchStr)
		
				cSQL = "SELECT TOP 1 Company,Addr1,Addr2,City,St,Zip,Country FROM dbo.SoldAddr WHERE Company LIKE '"+lcSearchStr+"%'"
					
				SELECT 0
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSoldAddr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSoldAddr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSoldAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSoldAddr")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpSoldAddr')
				ENDIF
				IF USED('tmpSoldAddr')
				
					IF UPPER(ALLTRIM(lcSearchStr)) = UPPER(ALLTRIM(tmpSoldAddr.Company))
						THIS.VALUE=tmpSoldAddr.Company
						THIS.FORECOLOR = RGB(0,0,0)
						ThisForm.ADDR11.Value =	tmpSoldAddr.Addr1
						ThisForm.ADDR21.Value =	tmpSoldAddr.Addr2
						ThisForm.CITY1.Value =	tmpSoldAddr.City
						ThisForm.ST1.Value =	tmpSoldAddr.St
						ThisForm.ZIP1.Value =	tmpSoldAddr.Zip
						ThisForm.COUNTRY1.Value =	tmpSoldAddr.Country
						
					ELSE
						*THIS.VALUE=lcSearchStr
						*THIS.FORECOLOR = RGB(255,0,0)
					ENDIF
				ELSE
			*		*No replacement
					*THIS.VALUE=lcSearchStr
					*THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
				THIS.VALUE=SPACE(0)
			ENDIF
		
		ENDIF
		
	ENDPROC

	PROCEDURE grdCoC.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.txtSOitem.Value	= tmpCoC.SOitem
		ThisForm.txtPO.Value		= tmpCoC.PO
		ThisForm.txtAlloy.Value		= tmpCoC.Alloy
		ThisForm.txtHeat.Value		= tmpCoC.Heat
		ThisForm.txtDescript.Value	= tmpCoC.Descript
		
		ThisForm.txtSpec.Value		= tmpCoC.Spec
		ThisForm.txtPN.Value		= tmpCoC.PartNo
	ENDPROC

	PROCEDURE lblGetPN.Click
		PRIVATE cSOItem
		cSOitem = Proper_SO_Item(ThisForm.txtSOitem.Value)
			
		IF NOT EMPTY(cSOitem)
			WAIT WINDOW 'Getting Part Number' NOWAIT
			
			IF USED('tmpSalesPartNo')
				USE IN tmpSalesPartNo
			ENDIF 
			
			cSQL = "SELECT PartNo "
			cSQL = cSQL + " FROM dbo.Sales "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
				
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSalesPartNo')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSalesPartNo')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesPartNo")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesPartNo")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpSalesPartNo')
			ENDIF
			IF USED('tmpSalesPartNo')
			
				IF cSOItem = tmpSalesPartNo.PartNo
					ThisForm.txtSpec.Value		= tmpSalesPartNo.PartNo
					SELECT tmpCoC
					REPLACE PartNo WITH tmpSalesPartNo.PartNo
					
				ENDIF
				USE IN tmpSalesPartNo
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE lblGetSpec.Click
		PRIVATE cSOItem
		cSOitem = Proper_SO_Item(ThisForm.txtSOitem.Value)
			
		IF NOT EMPTY(cSOitem )
			WAIT WINDOW 'Getting Spec Data' NOWAIT
			
			IF USED('tmpQuote')
				USE IN tmpQuote
			ENDIF 
			
			cSQL = "SELECT Comments, SOitem "
			cSQL = cSQL + " FROM dbo.AllQuotes "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
				
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpQuote')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpQuote')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuote")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuote")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpQuote')
			ENDIF
			IF USED('tmpQuote')
			
				IF cSOItem = tmpQuote.SOitem
					PRIVATE cComments
					cComments = PrepareSQLtxt(tmpQuote.Comments,'Comments',-1)
					
					ThisForm.txtSpec.Value	= cComments
					SELECT tmpCoC
					REPLACE Spec WITH cComments
					
				ENDIF
				USE IN tmpQuote
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE txtAlloy.Valid
		SELECT tmpCoC
		REPLACE Alloy WITH This.Value
		
	ENDPROC

	PROCEDURE txtDescript.Valid
		SELECT tmpCoC
		REPLACE Descript WITH ShowSQLtxt( This.Value,'Descript',80)
		
	ENDPROC

	PROCEDURE txtHeat.Valid
		PRIVATE ok2Save, tHeat
		ok2Save = .T.
		tHeat = This.Value
		
		IF ok2Save
			IF "HPA-" $ UPPER(tHeat)
				IF MESSAGEBOX("The Production Lot number standard no longer uses a dash 'HPA-'"+CHR(10)+"Answer Yes and you can edit the Heat.",4+32,"Revise the heat field?") = 6
					ok2Save = .F.		
				ENDIF
			ENDIF
		ENDIF		
		IF ok2Save
			IF "HPAG" $ UPPER(tHeat)
				IF MESSAGEBOX("The Production Lot number standard now uses a space like 'HPA G999'"+CHR(10)+"Answer Yes and you can edit the Heat.",4+32,"Revise the heat field?") = 6
					ok2Save = .F.		
				ENDIF
			ENDIF
		ENDIF		
		IF ok2Save
			IF "HPAR" $ UPPER(tHeat)
				IF MESSAGEBOX("The Production Lot number standard now uses a space like 'HPA R999'"+CHR(10)+"Answer Yes and you can edit the Heat.",4+32,"Revise the heat field?") = 6
					ok2Save = .F.		
				ENDIF
			ENDIF
		ENDIF		
		IF ok2Save
			IF "HPAL" $ UPPER(tHeat)
				IF MESSAGEBOX("The Production Lot number standard now uses a space like 'HPA L999'"+CHR(10)+"Answer Yes and you can edit the Heat.",4+32,"Revise the heat field?") = 6
					ok2Save = .F.		
				ENDIF
			ENDIF
		ENDIF		
		
		
		IF ok2Save
			SELECT tmpCoC
			REPLACE Heat WITH This.Value
		ENDIF
		
	ENDPROC

	PROCEDURE txtPN.Valid
		SELECT tmpCoC
		REPLACE PartNo WITH This.Value
		ThisForm.grdCoC.Refresh
	ENDPROC

	PROCEDURE txtPO.Valid
		SELECT tmpCoC
		REPLACE PO WITH This.Value
		
	ENDPROC

	PROCEDURE txtSO.LostFocus
		IF NOT EMPTY(This.Value)
			WAIT WINDOW 'Getting Data' NOWAIT
			
			PRIVATE nSO
			nSO = PrepareSQLnum(This.Value,'SO',9,0)
			
			IF USED('tmpQuote')
				USE IN tmpQuote
			ENDIF 
			
			cSQL = "SELECT PO_Num,Alloy,dbo.f_ItemDescription(Form,THCK,Sz2,Sz3,Weight,RandLen) AS Descript, Comments, SOitem ,Pieces"
			cSQL = cSQL + " FROM dbo.AllQuotes "
			cSQL = cSQL + " WHERE SalesNum = "+STR(nSO)
				
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpQuote')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpQuote')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuote")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuote")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpQuote')
			ENDIF
			IF USED('tmpQuote')
				*Clean tmpCoC
				SELECT tmpCoC
				ThisForm.grdCoC.RecordSource=''
				DELETE ALL FOR EMPTY(SOitem)
				PACK
				
				SELECT tmpQuote
				SCAN
					IF VARTYPE(tmpQuote.SOitem) = "C"
						cSOItem = tmpQuote.SOitem
						ThisForm.txtSOitem.Value	= tmpQuote.SOitem
						ThisForm.txtPO.Value		= tmpQuote.PO_Num
						ThisForm.txtAlloy.Value		= tmpQuote.Alloy
						cDescript = ALLTRIM(STR(PrepareSQLnum(tmpQuote.Pieces,'Pieces',-3)))+" Pc "+PrepareSQLtxt(tmpQuote.Descript,'Descript',50)
						ThisForm.txtDescript.Value	= cDescript 
						*ThisForm.txtDescript.Value	= tmpQuote.Descript
						ThisForm.txtSpec.Value		= ''	&&tmpQuote.Comments
		
						*Get Heat
						IF USED('tmpPackSlip')
							USE IN tmpPackSlip
						ENDIF 
						
						cSQL = "SELECT Pcs,Descript,HEAT,SOitem "
						cSQL = cSQL + " FROM dbo.PackingSlip "
						cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
							
						SELECT 0
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPackSlip')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPackSlip')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPackSlip")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPackSlip")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpPackSlip')
						ENDIF
						IF USED('tmpPackSlip')
							IF RECCOUNT('tmpPackSlip') > 0
								SCAN
									IF cSOItem = tmpPackSlip.SOitem
										ThisForm.txtHeat.Value	= ALLTRIM(tmpPackSlip.Heat)
										cDescript = ALLTRIM(STR(PrepareSQLnum(tmpPackSlip.Pcs,'Pieces',-3)))+" Pc "+PrepareSQLtxt(tmpPackSlip.Descript,'Descript',50)
										ThisForm.txtDescript.Value = cDescript
									ENDIF
									
									SELECT tmpCoC
									INSERT INTO tmpCoC (SOitem,PO,Alloy,Heat,Descript) VALUES ;
									(tmpQuote.SOitem,tmpQuote.PO_Num,tmpQuote.Alloy,tmpPackSlip.Heat,cDescript)
									*,Spec ,tmpQuote.Comments
									
									SELECT tmpPackSlip
									*SKIP
								ENDSCAN
								USE IN tmpPackSlip
							ELSE   &&RECCOUNT('tmpPackSlip') > 0
								INSERT INTO tmpCoC (SOitem,PO,Alloy,Descript) VALUES ;
								(tmpQuote.SOitem,tmpQuote.PO_Num,tmpQuote.Alloy,cDescript )
							ENDIF
						ELSE	&&USED('tmpPackSlip')
							INSERT INTO tmpCoC (SOitem,PO,Alloy,Descript) VALUES ;
							(tmpQuote.SOitem,tmpQuote.PO_Num,tmpQuote.Alloy,cDescript )
						
						ENDIF	&&USED('tmpPackSlip')
						
					ENDIF
					SELECT tmpQuote
					*SKIP
					
				ENDSCAN
				USE IN tmpQuote
				
				
				
				SELECT tmpCoC
				GO TOP IN tmpCoC
				ThisForm.grdCoC.RecordSource='tmpCoC'
				ThisForm.grdCoC.Column1.ControlSource 	= 'tmpCoC.PO'
				ThisForm.grdCoC.Column2.ControlSource	= 'tmpCoC.Alloy'
				ThisForm.grdCoC.Column3.ControlSource	= 'tmpCoC.Heat'
				ThisForm.grdCoC.Column4.ControlSource	= 'tmpCoC.Descript'
				ThisForm.grdCoC.Column5.ControlSource	= 'tmpCoC.Spec'
				ThisForm.grdCoC.Column6.ControlSource	= 'tmpCoC.PartNo'		
				
				*Get pSoldAddr from Sales_No
				IF USED('tmpSales_no')
					USE IN tmpSales_no
				ENDIF 
				
				cSQL = "SELECT pSoldAddr "
				cSQL = cSQL + " FROM dbo.Sales_No "
				cSQL = cSQL + " WHERE SalesNum = "+STR(nSO)
					
				SELECT 0
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSales_no')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSales_no')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_no")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_no")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpSales_no')
				ENDIF
				IF USED('tmpSales_no')
				
					IF tmpSales_no.pSoldAddr > 0
						*Get Billing Address
						cSQL = "SELECT TOP 1 Company,Addr1,Addr2,City,St,Zip,Country,SoldCode  FROM dbo.SoldAddr WHERE SoldCode = "+STR(tmpSales_no.pSoldAddr)
				
						SELECT 0
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSoldAddr')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSoldAddr')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSoldAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSoldAddr")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
		
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpSoldAddr')
						ENDIF
						IF USED('tmpSoldAddr')
						
							IF tmpSales_no.pSoldAddr  = tmpSoldAddr.SoldCode 
								ThisForm.Company1.VALUE=tmpSoldAddr.Company
								ThisForm.Company1.FORECOLOR = RGB(0,0,0)
								ThisForm.ADDR11.Value =	tmpSoldAddr.Addr1
								ThisForm.ADDR21.Value =	tmpSoldAddr.Addr2
								ThisForm.CITY1.Value =	tmpSoldAddr.City
								ThisForm.ST1.Value =	tmpSoldAddr.St
								ThisForm.ZIP1.Value =	tmpSoldAddr.Zip
								ThisForm.COUNTRY1.Value =	tmpSoldAddr.Country
								
							ENDIF
							USE IN tmpSoldAddr
						ENDIF
					ENDIF
					USE IN tmpSales_no
		
				ENDIF	
				
				
				
				This.TabStop = .F.
				*ThisForm.COMPANY1.SetFocus 
				ThisForm.chkMFC.SetFocus
				
				
			ENDIF
			**********************************************	
			
			PRIVATE cSOItem
			SELECT tmpCoC
			SCAN
		
				cSOitem = Proper_SO_Item(tmpCoC.SOitem)
				IF EMPTY(cSOitem)
					SKIP
				ENDIF
				
				IF USED('tmpSalesPartNo')
					USE IN tmpSalesPartNo
				ENDIF 
				
				cSQL = "SELECT PartNo "
				cSQL = cSQL + " FROM dbo.Sales "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
					
				SELECT 0
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSalesPartNo')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpSalesPartNo')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesPartNo")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesPartNo")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpSalesPartNo')
				ENDIF
				IF USED('tmpSalesPartNo')
				
					IF cSOItem = tmpSalesPartNo.PartNo
						*ThisForm.txtSpec.Value		= tmpSalesPartNo.PartNo
						SELECT tmpCoC
						REPLACE PartNo WITH tmpSalesPartNo.PartNo
						
					ENDIF
					USE IN tmpSalesPartNo
				ENDIF
			ENDSCAN
			
			SELECT tmpCoC
			GO TOP
			***********************************************************
		
			WAIT CLEAR
		ENDIF
	ENDPROC

	PROCEDURE txtSOitem.Valid
		IF NOT EMPTY(This.Value)
			WAIT WINDOW 'Getting Data' NOWAIT
			
			PRIVATE cSOItem
			cSOitem = Proper_SO_Item(This.Value)
			
			IF USED('tmpQuote')
				USE IN tmpQuote
			ENDIF 
			
			cSQL = "SELECT PO_Num,Alloy,dbo.f_ItemDescription(Form,THCK,Sz2,Sz3,Weight,RandLen) AS Descript, Comments, SOitem ,Pieces"
			cSQL = cSQL + " FROM dbo.AllQuotes "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
				
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpQuote')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpQuote')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuote")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuote")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpQuote')
			ENDIF
			IF USED('tmpQuote')
			
				IF cSOItem = tmpQuote.SOitem
					ThisForm.txtPO.Value		= tmpQuote.PO_Num
					ThisForm.txtAlloy.Value		= tmpQuote.Alloy
		*			ThisForm.txtHeat.Value		= tmpQuote.Heat
		*			ThisForm.txtDescript.Value	= tmpQuote.Descript
					ThisForm.txtDescript.Value	= ALLTRIM(STR(tmpQuote.Pieces))+" Pc "+ALLTRIM(tmpQuote.Descript)
					ThisForm.txtSpec.Value		= ''  &&tmpQuote.Comments
					ThisForm.txtPN.Value		= '' 
				ELSE
					ThisForm.txtPO.Value		= ''
					ThisForm.txtAlloy.Value		= ''
					ThisForm.txtHeat.Value		= ''
					ThisForm.txtDescript.Value	= ''
					ThisForm.txtSpec.Value		= ''
					ThisForm.txtPN.Value		= '' 
				ENDIF
				USE IN tmpQuote
			ENDIF
			
			*Get Heat
			IF USED('tmpPackSlip')
				USE IN tmpPackSlip
			ENDIF 
			
			cSQL = "SELECT Pcs,Descript,HEAT,SOitem "
			cSQL = cSQL + " FROM dbo.PackingSlip "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
				
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPackSlip')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPackSlip')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPackSlip")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPackSlip")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpPackSlip')
			ENDIF
			IF USED('tmpPackSlip')
			
				IF cSOItem = tmpPackSlip.SOitem
					ThisForm.txtAlloy.Value	= ALLTRIM(ThisForm.txtAlloy.Value)
					ThisForm.txtHeat.Value	= ALLTRIM(tmpPackSlip.Heat)
					ThisForm.txtDescript.Value	= ALLTRIM(STR(tmpPackSlip.Pcs))+" Pc "+ALLTRIM(tmpPackSlip.Descript)
				ENDIF
				USE IN tmpPackSlip
			ENDIF	
			
			SELECT tmpCoC
			REPLACE SOitem WITH cSOItem 
			REPLACE PO WITH ThisForm.txtPO.Value
			REPLACE Alloy WITH ThisForm.txtAlloy.Value
			REPLACE HEAT WITH ThisForm.txtHeat.Value
			REPLACE Descript WITH ThisForm.txtDescript.Value
			
			REPLACE Spec WITH ThisForm.txtSpec.Value
			REPLACE PartNo WITH ThisForm.txtPN.Value
			
			ThisForm.grdCoC.Refresh
			
			WAIT CLEAR
		ENDIF
	ENDPROC

	PROCEDURE txtSpec.Valid
		SELECT tmpCoC
		REPLACE Spec WITH This.Value
		ThisForm.grdCoC.Refresh
	ENDPROC

ENDDEFINE
