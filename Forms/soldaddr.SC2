	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE getallrecords
		
		*ThisForm.GetAllRecords()
		
		PRIVATE nAddrCode
		nAddrCode = 0
		
		IF USED('SoldAddr')
			nAddrCode = SoldAddr.SoldCode
			USE IN SoldAddr
		ENDIF
		SELECT 0
		
		WAIT WINDOW "Getting ALL records now!" NOWAIT
				
		cSQL = "SELECT * FROM dbo.SoldAddr ORDER BY Company"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
		ELSE
			IF nAddrCode > 0
				LOCATE FOR SoldCode = nAddrCode
			ENDIF
		
			ThisForm.Txtbtns1.Topfile = .F.
			ThisForm.Txtbtns1.navrefresh()
		
			ThisForm.Txtbtns1.CMDTOP.Enabled = .T.
			ThisForm.txtbtns1.CMDPrev.Enabled = .T.
			
		ENDIF
		
		ThisForm.cmdAll.Visible = .F.
	ENDPROC

	PROCEDURE Init
		PARAMETERS pSoldCode
		*DO FORM Forms\SoldAddr WITH 1024
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('SoldAddr')	
			USE IN SoldAddr
		ENDIF
		SELECT 0
		
		PRIVATE lFound
		lFound = .F.
		IF VARTYPE(pSoldCode) = "N"
			IF pSoldCode > 0
			
				cSQL = "SELECT S1.* FROM dbo.SoldAddr S1, dbo.SoldAddr S2 "
				cSQL = cSQL + " WHERE S2.SoldCode="+ALLTRIM(STR(pSoldCode))
				cSQL = cSQL + " AND S1.Company = S2.Company "
				
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
				ENDIF
			
				SELECT SoldAddr
				LOCATE FOR SoldCode = pSoldCode
				IF FOUND()
					lFound = .T.
					IF EOF()
						ThisForm.Txtbtns1.Endfile = .T.
					ELSE
						ThisForm.Txtbtns1.Endfile = .f.
					ENDIF
					IF BOF()
						ThisForm.Txtbtns1.Topfile = .T.
					ELSE
						ThisForm.Txtbtns1.Topfile = .F.
					ENDIF
					ThisForm.Txtbtns1.navrefresh()
		
		
					ThisForm.cmdAll.Visible = .T.
				ENDIF
			ENDIF
		ELSE
			*MESSAGEBOX("Parameters should look like this."+CHR(13)+"\SoldAddr WITH nSoldCode",16,"Bad Parameters")
		ENDIF
		
		IF NOT lFound
			ThisForm.GetAllRecords()
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_Setup.prg ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('SoldAddr')	
			USE IN SoldAddr
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK) WHERE 0>0"
			
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
		ENDIF
			
		RETURN !THIS.HadError
	ENDPROC

	PROCEDURE recordmoved
		*RecordMoved()
		PRIVATE cSalesPs
		cSalesPs = getSalesP_Customer( SoldAddr.SoldCode, ThisForm.nConnHandle )
		ThisForm.lblSalesP_Customer.Caption = cSalesPs
		
	ENDPROC

	PROCEDURE refreshtable
		PARAMETERS pRecNo
		*ThisForm.RefreshTable( RECNO(SoldAddr) )
		
		IF USED('SoldAddr')	
			USE IN SoldAddr
		ENDIF
		
		cSQL = "SELECT * FROM dbo.SoldAddr"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
		ENDIF
		
		IF VARTYPE(pRecNo) = 'N'
			IF pRecNo < RECCOUNT(SoldAddr)
				GOTO pRecNo
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE saveadd
		PARAMETERS pWhat
		*SaveAdd()  'Add' 'Save'
		
		IF VARTYPE( pWhat ) != 'C'
			pWhat = ''
		ENDIF
		
		IF EMPTY(pWhat)
			RETURN .F.
		ENDIF
		
		IF UPPER(pWhat) = "ADD"
			*get a new ShipCode
			
			PRIVATE useSoldCode, maxSoldCode
			*thisform.MaxSoldCode()
			*Get next code maxShipCode
		
			IF USED('cntShipAddr')
				USE IN cntShipAddr
			ENDIF
			SELECT 0
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT MAX(SoldCode) AS Cntd FROM dbo.SoldAddr "
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
			ENDIF
		
			IF USED('cntShipAddr')
				IF cntShipAddr.Cntd > 0
					useSoldCode = cntShipAddr.Cntd + 1
					ThisForm.SoldCODE1.Value = useSoldCode 
				ELSE
					useSoldCode = 1000
				ENDIF
			ENDIF
		
			IF USED('cntShipAddr')
				USE IN cntShipAddr
			ENDIF
			
			Thisform.SOLDCODE1.Value = useSoldCode 
			Thisform.LASTEDIT.Value = DATE()
			Thisform.Added1.Value = DATE()
			
			ThisForm.chkInactive.Value = 0
			Thisform.COMPANY1.Value = ''
			Thisform.ADDR11.Value = ''
			Thisform.AddR21.Value = ''
			Thisform.CITY1.Value = ''
			Thisform.ST1.Value = ''
			Thisform.ZIP1.Value = ''
			
			Thisform.COUNTRY1.Value = ''
			ThisForm.Marketing1.Value = ''
			
			Thisform.CONTACT1.Value = ''
			Thisform.TELEPHONE1.Value = ''
			Thisform.FAX_NUMBER1.Value = ''
			Thisform.EMAIL1.Value = ''
			
			Thisform.CUSTOMER1.Value = ''
			
			ThisForm.WhoAdd1.Value = ''
			
			*Thisform.txtInstrct.Value = ''
			*Thisform.chkBlind.Value = 0
			*Thisform.cmbPayment.Value = ''
			*Thisform.cmbFrtPayment.Value = ''
			*Thisform.SHIPROUTE.Value = ''
				
			RETURN &&useSoldCode
		ENDIF
		
		****************************************************
		IF UPPER(pWhat) = "SAVE"
			*SAVE
			PRIVATE	nMaxSoldCode, nmaxSoldCode, nOldSoldCode, nUseSoldCode, lSaveAddr1
			PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit,lnSoldAddr,lcInsrtct
			PRIVATE lcContact,lcPhone,lcFax,lcEmail, lcMarketing
			PRIVATE lcCustomer  &&, llBlind, lcPayment, lcFrtPayment, lcShipRoute
			PRIVATE mHoldRecordNum
			nMaxSoldCode = 0
			lSaveAddr1 = .F.
			nOldSoldCode = 0
			nUseSoldCode = 0
			
			*ShowSQLtxt("Space Alloys USA'",'Company',25)
			lcCompany =PrepareSQLtxt(Thisform.COMPANY1.VALUE,'Company',100)
			lcAddr1 = PrepareSQLtxt(Thisform.ADDR11.VALUE,'Addr1',100)
			lcAddr2 = PrepareSQLtxt(Thisform.ADDR21.VALUE,'Addr2',100)
			lcCity  = PrepareSQLtxt(Thisform.CITY1.VALUE,'City',100)
			lcST    = PrepareSQLtxt(Thisform.ST1.VALUE,'State',50)
			lcZip   = PrepareSQLtxt(Thisform.ZIP1.VALUE,'Zip',50)
			lcCountry = UPPER(ALLTRIM(PrepareSQLtxt(Thisform.COUNTRY1.VALUE,'Country',50)))
			lcMarketing = PrepareSQLtxt(Thisform.Marketing1.VALUE,'Marketing',100)
			lcContact = PrepareSQLtxt(Thisform.CONTACT1.VALUE,'Contact',100)
			lcPhone = PrepareSQLtxt(Thisform.TELEPHONE1.VALUE,'Phone',50)
			lcFax	 = PrepareSQLtxt(Thisform.FAX_NUMBER1.VALUE,'Fax',12)
			lcEmail = PrepareSQLtxt(Thisform.EMAIL1.VALUE,'Email',60)
			*lcCustomer, llBlind, lcPayment, lcFrtPayment, lcShipRoute, lcInsrtct
			lcCustomer	= PrepareSQLtxt(Thisform.CUSTOMER1.VALUE,'Customer',20)
			*llBlind		= PrepareSQLlogic(Thisform.chkBlind.Value,'Blind')
			*lcPayment	= PrepareSQLtxt(ThisForm.cmbPayment.Value,'Payment',10)
			*lcFrtPayment= PrepareSQLtxt(ThisForm.cmbFrtPayment.Value,'FrtPayment',12)
			*lcShipRoute	= PrepareSQLtxt(Thisform.ShipRoute.Value,'ShipRoute',50)
			*lcInsrtct	= PrepareSQLtxt(ThisForm.txtInstrct.Value,'Inscrt',100)
			
			*Thisform.CUSTOMER1
			ldLastEdit = DATE()
			lnSoldAddr = PrepareSQLnum(ThisForm.SoldCode1.Value,'SoldAddr',-3)
			lSaveAddress = .F.
		
			** Do you have anything to save?
			IF NOT LEN(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))=0
				lSaveAddress = .T.
			ENDIF
		
			IF LEN(ALLTRIM(lcCompany))=0
				MESSAGEBOX("Cannot save without an Company name!")
				lSaveAddress = .F.
			ENDIF
			
			PRIVATE lOK
			lOK = .T.
			
			IF lSaveAddress 
				IF USED( 'delSoldAddr' )
					USE IN delSoldAddr
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.SoldAddr WITH(NOLOCK) "
				cSQL = cSQL + " WHERE "
				cSQL = cSQL + "Company = '"+lcCompany+"' AND "
				cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
				cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
				cSQL = cSQL + "City = '"+lcCity+"' AND "
				cSQL = cSQL + "ST = '"+lcST+"' AND " 
				cSQL = cSQL + "Zip = '"+lcZip+"' AND "
				cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
				cSQL = cSQL + "Contact = '"+lcContact+"' AND "
				cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
				cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
				cSQL = cSQL + "Email = '"+lcEmail+"' "
		*		cSQL = cSQL + " AND SoldCode = "+ALLTRIM(STR(lnSoldAddr))
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'delSoldAddr' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'delSoldAddr' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "delSoldAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "delSoldAddr")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'delSoldAddr')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						lOK = .F.
					ENDIF
				ENDIF
				
				IF USED('delSoldAddr')
					IF delSoldAddr.Cnt < 1
						lSaveAddress = .T.
						
						*Override - Save as HPA Production Work
						IF lcCompany = "Space Alloys USA" OR lcCompany = "HPA "
						*	This.parent.parent.pgBillTo.txtSoldCode.Value = 1
							lnSoldAddr = 1
							lSaveAddress = .F.
						ENDIF
					ELSE
						lSaveAddress = .F.
						*Already have exact Address
						
						IF USED("tmpCntSoldCode")
							USE IN tmpCntSoldCode
						ENDIF
						
						cSQL = "SELECT SoldCode FROM dbo.SoldAddr WITH(NOLOCK)"
						cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
						cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
						cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
						cSQL = cSQL + " AND City = '"+lcCity+"'"
						cSQL = cSQL + " AND ST = '"+lcST+"'"
						cSQL = cSQL + " AND Zip = '"+lcZip+"'"
						cSQL = cSQL + " AND Country = '"+lcCountry+"'"
						cSQL = cSQL + " AND Contact = '"+lcContact+"'"
						cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
						cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
						cSQL = cSQL + " AND Email = '"+lcEmail+"'"
					*	cSQL = cSQL + " AND SoldCode = "+ALLTRIM(STR(lnSoldAddr))
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntSoldCode')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCntSoldCode')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSoldCode")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSoldCode")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCntSoldCode')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								lOK = .F.
							ENDIF
						ENDIF
						
						IF USED("tmpCntSoldCode")
							IF VARTYPE(tmpCntSoldCode.SoldCode) = 'N'
								lnSoldAddr = tmpCntSoldCode.SoldCode
								ThisForm.SoldAddr = lnSoldAddr
							*	REPLACE pSoldAddr WITH ThisForm.SoldAddr IN Sales_No
							ENDIF
							USE IN tmpCntSoldCode
						ENDIF
							
							
						*****
						IF lOK
							IF ThisForm.SoldAddr = 0
		
								*Find the SoldCode and display it
								IF USED( 'SoldCodeSoldAddr' )
									USE IN SoldCodeSoldAddr
								ENDIF
								
								PRIVATE cSQL, nSQLEXEC
								cSQL = "SELECT SoldCode FROM dbo.SoldAddr WITH(NOLOCK) "
								cSQL = cSQL + " WHERE "
								cSQL = cSQL + "Company = '"+lcCompany+"' AND "
								cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
								cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
								cSQL = cSQL + "City  = '"+lcCity+"' AND "
								cSQL = cSQL + "ST    = '"+lcST+"' AND " 
								cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
								cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
								cSQL = cSQL + "Contact = '"+lcContact+"' AND "
								cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
								cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
								cSQL = cSQL + "Email = '"+lcEmail+"'"
								
								SELECT 0
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldCodeSoldAddr' )
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldCodeSoldAddr' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldCodeSoldAddr")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldCodeSoldAddr")
											
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SoldCodeSoldAddr')
										RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
										lOK = .F.
									ENDIF
								ENDIF
		
								IF USED('SoldCodeSoldAddr')
									IF SoldCodeSoldAddr.SoldCode > 0
										ThisForm.SoldAddr = SoldCodeSoldAddr.SoldCode
										ThisForm.SoldCode1.REFRESH
										*REPLACE pSoldAddr WITH ThisForm.SoldAddr IN Sales_No
										
										*ThisForm.Set_Sales_No_Chng()
										
									ENDIF
									USE IN SoldCodeSoldAddr
								ENDIF
							ENDIF  &&EMPTY(ThisForm.SoldAddr)
						ENDIF &&lOK
						
					ENDIF &&delSoldAddr.Cnt
					
					USE IN delSoldAddr
				ELSE &&USE IN delSoldAddr
					lSaveAddress = .F.
				ENDIF
			ENDIF &&IF lSaveAddress
			
			*****
			
			IF lSaveAddress AND lOK
				PRIVATE	cSaveNew
		
				IF lnSoldAddr > 0
					nSaveNew = MESSAGEBOX("Save as new Address?"+CHR(13)+;
					"Answer 'YES' to save as new address"+CHR(13)+;
					"when the Company has moved or"+CHR(13)+;
					"when this is a different address location."+CHR(13)+CHR(13)+;
					"Answer 'No' if you are correcting typeing error.";
					,4+32,"New Address?")
					
					IF nSaveNew = 7 && No
						IF USED( 'cntSales_No' )
							USE IN cntSales_No
						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.Sales_No WITH(NOLOCK) "
						cSQL = cSQL + " WHERE pSoldAddr= "+STR(lnSoldAddr )
						cSQL = cSQL + " AND Sales_No.CNCLD = 0 AND Sales_No.CMPLT = 0"
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_No' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSales_No' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_No")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_No")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSales_No')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								lOK = .F.
							ENDIF
						ENDIF
						IF USED('cntSales_No')
							IF cntSales_No.cnt > 0
								
								MESSAGEBOX("There are Orders that have not shipped that will be changed!"+CHR(13)+CHR(13)+;
								ALLTRIM(STR(cntSales_No.cnt))+" unshipped Order(s) use the Address number "+;
								ALLTRIM(STR(lnSoldAddr))+".",0+16,"CAUTION")
								
							ENDIF
		
							USE IN cntSales_No
						ENDIF
						
						*SELECT Sales_No	&&Sales_No does not have items detail
						*REPLACE pSoldAddr WITH lnSoldAddr IN Sales_No
						
						ThisForm.SoldAddr = lnSoldAddr 
						*REPLACE pSoldAddr WITH ThisForm.SoldAddr IN Sales_No
					ENDIF
					
		
				ELSE
					**No SoldAddr- must save as new!
					nSaveNew = 6
				ENDIF
		
				IF nSaveNew = 6 AND lOK	&& Yes, save as new
					****** big save procedure********
					IF ThisForm.SoldAddr > 0 &&Check old SoldCode to see if anything changed.
						*Check old SoldCode to see if anything changed
						IF USED( 'cntSoldAddr' )
							USE IN cntSoldAddr
						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS cnt FROM dbo.SoldAddr WITH(NOLOCK) "
						cSQL = cSQL + " WHERE "
						cSQL = cSQL + "Company = '"+lcCompany+"' AND "
						cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
						cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
						cSQL = cSQL + "City  = '"+lcCity+"' AND "
						cSQL = cSQL + "ST    = '"+lcST+"' AND " 
						cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
						cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
						cSQL = cSQL + "Contact = '"+lcContact+"' AND "
						cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
						cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
						cSQL = cSQL + "Email = '"+lcEmail+"' "
		*				cSQL = cSQL + " AND SoldCode = "+STR(ThisForm.SoldAddr)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSoldAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSoldAddr' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSoldAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSoldAddr")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSoldAddr')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								lOK = .F.
							ENDIF
						ENDIF
						IF USED('cntSoldAddr')
							IF cntSoldAddr.Cnt = 0
		*						*-no change - do not save
								*Did not find - Save
								lSaveAddr1 = .T.
								nOldSoldCode = ThisForm.SoldCode1.Value
							ELSE 
								*Found match - do not need to save
								lSaveAddr1 = .F.
							ENDIF
						ELSE &&failed - add as new
							lSaveAddr1 = .T.
						ENDIF 
						
					ELSE && No SoldCode - add if have data
						IF LEN( ALLTRIM(ThisForm.COMPANY1.VALUE + ThisForm.ADDR11.VALUE)) > 1
							lSaveAddr1 = .T.
						ELSE
							*No Company or Address to save! Clear!!!
							lSaveAddr1 = .F.
						ENDIF
					ENDIF
		
					IF lSaveAddr1 AND lOK
						WAIT WINDOW "Saving 'Sold To' address." NOWAIT
		
		
						IF nUseSoldCode = 0 &&need to find a SoldCode
							*			Get next code nMaxSoldCode
		
							*nMaxSoldCode = ThisForm.maxSoldCode()
							*nMaxSoldCode = ThisForm.maxSoldCode()
							nMaxSoldCode = get_MaxSoldCode()
							*nUseSoldCode = MAX( nMaxSoldCode, nMaxSoldCode )
		
						ENDIF
						IF nUseSoldCode > 0 &&Save here
							ThisForm.SoldAddr = nUseSoldCode
							*REPLACE pSoldAddr WITH ThisForm.SoldAddr IN Sales_No
							ThisForm.SoldCode1.VALUE = nUseSoldCode
		*					THIS.PARENT.numSoldAddr.VALUE = nUseSoldCode
							lnSoldAddr = nUseSoldCode
							
							*Save_SoldAddrCode(nUseSoldCode, "SoldAddr", nOldSoldCode, ThisForm.nConnHandle)
						
							PRIVATE cSQLi
							cSQLi = "INSERT INTO dbo.SoldAddr (SoldCode, Company, Addr1, Addr2, City, ST, Zip, Country"
							cSQLi = cSQLi+",Marketing, Contact, Telephone, Fax_Number, Email, Customer, LastEdit) VALUES "
							cSQLi = cSQLi+"("+STR(nUseSoldCode)+""
							cSQLi = cSQLi+",'"+lcCompany+"'"
							cSQLi = cSQLi+",'"+lcAddr1+"'"
							cSQLi = cSQLi+",'"+lcAddr2+"'"
							cSQLi = cSQLi+",'"+lcCity+"'"
							cSQLi = cSQLi+",'"+lcST+"'"
							cSQLi = cSQLi+",'"+lcZip+"'"
							cSQLi = cSQLi+",'"+lcCountry+"'"
							cSQLi = cSQLi+",'"+lcMarketing+"'"
							cSQLi = cSQLi+",'"+lcContact+"'"
							cSQLi = cSQLi+",'"+lcPhone+"'"
							cSQLi = cSQLi+",'"+lcFax+"'"
							cSQLi = cSQLi+",'"+lcEmail+"'"
							cSQLi = cSQLi+",''"		&&+ALLTRIM(STR(nUseSoldCode,10,0))+""
							cSQLi = cSQLi+",'"+DTOC(DATE())+"' )"
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi)
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
										
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQLi ,ThisForm.nConnHandle, nSQLEXEC ,'')
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
									lOK = .F.
								ENDIF
							ENDIF
							
		
							******************
							IF lOK
								ThisForm.LastEdit.VALUE = DATE()
								ThisForm.LastEdit.REFRESH
							ENDIF
						ENDIF
						WAIT CLEAR
					ENDIF
				ELSE   &&IF nSaveNew = 6 && Yes
					*Save - not as new!
					*REPLACE DATA
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.SoldAddr SET "
					cSQLu= cSQLu+" Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",Marketing='"+lcMarketing+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
					cSQLu= cSQLu+",Customer="+ALLTRIM(STR(nUseSoldCode,10,0))+""
					cSQLu= cSQLu+",LastEdit='"+DTOC(DATE())+"'"
					cSQLu= cSQLu+" WHERE SoldAddr.SoldCode = "+STR(lnSoldAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
							lOK = .F.
						ENDIF
					ENDIF
						
					IF lOK
		*				ThisForm.UpdateCustID = .T.
						ThisForm.LastEdit.VALUE = DATE()
						ThisForm.LastEdit.REFRESH
					ENDIF
				ENDIF  &&  &&IF nSaveNew = 6 && Yes
				
				
				IF lOK AND lnSoldAddr > 0
				*Update the Rest of the Fields
					**lcCustomer, llBlind, lcPayment, lcFrtPayment, lcShipRoute, lcInsrtct
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.SoldAddr SET "
					cSQLu= cSQLu+" Customer='"+lcCustomer+"'"
					*cSQLu= cSQLu+",Blind="+IIF(llBlind,'1','0')+""
					*cSQLu= cSQLu+",PayType='"+lcPayment+"'"
					*cSQLu= cSQLu+",ShipPay='"+lcFrtPayment+"'"
					*cSQLu= cSQLu+",ShipRoute='"+lcShipRoute+"'"
					*cSQLu= cSQLu+",instrct='"+lcInsrtct+"'"
					
					cSQLu= cSQLu+" WHERE SoldAddr.SoldCode = "+STR(lnSoldAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
							lOK = .F.
						ENDIF
					ENDIF
					
				ENDIF	
			ENDIF &&IF lSaveAddress
		
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		IF USED('SoldAddr')	
			USE IN SoldAddr
		ENDIF
		
	ENDPROC

	PROCEDURE cmdAll.Click
		ThisForm.GetAllRecords()
	ENDPROC

	PROCEDURE cmdDuplicates.Click
		IF soldaddr.soldcode > 1001
			DO FORM Forms\RemoveDuplicate WITH 'SoldAddr',soldaddr.soldcode
		ELSE
			MESSAGEBOX("Cannot change this Address!",16,"Edit Denied")
		ENDIF
		
	ENDPROC

	PROCEDURE cmdIND_Type.Click
		IF soldaddr.soldcode > 1001
			DO FORM Forms\IND_Type WITH soldaddr.soldcode,'SoldAddr'
		ELSE
			MESSAGEBOX("Cannot change this Address!",16,"Edit Denied")
		ENDIF
		
	ENDPROC

	PROCEDURE cmdMarkSalesPCustomer.Click
		PRIVATE nSoldAddr,cCustID,cSalesP
		nSoldAddr = PrepareSQLnum(SoldAddr.SoldCode,'SoldAddr',-3)
		cCustID	= PrepareSQLtxt(ThisForm.CUSTOMER1.Value,'CustID',20)
		
		cSalesP	= ''
		IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			cSalesP = m.SalesP
		ENDIF
		
		IF nSoldAddr > 0 AND NOT EMPTY(cSalesP)
		
			DO FORM Forms\SalesP_Customer WITH nSoldAddr, cSalesP, SoldAddr.Company, cCustID
			
			PRIVATE cSalesPs
			cSalesPs = getSalesP_Customer( nSoldAddr, ThisForm.nConnHandle )
			ThisForm.lblSalesP_Customer.Caption = cSalesPs
		
		ELSE
			MESSAGEBOX("Could not Open",48,"No SalesP")
		ENDIF
	ENDPROC

	PROCEDURE cmdSearchSoldTo.Click
		Private lcCurrTable 
		lcCurrTable = ALIAS()
		
		IF ThisForm.cmdAll.Visible
			ThisForm.GetAllRecords()
		ENDIF
		
		DO FORM Forms\SearchForm WITH "SoldAddr",soldaddr.company  TO nNewSoldToCode
		
		IF USED('TmpSearch')
			USE IN TmpSearch
		EndIF
		
		SELECT SoldAddr
		
		IF nNewSoldToCode > 0
			LOCATE FOR SoldCode = nNewSoldToCode 
			ThisForm.Refresh
		ENDIF
	ENDPROC

	PROCEDURE LBLCUSTOMER1.Click
		lcCurrTable = ALIAS()
		
		PRIVATE cCompany,nSoldAddr,cCustomerID
		cCompany = PrepareSQLtxt(SalesQuote.Company,'Company',30)
		nSoldAddr = PrepareSQLnum(ThisFormSet.SoldAddr,'SoldAddr',-3)
		
		DO FORM Forms\Select_CustomerID WITH "SoldAddr",cCompany,nSoldAddr,ThisFormSet.nConnHandle  TO cCustomerID
		
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF VARTYPE(cCustomerID)="C"
			IF NOT EMPTY(cCustomerID)
				*This.Caption = cCustomerID 
				This.Parent.CUSTOMER1.Value = cCustomerID
		
		
				PRIVATE cSQLu
				cSQLu= "UPDATE dbo.SoldAddr SET "
				cSQLu= cSQLu+" Customer="+cCustomerID+"'"
				cSQLu = cSQLu+",LastEdit='"+DTOC(DATE())+"'"
				cSQLu = cSQLu+" WHERE SoldCode = "+STR(nSoldAddr)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
				ENDIF
		
				ThisForm.RefreshTable( RECNO(SoldAddr) )
		
				
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE Txtbtns1.cmdAdd.Click
		#DEFINE OPT_CANCEL			0
		#DEFINE OPT_ADD_PARENT		1
		#DEFINE OPT_ADD_CHILD		2
		#DEFINE OPT_ADD_BOTH		3
		#DEFINE MB_Q_YESNO			36
		#DEFINE MB_A_YES			6
		#DEFINE C_KEYFLDNOUPDATE_LOC	"The field relating the grid's view to the parent data source is not updatable. "+;
			"Do you just want to add a new record to the parent table?"
		#DEFINE C_BADCHILDKEY_LOC		"The fields relating the parent and child tables are not the same data type. "+;
			"Do you just want to add a new record to the parent table?"
		#DEFINE C_NOCHILDUPDATE_LOC		"The child data source is a view and does not send updates. "+;
			"Do you just want to add a new record to the parent table?"
		#DEFINE C_NOOBJ_LOC		"Failed create the Add Record form class. Check or reinstall your WIZSTYLE.VCX file."
		#DEFINE C_NOUPDATE_LOC	"You cannot add a new record because the view(s) selected does not send updates."
		#DEFINE C_NOUPDATE2_LOC	"You cannot add a new record because the view(s) selected does not send updates and the child data source has a primary key."
		
		LOCAL oSearchDlog,oAddRec,cChildAlias,cPapaAlias,i,lPrimeKey
		LOCAL cPapaKey,cChildKey,nSaveSess,oRel,cTagName,lBadViewKey,nSaveRec,nSaveRec2
		LOCAL lBadChildKey,lUpdatableParentKey,lNoSendParentUpdates,lNoSendChildUpdates
		
		DO CASE
		CASE THIS.Parent.EditMode
		
			** Code for saving record
			*THIS.Parent.UpdateRows()
			ThisForm.SaveAdd("Save")
		
		CASE EMPTY(THIS.Parent.GridRef)		&& not using Grid object
		
			** Code for adding record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
		*	APPEND BLANK
			ThisForm.SaveAdd("Add")
		OTHERWISE
		
			** Code for adding record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
			lPrimeKey = .F.					&&is child key primary index
			
			ThisForm.SaveAdd("Add")
		
		ENDCASE
		
		ThisForm.cmdAll.Enabled = .T.
		
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = THIS.Parent.EditMode
		THIS.Parent.TopFile = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		
		ThisForm.RecordMoved()
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE Txtbtns1.cmdAdd.Valid
		DODEFAULT( ) 
		PRIVATE maxSoldCode
		
		IF This.Caption = "\<Save"
			IF EMPTY(ThisForm.SOLDCODE1.Value)
				*maxSoldCode = THISFORM.maxSoldCode()
				MaxSoldCode=get_MaxSoldCode()
		
				ThisForm.SOLDCODE1.Value = maxSoldCode
			ENDIF
			ThisForm.LastEdit.Value = DATE()
		ENDIF
		
	ENDPROC

	PROCEDURE Txtbtns1.cmdDelete.Click
		PRIVATE nSoldCode
		nSoldCode = ThisForm.SOLDCODE1.Value
		
		IF nSoldCode < 10
			MESSAGEBOX( 'You cannot delete this Address Standard.',16,'Not allowed')
			RETURN
		ENDIF
		
		IF Count_pSoldAddrinSales_No( nSoldCode ,ThisForm.nConnHandle) > 0
			MESSAGEBOX( 'You cannot delete this Address!'+CHR(13)+"This address has a SalesOrder history to it!",16,'Not allowed')
			RETURN
		ENDIF
			
			*See if a filter was used to refilter.
			PRIVATE m.cGetExpr
			m.cGetExpr = ""
			cGetExpr = SET('FILTER')
			
		PRIVATE nSQLEXEC, cSQL
		cSQL = "DELETE FROM dbo.SoldAddr WHERE SoldCode = "+STR(nSoldCode)
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
			RETURN .F.
		ENDIF
		
		WAIT WINDOW 'Deleted ShipCode = '+ALLTRIM(STR(nShipCode))+'!'
		
		
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM dbo.SoldAddr "
		cSQL = cSQL + " ORDER BY Company"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SoldAddr' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SoldAddr' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SoldAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'SoldAddr')
		ENDIF
		
		IF !EMPTY(m.cGetExpr)
			SET FILTER TO &cGetExpr
			LOCATE
			IF EOF() &&Last of Filter!
				SET FILTER TO
			ENDIF
		ENDIF
		
		THIS.Parent.ButtonRefresh()
		
		ThisForm.RecordMoved()
		THIS.Parent.NavRefresh()
		
		
		
		
	ENDPROC

	PROCEDURE Txtbtns1.CMDEDIT.Click
		** Reverting record
		IF THIS.Parent.EditMode
			
			
			* Go back to original place
			SELECT (THIS.Parent.OldAlias)
			IF RECCOUNT() < THIS.Parent.OldRec	&&added record at EOF()
				GO TOP
			ELSE
				GO THIS.Parent.OldRec
			ENDIF
			
			ThisForm.cmdAll.Enabled = .T.
		ELSE
		
			* Check to see if view allows updates
		
			
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
			
			
			ThisForm.cmdAll.Enabled = .F.
		ENDIF
		
		** Editing record
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		ThisForm.RecordMoved()
		THIS.Parent.NavRefresh()
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE Txtbtns1.CMDEND.Click
		DODEFAULT()
		ThisForm.RecordMoved()
	ENDPROC

	PROCEDURE Txtbtns1.CMDFIND.Click
		DODEFAULT()
		ThisForm.RecordMoved()
	ENDPROC

	PROCEDURE Txtbtns1.cmdNext.Click
		DODEFAULT()
		ThisForm.RecordMoved()
	ENDPROC

	PROCEDURE Txtbtns1.CMDPREV.Click
		DODEFAULT()
		ThisForm.RecordMoved()
	ENDPROC

	PROCEDURE Txtbtns1.CMDTOP.Click
		DODEFAULT()
		ThisForm.RecordMoved()
	ENDPROC

ENDDEFINE
