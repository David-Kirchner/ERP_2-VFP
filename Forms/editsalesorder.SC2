			RETURN .F.
		ENDI
		*ThisFormSet.Refresh_pgBillTo()
				
		ThisFormSet.frmPO.Visible = .F.
		ThisFormSet.frmPO.AlwaysOnTop = .F.
		ThisFormSet.frmEoP.Visible = .F.
		
		This.chkIntP.SetFocus()
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		
		*This.Caption = "Clear"
		*This.Caption = "Cancel"
		
		
		IF ThisFormSet.SoldAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
		ENDIF
		
		IF This.Caption = "Clear" 
			IF lcMessAns = 6 &&Yes
				*Clear Address
				This.Caption = "Cancel"
				*ThisFormSet.Address_Screen("SoldToEdit")
				ThisFormSet.Address_Screen("SoldToSave")
				
				THIS.PARENT.cmdSearchSoldTo.ENABLED = .T.
		
				THIS.PARENT.txtCompany.VALUE	= ""
				THIS.PARENT.txtAddr1.VALUE		= ""
				THIS.PARENT.txtAddr2.VALUE		= ""
				THIS.PARENT.txtCity.VALUE		= ""
				THIS.PARENT.txtST.VALUE			= ""
				THIS.PARENT.txtZip.VALUE		= ""
				THIS.PARENT.txtCountry.VALUE	= ""
				THIS.PARENT.txtMarketing.Value	= ""
				THIS.PARENT.txtMarketing.BackColor = RGB(255,255,128)
				THIS.PARENT.txtContact.VALUE	= ""
				THIS.PARENT.txtPhone.VALUE		= ""
				THIS.PARENT.txtFax.VALUE		= ""
				THIS.PARENT.txtEmail.VALUE		= ""
				THIS.PARENT.txtLastEdit.VALUE	= ""
				
				SELECT Sales_No	&&Sales_No does not have items detail
				REPLACE pSoldAddr WITH 0 IN Sales_No
					
				ThisFormSet.SoldAddr = 0
				THIS.PARENT.txtSoldCode.VALUE = 0
				REPLACE pSoldAddr WITH ThisFormSet.SoldAddr IN Sales_No
			ENDIF
			
		ELSE
			*This.Caption = "Cancel"
			This.Caption = "Clear"
			ThisFormSet.Address_Screen("SoldToEdit")
			
			IF THIS.PARENT.cmdEditSoldTo.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
		
					IF USED( 'aSoldAddr' )
						USE IN aSoldAddr
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK)"
					cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(ThisFormSet.SoldAddr)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSoldAddr')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
					
					*Abort
					IF USED('aSoldAddr')
						*ThisFormSet.SoldAddr = aSoldAddr( 1, 1 )
						THIS.PARENT.txtSoldCode.VALUE = aSoldAddr.SoldCode
						THIS.PARENT.txtCompany.VALUE = aSoldAddr.Company
						THIS.PARENT.txtAddr1.VALUE = aSoldAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE = aSoldAddr.Addr2
						THIS.PARENT.txtCity.VALUE = aSoldAddr.City
						THIS.PARENT.txtST.VALUE = aSoldAddr.ST
						THIS.PARENT.txtZip.VALUE = aSoldAddr.Zip
						THIS.PARENT.txtCountry.VALUE = UPPER(ALLTRIM(aSoldAddr.Country))
						THIS.PARENT.txtMarketing.Value = PrepareSQLtxt(aSoldAddr.Marketing,'Marketing',100)
						THIS.PARENT.txtMarketing.BackColor = RGB(255,255,255)
						THIS.PARENT.txtContact.VALUE = aSoldAddr.Contact
						THIS.PARENT.txtPhone.VALUE = aSoldAddr.Telephone
						THIS.PARENT.txtFax.VALUE = aSoldAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE = aSoldAddr.Email
						THIS.PARENT.txtLastEdit.VALUE = IIF(EMPTY(PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit'))
					
						USE IN aSoldAddr
					ENDIF
					
					ThisFormSet.Address_Screen("SoldToEdit")
		
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.cmdCustomerID.Click
		PRIVATE cCustomerID, cCompany
		cCustomerID = PrepareSQLtxt(ThisForm.Caption,'CustID',20,.F.,.T.) &&Always over 20 char
		cCompany	= PrepareSQLtxt(SalesQuote.company,'Company',30)
		
		PRIVATE lcCurrTable 
		lcCurrTable = ALIAS()
		
		PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.F.
		ENDIF
		lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.F.
		ENDIF
		PRIVATE cCustID
		DO FORM Forms\Select_CustomerID WITH "SoldAddr",cCompany,ThisFormSet.SoldAddr,ThisFormSet.nConnHandle TO cCustID
		
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.T.
		ENDIF
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.T.
		ENDIF
		
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT LEN(ALLTRIM(lcCurrTable))=0
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF VARTYPE(cCustID)="C"
			IF NOT LEN(ALLTRIM(cCustID))=0
				This.Caption = cCustID
				
				PRIVATE nCurrentRec 
				nCurrentRec = RECNO('SalesQuote')
				SELECT SalesQuote
				REPLACE ALL CustID WITH cCustID
				GOTO (nCurrentRec)
				
				This.parent.parent.pgOrder.txtCustID.Value = cCustID
				
				IF NOT SaveCustID_AllQuotes(cCustID, SalesQuote.SalesNum, ThisFormSet.nConnHandle )
					MESSAGEBOX("Could not save Customer ID:'"+ALLTRIM(cCustID)+"' to the Quote.",48,"You may get a AR Call.")
					TrackError("Could not save Customer ID:'"+ALLTRIM(cCustID)+"' to the Quote. SalesNum="+STR(SalesQuote.SalesNum),"Could not save Customer ID", PROGRAM(), LINENO(1))
				ENDIF
				
				IF ThisFormSet.SoldAddr > 0
					SaveCustomer_SoldAddr(cCustID, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle )
				ENDIF
				
			ELSE
				PRIVATE cMess, nMess
				IF cCustomerID <> cCustID
				
					cMess = "Do you want to replace "+ALLTRIM(cCustomerID)+" with BLANK"
					nMess = MESSAGEBOX(cMess,4+32,"Empty")
					IF nMess = 6
						IF NOT SaveCustID_AllQuotes("", SalesQuote.SalesNum, ThisFormSet.nConnHandle )
							MESSAGEBOX("Could not save Customer ID:'"+ALLTRIM(cCustID)+"' to the Quote.",48,"You may get a AR Call.")
							TrackError("Could not save Customer ID:'"+ALLTRIM(cCustID)+"' to the Quote. SalesNum="+STR(SalesQuote.SalesNum),"Could not save Customer ID", PROGRAM(), LINENO(1))
						ELSE
							This.Caption = ''
							MESSAGEBOX("All Quotes records with the Company name of"+CHR(13)+cCompany+CHR(13)+"now has NO Accouting Code."+CHR(13)+CHR(13)+"Please conect back if this was in ERROR",0+64,"Saved to All the Quotes")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ELSE
			This.Caption = 'Get CustID'  &&Instruct user to Click to GET!
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.cmdEditSoldTo.Click
		
		*THIS.CAPTION = "Save"
		*THIS.CAPTION = "Edit"
		
		PRIVATE	nMaxSoldCode, nMaxShipCode, nOldSoldCode, lSaveAddr1
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,lcMarketing,ldLastEdit,lnSoldAddr
		PRIVATE lcContact,lcPhone,lcFax,lcEmail,lcCustID
		PRIVATE lSave_ShipAddrCode
		lSave_ShipAddrCode = .T.
		
		nMaxSoldCode = 1000
		
		*ShowSQLtxt("Space Alloys USA'",'Company',25)
		lcCompany =PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',100)
		lcAddr1 = PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',100)
		lcAddr2 = PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',100)
		lcCity  = PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',100)
		lcST    = PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'State',50)
		lcZip   = PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',50)
		lcCountry = UPPER(ALLTRIM(PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',50)))
		lcMarketing = PrepareSQLtxt(THIS.PARENT.txtMarketing.VALUE,'Marketing',100)
		lcContact = PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',100)
		lcPhone = PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',50)
		lcFax	 = PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
		lcEmail = PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
		ldLastEdit = DATE()
		lnSoldAddr = ThisFormSet.SoldAddr
		lcCustID = PrepareSQLtxt(This.Parent.cmdCustomerID.Caption,'CustID',20)
		IF UPPER(lcCustID) = "GET C"
			lcCustID = STR(lnSoldAddr)
		ENDIF
		
		lSaveAddr1 = .F.
		lSaveAddress = .F.
		nOldSoldCode = 0
		PRIVATE	nSaveNew
		nSaveNew = 0
		
		IF THIS.CAPTION = "Save"
			** Do you have anything to save?
			IF NOT LEN(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))=0
				lSaveAddress = .T.
			ENDIF
		
			IF LEN(ALLTRIM(lcCompany))=0
				MESSAGEBOX("Cannot save without an Company name!",0,'')
				lSaveAddress = .F.
				RETURN .F.
			ENDIF
			
			*Check Data
			
			IF USED("cntSoldCode")
				USE IN cntSoldCode
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.SoldAddr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
			cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
			cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
			cSQL = cSQL + " AND City = '"+lcCity+"'"
			cSQL = cSQL + " AND ST = '"+lcST+"'"
			cSQL = cSQL + " AND Zip = '"+lcZip+"'"
			cSQL = cSQL + " AND Country = '"+lcCountry+"'"
		*	cSQL = cSQL + " AND Marketing ='"+lcMarketing+"'"
			cSQL = cSQL + " AND Contact = '"+lcContact+"'"
			cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
			cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
			cSQL = cSQL + " AND Email = '"+lcEmail+"'"
		*	cSQL = cSQL + " AND SoldCode = "+STR(lnSoldAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntSoldCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSoldCode')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSoldCode")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSoldCode")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntSoldCode')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED("cntSoldCode")
				IF cntSoldCode.cnt = 0
					lSaveAddress = .T.
				ELSE
					lSaveAddress = .F.
					*Already have exact Address
					
					IF USED("tmpCntSoldCode")
						USE IN tmpCntSoldCode
					ENDIF
					
					cSQL = "SELECT SoldCode FROM dbo.SoldAddr WITH(NOLOCK)"
					cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
					cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
					cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
					cSQL = cSQL + " AND City = '"+lcCity+"'"
					cSQL = cSQL + " AND ST = '"+lcST+"'"
					cSQL = cSQL + " AND Zip = '"+lcZip+"'"
					cSQL = cSQL + " AND Country = '"+lcCountry+"'"
					*cSQL = cSQL + " AND Marketing ='"+lcMarketing+"'"
					cSQL = cSQL + " AND Contact = '"+lcContact+"'"
					cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
					cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
					cSQL = cSQL + " AND Email = '"+lcEmail+"'"
				*	cSQL = cSQL + " AND SoldCode = "+STR(lnSoldAddr)
				
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCntSoldCode')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntSoldCode')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntSoldCode")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntSoldCode")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
		
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCntSoldCode')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
					
					IF USED("tmpCntSoldCode")
						IF VARTYPE(tmpCntSoldCode.SoldCode) = 'N'
							lnSoldAddr = tmpCntSoldCode.SoldCode
							ThisFormSet.SoldAddr = lnSoldAddr 
							REPLACE pSoldAddr WITH ThisFormSet.SoldAddr IN Sales_No
						ENDIF
						USE IN tmpCntSoldCode
					ENDIF
						
						
					*****
				
					IF EMPTY(ThisFormSet.SoldAddr)
						*Find the SoldCode and display it
		
						IF USED("delSoldCode")
							USE IN delSoldCode
						ENDIF
						
						cSQL = "SELECT SoldCode FROM dbo.SoldAddr WITH(NOLOCK)"
						cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
						cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
						cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
						cSQL = cSQL + " AND City = '"+lcCity+"'"
						cSQL = cSQL + " AND ST = '"+lcST+"'"
						cSQL = cSQL + " AND Zip = '"+lcZip+"'"
						cSQL = cSQL + " AND Country = '"+lcCountry+"'"
						cSQL = cSQL + " AND Contact = '"+lcContact+"'"
						cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
						cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
						cSQL = cSQL + " AND Email = '"+lcEmail+"'"
						*cSQL = cSQL + " AND SoldCode = "+STR(lnSoldAddr)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'delSoldCode')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'delSoldCode')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delSoldCode")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delSoldCode")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'delSoldCode')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							ENDIF
						ENDIF
		
						IF USED('delSoldCode')
							ThisFormSet.SoldAddr = delSoldCode.SoldCode
							REPLACE pSoldAddr WITH ThisFormSet.SoldAddr IN Sales_No
							
							ThisFormSet.Set_Sales_No_Chng()
							
							THIS.PARENT.txtSoldCode.Value = delSoldCode.SoldCode
							THIS.PARENT.txtSoldCode.REFRESH
							
							USE IN delSoldCode
							
						ENDIF
					ELSE
						
						*Not changed
					ENDIF
				ENDIF
				
				IF USED("cntSoldCode")
					USE IN cntSoldCode
				ENDIF
			ELSE
				lSaveAddress = .F.
			ENDIF
			
			IF lSaveAddress
				****** big save procedure********
				
				IF lnSoldAddr > 0
					nSaveNew = MESSAGEBOX("Save as new Address?"+CHR(13)+;
					"Answer 'YES' to save as new address"+CHR(13)+;
					"when the Company has moved or"+CHR(13)+;
					"when this is a different address location."+CHR(13)+CHR(13)+;
					"Answer 'No' if you are correcting typeing error.";
					,4+32,"New Address?")
					
					IF nSaveNew = 7 && No
						IF USED("cntSales_No")
							USE IN cntSales_No
						ENDIF
						
						cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.Sales_No  WITH(NOLOCK)"
						cSQL = cSQL + " WHERE PShipAddr = "+STR(lnSoldAddr )
						cSQL = cSQL + " and Sales_No.CNCLD = 0 AND Sales_No.CMPLT = 0"
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntSales_No')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSales_No')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSales_No")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSales_No")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntSales_No')
								RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
							ENDIF
						ENDIF
		
						IF USED('cntSales_No')
							IF cntSales_No.Cnt > 0
								MESSAGEBOX("There are Orders that have not shipped that will be changed!"+CHR(13)+CHR(13)+;
								ALLTRIM(STR(cntSales_No.Cnt))+" unshipped Order(s) use the Address number "+;
								ALLTRIM(STR(lnSoldAddr ))+".",0+16,"CAUTION")
							ENDIF
							ThisFormSet.SoldAddr = lnSoldAddr
							REPLACE pSoldAddr WITH ThisFormSet.SoldAddr IN Sales_No
							USE IN cntSales_No
						ENDIF
					ENDIF
					IF nSaveNew = 6 && Yes
						IF MESSAGEBOX("Do you want to mark the old Address as INACTIVE ?"+CHR(13)+CHR(13)+;
							"Inactive address will not show when you search for an address."+CHR(13)+;
							"If the company has moved,"+CHR(13)+;
							"permantly leaving the address,"+CHR(13)+;
							"please mark the old address as inactive now.",4,"") = 6
							
							*Mark as InaActive
							PRIVATE cSQLu
							cSQLu= "UPDATE dbo.SoldAddr SET "
							cSQLu= cSQLu+" InActive = 1 "
							cSQLu= cSQLu+" WHERE soldcode = "+STR(lnSoldAddr)
		
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
		
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQLu ,ThisFormSet.nConnHandle, nSQLEXEC, '')
									RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLu )
								ENDIF
							ENDIF
							
						ENDIF
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					nSaveNew = 6
				ENDIF
		
				IF nSaveNew = 6 && Yes, save as new
		
					*	Get nMaxSoldCode
					*nMaxSoldCode = ThisFormSet.maxSoldCode()
					*nMaxShipCode = ThisFormSet.maxShipCode()
					nMaxSoldCode = get_MaxSoldCode()
					nMaxShipCode = get_MaxShipCode()
		
					nMaxSoldCode = MAX( nMaxSoldCode, nMaxShipCode )
					nMaxSoldCode = nMaxSoldCode + 2 &&leave space for Shipto Edits
		
					IF ThisFormSet.SoldAddr > 0
						*Check old SoldCode to see if anything changed. *if no change - do not save
						IF USED("aSoldAddr")
							USE IN aSoldAddr
						ENDIF
						
						cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK)"
						cSQL = cSQL + " WHERE SoldCode = "+STR(ThisFormSet.SoldAddr)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSoldAddr')
								RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
							ENDIF
						ENDIF
						
						IF USED('aSoldCode')
							IF aSoldAddr.soldcode = ThisFormSet.SoldAddr AND ;
									aSoldAddr.Company = lcCompany AND ;
									aSoldAddr.Addr1	= lcAddr1 AND ;
									aSoldAddr.Addr2	= lcAddr2 AND ;
									aSoldAddr.City	= lcCity AND ;
									aSoldAddr.ST		= lcST AND ;
									aSoldAddr.Zip		= lcZip AND ;
									aSoldAddr.Country	= lcCountry AND ;
									aSoldAddr.Contact	= lcContact AND ;
									aSoldAddr.Telephone	= lcPhone AND ;
									aSoldAddr.Fax_Number= lcFax AND ;
									aSoldAddr.Email		= lcEmail
								*no change - do not save
							ELSE &&did not match all Fields - Save
								lSaveAddr1 = .T.
								nOldSoldCode = ThisFormSet.SoldAddr
							ENDIF
						ELSE &&Seek failed - add as new
							lSaveAddr1 = .T.
						ENDIF
					ELSE && No SoldCode just add new if have data
						IF LEN(lcCompany+lcAddr1) > 1
							lSaveAddr1 = .T.
						ELSE
							lSaveAddr1 = .T.
						ENDIF
					ENDIF
		
		
					IF lSaveAddr1
						IF VARTYPE(nMaxSoldCode)!= "N"
							nMaxSoldCode = get_MaxShipCode()
						ENDIF
						DO WHILE FoundSoldCode( nMaxSoldCode, ThisFormSet.nConnHandle)  &&*--- yet another duplicate check
							nMaxSoldCode = nMaxSoldCode + 1
						ENDDO
						
						nOldSoldCode = lnSoldAddr
						THIS.PARENT.txtSoldCode.VALUE = nMaxSoldCode
						lnSoldAddr = nMaxSoldCode
		*				THIS.PARENT.numSoldAddr.VALUE = maxSoldCode
						ThisFormSet.SoldAddr = nMaxSoldCode
						REPLACE pSoldAddr WITH ThisFormSet.SoldAddr IN Sales_No
						This.Parent.txtSoldCode.Value = nMaxSoldCode
						
						
						lSave_ShipAddrCode = Save_ShipAddrCode(nMaxSoldCode, lcCustID, nOldSoldCode, ThisFormSet.nConnHandle)
		
						cSQLi = "INSERT INTO dbo.SoldAddr (soldcode, Company, Addr1, Addr2, City, ST, Zip, Country "
						cSQLi = cSQLi+",Marketing, Contact, Telephone, Fax_Number,Email, Customer, LastEdit "
						cSQLi = cSQLi+") VALUES ("
						cSQLi = cSQLi+" "+STR(nMaxSoldCode)
						cSQLi = cSQLi+",'"+lcCompany+"'"
						cSQLi = cSQLi+",'"+lcAddr1+"'"
						cSQLi = cSQLi+",'"+lcAddr2+"'"
						cSQLi = cSQLi+",'"+lcCity+"'"
						cSQLi = cSQLi+",'"+lcST+"'"
						cSQLi = cSQLi+",'"+lcZip+"'"
						cSQLi = cSQLi+",'"+lcCountry+"'"
						cSQLi = cSQLi+",'"+lcMarketing+"'"
						cSQLi = cSQLi+",'"+lcContact+"'"
						cSQLi = cSQLi+",'"+lcPhone+"'"
						cSQLi = cSQLi+",'"+lcFax+"'"
						cSQLi = cSQLi+",'"+lcEmail+"'"
						cSQLi = cSQLi+",'"+lcCustID+"'"
						cSQLi = cSQLi+",'"+DTOC(DATE())+"')"
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQLi,ThisFormSet.nConnHandle, nSQLEXEC, '')
							
								IF lSave_ShipAddrCode
									*nMaxSoldCode, lcCustID, nOldSoldCode
									cSQLd = "DELETE FROM dbo.ShipAddrCode "
									cSQLd = cSQLd + " WHERE shipcode = "+STR(nMaxSoldCode)
									cSQLd = cSQLd + " AND customer = '"+lcCustID+"'"
									cSQLd = cSQLd + " AND OldCode = "+STR(nOldSoldCode)
									
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd)
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
									ENDDO
									IF nSQLEXEC < 0 &&Try again!
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL 2' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
		
											IF nSQLEXEC < 0
												IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
													nSQLEXEC = 0
												ENDIF
											ENDIF
										ENDDO
									ENDIF
								ENDIF
								
								RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLi )
								RETURN
							ENDIF
						ENDIF
						
						ThisFormSet.UpdateCustID = .T.
		
						THIS.PARENT.txtLastEdit.VALUE = DATE()
						THIS.PARENT.txtLastEdit.REFRESH
							
							*****************
							
							IF ThisFormSet.SalesNum > 0
								IF Count_SOinPackingSlip_No( ThisFormSet.SalesNum, ThisFormSet.nConnHandle ) > 0
		
									MESSAGEBOX("This Order has been Packed for shipping!"+CHR(13)+;
									"The Packing Slip database will be updated with this new address.",0+48,"")
									
									IF Update_SoldCodeinPackingSlip_No( nMaxSoldCode, ThisFormSet.SalesNum, ThisFormSet.nConnHandle )
										TrackMess("Sales Order "+ALLTRIM(STR(ThisFormSet.SalesNum))+" Sold Address "+ALLTRIM(STR(nMaxSoldCode))+" Edit updated the PackingSlip that has already been printed. "+CHR(13)+SYS(16,1))
									ENDIF
								ENDIF
							
							ENDIF
							******************
							
						IF ThisFormSet.ShipAddr > 0
							Save_Sold_Ship(nMaxSoldCode, ThisFormSet.ShipAddr, ThisFormSet.nConnHandle )
						ELSE
							*a new sold to was added * no ship addr exist * copy to ship addr
							IF THIS.PARENT.PARENT.pgShipTo.cmdEditShipTo.CAPTION = "Edit"
								IF MESSAGEBOX("Ship to address is empty."+CHR(10)+CHR(13)+"Do you want to copy this billing address to start a shipping address?", 4+32,"Copy to Ship To?")=6
									ThisFormSet.Address_Screen("ShipToSave")
									THIS.PARENT.PARENT.pgShipTo.txtCompany.VALUE = THIS.PARENT.txtCompany.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtAddr1.VALUE   = THIS.PARENT.txtAddr1.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtAddr2.VALUE   = THIS.PARENT.txtAddr2.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtCity.VALUE    = THIS.PARENT.txtCity.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtST.VALUE      = THIS.PARENT.txtST.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtZip.VALUE     = THIS.PARENT.txtZip.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtCountry.VALUE = UPPER(ALLTRIM(THIS.PARENT.txtCountry.VALUE))
									*THIS.PARENT.PARENT.pgBillTo.txtMarketing.Value = THIS.PARENT.txtMarketing.Value
									THIS.PARENT.PARENT.pgShipTo.txtContact.VALUE = THIS.PARENT.txtContact.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtPhone.VALUE   = THIS.PARENT.txtPhone.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtFax.VALUE  	 = THIS.PARENT.txtFax.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtEmail.VALUE   = THIS.PARENT.txtEmail.VALUE
									THIS.PARENT.PARENT.pgShipTo.txtLastEdit.VALUE = ""
									WAIT WINDOW "Remember to Click Save on the Ship Address." NOWAIT
								ENDIF
							ENDIF
						ENDIF
						*		WAIT WINDOW "Edit is only saved to this Sales Order when Print is successfull." NOWAIT
					ENDIF
				ELSE  &&nSaveNew = 6 && Yes, save as new
			
					*Save - not as new!
					*REPLACE DATA
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.SoldAddr SET "
					cSQLu= cSQLu+" Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",Marketing='"+lcMarketing+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
					cSQLu= cSQLu+",customer='"+lcCustID+"'"
		*			cSQLu= cSQLu+",Customer="+ALLTRIM(STR(nUseShipCode,10,0))+""
					cSQLu= cSQLu+ ",LastEdit='"+DTOC(DATE())+"'"
					cSQLu= cSQLu+ " WHERE soldcode = "+STR(lnSoldAddr)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLu )
							RETURN
						ENDIF
					ENDIF
						
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
		
				ENDIF
			ENDIF
			
			IF ThisFormSet.SalesNum > 0 AND lnSoldAddr > 0 AND NOT nSaveNew=6 AND nMaxSoldCode=0
				*Save to dbo.Sales_No
				
				SELECT Sales_No	&&Sales_No does not have items detail
				REPLACE pSoldAddr WITH lnSoldAddr IN Sales_No
				
				ThisFormSet.SoldAddr = lnSoldAddr
				This.Parent.txtSoldCode.Value	= 0
				REPLACE pSoldAddr WITH ThisFormSet.SoldAddr IN Sales_No
		
			ENDIF
			
			
			ThisFormSet.Address_Screen("SoldToEdit")
			THISFORM.cmdNext.SETFOCUS()
		
		ELSE &&Caption was Edit
			ThisFormSet.Address_Screen("SoldToSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.cmdIND_Type.Click
		PRIVATE cCustID
		cCustID = PrepareSQLtxt(This.parent.parent.pgOrder.txtCustID.Value,'CustID',20)
		PRIVATE nSoldAddr
		nSoldAddr = PrepareSQLnum(ThisFormSet.SoldAddr,'SoldAddr',-3)
		
		PRIVATE nIndType_ORIG, nIND_Type
		nIndType_ORIG = PrepareSQlnum(This.parent.lblIndType.Caption,'IndType',-3)
		nIND_Type = 0
		
		
		PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.F.
		ENDIF
		lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.F.
		ENDIF
		
		IF LEN(cCustID) > 0
			DO FORM Forms\IND_Type WITH cCustID,'Customer_List_Notes'
			nIND_Type = getIND_Type( "Customer_List_Notes", cCustID, ThisFormSet.nConnHandle)
			
		ELSE
			IF nSoldAddr > 0
				DO FORM Forms\IND_Type WITH nSoldAddr,'SoldAddr'
				nIND_Type = getIND_Type( "SOLDADDR", nSoldAddr, ThisFormSet.nConnHandle)
				
			ENDIF
		ENDIF
		
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.T.
		ENDIF
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.T.
		ENDIF
		
		
		*******************
		
		IF nIND_Type > 0
			IF nIndType_ORIG <> nIND_Type 
				This.Parent.lblIndType.Caption = STR(nInd_Type)
		
		*!*			PRIVATE cSQL, nSQLEXEC 
		
		*!*			cSQL = "UPDATE dbo.SoldAddr SET "
		*!*			cSQL = cSQL + " Ind_Type="+STR(nIND_Type)
		*!*			cSQL = cSQL + " WHERE SoldCode = "+ALLTRIM(STR(nSoldAddr))
		
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		*!*						
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*!*					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
		*!*				ENDIF
		*!*			ELSE
		*!*				WAIT WINDOW "Updated to Sold Address." Nowait
		*!*			ENDIF			
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.cmdMarkSalesPCustomer.Click
		PRIVATE nSoldAddr, cCustID
		nSoldAddr = PrepareSQLnum(ThisFormSet.SoldAddr,'SoldAddr',-3)
		
		*Look for CustID in these 3 places:
		cCustID	= ShowSQLtxt(This.Parent.CmdCustomerID.Caption,'CustID',20)
		IF UPPER(cCustID) = "GET CUSTOMERID"
			cCustID = ""
		ENDIF
		IF LEN(ALLTRIM(cCustID))=0
			cCustID	= ShowSQLtxt(SalesQuote.CustID,'CustID',20)
		ENDIF
		IF LEN(ALLTRIM(cCustID))=0
			cCustID = ShowSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)
		ENDIF
		
		IF LEN(ALLTRIM(cCustID))=0
			MESSAGEBOX("Please connect Order with the Accounting 'CustomerID' ",32,"No Cust ID")
			RETURN .F.
		ENDIF
		
		IF nSoldAddr > 0
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
		
			DO FORM Forms\SalesP_Customer WITH nSoldAddr, SalesQuote.SalesP, SalesQuote.Company, cCustID
			
			PRIVATE cSalesPs
			cSalesPs = getSalesP_Customer( nSoldAddr, ThisFormSet.nConnHandle )
		*	This.lblSalesP_Customer.Caption = cSalesPs
			This.parent.lblSalesP_Customer.Caption = cSalesPs
			
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		ELSE
			MESSAGEBOX("Please save 'Bill To' Address first.",32,"No SoldCode")
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.cmdSearchSoldTo.Click
		Private nMatchingCode, nNewSoldToCode, lcCurrTable 
		nNewSoldToCode = 0
		nMatchingCode = 0
		lcCurrTable = ALIAS()
		IF NOT USED('SALESQUOTE')
			MESSAGEBOX("'SALESQUOTE' table is not opened.",16,"Error")
			RETURN
		ENDIF
		
		PRIVATE cUseCompany
		cUseCompany = ShowSQLtxt(SalesQuote.Company,"Company",30)
		PRIVATE cCustID
		cCustID = PrepareSQLtxt(SalesQuote.CustID,'CustID',20)
		IF LEN(ALLTRIM(cCustID))=0
			*Not sure why SalesQuote.CustID is lost
			cCustID = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)
			IF NOT LEN(ALLTRIM(cCustID))=0
				SELECT SalesQuote
				REPLACE CustID WITH cCustID IN SalesQuote
			ENDIF
		ENDIF
		
		IF LEN(ALLTRIM(cUseCompany))=0
			cUseCompany = ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30,.F.,.T.)
		ELSE
			IF NOT LEN(ALLTRIM( ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30,.F.,.T.) ))=0
				IF cUseCompany != ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30,.F.,.T.)
					IF MESSAGEBOX("The Search will be on the Company name Quoted: "+cUseCompany+CHR(13)+"Answer No to use the name: "+ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30),3,"Search for "+cUseCompany  )=7
						cUseCompany = ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30,.F.,.T.)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		
		PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.F.
		ENDIF
		lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.F.
		ENDIF
		
		DO FORM Forms\SearchForm WITH "SoldAddr",cUseCompany,ThisFormSet.nConnHandle  TO nNewSoldToCode
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.T.
		ENDIF
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.T.
		ENDIF
		
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT LEN(ALLTRIM(lcCurrTable))=0
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF nNewSoldToCode > 0
			IF USED( 'aSoldAddr' )
				USE IN aSoldAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK)"
			cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(nNewSoldToCode)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSoldAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			IF USED( 'aSoldAddr' )
			
				IF ThisFormSet.SoldAddr > 0 AND ThisFormSet.SoldAddr <> nNewSoldToCode
					Track_Sales_No_Chng( "Change SoldTo from "+ALLTRIM(STR(ThisFormSet.SoldAddr ))+" to "+ALLTRIM(STR(nNewSoldToCode)),ThisFormSet.SalesNum,.F.,ThisFormSet.nAmendment )
					ThisFormSet.Set_Sales_No_Chng()
				ENDIF
		
		
				ThisFormSet.SoldAddr = aSoldAddr.SoldCode
				REPLACE pSoldAddr WITH ThisFormSet.SoldAddr IN Sales_No
				
				THIS.PARENT.txtSoldCode.VALUE = aSoldAddr.SoldCode
				THIS.PARENT.txtCompany.VALUE = aSoldAddr.Company
				THIS.PARENT.txtAddr1.VALUE = aSoldAddr.Addr1
				THIS.PARENT.txtAddr2.VALUE = aSoldAddr.Addr2
				THIS.PARENT.txtCity.VALUE = aSoldAddr.City
				THIS.PARENT.txtST.VALUE = aSoldAddr.ST
				THIS.PARENT.txtZip.VALUE = aSoldAddr.Zip
				THIS.PARENT.txtCountry.VALUE = UPPER(ALLTRIM(aSoldAddr.Country))
				THIS.PARENT.txtMarketing.Value = PrepareSQLtxt(aSoldAddr.Marketing,'Marketing',100)
				THIS.PARENT.txtContact.VALUE = aSoldAddr.Contact
				THIS.PARENT.txtPhone.VALUE = aSoldAddr.TelePhone
				THIS.PARENT.txtFax.VALUE = aSoldAddr.Fax_Number
				THIS.PARENT.txtEmail.VALUE = aSoldAddr.Email
				THIS.PARENT.txtLastEdit.VALUE = IIF(EMPTY(PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit'))
				
				*PRIVATE cCustID
				cCustID = PrepareSQLtxt(aSoldAddr.Customer,'CustomerID',20)
				IF LEFT(cCustID,3)="C00"
					This.Parent.cmdCustomerID.Caption = cCustID
				ENDIF	
				
				SELECT SalesQuote
				PRIVATE nItem
				nItem = SalesQuote.Item
				
				*REPLACE CustID WITH cCustID IN SalesQuote
				UPDATE SalesQuote SET CustID = cCustID 
						
				SELECT SalesQuote
				IF nItem > 0 AND nItem <= RECCOUNT('SalesQuote')
					LOCATE FOR Item = nItem
				ELSE
					GO TOP
				ENDIF
				
				Ask_SaveCustID_AllQuotes(cCustID, SalesQuote.SalesNum, ThisFormSet.nConnHandle )
				
				ThisFormSet.Address_Screen("SoldToEdit")
							
				*****************
				IF ThisFormSet.SalesNum > 0
					IF Count_SOinPackingSlip_No( ThisFormSet.SalesNum,ThisFormSet.nConnHandle ) > 0
						MESSAGEBOX("This Order has been Packed for shipping!"+CHR(13)+;
						"The Packing Slip database will be updated with this new address.",0+48,;
						"A Packing Slip with the old address has already been Printed!")
						
						IF Update_SoldCodeinPackingSlip_No(ThisFormSet.SoldAddr, ThisFormSet.SalesNum, ThisFormSet.nConnHandle )
							TrackMess("Sales Order "+ALLTRIM(STR(ThisFormSet.SalesNum))+" Sold Address "+ALLTRIM(STR(ThisFormSet.SoldAddr))+" Edit updated the PackingSlip that has already been printed. "+CHR(13)+SYS(16,1))
						ENDIF
					ENDIF
				ENDIF		
				******************
				USE IN aSoldAddr
				
			ENDIF
		
			IF EMPTY(This.Parent.Parent.pgShipTo.txtCompany.Value);
			 AND EMPTY(This.Parent.Parent.pgShipTo.txtAddr1.Value);
			  AND EMPTY(This.Parent.Parent.pgShipTo.txtAddr2.Value);
			   AND EMPTY(This.Parent.Parent.pgShipTo.txtCity.Value);
			    AND EMPTY(This.Parent.Parent.pgShipTo.txtST.Value);
			     AND EMPTY(This.Parent.Parent.pgShipTo.txtZip.Value);
			      AND EMPTY(This.Parent.Parent.pgShipTo.txtCountry.Value)
		*		fill Shipto values
		*		use last Shipto assigned to this SoldTo
		
				IF ThisFormSet.SoldAddr > 0
		*			if SoldAddr soldCode lookup links in Sold_Ship
		
					PRIVATE nUseShipCode 
					nUseShipCode = Get_ShipCodeinSoldShip(ThisFormSet.SoldAddr,ThisFormSet.nConnHandle)			
		*			SELECT TOP 1 ShipCode FROM HPA!Sold_Ship WHERE SoldCode = ThisFormSet.SoldAddr ORDER BY ShipCode DESC INTO ARRAY aShipCode
					IF nUseShipCode  > 0
						nMatchingCode = nUseShipCode 
						WAIT WINDOW "Found 'Ship To' address last used with this 'Bill To' address!" NOWAIT
					ENDIF
					
					
					PRIVATE cCustomerID 
					cCustomerID = GetCustomerID_with_SoldCode(ThisFormSet.SoldAddr,ThisFormSet.nConnHandle)
					IF LEN(ALLTRIM(cCustomerID))=0
						This.parent.cmdCustomerID.Caption = 'Get CustomerID'
					ELSE
					*	*IF VAL(cCustomerID) = 0
					*	*	This.parent.cmdCustomerID.Caption = 'Get CustomerID'
					*	*ELSE
							IF LEFT(cCustomerID,3)="C00"
								This.parent.cmdCustomerID.Caption = cCustomerID 
							ENDIF
					*	*ENDIF
					ENDIF
		
		
				ENDIF
		
				IF nMatchingCode = 0
					*Look in SoldAddr where Customer is still a Code
					*Customer field is the Accounting ID to join to.
					IF USED("cntSoldAddr")
						USE IN cntSoldAddr
					ENDIF
					
					cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.SoldAddr WITH(NOLOCK)"
					cSQL = cSQL + " WHERE Customer = '"+STR(ThisFormSet.SoldAddr)+"'"
					cSQL = cSQL + " OR  Try_CAST(Customer AS INT) = "+STR(ThisFormSet.SoldAddr)+""
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntSoldAddr')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSoldAddr')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSoldAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSoldAddr")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntSoldAddr')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
					IF USED("cntSoldAddr")
						USE IN cntSoldAddr
						*Get the SoldCode
						nMatchingCode = Get_SoldCode_CustomerinSoldAddr( STR(ThisFormSet.SoldAddr,10,0), ThisFormSet.nConnHandle)
					ENDIF
		
				ENDIF
				
				IF USED("tempShipAddr")
					USE IN tempShipAddr
				ENDIF
				
				cSQL = "SELECT * FROM dbo.ShipAddr WITH(NOLOCK) WHERE ShipCode = "+STR(nMatchingCode) 
				*INTO CURSOR tempShipAddr NOFILTER
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tempShipAddr')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tempShipAddr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tempShipAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tempShipAddr")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tempShipAddr')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						RETURN .F.
					ENDIF
				ENDIF
				
			
				SELECT tempShipAddr
				GO BOTTOM IN tempShipAddr
				
				SELECT SalesQuote
				
				IF NOT EMPTY(tempShipAddr.ShipCode)
					ThisFormSet.ShipAddr = tempShipAddr.ShipCode
					REPLACE pShipAddr WITH ThisFormSet.ShipAddr IN Sales_No
					
					This.Parent.Parent.pgShipTo.txtShipCode.Value 	= tempShipAddr.ShipCode
		*			This.Parent.Parent.pgShipto.numShipAddr.Value	= tempShipAddr.ShipCode
					This.Parent.Parent.pgShipTo.txtCompany.Value 	= tempShipAddr.Company
					This.Parent.Parent.pgShipTo.txtAddr1.Value 		= tempShipAddr.Addr1
					This.Parent.Parent.pgShipTo.txtAddr2.Value 		= tempShipAddr.Addr2
					This.Parent.Parent.pgShipTo.txtCity.Value 		= tempShipAddr.City
					This.Parent.Parent.pgShipTo.txtST.Value 		= tempShipAddr.ST
					This.Parent.Parent.pgShipTo.txtZip.Value 		= tempShipAddr.zip
					This.Parent.Parent.pgShipTo.txtCountry.Value 	= UPPER(ALLTRIM(tempShipAddr.Country))
					This.Parent.Parent.pgShipTo.txtContact.Value 	= tempShipAddr.Contact
					This.Parent.Parent.pgShipTo.txtPhone.Value 		= tempShipAddr.Telephone
					This.Parent.Parent.pgShipTo.txtFax.Value 		= tempShipAddr.Fax_Number
					This.Parent.Parent.pgShipTo.txtEmail.Value 		= tempShipAddr.Email
					This.Parent.Parent.pgShipTo.txtLastEdit.Value 	= IIF(EMPTY(PrepareSQLdate(tempShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(tempShipAddr.LastEdit,'LastEdit'))
					
					IF NOT LEN(ALLTRIM( tempShipAddr.ShipRoute ))=0
						This.Parent.Parent.pgShipTo.txtShipRoute.Value 	= tempShipAddr.ShipRoute
						REPLACE ShipRoute WITH tempShipAddr.ShipRoute IN Sales_No
						
						IF ASCAN(aShipRoutes, tempShipAddr.ShipRoute )  > 0
							*Global Position for Array aShipRoutes
							gnPos = ASCAN(aShipRoutes, tempShipAddr.ShipRoute ) 
						ENDIF
					ENDIF
					IF NOT LEN(ALLTRIM( tempShipAddr.Instrct ))=0
						This.Parent.Parent.pgShipTo.txtInstrct.Value 	= tempShipAddr.Instrct
						REPLACE Instrct WITH tempShipAddr.Instrct IN Sales_No
					ENDIF
					IF VARTYPE( tempShipAddr.Blind ) = "L"
						This.Parent.Parent.pgShipTo.chkBlindSO.Value	= tempShipAddr.Blind
						REPLACE Blind WITH tempShipAddr.Blind IN Sales_No
					ENDIF
					IF NOT LEN(ALLTRIM( tempShipAddr.PayType ))=0
						This.Parent.Parent.pgShipTo.cmbPayment.Value	= ShowSQLtxt(tempShipAddr.PayType,'PayType',10)
						REPLACE PayType WITH tempShipAddr.PayType IN Sales_No
					ENDIF
					IF NOT LEN(ALLTRIM( tempShipAddr.ShipPay ))=0
						This.Parent.Parent.pgShipTo.cmbFrtPayment.Value	= ShowSQLtxt(tempShipAddr.ShipPay,'ShipPay',12)
						REPLACE ShipPay WITH tempShipAddr.ShipPay IN Sales_No
					ENDIF	
					
					
					ThisFormSet.Address_Screen("ShipToEdit")
					*WAIT CLEAR	
				ENDIF
			ENDIF
			
			**************************************************
			IF ThisFormSet.SalesNum > 0 AND nNewSoldToCode > 0
		
					SELECT Sales_No	&&Sales_No does not have items detail
					ThisFormSet.SoldAddr = nNewSoldToCode
					REPLACE pSoldAddr WITH ThisFormSet.SoldAddr IN Sales_No
		*!*			ENDIF
			ENDIF	
			
			
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.lblBillToCountry.Click
		PRIVATE cSQL_tmpCountries, nSQLEXEC, cCurrTable
		cCurrTable = ALIAS()
		
		IF USED("tmpCountries")
			USE IN tmpCountries
		ENDIF
		cSQL_tmpCountries="SELECT CountryCode AS CC, Restricted AS R, CountryDesc FROM dbo.Countries WITH(NOLOCK)"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_tmpCountries, 'tmpCountries')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_tmpCountries, 'tmpCountries')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_tmpCountries, "tmpCountries")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_tmpCountries, "tmpCountries")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL_tmpCountries,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountries')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		IF nSQLEXEC > 0
			DEFINE WINDOW output FROM 12,1 TO 23,40 TITLE 'Countries' CLOSE FLOAT GROW ZOOM
			ACTIVATE WINDOW output
			SELECT tmpCountries
			BROWSE IN WINDOW output NODELETE NOEDIT NOAPPEND
			DEACTIVATE WINDOW output
			RELEASE WINDOW output
		ENDIF
		
		IF USED("tmpCountries")
			USE IN tmpCountries
		ENDIF
		IF NOT LEN(ALLTRIM(cCurrTable))=0
			SELECT (cCurrTable)
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.lblMarketing.DblClick
		PRIVATE lReturn
		lReturn = .T.
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE cMarketing
		cMarketing = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgBillTo.txtMarketing.Value,'Marketing',100)
		
		
		*ThisFormSet.SalesNum
		*cCustID = PrepareSQLtxt(ThisForm.pf1.pgOrder.txtCustID.Value,'CustID',20)
		IF LEN(cMarketing ) > 0 AND ThisFormSet.SoldAddr > 0
			cSQL = "UPDATE dbo.SoldAddr "
			cSQL = cSQL +" SET [Marketing]='"+cMarketing+"'"
			cSQL = cSQL +" WHERE SoldCode="+ALLTRIM(STR(ThisFormSet.SoldAddr))+""
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL,"" )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL,"" )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0 &&Try again!, long triger
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					lReturn = .F.
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
					RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ELSE
				RecordTest("Record Test Data.", "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
			ENDIF
		ENDIF
		
		RETURN lReturn
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.txtBillInstrct.Valid
		PRIVATE cSQL, nSQLEXEC 
