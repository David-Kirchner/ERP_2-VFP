		*	IF nthck > 0 AND nthck < .125 AND cForm = "40"
		*		This.Parent.chkSPS1.Value = 1
		*	ENDIF
		*ENDIF
		
		ThisFormSet.RefreshForms(0)
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.cmbPU.GotFocus
		
		ThisFormSet.MetricGOTFocus  = "cmbPU"
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.cmbPU.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpPU')
			SELECT tmpPU
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT Unit, PU, RTRIM(Label) AS cLabel FROM dbo.PU WITH(NOLOCK) "
		cSQL = cSQL + " ORDER BY PU ASC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPU')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPU')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPU")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPU")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPU')
		ENDIF
		
		*DIMENSION aPU(1,2)
		IF VARTYPE(gaPU)="U"
			PUBLIC gaPU(1,3)
		ENDIF
		
		
		IF USED('tmpPU')
			SELECT Unit, STR(PU,1) AS PU, cLabel FROM tmpPU INTO ARRAY gaPU
			
			USE IN tmpPU
		ENDIF
		
		*This.ColumnCount = ALEN(gaPU,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(gaPU)
		This.BoundColumn = 2
		This.ColumnWidths = "50,17,70"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(gaPU,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(gaPU(I, 1),I,1)
			this.addListitem(gaPU(I, 2),I,2)
			this.addListitem(gaPU(I, 3),I,3)
		ENDFOR
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.cmbPU.LostFocus
		SELECT SalesQuote
		*REPLACE cLotP WITH ThisFormSet.CalcLotp() IN SalesQuote
		REPLACE cLotP WITH getSale_SOitem( SalesQuote.SOItem_A, ThisFormSet.nConnHandle ) IN SalesQuote
		
		*ThisFormSet.UpdtItemSale(SalesQuote.cLotP)
		*This.Parent.txtItemSale.Refresh()
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.cmbPU.SetFocus
		PRIVATE nQ_Total
		nQ_Total = PrepareSQLnum(Quotes.Q_Total,'Q_Total',10,2)
		
		PRIVATE nCutsP, nOtherP
		nCutsP		= PrepareSQLnum(Quotes.Cuts,'Cuts',8,2)
		nOtherP		= PrepareSQLnum(Quotes.OtherP,'OtherP',8,2)
		
		IF nQ_Total = 0
			nQ_Total = PrepareSQLnum(Quotes.Q_QTY*Quotes.Q_P ,'Q_QTY',-5) 
			
			IF nQ_Total > 0
				*REPLACE Quotes.Q_Total WITH nQ_Total IN Quotes
				ThisForm.Q_Total1.Value = nQ_Total 
			ELSE
				* Guess?
				nQ_Total = PrepareSQLnum(Quotes.Weight *Quotes.P_LB,'QTY_Total ',-5) 
		
				IF nQ_Total > 0
					ThisForm.Q_Total1.Value = nQ_Total 
				ELSE
					nQ_Total = PrepareSQLnum(Quotes.Pieces*Quotes.P_PC,'QTY_Total ',-5) 
					IF nQ_Total > 0
						ThisForm.Q_Total1.Value = nQ_Total 
					ELSE
						*Try Feet?
						
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.cmbPU.Valid
		PRIVATE nNewPU, nNew_P
		nNewPU = PrepareSQLnum(This.Value,'PU',-1) 
		nNew_P = 0
		
		PRIVATE nCutsP, nOtherP
		nCutsP = PrepareSQLnum(This.Parent.txtCUTS.Value,'Cuts',8,2)
		nOtherP = PrepareSQLnum(This.Parent.txtOtherP.Value,'OtherP',8,2) 
		
		PRIVATE nWeight
		nWeight = PrepareSQLnum(This.Parent.txtWeight.Value,'Weight',7,1)
		
		PRIVATE nQ_P, nQ_QTY, nQ_Total, nS_Total 
		nQ_P   = PrepareSQLnum(This.Parent.Q_P1.Value,'Q_P',-5)
		nQ_QTY = PrepareSQLnum(This.Parent.Q_QTY1.Value,'Q_QTY',-5)
		nQ_Total = PrepareSQLnum(This.Parent.Q_Total1.Value,'Q_Total',10,2)
		nS_Total = nQ_Total +nCutsP +nOtherP 
		
		PRIVATE nPieces,cAlloy,cForm,nThck,nSz2,nSz3
		nPieces			= PrepareSQLnum(This.Parent.txtPieces.Value,'Pieces',7,0)
		cAlloy			= PrepareSQLtxt(This.Parent.txtAlloy.Value,'Alloy',12)
		cForm			= PrepareSQLtxt(This.Parent.cmbForm.Value,'Form',2)
		nThck			= PrepareSQLnum(This.Parent.txtThck.Value,'Thck',10,4)
		nSz2			= PrepareSQLnum(This.Parent.txtSZ2.Value,'Sz2',9,3)
		nSz3			= PrepareSQLnum(This.Parent.txtSz3.Value,'Sz3',9,3)
				
		IF nPieces = 0
			nPieces = 1
		ENDIF
		
		PRIVATE nOld_PU, nNew_PU
		nOld_PU	= PrepareSQLnum(This.Parent.Q_PU1.Value,'PU',-1)
		nNew_PU	= PrepareSQLnum(This.Value,'PU',-1)
		
		This.Parent.lblUnitText .Caption  = Get_cPUfrom_nPU(nNewPU)
		This.Parent.lblQTY_Label.Caption = Get_Label_from_nPU(nNewPU)
		
		IF nOld_PU <> nNewPU
			* PU has Changed, All of the Q_ data needs Changed.
			
			IF nQ_Total = 0
				* Try to Calc nQ_Total
				IF nQ_P * nQ_QTY > 0
					nQ_Total = PrepareSQLnum(nQ_P * nQ_QTY ,'Q_Total',10,2)
					nS_Total = nQ_Total +nCutsP +nOtherP
				ELSE 
					IF nS_Total > 0
						nQ_Total = nS_Total -nCutsP -OtherP
					ENDIF
				ENDIF
			ENDIF
				
			
			*IF nQ_Total > 0
			*must have Q_Total	
			DO CASE 
			CASE nNewPU = 1
				*Pounds
				nNew_QTY = nWeight
				IF nNew_QTY = 0
					nNew_QTY = PrepareSQLnum( GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,gnConnHandle) ,'Pounds',8,1)
					IF nNew_QTY > 0
						
					ENDIF
				ENDIF
				IF nNew_QTY > 0
					nNew_P  = PrepareSQLnum( (nQ_Total / nNew_QTY), 'Q_P', -5 )
				ENDIF
					
				IF nNew_P > 0
					nQ_Total = PrepareSQLnum( ( nNew_QTY * nNew_P ),'Q_Total',10,2)
					IF nQ_Total > 0
						nS_Total = nQ_Total +nCutsP +nOtherP 
					ENDIF
				ELSE
					nQ_Total = 0
				ENDIF
				
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nNew_QTY 
				This.Parent.Q_Total1.Value	= nQ_Total 
				This.Parent.Q_PU1.Value		= nNewPU 
			
			CASE nNewPU = 2
				*Feet
				
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
				
				nNew_QTY = nFeet
				IF nNew_QTY > 0
					nNew_P   = PrepareSQLnum(( nQ_Total / nNew_QTY ),'Q_P',-5)
				ENDIF	
				IF nNew_P > 0
					nQ_Total = PrepareSQLnum(( nNew_QTY * nNew_P ),'Q_Total',10,2)
				ELSE
					nQ_Total = 0
				ENDIF
				
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nNew_QTY 
				This.Parent.Q_Total1.Value	= nQ_Total
				This.Parent.Q_PU1.Value		= nNewPU 
			
			CASE nNewPU = 3
				*Pieces
						
				nNew_QTY = nPieces 
				IF nNew_QTY > 0
					nNew_P   = PrepareSQLnum(nQ_Total / nNew_QTY ,'Q_P',10,2)	
				ENDIF
				
				IF nNew_P > 0
					nQ_Total = PrepareSQLnum(( nNew_QTY * nNew_P ),'Q_Total',10,2)
				ELSE
					nQ_Total = 0
				ENDIF
				nS_Total = nQ_Total +nCutsP +nOtherP
				
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nNew_QTY 
				This.Parent.Q_Total1.Value	= nQ_Total
				This.Parent.Q_PU1.Value		= nNewPU 
						
			CASE nNewPU = 4
				*Lot
				nNew_QTY = 1
				nNew_P   = PrepareSQLnum(This.Parent.LotP1.Value,'LotP',-5)
				
				IF nNew_P > 0
					nQ_Total = PrepareSQLnum(( nNew_QTY * nNew_P ),'Q_Total',10,2)
				ELSE
					nQ_Total = 0
				ENDIF
					
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nNew_QTY 
				This.Parent.Q_Total1.Value 	= nQ_Total 
				This.Parent.Q_PU1.Value		= nNewPU 
				
			CASE nNewPU = 5
				*Inches
		
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
				
				nNew_QTY = PrepareSQLnum(nFeet*12,'Q_QTY',-5)
				IF nNew_QTY > 0
					nNew_P   = PrepareSQLnum(nQ_Total / nNew_QTY ,'Q_P',-5)
				ENDIF
				
				IF nNew_P > 0
					nQ_Total = PrepareSQLnum(( nNew_QTY * nNew_P ),'Q_Total',10,2)
				ELSE
					nQ_Total = 0
				ENDIF
				
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nNew_QTY 
				This.Parent.Q_Total1.Value	= nQ_Total 
				This.Parent.Q_PU1.Value		= nNewPU 
			
			CASE nNewPU = 6
				*kg
				nNew_QTY = PrepareSQLnum( (PrepareSQLnum(This.Parent.Weight1.Value,'QTY',-5) * 2.205 ) ,'Pounds',8,1)
				IF nNew_QTY > 0
					nNew_P   = PrepareSQLnum(nQ_Total / nNew_QTY ,'Q_P',-5)
				ENDIF
				
				IF nNew_P > 0
					nQ_Total = PrepareSQLnum(( nNew_QTY * nNew_P ),'Q_Total',10,2)
				ELSE
					nQ_Total = 0
				ENDIF
				
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nNew_QTY 
				This.Parent.Q_Total1.Value	= nQ_Total 
				This.Parent.Q_PU1.Value		= nNewPU 
		
			CASE nNewPU = 7
				*Meters
		
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
				
				nNew_QTY = nFeet/ 3.28084
				IF nNew_QTY > 0
					nNew_P   = PrepareSQLnum(nQ_Total / nNew_QTY  ,'Q_P',-5)
				ENDIF
				
				IF nNew_P > 0
					nQ_Total = PrepareSQLnum(( nNew_QTY * nNew_P ),'Q_Total',10,2)
				ELSE
					nQ_Total = 0
				ENDIF
				
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nNew_QTY 
				This.Parent.Q_Total1.Value	= nQ_Total 
				This.Parent.Q_PU1.Value		= nNewPU 
				
			CASE nNewPU = 8
				*Hour
				IF nS_Total = 0
					nS_Total = nQ_Total +nCutsP +nOtherP
				ELSE
					IF nQ_Total = 0
						nQ_Total  = nS_Total -nCutsP -nOtherP
					ENDIF
				ENDIF
				
				
				IF nQ_QTY > 0
					nNew_P 	= (nS_Total -nCutsP -nOtherP) / nQ_QTY 
				ELSE
					nQ_QTY = 1
					nNew_P 	= (nS_Total -nCutsP -nOtherP) / nQ_QTY 
				ENDIF
				
				IF nNew_P > 0
					nQ_Total = PrepareSQLnum(( nQ_QTY * nNew_P ),'Q_Total',10,2)
				ELSE
					nQ_Total = 0
				ENDIF
				
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nQ_QTY 
				This.Parent.Q_Total1.Value	= nQ_Total 
				This.Parent.Q_PU1.Value		= nNewPU 
						
			CASE nNewPU = 9
				*Per Day
				IF nS_Total = 0
					nS_Total = nQ_Total +nCutsP +nOtherP
				ELSE
					IF nQ_Total = 0
						nQ_Total  = nS_Total -nCutsP -nOtherP
					ENDIF
				ENDIF
				
				IF nQ_QTY > 0
					nNew_P 	= (nS_Total -nCutsP -nOtherP) / nQ_QTY 
				ELSE
					nQ_QTY = 1
					nNew_P 	= (nS_Total -nCutsP -nOtherP) / nQ_QTY 
				ENDIF
				
				IF nNew_P > 0
					nQ_Total = PrepareSQLnum(( nQ_QTY * nNew_P ),'Q_Total',10,2)
				ELSE
					nQ_Total = 0
				ENDIF
				
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nQ_QTY 
				This.Parent.Q_Total1.Value	= nQ_Total 
				This.Parent.Q_PU1.Value		= nNewPU 
		
			CASE nNewPU = 10
				*Lot
				nNew_QTY = 1
				nNew_P   = 0
				nQ_Total = 0
					
				This.Parent.Q_P1.Value		= nNew_P
				This.Parent.Q_QTY1.Value	= nNew_QTY 
				This.Parent.Q_Total1.Value	= nQ_Total 
				This.Parent.Q_PU1.Value		= nNewPU 
							
			OTHERWISE
		*!*			PRIVATE nQ_P, nQ_QTY, nQ_Total
		*!*			nQ_P = PrepareSQLnum(This.Parent.Q_P1.Value,'Q_P',-5)
		*!*			nQ_QTY = PrepareSQLnum(This.Parent.Q_QTY1.Value,'Q_QTY',-5)
		*!*			nQ_Total = PrepareSQLnum(This.Parent.Q_Total1.Value,'Q_Total',10,2)
		
		*!*			This.Parent.Q_P1.Value		= nNew_P
		*!*			This.Parent.Q_QTY1.Value	= nNew_QTY 
		*!*			This.Parent.Q_Total1.Value	= nQ_Total 
		
		*	CASE nNewPU = 8
		*	CASE nNewPU = 9
			ENDCASE
		ENDIF
		*nS_Total = nQ_Total +nCutsP +nOtherP
		
		*ThisFormSet.Update_Prices()
		
		
	ENDPROC

