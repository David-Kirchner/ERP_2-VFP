		ELSE
			MESSAGEBOX("Lost table 'SalesQuote'.",0+16,"SQL Error")
			TrackError("Lost table 'SalesQuote'.","No Table", PROGRAM(), LINENO(1))
		ENDIF
				
		
		
	ENDPROC

	PROCEDURE refresh_pgpurchase
		*ThisFormSet.Refresh_pgPurchase()
		
		ThisFormSet.frmPO.Visible = .T.
		ThisFormSet.frmPO.Left	= ThisFormSet.frmEO.Left+6
		ThisFormSet.frmPO.Top	= ThisFormSet.frmEO.Top + 60
		ThisFormSet.frmPO.AlwaysOnTop = .T.
		
		ThisFormSet.frmEoP.Visible = .T.
		ThisFormSet.frmEoP.Left = ThisFormSet.frmEO.Left + ThisFormSet.frmEO.Width
		ThisFormSet.frmEoP.Top = ThisFormSet.frmEO.Top
		
		ThisFormSet.frmPO.pgfPO.Left = 1
		
		ThisFormSet.frmPO.PO_NewAdd = .F.
		ThisFormSet.frmPO.PO_NewClone = .F.
		ThisFormSet.frmPO.POEditing = .F.
		
		********
		
		ThisFormSet.frmPO.ItemNumber = ThisFormSet.ItemNumber
		ThisFormSet.frmPO.Salesnum 	 = ThisFormSet.SalesNum
		ThisFormSet.frmPO.txtItem.Value = ThisFormSet.ItemNumber
		
		ThisFormset.frmPO.pgfPO.pgPODesc.txtSalesnum.Value =  ThisFormSet.SalesNum
		ThisFormset.frmPO.pgfPO.pgPODesc.txtItem.Value = ThisFormSet.ItemNumber
		
		
		ThisFormSet.frmPO.QuotesID	= SalesQuote.ID
		ThisFormSet.frmPO.cSOitem	= Proper_PO_item(SalesQuote.SoItem_A)
		*ThisFormSet.frmPO.cPOitem	= ''
		
		ThisFormSet.frmPO.Descript	= SalesQuote.Descript	&&lblDescript.Click pulls from this memory location
		ThisFormSet.frmPO.Comments 	= SalesQuote.Comments
		
		ThisFormSet.frmPO.lblItem.Visible = .T.
		ThisFormSet.frmPO.cmdPoPrev.Visible = .T.
		ThisFormSet.frmPO.txtItem.Visible = .T.
		ThisFormSet.frmPO.cmdPoNext.Visible = .T.
		ThisFormSet.frmPO.lblOf.Visible = .T.
		
		ThisFormSet.frmPO.txtItemTot.Value = SalesQuote.itemTot
		ThisFormSet.frmPO.txtItemtot.Visible = .T.
		
		ThisFormSet.frmPO.pgfPO.pgPODesc.txtSalesNum.Enabled = .F.
		ThisFormSet.frmPO.pgfPO.pgPODesc.txtItem.Enabled = .F.
		ThisFormSet.frmPO.pgfPO.pgPODesc.lblSalesNum.Enabled = .F.
		
		**************************
		
		*set lstPoItems with gaPoItems
		*ThisFormSet.frmPO.SetPOitems(SalesQuote.SoItem_A, .F.)------Done in Show_frmPO
		*Set cPOitem
		PRIVATE cSQL, nSQLEXEC
		*IF Proper_PO_item(ThisFormSet.frmPO.cPOitem) = Proper_PO_item("")
		*	OR Proper_PO_item(ThisFormSet.POitem) = Proper_PO_item("")
		
		**INIT POitem 
		ThisFormSet.POitem = Proper_PO_item("")
		ThisFormSet.frmPO.cPOitem = ThisFormSet.POitem
		
		**POitem that belongs to SOitem
		IF USED('tmpPoItemDetail2')
			USE IN tmpPoItemDetail2
		ENDIF
		
		PRIVATE nItem
		nItem	= PrepareSQLnum(SalesQuote.Item_A,'Item',2,0)
		
		cSQL = "SELECT DISTINCT PoItem FROM dbo.PurchaseOrder WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_A+"')"
		cSQL = cSQL + " OR ( SalesNum = "+STR(ThisFormSet.SalesNum)
		cSQL = cSQL + " AND Item="+ALLTRIM(STR(nItem))
		cSQL = cSQL +")"
		cSQL = cSQL + " ORDER BY PoItem "  &&DESC " 
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPoItemDetail2')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPoItemDetail2' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPoItemDetail2")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPoItemDetail2")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPoItemDetail2' )
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpPoItemDetail2')
			IF RECCOUNT('tmpPoItemDetail2') > 0
				SELECT tmpPoItemDetail2
				*Move record to last known POitem if it belongs to SOitem
				IF Proper_PO_item(ThisFormSet.frmPO.cPOitem) != Proper_PO_item("")
					LOCATE FOR POitem = Proper_PO_item(ThisFormSet.frmPO.cPOitem)
					IF NOT FOUND('tmpPoItemDetail2')
						GO TOP IN tmpPoItemDetail2
					ENDIF
				ENDIF
				
				ThisFormSet.frmPO.cPOitem = tmpPoItemDetail2.POitem
				ThisFormSet.POitem = tmpPoItemDetail2.POitem
				
				ThisFormSet.frmPO.Show_frmPO()
				ThisFormSet.Show_EoP()
		
				ThisFormSet.frmPO.lstPoItems.SetFocus
		
				ThisFormSet.frmEO.pf1.pg_po.Refresh()
			ELSE
				ThisFormSet.SOitemDescript()	
			ENDIF
			
		ELSE
			ThisFormSet.SOitemDescript()
		ENDIF
		
		
		IF USED('tmpPoItemDetail2')
			USE IN tmpPoItemDetail2
		ENDIF
	ENDPROC

	PROCEDURE refresh_pgqa
		*ThisFormSet.Refresh_pgQA()
		ThisFormSet.frmEO.pf1.pgQA.txtVersion.Value = ThisFormSet.nAmendment
		
		************** Show_QA()
		PRIVATE cSOitem
		cSOitem = SalesQuote.SOitem
		
		IF USED('tmpSOitem_Hrs')
			USE IN tmpSOitem_Hrs
		ENDIF
		
		cSQL = "SELECT SOitem,Cncld,Cmplt,INV"
		cSQL = cSQL + ",Recv,[Mach],CG,[Pack],[GFM],[Draw],[Roll],Press"
		cSQL = cSQL + ",Heat,Test,Abrsv,BSaw,Shear,Plasma,WJet,Hrs"
		cSQL = cSQL + " FROM dbo.SOitem_Hrs  WITH(NOLOCK) "
		*cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"tmpSOitem_Hrs")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitem_Hrs')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Hrs")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Hrs")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSOitem_Hrs')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		PRIVATE lShowHrs
		lShowHrs = .F.
		
		ThisFormset.frmEO.pf1.pgQA.lblSOitem.Caption = cSOitem
		
		IF USED('tmpSOitem_Hrs')
			IF RECCOUNT('tmpSOitem_Hrs') > 0
				lShowHrs = .T.
		
				ThisFormset.frmEO.pf1.pgQA.spnINV.Value		= tmpSOitem_Hrs.INV
				ThisFormset.frmEO.pf1.pgQA.spnRecv.Value	= tmpSOitem_Hrs.Recv
				ThisFormset.frmEO.pf1.pgQA.spnMach.Value	= tmpSOitem_Hrs.Mach
				ThisFormset.frmEO.pf1.pgQA.spnCG.Value		= tmpSOitem_Hrs.CG
				ThisFormset.frmEO.pf1.pgQA.spnPack.Value	= tmpSOitem_Hrs.Pack
				ThisFormset.frmEO.pf1.pgQA.spnGFM.Value		= tmpSOitem_Hrs.GFM
				ThisFormset.frmEO.pf1.pgQA.spnDraw.Value		= tmpSOitem_Hrs.Draw
				ThisFormset.frmEO.pf1.pgQA.spnRoll.Value	= tmpSOitem_Hrs.Roll
				ThisFormset.frmEO.pf1.pgQA.spnPress.Value	= tmpSOitem_Hrs.Press
				ThisFormset.frmEO.pf1.pgQA.spnHeat.Value	= tmpSOitem_Hrs.Heat
				ThisFormset.frmEO.pf1.pgQA.spnTest.Value	= tmpSOitem_Hrs.Test
				ThisFormset.frmEO.pf1.pgQA.spnAbrsv.Value	= tmpSOitem_Hrs.Abrsv
				ThisFormset.frmEO.pf1.pgQA.spnBSaw.Value	= tmpSOitem_Hrs.BSaw
				ThisFormset.frmEO.pf1.pgQA.spnShear.Value	= tmpSOitem_Hrs.Shear
				ThisFormset.frmEO.pf1.pgQA.spnPlasma.Value	= tmpSOitem_Hrs.Plasma
				ThisFormset.frmEO.pf1.pgQA.spnWJet.Value	= tmpSOitem_Hrs.WJet
		*		ThisFormset.frmEO.pf1.pgQA.spnHrs.Value		= tmpSOitem_Hrs.Hrs
		
				nHRS=tmpSOitem_Hrs.INV+tmpSOitem_Hrs.Recv+tmpSOitem_Hrs.Mach+tmpSOitem_Hrs.CG+tmpSOitem_Hrs.Pack
				nHRS=nHRS+tmpSOitem_Hrs.GFM+tmpSOitem_Hrs.Draw+tmpSOitem_Hrs.Roll+tmpSOitem_Hrs.Press+tmpSOitem_Hrs.Heat+tmpSOitem_Hrs.Test
				nHRS=nHRS+tmpSOitem_Hrs.Abrsv+tmpSOitem_Hrs.BSaw+tmpSOitem_Hrs.Plasma+tmpSOitem_Hrs.WJet
				nHRS=nHRS+1
				ThisFormset.frmEO.pf1.pgQA.lblHRS.Caption 	= STR(nHRS)
			ENDIF
			
			USE IN tmpSOitem_Hrs
		ENDIF
		
		IF NOT lShowHrs
			ThisFormset.frmEO.pf1.pgQA.spnINV.Value		= 0
			ThisFormset.frmEO.pf1.pgQA.spnRecv.Value	= 0
			ThisFormset.frmEO.pf1.pgQA.spnMach.Value	= 0
			ThisFormset.frmEO.pf1.pgQA.spnCG.Value		= 0
			ThisFormset.frmEO.pf1.pgQA.spnPack.Value	= 0
			ThisFormset.frmEO.pf1.pgQA.spnGFM.Value		= 0
			ThisFormset.frmEO.pf1.pgQA.spnRoll.Value		= 0
			ThisFormset.frmEO.pf1.pgQA.spnRoll.Value	= 0
			ThisFormset.frmEO.pf1.pgQA.spnPress.Value	= 0
			ThisFormset.frmEO.pf1.pgQA.spnHeat.Value	= 0
			ThisFormset.frmEO.pf1.pgQA.spnTest.Value	= 0
			ThisFormset.frmEO.pf1.pgQA.spnAbrsv.Value	= 0
			ThisFormset.frmEO.pf1.pgQA.spnBSaw.Value	= 0
			ThisFormset.frmEO.pf1.pgQA.spnShear.Enabled 	= 0
			ThisFormset.frmEO.pf1.pgQA.spnPlasma.Enabled 	= 0
			ThisFormset.frmEO.pf1.pgQA.spnWJet.Value	= 0
		
			ThisFormset.frmEO.pf1.pgQA.lblHRS.Caption = 0
		ENDIF
		**************
		
		ThisFormset.frmEO.pf1.pgQA.spnINV.Enabled 	= SalesQuote.Inv
		ThisFormset.frmEO.pf1.pgQA.spnRecv.Enabled 	= .T.
		ThisFormset.frmEO.pf1.pgQA.spnMach.Enabled 	= SalesQuote.Mach
		ThisFormset.frmEO.pf1.pgQA.spnCG.Enabled 	= SalesQuote.CG
		ThisFormset.frmEO.pf1.pgQA.spnPack.Enabled 	= .T.
		ThisFormset.frmEO.pf1.pgQA.spnGFM.Enabled 	= SalesQuote.GFM
		ThisFormset.frmEO.pf1.pgQA.spnDraw.Enabled 	= SalesQuote.Draw
		ThisFormset.frmEO.pf1.pgQA.spnRoll.Enabled 	= SalesQuote.Roll
		ThisFormset.frmEO.pf1.pgQA.spnPress.Enabled	= SalesQuote.Press
		ThisFormset.frmEO.pf1.pgQA.spnHeat.Enabled 	= .T.
		ThisFormset.frmEO.pf1.pgQA.spnTest.Enabled 	= .T.
		ThisFormset.frmEO.pf1.pgQA.spnAbrsv.Enabled = .T.
		ThisFormset.frmEO.pf1.pgQA.spnBSaw.Enabled 	= .T.
		ThisFormset.frmEO.pf1.pgQA.spnShear.Enabled = .T.
		ThisFormset.frmEO.pf1.pgQA.spnPlasma.Enabled= SalesQuote.Plasma
		ThisFormset.frmEO.pf1.pgQA.spnWJet.Enabled	= SalesQuote.wjet
		
		*************************
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tmpSalesNo1')
			USE IN tmpSalesNo1
		ENDIF
		
		cSQL = "SELECT pSoldAddr, pShipAddr, ShipRoute, PayType, Amendment, Changing, PrintedSO, Cncld, Cmplt, ShopRecv, WebNum "
		cSQL = cSQL + " FROM dbo.Sales_No WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSalesNo1')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSalesNo1')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesNo1")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesNo1")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSalesNo1')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpSalesNo1')
			IF RECCOUNT('tmpSalesNo1') > 0
				
				ThisFormSet.nAmendment								= PrepareSQLnum(tmpSalesNo1.Amendment,'Amendment',2,0)
				ThisFormSet.frmEO.pf1.pgQA.txtVersion.Value			= ThisFormSet.nAmendment
				ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value	= ThisFormSet.nAmendment
				
				ThisFormSet.lPrintedSO								= PrepareSQLchk(tmpSalesNo1.PrintedSO,'PrintedSO')
				ThisFormSet.frmEO.pf1.pgQA.chkPrintedSO.Value		= ThisFormSet.lPrintedSO
				ThisFormSet.frmEO.pf1.pgBillTo.chkPrintedSO.Value	= ThisFormSet.lPrintedSO
				
				ThisFormSet.lChangingSO								= PrepareSQLchk(tmpSalesNo1.Changing,'Changing')
				ThisFormSet.frmEO.pf1.pgQA.chkChanging.Value		= ThisFormSet.lChangingSO
				ThisFormSet.frmEO.pf1.pgBillTo.chkSOchanging.Value	= ThisFormSet.lChangingSO
				
				ThisFormSet.lShopRecvSO								= PrepareSQLchk(tmpSalesNo1.ShopRecv,'ShopRecv')
				ThisFormSet.frmEO.pf1.pgQA.chkShopRecv.Value		= ThisFormSet.lShopRecvSO
				ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
				
				ThisFormSet.frmEO.pf1.pgQA.chkSNComplete.Value	= PrepareSQLchk(tmpSalesNo1.Cmplt,'Cmplt')
				ThisFormSet.frmEO.pf1.pgQA.chkSNCancelled.Value	= PrepareSQLchk(tmpSalesNo1.Cncld,'Cncld')
				ThisFormSet.frmEO.pf1.pgQA.txtWebNum.Value		= PrepareSQLnum(tmpSalesNo1.WebNum,'WebNum',-4)
		
				*ThisFormSet.cPaymentType						= ShowSQLtxt(tmpSalesNo1.PayType,'PayType',10)
				*ThisFormSet.SoldAddr							= PrepareSQLnum(tmpSalesNo1.pSoldAddr,'pSoldAddr',-3)
				*ThisFormSet.ShipAddr							= PrepareSQLnum(tmpSalesNo1.pShipAddr,'pShipAddr',-3)
		
			ENDIF
			USE IN tmpSalesNo1
		ENDIF
		
		*************************
		
		IF USED('tmpSales_No_Rev')
			ThisFormSet.frmEO.pf1.pgQA.grdAmend.RecordSource = ""
			USE IN tmpSales_No_Rev
		ENDIF
		
		cSQL = "SELECT [ID],[SalesNum],[WHEN],[Ver],[Comment] "
		cSQL = cSQL + " FROM dbo.Sales_No_Rev WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.SalesNum))
		cSQL = cSQL + " ORDER BY [WHEN] DESC "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"tmpSales_No_Rev")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_No_Rev')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_No_Rev")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_No_Rev")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSales_No_Rev')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		PRIVATE lShowRev
		lShowRev = .T.
		
		IF USED('tmpSales_No_Rev')
			IF RECCOUNT('tmpSales_No_Rev') > 0
				ThisFormSet.frmEO.pf1.pgQA.grdAmend.RecordSource = "tmpSales_No_Rev"
				*ThisFormSet.frmEO.pf1.pgQA.grdAmend.AfterRowColChange
			ELSE
				lShowRev = .F.
			ENDIF
		ELSE
			lShowRev = .F.
			
			IF ThisFormSet.nAmendment > 0
				
				*Set_Sales_No_Rev (ThisFormSet.SalesNum,ThisFormSet.nAmendment,ThisFormSet.nConnHandle)
				PRIVATE cSQL,nSQLEXEC 
				cSQL= "INSERT INTO dbo.Sales_No_Rev ([SalesNum],[VER],[Comment]) VALUES ("
				cSQL = cSQL +""+STR(ThisFormSet.SalesNum)
				cSQL = cSQL +","+STR(ThisFormSet.nAmendment)
				cSQL = cSQL +",'timestamp'" +")"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC,'')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ELSE
						nSQLexec = 1
					ENDIF
				ENDIF
				
				IF nSQLEXEC > 0
					Save_Sales_Status( ThisFormSet.SalesNum, "Version", "Version was changed to "+ALLTRIM(STR(ThisFormSet.nAmendment)), ThisFormSet.nConnHandle )
				ENDIF
		
			ENDIF
		ENDIF
		
		IF lShowRev
			ThisFormSet.frmEO.pf1.pgQA.grdAmend.Visible = .T.
			ThisFormSet.frmEO.pf1.pgQA.lblVer.Visible = .T.
			ThisFormSet.frmEO.pf1.pgQA.lblVerDate.Visible = .T.
			ThisFormSet.frmEO.pf1.pgQA.txtVer.Visible = .T.
			ThisFormSet.frmEO.pf1.pgQA.txtVerDate.Visible = .T.
			
			ThisFormSet.frmEO.pf1.pgQA.cmdAddQA.Visible = .T.
			ThisFormSet.frmEO.pf1.pgQA.cmdEditQA.Visible = .T.
			ThisFormSet.frmEO.pf1.pgQA.cmdCancelEdit.Visible = .F.
			ThisFormSet.frmEO.pf1.pgQA.cmdAmendmentsPrint.Visible = .T.
			
			ThisFormSet.Sales_No_RevID = tmpSales_No_Rev.ID
			
			ThisFormSet.frmEO.pf1.pgQA.edtVersionComments.Value = tmpSales_No_Rev.Comment
			ThisFormSet.frmEO.pf1.pgQA.txtVer.Value 			= tmpSales_No_Rev.Ver
			ThisFormSet.frmEO.pf1.pgQA.txtVerDate.Value			= tmpSales_No_Rev.when
			
			ThisFormSet.frmEO.pf1.pgQA.grdAmend.SetFocus()
			
		ELSE
			ThisFormSet.frmEO.pf1.pgQA.edtVersionComments.Value = "Save a comment here when you after you create a new Version"
			ThisFormSet.frmEO.pf1.pgQA.grdAmend.Visible = .F.
			ThisFormSet.frmEO.pf1.pgQA.lblVer.Visible = .F.
			ThisFormSet.frmEO.pf1.pgQA.lblVerDate.Visible = .F.
			ThisFormSet.frmEO.pf1.pgQA.txtVer.Visible = .F.
			ThisFormSet.frmEO.pf1.pgQA.txtVerDate.Visible = .F.
		
			ThisFormSet.frmEO.pf1.pgQA.cmdAddQA.Visible = .T.
			ThisFormSet.frmEO.pf1.pgQA.cmdEditQA.Visible = .F.
			ThisFormSet.frmEO.pf1.pgQA.cmdCancelEdit.Visible = .F.
			ThisFormSet.frmEO.pf1.pgQA.cmdAmendmentsPrint.Visible = .F.
			
			ThisFormSet.Sales_No_RevID = 0
		ENDIF
		
		
	ENDPROC

	PROCEDURE refresh_pgquote
		*ThisFormSet.Refresh_pgQuote()
		IF USED('SalesQuote')
			ThisFormSet.frmEO.pF1.pgQuote.txtPO_Num.Value	= ShowSQLtxt(SalesQuote.PO_Num,'PO_num',20)
			ThisFormSet.frmEO.pf1.pgQuote.txtItem.Refresh
			ThisFormSet.frmEO.pf1.pgQuote.txtItemTot.Refresh
			
			ThisFormSet.frmEO.pF1.pgQuote.txtCompany.Value	= ShowSQLtxt(SalesQuote.Company,'Company',30,.F.,.T.)
			ThisFormSet.frmEO.pF1.pgQuote.txtName.Value		= ShowSQLtxt(SalesQuote.Name,'Name',25)
			ThisFormSet.frmEO.pF1.pgQuote.txtCountryC.Value	= UPPER(ShowSQLtxt(SalesQuote.CountryC,'CountryC',10))
			ThisFormSet.frmEO.pF1.pgQuote.txtPhone_ext.Value= ShowSQLtxt(SalesQuote.Phone_Ext,'Phone_Ext',6)
			
			ThisFormSet.frmEO.pF1.pgQuote.txtAlloy.Value	= ShowSQLtxt(SalesQuote.Alloy,'Alloy',12)
			ThisFormSet.frmEO.pF1.pgQuote.cmbForm.Value		= ShowSQLtxt(SalesQuote.Form,'From',2)
			ThisFormSet.RefreshForms(0)
			ThisFormSet.frmEO.pF1.pgQuote.cmbCC.Value		= ShowSQLtxt(SalesQuote.CC,'CC',1)
			ThisFormSet.CC 									= ShowSQLtxt(SalesQuote.CC,'CC',1)
			ThisFormSet.RefreshCL()
			ThisFormSet.frmEO.pF1.pgQuote.cmbCL.Value		= ShowSQLtxt(SalesQuote.CL,'CL',1)
			
			ThisFormSet.frmEO.pF1.pgQuote.txtPieces.Value	= PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
			ThisFormSet.frmEO.pF1.pgQuote.txtThck.Value		= PrepareSQLnum(SalesQuote.Thck,'Thck',10,4)
			ThisFormSet.frmEO.pF1.pgQuote.txtSz2.Value		= PrepareSQLnum(SalesQuote.Sz2,'Sz2',9,3)
			ThisFormSet.frmEO.pF1.pgQuote.txtSz3.Value		= PrepareSQLnum(SalesQuote.Sz3,'Sz3',9,3)
			ThisFormSet.frmEO.pF1.pgQuote.txtPhone.Value	= ShowSQLtxt(SalesQuote.Phone,'Phone',10)
			
			ThisFormSet.frmEO.pF1.pgQuote.chkRL.Value		= PrepareSQLchk(SalesQuote.RandLen,'RandLen')
			ThisFormSet.frmEO.pF1.pgQuote.chkMetric.Value	= PrepareSQLchk(SalesQuote.Metric,'Metric')
			ThisFormSet.frmEO.pF1.pgQuote.chkServices.Value	= PrepareSQLchk(SalesQuote.Services,'Services')
			
			ThisFormSet.frmEO.pF1.pgQuote.txtDescript.Value	= ShowSQLtxt(SalesQuote.Descript,'Descript',50)
			ThisFormSet.frmEO.pF1.pgQuote.txtSalesP.Value	= ShowSQLtxt(SalesQuote.SalesP,'SalesP',1)
			ThisFormSet.frmEO.pF1.pgQuote.txtQComments.Value	= ShowSQLtxt(SalesQuote.Comments,'Comments',-1)
			
			ThisFormSet.frmEO.pF1.pgQuote.chkDShip.Value	= PrepareSQLchk(SalesQuote.dShip,'dShip')		&&Sales
			ThisFormSet.frmEO.pF1.pgQuote.txtShipDue.Value	= PrepareSQLdate(SalesQuote.ShipDue,'ShipDue')	&&Sales
			ThisFormSet.frmEO.pf1.pgQuote.cmbUrgent.Value	= ShowSQLtxt(SalesQuote.Urgent,'Urgent',1)		&&Sales
			ThisFormSet.frmEO.pF1.pgQuote.chkShipOn.Value	= PrepareSQLchk(SalesQuote.ShipOn,'ShipOn')		&&Sales
			ThisFormSet.frmEO.pF1.pgQuote.txtLeadTime.Value	= ShowSQLtxt(SalesQuote.LeadTime,'LeadTime',15)
			
			ThisFormSet.frmEO.pF1.pgQuote.txtPartNo.Value	= ShowSQLtxt(SalesQuote.PartNo,'PartNo',100) 	&&Sales
			ThisFormSet.frmEO.pF1.pgQuote.txtOrderSpec.Value= ShowSQLtxt(SalesQuote.OrderSpec,'OrderSpec',60) &&Sales
			*ThisFormSet.frmEO.pF1.pgQuote.txtHeat.Value		= ShowSQLtxt(SalesQuote.Heat,'Heat',50) 			&&Sales
			ThisFormSet.frmEO.pF1.pgQuote.edtQuote_S_Instrct.Value	= ShowSQLtxt(SalesQuote.S_Instrct,'S_Instrct',-1) &&Sales
			
			ThisFormSet.frmEO.pF1.pgQuote.txtWeight.Value	= PrepareSQLnum(SalesQuote.Weight,'Weight',9,1)
			ThisFormSet.frmEO.pF1.pgQuote.txtP_LB.Value		= PrepareSQLnum(SalesQuote.P_LB,'P_Lb',9,2)
			ThisFormSet.frmEO.pF1.pgQuote.txtP_Pc.Value		= PrepareSQLnum(SalesQuote.P_Pc,'P_Pc',9,2)
			ThisFormSet.frmEO.pF1.pgQuote.txtP_Ft.Value		= PrepareSQLnum(SalesQuote.P_Ft,'P_Ft',9,2)
			ThisFormSet.frmEO.pF1.pgQuote.txtCuts.Value		= PrepareSQLnum(SalesQuote.Cuts,'Cuts',8,2)
			ThisFormSet.frmEO.pF1.pgQuote.txtOtherFld.Value	= ShowSQLtxt(SalesQuote.OtherFld,'OtherFld',10)
			ThisFormSet.frmEO.pF1.pgQuote.txtOtherP.Value	= PrepareSQLnum(SalesQuote.OtherP,'OtherP',8,2)
			ThisFormSet.frmEO.pF1.pgQuote.txtLotP.Value		= PrepareSQLnum(SalesQuote.LotP,'LotP',9,2)
			
			ThisFormSet.frmEO.pF1.pgQuote.cmbPU.Value		= PrepareSQLnum(SalesQuote.Q_PU,'Q_PU',-1)
			ThisFormSet.RefreshPU()
			ThisFormSet.frmEO.pF1.pgQuote.Q_P1.Value		= PrepareSQLnum(SalesQuote.Q_P,'Q_P',-5)
			ThisFormSet.frmEO.pF1.pgQuote.Q_QTY1.Value		= PrepareSQLnum(SalesQuote.Q_QTY,'Q_QTY',-5)
			ThisFormSet.frmEO.pF1.pgQuote.Q_Total1.Value	= PrepareSQLnum(SalesQuote.Q_Total,'Q_Total',10,2)
			
			*Calculate ItemSale!!
			ThisFormSet.frmEO.pF1.pgQuote.txtItemSale.Value	= PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',9,2)	 &&Sales
			ThisFormSet.frmEO.pF1.pgQuote.txtItemCost.Value	= PrepareSQLnum(SalesQuote.ItemCost,'ItemCost',9,2)	 &&Sales
			
			IF PrepareSQLlogic(SalesQuote.StartStock,'StartStock',.F.)
				ThisFormset.frmEO.pf1.pgQuote.lblStartingStock.BackColor = RGB(255,255,128)
				ThisFormSet.ShowStartStock()
			ELSE
				*Default
				ThisFormset.frmEO.pf1.pgQuote.lblStartingStock.BackColor = RGB(192,192,192)
				ThisFormSet.ShowStartStock('EMPTY')
			ENDIF
		
		ELSE
			MESSAGEBOX("Lost table 'SalesQuote'",16,"Quit")
		ENDIF
	ENDPROC

	PROCEDURE refresh_pgshipto
		*ThisFormSet.Refresh_pgShipTo()
		*IF NOT USED('Sales_No')	&&just refresh!
		*	ThisFormSet.Load_Sales_No()
		*ENDIF
		
		PRIVATE cCustID
		cCustID = ShowSQLtxt(SalesQuote.CustID,'CustID',20)
		IF USED('Sales_No')
			ThisFormSet.frmEO.pf1.pgShipto.txtAddr_Ref.Value = ShowSQLtxt(Sales_No.Addr_Ref,'Addr_Ref',40)
			ThisFormSet.frmEO.pf1.pgShipto.lblCustID.Caption = cCustID
			
			ThisFormSet.frmEO.pf1.pgShipto.chkReceivedPO.Value = PrepareSQLchk(Sales_No.Paper_PO,'Paper_PO')
			ThisFormSet.frmEO.pf1.pgShipto.chkBlindSO.Value	= PrepareSQLchk(Sales_No.Blind,'Blind')
			ThisFormSet.frmEO.pf1.pgShipto.cmbPayment.Value	= ShowSQLtxt(Sales_No.PayType,'PayType',10)
			ThisFormSet.frmEO.pf1.pgShipto.cmbFrtPayment.Value	= ShowSQLtxt(Sales_No.ShipPay,'ShipPay',12)
			ThisFormSet.frmEO.pf1.pgShipto.txtFreightEst.Value = PrepareSQLnum(Sales_No.FreightEst,'FreightEst',9,2)
				
			ThisFormSet.frmEO.pf1.pgShipto.cmbTarfBill.Value = ShowSQLtxt(Sales_No.TarfBill,'TarfBill',10)
		
			ThisFormSet.frmEO.pf1.pgShipto.chkUSA.Value		= PrepareSQLchk(Sales_No.USA,'USA')
			ThisFormSet.frmEO.pf1.pgShipto.chkECPC.Value	= PrepareSQLchk(Sales_No.ECPC,'ECPC')
			ThisFormSet.frmEO.pf1.pgShipto.chkDPAS.Value	= PrepareSQLchk(Sales_No.DPAS,'DPAS')
			ThisFormSet.frmEO.pf1.pgShipto.chkFCI.Value		= PrepareSQLchk(Sales_No.FCI,'FCI')
			
		*!*		SELECT Sales_No	&&Sales_No does not have items detail
		*!*		REPLACE ShipRoute WITH cShipRouteSN IN Sales_No
		*!*		ThisFormSet.frmEO.pf1.pgShipto.txtShipRoute.Value = cShipRouteSN
							
			PRIVATE nMess,cShipRouteSN, cShipRouteCurr
			cShipRouteSN	= ALLTRIM(ShowSQLtxt(Sales_No.ShipRoute,'ShipRoute',20))
			cShipRouteCurr	= ALLTRIM(ShowSQLtxt(ThisFormSet.frmEO.pf1.pgShipto.txtShipRoute.Value,'ShipRoute',20))
			IF LEN(cShipRouteSN) = 0 
				IF LEN(cShipRouteCurr) > 0
					*nMess = MESSAGEBOX("Do you want to remove the Ship Route?"+CHR(13)+"Remove "+cShipRouteSN+" from the Sales_NO table?",4+32,"Clear Ship Route?")
					*IF nMess = 7
						ThisFormSet.frmEO.pf1.pgShipto.txtShipRoute.Value = ''
						SELECT Sales_No	&&Sales_No does not have items detail
						REPLACE ShipRoute WITH '' IN Sales_No
					*ELSE
					*	*No change
					*ENDIF
				ENDIF
			ELSE		&&cShipRouteSN has data
				IF LEN(cShipRouteCurr) > 0
					IF cShipRouteCurr != cShipRouteSN
						*nMess = MESSAGEBOX("Do you want to use the Ship Route "+cShipRouteSN+" ?"+CHR(13)+"ShipRoute is "+cShipRouteCurr ,4+32,"Replace Ship Route?")
						*IF nMess = 7
							ThisFormSet.frmEO.pf1.pgShipto.txtShipRoute.Value = cShipRouteSN
							SELECT Sales_No	&&Sales_No does not have items detail
							REPLACE ShipRoute WITH cShipRouteSN IN Sales_No
						*ELSE
						*	*No change
						*ENDIF
					ELSE
						*No change, already the same
					ENDIF
				ELSE
					ThisFormSet.frmEO.pf1.pgShipto.txtShipRoute.Value = cShipRouteSN
					SELECT Sales_No	&&Sales_No does not have items detail
					REPLACE ShipRoute WITH cShipRouteSN IN Sales_No
				ENDIF
			ENDIF
			
			cShipRouteCurr	= ALLTRIM(ShowSQLtxt(ThisFormSet.frmEO.pf1.pgShipto.txtShipRoute.Value,'ShipRoute',20))
			IF ASCAN(aShipRoutes, cShipRouteCurr )  > 0
				*Global Position for Array aShipRoutes
				gnPos = ASCAN(aShipRoutes, cShipRouteCurr ) 
			ENDIF
		
			ThisFormSet.frmEO.pf1.pgShipto.txtFreightEst.Value	= PrepareSQLnum(Sales_No.FreightEst,'FreightEst',9,2)
			REPLACE FreightEst WITH ThisFormSet.frmEO.pf1.pgShipto.txtFreightEst.Value IN Sales_No
			
			ThisFormSet.frmEO.pf1.pgShipto.txtInstrct.Value	= ShowSQLtxt(Sales_No.Instrct,'Instrct',100)
			REPLACE Instrct WITH ThisFormSet.frmEO.pf1.pgShipto.txtInstrct.Value IN Sales_No
			
			REPLACE CustID WITH cCustID IN Sales_No
			PRIVATE cAcctPayTypeNum
			cAcctPayTypeNum = GetPayTypeNum( cCustID, SalesQuote.Company, ThisFormSet.Soldaddr, ThisFormSet.nConnHandle )
			IF LEN(cAcctPayTypeNum) = 0
				ThisFormset.frmEO.pf1.pgShipto.txtAvailTerm.Value = ''
			ELSE
				ThisFormset.frmEO.pf1.pgShipto.txtAvailTerm.Value = ShowPaymentTypeText( cAcctPayTypeNum )
			ENDIF
			
			
				
		ELSE
			TrackError("Lost Sales_No","Table Sales_No is not opened",PROGRAM(),LINENO(1) )
		ENDIF
		
		ThisFormset.frmEO.pf1.pgShipto.Refresh()
		**********************************************
		
		IF ThisFormSet.ShipAddr > 0
			ThisFormSet.frmEO.pf1.pgShipto.txtShipCode.Value = ThisFormSet.ShipAddr
			
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			
			cSQL = "SELECT * FROM dbo.ShipAddr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE ShipCode = "+STR(ThisFormSet.ShipAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SolaShipAddrdAddr")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aShipAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('aShipAddr')
				SELECT aShipAddr
				ThisFormSet.frmEO.pf1.pgShipto.txtCompany.Value 	= aShipAddr.Company
				ThisFormSet.frmEO.pf1.pgShipto.txtAddr1.Value		= aShipAddr.Addr1	
				ThisFormSet.frmEO.pf1.pgShipto.txtAddr2.Value		= aShipAddr.Addr2
				ThisFormSet.frmEO.pf1.pgShipto.txtCity.Value 		= aShipAddr.City	
				ThisFormSet.frmEO.pf1.pgShipto.txtST.Value			= aShipAddr.ST
				ThisFormSet.frmEO.pf1.pgShipto.txtZip.Value			= aShipAddr.Zip
				ThisFormSet.frmEO.pf1.pgShipto.txtCountry.Value		= UPPER(ALLTRIM(aShipAddr.Country))
				ThisFormSet.frmEO.pf1.pgShipto.txtContact.Value		= aShipAddr.Contact
				ThisFormSet.frmEO.pf1.pgShipto.txtPhone.Value		= aShipAddr.Telephone
				ThisFormSet.frmEO.pf1.pgShipto.txtFax.Value			= aShipAddr.Fax_Number
				ThisFormSet.frmEO.pf1.pgShipto.txtEmail.Value		= aShipAddr.Email
				ThisFormSet.frmEO.pf1.pgShipto.txtLastEdit.Value	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
					
				ThisFormSet.Address_Screen("ShipToEdit")
				
				USE IN aShipAddr
			ENDIF
		ENDIF
		**********************************************
	ENDPROC

	PROCEDURE refresh_pgvalue
		*ThisFormSet.Refresh_pgValue()
		
		ThisFormSet.frmEO.pf1.pgValue.Refresh()
		
	ENDPROC

	PROCEDURE refresh_quotep		&& Calls RefreshPU
		PARAMETER pFrom
		*ThisFormSet.Refresh_QuoteP()
		*pFrom = 'Q_P','Q_QTY','lblSOiTotal','Pieces','Thck','Sz2','Sz3','Weight','Cuts','OtherP','Cost'
		
		*Calc Weight/Pounds
		PRIVATE cAlloy, cForm, nPieces, nThck, nSz2, nSz3
		cAlloy		= ShowSQLtxt(ThisFormSet.FrmEO.pf1.pgQuote.txtAlloy.VALUE,'Alloy',12,.F.)
		cForm		= ShowSQLtxt(ThisFormSet.FrmEO.pf1.pgQuote.cmbForm.VALUE,'Form',2,.T.)
		nPieces		= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.txtPieces.Value,'Pieces',-3)
		nThck		= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.txtThck.VALUE,'Thck',10,4)
		nSz2		= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.txtSz2.VALUE,'Sz2',9,3)
		nSz3		= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.txtSz3.VALUE,'Sz3',9,3)
		PRIVATE nCalcPound, nWeight, nQ_PU
		nCalcPound		= CalcWeight (nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisFormSet.nConnHandle)
		nWeight		= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.txtWeight.Value,'Weight',9,1)
		nQ_PU		= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.cmbPU.Value,'PU',-1)
		*nQ_PU 		= PrepareSQLnum(SalesQuote.Q_PU,'Q_PU',-1)
		
		IF nQ_PU = 1
			*Q_Qty is QTY to use over Weight field
			nWeight = PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.Q_QTY1.Value,'Weight',9,1)
		ENDIF
		
		
		IF nCalcPound > 0
			IF nWeight > 0
				IF ROUND(nCalcPound,1) # ROUND(nWeight,1)
					PRIVATE cMess
		
					cMess = "Calculated weight is "+ALLTRIM(STR(nCalcPound,9,1))+"."+CHR(13)+"Quoted weight is "+ALLTRIM(STR(nWeight,9,1))+"."+CHR(13)+CHR(13)+"Do you want to use the calculated Weight?"
					IF nQ_PU = 1
						cMess = cMess + CHR(13)+CHR(13)+"Since this was Quoted Per Pound"+CHR(13)+"The Quoted Total will be changed also."
					ENDIF
					
					IF MESSAGEBOX(cMess,4+48,"Replace Quoted Weight?") = 6
		
						ThisFormSet.FrmEO.pf1.pgQuote.txtWeight.Value = nCalcPound
						SELECT SalesQuote
						REPLACE SalesQuote.Weight WITH nCalcPound
						REPLACE SalesQuote.S_QTY WITH nCalcPound
						
						*IF GetPUfromForm(cForm, ThisFormSet.nConnHandle) = 1	&&Acct Stnd
						IF nQ_PU = 1
							*Price is based on Weight, this weight change, changes Q_Total
							PRIVATE nQ_P, nQ_QTY, nQ_Total
							nQ_P = PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.Q_P1,'Q_P',-5)
							nQ_QTY = nCalcPound
							
							PRIVATE nCutsP, nOtherP, nS_total, nItemSale 
							nCutsP		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtCuts.Value,'Cuts',8,2)
							nOtherP		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtOtherP.Value,'OtherP',8,2)
		
							nQ_Total = PrepareSQLnum( ( nQ_QTY * nQ_P ),'Q_Total',10,2)
							nS_Total  = nQ_Total +nCutsP +nOtherP 
							nItemSale = nQ_Total +nCutsP +nOtherP
				
							IF nQ_Total > 0
								REPLACE SalesQuote.Q_Total WITH nQ_Total 
								REPLACE SalesQuote.S_Total WITH nS_Total
								REPLACE SalesQuote.ItemSale WITH nItemSale 
								
								ThisFormSet.FrmEO.pf1.pgQuote.Q_Total1.Value = nQ_Total 
								ThisFormSet.FrmEO.pf1.pgQuote.txtItemSale.Value = nItemSale 
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ELSE
				*nWeight is zero
				ThisFormSet.FrmEO.pf1.pgQuote.txtWeight.Value = nCalcPound
				SELECT SalesQuote
				REPLACE SalesQuote.Weight WITH nCalcPound
			ENDIF
		ENDIF		
		
		
		*******************************************************************
		ThisFormSet.RefreshPU()  &&Use nQ_Total to adjust to new PU
	ENDPROC

	PROCEDURE refresh_salesquote
		PARAMETERS nRecNo
		*ThisFormSet.Refresh_SalesQuote(1)
		*worksheet.frx uses this data - Also used in Shop_StockLst_Edit
		
		IF VARTYPE(nRecNo) != "N"
			nRecNo = 1
		ENDIF
		
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		cSQL = " SELECT "
		cSQL = cSQL + "  A.Company,A.name,A.phone,A.phone_ext,A.fax,A.phone_ext,A.email,A.PO_num,A.alloy,a.form,A.cc,A.CL,A.pieces,A.thck,A.Sz2,A.sz3,A.weight,A.descript"
		cSQL = cSQL + " ,a.p_lb,A.p_pc,A.p_ft,a.cuts,A.otherfld,A.otherp,A.lotp,A.lotcost,A.leadtime,A.cweight,A.cp_lb,A.cp_lb,A.cp_pcc,A.cthk"
		cSQL = cSQL + " ,A.clotcp,A.clotp,A.ccut,A.Inqdate,A.Inqnum,A.InqNumP,A.SalesP"
		cSQL = cSQL + " ,A.HPApo,A.POitem,A.saledate,A.shipdate,A.buyfrom,A.buycost,A.buyfrom2,A.HPApo2,A.open_,A.Bracket,A.CustID,A.QuoteMemo,A.Comments"
		cSQL = cSQL + " ,A.CountryC,A.Country,A.Services,A.RandLen,A.Metric,A.StartStock,A.TN,A.sz1orig,A.sz2orig,A.sz3orig,A.QuoteDate"
		cSQL = cSQL + " ,A.Cover,A.ID,A.line1 "
		*--,A.cut
		*--,A.WO
		cSQL = cSQL + " ,A.CutOptions,A.Cut,A.CutHR "
		cSQL = cSQL + " ,A.SalesNum AS SalesNum_a, A.SOitem AS SOitem_a, A.Item AS Item_a "
		
		cSQL = cSQL + " ,S.SOitem,S.SalesNum,S.item,S.OrderSpec,S.S_Instrct,S.Inv,S.BRK"
		cSQL = cSQL + ",S.GFM,S.Draw,S.Roll,S.Press,S.Mach,S.CG,S.Plasma,S.WJet,S.ColdSaw,S.Cert"
		*cSQL = cSQL + " ,S.Heat"
		*cSQL = cSQL + " ,S.converpo,S.converter,S.conversion,S.converfrt,S.conversent,S.converretu"
		cSQL = cSQL + " ,S.itemtot,S.shipdue,S.shipped "
		
		cSQL = cSQL + " ,S.matlwt "
		cSQL = cSQL + " ,S.cncld,S.cmplt,S.partno,S.itemcost,S.itemsale,S.gs_cost,S.gs_sale,S.gs_cmplt "
		*--,S.rma_no
		cSQL = cSQL + " ,S.RMA_Detail "
		cSQL = cSQL + " ,S.qa,S.cofc,s.merc,S.ppo,S.ppn,S.pheat,S.pspec,S.pdesc,S.pother,S.other "
		cSQL = cSQL + " ,S.prcp,S.prcd,S.pckd,S.Urgent,S.shipon,S.Tol,S.JobHours,S.ProcLoc,S.DShip,S.Typ "
		cSQL = cSQL + " ,S.WO,S.StkPaid,S.WO_Detail "
		cSQL = cSQL + " ,S.ProductionWO, S.IntP, S.Export, S.StkCost, S.POCost "
		
		cSQL = cSQL + " ,A.Q_PU, A.Q_QTY, A.Q_P, A.Q_Total" 
		cSQL = cSQL + " ,A.S_PU ,A.S_QTY, A.S_P, A.S_Total"
		cSQL = cSQL + " ,A.StandardSize, A.CustDisc, ISNULL(S.Hold,0) AS Hold " 
		
		*cSQL = cSQL + " ,S.PT_P, S.PT_QTY, S.PT_PU, S.PT_Total"  &&ERP Acct Stnd (PriceTable)
		*&&Use AllQuote A.S_QTY,A.S_PU over this Sales Data.
		
		
		*--cSQL = cSQL + " ,S.Q_PU ,S.Q_QTY, S.Q_P, S.Q_Total"
		*--cSQL = cSQL + " ,S.Quoted_QTY, S.Quoted_P, S.Quoted_Total, S.Quoted_PU"
		*--cSQL = cSQL + " ,S.Quoted_DollarTotal"
		*--cSQL = cSQL + " ,Quoted_CutsP, Quoted_OtherP "
		*--cSQL = cSQL + " ,S.Selected_QTY, S.Shipped_QTY"
		
		*cSQL = cSQL + " ,S.fPS_total, S.fPS_QTY, S.fRMA_Qty, S.fInv_QTY, S.fInv_Cost "
		
		cSQL = cSQL + " FROM dbo.AllQuotes A "
		cSQL = cSQL + " INNER JOIN dbo.Sales S ON A.SOitem = S.SOitem "
		*cSQL = cSQL + " INNER JOIN dbo.Sales_No SN ON A.SalesNum = SN.SalesNum "	
		cSQL = cSQL + " WHERE A.SalesNum = "+STR(ThisFormSet.SalesNum)
		cSQL = cSQL + " ORDER BY A.Item "
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'SalesQuote')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'SalesQuote')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SalesQuote")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SalesQuote")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'SalesQuote')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		
		IF nRecNo <= RECCOUNT('SalesQuote')
			GOTO nRecNo IN SalesQuote
		ENDIF
		
		*!*	*These use the ControlSource SalesQuote.
		*!*	ThisFormSet.frmEO.pf1.pgOrder.Refresh
		*!*	*WO_Production
		*!*	*IntP
		
		ThisFormset.frmEO.pf1.pgShipto.lblCustID.Caption = ShowSQLtxt(SalesQuote.CustID,'CustID',20)
		
		*ThisFormSet.pgRefresh()
		*********************
		DO CASE
			CASE ThisFormSet.frmEO.pf1.ActivePage = 1	&&EnterOrder
				ThisFormSet.Refresh_pgOrder()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 2	&&Quote
				ThisFormSet.Refresh_pgQuote()		
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 3	&&Value
				ThisFormSet.Refresh_pgValue()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 4	&&BillTo
				ThisFormSet.Refresh_pgBillTo()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 5	&&ShipTo
				ThisFormSet.Refresh_pgShipTo()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 6	&&Purchase
				ThisFormSet.Refresh_pgPurchase()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 7	&&CreditCard
				ThisFormSet.Refresh_pgCreditCard()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 8	&&Hrs QA
				ThisFormSet.Refresh_pgQA()	
		ENDCASE
		
	ENDPROC

	PROCEDURE refresh_worksheet
		PARAMETERS nRecNo
		*ThisFormSet.Refresh_WorkSheet(1)
		*Like Refresh_SalesQuote
		IF VARTYPE(nRecNo) != "N"
			nRecNo = 1
		ENDIF
		
		IF USED('WorkSheet')
			USE IN WorkSheet
		ENDIF
		
		cSQL = " SELECT "
		cSQL = cSQL + "  A.Company,A.name,A.phone,A.phone_ext,A.fax,A.phone_ext,A.email,A.PO_num,A.alloy,a.form,A.cc,A.CL,A.pieces,A.thck,A.Sz2,A.sz3,A.weight,A.descript"
		cSQL = cSQL + " ,a.p_lb,A.p_pc,A.p_ft,a.cuts,A.otherfld,A.otherp,A.lotp,A.lotcost,A.leadtime,A.cweight,A.cp_lb,A.cp_lb,A.cp_pcc,A.cthk"
		cSQL = cSQL + " ,A.clotcp,A.clotp,A.ccut,A.Inqdate,A.Inqnum,A.InqNumP,A.SalesP"
		cSQL = cSQL + " ,A.HPApo,A.POitem,A.saledate,A.shipdate,A.buyfrom,A.buycost,A.buyfrom2,A.HPApo2,A.open_,A.Bracket,A.CustID,A.QuoteMemo,A.Comments"
		cSQL = cSQL + " ,A.CountryC,A.Country,A.Services,A.RandLen,A.Metric,A.StartStock,A.TN,A.sz1orig,A.sz2orig,A.sz3orig,A.QuoteDate"
		cSQL = cSQL + " ,A.Cover,A.ID,A.line1 "
		*--,A.cut
		*--,A.WO
		cSQL = cSQL + " ,A.CutOptions,A.Cut,A.CutHR "
		cSQL = cSQL + " ,A.SalesNum AS SalesNum_a, A.SOitem AS SOitem_a, A.Item AS Item_a "
		
		cSQL = cSQL + " ,S.SOitem,S.SalesNum,S.item,S.OrderSpec,S.S_Instrct,S.Inv,S.BRK"
		cSQL = cSQL + ",S.GFM,S.Draw,S.Roll,S.Press,S.Mach,S.CG,S.Plasma,S.WJet,S.ColdSaw,S.Cert"
		*cSQL = cSQL + " ,S.Heat"
		*cSQL = cSQL + " ,S.converpo,S.converter,S.conversion,S.converfrt,S.conversent,S.converretu"
		cSQL = cSQL + " ,S.itemtot,S.shipdue,S.shipped "
		
		cSQL = cSQL + " ,S.matlwt "
		cSQL = cSQL + " ,S.cncld,S.cmplt,S.partno,S.itemcost,S.itemsale,S.gs_cost,S.gs_sale,S.gs_cmplt "
		*--,S.rma_no
		cSQL = cSQL + " ,S.RMA_Detail "
		cSQL = cSQL + " ,S.qa,S.cofc,s.merc,S.ppo,S.ppn,S.pheat,S.pspec,S.pdesc,S.pother,S.other "
		cSQL = cSQL + " ,S.prcp,S.prcd,S.pckd,S.Urgent,S.shipon,S.Tol,S.JobHours,S.ProcLoc,S.DShip,S.Typ "
		cSQL = cSQL + " ,S.WO,S.StkPaid,S.WO_Detail "
		cSQL = cSQL + " ,S.ProductionWO, S.IntP, S.Export, S.StkCost, S.POCost "
		
		cSQL = cSQL + " ,A.Q_PU, A.Q_QTY, A.Q_P, A.Q_Total"
		cSQL = cSQL + " ,A.S_PU ,A.S_QTY, A.S_P, A.S_Total"	
		cSQL = cSQL + " ,A.StandardSize, A.CustDisc, ISNULL(S.Hold,0) AS Hold " 
		
		*cSQL = cSQL + " ,S.PT_P, S.PT_QTY, S.PT_PU, S.PT_Total"  &&ERP Acct Stnd (PriceTable)
		*&&Use AllQuote A.S_QTY,A.S_PU over this Sales Data.
		
		*--cSQL = cSQL + " ,S.Q_PU ,S.Q_QTY, S.Q_P, S.Q_Total, S.Q_PU"
		*--cSQL = cSQL + " ,S.Quoted_QTY, S.Quoted_P, S.Quoted_Total, S.Quoted_PU"
		*--cSQL = cSQL + " ,S.Quoted_DollarTotal"
		*--cSQL = cSQL + " ,Quoted_CutsP, Quoted_OtherP "
		*--cSQL = cSQL + " ,S.Selected_QTY, S.Shipped_QTY"
		
		*cSQL = cSQL + " ,S.fPS_total, S.fPS_QTY, S.fRMA_Qty, S.fInv_QTY, S.fInv_Cost "
		
		*cSQL = cSQL + " ,dbo.f_Selected_Stock(S.SOitem) AS SelectdSTK "
		
		cSQL = cSQL + " FROM dbo.AllQuotes A "
		cSQL = cSQL + " INNER JOIN dbo.Sales S ON A.SOitem = S.SOitem "
		*cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process SP ON A.SOitem = SP.SOitem "
		*cSQL = cSQL + " AND ( SP.Process_ID = 'SELECTED' OR SP.Process_ID='PARTSELECT' )"
		*cSQL = cSQL + " AND SP.AllowSub = 'N' "
		*cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Detail SD ON SP.ID_Detail = SD.ID_Detail "
		*cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Master SM ON SD.ID = SM.ID "
		cSQL = cSQL + " WHERE A.SalesNum = "+STR(ThisFormSet.SalesNum)
		cSQL = cSQL + " ORDER BY A.Item "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'WorkSheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'WorkSheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "WorkSheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "WorkSheet")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'WorkSheet')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('WorkSheet')
			IF nRecNo <= RECCOUNT('WorkSheet')
				GOTO nRecNo IN WorkSheet
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE savecustomernotes
		PARAMETERS pCustomerNotes
		*SaveCustomerNotes()
		*ThisFormSet.frmCustomer.
		
		IF VARTYPE(pCustomerNotes) != "C"
			RETURN .F.
		ENDIF
		
		PRIVATE cCustomerText
		cCustomerText = PrepareSQLtxt(pCustomerNotes,'Customer Notes',-1)
		PRIVATE lFound
		lFound  = .F.
		
		PRIVATE cQuotesCompany,cHoldQuotesName,cCustID
		cQuotesCompany 	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCompany.Value,'Company',30) &&ThisFormset.QUOTES.Company1.Value,'Company',30)
		cHoldQuotesName	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtName.Value,'Name',25)     &&ThisFormset.QUOTES.NAME1.Value,'Name',25)
		cCustID			= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20) &&ThisFormSet.Quotes.CustID1.Value,'CustID',20)
		
		IF NOT EMPTY(cQuotesCompany) AND NOT EMPTY(cHoldQuotesName) AND NOT EMPTY(cCustomerText)
			PRIVATE nSQLEXEC, cSQL
			IF USED('tmpCntQC')
				USE IN tmpCntQC
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company = '"+cQuotesCompany+"' AND Name = '"+cHoldQuotesName+"'"
			IF NOT EMPTY(cCustID)
				cSQL = cSQL + " AND customer = '"+cCustID+"'"
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpCntQC' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpCntQC' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "tmpCntQC")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "tmpCntQC")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpCntQC')
			ENDIF
		
			IF USED('tmpCntQC')
				IF VARTYPE(tmpCntQC.Cntd) = 'N'
					IF tmpCntQC.Cntd > 0
						lFound = .T.
					ENDIf
				ENDIF
				USE IN 'tmpCntQC'
			ENDIF
		
			IF lFound
				cSQL = "UPDATE dbo.QuickCompany SET Notes = '"+cCustomerText+"' WHERE Company LIKE '"+cQuotesCompany+"%' AND Name LIKE '"+cHoldQuotesName+"%'"
				IF NOT EMPTY(cCustID)
					cSQL = cSQL + " AND customer = '"+cCustID+"'"
				ENDIF
		
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
				ENDIF
			ELSE
				
				PRIVATE cCustID,cCompany,cNAME,cCountryC,cPhone,cPhone_Ext,cFax,cEmail,cXcomp
				cCustID	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)+"'"
				cCompany= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCOMPANY.Value,'Company',30)
				cNAME	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtNAME.Value,'Name',25)
				cCountryC = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCountryC.Value,'CountryC',10)
				cPhone 	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtPhone.Value,'Phone',10)
				cPhone_Ext = PrepareSQLtxt(SalesQuote.Phone_Ext,'Phone_Ext',6)
				cFax	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtFax.Value,'Fax',10)
				cEmail	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtEmail.Value,'Email',60)
				cXcomp	= cPhone+SOUNDEX(cNAME)
				
				cSQL = "INSERT INTO dbo.QuickCompany (Customer,company,NAME,CountryC,Phone,Phone_Ext,Fax,Email,Xcomp,Notes) VALUES ( "
				cSQL = cSQL + " '"+cCustID+"'"
				cSQL = cSQL + ",'"+cCompany+"'"
				cSQL = cSQL + ",'"+cName+"'"								
				cSQL = cSQL + ",'"+cCountryC +"'"
				cSQL = cSQL + ",'"+cPhone+"'"
				cSQL = cSQL + ",'"+cPhone_Ext +"'"
				cSQL = cSQL + ",'"+cFax+"'"
				cSQL = cSQL + ",'"+cEmail+"'"
				cSQL = cSQL + ",'"+cXcomp+"'"
				cSQL = cSQL + ",'"+cCustomerText+"'"
				cSQL = cSQL + ")"
										
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
					WAIT WINDOW "Customer info NOT saved." NOWAIT
				ELSE
					WAIT WINDOW "Customer info saved to Quick Company notes." NOWAIT
				ENDIF												
			ENDIF
		ELSE
			WAIT WINDOW 'Cannot save without unique Company and Name or NO Content to save' NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE savemkt_custid
		PRIVATE cAlias, lReturn
		cAlias = ALIAS()
		lReturn = .T.
		
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE cMarketing
		cMarketing = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgBillTo.txtMarketing.Value,'Marketing',100)
		
		*ThisFormSet.SalesNum
		*cCustID = PrepareSQLtxt(ThisForm.pf1.pgOrder.txtCustID.Value,'CustID',20)
		IF LEN(cMarketing ) > 0
			cSQL = "UPDATE dbo.SoldAddr "
			cSQL = cSQL +" SET [Marketing]='"+cMarketing+"'"
			cSQL = cSQL +" WHERE SoldCode="+ALLTRIM(STR(ThisFormSet.SoldAddr))+""
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL,"" )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL,"" )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0 &&Try again!, long triger
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					lReturn = .F.
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
					RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ELSE
				RecordTest("Record Test Data.", "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
			ENDIF
		ENDIF
		
		RETURN lReturn
	ENDPROC

	PROCEDURE savequote
		*ThisFormSet.SaveQuote()
		*
		* The User places in the Quoted values
		* The S_ values are calulated OFF the Q_ numbers
		* This SaveQuote is the only procedure to update the Quoted values
		*
		IF USED('SalesQuote')
		ENDIF
		
		*ThisFormSet.Tighten_S_Total()
		ThisFormSet.Total_Quotes_Item()
		
		PRIVATE nRecNo, cSOitem, nItem
		nRecNo = RECNO('SalesQuote')
		
		cSOitem = Proper_PO_Item(SalesQuote.SOItem_A)
		nItem = PrepareSQLnum(SalesQuote.Item_A,'SOitem_Item',2,0)
		&&form is frmPO
		***********************************
		*Store OldData to compare changes with StockLst_Process
		PRIVATE cPO_NumO,cAlloyO,cFormO,cCCO,cCLO,nPiecesO,nThckO,nSz2O,nSz3O,nWeightO,nQ_PO,nQ_PUO,nQ_QTYO
		cPO_NumO	= ''
		cAlloyO	= ''
		cFormO	= ''
		cCCO	= ''
		cCLO 	= ''
		nPiecesO= 0
		nThckO	= 0
		nSz2O	= 0
		nSz3O	= 0
		nWeightO	= 0
		nQ_PO	= 0
		nQ_PUO	= 0
		nQ_QTYO	= 0
		
		IF USED('tmpAQO')
			USE IN tmpAQO
		ENDIF
		
		*Get Original Data --Not the edited data in use!!! 
		cSQL = "SELECT PO_Num,Alloy,Form,CC,CL,Pieces,Thck,Sz2,Sz3,Weight,Q_P,Q_QTY,Q_PU "
		cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ID = " + ALLTRIM(STR(SalesQuote.ID))
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL, 'tmpAQO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAQO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQO")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'tmpAQO')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpAQO')
			IF RECCOUNT('tmpAQO') > 0
				*Original Data
				cPO_NumO= PrepareSQLtxt(tmpAQO.PO_Num,'PO_num',20)
				cAlloyO	= PrepareSQLtxt(tmpAQO.Alloy,'Alloy',12)
				cFormO	= PrepareSQLtxt(tmpAQO.Form,'Form',2)
				cCCO	= PrepareSQLtxt(tmpAQO.CC,'CC',1)
				cCLO	= PrepareSQLtxt(tmpAQO.CL,'CL',1)
				nPiecesO= PrepareSQLnum(tmpAQO.Pieces,'Pieces',-3)
				nThckO	= PrepareSQLnum(tmpAQO.Thck,'Thck',10,4)
				nSz2O	= PrepareSQLnum(tmpAQO.Sz2,'Sz2',9,3)
				nSz3O	= PrepareSQLnum(tmpAQO.Sz3,'Sz2',9,3)
				nWeightO= PrepareSQLnum(tmpAQO.Weight,'Weight',8,1)
				nQ_PO	= PrepareSQLnum(tmpAQO.Q_P,'Q_P',-5)
				nQ_PUO	= PrepareSQLnum(tmpAQO.Q_PU,'Q_PU',-1)
				nQ_QTYO	= PrepareSQLnum(tmpAQO.Q_QTY,'Q_QTY',-5)
			ENDIF
			USE IN tmpAQO
		ENDIF
		
		***********************************
		*Store OldData to compare changes with current Sales save.
		PRIVATE dShipDueO, lShipOnO, cUrgentO
		dShipDueO = CTOD('')
		lShipOnO = .F.
		
		IF USED('tmpSalesO')
			USE IN tmpSalesO
		ENDIF
		
		*Get Original Data
		cSQL = "SELECT ShipDue, ShipOn, Urgent "
		cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"	
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL, 'tmpSalesO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSalesO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesO")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'tmpSalesO')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpSalesO')
			IF RECCOUNT('tmpSalesO') > 0
				*Original Data
				dShipDueO	= ShowSQLdate(tmpSalesO.ShipDue,'ShipDue')
				lShipOnO 	= PrepareSQLlogic(tmpSalesO.ShipOn,'ShipOn',.T.)
				cUrgentO 	= PrepareSQLtxt(tmpSalesO.Urgent,'Urgent',1)
			ENDIF
			USE IN tmpSalesO
		ENDIF
		
		***********************************
		
		PRIVATE cCompany,cName,cPhone,cPhone_Ext
		PRIVATE cPO_Num,cAlloy,cForm,cCC,cCL,nPieces,nThck,nSz2,nSz3,nWeight
		PRIVATE cDescript,cSalesP,nP_Lb,nP_Pc,nP_Ft,nCutsP,cOtherFld,nOtherP,nLotP
		PRIVATE cLeadTime,cQComments,cCountryC,lServices,lRandLen,lMetric
		
		cPO_Num		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtPO_NUM.Value,'PO_num',20)
		cCompany	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtCompany.Value,'Company',30,.F.,.T.)
		cName		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtName.Value,'Name',25)
		
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.cmbForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.cmbCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.cmbCL.Value,'CL',1)
		nPieces		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtPieces.Value,'Pieces',7,0)
		nThck		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtTHCK.Value,'Thck',10,4)
		nSz2		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtSz2.Value,'Sz2',9,3)
		nSz3		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtSz3.Value,'Sz3',9,3)
		
		lRandLen	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgQuote.chkRL.Value,'RL',.F.)
		lMetric		= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgQuote.chkMetric.Value,'Metric',.F.)
		lServices	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgQuote.chkServices.Value,'Services',.F.)
		
		cCountryC	= UPPER(ALLTRIM(PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtCountryC.Value,'CountryC',10)))
		cPhone		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtPhone.Value,'Phone',10)
		cPhone_Ext	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtPhone_Ext.Value,'Phone_Ext',6)
		
		cDescript	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtDESCRIPT.Value,'Descript',50)
		cSalesP		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtSalesP.Value,'SalesP',1)
		
		nWeight		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtWeight.Value,'Weight',8,1)
		nP_Lb		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtP_lb.Value,'P_Lb',8,2)
		nP_Pc		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtP_pc.Value,'P_Pc',9,2)
		nP_Ft		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtP_ft.Value,'P_Ft',8,2)
		nCutsP		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtCuts.Value,'Cuts',8,2)
		cOtherFld	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtOtherFld.Value,'OtherFld',10)
		nOtherP		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtOtherP.Value,'OtherP',8,2)
		nLotP		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtLotP.Value,'LotP',9,2)
		***************
		PRIVATE nQ_P,nQ_QTY,nQ_PU,nQ_Total
		nQ_P	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.Q_P1.Value,'Q_P',-5)
		nQ_QTY	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.Q_QTY1.Value,'Q_QTY',-5)
		nQ_PU	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.cmbPU.Value,'PU',-1)
		IF nQ_PU = 0
			nQ_PU	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.Q_PU1.Value,'PU',-1)
		ENDIF
		nQ_Total= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.Q_total1.Value,'Q_Total',10,2)
		
		********************************
		***** test values
		IF VAL(cForm) < 1
			MESSAGEBOX("Did not find a Form"+CHR(13)+"This must be fixed to be Saved",0+48,"Cannot save")
			RETURN .F.
		ENDIF
		
		***** end test values
		********************************
		
		IF EMPTY(nQ_Total)
			*nQ_Total = (nQ_QTY * nQ_P)
			nQ_Total = PrepareSQLnum( ( nQ_QTY * nQ_P ),'Q_Total',10,2)
		ENDIF
		
		PRIVATE nS_QTY,nS_P,nS_PU
		nS_QTY	= 0
		nS_P	= 0
		nS_PU	= 1
		*****
		IF nQ_Total = 0
			*Use old School Calc
			****************************************************
			*Use this Function to return a table with the Quoted Answers
			*This overwrite typical units and uses Units found in OtherFld and OtherP
			IF Get_Quote_Pricing(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, ThisFormSet.nConnHandle)
				IF USED('tmpQuote_Pricing')
					*nQ_P		= Get_Quote_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, ThisFormSet.nConnHandle)
					nQ_P	= PrepareSQLnum(tmpQuote_Pricing.P,'Q_P',-5)
					nQ_PU	= PrepareSQLnum(tmpQuote_Pricing.PU,'Q_PU',-1)
					nQ_QTY	= PrepareSQLnum(tmpQuote_Pricing.QTY,'Q_QTY',-5)
					nQ_Total= PrepareSQLnum(tmpQuote_Pricing.Total,'Q_Total',10,2)
					
					USE IN tmpQuote_Pricing
				ENDIF
			ENDIF
		ENDIF
		***
		nS_PU	= nPU_Acct_Form(cForm,ThisFormSet.nConnHandle)
		IF nQ_PU = nS_PU  && Quote is same AS Acct Std
			nS_QTY	= nQ_QTY
			nS_P	= nQ_P
			nS_Total = nQ_Total +nCutsP +nOtherP
		ELSE
			*Get QTY for Acct PU
			nS_QTY	= Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld,ThisFormSet.nConnHandle)
			IF nS_QTY > 0
				IF nQ_Total > 0
					nS_P = PrepareSQLnum(nQ_Total / nS_QTY ,'S_P',-5)  &&Q_Total +nCutsP +nOtherP = nItemSale
				ELSE
					IF (nS_Total -nCutsP -nOtherP) > 0
						nS_P = PrepareSQLnum((nS_Total -nCutsP -nOtherP)/ nS_QTY ,'S_P',-5)
					ENDIF
				ENDIF
			ELSE
				nS_P = 0
			ENDIF
		ENDIF
		
		
		***************
		nItemSale	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Value,'ItemSale',9,2)
		nItemCost	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.txtItemCost.Value,'ItemCost',9,2)
		
		cQComments	= ALLTRIM(PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtQComments.Value,'Comments',-1))
		cLeadTime	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtLeadTime.Value,'LeadTime',15)
		
		IF NOT USED('SalesQuote')
			TrackError( "Lost Table 'SalesQuote'","EditSalesOrder:SaveQuote",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		***************************************
		SELECT SalesQuote
		*-- Replace All moves the record pointer
		REPLACE ALL ;
			PO_Num WITH cPO_Num ; 
			,Company WITH cCompany;
			,[Name] WITH cName;
			,CountryC WITH cCountryC;
			,Phone WITH cPhone;
			,Phone_Ext WITH cPhone_Ext;
			IN SalesQuote
		
		SELECT SalesQuote
		IF nRecNo > 0 AND nRecNo <= RECCOUNT("SalesQuote")
			GOTO (nRecNo) IN SalesQuote
		ELSE
			IF nItem > 0 AND nItem <= RECCOUNT("SalesQuote")
				GOTO (nItem) IN SalesQuote
			ELSE
				GO BOTTOM
			ENDIF
		ENDIF
		
		IF NOT USED('SalesQuote')
			TrackError("Lost SalesQuote SOitem" + CHR(13)+cSOitem+CHR(13)+"SalesNum "+STR(ThisFormSet.SalesNum)+CHR(13)+"Recno "+STR(nRecNo),"Lost SalesQuote SOitem record", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		*--GOTO (nRecNo) IN SalesQuote
		REPLACE Alloy WITH cAlloy
		REPLACE Form WITH cForm
		REPLACE CC WITH cCC	
		REPLACE CL WITH cCL
		REPLACE Pieces WITH nPieces
		REPLACE Thck WITH nThck
		REPLACE Sz2 WITH nSz2
		REPLACE Sz3 WITH nSz3
		********************
		IF NOT USED('SalesQuote')
			TrackError( "Lost Table 'SalesQuote'","EditSalesOrder:SaveQuote",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		SELECT SalesQuote
		REPLACE RandLen WITH lRandLen
		REPLACE Metric WITH lMetric
		REPLACE Services WITH lServices
		REPLACE Descript WITH cDescript
		REPLACE SalesP WITH cSalesP
		************
		IF NOT USED('SalesQuote')
			TrackError( "Lost Table 'SalesQuote'","EditSalesOrder:SaveQuote",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		SELECT SalesQuote
		REPLACE Weight WITH nWeight
		REPLACE P_Lb WITH nP_Lb
		REPLACE P_Pc WITH nP_Pc
		REPLACE P_Ft WITH nP_Ft
		REPLACE Cuts WITH nCutsP
		REPLACE OtherFld WITH cOtherFld
		REPLACE OtherP WITH nOtherP
		REPLACE LotP WITH nLotP
		
		************
		IF NOT USED('SalesQuote')
			TrackError( "Lost Table 'SalesQuote'","EditSalesOrder:SaveQuote",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		SELECT SalesQuote
		REPLACE Q_P WITH nQ_P
		REPLACE Q_QTY WITH nQ_QTY
		REPLACE Q_PU WITH nQ_PU
		REPLACE Q_Total WITH nQ_Total
		REPLACE S_QTY WITH nS_QTY
		REPLACE S_P WITH nS_P
		REPLACE S_PU WITH nS_PU
		
		************
		REPLACE ItemSale WITH nItemSale
		REPLACE ItemCost WITH nItemCost
		
		IF NOT USED('SalesQuote')
			TrackError( "Lost Table 'SalesQuote'","EditSalesOrder:SaveQuote",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		SELECT SalesQuote
		REPLACE Comments WITH cQComments
		REPLACE LeadTime WITH cLeadTime
		
		************
		SELECT 0
		
		PRIVATE cUpdate
		cUpdate = "UPDATE dbo.AllQuotes SET "
		cUpdate = cUpdate + " COMPANY='"+cCompany+"'"
		cUpdate = cUpdate + ",NAME='"+cName+"'"
		cUpdate = cUpdate + ",PHONE='"+cPhone+"'"
		cUpdate = cUpdate + ",PHONE_EXT='"+cPhone_Ext+"'"
		cUpdate = cUpdate + ",CountryC='"+cCountryC+"'"
		cUpdate = cUpdate + " WHERE SalesNum = " + ALLTRIM(STR(ThisFormSet.SalesNum))
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
			ENDIF
		ENDIF
		
		
		PRIVATE cUpdate
		cUpdate = "UPDATE dbo.AllQuotes SET "
		cUpdate = cUpdate + " PO_NUM='"+cPO_Num+"'"
		cUpdate = cUpdate + ",ALLOY='"+cAlloy+"'"
		cUpdate = cUpdate + ",FORM='"+cForm+"'"
		cUpdate = cUpdate + ",CC='"+cCC+"'"
		cUpdate = cUpdate + ",CL='"+cCL+"'"
		cUpdate = cUpdate + ",PIECES="+STR(nPieces,7,0)+""
		cUpdate = cUpdate + ",THCK="+STR(nThck,10,4)+""
		cUpdate = cUpdate + ",SZ2="+STR(nSz2,9,3)+""
		cUpdate = cUpdate + ",SZ3="+STR(nSz3,9,3)+""
		cUpdate = cUpdate + ",Weight="+STR(nWeight,8,1)+""
		cUpdate = cUpdate + ",DESCRIPT='"+cDescript+"'"
		cUpdate = cUpdate + ",P_lb="+STR(nP_Lb,8,2)+""
		cUpdate = cUpdate + ",P_pc="+STR(nP_Pc,9,2)+""
		cUpdate = cUpdate + ",P_ft="+STR(nP_Ft,8,2)+""
		cUpdate = cUpdate + ",cuts="+STR(nCutsP,8,2)+""
		cUpdate = cUpdate + ",OtherFld='"+cOtherFld+"'"
		cUpdate = cUpdate + ",OtherP="+STR(nOtherP,8,2)+""
		cUpdate = cUpdate + ",LotP="+STR(nLotP,9,2)+""
		cUpdate = cUpdate + ",LotCost="+STR(nItemCost,9,2)+""
		cUpdate = cUpdate + ",LeadTime='"+cLeadTime+"'"
		*	cUpdate = cUpdate + ",QuoteMemo='"+PrepareSQLtxt(oQ.QuoteMemo,'Quote Memo',-1)+"'"
		***************** 
		cUpdate = cUpdate + ",Q_P="+STR(nQ_P,18,4)+""
		cUpdate = cUpdate + ",Q_QTY="+STR(nQ_QTY,18,4)+""
		cUpdate = cUpdate + ",Q_PU="+STR(nQ_PU)+""
		cUpdate = cUpdate + ",Q_Total="+STR(nQ_Total,18,4)+""
		cUpdate = cUpdate + ",S_QTY="+STR(nS_QTY,18,4)+""
		cUpdate = cUpdate + ",S_P="+STR(nS_P,18,4)+""
		cUpdate = cUpdate + ",S_PU="+STR(nS_PU)+""
		
		*****************
		cUpdate = cUpdate + ",Comments='"+cQComments+"'"
		*	cUpdate = cUpdate + ",Country='"+PrepareSQLtxt(oQ.Country,'Country',20)+"'"
		cUpdate = cUpdate + ",Services="+IIF(lServices,"1","0")+""
		cUpdate = cUpdate + ",RandLen="+IIF(lRandLen,"1","0")+""
		cUpdate = cUpdate + ",Metric="+IIF(lMetric,"1","0")+""
		cUpdate = cUpdate + " WHERE ID = " + ALLTRIM(STR(SalesQuote.ID))
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
				
				MESSAGEBOX("Data could not be saved at the SQL Server."+CHR(13)+CHR(13)+"Your edit will show on this screen and print on the report,"+CHR(13)+;
				"the data will revert to orignal when refreshed from the SQL Server."+CHR(13)+CHR(13)+"Edit and Try to save again!",0,"SQL Error")
			
				RETURN .F.
			ENDIF
		ENDIF
		
		*Successfully Saved to Allquotes
		*Price
		*****************************************************************
		PRIVATE nCalcLotP 
		*nCalcLotP = ThisFormSet.CalcLotp() 
		nCalcLotP = getSale_SOitem( cSOitem, ThisFormSet.nConnHandle )
		
		ThisFormSet.CalcPgValues()	 &&UPDATE SalesTotal AND Saves to dbo.Sales ItemCost,StkCost,StkPaid,POCost
		
		*ThisFormSet.UpdtItemSale(nCalcLotP) &&Saves to dbo.Sales does ItemSale,Quoted_QTY,Quoted_P,Quoted_Total,Quoted_PU
		*		&&UpdtItemSale also saves to dbo.Sales nQuoted_QTY, Quoted_P, Quoted_Total, Quoted_PU
		
		*****************************************************************
		*Save to Sales
		PRIVATE cPartNo,cOrderSpec
		*,cHeat
		PRIVATE cS_Instrct ,llShipOn, cUrgent, dShipDue, ldShip, nItemSale, nItemCost
		*PRIVATE nQuoted_QTY, nQuoted_P, nQuoted_Total, nQuoted_PU
		PRIVATE nS_QTY, nS_PU 
		cPartNo		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtPartNo.Value,'PartNo',100)
		cOrderSpec	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtOrderSpec.Value,'OrderSpec',60)
		*cHeat		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtHeat.Value,'Heat',50)
		cS_Instrct 	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.edtQuote_S_Instrct.Value,'S_Instrct',-1)
		
		llShipOn	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgQuote.chkShipOn.Value,'ShipOn',.F.)
		cUrgent		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.cmbUrgent.Value,'Urgent',1)
		
		dShipDue	= PrepareSQLdate(ThisFormSet.frmEO.pf1.pgQuote.txtShipDue.Value,'ShipDue')
		ldShip		= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgQuote.chkDShip.Value,'DShip',.F.)
		
		nItemSale	= PrepareSQLnum(ThisFormSet.frmEO.pF1.pgQuote.txtItemSale.Value,'ItemSale',9,2)
		nItemCost	= PrepareSQLnum(ThisFormSet.frmEO.pF1.pgQuote.txtItemCost.Value,'ItemCost',9,2)
		
		*-- Quoted_ is primarily held in AllQuotes used in Sales for speed
		*nQuoted_QTY	= PrepareSQLnum(ThisFormSet.frmEO.pF1.pgQuote.Q_QTY1.Value,'Q_QTY',-5)
		*nQuoted_P	= PrepareSQLnum(ThisFormSet.frmEO.pF1.pgQuote.Q_P1.Value,'Q_P',-5)
		*nQuoted_Total = PrepareSQLnum(ThisFormSet.frmEO.pF1.pgQuote.Q_Total1.Value,'Q_Total',10,2)
		*nQuoted_PU	= PrepareSQLnum(ThisFormSet.frmEO.pF1.pgQuote.cmbPU.Value,'Q_PU',-1)
		
		nS_PU	= nPU_Acct_Form(cForm,ThisFormSet.nConnHandle) &&cForm PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.Q_PU1.Value,'Q_PU',-1)
		*nS_PU is by form not about the Quote to the Customer
		
		PRIVATE nCutsP, nOtherP, nS_Total
		*, nQuoted_DollarTotal
		nCutsP	= PrepareSQLnum(SalesQuote.Cuts,'Cuts',8,2)
		nOtherP	= PrepareSQLnum(SalesQuote.OtherP,'OtherP',8,2)
		nS_Total = nQ_Total +nCutsP +nOtherP
		
		IF ROUND(nItemSale,0) # ROUND(nS_Total,0)
			PRIVATE cMess
			
			cMess= "SOitem '"+cSOitem+"'"
			cMess=cMess+" ItemSale = "+ALLTRIM(STR(nItemSale,18,4))
			cMess=cMess+"  Q_Total = "+ALLTRIM(STR(Q_Total,18,4))
			cMess=cMess+"    CutsP = "+ALLTRIM(STR(nCutsP ,9,2))
			cMess=cMess+"   OtherP = "+ALLTRIM(STR(nOtherP,9,2))
			cMess=cMess+" Setting ItemSale to "+ALLTRIM(STR(nS_Total,18,4))  
			TrackMess(cMess) 
			
			nItemSale = nS_Total
		ENDIF
		
		*****************************************
		*  Recaclulate nS_
		*****************************************
		
		DO CASE
		CASE nS_PU = 1
			*P_LB
			nS_Qty	= nWeight
		CASE nS_PU = 2
			*P_FT
			nS_Qty	=  Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisFormSet.nConnHandle)
		CASE nS_PU = 3
			*P_Pc
			IF nPieces < 1
				nPieces = 1
			ENDIF
			nS_Qty	= nPieces
		CASE nS_PU = 4
			*LotP
			nS_Qty = 1
		OTHERWISE
			TrackError("nS_PU Case was not 1,2,3,or4","nS_PU Not correct", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDCASE
		
		IF nS_Qty > 0 AND nQ_Total > 0
			nS_P = PrepareSQLnum( (nQ_Total/nS_Qty) ,'S_P',-5)
		*ELSE
		*	nS_P = 0
		*	IF nS_Qty = 0
		*		nS_Qty = 0
		*	ENDIF
		ENDIF
		
		IF NOT USED('SalesQuote')
			TrackError( "Lost Table 'SalesQuote'","EditSalesOrder:SaveQuote",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		SELECT SalesQuote
		REPLACE ShipOn 	WITH llShipOn	IN SalesQuote
		REPLACE Urgent 	WITH cUrgent	IN SalesQuote
		REPLACE PartNo 	WITH cPartNo		IN SalesQuote
		REPLACE OrderSpec WITH cOrderSpec	IN SalesQuote
		*REPLACE Heat 	WITH cHeat				IN SalesQuote
		REPLACE OrderSpec WITH OrderSpec	IN SalesQuote
		REPLACE S_Instrct WITH cS_Instrct	IN SalesQuote
		REPLACE ShipDue	WITH dShipDue	IN SalesQuote
		REPLACE DShip	WITH lDShip		IN SalesQuote
		REPLACE ItemSale WITH nItemSale	IN SalesQuote
		REPLACE ItemCost WITH nItemCost	IN SalesQuote
		
		***************** 
		SELECT SalesQuote
		REPLACE Q_P WITH nQ_P
		REPLACE Q_QTY WITH nQ_QTY
		REPLACE Q_PU WITH nQ_PU
		REPLACE Q_Total WITH nQ_Total
		
		REPLACE S_QTY WITH nS_QTY
		REPLACE S_P WITH nS_P
		REPLACE S_PU WITH nS_PU
		REPLACE S_Total WITH nS_Total
		
		** Not in vSales **
		*REPLACE Quoted_P WITH nQ_P
		*REPLACE Quoted_QTY WITH nQ_QTY
		*REPLACE Quoted_PU WITH nQ_PU
		*REPLACE Quoted_Total WITH n_Total
		
		*REPLACE Quoted_CutsP WITH nCutsP
		*REPLACE Quoted_OtherP WITH nOtherP
		*REPLACE Quoted_PU WITH nQuoted_PU IN SalesQuote
		
		*****************
		
		cSQLu = "UPDATE dbo.Sales SET "
		cSQLu = cSQLu + " ShipON="+IIF(llShipOn,"1","0")+""
		cSQLu = cSQLu + ",Urgent='"+cUrgent+"'"
		cSQLu = cSQLu + ",PartNo='"+cPartNo+"'"
		cSQLu = cSQLu + ",OrderSpec='"+cOrderSpec+"'"
		*cSQLu = cSQLu + ",Heat='"+cHeat+"'"
		cSQLu = cSQLu + ",S_Instrct='"+cS_Instrct+"'"
		cSQLu = cSQLu + ",ShipDue= '"+IIF(EMPTY(dShipDue),'',DTOC(dShipDue))+"'"
			
		cSQLu = cSQLu + ",DShip="+IIF(lDShip,"1","0")+""
		
		nItemSale = nQ_Total +nCutsP +nOtherP
		cSQLu = cSQLu + ",ItemSale ="+STR(nItemSale ,18,4)+""
		cSQLu = cSQLu + ",ItemCost="+STR(nItemCost,9,2)
		
		***************** 
		cSQLu = cSQLu + ",Quoted_P="+STR(nQ_P,18,4)+""
		cSQLu = cSQLu + ",Quoted_QTY="+STR(nQ_QTY,18,4)+""
		cSQLu = cSQLu + ",Quoted_PU="+STR(nQ_PU)+""
		cSQLu = cSQLu + ",Quoted_Total="+STR(nQ_Total,18,4)+""
		cSQLu = cSQLu + ",Quoted_CutsP="+STR(nCutsP,9,2)+""
		cSQLu = cSQLu + ",Quoted_OtherP="+STR(nOtherP,9,2)+""
		
		cSQLu = cSQLu + ",S_QTY="+STR(nS_Qty,18,4)+""
		cSQLu = cSQLu + ",S_P="+STR(nS_P,18,4)+""
		cSQLu = cSQLu + ",S_PU="+STR(nS_PU)+""
		cSQLu = cSQLu + ",S_Total="+STR(nS_Total,18,4)+""
		
		cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"	
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
			ENDIF
		ENDIF
		
		*****************************************************************
		*Save to Ship
		cSQL = "UPDATE dbo.SHIP SET	"
		cSQL = cSQL + " SalesP = '"+PrepareSQLtxt(cSalesP,'SalesP',1)+"'"
		cSQL = cSQL + ",Company = '"+PrepareSQLtxt(cCompany,'Company',30,.F.,.T.)+"'"
		cSQL = cSQL + ",PO_Num = '"+PrepareSQLtxt(cPO_Num,'PO_num',20)+"'"
		cSQL = cSQL + ",Alloy = '"+PrepareSQLtxt(cAlloy,'Alloy',12)+"'"
		cSQL = cSQL + ",OrderDate = '"+IIF(EMPTY(SalesQuote.SaleDate),'',DTOC(SalesQuote.SaleDate))+"'"
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SOitem_a+"')"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				*Did not save to Ship
			ENDIF
		ENDIF
		
		PRIVATE nAmendment
		nAmendment = ThisformSet.nAmendment
		
		IF ThisFormSet.lPrintedSO
			MESSAGEBOX("This SalesOrder will now be listed as "+CHR(13)+"'NOT Printed' and "+CHR(13)+"is Changing and "+CHR(13)+"Shop has not received.",0+64,"You must reprint with the new edit.")
			
			cSQL = "UPDATE dbo.Sales_No SET	"
			cSQL = cSQL + " PrintedSO = 0 "
			cSQL = cSQL + ",Changing = 1 "
			cSQL = cSQL + ",ShopRecv = 0 "
			cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!, long trigerUPDATE dbo.Sales_No
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , "")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			
			IF nSQLEXEC > 0
				
				*Get_Amendment_Sales_No *Return SQL dbo.Sales_No Amendment #
				*Get_Ver_Sales_No_Rev(ThisFormSet.SalesNum, ThisFormSet.nConnHandle)
				
				IF Set_Sales_No_Changing( ThisFormSet.SalesNum, ThisFormSet.nConnHandle) 
					
					nAmendment = ThisFormSet.nAmendment
					*Done when the Sales Order is Saved.
					IF Is_Amendment_Allowed( ThisFormSet.SalesNum, ThisFormSet.nConnHandle ) 
						*nAmendment = ThisFormSet.nAmendment + 1
						nAmendment = Amend_Sales_No_Ver( ThisFormSet.SalesNum, "Edited the Quote for the SO.", ThisFormSet.nConnHandle)
						IF nAmendment > 0
							REPLACE Amendment WITH nAmendment IN Sales_No
							ThisFormSet.nAmendment = nAmendment 
							ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value = nAmendment 
						ENDIF
					ENDIF
					
					TrackMess("This SalesOrder "+ALLTRIM(STR(ThisFormSet.SalesNum))+" will now be listed as 'NOT Printed' and is Changing and Shop has not received. You must reprint with the new edit."+CHR(13)+cSQL)
					
					*Proc_ERP:Track_Sales_No_Chng
					Track_Sales_No_Chng( "Edit_SalesOrder.SaveQuote(success) ",ThisFormSet.SalesNum,.F.,ThisFormSet.nAmendment )
					
					*ThisFormSet.lPrintedSO was set earlier
					REPLACE PrintedSO WITH .F. IN Sales_No
					ThisFormSet.lPrintedSO = .F.
					ThisFormSet.frmEO.pf1.pgBillTo.chkPrintedSO.Value	= ThisFormSet.lPrintedSO
					ThisFormSet.frmEO.pf1.pgQA.chkPrintedSO.Value		= ThisFormSet.lPrintedSO
					
					REPLACE Changing WITH .T. IN Sales_No
					ThisFormSet.lChangingSO	= .T.
					ThisFormSet.frmEO.pf1.pgBillTo.chkSOchanging.Value	= ThisFormSet.lChangingSO
					ThisFormSet.frmEO.pf1.pgQA.chkChanging.Value		= ThisFormSet.lChangingSO
		
					REPLACE ShopRecv WITH .F. IN Sales_No
					ThisFormSet.lShopRecvSO = .F.
					ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
					ThisFormSet.frmEO.pf1.pgQA.chkShopRecv.Value		= ThisFormSet.lShopRecvSO
					
					
				ENDIF
				
			ENDIF
		ENDIF
		
		*****************************************************************
		*Adjust StockLst_Process
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		PRIVATE lSOitemUseInv
		lSOitemUseInv = .F.
		
		IF USED('cntdUseINV')
			USE IN cntdUseINV
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS Cntd "
		cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = '"+SalesQuote.SOitem_A+"'"
		*UNION Broker_
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntdUseINV')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntdUseINV')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntdUseINV")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntdUseINV")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntdUseINV')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('cntdUseINV')
			IF cntdUseINV.Cntd > 0
				*Found a Inventory selected process!
				lSOitemUseInv = .T.
			ENDIF
			USE IN cntdUseINV
		ENDIF
		
		IF lSOitemUseInv 	
			*
			IF USED('tmpUseINV2')
				USE IN tmpUseINV2
			ENDIF
		
			cSQL = "SELECT * "
			*SOitem,PO_item,SalesPerson,StartDate,DueDate,Comment"
			*cSQL = cSQL + ",AllowSub"
			*cSQL = cSQL + ",PU,QTY,Ordered_QTY,Ordered_P,Pounds,ID_Detail,ID_Detail_Process"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
			cSQL = cSQL + " WHERE ( Process_ID='SELECTED' OR Process_ID='PARTSELECT' )"
			cSQL = cSQL + " AND SOitem = '"+SalesQuote.SOitem_A+"'"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUseINV2')
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUseINV2')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUseINV2")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 3' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUseINV2")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpUseINV2')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
		
			IF USED('tmpUseINV2')
				IF RECCOUNT('tmpUseINV2') > 1
					MESSAGEBOX("Found multiple records in StockLst_Process as 'Selected' for this SO item."+CHR(13)+"Please manualy edit!",48,"Cannot auto adjust Selected Stock")
				ENDIF
				IF RECCOUNT('tmpUseINV2') = 1
					cSQL=''
		
					*Check if a selected stock has changed
					PRIVATE nPUS,nQTYS,nPoundsS
		
					nPUS	= PrepareSQLnum(tmpUseINV2.PU,'PU',-1)
					nQTYS	= PrepareSQLnum(tmpUseINV2.Ordered_QTY,'QTY',-5)
					nOrdered_P= PrepareSQLnum(tmpUseINV2.Ordered_P,'S_P',-5)
					nPoundsS= PrepareSQLnum(tmpUseINV2.Pounds,'Pounds',9,1)
					nID_Detail_Process = PrepareSQLnum(tmpUseINV2.ID_Detail_Process,'ID_Detail_Process',-3)
					PRIVATE cPrc_Form,nPrc_PCs,nPrc_Dim1,nPrc_Dim2,nPrc_Dim3
					cPrc_Form	= PrepareSQLtxt(tmpUseINV2.Prc_Form,'Form',2)
					nPrc_PCs	= PrepareSQLnum(tmpUseINV2.Prc_PCs,'PC',-1)
					nPrc_Dim1	= PrepareSQLnum(tmpUseINV2.Prc_Dim1,'Dim1',10,4)
					nPrc_Dim2	= PrepareSQLnum(tmpUseINV2.Prc_Dim2,'Dim2',9,3)
					nPrc_Dim3	= PrepareSQLnum(tmpUseINV2.Prc_Dim3,'Dim3',9,3)
		
		      			
					IF nPUS = 0
						nPUS = GetPUfromForm(cForm, ThisFormSet.nConnHandle)
					ENDIF
					IF nS_PU = 0
						nS_PU = nPUS
					ENDIF
					
					PRIVATE nQTY_now, nQTY_Shipd, nPounds
					*nQTY_now is the Standard QTY for that form with these dimensions
					nQTY_now = get_QTYwithWeight( cForm,nPieces,nThck,nSz2,nSz3,nWeight, nS_PU, ThisFormSet.nConnHandle)  &&Proc_Quotes
					nQTY_Shipd = get_QTY_Packed_SOitem(cSOitem,ThisFormSet.nConnHandle)
					IF nID_Detail_Process > 0
						nQTY_inDetail = get_QTY_ID_D_P(nID_Detail_Process,'S', ThisFormSet.nConnHandle)
					ELSE
						TrackError(" EditSalesOrder.SaveQuote() has a _Process record but not nID_Detail_Process !?! "+CHR(13)+cSQL,"Lost nID_Detail_Process", PROGRAM(), LINENO(1))
						nQTY_inDetail = 0
					ENDIF
					
					nPounds = CalcWeight(nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisFormSet.nConnHandle)				
					
					IF (nQTY_Shipd+100) >( nQTY_now+100) * .90
						*SOitem has shipped enough +10% error
						
					ELSE
						IF (nQTY_now-nQTY_Shipd) < nQTY_inDetail 
							*Update the QTY, the detail is large enough to take it.
					
							cSQL = "UPDATE dbo.StockLst_Process "
							cSQL = cSQL + " SET QTY="+STR((nQTY_now-nQTY_Shipd),18,4)
							cSQL = cSQL + ",Ordered_QTY="+STR(nQTY_now,9,1)
							cSQL = cSQL + ",Pounds="+STR(nQTY_now,9,1)
							cSQL = cSQL + ",PU="+STR(nS_PU)
							cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
						ENDIF
					ENDIF
					
		*!*				IF nQTYS > 0 OR nPoundsS > 0
		*!*					*Found Something Selected
		*!*					
		*!*					IF nQTY_now > 0
		*!*						IF nQTY_now * 1.15 < nQTYS
		*!*							IF MESSAGEBOX("Weight is now more than 15% greater than was selected!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
		*!*								cSQL = "UPDATE dbo.StockLst_Process "
		*!*								cSQL = cSQL + " SET QTY="+STR(nQTY_now,18,4)
		*!*								cSQL = cSQL + ",Ordered_QTY="+STR(nQTY_now,9,1)
		*!*								cSQL = cSQL + ",Pounds="+STR(nQTY_now,9,1)
		*!*								cSQL = cSQL + ",PU="+STR(nS_PU)
		*!*								cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		*!*								*AND consume = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*						IF nQTY_now * .85 > nQTYS
		*!*							IF MESSAGEBOX("Weight is now more than 15% less than was seleted!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
		*!*								cSQL = "UPDATE dbo.StockLst_Process "
		*!*								cSQL = cSQL + " SET QTY="+STR(nQTY_now,18,4)
		*!*								cSQL = cSQL + ",Ordered_QTY="+STR(nQTY_now,9,1)
		*!*								cSQL = cSQL + ",Pounds="+STR(nQTY_now,9,1)
		*!*								cSQL = cSQL + ",PU="+STR(nS_PU)
		*!*								cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		*!*								*AND consume = 0
		*!*							ENDIF
		*!*						ENDIF	
		*!*						
		*!*					ENDIF
		*			ELSE
						*Use the old procedure of PWeight,PPc and PFt
							
		*!*					DO CASE
		*!*					CASE nPUS = 1
		*!*						*Compare Weight
		*!*						IF nQTYS * 1.15 < nPounds
		*!*							IF MESSAGEBOX("Old Weight is more than 15% greater than was selected!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
		*!*								cSQL = "UPDATE dbo.StockLst_Process SET QTY="+STR(nQTY_now,18,4)
		*!*								cSQL = cSQL + ",Ordered_QTY="+STR(nQTY_now,9,1)
		*!*								cSQL = cSQL + ",Pounds="+STR(nPounds,9,1)
		*!*								cSQL = cSQL + ", PU="+STR(nPU_now)
		*!*								cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		*!*								*AND consume = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*						IF nQTYS * .85 > nPounds
		*!*							IF MESSAGEBOX("Old Weight is more than 15% less than was seleted!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
		*!*								cSQL = "UPDATE dbo.StockLst_Process SET QTY="+STR(nQTY_now,18,4)
		*!*								cSQL = cSQL + ",Ordered_QTY="+STR(nQTY_now,9,1)
		*!*								cSQL = cSQL + ",Pounds="+STR(nPounds,9,1)
		*!*								cSQL = cSQL + ",PU="+STR(nPU_now)
		*!*								cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		*!*								*AND consume = 0
		*!*							ENDIF
		*!*						ENDIF	
		*!*					CASE nPUS = 2
		*!*						*Compare Length
		*!*						*nThckO,nSz2O,nSz3O
		*!*						IF nPFTS > 0
		*!*							IF nQTY_now > 0
		*!*								IF nPFTS != nQTY_now 
		*!*									IF MESSAGEBOX("Number of FT has changed from what was selected!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
		*!*										cSQL = "UPDATE dbo.StockLst_Process SET "
		*!*										cSQL = cSQL + " QTY="+STR(nQTY_now,18,4)
		*!*										cSQL = cSQL + ",Ordered_QTY="+STR(nQTY_now,9,1)
		*!*										cSQL = cSQL + ",Pounds="+STR(nPounds,9,1)
		*!*										cSQL = cSQL + ",PU="+STR(nPU_now)
		*!*										cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		*!*										*AND consume = 0
		*!*									ENDIF
		*!*								ENDIF
		*!*							ENDIF
		*!*						ENDIF
		*!*					CASE nPUS = 3
		*!*						*Compare PCs
		*!*						IF nQTY_now > 0
		*!*							IF nPrc_PCs > 0
		*!*								IF nQTY_now != nPrc_PCs
		*!*									IF MESSAGEBOX("Number of PC has changed from what was selected!"+CHR(13)+"Do you want to update the selected StockLst?",4+32,"Update the 'select Stock Process' for Sales Order?") = 6
		*!*										cSQL = "UPDATE dbo.StockLst_Process "
		*!*										cSQL = cSQL + " SET QTY="+STR(nQTY_now,18,4)
		*!*										cSQL = cSQL + ",Ordered_QTY="+STR(nQTY_now,9,1)
		*!*										cSQL = cSQL + ",Pounds="+STR(nPounds,9,1)
		*!*										cSQL = cSQL + ",PU="+STR(nPU_now)
		*!*										cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		*!*										*AND consume = 0
		*!*									ENDIF
		*!*								ENDIF
		*!*							ENDIF
		*!*						ENDIF
		*!*					OTHERWISE
		*!*					
		*!*					ENDCASE
		*			ENDIF		
					******************
					IF LEN(cSQL) > 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC )
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							ELSE
								WAIT WINDOW "Successfully updated selected stock!" NOWAIT
							ENDIF
						ELSE
							WAIT WINDOW "Successfully updated selected stock!" NOWAIT
						ENDIF
		
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
		
		
		*****************************************************************
		*Report when Orig dShipDueO, lShipOnO has changed
		*nAmendment does not change here!!
		
		PRIVATE cMess 
		cMess = ""
		
		*IF ThisFormSet.nAmendment > 0
			IF lShipOnO <> llShipOn
				cMess = "SOitem:"+cSoitem+" ShipOn changed from:"+IIF(lShipOnO,"Ship On","Ship By")+" to:"+IIF(llShipOn,"Ship On","Ship By")+"."+CHR(13)
			ENDIF
			IF cUrgentO <> cUrgent
				cMess = "SOitem:"+cSoitem+" changed from Urgent:'"+cUrgentO+"' to Urgent:'"+cUrgent+"'."+CHR(13)
			ENDIF
			IF dShipDueO <> dShipDue
				cMess = cMess + "SOitem:"+cSoitem+" changed ShipDue from:"+IIF(EMPTY(dShipDueO),'',DTOC(dShipDueO))+" to:"+IIF(EMPTY(dShipDue),'',DTOC(dShipDue))+"."+CHR(13)
				* " changed ShipDue from:" is checked for in Sales_No_Chng Insert Trigger
				cMess = cMess + "EmailRule:SOiChangedShipDue"+CHR(13)
			ENDIF
		
					
			IF LEN(ALLTRIM(cMess)) > 1
				
				Track_Sales_No_Chng(cMess,ThisFormSet.SalesNum,.F.,ThisFormSet.nAmendment)
				*Calls:"INSERT INTO dbo.Sales_No_Chng 
				
				cSQL= "INSERT INTO dbo.Sales_No_Rev ([SalesNum],[VER],[Comment]) VALUES ("
				cSQL = cSQL +""+STR(ThisFormSet.SalesNum)
				cSQL = cSQL +","+STR(ThisFormSet.nAmendment)
				cSQL = cSQL +",'"+cMess+"'" +")"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				
				IF nSQLEXEC < 0 &&Try again!	--Has been failing 2021-11-08
					WAIT WINDOW 'SQL 3' TIMEOUT 2
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 4' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC,'')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ELSE 
						nSQLEXEC = 1
					ENDIF
				ENDIF
				IF nSQLEXEC > 0
					Save_Sales_Status( ThisFormSet.SalesNum, "Version", "Edited the Quote on SOitem '"+SalesQuote.SOitem_A+"' Amend "+ALLTRIM(STR(ThisFormSet.nAmendment)), ThisFormSet.nConnHandle)
					*calls: GetCancelReason if "CANCEL or REMOVE"
				ENDIF
				
			
			ENDIF
		*ENDIF
		
		*****************************************************************
		ThisFormSet.Refresh_SalesQuote(nRecNo)		
		*****************************************************************
		
		
	ENDPROC

	PROCEDURE savequote_pgorder
		*ThisFormSet.SaveQuote_pgOrder()
		
		
		PRIVATE lServices, lInv, lBRK, lGFM, lDraw, lRoll, lPress, lMach, lCG, cTol, lPlasma, lWjet
		lServices= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkService.Value,'Service',.F.)
		lInv	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkInv.Value,'Inv',.F.)
		lBRK	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkBRK.Value,'BRK',.F.)
		lGFM	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkGFM.Value,'GFM',.F.)
		lDraw	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkDraw.Value,'Draw',.F.)
		lRoll	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkRoll.Value,'Roll',.F.)
		lPress	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkPress.Value,'Press',.F.)
		lMach	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkMach.Value,'Mach',.F.)
		lCG		= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkCG.Value,'CG',.F.)
		
		cTol	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtTol.Value,'Tol',20)
		lPlasma	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkPlasma.Value,'Plasma',.F.)
		lWjet	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkWJet.Value,'WJet',.F.)
		
		SELECT 0
		
		PRIVATE cUpdate
		cUpdate = "UPDATE dbo.AllQuotes SET "
		cUpdate = cUpdate + " Services="+IIF(lServices,"1","0")+""
		cUpdate = cUpdate + " WHERE ID = " + ALLTRIM(STR(SalesQuote.ID))
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
				
				MESSAGEBOX("Data could not be saved at the SQL Server."+CHR(13)+CHR(13)+"Your edit will show on this screen and print on the report,"+CHR(13)+;
				"the data will revert to orignal when refreshed from the SQL Server."+CHR(13)+CHR(13)+"Edit and Try to save again!",0,"SQL Error")
				
				RETURN .F.
			ENDIF	
		ELSE
			*Successfully Saved to Allquotes
			
			*****************************************************************
		*	ThisFormSet.Refresh_SalesQuote(nRecNo)		
			*****************************************************************
		ENDIF
		
	ENDPROC

	PROCEDURE savequote_startingstock
		PARAMETERS pWhat
		*ThisForm.SaveQuote_StartingStock("REMOVE")
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ''
		ENDIF
		
		
		PRIVATE cAlloy,cForm,cCC,cCL,nPieces,nThck,nSz2,nSz3,nWeight
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmStartingStock.ssALLOY1.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmStartingStock.sscmbForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmStartingStock.sscmbCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmStartingStock.sscmbCL.Value,'CL',1)
		nPieces		= PrepareSQLnum(ThisFormSet.frmStartingStock.ssPieces1.Value,'Pieces',7,0)
		nThck		= PrepareSQLnum(ThisFormSet.frmStartingStock.ssTHCK1.Value,'Thck',10,4)
		nSz2		= PrepareSQLnum(ThisFormSet.frmStartingStock.ssSz21.Value,'Sz2',9,3)
		nSz3		= PrepareSQLnum(ThisFormSet.frmStartingStock.ssSz31.Value,'Sz3',9,3)
		nWeight		= PrepareSQLnum(ThisFormSet.frmStartingStock.ssWeight1.Value,'ssWeight',8,1)
		
		PRIVATE cDescript cComment, cInqNumP, cSOitem, cPOitem, lRandLen, lMetric
		cDescript	= ''
		cComment	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgQuote.txtQComments.Value,'Comments',-1)
		cInqNumP	= PrepareSQLtxt(SalesQuote.InqNumP,'InqNumP',9)
		cSOitem		= PrepareSQLtxt(SalesQuote.SOitem_A,'SOitem',10)
		cPOitem		= PrepareSQLtxt(SalesQuote.POitem,'POitem',12)
		lRandLen	= PrepareSQLlogic(SalesQuote.RandLen,'RandLen',.F.)
		lMetric		= .F.
		
		PRIVATE nSalesQuote_ID,lSSFound 
		nSalesQuote_ID = SalesQuote.ID
		lSSFound = .F.
		
		****************************************
		*Check for Exisiting
		IF USED('cntSS')
			USE IN cntSS
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS Cntd "
		cSQL = cSQL + " FROM dbo.StartingStock  WITH(NOLOCK) "
		cSQL = cSQL + " WHERE AllQuotes_ID = "+STR(nSalesQuote_ID)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntSS')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSS')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSS")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSS")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntSS')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('cntSS')
			IF cntSS.Cntd > 0
				*Found
				lSSFound = .T.
			ENDIF
			USE IN cntSS
		ENDIF
		
		PRIVATE lOk
		lOk = .F.
		****************************************
		IF lSSFound
		
			PRIVATE cUpdate
			
			IF pWhat = "REMOVE"
				cUpdate = "DELETE FROM dbo.StartingStock "
				cUpdate = cUpdate + " WHERE AllQuotes_ID = " + ALLTRIM(STR(nSalesQuote_ID))
				cUpdate = cUpdate + ";"
				cUpdate = cUpdate + " UPDATE dbo.AllQuotes "
				cUpdate = cUpdate + " SET StartStock = 0"
				cUpdate = cUpdate + " WHERE ID = " + ALLTRIM(STR(nSalesQuote_ID))
		
			ELSE
				cUpdate = "UPDATE dbo.StartingStock SET "
				cUpdate = cUpdate + " ALLOY='"+cAlloy+"'"
				cUpdate = cUpdate + ",FORM='"+cForm+"'"
				cUpdate = cUpdate + ",CC='"+cCC+"'"
				cUpdate = cUpdate + ",CL='"+cCL+"'"
				cUpdate = cUpdate + ",PIECES="+STR(nPieces,7,0)+""
				cUpdate = cUpdate + ",THCK="+STR(nThck,10,4)+""
				cUpdate = cUpdate + ",SZ2="+STR(nSz2,9,3)+""
				cUpdate = cUpdate + ",SZ3="+STR(nSz3,9,3)+""
				cUpdate = cUpdate + ",Weight="+STR(nWeight,8,1)+""
			*	cUpdate = cUpdate + ",DESCRIPT='"+cDescript+"'"
		
				cUpdate = cUpdate + ",Comment='"+cComment+"'"
				cUpdate = cUpdate + ",InqNumP='"+cInqNumP+"'"
				cUpdate = cUpdate + ",SOitem='"+cSOitem+"'"
				cUpdate = cUpdate + ",POitem='"+cPOitem+"'"
		
				cUpdate = cUpdate + ",RandLen="+IIF(lRandLen,"1","0")+""
				cUpdate = cUpdate + ",Metric="+IIF(lMetric,"1","0")+""
				cUpdate = cUpdate + " WHERE AllQuotes_ID = " + ALLTRIM(STR(nSalesQuote_ID))
			
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL'  TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
					RETURN .F.
				ELSE
					lOK = .T.
				ENDIF
			ELSE 
				lOk = .T.
			ENDIF
		ELSE
			*INSERT
			
			cSQL = "INSERT INTO dbo.StartingStock "
			cSQL = cSQL + " (Alloy,Form,CC,CL,Pieces,Thck,Sz2,Sz3,Weight "
			cSQL = cSQL + " ,Comment, InqNumP, SOitem, POitem, AllQuotes_ID ) "
			cSQL = cSQL + " VALUES "
			cSQL = cSQL + " ('"+cAlloy+"'"
			cSQL = cSQL + ",'"+cForm+"'"
			cSQL = cSQL + ",'"+cCC+"'"
			cSQL = cSQL + ",'"+cCL+"'"
			cSQL = cSQL + ","+STR(nPieces)
			cSQL = cSQL + ","+STR(nThck,10,4)
			cSQL = cSQL + ","+STR(nSz2,9,3)
			cSQL = cSQL + ","+STR(nSz3,9,3)
			cSQL = cSQL + ","+STR(nWeight,7,1)
			cSQL = cSQL + ",'"+cComment+"'"
			cSQL = cSQL + ",'"+cInqNumP+"'"
			cSQL = cSQL + ",'"+cSOitem+"'"
			cSQL = cSQL + ",'"+cPOitem+"'"
			*cSQL = cSQL + ","+IIF(lRandLen,'1','0')
			cSQL = cSQL + ","+STR(nSalesQuote_ID)
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL)
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL'  TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC,'')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					RETURN .F.
				ELSE
					lOK = .T.
				ENDIF
			ELSE
				lOk = .T.
			ENDIF
		ENDIF
		
		IF lOk 
			IF pWhat = "REMOVE"
				*ThisFormSet.frmStartingStock.ssALLOY1.Value,'Alloy',12)
				*ThisFormSet.frmStartingStock.sscmbForm.Value,'Form',2)
				*ThisFormSet.frmStartingStock.sscmbCC.Value,'CC',1)
				*ThisFormSet.frmStartingStock.sscmbCL.Value,'CL',1)
				ThisFormSet.frmStartingStock.ssPieces1.Value = 0
				ThisFormSet.frmStartingStock.ssTHCK1.Value = 0
				ThisFormSet.frmStartingStock.ssSz21.Value = 0
				ThisFormSet.frmStartingStock.ssSz31.Value = 0
				ThisFormSet.frmStartingStock.ssWeight1.Value = 0
		
				WAIT WINDOW "Starting Stock Removed!" NOWAIT
			ELSE
				
				cUpdate = "UPDATE dbo.AllQuotes "
				cUpdate = cUpdate + " SET StartStock = 1"
				cUpdate = cUpdate + " WHERE ID = " + ALLTRIM(STR(nSalesQuote_ID))
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL'  TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
						RETURN .F.
					ELSE
						nSQLEXEC = 1
					ENDIF
				ENDIF
				IF nSQLEXEC > 0
					SELECT SalesQuote
					REPLACE StartStock  WITH .T.
					
					lOk = .T.
				ENDIF
				WAIT WINDOW "Starting Stock is Saved!" NOWAIT		
			ENDIF	
		ENDIF
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE saveso
		PARAMETERS pWhat, lAmendVer
		*ThisFormSet.SaveSO()
		*Runs after ThisFormSet.CheckData4Save()
		*RETURNs True OR False
		
		PRIVATE cWhat
		IF VARTYPE(pWhat) != "C"
			cWhat = '' &&'PRINT',"CANCEL","SAVE"
		ELSE
			cWhat = pWhat
		ENDIF
		lAmendVer = PrepareSQLlogic(lAmendVer,'AmendVer')
		
		PRIVATE lReturn 
		lReturn = .T.
		
		PRIVATE mHoldRecordNum, nItem, nItem_A, cSQLUpdate  
		mHoldRecordNum = 0
		nItem = PrepareSQLnum(ThisFormSet.frmEO.pf1.pgOrder.txtItem.Value,'Item',2,0)
			
		SELECT SalesQuote
		mHoldRecordNum = RECNO('SalesQuote')
		
		IF mHoldRecordNum > RECCOUNT('SalesQuote')
			mHoldRecordNum = 0
			nItem_A = PrepareSQLnum( SalesQuote.Item_A,'Item',2,0)
		ENDIF
		
		IF mHoldRecordNum < 1
			IF nItem_A <> nItem
				MESSAGEBOX("RECNO('SalesQuote') has been lost."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem)),0,"Lost RecNo")
				TrackError("Lost RecNo","RECNO('SalesQuote') is 0."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"Begining of Save.",PROGRAM(),LINENO(1))
				
				LOCATE FOR Item_A = nItem
				mHoldRecordNum = RECNO('SalesQuote')
			ENDIF
		ENDIF
		
		*Get Variable
		LOCAL llpaper_po, lcPayType, lcShipPay, lcCustID, lcShipRoute, lnFreightEst, lcAddr_Ref, lcInstrct, lcBillInstrct
		LOCAL llBlind, llEmailConf, cBillToEmail, llFaxConf, cBillToFax, cSoldToFax, lcTarfBill, llUSA
		LOCAL lnShipAddr, lnSoldAddr, llPrintedSO
		PRIVATE lnSalesNum,lnAmendment,lECPC, lDPAS, lFCI, lGOV
		              
		lnSalesNum	= ThisFormSet.SalesNum
		llpaper_po	= PrepareSQLlogic( Sales_No.Paper_PO,'Paper_PO',.T. ) 
		lnAmendment = ThisFormSet.nAmendment
		lECPC		= PrepareSQLlogic( Sales_No.ECPC,'ECPC',.F.)
		lDPAS		= PrepareSQLlogic( Sales_No.DPAS,'DPAS',.F.)
		lFCI		= PrepareSQLlogic( Sales_No.FCI,'FCI',.F.)
		lGOV		= PrepareSQLlogic( Sales_No.GOV,'GOV',.F.)
		lcPayType	= PrepareSQLtxt( Sales_No.PayType,'PayType',10)
		
		IF LEN(ALLTRIM(lcPayType))=0
			lcPayType = ' '
		ENDIF
		lcShipPay	= PrepareSQLtxt( Sales_No.ShipPay,'ShipPay',12)
		
		lcCustID 	= PrepareSQLtxt( Sales_No.CustID,'CustID',20)
		IF LEN(lcCustID) < 1
			*check for in AllQuoes
			lcCustID 	= PrepareSQLtxt( SalesQuote.CustID,'CustID',20)
		ENDIF
		lcShipRoute	= PrepareSQLtxt( Sales_No.ShipRoute,'ShipRoute',20)
		lnFreightEst= PrepareSQLnum( Sales_No.FreightEst,'FreightEst',9,2)
		lcAddr_Ref	= PrepareSQLtxt( Sales_No.Addr_Ref,'Addr_ref',40)
		lcInstrct	= PrepareSQLtxt( Sales_No.Instrct,'Instrct',100)
		lcBillInstrct	= PrepareSQLtxt( Sales_No.BillInstrct,'BillInstrct',255)
		
		*rem lcInstrct is for Sales_No, S_Instrct is for Sales.
		llBlind		= PrepareSQLlogic( Sales_No.Blind,'Blind',.F.) 
		lcTarfBill	= PrepareSQLtxt( Sales_No.TarfBill,'TarfBill',10)
		llUSA		= PrepareSQLlogic( Sales_No.USA,'USA',.T.)
		llEmailConf	= PrepareSQLlogic( Sales_No.EmailConf,'EmailConf',.F.)
		llFaxConf	= PrepareSQLlogic( Sales_No.FaxConf,'FaxConf',.F.)
		
		lnShipAddr	= PrepareSQLnum(ThisFormSet.ShipAddr,'ShipAddr',-3)
		lnSoldAddr	= PrepareSQLnum(ThisFormSet.SoldAddr,'SoldAddr',-3)
		llPrintedSO	= PrepareSQLlogic(ThisFormSet.lPrintedSO,'PrintedSO',.F.)
		
		cBillToEmail= PrepareSQLtxt( get_SoldTo(ThisFormSet.SoldAddr,'Email',ThisFormSet.nConnHandle) ,'Email',60)
		cBillToFax	= PrepareSQLtxt( get_SoldTo(ThisFormSet.SoldAddr,'Fax',ThisFormSet.nConnHandle),'Fax',12)
		cSoldToFax	= PrepareSQLtxt( get_ShipTo(ThisFormSet.ShipAddr,'Fax',ThisFormSet.nConnHandle),'Fax',12)
		
		
		PRIVATE lQA,lCofC,lMerc,lpPO,lpPN,lpHeat,lpSpec,lpDesc,lpOther,cOther,lpIntP
		*USE SalesQuote Values
		lQA		= PrepareSQLlogic( SalesQuote.QA,'QA', .F. ) 
		lCofC	= PrepareSQLlogic( SalesQuote.CofC,'CofC', .F. ) 
		lMerc	= PrepareSQLlogic( SalesQuote.Merc,'Merc', .F. ) 
		lpPO	= PrepareSQLlogic( SalesQuote.pPO,'pPO', .F. ) 
		lpPN	= PrepareSQLlogic( SalesQuote.pPN,'pPN', .F. ) 
		lpHeat	= PrepareSQLlogic( SalesQuote.pHeat,'pHeat', .F. ) 
		lpSpec	= PrepareSQLlogic( SalesQuote.pSpec,'pSpec',.F.) 
		lpDesc	= PrepareSQLlogic( SalesQuote.pDesc,'pDesc',.F.) 
		lpOther	= PrepareSQLlogic( SalesQuote.pOther,'pOther',.F.)
		cOther	= PrepareSQLtxt(SalesQuote.Other,'Other',30)
		lpIntP	= PrepareSQLlogic( SalesQuote.IntP,'IntP',.F.)
		
		
		PRIVATE cBillCountry, cShipCountry, llFoundCountry, cBillCountryABV, cShipCountryABV
		cBillCountry = PADR(UPPER(get_SoldTo(ThisFormSet.SoldAddr,'COUNTRY',ThisFormSet.nConnHandle)) ,15," ")
		cShipCountry = PADR(UPPER(get_ShipTo(ThisFormSet.ShipAddr,'COUNTRY',ThisFormSet.nConnHandle)) ,15," ")
		llFoundCountry = .F.
		
		IF NOT USED('HardWood')
			ThisFormSet.LoadHardwood()
		ENDIF
			
		SELECT HardWood
		nHardWoodINDEX = ATAGINFO(aHardWood)
		IF nHardWoodINDEX = 0
			INDEX ON Country TAG Country
			nHardWoodINDEX = ATAGINFO(aHardWood)
		ENDIF
		
		IF ASCAN(aHardWood,"COUNTRY",1,ALEN(aHardwood,1),1) = 0
			INDEX ON Country TAG Country
			nHardWoodINDEX = ATAGINFO(aHardWood)
		ENDIF
		
		**
		IF nHardWoodINDEX = 0
			INDEX ON ABV TAG ABV
			nHardWoodINDEX = ATAGINFO(aHardWood)
		ENDIF
			
		IF ASCAN(aHardWood,"ABV",1,ALEN(aHardwood,1),1) = 0
			INDEX ON ABV TAG ABV
			nHardWoodINDEX = ATAGINFO(aHardWood)
		ENDIF
		
		****			
		IF NOT LEN(ALLTRIM(cShipCountry))=0
			
			SEEK cShipCountry ORDER Country IN HardWood
			IF FOUND("HardWood")
				IF NOT HardWood.Inactive
					llFoundCountry = .T.
				ENDIF
			ENDIF
			IF NOT llFoundCountry 
				IF LEN(ALLTRIM(cShipCountry)) = 2
					cShipCountryABV = LEFT(cShipCountry ,2)
			
					SEEK cShipCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							llFoundCountry = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT llFoundCountry 
				SEEK cShipCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						llFoundCountry = .T.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT LEN(ALLTRIM(cBillCountry))=0
			IF NOT llFoundCountry 
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						llFoundCountry = .T.
					ENDIF
				ENDIF
			ENDIF
			IF NOT llFoundCountry 
				IF LEN(ALLTRIM(cBillCountry )) = 2
					cBillCountryABV = LEFT(cBillCountry ,2)
					SEEK cBillCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							llFoundCountry = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT llFoundCountry 
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						llFoundCountry = .T.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************
		PRIVATE lSaveThis
		lSaveThis = .T.
		
		**check Send Email
		
		**Check Conversion PO
		*IF NOT ThisFormSet.frmPO.CheckVendCode()
		*	RETURN .F.
		*ENDIF
		
		**********************************
		* end check for bad values
		**********************************
		
		PRIVATE lRollBack
		lRollBack = .F.
		= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2) && Manual transactions
		
		*********************************
		
		*Update Sales where all the values are the same, even for different items
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "UPDATE dbo.Sales SET "
		cSQL = cSQL + " QA = "+ IIF(lQA,'1','0')
		cSQL = cSQL + ",CofC = "+ IIF(lCofC,'1','0') 
		cSQL = cSQL + ",Merc = "+ IIF(lMerc,'1','0')
		cSQL = cSQL + ",pPO = "+ IIF(lpPO,'1','0')
		cSQL = cSQL + ",pPN = "+ IIF(lpPN,'1','0')
		cSQL = cSQL + ",pHeat = "+ IIF(lpHeat,'1','0')
		cSQL = cSQL + ",pSpec = "+ IIF(lpSpec,'1','0')
		cSQL = cSQL + ",pDesc = "+ IIF(lpDesc,'1','0')
		cSQL = cSQL + ",pOther = "+ IIF(lpOther,'1','0')
		cSQL = cSQL + ",Other = '"+ ALLTRIM(cOther)+"'"
		cSQL = cSQL + ",IntP = "+ IIF(lpIntP,'1','0') 
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.SalesNum))
		
		WAIT WINDOW "Saved to dbo.Sales table" NOWAIT
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!, long triger
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				lRollBack = .T.
				lReturn = .F.
			ENDIF
		ENDIF
		
		
		IF lRollBack
			SQLROLLBACK(ThisFormSet.nConnHandle)
			= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1) && Auto transactions
			MESSAGEBOX( "The SO:"+ALLTRIM(STR(lnSalesNum))+" could not be Saved because of error.",16,"Save failed!")
			RETURN .F.
		ENDIF
		
		
		**************************************
		**Update dbo.Sales, one item at a time
		
		PRIVATE cOrderSpec, cS_Instrct, lInv, lBRK, lGFM, lDraw, lRoll, lPress, lMach, lCG, cTol, lPlasma, lWJet, lColdSaw
		PRIVATE nCert,cProcLoc,cTYP,lExport, cUrgent
		*, cHeat
		*PRIVATE nConverPO,cConverter,cConversion,cConverFrt,dConverSent,dConverRetu
		PRIVATE llShipOn ,dShipDue,dShipped,lDShip, lPODShip
		PRIVATE nMatlWt
		PRIVATE lcncld,lcmplt,cPartNo,nRMA_Detail, cSoItem
		PRIVATE nItemCost, nItemSale
		PRIVATE	lST_FoundCost, nST_ItemSale, nST_ItemCost, nST_StkCost, nST_StkPaid, nST_POCost
		lST_FoundCost	= .F.
		nST_ItemSale	= 0
		nST_ItemCost	= 0
		nST_StkCost		= 0
		nST_StkPaid		= 0
		nST_POCost		= 0
		
			
		SELECT SalesQuote
		SCAN
			IF NOT lRollBack 
				cSOItem = Proper_SO_item( SalesQuote.SoItem_a )
				
				*Check StockLst_Process for Selected Stock
				IF Count_StockLst_ProcessbySOitem( cSOItem, ThisFormSet.nConnHandle, 'SELECTED' ) > 0
					IF NOT PrepareSQLlogic(SalesQuote.Inv,'INV',.T.) &&null was causing too many false marks: changed to default True 8/1/19
						SELECT SalesQuote
						REPLACE SalesQuote.Inv WITH .T.
					ENDIF
				ELSE
					IF PrepareSQLlogic(SalesQuote.Inv,'INV',.F.)	
						WAIT WINDOW "SOitem: "+ALLTRIM(cSOitem)+" is marked as INV, but no Stock has been selected." NOWAIT
					ENDIF
				ENDIF
				
				cOrderSpec = PrepareSQLtxt(SalesQuote.OrderSpec,'Order Spec',60,.F.)
				cS_Instrct = PrepareSQLtxt(SalesQuote.S_Instrct,'Special Instructions',0,.f.)
				lInv = PrepareSQLlogic(SalesQuote.Inv,'INV',.F.)
				lBRK = PrepareSQLlogic(SalesQuote.BRK,'BRK',.F.)
				lGFM = PrepareSQLlogic(SalesQuote.GFM,'GFM',.F.)
				lDraw = PrepareSQLlogic(SalesQuote.Draw,'Draw',.F.)
				lRoll = PrepareSQLlogic(SalesQuote.Roll,'Roll',.F.)
				lPress = PrepareSQLlogic(SalesQuote.Press,'Press',.F.)
				lMach = PrepareSQLlogic(SalesQuote.MACH,'Mach',.F.)
				lCG	= PrepareSQLlogic(SalesQuote.CG,'CG',.F.)
				cTol = PrepareSQLtxt(SalesQuote.Tol,'Tolerance',20)
				IF lCG AND LEN(ALLTRIM(cTol))=0
					MESSAGEBOX("Please enter a CG Tolerance on SO-Item:"+ALLTRIM(SalesQuote.SoItem_a)+"!",0+64,"Found CG job with no Tolerance.")
				ENDIF
				lPlasma = PrepareSQLlogic(SalesQuote.Plasma,'Plasma',.F.)
				lWJet = PrepareSQLlogic(SalesQuote.WJet,'WJet',.F.)
				lColdSaw = PrepareSQLlogic(SalesQuote.ColdSaw,'ColdSaw',.F.)
				nCert = PrepareSQLnum(SalesQuote.Cert,'Cert',1,0)
				cProcLoc = PrepareSQLtxt(SalesQuote.ProcLoc,'ProcLoc',1)
				lExport	= PrepareSQLlogic(SalesQuote.Export,'Export',.F.)
				cUrgent	= PrepareSQLtxt(SalesQuote.Urgent,'Urgent',1)
				llShipOn = PrepareSQLlogic( SalesQuote.ShipOn,'ShipOn',.F.)
				*llShipOn = PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgQuote.chkShipOn.Value,'ShipOn',.F.)
				dShipDue = PrepareSQLdate(SalesQuote.ShipDue,'Ship Due',.T.)
				dShipped = PrepareSQLdate(SalesQuote.Shipped,'Shipped')
				
				lPODShip = SO_have_PO_DShip( cSOitem, ThisFormSet.nConnHandle ) && ShipWhere = 2 OR ShipWhere = 4 OR ShipWhere = 6
				lDShip   = lPODShip
				*lDShip	 = PrepareSQLlogic(SalesQuote.DShip,'DShip',.F.)
				
				nMatlWt = PrepareSQLnum(SalesQuote.matlWt,'Material Weight',9,1)
				lCncld = PrepareSQLlogic(SalesQuote.cncld,'Cancelled',.F.)
				
				*cmplt is only changed with a shipment or packingslip, unless PO has ship direct to customer!
				*lcmplt = PrepareSQLlogic(SalesQuote.cmplt,'Complete',.F.)
		
				cPartNo = PrepareSQLtxt(SalesQuote.PartNo,'Part Number',100,.F.)
				nItemCost = PrepareSQLnum(SalesQuote.ItemCost,'ItemCost',9,2)
				nItemSale = PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',9,2)
				nRMA_Detail = PrepareSQLnum(SalesQuote.RMA_Detail,'RMA Detail',-3)
				
				cTYP = PrepareSQLtxt(SalesQuote.TYP,'TYP',1)
				
				IF USED('SalesTotal')
					SELECT SalesTotal
					LOCATE FOR Item = SalesQuote.Item
					IF FOUND('SalesTotal')
						lFoundCost	= .T.
						nItemCost	= PrepareSQLnum(SalesTotal.ItemCost  ,'ItemCost',9,2)
						nStkCost	= PrepareSQLnum(SalesTotal.ItemSkCost,'StkCost',9,2)
						nStkPaid	= PrepareSQLnum(SalesTotal.ItemSKPaid,'StkPaid',9,2)
						nPOCost		= PrepareSQLnum(SalesTotal.ItemPOCost,'POCost',9,2)
					ENDIF
					
					SELECT SalesQuote
				ENDIF
				
				
				PRIVATE nQuoted_PU, nQuoted_QTY, nQuoted_P, nQuoted_Total
				
				PRIVATE nCutsP, nOtherP
				*, nQuoted_DollarTotal
				nQuoted_PU = PrepareSQLnum(SalesQuote.Q_PU,'PU',1)
				IF nQuoted_PU = 0
					*Old data, find PU Standard from Form
					nQuoted_PU = GetPUfromForm( SalesQuote.Form, ThisFormSet.nConnHandle )
				ENDIF
				***
				nQuoted_QTY	= PrepareSQLnum(SalesQuote.Q_QTY,'Q_QTY',-5)
				IF nQuoted_QTY = 0
					nQuoted_QTY	= get_QTYwithWeight( SalesQuote.Form,SalesQuote.Pieces,SalesQuote.Thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.Weight, nQuoted_PU, ThisFormSet.nConnHandle)
				ENDIF
				***
				nQuoted_P = PrepareSQLnum(SalesQuote.Q_P,'Q_P',-5)
		*		IF nQuoted_P = 0
		*			nQuoted_P = PrepareSQLnum(SalesQuote.Q_P,'Q_P',-5)
		*		ENDIF
				***
			
				nCutsP	= PrepareSQLnum(SalesQuote.Cuts,'Cuts',8,2)
				nOtherP	= PrepareSQLnum(SalesQuote.OtherP,'OtherP',8,2)
		
				nQuoted_Total = PrepareSQLnum((nQuoted_P * nQuoted_QTY),'Q_Total',10,2)
				nS_Total = PrepareSQLnum((nQuoted_Total +nCutsP +nOtherP),'S_Total',10,2)
				nItemSale = nQuoted_Total +nCutsP +nOtherP
				***
				IF nItemSale > 0 
					IF nS_Total = 0 
						nS_Total = nItemSale
					ENDIF
					*IF ROUND(nQ_Total +nCutsP +nOtherP,0) # ROUND(nItemSale, 0)
					*	nQ_Total = nItemSale -nCutsP -nOtherP
					*ENDIF
					
					*make sure there is a P and QTY
					IF nQuoted_QTY = 0 AND nQuoted_P > 0
						nQuoted_QTY = nQ_Total / nQuoted_P
					ENDIF
					IF nQuoted_QTY > 0 AND nQuoted_P = 0
						nQuoted_P = nQ_Total / nQuoted_QTY
					ENDIF
					
				ENDIF
				
				IF nS_Total = 0
					nS_Total = nQuoted_Total +nCutsP +nOtherP
				ENDIF
				IF nItemSale = 0
					nItemSale  = nQuoted_Total +nCutsP +nOtherP
				ENDIF
					
				IF ROUND((nQuoted_Total +nCutsP +nOtherP)/10,0) # ROUND(nItemSale/10,0)
					PRIVATE cMess 
					cMess = "SO item '"+cSOitem+"' has a mismatch on nQuoted_Total("+ALLTRIM(STR(ROUND((nQuoted_Total +nCutsP +nOtherP),0)))+") to nItemSale(" +ALLTRIM(STR(ROUND(nItemSale,0)))+")" 
					cMess = cMess + CHR(13)+HTML_SOitem(cSOitem,.T.)
					
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
		
				ENDIF
				
				************************************************
				*Set Router p_rtr_Oper
				*rtr_Oper_Sched('SOitem',cSOItem,"INV",lInv,lCncld,ThisFormSet.nConnHandle)
				
				IF NOT lCncld
					*Not Cancelled, make sure POitem work is scheduled.
					 
					IF lInv
						*rtr_Oper_Sched('SOitem',cSOItem,"Pull Material",lInv,ThisFormSet.nConnHandle) --Done in Select Stock
					ENDIF
					IF lBRK
						*rtr_Oper_Sched('SOitem',cSOItem,"Pull Material",lBRK,ThisFormSet.nConnHandle) --Done in Select Stock
					ENDIF
					IF lGFM
						rtr_Oper_Sched('SOitem',cSOItem,"Radial Forge",lGFM,ThisFormSet.nConnHandle)
					ENDIF
					IF lDraw
						rtr_Oper_Sched('SOitem',cSOItem,"Draw",lDraw,ThisFormSet.nConnHandle)
					ENDIF
					IF lPress
						rtr_Oper_Sched('SOitem',cSOItem,"Open Die Forge",lPress,ThisFormSet.nConnHandle)
					ENDIF
					IF lMach
						rtr_Oper_Sched('SOitem',cSOItem,"Machine Shop",lMach,ThisFormSet.nConnHandle)
					ENDIF
					IF lCG
						rtr_Oper_Sched('SOitem',cSOItem,"Centerless Grinder",lCG,ThisFormSet.nConnHandle)
					ENDIF
					IF lMach
						rtr_Oper_Sched('SOitem',cSOItem,"Machine Shop",lMach,ThisFormSet.nConnHandle)
					ENDIF
					IF lPlasma
						rtr_Oper_Sched('SOitem',cSOItem,"Plasma Cut",lPlasma,ThisFormSet.nConnHandle)
					ENDIF
					IF lWJet
						rtr_Oper_Sched('SOitem',cSOItem,"Waterjet",lWJet,ThisFormSet.nConnHandle)
					ENDIF
					IF lRoll
						rtr_Oper_Sched('SOitem',cSOItem,"Roll",lRoll,ThisFormSet.nConnHandle)
					ENDIF
					IF lColdSaw
					ENDIF
					*rtr_Oper_Sched('SOitem',cSOItem,"Testing", ,ThisFormSet.nConnHandle)
					*rtr_Oper_Sched('SOitem',cSOItem,"Peel", ,ThisFormSet.nConnHandle)
				ELSE
					*UN-SCHEDULE
					
				ENDIF		
				************************************************
		*!*	,[OrderSpec],[S_Instrct],[Inv],[BRK],[Gfm],[Draw],[Roll],[Press],[Mach],[CG]
		
				
				cSQLu = "UPDATE dbo.Sales SET "
				cSQLu = cSQLu + " OrderSpec='"+ALLTRIM(cOrderSpec)+"'"
				cSQLu = cSQLu + ",S_Instrct='"+ALLTRIM(cS_Instrct)+"'"
				cSQLu = cSQLu + ",Inv="+IIF(lInv,"1","0")
				cSQLu = cSQLu + ",BRK="+IIF(lBRK,"1","0")
				cSQLu = cSQLu + ",GFM="+IIF(lGFM,"1","0")
				cSQLu = cSQLu + ",Draw="+IIF(lDraw,"1","0")
				cSQLu = cSQLu + ",Roll="+IIF(lRoll,"1","0")
				cSQLu = cSQLu + ",Press="+IIF(lPress,"1","0")
				cSQLu = cSQLu + ",Mach="+IIF(lMach,"1","0")
				cSQLu = cSQLu + ",CG="+IIF(lCG,"1","0")
		
				cSQLu = cSQLu + ",Plasma="+IIF(lPlasma,"1","0")
				cSQLu = cSQLu + ",WJet="+IIF(lWJet,"1","0")
				cSQLu = cSQLu + ",ColdSaw="+IIF(lColdSaw,"1","0")
				
				cSQLu = cSQLu + ",Cert="+STR(nCert)
				cSQLu = cSQLu + ",ShipON="+IIF(llShipOn,"1","0")
		
		*!*	,[ItemTot],[ShipDue],[Shipped]
		*!*	,[MatlWt],[cncld],[cmplt],[PartNo]
		
				IF NOT EMPTY(dShipDue)
					cSQLu = cSQLu + ",ShipDue='"+DTOC(dShipDue)+"'"
				ENDIF
		*- Shipped gets updated from PackingSli[		
		*		IF NOT EMPTY(dShipped)
		*			cSQLu = cSQLu + ",Shipped='"+DTOC(dShipped)+"'"
		*		ENDIF
				cSQLu = cSQLu + ",MatlWt="+STR(nMatlWt,9,1)
				cSQLu = cSQLu + ",Cncld="+IIF(lcncld,"1","0")
		
				cSQLu = cSQLu + ",PartNo='"+ALLTRIM(cPartNo)+"'"
				cSQLu = cSQLu + ",ItemCost="+STR(nItemCost,9,2)
				cSQLu = cSQLu + ",ItemSale="+STR(nItemSale,9,2)
		
				IF lFoundCost
					cSQLu = cSQLu + ",StkPaid= "+STR(PrepareSQLnum(nStkPaid,'StkPaid',9,2),9,2)
					cSQLu = cSQLu + ",StkCost= "+STR(PrepareSQLnum(nSTKCost,'StkCost',9,2),9,2)
					cSQLu = cSQLu + ",POCost= "+STR(PrepareSQLnum(nPOCost,'POCost',9,2),9,2)
				ENDIF		
		
				* Quoted_ is found in dbo.Sales, not in dbo.vSales
				cSQLu = cSQLu + ",Quoted_QTY = "+STR(nQuoted_QTY,18,4)
				cSQLu = cSQLu + ",Quoted_P = "+STR(nQuoted_P,18,4)
				cSQLu = cSQLu + ",Quoted_Total = "+STR(nQuoted_Total,18,4) &&Total of P*QTY 
				cSQLu = cSQLu + ",Quoted_PU = "+STR(nQuoted_PU)
			*	cSQLu = cSQLu + ",Quoted_DollarTotal="+STR(nQuoted_DollarTotal,18,4)
				cSQLu = cSQLu + ",Quoted_CutsP ="+STR(nCutsP,9,2)
				cSQLu = cSQLu + ",Quoted_OtherP ="+STR(nOtherP,9,2)
				cSQLu = cSQLu + ",S_Total = "+STR(nS_Total,18,4) 
		*  		cSQLu = cSQLu + ",[Rma_No]
		*		cSQLu = cSQLu + ",RMA_Detail="+ALLTRIM(STR(nRMA_Detail))
				
		*!*	,[QA],[CofC],[Merc],[pPo],[pPn],[pHeat],[pSpec],[pDesc],[pOther],[Other]
		*!*	,[prcp],[prcd],[pckd]
		*!*	,[Urgent],[ShipOn]
			cSQLu = cSQLu + ",Urgent='"+cUrgent+"'"
		*!*,[Tol],[JobHours],[ProcLoc]
				cSQLu = cSQLu + ",Tol='"+ALLTRIM(cTol)+"'"
				cSQLu = cSQLu + ",ProcLoc='"+cProcLoc+"'"
		
		*!*	,[dShip],[Typ]
				cSQLu = cSQLu + ",DShip="+IIF(lDShip,"1","0") 	
				cSQLu = cSQLu + ",TYP='"+cTYP+"'"  
		
		*!*	,[WO],[WO_Detail],[ProductionWO]
		*!*	,[IntP]
		*!*	,[Export]
				cSQLu = cSQLu + ",Export="+IIF(lExport,"1","0")
		*!*	,[RcvdE],[RMA_E]
		
			
				
				*cSQLu = cSQLu + " WHERE SOitem = '"+cSoItem+"'"
				cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
				
				WAIT WINDOW "Saved to dbo.Sales table" NOWAIT
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!, long triger
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
						lReturn = .F.
						lRollBack = .T.
					ENDIF
				ENDIF
				
				
				IF lCncld 
					*Remove Cancelled process from StockLst and BrokerLst
					
					*Remove_ID_Detail_Process(m.ID_Detail_Process,"SOitem",cSOitem,cTbl,pConnHandle,"CANCELLED")
					IF Cancel_Detail_Process_SOitem(cSOitem,ThisFormSet.nConnHandle)
						
					ENDIF
					
				ENDIF
				
			ELSE
				*lRollBack
			ENDIF
		ENDSCAN
		
		*************************************
		*PRIVATE lSOisListedAsChanging 
		*lSOisListedAsChanging = IsSales_No_Changing(ThisFormSet.SalesNum,ThisFormSet.nConnHandle)
		IF NOT lRollBack 
			IF lAmendVer 
				IF Is_Amendment_Allowed(ThisFormSet.SalesNum,ThisFormSet.nConnHandle)
					lnAmendment = Amend_Sales_No_Ver( ThisFormSet.SalesNum, ThisFormSet.cReprintSOreason, ThisFormSet.nConnHandle)
					IF ThisFormSet.nAmendment > lnAmendment 
						*TrackError("Check Admendment info"+CHR(13)+"ThisFormSet.nAmendment="+STR(ThisFormSet.nAmendment)+CHR(13)+"lnAmendment="+STR(lnAmendment)+CHR(13)+"lnAmendment = Amend_Sales_No_Ver( ThisFormSet.SalesNum, ThisFormSet.cReprintSOreason, ThisFormSet.nConnHandle)"+CHR(13)+"ThisFormSet.SalesNum="+STR(ThisFormSet.SalesNum)+CHR(13)+"ThisFormSet.cReprintSOreason="+ThisFormSet.cReprintSOreason+CHR(13)+"Useing the lnAmendment value" ,"Check Admendment info", PROGRAM(), LINENO(1))
						*Confimed 6/13/2023: Needs ThisFormSet.nAmendment = lnAmendment 
						ThisFormSet.nAmendment = lnAmendment 
					ENDIF
				ELSE
					TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" lnAmendment NOT allowed in Is_Amendment_Allowed ("+DTOC(DATE())+")" +" "+PROGRAM()+" New Amendment was NOT ALLOWED. Amendment:"+ALLTRIM(STR(ThisFormSet.nAmendment)) )
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+"  lnAmendment NOT allowed in Is_Amendment_Allowed  ("+DTOC(DATE())+")" +" New Amendment was NOT ALLOWED. Amendment:"+ALLTRIM(STR(ThisFormSet.nAmendment))+CHR(13)+HTML_SO(ThisFormSet.SalesNum,.T.))
					lnAmendment = ThisFormSet.nAmendment
				ENDIF
				
				IF lnAmendment >= 0
					ThisFormSet.nAmendment = lnAmendment 
					SELECT Sales_No
					REPLACE Amendment WITH ThisFormSet.nAmendment IN Sales_No					
					ThisFormset.frmEO.pf1.pgBillTo.txtAmendment.Value = ThisFormSet.nAmendment
					ThisFormSet.frmEO.pf1.pgQA.txtVersion.Value = ThisFormSet.nAmendment
		
				ELSE
					MESSAGEBOX("Could not get next SO Version!",0+64,"No REV recorded, so Nothing print")
					TrackError("Could not get next SO Version!"+CHR(13)+"ThisFormSet.SalesNum="+ALLTRIM(STR(ThisFormSet.SalesNum))+CHR(13)+"No REV recorded, so Nothing print","Could not get next SO Version!", PROGRAM(), LINENO(1))
		
					*RETURN .F.
					lRollBack = .T.
				ENDIF
			ENDIF
		ENDIF
		
		*lnAmendment = ThisFormSet.nAmendment
		*!*		IF Is_Amendment_Allowed(ThisFormSet.SalesNum,ThisFormSet.nConnHandle)
		*!*			*Update Amendment !!!!
		*!*			lnAmendment = lnAmendment + 1	
		*!*			ThisFormSet.nAmendment = lnAmendment
		*!*								
		*!*			SELECT Sales_No
		*!*			REPLACE Amendment WITH ThisFormSet.nAmendment IN Sales_No					
		*!*			ThisFormset.frmEO.pf1.pgBillTo.txtAmendment.Value = ThisFormSet.nAmendment
		*!*			ThisFormSet.frmEO.pf1.pgQA.txtVersion.Value = ThisFormSet.nAmendment
		*!*			
		*!*			*lnAmendment gets saved in the Sales_No Update.
		*!*		ENDIF
		
							
			*IF ThisFormSet.Set_Sales_No_Chng()
			*	Done in next Sales_No SQL Update
			*ENDIF
		
		
		IF NOT lRollBack 
			*****************************************
			*Check to See if Sales_No Exist to Update
			PRIVATE nCountSales_No
			nCountSales_No = 0
			IF ThisFormSet.SalesNum > 0
				nCountSales_No = Count_SOinSales_No(ThisFormSet.SalesNum,ThisFormSet.nConnHandle,'')
			ENDIF
			IF nCountSales_No = 0
				*Add Sales_No
				PRIVATE cSalesRep,nSOItemTot
				cSalesRep = SalesPDescription(SalesQuote.SalesP,SalesQuote.Cover)
				nSOItemTot	= 1
				
				nSOItemTot = Count_SOinSales_No( ThisFormSet.SalesNum, ThisFormSet.nConnHandle )
				PRIVATE cSQL
				
				cSQL = "INSERT INTO dbo.Sales_No (SalesNum,SalesRep,ItemTot) VALUES ("+ALLTRIM(STR(ThisFormSet.SalesNum))
				cSQL = cSQL +",'"+cSalesRep+"',"+STR(nSOItemTot)+")"  
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						lReturn = .F.
						*lRollBack = .T.
					ENDIF
				ENDIF
			ENDIF
		
		
			PRIVATE lCancelSO
			lCancelSO = PrepareSQLlogic(SalesQuote.Cncld,'Cancel',.F.)
			*lCancelSO = PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgBillTo.chkCancelSO.Value,'Cancel',.F.)
		
			cSQL = "UPDATE dbo.Sales_No SET "
			cSQL = cSQL + " Instrct= '"+ALLTRIM(lcInstrct) +"'"
			cSQL = cSQL + ",BillInstrct= '"+ALLTRIM(lcBillInstrct) +"'"
		
			*IF lnSoldAddr > 0	&&Do not update to a 0
				cSQL = cSQL + ",pSoldAddr= "+ALLTRIM(STR(ThisFormSet.SoldAddr))+"" 
			*ENDIF
			*IF lnShipAddr > 0	&&Do not update to a 0
				cSQL = cSQL + ",pShipAddr= "+ALLTRIM(STR(ThisFormset.ShipAddr))+""
			*ENDIF
			cSQL = cSQL + ",ShipRoute= '"+ALLTRIM(lcShipRoute)+"'"
			cSQL = cSQL + ",ShipPay= '"+lcShipPay+"'"
			
			cSQL = cSQL + ",PayType= '"+lcPayType+"'"
			cSQL = cSQL + ",CustID= '"+lcCustID +"'"
			
			cSQL = cSQL + ",Paper_PO= "+IIF(llpaper_po,'1','0')+""
			cSQL = cSQL + ",Blind= "+IIF(llBlind,'1','0')+""
			cSQL = cSQL + ",FaxConf= "+IIF(llFaxConf,'1','0')+""
			cSQL = cSQL + ",EmailConf= "+IIF(llEmailConf,'1','0')+""
			cSQL = cSQL + ",FreightEst= "+STR(lnFreightEst,9,2)+""
			cSQL = cSQL + ",PrintedSO=0" 	&&remove PrintedSO mark
			cSQL = cSQL + ",Addr_Ref= '"+lcAddr_Ref+"'"
			cSQL = cSQL + ",Trt_Lumber= "+IIF(llFoundCountry,'1','0')+""
			cSQL = cSQL + ",TarfBill= '"+lcTarfBill+"'"
			cSQL = cSQL + ",USA= "+IIF(llUSA,'1','0')+""
		*	cSQL = cSQL + ",Amendment= "+STR(lnAmendment,2,0)+""
			cSQL = cSQL + ",ECPC= "+IIF(lECPC,'1','0')+""
			cSQL = cSQL + ",DPAS= "+IIF(lDPAS,'1','0')+""
			cSQL = cSQL + ",FCI= "+IIF(lFCI,'1','0')+""
			cSQL = cSQL + ",GOV= "+IIF(lGOV,'1','0')+""
			cSQL = cSQL + ",Changing=1 "+" "		&&mark as Changing
			*cSQL = cSQL + ",Cncld="+IIF(lCancelSO,'1','0')+"" **Do not change Cncld here!!
			cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.SalesNum))
				
			WAIT WINDOW "UPDATE dbo.Sales_No " NOWAIT
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!, long triger
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					lReturn = .F.
					*lRollBack = .T.
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
		
			IF nSQLEXEC > 0
				
				UPDATE Sales_No SET ;
				 Instrct= lcInstrct ;
				,BillInstrct=lcBillInstrct ;
				,pSoldAddr= ThisFormSet.SoldAddr ;
				,pShipAddr= ThisFormset.ShipAddr ;
				,ShipRoute= lcShipRoute ;
				,ShipPay= lcShipPay ;
				,PayType= lcPayType ;
				,CustID= lcCustID ;
				,Paper_PO= llpaper_po ;
				,Blind= llBlind ;
				,FaxConf= llFaxConf ;
				,EmailConf= llEmailConf ;
				,FreightEst= lnFreightEst ;
				,PrintedSO= .F. ;
				,Addr_Ref= lcAddr_Ref ;
				,Trt_Lumber= llFoundCountry ;
				,TarfBill= lcTarfBill ;
				,USA= llUSA ;
				,Amendment= lnAmendment ;
				,ECPC= lECPC ;
				,DPAS= lDPAS ;
				,FCI = lFCI ;
				,GOV = lGOV ;
				,PrintedSO=.F.;
				,Changing=.T. ;
				,ShopRecv=.F. ;
				 WHERE SalesNum = ThisFormSet.SalesNum
				
				Track_Sales_No_Chng( "Edit_SalesOrder.SaveSO(success) ",ThisFormSet.SalesNum,.F., lnAmendment  )
				
				ThisFormSet.lChangingSO = .T.
				ThisFormset.frmEO.pf1.pgBillTo.chkSOchanging.Value	= ThisFormSet.lChangingSO
				ThisFormSet.frmEO.pf1.pgQA.chkChanging.Value		= ThisFormSet.lChangingSO
				
				ThisformSet.lPrintedSO	= .F.
				ThisFormset.frmEO.pf1.pgBillTo.chkPrintedSO.Value	= ThisFormSet.lPrintedSO
				ThisFormSet.frmEO.pf1.pgQA.chkPrintedSO.Value		= ThisFormSet.lPrintedSO
				
				ThisFormSet.lShopRecvSO	=	.F.
				ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
				ThisFormSet.frmEO.pf1.pgQA.chkShopRecv.Value		= ThisFormSet.lShopRecvSO
				
				ThisFormSet.nAmendment								= lnAmendment
				ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value	= lnAmendment
				ThisFormSet.frmEO.pf1.pgQA.txtVersion.Value 		= lnAmendment
		
			ENDIF
		
			WAIT WINDOW "Data has been Stored!" NOWAIT
		ENDIF
		
		IF NOT lRollBack 
			LOCAL lcSOitem
			SELECT SalesQuote
			SCAN
				lcSOitem = Proper_SO_item( SalesQuote.SOitem_A )
				IF LEN(ALLTRIM(lcSOitem))=0
					lcSOitem = Proper_SO_Item(SalesQuote.SOitem_B)
				ENDIF
				********Update Ship
				*IF SalesQuote.Cncld 
				IF PrepareSQLlogic(SalesQuote.Cncld,'Cancel',.F.)
					* Update Ship - as Cancelled
					cSQL = "UPDATE dbo.Ship SET	"
					cSQL = cSQL + "[Cncld] = 1"
					cSQL = cSQL + ",SalesP = '"+PrepareSQLtxt(SalesQuote.Salesp,'SalesP',1)+"'"
					cSQL = cSQL + ",Company = '"+PrepareSQLtxt(SalesQuote.company,'Company',30,.F.,.T.)+"'"
					cSQL = cSQL + ",PO_Num = '"+PrepareSQLtxt(SalesQuote.PO_Num,'PO_num',20)+"'"
					cSQL = cSQL + ",Alloy = '"+PrepareSQLtxt(SalesQuote.Alloy,'Alloy',12)+"'"
					cSQL = cSQL + ",DueDate = '"+IIF(EMPTY(SalesQuote.ShipDue),'',DTOC(SalesQuote.ShipDue))+"'"
					*cSQL = cSQL + "	WHERE SOitem = dbo.f_ProperSOitem('"+lcSOItem+"')"
					cSQL = cSQL + "	WHERE SOitem = '"+lcSOItem+"'"
					
					WAIT WINDOW "UPDATE dbo.Ship " NOWAIT
		
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
				ELSE
		
					cSQL = "UPDATE dbo.Ship SET	"
					cSQL = cSQL + "[Cncld] = '0'"
					cSQL = cSQL + ",Salesp = '"+PrepareSQLtxt(SalesQuote.Salesp,'SalesP',1)+"'"
					cSQL = cSQL + ",Company = '"+PrepareSQLtxt(SalesQuote.company,'Company',30,.F.,.T.)+"'"
					cSQL = cSQL + ",PO_Num = '"+PrepareSQLtxt(SalesQuote.PO_Num,'PO_num',20)+"'"
					cSQL = cSQL + ",Alloy = '"+PrepareSQLtxt(SalesQuote.alloy,'Alloy',12)+"'"
					cSQL = cSQL + ",DueDate = '"+IIF(EMPTY(SalesQuote.ShipDue),'',DTOC(SalesQuote.ShipDue))+"'"
					cSQL = cSQL + "	WHERE SOitem = dbo.f_ProperSOitem('"+lcSOItem+"')"
					
					WAIT WINDOW "UPDATE dbo.Ship" NOWAIT
		
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							lReturn = .F.
							*lRollBack = .T.
						ENDIF
					ENDIF
				ENDIF	&&End Update Ship
		
				***** Save Production order 
				IF UPPER(SalesQuote.Company) = "Space Alloys USA"
					IF PrepareSQLlogic(SalesQuote.Cncld,'Cancel',.F.)
						*Remove from BrokerLst
						
					ELSE
						*Check BrokerLst for Insert or Update
						
					ENDIF
				ENDIF
				
				***** ...Lst_Process
				IF NOT EMPTY(SalesQuote.ShipDue) OR SalesQuote.ShipDue = CTOD("01/01/1900")
					IF NOT ISNULL(SalesQuote.ShipDue)
						PRIVATE cSQLUpdate
						cSQLUpdate = "UPDATE dbo.StockLst_Process "
						cSQLUpdate = cSQLUpdate + " SET DueDate = '"+IIF(EMPTY(SalesQuote.ShipDue),'',DTOC(SalesQuote.ShipDue))+"'"
						cSQLUpdate = cSQLUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+lcSOitem+"')"
						cSQLUpdate = cSQLUpdate + " AND ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
						
						WAIT WINDOW "UPDATE dbo.StockLst_Process " NOWAIT
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLUpdate)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 1' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLUpdate)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLUpdate)
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLUpdate, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLUpdate, "")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQLUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLUpdate )
								*lReturn = .F.
								*lRollBack = .T.
							ENDIF
						ENDIF
		
			***			****
						cSQLUpdate = "UPDATE dbo.BrokerLst_Process "
						cSQLUpdate = cSQLUpdate + " SET DueDate = '"+IIF(EMPTY(SalesQuote.ShipDue),'',DTOC(SalesQuote.ShipDue))+"'"
						cSQLUpdate = cSQLUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+lcSOitem+"')"
						cSQLUpdate = cSQLUpdate + " AND ( Process_ID = 'SELECTED' OR Process_ID='PartSelect' )"
						
						WAIT WINDOW "UPDATE dbo.BrokerLst_Process " NOWAIT
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLUpdate)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 1' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLUpdate)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLUpdate, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLUpdate, "")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQLUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLUpdate )
								*lReturn = .F.
								*lRollBack = .T.
							ENDIF
						ENDIF
		
					ENDIF
				ENDIF
				
				WAIT WINDOW "Validate_Sales_ShipDue() " NOWAIT
				Validate_Sales_ShipDue(lcSOitem,ThisFormSet.nConnHandle)
				
				******************************
				ThisFormSet.Check_SOitem_Hrs(.F.)
				******************************
				
			ENDSCAN
		ENDIF
		
		IF NOT lRollBack 
			IF ThisFormSet.ShipAddr > 0 AND ThisFormSet.SoldAddr > 0
				WAIT WINDOW "Save_Sold_Ship() " NOWAIT
				Save_Sold_Ship(ThisFormSet.SoldAddr, ThisFormSet.ShipAddr, ThisFormSet.nConnHandle)
			ENDIF
		
			ThisFormSet.frmEO.cmdConfirmSO.Enabled = .T.
			ThisFormSet.frmEO.cmdProforma.ENABLED = .T.
		ENDIF
		
		********************************************
		
		IF lRollBack 
			= SQLROLLBACK(ThisFormSet.nConnHandle)
			= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1) && Auto transactions
			
			MESSAGEBOX( "The SO could not be SAVED because of error.",16,"Save failed!")
		ELSE
			= SQLCOMMIT(ThisFormSet.nConnHandle)
			= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1) && Auto transactions
			
			TrackMess("Saved Sales Order:"+ALLTRIM(STR(lnSalesNum)) )
		ENDIF
		
		********************************************
		*Refresh 
		THISFORMSET.Load_Sales_No()
		
		IF USED('Sales_No')
			IF RECCOUNT('Sales_No') > 0
				*refresh done in Load_Sales_No
				
				PRIVATE cCustID
				cCustID = PrepareSQLtxt(SalesQuote.CustID,'CustID',20)
				IF LEN(ALLTRIM(cCustID))=0
					*Not sure why SalesQuote.CustID is lost
					cCustID = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)
					IF NOT LEN(ALLTRIM(cCustID))=0
						SELECT SalesQuote
						REPLACE CustID WITH cCustID IN SalesQuote
					ENDIF
				ENDIF
						
				IF LEN(ALLTRIM(ThisFormSet.cPaymentType))=0
					*IF cWhat = "PRINT"
					PRIVATE cPaymentTypeNumber
					cPaymentTypeNumber = GetPayTypeNum( SalesQuote.CustID, SalesQuote.Company, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle )
					IF cPaymentTypeNumber $ "OverLimit"
						MESSAGEBOX("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!",64,"Warning, already over credit Limit!")
						Trackmess("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!, before adding SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" "+PROGRAM())
						cPaymentTypeNumber = LEFT(cPaymentTypeNumber,1)
					ENDIF
					ThisFormSet.cPaymentType = ShowPaymentTypeText(cPaymentTypeNumber)
				ENDIF
				
				ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value	= ThisFormSet.nAmendment
				ThisFormSet.frmEO.pf1.pgBillTo.chkSOchanging.Value	= ThisFormSet.lChangingSO
				ThisFormSet.frmEO.pf1.pgBillTo.chkPrintedSO.Value	= ThisFormSet.lPrintedSO
				ThisFormSet.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
		
			ELSE
				*No Records!
				TrackError("No Sales_No records", "THISFORMSET.Load_Sales_No()", PROGRAM(),LINENO(1))
			ENDIF		
		ENDIF
		
		********************************************
		WAIT CLEAR
		
		*Go back to the Hold Record Number.
		SELECT SalesQuote
		*ThisFormSet.Refresh &&Does not work with the Value page
		IF mHoldRecordNum > 0
			GOTO (mHoldRecordNum) IN SalesQuote
		ELSE
			IF nItem > 0
				LOCATE FOR Item_A = nItem
			ELSE
				MESSAGEBOX("RECNO('SalesQuote') has been lost."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem)),0,"Lost RecNo")
				TrackError("Lost RecNo","RECNO('SalesQuote') is 0."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"End of Save SO.",PROGRAM(),LINENO(1))
		
				GOTO TOP
			ENDIF
		ENDIF
		
		RETURN lReturn
		
	ENDPROC

	PROCEDURE save_soitem_hrs
		*ThisFormSet.Save_SOitem_Hrs()
		*Also see Refresh_pgQA()  Check_SOitem_Hrs()
		PRIVATE nINVhrs, nBRKhrs, nRecvHrs, nMachHrs, nCGhrs,nPackHrs,nGFMhrs,nDrawHrs,nRollHrs,nPressHrs
		PRIVATE nHeatHrs,nTestHrs,nAbrsvHrs,nBSawHrs,nShearHrs,nPlasmaHrs,nWJetHrs,nHrs
		PRIVATE cSOitem, dDateEst
		
		nINVhrs 	= ThisFormset.frmEO.pf1.pgQA.spnINV.Value	
		*nBRKhrs 	= ThisFormset.frmEO.pf1.pgQA.spnINV.Value	
		nRecvHrs 	= ThisFormset.frmEO.pf1.pgQA.spnRecv.Value	
		nMachHrs	= ThisFormset.frmEO.pf1.pgQA.spnMach.Value	
		nCGhrs		= ThisFormset.frmEO.pf1.pgQA.spnCG.Value	
		nPackHrs	= ThisFormset.frmEO.pf1.pgQA.spnPack.Value	
		nGFMhrs		= ThisFormset.frmEO.pf1.pgQA.spnGFM.Value	
		nDrawHrs	= ThisFormset.frmEO.pf1.pgQA.spnDraw.Value	
		nRollHrs	= ThisFormset.frmEO.pf1.pgQA.spnRoll.Value
		nPressHrs	= ThisFormset.frmEO.pf1.pgQA.spnPress.Value
		nHeatHrs	= ThisFormset.frmEO.pf1.pgQA.spnHeat.Value
		nTestHrs	= ThisFormset.frmEO.pf1.pgQA.spnTest.Value
		nAbrsvHrs	= ThisFormset.frmEO.pf1.pgQA.spnAbrsv.Value
		nBSawHrs	= ThisFormset.frmEO.pf1.pgQA.spnBSaw.Value
		nShearHrs	= ThisFormset.frmEO.pf1.pgQA.spnShear.Value
		nPlasmaHrs	= ThisFormset.frmEO.pf1.pgQA.spnPlasma.Value
		nWJetHrs	= ThisFormset.frmEO.pf1.pgQA.spnWJet.Value
		
		nHrs = nINVhrs + nRecvHrs + nMachHrs + nCGhrs + nPackHrs + nGFMhrs + nDrawHrs + nRollHrs + nPressHrs 
		nHrs = nHrs + nHeatHrs + nTestHrs + nAbrsvHrs + nBSawHrs + nShearHrs +nPlasmaHrs + nWJetHrs
		nHrs = nHrs + 1
		
		ThisFormSet.frmEO.pf1.pgQA.lblHRS.Caption = STR(nHrs)
		cSOitem = ThisFormset.frmEO.pf1.pgQA.lblSOitem.Caption
		
		dDateEst = PrepareSQLDate(ThisFormset.frmEO.pf1.pgQuote.txtShipDue.Value,'ShipdDue')
		dDateEst = Get_ShipDateinSales(cSOitem ,ThisFormSet.nConnHandle )
		
		cSQL = "UPDATE dbo.SOitem_Hrs "
		cSQL = cSQL + "SET INV="+STR(nINVhrs)
		cSQL = cSQL + ",Recv="+STR(nRecvHrs)
		cSQL = cSQL + ",[Mach]="+STR(nMachHrs)
		cSQL = cSQL + ",[CG]="+STR(nCGhrs)
		cSQL = cSQL + ",[Pack]="+STR(nPackHrs)
		cSQL = cSQL + ",[GFM]="+STR(nGFMhrs)
		cSQL = cSQL + ",[Draw]="+STR(nDrawHrs)
		cSQL = cSQL + ",[Roll]="+STR(nRollHrs)
		cSQL = cSQL + ",Press="+STR(nPressHrs)
		cSQL = cSQL + ",Heat="+STR(nHeatHrs)
		cSQL = cSQL + ",Test="+STR(nTestHrs)
		cSQL = cSQL + ",Abrsv="+STR(nAbrsvHrs)
		cSQL = cSQL + ",BSaw="+STR(nBSawHrs)
		cSQL = cSQL + ",Shear="+STR(nShearHrs)
		cSQL = cSQL + ",Plasma="+STR(nPlasmaHrs)
		cSQL = cSQL + ",WJet="+STR(nWJetHrs)
		cSQL = cSQL + ",Hrs="+STR(nHrs)
		cSQL = cSQL + ",DateEst='"+IIF(EMPTY(dDateEst),'',DTOC(dDateEst))+"'"
		*cSQL = cSQL + ",DateEst='"+DTOC(dDateEst)+"'"
		*cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"tmpSOitem_Hrs")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitem_Hrs')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Hrs")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Hrs")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSOitem_Hrs')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				RETURN .F.
			ENDIF
		ENDIF
		
		RETURN .T.
		
	ENDPROC

