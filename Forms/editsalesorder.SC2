	PROCEDURE frmEO.pf1.pgQuote.txtShipdue.Valid
		PRIVATE dShipDue
		dShipDue = PrepareSQLdate(This.Value,'ShipDue')
		
		IF dShipDue != CTOD("  /  /  ")
			*Have a date
			IF dShipDue > DATE() + 1095 
				*3 Years Ahead
				MESSAGEBOX("Date field is for OVER 3 years ahead!"+CHR(13)+"ShipDue",0,"Warning")
			ENDIF
			IF dShipDue < DATE() - 90
				*3 Years Ahead
				MESSAGEBOX("Date field is for 3 months ago!"+CHR(13)+"ShipDue",0,"Warning")
			ENDIF
		ENDIF
		
		SELECT SalesQuote
		REPLACE ShipDue WITH dShipDue IN SalesQuote
		
	ENDPROC

