	PROCEDURE frmPO.cmdPrintPO.Click
		*DODEFAULT()
		*RETURN
		**************************
		
		**Get POShipAddr **
		PRIVATE nPOShipAddr
		nPOShipAddr = PrepareSQLnum(ThisForm.pgfPO.pgPOAddress.txtPOShipAddr.Value,'POShipAddr',-3)
		
		IF EMPTY(nPOShipAddr)
			MESSAGEBOX("Please Enter a 'Ship To Address'."+CHR(13)+"Please remember to add the address.",16,"No Print")
			RETURN .F.
		ENDIF
		
		**Get VendorContact **
		PRIVATE nContactID
		nContactID = PrepareSQLnum(ThisForm.pgfPO.pgVendorContact.nContactID.Value,'ContactID',-3)
		IF NOT SelectVendorContact(nContactID,ThisFormSet.nConnHandle)
			MESSAGEBOX("Could not retrieve VendorContact for ContactID: "+ALLTRIM(STR(nContactID)),16,"Cannot proceed")
			TrackError("Error","Could not retrieve VendorContact for ContactID: "+ALLTRIM(STR(nContactID)),"PurchaseOrder:cmdPrintPO.Click",LINENO(1))
			RETURN .F.
		ENDIF
		
		
		PRIVATE nHpaPo,lClosePO
		nHpaPo = PrepareSQLnum(ThisForm.pgfPO.pgPOAddress.txtHPAPo.Value,'HPAPO',-3)
		lClosePO = .T.
		
		IF nHpaPo > 0
		*	IF MESSAGEBOX("Do You want to Print/Preview this?"+CHR(13)+"ERP PO: "+ALLTRIM(STR(nHpaPo)),4+32,'You must preview to print.') = 6
		*		ThisFormSet.VISIBLE = .F.
				ThisFormSet.frmPO.PrintPO(nHpaPo,lClosePO)
		*		ThisFormSet.VISIBLE = .T.
		*		ThisFormSet.frmPO.AlwaysOnTop = .T.
		*		ThisFormSet.frmPO.AlwaysOnTop = .F.
		*	ENDIF
		ENDIF
		
		***************************
	ENDPROC

