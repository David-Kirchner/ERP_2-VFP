	PROCEDURE Destroy
		*SET CLASSLIB TO
		IF VARTYPE(ThisFormSet.frmEO) = "O"  &&
			ThisFormSet.frmEO.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmPO) = "O" &&
			ThisFormSet.frmPO.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmEoP) = "O"  &&
			ThisFormSet.frmEoP.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmPONotes) = "O" &&
			ThisFormSet.frmPONotes.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmStartingStock) = "O"  &&
			ThisFormSet.frmStartingStock.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmWOD) = "O"  &&
			ThisFormSet.frmWOD.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmWO) = "O"
			ThisFormSet.frmWO.Release
		ENDIF
		IF VARTYPE(ThisFormSet.frmCustomer) = "O"  &&
			ThisFormSet.frmCustomer.Release
		ENDIF
		
		RELEASE aShipRoutes
		RELEASE glTrt_lumber
		RELEASE gaCCtype
		*RELEASE gShippingCopy
		RELEASE gaCCtype
		
		IF "PURCHASEORDER" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\PURCHASEORDER"
		ENDIF
		
	ENDPROC

	PROCEDURE didsoitem_usestock
		*ThisFormSet.didSOitem_UseStock()
		
		IF USED('tmpUseINV')
			USE IN tmpUseINV
		ENDIF
		
		cSQL="SELECT TBL FROM ( "
		cSQL = cSQL + " SELECT 'S' AS TBL FROM dbo.StockLst_Process "
		cSQL = cSQL + " 	WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SOitem_A+"')"
		cSQL = cSQL + " AND Process_ID='SELECTED  '"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT 'B' AS TBL FROM dbo.BrokerLst_Process "
		cSQL = cSQL + " 	WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SOitem_A+"')"
		cSQL = cSQL + " AND Process_ID='SELECTED  '"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT 'W' AS TBL FROM dbo.WIPLst_Process "
		cSQL = cSQL + " 	WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SOitem_A+"')"
		cSQL = cSQL + " AND Process_ID='SELECTED  '"
		cSQL = cSQL + " ) t "
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUseINV')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUseINV')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUseINV")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUseINV")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpUseINV')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		PRIVATE cTyp
		cTyp = ALLTRIM(PrepareSQLtxt(SalesQuote.Typ,'TYP',1))
		
		IF USED('tmpUseINV')
			IF RECCOUNT('tmpUseINV') > 0
				SCAN
					IF tmpUseINV.TBL="S"
						*Found a Inventory selected process!
						SELECT SalesQuote
						REPLACE SalesQuote.INV WITH .T.
						IF LEN(ALLTRIM(cTyp))=0
							REPLACE SalesQuote.Typ WITH 'I'
						ELSE
							IF SalesQuote.Typ != 'I'
								WAIT WINDOW "Found Marked Inventory, it is wrong that Sales 'Type' is listed as: "+SalesQuote.Typ TIMEOUT 1
							ENDIF
						ENDIF
					ENDIF
					IF tmpUseINV.TBL="B"
						*Found a Inventory selected process!
						SELECT SalesQuote
						REPLACE SalesQuote.BRK WITH .T.
						IF LEN(ALLTRIM(cTyp))=0
							REPLACE SalesQuote.Typ WITH 'B'
						ELSE
							IF SalesQuote.Typ != 'B'
								WAIT WINDOW "Found Marked Brokered Stock, it is wrong that Sales 'Type' is listed as: "+SalesQuote.Typ TIMEOUT 1
							ENDIF
						ENDIF
					ENDIF
		
				ENDSCAN
			ENDIF
			USE IN tmpUseINV
		ENDIF
		
		ThisFormSet.frmEO.pf1.pgOrder.chkInv.Refresh
		ThisFormSet.frmEO.pf1.pgOrder.cmbTyp.Refresh
	ENDPROC

