			ThisFormSet.frmEO.pf1.pgValue.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgShipto.Enabled = .T.
			*ThisFormSet.frmEO.pf1.pg_po.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgCreditCard.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQA.ENABLED = .T.
		
			ThisFormSet.frmEO.pf1.pgQuote.cmdPrev.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmdNext.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmdP.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmdN.ENABLED = .T.
			
		CASE WhereWhat = "ContactToSave"
			ThisFormSet.frmPO.POaddress_Screen("ContactToSave")
			
			ThisFormSet.frmEO.cmdTop.Enabled = .F.
			ThisFormSet.frmEO.cmdPrev.Enabled = .F.
			ThisFormSet.frmEO.cmdNext.Enabled = .F.
			ThisFormSet.frmEO.cmdSO_Save.Enabled = .F.
			ThisFormSet.frmEO.cmdPrintAll.Enabled = .F.
			ThisFormSet.frmEO.cmdPrintWS.Enabled = .F.
			ThisFormSet.frmEO.cmdPrintWSExt.ENABLED = .F.
			ThisFormSet.frmEO.cmdPrintSO.Enabled = .F. 
			ThisFormSet.frmEO.cmdConfirmSO.Enabled = .F.
			ThisFormSet.frmEO.cmdProforma.Enabled = .F.
			ThisFormSet.frmEO.cmdExit.Enabled = .F.
			
		
			ThisFormSet.frmEO.pf1.pgOrder.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgValue.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgShipto.Enabled = .F.
		*		ThisFormSet.frmEO.pf1.pg_po.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgCreditCard.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQA.Enabled = .F.
			
			ThisFormSet.frmEO.pf1.pgQuote.cmdPrev.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmdNext.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmdP.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmdN.ENABLED = .F.
			
			ThisFormSet.frmEO.pf1.pg_po.cmdPOAdd.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pg_po.cmdPODelete.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pg_po.cmdPOEdit.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pg_po.cmdPrintPO.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pg_po.chkCancelPO.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pg_po.chkDeliveredPO.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pg_po.cmdPoPrev.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pg_po.cmdPoNext.ENABLED = .F.
					
		******
		ENDCASE
		*ThisFormSet.frmEO.EnablePrint()
	ENDPROC

	PROCEDURE calcinv
		PARAMETER pnField
		*ThisFormSet.CalcInv(2)
		
		*************************************** 
		** repeat changes in SetPriceBracket **
		*************************************** 
		
		IF VARTYPE(pnField) != 'N'
			pnField = 0
		ENDIF
		
		IF pnField = 2 AND ( ThisFormset.frmEO.pf1.pgQuote.txtSZ3.Visible AND ThisFormset.frmEO.pf1.pgQuote.txtSZ3.Enabled )
			RETURN &&Only calcutlate field 2 when field 3 is not Visible/Enabled
		ENDIF
		IF pnField = 12 AND ( ThisFormset.frmStartingStock.ssSZ31.Visible AND ThisFormset.frmStartingStock.ssSZ31.Enabled )
			RETURN &&Only calcutlate field 2 when field 3 is not Visible/Enabled
		ENDIF
		
		
		
		PRIVATE pcurdbf,cCurrTable,pcuralloy,nDensity 
		PRIVATE nCalcWeight,nCalcPricePerPound,nCalcLotPrice,nStandardThickness
		PRIVATE nCalcPricePerPiece,nCalcPricePerPieceCut,nCalcCutPounds,nCalcCutOnlyTotal,nCalcLotPriceCut
		PRIVATE cCC,cCL,nThck,nSz2,nSz3
		PRIVATE lnPieces, nCalcMachWeight, cCommonSpec 
		PRIVATE nPriceBracket, nForceBracket
		PRIVATE cForm,local_cCut, cCutOptions
		
		*nCalcMachWeight = 0
		
		PRIVATE lOpenedAlloy
		lOpenedAlloy = .F.
		
		lnPieces = SalesQuote.pieces
		IF lnPieces < 1
			lnPieces = 1
		ENDIF
		
		
		nDensity = 0
		nCalcWeight		= 0
		nCalcPricePerPound	= 0
		nCalcLotPrice   = 0
		nCalcLotPriceCut = 0
		nCalcPricePerPiece	= 0
		nCalcPricePerPieceCut= 0
		nCalcCutPounds	= 0
		nCalcCutOnlyTotal		= 0
		nForceBracket 	= 0
		
		PRIVATE nSurCharge,cWeightMess,cPriceMess,lActivePrice
		nSurCharge	= 0
		cWeightMess	= ''
		cPriceMess	= ''
		lActivePrice= .F.
		
		cCurrTable = ALIAS()
		
		IF pnField > 10
			pcuralloy = PrepareSQLtxt(ThisFormset.frmStartingStock.ssALLOY1.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmStartingStock.ssThck1.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmStartingStock.ssSz21.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmStartingStock.ssSz31.Value,'Sz3',9,3)
		ELSE
			pcuralloy = PrepareSQLtxt(ALLTRIM(SalesQuote.alloy),'Alloy',12)
			cForm	= PrepareSQLtxt(SalesQuote.Form,'Form',2)
			cCC		= PrepareSQLtxt(SalesQuote.CC,'CC',1)
			cCL		= PrepareSQLtxt(SalesQuote.CL,'CL',1)
			nThck	= PrepareSQLnum(SalesQuote.thck,'Thck',10,4)
			nSz2	= PrepareSQLnum(SalesQuote.Sz2,'sz2',9,3)
			nSz3	= PrepareSQLnum(SalesQuote.Sz3,'Sz3',9,3)
		ENDIF
		nStandardThickness	= ALLTRIM(Remove0( nThck,9,4 ))
		cCustID = PrepareSQLtxt(SalesQuote.CustID,'CustID',20)
		
		*local_cCut = GetCut_Letter_Number(ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.ogCutting.value)
		*cCutOptions = PrepareSQLtxt(SalesQuote.CutOptions,'CutOptions',75,.T.)
		
		IF LEN(ALLTRIM(cForm))=0
			MESSAGEBOX("Form has not been entered!",0+64,"Enter Form!")
			RETURN .F.
		ENDIF
		
		
		**************************************
		DO CASE
			CASE cForm = '60'
				IF nSz2*2>= nThck
					MESSAGEBOX("The Tube form cannot have a wall thickness greater than the Radius of OD",0,"Form Error")
					RETURN .F.
				ENDIF
			CASE cForm = '65'
				IF nSz2 = 5 OR nSz2 = 10 OR nSz2 = 20 OR nSz2 = 30 OR nSz2 = 40 OR nSz2 = 60 OR nSz2 = 80 OR nSz2 = 100 OR nSz2 = 120 OR nSz2 = 140 OR nSz2 = 160 
					*OK
				ELSE
					MESSAGEBOX("The Pipe form has a nonstandard Schedule."+CHR(13)+"Cannot get a Standard Price.",16,"Form Pipe")
					*RETURN .F.
				ENDIF
		ENDCASE
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.p_GetFullQuoteCL "
		cSQL = cSQL + STR(lnPieces)
		cSQL = cSQL + ",'"+pcuralloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",'"+cCL+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		cSQL = cSQL + ",'"+cCustID+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				
				PRIVATE cMess
				cMess = "Could not get the Price!"+CHR(13)
				IF lnPieces > 10000
					cMess = cMess + "Your Piece Count could be too high "+STR(lnPieces)+"."+CHR(13)
				ENDIF
				IF nThck > 16
					cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
				ENDIF
				IF nSz2	> 120
					cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
				ENDIF
				IF nSz3	 > 300
					cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
				ENDIF
				MESSAGEBOX(cMess,16,"Edit your input numbers")
		
			ENDIF
		ENDIF
		
		*!*	SELECT @nPounds AS Pounds, @lnSurcharge AS Surcharge, @nCutPounds AS CutPounds
		*!*	, @nPrice AS Price, @nBracket AS Bracket
		*!*	, @nStdSize AS StdSize
		*!*	, @cAlloy AS StdAlloy
		*!*	, @nDensity AS Density
		*!*	, @cMessage AS WeightMess
		*!*	, @cPTMessage AS PriceMess, @bActivePrice AS ActivePrice
		
		IF USED('tmpPriceTbl')
		
			IF EMPTY(tmpPriceTbl.Density)
				IF NOT LEN(ALLTRIM(pcuralloy))=0
					MESSAGEBOX("USING .290 DENSITY  - THE REAL FIGURE SHOULD BE PROGRAMED",0+64,"Alloy Density not found")
				ENDIF
				nDensity = .29
			ELSE 
				nDensity = tmpPriceTbl.Density
			ENDIF
		
			nCalcWeight			= tmpPriceTbl.Pounds
			nSurCharge 			= tmpPriceTbl.Surcharge
			nCalcCutPounds		= tmpPriceTbl.CutPounds	&&Abrasive Only .375 Kerf
			nCalcPricePerPound	= tmpPriceTbl.Price		
			nPriceBracket		= tmpPriceTbl.Bracket
			nStandardThickness	= tmpPriceTbl.StdSize
			*StdAlloy
			*Density
			cCommonSpec			= tmpPriceTbl.CommonSpec
			cWeightMess			= tmpPriceTbl.WeightMess
			cPriceMess			= tmpPriceTbl.PriceMess
			lActivePrice		= tmpPriceTbl.ActivePrice
			
			*Pounds,Surcharge,CutPounds,Price,Bracket,StdSize,StdAlloy,Density,CommonSpec,WeightMess,PriceMess,ActivePrice
			
			IF NOT lActivePrice
				*MESSAGEBOX( "Using Price Estimate - Price is not Active.",0+48,"Old Price")
				WAIT WINDOW "Using Price Estimate - Price is not Active." TIMEOUT 1
			ENDIF
			
			*Look for a returned error message
			IF NOT LEN( ALLTRIM(cWeightMess)+ALLTRIM(cPriceMess) )=0
				IF NOT LEN( ALLTRIM(cWeightMess))=0
					IF NOT LEN(ALLTRIM(cPriceMess) )=0
						MESSAGEBOX(ALLTRIM(cWeightMess)+CHR(13)+ALLTRIM(cPriceMess),0+64,"Weight\Price Message")
					ELSE
						MESSAGEBOX(ALLTRIM(cWeightMess),0+64,"Weight Message")
					ENDIF
				ELSE
					MESSAGEBOX(cPriceMess,0+64,"Price Message")
				ENDIF
			ENDIF
			
		*!*		*** Duplicate Surcharge changes to SetPriceBracket
		*!*		
		*!*		IF INLIST(cForm, '10','11','12','13','20','21','40','80','90')
		*!*		*	nSurCharge = AlloySurcharge(pcuralloy)
		*!*			ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.lblSurcharge.Caption = "Surcharge: "+ALLTRIM(STR(nSurCharge,9,3))
		*!*			IF nCalcPricePerPound > 0
		*!*				nCalcPricePerPound = nCalcPricePerPound + nSurCharge
		*!*			ENDIF
		*!*		ELSE
		*!*			IF pnField < 10
		*!*				ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.lblSurcharge.Caption = "Surcharge: "
		*!*			ENDIF
		*!*		ENDIF
		
			*IF nPriceBracket > 0
			*	IF PriceTable.stkbase > PriceTable.base
			*		WAIT WINDOW 'HIGH INVENTORY COST '+LTRIM(STR(PriceTable.stkbase,7,2)) NOWAIT
			*	ENDIF
			*ENDIF
				
		*!*		IF pnField < 10
		*!*			IF LEN(ALLTRIM(cCommonSpec))=0 OR ISNULL(cCommonSpec )
		*!*				ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.lblCommSpec.Caption = '  '
		*!*				ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.lblCommSpec.BackColor = RGB(0,255,255)
		*!*			ELSE
		*!*				ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.lblCommSpec.Caption = cCommonSpec 
		*!*				ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.lblCommSpec.BackColor = RGB(255,255,255)
		*!*			ENDIF
		*!*		ENDIF
			
			USE IN tmpPriceTbl
		ELSE
			*Error in SQL
			nCalcPricePerPound	= 0
			nPriceBracket		= 0
			nCalcCutPounds		= 0
			nCalcWeight			= 0
			cCommonSpec			= ''
			nStandardThickness	= 0
			nCalcLotPriceCut	= 0
		ENDIF
		
		IF USED('SalesQuote ')
			SELECT SalesQuote 
		ENDIF
		
		
		*!*	IF nStandardThickness > nThck*1.1 OR nStandardThickness < nThck/1.1
		*!*		*Warn if Standard is far from Thck
		*!*		*MESSAGEBOX("Your Quote is for Size: "+ALLTRIM(STR(nThck,9,4))+CHR(13)+"The Price Table Standard Size is: "+ALLTRIM(STR(nStandardThickness,9,4)),64,"Non Standard Size")
		*!*		WAIT WINDOW "Your Quote is for Size: "+ALLTRIM(STR(nThck,9,4))+". The Price Table Standard Size is: "+ALLTRIM(STR(nStandardThickness,9,4)) NOWAIT
		*!*	ENDIF
		
		*!*	nCalcLotPrice = ( nCalcPricePerPound * nCalcWeight )
		*!*	nCalcPricePerPiece = nCalcLotPrice  / lnPieces 	
		
		*!*	*The above cuts where based on abrasive Cutting. Check CutOption for Detailed cut charge!
		*!*	PRIVATE nCutPrice
		*!*	nCutPrice = 0
		
		*!*	IF NOT LEN(ALLTRIM(cCutOptions))=0
		*!*		PRIVATE cCutType, cCutOptions1, cCutPrice, cCutUnit, cCutSpeed
		*!*		PRIVATE nCutPcPrice, cCut 
		*!*		cCutType	= LEFT(cCutOptions, AT(" ",cCutOptions))
		*!*		cCutType 	= UPPER(ALLTRIM(cCutType))
		*!*		cCutOptions1 = RIGHT(cCutOptions,LEN(cCutOptions)-AT('$',cCutOptions))
		*!*		IF AT('/',cCutOptions1) > 0
		*!*			cCutPrice	= LEFT(cCutOptions1,AT('/',cCutOptions1)-1)
		*!*			cCutUnit	= SUBSTR(cCutOptions1,AT('/',cCutOptions1)+1,2)
		*!*		ELSE
		*!*			*" combined " $ cCutOptions
		*!*			cCutPrice	= LEFT(cCutOptions1,AT('Total',cCutOptions1)-1)
		*!*			cCutUnit = "LOT"
		*!*		ENDIF
		
		*!*		IF AT('%',cCutOptions1) > 0
		*!*			cCutSpeed = SUBSTR(cCutOptions1,AT('@',cCutOptions1)+1,3)
		*!*			IF '%' $ cCutSpeed 
		*!*				cCutSpeed = LEFT(cCutSpeed,2)
		*!*			ENDIF
		*!*		ELSE
		*!*			cCutSpeed	= ''
		*!*		ENDIF
		*!*		
		*!*		nCutPrice = PrepareSQLnum(cCutPrice,'CutPrice',10,2)
		*!*		
		*!*	ENDIF
		
		
		*!*	PRIVATE nKerfAdjust, nKerfAdjustTol 
		*!*	nKerfAdjust = 1
		*!*	*nCalcCutPounds is based on .3 which is good for .015
		*!*	nKerfAdjust = KerfAdjust(local_cCut,cForm,nThck)
		*!*	*nKerfAdjustTol = KerfAdjustTol(local_cCut,cForm,nThck)
		
		*!*	*Quote.Cut = N-not specified, A-abrasive, B-band saw, S-shear, P-plasma, W-waterjet
		*!*	DO CASE
		*!*	CASE local_cCut  = 'A'
		*!*		nCalcCutOnlyTotal	= ( nCalcPricePerPound * nCalcCutPounds * nKerfAdjust )
		*!*		nCalcLotPriceCut 	= nCalcLotPrice + ( nCalcPricePerPound * nCalcCutPounds * nKerfAdjust )
		*!*		nCalcPricePerPieceCut = nCalcLotPriceCut / lnPieces 
		*!*		
		*!*	CASE local_cCut  = 'B'
		*!*		nCalcCutOnlyTotal	= ( nCalcPricePerPound * nCalcCutPounds * nKerfAdjust )
		*!*		nCalcLotPriceCut	= nCalcLotPrice + ( nCalcPricePerPound * nCalcCutPounds * nKerfAdjust )
		*!*		nCalcPricePerPieceCut = nCalcLotPriceCut / lnPieces 
		*!*		
		*!*	CASE local_cCut  = 'P'
		*!*		nCalcCutOnlyTotal	= nCutPrice
		*!*	*	nCalcLotPriceCut	= nCalcLotPrice + nCutPrice
		*!*		nCalcLotPriceCut	= nCalcLotPrice + ( nCutPrice * lnPieces )
		*!*		nCalcPricePerPieceCut = nCalcLotPriceCut / lnPieces
		*!*		
		*!*		IF cForm = '80'
		*!*			IF LEN(ALLTRIM(cCutOptions))=0
		*!*				ThisFormSet.PlasmaCut('DEFAULT')
		
		*!*				nCalcCutOnlyTotal = ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.CCut1.Value
		*!*				nCalcLotPriceCut = nCalcLotPrice + ( nCalcCutOnlyTotal * lnPieces )
		*!*				nCalcPricePerPieceCut = nCalcLotPriceCut / lnPieces
		*!*				
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*	CASE local_cCut  = 'W'
		*!*		nCalcCutOnlyTotal = nCutPrice
		*!*	*	nCalcLotPriceCut = nCalcLotPrice + nCutPrice
		*!*		nCalcLotPriceCut = nCalcLotPrice + ( nCutPrice * lnPieces )
		*!*		nCalcPricePerPieceCut = nCalcLotPriceCut / lnPieces
		*!*		
		*!*		IF cForm = '80'
		*!*			IF LEN(ALLTRIM(cCutOptions))=0
		*!*				*Waterjet Cut Disk $"+"/PC @100% "
		*!*				ThisFormSet.WaterJetCut('DEFAULT')
		
		*!*				nCalcCutOnlyTotal = ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.CCut1.Value
		*!*				nCalcLotPriceCut = nCalcLotPrice + ( nCalcCutOnlyTotal * lnPieces )
		*!*				nCalcPricePerPieceCut = nCalcLotPriceCut / lnPieces	
		*!*							
		*!*			ENDIF
		*!*		ENDIF	
		*!*		
		*!*	OTHERWISE
		*!*		*try Abrasive numbers 
		*!*	*	nCircleCutLoss = 3.14 * ( nSz2 + .375 +.375 )  && 3/8 plasma curf
		*!*		nCalcCutOnlyTotal = ( nCalcPricePerPound * nCalcCutPounds )
		*!*		nCalcLotPriceCut = nCalcPricePerPound * ( nCalcWeight + nCalcCutPounds )
		*!*		nCalcPricePerPieceCut = nCalcLotPriceCut / lnPieces 
		*!*	ENDCASE
		*!*		
		
		
			IF pnField < 10
				ThisFormset.frmEO.pf1.pgQuote.txtWeight.Value = nCalcWeight
				ThisFormset.frmEO.pf1.pgQuote.txtWeight.Refresh
				
		*!*		REPLACE SalesQuote.cweight  WITH nCalcWeight IN SalesQuote 
		*!*	*!*		IF cForm = '80' 
		*!*	*!*			REPLACE SalesQuote.weight	WITH (nCalcWeight - nCalcCutPounds) IN SalesQuote 
		*!*	*!*			ThisFormset.frmEO.pf1.pgQuote.WEIGHT1.Refresh
		*!*	*!*		ENDIF
		*!*		REPLACE SalesQuote.cp_lb    WITH nCalcPricePerPound IN SalesQuote 
		*!*		ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.cWEIGHT1.Refresh
		*!*		
		*!*		REPLACE SalesQuote.cp_pc    WITH nCalcPricePerPiece IN SalesQuote 
		*!*		ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.cP_LB1.Refresh
		*!*		
		*!*		REPLACE SalesQuote.cp_pcc   WITH nCalcPricePerPieceCut IN SalesQuote 
		*!*		ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.cP_PCC1.Refresh
		*!*			
		*!*		REPLACE SalesQuote.clotp    WITH nCalcLotPrice IN SalesQuote 
		*!*		ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.cLOTP1.Refresh
		*!*		
		*!*		REPLACE SalesQuote.clotcp   WITH nCalcLotPriceCut IN SalesQuote 
		*!*		ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.cLOTCP1.Refresh
		*!*			
			cStandardThickness = 	ALLTRIM(STR(nStandardThickness,10,4))
		*!*		REPLACE SalesQuote.cthk     WITH cStandardThickness IN SalesQuote 
		*!*		ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.cTHK1.Refresh
		*!*		
		*!*		REPLACE SalesQuote.ccut     WITH nCalcCutOnlyTotal IN SalesQuote 
		*!*		ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.CCUT1.Refresh
		*!*		
		*!*		REPLACE SalesQuote.bracket  WITH nPriceBracket IN SalesQuote 
		*!*		ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.ZOrder
		*!*		ThisFormSet.Refresh
		*!*		ThisFormset.frmEO.pf1.pgQuote.pf1.PagePricing.cmbBracket.Value = SalesQuote.bracket
		
		*!*		REPLACE SalesQuote.Surcharge  WITH nSurcharge IN SalesQuote 
		*!*		
		*!*		
		*!*		IF ThisFormSet.FrmStockLst_Sum.Visible
		*!*			ThisFormSet.StockLst_Sum_Reload()
		*!*		ENDIF
		ELSE
			ThisFormset.frmStartingStock.ssWeight1.Value = nCalcWeight
			ThisFormset.frmStartingStock.ssWeight1.Refresh
		ENDIF
		
		IF NOT LEN(ALLTRIM(cCurrTable))=0
			IF USED(cCurrTable)
				SELECT (cCurrTable)
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE calcpgvalues
		*ThisFormSet.CalcPgValues()
		
		PRIVATE nItem2
		nItem2 = SalesQuote.Item
		
		Private cCurrTable
		cCurrTable = ALIAS()
		
		PRIVATE ncurrSalesNumRec
		
		IF USED('SalesTotal')
			SELECT SalesQuote
			nCurrSalesNumRec = RECNO('SalesQuote')
			LOCATE FOR Item = nItem2
		ELSE
			nCurrSalesNumRec = 0
		ENDIF
		
		*ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Visible = .F.
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.RecordSource = ""
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSOd.grdValueItem.RecordSource = ""
		
		IF NOT USED('SalesTotal')
		
			ThisFormSet.fnSalesTotal = UniqDBF(ThisFormSet.fnSalesTotal)
		
			
			SELECT 0
			SET SAFETY OFF
			IF "\MEM" $ SYS(2003)
				CREATE TABLE ( SYS(5)+SYS(2003)+"\"+ThisFormSet.fnSalesTotal ) FREE (ItemSale Y, ItemCost Y, ItemSkCost Y, ItemSKPaid Y, ItemPOCost Y, Item INT, Cncld l, SOitem CHAR(10))
			ELSE
				CREATE TABLE ( SYS(5)+SYS(2003)+"\MEM\"+ThisFormSet.fnSalesTotal ) FREE (ItemSale Y, ItemCost Y, ItemSkCost Y, ItemSKPaid Y, ItemPOCost Y, Item INT, Cncld l, SOitem CHAR(10))
			ENDIF
		*	INSERT INTO SalesTotal (ItemSale,ItemCost,ItemPOCost,Item,Cncld,SOitem) VALUES (0.00,0.00,0.00,1,.F.,'0-01')
			SELECT ItemSale, ItemCost, 00000000.00 AS ItemSkCost, 00000000.00 AS ItemSKPaid, 00000000.00 AS ItemPOCost, Item_A as Item, Cncld, SOitem FROM SalesQuote INTO TABLE (SYS(5)+SYS(2003)+"\"+ThisFormSet.fnSalesTotal)
			USE (SYS(5)+SYS(2003)+"\"+ThisFormSet.fnSalesTotal) EXCL ALIAS SalesTotal
		ENDIF
		
		
		SELECT SalesTotal
		*SELECT ItemSale, ItemCost, 0.00 AS ItemPOCost, Item_A as Item, Cncld, SOitem FROM SalesQuote INTO TABLE SalesTotal
		
		
		PRIVATE nSumSale,nSumCost,nSumPOCost, nSumStkCost, nSumStkPaid
		nSumSale = 0
		nSumCost = 0
		nSumPOCost = 0
		nSumStkCost = 0
		nSumStkPaid = 0
		
		PRIVATE nItem
		nItem = 0
		
		PRIVATE nItemSale, nItemCost, nPOCost, nStkCost, nStkPaid
		nItemSale	= 0
		nItemCost	= 0
		nPOCost		= 0
		nStkCost	= 0
		nStkPaid	= 0
		
		PRIVATE cSOitem
		PRIVATE nSQLEXEC, cSQL
		*cSOitem = Proper_SO_Item(SalesQuote.SOItem_A)
		
		SELECT SalesTotal
		GO TOP
		SCAN
			nItem = PrepareSQLnum(SalesTotal.item,'Item',-1)
			IF nItem = 0
				SKIP
			ENDIF
			cSOitem = Proper_SO_Item(SalesTotal.SOitem)
			
			**
			IF Proper_SO_item(SOitem) = Proper_SO_item('')
				nItemSale	= 0
				nItemCost	= 0
				nPOCost		= 0
				nStkCost	= 0
				nStkPaid	= 0
			ELSE
				
				*nItemSale = getSale_SOitem( SalesTotal.SOitem, ThisFormSet.nConnHandle )
				**Cordinate Items between tables
				*SELECT SalesQuote
				*LOCATE FOR SOitem = SalesTotal.SOitem
				*IF FOUND('SalesQuote')
				*	nItemSale = ThisFormSet.calc_ItemSale(cSOitem)
				*ELSE 	
				*	nItemSale	= 0
				*ENDIF
				*SELECT SalesTotal
				* ????? expose these Varibles to worksheet22 ?????
				nItemSale = ThisFormSet.calc_ItemSale(cSOitem)
				*nItemSale = getItemCost_SOitem(cSOitem)
				
				nPOCost = getPOCost_SOitem( cSOitem, ThisFormSet.nConnHandle )
				nStkCost = getStkCost_SOitem( cSOitem, ThisFormSet.nConnHandle )
				nStkPaid = getStkPaid_SOitem( cSOitem, ThisFormSet.nConnHandle )
				nItemCost = PrepareSQLnum( nPOCost + nStkCost ,'ItemCost',9,2)
		
			ENDIF
			
			UPDATE SalesTotal ;
				SET ItemSale = nItemSale ;
					,ItemCost = nItemCost ;
					,ItemPOCost = nPOCost ;
					,ItemSkCost = nSTKCost ;
					,ItemSkPaid = nStkPaid ;	
				WHERE Item = nItem
				
			WAIT WINDOW cSOitem NOWAIT
			
			IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
		*!*			**Save to SQL  --UpdtItemSale() does ItemSale,Quoted_QTY,Quoted_P,Quoted_Total,Quoted_PU
		*!*			cSQL = "UPDATE dbo.Sales SET "
		*!*			cSQL = cSQL + " ItemSale = "+STR(PrepareSQLnum(nItemSale,'ItemSale',9,2),9,2)
		*!*			cSQL = cSQL + ",ItemCost = "+STR(PrepareSQLnum(nItemCost,'ItemCost',9,2),9,2)
		*!*			cSQL = cSQL + ",StkCost = "+STR(PrepareSQLnum(nSTKCost,'StkCost',9,2,),9,2)
		*!*			cSQL = cSQL + ",StkPaid = "+STR(PrepareSQLnum(nStkPaid,'StkPaid',9,2,),9,2)
		*!*			cSQL = cSQL + ",POCost = "+STR(PrepareSQLnum(nPOCost,'POCost',9,2,),9,2)
		*!*			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
		*!*				
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*			IF nSQLEXEC < 0
		*!*				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC )
		
		*  				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*				*RETURN
		*!*			ENDIF
				
				UPDATE SalesQuote ;
					SET ItemSale = nItemSale ;
					,ItemCost = nItemCost ;
					,StkCost = nSTKCost ;
					,StkPaid = nStkPaid ;
					,POCost = nPOCost ;
					WHERE Item = nItem		
					
			ENDIF	
			
			SELECT SalesTotal 
			
			LOCATE FOR Item = nItem &&Get back, because the Update will take to EOF
		*!*		**
		*!*		*done in sumStockLstCost()
		*!*		**
		
			nSumPOCost  = nSumPOCost  + nPOCost
			nSumSTKCost = nSumSTKCost + nStkCost
			nSumStkPaid = nSumStkPaid + nStkPaid
			nSumCost  = nSumCost + nItemCost 
			nSumSale  = nSumSale + nItemSale		
		ENDSCAN
		
		SELECT SalesTotal
		GO TOP
		*LOCATE FOR Item = nItem2
		
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.RecordSource 		= "SalesTotal"
		*ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Visible = .T.
		
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Column1.ControlSource	= "SalesTotal.ItemSale"  &&unknown member 2014/11/21
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Column2.ControlSource	= "SalesTotal.ItemCost"  &&unknown member 2015/08/20 also
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Column3.ControlSource = "SalesTotal.ItemSkCost"
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Column4.ControlSource	= "SalesTotal.ItemPOCost"
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Column5.ControlSource	= "(SalesTotal.ItemSale - SalesTotal.ItemCost )"
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Column6.ControlSource	= "SalesTotal.item"
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Column7.ControlSource	= "SalesTotal.Cncld"
		
		*!*	ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.clmSale.ControlSource	= "SalesTotal.ItemSale"  &&unknown member 2014/11/21
		*!*	ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.clmCost.ControlSource	= "SalesTotal.ItemCost"  &&unknown member 2015/08/20 also
		*!*	ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.clmSTKCost.ControlSource= "SalesTotal.ItemSkCost"
		*!*	ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.clmPOCost.ControlSource	= "SalesTotal.ItemPOCost"
		*!*	ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.clmProfit.ControlSource	= "(SalesTotal.ItemSale - SalesTotal.ItemCost )"
		*!*	ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.clmItem.ControlSource		= "SalesTotal.item"
		*!*	ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.clmCncld.ControlSource	= "SalesTotal.Cncld"
		
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSOd.grdValueItem.RecordSource 	= "SalesTotal"
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSOd.grdValueItem.Column1.ControlSource	= "SalesTotal.item"
		*ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSOd.grdValueItem.clmItem.ControlSource	= "SalesTotal.item"
		
		PRIVATE ntProfit, ntPercent
		ntProfit = nSumSale - nSumCost  
		IF nSumSale <> 0
			ntPercent = (ntProfit / nSumSale ) * 100
		ELSE
			ntPercent = 100
		ENDIF
		
		
		ThisFormSet.frmEO.pf1.pgValue.nSale.Value    = PrepareSQLnum(nSumSale,'SumSale',10,2)
		ThisFormSet.frmEO.pf1.pgValue.nCost.Value    = PrepareSQLnum(nSumCost,'SumCost',10,2)
		ThisFormSet.frmEO.pf1.pgValue.nStkCost.Value = PrepareSQLnum(nSumStkCost,'SumStkCost',10,2)
		ThisFormSet.frmEO.pf1.pgValue.nPOCost.Value  = PrepareSQLnum(nSumPOCost,'SumPOCost',10,2)
		ThisFormSet.frmEO.pf1.pgValue.nProfit.Value  = PrepareSQLnum(ntProfit,'Profit',10,2)
		ThisFormSet.frmEO.pf1.pgValue.nPercent.Value = PrepareSQLnum(ntPercent,'Percent',4,1)
		
		IF ntProfit < 1
			ThisFormSet.frmEO.pf1.pgValue.nProfit.DisabledBackColor = RGB(255,0,0)
		ELSE
			ThisFormSet.frmEO.pf1.pgValue.nProfit.DisabledBackColor = RGB(212,208,200)
		ENDIF
		
		**************************
		SELECT SalesTotal
		LOCATE FOR Item = nItem2
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSum.grdPrices.Refresh
		ThisFormSet.frmEO.pf1.pgValue.pfPrice.pgSOd.grdValueItem.Refresh
		
		**************************
		IF NOT USED('SalesQuote')
			PRIVATE cMess
			cMess = "SalesQuote table is gone!."+CHR(13)
			cMess = cMess+"Current table is listed as '"+ALLTRIM(ShowSQLtxt(cCurrTable,'CurrTable',30))+"'."
			TrackError("CalcPgValues",cMess,PROGRAM(),LINENO(1))
		ENDIF
		
		SELECT SalesQuote
		IF ncurrSalesNumRec > RECCOUNT()
			GO BOTTOM
		ELSE
			IF nCurrSalesNumRec = 0
				GO TOP
			ELSE	
				GOTO (ncurrSalesNumRec)
			ENDIF
		ENDIF
		
		IF NOT LEN(ALLTRIM(cCurrTable))=0
			IF USED(cCurrTable)
				SELECT (cCurrTable)
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE calcpolotcost
		PARAMETER pSOitem, nQTY
		*ThisFormSet.CalcPOLotCost( m.SOitem, QTY )
		
		IF VARTYPE(pSOitem) != "C"
			RETURN 0
		ENDIF
		IF nQTY = 0
			nQTY = 1
		ENDIF
		
		IF USED('cntPO')
			USE IN cntPO
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT StockLst_QTY,StockLst_P,([StockLst_QTY] * [StockLst_P]) AS [LotCost] "
		cSQL = cSQL + ",StockLst_PU "		&&ERP Acct Standard
		cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
		cSQL = cSQL + " WHERE [SOitem] = dbo.f_ProperSOitem('"+pSOitem+"') "
		cSQL = cSQL + " AND Cancelled =0"
		cSQL = cSQL + " AND Services =0"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntPO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntPO' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntPO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntPO")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntPO' )
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		PRIVATE nAddCost,nStockCost,nStockLst_QTY 
		
		IF USED('cntPO')
			*SELECT LotCost FROM cntPO INTO ARRAY aPOCalc 
			nAddCost = 0
			nStockLst_QTY = 0
			SCAN
				nStockLst_QTY = nStockLst_QTY + cntPO.StockLst_QTY
				
				nStockCost = ( cntPO.StockLst_P * cntPO.StockLst_QTY )
				
				nAddCost = nAddCost + nStockCost 
				
			ENDSCAN
			
			GO TOP
			
			IF nStockLst_QTY*1.15 < nQTY
				IF nQTY*1.15 < nStockLst_QTY
					*More than 15% apart
					
					nTmpCost = StockLst_P * QTY
					
					IF MESSAGEBOX("Adding the Quantity for PO's for this SaleOrder item:"+ALLTRIM(pSOitem)+CHR(13)+"adds up to QTY of "+ALLTRIM(STR(nStockLst_QTY))+"."+CHR(13)+"The count the Order to use "+ALLTRIM(STR(nQTY))+CHR(13)+CHR(13)+"Do you want to use the cost as QTY of "+ALLTRIM(STR(nQTY))+" $"+ALLTRIM(STR(nTmpCost))+" for this item? (Y)"+CHR(13)+"The cost here is an estimate,"+CHR(13)+"the real cost will be entered after the incoming PO is received.",4,"Buying more htan sold?")=6
						nAddCost = nTmpCost 
					ENDIF
				ENDIF
			ENDIF
			
			USE IN cntPO
		ENDIF
			
		
		RETURN nAddCost 
		
		
	ENDPROC

	PROCEDURE calc_itemsale
		PARAMETERS pSOitem
		*ThisFormSt.calc_ItemSale(SOitem)
		
		PRIVATE nItemSale 
		nItemSale = getItemSale_SOitem(pSOitem, ThisFormSet.nConnHandle)
		IF nItemSale > 0
			RETURN nItemSale
		ENDIF
		
		****************************************************************
		PRIVATE cSOitem
		IF VARTYPE(pSOitem)="C"
			cSOitem = Proper_SO_item(pSOitem)
		ELSE
			cSOitem = Proper_SO_item(SalesQuote.SOitem)
		ENDIF
		*Old
		
		PRIVATE nWeight, nP_Lb, nP_Pc, nP_Ft
		nWeight		= PrepareSQLnum(SalesQuote.Weight,'Weight',8,1)
		nP_Lb		= PrepareSQLnum(SalesQuote.P_lb,'P_Lb',8,2)
		nP_Pc		= PrepareSQLnum(SalesQuote.P_pc,'P_Pc',9,2)
		nP_Ft		= PrepareSQLnum(SalesQuote.P_ft,'P_Ft',8,2)
		PRIVATE nCutsP, cOtherFld, nOtherP, nLotP
		nCutsP		= PrepareSQLnum(SalesQuote.Cuts,'Cuts',8,2)
		cOtherFld	= PrepareSQLtxt(SalesQuote.OtherFld,'OtherFld',10)
		nOtherP		= PrepareSQLnum(SalesQuote.OtherP,'OtherP',8,2)
		nLotP		= PrepareSQLnum(SalesQuote.LotP,'LotP',9,2)
		
		***************
		PRIVATE nQ_P, nQ_QTY, nQ_PU, nQ_Total, nItemSale 	&&AS Quoted for Customer
		nQ_P	= PrepareSQLnum(SalesQuote.Q_P,'Q_P',-5)
		nQ_QTY	= PrepareSQLnum(SalesQuote.Q_QTY,'Q_QTY',-5)
		nQ_PU	= PrepareSQLnum(SalesQuote.Q_PU,'Q_PU',-1)
		
		nQ_Total = PrepareSQLnum( ( nQ_QTY * nQ_P ),'Q_Total',10,2)
		nItemSale = nQ_Total +nCutsP +nOtherP
		
		***************
		PRIVATE nS_QTY, nS_P, nS_PU, nS_Total  &&ERP Acct Stnd
		nS_QTY	= PrepareSQLnum(SalesQuote.S_QTY,'S_QTY',-5)
		nS_P	= PrepareSQLnum(SalesQuote.S_P,'S_P',-5)
		nS_PU	= PrepareSQLnum(SalesQuote.S_PU,'S_PU',-5)
		nS_Total = PrepareSQLnum(SalesQuote.S_Total,'S_Total',10,2)
		*****
		
		IF nQ_Total = 0
			*Use old School Calc
			****************************************************
			*Use this Function to return a table with the Quoted Answers
			*This overwrite typical units and uses Units found in OtherFld and OtherP
			
			PRIVATE nPieces,cAlloy,cForm,nThck,nSz2,nSz3
			nPieces	= PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(SalesQuote.Alloy,"Alloy",12)
			cForm	= PrepareSQLtxt(SalesQuote.Form,"Form",2)
			nThck	= PrepareSQLnum(SalesQuote.Thck,'Thck',9,4)
			nSz2	= PrepareSQLnum(SalesQuote.Sz2,'Sz2',8,3)
			nSz3	= PrepareSQLnum(SalesQuote.Sz3,'Sz3',8,3)
			
			IF Get_Quote_Pricing(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, ThisFormSet.nConnHandle)
				IF USED('tmpQuote_Pricing')
					*nQ_P		= Get_Quote_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, ThisFormSet.nConnHandle)
					nQ_P	= PrepareSQLnum(tmpQuote_Pricing.P,'Q_P',-5)
					nQ_PU	= PrepareSQLnum(tmpQuote_Pricing.PU,'Q_PU',-1)
					nQ_QTY	= PrepareSQLnum(tmpQuote_Pricing.QTY,'Q_QTY',-5)
					nQ_Total= PrepareSQLnum(tmpQuote_Pricing.Total,'Q_Total',10,2)
				ENDIF
			ENDIF
		ENDIF
		
		IF nS_Total = 0 AND nQ_Total > 0
		
			nS_Total = nQ_Total +nCutsP +nOtherP
			REPLACE S_Total WITH nS_Total IN SalesQuote
			
			IF nS_PU = 0
				nS_PU = GetPUfromForm(SalesQuote.Form, ThisFormSet.nConnHandle)
				REPLACE S_PU WITH nS_PU IN SalesQuote
			ENDIF
			
			*******************
			
			IF nS_PU > 0
				IF nS_QTY * nS_P > 0
					IF nS_QTY = 0
						IF (nS_Total -nCutsP -nOtherP) > 0
							nS_QTY = (nS_Total -nCutsP -nOtherP) / nS_P 
							REPLACE S_QTY WITH nS_QTY IN SalesQuote
						ENDIF
					ENDIF
				ELSE
							
					*Unless S_PU = Q_PU
					IF nS_PU = nQ_PU
						nS_P = nQ_P
						nS_QTY = nQ_QTY
						REPLACE S_P WITH nS_P IN SalesQuote
						REPLACE S_QTY WITH nS_QTY IN SalesQuote
						nS_Total = (nS_P * nS_QTY) +nCutsP +nOtherP
					ELSE
						*Not Enough information! 
						 RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Not Enough information for Calc_ItemSale "+cSOitem)
					ENDIF
					
				ENDIF		
				
				IF (nS_Total -nCutsP -nOtherP) > 0
					IF nS_P <> (nS_Total -nCutsP -nOtherP) / nS_QTY
						nS_P = (nS_Total -nCutsP -nOtherP) / nS_QTY
						REPLACE S_P WITH nS_P IN SalesQuote
					ENDIF
				ELSE
					IF nQ_Total > 0
						nS_P = nQ_Total / nS_QTY
						REPLACE S_P WITH nS_P IN SalesQuote			
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
			
		IF CEILING(nQ_Total) <> CEILING(nS_Total)
			IF nQ_Total > 0
				*nQ_Total High or Low
				IF (nQ_Total +nCutsP +nOtherP) > nS_Total *1.01 OR nS_Total > (nQ_Total +nCutsP +nOtherP) * 1.01
					*more than 1% off
					
					*MESSAGEBOX(STR(CEILING(nQ_Total))+" Quote Total is not matching "+CHR(13)+STR(CEILING(nS_Total))+" ERP Acct Standard",0+32,"")
					
					nS_Total = nQ_Total +nCutsP +nOtherP
		
					*Get QTY for Acct PU
					nS_QTY	= Calc_QTY(SalesQuote.Alloy,SalesQuote.Form,SalesQuote.Pieces,SalesQuote.Thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.OtherFld,ThisFormSet.nConnHandle)
					
					nS_P = nQ_Total / nS_QTY 
					
					REPLACE S_P WITH nS_P IN SalesQuote
					REPLACE S_QTY WITH nS_QTY IN SalesQuote
					REPLACE S_Total WITH nS_Total IN SalesQuote
					
				ENDIF
			ELSE
				
			ENDIF
			
		ENDIF
		
		RETURN nQ_Total
	ENDPROC

	PROCEDURE ccaddress
		PARAMETER pAction
		PRIVATE nCardAddr
		DO CASE
		CASE pAction = "SHOW"
		
			nCardAddr =	ThisFormSet.frmEO.pf1.pgCreditCard.txtSoldcode.VALUE
		
			IF USED( 'SoldAddr' )
				USE IN SoldAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SoldCode = "+STR(nCardAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'SoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'SoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SoldAddr")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'SoldAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			IF USED( 'SoldAddr' )
		*		ThisFormSet.ShipAddr = SoldAddr.ShipCode
		*		ThisFormSet.frmEO.pf1.pgCreditCard..txtShipCode.VALUE = SoldAddr.SoldCode
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCompany.VALUE = SoldAddr.company
				ThisFormSet.frmEO.pf1.pgCreditCard.txtAddr1.VALUE = SoldAddr.Addr1
				ThisFormSet.frmEO.pf1.pgCreditCard.txtAddr2.VALUE = SoldAddr.Addr2
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCity.VALUE = SoldAddr.City
				ThisFormSet.frmEO.pf1.pgCreditCard.txtST.VALUE = SoldAddr.ST
				ThisFormSet.frmEO.pf1.pgCreditCard.txtZip.VALUE = SoldAddr.Zip
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCountry.VALUE = UPPER(ALLTRIM(SoldAddr.Country))
				ThisFormSet.frmEO.pf1.pgCreditCard.txtContact.VALUE = SoldAddr.Contact
				ThisFormSet.frmEO.pf1.pgCreditCard.txtPhone.VALUE = SoldAddr.Telephone
				ThisFormSet.frmEO.pf1.pgCreditCard.txtFax.VALUE = SoldAddr.Fax_Number
				ThisFormSet.frmEO.pf1.pgCreditCard.txtEmail.VALUE = SoldAddr.Email
				ThisFormSet.frmEO.pf1.pgCreditCard.txtLastEdit.VALUE = IIF(EMPTY(PrepareSQLdate(SoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(SoldAddr.LastEdit,'LastEdit'))
				
				USE IN SoldAddr
			ENDIF
			
		ENDCASE
		
	ENDPROC

	PROCEDURE ccscreen
		Parameter pAction
		
		DO CASE
		CASE pAction = "ENABLE"
				ThisFormSet.frmEO.pf1.pgCreditCard.txtHolderName.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.cmbCardtype.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo1.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo4.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCCV.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireDd.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireMm.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireYyyy.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtSale.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtShipIns.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtTotalAmt.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtNotes.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthNo.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthDate.ENABLED = .T.
		
		CASE pAction = "DISABLE"
				ThisFormSet.frmEO.pf1.pgCreditCard.txtHolderName.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.cmbCardtype.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo1.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo4.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCCV.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireDd.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireMm.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireYyyy.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtSale.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtShipIns.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtTotalAmt.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtNotes.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthNo.ENABLED = .F.
				ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthDate.ENABLED = .F.
		
		ENDCASE
	ENDPROC

	PROCEDURE checkcc
		PARAMETER pAction
		
		IF VARTYPE(pAction) != "C"
			pAction = ""
		ENDIF
		
		PRIVATE nFirst, cMiddle , nLast, nMiddle1, nMiddle2
		PRIVATE lcCardType
		
		nFirst		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCardno1.Value,'CardNo1',4,0)
		cMiddle 	= ThisFormSet.frmEO.pf1.pgCreditCard.txtCardno.Value
		nMiddle1 	= PrepareSQLnum(LEFT(cMiddle,4),'CardNo2',4,0)
		nMiddle2 	= PrepareSQLnum(RIGHT(cMiddle,4),'CardNo3',4,0)
		*nLast		= PADL( ALLTRIM(STR(PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCardno4.Value,'CardNo',4,0),4,0)),4,'0')
		nLast		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCardno4.Value,'CardNo4',4,0)
		lcCardType 	= ThisFormSet.frmEO.pf1.pgCreditCard.cmbCardType.Value
		
		
		DO CASE
		CASE pAction = "FIRST"
			IF nFirst < 0 OR nFirst > 9999
				MESSAGEBOX("This must be 4 Digits long",0,"Wrong number of Digits!")
		*		RETURN .F.
			ENDIF
		CASE pAction = "MIDDLE"
			IF nMiddle1 + nMiddle2 < 0 OR nMiddle1+nMiddle2 > 99999999
				MESSAGEBOX("This must be 8 Digits long",0,"Wrong number of Digits!")
		*		RETURN .F.
			ENDIF
		CASE pAction = "LAST"
			IF lcCardType = "AMEX"
				IF nLast <  0 OR nLast > 999
					MESSAGEBOX("This must be 3 Digits long",0,"Wrong number of Digits!")
		*			RETURN .F.
				ENDIF
			ELSE
				IF nLast < 0 OR  nLast > 9999
					MESSAGEBOX("This must be 4 Digits long",0,"Wrong number of Digits!")
		*			RETURN .F.
				ENDIF
			ENDIF
		OTHERWISE
		
		ENDCASE
		
		RETURN .T.
	ENDPROC

	PROCEDURE checkdata4print
		*ThisFormSet.CheckData4Print()
		
		PRIVATE lReturn, nMess, cMess
		lReturn = .T.
		nMess	= 0
		cMess	= ''
		
		IF USED('SalesQuote')
			SELECT SalesQuote
			GO TOP
		ELSE
			MESSAGEBOX("Lost Table 'SalesQuote'!"+CHR(13)+"Data will reload."+CHR(13)+"Recheck data as some edits were lost!",0+16,"Error")
			ThisFormSet.Refresh_SalesQuote(.F.)
			TrackError( "Lost Table 'SalesQuote'!","CheckData4print",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		*********************************
		*Check for Cancel
		PRIVATE lCancelOrder
		IF PrepareSQLchk( ThisFormSet.frmEO.pf1.pgBillTo.chkCancelSO.Value,'Cancel' )
			lCancelOrder = .T.
			RETURN .T.	&&Allow the cancelled SO to print
		ELSE
			lCancelOrder = .F.
		ENDIF
		
		*********************************
		*Check for Addresses
		PRIVATE nShipAddr, nSoldAddr
		nShipAddr	= PrepareSQLnum(ThisFormSet.ShipAddr,'ShipAddr',-3)
		nSoldAddr	= PrepareSQLnum(ThisFormSet.SoldAddr,'SoldAddr',-3)
		
		IF nShipAddr < 1
			nShipAddr	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgShipto.txtShipCode.Value ,'ShipAddr',-3)
			IF nShipAddr > 0
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"ThisFormSet.ShipAddr = 0, found ShipCode in 'ThisFormSet.frmEO.pf1.pgShipTo.txtShipCode.Value' SalesNum="+STR(ThisFormSet.SalesNum)+CHR(13)+HTML_SO(ThisFormSet.SalesNum,.T.) )
				ThisFormSet.ShipAddr = nShipAddr
			ELSE
				MESSAGEBOX("No Shipping Address Found."+CHR(13)+"Please correct before printing.",0+16,"Print cancelled.")
				RETURN .F.
			ENDIF
		ENDIF
		IF nSoldAddr < 1
			nSoldAddr = PrepareSQLnum(ThisFormSet.frmEO.pf1.pgBillTo.txtSoldCode.Value ,'SoldAddr',-3)
			IF nSoldAddr > 0
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"ThisFormSet.SoldAddr = 0, found SoldCode in 'ThisFormSet.frmEO.pf1.pgSoldTo.txtSoldCode.Value' SalesNum="+STR(ThisFormSet.SalesNum)+CHR(13)+HTML_SO(ThisFormSet.SalesNum,.T.) )
				ThisFormSet.SoldAddr = nSoldAddr 
			ELSE
				MESSAGEBOX("No Sold To Address Found."+CHR(13)+"Please correct before printing.",0+16,"Print cancelled.")
				RETURN .F.
			ENDIF
		ENDIF
		
		
		*********************************
		PRIVATE nRecNum
		nRecNum = RECNO('SalesQuote')
		
		SELECT SalesQuote
		
		
		PRIVATE cSOitem, lDShip, lInv, lIs_Stock_Selected
		PRIVATE lPassSalesQ
		lPassSalesQ = .T.
		PRIVATE lCancel
		
		IF NOT lReturn 
			SCAN
				lPassSalesQ = .T.
				lCancel = PrepareSQLchk(SalesQuote.Cncld,'Cancel' )
				IF lCancel
					LOOP
				ENDIF
				
				cSOitem 	= Proper_PO_Item(SalesQuote.SOItem_A)
				lDShip		= PrepareSQLlogic(SalesQuote.DShip,'DShip',.F.)
				IF lDShip
					*Check to see if there is a PO!
					IF SalesQuote.HPAPO = 0 AND SalesQuote.HPAPO2 = 0
						MESSAGEBOX("Quote page has SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"being a 'Direct Ship from Vendor'"+CHR(13)+"But there is no PO to Vendor!",32,"Add PO!")
					ENDIF
				ENDIF
				
				cTyp = PrepareSQLtxt(SalesQuote.Typ,'Typ',1)
				*Inv,I,Broker,B,Mill,M,Production,P,Service,S,Conversion,C
				IF NOT (cTyp = "I" OR cTyp = "B" OR cTyp = "M" OR cTyp = "P" OR cTyp = "S" OR cTyp = "C")
					MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"is not marked for Type!"+CHR(13)+"Not allowed to continue!",0+64,"Enter Type of Order")
					lReturn = .F.
					lPassSalesQ = .F.
				ENDIF
				
				lInv = PrepareSQLlogic(SalesQuote.INV,'Inv',.F.)
				lIs_Stock_Selected = IIF( get_ID_Detail_with_SOitem(cSOitem, 'S', 'SELECTED', ThisFormSet.nConnhandle) > 0, .T.,.F.)
				
				IF NOT lPassSalesQ 
					IF lInv	
						IF lIs_Stock_Selected
							*Good
						ELSE
							IF PrepareSQLnum(SalesQuote.WO,'WO',-3) > 0 OR PrepareSQLnum(SalesQuote.WO_Detail,'WO_Detail',-3) > 0
								*Good, A Production can select Stock
							ELSE
								MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"Marked as 'from Inventory'"+CHR(13)+"yet nothing has Selected in Inventory"+CHR(13)+"for SOitem:'"+cSOitem+"'"+CHR(13)+"Allowed to Print for now.",0+64,"Inventory flagged but not selected!")
					*			lReturn = .F.			
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
			ENDSCAN
		ENDIF
		
		*********************************
		*Check Quoted price numbers to Sold.
		SELECT SalesQuote
		PRIVATE cSOitem, lCancel, cMess, nQ_PU1, nQuoted_PU1 
		
		IF NOT lReturn 
			SCAN
				
				lCancel = PrepareSQLchk(SalesQuote.Cncld,'Cancel' )
				IF lCancel
					LOOP
				ENDIF
				
				cSOitem 	= Proper_PO_Item(SalesQuote.SOItem_A)
				cMess = ''
				nQ_PU1 		= PrepareSQLnum(SalesQuote.Q_PU,'PU',1)
				*nQuoted_PU1 = PrepareSQLnum(SalesQuote.Quoted_PU,'PU',1)
				
		*!*			IF nQ_PU1 <> nQuoted_PU1 
		*!*				IF nQ_PU1 > 0
		*!*					IF nQuoted_PU1 > 0
		*!*						cMess = "SOitem '"+cSOitem+"' is written differently than Quoted. (PU)"+CHR(13)+CHR(13)
		*!*						cMess = cMess + HTML_SOitem(cSOitem,.F.)+CHR(13)
		*!*						cMess = cMess + Get_cPUfrom_nPU(PrepareSQLnum(SalesQuote.Q_PU,'Q_PU',1),ThisFormSet.nConnHandle)+" is the Quoted Price Unit (Q_PU)."+CHR(13)
		*!*						cMess = cMess + Get_cPUfrom_nPU(PrepareSQLnum(SalesQuote.Quoted_PU,'Q_PU',1),ThisFormSet.nConnHandle)+" is the Sold Price Unit (Quoted_PU)."+CHR(13)		
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*			
				*IF PrepareSQLnum(SalesQuote.Q_PU,'PU',1) = PrepareSQLnum(SalesQuote.Quoted_PU,'PU',1)		
				*	*Only check if PU matches  -old records could have wrong PU before 6/16/2020
					
		*!*				IF PrepareSQLnum(SalesQuote.Q_P,'Q_P',-3) <> PrepareSQLnum(SalesQuote.Quoted_P,'Q_P',-3)
		*!*					*Quoted Price is different
		*!*					IF LEN(cMess)= 0
		*!*						cMess = cMess + "SOitem '"+cSOitem+"' is written differently than Quoted. (Price)"+CHR(13)+CHR(13)
		*!*						cMess = cMess + HTML_SOitem(cSOitem,.F.)+CHR(13)
		*!*					ENDIF
		*!*					cMess = cMess + "     (Q_P) "+STR(PrepareSQLnum(SalesQuote.Q_P,'Q_P',-3),18,4)+" is the Quoted Price per Unit."+CHR(13)
		*!*					cMess = cMess + "(Quoted_P) "+STR(PrepareSQLnum(SalesQuote.Quoted_P,'Q_P',-3),18,4)+" is the Sold Price per Unit."+CHR(13)
		*!*				ENDIF
					
		*!*				IF PrepareSQLnum(SalesQuote.Q_QTY,'Q_QTY',-3) <> PrepareSQLnum(SalesQuote.Quoted_QTY,'Q_QTY',-3)
		*!*					*Quoted QTY is different
		*!*					IF LEN(cMess)= 0
		*!*						cMess = cMess + "SOitem '"+cSOitem+"' is written differently than Quoted. (QTY)"+CHR(13)+CHR(13)
		*!*						cMess = cMess + HTML_SOitem(cSOitem,.F.)+CHR(13)
		*!*					ENDIF
		*!*					cMess = cMess + "     (Q_QTY) "+STR(PrepareSQLnum(SalesQuote.Q_QTY,'Q_QTY',-3),18,4)+" is the Quoted Units."+CHR(13)
		*!*					cMess = cMess + "(Quoted_QTY) "+STR(PrepareSQLnum(SalesQuote.Quoted_QTY,'Q_QTY',-3),18,4)+" is the Sales Units (Quoted_QTY)."+CHR(13)	
		*!*				ENDIF
		*!*				
		*!*				PRIVATE nQuoted_Total
		*!*				nQuoted_Total = PrepareSQLnum(SalesQuote.Quoted_Total,'Quoted_Total',-5)
		*!*				IF nQuoted_Total*1.05 < PrepareSQLnum(SalesQuote.Q_Total,'Q_Total',10,2) ;
		*!*					AND nQuoted_Total > 1.05*PrepareSQLnum(SalesQuote.Q_Total,'Q_Total',10,2)
		*!*					*Quoted Q_Total is different
		*!*					
		*!*					*IF nQuoted_Total > 0 AND PrepareSQLnum(SalesQuote.Q_Total,'Q_Total',10,2) > 0
		*!*					IF LEN(cMess)= 0
		*!*						cMess = cMess + "SOitem '"+cSOitem+"' is written differently than Quoted. (Total)"+CHR(13)+CHR(13)
		*!*						cMess = cMess + HTML_SOitem(cSOitem,.F.)+CHR(13)
		*!*					ENDIF
		*!*					cMess = cMess + " Quoted_Total > (Q_Total) and more than 5% off"+CHR(13)
		*!*					cMess = cMess + "     (Q_Total) "+STR(PrepareSQLnum(SalesQuote.Q_Total,'Q_Total',10,2),18,2)+" is the Quoted Total."+CHR(13)
		*!*					*cMess = cMess + STR(nQuoted_Total ,18,2)+" is the Quoted Total."+CHR(13)
		*!*					*cMess = cMess + " (Q_Total) "+STR(PrepareSQLnum(SalesQuote.Q_Total,'Q_Total',10,2),18,2)+" is the Sold Total."+CHR(13)
		*!*					cMess = cMess + "(Quoted_Total) "+STR(PrepareSQLnum(SalesQuote.Quoted_Total,'Q_Total',10,2),18,2)+" is the Sold Total."+CHR(13)
		*!*					cMess = cMess + "    (ItemSale) "+STR(PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',-5),18,2)+" is the ItemSale."+CHR(13)
		*!*					*cMess = cMess + "(ItemSale) "+STR(PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',-5),18,2)+" is the ItemSale."+CHR(13)
		*!*					
		*!*				ELSE
		*!*					*Q_Total = Quoted_Total
		*!*					IF PrepareSQLnum(SalesQuote.Q_Total,'Q_Total',-3)*1.05 < PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',-3) AND ;
		*!*						 PrepareSQLnum(SalesQuote.Q_Total,'Q_Total',-3) > 1.05*PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',-3)
		*!*						*Quoted ItemSale is different
		*!*						IF LEN(cMess)= 0
		*!*							cMess = cMess + "SOitem '"+cSOitem+"' is written differently than Quoted. (ItemSale)"+CHR(13)+CHR(13)
		*!*							cMess = cMess + HTML_SOitem(cSOitem,.F.)+CHR(13)
		*!*						ENDIF
		*!*						cMess = cMess + "Is more than 5% off"+CHR(13)
		*!*						cMess = cMess + "     (Q_Total) "+STR(PrepareSQLnum(SalesQuote.Q_Total,'Q_Total',10,2),18,2)+" is the Quoted Total."+CHR(13)
		*!*						cMess = cMess + "(Quoted_Total) "+STR(PrepareSQLnum(SalesQuote.Quoted_Total,'Q_Total',10,2),18,2)+" is the Sold Total."+CHR(13)
		*!*						cMess = cMess + "    (ItemSale) "+STR(PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',-5),18,2)+" is the ItemSale."+CHR(13)
		*!*					ENDIF
		*!*				ENDIF
		*!*				
					
				*ENDIF
				IF LEN(cMess) > 0
					PRIVATE nMess
					nMess = MESSAGEBOX(cMess+CHR(13)+CHR(13)+"Pricing Error, needs to be fixed!"+CHR(13)+CHR(13)+"Do you want to cancel Print Now? (Y)",4+48,"Warning")
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess+CHR(13)+"Price Error, will need to be fixed!"+CHR(13)+HTML_SO(ThisFormSet.SalesNum,.T.))
					TrackError(cMess,"Found Pricing Issue in SOitem '"+cSOitem+"'", PROGRAM(), LINENO(1))
					
					IF nMess = 6
						lReturn = .F.
						EXIT
					ENDIF
				ENDIF
				
			ENDSCAN
		ENDIF
		
		
		
		*******
		*!* ShowPaymentTypeText()
		*!*	DO CASE 
		*!*	CASE pPayType = '1'
		*!*		cPayType = "STD TERMS"
		*!*	CASE pPayType = '2'
		*!*		cPayType = "COD"
		*!*	CASE pPayType = '3'
		*!*		cPayType = "PREPAID"
		*!*	CASE pPayType = '4'
		*!*		cPayType = "CANADA STD"
		*!*	CASE pPayType = '5'
		*!*		cPayType = "CANADA COD"
		*!*	CASE pPayType = '6'
		*!*		cPayType = "CANADA PP"
		*!*	CASE pPayType = '7'
		*!*		cPayType = "FOREIGNSTD"
		*!*	CASE pPayType = '8'
		*!*		cPayType = "FOREIGNCOD"
		*!*	CASE pPayType = '9'
		*!*		cPayType = "FOREIGN PP"
		*!*	ENDCASE	
		
		*PayType terms.
		PRIVATE lcSO_PayType, lcCustID, lcAcct_nPayType
		lcSO_PayType = UPPER(PrepareSQLtxt(Sales_No.PayType,'PayType',10))
		IF LEN(ALLTRIM(lcSO_PayType)) = 0
			*has not been saved yet.
			lcSO_PayType = UPPER(ALLTRIM(ShowSQLtxt(ThisFormSet.frmEO.pf1.pgShipto.cmbPayment.Value,'PayType',10)))
		ENDIF
		lcCustID = ShowSQLtxt(SalesQuote.CustId,'CustID',20)
		IF LEN(lcCustID) = 0
			lcCustID = ShowSQLtxt( ThisFormset.frmEO.pf1.pgShipto.lblCustID.Caption,'CustID',20)
		ENDIF
		IF LEN(lcCustID) = 0
			*CustID was not in Quote.
			IF lcSO_PayType = "STD TERMS"
				MESSAGEBOX("This SO has been listed as 'STD TERMS', but there is no Customer ID."+CHR(13)+"Select a Customer ID in [BillTo] "+CHR(13)+"before you select Payment Type in [Ship To]",48,"Cannot Save SO!")
				lPassCheck = .F.
			ENDIF
		ELSE
			IF lcSO_PayType = "STD TERMS" OR lcSO_PayType = "CANADA STD" OR lcSO_PayType = "FOREIGNSTD"
				lcAcct_nPayType = GetPayTypeNum( lcCustID, SalesQuote.Company, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle )
		
				IF NOT ( lcAcct_nPayType = "1" OR lcAcct_nPayType = "4" OR lcAcct_nPayType  = "7" )
					*show error -Accounting is not STD and SO is STD
					lPassCheck = .F.	
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The Accounting Customer ID chosen for this SO is not allowed to have 'STD TERMS'"+CHR(13)+"lcSO_PayType = 'STD TERMS' and lcAcct_nPayType  = '"+lcAcct_nPayType  +"'  lcCustID='"+ALLTRIM(lcCustID)+"'"+CHR(13)+HTML_SO(ThisFormSet.SalesNum,.T.))			
					*Send Alert Email
					
					MESSAGEBOX("The Accounting Customer ID chosen for this SO is not allowed to have 'STD TERMS'"+CHR(13)+ALLTRIM(lcCustID)+" has Pay Terms of '"+lcAcct_nPayType +"'" ,48,"Cannot Save SO!")
					
					PRIVATE lOnHoldAR, cFirstSOitem
					cFirstSOitem = Proper_SO_Item(STR(ThisFormSet.SalesNum,7)+"-01")
					lOnHoldAR = Is_SOitem_OnHold( cFirstSOitem , "AR", ThisFormSet.nConnhandle)
					IF lOnHoldAR 
						MESSAGEBOX("This SO is on AR Hold.",48,"Continue with Save")
						lPassCheck = .T.	
					ELSE
						nMess = MESSAGEBOX("Do you want to mark this SO as on AR Hold?"+CHR(13)+CHR(13)+"If you are the Sales Person,"+CHR(13)+" answer NO and select PayType as '"+lcAcct_nPayType +"'"+CHR(13)+CHR(13)+"If you are the shop printing this SO,"+CHR(13)+" answer YES and have the SalesRep fix the PayType!"+CHR(13)+"Accounts Receiving will be alerted to this SO if Y"+CHR(13)+"If this is a new customer and STD TERMS are being tested,"+CHR(13)+"Mark (Y) as on hold so Customer knows knows order is being held up while Terms are determined.",4+32+256,"Mark SO with 'On Hold' for 'Accounts Receivable'")
						IF nMess = 6
							*Yes, mark OnHold
							lOK = Save_SOitem_Hold_Status( cFirstSOitem, ThisFormSet.SalesNum, "AR", .T., "AR On Hold", "HPA App placed Order On Hold for payment.  CustID="+ALLTRIM(lcCustID)+", SO Pay="+lcAcct_nPayType +", ACCT Pay="+ALLTRIM(ShowPaymentTypeText(lcAcct_nPayType)), ThisFormSet.nConnhandle )
							*lOK = Save_SOitem_Hold_Status( cFirstSOitem, ThisFormSet.SalesNum, "AR", .T., "AR On Hold", "AR placed Order On Hold for payment", ThisFormSet.nConnhandle,lcCustID,lcAcct_nPayType  )
							lPassCheck = .T.
						ENDIF
					ENDIF
																																		 
				ENDIF
			ENDIF
		ENDIF
		
		
		*********************************
		*Check Data Finished
		SELECT SalesQuote
		IF nRecNum > 0 AND nRecNum <= RECCOUNT('SalesQuote')
			GOTO (nRecNum)
		ENDIF
		
		IF NOT lReturn
			MESSAGEBOX("Print job has been stopped.",16,"Error")
		ENDIF
		
		
		RETURN lReturn 
			
	ENDPROC

	PROCEDURE checkdata4save
		*ThisFormSet.CheckData4Save()
		
		PRIVATE cTol,lCG,llShipOn,dShipDue,lDShip, lPODShip ,lServices, cTyp ,cSOitem 
		PRIVATE lInv, lBRK, lGFM, lDraw, lRoll,  lPress, lMach, lCG, lPlasma, lWJet, lExport
		PRIVATE lPassCheck, nMess, cMess, lCncld 
		lPassCheck = .T.
		nMess	= 0
		cMess	= ''
		PRIVATE nWO, nWO_Detail
		nWO = 0
		nWO_Detail = 0
		
		PRIVATE nItemCost, nItemSale
		PRIVATE	lST_FoundCost, nST_ItemSale, nST_ItemCost, nST_StkCost, nST_StkPaid, nST_POCost
		lST_FoundCost	= .F.
		nST_ItemSale	= 0
		nST_ItemCost	= 0
		nST_StkCost		= 0
		nST_StkPaid		= 0
		nST_POCost		= 0
		
		
		IF USED('SalesQuote')
			SELECT SalesQuote
			GO TOP
		ELSE
			MESSAGEBOX("Lost Table 'SalesQuote'!"+CHR(13)+"Data will reload."+CHR(13)+"Recheck data as some edits were lost!",0+16,"Error")
			ThisFormSet.Refresh_SalesQuote(.F.)
			TrackError( "Lost Table 'SalesQuote'!","CheckData4Save",PROGRAM(),LINENO(1))
			
			IF NOT USED('SalesQuote')
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE nRecNum, nItem, nItem_A
		nRecNum = RECNO('SalesQuote')
		nItem = PrepareSQLnum(ThisFormSet.frmEO.pf1.pgOrder.txtItem.Value,'Item',2,0)
		nItem_A = PrepareSQLnum( SalesQuote.Item_A,'Item',2,0)
		
		IF nRecNum < 1
			IF nItem_A <> nItem
				MESSAGEBOX("RECNO('SalesQuote') has been lost."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"Check Data for Save.",0,"Lost RecNo")
				TrackError("Lost RecNo","RECNO('SalesQuote') is 0."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"Begining of Check Data for Save.",PROGRAM(),LINENO(1))
				LOCATE FOR Item_A = nItem
				nRecNum = RECNO('SalesQuote')
			ENDIF
		ENDIF
		
		************************
		*From Sales_No -Verify Terms
		
		PRIVATE lcPayType, lcCustID 
		lcPayType	= PrepareSQLtxt( Sales_No.PayType,'PayType',10)
		IF LEN(ALLTRIM(lcPayType))=0
			lcPayType = ' '
		ENDIF
		
		lcCustID 	= PrepareSQLtxt( Sales_No.CustID,'CustID',20)
		IF LEN(lcCustID) < 1
			*check for in AllQuoes
			lcCustID 	= PrepareSQLtxt( SalesQuote.CustID,'CustID',20)
		ENDIF
		
		IF lcPayType='STD TERMS' OR lcPayType='FOREIGNSTD'
			*must have a lcCustID 
			IF NOT Is_CustID_StndTerms (lcCustID, ThisFormSet.nConnhandle)
				MESSAGEBOX("CustomerID = '"+lcCustID+"' was not "+CHR(13)+"found to have available Standard Terms!"+CHR(13)+"This will not SAVE "+CHR(13)+"until you change the Terms!"+CHR(13)+"cannot use Standard Terms right now!",0+16,"Cannot Save")
				RETURN .F.
			ENDIF
		ENDIF
		
		
		
		************************
		PRIVATE lShip_Outside_USA
		lShip_Outside_USA = ShipSOForeign( ThisFormSet.SalesNum, ThisFormSet.nConnhandle )
		**Checks Country of Address used
		
		PRIVATE nHPAPO
		
		SELECT SalesQuote
		SCAN
			lCncld = PrepareSQLlogic(SalesQuote.Cncld,'Cancelled',.F.)
			IF lCncld
				LOOP
			ENDIF
			
			*cSOitem 	= PrepareSQLtxt(SalesQuote.SOItem_A,'SOitem',10)
			
			lCG	 = PrepareSQLlogic(SalesQuote.CG,'CG',.F.)
			cTol = ALLTRIM(PrepareSQLtxt(SalesQuote.Tol,'Tolerance',20))
			
			IF lCG AND LEN(cTol)=0
				MESSAGEBOX("Please enter a CG Tolerance on SO-Item:"+ALLTRIM(SalesQuote.SoItem_a)+"!"+CHR(13)+CHR(13)+"This SO will not save untill the CG has a Tolerance.",0+64,"Found CG job with no Tolerance.")
				lPassCheck = .F.
			ENDIF
			
			llShipOn = PrepareSQLlogic( SalesQuote.ShipOn,'ShipOn',.F.)
			*llShipOn = PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgQuote.chkShipOn.Value,'ShipOn',.F.)
			dShipDue = PrepareSQLdate(SalesQuote.ShipDue,'Ship Due',.T.)
			
			*IF VARTYPE(dShipDue)="X"		&&null
			IF dShipDue=PrepareSQLdate('','Ship Due',.T.)	&&EMPTY
				*try the Leadtime
				dShipDue = PrepareSQLdate(SalesQuote.LeadTime,'Ship Due',.T.)
				IF dShipDue > DATE()-10 AND dShipDue < DATE()+30
					ThisFormSet.frmEO.pf1.pgQuote.txtShipDue.Value = dShipDue 
					SELECT SalesQuote
					REPLACE ShipDue WITH dShipDue IN SalesQuote
				ENDIF
			ENDIF
			
			IF EMPTY(dShipDue)
				*did not find Lead time date
				dShipDue = DATE()+7
				MESSAGEBOX("SO Item:"+ALLTRIM(SalesQuote.SoItem_a)+CHR(13)+"Please use a Ship Due Date."+CHR(13)+"ShipDue '"+DTOC(dShipDue)+"'"+CHR(13)+CHR(13)+"This SO will not save!",0+48,"ShipDue is Empty")
				ThisFormSet.frmEO.pf1.pgQuote.txtShipdue.Value = DATE()+7
				SELECT SalesQuote
				REPLACE ShipDue WITH DATE()+7 IN SalesQuote
				lPassCheck = .F.
			ENDIF
			IF VARTYPE(dShipDue) != "D" AND VARTYPE(dShipDue) != "T"
				dShipDue = CTOD("  /  /    ")
			ENDIF
			IF dShipDue < DATE()-30
				IF dShipDue < DATE()-356
					dShipDue = DATE()+7
					MESSAGEBOX("SO Item:"+ALLTRIM(SalesQuote.SoItem_a)+CHR(13)+"Resetting ShipDue to next WEEK."+CHR(13)+"ShipDue '"+DTOC(dShipDue)+"'"+CHR(13)+CHR(13)+"This SO will not save!",0+16,"Please check your dates!")
					dShipDue = DATE()+7
					ThisFormSet.frmEO.pf1.pgQuote.txtShipdue.Value = dShipDue 
					SELECT SalesQuote
					REPLACE ShipDue WITH dShipDue IN SalesQuote
		
					lPassCheck = .F.
				ELSE
					MESSAGEBOX("SO Item:"+ALLTRIM(SalesQuote.SoItem_a)+CHR(13)+"Warning! The ShipDue date is already over 30 days Late."+CHR(13)+"ShipDue '"+DTOC(dShipDue)+"'",0,"Warning only.")
				ENDIF
			ELSE
				IF dShipDue > DATE()+365	&&1 yr
					IF dShipDue > DATE()+730	&&2 Years
						dShipDue = DATE()+7
						MESSAGEBOX("SO Item:"+ALLTRIM(SalesQuote.SoItem_a)+CHR(13)+"The ShipDue date over 2 years from now!"+CHR(13)+"Resetting ShipDue to next WEEK."+CHR(13)+CHR(13)+"This SO will not save!"+CHR(13)+"Due Date must be less than 2 years!",0+16,"Please check your dates!")
						ThisFormSet.frmEO.pf1.pgQuote.txtShipdue.Value = dShipDue 
						SELECT SalesQuote
						REPLACE ShipDue WITH dShipDue IN SalesQuote
		
						lPassCheck = .F.
					ELSE
						MESSAGEBOX("SO Item:"+ALLTRIM(SalesQuote.SoItem_a)+CHR(13)+"The ShipDue date over 1 year from now!"+CHR(13)+"Please check your Due Dates!",0,"Warning")
					ENDIF
				ENDIF
			ENDIF
		
			***
			lServices	= PrepareSQLlogic(SalesQuote.Services,'Services',.F.)
			lInv		= PrepareSQLlogic(SalesQuote.INV,'Inv',.F.)
			lBRK		= PrepareSQLlogic(SalesQuote.BRK,'BRK',.F.)
			cTyp 		= UPPER(PrepareSQLtxt(SalesQuote.Typ,'TYP',1))
			cSOitem 	= PrepareSQLtxt(SalesQuote.SOItem_A,'SOitem',10)
			***
			lGFM	= PrepareSQLlogic(SalesQuote.GFM,'GFM',.F.)
			lDraw	= PrepareSQLlogic(SalesQuote.Draw,'Draw',.F.)
			lRoll	= PrepareSQLlogic(SalesQuote.Roll,'Roll',.F.)
			lPress	= PrepareSQLlogic(SalesQuote.Press,'Press',.F.)
			lMach	= PrepareSQLlogic(SalesQuote.Mach,'Mach',.F.)
			lCG		= PrepareSQLlogic(SalesQuote.CG,'CG',.F.)
			lPlasma	= PrepareSQLlogic(SalesQuote.Plasma,'Plasma',.F.)
			lWJet	= PrepareSQLlogic(SalesQuote.WJet,'WJet',.F.)
			
			nWO 		= PrepareSQLnum(SalesQuote.WO,'WO',-3)
			nWO_Detail = PrepareSQLnum(SalesQuote.WO_Detail,'WO_Detail',-3)
			***
				
			
			lPODShip 	= SO_have_PO_DShip( cSOitem, ThisFormSet.nConnHandle )
			lDShip		= PrepareSQLlogic(SalesQuote.DShip,'DShip',.F.)
			IF lDShip
				*Check to see if there is a PO!
			ENDIF
			
			
			IF lDShip
				*User clicked to Direct Ship
				IF SalesQuote.HPAPO = 0 AND SalesQuote.HPAPO2 = 0
					MESSAGEBOX("Quote page has SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"being a 'Direct Ship from Vendor'"+CHR(13)+"But there is no PO to vendor!",32,"Add PO!")
				ENDIF
						
				IF lPODShip 
					*good
				ELSE
					MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"Did not find PO that would Drop Ship to Customer."+CHR(13)+"Add a 'Ship to Direct' Po first.",48,"Cannot change here.")
					lPassCheck = .F.
				ENDIF
			ELSE
				*User clicked Drop Ship 
				IF lPODShip 
					*the Drop ship still needs a SO
					*MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"There is still a PO being Drop Shipped!"+CHR(13)+"Please remove the PO first!",48,"Cannot change here.")
					*lPassCheck = .F.
				ELSE
					*good
				ENDIF
			ENDIF	
			***
		
			************************************************************************************		
			PRIVATE nID_Detail, lIs_Stock_Selected,lIs_Stock_Incoming
			nID_Detail = get_ID_Detail_with_SOitem(cSOitem, 'S', 'SELECTED', ThisFormSet.nConnhandle)
			
			IF nID_Detail > 0
				lIs_Stock_Selected = IIF( nID_Detail > 0, .T.,.F.)
				lIs_Stock_Incoming = Is_Detail_Process("S",nID_Detail,'INCOMING', ThisFormSet.nConnhandle)
			ELSE
				lIs_Stock_Selected = .F.
				lIs_Stock_Incoming = .F.
			ENDIF
			
		*!*		IF cTYP != 'P'	
		*!*			*True if Selected Stock was found -found an ID_Detail
		*!*			IF lInv	
		*				IS Stock INCOMING from WO_Detail?
		*!*				IF lIs_Stock_Selected
		*!*					*Good
		*!*				ELSE
		*!*					MESSAGEBOX("Marked as 'from Inventory'"+CHR(13)+"yet nothing has Selected in Inventory"+CHR(13)+"for SOitem:'"+cSOitem+"'"+CHR(13)+"This just is a reminder.",0+64,"Inventory flagged but not selected!")
		*!*					*RETURN .F.			
		*!*				ENDIF		
		*!*			ELSE
		*!*				IF lIs_Stock_Selected
		*!*					nMess = MESSAGEBOX("Not marked as 'from Inventory'"+CHR(13)+"yet has Selected Inventory"+CHR(13)+"for SOitem:'"+cSOitem+"'"+CHR(13)+"(Yes) Program will mark SOitem AS 'From Stock'."+CHR(13)+"Answer (No) to keep as 'Not a Stock Order'"+CHR(13)+"and remove the marked stock later.",4+64,"Inventory NOT flagged has stock selected! Mark now?")
		*!*					IF nMess = 6
		*!*						lInv = .T.
		*!*						REPLACE SalesQuote.Inv WITH .T.
		*!*					ENDIF
		*!*				ELSE
		*!*					*Good
		*!*				ENDIF			
		*!*			ENDIF
		*!*		ELSE
		*!*			*When TYP = 'P' WO will look for that stock when SO is imported to WO
		*!*		ENDIF
			
			***
			IF (lInv OR lBRK) AND lServices
				MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"You cannot have 'Inventory/Broker' and 'Service' selected at the same time!."+CHR(13)+"Choose one on the 'Order' tab."+CHR(13)+CHR(13)+"This SO will not save!",48,"Please choose only one!")
				lPassCheck = .F.
			ENDIF
			
			nHPAPO = PrepareSQLnum(SalesQuote.HPAPo,'HPAPO',-3)
			
		
			***************************************************************************************
			IF cTYP==''
				MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"is not marked for Type!"+CHR(13)+"Not allowed to continue!",0+64,"Enter Type of Order")
				lPassCheck = .F.
			ELSE
				IF NOT ( cTYP="I" OR cTYP="B" OR cTYP="M" OR cTYP="P" OR cTYP="S" OR cTYP="C")
					MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"is not marked for Type!"+CHR(13)+"Not allowed to continue!",0+64,"Enter Type of Order")
					lPassCheck = .F.
				ENDIF
			ENDIF
				
			IF lPassCheck 
			
				*Check to see if cTYP makes Sense.
				DO CASE
				CASE cTYP = "I"  &&Inv,I
			*		MESSAGEBOX("'Type' is listed as INV, but the INV check box is not selected."+CHR(13)+"SOitem:'"+cSOitem+"'"+CHR(13)+"No PO for Stock is found!",0+16,"Type INV does not make sense!")
					IF lInv	
						IF lIs_Stock_Selected
							*good
						ELSE
							MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"Stock has not been marked for this Type 'I'!"+CHR(13)+"Not allowed to continue without Stock"+CHR(13)+"Select Stock first",0+64,"Select Stock!")
							lPassCheck = .F.
						ENDIF
					ELSE
						IF lIs_Stock_Selected
							*just mark lInv
							lInv = .T.
							SELECT SalesQuote
							REPLACE SalesQuote.INV WITH lInv
						ELSE
							*good
						ENDIF
					ENDIF
				
					IF lServices
						SELECT SalesQuote
						REPLACE Services WITH .T. IN SalesQuote
					ENDIF
						
				CASE cTYP = "B"  &&Broker,B
					IF Count_HPAPOinPurchaseOrder(nHPAPO, ThisFormSet.nConnhandle, '') > 0
						*good, Found a Broker PO?
						IF lIs_Stock_Selected 
							IF lIs_Stock_Incoming 
								*good
								*lIs_Stock_Incoming = Is_Detail_Process("S",nID_Detail,'INCOMING', ThisFormSet.nConnhandle)
							ELSE
								*bad 
		*						PRIVATE cMess
		*						cMess = "Have Brokered SalesOrder '"+cSOitem+"' without an incoming Purchase Order"
		*						TrackError(cMess,"Have Brokered SOi "+cSOitem+" that needs a Purchase ", PROGRAM(), LINENO(1))
								
							ENDIF
						ENDIF
					ELSE
						MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"The Broker PO has not been issued for this Type 'B'!"+CHR(13)+"",0,"Continue with Save")			
					ENDIF
					IF lInv
						SELECT SalesQuote
						REPLACE SalesQuote.INV WITH .F.
						lInv = .F.
					ENDIF						
				
					IF lServices
						SELECT SalesQuote
						REPLACE Services WITH .T. IN SalesQuote
					ENDIF
		
				CASE cTYP = "M"  &&Mill,M
					IF Count_HPAPOinPurchaseOrder(nHPAPO, ThisFormSet.nConnhandle, '') > 0
						*good, Test for Mill?
					ELSE
						*MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"The Broker PO has not been issued for this Type 'B'!"+CHR(13)+"",0,"Continue with Save")
					ENDIF
					IF lInv
						SELECT SalesQuote
						REPLACE SalesQuote.INV WITH .F.
						lInv = .F.
					ENDIF			
				
					IF lServices
						SELECT SalesQuote
						REPLACE Services WITH .T. IN SalesQuote
					ENDIF
		
				CASE cTYP = "P"  &&Production,P
					IF lInv
						IF lIs_Stock_Incoming 
							*Allow Stock to be Produced with a PO, connect that PO to a WOD 
							*the ID_Detail will have a INCOMING process from the PO/WOD and this SOitem can be "SELECETED'
						ELSE
							*NOT lIs_Stock_Incoming, Just means no stock has been maked as Incoming!
							IF lIs_Stock_Selected 
								IF nWO_Detail = 0
									MESSAGEBOX("SOitem:'"+ALLTRIM(cSOitem)+"' is marked as 'from Inventory'"+CHR(13)+"and is to be Produced"+CHR(13)+"with WO_Detail "+ALLTRIM(STR(nWO_Detail))+CHR(13)+CHR(13)+"Please let the WO choose stock!"+CHR(13)+"If some is stock and some is production"+CHR(13)+"use different SO items!"+CHR(13)+"If Production is marked, the shop will be alerted"+CHR(13)+CHR(13)+"You would not be getting this message if the stock is actually 'INCOMING'"+CHR(13)+"Cannot procede",0+64,"Inventory selected and Production")
									
									SELECT SalesQuote
									REPLACE SalesQuote.INV WITH .F.
									ThisFormSet.frmEO.pf1.pgOrder.chkInv.Value = 0
									ThisFormSet.frmEO.pf1.pgOrder.chkInv.Refresh
									
									RETURN .F.
								ENDIF
							ENDIF
						ENDIF
					ELSE
						IF lIs_Stock_Incoming 
							*OK
						ELSE
							IF lIs_Stock_Selected 
								*bad
								*Remove SELECT from Process!!
								
								SELECT SalesQuote
								REPLACE SalesQuote.INV WITH .F.
								lInv = .F.
							ENDIF
						ENDIF
					ENDIF
				
					IF lServices
						SELECT SalesQuote
						REPLACE Services WITH .T. IN SalesQuote
					ENDIF
					
				CASE cTYP = "S"  &&Service,S
					IF lServices
						*good
					ELSE
						lServices = .T.
						SELECT SalesQuote
						REPLACE Services WITH .T. IN SalesQuote
		
					ENDIF
		
					IF lInv
						*MESSAGEBOX("'Type' is listed as Conversion Service, but the 'Service' check box is not selected."+CHR(13)+"SOitem:'"+cSOitem+"'",0+16,"Type Conversion Needs Services Checked!")
						*RETURN .F.
						SELECT SalesQuote
						REPLACE SalesQuote.INV WITH .F.
						lInv = .F.
					ENDIF
					
					IF lIs_Stock_Incoming 
						*bad
						*Remove SELECT from Process!!
						*lIs_Stock_Selected = lIs_Stock_Incoming()
					ENDIF
					
					IF lIs_Stock_Selected 
						*bad
						*Remove SELECT from Process!!
						*lIs_Stock_Selected = Remove_Selected_Process()
					ENDIF	
					
				CASE cTYP = "C"  &&Conversion,C
					IF NOT lServices
						IF lInv
							MESSAGEBOX("'Type' is listed as Conversion Service, but the 'Service' check box is not selected."+CHR(13)+"SOitem:'"+cSOitem+"'"+CHR(13)+CHR(13)+"This SO will not save!",0+16,"Type Conversion Needs Services Checked!")
							RETURN .F.
						ENDIF
						lServices = .T.
						SELECT SalesQuote
						REPLACE Services WITH .T. IN SalesQuote
						
						IF lIs_Stock_Selected 
							*bad
							*Remove SELECT from Process!!
							
							SELECT SalesQuote
							REPLACE SalesQuote.INV WITH .F.
							lInv = .F.
						ENDIF
						***
						IF lInv
							*MESSAGEBOX("'Type' is listed as Conversion Service, but the 'Service' check box is not selected."+CHR(13)+"SOitem:'"+cSOitem+"'",0+16,"Type Conversion Needs Services Checked!")
							*RETURN .F.
							SELECT SalesQuote
							REPLACE SalesQuote.INV WITH .F.
							lInv = .F.
						ENDIF
					ENDIF
							
					IF lServices
						SELECT SalesQuote
						REPLACE Services WITH .T. IN SalesQuote
					ENDIF
					
					IF lIs_Stock_Incoming 
						*bad
						*Remove SELECT from Process!!
					ENDIF
					
					IF lIs_Stock_Selected 
						*bad
						*Remove SELECT from Process!!
					ENDIF	
					
				OTHERWISE
					*WAIT WINDOW "TYPE:"+cTYP NOWAIT
					*MESSAGEBOX("TYPE is not I,B,M,P,S,C for SOitem:"+cSOitem+CHR(13)+"Please mark the Type of Sale!",0+16,"Cannot continue!")
					TrackError("cTYP is not I,B,M,P,S,C for SOitem:"+cSOitem ,"cTyp='"+cTYP+"'" ,PROGRAM(),LINENO(1))
					
					MESSAGEBOX("On Order tab, TYPE is not I,B,M,P,S,C for SOitem:"+cSOitem+CHR(13)+"Please mark the Type of Sale!",0+16,"Reminder!")
					RETURN .F.
				ENDCASE
			ENDIF
			
			*********************************	
			*Check Export
		
			lExport	= PrepareSQLlogic(SalesQuote.Export,'Export',.F.)
			*lExport	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgOrder.chkExport.Value,'Export',.F.)
		
			PRIVATE lUSA, cSoldCountry, cShipCountry
			lUSA		= PrepareSQLlogic( Sales_No.USA,'USA',.T.)
			cSoldCountry = PADR(UPPER(get_SoldTo(ThisFormSet.SoldAddr,'COUNTRY',ThisFormSet.nConnHandle)) ,15," ")
			cShipCountry = PADR(UPPER(get_ShipTo(ThisFormSet.ShipAddr,'COUNTRY',ThisFormSet.nConnHandle)) ,15," ")
			
			IF lShip_outside_USA
				IF NOT lExport
					MESSAGEBOX("A non USA shipping address is being used."+CHR(13);
					 +"SoldCountry="+cSoldCountry+", ShipCountry="+cShipCountry+CHR(13);
					 +"Item: "+ALLTRIM(SalesQuote.SOItem_A)+CHR(13)+"Make sure you ask if any of this SO-item will be for export.";
					 +CHR(13)+"The USA DISC Export program has a lower tax rates for HPA."+CHR(13)+"Important Tax Discount!"+CHR(13);
					 +"This message will appear for each SO-item not marked as Export."+CHR(13)+"On bottom right of Order tab.";
					 ,0+32,"Could be for Export!")
				ENDIF
			ENDIF
			
			*lUSA	= PrepareSQLlogic(ThisformSet.frmEO.pf1.pgSHIPTO.chkUSA.Value,'USA',.T.)
			*cSoldCountry	= PrepareSQLtxt(ThisformSet.frmEO.pf1.pgBillTo.txtCountry.Value,'Country',50)
			*cShipCountry	= PrepareSQLtxt(ThisformSet.frmEO.pf1.pgShipTo.txtCountry.Value,'Country',50)
			
			IF ThisFormSet.ShipAddr > 0
				IF lExport AND lUSA
					MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"SOitem is listed for 'Export'"+CHR(13)+"and the Sales Order is listed as for 'USA'"+CHR(13)+"The USA checkmark by ECPC on 'Ship To' tab."+CHR(13)+CHR(13)+"Save was a success,"+CHR(13)+"but this does not seam right.",32,"Confusing Export data.")
				ENDIF
				IF NOT lExport AND NOT lUSA
					MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"SOitem is listed as NOT for 'Export'"+CHR(13)+"and the Sales Order is listed as NOT for 'USA'"+CHR(13)+"The USA checkmark by ECPC on 'Ship To' tab."+CHR(13)+CHR(13)+"The save was a success,"+CHR(13)+"but this does not seam right.",32,"Confusing Export data.")
				ENDIF
				
				IF NOT LEN(ALLTRIM(cShipCountry))=0
					IF UPPER(cShipCountry) != "US" AND UPPER(cShipCountry) != "USA" 
						IF NOT lExport
							MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"SOitem is listed as NOT for 'Export'"+CHR(13)+"and Ship Country is not 'USA'"+CHR(13)+CHR(13)+"Save was a success"+CHR(13)+", but this does not seam right.",32,"Confusing Export data.")
						ENDIF
						IF lUSA
							MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"The Sale is listed as for 'USA'"+CHR(13)+"and Ship Country is not 'USA'"+CHR(13)+CHR(13)+"Save was a success"+CHR(13)+", but this does not seam right.",32,"Confusing Export data.")
						ENDIF
					ELSE
						*update Sales_No.USA if null
						IF ISNULL(Sales_No.USA)
							REPLACE USA WITH .T. IN Sales_No
							ThisFormset.frmEO.pf1.pgShipto.chkUSA.Value = 1
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			*********************************	
			*Check DPAS
			PRIVATE lDPAS, lFoundDPAS, cComments 
			*lDPAS		= PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgShipto.chkDPAS.VALUE,'DPAS',.F.)
			lDPAS		= PrepareSQLlogic( Sales_No.DPAS,'DPAS',.F.)
			
			cComments = ALLTRIM(PrepareSQLtxt(SalesQuote.Comments,'Comments',-1))
			IF NOT LEN(cComments)=0
				lFoundDPAS	= HasDPAScomment( cComments )  &&Proc_Quotes
				
				DO CASE
				CASE lDPAS AND lFoundDPAS
					*Good
				CASE lDPAS AND NOT lFoundDPAS
					ThisFormSet.frmEO.pf1.ACTIVEPAGE = 2
					ThisFormSet.frmEO.pf1.PgQuote.txtQComments.Refresh
					ThisFormSet.frmEO.pf1.PgQuote.txtQComments.SetFocus
					MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"While checking data:"+CHR(13)+"Sales Order is Marked as a Government DPAS rated."+CHR(13)+"No Quote Comment was found about the rating."+CHR(13)+"Example 'DO-' or 'DX-' or evan 'NOT DO-'"+CHR(13)+"DO is too common, program looks for the dash like DO- or DX-"+CHR(13)+"This SO data is bad and will not be allowed save!"+CHR(13)+CHR(13)+"The Comments field is on the 'Quote' tab."+CHR(13)+"Listed Comments:"+cComments ,16,"The rating for DPAS is missing.")
					RETURN .F.
				CASE NOT lDPAS AND lFoundDPAS	
					ThisFormSet.frmEO.pf1.ACTIVEPAGE = 5
					ThisFormSet.frmEO.pf1.PgShipto.chkDPAS.Refresh
					ThisFormSet.frmEO.pf1.PgShipto.chkDPAS.SetFocus
					MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"While checking data:"+CHR(13)+"SO Comment was found to have a DPAS rating."+CHR(13)+"But the Ship To tab does not have the DPAS checked!."+CHR(13)+"Remove Comments like DPAS, 'DO-' or 'DX-' if this is not DPAS."+CHR(13)+CHR(13)+ALLTRIM(SalesQuote.Comments)+CHR(13)+CHR(13)+"This SO will not save!",16,"DPAS rating found.")
					RETURN .F.
				CASE NOT lDPAS AND NOT lFoundDPAS
					*Good
				ENDCASE
			ELSE
				IF lDPAS  
					ThisFormSet.frmEO.pf1.ACTIVEPAGE = 2
					ThisFormSet.frmEO.pf1.PgQuote.txtQComments.Refresh
					ThisFormSet.frmEO.pf1.PgQuote.txtQComments.SetFocus
					MESSAGEBOX("SOitem:"+ALLTRIM(cSOitem)+CHR(13)+"While checking data:"+CHR(13)+"Sales Order is Marked as a Government DPAS rated."+CHR(13)+"But no rating was found in the Quotes Comment!"+CHR(13)+"Example DO- or DX- 'the dash is needed'"+CHR(13)+CHR(13)+"This SO data is bad and will not be allowed save!"+CHR(13)+CHR(13)+"The Comments field is on the 'Quote' tab."+CHR(13)+"Add the DO- or DX- DPAS rating in Quotes Comment!",16,"DPAS rating missing.")
					RETURN .F.
				ENDIF
			ENDIF
			
			*********************************	
			*Check FCI
			PRIVATE lFCI
			lFCI	= PrepareSQLlogic( Sales_No.FCI,'FCI',.F.)
		
		
			*********************************	
			*Check GOV
			PRIVATE lGOV
			lGOV	= PrepareSQLlogic( Sales_No.GOV,'GOV',.F.)
			
			**
			IF lDPAS OR lFCI
				*Must Be US Government
				IF NOT lGOV
					lGOV = .T.
					REPLACE GOV WITH lGOV IN Sales_No
					ThisFormset.frmEO.pf1.pgShipto.chkGOV.Refresh
				ENDIF
			ENDIF
			
			
			**********************************
			*check pricing
			
			PRIVATE	lST_FoundCost, nST_ItemSale, nST_ItemCost, nST_StkCost, nST_StkPaid, nST_POCost
						
		*	nItemSale = PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',9,2)
		*	nItemCost = PrepareSQLnum(SalesQuote.ItemCost,'Item Cost',9,2)
		*SalesTotal (ItemSale Y, ItemCost Y, ItemSkCost Y, ItemSKPaid Y, ItemPOCost Y, Item INT, Cncld l, SOitem CHAR(10))
			IF USED('SalesTotal')
				SELECT SalesTotal
				LOCATE FOR Item = SalesQuote.Item
				IF FOUND('SalesTotal')
					lST_FoundCost	= .T.
					nST_ItemSale	= PrepareSQLnum(SalesTotal.ItemSale,'ItemSale',10,2)
					nST_ItemCost	= PrepareSQLnum(SalesTotal.ItemCost,'ItemCost',10,2)
					nST_StkCost		= PrepareSQLnum(SalesTotal.ItemSkCost,'ItemSkCost',10,2)
					nST_StkPaid		= PrepareSQLnum(SalesTotal.ItemSKPaid,'ItemSKPaid',10,2)
					nST_POCost		= PrepareSQLnum(SalesTotal.ItemPOCost,'ItemPOCost',10,2)
					
					IF nST_ItemSale = 0
						nST_ItemSale = PrepareSQLnum(SalesQuote.Q_P,'Q_P',-5) * PrepareSQLnum(SalesQuote.Q_QTY,'Q_QTY',-5)
						nST_ItemSale = PrepareSQLnum(nST_ItemSale,'ItemSale',10,2)
					ENDIF
					IF nST_ItemSale = 0
						*nST_ItemSale = ThisFormSet.CalcLotp()
						nST_ItemSale = getSale_SOitem( SalesQuote.SOItem_A, ThisFormSet.nConnHandle )
					ENDIF
		
					IF nST_ItemCost = 0
						nST_ItemCost = PrepareSQLnum( nST_StkCost + nST_POCost ,'ItemCost',10,2)
					ENDIF
					*nItemSale
					*nItemCost
				ELSE
					lST_FoundCost	= .F.
				ENDIF
					
				SELECT SalesQuote
				IF lST_FoundCost
					REPLACE ItemSale WITH nST_ItemSale IN SalesQuote
					REPLACE ItemCost WITH nST_ItemCost IN SalesQuote
				ENDIF
				
			ENDIF
			
			*** end checking
			SELECT SalesQuote
		ENDSCAN
		
		
		*********************************
		*Recenter SalesQuote on correct item
		SELECT SalesQuote
		
		IF nRecNum > 0 AND nRecNum <= RECCOUNT('SalesQuote')
			GOTO (nRecNum)
		ELSE
			IF nItem_A <> nItem
				MESSAGEBOX("RECNO('SalesQuote') has been lost."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"End: Check Data for Save.",0,"Lost RecNo")
				TrackError("Lost RecNo","RECNO('SalesQuote') is 0."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"End of Check Data for Save.",PROGRAM(),LINENO(1))
				LOCATE FOR Item_A = nItem
				*nRecNum = RECNO('SalesQuote')
			ELSE
				MESSAGEBOX("RECNO('SalesQuote') has been lost."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"Data check FAILED."+CHR(13)+"This will not be allowed to be saved."+CHR(13)+"End: Check Data for Save.",0,"Lost RecNo")
				TrackError("Lost RecNo","RECNO('SalesQuote') is 0."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"End of Check Data for Save.",PROGRAM(),LINENO(1))
				
				GO TOP
				lPassCheck = .F.
			ENDIF
		ENDIF
		
		******************************************************************
		PRIVATE llEmailConf, cBillToEmail
		
		llEmailConf	= PrepareSQLlogic( Sales_No.EmailConf,'EmailConf',.F.)
		IF llEmailConf 
			IF LEN(ALLTRIM(PrepareSQLtxt(SalesQuote.Email,'Email',60))) > 0
				*Can send Email!
			ELSE
				** SoldAddr is not a good place for Email
		
				cBillToEmail = PrepareSQLtxt( get_SoldTo(ThisFormSet.SoldAddr,'Email',ThisFormSet.nConnHandle) ,'Email',60)
				IF llEmailConf AND LEN(ALLTRIM(cBilltoEmail))>0
					IF ThisFormSet.SoldAddr > 0
					
						*Check ThisFormSet.SoldAddr for Email Address
						IF NOT Check_Addr_byCode( ThisFormSet.SoldAddr, "SOLD", "EMAIL", ThisFormSet.nConnhandle )
							MESSAGEBOX("Send Shipping notice by Email is marked, but"+CHR(13)+"there is no Email address!"+CHR(13)+"SoldAddr is "+ALLTRIM(STR(ThisFormSet.SoldAddr))+".",64,"Warning")
						ENDIF
					ELSE
						MESSAGEBOX("Send Shipping notice by Email is marked, but"+CHR(13)+"there is no Email address!"+CHR(13)+"SoldAddr is 0",64,"Warning")
					ENDIF
				ENDIF  
			ENDIF
		ENDIF
		
		******************************************************************
		*check the Sales_No level --no scan
		*!* ShowPaymentTypeText()
		*!*	DO CASE
		*!*	CASE pPayType = '1'
		*!*		cPayType = "STD TERMS"
		*!*	CASE pPayType = '2'
		*!*		cPayType = "COD"
		*!*	CASE pPayType = '3'
		*!*		cPayType = "PREPAID"
		*!*	CASE pPayType = '4'
		*!*		cPayType = "CANADA STD"
		*!*	CASE pPayType = '5'
		*!*		cPayType = "CANADA COD"
		*!*	CASE pPayType = '6'
		*!*		cPayType = "CANADA PP"
		*!*	CASE pPayType = '7'
		*!*		cPayType = "FOREIGNSTD"
		*!*	CASE pPayType = '8'
		*!*		cPayType = "FOREIGNCOD"
		*!*	CASE pPayType = '9'
		*!*		cPayType = "FOREIGN PP"
		*!*	ENDCASE	
		
		*PayType terms.
		PRIVATE lcSO_PayType, lcCustID, lcAcct_nPayType 
		lcSO_PayType = UPPER(PrepareSQLtxt(Sales_No.PayType,'PayType',10))
		IF LEN(ALLTRIM(lcSO_PayType)) = 0
			*has not been saved yet.
			lcSO_PayType = UPPER(ALLTRIM(ShowSQLtxt(ThisFormSet.frmEO.pf1.pgShipto.cmbPayment.Value,'PayType',10)))
		ENDIF
		
		lcCustID = ShowSQLtxt(SalesQuote.CustId,'CustID',20)
		IF LEN(lcCustID) = 0
			lcCustID = ShowSQLtxt( ThisFormset.frmEO.pf1.pgShipto.lblCustID.Caption,'CustID',20)
		ENDIF
		IF LEN(lcCustID) = 0
			*CustID was not in Quote.
			IF lcSO_PayType = "STD TERMS"
				MESSAGEBOX("This SO has been listed as 'STD TERMS', but there is no Customer ID."+CHR(13)+"Select a Customer ID in [BillTo] "+CHR(13)+"before you select Payment Type in [Ship To]",48,"Cannot Save SO!")
				lPassCheck = .F.
			ENDIF
		ELSE
			IF lcSO_PayType = "STD TERMS" OR lcSO_PayType = "CANADA STD" OR lcSO_PayType = "FOREIGNSTD"
				lcAcct_nPayType  =  GetPayTypeNum( lcCustID, SalesQuote.Company, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle )
				*IF lcAcct_nPayType  <> "STD TERMS"
				IF NOT ( lcAcct_nPayType  = "1" OR lcAcct_nPayType  = "4" OR lcAcct_nPayType  = "7" )
					*show error
					lPassCheck = .F.	
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The Accounting Customer ID chosen for this SO is not allowed to have 'STD TERMS'"+CHR(13)+"lcSO_PayType = 'STD TERMS' and lcAcct_nPayType  = '"+lcAcct_nPayType  +"'  lcCustID='"+ALLTRIM(lcCustID)+"'"+CHR(13)+HTML_SO(ThisFormSet.SalesNum,.T.))			
					MESSAGEBOX("The Accounting Customer ID chosen for this SO is not allowed to have 'STD TERMS'"+CHR(13)+ALLTRIM(lcCustID)+" has Pay Terms of '"+lcAcct_nPayType +"'" ,48,"Cannot Save SO!")
					
																																		 
				ENDIF
			ENDIF
		ENDIF
		
		*!*	PRIVATE cPaymentTypeNumber
		*!*	cPaymentTypeNumber = GetPayTypeNum( SalesQuote.CustID, SalesQuote.Company, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle )
		*!*	IF cPaymentTypeNumber $ "OverLimit"
		*!*		MESSAGEBOX("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!",64,"Warning, already over credit Limit!")
		*!*		Trackmess("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!, before adding SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" "+PROGRAM())
		*!*		cPaymentTypeNumber = LEFT(cPaymentTypeNumber,1)
		*!*	ENDIF
		
		
		
		
		
		PRIVATE llFaxConf, cBillToFax, cSoldToFax
		llFaxConf	= PrepareSQLlogic( Sales_No.FaxConf,'FaxConf',.F.)
		IF llFaxConf 
			IF LEN(ALLTRIM(PrepareSQLtxt(SalesQuote.Fax,'Fax',10)))>0
				*Can send Fax!
			ELSE
				** SoldAddr is not a good place for Fax
				cBillToFax	= PrepareSQLtxt( get_SoldTo(ThisFormSet.SoldAddr,'Fax',ThisFormSet.nConnHandle),'Fax',12)
				cSoldToFax	= PrepareSQLtxt( get_ShipTo(ThisFormSet.ShipAddr,'Fax',ThisFormSet.nConnHandle),'Fax',12)
		
				IF LEN(ALLTRIM( cBillToFax ))>0 AND LEN(ALLTRIM( cSoldToFax ))>0
					IF ThisFormSet.SoldAddr > 0
						IF NOT Check_Addr_byCode( ThisFormSet.SoldAddr, "SOLD", "FAX", ThisFormSet.nConnhandle )
						
							IF ThisFormSet.ShipAddr > 0
								IF NOT Check_Addr_byCode( ThisFormSet.ShipAddr, "SHIP", "FAX", ThisFormSet.nConnhandle )
									MESSAGEBOX("Send Shipping notice by Fax is marked, but"+CHR(13)+"there is no Fax Number!",64,"Warning")
								ENDIF	
							ELSE
								MESSAGEBOX("Send Shipping notice by Fax is marked, but"+CHR(13)+"there is no Fax Number!",64,"Warning")
							ENDIF
							
						ENDIF
					ELSE
						IF ThisFormSet.ShipAddr > 0
							IF NOT Check_Addr_byCode( ThisFormSet.ShipAddr, "SHIP", "FAX", ThisFormSet.nConnhandle )
								MESSAGEBOX("Send Shipping notice by Fax is marked, but"+CHR(13)+"there is no Fax Number!",64,"Warning")
							ENDIF	
						ELSE
							MESSAGEBOX("Send Shipping notice by Fax is marked, but"+CHR(13)+"there is no Fax Number!",64,"Warning")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*********************************
		*Check Internal Production
		PRIVATE lIntP, nSoldCode
		lIntP	= PrepareSQLlogic( SalesQuote.IntP,'IntP',.F.)
		*lIntP	= PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkIntP.VALUE,'IntP',.F.)
		nSoldCode = PrepareSQLnum(ThisFormSet.SoldAddr,'SoldCode',-3)
		*nSoldCode = PrepareSQLnum(ThisformSet.frmEO.pf1.pgBillTo.txtSoldCode.Value,'SoldCode',-3)
		
		IF nSoldCode = 1 OR nSoldCode = 2
			IF NOT lIntP
				MESSAGEBOX("Sold to HPA!"+CHR(13)+"Make sure you mark as Internal Production on Bill To tab.",48,"Looks like this should be marked as an Internal Production.")
			ENDIF
		ENDIF
		
		
		*********************************
		IF lPassCheck
			lPassCheck = ThisFormSet.CheckPOs_SalesQuote()
			IF NOT lPassCheck
				MESSAGEBOX("Error",16,"Save will cancel.")
			ENDIF
		ENDIF
		
		*********************************
		IF lPassCheck
			*list of dbo.sales that need to be the same across items
			PRIVATE lQA,lCofC,lMerc,lpPO,lpPN,lpHeat,lpSpec,lpDesc,lpOther,cOther,lpIntP
		
			lQA		= PrepareSQLlogic( SalesQuote.QA,'QA', .F. ) 
			lCofC	= PrepareSQLlogic( SalesQuote.CofC,'CofC', .F. ) 
			lMerc	= PrepareSQLlogic( SalesQuote.Merc,'Merc', .F. ) 
			lpPO	= PrepareSQLlogic( SalesQuote.pPO,'pPO', .F. ) 
			lpPN	= PrepareSQLlogic( SalesQuote.pPN,'pPN', .F. ) 
			lpHeat	= PrepareSQLlogic( SalesQuote.pHeat,'pHeat', .F. ) 
			lpSpec	= PrepareSQLlogic( SalesQuote.pSpec,'pSpec',.F.) 
			lpDesc	= PrepareSQLlogic( SalesQuote.pDesc,'pDesc',.F.) 
			lpOther	= PrepareSQLlogic( SalesQuote.pOther,'pOther',.F.)
			cOther	= PrepareSQLtxt(SalesQuote.Other,'Other',30)
			lpIntP	= PrepareSQLlogic( SalesQuote.IntP,'IntP',.F.)
		
			IF lpOther
				IF LEN(ALLTRIM(cOther))=0
					MESSAGEBOX("On tab 'Bill To', The 'Other' field was not filled."+CHR(13)+"But 'Other' was Selected to be printed on material.",0,"Please fix error.")
				ENDIF
			ENDIF
		
			******
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkQA.VALUE,'QA', .F. ) 
				IF NOT lQA
					WAIT WINDOW "Updating all SO items with QA as True" TIMEOUT 1
				ENDIF
			ENDIF
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkCofC.VALUE,'CofC', .F. ) 
				IF NOT lCofC
					WAIT WINDOW "Updating all SO items with C of C as True" TIMEOUT 1
				ENDIF
			ENDIF
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkMercury.VALUE,'Merc', .F. ) 
				IF NOT lMerc
					WAIT WINDOW "Updating all SO items with Mercury Free Statement as True" TIMEOUT 1
				ENDIF
			ENDIF
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkIntP.VALUE,'IntP',.F.)
				IF NOT lpIntP
					WAIT WINDOW "Updating all SO items with Internal Production as True" TIMEOUT 1
				ENDIF
			ENDIF
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkpPO.VALUE,'pPO', .F. ) 
				IF NOT lpPO
					WAIT WINDOW "Updating all SO items with Print PO on material as True" TIMEOUT 1
				ENDIF
			ENDIF
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkpPN.VALUE,'pPN', .F. ) 
				IF NOT lpPN
					WAIT WINDOW "Updating all SO items with Print PartNumber on material as True" TIMEOUT 1
				ENDIF
			ENDIF
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkpHeat.VALUE,'pHeat', .F. ) 
				IF NOT lpHeat
					WAIT WINDOW "Updating all SO items with Print Heat on material as True" TIMEOUT 1
				ENDIF
			ENDIF
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkpSpec.VALUE,'pSpec',.F.) 
				IF NOT lpSpec
					WAIT WINDOW "Updating all SO items with Print Specification on material as True" TIMEOUT 1
				ENDIF
			ENDIF	
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkpDesc.VALUE,'pDesc',.F.) 
				IF NOT lpDesc
					WAIT WINDOW "Updating all SO items with Print Description on material as True" TIMEOUT 1
				ENDIF
			ENDIF	
			IF PrepareSQLlogic( ThisFormSet.frmEO.pf1.pgBillTo.chkpOther.VALUE,'pOther',.F.)
				IF NOT lpOther
					WAIT WINDOW "Updating all SO items with Print '"+cOther+"' on material." TIMEOUT 1
				ENDIF
			ENDIF	
		
			SELECT SalesQuote
			*replace all data in the SalesQuote
			REPLACE ALL QA WITH lQA,;
			 CofC WITH lCofC,;
			 Merc WITH lMerc,;
			 pPO WITH lpPO,;
			 pPN WITH lpPN,;
			 pHeat WITH lpHeat,;
			 pSpec WITH lpSpec,;
			 pDesc WITH lpDesc,;
			 pOther WITH lpOther,;
			 Other WITH cOther;
			 IntP WITH lpIntP;
			  IN SalesQuote
		
			*********************************
			*Recenter SalesQuote on correct item
			SELECT SalesQuote
			IF nRecNum > 0 AND nRecNum <= RECCOUNT('SalesQuote')
				GOTO (nRecNum)
			ELSE
				IF nItem_A <> nItem
					MESSAGEBOX("RECNO('SalesQuote') has been lost."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"End: Check Data for Save.",0,"Lost RecNo")
					TrackError("Lost RecNo","RECNO('SalesQuote') is 0."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"End of Check Data for Save.",PROGRAM(),LINENO(1))
					LOCATE FOR Item_A = nItem
					*nRecNum = RECNO('SalesQuote')
				ELSE
					MESSAGEBOX("RECNO('SalesQuote') has been lost."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"Data check FAILED."+CHR(13)+"This will not be allowed to be saved."+CHR(13)+"End: Check Data for Save.",0,"Lost RecNo")
					TrackError("Lost RecNo","RECNO('SalesQuote') is 0."+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"End of Check Data for Save.",PROGRAM(),LINENO(1))
					
					GO TOP
					lPassCheck = .F.
				ENDIF
			ENDIF
		
		ENDIF
		
		********
		IF RECNO('SalesQuote') > RECCOUNT('SalesQuote')
			MESSAGEBOX("Lost 'SalesQuote' table order",0,"Error")
		ENDIF
		RETURN lPassCheck 
			
	ENDPROC

	PROCEDURE checkpos_salesquote
		*ThisFormSet.CheckPOs_SalesQuote
		*Check that PO's are listed in SalesQuote table
		*Returns .T. or .F.
		
		PRIVATE lReturn
		lReturn = .T.
		
		SELECT SalesQuote
		
		PRIVATE nRecNum
		nRecNum = RECNO('SalesQuote')
		
		PRIVATE cSOitem, nHPAPO1, cBuyFrom1, nHPAPO2, cBuyFrom2	
		PRIVATE lHavePO1, lHavePO2
		lHavePO1 = .F.
		lHavePO2 = .F.
		
		SELECT SalesQuote
		SCAN
			cSOitem		= SalesQuote.SOitem
			
			nHPAPO1		= PrepareSQLnum(SalesQuote.HPAPO,'HPAPO',-3)
			cBuyFrom1	= PrepareSQLtxt(SalesQuote.BuyFrom,'BuyFrom',15)
			nHPAPO2		= PrepareSQLnum(SalesQuote.HPAPO2,'HPAPO',-3)
			cBuyFrom2	= PrepareSQLtxt(SalesQuote.BuyFrom2,'BuyFrom2',15)
			
			lHavePO1	= IIF(nHPAPO1=0,.F.,.T.)
			lHavePO2	= IIF(nHPAPO2=0,.F.,.T.)
			
			*Get PO's for this SOitem
			PRIVATE nSQLEXEC, cSQL
			
			cSQL = "SELECT HPApo,POitem,Company,Services,ConvServ,Equipment,Printed "
			cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " ORDER BY Printed DESC, ConvServ, Services, Equipment"
			*Order by importance of PO!
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOitem' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL, 'tmpPOitem' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitem")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOitem')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					RETURN .F.
				ENDIF
			ENDIF
			
			PRIVATE lMatchHPAPO1, lMatchHPAPO2
			lMatchHPAPO1 = .F.
			lMatchHPAPO2 = .F.
			
			IF USED('tmpPOitem')
				*Compare tmpPOitem with SalesQuote
				IF RECCOUNT('tmpPOitem') > 0
					
					SCAN
						nHPAPO		= PrepareSQLnum(tmpPOitem.HPApo,'HPAPO',-3)
						cCompany	= PrepareSQLtxt(tmpPOitem.Company,'Company',30,.F.,.T.)
						
						IF lHavePO1 OR lHavePO2
							IF lHavePO1
								IF nHPAPO1 = nHPAPO
									lMatchHPAPO1 = .T.
								ENDIF
							ENDIF
							IF lHavePO2
								IF nHPAPO2 = nHPAPO
									lMatchHPAPO2 = .T.
								ENDIF
							ENDIF
							
						ELSE
							*have No lHavePO1 OR lHavePO2 - must add to SalesQuote
							IF NOT lHavePO1
								*Replace nHPAPO1 with nHPAPO
								SELECT SalesQuote
								LOCATE FOR SOitem = cSOitem
								
								IF FOUND('SalesQuote')
									REPLACE SalesQuote.HPAPO WITH nHPAPO
									REPLACE SalesQuote.BuyFrom WITH LEFT(cCompany,15)
									lHavePO1 = .T.
								ENDIF
							ELSE
								IF NOT lHavePO2
									*Replace nHPAPO2 with nHPAPO
									SELECT SalesQuote
									LOCATE FOR SOitem = cSOitem
									
									IF FOUND('SalesQuote')
										REPLACE HPAPO2 WITH nHPAPO IN SalesQuote
										REPLACE BuyFrom2 WITH LEFT(cCompany,15) IN SalesQuote
										lHavePO2 = .T.
									ENDIF					
								ENDIF
							ENDIF
						ENDIF
						
						IF lMatchHPAPO1 AND lMatchHPAPO2
							EXIT
						ENDIF
						SELECT tmpPOitem
					ENDSCAN
				ELSE
				*	*No reords Found
				*	IF lHavePO1 OR lHavePO2
				*		lReturn = .F.
				*	ELSE
						lReturn = .T.
				*	ENDIF
				ENDIF
			ELSE
			*	IF lHavePO1 OR lHavePO2
			*		*Problem - did not find a PO in PurchaseOrders
			*		lReturn = .F.
			*	ELSE
					lReturn = .T.
			*	ENDIF
			ENDIF
		
			SELECT SalesQuote
		ENDSCAN
		
		
		
		
		
		
		SELECT SalesQuote
		IF nRecNum > 0 AND nRecNum <= RECCOUNT('SalesQuote')
			GOTO (nRecNum)
		ENDIF
		
		RETURN lReturn 
	ENDPROC

	PROCEDURE checkspinnertyp
		PARAMETERS cField, pValue
		*ThisFormSet.CheckSpinnerTYP(cField, pValue)
		PRIVATE cTYP 
		
		
		DO CASE
		CASE cField = "cmbTyp"
			DO CASE
			CASE pValue = "I"
			*Inventory, Stock found on the Inventory List, IF Heat is Due In, should be TYP 'M' for Mill
				IF SalesQuote.Services
					MESSAGEBOX("You cannot have 'Inventory' and 'Service' selected on same item."+CHR(13)+"A Service does not use ERP Stock"+CHR(13)+"ERP Stock with an added Service is a SALE of Inventory",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF NOT SalesQuote.INV
					REPLACE INV WITH .T. IN SalesQuote
				ENDIF
				
			CASE pValue = "B"
			*Broker, HPA is bringing in Material for Order with an ERP PO
				IF SalesQuote.Services
					MESSAGEBOX("You cannot have 'Broker' and 'Service' selected on same item."+CHR(13)+"Could be a broker Sale with Service work",48,"Please choose only one!")
					RETURN .F.
				ENDIF
				IF NOT SalesQuote.BRK
					REPLACE BRK WITH .T. IN SalesQuote
				ENDIF
			
			CASE pValue = "M"
			*Mill, Stock with Long due dates
				IF SalesQuote.Services
					MESSAGEBOX("You cannot have 'Mill' and 'Service' selected on same item."+CHR(13)+"Could be a Mill Sale with Service Work",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			
			CASE pValue = "P"
			*Production work is rquired make make properties of the Sales
				IF SalesQuote.Services
					MESSAGEBOX("You cannot have 'Production' and 'Toll Work Service' selected on same item."+CHR(13)+"Production is on HPA material"+CHR(13)+"Toll Work is production on Customers Material",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			
			CASE pValue = "S"
			*Service Order/Toll Work on Customers Material
				IF NOT SalesQuote.Services
				
				ENDIF
			CASE pValue = "C"
			*Conversion without useing Big Production Equipment on Customers Material
			
			ENDCASE
			
		************************************
		CASE cField = "chkINV"
			IF pValue AND SalesQuote.Services
				MESSAGEBOX("You cannot have 'Inventory' and 'Service' selected on same item."+CHR(13)+"A Service does not use ERP Stock"+CHR(13)+"ERP Stock with an added Service is a SALE of Inventory",48,"Please choose only one!")
				RETURN .F.
			ENDIF
			
		CASE cField = "chkBRK"
			IF pValue AND SalesQuote.Services
				MESSAGEBOX("You cannot have 'Broker' and 'Service' selected on same item."+CHR(13)+"A Service does not use stock HPA must buy"+CHR(13)+"Stock with an added Service is a Value Added SALE ",48,"Please choose only one!")
				RETURN .F.
			ENDIF
			
		CASE cField = "chkService"
			*Toll Work Service Order
			IF pValue AND SalesQuote.INV
				MESSAGEBOX("You cannot have 'Inventory' and 'Service' selected on same item."+CHR(13)+"A Service does not use ERP Stock"+CHR(13)+"ERP Stock with an added Service is a SALE of Inventory",48,"Please choose only one!")
				RETURN .F.
			ENDIF
			IF pValue AND SalesQuote.BRK
				MESSAGEBOX("You cannot have 'Broker' and 'Service' selected on same item."+CHR(13)+"A Service does not use stock HPA must buy"+CHR(13)+"Stock with an added Service is a Value Added SALE ",48,"Please choose only one!")
				RETURN .F.
			ENDIF
		
		CASE cField = "chkGFM"
			IF SalesQuote.TYP == '' OR SalesQuote.TYP = 'P' OR SalesQuote.TYP = 'S' OR SalesQuote.TYP = 'C'
				*good
			ELSE
				IF pValue 
					cTYP = 	SalesQuote.TYP
					MESSAGEBOX("You cannot have 'GFM' and TYP '"+cTYP+"' selected on same item."+CHR(13)+"This is usually Production",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			ENDIF
			
		CASE cField = "chkDraw"
			IF SalesQuote.TYP == '' OR SalesQuote.TYP = 'P' OR SalesQuote.TYP = 'S' OR SalesQuote.TYP = 'C'
				*good
			ELSE
				IF pValue 
					cTYP = 	SalesQuote.TYP
					MESSAGEBOX("You cannot have 'Draw' and TYP '"+cTYP+"' selected on same item."+CHR(13)+"This is usually Production",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			ENDIF
		
		CASE cField = "chkRoll"
			IF SalesQuote.TYP == '' OR SalesQuote.TYP = 'P' OR SalesQuote.TYP = 'S' OR SalesQuote.TYP = 'C'
				*good
			ELSE
				IF pValue 
					cTYP = SalesQuote.TYP
					MESSAGEBOX("You cannot have 'Roll' and TYP '"+cTYP+"' selected on same item."+CHR(13)+"This is usually Production",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			ENDIF
		
		CASE cField = "chkPress"
			IF SalesQuote.TYP == '' OR SalesQuote.TYP = 'P' OR SalesQuote.TYP = 'S' OR SalesQuote.TYP = 'C'
				*good
			ELSE
				IF pValue 
					cTYP = 	SalesQuote.TYP
					MESSAGEBOX("You cannot have 'Press' and TYP '"+cTYP+"' selected on same item."+CHR(13)+"This is usually Production",48,"Please choose only one!")
					RETURN .F.
				ENDIF
			ENDIF
		
		CASE cField = "chkMach"
		
		CASE cField = "chkCG"
			IF VAL(ThisFormSet.frmEO.pF1.pgOrder.txtForm.Value) > 25
				WAIT WINDOW "Centerless Grinder is normally done on Rounds" TIMEOUT 1
			ENDIF
		
		CASE cField = "chkPlasma"
			*check Form 40
			IF ThisFormSet.frmEO.pF1.pgOrder.txtForm.Value <> "40"
				WAIT WINDOW "Plasma is normally done on Plate" TIMEOUT 1
			ENDIF
		CASE cField = "chkWJet"
			*Check form 40
			IF ThisFormSet.frmEO.pF1.pgOrder.txtForm.Value <> "40"
				WAIT WINDOW "Water Jet is normally done on Plate" TIMEOUT 1
			ENDIF
		OTHERWISE
			TrackError("ThisFormSet.CheckSpinnerTYP(cField, )"+CHR(13)+"cField not Found","Bad Parameter", PROGRAM(), LINENO(1))
		ENDCASE
	ENDPROC

	PROCEDURE check_new_wod
		*ThisFormSet.Check_New_WOD()
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(SalesQuote.SOitem,'SOitem',10)
		
		PRIVATE nWO, nWO_Detail
		nWO			= 0
		nWO_Detail	= 0
		
		*IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			nWO			= GetWO_SOitem(cSOitem, ThisFormSet.nConnhandle)
			nWO_Detail	= GetWOD_SOitem(cSOitem, ThisFormSet.nConnhandle)
		*ENDIF
		
		*!*	IF nWO > 0 AND nWO_Detail = 0
		*!*		*Look for nWO_Detail by WO
		*!*		IF Count_WODinWO_WO(nWO, ThisFormSet.nConnhandle,'') = 1
		*!*			nWO_Detail = GetWOD_SOitem( cSOitem, ThisForm.nConnHandle)
		*!*		ENDIF
		*!*	ENDIF
		
		IF nWO_Detail > 0
			
			SELECT SalesQuote
			REPLACE SalesQuote.WO_Detail WITH nWO_Detail
			REPLACE SalesQuote.WO WITH nWO
			
			ThisFormSet.ShowWO_WOD_Window()
			
		ENDIF
	ENDPROC

	PROCEDURE check_soitem_hrs
		PARAMETER lShowScreen
		*ThisFormSet.Check_SOitem_Hrs()
		
		IF VARTYPE(lShowScreen) != "L"
			lShowScreen = .F.
			*No Show also Saves!
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = SalesQuote.SOitem_A
		
		PRIVATE nINVhrs, nRecvHrs, nMachHrs, nCGhrs,nPackHrs,nGFMhrs,nDrawHrs,nRollHrs,nPressHrs
		PRIVATE nHeatHrs,nTestHrs,nAbrsvHrs,nBSawHrs,nShearHrs,nPlasmaHrs,nWJetHrs,nHrs
		IF lShowScreen
			nINVhrs 	= ThisFormset.frmEO.pf1.pgQA.spnINV.Value	
			nRecvHrs 	= ThisFormset.frmEO.pf1.pgQA.spnRecv.Value	
			nMachHrs	= ThisFormset.frmEO.pf1.pgQA.spnMach.Value	
			nCGhrs		= ThisFormset.frmEO.pf1.pgQA.spnCG.Value	
			nPackHrs	= ThisFormset.frmEO.pf1.pgQA.spnPack.Value	
			nGFMhrs		= ThisFormset.frmEO.pf1.pgQA.spnGFM.Value	
			nDrawHrs	= ThisFormset.frmEO.pf1.pgQA.spnDraw.Value	
			nRollHrs	= ThisFormset.frmEO.pf1.pgQA.spnRoll.Value
			nPressHrs	= ThisFormset.frmEO.pf1.pgQA.spnPress.Value
			nHeatHrs	= ThisFormset.frmEO.pf1.pgQA.spnHeat.Value
			nTestHrs	= ThisFormset.frmEO.pf1.pgQA.spnTest.Value
			nAbrsvHrs	= ThisFormset.frmEO.pf1.pgQA.spnAbrsv.Value
			nBSawHrs	= ThisFormset.frmEO.pf1.pgQA.spnBSaw.Value
			nShearHrs	= ThisFormset.frmEO.pf1.pgQA.spnShear.Value
			nPlasmaHrs	= ThisFormset.frmEO.pf1.pgQA.spnPlasma.Value
			nWJetHrs	= ThisFormset.frmEO.pf1.pgQA.spnWJet.Value
		ELSE
			nINVhrs 	= 0
			nRecvHrs 	= 0
			nMachHrs	= 0
			nCGhrs		= 0
			nPackHrs	= 0
			nGFMhrs		= 0
			nDrawHrs	= 0
			nRollHrs	= 0
			nPressHrs	= 0
			nHeatHrs	= 0
			nTestHrs	= 0
			nAbrsvHrs	= 0
			nBSawHrs	= 0
			nShearHrs	= 0
			nPlasmaHrs	= 0
			nWJetHrs	= 0
		
			IF USED('tmp_Hrs')
				USE IN tmp_Hrs
			ENDIF
			
			cSQL = "SELECT * FROM dbo.SOitem_Hrs WITH(NOLOCK) "
			*cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"tmp_Hrs")
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmp_Hrs')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmp_Hrs")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmp_Hrs")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmp_Hrs')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('tmp_Hrs')
				IF RECCOUNT('tmp_Hrs') > 0
					nINVhrs 	= PrepareSQLnum(tmp_Hrs.INV,'INV',-2)
					nRecvHrs 	= PrepareSQLnum(tmp_Hrs.Recv,'Recv',-2)
					nMachHrs	= PrepareSQLnum(tmp_Hrs.Mach,'Mach',-2)
					nCGhrs		= PrepareSQLnum(tmp_Hrs.CG,'CG',-2)
					nPackHrs	= PrepareSQLnum(tmp_Hrs.Pack,'Pack',-2)
					nGFMhrs		= PrepareSQLnum(tmp_Hrs.GFM,'GFM',-2)
					nDrawHrs	= PrepareSQLnum(tmp_Hrs.Draw,'Draw',-2)
					nRollHrs	= PrepareSQLnum(tmp_Hrs.Roll,'Roll',-2)
					nPressHrs	= PrepareSQLnum(tmp_Hrs.Press,'Press',-2)
					nHeatHrs	= PrepareSQLnum(tmp_Hrs.Heat,'Heat',-2)
					nTestHrs	= PrepareSQLnum(tmp_Hrs.Test,'Test',-2)
					nAbrsvHrs	= PrepareSQLnum(tmp_Hrs.Abrsv,'Abrsv',-2)
					nBSawHrs	= PrepareSQLnum(tmp_Hrs.BSaw,'BSaw',-2)
					nShearHrs	= PrepareSQLnum(tmp_Hrs.Shear,'Shear',-2)
					nPlasmaHrs	= PrepareSQLnum(tmp_Hrs.Plasma,'Plasma',-2)
					nWJetHrs	= PrepareSQLnum(tmp_Hrs.Wjet,'Wjet',-2)
				ENDIF
				USE IN tmp_Hrs
			ENDIF
		ENDIF
		
		SELECT SalesQuote
		IF SalesQuote.Inv
			IF nINVhrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnINV.Value = 1
				ENDIF
				nINVhrs = 1
			ENDIF
		ENDIF
		
		IF PrepareSQLnum(SalesQuote.HPAPo,'HPAPO',-3) > 0
			IF nRecvHrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnRecv.Value = 1	
				ENDIF
				nRecvHrs = 3
			ENDIF
		ENDIF
		**
		IF SalesQuote.Mach
			IF nMachHrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnMach.Value = 1
				ENDIF
				nMachHrs = 1
			ENDIF
		ENDIF
		**
		IF SalesQuote.CG
			IF nCGhrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnCG.Value = 4
				ENDIF
				nCGhrs = 4
			ENDIF
		ENDIF
		**
		*IF nPackHrs = 0
		*	ThisFormset.frmEO.pf1.pgQA.spnPack.Value = 1
		*	nPackHrs = 1
		*ENDIF
		**
		IF SalesQuote.GFM
			IF nGFMhrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnGFM.Value = 20
				ENDIF
				nGFMhrs = 20
			ENDIF
		ENDIF
		**
		IF SalesQuote.Draw
			IF nDrawHrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnDraw.Value = 2
				ENDIF
				nDrawHrs = 2
			ENDIF
		ENDIF
		**
		IF SalesQuote.Roll
			IF nRollHrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnRoll.Value = 20
				ENDIF
				nRollHrs = 20
			ENDIF
		ENDIF
		**
		IF SalesQuote.Press
			IF nPressHrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnPress.Value = 20
				ENDIF
				nPressHrs = 20
			ENDIF
		ELSE
			nPressHrs = 0
		ENDIF
		**
		IF SalesQuote.GFM OR SalesQuote.Roll OR SalesQuote.Press
			IF nHeatHrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnHeat.Value = 8
				ENDIF
				nHeatHrs = 8
			ENDIF
		ENDIF
		**
		IF SalesQuote.GFM OR SalesQuote.Draw OR SalesQuote.Roll OR SalesQuote.Press
			IF nTestHrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnTest.Value = 40
				ENDIF
				nTestHrs = 40
			ENDIF
		ENDIF
		**
		*IF nAbrsvHrs = 0
		*	nAbrsvHrs = 0
		*	nAbrsvHrs 
		*ENDIF
		**
		*IF nBSawHrs = 0
		*	nBSawHrs = 0
		*	nBSawHrs 
		*ENDIF
		**
		IF SalesQuote.Plasma
			IF nPlasmaHrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnPlasma.Value = 2
				ENDIF
				nPlasmaHrs = 2
			ENDIF
		ENDIF
		**
		IF SalesQuote.Plasma
			IF nWJetHrs = 0
				IF lShowScreen
					ThisFormset.frmEO.pf1.pgQA.spnWJet.Value = 2
				ENDIF
				nWJetHrs = 2
			ENDIF
		ENDIF
		
		*******************
		PRIVATE nCutHR
		nCutHR = PrepareSQLnum(SalesQuote.CutHR,'CutHR',-2)
		******
		*Override with Sales.CutHR
		IF VARTYPE(SalesQuote.Cut) = "C"
			DO CASE
			CASE SalesQuote.Cut = 'N'
			*-	not specified
			CASE SalesQuote.Cut = 'A'
			*	-abrasive
			CASE SalesQuote.Cut = 'B'
			*	-band saw
			CASE SalesQuote.Cut = 'S'
			*	-shear
			CASE SalesQuote.Cut = 'P'
			*	-plasma
				ThisFormset.frmEO.pf1.pgQA.spnPlasma.Value = nCutHR 
				nPlasmaHrs = nCutHR 
			CASE SalesQuote.Cut = 'W'
			*	-waterjet
				ThisFormset.frmEO.pf1.pgQA.spnWJet.Value = nCutHR 
				nWJetHrs = nCutHR 
			ENDCASE
		ENDIF
		**
		
		
		nHrs = nINVhrs + nRecvHrs + nMachHrs + nCGhrs + nPackHrs + nGFMhrs + nDrawHrs + nRollHrs + nPressHrs 
		nHrs = nHrs + nHeatHrs + nTestHrs + nAbrsvHrs + nBSawHrs + nShearHrs +nPlasmaHrs + nWJetHrs
		nHrs = nHrs + 1
		
		
		IF lShowScreen
			ThisFormSet.frmEO.pf1.pgQA.lblHRS.Caption = STR(nHrs)
		ELSE
			IF USED('tmpSOi_Hrs')
				USE IN tmpSOi_Hrs
			ENDIF
			
			cSQL = "UPDATE dbo.SOitem_Hrs "
			cSQL = cSQL + "SET INV="+STR(nINVhrs)
			cSQL = cSQL + ",Recv="+STR(nRecvHrs)
			cSQL = cSQL + ",[Mach]="+STR(nMachHrs)
			cSQL = cSQL + ",CG="+STR(nCGhrs)
			cSQL = cSQL + ",[Pack]="+STR(nPackHrs)
			cSQL = cSQL + ",[GFM]="+STR(nGFMhrs)
			cSQL = cSQL + ",[Draw]="+STR(nDrawHrs)
			cSQL = cSQL + ",[Roll]="+STR(nRollHrs)
			cSQL = cSQL + ",Press="+STR(nPressHrs)
			cSQL = cSQL + ",Heat="+STR(nHeatHrs)
			cSQL = cSQL + ",Test="+STR(nTestHrs)
			cSQL = cSQL + ",Abrsv="+STR(nAbrsvHrs)
			cSQL = cSQL + ",BSaw="+STR(nBSawHrs)
			cSQL = cSQL + ",Shear="+STR(nShearHrs)
			cSQL = cSQL + ",Plasma="+STR(nPlasmaHrs)
			cSQL = cSQL + ",WJet="+STR(nWJetHrs)
			cSQL = cSQL + ",Hrs="+STR(nHrs)
		*	cSQL = cSQL + ",DateEst='"+DTOC(dDateEst)+"'"
			*cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"tmpSOi_Hrs")
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOi_Hrs')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOi_Hrs")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOi_Hrs")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSOi_Hrs')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					RETURN .F.
				ENDIF
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE convertthis
		PARAMETER lcInputValue, lcDirection
		*ThisFormSet.ConvertThis()
		
		PRIVATE lcUPPERInputValue, nCalcValue, nStartVal 
		PRIVATE nDecimal
		lcUPPERInputValue = UPPER(ALLTRIM(lcInputValue))
		IF "/" $ lcUPPERInputValue 
			PRIVATE nSpacePos, nDividePos, nPreSpaceValue, cAfterSpace, nAfterSpaceValue, nCalcValue 
			PRIVATE nNominator ,nDeNominator
			*Check for a space like 2 1/2"
			nDividePos = AT("/",lcUPPERInputValue)
			nSpacePos = AT(" ", (lcUPPERInputValue) )
			IF nSpacePos > 0 AND nSpacePos < nDividePos &&Check for a space before divide like 2 1/2"
				*Save the space pre space value
				nPreSpaceValue = VAL( LEFT( ( lcUPPERInputValue ), nSpacePos ) )
				cAfterSpace    = ALLTRIM( RIGHT( ( lcUPPERInputValue ), LEN(( lcUPPERInputValue )) - nSpacePos ) )
				
				nDividePos = AT("/", cAfterSpace )
				nAfterSpaceValue = VAL( LEFT( cAfterSpace, nDividePos ) ) / VAL( RIGHT( cAfterSpace, LEN(cAfterSpace) - nDividePos ) )
				lcInputValue = STR( nPreSpaceValue + nAfterSpaceValue , 10, 3)
			ELSE
				nNominator =  VAL( LEFT( lcUPPERInputValue , nDividePos ) )
				nDeNominator = VAL( RIGHT( lcUPPERInputValue , LEN(lcUPPERInputValue ) - nDividePos ) )
				lcInputValue = STR( nNominator  / nDeNominator , 9, 3)
				*If $/LB,$/Pc,$/Ft and Denomator is fraction like .85, Store Nominator to Quote Field
				IF INLIST(ThisFormSet.MetricGOTFocus,"P_FT1","P_PC1","P_LB1")
					IF nDeNominator < 1 and nDeNominator > .6
						IF NOT ALLTRIM(STR(nNominator,9,0)) $ ALLTRIM(ThisFormset.frmEO.pf1.pgQuote.edtQuotememo.Value)
							PRIVATE cFraction
							cFraction = ALLTRIM(STR(nNominator,9,2))+ IIF(ThisFormSet.MetricGOTFocus="P_FT1","/FT",IIF(ThisFormSet.MetricGOTFocus="P_PC1","/PC",IIF(ThisFormSet.MetricGOTFocus="P_LB1","/LB","")))
							ThisFormset.frmEO.pf1.pgQuote.edtQuotememo.Value = ALLTRIM(ThisFormset.frmEO.pf1.pgQuote.edtQuotememo.Value)+CHR(13)+cFraction
							*Tried CHR(13), changed to CHR(10) on 2004-7-21
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE nMathPos
		IF "*" $ lcUPPERInputValue 
			nMathPos= AT("*",lcUPPERInputValue)
			lcInputValue = STR( VAL( LEFT( lcUPPERInputValue , nMathPos) ) * VAL( RIGHT( lcUPPERInputValue , LEN(lcUPPERInputValue ) - nMathPos) ), 9, 3)
		ENDIF
		IF "+" $ lcUPPERInputValue 
			nMathPos= AT("+",lcUPPERInputValue)
			lcInputValue = STR( VAL( LEFT( lcUPPERInputValue , nMathPos) ) + VAL( RIGHT( lcUPPERInputValue , LEN(lcUPPERInputValue ) - nMathPos) ), 9, 3)
		ENDIF
		IF "-" $ lcUPPERInputValue 
			nMathPos= AT("-",lcUPPERInputValue)
			lcInputValue = STR( VAL( LEFT( lcUPPERInputValue , nMathPos) ) - VAL( RIGHT( lcUPPERInputValue , LEN(lcUPPERInputValue ) - nMathPos) ), 9, 3)
		ENDIF
		
		
		
		IF ThisFormSet.MetricGotFocus = "THCK1" OR ThisFormSet.MetricGotFocus = "ssTHCK1"
			nDecimal = SET("Decimal")
			SET DECIMAL TO 4
		ENDIF
		
		nCalcValue = VAL(lcInputValue)
		
		IF ThisFormSet.MetricGotFocus = "THCK1" OR ThisFormSet.MetricGotFocus = "ssTHCK1"
			SET DECIMAL TO (nDecimal)
		ENDIF
		
		DO CASE
		CASE "'" $ lcUPPERInputValue OR "FT" $ lcUPPERInputValue OR "FEET" $ lcUPPERInputValue 
			nCalcValue = VAL(lcInputValue) * 12
		CASE "CM" $ lcUPPERInputValue 
			nCalcValue = VAL(lcInputValue) * .3937
		CASE "MM" $ lcUPPERInputValue 
			nCalcValue = VAL(lcInputValue) * .03937
		CASE "M" $ lcUPPERInputValue 
			IF LEFT(lcUPPERInputValue,1) = "M"
				IF ThisFormSet.MetricGotFocus = "THCK1"
					*ThisFormset.SalesQuote.ChkMetric.Value = 1
				ENDIF
				nCalcValue = VAL(RIGHT(lcInputValue,LEN(lcInputValue)-1))
			ELSE
				nCalcValue = VAL(lcInputValue) * 39.37
			ENDIF
		CASE "KG" $ lcUPPERInputValue 
			nCalcValue = VAL(lcInputValue) * 2.2
		CASE "G" $ lcUPPERInputValue 
			nStartVal = VAL(lcInputValue)
				DO CASE
				CASE nStartVal  = 8
					nCalcValue = .172
				CASE nStartVal  = 9
					nCalcValue = .156
				CASE nStartVal  = 10
					nCalcValue = .141
				CASE nStartVal  = 11
					nCalcValue = .125
				CASE nStartVal  = 12
					nCalcValue = .109
				CASE nStartVal  = 13
					nCalcValue = .094
				CASE nStartVal  = 14
					nCalcValue = .078
				CASE nStartVal  = 15
					nCalcValue = .070
				CASE nStartVal  = 16
					nCalcValue = .063
				CASE nStartVal  = 17
					nCalcValue = .056
				CASE nStartVal  = 18
					nCalcValue = .050
				CASE nStartVal  = 19
					nCalcValue = .044
				CASE nStartVal  = 20
					nCalcValue = .038
				CASE nStartVal  = 21
					nCalcValue = .034
				CASE nStartVal  = 22
					nCalcValue = .031
				CASE nStartVal  = 23
					nCalcValue = .028
				CASE nStartVal  = 24
					nCalcValue = .025
				CASE nStartVal  = 25
					nCalcValue = .020
				CASE nStartVal  = 26
					nCalcValue = .018
				OTHERWISE
					wait window "Gage not Programed!"
				ENDCASE		
		OTHERWISE
			
		ENDCASE
		
		RETURN nCalcValue
	ENDPROC

	PROCEDURE creditcard
		PARAMETERS pAction
		*ThisFormSet.CreditCard()
		
		PRIVATE nDecimal
		nDecimal = SET("DECIMAL")
		
		LOCAL nCCSO
		nCCSO = PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtSalesNum.VALUE,'SalesNum',-3)
		IF VARTYPE(nCCSO) <> "N"
			SET DECIMAL TO 0
			nCCSO = VAL(nCCSO)
			SET DECIMAL TO nDecimal
		ENDIF
		IF EMPTY(nCCSO)
			nCCSO = ThisFormSet.SalesNum
			*ThisFormSet.frmEO.pf1.pgCreditCard.txtSalesNum.VALUE = nCCSO
		ENDIF
		
		***********************
		
		DO CASE
		CASE pAction = "EDIT"
			RETURN .T.
			
		CASE pAction = "NEW"
		*New Initialize
			ThisFormSet.frmEO.pf1.pgCreditCard.txtSalesnum.VALUE = ThisFormSet.Salesnum
		
			IF ThisFormSet.SoldAddr > 0
			
				IF LEN(ALLTRIM( PrepareSQLtxt( ThisFormSet.frmEO.pf1.pgBillTo.txtCompany.VALUE, 'Company',100) ))=0
					ThisFormSet.frmEO.pf1.ACTIVEPAGE = 4
					*Load the Bill to page
					ThisFormSet.pgRefresh()
					ThisFormSet.frmEO.pf1.ACTIVEPAGE = 7
				ENDIF
				
				ThisFormSet.frmEO.pf1.pgCreditCard.txtSoldcode.VALUE = ThisFormSet.SoldAddr
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCompany.VALUE	= ThisFormSet.frmEO.pf1.pgBillTo.txtCompany.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtAddr1.VALUE	= ThisFormSet.frmEO.pf1.pgBillTo.txtAddr1.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtAddr2.VALUE	= ThisFormSet.frmEO.pf1.pgBillTo.txtAddr2.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCity.VALUE	= ThisFormSet.frmEO.pf1.pgBillTo.txtCity.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtST.VALUE		= ThisFormSet.frmEO.pf1.pgBillTo.txtST.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtZip.VALUE		= ThisFormSet.frmEO.pf1.pgBillTo.txtZip.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtCountry.VALUE	= UPPER(ALLTRIM(ThisFormSet.frmEO.pf1.pgBillTo.txtCountry.VALUE))
				ThisFormSet.frmEO.pf1.pgCreditCard.txtContact.VALUE	= ThisFormSet.frmEO.pf1.pgBillTo.txtContact.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtPhone.VALUE	= ThisFormSet.frmEO.pf1.pgBillTo.txtPhone.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtFax.VALUE		= ThisFormSet.frmEO.pf1.pgBillTo.txtFax.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtEmail.VALUE		= ThisFormSet.frmEO.pf1.pgBillTo.txtEmail.VALUE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtLastEdit.VALUE	= ThisFormSet.frmEO.pf1.pgBillTo.txtLastEdit.VALUE
		
		
			ELSE
				ThisFormSet.frmEO.pf1.pgCreditCard.txtSoldcode.VALUE = 0
			ENDIF
			IF VARTYPE(ThisFormSet.frmEO.pf1.pgValue.nSale.Value) = "N" &&OR VARTYPE(ThisFormSet.frmEO.pf1.pgValue.nSale.Value)="Y"
				ThisFormSet.frmEO.pf1.pgCreditCard.txtSale.VALUE = PrepareSQLNum(  NTOM(ThisFormSet.frmEO.pf1.pgValue.nSale.VALUE) ,'Sale',10,2)
			ENDIF
			RETURN .T.
			
		CASE pAction = "PRINTED"
		
				PRIVATE nCCSO, lccCardNo1, lccCardNo4, nCCV
				nCCSO = ThisFormSet.SalesNum
				lccCardNo1		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo1.VALUE,'CardNo1',4,0)
				lccCardNo4		= PADL( ALLTRIM(STR(PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo4.VALUE,'CardNo',4,0),4,0)),4,'0')
				nCCV			= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCCV.VALUE,'CCV',4,0)
						
				PRIVATE cSQL, nSQLEXEC
				cSQL = "UPDATE dbo.CreditCd SET "
				cSQL = cSQL + "	Printed = ISNULL(Printed,0) + 1 "
				cSQL = cSQL + ",WhoPrinted= (suser_sname())"
				cSQL = cSQL + "	WHERE SalesNum = "+STR(PrepareSQLnum(nCCSO,'SalesNum',-3))
				cSQL = cSQL + " AND CardNo1 = "+STR(PrepareSQLnum(lccCardNo1,'CardNo1',4,0),4,0)
				cSQL = cSQL + " AND CardNo4 = "+PADL( ALLTRIM(STR(PrepareSQLnum(lccCardNo4,'CardNo4',4,0),4,0)),4,'0')
				cSQL = cSQL + " AND CCV = "+STR(PrepareSQLnum(nCCV,'CCV',4,0))
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ELSE
					TrackMess("Printed CC used for SO "+ALLTRIM(STR(nCCSO))+" with last 4 "+lccCardNo4+". "+CHR(13)+SYS(16,1))
				ENDIF
		
		CASE pAction = "SAVE"
			LOCAL lccHolderName, lccCardType, lccCardNo1, lccCardNo4, lccCCV, lccExpireDd, lccExpireMm, lccExpireYyyy
			LOCAL lccSoldCode, lccSale, lccShipIns, lccTotalAmt, lccNotes, lccAuthNo, lccAuthDate
		
			lccHolderName	= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgCreditCard.txtHolderName.VALUE,'HolderName',50,.F.)
			lccCardType		= ThisFormSet.frmEO.pf1.pgCreditCard.cmbCardtype.VALUE
			lccCardNo1		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo1.VALUE,'CardNo1',4,0)
			lccCardNo4		= PADL( ALLTRIM(STR(PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo4.VALUE,'CardNo',4,0),4,0)),4,'0')
			*lccCardNo4		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo4.VALUE,'CardNo4',4,0)
			*lccCCV			= PADL( ALLTRIM(STR(PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCCV.VALUE,'CCV',4,0),4,0)),4,'0')
			lccCCV			= STR(PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCCV.VALUE,'CCV',4,0),4,0)
			*lccCCV			= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtCCV.VALUE,'CCV',4,0)
			lccExpireDd		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireDd.VALUE,'ExpireDD',2,0)
			lccExpireMm		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireMm.VALUE,'ExpireMM',2,0)
			lccExpireYyyy	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireYyyy.VALUE,'ExpireYYYY',4,0)
			lccSoldCode		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtSoldcode.VALUE,'SoldCode',-3)
			lccSale			= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtSale.VALUE,'Sale',-5)
			lccShipIns		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtShipIns.VALUE,'ShipIns',-5)
			lccTotalAmt		= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgCreditCard.txtTotalamt.VALUE,'TotalAmt',-5)
			lccNotes		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgCreditCard.txtNotes.VALUE,'Notes',100,.F.)
			lccAuthNo		= PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthNo.VALUE,'AuthNo',20,.F.)
			lccAuthDate		= PrepareSQLdate(ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthdate.VALUE,'AuthDate')
			
			PRIVATE lFoundSOCC
			lFoundSOCC = FoundCCforSO(nCCSO,ThisFormSet.nConnHandle)
			
			IF LEN(ALLTRIM(lccCCV))=0
				MESSAGEBOX("The CVV Number ('Card Verification Value') on your credit card or debit card is a 3 digit number on VISA, MasterCard and Discover branded credit and debit cards. On your American Express branded credit or debit card it is a 4 digit numeric code.",64,"CCV is empty!")
				lccCCV='0'
			ENDIF
			
			IF lFoundSOCC 
				*UPDATE
				PRIVATE cSQL, nSQLEXEC
				cSQL = "UPDATE dbo.CreditCd SET "
				cSQL = cSQL + "	HolderName='"+lccHolderName+"'"
				cSQL = cSQL + ",CardType = '"+lccCardType+"'"
				cSQL = cSQL + ",CardNo1 = "+STR(lccCardNo1,4,0)
				*cSQL = cSQL + ",CardNo4 = "+STR(lccCardNo4,4,0)
				cSQL = cSQL + ",CardNo4 = "+PADL( ALLTRIM(STR(PrepareSQLnum(lccCardNo4,'CardNo4',4,0),4,0)),4,'0')
				cSQL = cSQL + ",CCV = "+lccCCV
				
				cSQL = cSQL + ",ExpireDd = "+IIF(lccExpireDd=0,'Null',STR(lccExpireDd,2,0))+""
				cSQL = cSQL + ",ExpireMM = "+IIF(lccExpireMm=0,'Null',STR(lccExpireMm,2,0))+""
				cSQL = cSQL + ",ExpireYYYY = "+IIF(lccExpireYyyy=0,'Null',STR(lccExpireYyyy,4,0))+""
				cSQL = cSQL + ",SoldCode = "+STR(lccSoldCode,10,0)
				cSQL = cSQL + ",Sale = "+STR(lccSale,10,4)
				cSQL = cSQL + ",ShipIns = "+STR(lccShipIns,10,4)
				cSQL = cSQL + ",TotalAmt = "+STR(lccTotalAmt,10,4)
				cSQL = cSQL + ",Notes = '"+lccNotes+"'"
				cSQL = cSQL + ",AuthNo = '"+lccAuthNo+"'"
				cSQL = cSQL + ",AUTHDate = '"+IIF(EMPTY(lccAuthDate),'',DTOC(lccAuthDate))+"'"
				cSQL = cSQL + "	WHERE SalesNum = "+STR(nCCSO)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
		
			ELSE
				IF LEN(ALLTRIM(lccCCV))=0
					MESSAGEBOX("The CVV Number ('Card Verification Value') on your credit card or debit card is a 3 digit number on VISA, MasterCard and Discover branded credit and debit cards. On your American Express branded credit or debit card it is a 4 digit numeric code.",64,"CCV is empty!")
					lccCCV='0'
				ENDIF
		
				*ADD
				PRIVATE cSQL, nSQLEXEC
				cSQL = "INSERT INTO dbo.CreditCd ("
				cSQL = cSQL + " Salesnum, HolderName, CardType, CardNo1, CardNo4, CCV"
				cSQL = cSQL + ",ExpireDD, ExpireMM, ExpireYYYY,"
				cSQL = cSQL + "SoldCode, Sale, ShipIns, TotalAmt, Notes, AuthNo, AUTHDate) "
				cSQL = cSQL + " VALUES ("
				cSQL = cSQL + STR(nCCSO,10,0)
				cSQL = cSQL + ",'"+lccHolderName+"'"
				cSQL = cSQL + ",'"+lccCardType+"'"
				cSQL = cSQL + ","+STR(lccCardNo1,4,0)+""
				cSQL = cSQL + ","+PADL( ALLTRIM(STR(PrepareSQLnum(lccCardNo4,'CardNo4',4,0),4,0)),4,'0')+""
				*cSQL = cSQL + ","+STR(lccCardNo4,4,0)+""
				cSQL = cSQL + ","+lccCCV+""
				cSQL = cSQL + ","+IIF(lccExpireDd=0,'Null',STR(lccExpireDd,2,0))+""
				cSQL = cSQL + ","+IIF(lccExpireMm=0,'Null',STR(lccExpireMm,2,0))+""
				cSQL = cSQL + ","+IIF(lccExpireYyyy=0,'Null',STR(lccExpireYyyy,4,0))+""
				cSQL = cSQL + ","+STR(lccSoldCode,10,0)+""
				cSQL = cSQL + ","+STR(lccSale,10,4)+""
				cSQL = cSQL + ","+STR(lccShipIns,10,4)+""
				cSQL = cSQL + ","+STR(lccTotalamt,10,4)+""
				cSQL = cSQL + ",'"+lccNotes+"'"
				cSQL = cSQL + ",'"+lccAuthNo+"'"
				cSQL = cSQL + ",'"+IIF(EMPTY(lccAuthDate),'',DTOC(lccAuthDate))+"')"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
			ENDIF
		
		
		*CASE pAction = "CANCEL"
		*	ThisFormSet.frmEO.pf1.pgCreditCard.txtSalesnum.Value	= 0
		
		CASE pAction = "INIT"
		
			PRIVATE lFoundSOCC
			lFoundSOCC = FoundCCforSO(nCCSO,ThisFormSet.nConnHandle)
			IF lFoundSOCC 
			
				IF USED('tmpCCSO')
					USE IN tmpCCSO
				ENDIF
				
				cSQL = "SELECT * FROM dbo.CreditCd WITH(NOLOCK) "
				cSQL = cSQL +" WHERE Salesnum = "+STR(ThisFormSet.SalesNum)
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL,'tmpCCSO' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCCSO' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCCSO")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCCSO")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'tmpCCSO' )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
				
				IF USED('tmpCCSO')
					m.ccSalesNum	= tmpCCSO.SalesNum
					m.ccHolderName	= tmpCCSO.CardType
					m.ccCardType	= tmpCCSO.CardType
					m.ccCardNo1		= tmpCCSO.CardNo1
					m.ccCardNo4		= tmpCCSO.CardNo4
					m.ccCCV			= tmpCCSO.CCV
					m.ccExpireDD	= tmpCCSO.ExpireDD
					m.ccExpireMM	= tmpCCSO.ExpireMM
					m.ccExpireYYYY	= tmpCCSO.ExpireYYYY
					m.ccSoldCode	= tmpCCSO.SoldCode
					ThisFormSet.ccSoldAddr = tmpCCSO.SoldCode
					m.ccSale		= tmpCCSO.Sale
					m.ccShipIns		= tmpCCSO.ShipIns
					m.ccTotalAmt	= tmpCCSO.TotalAmt
					m.ccNotes		= tmpCCSO.Notes
					m.ccAuthNo		= tmpCCSO.AuthNo
					m.ccAuthDate	= tmpCCSO.AUTHDate
		
					*Need to get rid of the ControlSource!
					ThisFormSet.frmEO.pf1.pgCreditCard.txtHolderName.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.cmbCardtype.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtSalesnum.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo1.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo4.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtCCV.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireDd.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireMm.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireYyyy.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtSoldcode.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtSale.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtShipIns.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtTotalamt.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtNotes.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthNo.REFRESH
					ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthdate.REFRESH
		
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtHolderName.Value = PrepareSQLtxt(tmpCCSO.HolderName,'HolderName',50)
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.cmbCardtype.Value = PrepareSQLtxt(tmpCCSO.CardType,'CardType',10)
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtSalesnum.Value = PrepareSQLnum(tmpCCSO.SalesNum,'SalesNum',-3)
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo1.Value = PrepareSQLtxt(tmpCCSO.
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo4.REFRESH
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtCCV.Value = PrepareSQLtxt(tmpCCSO.CCV,'CCV',4)
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireDd.REFRESH
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireMm.REFRESH
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireYyyy.REFRESH
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtSoldcode.REFRESH
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtSale.REFRESH
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtShipIns.REFRESH
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtTotalamt.Value = PrepareSQLnum(tmpCCSO.
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtNotes.Value = PrepareSQLtxt(tmpCCSO.Notes,'Notes',100)
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthNo.Value = PrepareSQLtxt(tmpCCSO.AuthNo,'AuthNo',20)
		*!*				ThisFormSet.frmEO.pf1.pgCreditCard.txtAuthdate.Value = PrepareSQLdate(tmpCCSO.AuthDate,'Authdate')
					
					USE IN tmpCCSO
				ENDIF
				
				IF NOT EMPTY(m.ccSoldCode)
					ThisFormSet.CCAddress("SHOW")
				ENDIF
				ThisFormSet.frmEO.pf1.pgCreditCard.cmdCCPrint.ENABLED = .T.
				ThisFormSet.frmEO.pf1.pgCreditCard.cmdCCEdit.CAPTION = "Edit"
			ELSE
				pAction = "CLEAN"
			ENDIF
		
		ENDCASE
		
		
		IF pAction = "CLEAN"
			ThisFormSet.ccSoldAddr = 0
			ThisFormSet.frmEO.pf1.pgCreditCard.txtSalesnum.VALUE	= 0
			ThisFormSet.frmEO.pf1.pgCreditCard.txtHolderName.VALUE= ""
			ThisFormSet.frmEO.pf1.pgCreditCard.cmbCardtype.VALUE	= ""
			ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo1.VALUE	= ""
			ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo.VALUE	= ""
			ThisFormSet.frmEO.pf1.pgCreditCard.txtCardNo4.VALUE	= ""
			ThisFormSet.frmEO.pf1.pgCreditCard.txtCCV.VALUE	= ""
			ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireDd.VALUE	= ""
			ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireMm.VALUE	= ""
			ThisFormSet.frmEO.pf1.pgCreditCard.txtExpireYyyy.VALUE	= ""
		
			ThisFormSet.frmEO.pf1.pgCreditCard.txtSale.VALUE		= NTOM(0)
			ThisFormSet.frmEO.pf1.pgCreditCard.txtShipIns.VALUE	= NTOM(0)
			ThisFormSet.frmEO.pf1.pgCreditCard.txtTotalAmt.VALUE	= NTOM(0)
			
			ThisFormSet.frmEO.pf1.pgCreditCard.txtNotes.VALUE	= ""
