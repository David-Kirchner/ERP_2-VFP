	PROCEDURE address_screen
		PARAMETER WhereWhat
		*ThisFormSet.Address_Screen()
		
		*ThisFormSet.Show_frmPo()
		*ThisFormSet.frmPO.Show_frmpo()
		
		DO CASE
		CASE WhereWhat = "OrderToEdit"
			ThisFormSet.frmEO.cmdTop.Enabled = .T.
			ThisFormSet.frmEO.cmdPrev.Enabled = .T.
			ThisFormSet.frmEO.cmdNext.Enabled = .T.
			ThisFormSet.frmEO.cmdSO_Save.Enabled = .T.
			ThisFormSet.frmEO.cmdPrintAll.Enabled = .T.
			ThisFormSet.frmEO.cmdPrintWS.Enabled = .T.
			ThisFormSet.frmEO.cmdPrintWSExt.ENABLED = .T.
			ThisFormSet.frmEO.cmdPrintSO.Enabled = .T. 
			ThisFormSet.frmEO.cmdConfirmSO.Enabled = .T.
			ThisFormSet.frmEO.cmdProforma.Enabled = .T.
			ThisFormSet.frmEO.cmdExit.Enabled = .T.
			
		*		ThisFormSet.frmEO.pf1.pgOrder.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQuote.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgValue.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgShipto.Enabled = .T.
			ThisFormSet.frmEO.pf1.pg_po.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgCreditCard.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQA.Enabled = .T.
		
			ThisFormSet.frmEO.pf1.pgQuote.cmdPrev.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmdNext.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmdP.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmdN.ENABLED = .T.
		
		CASE WhereWhat = "OrderToSave"
			ThisFormSet.frmEO.cmdTop.Enabled = .F.
			ThisFormSet.frmEO.cmdPrev.Enabled = .F.
			ThisFormSet.frmEO.cmdNext.Enabled = .F.
			ThisFormSet.frmEO.cmdSO_Save.Enabled = .F.
			ThisFormSet.frmEO.cmdPrintAll.Enabled = .F.
			ThisFormSet.frmEO.cmdPrintWS.Enabled = .F.
			ThisFormSet.frmEO.cmdPrintWSExt.ENABLED = .F.
			ThisFormSet.frmEO.cmdPrintSO.Enabled = .F. 
			ThisFormSet.frmEO.cmdConfirmSO.Enabled = .F.
			ThisFormSet.frmEO.cmdProforma.Enabled = .F.
			ThisFormSet.frmEO.cmdExit.Enabled = .F.
			
		*		ThisFormSet.frmEO.pf1.pgOrder.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgValue.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgShipto.Enabled = .F.
			ThisFormSet.frmEO.pf1.pg_po.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgCreditCard.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQA.Enabled = .F.
			
			ThisFormSet.frmEO.pf1.pgQuote.cmdPrev.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmdNext.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmdP.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmdN.ENABLED = .F.
		******
		CASE WhereWhat = "QuoteToEdit"
			ThisFormSet.frmEO.cmdTop.Enabled = .T.
			ThisFormSet.frmEO.cmdPrev.Enabled = .T.
			ThisFormSet.frmEO.cmdNext.Enabled = .T.
			ThisFormSet.frmEO.cmdSO_Save.Enabled = .T.
			ThisFormSet.frmEO.cmdPrintAll.Enabled = .T.
			ThisFormSet.frmEO.cmdPrintWS.Enabled = .T.
			ThisFormSet.frmEO.cmdPrintWSExt.ENABLED = .T.
			ThisFormSet.frmEO.cmdPrintSO.Enabled = .T. 
			ThisFormSet.frmEO.cmdConfirmSO.Enabled = .T.
			ThisFormSet.frmEO.cmdProforma.Enabled = .T.
			ThisFormSet.frmEO.cmdExit.Enabled = .T.
			
			ThisFormSet.frmEO.pf1.pgOrder.Enabled = .T.
		*		ThisFormSet.frmEO.pf1.pgQuote.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgValue.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgShipto.Enabled = .T.
			ThisFormSet.frmEO.pf1.pg_po.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgCreditCard.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQA.Enabled = .T.
		
			ThisFormSet.frmEO.pf1.pgQuote.cmdPrev.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmdNext.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmdP.ENABLED = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmdN.ENABLED = .T.
		
		CASE WhereWhat = "QuoteToSave"
			ThisFormSet.frmEO.cmdTop.Enabled = .F.
			ThisFormSet.frmEO.cmdPrev.Enabled = .F.
			ThisFormSet.frmEO.cmdNext.Enabled = .F.
			ThisFormSet.frmEO.cmdSO_Save.Enabled = .F.
			ThisFormSet.frmEO.cmdPrintAll.Enabled = .F.
			ThisFormSet.frmEO.cmdPrintWS.Enabled = .F.
			ThisFormSet.frmEO.cmdPrintWSExt.ENABLED = .F.
			ThisFormSet.frmEO.cmdPrintSO.Enabled = .F. 
			ThisFormSet.frmEO.cmdConfirmSO.Enabled = .F.
			ThisFormSet.frmEO.cmdProforma.Enabled = .F.
			ThisFormSet.frmEO.cmdExit.Enabled = .F.
			
			ThisFormSet.frmEO.pf1.pgOrder.Enabled = .F.
		*		ThisFormSet.frmEO.pf1.pgQuote.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgValue.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgShipto.Enabled = .F.
			ThisFormSet.frmEO.pf1.pg_po.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgCreditCard.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQA.Enabled = .F.
			
			ThisFormSet.frmEO.pf1.pgQuote.cmdPrev.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmdNext.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmdP.ENABLED = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmdN.ENABLED = .F.
		******
		CASE WhereWhat = "SoldToEdit" &&Caption will say EDIT
			ThisFormSet.frmEO.pf1.pgBillTo.cmdEditSoldTo.Caption = "Edit"
			ThisFormSet.frmEO.pf1.pgBillTo.txtCompany.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtAddr1.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtAddr2.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtCity.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtST.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtZip.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtCountry.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtMarketing.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtMarketing.BackColor = RGB(255,255,255)	&&White, turned Yellow if Cleared for First Add
			ThisFormSet.frmEO.pf1.pgBillTo.txtContact.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtPhone.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtFax.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.txtEmail.Enabled = .F.
			
			ThisFormSet.frmEO.pf1.pgBillTo.cmdSearchSoldTo.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.cmdIND_Type.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.cmdMarkSalesPCustomer.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.lblSaveSoldTo.Caption = ""
			
			ThisFormSet.frmEO.pf1.pgBillTo.chkQA.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkCofC.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkMercury.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkIntP.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkpPO.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkpPN.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkpHeat.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkpSpec.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkpDesc.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkpOther.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtOther.Enabled = .T.
			
			ThisFormSet.frmEO.pf1.pgBillTo.chkEmailConf.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkFaxConf.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkPrintedSO.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkShopRecvSO.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkCancelSO.Enabled = .T.
			
			ThisFormSet.frmEO.pf1.pgBillTo.txtBillInstrct.Enabled = .T.
			
			ThisFormSet.frmEO.cmdTop.Enabled = .T.
			ThisFormSet.frmEO.cmdPrev.Enabled = .T.
			ThisFormSet.frmEO.cmdNext.Enabled = .T.
			ThisFormSet.frmEO.cmdSO_Save.Enabled = .T.
			ThisFormSet.frmEO.cmdPrintAll.Enabled = .T.
			ThisFormSet.frmEO.cmdPrintWS.Enabled = .T.
			ThisFormSet.frmEO.cmdPrintWSExt.ENABLED = .T.
			ThisFormSet.frmEO.cmdPrintSO.Enabled = .T.
			ThisFormSet.frmEO.cmdConfirmSO.Enabled = .T.
			ThisFormSet.frmEO.cmdProforma.Enabled = .T.
			ThisFormSet.frmEO.cmdExit.Enabled = .T.
			
			
			ThisFormSet.frmEO.pf1.pgOrder.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQuote.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgValue.Enabled = .T.
			*ThisFormSet.frmEO.pf1.pgBillTo.Enabled
			ThisFormSet.frmEO.pf1.pgShipto.Enabled = .T.
			ThisFormSet.frmEO.pf1.pg_po.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgCreditCard.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQA.Enabled = .T.
			
			ThisFormSet.frmEO.pf1.pgBillTo.txtSoldCode.Refresh
		*		ThisFormSet.frmEO.pf1.pgBillTo.numSoldAddr.Refresh
			
		CASE WhereWhat = "SoldToSave"
			ThisFormSet.frmEO.pf1.pgBillTo.cmdEditSoldTo.Caption = "Save"
			ThisFormSet.frmEO.pf1.pgBillTo.txtCompany.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtAddr1.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtAddr2.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtCity.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtST.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtZip.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtCountry.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtMarketing.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtContact.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtPhone.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtFax.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.txtEmail.Enabled = .T.
			
			ThisFormSet.frmEO.pf1.pgBillTo.cmdSearchSoldTo.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.cmdIND_Type.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.cmdMarkSalesPCustomer.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.lblSaveSoldTo.Caption = "Address Edit Mode."
			
			ThisFormSet.frmEO.pf1.pgBillTo.chkQA.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.chkCofC.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgBillTo.chkMercury.Enabled = .F.
