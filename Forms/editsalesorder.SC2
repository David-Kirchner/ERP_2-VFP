	PROCEDURE frmWO.cmdPrintWO.Click
		
		*********************	
		ThisFormSet.SeekSalesNuminSales_No()	
		*********************
		ThisFormSet.SeekStartingStockSalesNum()	
		*********************
				
		IF USED('tmpWO_SOi')
			USE IN tmpWO_SOi
		ENDIF
		
		cSQL = "SELECT WO.EnterDate,WO.SalesRep,WO.StartDate,WO.DueDate,WO.FinishDate"
		cSQL = cSQL + " ,WO.Descript,WO.SOitem,WO.POitem "
		cSQL = cSQL + " ,WO.sPieces,WO.sAlloy,WO.sForm,WO.sCC "
		cSQL = cSQL + " ,WO.sThck,WO.sSz2,WO.sSz3 "
		cSQL = cSQL + " ,WO.sWeight,WO.sID_Detail,WO.sID_Detail_Process "
		cSQL = cSQL + " ,WOD.WO,WOD.WO_Detail "
		cSQL = cSQL + " ,WOD.fStartDate AS WODStartDate "
		cSQL = cSQL + " ,WOD.fDueDate AS WODDueDate "
		cSQL = cSQL + " ,WOD.fFinishDate AS WODFinishDate "
		cSQL = cSQL + " ,WOD.fDescript AS WODDescript"
		*,WOD.[InqNumP] "
		cSQL = cSQL + " ,WOD.fSOitem AS WODSOitem "
		cSQL = cSQL + " ,WOD.fPOitem AS WODPOitem "
		cSQL = cSQL + " ,WOD.fPieces,WOD.fAlloy,WOD.fForm,WOD.fCC "
		cSQL = cSQL + " ,WOD.fThck,WOD.fSz2,WOD.fSz3,WOD.fWeight,WOD.fID_Detail,WOD.fCmplt "
		
		cSQL = cSQL + " ,ISNULL(sPO.Company,'') AS sPOCompany "
		cSQL = cSQL + " ,ISNULL(fPO.Company,'') AS fPOCompany "
		
		cSQL = cSQL + " FROM dbo.WorkOrder WO WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WorkOrder_Detail WOD WITH(NOLOCK) ON WOD.WO = WO.WO "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder sPO WITH(NOLOCK) ON WO.POitem = sPO.POitem "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder fPO WITH(NOLOCK) ON WOD.fPOitem = fPO.POitem "
		cSQL = cSQL + " WHERE WO.SOitem = dbo.f_ProperSOitem('"+SalesQuote.SOitem_A+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOi')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOi')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_SOi')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		WAIT WINDOW "Print WorkOrder Production sheet to:" NOWAIT
		*MODIFY Report reports\WorkOrder_Production
		REPORT FORM reports\WorkOrder_Production NOCONSOLE TO PRINTER PROMPT 
		REPORT FORM reports\WorkOrder_Prod_Detail NOCONSOLE TO PRINTER PROMPT 
		
		IF USED( 'tmpWO_SOi' )
			USE IN tmpWO_SOi
		ENDIF
		*IF USED( 'Sales_No' )
		*	USE IN Sales_No
		*ENDIF
		IF USED( 'StartingStock' )
			USE IN StartingStock
		ENDIF
		
		SELECT SalesQuote
	ENDPROC

	PROCEDURE frmWO.lblChooseF_SOitem.Click
		*!*	PRIVATE nSalesNum, cSOItem
		*!*	cSOItem = PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		*!*	nSalesNum = VAL(cSoItem)
		
		*!*	PRIVATE lSelectedTheOnlySOitem
		*!*	lSelectedTheOnlySOitem = .F.
		
		*!*	IF nSalesNum = 0
		*!*		DO FORM Forms\SalesOrder_Select WITH "ChooseSO" TO nSalesNum
		*!*		IF nSalesNum > 0
		*!*			IF Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle, '') = 1
		*!*				lSelectedTheOnlySOitem = .T.		
		*!*				cSOItem = Proper_SO_item(STR(nSalesNum,7)+"-01")
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF nSalesNum > 0 AND NOT lSelectedTheOnlySOitem
		*!*		DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSOItem
		*!*	ENDIF
		
		*!*	IF VARTYPE(cSoItem) = "C"
		*!*		IF Proper_SO_item(cSoItem) = Proper_SO_item('')
		*!*			ThisForm.txtFSOitem.Value = ''
		*!*		ELSE
		*!*			ThisForm.txtFSOitem.Value = cSOItem
		*!*		ENDIF
		*!*	ELSE
		*!*		ThisForm.txtFSOitem.Value = ''
		*!*	ENDIF
	ENDPROC

