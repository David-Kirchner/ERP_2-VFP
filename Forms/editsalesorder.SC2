		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*				
		*!*			IF nSQLEXEC < 0
		*!*				IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC, '')
		*!*			ENDIF	
		*	ENDIF
		ENDIF
		
		IF SalesQuote.Inv AND SalesQuote.Services
			MESSAGEBOX("You cannot have 'Inv' and 'Service' selected on same item.",48,"Please choose only one!")
		ENDIF
		
		ThisFormset.frmEO.pf1.pgQA.spnINV.Enabled 	= SalesQuote.Inv
	ENDPROC

