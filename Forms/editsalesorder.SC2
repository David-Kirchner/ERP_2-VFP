		*	ThisFormSet.frmEO.pf1.pgQuote.txtP_Pc.Enabled = .T.
		*	ThisFormSet.frmEO.pf1.pgQuote.txtP_Ft.Enabled = .T.
		*	ThisFormSet.frmEO.pf1.pgQuote.txtLotP.Enabled = .T.
		
			ThisFormSet.frmEO.pf1.pgQuote.txtCuts.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQuote.txtOtherFld.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQuote.txtOtherP.Enabled = .T.
		
