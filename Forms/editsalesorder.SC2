	PROCEDURE frmEO.pf1.pgOrder.lblType.Click
		MESSAGEBOX("If HPA has this on StockLst it is type 'Inv'"+CHR(13);
			+"a 'Broker' is when an HPA Purchase Order is needed for the stock."+CHR(13)+CHR(13);
			+"an INCOMING Mill PO for stock is still 'Inv',"+CHR(13);
			+" but type 'Mill' is preferred to understand why shipping is not fast."+CHR(13)+CHR(13);
			+"'Production' is when you have to wait for an HPA production operation before you can ship Ordered stock."+CHR(13)+CHR(13);
			+"'Service' Order is CUSTOMERS MATERIAL using HPA Cutting, Straightening, Machining Service."+CHR(13)+CHR(13);
			+"'Conversion' Order is CUSTOMERS MATERIAL being Toll Work on HPA Production Equipment.",0+64,"Type Definition")
			
		*+" ('Inv' can be broken down further as using CG, Plasma and Waterjet cut.)"+CHR(13)+CHR(13);
		*+" (Production can be divided further by GFM, Draw, Roll and Press Checkmarks.)";
		*+" (GFM, Roll and Press Checkmarks are only needed if material still needs production.)"+CHR(13)+CHR(13);
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.txtRMA_Detail.DblClick
		PRIVATE nRMA_No, nRMA_Detail
		nRMA_Detail = PrepareSQLnum(SalesQuote.RMA_Detail,'RMA_Detail',-3)
		nRMA_No = get_RMA_from_RMA_Detail(nRMA_Detail, ThisFormSet.nConnhandle)
		
		IF nRMA_No > 0
			WAIT WINDOW "Look for a Blinking web page to review this RMA report" NOWAIT
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_RMA_No(nRMA_No,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.txtTol.Valid
		PRIVATE cTol
		cTol	= PrepareSQLtxt(This.Value,'Tol',20)
		
		*!*	PRIVATE cUpdate
		*!*	cUpdate = "UPDATE dbo.Sales SET "
		*!*	cUpdate = cUpdate + " TOL='"+cTol+"'"
		*!*	cUpdate = cUpdate + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_A+"')"
		*!*		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL'  TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQpo")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQpo")
		*!*					
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF 
		*!*	IF nSQLEXEC < 0
		*!*		IF NOT SQLEXECError(cUpdate,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
		*!*		RETURN .F.
		*!*	ELSE
			
			SELECT SalesQuote
			REPLACE TOL WITH cTOL IN SalesQuote
			*WAIT WINDOW "Saved!" NOWAIT
		*ENDIF
		
