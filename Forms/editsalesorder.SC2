	PROCEDURE frmEO.pf1.pgQA.spnDraw.LostFocus
		PRIVATE cSOitem,nGFMhrs 
		cSOitem = ThisForm.Pf1.pgQA.lblSOitem.Caption
		nGFMhrs = PrepareSQLnum(This.Value,'nGFMhrs',-2)
		
		cSQL = "UPDATE dbo.SOitem_Hrs "
		cSQL = cSQL + "SET [GFM]="+STR(nGFMhrs)
		*cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
