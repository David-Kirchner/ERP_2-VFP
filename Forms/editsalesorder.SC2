	PROCEDURE frmEO.pf1.pgQuote.cmdCancelQuote.Click
		IF This.Caption = "Quote"
			**Start the Edit
			This.Parent.cmdEditQuote.Click
		ELSE
			**Cancel the Edit -- NO SAVE
			ThisFormSet.ShowQuote("DISABLE")
			This.Caption = "Quote"
			This.Parent.CmdEditQuote.Caption = "Edit"
			This.Parent.Refresh
			ThisFormSet.isQuoteEditing = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.CmdEditQuote.Click
		IF This.Caption = "Edit"
			*edit
			PRIVATE cSOitem
			cSOitem = Proper_SO_Item(SalesQuote.SOItem_A)
		
			IF Count_SOIteminShip(cSOItem, ThisFormSet.nConnHandle, 'SHIPPED') > 0
				MESSAGEBOX("Carefull,"+CHR(13)+"some of this item has SHIPPED!",0+48,"Caution")	
			ENDIF
			IF Count_SOIteminSales(cSOItem, ThisFormSet.nConnHandle, "COMPLETE") > 0
				MESSAGEBOX("This Sales Order item is COMPLETE!"+CHR(13)+CHR(13)+"You cannot Edit!"+CHR(13)+"Unless Ship.ShipDate is empty!",0,"No Edit")	
			ELSE
				IF Is_Amendment_Allowed( ThisFormSet.SalesNum, ThisFormSet.nConnHandle)
					*IF Cncld OR Cmplt = .F.
					*IF ShopRecv = .T.
					*IF NOT ShopRecv AND lPrinted AND lChanging = .T. 
					*IF NOT ShopRecv AND lPrinted AND NOT lChanging = .F. ????
				ENDIF
				**Prepare Screen for Editing
				ThisFormSet.ShowQuote("ENABLE")
				This.Caption = "Save"
				This.Parent.cmdCancelQuote.Caption = "Cancel"
				ThisFormSet.isQuoteEditing = .T.
			ENDIF
		ELSE
			**This.Caption = "Save"
			IF ThisFormSet.SaveQuote()
			
				ThisFormSet.ShowQuote("DISABLE")
				This.Caption = "Edit"
				This.Parent.cmdCancelQuote.Caption = "Quote"
				ThisFormSet.isQuoteEditing = .F.
			ENDIF
		ENDIF
		
		*WAIT WINDOW "RECNO('SalesQuote') is "+STR(RECNO('SalesQuote')) NOWAIT
	ENDPROC

