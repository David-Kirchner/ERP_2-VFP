	PROCEDURE frmEO.pf1.pgCreditCard.cmdCCEdit.Click
		DO CASE
		CASE This.Caption = "Add New"
			ThisFormSet.ccScreen("ENABLE")
			ThisFormSet.CreditCard("NEW")
			ThisFormSet.Address_Screen("CCSoldtoSave")
			
			This.Caption = "Save"
			This.Parent.cmdCCPrint.Caption = "Cancel"
			This.Parent.cmdCCPrint.Enabled = .T.
			
		CASE This.Caption = "Edit"
			ThisFormSet.ccScreen("ENABLE")
			ThisFormSet.CreditCard("EDIT")
			ThisFormSet.Address_Screen("CCSoldtoSave")
			
			This.Caption = "Save"
			This.Parent.cmdCCPrint.Caption = "Cancel"
			This.Parent.cmdCCPrint.Enabled = .T.
		
		CASE This.Caption = "Save"
			IF ThisFormSet.CreditCard("SAVE")
				ThisFormSet.ccScreen("DISABLE")
				
				ThisFormSet.Address_Screen("CCSoldtoEdit")
				
				This.Caption = "Edit"
				This.Parent.cmdCCPrint.Caption = "Print"
		
				
				IF !EMPTY(This.Parent.txtSalesnum.Value)
					This.Parent.cmdCCPrint.Enabled = .T.
				ELSE
					This.Parent.cmdCCPrint.Enabled = .F.
				ENDIF
			ENDIF
		ENDCASE
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.cmdCCEditSoldTo.Click
		PRIVATE	nMaxSoldCode, nMaxShipCode, oldSoldCode, SaveAddr, msettalk
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit,lnSoldAddr,lcMarketing
		PRIVATE lcContact,lcPhone,lcFax,lcEmail,lcCustomer
		
		lcCompany =PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',100)
		lcAddr1 = PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',100)
		lcAddr2 = PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',100)
		lcCity  = PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',50)
		lcST    = PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'State',50)
		lcZip   = PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',12)
		lcCountry = UPPER(ALLTRIM(PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',50)))
		*lcMarketing = PrepareSQLtxt(THIS.PARENT.txtMarketing.VALUE,'Marketing',100)
		lcContact = PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',100)
		lcPhone = PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',50)
		lcFax	 = PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
		lcEmail = PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
		*lcCustomer = PrepareSQLtxt(THIS.PARENT.txtCustomerID,'CustomerID',20)
		
		ldLastEdit = DATE()
		lnSoldAddr = IIF(ThisFormSet.ccSoldAddr>0,ThisFormSet.ccSoldAddr,ThisFormSet.SoldAddr)
		
		SaveAddr = .F.
		SaveAddress = .F.
		oldSoldCode = 0
		IF THIS.CAPTION = "Save"
			** Do you have anything to save?
			IF NOT LEN(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))=0
				SaveAddress = .T.
			ENDIF
		
			IF LEN(ALLTRIM(lcCompany))=0
				MESSAGEBOX("Cannot save without an Company name!")
				SaveAddress = .F.
				RETURN .F.
			ENDIF
		
			IF USED("cntSoldCode")
				USE IN cntSoldCode
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.SoldAddr WITH(NOLOCK)"
			cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
			cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
			cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
			cSQL = cSQL + " AND City = '"+lcCity+"'"
			cSQL = cSQL + " AND ST = '"+lcST+"'"
			cSQL = cSQL + " AND Zip = '"+lcZip+"'"
			cSQL = cSQL + " AND Country = '"+lcCountry+"'"
			cSQL = cSQL + " AND Contact = '"+lcContact+"'"
			cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
			cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
			cSQL = cSQL + " AND Email = '"+lcEmail+"'"
		*	cSQL = cSQL + " AND SoldCode = "+STR(lnSoldAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntSoldCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSoldCode')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSoldCode")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSoldCode")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntSoldCode')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			IF USED("cntSoldCode")
				IF cntSoldCode.cnt = 0
					SaveAddress = .T.
				ELSE
					SaveAddress = .F.
					*Already have exact Address
		
					IF EMPTY(ThisFormSet.SoldAddr)
						*Find the SoldCode and display it
		
		*				IF aCodeUsed(1) > 0
							ThisFormSet.ccSoldAddr = lnSoldAddr
							THIS.PARENT.txtSoldCode.REFRESH
		*				ENDIF
					ELSE
						*Not changed
					ENDIF
				ENDIF
			ELSE
				SaveAddress = .F.
			ENDIF
		
			IF SaveAddress
				****** big save procedure********
				PRIVATE	cSaveNew
		
				IF lnSoldAddr > 0
					IF lnSoldAddr < 6
						*DO NOT overwrite the HPA locations!
						MESSAGEBOX( "You cannot edit the default HPA address'!"+CHR(13)+"This address will be saved as a new Address Code.",0+48,'Create new address')
						cSaveNew = 6
					ELSE
						cSaveNew = MESSAGEBOX("Use NO to save the address edits."+CHR(13)+"Use NEW address only when Company has moved."+CHR(13)+CHR(13)+"Save as new Address?",4+32,"Is this a New Address?")
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					cSaveNew = 6
				ENDIF
		
				IF cSaveNew = 6 && Yes, save as new
		
					*	Get nMaxSoldCode
					*nMaxSoldCode = ThisFormSet.maxSoldCode()
					*nMaxShipCode = ThisFormSet.maxShipCode()
					nMaxSoldCode = get_MaxSoldCode()
					nMaxShipCode = get_MaxShipCode()
					
					nMaxSoldCode = MAX( nMaxSoldCode, nMaxShipCode )
					nMaxSoldCode = nMaxSoldCode + 2 &&leave space for Shipto Edits
		
					IF ThisFormSet.SoldAddr > 0
						*	*Check old SoldCode to see if anything changed.
		*				IF NOT USED('SoldAddr')
		*					USE SoldAddr IN 0 ORDER TAG soldcode
		*				ENDIF
		*				SELECT SoldAddr
		*				IF SEEK(ThisFormSet.SoldAddr,"SoldAddr","SoldCode" )
		
						IF USED("aSoldAddr")
							USE IN aSoldAddr
						ENDIF
						
						cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK)"
						cSQL = cSQL + " WHERE SoldCode = "+STR(ThisFormSet.SoldAddr)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSoldAddr')
								RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
							ENDIF
						ENDIF
						
						IF USED('aSoldAddr')
							IF aSoldAddr.soldcode 	= ThisFormSet.ccSoldAddr AND ;
									aSoldAddr.Company 	= THIS.PARENT.txtCompany.VALUE AND ;
									aSoldAddr.Addr1		= THIS.PARENT.txtAddr1.VALUE AND ;
									aSoldAddr.Addr2		= THIS.PARENT.txtAddr2.VALUE AND ;
									aSoldAddr.City		= THIS.PARENT.txtCity.VALUE AND ;
									aSoldAddr.ST		= THIS.PARENT.txtST.VALUE AND ;
									aSoldAddr.Zip		= THIS.PARENT.txtZip.VALUE AND ;
									aSoldAddr.Country	= UPPER(ALLTRIM(THIS.PARENT.txtCountry.VALUE )) AND ;
									aSoldAddr.Contact	= THIS.PARENT.txtContact.VALUE AND ;
									aSoldAddr.Telephone	= THIS.PARENT.txtPhone.VALUE AND ;
									aSoldAddr.Fax_Number	= THIS.PARENT.txtFax.VALUE AND ;
									aSoldAddr.Email		= THIS.PARENT.txtEmail.VALUE
								*no change - do not save
							ELSE &&did not match all Fields - Save
								SaveAddr = .T.
								oldSoldCode = ThisFormSet.ccSoldAddr
							ENDIF
							
							USE IN aSoldAddr
							
						ELSE &&Seek failed - add as new
							SaveAddr = .T.
						ENDIF
					ELSE && No SoldCode just add new if have data
						IF LEN( ALLTRIM(THIS.PARENT.txtCompany.VALUE+THIS.PARENT.txtAddr1.VALUE)) > 1
							SaveAddr = .T.
						ELSE
							SaveAddr = .T.
						ENDIF
					ENDIF
		
		
					IF SaveAddr
						DO WHILE FoundSoldCode( nMaxSoldCode, ThisFormSet.nConnHandle )
							nMaxSoldCode = nMaxSoldCode + 1
						ENDDO
						
						lcMarketing = ''
						
						THIS.PARENT.txtSoldCode.VALUE = nMaxSoldCode
		*				THIS.PARENT.numSoldAddr.VALUE = nMaxSoldCode
						ThisFormSet.ccSoldAddr = nMaxSoldCode
						Save_ShipAddrCode(nMaxSoldCode, ALLTRIM(STR(nMaxSoldCode,10,0)), oldSoldCode,ThisFormSet.nConnHandle)
		
		*				INSERT INTO SoldAddr (soldcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number,Email,Customer, LastEdit ) VALUES ;
							(nMaxSoldCode, THIS.PARENT.txtCompany.VALUE, THIS.PARENT.txtAddr1.VALUE, THIS.PARENT.txtAddr2.VALUE, THIS.PARENT.txtCity.VALUE,  THIS.PARENT.txtST.VALUE, THIS.PARENT.txtZip.VALUE, THIS.PARENT.txtCountry.VALUE, THIS.PARENT.txtContact.VALUE, THIS.PARENT.txtPhone.VALUE, THIS.PARENT.txtFax.VALUE, THIS.PARENT.txtEmail.VALUE, ALLTRIM(STR(nMaxSoldCode,10,0)), DATE())
		
						cSQLi = "INSERT INTO dbo.SoldAddr (soldcode, Company, Addr1, Addr2, City, ST, Zip"
						cSQLi = cSQLi+", Country, Marketing, Contact, Telephone, Fax_Number,Email,Customer, LastEdit ) VALUES ("
						cSQLi = cSQLi + STR(nMaxSoldCode)
						cSQLi = cSQLi+",'"+lcCompany+"'"
						cSQLi = cSQLi+",'"+lcAddr1+"'"
						cSQLi = cSQLi+",'"+lcAddr2+"'"
						cSQLi = cSQLi+",'"+lcCity+"'"
						cSQLi = cSQLi+",'"+lcST+"'"
						cSQLi = cSQLi+",'"+lcZip+"'"
						cSQLi = cSQLi+",'"+lcCountry+"'"
						cSQLi = cSQLi+",'"+lcMarketing+"'"
						cSQLi = cSQLi+",'"+lcContact+"'"
						cSQLi = cSQLi+",'"+lcPhone+"'"
						cSQLi = cSQLi+",'"+lcFax+"'"
						cSQLi = cSQLi+",'"+lcEmail+"'"
						cSQLi = cSQLi + ",''"		&&+ALLTRIM(STR(nMaxSoldCode,10,0))+""
						cSQLi = cSQLi + ",'"+DTOC(DATE())+"')"
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQLi, ThisFormSet.nConnHandle, nSQLEXEC, '')
								RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLi )
								RETURN
							ENDIF
						ENDIF
		
		
						ThisFormSet.UpdateCustID = .T.
		
						THIS.PARENT.txtLastEdit.VALUE = DATE()
						THIS.PARENT.txtLastEdit.REFRESH
		
					ENDIF
				ELSE
					*Save - not as new!
					*REPLACE DATA
					
					lcMarketing = ''
					
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.SoldAddr SET "
					cSQLu= cSQLu+" Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					*cSQLu= cSQLu+",Marketing='"+lcMarketing+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
		*			cSQLu= cSQLu+",Customer="+ALLTRIM(STR(useShipCode,10,0))+""
					cSQLu = cSQLu + ",LastEdit='"+DTOC(DATE())+"'"
					cSQLu = cSQLu + " WHERE SoldCode = "+STR(lnSoldAddr)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLu )
							RETURN
						ENDIF
					ENDIF
					*	ThisFormSet.UpdateCustID = .T.
		
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
		
				ENDIF
			ENDIF
		
			ThisFormSet.Address_Screen("CCAddrToEdit")
		*	ThisFormSet.cmdNext.SETFOCUS()
		
		ELSE &&Caption was Edit
			ThisFormSet.Address_Screen("CCAddrToSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.cmdCCPrint.Click
		IF THIS.CAPTION = "Print"
			
			**********************
			IF NOT ThisFormSet.SeekccSoldCodeinSoldAddr(ThisFormSet.ccSoldAddr)
				MESSAGEBOX("No or bad Credit Card 'Sold To' Address",0+16,"Could not get Address loaded.")
			ENDIF
			IF NOT USED( 'ccSoldAddr' )
				TrackError("Could not load 'ccSoldAddr'","Print CC",PROGRAM(),LINENO(1) )
				RETURN .F.
			ENDIF
			**********************
			IF NOT ThisFormSet.SeekSoldCodeinSoldAddr(ThisFormSet.SoldAddr)
				MESSAGEBOX("No or bad 'Sold To Address'",0+16,"Could not get Address loaded.")
			ENDIF
			IF NOT USED( 'SoldAddr' )
				TrackError("Could not load 'SoldAddr'","Print CC",PROGRAM(),LINENO(1) )
				RETURN .F.
			ENDIF
			*********************	
			IF NOT ThisFormSet.SeekShipCodeinShipAddr(ThisFormSet.ShipAddr)
				MESSAGEBOX("No or bad 'Ship To Address'",0+16,"Could not get Address loaded.")
			ENDIF
			IF NOT USED( 'ShipAddr' )
				TrackError("Could not load 'ShipAddr'","Print CC",PROGRAM(),LINENO(1) )
				RETURN .F.
			ENDIF
			*********************	
			*ThisFormSet.SeekSalesNuminSales_No()	
			IF NOT USED( 'Sales_No' )
				TrackError("Could not load 'Sales_No'","Print CC",PROGRAM(),LINENO(1) )
				RETURN .F.
			ENDIF
			**********************
			
			IF NOT ThisFormSet.SeekSalesNuminCreditCd()
				MESSAGEBOX("No or bad 'CreditCard record.'",0+16,"Could not get CreditCd loaded.")
			ENDIF
			IF NOT USED( 'CreditCd' )
				TrackError("Could not load 'CreditCd'","Print CC",PROGRAM(),LINENO(1) )
				RETURN .F.
			ENDIF
			
			
			SELECT CreditCd
		*	ThisForm.AlwaysOnBottom = .T.
		*	ThisForm.AlwaysOnTop = .F.
				
			IF NOT "PrintPreview" $ SET("CLASSLIB")  &&Added for when Quotes is run without ERP menu.
				SET CLASSLIB TO Libs\PrintPreview ADDITIVE
			ENDIF
			oPForm = CREATEOBJECT('PrintPreview')
			oPform.Visible = .T.    && open PrintPreview form	
				
			IF !EMPTY(ThisFormSet.SalesNum)
				cNotSaved = ALLTRIM(This.Parent.txtCardno.Value)
				IF FILE("Reports\CreditInfo.Frx")
					*REPORT FORM Reports\CreditInfo PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview FOR CreditCd.SalesNum = ThisFormSet.SalesNum 
					REPORT FORM Reports\CreditInfo PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview FOR CreditCd.SalesNum = ThisFormSet.SalesNum TO PRINTER PROMPT
				ELSE &&NOCONSOLE 
					IF FILE("\Reports\CreditInfo.Frx")
						*REPORT FORM \Reports\CreditInfo PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview FOR CreditCd.SalesNum = ThisFormSet.SalesNum 
						REPORT FORM \Reports\CreditInfo PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview FOR CreditCd.SalesNum = ThisFormSet.SalesNum TO PRINTER PROMPT
					ELSE
						IF FILE("Quotes\Reports\CreditInfo.Frx")
							*REPORT FORM Quotes\Reports\CreditInfo PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview FOR CreditCd.SalesNum = ThisFormSet.SalesNum
							REPORT FORM Quotes\Reports\CreditInfo PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview FOR CreditCd.SalesNum = ThisFormSet.SalesNum TO PRINTER PROMPT
						ELSE
							MESSAGEBOX("REPORT FROM CreditInfo NOT FOUND",0,"Cannot Print")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			IF VARTYPE(oPform) = "O"
				oPform.Visible = .F.
				RELEASE ALL LIKE oPform
			ENDIF
			IF "PrintPreview" $ SET("CLASSLIB")  &&Added for when Quotes is run without ERP menu.
				RELEASE CLASSLIB PrintPreview 
			ENDIF
			
			**record CreditCd as Printed and TrackMess
			ThisFormSet.CreditCard("PRINTED")
			
			
		*	ThisForm.AlwaysOnBottom = .F.
		*	ThisForm.AlwaysOnTop = .T.
		ENDIF
		
		IF THIS.CAPTION = "Cancel"
			ThisFormSet.ccScreen("DISABLE")
		
			ThisFormSet.Address_Screen("CCSoldtoEdit")
			
			ThisFormSet.CreditCard("INIT")
					
			THIS.CAPTION = "Print"
			THIS.PARENT.cmdCCEdit.CAPTION = "Edit"
			IF !EMPTY(ThisFormSet.SalesNum)
				THIS.ENABLED = .T.
			ELSE
				THIS.ENABLED = .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.cmdCCSearchSoldTo.Click
		Private matchCodes, nNewccSoldToCode , lcCurrTable 
		nNewccSoldToCode = 0
		matchCodes = 0
		
		lcCurrTable = ALIAS()
		
		
		PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.F.
		ENDIF
		lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.F.
		ENDIF
		
		DO FORM Forms\SearchForm WITH "SoldAddr", SalesQuote.company  TO nNewccSoldToCode 
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.T.
		ENDIF
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.T.
		ENDIF
		
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT LEN(ALLTRIM(lcCurrTable))=0
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		EndIF
		
		IF nNewccSoldToCode > 0
			IF USED( 'aSoldAddr' )
				USE IN aSoldAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK)"
			cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(nNewccSoldToCode )
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSoldAddr')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			IF USED( 'aSoldAddr' )
				ThisFormSet.ccSoldAddr = aSoldAddr.SoldCode
				This.Parent.txtSoldCode.Value = aSoldAddr.SoldCode
		*		This.Parent.numSoldAddr.Value = aSoldAddr.SoldCode
				This.Parent.txtCompany.Value = aSoldAddr.Company
				This.Parent.txtAddr1.Value = aSoldAddr.Addr1
				This.Parent.txtAddr2.Value = aSoldAddr.Addr2
				This.Parent.txtCity.Value = aSoldAddr.City
				This.Parent.txtST.Value = aSoldAddr.ST
				This.Parent.txtZip.Value = aSoldAddr.Zip
				This.Parent.txtCountry.Value = UPPER(ALLTRIM(aSoldAddr.Country))
				This.Parent.txtContact.Value = aSoldAddr.Contact
				This.Parent.txtPhone.Value = aSoldAddr.TelePhone
				This.Parent.txtFax.Value = aSoldAddr.Fax_Number
				This.Parent.txtEmail.Value = aSoldAddr.Email
				This.Parent.txtLastEdit.Value = PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')
				
				ThisFormSet.Address_Screen("CCSoldtoEdit")
				
				USE IN aSoldAddr
			EndIf
		
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		
		IF ThisFormSet.ccSoldAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6
			IF ThisFormSet.ccSoldAddr <> 0
			
				ThisFormSet.ccSoldAddr = 0
				THIS.PARENT.txtSoldCode.VALUE = 0
		
				ThisFormSet.Address_Screen("ccSoldToSave")
			ENDIF
		
			THIS.PARENT.cmdCCSearchSoldTo.ENABLED = .T.
		
			THIS.PARENT.txtCompany.VALUE	= ""
			THIS.PARENT.txtAddr1.VALUE		= ""
			THIS.PARENT.txtAddr2.VALUE		= ""
			THIS.PARENT.txtCity.VALUE		= ""
			THIS.PARENT.txtST.VALUE			= ""
			THIS.PARENT.txtZip.VALUE		= ""
			THIS.PARENT.txtCountry.VALUE	= ""
			*HIS.PARENT.txtM
			THIS.PARENT.txtContact.VALUE	= ""
			THIS.PARENT.txtPhone.VALUE		= ""
			THIS.PARENT.txtFax.VALUE		= ""
			THIS.PARENT.txtEmail.VALUE		= ""
			THIS.PARENT.txtLastEdit.VALUE	= ""
		ELSE
			IF THIS.PARENT.cmdCCEditSoldTo.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
					IF USED( 'aSoldAddr' )
						USE IN aSoldAddr
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK)"
					cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(ThisFormSet.ccSoldAddr)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSoldAddr')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
							RETURN
						ENDIF
					ENDIF
					IF USED( 'aSoldAddr' )
						ThisFormSet.ccSoldAddr = aSoldAddr.SoldCode
						THIS.PARENT.txtSoldCode.VALUE = aSoldAddr.SoldCode
						THIS.PARENT.txtCompany.VALUE = aSoldAddr.Company
						THIS.PARENT.txtAddr1.VALUE = aSoldAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE = aSoldAddr.Addr2
						THIS.PARENT.txtCity.VALUE = aSoldAddr.City
						THIS.PARENT.txtST.VALUE = aSoldAddr.ST
						THIS.PARENT.txtZip.VALUE = aSoldAddr.Zip
						THIS.PARENT.txtCountry.VALUE = UPPER(ALLTRIM(aSoldAddr.Country))
						*THIS.Parent.txtM
						THIS.PARENT.txtContact.VALUE = aSoldAddr.Contact
						THIS.PARENT.txtPhone.VALUE = aSoldAddr.TelePhone
						THIS.PARENT.txtFax.VALUE = aSoldAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE = aSoldAddr.Email
						THIS.PARENT.txtLastEdit.VALUE = PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')
						
						USE IN aSoldAddr
					ENDIF
		
					ThisFormSet.Address_Screen("ccSoldToEdit")
		
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.Init
		m.ccSalesNum	= 0
		m.ccHolderName	= ""
		m.ccCardType	= ""
		m.ccCardNo1		= ""
		m.ccCardNo4		= ""
		m.ccCCV	= ""
		m.ccExpireDd	= ""
		m.ccExpireMm	= ""
		m.ccExpireYyyy	= ""
		m.ccSoldCode	= 0
		m.ccSale		= 0
		m.ccShipIns		= 0
		m.ccTotalAmt	= 0
		m.ccAuthNo		= ""
		m.ccAuthDate	= CTOD("  /  /  ")
		
		PUBLIC gaCCtype(1)
		gaCCtype(1) = ""
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.lblAuthdate.Click
		IF This.Parent.cmdCCEdit.Caption = "Save"
			PRIVATE m.dDate1,m.dDate2
		
			m.dDate1 = This.Parent.txtAuthDate.Value
			
			
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
		
			DO FORM "forms\OleCalendar.scx" WITH m.dDate1 TO m.dDate2
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		
			This.Parent.txtAuthDate.Value = m.dDate2
		*	SELECT SalesQuote
		*	REPLACE AuthDate WITH m.dDate2 IN SalesQuote
			
			This.Parent.txtAuthDate.Refresh
			This.Parent.txtAuthDate.SetFocus
		
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.lblControln.Click
		MESSAGEBOX("The CVV Number ('Card Verification Value') on your credit card or debit card is a 3 digit number on VISA, MasterCard and Discover branded credit and debit cards. On your American Express branded credit or debit card it is a 4 digit numeric code.",64,"CCV is empty!")
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.lblExpire.Click
		IF This.Parent.cmdCCEdit.Caption = "Save"
			PRIVATE m.dDate1,m.dDate2
		
			m.dDate1 = Date()
			
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
		
			DO FORM "forms\OleCalendar.scx" WITH m.dDate1 TO m.dDate2
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		
			IF VARTYPE(m.dDate2)= "D"
				This.Parent.txtExpireDd.Value = STR(DAY(m.dDate2))
				This.Parent.txtExpireMm.Value = STR(MONTH(m.dDate2))
				This.Parent.txtExpireYyyy.Value = STR(YEAR(m.dDate2))
				This.Parent.txtSale.SetFocus
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.lblSale.Click
		IF This.Parent.cmdCCEdit.Caption = "Save"
			This.Parent.txtSale.Value = PrepareSQLnum( This.Parent.Parent.pgValue.nSale.Value ,'Sale',10,2)
			This.Parent.txtSale.Refresh
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.lblTotalamt.Click
		IF This.Parent.cmdCCEdit.Caption = "Save"
			This.Parent.txtTotalAmt.Value = PrepareSQLnum( This.Parent.Parent.pgValue.nSale.Value ,'Sale',10,2)
			This.Parent.txtTotalAmt.Refresh
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.txtCardNo.Valid
		RETURN ThisFormSet.CheckCC("MIDDLE")
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.txtCardno1.Valid
		RETURN ThisFormSet.CheckCC("FIRST")
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.txtCardno4.Valid
		RETURN ThisFormSet.CheckCC("LAST")
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.txtCompany.GotFocus
		IF LEN(ALLTRIM(This.Value))=0 AND This.Parent.cmdCCEditSoldTo.Caption = "Save"
			This.Value = SalesQuote.Company
			
			IF LEN(ALLTRIM(This.Parent.txtContact.Value))=0
				This.Parent.txtContact.Value = SalesQuote.name
			ENDIF
			IF LEN(ALLTRIM(This.Parent.txtPhone.Value))=0
				This.Parent.txtPhone.Value = SalesQuote.Phone+SalesQuote.Phone_ext
			ENDIF
			IF LEN(ALLTRIM(This.Parent.txtFax.Value))=0
				This.Parent.txtFax.Value = SalesQuote.Fax
			ENDIF
			IF LEN(ALLTRIM(This.Parent.txtEmail.Value))=0
				This.Parent.txtEmail.Value = SalesQuote.Email
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.txtExpireDd.Valid
		PRIVATE nVal
		IF VARTYPE(This.Value) = 'C'
			nVal = VAL(This.Value)
		ELSE
			nVal = This.Value
		ENDIF
		
		IF nVal < 0 OR nVal > 31
			MESSAGEBOX("Date can be only 1 to 31")
			This.Value = .NULL.
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.txtExpireMm.Valid
		PRIVATE nVal
		IF VARTYPE(This.Value) = 'C'
			nVal = VAL(This.Value)
		ELSE
			nVal = This.Value
		ENDIF
		
		IF nVal < 0 OR nVal > 12
			MESSAGEBOX("Month can be only 1 to 12")
			This.Value = .null.
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.txtExpireYYYY.Valid
		PRIVATE nVal
		
		IF VARTYPE(This.Value) = 'C'
			nVal = VAL(This.Value)
		ELSE
			nVal = This.Value
		ENDIF
		
		DO CASE
		CASE nVal < 1
			This.Value = .null.
		CASE nVal < 100 
			This.Value = 2000 + nVal
		CASE nVal < YEAR(DATE())
			MESSAGEBOX("Bad Year",0+48,"Past Due")
		*CASE nVal > 2000 AND nVal < YEAR(DATE())
		*	MESSAGEBOX("Bad Year",0+48,"Past Due")
		ENDCASE
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgCreditCard.txtHolderName.When
		IF LEN(ALLTRIM(This.Value))=0 AND This.Parent.cmdCCEdit.Caption = "Save"
			This.Value = SalesQuote.Name
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.Check1.Click
		PRIVATE lCancel
		lCancel = .T.
		PRIVATE cSOitem, nSalesNum
		cSOitem = SalesQuote.SoItem_A
		nSalesNum = ThisFormSet.SalesNum
		
		*Test Routine
		
			
		PRIVATE nWO, nWOD, cMess
		nWO = 0
		nWOD = 0
		
		IF lCancel
			********************************
			*Still in Cancel mode
			*
			*Cancel SO Item
			IF Cancel_SOitem( cSOitem, .T., ThisFormSet.nConnHandle )  && .T. to Amend
				*now marks PrintedSO as 0  -still need new amendment
				*Calls: Amend_Sales_No_Ver()
				*Calls: Is_SOitem_OnHold()
				******************
				*Remove SOitem from WO
				PRIVATE nCntWO
				nCntWO = 0
		
				IF USED('tmpWOp')
					USE IN tmpWOp
				ENDIF
				
				cSQL = "SELECT WO, cncld FROM dbo.WorkOrder WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				*cSQL = cSQL + " AND [cncld] = 0"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOp")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOp' )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
				IF USED('tmpWOp')
					IF RECCOUNT('tmpWOp') > 0
						SCAN
					
							nWO = PrepareSQLnum(tmpWOp.WO,'WO',-3)
							IF nWO > 0				
								cSQL = "UPDATE dbo.WorkOrder SET SOitem = '' "
								cSQL = cSQL + " WHERE WO = "+STR(nWO)
								
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
											
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '' )
										RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
									ENDIF
								ENDIF
								
								cMess = "Cancelled SOitem '"+cSOitem+"' and removed SOitem from WO "+STR(nWO)
								TrackMess(cMess)
							ENDIF
						ENDSCAN
						
					ENDIF
					USE IN tmpWOp
				ENDIF
		
		
				***********************
				*Remove WO_Detail from SOitem
				
				PRIVATE nCntWOD
				nCntWOD = 0
		
				IF USED('tmpWODp')
					USE IN tmpWODp
				ENDIF
				
				cSQL = "SELECT WO_Detail, fCmplt FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
				cSQL = cSQL + " WHERE fSOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				*cSQL = cSQL + " AND [fCmplt] = 0"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWODp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWODp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWODp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWODp")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWODp' )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
				IF USED('tmpWODp')
					IF RECCOUNT('tmpWODp') > 0
						SCAN			
							nWOD = PrepareSQLnum(tmpWODp.WO_Detail,'WO_Detail',-3)
							
							cSQL = "UPDATE dbo.WorkOrder_Detail SET fSOitem = '' "
							cSQL = cSQL + " WHERE WO_Detail = "+STR(nWOD)
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
										
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '' )
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								ENDIF
							ENDIF
							
							cMess = "Cancelled SOitem '"+cSOitem+"' and removed SOitem from WO_Detail "+STR(nWOD)
							TrackMess(cMess)
		
						ENDSCAN
					ENDIF
					USE IN tmpWODp
				ENDIF
		
				************************************
				SELECT SalesQuote
				PRIVATE nCurrSalesNumRec 
				nCurrSalesNumRec = RECNO('SalesQuote')
				
				SELECT SalesTotal
				UPDATE SalesTotal SET Cncld = .T. WHERE Item = SalesTotal.item
				
				*****
				IF Count_SOIteminSales(cSOItem, ThisFormSet.nConnHandle, "NOTCANCEL") = 0
					*All are Cancelled
					IF NOT PrepareSQLLogic(This.parent.parent.pgBillTo.chkCancelSO.Value,'Cancel SO')
						
						SELECT Sales_No	&&Sales_No does not have items details
						REPLACE Cncld  WITH .T. IN Sales_No
						This.parent.parent.pgBillTo.chkCancelSO.Refresh
						
					ENDIF
				ENDIF
				
				************************************
				*Cancel_SOitem Increase the Amendment or Ver num!!
				*cSQL = "SELECT Amendment FROM  WHERE SalesNum = "+STR(nSO)
				nAmendment = Get_Amendment_Sales_No (nSalesNum, ThisFormSet.nConnHandle)
				
				SELECT Sales_No	
				*REPLACE Cncld  WITH .F. IN Sales_No
				
				REPLACE Amendment WITH nAmendment IN Sales_No
				ThisFormSet.nAmendment = nAmendment 
				ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value = nAmendment 
				
				REPLACE ShopRecv WITH .F. IN Sales_No
				ThisFormSet.lShopRecvSO = .F.
				ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
				ThisFormSet.frmEO.pf1.pgQA.chkShopRecv.Value		= ThisFormSet.lShopRecvSO
				
				
				This.Parent.Parent.pgOrder.chkCancelItem.Refresh
				
				************************************
				SELECT SalesQuote
				REPLACE Cncld WITH .T. IN SalesQuote
				
				SELECT SalesQuote
				GOTO (nCurrSalesNumRec)
				
			
				************************************		
				ThisFormSet.Set_Sales_No_Chng()
				
				
				*MESSAGEBOX( "You must click 'SAVE' to make this 'SO Item' change permanent."+CHR(13)+"All other tables have been updated!",0+64,"Remember to click Save.")			
				MESSAGEBOX("The Sales Order has changed and needs to be printed."+CHR(13)+"Per ISO, HPA needs the paper trail of this cancel!",0+64,"Remember to Print.")			
			ENDIF
			*end cancel mode
		
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.chkBRK.Valid
		IF ThisFormSet.CheckSpinnerTYP('chkBRK', This.Value)
			REPLACE [BRK] WITH PrepareSQLlogic(This.Value,'BRK',.F.) IN SalesQuote
			IF This.Value
				REPLACE [Typ] WITH 'B' IN SalesQuote
			ENDIF
		ELSE
			This.Value = !This.Value
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.chkCancelItem.Click
		PRIVATE lCancel
		lCancel = PrepareSQLlogic( This.Value, 'Cancel',.F.)
		
		PRIVATE cSOitem, nSalesNum
		cSOitem = SalesQuote.SoItem_A
		nSalesNum = ThisFormSet.SalesNum
		
		PRIVATE nMess
		IF lCancel 
			nMess = MESSAGEBOX("Are you sure you want to Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Cancel?")
			IF nMess != 6
				RETURN .F.
			ENDIF
		ELSE
			nMess = MESSAGEBOX("Are you sure you want to UN Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"UN Cancel?")
			IF nMess != 6
				RETURN .F.
			ENDIF
		ENDIF
		
		******************************************
		*Check to see if Invoiced
		IF SO_Invoiced( nSalesNum, ThisFormSet.nConnHandle )
			MESSAGEBOX("Cannot change this SO!"+CHR(13)+"SO has been Invoiced.",32,"Cannot Cancel?") 
			RETURN .F.
		ENDIF
		
		******************************************
		*Check to see if has been Processed!
		IF SOitem_PRCD( cSOitem, ThisFormSet.nConnHandle )
			MESSAGEBOX("Cannot change this SO!"+CHR(13)+"SO item has a Process History Recorded.",32,"Cannot Cancel?") 
			RETURN .F.
		ENDIF
		
		*IF SO_Complete(nSalesNum, ThisFormSet.nConnHandle) 
		
		**********************
		*IF lCancel 	
			*MESSAGEBOX("You are allowed to Cancel SOitem:"+ALLTRIM(cSOitem)+" ",4+32,"Cancel?")
		*	WAIT WINDOW "You are allowed to Cancel SOitem:"+ALLTRIM(cSOitem) NOWAIT
		*ENDIF
		
		PRIVATE nMess
		*********************
		IF lCancel 
			*Check for Allow PO Cancel AND then Cancel POitem
			PRIVATE nCntPOitem 
			nCntPOitem = 0
		
		*	nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnHandle )
			IF USED('tmpPOp')
				USE IN tmpPOp
			ENDIF
			
			cSQL = "SELECT PoItem, Reconciled, [cancelled] "
			cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			*cSQL = cSQL + " AND [cancelled] = 0"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOp')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOp' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOp")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOp")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOp' )
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('tmpPOp')
				IF RECCOUNT('tmpPOp') > 0
					SCAN
						
						cPOitem = tmpPOp.POitem
						IF NOT PrepareSQLlogic(tmpPOp.Reconciled,'Reconciled',.F.)
						
							IF NOT PrepareSQLlogic(tmpPOp.Cancelled,'Cancelled',.F.)
								
								nMess = MESSAGEBOX("Do you want to Cancel this POitem? "+cPOitem+" was to be used for this SOitem",4+32,"Cancel POitem?") 
								IF nMess = 6
									lOK = PurchaseOrder_Allow_Cancel(cPOitem,ThisFormSet.nConnHandle)
									IF lOK
										lOK = PurchaseOrder_POitem_Cancel(cPOitem, ThisFormSet.nConnHandle, .F.)
									ENDIF
								ELSE
									PO_Item_Notes(cPOitem,"EditSalesOrder:chkCancelItem Cancelled SOitem='"+cSOitem+"' and user choose not to Cancel POitem='"+cPOitem+"'")
									TrackMess("EditSalesOrder:chkCancelItem Cancelled SOitem='"+cSOitem+"' and user choose not to Cancel POitem='"+cPOitem+"'")
								ENDIF		
							ENDIF
						ENDIF
									
					ENDSCAN
					
				ENDIF
				USE IN tmpPOp
			ENDIF
		ENDIF
		
		*End checks
		***********************
		*Run Cancel or Uncancel code
		*
		*
			
		PRIVATE nWO, nWOD, cMess
		nWO = 0
		nWOD = 0
		
		IF lCancel
			********************************
			*Still in Cancel mode
			*
			*Cancel SO Item **SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
			IF Cancel_SOitem( cSOitem, .T., ThisFormSet.nConnHandle )  && .T. to Amend
				*now marks PrintedSO as 0  -still need new amendment
				*Calls: Amend_Sales_No_Ver()
				*Calls: Is_SOitem_OnHold()
				******************
				*Remove SOitem from WO
				PRIVATE nCntWO
				nCntWO = 0
		
				IF USED('tmpWOp')
					USE IN tmpWOp
				ENDIF
				
				cSQL = "SELECT WO, cncld FROM dbo.WorkOrder WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				*cSQL = cSQL + " AND [cncld] = 0"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOp")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOp' )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
				IF USED('tmpWOp')
					IF RECCOUNT('tmpWOp') > 0
						SCAN
					
							nWO = PrepareSQLnum(tmpWOp.WO,'WO',-3)
							IF nWO > 0				
								cSQL = "UPDATE dbo.WorkOrder SET SOitem = '' "
								cSQL = cSQL + " WHERE WO = "+STR(nWO)
								
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
											
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '' )
										RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
									ENDIF
								ENDIF
								
								cMess = "Cancelled SOitem '"+cSOitem+"' and removed SOitem from WO "+STR(nWO)
								TrackMess(cMess)
							ENDIF
						ENDSCAN
						
					ENDIF
					USE IN tmpWOp
				ENDIF
		
		
				***********************
				*Remove WO_Detail from SOitem
				
				PRIVATE nCntWOD
				nCntWOD = 0
		
				IF USED('tmpWODp')
					USE IN tmpWODp
				ENDIF
				
				cSQL = "SELECT WO_Detail, fCmplt FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
				cSQL = cSQL + " WHERE fSOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				*cSQL = cSQL + " AND [fCmplt] = 0"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWODp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWODp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWODp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWODp")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWODp' )
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
				IF USED('tmpWODp')
					IF RECCOUNT('tmpWODp') > 0
						SCAN			
							nWOD = PrepareSQLnum(tmpWODp.WO_Detail,'WO_Detail',-3)
							
							cSQL = "UPDATE dbo.WorkOrder_Detail SET fSOitem = '' "
							cSQL = cSQL + " WHERE WO_Detail = "+STR(nWOD)
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
										
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '' )
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								ENDIF
							ENDIF
							
							cMess = "Cancelled SOitem '"+cSOitem+"' and removed SOitem from WO_Detail "+STR(nWOD)
							TrackMess(cMess)
		
						ENDSCAN
					ENDIF
					USE IN tmpWODp
				ENDIF
		
				************************************
				SELECT SalesQuote
				PRIVATE nCurrSalesNumRec 
				nCurrSalesNumRec = RECNO('SalesQuote')
				
				SELECT SalesTotal
				UPDATE SalesTotal SET Cncld = .T. WHERE Item = SalesTotal.item
				
				*****
				IF Count_SOIteminSales(cSOItem, ThisFormSet.nConnHandle, "NOTCANCEL") = 0
					*All are Cancelled
					IF NOT PrepareSQLLogic(This.parent.parent.pgBillTo.chkCancelSO.Value,'Cancel SO')
						
						SELECT Sales_No	&&Sales_No does not have items details
						REPLACE Cncld  WITH .T. IN Sales_No
						This.parent.parent.pgBillTo.chkCancelSO.Refresh
						
					ENDIF
				ENDIF
				
				************************************
				*Cancel_SOitem Increase the Amendment or Ver num!!
				*cSQL = "SELECT Amendment FROM  WHERE SalesNum = "+STR(nSO)
				nAmendment = Get_Amendment_Sales_No (nSalesNum, ThisFormSet.nConnHandle)
				
				SELECT Sales_No	
				*REPLACE Cncld  WITH .F. IN Sales_No
				
				REPLACE Amendment WITH nAmendment IN Sales_No
				ThisFormSet.nAmendment = nAmendment 
				ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value = nAmendment 
				
				REPLACE ShopRecv WITH .F. IN Sales_No
				ThisFormSet.lShopRecvSO = .F.
				ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
				ThisFormSet.frmEO.pf1.pgQA.chkShopRecv.Value		= ThisFormSet.lShopRecvSO
				
				
				This.Parent.Parent.pgOrder.chkCancelItem.Refresh
				
				************************************
				SELECT SalesQuote
				REPLACE Cncld WITH .T. IN SalesQuote
				
				SELECT SalesQuote
				GOTO (nCurrSalesNumRec)
				
			
				************************************		
				ThisFormSet.Set_Sales_No_Chng()
				
				
				*MESSAGEBOX( "You must click 'SAVE' to make this 'SO Item' change permanent."+CHR(13)+"All other tables have been updated!",0+64,"Remember to click Save.")			
				MESSAGEBOX("The Sales Order has changed and needs to be printed."+CHR(13)+"Per ISO, HPA needs the paper trail of this cancel!",0+64,"Remember to Print.")			
				
				TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been marked as 'Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
				*send to messenger
				IF nWO > 0 OR nWOD > 0
					 IF nWO > 0
					 	TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been removed ("+DTOC(DATE())+")" +" from WO="+ALLTRIM(STR(nWO)) )
					 ENDIF
					 IF nWOD > 0
					 	TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been removed ("+DTOC(DATE())+")" +" from WO_Detail="+ALLTRIM(STR(nWOD)) )
					 ENDIF
				ENDIF
			ENDIF
		
			*end cancel mode
		ELSE
			*uncancel -------------------------------
			
			*UNCancel SO Item
			IF UNCancel_SOitem( cSOitem, .T., ThisFormSet.nConnHandle ) && .T. to Amend
				
				SELECT SalesQuote
				PRIVATE nCurrSalesNumRec 
				nCurrSalesNumRec = RECNO('SalesQuote')
				
				SELECT SalesTotal
				UPDATE SalesTotal SET Cncld = .F. WHERE Item = SalesTotal.item
				
				**********************
				SELECT SalesQuote
				REPLACE Cncld WITH .F. IN SalesQuote
				
				SELECT SalesQuote
				GOTO (nCurrSalesNumRec)
				
				ThisFormSet.Set_Sales_No_Chng()
		
				TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
			ENDIF
		ENDIF
		
		
		
	ENDPROC

