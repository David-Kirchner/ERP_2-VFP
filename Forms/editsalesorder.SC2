	ENDPROC

	PROCEDURE frmEO.pf1.pgValue.pfPrice.pgSOd.txtPercent.Valid
		
		PRIVATE nPercent, nStockLst_QTY, nQTY, cSOitem 
		nPercent		= PrepareSQLnum(This.Value,'Percent',2,0)
		
		IF nPercent < 1
			nPercent = PrepareSQLnum(This.Value,'Percent',4,3)
		ELSE
			IF nPercent <= 100
				*Good Percent
				nPercent = nPercent/100
				This.Value = nPercent
			ENDIF
		ENDIF
		
		*nStockLst_QTY	= PrepareSQLnum(This.parent.parent.pgPODesc.txtStockLst_QTY.VALUE,'StockLst_QTY',-5)
		
		*cSOitem = PrepareSQLtxt(this.Parent.txtSOitem.Value,'SOitem',10)
		*nStockLst_QTY	= getSales_Quoted_QTY(cSOitem,ThisFormSet.nConnHandle)
		
		PRIVATE nSO_QTY, nDist_QTY
		nSO_QTY = PrepareSQLnum(This.Parent.txtSO_QTY.Value,'SO_QTY',-5)
		nDist_QTY = PrepareSQLnum(This.Parent.txtDist_QTY.Value,'Dist_QTY',-5)
		
		nQTY = 0
		
		IF nSO_QTY > 0
			IF nPercent > 0
				nQTY = 	ROUND( nSO_QTY * nPercent ,0)
				IF nQTY > 0
					This.Parent.txtQTY.Value = nQTY
				ENDIF
			ENDIF
		ENDIF	
	ENDPROC

	PROCEDURE frmEO.pf1.pgValue.pfPrice.pgSOd.txtQTY.Valid
		PRIVATE nQTY, nSO_QTY, nDist_QTY
		nQTY	= PrepareSQLnum(This.Value,'QTY',-5)
		nSO_QTY	= PrepareSQLnum(This.Parent.txtSO_QTY.Value,'SO_QTY',-5)
		nDist_QTY = PrepareSQLnum(This.Parent.txtDist_QTY.Value,'Dist_QTY',-5)
		
		IF (nQTY+10)*1.15 > (nSO_QTY+10)*1.15
			MESSAGEBOX("You have more QTY entered than you sold.",32,"Cannot save this QTY.")
			RETURN .F.
		ENDIF
		
		IF nQTY > nSO_QTY + nDist_QTY
			MESSAGEBOX("You have more QTY than you need."+CHR(13)+"Delete first.",32,"Cannot save this QTY.")
			RETURN .F.
		ENDIF
	ENDPROC

