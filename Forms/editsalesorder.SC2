	PROCEDURE frmEO.pf1.pgQuote.lblPO2HPA.Click
		PRIVATE cPO_Num, cCompany, cCustID, cMess
		cPO_Num		= PrepareSQLtxt(This.Parent.txtPO_Num.Value,'PO_num',20)
		cCompany	= PrepareSQLtxt(This.Parent.txtCompany.Value,'Company',30,.F.,.T.)
		cCustID		= PrepareSQLtxt(This.Parent.Parent.pgOrder.txtCustID.Value,'CustID',20)
		cMess = ""
		
		IF NOT EMPTY(cPO_Num) 
			IF NOT EMPTY(cCustID)
		
				IF USED( 'tmpPOtrend' )
					USE IN tmpPOtrend
				ENDIF
				
				cSQL = "SELECT DISTINCT TOP 15 SalesNum, PO_Num "
				cSQL = cSQL + " FROM dbo.AllQuotes  WITH(NOLOCK)"
				cSQL = cSQL + " WHERE CustID = '"+ALLTRIM(cCustID)+"'"
				cSQL = cSQL + " AND LEN( ISNULL(PO_Num,'') ) > 0 "
				cSQL = cSQL + "  ORDER BY SalesNum DESC "
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOtrend' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOtrend' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOtrend')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOtrend')
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOtrend')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
				
				IF USED('tmpPOtrend')
					IF RECCOUNT('tmpPOtrend') > 0
						SELECT tmpPOtrend
						SCAN
							IF EMPTY(cMess)
								cMess = PrepareSQLtxt(tmpPOtrend.PO_Num,'PO_num',20)
							ELSE
								cMess = cMess+ " "+CHR(13)+ PrepareSQLtxt(tmpPOtrend.PO_Num,'PO_num',20)
							ENDIF
						ENDSCAN
					ENDIF
				ENDIF	
				
			ELSE
				IF NOT EMPTY(cCompany)
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.lblShipdue.Click
		PRIVATE dDate1,dDate2
		
		dDate1 = This.Parent.txtShipdue.Value
		
		PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.F.
		ENDIF
		lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.F.
		ENDIF
		
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.T.
		ENDIF
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.T.
		ENDIF
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		This.Parent.txtShipdue.Value = dDate2
		SELECT SalesQuote
		REPLACE ShipDue WITH dDate2 IN SalesQuote
		
		This.Parent.txtShipdue.Refresh
	ENDPROC

