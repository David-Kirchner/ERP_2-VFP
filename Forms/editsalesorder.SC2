		*!*	cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.SalesNum ))
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
