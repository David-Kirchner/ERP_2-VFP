			ThisFormset.frmEO.pf1.pgOrder.edtQuotememo.Value = SalesQuote.QuoteMemo
		*!*		ThisFormSet.frmEO.pf1.pgOrder.edtQuoteMemo.refresh
		
		
		*!*		ThisFormSet.frmEO.pf1.pgOrder.txtBuyFrom.refresh
		*!*		ThisFormSet.frmEO.pf1.pgOrder.txtHPAPO.refresh
