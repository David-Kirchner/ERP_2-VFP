			*ThisFormSet.frmEO.pf1.pgQuote.txtHeat.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQuote.edtQuote_S_Instrct.Enabled = .T.
			
			ThisFormSet.RefreshForms(0)
			ThisFormSet.Address_Screen("QuoteToSave")
			
		CASE pAction = "DISABLE"
			ThisFormSet.frmEO.pf1.pgQuote.txtCompany.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtName.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.chkRL.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.chkMetric.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.chkServices.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtAlloy.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmbForm.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmbCC.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.cmbCL.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtPieces.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtThck.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtSz2.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtSz3.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtPhone.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtPhone_Ext.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtCountryC.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtQComments.ReadOnly = .T.
			ThisFormSet.frmEO.pf1.pgQuote.txtDescript.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtLeadTime.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.chkDShip.Enabled = .F.
		*	ThisFormSet.frmEO.pf1.pgQuote.chkShipOn.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtweight.Enabled = .F.
				
			ThisFormSet.frmEO.pf1.pgQuote.cmbPU.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.Q_P1.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.Q_QTY1.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.Q_Total1.Enabled = .F.
		
			*ThisFormSet.frmEO.pf1.pgQuote.txtP_lb.Enabled = .F.
			*ThisFormSet.frmEO.pf1.pgQuote.txtP_Pc.Enabled = .F.
			*ThisFormSet.frmEO.pf1.pgQuote.txtP_Ft.Enabled = .F.
			*ThisFormSet.frmEO.pf1.pgQuote.txtLotP.Enabled = .F.
			
			ThisFormSet.frmEO.pf1.pgQuote.txtCuts.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtOtherFld.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtOtherP.Enabled = .F.
			
			ThisFormSet.frmEO.pf1.pgQuote.txtPO_Num.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.txtOrderSpec.Enabled = .F.
			*ThisFormSet.frmEO.pf1.pgQuote.txtHeat.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgQuote.edtQuote_S_Instrct.Enabled = .F.
		
			ThisFormSet.Address_Screen("QuoteToEdit")
			
		CASE pAction = "SAVE"
			ThisFormSet.SaveQuote()
		
		CASE pAction = "OrderENABLE"
			ThisFormSet.frmEO.pf1.pgOrder.txtBuyFrom2.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgOrder.txtHPAPo2.Enabled = .T.
			
			ThisFormSet.Address_Screen("OrderToSave")
			
		CASE pAction = "OrderDISABLE"
			ThisFormSet.frmEO.pf1.pgOrder.txtBuyFrom2.Enabled = .F.
			ThisFormSet.frmEO.pf1.pgOrder.txtHPAPo2.Enabled = .F.
			
			ThisFormSet.Address_Screen("OrderToEdit")
			
		CASE pAction = "OrderSAVE"
			cUpdate = "UPDATE dbo.AllQuotes SET "
			cUpdate = cUpdate + " BUYFROM2='"+STRTRAN(ALLTRIM(SalesQuote.BUYFROM2),"'","''")+"'"
			cUpdate = cUpdate + ",HPAPO2="+ALLTRIM(STR(SalesQuote.HPAPO2))
			cUpdate = cUpdate + " WHERE ID = " + ALLTRIM(STR(SalesQuote.ID))
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL'  TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate , "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate , "")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
		
			IF nSQLEXEC < 0
				MESSAGEBOX("Data could not be saved at the SQL Server."+CHR(13)+CHR(13)+"Your edit will show on this screen and print on the report,"+CHR(13)+;
				"the data will revert to orignal when refreshed from the SQL Server."+CHR(13)+CHR(13)+"Edit and Try to save again!",0,"SQL Error")
			ENDIF
		
		ENDCASE
	ENDPROC

	PROCEDURE showstartstock
		PARAMETERS pText
		*ThisFormSet.ShowStartStock
		
		IF VARTYPE(pText) = "C"
			IF pText = "EMPTY"
				ThisFormset.frmStartingStock.ssALLOY1.Value = ''
				ThisFormset.frmStartingStock.sscmbForm.Value = '10'
				ThisFormset.frmStartingStock.sscmbCC.Value = '1'
				ThisFormset.frmStartingStock.sscmbCL.Value = ''
				ThisFormset.frmStartingStock.ssPieces1.Value = 0
				ThisFormset.frmStartingStock.ssThck1.Value = 0
				ThisFormset.frmStartingStock.ssSZ21.Value = 0
				ThisFormset.frmStartingStock.ssSZ31.Value = 0
				ThisFormset.frmStartingStock.ssWeight1.Value = 0
				
				RETURN
			ENDIF
		ENDIF
		
		PRIVATE lStartingStock
		lStartingStock = SalesQuote.StartStock 
		IF ISNULL(lStartingStock)
			lStartingStock  = .F.
		ENDIF
		IF NOT lStartingStock
			IF ThisFormSet.isQuoteEditing 
				*Nothing Entered - Start with Quote data
				SELECT SalesQuote
				REPLACE SalesQuote.StartStock WITH .T.
				ThisFormset.frmStartingStock.ssALLOY1.Value = ThisFormset.frmEO.pf1.pgQuote.txtALLOY.Value
				ThisFormset.frmStartingStock.sscmbForm.Value = ThisFormset.frmEO.pf1.pgQuote.cmbForm.Value
				ThisFormset.frmStartingStock.sscmbCC.Value = ThisFormset.frmEO.pf1.pgQuote.cmbCC.Value
				ThisFormset.frmStartingStock.sscmbCL.Value = ThisFormset.frmEO.pf1.pgQuote.cmbCL.Value
				ThisFormset.frmStartingStock.ssPieces1.Value = ThisFormset.frmEO.pf1.pgQuote.txtPieces.Value
				ThisFormset.frmStartingStock.ssThck1.Value = ThisFormset.frmEO.pf1.pgQuote.txtThck.Value
				ThisFormset.frmStartingStock.ssSZ21.Value = ThisFormset.frmEO.pf1.pgQuote.txtSZ2.Value
				ThisFormset.frmStartingStock.ssSZ31.Value = ThisFormset.frmEO.pf1.pgQuote.txtSZ3.Value
				ThisFormset.frmStartingStock.ssWeight1.Value = ThisFormset.frmEO.pf1.pgQuote.txtWeight.Value
				
			ELSE
				ThisFormSet.frmStartingStock.Visible = .F.
				WAIT WINDOW "To Create Starting Stock, you must be in Edit mode." NOWAIT
			ENDIF
		ELSE
			*Get Quotes Data
			
			IF USED('tmpStartStock')
				USE IN tmpStartStock
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT COUNT(*) as CNTD FROM dbo.StartingStock WITH(NOLOCK) "
			cSQL = cSQL + " WHERE AllQuotes_ID = "+STR(SalesQuote.ID)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStartStock')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStartStock')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStartStock")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStartStock")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStartStock')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('tmpStartStock')
				IF tmpStartStock.CNTD > 0
		
					cSQL = "SELECT * FROM dbo.StartingStock WITH(NOLOCK) "
					cSQL = cSQL + " WHERE AllQuotes_ID = "+STR(SalesQuote.ID)
					
					SELECT tmpStartStock
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStartStock')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStartStock')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStartStock")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStartStock")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStartStock')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
					
					IF USED('tmpStartStock')
						
						ThisFormset.frmStartingStock.ssALLOY1.Value = tmpStartStock.ALLOY
						ThisFormset.frmStartingStock.sscmbForm.Value = tmpStartStock.Form
						ThisFormset.frmStartingStock.sscmbCC.Value = tmpStartStock.CC
						ThisFormset.frmStartingStock.sscmbCL.Value = tmpStartStock.CL
						ThisFormset.frmStartingStock.ssPieces1.Value = tmpStartStock.Pieces
						ThisFormset.frmStartingStock.ssThck1.Value = tmpStartStock.Thck
						ThisFormset.frmStartingStock.ssSZ21.Value = tmpStartStock.SZ2
						ThisFormset.frmStartingStock.ssSZ31.Value = tmpStartStock.SZ3
						ThisFormset.frmStartingStock.ssWeight1.Value = tmpStartStock.Weight
						
						USE IN tmpStartStock
					ENDIF
				ELSE
				
					*No Data, Just make Visible
				
				ENDIF
			ENDIF
		ENDIF
		ThisFormSet.RefreshForms(1)
	ENDPROC

