		********************************
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE cOther
		cOther	= PrepareSQLtxt( This.Value,'Other',50)
		
		REPLACE Other WITH cOther IN SalesQuote
	ENDPROC

