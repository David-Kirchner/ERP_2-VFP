	PROCEDURE seekpoitems		&& Seek POitems for Printing
		PARAMETERS cSOitem
		*ThisFormSet.SeekPOitems(SalesQuote.SoItem_A)
		*Load_SO_POitems
		
		IF VARTYPE(cSOitem) != "C"
			cSOitem = ''
			*RETURN .F.
		ENDIF
		IF Proper_PO_item(cSOitem) = Proper_PO_item('')
			*RETURN .F.
		ENDIF
		
		IF USED( 'tmpPOitems' )
			USE IN tmpPOitems
		ENDIF
		
		IF Proper_PO_item(cSOitem) != Proper_PO_item('')
			cSQL = "SELECT LTRIM(p.POitem)+' ' "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.Services,0) = 1 then '{Service} ' else '' end "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.ConvServ,0) = 1 then '{Conversion} ' else '' end "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.WO_Detail,0) > 0 then '{WO_Detail'+RTRIM( CAST(p.WO_Detail AS CHAR(10) ))+'} ' else '' end "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.WO,0) > 0 then '{WO'+RTRIM( CAST(p.WO AS CHAR(10) ))+'} ' else '' end "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.Equipment,0) = 1 then '{Equipment} ' else '' end "
			cSQL = cSQL + " +LTRIM(p.Company) "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.Stock,'') = 'All for Stock' OR ISNULL(p.Stock,'') = 'Mostly Stock' then ' [Stock]' else '' end "
			cSQL = cSQL + " AS POtext "
			cSQL = cSQL + " FROM dbo.PurchaseOrder p  WITH(NOLOCK) "
			cSQL = cSQL + " WHERE p.SOitem = '"+cSOitem+"'"
			cSQL = cSQL + " AND p.Cancelled = 0 "
		ELSE
			*Collect blanks
			cSQL = "SELECT ' ' AS POtext FROM dbo.PurchaseOrder p WITH(NOLOCK) "
			cSQL = cSQL + " WHERE 0>0"
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOitems')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOitems')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitems")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOitems')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		************************
		IF USED( 'tmpAllPOitems' )
			USE IN tmpAllPOitems
		ENDIF
		
		cSQL = "SELECT CAST(' ' AS VarChar(MAX)) AS AllPOtext"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAllPOitems')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAllPOitems')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAllPOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAllPOitems")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpAllPOitems')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpAllPOitems')
			IF USED('tmpPOitems')
				SELECT tmpPOitems
				SCAN
					REPLACE AllPOtext WITH ALLTRIM(tmpAllPOitems.AllPOtext) + "|PO "+ ALLTRIM(tmpPOitems.POtext) + " |" IN tmpAllPOitems
					*+CHR(10)+CHR(13)
				ENDSCAN
				USE IN tmpPOitems
			ENDIF
		ELSE
			MESSAGEBOX("ThisFormSet.SeekPOitems(SalesQuote.SoItem_A) tmpAllPOitems.AllPOtext",0,"Report will not work")
			
		ENDIF
		
	ENDPROC

