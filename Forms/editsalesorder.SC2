	PROCEDURE frmEO.pf1.pgOrder.cmdRMA.Click
		*********************************************
		*check to see if a rtr has been made.
		
		
		PRIVATE cSOitem, nRMA_Detail, nRecNo
		cSOitem = PrepareSQLtxt(SalesQuote.SOItem_A,'SOitem',10)
		nRMA_Detail = PrepareSQLnum(SalesQuote.RMA_Detail,'RMA_Detail',-3)
		nRecNo = RECNO('SalesQuote')
		
		IF nRMA_Detail > 0
			MESSAGEBOX("This SOitem already has a RMA that has been started."+CHR(13)+"Use HPA App \Main Menu \Sales \RMA "+CHR(13)+CHR(13)+"Double click the RMA Number to review report page.",0+48,"Already has RMA")
			RETURN
		ENDIF
		PRIVATE nRMA_NO
		nRMA_No = get_RMA_from_RMA_Detail(nRMA_Detail, ThisFormSet.nConnHandle) 
		
		
		PRIVATE nCntSOitem
		nCntSOitem = Count_ItemsinSales (ThisFormSet.Salesnum, ThisFormSet.nConnHandle, 'RMA')
		IF nCntSOitem > 0
			*Get the RMA
			SELECT SalesQuote
			LOCATE FOR RMA_Detail > 0
			IF FOUND()
				nRMA_Detail = PrepareSQLnum(SalesQuote.RMA_Detail,'RMA_Detail',-3)
				IF nRMA_Detail > 0
					PRIVATE nMess
					nMess = MESSAGEBOX("This SalesNumber has a RMA Detail on a different Item"+CHR(13)+"Do you want to add this Item to that RMA?"+CHR(13)+"RMA "+ALLTRIM(STR(nRMA_No))+CHR(13)+"Answer (N)o to get a another RMA number.",4+32,"Add to RMA")
					IF nMess <> 6
						nRMA_Detail = 0
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		DO FORM Forms\RMA_Start WITH nRMA_No, cSOitem
		
		IF nRecNo > 0 AND nRecNo <= RECCOUNT('SalesQuote')
			ThisFormSet.Refresh_SalesQuote( nRecNo )
		ELSE
			ThisFormSet.Refresh_SalesQuote( 1 )
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.cmdSelectInv.Click
		PRIVATE lcInvForm, nReturnPrice, nWeight, nPieces, nFeet
		PRIVATE nSalesQuoteID 
		nSalesQuoteID = PrepareSQLnum(SalesQuote.ID,'ID',-3)
		
		*lcInvForm = ThisFormSet.InventoryForm( SalesQuote.Form )
		*lcInvForm = ThisFormSet.InventoryForm( Quotes.Form )
		
		nWeight = PrepareSQLnum(SalesQuote.Weight,'Weight',8,1)
		IF nWeight = 0
			*Calc Weight
		*	nWeight = ThisFormSet.CalcWeight( SalesQuote.Pieces, SalesQuote.Alloy, SalesQuote.Form, SalesQuote.Thck, SalesQuote.Sz2, SalesQuote.Sz3 )
		ENDIF
		PRIVATE nQTY
		nQTY = 0
		
		PRIVATE lStartStock 
		lStartStock = PrepareSQLlogic(SalesQuote.StartStock,'StartStock',.F.)
		
		IF lStartStock 
			PRIVATE nMess
			nMess = MESSAGEBOX("Found Starting Stock."+CHR(13)+"Do you wish to SELECT Inventory for this Starting Stock?",4+32,"Use Starting Stock?")
			IF nMess = 7
				lStartStock = .F.
			ENDIF
		ENDIF
		
		IF lStartStock 
			PRIVATE cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			cssAlloy	= ''
			cssForm		= ''
			cssCC		= ''
			cssCL		= ''
			nssPieces	= 0
			nssThck		= 0
			nssSz2		= 0
			nssSz3		= 0
			nssWeight	= 0
			DO GetStartingStock WITH SalesQuote.ID,ThisFormSet.nConnHandle,cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			
			nQTY = Calc_QTY(cssAlloy,cssForm,nssPieces,nssThck,nssSz2,nssSz3,'',ThisFormSet.nConnHandle)
			
			
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
		
		*Forms\StockLst_SQL_Browse 	*Use Browse if you are not looking for a Selection.
		*Forms\StockLst_SQL_Modal	*Use Modal if you are waiting for a Selection.
		*Forms\StockLst_SQL_Quotes
		
		*old DO FORM Forms\StockLst_SQL_Quotes WITH "SEL_SS",'S',cssAlloy,cssForm,cssCC,cssCL,nssThck,nssSz2,nssSz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,nssPieces,nssWeight,'',nQTY,.F.,''		
			DO FORM Forms\StockLst_SQL_Modal WITH "SEL_SS",'S',cssAlloy,cssForm,cssCC,cssCL,nssThck,nssSz2,nssSz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,nssPieces,nssWeight  ,'',nQTY,.F.,''		
			*                          PARAMETER pFunction,pTBL,  pAlloy,  pForm,  pCC,  pCL,  pThck,  pSz2,  pSz3,          pSOItem             ,pSalesNum       ,pPC, pLBS,pHeatLot,pQTY,pRL,pPOitem
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		
		ELSE
			nQTY = Calc_QTY(SalesQuote.alloy,SalesQuote.Form,SalesQuote.Pieces,SalesQuote.thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.OtherFld,ThisFormSet.nConnHandle)
			
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
		*Forms\StockLst_SQL_Browse 	*Use Browse if you are not looking for a Selection.
		*Forms\StockLst_SQL_Modal	*Use Modal if you are waiting for a Selection.
		*Forms\StockLst_SQL_Quotes
			*DO FORM Forms\StockLst_SQL_Quotes WITH "SELECT",'S',SalesQuote.alloy,SalesQuote.Form,SalesQuote.CC,SalesQuote.CL,SalesQuote.thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,SalesQuote.Pieces,SalesQuote.weight,'',nQTY,SalesQuote.RandLen,''
			DO FORM Forms\StockLst_SQL_Modal WITH "SELECT",'S',SalesQuote.alloy,SalesQuote.Form,SalesQuote.CC,SalesQuote.CL,SalesQuote.thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.SOItem_A,SalesQuote.SalesNum_A,SalesQuote.Pieces,SalesQuote.weight,'',nQTY,SalesQuote.RandLen,''
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		
		ENDIF
		
		*DO FORM Forms\ShowSelectedProcess WITH SalesQuote.SOItem_A
		********************************************************
		
		IF nSalesQuoteID > 0
			IF PrepareSQLnum(SalesQuote.ID,'ID',-3) != nSalesQuoteID 
				
				MESSAGEBOX("Let 'David Kirchner' know that your SalesQuote table has moved off its record!",64,"TEST")
				
				PRIVATE cMess
				cMess = "SalesQuote table has moved off its original record."+CHR(13)
				cMess = cMess+ "Current table is listed is '"+ALIAS()+"'."+CHR(13)
				cMess = cMess+ "Last SalesQuote.ID was "+STR(nSalesQuoteID)+"."+CHR(13)
				cMess = cMess+ "Current SalesQuote.ID is "+STR(PrepareSQLnum(SalesQuote.ID,'ID',-3))+"."+CHR(13)
				cMess = cMess+ "EOF('SalesQuote') is "+IIF(EOF('SalesQuote'),'True','False')+"."+CHR(13)
				cMess = cMess+ "BOF('SalesQuote') is "+IIF(BOF('SalesQuote'),'True','False')+"."+CHR(13)
				cMess = cMess+ "RECCOUNT('SalesQuote') is "+STR(RECCOUNT('SalesQuote'))+"."+CHR(13)
				TrackError("Select Inventory",cMess,PROGRAM(),LINENO(1))
					
				SELECT SalesQuote
				LOCATE FOR ID = nSalesQuoteID 	
				
			ENDIF
		ENDIF
		***************************
		ThisFormSet.sumStockLstCost()
		ThisFormSet.didSOitem_UseStock()
		
		
		
		
		ThisFormSet.frmEO.pf1.pgOrder.chkInv.REFRESH  &&SalesQuote.inv
		
		lVis = WVISIBLE('frmEO')
		IF lVis
		*	MESSAGEBOX( "If you did not just leave the 'Select from Inventory' window,"+CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+" AND remember what was done before this message appearred."+CHR(13)+CHR(13)+"Thank you for helping debug this program.",32,"frmEO is Visible")
		ELSE	
			MESSAGEBOX( "frmEO has not been activated, has been hidden, has been deactivated, or doesn't exist"+CHR(13)+CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+" AND remember what was done before this message appearred."+CHR(13)+CHR(13)+"Thank you for helping debug this program.",16,"frmEO is Visible")
		ENDIF
		ACTIVATE WINDOW frmEO TOP
		
		
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.cmdShowProcess.Click
		
		
		
			
		PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.F.
		ENDIF
		lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.F.
		ENDIF
		
		PRIVATE nID_Detail, cTBL
		nID_Detail = 0
		cTBL="S"
		DO FORM Forms\ShowProcess WITH nID_Detail,cTBL,ThisFormSet.SalesNum
		
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.T.
		ENDIF
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.T.
		ENDIF
		
		
		IF WVISIBLE('frmEO')
		*	MESSAGEBOX( "If you did not just leave the 'Select from Inventory' window,"+CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+" AND remember what was done before this message appearred."+CHR(13)+CHR(13)+"Thank you for helping debug this program.",32,"frmEO is Visible")
		ELSE	
			MESSAGEBOX( "frmEO has not been activated, has been hidden, has been deactivated, or doesn't exist"+CHR(13)+CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+" AND remember what was done before this message appearred."+CHR(13)+CHR(13)+"Thank you for helping debug this program.",16,"frmEO is Visible")
		ENDIF
		ACTIVATE WINDOW frmEO TOP
		
		
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.cmdSOiSched.Click
		*********************************************
		*check to see if a rtr has been made.
		
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(SalesQuote.SOItem_A,'SOitem',10)
		PRIVATE lNeed_rtr
		lNeed_rtr = DoesSOitem_need_rtr( cSOitem, ThisFormSet.nConnHandle )
		* SELECT dbo.f_rtr_Need_SOitem(dbo.f_ProperSOitem(
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE biRTR_ID
		biRTR_ID = 0
		
		IF Proper_SO_item(cSOItem) != Proper_SO_item('')
		
			cSQL = "SELECT ID FROM dbo.rtr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			IF USED("tmpCountRTR")	
				USE IN tmpCountRTR
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpCountRTR')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountRTR')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			IF USED('tmpCountRTR')
				IF RECCOUNT('tmpCountRTR') > 0
					biRTR_ID = PrepareSQLnum(tmpCountRTR.ID,'rtr_ID',-4)
				ENDIF
				USE IN tmpCountRTR
			ENDIF
		ENDIF
		
		IF biRTR_ID = 0
		*	biRTR_ID = Create_rtr_SOitem (cSOitem, ThisFormSet.nConnHandle)
			MESSAGEBOX("This SOitem does not have a Router!"+CHR(13)+"Create a route then Shop can Schedule Production.",48,"No Route")
			RETURN .F.
		ENDIF
		
		*have RTR
		******************************
		*now check Production Schedule
		PRIVATE nProductionID, nCntPdID
		nProductionID = 0
		nCntPdID = 0
		
		cSQL = "SELECT Pd.ID AS PdID,* "
		cSQL = cSQL + " FROM dbo.rtr WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.rtr_Detail rtrD WITH(NOLOCK) ON rtr.ID = rtrD.rtr_ID "
		cSQL = cSQL + " INNER JOIN dbo.rtr_Schedule Pd WITH(NOLOCK) ON rtr.OType_Num = pd.OType_Num "
		cSQL = cSQL + " WHERE Pd.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND rtrD.ReqSched = 1 "
		
			
		IF USED("tmpCountRTR")	
			USE IN tmpCountRTR
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpCountRTR')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountRTR')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		IF USED('tmpCountRTR')
			IF RECCOUNT('tmpCountRTR') > 0
				nCntPdID	= RECCOUNT('tmpCountRTR')
				nProductionID = PrepareSQLnum(tmpCountRTR.PdID,'ID',-3)
			ENDIF
			USE IN tmpCountRTR
		ENDIF
		
		IF nProductionID = 0
			MESSAGEBOX("There is no Production Scheduled for this SOitem"+CHR(13)+CHR(13)+"This SOitem does have a Router started."+CHR(13)+"You may need to edit the router to get on a machine schedule"+CHR(13)+CHR(13)+"Make sure you build the route so ALL of the production work can be scheduled.",48,"No Schedule")
			RETURN .F.
		ENDIF
		
		*************************************
		PRIVATE m.nPdID, cOType_Num 
		m.nPdID = 0
		cOType_Num = OType_Proper( "SI", cSOitem )
		
		IF nCntPdID > 1
			DO FORM Forms\ChooseProdSched WITH cOType_Num TO m.nPdID
			
			IF NOT VARTYPE(m.nPdID) = "N"
				m.nPdID = 0
			ENDIF
		ELSE
			*From prev query
			m.nPdID = nProductionID 
		ENDIF
		
		*************************************
		IF m.nPdID > 0
			DO FORM forms\Production WITH cOType_Num, m.nPdID
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.cmdSOrtr.Click
		IF Thisformset.frmRouterDetailOrder.Visible
			MESSAGEBOX("Close the 'Router Detail Order'"+CHR(13)+"window first.",16,"Another Window is Open")
			ThisFormSet.frmRouterDetailOrder.cmdReturn.SetFocus
		ELSE
			IF Thisformset.frmRouter.Visible
				Thisformset.frmRouter.grdRTR.SetFocus()
			ELSE
			
				PRIVATE cSOitem
				cSOitem = PrepareSQLtxt(SalesQuote.SOItem_A,'SOitem',10)
				
				PRIVATE biRTR_ID
				biRTR_ID = 0
				
				IF Proper_SO_item(cSOItem) != Proper_SO_item('')
					cSQL = "SELECT ID FROM dbo.rtr WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					
					IF USED("tmpCountRTR")	
						USE IN tmpCountRTR
					ENDIF
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpCountRTR')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountRTR')
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountRTR')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
					IF USED('tmpCountRTR')
						IF RECCOUNT('tmpCountRTR') > 0
							biRTR_ID = PrepareSQLnum(tmpCountRTR.ID,'rtr_ID',-4)
						ENDIF
						USE IN tmpCountRTR
					ENDIF
				ENDIF
		
				IF biRTR_ID = 0
					MESSAGEBOX("This Sales Order does not have an entry in the Router Table."+CHR(13)+"Select Stock to create a rtr to show!",0+48,"No record to show.")
					*Could run CREATE_RTR_SOITEM()
					*Reads Sales and add all Operations quoted to the router.
				ENDIF
				
				IF biRTR_ID > 0
					*WAIT WINDOW 'Router Loaded' NOWAIT
		
					ThisFormSet.frmRouter.Visible = .T.
					ThisFormSet.frmRouter.Top = ThisForm.Top + 20
					ThisFormSet.frmRouter.Left = ThisForm.Left + 300
		
					ThisFormSet.frmRouter.LoadRTR(biRTR_ID)
					*ThisFormSet.frmRouter.router_init(pWhat, pType, pID , nTop, nLeft, cCaption)
		
					ThisFormSet.frmRouter.grdRTR.SetFocus()
					
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.cmdWO_Detail.Click
		
		PRIVATE cPOitem, lReturn
		cPOitem = SalesQuote.POitem
		
		
		PRIVATE cPOitem, nWO, nWOD, lReturn
		cPOitem = PrepareSQLtxt(SalesQuote.POitem,'POitem',12)
		cSOitem = PrepareSQLtxt(SalesQuote.SOitem,'SOitem',10)
		nWO		= PrepareSQLnum(SalesQuote.WO,'WO',-3) &&Quote.WO, Sales.WO = WO1
		nWOD	= PrepareSQLnum(SalesQuote.WO_Detail,'WO_Detail',-3)
		
		IF nWOD	> 0
			ThisForm.AlwaysOnTop = .F.
			DO FORM Forms\WorkOrder WITH "EDIT",nWO,nWOD,cPOitem,cSOitem,0 
			ThisForm.AlwaysOnTop = .T.
			
			ThisFormSet.Check_New_WOD()
		ELSE
			IF nWO = 0
				*Must get a WO
				*Add Finishing Detail
				ThisForm.AlwaysOnTop = .F.
				DO FORM Forms\WorkOrder WITH "ADD_SO-Finish",nWO,nWOD,cPOitem,cSOitem,0
		
				ThisForm.AlwaysOnTop = .T.				
				ThisFormSet.Check_New_WOD()
			ELSE
				*Have WO
				*Add Finishing Detail
				ThisForm.AlwaysOnTop = .F.
				DO FORM Forms\WorkOrder WITH "ADD_SO-Finish",nWO,nWOD,cPOitem,cSOitem,0
					*PARAMETERS pWhat,pWOD,pWO,pPOitem,pSOitem,pWhatEver
				ThisForm.AlwaysOnTop = .T.
				ThisFormSet.Check_New_WOD()
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgOrder.lblBuyfrom.Click
		PRIVATE lReturn, cSOitem
		cSOitem = Proper_SO_Item(SalesQuote.SOItem_A)
		
		IF Refresh_Buyfrom_AllQuotes (cSOitem, ThisFormSet.nConnHandle )
			*Get current AllQuote PO's
			IF USED('tmpAQpo')
				USE IN tmpAQpo
			ENDIF
			
			cSQL = "SELECT HPAPo,BuyFrom ,HPAPo2,BuyFrom2 FROM dbo.AllQuotes WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAQpo')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAQpo' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQpo")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAQpo")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				lOK = .F.
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpAQpo')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			IF USED('tmpAQpo')
				IF RECCOUNT('tmpAQpo') > 0
					*Found
					nAQHPAPo	= PrepareSQLnum(tmpAQpo.HPAPo,'HPAPO',-3)
					cAQBuyFrom	= ShowSQLtxt(tmpAQpo.BuyFrom,'BuyFrom',30)
					nAQHPAPo2	= PrepareSQLnum(tmpAQpo.HPAPo2,'HPAPO2',-3)
					cAQBuyFrom2 = ShowSQLtxt(tmpAQpo.BuyFrom2,'BuyFrom2',30)
					
					This.parent.txtHpapo.Value    = PrepareSQLnum(tmpAQpo.HPAPo,'HPAPO',-3)
					This.parent.txtBuyFrom.Value  = ShowSQLtxt(tmpAQpo.BuyFrom,'BuyFrom',30)
					This.parent.txtHpapo2.Value   = PrepareSQLnum(tmpAQpo.HPAPo2,'HPAPO2',-3)
					This.parent.txtBuyFrom2.Value = ShowSQLtxt(tmpAQpo.BuyFrom2,'BuyFrom2',30)
					
					SELECT SalesQuote
					REPLACE HPAPo WITH nAQHPAPo
					REPLACE BuyFrom WITH cAQBuyFrom
					REPLACE HPAPo2 WITH nAQHPAPo2
					REPLACE BuyFrom2 WITH cAQBuyFrom2
					
					This.parent.txtHpapo.Refresh
					This.parent.txtBuyFrom.Refresh
					This.parent.txtHpapo2.Refresh
					This.parent.txtBuyFrom2.Refresh
					
				ENDIF
				USE IN tmpAQpo
			ENDIF
		
		ENDIF
	ENDPROC

