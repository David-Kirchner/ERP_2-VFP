	PROCEDURE frmPO.cmdPOAdd.Click
		*Tell the PurchaseOrder Class that it is being used by the EditSalesOrder form.
		ThisFormSet.frmPO.EditSalesOrder = .T.
		
		DODEFAULT()
		**PO_Valid("NEW") will ask if PO is a continuation.
		
		*ThisFormSet.frmPO.POEditing = .T. was set in dodefault
		*DoDefault now resets SalesNum, SOitem
		
		
		IF NOT ThisFormSet.FrmPO.POediting
			RETURN
		ENDIF
		
		ThisFormSet.frmPO.pgfPO.pgPODesc.txtSalesNum.Value = ThisFormSet.SalesNum
		cSOItem = Proper_SO_item( SalesQuote.SoItem_a )
		ThisFormSet.frmPO.pgfPO.pgPODesc.txtItem.Value = SalesQuote.Item
		ThisFormSet.frmPO.SalesNum = ThisFormSet.SalesNum
		
		ThisFormSet.frmPO.PO_NewAdd = .T.
		
		*IF ThisFormSet.frmPO.PO_NewAdd
		IF PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtItemPo.VALUE,'ItemPO',2,0) = 0
			ThisForm.pgfPO.pgPODesc.txtItemPo.VALUE = 1
		ENDIF
		IF LEN( PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.txtSalesP.VALUE,'SalesP',1) ) = 0
			ThisForm.pgfPO.pgPODesc.txtSalesP.VALUE = SalesQuote.SalesP
		ENDIF
		IF LEN( PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.txtCover.VALUE,'Cover',1)) = 0
			ThisForm.pgfPO.pgPODesc.txtCover.VALUE = SalesQuote.Cover
		ENDIF
			
			
		*	ThisForm.pgfPO.pgPODesc.txtCompany.Value = ''
		*	ThisForm.pgfPO.pgPODesc.lblVendCode.Caption = ''
		*	ThisForm.pgfPO.pgPODesc.lblPeachID.Caption	= ''
			
			*****************************************************
		PRIVATE lStartStock
		lStartStock = PrepareSQLlogic(SalesQuote.StartStock,'StartStock',.F.)
		
		IF lStartStock
			PRIVATE nMess
			nMess = MESSAGEBOX("Found Starting Stock."+CHR(13)+"Do you wish to create a New PO for this Starting Stock?",4+32,"Use Starting Stock?")
			IF nMess = 7
				lStartStock = .F.
			ENDIF
		ENDIF
		
		IF lStartStock
			PRIVATE cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			cssAlloy	= ''
			cssForm		= ''
			cssCC		= ''
			cssCL		= ''
			nssPieces	= 0
			nssThck		= 0
			nssSz2		= 0
			nssSz3		= 0
			nssWeight	= 0
			
			DO GetStartingStock WITH SalesQuote.ID,ThisFormSet.nConnHandle,cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
		
			ThisForm.pgfPO.pgPODesc.txtPieces.VALUE		= nssPieces
			ThisForm.pgfPO.pgPODesc.txtAlloy.VALUE		= cssAlloy
			ThisForm.pgfPO.pgPODesc.cmbForm.VALUE		= cssFORM
			ThisForm.pgfPO.pgPODesc.lblPerUnit.Caption	= FormUnitCaption(cssForm,.F.,.F.,ThisFormSet.nConnHandle)
			ThisForm.pgfPO.pgPODesc.cmbCC.VALUE			= cssCC
			ThisForm.pgfPO.pgPODesc.cmbCL.VALUE			= cssCL
			ThisForm.pgfPO.pgPODesc.txtThck.VALUE		= nssThck
			ThisForm.pgfPO.pgPODesc.txtStandSize.VALUE	= getStandardSize(nssThck, ThisFormSet.nConnHandle)
			ThisForm.pgfPO.pgPODesc.txtSz2.VALUE		= nssSz2
			ThisForm.pgfPO.pgPODesc.txtSz3.VALUE		= nssSz3
			ThisForm.pgfPO.pgPODesc.txtOrder_Qty.Value	= nssWeight
				
			IF cssFORM = "40" AND nssThck < .13
				ThisForm.pgfPO.pgPODesc.chkSPS1.VALUE = 1
			ELSE
				ThisForm.pgfPO.pgPODesc.chkSPS1.VALUE = 0
			ENDIF
			
		ELSE
			
			PRIVATE lDiff, cMess
			lDiff = .F.
			cMess = ''
			
			IF ThisFormSet.frmPO.pgfPO.pgPODesc.txtPieces.Value <> PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
				lDiff = .T.
				cMess = cMess + "Pieces="+ALLTRIM(STR( PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3) ))+"  "
			ENDIF
			
			IF ThisFormSet.frmPO.pgfPO.pgPODesc.txtAlloy.VALUE	<> PrepareSQLtxt(SalesQuote.Alloy,'Alloy',12)
				lDiff = .T.
				cMess = cMess + "Alloy="+ALLTRIM( PrepareSQLtxt(SalesQuote.Alloy,'Alloy',12))+"  "
			ENDIF
			IF ThisFormSet.frmPO.pgfPO.pgPODesc.cmbForm.VALUE <> PrepareSQLtxt(SalesQuote.FORM,'Form',2)
				cMess = cMess + "Form="+ALLTRIM( PrepareSQLtxt(SalesQuote.Form,'Form',2))+"  "
				lDiff = .T.
			ENDIF
			IF ThisFormSet.frmPO.pgfPO.pgPODesc.cmbCC.VALUE <> PrepareSQLtxt(SalesQuote.CC,'CC',1)
				cMess = cMess + "CC="+ALLTRIM( PrepareSQLtxt(SalesQuote.CC,'CC',1))+"  "
				lDiff = .T.
			ENDIF
			IF ThisFormSet.frmPO.pgfPO.pgPODesc.cmbCL.VALUE <> PrepareSQLtxt(SalesQuote.CL,'CL',1)
				cMess = cMess + "CL="+ALLTRIM( PrepareSQLtxt(SalesQuote.CL,'CL',1))+"  "
				lDiff = .T.
			ENDIF
			IF ThisFormSet.frmPO.pgfPO.pgPODesc.txtThck.Value	<> PrepareSQLnum(SalesQuote.Thck,'Thck',10,4)
				cMess = cMess + "Thck="+ALLTRIM(STR( PrepareSQLnum(SalesQuote.Thck,'Thck',10,4) ))+"  "
				lDiff = .T.
			ENDIF
			IF ThisFormSet.frmPO.pgfPO.pgPODesc.txtSz2.Value <> PrepareSQLnum(SalesQuote.Sz2,'Sz2',9,3)
				cMess = cMess + "Sz2="+ALLTRIM(STR( PrepareSQLnum(SalesQuote.Sz2,'Sz2',9,3) ))+"  "
				lDiff = .T.
			ENDIF
			IF ThisFormSet.frmPO.pgfPO.pgPODesc.txtSz3.Value <> PrepareSQLnum(SalesQuote.Sz3,'Sz3',9,3)
				cMess = cMess + "Sz3="+ALLTRIM(STR( PrepareSQLnum(SalesQuote.Sz3,'Sz3',9,3) ))+"  "
				lDiff = .T.
			ENDIF
			
			IF lDiff
				PRIVATE cSOitem, cPOitem
				cSOitem		= PrepareSQLtxt(SalesQuote.SOitem_A,'SOitem',10)
				cPOitem		= PrepareSQLtxt(ThisFormSet.frmPO.cPOitem,'POitem',12)
				
				RecordTest("Add PO '"+cPOitem+"' to a SO '"+cSOitem+"'.", PROGRAM(), LINENO(1),"Something was different."+CHR(13)+cMess)
			ENDIF
			
			
			
			IF SalesQuote.FORM = "40" AND SalesQuote.Thck < .13
				ThisForm.pgfPO.pgPODesc.chkSPS1.VALUE = 1
			ELSE
				ThisForm.pgfPO.pgPODesc.chkSPS1.VALUE = 0
			ENDIF
		ENDIF
		
		
		*ThisForm.pgfPO.pgPODesc.txtJobNumber.VALUE = STR(ThisFormSet.SalesNum)
		*ThisForm.pgfPO.pgPODesc.txtOrderDate.VALUE = DATE()
		
		*ThisForm.pgfPO.pgPODesc.cmbStock.VALUE = "No Stock"
		*m.Stock = "No Stock"
		
		IF PrepareSQLlogic(SalesQuote.Metric,'Metric',.F.)
			ThisForm.pgfPO.pgPODesc.chkMetric.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.Value = ShowSQLtxt(SalesQuote.Sz1orig,'Sz1Orig',20)
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.Value = ShowSQLtxt(SalesQuote.Sz2orig,'Sz2Orig',20)
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.Value = ShowSQLtxt(SalesQuote.Sz3orig,'Sz3Orig',20)
			
		ENDIF
		
		***************************************************************
		***************************************************************
		*!*	PRIVATE cForm,nS_PU, nLBS, nPieces, nSz2, nSz3
		*!*	cForm	= PrepareSQLtxt(SalesQuote.Form,'Form',2)
		*!*	nS_PU	= PrepareSQLnum(SalesQuote.S_PU,'S_PU',-1)
		*!*	IF nS_PU = 0
		*!*		nS_PU = GetPUfromForm(cForm, ThisFormSet.nConnHandle)
		*!*	ENDIF
		*!*	nLBS	= 0
		*!*	nPieces	= 0
		*!*	nSz2	= 0
		*!*	nSz3	= 0
		*!*	*Set default on screen
		*!*	*1 $/LB, 2 $/Ft, 3 $/PC, 4 $lot
		*!*	CASE nS_PU = 1
		*!*		ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value	= nLBS
		*!*	CASE nS_PU = 2
		*!*		*FT
		*!*		PRIVATE nFtLen, nSigDim
		*!*		nFtLen = 0
		*!*		nSigDim = getSigDim(cForm, ThisForm.nConnHandle)
		*!*		IF nSigDim = 2
		*!*			nFtLen = IIF(nPieces<1,1,nPieces) * nSz2/12
		*!*		ENDIF
		*!*		IF nSigDim = 3
		*!*			nFtLen = IIF(nPieces<1,1,nPieces) * nSz3/12
		*!*		ENDIF
		*!*				
		*!*		ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value	= ROUND(nFtLen,1)
		*!*		
		*!*	CASE nS_PU = 3
		*!*		ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value	= nPieces
		*!*	ENDCASE
	ENDPROC

	PROCEDURE frmPO.cmdPODelete.Click
		*Delete or Cancel
		PRIVATE lPOEditMode 
		lPOEditMode = ThisFormSet.frmPO.POEditing
		
		IF This.Caption = "Cancel"
			*Cancel Edit
			DODEFAULT()
			*ThisFormSet.Address_Screen("OrderToEdit")
			IF lPOEditMode AND NOT ThisFormSet.frmPO.POEditing
				*Cancel
		*		ThisFormSet.EditPOScreen(.F.)
			ELSE
				*Delete or Missed Cancel
			ENDIF
		ELSE
			*Delete
			PRIVATE cPOitem, cSOitem
			cPOitem = ThisForm.cPOitem		&&form is frmPO
			cSOitem = ThisForm.cSOitem		&&form is frmPO
			
			IF MESSAGEBOX("Are you sure you want to delete PO Item "+ALLTRIM(cPOitem)+" ?",4+48,"Delete PO Item?") = 6
				ThisFormSet.frmPO.cPOitem = ThisForm.cPOitem
				
				IF PurchaseOrder_POitem_Delete( cPOitem, ThisFormSet.nConnHandle, cSOitem ) 
					*ThisFormSet.ReloadPurchaseOrder()
					WAIT WINDOW "Deleted." NOWAIT
					
					ThisFormSet.frmPO.cPOitem = ''
					ThisFormSet.frmPO.PO_NewAdd = .F.
					ThisFormSet.frmPO.PO_NewClone = .F.
					ThisFormSet.frmPO.POEditing = .F.
					
					ThisFormSet.frmPO.POScreen("DISABLE")
					*ThisFormSet.frmPO.POScreen("CLEAR")	--done in ThisForm.Show_frmPO()	if needed	
					ThisFormSet.frmPO.Show_frmPO()
		
				ELSE
					WAIT WINDOW "Failed to deleted." NOWAIT
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmPO.cmdPOEdit.Click
		************
		*Edit or Save
		
		PRIVATE cPOitem, lAdd, lPOEditMode, cCaption
		cPOitem = ThisForm.cPOitem
		lAdd = ThisFormSet.FrmPO.PO_NewAdd
		*lPOEditMode = ThisformSet.POeditMode
		lPOEditMode = ThisFormSet.frmPO.POEditing
		cCaption = This.Caption
		
		DODEFAULT()
		
		IF lPOEditMode = ThisFormSet.frmPO.POEditing
			*Nothing Changed!
			RETURN
		ENDIF
		
		
		*POEditMode is changed in CLASS purchaseorder at DoDefault()
		IF ThisFormSet.frmPO.POEditing
			*show Edits
			ThisFormSet.frmPO.POScreen("ENABLE")
			*ThisFormSet.Address_Screen("POShiptoSave")
			ThisFormSet.Address_Screen("OrderToEdit")
		ELSE
			IF cCaption = "Save PO"
				*Cancelled the Save!
			ELSE
			*Save Edits
				ThisFormSet.frmPO.POScreen("DISABLE")
				*ThisFormSet.Address_Screen("POShipToEdit")
				ThisFormSet.Address_Screen("OrderToSave")	
			
			ENDIF
			*ThisFormSet.RefreshEditTab()
		ENDIF
		
		
	ENDPROC

