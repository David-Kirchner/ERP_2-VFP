	PROCEDURE frmEO.pf1.pgBillTo.txtCompany.GotFocus
		IF LEN(ALLTRIM(This.Value))=0 AND This.Parent.cmdEditSoldTo.Caption = "Save"
			This.Value = SalesQuote.Company
			
			IF LEN(ALLTRIM(This.Parent.txtContact.Value))=0
				This.Parent.txtContact.Value = SalesQuote.name
			ENDIF
			IF LEN(ALLTRIM(This.Parent.txtPhone.Value))=0
				This.Parent.txtPhone.Value = ALLTRIM(SalesQuote.CountryC)+ALLTRIM(SalesQuote.Phone)+IIF(!EMPTY(SalesQuote.Phone_ext),"x"+ALLTRIM(SalesQuote.Phone_ext),"")
			ENDIF
			IF LEN(ALLTRIM(This.Parent.txtFax.Value))=0
				This.Parent.txtFax.Value = ALLTRIM(SalesQuote.CountryC)+SalesQuote.Fax
			ENDIF
			IF LEN(ALLTRIM(This.Parent.txtEmail.Value))=0
				This.Parent.txtEmail.Value = SalesQuote.Email
			ENDIF
			
			ThisFormSet.Address_Screen("SoldToSave")
		ENDIF
	ENDPROC

