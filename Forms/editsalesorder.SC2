	PROCEDURE frmEO.pf1.pgQuote.txtItemCost.Valid
		PRIVATE nBuyCost
		PRIVATE nDecimal
		
		IF !SalesQuote.Cncld
			IF SalesQuote.Inv
			ELSE
				nBuyCost = This.Value
				IF VARTYPE(nBuyCost) = "C"
					nDecimal = SET("DECIMAL")
					SET DECIMAL TO 0
					nBuyCost = VAL(nBuyCost)
					SET DECIMAL TO nDecimal
				ENDIF
				SELECT SalesQuote
				REPLACE BuyCost WITH nBuyCost  IN SalesQuote
			ENDIF
			IF SalesQuote.BRK
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.txtItemSale.Valid
		RETURN
		
		IF !SalesQuote.Cncld
		
			PRIVATE nCalcLotP, nItemSale
			*nCalcLotP = ThisFormSet.CalcLotP()
			nCalcLotP = getSale_SOitem( SalesQuote.SOItem_A, ThisFormSet.nConnHandle )
			nItemSale = PrepareSQLnum(This.Value,'ItemSale',9,2)
			
			**************
			*Compare
			IF (nCalcLotP+100)*1.1 < (nItemSale+100) 
				*nItemSale is over 10% grater than nCalcLotP
				MESSAGEBOX("Please Check this Sale number."+CHR(13)+"The CalcLotPrice() function does not match!"+CHR(13)+"Edit the '$/lb' or 'Weigth'"+CHR(13)+"to change the estimated lot sale price",48,"Warning")
			ENDIF
			IF (nItemSale+100)*1.1 < (nCalcLotP+100) 
				*nCalcLotP is over 10% grater than nItemSale
				MESSAGEBOX("Please Check this Sale number."+CHR(13)+"The CalcLotPrice() function does not match!"+CHR(13)+"Edit the '$/lb' or 'Weigth'"+CHR(13)+"to change the estimated lot sale price",48,"Warning")		
			ENDIF
			
			****************	
			SELECT SalesQuote
			REPLACE cLotP WITH nCalcLotP IN SalesQuote
			*ThisFormSet.UpdtItemSale(SalesQuote.cLotP)
			*ThisFormSet.Update_Prices()
			****************
			*CREATE TABLE (ItemSale Y, ItemCost Y, ItemSkCost Y, ItemSKPaid Y, ItemPOCost Y, Item INT, Cncld l, SOitem CHAR(10))
			
			SELECT SalesTotal
			REPLACE ItemSale WITH nCalcLotP IN SalesTotal
		
			***********
			PRIVATE cSOitem
			cSOitem 	= PrepareSQLtxt(SalesQuote.SOItem_A,'SOitem',10)
		
			SELECT SalesTotal
			LOCATE FOR SOitem = cSOitem 
			IF FOUND('SalesTotal')
				REPLACE ItemSale WITH nCalcLotP IN SalesTotal
			ELSE
				MESSAGEBOX("SalesTotal table did not get updated.",16,"Error")
			ENDIF
			
			SELECT SalesQuote
			*ThisFormSet.Update_Prices()
			This.Parent.txtItemSale.Refresh()
		ENDIF
	ENDPROC

