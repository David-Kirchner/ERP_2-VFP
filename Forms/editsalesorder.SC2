	PROCEDURE frmEO.pf1.pgQuote.chkDShip.Valid
		PRIVATE lDShip, lPODShip
		lDShip = PrepareSQLlogic(This.Value,'DShip',.F.)
		
		PRIVATE cSOitem
		cSOitem = SalesQuote.SOitem_A
		
		*Is there a PO to be Drop or Direct shipped?
		lPODShip = SO_have_PO_DShip( cSOitem, ThisFormSet.nConnHandle )
		
		IF lDShip
			*User clicked to Direct Ship
			IF lPODShip 
				*good
			ELSE
				MESSAGEBOX("Did not find PO that would Drop Ship to Customer."+CHR(13)+"Add a 'Ship to Direct' Po first.",48,"Cannot change here.")
				This.Value = 0
				RETURN .F.
			ENDIF
		ELSE
			*User clicked Drop Ship Off
			IF lPODShip 
				MESSAGEBOX("There is still a PO being Drop Shipped!"+CHR(13)+"Please remove the PO first!",48,"Cannot change here.")
				This.Value = 1
				RETURN .F.
			ELSE
				*good
			ENDIF
		ENDIF	
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.chkServices.Click
		IF ThisFormSet.CheckSpinnerTYP('chkService', This.Value)
			REPLACE [Services] WITH PrepareSQLlogic(This.Value,'Services',.F.) IN SalesQuote
			REPLACE [TYP] WITH 'S' IN SalesQuote
		ELSE
			This.Value = !This.Value
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.chkShipOn.Valid
		PRIVATE lShipOn
		lShipOn	= PrepareSQLlogic(This.Value,'ShipOn',.F.)
		
		SELECT SalesQuote
		REPLACE ShipOn WITH lShipOn IN SalesQuote
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.Click
		IF NOT ThisFormSet.pgRefresh()	&&2
			RETURN .F.
		ENDIF
		*ThisFormSet.Refresh_pgQuote()
		
		ThisFormSet.frmPO.Visible = .F.
		ThisFormSet.frmPO.AlwaysOnTop = .F.
		ThisFormSet.frmEoP.Visible = .F.
		
		This.txtCompany.Setfocus
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.cmbCC.GotFocus
		ThisFormSet.CC = ShowSQLtxt(This.Value,'CC',1)
		ThisFormSet.CL = ShowSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			USE IN ConditionCode
		ENDIF
		
		*this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode WITH(NOLOCK)"
		cSQL = cSQL + " WHERE ISNULL(inActive,0) = 0"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF NOT LEN(ALLTRIM(cc1))=0
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = Quotes.CC
		*This.Value = SalesQuote.cc
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.cmbCC.InteractiveChange
		PRIVATE cCC
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		
		This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
		ThisFormSet.CC = ShowSQLtxt(This.Value,'CC',1)
		ThisFormSet.CL = ShowSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			USE IN ConditionLevel
		ENDIF
		
		This.Parent.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel WITH(NOLOCK)"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		This.Parent.cmbCL.ColumnCount = 2
		This.Parent.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		This.Parent.cmbCL.BoundColumn = 1
		This.Parent.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF NOT LEN(ALLTRIM(cc1))=0
				IF LEN(ALLTRIM(cc1)) > 1
					
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Parent.cmbCL.Value = cCL1
		SELECT SalesQuote
		REPLACE CL WITH cCL1 IN SalesQuote
		
		IF ThisFormSet.CC != ShowSQLtxt(This.Value,'CC',1)
			ThisFormSet.CC = ShowSQLtxt(This.Value,'CC',1)
			cCL1 = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
			This.Parent.cmbCL.Value = cCL1
			SELECT SalesQuote
			REPLACE CL WITH cCL1 IN SalesQuote
		
			This.Parent.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgQuote.cmbCC.LostFocus
		ThisFormSet.RefreshCL()
	ENDPROC

