	PROCEDURE seekstartingstocksalesnum
		*ThisFormSet.SeekStartingStockSalesNum()	
		
		IF USED('StartingStock')
			USE IN StartingStock
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT SS.*, AQ.SOitem FROM dbo.AllQuotes AQ WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StartingStock SS WITH(NOLOCK) ON AQ.ID = SS.AllQuotes_ID "
		cSQL = cSQL + " WHERE AQ.SalesNum = "+STR(ThisFormSet.SalesNum)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StartingStock')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'StartingStock')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StartingStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StartingStock")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'StartingStock')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('StartingStock')
			SELECT StartingStock
			INDEX ON SOitem TAG SOitem
			SET ORDER TO TAG SOitem
			
			SELECT SalesQuote
			SET RELATION TO SOitem INTO StartingStock
		ENDIF
		
		
	ENDPROC

	PROCEDURE set_sales_no_chng		&& Callls Proc_SQL:Set_Sales_No_Changing
		*ThisFormSet.Set_Sales_No_Chng()
		*Calls Proc_SQL:Set_Sales_No_Changing()
		*Does not record!  use Set_Sales_No_Changing to record Change in Save
		
		PRIVATE lOK, nSalesNum
		nSalesNum = PrepareSQLnum(ThisFormSet.SalesNum,'SalesNum',-3) 
		*IF nSalesNum = 0
		*	lOK = .F.
		*ELSE
		*	lOK = .T.
		*ENDIF
		
		IF nSalesNum > 0 AND Set_Sales_No_Changing( nSalesNum, ThisFormSet.nConnHandle ) 
		
			SELECT Sales_No
			ThisFormSet.lChangingSO = .T.
			ThisFormSet.frmEO.pf1.pgBillTo.chkSOchanging.Value	= ThisFormSet.lChangingSO
			REPLACE Changing WITH ThisFormSet.lChangingSO IN Sales_No
			
			ThisFormSet.lPrintedSO	= .F.
			ThisFormSet.frmEO.pf1.pgBillTo.chkPrintedSO.Value = ThisFormSet.lPrintedSO
			REPLACE PrintedSO WITH ThisFormSet.lPrintedSO IN Sales_No
			
			ThisFormSet.lShopRecvSO	= .F.
			ThisFormSet.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
			REPLACE ShopRecv WITH ThisFormSet.lShopRecvSO IN Sales_No
			
			*ThisFormset.frmEO.pf1.pgBillTo.txtAmendment.Value = ThisFormSet.nAmendment
			*REPLACE Amendment WITH ThisFormSet.nAmendment IN Sales_No
			
			lOK = .T.
		ELSE
			MESSAGEBOX("Could not Set SO to Changing state."+CHR(13)+"Amendment number may be affected.",16,"Set_Sales_No_Changing Error")
			TrackError("Set_Sales_No_Changing Error","Could not Set SO "+ALLTRIM(STR(nSalesNum))+" to Changing state.  Amendment number "+ALLTRIM(STR(ThisFormSet.nAmendment))+" may be affected.",PROGRAM(),LINENO(1) )
			lOK = .F.
		ENDIF
		
		RETURN lOK
	ENDPROC

