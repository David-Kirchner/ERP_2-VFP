	PROCEDURE frmEO.pf1.pgShipto.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		
		IF ThisFormSet.ShipAddr > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?"+CHR(13)+"Answer NO to be able to abort this edit.",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6
			IF ThisFormSet.ShipAddr <> 0
				ThisFormSet.ShipAddr = 0
				REPLACE pShipAddr WITH ThisFormSet.ShipAddr IN Sales_No
				THIS.PARENT.txtShipCode.VALUE = 0
			ENDIF
			
			ThisFormSet.Address_Screen("ShipToSave")
			
			THIS.PARENT.cmdSearchShipTo.ENABLED = .T.
		
			THIS.PARENT.txtCompany.VALUE	= ""
			THIS.PARENT.txtAddr1.VALUE		= ""
			THIS.PARENT.txtAddr2.VALUE		= ""
			THIS.PARENT.txtCity.VALUE		= ""
			THIS.PARENT.txtST.VALUE			= ""
			THIS.PARENT.txtZip.VALUE		= ""
			THIS.PARENT.txtCountry.VALUE	= ""
			THIS.PARENT.txtContact.VALUE	= ""
			THIS.PARENT.txtPhone.VALUE		= ""
			THIS.PARENT.txtFax.VALUE		= ""
			THIS.PARENT.txtEmail.VALUE		= ""
			THIS.PARENT.txtLastEdit.VALUE	= ""
		
		
			SELECT Sales_No	&&Sales_No does not have items detail
			REPLACE pShipAddr WITH 0 IN Sales_No	
			
			
		ELSE
			IF THIS.PARENT.cmdEditShipTo.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
					IF USED( 'ShipAddr' )
						USE IN ShipAddr
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.ShipAddr  WITH(NOLOCK)"
					cSQL = cSQL + " WHERE ShipCode = "+STR(ThisFormSet.ShipAddr)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ShipAddr' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ShipAddr' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'ShipAddr')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
					IF USED('ShipAddr')
						*ThisFormSet.ShipAddr = ShipAddr.ShipCode	
						THIS.PARENT.txtShipCode.VALUE = ShipAddr.ShipCode
						THIS.PARENT.txtCompany.VALUE 	= ShipAddr.Company
						THIS.PARENT.txtAddr1.VALUE 		= ShipAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE 		= ShipAddr.Addr2
						THIS.PARENT.txtCity.VALUE 		= ShipAddr.City
						THIS.PARENT.txtST.VALUE 		= ShipAddr.ST
						THIS.PARENT.txtZip.VALUE 		= ShipAddr.Zip
						THIS.PARENT.txtCountry.VALUE 	= UPPER(ALLTRIM(ShipAddr.Country))
						THIS.PARENT.txtContact.VALUE 	= ShipAddr.Contact
						THIS.PARENT.txtPhone.VALUE 		= ShipAddr.Telephone
						THIS.PARENT.txtFax.VALUE 		= ShipAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE 		= ShipAddr.Email
						THIS.PARENT.txtLastEdit.VALUE	= IIF(EMPTY(PrepareSQLdate(ShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(ShipAddr.LastEdit,'LastEdit'))
						
						USE IN ShipAddr
					ENDIF
					ThisFormSet.Address_Screen("ShipToEdit")
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdCopyto.Click
		
		*!*	IF ThisFormSet.SoldAddr > 0
		*!*		* Have Address number!
		*!*		THIS.PARENT.PARENT.pgBillTo.txtSoldCode.VALUE = ThisFormSet.SoldAddr
		*!*		*ThisFormSet.SoldAddr = SalesQuote.pSoldAddr
		
		*!*		IF USED( 'SoldAddr' )
		*!*			USE IN SoldAddr
		*!*		ENDIF
		*!*		SELECT 0
		*!*		PRIVATE cSQL, nSQLEXEC
		*!*		cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK) "
		*!*		cSQL = cSQL + " WHERE SoldCode = "+STR(ThisFormSet.SoldAddr)
		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'SoldAddr' )
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'SoldAddr' )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
		*!*							
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO
		*!*				ENDIF
		*!*		IF nSQLEXEC < 0
		*!*			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'SoldAddr')
		*		RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*		ENDIF
		*!*		IF USED('SoldAddr')
		*!*			ThisFormSet.ShipAddr = 0
		*!*			
		*!*			THIS.PARENT.PARENT.pgBillTo.txtCompany.VALUE 	= SoldAddr.Company
		*!*			THIS.PARENT.PARENT.pgBillTo.txtAddr1.VALUE		= SoldAddr.Addr1
		*!*			THIS.PARENT.PARENT.pgBillTo.txtAddr2.VALUE		= SoldAddr.Addr2
		*!*			THIS.PARENT.PARENT.pgBillTo.txtCity.VALUE 		= SoldAddr.City
		*!*			THIS.PARENT.PARENT.pgBillTo.txtST.VALUE			= SoldAddr.ST
		*!*			THIS.PARENT.PARENT.pgBillTo.txtZip.VALUE		= SoldAddr.Zip
		*!*			THIS.PARENT.PARENT.pgBillTo.txtCountry.VALUE	= UPPER(ALLTRIM(SoldAddr.Country))
		*!*			THIS.PARENT.PARENT.pgBillTo.txtContact.VALUE	= SoldAddr.Contact
		*!*			THIS.PARENT.PARENT.pgBillTo.txtPhone.VALUE		= SoldAddr.Telephone
		*!*			THIS.PARENT.PARENT.pgBillTo.txtFax.VALUE		= SoldAddr.Fax_Number
		*!*			THIS.PARENT.PARENT.pgBillTo.txtEmail.VALUE		= SoldAddr.Email
		*!*			This.Parent.Parent.pgBillTo.txtLastEdit.Value	= IIF(EMPTY(PrepareSQLdate(SoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(SoldAddr.LastEdit,'LastEdit'))
		*!*			*ThisFormSet.Address_Screen("SoldToEdit")
		*!*			
		*!*			USE IN SoldAddr
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
		***
		
		ThisFormSet.ShipAddr = 0
		THIS.PARENT.txtShipCode.VALUE	= 0 &&Blank- so save creates new ID
		REPLACE pShipAddr WITH ThisFormSet.ShipAddr IN Sales_No
		*THIS.PARENT.numShipAddr.VALUE	= 0 
		
		THIS.PARENT.txtCompany.VALUE	= THIS.PARENT.PARENT.pgBillTo.txtCompany.VALUE
		THIS.PARENT.txtAddr1.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtAddr1.VALUE
		THIS.PARENT.txtAddr2.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtAddr2.VALUE
		THIS.PARENT.txtCity.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtCity.VALUE
		THIS.PARENT.txtST.VALUE			= THIS.PARENT.PARENT.pgBillTo.txtST.VALUE
		THIS.PARENT.txtZip.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtZip.VALUE
		THIS.PARENT.txtCountry.VALUE	= UPPER(ALLTRIM(THIS.PARENT.PARENT.pgBillTo.txtCountry.VALUE))
		
		THIS.PARENT.txtContact.VALUE	= THIS.PARENT.PARENT.pgBillTo.txtContact.VALUE
		THIS.PARENT.txtPhone.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtPhone.VALUE
		THIS.PARENT.txtFax.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtFax.VALUE
		THIS.PARENT.txtEmail.VALUE		= THIS.PARENT.PARENT.pgBillTo.txtEmail.VALUE
		This.Parent.txtLastEdit.Value	= ""
		
		ThisFormSet.Address_Screen("ShipToSave")
		*wait window "Remember to Click Save on the Ship Address." NOWAIT
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdCopyto.When
		IF EMPTY(This.Parent.Parent.pgBillTo.txtSoldCode.Value)
			
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdCustomerTerms.Click
		PRIVATE cCompany
		IF NOT LEN(ALLTRIM(This.Parent.Parent.pgBillTo.txtCompany.Value))=0
			cCompany = ALLTRIM(This.Parent.Parent.pgBillTo.txtCompany.Value)
		ELSE
			cCompany = AllTrim(SalesQuote.Company)
		ENDIF
		
		IF FILE("forms\CustomerTerms.scx")
		
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
		
			DO FORM forms\CustomerTerms WITH cCompany 
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		ELSE
			MESSAGEBOX("FILE CustomerTerms.scx NOT FOUND!",0,'')
		ENDIF
		
		SELECT Sales_No	&&This was added to see if this Click code accidentally closed the 'Sales_No' table
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdEditShipTo.Click
		IF THIS.CAPTION != "Save"
			ThisFormSet.Address_Screen("ShipToSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ELSE
			*SAVE
			PRIVATE	nMaxShipCode, nMaxSoldCode, nOldShipCode, nUseShipCode, lSaveAddr1
			PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit,lnShipAddr
			PRIVATE lcContact,lcPhone,lcFax,lcEmail
			PRIVATE mHoldRecordNum
			nMaxShipCode = 0
			lSaveAddr1 = .F.
			nOldShipCode = 0
			nUseShipCode = 0
			
			*ShowSQLtxt("Space Alloys USA'",'Company',25)
			lcCompany =PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',100)
			lcAddr1 = PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',100)
			lcAddr2 = PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',100)
			lcCity  = PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',100)
			lcST    = PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'State',50)
			lcZip   = PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',50)
			lcCountry = UPPER(ALLTRIM(PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',50)))
			lcContact = PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',100)
			lcPhone = PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',50)
			lcFax	 = PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
			lcEmail = PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
			ldLastEdit = DATE()
			lnShipAddr = PrepareSQLnum(ThisFormSet.ShipAddr,'ShipAddr',-3)
			lSaveAddress = .F.
		
			** Do you have anything to save?
			IF NOT LEN(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))=0
				lSaveAddress = .T.
			ENDIF
		
			IF LEN(ALLTRIM(lcCompany))=0
				MESSAGEBOX("Cannot save without an Company name!")
				lSaveAddress = .F.
			ENDIF
			
			PRIVATE lOK
			lOK = .T.
			
			IF lSaveAddress 
				IF USED( 'delShipAddr' )
					USE IN delShipAddr
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.ShipAddr WITH(NOLOCK) "
				cSQL = cSQL + " WHERE "
				cSQL = cSQL + "Company = '"+lcCompany+"' AND "
				cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
				cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
				cSQL = cSQL + "City = '"+lcCity+"' AND "
				cSQL = cSQL + "ST = '"+lcST+"' AND " 
				cSQL = cSQL + "Zip = '"+lcZip+"' AND "
				cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
				cSQL = cSQL + "Contact = '"+lcContact+"' AND "
				cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
				cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
				cSQL = cSQL + "Email = '"+lcEmail+"' "
		*		cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(lnShipAddr))
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'delShipAddr' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'delShipAddr' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delShipAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delShipAddr")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'delShipAddr')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						lOK = .F.
					ENDIF
				ENDIF
				
				IF USED('delShipAddr')
					IF delShipAddr.Cnt < 1
						lSaveAddress = .T.
						
						*Override - Save as HPA Production Work
						IF lcCompany = "Space Alloys USA" OR lcCompany = "HPA " or lcCompany = "Tipton Forge "
							This.parent.parent.pgBillTo.txtSoldCode.Value = 1
							lnShipAddr = 1
							lSaveAddress = .F.
						ENDIF
					ELSE
						lSaveAddress = .F.
						*Already have exact Address
						
						IF USED("tmpCntShipCode")
							USE IN tmpCntShipCode
						ENDIF
						
						cSQL = "SELECT ShipCode FROM dbo.ShipAddr WITH(NOLOCK)"
						cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
						cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
						cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
						cSQL = cSQL + " AND City = '"+lcCity+"'"
						cSQL = cSQL + " AND ST = '"+lcST+"'"
						cSQL = cSQL + " AND Zip = '"+lcZip+"'"
						cSQL = cSQL + " AND Country = '"+lcCountry+"'"
						cSQL = cSQL + " AND Contact = '"+lcContact+"'"
						cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
						cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
						cSQL = cSQL + " AND Email = '"+lcEmail+"'"
					*	cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(lnShipAddr))
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCntShipCode')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntShipCode')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntShipCode")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntShipCode")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCntShipCode')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								lOK = .F.
							ENDIF
						ENDIF
						
						IF USED("tmpCntShipCode")
							IF VARTYPE(tmpCntShipCode.ShipCode) = 'N'
								lnShipAddr = tmpCntShipCode.ShipCode
								ThisFormSet.ShipAddr = lnShipAddr
								REPLACE pShipAddr WITH ThisFormSet.ShipAddr IN Sales_No
							ENDIF
							USE IN tmpCntShipCode
						ENDIF
							
							
						*****
						IF lOK
							IF EMPTY(ThisFormSet.ShipAddr)
		
								*Find the ShipCode and display it
								IF USED( 'shipcodeShipAddr' )
									USE IN shipcodeShipAddr
								ENDIF
								
								PRIVATE cSQL, nSQLEXEC
								cSQL = "SELECT shipcode FROM dbo.ShipAddr WITH(NOLOCK) "
								cSQL = cSQL + " WHERE "
								cSQL = cSQL + "Company = '"+lcCompany+"' AND "
								cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
								cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
								cSQL = cSQL + "City  = '"+lcCity+"' AND "
								cSQL = cSQL + "ST    = '"+lcST+"' AND " 
								cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
								cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
								cSQL = cSQL + "Contact = '"+lcContact+"' AND "
								cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
								cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
								cSQL = cSQL + "Email = '"+lcEmail+"'"
								
								SELECT 0
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'shipcodeShipAddr' )
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'shipcodeShipAddr' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "shipcodeShipAddr")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "shipcodeShipAddr")
											
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'shipcodeShipAddr')
										RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
										lOK = .F.
									ENDIF
								ENDIF
		
								IF USED('shipcodeShipAddr')
									IF shipcodeShipAddr.shipcode > 0
										ThisFormSet.ShipAddr = shipcodeShipAddr.shipcode
										THIS.PARENT.txtShipCode.REFRESH
										REPLACE pShipAddr WITH ThisFormSet.ShipAddr IN Sales_No
										
										ThisFormSet.Set_Sales_No_Chng()
										
									ENDIF
									USE IN shipcodeShipAddr
								ENDIF
							ENDIF  &&EMPTY(ThisFormSet.ShipAddr)
						ENDIF &&lOK
						
					ENDIF &&delShipAddr.Cnt
					
					USE IN delShipAddr
				ELSE &&USE IN delShipAddr
					lSaveAddress = .F.
				ENDIF
			ENDIF &&IF lSaveAddress
			
			*****
			
			IF lSaveAddress AND lOK
				PRIVATE	cSaveNew
		
				IF lnShipAddr > 0
					nSaveNew = MESSAGEBOX("Save as new Address?"+CHR(13)+;
					"Answer 'YES' to save as new address"+CHR(13)+;
					"when the Company has moved or"+CHR(13)+;
					"when this is a different address location."+CHR(13)+CHR(13)+;
					"Answer 'No' if you are correcting typeing error.";
					,4+32,"New Address?")
					
					IF nSaveNew = 7 && No
						IF USED( 'cntSales_No' )
							USE IN cntSales_No
						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.Sales_No WITH(NOLOCK) "
						cSQL = cSQL + " WHERE pShipAddr= "+STR(lnShipAddr )
						cSQL = cSQL + " AND Sales_No.CNCLD = 0 AND Sales_No.CMPLT = 0"
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntSales_No' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSales_No' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSales_No")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSales_No")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntSales_No')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								lOK = .F.
							ENDIF
						ENDIF
						IF USED('cntSales_No')
							IF cntSales_No.cnt > 0
								
								MESSAGEBOX("There are Orders that have not shipped that will be changed!"+CHR(13)+CHR(13)+;
								ALLTRIM(STR(cntSales_No.cnt))+" unshipped Order(s) use the Address number "+;
								ALLTRIM(STR(lnShipAddr))+".",0+16,"CAUTION")
								
							ENDIF
		
							USE IN cntSales_No
						ENDIF
						
						SELECT Sales_No	&&Sales_No does not have items detail
						REPLACE pShipAddr WITH lnShipAddr IN Sales_No
						
						ThisFormSet.ShipAddr = lnShipAddr 
						REPLACE pShipAddr WITH ThisFormSet.ShipAddr IN Sales_No
					ENDIF
					
					IF nSaveNew = 6 && Yes
						IF MESSAGEBOX("Do you want to mark the old Address as INACTIVE ?"+CHR(13)+CHR(13)+;
							"Inactive address will not show when you search for an address."+CHR(13)+;
							"If the company has moved,"+CHR(13)+;
							"permantly leaving the address,"+CHR(13)+;
							"please mark the old address as inactive now.",4,"") = 6
							
							
							*Mark as InaActive
							PRIVATE cSQLu
							cSQLu= "UPDATE dbo.ShipAddr SET "
							cSQLu= cSQLu+" ShipAddr.InActive = 1"
							cSQLu= cSQLu+" WHERE ShipCode = "+STR(lnShipAddr)
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
										
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQLu ,ThisFormSet.nConnHandle, nSQLEXEC, '')
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
									lOK = .F.
								ENDIF
							ENDIF
							
						ENDIF
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					nSaveNew = 6
				ENDIF
		
				IF nSaveNew = 6 AND lOK	&& Yes, save as new
					****** big save procedure********
					IF ThisFormSet.ShipAddr > 0 &&Check old ShipCode to see if anything changed.
						*Check old ShipCode to see if anything changed
						IF USED( 'cntShipAddr' )
							USE IN cntShipAddr
						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS cnt FROM dbo.ShipAddr WITH(NOLOCK) "
						cSQL = cSQL + " WHERE "
						cSQL = cSQL + "Company = '"+lcCompany+"' AND "
						cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
						cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
						cSQL = cSQL + "City  = '"+lcCity+"' AND "
						cSQL = cSQL + "ST    = '"+lcST+"' AND " 
						cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
						cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
						cSQL = cSQL + "Contact = '"+lcContact+"' AND "
						cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
						cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
						cSQL = cSQL + "Email = '"+lcEmail+"' "
		*				cSQL = cSQL + " AND shipcode = "+STR(ThisFormSet.ShipAddr)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntShipAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntShipAddr' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntShipAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntShipAddr")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntShipAddr')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								lOK = .F.
							ENDIF
						ENDIF
						IF USED('cntShipAddr')
							IF cntShipAddr.Cnt = 0
		*						*-no change - do not save
								*Did not find - Save
								lSaveAddr1 = .T.
								nOldShipCode = ThisFormSet.ShipAddr
							ELSE 
								*Found match - do not need to save
								lSaveAddr1 = .F.
							ENDIF
						ELSE &&failed - add as new
							lSaveAddr1 = .T.
						ENDIF 
						
					ELSE && No ShipCode - add if have data
						IF LEN( ALLTRIM(THIS.PARENT.txtCompany.VALUE+THIS.PARENT.txtAddr1.VALUE)) > 1
							lSaveAddr1 = .T.
						ELSE
							*No Company or Address to save! Clear!!!
							lSaveAddr1 = .F.
						ENDIF
					ENDIF
		
					IF lSaveAddr1 AND lOK
						WAIT WINDOW "Saving 'Ship To' address." NOWAIT
		
						*save same as SoldCode (if avalable)
						IF ThisFormSet.SoldAddr <> ThisFormSet.ShipAddr
						
							IF USED("cntShipCode")
								USE IN cntShipCode
							ENDIF
							
							cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.ShipAddr WITH(NOLOCK)"
							cSQL = cSQL + " WHERE ShipCode = "+STR(ThisFormSet.SoldAddr)
							
							SELECT 0
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntShipCode')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntShipCode')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntShipCode")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntShipCode")
										
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntShipCode')
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								ENDIF
							ENDIF
							IF USED("cntShipCode")
								IF cntShipCode.cnt = 0
									*Not Found
									nUseShipCode = ThisFormSet.SoldAddr
								ENDIF
								USE IN cntShipCode
							ELSE
							ENDIF
						ENDIF
						IF nUseShipCode = 0 &&need to find a ShipCode
							*			Get next code nMaxShipCode
							nMaxSoldCode = get_MaxSoldCode()
							*nMaxSoldCode = ThisFormSet.maxSoldCode()
							*nMaxShipCode = ThisFormSet.maxShipCode()
							nMaxShipCode = get_MaxShipCode()
							nUseShipCode = MAX( nMaxSoldCode, nMaxShipCode )
		
						ENDIF
						IF nUseShipCode > 0 &&Save here
							ThisFormSet.ShipAddr = nUseShipCode
							REPLACE pShipAddr WITH ThisFormSet.ShipAddr IN Sales_No
							THIS.PARENT.txtShipCode.VALUE = nUseShipCode
		*					THIS.PARENT.numShipAddr.VALUE = nUseShipCode
							lnShipAddr = nUseShipCode
							
							Save_ShipAddrCode(nUseShipCode, "ShipAddr", nOldShipCode, ThisFormSet.nConnHandle)
							
							IF ThisFormSet.SalesNum > 0
		*!*							*Save ShipCode now to Sales_No
		*!*							*so the ShipAddr insert trigger knows what Sales_No in email.
		*!*							cSQL = "UPDATE dbo.Sales_No "
		*!*							cSQL = cSQL + " SET pShipAddr = "+STR(nUseShipCode)
		*!*							cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
		*!*							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL 1' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		*!*							ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntShipCode")
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntShipCode")
		*!*									
		*!*								IF nSQLEXEC < 0
		*!*									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*										nSQLEXEC = 0
		*!*									ENDIF
		*!*								ENDIF
		*!*							ENDDO
		*!*						ENDIF
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		*!*							ENDDO
		*!*							
		*!*							IF nSQLEXEC < 0 &&Try again!, long triger
		*!*								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		*!*								DO WHILE nSQLEXEC = 0
		*!*									WAIT WINDOW 'SQL' TIMEOUT 1
		*!*									nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		*!*								ENDDO
		*!*							ENDIF
		*!*							
		*!*							IF nSQLEXEC < 0
		*!*								IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC)
		*							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*							ENDIF
		
								SELECT Sales_No	&&Sales_No does not have items detail
								REPLACE pShipAddr WITH nUseShipCode IN Sales_No
							ENDIF
							
							PRIVATE cSQLi
							cSQLi = "INSERT INTO dbo.ShipAddr (shipcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number, Email, Customer, LastEdit) VALUES "
							cSQLi = cSQLi+"("+STR(nUseShipCode)+""
							cSQLi = cSQLi+",'"+lcCompany+"'"
							cSQLi = cSQLi+",'"+lcAddr1+"'"
							cSQLi = cSQLi+",'"+lcAddr2+"'"
							cSQLi = cSQLi+",'"+lcCity+"'"
							cSQLi = cSQLi+",'"+lcST+"'"
							cSQLi = cSQLi+",'"+lcZip+"'"
							cSQLi = cSQLi+",'"+lcCountry+"'"
							cSQLi = cSQLi+",'"+lcContact+"'"
							cSQLi = cSQLi+",'"+lcPhone+"'"
							cSQLi = cSQLi+",'"+lcFax+"'"
							cSQLi = cSQLi+",'"+lcEmail+"'"
							cSQLi = cSQLi+",''"		&&+ALLTRIM(STR(nUseShipCode,10,0))+""
							cSQLi = cSQLi+",'"+DTOC(DATE())+"' )"
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi)
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
										
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQLi ,ThisFormSet.nConnHandle, nSQLEXEC ,'')
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
									lOK = .F.
								ENDIF
							ENDIF
							
							
							IF ThisFormSet.SoldAddr > 0 AND lOK
								Save_Sold_Ship(ThisFormSet.SoldAddr, nUseShipCode,ThisFormSet.nConnHandle)
							ENDIF
							
							*****************
							
							IF ThisFormSet.SalesNum > 0 AND lOK
								IF Count_SOinPackingSlip_No( ThisFormSet.SalesNum, ThisFormSet.nConnHandle ) > 0
									MESSAGEBOX("This Order has been Packed for shipping!"+CHR(13)+;
									"The Packing Slip database will be updated with this new address.",0+48,"")
		
									IF Update_ShipCodeinPackingSlip_No( nUseShipCode, ThisFormSet.SalesNum, ThisFormSet.nConnHandle )
										TrackMess("Sales Order "+ALLTRIM(STR(ThisFormSet.SalesNum))+" Ship Address "+ALLTRIM(STR(nUseShipCode))+" Edit updated the PackingSlip that has already been printed. "+CHR(13)+SYS(16,1))
									ENDIF
		
								ENDIF
							ENDIF		
							******************
							IF lOK
								THIS.PARENT.txtLastEdit.VALUE = DATE()
								THIS.PARENT.txtLastEdit.REFRESH
							ENDIF
						ENDIF
						WAIT CLEAR
					ENDIF
				ELSE   &&IF nSaveNew = 6 && Yes
					*Save - not as new!
					*REPLACE DATA
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.ShipAddr SET "
					cSQLu= cSQLu+" Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
					cSQLu= cSQLu+",Customer="+ALLTRIM(STR(nUseShipCode,10,0))+""
					cSQLu= cSQLu+",LastEdit='"+DTOC(DATE())+"'"
					cSQLu= cSQLu+" WHERE ShipAddr.ShipCode = "+STR(lnShipAddr)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu ,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
							lOK = .F.
						ENDIF
					ENDIF
						
					IF lOK
						ThisFormSet.UpdateCustID = .T.
						THIS.PARENT.txtLastEdit.VALUE = DATE()
						THIS.PARENT.txtLastEdit.REFRESH
					ENDIF
				ENDIF  &&  &&IF nSaveNew = 6 && Yes
			ENDIF &&IF lSaveAddress
			
			IF lnShipAddr = 0
				MESSAGEBOX("Could not Save"+CHR(13)+"ShipAddr = 0",0,"Not Saved")
			ENDIF
			
			IF ThisFormSet.SalesNum > 0 AND lnShipAddr > 0 AND lOK
		*!*			*Save to dbo.Sales_No
		*!*			PRIVATE cSQL, nSQLEXEC 
		*!*			cSQL = "UPDATE dbo.Sales_No "
		*!*			cSQL = cSQL + " SET pShipAddr = "+STR(lnShipAddr)
		*!*			cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
		
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL,"")
		
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 1' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
		*!*							
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO
		*!*				ENDIF
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, '')
		*			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*			ELSE
		*!*				ThisFormSet.ShipAddr = lnShipAddr
		*!*			ENDIF
				
				SELECT Sales_No	&&Sales_No does not have items detail
				REPLACE pShipAddr WITH lnShipAddr IN Sales_No
			
			ENDIF
			
			IF lOK
				ThisFormSet.Address_Screen("ShipToEdit")
				THISFORM.cmdNext.SETFOCUS()
			ENDIF
		
		ENDIF &&THIS.CAPTION = "Save"
		
		IF USED( 'delShipAddr' )
			USE IN delShipAddr
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdGetShipInfo.Click
		
		IF NOT Empty(ThisFormSet.ShipAddr)
		
			PRIVATE aShipInfo
			
		*	SELECT shiproute, instrct FROM shipaddr WHERE shipcode = ThisFormSet.ShipAddr INTO ARRAY aShipInfo
			IF USED( 'cntShipAddr' )
				USE IN cntShipAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT ShipRoute, Instrct FROM dbo.ShipAddr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE "
			cSQL = cSQL + " ShipCode = "+STR(ThisFormSet.ShipAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntShipAddr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntShipAddr")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntShipAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			******************************
			*IF VARTYPE(cntShipAddr.ShipRoute) = "C"
			*	This.Parent.txtShipRoute.Value = cntShipAddr.ShipRoute
			*	IF ASCAN(aShipRoutes, aShipAddr.ShipRoute )  > 0
			*		gnPos = ASCAN(aShipRoutes, cntShipAddr.ShipRoute ) 
			*	ENDIF
			*ENDIF
			
			******************************
			PRIVATE nMess,cShipRouteSA, cShipRouteCurr
			cShipRouteSA	= ALLTRIM(ShowSQLtxt(cntShipAddr.ShipRoute,'ShipRoute',20))
			cShipRouteCurr	= ALLTRIM(ShowSQLtxt(This.Parent.txtShipRoute.Value,'ShipRoute',20))
			IF LEN(cShipRouteSA) = 0 
				IF LEN(cShipRouteCurr) > 0
					*nMess = MESSAGEBOX("Do you want to remove the Ship Route?"+CHR(13)+"Remove "+cShipRouteSA+" ?",4+32,"Clear Ship Route?")
					*IF nMess = 7
					*	This.Parent.txtShipRoute.Value = ''
					*	REPLACE ShipRoute WITH '' IN Sales_No
					*ELSE
						*No change
					*ENDIF
				ENDIF
			ELSE		&&cShipRouteSA has data
				IF LEN(cShipRouteCurr) > 0
					IF cShipRouteCurr != cShipRouteSA
						nMess = MESSAGEBOX("Do you want to use the Address default Ship Route "+cShipRouteSA+" ?"+CHR(13)+"ShipRoute is "+cShipRouteCurr ,4+32,"Replace Ship Route?")
						IF nMess = 7
							This.Parent.txtShipRoute.Value = cShipRouteSA
							REPLACE ShipRoute WITH cShipRouteSA IN Sales_No
						ELSE
							*No change
						ENDIF
					ELSE
						*No change, already the same
					ENDIF
				ELSE
					This.Parent.txtShipRoute.Value = cShipRouteSA
					REPLACE ShipRoute WITH cShipRouteSA IN Sales_No
				ENDIF
			ENDIF
		
			******************************
			IF VARTYPE(cntShipAddr.Instrct) = "C"
				This.Parent.txtInstrct.Value = cntShipAddr.Instrct 
				REPLACE Instrct WITH cntShipAddr.Instrct IN Sales_No
				This.Parent.txtInstrct.Refresh
			ENDIF
			
			IF USED( 'cntShipAddr' )
				USE IN cntShipAddr
			ENDIF
		
		ELSE
		
			messagebox("ShipAddr code is empty",0,'')
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdPaymentStatus.Click
		IF FILE("forms\CustomerStatus.scx")
		
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
			
			PRIVATE cCustID
			cCustID = PrepareSQLtxt(SalesQuote.CustID,'CustID',20)
			IF LEN(ALLTRIM(cCustID))=0
				*Not sure why SalesQuote.CustID is lost
				cCustID = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)
				IF NOT LEN(ALLTRIM(cCustID))=0
					SELECT SalesQuote
					REPLACE CustID WITH cCustID IN SalesQuote
				ENDIF
			ENDIF
			*This.Parent.cmdCustomerID.Caption = cCustID
			
			DO FORM forms\CustomerStatus WITH cCustID, SalesQuote.Company, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle 
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		
		ELSE
			MESSAGEBOX("FILE CustomerStatus.scx NOT FOUND!",0,'')
		ENDIF
		
		
		SELECT Sales_No	&&This was added to see if this Click code accidentally closed the 'Sales_No' table
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdPeach.Click
		PRIVATE cCompany
		cCompany= AllTrim(SalesQuote.Company)
		
		PRIVATE cCustID
		cCustID = PrepareSQLtxt(SalesQuote.CustID,'CustID',20)
		IF LEN(ALLTRIM(cCustID))=0
			*Not sure why SalesQuote.CustID is lost
			cCustID = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)
			IF LEN(ALLTRIM(cCustID)) > 1
				SELECT SalesQuote
				REPLACE CustID WITH cCustID IN SalesQuote
			ENDIF
		ENDIF
		
		
		IF FILE("forms\MatchCustomerID.scx")
		
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTop
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
			DO FORM forms\MatchCustomerID WITH cCustID, cCompany
			
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
			
		*!*		**Save to SQL  --UpdtItemSale() does ItemSale,Quoted_QTY,Quoted_P,Quoted_Total,Quoted_PU
		*!*		cSQL = "UPDATE dbo.AllQuotes SET "
		*!*		cSQL = cSQL + " CustID = '"+CustID+"'"
		*!*		cSQL = cSQL + " WHERE SalesNum = "+STR( ThisFormSet.SalesNum )
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delShipAddr")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delShipAddr")
		
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF
		*!*		IF nSQLEXEC < 0
		*!*			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC )
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*			*RETURN
		*!*		ENDIF
		*!*		
		*!*			
		*!*		SELECT SalesQuote
		*!*		PRIVATE nCurrentRec 
		*!*		nCurrentRec = RECNO('SalesQuote')
		*!*		SELECT SalesQuote
		*!*		REPLACE ALL CustID WITH cCustID 
		*!*		GOTO (nCurrentRec)
			
		ELSE
			MESSAGEBOX("Could not find 'MatchCustomerID' to run",0+16,"Error")
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdRemoveShipInfo.Click
		PRIVATE cShipRoute, cInstrct
		cShipRoute	= PrepareSQLtxt(This.Parent.txtShipRoute.Value,"ShipRoute",50)
		cInstrct	= PrepareSQLtxt(This.Parent.txtInstrct.Value,"Instrct",100)
		
		IF NOT Empty(ThisFormSet.ShipAddr)
		
			*Remove the ShipRoute, Instruct FROM the Address table, not this SO
			PRIVATE cSQLu, nSQLEXEC 
			cSQLu= "UPDATE dbo.ShipAddr SET "
			cSQLu= cSQLu+" ShipRoute = '' "
			cSQLu= cSQLu+",Instrct = '' " 
			cSQLu= cSQLu+",LastEdit=GetDate() "
			cSQLu= cSQLu+" WHERE ShipCode = "+STR(ThisFormSet.ShipAddr)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQLu ,ThisFormSet.nConnHandle, nSQLEXEC ,'')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("ShipAddr Code is empty",0,'No ShipAddr Code')
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdSaveShipInfo.Click
		PRIVATE cShipRoute, cInstrct
		cShipRoute	= PrepareSQLtxt(This.Parent.txtShipRoute.Value,"ShipRoute",50)
		cInstrct	= PrepareSQLtxt(This.Parent.txtInstrct.Value,"Instrct",100)
		
		IF NOT Empty(ThisFormSet.ShipAddr)
			
			PRIVATE cSQLu, nSQLEXEC 
			cSQLu= "UPDATE dbo.ShipAddr SET "
			cSQLu= cSQLu+" ShipRoute = '"+cShipRoute+"'"
			cSQLu= cSQLu+", Instrct = '"+cInstrct+"'"
			cSQLu= cSQLu+", LastEdit=GetDate() "
			cSQLu= cSQLu+" WHERE ShipCode = "+STR(ThisFormSet.ShipAddr)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQLu ,ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("ShipAddr Code is empty",0,'No ShipAddr Code')
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdSearchShipTo.Click
		PRIVATE matchCodes, nNewShipToCodem, lcCurrTable
		nNewShipToCode = 0
		matchCodes = 0
		PRIVATE nUseSoldCodes 
		
		lcCurrTable = ALIAS()
		IF NOT USED('SALESQUOTE')
			MESSAGEBOX("'SALESQUOTE' table is not opened.",16,"Error")
			RETURN
		ENDIF
		
		PRIVATE cUseCompany
		cUseCompany = ShowSQLtxt(SalesQuote.Company,"Company",30,.F.,.T.)
		
		IF LEN(ALLTRIM(cUseCompany))=0
			cUseCompany = ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30,.F.,.T.)
		ELSE
			IF NOT LEN(ALLTRIM( ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30,.F.,.T.) ))=0
				IF cUseCompany != ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30,.F.,.T.)
					IF MESSAGEBOX("The Search will be on the Company name Quoted: "+cUseCompany+CHR(13)+"Answer No to use the name: "+ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30),3,"Search for "+cUseCompany  )=7
						cUseCompany = ShowSQLtxt(This.Parent.txtCompany.Value,"Company",30,.F.,.T.)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.F.
		ENDIF
		lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.F.
		ENDIF
		
		DO FORM Forms\SearchForm WITH "ShipAddr",cUseCompany,ThisFormSet.nConnHandle TO nNewShipToCode
		*DO FORM SearchForm WITH "ShipAddr",SalesQuote.company TO nNewShipToCode
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.T.
		ENDIF
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.T.
		ENDIF
		
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT LEN(ALLTRIM(lcCurrTable))=0
				SELECT (lcCurrTable)
			ELSE
				SELECT SalesQuote
			ENDIF
		ENDIF
		
		
		IF nNewShipToCode > 0
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.ShipAddr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE ShipCode = "+STR(nNewShipToCode)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aShipAddr")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aShipAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
				
			IF USED( 'aShipAddr' )
				*ThisFormSet.ShipAddr = aShipAddr.ShipCode
				
				IF ThisFormSet.ShipAddr > 0 AND ThisFormSet.ShipAddr <> nNewShipToCode
					Track_Sales_No_Chng( "Change ShipTo from "+ALLTRIM(STR(ThisFormSet.ShipAddr))+" to "+ALLTRIM(STR(nNewShipToCode)),ThisFormSet.SalesNum,.F.,ThisFormSet.nAmendment )
					ThisFormSet.Set_Sales_No_Chng()
				ENDIF
				ThisFormSet.ShipAddr = nNewShipToCode
				REPLACE pShipAddr WITH ThisFormSet.ShipAddr IN Sales_No
				
				THIS.PARENT.txtShipCode.VALUE = aShipAddr.ShipCode
				THIS.PARENT.txtCompany.VALUE = aShipAddr.company
				THIS.PARENT.txtAddr1.VALUE = aShipAddr.Addr1
				THIS.PARENT.txtAddr2.VALUE = aShipAddr.Addr2
				THIS.PARENT.txtCity.VALUE = aShipAddr.City
				THIS.PARENT.txtST.VALUE = aShipAddr.ST
				THIS.PARENT.txtZip.VALUE = aShipAddr.Zip
				THIS.PARENT.txtCountry.VALUE = UPPER(ALLTRIM(aShipAddr.Country))
				THIS.PARENT.txtContact.VALUE = aShipAddr.Contact
				THIS.PARENT.txtPhone.VALUE = aShipAddr.Telephone
				THIS.PARENT.txtFax.VALUE = aShipAddr.Fax_Number
				THIS.PARENT.txtEmail.VALUE = aShipAddr.Email
				This.parent.txtLastEdit.Value = IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
				
				***********************************************************
				*** other fields found in ShipAddr 
				*** *cShipRoute cInstrct lBlind cPayType cShipPay cCountry 
				***********************************************************
				PRIVATE cShipRoute 
				cShipRoute = ShowSQLtxt( aShipAddr.ShipRoute,"ShipRoute",20)
				IF NOT LEN(ALLTRIM(cShipRoute))=0
					IF LEN(ALLTRIM(THIS.PARENT.txtShipRoute.VALUE)) = 0
						THIS.PARENT.txtShipRoute.VALUE = cShipRoute
					ELSE
						IF NOT THIS.PARENT.txtShipRoute.VALUE = cShipRoute
							MESSAGEBOX("ShipRoute of "+ALLTRIM(THIS.PARENT.txtShipRoute.VALUE)+CHR(13)+"is being replaced with "+ALLTRIM(cShipRoute),48,"Ship Address replacement.")
							THIS.PARENT.txtShipRoute.VALUE = cShipRoute
						ENDIF
					ENDIF
					
					IF ASCAN(aShipRoutes, aShipAddr.ShipRoute )  > 0
						*Global Position for Array aShipRoutes
						gnPos = ASCAN(aShipRoutes, aShipAddr.ShipRoute ) 
					ENDIF
					SELECT Sales_No 	&&Sales_No does not have items detail
					REPLACE ShipRoute WITH aShipAddr.ShipRoute IN Sales_No
				ENDIF
				****
				PRIVATE cInstrct 
				cInstrct = ShowSQLtxt(aShipAddr.instrct,'instrct',100)
				IF NOT LEN(ALLTRIM(cInstrct))=0
					IF LEN(ALLTRIM(THIS.PARENT.txtInstrct.VALUE)) = 0
						THIS.PARENT.txtInstrct.VALUE = cInstrct
					ELSE
						IF NOT THIS.PARENT.txtInstrct.VALUE = cInstrct
							MESSAGEBOX("Instruction of "+ALLTRIM(THIS.PARENT.txtInstrct.VALUE)+CHR(13)+"is being replaced with "+ALLTRIM(cInstrct),48,"Ship Address replacement.")
							THIS.PARENT.txtInstrct.VALUE = cInstrct
						ENDIF
					ENDIF
					
					THIS.PARENT.txtInstrct.VALUE = aShipAddr.instrct
					SELECT Sales_No	&&Sales_No does not have items detail
					REPLACE Instrct WITH aShipAddr.instrct IN Sales_No
				ENDIF
				****
		
				PRIVATE lBlindSO, lBlind
				lBlindSO = PrepareSQLlogic(THIS.PARENT.chkBlindSO.VALUE,"Blind",.F.)
				lBlind	= PrepareSQLlogic(aShipAddr.Blind,"Blind",.F.)
				
			
				IF lBlind 
					IF lBlindSO 
						*THIS.PARENT.chkBlindSO.VALUE = aShipAddr.Blind
					ELSE
						MESSAGEBOX("Send Blind is being Changed to True for this Address.",48,"Ship Address replacement.")
						THIS.PARENT.chkBlindSO.VALUE = PrepareSQLchk(aShipAddr.Blind,'Blind')
						
						SELECT Sales_No	&&Sales_No does not have items detail
						REPLACE Blind WITH PrepareSQLlogic(aShipAddr.Blind,'Blind',.F.) IN Sales_No
					ENDIF
				ELSE
					IF lBlindSO 
						MESSAGEBOX("Send Blind is being Changed to True for this Address.",48,"Ship Address replacement.")
						THIS.PARENT.chkBlindSO.VALUE = PrepareSQLchk(aShipAddr.Blind,'Blind')
						
						SELECT Sales_No	&&Sales_No does not have items detail
						REPLACE Blind WITH PrepareSQLlogic(aShipAddr.Blind,'Blind',.F.) IN Sales_No
					ELSE
						*THIS.PARENT.chkBlindSO.VALUE = aShipAddr.Blind
					ENDIF
				ENDIF
			
		
				****
				PRIVATE cPayType
				cPayType = ShowSQLtxt(aShipAddr.PayType,"PayType",10)
				IF NOT LEN(ALLTRIM(cPayType))=0
					IF LEN(ALLTRIM(THIS.PARENT.cmbPayment.VALUE)) = 0
						THIS.PARENT.cmbPayment.VALUE = cPayType
						
						SELECT Sales_No	
						REPLACE PayType WITH cPayType IN Sales_No
					ELSE
						IF NOT THIS.PARENT.cmbPayment.VALUE = cPayType
							MESSAGEBOX("Payment of "+ALLTRIM(THIS.PARENT.cmbPayment.VALUE)+CHR(13)+"is being replaced with "+ALLTRIM(cPayType),48,"Ship Address replacement.")
							This.Parent.cmbPayment.Value = cPayType
							
							SELECT Sales_No	
							REPLACE PayType WITH cPayType IN Sales_No
						ENDIF
					ENDIF	
				ENDIF
				
				****
				PRIVATE cShipPay
				cShipPay = ShowSQLtxt(aShipAddr.ShipPay,"ShipPay",11)
				IF NOT LEN(ALLTRIM(cShipPay))=0
					IF LEN(ALLTRIM(THIS.PARENT.cmbFrtPayment.VALUE)) = 0
						THIS.PARENT.cmbFrtPayment.VALUE = cShipPay
						
						SELECT Sales_No	
						REPLACE ShipPay WITH cShipPay IN Sales_No
					ELSE
						IF NOT THIS.PARENT.cmbFrtPayment.VALUE = cShipPay
							MESSAGEBOX("Payment of "+ALLTRIM(THIS.PARENT.cmbFrtPayment.VALUE)+CHR(13)+"is being replaced with "+ALLTRIM(cShipPay),48,"Ship Address replacement.")
							This.Parent.cmbFrtPayment.Value = cShipPay
							
							SELECT Sales_No	
							REPLACE ShipPay WITH cShipPay IN Sales_No
						ENDIF
					ENDIF	
				ENDIF
				
				****		
				PRIVATE cCountry
				cCountry = ShowSQLtxt(aShipAddr.Country,"Country",50)
			
				IF UPPER(cCountry) = "US" OR UPPER(cCountry) = "USA" 
					*update Sales_No.USA
					IF NOT PrepareSQLlogic(THIS.PARENT.chkUSA.VALUE,'USA',.F.) 
						This.Parent.chkUSA.Value = 1
						*ThisFormset.frmEO.pf1.pgShipto.chkUSA.Value = 1
					ENDIF
					SELECT Sales_No	&&Sales_No does not have items detail
					REPLACE USA WITH .T. IN Sales_No
				ENDIF
					
				****		
		
				ThisFormSet.Address_Screen("ShipToEdit")
				
				*****************
				IF ThisFormSet.SalesNum > 0
					IF Count_SOinPackingSlip_No( ThisFormSet.SalesNum, ThisFormSet.nConnHandle ) > 0
						MESSAGEBOX("This Order has been Packed for shipping!"+CHR(13)+;
						"The Packing Slip database will be updated with this new address.",0+48,;
						"A Packing Slip with the old address has already been Printed!")
						
						IF Update_ShipCodeinPackingSlip_No( ThisFormSet.ShipAddr, ThisFormSet.SalesNum, ThisFormSet.nConnHandle )
							TrackMess("Sales Order "+ALLTRIM(STR(ThisFormSet.SalesNum))+" Ship Address "+ALLTRIM(STR(ThisFormSet.ShipAddr))+" Edit updated the PackingSlip that has already been printed. "+CHR(13)+SYS(16,1))
						ENDIF
					ENDIF
				ENDIF		
				******************
				
				USE IN aShipAddr
			ENDIF
		
			**********************************************
			**********************************************
			*Check BillToAddress - The Other Address screen
			IF EMPTY(This.Parent.Parent.pgBillTo.txtCompany.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtAddr1.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtAddr2.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtCity.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtST.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtZip.Value) ;
				AND EMPTY(This.Parent.Parent.pgBillTo.txtCountry.Value)
		
				*See if billing address can be filled in.
				IF USED( 'delSoldAddr' )
					USE IN delSoldAddr
				ENDIF
				
				cSQL = "SELECT TOP 1 Sold_Ship.SoldCode"
				cSQL = cSQL + " FROM dbo.Sold_Ship WITH(NOLOCK), dbo.SoldAddr WITH(NOLOCK) "
				cSQL = cSQL + " WHERE Sold_Ship.SoldCode = SoldAddr.SoldCode "
				cSQL = cSQL + " AND SoldAddr.InActive = 0 "
				cSQL = cSQL + " AND Sold_Ship.ShipCode = "+STR(nNewShipToCode)
				cSQL = cSQL + " ORDER BY Sold_Ship.SoldCode"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'delSoldAddr')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'delSoldAddr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delSoldAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delSoldAddr")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'delSoldAddr')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
				IF USED( 'delSoldAddr' )
					IF VARTYPE(	delSoldAddr.SoldCode ) = "N"
					
						WAIT WINDOW "Found 'Bill To' address last used with this 'Sold To' address!" NOWAIT
						nUseSoldCodes = delSoldAddr.SoldCode
						USE IN delSoldAddr
		
						IF USED( 'aSoldAddr' )
							USE IN aSoldAddr
						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK)"
						cSQL = cSQl + " WHERE SoldAddr.SoldCode = "+STR(nUseSoldCodes)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSoldAddr")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSoldAddr')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							ENDIF
						ENDIF
						
						IF USED( 'aSoldAddr' )
							IF ThisFormSet.SoldAddr <> aSoldAddr.SoldCode AND aSoldAddr.SoldCode > 0
								ThisFormSet.SoldAddr = aSoldAddr.SoldCode
								REPLACE pSoldAddr WITH ThisFormSet.SoldAddr IN Sales_No
								
								THIS.PARENT.PARENT.pgBillTo.txtSoldCode.VALUE = aSoldAddr.SoldCode
				*				THIS.PARENT.PARENT.pgBillTo.numSoldAddr.VALUE = aSoldAddr
								THIS.PARENT.PARENT.pgBillTo.txtCompany.VALUE = aSoldAddr.Company
								THIS.PARENT.PARENT.pgBillTo.txtAddr1.VALUE = aSoldAddr.Addr1
								THIS.PARENT.PARENT.pgBillTo.txtAddr2.VALUE = aSoldAddr.Addr2
								THIS.PARENT.PARENT.pgBillTo.txtCity.VALUE = aSoldAddr.City
								THIS.PARENT.PARENT.pgBillTo.txtST.VALUE = aSoldAddr.ST
								THIS.PARENT.PARENT.pgBillTo.txtZip.VALUE = aSoldAddr.Zip
								THIS.PARENT.PARENT.pgBillTo.txtCountry.VALUE = UPPER(ALLTRIM(aSoldAddr.Country))
								THIS.PARENT.PARENT.pgBillTo.txtMarketing.VALUE = PrepareSQLtxt(aSoldAddr.Marketing,'Marketing',100)
								THIS.PARENT.PARENT.pgBillTo.txtContact.VALUE = aSoldAddr.Contact
								THIS.PARENT.PARENT.pgBillTo.txtPhone.VALUE = aSoldAddr.TelePhone
								THIS.PARENT.PARENT.pgBillTo.txtFax.VALUE = aSoldAddr.Fax_Number
								THIS.PARENT.PARENT.pgBillTo.txtEmail.VALUE = aSoldAddr.Email
								THIS.PARENT.PARENT.pgBillTo.txtLastEdit.VALUE = IIF(EMPTY(PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit'))
								
								ThisFormSet.Address_Screen("SoldToEdit")
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF	&&Code to update other Address BillTo
			**********************************************
			
			**************************************************
			IF ThisFormSet.SalesNum > 0 AND nNewShipToCode > 0
		
					ThisFormSet.ShipAddr = nNewShipToCode
					SELECT Sales_No	&&Sales_No does not have items detail
					REPLACE pShipAddr WITH ThisFormSet.ShipAddr IN Sales_No
				*ENDIF
			ENDIF	
			
		ENDIF 	&&nNewShipToCode > 0
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdShipAddGet.Click
		IF NOT Empty(ThisFormSet.ShipAddr)
		
		*	PRIVATE aShipInfo
		
			*SELECT Blind, PayType, ShipPay  FROM shipaddr WHERE shipcode = ThisFormSet.ShipAddr INTO ARRAY aShipInfo
			IF USED('delShipAddr')
				USE IN delShipAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC 
			cSQL= "SELECT Blind, PayType, ShipPay FROM dbo.ShipAddr WITH(NOLOCK)"
			cSQL= cSQL+" WHERE ShipAddr.shipcode = "+STR(ThisFormSet.ShipAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'delShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'delShipAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "delShipAddr")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'delShipAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			PRIVATE lBlind, cPayType, cShipPay
			IF USED('delShipAddr')
				lBlind = PrepareSQLlogic(delShipAddr.Blind,'Blind',.F.)
				cPayType = ShowSQLtxt(delShipAddr.PayType,'PayType',10)
				cShipPay = ShowSQLtxt(delShipAddr.ShipPay,'ShipPay',12)
				This.Parent.chkBlindSO.Value = lBlind
				This.Parent.cmbPayment.Value = cPayType
				This.Parent.cmbFrtPayment.Value = cShipPay
				
				USE IN delshipAddr
				
				REPLACE Blind WITH lBlind IN Sales_No
				REPLACE PayType WITH cPayType IN Sales_No
				REPLACE ShipPay WITH cShipPay IN Sales_No
			ENDIF
		
		ELSE
		
			MESSAGEBOX("ShipAddr code is empty",0,"Cannot get for Address")
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdShipAddRemove.Click
		
		IF NOT Empty(ThisFormSet.ShipAddr)
		
		*	UPDATE shipaddr SET Blind = .F., PayType = "", ShipPay = "" WHERE shipcode = ThisFormSet.ShipAddr
		
			PRIVATE cSQL, nSQLEXEC 
			cSQL= "UPDATE dbo.ShipAddr SET "
			cSQL= cSQL+" Blind = 0,"
			cSQL= cSQL+" PayType = '',"
			cSQL= cSQL+" ShipPay = '' "
			cSQL= cSQL+",LastEdit=GetDate() "
			cSQL= cSQL+" WHERE shipcode = "+STR(ThisFormSet.ShipAddr)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
		ELSE
			MESSAGEBOX("ShipAddr Code is empty",0,'')
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.cmdShipAddSave.Click
		*Get from Screen to save to ShiAdd
		PRIVATE llBlind, lcPayType, lcShipPay
		llBlind			= PrepareSQLlogic(This.Parent.chkBlindSO.Value,'Blind',.F.)
		*lcPayType		= PrepareSQLtxt( Sales_No.PayType,'PayType',10)
		lcPayType		= PrepareSQLtxt(This.Parent.cmbPayment.Value,'PayType',10)
		*lcShipPay		= PrepareSQLtxt( Sales_No.ShipPay,'ShipPay',11)
		lcShipPay		= PrepareSQLtxt(This.Parent.cmbFrtPayment.Value,'ShipPay',12)
		
		IF NOT Empty(ThisFormSet.ShipAddr)
		
		*	UPDATE shipaddr SET Blind = llBlind, PayType = lnPaymentType WHERE shipcode = ThisFormSet.ShipAddr
			PRIVATE cSQLu, nSQLEXEC 
			cSQLu= "UPDATE dbo.ShipAddr SET "
			cSQLu= cSQLu+" Blind = "+IIF(llBlind,'1','0')
			cSQLu= cSQLu+",PayType = '"+lcPayType+"'"
			cSQLu= cSQLu+",ShipPay = '"+lcShipPay +"'"
			cSQLu= cSQLu+",LastEdit=GetDate() "
			cSQLu= cSQLu+" WHERE shipcode = "+STR(ThisFormSet.ShipAddr)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQLu ,ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
				ENDIF
			ENDIF
				
		
		ELSE
			MESSAGEBOX("ShipAddr Code is empty",0,'')
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.lblShipToCountry.Click
		PRIVATE cSQL_tmpCountries, nSQLEXEC, cCurrTable
		cCurrTable = ALIAS()
		
		IF USED("tmpCountries")
			USE IN tmpCountries
		ENDIF
		cSQL_tmpCountries="SELECT CountryCode AS CC, Restricted AS R, CountryDesc FROM dbo.Countries WITH(NOLOCK)"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_tmpCountries, 'tmpCountries')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_tmpCountries, 'tmpCountries')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_tmpCountries, "tmpCountries")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_tmpCountries, "tmpCountries")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL_tmpCountries,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountries')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		IF nSQLEXEC > 0
			DEFINE WINDOW output IN WINDOW frmEO FROM 12,1 TO 23,40 TITLE 'Countries' CLOSE FLOAT GROW ZOOM
			ACTIVATE WINDOW output
			SELECT tmpCountries
			BROWSE IN WINDOW output NODELETE NOEDIT NOAPPEND
			DEACTIVATE WINDOW output
			RELEASE WINDOW output
		ENDIF
		
		IF USED("tmpCountries")
			USE IN tmpCountries
		ENDIF
		IF NOT LEN(ALLTRIM(cCurrTable))=0
			SELECT (cCurrTable)
		ENDIF
	ENDPROC

