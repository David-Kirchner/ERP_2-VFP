	PROCEDURE gotosoitem
		PARAMETERS nItem
		*ThisFormset.gotoSOitem(Item)
		
		IF VARTYPE(nItem) != 'N'
			RETURN .F.
		ENDIF
		
		IF USED('SalesQuote')
			SELECT SalesQuote
			LOCATE FOR Item = nItem
			
			IF FOUND()
				ThisFormSet.ItemNumber = SalesQuote.ITEM_A
				ThisFormSet.frmEO.pf1.pgOrder.txtItem.REFRESH()
			ELSE
				WAIT WINDOW 'Cannot change Sales Order Items on this tab.' NOWAIT
			ENDIF
		ENDIF
		
		
		ThisFormSet.pgRefresh()
		
		
			
			
		
	ENDPROC

	PROCEDURE Init
		PARAMETER nSalesnum, lNoSave
		*Do Form Forms\EditSalesOrder WITH 80522,.T.
		*Do Form Forms\EditSalesOrder25 WITH 140195,.T.
		*nSalesnum = 140195
		*lNoSave = .F.
		*ResaleCerts@SpaceAlloysUSA.com
		PUBLIC glTrt_lumber
		glTrt_lumber = .F.
		
		PRIVATE cSQL,cSQLu, nSQLEXEC
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF	
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		SET PRINTER TO DEFAULT
		
		IF NOT "PURCHASEORDER" $ SET("CLASSLIB")
			SET CLASSLIB TO LIBS\PurchaseOrder ADDITIVE
		ENDIF
		
		
		IF NOT VARTYPE(nSalesnum) = "N"
			=MESSAGEBOX("Enter Sales Number first"+CHR(13)+"Cannot continue without!",16,"Did not find Parameter Sales Number")
			RETURN .F.
		ENDIF
		
		IF nSalesnum = 0
			MESSAGEBOX("Sales Number is 0!"+CHR(13)+"Cannot continue without SO!",16,"Did not find Parameter Sales Number")
			TrackError("Sales Number is 0!"+CHR(13)+"Cannot continue without SO!","Sales Number is 0!", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		*!*	IF Find_SOitem00(nSalesnum)
		*!*		IF Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle, '') = 1
		*!*			*Update AllQuotes
		*!*			*Update Sales	
		*!*		ELSE
		*!*			MESSAGEBOX("This Salesnumber has a bad Item=00 "+CHR(13)+"cannot continue.",16,"This needs to be fixed first")
		*!*			RETURN .F.
		*!*		ENDIF
		*!*	ENDIF
		
		ThisFormSet.SalesNum = PrepareSQLnum(nSalesNum,'SalesNum',-3)
		ThisFormSet.frmEO.Caption = ThisFormSet.frmEO.Caption +" "+STR(ThisFormSet.SalesNum)
		
		ThisFormSet.frmPO.Salesnum 	 = ThisFormSet.SalesNum
		ThisFormSet.itemNumber = 1
		ThisFormSet.frmPO.ItemNumber = ThisFormSet.ItemNumber
		ThisFormSet.frmPO.cSOitem	= Proper_SO_item(STR(nSalesNum)+"-01")
		
		
		*****************************
		ThisFormSet.Update_Sales_init()	&&Match Quotes prices with the copy in dbo.Sales
		*****************************
		*ThisFormSet.Update_Prices()    &&used here to Correct data before SalesQuote is created
		*****************************
		*ThisFormSet.UpdtItemSale
		*****************************
		ThisFormSet.Update_Sales_Total() 	&&Used here to correct SQL data
		*****************************
		
		IF VARTYPE(lNoSave) = "L"
			IF lNoSave
				ThisFormSet.frmEO.cmdSO_Save.Visible = .F.
			ENDIF
		ENDIF
		
		IF USED("QuotesSO")
			USE IN QuotesSO
		ENDIF
		
		IF USED("SalesQuote")
			USE IN SalesQuote
		ENDIF
		
		************************************************************
		WAIT WINDOW "Open SalesQuote" NOWAIT
		ThisFormSet.Refresh_SalesQuote(1)
		IF NOT USED('SalesQuote')
			TrackError("Lost table SalesQuote after .Refresh_SalesQuotes(1) ","Lost table SalesQuote in INIT", PROGRAM(), LINENO(1))
		ENDIF
		*--SalesQuote
		
		************************************************************
		ThisFormSet.didSOitem_UseStock()
		
		*Moved to After Sales_No is loaded.
		*ThisFormSet.SoldAddr = 0
		*ThisFormSet.ShipAddr = 0
		
		*****************************************************************
		*Make sure SalesQuote table has data
		SELECT SalesQuote
		IF RECCOUNT('SalesQuote') < 1
			*ThisFormSet.Refresh_SalesQuote(1)
			PRIVATE cMess, cCurrTable
			cCurrTable = ''
			cMess = "SalesQuote table is Empty!."+CHR(13)
			*cMess = cMess+"Current table is listed as '"+ALLTRIM(ShowSQLtxt(cCurrTable,'CurrTable',30))+"'."
			cMess = cMess+"Current SalesNum is "+ALLTRIM(STR(nSalesnum))
			TrackError('SalesQuote table is Empty!',cMess,PROGRAM(),LINENO(1))
			MESSAGEBOX('No Records found!',0,"INIT")
			ThisFormSet.Release
			RETURN
		ENDIF
		
		****************** dbo.SOitem_Hrs
		SELECT SalesQuote
		PRIVATE cSOitem 
		SCAN
			**Insert SOitem_Hrs if it does not exitst
			cSOitem = Proper_SO_Item(SalesQuote.SOitem)
			IF cSOitem != Proper_SO_Item("")
				cSQL = "IF NOT EXISTS( SELECT * FROM dbo.SOitem_Hrs WHERE SOitem = '"+cSOitem+"')"
				cSQL = cSQL + " INSERT INTO dbo.SOitem_Hrs (SOitem,SalesNum) VALUES ('"+cSOitem+"',"+STR(nSalesNum)+")"
				*DateEst
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				*
			ENDIF
			
			ThisFormSet.Check_SOitem_Hrs(.F.)
		
		ENDSCAN
		
		******************
		SELECT SalesQuote
		GO TOP IN SalesQuote
		
		
		IF ISNULL(SalesQuote.ProcLoc)
			IF SalesQuote.Form = '40' OR SalesQuote.Form = '51' OR SalesQuote.Form = '52' OR SalesQuote.Form = '80'
				REPLACE SalesQuote.ProcLoc WITH "W"
			ELSE
				REPLACE SalesQuote.ProcLoc WITH "T"
			ENDIF
			
			ThisFormSet.frmEO.pf1.pgOrder.cmbProcLoc.Refresh
			
		ENDIF
		
		*****************************
		ThisFormSet.Refresh_pgOrder()
		*****************************
		
		
		*WAIT WINDOW "Get Ship Route from Sales_No" NOWAIT
		PUBLIC aShipRoutes(1)
		DIMENSION aShipRoutes(1)
		
		
		IF USED("aSales_No")
			USE IN aSales_No
		ENDIF
		
		cSQL = "SELECT DISTINCT UPPER(ShipRoute) AS ShipRoute "
		cSQL = cSQL + " FROM dbo.Sales_No WITH(NOLOCK) ORDER BY ShipRoute"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSales_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSales_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSales_No')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('aSales_No')
			SELECT aSales_No
			*COPY TO ARRAY aShipRoutes FIELDS ShipRoute
			SELECT ShipRoute FROM aSales_No INTO ARRAY aShipRoutes
			USE IN aSales_No
		ELSE
			aShipRoutes(1) = ""
		ENDIF
		
		***********************************
		WAIT WINDOW "Get from Sales_No" NOWAIT
		
		ThisFormSet.SoldAddr = 0
		ThisFormSet.ShipAddr = 0	&&Filled by ThisFormSet.Load_Sales_No()
		
		ThisFormSet.Load_Sales_No()
		
		IF USED('Sales_No')
			*Done in Load_Sales_No() !
			*ThisFormSet.SoldAddr = PrepareSQLnum(Sales_No.pSoldAddr,'pSoldAddr',-3)
			*ThisFormSet.ShipAddr = PrepareSQLnum(Sales_No.pShipAddr,'pShipAddr',-3)
			*ThisFormSet.cPaymentType	= ShowSQLtxt(Sales_No.PayType,'PayType',10)
					
			IF LEN(ALLTRIM(ThisFormSet.cPaymentType))=0
				PRIVATE cPaymentTypeNumber
				
				PRIVATE cCustID
				cCustID = PrepareSQLtxt(SalesQuote.CustID,'CustID',20)
				IF LEN(ALLTRIM(cCustID))=0
					*Not sure why SalesQuote.CustID is lost
					cCustID = PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)
					IF NOT LEN(ALLTRIM(cCustID))=0
						SELECT SalesQuote
						REPLACE CustID WITH cCustID IN SalesQuote
					ENDIF
				ENDIF
		
		
				cPaymentTypeNumber = GetPayTypeNum( cCustID, SalesQuote.Company, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle )
				IF cPaymentTypeNumber $ "OverLimit"
					MESSAGEBOX("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!",64,"Warning, already over credit Limit!")
					Trackmess("This Company '"+ALLTRIM(SalesQuote.Company)+"' is over the credit limit!, before adding SO "+ALLTRIM(STR(nSalesnum))+" EditSalesOrder.Init()")
					cPaymentTypeNumber = LEFT(cPaymentTypeNumber,1)
				ENDIF
				ThisFormSet.cPaymentType = ShowPaymentTypeText(cPaymentTypeNumber)
			ENDIF
			
			****   Done in Load_Sales_No() ! ****
			*ThisFormSet.nAmendment	= PrepareSQLnum(Sales_No.Amendment,'Amendment',-1)
			*ThisFormSet.lChangingSO	= PrepareSQLlogic(Sales_No.Changing,'Changing',.F.)
			*ThisFormSet.lPrintedSO	= PrepareSQLlogic(Sales_No.PrintedSO,'PrintedSO')
			*ThisFormSet.lShopRecvSO	= PrepareSQLlogic(Sales_No.ShopRecv,'ShopRecv',.F.)
			
			IF ThisFormSet.lChangingSO
				*MESSAGEBOX("This Order has been changed."+CHR(13)+"The Version number has NOT been updated."+CHR(13)+"Save or Print this order to refresh the Version number!",0+64,"SO has changed!")
				WAIT WINDOW "This SO is flagged as 'Changing'."+CHR(13)+"This SO still needs to be Saved and Printed." TIMEOUT 2
			ENDIF
				
		ELSE
			*No record exists - INIT
			ThisFormSet.frmEO.pf1.pgShipto.cmbTarfBill.Value = "RECIPIENT"
			REPLACE TarfBill WITH "RECIPIENT" IN Sales_No
			
			ThisFormSet.frmEO.pf1.pgShipto.chkUSA.Value = 1
			REPLACE USA WITH .T. IN Sales_No
		ENDIF
		***** End Sales_No
		
		***** Check Dates
		SELECT SalesQuote
		PRIVATE lnATlt, lcrLeadTime, ldLTDate, lnLTVal
		PRIVATE nCalcLotP 
		lcrLeadTime = ''
		SCAN
		*	IF VARTYPE(SalesQuote.ShipDue) = "T"
		*		SalesQuote.ShipDue = TTOD(SalesQuote.ShipDue)
		*	ENDIF
			IF EMPTY(SalesQuote.ShipDue) OR SalesQuote.ShipDue = CTOD("01/01/1900")
				IF NOT LEN(ALLTRIM(SalesQuote.LeadTime))=0
					
					*Duplicate changes here with select4order.cmdDone4Order.Click
					IF CTOD(SalesQuote.LeadTime) != CTOD("  /  /  ")
						*Already in Date Format
						ldLTDate = CTOD(SalesQuote.LeadTime)
					ELSE
						lnATlt = AT("-",SalesQuote.LeadTime)
						lcrLeadTime  = IIF(lnATlt > 0,SUBSTR(SalesQuote.LeadTime,lnATlt+1) ,SalesQuote.LeadTime)
						lnLTVal = VAL(lcrLeadTime )
			
						IF "WK" $ UPPER(lcrLeadTime ) OR  "WEEK" $ UPPER(lcrLeadTime )
							IF lnLTVal > 0
								ldLTDate = DATE()+ (lnLTVal * 7) && num * 7Days/week
							ELSE
								ldLTDate = DATE()+ 7 &&1wk
							ENDIF
						ELSE
							IF lnLTVal > 0
								ldLTDate = DATE() + (lnLTVal) && num of days
							ELSE
								ldLTDate = DATE()+1	 && could not parse data
							ENDIF
						ENDIF
					ENDIF
					
					IF AT( "/", lcrLeadTime  , 2 )>0 OR AT( "-", lcrLeadTime  , 2 )>0 
						**MUST BE A DATE!
						ldLTDate = CTOD(lcrLeadTime)
					ENDIF
					
				ELSE
					ldLTDate = DATE()+1
					
				ENDIF
				
				**Correct for Holiday
				IF Is_Holiday( ldLTDate )
					ldLTDate = ldLTDate + 1
				ENDIF
				IF Is_Holiday( ldLTDate )  &&Black Friday
					ldLTDate = ldLTDate + 1
				ENDIF
				
				**Correct for weekends
				DO CASE
				CASE DOW(ldLTDate) = 7 &&Saterday
					ldLTDate = ldLTDate + 2
					IF Is_Holiday( ldLTDate )
						ldLTDate = ldLTDate + 1
					ENDIF
				CASE DOW(ldLTDate ) = 1 &&Sun
					ldLTDate = ldLTDate + 1
					IF Is_Holiday( ldLTDate )
						ldLTDate = ldLTDate + 1
					ENDIF
				ENDCASE
		
		
				
				IF NOT EMPTY(ldLTDate)
					REPLACE ShipDue WITH ldLTDate IN SalesQuote
				
		*!*				IF NOT EMPTY(ldLTDate)
		*!*					cSQLu = "UPDATE dbo.Sales SET "
		*!*					cSQLu = cSQLu + " ShipDue='"+IIF(EMPTY(ldLTDate),'',DTOC(ldLTDate))+"'"
		*!*					cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_a+"')"
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		*!*					
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		*!*					ENDDO
		*!*					IF nSQLEXEC < 0 &&Try again!, long triger
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		*!*						ENDDO
		*!*					ENDIF
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aSales_No")
		*!*				
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*					IF nSQLEXEC < 0
		*!*						IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*					ENDIF	
		*!*				ENDIF
				ENDIF
			ENDIF
			
			IF PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3) < 1
				MESSAGEBOX("Item "+PrepareSQLtxt(SalesQuote.Item,'Item',2)+" does not have a Piece count!"+CHR(13)+"This makes the Sales Total hard to calculate."+CHR(13)+CHR(13)+"If you know the Pieces, because it is a small number,"+CHR(13)+"	please enter the Piece Count.",0+32,"Sales Total may fail without a Piece Count" ) 
			ENDIF
		
			*IF EMPTY(SalesQuote.ItemSale) OR VARTYPE(SalesQuote.ItemSale)="X" 
				*make sure ALL ItemSale is correct.
				SELECT SalesQuote
				
				*nCalcLotP = ThisFormSet.CalcLotp()
				*nCalcLotP = getSale_SOitem( SalesQuote.SOItem_A, ThisFormSet.nConnHandle ) 
				nItemSale = ThisFormSet.calc_ItemSale(SalesQuote.SOItem_A)
				REPLACE ItemSale WITH nItemSale IN SalesQuote
				ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Value = nItemSale 
				ThisFormSet.UpdtItemSale(nItemSale)
			*ENDIF
			
			
		ENDSCAN  &&Salesnum
		
		***********
		*Keep SalesQuote local whith a Uniq DBF name
		
		IF USED('SalesTotal')
			USE IN SalesTotal
		ENDIF
		
		ThisFormSet.fnSalesTotal = UniqDBF(ThisFormSet.fnSalesTotal)
		
		SELECT 0
		SET SAFETY OFF
		IF "\MEM" $ SYS(2003)
			CREATE TABLE ( SYS(5)+SYS(2003)+"\"+ThisFormSet.fnSalesTotal ) FREE (ItemSale Y,ItemCost Y, ItemSkCost Y, ItemSkPaid Y, ItemPOCost Y, Item INT, Cncld l, SOitem CHAR(10))
			SELECT ItemSale, ItemCost, 00000000.00 AS ItemSkCost, 00000000.00 AS ItemSkPaid, 00000000.00 AS ItemPOCost, Item_A as Item, Cncld, SOitem FROM SalesQuote INTO TABLE (SYS(5)+SYS(2003)+"\"+ThisFormSet.fnSalesTotal)
			USE (SYS(5)+SYS(2003)+"\"+ThisFormSet.fnSalesTotal) EXCL ALIAS SalesTotal
		ELSE
			CREATE TABLE ( SYS(5)+SYS(2003)+"\MEM\"+ThisFormSet.fnSalesTotal ) FREE (ItemSale Y,ItemCost Y, ItemSkCost Y, ItemSkPaid Y, ItemPOCost Y, Item INT, Cncld l, SOitem CHAR(10))
			SELECT ItemSale, ItemCost, 00000000.00 AS ItemSkCost, 00000000.00 AS ItemSkPaid, 00000000.00 AS ItemPOCost, Item_A as Item, Cncld, SOitem FROM SalesQuote INTO TABLE (SYS(5)+SYS(2003)+"\MEM\"+ThisFormSet.fnSalesTotal)
			USE (SYS(5)+SYS(2003)+"\MEM\"+ThisFormSet.fnSalesTotal) EXCL ALIAS SalesTotal	
		ENDIF
		
		*************
		
		SELECT SalesQuote
		GO TOP
		WAIT CLEAR
		
		IF USED( 'aShipAddr' )
			USE IN aShipAddr
		ENDIF
		
		**************************************
		*Finish the INIT
		
		*ThisFormSet.lPrintedSO
		*ThisFormSet.lShopRecvSO
		*ThisFormSet.nAmendment
		*ThisFormSet.lChangingSO
		
		
		ThisFormSet.ItemNumber	= PrepareSQLnum(SalesQuote.ITEM_A,'Item',-1)
		ThisFormSet.SOItemTot	= PrepareSQLnum(SalesQuote.ItemTot,'ItemTot',-1)
		ThisFormSet.frmPO.txtItemTot.Value	= PrepareSQLnum(SalesQuote.ItemTot,'ItemTot',-1)
		
		ThisFormSet.frmPO.Visible = .F.
		ThisFormSet.frmPO.Left	= ThisFormSet.frmEO.Left+6
		ThisFormSet.frmPO.Top	= ThisFormSet.frmEO.Top + 60
		
		ThisFormSet.frmWO.Left	= ThisFormSet.frmEO.Left+ThisFormSet.frmEO.Width +15
		ThisFormSet.frmWO.Top	= ThisFormSet.frmEO.Top - 2
		
		ThisFormSet.frmWOD.Left	= ThisFormSet.frmEO.Left+ThisFormSet.frmEO.Width +15
		ThisFormSet.frmWOD.Top	= ThisFormSet.frmEO.Top + ThisFormSet.frmWO.Height + 20
		
		ThisFormSet.frmEoP.Visible = .F.
		
		*ThisFormSet.frmPO.AlwaysOnTop = .T.
		*ThisFormSet.frmEO.AlwaysOnTop = .F.
		*
		ThisFormSet.ShowWO_WOD_Window()
		
		ThisFormSet.frmCustomer.Left = ThisFormSet.frmEO.Left - ThisFormSet.frmCustomer.Width - 12
		ThisFormSet.frmCustomer.Top = ThisFormSet.frmEO.Top + 260
		ThisFormSet.InitCustomerNotes()
		
	ENDPROC

	PROCEDURE initcustomernotes
		*ThisFormSet.InitCustomerNotes()
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpCustNotes')
			USE IN tmpCustNotes
		ENDIF
		
		cSQL = "SELECT ISNULL(Notes,'') AS Notes FROM dbo.QuickCompany QC WITH(NOLOCK) "
		cSQL=cSQL+" inner join dbo.AllQuotes AQ WITH(NOLOCK) "
		cSQL=cSQL+" ON QC.Customer = AQ.CustID "
		cSQL=cSQL+" AND QC.Company = AQ.Company "
		cSQL=cSQL+" AND QC.[Name] = AQ.[Name] "
		cSQL=cSQL+" WHERE SalesNum = "+STR(ThisFormSet.Salesnum)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCustNotes' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCustNotes' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, "tmpCustNotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, "tmpCustNotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCustNotes')
		ENDIF
		
		IF USED('tmpCustNotes')
			ThisFormSet.frmCustomer.edtCustomer.Value = tmpCustNotes.Notes
			USE IN tmpCustNotes
		ELSE
			ThisFormSet.frmCustomer.edtCustomer.Value = ''
		ENDIF
	ENDPROC

	PROCEDURE inventoryform
		PARAMETER lcForm
		
		IF VARTYPE(lcForm) != "C"
			RETURN ''
		ENDIF
		
		PRIVATE lcInvForm
		lcInvForm = ''
		** Used to Find in Price Table!
		*FormDescription( lcForm, lcInvForm )
		lcInvForm = FormDescription( lcForm )
		
		RETURN lcInvForm 
		
	ENDPROC

	PROCEDURE Load
		
		IF "\MEM" $ SYS(2003)
			IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			ENDIF	
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
			ENDIF
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		*If Global exisits, make it the ThisFormSet.nConnHandle 
		*The Global is only set from Quote window
		IF VARTYPE(gnConnHandle) = "N"
			IF gnConnHandle > 0
				ThisFormSet.nConnHandle = gnConnHandle
			ELSE
				ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT() 
			ENDIF
		ELSE
			ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT() 
		ENDIF
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
		ENDIF
		
		
	ENDPROC

	PROCEDURE loadhardwood
		*ThisFormSet.LoadHardwood()
		
		PRIVATE cSQL,nSQLEXEC 
		
		IF USED('HardWood')
			USE IN HardWood
		ENDIF
		
		cSQL = "SELECT [Country]"
		cSQL = cSQL + " ,[Abv]"
		cSQL = cSQL + " ,[Summary]"
		cSQL = cSQL + " ,[WebPage]"
		cSQL = cSQL + " ,[PrintOut]"
		cSQL = cSQL + " ,[Inactive]"
		cSQL = cSQL + " FROM [dbo].[HardWood] WITH(NOLOCK)"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HardWood')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'HardWood')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HardWood")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HardWood")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'HardWood')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE loadstocklst
		PRIVATE  lOK
		lOK = .F.
		
		
		PRIVATE cSQL_Master, cSQL_Detail, cSQL_Process
		PRIVATE nSQLEXEC
		
		IF USED('StockLst_Master')
			USE IN StockLst_Master
		ENDIF
		
		cSQL_Master="SELECT * FROM dbo.StockLst_Master WITH(NOLOCK) " &&ORDER BY
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Master, 'StockLst_Master')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_Master, 'StockLst_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Master, "StockLst_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Master, "StockLst_Master")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL_Master,ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Master')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('StockLst_Master')
			SELECT StockLst_Master
		*	INDEX ON Alloy TAG Alloy
		*	INDEX ON Alloy+FORM TAG AlloyForm
		*	INDEX ON Alloy+FORM+STR(Size,9,3) TAG StockLst
		*	INDEX ON Alloy+FORM+COND+STR(SIZE,9,3)+HEAT TAG AFCSH
		
			***************
		
			IF USED("StockLst_Detail")
				USE IN StockLst_Detail
			ENDIF
			
			cSQL_Detail="SELECT * FROM dbo.StockLst_Detail WITH(NOLOCK) ORDER BY ID"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Detail, 'StockLst_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL'  TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_Detail, 'StockLst_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Detail, "StockLst_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Detail, "StockLst_Detail")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL_Detail,ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Detail')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			**************************
			
			IF USED('StockLst_Detail')
				*SELECT StockLst_Detail
				*INDEX ON ID TAG DetailID
				*SET RELATION TO ID INTO StockLst_Detail IN StockLst_Master
		
				cSQL_Process = "SELECT * FROM StockLst_Process WITH(NOLOCK) ORDER BY ID_Detail"
		
				IF USED("StockLst_Process")
					USE IN StockLst_Process
				ENDIF
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Process, 'StockLst_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL'  TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL_Process, 'StockLst_Process')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Process, "StockLst_Process")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Process, "StockLst_Process")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL_Process,ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Process')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ELSE
						lOK = .T.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF lOK
		
		ELSE
			= MESSAGEBOX('Error getting Data!'+CHR(13)+"Closing NOW!", 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE load_sales_no		&& dbo.SalesNo
		*ThisformSet.Load_Sales_No()
		
		IF USED("Sales_No")
			USE IN Sales_No
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Sales_No WITH(NOLOCK) WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Sales_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_No")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'Sales_No')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('Sales_No')
			IF RECCOUNT('Sales_No') > 0
				ThisFormSet.nAmendment	= PrepareSQLnum(Sales_No.Amendment,'Amendment',-3)
				ThisFormSet.lChangingSO	= PrepareSQLchk(Sales_No.Changing,'Changing')
				ThisFormSet.lPrintedSO	= PrepareSQLchk(Sales_No.PrintedSO,'PrintedSO')
				ThisFormSet.lShopRecvSO	= PrepareSQLchk(Sales_No.ShopRecv,'ShopRecv')
				ThisFormSet.cPaymentType	= ShowSQLtxt(Sales_No.PayType,'PayType',10)
				ThisFormSet.SoldAddr	= PrepareSQLnum(Sales_No.pSoldAddr,'pSoldAddr',-3)
				ThisFormSet.ShipAddr	= PrepareSQLnum(Sales_No.pShipAddr,'pShipAddr',-3)
				
				*ThisformSet.ncontactid
			ENDIF
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE load_worksheet
	ENDPROC

	PROCEDURE nextsorec
		*ThisFormset.NextSOrec()
		*Returns .F. on Fail
		
		IF ThisFormSet.frmEO.pf1.ACTIVEPAGE = 1 ;
			OR ThisFormSet.frmEO.pf1.ACTIVEPAGE = 2 ;
			OR ThisFormSet.frmEO.pf1.ACTIVEPAGE = 6 ;
			OR ThisFormSet.frmEO.pf1.ACTIVEPAGE = 8
			
		*ACTIVEPAGE 1 is pgOrder, 2 is pgQuote, 6 is pg_PO, 8 is HRS QA
		
			SELECT SalesQuote
			IF !EOF('SalesQuote')
				SKIP 1 IN SalesQuote
			ENDIF
			IF EOF('SalesQuote')
				WAIT WINDOW 'End of File' NOWAIT
				GO BOTTOM IN SalesQuote
			ENDIF
			
			IF NOT ThisFormSet.pgRefresh()  &&Check here for Refresh Code
				IF !BOF('SalesQuote')
					SKIP -1 IN SalesQuote
				ENDIF
			ENDIF
			
		ELSE
			WAIT WINDOW 'Cannot change Sales Order ITEMS on this tab.' NOWAIT
		ENDIF
		
	ENDPROC

	PROCEDURE pgrefresh
		*ThisFormSet.pgRefresh()
		WAIT WINDOW "Page Refresh" NOWAIT
		*Check Data before leaving Page
		
		IF NOT USED('SalesQuote')
			TrackError("Lost table SalesQuote","Lost table SalesQuote",Program(),LINENO(1))
			MESSAGEBOX("Table 'SalesQuote' is not available."+CHR(13)+"The Program cannot continue!"+CHR(13)+"Restart Program!",0+16,"No data!")
			MESSAGEBOX("Contact David so this part of the code can be fixed."+CHR(13)+"What was being done just prior to this errer?",48,"Lost Table")
			RETURN .F.
		ENDIF
		
		*IF ThisFormSet.frmEO.pf1.pgBillTo.cmdEditSoldTo.CAPTION = "Save"
		IF ThisFormSet.frmEO.pf1.pgShipto.cmdEditShipTo.CAPTION = "Save" 
			*ThisFormSet.ShipAddr
			IF NOT ( LEN(ALLTRIM(ShowSQLtxt(ThisFormSet.frmEO.pf1.pgShipto.txtADDR1.Value,'Addr1',100)))=0 AND ;
				LEN(ALLTRIM(ShowSQLtxt(ThisFormSet.frmEO.pf1.pgShipto.txtADDR2.Value,'Addr2',100)))=0 )
				
				IF ThisFormSet.ShipAddr = 0
					PRIVATE cMess
					cMess = "Ship To needs to be Saved."
					cMess = cMess + "Please Finish the Address Edit."
				
					MESSAGEBOX(cMess,0+48,"Cannot leave the page TAB.")
					RETURN .F.
				ENDIF
				
			ENDIF
		ENDIF
		********
		IF ThisFormSet.frmEO.pf1.pgBillto.cmdEditSoldTo.CAPTION = "Save"
			*ThisFormSet.SoldAddr
			IF NOT ( LEN(ALLTRIM(ShowSQLtxt(ThisFormSet.frmEO.pf1.pgBillto.txtADDR1.Value,'Addr1',100)))=0 AND ;
				LEN(ALLTRIM(ShowSQLtxt(ThisFormSet.frmEO.pf1.pgBillto.txtADDR2.Value,'Addr2',100)))=0 )
				
				IF ThisFormSet.SoldAddr = 0 OR ThisFormSet.frmEO.pf1.pgBillTo.cmdSearchSoldTo.Enabled = .F.
					PRIVATE cMess
					cMess = "Bill To needs to be Saved."
					cMess = cMess + "Please Finish the Address Edit."
					
					MESSAGEBOX(cMess,0+48,"Cannot leave the page TAB.")
					RETURN .F.
				ENDIF
				
			ENDIF
		ENDIF
		
		*********************
		
		PRIVATE lCG, cTol 
		lCG	 = PrepareSQLlogic(SalesQuote.CG,'CG',.F.)
		cTol = PrepareSQLtxt(SalesQuote.Tol,'Tolerance',20)
		IF lCG AND LEN(ALLTRIM(cTol))=0
			MESSAGEBOX("Please enter a CG Tolerance on SO-Item:"+ALLTRIM(SalesQuote.SoItem_a)+"!"+CHR(13)+CHR(13)+"This SO will not save untill the CG has a Tolerance."+CHR(13)+"Cannot leave the page tab called 'Order'.",0+64,"Found CG job with no Tolerance.")
			
			ThisFormSet.frmEO.pf1.ActivePage = 1
			ThisFormSet.Refresh_pgOrder()
			
			nItem = ThisFormSet.frmEO.Pf1.pgOrder.txtItem.Value
			nItm2 = SalesQuote.Item
			
			*RETURN .F.  &&If you return .F. then the SalesQuote will SKIP -1 
			* --from here do not move to another record.
			RETURN .T.
		ENDIF
		
		*********************
		*End of Data Check
		*********************
		
		ThisFormSet.ItemNumber	= PrepareSQLnum(SalesQuote.ITEM_A,'Item',-1)
		*ThisFormSet.frmEO.pf1.pgOrder.txtItem.Value = ThisFormSet.ItemNumber
		ThisFormSet.frmEO.pf1.pgOrder.txtItem.REFRESH()	&&SalesQuote.ITEM_A
		*ThisFormSet.frmEO.pf1.pgQuote.txtItem.Value = ThisFormSet.ItemNumber
		ThisFormSet.frmEO.pf1.pgQuote.txtItem.Refresh()  &&SalesQuote.item_A
		ThisFormSet.frmPO.txtItem.Value	= ThisFormSet.ItemNumber
		ThisFormSet.frmPO.ItemNumber 	= ThisFormSet.ItemNumber
		
		*ThisFormSet.SOItemTot 	= PrepareSQLnum(SalesQuote.ItemTot,'ItemTot',-1)
		*ThisFormSet.frmPO.txtItemTot.Value	= ThisFormSet.SOItemTot 
		
		*********************
		DO CASE
			CASE ThisFormSet.frmEO.pf1.ActivePage = 1	&&EnterOrder
				ThisFormSet.Refresh_pgOrder()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 2	&&Quote
				ThisFormSet.Refresh_pgQuote()		
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 3	&&Value
				ThisFormSet.Refresh_pgValue()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 4	&&BillTo
				ThisFormSet.Refresh_pgBillTo()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 5	&&ShipTo
				ThisFormSet.Refresh_pgShipTo()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 6	&&Purchase
				ThisFormSet.Refresh_pgPurchase()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 7	&&CreditCard
				ThisFormSet.Refresh_pgCreditCard()
			CASE ThisFormSet.frmEO.pf1.ACTIVEPAGE = 8	&&Hrs QA
				ThisFormSet.Refresh_pgQA()	
		ENDCASE
		
		ThisFormSet.ShowWO_WOD_Window()
		
		WAIT CLEAR
	ENDPROC

	PROCEDURE poshiptocustomer
		PARAMETERS nOption
		*POShipToCustomer
		
		DO CASE
		CASE nOption = 1
			* HPA, Tipton
			
		CASE nOption = 2
			*Direct, use same as SoldTO
			IF ThisFormSet.ShipAddr > 0
				IF ThisFormSet.frmPO.POShipAddr = 0
					ThisFormSet.frmPO.POShipAddr = ThisFormSet.ShipAddr
					ThisFormSet.frmPO.POShipTo(nOption)
				ELSE
					IF ThisFormSet.frmPO.POShipAddr != ThisFormSet.ShipAddr
						MESSAGEBOX("Found diffence in Shipping Address'"+CHR(13)+"PO Ship To is different from Sales Order Ship To.",48,"Address is Different!")
					ENDIF
				ENDIF
			ENDIF
		CASE nOption = 3
			*Direct, use same as ShipTo
			*Prepare for BLIND statement
			IF ThisFormSet.ShipAddr > 0
				IF ThisFormSet.frmPO.POShipAddr = 0
					ThisFormSet.frmPO.POShipAddr = ThisFormSet.ShipAddr
					ThisFormSet.frmPO.POShipTo(nOption)
				ELSE
					IF ThisFormSet.frmPO.POShipAddr != ThisFormSet.ShipAddr
						MESSAGEBOX("Found diffence in Ship To Address'"+CHR(13)+"PO Ship To is different from Sales Order Ship To.",48,"Address is Different!")
					ENDIF
				ENDIF
			ENDIF
			
		CASE nOption = 4
			*for Service- Enable Search
			*IF ThisForm.POShipAddr = 1 OR ThisForm.POShipAddr = 2
				*ThisForm.POShipAddr = 0
				*Can be back to HPA!
			*ENDIF
			IF ThisFormSet.ShipAddr > 0
				IF ThisFormSet.frmPO.POShipAddr = 0
					ThisFormSet.frmPO.POShipAddr = ThisFormSet.ShipAddr
					ThisFormSet.frmPO.POShipTo(nOption)
				ELSE
					IF ThisFormSet.frmPO.POShipAddr = 1 OR ThisFormSet.frmPO.POShipAddr = 2
						*This is OK
					ELSE
						IF ThisFormSet.frmPO.POShipAddr != ThisFormSet.ShipAddr
							MESSAGEBOX("Found diffence in Address'"+CHR(13)+"PO Ship To is different from Sales Order Ship To.",48,"Address is Different!")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		
		CASE nOption = 5
			* HPA, Windfall
			
		CASE nOption = 6
			*Remote Stock
			
		ENDCASE
		
	ENDPROC

	PROCEDURE prevsorec
		*ThisFormset.PrevSOrec()
		*Returns .F. on Fail
		
		IF ThisFormSet.frmEO.pf1.ACTIVEPAGE = 1 ;
			OR ThisFormSet.frmEO.pf1.ACTIVEPAGE = 2;
			OR ThisFormSet.frmEO.pf1.ACTIVEPAGE = 6;
			OR ThisFormSet.frmEO.pf1.ACTIVEPAGE = 8
			
		*ACTIVEPAGE 1 is pgOrder, 2 is pgQuote, 6 is pg_PO, 8 is HRS QA
		
			SELECT SalesQuote
			
			IF !BOF('SalesQuote')
				SKIP -1 IN SalesQuote
			ENDIF
			IF BOF('SalesQuote')
				WAIT WINDOW 'Top of file' NOWAIT
				GO TOP IN SalesQuote
			ENDIF
			
			IF NOT ThisFormSet.pgRefresh()  &&Check here for Refresh Code
				IF !EOF('SalesQuote')
					SKIP 1 IN SalesQuote
				ENDIF
			ENDIF
				
		ELSE
			WAIT WINDOW 'Cannot change Sales Order Items on this tab.' NOWAIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE record_sales_no_chng
		PARAMETERS pMess
		*ThisFormSet.Record_Sales_No_Chng()
		
		
		PRIVATE cMess
		cMess = PrepareSQLtxt(pMess,'Mess',-1)
		
		IF LEN(cMess) = 0
			cMess = "ThisFormSet.Record_Sales_No_Chng()"
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "INSERT INTO dbo.Sales_No_Chng (Body, SalesNum, ShopRecv, Ver) "
		cSQL = cSQL + " ( SELECT TOP 1 '"+cMess+"' AS Body "
		cSQL = cSQL + ",SN.SalesNum,SN.ShopRecv"
		*--dbo.Sales_No [VER] should be updated first! had to get Ver from FormSet
		cSQL = cSQL + " ,"+STR(ThisFormSet.nAmendment)+" AS VER "
		cSQL = cSQL + " FROM dbo.Sales_No SN WITH(NOLOCK) WHERE SN.salesnum = "+STR(ThisFormSet.SalesNum)
		cSQL = cSQL + " );"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, '')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refreshcc
	ENDPROC

	PROCEDURE refreshcl
		*ThisFormSet.RefreshCL()
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(ThisFormset.frmEO.pf1.pgQuote.cmbCC.Value,'CC',1)
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			USE IN ConditionLevel
		ENDIF
		
		ThisFormset.frmEO.pf1.pgQuote.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel WITH(NOLOCK)"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		ThisFormset.frmEO.pf1.pgQuote.cmbCL.ColumnCount = 2
		ThisFormset.frmEO.pf1.pgQuote.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		ThisFormset.frmEO.pf1.pgQuote.cmbCL.BoundColumn = 1
		ThisFormset.frmEO.pf1.pgQuote.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !LEN(ALLTRIM(cc1))=0
				IF LEN(ALLTRIM(cc1)) > 1
					
					ThisFormset.frmEO.pf1.pgQuote.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					ThisFormset.frmEO.pf1.pgQuote.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		
		
		IF ThisFormSet.CC != cCC
			ThisFormSet.CC = cCC
		
			IF AllowedCCLevel(cCC,cCL1)
				ThisFormset.frmEO.pf1.pgQuote.cmbCL.Value = cCL1
			ELSE
				ThisFormset.frmEO.pf1.pgQuote.cmbCL.Value = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
			ENDIF
		
			ThisFormset.frmEO.pf1.pgQuote.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE refreshforms
		PARAMETERS pSS
		*ThisFormSet.RefreshForms()
		*********************************************************************************
		** CHANGES HERE MUST BE REPLICATED TO WorkOrder, PurchaseOrder and PackingSlip
		** Form Changes must be made to Proc_Quotes.prg **
		*********************************************************************************
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		
		IF VARTYPE(pSS) != 'N'
			pSS = 0
		ENDIF
		
		IF pSS = 0
			pForm = SalesQuote.Form
			
			IF LEN(ALLTRIM(pForm))=0
				pForm = ThisFormset.frmEO.pf1.pgQuote.cmbForm.Value
			ENDIF
			IF NOT LEN(ALLTRIM(pForm))=0
				IF GetFormCaptions(pForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
		
						ThisFormSet.frmEO.pf1.pgQuote.LBLTHCK.Caption = RTRIM(tmpFormCaptions.txt1)
						ThisFormSet.frmEO.pf1.pgQuote.LBLSZ2.Caption = RTRIM(tmpFormCaptions.txt2)
						ThisFormset.frmEO.pf1.pgQuote.LBLSZ2.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormSet.frmEO.pf1.pgQuote.LBLSZ3.Caption = RTRIM(tmpFormCaptions.txt3)
						ThisFormset.frmEO.pf1.pgQuote.LBLSZ3.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormset.frmEO.pf1.pgQuote.LBLSZ3.Enabled 	= tmpFormCaptions.Sz3Enable
						ThisFormSet.frmEO.pf1.pgQuote.txtSZ3.Visible = tmpFormCaptions.use3rdDim
						ThisFormSet.frmEO.pf1.pgQuote.LBLSZ4.Caption = RTRIM(tmpFormCaptions.txt4)
						ThisFormset.frmEO.pf1.pgQuote.LBLSZ4.Visible 	= tmpFormCaptions.lblSz4Vis				
						USE IN tmpFormCaptions
					ELSE
						TrackMess( "tmpFormCaptions is not used!")
					ENDIF
				ELSE
					TrackMess("GetFormCaptions returned False!")
				ENDIF
			ELSE
				TrackMess("GetFormCaptions did not have a Form!")
			ENDIF
			IF NOT LEN(ALLTRIM(lCurrentTable))=0
				IF USED(lCurrentTable)
					SELECT (lCurrentTable)
				ENDIF
			ENDIF
		
		ELSE
			**Pass (1) to get SS
			pForm = ThisFormset.frmStartingStock.sscmbForm.Value
			IF NOT LEN(ALLTRIM(pForm))=0
				IF GetFormCaptions(pForm,ThisFormSet.nConnHandle)
					IF USED('tmpFormCaptions')
		
						ThisFormset.frmStartingStock.ssLBLTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
						ThisFormset.frmStartingStock.ssLBLSZ21.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormset.frmStartingStock.ssLBLSZ21.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormset.frmStartingStock.ssLBLSZ31.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormset.frmStartingStock.ssLBLSZ31.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormset.frmStartingStock.ssSZ31.Visible 	= tmpFormCaptions.use3rdDim
						ThisFormset.frmStartingStock.ssSZ31.Enabled 	= tmpFormCaptions.Sz3Enable
						ThisFormset.frmStartingStock.ssLBLSZ41.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormset.frmStartingStock.ssLBLSZ41.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ELSE
						TrackMess( "tmpFormCaptions is not used!")
					ENDIF
				ELSE
					TrackMess("GetFormCaptions returned False!")
				ENDIF
			ELSE
				TrackMess("GetFormCaptions did not have a Form!")	
			ENDIF
			IF NOT LEN(ALLTRIM(lCurrentTable))=0
				IF USED(lCurrentTable)
					SELECT (lCurrentTable)
				ENDIF
			ENDIF
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE refreshpu
		*ThisFormSet.RefreshPU()
		
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		
		PRIVATE nS_PU, nS_P, nS_QTY
		nS_PU  = PrepareSQLnum(SalesQuote.S_PU,'PU',-1)
		nS_P   = PrepareSQLnum(SalesQuote.S_P,'S_P',-5)
		nS_QTY = PrepareSQLnum(SalesQuote.S_QTY,'S_QTY',-5)
		
		PRIVATE nQ_PU, nQ_P, cUnitText, cUnitLabel 
		nQ_PU = PrepareSQLnum(SalesQuote.Q_PU,'PU',-1)
		nQ_P = PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.Q_P1.Value,'Q_P',-5)
		IF nQ_PU = 0
			nQ_PU = PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.Q_PU1.Value,'PU',-1)
		ENDIF
		
		PRIVATE cForm, nSz2, nSz3
		PRIVATE nP_LB, nP_FT, nP_PC, nLot
		
		**************************
		*Use nQ_Total to adjust to new PU
		
		PRIVATE nQ_Total1, nWeight, nFeet, nPieces 
		nQ_Total1 = PrepareSQLnum(ThisFormset.frmEO.pf1.pgQuote.Q_Total1.Value,'Q_Total',10,2)
		
		
		IF nQ_P <= 0
			*if no Q_Total, go old school
			IF nQ_Total1 < 0
				nP_LB = PrepareSQLnum(SalesQuote.P_LB,'P_LB',-5)
				IF nP_LB > 0
					nWeight = PrepareSQLnum(ThisFormset.frmEO.pf1.pgQuote.Weight1.Value,'Weight',9,1)
					IF nWeight > 0
						nQ_Total1 = nP_LB * nWeight 
						nQ_PU = 1
					ENDIF
				ENDIF
			ENDIF
			IF nQ_Total1 < 0
				nP_Ft = PrepareSQLnum(SalesQuote.P_Ft,'P_Ft',-5)
				IF nP_Ft > 0
					nPieces = PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
					cForm	= PrepareSQLtxt(SalesQuote.Form,'Form',2)
					nSZ2	= PrepareSQLnum(SalesQuote.SZ3,'Sz2',9,3)
					nSZ2	= PrepareSQLnum(SalesQuote.SZ3,'Sz3',9,3)
					nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisFormSet.nConnHandle)
					IF nFeet > 0
						nQ_Total1 = nP_Ft * nFeet 
						nQ_PU = 2
					ENDIF
				ENDIF
			ENDIF
			IF nQ_Total1 < 0
				nP_Pc = PrepareSQLnum(SalesQuote.P_PC,'P_PC',-5)
				IF nP_Pc > 0
					nPieces = PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
					IF nPieces > 0
						nQ_Total1 = nP_Pc * nPieces 
						nQ_PU = 3
					ENDIF
				ENDIF
			ENDIF		
			IF nQ_Total1 < 0
				nLotP = PrepareSQLnum(SalesQuote.LotP,'Lot_P',-5)
				IF nLotP > 0
					nQ_Total1 = nLotP 
					nQ_PU = 4
				ENDIF
			ENDIF	
			
			IF nQ_Total1 < 0
				nQ_Total1 = 0
			ENDIF
				
		ENDIF
		
		*ThisFormset.frmEO.pf1.pgQuote.cmbPU.Value = nQ_PU	
		IF nQ_PU < 1
			ThisFormset.frmEO.pf1.pgQuote.lblUnitText.Caption = ''
			ThisFormset.frmEO.pf1.pgQuote.lblQTY_Label.Caption = ''
		
			RETURN .F.
		ENDIF
		
		
		*Get Old School process before setting Label
		cUnitText = gaPU(nQ_PU,1)
		cUnitLabel = gaPU(nQ_PU,3)
		ThisFormset.frmEO.pf1.pgQuote.lblUnitText.Caption = cUnitText 
		ThisFormset.frmEO.pf1.pgQuote.lblQTY_Label.Caption = cUnitLabel 
		
		************************************
		
		IF nQ_Total1 = 0
			*do Old School conversion
			DO CASE
			CASE nQ_PU = 1
				*$/Lb
				nWeight = PrepareSQLnum(ThisFormset.frmEO.pf1.pgQuote.txtWeight.Value,'Weight',9,1)
				IF nWeight > 0
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = nWeight
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = nQ_Total1 / nWeight
				ELSE
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = 0
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = 0
				ENDIF	
			CASE nQ_PU = 2
				*$/Ft
				nPieces = PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
				cForm	= PrepareSQLtxt(SalesQuote.Form,'Form',2)
				nSZ2	= PrepareSQLnum(SalesQuote.SZ3,'Sz2',9,3)
				nSZ3	= PrepareSQLnum(SalesQuote.SZ3,'Sz3',9,3)
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisFormSet.nConnHandle)
				
				IF nFeet > 0
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = nFeet 
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = nQ_Total1 / nFeet 
				ELSE
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = 0
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = 0
				ENDIF	
			CASE nQ_PU = 3
				*$/Pc
				nPieces = PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
				IF nPieces > 0
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = nPieces 
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = nQ_Total1 / nPieces 
				ELSE
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = 0
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = 0
				ENDIF	
			CASE nQ_PU = 4
				*$Lot
				IF nQ_Total1 > 0
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = 1 
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = nQ_Total1 
				ELSE
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = 1
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = 0
				ENDIF	
			CASE nQ_PU = 5
				*$/Inch
				nPieces = PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
				cForm	= PrepareSQLtxt(SalesQuote.Form,'Form',2)
				nSZ2	= PrepareSQLnum(SalesQuote.SZ3,'Sz2',9,3)
				nSZ3	= PrepareSQLnum(SalesQuote.SZ3,'Sz3',9,3)
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisFormSet.nConnHandle)
				
				IF nFeet > 0
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = (nFeet / 12)
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = nQ_Total1 / (nFeet / 12)
				ELSE
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = 0
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = 0
				ENDIF		
			CASE nQ_PU = 6
				*$/Kg
				*nWeight = PrepareSQLnum(SalesQuote.Weight,'Weight',9,1)
				nWeight = PrepareSQLnum(ThisFormset.frmEO.pf1.pgQuote.txtWeight.Value,'Weight',9,1)
				IF nWeight > 0
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = (nWeight / 2.205)
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = nQ_Total1 / (nWeight / 2.205)
				ELSE
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = 0
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = 0
				ENDIF	
			CASE nQ_PU = 7
				*$/Mtr
				nPieces = PrepareSQLnum(SalesQuote.Pieces,'Pieces',-3)
				cForm	= PrepareSQLtxt(SalesQuote.Form,'Form',2)
				nSZ2	= PrepareSQLnum(SalesQuote.SZ3,'Sz2',9,3)
				nSZ3	= PrepareSQLnum(SalesQuote.SZ3,'Sz3',9,3)
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisFormSet.nConnHandle)
				
				IF nFeet > 0
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = (nFeet / 3.281)
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = nQ_Total1 / (nFeet / 3.281)
				ELSE
					ThisFormset.frmEO.pf1.pgQuote.Q_QTY1.Value = 0
					ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = 0
				ENDIF
				
			CASE nQ_PU = 8
				*$/Hr	
		*		ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = nQ_Total / nS_P
			CASE nQ_PU = 9
				*$/Day
		*		ThisFormset.frmEO.pf1.pgQuote.Q_P1.Value = nQ_Total / nS_P
			OTHERWISE
				
			ENDCASE
		ENDIF
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE refresh_pgbillto
		*ThisFormSet.Refresh_pgBillTo()
		
		**********************************************
		IF ThisFormSet.SoldAddr > 0
			ThisFormSet.frmEO.pf1.pgBillTo.txtSoldCode.Value = ThisFormSet.SoldAddr
		
			IF USED( 'SoldAddr' )
				USE IN SoldAddr
			ENDIF
			
			cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SoldCode = "+STR(ThisFormSet.SoldAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'SoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'SoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SoldAddr")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'SoldAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
		
		
			IF USED('SoldAddr')
				ThisFormSet.frmEO.pf1.pgBillTo.txtCompany.Value 	= SoldAddr.Company
				ThisFormSet.frmEO.pf1.pgBillTo.txtAddr1.Value		= SoldAddr.Addr1	
				ThisFormSet.frmEO.pf1.pgBillTo.txtAddr2.Value		= SoldAddr.Addr2
				ThisFormSet.frmEO.pf1.pgBillTo.txtCity.Value 		= SoldAddr.City	
				ThisFormSet.frmEO.pf1.pgBillTo.txtST.Value		= SoldAddr.ST
				ThisFormSet.frmEO.pf1.pgBillTo.txtZip.Value		= SoldAddr.Zip
				ThisFormSet.frmEO.pf1.pgBillTo.txtCountry.Value	= UPPER(ALLTRIM(SoldAddr.Country))
				ThisFormSet.frmEO.pf1.pgBillTo.txtMarketing.Value	= PrepareSQLtxt(SoldAddr.Marketing,'Marketing',100)
				ThisFormSet.frmEO.pf1.pgBillTo.txtContact.Value	= SoldAddr.Contact
				ThisFormSet.frmEO.pf1.pgBillTo.txtPhone.Value	= SoldAddr.Telephone
				ThisFormSet.frmEO.pf1.pgBillTo.txtFax.Value		= SoldAddr.Fax_Number
				ThisFormSet.frmEO.pf1.pgBillTo.txtEmail.Value		= SoldAddr.Email
				ThisFormSet.frmEO.pf1.pgBillTo.txtLastEdit.Value	= IIF(EMPTY(PrepareSQLdate(SoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(SoldAddr.LastEdit,'LastEdit'))
						
				ThisFormSet.Address_Screen("SoldToEdit")
				
				USE IN SoldAddr
			ENDIF
		ENDIF
		
		
		**********************************************
		
		ThisFormset.frmEO.pf1.pgBillTo.txtAmendment.Value	= ThisFormSet.nAmendment
		ThisFormset.frmEO.pf1.pgBillTo.chkSOchanging.Value	= ThisFormSet.lChangingSO
		ThisFormset.frmEO.pf1.pgBillTo.chkPrintedSO.Value	= ThisFormSet.lPrintedSO
		ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
		
		ThisFormSet.frmEO.pf1.pgBillTo.chkQA.VALUE		= PrepareSQLchk(SalesQuote.QA,'QA')
		ThisFormSet.frmEO.pf1.pgBillTo.chkCofC.VALUE	= PrepareSQLchk(SalesQuote.CofC,'CofC')
		ThisFormSet.frmEO.pf1.pgBillTo.chkMercury.VALUE	= PrepareSQLchk(SalesQuote.Merc,'Merc')
		ThisFormSet.frmEO.pf1.pgBillTo.chkIntP.VALUE	= PrepareSQLchk(SalesQuote.IntP,'IntP')
		ThisFormSet.frmEO.pf1.pgBillTo.chkpPO.VALUE		= PrepareSQLchk(SalesQuote.pPO,'pPO')
		ThisFormSet.frmEO.pf1.pgBillTo.chkpPN.VALUE		= PrepareSQLchk(SalesQuote.pPN,'pPN')
		ThisFormSet.frmEO.pf1.pgBillTo.chkpHeat.VALUE	= PrepareSQLchk(SalesQuote.pHeat,'pHeat')
		ThisFormSet.frmEO.pf1.pgBillTo.chkpSpec.VALUE	= PrepareSQLchk(SalesQuote.pSpec,'pSpec')
		ThisFormSet.frmEO.pf1.pgBillTo.chkpDesc.VALUE	= PrepareSQLchk(SalesQuote.pDesc,'pDesc')
		
		ThisFormSet.frmEO.pf1.pgBillTo.chkpOther.VALUE	= PrepareSQLchk(SalesQuote.pOther,'pOther')
		ThisFormSet.frmEO.pf1.pgBillTo.txtOther.VALUE	= ShowSQLtxt(SalesQuote.Other,'Other',50)
		
		*IF NOT USED("Sales_No")
		*	ThisformSet.Load_Sales_No()
		*ENDIF		
		IF USED("Sales_No")
			ThisFormSet.frmEO.pf1.pgBillTo.chkFaxConf.VALUE		= PrepareSQLchk(Sales_No.FaxConf,'FaxConf')
			ThisFormSet.frmEO.pf1.pgBillTo.chkEmailConf.VALUE	= PrepareSQLchk(Sales_No.EmailConf,'EmailConf')
			ThisFormSet.frmEO.pf1.pgShipto.txtFreightEst.Value = PrepareSQLnum(Sales_No.FreightEst,'FreightEst',9,2)
			ThisFormSet.frmEO.pf1.pgBillTo.chkCancelSO.Value 	= PrepareSQLchk(Sales_No.cncld,'Cncld')
			
			ThisFormSet.frmEO.pf1.pgBillTo.txtBillInstrct.Value	= ShowSQLtxt(Sales_No.BillInstrct,'BillInstrct',255)
		ENDIF
		
		ThisFormset.frmEO.pf1.pgBillTo.Refresh()
		
		**********************************************
		
		IF ThisFormSet.SoldAddr > 0
			PRIVATE cCustomerID 
			cCustomerID = GetCustomerID_with_SoldCode(ThisFormSet.SoldAddr,ThisFormSet.nConnHandle)
			IF LEN(ALLTRIM(cCustomerID))=0
				ThisFormset.frmEO.pf1.pgBillTo.cmdCustomerID.Caption = 'Get CustomerID'
			ELSE
				IF LEN(cCustomerID) = 0
					ThisFormset.frmEO.pf1.pgBillTo.cmdCustomerID.Caption = 'Get CustomerID'
				ELSE
					IF LEFT(cCustomerID,3)="C00"
						ThisFormset.frmEO.pf1.pgBillTo.cmdCustomerID.Caption = cCustomerID 
					ELSE
						ThisFormset.frmEO.pf1.pgBillTo.cmdCustomerID.Caption = 'Get CustomerID'
					ENDIF
				ENDIF
			ENDIF
			
			PRIVATE nIND_Type, cCustID
			cCustID = PrepareSQLtxt(ThisFormset.frmEO.pf1.pgOrder.txtCustID.Value,'CustID',20)
			IF LEN(cCustID)>0
				nIND_Type = getIND_Type( "Customer_List_Notes", cCustID, ThisFormSet.nConnHandle)
			ELSE	
				nIND_Type = getIND_Type( "SOLDADDR", ThisFormSet.SoldAddr, ThisFormSet.nConnHandle)
			ENDIF
			
			IF nIND_Type > 0
				ThisFormset.frmEO.pf1.pgBillTo.lblIndType.Caption = STR(nInd_Type)
				ThisFormset.frmEO.pf1.pgBillTo.lblIndType.Visible = .T.
			ELSE
				*No IND type!
				IF LEN(cCustomerID) > 0
					MESSAGEBOX("No INDustry Type selected!"+CHR(13)+"Please fill in for this Customer.",0+48,"Need IND Type")
				ENDIF
				ThisFormset.frmEO.pf1.pgBillTo.lblIndType.Caption = ''
				ThisFormset.frmEO.pf1.pgBillTo.lblIndType.Visible = .F.
			ENDIF
			
			PRIVATE cSalesPs
			cSalesPs = getSalesP_Customer( ThisFormSet.SoldAddr, ThisFormSet.nConnHandle )
			ThisFormset.frmEO.pf1.pgBillTo.lblSalesP_Customer.Caption = cSalesPs
		
		ENDIF
	ENDPROC

	PROCEDURE refresh_pgcreditcard
		*ThisFormSet.Refresh_pgCreditCard()
		
		IF PrepareSQLnum(ThisFormset.frmEO.pf1.pgCreditCard.txtSalesNum.Value,'SalesNum',-3) = 0
			ThisFormSet.CreditCard("INIT")
		ENDIF
		
		ThisFormset.frmEO.pf1.pgCreditCard.Refresh
		
	ENDPROC

