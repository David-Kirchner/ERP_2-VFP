	PROCEDURE frmEO.pf1.pgValue.pfPrice.pgSOd.cmdDeleteSO_Dist.Click
		PRIVATE nID_Detail_Pro, cSOitem
		
		nID_Detail_Pro	= PrepareSQLnum(This.Parent.txtID_Detail_Pro.Value,'ID_Detail_Process',-3)
		cSOitem			= PrepareSQLtxt(This.parent.txtSOitem.Value,'SOitem',10)
		
		
		IF NOT LEN(ALLTRIM(cSOitem))=0
			cSOitem = Proper_SO_item(cSOitem)
		ELSE
			cSOitem = Proper_SO_item('')
		ENDIF
		
		IF nID_Detail_Pro < 1
			IF cSOitem = Proper_SO_item('')
				MESSAGEBOX("Must have ID",16,"Cannot Delete")
				RETURN .F.
			ELSE
				*Clear
				This.Parent.txtID_Detail_Pro.Value = 0
				This.parent.txtSOitem.Value = ''
				This.parent.txtPercent.Value = 0
				This.parent.txtQTY.Value = 0
				RETURN .F.
			ENDIF
		ENDIF
		
		IF cSOitem = Proper_SO_item('')
			MESSAGEBOX(" SOitem:"+cSOitem,16,"Cannot Delete")
			RETURN .F.
		ENDIF
		
		IF MESSAGEBOX("Are you sure you want to Delete this Distribution for SOitem:"+ALLTRIM(cSOitem)+"?",4+32,"Delete?")!=6
			RETURN .F.
		ENDIF
		
		cTbl = "S"
		IF Remove_ID_Detail_Process(nID_Detail_Pro,"SOitem",cSOitem,cTbl,ThisFormSet.nConnHandle,"CANCELLED")
		
		
			****************
			PRIVATE nDist_QTY
			nDist_QTY = 0
		
			IF USED('tmpDistQTY')
				USE IN tmpDistQTY
			ENDIF
			
			cSQL = "SELECT SUM(QTY) AS nQTY"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpDistQTY')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpDistQTY' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpDistQTY')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpDistQTY')
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpDistQTY' )
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('tmpDistQTY')
				IF RECCOUNT('tmpDistQTY') > 0
					nDist_QTY = PrepareSQLnum(tmpDistQTY.nQTY,'QTY',18,4)
					*This.txtDist_QTY.Value = nDist_QTY 
					This.Parent.txtDist_QTY.Value = nDist_QTY 
				ENDIF
				USE IN tmpDistQTY
			ENDIF
			**********************
			
			This.Parent.txtSO_Total.Value	= 0
			This.Parent.txtStk_Total.Value	= This.Parent.txtStk_P.Value * This.Parent.txtDist_QTY.Value
			
			****************
			This.parent.grdSOdist.RecordSource = ''
			
		*	reload
			IF USED('tmpSO_Dist')
				USE IN tmpSO_Dist
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT ID_Detail_Process, SOitem, QTY, Ordered_QTY "
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist')
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSO_Dist' )
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ELSE
					This.parent.grdSOdist.RecordSource = 'tmpSO_Dist'
				ENDIF
			ELSE
				This.parent.grdSOdist.RecordSource = 'tmpSO_Dist'
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgValue.pfPrice.pgSOd.cmdNewSO_Dist.Click
		This.Parent.txtID_Detail_Pro.Value = 0
		This.parent.txtSOitem.Value = ''
		This.Parent.txtPercent.Value = 0
		This.Parent.txtQTY.Value = 0
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgValue.pfPrice.pgSOd.cmdSaveSO_Dist.Click
		PRIVATE nID_Detail_Pro, cSOitem, nPercent, nQTY
		
		nID_Detail_Pro	= PrepareSQLnum(This.Parent.txtID_Detail_Pro.Value,'ID_Detail_Process',-3)
		cSOitem			= PrepareSQLtxt(This.parent.txtSOitem.Value,'SOitem',10)
		nPercent		= PrepareSQLnum(This.Parent.txtPercent.Value,'Percent',4,3)
		nQTY			= PrepareSQLnum(This.Parent.txtQTY.Value,'QTY',-5)
									
		PRIVATE nSO_QTY, nSO_P
		nSO_QTY = PrepareSQLnum(This.Parent.txtDist_QTY.Value,'Dist_QTY',-5)
		nSO_P	= PrepareSQLnum(This.Parent.txtSO_P.Value,'SO_P',-5)
										
		PRIVATE nQTYtotal, nThisTotal
		nQTYtotal = 0
		nThisTotal = 0
		
		IF NOT LEN(ALLTRIM(cSOitem))=0
			cSOitem = Proper_SO_item(cSOitem)
		ELSE
			cSOitem = Proper_SO_item('')
		ENDIF
		
		IF cSOitem = Proper_SO_item('')
			MESSAGEBOX("Bad SOitem:"+cSOitem,16,"Cannot Save")
			RETURN .F.
		ENDIF
		
		*See if SoItem exists
		IF Count_SOIteminSales(cSOItem, ThisFormSet.nConnHandle) = 0
			MESSAGEBOX("Bad SOitem:"+cSOitem+CHR(13)+"Not Found!",16,"Cannot Save")
			RETURN .F.
		ENDIF
		
		IF nPercent < 0 AND nQTY < 0
			MESSAGEBOX("Must have a Quantity of Percent!",16,"cannot Save")
			RETURN .F.
		ENDIF
		
		**********
		IF nPercent = 0
			IF nSO_QTY > 0
				nPercent = nQTY / nSO_QTY 
			ENDIF
		ENDIF
		IF nQTY = 0
			nQTY = nSO_QTY * nPercent
		ENDIF
		 
		
		nThisTotal = nQTY * nSO_P
		
		*IF USED('tmpID_Detail_Process')
		*	USE IN tmpID_Detail_Process
		*ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		IF nID_Detail_Pro > 0
			*UPDATE
		*	cSQL = "UPDATE dbo.StockLst_Process_Detail SET "
		*    cSQL = cSQL + ",[who]=(suser_sname())"
		*	cSQL = cSQL + " WHERE ID_Detail_Process="+STR(nID_Detail_Pro)
		ELSE
			MESSAGEBOX("'Select from Inventory' on Order Tab!"+CHR(13)+"to create a new Process"+CHR(13)+"then you can edit that process here!",16,"Cannot save a new Process here.")
			RETURN .F.
			
		*!*		nID_Detail_Pro = 0
		*!*		*INSERT
		*!*		cSQL="EXEC dbo.p_PO_SOdist_ins "
		*!*		cSQL = cSQL + " @POitem = '"+cPOitem+"'"
		*!*		cSQL = cSQL + ",@SOitem = '"+cSOitem+"'"
		*!*	    cSQL = cSQL + ",@QTY = "+STR(nQTY,18,4)+""
		*!*	    cSQL = cSQL + ",@P = "+STR(nSO_P,18,4)+""
		ENDIF
		*!*	SELECT 0
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist')
		*!*					
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF 
		
		****************
		This.Parent.txtDist_QTY.Value = nQTY
		****************
		This.parent.grdSOdist.RecordSource = ''
		
		IF USED('tmpSO_Dist')
			USE IN tmpSO_Dist
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT ID_Detail_Process, SOitem, QTY, Ordered_QTY "
		cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist')
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSO_Dist' )
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpSO_Dist')
			This.parent.grdSOdist.RecordSource = 'tmpSO_Dist'
			LOCATE FOR ID_Detail_Process = nID_Detail_Pro
		ENDIF
		
		**********************
		
		*This.Parent.txtSO_Total.Value = SalesQuote.ItemSale
		This.Parent.txtStk_Total.Value = getStockTotal_SOitem( SalesQuote.SOitem, ThisFormSet.nConnhandle )
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgValue.pfPrice.pgSOd.grdSOdist.AfterRowColChange
		LPARAMETERS nColIndex
		
		This.Parent.txtID_Detail_Pro.Value = tmpSO_Dist.ID_Detail_Process
		This.parent.txtSOitem.Value		= tmpSO_Dist.SOitem
		This.Parent.txtPercent.Value	= 0
		This.Parent.txtQTY.Value		= tmpSO_Dist.QTY
		
		This.Parent.txtStk_P.Value	= getStock_P_ID_Detail_Process( tmpSO_Dist.ID_Detail_Process, ThisFormSet.nConnhandle )
		This.Parent.txtSO_Total.Value = SalesQuote.ItemSale
	ENDPROC

