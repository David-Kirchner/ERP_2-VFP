		*!*		ThisFormSet.frmEO.pf1.pgOrder.cmbCert.Refresh
		*!*		ThisFormSet.frmEO.pf1.pgOrder.cmbProcLoc.Refresh
		*!*		ThisFormSet.frmEO.pf1.pgOrder.cmbTyp.Refresh
		*!*		ThisFormSet.frmEO.pf1.pgOrder.chkExport.Refresh
		
		*!*		ThisFormSet.frmEO.pf1.pgOrder.chkService.Refresh
		*!*		ThisFormSet.frmEO.pf1.pgOrder.chkINV.refresh
		*!*		ThisFormSet.frmEO.pf1.pgOrder.chkBRK.refresh
		*!*		ThisFormSet.frmEO.pf1.pgOrder.chkGFM.refresh
