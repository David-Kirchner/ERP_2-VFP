	PROCEDURE frmEO.pf1.pgShipto.chkBlindSO.Valid
		********************************
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE llBlind
		llBlind	= PrepareSQLlogic( This.Value,'Blind',.T.)
		
		
		SELECT Sales_No	&&Sales_No does not have items detail
		REPLACE Blind WITH llBlind IN Sales_No
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.chkDPAS.Valid
		********************************
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE lDPAS
		lDPAS	= PrepareSQLlogic( This.Value,'DPAS',.F.)
		
		SELECT Sales_No	&&Sales_No does not have items detail
		REPLACE DPAS WITH lDPAS IN Sales_No
		
		IF lDPAS
			WAIT WINDOW "DoD Rated, keep details like DO-A1, DX-A3 in the Quotes tab, Comments Field." nowait
			
			PRIVATE lGOV
			lGOV	= PrepareSQLlogic( Sales_No.GOV,'GOV',.F.)
			IF NOT lGOV
				lGOV = .T.
				REPLACE GOV WITH lGOV IN Sales_No
				This.parent.chkGOV.Value = 1
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.chkECPC.Valid
		********************************
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE lECPC
		lECPC	= PrepareSQLlogic( This.Value,'ECPC',.F.)
		
		SELECT Sales_No	&&Sales_No does not have items detail
		REPLACE ECPC WITH lECPC IN Sales_No
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.chkFCI.Valid
		********************************
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE lFCI
		lFCI	= PrepareSQLlogic( This.Value,'FCI',.F.)
		
		SELECT Sales_No	&&Sales_No does not have items detail
		REPLACE FCI WITH lFCI IN Sales_No
		
		IF lFCI
			WAIT WINDOW "CMMC: Federal Contract Information." nowait
			
			PRIVATE lGOV
			lGOV	= PrepareSQLlogic( Sales_No.GOV,'GOV',.F.)
			IF NOT lGOV
				lGOV = .T.
				REPLACE GOV WITH lGOV IN Sales_No
				This.parent.chkGOV.Value = 1
			ENDIF
		
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.chkGOV.Valid
		********************************
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE lGOV
		lGOV	= PrepareSQLlogic( This.Value,'GOV',.F.)
		
		SELECT Sales_No	&&Sales_No does not have items detail
		REPLACE GOV WITH lGOV IN Sales_No
		
		IF lGOV
			WAIT WINDOW "US Government Order." nowait
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgShipto.chkReceivedPO.Valid
		PRIVATE lReceivedPO
		lReceivedPO = PrepareSQLlogic(This.Value,'ReceivedPO',.F.)
		
		PRIVATE cSQL, nSQLEXEC 
		
		*!*	cSQL = "UPDATE dbo.Sales_No SET "
		*!*	cSQL = cSQL + " Paper_PO= "+IIF(lReceivedPO,'1','0')
		*!*	cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.SalesNum ))
		*!*		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*	ENDIF
		
		SELECT Sales_No	&&Sales_No does not have items detail
		REPLACE Paper_PO WITH lReceivedPO IN Sales_No
	ENDPROC

