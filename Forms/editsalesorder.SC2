	ENDPROC

	PROCEDURE frmEO.pf1.pgQA.Label1.Click
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD "
		cSQL = cSQL + " FROM dbo.Quotes_PMI WITH(NOLOCK)"
		cSQL = cSQL + " WHERE AQ_ID_Curr = "+STR(nQuotes_ID)
		
		IF USED("tmpPMIcount")
			USE IN tmpPMIcount
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPMIcount')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPMIcount')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPMIcount")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPMIcount")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPMIcount')
			
			ENDIF
		ENDIF
		
		IF USED('tmpPMIcount')
			IF RECCOUNT('tmpPMIcount') > 0
			
			ENDIF
		ENDIF
	ENDPROC

