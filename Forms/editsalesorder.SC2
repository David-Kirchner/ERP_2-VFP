			ThisFormSet.frmEO.pf1.pgQuote.cmbForm.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmbCC.Enabled = .T.
			ThisFormSet.frmEO.pf1.pgQuote.cmbCL.Enabled = .T.
