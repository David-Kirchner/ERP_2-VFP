	PROCEDURE frmEO.pf1.pgQuote.lblCost.Click
		IF This.parent.cmdEditQuote.Caption = "Save"
			MESSAGEBOX("Please save the Quote Edit First.",48,"Need to Save")
			RETURN
		ENDIF
		
		PRIVATE nQuoted_QTY, nQuoted_P, nQuoted_Total, nQuoted_PU
		nQuoted_QTY	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.Q_Qty1.Value, 'Q_QTY',-5)
		nQuoted_P	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.Q_P1.Value, 'Q_P',-5)
		nQuoted_Total	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.Q_Total1.Value, 'Q_Total',10,2)
		nQuoted_PU	= PrepareSQLnum(ThisFormSet.frmEO.pf1.pgQuote.cmbPU.Value, 'Q_PU',-1)
		
		PRIVATE nCutsP, nOtherP, nItemSale 
		nCutsP	= PrepareSQLnum(SalesQuote.Cuts,'Cuts',8,2)
		nOtherP	= PrepareSQLnum(SalesQuote.Cuts,'OtherP',8,2)
		nItemSale = nQuoted_Total +nCutsP +nOtherP
				
		IF nQuoted_PU < 1
			*bad idea to retrive what Acct Stand is
			nQuoted_PU	= GetPUfromForm( SalesQuote.Form, ThisFormSet.nConnHandle )
		ENDIF
		IF nQuoted_QTY <= 0
			*Old School
			nQuoted_Total= get_QTYwithWeight( SalesQuote.Form,SalesQuote.Pieces,SalesQuote.Thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.Weight, nQuoted_PU, ThisFormSet.nConnHandle)
			nItemSale = nQuoted_Total +nCutsP +nOtherP
		ENDIF
		
		IF nQuoted_P = 0
			IF nQuoted_Total> 0
				IF nQuoted_QTY > 0
					nQuoted_P	= nQuoted_Total / nQuoted_QTY
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE nCalcLotP, nACCT_Total, nItemSale 
		nCalcLotP = getSale_SOitem( SalesQuote.SOItem_A, ThisFormSet.nConnHandle )
		*nItemSale = nQuoted_Total +nCutsP +nOtherP
				
		
		SELECT SalesQuote
		REPLACE ItemSale	WITH nQuoted_Total	IN SalesQuote	
		REPLACE Q_QTY	WITH nQuoted_QTY	IN SalesQuote
		REPLACE Q_P		WITH nQuoted_P		IN SalesQuote
		REPLACE Q_Total WITH nQuoted_Total	IN SalesQuote
		REPLACE Q_PU 	WITH nQuoted_PU		IN SalesQuote
		*!*	REPLACE Quoted_QTY	WITH nQuoted_QTY	IN SalesQuote
		*!*	REPLACE Quoted_P	WITH nQuoted_P		IN SalesQuote
		*!*	REPLACE Quoted_Total WITH nQuoted_Total	IN SalesQuote
		*!*	REPLACE Quoted_PU 	WITH nQuoted_PU		IN SalesQuote
		
		ThisFormSet.Refresh_QuoteP('Cost')
	ENDPROC

