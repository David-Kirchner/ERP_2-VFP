		ThisFormSet.frmPO.Visible = .F.
		ThisFormSet.frmPO.AlwaysOnTop = .F.
		ThisFormSet.frmEoP.Visible = .F.
		
		
	ENDPROC

	PROCEDURE frmEO.pf1.pgQA.cmdAddQA.Click
		IF THIS.Caption = "Add"
			*Add/Edit a High QA Quote
			This.Caption = "Save"
			This.parent.cmdEditQA.Visible = .F.
			This.parent.cmdCancelEdit.Visible = .T.
			This.parent.cmdAmendmentsPrint.Visible = .F.
			**Add -set to blank
			This.Parent.edtVersionComments.Value = ""
			This.Parent.edtVersionComments.ReadOnly = .F.
			ThisFormSet.Sales_No_RevID = 0
			This.parent.txtVersion.Value = 0
			This.Parent.edtVersionComments.SetFocus
			
		ELSE
			*Save a QA spec'd Quote
			This.Caption = "Add"
			This.parent.cmdEditQA.Visible = .T.
			This.parent.cmdCancelEdit.Visible = .F.
			This.parent.cmdAmendmentsPrint.Visible = .T.
		
			This.Parent.edtVersionComments.ReadOnly = .T.
			
			PRIVATE nSalesNum,nVER,cComment, nSales_No_RevID, nItem
			nSalesNum	= ThisFormSet.SalesNum
			nVER		= PrepareSQLnum(This.parent.txtVersion.Value,'amendment',-1)
			*ThisFormSet.nAmendment
			cComment	= PrepareSQLtxt(This.Parent.edtVersionComments.Value,'Comment',-1)
			nSales_No_RevID	= ThisFormSet.Sales_No_RevID
			nItem = SalesQuote.Item
			
		*!*		**************************************
		*!*		IF nVER = 0
		*!*			*user clicked Save, after an ADD the nVER is 0
		*!*			IF ThisFormSet.nAmendment > 0
		*!*				nVER = ThisFormSet.nAmendment + 1
		*!*			ELSE
		*!*				*just keep nVER as 0 to next IF
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		IF nVER > ThisFormSet.nAmendment
		*!*			*FIX
		*!*			SELECT Sales_No
		*!*			REPLACE Amendment WITH nVER IN Sales_No
		*!*			TrackError("SO Amendment is off!","Sales_No_Rev Rev="+ALLTRIM(STR(nVER))+CHR(13)+"Screen has item="+ALLTRIM(STR(nItem))+CHR(13)+"Sales_No amendment was "+ALLTRIM(STR(ThisFormSet.nAmendment)),PROGRAM(),LINENO(1))
		*!*			ThisFormSet.nAmendment = nVER
		*!*		ELSE
		*!*			*Assume the ThisFormSet.nAmendment
		*!*			nVER = ThisFormSet.nAmendment
		*!*		ENDIF
			
			**************************************
			IF nSales_No_RevID = 0	&&holds ID for Editing the Ver Comments
				*Add
				
				PRIVATE cSQL,nSQLEXEC 
				cSQL= "INSERT INTO dbo.Sales_No_Rev ([SalesNum],[VER],[Comment]) VALUES ("
				cSQL = cSQL +""+STR(ThisFormSet.SalesNum)
				cSQL = cSQL +","+STR(nVER)
				cSQL = cSQL +",'"+cComment+"'" +")"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
					ELSE
						nSQLEXEC = 1
					ENDIF
				ENDIF
				IF nSQLEXEC > 1
					SELECT Sales_No
					ThisFormSet.nAmendment	= nAmendment
					REPLACE Amendment WITH ThisFormSet.nAmendment IN Sales_No
					ThisFormset.frmEO.pf1.pgBillTo.txtAmendment.Value = ThisFormSet.nAmendment
					
				ENDIF
						
			ELSE
				*UPDATE
				PRIVATE cSQL,nSQLEXEC 
				cSQL= "UPDATE dbo.Sales_No_Rev SET "
				cSQL= cSQL+ " Comment= '"+cComment+"'"
				cSQL= cSQL+ " WHERE ID="+STR(nSales_No_RevID)
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
				
			ENDIF
			
			ThisFormSet.Refresh_pgQA()
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgQA.cmdAmendmentsPrint.Click
		IF USED('tmpSales_No_Rev')
			SELECT tmpSales_No_Rev
		
			IF NOT "PrintPreview" $ SET("CLASSLIB")  &&Added for when Quotes is run without ERP menu.
				SET CLASSLIB TO Libs\PrintPreview ADDITIVE
			ENDIF
			oPForm = CREATEOBJECT('PrintPreview')
			oPform.Visible = .T.    && open PrintPreview form
			
			REPORT FORM Reports\Sales_No_Rev NOCONSOLE PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview	
			
			IF VARTYPE(oPform) = "O"
				oPform.Visible = .F.
				RELEASE ALL LIKE oPform
			ENDIF
			IF "PrintPreview" $ SET("CLASSLIB")  &&Added for when Quotes is run without ERP menu.
				RELEASE CLASSLIB PrintPreview 
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE frmEO.pf1.pgQA.cmdCancelEdit.Click
		This.parent.cmdAmendmentsPrint.Visible = .T.
		This.Visible = .f.
		This.Parent.cmdEditQA.Visible = .T.
		This.parent.cmdAddQA.Caption = "Add"
		This.parent.cmdAddQA.Visible = .T.
		This.parent.edtVersionComments.ReadOnly = .T.
		
		ThisFormSet.Refresh_pgQA()
	ENDPROC

	PROCEDURE frmEO.pf1.pgQA.cmdDefault.Click
		PRIVATE lInv,lBRK,lMach,lCG,lGFM,lDraw,lRoll,lPress,lPlamsa,lWJet
		lInv 	= SalesQuote.Inv
		lBRK	= SalesQuote.BRK
		lMach	= SalesQuote.Mach
		lCG		= SalesQuote.CG
		lGFM	= SalesQuote.GFM
		lDraw	= SalesQuote.Draw
		lRoll	= SalesQuote.Roll
		lPress	= SalesQuote.Press
		lPlamsa	= SalesQuote.Plasma
		lWJet	= SalesQuote.wjet
		
		**
		IF lInv
			IF nINVhrs = 0
				nINVhrs = 1
			ENDIF
		ELSE
			nINVhrs = 0
		ENDIF
		**
		IF PrepareSQLnum(SalesQuote.HPAPo,'HPAPO',-3) > 0
			IF nRecvHrs = 0
				nRecvHrs = 1	
			ENDIF
		ELSE
			nRecvHrs = 0
		ENDIF
		**
		IF lMach 
			IF nMachHrs = 0
				nMachHrs = 4
			ENDIF
		ELSE
			nMachHrs = 0
		ENDIF
		**
		IF lCG
			IF nCGhrs = 0
				nCGhrs = 4
			ENDIF
		ELSE
			nCGhrs = 0
		ENDIF
		**
		IF nPackHrs = 0
			nPackHrs = 1
		ENDIF
		**
		IF lGFM
			IF nGFMhrs = 0
				nGFMhrs = 20
			ENDIF
		ELSE
			nGFMhrs = 0
		ENDIF
		**
		IF lDraw
			IF nDrawHrs = 0
				nDrawHrs = 20
			ENDIF
		ELSE
			nDrawHrs = 0
		ENDIF
		**
		
		IF lRoll
			IF nRollHrs = 0
				nRollHrs = 20
			ENDIF
		ELSE
			nRollHrs = 0
		ENDIF
		**
		IF lPress
			IF nPressHrs = 0
				nPressHrs = 20
			ENDIF
		ELSE
			nPressHrs = 0
		ENDIF
		**
		IF lGFM OR lRoll OR lPress
			IF nHeatHrs = 0
				nHeatHrs = 8
			ENDIF
		ENDIF
		**
		IF lGFM OR lDraw OR lRoll OR lPress
			IF nTestHrs = 0
				nTestHrs = 40
			ENDIF
		ENDIF
		**
		IF nAbrsvHrs = 0
			nAbrsvHrs = 0
		ENDIF
		**
		IF nBSawHrs = 0
		*	nBSawHrs = 0
		ENDIF
		**
		IF lPlamsa
			IF nPlasmaHrs = 0
				nPlasmaHrs = 2
			ENDIF
		ELSE
			nPlasmaHrs = 0
		ENDIF
		**
		IF lWJet
			IF nWJetHrs = 0
		*		nWJetHrs = 2
			ENDIF
		ELSE
			nWJetHrs = 0
		ENDIF
		
		
		
		
		***
		nHrs = nINVhrs + nRecvHrs + nMachHrs + nCGhrs + nPackHrs + nGFMhrs + nDrawHrs + nRollHrs + nPressHrs + nHeatHrs 
		nHrs = nHrs + nTestHrs + nAbrsvHrs + nBSawHrs + nShearHrs +nPlasmaHrs + nWJetHrs + 1
		
		ThisForm.pf1.pgQA.lblHRS.Caption = STR(nHrs)
		
		*ThisForm.Save_soitem_hrs
		ThisFormSet.Save_SOitem_Hrs()
		*UPDATE dbo.SOitem_Hrs
		
		ThisFormset.frmEO.pf1.pgQA.spnINV.Value		= nINVhrs
		ThisFormset.frmEO.pf1.pgQA.spnRecv.Value	= nRecvHrs
		ThisFormset.frmEO.pf1.pgQA.spnMach.Value	= nMachHrs
		ThisFormset.frmEO.pf1.pgQA.spnCG.Value		= nCGhrs
		ThisFormset.frmEO.pf1.pgQA.spnPack.Value	= nPackHrs
		ThisFormset.frmEO.pf1.pgQA.spnGFM.Value		= nGFMhrs 
		ThisFormset.frmEO.pf1.pgQA.spnDraw.Value		= nDrawHrs
		ThisFormset.frmEO.pf1.pgQA.spnRoll.Value	= nRollHrs 
		ThisFormset.frmEO.pf1.pgQA.spnPress.Value	= nPressHrs 
		ThisFormset.frmEO.pf1.pgQA.spnHeat.Value	= nHeatHrs 
		ThisFormset.frmEO.pf1.pgQA.spnTest.Value	= nTestHrs 
		ThisFormset.frmEO.pf1.pgQA.spnAbrsv.Value	= nAbrsvHrs 
		ThisFormset.frmEO.pf1.pgQA.spnBSaw.Value	= nBSawHrs 
		ThisFormset.frmEO.pf1.pgQA.spnShear.Value	= nShearHrs
		ThisFormset.frmEO.pf1.pgQA.spnPlasma.Value	= nPlasmaHrs 
		ThisFormset.frmEO.pf1.pgQA.spnWJet.Value	= nWJetHrs
				
	ENDPROC

