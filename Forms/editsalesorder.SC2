	PROCEDURE show_pgvalue_pgsod
		PARAMETERS nItem
		*Thisformset.show_pgValue_pgSOd(item)
		
		
		SELECT SalesQuote
		LOCATE FOR Item = nItem
		
		PRIVATE cSOitem
		cSOitem = SalesQuote.SOitem
		*cSOitem = SalesTotal.SOitem
		nItem = SalesQuote.Item
		
		PRIVATE nCutsP, nOtherP, nQ_Total
		nCutsP	= PrepareSQLnum(SalesQuote.Cuts,'Cuts',8,2)
		nOtherP	= PrepareSQLnum(SalesQuote.OtherP,'OtherP',8,2)
		
		
		
		
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtSOitem.Value = cSOitem
		*****************
		PRIVATE nSO_QTY, nSO_P, nSO_Total
		nSO_Total = 0
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtDist_QTY.Value	= 0
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtDist_QTY.Value	= 0
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtStk_P.Value		= 0
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtStk_Total.Value	= 0
		
		
		PRIVATE nSO_QTY, nSO_P, nSO_Total, nSO_PU
		PRIVATE nS_QTY	&&ERP Acct Standard
		
		
		IF USED('tmpSO_QTY')
			USE IN tmpSO_QTY
		ENDIF
		
		cSQL = "SELECT Quoted_QTY"
		cSQL = cSQL + " ,Quoted_P"
		cSQL = cSQL + " ,Quoted_PU"
		cSQL = cSQL + " ,Quoted_Total" &&Cusomer
		cSQL = cSQL + " ,S_QTY"		&&ERP Acct Standard
		cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_QTY')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSO_QTY' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSO_QTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSO_QTY")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSO_QTY' )
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpSO_QTY')
			IF RECCOUNT('tmpSO_QTY') > 0
				nSO_QTY	= PrepareSQLnum(tmpSO_QTY.Quoted_QTY,'Quote_QTY',-5)
				nSO_P	= PrepareSQLnum(tmpSO_QTY.Quoted_P,'Quote_P',-5)
				nSO_Total	= PrepareSQLnum(tmpSO_QTY.Quoted_Total,'Quote_Total',-5)
				nSO_PU	= PrepareSQLnum(tmpSO_QTY.Quoted_PU,'PU',-1)
				nItemSale = nSO_Total +nCutsP +nOtherP
				
				&&ERP Acct Standard
				nS_QTY	= PrepareSQLnum(tmpSO_QTY.S_QTY,'S_QTY',-5)
				
				*ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtDist_QTY.Value	= nSO_QTY txtDist_QTY
				*ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtSO_P.Value		= nSO_P
				*ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtSO_total.Value	= nSO_Total
		
		*		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtPT_QTY.Value	 = nPT_QTY
		*		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtS_QTY.Value	 = nPT_P
		*		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtPT_total.Value= nPT_Total
		
			ENDIF
			USE IN tmpSO_QTY
		ENDIF
		
		
		****************
		PRIVATE nDist_QTY, nDist_N
		nDist_QTY = 0
		nDist_N = 0
		
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtDist_QTY.Value = 0
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtDist_N.Value = 0
		
		IF USED('tmpDistQTY')
			USE IN tmpDistQTY
		ENDIF
		
		cSQL = "SELECT SUM(QTY) AS nQTY"
		cSQL = cSQL + " ,COUNT(*) AS CNTD"
		cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpDistQTY')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpDistQTY' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpDistQTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpDistQTY")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpDistQTY' )
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpDistQTY')
			IF RECCOUNT('tmpDistQTY') > 0
				nDist_QTY	= PrepareSQLnum(tmpDistQTY.nQTY,'QTY',18,4)
				nDist_N		= PrepareSQLnum(tmpDistQTY.CNTD,'CNTD',-3)
		
				ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtDist_QTY.Value = nDist_QTY 
				ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtDist_N.Value = nDist_N
			ENDIF
			USE IN tmpDistQTY
		ENDIF
		
		**********************
		
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtID_Detail_Pro.Value = 0
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtPercent.Value		= 0
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtQTY.Value			= 0
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtStk_P.Value		= 0
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtStk_Total.Value	= 0
				
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.grdSOdist.RecordSource = ''
		
		IF USED('tmpSO_Dist')
			USE IN tmpSO_Dist
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT ID_Detail_Process, SOitem, QTY "
		cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSO_Dist' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSO_Dist")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSO_Dist")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSO_Dist' )
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpSO_Dist')
			IF NOT EOF('tmpSO_Dist')
				*GO TOP
				ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.grdSOdist.RecordSource = 'tmpSO_Dist'
			*	LOCATE FOR ID_Detail_Process = nID_Detail_Pro
		
				ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtID_Detail_Pro.Value = tmpSO_Dist.ID_Detail_Process
				ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtPercent.Value		= 0
				ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtQTY.Value			= tmpSO_Dist.QTY
				
				ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtStk_P.Value	= getStock_P_ID_Detail_Process( tmpSO_Dist.ID_Detail_Process, ThisFormSet.nConnhandle )
			ENDIF
		ENDIF
		
		**********************
		
		
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtSO_Total.Value = nSO_Total  &&SalesQuote.ItemSale
		ThisFormset.frmEO.pf1.pgValue.pfPrice.pgSOd.txtStk_Total.Value = getStockTotal_SOitem( SalesQuote.SOitem, ThisFormSet.nConnhandle )
		
		
		
	ENDPROC

	PROCEDURE soitemdescript		&& SOitemDescript
		*ThisFormSet.SOitemDescript()
		
		*Clear Screen
		ThisFormSet.frmPO.Show_frmPO()
		ThisFormSet.Show_EoP()
				
		IF USED('tmpSOItemDesc')
			USE IN tmpSOItemDesc
		ENDIF
		
		cSQL = "SELECT dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS Descript "
		cSQL = cSQL + " FROM dbo.AllQuotes AQ WITH(NOLOCK) "
		cSQL = cSQL + " WHERE AQ.SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_A+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOItemDesc')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOItemDesc' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOItemDesc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOItemDesc")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOItemDesc' )
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		PRIVATE cDescript
		IF USED('tmpSOItemDesc')
			IF RECCOUNT('tmpSOItemDesc') > 0
				cDescript = "SOitem:"+ALLTRIM(SalesQuote.SoItem_A)+" for "+PrepareSQLtxt(tmpSOItemDesc.Descript,'Descript',100)
				ThisFormSet.frmPO.pgfPO.pgPODesc.txtCond_Spec.Value = cDescript
			ENDIF
			
			USE IN tmpSOItemDesc
		
		ENDIF
	ENDPROC

	PROCEDURE so_rtr
		*ThisFormSet.SO_rtr()
		*Check for need for rtr, try to start user if needed.
		
		*Build a scan table of Items.
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('rtrSOitem')
			USE IN rtrSOitem
		ENDIF
		
		cSQL = "SELECT SOitem, GFM, Draw, Roll, Mach, CG, Plasma, WJet, TYP, cncld, cmplt "
		cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
		cSQL = cSQL + " AND [Typ]= 'P'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL, 'rtrSOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'rtrSOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "rtrSOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "rtrSOitem")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'rtrSOitem')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		PRIVATE m.cSOitem, nrtr_ID, nOper_ID, nDetail
		nrtr_ID = 0
		nOper_ID = 0
		nDetail = 0
		
		IF USED('rtrSOitem')
			IF RECCOUNT('rtrSOitem') > 0
				SCAN
					IF PrepareSQLbit(rtrSOitem.cncld,'cncld') = 1
						LOOP
					ENDIF
					IF PrepareSQLbit(rtrSOitem.cmplt,'cmplt') = 1
						LOOP
					ENDIF
					
					m.cSOitem = PrepareSQLtxt(rtrSOitem.SOitem,'SOitem',10)
					*lNeed_rtr = DoesSOitem_need_rtr(m.cSOitem,ThisFormSet.nConnHandle)
					nrtr_ID = get_rtr_ID('SOI' ,m.cSOitem, ThisFormSet.nConnHandle)
					*-- this will create if not found!
					
					IF PrepareSQLbit(rtrSOitem.GFM,'GFM') = 1
						* pOperation,pJobType
						nOper_ID = GetStandard_Oper_ID('Radial Forge','', ThisFormSet.nConnHandle)
						IF nOper_ID > 0
							nDetail = GetStandard_rtr_Detail(nOper_ID, ThisFormSet.nConnHandle)
							IF nDetail > 0
								* pcOrder, pnOrder, pnDetail, pnOper_ID, pcOper_Note, plStart, pConnHandle
								set_rtr_Detail_Oper('SOi', cSOitem, nDetail, nOper_ID, 'SO GFM',.F.,ThisFormSet.nConnHandle)
							ENDIF
						ENDIF
					ENDIF
					***
					IF PrepareSQLbit(rtrSOitem.Draw,'Draw') = 1
						nOper_ID = GetStandard_Oper_ID('','Draw', ThisFormSet.nConnHandle)
					ENDIF
					***
					IF PrepareSQLbit(rtrSOitem.Roll,'Roll') = 1
						nOper_ID = GetStandard_Oper_ID('','Rolling', ThisFormSet.nConnHandle)
					ENDIF
					***
					IF PrepareSQLbit(rtrSOitem.Mach,'MACH') = 1
						nOper_ID = GetStandard_Oper_ID('','Machine Shop', ThisFormSet.nConnHandle)
					ENDIF
					***
					IF PrepareSQLbit(rtrSOitem.CG,'CG') = 1
						nOper_ID = GetStandard_Oper_ID('','Centerless Grinder', ThisFormSet.nConnHandle)
					ENDIF
					***
					IF PrepareSQLbit(rtrSOitem.Plasma,'Plasma') = 1
						nOper_ID = GetStandard_Oper_ID('','Plasma Cut', ThisFormSet.nConnHandle)
					ENDIF
					***
					IF PrepareSQLbit(rtrSOitem.WJet,'WJet') = 1
						nOper_ID = GetStandard_Oper_ID('','Waterjet', ThisFormSet.nConnHandle)
					ENDIF
					***
					IF PrepareSQLtxt(rtrSOitem.TYP,'TYP',1) = 'P'
						*nOper_ID = GetStandard_Oper_ID('','', ThisFormSet.nConnHandle)
					ENDIF
					***
							
					
				ENDSCAN
			ENDIF
			USE IN rtrSOitem
		ENDIF
	ENDPROC

	PROCEDURE startingstocksave
		*ThisFormSet.StartingStockSave()
		
		PRIVATE cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
		cssAlloy	= PrepareSQLtxt(ThisFormset.frmStartingStock.ssALLOY1.Value,'Alloy',12)
		cssForm		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbForm.Value,'Form',2)
		cssCC		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbCC.Value,'CC',1)
		cssCL		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbCL.Value,'CL',1)
		nssPieces	= PrepareSQLnum(ThisFormset.frmStartingStock.ssPieces1.Value,'Pieces',9,0)
		nssThck		= PrepareSQLnum(ThisFormset.frmStartingStock.ssThck1.Value,'Thck',10,4)
		nssSz2		= PrepareSQLnum(ThisFormset.frmStartingStock.ssSZ21.Value,'Sz2',9,3)
		nssSz3		= PrepareSQLnum(ThisFormset.frmStartingStock.ssSZ31.Value,'Sz3',9,3)
		nssWeight	= PrepareSQLnum(ThisFormset.frmStartingStock.ssWeight1.Value,'Weight',8,1)
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpCountStartingStock')
			USE IN tmpCountStartingStock
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.StartingStock WITH(NOLOCK) "
		cSQL = cSQL + " WHERE AllQuotes_ID = "+ALLTRIM(STR(SalesQuote.ID))
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountStartingStock' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountStartingStock' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountStartingStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountStartingStock")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountStartingStock' )
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpCountStartingStock')
			IF tmpCountStartingStock.CNTD = 1
				IF NOT LEN(ALLTRIM(cssAlloy))
					*UPDATE
					cSQL = "UPDATE dbo.StartingStock SET "
					cSQL = cSQL + " Alloy='"+cssAlloy+"'"
					cSQL = cSQL + ",Form='"+cssForm+"'"
					cSQL = cSQL + ",CC='"+cssCC+"'"
					cSQL = cSQL + ",CL='"+cssCL+"'"
					cSQL = cSQL + ",Pieces="+STR(nssPieces,10,0)
					cSQL = cSQL + ",Thck="+STR(nssThck,9,4)
					cSQL = cSQL + ",Sz2="+STR(nssSz2,9,3)
					cSQL = cSQL + ",Sz3="+STR(nssSz3,9,3)
					cSQL = cSQL + ",Weight="+STR(nssWeight,8,1)
					cSQL = cSQL + ",InqNumP='"+SalesQuote.InqNumP+"'"
					cSQL = cSQL + " WHERE AllQuotes_ID = "+ALLTRIM(STR(SalesQuote.ID))
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
				ELSE
					*Alloy is blank, Remove!
					cSQL = "DELETE FROM dbo.StartingStock "
					cSQL = cSQL + " WHERE AllQuotes_ID = "+ALLTRIM(STR(SalesQuote.ID))
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF				
					
					SELECT Quotes
					REPLACE SalesQuote.StartStock WITH .F.
					ThisFormset.frmEO.pf1.pgQuote.lblStartingStock.BackColor = RGB(192,192,192)
					
					PRIVATE cUpdate
					cUpdate = "UPDATE dbo.AllQuotes SET "
					cUpdate = cUpdate + " StartStock="+IIF(SalesQuote.StartStock,"1","0")+""
					cUpdate = cUpdate + " WHERE ID = " + ALLTRIM(STR(SalesQuote.ID))
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cUpdate)
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cUpdate)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLExecError(cUpdate,ThisFormSet.nConnHandle,nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cUpdate )
						ENDIF
					ENDIF
				ENDIF
			ELSE
			
				IF NOT LEN(ALLTRIM(cssAlloy))
					*INSERT
					cSQL = "INSERT INTO dbo.StartingStock "
					cSQL = cSQL + "(Alloy,Form,CC,Pieces,Thck,Sz2,Sz3,Weight,InqNumP,AllQuotes_ID ) VALUES ("
					cSQL = cSQL + "'"+cssAlloy+"'"
					cSQL = cSQL + ",'"+cssForm+"'"
					cSQL = cSQL + ",'"+cssCC+"'"
					cSQL = cSQL + ","+STR(nssPieces,10,0)
					cSQL = cSQL + ","+STR(nssThck,9,4)
					cSQL = cSQL + ","+STR(nssSz2,9,3)
					cSQL = cSQL + ","+STR(nssSz3,9,3)
					cSQL = cSQL + ","+STR(nssWeight,8,1)
					cSQL = cSQL + ",'"+SalesQuote.InqNumP+"'"
					cSQL = cSQL + ","+STR(SalesQuote.ID)+")"
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF			
				ELSE
					*Do not Insert a blank
				ENDIF
			ENDIF
			
			USE IN tmpCountStartingStock	
			
		ENDIF
	ENDPROC

	PROCEDURE sumstocklstcost
		*ThisFormSet.sumStockLstCost()
		
		RETURN
		
		
		
		
		
		
		PRIVATE nCurrSalesNumRec
		SELECT SalesQuote
		nCurrSalesNumRec = RECNO('SalesQuote')
		
		PRIVATE cSO
		cSO = ALLTRIM(STR(ThisFormSet.SalesNum))
		
		PRIVATE cSOitem
		cSOitem = Proper_SO_Item(SalesQuote.SOItem_A)
		
		***************************************************
		* Select Stock Process for (P.QTY * P.Ordered_P) AS Cost
		***************************************************
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT p.SOitem "
		cSQL = cSQL + ",M.PO_item "
		
		cSQL = cSQL + ",ISNULL( P.QTY * P.Ordered_P,0) AS Cost "
		cSQL = cSQL + ",P.Process_ID, P.PU, P.QTY, P.Ordered_QTY "
		cSQL = cSQL + ",'S' AS TBL "
		cSQL = cSQL + " FROM dbo.StockLst_Master M  WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
		cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		cSQL = cSQL + " UNION "
		
		cSQL = cSQL + " SELECT p.SOitem "
		cSQL = cSQL + ",M.PO_item "
		
		cSQL = cSQL + ",ISNULL( P.QTY * P.Ordered_P,0) AS Cost "
		cSQL = cSQL + ",P.Process_ID, P.PU, P.QTY, P.Ordered_QTY "
		cSQL = cSQL + ",'B' AS TBL "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
		cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		IF USED('tmpSumSoStock')
			USE IN tmpSumSoStock
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSumSoStock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSumSoStock')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumSoStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumSoStock")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSumSoStock')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				RETURN
			ENDIF
		ENDIF
		
		PRIVATE nStkCost 
		nStkCost = 0
		PRIVATE cCurrSOitem
		SELECT tmpSumSoStock
		IF RECCOUNT("tmpSumSoStock") > 0
			SCAN
				cCurrSOitem = tmpSumSoStock.SOitem
		
				nStkCost = tmpSumSoStock.Cost
				 
				SELECT SalesQuote
				LOCATE FOR SOitem_A = cCurrSOitem 
				IF USED('SalesQuote')
					IF SalesQuote.ItemCost > 0 AND ;
					( ROUND( SalesQuote.ItemCost,0) != ROUND( nStkCost,0) )  &&Must use 4 decimals because ItemCost is Money
					
						nItemSale = PrepareSQLnum(SalesTotal.ItemSale,'ItemSale',10,2)
						IF MESSAGEBOX("Do you want to replace ?"+CHR(13)+;
								"$"+ALLTRIM(STR(ROUND(SalesQuote.ItemCost,0)))+" Current Cost "+CHR(13)+;
								"$"+ALLTRIM(STR(ROUND(nStkCost,0)))+" Inventory Cost  *new*"+CHR(13)+;
								"$"+ALLTRIM(STR(ROUND(nItemSale,0)))+" Sale Price."+CHR(13)+CHR(13)+;
								"SO item:"+SalesQuote.SOitem_A+CHR(13)+;
								" "+SalesQuote.Descript,4+32,"Update Sales Cost with this Inventory Cost?." )= 6
							
							SELECT SalesTotal
							LOCATE FOR Item = SalesQuote.Item_a
							REPLACE ItemSkCost WITH nStkCost IN SalesTotal
							REPLACE ItemCost   WITH nStkCost IN SalesTotal
							
							SELECT SalesQuote	
							REPLACE ItemCost WITH nStkCost IN SalesQuote
							REPLACE Inv WITH .T. IN SalesQuote
						
		*!*						***************
		*!*						cSQLu = "UPDATE dbo.Sales SET "
		*!*						cSQLu = cSQLu + " ItemCost= "+STR(PrepareSQLnum(nStkCost,'ItemCost',9,2),9,2)
		*!*						cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+cCurrSOitem +"')"
		*!*						
		*!*						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		*!*						ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumSoStock")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumSoStock")
		*!*				
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*ENDIF 
		*!*						IF nSQLEXEC < 0
		*!*							IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
		*!*						ENDIF
							***************
						ENDIF
					ELSE
						SELECT SalesTotal
						LOCATE FOR Item = SalesQuote.Item_a
						REPLACE ItemSkCost WITH nStkCost IN SalesTotal
						REPLACE ItemCost   WITH nStkCost IN SalesTotal
		
						SELECT SalesQuote
						REPLACE ItemCost WITH nStkCost IN SalesQuote
						REPLACE Inv WITH .T. IN SalesQuote
						
		*!*					***************
		*!*					cSQLu = "UPDATE dbo.Sales SET "
		*!*					cSQLu = cSQLu + " ItemCost= "+STR(PrepareSQLnum(nStkCost,'ItemCost',9,2),9,2)
		*!*					cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+cCurrSOitem +"')"
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
		*!*					ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumSoStock")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumSoStock")
		*!*				
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*					IF nSQLEXEC < 0
		*!*						IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC,'')
		*	RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
		*!*					ENDIF
						***************
		
					ENDIF
					ThisFormSet.frmEO.pf1.pgOrder.chkInv.Refresh
				ENDIF
				SELECT tmpSumSoStock
			ENDSCAN
		ELSE	
			*Found nothing in Process
		
		
		*!*		IF MESSAGEBOX("Do you want to replace ?"+CHR(13)+;
		*!*				"$"+ALLTRIM(STR(ROUND(SalesQuote.ItemCost,0)))+" Current Cost "+CHR(13)+;
		*!*				"$"+ALLTRIM(STR(ROUND(nStkCost,0)))+" Inventory Cost  *new*"+CHR(13)+;
		*!*				"$"+ALLTRIM(STR(ROUND(nItemSale,0)))+" Sale Price."+CHR(13)+CHR(13)+;
		*!*				"SO item:"+SalesQuote.SOitem_A+CHR(13)+;
		*!*				" "+SalesQuote.Descript,4+32,"Update Sales Cost with this Inventory Cost?." )= 6
				
				nStkCost = SalesQuote.ItemCost 
				SELECT SalesTotal
				LOCATE FOR Item = SalesQuote.Item_a
				REPLACE ItemSkCost WITH nStkCost IN SalesTotal
				REPLACE ItemCost   WITH nStkCost IN SalesTotal
				
				SELECT SalesQuote	
				REPLACE ItemCost WITH nStkCost IN SalesQuote
				
				ThisFormSet.frmEO.pf1.pgQuote.txtItemCost.Value = nStkCost 
				
		ENDIF
		
		IF USED('tmpSumSoStock')
			USE IN tmpSumSoStock
		ENDIF
		
		
		SELECT SalesQuote
		IF nCurrSalesNumRec > RECCOUNT()
			GO BOTTOM
		ELSE
			GOTO (nCurrSalesNumRec)
		ENDIF
		
		*ThisFormSet.frmEO.pf1.pgQuote.txtHeat.Refresh
		
	ENDPROC

	PROCEDURE totalfinishweight
		PARAMETERS nWO
		*ThisFormSet.TotalFinishWeight()
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpWOD_Total")	
			USE IN tmpWOD_Total
		ENDIF
		
		cSQL = "SELECT SUM(fWeight) AS TotWeight FROM dbo.WorkOrder_Detail WITH(NOLOCK) WHERE WO="+ALLTRIM(STR(nWO))
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOD_Total')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOD_Total')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD_Total")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD_Total")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOD_Total')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		PRIVATE nTotWeight 
		nTotWeight = 0
		
		IF USED('tmpWOD_Total')
			IF RECCOUNT('tmpWOD_Total') > 0
				nTotWeight = PrepareSQLnum(tmpWOD_Total.TotWeight,'Weight',9,1)
			ENDIF
			USE IN tmpWOD_Total
		ENDIF
		
		IF NOT LEN(ALLTRIM(cAlias))=0
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		
		RETURN nTotWeight 
	ENDPROC

	PROCEDURE total_quotes_item
		*ThisFormSet.Total_Quotes_Item()
		RETURN .T.
		
		PRIVATE nQ_PU, nQ_P, nQ_QTY, nQ_Total 
		nQ_PU	= PrepareSQLnum(Quotes.Q_PU,'Q_PU',-1)
		nQ_P	= PrepareSQLnum(Quotes.Q_P,'Q_P',-5)
		nQ_QTY	= PrepareSQLnum(Quotes.Q_QTY,'Q_TY',-5)
		nQ_Total = PrepareSQLnum(Quotes.Q_Total,'Q_Total',10,2)
		PRIVATE nS_PU, nS_P, nS_QTY, nS_Total
		nS_PU  = PrepareSQLnum(Quotes.S_PU,'S_PU',-1)
		nS_P   = PrepareSQLnum(Quotes.S_P,'S_P',-5)
		nS_QTY = PrepareSQLnum(Quotes.S_QTY,'S_QTY',-5)
		nS_Total = PrepareSQLnum(Quotes.S_Total,'S_Total',10,2)
		
		PRIVATE nCutsP, nOtherP
		nCutsP = PrepareSQLnum(Quotes.CUTS,'Cuts',8,2)
		nOtherP = PrepareSQLnum(Quotes.OtherP,'OtherP',8,2) 
		
		IF FLOOR(nQ_Total +nCutsP +nOtherP) <> ( FLOOR(nS_Total) )
			nQ_Total =  PrepareSQLnum( nQ_P * nQ_QTY, 'Q_Total',10,2)
			nS_Total =  PrepareSQLnum( (nQ_P * nQ_QTY) +nCutsP +nOtherP, 'S_Total',10,2)
		ENDIF
		
		
		DO CASE
		CASE nQ_PU = 0  &&Q_PU not set.
		
			*Old School Calc
			DO CASE
			CASE PrepareSQLnum(Quotes.P_LB,'P_LB',-5) > 0 AND (Quotes.Weight + Quotes.Cweight > 0 )
				nQ_Total =	PrepareSQLnum(Quotes.P_LB,'P_LB',-5) * (IIF(Quotes.weight > 0,Quotes.weight,Quotes.Cweight))
				nQ_PU = 1
				ThisFormSet.QUOTES.cmbPU.Value = nQ_PU
				IF nQ_P = 0
					nQ_P = PrepareSQLnum(Quotes.Q_P,'Q_P',-5)
					ThisFormSet.QUOTES.Q_P1.Value = nQ_P
				ENDIF
				IF nQ_QTY = 0
					nQ_QTY = PrepareSQLnum( Quotes.Weight ,'Weight',8,1) 
					ThisFormSet.QUOTES.Q_QTY1.Value = nQ_QTY
				ENDIF
		
			CASE PrepareSQLnum(Quotes.P_FT,'P_FT',-5) > 0 AND (Quotes.SZ2+Quotes.SZ3 > 0)
				nQ_Total = PrepareSQLnum( PrepareSQLnum(Quotes.P_FT,'P_FT',-5) * IIF(Quotes.SZ3 > 0,Quotes.SZ3,Quotes.SZ2) * IIF(Quotes.Pieces > 0,Quotes.Pieces,1) / 12 ,'Q_Total',10,2)
				nQ_P = 2
				ThisFormSet.QUOTES.cmbPU.Value = nQ_PU
				IF nQ_P = 0
					nQ_P = PrepareSQLnum(Quotes.P_FT,'Q_P',-5)
					ThisFormSet.QUOTES.Q_P1.Value = nQ_P
				ENDIF
				IF nQ_QTY = 0
					nQ_QTY = IIF(Quotes.SZ3 > 0,Quotes.SZ3,Quotes.SZ2) * IIF(Quotes.Pieces > 0,Quotes.Pieces,1) / 12
					ThisFormSet.QUOTES.Q_QTY1.Value = nQ_QTY
				ENDIF		
		
			CASE PrepareSQLnum(Quotes.P_PC,'P_PC',-5) > 0 AND Quotes.Pieces > 0
				nQ_Total = PrepareSQLnum( ( Quotes.P_PC * Quotes.Pieces ),'Q_Total',10,2)
				nQ_PU = 3
				ThisFormSet.QUOTES.cmbPU.Value = nQ_PU
				IF nQ_P = 0
					nQ_P = PrepareSQLnum(Quotes.P_PC,'Q_P',-5)
					ThisFormSet.QUOTES.Q_P1.Value = nQ_P
				ENDIF
				IF nQ_QTY = 0
					nQ_QTY = PrepareSQLnum(Quotes.Pieces,'Q_TY',-5)  
					ThisFormSet.QUOTES.Q_QTY1.Value = nQ_QTY
				ENDIF
				
			CASE PrepareSQLnum(Quotes.LOTP,'LotP',-5) > 0
				nQ_Total = PrepareSQLnum(Quotes.LOTP,'Q_Total',10,2)
				nQ_PU = 4
				ThisFormSet.QUOTES.cmbPU.Value = nQ_PU
				IF nQ_P = 0
					nQ_P = PrepareSQLnum(Quotes.LOTP,'Q_P',-5)
					ThisFormSet.QUOTES.Q_P1.Value = nQ_P
				ENDIF
				nQ_QTY = 1
				ThisFormSet.QUOTES.Q_QTY1.Value = nQ_QTY
				
			ENDCASE
			
			ThisFormSet.QUOTES.lblUnitText.Caption  = Get_cPUfrom_nPU(nQ_PU) 	&& gaPU(nQ_PU,1)
			ThisFormSet.QUOTES.lblQTY_Label.Caption = Get_Label_from_nPU(nQ_PU)	&& gaPU(nQ_PU,3)
			
		CASE nQ_PU = 1
			*Pounds
			IF PrepareSQLnum(Quotes.Q_P,'Q_P',-5) > 0
				nQ_Total = PrepareSQLnum( Quotes.Q_P * Quotes.Q_QTY,'Q_Total',10,2)
			ENDIF
			IF nQ_Total = 0
				PRIVATE nLBS
				nLBS = GetWeight(Quotes.Pieces,Quotes.Alloy,Quotes.Form,Quotes.Thck,Quotes.Sz2,Quotes.Sz3,gnConnHandle)
				nQ_Total = PrepareSQLnum( Quotes.P_LB * nLBS ,'Q_Total',10,2)
				IF nQ_Total = 0
					nQ_Total = PrepareSQLnum( (Quotes.P_LB * (IIF(Quotes.weight > 0,Quotes.weight,Quotes.Cweight))  ),'Q_Total',10,2)
				ENDIF
			ENDIF
			*nLBS = GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,gnConnHandle)
		
		CASE nQ_PU = 2
			*Feet
			nFeet  = Calc_Feet(PrepareSQLnum(Quotes.Pieces,'Pieces',-3), PrepareSQLtxt(Quotes.Form,'Form',2), PrepareSQLnum(Quotes.Sz2,'Sz2',8,3), PrepareSQLnum(Quotes.Sz3,'Sz3',8,3), gnConnHandle) 
			IF PrepareSQLnum(Quotes.Q_P,'Q_P',-5) > 0
				nQ_Total = PrepareSQLnum( (Quotes.Q_P * nFeet) ,'Q_Total',10,2)
			ENDIF
			IF nQ_Total = 0
				nQ_Total = PrepareSQLnum( (Quotes.P_FT * nFeet) ,'Q_Total',10,2)  &&IIF(Quotes.SZ3 > 0,Quotes.SZ3,Quotes.SZ2) * IIF(Quotes.Pieces > 0,Quotes.Pieces,1)
			ENDIF
			
		CASE nQ_PU = 3
			*Pieces
			IF PrepareSQLnum(Quotes.Q_P,'Q_P',-5) > 0
				nQ_Total = PrepareSQLnum( (Quotes.Q_P * Quotes.Q_QTY),'Q_Total',10,2)
			ENDIF
			IF nQ_Total = 0
				nQ_Total = PrepareSQLnum( (Quotes.P_PC * Quotes.Pieces),'Q_Total',10,2)
			ENDIF
			
		CASE nQ_PU = 4
			*Lot
			nQ_Total = PrepareSQLnum(Quotes.Q_P,'Q_P',10,2,)
			IF nQ_Total = 0
				nQ_Total = PrepareSQLnum(Quotes.LOTP,'LotP',10,2)
			ENDIF
			
		CASE nQ_PU = 5
			*Inches
			IF PrepareSQLnum(Quotes.Q_P,'Q_P',-5) > 0
				nQ_Total =	Quotes.Q_P * PrepareSQLnum(Quotes.Q_QTY,'Q_QTY',-5)
			ENDIF
			IF nQ_Total = 0
				PRIVATE nFeet, nPieces, cForm, nSz2, nSz3
				nPieces			= PrepareSQLnum(ThisFormSet.QUOTES.Pieces1.Value,'Pieces',7,0)
				cForm			= PrepareSQLtxt(ThisFormSet.QUOTES.cmbForm.Value,'Form',2)
				nSz2			= PrepareSQLnum(ThisFormSet.QUOTES.SZ21.Value,'Sz2',9,3)
				nSz3			= PrepareSQLnum(ThisFormSet.QUOTES.Sz31.Value,'Sz3',9,3)
				
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
				
				IF PrepareSQLnum(Quotes.Q_P,'Q_P',-5) > 0
					nQ_Total = PrepareSQLnum(Quotes.Q_P * nFeet * 12,'Q_Total',10,2)
				ELSE
					nQ_Total = PrepareSQLnum(Quotes.P_FT * nFeet,'Q_Total',10,2) && use feet becuase P_FT is Feet!
				ENDIF
			ENDIF
			
		CASE nQ_PU = 6
			*kg
			*nNew_QTY = PrepareSQLnum(ThisFormSet.QUOTES.Weight1.Value,'Pounds',8,1) * 2.205
			IF PrepareSQLnum(Quotes.Q_P,'Q_P',-5) > 0
				nQ_Total = PrepareSQLnum( Quotes.Q_P * Quotes.Q_QTY,'Q_Total',10,2)
			ENDIF
			IF nQ_Total = 0
				nQ_Total = PrepareSQLnum( Quotes.P_LB * (IIF(Quotes.weight > 0,Quotes.weight,Quotes.Cweight))  ,'Q_Total',10,2)
			ENDIF
			IF nQ_Total = 0
				PRIVATE nLBS, nCalcWeight
				nLBS =  PrepareSQLnum( GetWeight(Quotes.Pieces,Quotes.Alloy,Quotes.Form,Quotes.Thck,Quotes.Sz2,Quotes.Sz3,gnConnHandle),'Weight',8,1)
				nCalcWeight = nLBS  * 2.205
				
				nQ_Total = PrepareSQLnum( Quotes.P_LB * nCalcWeight ,'Q_Total',10,2)
				IF nQ_Total = 0
					nQ_Total = PrepareSQLnum( Quotes.OtherP * nCalcWeight ,'Q_Total',10,2)
				ENDIF
			ENDIF
			
		CASE nQ_PU = 7
			*Meter
			IF PrepareSQLnum(Quotes.Q_P,'Q_P',-5) > 0
				nQ_Total =	PrepareSQLnum( (Quotes.Q_P * Quotes.Q_QTY),'Q_Total',10,2)
			ENDIF
			IF nQ_Total = 0
				PRIVATE nFeet, nPieces, cForm, nSz2, nSz3
				nPieces			= PrepareSQLnum(ThisFormSet.QUOTES.Pieces1.Value,'Pieces',7,0)
				cForm			= PrepareSQLtxt(ThisFormSet.QUOTES.cmbForm.Value,'Form',2)
				nSz2			= PrepareSQLnum(ThisFormSet.QUOTES.SZ21.Value,'Sz2',9,3)
				nSz3			= PrepareSQLnum(ThisFormSet.QUOTES.Sz31.Value,'Sz3',9,3)
				
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
				
				IF PrepareSQLnum(Quotes.Q_P,'Q_P',-5) > 0
					nQ_Total =	PrepareSQLnum( (Quotes.Q_P* ( nFeet / 3.28084 )) ,'Q_Total',10,2)
				ELSE
					nQ_Total =	PrepareSQLnum(Quotes.P_FT * nFeet ,'Q_Total',10,2)&& use feet becuase P_FT is Feet!
				ENDIF
			ENDIF	
		CASE nQ_PU = 8
			*Per Hour
			nQ_Total =	PrepareSQLnum(nQ_P * nQ_QTY,'Q_Total',10,2)
		CASE nQ_PU = 9
			*$/Dy
			nQ_Total =	PrepareSQLnum(nQ_P * nQ_QTY,'Q_Total',10,2)
		OTHERWISE
			*do anything
			nQ_Total =	PrepareSQLnum( (PrepareSQLnum(Quotes.Q_P,'Q_P',-5) * PrepareSQLnum(Quotes.Q_QTY,'Q_QTY',-5)),'Q_Total',10,2)
		ENDCASE
		
		
		ThisFormSet.QUOTES.Q_Total1.Value = PrepareSQLnum(nQ_Total,'Q_Total',10,2)
		
		RETURN nQ_Total
	ENDPROC

	PROCEDURE treated_lumber_country
		IF ThisFormSet.SoldAddr > 0 AND EMPTY(ThisFormSet.frmEO.pf1.pgBillTo.txtSoldCode.VALUE)
			IF USED( 'aSoldAddr' )
				USE IN aSoldAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SoldCode = "+STR(ThisFormSet.SoldAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aSoldAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aSoldAddr' )
			ENDDO
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aSoldAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
					
			IF USED('aSoldAddr') 
		*		ThisFormSet.POSoldAddr = aSoldAddr.SoldCode
		*		This.Parent.txtPOSoldAddr.Value = aSoldAddr.SoldCode
		*		This.Parent.numSoldAddr.Value = aSoldAddr
				ThisFormSet.frmEO.pf1.pgBillTo.txtCompany.Value = aSoldAddr.Company
				ThisFormSet.frmEO.pf1.pgBillTo.txtAddr1.Value = aSoldAddr.Addr1
				ThisFormSet.frmEO.pf1.pgBillTo.txtAddr2.Value = aSoldAddr.Addr2
				ThisFormSet.frmEO.pf1.pgBillTo.txtCity.Value = aSoldAddr.City
				ThisFormSet.frmEO.pf1.pgBillTo.txtST.Value = aSoldAddr.ST
				ThisFormSet.frmEO.pf1.pgBillTo.txtZip.Value = aSoldAddr.Zip
				ThisFormSet.frmEO.pf1.pgBillTo.txtCountry.Value = UPPER(ALLTRIM(aSoldAddr.Country))
				ThisFormSet.frmEO.pf1.pgBillTo.txtMarketing.Value = PrepareSQLtxt(aSoldAddr.Marketing,'Marketing',100)
				ThisFormSet.frmEO.pf1.pgBillTo.txtContact.Value = aSoldAddr.Contact
				ThisFormSet.frmEO.pf1.pgBillTo.txtPhone.Value = aSoldAddr.Telephone
				ThisFormSet.frmEO.pf1.pgBillTo.txtFax.Value = aSoldAddr.Fax_Number
				ThisFormSet.frmEO.pf1.pgBillTo.txtEmail.Value = aSoldAddr.Email
				ThisFormSet.frmEO.pf1.pgBillTo.txtLastEdit.Value = IIF(EMPTY(PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aSoldAddr.LastEdit,'LastEdit'))
				
				
				USE IN aSoldAddr
			ENDIF		
		ENDIF
		
		IF ThisFormSet.ShipAddr > 0 AND EMPTY(ThisFormSet.frmEO.pf1.pgShipto.txtShipCode.VALUE)
		
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.ShipAddr WITH(NOLOCK) "
			cSQL = cSQL + " WHERE ShipCode = "+STR(ThisFormSet.ShipAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'aShipAddr' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "aShipAddr")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'aShipAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			IF USED('aShipAddr') 
				ThisFormSet.frmEO.pf1.pgShipto.txtCompany.VALUE 	= aShipAddr.Company
				ThisFormSet.frmEO.pf1.pgShipto.txtAddr1.VALUE		= aShipAddr.Addr1
				ThisFormSet.frmEO.pf1.pgShipto.txtAddr2.VALUE		= aShipAddr.Addr2
				ThisFormSet.frmEO.pf1.pgShipto.txtCity.VALUE 		= aShipAddr.City
				ThisFormSet.frmEO.pf1.pgShipto.txtST.VALUE		= aShipAddr.ST
				ThisFormSet.frmEO.pf1.pgShipto.txtZip.VALUE		= aShipAddr.Zip
				ThisFormSet.frmEO.pf1.pgShipto.txtCountry.VALUE	= UPPER(ALLTRIM(aShipAddr.Country))
				ThisFormSet.frmEO.pf1.pgShipto.txtContact.VALUE	= aShipAddr.Contact
				ThisFormSet.frmEO.pf1.pgShipto.txtPhone.VALUE		= aShipAddr.Telephone
				ThisFormSet.frmEO.pf1.pgShipto.txtFax.VALUE		= aShipAddr.Fax_Number
				ThisFormSet.frmEO.pf1.pgShipto.txtEmail.VALUE		= aShipAddr.Email
				ThisFormSet.frmEO.pf1.pgShipto.txtLastEdit.VALUE	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit')),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit'))
				
				USE IN aShipAddr
			ENDIF
		ENDIF
		
		
		PRIVATE cBillCountry, cShipCountry, lFoundCountry, cBillCountryABV, cShipCountryABV
		cBillCountry = PADR(UPPER(ThisFormSet.frmEO.pf1.pgBillTo.txtCountry.VALUE),15," ")
		cShipCountry = PADR(UPPER(ThisFormSet.frmEO.pf1.pgShipto.txtCountry.VALUE),15," ")
		lFoundCountry = .F.
		
		PRIVATE cHoldCountryName
		cHoldCountryName = ""
		
		IF NOT USED('HardWood')
			ThisFormSet.LoadHardwood()
		ENDIF
		
		SELECT HardWood
		INDEX ON Country TAG Country
		INDEX ON ABV TAG ABV
		
		
		IF NOT LEN(ALLTRIM(cShipCountry))=0
			SEEK cShipCountry ORDER Country IN HardWood
			IF FOUND("HardWood")
				IF NOT HardWood.Inactive
					lFoundCountry = .T.
					cHoldCountryName = cShipCountry
				ENDIF
			ENDIF
			IF NOT lFoundCountry
				IF LEN(ALLTRIM(cShipCountry)) = 2
					cShipCountryABV = LEFT(cShipCountry ,2)
					SEEK cShipCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							lFoundCountry = .T.
							cHoldCountryName = HardWood.Country
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT lFoundCountry
				SEEK cShipCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						lFoundCountry = .T.
						cHoldCountryName = cShipCountry
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT LEN(ALLTRIM(cBillCountry))=0
			IF NOT lFoundCountry
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						lFoundCountry = .T.
						cHoldCountryName = cBillCountry
					ENDIF
				ENDIF
			ENDIF
			IF NOT lFoundCountry
				IF LEN(ALLTRIM(cBillCountry )) = 2
					cBillCountryABV = LEFT(cBillCountry ,2)
					SEEK cBillCountryABV ORDER ABV IN HardWood
					IF FOUND("HardWood")
						IF NOT HardWood.Inactive
							lFoundCountry = .T.
							cHoldCountryName = HardWood.Country
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF NOT lFoundCountry
				SEEK cBillCountry ORDER Country IN HardWood
				IF FOUND("HardWood")
					IF NOT HardWood.Inactive
						lFoundCountry = .T.
						cHoldCountryName = cBillCountry
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		RETURN cHoldCountryName
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpValue')
			USE IN tmpValue
		ENDIF
		IF USED('Graph')
			USE IN Graph
		ENDIF
		IF USED('SalesNum2')
			USE IN SalesNum2
		ENDIF
		IF USED('SalesNum')
			USE IN SalesNum
		ENDIF
		IF USED("PurchaseOrder")
			USE IN PurchaseOrder
		ENDIF
		
		
		IF USED("SalesQuote")
			USE IN SalesQuote
		ENDIF
		IF USED("QuotesSO")
			USE IN QuotesSO
		ENDIF
		IF USED("tmpPoItemDetail")
			USE IN tmpPoItemDetail
		ENDIF
		IF USED("CreditCd")	
			USE IN CreditCd
		ENDIF
		
		IF ThisFormSet.nConnHandle > -1
			IF VARTYPE(gnConnHandle) = "N"
				IF gnConnHandle = ThisFormSet.nConnHandle
					* Do not close! Quotes window needs this
				ELSE
					SQLDISCONNECT(ThisFormSet.nConnHandle)
				ENDIF
			ELSE
				IF ThisFormSet.nConnHandle > 0
		*			TRY   &&Still gave Errors
		*				SQLDISCONNECT(ThisFormSet.nConnHandle)
		*			ENDTRY
				ENDIF
			ENDIF
		ENDIF
		
		*!*	IF ThisFormSet.Close_Ship
		*!*		IF USED('SHIP')
		*!*			USE IN SHIP
		*!*		ENDIF
		*!*	ELSE
		*!*		IF USED('SHIP')
		*!*			SELECT SHIP
		*!*			USE SHIP NOUPDATE
		*!*		ENDIF
		*!*	ENDIF
		
		IF ThisFormSet.Close_Sales
			IF USED('SALES')
				USE IN SALES 
			ENDIF
		ELSE
			IF USED('SALES')
				SELECT Sales
		*		USE SALES NOUPDATE
			ENDIF
		ENDIF
		IF USED('Sales_No')
			USE IN Sales_No
		ENDIF
		
		IF USED('HardWood')
			USE IN HardWood
		ENDIF
		
		IF USED('VendorContacts')
			USE IN VendorContacts
		ENDIF
		
		IF USED('Vendor')
			USE IN Vendor
		ENDIF
		
		IF USED('tmpSO_Dist')
			USE IN tmpSO_Dist
		ENDIF
		IF USED('tmpPO_Dist')
			USE IN tmpPO_Dist
		ENDIF
		IF USED('SalesTotal')
			USE IN SalesTotal
		ENDIF
		
		UniqDBFdel(ThisFormSet.fnSalesTotal)
		
		
		IF USED('tmpSales_No_Rev')
			USE IN tmpSales_No_Rev
		ENDIF
		
		IF VARTYPE(gaWOD_EditSO)#"U"
			RELEASE gaWOD_EditSO
		ENDIF
		
		IF "PURCHASEORDER" $ SET("CLASSLIB")
			RELEASE CLASSLIB libs\PurchaseOrder
		ENDIF
		*CLEAR CLASSLIB libs\wizembss.vcx
		
	ENDPROC

	PROCEDURE update_prices		&& Reads Screen data not SQL data
		*ThisFormSet.Update_Prices()
		
		*ThisFormSet.UpdtItemSale(SalesQuote.cLotP) reads from SQL data not Screen data
		*Used when Editing Quote
		
		*READ in Screen Data
		
		**nItemSalePrice is a Total with Cuts and OtherP
		PRIVATE cSOitem
		cSOitem =  SalesQuote.SOitem
		
		**************************
		PRIVATE nQ_QTY, nQ_P, nQ_PU, nWeight, nCutsP, nOtherP
		*nQuoted_PU	= GetPUfromForm( SalesQuote.Form, ThisFormSet.nConnHandle )
		nQ_P	= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.Q_P1.Value,'Q_P',-5)
		nQ_PU	= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.Q_PU1.Value,'PU',-1)
		nQ_QTY	= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.Q_QTY1.Value,'QTY',-5)
		nWeight = PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.txtWeight.Value,'Weight',8,1)
		IF nWeight = 0
			nWeight = get_QTYwithWeight( SalesQuote.Form,SalesQuote.Pieces,SalesQuote.Thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.Weight, nQuoted_PU, ThisFormSet.nConnHandle)
		ENDIF
		
		nCutsP	= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.txtCuts.Value,'Cuts',8,2)
		nOtherP	= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.txtOtherP.Value,'OtherP',8,2)
		
		PRIVATE nItemSale, nS_Total, nQ_Total
		nItemSale 	= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.txtItemSale.Value,'ItemSale',10,2)
		nS_Total	= nItemSale
		nQ_Total 	= PrepareSQLnum(ThisFormSet.FrmEO.pf1.pgQuote.Q_Total1.Value,'Q_Total',10,2)
		
		IF nQ_Total = 0
			IF nItemSale > 0
				nQ_Total = nItemSale -nCutsP -nOtherP
			ENDIF
		ELSE
			IF nItemSale = 0
				nItemSale = nQ_total +nCutsP +nOtherP
			ENDIF
		ENDIF
		
		
		IF nQ_P = 0 AND nQ_Total > 0 AND nQ_QTY > 0
			nQ_P	= nQ_Total / nQ_QTY
			
			ThisFormSet.FrmEO.pf1.pgQuote.Q_P1.Value = nQ_P
		ENDIF
		
		IF nQ_Total > 0 AND ROUND(nQ_Total +nCutsP +nOtherP, 0) # ROUND(nItemSale, 0)
			nItemSale = nQ_Total +nCutsP +nOtherP
			ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Value = nItemSale 
		ENDIF
		
		
		PRIVATE nItem2, lFoundCost
		nItem2 = SalesQuote.Item
		lFoundCost = .F.
		
		***********************************************************
		*CalcPgValues() does ItemCost, StkCost ,POCost
		IF NOT USED('SalesTotal')
			ThisFormSet.CalcPgValues()
		ENDIF
		
		***********************************************************
		
		
		ThisFormSet.FrmEO.pf1.pgQuote.txtWeight.Value = nWeight 
		ThisFormSet.FrmEO.pf1.pgQuote.Q_P1.Value	= PrepareSQLnum(nQ_P,'Q_P',-5)
		ThisFormSet.FrmEO.pf1.pgQuote.Q_PU1.Value	= PrepareSQLnum(nQ_PU,'PU',-1)
		ThisFormSet.FrmEO.pf1.pgQuote.Q_QTY1.Value	= PrepareSQLnum(nQ_QTY,'QTY',-5)
		ThisFormSet.FrmEO.pf1.pgQuote.Q_Total1.Value = PrepareSQLnum(nItemSale,'Q_Total',10,2)
		
		ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Value = PrepareSQLnum(nItemSale,'Q_Total',10,2)
		
			
	ENDPROC

	PROCEDURE update_sales_init		&& Match Quote price to dbo.Sales on Init
		*ThisFormSet.Update_Sales_init()	&&Match Quotes prices with the copy in dbo.Sales
		
		
		*Update dbo.Sales to match Quotes
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpUpdate")
			USE IN tmpUpdate
		ENDIF
		
		cSQL = "UPDATE dbo.Sales SET "
		cSQL = cSQL + " Quoted_PU = AQ.Q_PU "
		cSQL = cSQL + ",Quoted_P = AQ.Q_P "
		cSQL = cSQL + ",Quoted_QTY = AQ.Q_QTY "
		cSQL = cSQL + ",Quoted_Total = AQ.Q_Total "
		
		cSQL = cSQL + ",Quoted_CutsP = AQ.Cuts "
		cSQL = cSQL + ",Quoted_OtherP = AQ.OtherP "
		cSQL = cSQL + ",Quoted_DollarTotal = (AQ.Q_Total +ISNULL(AQ.Cuts,0) +ISNULL(AQ.OtherP,0) ) "
		
		cSQL = cSQL + ",ItemSale = (AQ.Q_Total +ISNULL(AQ.Cuts,0) +ISNULL(AQ.OtherP,0) ) "
		
		cSQL = cSQL + " FROM dbo.Sales S WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.AllQuotes AQ WITH(NOLOCK) ON S.SOitem = AQ.SOitem "
		cSQL = cSQL + " WHERE S.SalesNum = "+STR(ThisFormSet.SalesNum)
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUpdate')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUpdate')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUpdate")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUpdate")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpUpdate')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE update_sales_total
		*ThisFormSet.Update_Sales_total()	&&Match Quotes prices with the copy in dbo.Sales
		*Correct for ubknown Zeros
		*Called from INIT()
		
		*IF NOT USED('SalesQuote')
		*	TrackError("Lost table SalesQuote","Lost table SalesQuote", PROGRAM(), LINENO(1))
		*ENDIF
		
		PRIVATE cSOitem
		cSOitem =  Quotes.SOitem
		PRIVATE nCutsP, nOtherP
		nCutsP	= PrepareSQLnum(Quotes.Cuts,'Cuts',8,2)
		nOtherP	= PrepareSQLnum(Quotes.OtherP,'OtherP',8,2)
		
		PRIVATE nQ_P, nQ_PU, nQ_QTY, nQ_Total
		nQ_P	= PrepareSQLnum(Quotes.Q_P,'Q_P',-5)
		nQ_PU	= PrepareSQLnum(Quotes.Q_PU,'PU',-1)
		nQ_QTY	= PrepareSQLnum(Quotes.Q_QTY,'QTY',-5)
		IF nQ_Qty = 0
			nQ_QTY	= get_QTYwithWeight( Quotes.Form,Quotes.Pieces,Quotes.Thck,Quotes.Sz2,Quotes.Sz3,Quotes.Weight, nQuoted_PU, ThisFormSet.nConnHandle)
		ENDIF
		nQ_Total	= PrepareSQLnum(Quotes.Q_Total,'Total',-5)
		
		****************************************************************************
		
		*!*	PRIVATE nQuoted_P, nQuoted_PU, nQuoted_QTY, nQuoted_Total, nQuoted_DollarTotal
		*!*	nQuoted_P	= PrepareSQLnum(Sales.Quoted_P,'Q_P',-5)
		*!*	nQuoted_PU	= PrepareSQLnum(Sales.Quoted_PU,'PU',-1)
		*!*	nQuoted_QTY	= PrepareSQLnum(Sales.Quoted_QTY,'QTY',-5)
		*!*	nQuoted_Total	= PrepareSQLnum(Sales.Quoted_Total,'Total',-5)
		*!*	nQuoted_DollarTotal = PrepareSQLnum(Sales.Quoted_DollarTotal,'Total',-5)
		
		*!*	*****************************************************************************
		*!*	IF nQ_PU > 10
		*!*		IF nQ_P > 0 AND nQuoted_P <> nQ_P
		*!*			nQuoted_P = nQ_P
		*!*		ENDIF
		*!*		IF nQ_PU> 0 AND nQuoted_PU <> nQ_PU
		*!*			nQuoted_PU= nQ_PU
		*!*		ENDIF
		*!*		
		*!*		IF nQuoted_Qty = 0 AND nQ_PU = 1
		*!*			nQuoted_QTY	= get_QTYwithWeight( Quotes.Form,Quotes.Pieces,Quotes.Thck,Quotes.Sz2,Quotes.Sz3,Quotes.Weight, nQuoted_PU, ThisFormSet.nConnHandle)
		*!*		ENDIF
		*!*		
		*!*		IF nQ_QTY> 0 AND nQuoted_Qty <> nQ_QTY
		*!*			nQuoted_Qty = nQ_QTY
		*!*		ENDIF
		*!*		IF nQ_Total> 0 AND nQuoted_P <> nQuoted_Total
		*!*			nQuoted_Total= nQ_Total
		*!*		ENDIF
		*!*		IF nQuoted_Total > 0 AND nQuoted_DollarTotal <> nQuoted_Total +nCutsP +nOtherP
		*!*			nQuoted_DollarTotal = nQuoted_Total +nCutsP +nOtherP
		*!*		ENDIF
		*!*	ELSE
		*!*		nQuoted_P = 0
		*!*		nQuoted_QTY = 0
		*!*		nQuoted_total = 0
		*!*		nQuoted_DollarTotal = nQuoted_Total +nCutsP +nOtherP
		*!*	ENDIF
		
		****************************************************************************
		
		PRIVATE nS_P, nS_PU, nS_QTY, nWeight, nS_Total, nItemSale
		nS_P	= PrepareSQLnum(Quotes.S_P,'Q_P',-5)
		nS_PU	= PrepareSQLnum(Quotes.S_PU,'PU',-1)
		nS_QTY	= PrepareSQLnum(Quotes.S_QTY,'QTY',-5)
		nWeight = PrepareSQLnum(Quotes.Weight,'Weight',7,1)
		
		nS_Total	= PrepareSQLnum(Quotes.S_Total,'Total',-5)
		
		*****************************************************************************
		
		IF nS_Total = 0
			IF nS_P > 0 AND nS_QTY > 0
				nS_Total = (nS_P * nS_QTY) +nCutsP +nOtherP
			ELSE
				IF nQ_Total > 0
					nS_Total = nQ_Total +nCutsP +nOtherP
				ENDIF
			ENDIF
		ENDIF
		
		*IF nS_QTY = 0
		*nItemSale = nS_Total  +nCutsP +nOtherP
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE updtitemsale
		PARAMETER npLotPrice
		*ThisFormSet.UpdtItemSale(SalesQuote.cLotP)
		*Called at INIT
		*RETURN
		
		
		**nItemLotPrice is a Total with Cuts and OtherP
		PRIVATE nItemLotPrice
		nItemLotPrice = PrepareSQLnum(npLotPrice,'ItemSale',-5)
		PRIVATE cSOitem
		cSOitem =  SalesQuote.SOitem
		
		**************************
		PRIVATE nQ_QTY, nQ_P, nQ_PU, nCutsP, nOtherP
		*nQuoted_PU	= GetPUfromForm( SalesQuote.Form, ThisFormSet.nConnHandle )
		nCutsP	= PrepareSQLnum(SalesQuote.Cuts,'Cuts',8,2)
		nOtherP	= PrepareSQLnum(SalesQuote.OtherP,'OtherP',8,2)
		
		nQ_P	= PrepareSQLnum(SalesQuote.Q_P,'Q_P',-5)
		nQ_PU	= PrepareSQLnum(SalesQuote.Q_PU,'PU',-1)
		nQ_QTY	= PrepareSQLnum(SalesQuote.Q_QTY,'QTY',-5)
		IF nQ_Qty = 0
			nQ_QTY	= get_QTYwithWeight( SalesQuote.Form,SalesQuote.Pieces,SalesQuote.Thck,SalesQuote.Sz2,SalesQuote.Sz3,SalesQuote.Weight, nQuoted_PU, ThisFormSet.nConnHandle)
		ENDIF
		
		PRIVATE nQ_total	
		nQ_total	= PrepareSQLnum(SalesQuote.Q_Total,'total',-5)
		*nQuoted_DollarTotal = PrepareSQLnum(SalesQuote.Quoted_DollarTotal,'Quoted_DollarTotal',-5)
		
		IF nQ_Total = 0
			IF NOT (VARTYPE(nItemLotPrice) = "N" OR VARTYPE(nItemLotPrice) = "Y")
				nItemLotPrice = PrepareSQLnum(SalesQuote.ItemSale,'ItemSale',10,2)
				nQ_Total = nItemLotPrice -nCutsP -nOtherP
			ENDIF
		ENDIF
		
		
		IF nQ_P = 0 AND nQ_Total > 0 AND nQ_QTY > 0
			nQ_P	= nQ_Total / nQ_QTY
			SELECT SalesQuote
			REPLACE Q_P WITH nQ_P IN SalesQuote
		ENDIF
		
		IF nQ_Total >0 
			IF ROUND(nItemLotPrice,0) # ROUND(nQ_Total +nCutsP +nOtherP,0)
				nItemLotPrice = nQ_Total +nCutsP +nOtherP
				SELECT SalesQuote
				REPLACE ItemSale WITH nItemLotPrice IN SalesQuote
			ENDIF
		ENDIF
		
		
		PRIVATE nItem2, lFoundCost
		nItem2 = SalesQuote.Item
		lFoundCost = .F.
		
		***********************************************************
		*CalcPgValues() does ItemCost, StkCost ,POCost
		IF NOT USED('SalesTotal')
			ThisFormSet.CalcPgValues()
		ENDIF
		
		***********************************************************
		PRIVATE	lST_FoundCost, nST_ItemSale, nST_ItemCost, nST_StkCost, nST_StkPaid, nST_POCost
		lST_FoundCost	= .F.
		nST_ItemSale	= 0
		nST_ItemCost	= 0
		nST_StkCost		= 0
		nST_StkPaid		= 0
		nST_POCost		= 0
		PRIVATE nItemCost, nStkCost, nStkPaid, nPOCost
		nItemCost	= 0
		nStkCost	= 0
		nStkPaid	= 0
		nPOCost		= 0
		
		***********************************************************
		
		PRIVATE cSQLu, nSQLEXEC
		IF VARTYPE(nItemLotPrice) = "N" OR VARTYPE(nItemLotPrice) = "Y"
		  IF nItemLotPrice > 0
			IF SalesQuote.ItemSale > 0
				IF ROUND(SalesQuote.ItemSale,2) != ROUND(nItemLotPrice,2)
					IF MESSAGEBOX( "Sales Price is entered as $"+ALLTRIM(STR(SalesQuote.ItemSale,9,2))+CHR(13)+;
					"Your edit calculates to a price of $"+ALLTRIM(STR(nItemLotPrice,9,2))+CHR(13)+CHR(13)+;
					"Do you want to use the new calculated number?",4+32,"Update Sale Price")=6
						
						REPLACE SalesQuote.ItemSale WITH nItemLotPrice IN SalesQuote
						
						ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Value = nItemLotPrice
						ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Refresh
						*ThisFormSet.frmEO.pf1.pgQA.txtItem.Refresh()
						
						nItemLotPrice = PrepareSQLNum(nItemLotPrice,'ItemSale',9,2)
						
						SELECT SalesTotal
						REPLACE ItemSale WITH nItemLotPrice IN SalesTotal
						
						SELECT SalesQuote
						REPLACE ItemSale WITH nItemLotPrice IN SalesQuote
						
						ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Value = nItemLotPrice
		
			
					ENDIF
				ENDIF
			ELSE
		*!*	*		No Price set
		*!*			
				nItemLotPrice = PrepareSQLNum(ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Value,'ItemSale',9,2)
		
				IF USED('SalesTotal')
					SELECT SalesTotal
					REPLACE ItemSale WITH nItemLotPrice IN SalesTotal
					ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Value = nItemLotPrice
				ENDIF
				
				SELECT SalesQuote
				REPLACE ItemSale WITH nItemLotPrice IN SalesQuote
				ThisFormSet.frmEO.pf1.pgQuote.txtItemSale.Value = nItemLotPrice
		
		
			ENDIF
		  ENDIF
		ELSE
		*	MESSAGEBOX("UpdtItemSale() expected a Number")
		ENDIF
		
		*******
		*ThisFormSet.Refresh_QuoteP()
	ENDPROC

	PROCEDURE frmCustomer.cmdEditSave.Click
		
		
		IF This.Caption = "Edit"
			ThisForm.edtCustomer.ReadOnly = .F.
			This.Caption = "Save"
			
			IF EMPTY(ThisForm.edtCustomer.Value)
				ThisForm.edtCustomer.Value = ALLTRIM(STR(YEAR(DATE())))+" "
			ENDIF
			
			ThisForm.edtCustomer.SetFocus
			
		ELSE
			This.Caption = "Edit"
			ThisForm.edtCustomer.ReadOnly = .T.
			
			ThisFormSet.SaveCustomerNotes(ThisForm.edtCustomer.Value)	
		
		ENDIF
	ENDPROC

	PROCEDURE frmEO.cmdConfirmSO.Click
		CLEAR TYPEAHEAD
		
		ThisForm.cmdSO_Save.Click
		
		PRIVATE cQ_faxnm
		
		SELECT SalesQuote
		*GO TOP &&IN SalesQuote
		GO TOP IN SalesQuote	&&Why did Glenda get Alias 'SALESQUOTE' is not found. 10/02/18
		
		**********************
		PRIVATE nSoldAddr
		nSoldAddr = PrepareSQLnum(ThisFormSet.SoldAddr,'SoldCode',-3)
		
		IF USED( 'SoldAddr' )
			USE IN SoldAddr
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.SoldAddr WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SoldCode = "+STR(nSoldAddr)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'SoldAddr')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'SoldAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SoldAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "SoldAddr")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'SoldAddr')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		*********************	
		PRIVATE nShipAddr
		nShipAddr = PrepareSQLnum(ThisFormSet.ShipAddr,'ShipCode',-3)
		
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.ShipAddr WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ShipCode = "+STR(nShipAddr)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ShipAddr' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ShipAddr' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ShipAddr")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'ShipAddr')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		*********************	
		IF USED( 'Sales_No' )
			USE IN Sales_No
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Sales_No WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Sales_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_No")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'Sales_No')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		**********************
		
		IF MESSAGEBOX("Do you want to Preview or Print?",4+32) = 6
		*	ThisForm.AlwaysOnTop = .F.
		*	ThisForm.AlwaysOnBottom = .T.
			ThisForm.Visible = .F.
			PRIVATE lfrmPOVisible
			lfrmPOVisible = ThisFormSet.frmPO.Visible
			ThisFormSet.frmPO.Visible = .F.
			ThisFormSet.frmEoP.Visible = .F.
		
			*PRIVATE lPOAllWaysOnTop
			*lPOAllWaysOnTop = ThisFormSet.frmPO.AlwaysOnTop
			**ThisFormSet.frmPO.AlwaysOnTop = lPOAllWaysOnTop
			
			SELECT SalesQuote
			IF FILE('reports\ConfSalesOrder.FRX')
				REPORT FORM reports\ConfSalesOrder TO PRINTER PREVIEW IN SCREEN
				*REPORT FORM reports\ConfSalesOrder TO PRINTER PREVIEW
				
				TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was printed on ("+DTOC(DATE())+")"+" "+PROGRAM() )
				Save_Sales_Status( ThisFormSet.SalesNum, 'Print', 'Print Sales Order Confirmation', ThisFormSet.nConnHandle )
				*calls: GetCancelReason if "CANCEL or REMOVE"
			ELSE
				IF FILE('\reports\ConfSalesOrder.FRX')
					REPORT FORM \reports\ConfSalesOrder TO PRINTER PREVIEW IN SCREEN
					*REPORT FORM \reports\ConfSalesOrder TO PRINTER PREVIEW
					TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was printed on ("+DTOC(DATE())+")"+" "+PROGRAM() )
					Save_Sales_Status( ThisFormSet.SalesNum, 'Print', 'Print Sales Order Confirmation', ThisFormSet.nConnHandle )
					*calls: GetCancelReason if "CANCEL or REMOVE"
				ELSE
					WAIT WINDOW "Report form 'reports\ConfSalesOrder' not found" NOWAIT
					TrackMess("Report form 'reports\ConfSalesOrder' not found"+CHR(13)+" SO: "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation."+" "+PROGRAM() )
				ENDIF
			ENDIF	
			
			PRIVATE nMess 
			nMess = Messagebox("Do you want to Second Print?"+CHR(13)+"To a different Printer?",4+32,"Second Print?")
			IF nMess = 6
				SELECT SalesQuote
				IF FILE('reports\ConfSalesOrder.FRX')
		
					REPORT FORM reports\ConfSalesOrder TO PRINTER PROMPT
					
					TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was printed on ("+DTOC(DATE())+")"+" "+PROGRAM() )
					Save_Sales_Status( ThisFormSet.SalesNum, 'Print', 'Print Sales Order Confirmation', ThisFormSet.nConnHandle )
					*calls: GetCancelReason if "CANCEL or REMOVE"
				ELSE
					IF FILE('\reports\ConfSalesOrder.FRX')
		
						REPORT FORM \reports\ConfSalesOrder TO PRINTER PROMPT
						TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was printed on ("+DTOC(DATE())+")"+" "+PROGRAM() )
						Save_Sales_Status( ThisFormSet.SalesNum, 'Print', 'Print Sales Order Confirmation', ThisFormSet.nConnHandle )
						*calls: GetCancelReason if "CANCEL or REMOVE"
					ELSE
						WAIT WINDOW "Report form 'reports\ConfSalesOrder' not found" NOWAIT
						TrackMess("Report form 'reports\ConfSalesOrder' not found"+CHR(13)+" SO: "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation."+" "+PROGRAM() )
					ENDIF
				ENDIF
			
			ENDIF
			ThisForm.Visible = .T.
			IF VARTYPE(ThisFormSet.frmPO)="O"
				ThisFormSet.frmPO.Visible = lfrmPOVisible  
			ENDIF
			IF VARTYPE(ThisFormSet.frmEoP)="O"
				ThisFormSet.frmEoP.Visible = lfrmPOVisible 
			ENDIF
		
			IF NOT USED('SalesQuote')
				PRIVATE cMess
				cMess = "SalesQuote table is gone!."+CHR(13)
				TrackError("Print or Preview Confirm SO",cMess,PROGRAM(),LINENO(1))
				RETURN .F.
			ENDIF
			
			SELECT SalesQuote
			GO TOP IN SalesQuote
			
		ENDIF
		
		
		********************************
		*!*	**********************
		
		*!*	IF MESSAGEBOX("Do you want to Preview or Print?",4+32) = 6
		*!*	*	ThisForm.AlwaysOnTop = .F.
		*!*	*	ThisForm.AlwaysOnBottom = .T.
		*!*		ThisForm.Visible = .F.
		*!*		PRIVATE lfrmPOVisible
		*!*		lfrmPOVisible = ThisFormSet.frmPO.Visible
		*!*		ThisFormSet.frmPO.Visible = .F.
		*!*		ThisFormSet.frmEoP.Visible = .F.
		
		*!*		*PRIVATE lPOAllWaysOnTop
		*!*		*lPOAllWaysOnTop = ThisFormSet.frmPO.AlwaysOnTop
		*!*		**ThisFormSet.frmPO.AlwaysOnTop = lPOAllWaysOnTop
		*!*		
		*!*		IF NOT "PrintPreview" $ SET("CLASSLIB")  &&Added for when Quotes is run without ERP menu.
		*!*			SET CLASSLIB TO Libs\PrintPreview ADDITIVE
		*!*		ENDIF
		*!*		oPForm = CREATEOBJECT('PrintPreview')
		*!*		oPform.Visible = .T.    && open PrintPreview form
		*!*	 
		*!*		SELECT SalesQuote
		*!*		IF FILE('reports\ConfSalesOrder.FRX')
		*!*			*REPORT FORM reports\ConfSalesOrder TO PRINTER PREVIEW IN SCREEN
		*!*			REPORT FORM reports\ConfSalesOrder TO PRINTER PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview
		*!*			
		*!*			TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was printed on ("+DTOC(DATE())+")"+" "+PROGRAM() )
		*!*			Save_Sales_Status( ThisFormSet.SalesNum, 'Print', 'Print Sales Order Confirmation', ThisFormSet.nConnHandle )
		*!*		ELSE
		*!*			IF FILE('\reports\ConfSalesOrder.FRX')
		*!*				*REPORT FORM \reports\ConfSalesOrder TO PRINTER PREVIEW IN SCREEN
		*!*				REPORT FORM \reports\ConfSalesOrder TO PRINTER PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview
		*!*				TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was printed on ("+DTOC(DATE())+")"+" "+PROGRAM() )
		*!*				Save_Sales_Status( ThisFormSet.SalesNum, 'Print', 'Print Sales Order Confirmation', ThisFormSet.nConnHandle )
		*!*			ELSE
		*!*				WAIT WINDOW "Report form 'reports\ConfSalesOrder' not found" NOWAIT
		*!*				TrackMess("Report form 'reports\ConfSalesOrder' not found"+CHR(13)+" SO: "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation."+" "+PROGRAM() )
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		IF VARTYPE(oPform) = "O"
		*!*			oPform.Visible = .F.
		*!*			RELEASE ALL LIKE oPform
		*!*		ENDIF
		*!*		IF "PrintPreview" $ SET("CLASSLIB")  &&Added for when Quotes is run without ERP menu.
		*!*			RELEASE CLASSLIB PrintPreview 
		*!*		ENDIF
		
		*!*		ThisForm.Visible = .T.
		*!*		IF VARTYPE(ThisFormSet.frmPO)="O"
		*!*			ThisFormSet.frmPO.Visible = lfrmPOVisible   &&Unknown member 6/16/14 +12/2/14 +6/3/16 +3/3/17
		*!*		ENDIF
		*!*		IF VARTYPE(ThisFormSet.frmEoP)="O"
		*!*			ThisFormSet.frmEoP.Visible = lfrmPOVisible 
		*!*		ENDIF
		
		*!*		IF NOT USED('SalesQuote')
		*!*			PRIVATE cMess
		*!*			cMess = "SalesQuote table is gone!."+CHR(13)
		*!*			TrackError("Print or Preview Confirm SO",cMess,PROGRAM(),LINENO(1))
		*!*			RETURN .F.
		*!*		ENDIF
		
		*!*		GO TOP IN SalesQuote
		*!*		
		*!*	ENDIF
		
		
		********************************
		CLEAR TYPEAHEAD
		
		
		PRIVATE cQouteEmail, cQuoteName, lSendEmail = .T.
		cQouteEmail	= ALLTRIM(PrepareSQLtxt(SalesQuote.Email,'Email',60))
		cQuoteName	= PrepareSQLtxt(SalesQuote.Name,'Name',25)
		lSendEmail = .T.
		PRIVATE cEmail, cContact, cHomeSalesp 
		cHomeSalesp = ""
		cEmail = ALLTRIM(PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgBillTo.txtEmail.Value,'Email',60))
		cContact = ALLTRIM(PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgBillTo.txtContact.Value,'Contact',25))
		
		**********
		
		PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
		lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.F.
		ENDIF
		lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.F.
		ENDIF
		
		PRIVATE cNewEmail
		cNewEmail=''
		DO FORM Forms\SelectEmail WITH cQouteEmail,cQuoteName,cEmail,cContact,'',''  TO cNewEmail
		IF LEN(ALLTRIM(cNewEmail))=0
			lSendEmail = .F.
		ELSE
			cQouteEmail = cNewEmail
		ENDIF
		
		IF lEOAllWaysOnTop
			ThisFormSet.frmEO.AlwaysOnTop =.T.
		ENDIF
		IF lPOAllWaysOnTop
			ThisFormSet.frmPO.AlwaysOnTop =.T.
		ENDIF
		
		***********
		
		IF lSendEmail &&Skip if already selected not to email
			IF LEN(ALLTRIM(cQouteEmail))=0
				MESSAGEBOX("No Email Address"+CHR(13)+"Enter the Email in the Qoute"+CHR(13)+"or Bill To address Tab",0,"Cannot Email!")
				lSendEmail = .F.
			ENDIF
		ENDIF
		
		IF lSendEmail 
			PRIVATE cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, cNewPDFName
			
			IF LEN(ALLTRIM(cHomeSalesp))=0
				cHomeSalesp = SalesQuote.SalesP
				WAIT WINDOW "SalesP was set to '"+cHomeSalesp+"'." NOWAIT
			ENDIF
			*Proc_ERP:EmailFileName
			cFileName = EmailFileName("HPA_SO.PDF")	&&in Proc_ERP - Adds Current DB folder to use.
		*	MESSAGEBOX( "Email File Name set as ["+cFileName+"]",0,"Click any key to continue...")
			
			cEmailTo	= cQouteEmail 
			cEmailFrom	= SalesPEmail(SalesQuote.SalesP,SalesQuote.Cover)
			cNewPDFName	= "HPA_Sales_Order_"+ALLTRIM(STR( ThisFormSet.SalesNum ))+".pdf"
			cSubject	= "Sales Order #"+ALLTRIM(STR( ThisFormSet.SalesNum ))+" Confirmation from Space Alloys USA"
			cMessage	= ""
			
		
		
			SELECT SalesQuote
			GO TOP IN SalesQuote
		
			DO WHILE FILE(cFileName)
				nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
				IF nMess = 7 &&No
					DELETE FILE (cFileName)
				ENDIF
			ENDDO
			
										
		
			*****************************
			TRY
				
				Local loListener As "PdfListener" Of "Pdfx.vcx"
				
				loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
				loListener.cCodePage="CP1252" &&CodePage
				loListener.cTargetFileName = cFileName
				loListener.QuietMode=.F.
				loListener.lCanPrint=.T.
				loListener.lCanEdit=.F.
				loListener.lCanCopy=.T.
				loListener.lCanAddNotes=.F.
				loListener.lEncryptDocument=.F.
				loListener.cMasterPassword=''
				loListener.cUserPassword=''
				loListener.lOpenViewer=.F.
		
				*THISFORM.AlwaysOnBottom = .T.
				*THISFORM.VISIBLE = .F.
		
				PRIVATE lfrmPOVisible
				lfrmPOVisible = ThisFormSet.frmPO.Visible
				ThisFormSet.frmPO.Visible = .F.
				ThisFormSet.frmEoP.Visible = .F.
		
				SELECT SalesQuote
				IF FILE('\reports\ConfSalesOrder.FRX')
					REPORT FORM \reports\ConfSalesOrder Object loListener
					WAIT WINDOW "REPORT FORM \reports\ConfSalesOrder Object loListener" TIMEOUT 1
				ELSE
					IF FILE('reports\ConfSalesOrder.FRX')
						REPORT FORM reports\ConfSalesOrder Object loListener
						WAIT WINDOW "REPORT FORM reports\ConfSalesOrder Object loListener" TIMEOUT 1
					ELSE
						WAIT WINDOW "Report form '\reports\ConfSalesOrder' not found" TIMEOUT 4
						TrackError("Send Email Error","Report form '\reports\ConfSalesOrder' not found",PROGRAM(),LINENO(1))
					ENDIF
				ENDIF
		
				ThisForm.Visible = .T.
				ThisFormSet.frmPO.Visible = lfrmPOVisible 
				ThisFormSet.frmEoP.Visible = lfrmPOVisible 
				*ThisForm.AlwaysOnBottom = .F.
				*ThisForm.AlwaysOnTop = .T.
				RELEASE loListener
		
		*		WAIT WINDOW "Making PDF" TIMEOUT 2
				PRIVATE nCount
				nCount = 0
				DO WHILE NOT FILE(cFileName) AND nCount < 3
					WAIT WINDOW "Waiting for file:"+cFileName+" to be made." TIMEOUT 1
					nCount = nCount + 1
				ENDDO
		
				SET PRINTER OFF
				SET PRINTER TO DEFAULT
				GO TOP IN SalesQuote
		
			CATCH TO oException
		
			   IF oException.ErrorNo = 1
			     * STRTOFILE("Error occurred at: " + TRANSFORM(DATETIME()) + CHR(13),"C:\Errors.txt",.T.)
			     MESSAGEBOX("oException.ErrorNo = 1",0,"Error Sending")
			     RecordError( 0, "CATCH TO oException", ""+PROGRAM(), LINENO(),"VFP message: oException.ErrorNo = 1"+CHR(13)+"loListener = NewObject('PdfListener',..." )
			     
			     *SendPDFEmail("earlsj3@gmail.com", "Shelton.Kirchner@SpaceAlloysUSA.com", "\\RAPTOR\HPAData\Quotes\SendPDF\D\HPA_SO.PDF", "Sales Order #131307 Confirmation from Space Alloys USA", "", 0, "HPA_Sales_Order_131307.pdf" )
			   ENDIF
		
		
			ENDTRY
			
			TRY
			
				cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName )
				*PARAMETER cEmailTo, cEmailFrom, cLocalFileName, cSubject, cMessage, pnConn, cNewPDFName, lCheckEmailStatus
				WAIT WINDOW "Finished the Send routine" TIMEOUT 2
		
				DO CASE
				CASE "Mail queued" $ cAns
					WAIT WINDOW "Mail queued." NOWAIT
					TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was Emailed to ("+cQouteEmail+") on ("+DTOC(DATE())+")"+" "+PROGRAM() )
					Save_Sales_Status( ThisFormSet.SalesNum, 'Email', 'Email Sales Order Confirmation', ThisFormSet.nConnHandle )
					*calls: GetCancelReason if "CANCEL or REMOVE"
				CASE NOT LEN(ALLTRIM(cAns))=0
					MESSAGEBOX( cANS,0,"SQL Returned Message!")
				OTHERWISE
					WAIT WINDOW "Email Complete" NOWAIT
					TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" confirmation was Emailed to ("+cQouteEmail+") on ("+DTOC(DATE())+")"+" "+PROGRAM() )
					Save_Sales_Status( ThisFormSet.SalesNum, 'Email', 'Email Sales Order Confirmation', ThisFormSet.nConnHandle )
					*calls: GetCancelReason if "CANCEL or REMOVE"
					
					ThisFormSet.Record_Sales_No_Chng("Confirmation of SO Sent to "+cEmailTo)
					
				ENDCASE
			CATCH TO oException
		
			   IF oException.ErrorNo = 1
			     * STRTOFILE("Error occurred at: " + TRANSFORM(DATETIME()) + CHR(13),"C:\Errors.txt",.T.)
			     MESSAGEBOX("oException.ErrorNo = 1",0,"Error Sending")
			     RecordError( 0, "CATCH TO oException", ""+PROGRAM(), LINENO(),"cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName )"+CHR(13)+"cAns ="+cAns )
			     
			     *SendPDFEmail("earlsj3@gmail.com", "Shelton.Kirchner@SpaceAlloysUSA.com", "\\RAPTOR\HPAData\Quotes\SendPDF\D\HPA_SO.PDF", "Sales Order #131307 Confirmation from Space Alloys USA", "", 0, "HPA_Sales_Order_131307.pdf" )
			   ENDIF
		
		
			ENDTRY
		ENDIF
		
		***********************************************
		
		
		
		SELECT SalesQuote
		
		ThisFormSet.frmEO.pf1.pgOrder.txtItem.Refresh()
		ThisFormSet.frmEO.pf1.pgQuote.txtItem.Refresh()
		
		ThisForm.cmdTop.Click()
		
		IF USED('SoldAddr')
			USE IN SoldAddr
		ENDIF
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		*IF USED('Sales_No')
		*	USE IN Sales_No
		*ENDIF
		
		WAIT Clear
		
	ENDPROC

	PROCEDURE frmEO.cmdExit.Click
		PRIVATE ncurrSalesNumRec, nTotalSalesNumCost, im, cTalkState
		
		***Check for Saved AddrCode
		PRIVATE nSoldCode, nShipCode, cMess, nMess
		nSoldCode = PrepareSQLnum(ThisFormSet.SoldAddr,'SoldAddr',10)
		nShipCode = PrepareSQLnum(ThisFormSet.ShipAddr,'ShipAddr',10)
		cMess = ''
		
		IF nSoldCode > 0
			IF USED('tmpSales_NoAddr')
				USE IN tmpSales_NoAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT pSoldAddr FROM dbo.Sales_No WITH(NOLOCK) "
			cSQL = cSQL +" WHERE SalesNum="+ALLTRIM(STR(ThisFormSet.SalesNum))+""
			
			*This is a common 'Bad SQL Connetion' initiation point
			ThisFormSet.nConnHandle = CheckSQLConnection(ThisFormSet.nConnHandle)
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_NoAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_NoAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_NoAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_NoAddr")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'tmpSales_NoAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
		
			IF USED('tmpSales_NoAddr')
				IF RECCOUNT('tmpSales_NoAddr') > 0
					IF nSoldCode != PrepareSQLnum(tmpSales_NoAddr.pSoldAddr,'pSoldAddr',10)
						nMess = MESSAGEBOX("The Bill To address has NOT been saved to this SalesOrder."+CHR(13)+CHR(13)+"You just choose to Exit the Sales Order Edit screen."+CHR(13)+CHR(13)+"Do you want to cancel this 'EXIT'"+CHR(13)+"to go back and SAVE the Address to Sales Order?"+CHR(13)+"Answer 'Y' to fix."+CHR(13)+CHR(13)+"Answer 'No' to exit.",4+32+256,"Chance to stop this Exit?")
						IF nMess = 6
							USE IN tmpSales_NoAddr
							RETURN .F.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF nShipCode > 0
			IF USED('tmpSales_NoAddr')
				USE IN tmpSales_NoAddr
			ENDIF
			
			cSQL = "SELECT pShipAddr FROM dbo.Sales_No WITH(NOLOCK) "
			cSQL = cSQL +" WHERE SalesNum="+ALLTRIM(STR(ThisFormSet.SalesNum))+""
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_NoAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_NoAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_NoAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_NoAddr")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'tmpSales_NoAddr')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
		
			IF USED('tmpSales_NoAddr')
				IF RECCOUNT('tmpSales_NoAddr') > 0
					IF nShipCode != PrepareSQLnum(tmpSales_NoAddr.pShipAddr,'pShipAddr',10)
						nMess = MESSAGEBOX("The Ship To address has NOT been saved to this SalesOrder."+CHR(13)+CHR(13)+"You just choose to Exit the Sales Order Edit screen."+CHR(13)+CHR(13)+"Do you want to cancel this 'EXIT'"+CHR(13)+"to go back and SAVE the Address to Sales Order?"+CHR(13)+CHR(13)+"Answer 'No' to exit.",4+32+256,"Chance to stop this Exit?")
						IF nMess = 6
							*Yes, Cancel the Exit
							USE IN tmpSales_NoAddr
							RETURN .F.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF USED('tmpSales_NoAddr')
				USE IN tmpSales_NoAddr
			ENDIF
		
		ENDIF
		
		
		***********************************
		IF NOT ThisFormSet.lPrintedSO
			IF USED('SalesQuote')
				PRIVATE lCancelSO
				lCancelSO = PrepareSQLlogic(SalesQuote.Cncld,'Cancel',.F.)
				
				IF NOT lCancelSO 
					IF MESSAGEBOX("This SalesOrder has not been marked as Printed."+CHR(13)+"The print routine also saves your work."+CHR(13)+"Make sure you have saved your work before you Exit."+CHR(13)+CHR(13)+"Are you sure you want to leave?"+CHR(13)+"Answer 'Yes' to exit.",4+32,"Not Printed") = 7 &&NO
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*CollectErrors()
		*MESSAGEBOX("RecordError.prg will not be run to Email this message.",0,"Skipping Email!")
		
		
		*ThisForm.Release
		ThisFormSet.Release
		
		 
	ENDPROC

	PROCEDURE frmEO.cmdNext.Click
		ThisFormset.NextSOrec()
		
	ENDPROC

	PROCEDURE frmEO.cmdPrev.Click
		ThisFormSet.PrevSOrec()
	ENDPROC

	PROCEDURE frmEO.cmdPrintAll.Click
		IF NOT USED('SalesQuote')
			TrackError( "Lost Table 'SalesQuote'","CheckData4Save",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		IF NOT ThisFormSet.CheckData4Save()
			*Save
			MESSAGEBOX("Could not save the SO as is."+CHR(13)+"Fix and try to print again.",48,"Not Printing")
			RETURN .F.
		ENDIF
		
		IF NOT ThisFormSet.CheckData4Print()
			*Print
			MESSAGEBOX("Cannot print this SO as is."+CHR(13)+"Fix and try to print again.",48,"Not Printing")
			RETURN .F.
		ENDIF
		
		*--TrueItemSale = IIF(SalesQuote.Cncld,0,SalesQuote.Q_Total)
		*--TrueItemSale = IIF(SalesQuote.Cncld,0,SalesQuote.Quoted_Total +CutsP + OtherP )
		*TrueItemSale = IIF(SalesQuote.Cncld,0,SalesQuote.ItemSale)
		*REPORT FORM reports\Worksheet-Blank NOCONSOLE TO PRINTER PROMPT *FOR Worksheet.SoItem_A = aSOitem_Len(nItem,1)
							
		PRIVATE lPrintTheSO
		lPrintTheSO = .T.
		
		PRIVATE cSQLu, cSQL, nSQLEXEC 
		************
		*Check For Extension page needs
		
		IF USED('tmpSOitem_Len')
			USE IN tmpSOitem_Len
		ENDIF
		
		cSQL = "SELECT SOitem, LEN( CAST(Comments AS CHAR(1024)) ) AS Lngth "
		cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
		cSQL = cSQL + " ORDER BY SOitem"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitem_Len')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitem_Len')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Len")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Len")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitem_Len')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		
		IF USED('tmpSOitem_Len')
			SELECT tmpSOitem_Len
			COPY TO ARRAY aSOitem_Len
			USE IN tmpSOitem_Len
		ELSE
			DECLARE aSOitem_Len(1,2)
			aSOitem_Len(1,1) = ThisFormSet.SalesNum
			aSOitem_Len(1,2) = " "
		ENDIF
		
		
		********************************
		
		
		*Rely on ThisFormSet.lChangingSO, not table!
		*!*	IF IsSales_No_Changing(ThisFormSet.SalesNum,ThisFormSet.nConnHandle)
		*!*		*SELECT Changing FROM dbo.Sales_No WHERE SalesNum
		
		*!*		*Found SO Changes!
		*!*		*Ammend and Print!	###
		*!*		
		*!*		lPrintTheSO = .T.
		*!*	ENDIF
		
		*PRIVATE nCount
		*nCount = Count_SOinSales_No(ThisFormSet.SalesNum, ThisFormSet.nConnHandle,'PrintedSO') 	
		*IF nCount > 0 OR ThisFormSet.lPrintedSO
		*Rely on Form status, not table!!!
		
		PRIVATE cReprintSOreason, lAmendVer
		cReprintSOreason = ""
		lAmendVer = .F.
		
		IF ThisFormSet.lPrintedSO
		
			ThisFormSet.cReprintSOreason = ''
			
			*Printed and not Changing, get Reason for Edit
			MESSAGEBOX("This Order has already been Printed."+CHR(13)+;
				"If you reprint this Sales Order again,"+CHR(13)+;
				"the previous paperwork must be destroyed!"+CHR(13)+;
				"so this Order does not get shipped twice!"+CHR(13)+CHR(13)+;
				"Please enter the 'Reason for reprint' next.";
				,32,"Print Again") 
			
			*"No Changes to the Sales Order where recorded."+CHR(13)+CHR(13)+;
			*"Do you wish to reprint this Sales Order?"+CHR(13)+CHR(13)+;
			
			
			
			PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
			lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.F.
			ENDIF
			lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.F.
			ENDIF
			
			DO FORM Forms\GetReason WITH "Reprint Sales Order Reason.","",.T. TO cReprintSOreason
			
			IF lEOAllWaysOnTop
				ThisFormSet.frmEO.AlwaysOnTop =.T.
			ENDIF
			IF lPOAllWaysOnTop
				ThisFormSet.frmPO.AlwaysOnTop =.T.
			ENDIF
		
			
			IF VARTYPE(cReprintSOreason) = "C"
				IF LEN(cReprintSOreason) > 1
					lAmendVer = .T.
					lPrintTheSO = .T.
					ThisFormSet.cReprintSOreason = cReprintSOreason
				
				ELSE
					lPrintTheSO = .F.
				ENDIF
			ELSE
				lPrintTheSO = .F.
			ENDIF
			
			IF NOT lPrintTheSO 
				MESSAGEBOX("Cannot reprint without a reason!"+CHR(13)+"Cancelling the RePrint",0+64,"No print")
				RETURN .F.
			ENDIF
			
			IF LEN(cReprintSOreason) > 0 AND lPrintTheSO 	
				TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+", Amendment "+ALLTRIM(STR(ThisFormSet.nAmendment))+", is to be reprinted with reason:"+PrepareSQLtxt(cReprintSOreason,'Reason',-1) )
			ENDIF	
		ELSE
			*Not found to be Printed!
			lPrintTheSO = .T.
		ENDIF
		
		
		
		*************************************
		PRIVATE lWOext, lWO_Production
		lWOext = .F.
		lWO_Production = .F.
		
		IF lPrintTheSO 
			IF ThisFormSet.SaveSO("PRINT",lAmendVer ) &&cReprintSOreason
			*lAmendVer is true if entered a Print reason
		
			************************************************************
			*Check for rtr, start rtr if needed.
			ThisFormSet.SO_rtr()
			
			************************************************************
					
		*!*			IF lAmendVer 
		*!*				*Track Usage
		*!*				TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" Reprinted! "+cReprintSOreason+" "+PROGRAM() )
		*!*				nAmendment = Amend_Sales_No_Ver( ThisFormSet.SalesNum, cReprintSOreason, ThisFormSet.nConnHandle)
		*!*				
		*!*				IF nAmendment > 0
		*!*					ThisFormSet.nAmendment = nAmendment 
		*!*				ELSE
		*!*					MESSAGEBOX("Could not get next SO Version!",0+64,"No REV recorded, so No print")
		*!*					RETURN .F.
		*!*				ENDIF
		*!*			ENDIF
		
		
			ELSE
				TrackError("SaveSO Error","SaveSO('PRINT')",PROGRAM(),LINENO(1) )	
			ENDIF
			
			****************************************************
			
			IF FILE('REPORTS\SalesOrder25.FRX')
				
				PRIVATE cTrt_Lumber_Co
		
				IF Count_SOinSales_No(ThisFormSet.SalesNum, ThisFormSet.nConnHandle, 'trt_lumber') > 0
					cTrt_Lumber_Co = ThisFormSet.Treated_Lumber_Country()
					IF NOT LEN(ALLTRIM(cTrt_Lumber_Co))=0
						glTrt_lumber = .T.
					ELSE
						glTrt_lumber = .F.
					ENDIF	
				ELSE
					glTrt_lumber = .F.
				ENDIF
				
		
				SELECT SalesQuote
				GO TOP IN SalesQuote
				
				PRIVATE cCurrSOitem
				cCurrSOitem = SalesQuote.SoItem_A
		
				**********************
				IF NOT ThisFormSet.SeekSoldCodeinSoldAddr(ThisFormSet.SoldAddr)
					MESSAGEBOX("No or bad 'Sold To Address'",0+16,"Could not get Address loaded.")
				ENDIF
				*********************	
				IF NOT ThisFormSet.SeekShipCodeinShipAddr(ThisFormSet.ShipAddr)
					MESSAGEBOX("No or bad 'Ship To Address'",0+16,"Could not get Address loaded.")
				ENDIF
				*********************	
				ThisFormSet.SeekSalesNuminSales_No()	
				*********************
				ThisFormSet.SeekStartingStockSalesNum()	
				*********************
				*ThisFormSet.SeekStartingStock(SalesQuote.ID)	
				*********************
				
				SET PRINTER OFF
				SET PRINTER TO DEFAULT
				
				SELECT SalesQuote
				WAIT WINDOW "Print SalesOrder to:" NOWAIT
				
				REPORT FORM reports\SalesOrder25 NOCONSOLE TO PRINTER PROMPT
						
				****
		
				GO TOP IN SalesQuote
				PRIVATE nItem
				
				**********************************
				*Print WorkSheet
				*
				ThisFormSet.Refresh_WorkSheet()
				
				*IF FILE('REPORTS\WS_Summary.FRX')
				*	REPORT FORM reports\WS_Summary NOCONSOLE TO PRINTER PROMPT 
				*ENDIF
				
				*******************
				GO TOP IN WorkSheet
				
				IF FILE('REPORTS\WorkSheet.FRX')
		*			IF nAnsPrint= 6
		*				SetPrinterTo("TIPTONSHOP")
		*			ENDIF
					***********************************
					
					PRIVATE nLenaSOitem
					nLenaSOitem = ALEN(aSOitem_Len,1)
					IF nLenaSOitem > 0
						*Loop thru Items
						FOR nItem = 1 TO nLenaSOitem
						
							SELECT SalesQuote
							LOCATE FOR Item = nItem 
							*IF FOUND()
							*	cCurrSOitem = SalesQuote.SoItem_A
							*ELSE
							*	cCurrSOitem = Proper_SO_item(STR(ThisFormSet.SalesNum)+"-"+STR(nItem,2,0))
							*ENDIF
							cCurrSOitem = aSOitem_Len(nItem,1)
							
							**********
							*see if WO_Production 
							lWO_Production = Is_Production_WO_SOi(SalesQuote.SoItem_A,ThisFormSet.nConnHandle)
							
							IF PrepareSQLlogic(SalesQuote.ProductionWO,'ProductionWO',.F.) AND NOT lWO_Production 
								*Need to Update
								SELECT SalesQuote
								REPLACE ProductionWO WITH lWO_Production IN SalesQuote
							ENDIF	
							
							**********
							PRIVATE lIntP 
							lIntP = Is_InternalProduction_SOi(SalesQuote.SoItem_A,ThisFormSet.nConnHandle)
							
							IF lIntP AND NOT PrepareSQLlogic(SalesQuote.IntP,'IntP',.F.)
								*Need to Update
								SELECT SalesQuote
								REPLACE IntP WITH lIntP IN SalesQuote
								ThisFormSet.frmEO.pf1.pgBillTo.chkIntP.Value = lIntP
							ENDIF	
							
							*********************
							ThisFormSet.SeekPOitems(SalesQuote.SoItem_A) &&tmpAllPOitems.AllPOtext
							*********************
							
							SELECT WorkSheet
							WAIT WINDOW "Print SO Work Sheet to:" NOWAIT
							REPORT FORM reports\Worksheet NOCONSOLE TO PRINTER PROMPT FOR Worksheet.SoItem_A = aSOitem_Len(nItem,1)
							**-- POCost varible is missing!!
							
							WAIT WINDOW "SO Work Sheet Page: "+ALLTRIM(STR(nItem)) TIMEOUT 3
							
							*Check For Extension page needs, count comeents lines to print
							lWOext = .F.
							IF USED('tmpSOitem_Len2')
								USE IN tmpSOitem_Len2
							ENDIF
							
							cSQL = "SELECT TRIM(Comments) AS [Comments] "
							cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
							cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+aSOitem_Len(nItem,1)+"')"
							cSQL = cSQL + " OR ( SalesNum = "+STR(ThisFormSet.SalesNum)
							cSQL = cSQL + " AND Item="+ALLTRIM(STR(nItem))+")"
							
							SELECT 0
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitem_Len2')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitem_Len2')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Len2")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Len2")
										
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
		
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitem_Len2')
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								ENDIF
							ENDIF
		
		
							IF USED('tmpSOitem_Len2')
								IF LinesToPrint(tmpSOitem_Len2.Comments,50) >= 5
									lWOext = .T.
								ENDIF
								USE IN tmpSOitem_Len2
							ENDIF
							
							****************************
							
							SELECT SalesQuote
							LOCATE FOR Item = nItem 
							
							**Check for Extension
							IF lWOext 
								SELECT WorkSheet
								WAIT WINDOW "Print SO Work Sheet EXTRA sheet to:" NOWAIT
								REPORT FORM reports\WorkSheet_Ext NOCONSOLE TO PRINTER PROMPT FOR WorkSheet.SoItem_A = aSOitem_Len(nItem,1)
							ENDIF
							
							****************************
							
							SELECT SalesQuote
							LOCATE FOR Item = nItem 
							
							**Check for Production WorkOrder
							
							IF lWO_Production 
							
								IF USED('tmpWO_SOi')
									USE IN tmpWO_SOi
								ENDIF
								
								cSQL = "SELECT WO.*,WOD.*"
								cSQL = cSQL + " ,ISNULL(sPO.Company,'') AS sPOCompany "
								cSQL = cSQL + " ,ISNULL(fPO.Company,'') AS fPOCompany "
								cSQL = cSQL + " FROM dbo.WorkOrder WO WITH(NOLOCK) "
								cSQL = cSQL + " INNER JOIN dbo.WorkOrder_Detail WOD WITH(NOLOCK) ON WOD.WO = WO.WO "
								cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder sPO ON WO.POitem = sPO.POitem "
								cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder fPO ON WOD.fPOitem = fPO.POitem "
								cSQL = cSQL + " WHERE WO.SOitem = dbo.f_ProperSOitem('"+aSOitem_Len(nItem,1)+"')"
		
								SELECT 0
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOi')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOi')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
											
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_SOi')
										RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
									ENDIF
								ENDIF
					
		
								WAIT WINDOW "Print WorkOrder Prod Detail sheet to:" NOWAIT
								REPORT FORM reports\WorkOrder_Prod_Detail NOCONSOLE TO PRINTER PROMPT 
								
								IF USED('tmpStock_Process')
									WAIT WINDOW "Print WorkOrder Production sheet to:" NOWAIT
									REPORT FORM reports\WorkOrder_Production NOCONSOLE TO PRINTER PROMPT 
								ELSE	&&Why did report with error Alias 'TMPSTOCK_PROCESS' is not found
									REPORT FORM reports\WorkOrder_Production NOCONSOLE TO PRINTER PROMPT 
								ENDIF			
							ENDIF
							
							****************************
							*set_rtr_Detail_Oper(pcOrder, pnOrder, pnDetail, pnOper_ID, pcOper_Note, plStart, pConnHandle
							set_rtr_Detail_Oper('SOi',SalesQuote.SoItem_A,90,540,'Print Order',.F.,ThisFormSet.nConnHandle)
		
							****************************
							SELECT SalesQuote
							
						NEXT nItem
					ENDIF
				ENDIF
				*****
				
				*Send an Email if no CustID was found on SO
				Check_SO_Terms(ThisFormSet.SalesNum,ThisFormSet.nConnHandle)
				
				ThisFormSet.lPrintedSO = .T.
				ThisFormSet.frmEO.pf1.pgBillTo.chkPrintedSO.Value = .T.
				REPLACE PrintedSO WITH .T. IN Sales_No
				
				WAIT WINDOW 'PRINTED' NOWAIT
			ELSE
				WAIT WINDOW "Report form 'REPORTS\SalesOrder25.FRX' not found." NOWAIT
			ENDIF
		
			IF glTrt_lumber
				IF NOT LEN(ALLTRIM(cTrt_Lumber_Co))=0
		*			IF nAnsPrint= 6
		*				SetPrinterTo("TIPTONSHOP")
		*			ENDIF
					
					IF NOT USED('HardWood')
						ThisFormSet.LoadHardwood()
					ENDIF
					SELECT HardWood
					
					WAIT WINDOW "Print Hard Wood statement to:" NOWAIT
					REPORT FORM reports\HardWood FOR Country = cTrt_Lumber_Co NOCONSOLE TO PRINTER PROMPT
					WAIT WINDOW "Hard Wood Packaging Statement printed." NOWAIT
					
				ELSE
					MESSAGEBOX("Hard Wood Packaging Statement did not print for this Counrty",0,"Print Error")
				ENDIF
			ENDIF
			
			****************************************************
			*Track Usage
			
			TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" was printed in complete form on ("+DTOC(DATE())+")" +" "+PROGRAM()+" Amendment:"+ALLTRIM(STR(ThisFormSet.nAmendment)) )
			Save_Sales_Status( ThisFormSet.SalesNum, 'Print', 'Print Sales Order', ThisFormSet.nConnHandle )
			*calls: GetCancelReason if "CANCEL or REMOVE"
			
			ThisFormSet.Record_Sales_No_Chng("User Track: Printed complete SO")
			
			SELECT SalesQuote
			GO TOP IN SalesQuote
		
			ThisFormSet.frmEO.pf1.pgOrder.txtItem.Refresh()
			ThisFormSet.frmEO.pf1.pgQuote.txtItem.Refresh()
			
			ThisForm.cmdTop.Click()
		ENDIF &&lPrintTheSO
		
		****************************************************************************
		***Revision page Report
		IF lPrintTheSO 
			*IF Have_Sales_No_Rev( ThisFormSet.Salesnum, ThisFormSet.nConnHandle )
			IF Have_Sales_No_Rev_Comment( ThisFormSet.Salesnum, ThisFormSet.nConnHandle ) &&Only counts when a comment exists
				IF MESSAGEBOX("There are Revision Comments to this Sales Order"+CHR(13)+"Do you want to Preview/Print the current Revision Report now?",4+32,"Print Revision Comment Report now?") = 6
					IF NOT USED('tmpSales_No_Rev')
						ThisFormSet.Refresh_pgQA()
					ENDIF
					
					IF USED('tmpSales_No_Rev')
						SELECT tmpSales_No_Rev
						IF FILE('REPORTS\Sales_No_Rev.FRX')
							REPORT FORM Reports\Sales_No_Rev NOCONSOLE PREVIEW
						ELSE
							MESSAGEBOX("Could not find Report Form",0+16,"File error")
						ENDIF
					ELSE
						MESSAGEBOX("Could open table tmpSales_No_Rev.",0+16,"File error")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		****************************************************************************
		
		IF USED('WorkSheet')
			USE IN WorkSheet
		ENDIF
		
		*IF USED( 'Sales_No' )
		*	USE IN Sales_No
		*ENDIF
				
		IF USED( 'SoldAddr' )
			USE IN SoldAddr
		ENDIF
		
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		
		IF USED( 'StartingStock' )
			USE IN StartingStock
		ENDIF
		
		IF USED('HardWood')
			USE IN HardWood
		ENDIF
		
		IF USED('tmpWO_SOi')
			USE IN tmpWO_SOi
		ENDIF
		
		
		IF lPrintTheSO 
			****************************************************
			* UPDATED here
		
			cSQL = "UPDATE dbo.Sales_No SET "
			cSQL = cSQL + " EverPrint = 1"
			cSQL = cSQL + ",PrintedSO = 1"
			*cSQL = cSQL + " ,Changing = 0"  && A print does not mean change.  Could be needed years after completed
			cSQL = cSQL + " ,ShopRecv = 0"
			cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(ThisFormSet.SalesNum))
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					TrackError("Update Sales_No PrintedSO Error",cSQL+CHR(13)+" Could not Set Sales_No to PrintedSO to True.",PROGRAM(),LINENO(1) )
					
					*RETURN
					lPrintTheSO = .F.
					
				ENDIF
			ELSE
				*Good Save
				Track_Sales_No_Chng( "Edit_SalesOrder.PrintAll() ",ThisFormSet.SalesNum,.F.,ThisFormSet.nAmendment )
				
				ThisformSet.Load_Sales_No()
				
				SELECT Sales_No	&&Sales_No does not have items detail
				REPLACE PrintedSO WITH .T. IN Sales_No
				REPLACE Changing WITH .F. IN Sales_No
				REPLACE ShopRecv WITH .F. IN Sales_No
				
				ThisFormSet.lPrintedSO = .T.
				ThisFormSet.frmEO.pf1.pgBillTo.chkPrintedSO.Value	= ThisFormSet.lPrintedSO
				ThisFormSet.frmEO.pf1.pgQA.chkPrintedSO.Value		= ThisFormSet.lPrintedSO
				
				ThisFormSet.lChangingSO	= .F.
				ThisFormSet.frmEO.pf1.pgBillTo.chkSOchanging.Value	= ThisFormSet.lChangingSO
				ThisFormSet.frmEO.pf1.pgQA.chkChanging.Value		= ThisFormSet.lChangingSO
				
				ThisFormSet.lShopRecvSO = .F.
				ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
				ThisFormSet.frmEO.pf1.pgQA.chkShopRecv.Value		= ThisFormSet.lShopRecvSO
				
			ENDIF	
		ENDIF
		
		IF lPrintTheSO 
			************************************************************
			*Check for unprinted Purchase Orders to Print
		
			PRIVATE nMess,cMess,nHPApo,nLastPO,lClosePO
			nMess = 0
			cMess = ''
			nHPApo = 0
			nLastPO = 0
			lClosePO = .T.
		
			IF ThisFormSet.SalesNum > 0
				IF USED('tmpPOS')
					USE IN tmpPOS
				ENDIF
				
				cSQL = "SELECT P.HPAPO,P.Company,P.Alloy "
				cSQL = cSQL + ",P.Services,P.ConvServ,P.Equipment,P.Stock "
				cSQL = cSQL + ",ISNULL(PO_No.Printed,0) AS [Printed] "
				cSQL = cSQL + " FROM dbo.PurchaseOrder P WITH(NOLOCK) "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.PO_No WITH(NOLOCK) ON P.HPAPO = PO_No.HPAPO "
				cSQL = cSQL + " WHERE P.SalesNum = "+STR(ThisFormSet.SalesNum)
				*cSQL = cSQL + " AND ISNULL(PO_No.Printed,0) = 0"
				cSQL = cSQL + " ORDER BY P.HPAPO "
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOS')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOS')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOS")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOS")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOS')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
				IF USED('tmpPOS')
					IF RECCOUNT('tmpPOS') > 0
						SCAN
							nHPApo = PrepareSQLnum(tmpPOS.HPAPO,'HPAPO',-3)
							IF nLastPO = nHPApo
								LOOP
							ELSE
								nLastPO = nHPApo
							ENDIF
							
							cMess = "Found a related PO"+CHR(13)
							IF PrepareSQLlogic(tmpPOS.Printed,'Printed',.F.)
								cMess = cMess + "that has already been Printed."+CHR(13)
							ELSE
								cMess = cMess + "that has NOT been Printed."+CHR(13)
							ENDIF
							cMess = cMess + "ERP PO: "+ALLTRIM(STR( nHPApo ))+" first record is:"+CHR(13)
							cMess = cMess + "Company: "+ShowSQLtxt(tmpPOS.Company,'Company',30,.F.,.T.)+CHR(13)
							IF PrepareSQLchk(tmpPOS.Services,'Services')
								cMess = cMess + " Services "+CHR(13)
							ENDIF
							IF PrepareSQLchk(tmpPOS.ConvServ,'ConvServ')
								cMess = cMess + " ConvServ "+CHR(13)
							ENDIF
							IF PrepareSQLchk(tmpPOS.Equipment,'Equipment')
								cMess = cMess + " Equipment "+CHR(13)
							ENDIF
							cMess = cMess + "Stock: "+ShowSQLtxt(tmpPOS.Stock,'Stock',13)+CHR(13)+CHR(13)
							cMess = cMess + "Do you wish to Print this PO now?"+CHR(13)+CHR(13)
							cMess = cMess + "~The Shop loves it when you include this~"
							nMess = MESSAGEBOX(cMess,4+32,"Print ERP PO?")
							
							IF nMess = 6
								*Call POPrint!
								ThisFormSet.FrmPO.PrintPO(nHPApo,lClosePO)
								
							ENDIF
						ENDSCAN
					ENDIF
					USE IN tmpPOS
				ENDIF
			ENDIF
		ENDIF
		
		*IF lPrintTheSO 
			
		*ENDIF
		
		***************************************
		
		ThisFormSet.pgRefresh()
	ENDPROC

	PROCEDURE frmEO.cmdPrintSO.Click
		IF FILE('REPORTS\SalesOrder25.FRX')
			SELECT SalesQuote
			GO TOP IN SalesQuote
			
			**********************
			IF NOT ThisFormSet.SeekSoldCodeinSoldAddr(ThisFormSet.SoldAddr)
				MESSAGEBOX("No or bad 'Sold Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			IF NOT ThisFormSet.SeekShipCodeinShipAddr(ThisFormSet.ShipAddr)
				MESSAGEBOX("No or bad 'Ship Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			ThisFormSet.SeekSalesNuminSales_No()	
			**********************
			
			
		*	RELEASE gShippingCopy
		*	PUBLIC gShippingCopy
		*	gShippingCopy= .F.
			
			SELECT SalesQuote
			ThisForm.AlwaysOnBottom = .T.
			ThisForm.AlwaysOnTop = .F.
			SET PRINTER TO DEFAULT
			WAIT WINDOW "Print SalesOrder to:" NOWAIT
			REPORT FORM reports\SalesOrder25 NOCONSOLE TO PRINTER PROMPT
			SET PRINTER TO DEFAULT
			ThisForm.AlwaysOnBottom = .F.
			ThisForm.AlwaysOnTop = .T.
		
			WAIT WINDOW 'PRINTED' NOWAIT
			
		*	RELEASE gShippingCopy
			
			*Track Usage
			TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" was printed as just a SO page on ("+DTOC(DATE())+")"+" "+PROGRAM() )
		
			ThisFormSet.Record_Sales_No_Chng("User Track: Printed SO page")
			
		ELSE
			WAIT WINDOW "Report form 'REPORTS\SalesOrder25.FRX' not found." NOWAIT
		ENDIF
		
		ThisFormSet.frmEO.pf1.pgOrder.txtItem.Refresh()
		ThisFormSet.frmEO.pf1.pgQuote.txtItem.Refresh()
		
		WAIT CLEAR
		
		ThisForm.cmdTop.Click()
		
		
		IF USED( 'SoldAddr' )
			USE IN SoldAddr
		ENDIF
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		*IF USED( 'Sales_No' )
		*	USE IN Sales_No
		*ENDIF
	ENDPROC

	PROCEDURE frmEO.cmdPrintWS.Click
		PRIVATE cSoItem
		cSoItem = PrepareSQLtxt(SalesQuote.SoItem_A,'SOitem',10)
		*Also used in Shop_StockLst_Edit
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE lWOext
		lWOext = .F.
		
		*******************************
		*Check For Extension page needs
		
		IF USED('tmpSOitem_Len')
			USE IN tmpSOitem_Len
		ENDIF
		
		cSQL = "SELECT Comments "
		cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		cSQL = cSQL + " OR ( SalesNum = "+STR(ThisFormSet.SalesNum)
		cSQL = cSQL + " AND Item="+ALLTRIM(STR(SalesQuote.Item_A))+")"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitem_Len')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitem_Len')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitem_Len")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmtmpSOitem_LenpPOS")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitem_Len')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpSOitem_Len')
			IF LinesToPrint(tmpSOitem_Len.Comments,50) > 5
				lWOext = .T.
			ENDIF
			USE IN tmpSOitem_Len
		ENDIF
		
		IF FILE('REPORTS\WorkSheet.FRX')
		
			IF NOT USED('HardWood')
				*USE HPA!HardWood SHARED IN 0
				ThisFormSet.LoadHardwood()
			
			ENDIF
		
			IF USED('cntSales_No')
				USE IN cntSales_No
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.Sales_No WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
			cSQL = cSQL + " AND trt_lumber = 0"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntSales_No')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSales_No')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSales_No")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSales_No")
						
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntSales_No')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			PRIVATE cTrt_Lumber_Co
			IF cntSales_No.cnt > 0
				cTrt_Lumber_Co = ThisFormSet.Treated_Lumber_Country()
				IF NOT LEN(ALLTRIM(cTrt_Lumber_Co))=0
					glTrt_lumber = .T.
				ELSE
					glTrt_lumber = .F.
				ENDIF
			ELSE
				glTrt_lumber = .F.
			ENDIF
			IF USED('cntSales_No')
				USE IN cntSales_No
			ENDIF
			
			*********************	
			ThisFormSet.SeekSalesNuminSales_No()	
			*********************
			ThisFormSet.SeekStartingStock(SalesQuote.ID)	
			*********************
			ThisFormSet.SeekPOitems(SalesQuote.SoItem_A) &&tmpAllPOitems.AllPOtext
			*********************
			
			PRIVATE lWO_Production
			lWO_Production = Is_Production_WO_SOi(cSoItem,ThisFormSet.nConnHandle)
			IF PrepareSQLlogic(SalesQuote.ProductionWO,'ProductionWO',.F.) AND NOT lWO_Production 
				*Need to Update
				SELECT SalesQuote
				REPLACE ProductionWO WITH lWO_Production
			ENDIF	
			
			**********
			*PRIVATE lIntP
			*lIntP = Is_InternalProduction_SOi(SalesQuote.SoItem_A,ThisFormSet.nConnHandle)
			*
			*IF PrepareSQLlogic(SalesQuote.IntP,'IntP',.F.) AND NOT lIntP
			*	*Need to Update  -depricated
			*	SELECT SalesQuote
			*	REPLACE IntP WITH lIntP
			*ENDIF	
			**********
			
			ThisForm.AlwaysOnBottom = .T.
			
			*SELECT SalesQuote  &&WorkSheet Report uses Table WorkSheet
			
			ThisFormSet.Refresh_WorkSheet(.F.)
			
			SET PRINTER TO DEFAULT
			WAIT WINDOW "Print Work Sheet to:" NOWAIT
			REPORT FORM reports\WorkSheet NOCONSOLE TO PRINTER PROMPT FOR WorkSheet.SoItem_A = cSoItem 
			WAIT WINDOW 'Printed Work Sheet' NOWAIT
			ThisForm.AlwaysOnBottom = .F.
			ThisForm.AlwaysOnTop = .T.
			glTrt_lumber = .F.	
			
			*Track Usage
			TrackMess("SO item "+ALLTRIM(cSoItem)+" was printed as just a WS on ("+DTOC(DATE())+")"+" "+PROGRAM() )
		
			
			IF glTrt_lumber
			  IF MESSAGEBOX("Do you wish to Print a 'Hard Wood Packaging Statement'?",4,"Print Statement?")=6
				IF NOT LEN(ALLTRIM(cTrt_Lumber_Co))=0
					WAIT WINDOW "Print Hard Wood statement to:" NOWAIT
					REPORT FORM reports\HardWood FOR Country = cTrt_Lumber_Co NOCONSOLE TO PRINTER PROMPT
					WAIT WINDOW "Hard Wood Packaging Statement printed." NOWAIT
				ELSE
					MESSAGEBOX("Hard Wood Packaging Statement did not print for this Counrty",0,"Print Error")
				ENDIF
			  ENDIF
			ENDIF
			
			IF lWOext 
				WAIT WINDOW "Print WorkSheet EXTRA sheet to:" NOWAIT
				REPORT FORM reports\WorkSheet_Ext NOCONSOLE TO PRINTER PROMPT FOR WorkSheet.SoItem_A = cSoItem 
				WAIT WINDOW 'Printed Work Sheet Extension page' NOWAIT
			ENDIF
			
			****************************
			
			IF USED('WorkSheet')
				USE IN WorkSheet
			ENDIF
			
			IF USED('StartingStock')
				USE IN StartingStock
			ENDIF
		
			SELECT SalesQuote
			**Check for Production WorkOrder
			
			
			IF lWO_Production 
			
				IF USED('tmpWO_SOi')
					USE IN tmpWO_SOi
				ENDIF
				
				cSQL = "SELECT WO.*, WOD.* "
				cSQL = cSQL + " ,ISNULL(sPO.Company,'') AS sPOCompany "
				cSQL = cSQL + " ,ISNULL(fPO.Company,'') AS fPOCompany "
		 		cSQL = cSQL + " FROM dbo.WorkOrder WO WITH(NOLOCK) "
		 		cSQL = cSQL + " LEFT OUTER JOIN dbo.WorkOrder_Detail WOD WITH(NOLOCK) ON WOD.WO = WO.WO "
		 		cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder sPO WITH(NOLOCK) ON WO.POitem = sPO.POitem "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder fPO WITH(NOLOCK) ON WOD.fPOitem = fPO.POitem "
				cSQL = cSQL + " WHERE WO.SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOi')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOi')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_SOi')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
		
				WAIT WINDOW "Print WorkOrder Production sheet to:" NOWAIT
				REPORT FORM reports\WorkOrder_Production NOCONSOLE TO PRINTER PROMPT 
				
				REPORT FORM reports\WorkOrder_Prod_Detail NOCONSOLE TO PRINTER PROMPT 
				
			ENDIF
			
			****************************
		
		ELSE
			MESSAGEBOX("Cannot print",0,"Report form not found")
			WAIT WINDOW 'Report form not found' NOWAIT
		ENDIF
		
		SELECT SalesQuote
		GO TOP IN SalesQuote
		ThisFormSet.frmEO.pf1.pgOrder.txtItem.Refresh()
		ThisFormSet.frmEO.pf1.pgQuote.txtItem.Refresh()
		
		ThisForm.cmdTop.Click()
	ENDPROC

	PROCEDURE frmEO.cmdPrintWSExt.Click
		PRIVATE cSoItem 
		cSoItem = PrepareSQLtxt(SalesQuote.SoItem_A,'SOitem',10)
		
		*********************	
		ThisFormSet.SeekSalesNuminSales_No()	
		*********************
		ThisFormSet.SeekStartingStock(SalesQuote.ID)	
		*********************
		
		ThisForm.AlwaysOnBottom = .T.
		
		*SELECT SalesQuote
		ThisFormSet.Refresh_WorkSheet(.F.)
		
		SET PRINTER TO DEFAULT
		*	REPORT FORM reports\WorkOrder06 NOCONSOLE TO PRINTER PROMPT FOR SalesQuote.SoItem_A = cSoItem 
		WAIT WINDOW "Print WorkSheet EXTRA sheet to:" NOWAIT
		REPORT FORM reports\WorkSheet_Ext NOCONSOLE TO PRINTER PROMPT FOR WorkSheet.SoItem_A = cSoItem 
		
		WAIT WINDOW 'Printed WS Extension page' NOWAIT
		ThisForm.AlwaysOnBottom = .F.
		ThisForm.AlwaysOnTop = .T.
		glTrt_lumber = .F.	
		
		*Track Usage
		TrackMess("SO item "+ALLTRIM(cSoItem)+" was printed as just a WS EXTENSION on ("+DTOC(DATE())+")"+" "+PROGRAM() )
		
		IF USED('WorkSheet')
			USE IN WorkSheet
		ENDIF
		
		IF USED('StartingStock')
			USE IN StartingStock
		ENDIF
		
		SELECT SalesQuote
		GO TOP IN SalesQuote
		ThisFormSet.frmEO.pf1.pgOrder.txtItem.Refresh()
		ThisFormSet.frmEO.pf1.pgQuote.txtItem.Refresh()
		
		ThisForm.cmdTop.Click()
	ENDPROC

	PROCEDURE frmEO.cmdProforma.Click
		
		WAIT WINDOW 'Saving SO' NOWAIT
		ThisForm.cmdSO_Save.Click
		
		
		CLEAR TYPEAHEAD
		
		PRIVATE lHold, lOK
		lHold = Is_SO_Hold(ThisFormSet.SalesNum,ThisFormSet.nConnHandle,'ONE')
		lOK = .T.
		
		IF NOT lHold
			*Place SO on AR Hold till proforma is paid.
			PRIVATE nRecNo 
			nRecNo = RECNO('SalesQuote')
			
			lOK = Save_SO_Hold_Status( ThisFormSet.SalesNum, "AR", .T., "Proforma", "Order waiting Payment", ThisFormSet.nConnHandle)
			
			IF lOK
				SELECT SalesQuote
				REPLACE HOLD WITH .T. IN SalesQuote 
				ThisForm.pf1.pgOrder.chkHold.Refresh
				
			ENDIF
			
			IF nRecNo <= RECCOUNT('SalesQuote')
				GOTO nRecNo IN SalesQuote
			ELSE
				GO BOTTOM
			ENDIF
			
			
		ENDIF
			
		
			
		*WAIT WINDOW "Do you want to Preview / Print?(Y)" TO BLANK
		*IF UPPER(BLANK) = "Y"
		IF MESSAGEBOX("Do you want to Preview or Print?"+CHR(13)+"before chance to Email PDF",4+32,"Proforma") = 6
		
			SELECT SalesQuote
			GO TOP IN SalesQuote
		
			**********************
			IF NOT ThisFormSet.SeekSoldCodeinSoldAddr(ThisFormSet.SoldAddr)
				MESSAGEBOX("No or bad 'Sold Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			IF NOT ThisFormSet.SeekShipCodeinShipAddr(ThisFormSet.ShipAddr)
				MESSAGEBOX("No or bad 'Ship Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			ThisFormSet.SeekSalesNuminSales_No()	
			**********************
		
			*ThisForm.AlwaysOnTop = .F.
			*ThisForm.AlwaysOnBottom = .T.
			ThisForm.Visible = .F.
			PRIVATE lfrmPOVisible
			lfrmPOVisible = ThisFormSet.frmPO.Visible
			ThisFormSet.frmPO.Visible = .F.
			ThisFormSet.frmEoP.Visible = .F.
			
			SELECT SalesQuote
			GO TOP
		
			IF FILE('Reports\Proforma.FRX')
				REPORT FORM reports\Proforma TO PRINTER PREVIEW IN SCREEN
				*REPORT FORM reports\Proforma TO PRINTER PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview
			ELSE
				IF FILE('\Reports\Proforma.FRX')
					REPORT FORM \reports\Proforma TO PRINTER PREVIEW IN SCREEN
					*REPORT FORM \reports\Proforma TO PRINTER PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview
				ELSE
					WAIT WINDOW "Report form 'reports\Proforma' not found" TIMEOUT 4
				ENDIF
			ENDIF
		
			SELECT SalesQuote
			PRIVATE nMess 
			nMess = Messagebox("Do you want to Second Print?"+CHR(13)+"To a different Printer?",4+32,"Second Print?")
			IF nMess = 6
		
				IF FILE('Reports\Proforma.FRX')
					REPORT FORM reports\Proforma TO PRINTER PROMPT
					*REPORT FORM reports\Proforma TO PRINTER PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview
				ELSE
					IF FILE('\Reports\Proforma.FRX')
						REPORT FORM \reports\Proforma TO PRINTER PROMPT
						*REPORT FORM \reports\Proforma TO PRINTER PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview
					ELSE
						WAIT WINDOW "Report form 'reports\Proforma' not found" TIMEOUT 4
					ENDIF
				ENDIF
			ENDIF	
			
			ThisForm.Visible = .T.
			ThisFormSet.frmPO.Visible = lfrmPOVisible 
			ThisFormSet.frmEoP.Visible = lfrmPOVisible 
			*ThisForm.AlwaysOnBottom = .F.
			*ThisForm.AlwaysOnTop = .T.
			
			GO TOP IN SalesQuote
			
			TrackMess("Proforma "+ALLTRIM(STR(ThisFormSet.SalesNum))+" was printed on ("+DTOC(DATE())+")"+" "+PROGRAM())
			Save_Sales_Status( ThisFormSet.SalesNum, 'PrintPro', 'Print Proforma', ThisFormSet.nConnHandle )
			*calls: GetCancelReason if "CANCEL or REMOVE"
		ENDIF
		
		**********************
		
		CLEAR TYPEAHEAD
		PRIVATE cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, cNewPDFName
		PRIVATE cEmail, cHomeSalesp 
		cHomeSalesp = ""
		
		IF MESSAGEBOX("Do you want to Email PDF?"+CHR(13)+"ar@SpaceAlloysUSA.com will also get this Proforma",4+32,"PDF Proforma") = 6
		
			
			cEmail = ALLTRIM(ThisFormSet.frmEO.pf1.pgBillTo.txtEmail.Value)
			IF LEN(ALLTRIM(cEmail))=0
				cEmail = ALLTRIM(SalesQuote.Email)
			ENDIF
			IF LEN(ALLTRIM(cEmail))=0
				cEmail = ALLTRIM(ThisFormSet.frmEO.pf1.pgShipto.txtEmail.Value)
			ENDIF
			IF LEN(ALLTRIM(cEmail))=0
				MESSAGEBOX("Enter the Email in the Bill to Tab",0,"No Email Address")
				RETURN .F.
			ENDIF
			
			cFileName = EmailFileName("HPA_Proforma.PDF") &&in Proc_ERP - Adds Current DB folder to use.
			cEmailTo	= cEmail+";ar@SpaceAlloysUSA.com"
			cEmailFrom	= ALLTRIM(SalesPEmail( SalesQuote.SalesP, SalesQuote.cover ))
			cNewPDFName	= "HPA_Proforma_"+ALLTRIM(STR( ThisFormSet.SalesNum ))+".pdf"
			cSubject	= "Proforma #"+ALLTRIM(STR( ThisFormSet.SalesNum ))+" from Space Alloys USA"
			cMessage	= ""
		
			**********************
			IF NOT ThisFormSet.SeekSoldCodeinSoldAddr(ThisFormSet.SoldAddr)
				MESSAGEBOX("No or bad 'Sold Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			IF NOT ThisFormSet.SeekShipCodeinShipAddr(ThisFormSet.ShipAddr)
				MESSAGEBOX("No or bad 'Ship Address'",0+16,"Could not get Address loaded.")
			ENDIF
			*********************	
			ThisFormSet.SeekSalesNuminSales_No()	
			**********************
		
		
			DO WHILE FILE(cFileName)
				nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
				IF nMess = 7 &&No
					DELETE FILE (cFileName)
				ENDIF
			ENDDO
			
		*	PRIVATE loListener
		*	loListener = NEWOBJECT("Listener", "Libs\Listener.VCX")	
		*			
		*	IF TYPE('loListener') = 'O'
		*		*-- Turn off UI feedback and user prompts at end of run
		*		loListener.QUIETMODE = .T.
		*		PRIVATE lcOutPutFileName, lcOutPutFilePath 
		*		lcOutPutFileName = JUSTSTEM(cFileName)
		*		lcOutPutFilePath = JUSTPATH(cFileName)
		*
		*		IF NOT "FRX2ANY" $ SET("CLASSLIB")
		*			*SET CLASSLIB TO 'LIBS\FRX2Any' ADDITIVE 
		*			SET CLASSLIB TO 'FRX2Any' IN 'LIBS\FRX2Any.APP' ALIAS FRX2Any	ADDITIVE 
		*		ENDIF
		*		IF NOT "GridDefinition" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*			SET PROCEDURE TO Progs\GridDefinition ADDITIVE
		*		ENDIF 
		*
		*		loListener.oFRX2Any = CREATEOBJECT('FRX2Any.PDFFile')
		*		
		*		IF TYPE('loListener.oFRX2Any') = 'O'
		*			loListener.oFRX2Any.UNLOCK('140601-150910-000255-INGGKG-FONEHK-PFJXPJ-MSJVGJ-AFKLQH')
		*			loListener.oFRX2Any.cExportFileName = lcOutPutFileName
		*			loListener.oFRX2Any.cSaveFolder     = lcOutPutFilePath
		*			loListener.oFRX2Any.nOutPutType     = 4 &&cnOUTPUT_FILE
		*							
		*			WAIT WINDOW "Making PDF" NOWAIT
		*			
		
			*****************************
			Local loListener As "PdfListener" Of "Pdfx.vcx"
		
			loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
			loListener.cCodePage="CP1252" &&CodePage
			loListener.cTargetFileName = cFileName
			loListener.QuietMode=.F.
			loListener.lCanPrint=.T.
			loListener.lCanEdit=.F.
			loListener.lCanCopy=.T.
			loListener.lCanAddNotes=.F.
			loListener.lEncryptDocument=.F.
			loListener.cMasterPassword=''
			loListener.cUserPassword=''
			loListener.lOpenViewer=.F.
		
			*ThisForm.AlwaysOnBottom = .T.
			ThisForm.Visible = .F.
			PRIVATE lfrmPOVisible
			lfrmPOVisible = ThisFormSet.frmPO.Visible
			ThisFormSet.frmPO.Visible = .F.
			ThisFormSet.frmEoP.Visible = .F.
		
			SELECT SalesQuote
			GO TOP
			
			IF FILE('Reports\Proforma.FRX')
				REPORT FORM Reports\Proforma Object loListener
			ELSE
				IF FILE('\Reports\Proforma.FRX')
					REPORT FORM \Reports\Proforma Object loListener
				ELSE
					WAIT WINDOW "Report form 'Reports\Proforma' not found" TIMEOUT 4
				ENDIF
			ENDIF
			
			ThisForm.Visible = .T.
			ThisFormSet.frmPO.Visible = lfrmPOVisible 
			ThisFormSet.frmEoP.Visible = lfrmPOVisible 
			*ThisForm.AlwaysOnBottom = .F.
			*ThisForm.AlwaysOnTop = .T.
			
			WAIT WINDOW "Making PDF" TIMEOUT 1	
			PRIVATE nCount
			nCount = 0
			DO WHILE NOT FILE(cFileName) AND nCount < 5
				WAIT WINDOW "Waiting for file:"+cFileName+" to be made." TIMEOUT 1
				nCount = nCount + 1
			ENDDO
		
		
			GO TOP IN SalesQuote
			
			cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName)
		
			DO CASE
			CASE "Mail queued" $ cAns
				WAIT WINDOW "Mail queued." NOWAIT
				TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" Proforma was Emailed to ("+cEmail+") on ("+DTOC(DATE())+")"+" "+PROGRAM() )
				Save_Sales_Status( ThisFormSet.SalesNum, 'EmailPro', 'Email Proforma', ThisFormSet.nConnHandle )
				*calls: GetCancelReason if "CANCEL or REMOVE"
			CASE NOT LEN(ALLTRIM(cAns))=0
				MESSAGEBOX( cANS,0,"SQL Returned Message!")
			OTHERWISE
				WAIT WINDOW "PDF Email Complete" NOWAIT
				TrackMess("Proforma "+ALLTRIM(STR(ThisFormSet.SalesNum))+" PDF was Emailed on ("+DTOC(DATE())+")"+" "+PROGRAM())
				Save_Sales_Status( ThisFormSet.SalesNum, 'PrintPro', 'Email PDF Proforma', ThisFormSet.nConnHandle )
			ENDCASE
		
			RELEASE loListener
			
		ENDIF
		
		GO TOP IN SalesQuote
		
		ThisFormSet.frmEO.pf1.pgOrder.txtItem.Refresh()
		ThisFormSet.frmEO.pf1.pgQuote.txtItem.Refresh()
		
		ThisForm.cmdTop.Click()
		
		IF USED('SoldAddr')
			USE IN SoldAddr
		ENDIF
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		*IF USED('Sales_No')
		*	USE IN Sales_No
		*ENDIF
	ENDPROC

	PROCEDURE frmEO.cmdSO_Save.Valid
		*this cmdSO_Save.Valid() Calls ThisFormSet.SaveSO()
		
		ThisFormSet.nConnHandle = CheckSQLConnection(ThisFormSet.nConnHandle)
		
		**Check Conversion PO
		IF NOT ThisFormSet.frmPO.CheckVendCode()
			*Error while Checking Vendor Code
			RETURN .F.
		ENDIF
		
		PRIVATE lAlreadySaved,  lSaveThis, lPrintedSO
		lAlreadySaved = .F.
		lSaveThis = .T.
		lPrintedSO = ThisFormSet.lPrintedSO 
		
		*Check for Cancel
		*A Cancelled Order Save does not need an Amendment! --Changed course 2017-- It should be an Admendment!
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpSOCancel')
			USE IN tmpSOCancel
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Sales_NO WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)+""
		cSQL = cSQL + " AND ISNULL([cncld],0) = 1"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOCancel')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOCancel' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOCancel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOCancel")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOCancel')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
				
		IF USED('tmpSOCancel') 
			IF RECCOUNT('tmpSOCancel') > 0
				IF tmpSOCancel.CNTD > 0
					*counted cancelled SO.
					*Cancelled - Do not bother with Check!
					*IF ThisFormSet.CheckData4Save()
						IF ThisFormSet.SaveSO("SAVE",.F.)
							*lSaveThis = .T.
							lAlreadySaved = .T.
						ENDIF
					*ENDIF
				ELSE
					*Not Cancelled
					*ThisFormSet.CheckData4Save() &&Done later in code
				ENDIF
			ENDIF
			USE IN tmpSOCancel
		ENDIF
					
		*ThisFormSet.nAmendment
		
		IF NOT lAlreadySaved AND lPrintedSO
			IF NOT IsSales_No_Changing(ThisFormSet.SalesNum,ThisFormSet.nConnHandle)
				IF MESSAGEBOX("This SO has already been printed."+CHR(13)+"If you save again the AMENDMENT"+CHR(13)+"number ("+ALLTRIM(STR(ThisFormSet.nAmendment))+") will increment by one ("+ALLTRIM(STR(ThisFormSet.nAmendment+1))+")."+CHR(13)+CHR(13)+"Do you wish to save now?",4+32,"Save as amended?")= 6 &&Yes
					
					*IF NOT ThisFormSet.Set_Sales_No_Chng()
					*	MESSAGEBOX("Could not set the 'Changing' field!"+CHR(13)+"Your SO will not increment to next version."+CHR(13)+"Try to save again!",0+48,"SQL Error- Not Saved.")
					*	lSaveThis = .F.	
					*ELSE
						lSaveThis = .T.
		
						*Check code at print time
					*	Save_Sales_Status( ThisFormSet.SalesNum, "Revision", "Save Amended to Version "+ALLTRIM(STR(ThisFormSet.nAmendment+1))+", Printed was True. ", ThisFormSet.nConnHandle)
					**ENDIF
				ELSE
					lSaveThis = .F.
				ENDIF
			ELSE
				*Already listed as Changing.
			ENDIF
		ENDIF
		
		IF NOT lAlreadySaved
			IF lSaveThis
				IF NOT USED('SalesQuote')
					TrackError( "CheckData4Save","Lost Table 'SalesQuote'!",PROGRAM(),LINENO(1))
				ENDIF
				
				IF ThisFormSet.CheckData4Save()
					IF ThisFormSet.SaveSO("SAVE",.F.)
						**********************************************
						*
						IF lPrintedSO
							MESSAGEBOX("This edit has been Saved,"+CHR(13)+CHR(13)+;
								"This edited order still needs to be printed with its edits.";
								,0+32,"Saved, now reprint." )
						*		
						*	ThisFormSet.Load_Sales_No()
						*	
						ENDIF
						*
						**********************************************
					ENDIF		
				ENDIF
				
				IF RECNO('SalesQuote') > RECCOUNT('SalesQuote')
					*Lost Record
					SELECT SalesQuote
					PRIVATE nItem
					nItem = PrepareSQLnum(ThisFormSet.frmEO.pf1.pgOrder.txtItem.Value,'Item',2,0)
					LOCATE FOR Item_A = nitem
				ENDIF
					
				IF LEN(ALLTRIM(SalesQuote.CustID))=0
					*Get Sage50 CustomerID
					PRIVATE cCustID
					
					PRIVATE lEOAllWaysOnTop,lPOAlwaysOnTopn
					lEOAllWaysOnTop = ThisFormSet.frmEO.AlWaysOnTop
					IF lEOAllWaysOnTop
						ThisFormSet.frmEO.AlwaysOnTop =.F.
					ENDIF
					lPOAllWaysOnTop = ThisFormSet.frmPO.AlWaysOnTop
					IF lPOAllWaysOnTop
						ThisFormSet.frmPO.AlwaysOnTop =.F.
					ENDIF
					
					DO FORM Forms\Select_CustomerID WITH "SoldAddr", SalesQuote.Company, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle  TO cCustID
					IF lEOAllWaysOnTop
						ThisFormSet.frmEO.AlwaysOnTop =.T.
					ENDIF
					IF lPOAllWaysOnTop
						ThisFormSet.frmPO.AlwaysOnTop =.T.
					ENDIF
		
					IF NOT LEN(ALLTRIM(cCustID))=0
					
						PRIVATE nCurrentRec 
						nCurrentRec = RECNO('SalesQuote')
						SELECT SalesQuote
						REPLACE ALL CustID WITH cCustID
						IF nCurrentRec > 0 AND nCurrentRec <= RECCOUNT('SalesQuote')
							GOTO (nCurrentRec)
						ENDIF
						
						ThisForm.pf1.pgOrder.txtCustID.Value = cCustID
									
						lOK = SaveCustID_AllQuotes(cCustID, ThisFormSet.SalesNum, ThisFormSet.nConnHandle )
						
						IF ThisFormSet.SoldAddr > 0
							SaveCustomer_SoldAddr(cCustID, ThisFormSet.SoldAddr, ThisFormSet.nConnHandle )
							ThisFormSet.SaveMKT_CustID()
						ENDIF
						
					ENDIF
				ENDIF
			ELSE
				MESSAGEBOX("Error on Save",16,"Not Saved")
			ENDIF
		ELSE
			*Was Saved at Cancel mark
		ENDIF
	ENDPROC

	PROCEDURE frmEO.cmdTop.Click
		WAIT WINDOW "GO TOP in SalesQuote" NOWAIT
		
		SELECT SalesQuote
		GO TOP IN SalesQuote
		
		
		ThisFormSet.ItemNumber = SalesQuote.Item_A
		ThisFormSet.frmPO.txtItem.Value = SalesQuote.Item_A
		ThisFormSet.frmPO.ItemNumber = ThisFormSet.ItemNumber
		ThisFormSet.SOItemTot = SalesQuote.ItemTot
		ThisFormSet.frmPO.txtItemtot.Value = SalesQuote.ItemTot
		
		ThisFormSet.frmEO.pf1.pgOrder.txtItem.REFRESH()
		
		ThisFormSet.pgRefresh()
		
		
		
	ENDPROC

	PROCEDURE frmEO.GotFocus
		IF ThisFormSet.frmEO.pf1.ActivePage = 6
			*pg_PO
			ThisFormSet.frmPO.Visible = .T.
			*ThisFormSet.frmEoP.Visible = .T.
			ThisFormSet.frmPO.AlwaysOnTop = .T.
			
		ELSE
			IF VARTYPE(ThisFormSet.frmPO) = "O"
				ThisFormSet.frmPO.Visible = .F.
				ThisFormSet.frmPO.AlwaysOnTop = .F.
			ENDIF
			IF VARTYPE(ThisFormSet.frmEoP) = "O"
				ThisFormSet.frmEoP.Visible = .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmEO.Move
		LPARAMETERS nLeft, nTop, nWidth, nHeight
		
		ThisFormSet.frmStartingStock.LEFT = ThisFormSet.frmEO.Left + 4  &&Also See Quotes.Move
		ThisFormSet.frmStartingStock.TOP = ThisFormSet.frmEO.Top + 130
		
	ENDPROC

	PROCEDURE frmEO.Moved
		LPARAMETERS nLeft, nTop, nWidth, nHeight
		ThisFormSet.frmPO.Left	= ThisFormSet.frmEO.Left+6
		ThisFormSet.frmPO.Top	= ThisFormSet.frmEO.Top + 60
		IF ThisFormSet.frmEO.pf1.ActivePage = 6
			*pg_PO
			ThisFormSet.frmPO.Visible = .T.
		
			*ThisFormSet.frmEoP.Visible = .T.
			ThisFormSet.frmEoP.Left = ThisFormSet.frmEO.Left + ThisFormSet.frmEO.Width
			ThisFormSet.frmEoP.Top = ThisFormSet.frmEO.Top
		
			ThisFormSet.frmPO.lstPOitems.SetFocus
		ELSE
			*ThisFormSet.frmPO.Visible = .F.
		ENDIF
		
		ThisFormSet.frmCustomer.Left = ThisFormSet.frmEO.Left - ThisFormSet.frmCustomer.Width - 12
		ThisFormSet.frmCustomer.Top = ThisFormSet.frmEO.Top + 270
	ENDPROC

	PROCEDURE frmEO.pf1.AddObject
		LPARAMETERS cName, cClass
	ENDPROC

	PROCEDURE frmEO.pf1.pgBillTo.chkCancelSO.Click
		PRIVATE lnSalesNum
		lnSalesNum	= ThisFormSet.SalesNum
		PRIVATE nItem
		nItem = SalesQuote.Item
		
		PRIVATE lCancel
		lCancel = PrepareSQLlogic( This.Value, 'Cancel',.F.)
		
		PRIVATE nSOItemTot, nMess
		nSOItemTot	= PrepareSQLnum(SalesQuote.ItemTot,'ItemTot',-1)
		
		nMess = MESSAGEBOX("Cancelling the Sales Number will cancel all Items"+CHR(13)+" ("+ALLTRIM(STR(nSOItemTot))+") Items"+CHR(13)+CHR(13)+"Are you sure you want to cancel?",4,"Cancel Sales Order")
		IF nMess = 6
			IF lCancel 
				
				TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.SalesNum))+" All "+ALLTRIM(STR(nSOItemTot))+" Items is to be marked as 'Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
				
				IF Cancel_SO(lnSalesNum, ThisFormSet.nConnHandle,'CANCEL')
					
					PRIVATE nAmendment, nVer, nAmendVer 
					nAmendment	= Get_Amendment_Sales_No( lnSalesNum, ThisFormSet.nConnHandle)
		
					UPDATE SalesQuote SET ;
						Cncld = .T.;
						WHERE SalesNum_a = lnSalesNum
						
					SELECT SalesTotal
					UPDATE SalesTotal SET Cncld = .T. 
					
					SELECT Sales_No	&&Sales_No does not have items details
					REPLACE Cncld  WITH .T. IN Sales_No
					REPLACE ShopRecv WITH .F. IN Sales_No
					REPLACE Amendment WITH nAmendment IN Sales_No
					
					ThisFormSet.nAmendment = nAmendment 
					ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value = nAmendment 
					
					ThisFormSet.SaveSO("CANCEL",.F.)
					*Calls: Amend_Sales_No_Ver( but the .F. prevents another Amendment
					
					PRIVATE cMess
					IF ThisFormSet.lPrintedSO
						cMess = "Please call shop to get paperwork stopped."+CHR(13)+"Reprint SalesOrder now as Cancelled."
					ELSE 
						cMess = "Please call shop to get paperwork stopped."+CHR(13)+"Reprint SalesOrder now as Cancelled."+CHR(13)+"Shop does not have the latest Print."
					ENDIF
					
					Track_Sales_No_Chng( "Edit_SalesOrder.CancelSO CANCEL(success) ",ThisFormSet.SalesNum,.F.,ThisFormSet.nAmendment )
					
					MESSAGEBOX(cMess,0+64,"Inform shop of this Cancel!")
					TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.SalesNum))+" is marked as 'Cancelled'. Reprint SalesOrder now as Cancelled." )
						
				ELSE
		*			IF HaveSODeletePermission(0)  -Now inside Calcel_SO proc
		*				IF MESSAGEBOX("Do you want to use your Administrator rights to force a Cancel?"+CHR(13)+CHR(13)+"Normal users could not cancel this order.",4+32,"Force Cancel?") = 6
							*No code needed
		*				ELSE
							TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.SalesNum))+" was NOT marked as 'Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
							This.Value = 0
							RETURN .F.
		*				ENDIF
		*			ENDIF
		*		ELSE
					This.Value = 0	
				ENDIF
				
			ELSE
				********************************************************************************************************
				TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.SalesNum))+" is to be marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
				*UN CANCEL
				IF Update_Ship_Cncld(.F.,ThisFormSet.SalesNum,ThisFormSet.nConnHandle)
					
					PRIVATE nAmendment, nVer, nAmendVer 
					nAmendment	= Get_Amendment_Sales_No( ThisFormSet.SalesNum, ThisFormSet.nConnHandle)
		
					SELECT SalesTotal
					UPDATE SalesQuote SET Cncld = .F.			
					
					SELECT Sales_No	&&Sales_No does not have items details
					REPLACE Cncld  WITH .F. IN Sales_No
					REPLACE ShopRecv WITH .F. IN Sales_No
					REPLACE Amendment WITH nAmendment IN Sales_No
					
					ThisFormSet.nAmendment = nAmendment 
					ThisFormSet.frmEO.pf1.pgBillTo.txtAmendment.Value = nAmendment 
					
					
					* KEEP SQL UPDATE Active here
					cSQLu = "UPDATE dbo.Sales_No SET "
					cSQLu = cSQLu + " Cncld = 0 "
					cSQLu = cSQLu + ",ShopRecv = 0 "&& Shop does not have this new Cancelled SO
					cSQLu = cSQLu + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLu )
						ELSE
							nSQLEXEC = 1
						ENDIF
					ENDIF
					IF nSQLEXEC > 0
					
						Track_Sales_No_Chng( "Edit_SalesOrder.CancelSO UNCANCEL(success) ",ThisFormSet.SalesNum,.F.,ThisFormSet.nAmendment )
										
						ThisFormSet.lShopRecvSO = .F.
						ThisFormset.frmEO.pf1.pgBillTo.chkShopRecvSO.Value	= ThisFormSet.lShopRecvSO
						ThisFormSet.frmEO.pf1.pgQA.chkShopRecv.Value		= ThisFormSet.lShopRecvSO
		
					ENDIF
					
					********************
					* KEEP SQL UPDATE Active here
					
					cSQLu = "UPDATE dbo.Sales SET "
					cSQLu = cSQLu + " Cncld = '0'"
					cSQLu = cSQLu + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLu )
						ELSE
							nSQLEXEC = 1
						ENDIF
					ENDIF
					IF nSQLEXEC > 0
						SELECT SalesQuote
						REPLACE Cncld WITH .F. FOR SalesNum = ThisFormSet.SalesNum IN SalesQuote
					ENDIF
					
					***************************************
					** Repeat in SOitem_Hrs
					cSQL = "UPDATE dbo.SOitem_Hrs SET "
					cSQL = cSQL + " [Cncld] = 0"
					*DateEst
					cSQL = cSQL + " WHERE SalesNum = "+STR(ThisFormSet.SalesNum)
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
							RETURN
						ELSE
							nSQLEXEC = 1
						ENDIF
					ENDIF
					**
					
					***********************
					*Record the change.
					cSQL= "INSERT INTO dbo.Sales_No_Rev ([SalesNum],[VER],[Comment]) VALUES ("
					cSQL = cSQL +""+STR(ThisFormSet.SalesNum)
					cSQL = cSQL +","+STR(ThisFormSet.nAmendment)
					cSQL = cSQL +",'"+"The Cancelled mark has been removed for Sales Order." +"')"
					
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
							*RETURN
						ELSE
							nSQLEXEC = 1
						ENDIF
					ENDIF
					***********************
		
					MESSAGEBOX("The 'Cancelled' mark has been removed for Sales Order #"+ALLTRIM(STR(ThisFormSet.SalesNum))+CHR(13)+CHR(13)+"This SO is also considered 'Not Received' by shop"+CHR(13)+"Please call and confirm about 'Sales Order print Receiving' with shop if you do not reprint this.",0+48,'Un Cancelled')
					
					TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.SalesNum))+" has been marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
					
					Save_Sales_Status( ThisFormSet.SalesNum, 'UNCancel', 'UN-Cancelled Sales Order.', ThisFormSet.nConnHandle )
					*calls: GetCancelReason if "CANCEL or REMOVE"
					
					ThisFormSet.SaveSO("CANCEL",.F.)
					MESSAGEBOX("Please call shop to get paperwork started."+CHR(13)+"Reprint SalesOrder now.",0+64,"Inform shop of this order!")
					*send to messenger
				ELSE
					*Failed Update_Ship_Cncld
					MESSAGEBOX("The 'Cancelled' mark was NOT removed for Sales Order #"+ALLTRIM(STR(ThisFormSet.SalesNum))+CHR(13)+CHR(13)+""+CHR(13)+"Please call IT and Fix.",0+16,"Error")
					TrackError("The 'Cancelled' mark was NOT removed for Sales Order #"+ALLTRIM(STR(ThisFormSet.SalesNum)),"Failed Update_Ship_Cncld", PROGRAM(), LINENO(1))
					TrackMess("Sales Order #"+ALLTRIM(STR(ThisFormSet.SalesNum))+" was NOT marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" "+PROGRAM() )
					THIS.VALUE = 1
				ENDIF
				
				This.Parent.Parent.pgOrder.chkCancelItem.Refresh
			ENDIF
		ELSE
			*unClick, this was an Error
			IF PrepareSQLlogic(THIS.Value,'Cncl',.F.)
				THIS.VALUE = 0
			ELSE
				THIS.VALUE = 1
			ENDIF
		
		ENDIF
		
		SELECT SalesQuote
		IF nItem > 0 AND nItem <= RECCOUNT('SalesQuote')
			LOCATE FOR Item = nItem
		ELSE
			GO TOP
		ENDIF
	ENDPROC

