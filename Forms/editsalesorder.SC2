			PRIVATE cShipToCountry, lUSA
			cShipToCountry = UPPER(ALLTRIM(PrepareSQLtxt(ThisFormSet.frmEO.pf1.pgShipto.txtCountry.Value,'Country',15)))
			lUSA	= PrepareSQLlogic(ThisFormSet.frmEO.pf1.pgShipto.chkUSA.Value,'USA',.T.)
			IF ( LEN(ALLTRIM(cShipToCountry))=0 OR cShipToCountry = "USA" OR cShipToCountry = "US "  OR cShipToCountry = "US" ) AND NOT lUSA
				ThisFormSet.frmEO.pf1.pgShipto.chkUSA.Value = 1
				REPLACE USA WITH .T. IN Sales_No
				
				IF !LEN(ALLTRIM(ThisFormSet.frmEO.pf1.pgShipto.cmbTarfBill.Value))=0 AND ThisFormSet.frmEO.pf1.pgShipto.cmbTarfBill.Value != "RECIPIENT"
					MESSAGEBOX( "Please Enter a ShipTo Country before using the "+CHR(13)+"'Foreign Duty billed to' tariff bill setting.",0,"No country, marked as USA!" )
				ENDIF
			ENDIF
			
