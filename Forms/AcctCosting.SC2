	PROCEDURE frmAcctCost_Mach.cmdNew.Click
		ThisForm.txtLot.ReadOnly = .F.
		
		ThisForm.cmdNew.Visible = .F.
		ThisForm.cmdEditSave.Visible = .T.
		ThisForm.cmdEditSave.Caption = "Save"
		ThisForm.cmdCancel.Caption = "Cancel"
	ENDPROC

	PROCEDURE frmAcctCost_Mach.cmdQuit.Click
		ThisForm.Visible = .F.
		
		*ThisFormSet.Load_AcctCosting(nAC_ID)
		ThisFormSet.Refresh_Editpf_Machine()
		
		ThisFormSet.frmAcctCosting_Edit.Visible = .T.
		
		
	ENDPROC

	PROCEDURE frmAcctCost_Mach.grdAcctCost_Mach.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisFormSet.Refresh_AcctCost_Mach()
	ENDPROC

ENDDEFINE
