	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		ThisFormSet.Load_AcctCosting(0)
		
	ENDPROC

	PROCEDURE Load
		SET TALK OFF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		
	ENDPROC

	PROCEDURE load_acctcosting
		PARAMETERS nAC_ID
		*ThisFormSet.Load_AcctCosting(nAC_ID)
		
		IF VARTYPE(nAC_ID) != "N"
			nAC_ID = 0
		ENDIF
		
		IF USED('tmpAcctCosting')
			ThisFormSet.frmAcctCosting.grdAcctCosting_AC_ID.RecordSource = ''
			*ThisFormSet.frmAcctCosting.grdAcctCost_Machine.RecordSource = ''
			
			USE IN tmpAcctCosting
		ENDIF
		*do not call a form ThisFormSet.frmAcctCosting on the LOAD()
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT AC.*"
		cSQL = cSQL + ", ISNULL((SELECT TOP 1 WO FROM dbo.AcctCost_WO WHERE AC_ID = AC.AC_ID),0)  AS WorkOrder "
		cSQL = cSQL + ", ISNULL((SELECT TOP 1 WO_Detail FROM dbo.AcctCost_WOD WHERE AC_ID = AC.AC_ID),0)  AS WO_Detail"
		cSQL = cSQL + ", ISNULL((SELECT TOP 1 SOitem FROM dbo.AcctCost_SOitem WHERE AC_ID = AC.AC_ID),'') AS SOitem "
		cSQL = cSQL + ", ISNULL((SELECT TOP 1 POitem FROM dbo.AcctCost_POitem WHERE AC_ID = AC.AC_ID),'') AS POitem "
		cSQL = cSQL + ", ISNULL((SELECT TOP 1 Machine FROM dbo.AcctCost_Mach WHERE AC_ID = AC.AC_ID),'') AS Machine "
		cSQL = cSQL + ", ISNULL((SELECT TOP 1 Lot FROM dbo.AcctCost_Mach WHERE AC_ID = AC.AC_ID),0) AS Lot "
		cSQL = cSQL + " FROM dbo.AcctCosting AC "
		cSQL = cSQL + " ORDER BY AC.AC_ID DESC "
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAcctCosting')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAcctCosting')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAcctCosting')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAcctCosting')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpAcctCosting' )
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(),cSQL )
			ENDIF
		ENDIF
		
		IF USED('tmpAcctCosting')
			SELECT tmpAcctCosting
			
			IF nAC_ID > 0
				LOCATE FOR AC_ID = nAC_ID
				IF NOT FOUND('tmpAcctCosting')
					MESSAGEBOX("AcctCosting AC_ID "+ALLTRIM(STR(nAC_ID))+" was not Found.",48,"Problem")
				ENDIF
			ENDIF
			
			ThisFormSet.frmAcctCosting.grdAcctCosting_AC_ID.RecordSource = 'tmpAcctCosting'
			
			ThisFormSet.Refresh_AcctCosting()
			
		ELSE
			MESSAGEBOX('Failed to load dbo.AcctCosting',0+16,"Error")
			*TrackError('Failed to load dbo.AcctCosting','Failed to load dbo.AcctCosting', PROGRAM(), LINENO(1))
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

	PROCEDURE load_acctcost_mach
		PARAMETERS nAC_ID
		*ThisFormSet.Load_AcctCost_Mach(AC_ID)
		
		IF USED('tmpAcctCost_Mach')
			ThisFormSet.frmAcctCosting.grdAcctCost_Mach.RecordSource = ''
			*ThisFormSet.frmAcctCosting.grdAcctCost_Machine.RecordSource = ''
			
			USE IN tmpAcctCost_Mach
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC 
		*IF NOT USED('tmpAcctCost_Mach')
			SELECT 0
			
			cSQL = "SELECT ACM.Machine, ACM.Lot "
			cSQL = cSQL + " FROM dbo.AcctCost_Mach ACM "
			cSQL = cSQL + " WHERE ACM.AC_ID ="+STR(nAC_ID)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAcctCost_Mach')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAcctCost_Mach')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAcctCost_Mach')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAcctCost_Mach')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'tmpAcctCost_Mach' )
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(),cSQL )
				ENDIF
			ENDIF
		
		*ENDIF
		
		IF USED('tmpAcctCost_Mach')
			SELECT tmpAcctCost_Mach
			ThisFormSet.frmAcctCosting.grdAcctCost_Mach.RecordSource = 'tmpAcctCost_Mach'
			
		ENDIF
		
		ThisFormSet.Refresh_AcctCost_Mach()
		
	ENDPROC

	PROCEDURE refresh_acctcosting
		*ThisFormSet.Refresh_AcctCosting()
		
		ThisFormSet.frmAcctCosting.txtMachine.Value		= ''
		ThisFormSet.frmAcctCosting.txtLot.Value			= 0
		
		
		IF USED('tmpAcctCosting')
			PRIVATE nAC_ID
			nAC_ID = PrepareSQLnum(tmpAcctCosting.AC_ID,'AC_ID',-3)
			
			ThisFormSet.frmAcctCosting.txtAC_ID.Value		= PrepareSQLnum(tmpAcctCosting.AC_ID,'AC_ID',-3)
			ThisFormSet.frmAcctCosting.txtdtCreated.Value 	= PrepareSQLdateTime(tmpAcctCosting.dtCreated,'dtCreated', .F.,.T.)
			ThisFormSet.frmAcctCosting.chkComplete.Value	= PrepareSQLchk(tmpAcctCosting.Complete,'Complete')
			ThisFormSet.frmAcctCosting.chkCancelled.Value	= PrepareSQLchk(tmpAcctCosting.Cancelled,'Cancelled')
			ThisFormSet.frmAcctCosting.txtdtComplete.Value	= PrepareSQLdateTime(tmpAcctCosting.dtComplete,'dtComplete', .F.,.T.)
			
			ThisFormSet.frmAcctCosting.txtWorkOrder.Value	= PrepareSQLnum(tmpAcctCosting.WorkOrder,'WorkOrder',-3)
			ThisFormSet.frmAcctCosting.txtWO_Detail.Value	= PrepareSQLnum(tmpAcctCosting.WO_Detail,'WO_Detail',-3)
			ThisFormSet.frmAcctCosting.txtSOitem.Value	= PrepareSQLtxt(tmpAcctCosting.SOitem,'SOitem',10)
			ThisFormSet.frmAcctCosting.txtPOitem.Value	= PrepareSQLtxt(tmpAcctCosting.POitem,'POitem',12)
			ThisFormSet.frmAcctCosting.txtMachine.Value	= PrepareSQLtxt(tmpAcctCosting.Machine,'Machine',10)
			ThisFormSet.frmAcctCosting.txtLot.Value		= PrepareSQLnum(tmpAcctCosting.Lot,'Lot',-3)
			
			*ThisFormSet.Refresh_AcctCost_Mach(nAC_ID)
			*ThisFormSet.Load_AcctCost_Mach(nAC_ID)
			
		ELSE
			ThisFormSet.frmAcctCosting.txtAC_ID.Value 		= 0
			ThisFormSet.frmAcctCosting.txtdtCreated.Value 	= ''
			ThisFormSet.frmAcctCosting.chkComplete.Value	= 0
			ThisFormSet.frmAcctCosting.chkCancelled.Value	= 0
			ThisFormSet.frmAcctCosting.txtdtComplete.Value	= ''
			
			ThisFormSet.frmAcctCosting.txtWorkOrder.Value	= 0
			ThisFormSet.frmAcctCosting.txtWO_Detail.Value	= 0
			ThisFormSet.frmAcctCosting.txtSOitem.Value	= ''
			ThisFormSet.frmAcctCosting.txtPOitem.Value	= ''
			ThisFormSet.frmAcctCosting.txtMachine.Value	= ''
			ThisFormSet.frmAcctCosting.txtLot.Value		= 0
		
		ENDIF
	ENDPROC

	PROCEDURE refresh_acctcost_mach
		*ThisFormSet.Refresh_AcctCost_Mach()
		
