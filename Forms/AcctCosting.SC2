	PROCEDURE frmAcctCost_Mach.cmbMachine.Init
		PRIVATE cMachList, cMachList2, cMach, cMachInit
		cMachList = GetMachine_LogList( ThisFormSet.nConnHandle )
		cMachList2 = cMachList
		cMach = ""
		cMachInit = ''
		
		IF LEN(cMachList) > 0
			cMachInit = LEFT(cMachList2, AT(",",cMachList2) -1 )
			
			
			DO WHILE LEN(cMachList2) > 0
				IF AT(",",cMachList2) = 0
					cMach = cMachList2
					This.AddItem( cMach )
					cMachList2 = ""
				ELSE
					cMach = LEFT(cMachList2, AT(",",cMachList2) -1 )
					IF LEN(cMach) > 0
						This.AddItem( cMach )
						cMachList2 = RIGHT(cMachList2, LEN(cMachList2)- LEN(cMach) -1 )
					ELSE
						EXIT
					ENDIF
				ENDIF
			ENDDO	
		ELSE
			This.AddItem('')
		ENDIF
		
		IF LEN(cMachInit) > 0
			This.DisplayValue = cMachInit
		ENDIF
	ENDPROC

	PROCEDURE frmAcctCost_Mach.cmdCancel.Click
		IF This.Caption = "Delete"
			***********************
			*Remove AC_ID from LOG
			PRIVATE nAC_ID, cMachine, nLot
			nAC_ID	= PrepareSQLnum(ThisForm.txtAC_ID.Value,'AC_ID',-3)
			cMachine	= ThisForm.cmbMachine.Value
			nLot	= PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
			
			*Check to Save
			IF nAC_ID = 0 OR nLot = 0 OR LEN(cMachine) = 0
				MESSAGEBOX("No save.",0+16,"Cannot Save.")
				RETURN .F.
			ENDIF	
			
				*Is lot Found?
			IF USED('cntAC_ID_Mach')	
				USE IN cntAC_ID_Mach
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC 
		
			SELECT 0
		
			cSQL = "SELECT COUNT(*) FROM "
			cSQL = cSQL + GetMachine_Log(cMachine,ThisFormSet.nConnHandle)
			cSQL = cSQL + " WHERE lot = "+STR(nLot)
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntAC_ID_Mach')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntAC_ID_Mach')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntAC_ID_Mach')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntAC_ID_Mach')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'cntAC_ID_Mach' )
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(),cSQL )
				ENDIF
			ENDIF
		
			IF USED('cntAC_ID_Mach')
				IF RECCOUNT('cntAC_ID_Mach') > 0
					IF cntAC_ID_Mach.EXP = 0
					*IF NOT FOUND('cntAC_ID_Mach')
						*MESSAGEBOX("AcctCosting AC_ID "+ALLTRIM(STR(nAC_ID))+" was not Found.",48,"Problem")
						MESSAGEBOX("Did not Find Machine/Lot",0+16,"Problem")
						USE IN cntAC_ID_Mach
						RETURN .F.
						
					ENDIF
				ENDIF
				
				USE IN cntAC_ID_Mach		
			ELSE
				MESSAGEBOX("Failed to count for Machine/Lot",0+16,"Error")
				*TrackError('Failed to load dbo.AcctCosting','Failed to load dbo.AcctCosting', PROGRAM(), LINENO(1))
				RETURN .F.	
			ENDIF
		
			*******************************************************
			*Is AC_ID Found for lot?
			IF USED('cntAC_ID_Mach')	
				USE IN cntAC_ID_Mach
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC 
		
			SELECT 0
		
			cSQL = "SELECT COUNT(*) FROM "
			cSQL = cSQL + GetMachine_Log(cMachine,ThisFormSet.nConnHandle)
			cSQL = cSQL + " WHERE lot = "+STR(nLot)
			cSQL = cSQL + " AND AC_ID = "+STR(nAC_ID)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntAC_ID_Mach')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntAC_ID_Mach')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntAC_ID_Mach')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntAC_ID_Mach')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'cntAC_ID_Mach' )
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(),cSQL )
				ENDIF
			ENDIF
		
			IF USED('cntAC_ID_Mach')
				IF RECCOUNT('cntAC_ID_Mach') > 0
					IF cntAC_ID_Mach.EXP > 0
					*IF NOT FOUND('cntAC_ID_Mach')
						*MESSAGEBOX("AcctCosting AC_ID "+ALLTRIM(STR(nAC_ID))+" was not Found.",48,"Problem")
						MESSAGEBOX("Machine/Lot already exists!",0+48,"Nothing to change")
						USE IN cntAC_ID_Mach
						RETURN .F.
						
					ENDIF
				ENDIF
				
				USE IN cntAC_ID_Mach		
			ELSE
				MESSAGEBOX("Failed to count for Machine/Lot"+CHR(13)+"with AC_ID",0+16,"Error")
				*TrackError('Failed to load dbo.AcctCosting','Failed to load dbo.AcctCosting', PROGRAM(), LINENO(1))
				RETURN .F.	
			ENDIF
		
			cSQL = "UPDATE "
			cSQL = cSQL + GetMachine_Log(cMachine,ThisFormSet.nConnHandle)
			cSQL = cSQL + " SET AC_ID = 0"
			cSQL = cSQL + " WHERE lot = "+STR(nLot)
		
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, '' )
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(),cSQL )
				ENDIF
				RETURN .F.
			ENDIF
		
		
			*******************************************
			*DELETE 
			cSQL = "DELETE FROM dbo.AcctCost_Mach "
			cSQL = cSQL + " WHERE AC_ID = "+STR(nAC_ID)
			cSQL = cSQL + " AND Machine = '"+cMachine+"'"
			cSQL = cSQL + " AND Lot = "+STR(nLot)
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, '' )
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(),cSQL )
				ENDIF
				RETURN .F.
			ENDIF
		
			*Refresh()
			*******************************************	
			
			*This.Caption = "Cancel"
			ThisForm.txtLot.ReadOnly = .T.
			ThisForm.cmdNew.Visible = .T.
			ThisForm.cmdEditSave.Visible = .T.
			ThisForm.cmdEditSave.Caption = "Edit"
			
		ELSE
			* Cancel Add/edit
			This.Caption = "Delete"
			
			ThisForm.txtLot.ReadOnly = .T.
			ThisForm.cmdNew.Visible = .T.
			ThisForm.cmdEditSave.Visible = .T.
			ThisForm.cmdEditSave.Caption = "Edit"
			
		ENDIF
	ENDPROC

