	PROCEDURE Unload
		RETURN THISFORM.cPassCompany
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cPassCompany = Space(20)+Space(30)
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdReturn.Click
		PRIVATE cCompany, cName, nID
		cCompany	= PrepareSQLtxt(tmpQcompN.Company,'Company',30)
		cName		= PrepareSQLtxt(tmpQcompN.Name,'Name',25)
		nID			= PrepareSQLnum(tmpQcompN.ID,'ID',-3)
		
		ThisForm.cPassCompany = UPPER(cCompany+cName+STR(nID,10,0) )
		ThisForm.Release
	ENDPROC

	PROCEDURE grdCompany.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.txtID.Refresh
		
	ENDPROC

