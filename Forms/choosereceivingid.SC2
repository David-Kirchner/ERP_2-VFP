	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		CASE tmpReceivingPOi.cancelled
			nColor = RGB( 255, 0, 0 ) &&RED	
		*CASE tmpReceivingPOitem.Cancelled
		*	nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pParm, pWhat
		*DO FORM Forms\ChooseReceivingID WITH cPOitem, 'POitem' TO nReceiveID
		
		*IF NOT VARTYPE(pParm) != "C" OR VARTYPE(pParm) != "N"
		*	MESSAGEBOX("Please pass parameter PO, SO or WO !",0,"Cannot continue getting ReceivingID")
		*	pParm = ''
		*ENDIF
		IF VARTYPE(pWhat) != "C"
			MESSAGEBOX("Please pass parameter PO, SO or WO !, NO (pWhat).",0,"Showing All ReceivingID")
			pWhat = ''
		ENDIF
		
		
		PRIVATE cPOitem, cSOitem, nSalesNum, nWO_Detail, nWO
		cPOitem =''
		cSOitem = ''
		nSalesNum = 0
		nWO_Detail = 0
		nWO = 0
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpReceivingPOi')	
			USE IN tmpReceivingPOi
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Receiving "
		
		DO CASE
		CASE pWhat = "POitem"
			IF VARTYPE(pParm) != "C" 
				MESSAGEBOX("Did not get the PO item.",0,"Showing All ReceivingID")
			ELSE
				cPOitem = pParm
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			ENDIF
		CASE pWhat = "SalesNum"
			IF VARTYPE(pParm) != "N" 
				MESSAGEBOX("Did not get the SalesNum.",0,"Showing All ReceivingID")
			ELSE
				nSalesNum = pParm
				cSQL = cSQL + " WHERE SOitem LIKE '%"+ALLTRIM(STR(nSalesNum))+"-%'"
			ENDIF
		CASE pWhat = "SOitem"
			IF VARTYPE(pParm) != "C" 
				MESSAGEBOX("Did not get the SO item.",0,"Showing All ReceivingID")
			ELSE
				cPOitem= pParm
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			ENDIF
		CASE pWhat = "WO_Detail"
			IF VARTYPE(pParm) != "N" 
				MESSAGEBOX("Did not get the WO_Detail.",0,"Showing All ReceivingID")
			ELSE
				nWO_Detail = pParm
				cSQL = cSQL + " WHERE WO_Detail = "+ALLTRIM(STR(nWO_Detail))
			ENDIF
		CASE pWhat = "WO"
			IF VARTYPE(pParm) != "N" 
				MESSAGEBOX("Did not get the WO.",0,"Showing All ReceivingID")
			ELSE
				nWO = pParm
				cSQL = cSQL + " WHERE WO = "+ALLTRIM(STR(nWO))
			ENDIF
		OTHERWISE
			RETURN .F.
		ENDCASE
		
		
		
		cSQL = cSQL + " ORDER BY ID DESC"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOi')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOi')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivingPOi")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivingPOi")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpReceivingPOi')
		ENDIF
		
		IF USED("tmpReceivingPOi")
			SELECT tmpReceivingPOi
		ELSE
			MESSAGEBOX("Table 'tmpReceivingPOi' not open",0,"Open file first")
			RETURN .F. 
		ENDIF
		
		*SELECT * FROM PurchaseOrders WHERE HpaPo = pnHpaPo INTO CURSOR tmpPOitems
		IF VARTYPE(cPoItem) = "C"
			ThisForm.Caption = ThisForm.Caption+" for PO item "+ALLTRIM(cPoItem)
		ELSE
		ENDIF
		
		ThisForm.grid.RecordSource = "tmpReceivingPOi"
		*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		*ThisForm.grid.SetFocus
		*!*	PRIVATE nRecCount
		*!*	nRecCount = RECCOUNT("tmpReceivingPOi")
		*!*	DO CASE
		*!*	CASE nRecCount = 0
		*!*		MESSAGEBOX("Sorry, PO Item number not Found",32,"No records to Show!")
		*!*		ThisForm.cmdCancel.Click
		*!*	CASE nRecCount = 1
		*!*		ThisForm.cmdSelect.Click()
		*!*	CASE nRecCount > 7
		*!*		GO BOTTOM
		*!*		SKIP -6
		*!*	OTHERWISE
		*!*		GO BOTTOM
		*!*	ENDCASE
		
		
		ThisForm.txtAlloy.Value 		= tmpReceivingPOi.Alloy
		ThisForm.txtHeat.Value	 		= tmpReceivingPOi.Heat
		ThisForm.txtDescription.Value 	= tmpReceivingPOi.Description
		ThisForm.txtSpecs.Value 		= tmpReceivingPOi.Specs
		ThisForm.txtComments.Value 		= tmpReceivingPOi.Comments
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		IF USED('')
			USE IN
		ENDIF
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdCancel.Click
		
		ThisForm.HoldNumber = 0
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE nHoldNumber
		*cHoldNumber = ""
		nHoldNumber = tmpReceivingPOi.ID
		ThisForm.HoldNumber = nHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE Grid.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.txtAlloy.Value 		= tmpReceivingPOi.Alloy
		ThisForm.txtHeat.Value	 		= tmpReceivingPOi.Heat
		ThisForm.txtDescription.Value 	= tmpReceivingPOi.Description
		ThisForm.txtSpecs.Value 		= tmpReceivingPOi.Specs
		ThisForm.txtComments.Value 		= tmpReceivingPOi.Comments
		
	ENDPROC

ENDDEFINE
