 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="2" />

	*<PropValue>
		DataSource = .NULL.
		Height = 0
		Left = 0
		Name = "Dataenvironment"
		Top = 0
		Width = 0
	*</PropValue>

ENDDEFINE

DEFINE CLASS frmreceiveso AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="lblSONumber" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtSO" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdReceived" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdQuit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblPastSO" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblInfo" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: checksonumber
		*p: connhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		AlwaysOnTop = .T.
		Caption = "Shop Receive "
		ClipControls = .T.
		Closable = .T.
		connhandle = 0
		ControlBox = .F.
		DataSession = 2
		DoCreate = .T.
		Height = 151
		Left = 0
		Name = "frmReceiveSO"
		ShowWindow = 2
		Top = 0
		Width = 235
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdQuit' AS commandbutton WITH ;
		Caption = "\<Quit", ;
		Height = 27, ;
		Left = 144, ;
		Name = "cmdQuit", ;
		Top = 96, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdReceived' AS commandbutton WITH ;
		Caption = "\<Receive", ;
		Height = 27, ;
		Left = 144, ;
		Name = "cmdReceived", ;
		Top = 24, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'lblInfo' AS label WITH ;
		Alignment = 2, ;
		Caption = "Used by SHOP to let SALESMEN know the sales order print out has been received.", ;
		ForeColor = 0,0,255, ;
		Height = 60, ;
		Left = 11, ;
		Name = "lblInfo", ;
		Top = 84, ;
		Width = 132, ;
		WordWrap = .T.
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblPastSO' AS label WITH ;
		Alignment = 2, ;
		Caption = "", ;
		Height = 17, ;
		Left = 11, ;
		Name = "lblPastSO", ;
		Top = 60, ;
		Width = 216
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblSONumber' AS label WITH ;
		Caption = "Sales Order Number", ;
		Height = 17, ;
		Left = 23, ;
		Name = "lblSONumber", ;
		Top = 5, ;
		Width = 120
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'txtSO' AS textbox WITH ;
		Alignment = 3, ;
		Height = 23, ;
		Left = 41, ;
		MaxLength = 14, ;
		Name = "txtSO", ;
		SelectOnEntry = .T., ;
		Top = 24, ;
		Value = 0, ;
		Width = 100
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE checksonumber
		PARAMETERS pSO
		
		PRIVATE cScanStandardResults
		IF VARTYPE(pSO) = "C"
			cScanStandardResults = getScanStandard( pSO )
			IF LEFT(cScanStandardResults,20) = "Sales Order Number"
				nSO = getScannedInt(cScanStandardResults)
			ELSE
				*Not positive this scan is for this procedure
				pSO = VAL(pSO)
			ENDIF
		ENDIF
		
		
		IF VARTYPE(pSO) != "N"
			nSO = 0
		ELSE
			nSO = pSO
		ENDIF
		
		IF nSO < 1
			MESSAGEBOX("Need a Sales Order Number",0+48,"Number too small")
			ThisForm.lblPastSO.Caption = ""
			RETURN
		ENDIF
		
		
		PRIVATE nCountSO
		nCountSO = Count_SOinSales_No( nSO, THISFORM.ConnHandle)
		
		
		
			IF nCountSO = 0
				MESSAGEBOX( "Did not Find the SO:"+ALLTRIM(STR(nSO)),0+48,"Not Found!")
				ThisForm.lblPastSO.Caption = "SO "+ALLTRIM(STR(nSO))+" not found!"
			ELSE
				PRIVATE nCountSOr 
				*Check to See if Allready Marked as ShopRecv
				nCountSOr = Count_SOinSales_No(nSO, ThisForm.ConnHandle,'ShopRecv')
				
				PRIVATE nAmendmentinSales_No
				nAmendmentinSales_No = Get_AmendmentinSales_No( nSO, THISFORM.ConnHandle )
				
					IF nCountSOr = 0
						*Found SalesNo, not marked.
						*Get SO info to Display
						
					
						
						cSQL = "SELECT Company, SalesP, SaleDate FROM dbo.AllQuotes WHERE SalesNum = "+STR(nSO)
						
						IF USED("AllQuotesSO")
							SELECT AllQuotesSO
						ELSE
							SELECT 0
						ENDIF
		
						nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'AllQuotesSO')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL , 'AllQuotesSO')
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, THISFORM.ConnHandle, nSQLEXEC, 'AllQuotesSO')
						ENDIF
						
						PRIVATE cCompany, cSalesP, dSaleDate
						cCompany = ""
						cSalesP = ""
						dSaleDate = CTOD("  /  /  ")
						
						IF USED("AllQuotesSO")
							IF VARTYPE(AllQuotesSO.Company) = "C"
								cCompany = ALLTRIM(AllQuotesSO.Company)
							ENDIF
							IF VARTYPE(AllQuotesSO.SalesP) = "C"
								cSalesP = ALLTRIM(AllQuotesSO.SalesP)
							ENDIF
							IF VARTYPE(AllQuotesSO.SaleDate) = "D" OR VARTYPE(AllQuotesSO.SaleDate) = "T"
								dSaleDate = AllQuotesSO.SaleDate 
							ENDIF
							
							USE IN AllQuotesSO
						ENDIF
						
						PRIVATE cText
						cText = "Are you sure you want to mark as Receive?"+CHR(13)
						cText = cText + CHR(13) +   "            SO:"+ALLTRIM(STR(nSO))
						IF NOT EMPTY(cCompany)
							cText = cText + CHR(13)+"    Company:"+cCompany 
						ENDIF
						IF NOT EMPTY(cSalesP)
							cText = cText + CHR(13)+"       SalesP:"+cSalesP 
						ENDIF
						IF NOT EMPTY(dSaleDate)
							cText = cText + CHR(13)+"   SaleDate:"+DTOC(dSaleDate )
						ENDIF
						IF nAmendmentinSales_No > 0
							cText = cText + CHR(13)+CHR(13)+"SO Revision:"+ALLTRIM(STR(nAmendmentinSales_No ))
						ELSE
							cText = cText + CHR(13)+CHR(13)+"SO Revision: 0"
						ENDIF
						
						CLEAR TYPEAHEAD 
						IF MESSAGEBOX(cText,4+32,"Found unmarked SO")=6 &&Yes
							*Mark SO
							
							cSQL = "UPDATE dbo.Sales_No SET ShopRecv = 1 WHERE SalesNum = "+STR(nSO)
							
							nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, THISFORM.ConnHandle, nSQLEXEC )
							ENDIF					
							
							ThisForm.txtSO.Value = 0
							ThisForm.lblPastSO.Caption = "Marked SO "+ALLTRIM(STR(nSO))+"!"
							
							
							TrackMess("Marked SO "+ALLTRIM(STR(nSO))+", Amendment "+ALLTRIM(STR(nAmendmentinSales_No))+" as Recieved by Shop.")
							
						ENDIF
					ELSE
						CLEAR TYPEAHEAD 
						*Found SalesNo and allready marked!
						MESSAGEBOX("  Found SO:"+ALLTRIM(STR(nSO))+CHR(13)+"Amendment:"+ALLTRIM(STR(nAmendmentinSales_No))+CHR(13)+"But it is Allready marked as Received by shop.",0+64,"Allready marked")
						ThisForm.lblPastSO.Caption = "SO "+ALLTRIM(STR(nSO))+" was allready received!"
					ENDIF
						
			ENDIF
		
	ENDPROC

	PROCEDURE Load
		ThisForm.ConnHandle = SQLSTRINGCONNECT('dsn=HPA')
		
		IF ThisForm.ConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "PROC_HPA" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		*!*	_SCREEN.Left	= 10    
		*!*	_SCREEN.Top		= 100
		*!*	_SCREEN.Height	= 200
		*!*	_SCREEN.Width	= 260
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.ConnHandle )
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		Quit
	ENDPROC

	PROCEDURE cmdReceived.Click
		PRIVATE nSO
		nSO = ThisForm.txtSO.Value
		
		IF VARTYPE(nSO ) = "C"
			nSO = VAL(nSO )
		ENDIF
		IF VARTYPE(nSO ) != "N"
			nSO = 0
		ENDIF
		IF nSO < 1
			MESSAGEBOX("Need a Sales Order Number",0+48,"Number too small")
			ThisForm.lblPastSO.Caption = ""
			RETURN
		ELSE
			ThisForm.CheckSOnumber(nSO)
		ENDIF
		
		
		ThisForm.txtSO.SetFocus
	ENDPROC

	PROCEDURE txtSO.Valid
		PRIVATE cText
		cText = This.Value
		
		IF NOT EMPTY(cText)
			ThisForm.CheckSOnumber(cText)
			*ThisForm.cmdReceived.Click
			This.Value = 0
			RETURN 0
		ENDIF
		
	ENDPROC

ENDDEFINE
