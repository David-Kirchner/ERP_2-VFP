		ENDIF
		SELECT 0
		
		cSQL = " SELECT Master_ID,ID_Detail "
		cSQL = cSQL + ",RTRIM(CAST(WHO AS CHAR(100))) AS cWho"
		cSQL = cSQL + ",[When] "
