	PROCEDURE frmSelect_SO_item.lblDatePicker.Click
		IF ThisForm.cmdEditDate.Caption = "Edit"
			RETURN .F.
		ENDIF
		
		PRIVATE dDate1,dDate2
		dDate1 = ThisForm.txtShipDue.Value
		
		DO FORM "forms\OleCalendar.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		ThisForm.txtShipDue.Value = dDate2
		ThisForm.txtShipDue.Refresh
		ThisForm.txtShipDue.SetFocus
	ENDPROC

