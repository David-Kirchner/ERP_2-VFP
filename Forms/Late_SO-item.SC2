	PROCEDURE frmSelect_SO_item.cmdStockHist.Click
		*ThisFormSet.SalesHistory()
		
		PRIVATE cTBL,nID,nID_Detail
		cTBL = 	''
		nID = 0
		nID_Detail = 0
		
		IF USED("tmpSales_Stock")
			IF ThisFormSet.frmSales_Stock.Visible 
				nID	=	 PrepareSQLnum(tmpSales_Stock.StockLst_ID,'ID_Master',-3)
				nID_Detail = PrepareSQLnum(tmpSales_Stock.StockLst_ID_Detail,'ID_Detail',-3)
			ENDIF
		ENDIF
		
		IF nID_Detail > 0
			DO FORM Forms\StockLst_History.scx WITH cTBL, nID, nID_Detail
		ELSE 
			IF nID > 0
				DO FORM Forms\StockLst_History.scx WITH cTBL,nID, 0
			ELSE
				MESSAGEBOX("Did not find a specific Stock ID"+CHR(13)+"Stock History will open"+CHR(13)+"but you will have to start the history search",0+64,"Open Stock History")
				DO FORM Forms\StockLst_History.scx 
			ENDIF
		ENDIF
	ENDPROC

