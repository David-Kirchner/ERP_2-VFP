	PROCEDURE getcompanyname
		*ThisFormSet.GetCompanyName
		PRIVATE nSalesNum
		nSalesNum = ThisFormSet.frmSelect_SO_item.txtSalesNum.Value
		
		ThisFormSet.frmSelect_SO_item.txtCompany.Value = ''
		
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpCompany")
			USE IN tmpCompany
		ENDIF
		SELECT 0
		
		cSQL="SELECT TOP 1 Company"
		cSQL=cSQL+" FROM dbo.AllQuotes WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SalesNum = "+STR(nSalesNum)
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCompany')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCompany')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompany")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompany")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCompany' )
		ENDIF
		
		IF USED('tmpCompany')
			IF RECCOUNT('tmpCompany') > 0
				ThisFormSet.frmSelect_SO_item.txtCompany.Value = tmpCompany.Company
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pSO
		*DO FORM Forms\Late_SO-item WITH nSO 
		
		IF VARTYPE(pSO) = "N"
			ThisFormSet.nSalesNum = pSO
		*	SELECT ChooseSales_No
		*	LOCATE FOR SalesNum = pSO
		*	ThisForm.RefreshScreen()	
		ELSE
			ThisFormSet.nSalesNum = 0
		ENDIF
		
		ThisFormSet.Load_Sales_NO(ThisFormSet.nSalesNum)
		
		IF ThisFormSet.nSalesNum > 0
			ThisFormset.frmSelect_SO_item.txtSalesOrder.Value = ThisFormSet.nSalesNum
			ThisFormset.frmSelect_SO_item.cmdFind.Click
		ENDIF
		
		ThisFormSet.frmSelect_SO_item.txtSalesOrder.Value = ChooseSales_No.SalesNum
		ThisFormSet.frmSelect_SO_item.txtSalesOrder.SetFocus
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
				
		ThisFormSet.nConnHandle = get_SQLstringCONNECT()
		
		
	ENDPROC

	PROCEDURE load_sales_no
		PARAMETERS pSO
		*ThisFormSet.Load_Sales_NO()
		PRIVATE nSO
		nSO = PrepareSQLnum(pSO,'SalesNum',-3)
		
		PRIVATE lLate, lcmplt, lOnHold
		lLate = PrepareSQLlogic(ThisFormSet.frmSelect_SO_item.chkFLate.Value,'Late')
		lOnHold	= PrepareSQLlogic(ThisFormSet.frmSelect_SO_item.chkFOnHold.Value,'HOLD')
		lcmplt = PrepareSQLlogic(ThisFormSet.frmSelect_SO_item.chkFcmplt.Value,'CMPLT')
		
		PRIVATE lReturn 
		lReturn = .T.
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("ChooseSales_No")
			ThisFormset.frmSelect_SO_item.grdSales_No.RecordSource = ''
			
			USE IN ChooseSales_No
		ENDIF
		SELECT 0
		
		cSQL="SELECT SN.SalesNum,SN.ItemTot,SN.SalesRep,SN.pShipAddr,SN.pSoldAddr,SN.ShipRoute,SN.ShipPay,SN.PayType "
		cSQL=cSQL+",SN.cncld,SN.cmplt,SN.amendment,SN.CreateDate" 
		cSQL=cSQL+" FROM dbo.Sales_No SN WITH(NOLOCK) "
		IF lLate OR lOnHold OR lcmplt
			cSQL=cSQL+" INNER JOIN dbo.Sales S WITH(NOLOCK) ON SN.salesnum = S.SalesNum "
			cSQL=cSQL+" WHERE "
		
			IF lLate 
				cSQL=cSQL+" ( "
				cSQL=cSQL+" S.ShipDue < GetDate() "
				
				cSQL=cSQL+" AND S.Cncld = 0 "
				cSQL=cSQL+" AND S.Cmplt = 0 "
				cSQL=cSQL+" ) "
			ENDIF
			IF lOnHold 
				IF lLate 
					cSQL=cSQL+" AND ISNULL(S.Hold,0) = 1 "
				ELSE
					cSQL=cSQL+" ISNULL(S.Hold,0) = 1 "
				ENDIF
			ENDIF
			IF lcmplt
				IF lLate OR lOnHold 
					cSQL=cSQL+" AND ( ISNULL(SN.cncld,0) = 1 AND ISNULL(SN.cmplt,0) = 1 ) "
				ELSE
					cSQL=cSQL+" ( ISNULL(SN.cncld,0) = 1 AND ISNULL(SN.cmplt,0) = 1 )"
				ENDIF
			ENDIF
		ENDIF
		cSQL=cSQL+" ORDER BY SN.SalesNum DESC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ChooseSales_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ChooseSales_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ChooseSales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ChooseSales_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ChooseSales_No' )
			lReturn = .F.
		ENDIF
		
		IF USED('ChooseSales_No')
			IF RECCOUNT('ChooseSales_No')=0
				MESSAGEBOX("No records found",0,"No data")
			ELSE
				ThisFormset.frmSelect_SO_item.grdSales_No.RecordSource = 'ChooseSales_No'
					
				SELECT ChooseSales_No
		
				GO TOP
				IF nSO > 0
					LOCATE FOR SalesNum = nSO
					IF FOUND('ChooseSales_No')
					
					ELSE
						PRIVATE cMess
						cMess = "SO "+ALLTRIM(STR(nSO))+" was not Found to show!"+CHR(13)
						cMess = cMess +"This will not be shown in the current records set."+CHR(13)
						IF lLate
							cMess = cMess +CHR(13)+ "Filter is set to LATE"
						ENDIF
						IF lcmplt
							cMess = cMess +CHR(13)+ "Filter is set to Complete AND Cancelled"
						ENDIF
						IF lOnHold
							cMess = cMess +CHR(13)+ "Filter is set to On Hold"
						ENDIF
								
						MESSAGEBOX(cMess,0+64,"Specific SO Not Found")
						lReturn = .F.
					ENDIF
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Could not load 'Sales_No'",0,"SQL Error")
			lReturn = .F.
		ENDIF
		
		RETURN lReturn 
	ENDPROC

	PROCEDURE refreshscreen
		*ThisFormSet.RefreshScreen()
		
		ThisFormSet.frmSelect_SO_item.txtSalesNum.Refresh
		ThisFormSet.frmSelect_SO_item.txtItemTot.Refresh
		ThisFormSet.frmSelect_SO_item.txtSalesRep.Refresh
		ThisFormSet.frmSelect_SO_item.txtpShipAddr.Refresh
		ThisFormSet.frmSelect_SO_item.txtpSoldAddr.Refresh
		ThisFormSet.frmSelect_SO_item.txtShipRoute.Refresh
		ThisFormSet.frmSelect_SO_item.txtShipPay.Refresh
		ThisFormSet.frmSelect_SO_item.txtPayType.Refresh
		ThisFormSet.frmSelect_SO_item.txtItemTot.Refresh
		ThisFormSet.frmSelect_SO_item.chkSOcncld.Refresh
		ThisFormSet.frmSelect_SO_item.chkSOcmplt.Refresh
		ThisFormSet.frmSelect_SO_item.txtAmendment.Refresh
