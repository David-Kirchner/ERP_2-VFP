		ThisFormSet.GetCompanyName()
		
		*ThisFormSet.frmSelect_SO_item.grdItem.Refresh
		ThisFormSet.Refresh_grdSOitems()
		*CALLS:ThisForm.RefreshScreenItem() called in Refresh_grdSOitems()
	ENDPROC

	PROCEDURE refreshscreenitem
		*PARAMETERS pItem
		
