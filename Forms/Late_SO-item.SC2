	ENDPROC

	PROCEDURE frmSelect_SO_item.chkSOcmplt.Click
		PRIVATE lComplete 
		lComplete = This.Value
		
		PRIVATE nSalesNum, nItem, nMess, nCntSOitem, lPermission, lSaved 
		nSalesNum = PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		nItem  		= PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',2,0)
		lPermission = .F.
		lSaved = .F.
		PRIVATE nCntItemFinished 
		nCntItemFinished = 0
		
		IF lComplete 
			nMess = MESSAGEBOX("Are you sure you want to mark this"+CHR(13)+"Sales Order "+ALLTRIM(STR(nSalesNum))+" as Complete?",4+32,"Mark as Complete" )
			IF nMess = 6
				*Mark all items that are not Cancelled as Complete.
				
				*nCntSOitem = Count_SOIteminSales(cSOItem, ThisForm.nConnHandle, "NOTCANCEL") 'cAndSome = "COMPLETE"'
				nCntSOitem = Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle, "NOTCANCELLED" ) 
				IF nCntSOitem = 0
					MESSAGEBOX("Cannot mark this"+CHR(13)+"Sales Order "+ALLTRIM(STR(nSalesNum))+" as Complete"+CHR(13)+"All Items are CANCELLED.",4+32,"Fail" )
					
					This.Value = .F.
					RETURN
				ENDIF
				
				lPermission = HaveSOCompletePermission( nSalesNum,ThisFormSet.nConnHandle )
				*lOK = Allow_REMOVE_SO(nSalesNum, nConn)
				
				IF lPermission
				
					nItemTot = Count_ItemTot_SalesNum (nSalesNum, ThisFormSet.nConnHandle)
					IF nCntItemFinished <> nItemTot
						IF MESSAGEBOX("SalesNumber "+STR(nSalesNum)+":"+CHR(13)+STR(nCntItemFinished)+" is the Counted Finished SOitems"+CHR(13)+STR(nItemTot)+" is the Listed SalesNum Total Items"+CHR(13)+CHR(13)+"Are you sure you want to update as Complete?",4+32,"Complete the SalesNumber")!=6
							lPermission = .F.
						ELSE
							TrackMess("SalesNumber "+ALLTRIM(STR(nSalesNum))+":"+CHR(13)+STR(nCntItemFinished)+" is the Counted Finished SOitems"+CHR(13)+STR(nItemTot)+" is the Listed SalesNum Total Items"+CHR(13)+CHR(13)+"User is sure they want to update as Complete.")
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"SalesNumber "+ALLTRIM(STR(nSalesNum))+":"+CHR(13)+STR(nCntItemFinished)+" is the Counted Finished SOitems"+CHR(13)+STR(nItemTot)+" is the Listed SalesNum Total Items"+CHR(13)+CHR(13)+"User is sure they want to update as Complete.")
						ENDIF
					ENDIF
				ENDIF
				IF lPermission
					*aSOitems() = ArraySOitem( nSalesNum, ThisFormSet.nConnHandle, "OPEN" )
					IF USED('tmpSOitem_s')
						USE IN 'tmpSOitem_s'
						TrackError("tmpSOitem_s was already open."+CHR(13)+"This table should be only used with Proc_SQL:Open_tmpSOitem_s()","tmpSOitem_s was already open.", PROGRAM(), LINENO(1))
					ENDIF
					SELECT 0
					IF Open_tmpSOitem_s( nSalesNum, ThisFormSet.nConnHandle, "OPEN" )
						IF USED('tmpSOitems')
							IF RECCOUNT('tmpSOitem_s') > 0
							
								SCAN
									*IF NOT lTranAlreadySet
										= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2) &&Set Manual transaction
									*ENDIF
									
									lSaved = Mark_SOitem_Cmplt(tmpSOitem_s.SOitem, ThisFormSet.nConnHandle, .F. )
									IF lSaved 
										lOK = Save_SOitem_Status( tmpSOitem_s.SOitem, nSalesNum, "Complete", "Completed from Late_SO-items screen.", ThisFormSet.nConnHandle )
									ELSE
										EXIT
									ENDIF
								ENDSCAN
								
										
								IF NOT lSaved
									= SQLROLLBACK(ThisFormSet.nConnHandle)
								ELSE
									= SQLCOMMIT(ThisFormSet.nConnHandle)	
								ENDIF
								= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && TRANSAUTO
								
							ENDIF
							USE IN 'tmpSOitem_s'
						ENDIF
					ENDIF
				ELSE
					MESSAGEBOX("Not allowed to change.",64,"Not Allowed")
				ENDIF
			ENDIF
			****************
			IF lSaved 
				*Count Finished Items
				nCntItemFinished = Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle, "FINISHED" ) 
				nItemTot = Count_ItemTot_SalesNum (nSalesNum, ThisFormSet.nConnHandle)
				
				IF nCntItemFinished <> nItemTot
					IF MESSAGEBOX("SalesNumber "+STR(nSalesNum)+":"+CHR(13)+STR(nCntItemFinished)+" is the Counted Finished SOitems"+CHR(13)+STR(nItemTot)+" is the Listed SalesNum Total Items"+CHR(13)+CHR(13)+"Are you sure you want to update as Complete?",4+32,"Complete the SalesNumber")!=6
						lSaved = .F.
					ELSE
						TrackMess("SalesNumber "+ALLTRIM(STR(nSalesNum))+":"+CHR(13)+STR(nCntItemFinished)+" is the Counted Finished SOitems"+CHR(13)+STR(nItemTot)+" is the Listed SalesNum Total Items"+CHR(13)+CHR(13)+"User is sure they want to update as Complete.")
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"SalesNumber "+ALLTRIM(STR(nSalesNum))+":"+CHR(13)+STR(nCntItemFinished)+" is the Counted Finished SOitems"+CHR(13)+STR(nItemTot)+" is the Listed SalesNum Total Items"+CHR(13)+CHR(13)+"User is sure they want to update as Complete.")
					ENDIF
				ENDIF
			ENDIF
			
			IF lSaved 
			
				PRIVATE cSQL, nSQLEXEC 
				*Mark_SO_Cmplt
				cSQL = "UPDATE dbo.Sales_NO "
				cSQL = cSQL + " SET cmplt=1 "
				cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
				cSQL = cSQL + " AND ItemTot <= "+STR(nCntItemFinished)
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL,'' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
						lReturn = .F.
					ENDIF
				ENDIF
		
			ENDIF
			
			IF lSaved 
			
				PRIVATE nAmendment
				nAmendment = Get_Amendment_Sales_No( nSalesNum, ThisFormSet.nConnHandle)
				Track_Sales_No_Chng( "Late_SO-item.SO COMPLETE", nSalesNum, .T., nAmendment )
				
				IF USED('tmpSalesDescript')
					lOK = Save_SOitem_Status( tmpSalesDescript.SOitem, nSalesNum, "Complete", "Completed SO from Late_SO-items screen.", ThisFormSet.nConnHandle )
				ENDIF
			ENDIF
		
			IF lSaved 
				IF ThisFormSet.Load_Sales_NO(nSalesNum)
					IF ChooseSales_No.SalesNum = nSalesNum
						SELECT tmpSOitems
						LOCATE FOR Item = nItem
					ENDIF
				ENDIF
				ThisFormSet.RefreshScreen()
			ELSE	
				This.Value = .F.
			ENDIF
		ELSE
			*
			*UnComplete code
			*MESSAGEBOX()
			nCntSOitem = Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle, "NOTCANCELLED" ) 
			IF nCntSOitem > 0
				PRIVATE nMess
				nMess = MESSAGEBOX("Are you sure you want to mark this"+CHR(13)+"Sales Order "+ALLTRIM(STR(nSalesNum))+" as NOT Complete?",4+32,"UN Complete" )
				IF nMess = 6
					PRIVATE cSQL, nSQLEXEC 
					*Mark_SO_Cmplt
					cSQL = "UPDATE dbo.Sales_NO "
					cSQL = cSQL + " SET cmplt=0 "
					cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
					
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL,'' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
							lReturn = .F.
						ENDIF
					ENDIF
		
				ENDIF
				
				IF lReturn
					PRIVATE nAmendment
					nAmendment = Get_Amendment_Sales_No( nSalesNum, ThisFormSet.nConnHandle)
					Track_Sales_No_Chng( "Late_SO-item.SO UNComplete", nSalesNum, .T., nAmendment )
					
					IF USED('tmpSalesDescript')
						lOK = Save_SOitem_Status( tmpSalesDescript.SOitem, nSalesNum, "UNComplete", "UNComplete SO from Late_SO-items screen.", ThisFormSet.nConnHandle )
					ENDIF
				ENDIF
				
				IF lReturn 
					IF ThisFormSet.Load_Sales_NO(nSalesNum)
						IF ChooseSales_No.SalesNum = nSalesNum
							SELECT tmpSOitems
							LOCATE FOR Item = nItem
						ENDIF
					ENDIF
					ThisFormSet.RefreshScreen()
				ELSE	
					This.Value = .T.
				ENDIF		
				
			ELSE	
				This.Value = .T.
				RETURN
			ENDIF
				
		ENDIF
		
	ENDPROC

	PROCEDURE frmSelect_SO_item.chkSOcncld.Click
		PRIVATE lCancel 
		lCancel = This.Value
		
		PRIVATE nSalesNum, nItem, nMess, nCntSOitem 
		nSalesNum = PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		nItem  		= PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',2,0)
		*Cancel_SOitem 
		*Cancel_SO(nSalesNum, ThisForm.nConnHandle,'CANCEL')
		PRIVATE lHaveAdminPermission 
		lHaveAdminPermission = AllowAdmin()
		
		********
		*Check for Permission to delete
		PRIVATE lHaveSODeletePermission	&&Proc_Setup:
		lHaveSODeletePermission = HaveSODeletePermission(nSalesNum)
		
		PRIVATE lReturn 
		lReturn = .T.
		
		IF lHaveAdminPermission OR lHaveSODeletePermission 
			PRIVATE cMess, nMess
			cMess = "Are you sure you want to mark this"+CHR(13)+"Sales Order "+ALLTRIM(STR(nSalesNum))
			IF lCancel 
				cMess = cMess +" as Cancelled?"
			ELSE
				cMess = cMess +" as NOT Cancelled?"
			ENDIF
			
			nMess = MESSAGEBOX(cMess,4+32,"Change SO Cancel status" )
			IF nMess = 6
				*lOK = Is_SOitem_OnHold( cSOitem, cType, nConn )
				PRIVATE cSQL, nSQLEXEC 
				*Mark_SO_Cmplt
				cSQL = "UPDATE dbo.Sales_NO "
				IF lCancel
					cSQL = cSQL + " SET cncld=1 "
				ELSE
					cSQL = cSQL + " SET cncld=0 "
				ENDIF
				cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL,'' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
						lReturn = .F.
					ENDIF
				ENDIF
				
				IF lReturn 
				
					PRIVATE nAmendment
					nAmendment = Get_Amendment_Sales_No( nSalesNum, ThisFormSet.nConnHandle)
					Track_Sales_No_Chng( "Late_SO-item.SO "+IIF(lCancel,"Cancel","UNCancel"), nSalesNum, .F., nAmendment )
				
					IF ThisFormSet.Load_Sales_NO(nSalesNum)
						IF ChooseSales_No.SalesNum = nSalesNum
							SELECT tmpSOitems
							LOCATE FOR Item = nItem
						ENDIF
					ENDIF
					ThisFormSet.RefreshScreen()
				ELSE	
					This.Value = NOT This.Value
				ENDIF
			ELSE	
				This.Value = NOT This.Value
			ENDIF
		ELSE
			MESSAGEBOX("Not allowed to change.",64,"Not Allowed")
			This.Value = NOT This.Value
		ENDIF
	ENDPROC

