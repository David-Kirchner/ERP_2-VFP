			ThisFormSet.frmSelect_SO_item.txtAlloy.Value	= ''
			ThisFormSet.frmSelect_SO_item.txtHeat.Value		= ''
			ThisFormSet.frmSelect_SO_item.txtDescript.Value	= ''
		
			ThisFormSet.frmSelect_SO_item.txtShipped.Value	= ''
			ThisFormSet.frmSelect_SO_item.txtWO.Value		= 0
			ThisFormSet.frmSelect_SO_item.txtWO_Detail.Value	= 0
		
			ThisFormSet.frmSelect_SO_item.chkCncld.Value	= .F.
			ThisFormSet.frmSelect_SO_item.chkCmplt.Value	= .F.
		
			ThisFormSet.frmSelect_SO_item.chkPrcp.Value	= .F.
			ThisFormSet.frmSelect_SO_item.chkPrcd.Value	= .F.
			ThisFormSet.frmSelect_SO_item.chkPckd.Value	= .F.
		
			*ThisFormSet.frmSelect_SO_item.chkIntP.Value	= .f.
		
			ThisFormSet.frmSelect_SO_item.chkShipOn.Value	= .F.
			ThisFormSet.frmSelect_SO_item.txtShipDue.Value	= ''
		
			ThisFormSet.frmSelect_SO_item.chkHold.Value = .F.
		
			ThisFormSet.frmSelect_SO_item.txtSalesP.Value = ''
		
			ThisFormSet.RefreshSOitem_Memo()
		ENDIF
	ENDPROC

	PROCEDURE refreshsoitem_memo
		*ThisForm.RefreshSOitem_Memo()
		ThisFormSet.Sales_Status.Visible = .F.
		ThisFormSet.rtr.Visible = .F.
		ThisFormSet.PackingSlip.Visible = .F.
		ThisFormSet.RMA_Detail.Visible = .F.
		ThisFormSet.frmSelect_SO_item.lblPOitem.Visible = .F.
		
		
		PRIVATE cSOitem
		IF USED('tmpSalesDescript')
			cSOitem = PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
		ELSE
			RETURN .F.
		ENDIF
		
		*****************
		IF USED("tmpSales_Status")
			ThisFormSet.Sales_Status.Grid1.RecordSource = ''
			USE IN tmpSales_Status
		ENDIF
		SELECT 0
		
		cSQL="SELECT SOitem,[when]"
		cSQL=cSQL+",CAST(Comment AS CHAR(250)) AS cComment "
		cSQL=cSQL+",Comment "
		cSQL=cSQL+" FROM dbo.Sales_Status WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL=cSQL+" ORDER BY [When] DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Status')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Status')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_Status")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_Status")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_Status' )
		ENDIF
		
		IF USED('tmpSales_Status')
			IF RECCOUNT('tmpSales_Status') > 0
				*tmpSOitems
				ThisFormSet.Sales_Status.Grid1.RecordSource = 'tmpSales_Status'
				ThisFormSet.Sales_Status.Visible = .T.
			ENDIF
		ENDIF
		
		
		*****************
		IF USED("tmpRTR")
			ThisFormSet.rtr.Grid1.RecordSource = ''
			USE IN tmpRTR
			
			ThisFormSet.frmSelect_SO_item.cmdSOrtr.Visible = .F.
		ENDIF
		SELECT 0
		
		cSQL="SELECT rtr.ID,rtr.SOitem, rtr.Started, rtr.Finished, rtr.Cncld "
		cSQL=cSQL+",rtr_Detail.StartDate"
		cSQL=cSQL+",CAST(rtr_Detail.Oper_Note AS CHAR(250)) AS OperNote"
		cSQL=cSQL+",rtr_Detail.Detail,rtr_Detail.FinishDate "
		cSQL=cSQL+" FROM dbo.rtr WITH(NOLOCK) "
		cSQL=cSQL+" INNER JOIN dbo.rtr_Detail ON rtr.ID = rtr_Detail.rtr_ID "
		cSQL=cSQL+" WHERE rtr.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*cSQL=cSQL+" INNER JOIN dbo.Sales S WITH(NOLOCK) ON rtr.SOitem = S.SOitem"
		*cSQL=cSQL+" WHERE S.SalesNum = "+STR(nSalesNum)
		cSQL=cSQL+" ORDER BY [ID] DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRTR')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRTR')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTR")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTR")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRTR' )
		ENDIF
		
		IF USED('tmpRTR')
			IF RECCOUNT('tmpRTR') > 0
				*tmpSOitems
				ThisFormSet.rtr.Grid1.RecordSource = 'tmpRTR'
				ThisFormSet.rtr.Visible = .T.
				ThisFormSet.frmSelect_SO_item.cmdSOrtr.Visible = .T.
			ENDIF
		ENDIF
		
		
		*****************
		IF USED("tmpPackingSlip")
			ThisFormSet.PackingSlip.Grid1.RecordSource = ''
			USE IN tmpPackingSlip
		ENDIF
		SELECT 0
		
		cSQL="SELECT * "
		cSQL=cSQL+" FROM dbo.PackingSlip WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL=cSQL+" ORDER BY [PackingSli] DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPackingSlip')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPackingSlip')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPackingSlip")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPackingSlip")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPackingSlip' )
		ENDIF
		
		IF USED('tmpPackingSlip')
			IF RECCOUNT('tmpPackingSlip') > 0
				ThisFormSet.PackingSlip.Grid1.RecordSource = 'tmpPackingSlip'
				ThisFormSet.PackingSlip.Visible = .T.
			ENDIF
		ENDIF
		
		
		
		*****************
		IF USED("tmpRMA_Detail")
			ThisFormSet.RMA_Detail.Grid1.RecordSource = ''
			USE IN tmpRMA_Detail
		ENDIF
		SELECT 0
		
		cSQL = " SELECT RTRIM(CAST(RMA_Detail.Reason AS CHAR(250))) AS cReason ,* "
		cSQL = cSQL + " FROM dbo.RMA_Detail WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.RMA WITH(NOLOCK) ON RMA_Detail.rma_no = RMA.rma_no "
		cSQL = cSQL + " WHERE RMA_Detail.SO_item = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRMA_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRMA_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRMA_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRMA_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRMA_Detail' )
		ENDIF
		
		IF USED('tmpRMA_Detail')
			IF RECCOUNT('tmpRMA_Detail') > 0
				*tmpSOitems
				ThisFormSet.RMA_Detail.Grid1.RecordSource = 'tmpRMA_Detail'
				ThisFormSet.RMA_Detail.Visible = .T.
			ENDIF
		ENDIF
		
		*****************
		
		
		IF USED("tmpPurchaseOrder")
			ThisFormSet.frmSelect_SO_item.txtPOitem.Value = ''
			ThisFormSet.frmSelect_SO_item.txtPOState.Value = ''
			USE IN tmpPurchaseOrder
		ENDIF
		SELECT 0
		
		cSQL="SELECT POitem "
		cSQL=cSQL+" ,( CASE when Delivered=1 then 'Delivered ' else '' end "
		cSQL=cSQL+" + CASE when Cmplt=1 then 'Complete ' else '' end "
		cSQL=cSQL+" + CASE when Cancelled=1 then 'Cancelled ' else '' end ) as [State]"
		cSQL=cSQL+" FROM dbo.PurchaseOrder WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPurchaseOrder')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
