				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPurchaseOrder' )
		ENDIF
		
		IF USED('tmpPurchaseOrder')
