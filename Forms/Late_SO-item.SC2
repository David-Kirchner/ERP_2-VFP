			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockInsert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockInsert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockInsert")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockInsert' )
		ENDIF
		
		IF USED('tmpStockInsert')
			IF RECCOUNT('tmpStockInsert') > 0
				*tmpSOitems
				ThisFormSet.frmStockInsert.Grid1.RecordSource = 'tmpStockInsert'
				ThisFormSet.frmStockInsert.Visible = .T.
			ENDIF
		ENDIF
		
		*****************
		ThisFormSet.Schedule.Visible = .F.
		
		IF USED("tmpSched")
			ThisFormSet.Schedule.Grid1.RecordSource = ''
			USE IN tmpSched
		ENDIF
		SELECT 0
		
		cSQL="SELECT  [ID]"
		cSQL=cSQL+",[Position]"
		cSQL=cSQL+",[Oper_ID]"
		cSQL=cSQL+",[WO_Detail]"
		cSQL=cSQL+",[SOitem]"
		cSQL=cSQL+",[POitem]"
		cSQL=cSQL+",[OnBoard]"
		cSQL=cSQL+",[InQue]"
		cSQL=cSQL+",[Closed]"
		cSQL=cSQL+",[OType_Num]"
		cSQL=cSQL+",[Sched_Type]"
		cSQL=cSQL+",[rtr_ID]"
		cSQL=cSQL+",[rtr_Detail]"
		cSQL=cSQL+",[LastTouch]"
		cSQL=cSQL+",[dateOnBoard]"
		cSQL=cSQL+",[dateInQue]"
		cSQL=cSQL+",[dateClosed]"
		cSQL=cSQL+" FROM Production WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL=cSQL+" ORDER BY [ID] DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSched')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSched')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSched")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSched")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSched' )
		ENDIF
		
		IF USED('tmpSched')
			IF RECCOUNT('tmpSched') > 0
				*tmpSOitems
				ThisFormSet.Schedule.Grid1.RecordSource = 'tmpSched'
				ThisFormSet.Schedule.Visible = .T.
			ENDIF
		ENDIF
		
		
		*****************
		
		
	ENDPROC

	PROCEDURE refresh_grdsoitems
		PRIVATE nSalesNum
		nSalesNum = ThisFormSet.frmSelect_SO_item.txtSalesNum.Value
		
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpSOitems")
			ThisFormSet.frmSelect_SO_item.grdItem.RecordSource = ''
			USE IN tmpSOitems
		ENDIF
		SELECT 0
		
		cSQL="SELECT Item"
		cSQL=cSQL+" FROM dbo.Sales WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SalesNum = "+STR(nSalesNum)
		cSQL=cSQL+" ORDER BY Item "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitems')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitems')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitems")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitems' )
		ENDIF
		
		IF USED('tmpSOitems')
			IF RECCOUNT('tmpSOitems') > 0
				*tmpSOitems
				ThisFormSet.frmSelect_SO_item.grdItem.RecordSource = 'tmpSOitems'
				
				********************************
				IF USED("tmpSalesDescript")
					USE IN tmpSalesDescript
				ENDIF
				SELECT 0
		
				cSQL="SELECT S.Item,S.Heat,S.ShipDue,S.Shipped,S.Cncld,S.Cmplt,S.pHeat "
				cSQL=cSQL+" ,ISNULL(S.Prcp,0) AS Prcp,S.Prcd,S.Pckd,S.ShipOn,ISNULL(S.WO,0) AS WO,ISNULL(S.WO_Detail,0) AS WO_Detail "
				cSQL=cSQL+" ,AQ.Alloy "
				cSQL=cSQL+" ,dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS Descript "
				cSQL=cSQL+" ,S.SOitem, S.Hold, S.IntP, AQ.SalesP "
				cSQL=cSQL+" FROM dbo.Sales S WITH(NOLOCK) "
				cSQL=cSQL+" INNER JOIN dbo.AllQuotes AQ ON AQ.SOitem = S.SOitem "
				cSQL=cSQL+" WHERE S.SalesNum = "+STR(nSalesNum)
		
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSalesDescript')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSalesDescript')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesDescript")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesDescript")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSalesDescript' )
				ENDIF
		
				IF USED('tmpSalesDescript')
					IF RECCOUNT('tmpSalesDescript') > 0
						SELECT tmpSalesDescript
						GO TOP
						ThisFormSet.frmSelect_SO_item.grdItem.Value = tmpSalesDescript.Item
						
						*ThisFormSet.RefreshScreenItem()
						
					ENDIF
				ENDIF
				******************************
				
			ENDIF
			*USE IN tmpSOitems
		ENDIF
		
		*****************
		IF USED("tmpSales_No_Chng")
			ThisFormSet.Sales_No_Chng.Visible = .F.
			ThisFormSet.Sales_No_Chng.Grid1.RecordSource = ''
			USE IN tmpSales_No_Chng
		ENDIF
		SELECT 0
		
		cSQL="SELECT [when]"
		*, LEFT(Body,10) AS C10"
		cSQL=cSQL+",CAST(Body AS CHAR(250)) AS cBody "
		cSQL=cSQL+", Body"
		cSQL=cSQL+" FROM dbo.Sales_No_Chng WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SalesNum = "+STR(nSalesNum)
		cSQL=cSQL+" ORDER BY [When] DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_No_Chng')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_No_Chng')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_No_Chng")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_No_Chng")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_No_Chng' )
		ENDIF
		
		IF USED('tmpSales_No_Chng')
			IF RECCOUNT('tmpSales_No_Chng') > 0
				*tmpSOitems
				ThisFormSet.Sales_No_Chng.Grid1.RecordSource = 'tmpSales_No_Chng'
				ThisFormSet.Sales_No_Chng.Visible = .T.
			ENDIF
		ENDIF
		
		*****************
		IF USED("tmpSales_No_Rev")
			ThisFormSet.Sales_No_Rev.Grid1.RecordSource = ''
			ThisFormSet.Sales_No_Rev.Visible = .F.
			USE IN tmpSales_No_Rev
		ENDIF
		SELECT 0
		
		cSQL="SELECT Ver,[when]"
		cSQL=cSQL+",CAST(Comment AS CHAR(250)) AS cComment "
		cSQL=cSQL+", Comment"
		cSQL=cSQL+" FROM dbo.Sales_No_Rev WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SalesNum = "+STR(nSalesNum)
		cSQL=cSQL+" ORDER BY [When] DESC "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_No_Rev')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_No_Rev')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_No_Rev")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_No_Rev")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_No_Rev' )
		ENDIF
		
		IF USED('tmpSales_No_Rev')
			IF RECCOUNT('tmpSales_No_Rev') > 0
				*tmpSOitems
				ThisFormSet.Sales_No_Rev.Grid1.RecordSource = 'tmpSales_No_Rev'
				ThisFormSet.Sales_No_Rev.Visible = .T.
			ENDIF
		ENDIF
		
		
		*****************
		ThisFormSet.RefreshScreenItem()
	ENDPROC

