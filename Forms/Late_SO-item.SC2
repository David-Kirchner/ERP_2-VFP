			ThisFormSet.frmSelect_SO_item.chkPrcd.Value	= PrepareSQLchk(tmpSalesDescript.Prcd,'Prcd')
			ThisFormSet.frmSelect_SO_item.chkPckd.Value	= PrepareSQLchk(tmpSalesDescript.Pckd,'Pckd')
		
			*ThisFormSet.frmSelect_SO_item.chkIntP.Value	= PrepareSQLchk(tmpSalesDescript.IntP,'IntP')
		
			ThisFormSet.frmSelect_SO_item.chkShipOn.Value	= PrepareSQLchk(tmpSalesDescript.ShipOn,'ShipOn')
			ThisFormSet.frmSelect_SO_item.txtShipDue.Value	= tmpSalesDescript.ShipDue
		
