		*ThisForm.Release
		
	ENDPROC

	PROCEDURE frmSelect_SO_item.cmdCancelEdit.Click
		IF This.Caption = "Cancel"
			*place in ReadOnly mode, refresh data
			
			ThisForm.txtShipDue.Enabled = .F.
			ThisForm.cmdEditDate.Caption = "Edit"
			This.Caption = "Return"
			This.Visible = .F.
		ELSE
		
			ThisForm.cmdEditDate.Caption = "Edit"
		
			*ThisForm.Visible = .F.
		ENDIF
	ENDPROC

