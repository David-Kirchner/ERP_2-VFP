		ThisFormSet.Load_Sales_NO()
	ENDPROC

	PROCEDURE frmSelect_SO_item.chkFLate.Click
		ThisFormSet.Load_Sales_NO()
	ENDPROC

	PROCEDURE frmSelect_SO_item.chkfOnHold.Click
