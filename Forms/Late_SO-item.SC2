	PROCEDURE frmSelect_SO_item.chkCmplt.Click
		
		PRIVATE lComplete
		lComplete = PrepareSQLlogic( This.Value, 'Cancel',.F.)
		
		PRIVATE cSOitem, nSalesNum, nItemSO
		cSOitem 	= PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		nItem  		= PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',2,0)
		
		IF HavePermission('CompleteSO') OR HavePermission('EditSOLate')
			IF lComplete 
				IF MESSAGEBOX("Are you sure you want to COMPLETE SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Complete ?") = 6
					*
					IF Mark_SOitem_Cmplt(cSOitem, ThisFormSet.nConnHandle, .F.) &&Default to .F. on UNMark, then MARK complete
						Save_SOitem_Status( cSOitem, nSalesNum, 'Complete', 'Select_SO-Item:Mark SO-Item as Complete', ThisFormSet.nConnHandle )
						REPLACE Cmplt WITH .T. IN tmpSalesDescript
						
						IF ThisFormSet.Load_Sales_NO(nSalesNum)
							IF ChooseSales_No.SalesNum = nSalesNum
								SELECT tmpSOitems
								LOCATE FOR Item = nItem
							ENDIF
						ENDIF
						
						ThisFormSet.RefreshScreen()
						
					ENDIF
				ELSE
					This.Value = IIF(lComplete,0,1)
					RETURN .F.
				ENDIF
			ELSE
				IF MESSAGEBOX("Are you sure you want to UN-Complete SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Not Complete?") = 6
					*
					IF Mark_SOitem_Cmplt(cSOitem, ThisFormSet.nConnHandle, .T.) &&T for Un Mark
						Save_SOitem_Status( cSOitem, nSalesNum, 'UNComplete', 'Select_SO-Item:Mark as UnComplete SO-Item', ThisFormSet.nConnHandle )
						REPLACE Cmplt WITH .F. IN tmpSalesDescript
		
						IF ThisFormSet.Load_Sales_NO(nSalesNum)
							IF ChooseSales_No.SalesNum = nSalesNum
								SELECT tmpSOitems
								LOCATE FOR Item = nItem
							ENDIF
						ENDIF
						
						ThisFormSet.RefreshScreen()
						
					ENDIF
				ELSE
					This.Value = IIF(lComplete,0,1)
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("You do not have Permission to Complete this SO",0+48,"Not Allowed to change!")
			This.Value = IIF(lComplete,0,1)
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE frmSelect_SO_item.chkCncld.Click
		
		PRIVATE lCancel
		lCancel = PrepareSQLlogic( This.Value, 'Cancel',.F.)
		
		PRIVATE cSOitem, nSalesNum, nItemSO
		cSOitem 	= PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		nItem  		= PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',2,0)
		
		IF NOT ( HavePermission('CompleteSO') OR HavePermission('EditSOLate') )
			*Allow is same SalesRep
			PRIVATE cSalesP,cSalesPlogin
			cSalesP = PrepareSQLtxt(ThisForm.txtSalesP.Value,'SalesP',1)
			cSalesPlogin = AppSetup_Login_SalesP()
			IF NOT cSalesP==cSalesPlogin
				MESSAGEBOX("Your Login does not match the SalesRep '"+cSalesP+"'"+CHR(13)+"You do not have Permision to change SOitem '"+cSOitem +"'.",0,"Not Allowed.")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Your Login does not match the SalesRep '"+cSalesP+"'"+CHR(13)+"You do not have Permision to change SOitem '"+cSOitem +"'.") 
				RETURN .F.
			ENDIF
		ENDIF
		
		IF lCancel 
			*Check to see if Shipped!
			IF NOT SOitem_PRCD(cSOitem, ThisFormSet.nConnHandle) 
			
				*Check for PO
				PRIVATE nCntPOitem 
				nCntPOitem = 0
		
			*	nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnHandle )
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				SELECT 0
				cSQL = "SELECT COUNT(poItem) AS CNTD FROM dbo.PurchaseOrder WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL + " AND [cancelled] = 0"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF tmpPOp.CNTD > 0
						nCntPOitem = tmpPOp.CNTD
					ENDIF
					USE IN tmpPOp
				ENDIF
		
				IF nCntPOitem > 0
					MESSAGEBOX( "Found "+ALLTRIM(STR(nCntPOitem))+" Purchase Order item"+IIF(nCntPOitem>1,"s","")+" for this Sales Order item."+CHR(13)+;
					  "Check to see if this PO needs to be cancelled also."+;
					  "These cannot be automatically cancelled, you must check yourself!",0,"Item is still on Order!")
					  
					  *PurchaseOrder_POitem_Cancel( cPOitem, ThisFormSet.nConnHandle )
				ENDIF
				
				***********************
				
				IF MESSAGEBOX("Are you sure you want to Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Cancel?") = 6
					*Cancel SO Item
					IF Cancel_SOitem( cSOitem, .T., ThisFormSet.nConnHandle )	&& .T. to Amend Ver
						REPLACE cncld WITH .T. IN tmpSalesDescript
						
						IF ThisFormSet.Load_Sales_NO(nSalesNum)
							IF ChooseSales_No.SalesNum = nSalesNum
								SELECT tmpSOitems
								LOCATE FOR Item = nItem
							ENDIF
						ENDIF
						
						ThisFormSet.RefreshScreen()
					ENDIF
				ELSE
					This.Value = IIF(lCancel,0,1)
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
		
			IF HaveSODeletePermission(nSalesNum)
				IF MESSAGEBOX("Are you sure you want to UN-Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"UN-Cancel?") = 6
					IF UNCancel_SOitem( cSOitem, .T., ThisFormSet.nConnHandle )
						REPLACE cncld WITH .F. IN tmpSalesDescript
						MESSAGEBOX("Not Programmed!",0+48,"No change!")
						*TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" EditOrder.chkCancelItem.Click()" )
						
						IF ThisFormSet.Load_Sales_NO(nSalesNum)
							IF ChooseSales_No.SalesNum = nSalesNum
								SELECT tmpSOitems
								LOCATE FOR Item = nItem
							ENDIF
						ENDIF
						lOK = Save_SOitem_Status( cSOitem, nSalesNum, "UNCancel", "UNCancel from Late_SO-items screen.", ThisFormSet.nConnHandle )
					ENDIF
					ThisFormSet.RefreshScreen()
				ELSE
					This.Value = IIF(lCancel,0,1)
					RETURN .F.
				ENDIF
			ELSE
				MESSAGEBOX(cMess,0+48,"Not Allowed to change now!")
				This.Value = IIF(lCancel,0,1)
				RETURN .F.
			ENDIF
		
		ENDIF
		
	ENDPROC

