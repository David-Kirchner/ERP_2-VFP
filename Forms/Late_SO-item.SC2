	PROCEDURE frmSelect_SO_item.txtSalesNum.Click
		*ThisFormSet.SalesHistory()
		PRIVATE nID,nID_Detail,nSalesNum
		nID = 0
		nID_Detail = 0
		nSalesNum = PrepareSQLnum(This.Value,'SalesNum',-3)
		
		
		
		WAIT WINDOW "Look for a blinking Internet Explorer to read report!" NOWAIT
		PRIVATE loHyperlink
		loHyperlink = Createobject("Hyperlink")
		
		*cHTTP = "https://"+cSQLServer+":1443/Reports/Pages/Report.aspx?ItemPath=%2fPrice+table%2fStock+that+is+more+than+PriceTable"
		*cHTTP =  get_Report_Server()+"ItemPath=%2fPrice+table%2fStock+that+is+more+than+PriceTable"
		*cHTTP =  get_Report_Server()+"%2FHPA%20Sales%20Reports%2FSales%20and%20Purchase%20Orders%20Late&rs%3AParameterLanguage=en-US"
		cHTTP = HTML_SO(nSalesNum,.T.)
		loHyperlink.NavigateTo( cHTTP )
		RELEASE loHyperlink
		
	ENDPROC

	PROCEDURE frmSelect_SO_item.txtSalesOrder.Valid
		IF !EMPTY(THIS.Value)
			*ThisForm.cmdFind.Click
			SELECT ChooseSales_No
			*SEEK THIS.Value ORDER SalesNum
			PRIVATE nSO 
			nSO = PrepareSQLnum(This.Value,'SalesNum',-3)
			LOCATE FOR SalesNum = nSO 
			IF !FOUND()
			
				PRIVATE lLate, lcmplt, lOnHold
				lLate = PrepareSQLlogic(ThisFormSet.frmSelect_SO_item.chkFLate.Value,'Late')
				lOnHold	= PrepareSQLlogic(ThisFormSet.frmSelect_SO_item.chkFOnHold.Value,'HOLD')
				lcmplt = PrepareSQLlogic(ThisFormSet.frmSelect_SO_item.chkFcmplt.Value,'CMPLT')
		
				PRIVATE cMess 
				cMess = "SO "+ALLTRIM(STR(nSO))+" was not Found to show!"+CHR(13)
				cMess = cMess +"This will not be shown in the current records set."+CHR(13)
				IF lLate
					cMess = cMess +"FILTER is set to Late."+CHR(13)
				ENDIF
				IF lOnHold
					cMess = cMess +"FILTER is set to On Hold."+CHR(13)
				ENDIF
				IF lcmplt 
					cMess = cMess +"FILTER is set to Complete AND Cancelled."+CHR(13)
				ENDIF
				MESSAGEBOX(cMess,0,"No SO")
				GO BOTTOM
				THIS.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
		*	ThisForm.grdSales_No.Refresh()
		*	ThisForm.grdSales_No.SetFocus
			ThisFormSet.RefreshScreen()
			*ThisForm.RefreshScreen()
			ThisForm.grdSales_No.Refresh()
			ThisForm.grdSales_No.clmSO.Refresh()
		ENDIF
	ENDPROC

	PROCEDURE frmSelect_SO_item.Unload
		ThisFormSet.Release
		
	ENDPROC

