	PROCEDURE frmSelect_SO_item.cmdEditDate.Click
		IF This.Caption = "Edit"
			IF NOT PrepareSQLlogic(ThisForm.chkCmplt.Value,'Complete',.F.)
				*Put in edit Mode
				ThisForm.txtShipDue.Enabled = .T.
				This.Caption = "Save"
				ThisForm.cmdCancelEdit.Caption = "Exit"
				ThisForm.cmdCancelEdit.Visible = .T.
			ELSE
				WAIT WINDOW "Already Delivered" NOWAIT
			ENDIF
		ELSE
			*Save and set Read only.
			PRIVATE cSOitem
			cSOitem = PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
			PRIVATE nSalesNum
			nSalesNum = PrepareSQLnum(ThisFormSet.frmSelect_SO_item.txtSalesNum.Value,'SalesNum',-3)
			
			****************************************
			PRIVATE cSQL2, cSQL, nSQLEXEC 
			cSQL2 = ''
			
			PRIVATE dHPA_Date_Update
			dHPA_Date_Update = PrepareSQLdate(ThisForm.txtShipDue.Value,'ShipDue')  &&,.F.,.T.
			
			cSQL = "UPDATE dbo.Sales "
			cSQL = cSQL + " SET ShipDue = '"+DTOC(dHPA_Date_Update)+"'" 
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'')
			ELSE
				TrackMess( cSQL +" in SalesOreder_Select, Edit due date." )
			ENDIF
			
			****************************************
			
			cSQL = "UPDATE dbo.Sales_No "
			cSQL = cSQL + " SET amendment = amendment+1"
			cSQL = cSQL + ",ShopRecv = 0"
			cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
			cSQL = cSQL + " AND Changing = 0 "
			cSQL = cSQL + " AND cmplt = 0 "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,'')
			ELSE
				PRIVATE nAmendment
				nAmendment = Get_Amendment_Sales_No( nSalesNum, ThisFormSet.nConnHandle)
				Track_Sales_No_Chng( "Late_SO-item.EditDate", nSalesNum, .F., nAmendment )
				
				*TrackMess( cSQL +" in SalesOreder_Select, Edit due date." )
				MESSAGEBOX("This will Require a reprint"+CHR(13)+"Please goto 'SO Edit' and Print",0,"Must Reprint")
				Save_SOitem_Status( cSOitem, VAL(cSOitem), 'ShipDue', "Changed Ship Due Date to "+DTOC(dHPA_Date_Update)+" in Select SO-item", ThisFormSet.nConnHandle)
			ENDIF
			
			****************************************
			ThisForm.grdItem.Refresh
			ThisForm.txtShipDue.Enabled = .F.
			This.Caption = "Edit"
			*ThisForm.cmdCancelEdit.Caption = "Cancel"
			ThisForm.cmdCancelEdit.Visible = .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmSelect_SO_item.cmdEditHoldStatus.Click
		*ThisFormSet.SalesHistory()
		IF NOT USED('tmpSalesDescript')
			MESSAGEBOX("Lost Table 'tmpSalesDescript'",0,"Cannot Continue")
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE nSalesNum,cSOitem
		cSOitem 	= PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		
		IF nSalesNum > 0
			DO FORM Forms\SOitem_Status WITH cSOitem,ThisFormSet.nConnHandle
			
			ThisFormSet.Refresh_grdSOitems()
			*ThisForm.RefreshScreenItem() called in Refresh_grdSOitems()
		ENDIF
	ENDPROC

	PROCEDURE frmSelect_SO_item.cmdFind.Click
		IF ThisForm.txtSalesOrder.Value > 0
			SELECT ChooseSales_No
			*SEEK ThisForm.txtSalesOrder.Value ORDER SalesNum
			PRIVATE nSO 
			nSO = PrepareSQLnum(ThisForm.txtSalesOrder.Value,'SalesNum',-3)
			
			LOCATE FOR SalesNum = nSO
			IF !FOUND()
				PRIVATE cMess 
				cMess = "SO "+ALLTRIM(STR(nSO))+" was not Found to show!"+CHR(13)
				cMess = cMess +"This will not be shown in the current records set."+CHR(13)
				MESSAGEBOX(cMess,0,"No SO")
				GO BOTTOM
				ThisForm.txtSalesOrder.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
			ThisForm.grdSales_No.Refresh
			ThisFormSet.RefreshScreen()
			
			*ThisForm.grdSales_No.clmSO.SetFocus()
			ThisForm.grdItem.SetFocus()
			
		ELSE
			WAIT WINDOW "Enter Number to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

