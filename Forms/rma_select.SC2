	ADD OBJECT 'txtSearch' AS textbox WITH ;
		Alignment = 3, ;
		Height = 23, ;
		InputMask = "999999", ;
		Left = 252, ;
		MaxLength = 6, ;
		Name = "txtSearch", ;
		SelectOnEntry = .T., ;
		TabIndex = 2, ;
		Top = 13, ;
		Value = 0, ;
		Width = 132
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		IF USED('tmpQuotes')
			USE IN tmpQuotes
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pnSO
		*DO FORM Forms\RMA_Select WITH nSalesNum
		
		ThisForm.cmbSWhere.Value = "Sales Order"
		ThisForm.cReturnKey=''
		ThisForm.txtSearch.SetFocus
		
		IF TYPE("pnSO")= "N"
			IF pnSO > 0
				ThisForm.txtSearch.Value = ALLTRIM(STR(pnSO))
				ThisForm.cmdSearch.Click
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		PRIVATE cSQL,nSQLExec
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		SELECT 0
		cSQL = "SELECT Company,Name,po_Num,Alloy,Form,Pieces,Thck,Sz2,Sz3,weight,Descript,' ' AS comment,inqdate,SalesP,SalesNum,SoItem,SaleDate FROM DBO.AllQuotes WHERE 1 <> 1"
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle)
		ENDIF
			
		
			
	ENDPROC

	PROCEDURE Unload
		
		RETURN This.cReturnKey
	ENDPROC

	PROCEDURE cmbSWhere.InteractiveChange
		DO CASE
		CASE This.Value = "Sales Order" 
			ThisForm.txtSearch.Value = 0
			ThisForm.txtSearch.InputMask = "99999"
			ThisForm.txtSearch.MaxLength = 6
		CASE This.Value = "Customers PO"
			ThisForm.txtSearch.Value = ""
			ThisForm.txtSearch.InputMask = ""
			ThisForm.txtSearch.MaxLength = 17
		CASE This.Value = "Company Name"
			ThisForm.txtSearch.Value = ""
			ThisForm.txtSearch.InputMask = ""
			ThisForm.txtSearch.MaxLength = 30
		CASE This.Value = "Packing Slip Number"
			ThisForm.txtSearch.Value = 0
			ThisForm.txtSearch.InputMask = "999999"
			ThisForm.txtSearch.MaxLength = 6
		ENDCASE
		ThisForm.txtSearch.Refresh
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdReturn.Click
		SELECT tmpQuotes
		GO TOP
		PRIVATE lFoundDel
		lFoundDel = .F.
		
		SCAN
			IF DELETED('tmpQuotes')
				lFoundDel = .T.
				IF EMPTY(ThisForm.cReturnKey)
					ThisForm.cReturnKey = tmpQuotes.soItem
				ELSE
					ThisForm.cReturnKey = ThisForm.cReturnKey + ";" + tmpQuotes.soItem
				ENDIF
			ENDIF
		ENDSCAN
		
		IF NOT lFoundDel
			MESSAGEBOX("No records found marked to return!"+CHR(13)+"Use Cancel if you do not wont any records returned.")
			RETURN
		ELSE	
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE cmdSearch.Click
		PRIVATE vSearchFor, cSQL
		vSearchFor = ThisForm.txtSearch.Value
		
		PRIVATE cSearchFor, vSearchFor
		
		IF EMPTY(ThisForm.txtSearch.Value)
			MESSAGEBOX("Nothing to Search for!",0,"Empty")
			RETURN .F.
		ENDIF
		
		IF TYPE("vSearchFor") = "N"
			cSearchFor = ALLTRIM(STR(vSearchFor))
		ELSE
			cSearchFor = ALLTRIM(vSearchFor)
		ENDIF
		
		ThisForm.grdSQL.RecordSource = ""
		
		cSQL = "SELECT Company,Name,po_Num,Alloy,Form,Pieces,Thck,Sz2,Sz3,weight,Descript,'' AS comment,inqdate,SalesP,SalesNum,SoItem,SaleDate FROM DBO.AllQuotes  "
		
		DO CASE
		CASE ThisForm.cmbSWhere.Value = "Sales Order" 
			IF VAL(cSearchFor) > 0
				cSQL = cSQL + "WHERE SalesNum = "+ cSearchFor
			ELSE
				MESSAGEBOX("Need a number to search SalesNum",0+48,'Error')
				cSQL = cSQL + "WHERE SalesNum = 0"
			ENDIF
		CASE ThisForm.cmbSWhere.Value = "Customers PO"
			
			cSQL = cSQL + "WHERE PO_Num = '" + cSearchFor + "'"
			
		CASE ThisForm.cmbSWhere.Value = "Company Name"
			
			cSQL = cSQL + "WHERE Company LIKE '%" + cSearchFor + "%'"
			
		*CASE ThisForm.cmbSWhere.Value = "Packing Slip Number"
			
		ENDCASE
		
		IF USED('tmpQuotes')
			USE IN tmpQuotes
		ENDIF
		SELECT 0
		cSQL = cSQL + " ORDER BY SaleDate DESC"
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle)
		ENDIF
			
		ThisForm.grdSQL.RecordSource = "tmpQuotes"
			
	ENDPROC

	PROCEDURE txtSearch.Valid
		IF !EMPTY(THIS.Value)
			ThisForm.cmdSearch.Click()
		ENDIF
	ENDPROC

ENDDEFINE
