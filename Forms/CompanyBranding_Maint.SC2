DEFINE CLASS frmcompanybranding_maint AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="lblTitle" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblPath" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="imgPreview" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdRefresh" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdEditProfile" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdClose" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: refreshpreview
		*p: lskipcompanybranding
	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth.ico
		AutoCenter = .T.
		Caption = "Company Logo (Reports)"
		DoCreate = .T.
		Height = 280
		lskipcompanybranding = .T.
		Name = "frmCompanyBranding_maint"
		Width = 420
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdClose' AS commandbutton WITH ;
		Cancel = .T., ;
		Caption = "Close", ;
		Height = 27, ;
		Left = 300, ;
		Name = "cmdClose", ;
		Top = 232, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdEditProfile' AS commandbutton WITH ;
		Caption = "Company Profile...", ;
		Height = 27, ;
		Left = 160, ;
		Name = "cmdEditProfile", ;
		Top = 232, ;
		Width = 120
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdRefresh' AS commandbutton WITH ;
		Caption = "Refresh cache", ;
		Height = 27, ;
		Left = 16, ;
		Name = "cmdRefresh", ;
		Top = 232, ;
		Width = 120
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'imgPreview' AS image WITH ;
		BorderStyle = 1, ;
		Height = 120, ;
		Left = 16, ;
		Name = "imgPreview", ;
		Picture = "", ;
		Stretch = 1, ;
		Top = 68, ;
		Width = 360
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'lblPath' AS label WITH ;
		AutoSize = .F., ;
		Caption = "", ;
		Height = 17, ;
		Left = 16, ;
		Name = "lblPath", ;
		Top = 44, ;
		Width = 380
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblTitle' AS label WITH ;
		AutoSize = .T., ;
		Caption = "Company BMP used by FRX (MEM\Company_BMP.bmp):", ;
		Height = 17, ;
		Left = 16, ;
		Name = "lblTitle", ;
		Top = 16, ;
		Width = 300
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Init
		This.RefreshPreview()
	ENDPROC

	PROCEDURE Load
		LOCAL lcRoot
		lcRoot = ADDBS(SYS(5) + SYS(2003))
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\proc_setup.prg") ADDITIVE
		ENDIF
		IF NOT "COMPANY_BRANDING" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\company_branding.prg") ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE RefreshPreview
		LOCAL lcPath
		= CacheCompanyReportBmpFile(0, .T.)
		lcPath = GetCompanyBmpPath()
		This.imgPreview.Picture = lcPath
		This.lblPath.Caption = IIF(EMPTY(lcPath), "(no Company BMP — upload via Company Profile)", lcPath)
	ENDPROC

	PROCEDURE cmdClose.Click
		Thisform.Release()
	ENDPROC

	PROCEDURE cmdEditProfile.Click
		DO PROGS\CompanyProfile_maint
	ENDPROC

	PROCEDURE cmdRefresh.Click
		This.RefreshPreview()
		MESSAGEBOX("Logo cache refreshed.", 64, "Company Branding")
	ENDPROC

ENDDEFINE
