	PROCEDURE viewsalesall
		*ThisForm.ViewSalesAll()
		PRIVATE cSalesWhere
		cSalesWhere = " 0=0 "
		*This.parent.parent.pgView.grdSales.RECORDSOURCE = ''
		ThisForm.pgfAll.pgView.grdSales.RECORDSOURCE = ''
		
		IF USED('FilterSales')
			USE IN FilterSales
		ENDIF
		SELECT 0
		
		*Also Change in INIT
		cSQL = "SELECT Sales.soitem, Sales.shipdue, Sales.shipped, Sales.cncld, Sales.cmplt, Sales.PT_Total"
		*cSQL = cSQL +" ,CAST(LEFT(Sales.soitem,7) AS INT) AS SalesNum "
		cSQL = cSQL +" ,Allquotes.company, Allquotes.salesp, Allquotes.Alloy, AllQuotes.SalesNum "
		cSQL = cSQL +" FROM dbo.Sales WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AllQuotes WITH(NOLOCK) ON Sales.SOitem = Allquotes.SOitem "
		cSQL = cSQL + " WHERE LEN(Sales.soitem) > 0"
		*cSQL = cSQL + "WHERE !EMPTY(Sales.soitem) "
		*cSQL = cSQL +" NOCONSOLE INTO CURSOR Sales"
		cSQL = cSQL +" ORDER BY Sales.SOitem"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FilterSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FilterSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'FilterSales')
		ENDIF
		
		ThisForm.pgfAll.pgTotals.edtvSalesWhere.Value = cSalesWhere
		
		IF USED('FilterSales')
			SELECT FilterSales
			ThisForm.pgfAll.pgView.grdSales.RECORDSOURCE = 'FilterSales'
			ThisForm.pgfAll.pgView.grdSales.REFRESH
			*This.parent.parent.pgView.grdSales.RECORDSOURCE = 'Sales'
			*THIS.PARENT.PARENT.pgView.grdSales.REFRESH
			ThisForm.RefreshView()
			ThisForm.vSalesFiltered = .T.
		ENDIF
		
	ENDPROC

	PROCEDURE pgfAll.pgSearch.chkAlloy.Click
		IF This.Value = 1
		
			This.Parent.cmbAlloy.ColumnCount = 0
			This.Parent.cmbAlloy.RowSourceType = 0
		
		
			IF USED('tmpAlloySales')
				USE IN tmpAlloySales
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT DISTINCT Allquotes.Alloy FROM dbo.Sales  WITH(NOLOCK)"
			cSQL = cSQL + " LEFT OUTER JOIN dbo.Allquotes WITH(NOLOCK) ON Sales.SOitem = Allquotes.SOitem WHERE "
			cSQL = cSQL + " LEN(Sales.SoItem)>0 "
			cSQL = cSQL + " AND LEN(Allquotes.Alloy)>0 "
			IF THIS.PARENT.cmbYear.VALUE = "Not"
				cSQL = cSQL + " AND ( Sales.Shipped=>'01/01/2000' )"
			ELSE
				*SELECT DISTINCT Allquotes.Alloy FROM HPA!Sales LEFT OUTER JOIN hpa!allquotes 
				*ON Sales.soitem = Allquotes.soitem WHERE !EMPTY(Sales.SoItem) AND !EMPTY(Allquotes.Alloy) 
				*AND YEAR(Sales.Shipped)=VAL(THIS.PARENT.cmbYear.VALUE) ORDER BY AllQuotes.Alloy INTO ARRAY aUalloy
				vYear = THIS.PARENT.cmbYear.VALUE
				IF VARTYPE(vYear) = "C"
					cYear = vYear
				ELSE
					IF VARTYPE(vYear) = "N"
						cYear = STR(vYear)
					ELSE
						cYear = STR(YEAR(DATE()))
					ENDIF
				ENDIF
				cSQL = cSQL + " AND YEAR(Sales.Shipped)='"+cYear+"'"
			ENDIF
			cSQL = cSQL + " ORDER BY AllQuotes.Alloy "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloySales')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloySales')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloySales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloySales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpAlloySales')
			ENDIF
			IF USED('tmpAlloySales')
				SELECT Alloy FROM tmpAlloySales ORDER BY Alloy INTO ARRAY aUalloy
				USE IN tmpAlloySales
			ENDIF
			
			
			This.Parent.cmbAlloy.RowSource = "aUalloy"
			This.Parent.cmbAlloy.RowSourceType = 5
			This.Parent.cmbAlloy.NumberOfElements =ALEN(aUalloy)
			This.Parent.cmbAlloy.ColumnCount = 1
			This.Parent.cmbAlloy.ColumnWidths = "50"
			This.Parent.cmbAlloy.Value = aUalloy(1)
			This.Parent.cmbAlloy.Enabled = .T.
		ELSE
			This.Parent.cmbAlloy.Enabled = .F.
			DIMENSION aUalloy[1]
			aUalloy(1) = "Not Selected"
		
		ENDIF
		ThisForm.vSalesFiltered= .F.
	ENDPROC

	PROCEDURE pgfAll.pgSearch.chkCompany.Click
		IF This.Value = 1
		
			This.Parent.cmbCompany.ColumnCount = 0
			This.Parent.cmbCompany.RowSourceType = 0
			IF USED("company_AllquotesSales")
				SELECT company_AllquotesSales
			ELSE
				SELECT 0
			ENDIF
			
			PRIVATE cSalesP
			cSalesP = This.parent.cmbAllEmployees.Value
			IF cSalesP = '*'
				cSalesP = ""
			ENDIF
			
			IF THIS.PARENT.cmbYear.VALUE = "Not"
				*SELECT DISTINCT Allquotes.company FROM HPA!Sales LEFT OUTER JOIN hpa!allquotes ON Sales.soitem = Allquotes.soitem WHERE !EMPTY(Sales.SoItem) AND !EMPTY(Allquotes.company) AND Sales.Shipped=CTOD('  /  /  ') ORDER BY AllQuotes.Company INTO ARRAY aUCompany
				cSQL = "SELECT DISTINCT Allquotes.company FROM dbo.Allquotes "
				cSQL = cSQL + " WHERE Allquotes.SalesNum>0 AND LEN(Allquotes.company)>0"
		*		cSQL = cSQL + " AND Sales.Shipped > '1900' " 
				IF NOT EMPTY(cSalesP)
					cSQL = cSQL + " AND Allquotes.SalesP = '"+cSalesP+"'"
				ENDIF
				cSQL = cSQL + " ORDER BY AllQuotes.Company "
			ELSE
				*SELECT DISTINCT Allquotes.company FROM HPA!Sales LEFT OUTER JOIN hpa!allquotes ON Sales.soitem = Allquotes.soitem WHERE !EMPTY(Sales.SoItem) AND !EMPTY(Allquotes.company) AND YEAR(Sales.Shipped)=VAL(THIS.PARENT.cmbYear.VALUE) ORDER BY AllQuotes.Company INTO ARRAY aUCompany
				cSQL = "SELECT DISTINCT Allquotes.company FROM dbo.Sales WITH(NOLOCK) "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.allquotes WITH(NOLOCK) ON Sales.soitem = Allquotes.soitem "
				cSQL = cSQL + " WHERE LEN(Sales.SoItem)>0 AND LEN(Allquotes.company)>0 "
				cSQL = cSQL + " AND YEAR(Sales.Shipped)="+STR(VAL(THIS.PARENT.cmbYear.VALUE))
				IF NOT EMPTY(cSalesP)
					cSQL = cSQL + " AND Allquotes.SalesP = '"+cSalesP+"'"
				ENDIF
				cSQL = cSQL + " ORDER BY AllQuotes.Company "
			ENDIF
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'company_AllquotesSales')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'company_AllquotesSales')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "company_AllquotesSales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "company_AllquotesSales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'company_AllQuotesSales')
			ENDIF
			IF USED('company_AllquotesSales')
				SELECT * FROM Company_AllquotesSales INTO ARRAY aCompany_AllquotesSales
				USE IN Company_AllquotesSales
			ENDIF	
		
			
			*This.Parent.cmbCompany.RowSource = "Company_AllquotesSales"
			This.Parent.cmbCompany.RowSource = "aCompany_AllquotesSales"
			*This.Parent.cmbCompany.RowSourceType = 2
			This.Parent.cmbCompany.RowSourceType = 5
			*This.Parent.cmbCompany.NumberOfElements = RECCOUNT(Company_AllquotesSales)
			This.Parent.cmbCompany.NumberOfElements = ALEN(aCompany_AllquotesSales,1)
			This.Parent.cmbCompany.ColumnCount = 1
			This.Parent.cmbCompany.ColumnWidths = "100"
			*This.Parent.cmbCompany.Value = Company_AllquotesSales.Company
			This.Parent.cmbCompany.Value = aCompany_AllquotesSales(1,1)
			This.Parent.cmbCompany.Enabled = .T.
			This.Parent.cmbCompany.Refresh
		ELSE
			This.Parent.cmbCompany.Enabled = .F.
		
		ENDIF
		ThisForm.vSalesFiltered= .F.
	ENDPROC

