	PROCEDURE pgfAll.pgTotals.Click
		This.txtQ_Total.Value = 0
		This.txtPS_Total.Value = 0
		THIS.txtStkCost.VALUE = 0
		THIS.txtPOCost.VALUE = 0
		
		*THIS.txtCost.VALUE = 0
		THIS.txtSale.VALUE = 0
		THIS.txtProfit.VALUE = 0
		THIS.txtPounds.VALUE = 0
		THIS.txtAveCost.VALUE = 0
		THIS.txtAveSale.VALUE = 0
		THIS.txtOrderItems.VALUE = 0
		
		
		IF NOT THISFORM.vSalesFiltered
			IF MESSAGEBOX( "Do you want to see ALL records?"+CHR(13)+"Click Filter first to see a filtered subset!",4+48,"Too many records.") = 6
				ThisForm.ViewSalesAll()
			ENDIF
		ENDIF
		
		
		IF THISFORM.vSalesFiltered
		
		
		*!*		DIMENSION aSalesSalesP[1,3]
		*!*		IF This.Parent.pgSearch.cmbAllEmployees.Value = "*"
		*!*			This.lstSalesSalesP.RowSource = ""
		*!*			
		*!*			SELECT allquotes.SalesP AS S, SUM(Sales.ItemSale) AS Sales, SUM(Sales.ItemCost) AS Cost ;
		*!*				FROM HPA!Sales LEFT OUTER JOIN HPA!allquotes ON Sales.soitem = allquotes.soitem ;
		*!*				WHERE &ThisForm.SalesWhere AND !EMPTY(AllQuotes.SalesP) ORDER BY Sales GROUP BY SalesP INTO ARRAY aSalesSalesP
		
		
			IF USED('aSalesSalesP')
				USE IN aSalesSalesP
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT allquotes.SalesP AS S, SUM(Sales.ItemSale) AS Sales, SUM(Sales.ItemCost) AS Cost "
			cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.allquotes WITH(NOLOCK) ON Sales.soitem = allquotes.soitem "
			cSQL = cSQL + " WHERE "+ThisForm.SalesWhere+" AND LEN(AllQuotes.SalesP)>0 "
			cSQL = cSQL + " GROUP BY SalesP ORDER BY Sales "  &&INTO ARRAY aSalesSalesP
		
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSalesSalesP')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aSalesSalesP')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aSalesSalesP")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aSalesSalesP")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'aSalesSalesP')
			ENDIF
			IF USED('aSalesSalesP')		
		
				This.lstSalesSalesP.RowSource = "aSalesSalesP"
				This.lstSalesSalesP.ColumnCount = 3
				This.lstSalesSalesP.NumberOfElements=RECCOUNT('aSalesSalesP')
				This.lstSalesSalesP.Refresh
				This.lstSalesSalesP.Visible = .T.
				
				
				gcSalesSalesP = "SP      Sales        Cost" + CHR(13)
				GO TOP IN aSalesSalesP
				SCAN
				*	gcSalesSalesP = gcSalesSalesP + aSalesSalesP(i,1)+ STR( aSalesSalesP(i,2) ,12) + STR( aSalesSalesP(i,3) ,12)+CHR(13)
					gcSalesSalesP = gcSalesSalesP + aSalesSalesP.s + STR( aSalesSalesP.Sales ,12) + STR( aSalesSalesP.Cost,12)+CHR(13)
				ENDSCAN
		
			ELSE
				This.lstSalesSalesP.Visible = .F.
				
				*SELECT This.Parent.pgSearch.cmbAllEmployees.Value AS S, 0 AS Sales, 0 AS Cost INTO ARRAY aSalesSalesP
			*	aSalesSalesP(1,1) = This.Parent.pgSearch.cmbAllEmployees.Value
			*	aSalesSalesP(1,2) = 0
			*	aSalesSalesP(1,3) = 0
					
			ENDIF
		
		
			IF USED('SumSales')
				USE IN SumSales
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT SUM(Sales.ItemSale) AS ItemSale "
			cSQL = cSQL + ", SUM(Sales.ItemCost) AS ItemCost "
			cSQL = cSQL + ", SUM(Sales.StkCost) AS StkCost "
			cSQL = cSQL + ", SUM(Sales.POCost) AS POCost "
		
			cSQL = cSQL + ", SUM(allquotes.weight) AS ItemWeight "
			cSQL = cSQL + ",COUNT(allquotes.soitem) AS ItemCount "
		*	cSQL = cSQL + ", SUM(Sales.S_Total) AS S_Total "
			cSQL = cSQL + ", SUM(allquotes.Q_Total) AS Q_Total "
			cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.allquotes WITH(NOLOCK) ON Sales.soitem = allquotes.soitem"
			cSQL = cSQL + " WHERE "+ThisForm.SalesWhere
		
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SumSales')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SumSales')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SumSales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SumSales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'SumSales')
			ENDIF
			IF USED('SumSales')	
		
		*!*		DIMENSION anItemSale[1]
		*!*		SELECT SUM(Sales.ItemSale) FROM Sales LEFT OUTER JOIN allquotes ON Sales.soitem = allquotes.soitem ;
		*!*			WHERE &ThisForm.SalesWhere INTO ARRAY anItemSale
		
		*!*		DIMENSION anItemCost[1]
		*!*		SELECT SUM(Sales.ItemCost) FROM Sales LEFT OUTER JOIN allquotes ON Sales.soitem = allquotes.soitem ;
		*!*			WHERE &ThisForm.SalesWhere INTO ARRAY anItemCost
		
		*!*		DIMENSION anWeight[1]
		*!*		SELECT SUM(allquotes.weight) FROM Sales LEFT OUTER JOIN allquotes ON Sales.soitem = allquotes.soitem ;
		*!*			WHERE &ThisForm.SalesWhere INTO ARRAY anWeight
		
		*!*		DIMENSION anCount[1]
		*!*		SELECT COUNT(allquotes.soitem) FROM Sales LEFT OUTER JOIN allquotes ON Sales.soitem = allquotes.soitem ;
		*!*			WHERE &ThisForm.SalesWhere INTO ARRAY anCount
		
		*!*		IF anCount(1) = 0
		*!*			anCount(1) = 1
		*!*		ENDIF
		
		
				THIS.edtvSalesWhere.VALUE = ThisForm.SalesWhere
		
				THIS.txtPS_Total.VALUE =  0 &&PrepareSQLnum(SumSales.S_Total,'Total',-3)
				THIS.txtQ_Total.VALUE = PrepareSQLnum(SumSales.Q_Total,'Total',-3)
				
				THIS.txtSale.VALUE = PrepareSQLnum(SumSales.ItemSale,'Calc',-3)
				
				THIS.txtStkCost.VALUE = PrepareSQLnum(SumSales.StkCost,'StkCost',-3)
				THIS.txtPOCost.VALUE = PrepareSQLnum(SumSales.POCost,'POCost',-3)
				
				THIS.txtProfit.VALUE = PrepareSQLnum(SumSales.ItemSale - SumSales.ItemCost,'Calc',-3)
				THIS.txtPounds.VALUE = PrepareSQLnum(SumSales.ItemWeight,'Calc',-3)
				THIS.txtAveCost.VALUE = PrepareSQLnum(SumSales.ItemCost / SumSales.ItemCount,'Calc',-3)
				THIS.txtAveSale.VALUE = PrepareSQLnum(SumSales.ItemSale / SumSales.ItemCount,'Calc',-3)
				THIS.txtOrderItems.VALUE = PrepareSQLnum(SumSales.ItemCount,'Calc',-3)
				
				gnAcct_Total= 0 &&PrepareSQLnum(SumSales.PT_Total,'PT_Total',-3)
				gnSales		= PrepareSQLnum(SumSales.ItemSale,'Calc',-3)
				gnCost		= PrepareSQLnum(SumSales.ItemCost,'Calc',-3)
				gnProfit	= PrepareSQLnum(SumSales.ItemSale - SumSales.ItemCost,'Calc',-3)
				gnAveSale	= PrepareSQLnum(SumSales.ItemSale / SumSales.ItemCount,'Calc',-3)
				gnAveCost	= PrepareSQLnum(SumSales.ItemCost / SumSales.ItemCount,'Calc',-3)
				gnOrdereItems = PrepareSQLnum(SumSales.ItemCount,'Calc',-3)
				gnPounds	= PrepareSQLnum(SumSales.ItemWeight,'Calc',-3)
		
				gnPS_Total	= 0
				gnQ_Total	= PrepareSQLnum(SumSales.Q_Total,'total',-3)
				gnStkCost	= PrepareSQLnum(SumSales.StkCost,'StkCost',-3)
				gnPOCost	= PrepareSQLnum(SumSales.POCost,'POCost',-3)
		
		*!*			THIS.edtvSalesWhere.REFRESH()
		*!*			THIS.txtCost.REFRESH()
		*!*			THIS.txtSale.REFRESH()
		*!*			THIS.txtProfit.REFRESH()
		*!*			THIS.txtPounds.REFRESH()
		*!*			THIS.txtAveCost.REFRESH()
		*!*			THIS.txtAveSale.REFRESH()
		*!*			THIS.txtOrderItems.REFRESH()
		
				USE IN SumSales
			ENDIF
			
			**************************
			
			IF USED('tmpPS_Total')
				USE IN tmpPS_Total
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT SUM(SPS.Acct_Total) AS Acct_Total "
			cSQL = cSQL + ",COUNT(SPS.SOitem) AS ItemCount "
			cSQL = cSQL + " FROM dbo.Sales_PS SPS WITH(NOLOCK) "
			cSQL = cSQL + " WHERE LEN(SPS.SOitem)>0 AND "+(ThisForm.SPSWhere )
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPS_Total')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPS_Total')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPS_Total")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPS_Total")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF USED('tmpPS_Total')
				IF RECCOUNT('tmpPS_Total') > 0
					gnPS_Total = PrepareSQLnum(tmpPS_Total.Acct_Total,'Total',-3)
					THIS.txtPS_Total.VALUE = PrepareSQLnum(tmpPS_Total.Acct_Total,'Total',-3)
					gnAcct_Total= PrepareSQLnum(tmpPS_Total.Acct_Total,'Total',-3)
				ENDIF
				USE IN tmpPS_Total
			ENDIF
			
			
		ENDIF
		
	ENDPROC

	PROCEDURE pgfAll.pgTotals.cmdExit.Click
		This.Parent.Parent.pgSearch.cmdExit.click
	ENDPROC

	PROCEDURE pgfAll.pgTotals.cmdPrintReport.Click
		*ThisForm.SalesWhere
		*gnSales
		*gnCost
		*gnProfit
		*gnAveSale
		*gnAveCost
		*gnOrdereItems
		*gnPounds
		
		IF TYPE("gcSalesSalesP")= "U"
			PUBLIC gcSalesSalesP
		ENDIF
		gcSalesSalesP = SalesPDescription(This.parent.parent.pgSearch.cmbAllEmployees.Value,'')
		
		*FOR i = 1 TO ALEN(aSalesSalesP,1)
		*	gcSalesSalesP = gcSalesSalesP + aSalesSalesP(i)+";"
		*ENDFOR
		
		SELECT FilterSales
		REPORT FORM Reports\SalesView RECORD 1 TO Printer PROMPT  
		*Report 1, because no table is needed, just make one report page of tatals
		*  could add the lstSalesSalesP data to the report.
		*PREVIEW
	ENDPROC

