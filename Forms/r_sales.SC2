	PROCEDURE seek_soitem_in_ship
		PARAMETERS pcSOitem
		*Seek_SOitem_in_Ship
		
		IF VARTYPE( pcSOitem ) != "C"
			pcSOitem = ''
		ENDIF
		
		IF USED('Ship')
			USE IN Ship
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.Ship "
		
		IF EMPTY(pcSOitem)
			cSQL = cSQL + " WITH(NOLOCK) WHERE 0>0 "
		ELSE
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pcSOitem+"')"
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Ship')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Ship')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Ship")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Ship')
		ENDIF
		IF USED('Ship')
			RETURN .T.
		ELSE
			RETURN .F.
		ENDIF
		
	ENDPROC

