	PROCEDURE Init
		PARAMETERS pParameter,pConnHandle
		*DO FORM Forms\StockLst_Vendor_Edit WITH POitem, ThisForm.nConnHandle  TO lReturn
		*DO FORM Forms\StockLst_Vendor_Edit WITH 635 --ID
		
		IF VARTYPE(pParameter) = "L"
			MESSAGEBOX("No POitem parameter.")
			pParameter = '  501260-01'
			*RETURN .F.
		ENDIF
		
		PRIVATE nID
		IF VARTYPE(pParameter) = "N"
			nID = pParameter
		ELSE
			nID = 0
		ENDIF
		
		PRIVATE cPOitem
		IF VARTYPE(pParameter)="C"
			cPOitem = Proper_PO_Item (pParameter)
		ELSE
			cPOitem = ''
		ENDIF
		
		IF TYPE("pConnHandle") = "N"
			IF pConnHandle > 0
				ThisForm.nConnHandle = pConnHandle
			ELSE
				ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
				IF ThisForm.nConnHandle > 0
					ThisForm.CloseConn = .T.
				ELSE
					MESSAGEBOX("Could not connect to SQL")
					RETURN .F.
				ENDIF
			ENDIF		
		ELSE
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			IF ThisForm.nConnHandle > 0
				ThisForm.CloseConn = .T.
			ELSE
				MESSAGEBOX("Could not connect to SQL")
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		IF nID > 0
			IF USED('tmpVendorStock')
				USE IN tmpVendorStock
			ENDIF
			SELECT 0
			
			cSQL = "SELECT * FROM dbo.Stocklst_Vendor WHERE ID="+STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendorStock')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendorStock')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendorStock")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendorStock")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpVendorStock')
				RETURN .F.
			ENDIF
			 
		ELSE
			*try POitem
			IF cPOitem == ''
				MESSAGEBOX("No POitem parameter.")
				RETURN .F.
			ELSE
				PRIVATE cAlloy,cForm,nThck,nDim2,nDim3,nPc,nWeight,cVendor
				**
				*Get from PO item
				IF USED('tmpPOitem')
					USE IN tmpPOitem
				ENDIF
		
				SELECT 0
				cSQL = "SELECT Alloy,Form,Thck,Sz2,Sz3,Pieces,Pounds,Order_Qty,StockLst_QTY,Company FROM dbo.PurchaseOrder WHERE POitem='"+cPOitem+"'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpPOitem")
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOitem')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitem")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitem")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpPOitem')
				ENDIF
		
				IF USED('tmpPOitem')
					cAlloy		= tmpPOitem.Alloy
					cForm		= tmpPOitem.Form
					nThck		= tmpPOitem.Thck
					nDim2		= tmpPOitem.Sz2
					nDim3		= tmpPOitem.Sz3
					cPCS		= tmpPOitem.Pieces
					nWeight		= tmpPOitem.Pounds
					cVendor		= tmpPOitem.Company
					
					USE IN tmpPOitem
				ELSE
					MESSAGEBOX( "Could not loading the table.","Program Error")
					RETURN .F.
				ENDIF
		
					
				**
				*Get the Matching Vendor Stock
		
				IF USED('tmpVendorStock')
					USE IN tmpVendorStock
				ENDIF
		
				SELECT 0
				cSQL = "SELECT * FROM dbo.StockLst_Vendor WHERE "
				cSQL = cSQL + " Alloy='"+cAlloy+"'"
				cSQL = cSQL + " AND Form='"+cForm+"'"
				cSQL = cSQL + " AND Size >="+STR(nThck*.98-.01,9,3)  
				cSQL = cSQL + " AND Size <="+STR(nThck*1.02+.01,9,3)
				*cSQL = cSQL + " AND Dim2="+nDim2
				*cSQL = cSQL + " AND Dim3="+nDim3
				*cSQL = cSQL + " AND PC="+nPc
				*cSQL = cSQL + " AND Weight="+nWeight
				*cSQL = cSQL + " AND Vendor='"+cVendor+"'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpVendorStock")
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpVendorStock')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendorStock")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendorStock")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpVendorStock')
				ENDIF
		
				IF NOT USED('tmpVendorStock')
					MESSAGEBOX( "Could not loading the table.","Program Error")
					RETURN .F.
				ENDIF
		
				IF RECCOUNT('tmpVendorStock') = 0
					MESSAGEBOX( "Did not find Vendor for Stock:"+CHR(13)+"Alloy: "+cAlloy+CHR(13)+"Form: "+cForm+CHR(13)+"Thick: "+ALLTRIM(STR(nThck,9,3)),0+16,"No Data")
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		
		SELECT tmpVendorStock
		ThisForm.grdVendorStock.RecordSource = 'tmpVendorStock'
		ThisForm.grdVendorStock.Refresh
		ThisForm.RefreshStocklst_Vendor()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SETUP ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
	ENDPROC

	PROCEDURE loadcustomerid
	ENDPROC

	PROCEDURE refreshstocklst_vendor
		*ThisForm.RefreshStockLst_Vendor()
		
		IF USED('tmpVendorStock')
			
			ThisForm.StockLst_ID.Value	= tmpVendorStock.ID
			ThisForm.ALLOY1.Value		= tmpVendorStock.Alloy
			ThisForm.cmbForm.Value		= tmpVendorStock.Form
			ThisForm.cmbCC.Value		= tmpVendorStock.CC
			ThisForm.Pieces1.Value		= tmpVendorStock.Pc
			ThisForm.Thck1.Value		= tmpVendorStock.Dim1
			ThisForm.SZ21.Value			= tmpVendorStock.Dim2
			ThisForm.SZ31.Value			= tmpVendorStock.dim3
			ThisForm.Weight1.Value		= tmpVendorStock.MWeight
			ThisForm.txtSpecs.Value		= tmpVendorStock.Specs
			ThisForm.txtHeat.Value		= tmpVendorStock.Heat
			ThisForm.txtCond.Value		= tmpVendorStock.Cond
			ThisForm.txtDescript.Value	= tmpVendorStock.Descript
			ThisForm.txtBrandName.Value	= tmpVendorStock.BrandName
			ThisForm.txtVendor.Value	= tmpVendorStock.Vendor
			ThisForm.txtMill.Value		= tmpVendorStock.Mill
			ThisForm.txtAddDate.Value	= tmpVendorStock.AddDate
			
		ENDIF
		
		IF GetFormCaptions(tmpVendorStock.Form, ThisForm.nConnHandle)
			IF USED('tmpFormCaptions')
				*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
				ThisForm.lblTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
				ThisForm.LBLSZ21.Caption = RTRIM(tmpFormCaptions.txt2)
				ThisForm.LBLSZ31.Caption = RTRIM(tmpFormCaptions.txt3)
				ThisForm.SZ31.Visible = tmpFormCaptions.use3rdDim
				ThisForm.LBLSZ41.Caption = RTRIM(tmpFormCaptions.txt4)
				USE IN tmpFormCaptions
			ENDIF
		ENDIF
			
		SELECT tmpVendorStock
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		IF USED('tmpVendorStock')
			USE IN tmpVendorStock
		ENDIF
		
		RETURN THISFORM.lReturn
	ENDPROC

	PROCEDURE ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy,  ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				MESSAGEBOX("Use Quotes-Alloys Standard program to add a new Alloy.",0+64,"Unkown Alloy.")
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		*This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE cmbCC.Valid
		*!*	IF ThisForm.QUOTES.THCK1.Value * ThisForm.QUOTES.SZ21.Value > 0
		*!*		IF NOT ThisForm.QUOTES.SZ31.Visible
		*!*	*		IF ThisForm.QUOTES.SZ21.Value > 0
		*!*				ThisForm.CalcInv(2)
		*!*	*		ENDIF
		*!*		ELSE
		*!*			IF ThisForm.QUOTES.SZ31.Value > 0
		*!*				ThisForm.CalcInv(3) 
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
		
	ENDPROC

	PROCEDURE cmbForm.Valid
		*!*	IF ThisForm.QUOTES.THCK1.Value * ThisForm.QUOTES.SZ21.Value > 0
		*!*		IF NOT ThisForm.QUOTES.SZ31.Visible
		*!*				ThisForm.CalcInv(2)
		*!*			ELSE
		*!*			IF ThisForm.QUOTES.SZ31.Value > 0
		*!*				ThisForm.CalcInv(3) 
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		PRIVATE pForm
		pForm = This.Value
		
		IF NOT EMPTY(pForm)
			IF GetFormCaptions(pForm,ThisForm.nConnHandle)
				IF USED('tmpFormCaptions')
					*[txt1],[txt2],[txt3],[txt4],[use3rdDim]
					ThisForm.lblTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisForm.LBLSZ21.Caption = RTRIM(tmpFormCaptions.txt2)
					ThisForm.LBLSZ31.Caption = RTRIM(tmpFormCaptions.txt3)
					ThisForm.SZ31.Visible = tmpFormCaptions.use3rdDim
					ThisForm.LBLSZ41.Caption = RTRIM(tmpFormCaptions.txt4)
					USE IN tmpFormCaptions
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.lReturn = .F.
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdDelete.Click
		
		*Delete
		
		PRIVATE nStockLst_ID, cAlloy, cForm, cCC, nThck, cDescr
		nStockLst_ID = This.parent.StockLst_ID.Value
		cAlloy	= This.Parent.AlLOY1.Value
		cForm	= This.Parent.cmbForm.Value
		cCC		= This.Parent.cmbCC.Value
		nThck	= This.Parent.Thck1.Value
		cDescr = ALLTRIM(cAlloy)+" "+cForm+" "+cCC+" "+ALLTRIM(STR(nThck,10,4))
		
		IF nStockLst_ID > 0
			IF MESSAGEBOX( "Are you sure you want to Delete ID:"+ALLTRIM(STR(nStockLst_ID))+"?"+CHR(13)+cDescr,4+64,"Delete (Y/N)") = 6
				
				
				PRIVATE cSQL, nSQLEXEC
				cSQL = "DELETE dbo.Stocklst_Vendor WHERE ID ="+ALLTRIM(STR(nStockLst_ID))
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
				ENDIF
				
				
				ThisForm.lReturn = .T.
				ThisForm.Release
		
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE grdVendorStock.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshStocklst_Vendor()
		
	ENDPROC

	PROCEDURE LBLWEIGHT1.Click
		
		PRIVATE cAlloy,cForm,cCC,nPieces,nThck,nSz2,nSz3,nForceBracket
		cAlloy = PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		nPieces	= PrepareSQLnum(ThisForm.Pieces1.Value,'Pieces',-3)
		nThck	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
		nSz2	= PrepareSQLnum(ThisForm.Sz21.Value,'sz2',9,3)
		nSz3	= PrepareSQLnum(ThisForm.Sz31.Value,'Sz3',9,3)
		nForceBracket = .F.
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.[p_GetFullQuote] "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
		ENDIF
		
		IF USED('tmpPriceTbl')
			IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
				IF tmpPriceTbl.Pounds > 0
					
					IF EMPTY(ThisForm.WEIGHT1.Value)
						ThisForm.WEIGHT1.Value = tmpPriceTbl.Pounds
					ELSE
						nPC = ROUND(ThisForm.WEIGHT1.Value / tmpPriceTbl.Pounds,0)
						WAIT WINDOW ALLTRIM(STR(tmpPriceTbl.Pounds,10,1))+" LBS" NOWAIT
						
						ThisForm.Pieces1.Value = ROUND(ThisForm.WEIGHT1.Value / tmpPriceTbl.Pounds,0)
						ThisForm.Pieces1.Refresh
					ENDIF
					ThisForm.WEIGHT1.Refresh
				ENDIF
			ENDIF
			USE IN tmpPriceTbl
		ENDIF
	ENDPROC

