	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Load
		Thisform.Currdbf = ALIAS()
		
		PRIVATE mSQL,nSQLEXEC 
		
		
		IF USED('SupplierQuotes')
			USE IN SupplierQuotes
		ENDIF
		SELECT 0
		
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		STORE get_SQLSTRINGCONNECT() TO ThisForm.nConnHandle
		
		mSQL = "SELECT * "
		mSQL = mSQL +" FROM dbo.SupplierQuotes "
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, mSQL, 'SupplierQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, mSQL, 'SupplierQuotes')
		ENDDO
		
		IF nSQLEXEC < 0  &&Try again. Problem Query.
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, mSQL, 'SupplierQuotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, mSQL, 'SupplierQuotes')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, mSQL, "SupplierQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, mSQL, "SupplierQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(mSQL, ThisForm.nConnHandle, nSQLEXEC, 'SupplierQuotes')
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('SupplierQuotes')
			USE IN SupplierQuotes
		ENDIF
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		IF NOT EMPTY(Thisform.Currdbf)
			IF USED(Thisform.Currdbf)
				SELECT (Thisform.Currdbf)
			ENDIF
		ENDIF
	ENDPROC

