	PROCEDURE frmWorkOrder.cmbFinishM.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpMachine')
			SELECT tmpMachine
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT ANS,UN FROM dbo.AppSetup WITH(NOLOCK) "
		cSQL = cSQL + " WHERE PRP = 'Production Machine'"
		cSQL = cSQL + " Order by [ANS]"
		
		*---cSQL="SELECT dbo.f_GetMachine_LogList() AS [ANS]"
		
		
		* UPDATE dbo.AppSetup SET ANS = 'Swage'
		* WHERE PRP = 'Production Machine' AND UN ='Swage_Log '
		 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMachine')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpMachine')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpMachine")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpMachine")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpMachine')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION atmpMachine(1,2)
		PRIVATE cLogList 
		cLogList = ""
		*cLogList = tmpMachine.ANS
		
		IF USED('tmpMachine')
			SELECT * FROM tmpMachine INTO ARRAY atmpMachine
		
			USE IN tmpMachine
		ENDIF
		
		This.ColumnCount = 2
		This.BoundColumn = 1
		This.ColumnWidths = "70,90"
		
		this.addListitem("",1,1)  &&Add a blank
		this.addListitem("",1,2)
		
		PRIVATE nArrayCount
		nArrayCount = 0
		IF TYPE('atmpMachine(1,1)') # 'L'
			nArrayCount = ALEN(atmpMachine,1)
		ENDIF
		This.NumberOfElements = nArrayCount + 1
		FOR I = 1 TO nArrayCount
			this.addListitem(atmpMachine(I, 1),I+1,1)
			this.addListitem(atmpMachine(I, 2),I+1,2)
		ENDFOR
	ENDPROC

