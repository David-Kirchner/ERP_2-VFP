	ENDPROC

	PROCEDURE frmWorkOrder.txtFinishLot.Valid
		*Validate the Lot
		PRIVATE cMach, nLot, cTable 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'Mach',20)
		nLot	= PrepareSQLnum(This.Value,'Lot',-3)
		cTable = ''
		
		PRIVATE cSQL, nSQLEXEC, lValidLot 
		lValidLot = .F.
		
		IF nLot = 0
			lValidLot = .T.
			RETURN lValidLot
		ENDIF
		
		IF NOT EMPTY(cMach)
			IF nLot > 0
		
				IF USED('tmpMachine')
					SELECT tmpMachine
				ELSE
					SELECT 0
				ENDIF
		
				cSQL="SELECT UN FROM dbo.AppSetup WITH(NOLOCK) "
				cSQL = cSQL + " WHERE PRP = 'Production Machine'"
				cSQL = cSQL + " AND ANS='"+cMach+"'"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMachine')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpMachine')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpMachine")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpMachine")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpMachine')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
		
				IF USED('tmpMachine')
					IF RECCOUNT('tmpMachine') > 0
						cTable = tmpMachine.UN
					ENDIF
					USE IN tmpMachine
				ENDIF
			ENDIF
		ENDIF
		
		
		IF NOT EMPTY(cTable)
		
			IF USED('tmpMachineLot')
				SELECT tmpMachineLot
			ELSE
				SELECT 0
			ENDIF
		
			cSQL="SELECT COUNT(*) AS CNTD FROM dbo."+cTable
			cSQL = cSQL + " WHERE LOT = "+STR(nLot)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMachineLot')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpMachineLot')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpMachineLot")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpMachineLot")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpMachineLot')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		
			IF USED('tmpMachineLot')
				IF RECCOUNT('tmpMachineLot') > 0
					IF tmpMachineLot.CNTD > 0
						lValidLot = .T.
					ELSE
						MESSAGEBOX("This Machine:"+cMach+"  and Lot:"+ALLTRIM(STR(nLOT))+ " was not found!",16,"Replace with '0' to continue")
					ENDIF
				ENDIF
				USE IN tmpMachineLot
			ENDIF
		ENDIF
		
		RETURN lValidLot 
	ENDPROC

