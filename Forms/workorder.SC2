		RETURN Remove_ID_Detail_Process(pID_Detail_Process,"SOitem",pSOitem,pTbl,ThisFormSet.nConnHandle,cWhat)
		
	ENDPROC

	PROCEDURE remove_poitem
		PARAMETERS pPOitem,pWhat
		*ThisFormSet.Remove_POitem(cPoItem,'WO')
		
		PRIVATE cPoItem
		cPoItem = PrepareSQLtxt(pPOitem,'POitem',12)
		
		IF Proper_PO_item(cPoItem) = Proper_PO_item('')
			RETURN
		ENDIF
		
		IF VARTYPE(pWhat) != "C"
			RETURN
		ENDIF
		
		PRIVATE nWhatNo, nWO, nWO_Detail
		nWO	 		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail  = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF pWhat = "WOD"
			*Update PO WO_Detail
			cSQL = "UPDATE dbo.PurchaseOrder SET WO_Detail=0"
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL = cSQL + " AND WO_Detail="+STR(nWO_Detail)
			
			nWhatNo = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		ENDIF
		IF pWhat =="WO"
			cSQL = "UPDATE dbo.PurchaseOrder SET WO=0"
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL = cSQL + " AND WO="+STR(nWO)
			
			nWhatNo = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		ENDIF
		
		IF NOT EMPTY(cSQL)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				TrackMess("Removed POitem from "+pWhat+" = "+ALLTRIM(STR(nWhatNo))+CHR(13)+cSQL )
			ENDIF
		ENDIF
		
		*Process
		****************************
		cSQL = ''
		IF pWhat = "WOD"
			*Update the 'SELECTED Process, remove the WO_Detail
			
			cSQL = "UPDATE dbo.StockLst_Process SET WO_Detail=0"
			cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL = cSQL + " AND Process_ID = 'SELECTED'"
			cSQL = cSQL + " AND WO_Detail="+STR(nWO_Detail)
			
			cSQL = cSQL + "; UPDATE dbo.BrokerLst_Process SET WO_Detail=0"
			cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL = cSQL + " AND Process_ID = 'SELECTED'"
			cSQL = cSQL + " AND WO_Detail="+STR(nWO_Detail)+" ;"
			
		ENDIF
			
		IF pWhat == "WO"
			*Update the 'SELECTED Process, remove the WO_Detail
			
			cSQL = "UPDATE dbo.StockLst_Process SET WO=0"
			cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL = cSQL + " AND Process_ID = 'INCOMING'"
			cSQL = cSQL + " AND WO="+STR(nWO)
			
			cSQL = cSQL + "; UPDATE dbo.BrokerLst_Process SET WO=0"
			cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL = cSQL + " AND Process_ID = 'INCOMING'"
			cSQL = cSQL + " AND WO="+STR(nWO)+" ;"
			
		ENDIF
		
		IF NOT EMPTY(cSQL)
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 2
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 3' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF	
		ENDIF
	ENDPROC

	PROCEDURE remove_soitem
		PARAMETERS pSOitem,pWhat
		*ThisFormSet.Remove_SOitem(cSOItem,'WO')
		
		PRIVATE cSOItem, nWhatNo, nWO, nWO_Detail
		cSOItem		= PrepareSQLtxt(pSOitem,'SOitem',10)
		nWO	 		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail  = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)		&&was throwing a Data type mismatch.. 
		
		IF Proper_SO_item(cSoItem) = Proper_SO_item('')
			RETURN
		ENDIF
		
		IF VARTYPE(pWhat) != "C"
			RETURN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF pWhat = "WOD"
			*Update SO WO_Detail
			cSQL = "UPDATE dbo.Sales SET WO_Detail=0"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND WO_Detail="+STR(nWO_Detail)
			
			nWhatNo = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		ENDIF
		IF pWhat =="WO"
			cSQL = "UPDATE dbo.Sales SET WO=0"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND WO="+STR(nWO)
			
			nWhatNo = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		ENDIF
		
		IF NOT EMPTY(cSQL)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				TrackMess("Removed SOitem from "+pWhat+" = "+ALLTRIM(STR(nWhatNo))+CHR(13)+cSQL )
			ENDIF
		ENDIF
		
		
		*Process
		****************************
		cSQL = ''
		IF pWhat = "WOD"
			*Update the 'SELECTED Process, remove the WO_Detail
			
			cSQL = "UPDATE dbo.StockLst_Process SET WO_Detail=0"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND Process_ID = 'SELECTED'"
			cSQL = cSQL + " AND WO_Detail="+STR(nWO_Detail)
			
			cSQL = cSQL + "; UPDATE dbo.BrokerLst_Process SET WO_Detail=0"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND Process_ID = 'SELECTED'"
			cSQL = cSQL + " AND WO_Detail="+STR(nWO_Detail)+";"
			
		ENDIF
			
		IF pWhat == "WO"
			*Update the 'SELECTED Process, remove the WO_Detail
			
			cSQL = "UPDATE dbo.StockLst_Process SET WO=0"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND Process_ID = 'SELECTED'"
			cSQL = cSQL + " AND WO="+STR(nWO)
			
			cSQL = cSQL + "; UPDATE dbo.BrokerLst_Process SET WO=0"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND Process_ID = 'SELECTED'"
			cSQL = cSQL + " AND WO="+STR(nWO)+";"
			
		ENDIF
		
		IF NOT EMPTY(cSQL)
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF	
		ENDIF
	ENDPROC

	PROCEDURE reset_mfg_lot
		PARAMETERS cMach,nFinishLot
		*ThisFormset.Reset_MFG_Lot(cFinishM,nFinishLot)
		
		IF EMPTY(cMach)
			RETURN .F.
		ENDIF
		
		****
		DO CASE
		CASE cMach = "Draw Bench"
		CASE cMach = "GFM"
		CASE cMach = "Heat Treat"
		CASE cMach = "Open Die"
		CASE cMach = "Rolling"
		CASE cMach = "Swage"
		CASE cMach = "Wire Draw"
		OTHERWISE
			TrackError("Mach is not programmed","No Mach",PROGRAM(),LINENO(1))
			RETURN .f.
		ENDCASE
		****
		
		*Store WO_Detail to MFG lot table +and Service PO
		
		
		PRIVATE nWO, nWO_Detail
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		
		
		IF nWO_Detail = 0
			*Must Save First
			RETURN .F.
		ENDIF
		
		
		
		PRIVATE cFSOitem, cFPOitem
		cFSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		cFPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFPOitem.Value,'POitem',12)
		
		
		****
		PRIVATE cSQL, nSQLEXEC 
		
		DO CASE
		CASE UPPER(cMach) = "DRAW BENCH" 
			cSQL = "UPDATE dbo.Draw_log "
		CASE UPPER(cMach) = "GFM" 
			cSQL = "UPDATE dbo.GFMlog "
		CASE UPPER(cMach) = "HEAT TREAT" 
			cSQL =  "UPDATE dbo.HT_Log "
		CASE UPPER(cMach) = "OPEN DIE" 
			cSQL =  "UPDATE dbo.LakeErie_Log "
		CASE UPPER(cMach) = "ROLLING"
			cSQL =  "UPDATE dbo.Roll_Log "
		CASE UPPER(cMach) = "SWAGE"
			cSQL =  "UPDATE dbo.Swage_Log "
		CASE UPPER(cMach) = "WIRE DRAW" 
			cSQL = "UPDATE dbo.WIRE_Log "
		ENDCASE
		
		
		cSQL = cSQL + " SET "
		
		*cSQL = cSQL + ",SalesNum,ItemSO,SOitem"
		*cSQL = cSQL + ","+STR(nSalesNum)+","+STR(nItemSO,2,0)+",'"+cSOitem+"'"
		*cSQL = cSQL + ",WO,WO_Detail,ProjID "
		*cSQL = cSQL + ","+STR(nWO)+","+STR(nWO_Detail)+","+STR(nStock_Projected_ID)
		cSQL = cSQL + " WO="+STR(nWO)
		cSQL = cSQL + " ,WO_Detail="+STR(nWO_Detail)
		
		IF Proper_PO_item(cFPOitem) <> Proper_PO_Item('')
			**IF cFPOitem is Service PO
			PRIVATE nHpaPO
			nHpaPO = Proper_PO_item_PO(cFPOitem)
			IF is_Vendor_LabService(nHpaPo,ThisFormSet.nConnHandle)
				cSQL = cSQL + " ,SrvcPO ="+STR(nHpaPO)
			ENDIF
		ENDIF
		cSQL = cSQL + " WHERE Lot = "+STR(nFinishLot)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			RETURN .F.
		ELSE
			WAIT WINDOW "Saved to MGF Lot" NOWAIT
			RETURN .T.
		ENDIF
		
		*!*	DO CASE			&&RoughSize
		*!*	CASE UPPER(cMach) = "DRAW_LOG" 
		*!*		cSQL = cSQL + ",DRAWsize"
		*!*	CASE UPPER(cMach) = "GFM" 
		*!*		cSQL = cSQL + ",GFMsize"
		*!*	CASE UPPER(cMach) = "HEAT TREAT" 
		*!*		*cSQL = cSQL + ",sSize"
		*!*	CASE UPPER(cMach) = "OPEN DIE" 
		*!*		*cSQL = cSQL + ",fsize"
		*!*	CASE UPPER(cMach) = "ROLLING"
		*!*		cSQL = cSQL + ",RollSize"
		*!*	CASE UPPER(cMach) = "SWAGE"
		*!*		cSQL = cSQL + ",SwageSize"
		*!*	CASE UPPER(cMach) = "WIRE" 
		*!*		cSQL = cSQL + ",DrawSize"
		*!*	ENDCASE
		
		
	ENDPROC

	PROCEDURE routerdetailorder_isopen
		*ThisFormSet.RouterDetailOrder_IsOpen
		IF VARTYPE(Thisformset.frmRouterDetailOrder) != "O"
			RETURN .F.
		ELSE
			IF Thisformset.frmRouterDetailOrder.Visible
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE saveadddetail
		PARAMETERS lAlreadyAmended
		*ThisFormSet.SaveAddDetail(lAlreadyAmended)
		
		IF NOT lAlreadyAmended
			IF NOT ThisFormSet.CheckSaveDetail()
				*WAIT WINDOW "Failed Check" NOWAIT
				MESSAGEBOX("WO Detail Failed Check",0,"Not Saved")
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE nWO, nWO_Detail
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cFAlloy,cFForm,cFCC,cFCL,nFPieces,nFThck,nFSz2,nFSz3,lpinFWeight,nFWeight,cFSpec
		nFPieces	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		cFAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
		cFForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFForm.Value,'Form',2)
		cFCC		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCC.Value,'CC',1)
		cFCL		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCL.Value,'CL',1)
		nFthck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz2.Value,'Sz2',13,3)
		nFSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz3.Value,'Sz3',13,3)
		lpinFWeight	= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkPinFWeight.Value,'pinFWeight')
		nFWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFWeight.Value,'Weight',9,1)
		cFSpec 		= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtFSpec.Value,'FSpec',50)
						
		PRIVATE cFDescript, cfCondLevel, cFollowM, nFollowLot, cFinishM, nFinishLot, cTestPO
		cFDescript	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFdescript.Value,'Fdescript',100)
		cfCondLevel = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		cFollowM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFollowM.Value,'FollowM',20)
		nFollowLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFollowLot.Value,'FollowLot',-3)
		cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		cTestPO		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtTestPO.Value,'POitem',12)
		PRIVATE cFSOitem, cFPOitem
		cFSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		cFPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFPOitem.Value,'POitem',12)
		
		PRIVATE dfDueDate, nWO_Detail, cfTBL, nFID_Detail, nFID_Detail_Process
		dfDueDate	= PrepareSQLDate(ThisFormSet.frmWorkOrder.txtfDueDate.Value,'DueDate')
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWO_Detail = 0
		*	nWO_Detail = 0
		ENDIF
		cfTBL		= ''
		nFID_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail.Value,'ID_Detail',-3)
		nFID_Detail_Process	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value,'ID_Detail_Process',-3)
		PRIVATE cNextCode, cNextNumber
		*STK,Stk ID_Detail, SOi,SO item,  WO,WorkOrder,  WOD,WO Detail
		cNextCode 	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbNextCode.Value,'NextCode',3)
		cNextNumber	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtNextNumber.Value,'NextNumber',10)
		 
		PRIVATE nfReceivingID, lfCmplt
		nfReceivingID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfReceivingID.Value,'RecevingID',-3)
		*lIntP		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')  &&Used on WO and WO_Detail
		lfCmplt		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCmplt.Value,'fCmplt')
		
		PRIVATE lfPrint, lfPRecv, lfMod, nfRev
		lfPrint	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfPrint.Value,'fPrint')
		lfPRecv	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfpRecv.Value,'fPRecv')
		lfMod	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfMod.Value,'fMod')
		nfRev	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfRev.Value,'fRev',-1)
		
		PRIVATE cFNotes, nStock_Projected_ID, lfCncld, lStkListed
		cFNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtfNotes.Value,'Notes',-1)
		nStock_Projected_ID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value,'Stock_Projected_ID',-3)
		lfCncld		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCncld.Value,'fCncld')
		lStkListed	= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkStkListed.Value,'StkListed')
		
		PRIVATE cfCondLevel, nStartSize, nCW, nRoughSize, nOverSize
		cfCondLevel	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		nStartSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		
		
		PRIVATE lWO_DetailExists
		lWO_DetailExists = .F.
		
		PRIVATE cSQL, nSQLEXEC 
		
		*******************
		*Check Data
		PRIVATE lOK
		lOK = .T.
		
		
		********
		IF nWO_Detail > 0
			*Check WO_Detail Past
				
			*DID lCncld change, is this allowed?
			IF lfCncld 
				*is now Cancelled
				IF Count_WODinWO_detail( nWO_Detail, ThisFormSet.nConnHandle, "CANCELLED" ) > 0 &&was already cancelled
					*no change
				ELSE
					*Try to mark as Cancelled
					*
				ENDIF	
			ELSE
				*is not Cancelled
				IF Count_WODinWO_detail( nWO_Detail, ThisFormSet.nConnHandle, "CANCELLED" ) > 0 &&was already cancelled
					*Try to mark as NOT Cancelled
					*
				ELSE
					*no change
				ENDIF	
			ENDIF
		
			*DID lCmplt change, is this allowed?
			IF lfCmplt 
				*is now Complete
				IF Count_WODinWO_detail( nWO_Detail, ThisFormSet.nConnHandle, "COMPLETE" ) > 0 &&was already Complete
					*no change
				ELSE
					*Try to mark as Complete
					*
				ENDIF	
			ELSE
				*is not Complete
				IF Count_WODinWO_detail( nWO_Detail, ThisFormSet.nConnHandle, "COMPLETE" ) > 0 &&was already Complete
					*Try to mark as NOT Complete
					*
				ELSE
					*no change
				ENDIF	
			ENDIF
		ENDIF
		
		*****************
		*End Check
		IF NOT lOK
			RETURN .F.
		ENDIF
		*****************
		*Ready for Save.
		
		IF EMPTY(cfTBL)
			PRIVATE cPOitem
			cPOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
			
			IF Proper_PO_item(cPOitem) != Proper_PO_item('')
			 
				cSQL = "SELECT TBL FROM PurchaseOrder "
				cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPOItem+"')"
				
				IF USED("tmpPOstock")	
					USE IN tmpPOstock
				ENDIF
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOstock')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPOstock')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOstock")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOstock")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOstock')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
				IF USED('tmpPOstock')
					IF RECCOUNT('tmpPOstock') > 0
						cfTBL = PrepareSQLtxt(tmpPOstock.TBL,'TBL',1)
					ENDIF
					USE IN tmpPOstock
				ENDIF
			ENDIF	
		ENDIF
		
		IF EMPTY(cfTBL)
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				cfTBL = getTBL_POitem(cPOItem)
			ENDIF
		ENDIF
		
		IF EMPTY(cfTBL)
			cfTBL = "S" && Default to Stock
		ENDIF
		
		*******************
		
		IF nWO_Detail > 0
			*Check for existing nWO_Detail
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder_Detail WHERE WO_Detail = "+STR(nWO_Detail)
		
			IF USED("tmpCountWOD")	
				USE IN tmpCountWOD
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountWOD')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpCountWOD')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountWOD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountWOD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountWOD')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpCountWOD')
				IF tmpCountWOD.Cntd > 0
					lWO_DetailExists = .T.
				ENDIF
				USE IN tmpCountWOD
			ENDIF
		ENDIF
		
		IF NOT lWO_DetailExists 
		
			*Use Stored Proc to insert and get next WO_Detail
			IF USED("InsertWOD")	
				USE IN InsertWOD
			ENDIF
			SELECT 0
		
			cSQL = "EXEC dbo.p_WorkOrder_Detail_Ins "
			cSQL = cSQL + "@WO="+STR(nWO)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'InsertWOD')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'InsertWOD' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "InsertWOD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "InsertWOD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'InsertWOD')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('InsertWOD')
				IF RECCOUNT('InsertWOD')>0
				
					ThisformSet.Load_lst_WO_Detail(nWO)
		
					nWO_Detail = InsertWOD.EXP
					IF nWO_Detail > 0
						ThisFormSet.frmWorkOrder.txtWO_Detail.Value = nWO_Detail
						ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .F.
		
						WAIT WINDOW "Inserted WO_Detail "+ALLTRIM(STR(nWO_Detail ))+" into table." TIMEOUT 1
		
					ENDIF
				ENDIF
				USE IN InsertWOD
			ENDIF
		ENDIF
		
		
		IF nWO_Detail > 0
			*The p_WorkOrder_Detail_Ins create the record, now update
			
			cUpdate = "UPDATE dbo.WorkOrder_Detail SET"
			cUpdate = cUpdate + " fStartDate=GetDate()"
		    cUpdate = cUpdate + ",fDueDate='"+IIF(EMPTY(dfDueDate),'',DTOC(dfDueDate))+"'"
		    cUpdate = cUpdate + ",fDescript='"+cFDescript+"'"
		
			cUpdate = cUpdate + ",fSOitem = dbo.f_ProperSOitem('"+cFSoItem+"')"
			cUpdate = cUpdate + ",fPOitem = dbo.f_ProperPOitem('"+cFPoItem+"')"
		    cUpdate = cUpdate + ",fPieces="+STR(nFPieces,7,0)+""
		    cUpdate = cUpdate + ",fAlloy='"+cFAlloy+"'"
		    cUpdate = cUpdate + ",fForm='"+cFForm+"'"
		    cUpdate = cUpdate + ",fCC='"+cFCC+"'"
		    cUpdate = cUpdate + ",fCL='"+cFCL+"'"
		    cUpdate = cUpdate + ",fThck="+STR(nFThck,10,4)+""
		    cUpdate = cUpdate + ",fSz2="+STR(nFSZ2,9,3)+""
		    cUpdate = cUpdate + ",fSz3="+STR(nFSz3,9,3)+""
		    cUpdate = cUpdate + ",fWeight="+STR(nFWeight,8,1)+""
		    cUpdate = cUpdate + ",pinFWeight="+IIF(lpinFWeight,'1','0')
		    cUpdate = cUpdate + ",fTBL='"+cfTBL+"'"
		    cUpdate = cUpdate + ",fID_Detail="+STR(nFID_Detail)+""
		    cUpdate = cUpdate + ",fID_Detail_Process="+STR(nFID_Detail_Process)+""
		    cUpdate = cUpdate + ",fReceivingID="+STR(nfReceivingID)+""
		*    cUpdate = cUpdate + ",fIntP="+IIF(lIntP,'1','0')
		    cUpdate = cUpdate + ",fNotes='"+cfNotes+"'"
		    cUpdate = cUpdate + ",fCondLevel='"+cfCondLevel+"'"
		    cUpdate = cUpdate + ",fCncld="+IIF(lfCncld,'1','0')
		    
		    cUpdate = cUpdate + ",fPrint=0"
		    cUpdate = cUpdate + ",fPRecv=0"
		    *cUpdate = cUpdate + ",fMod=0"
		    cUpdate = cUpdate + ",fRev="+STR(nfRev)
		    
		    cUpdate = cUpdate + ",StkListed="+IIF(lStkListed,'1','0')
		    cUpdate = cUpdate + ",Stock_Projected_ID="+STR(nStock_Projected_ID)+""
		    
		    cUpdate = cUpdate + ",FollowM='"+cFollowM+"'"
		    cUpdate = cUpdate + ",FollowLot="+STR(nFollowLot)
		    cUpdate = cUpdate + ",FinishM='"+cFinishM+"'"
		    cUpdate = cUpdate + ",FinishLot="+STR(nFinishLot)
		    
		    cUpdate = cUpdate + ",StartSize="+STR(nStartSize,8,3)
		    cUpdate = cUpdate + ",CW="+STR(nCW,2,0)
		    cUpdate = cUpdate + ",RoughSize="+STR(nRoughSize,8,3)
		    cUpdate = cUpdate + ",OverSize="+STR(nOverSize,5,3)
		    cUpdate = cUpdate + ",FSpec='"+cFSpec+"'"  
		    cUpdate = cUpdate + ",TestPO = dbo.f_ProperPOitem('"+cTestPO+"')"
		 *   cUpdate = cUpdate + ",RcvdE="+IIF(lRcvdE,'1','0')
		    cUpdate = cUpdate + ",NextCode='"+cNextCode+"'"
		    cUpdate = cUpdate + ",NextNumber='"+cNextNumber+"'"
		  
		 	cUpdate = cUpdate + " WHERE WO_Detail= "+STR(nWO_Detail)
			 
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cUpdate, ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cUpdate )
			ELSE
				WAIT WINDOW "Saved data to WO Detail "+ALLTRIM(STR(nWO_Detail)) NOWAIT
				
				***********************************************
				*Remove WO from All Sales records, then add back if real SOitem.
				
				cSQL = "UPDATE dbo.Sales SET WO_Detail=0"
				*cSQL = cSQL + ",IntP=0 " 
				cSQL = cSQL + " WHERE WO_Detail="+STR(nWO_Detail)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF		
		
				IF Proper_SO_item(cFSoItem) != Proper_SO_item("")
					*Update SO with WO_Detail
					cSQL = "UPDATE dbo.Sales SET WO_Detail="+STR(nWO_Detail)
					*cSQL = cSQL + ",IntP="+IIF(lIntP,'1','0')
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cFSOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF
				ENDIF
				
				***********************************************
				*SET WO_Detail=0 from All PurchaseOrders, then add back if real POitem
				* use to remove other PO's connected to this WOD
		*!*			cSQL = "UPDATE dbo.PurchaseOrder SET WO_Detail=0"
		*!*			*cSQL = cSQL + ",IntP=0"
		*!*			cSQL = cSQL + " WHERE WO_Detail="+STR(nWO_Detail)
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, '')
		*!*				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*			ENDIF		
				
				IF Proper_PO_item(cFPoItem) != Proper_PO_item("")
					*Update PO with WO_Detail
					cSQL = "UPDATE dbo.PurchaseOrder SET WO_Detail="+STR(nWO_Detail)
					*cSQL = cSQL + ",IntP="+IIF(lIntP,'1','0')
					cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cFPOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF	
					*Conversion Service POitem on WOD
					*If po item Selects Stock, Add WO to that process.
					ThisFormSet.Check_WOD_POi_Process(nWO,nWO_Detail,cFPOitem)
					
				ENDIF
				***********************************************
				
				ThisFormSet.frmWorkOrder.txtTotFinishW.Value = ThisFormSet.TotalFinishWeight(nWO)
				
				WAIT WINDOW "Saved Work Order Detail "+ALLTRIM(STR(nWO_Detail))+" !" NOWAIT
				
			ENDIF
			
			***********************************************
			ThisFormset.frmWorkOrder.chkfPrint.Value	= 0
			ThisFormset.frmWorkOrder.chkfpRecv.Value	= 0
			ThisFormset.frmWorkOrder.chkfMod.Value		= 1
		
			*************************************
			PRIVATE lComplete, lCancelled,  nWO_Detail
			lComplete = PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfCmplt.Value,'fCmplt')
			lCancelled	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfCncld.Value,'fCncld')	
			nWO_Detail	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		
		
			IF NOT ( lCancelled OR lComplete )
				
				cSQL = "UPDATE dbo.WorkOrder_Detail SET fPrint=0, fPRecv=0, fMod=1 WHERE WO_Detail = "+STR(nWO_Detail)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
				
				ThisFormset.frmWorkOrder.chkfPrint.Value	= .F.
				ThisFormset.frmWorkOrder.chkfpRecv.Value	= .F.
				ThisFormset.frmWorkOrder.chkfMod.Value		= .T.
			ENDIF
			
			
			ThisFormSet.Save_WOD_Incm_Prc(nWO_Detail)
			
			
			*************************************
			PRIVATE nWOD_pos 
			nWOD_pos = ASCAN(gaWO_Detail, nWO_Detail) 
			IF nWOD_pos > 0
				ThisFormSet.frmWorkOrder.lstWO_Detail.Value = nWOD_pos
				*ThisFormSet.frmWorkOrder.lstWO_Detail.Value = tmpWO_Detail.WO_Detail 
				ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .T.
				ThisFormSet.frmWorkOrder.lstWO_Detail.Refresh
			ENDIF
			
			*************************************
			
			IF LEN(cFinishM) > 0 AND nFinishLot > 0
				ThisFormSet.Reset_MFG_Lot(cFinishM,nFinishLot)
			ENDIF
			WAIT WINDOW "Saved data to WO Detail "+ALLTRIM(STR(nWO_Detail))+" !" TIMEOUT 1
		ELSE
			MESSAGEBOX("No WorkOrder_Detail Number",0+16,"Cannot create WO Detail!")
		ENDIF
		
		*******************
		IF nWO_Detail > 0
			*Save to Stock table is done in cmd.CreateStock
			*Check, resave ????
			ThisFormSet.ReCheck_StockData_WOD(nWO_Detail)
		
			IF nFinishLot > 0
				IF LEN(cFinishM) > 0
					ThisFormSet.ReCheck_FinishLot()
				ENDIF
			ENDIF
		
			*ThisFormSet.SaveAdd_rtr_WO(nWO)
			ThisFormSet.SaveAdd_rtr_WO_Detail(nWO_Detail)
			
			ThisFormSet.Refresh_frmWorkOrder_Detail(nWO_Detail)
		
		
		
		ENDIF
	ENDPROC

	PROCEDURE saveaddwo		&& SaveAddWO
		*ThisFormSet.SaveAddWO
		
		IF NOT ThisFormSet.CheckSaveWO()
			*WAIT WINDOW "Failed Check" NOWAIT
			MESSAGEBOX("WO Failed Check",0,"Not Saved")
			RETURN .F. 
		ENDIF
		
		PRIVATE nWO,nPieces,cAlloy,cForm,cCC,cCL,cHeat,nThck,nSz2,nSz3,lpinSWeight, nWeight
		PRIVATE nID_Detail,nID_Detail_Process,cDescript,cSalesRep,cNotes
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nPieces		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCL.Value,'CL',1)
		cHeat 		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtHeat.Value,'Heat',50)
		
		nThck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtThck.Value,'Thck',14,4)
		nSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz2.Value,'Sz2',13,3)
		nSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz3.Value,'Sz3',13,3)
		*nID_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtID_Detail.Value,'ID_Detail',-3)
		*nID_Detail_Process = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		lpinSWeight	= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkPinSWeight.Value,'pinSWeight')
		
		nWeight		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWeight.Value,'Weight',11,1)
		cDescript	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtDescript.Value,'Descript',100)
		cSalesRep	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSalesRep.Value,'SalesRep',20)
		cNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtWO_Notes.Value,'Notes',-1)
		
		PRIVATE lCmplt, lCncld,lRE,cSOitem,cPOitem
		lCmplt		= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkCmplt.Value,'Cmplt')
		lCncld		= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkCncld.Value,'Cncld')
		
		*lIntP		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')
		lRE			= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkRE.Value,'RE')
		cSOitem		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		cPOitem		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		
		PRIVATE dStartDate, dDueDate, dFinishDate, cSalesRep
		dStartDate	= PrepareSQLDate(ThisFormSet.frmWorkOrder.txtStartDate.Value,'StartDate')
		dDueDate	= PrepareSQLDate(ThisFormSet.frmWorkOrder.txtDueDate.Value,'DueDate')
		dFinishDate = CTOD('')
		cSalesRep	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSalesRep.Value,'SalesRep',20)
		
		IF dStartDate < CTOD('01/01/01')
			dStartDate = DATE()
			ThisFormSet.frmWorkOrder.txtStartDate.Value = DATE()
		ENDIF
		
		PRIVATE llPrc_Stock, lStkConsumed
		llPrc_Stock	 = PrepareSQLlogic(ThisFormSet.frmWorkOrder.chklPrc_Stock.Value,'lPrc_Stock')
		lStkConsumed = PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkStkConsumed.Value,'StkConsumed')
		
		*These are Read Only, disabled
		*PRIVATE lID_Stock, lStockConsumed
		*lID_Stock		
		*lStockConsumed
		
		PRIVATE lComplete, lCancelled, lfPrint, lfPRecv, lfMod, nAdmendment, nWOD
		lComplete = PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfCmplt.Value,'fCmplt')  	&&lCmplt is WO -lComplete is WO Detail
		lCancelled	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfCncld.Value,'fCncld')	&&lCncld is WO -lCancelled is Detail
		lfPrint	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfPrint.Value,'fPrint')
		lfPRecv	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfpRecv.Value,'fPRecv')
		lfMod	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfMod.Value,'fMod')
		nAdmendment	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfRev.Value,'fRev',-1)
		nWOD	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		
		*******************
		*Check Data
		PRIVATE lOK
		lOK = .T.
		
		********
		IF nWO > 0
			*Check WO Past
			
			*DID lCncld change, is this allowed?
			IF lCncld 
				*is now Cancelled
				IF Count_WOinWO( nWO, ThisFormSet.nConnHandle, "CANCELLED" ) > 0 &&was already cancelled
					*no change
				ELSE
					*Try to mark as Cancelled
					*
				ENDIF	
			ELSE
				*is not Cancelled
				IF Count_WOinWO( nWO, ThisFormSet.nConnHandle, "CANCELLED" ) > 0 &&was already cancelled
					*Try to mark as NOT Cancelled
					*
				ELSE
					*no change
				ENDIF	
			ENDIF
		
			*DID lCmplt change, is this allowed?
			IF lCmplt 
				*is now Complete
				IF Count_WOinWO( nWO, ThisFormSet.nConnHandle, "COMPLETE" ) > 0 &&was already Complete
					*no change
				ELSE
					*Try to mark as Complete
					*
				ENDIF	
			ELSE
				*is not Complete
				IF Count_WOinWO( nWO, ThisFormSet.nConnHandle, "COMPLETE" ) > 0 &&was already Complete
					*Try to mark as NOT Complete
					*
				ELSE
					*no change
				ENDIF	
			ENDIF
		ENDIF
		
		IF LEN(cCC) = 0
			MESSAGEBOX("Condition Code was not set."+CHR(13)+"Automatically set to 1-Ann",0,"Saving CC as 1")
			cCC = '1'
		ENDIF
		
		*****************
		*End Check
		IF NOT lOK
			RETURN .F.
		ENDIF
		*****************
		*Ready for Save.
		
		PRIVATE lWOexists
		lWOexists = .F.
		PRIVATE cSQL, nSQLEXEC 
		
		IF nWO > 0
			*Check for existing WO
		
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder WHERE WO = "+STR(nWO)
		
			IF USED("tmpCountWO")	
				USE IN tmpCountWO
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpCountWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountWO')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpCountWO')
				IF tmpCountWO.Cntd > 0
					lWOexists = .T.
				ENDIF
				USE IN tmpCountWO
			ENDIF
		ENDIF
		
		
		IF NOT lWOexists
			*INSERT WO
			IF USED("InsertWO")	
				USE IN InsertWO
			ENDIF
			SELECT 0
		
			cSQL = "EXEC dbo.p_WorkOrder_Ins "
			cSQL = cSQL + " @Descript='"+cDescript+"'"
			cSQL = cSQL + ",@SOitem='"+cSoItem+"'"
			cSQL = cSQL + ",@POitem='"+cPoItem+"'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'InsertWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'InsertWO' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "InsertWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "InsertWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'InsertWO')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('InsertWO')
				IF RECCOUNT('InsertWO')>0
					nWO = PrepareSQLnum(InsertWO.EXP,'WO',-3)
					IF nWO > 0
						WAIT WINDOW "Inserted WO "+ALLTRIM(STR(nWO))+" into table." TIMEOUT 1
					ENDIF
				ENDIF
				USE IN InsertWO
			ENDIF
		ENDIF
		
		IF nWO > 0
			PRIVATE nrtr_ID 
			nrtr_ID = get_rtr_ID('WO',nWO )
			
			IF Proper_SO_item(cSoItem) <>  Proper_SO_item('')
				*Make the WO router
				ThisFormSet.Make_WO_rtr_Detail_from_SOitem(cSOitem,nWO,nrtr_ID)	
			ENDIF
		ENDIF
		IF nWO > 0
			IF lfPRecv
				*Was marked as Print received, increment the fRev
				nAdmendment = nAdmendment + 1
			ENDIF
			
			
			*UPDATE WorkOrder
			cSQLu = "UPDATE dbo.WorkOrder SET"
		*	cSQLu = cSQLu + " [EnterDate]  --Never update
			cSQLu = cSQLu + " [SalesRep]='"+cSalesRep+"'"
			cSQLu = cSQLu + ",[StartDate]='"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
			cSQLu = cSQLu + ",[DueDate]='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		*	cSQLu = cSQLu + ",[FinishDate]='"+IIF(EMPTY(dFinishDate),'',DTOC(fFinishDate))+"'"
			cSQLu = cSQLu + ",Descript='"+cDescript+"'"
			cSQLu = cSQLu + ",Notes='"+cNotes+"'"
			cSQLu = cSQLu + ",SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
			cSQLu = cSQLu + ",POitem = dbo.f_ProperPOitem('"+cPoItem+"')"
			cSQLu = cSQLu + ",[sPieces]="+STR(nPieces)
			cSQLu = cSQLu + ",[sAlloy]='"+cAlloy+"'"
			cSQLu = cSQLu + ",[sForm]='"+cForm+"'"
			cSQLu = cSQLu + ",[sCC]='"+cCC+"'"
			cSQLu = cSQLu + ",[sCL]='"+cCL+"'"
			cSQLu = cSQLu + ",[sThck]="+STR(nThck,10,4)
			cSQLu = cSQLu + ",[sSz2]="+STR(nSz2,9,3)
			cSQLu = cSQLu + ",[sSz3]="+STR(nSz3,9,3)
			cSQLu = cSQLu + ",pinSWeight="+IIF(lpinSWeight,'1','0')
			cSQLu = cSQLu + ",[sWeight]="+STR(nWeight,7,1)
		*	cSQLu = cSQLu + ",[sID_Detail_Process]="+STR(nID_Detail_Process)
		*	cSQLu = cSQLu + ",[sID_Detail]="+STR(nID_Detail)
		*	cSQLu = cSQLu + ",[IntP]="+IIF(lIntP,'1','0')
			cSQLu = cSQLu + ",[RE]="+IIF(lRE,'1','0')
			cSQLu = cSQLu + ",lPrc_Stock="+IIF(llPrc_Stock,'1','0')
			cSQLu = cSQLu + ",StkConsumed="+IIF(lStkConsumed,'1','0')
			
			cSQLu = cSQLu + ",Changing=1"
			cSQLu = cSQLu + ",ShopRecv=0"
			cSQLu = cSQLu + ",Amendment="+STR(nAdmendment)
			*cSQLu = cSQLu + ",RcvdE=	&&Good News Email
			cSQLu = cSQLu + ",PrintedWO=0"
			cSQLu = cSQLu + ",sHeat='"+cHeat+"'"
			
			cSQLu = cSQLu + " WHERE WO= "+STR(nWO)
			 
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu , ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
			ELSE
				WAIT WINDOW "Saved data to WO "+ALLTRIM(STR(nWO)) NOWAIT
				
				***********************************************
				*Remove WO=0 from All Sales records, then add back if real SOitem
				cSQL = "UPDATE dbo.Sales SET WO=0"
				*cSQL = cSQL + ",IntP=0 " 
				cSQL = cSQL + " WHERE WO="+STR(nWO)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF		
		
				IF Proper_SO_item(cSoItem) != Proper_SO_item("")
					*Update SO with WO
					cSQL = "UPDATE dbo.Sales SET WO="+STR(nWO)
					*cSQL = cSQL + ",IntP="+IIF(lIntP,"1","0") 
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF
				ENDIF
				
				***********************************************
				*SET WO=0 on All PurchaseOrders, then add back if real POitem  
				*This POitem belongs to Start, cannot tell from POitem used for Finish!
				*ThisFormSet.frmWorkOrder.txtPOitem.Value
				
				cSQL = "UPDATE dbo.PurchaseOrder SET WO=0"
				*cSQL = cSQL + ",IntP=0"
				cSQL = cSQL + " WHERE WO="+STR(nWO)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF		
				
		
				IF Proper_PO_item(cPoItem) != Proper_PO_item("")
					*Update PO with WO
					cSQL = "UPDATE dbo.PurchaseOrder SET WO="+STR(nWO)
					*cSQL = cSQL + ",IntP="+IIF(lIntP,"1","0")
					cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF			
				ENDIF
				
				**************************************
				ThisFormSet.Save_Selected_Process(nWO)
				
				**************************************
				*-- added POitem check!  
				ThisFormSet.Save_WO_Incm_Prc(nWO,cPOitem)
				
				***********************************************
				
				ThisFormSet.SaveAdd_rtr_WO(nWO)
				
				***********************************************
				ThisFormset.frmWorkOrder.chkfPrint.Value	= 0
				ThisFormset.frmWorkOrder.chkfpRecv.Value	= 0
				ThisFormset.frmWorkOrder.chkfMod.Value	= 1
				ThisFormset.frmWorkOrder.txtfRev.Value	= nAdmendment
				
				ThisFormSet.SaveAddDetail(.T.)
				
				***********************************************
				WAIT WINDOW "Saved WO "+ALLTRIM(STR(nWO))+" !" TIMEOUT 1
				
			ENDIF
			
		ELSE
			MESSAGEBOX("No WorkOrder Number",0+16,"Cannot Save")
		ENDIF
		
		*******************
		PRIVATE nWO_Detail, nFinishLot, cFinishM
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		
		IF nWO > 0
			IF nWO_Detail > 0
				IF nFinishLot > 0
					IF LEN(cFinishM) > 0
						ThisFormSet.ReCheck_FinishLot()
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE saveadd_rtr_wo
		PARAMETERS nWO
		*ThisFormSet.SaveAdd_rtr_WO(nWO)
		
		IF VARTYPE(nWO) != "N"
			TrackError("ThisFormSet.SaveAdd_rtr_WO( nWO ) did not get WO Parameters ","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		***************************************************
		** This is now done in Lst_Process Insert and Update trigger for 'SELECTED'
		** Trigger calls EXEC Router.dbo.p_rtr_Select_Material
		
		RETURN .T.
		
		
		
		
	ENDPROC

	PROCEDURE saveadd_rtr_wo_detail
		PARAMETERS nWO_Detail
		*ThisFormSet.SaveAdd_rtr_WO_Detail(nWO_Detail)
		
		IF VARTYPE(nWO_Detail) != "N"
			TrackError("ThisFormSet.SaveAdd_rtr_WO_Detail( nWO_Detail ) did not get WO_Detail Parameter ","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE lWODexists 
		lWODexists = .F.
		PRIVATE biRTR_ID
		biRTR_ID = 0
		
		*This code will enter a 'Select Material' - When the Material is actually selected,
		* it is updated with the Selected TBL and Proc_ID
		
		*INSERT rtr_Detail Oper_ID 523 'Select Material'
		*               pcOrder, pnOrder, pnDetail, pnOper_ID, pcOper_Note, plStart, pConnHandle
		*lOK = set_rtr_Detail_Oper ('WO',1000,100,523,'SELECT S ID_Detail_Process=37724',.T.,nConn)
		*lOK = set_rtr_Detail_Oper ('WOD',nWO_Detail,100,523,'SELECT S ID_Detail_Process=37724',.T.,nConn)
		
		***************************************************
		** This is now done in Lst_Process Insert and Update trigger for 'SELECTED'
		** Trigger calls EXEC Router.dbo.p_rtr_Select_Material
		
		RETURN .T.
		
		
	ENDPROC

	PROCEDURE savemachlot
		PARAMETERS cMach, nLot, nWO_Detail
		*ThisForm.SaveMachLot( cMach, nLot, nWO_Detail )
		*Also see: ThisFormSet.Reset_MFG_Lot(cFinishM,nFinishLot)
			
		cMach	= PrepareSQLtxt(cMach,'MACH',20)
		nLot	= PrepareSQLnum(nLot,'LOT',-3)
		nWO_Detail = PrepareSQLnum(nWO_Detail,'WO_Detail',-3)
		
		
		IF EMPTY(cMach)
			TrackError("ThisFormSet.SaveMachLot( cMach, nLot, nWO_Detail ) did not get Mach Parameters ","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF nLot < 1 
			TrackError("ThisFormSet.SaveMachLot( cMach, nLot, nWO_Detail ) did not get nLot Parameters ","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF nWO_Detail < 1
			TrackError("ThisFormSet.SaveMachLot( cMach, nLot, nWO_Detail ) did not get nWO_Detail Parameters ","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		
		*A new lot has been created.
		*Save WO_Detail 
		*write to screen
		
		cSQL = "UPDATE dbo.WorkOrder_Detail "
		cSQL = cSQL + " SET FinishM = '"+cMach+"'"
		cSQL = cSQL + ",FinishLot = "+ALLTRIM(STR(nLOT)) 
		cSQL = cSQL + " WHERE WO_Detail = "+STR(nWO_Detail)
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORMSET.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
		 	
			ThisFormSet.frmWorkOrder.txtFinishLot.Value	= nLot
			ThisFormSet.frmWorkOrder.cmbFinishM.Value 	= cMach
			ThisFormSet.frmWorkOrder.txtFinishLot.Refresh
			ThisFormSet.frmWorkOrder.cmbFinishM.Refresh
			
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE savestocklstid_detail
		PARAMETERS pWhat, nID_Detail
		*ThisFormSet.SaveStockLstID_Detail('START',nID)
		
		*!*	IF VARTYPE(pWhat) !="C"
		*!*		MESSAGEBOX("ERROR")
		*!*		
		*!*		RETURN
		*!*	ENDIF
		*!*	IF VARTYPE(nID_Detail) !="N"
		*!*		MESSAGEBOX("ERROR")
		*!*		
		*!*		RETURN
		*!*	ENDIF
		
		*!*	PRIVATE nWO
		*!*	nWO = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		
		*!*	PRIVATE lWOexists
		*!*	lWOexists = .F.
		*!*	PRIVATE cSQL, nSQLEXEC 
		
		
		*!*	IF nWO = 0
		*!*		nWO = GetNextWorkOrder(ThisFormSet.nConnhandle)
		*!*	ENDIF
		
		
		
		*!*	IF nWO > 0
		*!*		*Check for existing WO
		
		*!*		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder WHERE WO = "+STR(nWO)
		
		*!*		IF USED("tmpCountWO")	
		*!*			USE IN tmpCountWO
		*!*		ENDIF
		*!*		SELECT 0
		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountWO')
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpCountWO')
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFindPO_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFindPO_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountWO')
		*RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*		ENDIF
		*!*		IF USED('tmpCountWO')
		*!*			IF tmpCountWO.Cntd > 0
		*!*				lWOexists = .T.
		*!*			ENDIF
		*!*			USE IN tmpCountWO
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	***************************
		*!*	PRIVATE nID_Detail_Process 
		*!*	nID_Detail_Process = 0
		
		*!*	IF lWOexists
		*!*		*nID_Detail_Process
		*!*		
		*!*		cSQL = "SELECT P.ID_Detail_Process "
		*!*		cSQL = cSQL + " FROM dbo.StockLst_Process P "
		*!*	*	cSQL = cSQL + " FROM dbo.BrokerLst_Process "
		*!*		cSQL = cSQL + " WHERE P.ID_Detail = "+STR(nID_Detail)
		*!*		cSQL = cSQL + " AND D.WO = "+STR(nWO)
		
		*!*		IF USED("tmpnID_Detail_Process")	
		*!*			USE IN tmpnID_Detail_Process
		*!*		ENDIF
		*!*		SELECT 0
		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpnID_Detail_Process')
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpnID_Detail_Process')
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFindPO_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFindPO_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpnID_Detail_Process')
		*RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*		ENDIF
		*!*		IF USED('tmpnID_Detail_Process')
		*!*			IF RECCOUNT('tmpnID_Detail_Process') > 0
		*!*				nID_Detail_Process = tmpnID_Detail_Process.ID_Detail_Process 
		*!*				IF UPPER(pWhat) = "START"
		*!*					*ThisFormSet.frmWorkOrder.txtID_Detail_Process.Value = nID_Detail_Process
		*!*					*ThisFormSet.frmWorkOrder.txtID_Detail.Value = nID_Detail
		*!*				ELSE
		*!*					*ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value = nID_Detail_Process
		*!*					*ThisFormSet.frmWorkOrder.txtFID_Detail.Value = nID_Detail
		*!*				IF nID_Detail > 0
		*!*					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(0,128,255)
		*!*				ELSE
		*!*					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(240,240,240)
		*!*				ENDIF	
		*!*				ENDIF
		*!*			ENDIF
		*!*			USE IN tmpnID_Detail_Process
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	***************************
		*!*	IF lWOexists
		*!*		*UPDATE WorkOrder
		*!*		
		*!*		IF UPPER(pWhat) = "START"
		*!*			cSQLu = "UPDATE dbo.WorkOrder SET "
		*!*			cSQLu = cSQLu + " sID_Detail = "+STR(nID_Detail)
		*!*			IF nID_Detail_Process > 0
		*!*				cSQLu = cSQLu + ", sID_Detail_Process = "+STR(nID_Detail_Process)
		*!*			ENDIF
		*!*			cSQLu = cSQLu + " WHERE WO= "+STR(nWO)
		*!*		ENDIF
		*!*		IF UPPER(pWhat) = "FINISH"
		*!*			cSQLu = "UPDATE dbo.WorkOrder_Detail SET "
		*!*			cSQLu = cSQLu + " fID_Detail = "+STR(nID_Detail)
		*!*			IF nID_Detail_Process > 0
		*!*				cSQLu = cSQLu + ", fID_Detail_Process = "+STR(nID_Detail_Process)
		*!*			ENDIF
		*!*			cSQLu = cSQLu + " WHERE WO_Detail = "+STR(nWO_Detail)
		*!*		ENDIF	
		*!*		
		*!*		 
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFindPO_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFindPO_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQLu,ThisFormSet.nConnHandle, nSQLEXEC, '')
		*RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

	PROCEDURE save_selected_process		&& Apply WO when selected.  Update process when SO or PO selected.
		PARAMETERS pWO
		*ThisFormSet.Save_Selected_Process(nWO)
		PRIVATE nWO
		nWO = PrepareSQLnum(pWO,'WO',-3)
		
		ThisFormSet.Load_tmpSPStart(nWO)
		*Finds stock that has been Selected for WO or SOitem and not POitem
		
		IF nWO = 0
			RETURN .F.
		ENDIF
		
		*look for records to update, 'needs WO'
		IF USED("tmpSPStart")
			IF RECCOUNT("tmpSPStart") > 0
				SELECT tmpSPStart
				
				PRIVATE nCurrRec
				nCurrRec = RECNO("tmpSPStart")
				
				PRIVATE cSQL, nSQLEXEC 
				cSQL= ''
				
				PRIVATE nID_Detail_Process, cTBL
				ID_Detail_Process = 0
				cTBL = ''
				
				SCAN
					IF PrepareSQLnum(tmpSPStart.WO,'WO',-3) = 0
						*store nWO to this Process
						nID_Detail_Process = PrepareSQLnum(tmpSPStart.ID_Detail_Process,'ID_Detail_Process',-3)
						cTBL = PrepareSQLtxt(tmpSPStart.TBL,'TBL',1)
						
						DO CASE
						CASE cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Process "
						CASE cTBL = "S"
							cSQL = "UPDATE dbo.BrokerLst_Process "
						CASE cTBL = "S"
							cSQL = "UPDATE dbo.WIPLst_Process "
						ENDCASE
						cSQL = cSQL +" SET WO = "+STR(nWO)
						*WO_Detail
						cSQL = cSQL +" WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						ELSE
							SELECT tmpSPStart
							REPLACE tmpSPStart.WO WITH nWO
							
						ENDIF
		
					ENDIF
				ENDSCAN
				*
				IF nCurrRec <= RECCOUNT("tmpSPStart")
					GOTO nCurrRec
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE save_wod_incm_prc		&& Save_Incoming_Prc_WOD
		PARAMETERS pWO_Detail
		*NOW Save_WOD_Incm_PRC()
		*WAS Save_Incoming_Prc_WOD(nWO_Detail)
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pWO_Detail,'WO_Detail',-3)
		IF nWO_Detail = 0
			RETURN .F.
		ENDIF
		
		
		PRIVATE cPOitem, cfPOitem
		cPOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		cfPOitem= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfPOitem.Value,'POitem',12)
		
		IF USED("tmpPrc_Incoming")	
			USE IN tmpPrc_Incoming
			*ThisFormSet.frmWorkOrder.cmdWO_StockProc.Visible = .F.
		ENDIF
		SELECT 0
		
		cSQL = " SELECT P.*, 'S' AS TBL "
		cSQL = cSQL +" ,D.Dim1,D.Dim2,D.Dim3,S_QTY "
		cSQL = cSQL +" ,M.Heat "
		cSQL = cSQL +" FROM dbo.StockLst_Process P "
		cSQL = cSQL +" INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL +" INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
		cSQL = cSQL +" WHERE ( "
		IF nWO_Detail > 0
			cSQL = cSQL +" P.WO_Detail = "+STR(nWO_Detail)
		ENDIF
		IF Proper_PO_item(cPOitem) != Proper_PO_item('')
			IF nWO_Detail > 0
				cSQL = cSQL +" OR "
			ENDIF
			cSQL = cSQL +" P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		ENDIF
		IF Proper_PO_item(cfPOitem) != Proper_PO_item('')
			IF nWO_Detail > 0 OR Proper_PO_item(cPOitem) != Proper_PO_item('')
				cSQL = cSQL +" OR "
			ENDIF
			cSQL = cSQL +" P.PO_item = dbo.f_ProperPOitem('"+cfPOitem+"')"
		ENDIF
		cSQL = cSQL +")"
		
		cSQL = cSQL +" AND ( P.Process_ID = 'INCOMING' OR P.Process_ID='PARTRECV' OR P.Process_ID='NOT2HPA' "
		cSQL = cSQL +")"
		
		cSQL = cSQL +" UNION "
		cSQL = cSQL +" SELECT P.*, 'B' AS TBL "
		cSQL = cSQL +" ,D.Dim1,D.Dim2,D.Dim3,D.S_QTY "
		cSQL = cSQL +" ,M.Heat "
		cSQL = cSQL +" FROM dbo.BrokerLst_Process P"
		cSQL = cSQL +" INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL +" INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
		cSQL = cSQL +" WHERE ( "
		IF nWO_Detail > 0
			cSQL = cSQL +" P.WO_Detail = "+STR(nWO_Detail)
		ENDIF
		IF Proper_PO_item(cPOitem) != Proper_PO_item('')
			IF nWO_Detail > 0
				cSQL = cSQL +" OR "
			ENDIF
			cSQL = cSQL +" P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		ENDIF
		IF Proper_PO_item(cfPOitem) != Proper_PO_item('')
			IF nWO_Detail > 0 OR Proper_PO_item(cPOitem) != Proper_PO_item('')
				cSQL = cSQL +" OR "
			ENDIF
			cSQL = cSQL +" P.PO_item = dbo.f_ProperPOitem('"+cfPOitem+"')"
		ENDIF
		cSQL = cSQL +")"
		
		cSQL = cSQL +" AND ( P.Process_ID = 'INCOMING' OR P.Process_ID='PARTRECV' OR P.Process_ID='NOT2HPA' "
		cSQL = cSQL +")"
		
		cSQL = cSQL +" UNION "
		cSQL = cSQL +" SELECT P.*, 'W' AS TBL "
		cSQL = cSQL +" ,D.Dim1,D.Dim2,D.Dim3,D.S_QTY "
		cSQL = cSQL +" ,M.Heat "
		cSQL = cSQL +" FROM dbo.WIPLst_Process P"
		cSQL = cSQL +" INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL +" INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
		cSQL = cSQL +" WHERE ( "
		IF nWO_Detail > 0
			cSQL = cSQL +" P.WO_Detail = "+STR(nWO_Detail)
		ENDIF
		IF Proper_PO_item(cPOitem) != Proper_PO_item('')
			IF nWO_Detail > 0
				cSQL = cSQL +" OR "
			ENDIF
			cSQL = cSQL +" P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		ENDIF
		IF Proper_PO_item(cfPOitem) != Proper_PO_item('')
			IF nWO_Detail > 0 OR Proper_PO_item(cPOitem) != Proper_PO_item('')
				cSQL = cSQL +" OR "
			ENDIF
			cSQL = cSQL +" P.PO_item = dbo.f_ProperPOitem('"+cfPOitem+"')"
		ENDIF
		cSQL = cSQL +")"
		
		cSQL = cSQL +" AND ( P.Process_ID = 'INCOMING' OR P.Process_ID='PARTRECV' OR P.Process_ID='NOT2HPA' "
		cSQL = cSQL +")"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPrc_Incoming')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPrc_Incoming')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPrc_Incoming")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPrc_Incoming")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPrc_Incoming')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		
		*look for records to update, 'needs WO_Detail'
		IF USED("tmpPrc_Incoming")
			IF RECCOUNT("tmpPrc_Incoming") > 0
				SELECT tmpPrc_Incoming
				
				PRIVATE nCurrRec
				nCurrRec = RECNO("tmpPrc_Incoming")
				
				PRIVATE cSQL, nSQLEXEC 
				cSQL= ''
				
				PRIVATE nID_Detail_Process, cTBL
				ID_Detail_Process = 0
				cTBL = ''
				
				SCAN
					IF PrepareSQLnum(tmpPrc_Incoming.WO_Detail,'WO_Detail',-3) = 0
						*store nWO_Detail to this Process
						nID_Detail_Process = PrepareSQLnum(tmpPrc_Incoming.ID_Detail_Process,'ID_Detail_Process',-3)
						cTBL = PrepareSQLtxt(tmpPrc_Incoming.TBL,'TBL',1)
						
						DO CASE
						CASE cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Process "
						CASE cTBL = "B"
							cSQL = "UPDATE dbo.BrokerLst_Process "
						CASE cTBL = "W"
							cSQL = "UPDATE dbo.WIPLst_Process "
						ENDCASE
						cSQL = cSQL +" SET WO_Detail = "+STR(nWO_Detail)
						cSQL = cSQL +" WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPrc_Incoming')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPrc_Incoming')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPrc_Incoming")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPrc_Incoming")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPrc_Incoming')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						ELSE
							REPLACE tmpPrc_Incoming.WO_Detail WITH nWO_Detail
							
							cSQL = "UPDATE dbo.WorkOrder_Detail "
							cSQL = cSQL +" SET stkListed = 1 "
							cSQL = cSQL +" WHERE WO_Detail = "+STR(nWO_Detail)
		
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPrc_Incoming')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPrc_Incoming')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPrc_Incoming")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPrc_Incoming")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPrc_Incoming')
								RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
							ELSE
								ThisFormSet.frmWorkOrder.chkStkListed.Value = 1
							ENDIF
						ENDIF
		
					ENDIF
				ENDSCAN
				*
				IF nCurrRec <= RECCOUNT("tmpPrc_Incoming")
					GOTO nCurrRec
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE save_wo_incm_prc
		PARAMETERS pWO, pPOitem
		*NOW Save_WO_Incm_Prc(pWO, pPOitem)
		*WAS ThisFormSet.Save_Incoming_Prc_WO(nWO)
		
		PRIVATE nWO
		nWO = PrepareSQLnum(pWO,'WO',-3)
		IF nWO = 0
			RETURN
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(pPOitem,'POitem',12)
		IF Proper_PO_item(cPOitem) = Proper_PO_item('')
			RETURN 
		ENDIF
		
		*Now do sPOitem
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "UPDATE dbo.StockLst_Process "
		cSQL = cSQL +" SET WO = "+STR(nWO)
		cSQL = cSQL +" WHERE Process_ID='INCOMING '"
		cSQL = cSQL +" AND ISNULL(WO,0) = 0 "
		cSQL = cSQL +" AND PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
		
		ENDIF
		
		
	ENDPROC

	PROCEDURE setvfrmworkorder		&& Set Visiblity for frmWorkOrder Screens
		PARAMETERS lVisible
		*ThisFormSet.SetVfrmWorkOrder(.F.)
		
		IF lVisible
			ThisFormSet.frmWorkOrder.Visible = .T.
			*ThisFormSet.RefreshCompletedID_Detail_ProcessP(nID_Detail_ProcessP)
			
		ELSE
		
			ThisFormSet.frmWorkOrder.Visible = .F.
			
			*frmStockUsed was incorrect when frmWorkOrder started. Solution: clear when frmWorkOrder ends.
			ThisFormSet.Refresh_CompletedID_Detail_ProcessP(0)	&&Clear data on frmStockUsed
			
			ThisFormSet.frmStockUsed.Visible = .F.
			ThisFormSet.frmStock_Produced.Visible = .F.
			
			
			ThisFormset.frmSTK_Detail.Visible = .F.
			ThisFormSet.frmLogView.Visible = .F.
			ThisFormSet.frmProjected.Visible = .F.
			ThisFormSet.frmRouter.Visible = .F.
			ThisFormSet.frmRouterDetailOrder.Visible = .F.
			ThisFormSet.frmRedArea.Visible = .F.
			ThisFormSet.frmGFMlog.Visible = .F.
			ThisFormSet.frmStartingStock.Visible = .F.
			ThisFormSet.frmTollWorkInquire.Visible = .F.
			ThisFormSet.frmStockWO.Visible = .F.
		
		
		ENDIF
		
		*ThisFormSet.SetVfrmWorkOrder(.T.)
		*ThisFormSet.SetVfrmWorkOrder(.F.)
		*ThisFormSet.frmWorkOrder.Visible = .F.
	ENDPROC

