		ENDIF
		
	ENDPROC

	PROCEDURE getheat_wo
		PARAMETERS nWO
		*ThisFormSet.getHeat_WO
		
		PRIVATE cHeat
		cHeat = ''
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('tmpCountSEL_WO')
			USE IN tmpCountSEL_WO
		ENDIF
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		SELECT 0
		cSQL = "SELECT M.Heat FROM "
		cSQL = cSQL + " dbo.StockLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		cSQL = cSQL + " WHERE P.WO = "+STR(nWO)
		cSQL = cSQL + " AND P.Process_ID = 'SELECTED' "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountSEL_WO' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountSEL_WO' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountSEL_WO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountSEL_WO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnhandle,nSQLEXEC, 'tmpCountSEL_WO')
				RecordError(nSQLEXEC,"SQL Error" ,"Proc_StockLst:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
				
				IF USED('tmpCountSEL_WO')
					USE IN tmpCountSEL_WO
				ENDIF
				RETURN 0
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		IF nSQLEXEC > 0
			IF USED('tmpCountSEL_WO')
				IF RECCOUNT('tmpCountSEL_WO') > 0
					cHeat = tmpCountSEL_WO.Heat
				ENDIF
				USE IN tmpCountSEL_WO
			ENDIF
		ENDIF
		
		**********************************
		**********************************
		IF EMPTY(cHeat)
		
			cSQL = " SELECT Heat FROM dbo.Sales_Detail WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO="+STR(nWO)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountSEL_WO' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, 'tmpCountSEL_WO' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountSEL_WO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "tmpCountSEL_WO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnhandle,nSQLEXEC, 'tmpCountSEL_WO')
					RecordError(nSQLEXEC,"SQL Error" ,"Proc_StockLst:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
					
					IF USED('tmpCountSEL_WO')
						USE IN tmpCountSEL_WO
					ENDIF
					RETURN 0
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
		
			IF nSQLEXEC > 0
				IF USED('tmpCountSEL_WO')
					IF RECCOUNT('tmpCountSEL_WO') > 0
						cHeat = tmpCountSEL_WO.Heat
					ENDIF
					USE IN tmpCountSEL_WO
				ENDIF
			ENDIF
		
		ENDIF
		**********************************
		**********************************
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ELSE
				RecordTest("Record Test Data.","Proc_StockLst:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
			ENDIF
		ENDIF
		
		RETURN cHeat
	ENDPROC

	PROCEDURE grab_foundstk
		PARAMETERS lFoundStk
		*ThisForm.Grab_foundStk()    This code does a loop thrue all Stock Selected for WO!
		*Combines ThisFormSet.Make_Process_Grab(nID_Detail_Process,cTBL) IN Loop
		*lFoundStk = PrepareSQLchk(This.Value,'FoundStk')
		lFoundStk = .T.	 &&True means it marks Vs Unmarks
		
		PRIVATE cSOitem, nSalesNum, nWO, cPOitem, cWhat, cComment 
		cSOitem		= Proper_SO_Item('')
		nSalesNum	= 0
		nWO			= ThisFormSet.nWO
		cPOitem		= Proper_PO_item('')
		cWhat 		= 'Found Stock' &&CHAR(20)
		
		PRIVATE nID, nID_Detail, nID_Detail_Process, cTBL
		nID_Detail		   = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSPS_ID_Detail.Value,'ID_Detail',-3)
		nID_Detail_Process = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSPS_Process_ID.Value,'ID_Detail_Process',-3)
		cTBL		= 'S'
		nID			= Get_ID_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnHandle)
		
		*IF nID_Detail_Process = 0
		*	MESSAGEBOX("Did not find the SELECTED Stock",0,"Cannot Continue")
		*	TrackError("Did not find the SELECTED Stock"+CHR(13)+"WO:"+STR(nWO),"Did not find the SELECTED Stock", PROGRAM(), LINENO(1))
		*	RETURN .F.
		*ENDIF
		
		cComment = "Stock:"+cTBL+" "+ALLTRIM(STR(nID))+" "+ALLTRIM(STR(nID_Detail))+" Prc:"+ALLTRIM(STR(nID_Detail_Process))
		IF nWO>0
			cComment = cComment + " WO:"+ALLTRIM(STR(nWO))
		ENDIF
		cWhat 		= 'Found Stock WO'+ALLTRIM(STR(nWO)) &&CHAR(20)
		
		
		PRIVATE lOK
		lOK = .T.
		PRIVATE cSQL, nSQLEXEC 
		
		
		********************************************
		*  WorkOrder might SELECT more than a Single Stock Master
		* need to FIND the ID_Detail_Process 
		********************************************
		
		IF USED("tmpWO_Proc")
			USE IN tmpWO_Proc
		ENDIF
		SELECT 0
		
		**Get the Process SELECT for WO
		cSQL = "SELECT DISTINCT ID_Detail_Process FROM dbo.StockLst_Process "
		cSQL = cSQL + " WHERE WO="+STR(nWO)
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWO_Proc' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Proc' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Proc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Proc")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		PRIVATE lOK
		lOK = .T.
		IF nSQLEXEC < 0
			IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Proc')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				lOK = .F.
			ENDIF
		ENDIF
		
		IF lOK
			SELECT tmpWO_Proc
			SCAN
				IF NOT lOK
					EXIT
				ENDIF
						
				********************************************
				*Update Proc
				********************************************
				nID_Detail_Process = PrepareSQLnum(tmpWO_Proc.ID_Detail_Process,'ID_Detail_Process',-3)
				
				cSQL = "UPDATE dbo.StockLst_Process "
				IF lFoundStk 
					cSQL = cSQL + " SET FoundSTK = GETDATE() "
				ELSE
					cSQL = cSQL + " SET FoundSTK = NULL "
				ENDIF
				cSQL = cSQL + " WHERE ID_Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))
		
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'CntProcess')
						RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
						lOK = .F.
					ENDIF
				ENDIF
		
				IF lOK
					nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL, ThisFormSet.nConnHandle)
					nID = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnHandle)	
					cComment = "Stock:"+cTBL+" ID:"+ALLTRIM(STR(nID))+" ID_D:"+ALLTRIM(STR(nID_Detail))+" Prc:"+ALLTRIM(STR(nID_Detail_Process))+ " WO:"+ALLTRIM(STR(nWO))
					
					IF lFoundStk 
						cComment = 'Grabbed '+cComment
					ELSE
						cComment = 'RemoveGrab '+cComment
					ENDIF		
					SaveTo_WorkOrder_Notes(nWO, 0, cComment, ThisFormSet.nConnHandle )
					lOK = set_rtr_Detail_Oper('WO',nWO,105,522,cComment,.T.,ThisFormSet.nConnHandle)
		
		
					IF lOK
		*				IF lFoundStk 
						*Save Grab Found Stock Process TO dbo.StockLst_Process_Grab
							
							
							PRIVATE cSQLi 
							cSQLi = "EXEC dbo.p_Lst_Process_Grab_ins "
							cSQLi = cSQLi + " @ID_Detail_Process="+STR(nID_Detail_Process)+""
							cSQLi = cSQLi + ",@TBL = 'S' "
							*INSERT INTO dbo.StockLst_Process_Grab
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, '')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, '')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
		
							*MESSAGEBOX("Marked the SELECTED process as FOUND STOCK"+CHR(13)+" and Pulled stock from Rack.",0,"Grabbed")
						*ENDIF
						
						ThisFormSet.Make_Process_Grab(nID_Detail_Process,cTBL)
											
					ENDIF
				ENDIF
		
			ENDSCAN
		ENDIF
		
		
		IF USED('tmpWO_Proc')
			USE IN tmpWO_Proc
		ENDIF
		
		RETURN lOK
		
		
		
		
		
	ENDPROC

	PROCEDURE grdwo_dynamic_background
		*ThisFormSet.grdWO_Dynamic_Background()
		
		PRIVATE nColor
		
		
		nColor = RGB( 255, 255, 255 ) &&WHITE
		
		IF WorkOrder.Cncld
			nColor = RGB( 255, 0, 0 ) &&RED
		ELSE
			IF WorkOrder.Cmplt
				nColor = RGB( 192,192,192) &&Grey
			ELSE
				nColor = RGB( 255, 255, 255 ) &&WHITE
			ENDIF
		ENDIF	
		
		*!*	IF StockLst_SQL.Quarantine 
		*!*		*OR StockLst_SQL.Heat = 'A14112' OR StockLst_SQL.Heat = 'A13940' OR StockLst_SQL.Heat = 'A13939'
		*!*		
		*!*		nColor = RGB( 128,128,128 ) &&Grey
		*!*	ELSE
		*!*		IF StockLst_SQL.Prc > 0
		*!*			IF NOT ISNULL(StockLst_SQL.cPODueDate)
		*!*				nColor = RGB( 255,128,64 ) &&ORANGE
		*!*			ELSE
		*!*				nColor = RGB( 255, 0, 0 ) &&RED
		*!*			ENDIF
		*!*		ELSE
		*!*			IF StockLst_SQL.ReceivingID = 0
		
		*!*				IF StockLst_SQL.Heat = 'DUE IN'
		*!*					*Due In
		*!*					nColor = RGB( 255,255,128 ) &&YELLOW
		*!*				ELSE
		*!*					IF CTOD(StockLst_SQL.cInvCheck) < DATE()-400
		*!*						*Not check in last year
		*!*						nColor = RGB( 235, 235, 235 ) &&Light Grey
		*!*					ENDIF
		*!*					IF CTOD(StockLst_SQL.cInvCheck) = CTOD('1900-01-01 00:00:00.000')
		*!*						*Not in stock -Overrides the -400
		*!*						nColor = RGB( 128,64,64 ) &&Brown
		*!*					ENDIF
		*!*					IF CTOD(StockLst_SQL.cInvCheck) = DATE()+1
		*!*						*Wants
		*!*						nColor = RGB( 128,128,255 ) &&Blue
		*!*					ENDIF
		*!*					IF CTOD(StockLst_SQL.cInvCheck) = DATE()+2
		*!*						*Vendor
		*!*						nColor = RGB( 196,145,183 ) &&Purple
		*!*					ENDIF
		*!*					IF StockLst_SQL.FloorStatus = 'X'
		*!*						*Excess Stock - Sell off.
		*!*						nColor = RGB( 192,192,192) &&Grey
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*	*		IF StockLst_SQL.POStatus = "W"
		*!*	*			nColor = RGB( 128,255,128 ) &&Light Green
		*!*	*		ENDIF
		*!*			IF StockLst_SQL.POStatus = "P"
		*!*				nColor = RGB( 213,252,120 ) &&Light YELLOW, Green
		*!*				*nColor = RGB( 0,0,0)
		*!*				*Partial Receive, overwrites Due IN
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		RETURN nColor
	ENDPROC

	PROCEDURE Init
		PARAMETERS pWhat,pWO,pWOD,pPOitem,pSOitem,pWhatEver
		*DO FORM Forms\WorkOrder WITH "ADD",WO,WOD,POitem,SOitem,'' TO lReturn
		*DO FORM Forms\WorkOrder WITH "ADD",0,0,'501284-01','',''
		*DO FORM Forms\WorkOrder WITH "EDIT",1000,0,'','',''
		
		IF VARTYPE(pWhat) != "C"
			pWhat = 'CHOOSE'
		ENDIF
		
		SET SAFETY OFF
		
		IF VARTYPE(pWhat) != "C" AND ( VARTYPE(pWO) != "N" OR VARTYPE(pWOD) != "N" ) AND ( VARTYPE(pPOitem) != "C" OR VARTYPE(pSOitem) != "C" )
			*must have What, WO or POtime or SOitem
			*MESSAGEBOX("DO FORM Forms\WorkOrder WITH 'What',nWO,'POitem','SOitem',pWhatEver TO lReturn",0+16,"Pass Parameters")
			*RETURN
			
			pWhat = "CHOOSE"
			pWO=0
			pWOD = 0
			pPOitem=''
		
		
		*	pWhat = "EDIT"
		*	pPOitem = '   501246-01'
			
		ENDIF
		
		*Done in lst .init
		*PUBLIC ARRAY gaWO_Detail(1)
		*PUBLIC ARRAY gaSPStart(1)
		*PUBLIC ARRAY gaSPcmpltP(1)
		*PUBLIC ARRAY gaSPStartP(1)
		
		PRIVATE cPOitem, cSOitem, pWhatEver
		cPOitem = ''
		cSOitem = ''
		pWhatEver = ''
		IF VARTYPE(pPOitem) ="C"
			cPOitem = Proper_PO_item(pPOitem)
		ENDIF
		IF VARTYPE(pSOitem) ="C"
			cSOitem = Proper_SO_item(pSOitem)
		ENDIF
		IF VARTYPE(pWhatEver) ="C"
			pWhatEver = pWhatEver
		ENDIF
		
		pWO = PrepareSQLnum(pWO,'WO',-3)
		ThisFormSet.nWO = pWO
		ThisFormset.frmWorkOrder.txtWO.Value = ThisFormSet.nWO
		
		pWOD = PrepareSQLnum(pWOD,'WOD',-3)
		
		*Edit will use WO 
		*Add may use WOD, PO, or nothing
		
		IF VARTYPE(pWhat) != "C"
			pWhat = "CHOOSE"
		ENDIF
		PRIVATE cWhat2
		cWhat2 = ''
		IF AT("-",pWhat) > 0
			cWhat2 = UPPER( RIGHT(pWhat, LEN(pWhat) - AT("-",pWhat)) )
			ThisFormSet.cWhat2 = cWhat2
			pWhat = UPPER( LEFT(pWhat, AT("-",pWhat)-1) )
		ENDIF
		
		ThisFormSet.pWhat = pWhat
		
		DO CASE
		CASE UPPER(pWhat) = "CHOOSE"
			*ThisFormSet.InitChooseWO('','')
			ThisFormSet.LoadWO_frmChooseWO(cPOitem, cSOitem,pWO)
		CASE UPPER(pWhat) == "ADD_PO" OR UPPER(pWhat) == "ADD_PO-Start" 
			*Add/Edit with POitem details
			ThisFormSet.cWhat2 = "START"
			ThisFormSet.NewWO_byPOitem(cPOitem)
			
		CASE UPPER(pWhat) == "ADD_PO-Finish"
			*Add/Edit with POitem details
			ThisFormSet.cWhat2 = "FINISH"
			ThisFormSet.NewWO_byPOitem(cPOitem)
		
		CASE UPPER(pWhat) == "ADD_SO"
			*Add/Edit with SOitem details
			ThisFormSet.AddbySOitem(cPOitem, cSOitem, pWhatEver)
		CASE UPPER(pWhat) = "ADD_PO_SO"
			*Add/Edit with POitem Distribution details
			*pWhatEver is the nID_PO_SODist
			ThisFormSet.AddbyPO_SO_Dist(cPOitem, cSOitem, pWhatEver)
		
		CASE UPPER(pWhat) == "ADD"
			IF NOT EMPTY(pPOitem)
				*Add/Edit with POitem details
		
				ThisFormSet.cWhat2 = "START"
				ThisFormSet.NewWO_byPOitem(cPOitem)
			ELSE
				IF NOT EMPTY(pWhatEver)
					*Add with pWhatEver details ???
				ELSE
					*Add blank WO ???
				ENDIF
			ENDIF
		*CASE UPPER(pWhat) == "EDIT_PO"
		CASE UPPER(pWhat) == "EDIT_PO_SO"
			*********************************************************
			**Why would Edit WO for PO_SO be different from Edit WO?
		*	IF NOT EMPTY(pWhatEver)
		*		*Edit WOitem details
		*		ThisFormSet.EditbyWO_PO_SO(pWhatEver)
			IF NOT EMPTY(pWOD)
				*Edit WOitem details
				*ThisFormSet.EditbyWOD(pWOD,pWO)
				ThisFormSet.EditbyWOD(pWOD)
			ELSE
				IF NOT EMPTY(pWO)
					*Edit WO
					ThisFormSet.EditbyWO(pWO)
						ELSE
					IF NOT EMPTY(pPOitem)
						*Edit with POitem details
						ThisFormSet.EditbyPOitem(cPOitem, cSOitem, pWhatEver)
					ELSE
						MESSAGEBOX("WorkOrder 'Edit' needs parameter!",0+16,"Pass Parameters")
						RETURN
					ENDIF
				ENDIF
			ENDIF
		CASE UPPER(pWhat) == "EDIT"
			IF NOT EMPTY(pWOD)
				*Edit WOitem details
				*ThisFormSet.EditbyWOD(pWOD,pWO)
				ThisFormSet.EditbyWOD(pWOD)
			ELSE
				IF NOT EMPTY(pWO)
					*Edit WOitem details
					ThisFormSet.EditbyWO(pWO)
				ELSE
					IF NOT EMPTY(pPOitem)
						*Edit with POitem details
						ThisFormSet.EditbyPOitem(cPOitem, cSOitem, pWhatEver)
					ELSE
						MESSAGEBOX("WorkOrder 'Edit' needs parameter!",0+16,"Pass Parameters")
						RETURN
					ENDIF
				ENDIF
			ENDIF
		OTHERWISE
			ThisFormSet.pWhat = "CHOOSE"
			ThisFormSet.LoadWO_frmChooseWO(cPOitem, cSOitem, pWO)
		*	MESSAGEBOX("WorkOrder needs 'CHOOSE','ADD' or 'EDIT' parameter!",0+16,"Pass Parameters")
		*	RETURN 
		ENDCASE
		
		
		ThisFormSet.pWhat = PrepareSQLtxt(pWhat,'What',-1)
		
		
	ENDPROC

	PROCEDURE initchoosewo
		PARAMETERS pPOitem, pSOitem, pWO
		*ThisFormSet.InitChooseWO()
		
		PRIVATE cPOitem, cSOitem, nWO
		cPOitem = PrepareSQLtxt(pPOitem,'POitem',12)
		cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		nWO 	= PrepareSQLnum(pWO,'WO',-3)
		
		cPOitem = Proper_PO_Item(cPOitem)
		cSOitem = Proper_SO_Item(cSOitem)
		
		IF USED("WorkOrder")	
			USE IN WorkOrder
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT WO.* "
		cSQL = cSQL + ", ISNULL(ACWO.AC_ID,0) AS AC_ID_WO "
		cSQL = cSQL + " FROM dbo.WorkOrder WO "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WO ACWO ON WO.WO = ACWO.WO "
		cSQL = cSQL + " ORDER BY WO DESC "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'WorkOrder')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'WorkOrder')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "WorkOrder")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "WorkOrder")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'WorkOrder')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			*See INIT
		*	ThisFormSet.pgf.pgBrowse.grdWorkOrder.RecordSource = "WorkOrder"
		ENDIF
		
		SELECT WorkOrder
		PRIVATE nBestRec 
		*nBestRec = RECCOUNT('WorkOrder')  &&SQL Order Sets Record 1 as most recent
		nBestRec = 1
		
		IF cSOitem != Proper_SO_item('')
			LOCATE FOR SOitem = cSoitem
			IF FOUND()
				nBestRec = RECNO('WorkOrder')
			ENDIF
		ENDIF
		
		IF Proper_PO_Item(cPOitem) != Proper_PO_item('')
			LOCATE FOR fPOitem = cPoitem
			IF FOUND()
				nBestRec = RECNO('WorkOrder')
			ENDIF
		ENDIF
		
		IF Proper_PO_Item(cPOitem) != Proper_PO_item('')
			LOCATE FOR POitem = cPoitem
			IF FOUND()
				nBestRec = RECNO('WorkOrder')
			ENDIF
		ENDIF	
		
		IF nWO > 0
			LOCATE FOR WO = nWO
			IF FOUND()
				nBestRec = RECNO('WorkOrder')
			ENDIF
		ENDIF
		
		IF nBestRec <= RECCOUNT('WorkOrder')
			GOTO nBestRec
		ELSE
			GO TOP
		ENDIF
		
		PRIVATE nWO
		nWO = PrepareSQLnum(WorkOrder.WO,'WO',-3)
		
		ThisFormSet.frmChooseWO.grdWO.RecordSource = 'WorkOrder'
		ThisFormSet.frmChooseWO.grdWO.column1.DynamicBackColor = "ThisFormSet.grdWO_Dynamic_Background()"
		
		ThisFormSet.frmChooseWO.Visible = .T.
		
		
		ThisFormset.Refresh_frmChooseWO_WO(nWO)
			*	CALLS: ThisFormSet.Refresh_frmChooseWO_Detail(WorkOrder.WO)
			*	CALLS: ThisFormSet.Set_frmChooseWO()
	ENDPROC

	PROCEDURE initcmbcl
		*ThisFormSet.InitcmbCL()
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCC.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			USE IN ConditionLevel
		ENDIF
		
		ThisFormSet.frmWorkOrder.cmbCL.Clear
		SELECT 0
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		ThisFormSet.frmWorkOrder.cmbCL.ColumnCount = 2
		ThisFormSet.frmWorkOrder.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		ThisFormSet.frmWorkOrder.cmbCL.BoundColumn = 1
		ThisFormSet.frmWorkOrder.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					ThisFormSet.frmWorkOrder.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					ThisFormSet.frmWorkOrder.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		ThisFormSet.frmWorkOrder.cmbCL.Value = cCL1
		
		IF ThisFormSet.CC != PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCC.Value,'CC',1)
			ThisFormSet.CC = PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCC.Value,'CC',1)
		*	This.Parent.cmbCL.Value = ''
			ThisFormSet.frmWorkOrder.cmbCL.Value = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
			ThisFormSet.frmWorkOrder.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE initcmbfcl
		*ThisFormSet.InitcmbFCL()
		
		PRIVATE cCC, cCL_Orig
		cCC = PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCC.Value,'CC',1)
		cCL_Orig = PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCl.Value,'Cl',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		ThisFormSet.frmWorkOrder.cmbFCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		ThisFormSet.frmWorkOrder.cmbFCL.ColumnCount = 2
		ThisFormSet.frmWorkOrder.cmbFCL.NumberOfElements=ALEN(aConditionLevel)
		ThisFormSet.frmWorkOrder.cmbFCL.BoundColumn = 1
		ThisFormSet.frmWorkOrder.cmbFCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		PRIVATE lFound 
		lFound = .F.
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					IF cc1 = cCL_Orig
						lFound = .T.
					ENDIF
					
					ThisFormSet.frmWorkOrder.cmbFCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					ThisFormSet.frmWorkOrder.cmbFCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		ThisFormSet.frmWorkOrder.cmbFCL.Value = cCL1
		
		IF ThisFormSet.fCC != PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCC.Value,'CC',1)
			ThisFormSet.fCC = PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCC.Value,'CC',1)
		*	This.Parent.cmbCL.Value = ''
			IF lFound
				*already set above
				*ThisFormSet.frmWorkOrder.cmbFCL.Value = cCL1
			ELSE
				ThisFormSet.frmWorkOrder.cmbFCL.Value = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
			ENDIF
			ThisFormSet.frmWorkOrder.cmbFCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE initprojstk
		*ThisFormSet.InitProjStock()
		
		IF USED("tmpProjStk")	
			USE IN tmpProjStk
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT SP.* "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Cnt(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWCnt "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Min_Cw(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWMin "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Avg_Cw(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWAvg "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Median_Cw(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWMedian "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Max_Cw(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWMax "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Start(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS StartDia "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_DiaMax(SP.Alloy,SP.CC,SP.CL),0) AS DiaMax "
		cSQL = cSQL+",ISNULL(CL.Text,'') AS CLText "
		cSQL = cSQL+",ISNULL(CL.Spec,'') AS FSpec "
		
		cSQL = cSQL+" ,(SELECT ISNULL(SUM(fWeight),0) "
		cSQL = cSQL+" 	 FROM dbo.WorkOrder WO "
		cSQL = cSQL+" 	 INNER JOIN dbo.WorkOrder_Detail WOD ON WO.WO = WOD.WO "
		cSQL = cSQL+" 	 WHERE WOD.Stock_Projected_ID = SP.ID "
		cSQL = cSQL+" 	 AND ISNULL(WOD.fCmplt,0) = 0 "
		cSQL = cSQL+" 	 AND ISNULL(WOD.fCncld,0) = 0 "
		cSQL = cSQL+" 	 ) AS fWeight "
		
		cSQL = cSQL+" , ( YearPounds - (SELECT ISNULL(SUM(fWeight),0) "
		cSQL = cSQL+" 	 FROM dbo.WorkOrder WO "
		cSQL = cSQL+" 	 INNER JOIN dbo.WorkOrder_Detail WOD ON WO.WO = WOD.WO "
		cSQL = cSQL+" 	 WHERE WOD.Stock_Projected_ID = SP.ID "
		cSQL = cSQL+" 	 AND ISNULL(WOD.fCmplt,0) = 0 "
		cSQL = cSQL+" 	 AND ISNULL(WOD.fCncld,0) = 0 "
		cSQL = cSQL+" 	 ) ) AS LBS_Needed "
			
		cSQL = cSQL+" ,(SELECT TOP 1 fStartDate  "
		cSQL = cSQL+" 	 FROM dbo.WorkOrder_Detail "
		cSQL = cSQL+" 	 WHERE Stock_Projected_ID = SP.ID "
		cSQL = cSQL+" 	 AND NOT fStartDate IS NULL "
		cSQL = cSQL+" 	 ORDER BY fStartDate ) AS PDate "
		
		cSQL = cSQL+", dbo.f_Calc_Stock_QTY(SP.Alloy,SP.Form,SP.Thck) AS StockQTY "
		
		cSQL = cSQL+" FROM dbo.Stock_Projected SP "
		cSQL = cSQL+" LEFT OUTER JOIN dbo.ConditionLevel CL ON CL.CC=SP.Spec_CC AND CL.CL=SP.Spec_CL "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProjStk')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpProjStk')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjStk")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjStk")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProjStk')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			*See INIT
		*	ThisFormSet.pgf.pgBrowse.grdtmpProjStk.RecordSource = "tmpProjStk"
			ThisFormSet.frmStock_Projected.grdProStk.RecordSource = "tmpProjStk"
		ENDIF
		
		SELECT tmpProjStk
		ThisFormSet.frmStock_Projected.grdProStk.RecordSource = 'tmpProjStk'
		*ThisFormSet.frmStock_Projected.Visible = .T.
		
		
		ThisFormset.ProjStk_Refresh()
		
	ENDPROC

	PROCEDURE initstockwo
		*ThisFormSet.InitStockWO
		
		IF NOT USED('tmpStockWO')
			RETURN .F.
		ENDIF
