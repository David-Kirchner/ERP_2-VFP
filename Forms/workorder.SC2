	PROCEDURE show_frmchoosewo_wodetail
		PARAMETERS nWO_Detail
		*ThisFormSet.Show_frmChooseWO_WODetail(nWO_Detail)
		
		IF VARTYPE(nWO_Detail) != "N"
			MESSAGEBOX("Bad Parameter",0,"No nWO_Detail")
			TrackError("ThisFormSet.Show_frmChooseWO_WODetail(nWO_Detail) did not get Parameter nWOD","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		IF USED('tmpWO_Detail')
		
			SELECT tmpWO_Detail
			LOCATE FOR WO_Detail = nWO_Detail
			
			IF FOUND('tmpWO_Detail')
			
				ThisFormset.frmChooseWO.txtFPieces.Value = PrepareSQLnum(tmpWO_Detail.fPieces,'Pieces',-3)
				ThisFormset.frmChooseWO.txtFAlloy.Value	= PrepareSQLtxt(tmpWO_Detail.fAlloy,'Alloy',12)
				ThisFormset.frmChooseWO.txtFForm.Value	= PrepareSQLtxt(tmpWO_Detail.fForm,'Form',2)
				ThisFormset.frmChooseWO.txtFcc.Value	= PrepareSQLtxt(tmpWO_Detail.fCC,'CC',1)
				ThisFormset.frmChooseWO.txtFCL.Value	= PrepareSQLtxt(tmpWO_Detail.fCL,'CL',1)
				ThisFormset.frmChooseWO.txtFThck.Value	= PrepareSQLnum(tmpWO_Detail.fThck,'Thck',10,4)
				ThisFormset.frmChooseWO.txtFSz2.Value	= PrepareSQLnum(tmpWO_Detail.fSz2,'Sz2',9,3)
				ThisFormset.frmChooseWO.txtFSz3.Value	= PrepareSQLnum(tmpWO_Detail.fSz3,'Sz3',9,3)
				ThisFormset.frmChooseWO.txtFDescript.Value = PrepareSQLtxt(tmpWO_Detail.fDescript,'Descript',100)
				ThisFormset.frmChooseWO.txtWO_Detail.Value = PrepareSQLnum(tmpWO_Detail.WO_Detail,'WO_Detail',-3)
				ThisFormset.frmChooseWO.txtfWeight.Value = PrepareSQLnum(tmpWO_Detail.fWeight,'Weight',9,1)
		
				ThisFormset.frmChooseWO.txtStock_Projected_ID.Value = PrepareSQLnum(tmpWO_Detail.Stock_Projected_ID,'Stock_Projected_ID',-3)
				ThisFormset.nStock_Projected_Id = ThisFormset.frmChooseWO.txtStock_Projected_ID.Value
				
				ThisFormSet.Refresh_Projected()
				
				ThisFormset.frmChooseWO.txtFinishM.Value	= PrepareSQLtxt(tmpWO_Detail.FinishM,'FinishM',20)
				ThisFormset.frmChooseWO.txtFinishLot.Value	= PrepareSQLnum(tmpWO_Detail.FinishLot,'FinishLot',-3)
		
				ThisFormset.frmChooseWO.txtFID_Detail.Value = PrepareSQLnum(tmpWO_Detail.FID_Detail,'FID_Detail',-3)
				IF PrepareSQLnum(tmpWO_Detail.FID_Detail,'FID_Detail',-3) > 0
					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(0,128,255)
				ELSE
					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(240,240,240)
				ENDIF	
				*ThisFormSet.frmChooseWO.chkIntP.Value		= PrepareSQLchk(tmpWO_Detail.IntP,'IntP')
				ThisFormSet.frmChooseWO.txtAC_ID_WOD.Value	= PrepareSQLtxt(tmpWO_Detail.AC_ID_WOD,'AC_ID',-3)
				
				ThisFormset.frmChooseWO.txtFSOitem.Value	= PrepareSQLtxt(tmpWO_Detail.fSOitem,'SOitem',10)
				ThisFormset.frmChooseWO.txtFPOitem.Value	= PrepareSQLtxt(tmpWO_Detail.fPOitem,'POitem',12)
				ThisFormset.frmChooseWO.txtTotFinishW.Value	= PrepareSQLnum(tmpWO_Detail.TotFinishW,'TotFinishW',9,1)
		
				ThisFormset.frmChooseWO.chkfComplete.Value	= PrepareSQLchk(tmpWO_Detail.fCmplt,'fCmplt')
				ThisFormset.frmChooseWO.chkfTested.Value	= PrepareSQLchk(tmpWO_Detail.PassTest,'PassTest')
				ThisFormset.frmChooseWO.chkfPrint.Value		= PrepareSQLchk(tmpWO_Detail.fPrint,'fPrint')
				ThisFormset.frmChooseWO.chkfpRecv.Value		= PrepareSQLchk(tmpWO_Detail.fPRecv,'fPRecv')
				ThisFormset.frmChooseWO.chkfMod.Value		= PrepareSQLchk(tmpWO_Detail.fMod,'fMod')
				ThisFormset.frmChooseWO.txtfRev.Value		= PrepareSQLnum(tmpWO_Detail.fRev,'fRev',-1)
				ThisFormset.frmChooseWO.chkfCncld.Value		= PrepareSQLchk(tmpWO_Detail.fCncld,'fCndld')
				
				
			ELSE
				ThisFormset.frmChooseWO.txtWO_Detail.Value = 0
				MESSAGEBOX("Could not find WO_Detail:"+ALLTRIM(STR(nWO_Detail)),0,"Error")
			ENDIF
			
			ThisFormSet.Show_frmChooseWO_Detail_Color()	
		ENDIF
	ENDPROC

	PROCEDURE show_frmstockused
		PARAMETERS nWO
		*ThisFormSet.Show_frmStockUsed(tmpWO.WO)
		
		IF VARTYPE(nWO) != "N"
			TrackError("ThisFormSet.Show_frmStockUsed(WO) did not get Parameter nWO","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		ThisFormSet.Load_tmpSPStartP(nWO)
			*CALLS: ThisFormSet.RefreshID_Detail_ProcessP( 0 )
			*CALLS: ThisFormSet.Load_tmpSPcmpltP(nWO)
				*CALLS: ThisFormSet.RefreshID_Detail_ProcessCP( 0 )
		
		IF USED("tmpSPStartP") OR USED("tmpSPcmpltP")	
			*ThisFormSet.frmWorkOrder.Visible = .T.
			
			IF RECCOUNT('tmpSPStartP') > 0 OR RECCOUNT('tmpSPcmpltP') > 0
				*Do not show at startup, use the lblShowConsumed
				*ThisFormSet.frmStockUsed.Visible = .T.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE show_frmstock_produced		&& Show Stock produced by WO_Detail
		PARAMETERS pWO_Detail
		*ThisFormSet.Show_frmStock_Produced(nWO_Detail)
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pWO_Detail,'WO_Detail',-3)
		
		IF nWO_Detail = 0
			RETURN .F.
		ENDIF
		
		PRIVATE cSPOitem, cFSOitem ,cFPOItem 
		cSPOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		cFSOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		cFPOItem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfPOitem.Value,'POitem',12)
		
		ThisFormSet.frmStock_Produced.Visible = .F.
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpStock_Produced")	
			ThisFormSet.frmStock_Produced.grdStockWOD.RecordSource = ''
			USE IN tmpStock_Produced
		ENDIF
		SELECT 0
		
		
		*!*	cSQL =        " SELECT M.*,D.*, 'S' AS TBL "
		*!*	cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(D.PC, M.Form, D.Dim1, D.Dim2, D.Dim3, D.Weight, D.RandLen,0 ,'','','') AS Descript"
		*!*	*cSQL = cSQL + " ,P.ID_Detail_Process, P.WO_Detail AS PWO_Detail, P.Process_ID, P.SOitem AS PSOitem "
		*!*	cSQL = cSQL + " ,0 AS ID_Detail_Process, 0 AS PWO_Detail, 0 AS Process_ID, '' AS PSOitem "
		*!*	cSQL = cSQL + " FROM dbo.StockLst_Master M "
		*!*	cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
		*!*	cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		*!*	IF Proper_PO_item(cFPOitem) != Proper_PO_item('')
		*!*		cSQL = cSQL + " OR M.PO_Item = dbo.f_ProperPOitem('"+cFPoItem+"')"
		*!*	ENDIF
		*!*	cSQL = cSQL + " UNION "
		*!*	cSQL = cSQL + " SELECT M.*,D.*, 'B' AS TBL "
		*!*	cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(D.PC, M.Form, D.Dim1, D.Dim2, D.Dim3, D.Weight, D.RandLen,0 ,'','','') AS Descript"
		*!*	*cSQL = cSQL + " ,P.ID_Detail_Process, P.WO_Detail AS PWO_Detail, P.Process_ID, P.SOitem AS PSOitem "
		*!*	cSQL = cSQL + " ,0 AS ID_Detail_Process, 0 AS PWO_Detail, 0 AS Process_ID, '' AS PSOitem "
		*!*	cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
		*!*	cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
		*!*	cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		*!*	IF Proper_PO_item(cFPOitem) != Proper_PO_item('')
		*!*		cSQL = cSQL + " OR M.PO_Item = dbo.f_ProperPOitem('"+cFPoItem+"')"
		*!*	ENDIF
		*!*	cSQL = cSQL + " SELECT M.*,D.*, 'W' AS TBL "
		*!*	cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(D.PC, M.Form, D.Dim1, D.Dim2, D.Dim3, D.Weight, D.RandLen,0 ,'','','') AS Descript"
		*!*	*cSQL = cSQL + " ,P.ID_Detail_Process, P.WO_Detail AS PWO_Detail, P.Process_ID, P.SOitem AS PSOitem "
		*!*	cSQL = cSQL + " ,0 AS ID_Detail_Process, 0 AS PWO_Detail, 0 AS Process_ID, '' AS PSOitem "
		*!*	cSQL = cSQL + " FROM dbo.WIPLst_Master M "
		*!*	cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
		*!*	cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		*!*	IF Proper_PO_item(cFPOitem) != Proper_PO_item('')
		*!*		cSQL = cSQL + " OR M.PO_Item = dbo.f_ProperPOitem('"+cFPoItem+"')"
		*!*	ENDIF
		
		
		cSQL = "SELECT M.*,D.* ,'S' AS TBL "
		cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(D.PC, M.Form, D.Dim1, D.Dim2, D.Dim3, D.Weight, D.RandLen,0 ,'','','') AS Descript "
		cSQL = cSQL + " ,P.ID_Detail_Process, P.WO_Detail AS PWO_Detail, P.Process_ID, P.SOitem AS PSOitem "
		cSQL = cSQL + " FROM dbo.StockLst_Master M "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
		cSQL = cSQL + " WHERE P.WO_Detail = "+STR(nWO_Detail)+" AND P.Process_ID='INCOMING' "
		*already on the StockLst
		IF nWO_Detail > 0
			IF AT(" WHERE ",cSQL) > 0
				cSQL = cSQL + " OR "
			ELSE
				cSQL = cSQL + " WHERE "
			ENDIF
			cSQL = cSQL + " M.WO_Detail = "+STR(nWO_Detail)
		ENDIF
		IF Proper_PO_item(cFPOitem) != Proper_PO_item('')
			IF AT(" WHERE ",cSQL) > 0
				cSQL = cSQL + " OR "
			ELSE
				cSQL = cSQL + " WHERE "
			ENDIF
			cSQL = cSQL + " M.PO_Item = dbo.f_ProperPOitem('"+cFPoItem+"')"
		ENDIF
		IF Proper_PO_item(cSPOitem) != Proper_PO_item('')
			IF AT(" WHERE ",cSQL) > 0
				cSQL = cSQL + " OR "
			ELSE
				cSQL = cSQL + " WHERE "
			ENDIF
			cSQL = cSQL + " M.PO_Item = dbo.f_ProperPOitem('"+cSPOitem+"')"
		ENDIF
		*If a SO was written and Choose Starting Stock
		IF Proper_SO_item(cFSOitem) != Proper_SO_item('')
			IF AT(" WHERE ",cSQL) > 0
				cSQL = cSQL + " OR "
			ELSE
				cSQL = cSQL + " WHERE "
			ENDIF
			cSQL = cSQL + " ( P.SOItem = dbo.f_ProperSOitem('"+cFSoItem+"')"+" AND P.Process_ID = 'SELECTED' )"
		ENDIF
		
		*tmpStock_Produced
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStock_Produced')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStock_Produced')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStock_Produced")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStock_Produced")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStock_Produced')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpStock_Produced')
			IF RECCOUNT('tmpStock_Produced') > 0
				ThisFormSet.frmStock_Produced.Visible = .T.
				ThisFormSet.frmStock_Produced.grdStockWOD.RecordSource = 'tmpStock_Produced'
				
				*Has NextStep been filled?
				IF LEN(ThisFormSet.frmWorkOrder.txtNextNumber.Value) = 0
					*Add to screen 
					ThisFormSet.frmWorkOrder.cmbNextCode.Value = 'STK'
					ThisFormSet.frmWorkOrder.txtNextNumber.Value = STR(tmpStock_Produced.ID_Detail) 
					*save now
					PRIVATE cUpdate 
					cUpdate = "UPDATE dbo.WorkOrder_Detail SET"
					cUpdate = cUpdate + " NextCode='STK' "
				    cUpdate = cUpdate + ",NextNumber='"+STR(tmpStock_Produced.ID_Detail)+"'"  
				 	cUpdate = cUpdate + " WHERE WO_Detail= "+STR(nWO_Detail)
					 
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cUpdate, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cUpdate )
					ENDIF
				ENDIF
				
				*ThisFormSet.RefreshStockWOD()
				*ThisFormSet.RefreshStockProduced()
				ThisFormSet.RefreshStock_Produced()
				
			ELSE
				*MESSAGEBOX("Did not find any record for this WO_Detail "+STR(nWO_Detail)+CHR(13)+"You may need to list to Stock yet!",0,"No data")
				*WAIT WINDOW "Did not find Stock Produced record for this WO_Detail "+STR(nWO_Detail) NOWAIT
			ENDIF
			*USE IN tmpStock_Produced
		ELSE
			*WAIT WINDOW "Did not find Stock Produced record for this WO_Detail "+STR(nWO_Detail) NOWAIT
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE show_frmworkorder_markedstock
		PARAMETERS nWO
		*ThisFormSet.Show_frmWorkOrder_MarkedStock(WO)
		
		IF VARTYPE(nWO) != "N"
			TrackError("ThisFormSet.Show_frmWorkOrder_MarkedStock(WO) did not get Parameter nWO","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		PRIVATE nID_Detail, nID_Detail_Process
		nID_Detail			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSPS_ID_Detail.Value,'ID_Detail',-3)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSPS_Process_ID.Value,'ID_Detail_Process',-3)
		
		********************************************
		ThisFormSet.Load_tmpSPStart(nWO)
		********************************************
		
		
		IF USED("StkConsumed")
			USE IN StkConsumed
		ENDIF
		SELECT 0
		
		cSQL = "SELECT StkConsumed FROM dbo.WorkOrder"
		cSQL = cSQL + " WHERE WO="+STR(nWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "StkConsumed")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQL, "StkConsumed")
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkConsumed")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StkConsumed")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnhandle, nSQLEXEC, "StkConsumed")
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('StkConsumed')
			IF RECCOUNT('StkConsumed') > 0
				IF PrepareSQLchk(StkConsumed.StkConsumed,'StkConsumed')
					ThisFormSet.frmWorkOrder.cmdConsumeStock.Visible = .F.
					ThisFormSet.frmWorkOrder.chkStkConsumed.Value = 1
				ELSE
					ThisFormSet.frmWorkOrder.cmdConsumeStock.Visible = .T.
					ThisFormSet.frmWorkOrder.cmdConsumeStock.Enabled = .T.
					ThisFormSet.frmWorkOrder.chkStkConsumed.Value = 0
				ENDIF
			ENDIF
			USE IN StkConsumed
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE show_frmworkorder_wodetail
		PARAMETERS nWO
		*ThisFormSet.Show_frmWorkOrder_WODetail(WO)
		*Selects all of the WorkOrder_Details for WO.
		*
		*Uses ThisFormSet.Show_frmWorkOrder_WODetail(nWO_Detail)  -First WO_Detail
		
		IF VARTYPE(nWO) != "N"
			TrackError("ThisFormSet.Show_frmWorkOrder_WODetail(WO) did not get Parameter nWO","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		*ThisFormSet.Show_frmWorkOrder_MarkedStock(nWO)	Not here!!!
			
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpWO_Detail")	
			USE IN tmpWO_Detail
		ENDIF
		SELECT 0
		
		
		cSQL = "SELECT WOD.* "
		cSQL = cSQL +" ,ISNULL(ACWOD.AC_ID,0) AS AC_ID_WOD "
		cSQL = cSQL +" FROM dbo.WorkOrder_Detail WOD "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.AcctCost_WOD ACWOD ON WOD.WO_Detail = ACWOD.WO_Detail "
		cSQL = cSQL +" WHERE WOD.WO ="+STR(nWO)
			
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Detail')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tmpWO_Detail')
		
			ThisFormSet.Refresh_frmWorkOrder_Detail(tmpWO_Detail.WO_Detail)
				*CALLS: ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_Detail.fPOitem)
				*CALLS: ThisFormSet.CheckFinish_ID_Detail()
			
			ThisFormSet.frmWorkOrder.txtWO_Detail.Value = tmpWO_Detail.WO_Detail 
			ThisFormSet.frmWO_Detail_SO.RefreshWO_Detail_SO(tmpWO_Detail.WO_Detail)	
			
			
			**********************************
			ThisFormSet.Load_lst_WO_Detail(nWO)
			PRIVATE nWOD_pos
			nWOD_pos = ASCAN(gaWO_Detail, tmpWO_Detail.WO_Detail) 
			IF nWOD_pos > 0
				ThisFormSet.frmWorkOrder.lstWO_Detail.Value = nWOD_pos
				*ThisFormSet.frmWorkOrder.lstWO_Detail.Value = tmpWO_Detail.WO_Detail 
				ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .T.
				ThisFormSet.frmWorkOrder.lstWO_Detail.Refresh
			ENDIF
			
			
			
		ENDIF
	ENDPROC

	PROCEDURE show_stocklst
		PARAMETERS cWhat,nNumber,cOItem
		*ThisFormSet.Show_StockLst("Received",nWO_Detail,cFPoItem)
		
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpStockWO")	
			ThisFormSet.frmStockWO.grdStockWO.RecordSource = ''
			USE IN tmpStockWO
		ENDIF
		SELECT 0
		
		cSQL = "SELECT M.*,D.*,'S' AS TBL "
		cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(D.PC, M.Form, D.Dim1, D.Dim2, D.Dim3, D.Weight, D.RandLen,0 ,'','','') AS Descript "
		cSQL = cSQL + " FROM dbo.StockLst_Master M "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
		
		DO CASE
		CASE cWhat = "Received"
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nNumber)
			IF Proper_PO_item(cOItem) != Proper_PO_item('')
				cSQL = cSQL + " OR M.PO_Item = dbo.f_ProperPOitem('"+cOItem+"')"
			ENDIF
		CASE cWhat = "Selected"
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE P.WO = "+STR(nNumber)
			IF Proper_PO_item(cOItem) != Proper_PO_item('')
				cSQL = cSQL + " OR P.PO_Item = dbo.f_ProperPOitem('"+cOItem+"')"
			ENDIF
		CASE cWhat = "Completed"
		*-- dbo.Sales_Detail
		MESSAGEBOX("Not Programmed")
		
			cSQL = "SELECT M.*,D.*,'S' AS TBL "
			cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(D.PC, M.Form, D.Dim1, D.Dim2, D.Dim3, D.Weight, D.RandLen,0 ,'','','') AS Descript "
			cSQL = cSQL + " FROM dbo.StockLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE P.WO = "+STR(nNumber)
			IF Proper_PO_item(cOItem) != Proper_PO_item('')
				cSQL = cSQL + " OR P.PO_Item = dbo.f_ProperPOitem('"+cOItem+"')"
			ENDIF
		OTHERWISE
			TrackError("Problem Memo","No cWhat parameter", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDCASE
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStockWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockWO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpStockWO')
			IF RECCOUNT('tmpStockWO') > 0
				*ThisFormSet.ShowSelectStockLst()
				
		*		ThisFormSet.InitStockWO()  &&calls ThisFormSet.StockLstAdd_WOD()
			
				
				ThisFormSet.frmStockWO.AlwaysOnTop = .T.
				ThisFormSet.frmStockWO.Visible = .T.
				ThisFormSet.frmStockWO.grdStockWO.RecordSource = 'tmpStockWO'
		
				ThisFormSet.frmStockWO.Caption = "Stock WO"
				DO CASE
				CASE cWhat = "Received"
					ThisFormSet.frmStockWO.Caption = "Received in, Still on Stock List"
				ENDCASE
		
				ThisFormSet.RefreshStockWO()
				ThisFormSet.frmStockWO.lblWO_D.Caption = ALLTRIM(STR(PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)))
		
				*MESSAGEBOX("Already Posted on StockLst"+CHR(13)+"Use StockLst Maintenance to Edit.",64,"Cannot edit from here.")
				*RETURN
			ENDIF
			USE IN tmpStockWO
		ENDIF
		
		*!*	ThisFormSet.StockLstAdd_WOD()
	ENDPROC

	PROCEDURE stocklstadd_wod		&& Add with WOD Details
		*ThisFormSet.StockLstAdd_WOD()
		*Adds the WO_Detail into StockLst as INCOMING
		
		PRIVATE nWO_Detail, nWO
		nWO_Detail = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		nWO		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		
		IF nWO_Detail = 0
			MESSAGEBOX("Cannot continue without the WO_Detail.",48,"No WO_Detail")
			RETURN .F.
		ENDIF
		IF nWO_Detail = 0
			MESSAGEBOX("Cannot continue without the WO.",48,"No WO")
			RETURN .F.
		ENDIF
		
		PRIVATE nFPieces, cAlloy,cForm,cCC,cCL
		nFPieces = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
		cForm2	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCL.Value,'CL',1)
		
		PRIVATE nFthck, nFSz2, nFSz3, nFWeight, nSWeight, nTotFinishW, nLostWeight, cFSpec
		nFthck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz2.Value,'Sz2',13,3)
		nFSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz3.Value,'Sz3',13,3)
		nFWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFWeight.Value,'Weight',7,1)
		nSWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWeight.Value,'Weight',7,1)
		nTotFinishW	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtTotFinishW.Value,'TotFinish',9,1)
		nLostWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtLostWeight.Value,'LostWeight',9,1)
		cFSpec		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSpec.Value,'FSpec',50)
		
		PRIVATE cfTBL, nFID_Detail, nFID_Detail_Process, nfReceivingID
		cfTBL			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFTBL.Value,'TBL',1)
		nFID_Detail		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail.Value,'ID_Detail',-3)
		nFID_Detail_Process = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value,'ID_Detail_Process',-3)
		nfReceivingID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfReceivingID.Value,'ReceivingID',-3)
		IF nfReceivingID > 0
			MESSAGEBOX("Cannot List stock that has already been Received."+CHR(13)+"Create another WO_Detail to list more stock."+CHR(13)+"or use StockLst Maintanence to Edit.",48,"Cannot Create a Stock entry!")
			RETURN .F.
		ENDIF
		
		PRIVATE cFDescript, cfCondLevel, cFollowM, nFollowLot, cFinishM, nFinishLot
		cFDescript	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFdescript.Value,'Fdescript',100)
		cfCondLevel = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		cFollowM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFollowM.Value,'FollowM',20)
		nFollowLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFollowLot.Value,'FollowLot',-3)
		cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		
		PRIVATE cSSOitem, cSPOitem
		cSSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		cSPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		PRIVATE cFSOitem, cFPOitem
		cFSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		cFPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFPOitem.Value,'POitem',12)
		
		PRIVATE nfReceivingID, nReceivingID, lfCmplt, cFNotes, nStock_Projected_ID, lfCncld, lStkListed
		nfReceivingID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfReceivingID.Value,'RecevingID',-3)
		nReceivingID = nfReceivingID
		*lIntP		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')  &&Used on WO and WO_Detail
		lfCmplt		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCmplt.Value,'fCmplt')
		cFNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtfNotes.Value,'Notes',-1)
		nStock_Projected_ID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value,'Stock_Projected_ID',-3)
		lfCncld		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCncld.Value,'fCncld')
		lStkListed	= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkStkListed.Value,'StkListed')
		
		PRIVATE cfCondLevel, nStartSize, nCW, nRoughSize, nOverSize, dFDueDate, dSDueDate
		cfCondLevel	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		nStartSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		dFDueDate	= PrepareSQLdate(ThisFormSet.frmWorkOrder.txtFDueDate.Value,'FDueDate')
		dSDueDate	= PrepareSQLdate(ThisFormSet.frmWorkOrder.txtDueDate.Value,'DueDate')
		
		PRIVATE cNextCode, cNextNumber
		cNextCode 	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbNextCode.Value,'NextCode',3)
		cNextNumber	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtNextNumber.Value,'NextNumber',10)
		
		PRIVATE nSalesNum, cSOitem, nItemSO, pcSOitem 
		nSalesNum = VAL( PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10))
		cSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		nItemSO = VAL( RIGHT(cSOitem,2))
		pcSOitem = "WORKORDER"
		
		***
		
		PRIVATE cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFForm.Value,'Form',2)
		nPrc_PCs	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'PCs',-3)
		nPrc_Dim1	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'DIM1',10,4)
		nPrc_Dim2	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz2.Value,'DIM2',9,3)
		nPrc_Dim3	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz3.Value,'DIM3',9,3)
		
		
		*************************************************
		*StockLst_Detail Variables
		PRIVATE nPieces, nThck, nSz2, nSz3, nPounds
		nPieces		= nFPieces
		nThck	= nFthck
		nSz2	= nFSz2
		nSz3	= nFSz3
		
		IF nTotFinishW > 0
			nPounds = nTotFinishW
		ELSE
			IF nFWeight > 0
				nPounds = nFWeight 
				IF nSWeight > 0
					nPounds = nFWeight 
				ELSE
					nPounds = 0
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE nStockLst_QTY, nStockLst_P, lRandLen, nS_Total, nS_PU
		nStockLst_QTY = 0
		
		IF nTotFinishW > 0
			nStockLst_QTY = nTotFinishW
		ELSE
			IF nFWeight > 0
				nStockLst_QTY = nFWeight 
				IF nSWeight > 0
					nStockLst_QTY = nFWeight 
				ENDIF
			ENDIF
		ENDIF
		nStockLst_P = 0
		lRandLen = .T.
		nS_Total = 0 
		nS_PU	= GetPUfromForm(cForm, ThisFormSet.nConnHandle)
		
		PRIVATE cHeat, cLength, cHeatLot, cPoItem
		*Heat could be looked up from selected Stock !!
		cHeat	= "DUE IN"
		cLength = ''
		cPoItem	= cFPOitem
		
		*Heat Lot could be filled in from the Create lot info !!
		cHeatLot = ''
		IF LEN(cFinishM) > 0 AND nFinishLot > 0
			cHeatLot = GetMachine_Init( cFinishM, ThisFormSet.nConnHandle ) + ALLTRIM(STR(nFinishLot))
		ENDIF
		
		***********************
		IF NOT EMPTY(dFDueDate)
			dDueDate = dFDueDate
		ELSE
			IF NOT EMPTY(dSDueDate)
				dDueDate = dSDueDate
			ELSE
				dDueDate = DATE()+180
			ENDIF
		ENDIF
		
		PRIVATE cPOStatus, cBrandName, cMelt
		cPOStatus	= 'D' &&DueIn
		cBrandName	= ''
		*Melt could be found with Master Selected
		cMelt		= ''
		
		PRIVATE cShipLocation, cLstDetailUnit
		cShipLocation	= 'HPA Prod'
		cLstDetailUnit	= GetUNITfromFORM( cForm, ThisFormSet.nConnHandle )
		
		PRIVATE cMill,cStock,cHistory ,nFrom_ID
		cMill	= PrepareSQLtxt("HPA",'Mill',10)
		cStock = "STOCK"
		cHistory = PrepareSQLtxt("WO_Detail "+ALLTRIM(STR(nWO_Detail)),'History',20)
		*ID from Master that was Selected.
		nFrom_ID = 0 &&look at WO selected stock.
		
		************************************************************************************
		PRIVATE lFoundSELECTED
		lFoundSELECTED = .F.
		
		*Grab ID, Mill, Heat, Melt, Cond Spec from SELECTED Stock *cFDescript, cfCondLevel
		
		IF USED('tmpINV2')
			USE IN tmpINV2
		ENDIF
		
		cSQL = "SELECT M.Mill, M.Melt, M.BrandName, M.ID, M.Heat, M.Cond, M.Specs "
		cSQL = cSQL + " FROM dbo.StockLst_Master M "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON P.ID_Detail = D.ID_Detail "
		
		cSQL = cSQL + " WHERE ( P.WO = "+STR(nWO)+" AND P.Process_ID = 'SELECTED' )"
		
		IF Proper_PO_item(cFPOitem) != Proper_PO_item('')
			IF AT(" WHERE ",cSQL) > 0
				cSQL = cSQL + " OR "
			ELSE
				cSQL = cSQL + " WHERE "
			ENDIF
			cSQL = cSQL + " ( P.PO_Item = dbo.f_ProperPOitem('"+cFPoItem+"')"+" AND P.Process_ID = 'SELECTED' )"
		ENDIF
		IF Proper_PO_item(cSPOitem) != Proper_PO_item('')
			IF AT(" WHERE ",cSQL) > 0
				cSQL = cSQL + " OR "
			ELSE
				cSQL = cSQL + " WHERE "
			ENDIF
			cSQL = cSQL + " ( P.PO_Item = dbo.f_ProperPOitem('"+cSPOitem+"')"+" AND P.Process_ID = 'SELECTED' )"
		ENDIF
		*If a SO was written and Choose Starting Stock
		IF Proper_SO_item(cFSOitem) != Proper_SO_item('')
			IF AT(" WHERE ",cSQL) > 0
				cSQL = cSQL + " OR "
			ELSE
				cSQL = cSQL + " WHERE "
			ENDIF
			cSQL = cSQL + " ( P.SOItem = dbo.f_ProperSOitem('"+cFSoItem+"')"+" AND P.Process_ID = 'SELECTED' )"
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpINV2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpINV2')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINV2")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINV2")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpINV2')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpINV2')
				IF RECCOUNT('tmpINV2')>0
					lFoundSELECTED = .T.
					
					*cMill	= PrepareSQLtxt(tmpINV2.Mill,'Mill',10) --Replaced with HPA
					cMelt	= PrepareSQLtxt(tmpINV2.Melt,'Melt',7)
					BrandName	= PrepareSQLtxt(tmpINV2.BrandName,'BrandName',20)
					nFrom_ID	= PrepareSQLnum(tmpINV2.ID,'ID',-3)
					cHeat		= PrepareSQLtxt(tmpINV2.Heat,'Heat',50)
					
					IF EMPTY(cFSpec)
						cFSpec = PrepareSQLtxt("Produced from Heat#"+ALLTRIM(tmpINV2.Heat)+" ID#"+ALLTRIM(STR(nFrom_ID))+" as WO_Detail#"+ALLTRIM(STR(nWO_Detail)) ,'Specs',160) 
					ENDIF
					cLength = PrepareSQLtxt("Produced from Heat#"+ALLTRIM(tmpINV2.Heat)+" ID#"+ALLTRIM(STR(nFrom_ID))+" as WO_Detail#"+ALLTRIM(STR(nWO_Detail)) ,'Specs',160) 
				ENDIF	
				USE IN tmpINV2
			ENDIF
		ENDIF
				
		*************************
		PRIVATE cSalesPerson, cAllowSub, nPU, cProcess_ID, cProcessor, cComment
		cSalesPerson = SUBSTR(SYS(0), AT('#',SYS(0))+2)
		IF LEN(cSalesPerson) = 0
			cSalesPerson = "Charlie Kirchner"
		ENDIF
		cAllowSub = "N"
		nPU	=1
		cProcess_ID = "INCOMING  "
		cProcessor = "WO Detail "+ALLTRIM(STR(nWO_Detail))
		cComment = "WO "+ALLTRIM(STR(nWO))+" created this "+cProcessor
		
		
		************************************************************************************
		*Process Variables
		PRIVATE nID_Detail_Process 
		nID_Detail_Process = 0
		
		PRIVATE lSQLgood, nMaster_ID, lNeedSave
		lSQLgood = .T.
		nMaster_ID = 0
		lNeedSave = .T.
		
		*********************************************************************************
		= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2)  && 1AUTO, 2MANUAL Trans
		*********************************************************************************
		
		PRIVATE cSQLi, nSQLEXEC, cSQL_M_Update
		*INSERT
		IF USED('tmpID_Master')
			USE IN tmpID_Master
		ENDIF
		
		cSQLi = "EXEC dbo.p_StockLst_Master_ins2 "
		cSQLi = cSQLi+ " @Alloy ='"+cAlloy+"'"   &&NOT NULL
		cSQLi = cSQLi+ ",@Form ='"+cForm+"'"   &&NOT NULL
		cSQLi = cSQLi+ ",@CC ='"+cCC+"'"
		cSQLi = cSQLi+ ",@Size ="+STR(nThck,9,3)+""   &&NOT NULL
		cSQLi = cSQLi+ ",@Cond ='"+PrepareSQLtxt(cfCondLevel,'Cond',50)+"'"   && 
		cSQLi = cSQLi+ ",@MWeight =0"			&&Init with 0
		cSQLi = cSQLi+ ",@Specs ='"+PrepareSQLtxt(cFSpec,'Specs',160)+"'"  &&cFDescript 
		*cSQLi = cSQLi+ ",@Heat ='"+"DUE IN"+"'"   &&Leave as a Hint for Receiving.
		IF cHeat = "DUE IN"
			cSQLi = cSQLi+ ",@Heat ='"+"DUE IN"+"'"   
		ELSE
			cSQLi = cSQLi+ ",@Heat ='"+"DUE IN "+cHeat+"'"   
		ENDIF
		cSQLi = cSQLi+ ",@Lot ='"+cHeatLot+"'"
		cSQLi = cSQLi+ ",@Paid ="+STR(nStockLst_P,18,4)+""
		cSQLi = cSQLi+ ",@PO_Item ='"+cPoItem+"'"
		cSQLi = cSQLi+ ",@PODueDate ='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		cSQLi = cSQLi+ ",@Mill ='"+cMill+"'"
		cSQLi = cSQLi+ ",@StkDate = '"+DTOC(DATE())+"'"
		cSQLi = cSQLi+ ",@History ='"+cHistory+"'"
		cSQLi = cSQLi+ ",@Num = 0"
		cSQLi = cSQLi+ ",@POStatus ='D'"	&&DueIn
		cSQLi = cSQLi+ ",@BrandName ='"+cBrandName+"'"
		cSQLi = cSQLi+ ",@From_ID ="+STR(nFrom_ID)
		cSQLi = cSQLi+ ",@Melt='"+cMelt+"'"
		
				
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			SQLEXECError(cSQLi,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Master')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLi )
			nMaster_ID = 0
			lSQLgood = .F.
		ELSE
			IF USED('tmpID_Master')
				nMaster_ID = tmpID_Master.EXP
				USE IN tmpID_Master
				
				IF nMaster_ID > 0
					***UPDATE Master
					cSQL_M_Update = "UPDATE dbo.StockLst_Master SET "
					cSQL_M_Update = cSQL_M_Update+" CL ='"+cCL+"'"
					cSQL_M_Update = cSQL_M_Update+",WO_Detail ="+STR(nWO_Detail)
					cSQL_M_Update = cSQL_M_Update+" WHERE ID = "+STR(nMaster_ID)
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_M_Update)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_M_Update)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_M_Update, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_M_Update, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_M_Update,ThisFormSet.nConnHandle,nSQLEXEC,'' )
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL_M_Update )
					ENDIF				
		
				ENDIF
			ELSE
				nMaster_ID = 0
			ENDIF
		ENDIF
		
		****
		IF lSQLgood
			Is_Alloy_New( cAlloy,cBrandName,ThisFormSet.nConnHandle )
		ENDIF
		
		****
		*lPOSaveOK
		
		IF lSQLgood AND lNeedSave
			******************************
			*create StockLst Detail
		*	PRIVATE nStkDetailCnt, nStkDetail_DELCnt
		*	nStkDetailCnt = 0
		*	nStkDetail_DELCnt = 0
			
			
		*!*		******************
		
			*INSERT StockLst_Detail
			IF USED('tmpID_Detail')
				USE IN tmpID_Detail
			ENDIF
			SELECT 0
		
			cSQLi = "EXEC dbo.p_StockLst_Detail_ins "
			cSQLi = cSQLi + " @size_h ="+'NULL'
			cSQLi = cSQLi + ",@size_l ="+'NULL'
			cSQLi = cSQLi + ",@pc ="+ STR(nPieces,10,0)
			cSQLi = cSQLi + ",@dim1 =" + STR(IIF(ISNULL(nThck),0,nThck),18,4)
			cSQLi = cSQLi + ",@dim2 =" + STR(IIF(ISNULL(nSz2),0,nSz2),18,4)
			cSQLi = cSQLi + ",@dim3 =" + STR(IIF(ISNULL(nSz3),0,nSz3),18,4)
			
			IF EMPTY(cLength)
				cSQLi = cSQLi + ",@length = 'Listing created from new WO_Detail:"+ALLTRIM(STR(nWO_Detail))  &&cLength 
			ELSE
				cSQLi = cSQLi + ",@length = '"+cLength
				IF nSalesNum > 0
					cSQLi = cSQLi +" needed for a SO:"+ALLTRIM(STR(nSalesNum))
				ENDIF
			ENDIF
			cSQLi = cSQLi +"'"
			
			cSQLi = cSQLi + ",@weight =" + STR(nPounds,9,2)
			cSQLi = cSQLi + ",@costvalue =" + STR(IIF(ISNULL(nStockLst_P),0,nStockLst_P),18,4)
			cSQLi = cSQLi + ",@descript ='"+cFDescript+"'"
			cSQLi = cSQLi + ",@location ='"+"'"
			cSQLi = cSQLi + ",@floorstatus ='"+"'"
			cSQLi = cSQLi + ",@class ='"+"'"
			cSQLi = cSQLi + ",@unit ='"+cLstDetailUnit+"'"
			cSQLi = cSQLi + ",@RandLen ="+IIF(lRandLen,"1","0")	&&'"+"'"
			cSQLi = cSQLi + ",@ID ="+STR(nMaster_ID )
			cSQLi = cSQLi + ",@ID_Detail_Process ="+STR(nID_Detail_Process)
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "tmpID_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "tmpID_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLi )
				lSQLgood = .F.
			ELSE
			
			
				IF USED('tmpID_Detail')
					nID_Detail = tmpID_Detail.EXP
					
					USE IN tmpID_Detail
				ELSE
					*Insert Failed
					SQLEXECError(cSQLi,ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLi )
					lSQLgood = .F.
					MESSAGEBOX('Could not SAVE detail',0,'Error')
				ENDIF
		
			ENDIF 
		ENDIF  &&IF lSQLgood AND lNeedSave
		
		******* StockLst Process
		PRIVATE lMany_ID_Details
		lMany_ID_Details = .F.
		
		*Save Process
		IF lSQLgood AND nMaster_ID > 0 AND nID_Detail > 0  &&AND lNeedSave
			**INSERT
			*!*	*Create StockLst_Process
			IF USED("tmpID_Detail_Process")
				USE IN tmpID_Detail_Process
			ENDIF
			SELECT 0
			
							
			cSQLi = "EXEC dbo.p_Lst_Process_ins "
			cSQLi = cSQLi + " @TBL = 'S'"
			cSQLi = cSQLi + ",@ID_Detail ="+STR(nID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
			cSQLi = cSQLi + ",@Startdate = '"+TTOC(DATETIME())+"'"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"   &&'Y' Computer does not Select the Stock!
		
			cSQLi = cSQLi + ",@PU	= "+STR(nPU)
			cSQLi = cSQLi + ",@QTY	= "+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Pounds ="+STR(nPounds,9,1)
		
			cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
			cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
			cSQLi = cSQLi + ",@WO 	= "+STR(0)
			cSQLi = cSQLi + ",@WO_Detail= "+STR(nWO_Detail)	
		
			cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
			cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
			cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
			cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID)
			
			cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
			cSQLi = cSQLi + ",@Prc_PCs  = "+STR(nPrc_PCs)
			cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
			cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
			cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
			
			cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Ordered_P = "+STR(0)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		
			IF nSQLEXEC < 0
				*retry
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				*=SQLROLLBACK(ThisFormSet.nConnHandle)
				SQLEXECError(cSQLi,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLi )
				TrackError("Could not EXEC dbo.p_Lst_Process_ins ","p_Lst_Process_ins ",PROGRAM(),LINENO(1))
				lSQLgood = .F.
			ELSE
				IF USED('tmpID_Detail_Process')
					nID_Detail_Process = tmpID_Detail_Process.EXP
				ELSE
					nID_Detail_Process = 0
				ENDIF
				*=SQLCOMMIT(ThisFormSet.nConnHandle)
			ENDIF
			
			IF USED('tmp_ID_Detail_Pro')
				USE IN tmp_ID_Detail_Pro
			ENDIF
			
		
		
		ENDIF	&& IF lPOSaveLst AND nShipWhere > 1
		
		*******************
		
		IF lSQLgood 
			SQLCOMMIT(ThisFormSet.nConnHandle)	
			
			
			*Now update what does not fit in SP p_StockLst_Detail_ins
			cSQL_Detail_Update = "UPDATE dbo.StockLst_Detail SET "
			cSQL_Detail_Update = cSQL_Detail_Update +" [location] ='"+cShipLocation+"'"
		
			cSQL_Detail_Update = cSQL_Detail_Update +",S_QTY = " 	+ STR(nStockLst_QTY,18,4) + ""
			cSQL_Detail_Update = cSQL_Detail_Update +",S_P = " 		+ STR(nStockLst_P,18,4) + ""
			cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = "  + STR(nS_Total,18,4) + ""
			cSQL_Detail_Update = cSQL_Detail_Update +",S_PU = " 	+ STR(nS_PU) + ""
		
			cSQL_Detail_Update = cSQL_Detail_Update +" WHERE ID_Detail = "+STR(nID_Detail)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Detail_Update )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Detail_Update )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Detail_Update, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL_Detail_Update, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Detail_Update,ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL_Detail_Update)
				lSQLgood = .F.
			ENDIF
			********
			***********************************
			*Save Stock ID Changes.
			IF nID_Detail_Process > 0
				ThisformSet.frmWorkOrder.txtFID_Detail_Process.Value = nID_Detail_Process 
				IF nID_Detail_Process > 0
					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(0,128,255)
				ELSE
					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(240,240,240)
				ENDIF	
				IF nID_Detail > 0
					ThisFormSet.frmWorkOrder.txtfID_Detail.Value = nID_Detail
					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(0,128,255)
					
					IF nMaster_ID > 0
						ThisFormSet.frmWorkOrder.txtfTBL.Value = "S"
						ThisFormSet.frmWorkOrder.chkStkListed.Value = 1
						
						PRIVATE cfTBL
						cfTBL = "S"
						
						*UPDATE dbo.WorkOrder_Detail
						cUpdate = "UPDATE dbo.WorkOrder_Detail SET "
					    cUpdate = cUpdate + " fTBL='"+cfTBL+"'"
					    cUpdate = cUpdate + " ,fID_Detail="+STR(nID_Detail)+""
					    cUpdate = cUpdate + " ,fID_Detail_Process="+STR(nID_Detail_Process)+""				    
					    cUpdate = cUpdate + " ,StkListed=1"
					    cUpdate = cUpdate + " ,NextCode='STK'"
					    cUpdate = cUpdate + " ,NextNumber = '"+STR(nMaster_ID)+"'"
					
					 	cUpdate = cUpdate + " WHERE WO_Detail= "+STR(nWO_Detail)
						 
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cUpdate, ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cUpdate )
						ENDIF
						
						MESSAGEBOX("Added to StockLst"+CHR(13)+" with an INCOMING process "+CHR(13)+" for WO Detail	"+STR(nWO_Detail),48,"Complete")
						
						ThisFormset.frmWorkOrder.txtfID_Detail.Value = nID_Detail
						ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(0,128,255)
						ThisFormset.frmWorkOrder.txtFID_Detail_Process.Value = nID_Detail_Process
						ThisFormSet.frmWorkOrder.txtfTBL.Value = cfTBL
					ENDIF
				ENDIF
			ELSE
				*POStatus says Part has been received!
				*an ERROR has occured on Master
				*or did not need to Save
			ENDIF  && lSQLGood AND lNeedSave AND nMaster_ID > 0
			
			
			**********
			*Insert the rtr
			PRIVATE lOK, cMess
			cMess = "WO Detail "+ALLTRIM(STR(nWO_Detail))+" listing produced Stock " 
			lOK = set_rtr_Detail_Oper('WOD', nWO_Detail, 95,         550, cMess+' ID_Detail_Process='+STR(nID_Detail_Process)+' ID_Detail='+ALLTRIM(STR(nID_Detail)) ,.T. ,ThisFormSet.nConnHandle)
			*			     pcOrder,   pOrder, pnDetail, pnOper_ID, pcOper_Note                                                                             , plStart, pConnHandle
				
		
			
			
		ELSE
			SQLROLLBACK(ThisFormSet.nConnHandle)
		ENDIF
		SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans
		
		***********
		IF lSQLgood AND nMaster_ID > 0 AND nID_Detail > 0 AND nWO_Detail > 0
			ThisFormSet.Show_frmStock_Produced(nWO_Detail)
		ENDIF
		
		RETURN lSQLgood
			
			
		
	ENDPROC

	PROCEDURE stocklst_process_custom_save
		PARAMETERS nID_Detail, cSOitem, cSalesPerson, nPU, nStockLst_QTY, nPounds, dDueDate, cPoItem, cTableName
		*ThisFormSet.StockLst_Process_Custom_Save( nID_Detail, cSOitem, cSalesPerson, nPU, nStockLst_QTY, nPounds, dDueDate, cPoItem, 'StockLst')
		
		*NOT nPieces,nPWeight,cComment,cTableName
		PRIVATE nWO_Detail
		*nWO_Detail = ThisFormSet.nWO
		nWO_Detail = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		PRIVATE dtStartDate, cAllowSub
		PRIVATE cProcess_ID, cProcessor, cComment
		
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item("STOCK")
			*Only create a 'SELECTED' WHEN not Stock!
			RETURN .T.
		ENDIF
		
		dtStartDate = DATETIME()
		cAllowSub 	= 'N'
		cProcess_ID = "SELECTED"
		
		PRIVATE cMach_User, cUserName 
		cMach_User = SYS(0)
		cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		
		cProcessor	= ShowSQLtxt(cUserName,'User',20)
		cComment = "Custom Stock - Do not substitue!" 
		cComment = cComment+CHR(13)+"This SELECTED process was created for the PO item:"+ALLTRIM(cPoItem)+"."
		
		PRIVATE cTBL
		cTBL = TBL_TableName(cTableName)
		
		PRIVATE cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= ''
		nPrc_PCs	= 0
		nPrc_Dim1	= 0
		nPrc_Dim2	= 0
		nPrc_Dim3	= 0
		
		IF nID_Detail > 0
			SELECT 0
			Get_Stock_Detail(cTBL,nID_Detail,ThisFormSet.nConnHandle)
			IF USED('tmpStock_Detail_Dim')
				cPrc_Form	= PrepareSQLtxt(tmpStock_Detail_Dim.Form,'Form',2)
				nPrc_PCs	= PrepareSQLnum(tmpStock_Detail_Dim.PC,'Pieces',-3)
				nPrc_Dim1	= PrepareSQLnum(tmpStock_Detail_Dim.Dim1,'Dim1',10,4)
				nPrc_Dim2	= PrepareSQLnum(tmpStock_Detail_Dim.Dim2,'Dim2',9,3)
				nPrc_Dim3	= PrepareSQLnum(tmpStock_Detail_Dim.Dim3,'Dim3',9,3)
		
				USE IN tmpStock_Detail_Dim
			ENDIF
		ENDIF
		
		*****************
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		**Check for existing Proc
		PRIVATE lNewProcess
		lNewProcess =.F.
		PRIVATE nID_Detail_Process, nReceivingID
		nID_Detail_Process = 0
		nReceivingID = 0
		
		
		cSQL = "SELECT P.ID_Detail_Process, ReceivingID FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + "dbo.StockLst_Process P "
		CASE cTBL = "B"
			cSQL = cSQL + "dbo.BrokerLst_Process P "
		CASE cTBL = "W"
			cSQL = cSQL + "dbo.WIPLst_Process P "
		ENDCASE
		
		**cSQL = cSQL + " WHERE P.ID_Detail = "+STR(nID_Detail)  **ID_Detail has changed!!  **Saving the PO, deleted and Recreated the ID,ID_Detail!!
		cSQL = cSQL + " WHERE ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
		*cSQL = cSQL + " AND P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		IF Proper_PO_item(cPoItem) != Proper_PO_item('')
			cSQL = cSQL + " AND P.PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		ENDIF
		IF nWO_Detail > 0
			cSQL = cSQL + " AND P.WO_Detail = "+STR(nWO_Detail)
		ENDIF
		
		cSQL = cSQL + " AND P.Comment LIKE '%Custom Stock%'"
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF VARTYPE(tmpID_Detail_Process.ID_Detail_Process) = "N"
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.ID_Detail_Process,'ID_Detail_Process',-3)
				nReceivingID = PrepareSQLnum(tmpID_Detail_Process.ReceivingID,'ReceivingID ',-3)
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
					
		
		IF nID_Detail_Process = 0
			*New Process
			cProcess_ID = "SELECTED"
		
			cSQLi = "EXEC dbo.p_Lst_Process_ins "
			cSQLi = cSQLi + " @TBL = '"+cTBL+"'"
			cSQLi = cSQLi + ",@ID_Detail ="+STR(nID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
			cSQLi = cSQLi + ",@Startdate = '"+TTOC(DATETIME())+"'"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"   &&'Y' Computer does not Select the Stock!
		
			cSQLi = cSQLi + ",@PU	= "+STR(nPU)
			cSQLi = cSQLi + ",@QTY	= "+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Pounds ="+STR(nPounds,9,1)
		
			cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
			cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
			cSQLi = cSQLi + ",@WO 	= "+STR(0)
			cSQLi = cSQLi + ",@WO_Detail= "+STR(nWO_Detail )	
		
			cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
			cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
			cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
			cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID)
			
			cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
			cSQLi = cSQLi + ",@Prc_PCs  = "+STR(nPrc_PCs)
			cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
			cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
			cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
			cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Ordered_P = "+STR(0)
				
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			IF nSQLEXEC < 0
				*retry
				WAIT WINDOW 'Slow SQL' TIMEOUT 3
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 1
				SQLExecError(cSQLi, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLi )
				TrackError("Could not EXEC dbo.p_Lst_Process_ins ","p_Lst_Process_ins ",PROGRAM(),LINENO(1))
			ELSE
		
		*		=SQLCOMMIT(ThisFormSet.nConnHandle)
				IF USED("tmpID_Detail_Process")
					nID_Detail_Process = tmpID_Detail_Process.exp		
					USE IN tmpID_Detail_Process
				ELSE
					nID_Detail_Process = 0
				ENDIF
		
			ENDIF
			
		ELSE
			*Update
			DO CASE
			CASE cTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Process SET "
			CASE cTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Process SET "
			CASE cTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Process SET "
			ENDCASE
			
			cSQL = cSQL+ " SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL+ ",PO_item = dbo.f_ProperPOitem('"+cPOItem+"')"
			cSQL = cSQL+ ",SalesPerson= '"+cSalesPerson+"'"
			cSQL = cSQL+ ",StartDate='"+TTOC(DATETIME())+"'"
			cSQL = cSQL+ ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQL = cSQL+ ",AllowSub='"+STRTRAN(cAllowSub,"'","''")+"'"
			*cSQL = cSQL+ ",PWeight="+STR(nPWeight,9,2)
			*cSQL = cSQL+ ",PPc="+STR(nPPc)
		
			cSQL = cSQL+ ",PU="+STR(nPU)
			cSQL = cSQL+ ",Process_ID='"+cProcess_ID+"'"
			cSQL = cSQL+ ",Processor='"+cProcessor+"'"
			cSQL = cSQL+ ",Comment='"+STRTRAN(cComment,"'","''")+"'"
			cSQL = cSQL+ ",QTY="+STR(nStockLst_QTY,18,4) &&ERP Acct Standard -QTY in Process.
			*Ordered_QTY &&ERP Acct Standard
			*PU	&&ERP Acct Standard
			cSQL = cSQL+ ",Pounds="+STR(nPounds,9,1)
			cSQL = cSQL+ ",ID_Detail="+STR(nID_Detail)
			
			cSQL = cSQL+ ",Prc_Form = '"+cPrc_Form+"'"
			cSQL = cSQL+ ",Prc_PCs  = "+STR(nPrc_PCs)
			cSQL = cSQL+ ",Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
			cSQL = cSQL+ ",Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
			cSQL = cSQL+ ",Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
			
			cSQL = cSQL+ ",Ordered_QTY="+STR(nStockLst_QTY,18,4)
			*WO
			*WO_Detail
			cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				lOK = .F.
			ELSE
		
			ENDIF
		ENDIF
		
		IF lOK 
			
		ENDIF
		
	ENDPROC

	PROCEDURE stocklst_process_remove_custom
		PARAMETERS nID_Detail, cPoItem, cTableName
		*ThisFormSet.StockLst_Process_Remove_Custom( nID_Detail, cPoItem, 'StockLst' )
		*Copied from PurchaseOrder Class
		
		PRIVATE cSQLi, nSQLEXEC, lOK, cTBL
		lOK = .T.
		
		*cComment = "Custom Stock - Do not select as typical stock!" 
		
		IF UPPER(cTableName) != "STOCKLST"
			*came from Broker- Find nID_Detail of StockLst to Delete
			cTBL="B"
			nID_Detail = 0
			IF USED("tmpID_Detail_ProcessIDD")
				USE IN tmpID_Detail_ProcessIDD
			ENDIF
			
			cSQL = "SELECT P.ID_Detail FROM dbo.StockLst_Process P "
			cSQL = cSQL + " WHERE Process_ID = 'SELECTED'"
			cSQL = cSQL + " AND P.PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
			cSQL = cSQL + " AND P.Comment LIKE 'Custom Stock - Do not select as typical stock!%'"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpID_Detail_ProcessIDD')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpID_Detail_ProcessIDD' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_ProcessIDD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_ProcessIDD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_ProcessIDD' )
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		
			IF USED('tmpID_Detail_ProcessIDD')
				IF VARTYPE(tmpID_Detail_ProcessIDD.ID_Detail) = "N"
					nID_Detail = tmpID_Detail_ProcessIDD.ID_Detail
				ENDIF
				USE IN tmpID_Detail_ProcessIDD
			ENDIF
						
			cTableName = "StockLst"
		ELSE
			cTBL = "S"
		ENDIF
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		**Check for existing Proc
		PRIVATE lNewProcess
		lNewProcess =.F.
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		cSQL = "SELECT P.ID_Detail_Process FROM dbo.StockLst_Process P "
		cSQL = cSQL + " WHERE P.ID_Detail = "+STR(nID_Detail)
		cSQL = cSQL + " AND P.Process_ID = 'SELECTED'"
		*cSQL = cSQL + " AND P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND P.PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		cSQL = cSQL + " AND P.Comment LIKE 'Custom Stock - Do not select as typical stock!%'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF VARTYPE(tmpID_Detail_Process.ID_Detail_Process) = "N"
				nID_Detail_Process = tmpID_Detail_Process.ID_Detail_Process
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
					
		IF nID_Detail_Process > 0
			*DELETE
			
			IF Remove_ID_Detail_Process(nID_Detail_Process,'','',cTbl,ThisFormSet.nConnHandle,"CORRECTION")
				lOK = .T.
			ELSE
				lOK = .F.
			ENDIF
		ENDIF
		
		IF lOK 
			
		ENDIF
		RETURN lOK 
		
	ENDPROC

	PROCEDURE tmpspcmpltp
	ENDPROC

	PROCEDURE totalfinishweight
		PARAMETERS nWO
		*ThisFormSet.TotalFinishWeight()
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpWOD_Total")	
			USE IN tmpWOD_Total
		ENDIF
		SELECT 0
		
		cSQL = "SELECT SUM(fWeight) AS TotWeight FROM dbo.WorkOrder_Detail WHERE WO="+ALLTRIM(STR(nWO))
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOD_Total')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOD_Total')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD_Total")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD_Total")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOD_Total')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		PRIVATE nTotWeight 
		nTotWeight = 0
		
		IF USED('tmpWOD_Total')
			IF RECCOUNT('tmpWOD_Total') > 0
				nTotWeight = PrepareSQLnum(tmpWOD_Total.TotWeight,'Weight',9,1)
			ENDIF
			USE IN tmpWOD_Total
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		
		RETURN nTotWeight 
	ENDPROC

	PROCEDURE Unload
		
		
		IF ThisFormSet.nConnhandle > 0
			= SQLDISCONNECT(ThisFormSet.nConnhandle)
		ENDIF
	ENDPROC

	PROCEDURE updatewodetail_proj		&& Have new  ID for WOD
		*ThisFormSet.UpdateWODetail_Proj() &&Stock_Projected_ID 
		
		IF USED('tmpProjStk')
			PRIVATE cMess, nMess
			cMess = ""
			nMess = 0
			
			PRIVATE cFAlloy,cFForm,cFCC,cFCL,nFPieces,nFThck,nFSz2,nFSz3,nFWeight
			nFPieces	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
			cFAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
			cFForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFForm.Value,'Form',2)
			cFCC		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCC.Value,'CC',1)
			cFCL		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCL.Value,'CL',1)
			nFthck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',14,4)
			nFSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz2.Value,'Sz2',13,3)
			nFSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz3.Value,'Sz3',13,3)
			nFWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFWeight.Value,'Weight',11,1)
		
			
			*ThisFormSet.frmStock_Projected.txtCompany.Value 	= tmpProjStk.Company   &&Not needed on Detail
			*ThisFormSet.frmStock_Projected.txtID.Value 		= tmpProjStk.ID
			PRIVATE cpAlloy
			cpAlloy = PrepareSQLtxt(tmpProjStk.Alloy,'Alloy',12)
			IF EMPTY(cFAlloy)
				ThisFormSet.frmWorkOrder.txtFAlloy.Value 	= cpAlloy
			ELSE
				IF ThisFormSet.frmWorkOrder.txtFAlloy.Value 	!= cpAlloy
					nMess = MESSAGEBOX("Alloy is currently listed as '"+cFAlloy+"'"+CHR(13)+"Do you wish to change to Projected Stock Alloy '"+cpAlloy+"'",32,"Replace Alloy?")
					IF nMess = 6
						ThisFormSet.frmWorkOrder.txtFAlloy.Value = cpAlloy
						cFAlloy = cpAlloy
					ENDIF
				ENDIF
			ENDIF
			ThisFormSet.frmWorkOrder.cmbfForm.Value 	= tmpProjStk.Form
			ThisFormSet.frmWorkOrder.cmbfCC.Value 		= tmpProjStk.CC
			ThisFormSet.frmWorkOrder.cmbfCL.Value 		= tmpProjStk.CL
			
			ThisFormSet.frmWorkOrder.txtfThck.Value 	= PrepareSQLnum(tmpProjStk.thck,'Thck',9,3)
			ThisFormSet.frmWorkOrder.txtfSz2.Value 		= PrepareSQLnum(tmpProjStk.YearInches,'YearInches',9,3)
			
			*ThisFormSet.frmWorkOrder.txtMinPounds.Value 	= PrepareSQLnum(tmpProjStk.MinPounds,'MinPounds',-3)
			ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= 0	
			ThisFormSet.frmWorkOrder.txtFWeight.Value 	= PrepareSQLnum(tmpProjStk.YearPounds,'YearPounds',-3)
			
			ThisFormSet.frmWorkOrder.txtFSpec.Value			= PrepareSQLtxt(tmpProjStk.FSpec,'FSpec',50)	
			ThisFormSet.frmWorkOrder.txtFCondLevel.Value	= PrepareSQLtxt(tmpProjStk.CLtext,'FCondLevel',30)	
				
			ThisFormSet.frmWorkOrder.cmbFollowM.Value		= PrepareSQLtxt(tmpProjStk.FollowM,'FollowM',20)
			ThisFormSet.frmWorkOrder.txtFollowLot.Value		= PrepareSQLnum(tmpProjStk.FollowLot,'FollowLot',-3)
			
			ThisFormSet.frmWorkOrder.txtStartSize.Value 	= PrepareSQLnum(tmpProjStk.SNomThck,'SNomThck',9,3)
			ThisFormSet.frmWorkOrder.txtCW.Value			= PrepareSQLnum(tmpProjStk.CW,'CW',-1)
			ThisFormSet.frmWorkOrder.txtRoughSize.Value 	= PrepareSQLnum(tmpProjStk.SThck,'RoughSize',8,3)
			ThisFormSet.frmWorkOrder.txtOverSize.Value		= PrepareSQLnum(tmpProjStk.OverSize,'OverSize',5,3)
		
		*,PT.CWCnt ,PT.CWMin, PT.CWAvg, PT.CWMedian, PT.CWMax, PT.StartDia "
		*CLText , FSpec, fWeight, LBS_Needed 
		ELSE
			MESSAGEBOX("Table 'tmpProjStk' was not Found.",16,"Error")
		ENDIF	
		
	ENDPROC

	PROCEDURE workorderscreen
		PARAMETERS pWhat
		*ThisFormSet.AddressScreen("ENABLE")
		
		DO CASE
		CASE pWhat = "DISABLE"
			ThisFormSet.SetVfrmWorkOrder(.F.)
		CASE pWhat = "ENABLE"
			ThisFormSet.SetVfrmWorkOrder(.T.)
		ENDCASE
		
	ENDPROC

	PROCEDURE wo_poitem
		PARAMETERS nWO, cPOitem, cWhat 
		*ThisFormSet.WO_POitem(nCurrWO, cPOitem, cWhat)
		
		*Save WO to PurchaseOrder
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "UPDATE dbo.PurchaseOrder "
		IF cWhat = "ADD"
			cSQL = cSQL + " SET WO="+STR(nWO)
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL = cSQL + " AND ISNULL(WO,0)=0"
		ELSE
			*cWhat = "REMOVE"
			cSQL = cSQL + " SET WO=0"
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL = cSQL + " AND ISNULL(WO,0)="+STR(nWO)
		ENDIF
			
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			TrackMess("Added WO "+ALLTRIM(STR(nWO))+" to POitem '"+cPOitem+"'"+CHR(13)+cSQL )
		ENDIF
	ENDPROC

	PROCEDURE frmChooseWO.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ConditionCode')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		*This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE frmChooseWO.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'FormCode')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

