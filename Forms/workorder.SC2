		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSS')
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSS")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSS")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSS')
		*!*			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*		ENDIF
		*!*		IF USED('tmpSS')
		*!*			IF RECCOUNT('tmpSS') > 0
		*!*				ThisFormset.frmWorkOrder.txtPieces.Value	= tmpSS.Pieces
		*!*				ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpSS.Alloy
		*!*				ThisFormset.frmWorkOrder.cmbForm.Value		= tmpSS.Form
		*!*				ThisFormSet.RefreshForms(tmpWO.sForm)
		*!*				ThisFormset.frmWorkOrder.cmbCC.Value		= tmpSS.CC
		*!*				ThisFormSet.InitcmbCL()
		*!*				ThisFormset.frmWorkOrder.cmbCL.Value		= tmpSS.CL
		*!*				ThisFormset.frmWorkOrder.txtHeat.Value		= ''
		*!*				
		*!*				ThisFormset.frmWorkOrder.txtThck.Value		= tmpSS.thck
		*!*				ThisFormset.frmWorkOrder.txtSz2.Value		= tmpSS.Sz2
		*!*				ThisFormset.frmWorkOrder.txtSz3.Value		= tmpSS.Sz3
		*!*				ThisFormset.frmWorkOrder.txtWeight.Value	= tmpSS.Weight
		*!*				* Descript, comment, SOitem, POitem, RandLen, Metric
		*!*				*ThisFormSet.frmWorkOrder.chkIntP.Value		= 0
		*!*				ThisFormset.frmWorkOrder.txtDescript.Value	= tmpSS.Descript
		*!*				*ThisFormset.frmWorkOrder.edtWO_Notes.Value	= tmpSS.
		*!*				
		*!*				IF Proper_PO_item(tmpWSO.POitem) = Proper_PO_item('')
		*!*					IF Proper_PO_item(tmpSS.POitem) != Proper_PO_item('')
		*!*						ThisFormSet.frmWorkOrder.txtPOitem.Value = Proper_PO_item(tmpSS.POitem)
		*!*					ENDIF
		*!*				ENDIF
		*!*				
		*!*				ThisFormSet.pWhat = "START"
		*!*				
		*!*			ENDIF
		*!*			USE IN tmpSS
		*!*		ENDIF
		*!*		
		*!*		ThisFormset.frmWorkOrder.txtWO.Value 	= GetNextWorkOrder(ThisFormSet.nConnhandle)
		*!*		ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
		*!*		*ThisFormset.frmWorkOrder.txtWO.Enabled = .F.
		*!*		
		*!*		ThisFormSet.Set_frmWorkOrder('ENABLE')
		*!*		
		*!*		RETURN .T.
		*!*	ELSE
		*!*		MESSAGEBOX("Cannot Import!",32,"No Data")
		*!*		RETURN .F.
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE printworkorder_matreq
		*PrintWorkOrder_MatReq()
		
		PRIVATE nWO
		nWO		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		PRIVATE cSOitem, cPOitem
		cSOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		
		IF USED('tmpWO')
			USE IN tmpWO
		ENDIF
		SELECT 0
		
		*cSQL = "SELECT * FROM dbo.WorkOrder WHERE WO ="+STR(nWO)
		cSQL = "SELECT WO.* "
		cSQL = cSQL + ",P.Comment, P.Process_ID"
		cSQL = cSQL + ",P.QTY, P.PU, P.Ordered_QTY "
		cSQL = cSQL + ",SS.Heat,SS.StockLst_QTY "
		cSQL = cSQL + ",ISNULL(ACWO.AC_ID,0) AS AC_ID_WO "
		cSQL = cSQL + " FROM dbo.WorkOrder WO WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales_Stock SS WITH(NOLOCK) ON SS.WO = WO.WO "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON P.WO = WO.WO "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WO ACWO ON WO.WO = ACWO.WO "
		cSQL = cSQL + " WHERE WO.WO ="+STR(nWO)
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO')
				IF RECCOUNT('tmpWO') > 0
				
					REPORT FORM reports\WorkOrder_MatReq NOCONSOLE TO PRINTER PROMPT
				
				*	REPORT FORM reports\WorkOrder_Prod_Detail NOCONSOLE TO PRINTER PROMPT
				ENDIF	
				USE IN tmpWO
			ENDIF
		ENDIF
			
		
	ENDPROC

	PROCEDURE printworkorder_production
		PARAMETERS pWhat
		*ThisFormSet.PrintWorkOrder_Production("Preview")
		
		IF ThisFormSet.RouterDetailOrder_IsOpen()
			*IF Thisformset.frmRouterDetailOrder.Visible
			*Thisformset.frmRouterDetailOrder.AlwaysOnTop = .T.
			MESSAGEBOX("Close the 'Router Detail Order'"+CHR(13)+"Window First.",16,"Another Window is Open")
			Thisformset.frmRouterDetailOrder.cmdReturn.SetFocus
			RETURN .F.
		ENDIF
		
		
		IF VARTYPE(pWhat) != "C"
			pWhat = 'Preview'
		ENDIF
		pWhat = UPPER(pWhat)
		PRIVATE nMess
		nMess = 0
		
		PRIVATE nWO, nWO_Detail
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		***********
		IF nWO_Detail = 0
			*Must Save First
			IF MESSAGEBOX("There is no WO_Detail"+CHR(13)+"Is it OK to save current WO/WO_Detail data (Y)?"+CHR(13)+"No WO_Detail data to Print!",4+32,"Save WO_Detail now?")=6
				ThisFormSet.SaveAddWO()   &&Saves WO and WO_Detail - creates the new WO_Detail number
				nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
			ENDIF
		ELSE
			ThisFormSet.SaveAddWO()  &&make sure all of the screen has been save to SQL
			nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		ENDIF
		***********
		
		IF nWO_Detail = 0
			RETURN .F.
		ENDIF
		
		
		PRIVATE cSOitem, cPOitem, cfPOitem
		cSOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		cfPOitem= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfPOitem.Value,'POitem',12)
		ThisFormSet.Refresh_FPOitem()  &&Opens tmpFPOitem Table
		
		
		PRIVATE lComplete, lCancelled, lfPrint, lfPRecv, lfMod, nfRev
		lComplete = PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfCmplt.Value,'fCmplt')
		lCancelled	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfCncld.Value,'fCncld')
		lfPrint	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfPrint.Value,'fPrint')
		lfPRecv	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfpRecv.Value,'fPRecv')
		lfMod	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfMod.Value,'fMod')
		nfRev	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfRev.Value,'fRev',-1)
		
		PRIVATE cSQL, nSQLEXEC 
		**************************
		
		IF NOT ( lCancelled OR lComplete )
			IF lfPRecv
				*Was marked as Print received, increment the fRev
				nfRev = nfRev + 1
			ENDIF
			
			cSQL = "UPDATE dbo.WorkOrder_Detail SET fPrint=1, fPRecv=0, fMod=0, fRev="+STR(nfRev)+" WHERE WO_Detail = "+STR(nWO_Detail)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				lfPrint = .T.
				lfPRecv = .F.
				lfMod   = .F.
				ThisFormset.frmWorkOrder.chkfPrint.Value	= lfPrint 
				ThisFormset.frmWorkOrder.chkfpRecv.Value	= lfPRecv 
				ThisFormset.frmWorkOrder.chkfMod.Value		= lfMod   	
				
				**********************************
				*Also do WorkOrder
				cSQL = "UPDATE dbo.WorkOrder SET ShopRecv = 0, Amendment="+STR(nfRev)+", PrintedWO=1 WHERE WO = "+STR(nWO)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
		
		
			ENDIF
			
		ENDIF
		
		****************************
		IF USED('tmpStock_Process')
			USE IN tmpStock_Process
		ENDIF
		
		SELECT 0
		cSQL = "SELECT SP.*,SD.* "
		cSQL = cSQL + " FROM dbo.StockLst_Process SP "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail SD ON SP.ID_Detail = SD.ID_Detail "
		cSQL = cSQL + " WHERE SP.WO = "+STR(nWO)
		cSQL = cSQL + " AND SP.Process_ID = 'SELECTED'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStock_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpStock_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStock_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStock_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStock_Process')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		*IF USED('tmpStock_Process')
		*ENDIF
		
		
		****************************
		
		PRIVATE lfrmWorkOrder
		IF ThisFormSet.frmWorkOrder.Visible
			ThisFormSet.SetVfrmWorkOrder(.F.)
		
			lfrmWorkOrder = .T.
		ELSE
			lfrmWorkOrder = .F.
		ENDIF
		
		****************************
		
		IF USED('tmpWO_SOi')
			USE IN tmpWO_SOi
		ENDIF
		
		SELECT 0
		cSQL = "SELECT WO.* "
		*cSQL = cSQL + " EnterDate,WO.SalesRep,WO.StartDate,WO.DueDate,WO.FinishDate"
		*cSQL = cSQL + " ,WO.Descript,WO.SOitem,WO.POitem "
		*cSQL = cSQL + " ,WO.sPieces,WO.sAlloy,WO.sForm,WO.sCC "
		*cSQL = cSQL + " ,WO.sThck,WO.sSz2,WO.sSz3 "
		*cSQL = cSQL + " ,WO.sWeight,WO.sID_Detail,WO.sID_Detail_Process "
		
		cSQL = cSQL + " ,WOD.* "
		*cSQL = cSQL + " ,WOD.WO,WOD.WO_Detail "
		*cSQL = cSQL + " ,WOD.StartDate AS WODStartDate "
		*cSQL = cSQL + " ,WOD.DueDate AS WODDueDate "
		*cSQL = cSQL + " ,WOD.FinishDate AS WODFinishDate "
		*cSQL = cSQL + " ,WOD.Descript AS WODDescript,WOD.[InqNumP] "
		*cSQL = cSQL + " ,WOD.SOitem AS WODSOitem "
		*cSQL = cSQL + " ,WOD.POitem AS WODPOitem "
		*cSQL = cSQL + " ,WOD.fPieces,WOD.fAlloy,WOD.fForm,WOD.fCC "
		*cSQL = cSQL + " ,WOD.fThck,WOD.fSz2,WOD.fSz3,WOD.fWeight,WOD.fID_Detail,WOD.fCmplt "
		cSQL = cSQL + " ,ISNULL(sPO.Company,'') AS sPOCompany "
		cSQL = cSQL + " ,ISNULL(fPO.Company,'') AS fPOCompany "
		cSQL = cSQL + ", ISNULL(ACWO.AC_ID,0) AS AC_ID_WO "
		cSQL = cSQL + ", ISNULL(ACWOD.AC_ID,0) AS AC_ID_WOD "
		cSQL = cSQL + " FROM dbo.WorkOrder WO "
		cSQL = cSQL + " INNER JOIN dbo.WorkOrder_Detail WOD ON WOD.WO = WO.WO "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder sPO ON WO.POitem = sPO.POitem "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder fPO ON WOD.fPOitem = fPO.POitem "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WO ACWO ON WO.WO = ACWO.WO "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WOD ACWOD ON WOD.WO_Detail = ACWOD.WO_Detail "
		cSQL = cSQL + " WHERE WO.WO = "+STR(nWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOi')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpWO_SOi')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_SOi")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_SOi')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			
			IF pWhat = "PREVIEW"
				REPORT FORM reports\WorkOrder_Production PREVIEW
			ELSE
				REPORT FORM reports\WorkOrder_Production NOCONSOLE TO PRINTER PROMPT
			ENDIF	
			*IF MESSAGEBOX("Also view the Detail Summary Page?",4+32,"Summary Page") = 6
				IF pWhat = "PREVIEW"
					REPORT FORM reports\WorkOrder_Prod_Detail PREVIEW
				ELSE
					REPORT FORM reports\WorkOrder_Prod_Detail NOCONSOLE TO PRINTER PROMPT
				ENDIF	
			*ENDIF	
		ENDIF
		***
		
		IF USED('tmpWO_SOi')
			USE IN tmpWO_SOi
		ENDIF
		
		*********************************************
		**** FOLLOW LOT
		PRIVATE nFollowLot, cFollowM, cFollowMlog
		nFollowLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFollowLot.Value,'FollowLot',-3)
		cFollowM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFollowM.Value,'FollowM',20)
		
		IF nFollowLot > 0 AND NOT EMPTY(cFollowM)
		
			cFollowMlog = AppSetup_Get_UN_From_PRP_ANS('Production Machine  ',cFollowM)
		
			nMess = MESSAGEBOX("Do you want to print the Follow lot paper?"+CHR(13)+CHR(13)+cFollowM+" "+ALLTRIM(STR(nFollowLot)),32+4,"Print "+cFollowMlog )
			IF nMess = 6
				*****************************
				DO CASE
				CASE cFollowMlog = 'Draw_Log'
				
					IF USED('Draw_log')
						USE IN Draw_log
					ENDIF
		
					SELECT 0
					cSQL = "SELECT * "
					cSQL = cSQL + " FROM dbo.Draw_log "
					cSQL = cSQL + " WHERE Lot = "+STR(nFollowLot)
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Draw_log')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Draw_log')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Draw_log")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Draw_log")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'Draw_log')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF			
		
					IF USED('Draw_log')
						IF RECCOUNT('Draw_log') > 0
							SELECT Draw_log
							IF pWhat = "PREVIEW"
								REPORT FORM reports\Draw_log PREVIEW
							ELSE
								REPORT FORM reports\Draw_log TO PRINTER PROMPT NOCONSOLE
							ENDIF	
						ENDIF	
						USE IN Draw_log 
					ENDIF
					
					
				*****************************
				CASE cFollowMlog = 'GFMlog'
				
					IF USED('GFMlog')
						USE IN GFMlog
					ENDIF
		
					SELECT 0
					cSQL = "SELECT * "
					cSQL = cSQL + " FROM dbo.GFMlog "
					cSQL = cSQL + " WHERE Lot = "+STR(nFollowLot)
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'GFMlog')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'GFMlog')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "GFMlog")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "GFMlog")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'GFMlog')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF
				
					
					IF USED('GFMlog')
						IF RECCOUNT('GFMlog') > 0
							SELECT GFMlog
							IF pWhat = "PREVIEW"
								REPORT FORM reports\GFMlog PREVIEW
							ELSE
								REPORT FORM reports\GFMlog TO PRINTER PROMPT NOCONSOLE
							ENDIF	
						ENDIF
						USE IN GFMlog
					ENDIF
					
				
				*********************************	
				CASE cFollowMlog = 'HT_Log'
				
				
					IF USED('HT_Log')
						USE IN HT_Log
					ENDIF
		
					SELECT 0
					cSQL = "SELECT * "
					cSQL = cSQL + " FROM dbo.HT_Log "
					cSQL = cSQL + " WHERE Lot = "+STR(nFollowLot)
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'HT_Log')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'HT_Log')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HT_Log")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "HT_Log")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'HT_Log')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF
					
					
					IF USED('HT_Log')
						IF RECCOUNT('HT_Log') > 0
							SELECT HT_Log
							IF pWhat = "PREVIEW"
