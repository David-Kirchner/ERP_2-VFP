		lCancelled	= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkfCncld.Value,'fCncld')	&&lCncld is WO -lCancelled is Detail
		
		DO CASE 
		CASE cWhat = 'ENABLE'
		
			IF NOT ( lCmplt OR lCncld )
		
				*ThisFormSet.frmWorkOrder.GetNextWO.Enabled = .F.
