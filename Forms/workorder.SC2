	PROCEDURE frmStock_Produced.cmdSaveWODtoStock.Click
		PRIVATE nWO,nWO_Detail, nWO_Detail_test, nID, nID_Detail, cLength
		nWO			= ThisFormSet.nWO
		nWO_Detail	= PrepareSQLnum(ThisForm.lblWO_D.Caption,'WO_Detail',-3)
		nWO_Detail_test = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nID			= PrepareSQLnum(tmpStock_Produced.ID,'ID',-3)
		nID_Detail	= PrepareSQLnum(tmpStock_Produced.ID_Detail,'ID_Detail',-3)
		cPOitem		= PrepareSQLtxt(tmpStock_Produced.PO_Item,'POitem',12)
		cLength		= PrepareSQLtxt(tmpStock_Produced.Length,'Length',160)
		
		PRIVATE nMess, lUpdateStock 
		lUpdateStock = .T.
		IF nWO_Detail_test > 0 AND nWO_Detail_test <> nWO_Detail
		
			nMess = MESSAGEBOX("This Stock is already associated with another WO_Detail";
				+CHR(13)+"Are you sure you want to change?"+CHR(13)+CHR(13);
				+"Only make this change if you know WO_Detail "+ALLTRIM(STR(nWO_Detail_test));
				+" is a mistake!"+CHR(13)+CHR(13);
				+"If ONE Stock Detail item was made by TWO different WO Details, something is wrong! ";
				+CHR(13)+"Report this situation to David to fix.",32,"Update Stock with new WO_Detail number.")
		
			IF nMess = 6
				lUpdateStock = .T.
			ELSE
				lUpdateStock = .F.
			ENDIF
		ENDIF
		
		IF nWO_Detail = 0
			lUpdateStock = .F.
			MESSAGEBOX("Bad WO_Detail",48,"Cannot Update Stock Detail")
		ENDIF
		IF nID = 0
			lUpdateStock = .F.
			MESSAGEBOX("Bad Stock ID",48,"Cannot Update Stock Detail")
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, lOK
		lOK = .T.
		*****************************************
		IF lUpdateStock AND lOK
			*Update Master with new WO_Detail
			cSQL = "UPDATE dbo.StockLst_Master "
			cSQL = cSQL + " SET WO_Detail = "+ALLTRIM(STR(nWO_Detail))
			cSQL = cSQL + " WHERE ID = "+STR(nID)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				lOK = .F.
			ELSE
				ThisForm.txtWO_Detail.Value = nWO_Detail
				*ThisFormSet.frmStock_Produced.cmdSaveWODtoStock.Enabled = .T.
				ThisForm.cmdSaveWODtoStock.Enabled = .F.
			ENDIF
		ENDIF
		
		*****************************************
		IF lUpdateStock AND lOK
			*Update Detail with new LENGTH message
			*cLength='Listing created from new PO:506647 needed for a SO:0.'
			PRIVATE cLengthNew
			cLengthNew = ''
			
			IF AT("needed for a",cLength) = 0
				IF LEFT(cLength,14) = "Listing created"
					cLengthNew = cLength + " needed fo a WOD:"+ALLTRIM(STR(nWO_Detail))
				ELSE
					cLengthNew = "Listing created," + " needed fo a WOD:"+ALLTRIM(STR(nWO_Detail))
				ENDIF
			ELSE
				cLengthNew = LEFT(cLength,AT("needed for a",cLength)+ 12)+"WOD:"+ALLTRIM(STR(nWO_Detail))
			ENDIF
			
			cSQL = "UPDATE dbo.StockLst_Detail "
			cSQL = cSQL + " SET Length = '"+cLengthNew+"'"
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				lOK = .F.
			ELSE
				SELECT tmpStock_Produced
				REPLACE Length WITH cLengthNew
				ThisForm.txtLength.Value = cLengthNew
			ENDIF	
		ENDIF
		
		*****************************************
		IF lUpdateStock AND lOK
			IF Proper_PO_item(cPOitem) != Proper_PO_item('')
				*Update the Process, If the process is an incoming by PO
				
				cSQL = "UPDATE dbo.StockLst_Process "
				cSQL = cSQL + " SET WO_Detail = "+ALLTRIM(STR(nWO_Detail))
				cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " AND PO_item = '"+cPOitem+"'"
				cSQL = cSQL + " AND Process_ID = 'INCOMING  '"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					lOK = .F.
				ELSE
					SELECT tmpStock_Produced
					REPLACE WO_Detail WITH nWO_Detail
					*tmpStock_Produced.WO_Detail.refresh
				ENDIF	
			ENDIF
		ENDIF
		
		*****************************************
		IF lUpdateStock AND lOK
			ThisFormSet.frmWorkOrder.chkStkListed.Value = 1
			
			cSQL = "UPDATE dbo.WorkOrder_Detail "
			cSQL = cSQL + " SET StkListed = 1"
			cSQL = cSQL + " WHERE WO_Detail = "+STR(nWO_Detail)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				lOK = .F.
			ENDIF	
		ENDIF
		
		*****************************************
	ENDPROC

