	ENDPROC

	PROCEDURE frmWorkOrder.cmdShowLabPO.Click
		PRIVATE cTestPO, nWO, nWO_Detail
		cTestPO = PrepareSQLtxt(ThisForm.txtTestPO.Value,'POItem',12)
		*nWO		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF Proper_PO_Item(cTestPO) <> Proper_PO_Item("")
			*cTestPO 
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_POitem(cTestPO,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		
		ENDIF
		
		*ShowPO_Testing "WO_Detail", nWO_Detail
		
		
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdShow_WIP.Click
		PRIVATE nWO, nWeight
		nWO = PrepareSQLnum(thisForm.txtWO.Value,'WO',-3)
		
		IF nWO = 0
			MESSAGEBOX("No WorkOrder Number",16,"Cannot Select Stock")
			RETURN .F.
		ENDIF
		nWeight = PrepareSQLnum(ThisForm.txtWeight.Value,'Weight',-3)
		IF nWeight = 0
			MESSAGEBOX("No Weight entered"+CHR(13)+"Enter the Estimated starting Weight First!",16,"Cannot Select Stock")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, nStkDetailCnt
		cSQL ="SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder WHERE WO = "+ALLTRIM(STR(nWO))
		nStkDetailCnt = 0
		
		IF USED('CntWO')
			USE IN CntWO
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CntWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CntWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,'CntWO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			nStkDetailCnt = 0
			lSQLgood = .F.
		ELSE
			IF USED("CntWO")
				nStkDetailCnt = PrepareSQLnum(CntWO.CNTD,'CNTD',-3)
				USE IN CntWO
			ELSE
				nStkDetailCnt = 0
			ENDIF
		ENDIF
		
		IF nStkDetailCnt = 0
			MESSAGEBOX("No WorkOrder Number saved in Table."+CHR(13)+"Save WO first.",16,"Cannot Select Stock")
			RETURN .F.
		ENDIF
		
		
		PRIVATE m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nPieces,m.nWeight,nQTY
		m.cAlloy	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtAlloy.Value,'Alloy',12)
		m.cForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbForm.Value,'Form',2)
		m.cCC		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCC.Value,'CC',1)
		m.cCL		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCL.Value,'CL',1)
		m.nThck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtThck.Value,'Thck',9,4)
		m.nSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz2.Value,'Sz2',8,3)
		m.nSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz3.Value,'Sz3',8,3)
		m.cSOItem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		nWO  		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		m.nSalesNum	= nWO
		m.nPieces	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		m.nWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWeight.Value,'Weight',7,1)
		nQTY 		= Calc_QTY(m.cAlloy,m.cForm,m.nPieces,m.nThck,m.nSz2,m.nSz3,'',ThisFormSet.nConnHandle)
		
		PRIVATE m.cSalesP,m.dSaleDate,m.dDueDate
		m.cSalesP	= '0'
		m.dSaleDate	= PrepareSQLDate(ThisFormSet.frmWorkOrder.txtStartDate.Value,'SaleDate')
		m.dDueDate	= PrepareSQLDate(ThisFormSet.frmWorkOrder.txtDueDate.Value,'DueDate')
		
		PRIVATE nHPAPO, cPoItem
		cPoItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		nHPAPO = VAL(cPoItem)
		
		*!*	PRIVATE cTBL
		IF Proper_PO_item(cPoItem) = Proper_PO_item('')
			cPoItem = PrepareSQLtxt(ThisForm.txtfPOitem.Value,'POitem',12)
		ENDIF
		*!*	IF Proper_PO_item(cPoItem) != Proper_PO_item('')
		*!*		**** Add code to see if a WIP or Broker Process had data!  --not always Broker
		*!*		
		*!*		cTBL = getTBL_Process_POitem(cPoItem,ThisFormSet.nConnhandle)
		*!*		IF EMPTY(cTBL)
		*!*			cTBL = "B"
		*!*		ENDIF
		*!*		
		*!*		*********
		*!*		IF cTBL = "B"
		*!*			IF MESSAGEBOX("Do you want to Select material on Broker List?"+CHR(13)+"Listing created by PO:"+cPOitem+" ?"+CHR(13)+CHR(13)+"Answer 'No' to choose from StockLst.",4+32,"On BrokerLst") = 6
		*!*				ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = "B"
		*!*				WAIT WINDOW "Using BrokerLst for POitem:"+ALLTRIM(cPOitem) TIMEOUT 1
		*!*			ELSE
		*!*				cTBL = "S"
		*!*				ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = cTBL
		*!*				WAIT WINDOW "Using StockLst" TIMEOUT 1
		*!*			ENDIF
		*!*		ENDIF
		*!*		*********
		*!*		IF cTBL = "W"
		*!*			IF MESSAGEBOX("Do you want to Select material on WIP List?"+CHR(13)+"Listing created by PO:"+cPOitem+" ?"+CHR(13)+CHR(13)+"Answer 'No' to choose from StockLst."+CHR(13)+"You probably want to choose from Stock. 'N'",4+32+256,"On BrokerLst") = 6
		*!*				ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = "W"
		*!*				WAIT WINDOW "Using WIP for POitem:"+ALLTRIM(cPOitem) TIMEOUT 1
		*!*			ELSE
		*!*				cTBL = "S"
		*!*				ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = cTBL
		*!*				WAIT WINDOW "Using StockLst" TIMEOUT 1
		*!*			ENDIF
		*!*		ENDIF
		*!*		********	
		*!*	ELSE
		*!*		cTBL = "S"
		*!*		ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = cTBL
		*!*		WAIT WINDOW "Using StockLst" TIMEOUT 1
		*!*	ENDIF
		*!*		
		
		*!*	IF USED('SalesQuote')
		*!*		USE IN SalesQuote
		*!*	ENDIF
		
		*!*	SELECT 0
		
		
		*	(SalesNum N(7), SOItem C(10), PO_num C(17), PCs N(10), Alloy C(12), Heat C(30), DESCRIPT C(80), Weight N(7,1), Kg L, PackWeight N(7,1);
		*	, PackingSli N(10) ,COMPLETE L, PartNo C(100), qShipped N(10), qBackOrder N(10) )
		
		PRIVATE cMEM
		cMEM = IIF( "\MEM" $ SYS(2003), '', '\MEM' )
		
		CREATE TABLE (SYS(5)+SYS(2003)+cMEM+"\"+"SalesQuote") FREE ;
			(Alloy C(12),Form C(2),CC C(1),CL C(1),Thck N(10,4),Sz2 N(9,3),Sz3 N(9,3),SalesP C(1),SaleDate D,Weight N(7,1),Pieces N(10),ShipDue D,SOItem_a C(10),Cover C(1))
		
		*LEFT( REPLACE(suser_sname(),'WINDFALL\',''),20)
		*SELECT Alloy,Form,Thck,Sz2,Sz3,SalesP,SaleDate,Weight,Pieces,ShipDue FROM SalesQuote WHERE SOItem_a = cSOitem	
		IF USED('SalesQuote')
			SELECT SalesQuote
			IF RECCOUNT('SalesQuote') = 0
				INSERT BLANK
			ENDIF
			REPLACE Alloy WITH cAlloy
			REPLACE Form WITH m.cForm
			REPLACE CC WITH m.cCC
			REPLACE CL WITH m.cCL
			REPLACE Thck WITH m.nThck
			REPLACE Sz2 WITH m.nSz2
			REPLACE Sz3 WITH m.nSz3
			REPLACE SalesP WITH m.cSalesP
			REPLACE SaleDate WITH m.dSaleDate
			REPLACE Weight WITH m.nWeight
			REPLACE Pieces WITH m.nPieces
			REPLACE ShipDue WITH m.dDueDate
			REPLACE SOItem_a WITH m.cSOitem
			REPLACE Cover WITH ''
			*NewSO_bySO_Finish() NewSO_byPO_Finish() Uses AllQuotes.Cover for frmWorkOrder.txtSalesRep
		ENDIF
		
		PRIVATE pID_Detail, m.nID
		m.nID = 0
		*old DO FORM Forms\StockLst_SQL_Quotes WITH "SEL_WO",cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''   ,nQTY,.F.,cPOitem TO pID_Detail
		*DO FORM Forms\StockLst_SQL_Browse WITH "BROWSE_WIP",'W',m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nWO, m.nPieces,m.nWeight,''     ,nQTY,.F.,cPOitem TO pID_Detail
		DO FORM Forms\StockLst_SQL_Modal WITH "BROWSE_WIP",'W',m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nWO, m.nPieces,m.nWeight,''     ,nQTY,.F.,cPOitem TO pID_Detail
		
		*PARAMETER pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem
		*Use MODAL if you need a Selection!
		*DO FORM Forms\stocklst_sql_browse WITH "BROWSE",'S',"718  ","10","1" ,'' ,.875 ,135,    0,     "",       0,   1,33 ,       '', 0.0,.F.,''
		*DO FORM Forms\stocklst_sql_browse WITH "BROWSE",'S',"HPA N50","10",'',"D",1,0,0,"",,1,10,''
		*DO FORM Forms\stocklst_sql_browse WITH "BROWSELot",'S',"157"
		
		*DO FORM Forms\StockLst_SQL_Modal WITH "SEL_WO",cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''     ,nQTY,.F.,cPOitem TO pID_Detail
		*Modal waits for a Return  PARAMETER pFunction,pTBL,  pAlloy,  pForm,  pCC,  pCL,  pThck,  pSz2,  pSz3,pSOItem, pSalesNum,      pPC,    pLBS,pHeatLot,pQTY,pRL,pPOitem
		*pID_Detail
		
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		*!*	PRIVATE lOverWrite
		*!*	lOverWrite = .T.
		
		*!*	PRIVATE nID_Detail
		*!*	nID_Detail = 0
		
		*!*	IF TYPE("pID_Detail") = "N"
		*!*		IF pID_Detail = 0
		*!*			*Look for old Selections.
		*!*			IF USED('tmpStkLstPWO')
		*!*				USE IN tmpStkLstPWO
		*!*			ENDIF
		*!*			SELECT 0
		*!*			
		*!*			cSQL = "SELECT ID_Detail"
		*!*			cSQL = cSQL +" FROM dbo.StockLst_Process "
		*!*			cSQL = cSQL +" WHERE WO = "+STR(nWO)
		*!*			cSQL = cSQL +" AND ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStkLstPWO')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStkLstPWO')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStkLstPWO")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStkLstPWO")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStkLstPWO')
		*!*				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*			ELSE
		*!*				IF USED("tmpStkLstPWO")
		*!*					pID_Detail	= PrepareSQLnum(tmpStkLstPWO.ID_Detail,'ID_Detail',-3)
		*!*					USE IN tmpStkLstPWO
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		IF pID_Detail > 0
		*!*			*Get StockLst
		*!*			*nID_Detail_Process = pID_Detail
		*!*			PRIVATE cSQL, nSQLEXEC
		*!*			cSQL = "SELECT m.ID,Alloy,Form,CC,CL,Heat,PC,Dim1,Dim2,Dim3,Weight,D.ID_Detail,P.QTY,P.Pounds"
		*!*			DO CASE
		*!*			CASE cTBL = "S"
		*!*				cSQL = cSQL +" FROM dbo.StockLst_Detail D "
		*!*				cSQL = cSQL +" INNER JOIN dbo.StockLst_Master M ON M.ID = D.ID "
		*!*				cSQL = cSQL +" INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
		*!*			CASE cTBL = "B"
		*!*				cSQL = cSQL +" FROM dbo.BrokerLst_Detail D "
		*!*				cSQL = cSQL +" INNER JOIN dbo.BrokerLst_Master M ON M.ID = D.ID "
		*!*				cSQL = cSQL +" INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
		*!*			CASE cTBL = "W"
		*!*				cSQL = cSQL +" FROM dbo.WIPLst_Detail D "
		*!*				cSQL = cSQL +" INNER JOIN dbo.WIPLst_Master M ON M.ID = D.ID "
		*!*				cSQL = cSQL +" INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
		*!*			ENDCASE
		*!*			cSQL = cSQL +" WHERE P.WO = "+STR(nWO)
		*!*			cSQL = cSQL +" AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
		*!*			*cSQL = cSQL +" AND D.ID_Detail = "+STR(pID_Detail)
		*!*			*cSQL = cSQL +" AND P.ID_Detail_Process  = "+STR(pID_Detail)
		
		*!*			IF USED("tmpStockLst_Detail")
		*!*				SELECT tmpStockLst_Detail
		*!*			ELSE
		*!*				SELECT 0
		*!*			ENDIF
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLst_Detail')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStockLst_Detail')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail')
		*!*				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*			ELSE
		*!*				IF USED("tmpStockLst_Detail")
		*!*					IF RECCOUNT("tmpStockLst_Detail")=1 &&>0
		*!*						PRIVATE nMess
		*!*						nMess = MESSAGEBOX("Do you want to overwrite WO Starting dimensions"+CHR(13)+"with the choosen Stock dimensions?"+CHR(13)+CHR(13)+"Handy if you are going to consume the whole Detail.",4+32+256,"Overwrite?") 
		*!*						IF nMess = 6
		*!*							lOverWrite = .T.
		*!*						ELSE
		*!*							lOverWrite = .F.
		*!*						ENDIF
		
		*!*						IF lOverWrite 
		*!*							PRIVATE nPieces, nPounds 
		*!*							
		*!*							ThisForm.txtAlloy.Value		= tmpStockLst_Detail.Alloy
		*!*							ThisForm.cmbForm.Value		= tmpStockLst_Detail.Form
		*!*							ThisForm.cmbCC.Value		= tmpStockLst_Detail.CC
		*!*							ThisFormSet.InitcmbCL()
		*!*							ThisForm.cmbCL.Value		= tmpStockLst_Detail.CL
		*!*							ThisForm.txtHeat.Value		= tmpStockLst_Detail.Heat
		*!*							
		*!*							ThisForm.txtPieces.Value	= tmpStockLst_Detail.PC   &&temp PC, recalc
		*!*							nPieces = PrepareSQLnum(tmpStockLst_Detail.PC,'PC',-3)
		*!*							ThisForm.txtThck.Value		= tmpStockLst_Detail.Dim1
		*!*							ThisForm.txtSz2.Value		= tmpStockLst_Detail.Dim2
		*!*							ThisForm.txtSz3.Value		= tmpStockLst_Detail.Dim3
		*!*							nPounds = PrepareSQLnum(tmpStockLst_Detail.QTY,'Pounds',9,1)
		*!*							ThisForm.txtWeight.Value	= tmpStockLst_Detail.QTY
		*!*							
		*!*							ThisFormSet.frmChooseWO.txtID_Detail.Value = tmpStockLst_Detail.ID_Detail
		*!*							
		*!*							IF tmpStockLst_Detail.Form = '20' OR tmpStockLst_Detail.Form = '22' OR tmpStockLst_Detail.Form = '23'
		*!*								ThisForm.txtSz2.Value = nPounds 
		*!*								ThisForm.txtWeight.Value = nPounds 
		*!*							ENDIF
		*!*							
		*!*							*****************************
		*!*							PRIVATE nPC_Pounds 
		*!*							nPC_Pounds = 0
		*!*							
		*!*							IF USED('tmpPriceTbl')
		*!*								USE IN tmpPriceTbl
		*!*							ENDIF
		*!*							SELECT 0
		*!*							
		*!*							PRIVATE cSQL
		*!*							cSQL = "EXEC dbo.p_GetFullQuoteCL "
		*!*							cSQL = cSQL + "@nPieces=1"      &&STR(nPieces)
		*!*							cSQL = cSQL + ",@cAlloy='"+ThisForm.txtAlloy.Value+"'"
		*!*							cSQL = cSQL + ",@cForm='"+ThisForm.cmbForm.Value+"'"
		*!*							cSQL = cSQL + ",@cCC='"+ThisForm.cmbCC.Value+"'"
		*!*							cSQL = cSQL + ",@cCL='"+ThisForm.cmbCL.Value+"'"
		*!*							cSQL = cSQL + ",@nThickness="+STR(PrepareSQLnum(ThisForm.txtThck.Value,'nThck',14,4),10,4)
		*!*							cSQL = cSQL + ",@nSize2="+STR(PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',12,3),9,3)
		*!*							cSQL = cSQL + ",@nSize3="+STR(PrepareSQLnum(ThisForm.txtSz3.Value,'nSz3',12,3),9,3)
		*!*							cSQL = cSQL + ",@nForceBracket=0"		&&+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		*!*							cSQL = cSQL + ",@cCustID='' " &&CustID
		*!*							
		*!*							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		*!*							ENDDO
		*!*							IF nSQLEXEC < 0 &&Try again!
		*!*								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
		*!*								DO WHILE nSQLEXEC = 0
		*!*									WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
		*!*									
		*!*									IF nSQLEXEC < 0
		*!*										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*											nSQLEXEC = 0
		*!*										ENDIF
		*!*									ENDIF
		*!*								ENDDO
		*!*							ENDIF 
		*!*							IF nSQLEXEC < 0
		*!*								SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
		*!*								RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*								
		*!*	*!*								PRIVATE cMess
		*!*	*!*								cMess = "Could not get the Price!"+CHR(13)
		*!*	*!*								*IF nPieces > 10000
		*!*	*!*								*	cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
		*!*	*!*								*ENDIF
		*!*	*!*								IF nThck > 16
		*!*	*!*									cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
		*!*	*!*								ENDIF
		*!*	*!*								IF nSz2	> 120
		*!*	*!*									cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
		*!*	*!*								ENDIF
		*!*	*!*								IF nSz3	 > 300
		*!*	*!*									cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
		*!*	*!*								ENDIF
		*!*	*!*								MESSAGEBOX(cMess,16,"Edit your input numbers")
		*!*								
		*!*							ENDIF
		*!*							
		*!*							IF USED('tmpPriceTbl')
		*!*								IF RECCOUNT('tmpPriceTbl') > 0
		*!*									nPC_Pounds = tmpPriceTbl.Pounds
		*!*								ENDIF
		*!*								USE IN tmpPriceTbl
		*!*							ENDIF
		*!*							
		*!*							IF nPC_Pounds > 0
		*!*								IF nPC_Pounds > nPounds
		*!*									*Stick with the new Stock
		*!*									nPounds = nPC_Pounds 
		*!*									nPieces = 1
		*!*								ELSE
		*!*									nPieces = ABS(nPounds/nPC_Pounds)+1
		*!*									nPounds = nPieces * nPC_Pounds 
		*!*								ENDIF
		*!*							ENDIF
		*!*							
		*!*							************************	
		*!*							
		*!*							*ThisFormSet.Calc_Weight("START",.T.)
		*!*							ThisFormSet.Set_frmWorkOrder_Descript("START")
		*!*							
		*!*							************************	
		
		*!*							*Ask about PC change
		
		*!*							*Ask about Weight Change and the pinit.
		
		
		*!*						ENDIF
		*!*					ENDIF								
		*!*					
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			IF USED("tmpStockLst_Detail")
		*!*				USE IN tmpStockLst_Detail
		*!*			ENDIF
		*!*		ENDIF
		*!*		********************
		*!*		IF pID_Detail > 0	
		*!*			ThisForm.chklPrc_Stock.Value = 1	
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	******
		*!*	ThisFormSet.Load_tmpSPStart(nWO)
		*!*	ThisFormSet.Load_tmpSPStartP(nWO)
		
		*!*	******
		*!*	IF USED('tmpSPStart')
		*!*		IF RECCOUNT('tmpSPStart') > 0
		*!*			ThisFormSet.frmWorkOrder.cmdConsumeStock.Visible = .T.
		*!*			ThisFormSet.frmWorkOrder.cmdConsumeStock.Enabled = .T.
		*!*		ENDIF
		*!*	ENDIF		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdViewStock.Click
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		*ThisFormSet.InitStock_Produced()  
