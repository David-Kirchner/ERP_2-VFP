	PROCEDURE Load
		
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_RTR ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE loadwo_frmchoosewo
		PARAMETERS pPOitem, pSOitem, pWO
		*ThisFormSet.LoadWO_frmChooseWO()
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpWO")	
			USE IN tmpWO
		ENDIF
		SELECT 0
		
		cSQL = "SELECT WO.* "
		cSQL = cSQL + ",0 AS AC_ID_WO "
		cSQL = cSQL + " FROM dbo.WorkOrder WO "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tmpWO')
			IF RECCOUNT('tmpWO') > 0
				
				ThisFormSet.SetVfrmWorkOrder(.F.)
				
				ThisFormSet.frmWorkOrder_Unload()
				
				ThisFormSet.InitChooseWO(pPOitem, pSOitem, pWO)  
		
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE loadwo_frmworkorder
		*ThisFormSet.LoadWO_frmWorkOrder()
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpWO")	
			USE IN tmpWO
		ENDIF
		SELECT 0
		
		cSQL = "SELECT WO.* "
		cSQL = cSQL + ",0 AS AC_ID_WO "
		cSQL = cSQL + " FROM dbo.WorkOrder WO "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tmpWO')
			IF RECCOUNT('tmpWO') > 0
						
				IF EMPTY(ThisFormSet.pWhat)
					ThisFormSet.pWhat = "CHOOSE"
				ENDIF
		
				
				ThisFormSet.EditByWO(ThisFormSet.nWO)
		
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE load_lst_wo_detail
		PARAMETERS nWO
		*ThisformSet.Load_lst_WO_Detail(nWO)
		
		ThisFormset.frmWorkOrder.lstWO_Detail.Clear
		ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .F.
		
		IF USED("tmp_gaWOD")	
			USE IN tmp_gaWOD
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT WOD.WO_Detail "
		cSQL = cSQL +" FROM dbo.WorkOrder_Detail WOD "
		cSQL = cSQL +" WHERE WOD.WO ="+STR(nWO)
			
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmp_gaWOD')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmp_gaWOD')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmp_gaWOD")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmp_gaWOD")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmp_gaWOD')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tmp_gaWOD')
			
			PRIVATE nCurrRec
			nCurrRec = RECNO('tmp_gaWOD')
			
			DIMENSION gaWO_Detail(1)
			gaWO_Detail(1) = 0
		
			SELECT WO_Detail FROM tmp_gaWOD INTO ARRAY gaWO_Detail
			*ThisFormSet.frmChooseWO.lstWO.NumberOfElements = ALEN(gaWO_Detail,1)
			ThisFormSet.frmWorkOrder.lstWO_Detail.NumberOfElements = ALEN(gaWO_Detail,1)
			ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .T.
			ThisFormSet.frmWorkOrder.lstWO_Detail.Refresh
		
			USE IN tmp_gaWOD 
		ELSE
			MESSAGEBOX("Could not get WO_Detail for WO to show in lst_WO_Detail"+CHR(13)+"You will need to restart program",0,"Error")
			TrackError("Could not get WO_Detail for WO to show in lst_WO_Detail","WO_Detail", PROGRAM(), LINENO(1))
		ENDIF
		
		*!*				nWOD_pos = ASCAN(gaWO_Detail, nWO_Detail) 
		*!*				IF nWOD_pos > 0
		*!*					ThisFormSet.frmWorkOrder.lstWO_Detail.Value = nWOD_pos
		*!*					ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .T.
		*!*					ThisFormSet.frmWorkOrder.lstWO_Detail.Refresh
		*!*				ENDIF
		
	ENDPROC

	PROCEDURE load_tmpspcmpltp
		PARAMETERS nWO
		*ThisFormSet.Load_tmpSPcmpltP(nWO)
		
		ThisFormSet.frmStockUsed.Left	= ThisFormSet.frmWorkOrder.Left + ThisFormSet.frmWorkOrder.Width +10
		ThisFormSet.frmStockUsed.Top 	= ThisFormSet.frmWorkOrder.Top
		
		PRIVATE cSOitem, cfSOitem
		IF ThisFormSet.frmWorkOrder.Visible
			cSOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
			cfSOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfSOitem.Value,'SOitem',10)
		ELSE
			cSOitem = Proper_SO_item('')
			cfSOitem = Proper_SO_item('')
		ENDIF
		
		***********************
		*Find Completed Process in Sales_Stock.
		
		IF USED("tmpSPcmpltP")	
			USE IN tmpSPcmpltP
		ENDIF
		SELECT 0
		
		cSQL =       " SELECT "
		cSQL = cSQL +"  SS.[TBL]" &&'S' AS TBL "
		cSQL = cSQL +" ,SS.Heat "
		cSQL = cSQL +" ,SS.[StockEdit] AS DateMod " &&,D.InvCheck AS StockEdit "
		
		*--,Removed_PC, Orig_PC, PS_PC, Pick_PC
		*cSQL = cSQL +" ,SS.[Pick_PC] AS StockLst_PC "
		cSQL = cSQL +" ,ISNULL(Removed_PC,0) AS Pieces "
		cSQL = cSQL +" ,ISNULL(Removed_LBS,0) AS Pounds "
		
		*--StockLst_QTY, Pick_QTY, Removed_QTY, PS_QTY
		cSQL = cSQL +" ,SS.StockLst_PU AS PU"
		cSQL = cSQL +" ,ISNULL(Removed_QTY,0) AS QTY "
		*cSQL = cSQL +" ,ISNULL(SS.Removed_QTY) AS Ordered_QTY "
		cSQL = cSQL +" ,ISNULL(StockLst_QTY,0) AS Ordered_QTY "
		cSQL = cSQL +" ,SS.[StockLst_ID_Detail] " &&AS StockLst_ID_Detail "
		cSQL = cSQL +" ,SS.[ID_Detail_Process] " &&AS ID_Detail_Process "
		cSQL = cSQL +" ,SS.WO_Detail,SS.SOitem "
		cSQL = cSQL +" ,dbo.f_DescriptCL(Alloy,CC,CL,Form,Removed_Dim1,Removed_Dim2,Removed_Dim3,Removed_LBS,RandLen) AS DescriptCL "
		cSQL = cSQL +" FROM dbo.Sales_Stock SS WITH(NOLOCK) "
		
		IF cfSOitem <> Proper_SO_item('')
			*Also report SOitem Selects.
			IF cSOitem <> Proper_SO_item('')
				*Also report SOitem Selects.
				cSQL = cSQL +" WHERE ( SS.WO = "+STR(nWO)+" OR SS.SOitem = '"+cfSOitem+"' OR SS.SOitem = '"+cSOitem+"'" + ") "
			ELSE
				cSQL = cSQL +" WHERE ( SS.WO = "+STR(nWO)+" OR SS.SOitem = '"+cfSOitem+"'" + ") "
			ENDIF
		ELSE
			IF cSOitem <> Proper_SO_item('')
				*Also report SOitem Selects.
				cSQL = cSQL +" WHERE ( SS.WO = "+STR(nWO)+" OR SS.SOitem = '"+cSOitem+"'" + ") "
			ELSE
				cSQL = cSQL +" WHERE SS.WO = "+STR(nWO)
			ENDIF
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSPcmpltP')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSPcmpltP')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSPcmpltP")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSPcmpltP")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSPcmpltP')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION gaSPcmpltP(1)
		gaSPcmpltP(1) = 0
		
		IF USED('tmpSPcmpltP')
			IF RECCOUNT('tmpSPcmpltP') > 0
				
				ThisFormSet.frmStockUsed.lstSPcmpltP.RowSource = ''
				
				SELECT tmpSPcmpltP
				SELECT ID_Detail_Process FROM tmpSPcmpltP INTO ARRAY gaSPcmpltP
				
				GO TOP
				
				ThisFormSet.frmStockUsed.lstSPcmpltP.RowSource = 'gaSPcmpltP'
				ThisFormSet.frmStockUsed.lstSPcmpltP.Refresh
				
				ThisFormSet.RefreshID_Detail_ProcessCP( 0 )
					*CALLS: ThisFormSet.Load_tmpSPcmpltP(ThisFormSet.nWO)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE load_tmpspstart
		PARAMETERS nWO
		*ThisFormSet.Load_tmpSPStart(nWO)  --can be run before WO exists
		*Finds stock that has been Selected for WO or SOitem or POitem
		
		PRIVATE cSOitem, cPOitem
		cSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'Poitem',12)
		
		IF USED("tmpSPStart")	
			USE IN tmpSPStart
			ThisFormSet.frmWorkOrder.cmdWO_StockProc.Visible = .F.
		ENDIF
		SELECT 0
		
		cSQL = " SELECT P.*, 'S' AS TBL "
		cSQL = cSQL + " ,D.Dim1,D.Dim2,D.Dim3,D.S_QTY "
		*cSQL = cSQL + " ,P.Pounds, P.QTY, P.PU, P.Ordered_QTY "
		cSQL = cSQL + " ,M.Heat "
		cSQL = cSQL + " ,dbo.f_DescriptCL(M.Alloy,M.CC,M.CL,M.Form,D.Dim1,D.Dim2,D.Dim3,D.Weight,RandLen) AS DescriptCL "
		cSQL = cSQL + " FROM dbo.StockLst_Process P "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
		cSQL = cSQL + " WHERE ( "
		IF nWO > 0
			cSQL = cSQL +" P.WO = "+STR(nWO)
		ENDIF
		IF Proper_SO_item(cSOitem) != Proper_SO_item('')
			IF nWO > 0
				cSQL = cSQL +" OR "
			ENDIF
			cSQL = cSQL +" P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		ENDIF
		
		*Do not include POitem here, only show where WO and SELECTED
		*!*	IF Proper_PO_item(cPOitem) != Proper_PO_item('')
		*!*		IF nWO > 0 OR Proper_PO_item(cSOitem) != Proper_PO_item('')
		*!*			cSQL = cSQL +" OR "
		*!*		ENDIF
		*!*		cSQL = cSQL +" P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*	ENDIF
		cSQL = cSQL +")"
		
		cSQL = cSQL +" AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' "
		cSQL = cSQL +")"
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT P.*, 'B' AS TBL "
		cSQL = cSQL + " ,D.Dim1,D.Dim2,D.Dim3,D.S_QTY "
		cSQL = cSQL + " ,M.Heat "
		cSQL = cSQL + " ,dbo.f_DescriptCL(M.Alloy,M.CC,M.CL,M.Form,D.Dim1,D.Dim2,D.Dim3,D.Weight,RandLen) AS DescriptCL "
		cSQL = cSQL + " FROM dbo.BrokerLst_Process P"
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
		cSQL = cSQL + " WHERE ( "
		IF nWO > 0
			cSQL = cSQL +" P.WO = "+STR(nWO)
		ENDIF
		IF Proper_SO_item(cSOitem) != Proper_SO_item('')
			IF nWO > 0
				cSQL = cSQL +" OR "
			ENDIF
			cSQL = cSQL +" P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		ENDIF
		
		*!*	IF Proper_PO_item(cPOitem) != Proper_PO_item('')
		*!*		IF nWO > 0 OR Proper_PO_item(cSOitem) != Proper_PO_item('')
		*!*			cSQL = cSQL +" OR "
		*!*		ENDIF
		*!*		cSQL = cSQL +" P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*	ENDIF
		cSQL = cSQL +")"
		cSQL = cSQL +" AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' "
		cSQL = cSQL +")"
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT P.*, 'W' AS TBL "
		cSQL = cSQL + " ,D.Dim1,D.Dim2,D.Dim3,D.S_QTY "
		cSQL = cSQL + " ,M.Heat "
		cSQL = cSQL + " ,dbo.f_DescriptCL(M.Alloy,M.CC,M.CL,M.Form,D.Dim1,D.Dim2,D.Dim3,D.Weight,RandLen) AS DescriptCL "
		cSQL = cSQL + " FROM dbo.WIPLst_Process P"
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
		cSQL = cSQL + " WHERE ( "
		IF nWO > 0
			cSQL = cSQL +" P.WO = "+STR(nWO)
		ENDIF
		IF Proper_SO_item(cSOitem) != Proper_SO_item('')
			IF nWO > 0
				cSQL = cSQL +" OR "
			ENDIF
			cSQL = cSQL +" P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		ENDIF
		
		*!*	IF Proper_PO_item(cPOitem) != Proper_PO_item('')
		*!*		IF nWO > 0 OR Proper_PO_item(cSOitem) != Proper_PO_item('')
		*!*			cSQL = cSQL +" OR "
		*!*		ENDIF
		*!*		cSQL = cSQL +" P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*	ENDIF
		cSQL = cSQL +") "
		cSQL = cSQL +" AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' "
		cSQL = cSQL +")"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSPStart')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSPStart')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSPStart")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSPStart")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSPStart')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		***************************
		
		*Reset data
		DIMENSION gaSPStart(1)
		gaSPStart(1) = 0
		ThisFormSet.frmWorkOrder.lstSPStart.Refresh
		
		ThisFormSet.frmWorkOrder.txtSPS_StartDate.Value = PrepareSQLdate('','StartDate')
		ThisFormSet.frmWorkOrder.txtSPS_Process_ID.Value = ''
		ThisFormSet.frmWorkOrder.txtSPS_QTY.Value 		= 0
		ThisFormSet.frmWorkOrder.txtSPS_QTY_Total.Value = 0
		ThisFormSet.frmWorkOrder.txtSPS_ID_Detail.Value = 0
		ThisFormSet.frmWorkOrder.txtSPS_TBL.Value	= ''
		ThisFormSet.frmWorkOrder.txtSPS_ID_Detail_Process.Value = 0
		ThisFormSet.frmWorkOrder.txtSPS_S_Qty.Value = 0
		ThisFormSet.frmWorkOrder.txtSPS_Dim1.Value = 0
		ThisFormSet.frmWorkOrder.txtSPS_Dim2.Value = 0
		ThisFormSet.frmWorkOrder.txtSPS_Dim3.Value = 0
		ThisFormSet.frmWorkOrder.txtSPS_Heat.Value = ''
		*,P.Pounds, P.QTY, P.PU, P.Ordered_QTY 
		*ThisFormSet.frmWorkOrder.txtSPc_Pounds.Value 		= tmpSPStartP.Pounds
		*ThisFormSet.frmWorkOrder.txtSPc_PQTY.Value 			= tmpSPStartP.Qty
		*ThisFormSet.frmWorkOrder.txtSPc_PPU.Value 			= tmpSPStartP.PU
		*ThisFormSet.frmWorkOrder.txtSPc_POrdered_QTY.Value 	= tmpSPStartP.Prdered_QTY
		
		
		*Just Get Total
		IF USED('tmpSPStart')
			IF RECCOUNT('tmpSPStart') > 0
				ThisFormSet.frmWorkOrder.cmdWO_StockProc.Visible = .T.
		
				*Get Total
				PRIVATE cTalk
				cTalk = SET('TALK')
				SET TALK OFF
		
				PRIVATE nTotalQTY
				nTotalQTY = 0
				
				SELECT tmpSPStart
				SUM S_QTY TO nTotalQTY
			
				IF cTalk = "ON"
					SET TALK ON
				ENDIF
			
				GO TOP
				ThisFormSet.frmWorkOrder.txtSPS_QTY_Total.Value = PrepareSQLnum(nTotalQTY,'TotalQTY',10,0)		&&Est QTY Needed for WO
			ENDIF
		ENDIF
				
		IF USED('tmpSPStart')
			IF RECCOUNT('tmpSPStart') > 0
				*frm Choose WorkOrder to Edit	
				
				ThisFormSet.frmWorkOrder.lstSPStart.RowSource = ''
				
				SELECT tmpSPStart
				SELECT ID_Detail_Process FROM tmpSPStart INTO ARRAY gaSPStart
				
				GO TOP
				
				ThisFormSet.frmWorkOrder.lstSPStart.RowSource = 'gaSPStart'
				ThisFormSet.frmWorkOrder.lstSPStart.Refresh
				ThisFormSet.RefreshID_Detail_Process( tmpSPStart.ID_Detail_Process )
				
				ThisFormSet.frmWorkOrder.cmdConsumeStock.Visible = .T.
				ThisFormSet.frmWorkOrder.cmdConsumeStock.Enabled = .T.
				
			ENDIF
		ENDIF
		
		*ThisFormSet.RefreshID_Detail_Process( nID_Detail_Process )
	ENDPROC

	PROCEDURE load_tmpspstartp
		PARAMETERS nWO
		*ThisFormSet.Load_tmpSPStartP(nWO) 'Process'
		*Finds stock that is DONE Complete and was a Selected process
		
		*ThisFormSet.frmWorkOrder.Left = 100
		ThisFormSet.frmStockUsed.Left = ThisFormSet.frmWorkOrder.Left + ThisFormSet.frmWorkOrder.Width +10
		ThisFormSet.frmStockUsed.Top = ThisFormSet.frmWorkOrder.Top
		*ThisFormSet.frmStockUsed.Visible = .T.
		*ThisFormSet.frmStockUsed.lstSPStartP.SetFocus
		
		PRIVATE cSOitem, cfSOitem
		IF ThisFormSet.frmWorkOrder.Visible
			cSOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
			cfSOitem = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfSOitem.Value,'SOitem',10)
		ELSE
			cSOitem = Proper_SO_item('')
			cfSOitem = Proper_SO_item('')
		ENDIF
		
		
		IF USED("tmpSPStartP")	
			USE IN tmpSPStartP
		ENDIF
		SELECT 0
		
		cSQL =       " SELECT M.Heat "
		cSQL = cSQL +" ,D.InvCheck AS StockEdit "
		cSQL = cSQL +" ,D.PC AS StockLst_PC "
		cSQL = cSQL +" ,D.S_QTY AS StockLst_Qty "
		cSQL = cSQL +" ,D.ID_Detail AS StockLst_ID_Detail "
		cSQL = cSQL +" ,P.ID_Detail_Process "
		cSQL = cSQL +" ,'S' AS TBL "
		cSQL = cSQL +" ,P.Pounds, P.QTY, P.PU, P.Ordered_QTY, P.SOitem "
		cSQL = cSQL +" ,dbo.f_DescriptCL(M.Alloy,M.CC,M.CL,M.Form,D.Dim1,D.Dim2,D.Dim3,D.Weight,D.RandLen) AS DescriptCL "
		cSQL = cSQL +" FROM dbo.StockLst_Process P "
		cSQL = cSQL +"  INNER JOIN dbo.StockLst_Detail D ON D.ID_Detail = P.ID_Detail "
		cSQL = cSQL +"  INNER JOIN dbo.StockLst_Master M ON M.ID = D.ID "
		IF cfSOitem <> Proper_SO_item('')
			*Also report SOitem Selects.
			IF cSOitem <> Proper_SO_item('')
				*Also report SOitem Selects.
				cSQL = cSQL +" WHERE ( P.WO = "+STR(nWO)+" OR P.SOitem = '"+cfSOitem+"' OR P.SOitem = '"+cSOitem+"'" + ") "
			ELSE
				cSQL = cSQL +" WHERE ( P.WO = "+STR(nWO)+" OR P.SOitem = '"+cfSOitem+"'" + ") "
			ENDIF
		ELSE
			IF cSOitem <> Proper_SO_item('')
				*Also report SOitem Selects.
				cSQL = cSQL +" WHERE ( P.WO = "+STR(nWO)+" OR P.SOitem = '"+cSOitem+"'" + ") "
			ELSE
				cSQL = cSQL +" WHERE P.WO = "+STR(nWO)
			ENDIF
		ENDIF
		cSQL = cSQL +" AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
		 cSQL = cSQL +" UNION "
		cSQL = cSQL +" SELECT M.Heat "
		cSQL = cSQL +" ,D.InvCheck AS StockEdit "
		cSQL = cSQL +" ,D.PC AS StockLst_PC "
		cSQL = cSQL +" ,D.S_QTY AS StockLst_Qty "
		cSQL = cSQL +" ,D.ID_Detail AS StockLst_ID_Detail "
		cSQL = cSQL +" ,P.ID_Detail_Process "
		cSQL = cSQL +" ,'S' AS TBL "
		cSQL = cSQL +" ,P.Pounds, P.QTY, P.PU, P.Ordered_QTY, P.SOitem "
		cSQL = cSQL +" ,dbo.f_DescriptCL(M.Alloy,M.CC,M.CL,M.Form,D.Dim1,D.Dim2,D.Dim3,D.Weight,D.RandLen) AS DescriptCL "
		cSQL = cSQL +" FROM dbo.BrokerLst_Process P "
		cSQL = cSQL +"  INNER JOIN dbo.BrokerLst_Detail D ON D.ID_Detail = P.ID_Detail "
		cSQL = cSQL +"  INNER JOIN dbo.BrokerLst_Master M ON M.ID = D.ID "
		IF cfSOitem <> Proper_SO_item('')
			*Also report SOitem Selects.
			IF cSOitem <> Proper_SO_item('')
				*Also report SOitem Selects.
				cSQL = cSQL +" WHERE ( P.WO = "+STR(nWO)+" OR P.SOitem = '"+cfSOitem+"' OR P.SOitem = '"+cSOitem+"'" + ") "
			ELSE
				cSQL = cSQL +" WHERE ( P.WO = "+STR(nWO)+" OR P.SOitem = '"+cfSOitem+"'" + ") "
			ENDIF
		ELSE
			IF cSOitem <> Proper_SO_item('')
				*Also report SOitem Selects.
				cSQL = cSQL +" WHERE ( P.WO = "+STR(nWO)+" OR P.SOitem = '"+cSOitem+"'" + ") "
			ELSE
				cSQL = cSQL +" WHERE P.WO = "+STR(nWO)
			ENDIF
		ENDIF
		cSQL = cSQL +" AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
		 cSQL = cSQL +" UNION " 
		cSQL = cSQL +" SELECT M.Heat "
		cSQL = cSQL +" ,D.InvCheck AS StockEdit "
		cSQL = cSQL +" ,D.PC AS StockLst_PC "
		cSQL = cSQL +" ,D.S_QTY AS StockLst_Qty "
		cSQL = cSQL +" ,D.ID_Detail AS StockLst_ID_Detail "
		cSQL = cSQL +" ,P.ID_Detail_Process "
		cSQL = cSQL +" ,'S' AS TBL "
		cSQL = cSQL +" ,P.Pounds, P.QTY, P.PU, P.Ordered_QTY, P.SOitem "
		cSQL = cSQL +" ,dbo.f_DescriptCL(M.Alloy,M.CC,M.CL,M.Form,D.Dim1,D.Dim2,D.Dim3,D.Weight,D.RandLen) AS DescriptCL "
		cSQL = cSQL +" FROM dbo.WIPLst_Process P "
		cSQL = cSQL +"  INNER JOIN dbo.WIPLst_Detail D ON D.ID_Detail = P.ID_Detail "
		cSQL = cSQL +"  INNER JOIN dbo.WIPLst_Master M ON M.ID = D.ID "
		IF cfSOitem <> Proper_SO_item('')
			*Also report SOitem Selects.
			IF cSOitem <> Proper_SO_item('')
				*Also report SOitem Selects.
				cSQL = cSQL +" WHERE ( P.WO = "+STR(nWO)+" OR P.SOitem = '"+cfSOitem+"' OR P.SOitem = '"+cSOitem+"'" + ") "
			ELSE
				cSQL = cSQL +" WHERE ( P.WO = "+STR(nWO)+" OR P.SOitem = '"+cfSOitem+"'" + ") "
			ENDIF
		ELSE
			IF cSOitem <> Proper_SO_item('')
				*Also report SOitem Selects.
				cSQL = cSQL +" WHERE ( P.WO = "+STR(nWO)+" OR P.SOitem = '"+cSOitem+"'" + ") "
			ELSE
				cSQL = cSQL +" WHERE P.WO = "+STR(nWO)
			ENDIF
		ENDIF
		cSQL = cSQL +" AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
		 
		 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSPStartP')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSPStartP')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSPStartP")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSPStartP")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSPStartP')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		
		DIMENSION gaSPStartP(1)
		gaSPStartP(1) = 0
		
		
		IF USED('tmpSPStartP')
			IF RECCOUNT('tmpSPStartP') > 0
				*frm Choose WorkOrder to Edit	
				ThisFormSet.frmStockUsed.lstSPStartP.RowSource = ''
				
				SELECT tmpSPStartP
				SELECT ID_Detail_Process FROM tmpSPStartP INTO ARRAY gaSPStartP
				
				GO TOP
				
				ThisFormSet.frmStockUsed.lstSPStartP.RowSource = 'gaSPStartP'
				ThisFormSet.frmStockUsed.lstSPStartP.Refresh
				
				ThisFormSet.RefreshID_Detail_ProcessP( 0 )
				
				*ThisFormSet.Show_frmStockUsed(tmpWO.WO) 
				
			ENDIF
		ENDIF
		
		***********************
		*Find Completed Process in Sales_Stock.
		ThisFormSet.Load_tmpSPcmpltP(nWO)
		
	ENDPROC

	PROCEDURE make_process_grab
		PARAMETERS nID_Detail_Process,cTBL
		*ThisFormSet.Make_Process_Grab(nID_Detail_Process,cTBL)
		
		*check for Process_Grab to see if Insert is needed.
		PRIVATE cSQL, nSQLEXEC 
		IF USED("cntProcessGrb")
			USE IN cntProcessGrb
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ID_Detail "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process_Grab "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM  dbo.BrokerLst_Process_Grab "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process_Grab "
		OTHERWISE
			MESSAGEBOX("Make_Process_Grab() did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("Make_Process_Grab() did not recognize Table Name","Make_Process_Grab() did not recognize Table Name",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntProcessGrb' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntProcessGrb' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntProcessGrb")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntProcessGrb")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		PRIVATE lOK
		lOK = .T.
		IF nSQLEXEC < 0
			IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntProcessGrb')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				lOK = .F.
			ENDIF
		ENDIF
		PRIVATE lInsert
		lInsert = lOK   &&should be True
		
		IF USED('cntProcessGrb')
			IF RECCOUNT('cntProcessGrb')>0
				IF cntProcessGrb.ID_Detail > 0
					lInsert = .F.
				ENDIF
			ENDIF
			USE IN cntProcessGrb
		ENDIF
		
		IF lInsert
			PRIVATE cSQLi 
			cSQLi = "EXEC dbo.p_Lst_Process_Grab_ins "
			cSQLi = cSQLi + "@ID_Detail_Process="+STR(nID_Detail_Process)+""
			cSQLi = cSQLi + ",@TBL='"+cTBL+"'"
			*INSERT INTO dbo.StockLst_Process_Grab 
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ELSE 
				*MESSAGEBOX("Made the SELECTED process as Process_Grab",0,"Grabbed")
				WAIT WINDOW "created Process_Grab record" NOWAIT
			ENDIF 
		ENDIF
		
		
	ENDPROC

	PROCEDURE make_wo_rtr_detail_from_soitem
		PARAMETERS cSOitem, nWO ,biRTR_ID
		*ThisFormSet.Make_WO_rtr_Detail_from_SOitem(cSOitem,nWO,nrtr_ID)	
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('rtrSOitem')
			USE IN rtrSOitem
		ENDIF
		
		cSQL = "SELECT SOitem, GFM, Roll, Mach, CG, Plasma, WJet, TYP, cncld, cmplt "
		cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
		cSQL = cSQL + " AND cncld = 0 AND cmplt = 0 "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,cSQL, 'rtrSOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL'  TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'rtrSOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "rtrSOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "rtrSOitem")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC,'rtrSOitem')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		
		IF USED('rtrSOitem')
			IF RECCOUNT('rtrSOitem') > 0
			
				*lNeed_rtr = DoesSOitem_need_rtr(m.cSOitem,ThisFormSet.nConnHandle)
				*nrtr_ID = get_rtr_ID('SOI',m.cSOitem)
				
				PRIVATE nOper_ID, nStdDetail, cOper_Note
				
				IF PrepareSQLlogic(rtrSOitem.GFM,'GFM',.F.)
		*!*					nOper_ID = get_Oper_ID('Radial Forge', nConn)
		*!*					nStdDetail = get_StndDetail('Radial Forge', nConn)
		
		*!*					cOper_Note = "Found GFM maked in SO"
		*!*					lOK = Add_rtr_Oper( biRTR_ID, nStdDetail, nOper_ID, cOper_Note, nConn )
		*!*					lOK = set_rtr_Detail_Oper('WO' ,nWO, nStdDetail, nOper_ID, cOper_Note, nConn)
				ENDIF
				IF PrepareSQLlogic(rtrSOitem.Roll,'Roll',.F.)
				ENDIF
				IF PrepareSQLlogic(rtrSOitem.Mach,'MACH',.F.)
				ENDIF
				IF PrepareSQLlogic(rtrSOitem.CG,'CG',.F.)
					*EXEC dbo.p_rtr_Oper 'WO',STR(nWO),520,1
				ENDIF
				IF PrepareSQLlogic(rtrSOitem.Plasma,'Plasma',.F.)
				ENDIF
				IF PrepareSQLlogic(rtrSOitem.WJet,'WJet',.F.)
				ENDIF
				IF PrepareSQLtxt(rtrSOitem.TYP,'TYP',1) = 'P'
				ENDIF
				
				*lOK = set_rtr_Detail_Oper('SOi',m.cSOitem,90,0,'Print Order',.F.,nConn)
				
				
			ENDIF
			USE IN rtrSOitem
		ENDIF
	ENDPROC

