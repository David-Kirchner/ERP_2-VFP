	ENDPROC

	PROCEDURE reloadpurchaseorder		&& Used for frmPO
		PARAMETERS pHow
		*ThisFormSet.ReloadPurchaseOrder()
		*"ALL" or cPOitem
		
		PRIVATE cPOitem
		cPOitem = ''
		
		IF VARTYPE(pHow) != "C"
			pHow = ""
		ENDIF
		
		*IF Proper_PO_Item(pHow) = Proper_PO_Item("ALL")
		IF LEN(pHow) > 0
			IF pHow = "ALL"
				*Good
			ELSE
				cPOitem = Proper_PO_Item(pHow)
				pHow = "PO_ITEM"
			ENDIF
		ENDIF
		
		***** frmPOMaint is not here, frmPO is available here !!
		
		*ThisFormSet.frmPOMaint.pf1.pgEdit.grdPO.RecordSource = ''
		*ThisFormSet.frmPOMaint.pf1.pgBrowse.GridBR.RecordSource = ''
		*ThisFormSet.frmPOMaint.pf1.pgStockLst.GridSOi.RecordSource = ''
		
		IF USED('PurchaseOrder')
			USE IN PurchaseOrder
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		*cSQL = "SELECT * FROM dbo.PurchaseOrder  "&&WITH(NOLOCK)
		*!*	cSQL = "SELECT "
		*!*	cSQL = cSQL+" [POitem]"
		*!*	cSQL = cSQL+",[hpapo]"
		*!*	cSQL = cSQL+",[itempo]"
		*!*	cSQL = cSQL+",[SOitem]"
		*!*	cSQL = cSQL+",[Salesnum]"
		*!*	cSQL = cSQL+",[item]"
		*!*	cSQL = cSQL+",[SalesP]"
		*!*	cSQL = cSQL+",[Company]"
		*!*	cSQL = cSQL+",[Alloy]"
		*!*	cSQL = cSQL+",[Form]"
		
		*!*	cSQL = cSQL+",[pieces]"
		*!*	cSQL = cSQL+",[thck]"
		*!*	cSQL = cSQL+",[sz2]"
		*!*	cSQL = cSQL+",[sz3]"
		
		*!*	cSQL = cSQL+",[Order_QTY]"
		*!*	cSQL = cSQL+",[Order_P]"
		*!*	cSQL = cSQL+",[Order_PU]"
		
		*!*	cSQL = cSQL+",[p_lb]"
		*!*	cSQL = cSQL+",[p_pc]"
		*!*	cSQL = cSQL+",[p_ft]"
		*!*	cSQL = cSQL+",[lotp]"
		
		*!*	cSQL = cSQL+",[otherp]"
		*!*	cSQL = cSQL+",[otherfld]"
		*!*	cSQL = cSQL+",[orderdate]"
		*!*	cSQL = cSQL+",[due_min]"
		*!*	cSQL = cSQL+",[due_max]"
		*!*	cSQL = cSQL+",[received]"
		*!*	cSQL = cSQL+",[cond_spec]"
		*!*	cSQL = cSQL+",[misc_purch]"
		*!*	cSQL = cSQL+",[heat]"
		*!*	cSQL = cSQL+",[cert]"
		*!*	cSQL = cSQL+",[receivedby]"
		*!*	cSQL = cSQL+",[receipt]"
		*!*	cSQL = cSQL+",[delivered]"
		*!*	cSQL = cSQL+",[cancelled]"
		*!*	cSQL = cSQL+",[posalesp]"
		*!*	cSQL = cSQL+",[shipvia]"
		*!*	cSQL = cSQL+",[jobnumber]"
		*!*	cSQL = cSQL+",[Services]"
		*!*	cSQL = cSQL+",[ConvServ]"
		*!*	cSQL = cSQL+",[Equipment]"
		*!*	cSQL = cSQL+",[Stock]"
		*!*	cSQL = cSQL+",[Sheet_pk]"
		*!*	cSQL = cSQL+",[ShipWhere]"
		*!*	cSQL = cSQL+",[POshipaddr]"
		*!*	cSQL = cSQL+",[POpayaddr]"
		*!*	cSQL = cSQL+",[Randlen]"
		*!*	cSQL = cSQL+",[Metric]"
		*!*	cSQL = cSQL+",[Sz1Orig]"
		*!*	cSQL = cSQL+",[Sz2Orig]"
		*!*	cSQL = cSQL+",[Sz3Orig]"
		*!*	cSQL = cSQL+",[DispAlloy]"
		*!*	cSQL = cSQL+",[StandSize]"
		*!*	cSQL = cSQL+",[Amendment]"
		*!*	cSQL = cSQL+",[Printed]"
		*!*	cSQL = cSQL+",[VendCode]"
		*!*	cSQL = cSQL+",[ContactID]"
		*!*	cSQL = cSQL+",[Terms]"
		*!*	cSQL = cSQL+",[FOB]"
		*!*	cSQL = cSQL+",[HPA_Due_Min]"
		*!*	cSQL = cSQL+",[HPA_Due_Max]"
		*!*	cSQL = cSQL+",[First_Due_Max]"
		*!*	cSQL = cSQL+",[Reconciled]"
		*!*	cSQL = cSQL+",[ReconcileTotal]"
		*!*	cSQL = cSQL+",[StockLst_QTY]"
		*!*	cSQL = cSQL+",[StockLst_P]"
		*!*	cSQL = cSQL+",[BMScheck]"
		*!*	cSQL = cSQL+",[ShipLocation]"
		*!*	cSQL = cSQL+",[VendorPOConf]"
		
		*!*	cSQL = cSQL+",[CC]" &&moved- Browse formats would need to be edited.
		*!*	cSQL = cSQL+" FROM dbo.PurchaseOrder  "&&WITH(NOLOCK)
		
		cSQL = "SELECT * FROM dbo.PurchaseOrder WITH(NOLOCK) "
		   
		*IF pHow = "ALL"
			*All
		*	ThisFormSet.AllRecordsRetrieved = .T.
		
		IF NOT ThisFormSet.AllRecordsRetrieved
			cSQL = cSQL + " WHERE OrderDate >= '"+DTOC( DATE()-720 )+"'"
			ThisFormSet.AllRecordsRetrieved = .F.
		ENDIF
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'PurchaseOrder' )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		***
		IF NOT USED('PurchaseOrder')
			*try again
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PurchaseOrder' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PurchaseOrder")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'PurchaseOrder' )
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		ENDIF
		***
		IF NOT USED('PurchaseOrder')
			MESSAGEBOX("Could not get the PurchaseOrder Table!",16,"DATA ERROR")
			RETURN .F.
		ENDIF
		***
		
		SELECT PurchaseOrder
		INDEX ON POitem TAG POitem
		SET ORDER TO POItem
		INDEX ON ValPOitem(POitem) TAG VALPOitem
		SET ORDER TO VALPOitem
		
		GO Bottom
		
		DO CASE
		CASE EMPTY(pHow) 
			SKIP -3
		CASE pHow = "ALL"
			SKIP -3
			WAIT WINDOW 'All records are now shown' NOWAIT
		CASE pHow = "PO_ITEM"
			SEEK cPOitem ORDER TAG POitem IN PurchaseOrder
		OTHERWISE
			*pHow is POitem to goto after update
			SEEK pHow ORDER TAG POitem IN PurchaseOrder
		ENDCASE
		
		*ThisFormSet.frmPOMaint.pf1.pgEdit.grdPO.RecordSource = 'PurchaseOrder'
		*ThisFormSet.frmPOMaint.pf1.pgBrowse.GridBR.RecordSource = 'PurchaseOrder'
		*ThisFormSet.frmPOMaint.pf1.pgStockLst.GridSOi.RecordSource = 'PurchaseOrder'
		
		
	ENDPROC

	PROCEDURE remove_id_detail_process
		PARAMETER pID_Detail_Process, pSOitem, pTbl, cWhat
		*Remove_ID_Detail_Process(m.ID_Detail_Process,cSOitem,cTbl,cwhat)
