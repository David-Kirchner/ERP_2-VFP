	PROCEDURE frmWorkOrder.lblChooseS_SOitem.Click
		PRIVATE nSalesNum, cSOItem, nMess 
		cSOItem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		nSalesNum = VAL(cSoItem)
		
		PRIVATE lSelectedTheOnlySOitem
		lSelectedTheOnlySOitem = .F.
		
		IF nSalesNum > 0
			nMess = MESSAGEBOX("A SO is listed here. '"+cSOItem +"'"+CHR(13)+"Do you want to keep this SO number?"+CHR(13)+"Answer Y to Continue."+CHR(13)+"Answer N to clear the SO Number.",4+32,"Continue with SO?")
			IF nMess = 7
				*Yes, Clear POitem field
				ThisForm.txtSOitem.Value = ''
				
				ThisFormSet.Remove_SOitem(cSOItem,'WO')	
				MESSAGEBOX("The SOitem '"+cSOItem+"' has been removed."+CHR(13)+"This edit needs to be saved.",0+48,"Removed SOitem.")
					
				RETURN
			ENDIF
		ENDIF
		
		IF nSalesNum = 0
			MESSAGEBOX("SO is Empty."+CHR(13)+"Select a SO in next Window."+CHR(13)+"SO Item would be asked in yet another Window.",0,"Choose the SO")
			DO FORM Forms\ChooseSO WITH "ChooseSO" TO nSalesNum
			IF nSalesNum > 0
				IF Count_ItemsinSales (nSalesNum, ThisFormSet.nConnHandle, '') > 0
					lSelectedTheOnlySOitem = .T.		
					cSOItem = Proper_SO_item(STR(nSalesNum,7)+"-01")
				ENDIF
			ENDIF
		ENDIF
		
		IF nSalesNum > 0 
			IF NOT lSelectedTheOnlySOitem 
				MESSAGEBOX("Now select the SOitem "+CHR(13)+CHR(13)+"To remove this SO Item,"+CHR(13)+"use [Cancel] instead of [Select] in the next Window.",0,"Select the SOitem")
				DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSOItem
			ENDIF
		ENDIF
		
		***********
		PRIVATE nWO, lRE
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		*lIntP = PrepareSQLlogic(ThisForm.chkIntP.Value,'IntP')
		lRE = PrepareSQLlogic(ThisForm.chkRE.Value,'RE')
		
		IF VARTYPE(cSoItem) = "C"
			IF Proper_SO_item(cSoItem) != Proper_SO_item('')
				IF Count_SOIteminSales(cSoItem, ThisFormSet.nConnHandle, '') > 0
					
					ThisForm.txtSOitem.Value = cSOItem
					
					*******************************
					*Update Sales with WO
			
					cSQL = "UPDATE dbo.Sales SET WO="+STR(nWO)
					*cSQL = cSQL + ",IntP="+IIF(lIntP,"1","0")
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 		
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF	
					
					*******************************
					
					*UPDATE WorkOrder
					cSQLu = "UPDATE dbo.WorkOrder SET"
					cSQLu = cSQLu + " SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
					*cSQLu = cSQLu + " POitem = dbo.f_ProperPOitem('"+cPoItem+"')"
					cSQLu = cSQLu + ",RE="+IIF(lRE,"1","0")
					*cSQLu = cSQLu + ",IntP="+IIF(lIntP,"1","0")
					cSQLu = cSQLu + " WHERE WO= "+STR(nWO)
					 
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 		
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
					ELSE
						
					ENDIF
					*******************************
					
					*nMess = MESSAGEBOX("Are you trying to import the contents of a SO?"+CHR(13)+"Answer Y to Select an EXISITING SOitem.",4+32,"Select a SO to use.")			
					*IF ThisFormSet.AddWOD_SOitem(cSOitem)
					
					*******************************
					PRIVATE cPoItem, nWO_Detail
					cPoItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
					nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
					
					IF Proper_PO_item(cPoItem) != Proper_PO_item('')
					
						IF MESSAGEBOX("Do you want PO item '"+cPOitem+"' to be copied into Sales Order Also?",4+32,"Record PO item with this SO?") = 6
		
							*UPDATE PurchaseOrder
							cSQLu = "UPDATE dbo.PurchaseOrder SET "
							cSQLu = cSQLu + " SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
							cSQLu = cSQLu + " ,WO_Detail = "+STR(nWO_Detail)
							*nWO
							cSQLu = cSQLu + " WHERE POitem = dbo.f_ProperPOitem('"+cPoItem+"')"
							 
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 		
							IF nSQLEXEC < 0
								SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
								RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
							ELSE
							
							ENDIF			
									
						ENDIF
					ENDIF
		
					MESSAGEBOX("You can now see this WO with the SO item '"+cSOitem+"'",0,"WO is conneted to SO")
							
				ELSE
					MESSAGEBOX("SO item '"+cSOitem+"' was not Found!",16,"NOT conneted to a SO")
				ENDIF
			ENDIF
		ELSE
			ThisForm.txtSOitem.Value = ''
		ENDIF
	ENDPROC

	PROCEDURE frmWorkOrder.lblConditionLevel.Click
		PRIVATE cfAlloy, cfForm, cfCC, cfCL, nfThck
		cFAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
		cFForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFForm.Value,'Form',2)
		cFCC		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCC.Value,'CC',1)
		cFCL		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCL.Value,'CL',1)
		nFthck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',14,4)
		
		IF EMPTY(cFCC)
			MESSAGEBOX("Need a Condition Code",48,"Exit")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE nCWAvg 
		nCWAvg = 0
		
		cSQL = "SELECT ISNULL(dbo.f_CC_CL_Min_Cw('"+cfAlloy+"','"+cfCC+"','"+cfCL+"',"+STR(nFthck,8,3)+"),0) AS CWMin "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Avg_Cw('"+cfAlloy+"','"+cfCC+"','"+cfCL+"',"+STR(nFthck,8,3)+"),0) AS CWAvg "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Median_Cw('"+cfAlloy+"','"+cfCC+"','"+cfCL+"',"+STR(nFthck,8,3)+"),0) AS CWMedian "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Max_Cw('"+cfAlloy+"','"+cfCC+"','"+cfCL+"',"+STR(nFthck,8,3)+"),0) AS CWMax "
		cSQL = cSQL+",ISNULL(dbo.f_CC_CL_Cnt('"+cfAlloy+"','"+cfCC+"','"+cfCL+"',"+STR(nFthck,8,3)+"),0) AS CWCnt "
		
		IF USED("tmp_CW")	
			USE IN tmp_CW
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmp_CW')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmp_CW')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmp_CW")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmp_CW")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmp_CW')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmp_CW')
			IF RECCOUNT('tmp_CW') > 0
				nCWAvg = tmp_CW.CWAvg
		
			ENDIF
			USE IN tmp_CW
		ENDIF
		
		
		IF nCWAvg > 0
			
			ThisFormSet.frmWorkOrder.txtCW.Value = nCWAvg
				
			PRIVATE nStartSize, nRoughSize, nOverSize
			nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
			nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
			nOverSize 	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
			
			IF nStartSize = 0
				nStartSize = PrepareSQLnum(ThisForm.txtThck.Value,'Thck',10,4)
			ENDIF
			IF nStartSize = 0
				MESSAGEBOX("Could not calculate Rough Size because there is no StartSize",48,"No StartSize")
				RETURN
			ELSE
				*M.A1= 3.14156*M.sD1*M.sD1/4
				*M.A2 = M.A1 - ( M.A1 * M.RA)
				*M.sD2 = SQRT(M.A2*4/3.14156)
				
				nRoughSize = SQRT( 3.14156*nStartSize*nStartSize/4 - (3.14156*nStartSize*nStartSize/4 * (nCWAvg/100)) *4/3.14156)
				ThisForm.txtRoughSize.Value = nRoughSize
				WAIT WINDOW STR(nRoughSize,9,3) NOWAIT
				
				IF nFthck > 0 AND nOverSize = 0
					nOverSize = nRoughSize - nFthck 
					ThisForm.txtOverSize.Value = nOverSize
				ENDIF
			ENDIF
			
			
			***************
			PRIVATE nSSz2, nFSz2
			nSSz2	= PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',8,3)
			nFSz2	= PrepareSQLnum(ThisForm.txtFSz2.Value,'Sz2',8,3)
			
			IF nSSz2 = 0 AND nFSz2 > 0
				nVolume = nFPieces * (3.14156*(nRoughSize*nRoughSize)/4) * nFSz2
				nSz2 = nVolume / ( nPieces * (3.14156*(nStartSize*nStartSize)/4) )
				ThisForm.txtSz2.Value = nSz2
				ThisFormSet.Calc_Weight('START',.F.)
			ENDIF
			IF nSSz2 > 0 AND nFSz2 = 0
				nVolume = nPieces * (3.14156*(nThck*nThck)/4) * nSz2
				nFSz2 = nVolume / ( nFPieces * (3.14156*(nRoughSize*nRoughSize)/4) )
				ThisForm.txtfSz2.Value = nFSz2
				ThisFormSet.Calc_Weight('FINISH',.F.)
			ENDIF
			
		ENDIF
		
		PRIVATE cText
		cText = ConditionLevelText(cfCC,cfCL)
		ThisFormSet.frmWorkOrder.txtfCondLevel.Value = cText
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblCW.Click
		PRIVATE nStartSize, nCW, nCWorig, nCWp, nRoughSize
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',2,0)
		nCWorig		= nCW
		nCWp		= 1+(nCW/100)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
					
		IF nCW <= 0
			WAIT WINDOW "Calculating ColdWork" NOWAIT
			IF nStartSize > 0
				IF nRoughSize > 0
					*FIND RA BY DIA'S    (ORIG-FINAL)/ORIG=%
					*M.A1= 3.14156*M.sD1*M.sD1/4
					*M.A2= 3.14156*M.sD2*M.sD2/4
					*M.sRA = (M.A1-M.A2)/M.A1
					nCWp = ((3.14156*nStartSize*nStartSize/4)-(3.14156*nRoughSize*nRoughSize/4))/(3.14156*nStartSize*nStartSize/4)
					nCW = ROUND(nCWp * 100,0)
				ELSE
					MESSAGEBOX("Cold Work Cannot be 0 to Calculate here.",48,"No Changes")
					RETURN	
				ENDIF
			ELSE
				MESSAGEBOX("Cold Work Cannot be 0 to Calculate here.",48,"No Changes")
				RETURN
			ENDIF
		ENDIF
			
		PRIVATE nStartSizeOrig
		IF nStartSize > 0
			IF nRoughSize > 0
				IF nCW = 0
					*Calc CW from SS and RS
					nCWp = ((3.14156*nStartSize*nStartSize/4)-(3.14156*nRoughSize*nRoughSize/4))/(3.14156*nStartSize*nStartSize/4)
					nCW = ROUND(nCWp * 100,0)
					ThisForm.txtCW.Value = PrepareSQLnum(nCW,'CW',2,0)
				ELSE
					IF nCWorig = nCW
						MESSAGEBOX("Either Start or Rough Size must be 0 to work with ColdWork!",48,"No Changes")
					ELSE
						ThisForm.txtCW.Value = PrepareSQLnum(nCW,'CW',2,0)
					ENDIF
				ENDIF
			ELSE
				*Calc Rough from Start
				IF nStartSize > 0 AND nCW > 0
					nRoughSize = SQRT( (nStartSize*nStartSize)/ nCWp )
					ThisForm.txtRoughSize.Value = PrepareSQLnum(nRoughSize,'RoughSize',8,3)
				ENDIF
			ENDIF
		ELSE
			IF nRoughSize = 0
				MESSAGEBOX("Either Start or Rough size must not be 0 to work with ColdWork!",48,"No Changes")
			ELSE
				*Calc Start from Rough
				IF nRoughSize > 0 AND nCW > 0
					nStartSizeOrig = nStartSize
					nStartSize = SQRT( (nRoughSize*nRoughSize) * nCWp )
					
					IF ((nStartSizeOrig+100)*1.0002 >= (nStartSize+100)) AND ((nStartSizeOrig+100) <= (nStartSize+100)*1.0002)
						*StartSize does not need to be changed from Orig
					ELSE
						WAIT WINDOW "Changing StartSize to "+ALLTRIM(STR(nStartSize,8,3)) NOWAIT
						ThisForm.txtStartSize.Value	= PrepareSQLnum(nStartSize,'StartSize',8,3)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmWorkOrder.lblCWavg.Click
		PRIVATE nCW, nOverSize
		nCW 		= PrepareSQLnum(ThisForm.txtCWavg.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		IF nCW = 0
			MESSAGEBOX("No ColdWork number to use!",0+48,"Cannot continue.")
			RETURN .F.
		ELSE
			ThisForm.txtCW.Value = nCW
		ENDIF
		
		PRIVATE nStartSize,nRoughSize,nOverSize,nsThck,nfThck
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'CW',2,0)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'Thick',9,3)
		nsThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3)
		nfThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',9,3)
		
		DO CASE
		CASE nStartSize = 0 AND nRoughSize = 0
			nRoughSize = nfThck + nOverSize
			ThisForm.txtRoughSize.Value = nRoughSize 
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize = 0
			ThisForm.lblRoughSize.Click
		CASE nStartSize = 0 AND nRoughSize > 0
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize > 0
			ThisForm.txtStartSize.Value = 0
			ThisForm.lblStartDia.Click
		ENDCASE	
	ENDPROC

	PROCEDURE frmWorkOrder.lblCWmax.Click
		PRIVATE nCW, nOverSize
		nCW 		= PrepareSQLnum(ThisForm.txtCWavg.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		IF nCW = 0
			MESSAGEBOX("No ColdWork number to use!",0+48,"Cannot continue.")
			RETURN .F.
		ELSE
			ThisForm.txtCW.Value = nCW
		ENDIF
		
		PRIVATE nStartSize,nRoughSize,nOverSize,nsThck,nfThck
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'CW',2,0)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		nsThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3)
		nfThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',9,3)
		
		DO CASE
		CASE nStartSize = 0 AND nRoughSize = 0
			nRoughSize = nRoughSize + nOverSize
			ThisForm.txtRoughSize.Value = nRoughSize 
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize = 0
			ThisForm.lblRoughSize.Click
		CASE nStartSize = 0 AND nRoughSize > 0
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize > 0
			ThisForm.txtStartSize.Value = 0
			ThisForm.lblStartDia.Click
		ENDCASE	
	ENDPROC

	PROCEDURE frmWorkOrder.lblCWMedian.Click
		PRIVATE nCW, nOverSize
		nCW			= PrepareSQLnum(ThisForm.txtCWmedian.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		IF nCW = 0
			MESSAGEBOX("No ColdWork number to use!",0+48,"Cannot continue.")
			RETURN .F.
		ELSE
			ThisForm.txtCW.Value = nCW
		ENDIF
		
		PRIVATE nStartSize,nRoughSize,nsThck,nfThck
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'CW',2,0)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		nsThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3)
		nfThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',9,3)
		
		DO CASE
		CASE nStartSize = 0 AND nRoughSize = 0
			nRoughSize = nRoughSize + nOverSize
			ThisForm.txtRoughSize.Value = nRoughSize 
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize = 0
			ThisForm.lblRoughSize.Click
		CASE nStartSize = 0 AND nRoughSize > 0
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize > 0
			ThisForm.txtStartSize.Value = 0
			ThisForm.lblStartDia.Click
		ENDCASE	
	ENDPROC

	PROCEDURE frmWorkOrder.lblCWmin.Click
		PRIVATE nCW, nOverSize
		nCW 		= PrepareSQLnum(ThisForm.txtCWmin.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		IF nCW = 0
			MESSAGEBOX("No ColdWork number to use!",0+48,"Cannot continue.")
			RETURN .F.
		ELSE
			ThisForm.txtCW.Value = nCW
		ENDIF
		
		PRIVATE nStartSize,nRoughSize,nOverSize,nsThck,nfThck
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',9,3)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		nsThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3)
		nfThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',9,3)
		
		DO CASE
		CASE nStartSize = 0 AND nRoughSize = 0
			nRoughSize = nRoughSize + nOverSize
			ThisForm.txtRoughSize.Value = nRoughSize 
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize = 0
			ThisForm.lblRoughSize.Click
		CASE nStartSize = 0 AND nRoughSize > 0
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize > 0
			ThisForm.txtStartSize.Value = 0
			
			ThisForm.lblStartDia.Click
		ENDCASE	
	ENDPROC

	PROCEDURE frmWorkOrder.lblDescript.Click
		ThisFormSet.Set_frmWorkOrder_Descript("START")
	ENDPROC

	PROCEDURE frmWorkOrder.lblDueDate.Click
		PRIVATE dDate1,dDate2
		dDate1 = ThisForm.txtDueDate.Value
		
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.txtDueDate.Value = dDate2
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblfAlloy.Click
		*ThisForm.txtfAlloy.Value = ThisForm.txtAlloy.Value
		
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12))
		
		IF LEN(pCurAlloy)>0
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisFormSet.nConnHandle )
			
			IF LEN(cAlloyStandard) > 0
				ThisForm.txtFAlloy.Value = cAlloyStandard
				
				ThisFormSet.Calc_Weight('FINISH',.F.)
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblFDescript.Click
		ThisFormSet.Set_frmWorkOrder_Descript("FINISH")
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblfNotes.Click
		
		PRIVATE cPOitem,cSOitem
		cPOitem = PrepareSQLtxt(ThisForm.txtfPOitem.Value,'POitem',12)
		cSOitem = PrepareSQLtxt(ThisForm.txtfPOitem.Value,'SOitem',10)
		
		IF Proper_PO_item(cPOitem) = Proper_PO_item('') AND Proper_SO_item(cSOitem)  = Proper_SO_item('') 
			RETURN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		
		*First opened in ThisFormSet.Refresh_frmWorkOrder_FPOitem(pfPOitem)
		IF Proper_PO_item(cPOitem) != Proper_PO_item('')
			cSQL = "SELECT Company"
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Order_Qty, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig) AS Descript "
			cSQL = cSQL + ",Received"
			cSQL = cSQL + ",Cond_Spec,Misc_Purch"
			cSQL = cSQL + ",Services,ConvServ,Equipment,Reconciled,Stock "
			cSQL = cSQL + " FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		ENDIF
		
		IF Proper_SO_item(cSOitem) != Proper_SO_item('') 
			cSQL = "SELECT Company "
			cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Q_QTY, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig) AS Descript "
			cSQL = cSQL + " ,cmplt AS Received, [Tol] AS Cond_Spec, Comments AS Misc_Purch, 0 AS [Services] "
			cSQL = cSQL + " , 0 AS ConvServ, 0 AS Equipment, cmplt AS [Reconciled], '' AS Stock "
			cSQL = cSQL + " FROM dbo.AllQuotes AQ "
			cSQL = cSQL + " INNER JOIN dbo.Sales S ON AQ.SOitem = S.SOitem "
			cSQL = cSQL + " WHERE AQ.SOitem = '"+cSOitem+"'"
		ENDIF
		
		IF EMPTY(cSQL)
			RETURN
		ENDIF
		
		IF USED("tmpWO_FPOitem")	
			USE IN tmpWO_FPOitem
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_FPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_FPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_FPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_FPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_FPOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpWO_FPOitem')
			IF RECCOUNT('tmpWO_FPOitem')>0
		
				PRIVATE cfNotes, cFPOMisc_Purch
		
				cfNotes			= PrepareSQLtxt(ThisForm.edtfNotes.Value,'Misc_Purch',-3)
				cFPOMisc_Purch	= PrepareSQLtxt(tmpWO_FPOitem.Misc_Purch,'Misc_Purch',-3)
		
				IF EMPTY(cfNotes)
					ThisForm.edtfNotes.Value = cFPOMisc_Purch
				ELSE
					ThisForm.edtfNotes.Value = cFPOMisc_Purch+CHR(13)+cfNotes
				ENDIF
			ENDIF
			*Do not Close, opened in ThisFormSet.Refresh_frmWorkOrder_FPOitem(pfPOitem)
		ENDIF
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblfPieces.Click
		ThisFormSet.Calc_Piece('FINISH')
	ENDPROC

	PROCEDURE frmWorkOrder.lblFPOCond_Spec.Click
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.txtfPOitem.Value,'POitem',12)
		IF Proper_PO_item(cPOitem) = Proper_PO_item('')
			RETURN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		*First opened in ThisFormSet.Refresh_frmWorkOrder_FPOitem(pfPOitem)
		
