	PROCEDURE newwo_bypoitem		&& New WO by POitem
		PARAMETERS pPOitem
		*ThisFormset.NewWO_byPOitem()
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item(pPOitem)
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			RETURN .F.
		ENDIF
		
		*************************************
		*Count POitem in PurchaseOrder
		PRIVATE lFoundPOiteminPO
		lFoundPOiteminPO = .F.
		
		IF USED("tmpPO_cnt")	
			USE IN tmpPO_cnt
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND Cancelled = 0 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_cnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_cnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_cnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_cnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_cnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPO_cnt')
				IF tmpPO_cnt.Cnt > 0
					lFoundPOiteminPO = .T.
				ENDIF
				USE IN tmpPO_cnt
			ENDIF
		ENDIF
		
		
		IF NOT lFoundPOiteminPO
			MESSAGEBOX("Did not find POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrder table!",16,"Data not found!")
			RETURN .F.
		ENDIF
		
		************************************************
		*Check POitem in WorkOrder, See if they meant to Edit.
		PRIVATE lFoundPOitem, lCreateWO
		lFoundPOitem 	= .F.
		lCreateWO		= .T.
		
		PRIVATE cMess
		cMess = ''
		
		IF USED("tmpWO_POitemCnt")	
			USE IN tmpWO_POitemCnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT WO FROM dbo.WorkOrder "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND ISNULL(Cncld,0) = 0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_POitemCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_POitemCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_POitemCnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_POitemCnt')
				IF RECCOUNT('tmpWO_POitemCnt') > 0
					lFoundPOitem = .T.
					cMess = "Found WO = "+ALLTRIM(STR(PrepareSQLnum(tmpWO_POitemCnt.WO,'WO',-3)))
					IF RECCOUNT('tmpWO_POitemCnt') > 1
						cMess = cMess + " with "+ALLTRIM(STR( RECCOUNT('tmpWO_POitemCnt') ))+" Records."
					ENDIF
				ENDIF
				USE IN tmpWO_POitemCnt
			ENDIF
		ENDIF
		
		IF lFoundPOitem
			*Show WO screen with POitem and Ask if they want to Edit That.
			IF MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was Found in another WO."+CHR(13)+cMess+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+"Answer No to continue with adding"+CHR(13)+"this PO item to this WO.",4+32,"Edit old WO?") = 6
				ThisFormSet.EditbyPOitem(pPOitem)
				*Could be reworked as 'Edit WO byPOitem' since POitem was found in WorkOrder
				RETURN .F.
			ENDIF
		ENDIF
		
		cMess = ''
		**********************************************
		*Check POitem in WorkOrder_Detail, See if they meant to Edit.
		IF USED("tmpWO_POitemCnt")	
			USE IN tmpWO_POitemCnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = " SELECT WO_Detail FROM dbo.WorkOrder_Detail "
		cSQL = cSQL + " WHERE fPOitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND ISNULL(fCncld,0) = 0"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_POitemCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_POitemCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_POitemCnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_POitemCnt')
				IF RECCOUNT('tmpWO_POitemCnt') > 0
					lFoundPOitem = .T.
					cMess = "Found WO_Detail = "+ALLTRIM(STR(PrepareSQLnum(tmpWO_POitemCnt.WO_Detail,'WO_Detail',-3)))
					IF RECCOUNT('tmpWO_POitemCnt') > 1
						cMess = cMess + " with "+ALLTRIM(STR( RECCOUNT('tmpWO_POitemCnt') ))+" Records."
					ENDIF
					
				ENDIF
				USE IN tmpWO_POitemCnt
			ENDIF
		ENDIF
		
		IF lFoundPOitem
			*Show WOD screen with POitem and Ask if they want to Edit That.
			IF MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was used in another WO Detail."+CHR(13)+cMess+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+CHR(13)+"(Y) Yes to edit."+CHR(13)+"(N)No to continue with adding this PO item to a NEW WO."+CHR(13)+CHR(13)+"A different input Size will need a new WO number.",4+32,"Edit old WO?(Y) or create new WO?(N)") = 6
				ThisFormSet.EditbyPOitem(pPOitem)
				*Could be reworked as 'Edit WOD byPOitem' since POitem was found in WorkOrder_Detail
				RETURN .F.
			ENDIF
		ENDIF
		
		*********************************************
		*Get PurchaseOrder Data
		
		IF USED("tmpPO_POitem")	
			USE IN tmpPO_POitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * "
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Pounds, RandLen, Metric,'','','') AS Descript "
		cSQL = cSQL + ",dbo.f_BestDate(dbo.f_BestDate(Due_Min,Due_Max),dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max)) AS DueDate "
		cSQL = cSQL + ",LEFT(Cond_Spec,1000) AS Cond_Spec ,LEFT(Misc_Purch,1000) as Misc_Purch"
		cSQL = cSQL + "	FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_POitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_POitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_POitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_POitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_POitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPO_POitem')
				IF RECCOUNT('tmpPO_POitem') > 0
				
					ThisFormset.frmWorkOrder.txtPieces.Value 	= tmpPO_POitem.Pieces
					ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpPO_POitem.Alloy
					ThisFormset.frmWorkOrder.cmbForm.Value		= tmpPO_POitem.Form
					ThisFormSet.RefreshForms(tmpPO_POitem.Form)
					ThisFormset.frmWorkOrder.cmbCC.Value		= tmpPO_POitem.CC
					ThisFormSet.InitcmbCL()
					ThisFormset.frmWorkOrder.cmbCL.Value		= tmpPO_POitem.CL
					ThisFormset.frmWorkOrder.txtHeat.Value		= ''
					
					ThisFormset.frmWorkOrder.txtThck.Value		= tmpPO_POitem.Thck
					ThisFormset.frmWorkOrder.txtSz2.Value		= tmpPO_POitem.Sz2
					ThisFormset.frmWorkOrder.txtSz3.Value		= tmpPO_POitem.Sz3
					ThisFormSet.frmWorkOrder.chkPinSWeight.Value	= 0
					ThisFormset.frmWorkOrder.txtWeight.Value 	= tmpPO_POitem.Order_Qty
					*
					ThisFormSet.frmWorkOrder.txtStartDate.Value	= DATE()
					*ThisFormSet.frmWorkOrder.chkIntP.Value		= PrepareSQLlogic(0,'IntP')
					ThisFormSet.frmWorkOrder.chkRE.Value		= PrepareSQLlogic(0,'RE')
					ThisFormset.frmWorkOrder.txtDescript.Value 	= tmpPO_POitem.Descript
					ThisFormset.frmWorkOrder.edtWO_Notes.Value 	= tmpPO_POitem.Cond_Spec
								
					ThisFormSet.frmWorkOrder.txtDueDate.Value	= PrepareSQLDate(tmpPO_POitem.DueDate,'DueDate')
					ThisFormSet.frmWorkOrder.txtSalesRep.Value	= AppSetup_Get_SalesRep_SalesP(tmpPO_POitem.SalesP)
					*
					ThisFormset.frmWorkOrder.txtFPieces.Value 	= tmpPO_POitem.Pieces
					ThisFormset.frmWorkOrder.txtFAlloy.Value	= tmpPO_POitem.Alloy
					ThisFormset.frmWorkOrder.cmbFForm.Value		= tmpPO_POitem.Form
					ThisFormSet.RefreshFForms(tmpPO_POitem.Form)
					ThisFormset.frmWorkOrder.cmbFcc.Value		= tmpPO_POitem.CC
					ThisFormSet.InitcmbFCL()
		
					ThisFormset.frmWorkOrder.cmbFCL.Value		= tmpPO_POitem.CL
					ThisFormset.frmWorkOrder.txtFThck.Value		= tmpPO_POitem.Thck
					ThisFormset.frmWorkOrder.txtFSz2.Value		= tmpPO_POitem.Sz2
					ThisFormset.frmWorkOrder.txtFSz3.Value		= tmpPO_POitem.Sz3
					ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= 0
					
					ThisFormSet.Calc_Weight('Finish',.T.)	&&PO may have wrong weight
					PRIVATE nfWeight
					nfWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtfWeight.Value,'fWeight',9,1)
					IF nfWeight = 0
						ThisFormset.frmWorkOrder.txtfWeight.Value 	= tmpPO_POitem.Order_Qty
					ENDIF
					
					ThisFormset.frmWorkOrder.txtFSpec.Value 	= ''
					ThisFormset.frmWorkOrder.txtFDescript.Value = tmpPO_POitem.Descript
					ThisFormset.frmWorkOrder.txtfCondLevel.Value = ConditionLevelText(tmpPO_POitem.CC,tmpPO_POitem.CL)
					
					ThisFormset.frmWorkOrder.cmbFollowM.Value	= ''
					ThisFormset.frmWorkOrder.txtFollowLot.Value	= 0
					ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
					ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
		
					ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(0,'StartSize',8,3)
					ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(0,'CW',-1)
					ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(0,'RoughSize',8,3)
					ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
					
					ThisFormset.frmWorkOrder.edtfNotes.Value = ALLTRIM(tmpPO_POitem.Cond_Spec)+CHR(13)+ALLTRIM(tmpPO_POitem.Misc_Purch)
					ThisFormSet.frmWorkOrder.txtFPOCompany.Value  = tmpPO_POitem.Company
					ThisFormSet.frmWorkOrder.txtFPODescript.Value = tmpPO_POitem.Descript
					ThisFormSet.frmWorkOrder.txtFPOReceived.Value = TTOC( PrepareSQLdate(tmpPO_POitem.Received,'Received'))
					ThisFormSet.frmWorkOrder.edtFPOCond_Spec.Value = tmpPO_POitem.Cond_Spec
					ThisFormSet.frmWorkOrder.edtFPOMisc_Purch.Value = tmpPO_POitem.Misc_Purch
					ThisFormset.frmWorkOrder.edtfNotes.Value = tmpPO_POitem.Misc_Purch
					
					ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
					ThisFormSet.nStock_Projected_ID = 0
					ThisFormSet.Refresh_Projected()
					
					ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0 &&PrepareSQLnum(tmpWO.AC_ID_WO,'AC_ID',-3)
					ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= 0 &&PrepareSQLnum(tmpWO.AC_ID_WOD,'AC_ID',-3)
					
					IF ThisFormSet.cWhat2 = "START"
						ThisFormSet.frmWorkOrder.txtPOitem.Value	= cPOitem
						ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpPO_POitem.SOitem,'SOitem',10)
						*ThisFormset.Refresh_frmWorkOrder_POitem(cPOitem)
					ENDIF
					IF ThisFormSet.cWhat2 = "FINISH"
						ThisFormSet.frmWorkOrder.txtFPOitem.Value	= cPOitem
						ThisFormSet.frmWorkOrder.txtFSOitem.Value	= PrepareSQLtxt(tmpPO_POitem.SOitem,'SOitem',10)
						ThisFormSet.Refresh_frmWorkOrder_FPOitem(cPOitem)
					ENDIF
					
					**********************************************
					
					*IF ThisFormset.frmWorkOrder.txtWO.Value = 0
					ThisFormset.frmWorkOrder.txtWO.Value = GetNextWorkOrder(ThisFormSet.nConnhandle)
					ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
					
					ThisFormSet.frmWorkOrder.txtWO_Detail.Value = GetNextWorkOrder_Detail(ThisFormSet.nConnHandle)		
					ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .F. &&Do not show untill save!
					
					**********************************************
					*ThisFormSet.AddBySOitemSS(pSOitem, pWhatEver)
					
					**********************************************
									
					ThisFormSet.Set_frmWorkOrder('ENABLE')
					ThisFormSet.SetVfrmWorkOrder(.T.)
					
					**********************************************
					
					PRIVATE cMess
					cMess = "The PO was found and the WO screen has this data."
					IF ThisFormSet.cWhat2 == ""
						cMess = cMess + CHR(13)+"The program assumes the PO would create the Start sizes of this WO."
						cMess = cMess + CHR(13)+"The start sizes have also been filled, but need to be changed"
						cMess = cMess + CHR(13)+"if this is a Size Conversion PO."
					ELSE
						IF ThisFormSet.cWhat2 = "START"
							cMess = cMess + CHR(13)+"The Start and Finish sizes have also been filled!"
						ENDIF
						IF ThisFormSet.cWhat2 = "FINISH"
							cMess = cMess + CHR(13)+"The Finish and Start sizes have also been filled!"
						ENDIF
					ENDIF
					*cMess = cMess + CHR(13)+CHR(13)+"WO_Detail will be 0 till you save."
					MESSAGEBOX(cMess,0+64,"WO is ready to Edit and Save.")
					
				ENDIF
				USE IN tmpPO_POitem
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE newwo_byprojstk
		*ThisFormSet.NewWO_ByProjStk()
		
		*ThisFormset.frmWorkOrder.lstWO_Detail.Clear
		ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .F.
		ThisFormSet.InitWO_Start()			&&Clears Data
		ThisFormSet.InitWO_Detail_Start()	&&Clears WO_Detail Data
		ThisFormSet.frmWorkOrder.txtWO_Detail.Value = GetNextWorkOrder_Detail(ThisFormSet.nConnHandle)
		
		
		IF USED('tmpWO')
			USE IN tmpWO
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC 
		*make blank table
		cSQL = "SELECT * "
		cSQL = cSQL + ",ISNULL(ACWO.AC_ID,0) AS AC_ID_WO "
		cSQL = cSQL + " FROM dbo.WorkOrder WO WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WorkOrder_Detail WITH(NOLOCK) ON WO.WO = WorkOrder_Detail.WO"
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WO ACWO ON WO.WO = ACWO.WO "
		cSQL = cSQL + " WHERE 0>0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO')
				PRIVATE cAlloy, nThck, nOverSize, nFinishThck, nSNomThck, nInches
				PRIVATE nCW, cForm, nStartThck, nFinishThck, nWeight
				cAlloy		= PrepareSQLtxt(ThisFormSet.frmStock_Projected.txtAlloy.Value,'Alloy',12)
											*ThisFormset.frmStock_Projected.txtAlloy
				nThck		= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtThck.Value,'Thck',9,3) 
				nOverSize	= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtOverSize.Value,'OverSize',5,3)
				nFinishThck	= nThck + nOverSize
				nSNomThck	= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtSNomThck.Value,'SNomThck',9,3)
				nInches		= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtYearInches.Value,'Sz2',9,3)
				
				nCW			= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtCW.Value,'CW',-3)
				cForm		= PrepareSQLtxt(ThisFormSet.frmStock_Projected.cmbForm.Value,'From',2)
				nStartThck	= getStartThck_RA( nFinishThck, nCW, cForm )
				nWeight		= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtLBS_Need.Value,'LBS_Need',-3)*1.1
		
				PRIVATE cCC,cCL
				cCC	= '1'
				cCL	= ' '
				*cCC	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFcc.Value,'CC',1)
				*cCL	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCL.Value,'CL',1)
			
				ThisFormset.frmWorkOrder.txtPieces.Value	= 1
				ThisFormset.frmWorkOrder.txtAlloy.Value		= cAlloy
				ThisFormset.frmWorkOrder.cmbForm.Value		= cForm
				ThisFormSet.RefreshForms(cForm)
				ThisFormset.frmWorkOrder.cmbCC.Value		= cCC &&PrepareSQLtxt(ThisFormSet.frmStock_Projected.txtSpec_CC.Value,'CC',1)
				ThisFormSet.InitcmbCL()
				ThisFormset.frmWorkOrder.cmbCL.Value		= cCL &&PrepareSQLtxt(ThisFormSet.frmStock_Projected.txtSpec_CL.Value,'CL',1)
				ThisFormset.frmWorkOrder.txtHeat.Value		= ''
				
				ThisFormset.frmWorkOrder.txtThck.Value		= IIF(nSNomThck = 0, nStartThck, nSNomThck )
				ThisFormset.frmWorkOrder.txtSz2.Value		= 0
				ThisFormset.frmWorkOrder.txtSz3.Value		= 0
				ThisFormSet.frmWorkOrder.chkPinSWeight.Value	= 0
				ThisFormset.frmWorkOrder.txtWeight.Value	= nWeight
				
				ThisFormset.frmWorkOrder.txtStartDate.Value	= DATE()
				ThisFormset.frmWorkOrder.txtDueDate.Value	= DATE()+31
				*ThisFormSet.frmWorkOrder.chkIntP.Value		= 1
				ThisFormSet.frmWorkOrder.chkRE.Value		= 0
				*ThisFormset.frmWorkOrder.txtDescript.Value	= 
				*ThisFormSet.Calc_Weight("START",.T.)
				ThisFormSet.Set_frmWorkOrder_Descript("START")
				
				ThisFormset.frmWorkOrder.edtWO_Notes.Value	= ''
				
				ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0
				
				ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt('','SOitem',10)
				ThisFormSet.frmWorkOrder.txtPOitem.Value	= PrepareSQLtxt('','POitem',12)
				ThisFormset.frmWorkOrder.txtSalesRep.Value	= 'Production Order'
				*
				*FINISH
				ThisFormset.frmWorkOrder.txtFPieces.Value	= 1
				ThisFormset.frmWorkOrder.txtFAlloy.Value	= cAlloy
				ThisFormset.frmWorkOrder.cmbFForm.Value		= cForm
				ThisFormSet.RefreshFForms(cForm)
				
				ThisFormset.frmWorkOrder.cmbFcc.Value		= PrepareSQLtxt(ThisFormSet.frmStock_Projected.txtSpec_CC.Value,'CC',1)
				ThisFormSet.InitcmbFCL()
		
				ThisFormset.frmWorkOrder.cmbFCL.Value		= PrepareSQLtxt(ThisFormSet.frmStock_Projected.txtSpec_CL.Value,'CL',1)
				ThisFormset.frmWorkOrder.txtFThck.Value		= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtThck.Value,'Thck',9,3)
				ThisFormset.frmWorkOrder.txtFSz2.Value		= nInches + 24
				ThisFormset.frmWorkOrder.txtFSz3.Value		= 0
				ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= 0
				ThisFormset.frmWorkOrder.txtFWeight.Value 	= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtLBS_Need.Value,'LBS_Need',-3)
				ThisFormSet.Calc_Length('START')
				ThisFormSet.Calc_Length('FINISH')
				ThisFormset.frmWorkOrder.txtFSpec.Value		= PrepareSQLtxt(ThisFormSet.frmStock_Projected.txtFSpec.Value,'FSpec',50)
				
				ThisFormset.frmWorkOrder.txtFDescript.Value	= ""
				*ThisFormset.frmWorkOrder.txtFDescript.Value	= "CW "+ALLTRIM(STR(PrepareSQLnum(ThisFormSet.frmStock_Projected.txtCW.Value,'CW',-3)))+"%"
				ThisFormSet.Set_frmWorkOrder_Descript("FINISH")
				
				ThisFormset.frmWorkOrder.cmbFollowM.Value	= PrepareSQLtxt(ThisFormSet.frmStock_Projected.txtFollowM.Value,'FollowM',20)
				ThisFormset.frmWorkOrder.txtFollowLot.Value	= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtFollowLot.Value,'FollowLot',-3)
				ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
				ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
		
				*ThisFormSet.frmWorkOrder.txtfCondLevel.Value = PrepareSQLtxt('','fCondLevel',30)
				ThisFormset.frmWorkOrder.txtfCondLevel.Value= ConditionLevelText(cCC,cCL)
				*ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(0,'StartSize',8,3)
				ThisformSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(ThisFormSet.frmStock_Projected.txtSThck.Value,'StartSize',9,3)
				ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(nCW  ,'CW',-1)
				*ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(0,'RoughSize',8,3)
				ThisformSet.frmWorkOrder.txtRoughSize.Value	= nThck + nOverSize
				ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(nOverSize,'OverSize',5,3)
		
				ThisFormset.frmWorkOrder.edtfNotes.Value	= ''
				ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = PrepareSQLnum(ThisFormSet.frmStock_Projected.txtID.Value,'Stock_Projected_ID',-3)
				ThisFormSet.nStock_Projected_ID = ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value
				ThisFormSet.Refresh_Projected()
				
				*ThisFormSet.Refresh_frmWorkOrder_POitem("")
				ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
			
				ThisFormSet.frmWorkOrder.txtFID_Detail.Value	= 0
				ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(240,240,240)
				
				ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value = 0
				ThisFormSet.frmWorkOrder.txtfTBL.Value 			= ''
				ThisFormSet.frmWorkOrder.txtfReceivingID.Value	= 0
				
				ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= 0 &&PrepareSQLnum(tmpWO.AC_ID_WOD,'AC_ID',-3)
				ThisFormSet.frmWorkOrder.txtFSOitem.Value	= PrepareSQLtxt('','SOitem',10)
				ThisFormSet.frmWorkOrder.txtFPOitem.Value	= PrepareSQLtxt('','POitem',12)
				ThisFormSet.Refresh_frmWorkOrder_FPOitem('')
				*ThisFormSet.Refresh_FPOitem()
				
				ThisFormset.frmWorkOrder.txtFDueDate.Value	= DATE()+31
				ThisFormSet.frmWorkOrder.cmbNextCode.Value	= ''
				ThisFormSet.frmWorkOrder.txtNextNumber.Value = ''
					
				ThisFormset.frmWorkOrder.chkfCmplt.Value	= 0
				ThisFormset.frmWorkOrder.chkfCncld.Value	= 0
				ThisFormset.frmWorkOrder.chkStkListed.Value	= 0
				
				ThisformSet.nWO						 	= GetNextWorkOrder(ThisFormSet.nConnhandle)
				ThisFormset.frmWorkOrder.txtWO.Value	= ThisformSet.nWO
				
				*ThisFormset.frmWorkOrder.txtWO_Detail.Value = 0
				ThisFormSet.frmWorkOrder.txtWO_Detail.Value = GetNextWorkOrder_Detail(ThisFormSet.nConnHandle)
				
				*ThisFormset.frmWorkOrder.txtWO.Enabled = .F.
				
		*		Redundant		
		*		IF ThisFormSet.CheckFinish_ID_Detail()
		*		ENDIF
		*		IF ThisFormSet.CheckFinish_ID_Detail_Process()
		*		ENDIF
				
				ThisFormSet.Set_frmWorkOrder('ENABLE')
		
				USE IN tmpWO
			ENDIF
		ENDIF
	ENDPROC

