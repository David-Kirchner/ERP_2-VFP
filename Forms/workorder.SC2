	PROCEDURE showgfmlog		&& *
		PARAMETERS nLot
		*ThisFormSet.ShowGFMlog()
		
		
		IF VARTYPE(nLot) = "N"
			IF nLot > 0
				DO FORM Forms\GFMlog WITH nLot
				*Tried as MDI form on 10-06-21
				
				
		*!*			ThisFormSet.frmGFMlog.Visible = .T.
		*!*			ThisFormSet.frmGFMlog.Top	= ThisFormSet.frmWorkOrder.Top
		*!*			ThisFormSet.frmGFMlog.Left	= ThisFormSet.frmWorkOrder.Left +ThisFormSet.frmWorkOrder.Width +10
		
		*!*			ThisFormSet.frmGFMlog.spnSpnlot.Value = nLot
		*!*			ThisFormSet.frmGFMlog.spnSpnlot.Valid
		*!*			
		*!*			ThisFormSet.frmGFMlog.AlwaysOnTop = .T.
		*!*			ThisFormSet.frmGFMLog.cmdPrint.SetFocus
				
			ELSE
				MESSAGEBOX("No Lot Number.",0+48,"Cannot Show LOG!")
			ENDIF
		ELSE
			MESSAGEBOX("No Lot Number.",0+48,"Cannot Show LOG")
		ENDIF
		
		WAIT WINDOW "GFM Log window is Ready" NoWAIT
		
	ENDPROC

	PROCEDURE showposcreen
		*ThisFormSet.ShowPOscreen()
		ThisFormSet.frmPO.Visible = .T.
		
		
		
		RETURN
		
		*This is From Edit_Sales_Order
		
		
		*ThisFormSet.frmPO.Left	= ThisFormSet.frmEO.Left+6
		*ThisFormSet.frmPO.Top	= ThisFormSet.frmEO.Top + 60
		
		*ThisFormSet.frmEoP.Visible = .T.
		*ThisFormSet.frmEoP.Left = ThisFormSet.frmEO.Left + ThisFormSet.frmEO.Width
		*ThisFormSet.frmEoP.Top = ThisFormSet.frmEO.Top
		
		*ThisFormSet.frmPO.pgfPO.Left = 1
		
		ThisFormSet.frmPO.PO_NewAdd = .F.
		ThisFormSet.frmPO.PO_NewClone = .F.
		ThisFormSet.frmPO.POEditing = .F.
		
		*
		***ThisFormSet.ShowPO
		
		
		ThisFormSet.frmPO.ItemNumber = 0 &&ThisFormSet.ItemNumber
		ThisFormSet.frmPO.Salesnum 	 = 0 && ThisFormSet.SalesNum
		ThisFormSet.frmPO.txtItem.Value = 0 && ThisFormSet.ItemNumber
		
		ThisFormset.frmPO.pgfPO.pgPODesc.txtSalesnum.Value = 0 &&  ThisFormSet.SalesNum
		ThisFormset.frmPO.pgfPO.pgPODesc.txtItem.Value = 0 && ThisFormSet.ItemNumber
		
		
		ThisFormSet.frmPO.QuotesID	= 0 && SalesQuote.ID
		ThisFormSet.frmPO.cSOitem	= 0 && SalesQuote.SoItem_A
		
		ThisFormSet.frmPO.Descript	= SalesQuote.Descript
		ThisFormSet.frmPO.Comments 	= SalesQuote.Comments
		
		ThisFormSet.frmPO.lblItem.Visible = .T.
		ThisFormSet.frmPO.cmdPoPrev.Visible = .T.
		ThisFormSet.frmPO.txtItem.Visible = .T.
		ThisFormSet.frmPO.txtItem.Value = SalesQuote.item_a
		ThisFormSet.frmPO.cmdPoNext.Visible = .T.
		ThisFormSet.frmPO.lblOf.Visible = .T.
		ThisFormSet.frmPO.txtItemTot.Value = SalesQuote.itemTot
		ThisFormSet.frmPO.txtItemtot.Visible = .T.
		ThisFormSet.frmPO.pgfPO.pgPODesc.txtSalesNum.Enabled = .F.
		ThisFormSet.frmPO.pgfPO.pgPODesc.txtSalesNum.Value = ThisFormSet.SalesNum
		ThisFormSet.frmPO.pgfPO.pgPODesc.txtItem.Enabled = .F.
		ThisFormSet.frmPO.pgfPO.pgPODesc.txtItem.Value = SalesQuote.item_a
		ThisFormSet.frmPO.pgfPO.pgPODesc.lblItem.Enabled = .F.
		ThisFormSet.frmPO.pgfPO.pgPODesc.lblSalesNum.Enabled = .F.
		
		
		*set lstPoItems with gaPoItems
		*ThisFormSet.frmPO.SetPOitems(SalesQuote.SoItem_A, .F.)------Done in Show_frmPO
		*Set cPOitem
		PRIVATE cSQL, nSQLEXEC
		IF Proper_PO_item(ThisFormSet.frmPO.cPOitem) = Proper_PO_item("")
			**INIT first POitem
			IF USED('tmpPoItemDetail')
				USE IN tmpPoItemDetail
			ENDIF
			SELECT 0
			PRIVATE nItem
			nItem	= PrepareSQLnum(SalesQuote.Item_A,'Item',2,0)
			
			cSQL = "SELECT TOP 1 PoItem FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+SalesQuote.SoItem_A+"')"
			cSQL = cSQL + " OR ( SalesNum = "+STR(SalesQuote.SalesNum_A)
			cSQL = cSQL + " AND Item="+ALLTRIM(STR(nItem))
			cSQL = cSQL +")"
			cSQL = cSQL + " ORDER BY PoItem DESC " 
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPoItemDetail')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPoItemDetail' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPoItemDetail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPoItemDetail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPoItemDetail' )
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		
			IF USED('tmpPoItemDetail')
				IF RECCOUNT('tmpPoItemDetail') > 0
					SELECT tmpPoItemDetail
					ThisFormSet.frmPO.cPOitem = tmpPoItemDetail.POitem
					ThisFormSet.POitem = tmpPoItemDetail.POitem
					
				ENDIF
				USE IN tmpPoItemDetail
			ENDIF
		ENDIF
		
		
		ThisFormSet.pgRefresh()
	ENDPROC

