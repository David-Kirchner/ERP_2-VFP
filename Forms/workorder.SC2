	PROCEDURE frmStock_Projected.cmdNewWO.Click
		ThisFormSet.frmWorkOrder.Left = 300
		ThisFormset.frmSTK_Detail.Visible = .F.
		IF This.Caption = "Create New WO"
			ThisFormSet.SetVfrmWorkOrder(.T.)
			ThisFormSet.pWhat = "START"
		
			ThisFormSet.NewWO_ByProjStk()	&&reads ThisFormset.frmWorkOrder.txt values
		ELSE
			*"Select for WO"
			PRIVATE nStock_Projected_ID
			nStock_Projected_ID = PrepareSQLnum(ThisForm.txtID.Value,'Stock_Projected_ID',-3)
			*ThisFormSet.nStock_Projected_ID = nStock_Projected_ID
			ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = nStock_Projected_ID 
			ThisFormSet.Refresh_Projected()
			
			IF ThisFormSet.nStock_Projected_ID = 0 AND nStock_Projected_ID > 0
				*Have new nStock_Projected_ID 
				ThisFormSet.UpdateWODetail_Proj() &&Stock_Projected_ID 
			ENDIF
			ThisFormSet.SetVfrmWorkOrder(.T.)
			
			This.Caption = "Create New WO"
		ENDIF
		
		ThisForm.Visible = .F.
	ENDPROC

	PROCEDURE frmStock_Projected.cmdQuit.Click
		ThisForm.Visible = .F.
		ThisFormSet.frmChooseWO.Visible = .T.
	ENDPROC

	PROCEDURE frmStock_Projected.cmdRA.Click
		ThisFormSet.frmRedArea.Visible = .T.
		*frmRA_Calc
		ThisFormSet.frmRedArea.Top = ThisFormSet.frmWorkOrder.Top
		*ThisFormSet.frmRedArea.Left = ThisForm.Left + ThisForm.Width 
		ThisFormSet.frmRedArea.Left = ThisFormSet.frmWorkOrder.shpDivide.Left
		
		PRIVATE nThck, nSz2, nFthck, nFSz2
		nThck		= PrepareSQLnum(ThisForm.txtSThck.Value,'Thck',14,4)
		nSz2		= 0 &&PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',13,3)
		
		nFthck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',14,4)
		nFSz2		= 0 &&PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz2.Value,'Sz2',13,3)
		
		PRIVATE nStartSize, nCW, nRoughSize, nOverSize
		nStartSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCWavg.Value,'CW',-1)/100
		nRoughSize	= 0 &&PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= 0 &&PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		
		IF nThck> 0
			ThisFormSet.frmRedArea.txtD123.Value = nThck
		ENDIF
		IF nSz2 > 0
			ThisFormSet.frmRedArea.txtL124.Value = nSz2
		ENDIF
		IF nFthck > 0
			ThisFormSet.frmRedArea.txtD225.Value = nFthck 
		ENDIF
		IF nFSz2 > 0
			ThisFormSet.frmRedArea.txtL226.Value = nFSz2 
		ENDIF
		
		IF nStartSize>0 AND ( nCW>0 OR nRoughSize>0 )
			ThisFormSet.frmRedArea.txtD123.Value = nStartSize
			IF nRoughSize > 0
				ThisFormSet.frmRedArea.txtD225.Value = nRoughSize 
			ENDIF	
			IF nCW > 0
				ThisFormSet.frmRedArea.txtRA36.Value = nCW
			ENDIF
		ENDIF
		
		ThisFormSet.frmRedArea.txtD123.SetFocus()
	ENDPROC

	PROCEDURE frmStock_Projected.lblFollowM.Click
		ThisFormSet.frmGFMlog.Visible = .T.
		ThisFormSet.frmGFMlog.Top	= ThisFormSet.frmWorkOrder.Top
