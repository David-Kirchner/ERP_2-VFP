	PROCEDURE set_frmworkorder		&& Enable or Disable the WorkOrder form
		PARAMETERS cWhat
		*ThisFormSet.Set_frmWorkOrder('ENABLE')
		IF VARTYPE(cWhat) != "C"
			cWhat = ""
			TrackError("ThisFormSet.Set_frmWorkOrder('What') did not get Parameter cWhat","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		cWhat = UPPER(cWhat)
		
		PRIVATE lCmplt, lCncld
		lCmplt		= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkCmplt.Value,'Cmplt')
		lCncld		= PrepareSQLlogic(ThisFormset.frmWorkOrder.chkCncld.Value,'Cncld')
		PRIVATE lComplete, lCancelled
