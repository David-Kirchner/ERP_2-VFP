	ENDPROC

	PROCEDURE frmWorkOrder.lblChooseF_POitem.Click
		PRIVATE nHPAPO, cFPOitem, nWOD
		cFPOitem = PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		nHPAPO = VAL(cFPOitem)
		nWOD = ThisForm.txtWO_DETAIL.Value
		
		PRIVATE nMess
		nMess = 0
		
		IF nHPAPO > 0
			nMess = MESSAGEBOX("A PO is listed here. '"+cFPOitem+"'"+CHR(13)+"Do you want to keep this PO number?"+CHR(13)+"Answer Y to Continue."+CHR(13)+"Answer N to clear the PO Number.",4+32,"Continue with PO?")
			IF nMess = 7
				*Yes, Clear POitem field
				ThisForm.txtFPOitem.Value = ''
				
				ThisFormSet.Remove_POitem(cFPOitem,'WOD')
				
				MESSAGEBOX("The PO item '"+cFPoItem +"' has been removed from the Work Order Detail."+CHR(13)+"This edit needs to be saved.",0+48,"Removed POitem.")
				RETURN
			ENDIF
		ENDIF
		
		IF nHPAPO = 0
			nMess = MESSAGEBOX("Are you trying to connect with a Conversiion or Service PO?"+CHR(13)+"Answer Y to Select an EXISITING POitem.",4+32,"Select a PO used.")
			*IF nMess = 7
			*	MESSAGEBOX("Please Create a PO from the HPA App Menu."+CHR(13)+"Sales\Purchase Order",0+48,"Not Programmed here.")
			*	RETURN
			*ENDIF
		
			IF nMess = 6
				*Select POitem
				DO FORM Forms\SelectPO_item WITH nWOD,"WOD" TO cFPOitem
		
				IF Proper_PO_item(cFPOitem) != Proper_PO_item('')
					ThisForm.txtFPOitem.Value = PrepareSQLtxt(cFPOitem,'POitem',12)
					
					WAIT WINDOW "Need to Save with WO" NOWAIT
				ELSE
					ThisForm.txtFPOitem.Value = ''		
					WAIT WINDOW "This edit needs to be saved this WO_Detail." NOWAIT	
					RETURN
				ENDIF
			ENDIF
		ENDIF
		
		***********
		
		PRIVATE nWO_Detail, lRE
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		*lIntP = PrepareSQLlogic(ThisForm.chkIntP.Value,'IntP')
		*lRE = PrepareSQLlogic(ThisForm.chkRE.Value,'RE')
		PRIVATE cAlloy
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		
		*read again
		cFPOitem = PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		PRIVATE lKeepWOD
		lKeepWOD = .T.
		
		IF Proper_PO_item(cFPOitem) != Proper_PO_item('')
			IF LEN(cAlloy) = 0
				*No alloy to compare
			ELSE
				**Print Error if different Alloys
				PRIVATE cAlloyPO, cDispAlloy 
				cAlloyPO = ''
				cDispAlloy = ''
				
				IF USED('tmpPOAlloy')
					USE IN tmpPOAlloy
				ENDIF
				
				cSQL = "SELECT Alloy, DispAlloy FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cFPOitem+"')"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOAlloy')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOAlloy")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOAlloy")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOAlloy')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF	
				
				IF USED('tmpPOAlloy')
					IF RECCOUNT('tmpPOAlloy') > 0
						cAlloyPO = PrepareSQLtxt(tmpPOAlloy.Alloy,'Alloy',12)
						cDispAlloy = PrepareSQLtxt(tmpPOAlloy.DispAlloy,'DispAlloy',20)
						
						IF cAlloy != cAlloyPO
							IF cAlloy != cDispAlloy
								*Warn
								nMess =	MESSAGEBOX("Are you sure this POitem is right for this WO?"+CHR(13)+"The WO Alloy = '"+cAlloy+"'"+CHR(13)+"The PO Alloy = '"+cAlloyPO+"'"+CHR(13)+"The PO Display Alloy = '"+cDispAlloy+"'",4+32,"Continue with this PO item?")
								IF nMess != 6
									USE IN tmpPOAlloy
									RETURN
								ELSE
									RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Answered Yes when asked."+CHR(13)+"Are you sure this POitem is right for this WO?"+CHR(13)+"The WO Alloy = '"+cAlloy+"'"+CHR(13)+"The PO Alloy = '"+cAlloyPO+"'"+CHR(13)+"The PO Display Alloy = '"+cDispAlloy+"'")
								ENDIF	
							ENDIF
						ENDIF
						
					ENDIF
					USE IN tmpPOAlloy
				ENDIF
			ENDIF
			
			*************************
			
			nMess = MESSAGEBOX("This is your chance to fill in the WO_Detail."+CHR(13)+"Do you want this PO to REPLACE Alloy, Form, Dims...?",4+32+256,"Overwrite WO Detail with PO info?") 
			IF nMess = 6
				PRIVATE lKeepWO
				lKeepWO = .T.
				ThisFormSet.cWhat2 = "FINISH"
				IF ThisFormSet.AddWOD_POitem(cFPOitem, lKeepWO)
				
					IF ThisFormSet.CheckFinish_ID_Detail()
					ENDIF
					
					IF ThisFormSet.CheckFinish_ID_Detail_Process()
					ENDIF
		
					ThisFormSet.Set_frmWorkOrder('ENABLE')  &&Does Start and Finish
					
				ENDIF
				
				*have PO, pull in Data
				ThisFormSet.frmWorkOrder.txtFPOitem.Value = cFPOitem
				ThisFormSet.frmWorkOrder.txtFPOitem.Refresh
				
				*******************************
				IF nWO_Detail > 0
					*Update PO with WO_Detail
					cSQL = "UPDATE dbo.PurchaseOrder SET WO_Detail="+STR(nWO_Detail)
					cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cFPOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF	
					
					*******************************
					
					*UPDATE WorkOrder
					cSQLu = "UPDATE dbo.WorkOrder_Detail SET"
				*	cSQLu = cSQLu + ",SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
					cSQLu = cSQLu + " fPOitem = dbo.f_ProperPOitem('"+cFPOitem+"')"
					cSQLu = cSQLu + " WHERE WO_Detail= "+STR(nWO_Detail)
					 
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
					ENDIF
				ENDIF
			ELSE
				MESSAGEBOX("Please Save this WorkOrder_Detail",0,"Need to save")
				*nMess = MESSAGEBOX("Do you want to Edit this POitem?",4+32,"View/Edit PO info?") 
				*IF nMess = 6
				*	PRIVATE nPOnum
				*	nPOnum = VAL(cFPOitem)
				*	
				*	*DO FORM Forms\PurchaseOrder_Modal WITH nPOnum, "EDIT"
				*	DO FORM Forms\PurchaseOrder_Modal WITH nPOnum, "SHOW"
				*	*Modal waits for the form Release before continue ing
				*	
				*ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblChooseF_SOitem.Click
		*!*	PRIVATE nSalesNum, cSOItem
		*!*	cSOItem = PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		*!*	nSalesNum = VAL(cSoItem)
		
		
		*!*	PRIVATE lSelectedTheOnlySOitem, lRemoveSO
		*!*	lSelectedTheOnlySOitem = .F.
		*!*	lRemoveSO = .F.
		
		*!*	IF nSalesNum > 0
		*!*		nMess = MESSAGEBOX("A SO is listed here. '"+cSOItem +"'"+CHR(13)+"Do you want to keep this SO number?"+CHR(13)+"Answer Y to Continue."+CHR(13)+"Answer N to clear the SO Number.",4+32,"Continue with SO?")
		*!*		IF nMess = 7
		*!*			*Yes, Clear POitem field
