	PROCEDURE frmStock_Produced.cmdDeleteDetail.Click
		PRIVATE nID,nID_Detail,cTBL, nWO_Detail
		nID			= PrepareSQLnum(ThisFormSet.frmStock_Produced.txtID.Value,'ID',-3)
		nID_Detail	= PrepareSQLnum(ThisFormSet.frmStock_Produced.txtID_Detail.Value,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.frmStock_Produced.txtTBL.Value,'TBL',1)
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmStock_Produced.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF nID*nID_Detail=0
			MESSAGEBOX("Lost ID or ID_Detail "+CHR(13)+"Cannot Delete this.",0,"Cannot Continue")
		ENDIF
		
		PRIVATE pFrom, pWhy
		pFrom	= "WOD Del ID_Detail"
		pWhy 	= "WOD Delete"
		
		IF MESSAGEBOX("Are you sure you want to DELETE this?",4,"Delete")=6
			IF Count_Lst_Detail_by_ID_Detail(cTBL,nID_Detail,ThisFormSet.nConnHandle) = 1
		
				IF ID_Detail_Exists(nID_Detail, cTBL, ThisFormSet.nConnHandle, "WO_Detail", nWO_Detail)
				
					IF Remove_Lst_Detail_by_ID_Detail(cTBL,nID_Detail,ThisFormSet.nConnHandle,pFrom, pWhy)
		
						*MESSAGEBOX("Changes made to Stock have not been updated here",0,"Refresh")
						ThisForm.Visible = .F.
						
						*Save to WorkOrder_Detail
						ThisFormSet.frmWorkOrder.txtfTBL.Value = ""
						ThisFormSet.frmWorkOrder.chkStkListed.Value = 0
						
						*UPDATE dbo.WorkOrder_Detail
						cUpdate = "UPDATE dbo.WorkOrder_Detail SET "
					    cUpdate = cUpdate + " fTBL=''"
					    cUpdate = cUpdate + " ,fID_Detail=0"
					    cUpdate = cUpdate + " ,fID_Detail_Process=0"
					    cUpdate = cUpdate + " ,StkListed=0"
					 	cUpdate = cUpdate + " WHERE WO_Detail= "+STR(nWO_Detail)
						cUpdate = cUpdate + " AND fID_Detail="+ STR(nID_Detail)
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cUpdate, ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cUpdate )
						ENDIF
						
						*MESSAGEBOX("Added to StockLst"+CHR(13)+" with an INCOMING process "+CHR(13)+" for WO Detail	"+STR(nWO_Detail),48,"Complete")
						
					ENDIF
					
				
				ELSE
					MESSAGEBOX("Did not find Detail for this WO_Detail to Delete.",0+48,"Cannot Delete")
					TrackError("TBL="+cTBL+" ID_Detail="+STR(nID_Detail)+CHR(13)+"WO_Detail="+STR(nWO_Detail),"Did not find Detail for this WO_Detail to Delete.", PROGRAM(), LINENO(1))
				ENDIF
			ELSE
				MESSAGEBOX("Did not find 1 Detail record to Delete.",0+48,"Cannot Delete")
				TrackError("Found more then 1 detail record to Delete."+CHR(13)+"Tbl="+cTBL+" ID_Detail="+STR(nID_Detail)+CHR(13)+"WO_Detail="+STR(nWO_Detail),"Did not find 1 Detail record to Delete.", PROGRAM(), LINENO(1))
			ENDIF
		ENDIF
	ENDPROC

