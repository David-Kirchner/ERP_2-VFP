		*********************************************
		**** FINISH LOT
		
		
		PRIVATE nFinishLot, cFinishM, cFinishMlog
		nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		
		IF nFinishLot > 0 AND NOT EMPTY(cFinishM)
			cFinishMlog = AppSetup_Get_UN_From_PRP_ANS('Production Machine  ',cFinishM)
			
			IF MESSAGEBOX("Do you want to print the Finish lot paper?"+CHR(13)+CHR(13)+cFinishM+" "+ALLTRIM(STR(nFinishLot)),32+4,"Print "+cFinishMlog )=6
				DO CASE
				*********************************
				CASE cFinishMlog = 'Draw_Log'
				
					IF USED('Draw_Log')
						USE IN Draw_Log
					ENDIF
		
					SELECT 0
					cSQL = "SELECT * "
					cSQL = cSQL + " FROM dbo.Draw_Log "
					cSQL = cSQL + " WHERE Lot = "+STR(nFinishLot)
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Draw_Log')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Draw_Log')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Draw_Log")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Draw_Log")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
