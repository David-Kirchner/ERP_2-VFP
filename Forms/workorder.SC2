	PROCEDURE frmChooseWO.cmdSearch.Valid
		PRIVATE nWO, nWO_Detail, nSearchWO, cSearchWhere, cSQL
		nWO = 0
		nWO_Detail = 0
		nSearchWO = 0
		cSearchWhere = ''
		cSQL = ''
		
		PRIVATE nPO, nSO, nLot, cLot, cMach_INIT, cFinishM, cSOitem, cPOitem
		nPO = 0
		nSO = 0
		nLot = 0
		cLot = ''
		cMach_INIT = ''
		cFinishM = ''
		cSOitem = Proper_SO_item('')
		cPOitem = Proper_PO_item('')
		
		PRIVATE cSearchType, cSearchText
		cSearchType = ThisForm.cmbSearch.Value  &&This.RowSource = "Work Order,WO Detail,SO item,PO item,GFM Log,Prod Log"
		cSearchText = ThisForm.txtSearch.Value
		
		*Work Order,WO Detail,SO item,PO item
		DO CASE
		CASE cSearchType = "Work Order"
			nWO = PrepareSQLnum(cSearchText,'WorkOrder',-3)
			IF nWO > 0
				cSQL = ''  &&Leave Empty
			ENDIF
			
		CASE cSearchType = "WO Detail"
			nWO_Detail = PrepareSQLnum(cSearchText,'WorkOrder_Detail',-3)
			IF nWO_Detail > 0
				cSQL = "SELECT WO, WO_Detail  "
				cSQL = cSQL + " FROM dbo.WorkOrder_Detail "
				cSQL = cSQL + " WHERE WO_Detail = "+ALLTRIM(STR(nWO_Detail))
			ENDIF
			
		CASE cSearchType = "SO item"
			cSOitem = PrepareSQLtxt(cSearchText,'SOitem',10)
			nSO = Proper_SO(cSOitem)
			IF AT("-",cSearchText) > 0 AND NOT cSOitem = Proper_SO_item('')
				cSQL = "SELECT WO, 0 AS WO_Detail FROM dbo.WorkOrder " 
				cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT WO, WO_Detail FROM dbo.WorkOrder_Detail " 
				cSQL = cSQL + " WHERE fSOitem = '"+cSOitem+"'"
			ELSE
				
				nSO = PrepareSQLnum(cSearchText,'SalesNum',-3)
				IF nSO > 0
					cSQL = "SELECT WO, 0 AS WO_Detail FROM dbo.WorkOrder " 
					cSQL = cSQL + " WHERE dbo.f_ProperSO(SOitem) = "+STR(nSO)
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT WO, WO_Detail FROM dbo.WorkOrder_Detail " 
					cSQL = cSQL + " WHERE dbo.f_ProperSO(fSOitem) = "+STR(nSO)
				ENDIF
			ENDIF
			
		CASE cSearchType = "PO item"
			cPOitem = PrepareSQLtxt(cSearchText,'POitem',12)
			nPO = Proper_PO(cPOitem)
			*IF cPOitem != Proper_PO_item('')
			IF AT("-",cSearchText) > 0 AND NOT cPOitem = Proper_PO_item('')
				cSQL = " SELECT WO, 0 AS WO_Detail  FROM dbo.WorkOrder " 
				cSQL = cSQL + " WHERE POitem = '"+cPoitem+"'"
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT WO, FROM dbo.WorkOrder_Detail " 
				cSQL = cSQL + " WHERE fPOitem = '"+cPoitem+"'"
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT WO, WO_Detail  FROM dbo.WorkOrder_Detail " 
				cSQL = cSQL + " WHERE TestPO = '"+cPoitem+"'"
			ELSE
				
				*nPO = PrepareSQLnum(cSearchText,'HPApo',-3)
				IF nPO > 0
					*dbo.f_ProperPO(POitem)
					cSQL = " SELECT WO, 0 AS WO_Detail FROM dbo.WorkOrder " 
					*cSQL = cSQL + " WHERE POitem LIKE '%"+ALLTRIM(STR(nPO))+"-%'"
					cSQL = cSQL + " WHERE dbo.f_ProperPO(POitem) = "+STR(nPO)
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT WO, WO_Detail  FROM dbo.WorkOrder_Detail " 
					*cSQL = cSQL + " WHERE fPOitem LIKE '%"+ALLTRIM(STR(nPO))+"-%'"
					cSQL = cSQL + " WHERE dbo.f_ProperPO(fPOitem) = "+STR(nPO)
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT WO, WO_Detail  FROM dbo.WorkOrder_Detail " 
					*cSQL = cSQL + " WHERE TestPO LIKE '%"+ALLTRIM(STR(nPO))+"-%'"
					cSQL = cSQL + " WHERE dbo.f_ProperPO(TestPO) = "+STR(nPO)
				ENDIF
			ENDIF
		CASE cSearchType = "GFM Log"
			cLot = PrepareSQLtxt(cSearchText,'Lot',10)
			IF LEFT(cLot,1) = "G"
				nLot = PrepareSQLnum(SUBSTR(cLot,2,10),'Lot',-3)
			ELSE
				nLot = PrepareSQLnum(cSearchText,'Lot',-3)
			ENDIF
			cFinishM = Machine_Name("G")
			IF nLot > 0
				*cSQL = "SELECT WO,WO_Detail FROM dbo.GFMlog "
				*cSQL = cSQL + " WHERE Lot = "+STR(nLot)
				cSQL = cSQL + " SELECT WO, WO_Detail FROM dbo.WorkOrder_Detail " 
				cSQL = cSQL + " WHERE FinishLot = "+STR(nLot)
				cSQL = cSQL + " AND FinishM = '"+cFinishM+"'"
			ENDIF
			
		CASE cSearchType = "Prod Log"
			cLot = PrepareSQLtxt(cSearchText,'Lot',10)
			IF AT(LEFT(cLot,1),"ABCDEFGHIJKLMNOPQRSTUVWXYZ") > 0
				cMach_INIT = LEFT(cLot,1)
				nLot = PrepareSQLnum(SUBSTR(cLot,2,10),'Lot',-3)
			ELSE
				nLot = PrepareSQLnum(cSearchText,'Lot',-3)
			ENDIF
		*	nLot = PrepareSQLnum(cSearchText,'Lot',-3)
		*SELECT ANS,UN FROM dbo.AppSetup WITH(NOLOCK) WHERE PRP = 'Production Machine'
			cFinishM = Machine_Name(cMach_INIT)
			IF nLot > 0
				*cSQL = "SELECT WO,WO_Detail FROM dbo.GFMlog "
				*cSQL = cSQL + " WHERE Lot = "+STR(nLot)
				cSQL = cSQL + " SELECT WO, WO_Detail FROM dbo.WorkOrder_Detail " 
				cSQL = cSQL + " WHERE FinishLot = "+STR(nLot)
				cSQL = cSQL + " AND FinishM = '"+cFinishM+"'"
			ENDIF
			
		OTHERWISE
		ENDCASE
		
		************************
		IF NOT EMPTY(cSQL)
			IF USED("srchWorkOrder")	
				USE IN srchWorkOrder
			ENDIF
			SELECT 0
		
			PRIVATE nSQLEXEC 
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'srchWorkOrder')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'srchWorkOrder')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "srchWorkOrder")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "srchWorkOrder")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'srchWorkOrder')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		
			IF USED('srchWorkOrder')
				IF RECCOUNT('srchWorkOrder') > 0
					IF RECCOUNT('srchWorkOrder') = 1
						nWO = PrepareSQLnum(srchWorkOrder.WO,'WO',-3)
						nWO_Detail = PrepareSQLnum(srchWorkOrder.WO_Detail,'WO_Detail',-3)
					ELSE
						IF nLot > 0
							SCAN
								PRIVATE cMess
								cMess = "A Lot "+ALLTRIM(STR(nLot))+" was Found in mutliple places."+CHR(13)+"Found "+ALLTRIM(STR(RECCOUNT('srchWorkOrder')))+" Records."
								cMess = cMess +CHR(13)+CHR(13)+"In file "+ALLTRIM(PrepareSQLtxt(srchWorkOrder.TBL,'Table',30))+" SOitem "+PrepareSQLtxt(srchWorkOrder.SOitem,'SOitem',10)
								cMess = cMess +CHR(13)+"Answer 'Y' to see this WorkOrder, 'N' to move on"
								IF MESSAGEBOX(cMess,48,"Is the Production Lot?")=6
									nWO = PrepareSQLnum(srchWorkOrder.WO,'WO',-3)
									nWO_Detail = PrepareSQLnum(srchWorkOrder.WO_Detail,'WO_Detail',-3)
									EXIT
								ENDIF
							ENDSCAN
						ELSE
							MESSAGEBOX("Search returned mutliple records."+CHR(13)+"Found "+ALLTRIM(STR(RECCOUNT('srchWorkOrder')))+" Records.",0,"Only First is being shown")
							nWO = PrepareSQLnum(srchWorkOrder.WO,'WO',-3)
							nWO_Detail = PrepareSQLnum(srchWorkOrder.WO_Detail,'WO_Detail',-3)
						ENDIF
					ENDIF
				ENDIF
				USE IN srchWorkOrder
			ENDIF
		ENDIF
		
		**************************
		*!*	DO CASE
		*!*	CASE cSearchType = "Work Order"
		*!*	CASE cSearchType = "WO Detail"
		*!*	CASE cSearchType = "SO item"
		*!*	CASE cSearchType = "PO item"
		*!*	CASE cSearchType = "GFM log"
		*!*	CASE cSearchType = "Prod log"
		*!*	OTHERWISE
		*!*	ENDCASE
		
		
		*****************
		IF nWO > 0
			SELECT WorkOrder
			LOCATE FOR WO = nWO
			IF FOUND()
				ThisForm.grdWO.Refresh
		
				ThisFormset.Refresh_frmChooseWO_WO(nWO)
				*	CALLS: ThisFormSet.Refresh_frmChooseWO_Detail(WorkOrder.WO)
				*	CALLS: ThisFormSet.Set_frmChooseWO()
				WAIT WINDOW "Found WO "+ALLTRIM(STR(nWO)) TIMEOUT 1
			ELSE
				MESSAGEBOX("WorkOrder "+ALLTRIM(STR(nWO))+" was not Found!",48,"Not able to Show.")
			ENDIF
		ELSE
			IF nWO_Detail > 0
				nWO = GetWO_WO_Detail( nWO_Detail, ThisFormSet.nConnHandle)
				
				SELECT WorkOrder
				LOCATE FOR WO = nWO
				IF FOUND()
					ThisForm.grdWO.Refresh
		
					ThisFormset.Refresh_frmChooseWO_WO(nWO)
					WAIT WINDOW "Found WO "+ALLTRIM(STR(nWO)) TIMEOUT 1
				ELSE
					MESSAGEBOX("WorkOrder "+ALLTRIM(STR(nWO))+" was not Found!",48,"Not able to Show.")
				ENDIF
			ELSE
				PRIVATE cMess
				cMess = "Search:"
				IF nSO > 0
					cMess  = cMess + CHR(13)+ "SO "+STR(nSO)+" was searched for"
				ENDIF
				IF nPO > 0
					cMess  = cMess + CHR(13)+ "PO "+STR(nPO)+" was searched for"
				ENDIF
				MESSAGEBOX("Nothing found"+CHR(13)+cMess,48,"Not able to Show.")
				
				*****************
				IF cSearchType = "SO item"
					*nSO cSOitem
					IF MESSAGEBOX("Do you want to do a Deep Shearch for this SOitem?"+CHR(13)+"A web page will open to search from",4,"Open Search Report") = 6
						ThisFormSet.DeepSearchSOitem(cSOitem)
					ENDIF
					*Open a ReportServer report here
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

