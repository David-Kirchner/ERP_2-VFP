		**************************
		*RTR
			
		PRIVATE biRTR_ID
		biRTR_ID = 0
		
		*Skip this till router is polished.
		IF 0>0
		*IF nWO > 0
			*Get rtr_ID with WO
			cSQL = "SELECT ID FROM dbo.rtr "
			cSQL = cSQL + " WHERE WO = "+STR(nWO)
		
			IF USED("tmpRTRidWO")	
				USE IN tmpRTRidWO
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRTRidWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpRTRidWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTRidWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTRidWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRTRidWO')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpRTRidWO')
				IF RECCOUNT('tmpRTRidWO') > 0
					biRTR_ID = PrepareSQLnum(tmpRTRidWO.ID,'rtr_ID',-4)
				ENDIF
				USE IN tmpRTRidWO
			ENDIF
			
			IF (biRTR_ID) > 0
				*Print rtr?
		*		IF MESSAGEBOX("Do you want to print the Router sheet for the WO?"+CHR(13),32+4,"Print rtr:"+ALLTRIM(STR(biRTR_ID)))=6
		*			
		*			ThisFormSet.frmRouter.LoadRTR(biRTR_ID)
		*			*ThisFormSet.frmRouter.router_init(pWhat, pType, pID , nTop, nLeft, cCaption)
		*			*'tmpRTR_Detail_Remote'
		*			ThisFormSet.frmRouter.cmdPrintID.Click()
		*			
		*		ENDIF
			ENDIF
		ENDIF
		
		
		
		*Skip this till router is polished.
		IF 0>0
		*IF nWO_Detail > 0
			*Get rtr_ID with WOD
			cSQL = "SELECT ID FROM dbo.rtr "
			cSQL = cSQL + " WHERE WO_Detail = "+STR(nWO_Detail)
		
			IF USED("tmpRTRidWOD")	
				USE IN tmpRTRidWOD
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRTRidWOD')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpRTRidWOD')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTRidWOD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTRidWOD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRTRidWOD')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpRTRidWOD')
				IF RECCOUNT('tmpRTRidWOD') > 0
					biRTR_ID = PrepareSQLnum(tmpRTRidWOD.ID,'rtr_ID',-4)
				ENDIF
				USE IN tmpRTRidWOD
			ENDIF
				
			IF (biRTR_ID) > 0
				*Print rtr?
		*		IF MESSAGEBOX("Do you want to print the Router sheet for the Detail?",32+4,"Print rtr:"+ALLTRIM(STR(biRTR_ID)) )=6
		*			
		*			ThisFormSet.frmRouter.LoadRTR(biRTR_ID)
		*			ThisFormSet.frmRouter.router_init(pWhat, pType, pID , nTop, nLeft, cCaption)
		*			*'tmpRTR_Detail'
		*			ThisFormSet.frmRouter.cmdPrintID.Click()
		*			
		*		ENDIF
			ENDIF
		ENDIF
		*ENDIF
		
		
		
		
		**************************
		IF lfrmWorkOrder
			ThisFormSet.SetVfrmWorkOrder(.T.)
		ENDIF
		
		****************************
		IF lCancelled
			RETURN
		ENDIF
		
		*!*	****************************
		*!*	IF lComplete 
		*!*		IF NOT lfPrint	Undo the Print ???
		*!*			cSQL = "UPDATE dbo.WorkOrder_Detail SET fPrint=0 WHERE WO_Detail = "+STR(nWO_Detail)
		*!*			cSQL = "UPDATE dbo.WorkOrder_Detail SET fPrint=1, fPRecv=0, fMod=0, fRev="+STR(nfRev)+" WHERE WO_Detail = "+STR(nWO_Detail)
		*!*		
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, '')
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTRidWOD")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTRidWOD")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, '')
		*!*				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*			ELSE
		*!*				lfPrint = .T.
		*!*				ThisFormset.frmWorkOrder.chkfPrint.Value	= lfPrint 
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*	ENDIF
		
		****************************
		RETURN .T.
		
		
	ENDPROC

	PROCEDURE projstk_in_production		&& Calcutlate Pounds in production for this ID
		*ProjStk_In_Production()
		PRIVATE nID, nReturn
		nID = PrepareSQLnum(tmpProjStk.ID,'ID',-3)
		nReturn = 0
		IF nID > 0
			PRIVATE cSQL, nSQLEXEC 
		
			IF USED("tmpProjStk_In_Prod")	
				USE IN tmpProjStk_In_Prod
			ENDIF
			SELECT 0
		
			cSQL = "SELECT SUM(fWeight) AS fWeight "
			cSQL = cSQL + " FROM dbo.WorkOrder WO "
			cSQL = cSQL + " INNER JOIN dbo.WorkOrder_Detail WOD ON WO.WO = WOD.WO "
			cSQL = cSQL + " WHERE WOD.Stock_Projected_ID = "+STR(nID)
			cSQL = cSQL + " AND ISNULL(fCmplt,0) = 0"
			cSQL = cSQL + " AND ISNULL(fCncld,0) = 0"
		 
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProjStk_In_Prod')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpProjStk_In_Prod')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjStk_In_Prod")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjStk_In_Prod")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProjStk_In_Prod')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpProjStk_In_Prod')
				IF RECCOUNT('tmpProjStk_In_Prod') > 0
					nReturn = PrepareSQLnum(tmpProjStk_In_Prod.fWeight,'fWeight',7,1)
				ELSE
				
				ENDIF
				USE IN tmpProjStk_In_Prod
			ENDIF
		ENDIF
		
		RETURN nReturn
	ENDPROC

	PROCEDURE projstk_refresh
		*ThisFormset.ProjStk_Refresh()
		ThisFormset.frmSTK_Detail.Visible = .F.
		
		IF USED('tmpProjStk')
			ThisFormSet.frmStock_Projected.grdProStk.Refresh
			
			ThisFormSet.frmStock_Projected.txtCompany.Value 	= tmpProjStk.Company
			ThisFormSet.frmStock_Projected.txtID.Value 		= PrepareSQLnum(tmpProjStk.ID,'ID',-3)
			ThisFormSet.frmStock_Projected.txtAlloy.Value 	= tmpProjStk.Alloy
			ThisFormSet.frmStock_Projected.cmbForm.Value 	= tmpProjStk.Form
			ThisFormSet.frmStock_Projected.cmbCC.Value 		= tmpProjStk.CC
			ThisFormSet.frmStock_Projected.cmbCL.Value 		= tmpProjStk.CL
			ThisFormSet.frmStock_Projected.txtThck.Value 	= PrepareSQLnum(tmpProjStk.Thck,'Thck',9,3)
			ThisFormSet.frmStock_Projected.txtYearInches.Value = PrepareSQLnum(tmpProjStk.YearInches,'Inches',9,3)
			
			ThisFormSet.frmStock_Projected.txtMinPounds.Value 	= PrepareSQLnum(tmpProjStk.MinPounds,'MinPounds',-3)
			ThisFormSet.frmStock_Projected.txtYearPounds.Value 	= PrepareSQLnum(tmpProjStk.YearPounds,'YearPounds',-3)
			ThisFormSet.frmStock_Projected.txtPoundsTaken.Value 	= PrepareSQLnum(tmpProjStk.PoundsTaken,'PoundsTaken',-3)
			
			ThisFormset.frmStock_Projected.txtOverSize.Value		= PrepareSQLnum(tmpProjStk.OverSize,'OverSize',5,3)
			ThisFormSet.frmStock_Projected.txtSThck.Value 		= PrepareSQLnum(tmpProjStk.SThck,'SThck',9,3)
			ThisFormSet.frmStock_Projected.txtSNomThck.Value 	= PrepareSQLnum(tmpProjStk.SNomThck,'SNomThck',9,3)
			ThisFormSet.frmStock_Projected.txtStockQTY.Value 	= PrepareSQLnum(tmpProjStk.StockQTY,'StockQTY',-3)
			
			ThisFormSet.frmStock_Projected.txtSDate.Value		= PrepareSQLtxt(tmpProjStk.SDate,'SDate',10)
			
			****************************************************
			*ThisFormSet.frmStock_Projected.txtStockLBS.Value		= Calc_StockLst_QTY(tmpProjStk.Alloy, tmpProjStk.Form, tmpProjStk.CC, tmpProjStk.CL, tmpProjStk.Thck)
			****************************************************
			*ThisFormSet.frmStock_Projected.txtSStockLBS.Value	= Calc_StockLst_QTY(tmpProjStk.Alloy, tmpProjStk.Form, '1', '', tmpProjStk.SNomThck)
			****************************************************
			
			ThisFormSet.frmStock_Projected.txtCW.Value 			= PrepareSQLnum(tmpProjStk.CW,'CW',-1)
			ThisFormSet.frmStock_Projected.chkUT.Value 			= PrepareSQLchk(tmpProjStk.UT,'UT')
			
			ThisFormSet.frmStock_Projected.txtFollowM.Value	= PrepareSQLtxt(tmpProjStk.FollowM,'FollowM',20)
			ThisFormSet.frmStock_Projected.txtFollowLot.Value	= PrepareSQLnum(tmpProjStk.FollowLot,'FollowLot',-3)
			
			ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(0,'StartSize',8,3)
			ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(0,'CW',-1)
			ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(0,'RoughSize',8,3)
			ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
			
			ThisFormSet.frmStock_Projected.txtLBS_Prod.Value 	= PrepareSQLnum(tmpProjStk.fWeight,'fWeight',-3)   &&ThisFormSet.ProjStk_In_Production()
			ThisFormSet.frmStock_Projected.txtPDate.Value		= PrepareSQLtxt(tmpProjStk.PDate,'PDate',10)
			
			ThisFormSet.frmStock_Projected.txtLBS_Need.Value		= PrepareSQLnum(tmpProjStk.LBS_Needed,'LBS_Needed',-3) && ThisFormSet.frmStock_Projected.txtLBS_Prod.Value - ThisFormSet.frmStock_Projected.txtMinPounds.Value
			
			ThisFormSet.frmStock_Projected.txtCWcnt.Value	= PrepareSQLnum(tmpProjStk.CWcnt,'CWcnt',-1)
			ThisFormSet.frmStock_Projected.txtCWmin.Value	= PrepareSQLnum(tmpProjStk.CWmin,'CWmin',-1)
			ThisFormSet.frmStock_Projected.txtCWavg.Value	= PrepareSQLnum(tmpProjStk.CWavg,'CWavg',-1)
			ThisFormSet.frmStock_Projected.txtCWmedian.Value= PrepareSQLnum(tmpProjStk.CWmedian,'CWmedian',-1)
			ThisFormSet.frmStock_Projected.txtCWmax.Value	= PrepareSQLnum(tmpProjStk.CWmax,'CWmax',-1)
			ThisFormSet.frmStock_Projected.txtCLText.Value	= PrepareSQLtxt(tmpProjStk.CLText,'CLText',15)
			
			****************************************************
			ThisFormSet.frmStock_Projected.txtFSpec.Value	= PrepareSQLtxt(tmpProjStk.FSpec,'FSpec',50)
			****************************************************
			ThisFormset.frmStock_Projected.txtSpec_CC.Value		= PrepareSQLtxt(tmpProjStk.Spec_CC,'Spec_CC',1)
			ThisFormset.frmStock_Projected.txtSpec_CL.Value		= PrepareSQLtxt(tmpProjStk.Spec_CL,'Spec_CL',1)
			
			
			*PT.StartDia 
		
		ENDIF	
		
	ENDPROC

	PROCEDURE p_calc_weight		&& Calls HPAlloy.dbo.p_Calc_Weight
		PARAMETERS nPieces, cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3
		*ThisFormSet.p_Calc_Weight(nPieces, cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3)
		
		PRIVATE nStandardThickness
		nStandardThickness	= ALLTRIM(Remove0( nThck,9,4 ))
		
		PRIVATE nWeight, nForceBracket
		nWeight = 0
		nForceBracket = .F.
		
		*****************************
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.p_GetFullQuoteCL "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",'"+cCL+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		cSQL = cSQL + ",''" &&CustID
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			
				PRIVATE cMess
				cMess = "Could not get the Price!"+CHR(13)
				IF nPieces > 10000
					cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
				ENDIF
				IF nThck > 16
					cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
				ENDIF
				IF nSz2	> 120
					cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
				ENDIF
				IF nSz3	 > 300
					cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
				ENDIF
				MESSAGEBOX(cMess,16,"Edit your input numbers")
				
		ENDIF
		
		*!*	SELECT @nPounds AS Pounds, @lnSurcharge AS Surcharge, @nCutPounds AS CutPounds
		*!*	, @nPrice AS Price, @nBracket AS Bracket
		*!*	, @nStdSize AS StdSize
		*!*	, @cAlloy AS StdAlloy
		*!*	, @nDensity AS Density
		*!*	, @cMessage AS WeightMess
		*!*	, @cPTMessage AS PriceMess, @bActivePrice AS ActivePrice
		*************************************
		
		************************
		IF USED('tmpPriceTbl')
		
			IF EMPTY(tmpPriceTbl.Density)
				IF NOT EMPTY(cAlloy)
					MESSAGEBOX("USING .290 DENSITY  - THE REAL FIGURE SHOULD BE PROGRAMED",0+64,"Alloy Density not found")
				ENDIF
				*nDensity = .29
			ELSE 
				*nDensity = tmpPriceTbl.Density
			ENDIF
		
			IF USED('tmpPriceTbl')
				IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
					IF tmpPriceTbl.Pounds > 0
						nWeight = tmpPriceTbl.Pounds
					ENDIF
				ENDIF
				USE IN tmpPriceTbl
			ENDIF
		ENDIF
		
		RETURN nWeight
		
	ENDPROC

	PROCEDURE recalc
		PARAMETERS pWhat
		*ThisFormSet.ReCalc("FINISH")
		
		IF VARTYPE(pWhat) != "C"
			MESSAGEBOX("Parameter TesingInches not supplied.",48,"Cannot Calculate")
			TrackError("ThisFormSet.ReCalc(pWhat) did not get Parameter pWhat","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE lFinish
		lFinish = .T.
		
		IF pWhat = "START"
			lFinish = .F.
		ENDIF
		
		PRIVATE nsPieces, cAlloy, csForm, cCC, cCL, nsThck, nsSz2, nsSz3, nsWeight
		PRIVATE nfPieces, cfForm, nfThck, nfSz2, nfSz3, nfWeight
		nsPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12)
		csForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCL.Value,'CL',1)
		nsThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtThck.Value,'Thck',10,4)
		nsSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz2.Value,'sz2',9,3)
		nsSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz3.Value,'Sz3',9,3)
		nsWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtWeight.Value,'weight',7,1)
		
		nfPieces= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		cfForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
		nfThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfThck.Value,'Thck',10,4)
		nfSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfSz2.Value,'sz2',9,3)
		nfSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfSz3.Value,'Sz3',9,3)
		nfWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtfWeight.Value,'weight',7,1)
		
		
		IF NOT ( csForm = '10' OR cfForm = '10' )
			MESSAGEBOX("Only form BAR has been programmed.",48,"Cannot Calculate")
			RETURN .F.
		ENDIF
		*PRIVATE lUse3rdDim, luse3rdDim2
		*lsUse3rdDim = Uses3rdDim( csForm )
		*lfUse3rdDim = Uses3rdDim( cfForm )
		
		PRIVATE lusesForm_Dim2 
		lusesForm_Dim2  = usesForm_Dim2(csForm, ThisFormSet.nConnHandle)
		
		PRIVATE nNewfSz2, nNewsWeight, nNewfWeight, nsLentgh, nfLength
		PRIVATE nsLength
		nsLength = 0
		
		IF lFinish
			IF nsPieces = 0 OR nsSz2 = 0
		*		IF lusesForm_Dim2 
					MESSAGEBOX("Need a Pc count, Dia and length on the START side.",48,"Cannot Calculate")
					RETURN .F.
		*		ELSE
				
		*		ENDIF
			ELSE
				nsLength = nsSz2 * nsPieces
			ENDIF
		ELSE
			IF lusesForm_Dim2  
				IF nfPieces = 0 OR nfSz2 = 0
					MESSAGEBOX("Need a Pc count, Dia and length on the FINISH side.",48,"Cannot Calculate")
					RETURN .F.
				ELSE
					nfLength = nfSz2 * nfPieces
				ENDIF
			ELSE
			
			ENDIF
		ENDIF
		
		*nNewfSz2 = CEILING( nfLength + ( nInches /nfPieces ))
		*nNewfWeight = CEILING( nfWeight * (nNewfSz2/nfLength))
		
	ENDPROC

	PROCEDURE recheck_finishlot		&& See if WO or WOD changes need to be carried to Log
		*ThisFormSet.ReCheck_FinishLot()
		
		PRIVATE nWO, nWO_Detail
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF nWO = 0
		*	MESSAGEBOX("No Work Order",48,"Cannot check Stock without WO.")
			RETURN .F.
		ENDIF
		IF nWO_Detail= 0
		*	MESSAGEBOX("No Work Order Detail",48,"Cannot check Stock without WO_Detail")
			RETURN .F.
		ENDIF
		
		PRIVATE cFinishM, nFinishLot
		cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		
		IF LEN(cFinishM) = 0
			*TrackError("Finish Machine '"+cFinishM+"' not defined."+CHR(13)+"Finish Lot = "+ALLTRIM(STR(nFinishLot)),"Finish Machine not defined.", PROGRAM(), LINENO(1))
			*MESSAGEBOX("Finish Machine '"+cFinishM+"' not defined."+CHR(13)+"Finish Lot = "+ALLTRIM(STR(nFinishLot)),"Finish Machine not defined."
			RETURN .F.
		ENDIF
		IF nFinishLot  = 0
			*TrackError("Finish Machine '"+cFinishM+"' defined."+CHR(13)+"Finish Lot = "+ALLTRIM(STR(nFinishLot)),"Finish Machine Lot not defined.", PROGRAM(), LINENO(1))
			*MESSAGEBOX("Finish Machine '"+cFinishM+"' defined."+CHR(13)+"Finish Lot = "+ALLTRIM(STR(nFinishLot)),"Finish Machine Lot not defined.")
			RETURN .F.
		ENDIF
		
		****************************
		
		*ThisFormSet.InitStockWO
		*ThisFormSet.StockLstAdd_WOD()
		
		PRIVATE nFPieces, cAlloy,cForm,cCC,cCL
		nFPieces = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
		cForm2	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCL.Value,'CL',1)
		
		PRIVATE nProjID 
		nProjID = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value,'ProjID',-3)
		
		PRIVATE nPC, nFthck, nFSz2, nFSz3, nFWeight, nSWeight, nTotFinishW, nLostWeight, cFSpec
		nfPC		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'PCs',-3)
		nFthck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz2.Value,'Sz2',13,3)
		nFSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz3.Value,'Sz3',13,3)
		nFWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFWeight.Value,'Weight',7,1)
		nSWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWeight.Value,'Weight',7,1)
		nTotFinishW	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtTotFinishW.Value,'TotFinish',9,1)
		nLostWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtLostWeight.Value,'LostWeight',9,1)
		cFSpec		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSpec.Value,'FSpec',50)
		
		
		PRIVATE cFDescript, cfCondLevel, cFollowM, nFollowLot
		cFDescript	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFdescript.Value,'Fdescript',100)
		cfCondLevel = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		cFollowM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFollowM.Value,'FollowM',20)
		nFollowLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFollowLot.Value,'FollowLot',-3)
		*cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		*nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		
		*!*	PRIVATE cSSOitem, cSPOitem
		*!*	cSSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		*!*	cSPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		*!*	PRIVATE cFSOitem, cFPOitem
		*!*	cFSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		*!*	cFPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFPOitem.Value,'POitem',12)
		
		*!*	PRIVATE nfReceivingID, lIntP, lfCmplt, cFNotes, nStock_Projected_ID, lfCncld, lStkListed
		*!*	nfReceivingID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfReceivingID.Value,'RecevingID',-3)
		*!*	lIntP		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')  &&Used on WO and WO_Detail
		*!*	lfCmplt		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCmplt.Value,'fCmplt')
		*!*	cFNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtfNotes.Value,'Notes',-1)
		*!*	nStock_Projected_ID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value,'Stock_Projected_ID',-3)
		*!*	lfCncld		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCncld.Value,'fCncld')
		*!*	lStkListed	= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkStkListed.Value,'StkListed')
		
		PRIVATE cfCondLevel, nStartSize, nCW, nRoughSize, nOverSize, dFDueDate, dSDueDate
		cfCondLevel	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		nStartSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		dFDueDate	= PrepareSQLdate(ThisFormSet.frmWorkOrder.txtFDueDate.Value,'FDueDate')
		dSDueDate	= PrepareSQLdate(ThisFormSet.frmWorkOrder.txtDueDate.Value,'DueDate')
		PRIVATE cNextCode, cNextNumber
		cNextCode 	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbNextCode.Value,'NextCode',3)
		cNextNumber	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtNextNumber.Value,'NextNumber',10)
		*!*	PRIVATE nSalesNum, cSOitem, nItemSO, pcSOitem 
		*!*	nSalesNum = VAL( PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFsoitem.Value,'SOitem',10))
		*!*	cSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFsoitem.Value,'SOitem',10)
		*!*	nItemSO = VAL( RIGHT(cSOitem,2))
		*!*	*pcSOitem = "WORKORDER"
		
		
		
		*!*	*************************************************
		*!*	*StockLst_Detail Variables
		*!*	PRIVATE nPieces, nThck, nSz2, nSz3, nPounds
		*!*	nPieces		= nFPieces
		*!*	nThck	= nFthck
		*!*	nSz2	= nFSz2
		*!*	nSz3	= nFSz3
		
		*!*	IF nTotFinishW > 0
		*!*		nPounds = nTotFinishW
		*!*	ELSE
		*!*		IF nFWeight > 0
		*!*			nPounds = nFWeight 
		*!*			IF nSWeight > 0
		*!*				nPounds = nFWeight 
		*!*			ELSE
		*!*				nPounds = 0
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	PRIVATE nS_QTY, nStockLst_P, lRandLen, nS_Total, nS_PU
		*!*	IF nTotFinishW > 0
		*!*		nS_QTY = nTotFinishW
		*!*	ELSE
		*!*		IF nFWeight > 0
		*!*			nS_QTY = nFWeight 
		*!*			IF nSWeight > 0
		*!*				nS_QTY = nFWeight 
		*!*			ELSE
		*!*				nS_QTY = 0
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		*!*	nStockLst_P = 0
		*!*	lRandLen = .T.
		*!*	nS_Total = 0 
		*!*	nS_PU	= GetPUfromForm(cForm, ThisFormSet.nConnHandle)
		
		*!*	PRIVATE cCond, cSpecs, cHeat, cPoItem
		*!*	cCond	= PrepareSQLtxt(cFDescript,'Cond',50)
		*!*	cSpecs	= PrepareSQLtxt(cFSpec,'FSpec',160)
		*!*	cHeat	= PrepareSQLtxt("Production",'Heat',50)
		*!*	cPoItem	= cFPOitem
		
		*!*	*!*	IF NOT EMPTY(dFDueDate)
		*!*	*!*		dDueDate = dFDueDate
		*!*	*!*	ELSE
		*!*	*!*		IF NOT EMPTY(dSDueDate)
		*!*	*!*			dDueDate = dSDueDate
		*!*	*!*		ELSE
		*!*	*!*			dDueDate = DATE()+180
		*!*	*!*		ENDIF
		*!*	*!*	ENDIF
		
		*!*	PRIVATE cPOStatus, cBrandName, cMelt
		*!*	cPOStatus	= 'D' &&DueIn
		*!*	cBrandName	= ''
		*!*	cMelt		= ''
		
		*!*	PRIVATE cShipLocation, cLstDetailUnit
		*!*	cShipLocation	= ''
		*!*	cLstDetailUnit	= GetUNITfromFORM( cForm, ThisFormSet.nConnHandle )
		
		*!*	PRIVATE cMill,cStock,cHistory ,nFrom_ID
		*!*	cMill	= PrepareSQLtxt("HPA",'Mill',10)
		*!*	cStock = "STOCK"
		*!*	cHistory = PrepareSQLtxt("WO_Detail "+ALLTRIM(STR(nWO_Detail)),'History',20)
		*!*	nFrom_ID = 0 &&look at WO selected stock.
		
		
		************************************************************************************
		
		IF USED('tmpLOG')
			USE IN tmpLOG
		ENDIF
		
		cSQL = "SELECT * "
		DO CASE 
		CASE UPPER(cFinishM) = "DRAW BENCH" 
			cSQL = cSQL + ",DrawSize AS [newSize]"
			cSQL = cSQL + " FROM dbo.Draw_log "
		
		CASE UPPER(cFinishM) = "GFM"
			cSQL = cSQL + ",GfmSize AS [newSize]"
			cSQL = cSQL + " FROM dbo.GFMlog "
		
		CASE UPPER(cFinishM) = "HEAT TREAT"
			cSQL = cSQL + ",rollSize AS [newSize]"
			cSQL = cSQL + " FROM dbo.HT_Log "
			
		CASE UPPER(cFinishM) = "OPEN DIE"
			cSQL = cSQL + ",rollSize AS [newSize]"
			cSQL = cSQL + " FROM dbo.LakeErie_Log "
		
		CASE UPPER(cFinishM) = "ROLLING"
			cSQL = cSQL + ",RollSize AS [newSize]"
			cSQL = cSQL + " FROM dbo.Roll_log "
		
		CASE UPPER(cFinishM) = "SWAGE"	
			cSQL = cSQL + ",SwageSize AS [newSize]"
			cSQL = cSQL + " FROM dbo.Swage_Log "
		
		*CASE UPPER(cFinishM) = "HALLDEN"
		
		CASE UPPER(cFinishM) = "WIRE DRAW"
			cSQL = cSQL + ",DrawSize AS [newSize]"
			cSQL = cSQL + " FROM dbo.Wire_Log "
			
		OTHERWISE
			TrackError("Finish Machine '"+cFinishM+"' not defined."+CHR(13)+"Finish Lot = "+ALLTRIM(STR(nFinishLot)),"Finish Machine not defined.", PROGRAM(), LINENO(1))
			*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Long Message")
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " WHERE LOT = "+STR(nFinishLot)
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpLOG')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpLOG')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpLOG")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpLOG")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,"tmpLOG",ThisFormSet.nConnHandle)
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpLOG')
				IF RECCOUNT('tmpLOG')=0
					MESSAGEBOX(cFinishM+" Lot "+ALLTRIM(STR(nFinishLot))+" does not exists!"+CHR(13)+"Check for a Typing error",0+48,"Not Found" )
				ELSE
					*See if WO_Detail has changed from last LOT Save.
					
					*** WIP !?!
					
					
					
					*[sPiece],[sSize],[sLength],[sWeight]
					IF cAlloy != PrepareSQLtxt(tmpLOG.AlloyName,"Alloy",12)
					ENDIF
					*[fPiece],[fLength],[Condition]
					*nStartSize, nRoughSize, nOverSize
					IF nfThck <> PrepareSQLnum(tmpLOG.fSize,'Size',9,3)
					ENDIF
					IF nStartSize <> PrepareSQLnum(tmpLOG.SSize,'Size',9,3)
					ENDIF
					
					IF nCW <> PrepareSQLnum(tmpLOG.ColdWork,'ColdWork',9,3)*100
					ENDIF
					IF nOverSize <> PrepareSQLnum(tmpLOG.newSize,'Size',9,3)
					ENDIF
					IF nfThck+nOverSize <> nRoughSize 
						*nRoughSize =
					ENDIF
					IF nRoughSize <> PrepareSQLnum(tmpLOG.newSize,'Size',9,3)
					ENDIF
					
					*IF cCond != PrepareSQLtxt(tmpLOG.Condition,"Cond",50)
					*ENDIF
					*IF cFSpec != PrepareSQLtxt(tmpLOG.Specs,"Specs",160)
					*ENDIF
		
					IF nWO_Detail <> PrepareSQLnum(tmpLOG.WO_Detail,'WO_Detail',-3)
					ENDIF
					IF nProjID <> PrepareSQLnum(tmpLOG.ProjID,'ProjID',-3)
					ENDIF
					
					***************************
					
					IF nfPC <> PrepareSQLnum(tmpLOG.fPiece,'PC',-3)
					ENDIF
		      		IF nFthck <> PrepareSQLnum(tmpLOG.fSize,'Dim1',9,4)
					ENDIF
					
					IF UPPER(cFinishM) = "GFM" OR UPPER(cFinishM) = "OPEN DIE"
						*some logs do not have a length
						IF nFSz2 <> PrepareSQLnum(tmpLOG.fLength,'Dim2',8,3)
						ENDIF
					ENDIF
					*IF nFSz3 <> PrepareSQLnum(tmpLOG.Dim3,'Dim3',8,3)
					*ENDIF
					*IF nFWeight <> PrepareSQLnum(tmpLOG.Weight,'Weight',9,1)
					*ENDIF
					*IF cDescript != PrepareSQLtxt(tmpLOG.Descript,"Descript",20)
					*ENDIF
					*IF nS_PU <> PrepareSQLnum(tmpLOG.S_PU,'S_PU',1)
					*ENDIF
					IF nWO <> PrepareSQLnum(tmpLOG.WO,'WO',-3)
					ENDIF
					
		
					*Start or Finish SOitem ?
					*IF cSOitem != PrepareSQLtxt(tmpLOG.SOitem,"SOitem",10)
					*ENDIF
					*IF cPOitem != PrepareSQLtxt(tmpLOG.PO_item,"PO_item",12)
					*ENDIF
					
		  
				ENDIF	
				USE IN tmpLOG
			ENDIF
		ENDIF
		
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE recheck_stockdata_wod		&& See if WOD has change and apply to Stock
		PARAMETERS pWO_Detail
		*ThisFormSet.ReCheck_StockData_WOD(nWO_Detail)
		
		PRIVATE nWO, nWO_Detail
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(pWO_Detail,'WO_Detail',-3)
		
		IF nWO = 0
		*	MESSAGEBOX("No Work Order",48,"Cannot check Stock without WO.")
			RETURN .F.
		ENDIF
		IF nWO_Detail= 0
		*	MESSAGEBOX("No Work Order Detail",48,"Cannot check Stock without WO_Detail")
			RETURN .F.
		ENDIF
		
		PRIVATE nfReceivingID
		nfReceivingID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfReceivingID.Value,'ReceivingID',-3)
		IF nfReceivingID > 0
		*	MESSAGEBOX("Cannot UPDATE stock that has already been Received."+CHR(13)+"Create another WO_Detail to list more stock."+CHR(13)+"or use StockLst Maintanence to Edit.",48,"Cannot Create a Stock entry!")
			RETURN .F.
		ENDIF
		
		PRIVATE cfTBL, nFID_Detail, nFID_Detail_Process
		cfTBL			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFTBL.Value,'TBL',1)
		nFID_Detail		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail.Value,'ID_Detail',-3)
		nFID_Detail_Process = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		IF EMPTY(cfTBL)
			RETURN .F.
		ENDIF
		IF NOT ( cfTBL = "S" OR cfTBL = "B" OR cfTBL = "W" )
			RETURN .F.
		ENDIF
		IF nFID_Detail = 0
			RETURN .F.
		ENDIF
		IF nFID_Detail_Process = 0
			RETURN .F.
		ENDIF
		
		****************************
		
		*ThisFormSet.InitStockWO
		*ThisFormSet.StockLstAdd_WOD()
		
		PRIVATE nFPieces, cAlloy,cForm,cCC,cCL
		nFPieces = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
		cForm2	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCL.Value,'CL',1)
		PRIVATE nmS_QTY, nProjID 
		nmS_QTY = 0
		nProjID = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value,'ProjID',-3)
		
		PRIVATE nPC, nFthck, nFSz2, nFSz3, nFWeight, nSWeight, nTotFinishW, nLostWeight, cFSpec
		nfPC		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'PCs',-3)
		nFthck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz2.Value,'Sz2',13,3)
		nFSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz3.Value,'Sz3',13,3)
		nFWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFWeight.Value,'Weight',7,1)
		nSWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWeight.Value,'Weight',7,1)
		nTotFinishW	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtTotFinishW.Value,'TotFinish',9,1)
		nLostWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtLostWeight.Value,'LostWeight',9,1)
		cFSpec		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSpec.Value,'FSpec',50)
		
		
		PRIVATE cFDescript, cfCondLevel, cFollowM, nFollowLot, cFinishM, nFinishLot
		cFDescript	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFdescript.Value,'Fdescript',100)
		cfCondLevel = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		cFollowM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFollowM.Value,'FollowM',20)
		nFollowLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFollowLot.Value,'FollowLot',-3)
		cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		
		PRIVATE cSSOitem, cSPOitem
		cSSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		cSPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		PRIVATE cFSOitem, cFPOitem
		cFSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		cFPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFPOitem.Value,'POitem',12)
		
		PRIVATE nfReceivingID, lfCmplt, cFNotes, nStock_Projected_ID, lfCncld, lStkListed
		nfReceivingID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfReceivingID.Value,'RecevingID',-3)
		*lIntP		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')  &&Used on WO and WO_Detail
		lfCmplt		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCmplt.Value,'fCmplt')
		cFNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtfNotes.Value,'Notes',-1)
		nStock_Projected_ID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value,'Stock_Projected_ID',-3)
		lfCncld		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCncld.Value,'fCncld')
		lStkListed	= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkStkListed.Value,'StkListed')
		
		PRIVATE cfCondLevel, nStartSize, nCW, nRoughSize, nOverSize, dFDueDate, dSDueDate
		cfCondLevel	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		nStartSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		dFDueDate	= PrepareSQLdate(ThisFormSet.frmWorkOrder.txtFDueDate.Value,'FDueDate')
		dSDueDate	= PrepareSQLdate(ThisFormSet.frmWorkOrder.txtDueDate.Value,'DueDate')
		PRIVATE cNextCode, cNextNumber
		cNextCode 	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbNextCode.Value,'NextCode',3)
		cNextNumber	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtNextNumber.Value,'NextNumber',10)
		
		PRIVATE nSalesNum, cSOitem, nItemSO, pcSOitem 
		nSalesNum = VAL( PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFsoitem.Value,'SOitem',10))
		cSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFsoitem.Value,'SOitem',10)
		nItemSO = VAL( RIGHT(cSOitem,2))
		*pcSOitem = "WORKORDER"
		
		
		
		*************************************************
		*StockLst_Detail Variables
		PRIVATE nPieces, nThck, nSz2, nSz3, nPounds
		nPieces		= nFPieces
		nThck	= nFthck
		nSz2	= nFSz2
		nSz3	= nFSz3
		
		IF nTotFinishW > 0
			nPounds = nTotFinishW
		ELSE
			IF nFWeight > 0
				nPounds = nFWeight 
				IF nSWeight > 0
					nPounds = nFWeight 
				ELSE
					nPounds = 0
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE nS_QTY, nStockLst_P, lRandLen, nS_Total, nS_PU
		IF nTotFinishW > 0
			nS_QTY = nTotFinishW
		ELSE
			IF nFWeight > 0
				nS_QTY = nFWeight 
				IF nSWeight > 0
					nS_QTY = nFWeight 
				ELSE
					nS_QTY = 0
				ENDIF
			ENDIF
		ENDIF
		nStockLst_P = 0
		lRandLen = .T.
		nS_Total = 0 
		nS_PU	= GetPUfromForm(cForm, ThisFormSet.nConnHandle)
		
		PRIVATE cCond, cSpecs, cHeat, cPoItem
		cCond	= PrepareSQLtxt(cFDescript,'Cond',50)
		cSpecs	= PrepareSQLtxt(cFSpec,'FSpec',160)
		cHeat	= PrepareSQLtxt("Production",'Heat',50)
		cPoItem	= cFPOitem
		
		*!*	IF NOT EMPTY(dFDueDate)
		*!*		dDueDate = dFDueDate
		*!*	ELSE
		*!*		IF NOT EMPTY(dSDueDate)
		*!*			dDueDate = dSDueDate
		*!*		ELSE
		*!*			dDueDate = DATE()+180
		*!*		ENDIF
		*!*	ENDIF
		
		PRIVATE cPOStatus, cBrandName, cMelt
		cPOStatus	= 'D' &&DueIn
		cBrandName	= ''
		cMelt		= ''
		
		PRIVATE cShipLocation, cLstDetailUnit
		cShipLocation	= ''
		cLstDetailUnit	= GetUNITfromFORM( cForm, ThisFormSet.nConnHandle )
		
		PRIVATE cMill,cStock,cHistory ,nFrom_ID
		cMill	= PrepareSQLtxt("HPA",'Mill',10)
		cStock = "STOCK"
		cHistory = PrepareSQLtxt("WO_Detail "+ALLTRIM(STR(nWO_Detail)),'History',20)
		nFrom_ID = 0 &&look at WO selected stock.
		
		
		************************************************************************************
		
		IF USED('tmpINVCheck')
			USE IN tmpINVCheck
		ENDIF
		
		cSQL = "SELECT * "
		DO CASE 
		CASE cfTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON P.ID_Detail = D.ID_Detail "
		CASE cfTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON P.ID_Detail = D.ID_Detail "
		CASE cfTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON P.ID_Detail = D.ID_Detail "
		OTHERWISE
			RETURN
		ENDCASE
		cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nFID_Detail)+" AND P.ID_Detail_Process = "+STR(nFID_Detail_Process)
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpINVCheck')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpINVCheck')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVCheck")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVCheck")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,"tmpINVCheck",ThisFormSet.nConnHandle)
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpINVCheck')
				IF RECCOUNT('tmpINVCheck')>0
					*See if WO_Detail has changed from last Stock Save.
					
					IF cAlloy != PrepareSQLtxt(tmpINVCheck.Alloy,"Alloy",12)
					ENDIF
					IF cForm != PrepareSQLtxt(tmpINVCheck.Form,"Form",2)
					ENDIF
					IF cCC != PrepareSQLtxt(tmpINVCheck.CC,"CC",1)
					ENDIF
					IF cCL != PrepareSQLtxt(tmpINVCheck.CL,"CL",1)
					ENDIF
					IF nfThck <> PrepareSQLnum(tmpINVCheck.Size,'Size',9,3)
					ENDIF
					IF cCond != PrepareSQLtxt(tmpINVCheck.Cond,"Cond",50)
					ENDIF
					IF cFSpec != PrepareSQLtxt(tmpINVCheck.Specs,"Specs",160)
					ENDIF
					IF cHeat != PrepareSQLtxt(tmpINVCheck.Heat,"Heat",50)
					ENDIF
					*IF cLot != PrepareSQLtxt(tmpINVCheck.Lot,"Lot",10)
					*ENDIF
					*IF nPaid <> PrepareSQLnum(tmpINVCheck.Paid,'Paid',-5)
					*ENDIF
					IF cPOitem != PrepareSQLtxt(tmpINVCheck.PO_item,"PO_item",12)
					ENDIF
					*IF PoDueDate != PrepareSQLdateTime(tmpINVCheck.PoDueDate,"PoDueDate")
					*ENDIF
					IF cMill != PrepareSQLtxt(tmpINVCheck.Mill,"Mill",10)
					ENDIF
					*IF StkDate != PrepareSQLdateTime(tmpINVCheck.StkDate,"StkDate")
					*ENDIF
					IF cHistory != PrepareSQLtxt(tmpINVCheck.History,"History",20)
					ENDIF
					*IF nNum != PrepareSQLnum(tmpINVCheck.Num,"Num",8,0)
					*ENDIF
					IF cPOStatus != PrepareSQLtxt(tmpINVCheck.POStatus,"POStatus",1)
					ENDIF
					IF cBrandName != PrepareSQLtxt(tmpINVCheck.BrandName,"BrandName",20)
					ENDIF
					IF nFROM_ID <> PrepareSQLnum(tmpINVCheck.FROM_ID,'FROM_ID',-3)
					ENDIF
					IF cMelt != PrepareSQLtxt(tmpINVCheck.Melt,"Melt",7)
					ENDIF
					*IF nS_QTY <> PrepareSQLnum(tmpINVCheck.mS_QTY,'mS_QTY',-5)
					*ENDIF
					IF nWO_Detail <> PrepareSQLnum(tmpINVCheck.WO_Detail,'WO_Detail',-3)
					ENDIF
					IF nProjID <> PrepareSQLnum(tmpINVCheck.ProjID,'ProjID',-3)
					ENDIF
		***************************
		*Detail
					*[Size_H]
		      		*[Size_L]
					IF nfPC <> PrepareSQLnum(tmpINVCheck.PC,'PC',-3)
					ENDIF
		      		IF nFthck <> PrepareSQLnum(tmpINVCheck.Dim1,'Dim1',9,4)
					ENDIF
					IF nFSz2 <> PrepareSQLnum(tmpINVCheck.Dim2,'Dim2',8,3)
					ENDIF
					IF nFSz3 <> PrepareSQLnum(tmpINVCheck.Dim3,'Dim3',8,3)
					ENDIF
					*IF cLength != PrepareSQLtxt(tmpINVCheck.Length,"Length",160)
					*ENDIF
					IF nFWeight <> PrepareSQLnum(tmpINVCheck.Weight,'Weight',9,1)
					ENDIF
			      	*,[CostValue]
					*IF cDescript != PrepareSQLtxt(tmpINVCheck.Descript,"Descript",20)
					*ENDIF
					*IF cLocation != PrepareSQLtxt(tmpINVCheck.Location,"Location",10)
					*ENDIF
					*IF cFloorStatus != PrepareSQLtxt(tmpINVCheck.FloorStatus,"FloorStatus",1)
					*ENDIF
					*IF cClass != PrepareSQLtxt(tmpINVCheck.Class,"Class",1)
					*ENDIF
					*IF cUnit != PrepareSQLtxt(tmpINVCheck.Unit,"Unit",6)
					*ENDIF
		      
		      		*,[RandLen]
		      		*,[InvCheck]
			      	*,[ID]
		    	  	*,[ID_Detail]
		      		*,[ReceivingID]
			   		*,[InvoiceValue]
		    	  	*,[LiveCheck]
		      		*,[AccountingCheck]
			      	*,[Quarantine]
			      	IF nS_QTY <> PrepareSQLnum(tmpINVCheck.S_QTY,'S_QTY',-5)
					ENDIF
					*IF nS_P <> PrepareSQLnum(tmpINVCheck.S_P,'S_P',-5)
					*ENDIF
					*IF nS_Total <> PrepareSQLnum(tmpINVCheck.S_Total,'S_Total',-5)
					*ENDIF
					IF nS_PU <> PrepareSQLnum(tmpINVCheck.S_PU,'S_PU',1)
					ENDIF
					*IF lPrime <> PrepareSQLlogic(tmpINVCheck.Prime,'Prime')
					*ENDIF
					IF nWO <> PrepareSQLnum(tmpINVCheck.WO,'WO',-3)
					ENDIF
					
		
		******************
		*Process
					IF cSOitem != PrepareSQLtxt(tmpINVCheck.SOitem,"SOitem",10)
					ENDIF
					IF cPOitem != PrepareSQLtxt(tmpINVCheck.PO_item,"PO_item",12)
					ENDIF
					*IF cSalesPerson != PrepareSQLtxt(tmpINVCheck.SalesPerson,"SalesPerson",20)
					*ENDIF
					*,[StartDate]
					*,[DueDate]
					*IF cComment != PrepareSQLtxt(tmpINVCheck.Comment,"Comment",100)
					*ENDIF
					*IF cProcess_ID != PrepareSQLtxt(tmpINVCheck.Process_ID,"Process_ID",10)
					*ENDIF
					*IF cProcessor != PrepareSQLtxt(tmpINVCheck.Processor,"Processor",20)
					*ENDIF
					*,[AllowSub]
					*,[PWeight]
			      	IF nS_PU <> PrepareSQLnum(tmpINVCheck.PU,'PU',1)
					ENDIF
					IF nS_QTY <> PrepareSQLnum(tmpINVCheck.QTY,'QTY',-5)
					ENDIF
					IF nPounds <> PrepareSQLnum(tmpINVCheck.Pounds,'Pounds',9,1)
					ENDIF
					*IF nID_Detail <> PrepareSQLnum(tmpINVCheck.ID_Detail,'ID_Detail',-3)
					*IF nID_Detail_Process <> PrepareSQLnum(tmpINVCheck.ID_Detail_Process,'ID_Detail_Process',-3)
					*IF nReceivingID <> PrepareSQLnum(tmpINVCheck.ReceivingID,'ReceivingID',-3)
					*ENDIF
					IF nWO <> PrepareSQLnum(tmpINVCheck.WO,'WO',-3)
					ENDIF
					IF nWO_Detail <> PrepareSQLnum(tmpINVCheck.WO_Detail,'WO_Detail',-3)
					ENDIF
					
		*			IF nOrdered_QTY <> PrepareSQLnum(tmpINVCheck.Ordered_QTY,'QTY',-5)	&&ERP Acct Standard
		*			ENDIF
					*PrepareSQLnum(tmpINVCheck.Ordered_QTY,'QTY',-5)	&&ERP Acct Standard incomming QTY
					*PrepareSQLnum(tmpINVCheck.QTY,'QTY',-5)			&&ERP Acct Standard used by Process
					
					*IF nP_QTY <> PrepareSQLnum(tmpINVCheck.Prc_Q_QTY,'QTY',-5)	&&Cust/Vend QTY in  this Process
					*ENDIF
					
					IF cForm2 != PrepareSQLtxt(tmpINVCheck.Prc_Form,"Prc_Form",2)
					ENDIF
					IF nfPC <> PrepareSQLnum(tmpINVCheck.Prc_PCs,'Prc_PCs',-3)
					ENDIF
		      		
					IF nFSz2 <> PrepareSQLnum(tmpINVCheck.Prc_Dim2,'Prc_Dim2',8,3)
					ENDIF
					IF nFSz3 <> PrepareSQLnum(tmpINVCheck.Prc_Dim3,'Prc_Dim3',8,3)
					ENDIF			
		  
				ENDIF	
				USE IN tmpINVCheck
			ENDIF
		ENDIF
		
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE refreshfforms
		PARAMETERS pForm
		*ThisFormSet.RefreshFForms()
		
		IF GetFormCaptions(pForm,ThisFormSet.nConnHandle)
			IF USED('tmpFormCaptions')
				ThisFormSet.frmWorkOrder.lblFThck.Caption 	= RTRIM(tmpFormCaptions.txt1)
				ThisFormSet.frmWorkOrder.lblFSz2.Caption 	= RTRIM(tmpFormCaptions.txt2)
				ThisFormSet.frmWorkOrder.lblFSz2.Visible 	= tmpFormCaptions.lblSz2Vis
				ThisFormSet.frmWorkOrder.lblFSz3.Caption 	= RTRIM(tmpFormCaptions.txt3)
				ThisFormSet.frmWorkOrder.lblFSz3.Visible 	= tmpFormCaptions.lblSz3Vis
				ThisFormSet.frmWorkOrder.txtFSz3.Visible 	= tmpFormCaptions.use3rdDim
				ThisFormSet.frmWorkOrder.txtFSz3.Enabled 	= tmpFormCaptions.Sz3Enable
				ThisFormSet.frmWorkOrder.lblFSz4.Caption	= RTRIM(tmpFormCaptions.txt4)
				ThisFormSet.frmWorkOrder.lblFSz4.Visible 	= tmpFormCaptions.lblSz4Vis
				
				IF NOT tmpFormCaptions.use3rdDim
					ThisFormSet.frmWorkOrder.txtFSz3.Value = 0
				ENDIF
				
				USE IN tmpFormCaptions
			ELSE
				TrackMess( "tmpFormCaptions is not used!")
			ENDIF
		ELSE
			TrackMess("GetFormCaptions returned False!")
		ENDIF
				
	ENDPROC

