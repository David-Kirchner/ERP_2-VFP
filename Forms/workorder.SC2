	PROCEDURE frmWorkOrder.lblAcctCosting.Click
		PRIVATE nAcctCosting_ID
		nAcctCosting_ID = PrepareSQLnum(ThisForm.txtAC_ID_WO.Value,'AC_ID',-3)
		
		IF nAcctCosting_ID > 0
			MESSAGEBOX("The 'Accounting Costing' has already begun.",0,"Return")
			RETURN 
		ENDIF
		
		nAcctCosting_ID = AcctCosting_Start()
		
		PRIVATE nWO 
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		IF nAcctCosting_ID > 0
			IF NOT AcctCosting_WO_Update(nAcctCosting_ID, nWO )
				*Reset
				nAcctCosting_ID = 0
			ENDIF
		ENDIF
		
		IF nAcctCosting_ID > 0
			ThisForm.txtAC_ID_WO.Value = nAcctCosting_ID
			
			SELECT tmpWO
			REPLACE AC_ID_WO WITH nAcctCosting_ID
			
			WAIT WINDOW 'Sent to Accounting' NOWAIT
		ENDIF
	ENDPROC

