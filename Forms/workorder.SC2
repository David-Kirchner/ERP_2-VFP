		*!*		ThisFormset.frmWorkOrder.txtFollowLot.Value	= 0
		*!*		ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
		*!*		ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
		
		*!*		ThisFormset.frmWorkOrder.txtTestPO.Value = ''
		*!*			
		*!*		ThisFormSet.frmWorkOrder.txtfCondLevel.Value = PrepareSQLtxt('','fCondLevel',30)
		*!*		ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(,'StartSize',8,3)
		*!*		ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(,'CW',-1)
		*!*		ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(,'RoughSize',8,3)
		*!*		ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
		
		*!*		ThisFormset.frmWorkOrder.edtfNotes.Value = PrepareSQLtxt(tmpWSO.Comments,'fNotes',-3)
		*!*	*!*		ThisFormset.frmWorkOrder.edtfNotes.Value = ALLTRIM(tmpWSO.Cond_Spec)+CHR(13)+ALLTRIM(tmpPO_POitem.Misc_Purch)
		*!*	*!*		ThisFormSet.frmWorkOrder.txtFPOCompany.Value  = tmpPO_POitem.Company
		*!*		ThisFormSet.frmWorkOrder.txtFPODescript.Value = PrepareSQLtxt(tmpWSO.Descript2,'Descript',100)
		*!*	*!*		ThisFormSet.frmWorkOrder.txtFPOReceived.Value = TTOC( PrepareSQLdate(tmpPO_POitem.Received,'Received'))
		*!*		ThisFormSet.frmWorkOrder.edtFPOCond_Spec.Value = PrepareSQLtxt(tmpWSO.Tol,'Cond_Spec',-1)
		
		
		*!*		ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
		*!*		ThisFormSet.nStock_Projected_ID = 0
		*!*		ThisFormSet.Refresh_Projected()
		*!*		
		*!*		ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0 
		*!*		ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= 0 &&PrepareSQLnum(tmpWO.AC_ID_WOD,'AC_ID',-3)
		*!*		
		*!*		*		IF ThisFormSet.cWhat2 = "START"
		*!*		*			ThisFormSet.frmWorkOrder.txtPOitem.Value	= cPOitem
		*!*		*			ThisFormSet.frmWorkOrder.txtSOitem.Value	= ''
		*!*					ThisFormSet.Refresh_frmWorkOrder_fPOitem("")
		*!*		*		ENDIF
		*!*		*		IF ThisFormSet.cWhat2 = "FINISH"
		*!*		*			ThisFormSet.frmWorkOrder.txtFPOitem.Value	= cPOitem
		*!*		*			ThisFormSet.frmWorkOrder.txtFSOitem.Value	= ''	&&PrepareSQLtxt(tmpPO_POitem.SOitem,'SOitem',10)
		*!*					ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
		*!*		*		ENDIF
		*!*		ThisFormset.frmWorkOrder.txtFDueDate.Value	= PrepareSQLdate(tmpWSO.ShipDue,'ShipDue')
		*!*		ThisFormSet.frmWorkOrder.cmbNextCode.Value	= ''
		*!*		ThisFormSet.frmWorkOrder.txtNextNumber.Value = ''
		
		*!*		ThisFormSet.frmWorkOrder.txtfReceivingID.Value	=	0
		*!*	*	ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')  &&Used on WO and WO_Detail
		*!*		ThisFormSet.frmWorkOrder.chkfCmplt.Value = 0
		
		*!*		ThisFormSet.frmWorkOrder.chkfCncld.Value	= 0
		*!*		ThisFormSet.frmWorkOrder.chkStkListed.Value = 0
		*!*		
		*!*		ThisFormSet.frmWorkOrder.chklPrc_Stock.Value	= 0
		*!*		ThisFormSet.frmWorkOrder.chkStkConsumed.Value	= 0
		
		*!*		IF USED("tmpSS")	
		*!*			USE IN tmpSS
		*!*		ENDIF
		*!*		SELECT 0
		*!*		
		*!*		PRIVATE cSQL, nSQLEXEC 
		*!*		cSQL = "SELECT * "
		*!*		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Weight, RandLen, Metric,'','','') AS Descript"
		*!*		cSQL = cSQL + " FROM dbo.StartingStock WHERE AllQuotes_ID = "+STR(tmpWSO.ID)
		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSS')
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSS')
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSS")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSS")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSS')
		*!*			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*		ENDIF
		*!*		IF USED('tmpSS')
		*!*			IF RECCOUNT('tmpSS') > 0
		*!*				ThisFormset.frmWorkOrder.txtPieces.Value	= tmpSS.Pieces
		*!*				ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpSS.Alloy
		*!*				ThisFormset.frmWorkOrder.cmbForm.Value		= tmpSS.Form
		*!*				ThisFormSet.RefreshForms(tmpWO.sForm)
		*!*				ThisFormset.frmWorkOrder.cmbCC.Value		= tmpSS.CC
		*!*				ThisFormSet.InitcmbCL()
		*!*				ThisFormset.frmWorkOrder.cmbCL.Value		= tmpSS.CL
		*!*				ThisFormset.frmWorkOrder.txtHeat.Value		= ''
		*!*				
		*!*				ThisFormset.frmWorkOrder.txtThck.Value		= tmpSS.thck
		*!*				ThisFormset.frmWorkOrder.txtSz2.Value		= tmpSS.Sz2
		*!*				ThisFormset.frmWorkOrder.txtSz3.Value		= tmpSS.Sz3
		*!*				ThisFormset.frmWorkOrder.txtWeight.Value	= tmpSS.Weight
		*!*				* Descript, comment, SOitem, POitem, RandLen, Metric
		*!*				*ThisFormSet.frmWorkOrder.chkIntP.Value		= 0
		*!*				ThisFormset.frmWorkOrder.txtDescript.Value	= tmpSS.Descript
		*!*				*ThisFormset.frmWorkOrder.edtWO_Notes.Value	= tmpSS.
		*!*				ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
		*!*				ThisFormSet.nStock_Projected_ID = 0
		*!*				ThisFormSet.Refresh_Projected()
		
		*!*				IF Proper_PO_item(tmpWSO.POitem) = Proper_PO_item('')
		*!*					IF Proper_PO_item(tmpSS.POitem) != Proper_PO_item('')
		*!*						ThisFormSet.frmWorkOrder.txtPOitem.Value = Proper_PO_item(tmpSS.POitem)
		*!*					ENDIF
		*!*				ENDIF
		*!*				
		*!*				ThisFormSet.pWhat = "FINISH"
		*!*				
		*!*			ENDIF
		*!*			USE IN tmpSS
		*!*		ENDIF
		*!*		
		*!*		ThisFormset.frmWorkOrder.txtWO.Value 	= GetNextWorkOrder(ThisFormSet.nConnhandle)
		*!*		ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
		*!*		*ThisFormset.frmWorkOrder.txtWO.Enabled = .F.
		*!*		
		*!*		ThisFormSet.Set_frmWorkOrder('ENABLE')
		*!*		
		*!*		RETURN .T.
		*!*	ELSE
		*!*		MESSAGEBOX("Cannot Import!",32,"No Data")
		*!*		RETURN .F.
		*!*	ENDIF
		
		
		
	ENDPROC

