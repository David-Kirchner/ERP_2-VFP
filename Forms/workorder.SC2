		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, StockLst_Qty, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig) AS Descript "
		cSQL = cSQL + ",Received"
		
		cSQL = cSQL + ",Cond_Spec,Misc_Purch"
		*cSQL = cSQL + ",LEFT(Cond_Spec,1000) AS Cond_Spec "
		*cSQL = cSQL + ",LEFT(Misc_Purch,1000) AS Misc_Purch "
		
		cSQL = cSQL + ",Services,ConvServ,Equipment,Reconciled,Stock "
		cSQL = cSQL + " FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
		
		IF USED("tmpWO_FPOitem")	
			USE IN tmpWO_FPOitem
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_FPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_FPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_FPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_FPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_FPOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpWO_FPOitem')
			IF RECCOUNT('tmpWO_FPOitem')>0
		
				PRIVATE cfNotes, cFPOMisc_Purch, cFPOCond_Spec
				cfNotes			= PrepareSQLtxt(ThisForm.edtfNotes.Value,'Misc_Purch',-3)
				*cFPOMisc_Purch	= PrepareSQLtxt(tmpWO_FPOitem.Misc_Purch,'Misc_Purch',-3)
				cFPOCond_Spec 	= PrepareSQLtxt(tmpWO_FPOitem.Cond_Spec,'Cond_Spec',-3)
		
				IF EMPTY(cfNotes)
					ThisForm.edtfNotes.Value = cFPOCond_Spec 
				ELSE
					ThisForm.edtfNotes.Value = cFPOCond_Spec +CHR(13)+cfNotes
				ENDIF
				ThisForm.edtfNotes.Refresh
			ENDIF
			*Do not Close, opened in ThisFormSet.Refresh_frmWorkOrder_FPOitem(pfPOitem)
		ENDIF
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblFSz2.Click
		PRIVATE nPieces, cForm, cAlloy, nThck, nSz2, nSz3, nWeight
		nPieces	= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		
		nThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',8,3)
		nSz2	= PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',8,3)
		nSz3 	= PrepareSQLnum(ThisForm.txtSz3.Value,'Sz3',8,3)
		nWeight	= PrepareSQLnum(ThisForm.txtWeight.Value,'Weight',7,1)
		
		PRIVATE nFPieces, nFThck, nFSz2, nFSz3, nFWeight
		nFPieces= PrepareSQLnum(ThisForm.txtFPieces.Value,'Pieces',-3)
		nFThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',8,3)
		nFSz2	= PrepareSQLnum(ThisForm.txtFSz2.Value,'Sz2',8,3)
		nFSz3 	= PrepareSQLnum(ThisForm.txtFSz3.Value,'Sz3',8,3)
		nFWeight= PrepareSQLnum(ThisForm.txtFWeight.Value,'Weight',7,1)
		
		PRIVATE nStartSize, nCW, nRoughSize, nOverSize, nVolume
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		IF nOverSize  = 0
			nOverSize = .060
			ThisForm.txtOverSize.Value = nOverSize
		ENDIF
		IF nRoughSize = 0
			nRoughSize = nFThck + nOverSize
			ThisForm.txtRoughSize.Value = nRoughSize
		ENDIF
		IF nStartSize = 0
			nStartSize = nThck
		*	ThisForm.txtThck.Value
			ThisForm.txtStartSize.Value = nStartSize 
		ENDIF
		
		nVolume = nPieces * (3.14156*(nThck*nThck)/4) * nSz2
		nFSz2 = nVolume / ( nFPieces * (3.14156*(nRoughSize*nRoughSize)/4) )
		ThisForm.txtfSz2.Value = nFSz2
		ThisFormSet.Calc_Weight('FINISH',.F.)
	ENDPROC

	PROCEDURE frmWorkOrder.lblFWeight.Click
		ThisFormSet.Calc_Weight('FINISH',.F.)
	ENDPROC

	PROCEDURE frmWorkOrder.lblFWeight.DblClick
		PRIVATE nWeight
		nWeight = PrepareSQLnum( ThisForm.txtWeight.Value ,'Weight',9,1)
		
		IF nWeight > 0
		
			PRIVATE lPinWeight
			lPinWeight = PrepareSQLlogic(ThisForm.chkPinFWeight.Value,'PinFWeight')
		
		
			IF lPinWeight
				MESSAGEBOX("Calculated Weight to be "+ALLTRIM(STR(nWeight))+CHR(13)+"Weight will not be updated while 'pinned'",64,"Finish Weight")
			ELSE
				ThisForm.txtFWeight.Value = nWeight 
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE frmWorkOrder.lblLostWeight.Click
		*nLostweight 
		PRIVATE nFWeight,nSWeight,nLostweight 
		nFWeight = PrepareSQLnum(ThisForm.txtFWeight.Value,'Weight',7,1)
		nSWeight = PrepareSQLnum(ThisForm.txtWeight.Value,'weight',7,1)
		nLostweight =  PrepareSQLnum(ThisForm.txtLostWeight.Value,'Weight',7,1)
		
		IF nFWeight > 0 AND nSWeight > 0
			nLostweight = nSWeight - nFWeight 
			IF nLostweight  > 1
				ThisFormset.frmWorkOrder.txtLostWeight.Value = nLostweight 
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblLotSearch.Click
		PRIVATE loHyperlink,m.cHyperLink
		*m.cHyperLink = HTML_MFG_Log(D,1002,.T.) &&lReturnURL --False is an HTML code.
		*https://raptor/ReportServer/Pages/ReportViewer.aspx?%2fMFG+Log%2fMFG+CC+CL+Search&rs:Command=Render&Alloy=HPA+N60&CC=7&CL=3&fSize=1
		
		PRIVATE cAlloy, cCC, cCL, nfSize
		cAlloy = PrepareSQLtxt(This.Parent.txtfAlloy.Value,'Alloy',12)
		cCC = PrepareSQLtxt(This.Parent.cmbFcc.Value,'CC',1)
		cCL = PrepareSQLtxt(This.Parent.cmbfCL.Value,'CL',1)
		nfSize = PrepareSQLnum(This.Parent.txtfThck.Value,'Thck',9,3)
		
		cHyperLink = HTML_MFG_CC_CL_Search(cAlloy, cCC, cCL, nfSize, .T.)
		
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(m.cHyperLink)
		RELEASE loHyperlink
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblOverSize.Click
		PRIVATE nfThck, nRoughSize, nOverSize
		nfThck		= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',8,3)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		IF nOverSize = 0
			IF nRoughSize > 0 AND nfThck > 0 AND nRoughSize > nfThck 
				nOverSize = nRoughSize - nfThck
				ThisForm.txtOverSize.Value = PrepareSQLnum(nOverSize,'OverSize',5,3)
			ENDIF
		ELSE
			IF nRoughSize = 0
				IF nfThck > 0 
					nRoughSize = nOverSize + nfThck
					ThisForm.txtRoughSize.Value = PrepareSQLnum(nRoughSize,'RoughSize',8,3)
				ENDIF
			ELSE
				*have OverSize and RoughSize
				IF nfThck = 0
					nfThck = nRoughSize - nOverSize 
					ThisForm.txtFThck.Value = PrepareSQLnum(nfThck,'Thck',8,3)
				ENDIF
			ENDIF
		ENDIF
		
		***Check if numbers add up.
		IF nOverSize > 0
			PRIVATE nCalcRoughSize, nCalcfThck
			IF nRoughSize > 0
				nCalcfThck = nRoughSize - nOverSize 
			ENDIF
			IF nfThck > 0
				nCalcRoughSize = nfThck + nOverSize 
			ENDIF
			
			IF nRoughSize > 0 AND nfThck > 0
				IF (nCalcfThck+10)*.9 < (nfThck+10) OR (nCalcfThck+10) > (nfThck+10)*.9
					*Within 10%
				ELSE
					MESSAGEBOX("Thck/Diameter "+ALLTRIM(STR(nfThck,9,3))+CHR(13)+" is more than 10% different than "+CHR(13)+" RoughSize - OverSize "+ALLTRIM(STR(nCalcfThck,9,3))+CHR(13)+"Please correct one of these numbers.",0+48,"Numbers do not Calculate.")
				ENDIF
				
				IF (nCalcRoughSize+10)*.9 < (nRoughSize+10) OR (nCalcRoughSize+10) > (nRoughSize+10)*.9
					*Within 10%
				ELSE
					MESSAGEBOX("Rough Size "+ALLTRIM(STR(RoughSize,9,3))+CHR(13)+" is more than 10% different than "+CHR(13)+" Thck + OverSize "+ALLTRIM(STR(nCalcRoughSize,9,3))+CHR(13)+"Please correct one of these numbers.",0+48,"Numbers do not Calculate.")
				ENDIF
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmWorkOrder.lblPieces.Click
		ThisFormSet.Calc_Piece('START')
	ENDPROC

