	PROCEDURE newwo
		PARAMETERS cParameter
		*ThisformSet.NewWO('NEW')
		*pWhat is a Parameter passed on Init.
		*ThisFormSet.pWhat = "START"	ThisFormSet.NewWO_byHPASO_Start() ThisFormSet.NewSO_bySO_Start()
		*ThisFormSet.pWhat = "FINISH"	ThisFormSet.NewWO_byPO_Finish()	ThisFormSet.NewWO_byHPASO_Finish() 
		*								InitWO_Detail_Start()	&&Clears WO_Detail Data
		
		IF VARTYPE(cParameter) != "C"
			cParameter = 'NEW'
		ENDIF
		
		*ThisFormSet.InitWO_Detail_Start()	&&Clears WO_Detail Data
		*ThisFormSet.frmWorkOrder.txtWO_Detail.Value = GetNextWorkOrder_Detail(ThisFormSet.nConnHandle)
		PRIVATE nWO, nWO_Detail
		nWO = 0
		nWO_Detail = 0
		
		IF USED('tmpWO_WOD')
			USE IN tmpWO_WOD
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT WO.*, WOD.* "
		cSQL = cSQL + ", ISNULL(ACWO.AC_ID,0) AS AC_ID_WO "
		cSQL = cSQL + ", ISNULL(ACWOD.AC_ID,0) AS AC_ID_WOD "
		cSQL = cSQL + " FROM dbo.WorkOrder WO "
		cSQL = cSQL + " INNER JOIN dbo.WorkOrder_Detail WOD ON WO.WO = WOD.WO "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WO ACWO ON WO.WO = ACWO.WO "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WOD ACWOD ON WOD.WO_Detail = ACWOD.WO_Detail "
		
		IF UPPER(cParameter) = 'NEW'
			cSQL = cSQL + " WHERE 0>0"
		ELSE
			*UPPER(cParameter) = 'CLONE'
			
			nWO = PrepareSQLnum(ThisFormset.frmChooseWO.txtWO.Value,'WO',-3)
			nWO_Detail = PrepareSQLnum(ThisFormset.frmChooseWO.txtWO_Detail.Value,'WO_Detail',-3)
			
			cSQL = cSQL + " WHERE WO.WO = "+ALLTRIM(STR(nWO))
			cSQL = cSQL + " AND WOD.WO_Detail = "+ALLTRIM(STR(nWO_Detail))
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_WOD')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_WOD')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_WOD")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_WOD")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_WOD')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_WOD')
				
				nWO	= GetNextWorkOrder(ThisFormSet.nConnhandle)
				ThisFormset.frmWorkOrder.txtWO.Value 		= nWO
				ThisFormSet.nWO 							= nWO
		
				ThisFormset.frmWorkOrder.txtWO.Enabled = .F.
		
				ThisFormset.frmWorkOrder.txtPieces.Value	= tmpWO_WOD.sPieces
				ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpWO_WOD.sAlloy
				ThisFormset.frmWorkOrder.cmbForm.Value		= tmpWO_WOD.sForm
				ThisFormSet.RefreshForms(tmpWO_WOD.sForm)
				ThisFormset.frmWorkOrder.cmbCC.Value		= tmpWO_WOD.sCC
				ThisFormSet.InitcmbCL()
				ThisFormset.frmWorkOrder.cmbCL.Value		= tmpWO_WOD.sCL
				ThisFormset.frmWorkOrder.txtHeat.Value		= tmpWO_WOD.sHeat
				
				ThisFormset.frmWorkOrder.txtThck.Value		= tmpWO_WOD.sThck
				ThisFormset.frmWorkOrder.txtSz2.Value		= tmpWO_WOD.sSz2
				ThisFormset.frmWorkOrder.txtSz3.Value		= tmpWO_WOD.sSz3
				ThisFormSet.frmWorkOrder.chkPinSWeight.Value	= PrepareSQLchk(tmpWO_WOD.pinSWeight,'pinSWeight')
				ThisFormset.frmWorkOrder.txtWeight.Value	= tmpWO_WOD.sWeight
				*ThisFormSet.frmWorkOrder.txtID_Detail.Value = tmpWO_WOD.sID_Detail
				*ThisFormSet.frmWorkOrder.txtID_Detail_Process.Value = tmpWO_WOD.sID_Detail_Process
				*
				*ThisFormset.frmWorkOrder.txtStartDate.Value	= PrepareSQLdate(tmpWO_WOD.StartDate,'StartDate')
				ThisFormset.frmWorkOrder.txtStartDate.Value	= DATE()
				ThisFormset.frmWorkOrder.txtDueDate.Value	= PrepareSQLDate('','DueDate') &&PrepareSQLDate(tmpWO_WOD.DueDate,'DueDate')
				*ThisFormSet.frmWorkOrder.chkIntP.Value		= PrepareSQLchk(tmpWO_WOD.IntP,'IntP')
				ThisFormSet.frmWorkOrder.chkRE.Value		= PrepareSQLchk(0,'RE') &&PrepareSQLchk(tmpWO_WOD.RE,'RE')
				ThisFormset.frmWorkOrder.chkCmplt.Value		= PrepareSQLchk(0,'Cmplt') &&PrepareSQLchk(tmpWO_WOD.Cmplt,'Cmplt')
				ThisFormset.frmWorkOrder.chkCncld.Value		= PrepareSQLchk(0,'Cncld') &&PrepareSQLchk(tmpWO_WOD.Cncld,'Cncld')
						
				ThisFormset.frmWorkOrder.txtDescript.Value	= tmpWO_WOD.Descript
				ThisFormset.frmWorkOrder.edtWO_Notes.Value	= tmpWO_WOD.Notes
				
				ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= PrepareSQLnum(tmpWO_WOD.AC_ID_WO,'AC_ID',-3)
				ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpWO_WOD.SOitem,'SOitem',10)
				ThisFormSet.frmWorkOrder.txtPOitem.Value	= PrepareSQLtxt(tmpWO_WOD.POitem,'POitem',12)
				ThisFormset.frmWorkOrder.txtSalesRep.Value	= tmpWO_WOD.SalesRep
		
				ThisFormSet.frmWorkOrder.chklPrc_Stock.Value	= 0
				ThisFormSet.frmWorkOrder.chkStkConsumed.Value	= 0
		
				*FINISH
				IF cParameter = 'NEW'
					ThisFormSet.InitWO_Detail('NEW')
				ELSE
					ThisFormSet.InitWO_Detail('CLONE')
				ENDIF
				
				nWO_Detail = GetNextWorkOrder_Detail(ThisFormSet.nConnHandle)		
				ThisFormSet.frmWorkOrder.txtWO_Detail.Value = nWO_Detail
				
				ThisformSet.Load_lst_WO_Detail(nWO)
				
				ThisFormSet.Set_frmWorkOrder('ENABLE')
				
				USE IN tmpWO_WOD
			ENDIF
		ENDIF.
		
	ENDPROC

