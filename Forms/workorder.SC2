	PROCEDURE addbypo_so_dist
		PARAMETERS cPOitem, cSOitem, pWhatEver
		*ThisForm.AddbyPO_SO_Dist
		
		*pWhatEver is nID_PO_SODist
		PRIVATE nID_PO_SODist
		nID_PO_SODist = PrepareSQLnum(pWhatever,'ID_PO_SODist',-3)
		
		PRIVATE cPOitem,cSOitem
		cPOitem = Proper_PO_Item(cPOitem)
		cSOitem = Proper_SO_Item(cSOitem)
		
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item('')
			RETURN .F.
		ENDIF
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item('')
			RETURN .F.
		ENDIF
		IF nID_PO_SODist = 0
			RETURN .f.
		ENDIF
		
		
		PRIVATE nWO
		nWO = ThisFormSet.nWO
		
		*Check POitem, See if they meant to Edit.
		PRIVATE lFoundPOitem, lCreateWO
		lFoundPOitem 	= .F.
		lCreateWO		= .T.
		
		IF USED("tmpWOcnt")	
			USE IN tmpWOcnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.PO_SOdist "
		cSQL = " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = " AND SOitem = dbo.f_ProperSOItem('"+cSOitem+"')"
		IF nWO > 0
			cSQL = cSQL + " AND WO <> "+STR(nWO)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOcnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOcnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOcnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOcnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOcnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOcnt')
				IF tmpWOcnt.Cnt > 0
					lFoundPOitem = .T.
				ENDIF
				USE IN tmpWOcnt
			ENDIF
		ENDIF
		
		IF lFoundPOitem
			*Show WO screen with POitem and Ask if they want to Edit That.
			IF MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was Found in another WO."+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+"Answer No to continue with adding"+CHR(13)+"this PO item to this WO.",4+32,"Edit old WO?") = 6
				ThisFormSet.EditbyPO_SODist(cPOitem,cSOitem, pWhatEver)
				RETURN
			ENDIF
		ENDIF
		
		*Use POitem to Create WO
		PRIVATE lFoundPOiteminPO, lFoundSOiteminPO 
		lFoundPOiteminPO = .F.
		lFoundSOiteminPO = .F.
		
		IF USED("tmpPOcnt")	
			USE IN tmpPOcnt
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOcnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPOcnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOcnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOcnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOcnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPOcnt')
				IF tmpPOcnt.Cnt > 0
					lFoundPOiteminPO = .T.
				ENDIF
				USE IN tmpPOcnt
			ENDIF
		ENDIF
		
		
		IF NOT lFoundPOiteminPO
			MESSAGEBOX("Did not find POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrder table!",16,"Data not found!")
			RETURN .F.
		ENDIF
		
		IF USED("tmpPOcnt")	
			USE IN tmpPOcnt
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.PurchaseOrder WHERE SOitem = dbo.f_ProperSOItem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOcnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPOcnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOcnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOcnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOcnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPOcnt')
				IF tmpPOcnt.Cnt > 0
					lFoundSOiteminPO = .T.
				ENDIF
				USE IN tmpPOcnt
			ENDIF
		ENDIF
		
		IF lFoundSOiteminPO 
			*Get PurchaseOrder Info
			
			IF USED("tmpPO_SOi")	
				USE IN tmpPO_SOi
			ENDIF
			SELECT 0
		
			cSQL = "SELECT * "
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Pounds, RandLen, Metric,'','','') AS Descript "
			cSQL = cSQL + ",dbo.f_BestDate(dbo.f_BestDate(Due_Min,Due_Max),dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max)) AS DueDate "
			cSQL = cSQL + ",Cond_Spec"
			cSQL = cSQL + "	FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL = cSQL + "	AND SOitem = dbo.f_ProperSOItem('"+cSOitem+"')"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_SOi')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_SOi')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_SOi")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_SOi")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_SOi')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpPO_SOi')
					IF VARTYPE(tmpPO_SOi.HPAPO) = 'N'
						ThisFormset.frmWorkOrder.txtPieces.Value 	= tmpPO_SOi.Pieces
						ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpPO_SOi.Alloy
						ThisFormset.frmWorkOrder.cmbForm.Value		= tmpPO_SOi.Form
						ThisFormSet.RefreshForms(tmpPO_SOi.Form)
						ThisFormset.frmWorkOrder.cmbCC.Value		= tmpPO_SOi.CC
						ThisFormSet.InitcmbCL()
						ThisFormset.frmWorkOrder.cmbCL.Value		= tmpPO_SOi.CL
						ThisFormset.frmWorkOrder.txtHeat.Value		= ''
						
						ThisFormset.frmWorkOrder.txtThck.Value		= tmpPO_SOi.Thck
						ThisFormset.frmWorkOrder.txtSz2.Value		= tmpPO_SOi.Sz2
						ThisFormset.frmWorkOrder.txtSz3.Value		= tmpPO_SOi.Sz3
						ThisFormset.frmWorkOrder.txtWeight.Value 	= tmpPO_SOi.Pounds
						*
						ThisFormSet.frmWorkOrder.txtStartDate.Value	= DATE()
						*ThisFormSet.frmWorkOrder.chkIntP.Value		= PrepareSQLlogic(tmpPO_SOi.IntP,'IntP')
						ThisFormset.frmWorkOrder.txtDescript.Value 	= tmpPO_SOi.Descript 
						ThisFormset.frmWorkOrder.edtWO_Notes.Value 	= ALLTRIM(tmpPO_SOi.Cond_Spec)+CHR(13)+ALLTRIM(tmpPO_SOi.Misc_Purch)
						
						ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0 
						
						IF ThisFormSet.cWhat2 == '' OR ThisFormSet.cWhat2 = "START"
							ThisFormSet.frmWorkOrder.txtPOitem.Value	= cPOitem 
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpPO_SOi.SOitem,'SOitem',10)
						ELSE
							ThisFormSet.frmWorkOrder.txtPOitem.Value	= ''
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= ''
						ENDIF
						
						*Why does tmpWO_WOD stop being used and tmpPO_POitem start!!!!!
						
						ThisFormSet.frmWorkOrder.txtSalesRep.Value	= AppSetup_Get_SalesRep_SalesP(tmpPO_POitem.SalesP)
						*
						ThisFormset.frmWorkOrder.txtFPieces.Value 	= tmpPO_POitem.Pieces
						ThisFormset.frmWorkOrder.txtFAlloy.Value	= tmpPO_POitem.Alloy
						ThisFormset.frmWorkOrder.cmbFForm.Value		= tmpPO_POitem.Form
						ThisFormSet.RefreshFForms(tmpPO_POitem.Form)
						ThisFormset.frmWorkOrder.cmbFcc.Value		= tmpPO_POitem.CC
						ThisFormSet.InitcmbFCL()
		
						ThisFormset.frmWorkOrder.cmbFCL.Value		= tmpPO_POitem.CL
						ThisFormset.frmWorkOrder.txtFThck.Value		= tmpPO_POitem.Thck
						ThisFormset.frmWorkOrder.txtFSz2.Value		= tmpPO_POitem.Sz2
						ThisFormset.frmWorkOrder.txtFSz3.Value		= tmpPO_POitem.Sz3
						ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= 0
						ThisFormset.frmWorkOrder.txtfWeight.Value 	= tmpPO_POitem.Pounds
						ThisFormset.frmWorkOrder.txtFSpec.Value		= ''
						ThisFormset.frmWorkOrder.txtFDescript.Value = tmpPO_POitem.Descript
						ThisFormset.frmWorkOrder.txtfCondLevel.Value= ConditionLevelText(tmpPO_POitem.CC,tmpPO_POitem.CL)
						
						ThisFormset.frmWorkOrder.cmbFollowM.Value	= ''
						ThisFormset.frmWorkOrder.txtFollowLot.Value	= 0
						ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
						ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
						
						ThisFormset.frmWorkOrder.txtTestPO.Value = ''
						
						ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(0,'StartSize',8,3)
						ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(0,'CW',-1)
						ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(0,'RoughSize',8,3)
						ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
						
						ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
						ThisFormSet.nStock_Projected_ID = 0
						ThisFormSet.Refresh_Projected()
						
						ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= 0 
						
						IF ThisFormSet.cWhat2 == '' OR ThisFormSet.cWhat2 = "START"
							ThisFormSet.frmWorkOrder.txtFPOitem.Value	= ''
							ThisFormSet.frmWorkOrder.txtFSOitem.Value	= ''
							ThisFormSet.Refresh_frmWorkOrder_fPOitem("")
						ELSE				
							ThisFormSet.frmWorkOrder.txtPOitem.Value	= cPOitem 
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpPO_POitem.SOitem,'SOitem',10)
							ThisFormSet.Refresh_frmWorkOrder_FPOitem(cPOitem)
						ENDIF
						
						ThisFormSet.frmWorkOrder.txtDueDate.Value	= PrepareSQLDate(tmpPO_POitem.DueDate,'DueDate')
		
						IF ThisFormset.frmWorkOrder.txtWO.Value = 0
							ThisFormset.frmWorkOrder.txtWO.Value = GetNextWorkOrder(ThisFormSet.nConnhandle)
							ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
						ENDIF
						
						IF ThisFormSet.CheckFinish_ID_Detail()
						ENDIF
						IF ThisFormSet.CheckFinish_ID_Detail_Process()
						ENDIF
						
						ThisFormSet.Set_frmWorkOrder('ENABLE')
						
						*ThisFormSet.CheckPOitemProcess()
						
						PRIVATE cMess
						cMess = "The PO was found and the WO screen has this data."
						IF ThisFormSet.cWhat2 == '' 
							cMess = cMess + CHR(13)+"The program assumes the PO would create the Finish sizes of this WO."
							cMess = cMess + CHR(13)+"The start sizes have also been filled, but need to be changed"
							cMess = cMess + CHR(13)+"if this is a Size Conversion PO."
						ENDIF
						IF ThisFormSet.cWhat2 = 'START' 
							cMess = cMess + CHR(13)+"The Start sizes have also been filled."
						ENDIF
						IF ThisFormSet.cWhat2 = 'FINISH' 
							cMess = cMess + CHR(13)+"The Finish sizes have also been filled."
						ENDIF
						MESSAGEBOX(cMess,0+64,"WO is ready ot Edit")
						
					ENDIF
					USE IN tmpPO_POitem
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE addbysoitem
		PARAMETERS pPOitem, pSOitem, pWhatEver
		*ThisFormSet.AddbySOitem(pPOitem,pSOitem, pWhatEver)
		
		PRIVATE cSOitem
		cSOitem = Proper_SO_Item(pSOitem)
		
		IF Proper_SO_Item(pSOitem) = Proper_SO_Item('')
			RETURN .F.
		ENDIF
		
		PRIVATE nWO
		nWO = PrepareSQLnum(ThisFormSet.frmWorkorder.txtWO.Value,'WO',-3)
		
		*Check SOitem, See if they meant to Edit.
		PRIVATE lFoundSOitem, lCreateWO
		lFoundSOitem 	= .F.
		lCreateWO		= .T.
		
		IF USED("cntWO_SOitem")	
			USE IN cntWO_SOitem
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		IF nWO > 0
			cSQL = cSQL + " AND WO<>"+STR(nWO)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntWO_SOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'cntWO_SOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO_SOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO_SOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntWO_SOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('cntWO_SOitem')
				IF cntWO_SOitem.Cnt > 0
					lFoundSOitem = .T.
				ENDIF
				USE IN cntWO_SOitem
			ENDIF
		ENDIF
		
		IF lFoundSOitem
			*Show WO screen with SOitem and Ask if they want to Edit That.
			IF MESSAGEBOX("SO Item:"+ALLTRIM(cSOitem)+" was Found in another WO."+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+"Answer No to continue with adding"+CHR(13)+"this SO item to this WO.",4+32,"Edit old WO?") = 6
				ThisFormSet.EditbySOitem(pSOitem)
				RETURN
			ENDIF
		ENDIF
		
		*Use SOitem to Create WO
		PRIVATE lFoundSOiteminSales
		lFoundSOiteminSales = .F.
		
		IF USED("cntWO_SOitem")	
			USE IN cntWO_SOitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.Sales WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntWO_SOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'cntWO_SOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO_SOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO_SOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntWO_SOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('cntWO_SOitem')
				IF cntWO_SOitem.Cnt > 0
					lFoundSOiteminSales = .T.
				ENDIF
				USE IN cntWO_SOitem
			ENDIF
		ENDIF
		
		
		IF NOT lFoundSOiteminSales
			MESSAGEBOX("Did not find SOitem:"+ALLTRIM(cSOitem)+" in Sales table!",16,"Data not found!")
			RETURN .F.
		ENDIF
		
		
		IF lFoundSOiteminSales 
			*Get Sales Info
			
			
			IF USED("tmpSO_SOitem")	
				USE IN tmpSO_SOitem
			ENDIF
			SELECT 0
			cSQL = "SELECT Pieces,Alloy,Form,CC,CL,Thck,Sz2,Sz3,Weight "
			cSQL = cSQL + ",S.SOitem,S.SalesNum "
			cSQL = cSQL + ",S.S_QTY, AQ.SalesP "
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, weight, RandLen, Metric,'','','') AS Descript "
			cSQL = cSQL + ",dbo.f_BestDate(dbo.f_BestDate(Shipped,ShipDue),dbo.f_BestDate(shipdate,saledate)) AS DueDate "
			cSQL = cSQL + ",OrderSpec,S_Instrct "
			cSQL = cSQL + " FROM dbo.Sales S "
			cSQL = cSQL + " INNER JOIN dbo.AllQuotes AQ ON AQ.Soitem = S.SOitem "
			cSQL = cSQL + " WHERE S.SOitem ='"+cSOitem+"'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_SOitem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSO_SOitem')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSO_SOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSO_SOitem")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSO_SOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpSO_SOitem')
					IF VARTYPE(tmpSO_SOitem.SalesNum) = 'N'
						ThisFormset.frmWorkOrder.txtPieces.Value 	= tmpSO_SOitem.Pieces
						ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpSO_SOitem.Alloy
						ThisFormset.frmWorkOrder.cmbForm.Value		= tmpSO_SOitem.Form
						ThisFormSet.RefreshForms(tmpSO_SOitem.Form)
						ThisFormset.frmWorkOrder.cmbCC.Value		= tmpSO_SOitem.CC
						ThisFormSet.InitcmbCL()
						ThisFormset.frmWorkOrder.cmbCL.Value		= tmpSO_SOitem.CL
						ThisFormset.frmWorkOrder.txtHeat.Value		= ''
						
						ThisFormset.frmWorkOrder.txtThck.Value		= tmpSO_SOitem.Thck
						ThisFormset.frmWorkOrder.txtSz2.Value		= tmpSO_SOitem.Sz2
						ThisFormset.frmWorkOrder.txtSz3.Value		= tmpSO_SOitem.Sz3
						ThisFormSet.frmWorkOrder.chkPinSWeight.Value	= 0
						ThisFormset.frmWorkOrder.txtWeight.Value 	= tmpSO_SOitem.Weight 
						*
						ThisFormSet.frmWorkOrder.txtStartDate.Value	= DATE()
						*ThisFormSet.frmWorkOrder.chkIntP.Value		= PrepareSQLlogic(0,'IntP')
						ThisFormSet.frmWorkOrder.chkRE.Value		= PrepareSQLlogic(0,'RE')
						ThisFormset.frmWorkOrder.txtDescript.Value 	= tmpSO_SOitem.Descript 
						ThisFormset.frmWorkOrder.edtWO_Notes.Value 	= ALLTRIM(tmpSO_SOitem.OrderSpec)+CHR(13)+ALLTRIM(tmpSO_SOitem.S_Instrct)
						
						ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0 
						
						IF ThisFormSet.cWhat2 = "START"
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= cSOitem 
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpSO_SOitem.SOitem,'SOitem',10)
						ELSE
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= '' &&cSOitem 
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= '' &&PrepareSQLtxt(tmpSO_SOitem.SOitem,'SOitem',10)				
						ENDIF
						
						ThisFormSet.frmWorkOrder.txtSalesRep.Value	= AppSetup_Get_SalesRep_SalesP(tmpSO_SOitem.SalesP)
						*
						ThisFormset.frmWorkOrder.txtFPieces.Value 	= tmpSO_SOitem.Pieces
						ThisFormset.frmWorkOrder.txtFAlloy.Value	= tmpSO_SOitem.Alloy
						ThisFormset.frmWorkOrder.cmbFForm.Value		= tmpSO_SOitem.Form
						ThisFormSet.RefreshFForms(tmpSO_SOitem.Form)
						ThisFormset.frmWorkOrder.cmbFcc.Value		= tmpSO_SOitem.CC
						ThisFormSet.InitcmbFCL()
		
						ThisFormset.frmWorkOrder.cmbFCL.Value		= tmpSO_SOitem.CL
						ThisFormset.frmWorkOrder.txtFThck.Value		= tmpSO_SOitem.Thck
						ThisFormset.frmWorkOrder.txtFSz2.Value		= tmpSO_SOitem.Sz2
						ThisFormset.frmWorkOrder.txtFSz3.Value		= tmpSO_SOitem.Sz3
						ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= 0
						ThisFormset.frmWorkOrder.txtfWeight.Value 	= tmpSO_SOitem.weight
						ThisFormset.frmWorkOrder.txtFSpec.Value		= ''
						ThisFormset.frmWorkOrder.txtFDescript.Value = tmpSO_SOitem.Descript
						ThisFormset.frmWorkOrder.txtfCondLevel.Value= ConditionLevelText(tmpSO_SOitem.CC,tmpSO_SOitem.CL)
						
						ThisFormset.frmWorkOrder.cmbFollowM.Value	= ''
						ThisFormset.frmWorkOrder.txtFollowLot.Value	= 0
						ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
						ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
						
						ThisFormset.frmWorkOrder.txtTestPO.Value = ''
						
						ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(0,'StartSize',8,3)
						ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(0,'CW',-1)
						ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(0,'RoughSize',8,3)
						ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
						
						ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
						ThisFormSet.nStock_Projected_ID = 0
						ThisFormSet.Refresh_Projected()
		
						ThisFormSet.frmWorkOrder.chklPrc_Stock.Value	= 0
						ThisFormSet.frmWorkOrder.chkStkConsumed.Value	= 0
						
						ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= 0 &&PrepareSQLnum(tmpWO.AC_ID_WOD,'AC_ID',-3)
						
						IF ThisFormSet.cWhat2 = "START"
							*ThisFormSet.frmWorkOrder.txtFSOitem.Value	= ''
							ThisFormSet.frmWorkOrder.txtFSOitem.Value	= ''
		*					ThisFormSet.Refresh_frmWorkOrder_fPOitem("")
						ELSE
							*ThisFormSet.frmWorkOrder.txtFSOitem.Value	= cSOitem
							ThisFormSet.frmWorkOrder.txtFSOitem.Value	= PrepareSQLtxt(tmpSO_SOitem.SOitem,'SOitem',10)				
		*					ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
						ENDIF
						
						*ThisFormSet.Refresh_frmWorkOrder_POitem("")
						ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
			
						ThisFormSet.frmWorkOrder.txtDueDate.Value	= PrepareSQLDate(tmpSO_SOitem.DueDate,'DueDate')
		
						IF ThisFormset.frmWorkOrder.txtWO.Value = 0
							ThisFormset.frmWorkOrder.txtWO.Value = GetNextWorkOrder(ThisFormSet.nConnhandle)
							ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
						ENDIF
						
						IF ThisFormSet.CheckFinish_ID_Detail()
						ENDIF
						IF ThisFormSet.CheckFinish_ID_Detail_Process()
						ENDIF
						
						ThisFormSet.Set_frmWorkOrder('ENABLE')
						
						*ThisFormSet.CheckSOitemProcess()
						
						PRIVATE cMess
						cMess = "The SO was found and the WO screen has this data."
						IF ThisFormSet.cWhat2 == ""
							cMess = cMess + CHR(13)+"The program assumes the SO would create the Finish sizes of this WO."
							cMess = cMess + CHR(13)+"The start sizes have also been filled, but need to be changed"
							cMess = cMess + CHR(13)+"if this is a Size Conversion SO."
						ELSE
							IF ThisFormSet.cWhat2 = "START"
								cMess = cMess + CHR(13)+"The Start sizes have also been filled!"
							ENDIF
							IF ThisFormSet.cWhat2 = "FINISH"
								cMess = cMess + CHR(13)+"The Finish sizes have also been filled!"
							ENDIF
						ENDIF
		*				cMess = cMess + CHR(13)+CHR(13)+"Make sure you"
						MESSAGEBOX(cMess,0+64,"WO is ready to Edit")
						
					ENDIF
					USE IN tmpSO_SOitem
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE addbysoitemss
		PARAMETERS pSOitem, pWhatEver
		*ThisFormSet.AddBySOitemSS()
		
		PRIVATE cSOitem
		cSOitem = Proper_SO_Item(pSOitem)
		
		IF Proper_SO_Item(pSOitem) = Proper_SO_Item('')
			RETURN .F.
		ENDIF
		
		
		PRIVATE lFoundSOitem
		lFoundSOitem 	= .F.
		
		IF USED("tmpSOitemSS")	
			USE IN tmpSOitemSS
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.StartingStock WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*SELECT * FROM dbo.StartingStock WHERE SOitem = ' 101523-01'
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitemSS')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSOitemSS')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitemSS")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitemSS")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitemSS')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpSOitemSS')
				IF tmpSOitemSS.Cnt > 0
					lFoundSOitem = .T.
				ENDIF
				USE IN tmpSOitemSS
			ENDIF
		ENDIF
		
		IF lFoundSOitem
		
			*DO FORM Forms\ShowStartingStock WITH cSOitem TO lUseData
			*Show SS screen with SOitem and Ask if they want to use that data.
			
			IF USED("tmpSOitemSS")	
				USE IN tmpSOitemSS
			ENDIF
			SELECT 0
		
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "SELECT Alloy,[Form],[CC],[CL],[Pieces],[Thck],[Sz2],[Sz3] "
		    cSQL = cSQL + ",[Weight],[Descript],[Comment],[InqNumP],[SOitem],[POitem]"
			cSQL = cSQL + ",[RandLen],[Metric]"
			cSQL = cSQL + " FROM dbo.StartingStock "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitemSS')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSOitemSS')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitemSS")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSOitemSS")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitemSS')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpSOitemSS')
					IF RECCOUNT('tmpSOitemSS') > 0
						ThisFormset.frmStartingStock.txtPieces.Value 	= tmpSOitemSS.Pieces
						ThisFormset.frmStartingStock.txtAlloy.Value		= tmpSOitemSS.Alloy
						ThisFormset.frmStartingStock.txtForm.Value		= tmpSOitemSS.Form
		*				ThisFormSet.RefreshForms(tmpSOitemSS.Form)
						ThisFormset.frmStartingStock.txtCC.Value		= tmpSOitemSS.CC
						ThisFormset.frmStartingStock.txtCL.Value		= tmpSOitemSS.CL
						ThisFormset.frmStartingStock.txtThck.Value		= tmpSOitemSS.Thck
						ThisFormset.frmStartingStock.txtSz2.Value		= tmpSOitemSS.Sz2
						ThisFormset.frmStartingStock.txtSz3.Value		= tmpSOitemSS.Sz3
						ThisFormset.frmStartingStock.txtWeight.Value 	= tmpSOitemSS.Weight
						*
						ThisFormset.frmStartingStock.txtDescript.Value 	= tmpPO_POitem.Descript
						ThisFormset.frmStartingStock.txtComment.Value 	= tmpPO_POitem.Comment
						ThisFormset.frmStartingStock.txtSOitem.Value 	= tmpPO_POitem.SOitem
						ThisFormset.frmStartingStock.txtPOitem.Value 	= tmpPO_POitem.POitem
						
						ThisFormset.frmStartingStock.Visible = .T.
						
					ENDIF
					USE IN tmpSOitemSS
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE addwodbypoitem
		PARAMETERS pPOitem, pSOitem, pWhatEver
		*ThisFormSet.AddWODbyPOitem(cPOitem, cSOitem, pWhatEver)
		*-- depricated
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item(pPOitem)
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			RETURN .F.
		ENDIF
		
		*************************************
		*Count POitem in PurchaseOrder
		PRIVATE lFoundPOiteminPO
		lFoundPOiteminPO = .F.
		
		IF USED("tmpPO_cnt")	
			USE IN tmpPO_cnt
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_cnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_cnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_cnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_cnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_cnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPO_cnt')
				IF tmpPO_cnt.Cnt > 0
					lFoundPOiteminPO = .T.
				ENDIF
				USE IN tmpPO_cnt
			ENDIF
		ENDIF
		
		
		IF NOT lFoundPOiteminPO
			MESSAGEBOX("Did not find POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrder table!",16,"Data not found!")
			RETURN .F.
		ENDIF
		
		*********************************************
		*Check POitem in WorkOrder, See if they meant to Edit.
		PRIVATE lFoundPOitem, lCreateWO
		lFoundPOitem 	= .F.
		lCreateWO		= .T.
		
		IF USED("tmpWO_POitemCnt")	
			USE IN tmpWO_POitemCnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND ISNULL(Cncld,0) = 0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_POitemCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_POitemCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_POitemCnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_POitemCnt')
				IF tmpWO_POitemCnt.Cntd > 0
					lFoundPOitem = .T.
				ENDIF
				USE IN tmpWO_POitemCnt
			ENDIF
		ENDIF
		
		IF lFoundPOitem
			*Show WO screen with POitem and Ask if they want to Edit That.
			IF MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was Found in another WO."+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+"Answer No to continue with adding"+CHR(13)+"this PO item to this WO.",4+32,"Edit old WO?") = 6
				ThisFormSet.EditbyPOitem(pPOitem)
				RETURN
			ENDIF
		ENDIF
		
		**********************************************
		*Check POitem in WorkOrder_Detail, See if they meant to Edit.
		IF USED("tmpWO_POitemCnt")	
			USE IN tmpWO_POitemCnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = cSQL + " SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder_Detail "
		cSQL = cSQL + " WHERE fPOitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND ISNULL(fCncld,0) = 0"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_POitemCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_POitemCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_POitemCnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_POitemCnt')
				IF tmpWO_POitemCnt.Cntd > 0
					lFoundPOitem = .T.
				ENDIF
				USE IN tmpWO_POitemCnt
			ENDIF
		ENDIF
		
		IF lFoundPOitem
			*Show WO screen with POitem and Ask if they want to Edit That.
			IF MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was Found in another WO Detail."+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+"Answer No to continue with adding"+CHR(13)+"this PO item to this WO.",4+32,"Edit old WO?") = 6
				ThisFormSet.EditbyPOitem(pPOitem)
				RETURN
			ENDIF
		ENDIF
		
		*********************************************
		*Do they want to add to the same WO
		PRIVATE nWO, lKeepWO, nMess
		nWO = PrepareSQLnum(ThisFormSet.frmWorkorder.txtWO.Value,'WO',-3)
		lKeepWO = .F.
		IF nWO > 0
			nMess = MESSAGEBOX("The current WO is '"+ALLTRIM(STR(nWO))+"'"+CHR(13)+"This code will add the POitem as a WO Detail."+CHR(13)+"Do you want the detail to belong to this WO?"+CHR(13)+"Answer No to create a new WO."+CHR(13)+"Answer Yes to use the current WO.",4+32,"Keep WO?")
			IF nMess = 6
				lKeepWO = .T.
			ELSE
				nWO = 0
				ThisFormSet.frmWorkorder.txtWO.Value = 0
			ENDIF
		ENDIF
		
		*************************************
		*Get PurchaseOrder Data
		
		IF USED("tmpPO_POitem")	
			USE IN tmpPO_POitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT Pieces,Alloy,Form,CC,CL,Thck,Sz2,Sz3"
		*,Weight "
		cSQL = cSQL + ",POitem, HPAPo, SOitem "
		cSQL = cSQL + ",[Order_QTY], SalesP "
		
		cSQL= cSQL+",StockLst_QTY, StockLst_P, ,ISNULL(StockLst_PU,dbo.f_GetFormPU(Form)) AS StockLst_PU "
		cSQL= cSQL+",ISNULL(StockLst_Total,dbo.f_GetPOItem_Total(P.POItem)) AS StockLst_Total "
		
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Pounds, RandLen, Metric,'','','') AS Descript "
		cSQL = cSQL + ",dbo.f_BestDate(dbo.f_BestDate(Due_Min,Due_Max),dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max)) AS DueDate "
		cSQL = cSQL + ",LEFT(Cond_Spec,1000) AS Cond_Spec ,LEFT(Misc_Purch,1000) as Misc_Purch"
		cSQL = cSQL + "	FROM dbo.PurchaseOrder WHERE POitem ='"+cPOitem+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_POitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_POitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_POitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_POitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_POitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPO_POitem')
				IF RECCOUNT('tmpPO_POitem') > 0
					*Adding Detail
					IF nWO = 0	&&might as well fill in
		*				IF EMPTY(PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12))
							ThisFormset.frmWorkOrder.txtPieces.Value 	= tmpPO_POitem.Pieces
							ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpPO_POitem.Alloy
							ThisFormset.frmWorkOrder.cmbForm.Value		= tmpPO_POitem.Form
							ThisFormSet.RefreshForms(tmpPO_POitem.Form)
							ThisFormset.frmWorkOrder.cmbCC.Value		= tmpPO_POitem.CC
							ThisFormSet.InitcmbCL()
							ThisFormset.frmWorkOrder.cmbCL.Value		= tmpPO_POitem.CL
							ThisFormset.frmWorkOrder.txtHeat.Value		= ''
							
							ThisFormset.frmWorkOrder.txtThck.Value		= tmpPO_POitem.Thck
							ThisFormset.frmWorkOrder.txtSz2.Value		= tmpPO_POitem.Sz2
							ThisFormset.frmWorkOrder.txtSz3.Value		= tmpPO_POitem.Sz3
							ThisFormSet.frmWorkOrder.chkPinSWeight.Value	= 0
							ThisFormset.frmWorkOrder.txtWeight.Value 	= tmpPO_POitem.Order_Qty
							*
							ThisFormSet.frmWorkOrder.txtStartDate.Value	= DATE()
							*ThisFormSet.frmWorkOrder.chkIntP.Value		= PrepareSQLlogic(0,'IntP')
							ThisFormSet.frmWorkOrder.chkRE.Value		= PrepareSQLlogic(0,'RE')
							ThisFormset.frmWorkOrder.txtDescript.Value 	= tmpPO_POitem.Descript
							ThisFormset.frmWorkOrder.edtWO_Notes.Value 	= tmpPO_POitem.Cond_Spec
							
							ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0
							ThisFormSet.frmWorkOrder.txtPOitem.Value	= ''
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= ''
							
							ThisFormSet.frmWorkOrder.txtSalesRep.Value	= AppSetup_Get_SalesRep_SalesP(tmpPO_POitem.SalesP)
		*				ENDIF
					ENDIF
					*
					* Detail
					ThisFormset.frmWorkOrder.txtFPieces.Value 	= tmpPO_POitem.Pieces
					ThisFormset.frmWorkOrder.txtFAlloy.Value	= tmpPO_POitem.Alloy
					ThisFormset.frmWorkOrder.cmbFForm.Value		= tmpPO_POitem.Form
					ThisFormSet.RefreshFForms(tmpPO_POitem.Form)
					ThisFormset.frmWorkOrder.cmbFcc.Value		= tmpPO_POitem.CC
					ThisFormSet.InitcmbFCL()
		
					ThisFormset.frmWorkOrder.cmbFCL.Value		= tmpPO_POitem.CL
					ThisFormset.frmWorkOrder.txtFThck.Value		= tmpPO_POitem.Thck
					ThisFormset.frmWorkOrder.txtFSz2.Value		= tmpPO_POitem.Sz2
					ThisFormset.frmWorkOrder.txtFSz3.Value		= tmpPO_POitem.Sz3
					ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= 0
					
					ThisFormSet.Calc_Weight('Finish',.T.)	&&PO may have wrong weight
					PRIVATE nfWeight
					nfWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtfWeight.Value,'fWeight',9,1)
					IF nfWeight = 0
						ThisFormset.frmWorkOrder.txtfWeight.Value 	= tmpPO_POitem.Order_Qty
					ENDIF
					
					ThisFormset.frmWorkOrder.txtfWeight.Value 	= tmpPO_POitem.Order_Qty
					ThisFormset.frmWorkOrder.txtFSpec.Value 	= ''
					ThisFormset.frmWorkOrder.txtFDescript.Value = tmpPO_POitem.Descript
					ThisFormset.frmWorkOrder.txtfCondLevel.Value = ConditionLevelText(tmpPO_POitem.CC,tmpPO_POitem.CL)
					
					ThisFormset.frmWorkOrder.cmbFollowM.Value	= ''
					ThisFormset.frmWorkOrder.txtFollowLot.Value	= 0
					ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
					ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
					
					ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(0,'StartSize',8,3)
					ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(0,'CW',-1)
					ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(0,'RoughSize',8,3)
					ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
					
					ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
					ThisFormSet.nStock_Projected_ID = 0
					ThisFormSet.Refresh_Projected()
					
					ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0
					
					IF ThisFormSet.cWhat2 = "START"
						ThisFormSet.frmWorkOrder.txtFPOitem.Value	= ''
						ThisFormSet.frmWorkOrder.txtFSOitem.Value	= ''
						ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
					ELSE
						*"FINISH"
						ThisFormSet.frmWorkOrder.txtFPOitem.Value	= cPOitem
						ThisFormSet.frmWorkOrder.txtFSOitem.Value	= ''	&&PrepareSQLtxt(tmpPO_POitem.SOitem,'SOitem',10)
						ThisFormSet.Refresh_frmWorkOrder_FPOitem(cPOitem)
					ENDIF
					
					*ThisFormSet.Refresh_FPOitem()
		
					ThisFormSet.frmWorkOrder.txtDueDate.Value	= PrepareSQLDate(tmpPO_POitem.DueDate,'DueDate')
		
					IF ThisFormset.frmWorkOrder.txtWO.Value = 0 OR NOT lKeepWO
						ThisFormset.frmWorkOrder.txtWO.Value = GetNextWorkOrder(ThisFormSet.nConnhandle)
						ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
					ENDIF
					
					**********************************************
									
					ThisFormSet.Set_frmWorkOrder('ENABLE')
					
					ThisFormSet.SetVfrmWorkOrder(.T.)
					
					**********************************************
					
					ThisFormSet.frmWorkOrder.txtWO_Detail.Value = GetNextWorkOrder_Detail(ThisFormSet.nConnHandle)					
					ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .F.	&&Do not show untill save!
					
					**********************************************
					PRIVATE cMess
					cMess = "The PO was found and the screen has this data."
					IF ThisFormSet.cWhat2 == ""
						cMess = cMess + CHR(13)+"The program assumes the PO would create the WO_Detail for this WO."
						cMess = cMess + CHR(13)+"The start sizes have also been filled, but need to be changed"
						cMess = cMess + CHR(13)+"if this is a Size Conversion PO."
					ELSE
						IF ThisFormSet.cWhat2 = "START"
							cMess = cMess + CHR(13)+"The Start sizes have also been filled!"
						ENDIF
						IF ThisFormSet.cWhat2 = "FINISH"
							cMess = cMess + CHR(13)+"The Finish sizes have also been filled!"
						ENDIF
					ENDIF
					*cMess = cMess + CHR(13)+CHR(13)+"WO_Detail will be 0 till you save."
					MESSAGEBOX(cMess,0+64,"WO is ready to Edit and Save.")
					
				ENDIF
				USE IN tmpPO_POitem
			ENDIF
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE addwod_poitem
		PARAMETERS pPOitem, pKeepWO
		*ThisFormSet.AddWOD_POitem(cPOitem,lKeepWO)
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item(pPOitem)
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			WAIT WINDOW "No PO item passed in.  Any key to continue..."
			RETURN .F.
		ENDIF
		
		PRIVATE lKeepWO
		lKeepWO = pKeepWO
		
		*************************************
		*Count POitem in PurchaseOrder
		PRIVATE lFoundPOiteminPO
		lFoundPOiteminPO = .F.
		
		IF USED("tmpPO_cnt")	
			USE IN tmpPO_cnt
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND Cancelled = 0 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_cnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_cnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_cnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_cnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_cnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPO_cnt')
				IF tmpPO_cnt.Cnt > 0
					lFoundPOiteminPO = .T.
				ENDIF
				USE IN tmpPO_cnt
			ENDIF
		ENDIF
		
		
		IF NOT lFoundPOiteminPO
			MESSAGEBOX("Did not find POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrder table!",16,"Data not found!")
			RETURN .F.
		ENDIF
		
		**********************************************
		
		PRIVATE nWO, nWO_Detail
		IF ThisFormSet.frmWorkOrder.Visible
			nWO		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
			nWO_Detail = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_detail.Value,'WO_Detail',-3)
		ELSE
			nWO = 0
			nWO_Detail = 0
		ENDIF
		
		************************************************
		*Check POitem in WO, See if they meant to Edit.
		PRIVATE lFoundPOitem, lCreateWO
		lFoundPOitem 	= .F.
		lCreateWO		= .T.
		
		PRIVATE cMess
		cMess = ''
		
		IF USED("tmpWO_POitemCnt")	
			USE IN tmpWO_POitemCnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND ISNULL(Cncld,0) = 0"
		cSQL = cSQL + " AND WO <> "+STR(nWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_POitemCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_POitemCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_POitemCnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_POitemCnt')
				IF tmpWO_POitemCnt.Cntd > 0
					lFoundPOitem = .T.
					cMess = "Found WO = "+ALLTRIM(STR(PrepareSQLnum(tmpWO_POitemCnt.WO,'WO',-3)))
					IF RECCOUNT('tmpWO_POitemCnt') > 1
						cMess = cMess + " with "+ALLTRIM(STR( RECCOUNT('tmpWO_POitemCnt') ))+" Records."
					ENDIF
				ENDIF
				USE IN tmpWO_POitemCnt
			ENDIF
		ENDIF
		
		IF lFoundPOitem
			*Show WO screen with POitem and Ask if they want to Edit That.
			IF MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was Found in another WO."+CHR(13)+cMess+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+"Answer No to continue with adding"+CHR(13)+"this PO item to this WO.",4+32,"Edit old WO?") = 6
				ThisFormSet.EditbyPOitem(pPOitem)
				*Could be reworked as 'Edit WO byPOitem' since POitem was found in WorkOrder
				RETURN .F.
			ENDIF
		ENDIF
		
		**********************************************
		*Check POitem in WorkOrder_Detail, See if they meant to Edit.
		IF USED("tmpWO_POitemCnt")	
			USE IN tmpWO_POitemCnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder_Detail "
		cSQL = cSQL + " WHERE fPOitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND ISNULL(fCncld,0) = 0"
		cSQL = cSQL + " AND WO_Detail <> "+STR(nWO_Detail)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_POitemCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_POitemCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_POitemCnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_POitemCnt')
				IF tmpWO_POitemCnt.Cntd > 0
					lFoundPOitem = .T.
					cMess = "Found WO_Detail = "+ALLTRIM(STR(PrepareSQLnum(tmpWO_POitemCnt.WO_Detail,'WO_Detail',-3)))
					IF RECCOUNT('tmpWO_POitemCnt') > 1
						cMess = cMess + " with "+ALLTRIM(STR( RECCOUNT('tmpWO_POitemCnt') ))+" Records."
					ENDIF			
		
				ENDIF
				USE IN tmpWO_POitemCnt
			ENDIF
		ENDIF
		
		IF lFoundPOitem
			*Show WO screen with POitem and Ask if they want to Edit That.
			IF MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was used in another WO Detail."+CHR(13)+cMess+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+CHR(13)+"(Y) Yes to edit."+CHR(13)+"(N)No to continue with adding this PO item to a NEW WO."+CHR(13)+CHR(13)+"A different input Size will need a new WO number.",4+32,"Edit old WO?(Y) or create new WO?(N)") = 6
				ThisFormSet.EditbyPOitem(pPOitem)
				*Could be reworked as 'Edit WOD byPOitem' since POitem was found in WorkOrder_Detail
				RETURN .F.
			ENDIF
		ENDIF
		
		*********************************************
		*Get PurchaseOrder Data
		
		IF USED("tmpPO_POitem")	
			USE IN tmpPO_POitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * "
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Pounds, RandLen, Metric,'','','') AS Descript "
		cSQL = cSQL + ",dbo.f_BestDate(dbo.f_BestDate(Due_Min,Due_Max),dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max)) AS DueDate "
		cSQL = cSQL + ",LEFT(Cond_Spec,1000) AS Cond_Spec ,LEFT(Misc_Purch,1000) as Misc_Purch"
		cSQL = cSQL + "	FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_POitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_POitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_POitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_POitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_POitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPO_POitem')
				IF RECCOUNT('tmpPO_POitem') > 0
					
					ThisFormset.frmWorkOrder.txtFPieces.Value 	= tmpPO_POitem.Pieces
					ThisFormset.frmWorkOrder.txtFAlloy.Value	= tmpPO_POitem.Alloy
					ThisFormset.frmWorkOrder.cmbFForm.Value		= tmpPO_POitem.Form
					ThisFormSet.RefreshFForms(tmpPO_POitem.Form)
					ThisFormset.frmWorkOrder.cmbFcc.Value		= tmpPO_POitem.CC
					ThisFormSet.InitcmbFCL()
		
					ThisFormset.frmWorkOrder.cmbFCL.Value		= tmpPO_POitem.CL
					ThisFormset.frmWorkOrder.txtFThck.Value		= tmpPO_POitem.Thck
					ThisFormset.frmWorkOrder.txtFSz2.Value		= tmpPO_POitem.Sz2
					ThisFormset.frmWorkOrder.txtFSz3.Value		= tmpPO_POitem.Sz3
					ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= 0
					
					ThisFormset.frmWorkOrder.txtfWeight.Value 	= tmpPO_POitem.Order_Qty
					ThisFormset.frmWorkOrder.txtFSpec.Value 	= ''
					ThisFormset.frmWorkOrder.txtFDescript.Value = tmpPO_POitem.Descript
					ThisFormset.frmWorkOrder.txtfCondLevel.Value = ConditionLevelText(tmpPO_POitem.CC,tmpPO_POitem.CL)
					
					ThisFormset.frmWorkOrder.cmbFollowM.Value	= ''
					ThisFormset.frmWorkOrder.txtFollowLot.Value	= 0
					ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
					ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
		
					ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(0,'StartSize',8,3)
					ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(0,'CW',-1)
					ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(0,'RoughSize',8,3)
					ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
					
					ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
					ThisFormSet.nStock_Projected_ID = 0
					ThisFormSet.Refresh_Projected()
					
					ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0
					
					*IF ThisFormSet.cWhat2 = "START"
					*	ThisFormSet.frmWorkOrder.txtFPOitem.Value	= cPOitem
					*	ThisFormSet.frmWorkOrder.txtFSOitem.Value	= ''
					*	ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
					*ENDIF
					*IF ThisFormSet.cWhat2 = "FINISH"
						ThisFormSet.frmWorkOrder.txtFPOitem.Value	= cPOitem
						ThisFormSet.frmWorkOrder.txtFSOitem.Value	= PrepareSQLtxt(tmpPO_POitem.SOitem,'SOitem',10)
						ThisFormSet.Refresh_frmWorkOrder_FPOitem(cPOitem)
					*ENDIF
					
					**********************************************
					
					ThisFormSet.Set_frmWorkOrder('ENABLE')
					ThisFormSet.SetVfrmWorkOrder(.T.)
					
					**********************************************
					
					PRIVATE cMess
					cMess = "The PO was found and the WO screen has this data."
					cMess = cMess + CHR(13)+"The Finish sizes have also been filled!"
					
					MESSAGEBOX(cMess,0+64,"WO is ready to Edit and Save.")
					
				ENDIF
				USE IN tmpPO_POitem
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE addwod_soitem
		PARAMETERS pSOitem
		*ThisFormSet.AddWO_SOitem(cSOitem)
		
		PRIVATE cSOitem
		cSOitem = Proper_SO_Item(pSOitem)
		
		IF Proper_SO_Item(pSOitem) = Proper_SO_Item('')
			RETURN .F.
		ENDIF
		
		PRIVATE nWO,nWOD
		nWO  = PrepareSQLnum(ThisFormSet.frmWorkorder.txtWO.Value,'WO',-3)
		nWOD = PrepareSQLnum(ThisFormSet.frmWorkorder.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF nWO = 0 OR nWOD = 0
			MESSAGEBOX("Please save work first."+CHR(13)+"WO is "+ALLTRIM(STR(nWO))+CHR(13)+"WOD is "+ALLTRIM(STR(nWOD))+CHR(13)+"The WO_Detail is needed to save to SOitem",0+48,"Cannot add yet.")
			RETURN
		ENDIF
		
		*Check SOitem, See if they meant to Edit.
		PRIVATE lFoundSOitem, lCreateWO
		lFoundSOitem 	= .F.
		lCreateWO		= .T.
		
		*!*	IF USED("cntWO_SOitem")	
		*!*		USE IN cntWO_SOitem
		*!*	ENDIF
		*!*	SELECT 0
		*!*	PRIVATE cSQL, nSQLEXEC 
		*!*	cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder_Detail "
		*!*	cSQL = cSQL + " WHERE fSOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*	cSQL = cSQL + " AND WO_Detail<>"+STR(nWOD)
		
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntWO_SOitem')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'cntWO_SOitem')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO_SOitem")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO_SOitem")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 	
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntWO_SOitem')
		*!*		RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*	ELSE
		*!*		IF USED('cntWO_SOitem')
		*!*			IF cntWO_SOitem.Cnt > 0
		*!*				lFoundSOitem = .T.
		*!*			ENDIF
		*!*			USE IN cntWO_SOitem
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF lFoundSOitem
		*!*		*Show WO screen with SOitem and Ask if they want to Edit That.
		*!*		IF MESSAGEBOX("SO Item:"+ALLTRIM(cSOitem)+" was Found in another WOD."+CHR(13)+"Do you want to Edit this other WO_Detail?"+CHR(13)+"Answer No to continue with adding"+CHR(13)+"this SO item to this WO_Detail.",4+32,"Edit old WO_Detail?") = 6
		*!*			ThisFormSet.EditbySOitem(pSOitem)
		*!*			RETURN
		*!*		ENDIF
		*!*	ENDIF
		
		*Use SOitem to Create WOD
		PRIVATE lFoundSOiteminSales
		lFoundSOiteminSales = .F.
		
		IF USED("cntWO_SOitem")	
			USE IN cntWO_SOitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.Sales WITH(NOLOCK)"
		cSQL = cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntWO_SOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'cntWO_SOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO_SOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO_SOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntWO_SOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('cntWO_SOitem')
				IF cntWO_SOitem.Cnt > 0
					lFoundSOiteminSales = .T.
				ENDIF
				USE IN cntWO_SOitem
			ENDIF
		ENDIF
		
		PRIVATE nMess
		nMess = 0
		IF lFoundSOiteminSales
			nMess = MESSAGEBOX("Found SOitem:"+ALLTRIM(cSOitem)+" in Sales table!"+CHR(13)+"Do you want to over write this WO_Detail with the SOitem Data?",4+32,"Import SOitem data")
		ELSE
			MESSAGEBOX("Did not find SOitem:"+ALLTRIM(cSOitem)+" in Sales table!",16,"Data not found!")
			RETURN .F.
		ENDIF
		
		*The Click code saves SOitem to WO_Detail
		*"UPDATE dbo.WorkOrder_Detail SET fSOitem = dbo.f_ProperSOitem('"+cSoItem+"') WHERE WO_Detail = "+STR(nWO_Detail)
				
		************************************
		IF lFoundSOiteminSales AND nMess = 6
			*Get Sales Info to import
			
			
			IF USED("tmpSO_SOitem")	
				USE IN tmpSO_SOitem
			ENDIF
			SELECT 0
			cSQL = "SELECT Pieces,Alloy,Form,CC,CL,Thck,Sz2,Sz3,Weight "
			cSQL = cSQL + ",S.SOitem,S.SalesNum "
			cSQL = cSQL + ",S.S_QTY, SalesP "
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, weight, RandLen, Metric,'','','') AS Descript "
			cSQL = cSQL + ",dbo.f_BestDate(dbo.f_BestDate(Shipped,ShipDue),dbo.f_BestDate(shipdate,saledate)) AS DueDate "
			cSQL = cSQL + ",OrderSpec,S_Instrct "
			cSQL = cSQL + " FROM dbo.Sales S "
			cSQL = cSQL + " INNER JOIN dbo.AllQuotes AQ ON AQ.Soitem = S.SOitem "
			cSQL = cSQL + " WHERE S.SOitem ='"+cSOitem+"'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_SOitem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSO_SOitem')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSO_SOitem")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSO_SOitem")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSO_SOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpSO_SOitem')
					IF VARTYPE(tmpSO_SOitem.SalesNum) = 'N'
						IF ThisFormset.frmWorkOrder.txtAlloy.Value = ""
							nMess = MESSAGEBOX("You are filling in the WO_Detail with SOitem data"+CHR(13)+"Dou you wnat to fill in Starting Data Also?",4+32,"Import to START")
							IF nMess = 6
								*ThisFormset.frmWorkOrder.txtPieces.Value 	= tmpSO_SOitem.Pieces
								ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpSO_SOitem.Alloy
								ThisFormset.frmWorkOrder.cmbForm.Value		= tmpSO_SOitem.Form
								ThisFormSet.RefreshForms(tmpSO_SOitem.Form)
								*ThisFormset.frmWorkOrder.cmbCC.Value		= tmpSO_SOitem.CC
								*ThisFormSet.InitcmbFCL()
								*
								*ThisFormset.frmWorkOrder.cmbCL.Value		= tmpSO_SOitem.CL
								*ThisFormset.frmWorkOrder.txtThck.Value		= tmpSO_SOitem.Thck
								*ThisFormset.frmWorkOrder.txtSz2.Value		= tmpSO_SOitem.Sz2
								*ThisFormset.frmWorkOrder.txtSz3.Value		= tmpSO_SOitem.Sz3
								*ThisFormSet.frmWorkOrder.chkPinWeight.Value	= 0
								ThisFormset.frmWorkOrder.txtWeight.Value 	= tmpSO_SOitem.Weight
								*
								ThisFormSet.frmWorkOrder.txtStartDate.Value	= DATE()
								*ThisFormSet.frmWorkOrder.chkIntP.Value		= PrepareSQLlogic(0,'IntP')
								ThisFormSet.frmWorkOrder.chkRE.Value		= PrepareSQLlogic(0,'RE')
								*ThisFormset.frmWorkOrder.txtDescript.Value 	= tmpSO_SOitem.Descript 
								ThisFormset.frmWorkOrder.edtWO_Notes.Value 	= ALLTRIM(tmpSO_SOitem.OrderSpec)+CHR(13)+ALLTRIM(tmpSO_SOitem.S_Instrct)
								
								*ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0 
								
								*IF ThisFormSet.cWhat2 = "START"
								*	ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpSO_SOitem.SOitem,'SOitem',10)
								*ELSE
								*	ThisFormSet.frmWorkOrder.txtSOitem.Value	= '' &&PrepareSQLtxt(tmpSO_SOitem.SOitem,'SOitem',10)				
								*ENDIF
								
								*ThisFormSet.frmWorkOrder.txtSalesRep.Value	= AppSetup_Get_SalesRep_SalesP(tmpSO_SOitem.SalesP)
							ENDIF
						ENDIF
						
						ThisFormset.frmWorkOrder.txtFPieces.Value 	= tmpSO_SOitem.Pieces
						ThisFormset.frmWorkOrder.txtFAlloy.Value	= tmpSO_SOitem.Alloy
						ThisFormset.frmWorkOrder.cmbFForm.Value		= tmpSO_SOitem.Form
						ThisFormSet.RefreshFForms(tmpSO_SOitem.Form)
						ThisFormset.frmWorkOrder.cmbFcc.Value		= tmpSO_SOitem.CC
						ThisFormSet.InitcmbFCL()
		
						ThisFormset.frmWorkOrder.cmbFCL.Value		= tmpSO_SOitem.CL
						ThisFormset.frmWorkOrder.txtFThck.Value		= tmpSO_SOitem.Thck
						ThisFormset.frmWorkOrder.txtFSz2.Value		= tmpSO_SOitem.Sz2
						ThisFormset.frmWorkOrder.txtFSz3.Value		= tmpSO_SOitem.Sz3
						ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= 0
						ThisFormset.frmWorkOrder.txtfWeight.Value 	= tmpSO_SOitem.Weight
						ThisFormset.frmWorkOrder.txtFSpec.Value		= ''
						ThisFormset.frmWorkOrder.txtFDescript.Value = tmpSO_SOitem.Descript
						ThisFormset.frmWorkOrder.txtfCondLevel.Value= ConditionLevelText(tmpSO_SOitem.CC,tmpSO_SOitem.CL)
						
						ThisFormset.frmWorkOrder.cmbFollowM.Value	= ''
						ThisFormset.frmWorkOrder.txtFollowLot.Value	= 0
						ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
						ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
						
						ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(0,'StartSize',8,3)
						ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(0,'CW',-1)
						ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(0,'RoughSize',8,3)
						ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
						
						ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
						ThisFormSet.nStock_Projected_ID = 0
						ThisFormSet.Refresh_Projected()
		
						ThisFormSet.frmWorkOrder.chklPrc_Stock.Value	= 0
						ThisFormSet.frmWorkOrder.chkStkConsumed.Value	= 0
						
						ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= 0 &&PrepareSQLnum(tmpWO.AC_ID_WOD,'AC_ID',-3)
						
						*IF ThisFormSet.cWhat2 = "START"
						*	ThisFormSet.frmWorkOrder.txtFSOitem.Value	= ''
		*				*	ThisFormSet.Refresh_frmWorkOrder_fPOitem("")
						*ELSE
							ThisFormSet.frmWorkOrder.txtFSOitem.Value	= PrepareSQLtxt(tmpSO_SOitem.SOitem,'SOitem',10)				
		*					ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
						*ENDIF
						
						*ThisFormSet.Refresh_frmWorkOrder_POitem("")
						ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
			
						ThisFormSet.frmWorkOrder.txtFDueDate.Value	= PrepareSQLDate(tmpSO_SOitem.DueDate,'DueDate')
						ThisFormSet.frmWorkOrder.cmbNextCode.Value	= ''
						ThisFormSet.frmWorkOrder.txtNextNumber.Value = ''
		
						IF ThisFormset.frmWorkOrder.txtWO.Value = 0
							ThisFormset.frmWorkOrder.txtWO.Value = GetNextWorkOrder(ThisFormSet.nConnhandle)
							ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
						ENDIF
						
						IF ThisFormSet.CheckFinish_ID_Detail()
						ENDIF
						IF ThisFormSet.CheckFinish_ID_Detail_Process()
						ENDIF
						
						ThisFormSet.Set_frmWorkOrder('ENABLE')
						
						*ThisFormSet.CheckSOitemProcess()
						
						PRIVATE cMess
						cMess = "The SO was found and the WO screen has this data."
						IF ThisFormSet.cWhat2 == ""
							cMess = cMess + CHR(13)+"The program assumes the SO would create the Finish sizes of this WO."
							cMess = cMess + CHR(13)+"The start sizes have also been filled, but need to be changed"
							cMess = cMess + CHR(13)+"if this is a Size Conversion SO."
						ELSE
							IF ThisFormSet.cWhat2 = "START"
								cMess = cMess + CHR(13)+"The Start sizes have also been filled!"
							ENDIF
							IF ThisFormSet.cWhat2 = "FINISH"
								cMess = cMess + CHR(13)+"The Finish sizes have also been filled!"
							ENDIF
						ENDIF
		*				cMess = cMess + CHR(13)+CHR(13)+"Make sure you"
						MESSAGEBOX(cMess,0+64,"WO is ready to Edit")
						
					ENDIF
					USE IN tmpSO_SOitem
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE addwo_detail
		PARAMETERS lShowOverwriteDetail
		*ThisFormSet.AddWO_Detail()
		
		IF VARTYPE(lShowOverwriteDetail) <> "L"
			lShowOverwriteDetail = .T.
		ENDIF
			
		PRIVATE nMess
		IF lShowOverwriteDetail
			nMess = MESSAGEBOX("Do you want to clone current Detail info"+CHR(13)+"for the New WO Detail?",4+32+256,"Keep some of the old Data")
		ELSE
			nMess = 7
		ENDIF
		
		IF nMess = 7	&&Clean
			IF USED('tmpWOD')
				USE IN tmpWOD
			ENDIF
			SELECT 0
		
			PRIVATE cSQL, nSQLEXEC 
		
			cSQL = "SELECT * "
			cSQL = cSQL + ",0 AS AC_ID_WOD "
			cSQL = cSQL + " FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL + " WHERE 0>0 "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOD')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOD')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOD')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpWOD')
						
					ThisFormset.frmWorkOrder.txtFPieces.Value	= tmpWOD.fPieces
					ThisFormset.frmWorkOrder.txtFAlloy.Value	= tmpWOD.fAlloy
					ThisFormset.frmWorkOrder.cmbFForm.Value		= tmpWOD.fForm
					ThisFormSet.RefreshFForms(tmpWOD.fForm)
					ThisFormset.frmWorkOrder.cmbFcc.Value		= tmpWOD.fCC
					ThisFormSet.InitcmbFCL()
		
					ThisFormset.frmWorkOrder.cmbFCL.Value		= tmpWOD.fCL
					ThisFormset.frmWorkOrder.txtFThck.Value		= tmpWOD.fThck
					ThisFormset.frmWorkOrder.txtFSz2.Value		= tmpWOD.fSz2
					ThisFormset.frmWorkOrder.txtFSz3.Value		= tmpWOD.fSz3
					ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= PrepareSQLchk(tmpWOD.pinFWeight,'pinFWeight')
					ThisFormset.frmWorkOrder.txtFWeight.Value 	= tmpWOD.fWeight
					
					ThisFormset.frmWorkOrder.txtTotFinishW.Value	= PrepareSQLnum(tmpWOD.TotFinishW,'TotFinishW',9,1)
					ThisFormset.frmWorkOrder.txtLostWeight.Value	= PrepareSQLnum(tmpWOD.LostWeight,'LostWeight',9,1)
					
					
					ThisFormset.frmWorkOrder.txtFSpec.Value				= PrepareSQLtxt(tmpWOD.fSpec,'fSpec',50)
					ThisFormset.frmWorkOrder.txtStock_Projected_ID.Value	= PrepareSQLnum(tmpWOD.Stock_Projected_ID,'Stock_Projected_ID',-3)
					ThisFormset.frmWorkOrder.txtfID_Detail.Value		= PrepareSQLnum(tmpWOD.fID_Detail,'fID_Detail',-3)
					IF PrepareSQLnum(tmpWOD.fID_Detail,'fID_Detail',-3) > 0
						ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(0,128,255)
					ELSE
						ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(240,240,240)
					ENDIF		
					ThisFormset.frmWorkOrder.txtfID_Detail_Process.Value	= PrepareSQLnum(tmpWOD.fID_Detail_Process,'fID_Detail_Process',-3)
					ThisFormset.frmWorkOrder.txtfTBL.Value				= PrepareSQLtxt(tmpWOD.fTBL,'fTBL',1)
					ThisFormset.frmWorkOrder.txtfReceivingID.Value		= PrepareSQLnum(tmpWOD.fReceivingID,'fReceivingID',-3)
					
					ThisFormset.frmWorkOrder.txtFDescript.Value	= tmpWOD.fDescript
					ThisFormset.frmWorkOrder.txtfCondLevel.Value= tmpWOD.fCondLevel
					
					ThisFormset.frmWorkOrder.cmbFollowM.Value	= PrepareSQLtxt(tmpWOD.FollowM,'FollowM',20)
					ThisFormset.frmWorkOrder.txtFollowLot.Value	= PrepareSQLnum(tmpWOD.FollowLot,'FollowLot',-3)
					ThisFormset.frmWorkOrder.cmbFinishM.Value	= PrepareSQLtxt(tmpWOD.FinishM,'FinishM',20)
					ThisFormset.frmWorkOrder.txtFinishLot.Value	= PrepareSQLnum(tmpWOD.FinishLot,'FinishLot',-3)
					
					ThisFormset.frmWorkOrder.txtTestPO.Value	= PrepareSQLtxt(tmpWOD.TestPO,'POitem',12)
					
					ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(tmpWOD.StartSize,'StartSize',8,3)
					ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(tmpWOD.CW,'CW',-1)
					ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(tmpWOD.RoughSize,'RoughSize',8,3)
					ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
					
					ThisFormset.frmWorkOrder.edtfNotes.Value	= PrepareSQLtxt(tmpWOD.fNotes,'fNotes',-1)
					ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = PrepareSQLnum(tmpWOD.Stock_Projected_ID,'Stock_Projected_ID',-3)
					ThisFormSet.nStock_Projected_ID 			= PrepareSQLnum(tmpWOD.Stock_Projected_ID,'Stock_Projected_ID',-3)
					ThisFormSet.Refresh_Projected()
					
					ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= 0
					*ThisFormSet.Refresh_frmWorkOrder_POitem("")
					ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
			
					ThisFormSet.frmWorkOrder.txtFID_Detail.Value = tmpWOD.fID_Detail
					IF tmpWOD.fID_Detail > 0
						ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(0,128,255)
					ELSE
						ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(240,240,240)
					ENDIF
					
					ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value = tmpWOD.fID_Detail_Process
					
					ThisFormSet.frmWorkOrder.txtFSOitem.Value	= PrepareSQLtxt(tmpWOD.fSOitem,'SOitem',10)
					ThisFormSet.frmWorkOrder.txtFPOitem.Value	= PrepareSQLtxt(tmpWOD.fPOitem,'POitem',12)
					ThisFormSet.Refresh_frmWorkOrder_FPOitem(tmpWOD.fPOitem)
					*ThisFormSet.Refresh_FPOitem()
					
					ThisFormSet.frmWorkOrder.txtfReceivingID.Value	=	0
				*	ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')  &&Used on WO and WO_Detail
					ThisFormSet.frmWorkOrder.chkfCmplt.Value = 0
		
					ThisFormSet.frmWorkOrder.chkfCncld.Value	= 0
					ThisFormSet.frmWorkOrder.chkStkListed.Value = 0
		
					ThisFormset.frmWorkOrder.txtfDueDate.Value	= ''
					ThisFormSet.frmWorkOrder.cmbNextCode.Value	= ''
					ThisFormSet.frmWorkOrder.txtNextNumber.Value = ''
					
					ThisFormset.frmWorkOrder.txtWO_Detail.Value 	= 0	&&Zero so new number can be found
					
					IF ThisFormSet.CheckFinish_ID_Detail()
					ENDIF
					IF ThisFormSet.CheckFinish_ID_Detail_Process()
					ENDIF
					
					USE IN tmpWOD
				ENDIF
			ENDIF
		ELSE
			*Clone 
			*except these.
			ThisFormset.frmWorkOrder.cmbFollowM.Value	= ''
			ThisFormset.frmWorkOrder.txtFollowLot.Value	= 0
			ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
			ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
					
			ThisFormset.frmWorkOrder.txtTestPO.Value	= ''
		
			ThisFormSet.frmWorkOrder.txtfReceivingID.Value	=	0
			*ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')  &&Used on WO and WO_Detail
			ThisFormSet.frmWorkOrder.chkfCmplt.Value = 0
		
			ThisFormSet.frmWorkOrder.chkfCncld.Value	= 0
			ThisFormSet.frmWorkOrder.chkStkListed.Value = 0
			
			ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value = 0
			ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
			ThisFormSet.frmWorkOrder.txtfTBL.Value = ''
			ThisFormSet.frmWorkOrder.txtfID_Detail.Value = 0
			ThisFormSet.frmWorkOrder.txtfID_Detail_Process.Value = 0
			ThisFormSet.frmWorkOrder.txtfReceivingID.Value = 0
			
			ThisFormSet.frmWorkOrder.txtFSOitem.Value = ''
			ThisFormSet.frmWorkOrder.txtFPOitem.Value = ''
			
			ThisFormSet.frmWorkOrder.chkfCmplt.Value = 0
			ThisFormSet.frmWorkOrder.chkfCncld.Value	= 0
			ThisFormSet.frmWorkOrder.chkStkListed.Value = 0
		
			ThisFormset.frmWorkOrder.txtfDueDate.Value	= ''
			ThisFormSet.frmWorkOrder.cmbNextCode.Value	= ''
			ThisFormSet.frmWorkOrder.txtNextNumber.Value = 0
			
			ThisFormset.frmWorkOrder.txtWO_Detail.Value 	= 0	&&Zero so new number can be found
		
			*ThisFormSet.Refresh_frmWorkOrder_POitem("")
			ThisFormSet.Refresh_frmWorkOrder_FPOitem("")
			
		ENDIF
		
		ThisFormset.frmWorkOrder.txtWO_Detail.Value = GetNextWorkOrder_Detail(ThisFormSet.nConnHandle)
		ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .F.
		
		ThisFormSet.SaveAddDetail(.F.)
		
		ThisFormSet.Set_frmWorkOrder('ENABLE')
		
		WAIT WINDOW "Ready to Edit NEW Detail" NOWAIT		
	ENDPROC

	PROCEDURE addwo_poitem		&& Refresh WO with POitem data
		PARAMETERS pPOitem
		*ThisFormSet.AddWO_POitem(cPOitem)
		
		PRIVATE nCurrWO
		nCurrWO = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item(pPOitem)
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			WAIT WINDOW "No PO item passed in.  Any key to continue..."
			RETURN .F.
		ENDIF
		
		*************************************
		*Count POitem in PurchaseOrder
		PRIVATE lFoundPOiteminPO
		lFoundPOiteminPO = .F.
		
		IF USED("tmpPO_cnt")	
			USE IN tmpPO_cnt
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.PurchaseOrder WITH(NOLOCK) "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND Cancelled = 0 "
		cSQL = cSQL + " AND WO <>"+STR(nCurrWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_cnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_cnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_cnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_cnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_cnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPO_cnt')
				IF tmpPO_cnt.Cnt > 0
					lFoundPOiteminPO = .T.
				ENDIF
				USE IN tmpPO_cnt
			ENDIF
		ENDIF
		
		
		IF NOT lFoundPOiteminPO
			MESSAGEBOX("Did not find POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrder table!",16,"Data not found!")
			RETURN .F.
		ENDIF
		
		************************************************
		*Check POitem in WO, See if they meant to Edit.
		PRIVATE lFoundPOitem, lCreateWO
		lFoundPOitem 	= .F.
		lCreateWO		= .T.
		
		PRIVATE cMess
		cMess = "POitem '"+cPOitem+"'"
		
		IF USED("tmpWO_POitemCnt")	
			USE IN tmpWO_POitemCnt
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND ISNULL(Cncld,0) = 0"
		cSQL = cSQL + " AND WO <> "+STR(nCurrWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_POitemCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_POitemCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_POitemCnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_POitemCnt')
				IF tmpWO_POitemCnt.Cntd > 0
					lFoundPOitem = .T.
					*cMess = "Found WO = "+ALLTRIM(STR(PrepareSQLnum(tmpWO_POitemCnt.WO,'WO',-3)))
					IF RECCOUNT('tmpWO_POitemCnt') > 1
						cMess = cMess + " with "+ALLTRIM(STR( RECCOUNT('tmpWO_POitemCnt') ))+" Records"
					ENDIF
					cMess = cMess + " using this POitem."
				ENDIF
				USE IN tmpWO_POitemCnt
			ENDIF
		ENDIF
		
		PRIVATE nMess
		IF lFoundPOitem
			*Show WO screen with POitem and Ask if they want to Edit That.
			nMess = MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was Found in another WO."+CHR(13)+cMess+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+"Answer No to continue with adding"+CHR(13)+"this PO item to this WO.",4+32+256,"Edit Other WO?") 
			IF nMess = 6
				*Edit the Other WO
				ThisFormSet.EditbyPOitem(pPOitem)
				*Could be renamed as 'Edit WO byPOitem' since POitem was found in WorkOrder
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE cMess
		cMess = "PO Item:"+ALLTRIM(cPOitem)
		**********************************************
		*Check POitem in WorkOrder_Detail, See if they meant to Edit.
		
		IF USED("tmpWO_POitemCnt")	
			USE IN tmpWO_POitemCnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder_Detail "
		cSQL = cSQL + " WHERE fPOitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND ISNULL(fCncld,0) = 0"
		*cSQL = cSQL + " AND WO <> "+STR(nCurrWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_POitemCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_POitemCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_POitemCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_POitemCnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_POitemCnt')
				IF tmpWO_POitemCnt.Cntd > 0
					lFoundPOitem = .T.
					*cMess = "Found WO_Detail = "+ALLTRIM(STR(PrepareSQLnum(tmpWO_POitemCnt.WO_Detail,'WO_Detail',-3)))
					IF RECCOUNT('tmpWO_POitemCnt') > 1
						cMess = cMess + " with "+ALLTRIM(STR( RECCOUNT('tmpWO_POitemCnt') ))+" Records."
					ENDIF			
		
				ENDIF
				USE IN tmpWO_POitemCnt
			ENDIF
		ENDIF
		
		IF lFoundPOitem
			*Show WO screen with POitem and Ask if they want to Edit That.
			nMess = MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was used in another WO Detail."+CHR(13)+cMess+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+CHR(13)+"(Y) Yes to edit."+CHR(13)+"(N)No to continue with adding this PO item to a NEW WO."+CHR(13)+CHR(13)+"A different input Size will need a new WO number.",4+32+256,"Edit old WO?(Y) or create new WO?(N)") 
			IF nMess = 6
				*Edit Other WOD
				ThisFormSet.EditbyPOitem(pPOitem)
				*Could be renamed as 'Edit WOD byPOitem' since POitem was found in WorkOrder_Detail
				RETURN .F.
			ENDIF
		ENDIF
		
		*********************************************
		*Get PurchaseOrder Data
		
		IF USED("tmpPO_POitem")	
			USE IN tmpPO_POitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * "
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Pounds, RandLen, Metric,'','','') AS Descript "
		cSQL = cSQL + ",dbo.f_BestDate(dbo.f_BestDate(Due_Min,Due_Max),dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max)) AS DueDate "
		cSQL = cSQL + ",LEFT(Cond_Spec,1000) AS Cond_Spec ,LEFT(Misc_Purch,1000) as Misc_Purch"
		cSQL = cSQL + "	FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_POitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_POitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_POitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_POitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_POitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPO_POitem')
				IF RECCOUNT('tmpPO_POitem') > 0
		
					ThisFormset.frmWorkOrder.txtPieces.Value 	= tmpPO_POitem.Pieces
					ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpPO_POitem.Alloy
					ThisFormset.frmWorkOrder.cmbForm.Value		= tmpPO_POitem.Form
					ThisFormSet.RefreshForms(tmpPO_POitem.Form)
					ThisFormset.frmWorkOrder.cmbCC.Value		= tmpPO_POitem.CC
					ThisFormSet.InitcmbCL()
					ThisFormset.frmWorkOrder.cmbCL.Value		= tmpPO_POitem.CL
					ThisFormset.frmWorkOrder.txtHeat.Value		= ''
					
					ThisFormset.frmWorkOrder.txtThck.Value		= tmpPO_POitem.Thck
					ThisFormset.frmWorkOrder.txtSz2.Value		= tmpPO_POitem.Sz2
					ThisFormset.frmWorkOrder.txtSz3.Value		= tmpPO_POitem.Sz3
					ThisFormSet.frmWorkOrder.chkPinSWeight.Value	= 0
					ThisFormset.frmWorkOrder.txtWeight.Value 	= tmpPO_POitem.Order_Qty
					*
					ThisFormSet.frmWorkOrder.txtStartDate.Value	= DATE()
					*ThisFormSet.frmWorkOrder.chkIntP.Value		= PrepareSQLlogic(0,'IntP')
					ThisFormSet.frmWorkOrder.chkRE.Value		= PrepareSQLlogic(0,'RE')
					ThisFormset.frmWorkOrder.txtDescript.Value 	= tmpPO_POitem.Descript
					ThisFormset.frmWorkOrder.edtWO_Notes.Value 	= tmpPO_POitem.Cond_Spec
					
					ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0 &&PrepareSQLnum(tmpWO.AC_ID_WO,'AC_ID',-3)
					
					*IF ThisFormSet.cWhat2 = "START"
						ThisFormSet.frmWorkOrder.txtPOitem.Value	= cPOitem 
						ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpPO_POitem.SOitem,'SOitem',10)
					*ELSE
					*use AddWOD_POitem if "FINISH"
					*	ThisFormSet.frmWorkOrder.txtPOitem.Value	= cPOitem 
					*	ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpPO_POitem.SOitem,'SOitem',10)
					*	*ThisFormSet.Refresh_frmWorkOrder_FPOitem(cPOitem)		
					*ENDIF
						
					ThisFormSet.frmWorkOrder.txtDueDate.Value	= PrepareSQLDate(tmpPO_POitem.DueDate,'DueDate')
					ThisFormSet.frmWorkOrder.txtSalesRep.Value	= AppSetup_Get_SalesRep_SalesP(tmpPO_POitem.SalesP)				
					
					**********************************************
					
					ThisFormSet.WO_POitem(nCurrWO, cPOitem, "ADD")							
					ThisFormSet.Set_frmWorkOrder('ENABLE')
					ThisFormSet.SetVfrmWorkOrder(.T.)
					
					**********************************************
					
					PRIVATE cMess
					cMess = "The PO was found and the WO screen has this data."
					cMess = cMess + CHR(13)+"The Start sizes have also been filled!"
					
					MESSAGEBOX(cMess,0+64,"WO is ready to Edit and Save.")
					
				ENDIF
				USE IN tmpPO_POitem
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE calc_addtest
		PARAMETERS pnInches
		*ThisFormSet.Calc_AddTest()
		
		IF VARTYPE(pnInches) != "N"
			MESSAGEBOX("Parameter Testing Inches not supplied.",48,"Cannot Calculate")
			RETURN .F.
		ELSE
			PRIVATE nInches
			nInches = pnInches
		ENDIF
		
		PRIVATE nsPieces, cAlloy, csForm, cCC, cCL, nsThck, nsSz2, nsSz3, nsWeight
		PRIVATE nfPieces, cfForm, nfThck, nfSz2, nfSz3, nfWeight
		
		nsPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12)
		csForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCL.Value,'CL',1)
		nsThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtThck.Value,'Thck',10,4)
		nsSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz2.Value,'sz2',9,3)
		nsSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz3.Value,'Sz3',9,3)
		nsWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtWeight.Value,'weight',7,1)
		
		nfPieces= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		cfForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
		nfThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfThck.Value,'Thck',10,4)
		nfSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfSz2.Value,'sz2',9,3)
		nfSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfSz3.Value,'Sz3',9,3)
		nfWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtfWeight.Value,'weight',7,1)
		
		
		IF NOT ( csForm = '10' OR cfForm = '10' )
			MESSAGEBOX("Only form BAR has been programmed.",48,"Cannot Calculate")
			RETURN .F.
		ENDIF
		*PRIVATE lUse3rdDim, luse3rdDim2
		*lsUse3rdDim = Uses3rdDim( csForm )
		*lfUse3rdDim = Uses3rdDim( cfForm )
		
		
		PRIVATE nNewfSz2, nNewsWeight, nNewfWeight, nsLentgh, nfLength
		PRIVATE nsLength
		nsLength = 0
		
		*PRIVATE lusesForm_Dim2
		*lusesForm_Dim2 = usesForm_Dim2(cfForm, ThisFormSet.nConnHandle)
		
		IF nsPieces = 0 OR nsSz2 = 0
			MESSAGEBOX("Need a Pc count, Dia and length on the START side.",48,"Cannot Calculate")
			RETURN .F.
		ELSE
			nsLength = nsSz2 * nsPieces
		ENDIF
		IF nfPieces = 0 OR nfSz2 = 0
			MESSAGEBOX("Need a Pc count, Dia and length on the FINISH side.",48,"Cannot Calculate")
			RETURN .F.
		ELSE
			nfLength = nfSz2 * nfPieces
		ENDIF
		
		
		nNewfSz2 = CEILING( nfLength + ( nInches /nfPieces ))
		
		nNewfWeight = CEILING( nfWeight * (nNewfSz2/nfLength))
		
		***
		*ThisFormSet.Calc("FINISH")
		***
		
		PRIVATE nStartSize, nRoughtSize, nNewRoughSizeWeight, nOverSize, nFinishSize, nNewStartSizeWeight
		nStartSize = PrepareSQLnum(ThisFormset.frmWorkOrder.txtStartSize.Value,'Thck',10,4)
		nRoughtSize	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtRoughSize.Value,'Thck',10,4)
		nNewRoughSizeWeight = 0
		nOverSize 	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		nFinishSize = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfThck.Value,'fThck',9,3)
		nNewStartSizeWeight = 0
		
		PRIVATE nNewsWeight
		nNewsWeight = 0
		
		*USE OverSize
		IF nRoughtSize = 0 AND nFinishSize > 0 
			IF nOverSize > 0
				nRoughtSize = nFinishSize + nOverSize 
			ELSE
				nRoughtSize = nFinishSize
			ENDIF
		ENDIF
		
		PRIVATE nsThckA, nfThckA
		nsThckA = (nsThck/2) * (nsThck/2)
		nfThckA = (nfThck/2) * (nfThck/2)
		
		IF ( nStartSize > 0 AND nRoughtSize > 0 )
			PRIVATE nStartSizeA, nRoughtSizeA
			nStartSizeA	= (nStartSize/2) * (nStartSize/2)
			nRoughtSizeA= (nRoughtSize/2) * (nRoughtSize/2)
		
			nNewRoughSizeWeight = nNewfWeight * (nRoughtSizeA / nfThckA)
			nNewStartSizeWeight = nNewRoughSizeWeight
			
			nNewsWeight = ROUND(nNewRoughSizeWeight * (nRoughtSizeA/nStartSizeA) ,0)
		ELSE
			*Do not use the StartSize, use nsThckA
			nNewsWeight = ROUND( nNewfWeight * (nsThckA/nfThckA) ,0)
		ENDIF
		
		PRIVATE nNewsLength, nNewsSz2
		nNewsLength = nsLength * (nNewsWeight / nsWeight)
		nNewsSz2	= nNewsLength / nsPieces
		
		IF nNewsWeight > 0
			ThisFormSet.frmWorkOrder.txtWeight.Value = nNewsWeight
			ThisFormSet.frmWorkOrder.txtfWeight.Value = nNewfWeight
			
			ThisFormSet.frmWorkOrder.txtSz2.Value = CEILING( nNewsSz2 )
			ThisFormSet.frmWorkOrder.txtfSz2.Value = CEILING( ( nfLength+nInches ) / nfPieces )
		
			
		ELSE
			MESSAGEBOX("New Start Weight calcualted to 0.",48,"Cannot finish Calculating")
			RETURN .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE calc_f_length
		*ThisFormSet.Calc_F_Length()
		
		PRIVATE nsPieces, cAlloy, csForm, cCC, cCL, nsThck, nsSz2, nsSz3, nsWeight
		PRIVATE nfPieces, cfForm, nfThck, nfSz2, nfSz3, nfWeight
		nsPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12)
		csForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCL.Value,'CL',1)
		nsThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtThck.Value,'Thck',10,4)
		nsSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz2.Value,'sz2',9,3)
		nsSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz3.Value,'Sz3',9,3)
		nsWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtWeight.Value,'Weight',7,1)
		
		nfPieces= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		cfForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
		nfThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfThck.Value,'Thck',10,4)
		nfSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfSz2.Value,'sz2',9,3)
		nfSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtfSz3.Value,'Sz3',9,3)
		nfWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtfWeight.Value,'weight',9,1)
		
		PRIVATE ns2Thck, nfThck2
		
		IF NOT ( csForm = '10' OR cfForm = '10' )
			MESSAGEBOX("Only form BAR has been programmed.",48,"Cannot Calculate")
			RETURN .F.
		ENDIF
		*PRIVATE lUse3rdDim, luse3rdDim2
		*lsUse3rdDim = Uses3rdDim( csForm )
		*lfUse3rdDim = Uses3rdDim( cfForm )
		*************************
		PRIVATE lPinsWeight, lPinfWeight
		lPinsWeight = PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkPinSWeight.Value,'PinSWeight')
		lPinfWeight = PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkPinFWeight.Value,'PinFWeight')
		
		PRIVATE nNewsWeight, nNewfWeight, nsLength, nfLength
		PRIVATE nNewfLength
		nNewfLength = 0
		PRIVATE nMess
		nMess = 0
		
		************************
		PRIVATE nNewsWeight
		nNewsWeight = FLOOR(ThisFormSet.p_Calc_Weight(nsPieces, cAlloy, csForm, cCC, cCL, nsThck, nsSz2, nsSz3))
		
		************************
		IF NOT (((nNewsWeight+10)*1.1 > (nsWeight+10)) AND ((nNewsWeight+10)*.9 < (nsWeight +10)))
			nMess = MESSAGEBOX("Listed Start Weight "+STR(nsWeight)+CHR(13)+"and Calculated Weight "+STR(nNewsWeight)+CHR(13)+"Do Not Match!"+CHR(13)+"Do you want to use new Calc Weight? (Y)",4+32,"Use new Weight?")
			IF nMess = 6
				IF lPinsWeight
					MESSAGEBOX("Cannot change the Start Weight"+CHR(13)+"Weight is Pinned",16,"Weight is Pinned")
					RETURN
				ELSE
					nsWeight = nNewsWeight 
					ThisFormset.frmWorkOrder.txtWeight.Value = nNewsWeight
				ENDIF
			ELSE
				IF lPinsWeight
					MESSAGEBOX("Continue with Calc using the pinned Weight "+STR(nsWeight),48,"Proceding")
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF	
		
		************************
		IF nsPieces = 0 OR nsSz2 = 0
			MESSAGEBOX("Need a Pc count, Dia and length on the START side.",48,"Cannot Calculate")
			RETURN .F.
		ELSE
			nsLength = nsSz2 * nsPieces
		ENDIF
		
		************************
		IF nfPieces = 0 
			nfPieces = 1	&&Guess on finish PC
			ThisFormset.frmWorkOrder.txtFPieces.Value	= 1
		ENDIF
		
		************************
		PRIVATE nStartSize, nNewStartSizeWeight
		nStartSize = PrepareSQLnum(ThisFormset.frmWorkOrder.txtStartSize.Value,'Thck',10,4)
		IF nStartSize > 0
			nNewStartSizeWeight = FLOOR(ThisFormSet.p_Calc_Weight(nsPieces, cAlloy, csForm, cCC, cCL, nStartSize, nsSz2, nsSz3))
		ELSE
			nNewStartSizeWeight = nNewsWeight
		ENDIF
		
		************************
		PRIVATE nRoughtSize, nNewRoughSizeWeight 
		nRoughtSize	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtRoughSize.Value,'Thck',10,4)
		IF nRoughtSize > 0
			IF nStartSize > 0
				nNewRoughSizeWeight = nNewStartSizeWeight
			ELSE
				nNewRoughSizeWeight = nNewsWeight
			ENDIF
		ELSE
			nNewRoughSizeWeight = nNewsWeight
		ENDIF
		
		************************
		* 100 Inch long Weight
		PRIVATE n100fWeight
		n100fWeight = 0
		
		IF nNewsWeight = 0 AND nNewStartSizeWeight = 0
			*Do nothing
		ELSE
			IF nRoughtSize = 0
				*use nRoughtSize 
				n100fWeight = ThisFormSet.p_Calc_Weight(1, cAlloy, csForm, cCC, cCL, nRoughtSize, 100, nfSz3)
			ELSE
				n100fWeight = ThisFormSet.p_Calc_Weight(1, cAlloy, csForm, cCC, cCL, nfThck, 100, nfSz3)
			ENDIF		
		ENDIF
		
		************************
		PRIVATE nNewfSz2
		nNewfSz2 = 0
		IF n100fWeight > 0
			IF nRoughtSize > 0
				nNewfLength = ( nNewRoughSizeWeight / n100fWeight )* 100
			ELSE
				nNewfLength = ( nNewsWeight / n100fWeight )* 100
			ENDIF
			
			nNewfSz2 = FLOOR( nNewfLength / nfPieces )
			
			*Remove Forged cupping
			IF nNewfSz2 > 12
				nNewfSz2 = nNewfSz2 - 6
				WAIT WINDOW 'Removing 6" from each bar for Forge Cupping' TIMEOUT 2
			ENDIF
			ThisFormSet.frmWorkOrder.txtfSz2.Value = nNewfSz2
			
			IF nRoughtSize > 0
				nfWeight = FLOOR(ThisFormSet.p_Calc_Weight(nfPieces, cAlloy, csForm, cCC, cCL, nRoughtSize, nNewfSz2, nfSz3))
			ELSE
				nfWeight = FLOOR(ThisFormSet.p_Calc_Weight(nfPieces, cAlloy, csForm, cCC, cCL, nfThck, nNewfSz2, nfSz3))
			ENDIF
			ThisFormset.frmWorkOrder.txtfWeight.Value = nfWeight
			
		ELSE
			MESSAGEBOX("Cannot calculate Length.",48,"Cannot finish Calculating")
			RETURN .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE calc_length
		PARAMETER pcWhere
		*ThisFormSet.Calc_Length('START')
		*ThisFormSet.Calc_Length('FINISH')
		
		IF VARTYPE(pcWhere) != 'C'
			pcWhere = 'START'
		ENDIF
		
		PRIVATE nPieces, cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3, nWeight
		PRIVATE cCurrTable, nCalcMachWeight, cCommonSpec 
		cCurrTable = ALIAS()
		
		IF pcWhere = 'START'
			nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtThck.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz2.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz3.Value,'Sz3',9,3)
			nWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtWeight.Value,'weight',7,1)
		ELSE
			nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFthck.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz2.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz3.Value,'Sz3',9,3)
			nWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtFWeight.Value,'Weight',7,1)
		ENDIF
		
		
		IF NOT ( nWeight > 0 AND NOT EMPTY(cAlloy) AND nThck > 0 )
			RETURN
		ENDIF
		
		
		PRIVATE nStandardThickness
		nStandardThickness	= ALLTRIM(Remove0( nThck,9,4 ))
		
		
		IF EMPTY(cForm)
			MESSAGEBOX("Please check the form."+CHR(13)+"Defaulted form to '10'.",0,"No form")
			cForm = '10'
			IF pcWhere = 'START'
				ThisFormset.frmWorkOrder.cmbForm.Value = '10'
			ELSE
				ThisFormset.frmWorkOrder.cmbFForm.Value = '10'
			ENDIF
		ENDIF
		
		**************************************
		
		PRIVATE lUse3rdDim
		lUse3rdDim = Uses3rdDim( cForm )
		
		IF NOT lUse3rdDim AND nSz2=0 AND nSz3>0
			*nSZ2 was listed as Width and nSz3 was listed as Length
			*Since there is no need for nSz3, move the nSz3 number to nSz2
			nSz2 = nSz3
			nSz3 = 0
			IF pcWhere = 'START'
				ThisFormset.frmWorkOrder.txtSz2.Value = nSz2
				ThisFormset.frmWorkOrder.txtSz3.Value = nSz3 
			ELSE
				ThisFormset.frmWorkOrder.txtFSz2.Value = nSz2 
				ThisFormset.frmWorkOrder.txtFSz3.Value = nSz3
			ENDIF
		ENDIF
		
		**************************************
		
		PRIVATE nForceBracket
		nForceBracket = 0
		
		*******************************************************************************
		IF NOT luse3rdDim AND nThck > 0 AND nSz2 = 0 AND nWeight > 0
			
			*Find Length
			*Use 100" for easy math
			nSz2 = 100
			
			PRIVATE cSQL
			cSQL = "EXEC dbo.p_GetFullQuoteCL "
			cSQL = cSQL + STR(nPieces)
			cSQL = cSQL + ",'"+cAlloy+"'"
			cSQL = cSQL + ",'"+cForm+"'"
			cSQL = cSQL + ",'"+cCC+"'"
			cSQL = cSQL + ",'"+cCL+"'"
			cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
			cSQL = cSQL + ",''" &&CustID
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				
				PRIVATE cMess
				cMess = "Could not get the Price!"+CHR(13)
				IF nPieces > 10000
					cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
				ENDIF
				IF nThck > 16
					cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
				ENDIF
				IF nSz2	> 120
					cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
				ENDIF
				IF nSz3	 > 300
					cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
				ENDIF
				MESSAGEBOX(cMess,16,"Edit your input numbers")
				
			ENDIF
		
			IF USED('tmpPriceTbl')
				IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
					IF tmpPriceTbl.Pounds > 0
						nSz2 = (100/tmpPriceTbl.Pounds) * nWeight 
						IF pcWhere = 'START'
							ThisFormset.frmWorkOrder.txtSz2.Value = nSz2
						ELSE
							ThisFormset.frmWorkOrder.txtFSz2.Value = nSz2
						ENDIF
					ENDIF
				ENDIF
				USE IN tmpPriceTbl
			ENDIF
		ENDIF
		
		
		*******************************************************************************
		IF luse3rdDim AND nThck > 0 AND nSz2 > 0 AND nSz3 = 0 AND nWeight > 0
			
			*Find Length
			*Use 100" for math
			nSz3 = 100
			
			PRIVATE cSQL
			cSQL = "EXEC dbo.p_GetFullQuoteCL "
			cSQL = cSQL + STR(nPieces)
			cSQL = cSQL + ",'"+cAlloy+"'"
			cSQL = cSQL + ",'"+cForm+"'"
			cSQL = cSQL + ",'"+cCC+"'"
			cSQL = cSQL + ",'"+cCL+"'"
			cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
			cSQL = cSQL + ",''" &&CustID
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				
				PRIVATE cMess
				cMess = "Could not get the Price!"+CHR(13)
				IF nPieces > 10000
					cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
				ENDIF
				IF nThck > 16
					cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
				ENDIF
				IF nSz2	> 120
					cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
				ENDIF
				IF nSz3	 > 300
					cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
				ENDIF
				MESSAGEBOX(cMess,16,"Edit your input numbers")
				
			ENDIF
		
			IF USED('tmpPriceTbl')
				IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
					IF tmpPriceTbl.Pounds > 0
						nSz3 = tmpPriceTbl.Pounds * (100/nWeight)
		*!*					IF USED('SELECT tmpVendorStock')
		*!*						SELECT tmpVendorStock
		*!*						REPLACE tmpVendorStock.Length WITH STR(nSz3,10,2)
		*!*						IF pFrm = "VendorImport"
		*!*							ThisFormSet.frmVendorImport.Sz31.Value = VAL( STR(nSz3,10,2) )
		*!*							ThisFormSet.frmVendorImport.Sz31.Refresh
		*!*							ThisFormSet.frmVendorImport.Pieces1.Value = nPieces
		*!*						ENDIF
		*!*					ENDIF
						
						IF pcWhere = 'START'
							ThisFormset.frmWorkOrder.txtSz3.Value = VAL( STR(nSz3,10,2) )
							ThisFormSet.frmWorkOrder.txtPieces.Value = nPieces
						ELSE
							ThisFormset.frmWorkOrder.txtFPieces.Value = nPieces
						ENDIF
		
					ENDIF
				ENDIF
				USE IN tmpPriceTbl
			ENDIF
		ENDIF
		*******************************************************
		
		*Double check PC
		**************************************
		IF pcWhere = 'START'
			nPieces = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		ELSE
			nPieces = PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		ENDIF
		
		IF nPieces = 0 
			IF (!luse3rdDim AND nThck > 0 AND nSz2 > 0 AND nWeight > 0 ) OR (luse3rdDim AND nThck > 0 AND nSz2 > 0 AND nSz3 > 0 AND nWeight > 0)
				*recalc PCs
		
				PRIVATE cSQL
				cSQL = "EXEC dbo.p_GetFullQuoteCL "
				cSQL = cSQL + "1"  &&nPieces
				cSQL = cSQL + ",'"+cAlloy+"'"
				cSQL = cSQL + ",'"+cForm+"'"
				cSQL = cSQL + ",'"+cCC+"'"
				cSQL = cSQL + ",'"+cCL+"'"
				cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
				cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
				cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
				cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
				cSQL = cSQL + ",''" &&CustID
			
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					
					PRIVATE cMess
					cMess = "Could not get the Price!"+CHR(13)
					*IF nPieces > 10000
					*	cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
					*ENDIF
					IF nThck > 16
						cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
					ENDIF
					IF nSz2	> 120
						cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
					ENDIF
					IF nSz3	 > 300
						cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
					ENDIF
					MESSAGEBOX(cMess,16,"Edit your input numbers")
					
				ENDIF
		
				IF USED('tmpPriceTbl')
					IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
						IF tmpPriceTbl.Pounds > 0
							nPieces = ROUND(nWeight / tmpPriceTbl.Pounds ,0)
		
							IF pcWhere = 'START'
								ThisFormSet.frmWorkOrder.txtPieces.Value = nPieces
							ELSE
								ThisFormset.frmWorkOrder.txtFPieces.Value = nPieces
							ENDIF
		
						ENDIF
					ENDIF
					USE IN tmpPriceTbl
				ENDIF
		
			ENDIF
		ENDIF
		
		*************************************
		PRIVATE lPinWeight
		IF pcWhere = 'START'
			lPinWeight = PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkPinSWeight.Value,'PinSWeight')
		ELSE
			lPinWeight = PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkPinFWeight.Value,'PinFWeight')
		ENDIF
		
		
		*Get Weight
		**************************************
		
		IF nPieces > 0 
			IF nWeight= 0
				*calc weight
		
				PRIVATE cSQL
				cSQL = "EXEC dbo.p_GetFullQuoteCL "
				cSQL = cSQL + STR(nPieces)
				cSQL = cSQL + ",'"+cAlloy+"'"
				cSQL = cSQL + ",'"+cForm+"'"
				cSQL = cSQL + ",'"+cCC+"'"
				cSQL = cSQL + ",'"+cCL+"'"
				cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
				cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
				cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
				cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
				cSQL = cSQL + ",''" &&CustID
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					
					PRIVATE cMess
					cMess = "Could not get the Price!"+CHR(13)
					IF nPieces > 10000
						cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
					ENDIF
					IF nThck > 16
						cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
					ENDIF
					IF nSz2	> 120
						cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
					ENDIF
					IF nSz3	 > 300
						cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
					ENDIF
					MESSAGEBOX(cMess,16,"Edit your input numbers")
					
				ENDIF
		
				IF USED('tmpPriceTbl')
					IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
						IF tmpPriceTbl.Pounds > 0
							nWeight = tmpPriceTbl.Pounds
		
							IF pcWhere = 'START'
								IF lPinWeight
									MESSAGEBOX("Calculated Weight to be "+ALLTRIM(STR(nWeight))+CHR(13)+"Weight will not be updated while 'pinned'",64,"Start Weight")
								ELSE
									ThisFormSet.frmWorkOrder.txtWeight.Value = nWeight 
								ENDIF
							ELSE
								IF lPinWeight
									MESSAGEBOX("Calculated Weight to be "+ALLTRIM(STR(nWeight))+CHR(13)+"Weight will not be updated while 'pinned'",64,"Finish Weight")
								ELSE
									ThisFormSet.frmWorkOrder.txtFWeight.Value = nWeight 
								ENDIF
							ENDIF
		
						ENDIF
					ENDIF
					USE IN tmpPriceTbl
				ENDIF
		
			ENDIF
		ENDIF
		
		************************
		
		PRIVATE cDescript, lRandLen, lMetric, cSz1orig, cSz2orig, cSz3orig
		cDescript = ''
		lRandLen = .T.
		lMetric = .F.
		cSz1orig = ''
		cSz2orig = ''
		cSz3orig = ''
		cDescript = DescriptionMetricReport(nPieces, cForm, nThck, nSZ2, nSZ3, nWeight, lRandLen, lMetric, cSz1orig, cSz2orig, cSz3orig)
		
		*IF LEN(cDescript) > 0
			IF pcWhere = 'START'
				ThisFormSet.frmWorkOrder.txtDescript.Value = cDescript
			ELSE
				ThisFormSet.frmWorkOrder.txtfDescript.Value = cDescript
			ENDIF
		*ELSE
		
		*ENDIF	
		
		
	ENDPROC

	PROCEDURE calc_piece
		PARAMETER pcWhere
		*ThisFormSet.Calc_Piece('START')
		*ThisFormSet.Calc_Piece('FINISH')
		
		IF VARTYPE(pcWhere) != 'C'
			pcWhere = 'START'
		ENDIF
		
		PRIVATE nPieces, cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3, nWeight
		PRIVATE cCurrTable, nCalcMachWeight, cCommonSpec 
		cCurrTable = ALIAS()
		
		IF pcWhere = 'START'
			nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtThck.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz2.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz3.Value,'Sz3',9,3)
			nWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtWeight.Value,'weight',7,1)
		ELSE
			nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFthck.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz2.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz3.Value,'Sz3',9,3)
			nWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtFWeight.Value,'Weight',7,1)
		ENDIF
		
		
		IF NOT ( nWeight > 0 AND NOT EMPTY(cAlloy) AND nThck > 0 )
			RETURN
		ENDIF
		
		
		PRIVATE nStandardThickness
		nStandardThickness	= ALLTRIM(Remove0( nThck,9,4 ))
		
		
		IF EMPTY(cForm)
			MESSAGEBOX("Please check the form."+CHR(13)+"Defaulted form to '10'.",0,"No form")
			cForm = '10'
			IF pcWhere = 'START'
				ThisFormset.frmWorkOrder.cmbForm.Value = '10'
			ELSE
				ThisFormset.frmWorkOrder.cmbFForm.Value = '10'
			ENDIF
		ENDIF
		
		**************************************
		
		PRIVATE lUse3rdDim
		lUse3rdDim = Uses3rdDim( cForm )
		
		IF NOT lUse3rdDim AND EMPTY(nSz2) AND NOT EMPTY(nSz3)
			*nSZ2 was listed as Width and nSz3 was listed as Length
			*Since there is no need for nSz3, move the nSz3 number to nSz2
			nSz2 = nSz3
			nSz3 = 0
			IF pcWhere = 'START'
				ThisFormset.frmWorkOrder.txtSz2.Value = nSz3 
			ELSE
				ThisFormset.frmWorkOrder.txtFSz2.Value = nSz3 
			ENDIF
		ENDIF
		
		**************************************
		
		PRIVATE nForceBracket
		nForceBracket = 0
		
		
		*Get PCs
		**************************************
		
		IF nWeight > 0 
		
			*calc Pieces
			nPieces = 1
		
			PRIVATE cSQL
			cSQL = "EXEC dbo.p_GetFullQuoteCL "
			cSQL = cSQL + STR(nPieces)
			cSQL = cSQL + ",'"+cAlloy+"'"
			cSQL = cSQL + ",'"+cForm+"'"
			cSQL = cSQL + ",'"+cCC+"'"
			cSQL = cSQL + ",'"+cCL+"'"
			cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
			cSQL = cSQL + ",''" &&CustID
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				
				PRIVATE cMess
				cMess = "Could not get the Price!"+CHR(13)
				IF nPieces > 10000
					cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
				ENDIF
				IF nThck > 16
					cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
				ENDIF
				IF nSz2	> 120
					cMess = cMess + "Your secon Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
				ENDIF
				IF nSz3	 > 300
					cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
				ENDIF
				MESSAGEBOX(cMess,16,"Edit your input numbers")
				
			ENDIF
		
			IF USED('tmpPriceTbl')
				IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
					IF tmpPriceTbl.Pounds > 0
						nPieces = nWeight / tmpPriceTbl.Pounds 
		
						IF pcWhere = 'START'
							ThisFormSet.frmWorkOrder.txtPieces.Value = nPieces
						ELSE
							ThisFormset.frmWorkOrder.txtFPieces.Value = nPieces
						ENDIF
		
					ENDIF
				ENDIF
				USE IN tmpPriceTbl
			ENDIF
		
		
		ENDIF
		
		
	ENDPROC

	PROCEDURE calc_startsizeweight
		*ThisFormSet.Calc_StartSizeWeight()
		
		
		PRIVATE nPieces, cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3, nWeight
		
		nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCL.Value,'CL',1)
		nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtStartSize.Value,'Thck',10,4)
		nSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz2.Value,'sz2',9,3)
		nSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz3.Value,'Sz3',9,3)
		nWeight = 0
			
			
			
		PRIVATE nStandardThickness
		nStandardThickness	= ALLTRIM(Remove0( nThck,9,4 ))
		
		
		PRIVATE nForceBracket
		nForceBracket = .F.
		
		*****************************
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.p_GetFullQuoteCL "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",'"+cCL+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		cSQL = cSQL + ",''" &&CustID
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			
			PRIVATE cMess
			cMess = "Could not get the Price!"+CHR(13)
			IF nPieces > 10000
				cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
			ENDIF
			IF nThck > 16
				cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
			ENDIF
			IF nSz2	> 120
				cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
			ENDIF
			IF nSz3	 > 300
				cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
			ENDIF
			MESSAGEBOX(cMess,16,"Edit your input numbers")
			
		ENDIF
		
		*!*	SELECT @nPounds AS Pounds, @lnSurcharge AS Surcharge, @nCutPounds AS CutPounds
		*!*	, @nPrice AS Price, @nBracket AS Bracket
		*!*	, @nStdSize AS StdSize
		*!*	, @cAlloy AS StdAlloy
		*!*	, @nDensity AS Density
		*!*	, @cMessage AS WeightMess
		*!*	, @cPTMessage AS PriceMess, @bActivePrice AS ActivePrice
		*************************************
		
		IF USED('tmpPriceTbl')
		
			IF EMPTY(tmpPriceTbl.Density)
				IF NOT EMPTY(cAlloy)
					MESSAGEBOX("USING .290 DENSITY  - THE REAL FIGURE SHOULD BE PROGRAMED",0+64,"Alloy Density not found")
				ENDIF
		*		nDensity = .29
			ELSE 
		*		nDensity = tmpPriceTbl.Density
			ENDIF
		
			IF USED('tmpPriceTbl')
				IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
					IF tmpPriceTbl.Pounds > 0
						nWeight = tmpPriceTbl.Pounds
					ENDIF
				ENDIF
				USE IN tmpPriceTbl
			ENDIF
		
			
		ENDIF
		
		RETURN nWeight
		
		
	ENDPROC

	PROCEDURE calc_weight
		PARAMETER pcWhere, lQuiet
		*ThisFormSet.Calc_Weight("START",.T.)
		*ThisFormSet.Calc_Weight("FINISH",.T.)
		
		IF VARTYPE(pcWhere) != 'C'
			pcWhere = 'START'
		ENDIF
		IF VARTYPE(lQuiet) != "L"
			lQuiet = .F.
		ENDIF
		
		PRIVATE nPieces, cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3, nWeight
		PRIVATE nPieces2, cForm2
		PRIVATE cCurrTable, nCalcMachWeight, cCommonSpec
		cCurrTable = ALIAS()
		
		IF pcWhere = 'START'
			nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
			nPieces2= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
			cForm2	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtThck.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz2.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz3.Value,'Sz3',9,3)
			nWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtWeight.Value,'weight',7,1)
			
			*IF Sz2 or Weight is missing, see if it is a reduction to the Finish Dims
		ELSE
			*pcWhere = 'FINISH'
			nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
			nPieces2= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
			cForm2	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFthck.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz2.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz3.Value,'Sz3',9,3)
			nWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtFWeight.Value,'Weight',7,1)
			
			*IF Sz2 or Weight is missing, see if it is a reduction to the Finish Dims
		ENDIF
		
		*********************************************
		*Check
		IF pcWhere = 'FINISH'
			IF EMPTY(cAlloy)
				IF NOT EMPTY(PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12))
					cAlloy = PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12)
					ThisFormset.frmWorkOrder.txtFAlloy.Value = cAlloy
				ENDIF
			ENDIF
			***
			IF EMPTY(cForm)
				IF NOT EMPTY(PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2))
					cForm = PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
					ThisFormset.frmWorkOrder.cmbFForm.Value = cForm
				ENDIF
			ENDIF
		ENDIF
		*IF NOT ( nWeight > 0 AND NOT EMPTY(cAlloy) AND nThck > 0 )
		*	RETURN
		*ENDIF
		
		*IF nSz2 > 0
		
		
		PRIVATE nStandardThickness
		nStandardThickness	= ALLTRIM(Remove0( nThck,9,4 ))
		
		
		IF EMPTY(cForm)
			IF NOT lQuiet
				MESSAGEBOX("Please check the form."+CHR(13)+"Defaulted form to '10'.",0,"No form")
			ENDIF
			cForm = '10'
			IF pcWhere = 'START'
				ThisFormset.frmWorkOrder.cmbForm.Value = '10'
			ELSE
				ThisFormset.frmWorkOrder.cmbFForm.Value = '10'
			ENDIF
		ENDIF
		
		**************************************
		
		PRIVATE lUse3rdDim, luse3rdDim2
		lUse3rdDim = Uses3rdDim( cForm )
		lUse3rdDim2 = Uses3rdDim( cForm2 )
		
		*test should not be needed.  only bar is in WO
		IF NOT lUse3rdDim AND EMPTY(nSz2) AND NOT EMPTY(nSz3)
			*nSZ2 was listed as Width and nSz3 was listed as Length
			*Since there is no need for nSz3, move the nSz3 number to nSz2
			nSz2 = nSz3
			nSz3 = 0
			IF pcWhere = 'START'
				ThisFormset.frmWorkOrder.txtSz2.Value = nSz2 
				ThisFormset.frmWorkOrder.txtSz3.Value = nSz3
			ELSE
				ThisFormset.frmWorkOrder.txtFSz2.Value = nSz2
				ThisFormset.frmWorkOrder.txtFSz3.Value = nSz3
			ENDIF
		ENDIF
		
		*********
		PRIVATE nForceBracket
		nForceBracket = 0
		
		*******************************************************************************
		
		IF luse3rdDim 
			IF nThck > 0 AND nSz2 > 0 AND nSz3 = 0 AND nWeight > 0
				ThisFormSet.Calc_Length(pcWhere)
				*RETURN 
				IF pcWhere = 'START'
					nSz3 	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz3.Value,'Sz3',9,3)
				ELSE
					nSz3 	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz3.Value,'Sz3',9,3)
				ENDIF
			ENDIF
		ELSE
			IF nThck > 0 AND nSz2 = 0 AND nWeight > 0
				ThisFormSet.Calc_Length(pcWhere)
				*RETURN 
				IF pcWhere = 'START'
					nSz2 	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz2.Value,'Sz2',9,3)
				ELSE
					nSz2 	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz2.Value,'Sz2',9,3)
				ENDIF
			ENDIF
		ENDIF
		
		*******************************************************************************
		** Get Pieces
		IF nPieces = 0
			IF luse3rdDim 
				IF nThck > 0 AND nSz2 > 0 AND nSz3 > 0 AND nWeight > 0
					ThisFormSet.Calc_Piece(pcWhere)
					*RETURN 
					IF pcWhere = 'START'
						nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
						nPieces2= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
					ELSE
						nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
						nPieces2= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)		
					ENDIF
				ENDIF
			ELSE
				IF nThck > 0 AND nSz2 > 0 AND nWeight > 0
					ThisFormSet.Calc_Piece(pcWhere)
					*RETURN 
					IF pcWhere = 'START'
						nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
						nPieces2= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
					ELSE
						nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
						nPieces2= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)		
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*******************************************************************************
		
		*IF cForm <> cForm2
		IF GetFormSort(cForm, ThisFormSet.nConnHandle) <> GetFormSort(cForm2, ThisFormSet.nConnHandle) 
			IF nPieces = nPieces2
				IF NOT lQuiet
					IF lUse3rdDim = lUse3rdDim2 
						*MESSAGEBOX("Pieces are the same"+CHR(13)+"but Form suggest it should be different!",64,"No Error, just caution.")
					ELSE
						*WAIT WINDOW "Form suggests the last dimension could change!"
						*MESSAGEBOX("Pieces are the same"+CHR(13)+"but Form suggest it could be different!",64,"No Error, just caution.")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		*******************************************************************************
		
		IF nPieces = 0
			nPieces = 1
		ENDIF
		
		*************************************
		
		PRIVATE lPinWeight
		IF pcWhere = 'START'
			lPinWeight = PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkPinSWeight.Value,'PinSWeight')
		ELSE
			lPinWeight = PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkPinFWeight.Value,'PinFWeight')
		ENDIF
		
		************************
		PRIVATE nNewWeight, nStartSize, nRoughSize, nOverSize, nWeightStart, nLostweight 
		nNewWeight = FLOOR(ThisFormSet.p_Calc_Weight(nPieces, cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3))
		nStartSize = PrepareSQLnum(ThisformSet.frmWorkOrder.txtStartSize.Value,'StartSize',10,4) 
		nRoughSize = PrepareSQLnum(ThisFormset.frmWorkOrder.txtRoughSize.Value,'RoughSize',9,3)
		nOverSize 	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		nWeightStart = PrepareSQLnum(ThisFormset.frmWorkOrder.txtWeight.Value,'Weight',7,1)
		nLostweight =  PrepareSQLnum(ThisFormset.frmWorkOrder.txtLostWeight.Value,'Weight',7,1)
		
		IF nNewWeight = 0 &&try to Reverse Engineer by Finish length
			IF pcWhere = 'FINISH'
				IF nRoughSize > 0 AND nSz2 = 0
					*use RoughSize
					IF nWeightStart > 0
						*Calculate Finish SZ2 with Start Weight and RoughSize
						nNewWeight = FLOOR(ThisFormSet.p_Calc_Weight(1, cAlloy, cForm, cCC, cCL, nRoughSize, 100, nSz3))
						nSz2 = FLOOR( ( nWeightStart /( nNewWeight/100 ) ) / nPieces )
						ThisFormset.frmWorkOrder.txtFSz2.Value = nSz2
						
						nNewWeight = nWeightStart
						nLostweight = nWeightStart - FLOOR(ThisFormSet.p_Calc_Weight(nPieces, cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3))
						ThisFormset.frmWorkOrder.txtLostWeight.Value = nLostweight 
					ENDIF
		
				ELSE
					*no RoughSize
					IF nThck > 0 AND nSz2 = 0
						IF nWeightStart > 0
							*Calculate Finish SZ2 with Start Weight and Finish Dia
							nNewWeight = FLOOR(ThisFormSet.p_Calc_Weight(1, cAlloy, cForm, cCC, cCL, nThck, 100, nSz3))
							nSz2 = FLOOR( ( nWeightStart /( nNewWeight/100 ) ) / nPieces )
							
							nNewWeight = nWeightStart
							ThisFormset.frmWorkOrder.txtFSz2.Value = nSz2
						ENDIF
					ENDIF
				ENDIF
				IF nRoughSize > 0 AND nThck > 0
					nOverSize = nRoughSize - nThck
					ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(nOverSize,'OverSize',5,3)
				ENDIF
			ENDIF
		ENDIF	&&End try to Reverse Engineer the Finish length
		
		******************************************
		
		IF nNewWeight > 0
			IF pcWhere = 'START'
				IF lPinWeight
					IF NOT lQuiet
						MESSAGEBOX("Calculated Weight to be "+ALLTRIM(STR(nNewWeight))+CHR(13)+"Weight will not be updated while 'pinned'",64,"Start Weight")
					ENDIF
				ELSE
					ThisFormSet.frmWorkOrder.txtWeight.Value = nNewWeight
				ENDIF
			ELSE
				IF lPinWeight
					IF NOT lQuiet
						MESSAGEBOX("Calculated Weight to be "+ALLTRIM(STR(nNewWeight))+CHR(13)+"Weight will not be updated while 'pinned'",64,"Finish Weight")
					ENDIF
				ELSE
					ThisFormSet.frmWorkOrder.txtFWeight.Value = nNewWeight
				ENDIF
			ENDIF
			
		*	ThisFormSet.Set_frmWorkOrder_Descript(pcWhere)
			
		ELSE
			*MESSAGEBOX("Could not Calculate Weight",0,"No Pounds")
			IF NOT lQuiet
				WAIT WINDOW "Could not Calculate Weight, No Pounds" NOWAIT
			ENDIF 
		ENDIF
		
		
		*!*	******************************************
		*!*	*nLostweight 
		*!*	PRIVATE nFWeight,nSWeight,nLostweight 
		*!*	nFWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtFWeight.Value,'Weight',7,1)
		*!*	nSWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtWeight.Value,'weight',7,1)
		*!*	nLostweight =  PrepareSQLnum(ThisFormset.frmWorkOrder.txtLostWeight.Value,'Weight',7,1)
		
		*!*	IF nLostweight = 0 AND pcWhere = 'FINISH' AND nFWeight > 0 AND nSWeight > 0
		*!*		nLostweight = nSWeight - nFWeight 
		*!*		IF nLostweight  > 1
		*!*			IF NOT lQuiet
		*!*				*IF MESSAGEBOX("Do you want to replace the LostWeight with the calculated "+ALLTRIM(STR(nLostweight,7,1))+"?",4+32,"Store Lost weight?") = 6
		*!*				*	ThisFormset.frmWorkOrder.txtLostWeight.Value = nLostweight 
		*!*				*ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE checkfinish_id_detail
		*ThisFormSet.CheckFinish_ID_Detail()
		
		PRIVATE nBegin_ID_Detail, nID_Detail, nID_Detail_Process, cTBL
		nBegin_ID_Detail = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail.Value,'ID_Detail',-3)
		nID_Detail = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail.Value,'ID_Detail',-3)
		nID_Detail_Process = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value,'ID_Detail_Process',-3)
		cTBL = ""
		
		PRIVATE cSOItem, cPOItem
		cSOItem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		cPOItem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFPOitem.Value,'POitem',12)
		
		PRIVATE lHaveSO, lHavePO
		IF Proper_SO_item(cSOItem) != Proper_SO_item('')
			lHaveSO = .T.
		ELSE
			lHaveSO = .F.
		ENDIF
		IF Proper_PO_item(cPOItem) != Proper_PO_item('')
			lHavePO = .T.
		ELSE
			lHavePO = .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		IF nID_Detail = 0
			IF lHavePO 
				*PO is for bringing in Stock!
				*Get ID_Detail FROM StockLst_Detail
		
				cSQL = " SELECT D.ID_Detail, 'S' AS TBL "
				cSQL = cSQL +" FROM dbo.StockLst_Detail D "
				cSQL = cSQL +" INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
				cSQL = cSQL +"  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL +" UNION "
				cSQL = cSQL +" SELECT D.ID_Detail, 'B' AS TBL"
				cSQL = cSQL +" FROM dbo.BrokerLst_Detail D "
				cSQL = cSQL +" INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
				cSQL = cSQL +"  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL +" UNION "
				cSQL = cSQL +" SELECT D.ID_Detail, 'W' AS TBL"
				cSQL = cSQL +" FROM dbo.WIPLst_Detail D "
				cSQL = cSQL +" INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
				cSQL = cSQL +"  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				
				IF USED("tmpStockLst_Detail")
					SELECT tmpStockLst_Detail
				ELSE
					SELECT 0
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLst_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStockLst_Detail')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					IF USED("tmpStockLst_Detail")
						IF RECCOUNT("tmpStockLst_Detail")>0
							IF RECCOUNT("tmpStockLst_Detail")=1
								nID_Detail = tmpStockLst_Detail.ID_Detail
								cTBL = PrepareSQLtxt(tmpStockLst_Detail.TBL,'TBL',1)
							ELSE
								GO TOP
								*Need to create a loop to find best match!
								nID_Detail = tmpStockLst_Detail.ID_Detail
								cTBL = PrepareSQLtxt(tmpStockLst_Detail.TBL,'TBL',1)
							ENDIF
						ENDIF
						USE IN "tmpStockLst_Detail"
					ENDIF
				ENDIF
			ENDIF
			IF nID_Detail > 0
				ThisFormSet.frmWorkOrder.txtFID_Detail.Value = nID_Detail 
				IF nID_Detail > 0
					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(0,128,255)
				ELSE
					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(240,240,240)
				ENDIF		
				
		
				PRIVATE nWO_Detail 
				nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		
				PRIVATE cUpdate, nSQLEXEC 
				IF nWO_Detail > 0 AND nBegin_ID_Detail <> nID_Detail 
					cUpdate = "UPDATE dbo.WorkOrder_Detail SET"
					cUpdate = cUpdate + " fID_Detail ="+ALLTRIM(STR(nID_Detail))
					cUpdate = cUpdate + " ,fTBL='"+cTBL+"' "
				 	cUpdate = cUpdate + " WHERE WO_Detail= "+STR(nWO_Detail)	
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cUpdate, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cUpdate )
					ENDIF
				ENDIF
				
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE checkfinish_id_detail_process
		*ThisFormSet.CheckFinish_ID_Detail_Process()
		
		PRIVATE nID_Detail, nID_Detail_Process, cTBL
		nID_Detail = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail.Value,'ID_Detail',-3)
		nID_Detail_Process = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value,'ID_Detail_Process',-3)
		cTBL = ""
		
		PRIVATE m.cSOItem, m.cPOItem
		m.cSOItem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		m.cPOItem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFPOitem.Value,'POitem',12)
		
		PRIVATE lHaveSO, lHavePO
		IF Proper_SO_item(m.cSOItem) != Proper_SO_item('')
			lHaveSO = .T.
		ELSE
			lHaveSO = .F.
		ENDIF
		IF Proper_PO_item(m.cPOItem) != Proper_PO_item('')
			lHavePO = .T.
		ELSE
			lHavePO = .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		IF nID_Detail_Process = 0
			IF lHavePO 
				*PO is for bringing in Stock!   or for Converting!! Not sure where this is heading!
				*Get ID_Detail FROM StockLst_Detail  **	SOitem = 'ConvertSVC'
		
				cSQL = "SELECT P.ID_Detail, P.ID_Detail_Process, 'S' AS TBL "
				cSQL = cSQL +",P.Pounds, P.QTY, P.PU, P.QTY, P.Ordered_QTY "		
				cSQL = cSQL +" FROM dbo.StockLst_Process P "
				cSQL = cSQL +" WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL +" UNION "
				cSQL = cSQL +" SELECT P.ID_Detail, P.ID_Detail_Process, 'B' AS TBL "
				cSQL = cSQL +",P.Pounds, P.QTY, P.PU, P.QTY, P.Ordered_QTY "
				cSQL = cSQL +" FROM dbo.BrokerLst_Process P "
				cSQL = cSQL +" WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL +" UNION "
				cSQL = cSQL +" SELECT P.ID_Detail, P.ID_Detail_Process, 'W' AS TBL "
				cSQL = cSQL +",P.Pounds, P.QTY, P.PU, P.QTY, P.Ordered_QTY "
				cSQL = cSQL +" FROM dbo.WIPLst_Process P "
				cSQL = cSQL +" WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				IF USED("tmpStockLst_Detail")
					SELECT tmpStockLst_Detail
				ELSE
					SELECT 0
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLst_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStockLst_Detail')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					IF USED("tmpStockLst_Detail")
						IF RECCOUNT("tmpStockLst_Detail")>0
							IF RECCOUNT("tmpStockLst_Detail")=1
								nID_Detail2 = PrepareSQLnum(tmpStockLst_Detail.ID_Detail,'ID_Detail',-3)
								nID_Detail_Process = PrepareSQLnum(tmpStockLst_Detail.ID_Detail_Process,'ID_Detail_Process',-3)
								cTBL = PrepareSQLtxt(tmpStockLst_Detail.TBL,'TBL',1)
							ELSE
								*find best match!
								SELECT tmpStockLst_Detail
								LOCATE FOR ID_Detail = nID_Detail
								IF FOUND()
									nID_Detail_Process = PrepareSQLnum(tmpStockLst_Detail.ID_Detail_Process,'ID_Detail_Process',-3)
									nID_Detail2 = PrepareSQLnum(tmpStockLst_Detail.ID_Detail,'ID_Detail',-3)
									cTBL = PrepareSQLtxt(tmpStockLst_Detail.TBL,'TBL',1)
								ENDIF
							ENDIF
						ENDIF
						USE IN "tmpStockLst_Detail"
					ENDIF
				ENDIF
			ENDIF
			
			IF nID_Detail_Process > 0
				IF nID_Detail2 != nID_Detail AND nID_Detail > 0
					TrackError("nID_Detail:"+ALLTRIM(STR(nID_Detail))+"  does not match"+CHR(13)+"nID_Detail2:"+ALLTRIM(STR(nID_Detail2))+CHR(13)+"For ID_Detail_Process:"+ALLTRIM(STR(nID_Detail_Process)),"Error",PROGRAM(),LINENO(1) )
				ENDIF
				ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value = nID_Detail_Process
				
				IF nID_Detail = 0
					*Use the nID_Detail2
					nID_Detail = nID_Detail2 
				ENDIF
				
				IF nID_Detail2 = nID_Detail 
					PRIVATE nWO_Detail 
					nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
					
					PRIVATE cUpdate, nSQLEXEC 
					IF nWO_Detail> 0
						cUpdate = "UPDATE dbo.WorkOrder_Detail SET"
						cUpdate = cUpdate + " fID_Detail_Process="+ALLTRIM(STR(nID_Detail_Process))
						*cUpdate = cUpdate + " ,fID_Detail ="+ALLTRIM(STR(nID_Detail))
						*cUpdate = cUpdate + " ,fTBL='"+cTBL+"' "
					 	cUpdate = cUpdate + " WHERE WO_Detail= "+STR(nWO_Detail)	
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 	
						IF nSQLEXEC < 0
							SQLEXECError(cUpdate, ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cUpdate )
						ENDIF
					ENDIF
				ENDIF		
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE checkpoitemprocess
		*ThisFormset.CheckPOitemProcess()
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisFormset.frmWorkOrder.txtPOitem.Value,'POitem',12)
		
		IF Proper_PO_item(cPOitem) != Proper_PO_item('')
			*cPOitem is not Empty
		*	ThisFormset.frmWorkOrder.cmdEdit_WOD_Listing.Enabled = .F.
		
			PRIVATE cSQL, nSQLEXEC 
		
			IF USED("tmpFindPO_Process")	
				USE IN tmpFindPO_Process
			ENDIF
			SELECT 0
		
			cSQL =        " SELECT 'S' AS TBL, P.ID_Detail, P.Pounds, P.QTY, P.PU, P.QTY, P.Ordered_QTY "
			cSQL = cSQL + " FROM dbo.StockLst_Process P "
			cSQL = cSQL + " WHERE P.PO_item = '"+cPOitem+"'"
			cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING  ' OR P.Process_ID = 'PARTRECV' )"
			
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT 'B' AS TBL, P.ID_Detail, P.Pounds, P.QTY, P.PU, P.QTY, P.Ordered_QTY "
			cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			cSQL = cSQL + " WHERE P.PO_item = '"+cPOitem+"'"
			cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING  ' OR P.Process_ID = 'PARTRECV' )"
			
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT 'W' AS TBL, P.ID_Detail, P.Pounds, P.QTY, P.PU, P.QTY, P.Ordered_QTY "
			cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			cSQL = cSQL + " WHERE P.PO_item = '"+cPOitem+"'"
			cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING  ' OR P.Process_ID = 'PARTRECV' )"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpFindPO_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpFindPO_Process')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFindPO_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFindPO_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpFindPO_Process')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpFindPO_Process')
				IF RECCOUNT('tmpFindPO_Process') > 0
					*ThisFormset.frmWorkOrder.cmdEdit_WOD_Listing.Enabled = .T.
				ELSE
				
				ENDIF
				USE IN tmpFindPO_Process
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE checksavedetail
		*ThisFormSet.CheckSaveDetail()
		
		PRIVATE lWOexists 
		lWOexists = .F.
		
		PRIVATE nWO, lOK
		nWO		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		lOK = .T.
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF nWO > 0
			*Check for existing WO
		
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder WHERE WO = "+STR(nWO)
		
			IF USED("tmpCountWO")	
				USE IN tmpCountWO
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpCountWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountWO')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpCountWO')
				IF tmpCountWO.Cntd > 0
					lWOexists = .T.
				ENDIF
				USE IN tmpCountWO
			ENDIF
		ENDIF
		
		
		IF NOT lWOexists
			IF ThisFormSet.SaveAddWO()
				*Good Save!
			ELSE
				MESSAGEBOX("Please Save WO first"+CHR(13)+"Cannot save Detail until WO exists!",0+48,"Cannot save WO Detail!")
				RETURN .F.
			ENDIF
		ENDIF
		
		*****************************
		PRIVATE cFinishM, nFinishLot
		cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		
		IF nFinishLot > 0
		*	MESSAGEBOX("Make sure you also apply updates to "+cFinishM+" lot "+ALLTRIM(STR(nFinishLot)),64,"Found a Lot")
		ENDIF
		
		*****************************
		*Test CW
		PRIVATE nStartSize,nRoughSize,nCW,nOverSize,nCWp
		nStartSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'CW',8,3)
		nRoughSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'CW',8,3)
		nCW			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtCW.Value,'CW',2,0)
		nOverSize 	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		IF nStartSize > 0 AND nRoughSize > 0 AND nCW > 0
			nCWp = ((3.14156*nStartSize*nStartSize/4)-(3.14156*nRoughSize*nRoughSize/4))/(3.14156*nStartSize*nStartSize/4)
			nCWcalc = ROUND(nCWp * 100,0)
			IF nCW = nCWcalc 
				*Good
			ELSE
				*Bad
				MESSAGEBOX("The CW between Starting Size to Rough Size"+"Does not add up."+CHR(13)+"CW should be:"+STR(nCWcalc,2,0)+CHR(13)+"CW is listed as:"+STR(nCW,2,0),16,"Math is Off.")
				*lOK = .F.
			ENDIF
		ENDIF
		
		*****************************
		
		PRIVATE nWO_Detail
		nWO_Detail	= PrepareSQlnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		
		*****************************
		*Check weight
		PRIVATE nWO_LB, nCurWOD_LB, nOthrWOD_LB, nTotF_LB
		nWO_LB 		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWeight.Value,'Weight',9,1)
		nCurWOD_LB	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfWeight.Value,'Weight',9,1)
		*nOthrWOD_LB	= get_Total_WO_Detail_Weight(nWO,nWO_Detail,ThisFormSet.nConnhandle )
		nTotF_LB	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtTotFinishW.Value,'Weight',9,1)
		
		
		
		*lOK = .F. ???
		
		
		
		
		*****************************
		*Check OverSize
		PRIVATE nfThck, nRoughSize, nOverSize
		nfThck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',8,3)
		nRoughSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		
		IF nOverSize = 0
			IF nRoughSize > 0 AND nfThck > 0 AND nRoughSize > nfThck 
				nOverSize = nRoughSize - nfThck
				ThisFormSet.frmWorkOrder.txtOverSize.Value = PrepareSQLnum(nOverSize,'OverSize',5,3)
			ENDIF
		ELSE
			IF nRoughSize = 0
				IF nfThck > 0 
					nRoughSize = nOverSize + nfThck
					ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(nRoughSize,'RoughSize',8,3)
				ENDIF
			ELSE
				*have OverSize and RoughSize
				IF nfThck = 0
					nfThck = nRoughSize - nOverSize 
					ThisFormSet.frmWorkOrder.txtFThck.Value = PrepareSQLnum(nfThck,'Thck',8,3)
				ENDIF
			ENDIF
		ENDIF
		
		***Check if numbers add up.
		IF nOverSize > 0
			PRIVATE nCalcRoughSize, nCalcfThck
			IF nRoughSize > 0
				nCalcfThck = nRoughSize - nOverSize 
			ENDIF
			IF nfThck > 0
				nCalcRoughSize = nfThck + nOverSize 
			ENDIF
			
			IF nRoughSize > 0 AND nfThck > 0
				IF (nCalcfThck+10)*.9 < (nfThck+10) OR (nCalcfThck+10) > (nfThck+10)*.9
					*Within 10%
				ELSE
					MESSAGEBOX("Thck/Diameter "+ALLTRIM(STR(nfThck,9,3))+CHR(13)+" is more than 10% different than "+CHR(13)+" RoughSize - OverSize "+ALLTRIM(STR(nCalcfThck,9,3))+CHR(13)+"Please correct one of these numbers.",0+48,"Numbers do not Calculate.")
					*lOK = .F. ???
				ENDIF
				
				IF (nCalcRoughSize+10)*.9 < (nRoughSize+10) OR (nCalcRoughSize+10) > (nRoughSize+10)*.9
					*Within 10%
				ELSE
					MESSAGEBOX("Rough Size "+ALLTRIM(STR(RoughSize,9,3))+CHR(13)+" is more than 10% different than "+CHR(13)+" Thck + OverSize "+ALLTRIM(STR(nCalcRoughSize,9,3))+CHR(13)+"Please correct one of these numbers.",0+48,"Numbers do not Calculate.")
					*lOK = .F. ???
				ENDIF
				
			ENDIF
		ENDIF
		
		
		
		**********
		RETURN lOK 
	ENDPROC

	PROCEDURE checksavewo
		*ThisForm.CheckSaveWO()
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE nWO
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		
		
		IF nWO < 1
			lOK = .F.
		ENDIF
		
		
		
		RETURN lOK
		
		
		
		
	ENDPROC

	PROCEDURE check_wod_poi_process
		PARAMETERS nWO, nWO_Detail, cFPOitem
		*ThisFormSet.Check_WOD_POi_Process
		*If po item Selects Stock, Add WO to that process.
		
		IF Proper_PO_item(cFPOitem) = Proper_PO_item("")
			RETURN .F.
		ENDIF
		
		IF USED("tmpPOi_SELECT")	
			USE IN tmpPOi_SELECT
		ENDIF
		SELECT 0
		
		cSQL = "SELECT 'S' AS TBL,WO,WO_Detail,ID_Detail_Process "
		cSQL = cSQL + "	FROM dbo.StockLst_Process WITH(NOLOCK) "
		cSQL = cSQL + "	WHERE PO_item='"+cFPOitem+"'"
		cSQL = cSQL + "	AND Process_ID = 'SELECTED  '"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT 'B' AS TBL,WO,WO_Detail,ID_Detail_Process "
		cSQL = cSQL + "	FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		cSQL = cSQL + "	WHERE PO_item='"+cFPOitem+"'"
		cSQL = cSQL + "	AND Process_ID = 'SELECTED  '"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT 'W' AS TBL,WO,WO_Detail,ID_Detail_Process "
		cSQL = cSQL + "	FROM dbo.WIPLst_Process WITH(NOLOCK) "
		cSQL = cSQL + "	WHERE PO_item='"+cFPOitem+"'"
		cSQL = cSQL + "	AND Process_ID = 'SELECTED  '"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOi_SELECT')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOi_SELECT' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOi_SELECT")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOi_SELECT")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOi_SELECT')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		PRIVATE nID_Detail_Process, cTBL, cSQLu 
		IF USED('tmpPOi_SELECT')
			IF RECCOUNT('tmpPOi_SELECT')>0
				SCAN
					IF NOT ( PrepareSQLnum(tmpPOi_SELECT.WO,'WO',-3) = nWO OR PrepareSQLnum(tmpPOi_SELECT.WO_Detail,'WO_Detail',-3) = nWO_Detail )
						*UPDATE SELECTED with the WO
						cTBL = PrepareSQLtxt(tmpPOi_SELECT.TBL,'TBL',1)
						nID_Detail_Process = PrepareSQLnum(tmpPOi_SELECT.ID_Detail_Process,'ID_Detail_Process',-3)
						
						cSQLu = "UPDATE "
						DO CASE
						CASE cTBL = "S"
							cSQLu = cSQLu + " dbo.StockLst_Process "
						CASE cTBL = "B"
							cSQLu = cSQLu + " dbo.BrokerLst_Process "
						CASE cTBL = "W"
							cSQLu = cSQLu + " dbo.WIPLst_Process "
						ENDCASE
						cSQLu = cSQLu + " SET WO = "+STR(nWO)
						cSQLu = cSQLu + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
						
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu)
						ENDIF	
					ENDIF
					
					SELECT tmpPOi_SELECT
				ENDSCAN
			ENDIF
			USE IN tmpPOi_SELECT
		ENDIF
	ENDPROC

	PROCEDURE conditionleveltext
		*ThisFormSet.ConditionLevelText()
		PRIVATE cCC,cCL,cCondLevel
		cCC = PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFcc.Value,'CC',1)
		cCL = PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFcl.Value,'CL',1)
		
		cCondLevel = ConditionLevelText(cCC,cCL)
		
		IF NOT EMPTY(cCondLevel)
			ThisFormSet.frmWorkOrder.txtfCondLevel.Value = cCondLevel 
		ELSE
			ThisFormSet.frmWorkOrder.txtfCondLevel.Value = ''
		ENDIF
		
		*******************************************************************************
		PRIVATE cSQL, nSQLEXEC
		PRIVATE cAlloy, cForm, cCC, cCL, nThck
		
		cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
		cForm2	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCL.Value,'CL',1)
		nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFthck.Value,'Thck',10,4)
		
		
		cSQL = "SELECT dbo.f_CC_CL_Start('"+cAlloy+"','"+cCC+"','"+cCL+"',"+STR(nThck,8,3)+") AS StartDia "
		cSQL = cSQL + ",dbo.f_CC_CL_Avg_Cw('"+cAlloy+"','"+cCC+"','"+cCL+"',"+STR(nThck,8,3)+") AS CWAvg "
		cSQL = cSQL + ",dbo.f_CC_CL_DiaMax('"+cAlloy+"','"+cCC+"','"+cCL+"') AS DiaMax "
		*cSQL = cSQL + " AND DiaMax > "+STR(nThck,8,3)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpPriceTbl')
			IF RECCOUNT('tmpPriceTbl')>0
				** Read current data
				*PRIVATE nStartSize, nCW, nRoughSize
				*nStartSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'StartSize',8,3)
				*nCW			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtCW.Value,'CW',-1)
				*nRoughSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
				
				PRIVATE nPTStartSize, nPTCW, nOverSize, nPTRoughSize, nDiaMax
				nPTStartSize	= PrepareSQLnum(tmpPriceTbl.StartDia,'StartSize',8,3)
				nPTCW			= PrepareSQLnum(tmpPriceTbl.CWAvg,'CW',-1)
				nOverSize		= .060
				nPTRoughSize	= nThck + nOverSize
				nDiaMax 		= PrepareSQLnum(tmpPriceTbl.DiaMax,'DiaMax',9,3)
				
				*IF nCW = 0 AND nPTCW > 0
				IF nPTCW > 0
					IF nDiaMax <= nThck 
						ThisFormSet.frmWorkOrder.txtStartSize.Value = nPTStartSize
						ThisFormSet.frmWorkOrder.txtCW.Value		= nPTCW
						ThisFormSet.frmWorkOrder.txtRoughSize.Value	= nPTRoughSize
						ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(nOverSize,'OverSize',5,3)
					ELSE
						ThisFormSet.frmWorkOrder.txtStartSize.Value = nPTStartSize
						ThisFormSet.frmWorkOrder.txtCW.Value		= nPTCW
						ThisFormSet.frmWorkOrder.txtRoughSize.Value	= nPTRoughSize
						ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(nOverSize,'OverSize',5,3)
						
						MESSAGEBOX("This condition Level is too high to guarantee at this Dia."+CHR(13)+"Guaranteed Max Dia is "+ALLTRIM(STR(nDiaMax))+'" on the GFM.',48,"GFM Not capable")
					ENDIF
				ELSE
					ThisFormSet.frmWorkOrder.txtStartSize.Value = 0
					ThisFormSet.frmWorkOrder.txtCW.Value		= 0
					ThisFormSet.frmWorkOrder.txtRoughSize.Value	= 0
					ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
					
					WAIT WINDOW "No CL history found on this Dia."+CHR(13)+"You may have to change the CC." NOWAIT
					*MESSAGEBOX("No CL history found on this Dia."+CHR(13)+"You may have to change the CC."+CHR(13)+"dbo.PriceTable",48,'No Data') 
				ENDIF
			ELSE
				ThisFormSet.frmWorkOrder.txtStartSize.Value = 0
				ThisFormSet.frmWorkOrder.txtCW.Value		= 0
				ThisFormSet.frmWorkOrder.txtRoughSize.Value	= 0
				ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
				
				WAIT WINDOW "No CL history found on this Dia."+CHR(13)+"You may have to change the CC." NOWAIT
				*MESSAGEBOX("No CL history found on this Dia."+CHR(13)+"You may have to change the CC."+CHR(13)+"dbo.PriceTable",48,'No Data') 
			ENDIF	
			USE IN 'tmpPriceTbl'
		ELSE
			ThisFormSet.frmWorkOrder.txtStartSize.Value = 0
			ThisFormSet.frmWorkOrder.txtCW.Value		= 0
			ThisFormSet.frmWorkOrder.txtRoughSize.Value	= 0
			ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
			
			WAIT WINDOW 'No CL history found on this Dia.' NOWAIT
		ENDIF
		
	ENDPROC

	PROCEDURE deepsearchsoitem
		PARAMETERS cSOitem
		*DeepSearchSOitem
		
		*WorkOrder/Find SOitem in WO_Detail
		
		PRIVATE loHyperlink,m.cHyperLink
		*m.cHyperLink = HTML_Stock_ID_Detail(cTBL,nID_Detail,.T.) &&lReturnURL --not URL is an HTML code.
		cHyperLink = HTML_DeepSearchSOitem(cSOitem,.T.)
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(m.cHyperLink)
		RELEASE loHyperlink
		
	ENDPROC

	PROCEDURE Destroy
		IF USED("tmpWO_Detail")	
			USE IN tmpWO_Detail
		ENDIF
		
		IF "RA_CALC" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\RA_CALC"
		ENDIF
		IF "PURCHASEORDER" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\PURCHASEORDER"
		ENDIF
		IF "PRODUCTIONLOG" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\PRODUCTIONLOG"
		ENDIF
		IF "WIZEMBSS" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\WIZEMBSS"
		ENDIF
		IF "WIZSTYLE" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\WizStyle"
		ENDIF
		
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		
		*IF TYPE("ThisFormSet.frmModifyStockLst") = "O"
		*	ThisFormSet.frmModifyStockLst.Release
		*ENDIF
	ENDPROC

	PROCEDURE editbypoitem
		PARAMETERS pPOitem,pSOitem,pWhatEver
		*ThisFormSet.EditbyPOitem(pPOitem)
		
		IF VARTYPE(pPOitem)!="C"
			RETURN .F.
		ENDIF
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item(pPOitem)
		
		PRIVATE cSOitem
		IF VARTYPE(pSOitem)!="C"
			cSOitem = ''
		ELSE
			cSOitem = Proper_SO_Item(pSOitem)
		ENDIF
		
		*Check POitem IN WO, See if they meant to Edit.
		PRIVATE lFoundPOitem, lCreateWO, nCountWO
		lFoundPOitem 	= .F.
		lCreateWO		= .T.
		nCountWO		= 0
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpWOPOitem")	
			USE IN tmpWOPOitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder WHERE POitem ='"+cPOitem+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOPOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOPOitem')
				IF tmpWOPOitem.Cnt > 0
					lFoundPOitem = .T.
					nCountWO = tmpWOPOitem.Cnt
				ENDIF
				USE IN tmpWOPOitem
			ENDIF
		ENDIF
		
		PRIVATE nWO
		nWO = 0
		
		IF lFoundPOitem 
			IF nCountWO > 1
				
				DO FORM Forms\Select_WorkOrder WITH '', cPOitem TO nWO
				
				IF nWO = 0
					RETURN .F.
				ENDIF
			ELSE
				*Only one record
				IF USED("tmpWOPOitem")	
					USE IN tmpWOPOitem
				ENDIF
				SELECT 0
		
				cSQL = "SELECT WO FROM dbo.WorkOrder WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOPOitem')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOPOitem')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOPOitem")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOPOitem")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOPOitem')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
		
				*Get the WO
				IF USED('tmpWOPOitem')
					IF VARTYPE(tmpWOPOitem.WO) = "N"
						IF tmpWOPOitem.WO > 0
							nWO = tmpWOPOitem.WO
						ENDIF
						USE IN tmpWOPOitem
					ENDIF
				ENDIF
				
			ENDIF
		ENDIF
		
		IF nWO > 0
			*Get WO Info
			**### did not check for WO_Detail
			ThisFormSet.EditbyWO(nWO)
		ENDIF
		
		************************************
		
		*Check fPOitem IN WO_Detail, See if they meant to Edit.
		*PRIVATE lFoundPOitem, lCreateWO, nCountWO
		lFoundPOitem 	= .F.
		lCreateWO		= .T.
		nCountWO		= 0
		
		IF USED("tmpWOPOitem")	
			USE IN tmpWOPOitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder_Detail WHERE fPOitem ='"+cPOitem+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOPOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOPOitem')
				IF tmpWOPOitem.Cnt > 0
					lFoundPOitem = .T.
					nCountWO = tmpWOPOitem.Cnt
				ENDIF
				USE IN tmpWOPOitem
			ENDIF
		ENDIF
		
		PRIVATE nWO_Detail
		nWO_Detail = 0
		
		IF lFoundPOitem 
			IF nCountWO > 1
				
				DO FORM Forms\Select_WorkOrder WITH '', cPOitem TO nWO
				
				IF nWO = 0
					RETURN .F.
				ENDIF
			ELSE
				*Only one record
				IF USED("tmpWOPOitem")	
					USE IN tmpWOPOitem
				ENDIF
				SELECT 0
		
				cSQL = "SELECT WO_Detail FROM dbo.WorkOrder_Detail WHERE fPOitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOPOitem')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOPOitem')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOPOitem")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOPOitem")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOPOitem')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
		
				*Get the WO_Detail
				IF USED('tmpWOPOitem')
					IF VARTYPE(tmpWOPOitem.WO_Detail) = "N"
						IF tmpWOPOitem.WO_Detail > 0
							nWO_Detail = tmpWOPOitem.WO_Detail
						ENDIF
					ENDIF
					USE IN tmpWOPOitem
				ENDIF
				
			ENDIF
		ENDIF
		
		IF nWO_Detail > 0
			*Get nWO_Detail Info
			ThisFormSet.EditbyWOD(nWO_Detail)
		ENDIF
		
		
	ENDPROC

	PROCEDURE editbypo_sodist
	ENDPROC

	PROCEDURE editbysoitem
		PARAMETERS pSOitem
		*ThisFormSet.EditbySOitem(pSOitem)
		
		PRIVATE cSOitem
		cSOitem = Proper_SO_Item(pSOitem)
		
		*Check SOitem, See if they meant to Edit.
		PRIVATE lFoundSOitem, lCreateWO, nCountWO
		lFoundSOitem 	= .F.
		lCreateWO		= .T.
		nCountWO		= 0
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpWOSOitem")	
			USE IN tmpWOSOitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder WHERE SOitem ='"+cSOitem+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOSOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOSOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOSOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOSOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOSOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOSOitem')
				IF tmpWOSOitem.Cnt > 0
					lFoundSOitem = .T.
					nCountWO = tmpWOSOitem.Cnt
				ENDIF
				USE IN tmpWOSOitem
			ENDIF
		ENDIF
		
		
		IF lFoundSOitem 
			IF nCountWO > 1
				PRIVATE nWO
				nWO = 0
				
				DO FORM Forms\Select_WorkOrder WITH cSOitem, '' TO nWO
				
				IF nWO = 0
					RETURN .F.
				ENDIF
			ELSE
				*Only 1 Record
				IF USED("tmpWOSOitem")	
					USE IN tmpWOSOitem
				ENDIF
				SELECT 0
		
				cSQL = "SELECT WO FROM dbo.WorkOrder WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOSOitem')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOSOitem')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOSOitem")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOSOitem")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOSOitem')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
		
				*Get the WO
				IF USED('tmpWOSOitem')
					IF VARTYPE(tmpWOSOitem.WO) = "N"
						IF tmpWOSOitem.WO > 0
							nWO = tmpWOSOitem.WO
						ENDIF
						USE IN tmpWOSOitem
					ENDIF
				ENDIF
				
			ENDIF
		ENDIF
		
		
		IF nWO > 0
			*Get WO Info
			ThisFormSet.EditbyWO(nWO)
			
		ENDIF
	ENDPROC

	PROCEDURE editbywo
		PARAMETERS pWO
		*ThisFormSet.EditbyWO(pWO)
		
		PRIVATE nWO
		IF VARTYPE(pWO) = "N"
			nWO = pWO
		ELSE
			MESSAGEBOX("Parameter WO missing",0,"ThisFormSet.EditbyWO")
			TrackError("ThisFormSet.EditbyWO(pWO) did not get Parameter nWO","Error",PROGRAM(),LINENO(1))
			RETURN
		ENDIF
		
		ThisFormSet.frmWorkOrder.Visible = .T.
		
		PRIVATE lFoundWO, lCreateWO
		lFoundWO 	= .F.
		lCreateWO	= .T.
		
		IF USED("tmpWO")	
			USE IN tmpWO
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder WHERE WO ="+STR(nWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO')
				IF RECCOUNT('tmpWO') > 0
					IF tmpWO.Cnt > 0
						lFoundWO = .T.
					ENDIF
				ENDIF
				USE IN tmpWO
			ENDIF
		ENDIF
		
		IF lFoundWO
		
			cSQL = "SELECT WO.* "
			cSQL = cSQL + ", ISNULL(ACWO.AC_ID,0) AS AC_ID_WO "
			cSQL = cSQL + " FROM dbo.WorkOrder WO "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WO ACWO ON WO.WO = ACWO.WO "
			cSQL = cSQL + " WHERE WO.WO ="+STR(nWO)
		
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpWO')
					IF RECCOUNT('tmpWO')>0
						ThisFormset.frmWorkOrder.txtWO.Value = tmpWO.WO
						ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
						*ThisFormset.frmWorkOrder.txtWO.Enabled = .F.
						ThisFormset.frmWorkOrder.txtPieces.Value = tmpWO.sPieces
						ThisFormset.frmWorkOrder.txtAlloy.Value	= tmpWO.sAlloy
						ThisFormset.frmWorkOrder.cmbForm.Value	= tmpWO.sForm
						ThisFormSet.RefreshForms(tmpWO.sForm)
						ThisFormset.frmWorkOrder.cmbCC.Value	= tmpWO.sCC
						ThisFormSet.InitcmbCL()
						ThisFormset.frmWorkOrder.cmbCL.Value	= tmpWO.sCL
						ThisFormset.frmWorkOrder.txtHeat.Value	= tmpWO.sHeat
						
						ThisFormset.frmWorkOrder.txtThck.Value	= tmpWO.sThck
						ThisFormset.frmWorkOrder.txtSz2.Value	= tmpWO.sSz2
						ThisFormset.frmWorkOrder.txtSz3.Value	= tmpWO.sSz3
						ThisFormSet.frmWorkOrder.chkPinSWeight.Value	= PrepareSQLchk(tmpWO.pinSWeight,'pinSWeight')
						ThisFormset.frmWorkOrder.txtWeight.Value = tmpWO.sWeight
						*ThisFormSet.frmWorkOrder.txtID_Detail.Value		= PrepareSQLnum(tmpWO.sID_Detail,'ID_Detail',-3)
						*ThisFormSet.frmWorkOrder.txtID_Detail_Process.Value = PrepareSQLnum(tmpWO.sID_Detail_Process,'ID_Detail_Process',-3)
						*
						ThisFormset.frmWorkOrder.txtStartDate.Value	= PrepareSQLDate(tmpWO.StartDate,'StartDate')
						ThisFormset.frmWorkOrder.txtDueDate.Value	= PrepareSQLDate(tmpWO.DueDate,'DueDate')
						
						*ThisFormset.frmWorkOrder.chkIntP.Value		= PrepareSQLchk(tmpWO.IntP,'IntP')
						ThisFormset.frmWorkOrder.chkRE.Value		= PrepareSQLchk(tmpWO.RE,'RE')
						
						ThisFormset.frmWorkOrder.chkCmplt.Value		= PrepareSQLchk(tmpWO.Cmplt,'Cmplt')
						ThisFormset.frmWorkOrder.chkCncld.Value		= PrepareSQLchk(tmpWO.Cncld,'Cncld')
						
						ThisFormset.frmWorkOrder.txtDescript.Value	= PrepareSQLtxt(tmpWO.Descript,'Descript',100)
						ThisFormset.frmWorkOrder.edtWO_Notes.Value	= PrepareSQLtxt(tmpWO.Notes,'Notes',-1)
						
						ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= PrepareSQLnum(tmpWO.AC_ID_WO,'AC_ID',-3)
						
						ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpWO.SOitem,'SOitem',10)
						ThisFormSet.frmWorkOrder.txtPOitem.Value	= PrepareSQLtxt(tmpWO.POitem,'POitem',12)
						ThisFormset.frmWorkOrder.txtSalesRep.Value	= PrepareSQLtxt(tmpWO.SalesRep,'SalesRep',20)
						
						ThisFormSet.frmWorkOrder.chklPrc_Stock.Value	= PrepareSQLchk(tmpWO.lPrc_Stock,'lPrc_Stock')
						ThisFormSet.frmWorkOrder.chkStkConsumed.Value	= PrepareSQLchk(tmpWO.StkConsumed,'StkConsumed')
		
						*ThisFormSet.Refresh_frmChooseWO_Detail(tmpWO.WO)
							*CALLS: ThisFormSet.Refresh_frmWorkOrder_FPOitem(pfPOitem)
						
						ThisFormSet.Show_frmWorkOrder_MarkedStock(tmpWO.WO)
							*CALLS:	ThisFormSet.Load_tmpSPStart(tmpWO.WO)
						
						ThisFormSet.Show_frmWorkOrder_WODetail(tmpWO.WO)
							*CALLS: ThisFormSet.Refresh_frmWorkOrder_Detail(tmpWO_Detail.WO_Detail)  -First WO_Detail
								*CALLS: ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_Detail.fPOitem)
								*CALLS: ThisFormSet.CheckFinish_ID_Detail()
								*CALLS:	ThisFormSet.Show_frmStock_Produced(nWOD)
												
						ThisFormSet.Show_frmStockUsed(tmpWO.WO)
							*CALLS: ThisFormSet.Load_tmpSPStartP(nWO)
								*CALLS: ThisFormSet.RefreshID_Detail_ProcessP( 0 )
								*CALLS: ThisFormSet.Load_tmpSPcmpltP(nWO)
									*CALLS: ThisFormSet.RefreshID_Detail_ProcessCP( 0 )
						
						ThisFormSet.Set_frmWorkOrder('ENABLE')
						
					ENDIF
					USE IN tmpWO
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE editbywod
		PARAMETERS pWOD
		*ThisFormSet.EditbyWOD(pWOD)
		
		PRIVATE nWOD
		IF VARTYPE(pWOD) = "N"
			nWOD = pWOD
		ELSE
			MESSAGEBOX("Parameter WOD missing",0,"ThisFormSet.EditbyWOD")
			TrackError("ThisFormSet.EditbyWOD(WOD) did not get Parameter WO_Detail","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE nWO
		nWO=0 &&tmpWO.WO
		*IF VARTYPE(pWO) = "N"
		*	nWO = pWO
		*	*Pass in 0 and NWOD will be used to find WO
		*ELSE
		*	MESSAGEBOX("Parameter WO missing",0,"ThisFormSet.EditbyWO")
		*	RETURN .F.
		*ENDIF
		
		PRIVATE lFoundWOD, lFoundWO, lCreateWO
		lFoundWOD	= .F.
		lFoundWO 	= .F.
		lCreateWO		= .T.
		
		*****************************************
		IF USED("tmpWOD")	
			USE IN tmpWOD
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT * "
		cSQL = cSQL + ",0 AS AC_ID_WOD "
		cSQL = cSQL + " FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
		cSQL = cSQL + " WHERE WO_Detail ="+STR(nWOD)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOD')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOD')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOD')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOD')
				IF RECCOUNT('tmpWOD') > 0
					lFoundWOD = .T.
				ENDIF
				USE IN tmpWOD
			ENDIF
		ENDIF
		
		
		*****************************************
		IF lFoundWOD
			*Get nWO and table 'tmpWO_Detail'
			cSQL = "SELECT WOD.*"
			cSQL = cSQL +", ISNULL(ACWOD.AC_ID,0) AS AC_ID_WOD "
			cSQL = cSQL +" FROM dbo.WorkOrder_Detail WOD "
			cSQL = cSQL +" LEFT OUTER JOIN dbo.AcctCost_WOD ACWOD ON WOD.WO_Detail = ACWOD.WO_Detail "
			cSQL = cSQL +" WHERE WOD.WO_Detail ="+STR(nWOD)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Detail')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpWO_Detail')
					IF RECCOUNT('tmpWO_Detail') > 0
					
						*Get WO while table is open
						nWO = PrepareSQLnum(tmpWO_Detail.WO,'WO',-3)
						ThisFormSet.nWO = nWO
						
						ThisFormSet.Show_frmWorkOrder_MarkedStock(nWO)		&& if lFoundWOD
											
						ThisFormSet.Show_frmWorkOrder_WODetail(nWO)		&&Check this, may not need here ###
		
							*CALLS: ThisFormSet.Refresh_frmWorkOrder_Detail(tmpWO_Detail.WO_Detail)  -First WO_Detail
								*CALLS: ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_Detail.fPOitem)
								*CALLS: ThisFormSet.CheckFinish_ID_Detail()
			
						ThisFormSet.Refresh_frmWorkOrder_Detail(nWOD)	&&For Specific WOD
							*CALLS: ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_Detail.fPOitem)
							*CALLS: ThisFormSet.CheckFinish_ID_Detail()
						
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************************
		
		IF nWO > 0
			IF USED("cntWO")	
				USE IN cntWO
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder WHERE WO ="+STR(nWO)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'cntWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntWO')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('cntWO')
					IF RECCOUNT('cntWO') > 0
						IF cntWO.Cnt > 0
							lFoundWO = .T.
						ENDIF
					ENDIF
					USE IN cntWO
				ENDIF
			ENDIF
		ELSE
			lFoundWO = .F.
		ENDIF
		
		*****************************************
		IF lFoundWO
			cSQL = "SELECT WO.* "
			cSQL = cSQL + ",ISNULL(ACWO.AC_ID,0) AS AC_ID_WO "
			cSQL = cSQL + " FROM dbo.WorkOrder WO "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WO ACWO ON WO.WO = ACWO.WO "
			cSQL = cSQL + " WHERE WO.WO ="+STR(nWO)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpWO')
					IF RECCOUNT('tmpWO')>0
						ThisFormset.frmWorkOrder.txtWO.Value = PrepareSQLnum(tmpWO.WO,'WO',-3)
						ThisFormSet.nWO = PrepareSQLnum(tmpWO.WO,'WO',-3)
						*ThisFormset.frmWorkOrder.txtWO.Enabled = .F.
						ThisFormset.frmWorkOrder.txtPieces.Value = tmpWO.sPieces
						ThisFormset.frmWorkOrder.txtAlloy.Value	= tmpWO.sAlloy
						ThisFormset.frmWorkOrder.cmbForm.Value	= tmpWO.sForm
						ThisFormSet.RefreshForms(tmpWO.sForm)
						ThisFormset.frmWorkOrder.cmbCC.Value	= tmpWO.sCC
						ThisFormSet.InitcmbCL()
						ThisFormset.frmWorkOrder.cmbCL.Value	= tmpWO.sCL
						ThisFormset.frmWorkOrder.txtHeat.Value	= tmpWO.sHeat
						
						ThisFormset.frmWorkOrder.txtThck.Value	= tmpWO.sThck
						ThisFormset.frmWorkOrder.txtSz2.Value	= tmpWO.sSz2
						ThisFormset.frmWorkOrder.txtSz3.Value	= tmpWO.sSz3
						ThisFormSet.frmWorkOrder.chkPinSWeight.Value	=  PrepareSQLchk(tmpWO.pinSWeight,'pinSWeight')
						ThisFormset.frmWorkOrder.txtWeight.Value = tmpWO.sWeight
						*ThisFormSet.frmWorkOrder.txtID_Detail.Value		= PrepareSQLnum(tmpWO.sID_Detail,'ID_Detail',-3)
						*ThisFormSet.frmWorkOrder.txtID_Detail_Process.Value = PrepareSQLnum(tmpWO.sID_Detail_Process,'ID_Detail_Process',-3)
						*
						IF ISNULL( tmpWO.StartDate )
							ThisFormset.frmWorkOrder.txtStartDate.Value	= DATE()
						ELSE
							ThisFormset.frmWorkOrder.txtStartDate.Value	= PrepareSQLDate(tmpWO.StartDate,'StartDate')
						ENDIF
						*ThisFormset.frmWorkOrder.chkIntP.Value		= PrepareSQLchk(tmpWO.IntP,'IntP')
						ThisFormset.frmWorkOrder.chkRE.Value		= PrepareSQLchk(tmpWO.RE,'RE')
						
						ThisFormset.frmWorkOrder.txtDescript.Value	= PrepareSQLtxt(tmpWO.Descript,'Descript',100)
						ThisFormset.frmWorkOrder.edtWO_Notes.Value	= PrepareSQLtxt(tmpWO.Notes,'Notes',-1)
						
						ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	=  PrepareSQLnum(tmpWO.AC_ID_WO,'AC_ID',-3)
						
						ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpWO.SOitem,'SOitem',10)
						ThisFormSet.frmWorkOrder.txtPOitem.Value	= PrepareSQLtxt(tmpWO.POitem,'POitem',12)
						ThisFormset.frmWorkOrder.txtSalesRep.Value	= PrepareSQLtxt(tmpWO.SalesRep,'SalesRep',20)
						
						ThisFormSet.frmWorkOrder.chklPrc_Stock.Value	= PrepareSQLchk(tmpWO.lPrc_Stock,'lPrc_Stock')
						ThisFormSet.frmWorkOrder.chkStkConsumed.Value	= PrepareSQLchk(tmpWO.StkConsumed,'StkConsumed')
		
						*ThisFormSet.Refresh_frmChooseWO_Detail(tmpWO.WO)
						
						ThisFormSet.Show_frmWorkOrder_MarkedStock(tmpWO.WO)	&& if lFoundWOD
							*CALLS:	ThisFormSet.Load_tmpSPStart(tmpWO.WO)
		
						ThisFormSet.Show_frmWorkOrder_WODetail(tmpWO.WO)
							*CALLS: ThisFormSet.Refresh_frmWorkOrder_Detail(tmpWO_Detail.WO_Detail)  -First WO_Detail
								*CALLS: ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_Detail.fPOitem)
								*CALLS: ThisFormSet.CheckFinish_ID_Detail()
								
						Thisformset.Refresh_frmWorkOrder_Detail(nWOD)		&& Set to specific WOD --Not sure if needed here
							*CALLS: ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_Detail.fPOitem)
							*CALLS: ThisFormSet.CheckFinish_ID_Detail()
											
						ThisFormSet.Show_frmStockUsed(tmpWO.WO)
							*CALLS: ThisFormSet.Load_tmpSPStartP(nWO)
								*CALLS: ThisFormSet.RefreshID_Detail_ProcessP( 0 )
								*CALLS: ThisFormSet.Load_tmpSPcmpltP(nWO)
									*CALLS: ThisFormSet.RefreshID_Detail_ProcessCP( 0 )
		
						ThisFormSet.Set_frmWorkOrder('ENABLE')
		
					ENDIF
					USE IN tmpWO
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Did not find WOD data",0,"No Data")
			PRIVATE cWODstr
			IF nWO=0
				cWODstr = "0' for WO '"+STR(nWO)+"'"
			ELSE
				cWODstr = STR(nWOD)
			ENDIF
			TrackError("Did not find WOD '"+cWODstr+"'.","Did not find WOD data",PROGRAM(),LINENO(1) )
		ENDIF
		
	ENDPROC

	PROCEDURE editbywo_po_so
		PARAMETERS pWhatEver
		*ThisForm.EditbyWO_PO_SO(pWhatEver)
		
		*pWhatEver is nID_PO_SODist
		PRIVATE nID_PO_SODist
		nID_PO_SODist = PrepareSQLnum(pWhatever,'ID_PO_SODist',-3)
		
		IF nID_PO_SODist = 0
			TrackError("ThisFormSet.EditbyWO_PO_SO(pWhatEver) did not get Parameter pWhatEver","Error",PROGRAM(),LINENO(1))
			RETURN .f.
		ENDIF
		
		
		PRIVATE nWO
		nWO = ThisFormSet.nWO
		
		*Check POitem, See if they meant to Edit.
		PRIVATE lFoundPOitem, lCreateWO
		lFoundID_PO_SODist	= .F.
		lCreateWO		= .T.
		
		IF USED("tmpPO_SOdistCnt")	
			USE IN tmpPO_SOdistCnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.PO_SOdist "
		cSQL = " WHERE ID_PO_SODist = "+STR(nID_PO_SODist)
		
		IF nWO > 0
			cSQL = cSQL + " AND WO <> "+STR(nWO)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_SOdistCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_SOdistCnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_SOdistCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_SOdistCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_SOdistCnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpPO_SOdistCnt')
				IF tmpPO_SOdistCnt.Cnt > 0
					lFoundID_PO_SODist= .T.
				ENDIF
				USE IN tmpPO_SOdistCnt
			ENDIF
		ENDIF
		
		IF lFoundID_PO_SODist
			*Show WO screen with POitem and Ask if they want to Edit That.
			IF MESSAGEBOX("PO Item:"+ALLTRIM(cPOitem)+" was Found in another WO."+CHR(13)+"Do you want to Edit this other WO?"+CHR(13)+"Answer No to continue with adding"+CHR(13)+"this PO item to this WO.",4+32,"Edit old WO?") = 6
				ThisFormSet.EditbyPO_SODist(cPOitem,cSOitem, pWhatEver)
				RETURN
			ENDIF
		ENDIF
		
		*Use POitem to Create WO
		
		IF lFoundSOiteminPO 
			*Get PurchaseOrder Info
			
			
			IF USED("tmpPO_SOdist")	
				USE IN tmpPO_SOdist
			ENDIF
			SELECT 0
		
			cSQL = "SELECT * "
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Pounds, RandLen, Metric,'','','') AS Descript "
			cSQL = cSQL + ",dbo.f_BestDate(dbo.f_BestDate(Due_Min,Due_Max),dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max)) AS DueDate "
			cSQL = cSQL + ",Cond_Spec"
			cSQL = cSQL + " FROM dbo.PO_SOdist PSD "
			cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder P ON PSP.POitem = P.POitem "
			cSQL = cSQL + " WHERE PSD.ID = "+STR(nID_PO_SODist)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_SOdist')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpPO_SOdist')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_SOdist")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_SOdist")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_SOdist')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpPO_POitem')
					IF VARTYPE(tmpPO_POitem.HPAPO) = 'N'
						ThisFormset.frmWorkOrder.txtPieces.Value 	= tmpPO_SOdist.Pieces
						ThisFormset.frmWorkOrder.txtAlloy.Value		= tmpPO_SOdist.Alloy
						ThisFormset.frmWorkOrder.cmbForm.Value		= tmpPO_SOdist.Form
						ThisFormSet.RefreshForms(tmpPO_SOdist.Form)
						ThisFormset.frmWorkOrder.cmbCC.Value		= tmpPO_SOdist.CC
						ThisFormSet.InitcmbCL()
						ThisFormset.frmWorkOrder.cmbCL.Value		= tmpPO_SOdist.CL
						ThisFormset.frmWorkOrder.txtHeat.Value		= ''
						
						ThisFormset.frmWorkOrder.txtThck.Value		= tmpPO_SOdist.Thck
						ThisFormset.frmWorkOrder.txtSz2.Value		= tmpPO_SOdist.Sz2
						ThisFormset.frmWorkOrder.txtSz3.Value		= tmpPO_SOdist.Sz3
						ThisFormSet.frmWorkOrder.chkPinSWeight.Value	= 0
						ThisFormset.frmWorkOrder.txtWeight.Value 	= tmpPO_SOdist.Pounds
						*
						ThisFormSet.frmWorkOrder.txtStartDate.Value	= DATE()
						*ThisFormSet.frmWorkOrder.chkIntP.Value		= PrepareSQLlogic(0,'IntP')
						ThisFormset.frmWorkOrder.txtDescript.Value 	= tmpPO_SOdist.Descript
						ThisFormset.frmWorkOrder.edtWO_Notes.Value 	= ALLTRIM(tmpPO_SOdist.Cond_Spec)+CHR(13)+ALLTRIM(tmpPO_SOdist.Misc_Purch)
						
						ThisFormSet.frmWorkOrder.txtAC_ID_WO.Value	= 0 
						
						IF ThisFormSet.cWhat2 == '' OR ThisFormSet.cWhat2 = "START"
							ThisFormSet.frmWorkOrder.txtPOitem.Value	= cPOitem 
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpPO_SOdist.SOitem,'SOitem',10)
						ELSE
							ThisFormSet.frmWorkOrder.txtPOitem.Value	= ''
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= ''
						ENDIF
						
						ThisFormSet.frmWorkOrder.txtSalesRep.Value	= AppSetup_Get_SalesRep_SalesP(tmpPO_SOdist.SalesP)
						*
						ThisFormset.frmWorkOrder.txtFPieces.Value 	= tmpPO_SOdist.Pieces
						ThisFormset.frmWorkOrder.txtFAlloy.Value	= tmpPO_SOdist.Alloy
						ThisFormset.frmWorkOrder.cmbFForm.Value		= tmpPO_SOdist.Form
						ThisFormSet.RefreshFForms(tmpPO_SOdist.Form)
						ThisFormset.frmWorkOrder.cmbFcc.Value		= tmpPO_SOdist.CC
						ThisFormSet.InitcmbFCL()
		
						ThisFormset.frmWorkOrder.cmbFCL.Value		= tmpPO_SOdist.CL
						ThisFormset.frmWorkOrder.txtFThck.Value		= tmpPO_SOdist.Thck
						ThisFormset.frmWorkOrder.txtFSz2.Value		= tmpPO_SOdist.Sz2
						ThisFormset.frmWorkOrder.txtFSz3.Value		= tmpPO_SOdist.Sz3
						ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= 0
						ThisFormset.frmWorkOrder.txtfWeight.Value 	= tmpPO_SOdist.Pounds
						ThisFormset.frmWorkOrder.txtFSpec.Value		= ''
						ThisFormset.frmWorkOrder.txtFDescript.Value = tmpPO_SOdist.Descript
						ThisFormset.frmWorkOrder.txtfCondLevel.Value= ConditionLevelText(tmpPO_SOdist.CC,tmpPO_SOdist.CL)
						
						ThisFormset.frmWorkOrder.cmbFollowM.Value	= ''
						ThisFormset.frmWorkOrder.txtFollowLot.Value	= 0
						ThisFormset.frmWorkOrder.cmbFinishM.Value	= ''
						ThisFormset.frmWorkOrder.txtFinishLot.Value	= 0
						
						ThisFormset.frmWorkOrder.txtTestPO.Value = ''
						
						ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(0,'StartSize',8,3)
						ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(0,'CW',-1)
						ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(0,'RoughSize',8,3)
						ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
						
						ThisFormSet.frmWorkOrder.chklPrc_Stock.Value	= 0
						ThisFormSet.frmWorkOrder.chkStkConsumed.Value	= 0
		
						ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = 0
						ThisFormSet.nStock_Projected_ID = 0
						ThisFormSet.Refresh_Projected()
						
						ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= 0 &&PrepareSQLnum(tmpWO.AC_ID_WOD,'AC_ID',-3)
						
						IF ThisFormSet.pWhat = '' OR ThisFormSet.pWhat = "START"
							ThisFormSet.frmWorkOrder.txtFPOitem.Value	= ''
							ThisFormSet.frmWorkOrder.txtFSOitem.Value	= ''
							ThisFormSet.Refresh_frmWorkOrder_fPOitem("")
						ELSE				
							ThisFormSet.frmWorkOrder.txtPOitem.Value	= cPOitem 
							ThisFormSet.frmWorkOrder.txtSOitem.Value	= PrepareSQLtxt(tmpPO_SOdist.SOitem,'SOitem',10)
							ThisFormSet.Refresh_frmWorkOrder_FPOitem(cPOitem)
						ENDIF
						
		
						ThisFormSet.frmWorkOrder.txtDueDate.Value	= PrepareSQLDate(tmpPO_SOdist.DueDate,'DueDate')
		
						IF ThisFormset.frmWorkOrder.txtWO.Value = 0
							ThisFormset.frmWorkOrder.txtWO.Value = GetNextWorkOrder(ThisFormSet.nConnhandle)
							ThisFormSet.nWO = ThisFormset.frmWorkOrder.txtWO.Value
						ENDIF
						
						IF ThisFormSet.CheckFinish_ID_Detail()
						ENDIF
						IF ThisFormSet.CheckFinish_ID_Detail_Process()
						ENDIF
						
						ThisFormSet.Set_frmWorkOrder('ENABLE')
						
						*ThisFormSet.CheckPOitemProcess()
						
						PRIVATE cMess
						cMess = "The PO was found and the WO screen has this data."
						cMess = cMess + CHR(13)+"The WO is ready to Edit."
						MESSAGEBOX(cMess,0+64,"WO is ready ot Edit")
						
					ENDIF
					USE IN tmpPO_SOdist
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE editpo
		PARAMETERS pPOitem, pSOitem, pWhatEver
		*ThisFormSet.EditPO(cPOitem)
		
		*!*	PRIVATE cPOitem
		*!*	cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,"POitem",13)
		
		IF TYPE("pPOitem") != "C"
			*Error
			MESSAGEBOX("EditPO did not receive the POitem",48,"Procedure Error")
			TrackError("EditPO did not receive the parameter POitem","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		IF EMPTY(pPOitem)
			MESSAGEBOX("EditPO did not receive the POitem",48,"Procedure Error")
			TrackError("EditPO did not receive the parameter POitem - Empty.","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		PRIVATE cPOitem
		cPOitem = Proper_PO_item( pPOitem )
		PRIVATE cSOitem
		cSOitem = Proper_SO_Item(pSOitem)
		
		IF NOT PurchaseOrder_Allow_Cancel( pPOitem, ThisFormSet.nConnHandle )
			RETURN .F.
		ENDIF
		
		*************************************
		*Code from Edit button in EditOrder
		ThisFormSet.frmPO.ShowPOitem(cPOitem)
		ThisFormSet.EditPOScreen(.T.)
		IF VARTYPE(ThisFormSet.frmPO) = "O"
			ThisFormSet.frmPO.PO_NewAdd = .F.
			ThisFormSet.frmPO.POEditing = .T.
			ThisFormSet.frmPO.POScreen("ENABLE")
			ThisFormSet.frmPO.PO_VALID("EDIT")
		
			*ThisFormSet.frmPO.RefreshPOForms(ThisFormset.frmPO.pgfPO.pgPODesc.cmbForm.Value )
		
			ThisFormSet.frmPO.Visible = .T.
			*ThisFormSet.frmPOMaint.pf1.ActivePage = 1
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtCompany.SetFocus()
		ENDIF
	ENDPROC

	PROCEDURE editposcreen
		PARAMETERS pShow
		*ThisFormSet.EditPOScreen(lShowEdit)
		
		PRIVATE lShowEdit
		lShowEdit = .F.
		
		IF VARTYPE(pShow) = 'N'
			IF pShow = 0
				lShowEdit = .F.
			ENDIF
			IF pShow = 1
				lShowEdit = .T.
			ENDIF
		ELSE
			IF VARTYPE(pShow) = 'L'
				lShowEdit = pShow
			ELSE
				MESSAGEBOX("PurchaseOrder.EditPOScreen()",16,"Bad Parameter")
				TrackError("ThisFormSet.EditPOScreen(lShowEdit) did not get Parameter lShowEdit","Error",PROGRAM(),LINENO(1))
			ENDIF
		ENDIF
		
		IF lShowEdit
			ThisFormSet.frmPO.POScreen("ENABLE")
			ThisFormSet.WorkOrderScreen("DISABLE")
			ThisFormSet.frmPO.Visible = .T.
		*	ThisFormset.frmPONotes.edtMisc_Purch.ReadOnly = .F.
		ELSE
			ThisFormSet.frmPO.POScreen("DISABLE")
			ThisFormSet.WorkOrderScreen("ENABLE")
		*	ThisFormset.frmPONotes.edtMisc_Purch.ReadOnly = .T.
			ThisFormSet.frmPO.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmworkorder_unload
		*ThisFormSet.frmWorkOrder_Unload()
		
		*
		IF USED('tmpWO_Detail')
			USE IN tmpWO_Detail
		ENDIF
		IF USED('tmpSPStart')
			USE IN tmpSPStart
		ENDIF
		IF USED('tmpSPStartP')
			USE IN tmpSPStartP 
		ENDIF
		IF USED('tmpSPcmpltP')
			USE IN tmpSPcmpltP
		ENDIF
		
		IF USED("tmpStockWO")
