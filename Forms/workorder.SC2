	PROCEDURE set_frmworkorder_descript
		PARAMETERS pWhere
		*ThisFormSet.Set_frmWorkOrder_Descript()
		
		PRIVATE nPieces, cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3, nWeight
		PRIVATE cCurrTable, nCalcMachWeight, cCommonSpec ,nPieces2,cForm2
		cCurrTable = ALIAS()
		
		
		
		IF pWhere = "START"
			PRIVATE cDescript
			cDescript= ""
			
			nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtPieces.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtAlloy.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtThck.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz2.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtSz3.Value,'Sz3',9,3)
			nWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtWeight.Value,'weight',7,1)
		
			cDescript = Descript(cAlloy, cForm, cCC, cCL, nThck, nSZ2, nSZ3, nWeight,.F.,.F.,'','','')
			*nPieces
			ThisFormset.frmWorkOrder.txtDescript.Value = cDescript
		ENDIF
		
		********************************
		IF pWhere = "FINISH"
			PRIVATE cFDescript
			cFDescript= ""
			
			nPieces	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisFormset.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmWorkOrder.cmbFCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFthck.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz2.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmWorkOrder.txtFSz3.Value,'Sz3',9,3)
			nWeight = PrepareSQLnum(ThisFormset.frmWorkOrder.txtFWeight.Value,'Weight',7,1)
			
			cFDescript = Descript(cAlloy, cForm, cCC, cCL, nThck, nSZ2, nSZ3, nWeight,.F.,.F.,'','','')
			*nPieces
			ThisFormset.frmWorkOrder.txtFDescript.Value = cFDescript
		ENDIF
	ENDPROC

