				ThisFormSet.frmStock_Produced.txtForm.Value = tmpStock_Produced.Form
				ThisFormSet.frmStock_Produced.txtCC.Value = tmpStock_Produced.CC
				ThisFormSet.frmStock_Produced.txtCL.Value = tmpStock_Produced.CL
				ThisFormSet.frmStock_Produced.txtSize.Value = tmpStock_Produced.Size
				ThisFormSet.frmStock_Produced.txtCond.Value = tmpStock_Produced.Cond
				ThisFormSet.frmStock_Produced.txtStockDate.Value = PrepareSQLDate(tmpStock_Produced.StkDate,'StkDate')
				
				ThisFormSet.frmStock_Produced.txtSpecs.Value = tmpStock_Produced.Specs
				ThisFormSet.frmStock_Produced.txtLot.Value = tmpStock_Produced.heat
				ThisFormSet.frmStock_Produced.txtHeat.Value = tmpStock_Produced.lot
				
				ThisFormSet.frmStock_Produced.txtDescription.Value = tmpStock_Produced.Descript		
				ThisFormSet.frmStock_Produced.txtTBL.Value = PrepareSQLtxt(tmpStock_Produced.TBL,'TBL',1)
				ThisFormSet.frmStock_Produced.txtID.Value = PrepareSQLnum(tmpStock_Produced.ID,'ID_Master',-3)
				ThisFormSet.frmStock_Produced.txtID_Detail.Value = PrepareSQLnum(tmpStock_Produced.ID_Detail,'ID_Detail',-3)
				
				ThisFormSet.frmStock_Produced.txtPC.Value = tmpStock_Produced.PC
				*ThisFormSet.frmStock_Produced.txtSize_H.Value = tmpStock_Produced.Size_H
				ThisFormSet.frmStock_Produced.txtDim1.Value = tmpStock_Produced.Dim1
				*ThisFormSet.frmStock_Produced.txtSize_L.Value = tmpStock_Produced.Size_L
				ThisFormSet.frmStock_Produced.txtDim2.Value = tmpStock_Produced.Dim2
				ThisFormSet.frmStock_Produced.txtDim3.Value = tmpStock_Produced.Dim3
		
				ThisFormSet.frmStock_Produced.txtLocation.Value = tmpStock_Produced.Location
				*ThisFormSet.frmStock_Produced.txtCostValue.Value = tmpStock_Produced.CostValue
				*ThisFormSet.frmStock_Produced.txtS_PU.Value = PrepareSQLtxt(tmpStock_Produced.S_PU,'S_PU',1)
				*ThisFormSet.frmStock_Produced.txtS_Qty.Value = tmpStock_Produced.S_Qty
				*ThisFormSet.frmStock_Produced.txtS_P.Value = tmpStock_Produced.S_P
				*ThisFormSet.frmStock_Produced.txtS_Total.Value = tmpStock_Produced.S_Total
				ThisFormSet.frmStock_Produced.txtPODueDate.Value = PrepareSQLDate(tmpStock_Produced.PODueDate,'PODueDate')
				ThisFormSet.frmStock_Produced.txtReceivingID.Value = tmpStock_Produced.ReceivingID
				
				ThisFormSet.frmStock_Produced.txtLength.Value = tmpStock_Produced.Length
				
				ThisFormSet.frmStock_Produced.txtPWO_Detail.Value = PrepareSQLnum(tmpStock_Produced.PWO_Detail,'WO_Detail',-3)
				ThisFormSet.frmStock_Produced.txtID_Detail_Process.Value = PrepareSQLnum(tmpStock_Produced.ID_Detail_Process,'ID_Detail_Process',-3)
				ThisFormSet.frmStock_Produced.txtProcess_ID.Value = PrepareSQLtxt(tmpStock_Produced.Process_ID,'Process_ID',10)
				ThisFormSet.frmStock_Produced.txtPSOitem.Value = PrepareSQLtxt(tmpStock_Produced.PSOitem,'SOitem',10)
				
				
		
				
				PRIVATE nWO_Detail
				nWO_Detail = PrepareSQLnum(tmpStock_Produced.WO_Detail,'WO_Detail',-3)
				ThisFormSet.frmStock_Produced.txtWO_Detail.Value = nWO_Detail 
				
				IF nWO_Detail = 0
				
					PRIVATE nNewWO_Detail
					nNewWO_Detail = PrepareSQLnum(ThisFormSet.frmStock_Produced.lblWO_D.Caption,'WO_Detail',-3) 
					IF nNewWO_Detail > 0
					*	ThisFormSet.frmStock_Produced.txtWO_Detail.Value = nNewWO_Detail
						ThisFormSet.frmStock_Produced.cmdSaveWODtoStock.Visible = .T.
						ThisFormSet.frmStock_Produced.cmdSaveWODtoStock.Enabled = .T.
					ENDIF
					*ThisFormSet.frmStock_Produced.cmdSaveWODtoStock.Visible = .T.
				ELSE
					ThisFormSet.frmStock_Produced.cmdSaveWODtoStock.Visible = .F.
				ENDIF
				
				ThisFormset.frmWorkOrder.txtfID_Detail.Value = tmpStock_Produced.ID_Detail
				*ThisFormset.frmWorkOrder.txtFID_Detail_Process.Value = tmpStock_Produced.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refresh_completedid_detail_processp
		PARAMETERS pID_Detail_ProcessP 
		*ThisFormSet.Refresh_CompletedID_Detail_ProcessP( nID_Detail_Process )
		*CmpltP
		
		PRIVATE nID_Detail_ProcessP 
		nID_Detail_ProcessP = PrepareSQLnum(pID_Detail_ProcessP,'ID_Detail_Process',-3)
		
		ThisFormSet.frmStockUsed.txtSPc_TBL.Value 			= ""
		ThisFormSet.frmStockUsed.txtSPc_Heat.Value			= ""
		ThisFormSet.frmStockUsed.txtSPc_StockEdit.Value		= CTOD("")
		ThisFormSet.frmStockUsed.txtSPc_StockLst_PC.Value	= 0
		ThisFormSet.frmStockUsed.txtSPc_StockLst_Qty.Value	= 0
		ThisFormSet.frmStockUsed.txtSPc_ID_Detail.Value		= 0
		ThisFormSet.frmStockUsed.txtSPc_ID_Detail_Process.Value = 0
		
		ThisFormSet.frmStockUsed.txtSPc_Pounds.Value 		= 0	&&PrepareSQLnum(tmpSPStartP.Pounds,'Pounds',9,1)
		ThisFormSet.frmStockUsed.txtSPc_PQTY.Value 			= 0	&&PrepareSQLnum(tmpSPStartP.Qty,'P_QTY',-5)
		ThisFormSet.frmStockUsed.txtSPc_PPU.Value 			= 0	&&PrepareSQLnum(tmpSPStartP.PU,'PU',-1)
		ThisFormSet.frmStockUsed.txtSPc_POrdered_QTY.Value 	= 0	&&PrepareSQLnum(tmpSPStartP.Ordered_QTY,'Ordered_QTY',-5)
			
		ThisFormSet.frmStockUsed.txtSPc_SOitem.Value	= ''	&&ShowSQLtxt(tmpSPStartP.SOitem,'SOitem',10)
		ThisFormSet.frmStockUsed.txtSPC_WOD.Value 		= 0
		ThisFormSet.frmStockUsed.txtSPc_Desc.Value		= ''	&&ShowSQLtxt(tmpSPStartP.DescriptCL,'DescriptCL',100)
		
		
		*	ThisFormSet.frmStockUsed.Visible = .F.
		
		IF nID_Detail_ProcessP = 0
		
		ELSE
		
			IF NOT USED('tmpSPcmpltP')
				IF ThisFormSet.nWO > 0
					ThisFormSet.Load_tmpSPcmpltP(ThisFormSet.nWO)
				ENDIF
			ENDIF
		
			IF NOT USED('tmpSPcmpltP')
				WAIT WINDOW "TABLE 'tmpSPcmpltP' is not open, Any key..."
				*ThisFormSet.Load_tmpSPcmpltP(ThisFormSet.nWO)
			ELSE	
				SELECT tmpSPcmpltP
				IF nID_Detail_ProcessP > 0
					LOCATE FOR ID_Detail_Process = nID_Detail_ProcessP
				ENDIF
				
				ThisFormSet.frmStockUsed.Visible = .T.
				
				ThisFormSet.frmStockUsed.txtSPc_TBL.Value 			= tmpSPcmpltP.TBL
				ThisFormSet.frmStockUsed.txtSPc_Heat.Value 			= tmpSPcmpltP.Heat
				ThisFormSet.frmStockUsed.txtSPc_StockEdit.Value 	= PrepareSQLdate(tmpSPcmpltP.DateMod,'DateMod')
				ThisFormSet.frmStockUsed.txtSPc_StockLst_PC.Value	= tmpSPcmpltP.Pieces 
				ThisFormSet.frmStockUsed.txtSPc_StockLst_Qty.Value	= tmpSPcmpltP.Qty
				ThisFormSet.frmStockUsed.txtSPc_ID_Detail.Value		= tmpSPcmpltP.StockLst_ID_Detail
				ThisFormSet.frmStockUsed.txtSPc_ID_Detail_Process.Value = tmpSPcmpltP.ID_Detail_Process
		
				ThisFormSet.frmStockUsed.txtSPc_Pounds.Value 		= PrepareSQLnum(tmpSPcmpltP.Pounds,'Pounds',9,1)
				ThisFormSet.frmStockUsed.txtSPc_PQTY.Value 			= PrepareSQLnum(tmpSPcmpltP.Qty,'P_QTY',-5)
				ThisFormSet.frmStockUsed.txtSPc_PPU.Value 			= PrepareSQLnum(tmpSPcmpltP.PU,'PU',-1)
				ThisFormSet.frmStockUsed.txtSPc_POrdered_QTY.Value 	= PrepareSQLnum(tmpSPcmpltP.Ordered_QTY,'Ordered_QTY',-5)
					
				ThisFormSet.frmStockUsed.txtSPc_SOitem.Value	= ShowSQLtxt(tmpSPcmpltP.SOitem,'SOitem',10)
				ThisFormSet.frmStockUsed.txtSPC_WOD.Value 		= PrepareSQLnum(tmpSPcmpltP.WO_Detail,'WO_Detail',-3)
				ThisFormSet.frmStockUsed.txtSPc_Desc.Value		= ShowSQLtxt(tmpSPcmpltP.DescriptCL,'DescriptCL',100)
		
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refresh_fpoitem
		*ThisFormSet.Refresh_FPOitem()
		*used in Report print
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisFormSet.frmWorkorder.txtFPOitem.Value,'POitem',12)
		PRIVATE cSQL, nSQLEXEC 
		
		IF cPOitem != Proper_PO_item('')
			
			cSQL = "SELECT Company"
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Pounds, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig) AS Descript "
			cSQL = cSQL + ",Received,LEFT(Cond_Spec,1000) AS Cond_Spec ,LEFT(Misc_Purch,1000) AS Misc_Purch "
			cSQL = cSQL + ",Services,ConvServ,Equipment,Reconciled,Stock "
			cSQL = cSQL + " FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
			
		ELSE
			*Still need an Empty table
			cSQL = "SELECT Company"
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Pounds, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig) AS Descript "
			cSQL = cSQL + ",Received,LEFT(Cond_Spec,1000) AS Cond_Spec ,LEFT(Misc_Purch,1000) AS Misc_Purch "
			cSQL = cSQL + ",Services,ConvServ,Equipment,Reconciled,Stock "
			cSQL = cSQL + " FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WITH(NOLOCK) WHERE 0>0"
		
		ENDIF
			
		IF USED("tmpFPOitem")	
			USE IN tmpFPOitem
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpFPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpFPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpFPOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpFPOitem')
			IF RECCOUNT('tmpFPOitem')>0
		
			ENDIF	
		ENDIF
			
		
	ENDPROC

	PROCEDURE refresh_frmchoosewo_detail
		PARAMETERS nWO
		*ThisFormSet.Refresh_frmChooseWO_Detail(tmpWO.WO)  *WAS Refresh_ChooseWO_Detail
		*Selects all of the WorkOrder_Details for WO.
		*
		*use ThisFormSet.Show_frmChooseWO_WODetail(nWO_Detail) -First WO_Detail
		
		IF VARTYPE(nWO) != "N"
			TrackError("ThisFormSet.Refresh_frmChooseWO_Detail(WO) did not get Parameter nWO","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpWO_Detail")	
			USE IN tmpWO_Detail
		ENDIF
		SELECT 0
		
		cSQL = "SELECT WOD.*"
		cSQL = cSQL + ", ISNULL(AC.AC_ID,0) AS AC_ID_WOD "
		cSQL = cSQL + " FROM dbo.WorkOrder_Detail WOD "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AcctCost_WOD AC ON WOD.WO_Detail = AC.WO_Detail "
		cSQL = cSQL + " WHERE WOD.WO="+ALLTRIM(STR(nWO))
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Detail')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF 
		
		IF USED('tmpWO_Detail')
		
			ThisFormSet.Show_frmChooseWO_WODetail(tmpWO_Detail.WO_Detail)	&& -First WO_Detail
			*Calls:ThisFormSet.Show_frmChooseWO_Detail_Color()	
		ENDIF
	ENDPROC

	PROCEDURE refresh_frmchoosewo_wo
		PARAMETERS nWOa
		*ThisFormset.Refresh_frmChooseWO_WO(nWO)
		
		PRIVATE nWO
		
		nWO = nWOa
		
		
		IF USED('WorkOrder')
			SELECT WorkOrder
			
			IF RECCOUNT('WorkOrder')>0
				
				LOCATE FOR WO = nWO
				IF FOUND()
					ThisFormset.frmChooseWO.txtWO.Value 	= WorkOrder.WO
					
					ThisFormset.frmChooseWO.txtPieces.Value = WorkOrder.sPieces
					ThisFormset.frmChooseWO.txtAlloy.Value	= WorkOrder.sAlloy
					ThisFormset.frmChooseWO.cmbForm.Value	= WorkOrder.sForm
					ThisFormSet.RefreshForms_ChooseWO(WorkOrder.sForm)
					ThisFormset.frmChooseWO.cmbCC.Value		= WorkOrder.sCC
					ThisFormset.frmChooseWO.txtCL.Value		= WorkOrder.sCL
					ThisFormset.frmChooseWO.txtThck.Value	= WorkOrder.sThck
					ThisFormset.frmChooseWO.txtSz2.Value	= WorkOrder.sSz2
					ThisFormset.frmChooseWO.txtSz3.Value	= WorkOrder.sSz3
					ThisFormSet.frmChooseWO.chkComplete.Value = WorkOrder.cmplt
					ThisFormset.frmChooseWO.txtWeight.Value = WorkOrder.sWeight
					*ThisFormset.frmChooseWO.txtTotStartW.Value = WorkOrder.
					ThisFormset.frmChooseWO.txtEnterDate.Value = WorkOrder.EnterDate
					
					
					*
					*ThisFormset.frmChooseWO.chkIntP.Value 	= WorkOrder.IntP
					ThisFormset.frmChooseWO.txtDescript.Value = WorkOrder.Descript
					*ThisFormset.frmChooseWO.edtWO_Notes.Value = WorkOrder.Notes
					*ThisFormset.frmChooseWO.edtWO_Notes.Value = 'Starting Stock'
					*
					ThisFormset.frmChooseWO.txtAC_ID_WO.Value	= PrepareSQLnum(WorkOrder.AC_ID_WO,'AC_ID',-3)
					ThisFormset.frmChooseWO.txtPOitem.Value	= PrepareSQLtxt(WorkOrder.POitem,'POitem',12)
					ThisFormset.frmChooseWO.txtSOitem.Value	= PrepareSQLtxt(WorkOrder.SOitem,'SOitem',10)
					
					ThisFormset.frmChooseWO.chkWOcomplete.Value = PrepareSQLchk(WorkOrder.Cmplt,'Cmplt')
		
					*
					ThisFormSet.Refresh_frmChooseWO_Detail(WorkOrder.WO)
					*
					
					*ThisFormSet.Set_frmChooseWO()
					*ThisFormSet.Set_frmWorkOrder('ENABLE')
					
					*ThisFormSet.frmChooseWO.grdWO.RecordSource = 'WorkOrder'
					*is set in ThisFormSet.InitChooseWO()
					
				ELSE
				 *NOT FOUND
				ENDIF	
					
				ThisFormSet.Set_frmChooseWO()	
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refresh_frmstock_produced
		*ThisFormSet.RefreshStock_Produced()
		*ThisFormSet.Refresh_frmStock_Produced()
		
		IF USED('tmpStock_Produced')
			IF RECCOUNT('tmpStock_Produced') > 0
				ThisFormSet.frmStock_Produced.txtAlloy.Value = tmpStock_Produced.Alloy
				ThisFormSet.frmStock_Produced.txtForm.Value = tmpStock_Produced.Form
				ThisFormSet.frmStock_Produced.txtCC.Value = tmpStock_Produced.CC
				ThisFormSet.frmStock_Produced.txtCL.Value = tmpStock_Produced.CL
				ThisFormSet.frmStock_Produced.txtSize.Value = tmpStock_Produced.Size
				ThisFormSet.frmStock_Produced.txtCond.Value = tmpStock_Produced.Cond
		
				ThisFormSet.frmStock_Produced.txtSpecs.Value = tmpStock_Produced.Specs
				ThisFormSet.frmStock_Produced.txtPODueDate.Value = PrepareSQLDate(tmpStock_Produced.PODueDate,'PODueDate')
				*ThisFormSet.frmStock_Produced.txtMill.Value = tmpStock_Produced.Mill
				ThisFormSet.frmStock_Produced.txtStockDate.Value = PrepareSQLDate(tmpStock_Produced.StkDate,'StkDate')
				*ThisFormSet.frmStock_Produced.txtHistory.Value = tmpStock_Produced.History
				*ThisFormSet.frmStock_Produced.txtS_Qty.Value = tmpStock_Produced.S_Qty
				
				ThisFormSet.frmStock_Produced.txtPC.Value = tmpStock_Produced.PC
				*ThisFormSet.frmStock_Produced.txtSize_H.Value = tmpStock_Produced.Size_H
				ThisFormSet.frmStock_Produced.txtDim1.Value = tmpStock_Produced.Dim1
				*ThisFormSet.frmStock_Produced.txtSize_L.Value = tmpStock_Produced.Size_L
				ThisFormSet.frmStock_Produced.txtDim2.Value = tmpStock_Produced.Dim2
				ThisFormSet.frmStock_Produced.txtDim3.Value = tmpStock_Produced.Dim3
				ThisFormSet.frmStock_Produced.txtDescription.Value = tmpStock_Produced.Descript
				ThisFormSet.frmStock_Produced.txtLocation.Value = tmpStock_Produced.Location
				ThisFormSet.frmStock_Produced.txtReceivingID.Value = tmpStock_Produced.ReceivingID
				*ThisFormSet.frmStock_Produced.txtCostValue.Value = tmpStock_Produced.CostValue
				*ThisFormSet.frmStock_Produced.txtS_PU.Value = PrepareSQLtxt(tmpStock_Produced.S_PU,'S_PU',1)
				*ThisFormSet.frmStock_Produced.txtS_Qty.Value = tmpStock_Produced.S_Qty
				*ThisFormSet.frmStock_Produced.txtS_P.Value = tmpStock_Produced.S_P
				*ThisFormSet.frmStock_Produced.txtS_Total.Value = tmpStock_Produced.S_Total
				ThisFormSet.frmStock_Produced.txtLength.Value = tmpStock_Produced.Length
				
				
				ThisFormSet.frmStock_Produced.txtPWO_Detail.Value = PrepareSQLnum(tmpStock_Produced.PWO_Detail,'WO_Detail',-3)
				ThisFormSet.frmStock_Produced.txtID_Detail_Process.Value = PrepareSQLnum(tmpStock_Produced.ID_Detail_Process,'ID_Detail_Process',-3)
				ThisFormSet.frmStock_Produced.txtProcess_ID.Value = PrepareSQLtxt(tmpStock_Produced.Process_ID,'Process_ID',10)
				ThisFormSet.frmStock_Produced.txtPSOitem.Value = PrepareSQLtxt(tmpStock_Produced.PSOitem,'SOitem',10)
				
				PRIVATE nWO_Detail
				nWO_Detail = PrepareSQLnum(tmpStock_Produced.WO_Detail,'WO_Detail',-3)
				ThisFormSet.frmStock_Produced.txtWO_Detail.Value = nWO_Detail 
				
				
				IF nWO_Detail = 0
					*ThisFormSet.frmStock_Produced.cmdSaveWODtoStock.Enabled = .T.
					
					PRIVATE nNewWO_Detail
					nNewWO_Detail = PrepareSQLnum(ThisFormSet.frmStock_Produced.lblWO_D.Caption,'WO_Detail',-3) 
					IF nNewWO_Detail > 0
					*	ThisFormSet.frmStock_Produced.txtWO_Detail.Value = nNewWO_Detail
						ThisFormSet.frmStock_Produced.cmdSaveWODtoStock.Visible = .T.
						ThisFormSet.frmStock_Produced.cmdSaveWODtoStock.Enabled = .T.
					ENDIF
				ELSE
					ThisFormSet.frmStock_Produced.cmdSaveWODtoStock.Enabled = .F.
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refresh_frmworkorder_detail
		PARAMETERS nWO_Detail
		*ThisFormSet.Refresh_frmWorkOrder_Detail(nWO_Detail)
			*CALLS: ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_Detail.fPOitem)
			*CALLS: ThisFormSet.CheckFinish_ID_Detail()
			*CALLS:	ThisFormSet.Show_frmStock_Produced(nWOD)
			
		IF VARTYPE(nWO_Detail) != "N"
			MESSAGEBOX("Bad Parameter",0,"No nWO_Detail")
			TrackError("ThisFormSet.Refresh_frmWorkOrder_Detail(nWO_Detail) did not get Parameter nWOD","Error",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE lFound_WOD
		lFound_WOD = .F.
		
		
		IF USED('tmpWO_Detail')
			USE IN 'tmpWO_Detail'
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT WOD.*"
		cSQL = cSQL +", ISNULL(ACWOD.AC_ID,0) AS AC_ID_WOD "
		cSQL = cSQL +" FROM dbo.WorkOrder_Detail WOD "
		cSQL = cSQL +" LEFT OUTER JOIN dbo.AcctCost_WOD ACWOD WITH(NOLOCK) ON WOD.WO_Detail = ACWOD.WO_Detail "
		cSQL = cSQL +" WHERE WOD.WO_Detail ="+STR(nWO_Detail)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_Detail')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_Detail')
				IF RECCOUNT('tmpWO_Detail') > 0
					SELECT tmpWO_Detail
					LOCATE FOR WO_Detail = nWO_Detail
					IF FOUND()
						lFound_WOD = .T.
					ELSE
						GO TOP
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('tmpWO_Detail') AND lFound_WOD 
			IF FOUND('tmpWO_Detail')
				ThisFormSet.frmWorkOrder.txtWO_Detail.Value = nWO_Detail
				ThisFormSet.frmStockWO.lblWO_D.Caption = ALLTRIM(STR(nWO_Detail))
				
				ThisFormset.frmWorkOrder.txtFPieces.Value	= PrepareSQLnum(tmpWO_Detail.fPieces,'Pieces',-3)
				ThisFormset.frmWorkOrder.txtFAlloy.Value	= PrepareSQLtxt(tmpWO_Detail.fAlloy,'Alloy',12)
				ThisFormset.frmWorkOrder.cmbFForm.Value		= PrepareSQLtxt(tmpWO_Detail.fForm,'Form',2)
				ThisFormSet.RefreshFForms(tmpWO_Detail.fForm)
				ThisFormset.frmWorkOrder.cmbFcc.Value		= PrepareSQLtxt(tmpWO_Detail.fCC,'CC',1)
				ThisFormSet.InitcmbFCL()
		
				ThisFormset.frmWorkOrder.cmbFCL.Value		= PrepareSQLtxt(tmpWO_Detail.fCL,'CL',1)
				ThisFormset.frmWorkOrder.txtFThck.Value		= PrepareSQLnum(tmpWO_Detail.fThck,'Thck',10,4)
				ThisFormset.frmWorkOrder.txtFSz2.Value		= PrepareSQLnum(tmpWO_Detail.fSz2,'Sz2',9,3)
				ThisFormset.frmWorkOrder.txtFSz3.Value		= PrepareSQLnum(tmpWO_Detail.fSz3,'Sz3',9,3)
				ThisFormSet.frmWorkOrder.chkPinFWeight.Value	= PrepareSQLchk(tmpWO_Detail.pinFWeight,'pinFWeight')
				ThisFormset.frmWorkOrder.txtFWeight.Value 	= PrepareSQLnum(tmpWO_Detail.fWeight,'Weight',9,1)
		
				ThisFormset.frmWorkOrder.txtFSpec.Value		= PrepareSQLtxt(tmpWO_Detail.fSpec,'FSpec',50)
		
				ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = PrepareSQLnum(tmpWO_Detail.Stock_Projected_ID,'Stock_Projected_ID',-3)
				ThisFormSet.nStock_Projected_ID = ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value		
				
				ThisFormSet.Refresh_Projected()
				
				ThisFormSet.frmWorkorder.txtFID_Detail.Value = PrepareSQLnum(tmpWO_Detail.fID_Detail,'ID_Detail',-3)
				IF PrepareSQLnum(tmpWO_Detail.fID_Detail,'ID_Detail',-3) > 0
					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(0,128,255)
				ELSE
					ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(240,240,240)
				ENDIF	
				ThisFormSet.frmWorkorder.txtFID_Detail_Process.Value = PrepareSQLnum(tmpWO_Detail.fID_Detail_Process,'ID_Detail_Process',-3)
				ThisFormSet.frmWorkorder.txtfTBL.Value 			= PrepareSQLtxt(tmpWO_Detail.fTBL,'TBL',1)
				ThisFormSet.frmWorkorder.txtfReceivingID.Value 	= PrepareSQLnum(tmpWO_Detail.fReceivingID,'ReceivingID',-3)
				
				ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= PrepareSQLnum(tmpWO_Detail.AC_ID_WOD,'AC_ID',-3)
				
				ThisFormSet.frmWorkorder.txtFSOitem.Value	= PrepareSQLtxt(tmpWO_Detail.fSOitem,'SOitem',10)
				ThisFormSet.frmWorkorder.txtFPOitem.Value	= PrepareSQLtxt(tmpWO_Detail.fPOitem,'POitem',12)
				
				ThisFormSet.frmWorkorder.txtFDescript.Value	= PrepareSQLtxt(tmpWO_Detail.fDescript,'Descript',100)
				ThisFormset.frmWorkOrder.txtfCondLevel.Value= PrepareSQLtxt(tmpWO_Detail.fCondLevel,'fCondLevel',30)
				
				ThisFormset.frmWorkOrder.cmbFollowM.Value	= PrepareSQLtxt(tmpWO_Detail.FollowM,'FollowM',20)
				ThisFormset.frmWorkOrder.txtFollowLot.Value	= PrepareSQLnum(tmpWO_Detail.FollowLot,'FollowLot',-3)
				ThisFormset.frmWorkOrder.cmbFinishM.Value	= PrepareSQLtxt(tmpWO_Detail.FinishM,'FinishM',20)
				ThisFormset.frmWorkOrder.txtFinishLot.Value	= PrepareSQLnum(tmpWO_Detail.FinishLot,'FinishLot',-3)
				
				ThisFormset.frmWorkOrder.txtTestPO.Value	= PrepareSQLtxt(tmpWO_Detail.TestPO,'POitem',12)
				
				ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(tmpWO_Detail.StartSize,'StartSize',8,3)
				ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(tmpWO_Detail.CW,'CW',-1)
				ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(tmpWO_Detail.RoughSize,'RoughSize',8,3)
				ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(tmpWO_Detail.OverSize,'OverSize',5,3)
				
				ThisFormSet.frmWorkorder.edtfNotes.Value	= PrepareSQLtxt(tmpWO_Detail.fNotes,'Notes',-1)
				
			
				ThisFormSet.frmWorkorder.txtFDueDate.Value	= PrepareSQLdate(tmpWO_Detail.fDueDate,'DueDate')
				ThisFormSet.frmWorkOrder.cmbNextCode.Value	= PrepareSQLtxt(tmpWO_Detail.NextCode,'NextCode',3)
				ThisFormSet.frmWorkOrder.txtNextNumber.Value = PrepareSQLtxt(tmpWO_Detail.NextNumber,'NextNumber',10)
		
				
				ThisFormSet.frmWorkOrder.chkfCmplt.Value 	= PrepareSQLchk(tmpWO_Detail.fCmplt,'fCmplt')
				ThisFormSet.frmWorkOrder.chkfCncld.Value	= PrepareSQLchk(tmpWO_Detail.fCncld,'fCncld')
				
				ThisFormSet.frmWorkOrder.chkStkListed.Value = PrepareSQLchk(tmpWO_Detail.StkListed,'StkListed')
				
				*************************************		
				ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_Detail.fPOitem)
		
				IF ThisFormSet.CheckFinish_ID_Detail()
				ENDIF
				IF ThisFormSet.CheckFinish_ID_Detail_Process()
				ENDIF
				
				**********
				PRIVATE nWOD_pos
				nWOD_pos = ASCAN(gaWO_Detail, tmpWO_Detail.WO_Detail) 
				IF nWOD_pos > 0
					ThisFormSet.frmWorkOrder.lstWO_Detail.Value = nWOD_pos
					*ThisFormSet.frmWorkOrder.lstWO_Detail.Value = tmpWO_Detail.WO_Detail 
					ThisFormSet.frmWorkOrder.lstWO_Detail.Visible = .T.
					ThisFormSet.frmWorkOrder.lstWO_Detail.Refresh
				ENDIF
		
		*		ThisFormSet.frmWorkOrder.lstWO_Detail.Value = nWO_Detail  &&RECNO('tmpWO_Detail')
				
				ThisFormSet.Show_frmStock_Produced(nWO_Detail)
				
				IF NOT ThisFormSet.frmWO_Detail_SO.Visible
					ThisFormSet.frmWO_Detail_SO.Top = ThisFormSet.frmWorkOrder.Top + 250
					ThisFormSet.frmWO_Detail_SO.LEFT = ThisFormSet.frmWorkOrder.LEFT + ThisFormSet.frmWorkOrder.Width
					ThisFormSet.frmWO_Detail_SO.WO_Detail_SO_init(nWO_Detail)
				ELSE
					ThisFormSet.frmWO_Detail_SO.RefreshWO_Detail_SO(tmpWO_Detail.WO_Detail)
				ENDIF
				
				ThisFormSet.Set_frmWorkOrder('ENABLE')
				
			ELSE
				MESSAGEBOX("Could not find WO_Detail:"+ALLTRIM(STR(nWO_Detail)),0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refresh_frmworkorder_fpoitem
		PARAMETERS pfPOitem
		*ThisFormSet.Refresh_frmWorkOrder_FPOitem(pfPOitem)
		*Also see ThisFormSet.Refresh_FPOitem()
		ThisFormSet.frmWorkOrder.txtFPOCompany.Value = ''
		ThisFormSet.frmWorkOrder.txtFPODescript.Value = ''
		ThisFormSet.frmWorkOrder.txtFPOReceived.Value = ''
		ThisFormSet.frmWorkOrder.edtFPOCond_Spec.Value = ''
		ThisFormSet.frmWorkOrder.edtFPOMisc_Purch.Value = ''
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(pfPOitem,'POitem',12)
		PRIVATE cSQL, nSQLEXEC 
		
		IF cPOitem = Proper_PO_item('')
			RETURN
		ELSE
			cSQL = "SELECT Company"
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Order_Qty, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig) AS Descript "
			cSQL = cSQL + ",Received"
			
			cSQL = cSQL + ",Cond_Spec,Misc_Purch"
			*cSQL = cSQL + ",LEFT(Cond_Spec,1000) AS Cond_Spec "
			*cSQL = cSQL + ",LEFT(Misc_Purch,1000) AS Misc_Purch "
			
			cSQL = cSQL + ",Services,ConvServ,Equipment,Reconciled,Stock "
			cSQL = cSQL + " FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		ENDIF
			
		IF USED("tmpWO_FPOitem")	
			USE IN tmpWO_FPOitem
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_FPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_FPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_FPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_FPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_FPOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpWO_FPOitem')
			IF RECCOUNT('tmpWO_FPOitem')>0
				ThisFormSet.frmWorkOrder.txtFPOCompany.Value  = tmpWO_FPOitem.Company
				ThisFormSet.frmWorkOrder.txtFPODescript.Value = tmpWO_FPOitem.Descript
				ThisFormSet.frmWorkOrder.txtFPOReceived.Value = TTOC( PrepareSQLdate(tmpWO_FPOitem.Received,'Received'))
				ThisFormSet.frmWorkOrder.edtFPOCond_Spec.Value = tmpWO_FPOitem.Cond_Spec
				ThisFormSet.frmWorkOrder.edtFPOMisc_Purch.Value = tmpWO_FPOitem.Misc_Purch
				
				**Check WO_Notes with edtFPOCond_Spec and edtfNotes with edtFPOMisc_Purch
				PRIVATE cWO_Notes, cFPOCond_Spec, cfNotes, cFPOMisc_Purch
				cWO_Notes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtWO_Notes.Value,'Cond_Spec',-3)
				cFPOCond_Spec	= PrepareSQLtxt(tmpWO_FPOitem.Cond_Spec,'Cond_Spec',-3)
				
				cfNotes			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtfNotes.Value,'Misc_Purch',-3)
				cFPOMisc_Purch	= PrepareSQLtxt(tmpWO_FPOitem.Misc_Purch,'Misc_Purch',-3)
				
				PRIVATE nMess
				IF NOT EMPTY(ALLTRIM(cFPOCond_Spec))
					*add cFPOCond_Spec to WO
					IF EMPTY(cWO_Notes)
						*nMess = MESSAGEBOX("Do you want to Add the Finish"+CHR(13)+"PO Condition / Specs"+CHR(13)+"to the WO Notes?"+CHR(13)+CHR(13)+"This usually is the same data. PO may have changed."+CHR(13)+CHR(13)+"You will need to 'Save WO' after this.",4+32,"Copy PO Cond to WO notes?")
						*IF nMess = 6
							ThisFormSet.frmWorkOrder.edtWO_Notes.Value = cFPOCond_Spec
						*ENDIF
					ELSE
						*IF cWO_Notes <> cFPOCond_Spec
						*	nMess = MESSAGEBOX("Do you want to copy over the Finish"+CHR(13)+"PO Condition / Specs"+CHR(13)+"to the WO Notes?"+CHR(13)+CHR(13)+"This usually is the same data. PO may have changed."+CHR(13)+"You will bw asked again."+CHR(13)+CHR(13)+"You will need to 'Save WO' after this.",4+32,"Copy PO Cond to WO notes?")
						*	IF nMess = 6
						*		ThisFormSet.frmWorkOrder.edtWO_Notes.Value = cFPOCond_Spec
						*	ENDIF
						*ENDIF
					ENDIF
				ENDIF
				
				IF NOT EMPTY(ALLTRIM(cFPOMisc_Purch))
					*add cFPOMisc_Purch to WO
					IF EMPTY(cfNotes)
						*nMess = MESSAGEBOX("Do you want to copy the Finish"+CHR(13)+"PO Miscellaneous Notes to the "+CHR(13)+"'WO Detail' Notes to the Shop?"+CHR(13)+CHR(13)+"This usually is the same data. PO may have changed."+CHR(13)+"You will bw asked again."+CHR(13)+CHR(13)+"You will need to 'Save Detail' after this.",4+32,"Copy PO Misc Notes to 'WO Detail' Notes?")
						*IF nMess = 6
							ThisFormSet.frmWorkOrder.edtfNotes.Value = cFPOMisc_Purch
						*ENDIF
					ELSE
						IF cFPOMisc_Purch <> cfNotes
							*nMess = MESSAGEBOX("Do you want to copy the Finish"+CHR(13)+"PO Miscellaneous Notes to the "+CHR(13)+"'WO Detail' Notes to the Shop?"+CHR(13)+CHR(13)+"This usually is the same data. PO may have changed."+CHR(13)+"You will bw asked again."+CHR(13)+CHR(13)+"You will need to 'Save Detail' after this.",4+32,"Copy PO Misc Notes to 'WO Detail' Notes?")
							*IF nMess = 6
							*	ThisFormSet.frmWorkOrder.edtfNotes.Value = cFPOMisc_Purch
							*ENDIF
						ENDIF
					ENDIF
				ENDIF		
				
			ENDIF	
		*	USE IN tmpWO_FPOitem
		ENDIF
			
		
	ENDPROC

	PROCEDURE refresh_lstwo_detail
		*!*	PARAMETERS nWO_Detail
		*!*	*ThisFormSet.Refresh_lstWO_Detail(nWO_Detail)
		
		*!*	PRIVATE nWO
		*!*	nWO = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		
		*!*	*Reset
		*!*	DIMENSION gaWO_Detail(1)
		*!*	gaWO_Detail(1) = 0
		
		*!*	ThisFormSet.frmWorkOrder.txtWO_Detail.Value = 0
		
		*!*	PRIVATE cSQL, nSQLEXEC 
		
		*!*	IF USED("tmpWO_Detail_WO_Detail")	
