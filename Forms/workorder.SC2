	PROCEDURE refresh_projected		&& Shows Projected Stock mechanicals or makes invisble
		*ThisFormSet.Refresh_Projected()
		
		PRIVATE nStock_Projected_ID
		nStock_Projected_ID = ThisFormSet.nStock_Projected_ID
		
		IF nStock_Projected_ID = 0
			ThisFormSet.frmWorkOrder.lblCWcnt.Visible = .F.	
			ThisFormSet.frmWorkOrder.txtCWcnt.Visible = .F.
			ThisFormSet.frmWorkOrder.lblCWmin.Visible = .F.	
			ThisFormSet.frmWorkOrder.txtCWmin.Visible = .F.
			ThisFormSet.frmWorkOrder.lblCWavg.Visible = .F.	
			ThisFormSet.frmWorkOrder.txtCWavg.Visible = .F.
			ThisFormSet.frmWorkOrder.lblCWmedian.Visible = .F.	
			ThisFormSet.frmWorkOrder.txtCWmedian.Visible = .F.
			ThisFormSet.frmWorkOrder.lblCWmax.Visible = .F.	
			ThisFormSet.frmWorkOrder.txtCWmax.Visible = .F.
		ELSE
		
			IF USED("tmpProjStkAvg")	
				USE IN tmpProjStkAvg
			ENDIF
			SELECT 0
			PRIVATE cSQL, nSQLEXEC 
			
			cSQL = "SELECT ISNULL(dbo.f_CC_CL_Cnt(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWCnt "
			cSQL = cSQL + ",ISNULL(dbo.f_CC_CL_Min_Cw(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWMin "
			cSQL = cSQL + ",ISNULL(dbo.f_CC_CL_Avg_Cw(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWAvg "
			cSQL = cSQL + ",ISNULL(dbo.f_CC_CL_Median_Cw(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWMedian "
			cSQL = cSQL + ",ISNULL(dbo.f_CC_CL_Max_Cw(SP.Alloy,SP.CC,SP.CL,SP.Thck),0) AS CWMax "
			cSQL = cSQL + " FROM dbo.Stock_Projected SP "
			cSQL = cSQL + " WHERE SP.ID = "+ALLTRIM(STR(nStock_Projected_ID ))
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProjStkAvg')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpProjStkAvg')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjStkAvg")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjStkAvg")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProjStkAvg')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED("tmpProjStkAvg")
					IF RECCOUNT("tmpProjStkAvg") > 0
		
						ThisFormSet.frmWorkOrder.lblCWcnt.Visible = .T.	
						ThisFormSet.frmWorkOrder.txtCWcnt.Visible = .T.
						ThisFormSet.frmWorkOrder.lblCWmin.Visible = .T.	
						ThisFormSet.frmWorkOrder.txtCWmin.Visible = .T.
						ThisFormSet.frmWorkOrder.lblCWavg.Visible = .T.	
						ThisFormSet.frmWorkOrder.txtCWavg.Visible = .T.
						ThisFormSet.frmWorkOrder.lblCWmedian.Visible = .T.	
						ThisFormSet.frmWorkOrder.txtCWmedian.Visible = .T.
						ThisFormSet.frmWorkOrder.lblCWmax.Visible = .T.	
						ThisFormSet.frmWorkOrder.txtCWmax.Visible = .T.
		
						ThisFormSet.frmWorkOrder.txtCWcnt.Value	= PrepareSQLnum(tmpProjStkAvg.CWCnt,'CWCnt',2,0)
						ThisFormSet.frmWorkOrder.txtCWmin.Value	= PrepareSQLnum(tmpProjStkAvg.CWMin,'CWMin',2,0)
						ThisFormSet.frmWorkOrder.txtCWavg.Value	= PrepareSQLnum(tmpProjStkAvg.CWAvg,'CWAvg',2,0)
						ThisFormSet.frmWorkOrder.txtCWmedian.Value	= PrepareSQLnum(tmpProjStkAvg.CWMedian,'CWMedian',2,0)
						ThisFormSet.frmWorkOrder.txtCWmax.Value	= PrepareSQLnum(tmpProjStkAvg.CWMax,'CWMax',2,0)
					ENDIF
					USE IN tmpProjStkAvg
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

