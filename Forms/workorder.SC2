				ThisFormSet.frmWorkOrder.txtNextNumber.Enabled = .T.
		
			*	ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Enabled = .T.
				ThisFormSet.Refresh_Projected()
			*	ThisFormSet.frmWorkOrder.txtTotFinishW.Enabled = .T.  &&Computed Field
				
			ENDIF
		
			
			ThisFormSet.frmWorkOrder.cmdReportTotals.Enabled = .T.
			
			*ThisFormSet.CheckPOitemProcess()
			
		CASE cWhat = 'DISABLE'
