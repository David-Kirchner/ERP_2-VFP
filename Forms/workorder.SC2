	PROCEDURE frmChooseWO.lblAcctCosting.Click
		PRIVATE nAcctCosting_ID
		nAcctCosting_ID = PrepareSQLnum(ThisForm.txtAC_ID_WOD.Value,'AC_ID',-3)
		
		IF nAcctCosting_ID > 0
			MESSAGEBOX("The 'Accounting Costing' has already begun.",0,"Return")
			RETURN 
		ENDIF
		
		nAcctCosting_ID = AcctCosting_Start()
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_detail',-3)
		
		IF nAcctCosting_ID > 0
			IF NOT AcctCosting_WOD_Update(nAcctCosting_ID, nWO_Detail )
				*Reset
				nAcctCosting_ID = 0
			ENDIF
		ENDIF
		
		IF nAcctCosting_ID > 0
			ThisForm.txtAC_ID_WOD.Value = nAcctCosting_ID
			
			SELECT tmpWO_Detail
			REPLACE AC_ID_WOD WITH nAcctCosting_ID
			
			WAIT WINDOW 'Sent to Accounting' NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE frmChooseWO.txtFAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisFormSet.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

