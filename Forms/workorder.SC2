	PROCEDURE frmWorkOrder.lblChooseS_POitem.Click
		PRIVATE nHPAPO, cPoItem
		cPoItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		nHPAPO = VAL(cPoItem)
		PRIVATE nMess
		nMess = 0
		
		IF nHPAPO > 0
			nMess = MESSAGEBOX("A PO is listed here. '"+cPoItem+"'"+CHR(13)+"Do you want to keep this PO number?"+CHR(13)+"Answer Y to Continue."+CHR(13)+"Answer N to clear the PO Number.",4+32,"Continue with PO?")
			IF nMess = 7
				*Yes, Clear POitem field
				ThisForm.txtPOitem.Value = ''
				
				*ThisFormSet.Remove_POitem(cPoItem,'WO')
				PRIVATE nCurrWO
				nCurrWO = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
				ThisFormSet.WO_POitem(nCurrWO, cPOitem, "REMOVE")
				
				MESSAGEBOX("The PO item value '"+cPoItem +"' has been removed from this Work Order."+CHR(13)+"This edit needs to be saved.",0+48,"Removed POitem.")
				RETURN
			ENDIF
		ENDIF
		
		IF nHPAPO = 0
			nMess = MESSAGEBOX("Are you trying to import the contents of a PO?"+CHR(13)+"Answer Y to Select an EXISITING POitem."+CHR(13)+"Answer N to create a NEW PO.",4+32,"Select a PO to use.")
			IF nMess <> 6
				MESSAGEBOX("Please Create a PO from the HPA App Menu."+CHR(13)+"Sales\Purchase Order",0+48,"Not Programmed here.")
				RETURN 
			ENDIF
			
			IF nMess = 6
				*Select POitem
				DO FORM Forms\SelectPO_item WITH 0 TO cPOItem
				
				IF Proper_PO_item(cPOitem) != Proper_PO_item('')
					ThisForm.txtPOitem.Value = PrepareSQLtxt(cPoItem,'POitem',12)
					
					WAIT WINDOW "Need to Save with WO" NOWAIT
				ELSE
					ThisForm.txtPOitem.Value = ''
					WAIT WINDOW "This edit needs to be saved to WO." NOWAIT	
					RETURN
				ENDIF
			ENDIF
		ENDIF
		
		***********
		
		PRIVATE nWO, lRE
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		*lIntP = PrepareSQLlogic(ThisForm.chkIntP.Value,'IntP')
		lRE = PrepareSQLlogic(ThisForm.chkRE.Value,'RE')
		PRIVATE cAlloy
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		
		*read again
		cPoItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		PRIVATE lKeepWO 
		lKeepWO = .T.
		
		IF Proper_PO_item(cPoItem) != Proper_PO_item('') 
		
			IF LEN(cAlloy) = 0
				*No Alloy to compare with
			ELSE
				**Print Error if different Alloys
				PRIVATE cAlloyPO, cDispAlloy 
				cAlloyPO = ''
				cDispAlloy = ''
				
				IF USED('tmpPOAlloy')
					USE IN tmpPOAlloy
				ENDIF
				
				cSQL = "SELECT Alloy, DispAlloy FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOAlloy')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOAlloy")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOAlloy")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOAlloy')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF	
				
				IF USED('tmpPOAlloy')
					IF RECCOUNT('tmpPOAlloy') > 0
						cAlloyPO = PrepareSQLtxt(tmpPOAlloy.Alloy,'Alloy',12)
						cDispAlloy = PrepareSQLtxt(tmpPOAlloy.DispAlloy,'DispAlloy',20)
						
						IF cAlloy != cAlloyPO
							IF cAlloy != cDispAlloy
								*Warn
								nMess =	MESSAGEBOX("Are you sure this POitem is right for this WO?"+CHR(13)+"The WO Alloy = '"+cAlloy+"'"+CHR(13)+"The PO Alloy = '"+cAlloyPO+"'"+CHR(13)+"The PO Display Alloy = '"+cDispAlloy+"'",4+32,"Continue with this PO item?")
								IF nMess != 6
									USE IN tmpPOAlloy
									RETURN
								ELSE
									RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Answered Yes when asked."+CHR(13)+"Are you sure this POitem is right for this WO?"+CHR(13)+"The WO Alloy = '"+cAlloy+"'"+CHR(13)+"The PO Alloy = '"+cAlloyPO+"'"+CHR(13)+"The PO Display Alloy = '"+cDispAlloy+"'")
								ENDIF	
							ENDIF
						ENDIF
						
					ENDIF
					USE IN tmpPOAlloy
				ENDIF
			ENDIF
			
			*************************
			
			nMess = MESSAGEBOX("This is your chance to fill in the WO."+CHR(13)+"Start Data"+CHR(13)+"Do you want this PO to REPLACE Alloy, Form, Dims...?",4+32,"Overwrite WO with PO info?") 
			IF nMess = 6
				ThisFormSet.cWhat2 = "START"
				IF ThisFormSet.AddWO_POitem(cPOitem)
				
					IF ThisFormSet.CheckFinish_ID_Detail()
					ENDIF
					
					IF ThisFormSet.CheckFinish_ID_Detail_Process()
					ENDIF
		
					ThisFormSet.Set_frmWorkOrder('ENABLE')  &&Does Start and Finish
		
				ENDIF
				
				*have PO, pull in Data
				ThisFormSet.frmWorkOrder.txtPOitem.Value = cPOitem
				ThisFormSet.frmWorkOrder.txtPOitem.Refresh
				
				*******************************
				IF nWO > 0
		
					*******************************
					*Update PO with WO
					cSQL = "UPDATE dbo.PurchaseOrder SET WO="+STR(nWO)
					*cSQL = cSQL + ",IntP="+IIF(lIntP,"1","0")
					cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 			
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF	
					
		
					*******************************
					
					*UPDATE WorkOrder
					cSQLu = "UPDATE dbo.WorkOrder SET"
				*	cSQLu = cSQLu + ",SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
					cSQLu = cSQLu + " POitem = dbo.f_ProperPOitem('"+cPoItem+"')"
					*cSQLu = cSQLu + ",IntP="+IIF(lIntP,"1","0")
					cSQLu = cSQLu + " WHERE WO= "+STR(nWO)
					 
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 		
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
					ENDIF
					
					*******************************
		
				ENDIF
				
			ELSE
				nMess = MESSAGEBOX("Do you want to Edit this POitem?",4+32,"View/Edit PO info?") 
				IF nMess = 6
					PRIVATE nPOnum
					nPOnum = VAL(cFPOitem)
					
					DO FORM Forms\PurchaseOrder_Modal WITH nPOnum, "EDIT"
					*Modal waits for the form Release before continue ing
					
				ENDIF
			ENDIF
		ENDIF
		
		
		*!*		cSQLu = "UPDATE dbo.BrokerLst_Detail "
		*!*		cSQLu = cSQLu + " SET WO = "+STR(nWO)
		*!*		cSQLu = cSQLu + " FROM dbo.BrokerLst_Detail D "
		*!*		cSQLu = cSQLu + " INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
		*!*		cSQLu = cSQLu + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
