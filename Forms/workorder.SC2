	PROCEDURE frmGFMlog.cmdRA.Click
		ThisFormSet.frmRedArea.Visible = .T.
		
		ThisFormSet.frmRedArea.Top = ThisFormSet.frmWorkOrder.Top
		*ThisFormSet.frmRedArea.Left = ThisForm.Left + ThisForm.Width 
		ThisFormSet.frmRedArea.Left = ThisFormSet.frmWorkOrder.shpDivide.Left
		
		PRIVATE nThck, nSz2, nFthck, nFSz2
		nThck		= PrepareSQLnum(ThisForm.txtSsize.Value,'Thck',14,4)
		nSz2		= PrepareSQLnum(ThisForm.txtSlength.Value,'Sz2',13,3)
		
		nFthck		= PrepareSQLnum(ThisForm.txtGFMsize.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisForm.txtFlength.Value,'Sz2',13,3)
		
		PRIVATE nStartSize, nCW, nRoughSize, nOverSize
		nStartSize	= nThck &&PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtColdwork.Value,'CW',-1)/100
		nRoughSize	= nFthck &&PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= nFthck &&PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		
		IF nThck> 0
			ThisFormSet.frmRedArea.txtD123.Value = nThck
		ENDIF
		IF nSz2 > 0
			ThisFormSet.frmRedArea.txtL124.Value = nSz2
		ENDIF
		IF nFthck > 0
			ThisFormSet.frmRedArea.txtD225.Value = nFthck 
		ENDIF
		IF nFSz2 > 0
			ThisFormSet.frmRedArea.txtL226.Value = nFSz2 
		ENDIF
		
		IF nStartSize>0 AND ( nCW>0 OR nRoughSize>0 )
			ThisFormSet.frmRedArea.txtD123.Value = nStartSize
			IF nRoughSize > 0
				ThisFormSet.frmRedArea.txtD225.Value = nRoughSize 
			ENDIF	
			IF nCW > 0
				ThisFormSet.frmRedArea.txtRA36.Value = nCW
			ENDIF
		ENDIF
		
		ThisFormSet.frmRedArea.txtD123.SetFocus()
	ENDPROC

