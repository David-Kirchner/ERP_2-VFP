	PROCEDURE refreshid_detail_process
		PARAMETERS nID_Detail_Process 
		*ThisFormSet.RefreshID_Detail_Process(nID_Detail_Process )
		
		IF NOT USED('tmpSPStart')
			ThisFormSet.frmWorkOrder.cmdWO_StockProc.Visible = .F.
			WAIT WINDOW "TABLE 'tmpSPStart' is not open, Any key..."
			*ThisFormSet.Load_tmpSPStart(nWO)
		ELSE
			SELECT tmpSPStart 
		
			IF nID_Detail_Process > 0
				LOCATE FOR ID_Detail_Process = nID_Detail_Process
			ELSE
				*Anything that works!
				IF RECCOUNT('tmpSPStart') > 0
					IF EOF('tmpSPStart')
						GO BOTTOM
						nID_Detail_Process = tmpSPStart.ID_Detail_Process 
					ENDIF
					IF RECNO('tmpSPStart') < 1
						GO TOP
						nID_Detail_Process = tmpSPStart.ID_Detail_Process
					ENDIF
				ELSE
					*no records
					nID_Detail_Process = 0
				ENDIF
			ENDIF
					
			IF nID_Detail_Process = 0
		
				ThisFormSet.frmWorkOrder.txtSPS_StartDate.Value = CTOD("")
				ThisFormSet.frmWorkOrder.txtSPS_Process_ID.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_QTY.Value 		= 0
				ThisFormSet.frmWorkOrder.txtSPS_ID_Detail.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_ID_Detail_Process.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_TBL.Value		= ""
		
				ThisFormSet.frmWorkOrder.txtSPS_S_Qty.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_Dim1.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_Dim2.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_Dim3.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_Heat.Value = ""
				
				ThisFormSet.frmWorkOrder.txtSPS_QTY_Total.Value = 0
				
				ThisFormSet.frmWorkOrder.txtSPS_Pounds.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_PQTY.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_PPU.Value = 0
				ThisFormSet.frmWorkOrder.txtSPS_POrdered_QTY .Value = 0
				
				ThisFormSet.frmWorkOrder.cmdWO_StockProc.Visible = .F.	
				
				************************************************************************
				ThisFormSet.RefreshID_Detail_ProcessP( nID_Detail_Process )
				************************************************************************
				
			ELSE
				ThisFormSet.frmWorkOrder.txtSPS_StartDate.Value = PrepareSQLdate(tmpSPStart.StartDate,'StartDate')
				ThisFormSet.frmWorkOrder.txtSPS_Process_ID.Value = tmpSPStart.Process_ID
				ThisFormSet.frmWorkOrder.txtSPS_QTY.Value 		= PrepareSQLnum(tmpSPStart.QTY,'QTY',10,0)  &&Process_QTY
				ThisFormSet.frmWorkOrder.txtSPS_ID_Detail.Value = tmpSPStart.ID_Detail
				ThisFormSet.frmWorkOrder.txtSPS_ID_Detail_Process.Value = tmpSPStart.ID_Detail_Process
				ThisFormSet.frmWorkOrder.txtSPS_TBL.Value		= tmpSPStart.TBL
		
				ThisFormSet.frmWorkOrder.txtSPS_S_Qty.Value = PrepareSQLnum(tmpSPStart.S_QTY,'S_QTY',10,0)	&&QTY available in Detail
				ThisFormSet.frmWorkOrder.txtSPS_Dim1.Value = tmpSPStart.Dim1
				ThisFormSet.frmWorkOrder.txtSPS_Dim2.Value = tmpSPStart.Dim2
				ThisFormSet.frmWorkOrder.txtSPS_Dim3.Value = tmpSPStart.Dim3
				ThisFormSet.frmWorkOrder.txtSPS_Heat.Value = tmpSPStart.Heat
				
				*ThisFormSet.frmWorkOrder.txtSPS_QTY_Total.Value = 0
				
				*ThisFormSet.frmWorkOrder.txtSPS_Pounds.Value = tmpSPStart.Pounds
				*ThisFormSet.frmWorkOrder.txtSPS_PQTY.Value = 0
				*ThisFormSet.frmWorkOrder.txtSPS_PPU.Value = 0
				*ThisFormSet.frmWorkOrder.txtSPS_POrdered_QTY .Value = 0
		
				ThisFormSet.frmWorkOrder.cmdWO_StockProc.Visible = .T.
				
				************************************************************************
				ThisFormSet.RefreshID_Detail_ProcessP( nID_Detail_Process )
				ThisFormSet.frmWorkOrder.lstSPStart.SetFocus
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refreshid_detail_processcp
		PARAMETERS nID_Detail_ProcessCP
		*ThisFormSet.RefreshID_Detail_ProcessCP(nID_Detail_ProcessCP)
		
		nID_Detail_ProcessCP = PrepareSQLnum(nID_Detail_ProcessCP,'ID_Detail_Process',-3)
		
		IF nID_Detail_ProcessCP = 0
			ThisFormSet.frmStockUsed.txtSPc_TBL.Value 			= ""
			ThisFormSet.frmStockUsed.txtSPc_Heat.Value			= ""
			ThisFormSet.frmStockUsed.txtSPc_StockEdit.Value		= CTOD("")
			ThisFormSet.frmStockUsed.txtSPc_StockLst_PC.Value	= 0
			ThisFormSet.frmStockUsed.txtSPc_StockLst_Qty.Value	= 0
			ThisFormSet.frmStockUsed.txtSPc_ID_Detail.Value		= 0
			ThisFormSet.frmStockUsed.txtSPc_ID_Detail_Process.Value = 0
			
			ThisFormSet.frmStockUsed.txtSPc_SOitem.Value 	= ''
			ThisFormSet.frmStockUsed.txtSPc_WOD.Value 	= 0
			ThisFormSet.frmStockUsed.txtSPc_Desc.Value		= ''
			
			ThisFormSet.frmStockUsed.Visible = .F.
		ELSE
		
			IF NOT USED('tmpSPcmpltP')
				IF ThisFormSet.nWO > 0
					ThisFormSet.Load_tmpSPcmpltP(ThisFormSet.nWO)
				ENDIF
			ENDIF
		
			IF NOT USED('tmpSPcmpltP')
				WAIT WINDOW "TABLE 'tmpSPcmpltP' is not open, Any key..."
			ELSE	
				SELECT tmpSPcmpltP
				IF nID_Detail_ProcessCP > 0
					LOCATE FOR ID_Detail_Process = nID_Detail_ProcessCP
				ENDIF
				
				ThisFormSet.frmStockUsed.Visible = .T.
				
				ThisFormSet.frmStockUsed.txtSPc_TBL.Value 			= tmpSPcmpltP.TBL
				ThisFormSet.frmStockUsed.txtSPc_Heat.Value			= tmpSPcmpltP.Heat
				ThisFormSet.frmStockUsed.txtSPc_StockEdit.Value		= tmpSPcmpltP.DateMod
				ThisFormSet.frmStockUsed.txtSPc_StockLst_PC.Value	= tmpSPcmpltP.Pieces 
				ThisFormSet.frmStockUsed.txtSPc_StockLst_Qty.Value	= tmpSPcmpltP.Qty
				ThisFormSet.frmStockUsed.txtSPc_ID_Detail.Value		= tmpSPcmpltP.StockLst_ID_Detail
				ThisFormSet.frmStockUsed.txtSPc_ID_Detail_Process.Value = tmpSPcmpltP.ID_Detail_Process
				
				ThisFormSet.frmStockUsed.txtSPc_SOitem.Value 	= tmpSPcmpltP.SOitem
				ThisFormSet.frmStockUsed.txtSPc_WOD.Value 		= tmpSPcmpltP.WO_Detail
				
				ThisFormSet.frmStockUsed.txtSPc_Desc.Value		= ShowSQLtxt(tmpSPcmpltP.DescriptCL,'DescriptCL',100)
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refreshid_detail_processp
		PARAMETERS pID_Detail_ProcessP
		*ThisFormSet.RefreshID_Detail_ProcessP(nID_Detail_ProcessP)
		*StartP
		
		PRIVATE nID_Detail_ProcessP
		nID_Detail_ProcessP = PrepareSQLnum(pID_Detail_ProcessP,'ID_Detail_Process',-3)
		
		*ThisFormSet.frmStockUsed.Visible = .F.
		ThisFormSet.frmStockUsed.txtSPSP_TBL.Value 			= ""
		ThisFormSet.frmStockUsed.txtSPSP_Heat.Value			= ""
		ThisformSet.frmStockUsed.txtSPSP_StockEdit.Value		= CTOD("")
		ThisFormSet.frmStockUsed.txtSPSP_StockLst_PC.Value	= 0
		ThisFormSet.frmStockUsed.txtSPSP_StockLst_Qty.Value	= 0
		ThisFormSet.frmStockUsed.txtSPSP_ID_Detail.Value		= 0
		ThisFormSet.frmStockUsed.txtSPSP_ID_Detail_Process.Value = 0
		
		ThisFormSet.frmStockUsed.txtSPSP_Pounds.Value = 0
		ThisFormSet.frmStockUsed.txtSPSP_PQTY.Value = 0
		ThisFormSet.frmStockUsed.txtSPSP_PPU.Value = 0
		ThisFormSet.frmStockUsed.txtSPSP_POrdered_QTY.Value = 0
		
		ThisFormSet.frmStockUsed.txtSPSP_SOitem.Value	= ''
		ThisFormSet.frmStockUsed.txtSPSP_Desc.Value	= ''
		
		IF nID_Detail_ProcessP = 0
			
			
		ELSE
			IF NOT USED('tmpSPStartP')
				IF ThisFormSet.nWO > 0
					ThisFormSet.Load_tmpSPStartP(ThisFormSet.nWO)
				ENDIF
			ENDIF
		
			IF NOT USED('tmpSPStartP')
				WAIT WINDOW "TABLE 'tmpSPStartP' is not open, Any key..."
			ELSE	
				SELECT tmpSPStartP
				IF nID_Detail_ProcessP > 0
					LOCATE FOR ID_Detail_Process = nID_Detail_ProcessP
				ENDIF
				
				IF FOUND()
					*ThisFormSet.frmStockUsed.Visible = .T.
					
					ThisFormSet.frmStockUsed.txtSPSP_TBL.Value 			= ShowSQLtxt(tmpSPStartP.TBL,'TBL',1)
					ThisFormSet.frmStockUsed.txtSPSP_Heat.Value			= ShowSQLtxt(tmpSPStartP.Heat,'Heat',50)
					ThisFormSet.frmStockUsed.txtSPSP_StockEdit.Value	= ShowSQLdate(tmpSPStartP.StockEdit,'StockEdit') &&Last Time Stock was checked.
					*txtSPSP_DateMod
					
					ThisFormSet.frmStockUsed.txtSPSP_StockLst_PC.Value	= PrepareSQLnum(tmpSPStartP.StockLst_PC,'StockLst_PC',-3)
					ThisFormSet.frmStockUsed.txtSPSP_StockLst_Qty.Value	= PrepareSQLnum(tmpSPStartP.StockLst_Qty,'StockLst_Qty',-5)
					ThisFormSet.frmStockUsed.txtSPSP_ID_Detail.Value		= PrepareSQLnum(tmpSPStartP.StockLst_ID_Detail,'StockLst_ID_Detail',-3)
					ThisFormSet.frmStockUsed.txtSPSP_ID_Detail_Process.Value = PrepareSQLnum(tmpSPStartP.ID_Detail_Process,'ID_Detail_Process',-3)
					
					ThisFormSet.frmStockUsed.txtSPSP_Pounds.Value 		= PrepareSQLnum(tmpSPStartP.Pounds,'Pounds',9,1)
					ThisFormSet.frmStockUsed.txtSPSP_PQTY.Value 			= PrepareSQLnum(tmpSPStartP.Qty,'P_QTY',-5)
					ThisFormSet.frmStockUsed.txtSPSP_PPU.Value 			= PrepareSQLnum(tmpSPStartP.PU,'PU',-1)
					ThisFormSet.frmStockUsed.txtSPSP_POrdered_QTY.Value 	= PrepareSQLnum(tmpSPStartP.Ordered_QTY,'Ordered_QTY',-5)
					
					ThisFormSet.frmStockUsed.txtSPSP_SOitem.Value	= ShowSQLtxt(tmpSPStartP.SOitem,'SOitem',10)
					ThisFormSet.frmStockUsed.txtSPSP_Desc.Value		= ShowSQLtxt(tmpSPStartP.DescriptCL,'DescriptCL',100)
					
				ENDIF		
			ENDIF
		ENDIF
	ENDPROC

