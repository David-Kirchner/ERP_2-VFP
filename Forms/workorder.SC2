				ThisFormSet.frmChooseWO.txtFSz3.Visible 	= tmpFormCaptions.use3rdDim
				ThisFormSet.frmChooseWO.txtFSz3.Enabled 	= tmpFormCaptions.Sz3Enable
				ThisFormSet.frmChooseWO.lblFSz4.Caption		= RTRIM(tmpFormCaptions.txt4)
				ThisFormSet.frmChooseWO.lblFSz4.Visible 	= tmpFormCaptions.lblSz4Vis
				
				USE IN tmpFormCaptions
			ELSE
