						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'Draw_Log')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF
				
					IF USED('Draw_Log')
						IF RECCOUNT('Draw_Log') > 0
							
							SELECT Draw_Log
							LOCATE FOR Lot = nFinishLot 
							
							PRIVATE nCurgRec
							nCurgRec = RECNO('Draw_Log')
							IF nCurgRec  <= RECCOUNT('Draw_Log')
								IF pWhat = "PREVIEW"
									REPORT FORM reports\Draw_Log RECORD (nCurgRec) PREVIEW
								ELSE
									REPORT FORM reports\Draw_Log RECORD (nCurgRec) TO PRINT PROMPT NOCONSOLE
								ENDIF	
							ELSE
								MESSAGEBOX("Did not find "+cFinishMlog+" LOT "+ALLTRIM(STR(nFinishLot)),0+16,"Cannot Print LOT")
							ENDIF
						
						ENDIF	
						USE IN GFMlog
					ENDIF
				
