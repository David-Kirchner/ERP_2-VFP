		ThisFormSet.frmStockWO.AlwaysOnTop = .T.
		ThisFormSet.frmStockWO.Visible = .T.
		ThisFormSet.frmStockWO.grdStockWO.RecordSource = 'tmpStockWO'
		
		ThisFormSet.RefreshStockWO()
		ThisFormSet.frmStockWO.lblWO_D.Caption = ALLTRIM(STR(PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)))
