	PROCEDURE frmWorkOrder.cmdCalcS.Click
		PRIVATE nPieces,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3, nWeight, nWO, nQTY
		nPieces		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCL.Value,'CL',1)
		nThck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtThck.Value,'Thck',14,4)
		nSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz2.Value,'Sz2',13,3)
		nSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz3.Value,'Sz3',13,3)
		nWeight		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWeight.Value,'Weight',11,1)
		nWO = ThisFormSet.nWO
		nQTY = nWeight
		
		IF EMPTY(cAlloy) OR EMPTY(cForm) OR nThck = 0 OR nWeight = 0
			MESSAGEBOX("Not Enough information"+CHR(13)+"EMPTY(cAlloy) OR EMPTY(cForm) OR nThck = 0 OR nWeight = 0",48,"Cannot Calc.")
			RETURN .F.
		ENDIF
		
		******************************************
		
		*Check for Marked Stock! return length
		PRIVATE nSz2STK 
		nSz2STK = 0
		
		IF USED("tmpStockLen")	
			USE IN tmpStockLen
		ENDIF
		SELECT 0
		
		
		*Check for Stock lengths
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT PC, Dim2, Dim3, QTY "
		cSQL = cSQL + " FROM dbo.StockLst_Process P "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " WHERE P.WO = "+STR(nWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLen')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStockLen')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLen")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLen")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockLen')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpStockLen')
			IF RECCOUNT('tmpStockLen') > 0
				nSz2STK = tmpStockLen.Dim2
				*Is the QTY correct
				nQTY = PrepareSQLnum(tmpStockLen.QTY,'QTY',11,1)  &&Change to Numeric
				
				IF (nQTY+10) * 1.1 > nWeight AND (nWeight+10) * 1.1 > nQTY
					*withing 10%
				ELSE
					
				ENDIF
			ENDIF
			USE IN tmpStockLen
		ENDIF
		
		
		******************************************
		IF nSz2STK = 0
		
			IF USED("tmpStockLen")	
				USE IN tmpStockLen
			ENDIF
			SELECT 0
		
		
			*Check for Stock lengths
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT TOP 1 D.Dim2, D.ID_Detail, D.PC "
			cSQL = cSQL + " FROM dbo.StockLst_Detail D "
			cSQL = cSQL + " INNER JOIN dbo.Stocklst_Master M ON D.ID = M.ID "
			cSQL = cSQL + " WHERE M.Alloy = '"+cAlloy+"'"
			cSQL = cSQL + " AND M.Form = '"+cForm+"'"
			cSQL = cSQL + " AND dbo.f_CC_CLsort(M.CC,M.CL) =  dbo.f_CC_CLsort('"+cCC+"','"+cCL+"')"
			cSQL = cSQL + " AND M.Size = "+STR(nThck,7,3)
			cSQL = cSQL + " AND FLOOR(D.S_QTY) >= "+STR(nQTY,10,0)
			cSQL = cSQL + " AND ISNULL(M.POStatus,'D') <>'D'"
			cSQL = cSQL + " ORDER BY D.S_QTY "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLen')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStockLen')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLen")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLen")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockLen')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpStockLen')
				IF RECCOUNT('tmpStockLen') > 0
					nSz2STK = tmpStockLen.Dim2
				ENDIF
				USE IN tmpStockLen
			ENDIF
		ENDIF
		
		******************************************
		IF nSz2STK > 0
			*Run with the stock found length
			*have nThck and nWeight
			*how many pcs does it take to cover the weight
			*find the weight of one PC    nPieces = 1
			nSz3	= 0
			nForceBracket = .F.
			PRIVATE nPC_Pounds 
			nPC_Pounds = 0
			
			*****************************
		
			IF USED('tmpPriceTbl')
				USE IN tmpPriceTbl
			ENDIF
			SELECT 0
		
			PRIVATE cSQL
			cSQL = "EXEC dbo.p_GetFullQuoteCL "
			cSQL = cSQL + "1"      &&STR(nPieces)
			cSQL = cSQL + ",'"+cAlloy+"'"
			cSQL = cSQL + ",'"+cForm+"'"
			cSQL = cSQL + ",'"+cCC+"'"
			cSQL = cSQL + ",'"+cCL+"'"
			cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2STK,'Sz2',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
			cSQL = cSQL + ",''" &&CustID
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				
				PRIVATE cMess
				cMess = "Could not get the Price!"+CHR(13)
				*IF nPieces > 10000
				*	cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
				*ENDIF
				IF nThck > 16
					cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
				ENDIF
				IF nSz2	> 120
					cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2STK,'Sz2',12,3),9,3)+"."+CHR(13)
				ENDIF
				IF nSz3	 > 300
					cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
				ENDIF
				MESSAGEBOX(cMess,16,"Edit your input numbers")
				
			ENDIF
		
			IF USED('tmpPriceTbl')
				IF RECCOUNT('tmpPriceTbl') > 0
					nPC_Pounds = tmpPriceTbl.Pounds
				ENDIF
				USE IN tmpPriceTbl
			ENDIF
			
			IF nPC_Pounds > 0
				IF nPC_Pounds > nWeight
					*Stick with the new Stock
					nWeight = nPC_Pounds 
					nPieces = 1
					nSz2 = nSz2STK 
				ELSE
					nPieces = ABS(nWeight/nPC_Pounds)+1
					nWeight = nPieces * nPC_Pounds 
					nSz2 = nSz2STK
				ENDIF
			ENDIF
			
			************************	
		ENDIF
			************************	
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdConsumeStock.Click
		PRIVATE nWO, cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem
		nWO  		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		*nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSPS_TBL.Value,'TBL',1)
		nID_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSPS_ID_Detail.Value,'ID_Detail',-3)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSPS_ID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		cSOitem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		
		IF nID_Detail = 0
			*Look for unSaved record.
			
			MESSAGEBOX("You must first select the 'INV'!",48,"Select INV first.")
			RETURN
		ENDIF
		
		PRIVATE lComplete
		lComplete = PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkCmplt.Value,'Complete')
		IF lComplete
			MESSAGEBOX("Work Order is already marked as complete!"+CHR(13)+"Press OK to continue",48,"Notice")
		ENDIF
		
		PRIVATE nWO_Detail, nRID, cHeat
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nRID		= PrepareSQLnum(ThisForm.txtfReceivingID.Value,'ReceivingID',-3)
		cHeat		= getHeat_from_RID(nRID,ThisFormSet.nConnHandle)
		
		ThisFormSet.Grab_foundStk(.T.)
		*CALLS: ThisFormSet.Make_Process_Grab(nID_Detail_Process,cTBL)
		
		*ThisFormSet.ID_Detail_process = nID_Detail_Process
		
		*ThisForm.AlwaysOnTop = .F.
		*ThisForm.AlwaysOnBottom = .T.
		*ThisFormSet.Visible = .F.
		
		*                                     pTBL, pID_Detail, pID_Detail_Process, pSOitem, pPOitem, pWO, pWO_Detail, pRID, pHeat
		DO FORM Forms\Modify_Stock4Order WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO, nWO_Detail, nRID, cHeat
		*DO FORM Forms\StockLst_SQL_Modal WITH "SEL_WO",cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''     ,nQTY,.F.,cPOitem TO pID_Detail
		*DO FORM Forms\Modify_Stocklst_Detail WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO, nWO_Detail, nRID, cHeat
		
		*                                        pTBL, pID_Detail, pID_Detail_Process, pSOitem, pPOitem, pWO
		*ThisForm.AlwaysOnBottom = .F.
		*ThisFormSet.Visible = .T.
		
		ThisFormSet.frmStockUsed.Visible = .F.
		
		ThisFormSet.Show_frmWorkOrder_MarkedStock(nWO)
			*CALLS:	ThisFormSet.Load_tmpSPStart(tmpWO.WO) &&
			* ThisFormSet.RefreshID_Detail_Process( 0 ) 
		ThisFormSet.Load_tmpSPStartP(nWO)	&&Start Process
			
			
		PRIVATE nMess 
		nMess = MESSAGEBOX("Production - Work Order screen"+CHR(13)+CHR(13)+"Do you want to "+CHR(13)+"mark this WO as Complete?"+CHR(13)+CHR(13)+"If you are done gathered the starting stock, then mark WO side as complete. (Y)",4+32,"Complete?")
		
		IF nMess = 6
			ThisFormSet.frmWorkOrder.chkCmplt.Value = 1
			
			ThisFormSet.frmWorkOrder.chkStkConsumed.Value = 1
					
			*ThisFormSet.frmWorkOrder.cmdSaveWO.Click()
			ThisFormSet.SaveAddWO()
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdCreateLot.Click
		PRIVATE cMach, cFollowMach, nLot, cAlloy, nfThick, cMach1 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'Mach',20)
		cFollowMach = PrepareSQLtxt(ThisForm.cmbFollowM.Value,'FollowMach',20)
		nLot	= PrepareSQLnum(ThisForm.txtFinishLot.Value,'Lot',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtfAlloy.Value,'Alloy',12)
		nfThick = PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',10,4)
		cMach1	= PrepareSQLtxt(ThisForm.cmbFollowM.Value,'Mach',20)
		
		IF EMPTY(cMach)
			IF NOT EMPTY(cFollowMach)
				cMach = cFollowMach 
			ENDIF
		ENDIF
		
		IF EMPTY(cMach)
			cMach = cMach1
			ThisForm.cmbFinishM.Value = cMach
		ENDIF
		
		IF EMPTY(cMach)
			MESSAGEBOX("You must Declare the Machine before inserting a new LOT",16,"Unknown machine")
			RETURN .F.
		ENDIF
		
		*--SELECT ANS,UN FROM dbo.AppSetup WITH(NOLOCK) WHERE PRP = 'Production Machine'
		******************************
		DO CASE
		CASE cMach = "Draw Bench"
		CASE cMach = "GFM"
		CASE cMach = "Heat Treat"
		*CASE cMach = "Lake Erie"
		CASE cMach = "Open Die"
		CASE cMach = "Rolling"
		CASE cMach = "Swage"
		CASE cMach = "Wire Draw"
		OTHERWISE
			TrackError("Mach '"+cMach+"' is not programmed","No Mach",PROGRAM(),LINENO(1))
			RETURN .f.
		ENDCASE
			
			
		IF nfThick=0 OR EMPTY(cAlloy)
			MESSAGEBOX("Please fill in more of the 'Finish' WO_Detail so a good insert log can be made.",16,"Unknown Alloy or Thickness")
			RETURN .F.
		ENDIF
		IF nLot > 0
			IF MESSAGEBOX("Lot is set to :"+ALLTRIM(STR(nLot))+CHR(13)+"Do you still want to create a NEW Record / lot?",4+32,"Replace LOT number?") != 6
				RETURN .F.
			ENDIF
		ENDIF
		
		********************************
		PRIVATE cMess, nMess
		*nMess = MESSAGEBOX("This 'Create Lot' procedure requires the current WO Detail "+CHR(13)+"to be save to disk."+CHR(13)+"the Save WO Detail routine will be run for you."+CHR(13)+CHR(13)+"Is it OK to Save current DETAIL data?"+CHR(13)+"Has ALL the detail been entered that is needed"+CHR(13)+"to create a Lot?"+CHR(13)+CHR(13)+"Answer No to Abort this Create.",4+32,"OK to Continue?")
		*IF nMess <> 6
		*	RETURN .F.
		*ELSE
			IF NOT ThisFormSet.SaveAddDetail(.F.)
				MESSAGEBOX("This 'Create Lot' procedure requires the current WO Detail "+CHR(13)+"to be save to disk."+CHR(13)+"the Save WO Detail routine will be run for you."+CHR(13)+CHR(13)+"Is it OK to Save current DETAIL data?"+CHR(13)+"Has ALL the detail been entered that is needed"+CHR(13)+"to create a Lot",4+32,"Save failed")
				RETURN .F.
			ENDIF
		*ENDIF
		
		********************************
		PRIVATE nWO,nWO_Detail,nPieces,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,nWeight
		PRIVATE nID_Detail,nID_Detail_Process,cDescript,cSalesRep,cNotes,lRE,cSOitem,cPOitem
		
		
		***********
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWO_Detail = 0
			*Must Save First
			IF MESSAGEBOX("There is no WO_Detail"+CHR(13)+"Is it OK to save current WO/WO_detail data (Y)?"+CHR(13)+"No data to send to new Log!",4+32,"Save WO_Detail now?")=6
				ThisFormSet.SaveAddWO()   &&Saves booth WO and WO_Detail
			ENDIF
		ENDIF
		***********
		
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWO_Detail = 0
			RETURN .F.
		ENDIF
		nPieces		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCL.Value,'CL',1)
		nThck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtThck.Value,'Thck',14,4)
		nSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz2.Value,'Sz2',13,3)
		nSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz3.Value,'Sz3',13,3)
		*nID_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtID_Detail.Value,'ID_Detail',-3)
		*nID_Detail_Process = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		nWeight		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWeight.Value,'Weight',11,1)
		cDescript	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtDescript.Value,'Descript',100)
		cSalesRep	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSalesRep.Value,'SalesRep',20)
		cNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtWO_Notes.Value,'Notes',-1)
		
		*lIntP		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')
		lRE			= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkRE.Value,'RE')
		cSOitem		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		cPOitem		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		
		*************
		PRIVATE nFPieces,cFAlloy,cHeat,cFForm,cFCC,cFCL,nFThck,nFSz2,nFSz3,nFWeight
		nFPieces	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		
		IF StockLst_Process_Count_WO( nWO, "S", ThisFormSet.nConnHandle, "SELECTED") > 0
			cHeat = ThisFormSet.getHeat_WO(nWO)
		ELSE
			cHeat	= ''
		ENDIF
		cFAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
		cFForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFForm.Value,'Form',2)
		cFCC		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCC.Value,'CC',1)
		cFCL		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCL.Value,'CL',1)
		nFthck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz2.Value,'Sz2',13,3)
		nFSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz3.Value,'Sz3',13,3)
		nFWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFWeight.Value,'Weight',11,1)
		PRIVATE cFDescript, cFNotes, cfCondLevel, cFollowM, nFollowLot, cFinishM, nFinishLot
		cFDescript	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFdescript.Value,'FDescript',50)
		cFNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtfNotes.Value,'FNotes',-1)
		cfCondLevel = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		cFollowM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFollowM.Value,'FollowM',20)
		nFollowLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFollowLot.Value,'FollowLot',-3)
		cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		PRIVATE cFSOitem, cFPOitem
		cFSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		cFPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFPOitem.Value,'POitem',12)
		
		PRIVATE nfReceivingID, lfCmplt, cFNotes, nStock_Projected_ID, lfCncld, lStkListed
		nfReceivingID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfReceivingID.Value,'RecevingID',-3)
		*lIntP		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')  
		lfCmplt		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCmplt.Value,'fCmplt')
		cFNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtfNotes.Value,'Notes',-1)
		nStock_Projected_ID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value,'Stock_Projected_ID',-3)
		lfCncld		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCncld.Value,'fCncld')
		lStkListed	= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkStkListed.Value,'StkListed')
		
		PRIVATE cFSpec, cfCondLevel, nStartSize, nCW, nRoughSize, nOverSize 
		cFSpec		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSpec.Value,'fSpec',50)
		cfCondLevel	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		nStartSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		
		IF nRoughSize = 0 AND nFthck >  0
			nRoughSize = nFthck
			ThisFormSet.frmWorkOrder.txtRoughSize.Value = nRoughSize
		ENDIF
			
		PRIVATE nSalesNum, nItemSO, cSOitem
		nSalesNum = VAL( PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfSOitem.Value,'SOitem',10))
		cSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfSOitem.Value,'SOitem',10)
		nItemSO = VAL( RIGHT(cSOitem,2))
		
		*****************
		*Look For Project restocking Program data
		
		PRIVATE lFoundProj, cProjCompany, cProjSpec_CC,cProjSpec_CL,cProj_ConditionLevel_Spec
		lFoundProj		= .F.
		cProjCompany	= ''
		cProjSpec_CC	= cFCC
		cProjSpec_CL	= cFCL
		cProj_ConditionLevel_Spec = ''
		PRIVATE nMinUTS,nMinYLD,nMinEl,nMinRA,cCmax 
		nMinUTS	= 0
		nMinYLD	= 0
		nMinEl	= 0
		nMinRA	= 0
		cCmax 	= ''
		
		IF nStock_Projected_ID > 0
			IF USED('tmpProjCompany')	
				USE IN tmpProjCompany
			ENDIF
		
			cSQL = "SELECT SP.Company, SP.Spec_CC, SP.Spec_CL, CL.Spec "
			cSQL = cSQL + " ,CL.MinUTS,CL.MinYLD,CL.MinEl,CL.MinRA,CL.Cmax "
			cSQL = cSQL + " FROM dbo.Stock_Projected SP "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.ConditionLevel CL ON SP.Spec_CC = CL.CC AND SP.Spec_CL = CL.CL "
			cSQL = cSQL + " WHERE SP.ID = "+STR(nStock_Projected_ID)
					
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProjCompany')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProjCompany')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjCompany")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProjCompany")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORMSET.nConnHandle, nSQLEXEC, 'tmpProjCompany')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				RETURN 
			ELSE
				IF USED('tmpProjCompany')
					IF RECCOUNT('tmpProjCompany') > 0
						lFoundProj = .T.
						
						cProjCompany	= ShowSQLtxt(tmpProjCompany.Company,'Company',30)
						cProjSpec_CC 	= ShowSQLtxt(tmpProjCompany.Spec_CC,'CC',1)
						cProjSpec_CL 	= ShowSQLtxt(tmpProjCompany.Spec_CL,'CC',1)
						cProj_ConditionLevel_Spec = ShowSQLtxt(tmpProjCompany.Spec,'Spec',50)
						
						nMinUTS = PrepareSQLnum(tmpProjCompany.MinUTS,'MinUTS',-3)
						nMinYLD = PrepareSQLnum(tmpProjCompany.MinYld,'MinYld',-3)
						nMinEl	= PrepareSQLnum(tmpProjCompany.MinEL,'MinEL',-3)
						nMinRA	= PrepareSQLnum(tmpProjCompany.MinRA,'MinRA',-3)
						cCmax	= PrepareSQLtxt(tmpProjCompany.Cmax,'Cmax',3)
						
						cfCondLevel = cfCondLevel + CHR(13)+"Proj Company: "+ALLTRIM(cProjCompany)+", ProjID: "+ALLTRIM(STR(nStock_Projected_ID))
						cfCondLevel = cfCondLevel + CHR(13)+"Min UTS:"+ALLTRIM(STR(nMinUTS,10,0))
						cfCondLevel = cfCondLevel + ",  Min YLD:"+ALLTRIM(STR(nMinYLD,10,0))
						cfCondLevel = cfCondLevel + ",  Min EL:"+ALLTRIM(STR(nMinEL,2,0))
						cfCondLevel = cfCondLevel + ",  Min RA:"+ALLTRIM(STR(nMinRA,2,0))
						IF NOT EMPTY(cCmax)
							cfCondLevel = cfCondLevel + ",  RC Max:"+ALLTRIM(cCMax)
						ENDIF
		
					ENDIF
					USE IN tmpProjCompany
				ENDIF
			ENDIF
		ENDIF
		
		*******************
		IF NOT lFoundProj
			*Use CC and CL to get Strength
		*!*		cProj_ConditionLevel_Spec = ShowSQLtxt(tmpProjCompany.Spec,'Spec',50)
		*!*		
		*!*		nMinUTS = PrepareSQLnum(tmpProjCompany.MinUTS,'MinUTS',-3)
		*!*		nMinYLD = PrepareSQLnum(tmpProjCompany.MinYld,'MinYld',-3)
		*!*		nMinEl	= PrepareSQLnum(tmpProjCompany.MinEL,'MinEL',-3)
		*!*		nMinRA	= PrepareSQLnum(tmpProjCompany.MinRA,'MinRA',-3)
		*!*		cCmax	= PrepareSQLtxt(tmpProjCompany.Cmax,'Cmax',3)
		*!*		
		*!*		cfCondLevel = cfCondLevel + CHR(13)+"Proj Company: "+ALLTRIM(cProjCompany)+", ProjID: "+ALLTRIM(STR(nStock_Projected_ID))
		*!*		cfCondLevel = cfCondLevel + CHR(13)+"Min UTS:"+ALLTRIM(STR(nMinUTS,10,0))
		*!*		cfCondLevel = cfCondLevel + ",  Min YLD:"+ALLTRIM(STR(nMinYLD,10,0))
		*!*		cfCondLevel = cfCondLevel + ",  Min EL:"+ALLTRIM(STR(nMinEL,2,0))
		*!*		cfCondLevel = cfCondLevel + ",  Min RA:"+ALLTRIM(STR(nMinRA,2,0))
		*!*		IF NOT EMPTY(cCmax)
		*!*			cfCondLevel = cfCondLevel + ",  RC Max:"+ALLTRIM(cCMax)
		*!*		ENDIF
		
		ENDIF
		
		*******************
		IF NOT EMPTY(cProj_ConditionLevel_Spec)
			cFDescript = PrepareSQLtxt(  cProj_ConditionLevel_Spec  ,'Spec',50,.F.,.F.)
		ENDIF
		
		
		***********************************************
		*Check Selected Start Stock for Heat
		*************************************************
		
		IF nWO > 0
			IF USED('tmpSelectSTK')	
				USE IN tmpSelectSTK
			ENDIF
		
			cSQL =        "SELECT M.Heat "
			cSQL = cSQL + " FROM dbo.StockLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.Stocklst_Master M ON M.ID = D.ID "
			cSQL = cSQL + " WHERE P.WO = "+ALLTRIM(STR(nWO))
			cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT M.Heat "
			cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
			cSQL = cSQL + " WHERE P.WO = "+ALLTRIM(STR(nWO))
			cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT M.Heat "
			cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
			cSQL = cSQL + " WHERE P.WO = "+ALLTRIM(STR(nWO))
		*	cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
					
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpSelectSTK')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpSelectSTK')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSelectSTK")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSelectSTK")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORMSET.nConnHandle, nSQLEXEC, 'tmpSelectSTK')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				
			ELSE
				IF USED('tmpSelectSTK')
					IF RECCOUNT('tmpSelectSTK') > 0
						cHeat = tmpSelectSTK.Heat
					ENDIF
					USE IN tmpSelectSTK
				ENDIF
			ENDIF
		ENDIF
		
		*********************
		* nFollowLot
		PRIVATE cFollowNotes
		cFollowNotes = ""
		IF nFollowLot > 0 AND LEN(cFollowM) > 0
			*get Lot Notes from a Follow Lot!
			
			IF USED('tmpLotNotes')	
				USE IN tmpLotNotes
			ENDIF
			
			DO CASE
			CASE cMach = "Draw Bench"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.Draw_log "
			CASE cMach = "GFM"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.GFMlog "
			CASE cMach = "Heat Treat"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.HT_log "
				
			
			CASE cMach = "Open Die"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.LakeErie_log "
			CASE cMach = "Rolling"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.Roll_log "
			CASE cMach = "Swage"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.Swage_log "
			CASE cMach = "Wire Draw"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.Wire_log "
			OTHERWISE
				TrackError("Mach '"+cMach+"' is not programmed"+CHR(13)+cMach ,"No Mach",PROGRAM(),LINENO(1))
				RETURN .f.
			ENDCASE
			cSQL = cSQL + " WHERE LOT = "+ALLTRIM(STR(nFollowLot))
					
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpLotNotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpLotNotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpLotNotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpLotNotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORMSET.nConnHandle, nSQLEXEC, 'tmpLotNotes')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				
			ELSE
				IF USED('tmpLotNotes')
					IF RECCOUNT('tmpLotNotes') > 0
						cFollowNotes = "Follow "+ShowSQLtxt(tmpLotNotes.Notes,'Notes',-1)+" "+ALLTRIM(STR(nFollowLot))+": "+ tmpLotNotes.Notes
					ENDIF
					USE IN tmpLotNotes
				ENDIF
			ENDIF
			
			
		ENDIF
		*********************
		*Insert WO_Detail as a new LOG
		*cInit = GetMachine_Init( cMach, nConn )
		*cMach = GetMachine_Caption( cInit, nConn )
		
		
		  
		IF USED('tmpCountLot')	
			USE IN tmpCountLot
		ENDIF
		
		cSQL = "SELECT MAX(Lot) AS MaxLot "
		DO CASE
		CASE cMach = "Draw Bench"
			cSQL = cSQL + " FROM dbo.Draw_Log "
		CASE cMach = "GFM" 
			cSQL = cSQL + " FROM dbo.GFMLog "
		CASE cMach = "Heat Treat"
			cSQL = cSQL + " FROM dbo.HT_log "
		
		CASE cMach = "Open Die"
			cSQL = cSQL + " FROM dbo.LakeErie_log "
		CASE cMach = "Rolling"
			cSQL = cSQL + " FROM dbo.Roll_log "
		CASE cMach = "Swage"
			cSQL = cSQL + " FROM dbo.Swage_Log "
		CASE cMach = "Wire Draw"
			cSQL = cSQL + " FROM dbo.Wire_log "
		OTHERWISE
			MESSAGEBOX("Please Choose the Machine type first '"+cMach+"'.",48,"Cannot Select")
			RETURN .F.
		ENDCASE
		
				
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpCountLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpCountLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountLot")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, THISFORMSET.nConnHandle, nSQLEXEC, 'tmpCountLot')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			RETURN 
		ELSE
			IF USED('tmpCountLot')
				IF tmpCountLot.MaxLot > 0
					nLot = tmpCountLot.MaxLot+1
					ThisFormSet.frmWorkOrder.txtFinishLot.Value = nLot
				ENDIF
				USE IN tmpCountLot 
			ENDIF
		ENDIF
		
		*********
		*get Notes
		PRIVATE cLotNotes
		cLotNotes = ""
		IF LEN(cFollowNotes) > 0
			cLotNotes = cFollowNotes +CHR(13) +CHR(13)
		ENDIF
		IF LEN(cfCondLevel) > 0
			cLotNotes = cLotNotes+ cfCondLevel +CHR(13)
		ENDIF
		cLotNotes = cLotNotes +"Starting Stock size is "+Remove0(nThck,9,3)+[" ]
		IF cAlloy = "HPA N60"
			IF cProjSpec_CC = "S" OR cProjSpec_CC ="L"  OR cProjSpec_CC = "R"
				cLotNotes= cLotNotes+ " ESR "
			ENDIF
		ENDIF
		*	IF cAlloy = "HPA N60" OR cAlloy = "HPA N50"
		*		cLotNotes= cLotNotes +CHR(13)+"Anneal 1925-1950F 1/2 Hr WQ or Rapid Air Cool."
		*	ENDIF
		IF nStartSize > 0
			cLotNotes= cLotNotes +CHR(13)+"Start Size is "+Remove0(nStartSize,9,3)+[" ]
		ENDIF
		IF cProjSpec_CC = "S" OR cProjSpec_CC = "L" OR cProjSpec_CC = "F"
			cLotNotes= cLotNotes +CHR(13)+"Work Cold to "+Remove0(nRoughSize,9,3)+[" ]
			
			IF UPPER(cMach) = "GFM" 
				IF VAL(cProjSpec_CL) > 2
					cLotNotes= cLotNotes +CHR(13)+"Do NOT make bars smoke."
					cLotNotes= cLotNotes +CHR(13)+"Use ICE and keep bars FULLY submerged."
					cLotNotes= cLotNotes +CHR(13)+"When using ice, make sure bars are COLD prior ro starting next pass."
				ENDIF
			ENDIF
			cLotNotes= cLotNotes +IIF( NOT EMPTY(cFNotes), CHR(13)+cFNotes, '')
		ELSE
			IF nRoughSize > 0
				cLotNotes= cLotNotes +CHR(13)+"work to "+Remove0(nRoughSize,9,3)+[" ]
			ENDIF
		ENDIF
		
		***********************
		*Add WO_Detail Notes to SHOP workers.
		IF NOT EMPTY(cFNotes)
			cLotNotes= cLotNotes +CHR(13)+CHR(13)+cFNotes
		ENDIF
		
		***********************
		*Testing info
		DO CASE
		CASE cProjSpec_CC = "S"
			IF nFthck <= 1
				cLotNotes= cLotNotes +CHR(13)+CHR(13)+[Cut 1PC 6.5" for SpaceX Mechanical and Hardness Testing. (For Center, Center and Hardness Profile)]+ CHR(13)
			ELSE
				cLotNotes= cLotNotes +CHR(13)+CHR(13)+[Cut 1PC 12.5" for SpaceX Mechanical and Hardness Testing. (For Outer with Outer, Center, Center and Hardness Profile)]+ CHR(13)
			ENDIF
		CASE cProjSpec_CC = "L"
			cLotNotes= cLotNotes +CHR(13)+CHR(13)+[Cut 1PC 4" and 2PC 3" for LMA Mechanical and Hardness Testing. (For Mid Radius of 3 different bars and Grain)]+ CHR(13)
		OTHERWISE
			cLotNotes= cLotNotes +CHR(13)+CHR(13)+[Cut 1PC 4" for Mechanical and Hardness Testing.  (For Hardness Profile) ]+ CHR(13)
		ENDCASE
		
		*********
		*RecordTest('Record Test Data.', PROGRAM(), LINENO(1), PrepareSQLtxt(cLotNotes,'Notes',-1))
		
		DO CASE
		CASE UPPER(cMach) = "DRAW BENCH" 
			cSQL = "INSERT INTO dbo.Draw_log "
		CASE UPPER(cMach) = "GFM" 
			cSQL = "INSERT INTO dbo.GFMlog "
		CASE UPPER(cMach) = "HEAT TREAT" 
			cSQL =  "INSERT INTO dbo.HT_Log "
		
		CASE UPPER(cMach) = "OPEN DIE" 
			cSQL =  "INSERT INTO dbo.LakeErie_Log "
		CASE UPPER(cMach) = "ROLLING"
			cSQL =  "INSERT INTO dbo.Roll_Log "
		CASE UPPER(cMach) = "SWAGE"
			cSQL =  "INSERT INTO dbo.Swage_Log "
		CASE UPPER(cMach) = "WIRE DRAW" 
			cSQL = "INSERT INTO dbo.WIRE_Log "
		OTHERWISE
			cSQL = ''
		ENDCASE
		
		
		cSQL = cSQL + "(AlloyName, [Date], Heat, Lot"
		cSQL = cSQL + ",Spiece"
		IF UPPER(cMach) != "HEAT TREAT" 
			cSQL = cSQL + ",Fpiece"
		ENDIF
		cSQL = cSQL + ",Ssize"
		DO CASE			&&RoughSize
		CASE UPPER(cMach) = "DRAW BENCH" 
			cSQL = cSQL + ",DRAWsize"
		CASE UPPER(cMach) = "GFM" 
			cSQL = cSQL + ",GFMsize"
		CASE UPPER(cMach) = "HEAT TREAT" 
			*cSQL = cSQL + ",sSize"
		CASE UPPER(cMach) = "OPEN DIE" 
			*cSQL = cSQL + ",fsize"
		CASE UPPER(cMach) = "ROLLING"
			cSQL = cSQL + ",RollSize"
		CASE UPPER(cMach) = "SWAGE"
			cSQL = cSQL + ",SwageSize"
		CASE UPPER(cMach) = "WIRE" 
			cSQL = cSQL + ",DrawSize"
		ENDCASE
		IF UPPER(cMach) = "GFM" OR UPPER(cMach) = "OPEN DIE" OR UPPER(cMach) = "ROLLING" OR UPPER(cMach) = "SWAGE" 
			cSQL = cSQL + ",Flength"
			cSQL = cSQL + ",[Fsize]"
		ENDIF
		cSQL = cSQL + ",Sweight"
		cSQL = cSQL + ",Condition"
		IF UPPER(cMach) != "HEAT TREAT" 
			cSQL = cSQL + ",ColdWork"
		ENDIF
		cSQL = cSQL + ",Spec"
		cSQL = cSQL + ",SalesNum,ItemSO,SOitem"
		cSQL = cSQL + ",Notes"
		cSQL = cSQL + ",WO,WO_Detail,ProjID "
		
		cSQL = cSQL + ") VALUES "
		
		cSQL = cSQL + "('"+cAlloy+"','"+DTOC(DATE())+"','"+cHeat+"',"+STR(nLot,10,0)
		cSQL = cSQL + ","+STR(nPieces,5,1)		&&Spiece
		IF UPPER(cMach) != "HEAT TREAT" 		&&Fpiece
			cSQL = cSQL + ","+STR(nFpieces,5,0)
		ENDIF
		cSQL = cSQL + ","+STR(nThck,9,3) &&Ssize
		
		DO CASE							&&RoughSize
		CASE UPPER(cMach) = "DRAW BENCH" 
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "GFM" 
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "HEAT TREAT" 
			*cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "OPEN DIE" 
			*cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "ROLLING"
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "SWAGE"
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "WIRE" 
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		ENDCASE
		IF UPPER(cMach) = "GFM" OR UPPER(cMach) = "OPEN DIE" OR UPPER(cMach) = "ROLLING" OR UPPER(cMach) = "SWAGE" 
			cSQL = cSQL + ","+STR(nFSz2,9,3)	 &&Flength
			cSQL = cSQL + ","+STR(nFthck,10,3)	 &&Fsize
		ENDIF
		cSQL = cSQL + ","+STR(nFWeight,8,1)
		IF UPPER(cMach) = "HEAT TREAT" 
			cSQL = cSQL + ",'HEAT TREAT'"		&&Condition
		ELSE
			cSQL = cSQL + ",'Cold Red'"			&&Condition
		ENDIF
		IF UPPER(cMach) != "HEAT TREAT" 
			cSQL = cSQL + ","+STR(nCW/100,3,3)+""	&&ColdWork
		ENDIF
		cSQL = cSQL + ",'"+cFDescript+"'"		&&Spec
		cSQL = cSQL + ","+STR(nSalesNum)+","+STR(nItemSO,2,0)+",'"+cSOitem+"'"
		cSQL = cSQL + ",'"+PrepareSQLtxt(cLotNotes,'Notes',-1)+"'" 					 &&Notes
		cSQL = cSQL + ","+STR(nWO)+","+STR(nWO_Detail)+","+STR(nStock_Projected_ID)
		cSQL = cSQL + ")"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			RETURN .F.
		ELSE
		
			ThisFormSet.SaveMachLot( cMach, nLot, nWO_Detail )
			
			*DO FORM Forms\ShowvGFMlog WITH nLot, cAlloy	
			*DO FORM Forms\GFMlog WITH nLot
			*MESSAGEBOX("No functioning yet.",64,"No")
			
			DO CASE
			CASE UPPER(cMach) = "DRAW BENCH" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Draw log Lot "+ALLTRIM(STR(nLot)),0,"Done")
			CASE UPPER(cMach) = "GFM" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the GFMlog Lot "+ALLTRIM(STR(nLot)),0,"Done")
		*			ThisFormSet.ShowGFMlog(PrepareSQLnum(nLot,'Lot',-3))
			CASE UPPER(cMach) = "HEAT TREAT" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Heat Treat log Lot "+ALLTRIM(STR(nLot)),0,"Done")
			CASE UPPER(cMach) = "OPEN DIE" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Lake Erie log Lot "+ALLTRIM(STR(nLot)),0,"Done")
		
			CASE UPPER(cMach) = "ROLLING"
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Roll_log Lot "+ALLTRIM(STR(nLot)),0,"Done")
			CASE UPPER(cMach) = "SWAGE"
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Swage_log Lot "+ALLTRIM(STR(nLot)),0,"Done")
		*			ThisFormSet.ShowSwage_log(PrepareSQLnum(nLot,'Lot',-3))
			CASE UPPER(cMach) = "WIRE DRAW" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Wire_log Lot "+ALLTRIM(STR(nLot)),0,"Done")
		*			ThisFormSet.ShowWire_log(PrepareSQLnum(nLot,'Lot',-3))
			ENDCASE
		
		
			
		ENDIF
		
		*********
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdCreateStock.Click
		PRIVATE nWO, nWO_Detail, cFSOitem, cFPOitem, cSPOitem
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		cFSOitem		= PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		cFPOitem		= PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		cSPOitem		= PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		
		IF nWO = 0
			MESSAGEBOX("No Work Order",48,"Cannot Stock without WO.")
			RETURN
		ENDIF
		IF nWO_Detail= 0
			MESSAGEBOX("No Work Order Detail",48,"Cannot Stock without WO_Detail")
			RETURN
		ENDIF
		PRIVATE nfWeight
		nfWeight = PrepareSQLnum(ThisForm.txtfWeight.Value,'Weight',9,1)
		IF nfWeight = 0
			MESSAGEBOX("No Weight entered"+CHR(13)+"Enter the Estimated Detail Weight First!",16,"Cannot List Stock")
			RETURN
		ENDIF
		
		PRIVATE nfReceivingID
		nfReceivingID	= PrepareSQLnum(ThisForm.txtfReceivingID.Value,'ReceivingID',-3)
		IF nfReceivingID > 0
			MESSAGEBOX("This has been received"+CHR(13)+"Click the Receiving number "+ALLTRIM(STR(nfReceivingID))+" to see receiving details.",16,"Cannot List Stock")
			RETURN
		ENDIF
		
		*************************
		* What is already on the StockLst
		PRIVATE lListStock, lOK
		lListStock = .F.
		
		lOK = ThisFormSet.Show_frmStock_Produced(nWO_Detail)
		
		*lListStock when Stock_Produced is empty
		IF USED("tmpStock_Produced")	
			IF RECCOUNT("tmpStock_Produced")	= 0
				lListStock = .T.
			ENDIF
		ELSE
			lListStock = .T.
		ENDIF
		
		************
		IF lListStock 
			IF ThisFormSet.StockLstAdd_WOD()
				*CALLS:ThisFormSet.Show_frmStock_Produced(nWO_Detail)
				*About the same as: ThisFormSet.Show_frmStock_Produced(nWO_Detail)
			ENDIF
		ENDIF
		
		RETURN lListStock 
	ENDPROC

	PROCEDURE frmWorkOrder.cmdDeleteDetail.Click
		IF MESSAGEBOX("Are you sure you want to Delete this WO Detail?",4+32,"Delete WO Detail?") != 6
			RETURN .F.
		ENDIF
		
		
		PRIVATE nWO, nWO_Detail, cFSOitem, cFPOitem
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		cFSOitem		= PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		cFPOitem		= PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		
		
		IF nWO = 0
			MESSAGEBOX("No Work Order",48,"Nothing to Delete")
			RETURN .F.
		ENDIF
		IF nWO_Detail= 0
			MESSAGEBOX("No Work Order Detail",48,"Nothing to Delete")
			RETURN .F.
		ENDIF
		
		********************************
		*Check for SOitem Complete!
		IF Proper_SO_item(cFSOItem)!=Proper_SO_item('')
			IF Count_SOIteminSales(cFSOItem, ThisFormSet.nConnHandle, "COMPLETE") > 0
				MESSAGEBOX("SO item:"+cFSOitem+" is listed as complete!",48,"Cannot Delete WO")
				RETURN .F.
			ENDIF
		ENDIF
		
		*Check for POitem Complete!
		IF Proper_PO_item(cFPOItem)!=Proper_PO_item('')
			IF Count_POIteminPurchaseOrder(cFPOItem, ThisFormSet.nConnHandle, "COMPLETE") > 0
				MESSAGEBOX("PO item:"+cFPOitem+" is listed as Complete/Reconciled!",48,"Cannot Delete WO")
				RETURN .F.
			ENDIF
		ENDIF
		
		*Check for WO_Detail Complete!
		IF nWO_Detail > 0
			IF Count_WODinWO_Detail(nWO_Detail, ThisFormSet.nConnHandle, "COMPLETE") > 0
		*	IF Count_WOinWO_Detail(nWO, ThisFormSet.nConnHandle, "COMPLETE") > 0	&&This proc looks at all WOD for WO
				MESSAGEBOX("WO Detail:"+STR(nWO_Detail)+" is listed as complete!",48,"Cannot Delete WO_Detail")
				RETURN .F.
			ENDIF
		ENDIF
		
		
		**************************************
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2)  && 1AUTO, 2MANUAL Trans
		SELECT 0
		
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "DELETE FROM dbo.WorkOrder_Detail WHERE WO_Detail= "+STR(nWO_Detail)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			lOK = .F.
		ENDIF
		
		*Remove WO_Detail from Sales - Done in Delete Triger
		*Remove WO_Detail from PurchaseOrder - Done in Delete Triger
		
		**********************
		
		IF lOK
			IF Proper_SO_item(cFSOitem) != Proper_SO_item('')
				IF MESSAGEBOX("Do you want to Cancel this SOitem? "+cFSOitem,4+32,"Cancel SOitem?") = 6
					nSalesNum = VAL(cFSOitem)
					lOK = Cancel_SOitem(cFSOitem, .T., ThisFormSet.nConnHandle) 	&& .T. to Amend Ver
				ENDIF
			ENDIF
		ENDIF
		
		**********************
		
		IF lOK
			IF Proper_PO_item(cFPOitem) != Proper_PO_item('')
				IF MESSAGEBOX("Do you want to Cancel this POitem? "+cFPOitem,4+32,"Cancel POitem?") = 6
					lOK = PurchaseOrder_Allow_Cancel(cFPOitem,ThisFormSet.nConnHandle)
					IF lOK
						lOK = PurchaseOrder_POitem_Cancel(cFPOitem, ThisFormSet.nConnHandle, .F.)
					ENDIF
				ENDIF		
			ENDIF
		ENDIF
		
		
		*******************
		IF lOK
			SQLCOMMIT(ThisFormSet.nConnHandle)	
		ELSE
			SQLROLLBACK(ThisFormSet.nConnHandle)
		ENDIF
		SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		ThisFormSet.Show_frmWorkOrder_WODetail(nWO)
			*CALLS: ThisFormSet.Refresh_frmWorkOrder_Detail(tmpWO_Detail.WO_Detail)  -First WO_Detail
				*CALLS: ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_Detail.fPOitem)
				*CALLS: ThisFormSet.CheckFinish_ID_Detail()
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdDeleteWO.Click
		
		
		PRIVATE nWO, nWO_Detail, cSOitem, cPOitem
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		cSOitem		= PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		cPOitem		= PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		PRIVATE cFSOitem, cFPOitem
		cFSOitem		= PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		cFPOitem		= PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		
		IF nWO = 0
			MESSAGEBOX("No Work Order",48,"Nothing to Delete")
			RETURN .F.
		ENDIF
		
		*Check for SOitem Complete!
		IF Proper_SO_item(cSOItem)!=Proper_SO_item('')
			IF Count_SOIteminSales(cSOItem, ThisFormSet.nConnHandle, "COMPLETE") > 0
				MESSAGEBOX("SO item:"+cSOitem+" is listed as complete from this WO!",48,"Cannot Delete WO")
				RETURN .F.
			ENDIF
		ENDIF
		
		*Check for POitem Complete!
		IF Proper_PO_item(cPOItem)!=Proper_PO_item('')
			IF Count_POIteminPurchaseOrder(cPOItem, ThisFormSet.nConnHandle, "COMPLETE") > 0
				MESSAGEBOX("PO item:"+cPOitem+" is listed as Complete/Reconciled!",48,"Cannot Delete WO")
				RETURN .F.
			ENDIF
		ENDIF
		
		*Check for WO Complete!
		IF nWO > 0
			IF Count_WOinWO(nWO, ThisFormSet.nConnHandle, "COMPLETE") > 0
				MESSAGEBOX("Work Order:"+STR(nWO)+" is listed as complete!",48,"Cannot Delete WO")
				RETURN .F.
			ENDIF
		ENDIF
		
		*Check for WO_Detail Complete!
		IF nWO_Detail > 0
		*	IF Count_WODinWO_Detail(nWO_Detail, ThisFormSet.nConnHandle, "COMPLETE") > 0
			IF Count_WOinWO_Detail(nWO, ThisFormSet.nConnHandle, "COMPLETE") > 0	&&This proc looks at all WOD for WO
				MESSAGEBOX("Work Order:"+STR(nWO)+" is listed as complete in WorkOrder Detail!",48,"Cannot Delete WO")
				RETURN .F.
			ENDIF
		ENDIF
		
		*Check if on the WorkOrder Board.
		IF nWO_Detail > 0
			IF Count_WODinWOD_WOD(nWO_Detail, ThisFormSet.nConnHandle, "") > 0
				MESSAGEBOX("Work Order Detail:"+STR(nWO_Detail)+" is listed on the Production Board.!"+CHR(13)+"Remove from Production first.",48,"Cannot Delete WO_Detail")
				RETURN .F.
			ENDIF
		ENDIF
		
		IF MESSAGEBOX("Are you sure you want to Delete this WO?",4+32,"Delete WO?") != 6
			RETURN .F.
		ENDIF
		
		***********************************
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		= SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2)  && 1AUTO, 2MANUAL Trans
		SELECT 0
		
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "DELETE FROM dbo.WorkOrder_Detail WHERE WO = "+STR(nWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			lOK = .F.
		ENDIF
		
		IF lOK
			cSQL = "DELETE FROM dbo.WorkOrder WHERE WO = "+STR(nWO)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				lOK = .F.
			ENDIF
		ENDIF
		
		
		*Remove WO from Sales - Done in Delete Triger
		*Remove WO from PurchaseOrder - Done in Delete Triger
		*Remove WO 'SELETED' Process - Done in Delete Triger
		
		*Remove WO_Detail from Sales - Done in Delete Triger
		*Remove WO_Detail from PurchaseOrder - Done in Delete Triger
		
		**********************
		
		IF lOK
			IF Proper_SO_item(cSOitem) != Proper_SO_item('')
				IF MESSAGEBOX("Do you want to Cancel this SOitem? "+cSOitem,4+32,"Cancel SOitem?") = 6
					nSalesNum = VAL(cSOitem)
					lOK = Cancel_SOitem(cSOitem, .T., ThisFormSet.nConnHandle)	&& .T. to Amend Ver
				ENDIF
			ENDIF
		ENDIF
		
		**********************
		
		IF lOK
			IF Proper_PO_item(cPOitem) != Proper_PO_item('')
				IF MESSAGEBOX("Do you want to Cancel this POitem? "+cPOitem,4+32,"Cancel POitem?") = 6
					lOK = PurchaseOrder_Allow_Cancel(cPOitem,ThisFormSet.nConnHandle)
					IF lOK
						lOK = PurchaseOrder_POitem_Cancel(cPOitem, ThisFormSet.nConnHandle, .F.)
					ENDIF
				ENDIF		
			ENDIF
		ENDIF
		
		
		*******************
		*Remove WO Stock Process
		IF lOK
			*Deleted in WorkOrder_Delete Triger
			lOK = Cancel_Detail_Process_WO(nWO, ThisFormSet.nConnHandle)
		ENDIF
		
		*******************
		
		IF lOK
			SQLCOMMIT(ThisFormSet.nConnHandle)	
		ELSE
			SQLROLLBACK(ThisFormSet.nConnHandle)
		ENDIF
		SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1AUTO, 2MANUAL Trans
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		ThisFormSet.nWO = nWO	&&LoadWO_frmWorkOrder uses nWO
		ThisFormSet.LoadWO_frmWorkOrder()
	ENDPROC

	PROCEDURE frmWorkOrder.cmdFcalc.Click
		ThisFormSet.Calc_Weight('FINISH',.F.)
	ENDPROC

	PROCEDURE frmWorkOrder.cmdFinishshow.Click
		PRIVATE cMach, nLot, cLot, cAlloy,nfThick 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'Mach',20)
		nLot	= PrepareSQLnum(ThisForm.txtFinishLot.Value,'Lot',-3)
		cLot	= PrepareSQLtxt(ThisForm.txtFinishLot.Value,'Lot',10)
		*cAlloy	= PrepareSQLtxt(ThisForm.txtfAlloy.Value,'Alloy',12)
		*nfThick = PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',10,4)
		
		IF EMPTY(cMach)
			MESSAGEBOX("You must Declare the Maching before inserting a new LOT",16,"Unknown machine")
			RETURN .F.
		ENDIF
		*!*	IF nfThick=0 OR EMPTY(cAlloy)
		*!*		MESSAGEBOX("Please fill in more the 'Finish' WO_Detail so a good insert log can be made.",16,"Unknown machine")
		*!*		RETURN .F.
		*!*	ENDIF
		
		DO CASE
		*Conversion_Log
		*Draw_Log
		CASE UPPER(LEFT(cMach,1)) = "D"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		*GFMLog
		CASE UPPER(LEFT(cMach,1)) = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		*HT_Lot
		*LakeErie_log
		CASE UPPER(LEFT(cMach,1)) = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		*Roll_log
		CASE UPPER(LEFT(cMach,1)) = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		*Swage_log	
		CASE UPPER(LEFT(cMach,1)) = "S"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		*Wire_log
		CASE UPPER(LEFT(cMach,1)) = "W"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		OTHERWISE
			MESSAGEBOX("Unknown Machine",16,"Unknown machine")
			RETURN .F.
		ENDCASE
		
		
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_MFG_Log(cMach,nLot,.T.)
		
		IF NOT EMPTY(m.cHyperLink)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			WAIT WINDOW "No Report to display" NOWAIT
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdFollowShow.Click
		PRIVATE cMach, nLot, cLot, cAlloy,nfThick 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFollowM.Value,'Mach',20)
		nLot	= PrepareSQLnum(ThisForm.txtFollowLot.Value,'Lot',-3)
		cLot	= PrepareSQLtxt(ThisForm.txtFollowLot.Value,'Lot',10)
		*cAlloy	= PrepareSQLtxt(ThisForm.txtfAlloy.Value,'Alloy',12)
		*nfThick = PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',10,4)
		
		IF EMPTY(cMach)
			MESSAGEBOX("You must Declare the Maching before inserting a new LOT",16,"Unknown machine")
			RETURN .F.
		ENDIF
		
		DO CASE
		*Conversion_Log
		
		*Draw_Log
		CASE UPPER(cMach) = "DRAW BENCH"  
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "D"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		*GFMLog
		CASE UPPER(cMach) = "GFM" 
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		CASE UPPER(cMach) = "HEAT TREAT" 
		*HT_Lot
		
		*LakeErie_log
		CASE UPPER(cMach) = "OPEN DIE" 
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		*Roll_log
		CASE UPPER(cMach) = "ROLLING"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		*Swage_log	
		CASE UPPER(cMach) = "SWAGE"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "S"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		*Wire_log
		CASE UPPER(cMach) = "WIRE DRAW" 
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "W"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		OTHERWISE
			MESSAGEBOX("Unknown Machine",16,"Unknown machine")
			RETURN .F.
		ENDCASE
		
		
			
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_MFG_Log(cMach,nLot,.T.)
		
		IF NOT EMPTY(m.cHyperLink)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			WAIT WINDOW "No Report to display" NOWAIT
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdGetInv.Click
		PRIVATE nWO, nWeight
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		IF nWO = 0
			MESSAGEBOX("No WorkOrder Number",16,"Cannot Select Stock")
			RETURN .F.
		ENDIF
		nWeight = PrepareSQLnum(ThisForm.txtWeight.Value,'Weight',-3)
		IF nWeight = 0
			MESSAGEBOX("No Weight entered"+CHR(13)+"Enter the Estimated starting Weight First!",16,"Cannot Select Stock")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, nStkDetailCnt
		cSQL ="SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder WHERE WO = "+ALLTRIM(STR(nWO))
		nStkDetailCnt = 0
		
		IF USED('CntWO')
			USE IN CntWO
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CntWO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CntWO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntWO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,'CntWO')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			nStkDetailCnt = 0
			lSQLgood = .F.
		ELSE
			IF USED("CntWO")
				nStkDetailCnt = PrepareSQLnum(CntWO.CNTD,'CNTD',-3)
				USE IN CntWO
			ELSE
				nStkDetailCnt = 0
			ENDIF
		ENDIF
		
		IF nStkDetailCnt = 0
			MESSAGEBOX("No WorkOrder Number saved in Table."+CHR(13)+"Save WO first.",16,"Cannot Select Stock")
			RETURN .F.
		ENDIF
		
		PRIVATE m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nPieces,m.nWeight,nQTY
		m.cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		m.cForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		m.cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		m.cCL		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		m.nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,4)
		m.nSz2		= PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',8,3)
		m.nSz3		= PrepareSQLnum(ThisForm.txtSz3.Value,'Sz3',8,3)
		m.cSOItem	= PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		m.nSalesNum	= nWO
		m.nPieces	= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
		m.nWeight	= PrepareSQLnum(ThisForm.txtWeight.Value,'Weight',7,1)
		nQTY 		= Calc_QTY(m.cAlloy,m.cForm,m.nPieces,m.nThck,m.nSz2,m.nSz3,'',ThisFormSet.nConnHandle)
		
		PRIVATE m.cSalesP,m.dSaleDate,m.dDueDate
		m.cSalesP	= AppSetup_Get_SalesP(ThisForm.txtSalesRep.Value)
		m.dSaleDate	= PrepareSQLDate(ThisForm.txtStartDate.Value,'SaleDate')
		m.dDueDate	= PrepareSQLDate(ThisForm.txtDueDate.Value,'DueDate')
		
		PRIVATE nHPAPO, cPoItem
		cPoItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		nHPAPO = VAL(cPoItem)
		
		PRIVATE cTBL
		IF Proper_PO_item(cPoItem) = Proper_PO_item('')
			cPoItem = PrepareSQLtxt(ThisForm.txtfPOitem.Value,'POitem',12)
		ENDIF
		IF Proper_PO_item(cPoItem) != Proper_PO_item('')
			**** Add code to see if a WIP or Broker Process had data!  --not always Broker
			
			cTBL = getTBL_Process_POitem(cPoItem,ThisFormSet.nConnhandle)
			IF EMPTY(cTBL)
				cTBL = "B"
			ENDIF
			
			*********
			IF cTBL = "B"
				IF MESSAGEBOX("Do you want to Select material on Broker List?"+CHR(13)+"Listing created by PO:"+cPOitem+" ?"+CHR(13)+CHR(13)+"Answer 'No' to choose from StockLst.",4+32,"On BrokerLst") = 6
					ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = 'B'
					WAIT WINDOW "Using BrokerLst for POitem:"+ALLTRIM(cPOitem) TIMEOUT 1
				ELSE
					cTBL = "S"
					ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = cTBL
					WAIT WINDOW "Using StockLst" TIMEOUT 1
				ENDIF
			ENDIF
			*********
			IF cTBL = "W"
				IF MESSAGEBOX("Do you want to Select material on WIP List?"+CHR(13)+"Listing created by PO:"+cPOitem+" ?"+CHR(13)+CHR(13)+"Answer 'No' to choose from StockLst."+CHR(13)+"You probably want to choose from Stock. 'N'",4+32+256,"On BrokerLst") = 6
					ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = 'W'
					WAIT WINDOW "Using WIP for POitem:"+ALLTRIM(cPOitem) TIMEOUT 1
				ELSE
					cTBL = "S"
					ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = cTBL
					WAIT WINDOW "Using StockLst" TIMEOUT 1
				ENDIF
			ENDIF
			********	
		ELSE
			cTBL = "S"
			ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = cTBL
			WAIT WINDOW "Using StockLst" TIMEOUT 1
		ENDIF
			
		
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		SELECT 0
		
		
		*	(SalesNum N(7), SOItem C(10), PO_num C(17), PCs N(10), Alloy C(12), Heat C(30), DESCRIPT C(80), Weight N(7,1), Kg L, PackWeight N(7,1);
		*	, PackingSli N(10) ,COMPLETE L, PartNo C(100), qShipped N(10), qBackOrder N(10) )
		
		PRIVATE cMEM
		cMEM = IIF( "\MEM" $ SYS(2003), '', '\MEM' )
		
		CREATE TABLE (SYS(5)+SYS(2003)+cMEM+"\"+"SalesQuote") FREE ;
			(Alloy C(12),Form C(2),CC C(1),CL C(1),Thck N(10,4),Sz2 N(9,3),Sz3 N(9,3),SalesP C(1),SaleDate D,Weight N(7,1),Pieces N(10),ShipDue D,SOItem_a C(10),Cover C(1))
		
		*LEFT( REPLACE(suser_sname(),'WINDFALL\',''),20)
		*SELECT Alloy,Form,Thck,Sz2,Sz3,SalesP,SaleDate,Weight,Pieces,ShipDue FROM SalesQuote WHERE SOItem_a = cSOitem	
		IF USED('SalesQuote')
			SELECT SalesQuote
			IF RECCOUNT('SalesQuote') = 0
				INSERT BLANK
			ENDIF
			REPLACE Alloy WITH cAlloy
			REPLACE Form WITH m.cForm
			REPLACE CC WITH m.cCC
			REPLACE CL WITH m.cCL
			REPLACE Thck WITH m.nThck
			REPLACE Sz2 WITH m.nSz2
			REPLACE Sz3 WITH m.nSz3
			REPLACE SalesP WITH m.cSalesP
			REPLACE SaleDate WITH m.dSaleDate
			REPLACE Weight WITH m.nWeight
			REPLACE Pieces WITH m.nPieces
			REPLACE ShipDue WITH m.dDueDate
			REPLACE SOItem_a WITH m.cSOitem
			REPLACE Cover WITH m.cSalesP &&Probably not needed
			*NewSO_bySO_Finish() NewSO_byPO_Finish() Uses AllQuotes.Cover for frmWorkOrder.txtSalesRep
		ENDIF
		
		PRIVATE pID_Detail, m.nID
		m.nID = 0
		*old DO FORM Forms\StockLst_SQL_Quotes WITH "SEL_WO",cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''   ,nQTY,.F.,cPOitem TO pID_Detail
		*DO FORM Forms\StockLst_SQL_Browse WITH "SEL_WO",cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''     ,nQTY,.F.,cPOitem TO pID_Detail
		 DO FORM Forms\StockLst_SQL_Modal WITH "SEL_WO",cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''     ,nQTY,.F.,cPOitem TO pID_Detail
		*Modal waits for a Return  PARAMETER pFunction,pTBL,  pAlloy,  pForm,  pCC,  pCL,  pThck,  pSz2,  pSz3,pSOItem, pSalesNum,      pPC,    pLBS,pHeatLot,pQTY,pRL,pPOitem
		
		
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		PRIVATE lOverWrite
		lOverWrite = .T.
		
		PRIVATE nID_Detail
		nID_Detail = 0
		
		IF TYPE("pID_Detail") = "N"
			IF pID_Detail = 0
				*Look for old Selections.
				IF USED('tmpStkLstPWO')
					USE IN tmpStkLstPWO
				ENDIF
				SELECT 0
				
				cSQL = "SELECT ID_Detail"
				cSQL = cSQL +" FROM dbo.StockLst_Process "
				cSQL = cSQL +" WHERE WO = "+STR(nWO)
				cSQL = cSQL +" AND ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStkLstPWO')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStkLstPWO')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStkLstPWO")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStkLstPWO")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStkLstPWO')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					IF USED("tmpStkLstPWO")
						pID_Detail	= PrepareSQLnum(tmpStkLstPWO.ID_Detail,'ID_Detail',-3)
						USE IN tmpStkLstPWO
					ENDIF
				ENDIF
			ENDIF
			
			IF pID_Detail > 0
				*Get StockLst
				*nID_Detail_Process = pID_Detail
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT m.ID,Alloy,Form,CC,CL,PC,Dim1,Dim2,Dim3,Weight,D.ID_Detail,P.QTY,P.Pounds"
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +" FROM dbo.StockLst_Detail D "
					cSQL = cSQL +" INNER JOIN dbo.StockLst_Master M ON M.ID = D.ID "
					cSQL = cSQL +" INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
				CASE cTBL = "B"
					cSQL = cSQL +" FROM dbo.BrokerLst_Detail D "
					cSQL = cSQL +" INNER JOIN dbo.BrokerLst_Master M ON M.ID = D.ID "
					cSQL = cSQL +" INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
				CASE cTBL = "W"
					cSQL = cSQL +" FROM dbo.WIPLst_Detail D "
					cSQL = cSQL +" INNER JOIN dbo.WIPLst_Master M ON M.ID = D.ID "
					cSQL = cSQL +" INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
				ENDCASE
				cSQL = cSQL +" WHERE P.WO = "+STR(nWO)
				cSQL = cSQL +" AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
				*cSQL = cSQL +" AND D.ID_Detail = "+STR(pID_Detail)
				*cSQL = cSQL +" AND P.ID_Detail_Process  = "+STR(pID_Detail)
		
				IF USED("tmpStockLst_Detail")
					SELECT tmpStockLst_Detail
				ELSE
					SELECT 0
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLst_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStockLst_Detail')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStockLst_Detail")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					IF USED("tmpStockLst_Detail")
						IF RECCOUNT("tmpStockLst_Detail")=1 &&>0
							PRIVATE nMess
							nMess = MESSAGEBOX("Do you want to overwrite WO Starting dimensions"+CHR(13)+"with the choosen Stock dimensions?"+CHR(13)+CHR(13)+"Handy if you are going to consume the whole Detail.",4+32+256,"Overwrite?") 
							IF nMess = 6
								lOverWrite = .T.
							ELSE
								lOverWrite = .F.
							ENDIF
		
							IF lOverWrite 
								PRIVATE nPieces, nPounds 
								
								ThisForm.txtAlloy.Value		= tmpStockLst_Detail.Alloy
								ThisForm.cmbForm.Value		= tmpStockLst_Detail.Form
								ThisForm.cmbCC.Value		= tmpStockLst_Detail.CC
								ThisFormSet.InitcmbCL()
								ThisForm.cmbCL.Value		= tmpStockLst_Detail.CL
								ThisForm.txtPieces.Value	= tmpStockLst_Detail.PC   &&temp PC, recalc
								nPieces = PrepareSQLnum(tmpStockLst_Detail.PC,'PC',-3)
								ThisForm.txtThck.Value		= tmpStockLst_Detail.Dim1
								ThisForm.txtSz2.Value		= tmpStockLst_Detail.Dim2
								ThisForm.txtSz3.Value		= tmpStockLst_Detail.Dim3
								nPounds = PrepareSQLnum(tmpStockLst_Detail.QTY,'Pounds',9,1)
								ThisForm.txtWeight.Value	= tmpStockLst_Detail.QTY
								
								ThisFormSet.frmChooseWO.txtID_Detail.Value = tmpStockLst_Detail.ID_Detail
								
								*****************************
								PRIVATE nPC_Pounds 
								nPC_Pounds = 0
								
								IF USED('tmpPriceTbl')
									USE IN tmpPriceTbl
								ENDIF
								SELECT 0
								
								PRIVATE cSQL
								cSQL = "EXEC dbo.p_GetFullQuoteCL "
								cSQL = cSQL + "@nPieces=1"      &&STR(nPieces)
								cSQL = cSQL + ",@cAlloy='"+ThisForm.txtAlloy.Value+"'"
								cSQL = cSQL + ",@cForm='"+ThisForm.cmbForm.Value+"'"
								cSQL = cSQL + ",@cCC='"+ThisForm.cmbCC.Value+"'"
								cSQL = cSQL + ",@cCL='"+ThisForm.cmbCL.Value+"'"
								cSQL = cSQL + ",@nThickness="+STR(PrepareSQLnum(ThisForm.txtThck.Value,'nThck',14,4),10,4)
								cSQL = cSQL + ",@nSize2="+STR(PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',12,3),9,3)
								cSQL = cSQL + ",@nSize3="+STR(PrepareSQLnum(ThisForm.txtSz3.Value,'nSz3',12,3),9,3)
								cSQL = cSQL + ",@nForceBracket=0"		&&+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
								cSQL = cSQL + ",@cCustID='' " &&CustID
								
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTbl")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
									RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
									
		*!*								PRIVATE cMess
		*!*								cMess = "Could not get the Price!"+CHR(13)
		*!*								*IF nPieces > 10000
		*!*								*	cMess = cMess + "Your Piece Count could be too high "+STR(nPieces)+"."+CHR(13)
		*!*								*ENDIF
		*!*								IF nThck > 16
		*!*									cMess = cMess + "Your first Dim could be too high "+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)+"."+CHR(13)
		*!*								ENDIF
		*!*								IF nSz2	> 120
		*!*									cMess = cMess + "Your second Dim could be too high "+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)+"."+CHR(13)
		*!*								ENDIF
		*!*								IF nSz3	 > 300
		*!*									cMess = cMess + "Your third Dim could be too high "+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)+"."+CHR(13)
		*!*								ENDIF
		*!*								MESSAGEBOX(cMess,16,"Edit your input numbers")
									
								ENDIF
								
								IF USED('tmpPriceTbl')
									IF RECCOUNT('tmpPriceTbl') > 0
										nPC_Pounds = tmpPriceTbl.Pounds
									ENDIF
									USE IN tmpPriceTbl
								ENDIF
								
								IF nPC_Pounds > 0
									IF nPC_Pounds > nPounds
										*Stick with the new Stock
										nPounds = nPC_Pounds 
										nPieces = 1
									ELSE
										nPieces = ABS(nPounds/nPC_Pounds)+1
										nPounds = nPieces * nPC_Pounds 
									ENDIF
								ENDIF
								
								************************	
								
								*ThisFormSet.Calc_Weight("START",.T.)
								ThisFormSet.Set_frmWorkOrder_Descript("START")
								
								************************	
		
								*Ask about PC change
		
								*Ask about Weight Change and the pinit.
		
		
							ENDIF
						ENDIF								
						
					ENDIF
				ENDIF
				
				IF USED("tmpStockLst_Detail")
					USE IN tmpStockLst_Detail
				ENDIF
			ENDIF
			********************
			IF pID_Detail > 0	
				ThisForm.chklPrc_Stock.Value = 1	
			ENDIF
		ENDIF
		
		******
		ThisFormSet.Load_tmpSPStart(nWO)
		ThisFormSet.Load_tmpSPStartP(nWO)
		
		******
		IF USED('tmpSPStart')
			IF RECCOUNT('tmpSPStart') > 0
				ThisFormSet.frmWorkOrder.cmdConsumeStock.Visible = .T.
				ThisFormSet.frmWorkOrder.cmdConsumeStock.Enabled = .T.
			ENDIF
		ENDIF		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdHelp.Click
		PRIVATE cMess
		cMess =                 "There are only WO and WO Details, no WO items."+CHR(13)
		cMess = cMess + CHR(13)+"The Work Order has only one Start description."
		cMess = cMess + CHR(13)+"Use 'Fast Start INV' to fill in the start description for you."
		cMess = cMess + CHR(13)+"Use 'Mark Inventory' when the Work Order will be comming from ERP Stock."+CHR(13)
		*cMess = cMess + CHR(13)+"The one start description can use multiple Inventory items."+CHR(13)
		cMess = cMess + CHR(13)+"If you need to start with different sizes to make"+CHR(13)
		cMess = cMess + CHR(13)+"a Finish size, use different Work Orders."+CHR(13)+CHR(13)
		*cMess = cMess + CHR(13)+"The finish description is stored in Quotes using SalesP='X'."
		*cMess = cMess + CHR(13)+"The start description is stored as the 'StartingStock' to the first Quote."
		*cMess = cMess + CHR(13)+"Multiple finish descriptions can be added to the one Work Order."
		cMess = cMess + CHR(13)+"Use 'Create PO' when HPA is stocking the converted product."
		*cMess = cMess + CHR(13)+"Use 'Edit StockLst' when a ERP PO has a process to bringing in material."
		
		MESSAGEBOX(cMess,0+64,"Helpfull Information.")
	ENDPROC

	PROCEDURE frmWorkOrder.cmdPrint.Click
		ThisFormSet.PrintWorkOrder_Production("Print")
		
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdPrintPreview.Click
		
		ThisFormSet.PrintWorkOrder_Production("Preview")
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdQuickPeek.Click
		PRIVATE m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,m.cSOItem,m.nPieces,m.nWeight
		PRIVATE nWO, nQTY
		nWO  		= PrepareSQLnum(thisForm.txtWO.Value,'WO',-3)
		m.cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		m.cForm		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		m.cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		m.cCL		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		m.nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,4)
		m.nSz2		= PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',8,3)
		m.nSz3		= PrepareSQLnum(ThisForm.txtSz3.Value,'Sz3',8,3)
		m.cSOItem	= PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		m.nPieces	= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
		m.nWeight	= PrepareSQLnum(ThisForm.txtWeight.Value,'Weight',7,1)
		nQTY 		= Calc_QTY(m.cAlloy,m.cForm,m.nPieces,m.nThck,m.nSz2,m.nSz3,'',ThisFormSet.nConnHandle)
		
		PRIVATE m.cSalesP,m.dSaleDate,m.dDueDate
		m.cSalesP	= AppSetup_Get_SalesP(ThisForm.txtSalesRep.Value)
		m.dSaleDate	= PrepareSQLDate(ThisForm.txtStartDate.Value,'SaleDate')
		m.dDueDate	= PrepareSQLDate(ThisForm.txtDueDate.Value,'DueDate')
		
		PRIVATE nHPAPO, cPoItem
		cPoItem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		nHPAPO = VAL(cPoItem)
		
		PRIVATE cTBL
		IF Proper_PO_item(cPoItem) != Proper_PO_item('')
			cTBL = "B"
			ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = cTBL
			
			IF MESSAGEBOX("Do you want to Select material from PO:"+cPOitem+" ?"+CHR(13)+"Answer 'No' to choose from StockLst.",4+32,"On BrokerLst") = 6
				WAIT WINDOW "Using BrokerLst for POitem:"+ALLTRIM(cPOitem) TIMEOUT 1
			ELSE
				cTBL = "S"
				ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = cTBL
				
				WAIT WINDOW "Using StockLst" TIMEOUT 1
			ENDIF
		ELSE
			cTBL = "S"
			ThisFormSet.frmWorkOrder.txtSPS_TBL.Value = cTBL
			
			WAIT WINDOW "Using StockLst" TIMEOUT 1
		ENDIF
			
		************************************
		ThisFormSet.frmSTK_Detail.Visible = .T.
		IF ThisFormSet.frmStockUsed.Visible
			ThisFormSet.frmSTK_Detail.Top	= ThisFormSet.frmStockUsed.Top + ThisFormSet.frmStockUsed.Height
		ELSE
			ThisFormSet.frmSTK_Detail.Top	= ThisForm.Top 
		ENDIF
		
		ThisFormSet.frmSTK_Detail.Left	= ThisForm.Left + ThisForm.Width
			
		ThisFormSet.frmSTK_Detail.grdSTK_Detail.RecordSource = ''
		ThisFormSet.frmSTK_Detail.lblLog.Caption = m.cAlloy+" "+m.cForm+" "+m.cCC+" "+m.cCL
		
		IF USED('STK_Detail')
			USE IN STK_Detail
		ENDIF
		
		SELECT 0
		
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT D.ID_Detail, dbo.f_CC_CLsort(M.CC,M.CL) AS CCL"
		*cSQL = cSQL +"m.ID,Alloy,Form
		*cSQL = cSQL +"CC,CL"
		
		*cSQL = cSQL +",Dim1,Dim2,Dim3,Weight,D.S_QTY"
		cSQL = cSQL +",P.Process_ID "
		cSQL = cSQL +",CONVERT(INT,D.S_QTY) AS QTY, PC"
		cSQL = cSQL +",dbo.f_ItemDescription(m.Form,Dim1,Dim2,Dim3,Weight,RandLen) AS ItemDescription"
		cSQL = cSQL +",D.ID_Detail"
		cSQL = cSQL +",M.Heat "
		cSQL = cSQL +" FROM dbo.StockLst_Detail D "
		cSQL = cSQL +" INNER JOIN dbo.StockLst_Master M ON M.ID = D.ID "
		cSQL = cSQL +" INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
		
		cSQL = cSQL +" WHERE M.Alloy = '"+m.cAlloy+"'"
		cSQL = cSQL +" AND M.Form = '"+m.cForm+"'"
		cSQL = cSQL +" AND dbo.f_CC_CLsort(M.CC,M.CL) =  dbo.f_CC_CLsort('"+m.cCC+"','"+m.cCL+"')"
		cSQL = cSQL +" AND ( M.Size >= "+STR(m.nThck,10,4)+" AND M.Size <= "+STR(m.nThck+1,10,4)+" )"
		cSQL = cSQL +" AND FLOOR(D.Weight) >= "+STR(m.nWeight,10,0)
		*--cSQL = cSQL +" AND ISNULL(M.POStatus,'D') <>'D' "
		*--cSQL = cSQL +" AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' ) "
		
		cSQL = cSQL +" ORDER BY M.Size "
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'STK_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'STK_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "STK_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "STK_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'STK_Detail')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED("STK_Detail")
				IF RECCOUNT('STK_Detail') > 0
					ThisFormSet.frmSTK_Detail.grdSTK_Detail.RecordSource = 'STK_Detail'
					
					ThisFormSet.frmSTK_Detail.grdSTK_Detail.SetFocus()
					
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdQuit_WorkOrder.Click
		ThisFormSet.SetVfrmWorkOrder(.F.)
		
		***********************
		*Check for Saved WO Data
		
		PRIVATE lFoundWO
		lFoundWO = .F.
		
		IF USED("tmpWOcnt")	
			USE IN tmpWOcnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder "
		cSQL = cSQL + " WHERE WO ="+STR(ThisFormSet.nWO)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOcnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOcnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOcnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOcnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOcnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOcnt')
				IF tmpWOcnt.Cnt > 0
					lFoundWO = .T.
				ENDIF
				USE IN tmpWOcnt
			ENDIF
		ENDIF
		
		***********************
		*Check for Saved WO_Detail Data
		
		PRIVATE lFoundWOD
		lFoundWOD = .F.
		
		IF USED("tmpWOcnt")	
			USE IN tmpWOcnt
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WorkOrder_Detail "
		cSQL = cSQL + " WHERE WO ="+STR(ThisFormSet.nWO)
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWOcnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWOcnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOcnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWOcnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWOcnt')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWOcnt')
				IF tmpWOcnt.Cnt > 0
					lFoundWOD = .T.
				ENDIF
				USE IN tmpWOcnt
			ENDIF
		ENDIF
		
		
		*************************
		PRIVATE nMess
		nMess = 0
		
		IF NOT lFoundWOD
			IF lFoundWO
				nMess = MESSAGEBOX("WO was found but there is no Detail"+CHR(13)+"You did not save."+CHR(13)+"Aborting Edit!"+CHR(13)+"Continue with the exit?",4+32,"Are you sure you want to leave?")
			ELSE
				nMess = MESSAGEBOX("WO and WO Detail not found."+CHR(13)+"You did not save."+CHR(13)+"Aborting Edits."+CHR(13)+"Continue with the exit?",4+32,"Are you sure you want to leave?")
			ENDIF
		ELSE
			IF NOT lFoundWO
				nMess = MESSAGEBOX("WO and WO Detail not found."+CHR(13)+"You did not save."+CHR(13)+"Aborting Edits."+CHR(13)+"Continue with the exit?",4+32,"Are you sure you want to leave?")
			ENDIF
		ENDIF
		
		IF nMess = 7
			ThisForm.Visible = .T.
			RETURN .F.
		ENDIF
		*************************
		
		ThisFormSet.frmWO_Detail_SO.WO_Detail_SO_Unload()
		
		DO CASE
		CASE ThisFormSet.pWhat = "CHOOSE"
			ThisFormSet.LoadWO_frmChooseWO('','',ThisFormSet.nWO)
				*CALLS: ThisFormSet.frmWorkOrder_Unload()
				*CALLS: ThisFormSet.InitChooseWO(cPOitem, cSOitem)
				
			*ThisFormset.Refresh_frmChooseWO_WO(ThisFormSet.nWO)
			*	CALLS: ThisFormSet.Refresh_frmChooseWO_Detail(WorkOrder.WO)
			*		CALLS: ThisFormSet.Refresh_frmWorkOrder_FPOitem(pfPOitem)
			*	CALLS: ThisFormSet.Set_frmWorkOrder('ENABLE')
		
			*ThisFormSet.frmChooseWO.grdWO.SetFocus
		CASE ThisFormSet.pWhat = "START"
			ThisFormSet.LoadWO_frmChooseWO('','',ThisFormSet.nWO)
			*ThisFormset.Refresh_frmChooseWO_WO(ThisFormSet.nWO)
			*	CALLS: ThisFormSet.Refresh_frmChooseWO_Detail(WorkOrder.WO)
			*	CALLS: ThisFormSet.Set_frmChooseWO()
			*ThisFormSet.frmChooseWO.grdWO.SetFocus
		CASE ThisFormSet.pWhat = "FINISH"
			ThisFormSet.LoadWO_frmChooseWO('','',ThisFormSet.nWO)
			*ThisFormset.Refresh_frmChooseWO_WO(ThisFormSet.nWO)
			*	CALLS: ThisFormSet.Refresh_frmChooseWO_Detail(WorkOrder.WO)
			*	CALLS: ThisFormSet.Set_frmChooseWO()
			*ThisFormSet.frmChooseWO.grdWO.SetFocus
			
		OTHERWISE
			*this code was called without ChooseWO!
		
			ThisForm.Visible = .F.
			ThisFormSet.frmWorkOrder_Unload()
			
			ThisForm.Release
			ThisFormSet.Release
		ENDCASE
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdRA.Valid
		ThisFormSet.frmRedArea.Visible = .T.
		
		ThisFormSet.frmRedArea.Top = ThisForm.Top
		*ThisFormSet.frmRedArea.Left = ThisForm.Left + ThisForm.Width
		ThisFormSet.frmRedArea.Left = ThisForm.shpDivide.Left
		
		PRIVATE nThck, nSz2, nFthck, nFSz2
		nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',14,4)
		nSz2		= PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',13,3)
		
		nFthck		= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisForm.txtFSz2.Value,'Sz2',13,3)
		
		PRIVATE nStartSize, nCW, nRoughSize, nOverSize
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		IF nThck> 0
			ThisFormSet.frmRedArea.txtD123.Value = nThck
		ENDIF
		IF nSz2 > 0
			ThisFormSet.frmRedArea.txtL124.Value = nSz2
		ENDIF
		IF nFthck > 0
			ThisFormSet.frmRedArea.txtD225.Value = nFthck 
		ENDIF
		IF nFSz2 > 0
			ThisFormSet.frmRedArea.txtL226.Value = nFSz2 
		ENDIF
		
		IF nStartSize>0 AND ( nCW>0 OR nRoughSize>0 )
			ThisFormSet.frmRedArea.txtD123.Value = nStartSize
			IF nRoughSize > 0
				ThisFormSet.frmRedArea.txtD225.Value = nRoughSize
			ENDIF	
			IF nCW > 0
				ThisFormSet.frmRedArea.txtRA36.Value = nCW
			ENDIF
		ENDIF
		
		ThisFormSet.frmRedArea.txtD123.SetFocus()
	ENDPROC

	PROCEDURE frmWorkOrder.cmdReceiveIn.Click
		PRIVATE nWO, nWO_Detail, cFSOitem, cFPOitem
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		cFSOitem		= PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		cFPOitem		= PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		
		IF nWO = 0
			MESSAGEBOX("No Work Order",48,"Cannot Stock without WO.")
			RETURN
		ENDIF
		IF nWO_Detail= 0
			MESSAGEBOX("No Work Order Detail",48,"Cannot Stock without WO_Detail")
			RETURN
		ENDIF
		
		*	Create a WO_Detail Receive
		*PARAMETER pPOitem, pLst, pnReceivingID, pnRMA, pnID_Detail, cHeat, pnID_Master 
		*DO FORM "forms\porecvstock.scx" WITH '   503396-03','BrokerLst', 0, 13481, 7071,'C3A59', 7198
		
		
		**********************************************
		*Receiving
		PRIVATE nfReceivingID, nfID_Detail, cfTBL
		
		nfReceivingID	= PrepareSQLnum(ThisForm.txtfReceivingID.Value,'ReceivingID',-3)
		nfID_Detail	= PrepareSQLnum(ThisForm.txtfID_Detail.Value,'ID_Detail',-3)
		cfTBL		= PrepareSQLtxt(ThisForm.txtfTBL.Value,'TBL',1)
		IF cfTBL=''
			cfTBL="S"
		ENDIF
		
		IF nfReceivingID > 0
			*PARAMETERS pcWhat, pValue, pcHeat
			DO FORM Forms\Receive_Edit WITH 'EDIT',nfReceivingID,''
		ELSE
			*PARAMETERS pcWhat, pValue, pcHeat
			DO FORM Forms\Receive_Edit WITH 'WO_Detail',nWO_Detail,''
		ENDIF
		
		
		
		*!*	*************************
		*!*	* What is already on the StockLst
		
		ThisFormSet.Show_StockLst("Received",nWO_Detail,cFPoItem)
		
		*!*	ThisFormSet.StockLstAdd_WOD()
		
		
		
		
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdResetCW.Click
		PRIVATE nThck, nfThck, nStartSize, nCW, nCWp, nRoughSize
		nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',8,3)
		nfThck		= PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',8,3)
		*nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		*nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		*nCWp		= 1+(nCW/100)
		*nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nStartSize = nThck
		IF nThck > 0 &&AND nCW = 0
			ThisForm.txtStartSize.Value = nThck
		ENDIF
		
		nRoughSize = nfThck
		IF nfThck > 0
			ThisForm.txtRoughSize.Value = nfThck
		ENDIF
		
		
		IF nStartSize > 0
			IF nRoughSize > 0
				*FIND RA BY DIA'S    (ORIG-FINAL)/ORIG=%
				*M.A1= 3.14156*M.sD1*M.sD1/4
				*M.A2= 3.14156*M.sD2*M.sD2/4
				*M.sRA = (M.A1-M.A2)/M.A1
				nCWp = ((3.14156*nStartSize*nStartSize/4)-(3.14156*nRoughSize*nRoughSize/4))/(3.14156*nStartSize*nStartSize/4)
				nCW = ROUND(nCWp * 100,0)
				ThisForm.txtCW.Value = PrepareSQLnum(nCW,'CW',2,0)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmWorkOrder.cmdSaveDetail.Click
		ThisFormSet.SaveAddDetail(.F.)
			***CALLS: ThisFormSet.CheckSaveDetail()
	ENDPROC

	PROCEDURE frmWorkOrder.cmdSaveWO.Click
