	ENDPROC

	PROCEDURE initwo_detail		&& Clear WO_Detail
		PARAMETERS cParameter
		*ThisFromSet.InitWO_Detail('NEW')
		
		IF VARTYPE(cParameter) != "C"
			cParameter = 'NEW'
		ELSE
			cParameter = cParameter
		ENDIF
		
		IF NOT USED('tmpWO_Detail') OR cParameter = 'NEW'
			IF cParameter = 'NEW'
				ThisFormSet.InitWO_Detail_Start()
			ELSE
				MESSAGEBOX("Could not 'CLONE'"+CHR(13)+"cParameter = "+cParameter ,0+16,"ThisFromSet.InitWO_Detail()")
			ENDIF
		ELSE
			*'NEW' and 'CLONE' use tmpWO !!!
			IF cParameter = 'CLONE'
				ThisFormset.frmWorkOrder.txtFPieces.Value	= tmpWO_Detail.fPieces
				ThisFormset.frmWorkOrder.txtFAlloy.Value	= tmpWO_Detail.fAlloy
				ThisFormset.frmWorkOrder.cmbFForm.Value		= tmpWO_Detail.fForm
				ThisFormSet.RefreshFForms(tmpWO_Detail.fForm)
		
				ThisFormset.frmWorkOrder.cmbFcc.Value		= tmpWO_Detail.fCC
				ThisFormSet.InitcmbFCL()
		
				ThisFormset.frmWorkOrder.cmbFCL.Value		= tmpWO_Detail.fCL
				ThisFormset.frmWorkOrder.txtFThck.Value		= tmpWO_Detail.fThck
				ThisFormset.frmWorkOrder.txtFSz2.Value		= tmpWO_Detail.fSz2
				ThisFormset.frmWorkOrder.txtFSz3.Value		= tmpWO_Detail.fSz3
				ThisFormSet.frmWorkOrder.chkPinFWeight.Value = PrepareSQLchk(tmpWO_Detail.pinFWeight,'pinfWeight')
				ThisFormset.frmWorkOrder.txtFWeight.Value 	= tmpWO_Detail.fWeight
				ThisFormset.frmWorkOrder.txtFSpec.Value 	= PrepareSQLtxt(tmpWO_Detail.fSpec,'fSpec',50)
				ThisFormset.frmWorkOrder.txtTotFinishW.Value 	= 0
				ThisFormset.frmWorkOrder.txtFDescript.Value	= tmpWO_Detail.fDescript
				ThisFormset.frmWorkOrder.txtfCondLevel.Value= ConditionLevelText(tmpWO_Detail.fCC,tmpWO_Detail.fCL)
		
				ThisFormset.frmWorkOrder.cmbFollowM.Value	= tmpWO_Detail.FollowM
				ThisFormset.frmWorkOrder.txtFollowLot.Value	= tmpWO_Detail.FollowLot
				ThisFormset.frmWorkOrder.cmbFinishM.Value	= tmpWO_Detail.FinishM
				ThisFormset.frmWorkOrder.txtFinishLot.Value	= tmpWO_Detail.FinishLot
				
				ThisFormSet.frmWorkOrder.txtStartSize.Value	= PrepareSQLnum(tmpWO_Detail.StartSize,'StartSize',9,3)
				ThisFormSet.frmWorkOrder.txtCW.Value		= PrepareSQLnum(tmpWO_Detail.CW,'CW',-1)
				ThisFormSet.frmWorkOrder.txtRoughSize.Value = PrepareSQLnum(tmpWO_Detail.RoughSize,'RoughSize',9,3)
				ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(tmpWO_Detail.OverSize,'OverSize',5,3)
			
				ThisFormset.frmWorkOrder.edtfNotes.Value	= tmpWO_Detail.fNotes
				ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value = PrepareSQLnum(tmpWO_Detail.Stock_Projected_ID,'Stock_Projected_ID',-3)
				ThisFormSet.nStock_Projected_ID 					= ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value 
				ThisFormSet.Refresh_Projected()
				
				*ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= PrepareSQLnum(tmpWO.AC_ID_WOD,'AC_ID',-3)
				ThisFormSet.frmWorkOrder.txtAC_ID_WOD.Value	= PrepareSQLnum(tmpWO_Detail.AC_ID_WOD,'AC_ID',-3)
				
				ThisFormSet.frmWorkOrder.txtFSOitem.Value	= PrepareSQLtxt(tmpWO_Detail.fSOitem,'SOitem',10)
				ThisFormSet.frmWorkOrder.txtFPOitem.Value	= PrepareSQLtxt(tmpWO_Detail.fPOitem,'POitem',12)
		*		ThisFormSet.Refresh_frmWorkOrder_POitem("")
				ThisFormSet.Refresh_frmWorkOrder_FPOitem(PrepareSQLtxt(tmpWO_Detail.fPOitem,'POitem',12))
			
				ThisFormSet.frmWorkOrder.txtFID_Detail.Value	= 0
				ThisFormSet.frmWorkOrder.txtFID_Detail.BackColor = RGB(240,240,240)
				
				ThisFormSet.frmWorkOrder.txtFID_Detail_Process.Value = 0
				ThisFormSet.frmWorkOrder.txtfTBL.Value 			= ''
				ThisFormSet.frmWorkOrder.txtfReceivingID.Value	= 0
		
		
				ThisFormset.frmWorkOrder.txtFDueDate.Value	= DATE()+31
				ThisFormSet.frmWorkOrder.cmbNextCode.Value	= ''
				ThisFormSet.frmWorkOrder.txtNextNumber.Value = ''
				
				ThisFormset.frmWorkOrder.chkfCmplt.Value	= 0
				ThisFormset.frmWorkOrder.chkfCncld.Value	= 0
				ThisFormset.frmWorkOrder.chkStkListed.Value	= 0
		
				ThisFormset.frmWorkOrder.chkfPrint.Value	= 0
				ThisFormset.frmWorkOrder.chkfPRecv.Value	= 0
				ThisFormset.frmWorkOrder.chkfMod.Value		= 0
				ThisFormset.frmWorkOrder.txtfRev.Value		= 0
		
				ThisFormset.frmWorkOrder.txtWO_Detail.Value = 0
				
				ThisFormSet.Calc_Weight("START",.T.)
				ThisFormSet.Calc_Weight("FINISH",.T.)
				
			ELSE
				MESSAGEBOX("Did not create 'NEW'"+CHR(13)+"cParameter = "+cParameter ,0+16,"ThisFromSet.InitWO_Detail()")
			ENDIF
		ENDIF
		
		
	ENDPROC

