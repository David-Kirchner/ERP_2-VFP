	PROCEDURE frmWorkOrder.txtSPS_ID_Detail_Process.Click
		PRIVATE nID_Detail_Process, nWO, nWO_Detail, cLst, cPoItem
		nID_Detail_Process = PrepareSQLnum(This.Value,'ID_Detail_Process',-3)
		nID_Detail = PrepareSQLnum(ThisForm.txtIDS_ID_Detail.Value,'ID_Detail',-3)
		
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WorkOrder',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		cLst = PrepareSQLtxt(ThisForm.txtSPS_TBL.Value,'TBL',1)
		cPoItem = PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		IF nID_Detail_Process  > 0
			DO FORM forms\Stocklst_Process WITH "EDIT_WO", nID_Detail_Process,      '',      '',         '',    0,    0,      '',        '', cLst, cPoItem, nWO, nID_Detail,       '', nWO_Detail
		*										  cWhatDo,            pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO, pID_Detail, pInqNumP, pWO_Detail
		ENDIF
	ENDPROC

