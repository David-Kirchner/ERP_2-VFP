	PROCEDURE frmWorkOrder.cmdWODrtr.Click
		
		IF ThisFormSet.RouterDetailOrder_IsOpen()
			*IF VARTYPE(Thisformset.frmRouterDetailOrder) != "O"
			*IF Thisformset.frmRouterDetailOrder.Visible
			Thisformset.frmRouterDetailOrder.AlwaysOnTop = .T.
			MESSAGEBOX("Close the 'Router Detail Order'"+CHR(13)+"Window First.",16,"Another Window is Open")
			Thisformset.frmRouterDetailOrder.cmdReturn.SetFocus
		ELSE
			PRIVATE biRTR_ID, nWOD
			biRTR_ID = 0
			nWOD = PrepareSQLnum( ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
			WAIT WINDOW 'Load Router' NOWAIT
			IF nWOD > 0
		
				cSQL = "SELECT ID FROM dbo.rtr "
				cSQL = cSQL + " WHERE WO_Detail = "+STR(nWOD)
		
				IF USED("tmpRTRidWO")	
					USE IN tmpRTRidWO
				ENDIF
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRTRidWO')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpRTRidWO')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTRidWO")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRTRidWO")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRTRidWO')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
				IF USED('tmpRTRidWO')
					IF RECCOUNT('tmpRTRidWO') > 0
						biRTR_ID = PrepareSQLnum(tmpRTRidWO.ID,'rtr_ID',-4)
					ENDIF
					USE IN tmpRTRidWO
				ENDIF
			ENDIF
		
			IF (biRTR_ID) > 0
				*ThisFormSet.LoadRTR(biRTR_ID)
				*WAIT WINDOW 'Router Loaded' NOWAIT
		
				ThisFormSet.frmRouter.Visible = .T.
				ThisFormSet.frmRouter.Top = ThisForm.Top + 20
				ThisFormSet.frmRouter.Left = 5
				
				*ThisFormSet.frmRouter.LoadRTR(biRTR_ID)
				ThisFormSet.frmRouter.router_init("EDIT", "WO_Detail", nWOD ) &&, nTop, nLeft, cCaption)
				
				ThisFormSet.frmRouter.cmdEdit.SetFocus
			ELSE
				MESSAGEBOX("No Router Enter Found!",0,"Nothing to Show")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmWorkOrder.cmdWOD_Connect.Click
		
		PRIVATE cPOitem, nWO, nWOD, lReturn
		cPOitem = PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		cSOitem = PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		nWO		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWOD	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WOD',-3)
		
		PRIVATE nMess
		DO FORM Forms\Connect_Orders WITH nWO,nWOD,cPOitem,cSOitem,"WOD"
		
		
		
		*!*	***********************
		*!*	*Update Record
		*!*	nWO = getWO_with_POitem( cPOitem, ThisFormSet.nConnHandle) 
		*!*	This.Parent.lblWOnum.Caption = STR(nWO)
		
		*!*	nWO_Detail = getWOD_with_POitem( cPOitem, ThisFormSet.nConnHandle) 
		*!*	This.parent.lblWO_Dnum.Caption = STR(nWO_Detail)
		
		*!*	*********************
		*!*	IF nWO + nWO_Detail > 0
		*!*		PRIVATE cSQLi 
		*!*		cSQLi = "UPDATE dbo.PurchaseOrder "
		*!*		IF nWO > 0
		*!*			cSQLi = cSQLi + " SET WO="+STR(nWO)
		*!*			IF nWO_Detail > 0
		*!*				cSQLi = cSQLi +", WO_Detail="+STR(nWO_Detail)
		*!*			ENDIF
		*!*		ELSE
		*!*			cSQLi = cSQLi + " SET WO_Detail="+STR(nWO_Detail)
		*!*		ENDIF
		*!*		
		*!*		cSQLi = cSQLi + " WHERE POitem = '"+cPOitem+"'"
		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi )
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi )
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQLi, ThisFormSet.nConnHandle, nSQLEXEC )
		*!*		ELSE
		
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

