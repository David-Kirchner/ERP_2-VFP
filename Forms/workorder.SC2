		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		
		IF nRoughSize = 0
			nRoughSize = nFThck + .050
		ENDIF
		IF nStartSize = 0
			nStartSize = nThck
		ENDIF
		
		ThisFormSet.frmProjected.grdProjected.RecordSource = ''
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tProjectedV')
			SELECT tProjectedV
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * "
		cSQL = cSQL + " FROM dbo.Stock_Projected "
		
		cSQL = cSQL + " ORDER BY CC,CL,STR(thck,9,3),Alloy"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tProjectedV')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tProjectedV')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tProjectedV")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tProjectedV")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tProjectedV')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tProjectedV')
			ThisFormSet.frmProjected.Visible = .T.
			PRIVATE cMess
			cMess = "Alloy:"+cAlloy + ", CC:"+cCC+", CL:"+cCL
		
			ThisFormSet.frmProjected.lblLog.Caption = cMess
			ThisFormSet.frmProjected.grdProjected.RecordSource = 'tProjectedV'
		ENDIF
		
	ENDPROC

	PROCEDURE frmWorkOrder.lblWO_Notes.Click
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		IF Proper_PO_item(cPOitem) = Proper_PO_item('')
			*use Finish
			cPOitem = PrepareSQLtxt(ThisForm.txtfPOitem.Value,'POitem',12)
			IF Proper_PO_item(cPOitem) = Proper_PO_item('')
				RETURN
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		*First opened in ThisFormSet.Refresh_frmWorkOrder_FPOitem(pfPOitem)
		
		cSQL = "SELECT Company"
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, StockLst_Qty, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig) AS Descript "
		cSQL = cSQL + ",Received"
		
		cSQL = cSQL + ",Cond_Spec,Misc_Purch"
		*cSQL = cSQL + ",LEFT(Cond_Spec,1000) AS Cond_Spec "
		*cSQL = cSQL + ",LEFT(Misc_Purch,1000) AS Misc_Purch "
		
		cSQL = cSQL + ",Services,ConvServ,Equipment,Reconciled,Stock "
		cSQL = cSQL + " FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
		
		IF USED("tmpWO_FPOitem")	
			USE IN tmpWO_FPOitem
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWO_FPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpWO_FPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_FPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWO_FPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpWO_FPOitem')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpWO_FPOitem')
			IF RECCOUNT('tmpWO_FPOitem')>0
		
				PRIVATE cWO_Notes, cFPOCond_Spec
				cWO_Notes		= PrepareSQLtxt(ThisForm.edtWO_Notes.Value,'Cond_Spec',-3)
				cFPOCond_Spec	= PrepareSQLtxt(tmpWO_FPOitem.Cond_Spec,'Cond_Spec',-3)
		
				IF EMPTY(cWO_Notes)
					ThisForm.edtWO_Notes.Value = cFPOCond_Spec 
				ELSE
					ThisForm.edtWO_Notes.Value = cFPOCond_Spec + CHR(13)+ cWO_Notes 
				ENDIF
		
			ENDIF
			*Do not Close, opened in ThisFormSet.Refresh_frmWorkOrder_FPOitem(pfPOitem)
		ENDIF
		
	ENDPROC

