	PROCEDURE Destroy
		IF VARTYPE(ThisFormSet.frmProd_Schedule) = "O"
			ThisFormSet.frmProd_Schedule.Release
		ENDIF
		
		IF "PRODUCTION" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\PRODUCTION"
		ENDIF
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pOType_Num, pPdID
		
		*DO FORM forms\Production WITH OType_Num, PdID
		
		PRIVATE nPdID, nFoundSched_Type 
		IF VARTYPE(pPdID) = "N"
			nPdID = pPdID
		ELSE
			nPdID = 0
		ENDIF
		nFoundSched_Type = 0
		
		IF VARTYPE(pOType_Num) = "C"
			PRIVATE m.nOper_ID, m.nBoardID, m.lOnBoard, m.lClosed, m.nSched_Type
			m.nOper_ID = 0
			m.nBoardID = 0
			m.lOnBoard = .F.
			m.lClosed = .F.
			m.nSched_Type = 0		
			
			PRIVATE cSQL, nSQLEXEC 
			IF USED('cntProd')
				USE IN cntProd
			ENDIF
		
			cSQL = "SELECT Prod.* "
			cSQL = cSQL + ", ISNULL(Job.Sched_Type,0) AS Sched_Type "
			cSQL = cSQL + " FROM dbo.rtr_Schedule Prod "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.OTracking_Job Job ON Prod.Oper_ID = Job.Oper_ID "
			cSQL = cSQL + " WHERE Prod.OType_Num = '"+pOType_Num+"'"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntProd')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntProd')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntProd")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntProd")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntProd')
			ENDIF
		
			IF USED('cntProd')
				IF RECCOUNT('cntProd') > 0 
					
					m.nOper_ID	= PrepareSQLnum(cntProd.Oper_ID,'Oper_ID',-3)
					m.nBoardID	= PrepareSQLnum(cntProd.ID,'ID',-3)
					m.lOnBoard	= PrepareSQLlogic(cntProd.OnBoard,'OnBoard')
					m.lClosed	= PrepareSQLlogic(cntProd.Closed,'Closed')
					m.nSched_Type = PrepareSQLnum(cntProd.Sched_Type,'Sched_Type',-1)
					
					IF m.nBoardID = nPdID
						*Found Parameter ID
						nFoundSched_Type = m.nSched_Type
					ENDIF
				ENDIF
				USE IN cntProd
			ENDIF
			
			IF m.lClosed
				MESSAGEBOX("Be carefull. This Order "+ALLTRIM(pOType_Num)+" has been Closed.",0+48,"Closed")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Be carefull. This Order "+ALLTRIM(pOType_Num)+" has been Closed. "+CHR(13)+"m.nBoardID = "+STR(m.nBoardID) )
			ENDIF
			IF m.lOnBoard
				*USE Oper_ID to choose Board group
				*Open Schedule m.nSched_Type board to m.nBoardID
			ELSE
				*Open a m.nSched_Type Window to Select and Add to Schedule
			ENDIF
		
		ENDIF
		
		******************************
		IF nPdID > 0 AND nFoundSched_Type > 0
			ThisFormSet.frmGen_Prod.nSched_Type = nFoundSched_Type
			ThisFormSet.frmGen_Prod.Refresh_Prod_Board()
			ThisFormSet.frmGen_Prod.SelectID(nPdID)
		ENDIF
	ENDPROC

	PROCEDURE Load
		*IF TYPE("gcSalesp") = "U"
		*	PUBLIC gcSalesp
		*ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
		ENDIF
		
		*ThisFormSet.GetPurchaseOrders(-720)
		
		SET SAFETY OFF
	ENDPROC

	PROCEDURE refreshprodtab
	ENDPROC

	PROCEDURE refresh_prod_board
		PARAMETERS cWindow
		*ThisFormSet.Refresh_Prod_Board("ROTARY FORGE")
		
		DO CASE
		CASE VARTYPE(cWindow)="U"
			TrackError("Bad Parameter cWindow","Bad Parameter cWindow", PROGRAM(), LINENO(1))
			RETURN .F.
		CASE cWindow = "ROTARY FORGE"
		OTHERWISE
			TrackError("Bad Parameter cWindow='"+cWindow+"'","Bad Parameter cWindow", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDCASE
			
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpProd_Board')
			DO CASE
			CASE cWindow = "ROTARY FORGE"
				ThisFormSet.frmGen_Prod.grdBoard.RecordSource = ''
			ENDCASE
			
			USE IN tmpProd_Pos
		ENDIF
		
		cSQL = "SELECT ID, Position, OType_Num "
		cSQL = cSQL + " ,dbo.f_OT_Descript(OType_Num) AS Descript "
		cSQL = cSQL + " FROM dbo.rtr_Schedule "
		DO CASE
		CASE cWindow = "ROTARY FORGE"
			cSQL = cSQL + " WHERE Oper_ID = 525 "
		ENDCASE
		
		cSQL = cSQL + " AND OnBoard = 1 "
		cSQL = cSQL + " ORDER BY Oper_ID, OnBoard, Position "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProd_Board')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpProd_Board')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProd_Board")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProd_Board")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProd_Board')
		ENDIF
		
		
		PRIVATE nBoardID
		nBoardID = 0
		
		IF USED('tmpProd_Board')
			IF RECCOUNT('tmpProd_Board') > 0 
				
				nBoardID = PrepareSQLnum(tmpProd_Board.ID,'ID',-3)
				
				DO CASE
				CASE cWindow = "ROTARY FORGE"
					ThisFormSet.frmGen_Prod.lstBoard.Visible = .T.	
					SCAN
						ThisFormSet.frmGen_Prod.lstBoard.AddItem(STR(tmpProd_Board.ID))
					ENDSCAN
				ENDCASE
				
			ENDIF
			*USE IN tmpProd_Board
		ENDIF
		
		DO CASE
		CASE cWindow = "ROTARY FORGE"
		*!*		ThisFormSet.frmRotaryForge.Visible = .T.
		*!*		ThisFormSet.frmRotaryForge.lstBoard.Value = STR(nBoardID)
		*!*		ThisFormSet.RotaryForgeID(nBoardID)
		*!*		
		*!*		ThisFormSet.frmRotaryForge.lstBoard.SetFocus
			ThisFormSet.frmGen_Prod.Visible = .T.
			ThisFormSet.frmGen_Prod.Caption = "ROTARY FORGE"
			ThisFormSet.frmGen_Prod.lstBoard.Value = STR(nBoardID)
		
			ThisFormSet.frmGen_Prod.RefreshGRD()
			ThisFormSet.frmGen_Prod.lstBoard.SetFocus
		ENDCASE
				
		
	ENDPROC

	PROCEDURE refresh_rotaryforge
		*ThisFormSet.Refresh_RotaryForge()
		
			
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpProd_Pos')
			ThisFormSet.frmRotaryForge.grdRotaryForge.RecordSource = ''
			USE IN tmpProd_Pos
		ENDIF
		
		cSQL = "SELECT ID, Position, OType_Num "
		cSQL = cSQL + " ,dbo.f_OT_Descript(OType_Num) AS Descript "
		cSQL = cSQL + " FROM dbo.rtr_Schedule "
		cSQL = cSQL + " WHERE Oper_ID = 525 AND OnBoard = 1 "
		cSQL = cSQL + " ORDER BY Oper_ID, OnBoard, Position "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpProd_Pos')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpProd_Pos')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProd_Pos")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProd_Pos")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProd_Pos')
		ENDIF
		
		ThisFormSet.frmRotaryForge.lstBoard.Visible = .F.
		PRIVATE nBoardID
		nBoardID = 0
		
		IF USED('tmpProd_Pos')
			IF RECCOUNT('tmpProd_Pos') > 0 
				
				nBoardID = PrepareSQLnum(tmpProd_Pos.ID,'ID',-3)
				
				ThisFormSet.frmRotaryForge.lstBoard.Visible = .T.			
				SCAN
					ThisFormSet.frmRotaryForge.lstBoard.AddItem(STR(tmpProd_Pos.ID))
				ENDSCAN
				
			ENDIF
			*USE IN tmpProd_Pos
		ENDIF
		
		*ThisFormSet.frmPO.lstPoItems.Value = ThisFormSet.frmPO.cPOitem
		ThisFormSet.frmRotaryForge.lstBoard.Value = STR(nBoardID)
		
		ThisFormSet.RotaryForgeID(nBoardID)
		
	ENDPROC

	PROCEDURE rotaryforgeid
		PARAMETERS nBoardID
		
		*ThisFormSet.RotaryForgeID(nBoardID)
		
		IF nBoardID > 0
			ThisFormSet.frmRotaryForge.cmdRemove.Visible = .T.
			ThisFormSet.frmRotaryForge.txtBoardID.Value = nBoardID
			
			SELECT tmpProd_Pos
			LOCATE FOR ID = nBoardID
			
			ThisFormSet.frmRotaryForge.grdRotaryForge.RecordSource = 'tmpProd_Pos'
		ELSE
			*clear
			ThisFormSet.frmRotaryForge.txtBoardID.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmpProd_Board')
			USE IN [tmpProd_Board]
		ENDIF
		
		
		= SQLDISCONNECT( ThisFormSet.nConnHandle )
		
		
	ENDPROC

