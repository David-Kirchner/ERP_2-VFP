DEFINE CLASS frmselectfromdeletedmaster AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdSelect" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Grid1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: closeconn
		*p: nconnhandle
		*p: returnvalue		&& Value to be returned ( Selected source Company)
	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth.ico
		Caption = "Deleteted StockLst Master records."
		closeconn = .F.
		DataSession = 1
		DoCreate = .T.
		Height = 282
		Left = 4
		LockScreen = .F.
		MDIForm = .T.
		Name = "frmSelectfromDeletedMaster"
		nconnhandle = 0
		returnvalue = 0
		Top = 5
		Width = 464
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdCancel' AS commandbutton WITH ;
		Caption = "Cancel", ;
		Height = 27, ;
		Left = 312, ;
		Name = "cmdCancel", ;
		TerminateRead = .T., ;
		Top = 240, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSelect' AS commandbutton WITH ;
		Caption = "Select", ;
		Default = .T., ;
		Height = 27, ;
		Left = 180, ;
		Name = "cmdSelect", ;
		Top = 240, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Grid1' AS grid WITH ;
		Height = 216, ;
		Left = 12, ;
		Name = "Grid1", ;
		Top = 12, ;
		Width = 432
		*< END OBJECT: BaseClass="grid" />
	
	PROCEDURE Init
		IF NOT USED('tmpStocklst_Master_History')
			*
		ENDIF
		
		ThisForm.grid1.RecordSource = "tmpStocklst_Master_History"
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		*ThisForm.CloseConn = .T.
		*ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		
		RETURN THISFORM.ReturnValue
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.ReturnValue = 0
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF USED("tmpStocklst_Master_History")
			IF VARTYPE(tmpStocklst_Master_History.ID_History) = "N"
				ThisForm.ReturnValue = tmpStocklst_Master_History.ID_History
			ELSE
				MESSAGEBOX( "Nothing Selected",0+48,"Nothing will be returned.")
			ENDIF
		ELSE
			MESSAGEBOX("No line was selected"+CHR(13)+"Did not find.",0+48,"Nothing will be returned.")
		ENDIF
		ThisForm.Release
	ENDPROC

ENDDEFINE
