	PROCEDURE frmSelect.cmdPrintLocations.Click
		PRIVATE cSQL
		cSQL = "SELECT DISTINCT location FROM dbo.StockLst_Detail WHERE NOT ( Location LIKE '%&%' OR Location LIKE '%/%' OR Location LIKE '%,%') ORDER BY Location"
		
		IF USED("location_SQL")
			SELECT location_SQL
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'location_SQL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'location_SQL')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "location_SQL")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "location_SQL")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC ,'location_SQL')
		ELSE
		
			SELECT location_SQL
			REPORT FORM Reports\Location TO PRINTER PREVIEW 
				
		ENDIF
		
		IF USED('location_SQL')
			USE IN location_SQL
		ENDIF
		
	ENDPROC

	PROCEDURE frmSelect.cmdReportHistory.Click
		IF USED('tmpUserTrack')
			USE IN tmpUserTrack
		ENDIF
		SELECT 0
		
		*cMess1		= RIGHT(cSQLmark,LEN(cSQLmark)-70)
		*cProgram	= "StockLst_Inv_Check"
		*cMachine	= LEFT(SYS(0),AT('#',SYS(0))-2)
		
		PRIVATE cSQL,nSQLEXEC
		
		cSQL = "SELECT ErrorDate,MESS1 FROM dbo.NR_UserTrack WHERE cprogram = 'StockLst_Inv_Check'"
		cSQL = cSQL + " AND YEAR(ErrorDate) = YEAR(GETDATE())"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUserTrack')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUserTrack')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUserTrack")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUserTrack")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpUserTrack')
		ENDIF
			
		
		IF USED('tmpUserTrack')
			BROWSE IN SCREEN
		
			USE IN tmpUserTrack
		ENDIF
	ENDPROC

	PROCEDURE frmSelect.cmdReportUnselected.Click
		IF USED('tmpUnCheckedINV')
			USE IN tmpUnCheckedINV
		ENDIF
		SELECT 0
		
		
		PRIVATE cSQL,nSQLEXEC
			
		cSQL = "SELECT COUNT(*) AS Items, "
		cSQL = cSQL + " M.alloy "
		cSQL = cSQL + " FROM dbo.stocklst_master AS M INNER JOIN "
		cSQL = cSQL + " dbo.stocklst_detail AS D ON M.id = D.id "
		cSQL = cSQL + " WHERE ISNULL(D.LiveCheck,0) = 0 "
		cSQL = cSQL + " AND ISNULL(D.AccountingCheck,0) = 1 "
		cSQL = cSQL + " GROUP BY m.Alloy "
		cSQL = cSQL + " ORDER BY m.Alloy "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUnCheckedINV')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpUnCheckedINV')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnCheckedINV")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnCheckedINV")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpUnCheckedINV')
		ENDIF
			
		
		IF USED('tmpUnCheckedINV')
			BROWSE IN SCREEN
		
			USE IN tmpUnCheckedINV
		ENDIF
	ENDPROC

