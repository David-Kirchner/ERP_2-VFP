	ENDPROC

	PROCEDURE frmStockLst_Inv_Check.cmdReportUnChecked.Click
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('StockCheckCount')
			USE IN StockCheckCount
		ENDIF
		
		
		cSQL = "SELECT COUNT(*) AS Items, "
		cSQL = cSQL + " M.alloy, M.form, M.CC, M.CL "
		cSQL = cSQL + " FROM dbo.stocklst_master AS M INNER JOIN "
		cSQL = cSQL + " dbo.stocklst_detail AS D ON M.id = D.id "
		*cSQL = cSQL + " WHERE ISNULL(D.LiveCheck,0) = 1 "
		cSQL = cSQL + " WHERE ISNULL(D.AccountingCheck,0) = 1"
		cSQL = cSQL + " GROUP BY m.Alloy,m.Form,m.CC,m.CL "
		cSQL = cSQL + " ORDER BY m.Alloy,m.Form,m.CC,m.CL "
		    
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockCheckCount')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockCheckCount')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockCheckCount")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockCheckCount")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'StockCheckCount')
		ENDIF
		
		IF USED('StockCheckCount')
			IF VARTYPE(StockCheckCount.Items) = "N"
				REPORT FORM Reports\StockCheckCount PREVIEW
			ENDIF
		ENDIF
	ENDPROC

ENDDEFINE
