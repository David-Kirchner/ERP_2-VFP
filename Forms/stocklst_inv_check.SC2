	PROCEDURE frmDetails.cmdDetailDelete.Click
		PRIVATE cSQL_Delete, cSQL, nSQLEXEC
		
		
		IF EMPTY(StockLst_Detail.ID_Detail)
			MESSAGEBOX("Cannot Delete",0,"No record")
		ELSE
			*Check for Process before Allowing Delete
			IF USED('tmpCountProcess')
				USE IN tmpCountProcess
			ENDIF
			SELECT 0
			DO CASE
			CASE ThisFormSet.Lst = "StockLst"
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.StockLst_Process "
			CASE ThisFormSet.Lst = "BrokerLst"
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.BrokerLst_Process "
			CASE ThisFormSet.Lst = "WIPLst"
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.WIPLst_Process "
			ENDCASE
			cSQL = cSQL + " WHERE ID_Detail = "+ STR(StockLst_Detail.ID_Detail)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountProcess' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountProcess' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountProcess")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountProcess")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountProcess')
			ENDIF
		
			IF USED('tmpCountProcess')
				IF tmpCountProcess.CNT > 0
					MESSAGEBOX("A process record is dependant on this Detail record."+CHR(13)+;
						"You must remove the process record first.",0,"You cannot delete!")
				ELSE
					IF MESSAGEBOX("Are you sure you want to delete this Detail Record?",4+32,"Confirm Delete") = 6
						
						
						PRIVATE cReason
						cReason = ""
						DO FORM Forms\AnswerForm WITH "Why do you want to Delete?","Not Found", 100 TO cReason
						
						IF TYPE("cReason") = "C"
							cReason = ALLTRIM(cReason)
						ELSE
							cReason = ""
						ENDIF
						
						
						IF Remove_Lst_Detail_by_ID_Detail(ThisFormSet.Lst,StockLst_Detail.ID_Detail,ThisFormSet.nConnHandle,.T.,cReason) &&Proc_ERP
							WAIT WINDOW 'Refreshing Screen to all in Live-Stock-Check' NOWAIT
							ThisFormSet.ShowSelectStockLst('LIVESTOCKCHECK')
						ENDIF
						
					ENDIF
		
				ENDIF
				USE IN tmpCountProcess
			ENDIF
		
			
		ENDIF
		
	ENDPROC

	PROCEDURE frmDetails.cmdDetailEdit.Click
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail
		
		IF TYPE("StockLst_Detail.ID_Detail")="U"
			MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
		ELSE
			DO FORM Forms\StockLst_Detail WITH "EDIT", StockLst_Detail.ID_Detail, 0, ThisFormSet.Lst, 0 TO nReturn
		
			IF TYPE("nReturn") = "N"
				IF nReturn > 0
					*ThisForm.RefreshMaster(StockLst_Master.ID)
					*THISFORM.ShowDetail(nReturn)
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

