	PROCEDURE frmDetails.cmdDetailNext.Click
		PRIVATE nRecNo, nReccount
		nRecNo = RECNO("StockLst_SQL")
		*SET ORDER TO TAG StockLst IN StockLst_SQL
		IF NOT EOF("StockLst_SQL")
			SKIP 1 IN StockLst_SQL
			nReccount = RECCOUNT("StockLst_SQL")
			
			DO WHILE NOT EOF("StockLst_SQL")
				IF DELETED()
					SKIP 1 IN StockLst_SQL
				ELSE
					EXIT
				ENDIF
			ENDDO
				
			IF nRecNo = RECNO("StockLst_SQL")
				WAIT WINDOW "End of File" NOWAIT
			ENDIF
			IF RECNO("StockLst_SQL") > nReccount
				SKIP -1 IN StockLst_SQL
				WAIT WINDOW "End of File" NOWAIT
			ENDIF
		ELSE
			WAIT WINDOW "End of File" NOWAIT
		ENDIF
		
		ThisFormset.frmBrowse.grdStockLst_SQL.Refresh
		ThisFormSet.RefreshDetails()
	ENDPROC

	PROCEDURE frmDetails.cmdDetailPrev.Click
		PRIVATE nRecNo
		nRecNo = recno("StockLst_SQL")
		*SET ORDER TO TAG StockLst IN StockLst_SQL
		IF NOT BOF("StockLst_SQL")
			SKIP -1 IN StockLst_SQL
			
			DO WHILE NOT DELETED() AND NOT BOF("StockLst_SQL")
				SKIP -1 IN StockLst_SQL
			ENDDO
				
			IF BOF("StockLst_SQL")
				WAIT WINDOW "Begining of File" NOWAIT
			ENDIF
		ELSE
			WAIT WINDOW "Begining of File" NOWAIT
		ENDIF
		
		ThisFormset.frmBrowse.grdStockLst_SQL.Refresh
		ThisFormSet.RefreshDetails()
	ENDPROC

	PROCEDURE frmDetails.cmdFound.Click
		SELECT StockLst_SQL
		IF DELETED('StockLst_SQL')
			MESSAGEBOX("This record has already been marked!"+CHR(13)+"Look previous for a record that has not been marked."+CHR(13)+"If you cannot find a record to mark,"+CHR(13)+"then you are done with this selection."+CHR(13)+"Quit here,"+CHR(13)+"then select another section of Stock List to check!",0+64,"Done!")
			RETURN
		ENDIF
		
		PRIVATE nID_Detail
		nID_Detail = StockLst_SQL.ID_Detail
		IF nID_Detail < 1
			RETURN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "UPDATE dbo.StockLst_Detail SET LiveCheck = 0, AccountingCheck = 0"
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC )
		ENDIF
		
		SELECT StockLst_SQL
		
		DELETE FOR ID_Detail = nID_Detail
		ThisFormset.frmBrowse.grdStockLst_SQL.Refresh
		LOCATE FOR ID_Detail = nID_Detail
		
		IF FOUND()
			WAIT WINDOW "Successfully marked Stock as correct!" NOWAIT
			
			SELECT StockLst_SQL
			PRIVATE nRecNo, nReccount 
			nRecNo = RECNO("StockLst_SQL")
			*SET ORDER TO TAG StockLst IN StockLst_SQL
			IF NOT EOF("StockLst_SQL")
				SKIP 1 IN StockLst_SQL
				nReccount = RECCOUNT("StockLst_SQL")
				
				DO WHILE NOT EOF("StockLst_SQL")
					IF DELETED()
						SKIP 1 IN StockLst_SQL
					ELSE
						EXIT
					ENDIF
				ENDDO
				
				IF nRecNo = RECNO("StockLst_SQL")
					WAIT WINDOW "Successfully marked Stock as correct! End of File" NOWAIT
				ENDIF
				IF RECNO("StockLst_SQL") > nReccount 
					SKIP -1 IN StockLst_SQL
					WAIT WINDOW "Successfully marked Stock as correct! End of File" NOWAIT
				ENDIF
				IF RECNO("StockLst_SQL") > nRecNo + 5
					GOTO nRecNo IN StockLst_SQL
				ENDIF
			ELSE
				WAIT WINDOW "Successfully marked Stock as correct! End of File" NOWAIT
			ENDIF
		
			ThisFormset.frmBrowse.grdStockLst_SQL.Refresh
			ThisFormSet.RefreshDetails()
		ENDIF
		
	ENDPROC

	PROCEDURE frmDetails.cmdMasterAdd.Click
		PRIVATE nReturn, nMasterID, nReturnID_Detail
		nReturn = 0 &&ID
		nMasterID = StockLst_Master.ID
		
		IF MESSAGEBOX("Is this a completly new ADD?"+CHR(13)+CHR(13)+;
			"If no, this ID will be saved to the new record in the From_ID field,"+CHR(13)+;
			"so the new record will be able to reference back to source."+CHR(13)+;
			"EXAMPLE: Forged 6B is NOT a NEW Add.",4+32,"New ADD is not related to this record.") = 6
			
			nMasterID = 0
		ENDIF
			
		DO FORM Forms\StockLst_Master WITH "ADD", nMasterID,ThisFormSet.Lst TO nReturn
		
		IF TYPE("nReturn") = "N"
			IF nReturn > 0
		* 		THISFORM.RefreshMaster(nReturn)
		 		ThisFormSet.RefreshDetails(nReturn)
		 		
				nReturnID_Detail = 0 &&ID_Detail
				DO FORM Forms\StockLst_Detail WITH "ADD", StockLst_Master.ID, 0, ThisFormSet.Lst, 0 TO nReturnID_Detail
		
				IF TYPE("nReturnID_Detail") = "N"
					IF nReturnID_Detail> 0
				 		*ThisForm.ShowDetail(nReturnD)
				 		ThisFormSet.Refresh_Detail(nReturnID_Detail)
				 		Mark_StockLst_Detail_Live_Check(nReturnID_Detail,ThisFormSet.nConnHandle)
					ENDIF
				ENDIF
				
				WAIT WINDOW 'Refreshing Screen to all in Live-Stock-Check' NOWAIT
				ThisFormSet.ShowSelectStockLst('LIVESTOCKCHECK')
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmDetails.cmdMasterDelete.Click
		PRIVATE cSQL_Delete, cSQL, nSQLEXEC
		PRIVATE nNextID,nID
		nNextID = 0
		nID = StockLst_Master.ID
		
		IF MESSAGEBOX("Are you sure you want to 'Delete'? ",4+32,"Delete")= 7	
			RETURN
		ENDIF
		
		PRIVATE cTBL
		cTBL = TBL_TableName(ThisFormSet.Lst)
		
		IF NOT EOF('stocklst_master')
			SELECT stocklst_master
			*SET ORDER TO TAG StockLst IN StockLst_Master
			
			SKIP 1 IN stocklst_master
			nNextID = StockLst_Master.ID
			SKIP -1 IN StockLst_Master
		ENDIF
				
		IF EMPTY(StockLst_Master.ID)
			MESSAGEBOX("Cannot Delete",0,"No record")
			RETURN
		ENDIF
		
		IF USED('tmpCountDetail')
			USE IN tmpCountDetail
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.StockLst_Detail WHERE ID = "+ STR(nID)
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountDetail' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountDetail' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountDetail')
			IF USED('tmpCountDetail')
				USE IN tmpCountDetail
			ENDIF
			RETURN .F.
		ENDIF
						
		IF tmpCountDetail.cnt > 1
			MESSAGEBOX("Found "+ALLTRIM(STR( tmpCountDetail.cnt ))+" Detail records that belong to this Master."+CHR(13)+"Please remove details first!"+CHR(13)+"Not Allowed to delete a master when it has many details.",0+16,"Cannot Delete")
			
			IF USED('tmpCountDetail')
				USE IN tmpCountDetail
			ENDIF
		
		ELSE
			IF USED('tmpCountDetail')
				USE IN tmpCountDetail
			ENDIF
		
			PRIVATE cReason
			cReason = ""
			DO FORM Forms\AnswerForm WITH "Why do you want to Delete?","Not Found", 100 TO cReason
			
			IF TYPE("cReason") = "C"
				cReason = ALLTRIM(cReason)
			ELSE
				cReason = ""
			ENDIF
			
			IF Remove_Lst_ID(cTBL,StockLst_Master.ID,ThisFormSet.nConnHandle,.T.,'',cReason) &&Proc_ERP
				ThisForm.ReloadSQL()
			ENDIF
			
			*ThisForm.ShowMaster(nNextID)
			*THISFORM.RefreshMaster(nNextID)
			
		*	IF ThisForm.pgFrameMaster.ActivePage = 2
		*		ThisForm.pgFrameMaster.ActivePage = 1
		*	ENDIF
			WAIT WINDOW 'Refreshing Screen to all in Live-Stock-Check' NOWAIT
			ThisFormSet.ShowSelectStockLst('LIVESTOCKCHECK')
		ENDIF
		
		
	ENDPROC

