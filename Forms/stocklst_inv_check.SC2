	PROCEDURE frmStockLst_Inv_Check.cmdDefault.Click
		
		IF MESSAGEBOX("Are you sure you are ready to START the Inventory Check process now?",4+32,"Start Inventory Check?") = 6
		
			IF Update_StockLst_Detail_AccountingCheck( ThisFormSet.nConnHandle )
			
				ThisFormSet.LoadLiveStock()
				
				MESSAGEBOX("Ready to Start the Inventory Check!",0,"Ready")
				
			ENDIF
		ENDIF
	ENDPROC

