	PROCEDURE Init
		ThisFormSet.LoadLiveStock()
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE loadlivestock
		*ThisFormSet.LoadLiveStock()
		PRIVATE lInLiveCheck
		lInLiveCheck = .F.
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT COUNT(*) AS Items, "
		cSQL = cSQL + " M.alloy, M.form, M.CC, M.CL "
		cSQL = cSQL + " FROM dbo.Stocklst_Master AS M INNER JOIN "
		cSQL = cSQL + " dbo.Stocklst_Detail AS D ON M.id = D.id "
		cSQL = cSQL + " WHERE ISNULL(D.LiveCheck,0) = 1 "
		cSQL = cSQL + " GROUP BY m.Alloy,m.Form,m.CC,m.CL "
		cSQL = cSQL + " ORDER BY m.Alloy,m.Form,m.CC,m.CL "
		    
		IF USED('LiveStockCount')
			ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.RecordSource = ""
			USE IN LiveStockCount
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'LiveStockCount')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'LiveStockCount')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "LiveStockCount")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "LiveStockCount")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'LiveStockCount')
		ENDIF
		
		IF USED('LiveStockCount')
			IF VARTYPE(LiveStockCount.Items) = "N"
				IF LiveStockCount.Items > 0
					lInLiveCheck = .T.
					ThisFormSet.ShowLiveStockCheck()
				ENDIF
			ENDIF
			*USE IN LiveStockCount
		ENDIF
		
		IF NOT lInLiveCheck
			ThisFormset.frmStockLst_Inv_Check.lblLiveCheckStatus.Caption = "No Live Stock Check records found!"
			ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Visible = .F.
			ThisFormset.frmStockLst_Inv_Check.cmdEditCurrent.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE makesql
	ENDPROC

	PROCEDURE refreshdetails
		PARAMETERS npID
		*ThisFormSet.RefreshDetails
		
		PRIVATE nID
		IF VARTYPE(npID) = "N"
			nID = npID
		ELSE
			nID = StockLst_SQL.ID
		ENDIF
		
		
		cSQLM = "SELECT * FROM dbo.StockLst_Master WHERE ID = "+STR(nID)
		
		cSQLD = "SELECT * FROM dbo.StockLst_Detail WHERE ID = "+STR(nID)
		
		IF USED('StockLst_Master')
			USE IN StockLst_Master
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLM, 'StockLst_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLM, 'StockLst_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLM, "StockLst_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLM, "StockLst_Master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLM, ThisFormSet.nConnHandle, nSQLEXEC ,'StockLst_Master')
		ENDIF
		
		IF USED('StockLst_Detail')
			USE IN StockLst_Detail
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, 'StockLst_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, 'StockLst_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, "StockLst_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, "StockLst_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLD, ThisFormSet.nConnHandle, nSQLEXEC ,'StockLst_Detail')
		ENDIF
		
		ThisFormSet.frmDetails.Refresh
	ENDPROC

	PROCEDURE refresh_detail
		PARAMETER nID_Detail
		*ThisFormSet.Refresh_Detail(nReturnID_Detail)
		
		IF USED('StockLst_Detail')
			USE IN StockLst_Detail
		ENDIF
		SELECT 0
		
		cSQLD = "SELECT * FROM dbo.StockLst_Detail WHERE ID = "+STR(StockLst_SQL.ID)
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, 'StockLst_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, 'StockLst_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, "StockLst_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLD, "StockLst_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLD, ThisFormSet.nConnHandle, nSQLEXEC,'StockLst_Detail')
		ENDIF
		
		
		
		IF USED('StockLst_Detail')
			LOCATE FOR ID_Detail = nID_Detail
			
			IF FOUND()
				ThisFormSet.frmDetails.Refresh
			ELSE
				GO TOP
				MESSAGEBOX("Did not find the new Detail to show!",0+16,"Error")
			ENDIF	
		ENDIF
	ENDPROC

	PROCEDURE selectformchanged
		PARAMETERS plValue
		*ThisFormSet.SelectFormChanged( This.Value )
		
		IF plValue = 0
			ThisFormSet.frmSelect.chkFormAll.Value = 0
		ELSE
			IF ThisFormSet.frmSelect.chkFormAll.Value = 0
				*IF ALL OTHERS ARE 1, change all to 1
				IF ThisFormSet.frmSelect.chkFormBar.Value = 1 ;
					AND ThisFormSet.frmSelect.chkFormWire.Value = 1 ;
					AND ThisFormSet.frmSelect.chkFormPlate.Value = 1 ;
					AND ThisFormSet.frmSelect.chkFormTube.Value = 1 ;
					AND ThisFormSet.frmSelect.chkFormPipe.Value = 1 ;
					AND ThisFormSet.frmSelect.chkFormFittings.Value = 1 ;
					AND ThisFormSet.frmSelect.chkFormFasteners.Value = 1
				
					ThisFormSet.frmSelect.chkFormAll.Value = 1
				ENDIF
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE showdetail
		PARAMETER pnID_Detail
		*ThisFormSet.ShowDetail(ID_Detail)
		PRIVATE cSQL, nSQLEXEC, nrecCount
		
		
		*ThisForm.StockLst_Detail_RecordSource('OFF')
		
		IF ThisFormSet.frmDetails.Lst = "StockLst"
			cSQL= "SELECT * FROM dbo.StockLst_Detail WHERE ID = "+STR(StockLst_Master.ID)+" ORDER BY ID_Detail"
		ELSE
			cSQL= "SELECT * FROM dbo.BrokerLst_Detail WHERE ID = "+STR(StockLst_Master.ID)+" ORDER BY ID_Detail"
		ENDIF
		
		IF USED("StockLst_Detail")
			SELECT StockLst_Detail
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Detail' )
		ELSE
			*ThisForm.StockLst_Detail_RecordSource('ON')
		
			IF TYPE("pnID_Detail")= "N"
				IF pnID_Detail > 0
					SELECT StockLst_Detail
					GO TOP
					DO WHILE NOT EOF("StockLst_Detail")
						IF StockLst_Detail.ID_Detail = pnID_Detail
							EXIT
						ENDIF
						SKIP IN StockLst_Detail
					ENDDO
				ENDIF
			ELSE
				*Get Detail
				SELECT StockLst_Detail
				*nRecCount = RECCOUNT("StockLst_Detail")
				*THISFORM.pgFrameDetail.pgEdit.lblRecCountDetail.Caption = "-"+ALLTRIM(STR(nRecCount))
				GO TOP
			ENDIF
		
			SELECT StockLst_Detail
		*!*		IF ThisForm.pgFrameMaster.ActivePage = 1
		*!*			THISFORM.pgFrameProcess.pgBrowse.grdProcess.REFRESH	&&Only refresh this for Speed
		*!*		ELSE
		*!*			THISFORM.pgFrameProcess.pgBrowse.grdProcess.REFRESH
		*!*		ENDIF
			
			ThisFormSet.frmDetails.Refresh
			
			ThisFormSet.frmDetails.chkRandLen.Refresh
			ThisFormSet.frmDetails.PC1.REFRESH
			ThisFormSet.frmDetails.SIZE_H1.REFRESH
			ThisFormSet.frmDetails.Dim11.REFRESH
			ThisFormSet.frmDetails.Size_L1.REFRESH
			ThisFormSet.frmDetails.Dim21.REFRESH
			ThisFormSet.frmDetails.Dim31.REFRESH
			ThisFormSet.frmDetails.Descript1.REFRESH
			ThisFormSet.frmDetails.UNIT1.Refresh
			ThisFormSet.frmDetails.CostValue1.REFRESH
			ThisFormSet.frmDetails.Weight1.REFRESH
			ThisFormSet.frmDetails.Length1.REFRESH
			ThisFormSet.frmDetails.Location1.REFRESH
			ThisFormSet.frmDetails.FLOORSTATUS1.REFRESH
			ThisFormSet.frmDetails.CLASS1.REFRESH
			ThisFormSet.frmDetails.txtID_Detail.REFRESH
			ThisFormSet.frmDetails.InvCheck.REFRESH
			
			THISFORM.ShowProcess()
		ENDIF
		
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE showlivestockcheck
		*ThisFormSet.ShowLiveStockCheck
		
		ThisFormset.frmStockLst_Inv_Check.lblLiveCheckStatus.Caption = "Showing 'Live Stock Check' records."
		ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.RecordSource = "LiveStockCount"
		
		*ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Column1.Header1.Caption = 'Records'
		*ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Column2.Header1.Caption = 'Alloy'
		*ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Column3.Header1.Caption = 'form'
		*ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Column4.Header1.Caption = 'CC'
		
		*ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Column1.Text1.ControlSource = LiveStockCount.items
		*ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Column2.Text1.ControlSource = LiveStockCount.Alloy
		*ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Column3.Text1.ControlSource = LiveStockCount.form
		*ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Column4.Text1.ControlSource = LiveStockCount.CC
		
		*ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Refresh
		
		ThisFormset.frmStockLst_Inv_Check.grdLiveStockCount.Visible = .T.
		ThisFormset.frmStockLst_Inv_Check.cmdEditCurrent.Visible = .T.
	ENDPROC

	PROCEDURE showselectstocklst
		PARAMETERS pcMark
		*ThisFormSet.ShowSelectStockLst()
		
		PRIVATE lMark, lLiveStockCheck 
		lMark = .F.
		lLiveStockCheck  = .F.
		
		IF VARTYPE(pcMark) = "C"
			IF pcMark = "MARK"
				lMark = .T.
			ENDIF
			IF pcMark = "LIVESTOCKCHECK"
				lLiveStockCheck = .T.
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE lAddWhere, lAddAND, lAddOR
		lAddWhere = .T.
		lAddAlloy = .F.
		lAddOR	= .T.
		
		IF lLiveStockCheck 
			IF USED("StockLst_SQL")
				ThisFormSet.frmBrowse.grdStockLst_SQL.RecordSource = ''
				USE IN StockLst_SQL
			ENDIF
			SELECT 0	
			
			cSQL = "SELECT * FROM dbo.StockLst_View WHERE LiveCheck = 1"
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_SQL')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_SQL')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_SQL")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_SQL")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC ,'StockLst_SQL')
			ELSE
				SELECT StockLst_SQL
				ThisFormSet.frmBrowse.grdStockLst_SQL.RecordSource = 'StockLst_SQL'
			ENDIF
			
			RETURN
		ENDIF
		
		PRIVATE cLocation, lHaveLocation
		lHaveLocation = .F.
		
		cLocation = ThisFormSet.frmSelect.cmbLocation.Value
		IF UPPER(cLocation) != "ALL"
			IF ThisFormSet.Lst = "StockLst"
				cSQL = "SELECT * FROM dbo.StockLst_View WHERE Location = '"+cLocation+"'" 
		*		cSQLmark = "UPDATE dbo.StockLst_View SET LiveCheck = 1 WHERE Location = '"+cLocation+"'" 
				cSQLmark = "UPDATE dbo.StockLst_Detail SET LiveCheck = 1 FROM dbo.StockLst_Master WHERE Location = '"+cLocation+"'" 
				cSQLmark = cSQLmark + " AND StockLst_Master.id = StockLst_Detail.id  "
			ELSE
				cSQL = "SELECT * FROM dbo.BrokerLst_View WHERE Location = '"+cLocation+"'" 
			ENDIF
			cSQL = cSQL + " ORDER BY alloy, form, size, cc, heat "
			*Return
			WAIT WINDOW "All items from Location selected!" NOWAIT 
			lHaveLocation = .T.
		ELSE
			*Continue with Other Options
		ENDIF
		
		IF NOT lHaveLocation
			PRIVATE nInvCheck 
			nInvCheck = 1 &&ThisFormSet.frmSelect.ogInvCheck.Value
			*nInvCheck 
			*1='Do not Use InvCheck
			*2='NotFound' list
			*3=Over a year Since 'Inv Check'
			*4=Order by InvCheck
		
			IF ThisFormSet.Lst = "StockLst"
				cSQL = "SELECT * FROM dbo.StockLst_View " 
				*cSQLmark = "UPDATE dbo.StockLst_View SET LiveCheck = 1 "
				cSQLmark = "UPDATE dbo.StockLst_Detail SET LiveCheck = 1 FROM dbo.stocklst_master "
			ELSE
				cSQL = "SELECT * FROM dbo.BrokerLst_View "
			ENDIF
		
			IF ThisFormSet.frmSelect.cmbAlloy.Value <> "All Alloys"
				lAddAlloy = .T.
			ENDIF
		
			IF ThisFormSet.frmSelect.chkFormAll.Value = 1
				*All Forms
				IF lAddAlloy 
					*No Form
					cSQL = cSQL + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"')"
					cSQLmark = cSQLmark + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"')"
					lAddWhere = .F.
				ELSE
					*No Alloy, No form
					cSQL = cSQL
					lAddWhere = .F.
				ENDIF
			ELSE
				IF ThisFormSet.frmSelect.chkFormBar.Value = 1
					IF lAddWhere 
						IF lAddAlloy 
							cSQL = cSQL + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='10' OR Form='11' OR Form='12' OR Form='13'))"
							cSQLmark = cSQLmark + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='10' OR Form='11' OR Form='12' OR Form='13'))"
						ELSE
							cSQL = cSQL + " WHERE (Form='10' OR Form='11' OR Form='12' OR Form='13')"
							cSQLmark = cSQLmark + " WHERE (Form='10' OR Form='11' OR Form='12' OR Form='13')"
						ENDIF
						lAddWhere = .F.
					ELSE
						IF lAddAlloy 
							cSQL = cSQL + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='10' OR Form='11' OR Form='12' OR Form='13'))"
							cSQLmark = cSQLmark + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='10' OR Form='11' OR Form='12' OR Form='13'))"
						ELSE
							cSQL = cSQL + " OR (Form='10' OR Form='11' OR Form='12' OR Form='13')"	
							cSQLmark = cSQLmark + " OR (Form='10' OR Form='11' OR Form='12' OR Form='13')"	
						ENDIF
					ENDIF
				ENDIF
				IF ThisFormSet.frmSelect.chkFormWire.Value = 1
					IF lAddWhere 
						IF lAddAlloy 
							cSQL = cSQL + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='20' OR Form='21' OR Form='30'))"	
							cSQLmark = cSQLmark + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='20' OR Form='21' OR Form='30'))"	
						ELSE
							cSQL = cSQL + " WHERE (Form='20' OR Form='21' OR Form='30')"	
							cSQLmark = cSQLmark + " WHERE (Form='20' OR Form='21' OR Form='30')"	
						ENDIF
						lAddWhere = .F.
					ELSE
						IF lAddAlloy 
							cSQL = cSQL + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"'  AND (Form='20' OR Form='21' OR Form='30'))"
							cSQLmark = cSQLmark + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"'  AND (Form='20' OR Form='21' OR Form='30'))"
						ELSE
							cSQL = cSQL + " OR (Form='20' OR Form='21' OR Form='30')"		
							cSQLmark = cSQLmark + " OR (Form='20' OR Form='21' OR Form='30')"		
						ENDIF
					ENDIF
				ENDIF
				IF ThisFormSet.frmSelect.chkFormPlate.Value = 1
					IF lAddWhere 
						IF lAddAlloy 
							cSQL = cSQL + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='40' OR Form='51' OR Form='52' OR Form='53' OR Form='80'))"	
							cSQLmark = cSQLmark + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='40' OR Form='51'  OR Form='52' OR Form='53' OR Form='80'))"	
						ELSE
							cSQL = cSQL + " WHERE (Form='40' OR Form='51' OR Form='52' OR Form='53' OR Form='80')"
							cSQLmark = cSQLmark + " WHERE (Form='40' OR Form='51' OR Form='52' OR Form='53' OR Form='80')"
						ENDIF
						lAddWhere = .F.
					ELSE
						IF lAddAlloy 
							cSQL = cSQL + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='40' OR Form='51' OR Form='52' OR Form='53' OR Form='80'))"
							cSQLmark = cSQLmark + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='40' OR Form='51' OR Form='52' OR Form='53' OR Form='80'))"
						ELSE
							cSQL = cSQL + " OR (Form='40' OR Form='51' OR Form='52' OR Form='53' OR Form='80')"
							cSQLmark = cSQLmark + " OR (Form='40' OR Form='51' OR Form='52' OR Form='53' OR Form='80')"
						ENDIF
					ENDIF
				ENDIF
				IF ThisFormSet.frmSelect.chkFormTube.Value = 1
					IF lAddWhere 
						IF lAddAlloy 
							cSQL = cSQL + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='60'))"	
							cSQLmark = cSQLmark + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='60'))"	
						ELSE
							cSQL = cSQL + " WHERE (Form='60')"
							cSQLmark = cSQLmark + " WHERE (Form='60')"
						ENDIF		
						lAddWhere = .F.
					ELSE
						IF lAddAlloy 
							cSQL = cSQL + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='60'))"
							cSQLmark = cSQLmark + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='60'))"
						ELSE
							cSQL = cSQL + " OR (Form='60')"
							cSQLmark = cSQLmark + " OR (Form='60')"
						ENDIF
					ENDIF
				ENDIF
				IF ThisFormSet.frmSelect.chkFormPipe.Value = 1 
					IF lAddWhere 
						IF lAddAlloy 
							cSQL = cSQL + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='65'))"	
							cSQLmark = cSQLmark + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='65'))"	
						ELSE
							cSQL = cSQL + " WHERE (Form='65')"
							cSQLmark = cSQLmark + " WHERE (Form='65')"
						ENDIF
						lAddWhere = .F.
					ELSE
						IF lAddAlloy 
							cSQL = cSQL + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='65'))"
							cSQLmark = cSQLmark + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='65'))"
						ELSE
							cSQL = cSQL + " OR (Form='65')"
							cSQLmark = cSQLmark + " OR (Form='65')"
						ENDIF
					ENDIF
				ENDIF
				IF ThisFormSet.frmSelect.chkFormFittings.Value = 1
					IF lAddWhere
						IF lAddAlloy 
							cSQL = cSQL + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='70' OR Form='71' OR Form='72' OR Form='73' OR Form='74'))"	
							cSQLmark = cSQLmark + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='70' OR Form='71' OR Form='72' OR Form='73' OR Form='74'))"	
						ELSE
							cSQL = cSQL + " WHERE (Form='70' OR Form='71' OR Form='72' OR Form='73' OR Form='74')"
							cSQLmark = cSQLmark + " WHERE (Form='70' OR Form='71' OR Form='72' OR Form='73' OR Form='74')"
						ENDIF
						lAddWhere = .F.
					ELSE
						IF lAddAlloy 
							cSQL = cSQL + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='70' OR Form='71' OR Form='72' OR Form='73' OR Form='74'))"
							cSQLmark = cSQLmark + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='70' OR Form='71' OR Form='72' OR Form='73' OR Form='74'))"
						ELSE
							cSQL = cSQL + " OR (Form='70' OR Form='71' OR Form='72' OR Form='73' OR Form='74')"
							cSQLmark = cSQLmark + " OR (Form='70' OR Form='71' OR Form='72' OR Form='73' OR Form='74')"
						ENDIF
					ENDIF
				ENDIF
				IF ThisFormSet.frmSelect.chkFormFasteners.Value = 1
					IF lAddWhere 
						IF lAddAlloy 
							cSQL = cSQL + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='75' OR  Form='90'))"	
							cSQLmark = cSQLmark + " WHERE (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='75' OR  Form='90'))"	
						ELSE
							cSQL = cSQL + " WHERE (Form='75' OR Form='90')"
							cSQLmark = cSQLmark + " WHERE (Form='75' OR Form='90')"
						ENDIF
						lAddWhere = .F.
					ELSE
						IF lAddAlloy 
							cSQL = cSQL + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='75' OR Form='90'))"
							cSQLmark = cSQLmark + " OR (Alloy = '"+ThisFormSet.frmSelect.cmbAlloy.Value+"' AND (Form='75' OR Form='90'))"
						ELSE
							cSQL = cSQL + " OR (Form='75' OR Form='90')"
							cSQLmark = cSQLmark + " OR (Form='75' OR Form='90')"
						ENDIf
					ENDIF
				ENDIF
			ENDIF
		
			PRIVATE cCC
			cCC = ThisFormSet.frmSelect.cmbCC.Value
			IF cCC != "0"
				IF " WHERE " $ cSQL
					cSQL = cSQL + " AND CC = '"+cCC+"'"
					cSQLmark = cSQLmark + " AND CC = '"+cCC+"'"
				ELSE
					cSQL = cSQL + " WHERE CC = '"+cCC+"'"
					cSQLmark = cSQLmark + " WHERE CC = '"+cCC+"'"
				ENDIF
			ENDIF
		
			PRIVATE nSizeMin
			nSizeMin = PrepareSQLnum(ThisFormSet.frmSelect.txtSQLMin.Value,'Size',9,3)
			IF NOT EMPTY(nSizeMin)
				IF nSizeMin > 0
					IF " WHERE " $ cSQL
						cSQL = cSQL + " AND Size >= "+STR(nSizeMin,14,3)
						cSQLmark = cSQLmark + " AND Size >= "+STR(nSizeMin,14,3)
					ELSE
						cSQL = cSQL + " WHERE  Size >= "+STR(nSizeMin,14,3)
						cSQLmark = cSQLmark + " WHERE  Size >= "+STR(nSizeMin,14,3)
					ENDIF
				ENDIF
			ENDIF
		
			PRIVATE nSizeMax
			nSizeMax = PrepareSQLnum(ThisFormSet.frmSelect.txtSQLMax.Value,'Size',9,3)
			IF NOT EMPTY(nSizeMax)
				IF nSizeMax > 0
					IF " WHERE " $ cSQL
						cSQL = cSQL + " AND Size <= "+STR(nSizeMax,14,3)
						cSQLmark = cSQLmark + " AND Size <= "+STR(nSizeMax,14,3)
					ELSE
						cSQL = cSQL + " WHERE  Size <= "+STR(nSizeMax,14,3)
						cSQLmark = cSQLmark + " WHERE  Size <= "+STR(nSizeMax,14,3)
					ENDIF
				ENDIF
			ENDIF
		
		
		
			PRIVATE lIgnoreCC, lSortLocation
			lIgnoreCC = ThisFormSet.frmSelect.chkIgnoreCC.Value
			lSortLocation = ThisFormSet.frmSelect.chkSortLocation.Value
			IF lSortLocation = 1
				IF lIgnoreCC = 1
					IF nInvCheck = 4
						cSQL = cSQL + " ORDER BY ISNULL(InvCheck,'1900-01-01'), alloy, form, Location, size, cc, heat "
					ELSE
						cSQL = cSQL + " ORDER BY alloy, form, Location, size, cc, heat "
					ENDIF
				ELSE
					IF nInvCheck = 4
						cSQL = cSQL + " ORDER BY ISNULL(InvCheck,'1900-01-01'), alloy, form, Location, cc, size, heat "
					ELSE
						cSQL = cSQL + " ORDER BY alloy, form, Location, cc, size, heat "
					ENDIF
				ENDIF
			ELSE	
				*Not Sorted by location
				IF lIgnoreCC = 1
					IF nInvCheck = 4
						cSQL = cSQL + " ORDER BY ISNULL(InvCheck,'1900-01-01'), alloy, form, size, cc, heat "
					ELSE
						cSQL = cSQL + " ORDER BY alloy, form, size, cc, heat "
					ENDIF
				ELSE
					IF nInvCheck = 4
						cSQL = cSQL + " ORDER BY ISNULL(InvCheck,'1900-01-01'), alloy, form, cc, size, heat "
					ELSE
						cSQL = cSQL + " ORDER BY alloy, form, cc, size, heat "
					ENDIF
				ENDIF
			ENDIF
		ENDIF &&lHaveLocation
		*RETURN cSQL
		
		IF NOT "WHERE" $ cSQL
			*Nothing was choosen to filter down records.
			IF MESSAGEBOX("Nothing was choosen to filter down records."+CHR(13)+"This is too many records!"+CHR(13)+"Do you want to continue anyway?",4+32,"Select All Records?") != 6
				RETURN
			ENDIF
		ENDIF
		
		**********************
		IF lMark 
		
		*!*		PRIVATE cMess1,cProgram,cMachine
		*!*		*? LEN("UPDATE dbo.StockLst_Detail SET LiveCheck = 1 FROM dbo.stocklst_master ")
		*!*		cMess1		= RIGHT(cSQLmark,LEN(cSQLmark)-70)
		*!*		cProgram	= "StockLst_Inv_Check"
		*!*		cMachine	= LEFT(SYS(0),AT('#',SYS(0))-2)
		*!*		
		*!*		*Do not INSERT into dbo.NR_UserTrack Direct, let HPAlloy trigger add ServerName!
		*!*		cSQLInsert = "INSERT INTO dbo.UserTrack (mess1,cprogram,machine) VALUES ("
		*!*		cSQLInsert=cSQLInsert+"'"+PrepareSQLtxt(cMess1,'cMess1',-1)+"'"
		*!*		cSQLInsert=cSQLInsert+",'"+cProgram+"'"
		*!*		cSQLInsert=cSQLInsert+",'"+cMachine+"')"
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLInsert )
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLInsert )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*		*****************************
		*!*		
		*!*		cSQLmark = cSQLmark + " AND StockLst_Master.id = StockLst_Detail.id"
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLmark )
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLmark )
		*!*		ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
			TrackMess(cSQLmark)
		ENDIF
		**********************
		
		IF USED("StockLst_SQL")
			SELECT StockLst_SQL
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_SQL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_SQL')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_SQL")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_SQL")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC ,'StockLst_SQL')
		ELSE
			SELECT StockLst_SQL
		ENDIF
		
		IF NOT lMark
			BROWSE IN SCREEN
			USE IN StockLst_SQL
		ENDIF
	ENDPROC

