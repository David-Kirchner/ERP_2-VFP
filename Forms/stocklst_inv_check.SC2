	PROCEDURE frmSelect.cmbAlloy.Init
		#DEFINE ALLAlloy_LOC "All Alloys"
		this.clear
		this.additem(ALLAlloy_LOC) 
		
		LOCAL aAlloys,cAlloy
		DIMENSION aAlloys[1]
		
		PRIVATE cSQL
		PRIVATE nSQLEXEC
		
		cSQL ="SELECT DISTINCT Alloy FROM dbo.StockLst_Master ORDER BY Alloy"
		
		IF USED('StockLst_Master_a')
			USE IN StockLst_Master_a
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Master_A')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Master_A')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Master_A")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Master_A")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC ,'StockLst_Master_A')
		ELSE
		
			SELECT DISTINCT alloy FROM StockLst_Master_A WHERE !EMPTY(alloy) INTO array aAlloys
		
			FOR EACH m.cAlloy IN aAlloys
				IF !EMPTY(m.cAlloy)
					this.additem(m.cAlloy)
				ENDIF
			ENDFOR
		
			*THIS.VALUE = ALLAlloy_LOC
			*THIS.VALUE = aAlloys(1)
		
		ENDIF
		
		IF USED('StockLst_Master_a')
			USE IN StockLst_Master_a
		ENDIF
		
		THIS.VALUE = ALLAlloy_LOC
		*ThisForm.DispAlloyFilter=aAlloys(1)
		
		
		
		
	ENDPROC

	PROCEDURE frmSelect.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "0"
		aConditionCode(1,2) = "ALL"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		
		nLoopCount = 1
		this.addListitem("0",nLoopCount,1)
		this.addListitem("All Conditions",nLoopCount,2)
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount+1,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount+1,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Value = "0"
		
	ENDPROC

	PROCEDURE frmSelect.cmbLocation.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpLocation')
			SELECT tmpLocation
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT DISTINCT Location FROM dbo.StockLst_Detail WHERE NOT ( Location LIKE '%&%' OR Location LIKE '%/%' OR Location LIKE '%,%') ORDER BY Location"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpLocation')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpLocation')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpLocation")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpLocation")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpLocation')
		ENDIF
		DIMENSION aLocation[1]
		aLocation(1) = "ALL"
		
		IF USED('tmpLocation')
			SELECT * FROM tmpLocation WHERE !EMPTY(Location) INTO ARRAY aLocation
			
			USE IN tmpLocation
		ENDIF
		
		This.ColumnCount = 1
		This.NumberOfElements=ALEN(aLocation)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		
		nLoopCount = 1
		this.addListitem("All",nLoopCount,1)
		
		FOR EACH cc1 IN aLocation
			IF !EMPTY(cc1)
				this.addListitem(ALLTRIM(cc1),nLoopCount+1)
				nLoopCount = nLoopCount + 1
			ENDIF
		ENDFOR
		
		This.Value = "All"
		
	ENDPROC

