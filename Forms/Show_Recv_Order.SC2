		RETURN .T.
		
		
	ENDPROC

	PROCEDURE receivingsaveid_master
		PARAMETERS pReceivingID, pSOitem, pPOitem, cHeat, nPC_Recv, nRMA, nRcv_HPA_QTY
		*PARAMETERS pReceivingID, pSOitem, pPOitem, nWO_Detail, cHeat, nPC_Recv, nRMA, nRcv_HPA_QTY
		*ThisForm.ReceivingSaveID_Master( nReceivingID, cSOitem, cPOitem, cHeat, nPC_Recv, nRMA )
		
		***Update ID_Master and StockTable in Receiving
		*a new receive should not have stock marked!
		*RecordID_Master to Receiving.
		
			
		IF VARTYPE(pReceivingID) != "N"
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisForm.nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisForm.nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		IF pReceivingID < 1
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisForm.nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisForm.nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(pReceivingID,'ReceivingID',-3)
		
		IF VARTYPE(pSOitem) != "C"
			pSOitem = ""
		ENDIF
		
		IF VARTYPE(pPOitem) != "C"
			pPOitem = ""
		ENDIF
		IF pSOitem = Proper_SO_Item("")
			pSOitem = ''
		ENDIF
		
		*IF VARTYPE(nWO_Detail) != "N"
		*	nWO_Detail = 0
		*ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem)
			MESSAGEBOX("No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)" )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPC_Recv) != "N"
			nPC_Recv = 0
		ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem) AND EMPTY(ThisForm.nWO_Detail)
			MESSAGEBOX("No SO, PO, or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, ThisForm.nWO_Detail)",0,"Parameter Error")
			TrackError("Parameter Error","No SO, PO or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, ThisForm.nWO_Detail)",PROGRAM(),LINENO(1) )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPC_Recv) != "N"
			nPC_Recv = 0
		ENDIF
		
		IF VARTYPE(nRMA) != "N"
			nRMA = 0
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC 
		
		**Find StockLst or BrokerLst and store ID to Receiving
		*Check for Process
		
		PRIVATE nID, nID_Detail, nID_Detail_Process
		nID			= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		ThisForm.cTBL	= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		
		***********************************
		PRIVATE nTableID_Master, nTableID_Detail
		nTableID_Master = 0
		nTableID_Detail = 0
		
		********
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" )
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableName_ReceivingID("+STR(nReceivingID)+") AS TblName"  &&Returns Init
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						SCAN
							IF EMPTY(PrepareSQLtxt(tmpTable.TblName,'TblName',1))
								LOOP
							ELSE
								ThisForm.cTBL = PrepareSQLtxt(tmpTable.TblName,'TblName',1)
								ThisForm.txtTBL.Value = ThisForm.cTBL
								EXIT
							ENDIF
						ENDSCAN
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ENDIF
		
		********
		
		IF nID_Detail < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_Detail_ReceivingID("+STR(nReceivingID)+") AS TableID_Detail"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
		
					IF RECCOUNT('tmpTable') > 0
						nTableID_Detail = PrepareSQLnum(tmpTable.TableID_Detail,'TableID_Detail',-3)
						ThisForm.txtID_Detail.Value = nTableID_Detail 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Detail = nID_Detail
		ENDIF
		
		***********************************
		
		
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" ) AND nID_Detail > 0
		
			*try for TBL using 'Listing created from %'
			IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" )
				IF nID > 0 AND nID_Detail > 0
					*Find TBL
					IF USED("tmpTBL")
						USE IN tmpTBL
					ENDIF
					SELECT 0
					
					cSQL =        " SELECT 'S' AS TBL"	
					cSQL = cSQL + " FROM dbo.StockLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'B' AS TBL"	
					cSQL = cSQL + " FROM dbo.BrokerLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'W' AS TBL"	
					cSQL = cSQL + " FROM dbo.WIPLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
					ELSE
						IF USED('tmpTBL')
		
							IF RECCOUNT('tmpTBL') > 0
								ThisForm.cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							ENDIF
							USE IN 'tmpTBL'
						ENDIF
					ENDIF
				ENDIF	
			ENDIF
		
		ENDIF
		
		***********************************
		
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" ) AND nID_Detail > 0	
			&&*Process is updated with ReceivingId, not Set _Detail with ReceivingId
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Detail "
			CASE ThisForm.cTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Detail "
			CASE ThisForm.cTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
			
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		********
		
		IF nID < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_ReceivingID("+STR(nReceivingID)+") AS TableID"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						nTableID_Master = PrepareSQLnum(tmpTable.TableID,'TableID',-3)
						ThisForm.txtID_Master.Value = nTableID_Master 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Master = nID
		ENDIF
		
		
		***********************************
		
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			IF nTableID_Master = 0
				IF nRMA = 0
					IF ThisForm.nWO_Detail > 0
						*Consider a WO_Detail for Stock.
						ThisForm.cTBL = 'S'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************************
		*recheck for ID,ID_Detail, ID_Detail_Process by POitem
		PRIVATE lFoundProcess
		lFoundProcess = .F.
		
		IF Proper_PO_Item(pPOitem) != Proper_PO_Item('')
			IF nID = 0 AND nID_Detail = 0 AND nID_Detail_Process = 0
			
				*Check for a Process with that SOitem\WO_Detail and Heat
				nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"S",cHeat,ThisForm.nConnhandle)
				IF nID_Detail_Process = 0
					*Try Broker
					nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"B",cHeat,ThisForm.nConnhandle)
					IF nID_Detail_Process > 0
						ThisForm.cTBL = "B"
					ELSE
					
						*Try WIP WO_Detail
						nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(ThisForm.nWO_Detail,"W",cHeat,ThisForm.nConnhandle)
						IF nID_Detail_Process > 0
							ThisForm.cTBL = "W"
						ELSE
						
							*Try S WO_Detail
							nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(ThisForm.nWO_Detail,"S",cHeat,ThisForm.nConnhandle)
							IF nID_Detail_Process > 0
								ThisForm.cTBL = "S"
							ELSE
								*Try B WO_Detail
								nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(ThisForm.nWO_Detail,"B",cHeat,ThisForm.nConnhandle)
								IF nID_Detail_Process > 0
									ThisForm.cTBL = "B"
								ELSE
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ELSE
					ThisForm.cTBL = "S"
				ENDIF
				
				IF nID_Detail_Process > 0
					*FOUND IT, Get ID_Detail, ID
					DO CASE
					CASE ThisForm.cTBL = "S"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, ThisForm.cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, ThisForm.cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF
					CASE ThisForm.cTBL = "B"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, ThisForm.cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, ThisForm.cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF			
					CASE ThisForm.cTBL = "W"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, ThisForm.cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, ThisForm.cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF				
					ENDCASE
					
					IF lFoundProcess
						ThisForm.txtID_Master.Value = nID
						nTableID_Master = nID
						ThisForm.txtID_Detail.Value = nID_Detail
						nTableID_Detail = nID_Detail
						ThisForm.txtID_Detail_Process.Value = nID_Detail_Process
						ThisForm.txtTBL.Value = ThisForm.cTBL
					
						ThisForm.Stocklst_ID		= nTableID_Master 
						ThisForm.Stocklst_ID_Detail	= nTableID_Detail 
						ThisForm.StockLst_TBL		= UPPER(ThisForm.cTBL)
					ENDIF
				ELSE
					*ADD to Stock?		
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Recheck for TBL
		IF ThisForm.cTBL!= "S" AND ThisForm.cTBL!= "B" AND ThisForm.cTBL!= "W" 
			IF nID > 0 AND nID_Detail > 0
				*Find TBL
				
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				SELECT 0
				cSQL =        " SELECT 'S' AS TBL"	
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'B' AS TBL"	
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'W' AS TBL"	
				cSQL = cSQL + " FROM dbo.WIPLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
		
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
		
						IF RECCOUNT('tmpTBL') > 0
							ThisForm.cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
		*					TrackError("Found ID and ID_Detail in table '"+ThisForm.cTBL+"'.","Change in TBL!",PROGRAM(),LINENO(1))
						ELSE
							PRIVAT cMess
							cMess = "Stocklst ID = "+STR(nID)+CHR(13)
							cMess = cMess +"Stocklst ID_Detail = "+STR(nID_Detail)+CHR(13)
							cMess = cMess +"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +"TBL Could not be Identified"
							TrackError(cMess,"No TBL!",PROGRAM(),LINENO(1))
							
						ENDIF
						USE IN 'tmpTBL'
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		***********************************
		*Get nID_Detail_Process 
		
		IF nID > 0 AND nID_Detail > 0 AND nID_Detail_Process = 0
			IF ThisForm.cTBL!= "S" AND ThisForm.cTBL!= "B" AND ThisForm.cTBL!= "W" 
				IF USED("tmpID_D_P")
					USE IN tmpID_D_P
				ENDIF
				SELECT 0
				cSQL = " SELECT * FROM "	
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Process "
				CASE ThisForm.cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Process "
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL + " dbo.WIPLst_Process "
				ENDCASE
				cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
				IF nReceivingID > 0
					cSQL = cSQL + " AND ReceivingID = "+STR(nReceivingID)
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_D_P')
				ELSE
					IF USED('tmpID_D_P')
		
						IF RECCOUNT('tmpID_D_P') > 0
							SCAN
								nID_Detail_Process = PrepareSQLnum(tmpID_D_P.ID_Detail_Process,'ID_Detail_Process',-3)
							ENDSCAN
						ENDIF
						
						USE IN tmpID_D_P
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Create Receive Process if have Table, ID_Detail AND no ID_Detail_Proc, BUT not found in History!
		IF nID_Detail_Process = 0
			IF NOT EMPTY(ThisForm.cTBL)
				IF nTableID_Detail > 0
					*Add a Receiving record to History, Only one that shows the ReceivingID
					THISFORM.Create_Receive_Process(ThisForm.cTBL,nTableID_Detail,pSOitem,pPOitem,nReceivingID, nRcv_HPA_QTY, nID_Detail_Process)
				ENDIF
			ENDIF		
		ENDIF
		
		
		***********************************
		IF nID_Detail_Process > 0 AND nReceivingID > 0
			IF NOT EMPTY(ThisForm.cTBL)
				*Update Process with ReceivingID
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Process SET"
				CASE ThisForm.cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Process SET"
				CASE ThisForm.cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Process SET"
				ENDCASE
				cSQLu = cSQLu +" ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail_Process = "+STR(nID_Detail_Process )
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update"+CHR(13)+"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		
		***********************************
		IF nID_Detail > 0
			IF NOT EMPTY(ThisForm.cTBL)
				*Update Detail with Receiving ID
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Detail "
				CASE ThisForm.cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Detail "
				CASE ThisForm.cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Detail "
				ENDCASE
				cSQLu = cSQLu +" SET ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail = "+STR(nID_Detail )
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"Could not update" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		***********************************
		
		IF nTableID_Master > 0
			IF NOT EMPTY(ThisForm.cTBL)
				*Check for Heat match
				
				IF USED("tmpMasterHeat")
					USE IN tmpMasterHeat
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS CTND "
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL +" FROM dbo.StockLst_Master "
				CASE ThisForm.cTBL = "B"
					cSQL = cSQL +" FROM dbo.BrokerLst_Master "
				CASE ThisForm.cTBL = "W"
					cSQL = cSQL +" FROM dbo.WIPLst_Master "
				ENDCASE
				cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
				cSQL = cSQL +" AND Heat = '"+cHeat+"'"
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterHeat')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterHeat")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterHeat")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMasterHeat')
				ELSE
					IF USED('tmpMasterHeat')
						IF VARTYPE(tmpMasterHeat.CTND)='N'
							*********
							IF tmpMasterHeat.CTND = 0			
								*Did not Find Correct Heat!
								*look for 'Due in'
								
								IF USED("tmpMasterDueIn")
									USE IN tmpMasterDueIn
								ENDIF
								
								cSQL = "SELECT COUNT(*) AS CTND "
								DO CASE
								CASE ThisForm.cTBL = "S"
									cSQL = cSQL +" FROM dbo.StockLst_Master "
								CASE ThisForm.cTBL = "B"
									cSQL = cSQL +" FROM dbo.BrokerLst_Master "
								CASE ThisForm.cTBL = "W"
									cSQL = cSQL +" FROM dbo.WIPLst_Master "
								ENDCASE
								cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
								cSQL = cSQL +" AND Heat = 'DUE IN'" 
		
								SELECT 0
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterDueIn')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterDueIn')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterDueIn")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterDueIn")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMasterDueIn')
								ELSE
									IF USED('tmpMasterDueIn')
										IF VARTYPE(tmpMasterDueIn.CTND)='N'
											IF tmpMasterDueIn.CTND = 0
												*Did not Find Correct Heat or 'Due In'!
												nTableID_Master = 0
											ENDIF
										ENDIF
										USE IN tmpMasterDueIn
									ENDIF				
								ENDIF
							*********					
							ENDIF
						ENDIF
						USE IN tmpMasterHeat
					ENDIF				
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		
		PRIVATE lSaved
		lSaved = .F.
		
		IF nTableID_Master = 0
			IF nID > 0
				nTableID_Master = nID
			ENDIF
			IF nID_Master > 0
				nTableID_Master = nID_Master
			ENDIF	
		ENDIF
		
		IF nTableID_Master > 0
			
			cSQLu = "UPDATE dbo.Receiving SET"
			cSQLu = cSQLu +" ID_Master = "+STR(nTableID_Master)+""
			cSQLu = cSQLu +",ID_Detail = "+STR(nID_Detail)+""
			cSQLu = cSQLu +",StockTable = '"+ThisForm.cTBL+"'"
			cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not update dbo.Receiving" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
			ELSE 
				lSaved = .T.
			ENDIF
		ELSE
			lSaved = .F.
		
		*	PRIVATE cText
		*	cText = "Not in StockLst or BrokerLst!"+CHR(13)+"Did not save StockLst ID to Receiving table! No ID_Master for StockTable = '"+ThisForm.cTBL+"' AND Receiving ID = "+STR(nReceivingID)
		*	MESSAGEBOX( cText ,0+48,"ReceivingID "+ALLTRIM(STR(nReceivingID)) )
		*	TrackMess(cText)
		ENDIF
		
		***********************************
		
		IF nTableID_Master > 0
			IF NOT ( ThisForm.Stocklst_ID = nTableID_Master AND ThisForm.Stocklst_ID_Detail = nTableID_Detail AND ThisForm.StockLst_TBL = UPPER(ThisForm.cTBL) )
				IF EMPTY(ThisForm.cTBL) OR ThisForm.Stocklst_ID>0
					PRIVAT cMess
					cMess = "Stocklst_ID = "+STR(ThisForm.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
					cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisForm.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
					cMess = cMess +"StockLst_TBL = '"+ThisForm.StockLst_TBL+"' 		TBL1 = '"+UPPER(ThisForm.cTBL)+"'"+CHR(13)
					cMess = cMess +"ReceivingID="+STR(nReceivingID)
					TrackError(cMess,"Change in ID, ID_Detail, or TBL!",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
			
			IF ThisForm.Stocklst_ID = 0
				ThisForm.Stocklst_ID		= nTableID_Master 
				ThisForm.Stocklst_ID_Detail	= nTableID_Detail 
				*ThisForm.ID_Detail_process
			ENDIF
		ENDIF
		
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" )
			IF ThisForm.Stocklst_ID > 0 AND ThisForm.Stocklst_ID_Detail > 0
			
				*What Table has ID and ID_Detail combo
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				
				cSQL = "SELECT 'S' AS TBL FROM dbo.Stocklst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID) 
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'B' AS TBL FROM dbo.BrokerLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'W' AS TBL FROM dbo.WIPLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
						IF RECCOUNT('tmpTBL')>0
							ThisForm.cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							PRIVAT cMess
							cMess = "Stocklst_ID = "+STR(ThisForm.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
							cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisForm.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
							cMess = cMess +"StockLst_TBL = '"+ThisForm.StockLst_TBL+"' 		TBL1 = ''"
							cMess = cMess +CHR(13)+"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +CHR(13)+"TBL1 now= '"+UPPER(ThisForm.cTBL)+"'"
		*					TrackError(cMess+CHR(13)+CHR(13)+cSQL,"Change TBL!",PROGRAM(),LINENO(1))
						ENDIF
						USE IN tmpTBL
					ENDIF
				ENDIF	
			ENDIF
		ENDIF
		
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" )
			*Found a TBL, Show it on screen
			ThisForm.StockLst_TBL = UPPER(ThisForm.cTBL)
			ThisForm.txtTBL.Value = UPPER(ThisForm.cTBL)
			ThisForm.txtTBL.Refresh
		ENDIF
		
		IF USED('Receiving')
			SELECT Receiving
		ENDIF
		
		RETURN lSaved
	ENDPROC

	PROCEDURE settowod
		*SetToWOD()
		This.Caption = "Show Received Vs Produced"
		
		ThisForm.cmdCancel.Caption = "Stop, Receive does not match Produced!"
		ThisForm.cmdGood.Caption = "Good, Receive matches WOD,  ** but NOT Complete **"
		ThisForm.cmdGoodCmplt.Caption = "Good, Receive matches WOD and COMPLETES the WO Detail!"
		thisform.lblPOitem.Caption = "WO Detail"
		
		
		*!*	*SetToPOitem
		*!*	This.Caption = "Show Received Vs Ordered"
		
		*!*	ThisForm.cmdCancel.Caption = "Stop, Receive does not match Ordered!"
		*!*	ThisForm.cmdGood.Caption = "Good, Receive matches PO,  ** but NOT Complete **"
		*!*	ThisForm.cmdGoodCmplt.Caption = "Good, Receive matches PO and COMPLETES the PO Item!"
		*!*	thisform.lblPOitem.Caption = "PO item"
		
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpReceive')	
			USE IN tmpReceive
		ENDIF
		
		
		RETURN ThisForm.nReturn
	ENDPROC

	PROCEDURE updateprocess
		PARAMETERS nID_Detail_Process, nReceivingID 
		*ThisForm.UpdateProcess(nID_Detail_Process, ThisForm.cTBL, ThisForm.nReceivingID )
		cSQL = " UPDATE "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		ENDCASE
		cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
			RETURN .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE update_incoming_process
		PARAMETERS nNewTBL, nNewID, nNewID_Detail, nOld_ID, nOld_ID_Detail
		*ThisForm.Update_Incoming_Process()
		*Updates the Incomming process with the new Edit data
		
		IF VARTYPE(nNewTBL)!="C"
			nNewTBL = ThisForm.cTBL
		ENDIF
		IF VARTYPE(nNewTBL)!="C"
			TrackError("Receiving:Receiving_Create_Incoming_Process(cTBL:NO TABLE ,nID_Detail:"+STR(nID_Detail)+",nPounds"+")" ,"bad variable",PROGRAM(),LINENO(1))
			ThisForm.cTBL = ""
			RETURN .F.
		ENDIF
		
		PRIVATE cSOitem,cPOitem
		cSOitem = Proper_SO_item(ThisForm.cSOitem)
		cPOitem = Proper_PO_item(ThisForm.cPOitem)
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisForm.nReceivingID,'ReceivingID',-3)
		
		IF nNewTBL = "N"
			TrackMess("Receiving:Receiving_Create_Incoming_Process(cTBL :"+nNewTBL +",nID_Detail:"+STR(nID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+")" )
			RETURN .F.
		ENDIF
		
		IF nID_Detail = 0
			*nID_Detail = get_ID_Detail_with_SOitem(cSOitem, nNewTBL, "", ThisForm.nConnHandle)
			TrackMess("Show Received VS Ordered:Create_Incoming_Process(cTBL:"+nNewTBL+",nID_Detail:"+STR(nID_Detail)+",cSOitem:"+cSOitem+",pPOitem:"+cPOitem+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
			RETURN .F.
		ENDIF
		
		IF nReceivingID < 1
			*need ReceivingID
			*POitem is too vague
			RETURN .F.
		ENDIF
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE cPrc_Form, nPU, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nPU 		= nPU_Acct_Form(cPrc_Form ,ThisForm.nConnHandle)
		nPrc_PCs	= PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC',-3)
		nPrc_Dim1	= PrepareSQLnum(ThisForm.txtThck.Value,'DIM1',10,4)
		nPrc_Dim2	= PrepareSQLnum(ThisForm.txtSz2.Value,'DIM2',9,3)
		nPrc_Dim3	= PrepareSQLnum(ThisForm.txtSz3.Value,'DIM3',9,3)
		
		PRIVATE nPrc_Q_QTY, nPrc_Q_PU, nOrdered_QTY, nOrdered_P
		nPrc_Q_QTY = 0
		nPrc_Q_PU = nPU_Acct_Form(cPrc_Form ,ThisForm.nConnHandle)
		IF ThisForm.nWO_Detail > 0
			nOrdered_QTY = Get_From_WO_Detail(ThisForm.nWO_Detail,'fWeight',ThisForm.nConnHandle)
			nOrdered_P = 0
		ENDIF
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			nOrdered_QTY = Get_From_POitem(cPOitem, "StockLst_QTY", ThisForm.nConnHandle )
			nOrdered_P = Get_From_POitem(cPOitem, "StockLst_P", ThisForm.nConnHandle )
		ENDIF
		
		PRIVATE nQTY_Need, nLBS_Need, nPC_Need
		nQTY_Need	= PrepareSQLnum(ThisForm.txtQTY_Need.Value,'QTY',-5)
		nLBS_Need	= PrepareSQLnum(ThisForm.txtLBS_Need.Value,'Pounds',8,1)
		nPC_Need	= PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC',-3)
		
		PRIVATE nPast_QTY, nPast_LBS, nPast_PCs
		nPast_QTY	= PrepareSQLnum(ThisForm.txtPast_QTY.Value,'QTY',-5)
		nPast_LBS	= PrepareSQLnum(ThisForm.txtPast_LBS.Value,'Pounds',8,1)
		nPast_PCs	= PrepareSQLnum(ThisForm.txtPast_PC.Value,'PC',-3)
		
		PRIVATE nQTY_Recv, nLBS_Recv, nPC_Recv
		nQTY_Recv	= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'QTY',-5)
		nLBS_Recv	= PrepareSQLnum(ThisForm.txtActualW.Value,'Pounds',8,1)
		nPC_Recv	= PrepareSQLnum(ThisForm.txtPC_Recv.Value,'PC',-3)
		
		PRIVATE cSalesPerson, dtStartDate, dDueDate
		cSalesPerson = PrepareSQLtxt( AppSetup_Get_UserName( getSalesP_POitem( cPOitem, ThisForm.nConnHandle )),'SalesPerson', 20)
		dtStartDate = DATE()
		dDueDate = GetNewDueDate( cPOItem, ThisForm.nConnHandle )
		*dDueDate = Get_From_Purchase_POitem (cPOitem, "Field", ThisForm.nConnHandle )
		
		PRIVATE cProcessor, cComment
		cProcessor = RIGHT( SYS(0) ,LEN(SYS(0))-AT("#",SYS(0))-1 )	&&cUserName 
		cComment = "ReceivingID = "+ALLTRIM(STR(nReceivingID))+" ran on "+DTOC(DATE())
		
		**********************
		*INSERT an 'RECEIVED' Process first with the NEW data for New ID_Detail\Receive
		*-- call it Received so it will be automatically deleted.
		**
		PRIVATE cSQLi
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		cSQLi = "EXEC dbo.p_Lst_Process_ins "
		cSQLi = cSQLi + " @TBL = '"+nNewTBL+"'"
		cSQLi = cSQLi + ",@ID_Detail ="+STR(nNewID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@Startdate = '"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = 'N'"	&&+cAllowSub+"'"   &&Incoming is not allowed to SUB
		
		cSQLi = cSQLi + ",@PU	= "+STR(nPU)
		cSQLi = cSQLi + ",@QTY	= "+STR(nQTY_Recv,18,4)
		cSQLi = cSQLi + ",@Pounds ="+STR(nLBS_Recv,9,1)
		
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		cSQLi = cSQLi + ",@WO 	= "+STR(0)
		cSQLi = cSQLi + ",@WO_Detail= "+STR(ThisForm.nWO_Detail)
		
		cSQLi = cSQLi + ",@Process_ID = 'RECEIVED'"	&&+cProcess_ID+"'"  
		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID) 
		
		cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
		cSQLi = cSQLi + ",@Prc_PCs = "+STR(nPC_Recv)
		cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
		cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
		cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
		cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nOrdered_QTY,18,4)
		cSQLi = cSQLi + ",@Ordered_P = "+STR(nOrdered_P,18,4)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
			lOK=.F.
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.EXP,'ID_Detail_Process',-3)
				IF nID_Detail_Process > 0
		
					PRIVATE cText
					cText = "INFO: Created RECEIVED Process "+STR(nID_Detail_Process)+" Show_Recv_Order.Create_Incoming_Process "+" StockTable="+ThisForm.cTBL+CHR(13)
					IF Proper_PO_item(cPOitem)<>Proper_PO_item("")
						cText = cText +" PO item="+cPOitem
					ENDIF
					IF ThisForm.nWO_Detail > 0
						cText = cText +" WO Detail="+ALLTRIM(STR(ThisForm.nWO_Detail))
					ENDIF
					*cText = cText +" Process_ID = '"+cProcess_ID+"'"  
					*MESSAGEBOX( cText,0+48,"INFO: Updated Balance of INCOMING Process After ReceivingID "+ALLTRIM(STR(nReceivingID)) )
					TrackMess(cText)
				ENDIF
		
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		
		****************************************************************
		*Edit The old Incoming a Received!
		*"Updated Balance of INCOMING Process After ReceivingID "+ALLTRIM(STR(nReceivingID)) )
		
		PRIVATE nID_Detail_Prc
		**Check for ID of INCOMING Process 
		nID_Detail_Prc = Get_ID_Detail_Prc_by_ID_Detail(nOld_ID_Detail,ThisForm.cTBL,'INCOMING',ThisForm.nConnHandle)
		
		IF nID_Detail_Prc > 0
			cSQL = " UPDATE "
			DO CASE
			CASE nNewTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Process "
			CASE nNewTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Process "
			CASE nNewTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Process "
			ENDCASE
			cSQL = cSQL + " SET QTY = "+STR(nQTY_Need,18,4)
			cSQL = cSQL + ",Pounds = "+STR(nLBS_Need,9,1)
			cSQL = cSQL + ",Prc_PCs ="+STR(nPC_Need)	&&nPrc_PCs
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nOld_ID_Detail)
			cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PartRecv' )"
			cSQL = cSQL + " AND ReceivingID = 0"
		ELSE
		
			cSQL = " INSERT INTO "
			DO CASE
			CASE nNewTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Process "
			CASE nNewTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Process "
			CASE nNewTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Process "
			ENDCASE
			cSQL= cSQL + " (SOitem,PO_item,SalesPerson,Startdate,DueDate,Comment     "
			cSQL= cSQL + ",[Process_ID],Processor,AllowSub,PU,QTY,Ordered_QTY,Ordered_P,Pounds "
			cSQL= cSQL + ",ID_Detail ,WO,WO_Detail"
			cSQL= cSQL + ",Prc_Form ,Prc_PCs,Prc_Dim1 ,Prc_Dim2,Prc_Dim3 ,Prc_Q_QTY ,Prc_Q_PU "
			
			cSQL= cSQL + " ) VALUES ("
			cSQL= cSQL + "'"+cSOitem+"'"
			cSQL= cSQL + ",'"+cPoItem+"'"
			cSQL= cSQL + ",'"+cSalesPerson+"'"
			cSQL= cSQL + ",'"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"	
			cSQL= cSQL + ",'"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQL= cSQL + ",'Revised INCOMING'"	
			
			cSQL= cSQL + ",'INCOMING'" 
			cSQL= cSQL + ",'"+LEFT( "Part Rcv "+RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) ,20)+"'"
			cSQL= cSQL + ",'N'"	&&+cAllowSub+"'"   &&Incoming is not allowed to SUB	
			cSQL= cSQL + ","+STR(nPU)
		
			cSQL= cSQL + ","+STR(nQTY_Need,18,4)
			cSQL= cSQL + ","+STR(nOrdered_QTY,18,4)
			cSQL= cSQL + ","+STR(nOrdered_P,18,4)
			cSQL= cSQL + ","+STR(nLBS_Need,9,1)
			cSQL= cSQL + ","+STR(nNewID_Detail)+""
			cSQL= cSQL + ",0"
			cSQL= cSQL + ","+STR(ThisForm.nWO_Detail)
		
			cSQL = cSQL + ",'"+cPrc_Form+"'"
			cSQL = cSQL + ","+STR(nPC_Need)	&&nPrc_PCs
		
			cSQL = cSQL + ", "+STR(nPrc_Dim1,10,4)
			cSQL = cSQL + ", "+STR(nPrc_Dim2,9,3)
			cSQL = cSQL + ", "+STR(nPrc_Dim3,9,3)
			cSQL = cSQL + ", "+STR(nQTY_Need,18,4)
			cSQL = cSQL + ", "+STR(nPrc_Q_PU)
			cSQL = cSQL + " )"
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
						lOK = .F.
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
			lOK = .F.
		ENDIF
		
		IF lOK 
			*UPDATE old_ID_Detail set Receiving = 0
			*Clean old style if found
			cSQL = " UPDATE "
			DO CASE
			CASE nNewTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail "
			CASE nNewTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail "
			CASE nNewTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " SET ReceivingID=0"
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nOld_ID_Detail)
			cSQL = cSQL + " AND ISNULL(ReceivingID,0)>0 "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
							lOK = .F.
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				*lOK = .F.
			ENDIF
		ENDIF
		
		RETURN lOK
		
		
	ENDPROC

	PROCEDURE update_postatus
		PARAMETERS lCmplt_the_Prc
		*ThisForm.Update_POStatus()
		
		IF VARTYPE(lCmplt_the_Prc) <> "L"
			lCmplt_the_Prc = .T.
		ENDIF
		*Check POStatus
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpPOStat')	
			USE IN tmpPOStat
		ENDIF
		
		cSQL = 		  " SELECT M.POStatus, 'S' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.StockLst_Master M  WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF ThisForm.nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisForm.nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
		IF ThisForm.nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(ThisForm.nReceivingID)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'B' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF ThisForm.nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisForm.nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
		IF ThisForm.nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(ThisForm.nReceivingID)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'W' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF ThisForm.nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisForm.nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
		IF ThisForm.nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(ThisForm.nReceivingID)
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOStat')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOStat')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOStat")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOStat")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOStat')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		
		PRIVATE lDueIn, lPartialReceive, lWaitingforBill, lAccountedfor
		lDueIn = .F.
		lPartialReceive = .F.
		lWaitingforBill = .F.
		lAccountedfor = .F.
		
		PRIVATE nMess,  nReceivingID2, cPOStatusText
		nMess = 0
		
		nReceivingID2 = 0
		cPOStatusText = ''
		
		***************************************
		
		IF USED('tmpPOStat')	
			IF RECCOUNT('tmpPOStat') > 0
			
				DO CASE
				CASE tmpPOStat.TBL = 'S'
					ThisForm.cTBL = "S"
				CASE tmpPOStat.TBL = 'B'
					ThisForm.cTBL = "B"
				CASE tmpPOStat.TBL = 'W'
					ThisForm.cTBL = "W"
				OTHERWISE
					TrackError(cSQL,"Could not find TBL.",PROGRAM(),LINENO(1) )
					ThisForm.cTBL = "N"
				ENDCASE
				
				SCAN
					
					cPOStatus	= PrepareSQLtxt(tmpPOstat.POStatus,'POStatus',1)
					
					DO CASE
					CASE cPOStatus = "D"	
						cPOStatusText = "DUE IN" && INCOMING
						lDueIn = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "P"	
						cPOStatusText = "Partial Receive" && "PARTRECV"
						lPartialReceive = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "W"	
						cPOStatusText = "Waiting for Bill"
						lWaitingforBill = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "A"	
						cPOStatusText = "Accounted for"
						lAccountedfor = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					ENDCASE
				ENDSCAN
			ENDIF
		ENDIF
				
		IF nReceivingID2 > 0
			IF ThisForm.nReceivingID <> nReceivingID2
				ThisForm.nReceivingID2 = nReceivingID2 
				*TrackMess("The POitem: '"+ThisForm.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(ThisForm.nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(ThisForm.nReceivingID))+"."+CHR(13)+cSQL)
				IF ThisForm.nWO_Detail > 0
					TrackError("The WO Detail: '"+STR(ThisForm.nWO_Detail)+"' has a ReceivingID of "+ALLTRIM(STR(ThisForm.nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL ,"Found nReceivingID2",PROGRAM(),LINENO(1))
				ELSE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem: '"+ThisForm.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(ThisForm.nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL )
				ENDIF
			ENDIF
		ENDIF
		
		**********************
		PRIVATE cSOitem
		cSOitem 	= Proper_SO_Item( ThisForm.cSOitem )
		
		**********************
		*Mark Master as POStatus='P'	&&Partial
		*
		**********************
		*Never Mark as Partial again!!! 3/11/2019
		*Complete the Receive ' lClearIncomingProcess '
		* and Create a new INCOMING Master, Detail, Process! ???
		*
		
		PRIVATE nMess
		nMess = 0
		PRIVATE lClearIncomingProcess
		lClearIncomingProcess = .F.
		
		IF lAccountedfor 
			*Do Nothing
			*cPOStatusText = "Accounted for"
			IF NOT lCmplt_the_Prc
				TrackMess("Did NOT Updated Stock:"+ThisForm.cTBL+" POStatusText = 'Accounted for' Receiving ID "+ALLTRIM(STR(ThisForm.nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
			ENDIF
			lClearIncomingProcess = .F.
		ELSE
			IF lWaitingforBill 
				*Do Nothing
				*cPOStatusText = "Waiting for Bill"
				IF NOT lCmplt_the_Prc
					TrackMess("Did NOT Updated Stock:"+ThisForm.cTBL+" POStatusText = 'Waiting for Bill' Receiving ID "+ALLTRIM(STR(ThisForm.nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
				ENDIF
		
				lClearIncomingProcess = .F.
			ELSE
				IF NOT lCmplt_the_Prc
					*User selected Good recieve, Not Complete
					nMess = 6
				ELSE
					*User Selected 'Just Editing' or Completes POitem
					IF lDueIn 
						IF ThisForm.nWO_Detail > 0
							nMess = MESSAGEBOX("This WO Detail:"+STR(ThisForm.nWO_Detail)+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"WO Detail status will be listed as Complete.")
						ELSE
							nMess = MESSAGEBOX("This PO_Item:"+ThisForm.cPOitem+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"PO status will be listed as Complete.")
						ENDIF
					ELSE
						IF lPartialReceive 
							IF ThisForm.nWO_Detail > 0
								nMess = MESSAGEBOX("This WO Detail:"+STR(ThisForm.nWO_Detail)+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"WO Detail status will be listed as Complete.")
							ELSE
								nMess = MESSAGEBOX("This PO_Item:"+ThisForm.cPOitem+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"PO status will be listed as Complete.")
							ENDIF			
						ENDIF
					ENDIF
				ENDIF
						
				IF nMess = 6
					lClearIncomingProcess = .T.
					cSQL = ""
					DO CASE
					CASE ThisForm.cTBL = "S"
						cSQL = " UPDATE dbo.StockLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisForm.cTBL = "B"
						cSQL = " UPDATE dbo.BrokerLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisForm.cTBL = "W"
						cSQL = " UPDATE dbo.WIPLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisForm.cTBL = "N"
						*
					OTHERWISE 
						ThisForm.cTBL = "N"
					ENDCASE
					
					IF ThisForm.cTBL = "N"
						*No TBL
					ELSE
						IF ThisForm.nWO_Detail > 0
							cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisForm.nWO_Detail)
						ELSE
							cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
						ENDIF
						IF nReceivingID2 > 0
							cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID2)
						ENDIF
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF		
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
						ELSE 
							TrackMess("Updated Stock:"+ThisForm.cTBL+" POStatusText set to W 'Waiting for Bill', Receiving ID "+ALLTRIM(STR(ThisForm.nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
							*MESSAGEBOX(cSQL,0,"Success")
						ENDIF
					ENDIF		
		
				ELSE
					IF NOT lCmplt_the_Prc
						TrackMess("Did NOT Updated Stock:"+ThisForm.cTBL+" User choose to not Complete. Receiving ID "+ALLTRIM(STR(ThisForm.nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		RETURN lClearIncomingProcess
	ENDPROC

	PROCEDURE cmdCancel.Valid
		IF MESSAGEBOX("Are you sure you want to Abort this receive?",4+32,"Cancel")=6
			*cTBL = ThisForm.cTBL
			ThisForm.nReturn = 0
			ThisForm.Release
		ENDIF
		
	ENDPROC

	PROCEDURE cmdGood.Valid
		*This could be an Edit
		*Check for ReceivingID in Stock to see if new partial stock needs to be run
		
		*****************************
		ThisForm.Clean_Stock("NOT_CMPLT")
		
		*******************************
		*See if ID_Detail already exists -Should be as a 'Due In'
		PRIVATE nCountDetail, cHeat, nCountHeat, cLot
		*nCountDetail = Count_Lst_Detail_by_ID_Detail(ThisForm.cTBL,nID_Detail,ThisForm.nConnHandle)
		cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		nCountHeat = Count_Lst_by_ID_Detail_Heat(ThisForm.cTBL,nID_Detail,cHeat,ThisForm.nConnHandle)
		cLot = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',0)
		
		IF nCountHeat > 0
			*nMess = MESSAGEBOX("This heat was found"+CHR(13)+"Do you want to Edit (Y)"+CHR(13)+"Answer No if this is a seperate Receive.",32,"Contine with Edit")
		
			ThisForm.nReturn = 1
			ThisForm.Release
			RETURN .T.
		ENDIF
		
		********************************
		*PRIVATE lTranAlreadySet, nProp, lOK 
		*nProp = SQLGETPROP(nConn, 'Transactions')
		*lTranAlreadySet = (nProp = 2)
		*lOK = .T.
		
		***********************************
		PRIVATE nQTY_Rcv,nQTY_Need,nPounds_Need,nPC_Need, nS_QTY, nPast_QTY, nRcv_HPA_QTY, nPast_PC, cCompany
		nQTY_Rcv		= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'Rcv QTY',18,4)
		nQTY_Need 		= PrepareSQLnum(ThisForm.txtQTY_Need.Value,'QTY_Need',18,4)
		nPounds_Need    = PrepareSQLnum(ThisForm.txtLBS_Need.Value,'Pounds_Need',9,1)
		nPC_Need		= PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC_Need',-3)
		nS_QTY 			= PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',-5)
		nS_P			= PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		nPast_QTY 		= PrepareSQLnum(ThisForm.txtPast_QTY.Value,'Past_QTY',-5)
		nPast_PC 		= PrepareSQLnum(ThisForm.txtPast_PC.Value,'Past_PC',-3)
		nRcv_HPA_QTY	= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'Receive_QTY',-5)
		cCompany		= PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		
		PRIVATE nMess
		
		IF (( nPast_QTY + nRcv_HPA_QTY +5 ) < (nS_QTY+5) * 1.2 ) AND (( nPast_QTY + nRcv_HPA_QTY +5 ) > (nS_QTY+5) / 1.2)
			nMess = MESSAGEBOX("The quantity Received is about the same "+CHR(13)+"as the quantity Ordered!"+CHR(13)+CHR(13)+;
			"Are you sure you DO NOT want to mark this"+CHR(13)+"as a COMPLETE Receive? (Y)"+CHR(13)+CHR(13)+;
			"Answer No here to go back and then mark as COMPLETE."+CHR(13)+;
			"Answer Yes to continue as 'UN COMPLETE'."+CHR(13),4+32,"Order not Completed")
			IF nMess != 6
				RETURN .F.
			ELSE
				IF ThisForm.nWO_Detail = 0
					TrackMess("The POitem: '"+ThisForm.cPOitem+"' was for a QTY of "+ALLTRIM(STR(nS_QTY))+CHR(13)+" from "+ALLTRIM(cCompany)+CHR(13)+"This QTY Received is "+ALLTRIM(STR(nRcv_HPA_QTY))+"."+CHR(13)+"The previous QTY Received is "+ALLTRIM(STR(nPast_QTY))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisForm.nReceivingID))+"." +CHR(13)+"User override the 15% 'looks complete' message and saved as NOT complete.")
				ELSE
					TrackMess("The WO Detail: '"+ALLTRIM(STR(ThisForm.nWO_Detail))+"' was for a QTY of "+ALLTRIM(STR(nS_QTY))+CHR(13)+" from "+ALLTRIM(cCompany)+CHR(13)+"This QTY Received is "+ALLTRIM(STR(nRcv_HPA_QTY))+"."+CHR(13)+"The previos QTY Received is "+ALLTRIM(STR(nPast_QTY))+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisForm.nReceivingID))+"." +CHR(13)+"User override the 15% 'looks complete' message and saved as NOT complete.")
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		PRIVATE nPO_OrigQTY, nO_QTY, nID_Detail_Process
		nPO_OrigQTY = 0
		nO_QTY	= 0
		nID_Detail_Process = 0
		PRIVATE lNOT2HPA, lPARTRECV
		lNOT2HPA = .F.
		lPARTRECV = .F.
		PRIVATE nPrc_PCs_need 
		
		*****************************************************************************
		*Create a new Master, Detail, Process for this Received metal
		*Update the Old Detail listing with new lower QTY, Pounds, Pieces.
		*Update the Old Process listing with new lower QTY, Pounds, Pieces as INCOMING.
		*****************************************************************************
		
		*Look for INCOMING PO item
		PRIVATE nSQLEXEC, cSQL
		
		IF USED('tmpStkProc')	
			USE IN tmpStkProc
		ENDIF
		
		cSQL = " SELECT QTY, Ordered_QTY, Ordered_P, ReceivingID, Process_ID, 'Original' AS Process, ID_Detail, ID_Detail_Process "
		cSQL = cSQL + " ,[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3],[Prc_Q_QTY],[Prc_Q_PU] "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
		ENDCASE
		IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_Item('')
			cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
			cSQL = cSQL + " AND WO_Detail = "+STR(ThisForm.nWO_Detail)
		ELSE
			IF ThisForm.nWO_Detail > 0
				cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)
			ELSE
				cSQL = cSQL = " WHERE 0>0 "
			ENDIF
		ENDIF
		cSQL = cSQL+" AND ( Process_ID='INCOMING' OR Process_ID = 'NOT2HPA' )"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkProc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkProc")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOStat')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		* Old School- Not sure if still relevant
		IF USED('tmpStkProc')
			IF RECCOUNT('tmpStkProc') > 0
				***************************
				SCAN	&& NOT sure if multiple exists ???
					
					DO CASE
					CASE tmpStkProc.Process = 'Original'
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					CASE tmpStkProc.Process_ID = 'INCOMING' 
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					CASE tmpStkProc.Process_ID = 'NOT2HPA' 
						lNOT2HPA = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					CASE tmpStkProc.Process_ID = 'PARTRECV' 
						lPARTRECV = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_Q_QTY 	= PrepareSQLnum(tmpStkProc.Prc_Q_QTY,'Prc_Q_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					ENDCASE
				ENDSCAN
		
			ENDIF
			USE IN tmpStkProc
		ENDIF
		
		****************************************************************************
		*get Orig PO QTY and PU from WO_Detail or POitem here
		
		PRIVATE nPO_QTY, nPO_P, nPU ,nStk_QTY, nStk_P, nStk_PU, cForm 
		nPO_QTY = 0
		nPO_P = 0
		nPU = 0
		nStk_QTY = 0
		nStk_P = 0
		nStk_PU = 0
		cForm = ''
		
		IF USED('tmpPOqty')	
			USE IN tmpPOqty
		ENDIF
		IF ThisForm.nWO_Detail > 0
			cSQL = "SELECT fWeight AS StockLst_QTY, 0 AS StockLst_P, 1 AS StockLst_PU, 0 AS StockLst_Total, fWeight AS Pounds "
			cSQL = cSQL + ", fWeight AS Order_QTY, 0 AS Order_P, 1 AS Order_PU, FForm AS Form "
			cSQL = cSQL + " FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)
		ELSE
			cSQL = "SELECT StockLst_QTY, StockLst_P, StockLst_PU, StockLst_Total, Pounds "
			cSQL = cSQL + ", Order_QTY, Order_P, Order_PU, Form "
			cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOqty')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOqty')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOqty")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOqty")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOqty')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpPOqty')
			IF RECCOUNT('tmpPOqty') > 0
				nPO_QTY = PrepareSQLnum(tmpPOqty.Order_QTY,'Order_QTY',-5)
				nPO_P	= PrepareSQLnum(tmpPOqty.Order_P, 'Order_P',-5)
				nPU 	= PrepareSQLnum(tmpPOqty.Order_PU,'Order_PU',-1)
				
				nPounds	 = PrepareSQLnum(tmpPOqty.Pounds,'Pounds',9,1)
				
				nStk_QTY = PrepareSQLnum(tmpPOqty.StockLst_QTY,'S_QTY',-5)
				nStk_P	 = PrepareSQLnum(tmpPOqty.StockLst_P, 'Order_P',-5)
				nStk_PU  = PrepareSQLnum(tmpPOqty.StockLst_PU,'Order_PU',-1)
				
				cForm = PrepareSQLtxt(tmpPOqty.Form,'Form',2)
				IF nStk_PU = 0
					nStk_PU = nPU_Acct_Form(cForm, ThisForm.nConnHandle)
				ENDIF
			ENDIF
			USE IN tmpPOqty
		ENDIF
		
		****************************************************************************
		*collect data to Edit Master, Detail, Process with remaining QTY (Incoming)
		*Add Stock to Master, Detail and Process
		
		PRIVATE cSOitem,cPOitem,cSalesPerson,dtStartDate,dDueDate,cComment,cProcess_ID, nRcvID_Incoming
		cSOitem = Proper_SO_item(ThisForm.cSOitem)
		cPOitem = Proper_PO_item(ThisForm.cPOitem)
		cSalesPerson = ''
		dtStartDate = DATETIME()
		dDueDate = DATE()+2 
		cComment = ''
		cProcess_ID	= "INCOMING"
		*nReceivingID = ThisForm.nReceivingID
		nRcvID_Incoming = 0
		
		PRIVATE cProcessor,cAllowSub
		cProcessor = RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
		cAllowSub	= 'N'
		
		PRIVATE cForm,nPU
		cForm = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		IF nStk_PU > 0
			nPU = nStk_PU  
		ELSE
			nPU = GetPUfromForm(cForm, ThisForm.nConnHandle)  
		ENDIF
		cUnit = GetUNITfromFORM(cForm, ThisForm.nConnHandle)
		
		PRIVATE nQTY_P,nQTY
		nQTY_P	= nStk_P
		nQTY	= 0
		
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		PRIVATE nWO, nWO_Detail
		nWO			= 0 
		nWO_Detail	= ThisForm.nWO_Detail
		PRIVATE lFoundOldPrc
		lFoundOldPrc = .F.
		
		***********************************************
		*Retreive INCOMING Process Detail before editing - If Exists
		IF USED('tmpStkProc')	
			USE IN tmpStkProc
		ENDIF
		
		cSQL = "SELECT * "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
		ENDCASE
		IF ThisForm.cPOitem <> Proper_PO_item('')
			cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ELSE
			IF ThisForm.nWO_Detail > 0
				cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)
			ENDIF
		ENDIF
		cSQL = cSQL + " AND ( [Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PARTRECV' )"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkProc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkProc")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStkProc')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpStkProc')	
			IF RECCOUNT('tmpStkProc') > 0
			
				lFoundOldPrc = .T.
				
				cSOitem	= PrepareSQLtxt(tmpStkProc.SOitem,'SOitem',10)
				ThisForm.cSOitem = cSOitem
				cPOitem	= PrepareSQLtxt(tmpStkProc.PO_item,'POitem',12)
				cSalesPerson = PrepareSQLtxt(tmpStkProc.SalesPerson,'SalesPerson',20)
				dtStartDate = PrepareSQLdateTime(tmpStkProc.StartDate,'StartDate')
				dDueDate = PrepareSQLdate(tmpStkProc.DueDate,'DueDate')
				cComment = PrepareSQLtxt( tmpStkProc.Comment,'Comment',100)
				cProcess_ID	= PrepareSQLtxt(tmpStkProc.Process_ID,'Process_ID',10)
				
				IF nPU=0
					nPU	= PrepareSQLnum(tmpStkProc.PU,'PU',-1)
				ENDIF
				*nQTY_P	= PrepareSQLnum(tmpStkProc.QTY_P,'QTY_P',-5)	&&Could implement S_P (Price per Unit)
				nQTY	= PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
				nO_QTY	= PrepareSQLnum(tmpStkProc.Ordered_QTY,'QTY',-5)
				nPounds				= PrepareSQLnum(tmpStkProc.Pounds,'Pounds',9,1)		
				nID_Detail			= PrepareSQLnum(tmpStkProc.ID_Detail,'ID_Detail',-3)
				nID_Detail_Process	= PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_Detail_Process',-3)
				*nReceivingID		= PrepareSQLnum(tmpStkProc.ReceivingID,'ReceivingID',-3)
				nRcvID_Incoming		= PrepareSQLnum(tmpStkProc.ReceivingID,'ReceivingID',-3)
				nWO			= PrepareSQLnum(tmpStkProc.WO,'WO',-3)
				nWO_Detail	= PrepareSQLnum(tmpStkProc.WO_Detail,'WO_Detail',-3)
				
				IF RECCOUNT('tmpStkProc') > 1
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Many results "+ALLTRIM(STR(RECCOUNT('tmpStkProc')))+CHR(13)+cSQL )
				ENDIF
			
			ENDIF
			USE IN tmpStkProc
		ENDIF
		
		
		****************************************
		IF NOT lFoundOldPrc
			*Could not find [Process_ID]='INCOMING'"
			*Get data from dbo.Receiving
			
			IF ThisForm.nReceivingID > 0
				*get from Receiving!
				IF USED('tmpReceiving2')	
					USE IN tmpReceiving2
				ENDIF
		
				cSQL = "SELECT * "
				cSQL = cSQL + " FROM dbo.Receiving "
				cSQL = cSQL + " WHERE ID = "+STR(ThisForm.nReceivingID)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceiving2')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceiving2')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceiving2")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceiving2")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpReceiving2')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('tmpReceiving2')	
					IF RECCOUNT('tmpReceiving2') > 0
						*lFoundOldPrc = .T.
						
						cSOitem	= PrepareSQLtxt(tmpReceiving2.SOitem,'SOitem',10)
						ThisForm.cSOitem = cSOitem
						cPOitem	= PrepareSQLtxt(tmpReceiving2.POitem,'POitem',12)
						IF LEN(cSalesPerson) < 1
							cSalesPerson = PrepareSQLtxt(cProcessor ,'SalesPerson',20)
						ENDIF
						dtStartDate = PrepareSQLdateTime(tmpReceiving2.Date,'StartDate', .F.,.T.)
						dDueDate = PrepareSQLdate(tmpReceiving2.Received,'DueDate')
						cComment = PrepareSQLtxt( tmpReceiving2.Comments,'Comment',100)
		
						cProcess_ID	= "INCOMING"
						cProcessor	= RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
						cAllowSub	= 'N'
						nQTY = nRcv_HPA_QTY	&&PrepareSQLnum(tmpReceiving2.ActualW,'ActualW',9,1)	
						nID_Detail			= 0 &&PrepareSQLnum(tmpReceiving2.ID_Detail,'ID_Detail',-3)
						nID_Detail_Process	= 0
						nWO			= PrepareSQLnum(tmpReceiving2.WO,'WO',-3)
						nWO_Detail	= PrepareSQLnum(tmpReceiving2.WO_Detail,'WO_Detail',-3)
						
					ENDIF
					USE IN tmpReceiving2
				ENDIF
						
			ENDIF
		ENDIF
		
		***********************************************************************************************
		*Clone a new Master Stock record for this receive
		*get Old ID to Clone
		
		PRIVATE nOld_ID	
		PRIVATE nOld_ID_Detail  &&get Old ID_Detail to Clone
		nOld_ID = 0
		nOld_ID_Detail = 0
		
		IF ThisForm.nID_Detail > 0
			IF LEN(ThisForm.cTBL) > 0
				nOld_ID_Detail = ThisForm.nID_Detail
			ELSE
				nOld_ID_Detail = nID_Detail
			ENDIF
		ELSE
			nOld_ID_Detail = nID_Detail
		ENDIF
		
		**************************************
		IF nOld_ID_Detail = 0
			*Find ID_Detail with PO_Item or WO_Detail - not accurate!!!
			*remove code when new code works 4-22
			IF lFoundOldPrc
				IF USED('tmpOldID')	
					USE IN tmpOldID
				ENDIF
		
				cSQL = "SELECT D.ID, D.ID_Detail, P.ID_Detail_Process  "
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail"
				CASE ThisForm.cTBL = "B"
					cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail"
				CASE ThisForm.cTBL = "W"
					cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail"
				ENDCASE
				cSQL = cSQL + " WHERE ( P.[Process_ID]='INCOMING' OR P.[Process_ID]='NOT2HPA' OR P.[Process_ID]='PARTRECV' )"
				IF ThisForm.nWO_Detail > 0
					cSQL = cSQL + " AND P.WO_Detail = "+STR(ThisForm.nWO_Detail)
				ENDIF
				IF ThisForm.cPOitem <> Proper_PO_item('')
					cSQL = cSQL + " AND P.PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOldID')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOldID')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOldID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOldID")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpOldID')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('tmpOldID')	
					IF RECCOUNT('tmpOldID') > 0
						SCAN
							nOld_ID	= PrepareSQLnum(tmpOldID.ID,'ID',-3)
							IF nOld_ID = 0
								SKIP
							ELSE
								nOld_ID_Detail	= PrepareSQLnum(tmpOldID.ID_Detail,'ID_Detail',-3)
								nID_Detail_Process = PrepareSQLnum(tmpOldID.ID_Detail_Process,'ID_D_P',-3)
								
							*	IF ThisForm.UpdateProcess(nID_Detail_Process, ThisForm.nReceivingID )
								EXIT	&&Exit Scan
							*	ENDIF
							ENDIF				 
						ENDSCAN
						
						IF RECCOUNT('tmpOldID') > 1
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Many results "+ALLTRIM(STR(RECCOUNT('tmpOldID')))+CHR(13)+cSQL )
						ENDIF
					ENDIF
					USE IN tmpOldID
				ENDIF
		
				IF nOld_ID = 0
			*		MESSAGEBOX("Did not find old data"+CHR(13)+"",0+48,"No")
					lFoundOldPrc = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*************************************
		*This Block of Code is probably just redundate
		IF nOld_ID_Detail = 0 AND NOT lFoundOldPrc
			*No INCOMING process
			*get the Old ID and ID_Detail by PO_item or WO_Detail  - not accurate!!!
			IF ThisForm.cPOitem <> Proper_PO_item('')
				IF USED('tmpOldID')	
					USE IN tmpOldID
				ENDIF
		
				cSQL = "SELECT M.ID, 'S' AS TBL "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
					cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
					IF NOT EMPTY(cHeat)
						cSQL = cSQL + " AND Heat = '"+ALLTRIM(cHeat)+"'"
					ENDIF
					IF NOT EMPTY(cLot)
						cSQL = cSQL + " AND Lot = '"+ALLTRIM(cLot)+"'"
					ENDIF
		
				ELSE
					IF ThisForm.nID_Detail > 0
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITHNOLOK) ON M.ID = D.ID "
						cSQL = cSQL + " WHERE D.ID_Detail = "+STR(ThisForm.nID_Detail)
					ENDIF
				ENDIF
				
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT M.ID, 'B' AS TBL "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
					cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
					IF NOT EMPTY(cHeat)
						cSQL = cSQL + " AND Heat = '"+ALLTRIM(cHeat)+"'"
					ENDIF
					IF NOT EMPTY(cLot)
						cSQL = cSQL + " AND Lot = '"+ALLTRIM(cLot)+"'"
					ENDIF
		
				ELSE
					IF ThisForm.nID_Detail > 0
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITHNOLOK) ON M.ID = D.ID "
						cSQL = cSQL + " WHERE D.ID_Detail = "+STR(ThisForm.nID_Detail)
					ENDIF
				ENDIF
				
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT M.ID, 'W' AS TBL "
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				
				IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
					cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
					IF NOT EMPTY(cHeat)
						cSQL = cSQL + " AND Heat = '"+ALLTRIM(cHeat)+"'"
					ENDIF
					IF NOT EMPTY(cLot)
						cSQL = cSQL + " AND Lot = '"+ALLTRIM(cLot)+"'"
					ENDIF
		
				ELSE
					IF ThisForm.nID_Detail > 0
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITHNOLOK) ON M.ID = D.ID "
						cSQL = cSQL + " WHERE D.ID_Detail = "+STR(ThisForm.nID_Detail)
					ENDIF
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOldID')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOldID')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOldID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOldID")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpOldID')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('tmpOldID')	
					IF RECCOUNT('tmpOldID') > 0
						SCAN 
							IF ThisForm.cTBL = PrepareSQLtxt(tmpOldID.TBL,'TBL',1)
								nOld_ID	= PrepareSQLnum(tmpOldID.ID,'ID',-3)
								IF nOld_ID = 0
									SKIP
								ELSE
									ThisForm.cTBL 	= PrepareSQLtxt(tmpOldID.TBL,'TBL',1)
									EXIT
								ENDIF
								
							ENDIF
						ENDSCAN
						
						nOld_ID_Detail	= 0
						IF RECCOUNT('tmpOldID') > 1
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Many results "+ALLTRIM(STR(RECCOUNT('tmpOldID')))+CHR(13)+ThisForm.cTBL+CHR(13)+cSQL )
						ENDIF
						
					ENDIF
					USE IN tmpOldID
				ENDIF
		
				IF nOld_ID = 0
					*Create StockListing is run in Receive_Edit !! not here
					
					lFoundOldPrc = .F.
				ENDIF		
			
			ENDIF
		ENDIF
		
		IF nOld_ID_Detail > 0
			IF nOld_ID = 0
				nOld_ID = GetIDfromID_Detail( nOld_ID_Detail, ThisForm.cTBL, ThisForm.nConnHandle )
			ENDIF
		ENDIF
		
		***********************************************************************************************
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		* Begin Manual transactions
		***********************************************************************************************
		
		PRIVATE lCommit, lOK, cBadMess
		lCommit = .T.
		lOK = .T.
		cBadMess = ''
		
		********************
		PRIVATE nNewID, nNewID_Detail, nNewTBL
		nNewID = 0
		nNewID_Detail = 0
		nNewTBL = "S"
		********************
		IF nOld_ID > 0 AND ThisForm.nReceivingID > 0
		
			******************************
			*Create new MASTER Stock record for new Receive 
			*Makes a Stock Lst entry
			nNewID = ThisForm.Lst_Master_Clone(ThisForm.cTBL,nOld_ID,nQTY_Rcv,cHeat,cLot)
			
			IF nNewID = 0
				MESSAGEBOX("Could not Create new MASTER Stock record",16,"Error")
				TrackError("Could not Create new MASTER Stock record "+CHR(13)+"TBL "+ThisForm.cTBL+CHR(13)+"ID= "+STR(nOld_ID)+CHR(13)+"Receive QTY "+STR(nQTY_Rcv),"Could not Create new MASTER Stock record ", PROGRAM(), LINENO(1))
				cBadMess = cBadMess + "Could not Create new MASTER Stock record "+CHR(13)
				cBadMess = cBadMess + "nNewID = ThisForm.Lst_Master_Clone(ThisForm.cTBL,nOld_ID,nQTY_Rcv,cHeat,cLot) returne4d 0!"+CHR(13)
				cBadMess = cBadMess + "ThisForm.cTBL='"+ThisForm.cTBL+"' ,nOld_ID="+STR(nOld_ID)+", nQTY_Rcv="+STR(nQTY_Rcv)+", cHeat='"+cHeat+"', cLot='"+cLot+"'!"+CHR(13)
				lOK = .F.
			ENDIF
			
			IF lOK 
				IF nNewID > 0
					******************************
					*Create new DETAIL Stock record with Receive data 
					*nOld_ID_Detail = PrepareSQLnum(ThisForm.nID_Detail,'ID_Detail',-3)
					IF nOld_ID_Detail = 0
						*Should never be 0
						nOld_ID_Detail = getHighestID_DetailbyID(nOld_ID,ThisForm.cTBL,ThisForm.nConnHandle)	&&Not a good Practice
					ENDIF
					IF nOld_ID_Detail = 0
						*lOK = .F.
						*cBadMess = cBadMess + "Do not have the Old ID_Detail to update. "+CHR(13)
						*EXEC dbo.p_Lst_Detail_ins
						nNewID_Detail = ThisForm.Lst_Detail_Ins(nNewID, nNewTBL )
					ELSE
						nNewID_Detail = ThisForm.Lst_Detail_Clone(nNewID, nOld_ID_Detail)
					ENDIF
					
					ThisForm.nID_Detail = nNewID_Detail 
					IF nNewID_Detail > 0
						ThisForm.Copy_SelectedPrc(nOld_ID_Detail, nNewID_Detail)		
					ELSE
						cBadMess = cBadMess + "Did not create a new ID_Detail . "+CHR(13)
					ENDIF
					
				ENDIF
			ENDIF
			*
			IF lOK
				*update the NEW Detail
				**********************
				IF nNewID_Detail > 0	
					*UPDATE new ID_Detail with the current data!  
					
					PRIVATE nPC_Recv, nActualW, nRcv_QTY, nS_P, nS_Total
					nPC_Recv	= PrepareSQLnum(ThisForm.txtPC_Recv.Value,'Pieces',-3)
					nActualW	= PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)	
					nRcv_QTY	= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'QTY',-5)
					nS_P		= PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
					nS_Total	= nRcv_QTY * nS_P
		
					DO CASE
					CASE nNewTBL = "S"
						cSQL = "UPDATE dbo.StockLst_Detail SET "
					CASE nNewTBL = "B"
						cSQL = "UPDATE dbo.BrokerLst_Detail SET "
					CASE ThisForm.cTBL = "W"
						cSQL = "UPDATE dbo.WIPLst_Detail SET "
					ENDCASE
								
					cSQL = cSQL+ " PC="+STR(nPC_Recv)+""
					cSQL = cSQL+ ",Weight="+STR(nActualW,18,4)+""
					cSQL = cSQL+ ",ReceivingID="+STR(ThisForm.nReceivingID)
					cSQL = cSQL+ ",InvCheck=GetDate()" &&+"'"+DTOC(DATE())+"'"
					cSQL = cSQL+ ",S_QTY = " + STR(nRcv_QTY,18,4) + ""
					cSQL = cSQL+ ",S_P = "+STR(nS_P,18,4)
					cSQL = cSQL+ ",S_Total = "+STR(nS_Total,18,4)
					cSQL = cSQL+ ",Prime = 1"
					
					cSQL  = cSQL+ " WHERE ID_Detail="+STR(nNewID_Detail)
				
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
						lCommit = .F.
						lOK = .F.
						cBadMess = cBadMess + "Could not Update the new Detail record "+CHR(13)
					ENDIF
				
				ENDIF
			ENDIF
			
			IF lOK
				**Update the NEW Master
				* --Totally redundant!!!
				PRIVATE cHeat, cLot, cPOitem, nFrom_ID, nWO_Detail
				cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
				cLot	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
				cPOitem = PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)
				nFrom_ID = nOld_ID 
				nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3)
				
				DO CASE
				CASE nNewTBL = "S"
					cSQL = "UPDATE dbo.StockLst_Master SET "
				CASE nNewTBL = "B"
					cSQL = "UPDATE dbo.BrokerLst_Master SET "
				CASE nNewTBL = "W"
					cSQL = "UPDATE dbo.WIPLst_Master SET "
				ENDCASE
				
				cSQL = cSQL +" Heat = '"+cHeat+"'"
				cSQL = cSQL +",Lot = '"+cLot+"'"
				cSQL = cSQL +",StkDate='"+TTOC(DATETIME())+"'"
				cSQL = cSQL +",POStatus = 'W'"
				IF cPOitem <> Proper_PO_item('')
					cSQL = cSQL+",PO_item = '"+cPOitem+"'"
				ENDIF
				IF nWO_Detail > 0
					cSQL = cSQL + ",WO_Detail = "+STR(nWO_Detail)
				ENDIF
				cSQL = cSQL + ",From_ID="+STR(nFrom_ID)
				cSQL = cSQL +" WHERE ID ="+STR(nNewID)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
					lCommit = .F.
					lOK = .F.
					cBadMess = cBadMess + "Could not Update Master "+CHR(13)
				ENDIF
			ENDIF
			
			***************************************************************************
			IF lOK AND nNewID > 0 AND nNewID_Detail > 0 AND ThisForm.nReceivingID > 0
			
				*Update Receiving
				cSQL = "UPDATE dbo.Receiving "
				cSQL = cSQL +" SET StockTable = '"+nNewTBL +"'"
				cSQL = cSQL +",ID_Master = "+STR(nNewID)
				cSQL = cSQL +",ID_Detail = "+STR(nNewID_Detail)
				cSQL = cSQL +" WHERE ID ="+STR(ThisForm.nReceivingID)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
			ENDIF
			
		ENDIF
		
		********************
		******************************
		********************
		IF lOK AND nNewID > 0 AND nNewID_Detail > 0 AND nOld_ID_Detail > 0 AND ThisForm.nReceivingID > 0 AND lOK
			*Update the 'Due In' with the QTY Needed
			*Detail QTY
			
			PRIVATE cLength, nS_Total
			cLength = "Balance DUE IN for "
			IF cPOitem <> Proper_PO_item('')
				cLength = cLength+"PO_item = "+ALLTRIM(cPOitem)
			ENDIF
			IF nWO_Detail > 0
				cLength = cLength+ "WO_Detail = "+ALLTRIM(STR(nWO_Detail))
			ENDIF
			IF nPC_Need < 1
				nPC_Need = 1
			ENDIF
			IF nQTY_Need < 0
				nQTY_Need = 0
			ENDIF
			DO CASE
			CASE nNewTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Detail SET "
			CASE nNewTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Detail SET "
			CASE nNewTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Detail SET "
			ENDCASE
			cSQL = cSQL +" Length='"+cLength+"'"
			cSQL = cSQL +",PC="+STR(nPC_Need)
			cSQL = cSQL +",Weight="+STR(nPounds_Need,9,1)
			cSQL = cSQL +",S_QTY="+STR(nQTY_Need,18,4)
			cSQL = cSQL +",S_Total="+STR(nQTY_Need,18,4)+"*[S_P]"
			
			cSQL = cSQL +" WHERE ID_Detail ="+STR(nOld_ID_Detail)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		ENDIF
		
		
		********************
		*Create new INCOMING PROCESS Stock, Broker or WIP record for new balance after Receive!
		************************
		IF lFoundOldPrc
			*Fix Process, Receive old INCOMING and create new INCOMING for balance
			lOK = ThisForm.Update_Incoming_Process(nNewTBL, nNewID, nNewID_Detail, nOld_ID, nOld_ID_Detail )
		ELSE
			*Just Received- Do not Create 
			*ThisForm.Create_Incoming_Process()
			
		ENDIF
		
		
		
		
		*Create a Received Process?
		
		
		******************************************
		IF lCommit 
			WAIT WINDOW "Saved!" NOWAIT
			=SQLCOMMIT(ThisForm.nConnHandle)
		ELSE
			MESSAGEBOX("SQL Transaction Rolled Back",0,"Could not save!")
			=SQLROLLBACK(ThisForm.nConnHandle)
			TrackError("SQL Transaction Rolled Back"+CHR(13)+CHR(13)+cBadMess,"Could not save!",PROGRAM(),LINENO(1))
			*= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1) 
			*RETURN .F.
			
		ENDIF
		
		
		***************************************************************************************
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		***************************************************************************************
		
		*ThisForm.Check_PartRecv("NOT_CMPLT")
		
		*Good, Receive matches PO,  ** NOT Complete **
		IF nNewID_Detail > 0
			*ThisForm.nReturn = PrepareSQLnum(("1."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
			ThisForm.nReturn = PrepareSQLnum("2."+PADL(ALLTRIM(STR(nNewID_Detail)),10,'0'),'Plus ID_Detail',12,10)
		ELSE
			ThisForm.nReturn = 1
		ENDIF
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdGoodCmplt.Valid
		*check for Complete by QTY
		PRIVATE nQTY_Need, nS_QTY, nRcv_QTY, nMess, nPast_QTY, nRcv_HPA_QTY, nPO_P, cCompany
		nQTY_Need	= PrepareSQLnum(ThisForm.txtQTY_Need.Value,'QTY_Need',-5)
		nS_QTY 		= PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',-5)
		nRcv_QTY	= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'S_QTY',-5)
		
		nS_P = PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
		
		nPast_QTY 	= PrepareSQLnum(ThisForm.txtPast_QTY.Value,'Past_QTY',-5)
		nRcv_HPA_QTY	= PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'Receive_QTY',9,1)
		
		*nPast_PC	= PrepareSQLnum(ThisForm.txtPast_QTY.Value,'Past_QTY',-5)
		nPast_PC	= PrepareSQLnum(ThisForm.txtPast_PC.Value,'Past_PC',9,1)  
		cCompany		= PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		
		IF (( nPast_QTY + nRcv_HPA_QTY +5) * 1.2 < (nS_QTY+5) ) OR (( nPast_QTY + nRcv_HPA_QTY +5 ) > (nS_QTY+5) * 1.2 )
			nMess = MESSAGEBOX("The Quantity Ordered to Quantity Received is more the 15% off!"+CHR(13)+CHR(13)+"Are you sure you want to make this as a COMPLETE receive?",4+32,"Complete?")
			IF nMess != 6
				RETURN .F.
			ELSE
				IF Proper_PO_Item(ThisForm.cPOitem) <> Proper_PO_Item('')
					PRIVATE cMess
					cMess = "The POitem: '"+ThisForm.cPOitem+"' was for a QTY of "+ALLTRIM(STR(nS_QTY))+CHR(13)+" from "+ALLTRIM(cCompany)+CHR(13)+"The QTY this Received is "+ALLTRIM(STR(nRcv_HPA_QTY))+"."+CHR(13)+"The Past QTY Received is "+ALLTRIM(STR(nPast_QTY))+"."+CHR(13)+"QTY added together is "+ALLTRIM(STR(nRcv_HPA_QTY+nPast_QTY))+"."+CHR(13)+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisForm.nReceivingID))+"." +CHR(13)+"User override the 15% Error message and saved as complete."
					TrackMess(cMess)
					Send_Chatter("PO_Item_Overage",ThisForm.cPOitem,ThisForm.cPOitem, cMess+CHR(13)+HTML_POitem(cPOitem,.T.), ThisForm.nConnhandle)
					*PARAMETERS pcType_Name, pnNumber, pcNumber, pcMessage, pConnHandle
				ENDIF
				IF ThisForm.nWO_Detail > 0
					TrackMess("The WO Detail: '"+STR(ThisForm.nWO_Detail)+"' was for a QTY of "+ALLTRIM(STR(nS_QTY))+CHR(13)+" from "+ALLTRIM(cCompany)+CHR(13)+"The QTY this Received is "+ALLTRIM(STR(nRcv_HPA_QTY))+"."+CHR(13)+"The Past QTY Received is "+ALLTRIM(STR(nPast_QTY))+CHR(13)+"QTY added together is "+ALLTRIM(STR(nRcv_HPA_QTY+nPast_QTY))+"."+"."+CHR(13)+"ReceiveID is "+ALLTRIM(STR(ThisForm.nReceivingID))+"." +CHR(13)+"User override the 15% Error message and saved as complete.")
				ENDIF
			ENDIF
		ENDIF
		
		
		*****************************
		ThisForm.Clean_Stock("CMPLT")
		
		* ThisForm.Del_IncomProc()
		
		PRIVATE nNewID_Detail
		nNewID_Detail = 0
		*****************************
		IF nNewID_Detail > 0
			*ThisForm.nReturn = PrepareSQLnum(("2."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
			*ThisForm.nReturn = PrepareSQLnum("2."+STR(nNewID_Detail,10),'Plus ID_Detail',12,10)
			ThisForm.nReturn = PrepareSQLnum("2."+PADL(ALLTRIM(STR(nNewID_Detail)),10,'0'),'Plus ID_Detail',12,10)
		ELSE
			ThisForm.nReturn = 2
		ENDIF
		
		ThisForm.Release
		
	ENDPROC

