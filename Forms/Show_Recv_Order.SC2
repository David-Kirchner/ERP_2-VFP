		*!*			cSQLi = cSQLi + ",@floorstatus ='"+"'"
		*!*			cSQLi = cSQLi + ",@class ='"+"'"
		*!*			cSQLi = cSQLi + ",@unit ='"+cLstDetailUnit+"'"
		*!*			cSQLi = cSQLi + ",@RandLen ="+IIF(lRandLen,"1","0")	&&'"+"'"
		*!*			cSQLi = cSQLi + ",@ID ="+STR(nMaster_ID )
		*!*			cSQLi = cSQLi + ",@ID_Detail_Process ="+STR(nID_Detail_Process)
		
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLi,ThisForm.nConnHandle)
		*!*				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi)
		*!*				lSQLgood = .F.
		*!*			ELSE
		*!*				IF USED('tmpID_Detail')
