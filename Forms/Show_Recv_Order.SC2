		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL_Detail_Update,ThisForm.nConnHandle,nSQLEXEC )
		*!*						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL_Detail_Update)
		*!*					ENDIF
		*!*				
		*!*				ENDIF
		*!*			ELSE
		*!*				nMaster_ID = 0
		*!*			ENDIF
		*!*		ENDIF
