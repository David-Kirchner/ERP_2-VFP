		*!*					MESSAGEBOX('Could not SAVE detail',0,'Error')
		*!*				ENDIF
		*!*			ENDIF	
		*!*		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE del_incomproc
		*ThisForm.Del_IncomProc()
		
		*ThisForm.nReceivingID2 is filled by Update_PO Status()
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisForm.nReceivingID,'ReceivingID',-3)
		
		IF nReceivingID < 1
			*Only Incoming Process with ReceivingID will be deleted.
			*POitem is too vague
			RETURN .F.
		ENDIF
		
		*cSQL = " DELETE FROM "
		cSQL = " UPDATE "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		OTHERWISE
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " SET [Process_ID]='RECEIVED' "
		*cSQL = cSQL + " WHERE ( PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		*IF nReceivingID2 > 0
		*	cSQL = cSQL + " OR ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + " WHERE ReceivingID = "+STR(nReceivingID)
		*ENDIF
		*cSQL = cSQL + " ) "
		cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PartRecv' )"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pWhat,pOrder, cAlloy,cHeat, nPC_Recv, nRcv_HPA_QTY, nActualW, cDescription, nReceivingID, cTBL, nID_Detail,cLot,nID_Master
		*DO FORM Forms\Show_Recv_Order WITH "POitem",cPOitem, cAlloy,cHeat,nPC_Recv,nRcv_HPA_QTY,nActualW,cDescription,nReceivingID,TBL,ID_Detail,Lot,nID_Master TO lRollBack
		*cPOitem can be WO_Detail!!
		
		IF VARTYPE(pWhat) != "C"
			RETURN
		ENDIF
		
		*IF VARTYPE(pOrder) != "C"
		*	*cPOitem = Proper_PO_item('')
		*	pOrder = ''
		*ENDIF
		
		PRIVATE nWO_Detail
		nWO_Detail = 0
		
		DO CASE
		CASE pwhat = "WOD"
			nWO_Detail = PrepareSQLnum(pOrder,'WO_Detail',-3)
			cPOitem = Proper_PO_Item('')
			pOrder = STR(pOrder)
		CASE pWhat = "POitem"
			IF Proper_PO_Item(pOrder) <> Proper_PO_Item('')
				nWO_Detail = 0
				cPOitem = Proper_PO_Item(pOrder)
			ELSE
				TrackError("Show_Recv_Order bad parameter pWhat='POitem'.","Show_Recv_Order bad parameter", PROGRAM(), LINENO(1))
				ThisForm.nReturn = 0
				RETURN
				ThisForm.Release
			ENDIF
		OTHERWISE
			TrackError("Show_Recv_Order bad parameter pWhat. INIT not programed for paramater.","Show_Recv_Order bad parameter", PROGRAM(), LINENO(1))
			ThisForm.nReturn = 0
			RETURN
			ThisForm.Release
		ENDCASE
		
		
		IF VARTYPE(nReceivingID)!= "N"
			nReceivingID = 0
		ENDIF
		ThisForm.nReceivingID = ABS(nReceivingID)   &&Inverted means New ID, was just ADDed
		
		IF nWO_Detail > 0
			ThisForm.SetToWOD()
			ThisForm.lblSummary.Caption = "Summary for WO Detail: "+ALLTRIM(STR(nWO_Detail))
			ThisForm.nWO_Detail = nWO_Detail
			ThisForm.cPOitem = ''
			ThisForm.cSOitem = Proper_SO_item('')
			ThisForm.lblPOitem.Caption = "WO Detail"
		ELSE
			*POitem
			ThisForm.lblSummary.Caption = "Summary for PO-item: "+ALLTRIM(cPOitem)
			ThisForm.cPOitem = cPOitem
			ThisForm.nWO_Detail = 0
			ThisForm.cSOitem = get_SOitem_from_POitem(cPOitem,ThisForm.nConnHandle)
			ThisForm.lblPOitem.Caption = "PO item"
		ENDIF
		
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('') OR nWO_Detail > 0
			*Good
		ELSE
			RecordTest('Record Test Data','Show_Recv_Order.INIT()',LINENO(1),"cPOitem "+cPOitem+", nWO_Detail "+STR(nWO_Detail) )
		ENDIF
		
		ThisForm.cTBL = PrepareSQLtxt(cTBL,'TBL',1)
		ThisForm.nID_Detail = PrepareSQLnum(nID_Detail,'ID_Detail',-3)
		ThisForm.nID_Master = PrepareSQLnum(nID_Master,'ID',-3)
		
		************************************
		PRIVATE lServices, lConvServ, lEquipment
		lServices = .F.
		lConvServ = .F.
		lEquipment = .F.
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "Select 0 "
		
		IF USED('tmpPO')	
			USE IN tmpPO
		ENDIF
		
		DO CASE
		CASE nWO_Detail > 0
			cSQL = "SELECT 'HPA' AS Company,fAlloy AS Alloy,fForm AS Form,fCC AS CC,fCL AS CL"
			cSQL = cSQL+",fThck AS Thck, fSz2 AS sz2, fSz3 AS sz3,fPieces AS Pieces"
			cSQL = cSQL+",fWeight AS StockLst_QTY,fWeight AS Pounds, 0 AS StockLst_P"
			cSQL = cSQL+", 0 AS Services, 0 AS ConvServ, 0 AS Equipment, 0 AS Delivered, 0 AS Reconciled "
			cSQL = cSQL+" FROM dbo.WorkOrder_Detail WITH(NOLOCK) WHERE WO_Detail = "+STR(nWO_Detail)
		*!*	CASE ThisForm.nID_Detail > 0
		*!*		DO CASE
		*!*		CASE ThisForm.cTBL = 'S'
		*!*		CASE ThisForm.cTBL = 'S'
		*!*		CASE ThisForm.cTBL = 'S'
		*!*		ENDCASE
		CASE Proper_PO_item(cPOitem) <> Proper_PO_item('')
			cSQL = "SELECT Company,Alloy,Form,CC,CL,Thck,sz2,sz3,Pieces"
			cSQL = cSQL+",StockLst_QTY, Pounds, StockLst_P"
			cSQL = cSQL+",Services,ConvServ,Equipment,Delivered,Reconciled "
			cSQL = cSQL+" FROM dbo.PurchaseOrder WITH(NOLOCK) WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		ENDCASE
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpPO')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpPO')	
			IF RECCOUNT('tmpPO') > 0
				ThisForm.txtCompany.Value	= tmpPO.Company
				ThisForm.txtAlloyPO.Value	= tmpPO.Alloy
				ThisForm.txtForm.Value		= tmpPO.Form
				ThisForm.txtThck.Value		= tmpPO.Thck
				ThisForm.txtSz2.Value		= tmpPO.sz2
				ThisForm.txtSz3.Value		= tmpPO.sz3
				ThisForm.txtPiecesPO.Value	= tmpPO.Pieces
				ThisForm.txtS_QTY.Value		= PrepareSQLnum(tmpPO.StockLst_QTY,'QTY',-5)
				ThisForm.txtS_P.Value		 = PrepareSQLnum(tmpPO.StockLst_P,'S_P',-5)
				ThisForm.txtOrder_LBS.Value = tmpPO.Pounds
				ThisForm.chkServicesPO.Value = tmpPO.Services
				ThisForm.chkConvServ.Value	= tmpPO.ConvServ
				ThisForm.chkEquipment.Value	= tmpPO.Equipment
				ThisForm.chkComplete.Value	= tmpPO.Delivered
				ThisForm.chkReconciled.Value = tmpPO.Reconciled	
				
				lServices	= PrepareSQLlogic(tmpPO.Services,'Services',.F.)
				lConvServ	= PrepareSQLlogic(tmpPO.ConvServ,'ConvServ',.F.)
				lEquipment	= PrepareSQLlogic(tmpPO.Equipment,'Equipment',.F.)
			ENDIF
			USE IN tmpPO
		ENDIF
		
		
		*!*	ThisForm.txt_SO_QTY.Value = 0
		*!*	ThisForm.txt_Cmplt_QTY.Value = 0
		*!*	ThisForm.cTBL = 'N'
		
		*!*	IF USED('tmpPO_Orig')	
		*!*		IF RECCOUNT('tmpPO_Orig') > 0
		*!*			*POitem in StockLst_Process
		*!*			ThisForm.cTBL	= PrepareSQLtxt(tmpPO_Orig.TBL,'TBL',1)
		*!*			
		*!*			ThisForm.txt_SO_QTY.Value     = PrepareSQLnum(tmpPO_Orig.QTY,'QTY',-3)		
		*!*			*ThisForm.txt_SO_QTY.Value     = PrepareSQLnum(tmpPO_Orig.QTY,'QTY',-3)
		*!*			ThisForm.txt_Cmplt_QTY.Value = PrepareSQLnum(tmpPO_Orig.Prc_Q_QTY,'Prc_Q_QTY',-3)
		*!*			ThisForm.txt_Cmplt_QTY.Value	= PrepareSQLnum(ThisForm.txt_SO_QTY.Value - ThisForm.txt_Cmplt_QTY.Value,'Diff',-3)
		*!*			
		*!*			ThisForm.lbl_Orig_QTY.Visible = .T.
		*!*			ThisForm.txt_SO_QTY.Visible = .T.
		*!*			ThisForm.lbl_Orig_Prc_Q_QTY.Visible = .T.
		*!*			ThisForm.txt_Cmplt_QTY.Visible = .T.
		*!*			ThisForm.lbl_Orig_Need.Visible = .T.
		*!*			ThisForm.txt_Cmplt_QTY.Visible = .T.
		*!*			
		*!*		ENDIF
		*!*		IF RECCOUNT('tmpPO_Orig') > 1
		*!*			*TrackError("Why is there more than 1, Counted "+ALLTRIM(STR(RECCOUNT('tmpPO_Orig')))+" ."+CHR(13)+cSQL,"Too many _Orig Records.",PROGRAM(),LINENO(1) )
		*!*			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Long Message")
		*!*		ENDIF
		*!*		USE IN tmpPO_Orig
		*!*	ELSE
		*!*		RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1), 'No records for POitem in StockLst_Process'+CHR(13)+cSQL )
		*!*	ENDIF
		
		***********************
		*PRIVATE cTBL
		*cTBL = "N"
		*ThisForm.cTBL = "N"
		
		IF ( lServices OR lEquipment )
			IF ThisForm.cTBL == ''
				ThisForm.cTBL = 'N'
			ENDIF
		ELSE
			IF ThisForm.cTBL == '' OR ThisForm.cTBL = "N"
				IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
					***
					*cTBL = getTBL_POitem(cPOitem, ThisForm.nConnHandle) 
					***
					ThisForm.cTBL = getTBL_POitem(cPOitem, ThisForm.nConnHandle) 
					*IF LEN(cTBL) > 0
					*	RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1), "cTBL set to '"+cTBL+"' for receiving POitem '"+cPOitem+"'" )
					*ELSE
					*	RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1), "cTBL was not found for receiving POitem '"+cPOitem+"'" )
					*ENDIF
				ELSE
					IF nWO_Detail > 0
						ThisForm.cTBL = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnHandle)
					ENDIF
				ENDIF 
			ENDIF
		ENDIF
		
		
		
		************************
		
		IF NOT ( lServices OR lEquipment )
			IF ThisForm.cTBL=='' OR ThisForm.cTBL = "N" 
				*MESSAGEBOX("Did not find TBL ",0+16,"This will cause errors!")
				*TrackError("Did not find TBL, POitem = '"+cPOitem+"', WO_Detail = "+ALLTRIM(STR(nWO_Detail))+CHR(13)+"Even tried getTBL_POitem('"+cPOitem+"') --Setting to 'S'"+CHR(13)+cSQL, "Did not find TBL",PROGRAM(),LINENO(1))
				
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not find TBL, POitem = '"+cPOitem+"', WO_Detail = "+ALLTRIM(STR(nWO_Detail))+CHR(13)+"Even tried getTBL_POitem('"+cPOitem+"') --Setting to 'S'"+CHR(13)+cSQL )
		
				IF nWO_Detail > 0
					*put in stock!
					ThisForm.cTBL = 'S'
				ELSE
					ThisForm.cTBL = 'S'
				ENDIF
			ENDIF
		ENDIF
		
		
		************************
		*get the RECEIVE data
		*
		*cAlloy,cHeat,nPC_Recv,nRcv_HPA_QTY,cDescription
		
		ThisForm.txtAlloy.Value		= ShowSQLtxt(cAlloy,'Alloy',12)
		ThisForm.txtHeat.Value		= ShowSQLtxt(cHeat,'Heat',50)
		ThisForm.cHeat 				= ShowSQLtxt(cHeat,'Heat',50)
		ThisForm.txtLot.Value		= ShowSQLtxt(cLot,'Lot',10)
		ThisForm.txtPC_Recv.Value	= PrepareSQLnum(nPC_Recv,'Pieces',-3)
		ThisForm.txtActualW.Value	= PrepareSQLnum(nActualW,'Pounds',9,1)
		ThisForm.txtRcv_QTY.Value	= PrepareSQLnum(nRcv_HPA_QTY,'Receive_QTY',9,1)
		
		ThisForm.edtDescription.Value = ShowSQLtxt(cDescription,'Description',-1)
		
		
		************************
		* Collect All Receives
		*
		IF USED('tmpReceive')
			USE IN tmpReceive
		ENDIF
		
		************************
		cSQL = "SELECT Alloy,Heat,Pieces, ActualW, R_QTY, R_PU"
		cSQL = cSQL+",PO_QTY,PO_PU"
		cSQL = cSQL+" ,LEFT(Description,100) AS [Description],Cancelled,ID "
		cSQL = cSQL+" FROM dbo.Receiving WITH(NOLOCK) "
		IF nWO_Detail > 0
			cSQL = cSQL+" WHERE ( WO_Detail = "+STR(nWO_Detail)
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				cSQL = cSQL+" OR POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			ENDIF
			cSQL = cSQL+" ) "
		ELSE
			*IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			cSQL = cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		ENDIF
		
		IF ThisForm.nReceivingID > 0
			cSQL = cSQL+" OR ID = "+STR(ThisForm.nReceivingID)
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceive')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceive')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceive")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceive")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpReceive')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		PRIVATE m.nPast_QTY, m.nPast_LBS, m.nPast_PC
		m.nPast_QTY = 0
		m.nPast_LBS = 0
		m.nPast_PC = 0
		
		IF USED('tmpReceive')	
			IF RECCOUNT('tmpReceive') > 0
			
				SET TALK OFF
				SUM ActualW TO m.nPast_LBS FOR ID <> ABS(nReceivingID)
				SUM R_QTY	TO m.nPast_QTY FOR ID <> ABS(nReceivingID)
				SUM Pieces	TO m.nPast_PC  FOR ID <> ABS(nReceivingID)
				
				ThisForm.txtPast_LBS.Value = ROUND(m.nPast_LBS,1)
				ThisForm.txtPast_QTY.Value = PrepareSQLnum(m.nPast_QTY,'QTY',-5)
				ThisForm.txtPast_PC.Value = ROUND(m.nPast_PC,0)
				GO TOP
				
				ThisForm.edtAllDescription.Value = tmpReceive.Description
				ThisForm.grdReceive.RecordSource = 'tmpReceive'
				
				IF nReceivingID > 0
					ThisForm.grdReceive.SetAll("dynamicbackcolor","IIF(ID="+STR(nReceivingID)+",RGB(128,255,128),IIF(tmpReceive.cancelled, RGB(255,255,255), RGB(0,205,128)))", "Column")
				ELSE
					ThisForm.grdReceive.SetAll("dynamicbackcolor","IIF(tmpReceive.cancelled, RGB(255,255,255), RGB(0,205,128))", "Column")
				ENDIF
				
				ThisForm.grdReceive.Visible = .T.
			ENDIF
			*USE IN tmpReceive
		ENDIF
		
		IF nReceivingID < 0
			*Change Screen to an EDIT -not Add!
		*!*		ThisForm.Shape1.Visible = .F.
		*!*		ThisForm.lblThisReceive.Visible = .F.
		*!*		ThisForm.lblAlloy.Visible = .F.
		*!*		ThisForm.txtAlloy.Visible = .F.
		*!*		ThisForm.lblHeat.Visible = .F.
		*!*		ThisForm.txtHeat.Visible = .F.
		*!*		ThisForm.lblPieces.Visible = .F.
		*!*		ThisForm.txtPC_Recv.Visible = .F.
		*!*		ThisForm.lblActualLbs.Visible = .F.
		*!*		ThisForm.txtActualW.Visible = .F.
		*!*		ThisForm.lblDescript.Visible = .F.
		*!*		ThisForm.edtDescription.Visible = .F.
			
			ThisForm.cmdJustEdit.Visible = .T.
			
			*Might need to change these
			*ThisForm.cmdCancel.Visible = .F.
			*ThisForm.cmdGood.Visible = .F.
			*ThisForm.cmdGoodCmplt.Visible = .F.
			
			SELECT tmpReceive
			LOCATE FOR ID = nReceivingID 
		ELSE
		
			IF NOT EMPTY(cHeat)
				SELECT tmpReceive
				LOCATE FOR Heat = cHeat
			ENDIF
		ENDIF
		
		
		***********************
		* Calc Diff
		*
		PRIVATE nS_QTY, nOrder_LBS, nRcv_HPA_QTY, nQTY_Need, lOrderItemDone
		nS_QTY 	= PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',9,1)
		nOrder_LBS	= PrepareSQLnum(ThisForm.txtOrder_LBS.Value,'Pounds',9,1)
		nRcv_HPA_QTY = PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'R_QTY',9,1)
		nReceive_LBS = PrepareSQLnum(ThisForm.txtActualW.Value,'Pounds',9,1) 
		PRIVATE nPieces, nPC_Recv, nPC_Need
		nPieces		= PrepareSQLnum(ThisForm.txtPiecesPO.Value,'PC',-3)
		nPC_Recv	= PrepareSQLnum(ThisForm.txtPC_Recv.Value,'PC',-3)
		nPC_Need	= PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC',-3)
		nPC_Need	= ROUND( nPieces - nPC_Recv - nPast_PC, 0)
		
		nQTY_Need 	= IIF(nS_QTY - m.nPast_QTY - nRcv_HPA_QTY > 0,nS_QTY - m.nPast_QTY - nRcv_HPA_QTY,0)
		nLBS_Need	= ROUND( IIF(nOrder_LBS - m.nPast_LBS - nReceive_LBS > 0,nOrder_LBS - m.nPast_LBS - nReceive_LBS,0) ,1)
		
		
		ThisForm.txtQTY_Need.Value = ABS(nQTY_Need)
		ThisForm.txtLBS_Need.Value = ABS(nLBS_Need)
		ThisForm.txtPC_Need.Value = ABS(nPC_Need)
		
		PRIVATE cMess_WO_Detail, cMess_POitem, cMess_ReceiveID
		cMess_WO_Detail = ''
		cMess_POitem	= ''
		cMess_ReceiveID = ''
		IF nWO_Detail > 0
			cMess_WO_Detail = "WO Detail is "+ALLTRIM(STR(nWO_Detail))+". This can be very random."+CHR(13)
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				cMess_POitem = "PO Item is "+ALLTRIM(cPOitem)+"."+CHR(13)
			ENDIF
		ELSE
			cMess_POitem = "PO Item is "+ALLTRIM(cPOitem)+"."+CHR(13)
		ENDIF
		
		IF ThisForm.nReceivingID > 0
			cMess_POitem = "Recieve ID is "+ALLTRIM(STR(ThisForm.nReceivingID))+"."+CHR(13)
		
		ENDIF
		
		PRIVATE cMess
		*Show Red if need more than 20% 
		DO CASE
		CASE (m.nPast_QTY + nRcv_HPA_QTY) >= nS_QTY
			lOrderItemDone = .T.
		CASE ( (m.nPast_QTY + nRcv_HPA_QTY + 5 ) > (nS_QTY+5) * 1.2 ) OR ( (m.nPast_QTY + nRcv_HPA_QTY +5 ) * 1.2 < (nS_QTY+5) )
			cMess = "Receive DID NOT complete expected QTY "+CHR(13)
			cMess = cMess+" --or within 20% of complete"+CHR(13)
			cMess = cMess+"Complete QTY: "+ALLTRIM(STR(nS_QTY))+CHR(13)+CHR(13)
			cMess = cMess+"Recv QTY: "+ALLTRIM(STR((m.nPast_QTY + nRcv_HPA_QTY )))+CHR(13)
			*cMess = cMess+"Recv QTY*1.2: "+ALLTRIM(STR((m.nPast_QTY + nRcv_HPA_QTY + 5 )*1.2))+" > "+ALLTRIM(STR((nS_QTY+5) ))+" expected "+CHR(13)
			MESSAGEBOX(cMess+CHR(13)+cMess_WO_Detail+cMess_POitem+cMess_ReceiveID,32,"QTY Math")
			
		*	MESSAGEBOX( "(m.nPast_QTY + nRcv_HPA_QTY + 5 )"+" > (nS_QTY+5) * 1.2 ) ",32,"QTY Math")
		*	MESSAGEBOX( "( (m.nPast_QTY + nRcv_HPA_QTY +5 ) * 1.2 "+ALLTRIM(STR(nS_QTY+5 * 1.2))+" < (nS_QTY+5) "+ALLTRIM(STR(nS_QTY+5)),32,"Pounds Math")
				ThisForm.lblOrder_QTY.BackColor = RGB(255,0,0)
				ThisForm.lblQTY_Diff.BackColor = RGB(255,0,0)
				lOrderItemDone = .F.
		CASE ( (m.nPast_LBS + nReceive_LBS + 5 ) > (nOrder_LBS+5) * 1.2 ) OR ( (m.nPast_LBS + nReceive_LBS +5 ) * 1.2 < (nOrder_LBS+5) )
			cMess = "Receive DID NOT complete expected LBS "+CHR(13)
			cMess = cMess+" --or within 20% complete"+CHR(13)
			cMess = cMess+"Complete LBS: "+ALLTRIM(STR(nS_QTY))+CHR(13)+CHR(13)
			cMess = cMess+"Recv LBS: "+ALLTRIM(STR((m.nPast_LBS + nReceive_LBS )))+CHR(13)
			*cMess = cMess+"Recv LBS*1.2: "+ALLTRIM(STR((m.nPast_LBS + nReceive_LBS + 5 )*1.2))+" > "+ALLTRIM(STR(((m.nPast_LBS + nReceive_LBS +5 ) * 1.2)))+" expected "+CHR(13)
			MESSAGEBOX(cMess+CHR(13)+cMess_WO_Detail+cMess_POitem+cMess_ReceiveID,32,"LBS Math")
		
		*	MESSAGEBOX( "(m.nPast_LBS + nReceive_LBS + 5) "+ALLTRIM(STR(m.nPast_LBS + nReceive_LBS + 5))+" > ((nOrder_LBS+5) * 1.2 "+ALLTRIM(STR(((nOrder_LBS+5) * 1.2))),32,"QTY Math")
		*	MESSAGEBOX( "(m.nPast_LBS + nReceive_LBS + 5 ) * 1.2 "+ALLTRIM(STR((m.nPast_LBS + nReceive_LBS +5 ) * 1.2))+" < (nOrder_LBS+5) "+ALLTRIM(STR((nOrder_LBS+5))),32,"Pounds Math")
		
				ThisForm.lblOrder_QTY.BackColor = RGB(255,0,0)
				ThisForm.lblQTY_Diff.BackColor = RGB(255,0,0)
				lOrderItemDone = .F.
		OTHERWISE
				lOrderItemDone = .T.
		ENDCASE
		
		*Show Red if need more than 20% 
		
			*240,240,240
			ThisForm.lblPounds.BackColor = RGB(255,0,0)
		
		
		***************************
		*Check for Complete	(WOD and POitem)
		
		PRIVATE nCNT
		IF nWO_Detail > 0
			*Read WorkOrder_Detail
			
			IF Count_WODinWO_Detail( nWO_Detail, ThisForm.nConnHandle, "CANCELLED" ) > 0
				cMess = "This WO_Detail '"+ALLTRIM(STR(nWO_Detail))+"' is listed as 'Cancelled' in dbo.WorkOrder_Detail."
				MESSAGEBOX(cMess,32,"Why Receive a Cancelled WO_Detail?")
				cMess = cMess+CHR(13)+"ReceivingID = "+ALLTRIM(STR(ThisForm.nReceivingID))
				TrackError(cMess,"Should not have a receive!", PROGRAM(), LINENO(1))
			ENDIF
			
			IF Count_WODinWO_Detail( nWO_Detail, ThisForm.nConnHandle, "COMPLETE" ) > 0
				ThisForm.ogPOitem.Value = 1
				
				IF ThisForm.nReceivingID = 0
					*New Receive, not an Edit!
					cMess = "This WO_Detail '"+ALLTRIM(STR(nWO_Detail))+"' is listed as 'Complete' in dbo.WorkOrder_Detail."
					MESSAGEBOX(cMess,32,"Why Receive a Complete WO_Detail?")
					cMess = cMess+CHR(13)+"ReceivingID = "+ALLTRIM(STR(ThisForm.nReceivingID))
					TrackError(cMess,"Should not have a NEW receive!", PROGRAM(), LINENO(1))
				ENDIF
			ELSE
				ThisForm.ogPOitem.Value = 2
			ENDIF
		ELSE
			*Read PurchaseOrder
			
			IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "CANCELLED" ) > 0
				cMess = "This POitem '"+cPOitem+"' is listed as 'Cancelled' in dbo.PurchaseOrder."
				MESSAGEBOX(cMess,32,"Why Receive a Cancelled Poitem?")
				cMess = cMess+CHR(13)+"ReceivingID = "+ALLTRIM(STR(ThisForm.nReceivingID))
				TrackError(cMess,"Should not have a receive!", PROGRAM(), LINENO(1))
			ENDIF
			
		*	IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "DELIVERED" ) > 0
		*		*Reconciled - TOO general, each receive will be reconciled
		*	ENDIF
			IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "COMPLETE" ) > 0
				ThisForm.ogPOitem.Value = 1
				
				IF ThisForm.nReceivingID = 0
					*New Receive, not an Edit!
					cMess = "This POitem '"+cPOitem+"' is listed as 'Complete' in dbo.PurchaseOrder."
					MESSAGEBOX(cMess,32,"Why Receive a Complete Poitem?")
					cMess = cMess+CHR(13)+"Edit ReceivingID = "+ALLTRIM(STR(ThisForm.nReceivingID))
					TrackError(cMess,"Should not have a NEW receive!", PROGRAM(), LINENO(1))
				ENDIF
			ELSE
				ThisForm.ogPOitem.Value = 2
			ENDIF
		ENDIF
		
		IF lOrderItemDone
			*Look for "INCOMING" process
			IF nWO_Detail > 0
				*Look for "INCOMING" process on WO_Detail
				nCNT = StockLst_Process_Count_WOD( nWO_Detail, 'S', ThisForm.nConnHandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" is Complete in dbo.WorkOrder_Detail, but has a StockLst 'INCOMING'.")
					ThisForm.ogPOitem.Value = 2
				ENDIF
				nCNT = StockLst_Process_Count_WOD( nWO_Detail, 'B', ThisForm.nConnHandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" is Complete in dbo.WorkOrder_Detail, but has a BrokerLst 'INCOMING'.")
					ThisForm.ogPOitem.Value = 2
				ENDIF
				nCNT = StockLst_Process_Count_WOD( nWO_Detail, 'W', ThisForm.nConnHandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" is Complete in dbo.WorkOrder_Detail, but has a WIPLst 'INCOMING'.")
					ThisForm.ogPOitem.Value = 2
				ENDIF
			ELSE
				*Look for "INCOMING" process on POitem
				nCNT = StockLst_Process_Count_POitem( cPOitem, 'S', ThisForm.nConnHandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' is Complete in PurchaseOrder, but has a StockLst 'INCOMING'.")
					ThisForm.ogPOitem.Value = 2
				ENDIF
				nCNT = StockLst_Process_Count_POitem( cPOitem, 'B', ThisForm.nConnHandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' is Complete in PurchaseOrder, but has a BrokerLst 'INCOMING'.")
					ThisForm.ogPOitem.Value = 2
				ENDIF
				nCNT = StockLst_Process_Count_POitem( cPOitem, 'W', ThisForm.nConnHandle, "INCOMING")
				IF nCNT > 0
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' is Complete in PurchaseOrder, but has a WIPLst 'INCOMING'.")
					ThisForm.ogPOitem.Value = 2
				ENDIF
			ENDIF
		ENDIF
		
		*Compare with Receiving totals
		IF nWO_Detail > 0
			*Compare with Receiving totals
			IF lOrderItemDone
				IF ThisForm.ogPOitem.Value = 1
					*Good
				ELSE
					ThisForm.ogPOitem.Value = 1
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" dbo.WorkOrder_Detail Calculations predict done, but marked as NOT Done."+CHR(13)+" ReceivingID = "+ALLTRIM(STR(ThisForm.nReceivingID)))
				ENDIF
			ELSE
				IF ThisForm.ogPOitem.Value = 1
					ThisForm.ogPOitem.Value = 2
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"WO_Detail "+ALLTRIM(STR(nWO_Detail))+" dbo.WorkOrder_Detail Calculations predict NOT done, but marked as Done."+CHR(13)+" ReceivingID = "+ALLTRIM(STR(ThisForm.nReceivingID)))
				ELSE
					*Good
				ENDIF
			ENDIF
			
		ELSE
			*Compare with Receiving totals
			IF lOrderItemDone
				IF ThisForm.ogPOitem.Value = 1
					*Good
				ELSE
					ThisForm.ogPOitem.Value = 1
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' dbo.Receive Calculations predict done, but marked as NOT Done."+CHR(13)+" ReceivingID = "+ALLTRIM(STR(ThisForm.nReceivingID)))
				ENDIF
			ELSE
				IF ThisForm.ogPOitem.Value = 1
					ThisForm.ogPOitem.Value = 2
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"POitem '"+cPOitem+"' dbo.Receive Calculations predict NOT done, but marked as Done."+CHR(13)+" ReceivingID = "+ALLTRIM(STR(ThisForm.nReceivingID)))
				ELSE
					*Good
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE insert_incomproc
		*ThisForm.Insert_IncomProc()
		
		
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisForm.nReceivingID,'ReceivingID',-3)
		
		IF nReceivingID < 1
			*need ReceivingID
			*POitem is too vague
			RETURN .F.
		ENDIF
		
		
		PRIVATE nQTY, nPounds, cPrc_Form, nPrc_PCs 
		nQTY = PrepareSQLnum(ThisForm.txtQTY_Need.Value,'QTY',-5)
		
		nPounds = PrepareSQLnum(ThisForm.txtPast_LBS.Value,'Pounds',-3)
		cPrc_Form = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nPrc_PCs = PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC',-3)
		
		
		cSQL = " INSERT INTO "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		ENDCASE
		*cSQL = cSQL + " SET [Process_ID]='RECEIVED' "
		
		cSQL = cSQL + " WHERE ReceivingID = "+STR(nReceivingID)
		cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PartRecv' )"
		
		*!*	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
		*!*		RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		*!*	ELSE
			TrackError("Why would you want this to run? "+CHR(13)+"ThisForm.Insert_IncomProc()"+CHR(13)+cSQL ,"Why would you want this to run?", PROGRAM(), LINENO(1))
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE lst_detail_clone
		PARAMETERS nNewID, nOld_ID_Detail
		*ThisForm.Lst_Detail_Clone
		
		PRIVATE nQTY
		nQTY = PrepareSQLnum(ThisForm.txtRcv_QTY.Value,'QTY',-5)
		
		PRIVATE nNewID_Detail, nNewID_Detail1, nNewID_Detail2
		nNewID_Detail = 0
		nNewID_Detail1 = 0
		nNewID_Detail2 = 0
		
		IF USED('tmpNewID')
			SELECT tmpNewID
		ELSE 
			SELECT 0
		ENDIF
		
		cSQL = "EXEC dbo.p_Lst_Detail_Clone "
		cSQL = cSQL + "	@ID="+STR(nNewID)
		cSQL = cSQL + " ,@ID_Detail="+STR(nOld_ID_Detail)
		cSQL = cSQL + " ,@TBL='"+ThisForm.cTBL+"'"
		cSQL = cSQL + " ,@mS_QTY="+STR(nQTY,18,4)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpNewID')
			RecordError(nSQLEXEC,"p_Lst_Detail_Clone Failed",PROGRAM(),LINENO(1),cSQL )
		ENDIF
		
		*************************************
		*"EXEC dbo.p_Lst_Detail_Clone " can create 3 Tables
		*check with all 3
		
		IF USED('tmpNewID2')	
			IF RECCOUNT('tmpNewID2') > 0
				nNewID_Detail2 = PrepareSQLnum(tmpNewID2.EXP,'ID',-3)
				*MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail2))+" in TBL='"+cTBL+"'",0,'Cloned Incoming ID')
				USE IN tmpNewID2
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
		*	TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID1')	
			IF RECCOUNT('tmpNewID1') > 0
				nNewID_Detail1 = PrepareSQLnum(tmpNewID1.EXP,'ID',-3)
				IF nNewID_Detail2 = 0 
					*MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail1))+" in TBL='"+cTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID1
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
		*	TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID')	
			IF RECCOUNT('tmpNewID') > 0
				nNewID_Detail = PrepareSQLnum(tmpNewID.EXP,'ID',-3)
				IF nNewID_Detail2 = 0 AND nNewID_Detail1 = 0
					*MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail))+" in TBL='"+cTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID"+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID"+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		***********************
		IF nNewID_Detail + nNewID_Detail1 + nNewID_Detail2 = 0
			MESSAGEBOX("Could not Clone/Create new DETAIL Stock record",16,"Error")
			TrackError("Could not Clone/Create new DETAIL Stock record "+CHR(13)+"TBL "+ThisForm.cTBL+CHR(13)+"ID= "+STR(nNewID)+CHR(13)+"New QTY "+STR(nQTY),"Could not Create new DETAIL Stock record "+CHR(13)+cSQL, PROGRAM(), LINENO(1))
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID_Detail"+CHR(13)+cSQL) 
		ENDIF
		
		IF nNewID_Detail2 > 0
			RETURN nNewID_Detail2
		ENDIF
		IF nNewID_Detail1 > 0
			RETURN nNewID_Detail1
		ENDIF
		
		RETURN nNewID_Detail 
		
		
		
	ENDPROC

	PROCEDURE lst_detail_ins
		PARAMETERS nNewID
		*ThisForm.Lst_Detail_INS
		
		PRIVATE nPCS, nDim1, nPounds, nReceivingID, nQTY, nS_PU
		nPCS	= PrepareSQLnum(ThisForm.txtPC_Recv.Value,'PC',-3)
		nDim1	= PrepareSQLnum(ThisForm.txtThck.Value,'DIM1',10,4)
		nPounds	= PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)
		nReceivingID = PrepareSQLnum(ThisForm.nReceivingID,'ReceivingID',9,1)
		nQTY	= PrepareSQLnum(ThisForm.txtThck.Value,'DIM1',10,4)
		nS_PU	= nPU_Acct_Form(PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2),ThisForm.nConnHandle)
		
		
		PRIVATE nNewID_Detail 
		nNewID_Detail = 0
		
		IF USED('tmpNewID')
			SELECT tmpNewID
		ELSE 
			SELECT 0
		ENDIF
		
		cSQL = "EXEC dbo.p_Lst_Detail_INS "
		cSQL = cSQL + " @TBL='"+ThisForm.cTBL+"'"
		*	@size_h		decimal(9, 4),
		*	@size_l		decimal(9, 4),
		cSQL = cSQL + ",@pc	= "+STR(nPCS)
		cSQL = cSQL + ",@dim1 = "+STR(		18, 4)
		*	@dim2		decimal(18, 4),
		*	@dim3		decimal(18, 4),
		*	@length		varchar(160),
		cSQL = cSQL + ",@weight = "+STR(	9,1)
		
		*	@descript	varchar(20),
		*	@location	varchar(10),
		*	@floorstatus	char(1),
		*	@class		char(1),
		*	@RandLen	BIT,
		cSQL = cSQL + ",@ID="+STR(nNewID)
		*	@ID_Detail_Process int,
		cSQL = cSQL + ",@ReceivingID= "+STR(nReceivingID)
		cSQL = cSQL + ",@S_QTY="+STR(nQTY,18,4)
		*	@S_P		decimal(18, 4),
		*	@S_TOTAL
		cSQL = cSQL + ",@S_PU = "+STR(nS_PU)
			
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpNewID')
			RecordError(nSQLEXEC,"p_Lst_Detail_Clone Failed",PROGRAM(),LINENO(1),cSQL )
		ENDIF
		
		*************************************
		*"EXEC dbo.p_Lst_Detail_INS " can create 3 Tables
		*check with all 3
		
		IF USED('tmpNewID2')	
			IF RECCOUNT('tmpNewID2') > 0
				nNewID_Detail2 = PrepareSQLnum(tmpNewID2.EXP,'ID',-3)
		*		MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail2))+" in TBL='"+ThisForm.cTBL+"'",0,'Cloned Incoming ID')
				USE IN tmpNewID2
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID1')	
			IF RECCOUNT('tmpNewID1') > 0
				nNewID_Detail1 = PrepareSQLnum(tmpNewID1.EXP,'ID',-3)
				IF nNewID_Detail2 = 0
		*			MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail1))+" in TBL='"+ThisForm.cTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID1
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID')	
			IF RECCOUNT('tmpNewID') > 0
				nNewID_Detail = PrepareSQLnum(tmpNewID.EXP,'ID',-3)
			ELSE
				IF nNewID_Detail2 =0 AND nNewID_Detail1 = 0
		*			MESSAGEBOX("Could not Create new Detail Stock record",16,"Error")
				ENDIF
				*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID"+CHR(13)+cSQL) 
				TrackError("Could not Create new Detail Stock record "+CHR(13)+"TBL "+ThisForm.cTBL+CHR(13)+"New ID= "+STR(nNewID)+CHR(13)+"New QTY "+STR(nQTY_Need),"Could not Create new Detail Stock record ", PROGRAM(), LINENO(1))
			ENDIF
			USE IN tmpNewID
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID","Detail Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		***********************
		IF nNewID_Detail + nNewID_Detail1 + nNewID_Detail2 = 0
			MESSAGEBOX("Could not Inser/Create new DETAIL Stock record",16,"Error")
			TrackError("Could not Inser/Create new DETAIL Stock record "+CHR(13)+"TBL "+ThisForm.cTBL+CHR(13)+"ID= "+STR(nNew_ID)+CHR(13)+"New QTY "+STR(nQTY),"Could not Create new DETAIL Stock record ", PROGRAM(), LINENO(1))
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID_Detail"+CHR(13)+cSQL) 
		ENDIF
		
		IF nNewID_Detail2 > 0
			RETURN nNewID_Detail2
		ENDIF
		IF nNewID_Detail1 > 0
			RETURN nNewID_Detail1
		ENDIF
		
		RETURN nNewID_Detail 
		
	ENDPROC

	PROCEDURE lst_master_clone
		PARAMETERS pcTBL,nOld_ID,nQTY_Rcv,cHeat,cLot
		*ThisForm.Lst_Master_Clone()
		
		*p_Lst_Master_Clone RETURNS 3 Tables ?!?
		PRIVATE nNewID, nNewID1, nNewID2
		nNewID = 0
		nNewID1 = 0
		nNewID2 = 0
		
		nQTY_Rcv	= PrepareSQLnum(nQTY_Rcv,'QTY',-5)
		cHeat		= PrepareSQLtxt(cHeat,'Heat',50)
		cLot		= PrepareSQLtxt(cLot,'Lot',10)
		
		IF USED('tmpNewID')
			SELECT tmpNewID
		ELSE 
			SELECT 0
		ENDIF
		
		cSQL = "EXEC dbo.p_Lst_Master_Clone "
		cSQL = cSQL + "	@ID="+STR(nOld_ID)
		cSQL = cSQL + ",@TBL='"+pcTBL+"'"
		cSQL = cSQL + ",@mS_QTY="+STR(nQTY_Rcv)
		cSQL = cSQL + ",@Heat='"+cHeat+"'"
		cSQL = cSQL + ",@Lot='"+cLot+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpNewID')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),"p_Lst_Master_Clone Returned Zero: "+cSQL )
			TrackError("Returned Zero: SQL Transaction will be Rolled Back"+CHR(13)+CHR(13)+cSQL,"Could not Clone!",PROGRAM(),LINENO(1))
			RETURN 0
		ENDIF
		
		*************************************
		*XEC dbo.p_Lst_Master_Clone2 can create 3 tables
		*check with all 3
		
		IF USED('tmpNewID2')	
			IF RECCOUNT('tmpNewID2') > 0
				nNewID2 = PrepareSQLnum(tmpNewID2.EXP,'ID',-3)
				*MESSAGEBOX("Created a new Master ID for this Received data "+ALLTRIM(STR(nNewID2))+" in TBL='"+pcTBL+"'",0,'Cloned Incoming ID')
				USE IN tmpNewID2
			ELSE
				TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID2"+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			*TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID1')	
			IF RECCOUNT('tmpNewID1') > 0
				nNewID1 = PrepareSQLnum(tmpNewID1.EXP,'ID',-3)
				IF nNewID2  = 0
				*	MESSAGEBOX("Created a new Master ID for this Received data "+ALLTRIM(STR(nNewID1))+" in TBL='"+pcTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID1
			ELSE
				TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID1"+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			*TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID')	
			IF RECCOUNT('tmpNewID') > 0
				nNewID = PrepareSQLnum(tmpNewID.EXP,'ID',-3)
				IF nNewID2 = 0 AND nNewID1 = 0
				*	MESSAGEBOX("Created a new Master ID for this Received data "+ALLTRIM(STR(nNewID))+" in TBL='"+pcTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID
			ELSE
				TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID"+CHR(13)+"nNewID1="+STR(nNewID1)+" nNewID2="+STR(nNewID2)+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID"+CHR(13)+"nNewID1="+STR(nNewID1)+" nNewID2="+STR(nNewID2)+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		***********************
		IF nNewID + nNewID1 + nNewID2 = 0
			MESSAGEBOX("Could not Create new MASTER Stock record",16,"Error")
			cMess = "Could not Create new MASTER Stock record "+CHR(10)+CHR(13)+"TBL "+pcTBL+CHR(13)+"ID= "+STR(nOld_ID)+CHR(10)+CHR(13)
			cMess = cMess + "Recv QTY "+STR(nQTY_Rcv)+CHR(10)+CHR(13) +CHR(10)+CHR(13)
			cMess = cMess + "@Heat='"+cHeat+"'"+CHR(10)+CHR(13)
			cMess = cMess + ",@Lot='"+cLot+"'"+CHR(10)+CHR(13) +CHR(10)+CHR(13)
			cMess = cMess + "Looked over 3 SQL returns."+CHR(10)+CHR(13) +CHR(10)+CHR(13)
			cMess = cMess + cSQL +CHR(10)+CHR(13)
			
			TrackError(cMess,"Could not Create new MASTER Stock record ", PROGRAM(), LINENO(1))
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID from p_Lst_Master_Clone ."+CHR(13)+cSQL) 
		ENDIF
		
		IF nNewID2 > 0
			RETURN nNewID2
		ENDIF
		IF nNewID1 > 0
			RETURN nNewID1
		ENDIF
		*ELSE
		RETURN nNewID 
		
	ENDPROC

	PROCEDURE marksoitemcomplete
		PARAMETERS lComplete
		*ThisForm.MarkSOitemComplete(.T.)
		
		*nCnt = Count_POIteminPurchaseOrder( ThisForm.cPOItem, ThisForm.nConnHandle, "DELIVERED" )
		PRIVATE cPOItem
		cPOitem = Proper_PO_item(ThisForm.cPOItem)
		IF cPOitem = Proper_PO_item("")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, cMess
		
		IF lComplete
			cSQL = "UPDATE dbo.PurchaseOrder "
			cSQL = cSQL+" SET Delivered = 1 "
			cSQL = cSQL+" ,[Cmplt] = 1"
			cSQL = cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOItem+"')"
			cMess = "POitem '"+cPOItem+"' was set to COMPLETE on Show Received VS Ordered screen."
		ELSE
			cSQL = "UPDATE dbo.PurchaseOrder SET [Cmplt] = 0 "
			cSQL = cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOItem+"')"
			cMess = "POitem '"+cPOItem+"' was set to NOT COMPLETE on Show Received VS Ordered screen."
		ENDIF
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			RETURN .F.
		ENDIF
		
		***************************************
		TrackMess(cMess)
		
		***************************************
		cSQL = "INSERT INTO dbo.PO_Item_Notes "
		cSQL = cSQL+ " ([POitem],[Notes]) VALUES ("
		cSQL = cSQL+ "'"+cPOItem+"','"+PrepareSQLtxt(cMess,'mess',-1)+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			*RETURN .F.
		ENDIF
		
		RETURN .T.
		
		
	ENDPROC

