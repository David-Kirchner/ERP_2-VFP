		*!*					cSQL_Detail_Update = cSQL_Detail_Update +",S_QTY = " 	+ STR(nStockLst_QTY,18,4) + ""
		*!*					cSQL_Detail_Update = cSQL_Detail_Update +",S_P = " 		+ STR(nStockLst_P,18,4) + ""
		*!*					cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = "  + STR(nS_Total,18,4) + ""
		*!*					cSQL_Detail_Update = cSQL_Detail_Update +",S_PU = " 	+ STR(nS_PU) + ""
		
