	PROCEDURE Load
		LOCAL lcRoot
		lcRoot = ADDBS(SYS(5) + SYS(2003))
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\proc_setup.prg") ADDITIVE
		ENDIF
		IF NOT "LOAD_COMPANYPROFILE" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\load_CompanyProfile.prg") ADDITIVE
		ENDIF
		IF NOT "COMPANY_BRANDING" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\company_branding.prg") ADDITIVE
		ENDIF
		IF NOT "LOAD_COMPANYPLANTS" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\load_CompanyPlants.prg") ADDITIVE
		ENDIF
		IF NOT "COMPANY_REPORT" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\company_report.prg") ADDITIVE
		ENDIF
		SET PROCEDURE TO (lcRoot + "PROGS\CompanyProfile_maint.prg") ADDITIVE
	ENDPROC

	PROCEDURE Init
		This.nConnHandle = get_SQLSTRINGCONNECT()
		DO PROGS\load_CompanyProfile
		DO PROGS\load_CompanyPlants
		This.LoadData()
		This.LoadPlantData()
		This.RefreshLogoPreview()
	ENDPROC

	PROCEDURE LoadPlantData
		LOCAL lo
		This.cWF_ReportLine = ""
		This.cWF_Phone = ""
		This.cWF_Fax = ""
		This.cWF_Cage = ""
		This.cTP_ReportLine = ""
		This.cTP_Cage = ""
		This.nWF_PlantId = 0
		This.nTP_PlantId = 0
		IF VARTYPE(goCompanyPlants) # "O"
			DO PROGS\load_CompanyPlants
		ENDIF
		IF VARTYPE(goCompanyPlants) # "O"
			RETURN
		ENDIF
		TRY
			lo = goCompanyPlants.Item("WINDFALL")
			This.nWF_PlantId = lo.PlantId
			This.cWF_ReportLine = lo.CertReportLine
			This.cWF_Phone = lo.Phone
			This.cWF_Fax = lo.Fax
			This.cWF_Cage = lo.CageCode
		CATCH
		ENDTRY
		TRY
			lo = goCompanyPlants.Item("TIPTON")
			This.nTP_PlantId = lo.PlantId
			This.cTP_ReportLine = lo.CertReportLine
			This.cTP_Cage = lo.CageCode
		CATCH
		ENDTRY
	ENDPROC

	PROCEDURE SavePlantData
		LOCAL lcSQL, nRet
		IF Thisform.nConnHandle < 1
			Thisform.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		IF Thisform.nWF_PlantId > 0
			lcSQL = "UPDATE dbo.CompanyPlant SET "
			lcSQL = lcSQL + "CertReportLine = "+CompanyProfile_SQLQuote(Thisform.cWF_ReportLine)+", "
			lcSQL = lcSQL + "Phone = "+CompanyProfile_SQLQuote(Thisform.cWF_Phone)+", "
			lcSQL = lcSQL + "Fax = "+CompanyProfile_SQLQuote(Thisform.cWF_Fax)+", "
			lcSQL = lcSQL + "CageCode = "+CompanyProfile_SQLQuote(Thisform.cWF_Cage)+", "
			lcSQL = lcSQL + "ModifiedDate = SYSDATETIME() "
			lcSQL = lcSQL + "WHERE PlantId = "+TRANSFORM(Thisform.nWF_PlantId)
			nRet = SQLEXEC(Thisform.nConnHandle, lcSQL)
		ENDIF
		IF Thisform.nTP_PlantId > 0
			lcSQL = "UPDATE dbo.CompanyPlant SET "
			lcSQL = lcSQL + "CertReportLine = "+CompanyProfile_SQLQuote(Thisform.cTP_ReportLine)+", "
			lcSQL = lcSQL + "CageCode = "+CompanyProfile_SQLQuote(Thisform.cTP_Cage)+", "
			lcSQL = lcSQL + "ModifiedDate = SYSDATETIME() "
			lcSQL = lcSQL + "WHERE PlantId = "+TRANSFORM(Thisform.nTP_PlantId)
			nRet = SQLEXEC(Thisform.nConnHandle, lcSQL)
		ENDIF
		DO PROGS\load_CompanyPlants WITH .T.
	ENDPROC

	PROCEDURE LoadData
		LOCAL laP[11], i, lcP, lcProp, xVal
		IF VARTYPE(goCompany) # "O"
			DO PROGS\load_CompanyProfile
		ENDIF
		IF VARTYPE(goCompany) # "O"
			RETURN
		ENDIF
		laP[1] = "LegalName"
		laP[2] = "DBAName"
		laP[3] = "ShortName"
		laP[4] = "Tagline"
		laP[5] = "SalesEmail"
		laP[6] = "QualityEmail"
		laP[7] = "Website"
		laP[8] = "CageCode"
		laP[9] = "CertHeaderText"
		laP[10] = "CertCertifyText"
		laP[11] = "CertFooterText"
		FOR i = 1 TO ALEN(laP)
			lcP = laP[i]
			lcProp = "c" + lcP
			IF PEMSTATUS(goCompany, lcP, 5)
				xVal = EVALUATE("goCompany." + lcP)
				DO CASE
					CASE TYPE("xVal") = "C" OR TYPE("xVal") = "M"
						This.&lcProp. = IIF(ISNULL(xVal), "", xVal)
					CASE TYPE("xVal") = "U"
						This.&lcProp. = ""
					OTHERWISE
						This.&lcProp. = NVL(TRANSFORM(xVal), "")
				ENDCASE
			ENDIF
		ENDFOR
	ENDPROC

	PROCEDURE RefreshLogoPreview
		This.pgf1.pgLogo.imgLogoPreview.Picture = GetCompanyLogoPath()
	ENDPROC

	PROCEDURE cmdClose.Click
		Thisform.Release()
	ENDPROC

	PROCEDURE cmdReload.Click
		DO PROGS\load_CompanyProfile WITH .T.
		DO PROGS\load_CompanyPlants WITH .T.
		Thisform.LoadData()
		Thisform.LoadPlantData()
		Thisform.RefreshLogoPreview()
	ENDPROC

	PROCEDURE cmdSave.Click
		LOCAL lcSQL, nRet
		IF Thisform.nConnHandle < 1
			Thisform.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		lcSQL = "UPDATE dbo.CompanyProfile SET "
		lcSQL = lcSQL + "LegalName = "+CompanyProfile_SQLQuote(Thisform.cLegalName)+", "
		lcSQL = lcSQL + "DBAName = "+CompanyProfile_SQLQuote(Thisform.cDBAName)+", "
		lcSQL = lcSQL + "ShortName = "+CompanyProfile_SQLQuote(Thisform.cShortName)+", "
		lcSQL = lcSQL + "Tagline = "+CompanyProfile_SQLQuote(Thisform.cTagline)+", "
		lcSQL = lcSQL + "SalesEmail = "+CompanyProfile_SQLQuote(Thisform.cSalesEmail)+", "
		lcSQL = lcSQL + "QualityEmail = "+CompanyProfile_SQLQuote(Thisform.cQualityEmail)+", "
		lcSQL = lcSQL + "Website = "+CompanyProfile_SQLQuote(Thisform.cWebsite)+", "
		lcSQL = lcSQL + "CageCode = "+CompanyProfile_SQLQuote(Thisform.cCageCode)+", "
		lcSQL = lcSQL + "CertHeaderText = "+CompanyProfile_SQLQuote(Thisform.cCertHeaderText)+", "
		lcSQL = lcSQL + "CertCertifyText = "+CompanyProfile_SQLQuote(Thisform.cCertCertifyText)+", "
		lcSQL = lcSQL + "CertFooterText = "+CompanyProfile_SQLQuote(Thisform.cCertFooterText)+", "
		lcSQL = lcSQL + "ModifiedDate = SYSDATETIME() "
		lcSQL = lcSQL + "WHERE CompanyId = 1"
		nRet = SQLEXEC(Thisform.nConnHandle, lcSQL)
		IF nRet < 1
			MESSAGEBOX("Save failed. Check SQL connection and CompanyProfile table.", 16, "Company Profile")
			RETURN
		ENDIF
		Thisform.SavePlantData()
		DO PROGS\load_CompanyProfile WITH .T.
		MESSAGEBOX("Company profile saved.", 64, "Company Profile")
	ENDPROC

	PROCEDURE pgf1.pgLogo.cmdClearLogo.Click
		IF MESSAGEBOX("Remove company logo from database?", 4+32, "Company Profile") # 6
			RETURN
		ENDIF
		= CompanyBranding_ClearLogo(Thisform.nConnHandle)
		Thisform.RefreshLogoPreview()
	ENDPROC

	PROCEDURE pgf1.pgLogo.cmdPickLogo.Click
		LOCAL lcFile
		lcFile = GETFILE("jpg,png,gif,bmp", "Company logo", "Import", 0, "Choose company logo image")
		IF EMPTY(lcFile)
			RETURN
		ENDIF
		IF !CompanyBranding_SaveLogoFile(lcFile, Thisform.nConnHandle)
			MESSAGEBOX("Could not save logo to SQL. Check connection and CompanyProfile table.", 16, "Company Profile")
			RETURN
		ENDIF
		Thisform.RefreshLogoPreview()
		MESSAGEBOX("Logo saved. Open forms and reports will use the new image.", 64, "Company Profile")
	ENDPROC

ENDDEFINE
