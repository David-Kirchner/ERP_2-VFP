	PROCEDURE Init
		This.nConnHandle = get_SQLSTRINGCONNECT()
		DO PROGS\load_CompanyProfile
		This.LoadData()
		This.RefreshLogoPreview()
		This.RefreshIconPreview()
		This.RefreshReportBmpPreview()
	ENDPROC

	PROCEDURE Load
		LOCAL lcRoot
		lcRoot = ADDBS(SYS(5) + SYS(2003))
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\proc_setup.prg") ADDITIVE
		ENDIF
		IF NOT "LOAD_COMPANYPROFILE" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\load_CompanyProfile.prg") ADDITIVE
		ENDIF
		IF NOT "COMPANY_BRANDING" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO (lcRoot + "PROGS\company_branding.prg") ADDITIVE
		ENDIF
		SET PROCEDURE TO (lcRoot + "PROGS\CompanyProfile_maint.prg") ADDITIVE
	ENDPROC

	PROCEDURE loaddata
		LOCAL laP[11], i, lcP, lcProp, xVal
		IF VARTYPE(goCompany) # "O"
			DO PROGS\load_CompanyProfile
		ENDIF
		IF VARTYPE(goCompany) # "O"
			RETURN
		ENDIF
		laP[1] = "LegalName"
		laP[2] = "DBAName"
		laP[3] = "ShortName"
		laP[4] = "Tagline"
		laP[5] = "SalesEmail"
		laP[6] = "QualityEmail"
		laP[7] = "Website"
		laP[8] = "CageCode"
		laP[9] = "CertHeaderText"
		laP[10] = "CertCertifyText"
		laP[11] = "CertFooterText"
		FOR i = 1 TO ALEN(laP)
			lcP = laP[i]
			lcProp = "c" + lcP
			IF PEMSTATUS(goCompany, lcP, 5)
				xVal = EVALUATE("goCompany." + lcP)
				DO CASE
					CASE TYPE("xVal") = "C" OR TYPE("xVal") = "M"
						This.&lcProp. = IIF(ISNULL(xVal), "", xVal)
					CASE TYPE("xVal") = "U"
						This.&lcProp. = ""
					OTHERWISE
						This.&lcProp. = NVL(TRANSFORM(xVal), "")
				ENDCASE
			ENDIF
		ENDFOR
	ENDPROC

	PROCEDURE refreshiconpreview
		This.pgf1.pgLogo.imgIconPreview.Picture = GetCompanyIconPath()
	ENDPROC

	PROCEDURE refreshlogopreview
		This.pgf1.pgLogo.imgLogoPreview.Picture = GetCompanyLogoPath()
	ENDPROC

	PROCEDURE refreshreportbmppreview
		LOCAL lcPath
		lcPath = GetCompanyBmpPath()
		This.pgf1.pgLogo.imgReportBmpPreview.Picture = lcPath
	ENDPROC

	PROCEDURE cmdClose.Click
		Thisform.Release()
	ENDPROC

	PROCEDURE cmdReload.Click
		DO PROGS\load_CompanyProfile WITH .T.
		Thisform.LoadData()
		Thisform.RefreshLogoPreview()
		Thisform.RefreshIconPreview()
		Thisform.RefreshReportBmpPreview()
	ENDPROC

	PROCEDURE cmdSave.Click
		LOCAL lcSQL, nRet
		IF Thisform.nConnHandle < 1
			Thisform.nConnHandle = get_SQLSTRINGCONNECT()
		ENDIF
		lcSQL = "UPDATE dbo.CompanyProfile SET "
		lcSQL = lcSQL + "LegalName = "+CompanyProfile_SQLQuote(Thisform.cLegalName)+", "
		lcSQL = lcSQL + "DBAName = "+CompanyProfile_SQLQuote(Thisform.cDBAName)+", "
		lcSQL = lcSQL + "ShortName = "+CompanyProfile_SQLQuote(Thisform.cShortName)+", "
		lcSQL = lcSQL + "Tagline = "+CompanyProfile_SQLQuote(Thisform.cTagline)+", "
		lcSQL = lcSQL + "SalesEmail = "+CompanyProfile_SQLQuote(Thisform.cSalesEmail)+", "
		lcSQL = lcSQL + "QualityEmail = "+CompanyProfile_SQLQuote(Thisform.cQualityEmail)+", "
		lcSQL = lcSQL + "Website = "+CompanyProfile_SQLQuote(Thisform.cWebsite)+", "
		lcSQL = lcSQL + "CageCode = "+CompanyProfile_SQLQuote(Thisform.cCageCode)+", "
		lcSQL = lcSQL + "CertHeaderText = "+CompanyProfile_SQLQuote(Thisform.cCertHeaderText)+", "
		lcSQL = lcSQL + "CertCertifyText = "+CompanyProfile_SQLQuote(Thisform.cCertCertifyText)+", "
		lcSQL = lcSQL + "CertFooterText = "+CompanyProfile_SQLQuote(Thisform.cCertFooterText)+", "
		lcSQL = lcSQL + "ModifiedDate = SYSDATETIME() "
		lcSQL = lcSQL + "WHERE CompanyId = 1"
		nRet = SQLEXEC(Thisform.nConnHandle, lcSQL)
		IF nRet < 1
			MESSAGEBOX("Save failed. Check SQL connection and CompanyProfile table.", 16, "Company Profile")
			RETURN
		ENDIF
		DO PROGS\load_CompanyProfile WITH .T.
		IF TYPE("SetERPAppCaption") = "F"
			= SetERPAppCaption(Thisform.cShortName)
		ENDIF
		MESSAGEBOX("Company profile saved.", 64, "Company Profile")
	ENDPROC

	PROCEDURE pgf1.pgLogo.cmdClearLogo.Click
		IF MESSAGEBOX("Remove company logo from database?", 4+32, "Company Profile") # 6
			RETURN
		ENDIF
		= CompanyBranding_ClearLogo(Thisform.nConnHandle)
		Thisform.RefreshLogoPreview()
	ENDPROC

	PROCEDURE pgf1.pgLogo.cmdPickLogo.Click
		LOCAL lcFile
		lcFile = GETFILE("jpg,png,gif,bmp", "Company logo", "Import", 0, "Choose company logo image")
		IF EMPTY(lcFile)
			RETURN
		ENDIF
		IF !CompanyBranding_SaveLogoFile(lcFile, Thisform.nConnHandle)
			MESSAGEBOX("Could not save logo to SQL. Check connection and CompanyProfile table.", 16, "Company Profile")
			RETURN
		ENDIF
		Thisform.RefreshLogoPreview()
		MESSAGEBOX("Logo saved. Reports will use the new image.", 64, "Company Profile")
	ENDPROC

	PROCEDURE pgf1.pgLogo.cmdClearIcon.Click
		IF MESSAGEBOX("Remove company icon from database and restore default?", 4+32, "Company Profile") # 6
			RETURN
		ENDIF
		= CompanyBranding_ClearIcon(Thisform.nConnHandle)
		Thisform.RefreshIconPreview()
		IF TYPE("GetCompanyIconPath") = "F"
			_SCREEN.Icon = GetCompanyIconPath()
		ENDIF
	ENDPROC

	PROCEDURE pgf1.pgLogo.cmdPickIcon.Click
		LOCAL lcFile, lcIcon, lcRoot, lcOldDir
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, SYS(5)+SYS(2003)))
		lcOldDir = CURDIR()
		CD (lcRoot + "ICO")
		lcFile = GETFILE("ico", "Company icon", "Import", 0, "Choose company icon (.ico)")
		CD (lcOldDir)
		IF EMPTY(lcFile)
			RETURN
		ENDIF
		IF !CompanyBranding_SaveIconFile(lcFile, Thisform.nConnHandle)
			MESSAGEBOX("Could not save icon to SQL. Check connection and CompanyProfile table.", 16, "Company Profile")
			RETURN
		ENDIF
		Thisform.RefreshIconPreview()
		lcIcon = GetCompanyIconPath()
		IF !EMPTY(lcIcon)
			_SCREEN.Icon = lcIcon
		ENDIF
		MESSAGEBOX("Icon saved to MEM\Company_Icon.ico. ERP window and forms will use the new icon.", 64, "Company Profile")
	ENDPROC

	PROCEDURE pgf1.pgLogo.cmdClearReportBmp.Click
		IF MESSAGEBOX("Remove Company BMP from database?", 4+32, "Company Profile") # 6
			RETURN
		ENDIF
		IF !CompanyBranding_ClearReportBmp(Thisform.nConnHandle)
			MESSAGEBOX("Could not clear report BMP. Run MEM\SQL\Config\09_CompanyProfile_ReportImage.sql if columns are missing.", 16, "Company Profile")
			RETURN
		ENDIF
		Thisform.RefreshReportBmpPreview()
	ENDPROC

	PROCEDURE pgf1.pgLogo.cmdPickReportBmp.Click
		LOCAL lcFile, lcRoot, lcOldDir
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, SYS(5)+SYS(2003)))
		lcOldDir = CURDIR()
		IF DIRECTORY(lcRoot + "GRAPHICS")
			CD (lcRoot + "GRAPHICS")
		ENDIF
		lcFile = GETFILE("bmp", "Company BMP", "Import", 0, "Choose report header BMP")
		CD (lcOldDir)
		IF EMPTY(lcFile)
			RETURN
		ENDIF
		IF !CompanyBranding_SaveReportBmpFile(lcFile, Thisform.nConnHandle)
			MESSAGEBOX("Could not save report BMP. Choose a .bmp file and run MEM\SQL\Config\09_CompanyProfile_ReportImage.sql if needed.", 16, "Company Profile")
			RETURN
		ENDIF
		Thisform.RefreshReportBmpPreview()
		MESSAGEBOX("Company BMP saved to MEM\Company_BMP.bmp. Reports using CompanyReport_Bmp() will show this image.", 64, "Company Profile")
	ENDPROC

ENDDEFINE
