	PROCEDURE frmCA.pf1.pgEdit.chkCancel.Valid
		PRIVATE lCancelled, nCA_Detail_ID
		lCancelled = CA.cancelled
		nCA_No = CA.CA_No
		
		IF NOT lCancelled && The button has been click and new cancelled state exists
			IF MESSAGEBOX("Are you sure you want to UN cancel this CA?"+CHR(13)+ALLTRIM(STR(nCA_No)),4+32,"UN Cancel") = 6
		*		Cancel_CA_No( nCA_No, .F., ThisFormSet.nConnHandle)
			ELSE
				This.parent.chkCancel.Value = NOT lCancelled 
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to cancel this CA?"+CHR(13)+ALLTRIM(STR(nCA_No)),4+32,"Cancel") = 6
		*		IF Cancel_CA_No( nCA_No, .T., ThisFormSet.nConnHandle)
					MESSAGEBOX("Also Cancelled ALL the Detail records.",0,"Cancelled")
		*		ENDIF
				This.parent.chkDetailCancel.Refresh
			ELSE
				This.parent.chkCancel.Value = NOT lCancelled 
				RETURN .F.
			ENDIF
		ENDIF
		
		
		This.Parent.grdCA.Refresh
		This.Parent.grdCA.Setfocus
	ENDPROC

	PROCEDURE frmCA.pf1.pgEdit.chkDetailCancel.Valid
		PRIVATE lCancelled, nCA_Detail_ID, nCA_No 
		lCancelled = CA_detail.cancelled
		nCA_Detail_ID = CA_Detail.CA_Detail_ID
		nCA_No = CA.CA_No
		
		IF NOT lCancelled  && The button has been click and new cancelled state exists
			IF MESSAGEBOX("Are you sure you want to UN cancel this Detail?"+CHR(13)+"CA:"+ALLTRIM(STR(nCA_No)),4+32,"UN Cancel") = 6
		*		Cancel_CA_Detail_ID( nCA_Detail_ID, .F., ThisFormSet.nConnHandle)
			ELSE
				This.parent.chkDetailCancel.Value = NOT lCancelled 
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to cancel this Detail?"+CHR(13)+"CA:"+ALLTRIM(STR(nCA_No)),4+32,"Cancel") = 6
		*		Cancel_CA_Detail_ID( nCA_Detail_ID, .T., ThisFormSet.nConnHandle)	
			ELSE
				This.parent.chkDetailCancel.Value = NOT lCancelled 
				RETURN .F.
			ENDIF
		ENDIF
		
		This.Parent.grdCA.Refresh
		This.Parent.grdCA.Setfocus
	ENDPROC

