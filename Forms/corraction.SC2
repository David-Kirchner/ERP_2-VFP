	PROCEDURE frmCA.pf1.pgAdd.lblCompany.Click
		PRIVATE nSalesNum 
		nSalesNum = VAL( LEFT( aSoItems(1), 7))
		
		IF nSalesNum > 0
		
			IF USED('Sales_No_SoldAddr')
				USE IN Sales_No_SoldAddr
			ENDIF
			SELECT 0
		
			cSQL = "SELECT SoldAddr.Company FROM Sales_No, SoldAddr WHERE Sales_No.SalesNum="+STR(nSalesNum)+" AND Sales_No.pSoldAddr = SoldAddr.SoldCode "
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales_No_SoldAddr')
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'Sales_No_SoldAddr')
			ENDIF
			IF USED('Sales_No_SoldAddr')
				IF VARTYPE(Sales_No_SoldAddr.Company) = "C"
					This.parent.txtCompany.Value = Sales_No_SoldAddr.Company
				ENDIF
		
				USE IN Sales_No_SoldAddr
			ENDIF
			
			
		ENDIF
	ENDPROC

