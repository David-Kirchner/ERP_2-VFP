		*!*	ENDIF
		
	ENDPROC

	PROCEDURE frmCA.pf1.pgAdd.cmdAdd.Click
		IF THIS.Caption = "\<Add"
		
			This.parent.cmdClear.Click
			THIS.Caption = "\<Save"
			
		ELSE
			*THIS.Caption = "\<Save"
			
			PRIVATE nItems, nItems2, lFoundEmpty, nArrayItems, nAddNextItem
			DECLARE anSalesCnt(1)
		
			nArrayItems = ALEN(aSoItems,1)
			DIMENSION aSOitems2(nArrayItems)
			lFoundEmpty = .F.
			nItems2 = 0
		
			*DO WHILE .T.
			FOR nItems = 1 TO ALEN(aSoItems,1)
		
			*	SELECT COUNT(*) FROM HPA!Sales Where Sales.SOItem = aSoItems(nItems) INTO ARRAY anSalesCnt
				IF USED("cntSales_1")
					SELECT cntSales_1
				ELSE
					SELECT 0
				ENDIF
				cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.Sales WHERE "
				cSQL = cSQL + " SOItem = dbo.ProperSO('"+aSoItems(nItems)+"')"
		
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSales_1')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSales_1')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'cntSales_1')
				ENDIF
				IF USED('cntSales_1')
					SELECT COUNT(*) FROM cntSales_1 INTO ARRAY anSalesCnt	
					IF anSalesCnt(1) < 1
						lFoundEmpty = .T.
						*Remove from Array
						nArrayItems = nArrayItems - 1
						IF nArrayItems = 0
							EXIT
						ENDIF
						DIMENSION aSOitems2(nArrayItems)
					ELSE
						FOR nAddNextItem = 1 TO ALEN( anSalesCnt,1 )
							nItems2 = nItems2 + 1		
							aSOitems2(nItems2) = anSalesCnt(nAddNextItem,1)
						ENDFOR
					ENDIF
				ENDIF
			ENDFOR
			*ENDDO
		
			IF ALEN(aSoItems,1) > 0
				ACOPY(aSOitems2,anSalesCnt)
				
		
				IF ThisFormSet.SaveAdd("ADD")
				
					This.Caption = "\<Add"
					ThisFormSet.ResetAddVars()	
		
					SELECT CA
				ENDIF
				
			ELSE
				MESSAGEBOX( "No Valid SO items", 0,"Cannot Save")
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE frmCA.pf1.pgAdd.cmdAdd.When
		IF ALEN(aSoItems,1) <= 0
			MESSAGEBOX("You need to Select a SO item first!",0,"CANNOT SAVE - No Sales Order Item!")
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE frmCA.pf1.pgAdd.cmdClear.Click
		ThisFormSet.ResetAddVars()	
		This.Parent.cmdAdd.Caption = "\<Save"
		
		This.parent.txtCA_No.Value = 0
		This.parent.txtCA_No.Enabled = .T.
		
		This.Parent.Refresh
		
		This.Parent.chkSameReason.Value=0
		
		DIMENSION aSoItems(1)
		aSoItems(1)=" "
		DIMENSION gaReason(1)
		gaReason(1) = ""
		gReason = ""
		ThisFormSet.SOitem = ""
		
		
		SELECT CA
		This.Parent.txtContact.SetFocus()
	ENDPROC

	PROCEDURE frmCA.pf1.pgAdd.cmdOpenSelect.Click
		PRIVATE cSelectSOItem, nSO
		nSO = 0
		
		IF NOT EMPTY(ThisFormSet.SOitem)
			nSO = VAL( LEFT( ThisFormSet.SOitem, 7 ) )
		ENDIF
		
		ThisFormSet.SelectSO( nSO )
		ThisFormSet.FrmCA.Visible = .F.
		ThisFormSet.CA_select12.Visible = .T.
			
		
		
	ENDPROC

	PROCEDURE frmCA.pf1.pgAdd.cmdRemoveItem.Click
		PRIVATE cSOitem,nCA_No
		cSOitem = This.parent.lstSOitem.Value
		IF EMPTY(cSOitem)
			cSOitem = ThisFormSet.SOitem 
		ENDIF
		cSOitem = Proper_SO_Item( cSOitem  )
		
		nCA_No = PrepareSQLnum(This.parent.txtCA_No.Value,'CA_No',-3)
		IF nCA_No <1 
			RETURN .F.
		ENDIF
		
		IF MESSAGEBOX( "Do you want to remove "+ALLTRIM(cSOitem)+" from this CA? ("+ALLTRIM(STR(nCA_No))+")",4+32,"Remove SO-item") = 6&&yes
			PRIVATE cSQL, nSQLEXEC
			cSQL = "DELETE FROM dbo.CA_Detail "
			cSQL = cSQL + " WHERE CA_No="+STR(nCA_No)
			cSQL = cSQL + " AND SO_item='"+cSoItem+"'"
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ENDIF
		
			************************
			
			IF cSOitem != Proper_SO_Item( "" )
				cSQL = "UPDATE dbo.Sales SET "
				cSQL = cSQL + " CA_No = 0"
				cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
				cSQL = cSQL + " and CA_No = "+STR(nCA_No)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC)
				ENDIF
			ENDIF
			
			************************
			PRIVATE nCount, nDrop
			nCount = 0
			nDrop = 0
			
			FOR i = 1 TO ALEN(aSOItems,1)
				IF aSOItems(i) != cSOitem
					nCount = nCount + 1
					DIMENSION aSOItemsNew(nCount)
					aSOItemsNew(nCount) = aSOItems(i)
					
					DIMENSION aReasonNew(nCount)
					aReasonNew(nCount) = gaReason(i)
				ELSE
					nDrop = i
				ENDIF
			ENDFOR
		
			IF nCount = 0
				DIMENSION aSOItems(1)
				aSOItems(1) = " "
				DIMENSION gaReason(1)
				gaReason(1) = " "
			ELSE
				DIMENSION aSOItems(nCount)
				ACOPY(aSOItemsNew,aSOitems)
				
				DIMENSION gaReason(nCount)
				ACOPY(aReasonNew,gaReason)
			ENDIF
			
			ThisFormset.frmCA.pf1.pgAdd.lstSOitem.NumberOfElements = ALEN(aSoItems)
			ThisFormset.frmCA.pf1.pgAdd.lstSOitem.Refresh
			
			IF nDrop - 1 > 0
				ThisFormSet.SOitem = aSoItems(nDrop - 1)
			ENDIF
			IF nDrop = 0 AND nCount > 0
				ThisFormSet.SOitem = aSoItems(1)
			ENDIF
		ENDIF
	ENDPROC

