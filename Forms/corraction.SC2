	PROCEDURE ca_no_refresh
		*ThisFormSet.CA_No_refresh()
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE nCA_No
		nCA_No = CA.CA_No
		
		
		IF USED('CA_Detail')
			USE IN CA_Detail
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.CA_Detail WHERE "
		cSQL = cSQL + " CA_No = "+STR(nCA_No)
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CA_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CA_Detail')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'CA_Detail')
		ENDIF
		
		IF USED('CA_Detail')
			ThisFormset.frmCA.pf1.pgAdd.txtReturned.Value	= IIF(EMPTY(CA_Detail.Returned),'',CA_Detail.Returned)
			ThisFormset.frmCA.pf1.pgAdd.txtReason.Value	= CA_Detail.Reason
			
			SELECT SO_item FROM CA_Detail INTO ARRAY aSoItems
		*	ThisFormset.frmCA.pf1.pgAdd.lstSOitem.RowSource = "aSoItems()"
		*	ThisFormset.frmCA.pf1.pgAdd.lstSOitem.NumberOfElements	= ALEN(aSoItems,1)
			ThisFormset.frmCA.pf1.pgAdd.lstSOitem.Refresh
			ThisFormSet.SOitem = aSoItems(1)
			
		*	ThisFormset.frmCA.pf1.pgAdd.chkSameReason.Value = get_CA_Detail_SameReason(nCA_No,ThisFormSet.nConnHandle)
			
			SELECT Reason FROM CA_Detail INTO ARRAY gaReason
		
		ENDIF
		
	ENDPROC

	PROCEDURE ca_refresh
		*ThisFormSet.CA_Refresh()
		
		ThisFormset.frmCA.pf1.pgAdd.txtCA_No.Value	= CA.CA_No
		ThisFormset.frmCA.pf1.pgAdd.txtCompany.Value= CA.Company
		ThisFormset.frmCA.pf1.pgAdd.txtContact.Value= CA.Contact
		ThisFormset.frmCA.pf1.pgAdd.txtPhone.Value	= CA.Phone
		ThisFormset.frmCA.pf1.pgAdd.txtFax.Value	= CA.Fax
		ThisFormset.frmCA.pf1.pgAdd.txtNotified.Value	= CA.Notified
		ThisFormset.frmCA.pf1.pgAdd.txtAPRV_Date.Value	= CA.APRV_Date
		ThisFormset.frmCA.pf1.pgAdd.txtAPRV_By.Value	= CA.APRV_By
		ThisFormset.frmCA.pf1.pgAdd.txtAUTH_By.Value	= CA.AUTH_By
		ThisFormset.frmCA.pf1.pgAdd.txtMoney.Value		= CA.Money
	ENDPROC

	PROCEDURE checkdata		&& Validate before Save
		PRIVATE lSave
		lSave = .T.
		PRIVATE dNotified, dAprv_Date 
		
		IF TYPE("CA.Notified") = "C"
			dNotified = CtoD(CA.dNotified)
		ENDIF
		
		IF TYPE("dNotified") <> "D" OR EMPTY(dNotified)
			MESSAGEBOX( "You need an 'Notified' date!"+CHR(13)+"Set to todays date.",0,"No Save")
			dNotified = DATE()
			ThisFormset.frmCA.pf1.pgAdd.txtNotified.Refresh
			RETURN .F.
		ENDIF
		
		IF TYPE("CA.Aprv_Date") = "C"
			dAprv_Date = CtoD(CA.Aprv_Date)
		ENDIF
		
		
		IF ALEN(aSoItems) = 0
			MESSAGEBOX( "You have no SO Items selected!"+CHR(13)+"Click 'Select Items' to find the item to be returned.",0,"No Save" )
			RETURN .F.
		ENDIF
			
		
		RETURN lSave
	ENDPROC

	PROCEDURE editca_no		&& Edit CA_No
		PARAMETERS pCA_No
		*ThisFormSet.EditCA_No(nCA_No)
		
		IF TYPE("pCA_No") != "N"
			RETURN .F.
		ENDIF
		
		
		IF pCA_No < 1
			*Erorr
			RETURN .F.
		ENDIF
		
		SELECT CA
		SEEK pCA_No ORDER TAG CA_No
		IF FOUND('CA')
			ThisFormset.frmCA.pf1.pgAdd.Edit1.Value = "Editting CA "+ALLTRIM(STR(pCA_No))&&+CHR(13)+ThisFormset.frmCA.pf1.pgAdd.Edit1.Value
			ThisFormset.frmCA.pf1.pgAdd.txtCA_No.Value = CA.CA_No
			
			ThisFormset.frmCA.pf1.pgAdd.txtCompany.Value	= CA.Company
			ThisFormset.frmCA.pf1.pgAdd.txtContact.Value	= CA.Contact
			ThisFormset.frmCA.pf1.pgAdd.txtPhone.Value		= CA.Phone
			ThisFormset.frmCA.pf1.pgAdd.txtFax.Value		= CA.Fax
			ThisFormset.frmCA.pf1.pgAdd.txtNotified.Value	= CA.Notified
			ThisFormset.frmCA.pf1.pgAdd.txtAprv_Date.Value	= CA.Aprv_Date
			ThisFormset.frmCA.pf1.pgAdd.txtAprv_By.Value	= CA.Aprv_By
			ThisFormset.frmCA.pf1.pgAdd.txtAuth_By.Value	= CA.Auth_By
			ThisFormset.frmCA.pf1.pgAdd.txtMoney.Value 		= CA.Money
			
			*********************************
			ThisFormSet.CA_No_refresh()
			ThisFormset.frmCA.pf1.ActivePage = 1
		
			***********************
			*UPDATE_CA_NoinSales( nCA_No,aSoItems(nItems), ThisFormSet.nConnHandle)
			***********************
			
			ThisFormset.frmCA.pf1.pgAdd.cmdAdd.Caption = "\<Save"
			
			ThisFormset.frmCA.pf1.pgAdd.txtCompany.SetFocus()
		ELSE
			MESSAGEBOX("CA "+ALLTRIM(STR(pCA_No))+" was not found!",0,"No Edit")
		ENDIF
		
	ENDPROC

	PROCEDURE formsrefresh
	ENDPROC

	PROCEDURE getbysoitem
		PARAMETER pSOitem
		*ThisFormSet.GetBySOitem(pSOitem)
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT Company,Name,Phone,Fax FROM dbo.Allquotes WHERE SOitem = '"+pSOitem+"'"
		
		IF USED("tmpAllQuotes")
			USE IN tmpAllQuotes
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAllQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAllQuotes')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpAllQuotes')
			*error
		ELSE
			IF USED("tmpAllQuotes")
				SELECT tmpAllQuotes
				IF NOT EOF('tmpAllQuotes')
					ThisFormset.frmCA.pf1.pgAdd.txtCompany.Value = tmpAllQuotes.Company
					ThisFormset.frmCA.pf1.pgAdd.txtContact.Value = tmpAllQuotes.Name
					ThisFormset.frmCA.pf1.pgAdd.txtPhone.Value = tmpAllQuotes.Phone
					ThisFormset.frmCA.pf1.pgAdd.txtFax.Value = tmpAllQuotes.Fax
					
					*Get CA with SOitem.
					IF USED('tmpCASoitem')
						USE IN tmpCASoitem
					ENDIF
		
					SELECT 0
		
					cSQL = "SELECT CA_No FROM dbo.CA_Detail "
					cSQL = cSQL + " WHERE SO_item = '"+pSOitem+"'"
		
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCASoitem')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCASoitem')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpCASoitem')
					ENDIF
		
					IF USED('tmpCASoitem')
						IF VARTYPE( tmpCASoitem.CA_No ) = "N"
							ThisFormset.frmCA.pf1.pgAdd.txtCA_No.Value = tmpCASoitem.CA_No
						ELSE
							ThisFormset.frmCA.pf1.pgAdd.txtCA_No.Value = 0
						ENDIF
						USE IN tmpCASoitem
					ELSE
						ThisFormset.frmCA.pf1.pgAdd.txtCA_No.Value = 0
					ENDIF
				ENDIF
			ENDIF
		
		
			USE IN tmpAllQuotes
		ENDIF
		
		
	ENDPROC

	PROCEDURE get_asoitems
		*ThisFormSet.get_aSOitems()
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE nCA_No
		nCA_No = CA.CA_No
		
		
		IF USED('tmpCA_Detail')
			SELECT tmpCA_Detail
			ThisFormset.frmCA.pf1.pgEdit.grdCA_D.RecordSource = ''
			ThisFormset.frmCA.pf1.pgBrowse.grdBrCA_D.RecordSource = ''
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT SO_Item"
		cSQL = cSQL +" ,CONVERT( CHAR(10), CA_Detail.Returned, 101 ) AS Returned"
		cSQL = cSQL +" ,Cancelled,Reason FROM dbo.CA_Detail WHERE "
		cSQL = cSQL + " CA_No = "+STR(nCA_No)
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCA_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCA_Detail')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpCA_Detail')
		ENDIF
		
		
		IF USED('tmpCA_Detail')
		
			SELECT SO_item FROM tmpCA_Detail INTO ARRAY aSoItems
			
			IF VARTYPE(ThisFormset.frmCA) != "U"
				ThisFormset.frmCA.pf1.pgEdit.grdCA_D.RecordSource = 'tmpCA_Detail'
				ThisFormset.frmCA.pf1.pgBrowse.grdBrCA_D.RecordSource = 'tmpCA_Detail'
				
				ThisFormset.frmCA.pf1.pgEdit.txtReason.Refresh
			
			ENDIF
			
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETER pCA_No, pSOitem
		*DO FORM CorrAction WITH nCA
		
		ThisFormSet.CA_Refresh()
		
		
		RELEASE m.ncmbFind,m.FindText
		Public m.ncmbFind,m.FindText
		m.ncmbFind = 1
		m.FindText = 0
		
		ThisFormSet.OleDate = DATE()
		ThisFormSet.SOitem = ""
		
		
		IF TYPE('pCA_No') = "N"  
			IF pCA_No > 0
				SELECT CA
				SEEK pCA_No ORDER CA_No IN CA
			
				ThisFormset.frmCA.pf1.ActivePage = 2
				ThisFormset.frmCA.pf1.pgEdit.txtFindText.SetFocus
			ELSE
				*From Quotes program!
				IF TYPE('pSOitem') = "C"
					ThisFormSet.SOitem = pSOitem
					ThisFormSet.GetBySOitem(pSOitem)
					
					ThisFormset.frmCA.pf1.ActivePage = 1
					ThisFormset.frmCA.pf1.pgAdd.txtCompany.SetFocus
				ENDIF
			ENDIF
		ELSE
			ThisFormset.frmCA.pf1.ActivePage = 2
		ENDIF
		
		ThisFormSet.CA_No_Refresh()
		ThisFormSet.RefreshEditTab()
		
		ThisFormset.frmCA.pf1.pgAdd.lstSOitem.RowSource			= "aSoItems"
		ThisFormset.frmCA.pf1.pgAdd.lstSOitem.NumberOfElements	= ALEN(aSoItems,1)
		ThisFormset.frmCA.pf1.pgAdd.lstSOitem.Refresh
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		*IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
		*	SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		*ENDIF 
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisFormSet.Load_CA()
		
		PUBLIC aSoItems(1)
		aSoItems(1)=" "
		
		PUBLIC gaReason(1)
		gaReason(1) = " "
		ThisFormSet.Get_aSoItems()
		
		SELECT CA
		*INDEX ON CA_No TAG CA_No
		*SET ORDER TO TAG CA_No
		
		
		GO BOTTOM
		
	ENDPROC

	PROCEDURE load_ca
		PARAMETERS pWhat
		*ThisFormSet.Load_CA()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		
		IF UPPER(pWhat) ="REFRESH"
			ThisFormset.frmCA.pf1.pgEdit.grdCA.RecordSource = ''
			ThisFormset.frmCA.pf1.pgBrowse.grdBrCA.RecordSource = ''
			
			IF USED('CA')
				USE IN CA
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('CA')
			SELECT 0
			
			cSQL = "SELECT * FROM dbo.CA "
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CA')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CA')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'CA' )
			ENDIF
		
		ENDIF
		
		IF USED('CA')
			
			SELECT CA
			INDEX ON CA_No TAG CA_No
			SET ORDER TO TAG CA_No
			
			IF UPPER(pWhat) ="REFRESH"
				GO BOTTOM
				ThisFormset.frmCA.pf1.pgEdit.grdCA.RecordSource = 'CA'
				ThisFormset.frmCA.pf1.pgBrowse.grdBrCA.RecordSource = 'CA'
			ENDIF
		ELSE
			MESSAGEBOX('Failed to load CA',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		IF USED('CA_Detail')
			SELECT CA_Detail
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT * FROM dbo.CA_Detail "
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CA_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CA_Detail')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'CA_Detail' )
		ENDIF
		
		
		IF USED('CA_Detail')
			
			SELECT CA_Detail
			INDEX ON CA_No TAG CA_No
			SET ORDER TO TAG CA_No
			
		*	SELECT CA
		*	SET RELATION TO CA_No INTO CA_Detail
		
			IF UPPER(pWhat) ="REFRESH"
				ThisFormset.frmCA.pf1.pgEdit.grdCA_D.RecordSource = 'CA_Detail'
				ThisFormset.frmCA.pf1.pgBrowse.grdBrCA_D.RecordSource = 'CA_Detail'
			ENDIF
		
		ELSE
			MESSAGEBOX('Failed to load CA_Detail',0+16,"Error")
			RETURN .F.	
		ENDIF
	ENDPROC

	PROCEDURE refreshedittab
		
		ThisFormset.frmCA.pf1.pgEdit.txtCompany.Refresh
		ThisFormset.frmCA.pf1.pgEdit.txtContact.Refresh
		ThisFormset.frmCA.pf1.pgEdit.txtPhone.Refresh
		*ThisFormset.frmCA.pf1.pgEdit.txtNotified.Refresh
		*ThisFormset.frmCA.pf1.pgEdit.txtReturned.Refresh
		ThisFormset.frmCA.pf1.pgEdit.txtAPRV_By.Refresh
		ThisFormset.frmCA.pf1.pgEdit.txtAPRV_Date.Refresh
		ThisFormset.frmCA.pf1.pgEdit.txtReason.Refresh
		ThisFormset.frmCA.pf1.pgEdit.txtInspection.Refresh
		ThisFormset.frmCA.pf1.pgEdit.txtMoney.Refresh
		
		IF EMPTY(CA.aprv_by) OR CA.aprv_by = 'Not Approved  ' OR CA.Aprv_Date = CTOD("01/01/1900")
			ThisFormset.frmCA.pf1.pgEdit.cmdApprove.Visible = .T.
		ELSE
			ThisFormset.frmCA.pf1.pgEdit.cmdApprove.Visible = .F.
		ENDIF
		
		ThisFormSet.CA_No_refresh()
		ThisFormSet.get_aSOitems()
		
		ThisFormset.frmCA.pf1.pgEdit.grdCA_D.Refresh
		
		ThisFormset.frmCA.pf1.pgEdit.chkCancel.Refresh
		ThisFormset.frmCA.pf1.pgEdit.chkDetailCancel.Refresh
		
		ThisFormset.frmCA.pf1.pgEdit.Vcr1.EnableDisableButtons()
		
	ENDPROC

	PROCEDURE resetaddvars
		ThisFormset.frmCA.pf1.pgAdd.txtCA_No.Value = 0
		ThisFormset.frmCA.pf1.pgAdd.txtCA_No.Enabled = .T.
		
		ThisFormset.frmCA.pf1.pgAdd.txtCompany.Value = ''
		ThisFormset.frmCA.pf1.pgAdd.txtContact.Value = ''
		ThisFormset.frmCA.pf1.pgAdd.txtPhone.Value = ''
		ThisFormset.frmCA.pf1.pgAdd.txtFax.Value = ''
		ThisFormset.frmCA.pf1.pgAdd.txtNotified.Value = DATE()
		
		ThisFormset.frmCA.pf1.pgAdd.txtAPRV_By.Value = ''
		ThisFormset.frmCA.pf1.pgAdd.txtAPRV_Date.Value = ''
		ThisFormset.frmCA.pf1.pgAdd.txtAUTH_By.Value = ''
		ThisFormset.frmCA.pf1.pgAdd.txtMoney.Value = ''
		
		ThisFormset.frmCA.pf1.pgAdd.txtReturned.Value = ''
		ThisFormset.frmCA.pf1.pgAdd.txtReason.Value = ''
		
		aSoItems(1) = " "
		gaReason(1) = ""
		gReason = ""
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETER pSaveType
		PRIVATE m.shipcomplete, lCAsaved
		PRIVATE nCurrRec
		PRIVATE lnSalesNum
		PRIVATE lActionRequest, nSalesNum
		
		lCAsaved = .F.
		lActionRequest = .T.
		nSalesNum = VAL( LEFT( aSoItems(1), 7))
		IF ALEN( aSoItems ) > 100
			MESSAGEBOX("Over 100 Items were Selected."+CHR(13)+"The program feels this is an Error and will reject the SAVE!",0,"No Save")
			RETURN
		ENDIF
		
		PRIVATE nCA_No,cCompany,cContact,cPhone,cFax,dNotified
		PRIVATE dAPRV_Date,dAPRV_By,cAuth_By,cMoney
		nCA_No		= PrepareSQLnum(ThisFormset.frmCA.pf1.pgAdd.txtCA_No.Value,'CA_No',-3)
		cCompany	= PrepareSQLtxt(ThisFormset.frmCA.pf1.pgAdd.txtCompany.Value,'Company',30)
		cContact	= PrepareSQLtxt(ThisFormset.frmCA.pf1.pgAdd.txtContact.Value,'Contact',20)
		cPhone		= PrepareSQLtxt(ThisFormset.frmCA.pf1.pgAdd.txtPhone.Value,'Phone',20)
		cFax		= PrepareSQLtxt(ThisFormset.frmCA.pf1.pgAdd.txtFax.Value,'Fax',20)
		dNotified	= PrepareSQLDate(ThisFormset.frmCA.pf1.pgAdd.txtNotified.Value,'Notified')
		dAPRV_Date	= PrepareSQLDate(ThisFormset.frmCA.pf1.pgAdd.txtAPRV_Date.Value,'APRV_Date')
		cAPRV_By	= PrepareSQLtxt(ThisFormset.frmCA.pf1.pgAdd.txtAPRV_By.Value,'APRV_By',20)  &&Insert uses 'Not Approved'
		
		cAuth_By	= PrepareSQLtxt(ThisFormset.frmCA.pf1.pgAdd.txtAuth_By.Value,'Auth_By',20)
		cMoney		= PrepareSQLtxt(ThisFormset.frmCA.pf1.pgAdd.txtMoney.Value,'Money',-1)
		
		*PRIVATE nCancelled,dReturned,cReason
		*nCancelled	= ThisFormset.frmCA.pf1.pgAdd.txt.Value
		*dReturned	= PrepareSQLDate(ThisFormset.frmCA.pf1.pgAdd.txtReturned.Value,'Returned')
		*cReason	= PrepareSQLtxt(ThisFormset.frmCA.pf1.pgAdd.txtReason.Value,'Reason',-1)
		
		
		***********Check Values
		
		IF EMPTY(nCA_No)
		*	Must be an Insert!	
		ENDIF
		
		IF TYPE("nSalesNum") <> "N"
			 nSalesNum = 0
		ENDIF
		
		IF TYPE("dNotified") <> "D" OR EMPTY(dNotified)
			MESSAGEBOX( "You need an 'Notified' date!"+CHR(13)+"Set to todays date.",0,"No Save")
			ThisFormset.frmCA.pf1.pgAdd.txtNotified.Value = DATE()
			ThisFormset.frmCA.pf1.pgAdd.txtNotified.Refresh
			RETURN .F.
		ENDIF
		
		IF ALEN(aSoItems) = 0
			MESSAGEBOX( "You have no SO Items selected!"+CHR(13)+"Click 'Select Items' to find the item to be returned.",0,"No Save" )
			RETURN .F.
		ENDIF
		
		IF EMPTY(cAuth_By)
			PRIVATE cMach_User
			cMach_User = SYS(0)
			cAuth_By = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		ENDIF	
		
		IF nCA_No > 0
			*Update
			ThisFormset.frmCA.pf1.pgAdd.Edit1.VALUE = "UPDATE CA #"+ALLTRIM(STR(m.nCA_No))+"."
			
			dAPRV_Date= CTOD('')
			cAPRV_By	= 'Not Approved'
				
			cSQL = "UPDATE dbo.CA SET "
			cSQL = cSQL + " Company='"+cCompany+"'"
			cSQL = cSQL + ",contact='"+cContact+"'"
			cSQL = cSQL + ",Phone='"+cPhone+"'"
			cSQL = cSQL + ",Fax='"+cFax+"'"
			cSQL = cSQL + ",Notified='"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
			cSQL = cSQL + ",APRV_Date='"+IIF(EMPTY(dAPRV_Date),'',DTOC(dAPRV_Date))+"'"
			cSQL = cSQL + ",APRV_By='"+cAPRV_By+"'"
			cSQL = cSQL + ",Auth_By='"+cAuth_By+"'"
			cSQL = cSQL + ",Money='"+cMoney+"'"
			cSQL = cSQL + " WHERE CA_No = "+STR(nCA_No)
			
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ELSE
				lCAsaved = .T.
			ENDIF
				
			*UPDATE Details **************
			cReason = ThisFormset.frmCA.pf1.pgAdd.txtReason.Value
		
			FOR nItems = 1 TO ALEN(aSoItems,1)
				IF NOT EMPTY(ALLTRIM(aSoItems(nItems)))	
					*Do not let blank SOitems into CA_Detail
					nItemSale = Get_ItemSaleinSales(aSoItems(nItems), ThisFormSet.nConnHandle)
					
		*			IF Is_CA_Detail_CA_N0andSO_item(nCA_No,aSoItems(nItems),ThisFormSet.nConnHandle) = 0
		*				*Add-Insert
		*				cSQL = "INSERT INTO CA_Detail "
		*				cSQL = cSQL + "(CA_No, SO_item, ItemSale, Refunded, Reason, Inspect, Cancelled ) VALUES ("
		*				cSQL = cSQL + " "+STR(nCA_No)
		*				cSQL = cSQL + ",'"+aSoItems(nItems)+"'"
		*				cSQL = cSQL + ","+STR(nItemSale)
		*				cSQL = cSQL + ",0"
		*				cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
		*				cSQL = cSQL + ",'',0"
		*				cSQL = cSQL + ")"
		*				
		*				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		*				DO WHILE nSQLEXEC = 0
		*					WAIT WINDOW 'SQL' TIMEOUT 1
		*					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		*				ENDDO
		*				IF nSQLEXEC < 0
		*					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		*				ENDIF
		*			ELSE
		*				*Update
		*				cSQL = "UPDATE CA_Detail SET "
		*				cSQL = cSQL + " ItemSale="+STR(nItemSale)
		*				cSQL = cSQL + ",Reason='"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
		*				cSQL = cSQL + " WHERE CA_No="+STR(nCA_No)
		*				cSQL = cSQL + " AND SO_item='"+aSoItems(nItems)+"'"
		*			
		*				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		*				DO WHILE nSQLEXEC = 0
		*					WAIT WINDOW 'SQL' TIMEOUT 1
		*					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		*				ENDDO
		*				IF nSQLEXEC < 0
		*					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		*				ENDIF
		*			ENDIF
					
					nSalesNum = VAL( LEFT( aSoItems(nItems), 7))
					IF lActionRequest
						*Add to Action Request
						PRIVATE nCount_AR
						nCount_AR = Count_ActionRequest( nCA_No, ThisFormSet.nConnHandle)	
						IF nCount_AR = 0
							*Insert
							cSQL = "INSERT INTO dbo.ActionRequest "
							cSQL = cSQL + "(CA,SalesNum,POnum,Customer,ARdate,TO_,Problem,Instruction,ARperson) VALUES ("
							cSQL = cSQL + ""+STR(nCA_No)
							cSQL = cSQL + ","+STR(nSalesNum)
							cSQL = cSQL + ",0"&&+STR(nPOnum)
							cSQL = cSQL + ",'"+cCompany+"'"
							cSQL = cSQL + ",'"+DTOC(DATE())+"'"
							cSQL = cSQL + ",'HPA'"
							cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
							cSQL = cSQL + ",' '"
							cSQL = cSQL + ",'"+cAuth_By+"'"
							cSQL = cSQL + ")"
								  
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
							ELSE
								lActionRequestsaved = .T.
							ENDIF
		
						ELSE
							*Update
							cSQL = "UPDATE dbo.ActionRequest SET "
							cSQL = cSQL + " CA="+STR(nCA_No)
							cSQL = cSQL + ",SalesNum="+STR(nSalesNum)
							cSQL = cSQL + ",POnum=0"&&+STR(nPOnum)
							cSQL = cSQL + ",Customer='"+cCompany+"'"
							cSQL = cSQL + ",ARdate'"+DTOC(DATE())+"'"
							cSQL = cSQL + ",TO_='HPA'"
							cSQL = cSQL + ",Problem='"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
							cSQL = cSQL + ",Instruction=' '"
							cSQL = cSQL + ",ARperson='"+cAuth_By+"'"
								  
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
							ELSE
								lActionRequestsaved = .T.
							ENDIF
						ENDIF
					ENDIF
					*Remove blank SOItem entries
					*DELETE FROM CA_Detail WHERE CA_No = m.nCA_No AND SO_item = ''
				ENDIF
				
				IF !EMPTY( aSoItems(nItems) )
					*UPDATE HPA!Sales SET CA_NO = m.nCA_No WHERE SOitem = aSoItems(nItems)
		*			UPDATE_CA_NoinSales( nCA_No,aSoItems(nItems), ThisFormSet.nConnHandle)
				ENDIF
			ENDFOR
			
			MESSAGEBOX("This update has voided the previous approval."+CHR(10)+"This needs to be 'Approved'.",0+64,"Not Approved")
			
			ThisFormset.frmCA.pf1.pgAdd.Edit1.VALUE = "CA #"+ALLTRIM(STR(m.nCA_No))+" saved."+CHR(13)+ThisFormset.frmCA.pf1.pgAdd.Edit1.VALUE
			ThisFormset.frmCA.pf1.pgAdd.Edit1.REFRESH
		
			
		ELSE
			
			*INSERT
			
			nCA_No = 0
			
			m.dAPRV_Date= CTOD('')
			m.cAPRV_By	= 'Not Approved'
		
			cSQL = "INSERT INTO dbo.CA (Company,contact,Phone,Fax,Notified,APRV_Date,APRV_By,Auth_By,Money,Cancelled) VALUES  ("
			cSQL = cSQL + " '"+cCompany+"'"
			cSQL = cSQL + ",'"+cContact+"'"
			cSQL = cSQL + ",'"+cPhone+"'"
			cSQL = cSQL + ",'"+cFax+"'"
			cSQL = cSQL + ",'"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
			cSQL = cSQL + ",'"+IIF(EMPTY(dAPRV_Date),'',DTOC(dAPRV_Date))+"'"
			cSQL = cSQL + ",'"+cAPRV_By+"'"
			cSQL = cSQL + ",'"+cAuth_By+"'"
			cSQL = cSQL + ",'"+cMoney+"'"
			cSQL = cSQL + ",0"
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ELSE
				lCAsaved = .T.
			ENDIF
			
			IF lCAsaved 
				**Get nCA_No
				IF USED('tmpCA_No')
					USE IN tmpCA_No
				ENDIF
				SELECT 0
				cSQL = "SELECT CA_No FROM dbo.CA WHERE "
				cSQL = cSQL + " Company='"+cCompany+"'"
				cSQL = cSQL + " AND contact='"+cContact+"'"
				cSQL = cSQL + " AND Phone='"+cPhone+"'"
				cSQL = cSQL + " AND Fax='"+cFax+"'"
				cSQL = cSQL + " AND Notified='"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
				cSQL = cSQL + " AND Auth_By='"+cAuth_By+"'"
				cSQL = cSQL + " AND Money='"+cMoney+"'"
			
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCA_No')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCA_No' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCA_No' )
				ENDIF
				IF USED('tmpCA_No')
					IF VARTYPE(tmpCA_No.CA_No) = 'N'
						nCA_No = tmpCA_No.CA_No
						ThisFormset.frmCA.pf1.pgAdd.Edit1.Value = "New CA is:"+ALLTRIM(STR(nCA_No))+CHR(13)+ThisFormset.frmCA.pf1.pgAdd.Edit1.Value 
					ENDIF
				ENDIF
			ENDIF	
			
			
			IF lCAsaved 
				*Save Details **************
				PRIVATE lcReason
				lcReason = ThisFormset.frmCA.pf1.pgAdd.txtReason.Value
		
				FOR nItems = 1 TO ALEN(aSoItems,1)
					
					nItemSale = Get_ItemSaleinSales(aSoItems(nItems), ThisFormSet.nConnHandle)
					
					IF NOT EMPTY(ALLTRIM(aSoItems(nItems)))	
						*Do not let blank SOitems into CA_Detail
						
						IF ThisFormset.frmCA.pf1.pgAdd.chkSameReason.Value=1
			*				All SO items have same Return Reason			
							
							cSQL = "INSERT INTO CA_Detail "
							cSQL = cSQL + "(CA_No, SO_item, ItemSale, Refunded, Reason, Inspect, Cancelled ) VALUES ("
							cSQL = cSQL + " "+STR(nCA_No)
							cSQL = cSQL + ",'"+aSoItems(nItems)+"'"
							cSQL = cSQL + ","+STR(nItemSale)
							cSQL = cSQL + ",0"
							cSQL = cSQL + ",'"+PrepareSQLtxt(lcReason,'Reason',-1)+"'"
							cSQL = cSQL + ",'',0"
							cSQL = cSQL + ")"
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							ENDIF
		
							nSalesNum = VAL( LEFT( aSoItems(nItems), 7))
							*Add to Action Request
							IF lActionRequest
								*Add to Action Request
								PRIVATE nCount_AR
								nCount_AR = Count_ActionRequest( nCA_No, ThisFormSet.nConnHandle)	
								IF nCount_AR = 0
									*Insert
									cSQL = "INSERT INTO dbo.ActionRequest "
									cSQL = cSQL + "(CA,SalesNum,POnum,Customer,ARdate,TO_,Problem,Instruction,ARperson) VALUES ("
									cSQL = cSQL + ""+STR(nCA_No)
									cSQL = cSQL + ","+STR(nSalesNum)
									cSQL = cSQL + ",0"&&+STR(nPOnum)
									cSQL = cSQL + ",'"+cCompany+"'"
									cSQL = cSQL + ",'"+DTOC(DATE())+"'"
									cSQL = cSQL + ",'HPA'"
									cSQL = cSQL + ",'"+PrepareSQLtxt(lcReason,'Reason',-1)+"'"
									cSQL = cSQL + ",' '"
									cSQL = cSQL + ",'"+cAuth_By+"'"
									cSQL = cSQL + ")"
										  
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
									ENDDO
									IF nSQLEXEC < 0
										SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
									ELSE
										lActionRequestsaved = .T.
									ENDIF
		
								ELSE
									
									*Update
									cSQL = "UPDATE dbo.ActionRequest SET "
									cSQL = cSQL + " CA="+STR(nCA_No)
									cSQL = cSQL + ",SalesNum="+STR(nSalesNum)
									cSQL = cSQL + ",POnum=0"&&+STR(nPOnum)
									cSQL = cSQL + ",Customer='"+cCompany+"'"
									cSQL = cSQL + ",ARdate'"+DTOC(DATE())+"'"
									cSQL = cSQL + ",TO_='HPA'"
									cSQL = cSQL + ",Problem='"+PrepareSQLtxt(lcReason,'Reason',-1)+"'"
									cSQL = cSQL + ",Instruction=' '"
									cSQL = cSQL + ",ARperson='"+cAuth_By+"'"
										  
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
									ENDDO
									IF nSQLEXEC < 0
										SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
									ELSE
										lActionRequestsaved = .T.
									ENDIF
								ENDIF
							ENDIF
							
							*Remove blank SOItem entries
							*DELETE FROM CA_Detail WHERE CA_No = m.nCA_No AND SO_item = ''
						ELSE
							** SO items have different Reasons
							
							cSQL = "INSERT INTO CA_Detail "
							cSQL = cSQL + "(CA_No, SO_item, ItemSale, Refunded, Reason, Inspect, Cancelled ) VALUES ("
							cSQL = cSQL + " "+STR(nCA_No)
							cSQL = cSQL + ",'"+aSoItems(nItems)+"'"
							cSQL = cSQL + ","+STR(nItemSale)
							cSQL = cSQL + ",0"
							cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
							cSQL = cSQL + ",'',0"
							cSQL = cSQL + ")"
							
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							ENDIF
							
							nSalesNum = VAL( LEFT( aSoItems(nItems), 7))
							IF lActionRequest
								*Add to Action Request
								PRIVATE nCount_AR
								nCount_AR = Count_ActionRequest( nCA_No, ThisFormSet.nConnHandle)	
								IF nCount_AR = 0
									*Insert
									cSQL = "INSERT INTO dbo.ActionRequest "
									cSQL = cSQL + "(CA,SalesNum,POnum,Customer,ARdate,TO_,Problem,Instruction,ARperson) VALUES ("
									cSQL = cSQL + ""+STR(nCA_No)
									cSQL = cSQL + ","+STR(nSalesNum)
									cSQL = cSQL + ",0"&&+STR(nPOnum)
									cSQL = cSQL + ",'"+cCompany+"'"
									cSQL = cSQL + ",'"+DTOC(DATE())+"'"
									cSQL = cSQL + ",'HPA'"
									cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
									cSQL = cSQL + ",' '"
									cSQL = cSQL + ",'"+cAuth_By+"'"
									cSQL = cSQL + ")"
										  
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
									ENDDO
									IF nSQLEXEC < 0
										SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
									ELSE
										lActionRequestsaved = .T.
									ENDIF
		
								ELSE
									*Update
									cSQL = "UPDATE dbo.ActionRequest SET "
									cSQL = cSQL + " CA="+STR(nCA_No)
									cSQL = cSQL + ",SalesNum="+STR(nSalesNum)
									cSQL = cSQL + ",POnum=0"&&+STR(nPOnum)
									cSQL = cSQL + ",Customer='"+cCompany+"'"
									cSQL = cSQL + ",ARdate'"+DTOC(DATE())+"'"
									cSQL = cSQL + ",TO_='HPA'"
									cSQL = cSQL + ",Problem='"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
									cSQL = cSQL + ",Instruction=' '"
									cSQL = cSQL + ",ARperson='"+cAuth_By+"'"
										  
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
									ENDDO
									IF nSQLEXEC < 0
										SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
									ELSE
										lActionRequestsaved = .T.
									ENDIF
								ENDIF
							ENDIF
		
		
						ENDIF
						*Remove blank SOItem entries
						*DELETE FROM CA_Detail WHERE CA_No = CA_No AND SO_item = ''
						
					ENDIF
					
			
					IF !EMPTY( aSoItems(nItems) )
						lCancelled = .F.
						*UpdateSalesWithCA_No( aSoItems(nItems), nCA_No, lCancelled , ThisFormSet.nConnHandle)
									
					ENDIF
				ENDFOR
				
				ThisFormset.frmCA.pf1.pgAdd.Edit1.VALUE = "CA #"+ALLTRIM(STR(nCA_No))+" saved."
				ThisFormset.frmCA.pf1.pgAdd.Edit1.REFRESH
			ENDIF
		ENDIF
		
		IF lCAsaved
		
			*Save To dbo.Sales
			FOR nItems = 1 TO ALEN(aSoItems,1)
				cSOitem = Proper_SO_Item( aSoItems(nItems) )
				
				IF cSOitem != Proper_SO_Item( "" )
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL + " CA_No = "+STR(nCA_No)
					cSQL = cSQL + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC)
					ENDIF
				ENDIF
			ENDFOR
			
			IF pSaveType = "ADD"
				ThisFormSet.ResetAddVars()
			ENDIF
			ThisFormset.frmCA.pf1.pgAdd.REFRESH
		
		
			*********** refresh tables
			ThisFormset.Load_CA('Refresh')
		*	ThisFormset.CA_no_refresh()
		
		
		ENDIF
		
		
		IF USED("ActionRequest")
			USE IN ActionRequest
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE selecteditems
		PARAMETERS cSelectSOItem
		*ThisFormSet.SelectedItems(cSelectSOItem)
		
		PRIVATE i, i2, aSOItem2
		i = 0
		
		IF !EMPTY(cSelectSOItem)
			DO WHILE LEN(cSelectSOItem) > 0
				i=i+1
				DIMENSION aSOItem2(i)
				aSOItem2(i) = LEFT(cSelectSOItem,10)
				cSelectSOItem = RIGHT(cSelectSOItem , LEN(cSelectSOItem)-11)
			ENDDO
		ENDIF
		
		PRIVATE nCurrSOitem
		FOR i2 = 1 TO i
			IF ASCAN(aSOItems, aSOItem2(i2)) = 0 &&Not Found
				IF EMPTY(aSoItems(1))
					aSoItems(1) = aSOItem2(i2)
		
					ThisFormset.frmCA.pf1.pgAdd.lstSOitem.Refresh
				ELSE
					nLenaSoItems = ALEN(aSoItems,1)
		
					DIMENSION aSoItems(nLenaSoItems +1)
					aSoItems(nLenaSoItems +1) = aSOItem2(i2)
					
					ThisFormset.frmCA.pf1.pgAdd.lstSOitem.Refresh
				ENDIF
			ENDIF 	
		ENDFOR
		
		
		ThisFormset.frmCA.pf1.pgAdd.lstSOitem.NumberOfElements = ALEN(aSoItems)
		ThisFormset.frmCA.pf1.pgAdd.lstSOitem.Refresh
		
		DIMENSION gaReason(ALEN(aSoItems))
		
		IF USED("tmpQuotes")
			USE IN tmpQuotes
		ENDIF
		IF !EMPTY(aSoItems(1))
		
			IF EMPTY( ThisFormset.frmCA.pf1.pgAdd.txtCompany.Value )
				cSQL = "SELECT Company FROM DBO.AllQuotes WHERE SOitem = '"+ aSoItems(1) +"'"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpQuotes')
				ENDIF
				ThisFormset.frmCA.pf1.pgAdd.txtCompany.Value = tmpQuotes.Company
			ENDIF
			IF EMPTY( ThisFormset.frmCA.pf1.pgAdd.txtContact.Value )
				cSQL = "SELECT Name FROM DBO.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisFormset.frmCA.pf1.pgAdd.txtContact.Value = tmpQuotes.Name
			ENDIF
			IF EMPTY( ThisFormset.frmCA.pf1.pgAdd.txtPhone.Value )
				cSQL = "SELECT Phone FROM DBO.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisFormset.frmCA.pf1.pgAdd.txtPhone.Value = tmpQuotes.Phone 
			ENDIF
			IF EMPTY( ThisFormset.frmCA.pf1.pgAdd.txtFax.Value )
				cSQL = "SELECT Fax FROM DBO.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisFormset.frmCA.pf1.pgAdd.txtFax.Value = tmpQuotes.Fax 
			ENDIF
			
			IF EMPTY( ThisFormset.frmCA.pf1.pgAdd.txtNotified.Value )
				ThisFormset.frmCA.pf1.pgAdd.txtNotified.Value = DATE()
			ENDIF
			
			IF USED("tmpQuotes")
				USE IN tmpQuotes
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE selectso		&& Open Select with SO
		PARAMETERS pnSO
		
		*ThisFormSet.SelectSO()
		ThisFormset.CA_select12.cmbSWhere.Value = "Sales Order"
		ThisFormset.CA_select12.cmbSWhere.Refresh
		ThisFormset.CA_select12.cReturnKey=''
		ThisFormset.CA_select12.txtSearch.SetFocus
		
		IF TYPE("pnSO")= "N"
			IF pnSO > 0
				ThisFormset.CA_select12.txtSearch.Value = ALLTRIM(STR(pnSO))
				ThisFormset.CA_select12.cmdSearch.Click
			ENDIF
		ENDIF
