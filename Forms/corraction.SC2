	PROCEDURE frmCA.pf1.pgEdit.cmdFindcmbText.Valid
		PRIVATE IntcmbFind, recb4find, nBestFind
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace m.FindText
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		IF TYPE('laText2Find') = "N"
			lnText2Find = laText2Find
			lcText2Find = ALLTRIM(STR(laText2Find))
		ENDIF
		IF TYPE('laText2Find') = "C"
			lcText2Find = ALLTRIM(laText2Find)
			lnText2Find = VAL(laText2Find)
		ENDIF
		
		IntcmbFind = INT(m.ncmbFind)
		recb4find = 0
		recb4find = RECNO('CA')
		
		SELECT CA
		DO CASE
		CASE IntcmbFind = 1
			*CA_no N, 10
		*	SELECT CA
		*	INDEX ON CA_No TAG CA_No
			SET ORDER TO TAG CA_No
		
			SEEK lnText2Find IN 'CA' ORDER CA_no
		CASE IntcmbFind = 2
			*Company c,30
			SELECT CA
			INDEX ON Company TAG Company
			SET ORDER TO TAG Company
		*	SET ORDER TO Company
			SEEK UPPER(lcText2Find) IN 'CA' ORDER Company
		*CASE IntcmbFind = 3
			*CA_no N,10
		*	SET ORDER TO CA_no
		*	SEEK lnText2Find  IN 'CA' ORDER CA_no
		*CASE IntcmbFind = 4
			*SOitem c,10
		*	SET ORDER TO SOitem
		*	SEEK PADL(lcText2Find,10) IN 'CA' ORDER SOitem
		ENDCASE
		
		IF NOT FOUND('CA')
			nBestFind = RECNO(0)
			IF nBestFind > 0 AND nBestFind <= RECCOUNT("CA")
				GOTO nBestFind 
			ENDIF
			IF EOF('CA')
				WAIT WINDOW 'Not Found' NOWAIT
				IF recb4find > 0 AND recb4find <= RECCOUNT("CA")
					GO recb4find
				ENDIF
			ELSE
				WAIT WINDOW 'closest match' NOWAIT
			ENDIF
		ENDIF
		
		This.Parent.grdCA.Refresh
		
		
		ThisFormSet.RefreshEditTab()
		
		This.Parent.grdCA.Setfocus
	ENDPROC

	PROCEDURE frmCA.pf1.pgEdit.cmdFindcmbText.When
		IF EMPTY(m.FindText)
			=MESSAGEBOX("Enter text first",16,"No text")
			RETURN .F.
		ENDIF
	ENDPROC

