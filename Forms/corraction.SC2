		This.Edit1.Value = "Last CA Number :"+ALLTRIM(STR(CA.CA_No))
		*+CHR(13)+"Last Company :"+CHR(13)+CA.Company
		
		*!*	IF NOT EMPTY(Ordrb4)
		*!*		SET ORDER TO (Ordrb4)
		*!*	ELSE
		*!*		SET ORDER TO
		*!*	ENDIF
		
		*!*	IF recb4 > 0 AND recb4 <= RECCOUNT("CA")
