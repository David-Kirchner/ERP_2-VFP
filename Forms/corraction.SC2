		DO CASE
		CASE IntcmbFind = 1
			*CA_no n,10
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999999"
		*CASE IntcmbFind = 2
		*	*SOitem c,10
		*	m.FindText = SPACE(10)
		*	This.Parent.txtFindText.InputMask =	"99999-99"
		CASE IntcmbFind = 2
