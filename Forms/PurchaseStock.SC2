	PROCEDURE getnextvendorimport
		*ThisFormSet.GetNextVendorImport()
		
		IF ThisFormSet.VendorFile = 'tmpElectralloy'
			SELECT tmpElectralloy
			
			DO WHILE NOT EOF('tmpElectralloy')
				IF EMPTY(tmpElectralloy.Grade) AND EMPTY(tmpElectralloy.Diameter)
					SKIP IN 'tmpElectralloy'
				ENDIF
				EXIT
			ENDDO
				
			IF EOF('tmpElectralloy')
				ThisFormSet.frmVendorImport.Visible = .F.
				USE IN tmpElectralloy
		
				ThisFormSet.Getstocklst_vendor()
				ThisFormSet.Refreshstocklst_vendor()
				ThisFormSet.frmVendorStock.Visible = .T.		
				
				RETURN
			ENDIF
		
			PRIVATE nDecimals
			nDecimals = SET("DECIMALS")
		
			PRIVATE cGrade,cDiameter,cLength,cWeight,cHeatLot,cCondition		
			cGrade		= tmpElectralloy.Grade
			cDiameter	= tmpElectralloy.Diameter
			cLength		= tmpElectralloy.Length
			cWeight		= tmpElectralloy.Weight
			cWeight		= STRTRAN(cWeight,",","")
			cHeatLot	= tmpElectralloy.HeatLot
			cCondition	= tmpElectralloy.Condition
			ThisFormSet.frmVendorImport.txtAll.Value 	= cGrade+cDiameter+cLength+cWeight+cHeatLot+cCondition
			ThisFormSet.frmVendorImport.ALLOY1.Value	= GetAlloyStandard(cGrade,ThisFormSet.nConnHandle)
			ThisFormSet.frmVendorImport.cmbForm.Value	= '10'
			ThisFormSet.frmVendorImport.cmbCC.Value		= IIF(cGrade="NIT 50 HS",'2','1')
			ThisFormSet.frmVendorImport.Pieces1.Value	= 1
			SET DECIMALS TO 3
			ThisFormSet.frmVendorImport.Thck1.Value		= VAL(cDiameter)
			ThisFormSet.frmVendorImport.SZ21.Value		= VAL(cLength)
			ThisFormSet.frmVendorImport.SZ31.Value		= 0
			SET DECIMALS TO 3
			ThisFormSet.frmVendorImport.Weight1.Value	= VAL(cWeight)
			ThisFormSet.frmVendorImport.txtSpecs.Value	= cCondition
			ThisFormSet.frmVendorImport.txtHeat.Value	= cHeatLot
			ThisFormSet.frmVendorImport.txtCond.Value	= cCondition
			ThisFormSet.frmVendorImport.txtDescript.Value= ''
			ThisFormSet.frmVendorImport.txtBrandName.Value= cGrade
			ThisFormSet.frmVendorImport.txtVendor.Value	= 'Electralloy'
			ThisFormSet.frmVendorImport.txtMill.Value	= 'Electrallo'
			SET DECIMALS TO nDecimals
			
			ThisFormSet.frmVendorImport.lblWEIGHT1.Click
			ThisFormSet.frmVendorImport.txtRecNum.Value = RECNO('tmpElectralloy')
			SKIP IN 'tmpElectralloy'
			
			ThisFormSet.frmVendorImport.Visible = .T.
		*	USE IN tmpElectralloy
		ENDIF
	ENDPROC

	PROCEDURE getstocklst_vendor
		*ThisFormset.GetStockLst_Vendor()
		
		IF USED("StockLst_Vendor")
			SELECT StockLst_Vendor
		ELSE
			SELECT 0
		ENDIF
		
		ThisFormSet.frmVendorStock.grdStockLst_Vendor.RecordSource=""
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.Stocklst_Vendor "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Vendor')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'StockLst_Vendor')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Vendor')
		ELSE
			SELECT StockLst_Vendor
			IF RECCOUNT('StockLst_Vendor') > 0
				
				ThisFormSet.frmVendorStock.grdStockLst_Vendor.RecordSource="StockLst_Vendor"
				
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshStockLst_Vendor()
	ENDPROC

	PROCEDURE getstocklst_wants
		*ThisFormSet.GetStockLst_Wants()
		
		IF USED("StockLst_Wants")
			SELECT StockLst_Wants
		ELSE
			SELECT 0
		ENDIF
		
		ThisFormSet.frmPurchaseStock.grdStockLst_Wants.RecordSource=""
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.Stocklst_Wants "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Wants')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'StockLst_Wants')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Wants')
		ELSE
			SELECT StockLst_Wants
			IF RECCOUNT('StockLst_Wants') > 0
				
				ThisFormSet.frmPurchaseStock.grdStockLst_Wants.RecordSource="StockLst_Wants"
				
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshStockLst_Wants()
	ENDPROC

	PROCEDURE Init
		ThisFormSet.GetStockLst_Wants()
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
	ENDPROC

	PROCEDURE refreshstocklst_vendor
		*ThisFormSet.frmPurchaseStock.RefreshStockLst_Vendor()
		
		IF USED('StockLst_Vendor')
			ThisFormSet.frmVendorStock.StockLst_ID.Value	= StockLst_Vendor.ID
			ThisFormSet.frmVendorStock.ALLOY1.Value		= StockLst_Vendor.Alloy
			ThisFormSet.frmVendorStock.cmbForm.Value	= StockLst_Vendor.Form
			ThisFormSet.frmVendorStock.cmbCC.Value		= StockLst_Vendor.CC
			ThisFormSet.frmVendorStock.Pieces1.Value	= StockLst_Vendor.Pc
			ThisFormSet.frmVendorStock.Thck1.Value		= StockLst_Vendor.Dim1
			ThisFormSet.frmVendorStock.SZ21.Value		= StockLst_Vendor.Dim2
			ThisFormSet.frmVendorStock.SZ31.Value		= StockLst_Vendor.dim3
			ThisFormSet.frmVendorStock.Weight1.Value	= StockLst_Vendor.MWeight
			ThisFormSet.frmVendorStock.txtSpecs.Value	= StockLst_Vendor.Specs
			ThisFormSet.frmVendorStock.txtHeat.Value	= StockLst_Vendor.Heat
			ThisFormSet.frmVendorStock.txtCond.Value	= StockLst_Vendor.Cond
			ThisFormSet.frmVendorStock.txtDescript.Value= StockLst_Vendor.Descript
			ThisFormSet.frmVendorStock.txtBrandName.Value= StockLst_Vendor.BrandName
			ThisFormSet.frmVendorStock.txtVendor.Value	= StockLst_Vendor.Vendor
			ThisFormSet.frmVendorStock.txtMill.Value	= StockLst_Vendor.Mill
			ThisFormSet.frmVendorStock.txtAddDate.Value	= StockLst_Vendor.AddDate
			
		ENDIF
	ENDPROC

	PROCEDURE refreshstocklst_wants
		*ThisFormSet.frmPurchaseStock.RefreshStockLst_Wants()
		
		IF USED('StockLst_Wants')
			ThisFormSet.frmPurchaseStock.StockLst_ID.Value	= StockLst_Wants.ID
			ThisFormSet.frmPurchaseStock.ALLOY1.Value	= StockLst_Wants.Alloy
			ThisFormSet.frmPurchaseStock.cmbForm.Value	= StockLst_Wants.Form
			ThisFormSet.frmPurchaseStock.cmbCC.Value	= StockLst_Wants.CC
			ThisFormSet.frmPurchaseStock.Pieces1.Value	= StockLst_Wants.Pc
			ThisFormSet.frmPurchaseStock.Thck1.Value	= StockLst_Wants.Dim1
			ThisFormSet.frmPurchaseStock.SZ21.Value		= StockLst_Wants.Dim2
			ThisFormSet.frmPurchaseStock.SZ31.Value		= StockLst_Wants.dim3
			ThisFormSet.frmPurchaseStock.Weight1.Value	= StockLst_Wants.MWeight
			ThisFormSet.frmPurchaseStock.txtSpecs.Value	= StockLst_Wants.Specs
			ThisFormSet.frmPurchaseStock.txtHeat.Value	= StockLst_Wants.Heat
			ThisFormSet.frmPurchaseStock.txtCond.Value	= StockLst_Wants.Cond
			ThisFormSet.frmPurchaseStock.txtDescript.Value	= StockLst_Wants.Descript
			ThisFormSet.frmPurchaseStock.txtAddDate.Value	= StockLst_Wants.AddDate
		ENDIF
	ENDPROC

	PROCEDURE form1.Check1.Click
		
		PRIVATE cFile
		cFile=GETFILE('CSV', 'Browse for CSV:', 'Open', 1, 'File' )
		IF VARTYPE(cFile)!="C"
			RETURN .f.
		ENDIF
		
		IF NOT FILE(cFile)
			MESSAGEBOX("File:"+ALLTRIM(cFile)+" not Found!",64,"Error")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		IF MESSAGEBOX("Is this From Electralloy?",4+64,"Known Source") = 6
			IF FILE(SYS(5)+SYS(2003)+"\MEM\tmpElectralloy.dbf")
				DELETE FILE(SYS(5)+SYS(2003)+"\MEM\tmpElectralloy.dbf")
			ENDIF
			
			CREATE TABLE SYS(5)+SYS(2003)+"\MEM\tmpElectralloy" FREE (Grade C(20),Diameter C(10),Length C(10),Weight C(10),HeatLot C(30),Condition C(30))
			
			IF NOT USED('tmpElectralloy')
				RETURN .F.
			ENDIF
			
			ThisFormSet.VendorFile = 'tmpElectralloy'
			
			APPEND FROM (cFile) TYPE CSV
			
			nRecCount = RECCOUNT('tmpElectralloy')
			IF nRecCount > 0
				
				IF MESSAGEBOX("Does this replace all current vendor?"+CHR(13)+"Found "+ALLTRIM(STR(nRecCount))+" records.",4+64,"Remove Old and Add new") = 6
					cSQL = "DELETE FROM dbo.StockLst_Vendor WHERE Vendor='Electralloy '"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
				ENDIF
				
		
				SELECT tmpElectralloy
				GO TOP 
				ThisFormSet.frmVendorImport.txtRecCount.Value = nRecCount 
				
				ThisFormSet.GetNextVendorImport()
				
				
			ENDIF
		ENDIF
	ENDPROC

