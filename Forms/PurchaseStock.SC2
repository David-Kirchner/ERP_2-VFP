	PROCEDURE frmPurchaseStock.ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisFormSet.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE frmPurchaseStock.ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE frmPurchaseStock.ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy,  ThisFormSet.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				MESSAGEBOX("Use Quotes-Alloys Standard program to add a new Alloy.",0+64,"Unkown Alloy.")
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmPurchaseStock.ALLOY1.When
		
		RETURN ThisFormSet.IsEditingStockLst_Wants
	ENDPROC

	PROCEDURE frmPurchaseStock.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		*This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE frmPurchaseStock.cmbCC.Valid
		*!*	IF ThisFormset.QUOTES.THCK1.Value * ThisFormset.QUOTES.SZ21.Value > 0
		*!*		IF NOT ThisFormset.QUOTES.SZ31.Visible
		*!*	*		IF ThisFormset.QUOTES.SZ21.Value > 0
		*!*				ThisFormSet.CalcInv(2)
		*!*	*		ENDIF
		*!*		ELSE
		*!*			IF ThisFormset.QUOTES.SZ31.Value > 0
		*!*				ThisFormSet.CalcInv(3) 
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE frmPurchaseStock.cmbCC.When
		RETURN ThisFormSet.IsEditingStockLst_Wants
	ENDPROC

	PROCEDURE frmPurchaseStock.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE frmPurchaseStock.cmbForm.Valid
		*!*	IF ThisFormset.QUOTES.THCK1.Value * ThisFormset.QUOTES.SZ21.Value > 0
		*!*		IF NOT ThisFormset.QUOTES.SZ31.Visible
		*!*				ThisFormSet.CalcInv(2)
		*!*			ELSE
		*!*			IF ThisFormset.QUOTES.SZ31.Value > 0
		*!*				ThisFormSet.CalcInv(3) 
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE frmPurchaseStock.cmbForm.When
		RETURN ThisFormSet.IsEditingStockLst_Wants
	ENDPROC

	PROCEDURE frmPurchaseStock.cmdDelete.Click
		IF THIS.Caption = "Delete"
			*Delete
			This.Parent.cmdNew.Enabled = .T.
			This.parent.cmdEdit.Enabled = .T.
			
			PRIVATE nStockLst_ID, cAlloy, cForm, cCC, nThck, cDescr
			nStockLst_ID = This.parent.StockLst_ID.Value
			cAlloy	= This.Parent.AlLOY1.Value
			cForm	= This.Parent.cmbForm.Value
			cCC		= This.Parent.cmbCC.Value
			nThck	= This.Parent.Thck1.Value
			cDescr = ALLTRIM(cAlloy)+" "+cForm+" "+cCC+" "+ALLTRIM(STR(nThck,10,4))
			
			IF nStockLst_ID > 0
				IF MESSAGEBOX( "Are you sure you want to Delete ID:"+ALLTRIM(STR(nStockLst_ID))+"?"+CHR(13)+cDescr,4+64,"Delete (Y/N)") = 6
					
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "DELETE dbo.Stocklst_Wants WHERE ID ="+ALLTRIM(STR(nStockLst_ID))
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					ThisForm.GetStockLst_Wants()
					
				ENDIF
			ENDIF
		ELSE
		*Abort
			This.Parent.cmdNew.Enabled = .T.
			This.Parent.cmdEdit.Caption = "Edit"
			This.parent.cmdEdit.Enabled = .T.
			This.Caption = "Delete"
			ThisFormSet.IsEditingStockLst_Wants = .F.
			
			ThisFormSet.Refreshstocklst_wants()
			
		ENDIF
	ENDPROC

	PROCEDURE frmPurchaseStock.cmdEdit.Click
		IF THIS.Caption = "Edit"
			This.Parent.cmdNew.Enabled = .F.
			This.Parent.cmdDelete.Caption = "Abort"
			This.parent.cmdDelete.Enabled = .T.
			This.Caption = "Save"
			ThisFormSet.IsEditingStockLst_Wants = .T.
		ELSE
		*Save
			PRIVATE nID, cAlloy, cForm, cCC, nPc, nDim1, nDim2, nDim3
			PRIVATE nMWeight, cSpecs, cHeat, cCond, cDescript
			PRIVATE cBrandName
			*,Size,CCSortValue,FormSort
			nID		= PrepareSQLnum(ThisForm.StockLst_ID.Value,'ID',-3)
			cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',13)
			cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
			nPc		= PrepareSQLnum(ThisForm.Pieces1.Value,'Pc',8,1)
			nDim1	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
			nDim2	= PrepareSQLnum(ThisForm.SZ21.Value,'Sz2',9,3)
			nDim3	= PrepareSQLnum(ThisForm.SZ31.Value,'Sz3',9,3)
			nMWeight = PrepareSQLnum(ThisForm.Weight1.Value,'Weight',9,1)
			cSpecs	= PrepareSQLtxt(ThisForm.txtSpecs.Value,'Specs',160)
			cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
			cCond	= PrepareSQLtxt(ThisForm.txtCond.Value,'Cond',50)
			cDescript = PrepareSQLtxt(ThisForm.txtDescript.Value,'Descript',20)
			cBrandName = ''
			*ThisForm.txtAddDate.Value
			
			PRIVATE cSQL, nSQLEXEC
			IF nID = 0
				*INSERT
				cSQL = "INSERT INTO dbo.StockLst_Wants "
				cSQL = cSQL+"( Alloy,Form,CC,Pc,Dim1,Dim2,Dim3"
				cSQL = cSQL+",MWeight,Specs,Heat,Cond,Descript"
				cSQL = cSQL+",Size,BrandName,CCSortValue,FormSort )"
				cSQL = cSQL+" VALUES ("
				cSQL = cSQL+"'"+cAlloy+"'"
				cSQL = cSQL+",'"+cForm+"'"
				cSQL = cSQL+",'"+cCC+"'"
				cSQL = cSQL+","+STR(nPc)+""
				cSQL = cSQL+","+STR(nDim1,10,4)+""
				cSQL = cSQL+","+STR(nDim2,9,3)+""
				cSQL = cSQL+","+STR(nDim3,9,3)+""
				cSQL = cSQL+","+STR(nMWeight,9,1)+""
				cSQL = cSQL+",'"+cSpecs+"'"
				cSQL = cSQL+",'"+cHeat+"'"
				cSQL = cSQL+",'"+cCond+"'"
				cSQL = cSQL+",'"+cDescript+"'"
				cSQL = cSQL+","+STR(nDim1,10,4)+""
				cSQL = cSQL+",'"+cBrandName+"'"
				cSQL = cSQL+",dbo.f_GetCCSortValue("+cCC+")"
				cSQL = cSQL+",dbo.f_FormSort("+cForm+")"
				cSQL = cSQL+")"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					ThisFormSet.GetStockLst_Wants()
					GO BOTTOM IN 'StockLst_Wants'
					ThisFormSet.RefreshStockLst_Wants()
				ENDIF
		
			ELSE
				*UPDATE
				cSQL = "UPDATE dbo.StockLst_Wants "
				cSQL = cSQL+" SET "
				cSQL = cSQL+" Alloy='"+cAlloy+"'"
				cSQL = cSQL+",Form='"+cForm+"'"
				cSQL = cSQL+",CC='"+cCC+"'"
				cSQL = cSQL+",Pc="+STR(nPc)+""
				cSQL = cSQL+",Dim1="+STR(nDim1,10,4)+""
				cSQL = cSQL+",Dim2="+STR(nDim2,9,3)+""
				cSQL = cSQL+",Dim3="+STR(nDim3,9,3)+""
				cSQL = cSQL+",MWeight="+STR(nMWeight,9,1)+""
				cSQL = cSQL+",Specs='"+cSpecs+"'"
				cSQL = cSQL+",Heat='"+cHeat+"'"
				cSQL = cSQL+",Cond='"+cCond+"'"
				cSQL = cSQL+",Descript='"+cDescript+"'"
				cSQL = cSQL+",Size="+STR(nDim1,10,4)+""
				cSQL = cSQL+",BrandName='"+cBrandName+"'"
				cSQL = cSQL+",CCSortValue=dbo.f_GetCCSortValue("+cCC+")"
				cSQL = cSQL+",FormSort=dbo.f_FormSort("+cForm+")"
				cSQL = cSQL+" WHERE ID = "+STR(nID)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
				ELSE
					ThisFormSet.GetStockLst_Wants()
					SELECT 'StockLst_Wants'
					LOCATE FOR ID = nID
					ThisFormSet.RefreshStockLst_Wants()
				ENDIF
				
			ENDIF
			
			This.Parent.cmdNew.Enabled = .T.
			This.Parent.cmdDelete.Caption = "Delete"
			This.parent.cmdDelete.Enabled = .T.
			This.Caption = "Edit"
			ThisFormSet.IsEditingStockLst_Wants = .F.
		ENDIF
	ENDPROC

	PROCEDURE frmPurchaseStock.cmdNew.Click
		ThisFormSet.IsEditingStockLst_Wants = .T.
		
		ThisForm.txtAddDate.Value = TTOD(DATETIME())
		ThisForm.StockLst_ID.Value = 0
		
		This.Enabled = .F.
		
		This.Parent.cmdEdit.Caption = "Save"
		This.parent.cmdEdit.Enabled = .T.
		This.Parent.cmdDelete.Caption = "Abort"
		This.parent.cmdDelete.Enabled = .T.
	ENDPROC

