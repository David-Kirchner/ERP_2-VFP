	PROCEDURE frmVendorImport.cmdEdit.Click
		
		*Save
		
		PRIVATE nID, cAlloy, cForm, cCC, nPc, nDim1, nDim2, nDim3
		PRIVATE nMWeight, cSpecs, cHeat, cCond, cDescript
		PRIVATE cBrandName, cVendor, cMill
		*,Size,CCSortValue,FormSort
		nID		= 0
		cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',13)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		nPc		= PrepareSQLnum(ThisForm.Pieces1.Value,'Pc',8,1)
		nDim1	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
		nDim2	= PrepareSQLnum(ThisForm.SZ21.Value,'Sz2',9,3)
		nDim3	= PrepareSQLnum(ThisForm.SZ31.Value,'Sz3',9,3)
		nMWeight = PrepareSQLnum(ThisForm.Weight1.Value,'Weight',9,1)
		cSpecs	= PrepareSQLtxt(ThisForm.txtSpecs.Value,'Specs',160)
		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cCond	= PrepareSQLtxt(ThisForm.txtCond.Value,'Cond',50)
		cDescript = PrepareSQLtxt(ThisForm.txtDescript.Value,'Descript',20)
		cBrandName = PrepareSQLtxt(ThisForm.txtBrandName.Value,'BrandName',20)
		cVendor = PrepareSQLtxt(ThisForm.txtVendor.Value,'Vendor',30)
		cMill 	= PrepareSQLtxt(ThisForm.txtMill.Value,'Mill',10)
		*ThisForm.txtAddDate.Value
		
		PRIVATE cSQL, nSQLEXEC
		
		*INSERT
		cSQL = "INSERT INTO dbo.StockLst_Vendor "
		cSQL = cSQL+"( Alloy,Form,CC,Pc,Dim1,Dim2,Dim3"
		cSQL = cSQL+",MWeight,Specs,Heat,Cond,Descript"
		cSQL = cSQL+",Size,BrandName,CCSortValue,FormSort,Vendor,Mill )"
		cSQL = cSQL+" VALUES ("
		cSQL = cSQL+"'"+cAlloy+"'"
		cSQL = cSQL+",'"+cForm+"'"
		cSQL = cSQL+",'"+cCC+"'"
		cSQL = cSQL+","+STR(nPc)+""
		cSQL = cSQL+","+STR(nDim1,10,4)+""
		cSQL = cSQL+","+STR(nDim2,9,3)+""
		cSQL = cSQL+","+STR(nDim3,9,3)+""
		cSQL = cSQL+","+STR(nMWeight,9,1)+""
		cSQL = cSQL+",'"+cSpecs+"'"
		cSQL = cSQL+",'"+cHeat+"'"
		cSQL = cSQL+",'"+cCond+"'"
		cSQL = cSQL+",'"+cDescript+"'"
		cSQL = cSQL+","+STR(nDim1,10,4)+""
		cSQL = cSQL+",'"+cBrandName+"'"
		cSQL = cSQL+",dbo.f_GetCCSortValue("+cCC+")"
		cSQL = cSQL+",dbo.f_FormSort("+cForm+")"
		cSQL = cSQL+",'"+cVendor+"'"
		cSQL = cSQL+",'"+cMill+"'"
		cSQL = cSQL+")"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC)
		ENDIF
		
		ThisFormSet.GetNextVendorImport()
	ENDPROC

	PROCEDURE frmVendorImport.Command1.Click
		SELECT (ThisFormSet.VendorFile)
		GO BOTTOM
		SKIP 1
		
		ThisFormSet.GetNextVendorImport()
		
	ENDPROC

	PROCEDURE frmVendorImport.LBLWEIGHT1.Click
		
		PRIVATE cAlloy,cForm,cCC,nPieces,nThck,nSz2,nSz3,nForceBracket
		cAlloy = PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		nPieces	= PrepareSQLnum(ThisForm.Pieces1.Value,'Pieces',-3)
		nThck	= PrepareSQLnum(ThisForm.Thck1.Value,'Thck',10,4)
		nSz2	= PrepareSQLnum(ThisForm.Sz21.Value,'sz2',9,3)
		nSz3	= PrepareSQLnum(ThisForm.Sz31.Value,'Sz3',9,3)
		nForceBracket = .F.
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.[p_GetFullQuote] "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',1,0),1,0)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
		ENDIF
		
		IF USED('tmpPriceTbl')
			IF VARTYPE(tmpPriceTbl.Pounds) = 'N'
				IF tmpPriceTbl.Pounds > 0
					
					IF EMPTY(ThisForm.WEIGHT1.Value)
						ThisForm.WEIGHT1.Value = tmpPriceTbl.Pounds
					ELSE
						nPC = ROUND(ThisForm.WEIGHT1.Value / tmpPriceTbl.Pounds,0)
						WAIT WINDOW ALLTRIM(STR(tmpPriceTbl.Pounds,10,1))+" LBS" NOWAIT
						
						ThisForm.Pieces1.Value = ROUND(ThisForm.WEIGHT1.Value / tmpPriceTbl.Pounds,0)
						ThisForm.Pieces1.Refresh
					ENDIF
					ThisForm.WEIGHT1.Refresh
				ENDIF
			ENDIF
			USE IN tmpPriceTbl
		ENDIF
	ENDPROC

