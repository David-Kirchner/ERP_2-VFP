	PROCEDURE checkdata		&& Validate before Save
		PRIVATE lSave
		lSave = .T.
		
		
		dARDate = PrepareSQLdate(ThisForm.Pageframe1.pgAdd.txtARDate.Value,'ARDate')
		IF EMPTY(dARDate)
			MESSAGEBOX( "You need an 'AR' date!"+CHR(13)+"I set to todays date.")
			dARDate = DATE()
			ThisForm.Pageframe1.pgAdd.txtARDate.Value = dARDate
			RETURN .F.
		ENDIF
		
		
		
		
		RETURN lSave
	ENDPROC

	PROCEDURE editar		&& EditAR
		PARAMETERS nRMA_No,nAR_No
		*ThisForm.EditAR(nRMA_No,nAR_No)
		
		
		*!*	IF TYPE("pRMA_No") != "N"
		*!*		*Erorr
		*!*		RETURN .F.
		*!*	ENDIF
		
		*!*	IF pRMA_No < 1
		*!*		*Erorr
		*!*		RETURN .F.
		*!*	ENDIF
		
		SELECT ActionRequest
		*SEEK pRMA_No ORDER TAG RMA_No
		*IF FOUND('RMA')
		ThisForm.Pageframe1.pgAdd.txtAR_No.Value		= ActionRequest.AR_No
		ThisForm.Pageframe1.pgAdd.txtSalesNum.Value		= ActionRequest.SalesNum
		ThisForm.Pageframe1.pgAdd.txtPOnum.Value		= ActionRequest.POnum
		ThisForm.Pageframe1.pgAdd.txtCustomer.Value		= ActionRequest.Customer
		*ThisForm.Pageframe1.pgAdd.txtFrom.Value			= ActionRequest.ARPerson
		ThisForm.Pageframe1.pgAdd.cmbSource.Value		= ActionRequest.Source
		ThisForm.Pageframe1.pgAdd.cmbRisk.Value			= ActionRequest.Risk
		ThisForm.Pageframe1.pgAdd.txtARDate.Value		= ActionRequest.ARDate
		ThisForm.Pageframe1.pgAdd.txtDueDate.Value		= ActionRequest.DueDate
		
		ThisForm.Pageframe1.pgAdd.pfAR.pgProblem.txtARPerson.Value		= ActionRequest.ARPerson
		ThisForm.Pageframe1.pgAdd.pfAR.pgProblem.cmbDisposition.Value	= ActionRequest.Disposition
		ThisForm.Pageframe1.pgAdd.pfAR.pgProblem.txtProblem.Value		= ActionRequest.Problem
		
		ThisForm.Pageframe1.pgAdd.pfAR.pgInstruction.txtInstruction.Value	= ActionRequest.Instruction
		ThisForm.Pageframe1.pgAdd.pfAR.pgInstruction.txtReworkDate.Value	= ActionRequest.Rework_Date
		
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.chkCAR.Value		= ActionRequest.car
		
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgDeterCause.txtDeterCause.Value	= ActionRequest.DeterCause
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgCauseProb.txtCauseProb.Value		= ActionRequest.CauseProb
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgSolEffectiv.txtSolEffectiv.Value	= ActionRequest.Solution
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgSolEffectiv.txtSolBy.Value		= ActionRequest.SolBy
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgSolEffectiv.txtSolDate.Value		= ActionRequest.SolDate
		
		ThisForm.Pageframe1.pgAdd.pfAR.pgEffective.txtVerifySol.Value	= ActionRequest.VerifySol
		ThisForm.Pageframe1.pgAdd.pfAR.pgEffective.txtVeriBy.Value		= ActionRequest.VeriBy
		ThisForm.Pageframe1.pgAdd.pfAR.pgEffective.txtVeriDate.Value	= ActionRequest.VeriDate
		
		
		ThisForm.Pageframe1.pgAdd.ActivePage = 1
		ThisForm.Pageframe1.pgAdd.pfAR.ActivePage = 1
		ThisForm.Pageframe1.pgAdd.txtSalesNum.SetFocus()
		*ELSE
		*	MESSAGEBOX("RMA "+ALLTRIM(STR(pRMA_No))+" was not found!",0,"No Edit")
		*ENDIF
		
	ENDPROC

	PROCEDURE Init
		
		PUBLIC aSoItems(1), gaReason(1), gReason
		aSoItems(1)=" "
		gaReason(1)=""
		gReason = ""
		
		ThisForm.ncmbFind = 1
		ThisForm.Pageframe1.pgEdit.cmbFind.Value = 1
		ThisForm.Pageframe1.pgFind.cmbFind.Value = 1
		
		ThisForm.FindText = 0
		ThisForm.Pageframe1.pgEdit.txtFindText.Value = 0
		ThisForm.Pageframe1.pgFind.txtFindText.Value = 0
		
		ThisForm.OleDate = DATE()
		
		ThisForm.Pageframe1.pgAdd.txtAR_No.SetFocus
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisForm.Load_ActionRequest()
		
		SELECT ActionRequest
		
		
	ENDPROC

	PROCEDURE load_actionrequest
		PARAMETERS pWhat
		*ThisForm.Load_ActionRequest()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		
		IF UPPER(pWhat) ="REFRESH"
			ThisForm.frmRMA.pf1.pgEdit.Grid1.RecordSource = ''
			ThisForm.frmRMA.pf1.pgBrowse.GridBR.RecordSource = ''
			
			IF USED('ActionRequest')
				USE IN ActionRequest
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('ActionRequest')
			SELECT 0
		
			cSQL = "SELECT * FROM dbo.ActionRequest WITH(NOLOCK)"
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ActionRequest')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ActionRequest')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ActionRequest')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ActionRequest')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'ActionRequest' )
			ENDIF
		
		ENDIF
		
		IF USED('ActionRequest')
			
			SELECT ActionRequest
			INDEX ON AR_No TAG AR_No
			SET ORDER TO AR_No
			GO BOTTOM
			
			IF UPPER(pWhat) ="REFRESH"
				GO BOTTOM
		
				ThisForm.Pageframe1.pgEdit.Grid1.RecordSource = 'ActionRequest'
				ThisForm.Pageframe1.pgBrowse.GridBR.RecordSource = 'ActionRequest'
			ENDIF
		ELSE
			MESSAGEBOX('Failed to load ActionRequest',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

	PROCEDURE refreshedittab
		ThisForm.Pageframe1.pgEdit.txtCustomer.Refresh
		ThisForm.Pageframe1.pgEdit.txtARPerson.Refresh
		ThisForm.Pageframe1.pgEdit.txtAR_No.Refresh
		ThisForm.Pageframe1.pgEdit.txtRMA.Refresh
		ThisForm.Pageframe1.pgEdit.txtProblem.Refresh
		ThisForm.Pageframe1.pgEdit.txtInstruction.Refresh
		ThisForm.Pageframe1.pgEdit.txtARDate.Refresh
		ThisForm.Pageframe1.pgEdit.txtDueDate.Refresh
		
		ThisForm.Pageframe1.pgEdit.chkDeleted.Value = DELETED('ActionRequest')
		ThisForm.Pageframe1.pgEdit.chkDeleted.Refresh
		
		ThisForm.Pageframe1.pgEdit.Grid1.Refresh
		
		ThisForm.Pageframe1.pgEdit.Vcr1.EnableDisableButtons()
		
	ENDPROC

