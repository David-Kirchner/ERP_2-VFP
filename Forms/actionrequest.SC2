	ENDPROC

	PROCEDURE Pageframe1.pgAdd.Click
		PRIVATE recb4,Ordrb4
		SELECT ActionRequest
		recb4 = 0
		recb4 = RECNO("ActionRequest")
		Ordrb4 = ORDER()
		SET ORDER TO AR_No
		GO BOTTOM
		
		IF NOT EMPTY(Ordrb4)
			SET ORDER TO (Ordrb4)
		ELSE
			SET ORDER TO
		ENDIF
		
		IF recb4 > 0 AND recb4 <= RECCOUNT("ActionRequest")
			GOTO recb4
		ENDIF
		
	ENDPROC

