	PROCEDURE Pageframe1.pgEdit.cmbFind.InteractiveChange
		ThisForm.ncmbFind = This.Value
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmbFind.Valid
		
		PRIVATE IntcmbFind
		IntcmbFind = PrepareSQLnum(This.Value,'nCmbFind',1)
		
		ThisForm.ncmbFind = IntcmbFind
		DO CASE
		CASE IntcmbFind = 1
			*AR_NO int
			*HPAPO n,10
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999999"
		CASE IntcmbFind = 2
			*RMA int
			*Salesnum n,7
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999999"
		CASE IntcmbFind = 3
			*SalesNum int
			*Company c,30
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999999"
		CASE IntcmbFind = 4
			*PONum int
			*SOitem c,10
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999999"
		CASE IntcmbFind = 5
			*Customer C30
			m.FindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		ENDCASE
		This.Parent.txtFindText.Refresh
		
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmdEdit.Click
		PRIVATE nRMA, nAR_No
		
		nRMA = ActionRequest.RMA
		nAR_No = ActionRequest.AR_No
		*This.parent.parent.pgAdd.txtRMA_No.Value = nRMA_No
		
		ThisForm.EditAR(nRMA, nAR_No)
		
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmdFindcmbText.Valid
		PRIVATE IntcmbFind, recb4find, nBestFind
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace m.FindText
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		IF TYPE('laText2Find') = "N"
			lnText2Find = laText2Find
			lcText2Find = ALLTRIM(STR(laText2Find))
		ENDIF
		IF TYPE('laText2Find') = "C"
			lcText2Find = ALLTRIM(laText2Find)
			lnText2Find = VAL(laText2Find)
		ENDIF
		
		PRIVATE IntcmbFind
		IntcmbFind = PrepareSQLnum(ThisForm.ncmbFind,'nCmbFind',1)
		
		recb4find = 0
		recb4find = RECNO('ActionRequest')
		
		SELECT ActionRequest
		DO CASE
		CASE IntcmbFind = 1
			*AR_NO int
			BROW for AR_NO = lnText2Find
			
			This.parent.parent.pgFind.cmbFind.Value		= IntcmbFind 
			This.parent.parent.pgFind.txtFindText.Value	= lnText2Find
		
		CASE IntcmbFind = 2
			*RMA int
			BROW for RMA = lnText2Find
		
			This.parent.parent.pgFind.cmbFind.Value		= IntcmbFind 
			This.parent.parent.pgFind.txtFindText.Value	= lnText2Find
		
		CASE IntcmbFind = 3
			*SalesNum int
			BROW for SalesNum = lnText2Find
			
			This.parent.parent.pgFind.cmbFind.Value		= IntcmbFind 
			This.parent.parent.pgFind.txtFindText.Value	= lnText2Find
		
		CASE IntcmbFind = 4
			*PONum int
			BROW for PONum = lnText2Find
		
			This.parent.parent.pgFind.cmbFind.Value		= IntcmbFind 
			This.parent.parent.pgFind.txtFindText.Value	= lnText2Find
			
		CASE IntcmbFind = 5
			*Customer c,30
			COUNT TO ncomp for UPPER(Customer) = UPPER(lcText2Find)
			IF ncomp > 0
				BROW for UPPER(Customer) = UPPER(lcText2Find) TITLE "Click X to close this find window."
			ELSE
				COUNT TO ncomp for LEFT(UPPER(Customer),4) = LEFT(UPPER(lcText2Find ),4)
				IF ncomp > 0
					BROW for LEFT(UPPER(Customer),4) = LEFT(UPPER(lcText2Find ),4) TITLE "Click X to close. Matched first 4 letters."
				ELSE
					COUNT TO ncomp for LEFT(UPPER(Customer),2) = LEFT(UPPER(lcText2Find ),2)
					IF ncomp > 0
						BROW for LEFT(UPPER(Customer),2) = LEFT(UPPER(lcText2Find ),2) TITLE "Click X to close. Matched first 2 letters."
					ELSE
						BROW for LEFT(UPPER(Customer),1) = LEFT(UPPER(lcText2Find ),1) TITLE "Click X to close. Matched first 1 letter only."
					ENDIF
				ENDIF
			ENDIF
		
			This.parent.parent.pgFind.cmbFind.Value		= IntcmbFind 
			This.parent.parent.pgFind.txtFindText.Value	= lcText2Find 
		
		ENDCASE
		
		IF NOT FOUND('ActionRequest')
			nBestFind = RECNO(0)
			IF nBestFind > 0 AND nBestFind <= RECCOUNT("ActionRequest")
				GOTO nBestFind 
			ENDIF
			IF EOF('ActionRequest')
				WAIT WINDOW 'Not Found' NOWAIT
				IF recb4find > 0 AND recb4find <= RECCOUNT("ActionRequest")
					GO recb4find
				ENDIF
			ELSE
				WAIT WINDOW 'closest match' NOWAIT
			ENDIF
		ENDIF
		
		
		
		ThisForm.RefreshEditTab()
		
		This.Parent.Grid1.Setfocus
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmdFindcmbText.When
		IF EMPTY(m.FindText)
			=MESSAGEBOX("Enter text first",16,"No text")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE Pageframe1.pgEdit.cmdPrint.Click
		PRIVATE nRMA_No, nCurrRMA
		
		*nRMA_No = RMA.RMA_No
		SELECT ActionRequest
		nCurrRMA = RECNO()
		
		IF FILE('reports\ActionRequest.FRX')
			REPORT FORM Reports\ActionRequest NEXT 1 TO PRINT PREVIEW
		ENDIF
		
		SELECT ActionRequest
		IF nCurrRMA > 0
			IF nCurrRMA < RECCOUNT('ActionRequest')
				GOTO nCurrRMA
			ENDIF
		ENDIF
	ENDPROC

