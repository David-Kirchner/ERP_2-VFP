		ThisForm.Pageframe1.pgAdd.txtCustomer.Value = ''
		*ThisForm.Pageframe1.pgAdd.txtFrom.Value			
		ThisForm.Pageframe1.pgAdd.cmbSource.Value = ''
		ThisForm.Pageframe1.pgAdd.cmbRisk.Value = ''
		ThisForm.Pageframe1.pgAdd.txtARDate.Value	= CTOD("  /  /  ")
		ThisForm.Pageframe1.pgAdd.txtDueDate.Value = CTOD("  /  /  ")
		
		ThisForm.Pageframe1.pgAdd.pfAR.pgProblem.txtARPerson.Value = ''		
		ThisForm.Pageframe1.pgAdd.pfAR.pgProblem.cmbDisposition.Value = ''	
		ThisForm.Pageframe1.pgAdd.pfAR.pgProblem.txtProblem.Value = ''
		
		ThisForm.Pageframe1.pgAdd.pfAR.pgInstruction.txtInstruction.Value = ''
		ThisForm.Pageframe1.pgAdd.pfAR.pgInstruction.txtReworkDate.Value = CTOD("  /  /  ")
		
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.chkCAR.Value = 0
		
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgDeterCause.txtDeterCause.Value = ''
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgCauseProb.txtCauseProb.Value = ''
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgSolEffectiv.txtSolEffectiv.Value = ''
		ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgSolEffectiv.txtSolBy.Value = ''
