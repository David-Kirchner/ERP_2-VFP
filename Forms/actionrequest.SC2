		ThisForm.Pageframe1.pgAdd.pfAR.pgEffective.txtVeriDate.Value = CTOD("  /  /  ")
		
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETER pSaveType
		PRIVATE m.shipcomplete, lActionRequestsaved
		PRIVATE nCurrRec
		PRIVATE lnSalesNum
		PRIVATE lActionRequest, nSalesNum, cCustomer, dARdate
		
		lActionRequestsaved = .F.
		lActionRequest = .T.
		
		SELECT ActionRequest
		
		IF ThisForm.CheckData()
				
			PRIVATE nAR_No,nSalesNum,nPOnum,cCustomer
			PRIVATE cSource,cRisk,dARDate,dDueDate
			PRIVATE cARPerson,cDisposition,cProblem,cInstruction,dRework_Date
			PRIVATE lCAR,cDeterCause,cCauseProb,cSolution
			PRIVATE cSolBy,dSolDate,cVerifySol,cVeriBy,dVeriDate
		
				
			nAR_No		= PrepareSQLnum(ThisForm.Pageframe1.pgAdd.txtAR_No.Value,'AR_No',-3)
			nRMA		= PrepareSQLnum(ThisForm.Pageframe1.pgAdd.txtRMA.Value,'RMA',-3)
			nSalesNum	= PrepareSQLnum(ThisForm.Pageframe1.pgAdd.txtSalesNum.Value,'SalesNum',-3)
			nPOnum		= PrepareSQLnum(ThisForm.Pageframe1.pgAdd.txtPOnum.Value,'PONum',10,0)
			cCustomer	= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.txtCustomer.Value,'Customer',30)
			
			cSource		= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.cmbSource.Value,'Source',1)
			cRisk		= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.cmbRisk.Value,'Risk',1)
			dARDate		= PrepareSQLdate(ThisForm.Pageframe1.pgAdd.txtARDate.Value,'ARdate')
			dDueDate	= PrepareSQLdate(ThisForm.Pageframe1.pgAdd.txtDueDate.Value,'DueDate')
		
			cARPerson		= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.pfAR.pgProblem.txtARPerson.Value,'ARperson',02)	
			cDisposition	= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.pfAR.pgProblem.cmbDisposition.Value,'Disposition',10)
			cProblem		= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.pfAR.pgProblem.txtProblem.Value,'Problem',-1)
		
			cInstruction	= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.pfAR.pgInstruction.txtInstruction.Value,'Instruction',-1)
			dRework_Date	= PrepareSQLdate(ThisForm.Pageframe1.pgAdd.pfAR.pgInstruction.txtReworkDate.Value,'ReworkDate')
		
			lCAR			= PrepareSQLchk(ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.chkCAR.Value,'CAR')
		
			cDeterCause	= PrepareSQLdate(ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgDeterCause.txtDeterCause.Value,'DeterCause',-1)	
			cCauseProb	= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgCauseProb.txtCauseProb.Value,'CauseProb',-1)
			cSolution	= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgSolEffectiv.txtSolEffectiv.Value,'SolEffectiv',-1)
			cSolBy		= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgSolEffectiv.txtSolBy.Value,'SolBy',20)
			dSolDate	= PrepareSQLdate(ThisForm.Pageframe1.pgAdd.pfAR.pgCorrectiveAction.pfCAR.pgSolEffectiv.txtSolDate.Value,'SolDate')
		
			cVerifySol 	= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.pfAR.pgEffective.txtVerifySol.Value,'VerifySol',-1)
			cVeriBy	 	= PrepareSQLtxt(ThisForm.Pageframe1.pgAdd.pfAR.pgEffective.txtVeriBy.Value,'VeriBy',20)
			dVeriDate	= PrepareSQLdate(ThisForm.Pageframe1.pgAdd.pfAR.pgEffective.txtVeriDate.Value,'VeriDate')
		
			IF VARTYPE(nSalesNum )="C"
				nSalesNum = VAL(nSalesNum)
			ENDIF
			
			IF EMPTY(nAR_No)
				nAR_No = GetMaxAR_No()+1
			ENDIF
			PRIVATE nCountActionRequest
			nCountActionRequest = Count_ActionRequest( nAR_No, ThisForm.nConnhandle )
			
			IF nCountActionRequest = 0
				
				cSQL = "INSERT INTO dbo.ActionRequest "
				cSQL = cSQL + "( AR_No, RMA, SalesNum, POnum, Customer, Source, Risk, ARDate, DueDate, ARPerson, Disposition, Problem, Instruction, Rework_Date, CAR, DeterCause, CauseProb, Solution, SolBy, SolDate, VerifySol, VeriBy, VeriDate) VALUES ("
				cSQL = cSQL + " "+STR(nAR_No)
				cSQL = cSQL + ","+STR(nRMA)
				cSQL = cSQL + ","+STR(nSalesNum)
				cSQL = cSQL + ","+STR(nPOnum)
				cSQL = cSQL + ",'"+cCustomer+"'"
				cSQL = cSQL + ",'"+cSource+"'"
				cSQL = cSQL + ",'"+cRisk+"'"
				cSQL = cSQL + ",'"+IIF(EMPTY(dARDate),'',DTOC(dARDate))+"'"
				cSQL = cSQL + ",'"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
				cSQL = cSQL + ",'"+cARPerson+"'"
				cSQL = cSQL + ",'"+cDisposition+"'"
				cSQL = cSQL + ",'"+cProblem+"'"
				cSQL = cSQL + ",'"+cInstruction+"'"
				cSQL = cSQL + ",'"+IIF(EMPTY(dRework_Date),'',DTOC(dRework_Date))+"'"
				cSQL = cSQL + ","+IIF(lCAR,'0','1')
				cSQL = cSQL + ",'"+cDeterCause+"'"
				cSQL = cSQL + ",'"+cCauseProb+"'"
				cSQL = cSQL + ",'"+cSolution+"'"
				cSQL = cSQL + ",'"+cSolBy+"'"
				cSQL = cSQL + ",'"+IIF(EMPTY(dSolDate),'',DTOC(dSolDate))+"'"
				cSQL = cSQL + ",'"+cVerifySol+"'"
				cSQL = cSQL + ",'"+cVeriBy+"'"
				cSQL = cSQL + ",'"+IIF(EMPTY(dVeriDate),'',DTOC(dVeriDate))+"'"
				cSQL = cSQL + ")"
					  
		
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
				ELSE
					lActionRequestsaved = .T.
				ENDIF
			
			ELSE
				IF MESSAGEBOX("ActionRequest #"+STR(nAR_No)+" already exist."+CHR(13)+CHR(13)+"Do you want to Update?.",0,"Update?") = 6
					
					cSQL = "UPDATE dbo.ActionRequest SET "
					cSQL = cSQL + " AR_No="+STR(nAR_No)
					cSQL = cSQL + ",RMA="+STR(nRMA)
					cSQL = cSQL + ",SalesNum="+STR(nSalesNum)
					cSQL = cSQL + ",POnum="+STR(nPOnum)
					cSQL = cSQL + ",Customer='"+cCustomer+"'"
					cSQL = cSQL + ",Source='"+cSource+"'"
					cSQL = cSQL + ",Risk='"+cRisk+"'"
					cSQL = cSQL + ",ARDate='"+IIF(EMPTY(dARDate),'',DTOC(dARDate))+"'"
					cSQL = cSQL + ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
					cSQL = cSQL + ",ARPerson='"+cARPerson+"'"
					cSQL = cSQL + ",Disposition='"+cDisposition+"'"
					cSQL = cSQL + ",Problem='"+cProblem+"'"
					cSQL = cSQL + ",Instruction='"+cInstruction+"'"
					cSQL = cSQL + ",Rework_Date='"+IIF(EMPTY(dRework_Date),'',DTOC(dRework_Date))+"'"
					cSQL = cSQL + ",CAR="+IIF(lCAR,'0','1')
					cSQL = cSQL + ",DeterCause='"+cDeterCause+"'"
					cSQL = cSQL + ",CauseProb='"+cCauseProb+"'"
					cSQL = cSQL + ",Solution='"+cSolution+"'"
					cSQL = cSQL + ",SolBy='"+cSolBy+"'"
					cSQL = cSQL + ",SolDate='"+IIF(EMPTY(dSolDate),'',DTOC(dSolDate))+"'"
					cSQL = cSQL + ",VerifySol='"+cVerifySol+"'"
					cSQL = cSQL + ",VeriBy='"+cVeriBy+"'"
					cSQL = cSQL + ",VeriDate='"+IIF(EMPTY(dVeriDate),'',DTOC(dVeriDate))+"'"
					cSQL = cSQL + "	WHERE AR_No = "+STR(nAR_No)+""
		*			cSQL = cSQL + " AND RMA = "+STR(nRMA)
		*			cSQL = cSQL + " AND SalesNum = "+STR(nSalesNum)
		*			cSQL = cSQL + " AND POnum = "+STR(nPOnum)
		
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,  cSQL)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
					ELSE
						lActionRequestsaved = .T.
					ENDIF
				ENDIF
			ENDIF
		
			IF lActionRequestsaved
				IF pSaveType = "ADD"
					ThisForm.ResetAddVars()
				ENDIF
				ThisForm.Pageframe1.pgAdd.REFRESH
		
			ENDIF
		ELSE
			*BAD DATA
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		
		IF USED('ActionRequest')
			USE IN ActionRequest
		ENDIF
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdQuit.Click
		IF USED('ActionRequest')
			cUsed = ALIAS()
			SELECT ActionRequest
			lcSafety = SET('SAFETY')
			SET SAFETY OFF
			
		*	WAIT WINDOW "Saving to receiving" NOWAIT
			IF "\MEM" $ SYS(2003)
				COPY TO (SYS(5)+SYS(2003) +"\ActionRequest") FOR Ardate > DATE()-14
			ELSE
				COPY TO (SYS(5)+SYS(2003) +"\MEM\ActionRequest") FOR Ardate > DATE()-14
			ENDIF
		
			IF NOT EMPTY(lcSafety)
				IF lcSafety = "ON"
					SET SAFETY ON
				ENDIF
			ENDIF
			IF NOT EMPTY(cUsed)
				SELECT (cUsed)
			ENDIF
		ENDIF
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdView.cmdVDue.Click
		PRIVATE currec1
		WAIT WINDOW 'Please wait while selecting records.' NOWAIT
		SELECT ActionRequest
		currec1 = RECNO("ActionRequest")
		SET DELETED ON
		REPORT FORM ActionRequest PREVIEW FOR ActionRequest.Returned=CTOD('  /  /  ') and !ActionRequest.Cancelled AND !DELETED()
		SET DELETED OFF
		** SHOW records that have not shipped 
		** AND not cancelled AND NOT DELETED()
		IF currec1 > 0 AND currec1 < RECCOUNT("ActionRequest")
			GOTO (currec1) IN ActionRequest
		ENDIF
	ENDPROC

