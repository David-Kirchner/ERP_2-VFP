DEFINE CLASS frmdeadcert AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdBrokerLst" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdStockLst" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtDays" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdQuit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblDays" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblFindHeat" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtHeat" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSearchHeat" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Dead Cert Report"
		DoCreate = .T.
		Height = 225
		Icon = graphics\earth-globe.ico
		Left = 0
		Name = "frmDeadCert"
		nconnhandle = 0
		Top = 0
		Width = 248
	*</PropValue>

	ADD OBJECT 'cmdBrokerLst' AS commandbutton WITH ;
		Caption = "Broker List", ;
		Height = 27, ;
		Left = 132, ;
		Name = "cmdBrokerLst", ;
		TabIndex = 3, ;
		Top = 7, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdQuit' AS commandbutton WITH ;
		Caption = "Quit", ;
		Height = 27, ;
		Left = 84, ;
		Name = "cmdQuit", ;
		TabIndex = 8, ;
		Top = 192, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSearchHeat' AS commandbutton WITH ;
		Caption = "Search", ;
		Height = 27, ;
		Left = 148, ;
		Name = "cmdSearchHeat", ;
		TabIndex = 7, ;
		Top = 124, ;
		Width = 72
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdStockLst' AS commandbutton WITH ;
		Caption = "Stock List", ;
