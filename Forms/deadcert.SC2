		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		Height = 73, ;
		Left = 12, ;
		Name = "Shape1", ;
		Top = 96, ;
		Width = 217
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txtDays' AS textbox WITH ;
		Alignment = 3, ;
		Height = 23, ;
		InputMask = "9999", ;
		Left = 43, ;
		Name = "txtDays", ;
		TabIndex = 2, ;
		Top = 35, ;
		Value = 180, ;
		Width = 60
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtHeat' AS textbox WITH ;
		Height = 23, ;
		Left = 22, ;
		Name = "txtHeat", ;
		TabIndex = 6, ;
		Top = 127, ;
		Width = 118
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdBrokerLst.Click
		PRIVATE cSQL, nDays
		nDays = ThisForm.txtDays.Value
		
		IF USED('tmpLst')
			USE IN tmpLst
		ENDIF
		SELECT 0
		
		cSQL = "SELECT heat,CONVERT(VARCHAR(12), [When],101) AS [Date],Alloy,Form,CC,CL,Size,PO_Item,History FROM dbo.Ar_BrokerLst_Master_history WITH(NOLOCK) "
		cSQL = cSQL + " WHERE HEAT != 'DUE IN' "
		cSQL = cSQL + " AND [WHEN] > GetDate() - "+STR(nDays)+" AND [WHAT] = 'DELETE    '"
		cSQL = cSQL + " AND HEAT NOT IN (SELECT Heat FROM dbo.BrokerLst_Master WHERE HEAT != 'DUE IN')"
		cSQL = cSQL + " ORDER BY [When]"
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpLst')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'tmpLst')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpLst')
		ENDIF
		
		IF USED('tmpLst')
			REPORT FORM Reports\DeadCert PREVIEW
			
		ENDIF
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdSearchHeat.Click
		PRIVATE cHeat
		cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		
		
		IF EMPTY( cHeat )
			MESSAGEBOX("You must Enter a Heat first",0+16,"Bad Heat")
			RETURN
		ENDIF
		
		IF USED('tmpLst')
			USE IN tmpLst
		ENDIF
		SELECT 0
		
		cSQL = "SELECT 'BrokerLst Deleted' AS Heat"
		cSQL = cSQL + " ,CONVERT(VARCHAR(12), [When],101) AS Date"
		cSQL = cSQL + " ,Alloy,Form,CC,CL,Size,PO_Item,History"
		cSQL = cSQL + " FROM dbo.Ar_BrokerLst_Master_history WITH(NOLOCK) WHERE HEAT LIKE '%"+cHeat+"%'"
		cSQL = cSQL + " AND [WHAT] = 'DELETE    '"
		cSQL = cSQL + " UNION"
		cSQL = cSQL + " SELECT 'BrokerLst Current' AS Heat"
		cSQL = cSQL + " ,CONVERT(VARCHAR(12), GETDATE(),101) AS Date"
		cSQL = cSQL + " ,Alloy,Form,CC,CL,Size,PO_Item,History"
		cSQL = cSQL + " FROM dbo.BrokerLst_Master WHERE HEAT LIKE '%"+cHeat+"%'"
		cSQL = cSQL + " UNION"
		cSQL = cSQL + " SELECT 'StockLst Deleted' AS Heat"
		cSQL = cSQL + " ,CONVERT(VARCHAR(12), [When],101) AS Date"
		cSQL = cSQL + " ,Alloy,Form,CC,CL,Size,PO_Item,History"
		cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History WITH(NOLOCK) WHERE HEAT LIKE '%"+cHeat+"%'"
		cSQL = cSQL + " AND [WHAT] = 'DELETE    '"
		cSQL = cSQL + " UNION"
		cSQL = cSQL + " SELECT 'StockLst Current' AS Heat"
		cSQL = cSQL + " ,CONVERT(VARCHAR(12), GETDATE(),101) AS Date"
		cSQL = cSQL + " ,Alloy,Form,CC,CL,Size,PO_Item,History"
		cSQL = cSQL + " FROM dbo.StockLst_Master WHERE HEAT LIKE '%"+cHeat+"%'"
		
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpLst')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'tmpLst')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpLst')
		ENDIF
		
		
		IF USED('tmpLst')
			IF RECCOUNT('tmpLst') > 0
				REPORT FORM Reports\DeadCert PREVIEW
			ELSE
				MESSAGEBOX( "No records found for Heat like '"+cHeat+"' !",0+48,"No find!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdStockLst.Click
		PRIVATE cSQL, nDays
		nDays = ThisForm.txtDays.Value
		
		IF USED('tmpLst')
			USE IN tmpLst
		ENDIF
		SELECT 0
		
		cSQL = "SELECT heat,CONVERT(VARCHAR(12), [When],101) AS [Date],Alloy,Form,CC,CL,Size,PO_Item,History "
		cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History WITH(NOLOCK) "
		cSQL = cSQL + " WHERE HEAT != 'DUE IN' "
		cSQL = cSQL + " AND [WHEN] > GetDate() - "+STR(nDays)+" AND [WHAT] = 'DELETE    '"
		cSQL = cSQL + " AND HEAT NOT IN (SELECT Heat FROM dbo.StockLst_Master WHERE HEAT != 'DUE IN')"
		cSQL = cSQL + " ORDER BY [When]"
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpLst')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'tmpLst')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpLst')
		ENDIF
		
		IF USED('tmpLst')
			REPORT FORM Reports\DeadCert PREVIEW
		
		ENDIF
	ENDPROC

ENDDEFINE
