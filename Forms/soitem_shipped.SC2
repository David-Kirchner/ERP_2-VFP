	PROCEDURE Init
		PARAMETERS pSOitem, pConnHandle
		
		*DO FORM Forms\SOitem_Shipped WITH SOitem, Conn
		*pSOitem = ' 100442-01'
		*pSOitem = ' 100442-01'
		
		PRIVATE cSOitem
		IF VARTYPE(pSOitem) = "C"
			cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		ELSE
			*RETURN ''
			cSOitem = ' 138016-01'
		ENDIF
		
		IF TYPE("pConnHandle") = "N"
			IF pConnHandle > 0
				ThisForm.nConnHandle = pConnHandle
			ELSE
				ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
				IF ThisForm.nConnHandle > 0
					ThisForm.CloseConn = .T.
				ELSE
					MESSAGEBOX("Could not connect to SQL")
					RETURN ''
				ENDIF
			ENDIF		
		ELSE
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			IF ThisForm.nConnHandle > 0
				ThisForm.CloseConn = .T.
			ELSE
				MESSAGEBOX("Could not connect to SQL")
				RETURN ''
			ENDIF
		ENDIF
		
		********************************
		ThisForm.cSOitem = cSOitem
		
		ThisForm.Load_tmpTables()
		*ThisForm.Load_tmpQuote()
		*ThisForm.Load_tmpSales()
		*ThisForm.Load_tmpSales_Ship()
		*ThisForm.Load_tmpSales_Packing()
		
		IF NOT USED('tmpSales_Ship')
			MESSAGEBOX( "Could not loading the Ship table.",16,"Program Error")
			RETURN ""
		ENDIF
		
		****************************
		*ON HOLD ?
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE load_tmpquote
		*ThisForm.Load_tmpQuote
		
		IF USED('tmpQuote')
			USE IN tmpQuote
		ENDIF
		
		SELECT 0
		cSQL = "SELECT Company,PO_Num " 
		cSQL = cSQL + " ,dbo.f_SaleRep_SP(SalesP) AS SalesRep "
		cSQL = cSQL + " ,Pieces "
		cSQL = cSQL + " FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE SOitem = '"+ThisForm.cSOitem+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpQuote")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpQuote')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuote")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuote")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpQuote')
		ELSE
			*ThisForm.grdSales.RecordSource = "tmpSales"
		ENDIF
		
		IF NOT USED('tmpQuote')
			MESSAGEBOX( "Could not loading the Quote table.",16,"Program Error")
			RETURN ""
		ENDIF
		**************************************
	ENDPROC

	PROCEDURE load_tmpsales
		*ThisForm.Load_tmpSales()
		
		IF USED('tmpSales')
			USE IN tmpSales
		ENDIF
		
		SELECT 0
		cSQL = "SELECT SOitem, ShipDue, Shipped,cncld,cmplt "
		cSQL = cSQL + ",ItemCost, ItemSale, POCost "
		cSQL = cSQL + ",Urgent, ShipOn, Quoted_QTY, Hold"
		cSQL = cSQL + " FROM dbo.Sales "
		cSQL = cSQL + " WHERE SOitem = '"+ThisForm.cSOitem+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales')
		ELSE
			*ThisForm.grdSales.RecordSource = "tmpSales"
		ENDIF
		
		IF NOT USED('tmpSales')
			MESSAGEBOX( "Could not loading the Sales table.",16,"Program Error")
			RETURN ""
		ENDIF
		
	ENDPROC

	PROCEDURE load_tmpsales_packing
		*ThisForm.Load_tmpSales_Packing()
		
		IF USED('tmpSales_Packing')
			USE IN tmpSales_Packing
		ENDIF
		
		SELECT 0
		cSQL = "SELECT P.PackingSli,P.PCs,P.Descript,P.[Weight] "
		cSQL = cSQL + ",P.Cancld,P.SOitem_Cmplt,PN.ps_date,PN.shippedvia,PN.tracking "
		cSQL = cSQL + ",P.SOitem "
		cSQL = cSQL + " FROM dbo.PackingSlip_No PN "
		cSQL = cSQL + " INNER JOIN dbo.PackingSlip P ON PN.PackingSli = P.PackingSli "
		cSQL = cSQL + " WHERE P.SOitem = '"+cSOitem+"'"
		cSQL = cSQL + " ORDER BY P.[WhenAdd] "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales_Packing")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Packing')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Packing")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Packing")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Packing')
		ELSE	
			ThisForm.grdPacking.RecordSource = 'tmpSales_Packing'
		ENDIF
		
	ENDPROC

	PROCEDURE load_tmpsales_ship
		*ThisForm.Load_tmpSales_Ship()
		
		IF USED('tmpSales_Ship')
			USE IN tmpSales_Ship
		ENDIF
		
		SELECT 0
		cSQL = "SELECT DISTINCT "
		*cSQL = cSQL + "(SELECT TOP 1 S2.ID FROM dbo.Ship S2 WHERE S2.[When] = Ship.[When] AND S2.Soitem = Ship.SOitem ) AS ID "
		cSQL = cSQL + "(SELECT @@ROWCOUNT) AS ID "
		cSQL = cSQL + ", [DueDate],[ShipDate],[ShipVia] "
		cSQL = cSQL + ",[Cncld],[QShipped],[Complete],[RMA_No] "
		cSQL = cSQL + ",SOitem "
		
		cSQL = cSQL + " FROM dbo.Ship "
		cSQL = cSQL + " WHERE SOitem = '"+ThisForm.cSOitem+"'"
		cSQL = cSQL + " ORDER BY [ShipDate] DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales_Ship")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Ship')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Ship")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Ship")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Ship')
		ELSE
			ThisForm.grdShip.RecordSource = "tmpSales_Ship"
		ENDIF
		
	ENDPROC

	PROCEDURE load_tmptables
		*ThisForm.Load_tmpTables()
		
		ThisForm.Load_tmpQuote()
		ThisForm.Load_tmpSales()
		ThisForm.Load_tmpSales_Ship()
		ThisForm.Load_tmpSales_Packing()
		
		
		ThisForm.Refresh_SOitem()
	ENDPROC

	PROCEDURE refresh_packingslip
		*ThisForm.Refresh_PackingSlip
		
		*,P.
		
		IF USED('tmpSales_Packing')
			*ThisForm.grdPacking.RecordSource = "tmpSales_Packing"
			
			ThisForm.txtSOitemP.Value	= ShowSQLtxt(tmpSales_Packing.SOitem,'SOitem',10)
			ThisForm.chkCancldP.Value	= PrepareSQLchk(tmpSales_Packing.Cancld,'Cancld')
			ThisForm.chkSOitem_CmpltP.Value	= PrepareSQLchk(tmpSales_Packing.SOitem_Cmplt,'SOitem_Cmplt')	
			
			ThisForm.txtPS_DateP.Value 	= ShowSQLdate(tmpSales_Packing.ps_date,'ps_date')
			ThisForm.txtTrackingP.Value	= ShowSQLtxt(tmpSales_Packing.tracking,'tracking',50)
			
			ThisForm.txtShipViaP.Value	= ShowSQLtxt(tmpSales_Packing.shippedvia,'shippedvia',20)
			ThisForm.txtPCSP.Value		= PrepareSQLnum(tmpSales_Packing.PCs,'PCs',-3)
			
			ThisForm.txtWeightP.Value	= PrepareSQLnum(tmpSales_Packing.Weight,'Weight',-3)
			ThisForm.txtPackingSliP.Value	= PrepareSQLnum(tmpSales_Packing.PackingSli,'PackingSli',-3)
			
			ThisForm.txtDescriptP.Value	= ShowSQLtxt(tmpSales_Packing.Descript,'Descript',80)
				
		ENDIF
		
	ENDPROC

	PROCEDURE refresh_ship
		*ThisForm.Refresh_Ship()
		IF USED('tmpSales_Ship')
			
			*ThisForm.grdShip.RecordSource = "tmpSales_Ship"
			ThisForm.txtSOitemS.Value	= ShowSQLtxt(tmpSales_Ship.SOitem,'SOitem',10)
			ThisForm.chkCncldS.Value	= PrepareSQLchk(tmpSales_Ship.cncld,'cncld')
			ThisForm.chkCompleteS.Value	= PrepareSQLchk(tmpSales_Ship.Complete,'Complete')	
			
			ThisForm.txtDueDateS.Value 	= ShowSQLdate(tmpSales_Ship.DueDate,'DueDate')
			ThisForm.txtShipDateS.Value = ShowSQLdate(tmpSales_Ship.ShipDate,'ShipDate')
		
			ThisForm.txtShipViaS.Value	= PrepareSQLnum(tmpSales_Ship.ShipVia,'ShipVia',-3)
			ThisForm.txtRMA_NoS.Value	= PrepareSQLnum(tmpSales_Ship.RMA_No ,'RMA_No ',-3)
			ThisForm.txtQShippedS.Value	= PrepareSQLnum(tmpSales_Ship.QShipped,'QShipped',-3)
			ThisForm.txtIDS.Value		= PrepareSQLnum(tmpSales_Ship.ID,'ID',-3)
		
				
		ENDIF
		
		ThisForm.Refresh_PackingSlip()
	ENDPROC

	PROCEDURE refresh_soitem
		*ThisForm.Refresh_SOitem()
		SELECT tmpQuote
		
		ThisForm.txtCompany.Value	= ShowSQLtxt(tmpQuote.Company,'Company',30)
		ThisForm.txtPoNum.Value		= ShowSQLtxt(tmpQuote.PO_num,'PO_num',20)
		ThisForm.txtSalesRep.Value	= ShowSQLtxt(tmpQuote.SalesRep,'SalesRep',30)
		ThisForm.txtPieces.Value	= PrepareSQLnum(tmpQuote.Pieces,'Pieces',-3)
		
		SELECT tmpSales
		
		ThisForm.txtSOitem.Value	= ShowSQLtxt(tmpSales.SOitem,'SOitem',10)
		ThisForm.chkCncld.Value		= PrepareSQLchk(tmpSales.cncld,'cncld')
		ThisForm.chkCmplt.Value		= PrepareSQLchk(tmpSales.cmplt,'cmplt')
		ThisForm.chkShipOn.Value	= PrepareSQLchk(tmpSales.ShipOn,'ShipOn')
		ThisForm.chkHold.Value		= PrepareSQLchk(tmpSales.Hold,'Hold')
		
		ThisForm.txtShipDue.Value 	= ShowSQLdate(tmpSales.ShipDue,'ShipDue')
		ThisForm.txtShipped.Value 	= ShowSQLdate(tmpSales.Shipped,'Shipped')
		
		ThisForm.txtUrgent.Value 	= ShowSQLtxt(tmpSales.Urgent,'Urgent',1)
		
		ThisForm.txtItemCost.Value	= PrepareSQLnum(tmpSales.ItemCost,'ItemCost',-3)
		ThisForm.txtItemSale.Value	= PrepareSQLnum(tmpSales.ItemSale,'ItemSale',-3)
		ThisForm.txtPOCost.Value	= PrepareSQLnum(tmpSales.POCost,'POCost',-3)
		
		IF USED('tmpSales_Ship')
			*SELECT
		ENDIF
		IF USED('tmpSales_Packing')
		
		ENDIF
		
		ThisForm.Refresh_Ship()
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		IF USED('CustomerID')
			USE IN CustomerID
		ENDIF
		
		RETURN THISFORM.cReturnValue
	ENDPROC

	PROCEDURE chkCancel.Valid
		PRIVATE cSOitem, cSQL, nSQLEXEC
		cSOitem = ThisForm.txtSOitem.Value
		PRIVATE lCancelled
		*lCancelled = PrepareSQLchk(tmpSales_Ship.cncld,'Cancel')
		lCancelled = PrepareSQLchk(tmpSales_Ship.cncld,'Cancel')
		PRIVATE nSalesNum
		nSalesNum = tmpSales_Ship.SalesNum
		
		IF NOT lCancelled 
			IF NOT SOitem_PRCD(cSOitem, ThisForm.nConnHandle) 
			*Return True if SOitem has a PRCD
		
		
				*Check for PO
				PRIVATE nCntPOitem 
				nCntPOitem = 0
		
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				SELECT 0
				cSQL = "SELECT COUNT(poItem) AS CNTD FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem +"')"
				cSQL = cSQL + " AND [cancelled] = 0"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF tmpPOp.CNTD > 0
						nCntPOitem = tmpPOp.CNTD
					ENDIF
					USE IN tmpPOp
				ENDIF
		
				IF nCntPOitem > 0
					MESSAGEBOX( "Found "+ALLTRIM(STR(nCntPOitem))+" Purchase Order item"+IIF(nCntPOitem>1,"s","")+" for this Sales Order item."+CHR(13)+;
					  "Check to see if this PO needs to be cancelled also."+;
					  "These cannot be automatically cancelled, you must check yourself!",0,"Item is still on Order!")
					  
					  *PurchaseOrder_POitem_Cancel( cPOitem, ThisForm.nConnhandle )
				ENDIF
					
				**********************
		
				IF MESSAGEBOX("Are you sure you want to Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Cancel?") = 6
					
					IF Cancel_SOitem(cSOitem, .T., ThisForm.nConnHandle) 	&& .T. to Amend Ver
						ThisForm.ReLoadShip()
						LOCATE FOR SOitem = cSoItem
					ENDIF
					
					This.parent.Grid1.Refresh
					
					*Send the SalesRep an Email!
					PRIVATE cSalesRep, nSalesNum, cSendEmail
					nSalesNum = VAL(cSOitem)
					cSalesRep = SalesRepfromSO(nSalesNum)
					cSendEmail = AppSetup_Get_Email( cSalesRep )
					
					
					PRIVATE cSubject
					cSubject = "Sales Order:"+ALLTRIM(STR(nSalesNum))+" was just marked as CANCELLED by the Ship program!"
					cSubject = cSubject + CHR(13) + "Sales Order report:"+ HTML_SO(nSalesNum,.F.)
					cSubject = cSubject + CHR(13) + "Sales Rep: "+cSalesRep 
					cSubject = cSubject + CHR(13) + "Company: "+getFromQuotesSO(nSalesNum,'COMPANY',ThisForm.nConnHandle)
					*cSubject = cSubject + CHR(13) + "Packing slip report:"+HTML_PackingSlip_SO(nSalesNum,.F.)
					cSubject = cSubject + CHR(13) + SYS(0)
					Send_HTML_Email( cSendEmail, get_Server_Email(), 'SO marked as CANCELLED after last Packing Slip.',cSubject,ThisForm.nConnHandle,.T.,.T.)	
						
							
					RETURN .T.
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			*try to UNcancel
			IF MESSAGEBOX("Are you sure you want to UNCancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"UNCancel?") = 6
				PRIVATE lOK
				lOK = .T.
				
				cSQL = "UPDATE dbo.SHIP SET "
				cSQL = cSQL + " [Cncld] = 0"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
					lOK = .F.
				ELSE
					TrackMess( "UNCancelled SOitem="+ALLTRIM(cSOitem)+" in Ship" )
				ENDIF
				
				IF lOK
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL + " [Cncld] = 0"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
						lOK = .F.
					ELSE
						TrackMess( "UNCancelled SOitem="+ALLTRIM(cSOitem)+" in Sales table, Ship Screen, chkCancel.Valid()" )
					ENDIF
				ENDIF
				
				IF lOK
					* IF at least one item is uncancelled, then the SalesNum is UNCancelled 
					cSQL = "UPDATE dbo.Sales_No SET "
					cSQL = cSQL + " [Cncld] = 0"
					cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
						lOK = .F.
					ELSE
						PRIVATE nAmendment
						nAmendment = Get_Amendment_Sales_No( nSalesNum, ThisForm.nConnHandle)
						Track_Sales_No_Chng( "SOitem_Shipped.Cancel UnCancel", nSalesNum, .F., nAmendment )
		
						TrackMess( "UNCancelled SaleNum for "+ALLTRIM(STR(nSalesNum))+" in Sales_No table, Ship Screen, chkCancel.Valid()" )
					ENDIF
				ENDIF
				
				IF lOK
					** Repeat in SOitem_Hrs
					cSQL = "UPDATE dbo.SOitem_Hrs SET "
					cSQL = cSQL + " [Cncld] = 0"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
						lOK = .F.
					ELSE
						TrackMess( "UNCancelled SOitem="+ALLTRIM(cSOitem)+" in SOitem_Hrs table, Ship Screen, chkCancel.Valid()" )
					ENDIF
				ENDIF
				
				This.parent.Grid1.Refresh
				
				ThisForm.ReLoadShip()
				
				LOCATE FOR SOitem = cSoItem
						
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE chkComplete.Valid
		*Change Similar code in Receiving-PO complete
		
		PRIVATE lComplete, cSOitem, cSQL, nSQLEXEC
		*lComplete2 = PrepareSQLchk(This.Value,'Complete')
		lComplete = PrepareSQLchk(tmpSales_Ship.Complete,'Complete')
		lComplete = .F.
		cSOitem = ThisForm.txtSOitem.Value
		
		IF ISNULL(lComplete)
			lComplete = .F.
		ENDIF
		IF NOT lComplete 
			
			IF MESSAGEBOX("Are you sure you want to mark SOitem:"+ALLTRIM(cSOitem)+" as Complete?",4+32,"Mark as Complete?") = 6
		
				cSQL = "UPDATE dbo.SHIP SET "
				cSQL = cSQL + " [Complete] = 1"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ELSE
					TrackMess( "Marked as Complete for SOitem="+ALLTRIM(cSOitem)+" in SO_Shiped " )
					
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL + " [Cmplt] = 1"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
					ELSE
						TrackMess( "Marked as Complete for SOitem="+ALLTRIM(cSOitem)+" in Sales table, SO_Ship screen, chkComplete.Valid() L35" )
						
						** Repeat in SOitem_Hrs
						cSQL = "UPDATE dbo.SOitem_Hrs SET "
						cSQL = cSQL + " [Cmplt] = 1"
						cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
						ENDIF 
						
						
		
						****
						
						
						Save_SOitem_Status( cSOitem, VAL(cSOitem),'Complete  ', 'SOitem was changed to Complete in SO_Shiped.', ThisForm.nConnHandle )
		
						
						****
						cSQL = "INSERT INTO dbo.Sales_No_Chng (Body, SalesNum, ShopRecv, Ver) "
						cSQL = cSQL + " VALUES ("
						cSQL = cSQL + "'Marked as SOitem Complete for SOitem="+ALLTRIM(cSOitem)+" in SO_Shipped screen'"
						cSQL = cSQL + ","+ STR(VAL(cSOitem))
						cSQL = cSQL + ",0"  &&ShopRecv
						cSQL = cSQL + ",0"	&&Ver
						cSQL = cSQL + " );"
						
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
						ENDIF 
						
						*****
										
						ThisForm.Refresh_SOitem()
						
					ENDIF
				ENDIF
				
				*Send the SalesRep an Email!
				PRIVATE cSalesRep, nSalesNum, cSendEmail
				nSalesNum = VAL(cSOitem)
				cSalesRep = SalesRepfromSO(nSalesNum)
				cSendEmail = AppSetup_Get_Email( cSalesRep )
				
				
				PRIVATE cSubject
				cSubject = "Sales Order:"+ALLTRIM(STR(nSalesNum))+" was just marked as COMPLETE by the SO Shipped program!"
				cSubject = cSubject + CHR(13) + "Sales Order report:"+ HTML_SO(nSalesNum,.F.)
				cSubject = cSubject + CHR(13) + "Sales Rep: "+cSalesRep 
				cSubject = cSubject + CHR(13) + "Company: "+getFromQuotesSO(nSalesNum,'COMPANY',ThisForm.nConnHandle)
				cSubject = cSubject + CHR(13) + "Packing slip report:"+HTML_PackingSlip_SO(nSalesNum,.F.)
				cSubject = cSubject + CHR(13) + SYS(0)
				Send_HTML_Email( cSendEmail, get_Server_Email(), 'SO marked as COMPLETE after last Packing Slip.',cSubject,ThisForm.nConnHandle,.T.,.T.)	
				
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		********************************************
		ELSE
		********************************************
			MESSAGEBOX("Please do not use this Ship screen to redo a PackingSlip!"+CHR(13)+"Use Packingslip history screen and cancel the old packing slip number."+CHR(13)+"Packing Slip History has the correct code to update the correct tables."+CHR(13)+"This ship screen assumes other PackingSlips tables are correct,"+CHR(13)+"and only edits this Ship table.",48,'New Message')
			IF MESSAGEBOX("Are you sure you want to UNmark SOitem:"+ALLTRIM(cSOitem)+" as Complete?",4+32,"Mark as NOT Complete?") = 6
		
				cSQL = "UPDATE dbo.SHIP SET "
				cSQL = cSQL + " [Complete] = 0"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ELSE
					TrackMess( "Marked as NOT Complete for SOitem="+ALLTRIM(cSOitem)+" in Ship table, Ship screen" )
					
					** Repeat in SOitem_Hrs
					cSQL = "UPDATE dbo.SOitem_Hrs SET "
					cSQL = cSQL + " [Cmplt] = 1"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
					ENDIF 
					
					
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL + " [Cmplt] = 0"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
					ELSE
						TrackMess( "Marked as NOT Complete for SOitem="+ALLTRIM(cSOitem)+" in Sales table, ship screen, chkComplete.Valid() L74" )
						MESSAGEBOX("Marked as NOT Complete for SOitem="+ALLTRIM(cSOitem)+CHR(13)+"Please check 'Qty', as a new Packing slip will add to current Qty!",0+48,"Not Complete")
						Save_SOitem_Status( cSOitem, VAL(cSOitem),'Complete', 'SOitem was changed to Complete in SO_Shipped.', ThisForm.nConnHandle)
					ENDIF
					
					
					ThisForm.Refresh_SOitem()
		
				ENDIF
				
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE lSOitemCanc
		lSOitemCanc = PrepareSQLchk(ThisForm.chkCancel.Value,'Cancel')
		IF lSOitemCanc
			MESSAGEBOX("This SOitem has already been CANCELLED",48,"Cannot Cancel")
			RETURN .F.
		ENDIF
		
		PRIVATE cSOitem, cSQL, nSQLEXEC
		cSOitem = ThisForm.txtSOitem.Value
		
		
		PRIVATE lOK = .T.
		lOK = .T.
		
		IF MESSAGEBOX("Are you sure you want to mark SOitem:"+ALLTRIM(cSOitem)+" as Cancelled?",4+32,"Mark as Cancelled?") = 6
			*Check to see if Shipped!
			IF NOT SOitem_PRCD(cSOitem, ThisForm.nConnHandle) 
			
				*Check for PO
				PRIVATE nCntPOitem, cPOitem 
				nCntPOitem = 0
				cPOitem = ''
				
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				SELECT 0
				cSQL = " SELECT DISTINCT(POitem)"
				cSQL = cSQL + " FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem +"')"
				cSQL = cSQL + " AND dbo.f_ProperPOitem(POitem) <> dbo.f_ProperPOitem('') "
				cSQL = cSQL + " AND [cancelled] = 0"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF RECCOUNT('tmpPOp') > 0
						nCntPOitem = RECCOUNT('tmpPOp')
						cPOitem = tmpPOp.POitem
					ENDIF
					USE IN tmpPOp
				ENDIF
				
				PRIVATE cSalesRep, nSalesNum, cSendEmail
				nSalesNum = VAL(cSOitem)
				cSalesRep = SalesRepfromSO(nSalesNum)
				cSendEmail = AppSetup_Get_Email( cSalesRep )
				
				PRIVATE cMessage
				cMessage = ''
				IF nCntPOitem > 0
					
					cMessage = "Found "+ALLTRIM(STR(nCntPOitem))+" Purchase Order item"+IIF(nCntPOitem>1,"s","")+" for this Sales Order item."+CHR(13)+;
					  "Check to see if this PO needs to be cancelled also."+;
					  "These cannot be automatically cancelled, you must check yourself!"
					MESSAGEBOX( cMessage,0,"Item is still on Order!")
					
					IF EMPTY(cSalesRep)
						cSalesRep = PrepareSQLtxt(This.Parent.txtSalesRep.Value,'SalesRep',20)
					ENDIF
					lOK = Chatter(cSalesRep ,cMessage+CHR(13)+HTML_SO_Status(cSOitem,.T.),ThisForm.nConnHandle)
					
					  *PurchaseOrder_POitem_Cancel( cPOitem, ThisForm.nConnhandle )
					lOK = PurchaseOrder_POitem_Cancel( cPOitem, ThisForm.nConnhandle, .F.) 
					
					IF NOT lOK
						*Send the SalesRep an Email!
						PRIVATE cSubject
						cSubject = "Found "+ALLTRIM(STR(nCntPOitem))+" Purchase Order item"+IIF(nCntPOitem>1,"s","")+" for this Sales Order item."+CHR(13)+CHR(10)+CHR(13)+" Failed to automaitically cancel to PO. Please do this manually thru the App."
						TrackMess(cSubject) &&only C1024
						
						cSubject = cSubject + CHR(13) + "Sales Order report:"+ HTML_SO(nSalesNum,.F.)
						cSubject = cSubject + CHR(13) + "Sales Rep: "+cSalesRep 
						cSubject = cSubject + CHR(13) + "Company: "+getFromQuotesSO(nSalesNum,'COMPANY',ThisForm.nConnHandle)
						
						*IF NOT EMPTY(cMessage)
						*	cSubject = cSubject + CHR(13) +CHR(13) + cMessage 
						*ENDIF
						cSubject = cSubject + CHR(13) + "Packing slip report:"+HTML_PackingSlip_SO(nSalesNum,.F.)
						cSubject = cSubject + CHR(13) + SYS(0)
						Send_HTML_Email( cSendEmail, get_Server_Email(), 'PO NOT marked as CANCEL after last Packing Slip.',cSubject,ThisForm.nConnHandle,.T.,.T.)	
					ENDIF	
				ENDIF
				
				**********************
				*run the SOitem Cancel
				IF lOK
					lOK = Cancel_SOitem(cSOitem, lAmend, ThisForm.nConnHandle)
					*Report here the subs completed in that procedure!
					
				ENDIF
				
		
				**********************
				*Send the SalesRep an Email!
				PRIVATE cSubject
				cSubject = "Sales Order:"+ALLTRIM(STR(nSalesNum))+" was just marked as CANCEL by the SOitem_Ship program!"
				TrackMess(cSubject) &&only C1024
				
				cSubject = cSubject + CHR(13) + "Sales Order report:"+ HTML_SO(nSalesNum,.F.)
				cSubject = cSubject + CHR(13) + "Sales Rep: "+cSalesRep 
				cSubject = cSubject + CHR(13) + "Company: "+getFromQuotesSO(nSalesNum,'COMPANY',ThisForm.nConnHandle)
				
				IF NOT EMPTY(cMessage)
					cSubject = cSubject + CHR(13) +CHR(13) + cMessage 
				ENDIF
				cSubject = cSubject + CHR(13) + "Packing slip report:"+HTML_PackingSlip_SO(nSalesNum,.F.)
				cSubject = cSubject + CHR(13) + SYS(0)
				Send_HTML_Email( cSendEmail, get_Server_Email(), 'SO marked as CANCEL after last Packing Slip.',cSubject,ThisForm.nConnHandle,.T.,.T.)	
				
			ENDIF
		ENDIF
		ThisForm.Load_tmpTables()
		
	ENDPROC

	PROCEDURE cmdComplete.Click
		*Change Similar code in Receiving-PO complete
		PRIVATE lSOitemCmplt
		lSOitemCmplt = PrepareSQLchk(ThisForm.chkCmplt.Value,'Complete')
		IF lSOitemCmplt
			MESSAGEBOX("This SOitem has already been COMPLETED",48,"Cannot Complete")
			RETURN .F.
		ENDIF
		
		
		PRIVATE lComplete, cSOitem, cSQL, nSQLEXEC
		lComplete = .F.
		cSOitem = ThisForm.txtSOitem.Value
			
		IF MESSAGEBOX("Are you sure you want to mark SOitem:"+ALLTRIM(cSOitem)+" as Complete?",4+32,"Mark as Complete?") = 6
		
			cSQL = "UPDATE dbo.SHIP SET "
			cSQL = cSQL + " [Complete] = 1"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
			ELSE
				TrackMess( "Marked as Complete for SOitem="+ALLTRIM(cSOitem)+" in SOitem_Ship" )
				
				cSQL = "UPDATE dbo.Sales SET "
				cSQL = cSQL + " [Cmplt] = 1"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ELSE
					TrackMess( "Marked as Complete for SOitem="+ALLTRIM(cSOitem)+" in Sales table, ship screen, chkComplete.Valid() L35" )
					
					** Repeat in SOitem_Hrs
					cSQL = "UPDATE dbo.SOitem_Hrs SET "
					cSQL = cSQL + " [Cmplt] = 1"
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
					ENDIF 
					
					Save_SOitem_Status( cSOitem, VAL(cSOitem),'Complete  ', 'SOitem was changed to Complete in SO_Shipped.', ThisForm.nConnHandle )
		
				ENDIF
			ENDIF
			
			*Send the SalesRep an Email!
			PRIVATE cSalesRep, nSalesNum, cSendEmail
			nSalesNum = VAL(cSOitem)
			cSalesRep = SalesRepfromSO(nSalesNum)
			cSendEmail = AppSetup_Get_Email( cSalesRep )
			
			
			PRIVATE cSubject
			cSubject = "Sales Order:"+ALLTRIM(STR(nSalesNum))+" SOitem '"+cSoItem+"' was just marked as COMPLETE by the SOitem_Ship program!"
			cSubject = cSubject + CHR(13) + "Sales Order report:"+ HTML_SO(nSalesNum,.F.)
			cSubject = cSubject + CHR(13) + "Sales Rep: "+cSalesRep 
			cSubject = cSubject + CHR(13) + "Company: "+getFromQuotesSO(nSalesNum,'COMPANY',ThisForm.nConnHandle)
			cSubject = cSubject + CHR(13) + "Packing slip report:"+HTML_PackingSlip_SO(nSalesNum,.F.)
			cSubject = cSubject + CHR(13) + SYS(0)
			
			Send_HTML_Email( cSendEmail, get_Server_Email(), 'SO marked as COMPLETE in SOitem_Ship.',cSubject,ThisForm.nConnHandle,.T.,.T.)	
		
		ENDIF
		
		ThisForm.Load_tmpTables()
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdHold.Click
		*Change Similar code in Receiving-PO complete
		
		PRIVATE cSOitem 
		cSOitem = ThisForm.txtSOitem.Value
		
		DO FORM Forms\SOitem_Status WITH cSOitem,ThisForm.nConnHandle
		
		ThisForm.Load_tmpTables()
	ENDPROC

	PROCEDURE cmdUnComplt.Click
		*Change Similar code in Receiving-PO complete
		
		PRIVATE lSOitemCmplt
		lSOitemCmplt = PrepareSQLchk(ThisForm.chkCmplt.Value,'Complete')
		IF NOT lSOitemCmplt
			MESSAGEBOX("This SOitem is already UN COMPLET",48,"Cannot UnComplete")
			RETURN .F.
		ENDIF
		
		PRIVATE lComplete, cSOitem, cSQL, nSQLEXEC
		*lComplete2 = PrepareSQLchk(This.Value,'Complete')
		lComplete = PrepareSQLchk(tmpSales_Ship.Complete,'Complete')
		lComplete = .F.
		cSOitem = ThisForm.txtSOitem.Value
		
		MESSAGEBOX("Please do not use this Ship screen to redo a PackingSlip!"+CHR(13)+"Use Packingslip history screen and cancel the old packing slip number."+CHR(13)+"Packing Slip History has the correct code to update the correct tables."+CHR(13)+"This ship screen assumes other PackingSlips tables are correct,"+CHR(13)+"and only edits this Ship table.",48,'New Message')
		
		IF MESSAGEBOX("Are you sure you want to mark SOitem:"+ALLTRIM(cSOitem)+" as NOT Complete?",4+32,"Mark as Complete?") = 6
		
		
			cSQL = "UPDATE dbo.SHIP SET "
			cSQL = cSQL + " [Complete] = 0"
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
			ELSE
				TrackMess( "Marked as NOT Complete for SOitem="+ALLTRIM(cSOitem)+" in Ship table, Ship screen" )
				
				** Repeat in SOitem_Hrs
				cSQL = "UPDATE dbo.SOitem_Hrs SET "
				cSQL = cSQL + " [Cmplt] = 1"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
				ENDIF 
				
				
				cSQL = "UPDATE dbo.Sales SET "
				cSQL = cSQL + " [Cmplt] = 0"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
				ELSE
					TrackMess( "Marked as NOT Complete for SOitem="+ALLTRIM(cSOitem)+" in Sales table, ship screen, chkComplete.Valid() L74" )
					MESSAGEBOX("Marked as NOT Complete for SOitem="+ALLTRIM(cSOitem)+CHR(13)+"Please check 'Qty', as a new Packing slip will add to current Qty!",0+48,"Not Complete")
					Save_SOitem_Status( cSOitem, VAL(cSOitem),'INComplete', 'SOitem was changed to INComplete in SO_Shipped.', ThisForm.nConnHandle)
				ENDIF
				
				**************************************
				
				*Send the SalesRep an Email!
				PRIVATE cSalesRep, nSalesNum, cSendEmail, nPackingSli
				nSalesNum = VAL(cSOitem)
				cSalesRep = SalesRepfromSO(nSalesNum)
				cSendEmail = AppSetup_Get_Email( cSalesRep )
				nPackingSli = PrepareSQLnum(ThisForm.txtPackingSliP.Value,'PackingSlip',-3)
				
				PRIVATE cSubject,cMessage
				cSubject = "Sales Order:"+ALLTRIM(STR(nSalesNum))+" was just marked as COMPLETE by the SOitem_Ship program!"
				cMessage = cSubject
				cSubject = cSubject + CHR(13) + "Sales Order report:"+ HTML_SO(nSalesNum,.F.)
				cSubject = cSubject + CHR(13) + "Sales Rep: "+cSalesRep 
				cSubject = cSubject + CHR(13) + "Company: "+getFromQuotesSO(nSalesNum,'COMPANY',ThisForm.nConnHandle)
				cMessage = cMessage + CHR(13) + "Company: "+getFromQuotesSO(nSalesNum,'COMPANY',ThisForm.nConnHandle)
				cSubject = cSubject + CHR(13) + "Packing slip report:"+HTML_PackingSlipNo(nPackingSli,.F.)
				IF nSalesNum > 0
					cSubject = cSubject + CHR(13) + "Packing slip report by SalesNum:"+HTML_PackingSlip_SO(nSalesNum,.F.)
				ENDIF	
				cSubject = cSubject + CHR(13)+PROGRAM()
				cSubject = cSubject + CHR(13)+ CHR(10) + SYS(0)
				Send_HTML_Email( cSendEmail, get_Server_Email(), 'SO marked as NOT COMPLETE after last Packing Slip.',cSubject,ThisForm.nConnHandle,.T.,.T.)	
				
						
				IF EMPTY(cSalesRep)
					cSalesRep = PrepareSQLtxt(This.Parent.txtSalesRep.Value,'SalesRep',20)
				ENDIF
				lOK = Chatter(cSalesRep,cMessage,ThisForm.nConnHandle)
		
			ENDIF
		ENDIF
		
		
		ThisForm.Load_tmpTables()
	ENDPROC

	PROCEDURE grdPacking.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.Refresh_PackingSlip()
		
	ENDPROC

	PROCEDURE grdShip.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.Refresh_Ship()
		
	ENDPROC

	PROCEDURE lblPackingSlipP.Click
		PRIVATE nSalesNum
		nSalesnum = PrepareSQLnum(ThisForm.txtSOitem.Value,'SalesNum',-3)
		IF nSalesnum > 0
			DO FORM Forms\PackingSlipHistory WITH nSalesNum
		ENDIF
	ENDPROC

	PROCEDURE lblRMA_No.Click
		PRIVATE nRMA
		nRMA = PrepareSQLnum(ThisForm.txtRMA_NoS.Value,'RMA',-3)
		IF nRMA > 0
			DO FORM Forms\RMA WITH nRMA
		ENDIF
	ENDPROC

ENDDEFINE
