	PROCEDURE alert_receive_email
		PARAMETERS cWhat,xOrderNumber,nReceivingID
		*ThisForm.Alert_Receive_Email()  
		*uses Alert_Receive() to see if needed.
		
		PRIVATE cMess, lReturnURL, pcEmailTo, pcEmailSubject
		lReturnURL = .T.
		pcEmailSubject = ''
		PRIVATE cUser, cUserEmail
		cUser = RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
		cUserEmail = AppSetup_Get_Email(cUser)
		
		*HTML_SOitem HTML_SO 	HTML_POitem HTML_PO 	HTML_WO HTML_WO_Detail 
		*HTML_ProjID HTML_GFM_Log HTML_PackingSlipNo
		*--HTML_RA
		*--HTML_RA_Detail
		*--HTML_Receiving
		
		PRIVATE nOrderNumber, cOrderNumber
		DO CASE
		CASE VARTYPE(xOrderNumber) = "C"
			cOrderNumber = xOrderNumber
			nOrderNumber = VAL(xOrderNumber)
		CASE VARTYPE(xOrderNumber) = "N"
			cOrderNumber = ALLTRIM(STR(xOrderNumber))
			nOrderNumber = xOrderNumber
		CASE VARTYPE(xOrderNumber) = "Y"
			cOrderNumber = ALLTRIM(STR(xOrderNumber))
			nOrderNumber = xOrderNumber
		OTHERWISE
			cOrderNumber = ''
			nOrderNumber = 0
			TrackError("Bad xOrderNumber VarType","xOrderNumber VarType was not programmed. '"+VARTYPE(xOrderNumber)+"' cWhat='"+cWhat+"'",PROGRAM(),LINENO(1))
		ENDCASE
		
		PRIVATE lCerts, lCofC, lMillCert
		lCerts		= PrepareSQLchk(ThisForm.chkCert.Value,'Cert')
		lCofC		= PrepareSQLchk(ThisForm.chkCofC.Value,'CofC')
		lMillCert	= PrepareSQLchk(ThisForm.chkMillTrace.Value,'MillTrace')
		
		PRIVATE lPass_PW, lGoodPapers, lHold
		lPass_PW		= PrepareSQLlogic(ThisForm.chkPass.Value,'Pass')
		lGoodPapers	= PrepareSQLlogic(ThisForm.chkGoodPapers.Value,'GoodPapers')
		lHold		= PrepareSQLlogic(ThisForm.chkHold.Value,'Hold')
		
		*pcEmailTo = "David.Kirchner@SpaceAlloysUSA.com"
		*pcEmailTo = "David.Kirchner@Windfall.HPA.local"
		pcEmailTo = ""
		
		PRIVATE cSalesP, cUserName, cEmail
		cSalesP	= ''
		cUserName = ''
		cEmail	= ''
		PRIVATE lSendThisEmail 
		lSendThisEmail = .F.
		
		PRIVATE lOK
		lOK = .F.
		
		DO CASE
		CASE cWhat = "POitem"
			PRIVATE lMETAL, lServices, lConvServ, lEquipment 
			lMETAL = Count_POIteminPurchaseOrder( cOrderNumber, ThisForm.nConnHandle, "METAL" ) > 0
			lServices = Count_POIteminPurchaseOrder( cOrderNumber, ThisForm.nConnHandle, "SERVICES" ) > 0
			lConvServ = Count_POIteminPurchaseOrder( cOrderNumber, ThisForm.nConnHandle, "CONVSERV" ) > 0
			lEquipment = Count_POIteminPurchaseOrder( cOrderNumber, ThisForm.nConnHandle, "EQUIPMENT" ) > 0
			*Hey, good news,
			cMess = "Correction of Purchase Order Item '"+cOrderNumber+"' now has yhis item received in"
			IF lMETAL 
				cMess = cMess + " Metal for Stock."
			ENDIF
			
			pcEmailSubject = cMess
			
			cMess = cMess + CHR(13)+CHR(10)
			
			IF lServices 
				cMess = cMess + "Lab Service."
			ENDIF
			IF lConvServ 
				cMess = cMess + "Conversion Service."
			ENDIF
			IF lEquipment 
				cMess = cMess + "Equipment Purchase."
			ENDIF
			
			cMess = cMess + CHR(13)+CHR(10)
			
			********************
			IF NOT lMETAL or lServices or lConvServ or lEquipment 
				cMess = cMess + " Not Stock."
				cMess = cMess + CHR(13)+CHR(10)
			ENDIF
			********************
			IF NOT lPass_PW
				IF lHold
					*Assume they held it becuse it did not pass
					cMess = cMess + " The Paper Work Verified was not checked."+CHR(10)+CHR(13)
					cMess = cMess + " So this Did NOT Pass Specs "+CHR(10)+CHR(13)
					cMess = cMess + " This is being placed on Receive HOLD. "+CHR(10)+CHR(13)
		
				ELSE
					cMess = cMess + "The Paper Work Verified was not checked."+CHR(13)+"So this Did NOT Pass Specs! "+CHR(13)
					cMess = cMess + "also consider putting on Receiving hold."+CHR(13)+CHR(13)
					
				ENDIF
			ELSE
				cMess = cMess + " Marked as Passed Specs."
				cMess = cMess + CHR(13)+CHR(10)
			ENDIF
			
			
			IF lGoodPapers
				cMess = cMess + " Marked as with Good Papers."+CHR(10)+CHR(13)
			ENDIF
			IF lHold
				cMess = cMess + " Marked as Generic OnHold."+CHR(10)+CHR(13)
			ENDIF
			**********
			*MESSAGEBOX(cMess,64,"Sending this message as Email")
				
			cMess = cMess + CHR(10)+CHR(13)+ get_Description("POitem",cOrderNumber,ThisForm.nConnHandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the Purchase Order Record, click here. "
			cMess = cMess + CHR(13) + HTML_POitem(cOrderNumber,lReturnURL)
			
			IF lHold
				cMess = cMess + CHR(13) + " "
				cMess = cMess + CHR(10)+CHR(13) + "To see or change the OnHold, click here. "
				cMess = cMess + CHR(10)+CHR(13) + "https://internal.highperformancealloys.com/onHoldPurchaseOrders"
			ENDIF
			***
			*Check for a SOitem
			PRIVATE cSOitem
			cSOItem = get_SOitem_from_POitem(cOrderNumber, ThisForm.nConnHandle)
			IF NOT Proper_SO_Item(cSOItem) = Proper_SO_Item("")
				* Sales Order Item '"+cOrderNumber+"'
				cMess = cMess + CHR(13) + "Found a SOitem that is tied to this PO item. "
				cMess = cMess + CHR(10)+CHR(13) + get_Description("SOitem",cSOItem,ThisForm.nConnHandle)
				cMess = cMess + CHR(13) + " "
				cMess = cMess + CHR(10)+CHR(13) + "To see the Sales Order, click here. "
				cMess = cMess + CHR(13) + HTML_SOitem(cSOItem,lReturnURL)
			ENDIF
			
			
			***
			cSalesP = getSalesP_POitem(cOrderNumber,ThisForm.nConnHandle)
			cUserName = ALLTRIM( AppSetup_Get_UserName(cSalesP) )
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
			
			lSendThisEmail = Alert_Receive_Check("POitem",cOrderNumber,ThisForm.nConnHandle)
		
		CASE cWhat == "SOitem"
			*SalesPfromSO 
			*cMess = "Hey, good news, the material for the Sales Order Item '"+ALLTRIM(cOrderNumber)+"' has just been received in."
			PRIVATE cSOitem
			cSOItem = get_SOitem_from_POitem(cOrderNumber, ThisForm.nConnHandle)
			IF NOT Proper_SO_Item(cSOItem) = Proper_SO_Item("")
				cMess = "Correction of Purchase Order Item '"+ALLTRIM(cOrderNumber)+" and Sales Order Item '"+ALLTRIM(cSOItem)+"' now has this as items as been received in."
			ELSE
				cMess = "Correction of Purchase Order Item '"+ALLTRIM(cOrderNumber)+"' now has this as items as been received in."
			ENDIF
			**********
			*MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			
			* Sales Order Item '"+cOrderNumber+"'
			cMess = cMess + CHR(10)+CHR(13) + get_Description("SOitem",cOrderNumber,ThisForm.nConnHandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the Sales Order Record, click here. "
			cMess = cMess + CHR(13) + HTML_SOitem(cOrderNumber,lReturnURL)
			
			* Customer Info by Sales Order Item '"+cOrderNumber+"'
			PRIVATE cSO_CustID
			cSO_CustID = CustID_SalesNum(VAL(cOrderNumber),ThisForm.nConnHandle)
			IF LEN(cSO_CustID) > 0
				cMess = cMess + CHR(10)+CHR(13) + "To see the Customer Info, click here. "
				*HTML_CompanyInfo 
				cMess = cMess + CHR(13) + HTML_CustomerInfo_ID(cSO_CustID,lReturnURL)
			ENDIF
			
			***
			*cSalesP = getSalesP_SO(nOrderNumber,ThisForm.nConnHandle)
			cSalesP = getFromQuotesSO(nOrderNumber,'SALESP',ThisForm.nConnHandle)
			cUserName = ALLTRIM( AppSetup_Get_UserName(cSalesP) )
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
		
			lSendThisEmail = Alert_Receive_Check("SOitem",cOrderNumber,ThisForm.nConnHandle)
			
		CASE cWhat = "SOitem_RMA"
		
			cMess = "Hey, the returned material from the Sales Order Item '"+ALLTRIM(cOrderNumber)+"' has just been received in."
			**********
			*MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			
			cMess = cMess + CHR(10)+CHR(13) + get_Description("SOitem",cOrderNumber,ThisForm.nConnHandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the Sales Order Record, click here. "
			cMess = cMess + CHR(13) + HTML_SOitem(cOrderNumber,lReturnURL)
				
			PRIVATE nRMA_No, nRMA_Detail
			nRMA_No		= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
			nRMA_Detail	= PrepareSQLnum(ThisForm.txtRMA_detail.Value,'RMA_Detail',-3)
		
			IF nRMA_No > 0
				cMess = cMess + CHR(13) + "On RMA "+ALLTRIM(STR(nRMA_no))+"."
				cMess = cMess + CHR(10)+CHR(13) + "To see the RMA Record, click here."
				cMess = cMess + CHR(13) + " "
				cMess = cMess + CHR(13) + HTML_RMA_No(nRMA_no,lReturnURL)
			ENDIF
			IF nRMA_Detail > 0
				cMess = cMess + CHR(13) + "On RMA_Detail "+ALLTRIM(STR(nRMA_Detail))+"."
				cMess = cMess + CHR(10)+CHR(13) + "To see the RMA Record, click here."
				cMess = cMess + CHR(13) + " "
				cMess = cMess + CHR(13) + HTML_RMA_Detail(nRMA_Detail,lReturnURL)
			ENDIF
			
			***
			cSalesP = getFromQuotesSO(nOrderNumber,'SALESP',ThisForm.nConnHandle)
			cUserName = ALLTRIM( AppSetup_Get_UserName(cSalesP) )
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
			
			lSendThisEmail = Alert_Receive_Check("SOitem_RMA",ALLTRIM(STR(nRMA_Detail)),ThisForm.nConnHandle)
			
		CASE cWhat == "WO"
			cMess = "PO correction for the material for the WorkOrder '"+ALLTRIM(cOrderNumber)+"' has just been received in."
			**********
			*MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			
			cMess = cMess + CHR(10)+CHR(13) + get_Description("WO",nOrderNumber,ThisForm.nConnHandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the WorkOrder Record, click here."
			cMess = cMess + CHR(13) + HTML_WO(nOrderNumber,lReturnURL)
			
			***
			*cUserName = ALLTRIM( getSalesRep_WO(nOrderNumber,ThisForm.nConnHandle) )
			cUserName = "Charlie Kirchner"
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
			
			lSendThisEmail = Alert_Receive_Check("WO",cOrderNumber,ThisForm.nConnHandle)
			
		CASE cWhat = "WO_Detail"
			cMess = "Correction of PO for the material for the WorkOrder Detail '"+ALLTRIM(cOrderNumber)+"' has just been received in."
			**********
			*MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			
			cMess = cMess + CHR(10)+CHR(13) + get_Description("WO_Detail",nOrderNumber,ThisForm.nConnHandle)
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the WorkOrder Detail, click here."
			cMess = cMess + CHR(13) + HTML_WO(nReceivingID,lReturnURL)
			
			***
			*cUserName = ALLTRIM( getSalesRep_WOD(nOrderNumber,ThisForm.nConnHandle) )
			cUserName = "Charlie Kirchner"
			cEmail = AppSetup_Get_Email(cUserName)
			
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
			
			lSendThisEmail = Alert_Receive_Check("WO_Detail",cOrderNumber,ThisForm.nConnHandle)
			
		ENDCASE
		
		***************************************************************************
		
		IF nReceivingID > 0
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13)+"To see the Receiving Record, click here."
			cMess = cMess + CHR(13) + HTML_ReceivingID(nReceivingID,lReturnURL)+ CHR(13)
		ENDIF
		
		cMess = cMess + CHR(10)+CHR(13) + "Receive_Edit.Alert_Receive_Email: " + pcEmailTo 
		cMess = cMess + CHR(13) + "Worker: " + SYS(0)
		cMess = cMess + CHR(13) + Get_HPAVersion(.F.,"STABLE")
		* cMess = cMess + CHR(13) + Get_HPAVersion(.F.)
		
		PRIVATE cSQLServer 
		IF VARTYPE(gGlobalServer)="C"
			cSQLServer = gGlobalServer 
		ELSE
			RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),'gGlobalServer was not set!')
		 	cSQLServer = "Raptor"
		ENDIF
		
		PRIVATE pcEmailFrom,  lQuiet, lNoHeadder
		*pcEmailFrom	= ""+cSQLServer+"@SpaceAlloysUSA.com"  &&--do not use SpaceAlloysUSA.com, server does not need a Google Account
		pcEmailFrom = get_Server_Email()	&&cSQL_Server_Email
		lQuiet 		= .F.
		lNoHeadder	= .F.
		
		IF NOT EMPTY(cUserEmail)
			pcEmailTo = pcEmailTo + "; " +cUserEmail
		ENDIF
		
		lSendThisEmail = PrepareSQLlogic(lSendThisEmail,'SendThisEmail',.F.)
		IF lSendThisEmail AND LEN(cMess) > 1
		
			lOK = Send_HTML_Email(pcEmailTo, pcEmailFrom, pcEmailSubject, cMess, ThisForm.nConnHandle, lQuiet, lNoHeadder)
			
		ELSE
			*IF lSendThisEmail AND LEN(cMess) > 1
			*	lOK = Send_HTML_Email(pcEmailTo, pcEmailFrom, pcEmailSubject, cMess, ThisForm.nConnHandle, lQuiet, lNoHeadder)
			*ENDIF
		ENDIF
		
		IF lOK
			*lSentEmailMarked = Alert_Receive_Mark("WO_Detail",cOrderNumber,ThisForm.nConnHandle)
			Alert_Receive_Mark( cWhat, xOrderNumber, nReceivingID )
			IF LEN(cMess) > 1
				TrackMess(cMess)
			ENDIF
		ENDIF
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE checkrma
		*ThisForm.CheckRMA() 
		
		PRIVATE nRMA_Detail, nRMA, cHeat, cLot
		nRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		nRMA 	= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		
		PRIVATE lOK 
		lOK = .T.
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOitem.Value,'SOitem',2,0)
		cSOitem		= Proper_SO_item('')
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			ENDIF
		ENDIF
		
		IF nRMA = 0
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				*No SOitem to compare with
				RETURN .T.
			ELSE
				
			ENDIF
		ENDIF
				
		PRIVATE cSQL, nSQLExec
		IF USED("tmpRMA")
			USE IN tmpRMA
		ENDIF
		
		PRIVATE cMess
		
		cSQL = "SELECT RD.SO_item "
		cSQL = cSQL + ",RMA.RMA_No, RD.RMA_Detail_ID"
		cSQL = cSQL + " FROM dbo.RMA WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.RMA_Detail RD WITH(NOLOCK) ON RMA.RMA_No = RD.RMA_NO "
		cSQL = cSQL + " WHERE RMA.RMA_No = "+STR(nRMA)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMA')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA' )
		ENDIF
		
		
		PRIVATE cMess,nMess,nOldRMA_Detail
		nOldRMA_Detail = 0
		
		IF USED('tmpRMA')
			IF RECCOUNT('tmpRMA') > 0
				*IF Proper_SO_item(tmpRMA.SO_item) <> Proper_SO_item('')
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
					*have a SOitem to check Also
					SELECT tmpRMA
					LOCATE FOR SO_item = SO_item
					IF FOUND('tmpRMA')
						nOldRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
						ThisForm.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail',-3)
						IF nOldRMA_Detail = 0
							nMess = MESSAGEBOX("Do you want to try to import data?"+CHR(13)+"This will overwrite current data.",4+32,"Over Write?")
							IF nMess = 6
								ThisForm.Refresh_RMA_Detail()
							ENDIF
						ENDIF
					ELSE
					
						MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem ="+Proper_SO_item(tmpRMA.SO_item),16,"Does not Match")
						GO TOP			
					ENDIF
				ELSE
					IF RECCOUNT('tmpRMA') = 1
						ThisForm.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA.RMA_Detail_ID,'RMA_Detail',-3)
						ThisForm.Refresh_RMA_Detail()
					ENDIF		
				ENDIF
			ELSE
				lOK = .F.
				MESSAGEBOX("This RMA is not Found!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem =",16,"Does not Exists")	
			ENDIF
			
			SELECT tmpRMA
		
		ELSE
			MESSAGEBOX("This RMA is not Found!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem =",16,"Does not Exists")	
			lOK = .F.
		ENDIF
		RETURN lOK
	ENDPROC

	PROCEDURE checksave
		*ThisForm.CheckSave() 
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		
		
		IF EMPTY(ThisForm.edtDescription.Value)
			lReady2Save = .F.
			MESSAGEBOX( "No Valid Description", 0+32,"Cannot Save")
		ENDIF
		
		PRIVATE dReceived, dDate
		dReceived	= PrepareSQLdate(ThisForm.txtReceived.Value,'Received')
		dDate		= PrepareSQLdate(ThisForm.txtDate.Value,'Date')
		
		IF dReceived + 1000 < DATE() OR dReceived - 1000 > DATE()
			*Not within 1000 Days, Reset.
			dReceived = CTOD("  /  /  ")
		ENDIF
		
		
		IF dReceived = CTOD("  /  /  ")
			IF MESSAGEBOX( "Do you want to set today as Received date?", 4+32,"Date") = 6
				ThisForm.txtReceived.Value = DATE()
				dReceived	= PrepareSQLdate(ThisForm.txtReceived.Value,'Received')
			ELSE
				lReady2Save = .F.
				RETURN lReady2Save 
			ENDIF
		ENDIF
		
		
		*************
		PRIVATE nReceivingID
		*nReceivingID = Receive_Edit.txtReceivingID.Value
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		ThisForm.nReceivingID = nReceivingID
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		PRIVATE cSOitem, nSalesNum, nItemSo, nWO, nWO_Detail, lHaveWOD
		PRIVATE nRMA,cAlloy,cHeat,cLot,cDescription
		
		nHpaPo		= PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		* NOTE cPOitem is not used on customers material like a SO is a Toll Service Order
		
		**********************
		ThisForm.cPOitem = cPOitem
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			lReady2Save = ThisForm.CheckSave_POitem()
		ENDIF
		
		**********************
		lHaveWOD = .F.
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWO_Detail  > 0
			lReady2Save = ThisForm.CheckSave_WOD()
			IF lReady2Save 
				lHaveWOD = .T.
			ENDIF
		ENDIF
		
		IF nHpaPo > 0 AND nWO_Detail = 0 AND lReady2Save 
			*Ignore if have WO_Detail
			IF NOT lHaveWOD 
				IF is_Vendor_LabService(nHpaPo, ThisForm.nConnhandle)
				*	IF MESSAGEBOX("This PO "+ALLTRIM(STR(nHPApo))+" is for a Material Test Report."+CHR(13)+CHR(13)+"This is not the Vendor!"+CHR(13)+"Are you receiving to the right PO?"+CHR(13)+CHR(13)+"Do you still want to continue?",4+256+16,"Wrong PO") <> 6
				*		lReady2Save = .F.
				*	ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************
		PRIVATE nAcct_P, nAcct_PU, nMax_P, nAcct_QTY
		nAcct_P = PrepareSQLnum(ThisForm.txtAcct_P.Value,'S_P',-5)
		nAcct_PU= PrepareSQLnum(ThisForm.lblAcct_PU.Caption,'PU',-1)
		nMax_P = 0
		*Check PU Limit
		nMax_P = get_Max_P_fromPU (nAcct_PU, ThisForm.nConnhandle)
		nAcct_QTY = PrepareSQLnum(ThisForm.txtAcct_Qty.Value,'Acct_QTY',-5)
		
		PRIVATE cMess
		cMess=''
		
		IF nAcct_P >= nMax_P 
			ThisForm.txtAcct_P.DisabledBackColor = RGB(255,0,0)
			
			cMess = "This Receive has an ERP Acct Standard Price of "+STR(nAcct_P)+CHR(13)+"The set logical limit is "+STR(nMax_P)+" for this type."
			
			MESSAGEBOX(cMess+CHR(13)+"This will send message to David",4+256+16,"Bad Pricing") 
			*lReady2Save = .F.
			cMess = cMess +CHR(13)+"ReceivingID = "+STR(nReceivingID)
			
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				cMess = cMess +CHR(13)+"POitem = "+cPOitem
			ENDIF
			IF nWO_Detail  > 0
				cMess = cMess +CHR(13)+"WO_Detail = "+STR(nWO_Detail)
			ENDIF
			cMess = cMess+CHR(13)+"Acct_PU = "+STR(nAcct_PU)
			cMess = cMess+CHR(13)+"Acct_QTY = "+STR(nAcct_QTY)
			
			TrackError(cMess+CHR(13)+"User has no way to fix here!","S_P is over Max_P", PROGRAM(), LINENO(1))
			
			
		ENDIF
		
		**********************
		PRIVATE lServicesPO, lConvServ, lEquipment
		lServicesPO		= PrepareSQLlogic(ThisForm.chkLab_Service.VALUE,'ServicesPO',.F.)
		lConvServ		= PrepareSQLlogic(ThisForm.chkConvServ.VALUE,'ConvServ',.f.)
		lEquipment		= PrepareSQLlogic(ThisForm.chkEquipment.VALUE,'Equipment',.F.)
		
		******************
		PRIVATE lPaperWork,lGoodPapers,lHold
		lPaperWork		= PrepareSQLlogic(ThisForm.chkPass.Value,'Pass')
		lGoodPapers	= PrepareSQLlogic(ThisForm.chkGoodPapers.Value,'GoodPapers')
		lMillTrace	= PrepareSQLlogic(ThisForm.chkMillTrace.Value,'MillTrace')
		lHold		= PrepareSQLlogic(ThisForm.chkHold.Value,'Hold')
		
		PRIVATE cTBL, nID_Detail, nID_Detail_ProO, lDetail_History
		cTBL 			= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		nID_Detail		= PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
		nID_Detail_ProO = PrepareSQLnum(Thisform.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		lDetail_History = .F.
		IF ThisForm.lblWhat.Caption <> 'ADD'
			*Is there History for this Detail?
			IF nID_Detail > 0 AND ( cTBL='S' OR cTBL='B' OR cTBL='W' )
				lDetail_History = Has_ID_Detail_History( nID_Detail, cTBL, ThisForm.nConnhandle)
			ENDIF
		ENDIF
		
		IF NOT lPaperWork AND NOT lDetail_History AND NOT lHaveWOD 
			IF lHold
				*Assume they held it because it did not pass
			ELSE
				IF NOT (lServicesPO OR lConvServ OR lEquipment )
				
					cMess = "You left the Paper Work Verified as not checked."+CHR(13)+"SO it Did NOT Pass Specs? "
					cMess = cMess+CHR(13)+CHR(13)+"Answer (Y) to contine"+CHR(13)+"Answer (N) to go back and Fix"+CHR(13)+"to being: Receive Item is as Ordered"
					cMess = cMess+CHR(13)+CHR(13)+"also consider putting on Receiving hold."
					
					IF MESSAGEBOX(cMess,4+256+16,"Could not verify as Item Ordered?") = 7
						lReady2Save = .F.
					ENDIF
				ELSE
					*Do not mess with an edited stock
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT (lServicesPO OR lConvServ OR lEquipment)
			IF NOT lMillTrace AND NOT lDetail_History AND NOT lHaveWOD 
				
				IF lHold
					*Assume they held it because it did not pass
				ELSE
					cMess = "Stock without traceability"+CHR(13)+CHR(13)+"The Mill Trace was NOT checked."+CHR(13)+"This will put a Receiving Hold on this Stock!"			
					MESSAGEBOX(cMess,0,"Stock without traceability")
					
					ThisForm.chkHold.Value = PrepareSQLlogic(.T.,'Hold')
					lReady2Save = .F.
				ENDIF
			ELSE
				*Do not mess with an edited stock	
			ENDIF
		ENDIF
			
				
		**********************
		RETURN lReady2Save
	ENDPROC

	PROCEDURE checksave_poitem
		*ThisForm.CheckSave_POitem()
		
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		
		PRIVATE  nReceivingID
		*nReceivingID = Receive_Edit.txtReceivingID.Value
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		ThisForm.nReceivingID = nReceivingID
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		PRIVATE cSOitem, nSalesNum, nItemSo, nWO, nWO_Detail
		PRIVATE nRMA,cAlloy,cHeat,cDescription
		
		nHpaPo		= PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		
		
		nSalesNum	= PrepareSQLnum(ThisForm.txtSONum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		ThisForm.cSOitem = cSOitem
		
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50,.f.)
		cDescription= PrepareSQLtxt(ThisForm.edtDescription.Value,'Description',-1,.F.)
		
		nRMA = PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA',-3)
		
		*************************
		*Check Heat
		IF UPPER(cHeat) = "DUE IN"
			cHeat = ""	&&Do not check for Due In
		ENDIF
		IF LEN(cHeat)=0
			IF MESSAGEBOX("No Heat was Entered."+CHR(13)+CHR(13)+"If this is OK answer (Y)."+CHR(13)+CHR(13)+"If you want to go back"+CHR(13)+"and enter the Heat, answer(N)",16+4,"Continue...") != 6
				lReady2Save = .F.
			ENDIF
		ENDIF
		
		*************************
		*Check TBL
		
		PRIVATE nID_Master, nID_Detail, cTBL, cForm
		nID_Master	= PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
		cTBL 		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		cForm 		= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		
		PRIVATE cTBL_POi, cTBL_POi_P
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			cTBL_POi	= getTBL_POitem(cPOitem, ThisForm.nConnhandle ) 
			cTBL_POi_P	= getTBL_Process_POitem(cPOitem, ThisForm.nConnhandle ) 
		ELSE
			cTBL_POi	= ''
			cTBL_POi_P	= ''
		ENDIF
		
		PRIVATE cTBL_WO, cTBL_WOD
		IF nWO > 0
			cTBL_WO		= getTBL_WO(nWO, ThisForm.nConnhandle )
		ELSE
			cTBL_WO		= ''
		ENDIF
		IF nWO_Detail > 0
			*cTBL_WOD	= getTBL_WOD_WO(nWO, ThisForm.nConnhandle )
			cTBL_WOD	= getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle )
		ELSE
			cTBL_WOD	= ''
		ENDIF
		
		IF nID_Master + nID_Detail > 0
			IF ThisForm.cTBL != cTBL 
				IF LEN(ALLTRIM(cTBL)) = 0
					IF LEN(ALLTRIM(ThisForm.cTBL)) > 0
						cTBL = ThisForm.cTBL
					ENDIF
				ENDIF
			ENDIF
			
			IF LEN(ALLTRIM(cTBL)) = 0
				*Should have TBL
				DO CASE
				CASE ThisForm.cWhat = "S_Process" 
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "B_Process"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "W_Process"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "Stk_Detail" 
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "Brk_Detail"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "WO_Detail"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "WO"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				OTHERWISE
					*Carefull, POitem has been incorrectly passed before.
					IF Proper_PO_item(cPOitem) != Proper_PO_item('')
						
						IF USED('get_TBL_POitem')
							USE IN get_TBL_POitem
						ENDIF
						
						SELECT 0
						cSQL =       " SELECT 'S' AS TBL, ID FROM dbo.StockLst_Master WITH(NOLOCK) "
						cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
						cSQL = cSQL +" UNION "
						cSQL = cSQL +" SELECT 'B' AS TBL, ID FROM dbo.BrokerLst_Master WITH(NOLOCK) "
						cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
						cSQL = cSQL +" UNION "
						cSQL = cSQL +" SELECT 'W' AS TBL, ID FROM dbo.WIPLst_Master WITH(NOLOCK) "
						cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'get_TBL_POitem' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'get_TBL_POitem' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "get_TBL_POitem")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "get_TBL_POitem")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'get_TBL_POitem')
						ENDIF
						
						IF USED('get_TBL_POitem')
							IF RECCOUNT('get_TBL_POitem') = 1
								IF nID_Master = PrepareSQLnum(get_TBL_POitem.ID,'ID',-3)
									*good
									cTBL = get_TBL_POitem.TBL
								ELSE
									*bad
								ENDIF
							ENDIF
							IF RECCOUNT('get_TBL_POitem') > 1
								LOCATE FOR ID = nID_Master 
								IF FOUND()
									*good
									cTBL = get_TBL_POitem.TBL
								ELSE
									*bad
								ENDIF
							ENDIF
							
							IF NOT EMPTY(cTBL)
								ThisForm.txtTBL.Value = cTBL
							ENDIF
							
							USE IN get_TBL_POitem
						ELSE
							*do not have TBL ###
						ENDIF
					
					ENDIF
				ENDCASE
			ENDIF
		ENDIF
		
		*!*	*************************
		*!*	*No ReceivingID	
		*!*	IF TYPE("nReceivingID") != "N"
		*!*		PRIVATE cMess
		*!*		
		*!*		cMess = "nReceivingID is 0"+CHR(13)
		*!*		cMess = cMess + "SOitem "+ALLTRIM(ShowSQLtxt(cSOitem,'SOitem',12))+CHR(13)
		*!*		cMess = cMess + "POitem "+ALLTRIM(ShowSQLtxt(cPOitem,'POitem',12))+CHR(13)
		*!*		cMess = cMess + "RMA "+ALLTRIM(STR(nRMA))+CHR(13)
		*!*		cMess = cMess + "Alloy "+ALLTRIM(ShowSQLtxt(cAlloy,'Alloy',12))+CHR(13)
		*!*		cMess = cMess + "Heat "+ALLTRIM(ShowSQLtxt(cHeat,'Heat',50))+CHR(13)
		*!*		cMess = cMess + "Desc "+ALLTRIM(LEFT(ShowSQLtxt(cDescription,'Desc',20),20))
		*!*		IF nID_Master > 0
		*!*			cMess = cMess +CHR(13)+ "ID_Master "+ALLTRIM(STR(nID_Master))
		*!*		ENDIF
		*!*		IF nID_Detail > 0
		*!*			cMess = cMess +CHR(13)+ "ID_Detail "+ALLTRIM(STR(nID_Detail))
		*!*		ENDIF
		*!*		
		*!*		TrackMess("bad parameter"+CHR(13)+ShowSQLtxt(cMess,'cMess',-1)+CHR(13)+"Shop_StockLst_Edit:frmReceiving:cmdAdd-CheckSave")
		*!*		nReceivingID = 0
		*!*		ThisForm.txtReceivingID.Value = 0
		*!*		*lReady2Save = .F.
		*!*	ENDIF
		
		*!*	*************
		*!*	IF EMPTY(nReceivingID)
		*!*		nReceivingID = 0
		*!*	ENDIF
		
		*****
		IF nRMA > 0 	
			IF NOT RMA_Exists(nRMA,ThisForm.nConnhandle)
				MESSAGEBOX("Not an Active RMA!",48,"Bad RMA Number")
				lReady2Save = .F.
			ELSE
				ThisForm.StockLst_TBL = "S"
			ENDIF
			
			***
			IF nReceivingID > 0 
				nMess = 0
				nMess = MESSAGEBOX("RMA and Receiving ID are good."+CHR(13)+"Last chance to create a NEW receive."+CHR(13)+CHR(13)+"If you are editing an old record:"+CHR(13)+"Answer (Y) to update the ReceivingID"+CHR(13)+"Answer (N) to set create new ReceivingID.",4+32,"Save Edited Record?")	
				IF nMess = 7
					nReceivingID = 0
					ThisForm.txtReceivingID.Value = nReceivingID 
				ENDIF
			ENDIF
			
			***
			IF Proper_SO_item(cSOitem) = Proper_SO_item('')
				MESSAGEBOX("Need Sales Order for an RMA!"+CHR(13)+"Add the Sales Order for the RMA!",48,"Bad SO Item Number")
				lReady2Save = .F.
			ENDIF
			***
			IF Proper_PO_item(cPOitem) != Proper_PO_item('')
				MESSAGEBOX("RMA cannot have a PO on RMA!"+CHR(13)+"RMA needs the SO."+CHR(13)+"Remove the PO or remove the RMA.",48,"Bad RMA Number")
				lReady2Save = .F.
			ENDIF
			IF lReady2Save 
				PRIVATE nHpaPo
				nHpaPo	= PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
				IF nHpaPo > 0
					MESSAGEBOX("This receive is marked as for a RMA."+CHR(13)+"PO number is being dropped!",0+48,"RMA do not record their PO info.")
					ThisForm.txtHpaPONum.Value = 0
					ThisForm.txtHPAPOItem.Value = 0
					ThisForm.cPOitem = Proper_PO_item('')
				ENDIF
			ENDIF
			***
		
		ENDIF
		*****
		
		IF lReady2Save 
			IF nSalesNum > 0
				IF nItemSo <= 0
					*Problem
					MESSAGEBOX("Sales Order is "+ALLTRIM(STR(nSalesNum))+"."+CHR(13)+"Cannot save with item of "+ALLTRIM(STR(nItemSo))+"!",48,"Bad Item Number")
					lReady2Save = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*************
		PRIVATE lFoundSOitem
		lFoundSOitem = .F.
		
		*************
		*Check to see if this receive does not need a po.
		*The SalesOrder is quotes.services, Conversion Service Only- customers material.
		PRIVATE lFoundConvServ 
		lFoundConvServ = .F.
		IF lReady2Save
			IF cSOitem 	!= Proper_SO_Item("")
				*have SOitem
				
				IF USED('tmpCountSO_ServiceOnly')
					USE IN tmpCountSO_ServiceOnly
				ENDIF
				
				SELECT 0
				cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.AllQuotes WITH(NOLOCK) "
				cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL +" AND ISNULL(Services,0) = 1"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountSO_ServiceOnly' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountSO_ServiceOnly' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountSO_ServiceOnly")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountSO_ServiceOnly")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountSO_ServiceOnly')
				ENDIF
				
				IF USED('tmpCountSO_ServiceOnly')
					IF RECCOUNT('tmpCountSO_ServiceOnly')>0
						lFoundSOitem = .T.
						IF tmpCountSO_ServiceOnly.Cntd>0
							lFoundConvServ = .T.
						ENDIF
					ENDIF
					USE IN tmpCountSO_ServiceOnly
				ENDIF
				
			ENDIF
		ENDIF
		
		*************
		PRIVATE lFoundWO_Detail
		lFoundWO_Detail = .F.
		
		*Check to see if this receive uses a WO_Detail
		IF nWO_Detail>0
			*have WO_Detail
			
			IF USED('tmpCountWO_Detail')
				USE IN tmpCountWO_Detail
			ENDIF
			
			SELECT 0
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL +" WHERE WO_Detail="+STR(nWO_Detail)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountWO_Detail' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpCountWO_Detail' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountWO_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountWO_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountWO_Detail')
			ENDIF
			
			IF USED('tmpCountWO_Detail')
				IF RECCOUNT('tmpCountWO_Detail')>0
					lFoundSOitem = .T.
					IF tmpCountWO_Detail.Cntd>0
						lFoundWO_Detail = .T.
					ENDIF
				ENDIF
				USE IN tmpCountWO_Detail
			ENDIF
			
		ENDIF
		
		
		*************
		*Check from RMA
		*ThisForm.nRMA = 0  &&Reset, Should only have been set as INIT Parameter
		
		PRIVATE nRMA_No, nRMAcnt
		nRMA_No		= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		nRMAcnt	= 0
		
		IF NOT EMPTY(nRMA_No)
			*Verify RMA
			IF USED('tmpRMAcnt')
				USE IN tmpRMAcnt
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.RMA WITH(NOLOCK) "
			cSQL = cSQL + " WHERE RMA_No = "+STR(nRMA_No)
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMAcnt' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,  cSQL, 'tmpRMAcnt' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMAcnt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMAcnt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMAcnt')
			ENDIF
			
			IF USED('tmpRMAcnt')
				IF VARTYPE(tmpRMAcnt.CNTD) = "N"
					nRMAcnt = IIF(tmpRMAcnt.CNTD>0,1,0)
					IF nRMAcnt = 0
						MESSAGEBOX("Did not Find RMA:"+STR(nRMA_No)+CHR(13)+"Cannot receive against a bad RMA number."+CHR(13)+"Correct the RMA!",0+48,"Not accepted as RMA")
						TrackError("Did not Find RMA:"+STR(nRMA_No),"Did not Find RMA:"+STR(nRMA_No),PROGRAM(),LINENO(1) )
					ENDIF
				ENDIF
				USE IN tmpRMAcnt
			ENDIF
		ENDIF
		
		IF nRMAcnt > 0
			ThisForm.nRMA = nRMA_No
		ENDIF
		
		***************
		* Check POitem
		* NOTE cPOitem is not used on customers material like a SO is a Toll Service Order
		PRIVATE nCountPOitem
		nCountPOitem = 0
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item("")
			nCountPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, '' ) 
		ENDIF
		
		IF nCountPOitem = 0
			*Check SOitem
			IF Count_SOIteminSales( cSOItem, ThisForm.nConnHandle, 'CONVERSIONSERVICE' ) > 0
				*Good
			ELSE
				*Bad
				PRIVATE cPOitem_OLD, nMess
				cPOitem_OLD = cPOitem
				nMess = 0
					
				*TrackError("Did not find POItem ["+cPOItem+"]","Did not Find POitem", PROGRAM(), LINENO(1))
				
				IF Count_POIteminPurchaseOrder( Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-01"), ThisForm.nConnHandle, '' ) > 0
					cPOItem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-01")
					
					nMess = MESSAGEBOX("PO item:"+cPOitem_OLD+" was NOT found but"+CHR(13)+"PO item:"+cPOitem+" was found!"+CHR(13)+CHR(13)+"Do you want to use the POitem:"+cPOitem+"? (Y)"+CHR(13)+CHR(13)+"Otherwise answer No to go back "+CHR(13)+"and fill the correct POitem in. (N)",4+32,"Unsure about the POitem")
					IF nMess = 7
						ThisForm.cPOItem = cPOitem
						ThisForm.txtHpaPOItem.Value = 1
						
						TrackError("PO item:"+cPOitem_OLD+" was NOT found but"+CHR(13)+"PO item:"+cPOitem+" was found!"+CHR(10)+"User choose to use POitem:"+cPOitem,"Did not Find POitem", PROGRAM(), LINENO(1))
						WAIT WINDOW "Now edit the POitem"
						RETURN
					ELSE
						lReady2Save = .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		***************
		
		*************
		PRIVATE cVendor
		cVendor	= PrepareSQLtxt(ThisForm.txtVendor.Value,'Vendor',30,.F.,.T. )
		IF LEN(cVendor) = 0
			*Problem
			MESSAGEBOX("ERP PO "+ALLTRIM(STR(nHpaPo))+" needs a Vendor."+CHR(13)+"Cannot save with out Vendor"+CHR(13)+"(The Company you bought from)",48,"Vendor is Empty!")
			lReady2Save = .F.
		ENDIF
		
		*************
		*Check RMA stuff
		IF lReady2Save
			IF nRMAcnt > 0
				*Get the SO data to check Alloy,etc
				IF nSalesNum=0 OR nItemSo=0
					MESSAGEBOX("Cannot save as an RMA with no SO "+ALLTRIM(STR(nSalesNum))+CHR(13)+" or Item "+ALLTRIM(STR(nItemPo))+"!",48,"Bad SO Item Number")
					lReady2Save = .F.
				ENDIF
				
				IF lReady2Save 
					IF USED('tmpQuote_Sales')
						USE IN tmpQuote_Sales
					ENDIF
					
					cSQL = "SELECT "
					*cSQL = cSQL + " S.StockLst_Qty,S.StockLst_PC,S.StockLst_LBS,"
					cSQL = cSQL + " S.Alloy,S.Form,S.Heat,S.CC,S.StockEdit,S.Reconciled  "
					cSQL = cSQL + " ,S.Removed_QTY"&&	ERP Acct Standard
					cSQL = cSQL + " ,S.Invoice_QTY"	&&	Customer
					cSQL = cSQL + " ,S.Invoice_P"	&&Customer
					cSQL = cSQL + " ,S.PS_QTY"		&&Customer
					cSQL = cSQL + " ,S.Left_QTY"	&&	ERP Acct Standard
		
					cSQL = cSQL + " ,AllQuotes.Company "
					cSQL = cSQL + " ,AllQuotes.Form "
					cSQL = cSQL + " FROM dbo.Sales_Stock S WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.AllQuotes WITH(NOLOCK) ON AllQuotes.SOitem = S.SOitem "
					cSQL = cSQL + " WHERE S.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
				
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuote_Sales' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,  cSQL, 'tmpQuote_Sales' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuote_Sales")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuote_Sales")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpQuote_Sales')
					ENDIF
					
					IF USED('tmpQuote_Sales')
						IF RECCOUNT('tmpQuote_Sales') >  0
							*Check Alloy, Pc, Weight
							IF ALLTRIM(cAlloy) != ALLTRIM(tmpQuote_Sales.Alloy)
								MESSAGEBOX("Receive Alloy "+ALLTRIM(cAlloy)+" does not match SO Alloy "+ALLTRIM(tmpQuote_Sales.Alloy)+"!",48,"Bad SO Item Number")
								lReady2Save = .F.
							ENDIF
						ELSE
							MESSAGEBOX("Cannot save as an RMA with bad SO Item "+ALLTRIM(cSOitem)+"!",48,"Bad SO Item Number")
							lReady2Save = .F.
						ENDIF
						USE IN tmpQuote_Sales
					ENDIF
		
				ENDIF
			ENDIF
		ENDIF
		
		*************
		*Check POitem2
		IF lReady2Save 
			IF nRMAcnt = 0   
				*Do not need to check for PO on RMA
				IF NOT lFoundSOitem  &&Do not to check on PO because it hase a good SOitem
					IF NOT lFoundWO_Detail  &&Do not to check on PO because it hase a good WO_Detail
						IF NOT lFoundConvServ &&Do not check for PO if lFoundConvServ 
							PRIVATE nCntPOitem 
							nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle )
							IF nCntPOitem < 1
		
								MESSAGEBOX("Did not find POitem: "+ALLTRIM(cPOitem)+CHR(13)+"You cannot save this receive with that POitem!"+CHR(13)+CHR(13)+"Only a Sales Order as a conversion service is allowed."+CHR(13)+"Have Salesman mark as a service.",16,"No Save")
								lReady2Save = .F.
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****
		*Does ThisForm.cSOitem belong to ThisForm.cPOitem
		IF Proper_PO_Item(ThisForm.cPOitem) <> Proper_PO_Item('')
			IF Proper_SO_Item(ThisForm.cSOitem) <> Proper_SO_Item('')
				PRIVATE cMess
				
				*Find SOitem in PurchaseOrder
				PRIVATE nCntSOitem 
				nCntSOitem = Count_SOitem_PurchaseOrder(ThisForm.cSOItem, ThisForm.nConnHandle) 
				IF nCntSOitem = 0
					cMess = "While Receiving for POitem='"+Proper_PO_Item(cPOitem)+"'"
					IF ThisForm.nReceivingid > 0
						cMess = cMess +CHR(13)+" ReceivingID="+ALLTRIM(STR(ThisForm.nReceivingid))
					ENDIF	
					cMess = cMess +CHR(13)+" SOitem='"+Proper_SO_Item(ThisForm.cSOItem)+"' did not belong to this POitem."
					cMess = cMess +CHR(13)+"Count_SOitem_PurchaseOrder()"
					TrackMess(cMess)
				ENDIF
				*Find POitem is Sales
				*cSOItem = get_SOitem_from_POitem(cPOItem, ThisForm.nConnHandle)
				PRIVATE cGetPOitem
				cGetPOitem = Proper_PO_Item(GetPOitem_PurchaseOrder_SOitem( ThisForm.cSOItem, ThisForm.nConnHandle ))
				IF Proper_PO_Item(cGetPOitem) <> Proper_PO_Item('')
					IF Proper_PO_Item(cGetPOitem) <> Proper_PO_Item(ThisForm.cPOitem)
						cMess = "While Receiving for POitem='"+Proper_PO_Item(cPOitem)+"'"
						IF ThisForm.nReceivingid > 0
							cMess = cMess +CHR(13)+" ReceivingID="+ALLTRIM(STR(ThisForm.nReceivingid))
						ENDIF	
						cMess = cMess +CHR(13)+" SOitem='"+Proper_SO_Item(ThisForm.cSOItem)+"' did not belong to this POitem."
						cMess = cMess +CHR(13)+" Found POitem='"+Proper_PO_Item(cGetPOitem)+"' on that SOitem."
						cMess = cMess +CHR(13)+"GetPOitem_PurchaseOrder_SOitem()"
						TrackMess(cMess)
					ENDIF
				ENDIF		
				
			ENDIF
		ENDIF
		
		
		ThisForm.cSOitem = cSOitem
		
		*****
		*Check Recv_QTY
		PRIVATE nAcct_QTY,nAcct_P,nPS_QTY,nPS_P
		nAcct_QTY	= PrepareSQLnum(ThisForm.txtAcct_Qty.Value,'S_QTY',-5)	&&Acct QTY
		nAcct_P		= PrepareSQLnum(ThisForm.txtAcct_P.Value,'S_P',-5)	&&Acct P
		
		nPS_QTY = PrepareSQLnum(ThisForm.txtPO_QTY.Value,'Quoted_QTY',-5)	&&Customer QTY
		nPS_P 	= PrepareSQLnum(ThisForm.txtPO_P.Value,'Quoted_P',-5)	&&Customer
		*	
		
		IF nAcct_QTY = 0
			MESSAGEBOX("ERP Acct Standard QTY was not entered."+CHR(13)+"You cannot save this receive with no Quantity!"+CHR(13)+"Calculate the QTY that ERP Acct Standard would like to see"+CHR(13)+"Most of the time this is Pounds, but could by Foot or Pieces",16,"No Save")
			lReady2Save = .F.
		ENDIF
		*****
		IF nPS_QTY = 0
			MESSAGEBOX("Vendor QTY was not entered."+CHR(13)+"You cannot save this receive with no Quantity!"+CHR(13)+"Enter the QTY found on packingslip from Vendor"+CHR(13)+"This entered Quantity will be verified against their Invoice.",16,"No Save")
			lReady2Save = .F.
		ENDIF
		****
		*****
		*Is Receive nAcct_QTY > Expected
		*Is Receive nPS_QTY > Expected
		*****
		
		RETURN lReady2Save
	ENDPROC

	PROCEDURE checksave_wod
		*ThisForm.CheckSave_WOD()
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		
		PRIVATE  nReceivingID
		*nReceivingID = Receive_Edit.txtReceivingID.Value
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		ThisForm.nReceivingID = nReceivingID
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		PRIVATE cSOitem, nSalesNum, nItemSo, nWO, nWO_Detail
		PRIVATE nRMA,cAlloy,cHeat,cLot,cDescription
		
		nHpaPo		= PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		nSalesNum	= PrepareSQLnum(ThisForm.txtSONum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		ThisForm.cSOitem = cSOitem
		
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50,.f.)
		cLot		= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10,.f.)
		
		cDescription= PrepareSQLtxt(ThisForm.edtDescription.Value,'Description',-1,.F.)
		
		nRMA = PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA',-3)
		
		*************************
		*Check Heat
		IF UPPER(cHeat) = "DUE IN"
			cHeat = ""	&&Do not check for Due In
		ENDIF
		IF LEN(cHeat)=0
			IF MESSAGEBOX("No Heat was Entered."+CHR(13)+CHR(13)+"If this is OK answer (Y)."+CHR(13)+CHR(13)+"If you want to go back"+CHR(13)+"and enter the Heat, answer(N)",16+4,"Continue...") != 6
				lReady2Save = .F.
			ENDIF
		ENDIF
		
		*************************
		*Check TBL
		
		PRIVATE nID_Master, nID_Detail, cTBL, cForm
		nID_Master	= PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
		cTBL 		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		cForm 		= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		
		PRIVATE cTBL_POi, cTBL_POi_P
		*cTBL_POi	= getTBL_POitem(cPOitem, ThisForm.nConnhandle ) 
		*cTBL_POi_P	= getTBL_Process_POitem(cPOitem, ThisForm.nConnhandle ) 
		cTBL_POi	= 'S'
		cTBL_POi_P	= 'S'
		
		
		PRIVATE cTBL_WO, cTBL_WOD
		IF nWO > 0
			cTBL_WO		= getTBL_WO(nWO, ThisForm.nConnhandle )
		ELSE
			cTBL_WO		= ''
		ENDIF
		IF nWO_Detail > 0
			*cTBL_WOD	= getTBL_WOD_WO(nWO, ThisForm.nConnhandle )
			cTBL_WOD	= getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle )
		ELSE
			cTBL_WOD	= ''
		ENDIF
		
		IF nID_Master + nID_Detail > 0
			IF ThisForm.cTBL != cTBL 
				IF LEN(ALLTRIM(cTBL)) = 0
					IF LEN(ALLTRIM(ThisForm.cTBL)) > 0
						cTBL = ThisForm.cTBL
					ENDIF
				ENDIF
			ENDIF
			
			IF LEN(ALLTRIM(cTBL)) = 0
				*Should have TBL
				DO CASE
				CASE ThisForm.cWhat = "S_Process" 
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "B_Process"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "W_Process"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "Stk_Detail" 
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "Brk_Detail"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "WO_Detail"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				CASE ThisForm.cWhat = "WO"
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not figure out TBL in Receive_Edit"+CHR(13)+"CheckSave() What="+ThisForm.cWhat+", nReceivingID="+ALLTRIM(STR(nReceivingID))+", pcHeat="+ThisForm.cHeat )
				OTHERWISE
					*Carefull, POitem has been incorrectly passed before.
		*!*				IF Proper_PO_item(cPOitem) != Proper_PO_item('')
		*!*					
		*!*					IF USED('get_TBL_WO')
		*!*						USE IN get_TBL_WO
		*!*					ENDIF
		*!*					
		*!*					SELECT 0
		*!*					cSQL =       " SELECT 'S' AS TBL, ID FROM dbo.StockLst_Master WITH(NOLOCK) "
		*!*					cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*					cSQL = cSQL +" UNION "
		*!*					cSQL = cSQL +" SELECT 'B' AS TBL, ID FROM dbo.BrokerLst_Master WITH(NOLOCK) "
		*!*					cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*					cSQL = cSQL +" UNION "
		*!*					cSQL = cSQL +" SELECT 'W' AS TBL, ID FROM dbo.WIPLst_Master WITH(NOLOCK) "
		*!*					cSQL = cSQL +"  WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'get_TBL_WO' )
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'get_TBL_WO' )
		*!*					ENDDO
		*!*					IF nSQLEXEC < 0 &&Try again!
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "get_TBL_WO")
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "get_TBL_WO")
		*!*							
		*!*							IF nSQLEXEC < 0
		*!*								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*									nSQLEXEC = 0
		*!*								ENDIF
		*!*							ENDIF
		*!*						ENDDO
		*!*					ENDIF 
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'get_TBL_WO')
		*!*					ENDIF
		*!*					
		*!*					IF USED('get_TBL_POitem')
		*!*						IF RECCOUNT('get_TBL_POitem') = 1
		*!*							IF nID_Master = PrepareSQLnum(get_TBL_WO.ID,'ID',-3)
		*!*								*good
		*!*								cTBL = get_TBL_POitem.TBL
		*!*							ELSE
		*!*								*bad
		*!*							ENDIF
		*!*						ENDIF
		*!*						IF RECCOUNT('get_TBL_POitem') > 1
		*!*							LOCATE FOR ID = nID_Master 
		*!*							IF FOUND()
		*!*								*good
		*!*								cTBL = get_TBL_POitem.TBL
		*!*							ELSE
		*!*								*bad
		*!*							ENDIF
		*!*						ENDIF
		*!*						
		*!*						IF NOT EMPTY(cTBL)
		*!*							ThisForm.txtTBL.Value = cTBL
		*!*						ENDIF
		*!*						
		*!*						USE IN get_TBL_POitem
		*!*					ELSE
		*!*						*do not have TBL ###
		*!*					ENDIF
		*!*				
		*!*				ENDIF
				ENDCASE
			ENDIF
		ENDIF
		
		*!*	*****
		*!*	IF nRMA > 0 	
		*!*		IF NOT RMA_Exists(nRMA,ThisForm.nConnhandle)
		*!*			MESSAGEBOX("Not an Active RMA!",48,"Bad RMA Number")
		*!*			lReady2Save = .F.
		*!*		ELSE
		*!*			ThisForm.StockLst_TBL = "S"
		*!*		ENDIF
		*!*		
		*!*		***
		*!*		IF nReceivingID > 0 
		*!*			nMess = 0
		*!*			nMess = MESSAGEBOX("RMA and Receiving ID are good."+CHR(13)+"Last chance to create a NEW receive."+CHR(13)+CHR(13)+"If you are editing an old record:"+CHR(13)+"Answer (Y) to update the ReceivingID"+CHR(13)+"Answer (N) to set create new ReceivingID.",4+32,"Save Edited Record?")	
		*!*			IF nMess = 7
		*!*				nReceivingID = 0
		*!*				ThisForm.txtReceivingID.Value = nReceivingID 
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		***
		*	IF Proper_SO_item(cSOitem) = Proper_SO_item('')
		*		MESSAGEBOX("Need Sales Order for an RMA!"+CHR(13)+"Add the Sales Order for the RMA!",48,"Bad SO Item Number")
		*		lReady2Save = .F.
		*	ENDIF
		*	***
		*	IF Proper_PO_item(cPOitem) != Proper_PO_item('')
		*		MESSAGEBOX("RMA cannot have a PO on RMA!"+CHR(13)+"RMA needs the SO."+CHR(13)+"Remove the PO or remove the RMA.",48,"Bad RMA Number")
		*		lReady2Save = .F.
		*	ENDIF
		*	IF lReady2Save 
		*		PRIVATE nHpaPo
		*		nHpaPo	= PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		*		IF nHpaPo > 0
		*			MESSAGEBOX("This receive is marked as for a RMA."+CHR(13)+"PO number is being dropped!",0+48,"RMA do not record their PO info.")
		*			ThisForm.txtHpaPONum.Value = 0
		*			ThisForm.txtHPAPOItem.Value = 0
		*			ThisForm.cPOitem = Proper_PO_item('')
		*		ENDIF
		*	ENDIF
		*	***
		
		*ENDIF
		*****
		
		*!*	IF lReady2Save 
		*!*		IF nSalesNum > 0
		*!*			IF nItemSo <= 0
		*!*				*Problem
		*!*				MESSAGEBOX("Sales Order is "+ALLTRIM(STR(nSalesNum))+"."+CHR(13)+"Cannot save with item of "+ALLTRIM(STR(nItemSo))+"!",48,"Bad Item Number")
		*!*				lReady2Save = .F.
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*************
		*!*	PRIVATE lFoundSOitem
		*!*	lFoundSOitem = .F.
		
		*!*	*************
		*!*	*Check to see if this receive does not need a po.
		*!*	*The SalesOrder is quotes.services, Conversion Service Only- customers material.
		*!*	PRIVATE lFoundConvServ 
		*!*	lFoundConvServ = .F.
		*!*	IF lReady2Save
		*!*		IF cSOitem 	!= Proper_SO_Item("")
		*!*			*have SOitem
		*!*			
		*!*			IF USED('tmpCountSO_ServiceOnly')
		*!*				USE IN tmpCountSO_ServiceOnly
		*!*			ENDIF
		*!*			
		*!*			SELECT 0
		*!*			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.AllQuotes WITH(NOLOCK) "
		*!*			cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*			cSQL = cSQL +" AND ISNULL(Services,0) = 1"
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountSO_ServiceOnly' )
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountSO_ServiceOnly' )
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountSO_ServiceOnly")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountSO_ServiceOnly")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountSO_ServiceOnly')
		*!*			ENDIF
		*!*			
		*!*			IF USED('tmpCountSO_ServiceOnly')
		*!*				IF RECCOUNT('tmpCountSO_ServiceOnly')>0
		*!*					lFoundSOitem = .T.
		*!*					IF tmpCountSO_ServiceOnly.Cntd>0
		*!*						lFoundConvServ = .T.
		*!*					ENDIF
		*!*				ENDIF
		*!*				USE IN tmpCountSO_ServiceOnly
		*!*			ENDIF
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
		*************
		PRIVATE lFoundWO_Detail
		lFoundWO_Detail = .F.
		
		*Check to see if this receive uses a WO_Detail
		IF nWO_Detail > 0
			*have WO_Detail
			
			IF USED('tmpCountWO_Detail')
				USE IN tmpCountWO_Detail
			ENDIF
			
			SELECT 0
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL +" WHERE WO_Detail="+STR(nWO_Detail)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountWO_Detail' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpCountWO_Detail' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountWO_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountWO_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountWO_Detail')
			ENDIF
			
			IF USED('tmpCountWO_Detail')
				IF RECCOUNT('tmpCountWO_Detail')>0
					lFoundSOitem = .T.
					IF tmpCountWO_Detail.Cntd>0
						lFoundWO_Detail = .T.
					ENDIF
				ENDIF
				USE IN tmpCountWO_Detail
			ENDIF
			
		ENDIF
		
		
		
		
		
		*************
		*Check POitem2
		IF lReady2Save 
		
				*Do not need to check for PO on RMA
				
					IF NOT lFoundWO_Detail  &&Do not to check on PO because it hase a good WO_Detail
						MESSAGEBOX("Did not find WO_Detail: "+ALLTRIM(STR(nWO_Detail))+CHR(13)+"You cannot save this receive with that WO_Detail!",16,"No Save")
						lReady2Save = .F.
					ENDIF
				
		
		ENDIF
		
		
		
		*****
		*Check Recv_QTY
		PRIVATE nAcct_QTY,nAcct_P,nPS_QTY,nPS_P
		nAcct_QTY	= PrepareSQLnum(ThisForm.txtAcct_Qty.Value,'S_QTY',-5)	&&Acct QTY
		nAcct_P = 0
		nPS_QTY = PrepareSQLnum(ThisForm.txtPO_QTY.Value,'Quoted_QTY',-5)	&&Customer QTY
		nPS_P 	= PrepareSQLnum(ThisForm.txtPO_P.Value,'Quoted_P',-5)	&&Customer
		*	
		
		IF nAcct_QTY = 0
			MESSAGEBOX("ERP Acct Standard QTY was not entered."+CHR(13)+"You cannot save this receive with no Quantity!"+CHR(13)+"Calculate the QTY that ERP Acct Standard would like to see"+CHR(13)+"Most of the time this is Pounds, but could by Foot or Pieces",16,"No Save")
			lReady2Save = .F.
		ENDIF
		*****
		
		IF nAcct_QTY > 0
			IF nPS_QTY = 0
				nPS_QTY = nAcct_QTY
				ThisForm.txtPO_QTY.Value = nPS_QTY
			ENDIF
		ENDIF
		
		IF nPS_QTY = 0
			MESSAGEBOX("Vendor QTY was not entered."+CHR(13)+"You cannot save this receive with no Quantity!"+CHR(13)+"Enter the QTY, usually pounds "+CHR(13)+"This entered Quantity will be verified when reconciled.",16,"No Save")
			lReady2Save = .F.
		ENDIF
		
		*****
		
		
		RETURN lReady2Save
	ENDPROC

	PROCEDURE choosepoitemload
		PARAMETER pnHpaPo
		*ThisForm.ChoosePOitemLoad(nHPApo)
		
		PRIVATE nHpaPo
		IF TYPE("pnHpaPo") = "N"
			nHpaPo = pnHpaPo
		ELSE
			nHpaPo = 0
		ENDIF
		
		IF nHpaPo = 0
			WAIT WINDOW "No ERP PO to load" NOWAIT
			RETURN .F.
		ENDIF
		
		PRIVATE nItemPo
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		
		IF nHpaPo > 0
			IF ThisForm.ChecknHpaPO = nHpaPo 
				IF ThisForm.ChecknItemPO = nItemPo
				
					RETURN .F.
				ELSE
					ThisForm.ChecknItemPO = nItemPo
				ENDIF
			ELSE
				ThisForm.ChecknHpaPO = nHpaPo 
				ThisForm.ChecknItemPO = 0
			ENDIF
		ENDIF
		
		*ThisForm.ChecknItemPO 
		
		
		*Show list of Item to Choose
		PRIVATE cPoItem
		DO FORM Forms\ChoosePOitem WITH nHpaPo TO cPoItem
		
		cPOitem	= Proper_PO_Item( cPoItem )
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item( '' )
			RETURN .F.
		ENDIF
		nItemPo = Proper_PO_Item_Item(cPOitem)
		
		*****************
		*Check for PO
		IF USED("tmpPOitems")
			USE IN tmpPOitems
		ENDIF
		
		
		cSQL = "SELECT COUNT(*) AS CNTD "
		cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
		*cSQL = cSQL + " WHERE HpaPo = "+STR(nHpaPo)
		cSQL = cSQL + " WHERE POitem='"+cPOitem+"'"
		
		IF USED("tmpPOitems")
			SELECT tmpPOitems 
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOitems')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOitems')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOitems')
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitems")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF USED("tmpPOitems")
			IF RECCOUNT("tmpPOitems") > 0
				IF tmpPOitems.CNTD > 0
					ThisForm.txtHpaPOItem.Value = nItemPo
					ThisForm.ChecknItemPO = nItemPO
					ThisForm.cPOitem = cPOitem
					ThisForm.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisForm.nConnHandle )
		
					PRIVATE nWO_Detail
					nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
					PRIVATE nCntPO, nMess
					
					IF ThisForm.lblWhat.Caption = 'ADD'
		
						nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle ,"NOTSTOCK")
						nMess = 6				
						IF nCntPO > 0 AND nWO_Detail = 0
							nMess = MESSAGEBOX("This PO "+ALLTRIM(STR(nHpaPo))+" is not for receiving metal!"+CHR(13)+"This could be a testing PO number."+CHR(13)+"This could be a Conversion Service"+CHR(13)+CHR(13)+"If you are trying to receive in "+CHR(13)+"stock for Inventory "+CHR(13)+"or a Sales Order"+CHR(13)+"You have the wrong PO number."+CHR(13)+CHR(13)+"Do you still want to use this PO?",4+32,"Service PO")
						ENDIF
						IF nMess = 6
							*Get POitem Detail
							ThisForm.GetPO_Incoming(cPOitem)
							*ThisForm.GetPoItemDetail(cPOitem)
						ENDIF
					ELSE
						IF ThisForm.lblWhat.Caption = 'EDIT'
						
							nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle ,"NOTSTOCK")
							nMess = 6				
							IF nCntPO > 0 AND nWO_Detail = 0
								nMess = MESSAGEBOX("This PO "+ALLTRIM(STR(nHpaPo))+" is not for receiving metal!"+CHR(13)+"This could be a testing PO number."+CHR(13)+"This could be a Conversion Service"+CHR(13)+CHR(13)+"If you are trying to receive in "+CHR(13)+"stock for Inventory "+CHR(13)+"or a Sales Order"+CHR(13)+"You have the wrong PO number."+CHR(13)+CHR(13)+"Do you still want to use this PO?",4+32,"Service PO")
							ENDIF
							IF nMess = 6
								*Get POitem Detail
								*ThisForm.GetPO_Incoming(cPOitem)
								ThisForm.GetPoItemDetail(cPOitem)
							ENDIF
		
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			USE IN tmpPOitems
		ENDIF
		
		RETURN .T.
	ENDPROC

