	PROCEDURE getby_stk_detail_process
		*ThisForm.GetBy_STK_Detail()
		
		*See if this ID_Detail can get the correct ReceivingID
		PRIVATE nID_Detail_Process, cTBL, nReceivingID 
		nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process.Value',-3)
		cTBL = PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		nReceivingID = 0
		
		PRIVATE cSQL, nSQLExec
		PRIVATE lFoundProcess
		lFoundProcess = .F.
		
		
		IF USED("tmpRcv_ID_Detail_P")
			USE IN tmpRcv_ID_Detail_P
		ENDIF
		SELECT 0
		*[SOitem],[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment],[Process_ID],[Processor],[AllowSub]
		*,[PU],[QTY],[Ordered_QTY],[Ordered_P],[Pounds],[ID_Detail],[ID_Detail_Process],[ReceivingID],[WO],[WO_Detail]
		*,[Prc_QTY],[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3]
		
		cSQL = "SELECT P.* "
		cSQL = cSQL + ",M.Alloy,M.Form,M.Heat,M.Lot,M.Specs, M.PO_item AS MPO_item, M.WO_Detail AS MWO_Detail "
		cSQL = cSQL + ",D.PC, D.ID_Detail, D.ID, D.S_P, D.S_PU "
		cSQL = cSQL + ",(SELECT ISNULL(PO.Order_P,0) FROM dbo.PurchaseOrder PO WITH(NoLock) WHERE PO.POitem = P.PO_Item ) AS Order_P  "
		DO CASE
		CASE cTBL = 'S'
			cSQL = cSQL + " FROM dbo.StockLst_Process P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
		CASE cTBL = 'B'
			cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
		CASE cTBL = 'W'
			cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRcv_ID_Detail_P')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRcv_ID_Detail_P' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRcv_ID_Detail_P")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRcv_ID_Detail_P")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRcv_ID_Detail_P' )
		ENDIF
		
		IF USED('tmpRcv_ID_Detail_P')
			IF RECCOUNT('tmpRcv_ID_Detail_P') > 0	
				lFoundProcess = .T.
			ENDIF
			*USE IN tmpRcv_ID_Detail_P
		ENDIF
		
		*******************************
		
		*IF NOT lFoundProcess 
		
		
		********************************
		*See what records where found
		PRIVATE nRecCount, nRecNum, nMess
		
		IF USED('tmpRcv_ID_Detail_P')
			nRecCount = RECCOUNT('tmpRcv_ID_Detail_P')
			
			ThisForm.txtReceivingID.Value = PrepareSQLnum(tmpRcv_ID_Detail_P.ReceivingID,'ReceivingID',-3)
			
			ThisForm.txtWO.Value		= PrepareSQLnum(tmpRcv_ID_Detail_P.WO,'WO',-3)
			ThisForm.txtWO_Detail.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.WO_Detail,'WO_Detail',-3)
			
			
			*ThisForm.txtReceived.Value = PrepareSQLDate(tmpRcv_ID_Detail_P.Received,'Received')
			ThisForm.txtReceived.Value = PrepareSQLDate(DATE(),'Received')
			
			PRIVATE cPOitem 
			cPOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.PO_item,'POitem',12)  &&Try from Process
			IF Proper_PO_item(cPOitem) != Proper_PO_item('')
				*IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "METAL" ) > 0
				ThisForm.cPOitem 		= cPOitem
				ThisForm.txtHpaPONum.Value 	= Proper_PO_Item_PO(cPOitem) &&LEFT(ThisForm.cPOitem,AT("-",ThisForm.cPOitem)-1)
				ThisForm.txtHpaPOItem.Value = Proper_PO_Item_Item(cPOitem)  &&ALLTRIM(STR(VAL(RIGHT(ThisForm.cPOitem,LEN(ThisForm.cPOitem)-AT("-",ThisForm.cPOitem)))))
				ThisForm.ChecknHpaPO = ThisForm.txtHpaPONum.Value
				ThisForm.ChecknItemPO = ThisForm.txtHpaPOItem.Value
			ELSE
				
				cPOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.MPO_item,'POitem',12)	&&Try from Master
				IF Proper_PO_item(cPOitem) != Proper_PO_item('')
					ThisForm.cPOitem 		= cPOitem
					ThisForm.txtHpaPONum.Value 	= Proper_PO_Item_PO(cPOitem) &&LEFT(ThisForm.cPOitem,AT("-",ThisForm.cPOitem)-1)
					ThisForm.txtHpaPOItem.Value = Proper_PO_Item_Item(cPOitem)  &&ALLTRIM(STR(VAL(RIGHT(ThisForm.cPOitem,LEN(ThisForm.cPOitem)-AT("-",ThisForm.cPOitem)))))
					ThisForm.ChecknHpaPO = ThisForm.txtHpaPONum.Value
					ThisForm.ChecknItemPO = ThisForm.txtHpaPOItem.Value
				ELSE
					ThisForm.cPOitem 		= Proper_PO_item('')
					ThisForm.txtHpaPONum.Value 	= 0
					ThisForm.txtHpaPOItem.Value = 0
					ThisForm.ChecknHpaPO = ThisForm.txtHpaPONum.Value
					ThisForm.ChecknItemPO = ThisForm.txtHpaPOItem.Value
				ENDIF
			ENDIF
			
			PRIVATE cSOitem 	
			cSOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.SOitem,'SOitem',10)   &&Try from Process
			IF Proper_SO_item(cSOitem) != Proper_SO_item("")
				ThisForm.cSOitem			= cSOitem
				ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
				ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
			ELSE
				cSOitem = PrepareSQLtxt(tmpRcv_ID_Detail_P.SOitem,'SOitem',10)	&&Try from Master
				IF Proper_SO_item(cSOitem) != Proper_SO_item("")
					ThisForm.cSOitem			= cSOitem
					ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
					ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
				ELSE
					ThisForm.cSOitem			= Proper_SO_item("")
					ThisForm.txtSOnum.Value		= 0
					ThisForm.txtSOitem.Value	= 0
				ENDIF
			ENDIF
							
			ThisForm.txtAlloy.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.Alloy,'Alloy',12)
			
			IF NOT (ThisForm.cHeat = "ADD" OR ThisForm.cHeat = "EDIT")
				ThisForm.txtHeat.Value		= ThisForm.cHeat 
			ENDIF
			
			IF NOT EMPTY(PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50))
				IF EMPTY(PrepareSQLtxt(ThisForm.cHeat,'Heat',50))
					ThisForm.txtHeat.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50)
				ELSE
					IF ALLTRIM(UPPER(PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50))) = ALLTRIM(UPPER(ThisForm.cHeat))
						ThisForm.txtHeat.Value = ThisForm.cHeat
					ELSE
						IF NOT (ThisForm.cHeat = "ADD" OR ThisForm.cHeat = "EDIT")
							nMess = MESSAGEBOX("Heat was passed in as"+CHR(13)+ThisForm.cHeat+CHR(13)+"the Process ID Heat is"+CHR(13)+PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50)+CHR(13)+CHR(13)+"Do you want to keep the Passed in Heat?",4+32,"Keep the Passed in Heat")
							IF nMess = 6
								ThisForm.txtHeat.Value = ThisForm.cHeat
							ENDIF
							IF nMess = 7
								ThisForm.txtHeat.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Heat,'Heat',50)
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			IF ALLTRIM(UPPER(ThisForm.txtHeat.Value)) = "DUE IN"
				ThisForm.txtHeat.Value = ""
			ENDIF
			ThisForm.txtLot.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.Lot,'Lot',10)
			
			*ThisForm.chkCert.Value		= IIF(tmpRcv_ID_Detail_P.Cert,1,0)
			ThisForm.chkCert.Value		= 0
			ThisForm.chkCofC.Value		= 0
			ThisForm.chkMillTrace.Value = 0
			
			ThisForm.txtPieces.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.PC,'PC',-3)
		*	ThisForm.edtDescription.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Descript,'Decript',20)  &&Do not use Descript from here!
			ThisForm.edtSpecs.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.Specs,'Specs',160)
			ThisForm.edtComments.Value 	= PrepareSQLtxt(tmpRcv_ID_Detail_P.Comment,'Comment',100)
			*ThisForm.edtComments.Value 	= ''
			
			*ThisForm.txtInit.Value		= tmpRcv_ID_Detail_P.Init
			ThisForm.txtInit.Value		= ''
			
			*ThisForm.txtDate.Value		= DTOC(tmpRcv_ID_Detail_P.Date)
			ThisForm.txtDate.Value 		= PrepareSQLDate(DATE(),'DATE')
			
			*ThisForm.chkPass.Value		= IIF(tmpRcv_ID_Detail_P.Pass,1,0)
			ThisForm.chkPass.Value		= PrepareSQLlogic(0,'Pass')
			
			*ThisForm.chkGoodPapers.Value = IIF(tmpRcv_ID_Detail_P.GoodPapers,1,0)
			ThisForm.chkGoodPapers.Value = PrepareSQLlogic(0,'GoodPapers')
			
			ThisForm.txtActualW.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.Pounds,'Weight',9,1)
			ThisForm.txtBillW.Value		= PrepareSQLnum(tmpRcv_ID_Detail_P.Pounds,'Weight',9,1)
			
			ThisForm.txtAcct_Qty.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.QTY,'S_QTY',-5) &&Try from Process
			
			ThisForm.txtAcct_P.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.S_P,'S_P',-5)
			
			PRIVATE nAcct_PU 
			nAcct_PU = PrepareSQLnum(tmpRcv_ID_Detail_P.S_PU,'PU',-1)
			ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
			ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
			ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisForm.nConnHandle)
			
			PRIVATE nVend_PU 
			nVend_PU = PrepareSQLnum(tmpRcv_ID_Detail_P.PU,'PO_PU',-1)	 &&Try from Process
			IF nVend_PU > 0
				ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(tmpRcv_ID_Detail_P.Ordered_QTY,'PO_QTY',-5)
				ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpRcv_ID_Detail_P.Ordered_P,'PO_P',-5)
			ENDIF
			
			IF nVend_PU = 0
				*Old Receive - Get by POitem
				IF Proper_PO_Item(ThisForm.cPOitem) <> Proper_PO_Item("")
					nVend_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisForm.nConnHandle ), 'Order_PU',-1)		
				ENDIF
			ENDIF
			
			IF nVend_PU = 0
				ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(1, 'PO_PU',2)
				ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( 1, ThisForm.nConnHandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( 1, ThisForm.nConnHandle)
			ELSE
				ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
				ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( nVend_PU, ThisForm.nConnHandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nVend_PU, ThisForm.nConnHandle)
			ENDIF
			
			IF EMPTY(ThisForm.txtPO_QTY.Value)
				PRIVATE nVend_QTY, nVend_P
				nVend_QTY = Calc_Vend_QTYleft_PO(cPOitem, ThisForm.nConnHandle)
				nVend_P = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisForm.nConnHandle ), 'Order_PU',-1)
				ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
				ThisForm.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
			ENDIF
			
			*Done in next block of code.
			*ThisForm.txtVendor.Value = PrepareSQLtxt(Get_From_POitem(cPOitem, "Company", ThisForm.nConnHandle ),'Vendor',30,.F.,.T.)
				
			*ThisForm.edtRejectReason.Value	= tmpRcv_ID_Detail_P.RejectReason
			ThisForm.edtRejectReason.Value	= ''
			
			*ThisForm.txtRMA_No.Value		= tmpRcv_ID_Detail_P.RMA_No
			ThisForm.txtRMA_No.Value		= 0
			ThisForm.txtRMA_Detail.Value	= 0
			
			ThisForm.chkLab_Service.Value= PrepareSQLchk(0,'Services')
			ThisForm.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
			ThisForm.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
		
			ThisForm.txtID_Master.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.ID,'ID_Master',-3)
			ThisForm.txtID_Detail.Value	= PrepareSQLnum(tmpRcv_ID_Detail_P.ID_Detail,'ID_Detail',-3)
			*ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpRcv_ID_Detail_P.StockTable,'TBL',1)
			*IF EMPTY(ThisForm.txtTBL.Value)
			*	ThisForm.txtTBL.Value		= PrepareSQLtxt(ThisForm.StockLst_TBL,'TBL',1)
			*ENDIF
			ThisForm.txtForm.Value = PrepareSQLtxt(tmpRcv_ID_Detail_P.Form,'Form',2)
			
			************************************************************************************
			************************************************************************************
			************************************************************************************
			
			IF USED('tmpRcv_ID_Detail_P')
				USE IN tmpRcv_ID_Detail_P
			ENDIF
			*******
			IF Proper_PO_item(PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)) != Proper_PO_item('')
				*Get Vendor Company name, Description
				
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				cSQL = "SELECT Company, Alloy"
		*		cSQL = cSQl + ", Form, Order_Qty, Pieces, Thck, Sz2, Sz3, Cond_Spec, Heat, RandLen "
		*		cSQL = cSQl + ",StockLst_QTY,StockLst_P,Pounds,Order_PU "
		*		cSQL = cSQL + " ,dbo.f_Descript(Alloy,CC,CL,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen) AS Descript "
				cSQL = cSQL + " ,dbo.f_DescriptionMetricReport(Pieces,Form,Thck,Sz2,Sz3,[Order_QTY],RandLen,0,'','','') AS Descript "
				cSQL = cSQL + " FROM dbo.PurchaseOrder WHERE PoItem = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF RECCOUNT('tmpPOp') > 0
						ThisForm.txtVendor.Value	= PrepareSQLtxt(tmpPOp.Company,'Company',30)
						ThisForm.txtAlloy.Value		= PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
						PRIVATE cDesc,cDesc2
						cDesc = ALLTRIM(PrepareSQLtxt(ThisForm.edtDescription.Value,'Descript',-1))
						cDesc2 = ALLTRIM(PrepareSQLtxt(tmpPOp.Descript,'Descript',-1))
						IF EMPTY(cDesc)
							ThisForm.edtDescription.Value = cDesc2
						ELSE
							IF MESSAGEBOX("Add PO Description"+CHR(13)+cDesc2+","+CHR(13)+"before Process Description"+CHR(13)+cDesc+CHR(13)+"Answer No to just use Process Description.",4,"Add PO Description, before Process Description")=6
								ThisForm.edtDescription.Value = cDesc2+". "+cDesc
							ENDIF
						ENDIF
					ENDIF
					USE IN tmpPOp
				ENDIF
		
			ENDIF
			
			**validate data
			IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
				IF Count_POIteminPurchaseOrder( ThisForm.cPOitem, ThisForm.nConnHandle )=0
					MESSAGEBOX("The POitem '"+ThisForm.cPOitem+"'"+CHR(13)+"entered in '"+cTBL+"' Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for POitem problems.",48,"Weird")
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem '"+ThisForm.cPOitem+"' entered in '"+cTBL+"' Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))+", does not Exists!")
				ENDIF
			ENDIF
			IF Proper_SO_item(ThisForm.cSOitem) <> Proper_SO_item('')
				IF Count_SOIteminSales( ThisForm.cSOitem, ThisForm.nConnHandle )=0
					MESSAGEBOX("The SO item '"+ThisForm.cSOitem+"'"+CHR(13)+"entered in '"+cTBL+"' Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for SOitem problems.",48,"Weird")
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SO item '"+ThisForm.cSOitem+"' entered in '"+cTBL+"' Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))+", does not Exists!")
				ENDIF
			ENDIF
			********
			
			RETURN .T.
		ELSE
			RETURN .F.		
		ENDIF
		
		
	ENDPROC

	PROCEDURE getfromreceiving
		PARAMETER pcPoItem, pnWO_Detail, pcHeat, pcLot
		*ThisForm.GetFromReceiving(cPOitem, nWO_Detail ,cHeat)
		*returns .F. if did not get a receiving record.
		
		IF TYPE("pcPoItem") != "C"
			RETURN .F.
			*pHPAPo = ''
		ENDIF
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pnWO_Detail,'WO_Detail',-3)
		
		PRIVATE cAndHeat, nReceivingID, cLot
		cLot = PrepareSQLtxt(pcLot,'Lot',10)
		IF TYPE("pcHeat") != "C"
			cAndHeat = ""
			pcHeat = ''
		ELSE
			IF NOT EMPTY(pcHeat)
			 	cAndHeat = " AND HEAT = '"+ALLTRIM(pcHeat)+"' "
			 	IF LEN(cLot) > 0
			 		cAndHeat = cAndHeat +" AND Lot = '"+cLot+"' "
			 	ENDIF
			 ELSE
			 	cAndHeat = ""
			 ENDIF
		ENDIF
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ID',-3,0)
		
		PRIVATE cSOitem, nSalesNum, nItemSO
		PRIVATE cPOitem, nHpaPo, nItemPo
		cSOitem = Proper_SO_item('')
		cPOitem = Proper_PO_item('')
		pcPoItem = Proper_PO_item(pcPoItem)
		
		***********************************
		*** FROM RecStockGetByPOitem
		*** GetPOitemDetail
		***********************************
		IF USED('tmpReceivingPOitem')
			USE IN tmpReceivingPOitem
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		*cSQL = "SELECT Heat,Cert,Pieces,Description,Specs,Comments,Init,Date,ActualW,BillW,Vendor,pass,ID FROM dbo.Receiving "
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ( dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+pcPoItem+"')"
		IF nWO_Detail > 0
			cSQL = cSQL + " OR WO_Detail = "+STR(nWO_Detail)+" )"
			cSQL = cSQL + cAndHeat
		ELSE
			cSQL = cSQL + " ) "
			cSQL = cSQL + cAndHeat
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivingPOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivingPOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpReceivingPOitem')
			RETURN .F.
		ENDIF
		PRIVATE cDescription, lFoundOnetoEdit, nCurRec, nRecords, nRID 
		cDescription = ''
		lFoundOnetoEdit = .F.
		nCurRec = 0
		nRecords = 0
		
		IF USED('tmpReceivingPOitem')
			IF RECCOUNT('tmpReceivingPOitem') = 0
				PRIVATE cMess
				cMess = ''
				IF Proper_PO_item(pcPoItem) <> Proper_PO_item('')
					cMess = "The POitem "+pcPoItem+CHR(13)
				ENDIF
				IF nWO_Detail > 0
					cMess = cMess + "WO_Detail "+STR(nWO_Detail)+CHR(13)
				ENDIF
				IF LEN(pcHeat) > 0
					cMess = cMess + " and Heat/Lot "+pcHeat+CHR(13)
				ENDIF
				cMess = cMess + "was not found as received."+CHR(13)
				cMess = cMess + "Please check the Heat for a typing error."
				
				MESSAGEBOX(cMess ,48,"Not found")
				RETURN .F.
			ELSE
				GO TOP
				IF VARTYPE(tmpReceivingPOitem.Description) = "C"
					cDescription = ALLTRIM(LEFT(tmpReceivingPOitem.Description, 40))
				ENDIF
			
		
				IF VARTYPE(tmpReceivingPOitem.Heat)="C" &&Heat
					IF !EMPTY(tmpReceivingPOitem.Heat)
						IF !EMPTY(pcHeat)
							IF nReceivingID > 0
								PRIVATE nReceivingID2
								nReceivingID2 = PrepareSQLnum(tmpReceivingPOitem.ID,'RID',-3)
								IF nReceivingID2 != nReceivingID 
									IF NOT ThisForm.cWhat = "EDIT"
										PRIVATE nMess, cMess
										cMess = "There is already a receiving record with this"+CHR(13)+"Heat= '"+ALLTRIM(pcHeat)+"'"
										
										IF LEN(cLot)>0
											cMess = cMess+"Lot= '"+ALLTRIM(cLot)+"'"+CHR(13)
										ENDIF
										cMess = cMess + " Your Receive ID "+ALLTRIM(STR(nReceivingID))+CHR(13)
										cMess = cMess + "Found Receive ID "+ALLTRIM(STR(nReceivingID2))+CHR(13)+CHR(13)
										
										cMess = cMess+CHR(13)+cDescription+CHR(13)+CHR(13)
										cMess = cMess+"Do you want to load the Found data?"
										
										nMess = MESSAGEBOX(cMess,4,"Overwrite current Data?") 
										IF nMess = 7
											*NO, do not overwrite
											ThisForm.ResetAddVars()
											
											RETURN .F.
										ENDIF
									ENDIF
								ENDIF
							ELSE
								*ID is 0, NEW
							ENDIF
						ELSE
							PRIVATE cEditNextRecord 
							cEditNextRecord = CHR(13)+"edit the next RECORD or"
							
							SELECT tmpReceivingPOitem
							nRecords = RECCOUNT()
							SCAN
							nCurRec = RECNO()
							cDescription = ALLTRIM(STR(tmpReceivingPOitem.Pieces))+"Pc "
							cDescription = cDescription + ALLTRIM(LEFT(tmpReceivingPOitem.Description, 40))
							cDescription = cDescription + " Heat:"+tmpReceivingPOitem.Heat
							
							nRID = tmpReceivingPOitem.ID
							IF nRecords > nCurRec
								cEditNextRecord = CHR(13)+"edit the next RECORD or"
							ELSE
								cEditNextRecord = ""
							ENDIF
							PRIVATE cMess, nMess
							nMess = 0
							cMess = "There is already a receiving record. "
							IF nCurRec < nRecords 
								cMess = cMess + "Record "+ALLTRIM(STR(nCurRec))+"/"+ALLTRIM(STR(nRecords))+"."+CHR(13)
							ENDIF
							cMess = cMess + cDescription+CHR(13)+CHR(13)+"Do you want to edit this data?"+CHR(13)+CHR(13)
							IF nCurRec < nRecords 
								cMess = cMess +"Answer No and you will get a chance to edit the next RECORD"+CHR(13)
							ENDIF
							*cMess = cMess +"Create a new Receiving record."
							
							nMess = MESSAGEBOX(cMess,4,"Edit old Data?")
							IF nMess = 6
								*Edit this one
								lFoundOnetoEdit = .T.
								EXIT
							ELSE
								*IF nRecords = nCurRec
									nMess = MESSAGEBOX("This is a chance to 'Create' a receive."+CHR(13)+"Are you sure you want to create"+CHR(13)+"another receiving record"+CHR(13)+"for this same PO item?"+CHR(13)+" ",4,"Create new receiving record?")
									IF nMess = 6
										ThisForm.txtReceivingID.Value = 0
										RETURN .F.
									ENDIF
								*ENDIF
							ENDIF
							
							cPOitem	= PrepareSQLtxt(tmpReceivingPOitem.POitem,'POitem',12)
		
							ENDSCAN
							
							IF lFoundOnetoEdit 
								IF MESSAGEBOX("Found a Receiving Record for this PO item '"+pcPoItem++"'"+CHR(13)+"Receiving ID: "+ALLTRIM(STR(nRID))+CHR(13)+CHR(13)+"Do you want to Edit this old receive?"+CHR(13)+"Answer No to be able to ADD another receive to this Po item.",4+32,"Edit old Receive?")=6
									ThisForm.txtReceivingID.Value = PrepareSQLnum(nRID,'ReceivingID',-3)
									ThisForm.GetBy_ReceivingID()
									RETURN .T.
								ELSE
									ThisForm.txtReceivingID.Value = 0			
								ENDIF
							ELSE
								ThisForm.txtReceivingID.Value = 0
								ThisForm.ResetAddVars()
								RETURN .F.
							ENDIF
		
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			*****
			
			*cPOitem	=	 PrepareSQLtxt(tmpReceivingPOitem.POitem,'POitem',12)
			IF Proper_PO_item(cPOitem) != Proper_PO_item("")
				IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "METAL" ) > 0
					ThisForm.cPOitem				= cPOitem
					ThisForm.txtHPAPONum.Value		= Proper_PO_Item_PO(cPOitem)
					ThisForm.txtHPAPOItem.Value		= Proper_PO_Item_Item(cPOitem)
					ThisForm.ChecknHpaPO 		= Proper_PO_Item_PO(cPOitem)
					ThisForm.ChecknItemPO		= Proper_PO_Item_Item(cPOitem)
				ELSE
					ThisForm.cPOitem			= Proper_PO_item("")
					ThisForm.txtHPAPONum.Value	= 0
					ThisForm.txtHPAPOItem.Value	= 0
					ThisForm.ChecknHpaPO 		= 0
					ThisForm.ChecknItemPO		= 0
				ENDIF
			ELSE
				*Just leave alone - function runs with the POitem or WO_Detail
		*		ThisForm.cPOitem			= Proper_PO_item("")
		*		ThisForm.txtHPAPONum.Value	= 0
		*		ThisForm.txtHPAPOItem.Value	= 0
		*		ThisForm.ChecknHpaPO 		= 0
		*		ThisForm.ChecknItemPO		= 0
			ENDIF
			
			cSOitem	=	 PrepareSQLtxt(tmpReceivingPOitem.SOitem,'SOitem',10)
			IF Proper_SO_item(cSOitem) != Proper_SO_item("")
				ThisForm.cSOitem			= cSOitem
				ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(cSOitem)
				ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(cSOitem)
			ELSE
				ThisForm.cSOitem			= Proper_SO_item("")
				ThisForm.txtSOnum.Value		= 0
				ThisForm.txtSOitem.Value	= 0
			ENDIF
				
			ThisForm.txtHeat.Value = PrepareSQLtxt(tmpReceivingPOitem.Heat,'Heat',50)
			ThisForm.txtLot.Value = PrepareSQLtxt(tmpReceivingPOitem.Lot,'Lot',10)
			ThisForm.chkCert.Value = PrepareSQLchk(tmpReceivingPOitem.Cert,'Cert')
			ThisForm.chkCofC.Value = PrepareSQLchk(tmpReceivingPOitem.CofC,'CofC')
			ThisForm.chkMillTrace.Value = PrepareSQLchk(tmpReceivingPOitem.MillTrace,'MillTrace')
			
			ThisForm.txtPieces.Value = PrepareSQLnum(tmpReceivingPOitem.Pieces,'Pieces',-3)
			ThisForm.edtDescription.Value = PrepareSQLtxt(tmpReceivingPOitem.Description,'Description',-1)
			ThisForm.edtSpecs.Value = PrepareSQLtxt(tmpReceivingPOitem.Specs,'Specs',-1)
			ThisForm.edtComments.Value = PrepareSQLtxt(tmpReceivingPOitem.Comments,'Comments',-1)
			ThisForm.txtInit.Value = PrepareSQLtxt(tmpReceivingPOitem.Init,'Init',10)
			ThisForm.txtDate.Value = DTOC(PrepareSQLdate(tmpReceivingPOitem.Date,'Date'))
			ThisForm.chkPass.Value = PrepareSQLlogic(tmpReceivingPOitem.Pass,'Pass')
			ThisForm.chkGoodPapers.Value = PrepareSQLlogic(tmpReceivingPOitem.GoodPapers,'GoodPapers')
		
			PRIVATE nActualW
			nActualW = PrepareSQLnum(ThisForm.txtActualW.Value,'ActualW',9,1)
			IF PrepareSQLnum(tmpReceivingPOitem.ActualW,'ActualW',9,1) > 0 AND nActualW < 2
				ThisForm.txtActualW.Value = PrepareSQLnum(tmpReceivingPOitem.ActualW,'ActualW',9,1)
			ENDIF
			PRIVATE nBillW
			nBillW = PrepareSQLnum(ThisForm.txtBillW.Value,'BillW',9,1)
			IF PrepareSQLnum(tmpReceivingPOitem.BillW,'BillW',9,1) > 0 AND nBillW < 2
				ThisForm.txtBillW.Value = PrepareSQLnum(tmpReceivingPOitem.BillW,'BillW',9,1)
			ENDIF
			
			ThisForm.chkLab_Service.Value= PrepareSQLchk(tmpReceivingPOitem.Services,'Services')
			ThisForm.chkConvServ.Value	= PrepareSQLchk(tmpReceivingPOitem.ConvServ,'ConvServ') 
			ThisForm.chkEquipment.Value	= PrepareSQLchk(tmpReceivingPOitem.Equipment,'Equipment')
		
			ThisForm.txtAcct_Qty.Value	= PrepareSQLnum(tmpReceivingPOitem.R_QTY,'S_QTY',-5)
			ThisForm.txtAcct_P.Value	= PrepareSQLnum(tmpReceivingPOitem.R_P,'S_P',-5)
			
			PRIVATE nAcct_PU 
			nAcct_PU = PrepareSQLnum(tmpReceivingPOitem.R_PU,'S_PU',-1)
			ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
			ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
			ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisForm.nConnHandle)
		*							
			IF EMPTY(ThisForm.txtPO_QTY.Value)
				ThisForm.txtPO_QTY.Value	= PrepareSQLnum(tmpReceivingPOitem.PO_QTY,'PO_QTY',-5)
			ENDIF
			
			PRIVATE nPO_P
			nPO_P = PrepareSQLnum(tmpReceivingPOitem.PO_P,'Order_P',-5)
			IF EMPTY(ThisForm.txtPO_P.Value)
		*		IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "METAL" ) > 0
					ThisForm.txtPO_P.Value		= nPO_P
		*		ENDIF
			ELSE
				IF nPO_P > 0
					PRIVATE nPO_Prev
					nPO_Prev = PrepareSQLnum(ThisForm.txtPO_P.Value,'Order_P',-5)
					IF nPO_Prev > 0
						IF ROUND(nPO_Prev,1) <> ROUND(nPO_P ,1)
							IF MESSAGEBOX("The PO item has a Price of "+STR(nPO_Prev,10,2)+CHR(13)+" The receive has a price of "+STR(nPO_P,10,2)+CHR(13)+"Do you want to keep the PO item Price",4+32,"Use PO item") = 6
								*nPO_Prev
							ELSE
								ThisForm.txtPO_P.Value = PrepareSQLnum(nPO_P,'Recv_P',-5)
							ENDIF	
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		*		
			*PRIVATE nCust_PU 
			*nCust_PU = PrepareSQLnum(tmpReceivingPOitem.PO_PU,'PO_PU',-1)
			PRIVATE nVend_PU 
			nVend_PU = PrepareSQLnum(tmpReceivingPOitem.PO_PU,'PO_PU',-1)
			IF nVend_PU > 0
				ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
				ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisForm.nConnHandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nVend_PU, ThisForm.nConnHandle)
				
				ThisForm.txtForm.Value = PrepareSQLtxt(tmpReceivingPOitem.Form,'Form',2)
				
				IF EMPTY(ThisForm.txtPO_QTY.Value)
					ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(tmpReceivingPOitem.PO_QTY,'PO_QTY',-5)
				ENDIF
				IF EMPTY(ThisForm.txtPO_P.Value)
					ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpReceivingPOitem.PO_P,'PO_P',-5)
				ENDIF
			ELSE
				*Old Receive - Get by POitem
				IF Proper_PO_Item(ThisForm.cPOitem) <> Proper_PO_Item("")
					nVend_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisForm.nConnHandle ), 'Order_PU',-1)
					ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
					ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( nVend_PU, ThisForm.nConnHandle)
					ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nVend_PU, ThisForm.nConnHandle)
					
					PRIVATE nVend_QTY, nVend_P
					nVend_QTY = Calc_Vend_QTYleft_PO(cPOitem, ThisForm.nConnHandle)
					nVend_P = PrepareSQLnum( Get_From_POitem(cPOitem, "StockLst_P", ThisForm.nConnHandle ), 'StockLst_P',-5)
					IF EMPTY(ThisForm.txtPO_QTY.Value) AND nVend_QTY > 0
						ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
					ENDIF
					IF EMPTY(ThisForm.txtPO_P.Value) AND nVend_P > 0
						ThisForm.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
					ENDIF
					
				ELSE
					ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(1, 'PO_PU',2)
					ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( 1, ThisForm.nConnHandle)
					ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( 1, ThisForm.nConnHandle)
				ENDIF								
			ENDIF
			
		*	ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(tmpReceivingPOitem.PO_QTY,'PO_QTY',-5)
		*	ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpReceivingPOitem.PO_P,'PO_P',-5)
		*	ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
		*	ThisForm.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
		
		
			ThisForm.txtVendor.Value = PrepareSQLtxt(tmpReceivingPOitem.Vendor,'Vendor',30,.F.,.T.)
			
			ThisForm.txtReceivingID.Value = PrepareSQLnum(tmpReceivingPOitem.ID,'ID',-3)
			
			ThisForm.txtID_Master.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Master,'ID_Master',-3)
			ThisForm.txtID_Detail.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Detail,'ID_Detail',-3)
			ThisForm.txtTBL.Value = PrepareSQLtxt(tmpReceivingPOitem.StockTable,'StockTable',1)
			*ThisForm.StockLst_TBL = PrepareSQLtxt(tmpReceivingPOitem.StockTable,'StockTable',1)
			ThisForm.txtForm.Value = PrepareSQLtxt(tmpReceivingPOitem.Form,'Form',2)
			
			*ID_Detail_Process is not stored in Receiving!
			*ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Detail_Process,'ID_Detail_Process',-3)
				
			IF USED('tmpReceivingPOitem')
				USE IN tmpReceivingPOitem
			ENDIF
			
			*ThisForm.Edit1.Value = ThisForm.Edit1.Value+CHR(13)+"Retrieved PO item "+pcPoItem+" for edit."
			ThisForm.Refresh	
		ENDIF
		
		**validate data
		IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
			IF Count_POIteminPurchaseOrder( ThisForm.cPOitem, ThisForm.nConnHandle )=0
				MESSAGEBOX("The POitem '"+ThisForm.cPOitem+"'"+CHR(13)+" entered in ReceivingID= "+ALLTRIM(STR(nReceivingID))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for POitem problems.",48,"Weird")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem '"+ThisForm.cPOitem+"' entered in ReceivingID= "+ALLTRIM(STR(nReceivingID))+", does not Exists!")
			ENDIF
		ENDIF
		IF Proper_SO_item(ThisForm.cSOitem) <> Proper_SO_item('')
			IF Count_SOIteminSales( ThisForm.cSOitem, ThisForm.nConnHandle )=0
				MESSAGEBOX("The SO item '"+ThisForm.cSOitem+"'"+CHR(13)+" entered in ReceivingID= "+ALLTRIM(STR(nReceivingID))+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for SOitem problems.",48,"Weird")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SO item '"+ThisForm.cSOitem+"' entered in ReceivingID= "+ALLTRIM(STR(nReceivingID))+", does not Exists!")
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE getid_d_p_txt
		*ThisForm.getid_d_p_txt()
		
		PRIVATE cTBL, nID_Master, nID_Detail, nID_Detail_PRC
		cTBL 		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		nID_Master = PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3)
		nID_Detail = PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
		nID_Detail_PRC = PrepareSQLnum(Thisform.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		
		IF USED('tmpStkHist')
			USE IN tmpStkHist
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT TOP 1 [Who],[What],[When],Heat "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.Ar_BrokerLst_Master_history WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.Ar_WIPLst_Master_History WITH(NOLOCK) "
		OTHERWISE
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History WITH(NOLOCK) "
		ENDCASE		
		cSQL = cSQL + " WHERE ID = "+STR(nID_Master)
		cSQL = cSQL + " order by [when] desc"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkHist')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkHist')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkHist")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkHist")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStkHist')
			RETURN
		ENDIF
		
		
		IF USED('tmpStkHist')
			IF RECCOUNT('tmpStkHist') > 0
				IF tmpStkHist.What = "DELETE"
					ThisForm.txtID_Detail_Process.Value = "Deleted "+TTOC(tmpStkHist.When)
					ThisForm.txtID_Detail_Process.FontBold = .T.
					ThisForm.txtID_Detail_Process.DisabledForeColor = RGB(255,0,0)
					*ThisForm.txtID_Detail_Process.Width = 102 &&Min
				ENDIF
			ENDIF
			
			USE IN tmpStkHist
		ENDIF
	ENDPROC

	PROCEDURE getpoitemdetail
		PARAMETERS pPOitem
		*ThisForm.GetPOitemDetail(cPOitem)
		
		*Check ThisForm.cPOitem and populated.
		IF Proper_PO_item(PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)) = Proper_PO_item(pPOitem)
			*Already ran GetPOitemDetail(cPOitem)
		*	WAIT WINDOW 'Re-run the get POitem' NOWAIT
		ENDIF
		IF NOT Proper_PO_item(PrepareSQLtxt(pPOitem,'POitem',12)) = Proper_PO_item('')
			*pPoitem has data, use it
			ThisForm.cPOitem = Proper_PO_item(pPOitem)
			*cPOitem = Proper_PO_item(pPOitem) Done later
		ELSE
		*	TrackError("Need PO Item","Need SO Item",PROGRAM(),LINENO(1) )
			MESSAGEBOX("Need PO Item",0,"getPoItemDetail()" )
			RETURN .F.
		ENDIF
		
		**********************************************
		**check POitem in all tables including History
		PRIVATE nItemPO, nHpaPo, cPOitem, nID_Detail, nID_Detail_Process, nID_D_P
		cPOitem = Proper_PO_Item(PrepareSQLtxt(ThisForm.cPOitem,'POitem',12))
		nItemPO = Proper_PO_Item_Item(cPOitem)
		nHpaPo	= Proper_PO_Item_PO(cPOitem)
		nID_Detail = 0
		nID_Detail_Process = 0
		nID_D_P = 0 
		
		PRIVATE nWO_Detail, nMess
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nMess = 0
		
		IF nHpaPo = 0
			MESSAGEBOX("No PO to show!",0,"No PO")
			RETURN .F.
		ENDIF
				
				
		*Check ThisForm.cHeat and populate
		IF NOT EMPTY(ThisForm.cHeat)
			ThisForm.txtHeat.Value = ThisForm.cHeat
		ENDIF
		
		PRIVATE nPOcnt 
		nPOcnt = 0
		
		IF nItemPo = 0
			*Guess at Item
			ThisForm.ChecknItemPO = 0
			nPOcnt = Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle )
			IF nPOcnt = 0
				MESSAGEBOX("Nothing to return for that PO"+CHR(13)+" POitem '"+cPOitem+"' not found!",0,"No PO items")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Nothing to return for that PO"+CHR(13)+" POitem '"+cPOitem+"' not found!")
				RETURN .F.
			ENDIF
			IF Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle, "METAL" ) = 0
				*Not for Stock!!!
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Receiving for POitem '"+cPOitem+"' but not for Stock!")
			ENDIF
			IF nPOcnt = 1
				*Must be only one
				nItemPo = GetMaxItemforPO( nHpaPo, ThisForm.nConnHandle )  &&nItemPO started as 0!
		
				ThisForm.txtHPAPOitem.Value = nItemPO
				ThisForm.ChecknItemPO = nItemPO
			ENDIF
			IF nPOcnt > 1
				*Show list of Item to Choose
				*PRIVATE cPoItem
				DO FORM Forms\ChoosePOitem WITH nHpaPo TO cPoItem
				IF TYPE("cPoItem") = "C"
					IF Proper_PO_Item(cPoItem) != Proper_PO_Item('')
						nItemPo = Proper_PO_Item_Item(cPOitem)
						ThisForm.txtHpaPOItem.Value = nItemPo
						ThisForm.ChecknItemPO = nItemPO
						ThisForm.cPOitem = cPOitem
					ELSE
						MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
						RETURN .F.
					ENDIF		
				ELSE
					MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		
		*****
		*Check for INCOMING Process or to EDIT old Receieve
		*
		PRIVATE lChoosePOstk, lDelHistPOstk, cHeat, cLot, cTBL, cTBLOld  
		lChoosePOstk = .F.
		lDelHistPOstk = .F.
		cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot  = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		cTBL = 'N'
		cTBLOld = ''
		PRIVATE nReceivingID, nEditReceivingID, lChecked_RcvID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'RID',-3)
		nEditReceivingID = 0
		IF ThisForm.lClone 
			nReceivingID = 0
		ENDIF
		lChecked_RcvID = (nReceivingID > 0)
		
		*IF ThisForm.lClone	--does Clone matter here? !!!
		
		*******************************************
		**Look to see if POitem can have Stock!
		* or if a WO_Detail should be used.
		
		PRIVATE nCntPOitem, cProcess_IDd  
		cProcess_ID = ''
		nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "NOT SERVICES CONVSERV EQUIPMENT" )
		
		IF nCntPOitem = 0
			IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "WORKORDER" ) > 0
				IF nWO_Detail > 0
					ThisForm.txtWO_Detail.Value = nWO_Detail 
					ThisForm.getBy_nWo_Detail(nWO_Detail)
					RETURN .T.
				ENDIF
				
				nWO_Detail = PrepareSQLnum( Get_From_POitem (cPOitem, "WO_Detail", ThisForm.nConnHandle ),"WO_Detail",-3)
				IF nWO_Detail > 0
					ThisForm.txtWO_Detail.Value = nWO_Detail 
					ThisForm.getBy_nWo_Detail(nWO_Detail)
					RETURN .T.	
				ENDIF
				
				nWO_Detail = getWOD_with_POitem( cPOitem, ThisForm.nConnHandle) 
				IF nWO_Detail > 0
					ThisForm.txtWO_Detail.Value = nWO_Detail 
					ThisForm.getBy_nWo_Detail(nWO_Detail)
					RETURN .T.	
				ENDIF
				
				IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "CONVSERV" ) > 0
					cMess = "This PO is for a Conversion Service"+CHR(13)
					cMess = cMess + "Please Enter the WO_Detail"+CHR(13)+"to receive to."
					MESSAGEBOX(cMess,48,"Need WO_Detail")
					ThisForm.txtWO_Detail.SetFocus
					RETURN .T.
				ENDIF
				
				*************
				
		*!*			IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "EQUIPMENT" ) > 0
		*!*				cMess = "This PO is for a Equipment"+CHR(13)
		*!*				cMess = cMess + "You do not need to enter data here"+CHR(13)+"Go back to first Receiving screen"+CHR(13)+" and mark as Complete."
		*!*			*	MESSAGEBOX(cMess,48,"This PO is for a Equipment") &&"Do not record here.")
		*!*			*	RETURN
		*!*			ENDIF
		*!*			IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "SERVICES" ) > 0
		*!*				cMess = "This PO is for a Service"+CHR(13)
		*!*				cMess = cMess + "You do not need to enter data here"+CHR(13)+"Go back to first Receiving screen"+CHR(13)+" and mark as Complete."
		*!*			*	MESSAGEBOX(cMess,48,"This PO is for a Service") &&"Do not record here.")
		*!*			*	RETURN .T.
		*!*			ENDIF
				
				cMess = "This POitem "+cPOItem+" is not to receive Metal"+CHR(13)+"Tried to find WO_Detail"
				IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "CONVSERV" ) > 0
					cMess = cMess +CHR(13)+"This PO is for a Conversion Service"
				ENDIF
				IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "SERVICES" ) > 0
					cMess = cMess +CHR(13)+"This PO is for a Service"+CHR(13)
				ENDIF
				IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "EQUIPMENT" ) > 0
					cMess = cMess +CHR(13)+"This PO is for a Equipment"+CHR(13)
				ENDIF
				
				MESSAGEBOX(cMess,16,"Not Metal")
				TrackError(cMess,"Receiving PO", PROGRAM(), LINENO(1))
				*RETURN .T.
				*ThisForm.getBy_nWO
			ENDIF
		ENDIF
		
		*Only for PO for Metal
		ThisForm.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisForm.nConnHandle ) 
		
		*******************************************
		**Look for Incomning Process, Received Heats
		PRIVATE lFoundHeatRecv 
		lFoundHeatRecv = .F.
		IF USED('tmpPO_ProcessCNT')
			USE IN 'tmpPO_ProcessCNT'
		ENDIF
		
		IF nReceivingID > 0
			*Count for ReceivingID on Stock! --This should not fire
			cSQL = " SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
			cSQL = cSQL + " SELECT TOP 1 "
			cSQL = cSQL + " ( SELECT Count(*) AS CNT "
			cSQL = cSQL + " FROM dbo.StockLst_Detail D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
			cSQL = cSQL + "  WHERE D.ReceivingID = "+STR(nReceivingID)+ "  ) AS CNT "
			cSQL = cSQL + ", 'S' AS TBL, M.Heat, M.Lot "
			cSQL = cSQL + " ,D.ID_Detail, '' AS Process_ID, 0 AS ID_Detail_Process "
			cSQL = cSQL + " FROM dbo.StockLst_Detail D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
			cSQL = cSQL + "  WHERE D.ReceivingID = "+STR(nReceivingID)
		
			cSQL = cSQL + " UNION "
			
			cSQL = cSQL + " SELECT TOP 1 "
			cSQL = cSQL + " (SELECT Count(*) AS CNT "
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Detail_History D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) ON D.ID = M.ID "
			cSQL = cSQL + "  WHERE D.ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' ) AS CNT "
			cSQL = cSQL + ", 'A' AS TBL, M.Heat, M.Lot "
			cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Detail_History D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) ON D.ID = M.ID "
			cSQL = cSQL + "  WHERE D.ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' "
			cSQL = cSQL + " ) t ORDER BY TBL, Heat, Lot "
			
		ELSE
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				*Count for that POitem Process on Stock!
				
				cSQL = " SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
				*Stock Master
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT"
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'S' AS TBL, M.Heat, M.Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				cSQL = cSQL + " UNION "
				*Stock History
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT "
				cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
				cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' AND M.[heat] != 'DUE IN'"
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + ", 'A' AS TBL, M.Heat, M.Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' AND M.[heat] != 'DUE IN'"
		
				cSQL = cSQL + " UNION "
				*Stock Process
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT "
				cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'S' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
				*LEFT OUTER ?
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
				
		
				cSQL = cSQL + " UNION "
				*Broker Master
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT"
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'B' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
		
				cSQL = cSQL + " UNION "
				*Broker Process
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT "
				cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'B' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
				cSQL = cSQL + " UNION "
				*WIP Master
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT"
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'W' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				cSQL = cSQL + " UNION "
				*WIP Process
				cSQL = cSQL + " SELECT TOP 1 "
				cSQL = cSQL + " (SELECT Count(*) AS CNT "
				cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
				cSQL = cSQL + "  ) AS CNT "
				cSQL = cSQL + " , 'W' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
				cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
				cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
				cSQL = cSQL + " UNION "
				*Recieving  --May need TOP 1
				cSQL = cSQL + " SELECT 1 AS CNT "
				cSQL = cSQL + " , 'R' AS TBL, ISNULL(R.Heat,'') AS Heat, ISNULL(R.Lot,'') AS Lot"
				cSQL = cSQL + " , ISNULL(R.ID_Detail,0) AS ID_Detail, '' AS Process_ID, 0 AS ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.Receiving R WITH(NOLOCK) "
				cSQL = cSQL + "  WHERE R.POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
				
			ENDIF
			*IF nWO_Detail > 0
				*This is a POitem method, do not check WO_Detail here
				*Count for that WO_Detail Process on Stock!
			*" SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
			*cSQL = cSQL + " ) t ORDER BY TBL, Heat, Lot "
			cSQL = cSQL + " ) t ORDER BY [Process_ID] DESC, Heat, Lot "
			
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_ProcessCNT')
		WAIT WINDOW 'TIMEOUT1' TIMEOUT 1
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 2
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_ProcessCNT' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_ProcessCNT")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 2
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_ProcessCNT")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			TrackError(cSQL,"Get POitem Detail, Bad Query", PROGRAM(), LINENO(1))
		
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_ProcessCNT' )	
		ENDIF
		
		IF USED('tmpPO_ProcessCNT')
			IF RECCOUNT('tmpPO_ProcessCNT') > 0
			
				PRIVATE cMess
				cMess = "Found many records"+CHR(13)+"you do not need to take action"+CHR(13)+"This could get messy:"+CHR(13)+CHR(13)
				
				SELECT tmpPO_ProcessCNT
				
				LOCATE FOR TBL = 'A'
				IF FOUND('tmpPO_ProcessCNT')
					lDelHistPOstk = .T.
					
					PRIVATE cHistHeat 
					cHistHeat = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
					IF NOT cHistHeat = "DUE IN"
						cMess = cMess + "Found '"+ALLTRIM(cHistHeat)+"' in Archive. "+CHR(13)
						cMess = cMess + "        The Archive data will not be used. "+CHR(13)
						DELETE FROM tmpPO_ProcessCNT WHERE Heat = cHistHeat 
					ENDIF
				ENDIF
				GO TOP
				
				PRIVATE cHeatNew,cLotNew, nID_DetailNew
				
				SCAN
					IF DELETED('tmpPO_ProcessCNT')
						LOOP
					ENDIF
					IF PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1) = "A"
						LOOP
					ENDIF
					IF tmpPO_ProcessCNT.CNT = 0
						LOOP
					ENDIF
					*IF NOT lChoosePOstk 
						IF PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1) = "R"
							*Found a Heat in Receiving and PO_item
							lFoundHeatRecv = .T.
					*		lChoosePOstk = .T.
							
							cHeatNew = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
							cLotNew	= PrepareSQLtxt(tmpPO_ProcessCNT.Lot,'Lot',10)
							nID_DetailNew = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail,'ID_Detail',-3)
							
							IF LEN(cHeat) > 0 AND LEN(cHeatNew) > 0 AND cHeat<>cHeatNew AND NOT cHeatNew = 'DUE IN' AND NOT cHeat = 'DUE IN' 
								cMess = cMess + "Found Heat '"+ALLTRIM(cHeatNew)+"' when looking for the Heat '"+cHeat+"'."+CHR(13)
								*MESSAGEBOX( "The Heat '"+cHeat+"' is being changed to '"+cHeatNew+"' ",48,"Could be a problem")
							ENDIF
							IF LEN(cHeatNew) > 0 AND NOT cHeatNew = 'DUE IN'
								cHeat = cHeatNew
							ENDIF
							
					*		MESSAGEBOX("Found POitem in Receiving 'R'"+CHR(13)+"Received Heat='"+cHeat+"'",64,"Found in Receiving")
							cMess = cMess + "Found '"+ALLTRIM(cHeat)+"', Lot '"+ALLTRIM(cLotNew)+"', ID_Detail="+ALLTRIM(STR(nID_DetailNew))+"' in Receiving. "+CHR(13)
							LOOP
						ENDIF
					*ENDIF
					
					
					*Found in S,B,W AND not in DELETED History
					cTBL = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
					IF LEN(cTBLOld) > 0
						IF cTBLOld <> cTBL
							cMess = cMess +CHR(13)+ "Found POitem in different tables:"+CHR(13)
							cMess = cMess + "Tables '"+cTBL+"' and '"+cTBLOld+"'"+CHR(13)
							cMess = cMess + "This is a weird, you could see incorrect data after this receive."+CHR(13)
							cMess = cMess + "Please double check stock after edit."+CHR(13)+CHR(13)
						ENDIF
					ENDIF
					cTBLOld = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
					IF cTBL = "S" OR cTBL = "B" OR cTBL = "W" 
						*lChoosePOstk = .T.
						cHeat = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
						cLot  = PrepareSQLtxt(tmpPO_ProcessCNT.Lot,'Lot',10)
						nID_Detail = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail,'ID_Detail',-3)
						
						cMess = cMess + "Found Heat '"+ALLTRIM(cHeat)+"', Lot '"+cLot+"' in Table '"+cTBL+"'. "+CHR(13)
						cProcess_ID = PrepareSQLtxt(tmpPO_ProcessCNT.Process_ID,'Process_ID',10)
						IF LEN(cProcess_ID) = 0
							cMess = cMess + "   without an Incoming Process_ID ."+CHR(13)
							nID_D_P = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
							IF nID_D_P > 0
								cMess = cMess + " nID_Detail_Process = "+ALLTRIM(STR(nID_D_P))+CHR(13)+CHR(13)
								IF nID_Detail_Process = 0
									nID_Detail_Process = nID_D_P
								ENDIF
							ENDIF
						ELSE
		
							cMess = cMess + "   with a Process_ID of '"+cProcess_ID+"'."+CHR(13)
							cMess = cMess + " nID_Detail = "+ALLTRIM(STR(nID_Detail))+CHR(13)
							IF cProcess_ID = "INCOMING"
								*Use this nID_Detail_Process !
								nID_Detail_Process = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
								cMess = cMess + "INCOMING nID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+CHR(13)+CHR(13)
							ENDIF
						ENDIF
					ENDIF
				
				ENDSCAN
				
				IF nID_Detail_Process = 0
					cMess = cMess + CHR(13)+"Did not find an Incoming Process to receive to!"+CHR(13)
				ELSE
					cMess = cMess + CHR(13)+"Using Incoming Process "+ALLTRIM(STR(nID_Detail_Process))+" to receive to!"+CHR(13)
					IF nID_D_P > 0
						cMess = cMess + CHR(13)+"Where did Process "+ALLTRIM(STR(nID_D_P))+" come from!?!"+CHR(13)
					ENDIF
				ENDIF
				
				PRIVATE lFoundHeatRecv 
				lFoundHeatRecv = .F.
		
				IF nID_Detail_Process > 0
					cMess = cMess + CHR(13)+"Incomming Process "+ALLTRIM(STR(nID_Detail_Process))+" will be choosen to be used."
				ENDIF
				cMess = cMess + CHR(13)+"You may get another screen"+CHR(13)+" where you can choose "+CHR(13)+"to EDIT a Certain Heat"
				
				IF ( NOT lFoundHeatRecv AND RECCOUNT('tmpPO_ProcessCNT') = 1 )
					MESSAGEBOX(cMess,48,"Found for POitem '"+cPOitem+"'")
					RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),cMess)
				ENDIF
				lChoosePOstk = .T.
			ENDIF
			USE IN tmpPO_ProcessCNT
		ENDIF
		
		**********
		PRIVATE nID_D_P, cProcTBL
		nID_D_P = 0
		cProcTBL = ''
		IF nID_Detail_Process > 0
			nID_D_P = nID_Detail_Process 
		ENDIF
		
		***
		IF nID_D_P = 0 AND NOT ThisForm.cWhat = "ADD"
			*Get Process ID with POitem ????
			IF lChoosePOstk 
				*IF Heat = 'Due In' - set lChoosePOstk = .F.		
				IF UPPER(cHeat) = UPPER("DUE IN") OR ( ThisForm.lblWhat.Caption = 'ADD' AND LEN(ThisForm.txtHeat.Value) = 0)
					lChoosePOstk = .F.
					*have not Heat
					*nEditReceivingID = 0
					*nID_D_P &&Could get the Process ID here
					
					IF USED('tmpCNT_Heat')
						USE IN 'tmpCNT_Heat'
					ENDIF
		
		
					cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
					cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
		
					DO CASE
					CASE cTBL = "S"
						cSQL = cSQL + ",'S' AS TBL "
						cSQL = cSQL + " FROM dbo.StockLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
					CASE cTBL = "B"
						cSQL = cSQL + ",'B' AS TBL "
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
					CASE cTBL = "W"
						cSQL = cSQL + ",'W' AS TBL "
						cSQL = cSQL + " FROM dbo.WIPLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
					ENDCASE		
					
					cSQL = cSQL + " WHERE M.Heat = 'DUE IN'"
					cSQL = cSQL + " AND M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_Heat')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_Heat')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCNT_Heat")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCNT_Heat")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCNT_Heat')
					ELSE
						IF USED('tmpCNT_Heat')
						
							IF RECCOUNT('tmpCNT_Heat') > 0
								nID_Detail 	= PrepareSQLnum(tmpCNT_Heat.ID_Detail,'ID_Detail',-3)
								cProcess_ID = PrepareSQLtxt(tmpCNT_Heat.Process_ID,'Process_ID',10)
								nID_D_P  	= PrepareSQLnum(tmpCNT_Heat.ID_Detail_Process ,'ID_Detail_Process',-3)
								cProcTBL 	= PrepareSQLtxt(tmpCNT_Heat.TBL,'TBL',1)
								
								IF PrepareSQLnum(tmpCNT_Heat.ReceivingID,'ReceivingID',-3) > 0
									nEditReceivingID = PrepareSQLnum(tmpCNT_Heat.ReceivingID,'ReceivingID',-3)
									*cProcess_ID
								ELSE
									nEditReceivingID = nReceivingID
								ENDIF
		*!*							IF RECCOUNT('tmpCNT_Heat') = 1
		*!*								*Run Choose to make sure the data is right
		*!*								lChoosePOstk = .T.
		*!*								*lChoosePOstk = .F.	&&Do not run Choose
		*!*							ELSE
		*!*								lChoosePOstk = .T.
		*!*							ENDIF
							ENDIF
							USE IN 'tmpCNT_Heat'
						ENDIF
					ENDIF
					
					
				ELSE && Have a Heat!!
				
					
					IF USED('tmpCNT_Heat')
						USE IN 'tmpCNT_Heat'
					ENDIF
		
					DO CASE
					CASE cTBL = "S"
						cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",'S' AS TBL "
						cSQL = cSQL + " FROM dbo.StockLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
					CASE cTBL = "B"
						cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",'B' AS TBL "
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
					CASE cTBL = "W"
						cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + ",'W' AS TBL "
						cSQL = cSQL + " FROM dbo.WIPLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
					CASE cTBL = "N"
						cSQL = "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + ",'S' AS TBL "
						cSQL = cSQL + " FROM dbo.StockLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
						
						cSQL = cSQL + " UNION "
						cSQL = cSQL + "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + ",'B' AS TBL "
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
						
						cSQL = cSQL + " UNION "
						cSQL = cSQL + "SELECT M.PO_item, D.ID_Detail ,ISNULL(P.Process_ID,'') AS Process_ID "
						cSQL = cSQL + " ,ISNULL(M.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + ",ISNULL(P.ReceivingID,0) AS ReceivingID, ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process"
						cSQL = cSQL + ",'W' AS TBL "
						cSQL = cSQL + " FROM dbo.WIPLst_Master M "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE M.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE M.Lot = '"+cLot+"'"	
						ENDIF
						
						cSQL = cSQL + " UNION "
						cSQL = cSQL + " SELECT R.POitem AS PO_item, R.ID_Detail ,'' AS Process_ID "
						cSQL = cSQL + " ,ISNULL(R.WO_Detail,0) AS WO_Detail "
						cSQL = cSQL + " ,ISNULL(R.ID,0) AS ReceivingID, 0 AS ID_Detail_Process ,R.StockTable AS TBL "
						cSQL = cSQL + " FROM dbo.Receiving R "
						cSQL = cSQL + " WHERE R.Heat = '"+cHeat+"'"	
						IF LEN(cLot)>0
							cSQL = cSQL + " WHERE R.Lot = '"+cLot+"'"	
						ENDIF
						cSQL = cSQL + " AND R.AcctFinish = 0 "
						
					ENDCASE			
								
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_Heat')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_Heat')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCNT_Heat")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCNT_Heat")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCNT_Heat')
					ELSE
						IF USED('tmpCNT_Heat')
							IF RECCOUNT('tmpCNT_Heat') > 0
							
								SELECT tmpCNT_Heat
								LOCATE FOR PO_Item = cPOitem
								
								IF FOUND('tmpCNT_Heat')
									*M.PO_item, 
									nID_Detail 	= PrepareSQLnum(tmpCNT_Heat.ID_Detail,'ID_Detail',-3)
									cProcess_ID = PrepareSQLtxt(tmpCNT_Heat.Process_ID,'Process_ID',10)
									*nReceivingID
									nID_D_P 	= PrepareSQLnum(tmpCNT_Heat.ID_Detail_Process ,'ID_Detail_Process',-3)
									cProcTBL 	= PrepareSQLtxt(tmpCNT_Heat.TBL,'TBL',1)
									
									IF PrepareSQLnum(tmpCNT_Heat.ReceivingID,'ReceivingID',-3) > 0
										nEditReceivingID = PrepareSQLnum(tmpCNT_Heat.ReceivingID,'ReceivingID',-3)
										*cProcess_ID
									ELSE
										nEditReceivingID = nReceivingID
									ENDIF
									
									IF RECCOUNT('tmpCNT_Heat') = 1
										*Run Choose to make sure the data is right
										lChoosePOstk = .T.
										*lChoosePOstk = .F.	&&Do not run Choose
									ELSE
										lChoosePOstk = .T.
									ENDIF
									
									IF cTBL = "N"
										cTBL = PrepareSQLtxt(tmpCNT_Heat.TBL,'TBL',1)
										IF LEN(cTBL) > 0
											IF cTBL = "N" 
												 cR_POitem = PrepareSQLtxt(tmpCNT_Heat.PO_item,'POitem',12)
												 nCount_POIteminPurchaseOrder = Count_POIteminPurchaseOrder( cR_POitem, ThisForm.nConnHandle, 'METAL' )
												 IF nCount_POIteminPurchaseOrder > 0
												 	IF Count_POIteminPurchaseOrder( cR_POitem, ThisForm.nConnHandle, 'BROKER' ) > 0
												 		cTBL = 'B'
												 	ELSE
												 		cTBL = 'S'
												 	ENDIF
			 										ThisForm.cTBL = cTBL
													ThisForm.txtTBL.Value = cTBL
												 ENDIF
												 nWO_Detail = PrepareSQLnum(tmpCNT_Heat.WO_Detail,'WO_Detail',-3) 
												 IF nWO_Detail > 0
												 	cTBL = 'S'
			 										ThisForm.cTBL = cTBL
													ThisForm.txtTBL.Value = cTBL
												 ENDIF
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
							USE IN 'tmpCNT_Heat'
						ENDIF
					ENDIF			
				
				ENDIF
			ENDIF
		ENDIF
		***
		***
		
		*nID_Detail = PrepareSQLnum(tmpCNT_Heat.ID_Detail,'ID_Detail',-3)
		********************
		IF nID_D_P = 0 AND NOT ThisForm.cWhat = "ADD"
			*Get ReceivingID without Process!
		
			*IF Heat = 'Due In' - set lChoosePOstk = .F.		
			IF UPPER(cHeat) = "DUE IN" OR ( ThisForm.lblWhat.Caption = 'ADD' AND LEN(ThisForm.txtHeat.Value) = 0)
				lChoosePOstk = .F.
				
				*nEditReceivingID = 0
				*nID_D_P - no process here
				
				IF USED('tmpCNT_Heat')
					USE IN 'tmpCNT_Heat'
				ENDIF
		
				cSQL = "SELECT D.ID_Detail, D.ReceivingID "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " FROM dbo.StockLst_Master M "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
				CASE cTBL = "B"
					cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
				CASE cTBL = "W"
					cSQL = cSQL + " FROM dbo.WIPLst_Master M "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON M.ID = D.ID "
				OTHERWISE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No cTBL, Try Stock")
					*cTBL not Found.
					*cTBL = 'N'       Try StockLst ?
					cSQL = cSQL + " FROM dbo.StockLst_Master M "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
				ENDCASE			
				
				cSQL = cSQL + " WHERE M.Heat = 'DUE IN'"
				cSQL = cSQL + " AND M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_Heat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_Heat')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCNT_Heat")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCNT_Heat")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCNT_Heat')
				ELSE
					IF USED('tmpCNT_Heat')
						IF RECCOUNT('tmpCNT_Heat') > 0
							nID_Detail = PrepareSQLnum(tmpCNT_Heat.ID_Detail,'ID_Detail',-3)
							nEditReceivingID = PrepareSQLnum(tmpCNT_Heat.ReceivingID,'RID',-3)
						ENDIF
						USE IN 'tmpCNT_Heat'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		******
		
		
		ThisForm.cTBL = cTBL
		IF nID_D_P = 0 AND NOT ThisForm.cWhat = "ADD"
			IF lChoosePOstk 
				*lDelHistPOstk 
				*nID_Detail_Process 
				
				*Show PO Process, choose EDIT of a heat or INCOMING, or ADD
				*-*write from so a POitem on stock can be choosen that has no ReceiveID !!!
				
				IF UPPER(cHeat) = "DUE IN" OR ( ThisForm.lblWhat.Caption = 'ADD' AND LEN(ThisForm.txtHeat.Value) = 0)
					*Do not look at dbo.Receiving for the nEditReceivingID
				ELSE
					*cTBL R is from Receiving Table
					IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
						IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
							cPOitem = Proper_PO_item(ThisForm.cPOitem)
						ENDIF
					ENDIF
					
					IF Proper_PO_item(cPOitem) <> Proper_PO_item('') 
					**** AND nEditReceivingID = 0
						DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, cTBL TO nEditReceivingID
					ENDIF
				ENDIF
				
				*return Receiving ID or ''
				DO CASE
				CASE VARTYPE(nEditReceivingID) = "C"
					*User Cancelled
					nEditReceivingID = 0
				CASE PrepareSQLnum(nEditReceivingID,'ReceivingID',-3) > 0
					*Edit this old Receive
					IF nReceivingID > 0 AND nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3) 
						*ReceivingID did not change
						nEditReceivingID = nReceivingID
						lChecked_RcvID = .T.
					ELSE
						IF nEditReceivingID > 0
							lChecked_RcvID = .T.
							ThisForm.txtReceivingID.Value = nEditReceivingID
							ThisForm.txtReceivingID.Refresh
							ThisForm.GetBy_ReceivingID()
						ENDIF
					ENDIF
				CASE PrepareSQLnum(nEditReceivingID,'ReceivingID',-3) < 0
					*Edit incoming Process
					lChecked_RcvID = .T.
					nID_D_P = -nEditReceivingID
					*Should TBL be returned? !!!
					IF nID_D_P = 1
						*Lost ID_Detail_Process!
						nID_D_P = 0
						nID_D_P = nID_Detail_Process 
					ENDIF
				CASE PrepareSQLnum(nEditReceivingID,'ReceivingID',-3) = 0
					lChecked_RcvID = .T.
				ENDCASE
			ENDIF	
		ENDIF
		
		**********************
		IF USED("tmpID_D_P")
			USE IN tmpID_D_P
		ENDIF
		cSQL = ''
		PRIVATE cMess
		IF nID_D_P > 0
			*nReceivingID
			DO CASE
			CASE cProcTBL = 'S'
				cMess = "The StockList is expecting this Receive."+CHR(13)
			CASE cProcTBL = 'B'
				cMess = "The BrokerList is expecting this Receive."+CHR(13)
			CASE cProcTBL = 'W'
				cMess = "The WIPList is expecting this Receive."+CHR(13)
			OTHERWISE
				cMess = "The system is expecting this Receive."+CHR(13)
			ENDCASE
			
			cMess = cMess +CHR(13)+ "Do you want to use this 'INCOMING' record?"+CHR(13)+"Answer 'No' to Edit an old receive."+CHR(13)
			IF cHeat <> "DUE IN"
				cMess = cMess + "Heat = "+cHeat+CHR(13)
			ENDIF
			IF ThisForm.lblWhat.Caption = 'ADD'
				cMess = cMess + CHR(13)+ "The program was to ADD a Receiving record,"+CHR(13)+"choose 'Yes' to Add the new receive"
			ELSE
				cMess = cMess + CHR(13)+ "This was to be an Edit, Choose 'No' to Edit"
			ENDIF
			nMess = MESSAGEBOX(cMess,4,"Receive Incoming?")
			IF nMess = 7	
				*NO - Do Not Add a Receiving
				nID_D_P = 0 
			ENDIF
		ENDIF
		
		IF nID_D_P > 0
			*bring in INCOMING/SELECTED Process by nID_D_P !!
		
			*ThisForm.txtReceivingID.Value = nReceivingID
			*ThisForm.txtReceivingID.refresh
			
			cSQL = "SELECT M.Alloy,M.Form,M.Heat,M.Lot,M.Specs, P.Prc_PCs, P.Comment, P.Pounds, P.QTY, P.Ordered_QTY "
			cSQL = cSQL + ", M.ID, D.ID_Detail, P.ID_Detail_Process"
			cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
			*cSQL = cSQL + ",dbo.f_Descript(M.Alloy,M.CC,M.Form,D.Dim1,D.Dim2,D.Dim3,D.S_QTY,D.RandLen ) AS Descript"
			cSQL = cSQL + ", dbo.f_DescriptionMetricReport(0, M.Form,D.Dim1,D.Dim2,D.Dim3, D.[Weight], D.RandLen, 0, '', '', '') AS Descript "
			cSQL = cSQL + ",(SELECT ISNULL(PO.Order_P,0) FROM dbo.PurchaseOrder PO WITH(NoLock) WHERE PO.POitem = P.PO_Item ) AS Order_P "
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + ",'S' AS TBL "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_D_P)
			CASE cTBL = "B"
				cSQL = cSQL + ",'B' AS TBL "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_D_P)
			CASE cTBL = "W"
				cSQL = cSQL + ",'W' AS TBL "
				cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_D_P)
			OTHERWISE
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No cTBL, Try Stock")
				*cSQL = "SELECT 1 "
				*cTBL not Found
				*cTBL = "S"   try StockLst
				cSQL = cSQL + ",'S' AS TBL "
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_D_P)
			ENDCASE
		ELSE
			IF nID_Detail > 0 AND NOT ThisForm.cWhat = "ADD"
				*bring in stock with ID_Detail
				**leads to errors if too many records
				cSQL = "SELECT M.Alloy,M.Form,M.Heat,M.Lot,M.Specs, D.PC AS Prc_PCs, '' AS Comment, D.Weight AS Pounds, D.S_QTY AS QTY, D.S_QTY AS Ordered_QTY "
				cSQL = cSQL + ", M.ID, D.ID_Detail, 0 AS ID_Detail_Process"
				cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
				*cSQL = cSQL + ",dbo.f_Descript(M.Alloy,M.CC,M.Form,D.Dim1,D.Dim2,D.Dim3,D.S_QTY,D.RandLen ) AS Descript"
				cSQL = cSQL + ", dbo.f_DescriptionMetricReport(0, M.Form,D.Dim1,D.Dim2,D.Dim3, D.[Weight], D.RandLen, 0, '', '', '') AS Descript "
				cSQL = cSQL + ",D.S_P AS Order_P "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + ",'S' AS TBL "
					cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
				CASE cTBL = "B"
					cSQL = cSQL + ",'B' AS TBL "
					cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
				CASE cTBL = "W"
					cSQL = cSQL + ",'W' AS TBL "
					cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
				OTHERWISE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No cTBL, Try Stock")
					cSQL = cSQL + ",'S' AS TBL "
					cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
				ENDCASE		
			ENDIF
		ENDIF
		
		IF LEN(cSQL) = 0 AND ThisForm.cWhat = "ADD"
			cSQL = "SELECT  Alloy,Form,'' AS Heat, '' AS Lot,Cond_Spec AS Specs,Pieces AS Prc_PCs, Misc_Purch AS Comment "
			cSQL = cSQL + ",Pounds, StockLst_QTY AS QTY, Order_QTY AS Ordered_QTY"
			cSQL = cSQL + ",0 AS ID, 0 AS ID_Detail, 0 AS ID_Detail_Process "
			cSQL = cSQL + ", StockLst_QTY AS S_QTY, StockLst_P AS S_P, StockLst_PU AS S_PU "
			cSQL = cSQL + ", dbo.f_DescriptionMetricReport(0, Form,Thck,Sz2,Sz3, Pounds, 0, 0, '', '', '') AS Descript "
			
			cSQL = cSQL + ",Order_P,TBL  "
		
			cSQL = cSQL + " FROM dbo.PurchaseOrder PO WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POitem ='"+cPOitem+"'"
		ENDIF
		
		SELECT 0  
		IF LEN(cSQL)>0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_D_P')
				RETURN .F.
			ENDIF
		ENDIF
			
		IF USED('tmpID_D_P')
			IF RECCOUNT('tmpID_D_P') = 0
				*Try Query with History
				cSQL = "SELECT M.Alloy,M.Form,M.Heat,M.Lot,M.Specs, P.Prc_PCs, P.Comment, P.Pounds, P.QTY, P.Ordered_QTY , M.ID, D.ID_Detail, P.ID_Detail_Process "
				cSQL = cSQL+", D.S_QTY, D.S_P, D.S_PU , dbo.f_DescriptionMetricReport(0, M.Form,D.Dim1,D.Dim2,D.Dim3, D.[Weight], D.RandLen, 0, '', '', '') AS Descript "
				cSQL = cSQL+" ,(SELECT ISNULL(PO.Order_P,0) FROM dbo.PurchaseOrder PO WITH(NoLock) WHERE PO.POitem = P.PO_Item ) AS Order_P "
				
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL+",'S' AS TBL  "
					cSQL = cSQL+" FROM dbo.Ar_StockLst_Process_History P WITH(NOLOCK) "
					cSQL = cSQL+" INNER JOIN dbo.Ar_Stocklst_Detail_History D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL+" INNER JOIN dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) ON D.ID = M.ID "
				CASE cTBL = "B"
					cSQL = cSQL+",'B' AS TBL  "
					cSQL = cSQL+" FROM dbo.Ar_BrokerLst_Process_History P WITH(NOLOCK) "
					cSQL = cSQL+" INNER JOIN dbo.Ar_BrokerLst_Detail_History D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL+" INNER JOIN dbo.Ar_BrokerLst_Master_history M WITH(NOLOCK) ON D.ID = M.ID "
				CASE cTBL = "W"
					cSQL = cSQL+",'W' AS TBL  "
					cSQL = cSQL+" FROM dbo.Ar_WIPLst_Process_History P WITH(NOLOCK) "
					cSQL = cSQL+" INNER JOIN dbo.Ar_WIPlst_Detail_History D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL+" INNER JOIN dbo.Ar_WIPLst_Master_History M WITH(NOLOCK) ON D.ID = M.ID "
				OTHERWISE 
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No cTBL, Try Stock" )
					
					cSQL = cSQL+",'S' AS TBL  "
					cSQL = cSQL+" FROM dbo.Ar_StockLst_Process_History P WITH(NOLOCK) "
					cSQL = cSQL+" INNER JOIN dbo.Ar_Stocklst_Detail_History D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL+" INNER JOIN dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) ON D.ID = M.ID "
				ENDCASE			
				
				cSQL = cSQL+" WHERE P.ID_Detail_Process = "+STR(nID_D_P)
				cSQL = cSQL+" AND P.[what]='DELETE'"
				cSQL = cSQL+" AND D.[what]='DELETE'"
				cSQL = cSQL+" AND M.[what]='DELETE'"
		
				*Second try with History
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_D_P')
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		
		
		****************
		IF USED('tmpID_D_P')
			IF RECCOUNT('tmpID_D_P') > 0
				IF VARTYPE(tmpID_D_P.Alloy) = "C"
					
					*ThisForm.txtWO.Value		= 0 &&PrepareSQLnum(tmpReceivingPOitem.WO,'WO',-3)
					*ThisForm.txtWO_Detail.Value	= 0 &&PrepareSQLnum(tmpReceivingPOitem.WO_Detail,'WO_Detail',-3)
					*ThisForm.txtReceived.Value = '' &&PrepareSQLDate(tmpReceivingPOitem.Received,'Received')
		
		
					*Show the POitem
					ThisForm.cPOitem 			= PrepareSQLtxt(cPOitem,'POitem',12)
					ThisForm.txtHpaPONum.Value 	= Proper_PO_Item_PO(ThisForm.cPOitem)
					ThisForm.txtHpaPOItem.Value = Proper_PO_Item_Item(ThisForm.cPOitem)
					
					*ThisForm.cSOitem			= PrepareSQLtxt(tmpReceivingPOitem.SOitem,'SOitem',10)
					*ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(ThisForm.cSOitem)
					*ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(ThisForm.cSOitem)
		
					ThisForm.ChecknHpaPO		= Proper_PO_Item_PO(ThisForm.cPOitem)
					ThisForm.ChecknItemPO		= Proper_PO_Item_Item(ThisForm.cPOitem)
					
					ThisForm.txtAlloy.Value 	= PrepareSQLtxt(tmpID_D_P.Alloy,'Alloy',12)
					ThisForm.txtHeat.Value		= ALLTRIM(ShowSQLtxt(tmpID_D_P.Heat,'Heat',50,.F.,.T.))
				 	ThisForm.txtLot.Value		= PrepareSQLtxt(tmpID_D_P.Lot,'Lot',10)
					
					ThisForm.txtPieces.Value	= PrepareSQLnum(tmpID_D_P.Prc_PCs,'Prc_PCs',-3)
					ThisForm.edtSpecs.Value 	= ALLTRIM(ShowSQLtxt(tmpID_D_P.Specs,'Specs',160))
					ThisForm.edtDescription.Value = ALLTRIM(ShowSQLtxt(tmpID_D_P.Descript,'Descript',-1))
						
					ThisForm.txtID_Master.Value	= PrepareSQLnum(tmpID_D_P.ID,'ID',-3)
					ThisForm.txtID_Detail.Value	= PrepareSQLnum(tmpID_D_P.ID_Detail,'ID_Detail',-3)
					Thisform.txtID_Detail_Process.Value	= PrepareSQLnum(tmpID_D_P.ID_Detail_Process,'ID_Detail_Process',-3)
					ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpID_D_P.TBL,'TBL',1)
					ThisForm.txtForm.Value		= PrepareSQLtxt(tmpID_D_P.Form,'Form',2)
					***
					ThisForm.chkCert.Value		= 0
					ThisForm.chkCofC.Value		= 0
					ThisForm.chkMillTrace.Value	= 0
					*ThisForm.edtSpecs.Value		= ''
					*ThisForm.edtComments.Value	= ''
					ThisForm.txtInit.Value		= ''
					ThisForm.txtDate.Value		= DTOC(DATE())
					ThisForm.chkPass.Value		= PrepareSQLlogic(0,'Pass')
					ThisForm.chkGoodPapers.Value= PrepareSQLlogic(0,'GoodPapers')
					
					ThisForm.txtActualW.Value	= PrepareSQLnum(tmpID_D_P.Pounds,'Pounds',9,1)
					ThisForm.txtBillW.Value		= PrepareSQLnum(tmpID_D_P.Pounds,'Pounds',9,1)
					
					PRIVATE nAcct_PU 
					nAcct_PU = PrepareSQLnum(tmpID_D_P.S_PU,'S_PU',-1)
					ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
					ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
					ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle)
					
					ThisForm.txtAcct_Qty.Value	= PrepareSQLnum(tmpID_D_P.S_QTY,'S_QTY',-5)
					ThisForm.txtAcct_P.Value	= PrepareSQLnum(tmpID_D_P.S_P,'S_P',-5)
					
		*			ThisForm.txtPO_QTY.Value 	= PrepareSQLnum( Calc_Vend_QTYleft_PO(ThisForm.cPOitem,ThisForm.nConnHandle),'PO_QTY',-5)
					ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(tmpID_D_P.S_QTY,'S_QTY',-5)
					ThisForm.txtPO_P.Value		= PrepareSQLnum( Get_From_POitem(ThisForm.cPOitem, "Order_P", ThisForm.nConnHandle ), 'Order_P',-5)
			
					PRIVATE nCust_PU 
					nCust_PU = PrepareSQLnum( Get_From_POitem(ThisForm.cPOitem, "Order_PU", ThisForm.nConnHandle ), 'Order_PU',-1) &&Cust PU
					ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
					ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisForm.nConnHandle)
					ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisForm.nConnHandle)
		
					ThisForm.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisForm.nConnHandle ) 
					
					ThisForm.txtRMA_No.Value	= 0
					ThisForm.txtRMA_Detail.Value= 0
					ThisForm.edtRejectReason.Value	= ''
					
					ThisForm.chkLab_Service.Value= PrepareSQLchk(0,'Services')
					ThisForm.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
					ThisForm.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
		
					*: Cannot call SetFocus from within a When, Valid, RangeHigh or RangeLow event.. 
					*ThisForm.txtAlloy.SetFocus()
					
					****************
					ThisForm.ShowPOitemType(cPOitem)
					****************
		
				ENDIF
			ELSE
				TrackError("nID_D_P = "+ALLTRIM(STR(nID_D_P))+" but no records."+CHR(13)+CHR(13)+cSQL,"No records", PROGRAM(), LINENO(1))
			ENDIF
			USE IN tmpID_D_P
		
		ENDIF
		
		IF nEditReceivingID > 0
			ThisForm.txtReceivingID.Value = nEditReceivingID	&&needed by GetBy_ReceivingID()
			
			ThisForm.GetBy_ReceivingID()		&&??
			
			RETURN .T.
		ENDIF
		
		IF nID_D_P > 0
			RETURN .T.
		ENDIF
		
		IF lChecked_RcvID 
			RETURN .T.
		ENDIF
		
		IF ThisForm.cWhat = "ADD"
			RETURN .T.
		ENDIF
		
		************************************************************************************************
		*Still here?
		**************
		
		IF USED('tmpPO_Process')
			USE IN 'tmpPO_Process'
		ENDIF
			
		IF nID_Detail > 0 AND ( cTBL='S' OR cTBL='B' OR cTBL='W' )
		
			cSQL = "SELECT D.ReceivingID, D.InvoiceValue, M.Heat,M.Lot,M.Form,M.Specs, 'S' AS TBL, M.PO_Item  "
			cSQL = cSQL + " ,D.WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.[Weight], M.ID, D.ID_Detail "
			cSQL = cSQL + " ,PO.SOitem"
		*, P.PO_Item AS PPOItem, P.DueDate, P.QTY, P.Pounds, P.ReceivingID AS PReceivingID,P.PU "
			cSQL = cSQL + " ,P.Process_ID "
			cSQL = cSQL + " ,D.S_QTY, D.S_P, D.S_PU "
			cSQL = cSQL + " ,PO.Order_QTY, PO.Order_P, PO.Order_PU, PO.Pounds "
			DO CASE
			CASE cTBL = 'S'
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = 'B'
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = 'W'
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			OTHERWISE
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No cTBL, Try Stock")
				
				cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
				
			ENDCASE
			cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON M.PO_item = PO.POitem "
			cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
			cSQL = cSQL + " AND D.ID_Detail = "+STR(nID_Detail)
			
		ELSE
			
			cSQL = "SELECT D.ReceivingID, D.InvoiceValue, M.Heat,M.Lot,M.Form,M.Specs, 'S' AS TBL, M.PO_Item  "
			cSQL = cSQL + " ,D.WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.Weight, M.ID, D.ID_Detail "
			cSQL = cSQL + " ,PO.SOitem"
		*, P.PO_Item AS PPOItem, P.DueDate, P.QTY, P.Pounds, P.ReceivingID AS PReceivingID,P.PU "
			cSQL = cSQL + ",P.Process_ID "
			cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
			cSQL = cSQL + ",PO.Order_QTY, PO.Order_P, PO.Order_PU, PO.Pounds "
		
			cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON M.PO_item = PO.POitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE ( M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
			cSQL = cSQL + " OR P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') )"
			cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
			
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT D.ReceivingID, D.InvoiceValue, M.Heat,M.Lot,M.Form,M.Specs, 'B' AS TBL, M.PO_Item "
			cSQL = cSQL + " ,0 AS WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.[Weight], M.ID, D.ID_Detail "
			cSQL = cSQL + " ,PO.SOitem"
		*, P.PO_Item AS PPOitem, P.DueDate, P.QTY, P.Pounds, P.ReceivingID AS PReceivingID,P.PU "
			cSQL = cSQL + ",P.Process_ID "
			cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
			cSQL = cSQL + ",PO.Order_QTY, PO.Order_P, PO.Order_PU, PO.Pounds"
			
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON M.PO_item = PO.POitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE ( M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
			cSQL = cSQL + " OR  P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') )"
			cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
			
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT D.ReceivingID, D.InvoiceValue, M.Heat,M.Lot,M.Form,M.Specs, 'W' AS TBL, M.PO_Item "
			cSQL = cSQL + " ,0 AS WO, M.WO_Detail, M.Alloy, D.PC, D.Descript, M.Specs, D.[Weight], M.ID, D.ID_Detail "
			cSQL = cSQL + " ,PO.SOitem"
		*, P.PO_Item AS PPOitem, P.DueDate, P.QTY, P.Pounds, P.ReceivingID AS PReceivingID,P.PU "
			cSQL = cSQL + ",P.Process_ID "
			cSQL = cSQL + ", D.S_QTY, D.S_P, D.S_PU "
			cSQL = cSQL + ",PO.Order_QTY, PO.Order_P, PO.Order_PU, PO.Pounds"
				
			cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
			cSQL = cSQL + " INNER JOIN dbo.PurchaseOrder PO WITH(NOLOCK) ON M.PO_item = PO.POitem "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE ( M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
			cSQL = cSQL + " OR P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') ) "
			cSQL = cSQL + " AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
			cSQL = cSQL + " ORDER BY P.Process_ID "
			
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_Process' )
		ENDIF
		
		**
		PRIVATE nMess 
		nMess = 6
		*PRIVATE cHeat
		cHeat = ''
		
		IF USED('tmpPO_Process')
			IF RECCOUNT('tmpPO_Process') > 0
				PRIVATE nRecCount, nRecNum, nMess
				nRecCount = RECCOUNT('tmpPO_Process')
				PRIVATE nInvoiceValue, cTBL
				PRIVATE cPO_Item, cSOitem, nPounds, nS_QTY
				*, cPPOItem, dDueDate, cProcess_ID
				cHeat = '*'
				SCAN
					IF ThisForm.lClone 
						nReceivingID 	= 0
						nInvoiceValue	= 0
						*cHeat		 	= '*'   &&This is the Heat of the Process!
					ELSE
						nReceivingID	= PrepareSQLnum(tmpPO_Process.ReceivingID,'ReceivingID',-3)
						IF nReceivingID > 0
							PRIVATE cMess, nNum
							nNum = 4+32
							cMess = "Found a record with that PO item"+CHR(13)
							cMess = cMess + "POitem '"+cPOitem+"'"+CHR(13)
							cMess = cMess + "Receiving ID = "+ALLTRIM(STR(nReceivingID))+CHR(13)
							
							cHeatMess = "Heat "+ALLTRIM(PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50))
							IF LEN(PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)) > 0
								cHeatMess = cHeatMess + "/Lot "+PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)
							ENDIF
							IF LEN(cHeatMess )> 8
								cMess = cMess +CHR(13)+cHeatMess +CHR(13)+CHR(13)
							ENDIF
							cMess = cMess +"Answer (Y) to edit this Receive ID."+CHR(13)
							IF ThisForm.cWhat = "ADD"
								cMess = cMess + "But, this was to be an Add, not an Edit."+CHR(13)
								nNum = 4+32+256
							ENDIF
							IF RECNO('tmpPO_Process') < RECCOUNT('tmpPO_Process')
								cMess = cMess+CHR(13)+ "Record "+ALLTRIM(STR(RECNO('tmpPO_Process')))+" of "+ALLTRIM(STR(RECCOUNT('tmpPO_Process')))+" Records."
								cMess = cMess+CHR(13)+"Answer (N) to see next Heat/Lot."
							ELSE
								cMess = cMess+CHR(13)+"Answer (N) to ADD another Heat/Lot."
							ENDIF
							
							nMess = MESSAGEBOX(cMess,nNum,"Edit this Heat/Lot?")
							IF nMess = 6
								nInvoiceValue	= PrepareSQLnum(tmpPO_Process.InvoiceValue,'InvoiceValue',-5)
								cHeat			= PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50)
								cLot 			= PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)
							ELSE
								nReceivingID 	= 0
								nInvoiceValue	= 0
								cHeat			= '*'   &&This is the Heat of the Process!
								
							ENDIF
						ELSE
							nReceivingID	= 0
							nInvoiceValue	= 0
							*cHeat			= '*'   &&This is the Heat of the Process!
							
							IF RECCOUNT('tmpPO_Process') = 1 AND PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50) = "DUE IN"
								nMess = 0
							ELSE
								IF NOT PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50) = "DUE IN"
									cMess = "Found a PO Process record with that PO item"+CHR(13)
									cMess = cMess + "POitem '"+cPOitem+"'"+CHR(13)
									cMess = cMess + "Receiving ID = "+ALLTRIM(STR(nReceivingID))+CHR(13)
									
									cHeatMess = "Heat "+ALLTRIM(PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50))
									IF LEN(PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)) > 0
										cHeatMess = cHeatMess + "/Lot "+PrepareSQLtxt(tmpPO_Process.Lot,'Lot',10)
									ENDIF
									IF LEN(cHeatMess )> 8
										cMess = cMess +CHR(13)+cHeatMess +CHR(13)+CHR(13)
									ENDIF
									
									IF LEN(cHeatMess )>6
										cMess = cMess +CHR(13)+cHeatMess +CHR(13)+CHR(13)
										cMess = cMess +CHR(13)+"Will default to this Heat/Lot."
									ENDIF
									
									cMess = cMess+CHR(13)+ "Record "+ALLTRIM(STR(RECNO('tmpPO_Process')))+" of "+ALLTRIM(STR(RECCOUNT('tmpPO_Process')))+" Records."
									cMess = cMess+CHR(13)+ "No INCOMING POitem Process."
									cMess = cMess+CHR(13)+CHR(13)+ "Last Status info screen."
									nMess = MESSAGEBOX(cMess,0+64,"No INCOMING POitem Process!")
									nMess = 0
								ENDIF
							ENDIF
						ENDIF					
					ENDIF
					
					cTBL		= PrepareSQLtxt(tmpPO_Process.TBL,'TBL',1)
					cPO_Item	= PrepareSQLtxt(tmpPO_Process.PO_Item,'PO_Item',12)
					cSOitem		= PrepareSQLtxt(tmpPO_Process.SOitem,'SOitem',10)
					*cPPOItem	= PrepareSQLtxt(tmpPO_Process.PPOItem,'POItem',12)
					*dDueDate	= PrepareSQLdate(tmpPO_Process.DueDate,'DueDate')
					*cProcess_ID	= PrepareSQLtxt(tmpPO_Process.Process_ID,'Process_ID',10)
					nPounds		= PrepareSQLnum(tmpPO_Process.Pounds,'Pounds',9,1)
					nS_QTY		= PrepareSQLnum(tmpPO_Process.S_QTY,'QTY',-5)
					*nEditReceivingID	= PrepareSQLnum(tmpPO_Process.PReceivingID,'ReceivingID',-3)
					nRecNum		= RECNO('tmpPO_Process')
					nID_Detail	= PrepareSQLnum(tmpPO_Process.ID_Detail,'ID_Detail',-3)
					
		*!*					*Find best POitem
		*!*					IF Proper_PO_item(cPPOItem) != Proper_PO_item('')
		*!*						IF Proper_PO_item(cPO_item) != Proper_PO_item('')
		*!*							cPOitem = cPPOItem
		*!*						ELSE
		*!*							cPOitem = cPO_item
		*!*						ENDIF
		*!*					ELSE
		*!*						IF Proper_PO_item(cPO_item) != Proper_PO_item('')
		*!*							cPOitem = cPO_item
		*!*						ELSE
		*!*							*cPOitem = ''
		*!*						ENDIF
		*!*					ENDIF
		
					IF nRecCount = 1
						*Only 1 Record found
						DO CASE
						CASE nReceivingID = 0
							IF LEN(cHeat)=0 OR cHeat = '*' 
								* No need to Ask, just use this one record.
								IF cProcess_ID = "SELECTED"
									*cProcess_ID = "INCOMING" "NOT2HPA" "PARTRECV"
								ELSE
									nMess = 6
								ENDIF
							ELSE
								IF cHeat = 'DUE IN'
									IF UPPER(cProcess_ID) = "INCOMING"
										nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "NOT2HPA"
										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
									IF UPPER(cProcess_ID) = "PARTRECV"
										nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
								ENDIF
							ENDIF
		*!*						CASE nEditReceivingID = 0
		*!*							IF EMPTY(cHeat) OR cHeat = '*'
		*!*								IF UPPER(cProcess_ID) = "INCOMING"
		*!*									nMess = MESSAGEBOX("Is this the 'INCOMING' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*								ENDIF
		*!*								IF UPPER(cProcess_ID) = "NOT2HPA"
		*!*									nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*								ENDIF
		*!*								IF UPPER(cProcess_ID) = "PARTRECV"
		*!*									nMess = MESSAGEBOX("Is this the 'PARTRECV' record what you need to Receive?"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
		*!*								ENDIF
