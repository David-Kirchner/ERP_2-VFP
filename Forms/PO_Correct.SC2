							IF NOT EMPTY(ThisForm.cHeat)
								* ThisForm.cHeat was passed in as a Parameter.
							ELSE
								ThisForm.txtHeat.Value		= PrepareSQLtxt(tmpPO_Process.Heat,'Heat',50)
							ENDIF
