	PROCEDURE cmbStock.AddItem
		LPARAMETERS cItem
		*All for Stock,Mostly Stock,Some Stock,No Stock,Not 2 HPA
	ENDPROC

	PROCEDURE cmbStock.Valid
		*All for Stock,Mostly Stock,Some Stock,No Stock,Not 2 HPA
		
		PRIVATE cStockType, lNeedSO
		cStockType = PrepareSQLtxt(This.Value,'Stock',13)
		
		DO CASE 
		CASE cStockType = "All for Stock"
			lNeedSO = .F.
		CASE cStockType = "Mostly Stock"
			lNeedSO = .T.
		CASE cStockType = "Some Stock"
			lNeedSO = .T.
		CASE cStockType = "No Stock"
			lNeedSO = .T.
		CASE cStockType = "DO NOT Stock"
			lNeedSO = .T.
		OTHERWISE
			lNeedSO = .F.
		ENDCASE
		
		IF lNeedSO 
			IF PrepareSQLnum(ThisForm.SalesNum,'Salesnum',-3) > 0
				IF PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSalesnum.Value,'Salesnum',-3) = 0
					ThisForm.pgfPO.pgPODesc.txtSalesnum.Value = ThisForm.SalesNum
				ENDIF
			ENDIF
			
			IF PrepareSQLnum(ThisForm.ItemNumber,'ItemNumber',2,0) > 0
				IF PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtItem.Value,'ItemNumber',2,0) = 0
					ThisForm.pgfPO.pgPODesc.txtItem.Value = ThisForm.ItemNumber
				ENDIF
			ENDIF
			
		ELSE
			PRIVATE nSalesNum
			nSalesNum = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSalesnum.Value,'Salesnum',-3)
			IF nSalesNum > 0
				IF MESSAGEBOX("If you do not have a customer,"+CHR(13)+"then you do not need the Customer Sales Number!"+CHR(13)+" Press (Y) to remove the SO:"+ALLTRIM(STR(nSalesNum)),4+48,"Remove SalesNum from PO?") = 6
					ThisForm.pgfPO.pgPODesc.txtSalesnum.Value = 0
					ThisForm.pgfPO.pgPODesc.txtItem.Value = 0
		*			ThisForm.ItemNumber = 0
		*			ThisForm.SalesNum = 0
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdAbort.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdAdd.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		lReady2Save = ThisForm.CheckSave()
		
		IF lReady2Save
			IF nReceivingID = 0
				IF ThisForm.SaveAdd("ADD")
					*--DO FORM Forms\ShowReceived_Ordered
					*--DO FORM Forms\Recv_Stock 
					
					ThisForm.Release
				ELSE
					RETURN .F.
				ENDIF
			ELSE
				IF ThisForm.SaveAdd("EDIT")
					ThisForm.Release
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			RETURN .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE lblActualLbs.Click
		PRIVATE nActualW, nAcct_PU, nPO_PU, nWO_Detail
		nActualW = PrepareSQLnum(ThisForm.txtActualW.Value,'Actual',9,1)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF nActualW > 0
			nAcct_PU = PrepareSQLnum(ThisForm.lblAcct_PU.Caption,'PU',-1)
			
			IF nAcct_PU = 0 AND nWO_Detail > 0
				nAcct_PU = 1
				ThisForm.lblAcct_PU.Caption = '1'
				ThisForm.lblAcct_PUstr.Caption	 = Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
				ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle )
		
		
				ThisForm.lblPO_PU.Caption = '1'
				ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle )
		
			ENDIF
		
			IF nAcct_PU = 1
				ThisForm.txtAcct_Qty.Value = nActualW 
				IF nWO_Detail > 0
		
					ThisForm.txtPO_QTY.Value = nActualW 
				ENDIF
			ENDIF
			
			nPO_PU	= PrepareSQLnum(ThisForm.lblPO_PU.Caption,'PU',-1)
			IF nPO_PU = 1
				ThisForm.txtPO_QTY.Value = nActualW 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE lblDate.Click
		*ThisForm.txtDate.Value = DATE()
		
		PRIVATE dDate1,dDate2
		
		dDate1 = PrepareSQLdate(ThisForm.txtDate.Value,'DueDate',.F.,.T.)
		
		DO FORM "forms\popupdate.scx" WITH dDate1, 'Due Date', ThisForm.txtDate.Top, ThisForm.txtDate.Left TO dDate2
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		dDate2 = PrepareSQLdate(dDate2,'DueDate',.F.,.T.)
		
		ThisForm.txtDate.Value = dDate2
		ThisForm.txtDate.Refresh
	ENDPROC

