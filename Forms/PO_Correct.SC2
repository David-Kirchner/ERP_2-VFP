						ThisForm.edtComments.Value 	= ''
						
						*ThisForm.txtInit.Value		= tmpPO_Process.Init
						ThisForm.txtInit.Value		= ''
						
						*ThisForm.txtDate.Value		= DTOC(tmpPO_Process.Date)
						ThisForm.txtDate.Value 		= PrepareSQLDate(DATE(),'DATE')
						
						*ThisForm.chkPass.Value		= IIF(tmpPO_Process.Pass,1,0)
						ThisForm.chkPass.Value		= PrepareSQLlogic(0,'Pass')
						
						*ThisForm.chkGoodPapers.Value = IIF(tmpPO_Process.GoodPapers,1,0)
						ThisForm.chkGoodPapers.Value = PrepareSQLlogic(0,'GoodPapers')
						
						*ThisForm.txtActualW.Value	= PrepareSQLnum(tmpPO_Process.S_QTY,'S_QTY',-5)
						ThisForm.txtActualW.Value	= PrepareSQLnum(tmpPO_Process.Weight,'Weight',9,1)
						ThisForm.txtBillW.Value		= PrepareSQLnum(tmpPO_Process.Weight,'Weight',9,1)
						
						ThisForm.txtAcct_Qty.Value		= PrepareSQLnum(tmpPO_Process.S_QTY,'S_QTY',-5)
						ThisForm.txtAcct_P.Value		= PrepareSQLnum(tmpPO_Process.S_P,'S_P',-5)
						
						PRIVATE nAcct_PU 
						nAcct_PU = PrepareSQLnum(tmpPO_Process.S_PU,'S_PU',-1)			
						ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
						ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
						ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisForm.nConnHandle)
		*	
						ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(tmpPO_Process.Order_QTY,'PO_QTY',-5)
						ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpPO_Process.Order_P,'Order_P',-5)
		*						
						PRIVATE nCust_PU 
						nCust_PU = PrepareSQLnum(tmpPO_Process.Order_PU,'Order_PU',-1)
						ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
						ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisForm.nConnHandle)	&&Customer PU
						ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisForm.nConnHandle)
						
						
						*ThisForm.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisForm.nConnHandle ) 
						*ThisForm.txtVendor.Value = PrepareSQLtxt(tmpReceivingPOitem.Vendor,'Vendor',30,.F.,.T.)
						ThisForm.txtVendor.Value	= ''   &&Company is filled in with the next PurchaseOrder Select
						
						*ThisForm.edtRejectReason.Value	= tmpPO_Process.RejectReason
						ThisForm.edtRejectReason.Value	= ''
						
						*ThisForm.txtRMA_No.Value		= tmpPO_Process.RMA_No
						ThisForm.txtRMA_No.Value		= 0
						ThisForm.txtRMA_Detail.Value	= 0
		
						ThisForm.chkLab_Service.Value= PrepareSQLchk(0,'Services')
						ThisForm.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
						ThisForm.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
						
						*ThisForm.StockLst_TBL		= PrepareSQLtxt(tmpPO_Process.TBL,'TBL',1)
						
						EXIT  &&SCAN
					ENDIF
				ENDSCAN
			ENDIF
			USE IN tmpPO_Process
		ENDIF
		
		
		******************************************************
		*------------------------------------------------------
		******************************************************
		
		IF EMPTY(ThisForm.edtDescription.Value) AND EMPTY(ThisForm.edtSpecs.Value)
		
			*Past the Receive and INCOMING checks - just find data by POitem
			***Look at PurchaseOrder to back fill data 
			*--ThisForm.frmReceiving-Not PO RecvStock
		
			PRIVATE cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, cLot, lRandLen, cDispAlloy, nStandSize, cMisc_purch
			PRIVATE nSalesNum, nItemSo, cDescription, nWeight
			PRIVATE cSOitem, cHeatCurr
		
			IF USED('tmpPOp')
				USE IN tmpPOp
			ENDIF
		
			cSQL = "SELECT * "
			cSQL = cSQl + ",dbo.f_Descript(Alloy,CC,Form,Thck,Sz2,Sz3,Order_QTY,RandLen ) AS Descript"
			cSQL = cSQl + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQl + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
			ENDIF
		
			IF USED('tmpPOp')
				IF RECCOUNT('tmpPOp') > 0
					*get PO Item data
					ThisForm.txtHPAPOItem.Value = PrepareSQLnum(tmpPOp.ItemPO,'ItemPO',2)
					ThisForm.cPOitem		=  cPOitem
					ThisForm.txtHPAPONum.Value = VAL(cPOitem)
					ThisForm.ChecknItemPO	= ThisForm.txtHPAPOItem.Value
					ThisForm.ChecknHPApo	= VAL(cPOitem)
					
					cSOitem = Proper_SO_Item(tmpPOp.SOitem)
					*********************************
					*Do not Add SOitem automatic, make use enter correct one- could be mutiple!!!
		*!*				IF !EMPTY(cSOitem) AND Proper_SO_Item(cSOitem) != Proper_SO_Item('')
		*!*				
		*!*					IF Count_SOIteminSales(cSOitem, ThisForm.nConnHandle ) > 0
		*!*						IF Count_SOIteminSales(cSOitem, ThisForm.nConnHandle, "CANCEL") < 1
		*!*							*Do not use if Cancelled
		*!*							ThisForm.cSOitem			= PrepareSQLtxt(tmpPOp.SOitem,'SOitem',10)
		*!*							ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(ThisForm.cSOitem)
		*!*							ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(ThisForm.cSOitem)
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
					
					*
					*Only ask only if a Service or Conv or Service PO ??? removed 01/16/19
					*IF PO_POitem_Cnt( cPOitem, ThisForm.nConnHandle, 'SERVICECONVSERV' ) > 0 removed 01/16/19
						cCompany = PrepareSQLtxt(tmpPOp.Company,'Company',30)
						IF !EMPTY(cCompany)
							IF !EMPTY(ThisForm.txtVendor.Value)
								IF ALLTRIM(UPPER(get_NoNoiseName(ThisForm.txtVendor.Value,ThisForm.nConnHandle))) != ALLTRIM(UPPER(get_NoNoiseName(cCompany,ThisForm.nConnHandle)))
			*						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Vendor '"+ALLTRIM(ThisForm.txtVendor.Value)+"' with '"+Alltrim(cCompany)+"?"+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Vendor listed differently.") = 6
										ThisForm.txtVendor.Value = cCompany
			*						ENDIF
								ENDIF
							ELSE
								ThisForm.txtVendor.Value = ALLTRIM(ShowSQLtxt(cCompany,'Company',30))
							ENDIF
						ENDIF
					*ENDIF
					*
					cAlloy = PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
					IF !EMPTY(cAlloy)
						IF !EMPTY(ThisForm.txtAlloy.Value)
							IF ThisForm.txtAlloy.Value != cAlloy
								IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Alloy '"+ALLTRIM(ThisForm.txtAlloy.Value)+"' with '"+Alltrim(cAlloy)+"?"+CHR(13)+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Alloy listed differently.") = 6
									ThisForm.txtAlloy.Value = cAlloy
								ENDIF
							ENDIF
						ELSE
							ThisForm.txtAlloy.Value = cAlloy
						ENDIF
					ENDIF
					*
					cForm = PrepareSQLtxt(tmpPOp.Form,'form',2)
					ThisForm.txtForm.Value = cForm
					
					nPieces = PrepareSQLnum(tmpPOp.Pieces,'Pieces',11,3)
					IF nPieces > 0
						IF !EMPTY(ThisForm.txtPieces.Value)
							IF ROUND(ThisForm.txtPieces.Value,0) != ROUND(nPieces,0)
								IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Pieces '"+ALLTRIM(STR(ThisForm.txtPieces.Value))+"'"+CHR(13)+"with the Complate PO count of'"+Alltrim(STR(nPieces))+"?"+CHR(13)+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Pieces listed differently.") = 6
									ThisForm.txtPieces.Value = nPieces
								ENDIF
							ENDIF
						ELSE
							ThisForm.txtPieces.Value = nPieces
						ENDIF
					ENDIF
					*
					nThck = PrepareSQLnum(tmpPOp.Thck,'Thck',10,4)
					nSz2 = PrepareSQLnum(tmpPOp.Sz2,'Sz2',10,3)
					nSz3 = PrepareSQLnum(tmpPOp.Sz3,'Sz3',10,3)
					cCond_Spec = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-1)
					IF !EMPTY(cCond_Spec)
						IF !EMPTY(ThisForm.edtSpecs.Value)
							IF NOT ALLTRIM(UPPER(ThisForm.edtSpecs.Value)) == ALLTRIM(UPPER(cCond_Spec))
								IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Specs '"+ALLTRIM(ThisForm.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cCond_Spec)+"?"+CHR(13)+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Specs listed differently.") = 6
									ThisForm.edtSpecs.Value = cCond_Spec
								ENDIF
							ENDIF
						ELSE
							ThisForm.edtSpecs.Value = cCond_Spec
						ENDIF
					ENDIF
					*
			*!*			cHeat = PrepareSQLtxt(tmpPOp.Heat,'Heat',40)
			*!*			IF !EMPTY(cHeat)
			*!*				IF !EMPTY( ALLTRIM(ThisForm.txtHeat.Value ))
			*!*					*IF ALLTRIM(UPPER(ThisForm.txtHeat.Value)) != ALLTRIM(UPPER(cHeat))
			*!*					
			*!*						*CHOOSE Receiving Details if different heat
			*!*		
			*!*					*ENDIF
			*!*				ELSE
			*!*					ThisForm.txtHeat.Value = cHeat
			*!*				ENDIF
			*!*			ENDIF
					*
					lRandLen = PrepareSQLlogic(tmpPOp.RandLen,'RandLen')
					nStandSize = PrepareSQLnum(tmpPOp.StandSize,'StandSize',10,4)
					**
				
					*FormUnitPrice('10') FormUnitCaption('10')
					PRIVATE cPriceUnit
					cPriceUnit = FormUnitPrice(cForm)
					
					PRIVATE nStockLst_Qty
					nStockLst_Qty	= PrepareSQLnum(tmpPOp.StockLst_Qty,'StockLst_QTY',-5)
					PRIVATE nBillW
					nBillW			= PrepareSQLnum(ThisForm.txtBillW.Value,'BillW',-5)
					IF nStockLst_Qty > 0
						IF nBillW > 0
							IF ROUND(nBillW,-1) != ROUND(nStockLst_Qty,-1)
								IF ThisForm.cWhat = "ADD"
									*no need to ask on ADD.
									nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
									ThisForm.txtBillW.Value = nStockLst_Qty
								ELSE
									IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(nBillW))+"'"+CHR(13)+" with '"+Alltrim(STR(nStockLst_Qty))+"' ?"+CHR(13)+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Bill Weight listed differently.") = 6
										ThisForm.txtBillW.Value = nStockLst_Qty
									ELSE 
										nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
									ENDIF
								ENDIF
							ENDIF
						ELSE
							ThisForm.txtBillW.Value = nStockLst_Qty
						ENDIF
					ENDIF
					*
					PRIVATE nPounds 
					nPounds = PrepareSQLnum(tmpPOp.Pounds,'Pounds',9,1)
					IF nPounds > 0
						IF cPriceUnit = "LB"
							IF nBillW > 0
								IF ROUND(nBillW,-1) != ROUND(nPounds,-1)
									IF ThisForm.cWhat = "ADD"
										*no need to ask on ADD.
										nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
										ThisForm.txtBillW.Value = nStockLst_Qty
									ELSE
										IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(nBillW))+"'"+CHR(13)+" with '"+Alltrim(STR(nPounds))+"?"+CHR(13)+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Bill Weight listed differently.") = 6
											ThisForm.txtBillW.Value = nPounds
										ENDIF
									ENDIF
								ENDIF
							ELSE
								ThisForm.txtBillW.Value = nPounds
							ENDIF
						ENDIF
					ENDIF
					*
					*	
					ThisForm.txtAcct_Qty.Value	= PrepareSQLnum(tmpPOp.StockLst_QTY,'S_QTY',-5)
					ThisForm.txtAcct_P.Value	= PrepareSQLnum(tmpPOp.StockLst_P,'S_P',-5)
					
					PRIVATE nAcct_PU 
					nAcct_PU = PrepareSQLnum( nPU_Acct_Form( Get_From_POitem(tmpPOp.POitem, "Form", ThisForm.nConnHandle ), ThisForm.nConnHandle ),'PU',-1 )
					ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
					ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU( nAcct_PU, ThisForm.nConnHandle)
					ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle)
			*
					ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(tmpPOp.Order_QTY,'PO_QTY',-5)
					ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpPOp.Order_P,'Order_P',-5)
					IF EMPTY(ThisForm.txtPO_P.Value)
						ThisForm.txtPO_P.Value = Get_From_POitem(cPOitem, "Order_P", ThisForm.nConnHandle )
					ENDIF
					
					PRIVATE nCust_PU 
					nCust_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
					ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
					ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisForm.nConnHandle)
					ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisForm.nConnHandle)
					*
					PRIVATE nOrder_PU
					nOrder_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
					IF nOrder_PU = 0
						*Fix Old data
						nOrder_PU = GetPUfromForm( cForm, ThisForm.nConnHandle )
					ENDIF
					ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nOrder_PU, 'PO_PU',2)
					ThisForm.lblPO_PUstr.Caption 	= Get_PUstr_from_nPU(nOrder_PU, ThisForm.nConnHandle)
					ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nOrder_PU, ThisForm.nConnHandle)
					
					cMisc_purch = PrepareSQLtxt(tmpPOp.misc_purch,'Misc_Purch',-1)
					IF !EMPTY(cMisc_purch)
						IF !EMPTY(ThisForm.edtSpecs.Value)
							IF NOT ALLTRIM(UPPER(ThisForm.edtSpecs.Value)) == ALLTRIM(UPPER(cMisc_purch))
								*IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Spec '"+ALLTRIM(ThisForm.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cMisc_purch)+"?",4+32,"Purchase Order Table has Spec listed differently.") = 6
								*	ThisForm.edtSpecs.Value = cMisc_purch
								*ELSE
									*IF EMPTY(ThisForm.edtComments.Value)
									*	IF MESSAGEBOX("Do you want to save this line "+CHR(13)+Alltrim(cMisc_purch)+CHR(13)+" to the Comment field? ",4+32,"Save info") = 6
									*		ThisForm.edtComments.Value = cMisc_purch
									*	ENDIF
									*ENDIF
								*ENDIF
							ENDIF
						ELSE
							ThisForm.edtSpecs.Value = cMisc_purch
						ENDIF
					ENDIF
					*
					
					cDescription = PrepareSQLtxt(tmpPOp.Descript,'Description',-3)
					
					IF !EMPTY(cDescription)
						IF LEN(ThisForm.edtDescription.Value)>0
							IF NOT ALLTRIM(UPPER(ThisForm.edtDescription.Value)) == ALLTRIM(UPPER(cDescription))
								IF NOT ThisForm.AskedReplaceDescrPO
									ThisForm.AskedReplaceDescrPO = .T.
									cDescription = RIGHT(cDescription,LEN(cDescription) - AT('Pcs',cDescription) - 3 )
									IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Description '"+ALLTRIM(ThisForm.edtDescription.Value)+"'"+CHR(13)+" with '"+Alltrim(cDescription)+"?"+CHR(13)+CHR(13)+"ThisForm.GetPOitemDetail()",4+32,"Purchase Order Table has Description listed differently.") = 6
										ThisForm.edtDescription.Value = cDescription
									ENDIF
								ENDIF
							ENDIF
						ELSE
							ThisForm.edtDescription.Value = cDescription
						ENDIF
					ENDIF
					*
					*Table
					
					*IF PrepareSQLtxt(tmpPOp.Stock,'Stock',13) = 'No Stock'
						IF LEN(cTBL) > 0 
							ThisForm.txtTBL.Value = cTBL
							*MESSAGEBOX("POitem is NOT for stocking:'No Stock'."+CHR(13)+"listing as Stock in TBL="+cTBL+" on a Receive.",64,"Found problem.")
						ELSE			
							ThisForm.txtTBL.Value = 'N'
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Receiving POitem 'No Stock' and listing as TBL="+cTBL+" on a Receive." )
						ENDIF
					*ENDIF
					
					IF PrepareSQLchk(tmpPOp.Services,'Services') OR PrepareSQLchk(tmpPOp.Convserv,'ConServ') OR PrepareSQLchk(tmpPOp.Equipment,'Equipment')
						ThisForm.txtTBL.Value = 'N'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.cWhat != "ADD"
			***********************************
			*** FROM RecStockGetByPOitem
			*** GetFromReceiving
			*************************************************
		
			IF USED("cntReceiving2")
				USE IN cntReceiving2
			ENDIF
		
			cSQL = "SELECT ID, Heat, Lot "
			cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			SELECT 0  
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntReceiving2')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntReceiving2')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntReceiving2")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntReceiving2")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntReceiving2')
				RETURN
			ENDIF
			IF USED('cntReceiving2')
				IF RECCOUNT('cntReceiving2') > 0
		
					*CHOOSE Receiving Details if different heat
					PRIVATE nReceivingID, lDiffHeat
					nReceivingID = 0
					lDiffHeat = .F.
					
					IF VARTYPE(cntReceiving2.Heat)="C"
						cHeat = ALLTRIM(ShowSQLtxt(cntReceiving2.Heat,'HEAT',50))
					ENDIF
					cHeatCurr = ALLTRIM(ShowSQLtxt(ThisForm.txtHeat.Value,'Heat',50))
					
					IF LEN(cHeatCurr) > 1 AND LEN(cHeat) > 1
						IF NOT cHeatCurr $ cHeat
							lDiffHeat = .T.
						ENDIF
					ENDIF
					
					IF lDiffHeat
						IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
							IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
								cPOitem = Proper_PO_item(ThisForm.cPOitem)
							ENDIF
						ENDIF
						IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
							DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, "" TO nReceivingID
							nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
							IF TYPE("nReceivingID")="N"
								IF nReceivingID > 0
									*ThisForm.ReceivingID = nReceivingID
									
									ThisForm.txtReceivingID.Value = nReceivingID
									ThisForm.txtReceivingID.refresh
									
									lOK = ThisFormSet.Get_Exact_ReceivingID(nReceivingID)
									
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF	
			ENDIF	
		ENDIF
		
		IF USED('cntReceiving2')
			USE IN cntReceiving2
		ENDIF	
		
		
		
		**validate data
		
		IF Proper_SO_item(ThisForm.cSOitem) <> Proper_SO_item('')
			IF Count_SOIteminSales( ThisForm.cSOitem, ThisForm.nConnHandle )=0
				MESSAGEBOX("The SO item '"+ThisForm.cSOitem+"'"+CHR(13)+" entered with PO item '"+ThisForm.cPOitem+"'"+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for SOitem problems.",48,"Weird")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SO item '"+ThisForm.cSOitem+"' entered with PO item '"+ThisForm.cPOitem+"', does not Exists!")
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE getpo_incoming
		PARAMETERS cPOitem
		*ThisForm.GetPO_Incoming(cPOitem)
		
		**check POitem as  INCOMING or 'Due in'
		PRIVATE nItemPO, nHpaPo, nID_Detail, nID_Detail_Process, nID_D_P
		nItemPO = Proper_PO_Item_Item(cPOitem)
		nHpaPo	= Proper_PO_Item_PO(cPOitem)
		nID_Detail = 0
		nID_Detail_Process = 0
		nID_D_P = 0 
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF nHpaPo = 0
			MESSAGEBOX("No PO to show!",0,"No PO")
			RETURN .F.
		ENDIF
		
		*Check Vendor QAType
		IF is_Vendor_LabService(nHpaPo, ThisForm.nConnhandle) 
			* AND nWO_Detail = 0
			nMess = MESSAGEBOX("PO "+ALLTRIM(STR(nHPApo))+" is for a Test Report."+CHR(13)+"This is not the Vendor!"+CHR(13)+"Are you receiving to the right PO?"+CHR(13)+CHR(13)+"Do you still want to continue?",4+256+16,"Wrong PO") 
			IF nMess <> 6
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE lFoundIncoming	&&Found a INCOMING OR 'Due In'
		lFoundIncoming = .F.
		
		**********************
		PRIVATE cSQL
		cSQL = " SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
		*Stock Master
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT"
		cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'S' AS TBL, M.Heat, M.Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND M.Heat = 'DUE IN'"
		
		cSQL = cSQL + " UNION "
		*Stock History
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT "
		cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
		cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' 
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + ", 'A' AS TBL, M.Heat, M.Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		*cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' "
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		
		cSQL = cSQL + " UNION "
		*Stock Process
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT "
		cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'S' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
		*LEFT OUTER ?
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
		
		cSQL = cSQL + " UNION "
		*Broker Master
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT"
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'B' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		
		cSQL = cSQL + " UNION "
		*Broker Process
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT "
		cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'B' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
		cSQL = cSQL + " UNION "
		*WIP Master
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT"
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'W' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'' AS Process_ID, 0 AS ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " AND M.[heat] = 'DUE IN'"
		
		cSQL = cSQL + " UNION "
		*WIP Process
		cSQL = cSQL + " SELECT TOP 1 "
		cSQL = cSQL + " (SELECT Count(*) AS CNT "
		cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
		cSQL = cSQL + "  ) AS CNT "
		cSQL = cSQL + " , 'W' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
		cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
		cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
		cSQL = cSQL + " ) t ORDER BY [Process_ID] DESC, Heat, Lot "
			
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_ProcessCNT')
		WAIT WINDOW 'TIMEOUT1' TIMEOUT 1
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 2
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_ProcessCNT' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_ProcessCNT")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 2
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_ProcessCNT")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			TrackError(cSQL,"Get POitem Detail, Bad Query", PROGRAM(), LINENO(1))
		
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_ProcessCNT' )	
		ENDIF
		
		PRIVATE cTBL
		cTBL = getTBL_Poitem(cPOitem, ThisForm.nConnhandle) 
		
		IF USED('tmpPO_ProcessCNT')
			IF RECCOUNT('tmpPO_ProcessCNT') > 0
				
				PRIVATE cMess
				cMess = "Found records"+CHR(13)+"you do not need to take action"+CHR(13)+"This could get messy:"+CHR(13)+CHR(13)
				
				SELECT tmpPO_ProcessCNT
				
				LOCATE FOR TBL = 'A'
				IF FOUND('tmpPO_ProcessCNT')
					lDelHistPOstk = .T.
					
					PRIVATE cHistHeat 
					cHistHeat = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
					cMess = cMess + "Found '"+ALLTRIM(cHistHeat)+"' in Archive. "+CHR(13)
					cMess = cMess + "        The Archive data will not be used. "+CHR(13)
					DELETE FROM tmpPO_ProcessCNT WHERE Heat = cHistHeat 
				ENDIF
				GO TOP
				
				PRIVATE cHeatNew,cLotNew, nID_DetailNew
				
				SCAN
					IF DELETED('tmpPO_ProcessCNT')
						LOOP
					ENDIF
					IF PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1) = "A"
						LOOP
					ENDIF
					IF tmpPO_ProcessCNT.CNT = 0
						LOOP
					ENDIF
					
					cTBLOld = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
					IF cTBL = "S" OR cTBL = "B" OR cTBL = "W" 
						nID_Detail = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail,'ID_Detail',-3)
						lFoundIncoming = .T.
						
						cProcess_ID = PrepareSQLtxt(tmpPO_ProcessCNT.Process_ID,'Process_ID',10)
						IF LEN(cProcess_ID) = 0
							cMess = cMess + "   without an Incoming Process_ID ."+CHR(13)
							nID_D_P = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
							IF nID_D_P > 0
								cMess = cMess + " nID_Detail_Process = "+ALLTRIM(STR(nID_D_P))+CHR(13)+CHR(13)
								IF nID_Detail_Process = 0
									nID_Detail_Process = nID_D_P
								ENDIF
							ENDIF
						ELSE
							cTBL = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
							
							cMess = cMess + "   with a Process_ID of '"+cProcess_ID+"'."+CHR(13)
							cMess = cMess + " nID_Detail = "+ALLTRIM(STR(nID_Detail))+CHR(13)
							IF cProcess_ID = "INCOMING"
								*Use this nID_Detail_Process !
								nID_Detail_Process = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
								cMess = cMess + "INCOMING nID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+CHR(13)+CHR(13)
							ENDIF
						ENDIF
					ENDIF
				
				ENDSCAN
				
				IF nID_Detail_Process = 0
					cMess = cMess + CHR(13)+"Did not find an Incoming Process to receive to!"+CHR(13)
				ELSE
					cMess = cMess + CHR(13)+"Using Incoming Process "+ALLTRIM(STR(nID_Detail_Process))+" to receive to!"+CHR(13)
					IF nID_D_P > 0
						cMess = cMess + CHR(13)+"Where did Process "+ALLTRIM(STR(nID_D_P))+" come from!?!"+CHR(13)
					ENDIF
				ENDIF
				IF nID_Detail_Process > 0
					cMess = cMess + CHR(13)+"Incomming Process "+ALLTRIM(STR(nID_Detail_Process))+" will be choosen to be used."
				ENDIF
		
				
				IF RECCOUNT('tmpPO_ProcessCNT') = 1 
					MESSAGEBOX(cMess,48,"Found for POitem '"+cPOitem+"'")
					RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),cMess)
				ENDIF
				lChoosePOstk = .T.
			ENDIF
			USE IN tmpPO_ProcessCNT
		ENDIF
		
		************
		*****************************************
		*************************************************************
		*Bring in basics from POitem
		PRIVATE cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, cLot, lRandLen, cDispAlloy, nStandSize, cMisc_purch
		PRIVATE nSalesNum, nItemSo, cDescription, nWeight
		
		
		IF USED('tmpPOp')
			USE IN tmpPOp
		ENDIF
		
		cSQL = "SELECT * "
		cSQL = cSQl + ",dbo.f_Descript(Alloy,CC,Form,Thck,Sz2,Sz3,Order_QTY,RandLen ) AS Descript"
		cSQL = cSQl + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
		cSQL = cSQl + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOitem+"')"
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
		ENDIF
		
		IF USED('tmpPOp')
			IF RECCOUNT('tmpPOp') > 0
				*get PO Item data
				
				cCompany = PrepareSQLtxt(tmpPOp.Company,'Company',30)
				ThisForm.txtVendor.Value = ALLTRIM(ShowSQLtxt(cCompany,'Company',30))
				cAlloy = PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
				ThisForm.txtAlloy.Value = cAlloy
				cForm = PrepareSQLtxt(tmpPOp.Form,'form',2)
				ThisForm.txtForm.Value = cForm
				nPieces = PrepareSQLnum(tmpPOp.Pieces,'Pieces',11,3)
				ThisForm.txtPieces.Value = nPieces
				
				nThck = PrepareSQLnum(tmpPOp.Thck,'Thck',10,4)
				nSz2 = PrepareSQLnum(tmpPOp.Sz2,'Sz2',10,3)
				nSz3 = PrepareSQLnum(tmpPOp.Sz3,'Sz3',10,3)
				cCond_Spec = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-1)
				ThisForm.edtSpecs.Value = cCond_Spec
				lRandLen = PrepareSQLlogic(tmpPOp.RandLen,'RandLen')
				nStandSize = PrepareSQLnum(tmpPOp.StandSize,'StandSize',10,4)
				PRIVATE cPriceUnit
				cPriceUnit = FormUnitPrice(cForm)
				
				PRIVATE nStockLst_Qty
				nStockLst_Qty	= PrepareSQLnum(tmpPOp.StockLst_Qty,'StockLst_QTY',-5)
				PRIVATE nBillW
				nBillW			= PrepareSQLnum(ThisForm.txtBillW.Value,'BillW',-5)
				PRIVATE nPounds 
				nPounds = PrepareSQLnum(tmpPOp.Pounds,'Pounds',9,1)
				nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
				ThisForm.txtBillW.Value = nStockLst_Qty
				ThisForm.txtBillW.Value = nPounds
				ThisForm.txtAcct_Qty.Value	= PrepareSQLnum(tmpPOp.StockLst_QTY,'S_QTY',-5)
				ThisForm.txtAcct_P.Value	= PrepareSQLnum(tmpPOp.StockLst_P,'S_P',-5)
				
				PRIVATE nAcct_PU 
				nAcct_PU = PrepareSQLnum( nPU_Acct_Form( Get_From_POitem(tmpPOp.POitem, "Form", ThisForm.nConnHandle ), ThisForm.nConnHandle ),'PU',-1 )
				ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
				ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU( nAcct_PU, ThisForm.nConnHandle)
				ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle)
		*
				ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(tmpPOp.Order_QTY,'PO_QTY',-5)
				ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpPOp.Order_P,'Order_P',-5)
				IF EMPTY(ThisForm.txtPO_P.Value)
					ThisForm.txtPO_P.Value = Get_From_POitem(cPOitem, "Order_P", ThisForm.nConnHandle )
				ENDIF
					
				PRIVATE nCust_PU 
				nCust_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
				ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
				ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisForm.nConnHandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisForm.nConnHandle)
				*
				PRIVATE nOrder_PU
				nOrder_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
				IF nOrder_PU = 0
					*Fix Old data
					nOrder_PU = GetPUfromForm( cForm, ThisForm.nConnHandle )
				ENDIF
				ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nOrder_PU, 'PO_PU',2)
				ThisForm.lblPO_PUstr.Caption 	= Get_PUstr_from_nPU(nOrder_PU, ThisForm.nConnHandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nOrder_PU, ThisForm.nConnHandle)
				
				cMisc_purch = PrepareSQLtxt(tmpPOp.misc_purch,'Misc_Purch',-1)
				ThisForm.edtSpecs.Value = cMisc_purch
				cDescription = PrepareSQLtxt(tmpPOp.Descript,'Description',-3)
				ThisForm.edtDescription.Value = cDescription
		*		IF PrepareSQLchk(tmpPOp.Services,'Services') OR PrepareSQLchk(tmpPOp.Convserv,'ConServ') OR PrepareSQLchk(tmpPOp.Equipment,'Equipment')
		*			ThisForm.txtTBL.Value = 'N'
		*		ENDIF
			ENDIF
			USE IN tmpPOp
		ENDIF		
		******
		****************************
		************************************
		IF ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" ) AND nID_Detail > 0
			IF lFoundIncoming 
				*select correct data to fill!!!
				
				cSQL = cSQL + " SELECT * "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				CASE cTBL = "B"
					cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				CASE cTBL = "W"
					cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
				ENDCASE
				cSQL = cSQL + " WHERE D.ID_Detail = "+STR(nID_Detail)
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF RECCOUNT('tmpPOp') > 0
						*get PO Item data
						
						cCompany = PrepareSQLtxt(tmpPOp.Company,'Company',30)
						ThisForm.txtVendor.Value = ALLTRIM(ShowSQLtxt(cCompany,'Company',30))
						cAlloy = PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
						ThisForm.txtAlloy.Value = cAlloy
						cForm = PrepareSQLtxt(tmpPOp.Form,'form',2)
						ThisForm.txtForm.Value = cForm
						nPieces = PrepareSQLnum(tmpPOp.Pieces,'Pieces',11,3)
						ThisForm.txtPieces.Value = nPieces
						
						nThck = PrepareSQLnum(tmpPOp.Thck,'Thck',10,4)
						nSz2 = PrepareSQLnum(tmpPOp.Sz2,'Sz2',10,3)
						nSz3 = PrepareSQLnum(tmpPOp.Sz3,'Sz3',10,3)
						cCond_Spec = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-1)
						ThisForm.edtSpecs.Value = cCond_Spec
						lRandLen = PrepareSQLlogic(tmpPOp.RandLen,'RandLen')
						nStandSize = PrepareSQLnum(tmpPOp.StandSize,'StandSize',10,4)
						PRIVATE cPriceUnit
						cPriceUnit = FormUnitPrice(cForm)
						
						PRIVATE nStockLst_Qty
						nStockLst_Qty	= PrepareSQLnum(tmpPOp.StockLst_Qty,'StockLst_QTY',-5)
						PRIVATE nBillW
						nBillW			= PrepareSQLnum(ThisForm.txtBillW.Value,'BillW',-5)
						PRIVATE nPounds 
						nPounds = PrepareSQLnum(tmpPOp.Pounds,'Pounds',9,1)
						nStockLst_Qty = PrepareSQLnum(nBillW,'StockLst_QTY',-5)
						ThisForm.txtBillW.Value = nStockLst_Qty
						ThisForm.txtBillW.Value = nPounds
						ThisForm.txtAcct_Qty.Value	= PrepareSQLnum(tmpPOp.StockLst_QTY,'S_QTY',-5)
						ThisForm.txtAcct_P.Value	= PrepareSQLnum(tmpPOp.StockLst_P,'S_P',-5)
						
						PRIVATE nAcct_PU 
						nAcct_PU = PrepareSQLnum( nPU_Acct_Form( Get_From_POitem(tmpPOp.POitem, "Form", ThisForm.nConnHandle ), ThisForm.nConnHandle ),'PU',-1 )
						ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
						ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU( nAcct_PU, ThisForm.nConnHandle)
						ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle)
				*
						ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(tmpPOp.Order_QTY,'PO_QTY',-5)
						ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpPOp.Order_P,'Order_P',-5)
						IF EMPTY(ThisForm.txtPO_P.Value)
							ThisForm.txtPO_P.Value = Get_From_POitem(cPOitem, "Order_P", ThisForm.nConnHandle )
						ENDIF
							
						PRIVATE nCust_PU 
						nCust_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
						ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
						ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisForm.nConnHandle)
						ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisForm.nConnHandle)
						*
						PRIVATE nOrder_PU
						nOrder_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
						IF nOrder_PU = 0
							*Fix Old data
							nOrder_PU = GetPUfromForm( cForm, ThisForm.nConnHandle )
						ENDIF
						ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nOrder_PU, 'PO_PU',2)
						ThisForm.lblPO_PUstr.Caption 	= Get_PUstr_from_nPU(nOrder_PU, ThisForm.nConnHandle)
						ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nOrder_PU, ThisForm.nConnHandle)
						
						cMisc_purch = PrepareSQLtxt(tmpPOp.misc_purch,'Misc_Purch',-1)
						ThisForm.edtSpecs.Value = cMisc_purch
						cDescription = PrepareSQLtxt(tmpPOp.Descript,'Description',-3)
						ThisForm.edtDescription.Value = cDescription
				*		IF PrepareSQLchk(tmpPOp.Services,'Services') OR PrepareSQLchk(tmpPOp.Convserv,'ConServ') OR PrepareSQLchk(tmpPOp.Equipment,'Equipment')
				*			ThisForm.txtTBL.Value = 'N'
				*		ENDIF
				
				
						****************
						ThisForm.ShowPOitemType(cPOitem)
						****************
		
					ENDIF
					USE IN tmpPOp
				ENDIF	
			
			ENDIF
		ENDIF
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
	ENDPROC

	PROCEDURE getsoitemdetail
		*ThisForm.GetSoItemDetail()
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
		IF Proper_SO_item(cSOitem) = Proper_SO_item('')
			IF Proper_SO_item(ThisForm.cSOitem) <> Proper_SO_item('')
				cSOitem = ThisForm.cSOitem 
			ENDIF
		ELSE
			IF Proper_SO_item(ThisForm.cSOitem) = Proper_SO_item('')
				ThisForm.cSOitem = cSOitem
			ENDIF
		ENDIF
		
		
		PRIVATE cSQL, nSQLExec
		IF USED("tmpSOitem")
			USE IN tmpSOitem
		ENDIF
		
		PRIVATE cSOitem, cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, cLot, lRandLen, cDispAlloy , nOrder_Qty, cMisc_purch
		PRIVATE nSalesNum, nItemSo, cDescription, nPounds
		
		cSQL = "SELECT "
		cSQL = cSQL + "AQ.SOitem, AQ.Company, AQ.Alloy, AQ.Form, AQ.Pieces, AQ.Weight "
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS DescriptM "
		cSQL = cSQL + ",SS.Alloy AS SSAlloy, SS.Form AS SSForm, SS.Pieces AS SSPieces, SS.Weight AS SSWeight"
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.Pieces, SS.Form, SS.Thck, SS.SZ2, SS.SZ3, SS.Weight, SS.RandLen, SS.Metric, '', '', '') AS SSDescriptM "
		cSQL = cSQL + ",AQ.S_QTY, AQ.S_P "
		cSQL = cSQL + ",AQ.Q_P, AQ.Q_QTY, AQ.Q_PU "
		cSQL = cSQL + " FROM dbo.AllQuotes AQ WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StartingStock SS WITH(NOLOCK) ON SS.AllQuotes_ID = AQ.ID "
		cSQL = cSQL + " WHERE AQ.SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitem' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitem' )
		ENDIF
		
		IF USED('tmpSOitem')
			IF RECCOUNT('tmpSOitem') > 0	
				IF TYPE("tmpSOitem.SOitem") = "C"
					cSOitem = tmpSOitem.SOitem
				ELSE
					cSOitem = ''
				ENDIF
				PRIVATE cSOitemText 
				cSOitemText = "Found in SOitem "+cSOitem+":"
				
				nSalesNum	= Proper_SO_item_SO(cSOitem)
				nItemSo		= Proper_SO_Item_Item(cSOitem)
		*		ThisForm.txtSOitem.Value = nItemSO
				
				*Only ask only if a Service or ConvService PO
				*IF PO_POitem_Cnt( cPOitem, ThisForm.nConnHandle, 'SERVICECONVSERV' ) >
				
		*!*			cCompany = ALLTRIM(ShowSQLtxt(tmpSOitem.Company,'Company',30))
		*!*			IF !EMPTY(cCompany)
		*!*				IF !EMPTY(ThisForm.txtVendor.Value)
		*!*					IF ALLTRIM(UPPER(ThisForm.txtVendor.Value)) != ALLTRIM(UPPER(cCompany))
		*!*						*IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Vendor '"+ALLTRIM(ThisForm.txtVendor.Value)+"'"+CHR(13)+"with '"+Alltrim(cCompany)+"?"+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Vendor listed differently.") = 6
		*!*							ThisForm.txtVendor.Value = cCompany
		*!*						*ENDIF
		*!*					ENDIF
		*!*				ELSE
		*!*					ThisForm.txtVendor.Value = cCompany
		*!*				ENDIF
		*!*			ENDIF
				
				PRIVATE lHasSS
				lHasSS = .F.
				IF NOT EMPTY(tmpSOitem.SSDescriptM)
					lHasSS = .T.
				ENDIF
				
				IF lHasSS 
					cAlloy = PrepareSQLtxt(tmpSOitem.SSAlloy,'Alloy',12)
				ELSE
					cAlloy = PrepareSQLtxt(tmpSOitem.Alloy,'Alloy',12)
				ENDIF
		
				IF !EMPTY(cAlloy)
					IF !EMPTY(ThisForm.txtAlloy.Value)
						IF ThisForm.txtAlloy.Value != cAlloy
							IF MESSAGEBOX(cSOitemText+CHR(13)+"Do you want to replace the "+CHR(13)+"Alloy '"+ALLTRIM(ThisForm.txtAlloy.Value)+"'"+CHR(13)+"with '"+Alltrim(cAlloy)+"?"+CHR(13)+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Alloy listed differently.") = 6
								ThisForm.txtAlloy.Value = cAlloy
							ENDIF
						ENDIF
					ELSE
						ThisForm.txtAlloy.Value = cAlloy
					ENDIF
				ENDIF
				***
				
				IF lHasSS 
					nPieces = PrepareSQLnum(tmpSOitem.SSPieces,'SSPieces',-3)
				ELSE
					nPieces = PrepareSQLnum(tmpSOitem.Pieces,'Pieces',-3)
				ENDIF
				
				IF nPieces > 0
					IF !EMPTY(ThisForm.txtPieces.Value)
						IF ThisForm.txtPieces.Value != nPieces 
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Pieces '"+ALLTRIM(STR(ThisForm.txtPieces.Value))+"'"+CHR(13)+"with '"+Alltrim(STR(nPieces))+"?"+CHR(13)+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Alloy listed differently.") = 6
								ThisForm.txtPieces.Value = nPieces
							ENDIF
						ENDIF
					ELSE
						ThisForm.txtPieces.Value = nPieces
					ENDIF
				ENDIF
				***
				
				IF lHasSS 
					nOrder_Qty = PrepareSQLnum(tmpSOitem.SSWeight,'SSWeight',9,1)
				ELSE
					nOrder_Qty = PrepareSQLnum(tmpSOitem.Weight,'Weight',9,1)
				ENDIF
				
				PRIVATE nS_PU
				nS_PU = PrepareSQLnum(tmpSOitem.Q_PU,'PU',-1)
				
				IF nS_PU = 1 &&PU1 is Pounds.
					IF nOrder_Qty > 0
						IF ThisForm.txtBillW.Value > 0
							IF ThisForm.txtBillW.Value != nOrder_Qty
								IF MESSAGEBOX(cSOitemText+CHR(13)+"Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisForm.txtBillW.Value))+"'"+CHR(13)+"with '"+Alltrim(STR(nOrder_Qty))+"?"+CHR(13)+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Weight listed differently.") = 6
									ThisForm.txtBillW.Value = nOrder_Qty
								ENDIF
							ENDIF
						ELSE
							ThisForm.txtBillW.Value = nOrder_Qty
						ENDIF
					ENDIF
				ENDIF
				***
				IF lHasSS
					nPounds = PrepareSQLnum(tmpSOitem.SSWeight,'SSWeight',9,1)
				ELSE
					nPounds = PrepareSQLnum(tmpSOitem.Weight,'Weight',9,1)
				ENDIF
				
				IF nS_PU = 1 &&PU1 is Pounds.
					IF nPounds > 0
						IF ThisForm.txtBillW.Value > 0
							IF ThisForm.txtBillW.Value != nPounds 
								IF MESSAGEBOX(cSOitemText+CHR(13)+"Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisForm.txtBillW.Value))+"'"+CHR(13)+"with '"+Alltrim(STR(nPounds ))+"?"+CHR(13)+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Weight listed differently.") = 6
									ThisForm.txtBillW.Value = nPounds 
								ENDIF
							ENDIF
						ELSE
							ThisForm.txtBillW.Value = nPounds 
						ENDIF
					ENDIF
				ENDIF
				***
				
				PRIVATE nCust_PU
				nCust_PU = PrepareSQLnum(tmpSOitem.Q_PU,'Recv_PU',-1)	&&Cust
				*This is the PU Sold to,  NOT the StockLst Standard.  Use Acct Standard by form.
				
				PRIVATE nStockLst_PU 
				nStockLst_PU = GetPUfromForm( tmpSOitem.Form, ThisForm.nConnHandle )  &&Acct Stnd
				ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nStockLst_PU,'Acct_PU',2)
				ThisForm.lblAcct_PUstr.Caption	= Get_PUstr_from_nPU(nStockLst_PU, ThisForm.nConnHandle)
				ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nStockLst_PU,ThisForm.nConnHandle)
		*	
				ThisForm.txtPO_QTY.Value	= PrepareSQLnum(tmpSOitem.Q_QTY,'Q_QTY',-5)
				ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpSOitem.Q_P,'Q_P',-5)
				
				ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
				ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nCust_PU, ThisForm.nConnHandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nCust_PU, ThisForm.nConnHandle)
			
				ThisForm.txtForm.Value = PrepareSQLtxt(tmpSOitem.Form,'Form',2)	
		
				***
				IF lHasSS
					cDescription = PrepareSQLtxt(tmpSOitem.SSDescriptM,'SSDescriptM',-1)
				ELSE
					cDescription = PrepareSQLtxt(tmpSOitem.DescriptM,'DescriptM',-1)
				ENDIF
				IF AT('PCS',UPPER(cDescription)) > 0
					cDescription = RIGHT(cDescription,LEN(cDescription) - AT('PCS',UPPER(cDescription)) - 3 )
				ENDIF
				IF AT('PC',UPPER(cDescription)) > 0
					cDescription = RIGHT(cDescription,LEN(cDescription) - AT('PC',UPPER(cDescription)) - 2 )
				ENDIF
				
				IF !EMPTY(cDescription)
					IF !EMPTY(ThisForm.edtDescription.Value)
						IF ALLTRIM(UPPER(ThisForm.edtDescription.Value)) != ALLTRIM(UPPER(cDescription))
							IF NOT ThisForm.AskedReplaceDescrSO
		
								ThisForm.AskedReplaceDescrSO = .T.
								*cDescription = RIGHT(cDescription,LEN(cDescription) - AT('Pcs',cDescription) - 3 )
								IF MESSAGEBOX(cSOitemText+CHR(13)+"Do you want to replace the "+CHR(13)+"Description '"+ALLTRIM(ThisForm.edtDescription.Value)+"'"+CHR(13)+"with '"+Alltrim(cDescription)+"?"+CHR(13)+CHR(13)+"Yes, the computer sees a differance"+CHR(13)+"ThisForm.GetSoItemDetail()",4+32,"Purchase Order Table has Description listed differently.") = 6
									ThisForm.edtDescription.Value = cDescription
								ENDIF
							ENDIF
						ENDIF
					ELSE
						ThisForm.edtDescription.Value = cDescription
					ENDIF
				ENDIF
				***
		
				PRIVATE cHeat, cLot, cMess
				cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
				cLot	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
				
				IF USED("tmpSDitem")
					USE IN tmpSDitem
				ENDIF
				
				cSQL = "SELECT Heat,Lot "
				cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
				IF LEN(cHeat)> 0 AND cHeat <> "DUE IN"
					cSQL = cSQL + " AND Heat = '"+cHeat+"'"
				ENDIF
				*IF LEN(cLot)> 0
				*	cSQL = cSQL + " AND Lot = '"+cLot+"'"
				*ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSDitem')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSDitem' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSDitem")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSDitem")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSDitem' )
				ENDIF
		
				IF USED('tmpSDitem')
					IF RECCOUNT('tmpSDitem') > 0 
						IF RECCOUNT('tmpSDitem') > 1 
							cMess = ''
							SCAN
								IF EMPTY(cMess)
									cMess = ALLTRIM(PrepareSQLtxt(tmpSDitem.Heat,'Heat',50))
								ELSE
									cMess = cMess + ", "+ALLTRIM(PrepareSQLtxt(tmpSDitem.Heat,'Heat',50))
								ENDIF
							ENDSCAN
							MESSAGEBOX("More than 1 Heat/Lot was found"+CHR(13)+"for this SOitem."+CHR(13)+cMess,0+64,"Mulitple Heats")
							SCAN
								IF MESSAGEBOX("Do you want to use Heat:"+ALLTRIM(PrepareSQLtxt(tmpSDitem.Heat,'Heat',50))+CHR(13)+"/Lot '"+PrepareSQLtxt(tmpSDitem.Lot,'Lot',10),4+32,"Choose Heat") = 6
									ThisForm.txtHeat.Value	= PrepareSQLtxt(tmpSDitem.Heat,'Heat',50)
									ThisForm.txtLot.Value	= PrepareSQLtxt(tmpSDitem.Lot,'Lot',10)
									EXIT
								ENDIF
							ENDSCAN
						ELSE
							ThisForm.txtHeat.Value	= PrepareSQLtxt(tmpSDitem.Heat,'Heat',50)
							ThisForm.txtLot.Value	= PrepareSQLtxt(tmpSDitem.Lot,'Lot',10)
						ENDIF
					ENDIF
					
					USE IN tmpSDitem
					
					*Get Detail of this Heat.
					cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
					cLot  = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
					
					IF USED("tmpSDSOiHeat")
						USE IN tmpSDSOiHeat
					ENDIF
					
					cSQL = "SELECT StockLst_ID,StockLst_ID_Detail,TBL,ID,Lot,Form "  &&Quoted_PU
					*cSQL = cSQL + " ,StockLst_QTY,StockLst_P,StockLst_Total,StockLst_PU "
					*cSQL = cSQL + " ,StockLst_PC,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3, StockLst_LBS"
					
					cSQL = cSQL + " ,Orig_PC,Orig_Dim1,Orig_Dim2,Orig_Dim3, Orig_LBS"
					cSQL = cSQL + " ,Orig_QTY,Orig_P,Orig_Total,Orig_PU "
					
					cSQL = cSQL + " ,Removed_QTY"&&	ERP Acct Standard
					cSQL = cSQL + " ,Form"		&&	ERP Acct Standard
					cSQL = cSQL + " ,Invoice_QTY"	&&	Customer
					cSQL = cSQL + " ,Invoice_P"	&&Customer
					cSQL = cSQL + " ,PS_QTY"		&&Customer
					cSQL = cSQL + " ,Left_QTY"	&&	ERP Acct Standard
		
					cSQL = cSQL + " ,Removed_PC "
					cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSoItem+"')"
					cSQL = cSQL + " AND Heat = '"+cHeat+"'"
					*IF LEN(cLot)> 0
					*	cSQL = cSQL + " AND Lot = '"+cLot+"'"
					*ENDIF
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSDSOiHeat')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSDSOiHeat' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSDSOiHeat")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSDSOiHeat")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSDSOiHeat' )
					ENDIF
		
					IF USED('tmpSDSOiHeat')
						IF RECCOUNT('tmpSDSOiHeat') > 0 
							ThisForm.txtID_Master.Value	= PrepareSQLnum(tmpSDSOiHeat.StockLst_ID,'Master_ID',-3)
							ThisForm.txtID_Detail.Value	= PrepareSQLnum(tmpSDSOiHeat.StockLst_ID_Detail,'ID_Detail',-3)
							ThisForm.txtTBL.Value 		= PrepareSQLtxt(tmpSDSOiHeat.TBL,'TBL',1)
							ThisForm.txtForm.Value		= PrepareSQLtxt(tmpSDSOiHeat.Form,'Form',2)
							ThisForm.txtLot.Value		= PrepareSQLtxt(tmpSDSOiHeat.Lot,'Lot',10)
							
							ThisForm.Sales_Stock_ID 	= PrepareSQLnum(tmpSDSOiHeat.ID,'ID',-3)
							ThisForm.txtActualW.Value	= PrepareSQLnum(tmpSDSOiHeat.Orig_LBS,'LBS',9,1)
							ThisForm.txtBillW.Value		= PrepareSQLnum(tmpSDSOiHeat.Orig_LBS,'LBS',9,1)				
							ThisForm.txtAcct_Qty.Value	= PrepareSQLnum(tmpSDSOiHeat.Orig_QTY,'S_QTY',-5)
							ThisForm.txtAcct_P.Value	= PrepareSQLnum(tmpSDSOiHeat.Orig_P,'S_P',-5)
							
							PRIVATE nAcct_PU 
							nAcct_PU = PrepareSQLnum(tmpSDSOiHeat.Orig_PU,'S_PU',-1)
							ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
							ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU( nAcct_PU, ThisForm.nConnHandle)
							ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle)									
							
							ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpSDSOiHeat.Orig_P,'Q_P',-5)
							ThisForm.txtPO_QTY.Value 	= Calc_Vend_QTYleft_PO(ThisForm.cPOitem, ThisForm.nConnHandle)
							
							PRIVATE nCust_PU
							nCust_PU = PrepareSQLnum(tmpSOitem.Q_PU,'Recv_PU',-1)	&&Cust
							ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nCust_PU, 'PO_PU',2)
							ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( nCust_PU, ThisForm.nConnHandle)
							ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nCust_PU, ThisForm.nConnHandle)
							
		*	
							ThisForm.txtPieces.Value 	= Calc_Vend_PiecesLeft_PO(ThisForm.cPOitem, ThisForm.nConnHandle)
		
							ThisForm.txtForm.Value = PrepareSQLtxt(tmpSDSOiHeat.Form,'Form',2)	
		
							*ThisForm.txtPieces.Value 	= PrepareSQLnum(tmpSDSOiHeat.Orig_PC,'Orig_PC',-3)
							
							* StockLst_Dim1
							IF RECCOUNT('tmpSDSOiHeat') > 1
								MESSAGEBOX("Caution, more than one Heat/Lot record was found!",0+64,"Multiple records found")
							ENDIF	 
						ENDIF
						USE IN tmpSDSOiHeat
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		**validate data
		IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
			IF Count_POIteminPurchaseOrder( ThisForm.cPOitem, ThisForm.nConnHandle )=0
				MESSAGEBOX("The PO item '"+ThisForm.cPOitem+"'"+CHR(13)+" entered with SO item '"+ThisForm.cSOitem+"'"+CHR(13)+CHR(13)+"Does not Exists!"+CHR(13)+"Watch for POitem problems.",48,"Weird")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The PO item '"+ThisForm.cPOitem+"' entered with SO item '"+ThisForm.cSOitem+"', does not Exists!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getwo_detail
	ENDPROC

	PROCEDURE get_exact_receivingid
	ENDPROC

	PROCEDURE get_rma_detail
	ENDPROC

	PROCEDURE Init
		PARAMETERS pcPOitem, pcWhat, pValue
		*DO FORM Forms\PO_Correct WITH cPOitem, 'RECEIVING', pnRID
		
		IF VARTYPE(pcWhat)!="C"
			pcWhat=''
		ENDIF
		
		IF NOT ( VARTYPE(pValue)="C" OR VARTYPE(pValue)="N" )
			pValue=''
		ENDIF
		
		*? ThisForm.AskedReplaceDescrSO
		
		ThisForm.lblWhat.Caption = ''
		ThisForm.cWhat = pcWhat
		
		
		ThisForm.txtReceivingID.Value = 0
		ThisForm.txtTBL.Value = ''
		
		DO CASE 
		CASE pcWhat = "RECEIVING"
			ThisForm.lblWhat.Caption = 'CORRECT'
			ThisForm.ResetAddVars()
		
		OTHERWISE
			MESSAGEBOX("Parameters should look like this."+CHR(13)+"\PO_Correct WITH 'pcWhat', pValue, 'pcHeat'",16,"Bad Parameters")
			TrackError("Did not get a proper pcWhat. '"+pcWhat+"'"+CHR(13)+"\Receive_Edit WITH 'pcWhat', pValue, 'pcHeat'","Parameter error!",PROGRAM(), LINENO(1))
		ENDCASE
		
		PRIVATE cPOitem
		cPOitem	= Proper_PO_Item( pcPOitem )
		
		IF cPOitem	!= Proper_PO_Item('')
			ThisForm.ShowPOitemType(cPOitem)
		ELSE
		
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE look4_recvid
		*Look4_RecvID()
		
		
		PRIVATE nRID
		nRID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nRID > 0
			*ThisRoutine was to look 4 an ReceivingID that already exists, import if Found
			RETURN 
		ENDIF
		
		PRIVATE cHeat, cLot
		cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot  = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		
		PRIVATE nWO_Detail
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		IF nSalesNum > 0 AND nItemSo > 0
			cSOitem 	= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
		ELSE
			cSOitem		= Proper_SO_item('')
		ENDIF
		
		PRIVATE cPOitem, nHpaPo, nItemPo  
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nHpaPo > 0 AND nItemPo > 0
			cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		ELSE
			cPOitem		=  Proper_PO_item('')
		ENDIF
		
		PRIVATE lHave_POi, lHave_SOi, lHave WOD
		lHave_POi = IIF(cPOitem <> Proper_PO_item(''), .T. ,.F.)
		lHave_SOi = IIF(cSOitem <> Proper_SO_item(''), .T. ,.F.)
		lHave_WOD = IIF(nWO_Detail > 0, .T. ,.F.)
		
		PRIVATE cMess, nMess
		cMess = "Found a Previously saved Receiving Record"+CHR(13)
		nMess = 0
		
		PRIVATE cSQL, cSQL2, nSQLEXEC 
		* pcWhat = "S_Process"  pcWhat = "B_Process"   pcWhat = "W_Process"
		IF USED("cntReceiving2")
			USE IN cntReceiving2
		ENDIF
		
		cSQL = "SELECT ID, Heat, Lot, POitem, SOitem, WO_Detail "
		cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
		
		DO CASE
		CASE lHave_POi AND lHave_SOi AND lHave_WOD
			cSQL2 = " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL2 = cSQL2 + " AND SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL2 = cSQL2 + " AND WO_Detail = "+STR(nWO_Detail)
		CASE lHave_POi AND NOT lHave_SOi AND NOT lHave_WOD
			cSQL2 = " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			
		CASE lHave_POi AND NOT lHave_SOi AND lHave_WOD
			cSQL2 = " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL2 = cSQL2 + " AND WO_Detail = "+STR(nWO_Detail)
			
		CASE lHave_POi AND lHave_SOi AND NOT lHave_WOD
			cSQL2 = " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
			cSQL2 = cSQL2 + " AND SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
		CASE NOT lHave_POi AND lHave_SOi AND lHave_WOD
			cSQL2 = " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL2 = cSQL2 + " AND WO_Detail = "+STR(nWO_Detail)
			
		CASE NOT lHave_POi AND lHave_SOi AND NOT lHave_WOD
			cSQL2 = " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		CASE NOT lHave_POi AND NOT lHave_SOi AND lHave_WOD
			cSQL2 = " WHERE WO_Detail = "+STR(nWO_Detail)
				
		CASE NOT lHave_POi AND NOT lHave_SOi AND NOT lHave_WOD
			cSQL2 = " WHERE 0<>0 "
		ENDCASE
		
		
		cSQL = cSQL + cSQL2 + " AND ISNULL(Cancelled,0) = 0 "+CHR(13)+" ORDER BY ID_Detail DESC"
		
		
		SELECT 0  
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntReceiving2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntReceiving2')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntReceiving2")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntReceiving2")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntReceiving2')
			RETURN
		ENDIF
		IF USED('cntReceiving2')
			IF RECCOUNT('cntReceiving2') > 0
				
				*CHOOSE ReceivingID Details if same heat, Lot
				PRIVATE nReceivingID, nRecCount, nCurrRec, lDiffHeat, lDiffLot, nRID 
				nRecCount = RECCOUNT('cntReceiving2')
				lDiffHeat = .T.
				lDiffLot = .T.
				
				SCAN
					nReceivingID = 0
					nMess = 0
					nRID = PrepareSQLnum(cntReceiving2.ID,'RID',-3)
					
					nCurrRec = RECNO('cntReceiving2')
					
					IF VARTYPE(cntReceiving2.Heat)="C"
						cHeat = ALLTRIM(ShowSQLtxt(cntReceiving2.Heat,'Hest',50))
					ENDIF
					cHeatCurr = ALLTRIM(ShowSQLtxt(cHeat,'Heat',50))
					
					
					cMess = cMess + cSQL2 +CHR(13)+CHR(13)+"Do you want to see this Receiving Record?"
					IF LEN(cHeat) > 0
						cMess = cMess + CHR(13)+"with Heat of "+cHeat+CHR(13)+"your heat is "+cHeatCurr+CHR(13)
					ENDIF
					
					cMess = cMess + "Receiving ID = "+ALLTRIM(STR(nRID))+" "+ CHR(13)
					
					IF nRecCount > 1
						cMess = cMess + CHR(13)+"Record "+ALLTRIM(STR(nCurrRec))+" of "+ALLTRIM(STR(nRecCount))
					ENDIF
					
					nMess = MESSAGEBOX(cMess,0,"See This Receiving Record?")
					IF nMess = 6
						IF lHave_POi
							IF cPOitem = PrepareSQLtxt(cntReceiving2.POitem,'POitem',12) 
								DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, "" TO nReceivingID
								*Returns ReceivingID , 0 if Create new, OR -ID_Detail
								nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
							ENDIF
						ENDIF
		*				IF nReceivingID < 1
		*					IF lHave_SOi
		*						IF cSOitem = PrepareSQLtxt(cntReceiving2.SOitem,'SOitem',10) 
		*							DO FORM Forms\ChooseReceivingDetails WITH cSOitem, cHeat, "" TO nReceivingID
		*							nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
		*						ENDIF
		*					ENDIF
		*				ENDIF
						IF nReceivingID < 1
							IF lHave_WOD
								IF nWO_Detail = PrepareSQLnum(cntReceiving2.WO_Detail,'WO_Detail',-3) 
									DO FORM Forms\ChooseReceivingDetails WITH nWO_Detail, cHeat, "" TO nReceivingID
									nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					
					IF nReceivingID > 0
						EXIT
					ENDIF
					
				ENDSCAN
				
		*!*			IF LEN(cHeatCurr) > 1 AND LEN(cHeat) > 1
		*!*				IF NOT cHeatCurr $ cHeat
		*!*					lDiffHeat = .T.
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			IF lDiffHeat
		*!*				IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
		*!*					IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
		*!*						cPOitem = Proper_PO_item(ThisForm.cPOitem)
		*!*					ENDIF
		*!*				ENDIF
		*!*				IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
		*!*					DO FORM Forms\ChooseReceivingDetails WITH cPOitem, cHeat, "" TO nReceivingID
		*!*					nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
		*!*					IF TYPE("nReceivingID")="N"
		*!*						IF nReceivingID > 0
		*!*							*ThisForm.ReceivingID = nReceivingID
		*!*							
		*!*							ThisForm.txtReceivingID.Value = nReceivingID
		*!*							ThisForm.txtReceivingID.refresh
		*!*							
		*!*							IF USED("tmpReceivingPOi")
		*!*								USE IN tmpReceivingPOi
		*!*							ENDIF
		
		*!*							cSQL = "SELECT * "
		*!*							cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
		*!*							cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		*!*							
		*!*							
		*!*							SELECT 0  
		*!*							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOi')
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceivingPOi')
		*!*							ENDDO
		*!*							IF nSQLEXEC < 0 &&Try again!
		*!*								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivingPOi")
		*!*								DO WHILE nSQLEXEC = 0
		*!*									WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceivingPOi")
		*!*									
		*!*									IF nSQLEXEC < 0
		*!*										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*											nSQLEXEC = 0
		*!*										ENDIF
		*!*									ENDIF
		*!*								ENDDO
		*!*							ENDIF 
		*!*							IF nSQLEXEC < 0
		*!*								SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpReceivingPOi')
		*!*								RETURN
		*!*							ENDIF
		*!*							IF USED('tmpReceivingPOi')
		*!*								ThisForm.txtHeat.Value		= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Heat,'Heat',50,.F.,.T.))
		*!*								ThisForm.txtLot.Value		= PrepareSQLtxt(tmpReceivingPOi.Lot,'Lot',10)
		*!*								ThisForm.chkCert.Value		= PrepareSQLchk(tmpReceivingPOi.Cert,'Cert')
		*ThisForm.chkCofC.Value
		*!*								ThisForm.txtPieces.Value	= PrepareSQLnum(tmpReceivingPOi.Pieces,'Pieces',-3)
		*!*								ThisForm.edtDescription.Value = ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Description,'Descript',-1,.F.,.T.))
		*!*								ThisForm.edtSpecs.Value		= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Specs,'Specs',160))
		*!*								ThisForm.edtComments.Value	= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Comments,'Receipt',-1))
		*!*								ThisForm.txtInit.Value		= ShowSQLtxt(tmpReceivingPOi.Init,'INIT',10)
		*!*								ThisForm.txtDate.Value		= ShowSQLdate(tmpReceivingPOi.Date,'Date')
		*!*								ThisForm.chkPass.Value		= PrepareSQLlogic(tmpReceivingPOi.Pass,'Pass')
		*!*								ThisForm.chkGoodPapers.Value	= PrepareSQLlogic(tmpReceivingPOi.GoodPapers,'GoodPapers')
		*!*								
		*!*								ThisForm.txtActualW.Value	= PrepareSQLnum(tmpReceivingPOi.ActualW,'Weight',9,1)
		*!*								ThisForm.txtBillW.Value		= PrepareSQLnum(tmpReceivingPOi.BillW,'Weight',9,1)
		*!*								
		*!*								ThisForm.txtAcct_Qty.Value	= PrepareSQLnum(tmpReceivingPOi.R_QTY,'S_QTY',-5)
		*!*								PRIVATE nAcct_PU 
		*!*								nAcct_PU = PrepareSQLnum(tmpReceivingPOi.R_PU,'S_PU',-1)
		*!*								ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
		*!*								ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
		*!*								ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisForm.nConnHandle)
		*!*	*						
		*!*								PRIVATE nVend_PU 
		*!*								nVend_PU = PrepareSQLnum(tmpReceivingPOi.PO_PU,'PO_PU',-1)
		*!*								IF nVend_PU > 0
		*!*									ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(tmpReceivingPOi.PO_QTY,'PO_QTY',-5)
		*!*									ThisForm.txtPO_P.Value		= PrepareSQLnum(tmpReceivingPOi.PO_P,'PO_P',-5)
		*!*									
		*!*									ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
		*!*									ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisForm.nConnHandle)
		*!*									ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nVend_PU, ThisForm.nConnHandle)
		*!*								ELSE
		*!*									*Old Receive - Get by POitem
		*!*									IF Proper_PO_Item(ThisForm.cPOitem) <> Proper_PO_Item("")
		*!*										nVend_PU = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisForm.nConnHandle ), 'Order_PU',-1)
		*!*										ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nVend_PU, 'PO_PU',2)
		*!*										ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nVend_PU, ThisForm.nConnHandle)
		*!*										ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nVend_PU, ThisForm.nConnHandle)
		*!*										
		*!*										PRIVATE nVend_QTY, nVend_P
		*!*										nVend_QTY = Calc_Vend_QTYleft_PO(cPOitem, ThisForm.nConnHandle)
		*!*										nVend_P = PrepareSQLnum( Get_From_POitem(cPOitem, "Order_PU", ThisForm.nConnHandle ), 'Order_PU',-1)
		*!*										ThisForm.txtPO_QTY.Value 	= PrepareSQLnum(nVend_QTY,'PO_QTY',-5)
		*!*										ThisForm.txtPO_P.Value		= PrepareSQLnum(nVend_P,'PO_P',-5)
		
		*!*									ELSE
		*!*										ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(1, 'PO_PU',2)
		*!*										ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU( 1, ThisForm.nConnHandle)
		*!*										ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( 1, ThisForm.nConnHandle)
		*!*									ENDIF								
		*!*								ENDIF
		*!*								
		*!*								ThisForm.txtVendor.Value	= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.Vendor,'Vendor',30))
		*!*								ThisForm.txtRMA_No.Value	= PrepareSQLnum(tmpReceivingPOi.RMA_No,'RMA_No',-3)
		*!*								ThisForm.txtRMA_Detail.Value= PrepareSQLnum(tmpReceivingPOi.RMA_Detail,'RMA_Detail',-3)
		*!*								
		*!*								ThisForm.edtRejectReason.Value	= ALLTRIM(ShowSQLtxt(tmpReceivingPOi.RejectReason,'RejectReason',255))
		*!*								
		*!*								*ThisForm.txtAlloy.SetFocus()
		*!*								
		*!*								*USE IN tmpReceivingPOi
		*!*								
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
			ENDIF	
		ENDIF
		IF USED('cntReceiving2')
			USE IN cntReceiving2
		ENDIF	
			
	ENDPROC

	PROCEDURE markasrmareceived
		PARAMETERS pnReceivingID
		*ThisForm.MarkAsRMAreceived(nReceivingID)
		
		PRIVATE cSQL, nSQLEXEC, nRMA_Detail, nReceivingID, dReceived
		nRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		nReceivingID = PrepareSQLnum(pnReceivingID,'ReceivingID',-3)
		dReceived = PrepareSQLdate(ThisForm.txtReceived.Value,'Received')
		
		IF nRMA_Detail > 0
			*Update RMA_Detail with Date
			
			IF NOT EMPTY(dReceived)
				cSQL= "UPDATE dbo.RMA_Detail SET "
				cSQL= cSQL+" Returned ='"+DTOC(dReceived)+"'"
				cSQL= cSQL+",ReceivingID = "+STR(nReceivingID)
				cSQL= cSQL+" WHERE RMA_Detail_ID = "+STR(nRMA_Detail)
				cSQL= cSQL+" AND ISNULL(ReceivingID,0)=0 "
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update. "+CHR(13)+cSQL )
				ENDIF
			ENDIF	
			
			PRIVATE nID_Master, nID_Detail, nID_Detail_Process
			nID_Master	= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
			nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
			nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
			PRIVATE cForm,cHeat,cLot
			cForm = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
			cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',30)
			cLot = PrepareSQLtxt(ThisForm.txtLot.Value,'LOT',10)
			
		*!*	Done in ThisForm.Set_RMA_SS_ID()
		*!*		cSQL  = ''
		*!*		IF nID_Master >0 AND nID_Detail > 0 && AND nID_Detail_Process >0
		*!*			*Update Sales_Stock with the Stock Master and Detail IDs
		*!*			IF ThisForm.RMA_SS_ID > 0 
		*!*				IF Sales_Stock_Exists(nRMA_Detail,'RMA_Detail',ThisForm.nConnHandle)
		*!*					cSQL = "UPDATE dbo.Sales_Stock SET "
		*!*					cSQL= cSQL+" StkBack = 1"
		*!*					cSQL= cSQL+", Return_ID_Master = "+STR(nID_Master)
		*!*					cSQL= cSQL+", Return_ID_Detail = "+STR(nID_Detail)
		*!*					cSQL= cSQL+", RMA_Detail_ID="+STR(nRMA_Detail)
		
		*!*					cSQL= cSQL+",[Returned] = CASE WHEN ISNULL([Returned],CONVERT (date,GETDATE()) )=CONVERT (date,GETDATE()) then GETDATE() ELSE [Returned] end"
		*!*					cSQL= cSQL+" WHERE ID = "+STR(ThisForm.RMA_SS_ID)
		*!*				ELSE
		*!*				
		*!*				ENDIF		
		*!*			ELSE
		*!*				*Try to Update by an existing RMA entry
		*!*				cSQL = "UPDATE dbo.Sales_Stock SET "
		*!*				cSQL = cSQL+" StkBack = 1"
		*!*	*			cSQL = cSQL+", StockLst_ID = "+STR(nID_Master)
		*!*	*			cSQL = cSQL+", StockLst_ID_Detail = "+STR(nID_Detail)
		*!*				cSQL= cSQL+", Return_ID_Master = "+STR(nID_Master)
		*!*				cSQL= cSQL+", Return_ID_Detail = "+STR(nID_Detail)
		*!*				*cSQL= cSQL+", RMA_Detail_ID="+STR(nRMA_Detail)
		*!*				cSQL = cSQL+",[Returned] = CASE WHEN ISNULL([Returned],CONVERT (date,GETDATE()) )=CONVERT (date,GETDATE()) then GETDATE() ELSE [Returned] end"
		*!*				*cSQL = cSQL+" WHERE RMA_Detail_ID="+STR(nRMA_Detail)
		*!*				IF LEN(cHeat) > 0
		*!*					cSQL = cSQL+" AND Heat = '"+cHeat+"'"
		*!*				ENDIF
		*!*				IF LEN(cLot) > 0
		*!*					cSQL = cSQL+" AND Lot = '"+cLot+"'"
		*!*				ENDIF
		*!*			ENDIF
		*!*		ELSE
		*!*			*Update without Stock IDs
		*!*			IF ThisForm.RMA_SS_ID > 0	
		*!*				cSQL = "UPDATE dbo.Sales_Stock SET "
		*!*				cSQL= cSQL+" StkBack = 1"
		*!*				cSQL= cSQL+",RMA_Detail_ID="+STR(nRMA_Detail)
		*!*				cSQL= cSQL+",[Returned] = CASE WHEN ISNULL([Returned],CONVERT (date,GETDATE()) )=CONVERT (date,GETDATE()) then GETDATE() ELSE [Returned] end"
		*!*				cSQL= cSQL+" WHERE ID = "+STR(ThisForm.RMA_SS_ID)
		*!*				
		*!*			ELSE
		*!*				*Try to Update by an existing RMA entry
		*!*				cSQL = "UPDATE dbo.Sales_Stock SET "
		*!*				cSQL = cSQL+" StkBack = 1"
		*!*				cSQL = cSQL+",[Returned] = CASE WHEN ISNULL([Returned],CONVERT (date,GETDATE()) )=CONVERT (date,GETDATE()) then GETDATE() ELSE [Returned] end"
		*!*				*cSQL = cSQL+",Return_ID_Master = "+STR(nID_Master)
		*!*				*cSQL = cSQL+",Return_ID_Detail = "+STR(nID_Detail)
		*!*				cSQL = cSQL+" WHERE RMA_Detail_ID="+STR(nRMA_Detail)
		*!*				IF LEN(cHeat) > 0
		*!*					cSQL = cSQL+" AND Heat = '"+cHeat+"'"
		*!*				ENDIF
		*!*				IF LEN(cLot) > 0
		*!*					cSQL = cSQL+" AND Lot = '"+cLot+"'"
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		IF LEN(cSQL) > 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 1
		*!*				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
		*!*				*RETURN
		*!*				RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update. "+CHR(13)+cSQL )
		*!*			ENDIF
		*!*		ELSE
		*!*			MESSAGEBOX("Did not get full details"+CHR(13)+STR(nID_Master)+" ID_Master"+CHR(13)+STR(nID_Detail)+" ID_Detail"+CHR(13)+STR(nID_Detail_Process)+" ID_Detail_Process",64,"RMA _Detail not Saved")
		*!*		ENDIF
			
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE new_id_detail
		PARAMETERS nID_Master, nID_Detail, cTBL
		*PARAMETERS nID_Master, cTBL
		
		*ThisForm.New_ID_Detail()
		*Return nID_Detail = EXEC dbo.p_Lst_Detail_Clone @ID= @ID_Detail= ,@TBL='',@mS_QTY=
		
		IF PrepareSQLnum(nID_Master,'ID_Master',-3)= 0
			RETURN 0
		ENDIF
		
		PRIVATE nQTY
		nQTY = PrepareSQLnum(ThisForm.txtAcct_Qty.Value,'Acct_Qty',-5)
		*PRIVATE cTBL
		
		*!*	PRIVATE nSize_H,nSize_L,nPC,nDim1,nDim2,nDim3
		*!*	PRIVATE clength, nWeight,cDescript,cLocation,cFloorStatus
		*!*	PRIVATE	cClass,bRandLen,nID,nID_Detail_Process,nReceivingID
		*!*	PRIVATE nS_QTY, nS_P,nS_TOTAL,nS_PU
		
		*See if old ID_Detail still in TBL
		PRIVATE nCount
		nCount = Count_Lst_Detail_by_ID_Detail(cTBL,nID_Detail,ThisForm.nConnHandle)
		IF nCount = 0
			nCount = Count_Lst_Detail_by_ID_Detail(cTBL+"H",nID_Detail,ThisForm.nConnHandle)
			IF nCount > 0
				*Clone this History
				cTBL = cTBL+"H"
			ELSE
				TrackError("Could not run New_ID_Detail","New_ID_Detail", PROGRAM(), LINENO(1))
				RETURN 0
			ENDIF
		ENDIF
		
		IF USED('tmp_New_ID_Detail')
			USE IN tmp_New_ID_Detail
		ENDIF
		
		SELECT 0
		cSQL = " EXEC dbo.p_Lst_Detail_Clone "
		cSQL = cSQL +" @ID="+STR(nID_Master)
		cSQL = cSQL +",@ID_Detail="+STR(nID_Detail)
		cSQL = cSQL +",@TBL='"+cTBL+"'"
		cSQL = cSQL +",@mS_QTY="+STR(nQTY)
		
		*!*	cSQL = " EXEC [dbo].[p_Lst_Detail_ins] "
		*!*	cSQL = cSQL +"	@TBL="
		*!*	cSQL = cSQL +"	@size_h=" &&		decimal(9, 4),
		*!*	cSQL = cSQL +"	@size_l=" &&		decimal(9, 4),
		*!*	cSQL = cSQL +"	@pc	=" &&	    INT,
		*!*	cSQL = cSQL +"	@dim1	=" &&	decimal(18, 4),
		*!*	cSQL = cSQL +"	@dim2	=" &&	decimal(18, 4),
		*!*	cSQL = cSQL +"	@dim3	=" &&	decimal(18, 4),
		*!*	cSQL = cSQL +"	@length	=" &&	varchar(160),
		*!*	cSQL = cSQL +"	@weight	=" &&	decimal(18, 8),
		*!*	cSQL = cSQL +"	@descript=" &&	varchar(20),
		*!*	cSQL = cSQL +"	@location=" &&	varchar(10),
		*!*	cSQL = cSQL +"	@floorstatus=" &&	char(1),
		*!*	cSQL = cSQL +"	@class		=" &&char(1),
		*!*	cSQL = cSQL +"	@RandLen	=" &&BIT,
		*!*	cSQL = cSQL +"	@ID		=" &&int,
		*!*	cSQL = cSQL +"	@ID_Detail_Process =" &&int,
		*!*	cSQL = cSQL +"	@ReceivingID	=" &&int,
		*!*	cSQL = cSQL +"	@S_QTY		=" &&decimal(18, 4),
		*!*	cSQL = cSQL +"	@S_P		=" &&decimal(18, 4),
		*!*	cSQL = cSQL +"	@S_TOTAL	=" &&decimal(18, 4),
		*!*	cSQL = cSQL +"	@S_PU	=" &&TinyInt	
			
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_New_ID_Detail' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_New_ID_Detail' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_New_ID_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_New_ID_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'tmp_New_ID_Detail')
		ENDIF
		
		PRIVATE nNew_ID_Detail 
		nNew_ID_Detail = 0
		
		IF USED('tmp_New_ID_Detail')
			IF RECCOUNT('tmp_New_ID_Detail') > 0
				nNew_ID_Detail = PrepareSQLnum(tmp_New_ID_Detail.EXP,'ID_Detail',-3)	
				
			ENDIF
		
		ENDIF
		
		RETURN nNew_ID_Detail 
		
		
		
		
		
	ENDPROC

	PROCEDURE receivedtoordered
		PARAMETER pcPOitem
		*THISFORM.ReportReceivedtoOrdered(cPOitem)
		
		*-* Check Received to Ordered and display difference
		
		IF TYPE("pcPOitem") != "C"
			MESSAGEBOX("No POitem for ReportReceivedtoOrdered(pcPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No POitem for ReportReceivedtoOrdered(pcPOitem)" )
			RETURN
		ENDIF
		
		IF Proper_PO_item(pcPOitem)=Proper_PO_item('')
			MESSAGEBOX("No POitem for ReportReceivedtoOrdered(pcPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No POitem for ReportReceivedtoOrdered(pcPOitem)" )
			RETURN
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item( pcPOitem )
		PRIVATE nDec
		nDec = SET("DECIMAL")
		SET DECIMAL TO 0
		PRIVATE nItemPO, nPO
		nItemPO = VAL( RIGHT( cPOitem,2 ) )
		nPO		= VAL( LEFT(  cPOitem,9 ) )
		SET DECIMAL TO nDec
		
		IF nPO > 0 AND nItemPO > 0
			IF USED("tmpSumPO")
				USE IN tmpSumPO
			ENDIF
			PRIVATE nT_Pc, nT_Weight, nT_Count
			PRIVATE cSQL
			cSQL = "SELECT SUM(d.PC) AS T_pc, SUM(d.Weight) AS T_Weight, COUNT(d.ID) AS T_Count FROM dbo.BrokerLst_Detail d, dbo.BrokerLst_Master m "
			cSQL = cSQL + " WHERE dbo.f_ProperPOitem(m.PO_item) = dbo.f_ProperPOitem('" + cPOitem + "') AND m.ID = d.ID"
		
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumPO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSumPO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSumPO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSumPO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSumPO')
				nT_Pc		= 0
				nT_Weight	= 0
				nT_Count	= 0
			ELSE
				nT_Pc		= tmpSumPO.T_Pc
				nT_Weight	= tmpSumPO.T_Weight
				nT_Count	= tmpSumPO.T_Count
			ENDIF
			
			IF USED("tmpSumPO")
				USE IN tmpSumPO
			ENDIF
			
			IF nT_Count = 0 &&Try StockLst
			
				cSQL = "SELECT SUM(d.PC) AS T_pc, SUM(d.Weight) AS T_Weight, COUNT(d.ID) AS T_Count FROM dbo.StockLst_Detail d, dbo.StockLst_Master m "
				cSQL = cSQL + " WHERE dbo.f_ProperPOitem(m.PO_item) = dbo.f_ProperPOitem('" + cPOitem + "') AND m.ID = d.ID"
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumPO')
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSumPO')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSumPO")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSumPO")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSumPO')
					nT_Pc		= 0
					nT_Weight	= 0
					nT_Count	= 0
				ELSE
					nT_Pc		= tmpSumPO.T_Pc
					nT_Weight	= tmpSumPO.T_Weight
					nT_Count	= tmpSumPO.T_Count
				ENDIF
				
				IF USED("tmpSumPO")
					USE IN tmpSumPO
				ENDIF
			
			ENDIF
			
			IF nT_Count = 0
				nT_Pc		= 0
				nT_Weight	= 0
			ENDIF
					
			PRIVATE nT_pcR, nT_ActualR, nT_BillR, nT_CountR 
			nT_pcR		= 0
			nT_ActualR	= 0
			nT_BillR	= 0
			nT_CountR 	= 0
					
			DIMENSION aTotalW(1,4)
			cSQL = "SELECT SUM(Pieces) AS T_pc, SUM(ActualW) AS T_Actual, SUM(BillW) AS T_Bill, COUNT(*) AS T_CountR FROM dbo.Receiving WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			IF USED("tmpReceiving")
				USE IN tmpReceiving
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceiving')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReceiving')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceiving")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceiving")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpReceiving')
			ELSE
				IF !EOF("tmpReceiving")
					IF TYPE("tmpReceiving.T_pc") = "N" OR VARTYPE(tmpReceiving.T_pc)="Y"
						nT_pcR = tmpReceiving.T_pc
					ENDIF
					IF TYPE("tmpReceiving.T_Actual") = "N" OR VARTYPE(tmpReceiving.T_Actual)="Y"
						nT_ActualR = tmpReceiving.T_Actual
					ENDIF
					IF TYPE("tmpReceiving.T_Bill") = "N" OR VARTYPE(tmpReceiving.T_Bill)="Y"
						nT_BillR = tmpReceiving.T_Bill
					ENDIF
					IF TYPE("tmpReceiving.T_CountR") = "N" OR VARTYPE(tmpReceiving.T_CountR)="Y"
						nT_CountR = tmpReceiving.T_CountR
						*Do not keep doubling when their are muliple receiveing records
						IF nT_CountR > 1 AND nT_BillR > 0
							nT_BillR = nT_BillR / nT_CountR 
						ENDIF
					ENDIF
				
				ENDIF
			ENDIF
			
		*	MESSAGEBOX(SPACE(15)+"-Ordered-"+SPACE(7)+"-Received-"  +CHR(13)+;
					   "        PC:"+PADL(STR(nT_Pc),10)    +SPACE(12)+PADL(STR(nT_pcR),10)+CHR(13)+;
					   "  Weight:"+PADL(STR(nT_Weight),10)+SPACE(10)+PADL(STR(nT_ActualR),10)+CHR(13)+;
					   "Billed W:"+PADL(STR(nT_BillR),10) +SPACE(10)+" "+CHR(13)+;
					   "       ID's:"+PADL(STR(nT_Count),10) +SPACE(11)+PADL(STR(nT_CountR),10);
					   ,0+64,"Report Purchase Order Summary for PO-item '"+ALLTRIM(cPOitem)+"'")
					   
		*	DO FORM Forms\ReportReceived_Ordered WITH nT_Pc,nT_pcR,nT_Weight,nT_ActualR,nT_BillR,nT_Count,nT_CountR,cPOitem
		*	DO FORM Forms\ShowReceived_Ordered WITH "what",cPOitem, cAlloy,cHeat,nPieces,nAcct_QTY,nActualW,cDescription,nReceivingID,cTBL
		
		
		ENDIF
		
		SELECT Receiving
	ENDPROC

	PROCEDURE receive_stock		&& was receivepostocklst
		PARAMETER pPOitem, pnReceivingID, cHeat, cLot, nRMA_Detail, pSOitem, pWO_Detail, lMillTrace
		*Thisform.Receive_Stock( purchaseorder.poitem ,pnReceivingID, cHeat, nRMA_Detail, cSOitem, nWO_Detail ) 
		*Calls DO FORM Forms\Recv_Stock
		*Relays pReceivingID 
		
		IF VARTYPE(pnReceivingID) != "N"
			TrackError("Parameter pnReceivingID is not a NUMBER","bad variable",PROGRAM(),LINENO(1))
			pnReceivingID = 0
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(pPoItem,'POitem',12)
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(pnReceivingID,'ReceivingID',-3)
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ""
		ENDIF
		cHeat = ALLTRIM(cHeat)
		
		IF VARTYPE(cLot) != "C"
			cLot = ""
		ENDIF
		cLot = ALLTRIM(cLot)
		
		IF VARTYPE(nRMA_Detail) != "N"
			nRMA_Detail = 0
		ENDIF
		
		PRIVATE lRMA,nRMA_No 
		lRMA = .F.
		nRMA_No = 0
		
		IF nRMA_Detail > 0
			lRMA = RMA_Detail_Exists( nRMA_Detail, ThisForm.nConnHandle)	
			IF lRMA 
				nRMA_No = get_RMA_from_RMA_Detail( nRMA_Detail, ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pWO_Detail,'WO_Detail',-3)
		
		
		*Update StockLst
		************************** StockLst SQL
		
		PRIVATE cSQL_Master_PO, nID_Master, nID_Detail
		nID_Master = 0
		nID_Detail = 0
		PRIVATE nBkrMastCnt, nBkrMastCntRid
		nStkMastCntRid = 0
		nBkrMastCntRid = 0
		PRIVATE nStkMastCnt, nBkrMastCnt 
		nStkMastCnt = 0
		nBkrMastCnt = 0
		PRIVATE cTBL2
		cTBL2 = "N"
		
		IF nReceivingID = 0
			nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		ENDIF
		
		IF nReceivingID > 0 AND NOT lRMA
			********************* Check History, never overwrite when it has history
			PRIVATE lFoundStockHistory 
			lFoundStockHistory = .F.
			
			IF USED("tmpHistCnt")
				USE IN tmpHistCnt
			ENDIF
			
			cSQL =		  " SELECT COUNT(ID) AS Cntd "
			cSQL = cSQL + " FROM dbo.Ar_Stocklst_Detail_History "
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR( nReceivingID ))
			cSQL = cSQL + " AND [WHAT] = 'BEFOREEDIT' "
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT COUNT(ID) AS Cntd "
			cSQL = cSQL + " FROM dbo.Ar_BrokerLst_Detail_History "
			cSQL = cSQL + " WHERE ReceivingID = "+ALLTRIM(STR( nReceivingID ))
			cSQL = cSQL + " AND [WHAT] = 'BEFOREEDIT' "
			
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpHistCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpHistCnt')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpHistCnt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpHistCnt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpHistCnt')
				nStkMastCntRid = 0
			ELSE
				IF RECCOUNT('tmpHistCnt') > 0
					IF tmpHistCnt.CNTD > 0
						lFoundStockHistory = .T.
					ENDIF
				ENDIF
			ENDIF
			IF USED("tmpHistCnt")
				USE IN tmpHistCnt
			ENDIF
		
			IF lFoundStockHistory 
				MESSAGEBOX("Found this Receiving ID in Archives."+CHR(13)+"the Receive to StockLst to Edit Window will NOT show."+CHR(13)+CHR(13)+"If you still need to Edit for StockLst"+CHR(13)+"Use StockLst Maintenance.",0+48,"Not allowed to edit stock.")
				*Return True here to indicate that Recv_Stock was good, go on.
				RETURN .T.
			ENDIF
		
			********************* Check StockLst_Detail for Receiving ID
			*Could be used for RMA
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
			
			cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Detail "
			cSQL_S_Master_PO = cSQL_S_Master_PO + " WHERE ReceivingID = "+ALLTRIM(STR( nReceivingID ))
		
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "StkMastCnt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "StkMastCnt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_S_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'StkMastCnt')
				nStkMastCntRid = 0
			ELSE
				nStkMastCntRid = StkMastCnt.Cntd
				IF nStkMastCntRid > 0
					*ReceivingID is not stored to Stock untill Recv_Stock is run
					
					nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'StockLst',ThisForm.nConnHandle)  
					IF nID_Detail > 0
						cTBL = 'StockLst'
						nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
					ELSE
						nID_Master = 0
					ENDIF
					
					IF nID_Master > 0
						cTBL2 = "S"
					ENDIF
				ENDIF
			ENDIF
			IF USED("StkMastCnt")
				USE IN StkMastCnt
			ENDIF
			
			********************* Check BrokerLst_Detail for Receiving ID	
			IF USED("BkrMastCnt")
				USE IN BkrMastCnt
			ENDIF
		
			cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.BrokerLst_Detail "
			cSQL_S_Master_PO = cSQL_S_Master_PO + " WHERE ReceivingID = "+ALLTRIM(STR( nReceivingID ))
				
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "BkrMastCnt")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "BkrMastCnt")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_S_Master_PO, ThisForm.nConnHandle, nSQLEXEC, 'BkrMastCnt')
				nBkrMastCntRid = 0
			ELSE
				nBkrMastCntRid = BkrMastCnt.Cntd
				IF nBkrMastCntRid > 0
					*ReceivingID is not stored to Stock untill Recv_Stock is run
					nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'BrokerLst',ThisForm.nConnHandle)
					IF nID_Detail > 0
			*			nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,cTBL,ThisForm.nConnHandle)
						nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
					ELSE	
						nID_Master = 0
					ENDIF
					
					IF nID_Master > 0
						cTBL2 = "B"
					ENDIF
				ENDIF
			ENDIF
		
			IF USED("BkrMastCnt")
				USE IN BkrMastCnt
			ENDIF
		ELSE
			IF NOT lRMA
				*Why is there no nReceivingID!!!!
				TrackError("nReceivingID = 0","No nReceivingID!",PROGRAM(),LINENO(1))
			ENDIF
		ENDIF
		
		***********************
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCntRid + nBkrMastCntRid = 0
				*Not in Detail record for ReceivingID
				*Look by POitem - 
				
				IF Proper_PO_Item(pPoItem) != Proper_PO_Item("")
					*Lst_Detail Does not have ReceivingID
					cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL_S_Master_PO = cSQL_S_Master_PO +" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_S_Master_PO = cSQL_S_Master_PO +" AND ( POStatus LIKE 'D' OR POStatus LIKE 'P' OR POStatus IS NULL )"
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "StkMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "StkMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_S_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd
						IF nStkMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
		
							nID_Detail = get_ID_Detail_by_ReceivingID(nReceivingID,'StockLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'StockLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisForm.nConnHandle)
							ENDIF
							IF nID_Master > 0
								cTBL2 = "S"
							ENDIF
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL_B_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.BrokerLst_Master "
					cSQL_B_Master_PO = cSQL_B_Master_PO +" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_B_Master_PO = cSQL_B_Master_PO+" AND ( POStatus LIKE 'D' OR POStatus LIKE 'P' OR POStatus IS NULL )"
					*OR POStatus IS NULL )"
					
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_B_Master_PO, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "BkrMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "BkrMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_B_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd
						IF nBkrMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'BrokerLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'BrokerLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisForm.nConnHandle)
							ENDIF
							IF nID_Master > 0
								cTBL2 = "B"
							ENDIF
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
				ENDIF
			ELSE
				IF nReceivingID = 0
					*Why is there no nReceivingID!!!!
					TrackError("No nReceivingID!","No nReceivingID",PROGRAM(),LINENO(1))		
				ENDIF
			ENDIF
		ENDIF
		
		***********************
		
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCnt + nBkrMastCnt + nStkMastCntRid + nBkrMastCntRid= 0
				*No Detail record have ReceivingID
				*Look by POitem - 
		
				IF Proper_PO_Item(pPoItem) != Proper_PO_Item("") 
					*Lst_Detail Does not have ReceivingID
					cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL_S_Master_PO = cSQL_S_Master_PO+" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_S_Master_PO = cSQL_S_Master_PO+" AND ( POStatus NOT LIKE 'A' AND Heat='DUE IN' )"
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "StkMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "StkMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_S_Master_PO,ThisForm.nConnHandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd 
						IF nStkMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Detail = get_ID_Detail_by_ReceivingID(nReceivingID,'StockLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'StockLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisForm.nConnHandle)
							ENDIF
							IF nID_Master > 0
								cTBL2 = "S"
							ENDIF
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL_B_Master_PO = "SELECT COUNT(ID) AS Cntd  FROM dbo.BrokerLst_Master "
					cSQL_B_Master_PO = cSQL_B_Master_PO+" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_B_Master_PO = cSQL_B_Master_PO+" AND ( POStatus NOT LIKE 'A' AND Heat='DUE IN' )"
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL_B_Master_PO, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "BkrMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_S_Master_PO, "BkrMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_B_Master_PO, ThisForm.nConnHandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd 
						IF nBkrMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'BrokerLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'BrokerLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisForm.nConnHandle)
							ENDIF
							IF nID_Master > 0
								cTBL2 = "B"
							ENDIF
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
				ENDIF
			ELSE
				IF nReceivingID = 0
					*Why is there no nReceivingID!!!!
					TrackError("No nReceivingID!"+" , nStkMastCnt="+STR(nStkMastCnt)+", nBkrMastCnt="+STR(nBkrMastCnt)+", nStkMastCntRid="+STR(nStkMastCntRid)+", nBkrMastCntRid="+STR(nBkrMastCntRid),"No nReceivingID",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
		ENDIF
		***********************
		
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCnt + nBkrMastCnt + nStkMastCntRid + nBkrMastCntRid = 0
				*No Detail record have ReceivingID
				*Look by WO_Detail
		
				*IF Proper_PO_Item(pPoItem) = Proper_PO_Item("") 
				IF nWO_Detail > 0
					*Lst_Detail Does not have ReceivingID
					cSQL = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL = cSQL+" WHERE WO_Detail="+STR(nWO_Detail)
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StkMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StkMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd 
						IF nStkMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Master = get_ID_Master_with_WO_Detail(nWO_Detail,'StockLst',ThisForm.nConnHandle)
							nID_Detail = get_ID_Detail_by_ReceivingID(nReceivingID,'StockLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_WO_Detail(nWO_Detail,'StockLst',ThisForm.nConnHandle)
							ENDIF
							IF nID_Detail > 0 AND nID_Master = 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisForm.nConnHandle)
								IF nID_Master > 0
									cTBL2 = "S"
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL = "SELECT COUNT(ID) AS Cntd  FROM dbo.BrokerLst_Master "
					cSQL = cSQL +" WHERE WO_Detail="+STR(nWO_Detail)
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "BkrMastCnt")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "BkrMastCnt")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd 
						IF nBkrMastCnt > 0
							*ReceivingID is not stored to Stock untill Recv_Stock is run
							nID_Master = get_ID_Master_with_WO_Detail(nWO_Detail,'BrokerLst',ThisForm.nConnHandle)
							nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,'BrokerLst',ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_WO_Detail(nWO_Detail,'BrokerLst',ThisForm.nConnHandle,.T.)
							ENDIF
							IF nID_Detail > 0 AND nID_Master = 0
								nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisForm.nConnHandle)
								IF nID_Master > 0
									cTBL2 = "B"
								ENDIF
							ENDIF
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
		**************************
		PRIVATE lOK
		lOK = .T.
		
		IF NOT ThisForm.lRan_Recv_Stock 
			DO CASE
			CASE nRMA_Detail > 0
				IF MESSAGEBOX("Will this Returned Material need to be listed to Stock List?"+CHR(13)+"Open the Stock Add/Edit screen?",4,"Open Stock Edit screen?") = 6
					*Was this a Broker? - find previous TBL by SOitem and heat for RMA
					IF PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3) > 0
						nID_Master = PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
						nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
					ELSE
						nID_Detail = get_ID_Detail_from_RMA_Detail(nRMA_Detail,ThisForm.nConnHandle,cHeat)
						nID_Master = GetIDfromID_Detail( nID_Detail, cTBL, ThisForm.nConnHandle)
					ENDIF
					
					IF nID_Master > 0 AND cTBL = "S"
						*IS ID Still in Stock?
						IF Count_Lst_by_ID(cTBL, nID_Master, ThisForm.nConnHandle) = 0
							*bring back ID From History
							lOK = BringBack_DeletedLst(nID_Master,cTBL,ThisForm.nConnHandle)
							IF lOK
								IF nRMA_No > 0
									
								ENDIF
							ELSE
								TrackError("Failed to Bring back Master ID"+CHR(13)+"BringBack_DeletedLst("+STR(nID_Master)+",'"+cTBL+"')","BringBack_DeletedLst", PROGRAM(), LINENO(1))
								RETURN .F.
							ENDIF
						ENDIF
					ENDIF
					
					IF nID_Master > 0
						*Has this been run before?
						*IF lRMA
						IF nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisForm.nConnHandle)
							 *ReceivingID and ID_Detail already exists.  
							 *no need to create a new ID_Detail for the RMA Receive
							 nRMA_ID_Detail = nID_Detail 
						ELSE
							*Create a new ID_Detail for just this Returned material
							*EXEC dbo.p_Lst_Detail_Clone @ID= @ID_Detail= ,@TBL=''
							nRMA_ID_Detail = ThisForm.New_ID_Detail(nID_Master, nID_Detail, cTBL)
							
							*Save to screen
							nID_Detail = PrepareSQLnum(nRMA_ID_Detail,'ID_Detail',-3)
							ThisForm.txtID_Detail.Value = nID_Detail
							
							IF nID_Detail > 0
								*Save to Detail
								DO CASE
								CASE cTBL = "S"
									cSQL = "UPDATE dbo.StockLst_Detail "
								CASE cTBL = "B"
									cSQL = "UPDATE dbo.BrokerLst_Detail "
								CASE cTBL = "W"
									cSQL = "UPDATE dbo.WIPLst_Detail "
								OTHERWISE
									cSQL = "Lost cTBL "	
								ENDCASE				
								cSQL = cSQL + " SET [ReceivingID]="+STR(nReceivingID)
								cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
							
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
								ELSE
								ENDIF
							ENDIF		
						ENDIF
					ENDIF
					
					IF nID_Master > 0 AND nRMA_ID_Detail > 0
					
						
						*Save to dbo.Receiving now - before running Recv_Stock 
						ThisForm.MarkAsRMAreceived(nReceivingID)
						
						*********************
		
						cSQL = "UPDATE dbo.Receiving SET "
						cSQL = cSQL +" ID_Master = "+STR(nID_Master) 
						cSQL = cSQL +",ID_Detail = "+STR(nRMA_ID_Detail) 
						cSQL = cSQL +",StockTable = '"+cTBL+"'"
						cSQL = cSQL +" WHERE ID="+STR(nReceivingID)
		
						SELECT 0
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
						ELSE
							ThisForm.txtID_Detail.Value = nRMA_ID_Detail
						ENDIF
						
						DO FORM Forms\Recv_Stock WITH pPOitem, cTBL, nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail, lMillTrace
					*	ThisForm.lRan_Recv_Stock = .T.
					ENDIF
				ENDIF
				
				
			CASE nStkMastCntRid > 0
			*	DO FORM forms\Recv_Stock WITH pPOitem, pTableName, nReceivingID, pnRMA_Detail, pnID_Detail, cHeat, pnID_Master, pnWO_Detail
				DO FORM Forms\Recv_Stock WITH pPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail, lMillTrace
				*					PARAMETER  pPOitem,    pLst,    nReceivingID, pnRMA_Detail, pnID_Detail, cHeat, pnID_Master 
				ThisForm.lRan_Recv_Stock = .T.
			CASE nBkrMastCntRid > 0
				DO FORM Forms\Recv_Stock WITH pPOitem, 'BrokerLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail, lMillTrace
				*ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'BrokerLst', nReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
				ThisForm.lRan_Recv_Stock = .T.
			CASE nStkMastCnt > 0
				* SetReceivingID_in_Detail( cPOitem ,pnID_Detail, nConn, cTBL2, pnReceiveID, lCancel )
				nID_Detail = SetReceivingID_in_Detail( pPOitem, nID_Detail, ThisForm.nConnHandle, 'StockLst', nReceivingID, .F. )
				IF nID_Detail > 0 AND nID_Master = 0
					nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisForm.nConnHandle)
				ENDIF
				
				DO FORM Forms\Recv_Stock WITH pPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail, lMillTrace
				*ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'StockLst ', nReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
				ThisForm.lRan_Recv_Stock = .T.
			CASE nBkrMastCnt > 0
				* SetReceivingID_in_Detail( cPOitem ,pnID_Detail, nConn, cTBL2, pnReceiveID, lCancel )
				nID_Detail = SetReceivingID_in_Detail( pPOitem, nID_Detail, ThisForm.nConnHandle, 'BrokerLst', nReceivingID, .F. )
				IF nID_Detail > 0 AND nID_Master = 0
					nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisForm.nConnHandle)
				ENDIF
					
				DO FORM Forms\Recv_Stock WITH pPOitem, 'BrokerLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail, lMillTrace
				*ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'BrokerLst', nReceivingID, nRMA_Detail, nID_Detail, nID_Master  )
				ThisForm.lRan_Recv_Stock = .T.
			OTHERWISE
					
				*Is this a Lab Test?
				PRIVATE nCountPOitem 
				nCountPOitem = PO_POitem_Cnt( cPOitem, ThisForm.nConnHandle, "NOTRECEIVE" )
				*Only counts if Services = 0 AND ConvServ = 0 AND Equipment = 0 
				IF nCountPOitem > 0
					*ThisForm.RecvStockLoad( pPOitem, ThisForm.nConnHandle, 'StockLst ', nReceivingID, nRMA_Detail, nID_Detail, cHeat, nID_Master  )
					
					cMess = "Receive_Stock( "+CHR(13)
					cMess = cMess+"POitem,ReceivingID,Heat,Lot,RMA_Detail,SOitem,WO_Detail,lMillTrace)"+CHR(13)
					cMess = cMess+"Could not find a Master with ( POStatus NOT LIKE 'A' OR POStatus IS NULL ) "
					cMess = cMess+CHR(13)+"or Detail WHERE ReceivingID="
					cMess = cMess+STR(nReceivingID)+CHR(13)
					cMess = cMess+" POitem='"+pPOitem+"'"
					cMess = cMess+", Heat='"+ALLTRIM(cHeat)+"'"
					cMess = cMess+", RMA_Detail"+ALLTRIM(STR(nRMA_Detail))
					cMess = cMess+", TBL='"+cTBL2+"'"
					*TrackError(cMess,"nStkMastCntRid Not Found",PROGRAM(),LINENO(1) )
					TrackMess(cMess)
		
					*DO FORM forms\Recv_Stock WITH pPOitem, pTableName, nReceivingID, pnRMA_Detail, pnID_Detail, cHeat, cLot, pnID_Master, pnWO_Detail, lMillTrace
					
					PRIVATE cTableName 
					cTableName = 'StockLst'
					*Probably not the First receive, Check to see if for StockLst
					IF Count_POitem_StockLst ( cPOitem, 'S', ThisForm.nConnHandle ) > 0
						cTableName = 'StockLst'
						cTBL2 = "S"
					ELSE
						IF Count_POitem_StockLst ( cPOitem, 'B', ThisForm.nConnHandle ) > 0
							cTableName = 'BrokerLst'
							cTBL2 = "B"
						ENDIF
					ENDIF
					
					nMess = MESSAGEBOX("The PO item 'INCOMING' or 'NOT2HPA' or 'PARTRECV'"+CHR(13)+"mark is missing."+CHR(13)+CHR(13)+"This is most like a receive for '"+cTableName+"' table."+CHR(13)+"Just double checking!"+CHR(13)+"Do not worry about if you are to consume it."+CHR(13)+"Is this correct ? (Y)",3+32,"Save to "+cTableName )
					IF nMess != 6 &&No,Canc
					
						cTableName = IIF(cTableName = 'StockLst', 'BrokerLst', 'StockLst' )
						nMess = MESSAGEBOX("Would you rather receive to '"+cTableName+"' table?",3+32,"Save to "+cTableName )
						
						IF nMess!= 6
							*Must cancel!
							RETURN .F.
						ENDIF
						
					ENDIF
		
					*DO FORM forms\Recv_Stock WITH pPOitem, pTableName, nReceivingID, pnRMA_Detail, pnID_Detail, cHeat, cLot, pnID_Master, pnWO_Detail, lMillTrace
					DO FORM Forms\Recv_Stock WITH pPOitem, cTableName, nReceivingID, nRMA_Detail  ,   0        , cHeat, cLot,           0,  0, lMillTrace
					ThisForm.lRan_Recv_Stock = .T.
					
					*Retrieve Detail by ReceivingID
					nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTableName,ThisForm.nConnHandle) 
					IF nID_Detail > 0
			*			nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,cTBL,ThisForm.nConnHandle)
						nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTableName, ThisForm.nConnHandle) 
					ELSE	
						nID_Master = 0
					ENDIF
		
					ThisForm.txtID_Master.Value = PrepareSQLnum(nID_Master,'ID',-3)
					ThisForm.txtID_Detail.Value = PrepareSQLnum(nID_Detail,'ID_Detail',-3)
					ThisForm.txtTBL.Value		= cTBL2
					
				ELSE
					* Services OR ConvServ OR Equipment
					*Do not add to stock
				ENDIF
			ENDCASE
			
		ENDIF
		
		*IF NOT lRMA
		*	IF nID_Master > 0 AND nID_Detail > 0
		*		ThisForm.Update_POStatus()
		*	ENDIF
		*ENDIF
		
		
		RETURN .T.
		
		
		
	ENDPROC

	PROCEDURE receivingsaveid_master
		PARAMETERS pReceivingID, pSOitem, pPOitem, nWO_Detail, cHeat, nPieces, nRMA, nActualW
		*ThisForm.ReceivingSaveID_Master( nReceivingID, cSOitem, cPOitem, cHeat, nPieces, nRMA )
		
		***Update ID_Master and StockTable in Receiving
		*a new receive should not have stock marked!
		*RecordID_Master to Receiving.
			
		IF VARTYPE(pReceivingID) != "N"
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		IF pReceivingID < 1
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(pReceivingID,'ReceivingID',-3)
		
		IF VARTYPE(pSOitem) != "C"
			pSOitem = ""
		ENDIF
		
		IF VARTYPE(pPOitem) != "C"
			pPOitem = ""
		ENDIF
		IF pSOitem = Proper_SO_Item("")
			pSOitem = ''
		ENDIF
		
		IF VARTYPE(nWO_Detail) != "N"
			nWO_Detail = 0
		ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem)
			MESSAGEBOX("No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)" )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPieces) != "N"
			nPieces = 0
		ENDIF
		
		IF VARTYPE(nWO_Detail) != "N"
			nWO_Detail = 0
		ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem) AND EMPTY(nWO_Detail)
			MESSAGEBOX("No SO, PO, or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, nWO_Detail)",0,"Parameter Error")
			TrackError("Parameter Error","No SO, PO or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, nWO_Detail)",PROGRAM(),LINENO(1) )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPieces) != "N"
			nPieces = 0
		ENDIF
		
		IF VARTYPE(nRMA) != "N"
			nRMA = 0
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC 
		
		PRIVATE cLot
		cLot = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		
		**Find StockLst or BrokerLst and store ID to Receiving
		*Check for Process
		
		PRIVATE nID, nID_Detail, cTBL, nID_Detail_Process,cForm
		nID			= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		cForm = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		IF cTBL = "N"
			cTBL = " "
		ENDIF
		
		***********************************
		PRIVATE nTableID_Master, nTableID_Detail
		nTableID_Master = 0
		nTableID_Detail = 0
		
		********
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableName_ReceivingID("+STR(nReceivingID)+") AS TblName"  &&Returns Init
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						SCAN
							IF EMPTY(PrepareSQLtxt(tmpTable.TblName,'TblName',1))
								LOOP
							ELSE
								cTBL = PrepareSQLtxt(tmpTable.TblName,'TblName',1)
								ThisForm.txtTBL.Value = cTBL
								EXIT
							ENDIF
						ENDSCAN
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ENDIF
		
		********
		
		IF nID_Detail < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_Detail_ReceivingID("+STR(nReceivingID)+") AS TableID_Detail"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
		
					IF RECCOUNT('tmpTable') > 0
						nTableID_Detail = PrepareSQLnum(tmpTable.TableID_Detail,'TableID_Detail',-3)
						ThisForm.txtID_Detail.Value = nTableID_Detail 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Detail = nID_Detail
		ENDIF
		
		***********************************
		
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" ) AND nID_Detail > 0
		
			*try for TBL using 'Listing created from %'
			IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
				IF nID > 0 AND nID_Detail > 0
					*Find TBL
					IF USED("tmpTBL")
						USE IN tmpTBL
					ENDIF
					SELECT 0
					
					cSQL =        " SELECT 'S' AS TBL, Form"	
					cSQL = cSQL + " FROM dbo.StockLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'B' AS TBL, Form"	
					cSQL = cSQL + " FROM dbo.BrokerLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'W' AS TBL, Form"	
					cSQL = cSQL + " FROM dbo.WIPLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
					ELSE
						IF USED('tmpTBL')
		
							IF RECCOUNT('tmpTBL') > 0
								cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
								cForm = PrepareSQLtxt(tmpTBL.Form,'Form',2)
							ENDIF
							USE IN 'tmpTBL'
						ENDIF
					ENDIF
				ENDIF	
			ENDIF
		
		ENDIF
		
		***********************************
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" ) AND nID_Detail > 0 AND nReceivingID > 0
			&&*Process is updated with ReceivingId, not Set _Detail with ReceivingId
			DO CASE
			CASE cTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Detail "
			CASE cTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Detail "
			CASE cTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
			
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		********
		
		IF nID < 1 AND nReceivingID > 0
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_ReceivingID("+STR(nReceivingID)+") AS TableID"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						nTableID_Master = PrepareSQLnum(tmpTable.TableID,'TableID',-3)
						ThisForm.txtID_Master.Value = nTableID_Master 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Master = nID
		ENDIF
		
		
		***********************************
		
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			IF nTableID_Master = 0
				IF nRMA = 0
					IF nWO_Detail > 0
						*Consider a WO_Detail for Stock.
						cTBL = 'S'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************************
		*recheck for ID,ID_Detail, ID_Detail_Process by POitem
		PRIVATE lFoundProcess
		lFoundProcess = .F.
		
		IF Proper_PO_Item(pPOitem) != Proper_PO_Item('')
			IF nID = 0 AND nID_Detail = 0 AND nID_Detail_Process = 0
			
				*Check for a Process with that SOitem\WO_Detail and Heat
				nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"S",cHeat,ThisForm.nConnhandle)
				IF nID_Detail_Process = 0
					*Try Broker
					nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"B",cHeat,ThisForm.nConnhandle)
					IF nID_Detail_Process > 0
						cTBL = "B"
					ELSE
					
						*Try WIP WO_Detail
						nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(nWO_Detail,"W",cHeat,ThisForm.nConnhandle)
						IF nID_Detail_Process > 0
							cTBL = "W"
						ELSE
						
							*Try S WO_Detail
							nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(nWO_Detail,"S",cHeat,ThisForm.nConnhandle)
							IF nID_Detail_Process > 0
								cTBL = "S"
							ELSE
								*Try B WO_Detail
								nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(nWO_Detail,"B",cHeat,ThisForm.nConnhandle)
								IF nID_Detail_Process > 0
									cTBL = "B"
								ELSE
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ELSE
					cTBL = "S"
				ENDIF
				
				IF nID_Detail_Process > 0
					*FOUND IT, Get ID_Detail, ID
					DO CASE
					CASE cTBL = "S"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF
					CASE cTBL = "B"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF			
					CASE cTBL = "W"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF				
					ENDCASE
					
					IF lFoundProcess
						ThisForm.txtID_Master.Value = nID
						nTableID_Master = nID
						ThisForm.txtID_Detail.Value = nID_Detail
						nTableID_Detail = nID_Detail
						ThisForm.txtID_Detail_Process.Value = nID_Detail_Process
						ThisForm.txtTBL.Value = cTBL
						ThisForm.txtForm.Value = cForm
						
						ThisForm.Stocklst_ID		= nTableID_Master 
						ThisForm.Stocklst_ID_Detail	= nTableID_Detail 
						ThisForm.StockLst_TBL		= UPPER(cTBL)
					ENDIF
				ELSE
					*ADD to Stock?		
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Recheck for TBL
		IF cTBL!= "S" AND cTBL!= "B" AND cTBL!= "W" 
			IF nID > 0 AND nID_Detail > 0
				*Find TBL
				
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				SELECT 0
				cSQL =        " SELECT 'S' AS TBL"	
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'B' AS TBL"	
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'W' AS TBL"	
				cSQL = cSQL + " FROM dbo.WIPLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
		
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
		
						IF RECCOUNT('tmpTBL') > 0
							cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
		*					TrackError("Found ID and ID_Detail in table '"+cTBL+"'.","Change in TBL!",PROGRAM(),LINENO(1))
						ELSE
							PRIVAT cMess
							cMess = "Stocklst ID = "+STR(nID)+CHR(13)
							cMess = cMess +"Stocklst ID_Detail = "+STR(nID_Detail)+CHR(13)
							cMess = cMess +"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +"TBL Could not be Identified"
							TrackError(cMess,"No TBL!",PROGRAM(),LINENO(1))
							
						ENDIF
						USE IN 'tmpTBL'
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		***********************************
		*Get nID_Detail_Process 
		
		IF nID > 0 AND nID_Detail > 0 AND nID_Detail_Process = 0
			IF cTBL!= "S" AND cTBL!= "B" AND cTBL!= "W" 
				IF USED("tmpID_D_P")
					USE IN tmpID_D_P
				ENDIF
				SELECT 0
				cSQL = " SELECT * FROM "	
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Process "
				CASE cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Process "
				CASE cTBL = "W"
					cSQL = cSQL + " dbo.WIPLst_Process "
				ENDCASE
				cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
				IF nReceivingID > 0
					cSQL = cSQL + " AND ReceivingID = "+STR(nReceivingID)
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_D_P')
				ELSE
					IF USED('tmpID_D_P')
		
						IF RECCOUNT('tmpID_D_P') > 0
							SCAN
								nID_Detail_Process = PrepareSQLnum(tmpID_D_P.ID_Detail_Process,'ID_Detail_Process',-3)
							ENDSCAN
						ENDIF
						
						USE IN tmpID_D_P
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Create Receive Process if have Table, ID_Detail AND no ID_Detail_Proc, BUT not found in History!
		IF nID_Detail_Process = 0
			IF NOT EMPTY(cTBL)
				IF nTableID_Detail > 0
					*Add a Receiving record to History, Only one that shows the ReceivingID
					THISFORM.Create_Receive_Process(cTBL,nTableID_Detail,pSOitem,pPOitem,nReceivingID, nActualW, nID_Detail_Process)
				ENDIF
			ENDIF		
		ENDIF
		
		
		***********************************
		IF nID_Detail_Process > 0 AND nReceivingID > 0
			IF NOT EMPTY(cTBL)
				*Update Process with ReceivingID
				DO CASE
				CASE cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Process SET"
				CASE cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Process SET"
				CASE cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Process SET"
				ENDCASE
				cSQLu = cSQLu +" ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail_Process = "+STR(nID_Detail_Process )
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update"+CHR(13)+"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		
		***********************************
		IF nID_Detail > 0
			IF NOT EMPTY(cTBL)
				*Update Detail with Receiving ID
				DO CASE
				CASE cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Detail "
				CASE cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Detail "
				CASE cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Detail "
				ENDCASE
				cSQLu = cSQLu +" SET ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail = "+STR(nID_Detail )
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"Could not update" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		***********************************
		
		IF nTableID_Master > 0
			IF NOT EMPTY(cTBL)
				*Check for Heat match
				
				IF USED("tmpMasterHeat")
					USE IN tmpMasterHeat
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS CTND "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +" FROM dbo.StockLst_Master "
				CASE cTBL = "B"
					cSQL = cSQL +" FROM dbo.BrokerLst_Master "
				CASE cTBL = "W"
					cSQL = cSQL +" FROM dbo.WIPLst_Master "
				ENDCASE
				cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
				cSQL = cSQL +" AND Heat = '"+cHeat+"'"
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterHeat')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterHeat")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterHeat")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMasterHeat')
				ELSE
					IF USED('tmpMasterHeat')
						IF VARTYPE(tmpMasterHeat.CTND)='N'
							*********
							IF tmpMasterHeat.CTND = 0			
								*Did not Find Correct Heat!
								*look for 'Due in'
								
								IF USED("tmpMasterDueIn")
									USE IN tmpMasterDueIn
								ENDIF
								
								cSQL = "SELECT COUNT(*) AS CTND "
								DO CASE
								CASE cTBL = "S"
									cSQL = cSQL +" FROM dbo.StockLst_Master "
								CASE cTBL = "B"
									cSQL = cSQL +" FROM dbo.BrokerLst_Master "
								CASE cTBL = "W"
									cSQL = cSQL +" FROM dbo.WIPLst_Master "
								ENDCASE
								cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
								cSQL = cSQL +" AND Heat = 'DUE IN'" 
		
								SELECT 0
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterDueIn')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterDueIn')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterDueIn")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterDueIn")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMasterDueIn')
								ELSE
									IF USED('tmpMasterDueIn')
										IF VARTYPE(tmpMasterDueIn.CTND)='N'
											IF tmpMasterDueIn.CTND = 0
												*Did not Find Correct Heat or 'Due In'!
												nTableID_Master = 0
											ENDIF
										ENDIF
										USE IN tmpMasterDueIn
									ENDIF				
								ENDIF
							*********					
							ENDIF
						ENDIF
						USE IN tmpMasterHeat
					ENDIF				
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		
		PRIVATE lSaved
		lSaved = .F.
		
		IF nTableID_Master = 0
			IF nID > 0
				nTableID_Master = nID
			ENDIF
			IF nID_Master > 0
				nTableID_Master = nID_Master
			ENDIF	
		ENDIF
		
		IF nTableID_Master > 0
			
			cSQLu = "UPDATE dbo.Receiving SET"
			cSQLu = cSQLu +" ID_Master = "+STR(nTableID_Master)+""
			cSQLu = cSQLu +",ID_Detail = "+STR(nID_Detail)+""
			cSQLu = cSQLu +",StockTable = '"+cTBL+"'"
			cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not update dbo.Receiving" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
			ELSE 
				lSaved = .T.
			ENDIF
		ELSE
			lSaved = .F.
		
		*	PRIVATE cText
		*	cText = "Not in StockLst or BrokerLst!"+CHR(13)+"Did not save StockLst ID to Receiving table! No ID_Master for StockTable = '"+cTBL+"' AND Receiving ID = "+STR(nReceivingID)
		*	MESSAGEBOX( cText ,0+48,"ReceivingID "+ALLTRIM(STR(nReceivingID)) )
		*	TrackMess(cText)
		ENDIF
		
		***********************************
		
		IF nTableID_Master > 0
			IF NOT ( ThisForm.Stocklst_ID = nTableID_Master AND ThisForm.Stocklst_ID_Detail = nTableID_Detail AND ThisForm.StockLst_TBL = UPPER(cTBL) )
				IF EMPTY(cTBL) OR ThisForm.Stocklst_ID>0
					PRIVAT cMess
					cMess = "Stocklst_ID = "+STR(ThisForm.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
					cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisForm.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
					cMess = cMess +"StockLst_TBL = '"+ThisForm.StockLst_TBL+"' 		TBL1 = '"+UPPER(cTBL)+"'"+CHR(13)
					cMess = cMess +"ReceivingID="+STR(nReceivingID)
					TrackError(cMess,"Change in ID, ID_Detail, or TBL!",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
			
			IF ThisForm.Stocklst_ID = 0
				ThisForm.Stocklst_ID		= nTableID_Master 
				ThisForm.Stocklst_ID_Detail	= nTableID_Detail 
				*ThisForm.ID_Detail_process
			ENDIF
		ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			IF ThisForm.Stocklst_ID > 0 AND ThisForm.Stocklst_ID_Detail > 0
			
				*What Table has ID and ID_Detail combo
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				
				cSQL = "SELECT 'S' AS TBL FROM dbo.Stocklst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID) 
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'B' AS TBL FROM dbo.BrokerLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'W' AS TBL FROM dbo.WIPLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
						IF RECCOUNT('tmpTBL')>0
							cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							PRIVAT cMess
							cMess = "Stocklst_ID = "+STR(ThisForm.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
							cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisForm.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
							cMess = cMess +"StockLst_TBL = '"+ThisForm.StockLst_TBL+"' 		TBL1 = ''"
							cMess = cMess +CHR(13)+"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +CHR(13)+"TBL1 now= '"+UPPER(cTBL)+"'"
		*					TrackError(cMess+CHR(13)+CHR(13)+cSQL,"Change TBL!",PROGRAM(),LINENO(1))
						ENDIF
						USE IN tmpTBL
					ENDIF
				ENDIF	
			ENDIF
		ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			*Found a TBL, Show it on screen
			ThisForm.StockLst_TBL = UPPER(cTBL)
			ThisForm.txtTBL.Value = UPPER(cTBL)
			ThisForm.txtTBL.Refresh
		ENDIF
		
		IF USED('Receiving')
			SELECT Receiving
		ENDIF
		
		RETURN lSaved
	ENDPROC

	PROCEDURE refresh_rma_detail
		*ThisForm.Refresh_RMA_Detail()
		
		PRIVATE nRMA_Detail, nRMA, cHeat
		nRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		IF nRMA_Detail = 0
			RETURN
		ENDIF
		
		nRMA 	= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSoitem.Value,'SOitem',2,0)
		cSOitem		= Proper_SO_item('')
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			ENDIF
		ENDIF
		
		PRIVATE cMess
		PRIVATE cSQL, nSQLExec
		
		IF nRMA_Detail > 0
			IF USED("tmpRcvRMA")
				USE IN tmpRcvRMA
			ENDIF
		
			cSQL = "SELECT ID "
			cSQL = cSQL + " FROM dbo.Receiving "
			cSQL = cSQL + " WHERE RMA_Detail = "+STR(nRMA_Detail)
					
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRcvRMA')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRcvRMA' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRcvRMA")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRcvRMA")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRcvRMA' )
			ENDIF
						
			IF USED('tmpRcvRMA')
				IF RECCOUNT('tmpRcvRMA') > 0	
					nReceivingID = PrepareSQLnum(tmpRcvRMA.ID,'ReceiveID',-3)
					PRIVATE nMess
					nMess =  MESSAGEBOX("Found a Receive with this RMA Detail: "+ALLTRIM(STR(nRMA_Detail))+CHR(13)+"Receiving ID: "+ALLTRIM(STR(nReceivingID))+CHR(13)+"Do you want to Edit this Receive? (Y)"+CHR(13)+"Here is a chance to edit the Receive."+CHR(13)+CHR(13)+"Answer No to be able to ADD another receive to this RMA.",4+32,"Edit Data") 
					IF nMess = 6
						ThisForm.txtReceivingID.Value = nReceivingID 
						ThisForm.GetBy_ReceivingID()
						RETURN
					ENDIF
					IF nMess <> 7
						RETURN
					ENDIF
				ENDIF
				USE IN tmpRcvRMA
			ENDIF
		ENDIF
		
		************************************************************************
		IF nRMA_Detail > 0
			
			IF USED("tmpRMA_D")
				USE IN tmpRMA_D
			ENDIF
		
			cSQL = "SELECT RMA.Money,RMA_Detail.Reason,RMA.Aprv_By,RMA_Detail.SO_item ,RMA.RMA_No, RMA_Detail.RMA_Detail_ID"
			cSQL = cSQL + ",SS.StockLst_ID,SS.StockLst_ID_Detail,SS.TBL,SS.ID "
			cSQL = cSQL + ",SS.StockLst_PU,SS.StockLst_PC,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3, SS.StockLst_LBS,SS.Heat,SS.Lot,SS.PS_PC "
			cSQL = cSQL + ",SS.Removed_QTY ,SS.Form ,SS.Invoice_QTY ,SS.Invoice_P ,SS.PS_QTY ,SS.Left_QTY,SS.PackingSli, SS.Reconciled,SS.Returned, SS.Alloy "
			cSQL = cSQL + ",dbo.f_DescriptCL(SS.Alloy,SS.CC,SS.CL,SS.Form,SS.Removed_Dim1,SS.Removed_Dim2,SS.Removed_Dim3,SS.Removed_QTY,0) AS Descript_CL "
			cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.Removed_PC, SS.Form,SS.Removed_Dim1,SS.Removed_Dim2,SS.Removed_Dim3,SS.Removed_QTY, 0, 0, '', '', '') AS Descript_M "
		
			cSQL = cSQL + " FROM dbo.RMA RMA WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.RMA_Detail WITH(NOLOCK) ON RMA.RMA_No = RMA_Detail.RMA_NO "
			cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SS WITH(NOLOCK) ON RMA_Detail.So_item = SS.SOitem "
			cSQL = cSQL + " WHERE RMA_Detail.RMA_Detail_ID = "+STR(nRMA_Detail)
			IF NOT EMPTY(cHeat)	
				cSQL = cSQL + " AND SS.Heat = '"+cHeat+"'"
			ENDIF
					
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMA_D')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_D' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_D")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_D")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA_D' )
			ENDIF
		
			IF NOT USED('tmpRMA_D') OR RECCOUNT('tmpRMA_D') = 0	
				*try without HEAT
				cSQL = "SELECT RMA.Money,RMA_Detail.Reason,RMA.Aprv_By,RMA_Detail.SO_item ,RMA.RMA_No, RMA_Detail.RMA_Detail_ID"
				cSQL = cSQL + ",SS.StockLst_ID,SS.StockLst_ID_Detail,SS.TBL, SS.ID "
				cSQL = cSQL + ",SS.StockLst_PU,SS.StockLst_PC,SS.StockLst_Dim1,SS.StockLst_Dim2,SS.StockLst_Dim3, SS.StockLst_LBS,SS.Heat,SS.Lot,SS.PS_PC "
				cSQL = cSQL + ",SS.Removed_QTY ,SS.Form ,SS.Invoice_QTY ,SS.Invoice_P ,SS.PS_QTY ,SS.Left_QTY,SS.PackingSli, SS.Reconciled,SS.Returned, SS.Alloy "
				cSQL = cSQL + ",dbo.f_DescriptCL(SS.Alloy,SS.CC,SS.CL,SS.Form,SS.Removed_Dim1,SS.Removed_Dim2,SS.Removed_Dim3,SS.Removed_QTY,0) AS Descript_CL "
				cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.Removed_PC, SS.Form,SS.Removed_Dim1,SS.Removed_Dim2,SS.Removed_Dim3,SS.Removed_QTY, 0, 0, '', '', '') AS Descript_M "
		
				cSQL = cSQL + " FROM dbo.RMA RMA WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.RMA_Detail WITH(NOLOCK) ON RMA.RMA_No = RMA_Detail.RMA_NO "
				cSQL = cSQL + " INNER JOIN dbo.Sales_Stock SS WITH(NOLOCK) ON RMA_Detail.So_item = SS.SOitem "
				cSQL = cSQL + " WHERE RMA_Detail.RMA_Detail_ID = "+STR(nRMA_Detail)
						
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMA_D')
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_D' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_D")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_D")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA_D' )
				ENDIF
				
			ENDIF	
				
				
			IF USED('tmpRMA_D')
				IF RECCOUNT('tmpRMA_D') > 0	
					PRIVATE nRecCount, nRecNo, nMess, cMess
					nRecCount = RECCOUNT()
					nRecNo	= RECNO()
					*cSOitem = Proper_SO_item(ThisForm.cSOitem)
					
					SCAN
					
		*!*					IF Proper_SO_item(tmpRMA_D.SO_item) <> Proper_SO_item('') AND Proper_SO_item(cSOitem) <> Proper_SO_item('')
		*!*						IF Proper_SO_item(tmpRMA_D.SO_item) <> cSOitem
		*!*							MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem = "+Proper_SO_item(tmpRMA_D.SO_item),16,"Does not Match")
		*!*							*EXIT
		*!*							IF USED('tmpRMA_D')
		*!*								USE IN tmpRMA_D
		*!*							ENDIF
		*!*							RETURN
		*!*						ENDIF
		*!*					ENDIF
						
						IF nRecNo < nRecCount
							cMess = "Record: "+ALLTRIM(STR(nRecNo))+" of "+ALLTRIM(STR(nRecCount))+" records."+CHR(13)
						ELSE
							cMess = "1 Record."+CHR(13)
						ENDIF
						cMess = cMess + "Description: "+tmpRMA_D.Descript_CL+CHR(13)+CHR(13)
						cMess = cMess + ALLTRIM(PrepareSQLtxt(tmpRMA_D.Money,'Money',-3))+CHR(13)+CHR(13)
						cMess = cMess + ALLTRIM(PrepareSQLtxt(tmpRMA_D.Reason,'Reason',-3))+CHR(13)+CHR(13)
						cMess = cMess + "Is this the RMA Item you want to use for Receiving?"
						*cMess = cMess + "Approved By:"+ALLTRIM(PrepareSQLtxt(tmpRMA_D.Aprv_By,'Appv_By',-3))
						
						nMess = MESSAGEBOX(cMess,4+32,"RMA Description") 
						
						IF nMess = 6		
							ThisForm.RMA_SS_ID = PrepareSQLnum(tmpRMA_D.ID,'SS_ID',-3)
								
							ThisForm.txtReceivingID.Value = 0
							
							ThisForm.txtReceived.Value = DATE()
							
							ThisForm.txtSOnum.Value = Proper_SO_Item_SO(tmpRMA_D.SO_item)
							ThisForm.txtSOitem.Value = Proper_SO_Item_Item(tmpRMA_D.SO_item)
							ThisForm.cSOitem = Proper_SO_Item(tmpRMA_D.SO_item)
		
							ThisForm.txtAlloy.Value = PrepareSQLtxt(tmpRMA_D.Alloy,'Alloy',12)
							ThisForm.txtHeat.Value	= PrepareSQLtxt(tmpRMA_D.Heat,'Heat',50)
							Thisform.txtLot.Value	= PrepareSQLtxt(tmpRMA_D.Lot,'Lot',10)
							ThisForm.chkCert.Value	= 1
							ThisForm.chkCofC.Value	= 0
							ThisForm.chkMillTrace.Value = 0
							ThisForm.txtPieces.Value= PrepareSQLnum(tmpRMA_D.PS_PC,'Pieces',-3)
		
							ThisForm.edtDescription.Value = PrepareSQLtxt(tmpRMA_D.Descript_M,'Descript',-1)					
							ThisForm.edtSpecs.Value 	= PrepareSQLtxt(tmpRMA_D.Money,'Money',-3)
							ThisForm.edtComments.Value	= PrepareSQLtxt(tmpRMA_D.Reason,'Reason',-3)
		
							Thisform.txtDate.Value = DATE()	
							ThisForm.chkPass.Value = PrepareSQLlogic(1,'Pass')
							Thisform.chkGoodPapers.Value = PrepareSQLlogic(1,'GoodPaperwork')
							ThisForm.chkHold.Value = PrepareSQLlogic(0,'Hold')
							ThisForm.txtVendor.Value = ''
							
							PRIVATE nStockLst_QTY
							nStockLst_QTY = PrepareSQLnum(tmpRMA_D.Removed_QTY,'StockLst_QTY',-5)
							*IF nStockLst_QTY > 0
								ThisForm.txtActualW.Value = nStockLst_QTY
								ThisForm.txtBillW.Value = nStockLst_QTY
							*ENDIF
							
							*tmpRMA_D.SO_item 
							PRIVATE nAcct_PU, nAcct_QTY, nAcct_P
							nAcct_PU = PrepareSQLnum( nPU_Acct_Form( Get_From_AllQuote_SOitem (tmpRMA_D.SO_item, "Form", ThisForm.nConnHandle ), ThisForm.nConnHandle ),'PU',-1 )
							nAcct_QTY = PrepareSQLnum(Get_From_AllQuote_SOitem (tmpRMA_D.SO_item, "S_QTY", ThisForm.nConnHandle ),'S_QTY',-5)
							nAcct_P = 0
							ThisForm.txtAcct_Qty.Value		= nAcct_QTY
							ThisForm.txtAcct_P.Value		= nAcct_P
							
							ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
							ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
							ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisForm.nConnHandle)
		
							ThisForm.txtPO_QTY.Value 	= nAcct_QTY  &&PrepareSQLnum(Get_From_AllQuote_SOitem (tmpRMA_D.SO_item, "Q_QTY", ThisForm.nConnHandle ),'Q_QTY',-5)
							ThisForm.txtPO_P.Value		= PrepareSQLnum(Get_From_AllQuote_SOitem (tmpRMA_D.SO_item, "Q_P", ThisForm.nConnHandle ),'Q_P',-5)
		
							ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nAcct_PU, 'PO_PU',2)
							ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
							ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle )
		
							
							PRIVATE cTBL
							cTBL = PrepareSQLtxt(tmpRMA_D.TBL,'TBL',1)
							IF cTBL = 'S'
								*Use the MasterID of Stock
								ThisForm.txtID_Master.Value = PrepareSQLnum(tmpRMA_D.StockLst_ID,'Master_ID',-3)
								ThisForm.txtID_Detail.Value = 0 &&PrepareSQLnum(tmpRMA_D.StockLst_ID_Detail,'ID_Detail',-3)
								ThisForm.txtTBL.Value	= cTBL
								ThisForm.cTBL = cTBL
							ELSE
								ThisForm.txtID_Master.Value = 0
								ThisForm.txtID_Detail.Value = 0
								ThisForm.txtTBL.Value	= 'S'					
								ThisForm.cTBL = 'S'
							ENDIF
											
							PRIVATE nAcct_PU 
							nAcct_PU = PrepareSQLtxt(tmpRMA_D.StockLst_PU,'PU',-1)
							ThisForm.lblAcct_PU.Caption 	= PrepareSQLtxt(nAcct_PU,'Acct_PU',2)
							ThisForm.lblAcct_PUstr.Caption 	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
							ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU(nAcct_PU, ThisForm.nConnHandle)
							
							ThisForm.txtForm.Value = PrepareSQLtxt(tmpRMA_D.Form,'Form',2)
							
							ThisForm.txtRMA_No.Value	= PrepareSQLnum(tmpRMA_D.RMA_No,'RMA_No',-3)
							ThisForm.txtRMA_Detail.Value = PrepareSQLnum(tmpRMA_D.RMA_Detail_ID,'RMA_Detail_ID',-3)
							
							ThisForm.chkLab_Service.Value= PrepareSQLchk(0,'Services')
							ThisForm.chkConvServ.Value	= PrepareSQLchk(0,'ConvServ') 
							ThisForm.chkEquipment.Value	= PrepareSQLchk(0,'Equipment')
		
							
							*This Reject area is NOT for an RMA
							*ThisForm.edtRejectReason.Visible = .T.
							*
							*ThisForm.edtRejectReason.Value	= PrepareSQLtxt(tmpRMA_D.Reason,'Reason',-3)
							
						ENDIF
						
					ENDSCAN			
				ENDIF
				USE IN tmpRMA_D
				
			ENDIF
		ENDIF
	ENDPROC

