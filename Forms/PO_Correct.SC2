		ThisForm.txtBillW.Value	= 0
		
		
		ThisForm.txtAcct_Qty.Value	= 0
		ThisForm.txtAcct_P.Value	= 0
		
		ThisForm.lblAcct_PU.Caption	= ''
		ThisForm.lblAcct_PUstr.Caption 	= ''
		ThisForm.lblAcct_PUlabel.Caption	= ''
		*
		ThisForm.txtPO_QTY.Value 	= 0
