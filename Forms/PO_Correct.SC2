			WAIT WINDOW "'Stk QTY' was set to number of Pieces" NOWAIT
		ENDIF
		
		IF lEquipment
			MESSAGEBOX("This POitem will not use the Alloy, Form or Sizes."+CHR(13)+"Please remember to describe this Item in the Description field.",0,"Equipment")
			
			PRIVATE nPieces
