	PROCEDURE lblHpaPOnum.DblClick
		PRIVATE m.cHyperLink, loHyperlink
		IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_item('')
		
			m.cHyperLink = HTML_POitem(ThisForm.cPOitem,.F.)
		
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
			WAIT WINDOW 'Double Click opened a Web Report -Any key to continue'
		ELSE
			PRIVATE nPO
			nPO = PrepareSQLnum(ThisForm.txtHPAPONum.Value,'PO_num',-3)
			IF nPO > 0
		
				m.cHyperLink = HTML_PO(nPO,.F.)
		
				loHyperlink = CREATEOBJECT("Hyperlink")
				loHyperlink.navigateto(m.cHyperLink)
				RELEASE loHyperlink
				
				WAIT WINDOW 'Double Click opened a Web Report -Any key to continue'	
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE lblOrderdate.Click
		PRIVATE m.dDate1,m.dDate2
		
		m.dDate1 = ThisForm.txtReceived.Value
		DO FORM "forms\olecalendar.scx" WITH m.dDate1, 'Dock Date', ThisForm.Top, ThisForm.Left TO m.dDate2
		
		ThisForm.txtReceived.Value = m.dDate2
		ThisForm.txtReceived.Refresh
		ThisForm.txtReceived.SetFocus
		
		
	ENDPROC

	PROCEDURE lblPO.Click
		IF Proper_PO_item(ThisForm.cPOitem) = Proper_PO_item('')
			MESSAGEBOX("Enter the Po item first.",16,"No PO item")
			RETURN .F.
		ENDIF
		IF Count_POIteminPurchaseOrder( ThisForm.cPOItem, ThisForm.nConnHandle) = 0
			MESSAGEBOX("ERP POItem was not found."+CHR(13)+ThisForm.cPOItem,48,"Bad POItem Number")
			RETURN .F.
		ENDIF
		
		PRIVATE nOrder_QTY, nOrder_P, nOrder_PU, nStockLst_Total
		nOrder_QTY = 0
		nOrder_P = 0
		nOrder_PU = 0
		nStockLst_Total = 0
		
		*************************
		IF USED("tmpPOitemP")
			USE IN tmpPOitemP
		ENDIF
		
		
		cSQL = "SELECT Order_QTY, Order_P, Order_PU, StockLst_Total "
		cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"') "
		
		IF USED("tmpPOitemP")
			SELECT tmpPOitemP 
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOitemP')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOitemP')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOitemP')
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitemP")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOitemP")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF USED("tmpPOitemP")
			IF RECCOUNT("tmpPOitemP") > 0
				nOrder_QTY 	= PrepareSQLnum(tmpPOitemP.Order_QTY,'Order_QTY',-5)
				nOrder_P	= PrepareSQLnum(tmpPOitemP.Order_P,'Order_p',-5)
				nOrder_PU	= PrepareSQLnum(tmpPOitemP.Order_PU,'Order_PU',-1)
				nStockLst_Total	= PrepareSQLnum(tmpPOitemP.StockLst_Total,'StockLst_Total',-5)
						
			ENDIF
			USE IN tmpPOitemP
		ENDIF
		IF nOrder_QTY > 0
			ThisForm.txtPO_QTY.Value =  nOrder_QTY
		ENDIF
		IF nOrder_P > 0
			ThisForm.txtPO_P.Value = nOrder_P
		ENDIF
		IF nOrder_PU > 0
			ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nOrder_PU, 'PO_PU',2)
			ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nOrder_PU, ThisForm.nConnHandle)
			ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nOrder_PU, ThisForm.nConnHandle)
		
		ENDIF
		
		IF nStockLst_Total > 0
			
		ENDIF
		
	ENDPROC

	PROCEDURE lblRMA_No.Click
		*RMA_No Receive
		PRIVATE nRMA_Detail, nRMA
		nRMA_Detail= PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		nRMA 	= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOitemNum.Value,'SOitemItem',2,0)
		cSOitem		= Proper_SO_item('')
		
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			ENDIF
		ENDIF
		
		PRIVATE nNewRMA
		nNewRMA = 0
		
		IF nRMA = 0
			*Get RMA
			IF nSalesNum = 0
				DO FORM Forms\Choose_RMA WITH '' TO nNewRMA
				nNewRMA = PrepareSQLnum(nNewRMA,'NewRMA',-3)
			ELSE
				DO FORM Forms\Choose_RMA WITH cSOitem TO nNewRMA
				nNewRMA = PrepareSQLnum(nNewRMA,'NewRMA',-3)
			ENDIF
			
			***
			IF nNewRMA > 0
				ThisForm.txtRMA_No.Value = nNewRMA
				IF Thisform.CheckRMA()
					ThisForm.Get_RMA_Detail()
					*CALLS:ThisForm.Refresh_RMA_Detail()
				ENDIF
			ENDIF
		ELSE
			WAIT WINDOW "Already have RMA "+ALLTRIM(STR(nRMA))+CHR(13)+"Any key to continue..."
		ENDIF
		
		
	ENDPROC

	PROCEDURE lblSOnum.Click
		PRIVATE nHpaPo, nItemPo, cPOitem 
		nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(This.Parent.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		PRIVATE cSOitem
		
		IF nHpaPo > 0 AND nItemPo > 0
			*Look for SO that belong to this POitem
			*ThisForm.ChooseSOitemLoad(cPOitem)
			cSOItem = get_SOitem_from_POitem(cPOItem, ThisForm.nConnHandle ) 
			
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				nSalesNum = Proper_SO_Item_SO(cSOitem)
				nSOitem_Item = Proper_SO_Item_Item(cSOitem)
				
				ThisForm.txtSOnum.Value = nSalesNum 
				ThisForm.txtSOItem.Value = nSOitem_Item 
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE lblWO.Click
		PRIVATE nWO
		nWO = PrepareSQLnum(This.Parent.txtWO.Value,'WO',-3)
		
		IF nWO > 0
			MESSAGEBOX("Ther is already a WO "+ALLTRIM(STR(nWO))+CHR(13)+"Click the Blue WO number to see it in a web browser",64,"Cannot change")
		ELSE
			
			PRIVATE nNewWO, cSOitem, cPOitem
			nNewWO = 0
			cSOitem	= Proper_SO_item(ThisForm.cSOitem)
			cPOitem	= Proper_PO_Item(ThisForm.cPOitem)
			
			
			DO FORM Forms\Select_WorkOrder WITH cSOitem, cPOitem to nNewWO
			IF nNewWO > 0
				ThisForm.txtWO.Value = nNewWO
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE lblWO_Detail.Click
		PRIVATE nWO_Detail, nWO
		nWO_Detail = PrepareSQLnum(This.Parent.txtWO_Detail.Value,'WO_Detail',-3)
		nWO = 0
		
		IF nWO_Detail > 0
			MESSAGEBOX("There is already a WO_Detail "+ALLTRIM(STR(nWO_Detail))+CHR(13)+"Click the Blue WO Detail number to see it in a web browser",64,"Cannot change")
		ELSE
			*DO FORM Forms\Select_WorkOrder_Detail WITH cSOitem, cPOitem, nWO to nWO_Detail
			PRIVATE nNewWO_Detail, cSOitem, cPOitem, nWO 
			nNewWO_Detail = 0 
			cSOitem	= Proper_SO_item(ThisForm.cSOitem)
			cPOitem	= Proper_PO_Item(ThisForm.cPOitem)
			
			nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
			
			DO FORM Forms\Select_WorkOrder_Detail WITH cSOitem, cPOitem, nWO to nNewWO_Detail
			
			IF nNewWO_Detail > 0
				ThisForm.txtWO_Detail.Value = PrepareSQLnum(nNewWO_Detail,'WO_Detail',-3)
				ThisForm.txtWO.Value =  GetWO_WO_Detail( nNewWO_Detail, ThisForm.nConnHandle)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE lblWO_Detail.DblClick
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(This.Value,'WO_Detail',-3)
		
		IF nWO_Detail > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO_Detail(nWO_Detail,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE txtAcct_Qty.Valid
		PRIVATE nRecv_Qty
		nRecv_Qty		= PrepareSQLnum(This.VALUE,'Recv_Qty',11,3)
		
		PRIVATE lShowMess
		lShowMess = .F.
		IF nRecv_Qty < 1
			lShowMess = .T.
			*PRIVATE	lEquipment 
			*lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
			*IF lEquipment 
			IF ThisForm.cSOitem = 'Equipment' OR ThisForm.cSOitem = 'LabService'
				This.Value = 1
				lShowMess = .F.
				RETURN .T.
			ENDIF
		
			IF lShowMess
				MESSAGEBOX("Please enter the number of units to be priced.",48,"Units priced is empty!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtActualW.Valid
		PRIVATE nActualW, nAcct_PU, nPO_PU, nWO_Detail
		nActualW = PrepareSQLnum(This.Value,'Actual',9,1)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		
		IF nActualW > 0
			nAcct_PU = PrepareSQLnum(ThisForm.lblAcct_PU.Caption,'PU',-1)
			
			IF nAcct_PU = 0 AND nWO_Detail > 0
				nAcct_PU = 1
				ThisForm.lblAcct_PU.Caption = '1'
				ThisForm.lblAcct_PUstr.Caption	 = Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
				ThisForm.lblAcct_PUlabel.Caption = Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle )
		
		
				ThisForm.lblPO_PU.Caption = '1'
				ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
				ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU( nAcct_PU, ThisForm.nConnHandle )
		
			ENDIF
		
			IF nAcct_PU = 1
				ThisForm.txtAcct_Qty.Value = nActualW 
				IF nWO_Detail > 0
		
					ThisForm.txtPO_QTY.Value = nActualW 
				ENDIF
			ENDIF
			
			nPO_PU	= PrepareSQLnum(ThisForm.lblPO_PU.Caption,'PU',-1)
			IF nPO_PU = 1
				ThisForm.txtPO_QTY.Value = nActualW 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtBillW.Valid
		PRIVATE nBillW, nAcct_PU, nPO_PU
		nBillW = PrepareSQLnum(This.Value,'BillW',9,1)
		
		IF nBillW > 0
			nPO_PU	= PrepareSQLnum(ThisForm.lblPO_PU.Caption,'PU',-1)
			IF nPO_PU = 1
				ThisForm.txtPO_QTY.Value = nBillW 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtDate.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE("dDate") = "C"
				dDate = CtoD(ALLTRIM(This.Value))
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
				This.Value = DATE()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtDispAlloy.InteractiveChange
		PRIVATE nInsertionPt , lcSearchStr, cSearchStrOrig, lcTryAlloy 
		nInsertionPt  = THIS.SELSTART
		cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		lcSearchStr = ShowSQLtxt(cSearchStrOrig,'DispAlloy',20)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchDispAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,nInsertionPt )
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=cSearchStrOrig 
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = nInsertionPt 
	ENDPROC

	PROCEDURE txtDispAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtDispAlloy.Valid
		PRIVATE cAlloy ,cAlloyStandard
		cAlloyStandard = ShowSQLtxt(This.Value,'DisplayAlloy',20)
		cAlloy = ShowSQLtxt(This.parent.txtAlloy.Value,'Alloy',12)
		
		IF NOT EMPTY(cAlloy)
			IF NOT EMPTY(cAlloyStandard)
		
				IF NOT CheckDisplayAlloyforAlloy(cAlloy, cAlloyStandard, ThisForm.nConnHandle)
					MESSAGEBOX("Display Alloy to Vendor:"+ALLTRIM(cAlloy)+" has never been purchased as HPA Alloy:"+ALLTRIM(cAlloyStandard)+"!",0+48,"Check your Display Alloy!")
				ENDIF
				
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE txtHpaPOItem.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID > 0 OR ThisForm.lblWhat.Caption = 'EDIT'
			*If it has a receivingID the POitem is good.
			RETURN .T.
		ENDIF
		
		*ThisForm.lblWhat.Caption = 'ADD'
		
		PRIVATE cPOitem, nHpaPo, nItemPo, nWO_Detail, cHeat, cLot
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		cHeat 	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot 	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		
		IF nItemPo = 0
			ThisForm.ChecknItemPO = 0
		ENDIF
		
		PRIVATE nReceivingID, nEditReceivingID, nID_Detail_Prc
		nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		nEditReceivingID = 0
		nID_Detail_Prc	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		IF nReceivingID > 0 OR nID_Detail_Prc > 0
			*Skip Heat look up if already have ReceiveID or known nID_Detail_Prc
			RETURN .T.
		ENDIF
		
		****
		IF nItemPo = 0 AND nHpaPo > 0
			*Choose a HPApo
			ThisForm.ChoosePOitemLoad(nHPApo)
			*Refresh
			nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
			nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
			cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		ELSE
			IF ThisForm.ChecknItemPO = nItemPo
				IF nItemPo > 0
					*WAIT WINDOW "Already Checked this PO item:"+ALLTRIM(STR(nItemPO)) NOWAIT
				ENDIF
			ELSE
				IF nHpaPo > 0 AND nItemPo > 0
					IF ThisForm.ChecknHpaPO <> nHpaPo OR ThisForm.ChecknItemPO <> nItemPo
						IF EMPTY(cHeat) 
							ThisForm.cPOitem = cPOitem
							ThisForm.GetPoItemDetail(cPOitem)
						ELSE
							ThisForm.cPOitem = cPOitem
							ThisForm.GetFromReceiving(cPOitem,nWO_Detail,cHeat,cLot)
						ENDIF
						ThisForm.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisForm.nConnHandle )
					ELSE
						*Do not Recheck
					ENDIF
				ENDIF
			ENDIF
		ENDIF	
		
		********
		IF ThisForm.cPOitem <> Proper_PO_Item('')
			IF Count_POIteminPurchaseOrder( ThisForm.cPOItem, ThisForm.nConnHandle) = 0
				*Problem
				MESSAGEBOX("ERP POItem was not found."+CHR(13)+ThisForm.cPOItem+CHR(13)+"Cannot save!",48,"Bad POItem Number")
				
				This.Value = 0
				ThisForm.txtHpaPONum.Value = 0
				ThisForm.txtHpaPOItem.Value = Proper_PO_item('')
				ThisForm.cPOItem = Proper_PO_item('')
				
				RETURN .F.
			ENDIF
			
			*cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50))
			IF UPPER(cHeat) = "DUE IN" 
				IF nReceivingID > 0
					ThisForm.GetBy_ReceivingID()
				ENDIF
			ENDIF
			
			*IF Count_POIteminPurchaseOrder( ThisForm.cPOItem, ThisForm.nConnHandle, 'WORKORDER') = 1  &&Done in GetPoItemDetail
			
		ENDIF
	ENDPROC

	PROCEDURE txtHpaPONum.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID > 0
			*If it has a Receiving ID, the POitem is good.
			*ThisForm.txtAlloy.SetFocus()
			RETURN .T.
		ENDIF
		
		
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat, cLot, nWO_Detail
		nHpaPo  = PrepareSQLnum(This.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50))
		cLot	= ALLTRIM(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE nCntPO,nCntPOitem 
		nCntPO = 0
		
		IF nItemPo = 0
			nCntPO = Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle )
			IF nCntPO = 1
				cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-01" )
				nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle,'' )
				IF nCntPOitem = 1
					*have the correct cPOitem!
					nItemPo = 1
					ThisForm.txtHpaPOItem.Value = 1
				ENDIF
			ELSE
				IF ThisForm.ChoosePOitemLoad(nHpaPo)
					*Sets ThisForm.ChecknItemPO = nItemPO
					nItemPo = PrepareSQLnum(ThisForm.ChecknItemPO,'Item',-1)
					cPOitem = Proper_PO_item(STR(nHpaPo)+"-"+STR(nItemPo,2))
					ThisForm.cPOitem = cPOitem
					ThisForm.GetPoItemDetail(cPOitem)
				ENDIF
			ENDIF
		ENDIF
		
		IF nItemPo > 0
			IF nHpaPo > 0
				IF ThisForm.ChecknHpaPO <> nHpaPo OR ThisForm.ChecknItemPO <> nItemPo
					ThisForm.cPOitem = cPOitem
					IF EMPTY(cHeat) OR UPPER(cHeat) = "DUE IN"
						IF ThisForm.GetPoItemDetail(cPOitem)
							ThisForm.ChecknItemPO = nItemPo
						ENDIF
					ELSE
						IF ThisForm.GetFromReceiving(cPOitem,nWO_Detail,cHeat,cLot)
							ThisForm.ChecknItemPO = nItemPo
						ENDIF
					ENDIF
		
				ELSE
					*Do not Recheck
				ENDIF
				IF EMPTY(ThisForm.txtVendor.Value)
					ThisForm.txtVendor.Value	= getVendor_Company_POitem( cPOitem, ThisForm.nConnHandle )
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtReceived.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE('dDate') = "C"
				dDate = CtoD(ALLTRIM(This.Value))
				This.Value = dDate
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
				This.Value = DATE()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtReceivingID.DblClick
		PRIVATE nMess
		nMess = MESSAGEBOX("Do you wish to reset Receiving ID to 0? (Y)"+CHR(13)+"Reseting to 0 will allow you to receive another Heat/Lot!",4+32,"Create new Receiving Record?")
		IF nMess = 6
			This.Parent.txtReceivingID.Value =0
			*This.Parent.txtID_Detail.Value	= 0
		ENDIF
	ENDPROC

	PROCEDURE txtRMA_Detail.Valid
		PRIVATE nRMA_Detail
		nRMA_Detail= PrepareSQLnum(This.Value,'RMA_Detail',-3)
		
		IF nRMA_Detail > 0
			ThisForm.Refresh_RMA_Detail()
		ENDIF
	ENDPROC

	PROCEDURE txtRMA_No.Valid
		*RMA_No Receive
		ThisForm.Validate_RMA()
		
		
	ENDPROC

	PROCEDURE txtSOitem.Valid
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(This.Value,'SOitem',2,0)
		
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
					ThisForm.cSOitem = cSOitem
				ENDIF
				ThisForm.GetSoItemDetail()
			ELSE
				DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSOItem
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				
					IF Count_SOIteminSales( cSOItem, ThisForm.nConnHandle, '' ) = 0
						*Problem
						MESSAGEBOX("HPA SOItem was not found."+CHR(13)+cSOItem+CHR(13)+"Cannot save!",48,"Bad SOItem Number")
						
						This.Value = 0
						ThisForm.txtSOnum.Value = 0
						ThisForm.cSOitem = Proper_SO_item('')
						
						RETURN .F.
					ENDIF
						
					ThisForm.cSOitem = cSOitem
					This.Value = Proper_SO_item_item(cSOitem)
					ThisForm.GetSoItemDetail()
				ENDIF
			ENDIF
		ELSE
			*do not have full SOitem
		ENDIF
	ENDPROC

	PROCEDURE txtSOnum.Valid
		PRIVATE cSOitem, nSalesNum, nItemSo, nOldSO
		nSalesNum	= PrepareSQLnum(This.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		nOldSO		= VAL(ThisForm.cSOitem)
		
		IF nOldSO > 0 AND nSalesNum > 0
			IF nOldSO <> nSalesNum 
				PRIVATE cPOitem, nHpaPo, nItemPo
				nHpaPo  = PrepareSQLnum(ThisForm.txtHPAPOnum.Value,'HPApo',-3)
				nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
				cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
				
				PRIVATE cMess, cSOitem
				
				cSOitem = PrepareSQLtxt(ThisForm.cSOitem,'SOitem',10)
				*cMess = "While Receiving for POitem='"+cPOitem+"'"
				cMess = "While Receiving for SOitem='"+cSOitem+"'"
				IF ThisForm.nReceivingid > 0
					cMess = cMess +CHR(13)+" ReceivingID="+ALLTRIM(STR(ThisForm.nReceivingid))
				ENDIF
				cMess = cMess +CHR(13)+" SalesNum="+ALLTRIM(STR(nOldSO ))+" was changed to"
				cMess = cMess +CHR(13)+" SalesNum="+ALLTRIM(STR(nSalesNum))+"."
				
				cMess = cMess +CHR(13)+CHR(13)+" POitem='"+cPOitem+"'"
				
				TrackMess(cMess)
			ENDIF
		ENDIF
		
		IF nSalesNum > 0 AND nItemSo > 0
		
			cSOitem 	= Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				ThisForm.cSOitem = cSOitem
			ENDIF
			*PRIVATE cPOitem, nHpaPo, nItemPo
			*nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
			*nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
			*cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
			*IF nSalesNum > 0 AND nHpaPo=0 AND nItemPo=0
				ThisForm.GetSoItemDetail()
			*ENDIF
		ELSE
			*do not have full SOitem
		ENDIF
	ENDPROC

	PROCEDURE txtVendor.Valid
		
		*IF is_Vendor_LabService(nHpaPo, ThisForm.nConnhandle)
		*		IF MESSAGEBOX("PO "+ALLTRIM(STR(nHPApo))+" is for a Test Report."+CHR(13)+"This is not the Vendor!"+CHR(13)+"Are you receiving to the right PO?"+CHR(13)+CHR(13)+"Do you still want to continue?",4+256+16,"Wrong PO") <> 6
				
	ENDPROC

	PROCEDURE txtWO.DblClick
		PRIVATE nWO
		nWO = PrepareSQLnum(This.Parent.txtWO.Value,'WO',-3)
		
		IF nWO > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO(nWO,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		
		ENDIF
	ENDPROC

	PROCEDURE txtWO.Valid
		PRIVATE nWO
		nWO = PrepareSQLnum(This.Value,'WO',-3)
		IF nWO > 0
			ThisForm.Getby_nWO(nWO)
		ENDIF
		
	ENDPROC

	PROCEDURE txtWO_Detail.DblClick
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(This.Value,'WO_Detail',-3)
		
		IF nWO_Detail > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO_Detail(nWO_Detail,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE txtWO_Detail.Valid
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(This.Value,'WO_Detail',-3)
		IF nWO_Detail > 0
			ThisForm.Getby_nWO_Detail(nWO_Detail)
		ENDIF
		
	ENDPROC

ENDDEFINE
