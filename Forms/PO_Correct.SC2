							ThisForm.txtReceivingID.Value = PrepareSQLnum(tmpPO_Process.ReceivingID,'ReceivingID',-3)
						ENDIF
						
						ThisForm.txtID_Master.Value	= PrepareSQLnum(tmpPO_Process.ID,'ID_Master',-3)
						ThisForm.txtID_Detail.Value	= PrepareSQLnum(tmpPO_Process.ID_Detail,'ID_Detail',-3)
						ThisForm.txtTBL.Value		= PrepareSQLtxt(tmpPO_Process.TBL,'TBL',1)
						ThisForm.txtForm.Value		= PrepareSQLtxt(tmpPO_Process.Form,'Form',2)
						
						ThisForm.txtWO.Value		= PrepareSQLnum(tmpPO_Process.WO,'WO',-3)
						*WO is not used for Receiving
						ThisForm.txtWO_Detail.Value	= 0
						
						**Field Received is not here, seen in Receiving table
						*IF nReceivingID > 0
						*	ThisForm.txtReceived.Value = PrepareSQLDate(tmpPO_Process.Received,'Received')
						*ELSE
							IF EMPTY(ThisForm.txtReceived.Value)
								ThisForm.txtReceived.Value = PrepareSQLDate(DATE(),'Received')
							ENDIF
						*ENDIF
						
						
						ThisForm.cPOitem 			= PrepareSQLtxt(cPOitem,'POitem',12)
						ThisForm.txtHpaPONum.Value 	= Proper_PO_Item_PO(ThisForm.cPOitem)
						ThisForm.txtHpaPOItem.Value = Proper_PO_Item_Item(ThisForm.cPOitem)
						
						PRIVATE cSOitem
						cSOitem = Proper_SO_item(PrepareSQLtxt(tmpPO_Process.SOitem,'SOitem',10))
						
						ThisForm.cSOitem			= ''
						ThisForm.txtSOnum.Value		= 0
						ThisForm.txtSOitem.Value	= 0
		
						IF cSOitem != Proper_SO_item("")	
							*Do not use a SOitem if it is Cancelled.
							IF Count_SOIteminSales(cSOitem, ThisForm.nConnHandle ) > 0
								IF Count_SOIteminSales(cSOitem, ThisForm.nConnHandle, "CANCEL") < 1
									ThisForm.cSOitem			= PrepareSQLtxt(tmpPO_Process.SOitem,'SOitem',10)
									ThisForm.txtSOnum.Value		= Proper_SO_Item_SO(ThisForm.cSOitem)
									ThisForm.txtSOitem.Value	= Proper_SO_Item_Item(ThisForm.cSOitem)
								ENDIF
							ENDIF
						ENDIF
						
						*******
										
						ThisForm.txtAlloy.Value		= PrepareSQLtxt(tmpPO_Process.Alloy,'Alloy',12)
