									ENDIF
									IF UPPER(cProcess_ID) = "NOT2HPA"
										nMess = MESSAGEBOX("Is this the 'NOT2HPA' record what you need to Edit?"+CHR(13)+"Process_ID:NOT2HPA"+CHR(13)+"Table:"+cTBL+CHR(13)+"POitem:"+cPOitem+CHR(13)+"Weight:"+STR(nPounds)+CHR(13)+"QTY:"+STR(nS_QTY)+CHR(13)+"Record:"+ALLTRIM(STR(nRecNum))+" of "+ALLTRIM(STR(nRecCount)),4,"Use this Data?")
									ENDIF
