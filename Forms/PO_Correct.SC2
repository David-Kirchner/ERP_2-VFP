		ThisForm.AskedReplaceDescrPO = .F.
	ENDPROC

	PROCEDURE Resize
		PRIVATE nHeight, nWidth
		nHeight	= This.Height - 370
		nWidth	= This.Width - 616
	ENDPROC

	PROCEDURE rma_receive
		*PARAMETERS pcSOitem
		*ThisForm.RMA_Receive()
		
		
		*Old, disable this
		
		
		
		
		
		PRIVATE nRMA
		nRMA = ThisForm.nRMA
		
		PRIVATE cPOitem, cSOitem
		cPOitem = PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)
		cSOitem = ThisForm.cSOitem
		
		
		IF EMPTY(cSOitem)
			MESSAGEBOX("Cannot process RMA return without the SOitem!"+CHR(13)+"RMA:"+ALLTRIM(STR(nRMA))+".",0+32,"No SO-item")
			RETURN .F.
		ENDIF
		
		PRIVATE nDec, nItemSo, nSalesNum 
		nSalesNum = Proper_SO_Item_SO(cSoItem)
		nItemSo = Proper_SO_Item_Item(cSOitem)
		
		ThisForm.txtSOnum.Value = nSalesNum 
		ThisForm.txtSOnum.Refresh
		ThisForm.txtSOitem.Value = nItemSo 
		ThisForm.txtSOitem.Refresh	
		
		
		*Get ID_Detail
		IF USED('tmpStockLst_Process_History')
			USE IN tmpStockLst_Process_History
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT ID_Detail FROM dbo.Ar_StockLst_Process_History "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ([WHAT] = 'SUBED     ' OR [WHAT] = 'DELETE    ')"
		cSQL = cSQL + " ORDER BY [WHAT] DESC "
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT ID_Detail FROM dbo.Ar_BrokerLst_Process_History "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ([WHAT] = 'SUBED     ' OR [WHAT] = 'DELETE    ')"
		cSQL = cSQL + " ORDER BY [WHAT] DESC "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Process_History')
			MESSAGEBOX("Cannot process RMA return.",0+32,"No ID_Detail")
			RETURN .F.
		ENDIF
		
		PRIVATE nID_Detail 
		nID_Detail = 0
		IF USED('tmpStockLst_Process_History')
			IF VARTYPE(tmpStockLst_Process_History.ID_Detail) = "N"
				nID_Detail = tmpStockLst_Process_History.ID_Detail
			ENDIF
			USE IN tmpStockLst_Process_History
		ENDIF
		
		PRIVATE cTBL
		IF nID_Detail > 0
			cTBL = "S"
		ELSE
			*Check BrokerLst
			cSQL = "SELECT ID_Detail FROM dbo.Ar_BrokerLst_Process_History "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND [WHAT] = 'DELETE    '"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process_History")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process_History")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Process_History')
				MESSAGEBOX("Cannot process RMA return.",0+32,"No ID_Detail")
				RETURN .F.
			ENDIF
			IF USED('tmpStockLst_Process_History')
				IF VARTYPE(tmpStockLst_Process_History.ID_Detail) = "N"
					nID_Detail = tmpStockLst_Process_History.ID_Detail
					cTBL = "B"
				ENDIF
				USE IN tmpStockLst_Process_History
			ELSE
				MESSAGEBOX("Could not retrieve ID_Detail.",0+32,"No StockLst info")
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE nStockLst_ID
		nStockLst_ID = Get_ID_with_ID_Detail(nID_Detail,cTBL,ThisForm.nConnHandle)
		
		
		**************** StockLst_Master 
		IF nStockLst_ID = 0
			MESSAGEBOX("Could not retrieve ID.",0+32,"No StockLst info")
			*RETURN .F.
		ENDIF
		
		IF cTBL = "S"
			cSQL = "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.StockLst_Master WHERE ID = "+STR(nStockLst_ID)
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.Ar_Stocklst_Master_History WHERE ID = "+STR(nStockLst_ID)
		ELSE
			cSQL = "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.BrokerLst_Master WHERE ID = "+STR(nStockLst_ID)
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.Ar_BrokerLst_Master_history WHERE ID = "+STR(nStockLst_ID)
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstID')
			MESSAGEBOX("Could not retrieve ID Info.",0+32,"No StockLst info")
		ENDIF
		
		
		IF USED('tmpStockLstID')
			IF VARTYPE(tmpStockLstID.Alloy)="C" &&Alloy
				IF !EMPTY(tmpStockLstID.Alloy)
					ThisForm.txtAlloy.Value = tmpStockLstID.Alloy
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Heat)="C" &&Heat
				IF !EMPTY(tmpStockLstID.Heat)
					ThisForm.txtHeat.Value = tmpStockLstID.Heat
				ENDIF
			ENDIF
			
			IF VARTYPE(tmpStockLstID.Lot)="C" &&Lot
				IF !EMPTY(tmpStockLstID.Lot)
					ThisForm.txtLot.Value = tmpStockLstID.Lot
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Specs)="C"  &&Specs
				IF !EMPTY(tmpStockLstID.Specs)
					ThisForm.edtSpecs.Value = tmpStockLstID.Specs
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Mill)="C"  &&Mill 
				IF !EMPTY(tmpStockLstID.Mill)
					ThisForm.txtVendor.Value = tmpStockLstID.Mill 
				ENDIF
			ENDIF
		
			USE IN tmpStockLstID
		ENDIF
		
		*************** StockLst_Detail 
		
		IF USED('tmpStockLstDetail')
			USE IN tmpStockLstDetail
		ENDIF
		
		IF cTBL = "S"
			cSQL = "SELECT PC, dbo.f_ItemDescription(dbo.StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.StockLst_Detail WHERE ID_Detail ="+STR(nID_Detail)
			cSQL = cSQL + " Union "
			cSQL = cSQL + "SELECT PC, dbo.f_ItemDescription(dbo.StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.Ar_Stocklst_Detail_History WHERE ID_Detail ="+STR(nID_Detail)
		ELSE
			cSQL = "SELECT PC, dbo.f_ItemDescription(dbo.BrokerLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.BrokerLst_Detail WHERE ID_Detail ="+STR(nID_Detail)
			cSQL = cSQL + " Union "
			cSQL = cSQL + "SELECT PC, dbo.f_ItemDescription(dbo.BrokerLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.Ar_BrokerLst_Detail_History WHERE ID_Detail ="+STR(nID_Detail)
		ENDIF
		*SELECT PC, dbo.f_ItemDescription(dbo.StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.StockLst_Detail WHERE ID_Detail = 5657
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstDetail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstDetail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstDetail')
			MESSAGEBOX("Could not retrieve ID Detail Info.",0+32,"No StockLst info")
		ENDIF
		
		IF USED('tmpStockLstDetail')
			GO TOP
			IF VARTYPE(tmpStockLstDetail.PC)="N"  &&Pieces
				IF tmpStockLstDetail.PC > 0
					ThisForm.txtPieces.Value = tmpStockLstDetail.PC
				ENDIF
			ENDIF
			IF VARTYPE(tmpStockLstDetail.Description)="C"  &&Description
				IF !EMPTY(tmpStockLstDetail.Description)
					ThisForm.edtDescription.Value = tmpStockLstDetail.Description
				ENDIF
			ENDIF
			
			USE IN tmpStockLstDetail
			
			ThisForm.Edit1.Value = ThisForm.Edit1.Value+CHR(13)+"Retrieved: receive again after RMA."
			ThisForm.Refresh	
			ThisForm.txtReceivingID.Value = 0
		ENDIF
		
		********** Sales
		
		ThisForm.txtActualW.Value		= 0
		ThisForm.txtBillW.Value 		= 0
		
		ThisForm.txtAcct_Qty.Value	= Get_From_AllQuote_SOitem (cSoItem, "S_QTY", ThisForm.nConnHandle )
		ThisForm.txtAcct_P.Value	= 0
		
		PRIVATE nAcct_PU
		*nAcct_PU = PrepareSQLnum( Get_From_AllQuote_SOitem (ThisForm.cSOitem, "Quoted_PU", ThisForm.nConnHandle ),'Recv_PU',-1)	&&Cust 
		nAcct_PU = GetPUfromForm(  Get_From_AllQuote_SOitem (cSOitem, "Form", ThisForm.nConnHandle ) )
		ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nAcct_PU, 'PO_PU',2)
		ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
		ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nAcct_PU , ThisForm.nConnHandle)
		*
		PRIVATE nCust_PU
		nCust_PU = PrepareSQLnum( Get_From_Sales_SOitem (ThisForm.cSOitem, "Quoted_PU", ThisForm.nConnHandle ),'Recv_PU',-1)	&&Cust 
		ThisForm.lblPO_PU.Caption 		= PrepareSQLtxt(nAcct_PU, 'PO_PU',2)
		ThisForm.lblPO_PUstr.Caption	= Get_PUstr_from_nPU(nAcct_PU, ThisForm.nConnHandle)
		ThisForm.lblPO_PUlabel.Caption	= Get_Label_from_nPU(nAcct_PU, ThisForm.nConnHandle)
		
		ThisForm.txtPO_QTY.Value 	= PrepareSQLnum( Get_From_Sales_SOitem (cSoItem, "Quoted_QTY", ThisForm.nConnHandle ),'Quoted_QTY',-5)
		ThisForm.txtPO_P.Value		= PrepareSQLnum( Get_From_Sales_SOitem (cSoItem, "Quoted_P", ThisForm.nConnHandle ),'Quoted_P',-5)
		
		
		cSQL = "SELECT matlwt FROM dbo.Sales WHERE SOitem = '"+cSOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesWt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesWt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesWt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesWt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesWt')
			MESSAGEBOX("Could not retrieve Sales Weight.",0+32,"No info")
		ENDIF
		
		IF USED('tmpSalesWt')
			GO TOP
			IF VARTYPE(tmpSalesWt.matlwt)="N"  &&Pieces
				IF tmpSalesWt.matlwt > 0
					ThisForm.txtActualW.Value = tmpSalesWt.matlwt 
					ThisForm.txtBillW.Value = tmpSalesWt.matlwt 
				ENDIF
			ENDIF
			
			USE IN tmpSalesWt
		ENDIF
		
		*************** AllQuotes
		IF USED('tmpAllQuotes')
			USE IN tmpAllQuotes
		ENDIF
		
		cSQL = "SELECT Alloy,Pieces,Form,dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Weight,RandLen) AS Description,Weight FROM dbo.AllQuotes WHERE SOitem ='"+cSOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAllQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAllQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpAllQuotes')
			MESSAGEBOX("Could not retrieve AllQuotes Info.",0+32,"No StockLst info")
		ENDIF
		
		IF USED('tmpAllQuotes')
			GO TOP
			IF VARTYPE(tmpAllQuotes.Alloy)="C" &&Alloy
				IF !EMPTY(tmpAllQuotes.Alloy)
					ThisForm.txtAlloy.Value = tmpAllQuotes.Alloy
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Pieces)="N"  &&Pieces
				IF tmpAllQuotes.Pieces > 0
					ThisForm.txtPieces.Value = tmpAllQuotes.Pieces
				ENDIF
			ENDIF
			
			ThisForm.txtForm.Value = PrepareSQLtxt(tmpAllQuotes.Form,'Form',2)	
			
			IF VARTYPE(tmpAllQuotes.Description)="C"  &&Description
				IF !EMPTY(tmpAllQuotes.Description)
					ThisForm.edtDescription.Value = tmpAllQuotes.Description
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Weight)="N"  &&Weight 
				IF tmpAllQuotes.Weight > 0
					ThisForm.txtActualW.Value = tmpAllQuotes.Weight 
					ThisForm.txtBillW.Value = tmpAllQuotes.Weight 
				ENDIF
			ENDIF
			USE IN tmpAllQuotes
		ENDIF
			
		SELECT Receiving
		
		ThisForm.chkCert.Value		= 1
		ThisForm.chkCofC.Value		= 0
		ThisForm.chkMillTrace.Value	= 0
		
		ThisForm.edtComments.Value	= ''
		ThisForm.txtInit.Value 		= ''
		ThisForm.txtDate.Value 		= DTOC(DATE())
		ThisForm.chkPass.Value		= PrepareSQLlogic(1,'Pass')
		ThisForm.chkGoodPapers.Value= PrepareSQLlogic(1,'GoodPapers')
		
		ThisForm.chkLab_Service.Value= PrepareSQLlogic(0,'Services')
		ThisForm.chkConvServ.Value	= PrepareSQLlogic(0,'ConvServ') 
		ThisForm.chkEquipment.Value	= PrepareSQLlogic(0,'Equipment')
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETER pSaveType
		*ThisForm.SaveAdd(pSaveType)	ADD	  ADDCLONE	EDIT
		
		IF TYPE("pSaveType") != "C"
			MESSAGEBOX("No pSaveType for SaveAdd(pSaveType)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No pSaveType for SaveAdd(pSaveType)" )
			RETURN
		ENDIF
		
		PRIVATE lSQLgood, lNeedSave, lSaved, lAlready_Saved, lRMA
		lSQLgood = .T.
		lNeedSave = .T.
		lSaved = .F.
		lAlready_Saved = .F.
		lRMA = .F.
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		nHpaPo		= PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPAPO',-3,0)
		nItemPo		= PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSONum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		
		* NOTE cPOitem is not used on customers material like a SO is a Toll Service Order
		PRIVATE nCountPOitem
		nCountPOitem = 0
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item("")
			nCountPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, '' ) 
		ENDIF
		
		PRIVATE nCountSOitem
		nCountSOitem = 0
		IF Proper_SO_Item(cSOitem) <> Proper_SO_Item("")
			nCountSOitem = Count_SOIteminSales( cSOItem, ThisForm.nConnHandle, 'CONVERSIONSERVICE' )
			IF nCountSOitem = 0
				nCountSOitem = Count_SOIteminSales( cSOItem, ThisForm.nConnHandle, 'PRODUCTION' )
			ENDIF
		ENDIF
		
		PRIVATE nWO_Detail, nWO
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE nRMA_No, nRMA_Detail
		nRMA_No		= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA',-3)
		nRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		
		IF nRMA_No > 0
			IF RMA_Exists(nRMA_No, ThisForm.nConnHandle)
				lRMA = .T.
				IF PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1) <> "S"
					RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"RMA > 0 and RMA Exists, so StockLst_TBL is set to 'S' ." )
				ENDIF
				ThisForm.txtTBL.Value = "S"
				ThisForm.cTBL 	= "S"
				ThisForm.txtTBL.Value = "S"
				ThisForm.StockLst_TBL = "S"
			ENDIF
		ENDIF
		
		IF nCountPOitem = 0 AND nCountSOitem = 0 AND nWO_Detail = 0 AND nWO = 0 AND nWO = 0 AND nRMA_No = 0
			IF Proper_SO_Item(cSOitem) <> Proper_SO_Item("")
			
				MESSAGEBOX("Sales Order item "+cSOitem+" is not a Conversion Service!"+CHR(13)+"This program is to Receive material."+CHR(13)+"The program does not know how to process."+CHR(13)+"Have the Sales Rep fix as Converion Service"+CHR(13)+"or get the WO Detail to receive this material to.",16,"Cannot Save")
				TrackError("Checked for POitem, WO_Detail, WO. "+CHR(13)+"Sales Order item "+cSOitem+" is not a Conversion Service","Did not Find a PO or Work Order to RECEIVE to", PROGRAM(), LINENO(1))
				RETURN .F.
			ELSE
				MESSAGEBOX("Checked for POitem, SOitem, WO_Detail, WO. "+CHR(13)+"Did not find any Order to work with",48,"Weird")
				TrackError("Checked for POitem, SOitem, WO_Detail, WO. "+CHR(13)+"Did not find any Order to work with","Did not Find an Order", PROGRAM(), LINENO(1) )
			ENDIF
		ENDIF
		
		IF nReceivingID = 0
			nReceivingID = ThisForm.SaveAsNewReceiving()
		ENDIF
		
		
		PRIVATE nID_Master, nID_Detail, nID_Detail_PRC, cTBL, cForm
		nID_Master = PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3)
		nID_Detail = PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
		nID_Detail_PRC = PrepareSQLnum(Thisform.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		cTBL 		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		cForm		= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		
		
		PRIVATE dReceived, cAlloy, cHeat, cLot, lCert, lCofC, lMillTrace, nPieces, cDescription
		PRIVATE cSpecs, cComments, cInit, dDate, lPass_PW, lGoodPapers, lHold, nActualW, nBillW, cVendor
		PRIVATE cRejectReason
		dReceived	= PrepareSQLdate(ThisForm.txtReceived.Value,'Received')
		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= UPPER(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50,.f.))
		cLot 		= UPPER(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		lCert		= PrepareSQLchk(ThisForm.chkCert.Value,'Cert')
		lCofC		= PrepareSQLchk(ThisForm.chkCofC.Value,'CofC')
		lMillTrace	= PrepareSQLchk(ThisForm.chkMillTrace.Value,'MillTrace')
		nPieces		= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
		cDescription= PrepareSQLtxt(ThisForm.edtDescription.Value,'Description',-1,.F.)
		cSpecs		= PrepareSQLtxt(ThisForm.edtSpecs.Value,'Specs',-1)
		cComments	= PrepareSQLtxt(ThisForm.edtComments.Value,'Comments',-1,.F.)
		cInit		= PrepareSQLtxt(ThisForm.txtInit.Value,'Init',10 )
		dDate		= PrepareSQLdate(ThisForm.txtDate.Value,'Date')
		lPass_PW	= PrepareSQLlogic(Thisform.chkPass.Value,'Pass')
		lGoodPapers	= PrepareSQLlogic(ThisForm.chkGoodPapers.Value,'GoodPapers')
		lHold		= PrepareSQLlogic(ThisForm.chkHold.Value,'Hold')
		nActualW	= PrepareSQLnum(ThisForm.txtActualW.Value,'Actual',9,1)
		nBillW		= PrepareSQLnum(ThisForm.txtBillW.Value,'BillW',9,1)
		
		PRIVATE nAcct_QTY, nAcct_P, nAcct_PU
		nAcct_QTY	= PrepareSQLnum(ThisForm.txtAcct_Qty.Value,'S_QTY',-5)	&&Acct
		nAcct_P		= PrepareSQLnum(ThisForm.txtAcct_P.Value,'S_P',-5)	
		nAcct_PU	= PrepareSQLnum(ThisForm.lblAcct_PU.Caption,'PU',-1)
		PRIVATE nPO_QTY, nPO_P, nPO_PU
		nPO_QTY = PrepareSQLnum(ThisForm.txtPO_QTY.Value,'PO_QTY',-5)	&&Vendor
		nPO_P	= PrepareSQLnum(ThisForm.txtPO_P.Value,'PO_P',-5)	&&Vendor
		nPO_PU	= PrepareSQLnum(ThisForm.lblPO_PU.Caption,'PU',-1)
		
		***************
		cVendor		= PrepareSQLtxt(ThisForm.txtVendor.Value,'Vendor',30,.F.,.T. )
		cRejectReason= PrepareSQLtxt(ThisForm.edtRejectReason.Value,'RejectReason',255,.f. )
		
		**********************
		PRIVATE lServicesPO, lConvServ, lEquipment
		lServicesPO		= PrepareSQLlogic(ThisForm.chkLab_Service.VALUE,'ServicesPO',.F.)
		lConvServ		= PrepareSQLlogic(ThisForm.chkConvServ.VALUE,'ConvServ',.f.)
		lEquipment		= PrepareSQLlogic(ThisForm.chkEquipment.VALUE,'Equipment',.F.)
		
		
		*cComments
		PRIVATE lLabServices, nCountPOitem 
		lLabServices = .F.
		nCountPOitem = 0
		
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
			*Is this a Lab Test?
			*lLabService = Get_From_POitem (cPOitem, "Field", ThisForm.nConnHandle )
			
			nCountPOitem = PO_POitem_Cnt( cPOitem, ThisForm.nConnHandle, 'SERVICES' ) &&NOTRECEIVE includes (Services AND ConvServ AND Equipment)
			
			IF nCountPOitem > 0 OR lServicesPO
				lLabServices = .T.
				
				IF NOT "Received data from paid Services" $ cComments
					IF LEN(cComments)>0
						cComments = cComments+ CHR(13)
					ENDIF
					cComments = cComments+ "Received data from paid Services "
				ENDIF
			ENDIF
		ENDIF
		
		*********************
		PRIVATE lHaveWOD 
		lHaveWOD = .F.
		IF nWO_Detail > 0
			IF EMPTY(cComments)
				cComments = "From Work Order Detail "+STR(nWO_Detail)
			ENDIF
			lHaveWOD = .T.
		ENDIF
		
		************************
		PRIVATE cTBL, nID_Detail, lDetail_History
		cTBL 			= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		nID_Detail		= PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
		*Is there History for this Detail?
		IF nID_Detail > 0
			lDetail_History = Has_ID_Detail_History( nID_Detail, cTBL, ThisForm.nConnhandle)
		ELSE
			lDetail_History = .F.
		ENDIF
		
		**********************
		
		IF NOT lPass_PW AND NOT lDetail_History AND NOT lHaveWOD
			IF nReceivingID > 0
				IF lHold
					MESSAGEBOX("Since this material did not PASS Specs,"+CHR(13)+"this will be considered on ReceiveOnHold."+CHR(13)+CHR(13)+"The PO Sales Rep will be notified"+CHR(13)+"daily so this order can be fixed.",48,"On Receive Hold")
					Send_Chatter("ReceivingID_Hold",nReceivingID,"BLANK","The receiving material for ReceivingID "+ALLTRIM(STR(nReceivingID))+", Placed on Receive OnHold."+CHR(13)+HTML_ReceivingID(nReceivingID,.T.),ThisForm.nConnHandle)
					*Send_Chatter("QA",0,"BLANK","The receiving material did not PASS Specs for ReceivingID "+ALLTRIM(STR(nReceivingID))+", Placed on QA Hold.",ThisForm.nConnHandle)
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT (lServicesPO OR lConvServ OR lEquipment)
			IF NOT lMillTrace AND NOT lDetail_History AND NOT lHaveWOD
				IF lHold
					*Assume they held it because it did not pass
				ELSE
					lHold = .F.
					ThisForm.chkHold.Value = 0
				ENDIF
			ELSE
				*Do not mess with an edited stock			
			ENDIF
		ELSE
			Hold = .F.
		ENDIF
		
		************************
		** End Testing
		************************
		PRIVATE nReceivingIDOld 
		nReceivingIDOld = 0
		
		**********************
		IF USED('tmpCountPOitem')
			USE IN tmpCountPOitem
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, cSQLu
		PRIVATE lSaveByOldMethod
		lSaveByOldMethod = .T.
		cSQL=''
		***
		
		PRIVATE lFoundStockUpdateReceiving, lRan_Show_Recv_Order
		lFoundStockUpdateReceiving = .F.
		lRan_Show_Recv_Order = .F.
		
		PRIVATE nCntPOitemMetal
		nCntPOitemMetal = 0
		IF Proper_PO_item(cPOItem) = Proper_PO_item('')
			nCntPOitemMetal = -1
		ELSE
			nCntPOitemMetal = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "NOT SERVICES CONVSERV EQUIPMENT" )  && count of metal stock
			IF nCntPOitemMetal > 0
				*Count for Service and Not Received
				nCntPOitemMetal = PO_POitem_Cnt( cPOitem, ThisForm.nConnHandle, 'NOTRECEIVE' )	&&Count of Not Services
			ENDIF
		ENDIF
		
		IF lLabServices 
			nCntPOitemMetal = 0
		ENDIF
		
		********************
		IF EMPTY(cTBL) && ThisForm.cTBL
		*cTBL = getTBL_POitem(cPOitem, ThisForm.nConnhandle ) 
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				cTBL = getTBL_POitem(cPOitem, ThisForm.nConnhandle ) 
			ELSE
				IF nWO_Detail > 0
					cTBL = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle )
				ELSE
					cTBL = ThisForm.cTBL
				ENDIF
			ENDIF
		ENDIF
		
		********************
		PRIVATE nPOcomplete
		nPOcomplete = 0
		
		*****************************
		**Show Receive by POitem or WO_Detail
		IF nHPApo > 0 AND NOT (lServicesPO or lConvServ or lEquipment)
			IF nCntPOitemMetal > 0 
			* OR nWO_Detail > 0 would have to be the Complete WOD
				IF nReceivingID > 0 AND NOT lRMA
					PRIVATE nReceivingIDnow
					IF nReceivingIDOld = 0
						*New Add, Invert nReceivingID to Show as an Add
						nReceivingIDnow = -nReceivingID  
					ELSE
						nReceivingIDnow = nReceivingID  
					ENDIF
					*DO FORM Forms\ShowReceived_Ordered WITH "What", cPOitem, cAlloy,cHeat,nPieces,nAcct_QTY,nActualW,cDescription,nReceivingIDnow,cTBL,nID_Detail,clot TO nPOcomplete
					DO FORM Forms\Show_Recv_Order WITH "POitem",cPOitem, cAlloy,cHeat,nPieces,nAcct_QTY,nActualW,cDescription,nReceivingIDnow,cTBL,nID_Detail,cLot,nID_Master  TO nPOcomplete
					lRan_Show_Recv_Order = .T.
					
					nWO_Detail = PrepareSQLnum(nWO_Detail,'WO_Detail',-3)  &&What changes this to Text
								
					IF VARTYPE(nPOcomplete) = 'N'
					
						IF nPOcomplete > FLOOR(nPOcomplete)
							*Remove Decimal point
							*Have ID_Detail       *ID_Detail = ALLTRIM(STR(nID_Detail,10,10))
		
							cTBL = Get_TBL_by_ReceivingID(nReceivingID,ThisForm.nConnHandle)
							nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisForm.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = ROUND((nPOcomplete - FLOOR(nPOcomplete))*10000000000,0)
								TrackError("nPOcomplete="+STR(nPOcomplete,12,10)+", nID_Detail="+STR(nID_Detail)+", cPOitem="+cPOitem+", nReceivingID="+STR(nReceivingID)+", cTBL="+cTBL,"Tried ID_Detail", PROGRAM(), LINENO(1))
							ENDIF
							IF nID_Detail > 0
								*nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,cTBL,ThisForm.nConnHandle)
								IF LEN(cTBL)>0 AND cTBL<>"N"
									nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
								ENDIF
							ENDIF
							nPOcomplete  = FLOOR(nPOcomplete)
						ENDIF
		
						
						*nPOcomplete = PrepareSQLnum(nPOcomplete,'nPOcomplete',-1)
						*nPOcomplete = 0 no Choice, 1 Not Complete, 2 Complete, 3 Edit
						DO CASE
						CASE nPOcomplete = 0
							* Abort this receive
							ThisForm.AbortThisReceive(nReceivingID)
							RETURN .F.
						CASE FLOOR(nPOcomplete) = 1
							*Partial ShowReceived_Ordered
						CASE FLOOR(nPOcomplete) = 2
							*Complete in ShowReceived_Ordered 
						CASE FLOOR(nPOcomplete) = 3
							*Good, Just Editing the Receiving Record.
						ENDCASE
					ELSE
						TrackError("DO FORM Forms\Show_Recv_Order returned nPOcomplete that was not 0,1,2"+CHR(13)+"nReceivingID > 0 AND NOT lRMA" ,"bad return",PROGRAM(),LINENO(1))
						*RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"DO FORM Forms\ShowReceived_Ordered returned nPOcomplete that was not 0,1,2"+CHR(13)+"nReceivingID > 0 AND NOT lRMA")
						RETURN .F.
					ENDIF
					
					*****************************
					IF nID_Detail = 0
						*See if ShowReceived_Ordered created stock
						
						cSQL = "SELECT StockTable AS TBL, ID_Master, ID_Detail FROM dbo.Receiving WITH(NOLOCK) WHERE ID ="+STR(nReceivingIDnow)
						
						IF USED("tmpReceiveID")
							USE IN tmpReceiveID
						ENDIF
						SELECT 0
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpReceiveID')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpReceiveID')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceiveID")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReceiveID")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpReceiveID')
							*TrackMess("Error with Add Receiving ID:"+ALLTRIM(STR(nReceivingID)) )
							TrackError("Check for Existing Record. "+CHR(13)+cSQL ,"bad select",PROGRAM(),LINENO(1))
						ELSE
							IF RECCOUNT('tmpReceiveID') > 0
								cTBL 					= PrepareSQLtxt(tmpReceiveID.TBL,'TBL',1)
								ThisForm.txtTBL.Value 	= PrepareSQLtxt(tmpReceiveID.TBL,'TBL',1)
								nID_Master					= PrepareSQLnum(tmpReceiveID.ID_Master,'ID_Master',-3)
								ThisForm.txtID_Master.Value = nID_Master 
								nID_Detail					= PrepareSQLnum(tmpReceiveID.ID_Detail,'ID_Detail',-3)
								ThisForm.txtID_Detail.Value = nID_Detail
								
								USE IN tmpReceiveID
							ENDIF
						ENDIF
					ENDIF
					
				ENDIF
				IF nReceivingID > 0 AND lRMA
					nPOcomplete = 2
				ENDIF
			ELSE
				
				IF nWO_Detail > 0
					*Check to see if this is repeatative
					*cTBL 					= PrepareSQLtxt(tmpReceiveID.TBL,'TBL',1)
					*ThisForm.txtTBL.Value 	= PrepareSQLtxt(tmpReceiveID.TBL,'TBL',1)
					*nID_Master					= PrepareSQLnum(tmpReceiveID.ID_Master,'ID_Master',-3)
					*ThisForm.txtID_Master.Value = nID_Master 
					*nID_Detail					= PrepareSQLnum(tmpReceiveID.ID_Detail,'ID_Detail',-3)
					*ThisForm.txtID_Detail.Value = nID_Detail
				ELSE
					*SERVICES CONVSERV EQUIPMENT
					IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "SERVICES" ) > 0
						*lPass_PW
						IF nWO > 0
							lOK = Update_WO_POitem_Test( nWO, cPOItem, ThisForm.nConnHandle, lPass_PW)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		**Show Receive by WO_Detail
		
		IF FLOOR(nPOcomplete) = 0
			IF nWO_Detail > 0 AND NOT (lServicesPO or lConvServ or lEquipment)
				
			*	IF nCntPOitemMetal > 0
					IF nReceivingID > 0
						PRIVATE nReceivingIDnow
						IF nReceivingIDOld = 0
							*New Add, Invert nReceivingID to Show as an Add
							nReceivingIDnow = -nReceivingID  
						ELSE
							nReceivingIDnow = nReceivingID  
						ENDIF
						
						PRIVATE cWOD
						cWOD = "WOD"+STR(nWO_Detail)
						
						DO FORM Forms\Show_Recv_Order WITH "WOD",nWO_Detail, cAlloy,cHeat,nPieces,nAcct_QTY,nActualW,cDescription,nReceivingIDnow,cTBL,nID_Detail,cLot,nID_Master TO nPOcomplete
						lRan_Show_Recv_Order = .T.
						
						nWO_Detail = PrepareSQLnum(nWO_Detail,'WO_Detail',-3)  &&What changes this to Text
						
						IF VARTYPE(nPOcomplete) = 'N'
							IF nPOcomplete > FLOOR(nPOcomplete)
								cTBL = Get_TBL_by_ReceivingID(nReceivingID,ThisForm.nConnHandle)
								IF LEN(cTBL) = 0
									nID_Detail = 0
									nID_Master = 0
								ELSE
									nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisForm.nConnHandle)
									IF nID_Detail > 0
			*							nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,cTBL,ThisForm.nConnHandle)
										nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
									ENDIF
								ENDIF
								nPOcomplete  = FLOOR(nPOcomplete)
							ENDIF
						ENDIF
						
						IF VARTYPE(nPOcomplete) = 'N'
							nPOcomplete = PrepareSQLnum(nPOcomplete,'nPOcomplete',-1)
							*nPOcomplete = 0 no Choice, 1 Not Complete, 2 Complete
							*PrepareSQLnum((2+"."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
							DO CASE
							CASE FLOOR(nPOcomplete) = 0
								* Abort this receive
								ThisForm.AbortThisReceive(nReceivingID)
								
								RETURN .F.
							CASE FLOOR(nPOcomplete) = 1
								*OR Good, Receive matches PO,  ** NOT Complete **
								IF nReceivingID > 0
									nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisForm.nConnHandle)  
									IF nID_Detail > 0
			*							nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,cTBL,ThisForm.nConnHandle)
										nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
									ENDIF
									ThisForm.txtID_Master.Value = nID_Master 
									ThisForm.txtID_Detail.Value = nID_Detail 
								ENDIF
								IF nID_Detail = 0
									ThisForm.txtID_Detail_Process.Value = 0
								ELSE
									ThisForm.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisForm.nConnHandle)  
								ENDIF
							
							CASE FLOOR(nPOcomplete) = 2
								*Good, Receive matches PO and COMPLETES the PO Item!
								IF nReceivingID > 0
									nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisForm.nConnHandle)
									IF nID_Detail > 0
			*							nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,cTBL,ThisForm.nConnHandle)
										nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
									ENDIF  
									ThisForm.txtID_Master.Value = nID_Master 
									ThisForm.txtID_Detail.Value = nID_Detail 
								ENDIF
								IF nID_Detail = 0
									ThisForm.txtID_Detail_Process.Value = 0
								ELSE
									ThisForm.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisForm.nConnHandle)  
								ENDIF
								
							CASE FLOOR(nPOcomplete) = 3
								*Good, Just Editing the Receiving Record.
								IF nReceivingID > 0
									nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisForm.nConnHandle)  
									IF nID_Detail > 0
			*							nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,cTBL,ThisForm.nConnHandle)
										nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
									ENDIF
									ThisForm.txtID_Master.Value = nID_Master 
									ThisForm.txtID_Detail.Value = nID_Detail 
								ENDIF
								IF nID_Detail = 0
									ThisForm.txtID_Detail_Process.Value = 0
								ELSE
									ThisForm.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisForm.nConnHandle)  
								ENDIF
								
							ENDCASE
						ELSE
							TrackError("DO FORM Forms\Show_Recv_Order returned nPOcomplete that was not 0,1,2"+CHR(13)+cWOD ,"bad return",PROGRAM(),LINENO(1))
							*RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"DO FORM Forms\ShowReceived_Ordered returned nPOcomplete that was not 0,1,2"+CHR(13)+cWOD )
							RETURN .F.
						ENDIF
					ENDIF
			*	ELSE
			*!*			*This Receive is for a Service
			*!*			IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "SERVICES" ) > 0
			*!*				*lPass_PW
			*!*				IF nWO_Detail > 0	&&getWOD_POitem(nWO_Detail, cPOItem, ThisForm.nConnHandle,'TestPO')
			*!*					lOK = Update_WOD_POitem_Test( nWO_Detail, cPOItem, ThisForm.nConnHandle, lPass_PW)
			*!*				ENDIF
			*!*			ENDIF
				*ENDIF
			ENDIF
		ENDIF
		
		
		
		
		*nPOcomplete 0,1,2,3
		*nPOcomplete USE Floor() becuase a ID_Detail is sent in Decimal
		
		**************************************************************
		**********************************************************************************
		*Test Table - Get rid of 'N'
		IF pSaveType = "ADD" OR pSaveType = "ADDCLONE"
			IF nCntPOitemMetal > 0	&&nCntPOitemMetal  is -1 when WO_Detail  --Checked in next code block
				IF nID_Detail_PRC = 0
					IF FLOOR(nPOcomplete) = 1
						IF nWO_Detail > 0
							cTBL = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
						ELSE
							cTBL = getTBL_Poitem(cPOitem, ThisForm.nConnhandle) 
						ENDIF
						
						nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisForm.nConnHandle) 
						IF nID_Detail_PRC > 0 AND ( cTBL="S" OR cTBL="B" OR cTBL="W" )
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisForm.nConnHandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
							Thisform.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							Thisform.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
							IF nID_Detail = 0
								ThisForm.txtID_Detail_Process.Value = 0
							ELSE
								ThisForm.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisForm.nConnHandle)  
							ENDIF
						ENDIF
					ENDIF
					IF FLOOR(nPOcomplete) = 2 
						*TBL could be anything except 'N'
						IF cTBL='N'
							IF nWO_Detail > 0
								cTBL = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
							ELSE
								cTBL = getTBL_Poitem(cPOitem, ThisForm.nConnhandle) 
							ENDIF
						ENDIF
						
						nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisForm.nConnHandle) 
						
						IF nID_Detail_PRC > 0 AND ( cTBL="S" OR cTBL="B" OR cTBL="W" )
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisForm.nConnHandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
							Thisform.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							Thisform.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
							IF nID_Detail = 0
								ThisForm.txtID_Detail_Process.Value = 0
							ELSE
								ThisForm.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisForm.nConnHandle)  
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			*****
			IF nWO_Detail > 0
				IF nID_Detail_PRC = 0
					IF FLOOR(nPOcomplete) = 1
						*An Add would be for Stock, -- get data After Show Receive VS Ordered
						cTBL = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
						
						nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisForm.nConnHandle)
						IF nID_Detail_PRC > 0  AND ( cTBL="S" OR cTBL="B" OR cTBL="W" )
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisForm.nConnHandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
							Thisform.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							Thisform.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
							IF nID_Detail = 0
								ThisForm.txtID_Detail_Process.Value = 0
							ELSE
								ThisForm.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail,ThisForm.nConnHandle)  
							ENDIF
						ENDIF
					ENDIF
					IF FLOOR(nPOcomplete) = 2 
						*TBL could be anything except 'N'
						IF cTBL='N'
							cTBL = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
						ENDIF
						
						nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisForm.nConnHandle) 
						IF nID_Detail_PRC > 0 AND ( cTBL="S" OR cTBL="B" OR cTBL="W" )
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisForm.nConnHandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle)
							Thisform.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							Thisform.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
							IF nID_Detail = 0
								ThisForm.txtID_Detail_Process.Value = 0
							ELSE
								ThisForm.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisForm.nConnHandle)  
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
				
			*****
			IF lRMA
				IF nID_Detail_PRC = 0
					IF FLOOR(nPOcomplete) = 1
						*An Add would be for Stock, -- get data After Show Receive VS Ordered
						cTBL ="S"
		*!*					IF nWO_Detail > 0
		*!*						cTBL = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
		*!*					ELSE
		*!*						cTBL = getTBL_Poitem(cPOitem, ThisForm.nConnhandle) 
		*!*					ENDIF
		
						IF nID_Detail_PRC > 0 AND ( cTBL="S" OR cTBL="B" OR cTBL="W" )
							nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisForm.nConnHandle) 
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisForm.nConnHandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
							Thisform.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							Thisform.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
							IF nID_Detail = 0
								ThisForm.txtID_Detail_Process.Value = 0
							ELSE
								ThisForm.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail ,ThisForm.nConnHandle)  
							ENDIF
						ENDIF
					ENDIF
					IF FLOOR(nPOcomplete) = 2 
						*TBL could be anything except 'N'
						IF cTBL='N' OR EMPTY(cTBL)
							cTBL ="S"
						ENDIF
						IF nID_Detail_PRC > 0 AND ( cTBL="S" OR cTBL="B" OR cTBL="W" )
							nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisForm.nConnHandle) 
							nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisForm.nConnHandle) 
							nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
							Thisform.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							Thisform.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ENDIF
					ENDIF
				ENDIF
						
				IF nID_Detail = 0 AND nID_Master > 0
					nID_Detail = get_ID_Detail_from_RMA_Detail(nRMA_Detail, ThisForm.nConnHandle,cHeat) 
					Thisform.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
					Thisform.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
					IF nID_Detail = 0
						ThisForm.txtID_Detail_Process.Value = 0
					ELSE
						ThisForm.txtID_Detail_Process.Value = Get_ID_Detail_Prc_by_Received_hist(cTBL,nID_Detail,ThisForm.nConnHandle)  
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF pSaveType = "EDIT"
			IF nID_Detail = 0
				IF nPOcomplete > FLOOR(nPOcomplete)
					*PrepareSQLnum((2+"."+ALLTRIM(STR(nNewID_Detail))),'Plus ID_Detail',9,7)
					*nID_Detail = nPOcomplete-FLOOR(nPOcomplete)
					*Remove Decimal point
					cID_Detail = ALLTRIM(STR(nID_Detail))
					cID_Detail = RIGHT(cID_Detail,LEN(cID_Detail)-2)
					nID_Detail = PrepareSQLnum(cID_Detail,'ID_Detail',-3)
					IF nID_Detail > 0 AND ( cTBL="S" OR cTBL="B" OR cTBL="W" )
						nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
						cTBL = get_TBLwithID_ID_Detail(nID_Master,nID_Detail, ThisForm.nConnHandle)
					ENDIF
				ENDIF
			ENDIF
			
			IF (nCntPOitemMetal > 0 OR nWO_Detail > 0 OR nRMA_No > 0 ) AND ( (nID_Detail+nRMA_No) = 0 OR nID_Master = 0 ) AND nReceivingID > 0
				*Metal Receive with no Stock ID,  a RMA has NO nID_Detail at first!
				
				PRIVATE cMess
				cMess = "This Receiving record "+ALLTRIM(STR(nReceivingID))+CHR(13)
				cMess = cMess + "was to be an 'Edit'"+CHR(13)
				cMess = cMess + "but no Stock ID was found."+CHR(13)+CHR(13)
				cMess = cMess + "Do you want to try to Add Stock now ?"+CHR(13)+CHR(13)
				cMess = cMess + "Customer material is not be added"+CHR(13)+CHR(13)
				cMess = cMess + "You might have to click 'Save' again."
				
				PRIVATE nMess
				nMess = MESSAGEBOX(cMess,4+32,"Add to Stock")
			
				IF nMess = 6
					IF nID_Detail_PRC = 0
						*try to find ID, ID_Detail
						IF FLOOR(nPOcomplete) = 1
							*An Add would be for Stock, -- get data After Show Receive VS Ordered
							*cTBL ="S"
							IF nWO_Detail > 0
								cTBL = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
							ELSE
								cTBL = getTBL_Poitem(cPOitem, ThisForm.nConnhandle) 
							ENDIF
							IF ( cTBL="S" OR cTBL="B" OR cTBL="W" )
								nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisForm.nConnHandle) 
							ENDIF
							IF nID_Detail_PRC > 0 AND ( cTBL="S" OR cTBL="B" OR cTBL="W" )
								nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisForm.nConnHandle) 
								nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
								Thisform.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
								Thisform.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
							ENDIF
						ENDIF
						IF FLOOR(nPOcomplete) = 2 
							*TBL could be anything except 'N'
							IF nWO_Detail > 0
								cTBL = getTBL_WO_Detail(nWO_Detail, ThisForm.nConnhandle) 
							ELSE
								cTBL = getTBL_Poitem(cPOitem, ThisForm.nConnhandle) 
							ENDIF
		
							IF cTBL='N'
								cTBL ="S"
							ENDIF
							
							nID_Detail_PRC = get_ID_D_P_forReceivingID(cTBL, nReceivingID, ThisForm.nConnHandle) 
							IF nID_Detail_PRC > 0  AND ( cTBL="S" OR cTBL="B" OR cTBL="W" )
								nID_Detail = get_ID_Detail_from_PRC(cTBL, nID_Detail_PRC, ThisForm.nConnHandle) 
							ELSE
								IF nWO_Detail > 0
									nID_Detail = get_ID_Detail_from_WOD(nWO_Detail, ThisForm.nConnHandle)
								ENDIF
							ENDIF
							IF nID_Detail > 0
								IF NOT ( cTBL="S" OR cTBL="B" OR cTBL="W" )
									cTBL = get_TBLwithID_ID_Detail(nID_Master,nID_Detail, ThisForm.nConnHandle)
								ENDIF
								nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle)
								
							ENDIF
							Thisform.txtID_Master.Value	= PrepareSQLnum(nID_Master,'ID_Master',-3)
							Thisform.txtID_Detail.Value	= PrepareSQLnum(nID_Detail,'ID_Detail',-3)
						ENDIF
					ENDIF
					**
					IF nID_Detail = 0
						DO CASE
						CASE nWO_Detail > 0
							MESSAGEBOX("WO_Detail "+ALLTRIM(STR(nWO_Detail))+" did not create a Stock Listing!"+CHR(13)+"Tell Elliot to have WO_Detail"+CHR(13)+"Create an Incoming process"+CHR(13)+CHR(13)+"You may get another chance at end of code.",0+48,"WO Detail, NO Incoming Process")
						CASE nRMA_No > 0
							MESSAGEBOX("RMA "+ALLTRIM(STR(nRMA_No))+" could not create the Stock Listing here."+CHR(13)+"There will be another place to Add back Stock",0+48,"RMA, NO Incoming Process")
						OTHERWISE
							MESSAGEBOX("Did not create a Stock Listing!"+CHR(13)+"Tell PO rep edit Purchase Order and save it to"+CHR(13)+"Create an Incoming process"+CHR(13)+CHR(13)+"You may get another chance at end of code.",0+48,"NO Incoming Process")
						ENDCASE
		
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		************************
		cSQLu = ''
		IF nReceivingID > 0 &&SaveAdd()
			**Check for Existing Record
			nReceivingIDOld = nReceivingID
			
			cSQL = "SELECT Count(*) AS Cntd FROM dbo.Receiving WITH(NOLOCK) WHERE ID ="+STR(nReceivingID)
			IF USED("tmpCountRid")
				USE IN tmpCountRid
			ENDIF
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountRid')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountRid')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountRid")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountRid")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountRid')
				*TrackMess("Error with Add Receiving ID:"+ALLTRIM(STR(nReceivingID)) )
				TrackError("Check for Existing Record. "+CHR(13)+cSQL ,"bad select",PROGRAM(),LINENO(1))
			ELSE
				IF tmpCountRid.Cntd > 0
					*Update Receiving by ReceivingID
					*Also edit changes her in PurchaseOrder chkComplete
					
					lAlready_Saved = .T.
					
					cSQLu = "UPDATE dbo.Receiving SET"
					cSQLu = cSQLu +" Received='"+IIF(EMPTY(dReceived),'',DTOC(dReceived)) +"'"
					cSQLu = cSQLu +",POitem=dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQLu = cSQLu +",SOitem=dbo.f_ProperSOitem('"+cSOitem+"')"
					cSQLu = cSQLu +",WO="+STR(nWO)
					cSQLu = cSQLu +",WO_Detail="+STR(nWO_Detail)
					cSQLu = cSQLu +",Alloy='"+cAlloy+"'"
					cSQLu = cSQLu +",Heat='"+cHeat+"'"
					cSQLu = cSQLu +",Lot='"+cLot+"'"
					cSQLu = cSQLu +",Cert="+IIF(lCert,'1','0')+""	&&BIT
					cSQLu = cSQLu +",CofC="+IIF(lCofC,'1','0')+""	&&BIT
					cSQLu = cSQLu +",MillTrace="+IIF(lMillTrace,'1','0')+""	&&BIT
					
					cSQLu = cSQLu +",Pieces="+STR(nPieces)
					cSQLu = cSQLu +",Description='"+cDescription+"'"
					cSQLu = cSQLu +",Specs='"+cSpecs+"'"
					cSQLu = cSQLu +",Comments='"+cComments+"'"
					cSQLu = cSQLu +",[Init]='"+cInit+"'"
					cSQLu = cSQLu +",[Date]='"+IIF(EMPTY(dDate),'',DTOC(dDate)) +"'"
					cSQLu = cSQLu +",Pass="+IIF(lPass_PW,'1','0')
					cSQLu = cSQLu +",GoodPapers="+IIF(lGoodPapers,'1','0')
					cSQLu = cSQLu +",ActualW="+STR(nActualW,9,1)
					cSQLu = cSQLu +",BillW="+STR(nBillW,9,1)
					
					cSQLu = cSQLu +",R_Qty="+STR(nAcct_QTY,18,4)
					cSQLu = cSQLu +",R_P ="+STR(nAcct_P,18,4)
					cSQLu = cSQLu +",R_PU="+STR(nAcct_PU)
					
						*use PO Fields for WO_Detail Data		
					cSQLu = cSQLu +",PO_Qty="+STR(nPO_QTY,18,4)
					cSQLu = cSQLu +",PO_P="+STR(nPO_P,18,4)
					cSQLu = cSQLu +",PO_PU="+STR(nPO_PU)
					
					cSQLu = cSQLu +",Vendor='"+cVendor+"'"
		*--			cSQLu = cSQLu +",Cancelled=0"
					cSQLu = cSQLu +",ID_Master="+STR(nID_Master)
					cSQLu = cSQLu +",ID_Detail="+STR(nID_Detail)
					cSQLu = cSQLu +",StockTable='"+cTBL+"'"
					
					cSQLu = cSQLu +",RejectReason='"+cRejectReason+"'"
					cSQLu = cSQLu +",RMA_No="+STR(nRMA_No)
					cSQLu = cSQLu +",RMA_Detail="+STR(nRMA_Detail)
					cSQLu = cSQLu +",hold="+IIF(lHold,"1","0")
					cSQLu = cSQLu +",Form='"+cForm+"'"
					
					cSQLu = cSQLu +",Services="+IIF(lServicesPO,"1","0")
					cSQLu = cSQLu +",ConvServ="+IIF(lConvServ,"1","0")
					cSQLu = cSQLu +",Equipment="+IIF(lEquipment,"1","0")
						
					cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
						lSaved = .F.
						TrackError("Update Receiving by ReceivingID. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
						*RETURN
					ELSE 
						lSaved = .T.
						lSaveByOldMethod = .F.
						TrackMess("Updated Receiving ID:"+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(cPOitem)+", SO:"+ALLTRIM(cSOitem) )
						IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
							*Alert SO Status
							IF lRMA
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "RecvUpdate", "Update the Receiving ID:"+ALLTRIM(STR(nReceivingID))+" for RMA_Detail "+ALLTRIM(STR(nRMA_Detail)) , ThisForm.nConnHandle)
							ELSE
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "RecvUpdate", "Update the Receiving ID:"+ALLTRIM(STR(nReceivingID))+" for POitem '"+cPOitem+"'" , ThisForm.nConnHandle)
							ENDIF
						ELSE
							IF lRMA
								*Save_RMA_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" as RMA", ThisForm.nConnHandle)						
							ENDIF
						ENDIF
					ENDIF
					
				ELSE
					*ReceivingID was not found in dbo.Receiving !!
					
					nReceivingIDOld = nReceivingID 
					*Insert INTO dbo.Receiving
					cSQLi = "EXEC dbo.p_Receiving_ins5 "
					cSQLi = cSQLi +" @Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
					cSQLi = cSQLi +",@POitem = '"+cPOitem+"'"
					cSQLi = cSQLi +",@SOitem = '"+cSOitem+"'"
					cSQLi = cSQLi +",@WO_Detail = "+STR(nWO_Detail)
					cSQLi = cSQLi +",@Alloy ='"+cAlloy+"'"
					cSQLi = cSQLi +",@Heat ='"+cHeat+"'"
					cSQLi = cSQLi +",@Cert ="+IIF(lCert,'1','0')+""	&&BIT
					cSQLi = cSQLi +",@CofC ="+IIF(lCofC,'1','0')+""	&&BIT
					cSQLi = cSQLi +",@Pieces ="+STR(nPieces)
					cSQLi = cSQLi +",@Description ='"+cDescription+"'"
					cSQLi = cSQLi +",@Specs ='"+cSpecs+"'"
					cSQLi = cSQLi +",@Comments ='"+cComments+"'"
					cSQLi = cSQLi +",@Init ='"+cInit+"'"
					cSQLi = cSQLi +",@Date ='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
					cSQLi = cSQLi +",@Pass ="+IIF(lPass_PW,'1','0')
					cSQLi = cSQLi +",@GoodPapers ="+IIF(lGoodPapers,'1','0')
					cSQLi = cSQLi +",@ActualW ="+STR(nActualW)
					cSQLi = cSQLi +",@BillW ="+STR(nBillW)
					cSQLi = cSQLi +",@Vendor ='"+cVendor+"'"
					
					cSQLi = cSQLi +",@RejectReason ='"+cRejectReason+"'"
					cSQLi = cSQLi +",@RMA_No="+STR(nRMA_No)
					
					IF USED("tmpIDReceiving")
						USE IN tmpIDReceiving
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpIDReceiving")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpIDReceiving")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpIDReceiving')
						TrackError("Insert INTO dbo.Receiving. "+CHR(13)+cSQLi ,"bad update",PROGRAM(),LINENO(1))
					ELSE &&IF nSQLEXEC < 1
						lSaved = .T.
						
						IF USED("tmpIDReceiving")
							nReceivingID = PrepareSQLnum(tmpIDReceiving.EXP,'RID',-3)
							
							IF nReceivingID > 0		&&Should do this later when ID_Master and ID_Detail are known
								*UPDATE the rest of that dbo.Receiving record
								
								cSQLu = "UPDATE dbo.Receiving SET "
								cSQLu = cSQLu +" StockTable='"+cTBL+"'"
								cSQLu = cSQLu +",ID_Master="+STR(nID_Master)
								cSQLu = cSQLu +",ID_Detail="+STR(nID_Detail)
								cSQLu = cSQLu +",RMA_Detail="+STR(nRMA_Detail)
								
								cSQLu = cSQLu +",Lot='"+cLot+"'"
								cSQLu = cSQLu +",MillTrace="+IIF(lMillTrace,'1','0')+""	&&BIT
		
								cSQLu = cSQLu +",R_Qty="+STR(nAcct_QTY,18,4)
								cSQLu = cSQLu +",R_P ="+STR(nAcct_P,18,4)
								cSQLu = cSQLu +",R_PU="+STR(nAcct_PU)
								
								*use PO Fields for WO_Detail Data
								cSQLu = cSQLu +",PO_Qty="+STR(nPO_QTY,18,4)
								cSQLu = cSQLu +",PO_P="+STR(nPO_P,18,4)
								cSQLu = cSQLu +",PO_PU="+STR(nPO_PU)
					
								cSQLu = cSQLu +",hold="+IIF(lHold,"1","0")
								cSQLu = cSQLu +",Form='"+cForm+"'"
								
								cSQLu = cSQLu +",Services="+IIF(lServicesPO,"1","0")
								cSQLu = cSQLu +",ConvServ="+IIF(lConvServ,"1","0")
								cSQLu = cSQLu +",Equipment="+IIF(lEquipment,"1","0")
						
								cSQLu = cSQLu + " WHERE ID="+STR(nReceivingID)
								
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, '')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, '')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
									TrackError("UPDATE the rest of table dbo.Receiving. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
								ENDIF
								
								
								cMess = "Added Receiving ID:"+ALLTRIM(STR(nReceivingID))
								cMess = cMess + " WAS Receiving ID:"+ALLTRIM(STR(nReceivingIDOld))
								cMess = cMess + ", PO:"+ALLTRIM(cPOitem)
								cMess = cMess + ", SO:"+ALLTRIM(cSOitem)
								cMess = cMess + ", WO_Detail:"+ALLTRIM(STR(nWO_Detail))
								cMess = cMess + ", WO:"+ALLTRIM(STR(nWO))
								IF lRMA 
									cMess = cMess + ", RMA:"+ALLTRIM(STR(nRMA_No))
									cMess = cMess + ", RMA_Detail:"+ALLTRIM(STR(nRMA_Detail))
								ENDIF
								
								cMess = ShowSQLtxt(cMess,'Mess',-1)
								*TrackMess(cMess)
								TrackError(cMess,"nReceivingID is not 0, but is a new Receive!",PROGRAM(),LINENO(1))
								RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"nReceivingID is not 0, but was not found in Receiving table!"+CHR(13)+cMess+" "+CHR(13)+cSQL  )
								
								lSaveByOldMethod = .F.
								
								IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
									*Alert SO Status
									IF lRMA
										Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" for RMA_Detail "+ALLTRIM(STR(nRMA_Detail)) , ThisForm.nConnHandle)
									ELSE
										Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+CHR(13)+", WAS Receiving ID:"+ALLTRIM(STR(nReceivingIDOld)), ThisForm.nConnHandle)
									ENDIF
								ELSE
									IF lRMA
										Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" as RMA", ThisForm.nConnHandle)
									ENDIF
								ENDIF
								
								USE IN tmpIDReceiving 
								ThisForm.txtReceivingID.Value = nReceivingID 
								ThisForm.txtReceivingID.Refresh
							ENDIF						
						ENDIF
						
						PRIVATE cMess
						cMess = "Added Receiving ID:"+ALLTRIM(STR(nReceivingID)) 
						cMess = cMess + ", POitem '"+cPOitem+"'"
						cMess = cMess + ", SOitem '"+cSOitem+"'"
						cMess = cMess + ", WO_Detail:"+ALLTRIM(STR(nWO_Detail))
						cMess = cMess + ", WO:"+ALLTRIM(STR(nWO))
						TrackMess(cMess)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("tmpCountRid")
			USE IN tmpCountRid
		ENDIF
		
		*****************************
		*Is nReceivingID still 0
		PRIVATE nMess, lSaveRMAtoStock 
		nMess = 6
		lSaveRMAtoStock = .T.
		
		IF nReceivingID = 0 
			*NO nReceivingID Found! -must be NewAdd Save
			nReceivingIDOld = 0
			
			IF lRMA
				nMess = MESSAGEBOX("Is this material worth stocking?",4+32,"Found RMA number!")
				IF nMess = 6
					lSaveRMAtoStock = .T.
				ELSE
					lSaveRMAtoStock = .F.
				ENDIF
			ENDIF
			
			
			*Insert as new and get ReceivingID
			*Insert INTO dbo.Receiving
			cSQLi = "EXEC dbo.p_Receiving_ins5 "
			cSQLi = cSQLi +" @Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
			cSQLi = cSQLi +",@POitem = '"+cPOitem+"'"
			cSQLi = cSQLi +",@SOitem = '"+cSOitem+"'"
			cSQLi = cSQLi +",@WO_Detail = "+STR(nWO_Detail)
			cSQLi = cSQLi +",@Alloy ='"+cAlloy+"'"
			cSQLi = cSQLi +",@Heat ='"+cHeat+"'"
			cSQLi = cSQLi +",@Cert ="+IIF(lCert,'1','0')+""	&&BIT
			cSQLi = cSQLi +",@CofC ="+IIF(lCofC,'1','0')+""	&&BIT
			cSQLi = cSQLi +",@Pieces ="+STR(nPieces)
			cSQLi = cSQLi +",@Description ='"+cDescription+"'"
			cSQLi = cSQLi +",@Specs ='"+cSpecs+"'"
			cSQLi = cSQLi +",@Comments ='"+cComments+"'"
			cSQLi = cSQLi +",@Init ='"+cInit+"'"
			cSQLi = cSQLi +",@Date ='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
			cSQLi = cSQLi +",@Pass ="+IIF(lPass_PW,'1','0')
			cSQLi = cSQLi +",@GoodPapers ="+IIF(lGoodPapers,'1','0')
			cSQLi = cSQLi +",@ActualW ="+STR(nActualW)
			cSQLi = cSQLi +",@BillW ="+STR(nBillW)
			cSQLi = cSQLi +",@Vendor ='"+cVendor+"'"
			cSQLi = cSQLi +",@RejectReason ='"+cRejectReason+"'"
			cSQLi = cSQLi +",@RMA_No="+STR(nRMA_No)
			
			IF USED("tmpIDReceiving")
				USE IN tmpIDReceiving
			ENDIF
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpIDReceiving")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpIDReceiving")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpIDReceiving')
				TrackError("Insert as new and get ReceivingID. "+CHR(13)+cSQLi ,"bad update",PROGRAM(),LINENO(1))
			ELSE &&IF nSQLEXEC < 1
				lSaved = .T.
				
				IF USED("tmpIDReceiving")
					nReceivingID = PrepareSQLnum(tmpIDReceiving.EXP,'ReceivingID',-3)
		*				TrackMess("Added Receiving ID:"+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(cPOitem)+", SO:"+ALLTRIM(cSOitem))
					
					lSaveByOldMethod = .F.
					USE IN tmpIDReceiving 
					
					ThisForm.txtReceivingID.Value = nReceivingID 
					ThisForm.txtReceivingID.Refresh
					
					IF VARTYPE(nReceivingID) != "N"		
						TrackError("nReceivingID is not a NUMBER"+CHR(13)+cSQLi,"SaveAdd(INSERT) failed.",PROGRAM(),LINENO(1))
					ELSE
						*MESSAGEBOX("Added Receive.",64,"Success")
						MESSAGEBOX("Added Receive to Database."+CHR(13)+"This data is now in the Receiving table."+CHR(13)+CHR(13)+"Heat "+cHeat,64,"Successful Insert Receive")
						*TrackMess(LEFT("Added Receiving ID:"+STR(nReceivingID)+CHR(13)+" Did not find a Receiving ID."+CHR(13)+cSQLi ,254))	
						
						IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
							*Alert SO Status
							IF lRMA
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" as RMA", ThisForm.nConnHandle)
							ELSE
								Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID)), ThisForm.nConnHandle)
							ENDIF
						ELSE
							IF lRMA
								IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
									Save_SOitem_Status( cSOitem, VAL(cSOitem), "Receive", "Receiving record "+ALLTRIM(STR(nReceivingID))+" as RMA", ThisForm.nConnHandle)
								ENDIF
							ENDIF
						ENDIF
						
					ENDIF
					
					IF nReceivingID > 0
						*UPDATE the rest of that dbo.Receiving record
						
						cSQL = "UPDATE dbo.Receiving SET "
						cSQL = cSQL + " StockTable='"+cTBL+"'"
						cSQL = cSQL + ",ID_Master="+STR(nID_Master)
						cSQL = cSQL + ",ID_Detail="+STR(nID_Detail)
						cSQL = cSQL + ",RMA_Detail="+STR(nRMA_Detail)
						
						cSQL = cSQL + ",Lot='"+cLot+"'"
						cSQL = cSQL + ",MillTrace="+IIF(lMillTrace,'1','0')+""
						cSQL = cSQL + ",R_Qty="+STR(nAcct_QTY,18,4)
						cSQL = cSQL + ",R_P ="+STR(nAcct_P,18,4)
						cSQL = cSQL + ",R_PU="+STR(nAcct_PU)
						
						*use PO Fields for WO_Detail Data				
						cSQL = cSQL +",PO_Qty="+STR(nPO_QTY,18,4)
						cSQL = cSQL +",PO_P="+STR(nPO_P,18,4)
						cSQL = cSQL +",PO_PU="+STR(nPO_PU)
					
						cSQL = cSQL +",hold="+IIF(lHold,"1","0")
						cSQL = cSQL +",Form='"+cForm+"'"
						
						cSQL = cSQL +",Services="+IIF(lServicesPO,"1","0")
						cSQL = cSQL +",ConvServ="+IIF(lConvServ,"1","0")
						cSQL = cSQL +",Equipment="+IIF(lEquipment,"1","0")
		
						cSQL = cSQL + " WHERE ID="+STR(nReceivingID)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
							TrackError("UPDATE the rest of table dbo.Receiving. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
						ENDIF
					ENDIF	
				ENDIF			
			ENDIF
			
			IF nReceivingID = 0
				IF nRMA_No = 0
					*Could be a new Add and nReceivingID has not been set
					TrackError("nReceivingID is 0, Should have been set by EXEC dbo.p_Receiving_ins3 ."+CHR(13)+cSQL,"bad variable",PROGRAM(),LINENO(1))
					*TrackMess("nReceivingID is 0, Should have been set by EXEC dbo.p_Receiving_ins3 ."+CHR(13)+"bad variable"+CHR(13)+"Shop_StockLst_Edit:ReceivingSaveAdd")
				ENDIF
			ENDIF
		ENDIF
		
		*******************************************************
		*******************************************************
		*!*	IF NOT (lServicesPO or lConvServ or lEquipment)
		*!*		** Save Receiving ID to Stock Detail
		
		*!*		IF lSaved AND nReceivingID > 0 AND nID_Master > 0 AND nID_Detail > 0
		*!*			IF NOT (cTBL="S" OR cTBL="B" OR cTBL="W")
		*!*				cTBL = get_TBLwithID_ID_Detail(nID_Master,nID_Detail,ThisForm.nConnHandle)
		*!*			ENDIF
		*!*			
		*!*			DO CASE
		*!*			CASE cTBL = "S"
		*!*				cSQL = "UPDATE dbo.StockLst_Detail "
		*!*			CASE cTBL = "B"
		*!*				cSQL = "UPDATE dbo.BrokerLst_Detail "
		*!*			CASE cTBL = "W"
		*!*				cSQL = "UPDATE dbo.WIPLst_Detail "
		*!*			OTHERWISE
		*!*				cSQL = "Lost cTBL "	
		*!*			ENDCASE				
		*!*				
		*!*			cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
		*!*			cSQL = cSQL + " WHERE ID="+STR(nID_Master)
		*!*			cSQL = cSQL + " AND ID_Detail="+STR(nID_Detail)
		
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
		*!*				TrackError("Save Receiving ID to Stock Detail. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		*!*	*******************************************************
				
		IF nReceivingID = 0
			IF NOT lRMA
				TrackError("bad variable","nReceivingID is 0, Could not run ReceivingSaveID_Master(nReceivingID)",PROGRAM(),LINENO(1))
			ENDIF
		ENDIF
		
		********************************************************
		
		PRIVATE cMess
		IF NOT lRan_Show_Recv_Order
			DO CASE 
			CASE nWO_Detail > 0
				*FLOOR(nPOcomplete) = 2
			CASE nCntPOitemMetal = 0
				*Service, Eqp or Conv
				*FLOOR(nPOcomplete) 0,1,2,3
				*FLOOR(nPOcomplete) = 2
			CASE lRMA 
				*FLOOR(nPOcomplete) = 2
			OTHERWISE
				
				cMess = "SaveAdd(): Did not run Show_Recv_Order."+CHR(13)
				cMess = cMess +"INIT pWhat="+ThisForm.cWhat+", pcHeat="+ThisForm.cHeat+CHR(13)
				cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
				cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
				cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
				cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
				cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
				cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
				cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
				cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
				cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
				cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
				cMess = cMess +", pSaveType = '"+pSaveType+"'"
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
			ENDCASE
		ENDIF
		
		********************
		PRIVATE lOK
		lOK = .F.
		
		**********************
		PRIVATE lRun_Recv_Stock
		lRun_Recv_Stock = .F.
		
		
		********************************************
		*By POitem
		* 
		IF lRMA
			IF lSaved 
				*ThisForm.MarkAsRMAreceived()	&&Done later
				lOK = .T.
			ENDIF
		ELSE
			IF lSaved 
				lOK = .T.
				*lSaveRMAtoStock 
				
				******************
				IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
					IF nCntPOitemMetal > 0
					
						PRIVATE nCntPOitem
						*nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle,"METAL")
						nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle,"METAL")
						
						IF nCntPOitem > 0 &&AND NOT (lServicesPO or lConvServ or lEquipment)
							IF ThisForm.UpdatePOitemRecDt(dReceived,cPOitem,FLOOR(nPOcomplete) ) &&Safe Received Date update.
							ENDIF
						
							lSaved = ThisForm.SaveAdd_PurchaseOrder(nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,lCofC,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,FLOOR(nPOcomplete) )
							IF lSaved
								IF nID_Master = 0
									nID_Master	= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID',-3)
								ENDIF
								IF nID_Detail= 0
									nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
								ENDIF
								*Receive_Stock calls forms\Recv_Stock()
								lRun_Recv_Stock = .F.
								*ThisForm.lRan_Recv_Stock  = .T.
							ENDIF
						ELSE
							IF (lServicesPO or lConvServ or lEquipment)
								WAIT WINDOW nPOcomplete
								IF ThisForm.UpdatePOitemRecDt(dReceived,cPOitem,FLOOR(nPOcomplete) ) &&Safe Received Date update.
								
								ENDIF			
							ELSE
								cMess = "SaveAdd(): Did not find POitem Count_POIteminPurchaseOrder()."+CHR(13)
								cMess = cMess +"INIT pWhat="+ThisForm.cWhat+", pcHeat="+cHeat+CHR(13)
								cMess = cMess +"Did not run ThisForm.UpdatePOitemRecDt()"+CHR(13)
								cMess = cMess +"Did not run ThisForm.SaveAdd_PurchaseOrder()"+CHR(13)
								cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
								cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
								cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
								cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
								cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
								cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
								cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
								cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
								cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
								cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
								RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
							ENDIF
						ENDIF
					ELSE
						*Not a Metal Receive.
					ENDIF
					
					IF pSaveType == "ADD"
						* not "ADDCLONE"
						*ThisForm.ResetAddVars()
					ELSE
						IF pSaveType = "ADDCLONE"
							ThisForm.lClone = .T.
							ThisForm.txtReceivingID.Value = 0
							*ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
						ENDIF
					ENDIF
				ENDIF
				
				******************************
				IF nWO_Detail > 0
					PRIVATE nCntWO_Detail
					*nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle,"METAL")
					nCntWO_Detail = Count_WODinWO_Detail( nWO_Detail, ThisForm.nConnHandle,"NOTCANCELLED")
					
					IF nCntWO_Detail > 0
						*IF ThisForm.UpdatePOitemRecDt(dReceived,cPOitem,FLOOR(nPOcomplete) ) &&Safe Received Date update.
						IF ThisForm.UpdateWO_DetailRecDt(dReceived,nWO_Detail,FLOOR(nPOcomplete) ) &&Save Received Date update.
						ENDIF
					
						*lSaved =ThisForm.SaveAdd_WO_Detail(nReceivingID,nWO_Detail,cComments,dReceived,cInit,cHeat,lCert,lCofC,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,nWODcomplete )
						lSaved = ThisForm.SaveAdd_WO_Detail(nReceivingID,nWO_Detail,cComments,dReceived,cInit,cHeat,lCert,lCofC,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,FLOOR(nPOcomplete) )
						IF lSaved
							IF nID_Master = 0
								nID_Master	= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID',-3)
							ENDIF
							IF nID_Detail= 0
								nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
							ENDIF
							*Receive_Stock calls forms\Recv_Stock()
							lRun_Recv_Stock = .T.
							*ThisForm.lRan_Recv_Stock  = .T.
						ENDIF
					ELSE
						cMess = "SaveAdd(): Did not find WO_Order Count_WODinWO_Detail()."+CHR(13)
						cMess = cMess +"INIT pWhat="+ThisForm.cWhat+", pcHeat="+cHeat+CHR(13)
						cMess = cMess +"Did not run ThisForm.UpdateWO_DetailRecDt()"+CHR(13)
						cMess = cMess +"Did not run ThisForm.SaveAdd_WO_Detail()"+CHR(13)
						cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
						cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
						cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
						cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
						cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
						cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
						cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
						cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
						cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
						cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
					ENDIF
					
					IF pSaveType = "ADDCLONE"
						ThisForm.lClone = .T.
						ThisForm.txtReceivingID.Value = 0
						*ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
					ENDIF		
				ENDIF
				*Called in SaveAdd_PurchaseOrder
				*lSaved = ThisForm.Receive_Stock() 
				*pPOitem, pnReceivingID, cHeat, cLot, nRMA_Detail, pSOitem, pWO_Detail, lMillTrace
				*Receive_Stock calls forms\Recv_Stock()
				lRun_Recv_Stock = .F.
				*ThisForm.lRan_Recv_Stock  = .T.
		
			ENDIF
			
			****************************
			IF lSaved 			
				IF lHold
					*****************************************
					*nWO_Detail
					IF nWO_Detail > 0
		
					ENDIF
					
					*cPOitem
					IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
						lOK = POitem_Hold( cPOitem, .T., ThisForm.nConnHandle)
						IF lOK
						
							cSQL = "INSERT INTO dbo.Sales_Hold_Status "
							cSQL = cSQL+"([SOitem],[SalesNum],[POitem],[Hold_Type],[Hold_Value] "
							cSQL = cSQL+",[What],[Comment]) VALUES ("
							cSQL = cSQL+"'"+cSOitem+"'"
							cSQL = cSQL+","+STR(nSalesNum)
							cSQL = cSQL+",'"+cPOitem+"'"
							      		
				      		*--[What],[Comment] are in next code
				      		
				      		IF NOT lPass_PW
					      		cSQL = cSQL+",'PO'"
					      		cSQL = cSQL+",1 "
				      			cSQL = cSQL+",'PO On Receiving Hold'" &&What
				      			cSQL = cSQL+",'"+LEFT("Receiving QA Spec issues. RID: "+ALLTRIM(STR(nReceivingID))+" "+ALLTRIM(cRejectReason),255)+"'"
				      			
				      		ELSE
					      		cSQL = cSQL+",'RCV'"
					      		cSQL = cSQL+",1 "
				      			cSQL = cSQL+",'Receiving Hold'" &&What
					      		cSQL = cSQL+",'"+LEFT("Receiving found issues RID: "+ALLTRIM(STR(nReceivingID))+" "+ALLTRIM(cRejectReason),255)+"'"
				      		ENDIF
				      		cSQL = cSQL+")"
				      		
				  			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
								TrackError("Insert dbo.Sales_Hold_Status. "+CHR(13)+cSQL ,"bad update",PROGRAM(),LINENO(1))
							ENDIF
									
		
						ENDIF
					ENDIF
					
					*nSalesNum
					IF nSalesNum > 0
						*do not put Sales on hold because of incoming material
					ENDIF
							
				ENDIF
			ENDIF
		
			IF lSaved 			
				IF pSaveType == "ADD"
					* not "ADDCLONE"
					*ThisForm.ResetAddVars()
				ENDIF
				IF pSaveType = "ADDCLONE"
					ThisForm.lClone = .T.
					ThisForm.txtReceivingID.Value = 0
					*IF NOT LEFT(ThisForm.txtHeat.Value,1) = '*'
					*	ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
					*ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		********************************************
		*Remove_Incoming_Process
		PRIVATE lRemove_Incoming_Process
		lRemove_Incoming_Process = .F.
		
		IF NOT lRMA
			IF lSaved
				IF FLOOR(nPOcomplete) = 2 AND LEN(cTBL) > 0 
					*Complete
					IF ( ThisForm.cWhat = "S_Process" OR ThisForm.cWhat = "B_Process" OR ThisForm.cWhat = "W_Process" );
						OR (ThisForm.cWhat = "ADD" AND nID_Detail_PRC > 0);
						OR (ThisForm.cWhat = "ADD" AND nWO_Detail > 0) 	
					
						*By ID_Detail* Do not rely on POitem 
						*remove INCOMING Process that Receive Edit started
						
						*make sure there is a SELECT process before the Incoming process is removed.
						*when there is a know SO or WO.
		
						IF Proper_PO_Item(cPOitem) != Proper_PO_Item('') AND  nCntPOitemMetal > 0 
							*Select_before_Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, 'POitem', cPOitem, nReceivingID, ThisForm.nConnHandle)
						ENDIF
						
						IF nSalesNum > 0 
							Select_before_Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, 'SOitem', cSOitem, nReceivingID, ThisForm.nConnHandle)
						ENDIF
						IF nWO_Detail > 0 
						*	Select_before_Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, 'WO_Detail', nWO_Detail, nReceivingID, ThisForm.nConnHandle)
						ENDIF
						IF nWO > 0
						*	Select_before_Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, 'WO', nWO, nReceivingID, ThisForm.nConnHandle)
						ENDIF
					ENDIF
					
					
					IF cTBL = "S" OR cTBL = "B" OR cTBL = "W" 
						IF nID_Detail > 0
							IF Remove_Incoming_Process_by_ID_Detail(cTBL, nID_Detail, nReceivingID, ThisForm.nConnHandle)
								lRemove_Incoming_Process = .T.
							ENDIF
						ELSE
							lRemove_Incoming_Process = .T.
						ENDIF
					ENDIF
					
					IF !lRemove_Incoming_Process AND ( nCntPOitemMetal > 0 OR nWO_Detail > 0 )
						 
					
						cMess = "SaveAdd(): Remove_Incoming_Process_by_ID_Detail failed."+CHR(13)
						cMess = cMess +"INIT pWhat="+ThisForm.cWhat+", pcHeat="+cHeat+CHR(13)
						cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
						cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
						cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
						cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
						cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
						cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
						cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
						cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
						cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
						cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)	
						
						
					ENDIF
				ELSE
					*Could be WO_Detail
					
				ENDIF
				
				*****
		
		*!*			IF !lRemove_Incoming_Process AND ( nCntPOitemMetal > 0 OR nWO_Detail > 0 )
		*!*				*Remove_Incoming_Process_RID, send FLOOR(nPOcomplete) to decide to delete Process
		*!*				IF Remove_Incoming_Process_RID(cPOItem,nPieces,nActualW,nAcct_QTY,nAcct_PU, ThisForm.nConnHandle, FLOOR(nPOcomplete), nReceivingID, cTBL )
		*!*					lRemove_Incoming_Process = .T.
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			*****
		*!*			IF !lRemove_Incoming_Process AND ( nCntPOitemMetal > 0 OR nWO_Detail > 0 )
		
		*!*				*Remove_Incoming_Process_by_POitem 
		*!*				IF FLOOR(nPOcomplete) = 2 
		*!*					IF Remove_Incoming_Process_by_POitem(cPOitem, ThisForm.nConnHandle)
		*!*						lRemove_Incoming_Process = .T.
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
				*****
				IF FLOOR(nPOcomplete) = 2 	
					*Send Report 
					cMess = "SaveAdd(): "+IIF(lRemove_Incoming_Process,"Successfully removed Incoming Process.","Failed to remove Incoming Process." )+CHR(13)
					cMess = cMess +"INIT pWhat="+ThisForm.cWhat+", pcHeat="+cHeat+CHR(13)
					cMess = cMess +", nReceivingID="+STR(PrepareSQLnum(nReceivingID,'ReceivingID',-3))+CHR(13)
					cMess = cMess +", cSOitem='"+PrepareSQLtxt(cSOitem,'SOitem',10)+"'"+CHR(13)
					cMess = cMess +", cPOitem='"+PrepareSQLtxt(cPOitem,'POitem',12)+"'"+CHR(13)
					cMess = cMess +", nWO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))+CHR(13)
					cMess = cMess +", nWO="+STR(PrepareSQLnum(nWO,'WO',-3))+CHR(13)
					cMess = cMess +", nRMA="+STR(PrepareSQLnum(nRMA_No,'RMA',-3))+CHR(13)
					cMess = cMess +", nRMA_Detail="+STR(PrepareSQLnum(nRMA_Detail,'RMA_Detail',-3))+CHR(13)
					cMess = cMess +", nID_Master="+STR(PrepareSQLnum(nID_Master,'ID_Master',-3))+CHR(13)
					cMess = cMess +", nID_Detail="+STR(PrepareSQLnum(nID_Detail,'ID_Detail',-3))+CHR(13)
					cMess = cMess +", cTBL='"+PrepareSQLtxt(cTBL,'TBL',1)+"'"+CHR(13)
		
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)	
				ENDIF
			ENDIF
		ENDIF
		
		
		********************************************
		IF lRMA
			*RMA
		*	IF NOT lOK
			IF nReceivingID > 0
				*RMA does not have a Process!
		*!*			ThisForm.MarkAsRMAreceived() reads - So must be set before calling
		*!*			ThisForm.txtID_Master.Value
		*!*			ThisForm.txtID_Detail.Value
		*!*			ThisForm.txtID_Detail_Process.Value
		*!*			ThisForm.RMA_SS_ID
				IF ThisForm.RMA_SS_ID = 0
					*Set from Sales_Stock and StockLst_Process_Detail
					ThisForm.Set_RMA_SS_ID(nRMA_Detail)
				ENDIF
				
				IF ThisForm.MarkAsRMAreceived(nReceivingID)
					*Add RMA to StockLst
					lSaved = ThisForm.Receive_Stock( cPOitem, nReceivingID, cHeat, cLot, nRMA_Detail, cSOitem, nWO_Detail, lMillTrace ) 
					*pPOitem, pnReceivingID, cHeat, cLot, nRMA_Detail, pSOitem, pWO_Detail, lMillTrace
					*Receive_Stock call Forms\Recv_Stock
					lRun_Recv_Stock = .F.
					*ThisForm.lRan_Recv_Stock  = .T.
		
					IF lSaved 
						IF pSaveType == "ADD"
						*	THISFORM.ResetAddVars()
						ELSE
							IF pSaveType = "ADDCLONE"
								ThisForm.lClone = .T.
								ThisForm.txtReceivingID.Value = 0
								*IF NOT LEFT(ThisForm.txtHeat.Value,1) = '*'					
								*	ThisForm.txtHeat.Value = '*'+ThisForm.txtHeat.Value
								*ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		*	ENDIF
		ENDIF	
		
		
		*************************************
		PRIVATE lFoundHistory
		lFoundHistory = .F.
		
		
		IF lOK AND lSaved
			*FLOOR(nPOcomplete) 0,1 Good, incomplete, 2 Good Complete, 3 Edit
			IF nID_Detail = 0 AND nID_Master = 0 AND ( nCntPOitemMetal > 0 or nWO_Detail > 0 )
		
				*********************************
				*Check History to see if a StockLst MASTER Add is needed
				
				
				*IGNORE, If there is history
				IF USED('cntMDP_History')
					USE IN cntMDP_History
				ENDIF
		
				cSQL = "SELECT DISTINCT 'S' AS TBL, P.ID_Detail, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.Ar_StockLst_Process_History P "
				cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History D ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M ON D.ID = M.ID "
				cSQL = cSQL + " WHERE ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'NOT2HPA' OR P.Process_ID = 'PARTRECV' )"
				cSQL = cSQL + " AND P.WHAT = 'DELETE' "
				IF Proper_PO_Item(cPOitem) <> Proper_PO_item('')
					cSQL = cSQL + " AND P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				ENDIF
				IF nWO_Detail > 0
					cSQL = cSQL + " AND P.WO_Detail = "+ALLTRIM(STR(nWO_Detail))
				ENDIF
		
				IF LEN(cHeat) > 0
					cSQL = cSQL + " AND M.Heat = '"+cHeat+"'"
				ENDIF
				IF LEN(cLot) > 0
					cSQL = cSQL + " AND M.Lot = '"+cLot+"'"
				ENDIF
		
		
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntMDP_History')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntMDP_History')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntMDP_History")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntMDP_History")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntMDP_History')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('cntMDP_History')	
					IF RECCOUNT('cntMDP_History') > 0
						*A P.Process_ID = 'INCOMING' with this POitem has already been deleted
						lFoundHistory = .T.
					ENDIF
					USE IN cntMDP_History
				ENDIF
			ENDIF
			
			**************************************
			
			IF nID_Detail = 0 AND nID_Master > 0 AND nRMA_No > 0
				*********************************
				*Check History to see if a StockLst Add is needed
				
				
				*IGNORE, If there is history
				IF USED('cntMDP_History')
					USE IN cntMDP_History
				ENDIF
		
				cSQL = "SELECT DISTINCT 'S' AS TBL, P.ID_Detail, P.ID_Detail_Process "
				cSQL = cSQL + " FROM dbo.Ar_StockLst_Process_History P "
				cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History D ON P.ID_Detail = D.ID_Detail "
				cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M ON D.ID = M.ID "
				cSQL = cSQL + " WHERE ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'NOT2HPA' OR P.Process_ID = 'RECEIVED' OR P.Process_ID = 'PARTRECV')"
				cSQL = cSQL + " AND P.WHAT = 'DELETE' "
				cSQL = cSQL + " AND M.ID = "+STR(nID_Master )
				
				IF LEN(cHeat) > 0
					cSQL = cSQL + " AND M.Heat = '"+cHeat+"'"
				ENDIF
				IF LEN(cLot) > 0
					cSQL = cSQL + " AND M.Lot = '"+cLot+"'"
				ENDIF
		
		
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntMDP_History')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntMDP_History')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntMDP_History")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntMDP_History")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntMDP_History')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				ENDIF
		
				IF USED('cntMDP_History')	
					IF RECCOUNT('cntMDP_History') > 0
						*A P.Process_ID = 'INCOMING' with this POitem has already been deleted
						lFoundHistory = .T.
					ENDIF
					USE IN cntMDP_History
				ENDIF
			ENDIF
		ENDIF
		
		***************************************
		IF NOT lRun_Recv_Stock
			IF lFoundHistory
		
				cMess = "Found record in History Archive for "+CHR(13)
				IF Proper_PO_Item(cPOitem) <> Proper_PO_item('')
					cMess = cMess + " and POitem = '"+cPOitem+"'"
				ENDIF
				IF nWO_Detail > 0
					cMess = cMess + " and WO_Detail = "+ALLTRIM(STR(nWO_Detail))
				ENDIF
				IF nRMA_No > 0
					cMess = cMess + " and RMA_No = "+ALLTRIM(STR(nRMA_No))+" for ID "+ALLTRIM(STR(nID_Master))
				ENDIF
				IF LEN(ThisForm.cHeat) > 0
					cMess = cMess + CHR(13) +" and Heat = '"+ThisForm.cHeat
				ENDIF
				IF LEN(cLot) > 0
					cSQL = cSQL + " AND M.Lot = '"+cLot+"'"
				ENDIF
		
				nMess = MESSAGEBOX(cMess+CHR(13)+CHR(13)+"Do you want to ADD this to stock? (Y)"+CHR(13)+"Make sure this is DIFFERENT stock (Heat/Lot)"+CHR(13)+"Answer No if this is same stock",4+48,"Add to Stock")
				IF nMess = 6
					lRun_Recv_Stock = .T.
				ENDIF
			ELSE
				*not found in History
				IF lOK AND lSaved
					IF nID_Detail = 0 AND nID_Master > 0 AND nRMA_No > 0
						*-- get Detail by RMA_No
						IF nCntPOitemMetal > 0 OR nWO_Detail > 0
							IF pSaveType = "EDIT"	
								*nCntPOitemMetal did not look for Heat
		
								IF USED('cntMDP_History')
									USE IN cntMDP_History
								ENDIF
		
								cSQL = "SELECT DISTINCT 'S' AS TBL, P.ID_Detail, P.ID_Detail_Process "
								cSQL = cSQL + " FROM dbo.Ar_StockLst_Process_History P "
								cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Detail_History D ON P.ID_Detail = D.ID_Detail "
								cSQL = cSQL + " INNER JOIN dbo.Ar_Stocklst_Master_History M ON D.ID = M.ID "
								cSQL = cSQL + " WHERE ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'NOT2HPA' OR P.Process_ID = 'RECEIVED' OR P.Process_ID = 'PARTRECV')"
								cSQL = cSQL + " AND M.ID = "+STR(nID_Master )
								
								IF LEN(cHeat) > 0
									cSQL = cSQL + " AND M.Heat = '"+cHeat+"'"
								ENDIF
								IF LEN(cLot) > 0
									cSQL = cSQL + " AND M.Lot = '"+cLot+"'"
								ENDIF
		
		
								SELECT 0
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntMDP_History')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntMDP_History')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntMDP_History")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntMDP_History")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntMDP_History')
									RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
								ENDIF
		
								IF USED('cntMDP_History')	
									IF RECCOUNT('cntMDP_History') > 0
										*A P.Process_ID = 'INCOMING' with this POitem has already been deleted
										lFoundHistory = .T.
									ENDIF
									USE IN cntMDP_History
								ENDIF
							ENDIF	
								
		
							IF NOT lFoundHistory 
								cMess = "The Heat# "+ALLTRIM(cHeat)
								IF LEN(cLot) > 0
									cMess = cMess +" /Lot "+cLot
								ENDIF
								cMess = cMess +" was not found in History."+CHR(13)
								cMess = cMess + "This Receive was to EDIT the Receive."+CHR(13)
								cMess = cMess + "Do you want to try to ADD to StockLst now? (Y)"
							
								nMess = MESSAGEBOX(cMess,4+32,"Add to Stock?")		
								
								IF nMess = 6
									lRun_Recv_Stock = .T.
								ENDIF
		
							ELSE
								lRun_Recv_Stock = .F.
								nMess = 6
							ENDIF
						ENDIF
					ENDIF
					
					**************************************
					
					IF nID_Detail > 0 AND nID_Master > 0 AND nRMA_No = 0
						DO CASE
						CASE nCntPOitemMetal > 0 
							lRun_Recv_Stock = .T.
						CASE nWO_Detail > 0
							lRun_Recv_Stock = .T.
						OTHERWISE 
							lRun_Recv_Stock = .F.
						ENDCASE
					ENDIF
				ELSE
					*NOT lOK AND lSaved
					nMess = 0
					*lRun_Recv_Stock = .T.
					lRun_Recv_Stock = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*************************
		This.Visible = .F.
		
		*PRIVATE lRan_Recv_Stock  
		*ThisForm.lRan_Recv_Stock  = .F.
		
		IF lRun_Recv_Stock AND NOT ThisForm.lRan_Recv_Stock
			DO FORM Forms\Recv_Stock WITH cPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail, lMillTrace
			lRun_Recv_Stock = .F.
			ThisForm.lRan_Recv_Stock = .T.
		ENDIF
		****
		IF NOT ThisForm.lRan_Recv_Stock  
			IF nID_Detail = 0 AND nID_Master > 0 AND nRMA_No > 0
				nMess = MESSAGEBOX("Do you want to Show/Edit the Stock?"+CHR(13)+"This was for an just an Edit to a RMA"+CHR(13)+"This will be ignoring the "+CHR(13)+"'Already Found in History' warnings!",4+32+256,"Show Stock")
				IF nMess = 6		
					DO FORM Forms\Recv_Stock WITH cPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail, lMillTrace
					ThisForm.lRan_Recv_Stock = .T.
					lRun_Recv_Stock = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*******
		IF ThisForm.lRan_Recv_Stock AND nReceivingID>0
			nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisForm.nConnHandle)
		*	nID_Master = Get_ID_Master_by_ReceivingID(nReceivingID,cTBL,ThisForm.nConnHandle)
			
			IF NOT ( cTBL="S" OR cTBL="B" OR cTBL="W" )
				cTBL = get_TBLwithID_ID_Detail(nID_Master,nID_Detail, ThisForm.nConnHandle)
			ENDIF
			
			nID_Master = get_ID_Master_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle) 
		ENDIF
		
		********************************
		PRIVATE cTBL2,cTBL3
		IF lOK AND lSaved AND ( nCntPOitemMetal > 0 or nWO_Detail > 0 ) AND NOT ThisForm.lRan_Recv_Stock  
			*only run with a Metal PO or WO_Detail
			
			*FLOOR(nPOcomplete) 0,1 Good, incomplete, 2 Good Complete, 3 Edit
			IF nID_Detail > 0 AND nID_Master > 0 AND FLOOR(nPOcomplete) > 0 AND LEN(cTBL) > 0
				cTBL2 = get_TBLwithID_ID_Detail(nID_Master,nID_Detail, ThisForm.nConnHandle)
				nMess = 6
				
				IF LEN(ALLTRIM(cTBL2)) = 2	&&Found History, Returned cTBL as 'SH
					MESSAGEBOX("This Received Stock is now Archived"+CHR(13)+"Only found in the records History Files now."+CHR(13)+"No current Found!",0+32,"No current Stock to show")
					nMess = 0
				ELSE
					cTBL3 = get_TBLwithID_ID_Detail(nID_Master,nID_Detail, ThisForm.nConnHandle,'NOCHECKHISTORY')
					IF LEN(ALLTRIM(cTBL3)) > 0
						nMess = MESSAGEBOX("Do you want to Show/Edit the Stock?"+CHR(13)+"This was for an just an Edit"+CHR(13)+"This will be ignoring the "+CHR(13)+"'Already Found in History' warnings!",4+32+256,"Show Stock")
					ELSE
						nMess =0
					ENDIF
				ENDIF
				IF nMess = 6
					DO FORM Forms\Recv_Stock WITH cPOitem, 'StockLst', nReceivingID, nRMA_Detail, nID_Detail, cHeat, cLot, nID_Master, nWO_Detail
					ThisForm.lRan_Recv_Stock = .T.
				ENDIF
			ENDIF
		ENDIF
		
		
		****************************************
		
		IF NOT lOK OR NOT lSaved
			This.Visible = .T.
		ENDIF
		
		****************************************
		*********************************
		*Alert proper department of this receive
		
		IF lOK AND lSaved
		
			*Open a SELECTED SOitem Report page
			PRIVATE m.cHyperLink, loHyperlink
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				IF Count_PO_IteminProcess( cPOItem, ThisForm.nConnHandle, "SELECTED" ) > 0
					m.cHyperLink = HTML_Receiving_SELECTED_SOitem(cPOitem,.T.)
		
					loHyperlink = CREATEOBJECT("Hyperlink")
					loHyperlink.navigateto(m.cHyperLink)
					RELEASE loHyperlink
				ENDIF
			ELSE
				IF nWO_Detail > 0
					m.cHyperLink = HTML_Receiving_WOD_SELECTED_SOitem(nWO_Detail,.T.)
		
					loHyperlink = CREATEOBJECT("Hyperlink")
					loHyperlink.navigateto(m.cHyperLink)
					RELEASE loHyperlink		
				ENDIF
			ENDIF
			
			***************************************
			PRIVATE lReport
			lReport = .T.
			
			IF pSaveType = "EDIT" OR ThisForm.lblWhat.Caption <> 'ADD'
				*check for an important edit or reason to notify users.
				lReport = .F.
				
			ENDIF
			
			**************
		
			IF lReport
				******
				IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
					IF lRMA 
						ThisForm.Alert_Receive_Email('SOitem_RMA',cSOitem,nReceivingID) &&,nRMA_No, nRMA_Detail
					ELSE
						*Send to the SOitem SalesP
						ThisForm.Alert_Receive_Email('SOitem',cSOitem,nReceivingID )
					ENDIF
				ENDIF
				******
				IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
					IF nCntPOitemMetal = 0 
						IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "SERVICES" ) > 0
							*Testing Services
							ThisForm.Alert_Receive_Email('POitem',cPOitem,nReceivingID )
						ENDIF
						IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "CONVSERV" ) > 0
							*Conversion Service
							ThisForm.Alert_Receive_Email('POitem',cPOitem,nReceivingID )
						ENDIF
						IF Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle, "EQUIPMENT" ) > 0
							*Equipement
							ThisForm.Alert_Receive_Email('POitem',cPOitem,nReceivingID )
						ENDIF
					ELSE		
						ThisForm.Alert_Receive_Email('POitem',cPOitem,nReceivingID )
					ENDIF
				ENDIF
				******
				IF nWO_Detail > 0
					ThisForm.Alert_Receive_Email('WO_Detail',nWO_Detail,nReceivingID )
				ELSE
					IF nWO > 0
						ThisForm.Alert_Receive_Email('WO',nWO,nReceivingID )
					ENDIF
				ENDIF
				******
			
				IF pSaveType == "ADD"
					* not "ADDCLONE"
					ThisForm.ResetAddVars()
				ENDIF
		
			ENDIF	 
		ENDIF
		
		*********************************
		
		RETURN lSaved 
		
		
		
	ENDPROC

	PROCEDURE saveadd_purchaseorder
		PARAMETERS nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,lCofC,cSOitem,cVendor,cComments,nPieces,nRMA,   lAlready_Saved,nActualW,nS_QTY,nS_PU,lFoundStockUpdateReceiving,nPOcomplete 
		*          nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,lFoundStockUpdateReceiving,nPOcomplete )
		*ThisForm.SaveAdd_PurchaseOrder
		
		IF VARTYPE(nReceivingID) != "N"		
			*TrackError("bad parameter","nReceivingID is not a NUMBER",PROGRAM(),LINENO(1))
			nReceivingID = 0
		ELSE
			IF nReceivingID = 0
				*TrackError("Bad Parameter","nReceivingID is 0",PROGRAM(),LINENO(1))
				TrackMess("nReceivingID is 0"+CHR(13)+"Bad Parameter"+CHR(13)+"Receiving:SaveAdd_PurchaseOrder")
			ENDIF
		ENDIF
		
		IF ( VARTYPE(dReceived) = "D" OR VARTYPE(dReceived) = "T" )
			*good
		ELSE
			dReceived = DATE()
		ENDIF
			
		IF VARTYPE(lFoundStockUpdateReceiving) != "L"
			lFoundStockUpdateReceiving = .F.
		ENDIF
		
		PRIVATE nItemPO,nHPAPO,nSalesNum,nItemSo
		nItemPO	= VAL(RIGHT(cPOitem,2))
		nHPAPO	= VAL(LEFT(cPOitem,AT('-',cPOitem)-1 ))
		nSalesNum	= VAL(LEFT(cSOitem,AT('-',cSOitem)-1 ))
		nItemSo	= VAL(RIGHT(cSOitem,2))
		
		PRIVATE lMillTrace
		lMillTrace = PrepareSQLlogic(ThisForm.chkMillTrace.Value,'MillTrace')
		
		*Mark PO
		PRIVATE lRollBack
		lRollBack = .F.
		
		PRIVATE nCntPOitem,nCntSOitem 
		nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle)
		nCntSOitem = 0
		
		*****************
		PRIVATE cHeatCombined,cLot
		cHeatCombined = cHeat
		cLot = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		
		IF nCntPOitem > 0	
			*Add new heat to heat list
			IF USED('tmpPOHeat')
				USE IN tmpPOHeat
			ENDIF
		
			SELECT 0
			cSQL = "SELECT Heat FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = '"+cPOItem+"'"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOHeat')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOHeat' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOHeat")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOHeat")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOHeat' )
			ENDIF
		
			IF USED('tmpPOHeat')
				IF VARTYPE(tmpPOHeat.Heat) = "C"
					IF NOT EMPTY(tmpPOHeat.Heat)
						IF NOT UPPER(cHeat) $ UPPER(tmpPOHeat.Heat)
							IF EMPTY(cHeat)
								cHeatCombined = PrepareSQLtxt(tmpPOHeat.Heat,'Heat',50,.F.,.T.)
							ELSE
								cHeatCombined = ALLTRIM(cHeat)+","+ALLTRIM(PrepareSQLtxt(tmpPOHeat.Heat,'Heat',50,.F.,.T.))
							ENDIF
						ENDIF
					ENDIF
				ELSE
					*Null Heat found!
				ENDIF
				USE IN tmpPOHeat
			ENDIF
		ENDIF
		
		********************
		IF nCntPOitem = 0	
			
		*	nCntSOitem = Count_SOIteminSales(cSOItem, ThisForm.nConnHandle)		
		*	IF nCntSOitem = 0
				*Did not find that PO in PurchaseOrder!
		
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" #Rollback")
				MESSAGEBOX("Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" #Rollback"+CHR(13)+"Please check that you typed the right PO or SO!",0,"PO or SO item not found!")
				*Do not add to PurchaseOrder
				*POitem is check early in receiving
				lRollBack = .T.
		*	ENDIF
		ENDIF
		
		PRIVATE lHold
		lHold	= PrepareSQLchk(ThisForm.chkHold.Value,'Hold')
		PRIVATE lPOSaveLst 
		lPOSaveLst = .F.
		
		********************
		IF NOT lRollBack AND nCntPOitem > 0	
		
			PRIVATE cSQLu
			cSQLu = "UPDATE dbo.PurchaseOrder SET "
			cSQLu = cSQLu + " Receipt ='"+cComments+"'"
			*cSQLu = cSQLu + ",Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"		
			cSQLu = cSQLu + ",ReceivedBy ='"+cInit+"'"
			cSQLu = cSQLu + ",Heat ='"+PrepareSQLtxt(cHeatCombined,'Heat',50,.F.,.T.)+"'"
			IF nPOcomplete = 2
				cSQLu = cSQLu + ",Delivered=1"
				cSQLu = cSQLu + ",CMPLT=1"
			ENDIF
			cSQLu = cSQLu + ",Cert="+IIF(lCert or lCofC,'1','0')
			IF lHold
				cSQLu = cSQLu + ",Hold=1 "
			ENDIF
			cSQLu = cSQLu + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOItem+"')"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
				lRollBack = .T.
			ELSE
				lPOSaveLst = .T.
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" updated POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrders to Delivered.")
			ENDIF
		ENDIF	
		
		
		********************
		IF lRollBack
			RETURN .F.
		ENDIF
		
		
		****************************
		*ThisForm.RefreshReceiving()
		
		********************		
		IF nCntPOitem > 0	
		*	ThisForm.ReportReceivedtoOrdered(cPOitem)
			*ThisForm.ReceivingRefreshReceiving()
			PRIVATE nWO, nWO_Detail 
			nWO 		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
			nWO_Detail  = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
			
		*	IF lAlready_Saved
				IF lFoundStockUpdateReceiving 
					ThisForm.Receive_Stock( cPOitem, nReceivingID, cHeat, cLot, 0, cSOitem, nWO_Detail, lMillTrace ) 
					*pPOitem, pnReceivingID, cHeat, cLot, nRMA_Detail, pSOitem, pWO_Detail, lMillTrace
				ELSE
					ThisForm.Receive_Stock( cPOitem, nReceivingID, cHeat, cLot, 0, cSOitem, nWO_Detail, lMillTrace ) 
				ENDIF
		*	ELSE
		*		ThisForm.Receive_Stock( cPOitem, nReceivingID, cHeat, cLot, 0, cSOitem, nWO_Detail, lMillTrace ) 
		*	ENDIF
		ENDIF
		
		
		
		*************************
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		
		*!*	*******************
		*!*	IF NOT lRollBack AND lPOSaveLst 
		*!*		IF nPOcomplete = 1 OR nPOcomplete = 2
		*!*			*Clear INCOMING Stock Process'
		*!*			*nReceivingID is essential
		*!*			
		*!*			IF NOT Remove_Incoming_Process_RID(cPOitem,nPieces,nActualW,nS_QTY,nS_PU,ThisForm.nConnHandle,nPOcomplete,nReceivingID,cTBL)
		*!*				
		*!*				PRIVATE cMess
		*!*				cMess = "Remove_Incoming_Process_RID("
		*!*				IF NOT Proper_PO_item(cPOitem) = Proper_PO_item('')
		*!*					cMess = cMess + " POitem='"+cPOitem+"'"
		*!*				ENDIF
		*!*				IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
		*!*					cMess = cMess + ", SOitem='"+cSOitem+"'"
		*!*				ENDIF
		*!*				cMess = cMess + ", nPieces="+ALLTRIM(STR(nPieces))
		*!*				cMess = cMess + ", nActualW="+ALLTRIM(STR(nActualW))
		*!*				cMess = cMess + ", WO_Detail="+ALLTRIM(STR(nWO_Detail))
		*!*				
		*!*				TrackError(cMess,"Bad variable or Fail",PROGRAM(),LINENO(1))
		*!*				TrackMess("Remove_Incoming_Process_RID"+CHR(13)+"Bad variable or Fail"+CHR(13)+"Receiving:SaveAdd(Remove_Incoming_Process_RID)")
		*!*			ENDIF
		*!*	 		*lPOSaveLst = Remove_Incoming_Process_by_POitem(cPOitem, ThisForm.nConnHandle)
		*!*			
		*!*			IF ThisForm.cWhat = "S_Process" OR ThisForm.cWhat = "B_Process" OR ThisForm.cWhat = "W_Process"
		*!*				* Do not rely on POitem
		*!*				*remove INCOMING Process that Receive Edit started
		*!*				PRIVATE nID_Detail_Process
		*!*				nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		*!*				DO CASE
		*!*				CASE ThisForm.cWhat = "S_Process"
		*!*					cSQL = "DELETE FROM dbo.StockLst_Process "
		*!*				CASE ThisForm.cWhat = "B_Process"
		*!*					cSQL = "DELETE FROM dbo.BrokerLst_Process "
		*!*				CASE ThisForm.cWhat = "W_Process"
		*!*					cSQL = "DELETE FROM dbo.WIPLst_Process "
		*!*				ENDCASE
		*!*				cSQL = cSQL + "	WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		*!*				
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*						
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO
		*!*				ENDIF 
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
		
		***************
		RETURN .T.
	ENDPROC

	PROCEDURE saveadd_wo_detail
		PARAMETERS nReceivingID,nWO_Detail,cComments,dReceived,cInit,cHeat,lCert,lCofC,pcSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,nWODcomplete 
		*         (nReceivingID,nWO_Detail,cComments,dReceived,cInit,cHeat,lCert,lCofC,pcSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,nWODcomplete )
		*ThisForm.SaveAdd_WO_Detail(nReceivingID,nWO_Detail,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA_No,lAlready_Saved,nActualW,nAcct_QTY,nAcct_PU,lFoundStockUpdateReceiving,nWODcomplete )
		
		nReceivingID = PrepareSQLnum(nReceivingID,'ReceivingID',-3)
		IF nReceivingID = 0
			*TrackError("Bad Parameter","nReceivingID is 0",PROGRAM(),LINENO(1))
			TrackMess("nReceivingID is 0"+CHR(13)+"Bad Parameter"+CHR(13)+"Receiving:SaveAdd_WO_Detail")
		ENDIF
		
		
		DO CASE 
		CASE VARTYPE(dReceived) = "D" 
		CASE VARTYPE(dReceived) = "T" 
		OTHERWISE
			dReceived = DATE()
		ENDCASE
			
		IF VARTYPE(lFoundStockUpdateReceiving) != "L"
			lFoundStockUpdateReceiving = .F.
		ENDIF
		
		PRIVATE cSOitem,nSalesNum,nItemSo
		cSOitem 	= Proper_SO_Item(pcSOitem)
		nSalesNum	= VAL(LEFT(cSOitem,AT('-',cSOitem)-1 ))
		nItemSo		= VAL(RIGHT(cSOitem,2))
		
		*Mark PO
		PRIVATE lRollBack
		lRollBack = .F.
		
		PRIVATE nCntWO_Detail,nCntSOitem 
		nCntWO_Detail = Count_WODinWO_Detail( nWO_Detail, ThisForm.nConnHandle,"NOTCANCELLED")
		nCntSOitem = 0
		
		********************
		IF nCntWO_Detail = 0	
			TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for WO_Detail:"+STR(nWO_Detail)+" #NotFound#Rollback")
			MESSAGEBOX("Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for WO_Detail:"+STR(nWO_Detail)+" #NotFound#Rollback"+CHR(13)+"Please check that you typed the right WO_Detail!",0,"WO_Detail not found!")
			lRollBack = .T.
		ENDIF
		
		PRIVATE lHold
		lHold	= PrepareSQLchk(ThisForm.chkHold.Value,'Hold')
		PRIVATE lWOD_SaveLst 
		lWOD_SaveLst = .F.
		PRIVATE nID_Master, nID_Detail, cHeat, cLot
		nID_Master = PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3)
		nID_Detail= PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
		cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		cTBL = PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		
		********************
		IF NOT lRollBack AND nCntWO_Detail > 0	
		
			PRIVATE cSQLu
			cSQLu = "UPDATE dbo.WorkOrder_Detail SET "
		*	cSQLu = cSQLu + " Receipt ='"+cComments+"'"
			*cSQLu = cSQLu + ",Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"		
			cSQLu = cSQLu + " fHeat='"+cHeat+"',fLot='"+clot+"'"
			cSQLu = cSQLu + ",fReceivingID="+STR(nReceivingID)
		
		*	cSQLu = cSQLu + ",ReceivedBy ='"+cInit+"'"
			*cSQLu = cSQLu + ",Heat ='"+PrepareSQLtxt(cHeatCombined,'Heat',50,.F.,.T.)+"'"
			IF nWODcomplete = 2
		*		cSQLu = cSQLu + ",Delivered=1"
				cSQLu = cSQLu + ",fCMPLT=1"
			ENDIF
			cSQLu = cSQLu + ",stkListed=1"
		*	cSQLu = cSQLu + ",Cert="+IIF(lCert,'1','0')
		*	IF lHold
		*		cSQLu = cSQLu + ",Hold=1 "
		*	ENDIF
			cSQLu = cSQLu + " WHERE WO_Detail ="+STR(nWO_Detail)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
				lRollBack = .T.
			ELSE
				lPOSaveLst = .T.
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" updated WO_Detail:"+ALLTRIM(STR(nWO_Detail))+" as Complete.")
			ENDIF
		ENDIF	
		
		
		
		
		********************
		*!*	IF NOT lRollBack AND lWOD_SaveLst 
		*!*		IF nWODcomplete = 1 OR nWODcomplete = 2
		*!*			*Clear INCOMING Stock Process'
		*!*			*nReceivingID is essential
		*!*			
		*!*			IF NOT Remove_Incoming_Process_by_WO_Detail_RID(cPOitem,nPieces,nActualW,nS_QTY,nS_PU,ThisForm.nConnHandle,nWODcomplete,nReceivingID,cTBL)
		*!*				
		*!*				PRIVATE cMess
		*!*				cMess = "Remove_Incoming_Process_RID("
		*!*				cMess = cMess + " WO_Detail="+STR(nWO_Detail)
		*!*				
		*!*				IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
		*!*					cMess = cMess + ", SOitem='"+cSOitem+"'"
		*!*				ENDIF
		*!*				cMess = cMess + ", nPieces="+ALLTRIM(STR(nPieces))
		*!*				cMess = cMess + ", nActualW="+ALLTRIM(STR(nActualW))
		*!*	*			cMess = cMess + ", WO_Detail="+ALLTRIM(STR(nWO_Detail))
		*!*				
		*!*				TrackError(cMess,"Bad variable or Fail",PROGRAM(),LINENO(1))
		*!*				TrackMess("Remove_Incoming_Process_RID"+CHR(13)+"Bad variable or Fail"+CHR(13)+"Receiving:SaveAdd_WO_Detail(Remove_Incoming_Process_RID)")
		*!*			ENDIF
		*!*	 		*lPOSaveLst = Remove_Incoming_Process_by_POitem(cPOitem, ThisForm.nConnHandle)
		*!*			
		*!*			IF ThisForm.cWhat = "S_Process" OR ThisForm.cWhat = "B_Process" OR ThisForm.cWhat = "W_Process"
		*!*				* Do not rely on POitem
		*!*				*remove INCOMING Process that Receive Edit started
		*!*				PRIVATE nID_Detail_Process
		*!*				nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		*!*				DO CASE
		*!*				CASE ThisForm.cWhat = "S_Process"
		*!*					cSQL = "DELETE FROM dbo.StockLst_Process "
		*!*				CASE ThisForm.cWhat = "B_Process"
		*!*					cSQL = "DELETE FROM dbo.BrokerLst_Process "
		*!*				CASE ThisForm.cWhat = "W_Process"
		*!*					cSQL = "DELETE FROM dbo.WIPLst_Process "
		*!*				ENDCASE
		*!*				cSQL = cSQL + "	WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		*!*				cSQL = cSQL + " AND Process_ID = 'INCOMING' "
		*!*				
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*						
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO
		*!*				ENDIF 
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE saveasnewreceiving
		*ThisForm.SaveAsNewReceiving()
		
		PRIVATE dReceived, cAlloy, cHeat, cLot, lCert, lCofC, lMillTrace, nPieces, cDescription
		PRIVATE cSpecs, cComments, cInit, dDate, lPass_PW, lGoodPapers, lHold, nActualW, nBillW, cVendor, nRMA_No, nRMA_Detail
		PRIVATE cRejectReason
		dReceived	= PrepareSQLdate(ThisForm.txtReceived.Value,'Received')
		cAlloy		= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= UPPER(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50,.f.))
		cLot		= UPPER(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10,.f.))
		
		lCert		= PrepareSQLchk(ThisForm.chkCert.Value,'Cert')
		lCofC		= PrepareSQLchk(ThisForm.chkCofC.Value,'CofC')
		lMillTrace	= PrepareSQLchk(ThisForm.chkMillTrace.Value,'MillTrace')
		
		nPieces		= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
		cDescription= PrepareSQLtxt(ThisForm.edtDescription.Value,'Description',-1,.F.)
		cSpecs		= PrepareSQLtxt(ThisForm.edtSpecs.Value,'Specs',-1)
		cComments	= PrepareSQLtxt(ThisForm.edtComments.Value,'Comments',-1,.F.)
		cInit		= PrepareSQLtxt(ThisForm.txtInit.Value,'Init',10 )
		dDate		= PrepareSQLdate(ThisForm.txtDate.Value,'Date')
		lPass_PW		= PrepareSQLlogic(Thisform.chkPass.Value,'Pass')
		lGoodPapers	= PrepareSQLlogic(ThisForm.chkGoodPapers.Value,'GoodPapers')
		lHold		= PrepareSQLlogic(ThisForm.chkHold.Value,'Hold')
		nActualW	= PrepareSQLnum(ThisForm.txtActualW.Value,'Actual',9,1)
		nBillW		= PrepareSQLnum(ThisForm.txtBillW.Value,'BillW',9,1)
		
		PRIVATE nAcct_QTY, nAcct_P, nAcct_PU
		nAcct_QTY	= PrepareSQLnum(ThisForm.txtAcct_Qty.Value,'S_QTY',-5)	&&Acct
		nAcct_P		= PrepareSQLnum(ThisForm.txtAcct_P.Value,'S_P',-5)	
		nAcct_PU	= PrepareSQLnum(ThisForm.lblAcct_PU.Caption,'PU',-1)
		PRIVATE nPO_QTY, nPO_P, nPO_PU
		nPO_QTY = PrepareSQLnum(ThisForm.txtPO_QTY.Value,'PO_QTY',-5)	&&Vendor
		nPO_P	= PrepareSQLnum(ThisForm.txtPO_P.Value,'PO_P',-5)	&&Vendor
		nPO_PU	= PrepareSQLnum(ThisForm.lblPO_PU.Caption,'PU',-1)
		
		***************
		cVendor		= PrepareSQLtxt(ThisForm.txtVendor.Value,'Vendor',30,.F.,.T. )
		nRMA_No		= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		nRMA_Detail	= PrepareSQLnum(ThisForm.txtRMA_detail.Value,'RMA_Detail',-3)
		cRejectReason= PrepareSQLtxt(ThisForm.edtRejectReason.Value,'RejectReason',255,.f. )
		
		PRIVATE nWO_Detail, nWO
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		PRIVATE nRMA, nRMA_Detail
		nRMA 	= PrepareSQLnum(ThisForm.nRMA,'RMA',-3)
		nRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		
		PRIVATE nID_Master, nID_Detail, nID_Detail_PRC, cTBL, cForm
		*!*	nID_Master = PrepareSQLnum(Thisform.txtID_Master.Value,'ID_Master',-3)
		*!*	nID_Detail = PrepareSQLnum(Thisform.txtID_Detail.Value,'ID_Detail',-3)
		*!*	nID_Detail_PRC = PrepareSQLnum(Thisform.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		*!*	cTBL 		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		cForm		= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		
		
		**********************
		PRIVATE lServicesPO, lConvServ, lEquipment
		lServicesPO		= PrepareSQLlogic(ThisForm.chkLab_Service.VALUE,'ServicesPO',.F.)
		lConvServ		= PrepareSQLlogic(ThisForm.chkConvServ.VALUE,'ConvServ',.f.)
		lEquipment		= PrepareSQLlogic(ThisForm.chkEquipment.VALUE,'Equipment',.F.)
		
		*cComments
		PRIVATE lLabServices, nCountPOitem 
		lLabServices = .F.
		nCountPOitem = 0
		
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
			*Is this a Lab Test?
			*lLabService = Get_From_POitem (cPOitem, "Field", ThisForm.nConnHandle )
			nCountPOitem = PO_POitem_Cnt( cPOitem, ThisForm.nConnHandle, 'SERVICES' ) &&NOTRECEIVE includes (Services AND ConvServ AND Equipment)
			IF nCountPOitem > 0 OR lServicesPO
				lLabServices = .T.
				
				IF NOT "Received data from paid Services" $ cComments
					IF LEN(cComments)>0
						cComments = cComments+ CHR(13)
					ENDIF
					cComments = cComments+ "Received data from paid Services "
				ENDIF
			ENDIF
		ENDIF
		IF nWO_Detail > 0
			cComments = "From Work Order Detail "+STR(nWO_Detail)
		ENDIF
		
		
		
		*************************
		*************************
		PRIVATE cSQLi 
		
		*Insert INTO dbo.Receiving
		cSQLi = "EXEC dbo.p_Receiving_ins5 "
		cSQLi = cSQLi +" @Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
		cSQLi = cSQLi +",@POitem = '"+cPOitem+"'"
		cSQLi = cSQLi +",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi +",@WO_Detail = "+STR(nWO_Detail)
		cSQLi = cSQLi +",@Alloy ='"+cAlloy+"'"
		cSQLi = cSQLi +",@Heat ='"+cHeat+"'"
		cSQLi = cSQLi +",@Cert ="+IIF(lCert,'1','0')+""	&&BIT
		cSQLi = cSQLi +",@CofC ="+IIF(lCofC,'1','0')+""	&&BIT
		cSQLi = cSQLi +",@Pieces ="+STR(nPieces)
		cSQLi = cSQLi +",@Description ='"+cDescription+"'"
		cSQLi = cSQLi +",@Specs ='"+cSpecs+"'"
		cSQLi = cSQLi +",@Comments ='"+cComments+"'"
		cSQLi = cSQLi +",@Init ='"+cInit+"'"
		cSQLi = cSQLi +",@Date ='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
		cSQLi = cSQLi +",@Pass ="+IIF(lPass_PW,'1','0')
		cSQLi = cSQLi +",@GoodPapers ="+IIF(lGoodPapers,'1','0')
		cSQLi = cSQLi +",@ActualW ="+STR(nActualW)
		cSQLi = cSQLi +",@BillW ="+STR(nBillW)
		cSQLi = cSQLi +",@Vendor ='"+cVendor+"'"
		cSQLi = cSQLi +",@RejectReason ='"+cRejectReason+"'"
		cSQLi = cSQLi +",@RMA_No="+STR(nRMA_No)
		
		IF USED("tmpIDReceiving")
			USE IN tmpIDReceiving
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpIDReceiving')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpIDReceiving")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpIDReceiving")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpIDReceiving')
			TrackError("Insert INTO dbo.Receiving. "+CHR(13)+cSQLi ,"bad update",PROGRAM(),LINENO(1))
		ELSE &&IF nSQLEXEC < 1
		
			IF USED("tmpIDReceiving")
				nReceivingID = PrepareSQLnum(tmpIDReceiving.EXP,'RID',-3)
				
				IF nReceivingID > 0		&&Should do this later when ID_Master and ID_Detail are known
					lSaved = .T.
					*UPDATE the rest of that dbo.Receiving record
					
					cSQLu = "UPDATE dbo.Receiving SET "
					*cSQLu = cSQLu +" StockTable='"+cTBL+"'"
					*cSQLu = cSQLu +",ID_Master="+STR(nID_Master)
					*cSQLu = cSQLu +",ID_Detail="+STR(nID_Detail)
					cSQLu = cSQLu +" RMA_Detail="+STR(nRMA_Detail)
					
					cSQLu = cSQLu +",Lot='"+cLot+"'"
					
					cSQLu = cSQLu +",R_Qty="+STR(nAcct_QTY,18,4)
					cSQLu = cSQLu +",R_P= "+STR(nAcct_P,18,4)
					cSQLu = cSQLu +",R_PU="+STR(nAcct_PU)
					
					*use PO Fields for WO_Detail Data
					cSQLu = cSQLu +",PO_Qty="+STR(nPO_QTY,18,4)
					cSQLu = cSQLu +",PO_P="+STR(nPO_P,18,4)
					cSQLu = cSQLu +",PO_PU="+STR(nPO_PU)
		
					cSQLu = cSQLu +",hold="+IIF(lHold,"1","0")
					cSQLu = cSQLu +",Form='"+cForm+"'"
					
					cSQLu = cSQLu +",Services="+IIF(lServicesPO,"1","0")
					cSQLu = cSQLu +",ConvServ="+IIF(lConvServ,"1","0")
					cSQLu = cSQLu +",Equipment="+IIF(lEquipment,"1","0")
					
					cSQLu = cSQLu +",MillTrace="+IIF(lMillTrace,'1','0')
					
					cSQLu = cSQLu + " WHERE ID="+STR(nReceivingID)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, '')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
						TrackError("UPDATE the rest of table dbo.Receiving. "+CHR(13)+cSQLu ,"bad update",PROGRAM(),LINENO(1))
					ENDIF
					
					
		
					USE IN tmpIDReceiving 
					ThisForm.txtReceivingID.Value = nReceivingID 
					ThisForm.txtReceivingID.Refresh
				ENDIF						
			ENDIF
			
		ENDIF
		
		IF lSaved 
			IF NOT lPass_PW
				IF lHold
					MESSAGEBOX("Since this material did not PASS Specs,"+CHR(13)+"this will be considered on ReceiveOnHold."+CHR(13)+CHR(13)+"The PO Sales Rep will be notified"+CHR(13)+"daily so this order can be fixed.",48,"On Receive Hold")
					*PARAMETERS    pcType_Name,      pnNumber,  pcNumber,  pcMessage                                                                                                                                 , pConnHandle
					Send_Chatter("ReceivingID_Hold",nReceivingID,"BLANK","The receiving material for ReceivingID "+ALLTRIM(STR(nReceivingID))+", Placed on Receive OnHold."+CHR(13)+HTML_ReceivingID(nReceivingID,.T.),ThisForm.nConnHandle)
					*Send_Chatter("QA",0,"BLANK","The receiving material did not PASS Specs for ReceivingID "+ALLTRIM(STR(nReceivingID))+", Placed on QA Hold.",ThisForm.nConnHandle)
				ENDIF
			ENDIF
		ELSE
			nReceivingID = 0
		ENDIF
		
		
		
		RETURN nReceivingID 
		
	ENDPROC

	PROCEDURE save_po
	ENDPROC

	PROCEDURE set_rma_ss_id
		PARAMETERS pnRMA_Detail
		*ThisForm.Set_RMA_SS_ID()
		
		PRIVATE cSOitem, cHeat, cLot
		cSOitem	= ThisForm.cSOitem
		cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot  = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		
		IF USED('cntSS_History')
			USE IN cntSS_History
		ENDIF
		
		cSQL = "SELECT SS.ID,TBL,StockLst_ID,StockLst_ID_Detail,SS.ID_Detail_Process,Sales_Detail_ID"
		cSQL = cSQL + ",SS.Heat,SS.Lot,SS.PackingSli,SS.RMA_Detail_ID "
		cSQL = cSQL + ",SS.Return_ID_Master,SS.Return_ID_Detail "
		cSQL = cSQL + " ,P.ID AS PID, P.ID_Detail AS PID_Detail "
		cSQL = cSQL + " FROM dbo.Sales_Stock SS "
		cSQL = cSQL + " left outer join dbo.Ar_StockLst_Process_Detail_History P "
		cSQL = cSQL + " 	ON SS.ID_Detail_Process = P.ID_Detail_Process AND P.[What]='Sell Stock' "
		
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			cSQL = cSQL + " WHERE SS.SOitem=dbo.f_ProperSOitem('"+cSOitem+"')"
		ELSE
			IF LEN(cHeat) > 0 OR LEN(cLot) > 0
				cSQL = cSQL + " WHERE "
				IF LEN(cHeat) > 0
					cSQL = cSQL + " Heat = '"+cHeat+"'"
					IF LEN(cLot) > 0
						cSQL = cSQL + " AND Lot = '"+cLot+"'"
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSS_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSS_History')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSS_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSS_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntSS_History')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		PRIVATE nSS_ID, cTBL, nStockLst_ID, nStockLst_ID_Detail, nID_Detail_Process, nSales_Detail_ID
		PRIVATE nReturn_ID_Master, nReturn_ID_Detail
		PRIVATE cHeat2, cLot2, nPackingSli, nRMA_Detail_ID,nPID, nPID_Detail
		nSS_ID	= 0
		cTBL	= ''
		nStockLst_ID	= 0
		nStockLst_ID_Detail	= 0
		nID_Detail_Process	= 0
		nSales_Detail_ID	= 0
		nReturn_ID_Master	= 0
		nReturn_ID_Detail	= 0
		cHeat2		= ''
		cLot2		= '' 
		nPackingSli	= 0
		nRMA_Detail_ID	= 0
		nPID	= 0
		nPID_Detail	= 0
		
		PRIVATE nUseID_Master, nUseID_Detail
		nUseID_Master = 0
		nUseID_Detail = 0
		
		IF USED('tmpSS_Hist')
			USE IN tmpSS_Hist
		ENDIF
		
		IF USED('cntSS_History')	
			IF RECCOUNT('cntSS_History') > 0
			
				IF LEN(cHeat) > 0
					IF LEN(cLot) > 0
						LOCATE FOR Heat = cHeat AND Lot = cLot
						IF FOUND('cntSS_History')
							*SET FILTER TO Heat = cHeat AND Lot = cLot
							SELECT * FROM cntSS_History WHERE Heat = cHeat AND Lot = cLot INTO CURSOR tmpSS_Hist
						ENDIF
					ELSE
						LOCATE FOR Heat = cHeat 
						IF FOUND('cntSS_History')
							*SET FILTER TO Heat = cHeat
							SELECT * FROM cntSS_History WHERE Heat = cHeat INTO CURSOR tmpSS_Hist
						ENDIF
					ENDIF
				ELSE
					
					*Do not restrict to RMA_Detail just yet
					SELECT * FROM cntSS_History INTO CURSOR tmpSS_Hist
					*IF FOUND('cntSS_History')
					*	SET FILTER TO RMA_Detail = pnRMA_Detail
					*ENDIF
				ENDIF
				
				IF NOT USED('tmpSS_Hist')
					SELECT * FROM cntSS_History INTO CURSOR tmpSS_Hist
				ENDIF
				
				IF RECCOUNT("tmpSS_Hist")>1
					TrackError("Found History when looking for a Sales_Stock StockLst_ID"+CHR(13)+"for RMA_Detail ="+STR(pnRMA_Detail)+CHR(13)+"Records="+STR(RECCOUNT("tmpSS_Hist"))+CHR(13)+CHR(13)+cSQL,"Receiving:Set_RMA_SS_ID", PROGRAM(), LINENO(1))	
				ENDIF
				
				SELECT tmpSS_Hist
				SCAN
					nSS_ID		= PrepareSQLnum(tmpSS_Hist.ID,'Sales_Stock_ID',-3)
					cTBL		= PrepareSQLtxt(tmpSS_Hist.TBL,'TBL',1)
					nStockLst_ID	= PrepareSQLnum(tmpSS_Hist.StockLst_ID,'StockLst_ID',-3)
					nStockLst_ID_Detail	= PrepareSQLnum(tmpSS_Hist.StockLst_ID_Detail,'StockLst_ID_Detail',-3)
					nID_Detail_Process	= PrepareSQLnum(tmpSS_Hist.ID_Detail_Process,'ID_Detail_Process',-3)
					nSales_Detail_ID	= PrepareSQLnum(tmpSS_Hist.Sales_Detail_ID,'Sales_Detail_ID',-3)
					nReturn_ID_Master	= PrepareSQLnum(tmpSS_Hist.Return_ID_Master,'Return_ID_Master',-3)
					nReturn_ID_Detail	= PrepareSQLnum(tmpSS_Hist.Return_ID_Detail,'Return_ID_Detail',-3)
					cHeat2			= PrepareSQLtxt(tmpSS_Hist.Heat,'Heat',50)
					cLot2			= PrepareSQLtxt(tmpSS_Hist.Lot,'Lot',10)
					nPackingSli		= PrepareSQLnum(tmpSS_Hist.PackingSli,'PackingSli',-3)
					nRMA_Detail_ID	= PrepareSQLnum(tmpSS_Hist.RMA_Detail_ID,'RMA_Detail',-3)
					nPID			= PrepareSQLnum(tmpSS_Hist.PID,'ID_Master',-3)
					nPID_Detail		= PrepareSQLnum(tmpSS_Hist.PID_Detail,'ID_Detail',-3)
					
					***
					IF nReturn_ID_Master > 0
						nUseID_Master  = nReturn_ID_Master 
					ELSE
						IF nPID > 0
							nUseID_Master  = nPID
						ELSE	
							nUseID_Master	= nStockLst_ID
						ENDIF
					ENDIF
					***		
					IF nReturn_ID_Detail > 0
						nUseID_Detail   = nReturn_ID_Detail 
					ELSE
						IF nPID_Detail > 0
							nUseID_Detail  = nPID_Detail
						ELSE
							nUseID_Detail  = nStockLst_ID_Detail
						ENDIF
					ENDIF
					***
								
				ENDSCAN
				
				ThisForm.txtID_Master.Value	= nUseID_Master
				ThisForm.txtID_Detail.Value	= nUseID_Detail
				ThisForm.txtID_Detail_Process.Value = 0 &&nID_Detail_Process
				ThisForm.RMA_SS_ID = nSS_ID
				
				**************************
				IF nSS_ID > 0
					cSQL = "UPDATE dbo.Sales_Stock SET"
					cSQL= cSQL+" RMA_Detail_ID = "+STR(nSS_ID)
					cSQL= cSQL+", Return_ID_Master = "+STR(nUseID_Master)
					*cSQL= cSQL+", Return_ID_Detail = "+STR(nUseID_Detail)
					cSQL= cSQL+",[Returned] = CASE WHEN ISNULL([Returned],CONVERT (date,GETDATE()) )=CONVERT (date,GETDATE()) then GETDATE() ELSE [Returned] end"
					*cSQL= cSQL+" WHERE ID_Detail_Process ="+STR(nID_Detail_Process)
					cSQL= cSQL+" WHERE ID = "+STR(nSS_ID)	&&
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 1
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
						*RETURN
						RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update. "+CHR(13)+cSQL )
					ENDIF
				ENDIF
			ENDIF
			
			USE IN tmpSS_Hist
		ENDIF
		
		IF USED('cntSS_History')
			USE IN cntSS_History
		ENDIF
		
		RETURN nUseID_Master > 0
	ENDPROC

	PROCEDURE showpoitem
		PARAMETERS pcPOitem
		*ThisForm.ShowPOitem(cPOitem)
		
		PRIVATE cPOitem, cSOitem
		cPOitem = ''
		
		IF VARTYPE(pcPOitem) = "C"
			cPOitem = Proper_PO_Item( pcPOitem )
		ENDIF
		
		IF EMPTY(cPOitem )
			MESSAGEBOX("Cannot get PO.",0+32,"No PO-item")
			RETURN .F.
		ENDIF
		
		PRIVATE lnText2Find  
		lnText2Find  = VAL(LEFT(cPOitem,AT("-",cPOitem)-1))
		
		ThisForm.txtFindText.Value = STR(lnText2Find)
		
		SELECT Receiving
		*POitem
		SET ORDER TO TAG HPAPO
		SEEK lnText2Find  IN 'Receiving' ORDER HPAPO
		
		IF NOT FOUND('Receiving')
			IF Count_HPAPOinPurchaseOrder( lnText2Find, ThisForm.nConnHandle ) = 0
				MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" has not been entered!"+CHR(13)+"Have this PO added in PurchaseOrder screen",0+16,"PO Not Found, Stop receiving and enter PO first!")
			ELSE
				IF Count_HPAPOinStockLst( lnText2Find, ThisForm.nConnHandle ) = 0
					MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" was not found in StockLst\BrokerLst list."+CHR(13)+"Have this PO edited in PurchaseOrder screen"+CHR(13)+"so ALL PO related tables are updated!",0+16,"PO Not Found, Stop receiving and enter PO first!")
				ELSE
					MESSAGEBOX(	"Po ="+ALLTRIM(STR(lnText2Find))+" was not found."+CHR(13)+CHR(13)+"But was found in PurchaseOrder and StockLst/BrokerLst!.",0+64,"Not found in Receiving.")
				ENDIF
			ENDIF
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE showpoitemtype
		PARAMETERS cPOitem
		*ThisForm.ShowPOitemType(cPOitem)
		
		IF Proper_PO_item(cPOitem) = Proper_PO_item('')
			ThisForm.chkLab_Service.Visible = .T.
			ThisForm.chkConvServ.Visible = .T.
			ThisForm.chkEquipment.Visible = .T.
		
			ThisForm.chkCert.Visible = .T.
			ThisForm.chkCofC.Visible = .T.
			ThisForm.chkMillTrace.Visible = .T.
			RETURN .F.
		ENDIF
		
		ThisForm.chkLab_Service.Visible = .F.
		ThisForm.chkConvServ.Visible = .F.
		ThisForm.chkEquipment.Visible = .F.
		
		ThisForm.chkCert.Visible = .T.
		ThisForm.chkCofC.Visible = .T.
		ThisForm.chkMillTrace.Visible = .T.
		
		PRIVATE nCntPO_Stock 
		*nCntPO_NotStock = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, "NOTSTOCK" )
		nCntPO_Stock = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, "FORSTOCK" )
		IF nCntPO_Stock > 0
			This.Caption = "Material Recieving"
			ThisForm.POType = "MAT"
			
		*	ThisForm.chkCert.Visible = .T.
		*	ThisForm.chkCofC.Visible = .T.
		*	ThisForm.chkMillTrace.Visible = .T.
		
		ELSE
			IF Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, "CONVSERV" ) > 0
				This.Caption = "Recieving material from Conversion Service"
				ThisForm.chkConvServ.Visible = .T.
				ThisForm.chkConvServ.Enabled = .T.
				
				ThisForm.POType = "CNV"
		
				ThisForm.chkCert.Visible = .F.
				ThisForm.chkCofC.Visible = .F.
				ThisForm.chkMillTrace.Visible = .F.	
			ELSE
				IF Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, "SERVICES" ) > 0
					This.Caption = "Receiving data for Lab Services"
					ThisForm.chkLab_Service.Visible = .T.
					ThisForm.chkLab_Service.Enabled = .T.
					
					ThisForm.POType = "SRV"
					*ThisForm.PO
					
					ThisForm.chkCert.Visible = .F.
					ThisForm.chkCofC.Visible = .F.
					ThisForm.chkMillTrace.Visible = .F.
				ELSE
					IF Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, "EQUIPMENT" ) > 0
						This.Caption = "Receiving Equipement"
						ThisForm.chkEquipment.Visible = .T.
						ThisForm.chkEquipment.Enabled = .T.
						
						ThisForm.POType = "EQP"
						
						ThisForm.chkCert.Visible = .F.
						ThisForm.chkCofC.Visible = .F.
						ThisForm.chkMillTrace.Visible = .F.
					ELSE
						This.Caption = "Receive Edit"
						ThisForm.POType = ""
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
					
		*Check Vendor QAType
		*IF is_Vendor_LabService(nHpaPo, ThisForm.nConnhandle) &&Checks Vendor QAtype
			*nMess = MESSAGEBOX("PO "+ALLTRIM(STR(nHPApo))+" is for a Test Report."+CHR(13)+"This is not the Vendor!"+CHR(13)+"Are you receiving to the right PO?"+CHR(13)+CHR(13)+"Do you still want to continue?",4+256+16,"Wrong PO") 
		*ENDIF
	ENDPROC

	PROCEDURE stripdescription
		PARAMETERS pDescription
		*ThisForm.StripDescription(pDescription) 
		
		pDescription = PrepareSQLtxt(pDescription,'pDescription',-1)
		
		PRIVATE cAlloy
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		
		PRIVATE cDescAlloy
		cDescAlloy = LEFT(pDescription,12)
		
		IF ALLTRIM(cDescAlloy) = ALLTRIM(cAlloy)
			*Strip Alloy
			pDescription = SUBSTR(pDescription,LEN(ALLTRIM(cAlloy))+2 )
			*pDescription = SUBSTR(pDescription,LEN(ALLTRIM(cAlloy))
		
		ENDIF
		
		IF AT( ")", pDescription ) > 0
			pDescription = SUBSTR(pDescription,AT( ")", pDescription )+2 )
		ENDIF
		
		RETURN pDescription 
	ENDPROC

	PROCEDURE Unload
		IF USED('Receiving')	
			USE IN Receiving 
		ENDIF
		
		IF USED('poStatusDef')
			USE IN poStatusDef
		ENDIF
		
		IF USED("tmpStockLst_Master")
			USE IN tmpStockLst_Master
		ENDIF
		*Private Data
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
	ENDPROC

	PROCEDURE updatepoitemrecdt
		PARAMETERS dReceived, cPOitem, nPOcomplete 
		*ThisForm.UpdatePOitemRecDt(dReceived,cPOitem,nPOcomplete )
		
		IF ( VARTYPE(dReceived) = "D" OR VARTYPE(dReceived) = "T" )
			*good
		ELSE
			RETURN .F.
		ENDIF
		
		IF VARTYPE(cPOitem) != "C"
			RETURN .F.
		ENDIF
		
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item("0-00")
			RETURN .F.
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC, lSaved 
		lSaved = .T.
		
		cSQLu = "IF EXISTS (SELECT * FROM dbo.PurchaseOrder "
		cSQLu = cSQLu +" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"	
		cSQLu = cSQLu +" AND Received IS NULL) "
		
		cSQLu = cSQLu +" UPDATE dbo.PurchaseOrder SET"
		cSQLu = cSQLu +" Received = '"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"	
		cSQLu = cSQLu +" WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"') ;"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
			lSaved = .F.
			*RETURN
			RecordError(0,"Could not update dbo.PurchaseOrder " ,PROGRAM(),LINENO(1), "SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
		ELSE 
			lSaved = .T.
		ENDIF
		
		
		
		*************************
		IF lSaved 
			PRIVATE cNotes, nReceivingID 
			cNotes = "POitem '"+cPOitem+"' was Received on '"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
			nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
			IF nReceivingID > 0
				cNotes = cNotes + " with ReceivingID = "+ALLTRIM(STR(nReceivingID))
			ENDIF
			IF nPOcomplete = 2
				cNotes = cNotes + " and Delivered in Complete"
			ENDIF
			cSQL = "INSERT INTO dbo.PO_Item_Notes "
			cSQL = cSQL +" ([POitem],[Notes]) VALUES ("
			cSQL = cSQL +"'"+cPOitem+"','"+PrepareSQLtxt(cNotes,'Notes',-1)+"') ;"
		
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not Insert into dbo.PO_ProcessNotes " ,PROGRAM(),LINENO(1), "SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQL )
			ELSE 
				lSaved = .T.
			ENDIF
		ENDIF
		
		**************************************
		
		RETURN lSaved 
	ENDPROC

	PROCEDURE updatepurchaseorder
	ENDPROC

	PROCEDURE updatewo_detailrecdt
		PARAMETERS dReceived, nWO_Detail, nPOcomplete 
		*ThisForm.UpdateWO_DetailRecDt(dReceived, nWO_Detail, nPOcomplete)
		
		IF ( VARTYPE(dReceived) = "D" OR VARTYPE(dReceived) = "T" )
			*good
		ELSE
			RETURN .F.
		ENDIF
		
		nWO_Detail = PrepareSQLnum(nWO_Detail,'WO_Detail',-3)
		IF nWO_Detail = 0
			RETURN .F.
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC, lSaved 
		lSaved = .T.
		
		cSQLu = "IF EXISTS (SELECT * FROM dbo.WorkOrder_Detail  "
		cSQLu = cSQLu +" WHERE WO_Detail = "+STR(nWO_Detail)
		cSQLu = cSQLu +" AND ISNULL(fReconciled ,0) = 0 ) "
		
		cSQLu = cSQLu +" UPDATE dbo.WorkOrder_Detail SET"
		cSQLu = cSQLu +" [fFinishDate] = '"+IIF(EMPTY(dReceived),DTOC(DATE()),DTOC(dReceived))+"'"	
		IF PrepareSQLnum(nPOcomplete,'complete',-1) = 2 
			cSQLu = cSQLu +" ,fCmplt = 1 "
		ENDIF
		cSQLu = cSQLu +" WHERE WO_Detail = "+STR(nWO_Detail)
		cSQLu = cSQLu +" ;"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
			lSaved = .F.
			*RETURN
			RecordError(0,"Could not update dbo.PurchaseOrder " ,PROGRAM(),LINENO(1), "SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
		ELSE 
			lSaved = .T.
		ENDIF
		
		
		*************************
		IF lSaved 
			PRIVATE cNotes, nReceivingID 
			cNotes = "WO_Detail "+STR(nWO_Detail)+" was Received on '"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
			nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
			ThisForm.nReceivingID = nReceivingID
			
			IF nReceivingID > 0
				cNotes = cNotes + " with ReceivingID = "+ALLTRIM(STR(nReceivingID))
			ENDIF
			IF nPOcomplete = 1
				cNotes = cNotes + " and WO_Detail NOT Complete"
			ENDIF
			IF nPOcomplete = 2
				cNotes = cNotes + " and WO_Detail is Complete"
			ENDIF
			cSQL = "INSERT INTO dbo.WorkOrder_Notes "
			cSQL = cSQL +" ([WO_Detail],[Notes]) VALUES ("
			cSQL = cSQL +""+STR(nWO_Detail)+",'"+PrepareSQLtxt(cNotes,'Notes',-1)+"') ;"
		
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not Insert into dbo.PO_ProcessNotes " ,PROGRAM(),LINENO(1), "SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQL )
			ELSE 
				lSaved = .T.
			ENDIF
		ENDIF
		
		**************************************
		
		RETURN lSaved 
	ENDPROC

	PROCEDURE update_postatus
		PARAMETERS lCmplt_the_Prc
		*ThisForm.Update_POStatus()
		
		IF VARTYPE(lCmplt_the_Prc) <> "L"
			lCmplt_the_Prc = .T.
		ENDIF
		PRIVATE nReceivingID, nWO_Detail
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		*Check POStatus
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpPOStat')	
			USE IN tmpPOStat
		ENDIF
		
		cSQL = 		  " SELECT M.POStatus, 'S' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.StockLst_Master M  WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
		IF nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'B' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
		IF nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'W' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
		IF nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID)
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOStat')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOStat')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOStat")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOStat")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOStat')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		
		PRIVATE lDueIn, lPartialReceive, lWaitingforBill, lAccountedfor
		lDueIn = .F.
		lPartialReceive = .F.
		lWaitingforBill = .F.
		lAccountedfor = .F.
		
		PRIVATE nMess,  nReceivingID2, cPOStatusText
		nMess = 0
		
		nReceivingID2 = 0
		cPOStatusText = ''
		
		***************************************
		
		IF USED('tmpPOStat')	
			IF RECCOUNT('tmpPOStat') > 0
			
				DO CASE
				CASE tmpPOStat.TBL = 'S'
					Thisform.cTBL = "S"
				CASE tmpPOStat.TBL = 'B'
					Thisform.cTBL = "B"
				CASE tmpPOStat.TBL = 'W'
					Thisform.cTBL = "W"
				OTHERWISE
					TrackError(cSQL,"Could not find TBL.",PROGRAM(),LINENO(1) )
					Thisform.cTBL = "N"
				ENDCASE
				
				SCAN
					
					cPOStatus	= PrepareSQLtxt(tmpPOstat.POStatus,'POStatus',1)
					
					DO CASE
					CASE cPOStatus = "D"	
						cPOStatusText = "DUE IN" && INCOMING
						lDueIn = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "P"	
						cPOStatusText = "Partial Receive" && "PARTRECV"
						lPartialReceive = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "W"	
						cPOStatusText = "Waiting for Bill"
						lWaitingforBill = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "A"	
						cPOStatusText = "Accounted for"
						lAccountedfor = .T.
						nReceivingID2 = PrepareSQLnum(tmpPOstat.ReceivingID,'ReceivingID',-3)
						EXIT
					ENDCASE
				ENDSCAN
			ENDIF
		ENDIF
				
		IF nReceivingID2 > 0
			IF nReceivingID <> nReceivingID2
				nReceivingID2 = nReceivingID2 
				*TrackMess("The POitem: '"+ThisForm.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID))+"."+CHR(13)+cSQL)
				IF nWO_Detail > 0
					TrackError("The WO Detail: '"+STR(nWO_Detail)+"' has a ReceivingID of "+ALLTRIM(STR(nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL ,"Found nReceivingID2",PROGRAM(),LINENO(1))
				ELSE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem: '"+ThisForm.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL )
				ENDIF
			ENDIF
		ENDIF
		
		**********************
		PRIVATE cSOitem
		cSOitem 	= Proper_SO_Item( ThisForm.cSOitem )
		
		**********************
		*Mark Master as POStatus='P'	&&Partial
		*
		**********************
		*Never Mark as Partial again!!! 3/11/2019
		*Complete the Receive ' lClearIncomingProcess '
		* and Create a new INCOMING Master, Detail, Process! ???
		*
		
		PRIVATE nMess
		nMess = 0
		PRIVATE lClearIncomingProcess
		lClearIncomingProcess = .F.
		
		IF lAccountedfor 
			*Do Nothing
			*cPOStatusText = "Accounted for"
			IF NOT lCmplt_the_Prc
				TrackMess("Did NOT Updated Stock:"+Thisform.cTBL+" POStatusText = 'Accounted for' Receiving ID "+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
			ENDIF
			lClearIncomingProcess = .F.
		ELSE
			IF lWaitingforBill 
				*Do Nothing
				*cPOStatusText = "Waiting for Bill"
				IF NOT lCmplt_the_Prc
					TrackMess("Did NOT Updated Stock:"+Thisform.cTBL+" POStatusText = 'Waiting for Bill' Receiving ID "+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
				ENDIF
		
				lClearIncomingProcess = .F.
			ELSE
				IF NOT lCmplt_the_Prc
					*User selected Good recieve, Not Complete
					nMess = 6
				ELSE
					*User Selected 'Just Editing' or Completes POitem
					IF lDueIn 
						IF nWO_Detail > 0
							nMess = MESSAGEBOX("This WO Detail:"+STR(nWO_Detail)+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"WO Detail status will be listed as Complete.")
						ELSE
							nMess = MESSAGEBOX("This PO_Item:"+ThisForm.cPOitem+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"PO status will be listed as Complete.")
						ENDIF
					ELSE
						IF lPartialReceive 
							IF nWO_Detail > 0
								nMess = MESSAGEBOX("This WO Detail:"+STR(nWO_Detail)+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"WO Detail status will be listed as Complete.")
							ELSE
								nMess = MESSAGEBOX("This PO_Item:"+ThisForm.cPOitem+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"PO status will be listed as Complete.")
							ENDIF			
						ENDIF
					ENDIF
				ENDIF
						
				IF nMess = 6
					lClearIncomingProcess = .T.
					cSQL = ""
					DO CASE
					CASE Thisform.cTBL = "S"
						cSQL = " UPDATE dbo.StockLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE Thisform.cTBL = "B"
						cSQL = " UPDATE dbo.BrokerLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE Thisform.cTBL = "W"
						cSQL = " UPDATE dbo.WIPLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE Thisform.cTBL = "N"
						*
					OTHERWISE 
						Thisform.cTBL = "N"
					ENDCASE
					
					IF Thisform.cTBL = "N"
						*No TBL
					ELSE
						IF nWO_Detail > 0
							cSQL = cSQL + " WHERE M.WO_Detail = "+STR(nWO_Detail)
						ELSE
							cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
						ENDIF
						IF nReceivingID2 > 0
							cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID2)
						ENDIF
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 				
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
						ELSE 
							TrackMess("Updated Stock:"+Thisform.cTBL+" POStatusText set to W 'Waiting for Bill', Receiving ID "+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
							*MESSAGEBOX(cSQL,0,"Success")
						ENDIF
					ENDIF		
		
				ELSE
					IF NOT lCmplt_the_Prc
						TrackMess("Did NOT Updated Stock:"+Thisform.cTBL+" User choose to not Complete. Receiving ID "+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		RETURN lClearIncomingProcess
	ENDPROC

	PROCEDURE update_rma
	ENDPROC

	PROCEDURE validate_rma
		*ThisForm.Validate_RMA
		*Called from: txtRMA_No.Valid
		PRIVATE nRMA_Detail, nRMA, cHeat, cLot
		nRMA_Detail= PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
		nRMA 	= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		cLot	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		
		
		PRIVATE cSOitem, nSalesNum, nItemSo
		nSalesNum	= PrepareSQLnum(ThisForm.txtSOnum.Value,'SalesNum',-3)
		nItemSo 	= PrepareSQLnum(ThisForm.txtSOitem.Value,'SOitem',2,0)
		cSOitem		= Proper_SO_item('')
		
		IF nSalesNum > 0 
			IF nItemSo > 0
				cSOitem = Proper_SO_item( STR(nSalesNum)+"-"+STR(nItemSo,2,0) )
			ENDIF
		ENDIF
		
		IF nRMA = 0
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				*No SOitem to compare with
				RETURN .T.
			ELSE
				
			ENDIF
		ENDIF
				
		PRIVATE cSQL, nSQLExec
		IF USED("tmpRMA_V")
			USE IN tmpRMA_V
		ENDIF
		
		PRIVATE cMess
		
		cSQL = "SELECT RD.SO_item "
		cSQL = cSQL + ",RMA.RMA_No, RD.RMA_Detail_ID"
		cSQL = cSQL + " FROM dbo.RMA WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.RMA_Detail RD WITH(NOLOCK) ON RMA.RMA_No = RD.RMA_NO "
		
		cSQL = cSQL + " WHERE RMA.RMA_No = "+STR(nRMA)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMA_V')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_V' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_V")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_V")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA_V' )
		ENDIF
		
		IF NOT USED('tmpRMA_V') OR RECCOUNT('tmpRMA_V') = 0	
			*try without HEAT
			cSQL = "SELECT RD.SO_item "
			cSQL = cSQL + ",RMA.RMA_No, RD.RMA_Detail_ID"
			cSQL = cSQL + " FROM dbo.RMA WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.RMA_Detail RD WITH(NOLOCK) ON RMA.RMA_No = RD.RMA_NO "
		
			cSQL = cSQL + " WHERE RMA.RMA_No = "+STR(nRMA)
					
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRMA_V')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_V' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_V")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_V")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA_V' )
			ENDIF
		
		ENDIF	
		
		PRIVATE lFound 
		lFound = .F.
		
		IF USED('tmpRMA_V')
			IF RECCOUNT('tmpRMA_V') > 0
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
					SELECT tmpRMA_V
					LOCATE FOR SO_item = cSOitem
					IF FOUND('tmpRMA_V')
						lFound = .T.
					ELSE
						MESSAGEBOX("This RMA does not match the SOitem!"+CHR(13)+"Current SOitem:"+cSOitem+CHR(13)+"RMA SOitem ="+Proper_SO_item(tmpRMA_V.SO_item),16,"Does not Match")
						GO TOP			
					ENDIF
				ELSE
					*No SOitem to Compare
				ENDIF
			ENDIF
			
			USE IN tmpRMA_V		
		ENDIF
		
		IF nRMA_Detail = 0
			*TRY TO get Detail
			IF Thisform.CheckRMA()
		*		ThisForm.Get_RMA_Detail()
		*		*CALLS:ThisForm.Refresh_RMA_Detail()
			ENDIF
		ENDIF
			
		RETURN .T.
		
	ENDPROC

	PROCEDURE Check2.InteractiveChange
		PRIVATE lServicesPO, cForm, nPU, lConvServ, lEquipment, lIntP
		lServicesPO = PrepareSQLlogic( This.Value, 'ServicesPO',.F. )
		cForm = ShowSQLtxt(This.parent.cmbForm.Value,'Form',2)
		nPU = 0
		lConvServ = PrepareSQLlogic(This.parent.chkConvServ.Value,'ConvServ',.F.)
		lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
		lIntP	= PrepareSQLlogic(This.parent.chkIntP.Value,'IntP',.F.)
		
		This.parent.lblPerUnit.Caption	= FormUnitCaption(cForm,lServicesPO,lConvServ,lEquipment,ThisForm.nConnHandle)
		*This.parent.lblPerUnit.Caption	= PriceUnitCaption(cForm,nPU,lServicesPO,lConvServ,lEquipment,lIntP,ThisForm.nConnHandle)
		
		IF This.parent.lblPerUnit.Caption = "$ Lot" OR This.parent.lblPerUnit.Caption = "$Lot"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to 1 for 1 LOT" NOWAIT
		ENDIF
		IF This.parent.lblPerUnit.Caption = "$/PC"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to number of Pieces" NOWAIT
		ENDIF
		
		IF lServicesPO 
			MESSAGEBOX("This POitem will not use the Alloy, Form or Sizes."+CHR(13)+"Please remember to describe this Item in the Description field.",0,"Equipment")
		ENDIF
	ENDPROC

	PROCEDURE Check2.Valid
		*PurchaseOrder.Services or LabServices
		PRIVATE lServicesPO,lConvServ,lEquipment
		lConvServ  = PrepareSQLlogic(This.parent.chkConvServ.Value, 'ConvServ',.F. )
		lServicesPO = PrepareSQLlogic(This.Value,'ServicesPO',.F.)
		lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
		
		************************
		IF lServicesPO AND lConvServ
			MESSAGEBOX("This PO item is listed for a Lab Sevices"+CHR(13)+"most likeley for a test report."+CHR(13)+CHR(13)+"This PO item is also listed as Conversion Service"+CHR(13)+"A Converion Service is where HPA Cuts, Forges or Changes the cusromers material."+CHR(13)+CHR(13)+"Both at the same time is not alowed!",48,"Cannot save this")
			This.Value = !This.Value
			RETURN .F.
		ENDIF
		
		IF lServicesPO AND lEquipment 
			MESSAGEBOX("This PO item is listed for a Lab Sevices"+CHR(13)+"most likeley for a test report."+CHR(13)+CHR(13)+"This PO item is also listed as Equipement"+CHR(13)+"Equipement is PO to bring in supplies or machines that are not to be stocked or sold."+CHR(13)+CHR(13)+"Both at the same time is not alowed!",48,"Cannot save this")
			This.Value = !This.Value
			RETURN .F.
		ENDIF
		
		****
		IF lServicesPO 
			PRIVATE nOrder_PU, nOrder_P, nOrder_Qty
			nOrder_PU 	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.cmbOrder_PU.VALUE,'Order_PU',-1)
			nOrder_P	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.VALUE,'Order_P',-5)
			nOrder_Qty	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_Qty.VALUE,'Order_Qty',-5)
			IF nOrder_P = 0 OR nOrder_Qty = 0
				IF nOrder_PU <> 3
					*SET to Lot
					ThisForm.pgfPO.pgPODesc.cmbOrder_PU.Value = 3
				ENDIF
			ENDIF
			
			****
			PRIVATE	nHpaPo, nItemPo, cPoItem
			nHpaPo	= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtHPApo.VALUE,'ERP PO',-3,0)
			nItemPo	= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtItempo.VALUE,'Item PO',2,0)
			cPOItem = Proper_PO_item( STR(nHPApo)+"-"+STR(nItemPo,2,0) )
			
			IF cPOItem <> Proper_PO_item('')
				PRIVATE cSQLu
				cSQLu = "UPDATE dbo.PurchaseOrder SET "
				cSQLu = cSQLu + " Services ="+IIF(lServicesPO,'1','0')
				cSQLu = cSQLu + " WHERE PoItem = '"+cPOItem+"'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
				*	lPOSaveOK  = .F.
				ELSE
				ENDIF
				
				*After PO is updates, Check PU:
				ThisForm.Refresh_PU()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Check3.InteractiveChange
		
		PRIVATE lServicesPO,lConvServ,lEquipment
		lConvServ  = PrepareSQLlogic( This.Value, 'ConvServ',.F. )
		PRIVATE cForm
		cForm = ShowSQLtxt(This.parent.cmbForm.Value,'Form',2)
		lServicesPO = PrepareSQLlogic(This.parent.chkLab_Service.Value,'ServicesPO',.F.)
		lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
		
		This.parent.lblPerUnit.Caption	= FormUnitCaption(cForm,lServicesPO,lConvServ,lEquipment,ThisForm.nConnHandle)
		
		IF This.parent.lblPerUnit.Caption = "$ Lot" OR This.parent.lblPerUnit.Caption = "$Lot"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to 1 for 1 LOT" NOWAIT
		ENDIF
		IF This.parent.lblPerUnit.Caption = "$/PC"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to number of Pieces" NOWAIT
		ENDIF
		
		
		**********************
		
		PRIVATE nHpaPo, nItemPo, cPoItem
		nHpaPo	= PrepareSQLnum(This.parent.txtHPApo.VALUE,'ERP PO',-3,0)
		nItemPo	= PrepareSQLnum(This.parent.txtItempo.VALUE,'Item PO',2,0)
		cPOItem = Proper_PO_item( STR(nHPApo)+"-"+STR(nItemPo,2,0) )
		
		PRIVATE nPieces
		nPieces = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
		IF nPieces = 0
			ThisForm.pgfPO.pgPODesc.txtPieces.Value = 1
		ENDIF
		
		***
		IF lConvServ 
			IF cPOItem <> Proper_PO_item('')
				PRIVATE cSQLu
				cSQLu = "UPDATE dbo.PurchaseOrder SET "
				cSQLu = cSQLu + " ConvServ="+IIF(lConvServ,'1','0')
				cSQLu = cSQLu + " WHERE PoItem = '"+cPOItem+"'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
				*	lPOSaveOK  = .F.
				ELSE
				ENDIF
				
				*After PO is updates, Check PU:
				ThisForm.Refresh_PU()
			ENDIF
		ENDIF
		
		PRIVATE nWO, nWO_Detail
		IF lConvServ 
			nWO = PrepareSQLnum(This.Parent.lblWOnum.Caption,'WO',-3)
			nWO_Detail = PrepareSQLnum(This.Parent.lblWO_Dnum.Caption,'WO_Detail',-3)
			IF nWO_Detail = 0
				nWO_Detail = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtWO_Detail.Value,'WO_Detail',-3)
			ENDIF	
			IF nWO = 0 AND nWO_Detail = 0
				*See if WO was Entered
				nWO = get_WO_from_POitem(cPOItem, ThisForm.nConnhandle )
				IF nWO > 0
					This.Parent.lblWOnum.Caption = STR(nWO)
					
				ELSE
					MESSAGEBOX("Please enter a WO when doing an Conversion Service"+CHR(13)+"HPA will be able to better track Inventory movement and cost.",0,"WO is Empty")
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Check3.Valid
