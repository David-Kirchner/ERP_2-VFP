	PROCEDURE Init
		PARAMETER pAlloy
		
		IF TYPE("pAlloy") = "C"
		
			SELECT Alloy
			LOCATE FOR Alloy = pAlloy
		
		ENDIF
		
		
		ThisForm.grdSql_alloy.RecordSource = "Alloy"
		*ThisForm.grdSql_alloy.clmAlloy.Text1.ReadOnly = .T.
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		ThisForm.ConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.ConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		
		ThisForm.LoadAlloy()
		*ThisForm.LoadAlloys()
		
		SELECT Alloy
		
	ENDPROC

	PROCEDURE loadalloy
		PRIVATE cSQL, nSQLEXEC
		*ThisForm.LoadAlloy()
		
		*cSQL = "SELECT * FROM dbo.Alloy ORDER BY Alloy "
		*cSQL = "SELECT Alloy,ISNULL(Density,0),INV,ISNULL(Co,0),ISNULL(Cu,0),ISNULL(Cr,0),ISNULL(Ni,0),ISNULL(Mo,0),ISNULL(Fe,0),ISNULL(Ti,0),ISNULL(UNS,' ') FROM dbo.Alloy ORDER BY Alloy "
		cSQL = "SELECT Alloy, ISNULL(Density,0) AS Density, ISNULL(Inventory,' ') AS Inventory"
		cSQL = cSQL +", ISNULL(Co,0) AS Co, ISNULL(Cr,0) AS Cr, ISNULL(Cu,0) AS Cu, ISNULL(Fe,0) AS Fe"
		cSQL = cSQL +", ISNULL(Mo,0) AS Mo, ISNULL(Mn,0) AS Mn, ISNULL(Nb,0) AS Nb"
		cSQL = cSQL +", ISNULL(Ni,0) AS Ni, ISNULL(Ti,0) AS Ti, ISNULL(V,0) AS V, ISNULL(W,0) AS W"
		cSQL = cSQL +", ISNULL(UNS,' ') AS UNS"
		cSQL = cSQL +", ISNULL(BrandName,' ') AS BrandName, ISNULL(UName,' ') AS UName FROM dbo.Alloy ORDER BY Alloy"
		
		IF USED("Alloy")
			SELECT Alloy
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'Alloy')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'Alloy')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Alloy")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Alloy")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'Alloy')
		ENDIF
		
		
		IF USED("Alloy")
			SELECT Alloy
			INDEX ON UPPER(Alloy) TAG UppAlloy
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.ConnHandle )
	ENDPROC

