	PROCEDURE grdSql_alloy.clmInv.Text1.Valid
		IF This.Value = "Y" OR This.Value = "T" OR ISNULL(This.Value)
			IF This.Value = "T"
				This.Value = "Y"
			ENDIF
		ELSE
			This.Value = .NULL.
		ENDIF
	ENDPROC

ENDDEFINE
