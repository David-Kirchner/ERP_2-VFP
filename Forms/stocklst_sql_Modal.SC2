	PROCEDURE Init
		PARAMETER pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pPassedNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem
		*Use Browse if you are not looking for a Selection.  Modal waits for Answer
		*Repeat edit in StockLst_SQLBrowse form. Init paramters need to be the same
		
		*DO FORM Forms\StockLst_SQL_Modal WITH "SELECT",'S',"6B","10","1",'',1,0,0,"1234567-01",1234567,1,10,'',0.0,.F.,''
		*DO FORM Forms\StockLst_SQL_Modal WITH "GET",'S'
		*DO FORM Forms\StockLst_SQL_Modal WITH "GET",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,'' TO nID_Deatil
		
		*pPassedNum can be ID_Detail on pFunction="Browse_ID_Detail" or WO on pFunction="BrowseWIP'
		
		**************************************************************************
		*This Form lives as a Window in Shop_StockLst_Edit - Repeat edit there.
		*Modal means this screen keep atention till closed.
		
		*This Screen uses CLASS stocklst_sql OF "c:\program files (x86)\hpa\libs\stocklst_sql.vcx"
		* FORM "c:\program files (x86)\hpa\forms\stocklst_sql_quotes.scx" is OLD
		**************************************************************************
		
		PRIVATE nBestItem, cAlloy, cHeatLot
		PRIVATE cText,lRandLen, lMetric
		
		
		IF PrepareSQLnum(pPassedNum,'SalesNum',-3) = 0
			ThisFormSet.Stocklst_SQL.cInqNumP = PrepareSQLtxt(pSOitem,'InqNumP',9)
			pSOitem = ''
		ENDIF
		
		ThisFormSet.StockLst_SQL.INIT_pWhat(pFunction)
		
		********************
		** repeate Changes here in GetSO()
		********************
		
		IF TYPE('pAlloy') = "C"
			ThisFormSet.Stocklst_SQL.pAlloy = pAlloy
			ThisFormSet.Stocklst_SQL.txtAlloy.Value = ThisFormSet.Stocklst_SQL.pAlloy
		ELSE
			ThisFormSet.Stocklst_SQL.pAlloy = ""
			ThisFormSet.Stocklst_SQL.txtAlloy.Value = "HPA N60"
		ENDIF
		*************
		IF TYPE('pForm') = "C"
			ThisFormSet.Stocklst_SQL.pForm = pForm
		ELSE
			ThisFormSet.Stocklst_SQL.pForm = ""
		ENDIF
		*************
		PRIVATE cCC
		IF PrepareSQLtxt(pCC,'CC',1) = "R"
			pCC = "1"  &&Replace "R" with CC=1
		ENDIF
		
		IF TYPE('pCC') = "C"
			ThisFormSet.Stocklst_SQL.pCC = pCC
			cCC = pCC
			ThisFormSet.Stocklst_SQL.cmbCC.Value = cCC
		ELSE
			IF TYPE('pCC') = "N"
				ThisFormSet.Stocklst_SQL.pCC = STR(pCC)
				cCC = STR(pCC)
				ThisFormSet.Stocklst_SQL.cmbCC.Value = cCC
			ELSE
				ThisFormSet.Stocklst_SQL.pCC = "1"
				cCC = "1"
				ThisFormSet.Stocklst_SQL.cmbCC.Value = cCC
			ENDIF
		ENDIF
		*************
		PRIVATE cCL
		IF TYPE('pCL') = "C"
			ThisFormSet.Stocklst_SQL.pCL = pCL
			cCL = pCL
			ThisFormSet.Stocklst_SQL.cmbCC.Value = cCC
		ELSE
			IF TYPE('pCL') = "N"
				ThisFormSet.Stocklst_SQL.pCL = STR(pCL)
				cCL = STR(pCL)
				ThisFormSet.Stocklst_SQL.cmbCL.Value = cCL
			ELSE
				ThisFormSet.Stocklst_SQL.pCL = ""
				cCL = ""
				ThisFormSet.Stocklst_SQL.cmbCL.Value = cCL
			ENDIF
		ENDIF
		*************
		ThisFormSet.Stocklst_SQL.lblSz1.Visible = .F.
		ThisFormSet.Stocklst_SQL.lblSz1.Caption = ""
		IF VARTYPE(pPC) = "N"
			ThisFormSet.Stocklst_SQL.pPieces = pPc
		ELSE
			pPC = 0
		ENDIF
		*************
		IF TYPE('pThck') = "N"
			ThisFormSet.Stocklst_SQL.pThck = pThck
			IF pThck > 0
				ThisFormSet.Stocklst_SQL.lblSz1.Caption = ALLTRIM(Remove0(pThck,10,4))+'"'
				ThisFormSet.Stocklst_SQL.lblSz1.Visible = .T.
			ENDIF
		ELSE
			ThisFormSet.Stocklst_SQL.pThck = 0
		ENDIF
		*************
		IF TYPE('pSz2') = "N"
			IF pSz2 > 0
				ThisFormSet.Stocklst_SQL.lblSz1.Caption = ThisFormSet.Stocklst_SQL.lblSz1.Caption + " X "+ALLTRIM(Remove0(pSz2,9,3))+'"'
			ENDIF
		ENDIF
		*************
		IF TYPE('pSz3') = "N"
			IF pSz3 > 0
				ThisFormSet.Stocklst_SQL.lblSz1.Caption = ThisFormSet.Stocklst_SQL.lblSz1.Caption + " X "+ALLTRIM(remove0(pSz3,9,3))+'"'
			ENDIF
		ENDIF
		
		*************
		pLBS = PrepareSQLnum(pLBS,'LBS',7,1)
		ThisFormSet.Stocklst_SQL.pWeight = pLBS
		*************
		IF TYPE('pQTY') = "N" OR TYPE('pQTY') = "Y"
			pQTY	= PrepareSQLnum(pQTY,'QTY',-5)
			ThisFormSet.Stocklst_SQL.pQTY = pQTY
		ELSE
			ThisFormSet.Stocklst_SQL.pQTY = 0
		ENDIF
		*************
		IF VARTYPE(pRL) = "L"
			lRandLen = pRL
		ELSE
			lRandLen = .F.
		ENDIF
		ThisFormSet.Stocklst_SQL.pRandLen = lRandLen 
		*************
		
		lMetric = .F.
		IF TYPE('pForm') = "C" AND TYPE('pThck') = "N" AND TYPE('pSz2') = "N" AND TYPE('pSz3') = "N"
			*Overwrite with ItemDescriptionMetric ThisFormSet.Stocklst_SQL.pThck
			ThisFormSet.Stocklst_SQL.ShowAlloyFormCC(pSz2, pSz3)
		ENDIF
		
		*************
		PRIVATE cTBL
		IF TYPE('pTBL') = "C"
			cTBL = pTBL
		ELSE
			cTBL = ''
		ENDIF
		IF VARTYPE(pTBL) != 'C'
			IF ThisFormSet.Stocklst_SQL.pFunction= "BROWSE"
				cTBL = 'S'
			ENDIF
		ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			MESSAGEBOX("frmStockLst_SQL_Quotes.Init did not recognize Table Name",0+16,"Bad Initialization!")
			TrackError("frmStockLst_SQL_Quotes.Init did not recognize Table Name","frmStockLst_SQL_Quotes.Init not recognize Table Name '"+CHR(13)+ThisFormSet.Stocklst_SQL.pFunction+" "+cText+CHR(13)+cTBL+"'.","frmShop_StockLst_Edit.Init",LINENO(1))
		*	RETURN .F.
		ENDIF
		
		ThisFormSet.Stocklst_SQL.cTBL = cTBL
		
		*****
		ThisFormSet.Stocklst_SQL.Load_StockLst_SQL(ThisFormSet.Stocklst_SQL.cTBL)
		
		
		*********************
		IF VARTYPE(pSOItem) = "C"
			IF Proper_SO_item(pSOitem) = Proper_SO_item('')
				*empty
				ThisFormSet.Stocklst_SQL.pSOitem = Proper_SO_item('')
				ThisFormSet.Stocklst_SQL.txtSOItem.VALUE = ''
			ELSE
				ThisFormSet.Stocklst_SQL.txtSOItem.VALUE = pSOItem 
				ThisFormSet.Stocklst_SQL.pSOitem = pSOItem		
				ThisFormSet.Stocklst_SQL.pSalesNum = VAL( LEFT(ThisFormSet.Stocklst_SQL.pSOItem,7) )
			ENDIF
		ELSE
			ThisFormSet.Stocklst_SQL.txtSOItem.VALUE = "No SO Item"
			ThisFormSet.Stocklst_SQL.pSOItem = ""
			IF ThisFormSet.Stocklst_SQL.cmdMark.Caption = "Select this Record"
				ThisFormSet.Stocklst_SQL.cmdMark.Enabled=.T.
			ELSE
				ThisFormSet.Stocklst_SQL.cmdMark.Enabled=.F.
			ENDIF
		ENDIF
		
		*********************
		IF VARTYPE(pPassedNum) = "N"
			*pPassedNum can be ID_Detail on pFunction="Browse_ID_Detail"
			IF pFunction="Browse_ID_Detail"
				*pPassedNum is holding the ID_Detail
				ThisFormSet.StockLst_SQL.pID_Detail	= pPassedNum
				ThisFormSet.Stocklst_SQL.pSalesNum = 0
			ELSE
				ThisFormSet.Stocklst_SQL.pSalesNum = pPassedNum
			ENDIF
			
		ELSE	&&Already Done in pSOitem Check
			ThisFormSet.Stocklst_SQL.pSalesNum = 0
		ENDIF
		
		*********************
		*IF VARTYPE(pPOitem) != "C"
		*	ThisFormSet.Stocklst_SQL.pPOitem = ''
		*ELSE
			ThisFormSet.Stocklst_SQL.pPOitem = PrepareSQLtxt(pPOitem,'PO_item',12)
		*ENDIF
		
		*IF Proper_SO_item(ThisFormSet.Stocklst_SQL.pSOItem) = Proper_SO_item('') AND ThisFormSet.Stocklst_SQL.pSalesNum = 0
		
		
		*********************
		IF VARTYPE(pHeatLot) = "C"
			cHeatLot = pHeatLot
		ELSE
			cHeatLot = ''
		ENDIF
		
		*********************
		PRIVATE lFoundStock
		lFoundStock = .F.
		
		PRIVATE nID_Detail
		nID_Detail = 0
		
		
		*********************
		DO CASE
		CASE ThisFormSet.Stocklst_SQL.pFunction = "SEL_WO"
		
			ThisFormSet.Stocklst_SQL.nWO = PrepareSQLnum(pPassedNum,'WO',10)
			ThisFormSet.Stocklst_SQL.pSalesNum = VAL( PrepareSQLtxt(pSOItem,'SOitem',10) )
			*pSalesNum = ThisFormSet.Stocklst_SQL.pSalesNum
			ThisFormSet.Stocklst_SQL.pSOItem = pSOitem
			
			IF ThisFormSet.Stocklst_SQL.nWO > 0
				ThisFormSet.Stocklst_SQL.pShipDue = getWO_Detail_DueDate( ThisFormSet.Stocklst_SQL.nWO, ThisFormSet.Stocklst_SQL.nConnhandle )
			ELSE
				ThisFormSet.Stocklst_SQL.pShipDue = CTOD("  /  /  ")
			ENDIF
			
		CASE ThisFormSet.Stocklst_SQL.pFunction = "BROWSE_WIP"
			ThisFormSet.StockLst_SQL.cmdMark.Enabled = .F.
			ThisFormSet.Stocklst_SQL.nWO = PrepareSQLnum(pPassedNum,'WO',10)
			
			IF ThisFormSet.Stocklst_SQL.nWO > 0
				ThisFormSet.Stocklst_SQL.pShipDue = getWO_Detail_DueDate( ThisFormSet.Stocklst_SQL.nWO, ThisFormSet.Stocklst_SQL.nConnhandle )
			ELSE
				ThisFormSet.Stocklst_SQL.pShipDue = CTOD("  /  /  ")
			ENDIF
		
		CASE ThisFormSet.Stocklst_SQL.pFunction = "BROWSELot"
			ThisFormSet.StockLst_SQL.cmdMark.Enabled = .F.
			IF ThisFormSet.Stocklst_SQL.SearchHeatLot(cHeatLot)
				lFoundStock = .T.
			ENDIF
		
		CASE ThisFormSet.Stocklst_SQL.pFunction = "BROWSE_ID_Detail"
			*ThisFormSet.Stocklst_SQL.pFunction = "BROWSE_ID_Detail" AND ThisFormSet.Stocklst_SQL.pID_Detail = pPassedNum		
			
			ThisFormSet.StockLst_SQL.cmdMark.Enabled = .F.
			IF cTBL = 'S' OR cTBL = 'B' OR cTBL = 'W'
				nID_Detail	= PrepareSQLnum(pPassedNum,'ID_Detail',-3)
				IF nID_Detail > 0
					IF ThisFormSet.Stocklst_SQL.GoToID_Detail(nID_Detail, pSz2, pSz3)
						lFoundStock = .T.
					ENDIF
				ELSE
					TrackError("No ID_Detail for TBL"+CHR(13)+ShowSQLtxt(cTBL,'TBL',1)+CHR(13)+"Function = BROWSE_ID_Detail","No ID_Detail", PROGRAM(), LINENO(1))
				ENDIF
			ELSE
				TrackError("No TBL info"+CHR(13)+ShowSQLtxt(cTBL,'TBL',1)+CHR(13)+"Function = BROWSE_ID_Detail","Unknown TBL", PROGRAM(), LINENO(1))
			ENDIF
		
		CASE ThisFormSet.Stocklst_SQL.pFunction = "SEL_WO"
			IF ThisFormSet.Stocklst_SQL.nWO > 0
				*Look for an ID_Detail by WO
				nID_Detail = ThisFormSet.Stocklst_SQL.getBy_WO(ThisFormSet.Stocklst_SQL.nWO)
				IF nID_Detail > 0
					lFoundStock = .T.
				ENDIF
			ENDIF
			
		OTHERWISE 
			ThisFormSet.Stocklst_SQL.nWO = 0
			ThisFormSet.Stocklst_SQL.pShipDue = CTOD("  /  /  ")
		ENDCASE
		
		
		
		*****************************
		IF NOT lFoundStock
			IF !EMPTY(cHeatLot) 
				IF UPPER(cHeatLot) != "DUE IN"
					IF !EMPTY(ThisFormSet.Stocklst_SQL.pAlloy)
						IF !EMPTY(cCC)
							ThisFormSet.Stocklst_SQL.Search(cHeatLot)
							*lFoundStock
						ELSE
							ThisFormSet.Stocklst_SQL.SearchHeatLot(cHeatLot)
							*lFoundStock
						ENDIF
					ELSE
						ThisFormSet.Stocklst_SQL.SearchHeatLot(cHeatLot)
						*lFoundStock
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		IF NOT lFoundStock
			ThisFormSet.Stocklst_SQL.Search('HARD')
		ENDIF
		
		*****************************************************
		*****************************************************
		
		*ThisFormSet.Stocklst_SQL.grdStockLst.SetFocus
		ThisFormSet.Stocklst_SQL.grdStockLst.clmAlloy.SetFocus
		
		*If Admin, Show Edit!
		IF HavePermission('EditStockLst',.F.)
			ThisFormSet.Stocklst_SQL.cmdMasterEdit.Visible = .T.
			ThisFormSet.Stocklst_SQL.cmdDetailEdit.Visible = .T.
		ENDIF
		
		****************
		IF WEXIST("WorkOrder")
			ThisFormSet.Stocklst_SQL.Top = ThisFormSet.Stocklst_SQL.Top + 250
		ENDIF
		
		
	ENDPROC

	PROCEDURE Stocklst_SQL.chkCCCL.Click
		DODEFAULT()
		
		
		*!*	PRIVATE cFormSort, cCCSort, cCCCL, lCCCL
		*!*	cFormSort = ALLTRIM(STR(nFormSort,2,0))
		*!*	cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		*!*	cCCCL = CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		*!*	lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
	ENDPROC

	PROCEDURE Stocklst_SQL.cmdMark.Click
		DODEFAULT()
		
	ENDPROC

	PROCEDURE Stocklst_SQL.Init
		DODEFAULT()
		
		
		
	ENDPROC

ENDDEFINE
