					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			*RETURN .F.
		ENDIF
		
		RETURN .T.
		
		
	ENDPROC

	PROCEDURE markwod_complete
		PARAMETERS lComplete
		*ThisForm.MarkWOD_Complete(.T.)
		
		*nCnt = Count_WODinWO_Detail( ThisForm.nWO_Detail, ThisForm.nConnHandle, "COMPLETE" )
		*PRIVATE nWO_Detail
