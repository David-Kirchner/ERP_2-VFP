			cMess = "WO_Detail = "+STR(ThisForm.nWO_Detail)+" was set to fComplete on Show Received VS Ordered screen."
		ELSE
			cSQL = "UPDATE dbo.WorkOrder_Detail SET fCmplt = 1 "
			cSQL = cSQL+" "
			cSQL = cSQL+" WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)
			cMess = "WO_Detail = "+STR(ThisForm.nWO_Detail)+" was set to NOT fComplete on Show Received VS Ordered screen."
		ENDIF
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			RETURN .F.
		ENDIF
		
		***************************************
		TrackMess(cMess)
		
		
		
		RETURN .T.
		
		
	ENDPROC

	PROCEDURE pship_refresh		&& Refresh the PShip Detail area
		*ThisForm.PShip_Refresh()
		
		IF USED('tmp_PShip_SOi')
			ThisForm.PShip_visible(.T.)
		
			ThisForm.txtPShip_Alloy.Value		= ShowSQLtxt(tmp_PShip_SOi.Alloy,'Alloy',12)
			ThisForm.txtPShip_Heat.Value		= ShowSQLtxt(tmp_PShip_SOi.Heat,'Heat',50)
			*ThisForm.cHeat 				= ShowSQLtxt(tmp_PShip_SOi.Heat,'Heat',50)
			*ThisForm.txtLot.Value		= ShowSQLtxt(tmp_PShip_SOi.Lot,'Lot',10)
			ThisForm.txtPShip_PC.Value	= PrepareSQLnum(tmp_PShip_SOi.PCs,'Pieces',-3)
			ThisForm.txtPShip_LBS.Value	= PrepareSQLnum(tmp_PShip_SOi.Weight,'Pounds',9,1)
			ThisForm.txtPShip_QTY.Value	= PrepareSQLnum(tmp_PShip_SOi.PT_QTY,'Receive_QTY',9,1)
		
			ThisForm.PShip_Description.Value = ShowSQLtxt(tmp_PShip_SOi.Descript,'Description',-1)
			ThisForm.txtPackingSli.Value	= PrepareSQLnum(tmp_PShip_SOi.PackingSli,'PackingSli',-3)
			
			ThisForm.txtTracking.Value		= ShowSQLtxt(tmp_PShip_SOi.Tracking,'Tracking',50)
			ThisForm.txtWho.Value			= ShowSQLtxt(tmp_PShip_SOi.Who,'Who',255)
		ELSE
			ThisForm.PShip_visible(.F.)
		ENDIF
		
	ENDPROC

	PROCEDURE pship_visible		&& Make visible
		PARAMETERS lVis
		*ThisForm.PShip_Visible(.T.)
		
		*IF lVis
			*Change Screen to an EDIT -not Add!
			ThisForm.Shape1.Visible = lVis
			ThisForm.lblThisReceive.Visible = lVis
			ThisForm.lblAlloy.Visible = lVis
			ThisForm.txtPShip_Alloy.Visible = lVis
			ThisForm.lblHeat.Visible = lVis
			ThisForm.txtPShip_Heat.Visible = lVis
		
			ThisForm.lblPieces.Visible = lVis
			ThisForm.txtPShip_PC.Visible = lVis
			
			ThisForm.lblQTY.Visible 	= lVis
			ThisForm.txtPShip_QTY.Visible = lVis
			
			ThisForm.lblActualLbs.Visible = lVis
			ThisForm.txtPShip_LBS.Visible = lVis
		
			ThisForm.PShip_Description.Visible = lVis
			
			ThisForm.lblPack.Visible = lVis
			ThisForm.txtPackingSli.Visible = lVis
			
			ThisForm.lblTracking.Visible = lVis
			ThisForm.txtTracking.Visible = lVis
			
			ThisForm.txtWho.Visible = lVis
			
		*	ThisForm.cmdJustEdit.Visible = lVis
			
			*Might need to change these
			*ThisForm.cmdCancel.Visible = .F.
			*ThisForm.cmdGood.Visible = .F.
			*ThisForm.cmdGoodCmplt.Visible = .F.
		
	ENDPROC

	PROCEDURE receivingsaveid_master
		PARAMETERS pReceivingID, pSOitem, pPOitem, cHeat, nPC_Recv, nRMA, nRcv_HPA_QTY
		*PARAMETERS pReceivingID, pSOitem, pPOitem, nWO_Detail, cHeat, nPC_Recv, nRMA, nRcv_HPA_QTY
		*ThisForm.ReceivingSaveID_Master( nReceivingID, cSOitem, cPOitem, cHeat, nPC_Recv, nRMA )
		
		***Update ID_Master and StockTable in Receiving
		*a new receive should not have stock marked!
		*RecordID_Master to Receiving.
		
			
		IF VARTYPE(pReceivingID) != "N"
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisForm.nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisForm.nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		IF pReceivingID < 1
			MESSAGEBOX("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisForm.nWO_Detail)",0,"Parameter Error")
			TrackError("No pReceivingID for ReceivingSaveID_Master(pReceivingID, pSOitem, pPOitem,ThisForm.nWO_Detail)","Parameter Error",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(pReceivingID,'ReceivingID',-3)
		
		IF VARTYPE(pSOitem) != "C"
			pSOitem = ""
		ENDIF
		
		IF VARTYPE(pPOitem) != "C"
			pPOitem = ""
		ENDIF
		IF pSOitem = Proper_SO_Item("")
			pSOitem = ''
		ENDIF
		
		*IF VARTYPE(nWO_Detail) != "N"
		*	nWO_Detail = 0
		*ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem)
			MESSAGEBOX("No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)",0,"Parameter Error")
			RecordError(0,"Parameter Error" ,PROGRAM(),LINENO(1),"No SO or PO for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem)" )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPC_Recv) != "N"
			nPC_Recv = 0
		ENDIF
		
		IF EMPTY(pSOitem) AND EMPTY(pPOitem) AND EMPTY(ThisForm.nWO_Detail)
			MESSAGEBOX("No SO, PO, or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, ThisForm.nWO_Detail)",0,"Parameter Error")
			TrackError("Parameter Error","No SO, PO or WO_Detail for ReceivingSaveID_Master(nReceivingID, pSOitem, pPOitem, ThisForm.nWO_Detail)",PROGRAM(),LINENO(1) )
			RETURN
		ENDIF
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ''
		ENDIF
		IF VARTYPE(nPC_Recv) != "N"
			nPC_Recv = 0
		ENDIF
		
		IF VARTYPE(nRMA) != "N"
			nRMA = 0
		ENDIF
		
		****
		PRIVATE cSQLu, nSQLEXEC 
		
		**Find StockLst or BrokerLst and store ID to Receiving
		*Check for Process
		
		PRIVATE nID, nID_Detail, nID_Detail_Process
		nID			= PrepareSQLnum(ThisForm.txtID_Master.Value,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		ThisForm.cTBL	= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		
		***********************************
		PRIVATE nTableID_Master, nTableID_Detail
		nTableID_Master = 0
		nTableID_Detail = 0
		
		********
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" )
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableName_ReceivingID("+STR(nReceivingID)+") AS TblName"  &&Returns Init
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						SCAN
							IF EMPTY(PrepareSQLtxt(tmpTable.TblName,'TblName',1))
								LOOP
							ELSE
								ThisForm.cTBL = PrepareSQLtxt(tmpTable.TblName,'TblName',1)
								ThisForm.txtTBL.Value = ThisForm.cTBL
								EXIT
							ENDIF
						ENDSCAN
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ENDIF
		
		********
		
		IF nID_Detail < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_Detail_ReceivingID("+STR(nReceivingID)+") AS TableID_Detail"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
		
					IF RECCOUNT('tmpTable') > 0
						nTableID_Detail = PrepareSQLnum(tmpTable.TableID_Detail,'TableID_Detail',-3)
						ThisForm.txtID_Detail.Value = nTableID_Detail 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Detail = nID_Detail
		ENDIF
		
		***********************************
		
		
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" ) AND nID_Detail > 0
		
			*try for TBL using 'Listing created from %'
			IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" )
				IF nID > 0 AND nID_Detail > 0
					*Find TBL
					IF USED("tmpTBL")
						USE IN tmpTBL
					ENDIF
					SELECT 0
					
					cSQL =        " SELECT 'S' AS TBL"	
					cSQL = cSQL + " FROM dbo.StockLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'B' AS TBL"	
					cSQL = cSQL + " FROM dbo.BrokerLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
					cSQL = cSQL + " UNION "
					cSQL = cSQL + " SELECT 'W' AS TBL"	
					cSQL = cSQL + " FROM dbo.WIPLst_Master SM "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail SD ON SM.ID=SD.ID "
					cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(nID_Detail)
					cSQL = cSQL + " AND SD.Length LIKE 'Listing created from %'"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
					ELSE
						IF USED('tmpTBL')
		
							IF RECCOUNT('tmpTBL') > 0
								ThisForm.cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							ENDIF
							USE IN 'tmpTBL'
						ENDIF
					ENDIF
				ENDIF	
			ENDIF
		
		ENDIF
		
		***********************************
		
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" ) AND nID_Detail > 0	
			&&*Process is updated with ReceivingId, not Set _Detail with ReceivingId
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Detail "
			CASE ThisForm.cTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Detail "
			CASE ThisForm.cTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
			
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		********
		
		IF nID < 1
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			cSQL = "SELECT dbo.f_TableID_ReceivingID("+STR(nReceivingID)+") AS TableID"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						nTableID_Master = PrepareSQLnum(tmpTable.TableID,'TableID',-3)
						ThisForm.txtID_Master.Value = nTableID_Master 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ELSE
			nTableID_Master = nID
		ENDIF
		
		
		***********************************
		
		IF Proper_PO_Item(pPOitem) = Proper_PO_Item('')
			IF nTableID_Master = 0
				IF nRMA = 0
					IF ThisForm.nWO_Detail > 0
						*Consider a WO_Detail for Stock.
						ThisForm.cTBL = 'S'
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************************
		*recheck for ID,ID_Detail, ID_Detail_Process by POitem
		PRIVATE lFoundProcess
		lFoundProcess = .F.
		
		IF Proper_PO_Item(pPOitem) != Proper_PO_Item('')
			IF nID = 0 AND nID_Detail = 0 AND nID_Detail_Process = 0
			
				*Check for a Process with that SOitem\WO_Detail and Heat
				nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"S",cHeat,ThisForm.nConnhandle)
				IF nID_Detail_Process = 0
					*Try Broker
					nID_Detail_Process = GetID_Detail_Process_With_POitem(pPOitem,"B",cHeat,ThisForm.nConnhandle)
					IF nID_Detail_Process > 0
						ThisForm.cTBL = "B"
					ELSE
					
						*Try WIP WO_Detail
						nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(ThisForm.nWO_Detail,"W",cHeat,ThisForm.nConnhandle)
						IF nID_Detail_Process > 0
							ThisForm.cTBL = "W"
						ELSE
						
							*Try S WO_Detail
							nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(ThisForm.nWO_Detail,"S",cHeat,ThisForm.nConnhandle)
							IF nID_Detail_Process > 0
								ThisForm.cTBL = "S"
							ELSE
								*Try B WO_Detail
								nID_Detail_Process = GetID_Detail_Process_With_WO_Detail(ThisForm.nWO_Detail,"B",cHeat,ThisForm.nConnhandle)
								IF nID_Detail_Process > 0
									ThisForm.cTBL = "B"
								ELSE
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ELSE
					ThisForm.cTBL = "S"
				ENDIF
				
				IF nID_Detail_Process > 0
					*FOUND IT, Get ID_Detail, ID
					DO CASE
					CASE ThisForm.cTBL = "S"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, ThisForm.cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, ThisForm.cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF
					CASE ThisForm.cTBL = "B"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, ThisForm.cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, ThisForm.cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF			
					CASE ThisForm.cTBL = "W"
						nID_Detail = GetID_Detail_With_ID_Detail_Process(nID_Detail_Process, ThisForm.cTBL ,ThisForm.nConnhandle)
						IF nID_Detail > 0
							nID = GetIDfromID_Detail( nID_Detail, ThisForm.cTBL, ThisForm.nConnHandle )
							IF nID > 0
								*Have All
								lFoundProcess = .T.
							ENDIF
						ENDIF				
					ENDCASE
					
					IF lFoundProcess
						ThisForm.txtID_Master.Value = nID
						nTableID_Master = nID
						ThisForm.txtID_Detail.Value = nID_Detail
						nTableID_Detail = nID_Detail
						ThisForm.txtID_Detail_Process.Value = nID_Detail_Process
						ThisForm.txtTBL.Value = ThisForm.cTBL
					
						ThisForm.Stocklst_ID		= nTableID_Master 
						ThisForm.Stocklst_ID_Detail	= nTableID_Detail 
						ThisForm.StockLst_TBL		= UPPER(ThisForm.cTBL)
					ENDIF
				ELSE
					*ADD to Stock?		
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Recheck for TBL
		IF ThisForm.cTBL!= "S" AND ThisForm.cTBL!= "B" AND ThisForm.cTBL!= "W" 
			IF nID > 0 AND nID_Detail > 0
				*Find TBL
				
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				SELECT 0
				cSQL =        " SELECT 'S' AS TBL"	
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'B' AS TBL"	
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
				cSQL = cSQL + " UNION "
				cSQL = cSQL + " SELECT 'W' AS TBL"	
				cSQL = cSQL + " FROM dbo.WIPLst_Detail "
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				cSQL = cSQL + " AND ID_Detail = "+STR(nID_Detail)
		
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
		
						IF RECCOUNT('tmpTBL') > 0
							ThisForm.cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
		*					TrackError("Found ID and ID_Detail in table '"+ThisForm.cTBL+"'.","Change in TBL!",PROGRAM(),LINENO(1))
						ELSE
							PRIVAT cMess
							cMess = "Stocklst ID = "+STR(nID)+CHR(13)
							cMess = cMess +"Stocklst ID_Detail = "+STR(nID_Detail)+CHR(13)
							cMess = cMess +"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +"TBL Could not be Identified"
							TrackError(cMess,"No TBL!",PROGRAM(),LINENO(1))
							
						ENDIF
						USE IN 'tmpTBL'
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		***********************************
		*Get nID_Detail_Process 
		
		IF nID > 0 AND nID_Detail > 0 AND nID_Detail_Process = 0
			IF ThisForm.cTBL!= "S" AND ThisForm.cTBL!= "B" AND ThisForm.cTBL!= "W" 
				IF USED("tmpID_D_P")
					USE IN tmpID_D_P
				ENDIF
				SELECT 0
				cSQL = " SELECT * FROM "	
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Process "
				CASE ThisForm.cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Process "
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL + " dbo.WIPLst_Process "
				ENDCASE
				cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
				IF nReceivingID > 0
					cSQL = cSQL + " AND ReceivingID = "+STR(nReceivingID)
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_D_P')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_D_P")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
		
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_D_P')
				ELSE
					IF USED('tmpID_D_P')
		
						IF RECCOUNT('tmpID_D_P') > 0
							SCAN
								nID_Detail_Process = PrepareSQLnum(tmpID_D_P.ID_Detail_Process,'ID_Detail_Process',-3)
							ENDSCAN
						ENDIF
						
						USE IN tmpID_D_P
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		*Create Receive Process if have Table, ID_Detail AND no ID_Detail_Proc, BUT not found in History!
		IF nID_Detail_Process = 0
			IF NOT EMPTY(ThisForm.cTBL)
				IF nTableID_Detail > 0
					*Add a Receiving record to History, Only one that shows the ReceivingID
					THISFORM.Create_Receive_Process(ThisForm.cTBL,nTableID_Detail,pSOitem,pPOitem,nReceivingID, nRcv_HPA_QTY, nID_Detail_Process)
				ENDIF
			ENDIF		
		ENDIF
		
		
		***********************************
		IF nID_Detail_Process > 0 AND nReceivingID > 0
			IF NOT EMPTY(ThisForm.cTBL)
				*Update Process with ReceivingID
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Process SET"
				CASE ThisForm.cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Process SET"
				CASE ThisForm.cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Process SET"
				ENDCASE
				cSQLu = cSQLu +" ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail_Process = "+STR(nID_Detail_Process )
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"SQL Error:"+STR(nSQLEXEC) ,PROGRAM(),LINENO(1),"Could not update"+CHR(13)+"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		
		***********************************
		IF nID_Detail > 0
			IF NOT EMPTY(ThisForm.cTBL)
				*Update Detail with Receiving ID
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQLu = "UPDATE dbo.StockLst_Detail "
				CASE ThisForm.cTBL = "B"
					cSQLu = "UPDATE dbo.BrokerLst_Detail "
				CASE ThisForm.cTBL = "W"
					cSQLu = "UPDATE dbo.WIPLst_Detail "
				ENDCASE
				cSQLu = cSQLu +" SET ReceivingID = "+STR(nReceivingID)
				cSQLu = cSQLu +" WHERE ID_Detail = "+STR(nID_Detail )
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
					*RETURN
					RecordError(0,"Could not update" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
				ENDIF
			ENDIF
		ENDIF	
		***********************************
		
		IF nTableID_Master > 0
			IF NOT EMPTY(ThisForm.cTBL)
				*Check for Heat match
				
				IF USED("tmpMasterHeat")
					USE IN tmpMasterHeat
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS CTND "
				DO CASE
				CASE ThisForm.cTBL = "S"
					cSQL = cSQL +" FROM dbo.StockLst_Master "
				CASE ThisForm.cTBL = "B"
					cSQL = cSQL +" FROM dbo.BrokerLst_Master "
				CASE ThisForm.cTBL = "W"
					cSQL = cSQL +" FROM dbo.WIPLst_Master "
				ENDCASE
				cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
				cSQL = cSQL +" AND Heat = '"+cHeat+"'"
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterHeat')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterHeat')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterHeat")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterHeat")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMasterHeat')
				ELSE
					IF USED('tmpMasterHeat')
						IF VARTYPE(tmpMasterHeat.CTND)='N'
							*********
							IF tmpMasterHeat.CTND = 0			
								*Did not Find Correct Heat!
								*look for 'Due in'
								
								IF USED("tmpMasterDueIn")
									USE IN tmpMasterDueIn
								ENDIF
								
								cSQL = "SELECT COUNT(*) AS CTND "
								DO CASE
								CASE ThisForm.cTBL = "S"
									cSQL = cSQL +" FROM dbo.StockLst_Master "
								CASE ThisForm.cTBL = "B"
									cSQL = cSQL +" FROM dbo.BrokerLst_Master "
								CASE ThisForm.cTBL = "W"
									cSQL = cSQL +" FROM dbo.WIPLst_Master "
								ENDCASE
								cSQL = cSQL +" WHERE ID = "+STR(nTableID_Master)
								cSQL = cSQL +" AND Heat = 'DUE IN'" 
		
								SELECT 0
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterDueIn')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterDueIn')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterDueIn")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterDueIn")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpMasterDueIn')
								ELSE
									IF USED('tmpMasterDueIn')
										IF VARTYPE(tmpMasterDueIn.CTND)='N'
											IF tmpMasterDueIn.CTND = 0
												*Did not Find Correct Heat or 'Due In'!
												nTableID_Master = 0
											ENDIF
										ENDIF
										USE IN tmpMasterDueIn
									ENDIF				
								ENDIF
							*********					
							ENDIF
						ENDIF
						USE IN tmpMasterHeat
					ENDIF				
				ENDIF
			ENDIF
		ENDIF
		
		***********************************
		
		PRIVATE lSaved
		lSaved = .F.
		
		IF nTableID_Master = 0
			IF nID > 0
				nTableID_Master = nID
			ENDIF
			IF nID_Master > 0
				nTableID_Master = nID_Master
			ENDIF	
		ENDIF
		
		IF nTableID_Master > 0
			
			cSQLu = "UPDATE dbo.Receiving SET"
			cSQLu = cSQLu +" ID_Master = "+STR(nTableID_Master)+""
			cSQLu = cSQLu +",ID_Detail = "+STR(nID_Detail)+""
			cSQLu = cSQLu +",StockTable = '"+ThisForm.cTBL+"'"
			cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
				lSaved = .F.
				*RETURN
				RecordError(0,"Could not update dbo.Receiving" ,PROGRAM(),LINENO(1),"SQL Error:"+STR(nSQLEXEC)+CHR(13)+cSQLu )
			ELSE 
				lSaved = .T.
			ENDIF
		ELSE
			lSaved = .F.
		
		*	PRIVATE cText
		*	cText = "Not in StockLst or BrokerLst!"+CHR(13)+"Did not save StockLst ID to Receiving table! No ID_Master for StockTable = '"+ThisForm.cTBL+"' AND Receiving ID = "+STR(nReceivingID)
		*	MESSAGEBOX( cText ,0+48,"ReceivingID "+ALLTRIM(STR(nReceivingID)) )
		*	TrackMess(cText)
		ENDIF
		
		***********************************
		
		IF nTableID_Master > 0
			IF NOT ( ThisForm.Stocklst_ID = nTableID_Master AND ThisForm.Stocklst_ID_Detail = nTableID_Detail AND ThisForm.StockLst_TBL = UPPER(ThisForm.cTBL) )
				IF EMPTY(ThisForm.cTBL) OR ThisForm.Stocklst_ID>0
					PRIVAT cMess
					cMess = "Stocklst_ID = "+STR(ThisForm.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
					cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisForm.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
					cMess = cMess +"StockLst_TBL = '"+ThisForm.StockLst_TBL+"' 		TBL1 = '"+UPPER(ThisForm.cTBL)+"'"+CHR(13)
					cMess = cMess +"ReceivingID="+STR(nReceivingID)
					TrackError(cMess,"Change in ID, ID_Detail, or TBL!",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
			
			IF ThisForm.Stocklst_ID = 0
				ThisForm.Stocklst_ID		= nTableID_Master 
				ThisForm.Stocklst_ID_Detail	= nTableID_Detail 
				*ThisForm.ID_Detail_process
			ENDIF
		ENDIF
		
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" )
			IF ThisForm.Stocklst_ID > 0 AND ThisForm.Stocklst_ID_Detail > 0
			
				*What Table has ID and ID_Detail combo
				IF USED("tmpTBL")
					USE IN tmpTBL
				ENDIF
				
				cSQL = "SELECT 'S' AS TBL FROM dbo.Stocklst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID) 
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'B' AS TBL FROM dbo.BrokerLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
				
				cSQL = cSQL +" UNION "
				
				cSQL = cSQL +" SELECT 'W' AS TBL FROM dbo.WIPLst_Detail "
				cSQL = cSQL +" WHERE ID = "+STR(ThisForm.Stocklst_ID)
				cSQL = cSQL +" AND ID_Detail = "+STR(ThisForm.Stocklst_ID_Detail)
		
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTBL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTBL')
				ELSE
					IF USED('tmpTBL')
						IF RECCOUNT('tmpTBL')>0
							ThisForm.cTBL = PrepareSQLtxt(tmpTBL.TBL,'TBL',1)
							PRIVAT cMess
							cMess = "Stocklst_ID = "+STR(ThisForm.Stocklst_ID)+" TableID_Master = "+STR(nTableID_Master)+CHR(13)
							cMess = cMess +"Stocklst_ID_Detail = "+STR( ThisForm.Stocklst_ID_Detail) +"  TableID_Detail = "+STR(nTableID_Detail)+CHR(13)
							cMess = cMess +"StockLst_TBL = '"+ThisForm.StockLst_TBL+"' 		TBL1 = ''"
							cMess = cMess +CHR(13)+"ReceivingID="+STR(nReceivingID)+CHR(13)
							cMess = cMess +CHR(13)+"TBL1 now= '"+UPPER(ThisForm.cTBL)+"'"
		*					TrackError(cMess+CHR(13)+CHR(13)+cSQL,"Change TBL!",PROGRAM(),LINENO(1))
						ENDIF
						USE IN tmpTBL
					ENDIF
				ENDIF	
			ENDIF
		ENDIF
		
		IF NOT ( ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W" )
			*Found a TBL, Show it on screen
			ThisForm.StockLst_TBL = UPPER(ThisForm.cTBL)
			ThisForm.txtTBL.Value = UPPER(ThisForm.cTBL)
			ThisForm.txtTBL.Refresh
		ENDIF
		
		IF USED('Receiving')
			SELECT Receiving
		ENDIF
		
		RETURN lSaved
	ENDPROC

	PROCEDURE refreshforms		&& tmpFormCaptions
		PARAMETERS pSS
		*ThisFormSet.RefreshForms()
		
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		
		IF VARTYPE(pSS) != 'N'
			pSS = 0
		ENDIF
		
		*IF pSS = 0
			PRIVATE cForm
			cForm = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
			
			
			IF NOT EMPTY(cForm) OR LEN(cForm) > 0
				IF GetFormCaptions(cForm,ThisForm.nConnhandle)
					IF USED('tmpFormCaptions')
						ThisForm.lblTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
						ThisForm.lblSZ21.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisForm.lblSZ21.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisForm.lblSZ31.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisForm.LBLSZ31.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisForm.txtSZ3.Visible 	= tmpFormCaptions.use3rdDim
						ThisForm.txtSZ3.Enabled 	= tmpFormCaptions.Sz3Enable
						ThisForm.lblSZ41.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisForm.lblSZ41.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ELSE
						TrackMess( "tmpFormCaptions is not used!")
						TrackError("Table tmpFormCaptions is not open!","tmpFormCaptions is not used!", PROGRAM(), LINENO(1))
					ENDIF
				ENDIF
			ENDIF
			
			IF NOT EMPTY(lCurrentTable)
				IF USED(lCurrentTable)
					SELECT (lCurrentTable)
				ENDIF
			ENDIF
		*ENDIF
		
		
		
	ENDPROC

	PROCEDURE settowod
	ENDPROC

	PROCEDURE Unload
		IF USED('tmp_Ship_SOi')	
			USE IN tmp_Ship_SOi
		ENDIF
		
		
		RETURN ThisForm.nReturn
	ENDPROC

	PROCEDURE updateprocess
		PARAMETERS nID_Detail_Process, nReceivingID 
		*ThisForm.UpdateProcess(nID_Detail_Process, ThisForm.cTBL, ThisForm.nReceivingID )
		cSQL = " UPDATE "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		ENDCASE
		cSQL = cSQL + " SET ReceivingID = "+STR(nReceivingID)
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
			RETURN .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE update_incoming_process
		PARAMETERS nNewTBL, nNewID, nNewID_Detail, nOld_ID, nOld_ID_Detail
		*ThisForm.Update_Incoming_Process()
		*Updates the Incomming process with the new Edit data
		
		IF VARTYPE(nNewTBL)!="C"
			nNewTBL = ThisForm.cTBL
		ENDIF
		IF VARTYPE(nNewTBL)!="C"
			TrackError("Receiving:Receiving_Create_Incoming_Process(cTBL:NO TABLE ,nID_Detail:"+STR(nID_Detail)+",nPounds"+")" ,"bad variable",PROGRAM(),LINENO(1))
			ThisForm.cTBL = ""
			RETURN .F.
		ENDIF
		
		PRIVATE cSOitem,cPOitem
		cSOitem = Proper_SO_item(ThisForm.cSOitem)
		cPOitem = Proper_PO_item(ThisForm.cPOitem)
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisForm.nReceivingID,'ReceivingID',-3)
		
		IF nNewTBL = "N"
			TrackMess("Receiving:Receiving_Create_Incoming_Process(cTBL :"+nNewTBL +",nID_Detail:"+STR(nID_Detail)+",pSOitem:"+cSOitem+",pPOitem:"+cPOitem+")" )
			RETURN .F.
		ENDIF
		
		IF nID_Detail = 0
			*nID_Detail = get_ID_Detail_with_SOitem(cSOitem, nNewTBL, "", ThisForm.nConnHandle)
			TrackMess("Show Received VS Ordered:Create_Incoming_Process(cTBL:"+nNewTBL+",nID_Detail:"+STR(nID_Detail)+",cSOitem:"+cSOitem+",pPOitem:"+cPOitem+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
			RETURN .F.
		ENDIF
		
		IF nReceivingID < 1
			*need ReceivingID
			*POitem is too vague
			RETURN .F.
		ENDIF
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE cPrc_Form, nPU, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nPU 		= nPU_Acct_Form(cPrc_Form ,ThisForm.nConnHandle)
		nPrc_PCs	= PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC',-3)
		nPrc_Dim1	= PrepareSQLnum(ThisForm.txtThck.Value,'DIM1',10,4)
		nPrc_Dim2	= PrepareSQLnum(ThisForm.txtSz2.Value,'DIM2',9,3)
		nPrc_Dim3	= PrepareSQLnum(ThisForm.txtSz3.Value,'DIM3',9,3)
		
		PRIVATE nPrc_S_QTY, nPrc_Q_PU, nOrdered_QTY, nOrdered_P
		nPrc_S_QTY = 0
		nPrc_Q_PU = nPU_Acct_Form(cPrc_Form ,ThisForm.nConnHandle)
		IF ThisForm.nWO_Detail > 0
			nOrdered_QTY = Get_From_WO_Detail(ThisForm.nWO_Detail,'fWeight',ThisForm.nConnHandle)
			nOrdered_P = 0
		ENDIF
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			nOrdered_QTY = Get_From_POitem(cPOitem, "StockLst_QTY", ThisForm.nConnHandle )
			nOrdered_P = Get_From_POitem(cPOitem, "StockLst_P", ThisForm.nConnHandle )
		ENDIF
		
		PRIVATE nQTY_Need, nLBS_Need, nPC_Need
		nQTY_Need	= PrepareSQLnum(ThisForm.txtQTY_Need.Value,'QTY',-5)
		nLBS_Need	= PrepareSQLnum(ThisForm.txtLBS_Need.Value,'Pounds',8,1)
		nPC_Need	= PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC',-3)
		
		PRIVATE nPast_QTY, nPast_LBS, nPast_PCs
		nPast_QTY	= PrepareSQLnum(ThisForm.txtPast_QTY.Value,'QTY',-5)
		nPast_LBS	= PrepareSQLnum(ThisForm.txtPast_LBS.Value,'Pounds',8,1)
		nPast_PCs	= PrepareSQLnum(ThisForm.txtPast_PCs.Value,'PC',-3)
		
		PRIVATE nQTY_Recv, nLBS_Recv, nPC_Recv
		nQTY_Recv	= PrepareSQLnum(ThisForm.txtPShip_QTY.Value,'QTY',-5)
		nLBS_Recv	= PrepareSQLnum(ThisForm.txtPShip_LBS.Value,'Pounds',8,1)
		nPC_Recv	= PrepareSQLnum(ThisForm.txtPShip_PC.Value,'PC',-3)
		
		PRIVATE cSalesPerson, dtStartDate, dDueDate
		cSalesPerson = PrepareSQLtxt( AppSetup_Get_UserName( getSalesP_POitem( cPOitem, ThisForm.nConnHandle )),'SalesPerson', 20)
		dtStartDate = DATE()
		dDueDate = GetNewDueDate( cPOItem, ThisForm.nConnHandle )
		*dDueDate = Get_From_Purchase_POitem (cPOitem, "Field", ThisForm.nConnHandle )
		
		PRIVATE cProcessor, cComment
		cProcessor = RIGHT( SYS(0) ,LEN(SYS(0))-AT("#",SYS(0))-1 )	&&cUserName 
		cComment = "ReceivingID = "+ALLTRIM(STR(nReceivingID))+" ran on "+DTOC(DATE())
		
		**********************
		*INSERT an 'RECEIVED' Process first with the NEW data for New ID_Detail\Receive
		*-- call it Received so it will be automatically deleted.
		**
		PRIVATE cSQLi
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		cSQLi = "EXEC dbo.p_Lst_Process_ins "
		cSQLi = cSQLi + " @TBL = '"+nNewTBL+"'"
		cSQLi = cSQLi + ",@ID_Detail ="+STR(nNewID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@Startdate = '"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = 'N'"	&&+cAllowSub+"'"   &&Incoming is not allowed to SUB
		
		cSQLi = cSQLi + ",@PU	= "+STR(nPU)
		cSQLi = cSQLi + ",@QTY	= "+STR(nQTY_Recv,18,4)
		cSQLi = cSQLi + ",@Pounds ="+STR(nLBS_Recv,9,1)
		
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		cSQLi = cSQLi + ",@WO 	= "+STR(0)
		cSQLi = cSQLi + ",@WO_Detail= "+STR(ThisForm.nWO_Detail)
		
		cSQLi = cSQLi + ",@Process_ID = 'RECEIVED'"	&&+cProcess_ID+"'"  
		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID) 
		
		cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
		cSQLi = cSQLi + ",@Prc_PCs = "+STR(nPC_Recv)
		cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
		cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
		cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
		cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nOrdered_QTY,18,4)
		cSQLi = cSQLi + ",@Ordered_P = "+STR(nOrdered_P,18,4)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
			lOK=.F.
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.EXP,'ID_Detail_Process',-3)
				IF nID_Detail_Process > 0
		
					PRIVATE cText
					cText = "INFO: Created RECEIVED Process "+STR(nID_Detail_Process)+" Show_Ship_Order.Create_Incoming_Process "+" StockTable="+ThisForm.cTBL+CHR(13)
					IF Proper_PO_item(cPOitem)<>Proper_PO_item("")
						cText = cText +" PO item="+cPOitem
					ENDIF
					IF ThisForm.nWO_Detail > 0
						cText = cText +" WO Detail="+ALLTRIM(STR(ThisForm.nWO_Detail))
					ENDIF
					*cText = cText +" Process_ID = '"+cProcess_ID+"'"  
					*MESSAGEBOX( cText,0+48,"INFO: Updated Balance of INCOMING Process After ReceivingID "+ALLTRIM(STR(nReceivingID)) )
					TrackMess(cText)
				ENDIF
		
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		
		****************************************************************
		*Edit The old Incoming a Received!
		*"Updated Balance of INCOMING Process After ReceivingID "+ALLTRIM(STR(nReceivingID)) )
		
		PRIVATE nID_Detail_Prc
		**Check for ID of INCOMING Process 
		nID_Detail_Prc = Get_ID_Detail_Prc_by_ID_Detail(nOld_ID_Detail,ThisForm.cTBL,'INCOMING',ThisForm.nConnHandle)
		
		IF nID_Detail_Prc > 0
			cSQL = " UPDATE "
			DO CASE
			CASE nNewTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Process "
			CASE nNewTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Process "
			CASE nNewTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Process "
			ENDCASE
			cSQL = cSQL + " SET QTY = "+STR(nQTY_Need,18,4)
			cSQL = cSQL + ",Pounds = "+STR(nLBS_Need,9,1)
			cSQL = cSQL + ",Prc_PCs ="+STR(nPC_Need)	&&nPrc_PCs
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nOld_ID_Detail)
			cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PartRecv' )"
			cSQL = cSQL + " AND ReceivingID = 0"
		ELSE
		
			cSQL = " INSERT INTO "
			DO CASE
			CASE nNewTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Process "
			CASE nNewTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Process "
			CASE nNewTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Process "
			ENDCASE
			cSQL= cSQL + " (SOitem,PO_item,SalesPerson,Startdate,DueDate,Comment     "
			cSQL= cSQL + ",[Process_ID],Processor,AllowSub,PU,QTY,Ordered_QTY,Ordered_P,Pounds "
			cSQL= cSQL + ",ID_Detail ,WO,WO_Detail"
			cSQL= cSQL + ",Prc_Form ,Prc_PCs,Prc_Dim1 ,Prc_Dim2,Prc_Dim3 ,Prc_S_QTY ,Prc_Q_PU "
			
			cSQL= cSQL + " ) VALUES ("
			cSQL= cSQL + "'"+cSOitem+"'"
			cSQL= cSQL + ",'"+cPoItem+"'"
			cSQL= cSQL + ",'"+cSalesPerson+"'"
			cSQL= cSQL + ",'"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"	
			cSQL= cSQL + ",'"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQL= cSQL + ",'Revised INCOMING'"	
			
			cSQL= cSQL + ",'INCOMING'" 
			cSQL= cSQL + ",'"+LEFT( "Part Rcv "+RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ) ,20)+"'"
			cSQL= cSQL + ",'N'"	&&+cAllowSub+"'"   &&Incoming is not allowed to SUB	
			cSQL= cSQL + ","+STR(nPU)
		
			cSQL= cSQL + ","+STR(nQTY_Need,18,4)
			cSQL= cSQL + ","+STR(nOrdered_QTY,18,4)
			cSQL= cSQL + ","+STR(nOrdered_P,18,4)
			cSQL= cSQL + ","+STR(nLBS_Need,9,1)
			cSQL= cSQL + ","+STR(nNewID_Detail)+""
			cSQL= cSQL + ",0"
			cSQL= cSQL + ","+STR(ThisForm.nWO_Detail)
		
			cSQL = cSQL + ",'"+cPrc_Form+"'"
			cSQL = cSQL + ","+STR(nPC_Need)	&&nPrc_PCs
		
			cSQL = cSQL + ", "+STR(nPrc_Dim1,10,4)
			cSQL = cSQL + ", "+STR(nPrc_Dim2,9,3)
			cSQL = cSQL + ", "+STR(nPrc_Dim3,9,3)
			cSQL = cSQL + ", "+STR(nQTY_Need,18,4)
			cSQL = cSQL + ", "+STR(nPrc_Q_PU)
			cSQL = cSQL + " )"
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
						lOK = .F.
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
			lOK = .F.
		ENDIF
		
		IF lOK 
			*UPDATE old_ID_Detail set Receiving = 0
			*Clean old style if found
			cSQL = " UPDATE "
			DO CASE
			CASE nNewTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail "
			CASE nNewTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail "
			CASE nNewTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " SET ReceivingID=0"
			cSQL = cSQL + " WHERE ID_Detail = "+STR(nOld_ID_Detail)
			cSQL = cSQL + " AND ISNULL(ReceivingID,0)>0 "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
							lOK = .F.
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
				*lOK = .F.
			ENDIF
		ENDIF
		
		RETURN lOK
		
		
	ENDPROC

	PROCEDURE update_postatus
		PARAMETERS lCmplt_the_Prc
		*ThisForm.Update_POStatus()
		
		IF VARTYPE(lCmplt_the_Prc) <> "L"
			lCmplt_the_Prc = .T.
		ENDIF
		*Check POStatus
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpShow_SOiStat')	
			USE IN tmpShow_SOiStat
		ENDIF
		
		cSQL = 		  " SELECT M.POStatus, 'S' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.StockLst_Master M  WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF ThisForm.nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisForm.nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
		IF ThisForm.nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(ThisForm.nReceivingID)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'B' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF ThisForm.nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisForm.nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
		IF ThisForm.nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(ThisForm.nReceivingID)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT M.POStatus, 'W' AS TBL, D.ReceivingID "
		cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
		
		IF ThisForm.nWO_Detail > 0
			cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisForm.nWO_Detail)
		ELSE
			cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		ENDIF
		IF ThisForm.nReceivingID > 0
			cSQL = cSQL + " OR D.ReceivingID = "+STR(ThisForm.nReceivingID)
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOiStat')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOiStat')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOiStat")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOiStat")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShow_SOiStat')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		
		PRIVATE lDueIn, lPartialReceive, lWaitingforBill, lAccountedfor
		lDueIn = .F.
		lPartialReceive = .F.
		lWaitingforBill = .F.
		lAccountedfor = .F.
		
		PRIVATE nMess,  nReceivingID2, cPOStatusText
		nMess = 0
		
		nReceivingID2 = 0
		cPOStatusText = ''
		
		***************************************
		
		IF USED('tmpShow_SOiStat')	
			IF RECCOUNT('tmpShow_SOiStat') > 0
			
				DO CASE
				CASE tmpShow_SOiStat.TBL = 'S'
					ThisForm.cTBL = "S"
				CASE tmpShow_SOiStat.TBL = 'B'
					ThisForm.cTBL = "B"
				CASE tmpShow_SOiStat.TBL = 'W'
					ThisForm.cTBL = "W"
				OTHERWISE
					TrackError(cSQL,"Could not find TBL.",PROGRAM(),LINENO(1) )
					ThisForm.cTBL = "N"
				ENDCASE
				
				SCAN
					
					cPOStatus	= PrepareSQLtxt(tmpShow_SOistat.POStatus,'POStatus',1)
					
					DO CASE
					CASE cPOStatus = "D"	
						cPOStatusText = "DUE IN" && INCOMING
						lDueIn = .T.
						nReceivingID2 = PrepareSQLnum(tmpShow_SOistat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "P"	
						cPOStatusText = "Partial Receive" && "PARTRECV"
						lPartialReceive = .T.
						nReceivingID2 = PrepareSQLnum(tmpShow_SOistat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "W"	
						cPOStatusText = "Waiting for Bill"
						lWaitingforBill = .T.
						nReceivingID2 = PrepareSQLnum(tmpShow_SOistat.ReceivingID,'ReceivingID',-3)
						EXIT
					CASE cPOStatus = "A"	
						cPOStatusText = "Accounted for"
						lAccountedfor = .T.
						nReceivingID2 = PrepareSQLnum(tmpShow_SOistat.ReceivingID,'ReceivingID',-3)
						EXIT
					ENDCASE
				ENDSCAN
			ENDIF
		ENDIF
				
		IF nReceivingID2 > 0
			IF ThisForm.nReceivingID <> nReceivingID2
				ThisForm.nReceivingID2 = nReceivingID2 
				*TrackMess("The POitem: '"+ThisForm.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(ThisForm.nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(ThisForm.nReceivingID))+"."+CHR(13)+cSQL)
				IF ThisForm.nWO_Detail > 0
					TrackError("The WO Detail: '"+STR(ThisForm.nWO_Detail)+"' has a ReceivingID of "+ALLTRIM(STR(ThisForm.nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL ,"Found nReceivingID2",PROGRAM(),LINENO(1))
				ELSE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The POitem: '"+ThisForm.cPOitem+"' has a ReceivingID of "+ALLTRIM(STR(ThisForm.nReceivingID))+"."+CHR(13)+"The Second ReceiveingID2 is "+ALLTRIM(STR(nReceivingID2))+"."+CHR(13)+cSQL )
				ENDIF
			ENDIF
		ENDIF
		
		**********************
		PRIVATE cSOitem
		cSOitem 	= Proper_SO_Item( ThisForm.cSOitem )
		
		**********************
		*Mark Master as POStatus='P'	&&Partial
		*
		**********************
		*Never Mark as Partial again!!! 3/11/2019
		*Complete the Receive ' lClearIncomingProcess '
		* and Create a new INCOMING Master, Detail, Process! ???
		*
		
		PRIVATE nMess
		nMess = 0
		PRIVATE lClearIncomingProcess
		lClearIncomingProcess = .F.
		
		IF lAccountedfor 
			*Do Nothing
			*cPOStatusText = "Accounted for"
			IF NOT lCmplt_the_Prc
				TrackMess("Did NOT Updated Stock:"+ThisForm.cTBL+" POStatusText = 'Accounted for' Receiving ID "+ALLTRIM(STR(ThisForm.nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
			ENDIF
			lClearIncomingProcess = .F.
		ELSE
			IF lWaitingforBill 
				*Do Nothing
				*cPOStatusText = "Waiting for Bill"
				IF NOT lCmplt_the_Prc
					TrackMess("Did NOT Updated Stock:"+ThisForm.cTBL+" POStatusText = 'Waiting for Bill' Receiving ID "+ALLTRIM(STR(ThisForm.nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
				ENDIF
		
				lClearIncomingProcess = .F.
			ELSE
				IF NOT lCmplt_the_Prc
					*User selected Good recieve, Not Complete
					nMess = 6
				ELSE
					*User Selected 'Just Editing' or Completes POitem
					IF lDueIn 
						IF ThisForm.nWO_Detail > 0
							nMess = MESSAGEBOX("This WO Detail:"+STR(ThisForm.nWO_Detail)+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"WO Detail status will be listed as Complete.")
						ELSE
							nMess = MESSAGEBOX("This PO_Item:"+ThisForm.cPOitem+" has a 'DUE IN' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'DUE IN'.",4+64,"PO status will be listed as Complete.")
						ENDIF
					ELSE
						IF lPartialReceive 
							IF ThisForm.nWO_Detail > 0
								nMess = MESSAGEBOX("This WO Detail:"+STR(ThisForm.nWO_Detail)+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"WO Detail status will be listed as Complete.")
							ELSE
								nMess = MESSAGEBOX("This PO_Item:"+ThisForm.cPOitem+" has a 'Partial Receive' flag."+CHR(13)+"This POitem will be marked as complete."+CHR(13)+"Click (Yes) to continue as Complete"+CHR(13)+"Click (No) to keep as 'Partial Receive'.",4+64,"PO status will be listed as Complete.")
							ENDIF			
						ENDIF
					ENDIF
				ENDIF
						
				IF nMess = 6
					lClearIncomingProcess = .T.
					cSQL = ""
					DO CASE
					CASE ThisForm.cTBL = "S"
						cSQL = " UPDATE dbo.StockLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisForm.cTBL = "B"
						cSQL = " UPDATE dbo.BrokerLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisForm.cTBL = "W"
						cSQL = " UPDATE dbo.WIPLst_Master "
						cSQL = cSQL + " SET POStatus = 'W'"
						cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					CASE ThisForm.cTBL = "N"
						*
					OTHERWISE 
						ThisForm.cTBL = "N"
					ENDCASE
					
					IF ThisForm.cTBL = "N"
						*No TBL
					ELSE
						IF ThisForm.nWO_Detail > 0
							cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisForm.nWO_Detail)
						ELSE
							cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
						ENDIF
						IF nReceivingID2 > 0
							cSQL = cSQL + " OR D.ReceivingID = "+STR(nReceivingID2)
						ENDIF
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF		
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
						ELSE 
							TrackMess("Updated Stock:"+ThisForm.cTBL+" POStatusText set to W 'Waiting for Bill', Receiving ID "+ALLTRIM(STR(ThisForm.nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
							*MESSAGEBOX(cSQL,0,"Success")
						ENDIF
					ENDIF		
		
				ELSE
					IF NOT lCmplt_the_Prc
						TrackMess("Did NOT Updated Stock:"+ThisForm.cTBL+" User choose to not Complete. Receiving ID "+ALLTRIM(STR(ThisForm.nReceivingID))+", PO:"+ALLTRIM(ThisForm.cPOitem)+", SO:"+ALLTRIM(cSOitem))
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		RETURN lClearIncomingProcess
	ENDPROC

	PROCEDURE cmdCancel.Valid
		IF MESSAGEBOX("Are you sure you want to Abort this?",4+32,"Cancel")=6
			*cTBL = ThisForm.cTBL
			ThisForm.nReturn = 0
			ThisForm.Release
		ENDIF
		
	ENDPROC

