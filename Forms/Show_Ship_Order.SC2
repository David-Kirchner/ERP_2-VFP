		nSalesNum = VAL(ThisForm.cSOitem)
		
		
		*has complete changed?
		IF ThisForm.ogPOitem.NotDone.Value =1
		
			lOK=Mark_SOitem_Cmplt(ThisForm.cSOitem, ThisForm.nConnHandle, .F. ) &&use .T. to lUnMark
		*cSQL = "UPDATE dbo.Sales SET "
		*cSQL = "UPDATE Router.dbo.rtr SET "
		*cSQL = "UPDATE dbo.SOitem_Hrs SET "
		*cSQL = "UPDATE dbo.Ship SET "
		*cSQL = "UPDATE dbo.Mach_Shop SET "
		*check across all items for complete or UNcomplete and Cancelled
			*cSQL = "UPDATE dbo.Sales_No "
		
			IF lOK
				ThisForm.nReturn = 4
			ENDIF
		ENDIF
		ThisForm.Release
		
	ENDPROC

