	PROCEDURE check_partrecv		&& Check and Add PartRecv Process
		PARAMETERS pWhat
		*ThisForm.Check_PartRecv()
		
		
	ENDPROC

	PROCEDURE clean_stock
		PARAMETERS pWhat
		*ThisForm.Check_PartRecv()
		*ThisForm.Clean_Stock()
		
		PRIVATE cWhat  &&"CMPLT","EDIT","NOT_CMPLT"
		cWhat = PrepareSQLtxt(pWhat,'WHAT',10)  
		**ThisForm.Clean_Stock("CMPLT")
		
		*This could be an Edit/show Old data.
		*Check for ReceivingID in Stock to see if new partial stock needs to be run
		*EXIT if needed.  cmdCancel
		
		PRIVATE nID_Master, nID_Detail
		nID_Detail = PrepareSQLnum(ThisForm.nID_Detail,'ID_Detail',-3)
		nID_Master = 0
		IF nID_Detail > 0
			nID_Master = Get_ID_Master_with_ID_Detail(nID_Detail, ThisForm.cTBL, ThisForm.nConnHandle) 
		ENDIF
		
		IF nID_Master = 0
			IF ThisForm.nReceivingID > 0
				nID_Master = Get_ID_Master_by_ReceivingID(ThisForm.nReceivingID,ThisForm.cTBL,ThisForm.nConnHandle)
				IF nID_Master > 0
					*This Show Received vs Ordered was just a Receive Edit, not an ADD!
					*did not come in with RID but 
					ThisForm.nReturn = 1
					ThisForm.Release
					RETURN .T.
				ELSE
					*A new Receive_Edit does not have the Stock Detail with the ReceivingID and ID_Master would be 0
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		IF NOT (ThisForm.cTBL = "S" OR ThisForm.cTBL = "B" OR ThisForm.cTBL = "W")
			RETURN .T.
			*Do not contiunue down this path
		ENDIF
		
		*****************************
		*Check that there is no history
		*Do not change if history has been made 
		
		PRIVATE lFound_STK_History
		lFound_STK_History = .F.
		
		
		PRIVATE nSQLEXEC, cSQL
		IF nID_Detail > 0
			lFound_STK_History  = Has_ID_Detail_History(nID_Detail, ThisForm.cTBL, ThisForm.nConnhandle)
		ENDIF
			
		*****************************
		PRIVATE nPO_OrigQTY, nO_QTY, nID_Detail_Process, nID_Detail_Process
		nPO_OrigQTY = 0
		nO_QTY	= 0
		nID_Detail_Process = 0
		nID_Detail_INCOMING = 0
		PRIVATE lIncoming,lNOT2HPA, lPARTRECV
		lIncoming = .T.
		lNOT2HPA = .F.
		lPARTRECV = .F.
		PRIVATE nPrc_PCs_need 
		PRIVATE lFoundOldPrc
		lFoundOldPrc = .F.
		
		*Look for INCOMING PO item or WO_Detail
		PRIVATE nSQLEXEC, cSQL
		
		IF USED('tmpStkProc')	
			USE IN tmpStkProc
		ENDIF
		
		cSQL = " SELECT QTY, Ordered_QTY, Ordered_P, ReceivingID, Process_ID, 'Original' AS Process, ID_Detail, ID_Detail_Process "
		cSQL = cSQL + " ,[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3],[Prc_S_QTY],[Prc_Q_PU] "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
		ENDCASE
		IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_Item('')
			cSQL = cSQL + " WHERE PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
			IF ThisForm.nWO_Detail > 0
				cSQL = cSQL + " AND WO_Detail = "+STR(ThisForm.nWO_Detail)
			ENDIF
		ELSE
			IF ThisForm.nWO_Detail > 0
				cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)
			ELSE
				cSQL = cSQL = " WHERE 0>0 "
			ENDIF
		ENDIF
		cSQL = cSQL+" AND ( Process_ID='INCOMING' OR Process_ID = 'NOT2HPA' )"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkProc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkProc")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStkProc')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpStkProc')
			IF RECCOUNT('tmpStkProc') > 0
				***************************
				SCAN	&& NOT sure if multiple exists ???
					
					DO CASE
					CASE tmpStkProc.Process_ID = 'INCOMING' 
						lIncoming = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_S_QTY 	= PrepareSQLnum(tmpStkProc.Prc_S_QTY,'Prc_S_QTY',-5)
						nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
						nID_Detail_INCOMING = PrepareSQLnum(tmpStkProc.ID_Detail,'ID_Detail',-3)
						lFound_STK_History  = Has_ID_Detail_History(nID_Detail_INCOMING, ThisForm.cTBL, ThisForm.nConnhandle)
						lFoundOldPrc = .T.
					CASE tmpStkProc.Process_ID = 'NOT2HPA' 
						lNOT2HPA = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_S_QTY 	= PrepareSQLnum(tmpStkProc.Prc_S_QTY,'Prc_S_QTY',-5)
						nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
						nID_Detail_INCOMING = PrepareSQLnum(tmpStkProc.ID_Detail,'ID_Detail',-3)
						lFound_STK_History  = Has_ID_Detail_History(nID_Detail_INCOMING, ThisForm.cTBL, ThisForm.nConnhandle)
						lFoundOldPrc = .T.
					CASE tmpStkProc.Process_ID = 'PARTRECV' 
						lPARTRECV = .T.
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_S_QTY 	= PrepareSQLnum(tmpStkProc.Prc_S_QTY,'Prc_S_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					CASE tmpStkProc.Process = 'Original'
						nPO_OrigQTY  = PrepareSQLnum(tmpStkProc.QTY,'QTY',-5)
						nPrc_S_QTY 	= PrepareSQLnum(tmpStkProc.Prc_S_QTY,'Prc_S_QTY',-5)
						*nID_Detail_Process = PrepareSQLnum(tmpStkProc.ID_Detail_Process,'ID_D_P',-3)
					ENDCASE
				ENDSCAN
		
			ENDIF
			USE IN tmpStkProc
		ENDIF
		
		PRIVATE lCommit, lOK, cBadMess
		lCommit = .T.
		lOK = .T.
		cBadMess = ''
		PRIVATE nRcv_QTY, nID_INCOMING
		nRcv_QTY = PrepareSQLnum(ThisForm.txtPShip_QTY.Value,'QTY',-5)
		nID_INCOMING = 0
		
		*************************
		DO CASE
		CASE cWhat = "CMPLT"
			IF lFoundOldPrc 
				IF nID_Detail_INCOMING = 0
					*Get ID_Detail FROM history='New Partial Receive ' 
					
					cSQL = "SELECT TOP 1 M.ID, D.ID_Detail "
					DO CASE
					CASE ThisForm.cTBL = "S"
						cSQL = cSQL + " FROM dbo.Stocklst_Master WITH(NOLOCK) M "
						cSQL = cSQL + " INNER JOIN dbo.Stocklst_Detail WITH(NOLOCK) D ON M.ID=D.ID "
					CASE ThisForm.cTBL = "B"
						cSQL = cSQL + " FROM dbo.BrokerLst_Master WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.Stocklst_Detail WITH(NOLOCK) D ON M.ID=D.ID "
					CASE ThisForm.cTBL = "W"
						cSQL = cSQL + " FROM dbo.WIPLst_Master WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.Stocklst_Detail WITH(NOLOCK) D ON M.ID=D.ID "
					ENDCASE
					IF Proper_PO_item(ThisForm.cPOitem) <> Proper_PO_Item('')
					* WHERE history='New Partial Receive '
						cSQL = cSQL + " WHERE M.PO_Item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
						IF ThisForm.nWO_Detail > 0
							cSQL = cSQL + " AND M.WO_Detail = "+STR(ThisForm.nWO_Detail)
						ENDIF
					ELSE
						IF ThisForm.nWO_Detail > 0
							cSQL = cSQL + " WHERE M.WO_Detail = "+STR(ThisForm.nWO_Detail)
						ELSE
							cSQL = cSQL = " WHERE 0>0 "
						ENDIF
					ENDIF
					cSQL = cSQL + " AND M.history='New Partial Receive ' ORDER BY M.ID DESC "
					
					IF USED('tmpStkProc')
						USE IN tmpStkProc
					ENDIF
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkProc')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkProc")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkProc")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStkProc')
						RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
					ENDIF
		
					IF USED('tmpStkProc')
						IF RECCOUNT('tmpStkProc') > 0
							nID_INCOMING		= tmpStkProc.ID 
							nID_Detail_INCOMING = tmpStkProc.ID_Detail
							*nID_INCOMING 	= get_ID_Master_with_ID_Detail(nID_Detail_INCOMING, ThisForm.cTBL, ThisForm.nConnhandle)
						ENDIF
					ENDIF
				ENDIF
				
				*Need to mark INCOMING as RECEIVED
				*nID_Detail_Process
				*nID_Detail_INCOMING
				
				IF lOK
					*update the Detail Process
					**********************
					IF nID_Detail_Process > 0	
						*UPDATE ID_Detail Process as Received
										
						cSQL = " UPDATE "
						DO CASE
						CASE ThisForm.cTBL = "S"
							cSQL = cSQL + " dbo.StockLst_Process "
						CASE ThisForm.cTBL = "B"
							cSQL = cSQL + " dbo.BrokerLst_Process "
						CASE ThisForm.cTBL = "W"
							cSQL = cSQL + " dbo.WIPLst_Process "
						OTHERWISE
							RETURN .F.
						ENDCASE
						cSQL = cSQL + " SET [Process_ID]='RECEIVED' "
						cSQL = cSQL + " ,QTY = "+STR(nRcv_QTY)
						cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
						ENDIF		
					ELSE
					
						*Insert Stock_Process_INS
						
						PRIVATE nQTY, nPounds, cPrc_Form, nPrc_PCs 
						nQTY = PrepareSQLnum(ThisForm.txtRecv_QTY.Value,'QTY',-5)
		
						nPounds = PrepareSQLnum(ThisForm.txtPShip_LBS.Value,'Pounds',-3)
						cPrc_Form = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
						nPrc_PCs = PrepareSQLnum(ThisForm.txtPShip_PC.Value,'PC',-3)
		
		
						cSQL = " INSERT INTO "
						DO CASE
						CASE ThisForm.cTBL = "S"
							cSQL = cSQL + " dbo.StockLst_Process "
						CASE ThisForm.cTBL = "B"
							cSQL = cSQL + " dbo.BrokerLst_Process "
						CASE ThisForm.cTBL = "W"
							cSQL = cSQL + " dbo.WIPLst_Process "
						ENDCASE
						
		*!*					cSQL=cSQL+"( [SOitem],[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment],[Process_ID]"
		*!*					cSQL=cSQL+",[Processor],[AllowSub],[PU],[QTY],[Ordered_QTY],[Ordered_P],[Pounds]"
		*!*					cSQL=cSQL+",[ID_Detail],[ReceivingID],[WO],[WO_Detail]"
		*!*					cSQL=cSQL+",[InqNumP],[Prc_Form],[Prc_PCs],[Prc_Dim1]"
		*!*					cSQL=cSQL+",[Prc_Dim2],[Prc_Dim3],[Prc_S_QTY],[Prc_Q_PU]"
		
						cSQL=cSQL+"( PO_item"
						cSQL=cSQL+",[Process_ID]"
						cSQL=cSQL+",[QTY],[Pounds]"
						cSQL=cSQL+",ID_Detail "
						cSQL=cSQL+",ReceivingID "
						cSQL=cSQL+",WO_Detail" 
						cSQL=cSQL+",[Prc_Form],[Prc_PCs]"
										
					 	cSQL=cSQL+" ) VALUES ("
					 	cSQL=cSQL+"'"+ThisForm.cPOitem+"'"
					 	cSQL=cSQL+",'RECEIVED' "
					 	cSQL=cSQL+","+STR(nQTY,18,4)+","+STR(nPounds,8,1)
					 	cSQL=cSQL+","+STR(nID_Detail_INCOMING)
					 	cSQL=cSQL+","+STR(nReceivingID)
					 	cSQL=cSQL+STR(ThisForm.nWO_Detail)
					 	cSQL=cSQL+",'"+cPrc_Form+"',"+STR(nPrc_PCs)
					 	cSQL=cSQL+")"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
							*lCommit = .F.
							*lOK = .F.
							cBadMess = cBadMess + "Could not Insert the new 'Received' Process record "+CHR(13)
						ENDIF
						
					ENDIF
				ENDIF
				
				***************************************************************************
				IF lOK AND NOT lFound_STK_History
					*update the Detail
					**********************
					IF nID_Detail_INCOMING > 0	
						*UPDATE ID_Detail with the current data!  
						
						PRIVATE nPC_Recv, nActualW, nRcv_QTY, nS_P, nS_Total
						nPC_Recv	= PrepareSQLnum(ThisForm.txtPShip_PC.Value,'Pieces',-3)
						nActualW	= PrepareSQLnum(ThisForm.txtPShip_LBS.Value,'ActualW',9,1)	
						nRcv_QTY	= PrepareSQLnum(ThisForm.txtPShip_QTY.Value,'QTY',-5)
						nS_P		= PrepareSQLnum(ThisForm.txtS_P.Value,'S_P',-5)
						nS_Total	= nRcv_QTY * nS_P
		
						DO CASE
						CASE ThisForm.cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Detail SET "
						CASE ThisForm.cTBL = "B"
							cSQL = "UPDATE dbo.BrokerLst_Detail SET "
						CASE ThisForm.cTBL = "W"
							cSQL = "UPDATE dbo.WIPLst_Detail SET "
						ENDCASE
									
						cSQL = cSQL+ " PC="+STR(nPC_Recv)+""
						cSQL = cSQL+ ",Weight="+STR(nActualW,18,4)+""
						cSQL = cSQL+ ",ReceivingID="+STR(ThisForm.nReceivingID)
						cSQL = cSQL+ ",InvCheck=GetDate()" &&+"'"+DTOC(DATE())+"'"
						cSQL = cSQL+ ",S_QTY = " + STR(nRcv_QTY,18,4) + ""
						cSQL = cSQL+ ",S_P = "+STR(nS_P,18,4)
						cSQL = cSQL+ ",S_Total = "+STR(nS_Total,18,4)
						cSQL = cSQL+ ",Prime = 1"
						
						cSQL  = cSQL+ " WHERE ID_Detail="+STR(nID_Detail_INCOMING)
					
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
							lCommit = .F.
							lOK = .F.
							cBadMess = cBadMess + "Could not Update the new Detail record "+CHR(13)
						ENDIF
					
					ENDIF
				ENDIF
				
				***************************************************************************
				IF lOK AND NOT lFound_STK_History
					**Update the Master
					
					nID_INCOMING = get_ID_Master_with_ID_Detail(nID_Detail_INCOMING, ThisForm.cTBL, ThisForm.nConnhandle)
					
					IF nID_INCOMING = 0
						nID_INCOMING = Get_ID_Master_by_ReceivingID(ThisForm.nReceivingID, ThisForm.cTBL, ThisForm.nConnhandle)
					ENDIF
					
					IF nID_INCOMING > 0
						
						PRIVATE cHeat, cLot, cPOitem, nFrom_ID, nWO_Detail
						cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
						cLot	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
						cPOitem = PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)
						nFrom_ID = 0 
						nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3)
						
						DO CASE
						CASE ThisForm.cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Master SET "
						CASE ThisForm.cTBL = "B"
							cSQL = "UPDATE dbo.BrokerLst_Master SET "
						CASE ThisForm.cTBL = "W"
							cSQL = "UPDATE dbo.WIPLst_Master SET "
						ENDCASE
						
						cSQL = cSQL +" Heat = '"+cHeat+"'"
						cSQL = cSQL +",Lot = '"+cLot+"'"
						cSQL = cSQL +",StkDate='"+TTOC(DATETIME())+"'"
						cSQL = cSQL +",POStatus = 'W'"
						IF cPOitem <> Proper_PO_item('')
							cSQL = cSQL+",PO_item = '"+cPOitem+"'"
						ENDIF
						IF nWO_Detail > 0
							cSQL = cSQL + ",WO_Detail = "+STR(nWO_Detail)
						ENDIF
						cSQL = cSQL + ",From_ID="+STR(nFrom_ID)
						cSQL = cSQL +" WHERE ID ="+STR(nID_INCOMING)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
							lCommit = .F.
							lOK = .F.
							cBadMess = cBadMess + "Could not Update Master "+CHR(13)
						ENDIF
					ENDIF
				ENDIF
				
				***************************************************************************
				IF lOK AND nID_INCOMING > 0 AND nID_Detail_INCOMING > 0 AND ThisForm.nReceivingID > 0
				
					*Update Receiving
					cSQL = "UPDATE dbo.Receiving "
					cSQL = cSQL +" SET StockTable = '"+ThisForm.cTBL +"'"
					cSQL = cSQL +",ID_Master = "+STR(nID_INCOMING)
					cSQL = cSQL +",ID_Detail = "+STR(nID_Detail_INCOMING)
					cSQL = cSQL +" WHERE ID ="+STR(ThisForm.nReceivingID)
					cSQL = cSQL +" AND ISNULL(ID_Master,0) = 0"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
				ENDIF	
				 
			ENDIF
			
		CASE cWhat = "EDIT"
		
		CASE cWhat = "NOT_CMPLT"
		
		OTHERWISE
			*Did not get good Parameter!
			TrackError("cWhat needs to be 'CMPLT', 'EDIT' OR 'NOT_CMPLT'","PARAMETERS pWhat", PROGRAM(), LINENO(1))
		ENDCASE
		
		RETURN .T.
	ENDPROC

	PROCEDURE copy_selectedprc
		PARAMETERS nOld_ID_Detail, nNewID_Detail
		*ThisForm.Copy_SelectedPrc
		
		PRIVATE cSQL, lOK
		lOK = .T.
		
		*PRIVATE nID_Detail_Prc
		**Check for Incoming Process to copy, may have to insert.
		*nID_Detail_Prc = Get_ID_Detail_Prc_by_ID_Detail(nOld_ID_Detail,ThisForm.cTBL,'INCOMING',ThisForm.nConnHandle)
		
		IF nOld_ID_Detail*nNewID_Detail > 0
			cSQL = "INSERT INTO "
			DO CASE
			CASE ThisForm.cTBL= "S"
				cSQL=cSQL+" dbo.StockLst_Process ("
			CASE ThisForm.cTBL= "B"
				cSQL=cSQL+" dbo.BrokerLst_Process ("
			CASE ThisForm.cTBL = "W"
				cSQL=cSQL+" dbo.WIPLst_Precess ("
			ENDCASE
			cSQL=cSQL+"[SOitem],[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment],[Process_ID]"
			cSQL=cSQL+",[Processor],[AllowSub],[PU],[QTY],[Ordered_QTY],[Ordered_P],[Pounds]"
			cSQL=cSQL+",[ID_Detail]"
		*	cSQL=cSQL+"--,[ID_Detail_Process]"
		 	cSQL=cSQL+",[ReceivingID],[WO],[WO_Detail]"
			cSQL=cSQL+",[InqNumP],[Prc_Form],[Prc_PCs],[Prc_Dim1]"
			cSQL=cSQL+",[Prc_Dim2],[Prc_Dim3],[Prc_S_QTY],[Prc_Q_PU]"
		 	cSQL=cSQL+" ) "
			cSQL=cSQL+" SELECT [SOitem],[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment],[Process_ID]"
			cSQL=cSQL+",[Processor],[AllowSub],[PU]"
			cSQL=cSQL+",[QTY]"	&&QTY needed
			cSQL=cSQL+",[Ordered_QTY],[Ordered_P]"
			cSQL=cSQL+",[Pounds]" &&Pounds Needed
			cSQL=cSQL+","+STR(nNewID_Detail)
		*	cSQL=cSQL+"--,[ID_Detail_Process]"
			cSQL=cSQL+" ,[ReceivingID],[WO],[WO_Detail]"
			cSQL=cSQL+" ,[InqNumP],[Prc_Form],[Prc_PCs],[Prc_Dim1]"
			cSQL=cSQL+" ,[Prc_Dim2],[Prc_Dim3],[Prc_S_QTY],[Prc_Q_PU]"
			DO CASE
			CASE ThisForm.cTBL= "S"
				cSQL=cSQL+ " FROM dbo.StockLst_Process "
			CASE ThisForm.cTBL= "B"
				cSQL=cSQL+ " FROM dbo.BrokerLst_Process "
			CASE ThisForm.cTBL = "W"
				cSQL=cSQL+ " FROM dbo.WIPLst_Precess "
			ENDCASE
			cSQL=cSQL+" WHERE ID_Detail="+STR(nOld_ID_Detail)
			cSQL=cSQL+" AND [Process_ID]='SELECTED'"
			*cSQL=cSQL+" AND [AllowSub]='N'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
				lOK = .F.
				TrackError("Could not Insert copy of 'SELECTED' into new ID_Detail_Process ","SELECTED ID_Detail_Process", PROGRAM(), LINENO(1))
			ENDIF
		
		ENDIF
		
		RETURN lOK
	ENDPROC

	PROCEDURE create_incoming_process
		PARAMETERS cnNewTBL, nNewID, nNewID_Detail, nOld_ID, nOld_ID_Detail
		*THISFORM.Create_Incoming_Process(cTBL,nTableID_Detail,nPounds)
		*creates an INCOMING process for the NEW balance due Stock entry
		*Returns nID_Detail_Process
		
		*IF VARTYPE(ThisForm.cTBL)!="C"
		*	TrackError("Receiving:Receiving_Create_Incoming_Process(cTBL:NO TABLE ,nID_Detail:"+STR(nID_Detail)+",nPounds"+")" ,"bad variable",PROGRAM(),LINENO(1))
		*	ThisForm.cTBL = "N"
		*	RETURN 0
		*ENDIF
		
		PRIVATE nID_Detail,cSOitem,cPOitem,nReceivingID
		nID_Detail = ThisForm.nID_Detail
		cSOitem = Proper_SO_item(ThisForm.cSOitem)
		cPOitem = Proper_PO_item(ThisForm.cPOitem)
		nReceivingID = ThisForm.nReceivingID
		
		
		IF nID_Detail = 0
			*nID_Detail = get_ID_Detail_with_SOitem(cSOitem, ThisForm.cTBL, "", ThisForm.nConnHandle)
			TrackMess("Show Received VS Ordered:Create_Incoming_Process(TBL:"+ThisForm.cTBL+",nID_Detail:"+STR(nID_Detail)+",cSOitem:"+cSOitem+",pPOitem:"+cPOitem+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
			RETURN 0
		ENDIF
		
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisForm.nReceivingID,'ReceivingID',-3)
		IF nReceivingID < 1
			*need ReceivingID
			*POitem is too vague
			RETURN .F.
		ENDIF
		
		*PRIVATE lTranAlreadySet, nProp, lOK 
		*nProp = SQLGETPROP(nConn, 'Transactions')
		*lTranAlreadySet = (nProp = 2)
		*lOK = .T.
		PRIVATE nQTY_Need, nLBS_Need, nPC_Need
		nQTY_Need	= PrepareSQLnum(ThisForm.txtQTY_Need.Value,'QTY',-5)
		nLBS_Need	= PrepareSQLnum(ThisForm.txtLBS_Need.Value,'Pounds',8,1)
		nPC_Need	= PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC',-3)
		
		PRIVATE cSalesPerson
		IF ThisForm.nWO_Detail > 0
			cSalesPerson = " HPA Shop WO"
		ELSE
			cSalesPerson = PrepareSQLtxt( AppSetup_Get_UserName( getSalesP_POitem( cPOitem, ThisForm.nConnHandle )),'SalesPerson', 20)
		ENDIF
		
		PRIVATE nWO, cProcess_ID, cProcessor, cComment
		nWO = 0 
		*nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3)
		cProcess_ID = "INCOMING"
		cProcessor	= LEFT( SUBSTR(SYS(0), AT("#",SYS(0))+1 ), 20)
		cComment 	= "Created INCOMING process with Received VS Ordered"
		
		PRIVATE cPrc_Form, nPU, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nPU 	= nPU_Acct_Form(cPrc_Form ,ThisForm.nConnHandle)
		nPrc_Dim1	= PrepareSQLnum(ThisForm.txtThck.Value,'DIM1',10,4)
		nPrc_Dim2	= PrepareSQLnum(ThisForm.txtSz2.Value,'DIM2',9,3)
		nPrc_Dim3	= PrepareSQLnum(ThisForm.txtSz3.Value,'DIM3',9,3)
		
		IF ThisForm.nWO_Detail > 0
			nOrdered_QTY = Get_From_WO_Detail(ThisForm.nWO_Detail,'fWeight',ThisForm.nConnHandle)
			nOrdered_P = 0
		ENDIF
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			nOrdered_QTY = Get_From_POitem(cPOitem, "StockLst_QTY", ThisForm.nConnHandle )
			nOrdered_P = Get_From_POitem(cPOitem, "StockLst_P", ThisForm.nConnHandle )
		ENDIF
		
		PRIVATE cAllowSub, dStartDate, dDueDate, nID_Detail_Process 
		cAllowSub	= "N"
		dtStartDate	= DATETIME()
		dDueDate	= DATE()
		nID_Detail_Process = 0
		
		IF Proper_PO_item(cPOitem)=Proper_PO_item("")
			cProcess_ID		= "INCOMING"  
		ELSE
			PRIVATE nShipWhere
			nShipWhere = Get_From_POitem(cPOitem,"ShipWhere",ThisForm.nConnHandle)
			IF nShipWhere = 1 OR nShipWhere = 5
				cProcess_ID		= "INCOMING"  
			ELSE
				cProcess_ID 	= 'NOT2HPA'
			ENDIF
		ENDIF
		
		*!*	*****************************
		*!*	*Check for Existing 'INCOMING'
		
		*!*	IF USED('tmpShow_SOi_IDDP')
		*!*		USE IN tmpShow_SOi_IDDP
		*!*	ENDIF
		*!*	SELECT 0
		
		*!*	cSQL = "SELECT ID_Detail_Process FROM "
		*!*	*DO CASE
		*!*	*CASE ThisForm.cTBL = "S"
		*!*		cSQL = cSQL + " dbo.StockLst_Process WITH(NOLOCK) "
		*!*	*CASE ThisForm.cTBL = "B"
		*!*	*	cSQL = cSQL + " dbo.BrokerLst_Process WITH(NOLOCK) "
		*!*	*CASE ThisForm.cTBL = "W"
		*!*	*	cSQL = cSQL + " dbo.WIPLst_Process WITH(NOLOCK) "
		*!*	*ENDCASE
		
		*!*	cSQL = cSQL + " WHERE ID_Detail = "+STR(nOld_ID_Detail)+""
		*!*	cSQL = cSQL + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'NOT2HPA' OR Process_ID = 'PARTRECV' )"
		*!*	*cSQL = cSQL + " AND ReceivingID = 0"
		*!*	*cSQL = cSQL + " AND PO_Item = '"+cPoItem+"'"
		
		*!*	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOi_IDDP')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOi_IDDP')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOi_IDDP")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOi_IDDP")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShow_SOi_IDDP')
		*!*		RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*	ENDIF
		
		IF USED('tmpShow_SOi_IDDP')
			IF RECCOUNT('tmpShow_SOi_IDDP') > 0
				nID_Detail_Process  = PrepareSQLnum(tmpShow_SOi_IDDP.ID_Detail_Process,'ID_Detail_Process',-3)
			ENDIF
			USE IN tmpShow_SOi_IDDP
			RETURN nID_Detail_Process
		ENDIF
		
		
		******************************
		
		IF Proper_PO_item(cPoItem) <> Proper_PO_item('')
			IF USED('tmpShow_SOi_QTY')
				USE IN tmpShow_SOi_QTY
			ENDIF
			SELECT 0
		
			cSQL = "SELECT StockLst_QTY, StockLst_P, dbo.f_GetFormPU(Form) AS S_PU"
			cSQL = cSQL + " ,Due_Min,Due_Max "
			cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPoItem+"')" 
			cSQL = cSQL + " AND ISNULL(Reconciled,0)=0"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOi_QTY')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOi_QTY')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOi_QTY")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOi_QTY")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShow_SOi_QTY')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		
			IF USED('tmpID_Detail_Process')
				IF RECCOUNT('tmpID_Detail_Process') > 0
		*			nQTY = PrepareSQLnum(tmpID_Detail_Process.StockLst_QTY,'S_QTY',-5)
					nP   = PrepareSQLnum(tmpID_Detail_Process.StockLst_P,'S_P',-5)
					nPU  = PrepareSQLnum(tmpID_Detail_Process.S_PU,'PU',-1)
					dDueDate = PrepareSQLdate(tmpID_Detail_Process.Due_Max,'Due_Max')
					IF EMPTY(dDue_Max)
						dDueDate = PrepareSQLdate(tmpID_Detail_Process.Due_Min,'Due_Min')
					ENDIF
				ENDIF
				USE IN tmpID_Detail_Process
			ENDIF
		ENDIF
		
		******************************
		*Look for UNReconciled WO_Detail
		IF ThisForm.nWO_Detail > 0
			IF USED('tmpShow_SOi_QTY')
				USE IN tmpShow_SOi_QTY
			ENDIF
			SELECT 0
		
			cSQL = "SELECT fWeight AS StockLst_QTY, 0 AS StockLst_P, dbo.f_GetFormPU(fForm) AS S_PU"
			cSQL = cSQL + " ,dDue_Date AS Due_Min, fFinishDate AS Due_Max "
			cSQL = cSQL + " FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)
			cSQL = cSQL + " AND ISNULL(fReconciled,0)=0"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOi_QTY')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOi_QTY')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOi_QTY")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOi_QTY")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpShow_SOi_QTY')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		
			IF USED('tmpID_Detail_Process')
				IF RECCOUNT('tmpID_Detail_Process') > 0
		*			nQTY = PrepareSQLnum(tmpID_Detail_Process.StockLst_QTY,'S_QTY',-5)
					nP   = PrepareSQLnum(tmpID_Detail_Process.StockLst_P,'S_P',-5)
					nPU  = PrepareSQLnum(tmpID_Detail_Process.S_PU,'PU',-1)
					dDueDate = PrepareSQLdate(tmpID_Detail_Process.Due_Max,'Due_Max')
					IF EMPTY(dDue_Max)
						dDueDate = PrepareSQLdate(tmpID_Detail_Process.Due_Min,'Due_Min')
					ENDIF
				ENDIF
				USE IN tmpID_Detail_Process
			ENDIF
		ENDIF
		
		
		******************************
		IF nQTY_Need = 0
			SELECT Receiving
			*TrackMess("Show Received VS Ordered:Create_Incoming_Process(TBL:"+ThisForm.cTBL+",nID_Detail:"+STR(nID_Detail)+",cSOitem:"+cSOitem+",pPOitem:"+cPOitem+")"+CHR(10)+"TableID_Detail is from get_ID_Detail_with_SOitem() search." )
			RecordError( 0, 'No QTY', PROGRAM(), LINENO(),"No QTY to Create Process" )
			RETURN 0
		ENDIF
		*****************************nQTY_Need, nLBS_Need, nPC_Need
		
		IF USED('tmpID_Detail_Process')
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		cSQLi = "EXEC dbo.p_Lst_Process_ins "
		cSQLi = cSQLi + " @TBL = 'S'"
		cSQLi = cSQLi + ",@ID_Detail ="+STR(nOld_ID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@Startdate = '"+IIF(EMPTY(dtStartDate),TTOC(DATETIME()),TTOC(dtStartDate))+"'"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = 'N'"	&&+cAllowSub+"'"   &&Incoming is not allowed to SUB
		
		cSQLi = cSQLi + ",@PU	= "+STR(nPU)
		cSQLi = cSQLi + ",@QTY	= "+STR(nQTY_Need,18,4)
		cSQLi = cSQLi + ",@Pounds ="+STR(nLBS_Need,9,1)
		
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		cSQLi = cSQLi + ",@WO 	= "+STR(0)
		cSQLi = cSQLi + ",@WO_Detail= "+STR(ThisForm.nWO_Detail)
		
		cSQLi = cSQLi + ",@Process_ID = 'INCOMING'"	&&+cProcess_ID+"'"  
		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		cSQLi = cSQLi + ",@ReceivingID =0" &&+STR(nReceivingID) This is the new INCOMING
		
		cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
		cSQLi = cSQLi + ",@Prc_PCs = "+STR(nPC_Need)
		cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
		cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
		cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
		cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nOrdered_QTY,18,4)
		cSQLi = cSQLi + ",@Ordered_P = "+STR(nOrdered_P,18,4)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.EXP,'ID_Detail_Process',-3)
				IF nID_Detail_Process > 0
		
					PRIVATE cText
					cText = "INFO: Created Incoming Process "+STR(nID_Detail_Process)+" Show_Ship_Order.Create_Incoming_Process "+" StockTable="+ThisForm.cTBL+CHR(13)
					IF Proper_PO_item(cPOitem)<>Proper_PO_item("")
						cText = cText +" PO item="+cPOitem
					ENDIF
					IF ThisForm.nWO_Detail > 0
						cText = cText +" WO Detail="+ALLTRIM(STR(ThisForm.nWO_Detail))
					ENDIF
					*cText = cText +" Process_ID = '"+cProcess_ID+"'"  
					MESSAGEBOX( cText,0+48,"INFO: Created Balance of INCOMING Process After ReceivingID "+ALLTRIM(STR(nReceivingID)) )
					TrackMess(cText)
				ENDIF
		
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		SELECT Receiving
		RETURN nID_Detail_Process 
	ENDPROC

	PROCEDURE create_partial_stock
		*!*	*ThisForm.Create_Partial_Stock()
		*!*		*INSERT
		*!*		
		*!*		IF USED('tmpID_Master')
		*!*			USE IN tmpID_Master
		*!*		ENDIF
		
		*!*		cSQLi = "EXEC dbo.p_BrokerLst_Master_ins2 "
		*!*		cSQLi = cSQLi+ " @Alloy ='"+cAlloy+"'"   &&NOT NULL
		*!*		cSQLi = cSQLi+ ",@Form ='"+cForm+"'"   &&NOT NULL
		*!*		cSQLi = cSQLi+ ",@CC ='"+cCC+"'"
		*!*		cSQLi = cSQLi+ ",@Size ="+STR(nThck,9,3)+""   &&NOT NULL
		*!*		cSQLi = cSQLi+ ",@Cond ='"+cCond+"'"   &&NOT NULL
		*!*		cSQLi = cSQLi+ ",@MWeight ="+STR(nStockLst_QTY,18,4)+"" &&Init with 0 **STR(IIF(ISNULL(mweight),0,mweight),9,2)+""
		*!*		cSQLi = cSQLi+ ",@Specs ='"+cSpecs+"'"
		*!*		cSQLi = cSQLi+ ",@Heat ='"+'Due In'+"'"   &&NOT NULL
		*!*		cSQLi = cSQLi+ ",@Lot =''"
		*!*		cSQLi = cSQLi+ ",@Paid ="+STR(nStockLst_P,18,4)+""
		*!*		cSQLi = cSQLi+ ",@PO_Item ='"+cPoItem+"'"
		*!*		cSQLi = cSQLi+ ",@PODueDate ='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		*!*		cSQLi = cSQLi+ ",@Mill =''"
		*!*		cSQLi = cSQLi+ ",@StkDate =''"
		*!*		cSQLi = cSQLi+ ",@History =''"
		*!*		cSQLi = cSQLi+ ",@Num = 0"
		*!*		cSQLi = cSQLi+ ",@POStatus ='D'"
		*!*		cSQLi = cSQLi+ ",@BrandName ='"+cBrandName+"'"
		*!*		cSQLi = cSQLi+ ",@From_ID =0"
		*!*		cSQLi = cSQLi+ ",@Melt='"+cMelt+"'"
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
		*!*		ENDDOIF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*		IF nSQLEXEC < 1
		*!*			SQLEXECError(cSQLi,ThisForm.nConnHandle)
		*!*			nMaster_ID = 0
		*!*			lSQLgood = .F.
		*!*		ELSE
		*!*			IF USED('tmpID_Master')
		*!*				nMaster_ID = tmpID_Master.EXP
		*!*				USE IN tmpID_Master
		*!*				
		*!*				IF nMaster_ID > 0
		*!*					cSQL_M_Update = "UPDATE dbo.BrokerLst_Master SET "
		*!*					cSQL_M_Update = cSQL_M_Update +" CL ='"+cCL+"'"
		*!*					cSQL_M_Update = cSQL_M_Update +" WHERE ID = "+STR(nMaster_ID )
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
		*!*					ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL_Detail_Update,ThisForm.nConnHandle,nSQLEXEC )
		*!*						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL_Detail_Update)
		*!*					ENDIF
		*!*				
		*!*				ENDIF
		*!*			ELSE
		*!*				nMaster_ID = 0
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*	 	IF nMaster_ID > 0
		*!*			*INSERT Detail
		
		*!*			IF USED('tmpID_Detail')
		*!*				USE IN tmpID_Detail
		*!*			ENDIF
		*!*			SELECT 0
		
		*!*			cSQLi = "EXEC dbo.p_BrokerLst_Detail_ins "
		*!*			cSQLi = cSQLi + " @size_h ="+'NULL'
		*!*			cSQLi = cSQLi + ",@size_l ="+'NULL'
		*!*			cSQLi = cSQLi + ",@pc ="+ STR(nPieces,10,0)
		*!*			cSQLi = cSQLi + ",@dim1 =" + STR(IIF(ISNULL(nThck),0,nThck),18,4)
		*!*			cSQLi = cSQLi + ",@dim2 =" + STR(IIF(ISNULL(nSz2),0,nSz2),18,4)
		*!*			cSQLi = cSQLi + ",@dim3 =" + STR(IIF(ISNULL(nSz3),0,nSz3),18,4)
		*!*			cSQLi = cSQLi + ",@length ="+"'Listing created from new PO:"+ALLTRIM(STR(nHpaPo))+" needed for a SO:"+ALLTRIM(STR(nSalesNum))+".'"
		*!*			cSQLi = cSQLi + ",@weight =" + STR(nPounds,9,2)
		*!*			cSQLi = cSQLi + ",@costvalue =" + STR(IIF(ISNULL(nStockLst_P),0,nStockLst_P),18,4)
		*!*			cSQLi = cSQLi + ",@descript ='"+"'"
		*!*			cSQLi = cSQLi + ",@location ='"+"'"
		*!*			cSQLi = cSQLi + ",@floorstatus ='"+"'"
		*!*			cSQLi = cSQLi + ",@class ='"+"'"
		*!*			cSQLi = cSQLi + ",@unit ='"+cLstDetailUnit+"'"
		*!*			cSQLi = cSQLi + ",@RandLen ="+IIF(lRandLen,"1","0")	&&'"+"'"
		*!*			cSQLi = cSQLi + ",@ID ="+STR(nMaster_ID )
		*!*			cSQLi = cSQLi + ",@ID_Detail_Process ="+STR(nID_Detail_Process)
		
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail')
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLi,ThisForm.nConnHandle)
		*!*				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi)
		*!*				lSQLgood = .F.
		*!*			ELSE
		*!*				IF USED('tmpID_Detail')
		*!*					nID_Detail = tmpID_Detail.EXP
		*!*					USE IN tmpID_Detail
		
		*!*					*Now update what does not fit in SP p_StockLst_Detail_ins
		*!*					cSQL_Detail_Update = "UPDATE dbo.BrokerLst_Detail SET "
		*!*					cSQL_Detail_Update = cSQL_Detail_Update +" location ='"+cShipLocation+"'"
		
		*!*					cSQL_Detail_Update = cSQL_Detail_Update +",S_QTY = " 	+ STR(nStockLst_QTY,18,4) + ""
		*!*					cSQL_Detail_Update = cSQL_Detail_Update +",S_P = " 		+ STR(nStockLst_P,18,4) + ""
		*!*					cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = "  + STR(nS_Total,18,4) + ""
		*!*					cSQL_Detail_Update = cSQL_Detail_Update +",S_PU = " 	+ STR(nS_PU) + ""
		
		*!*					cSQL_Detail_Update = cSQL_Detail_Update +" WHERE ID_Detail = "+STR(nID_Detail)
		
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
		*!*					ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL_Detail_Update,ThisForm.nConnHandle,nSQLEXEC )
		*!*						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL_Detail_Update)
		*!*					ENDIF
		
		*!*				ELSE
		*!*					*Insert Failed
		*!*					SQLEXECError(cSQLi,ThisForm.nConnHandle)
		*!*					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
		*!*					lSQLgood = .F.
		*!*					MESSAGEBOX('Could not SAVE detail',0,'Error')
		*!*				ENDIF
		*!*			ENDIF	
		*!*		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE del_incomproc
		*ThisForm.Del_IncomProc()
		
		*ThisForm.nReceivingID2 is filled by Update_PO Status()
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisForm.nReceivingID,'ReceivingID',-3)
		
		IF nReceivingID < 1
			*Only Incoming Process with ReceivingID will be deleted.
			*POitem is too vague
			RETURN .F.
		ENDIF
		
		*cSQL = " DELETE FROM "
		cSQL = " UPDATE "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		OTHERWISE
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " SET [Process_ID]='RECEIVED' "
		*cSQL = cSQL + " WHERE ( PO_item = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
		*IF nReceivingID2 > 0
		*	cSQL = cSQL + " OR ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL + " WHERE ReceivingID = "+STR(nReceivingID)
		*ENDIF
		*cSQL = cSQL + " ) "
		cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PartRecv' )"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pWhat, pOrder
		*DO FORM Forms\Show_Ship_Order WITH "SOitem",cSOitem ' 135518-01' to nReturn
		
		*pWhat = "SOitem"
		*pOrder = ' 135480-01'
		IF VARTYPE(pWhat) != "C"
			RETURN
		ENDIF
		
		DO CASE
		CASE pwhat = "SOitem"
			cSOitem = Proper_SO_item(pOrder)
			
		OTHERWISE
			TrackError("Show_Ship_Order bad parameter pWhat. INIT not programed for paramater.","Show_Ship_Order bad parameter", PROGRAM(), LINENO(1))
			ThisForm.nReturn = 0
			RETURN
			ThisForm.Release
		ENDCASE
		
		ThisForm.lblOrder.Caption = ALLTRIM(cSOitem)
		ThisForm.cSOitem = cSOitem
		ThisForm.nWO_Detail = 0
		ThisForm.lblOrderitem.Caption = "SO item"
		
		
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('') 
			*Good
		ELSE
			RecordTest('Record Test Data','Show_Ship_Order.INIT()',LINENO(1),"SOitem "+cSOitem )
		ENDIF
		
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "Select 0 "
		
		IF USED('tmpShow_SOi')	
			USE IN tmpShow_SOi
		ENDIF
		
		*DO CASE
		*CASE Proper_SO_item(cSOitem) <> Proper_SO_item('')
			cSQL = "SELECT AQ.*, dbo.f_DescriptCL(AQ.Alloy,AQ.CC,AQ.CL,AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen) AS DescriptCL "
			cSQL = cSQL+",S.*"
			cSQL = cSQL+" FROM dbo.AllQuotes AQ WITH(NOLOCK) "
			cSQL = cSQL+" inner join dbo.Sales S WITH(NOLOCK) ON AQ.SOitem = S.SOitem "
			cSQL = cSQL+" WHERE S.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*ENDCASE
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOi')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShow_SOi')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOi")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShow_SOi")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpShow_SOi')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		IF USED('tmpShow_SOi')	
			IF RECCOUNT('tmpShow_SOi') > 0
				ThisForm.txtCompany.Value	= tmpShow_SOi.Company
				ThisForm.txtAlloySO.Value	= tmpShow_SOi.Alloy
				ThisForm.txtForm.Value		= tmpShow_SOi.Form
				ThisForm.txtThck.Value		= tmpShow_SOi.Thck
				ThisForm.txtSz2.Value		= tmpShow_SOi.sz2
				ThisForm.txtSz3.Value		= tmpShow_SOi.sz3
				ThisForm.RefreshForms()
				
				ThisForm.txtS_Pcs.Value	= PrepareSQLnum(tmpShow_SOi.Pieces,'PCS',-3)
				ThisForm.txtS_QTY.Value		= PrepareSQLnum(tmpShow_SOi.S_QTY,'QTY',9,1)
				ThisForm.txtS_P.Value		= PrepareSQLnum(tmpShow_SOi.S_P,'S_P',-5)
				ThisForm.txtOrder_LBS.Value = PrepareSQLnum(tmpShow_SOi.Weight,'Weight',9,1)
				ThisForm.lblS_PU.Caption	= Get_PUstr_from_nPU(tmpShow_SOi.S_PU)
				
				ThisForm.chkServices.Value = PrepareSQLlogic(tmpShow_SOi.Services,'Services',.F.)
				ThisForm.chkRandom.Value = PrepareSQLlogic(tmpShow_SOi.RandLen,'RandLen',.F.)
				ThisForm.chkMetric.Value = PrepareSQLlogic(tmpShow_SOi.Metric,'Metric',.F.)
				
				PRIVATE lComplete, lCancel
				lComplete	= PrepareSQLlogic(tmpShow_SOi.cmplt,'Cmplt')
				ThisForm.chkComplete.Value	= lComplete
				lCancel	= PrepareSQLlogic(tmpShow_SOi.cncld,'Cncld')
				ThisForm.chkCancelled.Value = lCancel
				
				ThisForm.txtSO_Desc.Value = tmpShow_SOi.DescriptCL
				
				IF lComplete
					ThisForm.ogPOitem.Complete.Value = 1
					
				ELSE
					
					ThisForm.ogPOitem.NotDone.Value = 1
				ENDIF		
				
				IF lCancel
					ThisForm.cmdGood.Visible = .F.
					ThisForm.cmdJustEdit.Visible = .F.
					ThisForm.cmdGoodCmplt.Visible = .F.
				ENDIF
			ENDIF
			USE IN tmpShow_SOi
		ENDIF
		
		************************
		* Collect All Packing Slips for SOitem
		*
		IF USED('tmp_PShip_SOi')
			USE IN tmp_PShip_SOi
		ENDIF
		
		************************
		cSQL = "SELECT PS.[Weight]"
		cSQL = cSQL+" ,PS.[PT_QTY]"
		cSQL = cSQL+" ,PS.[Packingsli]"
		cSQL = cSQL+" ,PS.[PCs]"
		cSQL = cSQL+" ,PS.[Descript]"
		cSQL = cSQL+" ,PS.[SOitem]"
		cSQL = cSQL+" ,PS.[SO_QTY]"
		cSQL = cSQL+" ,PS.* "
		cSQL = cSQL+" ,PSN.* "
		cSQL = cSQL+"  FROM dbo.PackingSlip PS WITH(NOLOCK) "
		cSQL = cSQL+" inner join dbo.PackingSlip_No PSN WITH(NOLOCK) ON PS.Packingsli = PSN.Packingsli "
		*cSQL = cSQL+" --inner join dbo.Sales_Detail SD WITH(NOLOCK) ON PS.PackingSli = SD.PackingSli "
		cSQL = cSQL+" WHERE PS.SOitem = dbo.f_ProperSOitem('" +cSOitem+"')"
		cSQL = cSQL+" AND PS.Cancld = 0 "
		*' 135485-01'
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_PShip_SOi')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_PShip_SOi')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_PShip_SOi")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_PShip_SOi")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmp_PShip_SOi')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		ENDIF
		
		thisform.Visible = .T.
		
		PRIVATE m.nPast_LBS, m.nPast_PT_QTY, m.nPastSO_QTY, m.nPast_PCs
		m.nPast_LBS   = 0
		m.nPast_PT_QTY = 0
		m.nPastSO_QTY = 0
		m.nPast_PCs   = 0
		
		IF USED('tmp_PShip_SOi')	
			IF RECCOUNT('tmp_PShip_SOi') > 0
				SELECT tmp_PShip_SOi
				
				SET TALK OFF
				SUM PCs		TO m.nPast_PCs  
				SUM Weight	TO m.nPast_LBS 
				SUM PT_Qty	TO m.nPast_PT_QTY
				SUM SO_Qty	TO m.nPast_SO_QTY 
				
				
				
				ThisForm.txtPast_PCs.Value = ROUND(m.nPast_PCs,0)
				ThisForm.txtPast_PT_Qty.Value = PrepareSQLnum(m.nPast_PT_QTY,'QTY',9,1)
				*ThisForm.txtPast_SO_QTY.Value = PrepareSQLnum(m.nPast_SO_QTY,'QTY',9,1)	&&SO Ordered QTY
				ThisForm.txtPast_LBS.Value = ROUND(m.nPast_LBS,1)
				
				GO TOP
				
				
				ThisForm.grdPackingSlip.RecordSource = 'tmp_PShip_SOi'
		
		*			ThisForm.grdPackingSlip.SetAll("dynamicbackcolor","IIF(ID="+STR(nReceivingID)+",RGB(128,255,128),IIF(tmp_PShip_SOi.cancelled, RGB(255,255,255), RGB(0,205,128)))", "Column")
		*			ThisForm.grdPackingSlip.SetAll("dynamicbackcolor",IF(tmp_PShip_SOi.cancelled, RGB(255,255,255), RGB(0,205,128))", "Column")
				ThisForm.PShip_Refresh()
				ThisForm.grdPackingSlip.Visible = .T.
			ENDIF
			*USE IN tmp_PShip_SOi
		ENDIF
		
		***********************
		* Calc Diff
		*
		PRIVATE nPieces, nS_QTY, nOrder_LBS
		nPieces		= PrepareSQLnum(ThisForm.txtS_Pcs.Value,'PC',-3)
		nS_QTY 		= PrepareSQLnum(ThisForm.txtS_QTY.Value,'S_QTY',9,1)
		nOrder_LBS	= PrepareSQLnum(ThisForm.txtOrder_LBS.Value,'Pounds',9,1)
		*m.nPast_LBS, m.nPastPT_QTY, m.nPastSO_QTY, 
		
		PRIVATE nPC_Recv, nPC_Need
		nPC_Recv	= 0	&&PrepareSQLnum(ThisForm.txtPShip_PC.Value,'PC',-3)
		nPC_Need	= ROUND( nPieces - m.nPast_PCs, 0)
		
		PRIVATE nQTY_Recv, nQTY_Need 
		nQTY_Recv	= 0
		nQTY_Need 	= ROUND(nS_QTY - m.nPast_PT_QTY, 0)
		
		PRIVATE nLBS_Recv, nLBS_Need
		nLBS_Recv	= 0
		nLBS_Need	= ROUND( nOrder_LBS - m.nPast_LBS ,1)
		
		ThisForm.txtPC_Need.Value  = PrepareSQLnum(nPC_Need,'PC',-3)
		ThisForm.txtQTY_Need.Value = PrepareSQLnum(nQTY_Need,'S_QTY',9,1)
		ThisForm.txtLBS_Need.Value = PrepareSQLnum(nLBS_Need,'Pounds',9,1)
		
		****
		
		
		**************************
		
		PRIVATE cMess
		*Show Red if need more than 20% 
		IF nQTY_Need > 0
			IF m.nPast_PT_QTY *1.2 < nS_QTY
				cMess = "Shipping DID NOT complete SO QTY "+CHR(13)
				cMess = cMess+" --or even within 20% of being complete."+CHR(13)
				cMess = cMess+"Complete QTY: "+ALLTRIM(STR(nS_QTY))+CHR(13)+CHR(13)
				cMess = cMess+"Packed QTY: "+ALLTRIM(STR((m.nPast_PT_QTY)))+CHR(13)
		
				MESSAGEBOX(cMess,32,"QTY problem")
			
				ThisForm.lblOrder_QTY.BackColor = RGB(255,0,0)
				ThisForm.lblQTY_Diff.BackColor = RGB(255,0,0)
				lOrderItemDone = .F.
			ELSE
				IF m.nPast_PT_QTY *1.1 < nS_QTY
					cMess = "Shipping DID NOT complete SO QTY "+CHR(13)
					cMess = cMess+" --or even within 10% of being complete."+CHR(13)+CHR(13)
					cMess = cMess+" Order QTY: "+ALLTRIM(STR(nS_QTY))+CHR(13)+CHR(13)
					cMess = cMess+"Packed QTY: "+ALLTRIM(STR((m.nPast_PT_QTY)))+CHR(13)
		
					MESSAGEBOX(cMess,32,"QTY problem")
				
					ThisForm.lblOrder_QTY.BackColor = RGB(255,0,0)
					ThisForm.lblQTY_Diff.BackColor = RGB(255,0,0)
					lOrderItemDone = .F.
				ENDIF
			ENDIF
		ELSE
			IF m.nPast_PT_QTY > nS_QTY *1.1
				cMess = "Shipping completed SO QTY "+CHR(13)
				cMess = cMess+" --actually it is over 10% of Order."+CHR(13)+CHR(13)
				cMess = cMess+" Order QTY: "+ALLTRIM(STR(nS_QTY))+CHR(13)+CHR(13)
				cMess = cMess+"Packed QTY: "+ALLTRIM(STR(m.nPast_PT_QTY))+CHR(13)
		
				MESSAGEBOX(cMess,32,"QTY isuue")
			
				ThisForm.lblOrder_QTY.BackColor = RGB(255,0,255)
				ThisForm.lblQTY_Diff.BackColor = RGB(255,255,0)
			ENDIF
			
			lOrderItemDone = .T.
		ENDIF
		
		IF nLBS_Need > 0
			IF m.nPast_LBS *1.2 < nOrder_LBS
				cMess = "Shipping DID NOT complete SO by Weight "+CHR(13)
				cMess = cMess+" --or even within 20% of being complete."+CHR(13)+CHR(13)
				cMess = cMess+" Order QTY: "+ALLTRIM(STR(nOrder_LBS))+CHR(13)+CHR(13)
				cMess = cMess+"Packed QTY: "+ALLTRIM(STR((m.nPast_LBS)))+CHR(13)
		
				MESSAGEBOX(cMess,32,"QTY problem")
			
				ThisForm.lblOrder_QTY.BackColor = RGB(255,0,0)
				ThisForm.lblQTY_Diff.BackColor = RGB(255,0,0)
		
			ELSE
				IF m.nPast_LBS *1.1 < nOrder_LBS
					cMess = "Shipping DID NOT complete SO by Weight "+CHR(13)
					cMess = cMess+" --or even within 10% of being complete."+CHR(13)+CHR(13)
					cMess = cMess+" Order QTY: "+ALLTRIM(STR(nOrder_LBS))+CHR(13)+CHR(13)
					cMess = cMess+"Packed QTY: "+ALLTRIM(STR(m.nPast_LBS))+CHR(13)
		
					MESSAGEBOX(cMess,32,"QTY problem")
				
					ThisForm.lblOrder_QTY.BackColor = RGB(255,0,0)
					ThisForm.lblQTY_Diff.BackColor = RGB(255,0,0)
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE insert_incomproc
		*ThisForm.Insert_IncomProc()
		
		
		PRIVATE nReceivingID 
		nReceivingID = PrepareSQLnum(ThisForm.nReceivingID,'ReceivingID',-3)
		
		IF nReceivingID < 1
			*need ReceivingID
			*POitem is too vague
			RETURN .F.
		ENDIF
		
		
		PRIVATE nQTY, nPounds, cPrc_Form, nPrc_PCs 
		nQTY = PrepareSQLnum(ThisForm.txtQTY_Need.Value,'QTY',-5)
		
		nPounds = PrepareSQLnum(ThisForm.txtPast_LBS.Value,'Pounds',-3)
		cPrc_Form = PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nPrc_PCs = PrepareSQLnum(ThisForm.txtPC_Need.Value,'PC',-3)
		
		
		cSQL = " INSERT INTO "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		ENDCASE
		*cSQL = cSQL + " SET [Process_ID]='RECEIVED' "
		
		cSQL = cSQL + " WHERE ReceivingID = "+STR(nReceivingID)
		cSQL = cSQL + " AND ([Process_ID]='INCOMING' OR [Process_ID]='NOT2HPA' OR [Process_ID]='PartRecv' )"
		
		*!*	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
		*!*		RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL)
		*!*	ELSE
			TrackError("Why would you want this to run? "+CHR(13)+"ThisForm.Insert_IncomProc()"+CHR(13)+cSQL ,"Why would you want this to run?", PROGRAM(), LINENO(1))
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE lst_detail_clone
		PARAMETERS nNewID, nOld_ID_Detail
		*ThisForm.Lst_Detail_Clone
		
		PRIVATE nQTY
		nQTY = PrepareSQLnum(ThisForm.txtPShip_QTY.Value,'QTY',-5)
		
		PRIVATE nNewID_Detail, nNewID_Detail1, nNewID_Detail2
		nNewID_Detail = 0
		nNewID_Detail1 = 0
		nNewID_Detail2 = 0
		
		IF USED('tmpNewID')
			SELECT tmpNewID
		ELSE 
			SELECT 0
		ENDIF
		
		cSQL = "EXEC dbo.p_Lst_Detail_Clone "
		cSQL = cSQL + "	@ID="+STR(nNewID)
		cSQL = cSQL + " ,@ID_Detail="+STR(nOld_ID_Detail)
		cSQL = cSQL + " ,@TBL='"+ThisForm.cTBL+"'"
		cSQL = cSQL + " ,@mS_QTY="+STR(nQTY,18,4)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpNewID')
			RecordError(nSQLEXEC,"p_Lst_Detail_Clone Failed",PROGRAM(),LINENO(1),cSQL )
		ENDIF
		
		*************************************
		*"EXEC dbo.p_Lst_Detail_Clone " can create 3 Tables
		*check with all 3
		
		IF USED('tmpNewID2')	
			IF RECCOUNT('tmpNewID2') > 0
				nNewID_Detail2 = PrepareSQLnum(tmpNewID2.EXP,'ID',-3)
				*MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail2))+" in TBL='"+cTBL+"'",0,'Cloned Incoming ID')
				USE IN tmpNewID2
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
		*	TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID1')	
			IF RECCOUNT('tmpNewID1') > 0
				nNewID_Detail1 = PrepareSQLnum(tmpNewID1.EXP,'ID',-3)
				IF nNewID_Detail2 = 0 
					*MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail1))+" in TBL='"+cTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID1
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
		*	TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID')	
			IF RECCOUNT('tmpNewID') > 0
				nNewID_Detail = PrepareSQLnum(tmpNewID.EXP,'ID',-3)
				IF nNewID_Detail2 = 0 AND nNewID_Detail1 = 0
					*MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail))+" in TBL='"+cTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID"+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID"+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		***********************
		IF nNewID_Detail + nNewID_Detail1 + nNewID_Detail2 = 0
			MESSAGEBOX("Could not Clone/Create new DETAIL Stock record",16,"Error")
			TrackError("Could not Clone/Create new DETAIL Stock record "+CHR(13)+"TBL "+ThisForm.cTBL+CHR(13)+"ID= "+STR(nNewID)+CHR(13)+"New QTY "+STR(nQTY),"Could not Create new DETAIL Stock record "+CHR(13)+cSQL, PROGRAM(), LINENO(1))
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID_Detail"+CHR(13)+cSQL) 
		ENDIF
		
		IF nNewID_Detail2 > 0
			RETURN nNewID_Detail2
		ENDIF
		IF nNewID_Detail1 > 0
			RETURN nNewID_Detail1
		ENDIF
		
		RETURN nNewID_Detail 
		
		
		
	ENDPROC

	PROCEDURE lst_detail_ins
		PARAMETERS nNewID
		*ThisForm.Lst_Detail_INS
		
		PRIVATE nPCS, nDim1, nPounds, nReceivingID, nQTY, nS_PU
		nPCS	= PrepareSQLnum(ThisForm.txtPShip_PC.Value,'PC',-3)
		nDim1	= PrepareSQLnum(ThisForm.txtThck.Value,'DIM1',10,4)
		nPounds	= PrepareSQLnum(ThisForm.txtPShip_LBS.Value,'ActualW',9,1)
		nReceivingID = PrepareSQLnum(ThisForm.nReceivingID,'ReceivingID',9,1)
		nQTY	= PrepareSQLnum(ThisForm.txtThck.Value,'DIM1',10,4)
		nS_PU	= nPU_Acct_Form(PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2),ThisForm.nConnHandle)
		
		
		PRIVATE nNewID_Detail 
		nNewID_Detail = 0
		
		IF USED('tmpNewID')
			SELECT tmpNewID
		ELSE 
			SELECT 0
		ENDIF
		
		cSQL = "EXEC dbo.p_Lst_Detail_INS "
		cSQL = cSQL + " @TBL='"+ThisForm.cTBL+"'"
		*	@size_h		decimal(9, 4),
		*	@size_l		decimal(9, 4),
		cSQL = cSQL + ",@pc	= "+STR(nPCS)
		cSQL = cSQL + ",@dim1 = "+STR(		18, 4)
		*	@dim2		decimal(18, 4),
		*	@dim3		decimal(18, 4),
		*	@length		varchar(160),
		cSQL = cSQL + ",@weight = "+STR(	9,1)
		
		*	@descript	varchar(20),
		*	@location	varchar(10),
		*	@floorstatus	char(1),
		*	@class		char(1),
		*	@RandLen	BIT,
		cSQL = cSQL + ",@ID="+STR(nNewID)
		*	@ID_Detail_Process int,
		cSQL = cSQL + ",@ReceivingID= "+STR(nReceivingID)
		cSQL = cSQL + ",@S_QTY="+STR(nQTY,18,4)
		*	@S_P		decimal(18, 4),
		*	@S_TOTAL
		cSQL = cSQL + ",@S_PU = "+STR(nS_PU)
			
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpNewID')
			RecordError(nSQLEXEC,"p_Lst_Detail_Clone Failed",PROGRAM(),LINENO(1),cSQL )
		ENDIF
		
		*************************************
		*"EXEC dbo.p_Lst_Detail_INS " can create 3 Tables
		*check with all 3
		
		IF USED('tmpNewID2')	
			IF RECCOUNT('tmpNewID2') > 0
				nNewID_Detail2 = PrepareSQLnum(tmpNewID2.EXP,'ID',-3)
		*		MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail2))+" in TBL='"+ThisForm.cTBL+"'",0,'Cloned Incoming ID')
				USE IN tmpNewID2
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID1')	
			IF RECCOUNT('tmpNewID1') > 0
				nNewID_Detail1 = PrepareSQLnum(tmpNewID1.EXP,'ID',-3)
				IF nNewID_Detail2 = 0
		*			MESSAGEBOX("Created a new Detail ID for this Received data "+ALLTRIM(STR(nNewID_Detail1))+" in TBL='"+ThisForm.cTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID1
			ELSE
				TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID')	
			IF RECCOUNT('tmpNewID') > 0
				nNewID_Detail = PrepareSQLnum(tmpNewID.EXP,'ID',-3)
			ELSE
				IF nNewID_Detail2 =0 AND nNewID_Detail1 = 0
		*			MESSAGEBOX("Could not Create new Detail Stock record",16,"Error")
				ENDIF
				*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID"+CHR(13)+cSQL) 
				TrackError("Could not Create new Detail Stock record "+CHR(13)+"TBL "+ThisForm.cTBL+CHR(13)+"New ID= "+STR(nNewID)+CHR(13)+"New QTY "+STR(nQTY_Need),"Could not Create new Detail Stock record ", PROGRAM(), LINENO(1))
			ENDIF
			USE IN tmpNewID
		ELSE
			TrackError("SQL Problem"+CHR(13)+"No records in tmpNewID","Detail Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		***********************
		IF nNewID_Detail + nNewID_Detail1 + nNewID_Detail2 = 0
			MESSAGEBOX("Could not Inser/Create new DETAIL Stock record",16,"Error")
			TrackError("Could not Inser/Create new DETAIL Stock record "+CHR(13)+"TBL "+ThisForm.cTBL+CHR(13)+"ID= "+STR(nNew_ID)+CHR(13)+"New QTY "+STR(nQTY),"Could not Create new DETAIL Stock record ", PROGRAM(), LINENO(1))
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID_Detail"+CHR(13)+cSQL) 
		ENDIF
		
		IF nNewID_Detail2 > 0
			RETURN nNewID_Detail2
		ENDIF
		IF nNewID_Detail1 > 0
			RETURN nNewID_Detail1
		ENDIF
		
		RETURN nNewID_Detail 
		
	ENDPROC

	PROCEDURE lst_master_clone
		PARAMETERS pcTBL,nOld_ID,nQTY_Rcv,cHeat,cLot
		*ThisForm.Lst_Master_Clone()
		
		*p_Lst_Master_Clone RETURNS 3 Tables ?!?
		PRIVATE nNewID, nNewID1, nNewID2
		nNewID = 0
		nNewID1 = 0
		nNewID2 = 0
		
		nQTY_Rcv	= PrepareSQLnum(nQTY_Rcv,'QTY',-5)
		cHeat		= PrepareSQLtxt(cHeat,'Heat',50)
		cLot		= PrepareSQLtxt(cLot,'Lot',10)
		
		IF USED('tmpNewID')
			SELECT tmpNewID
		ELSE 
			SELECT 0
		ENDIF
		
		cSQL = "EXEC dbo.p_Lst_Master_Clone "
		cSQL = cSQL + "	@ID="+STR(nOld_ID)
		cSQL = cSQL + ",@TBL='"+pcTBL+"'"
		cSQL = cSQL + ",@mS_QTY="+STR(nQTY_Rcv)
		cSQL = cSQL + ",@Heat='"+cHeat+"'"
		cSQL = cSQL + ",@Lot='"+cLot+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpNewID')
			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),"p_Lst_Master_Clone Returned Zero: "+cSQL )
			TrackError("Returned Zero: SQL Transaction will be Rolled Back"+CHR(13)+CHR(13)+cSQL,"Could not Clone!",PROGRAM(),LINENO(1))
			RETURN 0
		ENDIF
		
		*************************************
		*XEC dbo.p_Lst_Master_Clone2 can create 3 tables
		*check with all 3
		
		IF USED('tmpNewID2')	
			IF RECCOUNT('tmpNewID2') > 0
				nNewID2 = PrepareSQLnum(tmpNewID2.EXP,'ID',-3)
				*MESSAGEBOX("Created a new Master ID for this Received data "+ALLTRIM(STR(nNewID2))+" in TBL='"+pcTBL+"'",0,'Cloned Incoming ID')
				USE IN tmpNewID2
			ELSE
				TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID2"+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID2","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID1')	
			IF RECCOUNT('tmpNewID1') > 0
				nNewID1 = PrepareSQLnum(tmpNewID1.EXP,'ID',-3)
				IF nNewID2  = 0
				*	MESSAGEBOX("Created a new Master ID for this Received data "+ALLTRIM(STR(nNewID1))+" in TBL='"+pcTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID1
			ELSE
				TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID1"+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID1","Master Clone issue!",PROGRAM(),LINENO(1))
		ENDIF
		
		IF USED('tmpNewID')	
			IF RECCOUNT('tmpNewID') > 0
				nNewID = PrepareSQLnum(tmpNewID.EXP,'ID',-3)
				IF nNewID2 = 0 AND nNewID1 = 0
				*	MESSAGEBOX("Created a new Master ID for this Received data "+ALLTRIM(STR(nNewID))+" in TBL='"+pcTBL+"'",0,'Cloned Incoming ID')
				ENDIF
				USE IN tmpNewID
			ELSE
				TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID"+CHR(13)+cSQL,"Master Clone issue!",PROGRAM(),LINENO(1))
			ENDIF
		ELSE
			TrackError("SQL Problem p_Lst_Master_Clone "+CHR(13)+"No records in tmpNewID","Master Clone issue!"+CHR(13)+cSQL,PROGRAM(),LINENO(1))
		ENDIF
		
		***********************
		IF nNewID + nNewID1 + nNewID2 = 0
			MESSAGEBOX("Could not Create new MASTER Stock record",16,"Error")
			cMess = "Could not Create new MASTER Stock record "+CHR(10)+CHR(13)+"TBL "+pcTBL+CHR(13)+"ID= "+STR(nOld_ID)+CHR(10)+CHR(13)
			cMess = cMess + "Recv QTY "+STR(nQTY_Rcv)+CHR(10)+CHR(13) +CHR(10)+CHR(13)
			cMess = cMess + "@Heat='"+cHeat+"'"+CHR(10)+CHR(13)
			cMess = cMess + ",@Lot='"+cLot+"'"+CHR(10)+CHR(13) +CHR(10)+CHR(13)
			cMess = cMess + "Looked over 3 SQL returns."+CHR(10)+CHR(13) +CHR(10)+CHR(13)
			cMess = cMess + cSQL +CHR(10)+CHR(13)
			
			TrackError(cMess,"Could not Create new MASTER Stock record ", PROGRAM(), LINENO(1))
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get NewID from p_Lst_Master_Clone ."+CHR(13)+cSQL) 
		ENDIF
		
		IF nNewID2 > 0
			RETURN nNewID2
		ENDIF
		IF nNewID1 > 0
			RETURN nNewID1
		ENDIF
		*ELSE
		RETURN nNewID 
		
	ENDPROC

	PROCEDURE marksoitemcomplete
		PARAMETERS lComplete
		*ThisForm.MarkSOitemComplete(.T.)
		
		*nCnt = Count_POIteminPurchaseOrder( ThisForm.cPOItem, ThisForm.nConnHandle, "DELIVERED" )
		PRIVATE cPOItem
		cPOitem = Proper_PO_item(ThisForm.cPOItem)
		IF cPOitem = Proper_PO_item("")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, cMess
		
		IF lComplete
			cSQL = "UPDATE dbo.PurchaseOrder "
			cSQL = cSQL+" SET Delivered = 1 "
			cSQL = cSQL+" ,[Cmplt] = 1"
			cSQL = cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOItem+"')"
			cMess = "POitem '"+cPOItem+"' was set to COMPLETE on Show Received VS Ordered screen."
		ELSE
			cSQL = "UPDATE dbo.PurchaseOrder SET [Cmplt] = 0 "
			cSQL = cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPOItem+"')"
			cMess = "POitem '"+cPOItem+"' was set to NOT COMPLETE on Show Received VS Ordered screen."
		ENDIF
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			RETURN .F.
		ENDIF
		
		***************************************
		TrackMess(cMess)
		
		***************************************
		cSQL = "INSERT INTO dbo.PO_Item_Notes "
		cSQL = cSQL+ " ([POitem],[Notes]) VALUES ("
		cSQL = cSQL+ "'"+cPOItem+"','"+PrepareSQLtxt(cMess,'mess',-1)+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			*RETURN .F.
		ENDIF
		
		RETURN .T.
		
		
	ENDPROC

