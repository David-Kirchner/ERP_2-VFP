				cSQL = "SELECT Phone FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisFormset.frmRMA.pf1.pgAddEdit.txtPhone.Value = tmpQuotes.Phone 
			ENDIF
			IF EMPTY( ThisFormset.frmRMA.pf1.pgAddEdit.txtFax.Value )
				cSQL = "SELECT Fax FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisFormset.frmRMA.pf1.pgAddEdit.txtFax.Value = tmpQuotes.Fax 
			ENDIF
			
			IF EMPTY( ThisFormset.frmRMA.pf1.pgAddEdit.txtNotified.Value )
				ThisFormset.frmRMA.pf1.pgAddEdit.txtNotified.Value = DATE()
			ENDIF
			
			IF USED("tmpQuotes")
				USE IN tmpQuotes
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE selectso		&& Open Select with SO
		PARAMETERS pnSO
		*ThisFormSet.SelectSO()
		
		ThisFormSet.FrmRMA.Visible = .F.
		ThisFormSet.Rma_select12.Visible = .T.
		
		ThisFormset.Rma_select12.cmbSWhere.Value = "Sales Order"
		ThisFormset.Rma_select12.cmbSWhere.Refresh
		ThisFormset.Rma_select12.cReturnKey=''
		ThisFormset.Rma_select12.txtSearch.SetFocus
		
		IF TYPE("pnSO")= "N"
			IF pnSO > 0
				ThisFormset.Rma_select12.txtSearch.Value = ALLTRIM(STR(pnSO))
				ThisFormset.Rma_select12.cmdSearch.Click
			ENDIF
		ENDIF
		
	ENDPROC

