		SELECT RMA_DETAIL
		IF RECCOUNT('RMA_Detail') > 0
			IF FILE('reports\RMA.FRX')
				REPORT FORM Reports\RMA FOR RMA_No = nRMA_No TO PRINT PREVIEW
				ThisFormset.frmRMA.Refresh
				
			ELSE
				MESSAGEBOX("No File 'reports\RMA.FRX'")
			ENDIF
		ELSE
			MESSAGEBOX("No RMA_Detail table")
		ENDIF
		
		SELECT RMA
		IF nCurrRMA > 0
			IF nCurrRMA <= RECCOUNT('RMA')
				GOTO nCurrRMA
			ENDIF
		ENDIF
	ENDPROC

