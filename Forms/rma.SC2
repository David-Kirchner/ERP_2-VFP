	PROCEDURE frmRMA.pf1.pgFind.cmbFind.Valid
		PRIVATE IntcmbFind
		IntcmbFind = INT(This.Value)
		DO CASE
		CASE IntcmbFind = 1
			*rma_no n,10
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999999"
		*CASE IntcmbFind = 2
		*	*SOitem c,10
		*	m.FindText = SPACE(10)
		*	This.Parent.txtFindText.InputMask =	"99999-99"
		CASE IntcmbFind = 2
			*Company c,30
			m.FindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		ENDCASE
		This.Parent.txtFindText.Refresh
	ENDPROC

	PROCEDURE frmRMA.pf1.pgFind.cmdFindcmbText.Valid
		PRIVATE IntcmbFind,ncomp
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace m.FindText
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		IF TYPE('laText2Find') = "N"
			lnText2Find = laText2Find
			lcText2Find = ALLTRIM(STR(laText2Find))
		ENDIF
		IF TYPE('laText2Find') = "C"
			lcText2Find = ALLTRIM(laText2Find)
			lnText2Find = VAL(laText2Find)
		ENDIF
		IntcmbFind = INT(m.ncmbFind)
		SELECT RMA
		
		*RMA_No,SalesOrder-Item
		DO CASE
		CASE IntcmbFind = 1
			*RMA_No n,10
			BROW for RMA.RMA_No = lnText2Find  TITLE "Click X to close this find window."
		*CASE IntcmbFind = 2
		*	*SOitem c,10
		*	BROWSE for RMA_detail.SO_item = PADL(lcText2Find,10) TITLE "Click X to close this find window."
		CASE IntcmbFind = 2
			*Company c,30
			COUNT TO ncomp for UPPER(Company) = UPPER(lcText2Find)
			IF ncomp > 0
				BROW for UPPER(Company) = UPPER(lcText2Find) TITLE "Click X to close this find window."
			ELSE
				COUNT TO ncomp for LEFT(UPPER(Company),4) = LEFT(UPPER(lcText2Find ),4)
				IF ncomp > 0
					BROW for LEFT(UPPER(Company),4) = LEFT(UPPER(lcText2Find ),4) TITLE "Click X to close. Matched first 4 letters."
				ELSE
				COUNT TO ncomp for LEFT(UPPER(Company),2) = LEFT(UPPER(lcText2Find ),2)
				IF ncomp > 0
					BROW for LEFT(UPPER(Company),2) = LEFT(UPPER(lcText2Find ),2) TITLE "Click X to close. Matched first 2 letters."
				ELSE
					BROW for LEFT(UPPER(Company),1) = LEFT(UPPER(lcText2Find ),1) TITLE "Click X to close. Matched first 1 letter only."
				ENDIF
				ENDIF
			ENDIF
		ENDCASE
		*SET EXACT ON
	ENDPROC

	PROCEDURE frmRMA.pf1.pgView.chkCancel.Valid
		PRIVATE lCancelled, nRMA_No, nRMA_Detail_ID
		lCancelled = RMA.cancelled
		nRMA_No = RMA.RMA_No
		nRMA_Detail_ID = RMA_Detail.RMA_Detail_ID
		
		IF NOT AllowRMA_Approval()
			IF HavePermission('RMA_Cancel')
				*OK
			ELSE
				MESSAGEBOX("You are not listed as having 'RMA' Permissions.",48,"Cannot Change.")
				RETURN .f.
			ENDIF
		ENDIF
		
		
		IF lCancelled && The button has been clicked and new cancelled state exists
			IF MESSAGEBOX("Are you sure you want to UN cancel this RMA?"+CHR(13)+ALLTRIM(STR(nRMA_No)),4+32,"UN Cancel") = 6
				Cancel_RMA_No( nRMA_No, .F., ThisFormSet.nConnHandle)
				This.parent.chkDetailCancel.Refresh
			ELSE
				This.parent.chkCancel.Value = NOT lCancelled 
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to cancel this RMA?"+CHR(13)+ALLTRIM(STR(nRMA_No)),4+32,"Cancel") = 6
				IF Cancel_RMA_No( nRMA_No, .T., ThisFormSet.nConnHandle)
					MESSAGEBOX("Also Cancelled ALL the Detail records.",0,"Cancelled")
				ELSE
					MESSAGEBOX("Return code is 'Failed'",0,"Did not CANCEL")
					This.parent.chkCancel.Value = NOT lCancelled 
					RETURN .F.	
				ENDIF
				
			ELSE
				This.parent.chkCancel.Value = NOT lCancelled 
				RETURN .F.
			ENDIF
		ENDIF
		
		ThisFormSet.RMA_No_refresh(nRMA_Detail_ID)
		
		This.parent.chkCancel.Refresh
		This.parent.chkDetailCancel.Refresh
		
		This.Parent.grdRMA.Refresh
		This.Parent.grdRMA.Setfocus
	ENDPROC

	PROCEDURE frmRMA.pf1.pgView.chkDetailCancel.Valid
		PRIVATE lCancelled, nRMA_Detail_ID, nRMA_No 
		lCancelled = RMA_detail.cancelled
		nRMA_Detail_ID = RMA_Detail.RMA_Detail_ID
		nRMA_No = RMA.RMA_No
		
		IF NOT lCancelled  && The button has been click and new cancelled state exists
			IF MESSAGEBOX("Are you sure you want to UN cancel this Detail?"+CHR(13)+"RMA:"+ALLTRIM(STR(nRMA_No)),4+32,"UN Cancel") = 6
				IF NOT Cancel_RMA_Detail_ID( nRMA_Detail_ID, .F., ThisFormSet.nConnHandle)
					TrackError("UN Cancel RMA "+STR(nRMA_No)+" Failed.","Could not un Cancel", PROGRAM(), LINENO(1))
				ENDIF
			ELSE
				This.parent.chkDetailCancel.Value = NOT lCancelled 
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to cancel this Detail?"+CHR(13)+"RMA:"+ALLTRIM(STR(nRMA_No)),4+32,"Cancel") = 6
				IF NOT Cancel_RMA_Detail_ID( nRMA_Detail_ID, .T., ThisFormSet.nConnHandle)	
					TrackError("Cancel RMA "+STR(nRMA_No)+" Failed.","Could not Cancel", PROGRAM(), LINENO(1))
				ENDIF
			ELSE
				This.parent.chkDetailCancel.Value = NOT lCancelled 
				RETURN .F.
			ENDIF
		ENDIF
		
		This.Parent.grdRMA.Refresh
		This.Parent.grdRMA.Setfocus
	ENDPROC

