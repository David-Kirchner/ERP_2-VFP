		This.Parent.txtRefunded.Value = nItemSale
		
	ENDPROC

	PROCEDURE frmRMA.pf1.pgAddEdit.txtAuth_By.LostFocus
		IF EMPTY(This.Value)
			PRIVATE cMach_User, cUserName
			cMach_User = SYS(0)
			cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
			This.Value = cUserName
		ENDIF
	ENDPROC

	PROCEDURE frmRMA.pf1.pgAddEdit.txtReason.Valid
		IF This.Parent.chkSameReason.Value=0
			gaReason(ASCAN(aSoItems, PrepareSQLtxt(RMA_Detail.SO_item,'SOitem',10))) = PrepareSQLtxt(This.Value,'Reason',-1)
		ELSE
			gaReason(1) = PrepareSQLtxt(This.Value,'Reason',-1)
		ENDIF
	ENDPROC

	PROCEDURE frmRMA.pf1.pgAddEdit.txtReturnTo.Click
		PRIVATE cReturnTo
		cReturnTo = UPPER( PrepareSQLtxt(This.Value,'ReturnTo',1) )
		
		IF cReturnTo = "T" OR cReturnTo = "W"
		
		ELSE
			IF NOT EMPTY(cReturnTo)
				MESSAGEBOX("Return to is limited to 'Tipton or Windfall'",0,"Ignore input")
				This.Value = ''
			ENDIF
		ENDIF
	ENDPROC

