	ENDPROC

	PROCEDURE frmRMA.pf1.pgView.cmbFind.Valid
		PRIVATE IntcmbFind
		IntcmbFind = INT(This.Value)
		*Sales Order,Customer,RMA,PurchaseOrder
		DO CASE
		CASE IntcmbFind = 1
			*Salesnum n,7
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999"
		CASE IntcmbFind = 2
			*Company c,30
			m.FindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 3
			*RMA N,10
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999999"
		CASE IntcmbFind = 4
			*PO_Num
			m.FindText = SPACE(20)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXX"
		ENDCASE
		This.Parent.txtFindText.Refresh
		
	ENDPROC

	PROCEDURE frmRMA.pf1.pgView.cmdApprove.Click
		PRIVATE nRMA_No, cSalesP
		nRMA_No = rma.RMA_No
		cSalesP = RMA_Detail.SalesP
		*ThisFormSet.EditRMA_No(nRMA_No)
		
		IF AllowRMA_Approval()
		
			IF RMA_No_Approve( nRMA_No, ThisFormSet.nConnHandle)
				MESSAGEBOX("RMA "+ALLTRIM(STR(nRMA_No))+" saved.",0+64,"Saved!")
				
				PRIVATE cNetMachInfo, cMachine, cUser
				cNetMachInfo = SYS(0)
				cMachine = LEFT( cNetMachInfo, AT("#",cNetMachInfo)-2)
				cUser	= RIGHT( cNetMachInfo, LEN(cNetMachInfo)-AT("#",cNetMachInfo)-1 )
				
				SELECT RMA
				This.parent.parent.pgAddEdit.txtAPRV_By.Value = cUser
				This.parent.txtAPRV_By.Value = cUser
				REPLACE aprv_by WITH cUser
				
				This.parent.parent.pgAddEdit.txtAPRV_Date.Value = DATE()
				This.parent.txtApRV_Date.Value = This.parent.parent.pgAddEdit.txtAPRV_Date.Value
				REPLACE Aprv_Date WITH  This.parent.txtApRV_Date.Value
				
				This.parent.grdRMA.Refresh
				
				This.Visible = .F.
				
				
				
				
				PRIVATE cSOitem, cDesc
				cSOitem = PrepareSQLtxt(RMA_Detail.SO_item,'SOitem',10)
				cDesc = get_Description("SOitem", cSOitem, ThisFormSet.nConnHandle)
				
				IF Send_Chatter('RMA_Approved',nRMA_No,cSOitem,"RMA "+ALLTRIM(STR(nRMA_No))+" on '"+cSOitem+"' has been Approved"+CHR(13)+cDesc+CHR(13)+HTML_SOitem(cSOitem,.T.)+CHR(13)+HTML_RMA_No(nRMA_No,.T.),ThisFormSet.nConnHandle)
					MESSAGEBOX("Sent 'RMA Approved' message to Sales Rep",0,"Sent in Chatter")
				ENDIF
				
				*Send Email to Sales Rep
				PRIVATE cSubject, cSendTo, nSO
				nSO	= VAL( cSOitem )
				cSendTo = AppSetup_Get_Email( SalesRepfromSO(nSO) )
				cSendTo = cSendTo +";"+ AppSetup_Get_Email( 'RMA Accounting' )
				
				cSubject = "Sales Order:"+ALLTRIM(STR(nSO))+" now has an approved RMA number."
				
				cSubject = cSubject + CHR(13) + cDesc
				
				
				cSubject = cSubject + CHR(13) + "Sales Rep: "+SalesRepfromSO(nSO)
				cSubject = cSubject + CHR(13) + "Company: "+getFromQuotesSO(nSO,'COMPANY',ThisFormSet.nConnHandle)
				cSubject = cSubject + CHR(13) + SalesRepfromSO(nSO)+": Alert your customer to return with this RMA number "+ALLTRIM(STR(nRMA_No))
				cSubject = cSubject + CHR(13) + PrepareSQLtxt(RMA_Detail.Reason,'Reason',-1)
				cSubject = cSubject + CHR(13) + " "
				cSubject = cSubject + CHR(13) + HTML_SO(nSO,.F.)
				cSubject = cSubject + CHR(13) + " "
				cSubject = cSubject + CHR(13) + HTML_RMA_No(nRMA_No,.F.)
				cSubject = cSubject + CHR(13) + " "
				*cSubject = cSubject + CHR(13) + "Consider canceling the SOitem"
				
				Send_HTML_Email( cSendTo ,get_Server_Email(),'RMA Aproved',cSubject,ThisFormSet.nConnHandle,.T.,.T.)
			ELSE
				MESSAGEBOX('Data not saved.',0+64,"Not Saved!")
			ENDIF
		ELSE
			MESSAGEBOX("You are not listed as having 'RMA_Approval' Permissions."+CHR(13)+"Set PRP = YES AND ANS = RMA_Approval"+CHR(13)+"and Set PRP = RMA AND ANS = True",48,"Cannot approve.")
		ENDIF
	ENDPROC

