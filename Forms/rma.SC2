		= SQLDISCONNECT(ThisFormSet.nConnHandle)
	ENDPROC

	PROCEDURE frmRMA.cmdQuit.Click
		
		ThisForm.Release
		ThisFormSet.Release
	ENDPROC

	PROCEDURE frmRMA.cmdShowApproved.Click
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		IF USED("tmpSetup")
			USE IN tmpSetup
		ENDIF
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT UN FROM dbo.AppSetup WITH(NOLOCK) "
		cSQL = cSQL + " WHERE PRP = 'YES' AND ANS = 'RMA_Approval'"
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSetup')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSetup')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSetup")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSetup")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSetup')
		ENDIF
		
		PRIVATE cNameList
		cNameList = ''
		
		IF USED("tmpSetup")
			IF RECCOUNT("tmpSetup")>0
				SCAN
					IF EMPTY(cNameList)
						cNameList = ALLTRIM(tmpSetup.UN)
					ELSE
						cNameList = cNameList+CHR(13)+""+ALLTRIM(tmpSetup.UN)
					ENDIF
				ENDSCAN	
			ENDIF
			USE IN tmpSetup
		ENDIF
			
		IF NOT EMPTY(cNameList)
			MESSAGEBOX("Users allowed to approve RMA:"+CHR(13)+cNameList,64,"Approve RMA")
		ELSE
			MESSAGEBOX("No users where found!",64,"Error")
		ENDIF
	ENDPROC

