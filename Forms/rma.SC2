	PROCEDURE checkdata		&& Validate before Save
		PRIVATE lSave
		lSave = .T.
		PRIVATE dNotified, dAprv_Date 
		
		IF TYPE("RMA.Notified") = "C"
			dNotified = CtoD(RMA.dNotified)
		ENDIF
		
		IF TYPE("dNotified") <> "D" OR EMPTY(dNotified)
			MESSAGEBOX( "You need an 'Notified' date!"+CHR(13)+"Set to todays date.",0,"No Save")
			dNotified = DATE()
			ThisFormset.frmRMA.pf1.pgAddEdit.txtNotified.Refresh
			RETURN .F.
		ENDIF
		
		IF TYPE("RMA.Aprv_Date") = "C"
			dAprv_Date = CtoD(RMA.Aprv_Date)
		ENDIF
		
		
		IF ALEN(aSoItems) = 0
			MESSAGEBOX( "You have no SO Items selected!"+CHR(13)+"Click 'Select Items' to find the item to be returned.",0,"No Save" )
			RETURN .F.
		ENDIF
			
		
		RETURN lSave
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE editrma_no		&& Edit RMA_No
		PARAMETERS pRMA_No
		*ThisFormSet.EditRMA_No(nRMA_No)
		
		IF TYPE("pRMA_No") != "N"
			RETURN .F.
		ENDIF
		
		
		IF pRMA_No < 1
			*Erorr
			RETURN .F.
		ENDIF
		
		SELECT RMA
		SEEK pRMA_No ORDER TAG RMA_No
		IF FOUND('RMA')
			ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.Value = "Editting RMA "+ALLTRIM(STR(pRMA_No))&&+CHR(13)+ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.Value
			ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value = RMA.RMA_No
			
			ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.Value	= RMA.Company
			ThisFormset.frmRMA.pf1.pgAddEdit.txtContact.Value	= RMA.Contact
			ThisFormset.frmRMA.pf1.pgAddEdit.txtEmail.Value		= RMA.Email
			ThisFormset.frmRMA.pf1.pgAddEdit.txtPhone.Value		= RMA.Phone
			ThisFormset.frmRMA.pf1.pgAddEdit.txtFax.Value		= RMA.Fax
			ThisFormset.frmRMA.pf1.pgAddEdit.txtNotified.Value	= RMA.Notified
			ThisFormset.frmRMA.pf1.pgAddEdit.txtAprv_Date.Value	= RMA.Aprv_Date
			ThisFormset.frmRMA.pf1.pgAddEdit.txtAprv_By.Value	= RMA.Aprv_By
			ThisFormset.frmRMA.pf1.pgAddEdit.txtAuth_By.Value	= RMA.Auth_By
			ThisFormset.frmRMA.pf1.pgAddEdit.txtMoney.Value 	= RMA.Money
			ThisFormset.frmRMA.pf1.pgAddEdit.edtWhoAdd.Value 	= RMA.WhoAdd
			
			*********************************
			ThisFormset.frmRMA.pf1.ActivePage = 1
			
			IF USED('RMA_Detail')
				IF PrepareSQLnum(RMA_Detail.RMA_Detail_ID,'RMA_Detail_ID',-3) > 0
					ThisFormSet.RMA_No_refresh(RMA_Detail.RMA_Detail_ID)
				ELSE
					ThisFormSet.RMA_No_refresh(0)
				ENDIF
			ELSE
				ThisFormSet.RMA_No_refresh(0)
			ENDIF
		
			***********************
			*UPDATE_RMA_NoinSales( nRMA_No,aSoItems(nItems), ThisFormSet.nConnHandle)
			***********************
			
			ThisFormset.frmRMA.pf1.pgAddEdit.cmdAdd.Caption = "Save RMA"
			
			ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.SetFocus()
		ELSE
			MESSAGEBOX("RMA "+ALLTRIM(STR(pRMA_No))+" was not found!",0,"No Edit")
		ENDIF
		
	ENDPROC

	PROCEDURE formsrefresh
	ENDPROC

	PROCEDURE getbysoitem
		PARAMETER pSOitem
		*ThisFormSet.GetBySOitem(pSOitem)
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT Company,Name,Phone,Fax FROM dbo.Allquotes WHERE SOitem = '"+pSOitem+"'"
		
		IF USED("tmpAllQuotes")
			USE IN tmpAllQuotes
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAllQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAllQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAllQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAllQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpAllQuotes')
			*error
		ELSE
			IF USED("tmpAllQuotes")
				SELECT tmpAllQuotes
				IF NOT EOF('tmpAllQuotes')
					ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.Value = tmpAllQuotes.Company
					ThisFormset.frmRMA.pf1.pgAddEdit.txtContact.Value = tmpAllQuotes.Name
					ThisFormset.frmRMA.pf1.pgAddEdit.txtEmail.Value = tmpAllQuotes.Email
					ThisFormset.frmRMA.pf1.pgAddEdit.txtPhone.Value = tmpAllQuotes.Phone
					ThisFormset.frmRMA.pf1.pgAddEdit.txtFax.Value = tmpAllQuotes.Fax
					
					*Get RMA with SOitem.
					IF USED('tmpRMASoitem')
						USE IN tmpRMASoitem
					ENDIF
		
					SELECT 0
		
					cSQL = "SELECT RMA_No FROM dbo.RMA_Detail "
					cSQL = cSQL + " WHERE SO_item = '"+pSOitem+"'"
		
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRMASoitem')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRMASoitem')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRMASoitem")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRMASoitem")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpRMASoitem')
					ENDIF
		
					IF USED('tmpRMASoitem')
						IF VARTYPE( tmpRMASoitem.RMA_No ) = "N"
							ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value = tmpRMASoitem.RMA_No
						ELSE
							ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value = 0
						ENDIF
						USE IN tmpRMASoitem
					ELSE
						ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value = 0
					ENDIF
				ENDIF
			ENDIF
		
		
			USE IN tmpAllQuotes
		ENDIF
		
		
	ENDPROC

	PROCEDURE getcompanysoitem
		PARAMETER pSOitem
		*ThisFormSet.GetCompanySOitem(pSOitem)
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT Company,Name,Phone,Fax,Email,SalesP,Cover "
		*cSQL = cSQL + ",dbo.f_Descript(AQ.Alloy,AQ.CC,AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen) AS Descript "
		*cSQL = cSQL + ",AQ.SalesP"
		cSQL = cSQL + " FROM dbo.Allquotes AQ WHERE AQ.SOitem = '"+pSOitem+"'"
		
		IF USED("tmpAllQuotes")
			USE IN tmpAllQuotes
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAllQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAllQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAllQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAllQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpAllQuotes')
			*error
		ELSE
			IF USED("tmpAllQuotes")
				SELECT tmpAllQuotes
				IF NOT EOF('tmpAllQuotes')
					
					ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.Value = tmpAllQuotes.Company
					ThisFormset.frmRMA.pf1.pgAddEdit.txtContact.Value = tmpAllQuotes.Name
					ThisFormset.frmRMA.pf1.pgAddEdit.txtEmail.Value = tmpAllQuotes.Email
					ThisFormset.frmRMA.pf1.pgAddEdit.txtPhone.Value = tmpAllQuotes.Phone
					ThisFormset.frmRMA.pf1.pgAddEdit.txtFax.Value = tmpAllQuotes.Fax
					
					ThisFormset.frmRMA.pf1.pgAddEdit.txtAuth_By.Value = SalesPDescription(tmpAllQuotes.SalesP,tmpAllQuotes.Cover)
					
					*ThisForm.Load_SOitem_Detail(pSOitem)
					
					********************************
					*Get RMA with SOitem.
					IF USED('tmpRMASoitem')
						USE IN tmpRMASoitem
					ENDIF
		
					SELECT 0
		
					cSQL = "SELECT RMA_No FROM dbo.RMA_Detail "
					cSQL = cSQL + " WHERE SO_item = '"+pSOitem+"'"
		
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRMASoitem')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRMASoitem')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRMASoitem")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRMASoitem")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpRMASoitem')
					ENDIF
		
					IF USED('tmpRMASoitem')
						IF RECCOUNT('tmpRMASoitem') > 0
							IF ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value > 0
								IF ThisForm.txtRMA_No.Value <> tmpRMASoitem.RMA_No
									PRIVATE nMess
									nMess = MESSAGEBOX("This SOitem '"+pSOitem+"' is already atached "+CHR(13)+" to RMA "+ALLTRIM(STR(tmpRMASoitem.RMA_No))+CHR(13)+"Do you want to have this POitem to be for "+CHR(13)+" RMA "+ALLTRIM(STR(ThisForm.txtRMA_No.Value))+" ?",4+32,"Use another RMA number?") 
									IF nMess = 6
										ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value = tmpRMASoitem.RMA_No
									ENDIF
								ENDIF
							ELSE
								ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value = tmpRMASoitem.RMA_No
							ENDIF
						ELSE
							ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value = 0
						ENDIF
						USE IN tmpRMASoitem
					ELSE
						ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value = 0
					ENDIF
				ENDIF
			ENDIF
		
		
			USE IN tmpAllQuotes
		ENDIF
		
		
	ENDPROC

	PROCEDURE get_asoitems
		*ThisFormSet.get_aSOitems()
			
		IF USED('RMA_Detail')
		
			SELECT SO_item FROM RMA_Detail INTO ARRAY aSoItems
			SELECT Reason  FROM RMA_Detail INTO ARRAY gaReason
		
			
			IF VARTYPE(ThisFormset.frmRMA) = "O"
				ThisFormset.frmRMA.pf1.pgView.grdRMA_D.RecordSource = 'RMA_Detail'
				ThisFormset.frmRMA.pf1.pgView.grdRMA_D.Refresh
				
				ThisFormset.frmRMA.pf1.pgBrowse.grdBrRMA_D.RecordSource = 'RMA_Detail'
				
				ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.RecordSource = 'RMA_Detail'
		
				ThisFormSet.RMA_Detail_Refresh()
			
			ENDIF
			
		ENDIF
		
	ENDPROC

	PROCEDURE get_soitemfrompo_num
		PARAMETERS pPO_num
		*ThisFormSet.get_SOitemfromPO_Num()
		PRIVATE cPO_num
		cPO_Num = PrepareSQLtxt(pPO_num,'PO_num',20)
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		IF USED('tmpPO_No')
			USE IN tmpPO_No
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT SalesNum,SOitem "
		cSQL = cSQL + " FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE PO_Num = '"+cPO_num+"'"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPO_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPO_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpPO_No')
		ENDIF
		
		PRIVATE cSOitem, nSalesNum
		cSOitem = ''
		nSalesNum = 0
		
		IF USED('tmpPO_No')
			IF RECCOUNT('tmpPO_No') > 0
				IF RECCOUNT('tmpPO_No') = 1
					nSalesNum = PrepareSQLnum(tmpPO_No.SalesNum,'SalesNum',-3)
					cSOitem = PrepareSQLtxt(tmpPO_No.SOitem,'SOitem',12)
				ELSE
					*SCAN
						nSalesNum = PrepareSQLnum(tmpPO_No.SalesNum,'SalesNum',-3)
						cSOitem = PrepareSQLtxt(tmpPO_No.SOitem,'SOitem',12)
						MESSAGEBOX("Found more than 1 SO item"+CHR(13)+"for the customers PO "+cPO_num+CHR(13)+"Returning the first occurance"+CHR(13)+cSOitem,0,"Found Many")
					*ENDSCAN
				ENDIF
			ENDIF
			USE IN tmpPO_No
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ELSE
				RecordTest("Record Test Data.", "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Lost Alias '"+cAlias+"'")
			ENDIF
		ENDIF
		
		RETURN cSOitem 
	ENDPROC

	PROCEDURE Init
		PARAMETER pRMA_No, pSOitem
		*DO FORM RMA WITH nRMA
		
		ThisFormSet.Load_RMA("Refresh")
		ThisFormSet.RMA_No_refresh(0)
		ThisFormSet.RMA_Refresh()
		
		ThisFormSet.RMA_Detail_Refresh()
		
		ThisFormSet.RefreshViewTab()
		RELEASE m.ncmbFind,m.FindText
		Public m.ncmbFind,m.FindText
		m.ncmbFind = 1
		m.FindText = 0
		
		ThisFormSet.OleDate = DATE()
		ThisFormSet.SOitem = ""
		
		
		IF TYPE('pRMA_No') = "N"  
			IF pRMA_No > 0
				SELECT RMA
				SEEK pRMA_No ORDER RMA_No IN RMA
			
				ThisFormset.frmRMA.pf1.ActivePage = 2
				ThisFormset.frmRMA.pf1.pgView.txtFindText.SetFocus
			ELSE
				*From Quotes program!
				IF TYPE('pSOitem') = "C"
					ThisFormSet.SOitem = pSOitem
					ThisFormSet.GetBySOitem(pSOitem)
					
					ThisFormset.frmRMA.pf1.ActivePage = 1
					ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.SetFocus
				ENDIF
			ENDIF
		ELSE
			ThisFormset.frmRMA.pf1.ActivePage = 2
		ENDIF
		
		*ThisFormSet.RMA_No_Refresh(0) %%not here
		
		
		*ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.RowSource			= "aSoItems"
		*ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.NumberOfElements	= ALEN(aSoItems,1)
		*ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.Refresh
		
		*ThisFormSet.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.Refresh
		*ThisFormSet.Refresh_SOitem_PS()
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		*IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*	SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		*ENDIF 
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_rtr ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		PUBLIC aSoItems(1)
		aSoItems(1)=" "
		
		PUBLIC gaReason(1)
		gaReason(1) = " "
		
		PRIVATE cSQL, nSQLEXEC 
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.RMA WHERE 0>0"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'RMA' )
		ENDIF
		
	ENDPROC

	PROCEDURE load_rma
		PARAMETERS pWhat
		*ThisFormSet.Load_RMA()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		
		IF UPPER(pWhat) ="REFRESH"
			ThisFormset.frmRMA.pf1.pgView.grdRMA.RecordSource = ''
			ThisFormset.frmRMA.pf1.pgBrowse.grdBrRMA.RecordSource = ''
			
			IF USED('RMA')
				USE IN RMA
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED('RMA')
			USE IN RMA
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.RMA "
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'RMA' )
		ENDIF
		
		
		IF USED('RMA')
			
			SELECT RMA
			INDEX ON RMA_No TAG RMA_No
			SET ORDER TO TAG RMA_No
			
			IF UPPER(pWhat) ="REFRESH"
				GO BOTTOM
				ThisFormset.frmRMA.pf1.pgView.grdRMA.RecordSource = 'RMA'
				ThisFormset.frmRMA.pf1.pgBrowse.grdBrRMA.RecordSource = 'RMA'
			ENDIF
		ELSE
			MESSAGEBOX('Failed to load RMA',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		***********************************
		
		ThisFormSet.Load_RMA_Detail()
		
		
		********************************************
		
		PRIVATE nSales_Detail_ID
		nSales_Detail_ID = PrepareSQLnum(RMA_Detail.Sales_Detail_ID,'Sales_Detail_ID',-3)
		IF USED('Sales_Detail')
			USE IN Sales_Detail
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT ISNULL(SD.ID,0) AS Sales_Detail_ID, StockLst_ID_Detail "
		cSQL = cSQL + ",0 AS ReceivingID "
		cSQL = cSQL + ", SD.Alloy, SD.Form, SD.Sale_PC, SD.Descript, SD.Heat, SD.Lot "
		cSQL = cSQL + " ,SD.PackingSli AS SDPackingSli "
		cSQL = cSQL + " FROM dbo.Sales_Detail SD WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SD.ID = "+STR(nSales_Detail_ID) 
		
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Sales_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Sales_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'Sales_Detail' )
		ENDIF
		
		IF USED('Sales_Detail')
			
			ThisFormSet.FrmRMA.pf1.pgAddEdit.grdSD.RecordSource = 'Sales_Detail'
			ThisFormSet.FrmRMA.pf1.pgAddEdit.grdSD.ColumnCount = 1
			ThisFormSet.FrmRMA.pf1.pgAddEdit.grdSD.Column1.Header1.Caption = "Sales Detail"
		*	ThisFormSet.FrmRMA.pf1.pgAddEdit.grdSD.Column1.Text1.ControlSource = "Sales_Detail.Sales_Detail_ID"
			
			ThisFormSet.Refresh_Sales_Detail()
		ENDIF
	ENDPROC

	PROCEDURE load_rma_detail
		*ThisFormSet.Load_RMA_Detail()
		
		IF USED('RMA_Detail')
			SELECT RMA_Detail
			
			ThisFormset.frmRMA.pf1.pgView.grdRMA_D.RecordSource = ''
			ThisFormset.frmRMA.pf1.pgBrowse.grdBrRMA_D.RecordSource = ''
			
			ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.RecordSource = ''
			
			USE IN RMA_Detail
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT DISTINCT RMA_Detail.* "
		cSQL = cSQL + " ,SD.Alloy, SD.Form, SD.Sale_PC, SD.Descript, SD.Heat, SD.Lot "
		cSQL = cSQL + " ,ISNULL(SD.ID,0) AS Sales_Detail_ID "
		cSQL = cSQL + " ,SD.PackingSli AS SDPackingSli "
		cSQL = cSQL + " ,AQ.Alloy "
		cSQL = cSQL + " ,SD.Quoted_P,SD.Quoted_QTY"
		cSQL = cSQL + " ,AQ.Alloy+' '+dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS DescriptM "
		
		cSQL = cSQL + " FROM dbo.RMA_Detail "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales_Detail SD ON "
		cSQL = cSQL + " SD.RMA_Detail_ID = RMA_Detail.RMA_Detail_ID AND ISNULL(RMA_Detail.RMA_Detail_ID,0)>0 "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.AllQuotes AQ ON SD.SOitem = AQ.SOitem "
		
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'RMA_Detail' )
		ENDIF
		
		IF USED('RMA_Detail')
			
			SELECT RMA_Detail
			INDEX ON RMA_No TAG RMA_No
			SET ORDER TO TAG RMA_No
			
			ThisFormset.frmRMA.pf1.pgView.grdRMA_D.RecordSource = 'RMA_Detail'
			ThisFormset.frmRMA.pf1.pgBrowse.grdBrRMA_D.RecordSource = 'RMA_Detail'
			
			ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.RecordSource = 'RMA_Detail'
			
			ThisFormSet.RMA_Detail_Refresh()
		ELSE
			MESSAGEBOX('Failed to load RMA_Detail',0+16,"Error")
			RETURN .F.	
		ENDIF
		
	ENDPROC

	PROCEDURE load_rma_detail_print
		*ThisForm.Load_RMA_Detail_P()
		IF USED('RMA_Detail_P')
			SELECT RMA_Detail_P
			USE IN RMA_Detail_P
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE nRMA_No
		nRMA_No = RMA.RMA_No
		
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT S.S_P,S.S_QTY "
		cSQL = cSQL + " ,ISNULL(SD.ID,0) AS Sales_Detail_ID "
		cSQL = cSQL + " ,PS.PackingSli, PS.PCS "
		cSQL = cSQL + " ,TRIM(SD.Alloy)+' '+TRIM(PS.Descript) AS Descript "
		cSQL = cSQL + " ,PS.SOitem,PS.Heat,PS.[Weight] "
		cSQL = cSQL + " ,RD.RMA_Detail_ID "
		cSQL = cSQL + " FROM dbo.RMA_Detail RD "
		cSQL = cSQL + "  INNER JOIN dbo.PackingSlip PS ON RD.Packingsli = PS.Packingsli "
		cSQL = cSQL + "  INNER JOIN dbo.Sales S ON PS.SOitem = S.SOitem "
		cSQL = cSQL + "  LEFT OUTER JOIN dbo.Sales_Detail SD "
		cSQL = cSQL + " 	ON SD.RMA_Detail_ID = RD.RMA_Detail_ID AND ISNULL(RD.RMA_Detail_ID,0)>0 "
		cSQL = cSQL + "  WHERE RD.RMA_No = "+STR(nRMA_No)
		cSQL = cSQL + "  ORDER BY RD.RMA_Detail_ID, RD.Packingsli "
		 
		
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA_Detail_P')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA_Detail_P')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA_Detail_P")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA_Detail_P")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'RMA_Detail_P' )
		ENDIF
		
		
		IF USED('RMA_Detail_P')
			
			SELECT RMA_Detail_P
			INDEX ON RMA_Detail_ID TAG RMA_Detail_ID 
			SET ORDER TO TAG RMA_Detail_ID 
			
		*	SELECT RMA
		*	SET RELATION TO RMA_No INTO RMA_Detail_P
		
		
		ELSE
			MESSAGEBOX('Failed to load RMA_Detail_P',0+16,"Error")
			RETURN .F.	
		ENDIF
	ENDPROC

