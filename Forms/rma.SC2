	PROCEDURE frmRMA.pf1.pgAddEdit.cmdAdd.Click
		IF THIS.Caption = "Add NEW RMA"
		*.cmdAdd.Caption 
			This.parent.cmdClear.Click
			THIS.Caption = "Save RMA"
			
			IF USED('RMA_Detail')
				SELECT RMA_Detail
				REPLACE RMA_Detail.SO_item WITH ''
				
				This.parent.grd_RMA_Detail.Column1.Text1.Value = ''
				This.parent.grd_RMA_Detail.Refresh
				
				REPLACE RMA_Detail.returned WITH CTOD('')
		      	REPLACE RMA_Detail.ItemSale WITH 0
				REPLACE RMA_Detail.refunded WITH 0
				REPLACE RMA_Detail.reason WITH ''
				REPLACE RMA_Detail.inspect WITH ''
				REPLACE RMA_Detail.cancelled WITH .F.
				REPLACE RMA_Detail.Packingsli WITH 0
				REPLACE RMA_Detail.SalesP WITH ''
				REPLACE RMA_Detail.SP_fault WITH 0
				REPLACE RMA_Detail.ReceivingID WITH 0
				REPLACE RMA_Detail.RMA_E WITH .F.
				
				REPLACE RMA_Detail.SDPackingSli WITH 0
				REPLACE RMA_Detail.Heat WITH ''
				REPLACE RMA_Detail.Lot WITH ''
				REPLACE RMA_Detail.DescriptM WITH ''
				
				This.Parent.cmdRemoveItem.Visible = .F.
				This.parent.cmdOpenSelect.SetFocus
				
			ENDIF
		ELSE
			*THIS.Caption = "Save RMA"
			
			PRIVATE nItems, nItems2, lFoundEmpty, nArrayItems, nAddNextItem
			DECLARE anSalesCnt(1)
		
			nArrayItems = ALEN(aSoItems,1)
			DIMENSION aSOitems2(nArrayItems)
			lFoundEmpty = .F.
			nItems2 = 0
		
			*DO WHILE .T.
			FOR nItems = 1 TO ALEN(aSoItems,1)
		
			*	SELECT COUNT(*) FROM HPA!Sales Where Sales.SOItem = aSoItems(nItems) INTO ARRAY anSalesCnt
				IF USED("cntSales_3")
					SELECT cntSales_3
				ELSE
					SELECT 0
				ENDIF
				cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.Sales WITH(NOLOCK) WHERE "
				cSQL = cSQL + " SOItem = dbo.f_ProperSOitem('"+aSoItems(nItems)+"')"
		
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSales_3')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntSales_3')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSales_3")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntSales_3")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'cntSales_3')
				ENDIF
				IF USED('cntSales_3')
					SELECT COUNT(*) FROM cntSales_3 INTO ARRAY anSalesCnt	
					IF anSalesCnt(1) < 1
						lFoundEmpty = .T.
						*Remove from Array
						nArrayItems = nArrayItems - 1
						IF nArrayItems = 0
							EXIT
						ENDIF
						DIMENSION aSOitems2(nArrayItems)
					ELSE
						FOR nAddNextItem = 1 TO ALEN( anSalesCnt,1 )
							nItems2 = nItems2 + 1		
							aSOitems2(nItems2) = anSalesCnt(nAddNextItem,1)
						ENDFOR
					ENDIF
				ENDIF
			ENDFOR
			*ENDDO
			
			***************************************************************************
			PRIVATE nRMA_No,cSOitem
			nRMA_No	= PrepareSQLnum(ThisForm.pf1.pgAddEdit.txtRMA_No.Value,'RMA_No',-3)	&&is 0 
			cSOitem	= PrepareSQLtxt(RMA_Detail.SO_item,'SOitem',10)
			Send_Chatter('RMA_INIT',nRMA_No,cSOitem,"Initiated RMA on '"+cSOitem+"', now needs Approved."+CHR(13)+HTML_SOitem(cSOitem,.T.)+CHR(13)+HTML_RMA_No(nRMA_No,.T.),ThisFormSet.nConnHandle)
			
			***************************************************************************	
			IF ALEN(aSoItems,1) > 0
				ACOPY(aSOitems2,anSalesCnt)
				
		
				IF ThisFormSet.SaveAdd("ADD")
				
					This.Caption = "Add NEW RMA"
					ThisFormSet.ResetAddVars()	
					This.Parent.cmdRemoveItem.Visible = .T.
					
					SELECT RMA
				ENDIF
				
			ELSE
				MESSAGEBOX( "No Valid SO items", 0,"Cannot Save")
			ENDIF
		
		ENDIF
	ENDPROC

