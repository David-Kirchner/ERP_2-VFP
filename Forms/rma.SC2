	PROCEDURE frmRMA.pf1.pgAddEdit.cmdRemoveItem.Click
		PRIVATE cSOitem,nRMA_No
		*cSOitem = This.parent.lstSOitem.Value
		cSOitem = This.parent.grd_RMA_Detail.Column1.Text1.Value
		IF EMPTY(cSOitem)
			cSOitem = ThisFormSet.SOitem 
		ENDIF
		cSOitem = Proper_SO_Item( cSOitem  )
		
		nRMA_No = PrepareSQLnum(This.parent.txtRMA_No.Value,'RMA_No',-3)
		IF nRMA_No < 1 
			MESSAGEBOX("Not able to remove.",16,"No RMA_No")
			RETURN .F.
		ENDIF
		
		IF MESSAGEBOX( "Do you want to remove "+ALLTRIM(cSOitem)+CHR(13)+"from this RMA? ("+ALLTRIM(STR(nRMA_No))+")"+CHR(13)+"All listings of this SO item will be gone."+CHR(13)+"and the RMA number will be removed from dbo.Sales table for this SO item.",4+32,"Remove SO-item") = 6&&yes
			PRIVATE cSQL, nSQLEXEC
			cSQL = "DELETE FROM dbo.RMA_Detail "
			cSQL = cSQL + " WHERE RMA_No="+STR(nRMA_No)
			cSQL = cSQL + " AND SO_item='"+cSoItem+"'"
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ENDIF
		
			************************
			
			IF cSOitem != Proper_SO_Item( "" )
				cSQL = "UPDATE dbo.Sales SET "
				cSQL = cSQL + " RMA_No = 0"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL + " and RMA_No = "+STR(nRMA_No)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC)
				ENDIF
			ENDIF
			
			************************
			PRIVATE nCount, nDrop
			nCount = 0
			nDrop = 0
			
			FOR i = 1 TO ALEN(aSOItems,1)
				IF aSOItems(i) != cSOitem
					nCount = nCount + 1
					DIMENSION aSOItemsNew(nCount)
					aSOItemsNew(nCount) = aSOItems(i)
					
					DIMENSION aReasonNew(nCount)
					aReasonNew(nCount) = gaReason(i)
				ELSE
					nDrop = i
				ENDIF
			ENDFOR
		
			IF nCount = 0
				DIMENSION aSOItems(1)
				aSOItems(1) = " "
				DIMENSION gaReason(1)
				gaReason(1) = " "
			ELSE
				DIMENSION aSOItems(nCount)
				ACOPY(aSOItemsNew,aSOitems)
				
				DIMENSION gaReason(nCount)
				ACOPY(aReasonNew,gaReason)
			ENDIF
			
		*	ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.NumberOfElements = ALEN(aSoItems)
		*	ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.Refresh
			
			IF nDrop - 1 > 0
				IF AELEMENT(aSoItems,1) < nDrop
					ThisFormSet.SOitem = aSoItems( AELEMENT(aSoItems,1) )  &&lAST ONE
				ELSE
					ThisFormSet.SOitem = aSoItems( nDrop - 1)
				ENDIF
			ENDIF
			IF nDrop = 0 AND nCount > 0
				ThisFormSet.SOitem = aSoItems(1)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmRMA.pf1.pgAddEdit.cmdSaveEdit.Click
		
		PRIVATE m.shipcomplete, lRMAsaved
		PRIVATE nCurrRec
		PRIVATE lnSalesNum
		PRIVATE lActionRequest, nSalesNum
		
		lRMAsaved = .F.
		lActionRequest = .T.
		nSalesNum = VAL( LEFT( aSoItems(1), 7))
		IF ALEN( aSoItems ) > 100
			MESSAGEBOX("Over 100 Items were Selected."+CHR(13)+"The program feels this is an Error and will reject the SAVE!",0,"No Save")
			RETURN
		ENDIF
		
		PRIVATE nRMA_No,cCompany,cContact,cEmail,cPhone,cFax,dNotified
		PRIVATE dAPRV_Date,dAPRV_By,cAuth_By,cMoney
		nRMA_No		= PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value,'RMA_No',-3)
		cCompany	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.Value,'Company',30)
		cContact	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtContact.Value,'Contact',20)
		cEmail		= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtEmail.Value,'Email',100)
		
		cPhone		= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtPhone.Value,'Phone',20)
		cFax		= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtFax.Value,'Fax',20)
		dNotified	= PrepareSQLDate(ThisFormset.frmRMA.pf1.pgAddEdit.txtNotified.Value,'Notified')
		dAPRV_Date	= PrepareSQLDate(ThisFormset.frmRMA.pf1.pgAddEdit.txtAPRV_Date.Value,'APRV_Date')
		cAPRV_By	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtAPRV_By.Value,'APRV_By',20)  &&Insert uses 'Not Approved'
		
		cAuth_By	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtAuth_By.Value,'Auth_By',20)
		cMoney		= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtMoney.Value,'Money',-1)
		
		*PRIVATE nCancelled,dReturned,cReason
		*nCancelled	= ThisFormset.frmRMA.pf1.pgAddEdit.txt.Value
		*dReturned	= PrepareSQLDate(ThisFormset.frmRMA.pf1.pgAddEdit.txtReturned.Value,'Returned')
		*cReason	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtReason.Value,'Reason',-1)
		
		
		***********Check Values
		
		IF EMPTY(nRMA_No)
		*	Must be an Insert!	
		ENDIF
		
		IF TYPE("nSalesNum") <> "N"
			 nSalesNum = 0
		ENDIF
		
		IF nRMA_No > 0
			*Update
			ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.VALUE = "UPDATE RMA #"+ALLTRIM(STR(m.nRMA_No))+"."
			
			dAPRV_Date= CTOD('')
			cAPRV_By	= 'Not Approved'
				
			cSQL = "UPDATE dbo.RMA SET "
			cSQL = cSQL + " Company='"+cCompany+"'"
			cSQL = cSQL + ",contact='"+cContact+"'"
			cSQL = cSQL + ",Email='"+cEmail+"'"
			cSQL = cSQL + ",Phone='"+cPhone+"'"
			cSQL = cSQL + ",Fax='"+cFax+"'"
			cSQL = cSQL + ",Notified='"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
			cSQL = cSQL + ",APRV_Date='"+IIF(EMPTY(dAPRV_Date),'',DTOC(dAPRV_Date))+"'"
			cSQL = cSQL + ",APRV_By='"+cAPRV_By+"'"
			cSQL = cSQL + ",Auth_By='"+cAuth_By+"'"
			cSQL = cSQL + ",Money='"+cMoney+"'"
			cSQL = cSQL + " WHERE RMA_No = "+STR(nRMA_No)
			
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ELSE
				lRMAsaved = .T.
				ThisFormSet.Load_RMA("REFRESH")
				MESSAGEBOX("RMA Saved",0,"Saved")
				
				SELECT RMA
				LOCATE FOR RMA_No=nRMA_No
				
			ENDIF
				
		ENDIF
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE frmRMA.pf1.pgAddEdit.cmdSaveItemReason.Click
		PRIVATE cSOitem,nRMA_No
		*cSOitem = PrepareSQLtxt(This.parent.lstSOitem.Value,'SOitem',10)
		*cSOitem = ThisFormSet.SOitem &&= RMA_Detail.SO_item
		cSOitem = PrepareSQLtxt(RMA_Detail.SO_item,'SOitem',10)
		
		
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item('')
		*IF EMPTY(cSOitem)
			cSOitem = ThisFormSet.SOitem 
		ENDIF
		cSOitem = Proper_SO_Item( cSOitem )
		
		
		IF Count_SOIteminSales(cSOitem,ThisFormSet.nConnHandle,'')=0
			MESSAGEBOX("Could not find SOitem '"+cSOitem+"' ",16,"Cannot contiue with save")
			TrackError("Could not find SOitem '"+cSOitem+"' to save REASON. ","Could not find SOitem '"+cSOitem+"' ", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		nRMA_No = PrepareSQLnum(This.parent.txtRMA_No.Value,'RMA_No',-3)
		IF nRMA_No < 1 
			MESSAGEBOX("Not able to Save Reason.",16,"No RMA_No")
			RETURN .F.
		ENDIF
		
		PRIVATE cReason, ccDescrip
		cReason	 = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtReason.Value,'Reason',-1)
		cDescrip = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtDescrip.Value,'Descrip',140)
		
		PRIVATE dReturned, nItemSale, nRefunded, cReturnTo, cSalesP, nSP_Fault, lcncSO_item, nPackingSlip 
		*dReturned = PrepareSQLdate(ThisFormset.frmRMA.pf1.pgAddEdit.txtReturned.Value,'Returned')
		nItemSale = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtItemSale.Value,'ItemSale',-5)
		IF nItemSale = 0
			nItemSale = Get_ItemSaleinSales(cSOitem, ThisFormSet.nConnHandle)
		ENDIF
		nRefunded = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtRefunded.Value,'Refunded',-5)
		cReturnTo =	PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtReturnTo.Value,'ReturnTo',1)
		
		nPackingSli = PrepareSQLtxt(This.Parent.txtPackingSli.Value,'PackingSli',-3)
		nPackingSlip = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtPackingSli.Value,'PackingSli',-3)
		cSalesP	 = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtSalesP.Value,'SalesP',1)
		nSP_Fault = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.spnSP_Fault.Value,'SP_Fault',1)
		lcncSO_item = PrepareSQLchk(ThisFormset.frmRMA.pf1.pgAddEdit.chkCancelSOitem.Value,'cncSO_item')
		
		PRIVATE cSQL, nSQLEXEC				
		**Count SOitem in RMA_Detail
		IF Is_RMA_Detail_RMA_N0andSO_item(nRMA_No, cSoItem, ThisFormSet.nConnHandle) = 0
		
			cSQL = "INSERT INTO dbo.RMA_Detail (RMA_No,SO_item) VALUES ("
			cSQL = cSQL + STR(nRMA_No)
			cSQL = cSQL + ",'"+cSoItem+"')"
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ENDIF	
		ENDIF
		
		
		cSQL = "UPDATE dbo.RMA_Detail SET "
		cSQL = cSQL + " Reason='"+cReason+"'"
		cSQL = cSQL + ",ItemSale="+STR(nItemSale,18,2)
		cSQL = cSQL + ",Refunded ="+STR(nRefunded,18,2)
		cSQL = cSQL + ",cncSO_item="+IIF(lcncSO_item, "1","0")
		cSQL = cSQL + ",PackingSli ="+STR(nPackingSlip)
		cSQL = cSQL + ",SalesP = '"+cSalesP+"'"
		cSQL = cSQL + ",SP_Fault="+STR(nSP_Fault)
		cSQL = cSQL + ",ReturnTo='"+cReturnTo+"'"
		cSQL = cSQL + ",Descrip = '"+cDescrip+"'"
		cSQL = cSQL + " WHERE RMA_No="+STR(nRMA_No)
		cSQL = cSQL + " AND SO_item='"+cSoItem+"'"
		*cSQL = cSQL + " WHERE RMA_Detail_ID = "+STR(nRMA_Detail)
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		ELSE
		
			IF lcncSO_item 
				lOK = Cancel_SOitem(cSOitem, .T., ThisFormSet.nConnHandle, nRMA_No )
			ENDIF
			
			MESSAGEBOX("SOitem '"+cSoItem+"' was saved with Reason for RMA_No "+ALLTRIM(STR(nRMA_No)),0,"Saved")
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmRMA.pf1.pgAddEdit.cmdSavePS.Click
		PRIVATE cSOitem,nRMA_No
		*cSOitem = PrepareSQLtxt(This.parent.lstSOitem.Value,'SOitem',10)
		*cSOitem = ThisFormSet.SOitem &&= RMA_Detail.SO_item
		cSOitem = PrepareSQLtxt(RMA_Detail.SO_item,'SOitem',10)
		
		
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item('')
		*IF EMPTY(cSOitem)
			cSOitem = ThisFormSet.SOitem 
		ENDIF
		cSOitem = Proper_SO_Item( cSOitem )
		
		
		IF Count_SOIteminSales(cSOitem,ThisFormSet.nConnHandle,'')=0
			MESSAGEBOX("Could not find SOitem '"+cSOitem+"' ",16,"Cannot contiue with save")
			TrackError("Could not find SOitem '"+cSOitem+"' to save REASON. ","Could not find SOitem '"+cSOitem+"' ", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		nRMA_No = PrepareSQLnum(This.parent.txtRMA_No.Value,'RMA_No',-3)
		IF nRMA_No < 1 
			MESSAGEBOX("Not able to Save Reason.",16,"No RMA_No")
			RETURN .F.
		ENDIF
		
		PRIVATE cReason, ccDescrip
		cReason	 = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtReason.Value,'Reason',-1)
		cDescrip = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtDescrip.Value,'Descrip',140)
		
		PRIVATE dReturned, nItemSale, nRefunded, cReturnTo, nPackingSlip, cSalesP, nSP_Fault
		*dReturned = PrepareSQLdate(ThisFormset.frmRMA.pf1.pgAddEdit.txtReturned.Value,'Returned')
		nItemSale = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtItemSale.Value,'ItemSale',-5)
		IF nItemSale = 0
			nItemSale = Get_ItemSaleinSales(cSOitem, ThisFormSet.nConnHandle)
		ENDIF
		nRefunded = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtRefunded.Value,'Refunded',-5)
		cReturnTo =	PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtReturnTo.Value,'ReturnTo',1)
		
		nPackingSli = PrepareSQLtxt(This.Parent.txtPackingSli.Value,'PackingSli',-3)
		nPackingSlip = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtPackingSli.Value,'PackingSli',-3)
		cSalesP	 = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtSalesP.Value,'SalesP',1)
		nSP_Fault = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.spnSP_Fault.Value,'SP_Fault',1)
		
		PRIVATE cSQL, nSQLEXEC				
		**Count SOitem in RMA_Detail
		IF Is_RMA_Detail_RMA_N0andSO_item(nRMA_No, cSoItem, ThisFormSet.nConnHandle) = 0
		
			cSQL = "INSERT INTO dbo.RMA_Detail (RMA_No,SO_item) VALUES ("
			cSQL = cSQL + STR(nRMA_No)
			cSQL = cSQL + ",'"+cSoItem+"')"
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ENDIF	
		ENDIF
		
		
		cSQL = "UPDATE dbo.RMA_Detail SET "
		cSQL = cSQL + " Reason='"+cReason+"'"
		cSQL = cSQL + ",ItemSale="+STR(nItemSale,18,2)
		cSQL = cSQL + ",Refunded ="+STR(nRefunded,18,2)
		cSQL = cSQL + ",cncSO_item="+IIF(lcncSO_item, "1","0")
		cSQL = cSQL + ",PackingSli ="+STR(nPackingSlip)
		cSQL = cSQL + ",SalesP = '"+cSalesP+"'"
		cSQL = cSQL + ",SP_Fault="+STR(nSP_Fault)
		cSQL = cSQL + ",ReturnTo='"+cReturnTo+"'"
		cSQL = cSQL + ",Descrip = '"+cDescrip+"'"
		cSQL = cSQL + " WHERE RMA_No="+STR(nRMA_No)
		cSQL = cSQL + " AND SO_item='"+cSoItem+"'"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		ELSE
			MESSAGEBOX("SOitem '"+cSoItem+"' was saved with Reason for RMA_No "+ALLTRIM(STR(nRMA_No)),0,"Saved")
		ENDIF
		
		
	ENDPROC

