	PROCEDURE rma_email
		PARAMETERS nRMA_No 
		*ThisFormSet.RMA_Email()
		
		IF nRMA_No < 1
			TrackError("No RMA_No parameter","No RMA_No parameter", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		SELECT RMA
		SELECT RMA_DETAIL
		PRIVATE curgrec
		curgrec = RECNO('RMA_DETAIL')
		
		PRIVATE cSOitem, nSalesNum
		cSOitem   = PrepareSQLtxt(RMA_Detail.SO_Item,"SOitem",10)
		nSalesNum = Proper_SO_item_SO(cSOitem)
		
		SELECT DISTINCT SO_item FROM RMA_DETAIL ORDER BY SO_item INTO ARRAY acSOitem
		
		IF ALEN(acSOitem,1)=0
			*Not Found
			MESSAGEBOX("Did not find any SO items for RMA_No "+ALLTRIM(STR(nRMA_No))+" to Email",0,"Cannot Email")
			RETURN .F.
		ENDIF
		
		SELECT RMA_DETAIL
		IF curgrec > RECCOUNT('RMA_DETAIL')
			GO top
		ELSE
			GO curgrec
		ENDIF
		
		PRIVATE cAllSOitem, i
		cAllSOitem = ''
		i=0
		
		FOR i = 1 TO ALEN(acSOitem,1)
			IF LEN(cAllSOitem) = 0
				cAllSOitem = acSOitem(i)
			ELSE
				cAllSOitem = cAllSOitem +", "+acSOitem(i)
			ENDIF
		ENDFOR
		
		
		********************
		PRIVATE cFileName,lcReportFullName
		cFileName = "RMA"+ALLTRIM(STR(nRMA_No))+".PDF"
		
		*****************************
		Local loListener As "PdfListener" Of "Pdfx.vcx"
		
		loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
		loListener.cCodePage="CP1252" &&CodePage
		loListener.cTargetFileName = cFileName
		loListener.QuietMode=.F.
		loListener.lCanPrint=.T.
		loListener.lCanEdit=.F.
		loListener.lCanCopy=.T.
		loListener.lCanAddNotes=.F.
		loListener.lEncryptDocument=.F.
		loListener.cMasterPassword=''
		loListener.cUserPassword=''
		loListener.lOpenViewer=.F.
		
		ThisFormSet.Visible = .F.
		
		IF curgrec <= RECCOUNT('RMA_DETAIL')
		
			IF FILE('\Reports\RMA_EMAIL.FRX')
				REPORT FORM \Reports\RMA_EMAIL FOR RMA_No = nRMA_No Object loListener
				WAIT WINDOW "REPORT FORM \Reports\RMA_EMAIL Object loListener" TIMEOUT 1
			ELSE
				IF FILE('Reports\RMA.FRX')
					REPORT FORM Reports\RMA_EMAIL FOR RMA_No = nRMA_No Object loListener
					WAIT WINDOW "REPORT FORM Reports\RMA_EMAIL Object loListener" TIMEOUT 1
				ELSE
					MESSAGEBOX("No File 'reports\RMA_EMAIL.FRX'")
					TrackError("Send Email Error","Report form '\reports\RMA_EMAIL' not found","RMA:cmdPrint.Valid",LINENO(1))
		
					RETURN .F.
				ENDIF
			ENDIF
			
			
			SELECT RMA_DETAIL
			GO curgrec
		ELSE
			MESSAGEBOX('Record pointer off!'+CHR(13)+'Try to go prev and next to fix.',0+16,"Not on a record.")
			RETURN .F.
		ENDIF
		
		
		ThisFormSet.Visible = .T.
		RELEASE loListener
		
		*	WAIT WINDOW "Making PDF" TIMEOUT 2
		PRIVATE nCount
		nCount = 0
		DO WHILE NOT FILE(cFileName) AND nCount < 3
			WAIT WINDOW "Waiting for file:"+cFileName+" to be made." TIMEOUT 1
			nCount = nCount + 1
		ENDDO
		
		*SET PRINTER OFF
		*SET PRINTER TO DEFAULT
		*GO TOP IN SalesQuote
		
		PRIVATE cEmailTo, cEmailFrom, cSubject, cMessage, cNewPDFName 
		cEmailTo	=	PrepareSQLtxt(RMA.Email,'Email',100)
		IF LEN(cEmailTo) > 0
			cEmailTo = cEmailTo + " ; "+"Receiving@SpaceAlloysUSA.com"
		ELSE
			cEmailTo = "Receiving@SpaceAlloysUSA.com"
		ENDIF
		cEmailTo = "David.Kirchner@SpaceAlloysUSA.com"	&&use for testing
		
		cEmailFrom	= "Receiving@SpaceAlloysUSA.com"
		cSubject	= "RMA "+ALLTRIM(STR(nRMA_No))
		cMessage	= "RMA "+ALLTRIM(STR(nRMA_No))+" covering SOitems;"+cAllSOitem 
		cNewPDFName = cFileName
		
		
		IF FILE(cFileName)
			cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName )
			WAIT WINDOW "Finished Send routine" TIMEOUT 2
		
			DO CASE
			CASE "Mail queued" $ cAns
				WAIT WINDOW "Mail queued." NOWAIT
				TrackMess("RMA "+ALLTRIM(STR(nRMA_No))+" was Emailed to ("+cEmailTo +") SO "+ALLTRIM(STR(nSalesNum ))+" RMA.RMA_Email()")
				*Save_Sales_Status( nSalesNum, 'Email', 'Email RMA '+cSOitem, ThisFormSet.nConnHandle )
				*lOK = Save_SOitem_Status( cSOitem, nSalesNum, "Emailed RMA "+ALLTRIM(STR(nRMA_No))+" for "+cSOitem, "RMA "+ALLTRIM(STR(nRMA_No))+" was Emailed to ("+cEmailTo+")" , ThisFormSet.nConnHandle)
				
				FOR i = 1 TO ALEN(acSOitem,1)
					lOK = Save_SOitem_Status( acSOitem(i), nSalesNum, "Emailed RMA "+ALLTRIM(STR(nRMA_No))+" for "+acSOitem(i), "RMA "+ALLTRIM(STR(nRMA_No))+" was Emailed to ("+cEmailTo+")" , ThisFormSet.nConnHandle)
				ENDFOR
		
			CASE NOT EMPTY(cAns)
				MESSAGEBOX( cANS,0,"SQL Returned Message!")
			OTHERWISE
				WAIT WINDOW "Email Complete" NOWAIT
				TrackMess("RMA "+ALLTRIM(STR(nRMA_No))+" was Emailed to ("+cEmailTo+") SO "+ALLTRIM(STR(nSalesNum ))+" RMA.RMA_Email()")
				*Save_Sales_Status( nSalesNum, 'Email', 'Email RMA '+cSOitem, ThisFormSet.nConnHandle )
				*lOK = Save_SOitem_Status( cSOitem, nSalesNum, "Emailed RMA "+ALLTRIM(STR(nRMA_No))+" for "+cSOitem, "RMA "+ALLTRIM(STR(nRMA_No))+" was Emailed to ("+cEmailTo+")" , ThisFormSet.nConnHandle)
				
				FOR i = 1 TO ALEN(acSOitem,1)
					lOK = Save_SOitem_Status( acSOitem(i), nSalesNum, "Emailed RMA "+ALLTRIM(STR(nRMA_No))+" for "+acSOitem(i), "RMA "+ALLTRIM(STR(nRMA_No))+" was Emailed to ("+cEmailTo+")" , ThisFormSet.nConnHandle)
				ENDFOR
		
			ENDCASE
		ELSE
			MESSAGEBOX("Could not Create PDF file!",0,"Error")
		ENDIF
		***********************************************
		
		SELECT RMA_DETAIL
		GO curgrec
		RETURN
		
		
		
	ENDPROC

	PROCEDURE rma_no_refresh
		PARAMETERS pRMA_Detail_ID
		*ThisFormSet.RMA_No_refresh()
		
		PRIVATE nRMA_Detail_ID
		nRMA_Detail_ID = PrepareSQLnum(pRMA_Detail_ID,'RMA_Detail ',-3)
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE nRMA_No
		nRMA_No = RMA.RMA_No
		
		aSoItems(1) = ""
		ThisFormSet.SOitem = aSoItems(1)
		
		IF USED('RMA_Detail')
			ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.RecordSource = ""
			USE IN RMA_Detail
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT DISTINCT RMA_Detail.* "	&&[Descrip]
		cSQL = cSQL + ",(SELECT TOP 1 SD.Alloy FROM dbo.Sales_Detail SD WHERE SD.Soitem = RMA_Detail.SO_item ) AS Alloy "
		cSQL = cSQL + ",(SELECT TOP 1 SD.Form FROM dbo.Sales_Detail SD WHERE SD.Soitem = RMA_Detail.SO_item ) AS [Form] "
		cSQL = cSQL + ",(SELECT TOP 1 SD.Sale_PC FROM dbo.Sales_Detail SD WHERE SD.Soitem = RMA_Detail.SO_item ) AS Sale_PC "
		cSQL = cSQL + ",(SELECT TOP 1 SD.Descript FROM dbo.Sales_Detail SD WHERE SD.Soitem = RMA_Detail.SO_item ) AS Descript " 
		cSQL = cSQL + ",(SELECT TOP 1 SD.Heat FROM dbo.Sales_Detail SD WHERE SD.Soitem = RMA_Detail.SO_item ) AS Heat "
		cSQL = cSQL + ",(SELECT TOP 1 SD.Lot FROM dbo.Sales_Detail SD WHERE SD.Soitem = RMA_Detail.SO_item ) AS Lot "
		cSQL = cSQL + ",(SELECT TOP 1 SD.PackingSli FROM dbo.Sales_Detail SD WHERE SD.Soitem = RMA_Detail.SO_item ) AS SDPackingSli "
		cSQL = cSQL + ",(SELECT TOP 1 RTRIM(AQ.Alloy)+' '+dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) FROM dbo.AllQuotes AQ WHERE AQ.SOitem = RMA_Detail.SO_item) AS DescriptM "
		cSQL = cSQL + " FROM dbo.RMA_Detail "
		cSQL = cSQL + " WHERE RMA_Detail.RMA_No = "+STR(nRMA_No)
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'RMA_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "RMA_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'RMA_Detail')
		ENDIF
		
		
		IF USED('RMA_Detail')
			IF RECCOUNT('RMA_Detail') > 0
				IF nRMA_Detail_ID > 0
					SELECT RMA_Detail
					LOCATE FOR RMA_Detail_ID = nRMA_Detail_ID
					IF FOUND('RMA_Detail')
						ThisFormSet.SOitem = RMA_Detail.SO_item
					ENDIF
				ENDIF
			ENDIF
			
			ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.RecordSource = "RMA_Detail"
			ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.ColumnCount = 1
			ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.Column1.Width = ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.Width
			ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.Column1.ControlSource = 'RMA_Detail.SO_Item'
			ThisFormset.frmRMA.pf1.pgAddEdit.grd_RMA_Detail.Column1.Header1.Caption = "SO item"
			
			ThisFormset.frmRMA.pf1.pgAddEdit.txtReturned.Value	= IIF(EMPTY(RMA_Detail.Returned),'',RMA_Detail.Returned)
			ThisFormset.frmRMA.pf1.pgAddEdit.txtReason.Value	= ShowSQLtxt(RMA_Detail.Reason,'Reason',-3)
			ThisFormset.frmRMA.pf1.pgAddEdit.txtDescrip.Value	= ShowSQLtxt(RMA_Detail.Descrip,'Descrip',140)
			
			ThisFormset.frmRMA.pf1.pgAddEdit.txtItemSale.Value	= PrepareSQLnum(RMA_Detail.ItemSale,'ItemSale',-5)
			ThisFormset.frmRMA.pf1.pgAddEdit.txtRefunded.Value	= PrepareSQLnum(RMA_Detail.Refunded,'Refunded',-5)
			ThisFormset.frmRMA.pf1.pgAddEdit.txtReturnTo.Value	= PrepareSQLtxt(RMA_Detail.ReturnTo,'ReturnTo',1)
			ThisFormset.frmRMA.pf1.pgAddEdit.txtSalesP.Value 	= PrepareSQLtxt(RMA_Detail.SalesP,'SalesP',1)
			ThisFormset.frmRMA.pf1.pgAddEdit.spnSP_Fault.Value	= PrepareSQLnum(RMA_Detail.SP_Fault,'SP_Fault',-1)
			ThisFormset.frmRMA.pf1.pgAddEdit.chkCancelSOitem.Value = PrepareSQLbit(RMA_Detail.cncSO_item,'cncSO_item')
			ThisFormset.frmRMA.pf1.pgAddEdit.txtPackingSli.Value	= PrepareSQLnum(RMA_Detail.SDPackingSli,'PackingSli',-3)
			
			
			ThisFormset.frmRMA.pf1.pgAddEdit.txtReceivingID.Value = PrepareSQLnum(RMA_Detail.ReceivingID,'ReceivingID',-3)
			ThisFormset.frmRMA.pf1.pgAddEdit.txtHeat.Value		= PrepareSQLtxt(RMA_Detail.Heat,'Heat',50)
			ThisFormset.frmRMA.pf1.pgAddEdit.txtLot.Value		= PrepareSQLtxt(RMA_Detail.Lot,'Lot',10)
		
			ThisFormset.frmRMA.pf1.pgAddEdit.txtSOiDesc.Value =  PrepareSQLtxt(RMA_Detail.DescriptM,'DescriptM',100)
			ThisFormset.frmRMA.pf1.pgAddEdit.chkSameReason.Value = get_RMA_Detail_SameReason(nRMA_No,ThisFormSet.nConnHandle)
			
			*SELECT Reason FROM RMA_Detail INTO ARRAY gaReason
			ThisFormSet.get_aSOitems()
		
		ELSE
		*	ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.Refresh
		ENDIF
		
		
	ENDPROC

	PROCEDURE rma_refresh
		*ThisFormSet.RMA_Refresh()
		
		ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value	= RMA.RMA_No
		ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.Value	= RMA.Company
		ThisFormset.frmRMA.pf1.pgAddEdit.txtContact.Value	= RMA.Contact
		ThisFormset.frmRMA.pf1.pgAddEdit.txtEmail.Value	= RMA.Email
		ThisFormset.frmRMA.pf1.pgAddEdit.txtPhone.Value		= RMA.Phone
		ThisFormset.frmRMA.pf1.pgAddEdit.txtFax.Value		= RMA.Fax
		ThisFormset.frmRMA.pf1.pgAddEdit.txtNotified.Value	= RMA.Notified
		ThisFormset.frmRMA.pf1.pgAddEdit.txtAPRV_Date.Value	= RMA.APRV_Date
		ThisFormset.frmRMA.pf1.pgAddEdit.txtAPRV_By.Value	= RMA.APRV_By
		
		ThisFormset.frmRMA.pf1.pgAddEdit.txtAUTH_By.Value	= RMA.AUTH_By
		ThisFormset.frmRMA.pf1.pgAddEdit.txtMoney.Value		= RMA.Money
		
		ThisFormset.frmRMA.pf1.pgAddEdit.edtWhoAdd.Value	= RMA.WhoAdd
		
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETER pSaveType
		PRIVATE m.shipcomplete, lRMAsaved
		PRIVATE nCurrRec
		PRIVATE lnSalesNum
		PRIVATE lActionRequest, nSalesNum
		
		lRMAsaved = .F.
		lActionRequest = .T.
		nSalesNum = VAL( LEFT( aSoItems(1), 7))
		IF ALEN( aSoItems ) > 100
			MESSAGEBOX("Over 100 Items were Selected."+CHR(13)+"The program feels this is an Error and will reject the SAVE!",0,"No Save")
			RETURN
		ENDIF
		
		PRIVATE nRMA_No,cCompany,cContact,cEmail,cPhone,cFax,dNotified
		PRIVATE dAPRV_Date,dAPRV_By,cAuth_By,cMoney
		nRMA_No		= PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value,'RMA_No',-3)
		cCompany	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.Value,'Company',30)
		cContact	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtContact.Value,'Contact',20)
		cEmail		= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtEmail.Value,'Email',100)
		cPhone		= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtPhone.Value,'Phone',20)
		cFax		= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtFax.Value,'Fax',20)
		dNotified	= PrepareSQLDate(ThisFormset.frmRMA.pf1.pgAddEdit.txtNotified.Value,'Notified')
		dAPRV_Date	= PrepareSQLDate(ThisFormset.frmRMA.pf1.pgAddEdit.txtAPRV_Date.Value,'APRV_Date')
		cAPRV_By	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtAPRV_By.Value,'APRV_By',20)  &&Insert uses 'Not Approved'
		
		cAuth_By	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtAuth_By.Value,'Auth_By',20)
		cMoney		= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtMoney.Value,'Money',-1)
		
		*PRIVATE nCancelled,dReturned,cReason
		*nCancelled	= ThisFormset.frmRMA.pf1.pgAddEdit.txt.Value
		*dReturned	= PrepareSQLDate(ThisFormset.frmRMA.pf1.pgAddEdit.txtReturned.Value,'Returned')
		*cReason	= PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtReason.Value,'Reason',-1)
		
		
		***********Check Values
		
		IF EMPTY(nRMA_No)
		*	Must be an Insert!	
		ENDIF
		
		IF TYPE("nSalesNum") <> "N"
			 nSalesNum = 0
		ENDIF
		
		IF TYPE("dNotified") <> "D" OR EMPTY(dNotified)
			MESSAGEBOX( "You need an 'Notified' date!"+CHR(13)+"Set to todays date.",0,"No Save")
			ThisFormset.frmRMA.pf1.pgAddEdit.txtNotified.Value = DATE()
			ThisFormset.frmRMA.pf1.pgAddEdit.txtNotified.Refresh
			RETURN .F.
		ENDIF
		
		IF ALEN(aSoItems) = 0
			MESSAGEBOX( "You have no SO Items selected!"+CHR(13)+"Click 'Select Items' to find the item to be returned.",0,"No Save" )
			RETURN .F.
		ENDIF
		
		IF EMPTY(cAuth_By)
			PRIVATE cMach_User
			cMach_User = SYS(0)
			cAuth_By = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		ENDIF	
		
		IF nRMA_No > 0
			*Update
			ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.VALUE = "UPDATE RMA #"+ALLTRIM(STR(m.nRMA_No))+"."
			
			dAPRV_Date= CTOD('')
			cAPRV_By	= 'Not Approved'
				
			cSQL = "UPDATE dbo.RMA SET "
			cSQL = cSQL + " Company='"+cCompany+"'"
			cSQL = cSQL + ",contact='"+cContact+"'"
			cSQL = cSQL + ",Email='"+cEmail+"'"
			cSQL = cSQL + ",Phone='"+cPhone+"'"
			cSQL = cSQL + ",Fax='"+cFax+"'"
			cSQL = cSQL + ",Notified='"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
			cSQL = cSQL + ",APRV_Date='"+IIF(EMPTY(dAPRV_Date),'',DTOC(dAPRV_Date))+"'"
			cSQL = cSQL + ",APRV_By='"+cAPRV_By+"'"
			cSQL = cSQL + ",Auth_By='"+cAuth_By+"'"
			cSQL = cSQL + ",Money='"+cMoney+"'"
			cSQL = cSQL + " WHERE RMA_No = "+STR(nRMA_No)
			
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ELSE
				lRMAsaved = .T.
			ENDIF
				
			*UPDATE Details **************
			PRIVATE cReason, cDescrip
			cReason  = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtReason.Value,'Reason',-1)
			cDescrip = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtDescrip.Value,'Descrip',140)
			
			PRIVATE dReturned, nItemSale, nRefunded, nPackingSlip, cSalesP, nSP_Fault, lcncSO_item
		
			FOR nItems = 1 TO ALEN(aSoItems,1)
				IF NOT EMPTY(ALLTRIM(aSoItems(nItems)))	
					*Do not let blank SOitems into RMA_Detail
					dReturned = PrepareSQLdate(ThisFormset.frmRMA.pf1.pgAddEdit.txtReturned.Value,'Returned')
					nItemSale = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtItemSale.Value,'ItemSale',-5)
					IF nItemSale = 0
						nItemSale = Get_ItemSaleinSales(aSoItems(nItems), ThisFormSet.nConnHandle)
					ENDIF
					nRefunded = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtRefunded.Value,'Refunded',-5)
					nPackingSlip = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtPackingSli.Value,'PackingSli',-3)
					cSalesP	 = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtSalesP.Value,'SalesP',1)
					nSP_Fault = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.spnSP_Fault.Value,'SP_Fault',1)
					lcncSO_item = PrepareSQLchk(ThisFormset.frmRMA.pf1.pgAddEdit.chkCancelSOitem.Value,'cncSO_item')
						
					IF Is_RMA_Detail_RMA_N0andSO_item(nRMA_No,aSoItems(nItems),ThisFormSet.nConnHandle) = 0
						*Add-Insert
						cSQL = "INSERT INTO RMA_Detail "
						cSQL = cSQL + "(RMA_No, SO_item, ItemSale, Refunded, Reason, Inspect, cncSO_item, Cancelled "
						cSQL = cSQL + ",PackingSli, SalesP, SP_Fault, Descrip) VALUES ("
						cSQL = cSQL + " "+STR(nRMA_No)
						cSQL = cSQL + ",'"+aSoItems(nItems)+"'"
						cSQL = cSQL + ","+STR(nItemSale,18,4)
						cSQL = cSQL + ","+STR(nRefunded,18,4)
						cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
						cSQL = cSQL + ",''" &&Inspect
						cSQL = cSQL + ","+IIF(lcncSO_item,"1","0")
						cSQL = cSQL + ",0" && Cancelled 
						cSQL = cSQL + ","+STR(nPackingSlip)
						cSQL = cSQL + ",'"+cSalesP+"'"
						cSQL = cSQL + ","+STR(nSP_Fault)
						cSQL = cSQL + ",'"+cDescrip+"'"
						cSQL = cSQL + ")"
						
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
						ENDIF
					ELSE
						*Update
						cSQL = "UPDATE dbo.RMA_Detail SET "
						cSQL = cSQL + " Reason='"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
						cSQL = cSQL + ",ItemSale="+STR(nItemSale,18,2)
						cSQL = cSQL + ",Refunded ="+STR(nRefunded,18,2)
						cSQL = cSQL + ",cncSO_item="+IIF(lcncSO_item,"1","0")
						cSQL = cSQL + ",PackingSli ="+STR(nPackingSlip)
						cSQL = cSQL + ",SalesP = '"+cSalesP+"'"
						cSQL = cSQL + ",SP_Fault="+STR(nSP_Fault)
						cSQL = cSQL + ",Descrip = '"+cDescrip+"'"
						cSQL = cSQL + " WHERE RMA_No="+STR(nRMA_No)
						cSQL = cSQL + " AND SO_item='"+aSoItems(nItems)+"'"
					
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
						ENDIF
					ENDIF
					
					nSalesNum = VAL( LEFT( aSoItems(nItems), 7))
					IF lActionRequest
						*Add to Action Request
						PRIVATE nCount_AR
						nCount_AR = Count_ActionRequest( nRMA_No, ThisFormSet.nConnHandle)	
						IF nCount_AR = 0
							*Insert
							cSQL = "INSERT INTO dbo.ActionRequest "
							cSQL = cSQL + "(RMA,SalesNum,POnum,Customer,ARdate,TO_,Problem,Instruction,ARperson) VALUES ("
							cSQL = cSQL + ""+STR(nRMA_No)
							cSQL = cSQL + ","+STR(nSalesNum)
							cSQL = cSQL + ",0"&&+STR(nPOnum)
							cSQL = cSQL + ",'"+cCompany+"'"
							cSQL = cSQL + ",'"+DTOC(DATE())+"'"
							cSQL = cSQL + ",'HPA'"
							cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
							cSQL = cSQL + ",' '"
							cSQL = cSQL + ",'"+cAuth_By+"'"
							cSQL = cSQL + ")"
								  
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
							ELSE
								lActionRequestsaved = .T.
							ENDIF
		
						ELSE
							*Update
							cSQL = "UPDATE dbo.ActionRequest SET "
							cSQL = cSQL + " RMA="+STR(nRMA_No)
							cSQL = cSQL + ",SalesNum="+STR(nSalesNum)
							cSQL = cSQL + ",POnum=0"&&+STR(nPOnum)
							cSQL = cSQL + ",Customer='"+cCompany+"'"
							cSQL = cSQL + ",ARdate'"+DTOC(DATE())+"'"
							cSQL = cSQL + ",TO_='HPA'"
							cSQL = cSQL + ",Problem='"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
							cSQL = cSQL + ",Instruction=' '"
							cSQL = cSQL + ",ARperson='"+cAuth_By+"'"
								  
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
							ELSE
								lActionRequestsaved = .T.
							ENDIF
						ENDIF
					ENDIF
					*Remove blank SOItem entries
					*DELETE FROM RMA_Detail WHERE RMA_No = m.nRMA_No AND SO_item = ''
				ENDIF
				
				IF !EMPTY( aSoItems(nItems) )
					*UPDATE HPA!Sales SET RMA_NO = m.nRMA_No WHERE SOitem = aSoItems(nItems)
					UPDATE_RMA_NoinSales( nRMA_No,aSoItems(nItems), ThisFormSet.nConnHandle)
				ENDIF
			ENDFOR
			
			MESSAGEBOX("This update has voided the previous approval."+CHR(10)+"This needs to be 'Approved'.",0+64,"Not Approved")
			
			ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.VALUE = "RMA #"+ALLTRIM(STR(m.nRMA_No))+" saved."+CHR(13)+ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.VALUE
			ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.REFRESH
		
			
		ELSE
			
			*INSERT
			
			nRMA_No = 0
			
			m.dAPRV_Date= CTOD('')
			m.cAPRV_By	= 'Not Approved'
		
			cSQL = "INSERT INTO dbo.RMA (Company,contact,Email,Phone,Fax,Notified,APRV_Date,APRV_By,Auth_By,Money,Cancelled) VALUES  ("
			cSQL = cSQL + " '"+cCompany+"'"
			cSQL = cSQL + ",'"+cContact+"'"
			cSQL = cSQL + ",'"+cEmail+"'"
			cSQL = cSQL + ",'"+cPhone+"'"
			cSQL = cSQL + ",'"+cFax+"'"
			cSQL = cSQL + ",'"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
			cSQL = cSQL + ",'"+IIF(EMPTY(dAPRV_Date),'',DTOC(dAPRV_Date))+"'"
			cSQL = cSQL + ",'"+cAPRV_By+"'"
			cSQL = cSQL + ",'"+cAuth_By+"'"
			cSQL = cSQL + ",'"+cMoney+"'"
			cSQL = cSQL + ",0"
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			ELSE
				lRMAsaved = .T.
			ENDIF
			
			IF lRMAsaved 
				**Get nRMA_No
				IF USED('tmpRMA_No')
					USE IN tmpRMA_No
				ENDIF
				SELECT 0
				cSQL = "SELECT RMA_No FROM dbo.RMA WHERE "
				cSQL = cSQL + " Company='"+cCompany+"'"
				cSQL = cSQL + " AND contact='"+cContact+"'"
				cSQL = cSQL + " AND Email='"+cEmail+"'"
				cSQL = cSQL + " AND Phone='"+cPhone+"'"
				cSQL = cSQL + " AND Fax='"+cFax+"'"
				cSQL = cSQL + " AND Notified='"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
				cSQL = cSQL + " AND Auth_By='"+cAuth_By+"'"
				cSQL = cSQL + " AND Money='"+cMoney+"'"
			
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRMA_No')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpRMA_No' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRMA_No")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRMA_No")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRMA_No' )
				ENDIF
				IF USED('tmpRMA_No')
					IF VARTYPE(tmpRMA_No.RMA_No) = 'N'
						nRMA_No = tmpRMA_No.RMA_No
						ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.Value = "New RMA is:"+ALLTRIM(STR(nRMA_No))+CHR(13)+ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.Value 
					ENDIF
				ENDIF
			ENDIF	
			
			
			IF lRMAsaved 
				*Save Details **************
				PRIVATE lcReason, cDescrip
				lcReason  = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtReason.Value,'Reason',-1)
				lcDescrip = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtDescrip.Value,'Descrip',140)
				
				PRIVATE dReturned, nItemSale, nRefunded, nPackingSlip, cSalesP, nSP_Fault
				
				FOR nItems = 1 TO ALEN(aSoItems,1)
					
					
					dReturned = PrepareSQLdate(ThisFormset.frmRMA.pf1.pgAddEdit.txtReturned.Value,'Returned')
					nItemSale = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtItemSale.Value,'ItemSale',-5)
					IF nItemSale = 0
						nItemSale = Get_ItemSaleinSales(aSoItems(nItems), ThisFormSet.nConnHandle)
					ENDIF
					nRefunded = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtRefunded.Value,'Refunded',-5)
					nPackingSlip = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtPackingSli.Value,'PackingSli',-3)
					cSalesP	 = PrepareSQLtxt(ThisFormset.frmRMA.pf1.pgAddEdit.txtSalesP.Value,'SalesP',1)
					nSP_Fault = PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.spnSP_Fault.Value,'SP_Fault',1)
					lcncSO_item = PrepareSQLchk(ThisFormset.frmRMA.pf1.pgAddEdit.chkCancelSOitem.Value,'cncSO_item')
					
			
					IF NOT EMPTY(ALLTRIM(aSoItems(nItems)))	
						*Do not let blank SOitems into RMA_Detail
						
						IF ThisFormset.frmRMA.pf1.pgAddEdit.chkSameReason.Value=1
			*				All SO items have same Return Reason			
							
							cSQL = "INSERT INTO RMA_Detail "
							cSQL = cSQL + "(RMA_No, SO_item, ItemSale, Refunded, Reason, Inspect, cncSO_item, Cancelled "
							cSQL = cSQL + ",PackingSli, SalesP, SP_Fault, Descrip) VALUES ("
							cSQL = cSQL + " "+STR(nRMA_No)
							cSQL = cSQL + ",'"+aSoItems(nItems)+"'"
							cSQL = cSQL + ","+STR(nItemSale,18,4)
							cSQL = cSQL + ","+STR(nRefunded,18,4)
							cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
							cSQL = cSQL + ",''" &&Inspect
							cSQL = cSQL + ","+IIF(lcncSO_item,"1","0")
							cSQL = cSQL + ",0" && Cancelled 
							cSQL = cSQL + ","+STR(nPackingSlip)
							cSQL = cSQL + ",'"+cSalesP+"'"
							cSQL = cSQL + ","+STR(nSP_Fault)
							cSQL = cSQL + ",'"+cDescrip+"'"
							cSQL = cSQL + ")"
							
		
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							ENDIF
		
							nSalesNum = VAL( LEFT( aSoItems(nItems), 7))
							*Add to Action Request
							IF lActionRequest
								*Add to Action Request
								PRIVATE nCount_AR
								nCount_AR = Count_ActionRequest( nRMA_No, ThisFormSet.nConnHandle)	
								IF nCount_AR = 0
									*Insert
									cSQL = "INSERT INTO dbo.ActionRequest "
									cSQL = cSQL + "(RMA,SalesNum,POnum,Customer,ARdate,TO_,Problem,Instruction,ARperson) VALUES ("
									cSQL = cSQL + ""+STR(nRMA_No)
									cSQL = cSQL + ","+STR(nSalesNum)
									cSQL = cSQL + ",0"&&+STR(nPOnum)
									cSQL = cSQL + ",'"+cCompany+"'"
									cSQL = cSQL + ",'"+DTOC(DATE())+"'"
									cSQL = cSQL + ",'HPA'"
									cSQL = cSQL + ",'"+PrepareSQLtxt(lcReason,'Reason',-1)+"'"
									cSQL = cSQL + ",' '"
									cSQL = cSQL + ",'"+cAuth_By+"'"
									cSQL = cSQL + ")"
										  
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
									ENDDO
									IF nSQLEXEC < 0 &&Try again!
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL 2' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
											
											IF nSQLEXEC < 0
												IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
													nSQLEXEC = 0
												ENDIF
											ENDIF
										ENDDO
									ENDIF 
									IF nSQLEXEC < 0
										SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
									ELSE
										lActionRequestsaved = .T.
									ENDIF
		
								ELSE
									
									*Update
									cSQL = "UPDATE dbo.ActionRequest SET "
									cSQL = cSQL + " RMA="+STR(nRMA_No)
									cSQL = cSQL + ",SalesNum="+STR(nSalesNum)
									cSQL = cSQL + ",POnum=0"&&+STR(nPOnum)
									cSQL = cSQL + ",Customer='"+cCompany+"'"
									cSQL = cSQL + ",ARdate'"+DTOC(DATE())+"'"
									cSQL = cSQL + ",TO_='HPA'"
									cSQL = cSQL + ",Problem='"+PrepareSQLtxt(lcReason,'Reason',-1)+"'"
									cSQL = cSQL + ",Instruction=' '"
									cSQL = cSQL + ",ARperson='"+cAuth_By+"'"
										  
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL)
									ENDDO
									IF nSQLEXEC < 0 &&Try again!
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL 2' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
											
											IF nSQLEXEC < 0
												IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
													nSQLEXEC = 0
												ENDIF
											ENDIF
										ENDDO
									ENDIF 
									IF nSQLEXEC < 0
										SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
									ELSE
										lActionRequestsaved = .T.
									ENDIF
								ENDIF
							ENDIF
							
							*Remove blank SOItem entries
							*DELETE FROM RMA_Detail WHERE RMA_No = m.nRMA_No AND SO_item = ''
						ELSE
							** SO items have different Reasons
							
							cSQL = "INSERT INTO RMA_Detail "
							cSQL = cSQL + "(RMA_No, SO_item, ItemSale, Refunded, Reason, Inspect, cncSO_item, Cancelled "
							cSQL = cSQL + ",PackingSli, SalesP, SP_Fault, Descrip) VALUES ("
							cSQL = cSQL + " "+STR(nRMA_No)
							cSQL = cSQL + ",'"+aSoItems(nItems)+"'"
							cSQL = cSQL + ","+STR(nItemSale,18,4)
							cSQL = cSQL + ","+STR(nRefunded,18,4)
							cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
							cSQL = cSQL + ",''" &&Inspect
							cSQL = cSQL + ","+IIF(lcncSO_item,"1","0")
							cSQL = cSQL + ",0" && Cancelled 
							cSQL = cSQL + ","+STR(nPackingSlip)
							cSQL = cSQL + ",'"+cSalesP+"'"
							cSQL = cSQL + ","+STR(nSP_Fault)
							cSQL = cSQL + ",'"+cDescrip+"'"
							cSQL = cSQL + ")"
							
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							ENDIF
							
							nSalesNum = VAL( LEFT( aSoItems(nItems), 7))
							IF lActionRequest
								*Add to Action Request
								PRIVATE nCount_AR
								nCount_AR = Count_ActionRequest( nRMA_No, ThisFormSet.nConnHandle)	
								IF nCount_AR = 0
									*Insert
									cSQL = "INSERT INTO dbo.ActionRequest "
									cSQL = cSQL + "(RMA,SalesNum,POnum,Customer,ARdate,TO_,Problem,Instruction,ARperson) VALUES ("
									cSQL = cSQL + ""+STR(nRMA_No)
									cSQL = cSQL + ","+STR(nSalesNum)
									cSQL = cSQL + ",0"&&+STR(nPOnum)
									cSQL = cSQL + ",'"+cCompany+"'"
									cSQL = cSQL + ",'"+DTOC(DATE())+"'"
									cSQL = cSQL + ",'HPA'"
									cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
									cSQL = cSQL + ",' '"
									cSQL = cSQL + ",'"+cAuth_By+"'"
									cSQL = cSQL + ")"
										  
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
									ENDDO
									IF nSQLEXEC < 0 &&Try again!
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL 2' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
											
											IF nSQLEXEC < 0
												IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
													nSQLEXEC = 0
												ENDIF
											ENDIF
										ENDDO
									ENDIF 
									IF nSQLEXEC < 0
										SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
									ELSE
										lActionRequestsaved = .T.
									ENDIF
		
								ELSE
									*Update
									cSQL = "UPDATE dbo.ActionRequest SET "
									cSQL = cSQL + " RMA="+STR(nRMA_No)
									cSQL = cSQL + ",SalesNum="+STR(nSalesNum)
									cSQL = cSQL + ",POnum=0"&&+STR(nPOnum)
									cSQL = cSQL + ",Customer='"+cCompany+"'"
									cSQL = cSQL + ",ARdate'"+DTOC(DATE())+"'"
									cSQL = cSQL + ",TO_='HPA'"
									cSQL = cSQL + ",Problem='"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"
									cSQL = cSQL + ",Instruction=' '"
									cSQL = cSQL + ",ARperson='"+cAuth_By+"'"
										  
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL)
									ENDDO
									IF nSQLEXEC < 0 &&Try again!
										nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL 2' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
											
											IF nSQLEXEC < 0
												IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
													nSQLEXEC = 0
												ENDIF
											ENDIF
										ENDDO
									ENDIF 
									IF nSQLEXEC < 0
										SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC)
									ELSE
										lActionRequestsaved = .T.
									ENDIF
								ENDIF
							ENDIF
		
		
						ENDIF
						*Remove blank SOItem entries
						*DELETE FROM RMA_Detail WHERE RMA_No = RMA_No AND SO_item = ''
						
					ENDIF
					
			
					IF !EMPTY( aSoItems(nItems) )
						lCancelled = .F.
						UpdateSalesWithRMA_No( aSoItems(nItems), nRMA_No, lCancelled , ThisFormSet.nConnHandle)
									
					ENDIF
				ENDFOR
				
				ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.VALUE = "RMA #"+ALLTRIM(STR(nRMA_No))+" saved."
				ThisFormset.frmRMA.pf1.pgAddEdit.Edit1.REFRESH
			ENDIF
		ENDIF
		
		IF lRMAsaved
		
			*Save To dbo.Sales
			FOR nItems = 1 TO ALEN(aSoItems,1)
				cSOitem = Proper_SO_Item( aSoItems(nItems) )
				
				IF cSOitem != Proper_SO_Item( "" )
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL + " RMA_No = "+STR(nRMA_No)
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC)
					ENDIF
				ENDIF
			ENDFOR
			
			IF pSaveType = "ADD"
				ThisFormSet.ResetAddVars()
			ENDIF
			ThisFormset.frmRMA.pf1.pgAddEdit.REFRESH
		
		
			*********** refresh tables
			ThisFormset.Load_RMA('Refresh')
		
		
		ENDIF
		
		
		IF USED("ActionRequest")
			USE IN ActionRequest
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE selecteditems
		PARAMETERS cSelectSOItem
		*ThisFormSet.SelectedItems(cSelectSOItem)
		
		cSelectSOItem = Proper_SO_Item(cSelectSOItem)
		
		IF Count_SOIteminSales(cSelectSOItem,ThisFormSet.nConnHandle,'')=0
			MESSAGEBOX("Could not find SOitem '"+cSelectSOItem+"' ",16,"Cannot contiue with save")
			TrackError("Could not find SOitem '"+cSelectSOItem+"' to save REASON. ","Could not find SOitem '"+cSelectSOItem+"' ", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		ThisFormSet.SOitem = cSelectSOItem
		
			IF ASCAN(aSOItems, cSelectSOItem ) = 0 &&Not Found
				IF EMPTY(aSoItems(1))
					aSoItems(1) = cSelectSOItem
					*ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.Refresh
				ELSE
					*add new SOitem
					PRIVATE nLenaSoItems 
					nLenaSoItems = ALEN(aSoItems,1)
		
					DIMENSION aSoItems(nLenaSoItems +1)
					aSoItems(nLenaSoItems +1) = cSelectSOItem
					
					
					*ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.Refresh
				ENDIF
			ENDIF 	
		
		
		
		*ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.NumberOfElements = ALEN(aSoItems)
		*ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.Refresh
		
		DIMENSION gaReason(ALEN(aSoItems))
		
		IF USED("tmpQuotes")
			USE IN tmpQuotes
		ENDIF
		IF !EMPTY(aSoItems(1))
		
			IF EMPTY( ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.Value )
				cSQL = "SELECT Company FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1) +"'"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpQuotes')
				ENDIF
				ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.Value = tmpQuotes.Company
			ENDIF
			***
			IF EMPTY( ThisFormset.frmRMA.pf1.pgAddEdit.txtContact.Value )
				cSQL = "SELECT Name FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisFormset.frmRMA.pf1.pgAddEdit.txtContact.Value = tmpQuotes.Name
			ENDIF
			***
			IF EMPTY( ThisFormset.frmRMA.pf1.pgAddEdit.txtEmail.Value )
				cSQL = "SELECT Email FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisFormset.frmRMA.pf1.pgAddEdit.txtEmail.Value = tmpQuotes.Email
