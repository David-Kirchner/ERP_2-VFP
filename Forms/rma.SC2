	PROCEDURE frmRMA.pf1.pgAddEdit.lblOrderdate.Click
		PRIVATE m.dDate1,m.dDate2
		
		m.dDate1 = This.Parent.txtNotified.Value
		DO FORM "forms\popupdate.scx" WITH m.dDate1 TO m.dDate2
		IF VARTYPE(m.dDate2) = "D"
			This.Parent.txtNotified.Value = m.dDate2
		ENDIF
		IF VARTYPE(m.dDate2) = "T"
			This.Parent.txtNotified.Value = CTOD(TTOC(m.dDate2))
		ENDIF
		
		This.Parent.txtNotified.Refresh
		This.Parent.txtNotified.SetFocus
		
		
	ENDPROC

	PROCEDURE frmRMA.pf1.pgAddEdit.lblPackingSlip.Click
		PRIVATE cSOitem,nPackingSli,nRMA_Detail
		cSOitem = RMA_Detail.SO_item &&ThisForm.lstSOitem.Value
		nRMA_Detail = PrepareSQLnum(RMA_Detail.RMA_Detail_ID,'RMA_Detail_ID',-3)
		nPackingSli = 0
		
		IF cSOitem <> Proper_SO_item('')
			MESSAGEBOX("Please <MARK> ALL heats packed to send to customer",48,"Mark heats before selecting Invoice")
			DO FORM Forms\ChooseSD_PackingSli WITH cSOitem,-nRMA_Detail TO nPackingSli 
		ENDIF
		
		IF nPackingSli > 0
			This.parent.txtPackingSli.Value = nPackingSli 
			*This.parent.txtHeat.Value
		ENDIF
		
		
	ENDPROC

