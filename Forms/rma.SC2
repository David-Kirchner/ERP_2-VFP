	PROCEDURE Rma_select12.cmdReturn.Click
		SELECT tmpQuotes
		PRIVATE lFoundDel
		lFoundDel = .F.
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(tmpQuotes.SOitem,'SOitem',10)
		
		GO TOP
		PRIVATE lFoundDel
		lFoundDel = .F.
		
		*!*	SCAN
		*!*		IF DELETED('tmpQuotes')
		*!*			lFoundDel = .T.
		*!*			IF EMPTY(THISFORM.cReturnKey)
		*!*				THISFORM.cReturnKey = tmpQuotes.SOitem
		*!*			ELSE
		*!*				THISFORM.cReturnKey = THISFORM.cReturnKey + ";" + tmpQuotes.SOitem
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDSCAN
		
		IF NOT lFoundDel
			IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				THISFORM.cReturnKey = cSOitem
				lFoundDel = .T.
			ELSE
				MESSAGEBOX("No records found marked to return!"+CHR(13)+"Use Cancel if you do not wont any records returned.")
				THISFORM.cReturnKey = ''
				RETURN
			ENDIF
		ELSE
			*THISFORM.RELEASE
		ENDIF
		
		
		*!*	IF NOT lFoundDel
		*!*		IF RECCOUNT('tmpQuotes') = 1  &&Return the only one!
		*!*			lFoundDel = .T.
		*!*			GO TOP IN tmpQuotes
		*!*			ThisForm.cReturnKey = tmpQuotes.soItem
		*!*		ENDIF
		*!*	ENDIF
		
		IF NOT lFoundDel
			MESSAGEBOX("No records found marked to return!"+CHR(13)+"Use Cancel if you do not wish any records returned.",0+48,"This screen allows many to be marked")
			RETURN
		ELSE	
		*	PRIVATE cSOitem
			ThisForm.Visible = .F.
			ThisFormSet.FrmRMA.Visible = .T.
			cSOitem = ThisForm.cReturnKey
			
			IF EMPTY(ThisFormset.frmRMA.pf1.pgAddEdit.txtCompany.Value)
				ThisFormSet.GetCompanySOitem(cSOitem)
			ENDIF
			
			PRIVATE lUpdatedRMA_Detail, lFoundSOitem
			lUpdatedRMA_Detail = .F.
			lFoundSOitem = .F.
			
			IF USED('RMA_Detail')
				SELECT RMA_Detail
				IF RECCOUNT('RMA_Detail') > 0
					SCAN
						IF Proper_SO_item(RMA_Detail.SO_item) = Proper_SO_item(cSOitem)
							lFoundSOitem = .T.
							lUpdatedRMA_Detail = .T.
							EXIT
						ENDIF
					ENDSCAN
					IF NOT lFoundSOitem = .T.
						SCAN
							IF Proper_SO_item(RMA_Detail.SO_item) = Proper_SO_item('')
							
								MESSAGEBOX("Replacing empty SO item with '"+cSOitem+"'",0,"Selected")
								REPLACE RMA_Detail.SO_item WITH cSOitem 
								ThisFormSet.SOitem = cSOitem 
								aSoItems(1) = cSOitem 
								lUpdatedRMA_Detail = .T.
								EXIT
							ENDIF			
						ENDSCAN
					ENDIF
				ENDIF
			ENDIF
			
			IF lUpdatedRMA_Detail = .F.
			
				*Add record
				*p_RMA_Detail_ins(RMA.RMA_No,cSOitem)
				*dbo.f_SalesP_SOitem()
				
				IF PrepareSQLnum(RMA.RMA_No,'RMA_No',-3) > 0
					IF PrepareSQLnum(ThisFormset.frmRMA.pf1.pgAddEdit.txtRMA_No.Value,'RMA_No',-3) = PrepareSQLnum(RMA.RMA_No,'RMA_No',-3)
					
				
						IF USED('newRMA_Detail')
							USE IN newRMA_Detail
						ENDIF
		
						PRIVATE cSQL
						cSQL = "EXEC dbo.p_RMA_Detail_ins @RMA_NO="+STR(RMA.RMA_No)+", @SOitem='"+cSOitem+"'"
		
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'newRMA_Detail') 
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'newRMA_Detail')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "newRMA_Detail")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "newRMA_Detail")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF																																														
							ENDDO
						ENDIF 	
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'newRMA_Detail')
						ENDIF	
				
						IF USED('newRMA_Detail')
							IF RECCOUNT('newRMA_Detail') > 0
								nRMA_Detail_ID = PrepareSQLnum(newRMA_Detail.RMA_Detail_ID,'RMA_Detail',-3)
								*Reload RMA_Detail()
								*ThisFormSet.get_aSOitems()
								ThisFormSet.RMA_No_refresh(nRMA_Detail_ID)
								
								ThisFormSet.Load_RMA_Detail()
								
								SELECT RMA_Detail 
								LOCATE FOR RMA_Detail_ID = nRMA_Detail_ID 
								ThisFormSet.SOitem = cSOitem 
								
								PRIVATE nItems
								nItems = ALEN(aSoItems)
								
								DO CASE
								CASE nItems = 0
									DIMENSION aSoItems(1)
									aSoItems(1) = cSOitem 
								CASE nItems = 1
									IF Proper_SO_item(ALEN(aSoItems)) = Proper_SO_Item('')
										*Replace
										aSoItems(1) = cSOitem 
									ELSE
										DIMENSION aSoItems(2)
										aSoItems(2) = cSOitem 
									ENDIF
								OTHERWISE
									
									DIMENSION aSoItems(nItems+1)
									aSoItems(nItems+1) = cSOitem 
									
								ENDCASE
								lUpdatedRMA_Detail = .T.
							ENDIF
							USE IN newRMA_Detail
						ENDIF
						
					ENDIF
				ENDIF
		
			ENDIF
		
		
			ThisFormSet.RMA_No_refresh(nRMA_Detail_ID )
		*!*		IF USED('RMA_Detail')
		*!*			IF PrepareSQLnum(RMA_Detail.RMA_Detail_ID,'RMA_Detail_ID',-3) > 0
		*!*				ThisFormSet.RMA_No_refresh(RMA_Detail.RMA_Detail_ID)
		*!*			ELSE
		*!*				ThisFormSet.RMA_No_refresh(0)
		*!*			ENDIF
		*!*		ELSE
		*!*			ThisFormSet.RMA_No_refresh(0)
		*!*		ENDIF
		
			*ThisFormSet.SelectedItems(cSOitem)
			************************
			PRIVATE nCount, nDrop
			nCount = 0
			nDrop = 0
			
			FOR i = 1 TO ALEN(aSOItems,1)
				IF aSOItems(i) != cSOitem
					nCount = nCount + 1
					DIMENSION aSOItemsNew(nCount)
					aSOItemsNew(nCount) = aSOItems(i)
					
					DIMENSION aReasonNew(nCount)
					aReasonNew(nCount) = gaReason(i)
				ELSE
					nDrop = i
				ENDIF
			ENDFOR
		
			IF nCount = 0
				DIMENSION aSOItems(1)
				aSOItems(1) = " "
				DIMENSION gaReason(1)
				gaReason(1) = " "
			ELSE
				DIMENSION aSOItems(nCount)
				ACOPY(aSOItemsNew,aSOitems)
				
				DIMENSION gaReason(nCount)
				ACOPY(aReasonNew,gaReason)
			ENDIF
			
		*	ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.NumberOfElements = ALEN(aSoItems)
		*	ThisFormset.frmRMA.pf1.pgAddEdit.lstSOitem.Refresh
			
			IF nDrop - 1 > 0
				IF AELEMENT(aSoItems,1) < nDrop
					ThisFormSet.SOitem = aSoItems( AELEMENT(aSoItems,1) )  &&lAST ONE
				ELSE
					ThisFormSet.SOitem = aSoItems( nDrop - 1)
				ENDIF
			ENDIF
			IF nDrop = 0 AND nCount > 0
				ThisFormSet.SOitem = aSoItems(1)
			ENDIF
			
			
			ThisFormSet.Refresh_SOitem_PS()
		ENDIF
	ENDPROC

	PROCEDURE Rma_select12.cmdSearch.Click
		PRIVATE vSearchFor, cSQL
		vSearchFor = ThisForm.txtSearch.Value
		
		PRIVATE nConnHandle, cSearchFor, vSearchFor
		nConnHandle = ThisFormSet.nConnHandle
		*nConnHandle = ThisForm.nConnHandle
		
		IF EMPTY(ThisForm.txtSearch.Value)
			MESSAGEBOX("Nothing to Search for!",0,"Empty")
			RETURN .F.
		ENDIF
		
		IF TYPE("vSearchFor") = "N"
			cSearchFor = ALLTRIM(STR(vSearchFor))
		ELSE
			cSearchFor = ALLTRIM(vSearchFor)
		ENDIF
		
		ThisForm.grdSQL.RecordSource = ""
		
		cSQL = "SELECT Company,Name,po_Num,Alloy,Form,Pieces,Thck,Sz2,Sz3,weight,Descript,'' AS comment,inqdate,SalesP,SalesNum,SoItem,SaleDate FROM dbo.AllQuotes  "
		
		DO CASE
		CASE ThisForm.cmbSWhere.Value = "Sales Order" 
		
			cSQL = cSQL + "WHERE SalesNum = "+ cSearchFor
			
		CASE ThisForm.cmbSWhere.Value = "Customers PO"
			
			cSQL = cSQL + "WHERE PO_Num = '" + cSearchFor + "'"
			
		CASE ThisForm.cmbSWhere.Value = "Company Name"
			
			cSQL = cSQL + "WHERE Company LIKE '%" + cSearchFor + "%'"
			
		*CASE ThisForm.cmbSWhere.Value = "Packing Slip Number"
			
		ENDCASE
		
		IF USED('tmpQuotes')
			USE IN tmpQuotes
		ENDIF
		SELECT 0
		*cSQL = cSQL + " ORDER BY SaleDate DESC"
		cSQL = cSQL + " ORDER BY SoItem"
		
		nSQLEXEC = SQLEXEC(nConnHandle, cSQL, 'tmpQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConnHandle, cSQL, 'tmpQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, nConnHandle)
		ENDIF
			
		ThisForm.grdSQL.RecordSource = "tmpQuotes"
			
	ENDPROC

	PROCEDURE Rma_select12.Init
		*PARAMETER pnSO
		*DODEFAULT()
		
		
		ThisForm.lblSelectByDel.Visible = .F.
	ENDPROC

	PROCEDURE Rma_select12.Load
		PRIVATE cSQL,nSQLExec
		
		SELECT 0
		cSQL = "SELECT Company,Name,po_Num,Alloy,Form,Pieces,Thck,Sz2,Sz3,weight,Descript,' ' AS comment,inqdate,SalesP,SalesNum,SoItem,SaleDate FROM dbo.AllQuotes WHERE 1 <> 1"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuotes')
		ENDDO
		
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'tmpQuotes')
		ENDIF
			
		
			
	ENDPROC

ENDDEFINE
