	PROCEDURE frmRMA.pf1.pgAddEdit.lblCompany.Click
		PRIVATE nSalesNum 
		nSalesNum = VAL( LEFT( aSoItems(1), 7))
		
		IF nSalesNum > 0
		
			IF USED('Sales_No_SoldAddr')
				USE IN Sales_No_SoldAddr
			ENDIF
			SELECT 0
		
			cSQL = "SELECT SoldAddr.Company FROM dbo.Sales_No, dbo.SoldAddr WHERE Sales_No.SalesNum="+STR(nSalesNum)+" AND Sales_No.pSoldAddr = SoldAddr.SoldCode "
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales_No_SoldAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales_No_SoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_No_SoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Sales_No_SoldAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'Sales_No_SoldAddr')
			ENDIF
			IF USED('Sales_No_SoldAddr')
				IF VARTYPE(Sales_No_SoldAddr.Company) = "C"
					This.parent.txtCompany.Value = Sales_No_SoldAddr.Company
				ENDIF
		
				USE IN Sales_No_SoldAddr
			ENDIF
			
			
		ENDIF
	ENDPROC

	PROCEDURE frmRMA.pf1.pgAddEdit.lblDescription.Click
		
		*get_Description_of_SOitem_in_AllQuotes(cSOitem,ThisForm.nConnHandle)
		*get_Description_of_Packed_in_PackingSlipNo(nPackingSli,ThisForm.nConnHandle)
		PRIVATE cDescrip, cSOitem
		cDescrip = ''
		
		PRIVATE nPackingSli
		nPackingSli = PrepareSQLnum(This.Parent.txtPackingSli.Value,'PackingSli',-1)
		IF nPackingSli > 0
			cDescrip = get_Description_of_Packed_in_PackingSlipNo(nPackingSli,ThisFormSet.nConnhandle)
		ELSE
			cSOitem = PrepareSQLtxt(This.Parent.grd_RMA_Detail.Column1.Text1.Value,'SOitem',10)
			IF cSOitem <> Proper_SO_item('')
				cDescrip = get_Description_of_SOitem_in_AllQuotes(cSOitem,ThisFormSet.nConnhandle)
			ENDIF
		ENDIF
		
		IF LEN(cDescrip) > 0
			This.Parent.txtDescrip.Value = cDescrip 
		ENDIF
	ENDPROC

