	ENDPROC

	PROCEDURE frmRMA.pf1.pgView.cmdFindcmbText.Valid
		PRIVATE IntcmbFind, recb4find, nBestFind
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace m.FindText
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		IF TYPE('laText2Find') = "N"
			lnText2Find = laText2Find
			lcText2Find = ALLTRIM(STR(laText2Find))
		ENDIF
		IF TYPE('laText2Find') = "C"
			lcText2Find = ALLTRIM(laText2Find)
			lnText2Find = VAL(laText2Find)
		ENDIF
		
		IntcmbFind = INT(m.ncmbFind)
		recb4find = 0
		recb4find = RECNO('RMA')
		
		**Sales Order,Customer,RMA
		SELECT RMA
		DO CASE
		CASE IntcmbFind = 1
			*SalesNum N, 10
			SELECT RMA_Detail
			LOCATE FOR VAL(SO_Item) = lnText2Find 
			SELECT RMA
			IF FOUND('RMA_Detail')
				nRMA_No = RMA_Detail.RMA_No
				
				SEEK nRMA_No IN 'RMA' ORDER rma_no
			ENDIF
		CASE IntcmbFind = 2
			*Company c,30
			SELECT RMA
			INDEX ON Company TAG Company
			SET ORDER TO TAG Company
		*	SET ORDER TO Company
			SEEK UPPER(lcText2Find) IN 'RMA' ORDER Company
		CASE IntcmbFind = 3
			*rma_no N,10
			SELECT RMA
			SET ORDER TO rma_no
			SEEK lnText2Find  IN 'RMA' ORDER rma_no
		CASE IntcmbFind = 4
			*PO_Num C20
			*get SOitem from PO_num
			lnText2Find = ThisFormSet.get_SOitemfromPO_Num(lnText2Find)
			
			IF Proper_SO_item(lnText2Find ) <> Proper_SO_item('')
				SELECT RMA_Detail
				LOCATE FOR SO_Item = lnText2Find 
				SELECT RMA
				IF FOUND('RMA_Detail')
					nRMA_No = RMA_Detail.RMA_No
					
					SEEK nRMA_No IN 'RMA' ORDER rma_no
				ENDIF	
			ELSE
				*Locate so not found!
				SEEK '~-' IN 'RMA' ORDER rma_no
			ENDIF
		ENDCASE
		
		SELECT RMA
		IF NOT FOUND('RMA')
			nBestFind = RECNO(0)
			IF nBestFind > 0 AND nBestFind <= RECCOUNT("RMA")
				GOTO nBestFind 
			ENDIF
			IF EOF('RMA')
				WAIT WINDOW 'Not Found' NOWAIT
				IF recb4find > 0 AND recb4find <= RECCOUNT("RMA")
					GO recb4find
				ENDIF
			ELSE
				WAIT WINDOW 'closest match' NOWAIT
			ENDIF
		ENDIF
		
		This.Parent.grdRMA.Refresh
		
		
		ThisFormSet.RefreshViewTab()
		
		This.Parent.grdRMA.Setfocus
	ENDPROC

	PROCEDURE frmRMA.pf1.pgView.cmdFindcmbText.When
		IF EMPTY(m.FindText)
			=MESSAGEBOX("Enter text first",16,"No text")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE frmRMA.pf1.pgView.cmdPreview.Click
