DEFINE CLASS frmspectext AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Grid1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Grid1.test.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Grid1.test.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdPrint" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdReturn" UniqueID="" Timestamp="" />

	*<PropValue>
		Caption = "Spec Text"
		DoCreate = .T.
		Height = 353
		Icon = graphics\earth-globe.ico
		Left = 0
		Name = "frmSpecText"
		Top = 0
		Width = 557
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdPrint' AS commandbutton WITH ;
		Caption = "Print", ;
		Height = 27, ;
		Left = 324, ;
		Name = "cmdPrint", ;
		Top = 324, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdReturn' AS commandbutton WITH ;
		Caption = "Return", ;
		Height = 27, ;
		Left = 456, ;
		Name = "cmdReturn", ;
		Top = 324, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Grid1' AS grid WITH ;
		ColumnCount = 1, ;
		Height = 300, ;
		Left = 12, ;
		Name = "Grid1", ;
		Top = 12, ;
		Width = 540, ;
		Column1.ControlSource = "SpecText", ;
