DEFINE CLASS frmcancelcomment AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="edtComment" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdDone" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: creturn
	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth.ico
		AlwaysOnTop = .T.
		Caption = "Enter cancel  reason."
		Closable = .F.
		ControlBox = .F.
		creturn = 
		DoCreate = .T.
		Height = 76
		Left = 0
		Name = "frmCancelComment"
		Top = 0
		Width = 377
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdDone' AS commandbutton WITH ;
		Caption = "Done", ;
		ForeColor = 0,0,0, ;
		Height = 24, ;
		Left = 288, ;
		Name = "cmdDone", ;
		TabIndex = 13, ;
		TerminateRead = .T., ;
		Top = 36, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'edtComment' AS editbox WITH ;
		Height = 48, ;
		Left = 8, ;
		MaxLength = 240, ;
		Name = "edtComment", ;
		OLEDragPicture = ..\..\microsoft visual foxpro 9\samples\solution\, ;
		OLEDropEffects = 1, ;
		OLEDropMode = 1, ;
		OLEDropTextInsertion = 1, ;
		Top = 12, ;
		Value = Customer requested this cancel., ;
		Width = 276
		*< END OBJECT: BaseClass="editbox" />
	
	PROCEDURE Init
		PARAMETERS pUnknown
		
		IF VARTYPE(pUnknown) = "C"
			This.Caption = "Enter SO Item:"+ALLTRIM(pUnknown)+" reason for Cancel."
		ENDIF
		IF VARTYPE(pUnknown) = "N"
			This.Caption = "Enter SO:"+ALLTRIM(STR(pUnknown))+" reason for Cancel."
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		RETURN ThisForm.cReturn
	ENDPROC

	PROCEDURE cmdDone.Click
		ThisForm.cReturn = ThisForm.edtComment.Value
		
		IF EMPTY(ThisForm.cReturn)
			MESSAGEBOX("Please type a reason so future reports can be accurate.",48,"No Reason")
			ThisForm.edtComment.Value = "Customer requested this cancel."
		ELSE
			ThisForm.Release
		ENDIF
	ENDPROC

ENDDEFINE
