	PROCEDURE Init
			IF USED("tmpSOitemSS")	
				USE IN tmpSOitemSS
			ENDIF
			SELECT 0
		
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "SELECT Alloy,[Form],[CC],[CL],[Pieces],[Thck],[Sz2],[Sz3] "
		    cSQL = cSQL + ",[Weight],[Descript],[Comment],[InqNumP],[SOitem],[POitem]"
			cSQL = cSQL + ",[RandLen],[Metric]"
			cSQL = cSQL + " FROM dbo.StartingStock "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitemSS')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpSOitemSS')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitemSS')
			ELSE
				IF USED('tmpSOitemSS')
					IF RECCOUNT('tmpSOitemSS') > 0
						ThisFormset.frmStartingStock.txtPieces.Value 	= tmpSOitemSS.Pieces
						ThisFormset.frmStartingStock.txtAlloy.Value		= tmpSOitemSS.Alloy
						ThisFormset.frmStartingStock.txtForm.Value		= tmpSOitemSS.Form
		*				ThisFormSet.RefreshForms(tmpSOitemSS.Form)
						ThisFormset.frmStartingStock.txtCC.Value		= tmpSOitemSS.CC
						ThisFormset.frmStartingStock.txtCL.Value		= tmpSOitemSS.CL
						ThisFormset.frmStartingStock.txtThck.Value		= tmpSOitemSS.Thck
						ThisFormset.frmStartingStock.txtSz2.Value		= tmpSOitemSS.Sz2
						ThisFormset.frmStartingStock.txtSz3.Value		= tmpSOitemSS.Sz3
						ThisFormset.frmStartingStock.txtWeight.Value 	= tmpSOitemSS.Weight
						*
						ThisFormset.frmStartingStock.txtDescript.Value 	= tmpPO_POitem.Descript
						ThisFormset.frmStartingStock.txtComment.Value 	= tmpPO_POitem.Comment
						ThisFormset.frmStartingStock.txtSOitem.Value 	= tmpPO_POitem.SOitem
						ThisFormset.frmStartingStock.txtPOitem.Value 	= tmpPO_POitem.POitem
						
						ThisFormset.frmStartingStock.Visible = .T.
						
					ENDIF
					USE IN tmpSOitemSS
				ENDIF
			ENDIF
	ENDPROC

	PROCEDURE cmdHide.Click
		ThisForm.Visible = .F.
	ENDPROC

	PROCEDURE Command1.Click
		ThisForm.Visible = .F.
	ENDPROC

	PROCEDURE txtAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisFormSet.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisFormSet.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

