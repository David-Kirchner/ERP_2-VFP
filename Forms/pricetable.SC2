	PROCEDURE calctestprice
		*ThisFormSet.CalcTestPrice()
		
		PRIVATE nCostCurr
		nCostCurr = PrepareSQLnum(ThisFormSet.frmFormula.CostCurr.Value,'CostCurr',-5)
		
		PRIVATE A0, A5, A10, A25, A50, A100, A200, A500, A1000, A2000, Abase
		nA0		= PrepareSQLnum(ThisFormSet.frmFormula.A0.Value,'A',9,6)
		nA5		= PrepareSQLnum(ThisFormSet.frmFormula.A5.Value,'A',9,6)
		nA10	= PrepareSQLnum(ThisFormSet.frmFormula.A10.Value,'A',9,6)
		nA25	= PrepareSQLnum(ThisFormSet.frmFormula.A25.Value,'A',9,6)
		nA50	= PrepareSQLnum(ThisFormSet.frmFormula.A50.Value,'A',9,6)
		nA100	= PrepareSQLnum(ThisFormSet.frmFormula.A100.Value,'A',9,6)
		nA200	= PrepareSQLnum(ThisFormSet.frmFormula.A200.Value,'A',9,6)
		nA500	= PrepareSQLnum(ThisFormSet.frmFormula.A500.Value,'A',9,6)
		nA1000	= PrepareSQLnum(ThisFormSet.frmFormula.A1000.Value,'A',9,6)
		nA2000	= PrepareSQLnum(ThisFormSet.frmFormula.A2000.Value,'A',9,6)
		nABase	= PrepareSQLnum(ThisFormSet.frmFormula.ABase.Value,'A',9,6)
			
		ThisFormSet.frmFormula.T0.Value = (nA0 * nCostCurr )
		ThisFormSet.frmFormula.T5.Value = (nA5 * nCostCurr )
		ThisFormSet.frmFormula.T10.Value = (nA10 * nCostCurr )
		ThisFormSet.frmFormula.T25.Value = (nA25 * nCostCurr )
		ThisFormSet.frmFormula.T50.Value = (nA50 * nCostCurr )
		ThisFormSet.frmFormula.T100.Value = (nA100 * nCostCurr )
		ThisFormSet.frmFormula.T200.Value = (nA200 * nCostCurr )
		ThisFormSet.frmFormula.T500.Value = (nA500 * nCostCurr )
		ThisFormSet.frmFormula.T1000.Value = (nA1000 * nCostCurr )
		ThisFormSet.frmFormula.T2000.Value = (nA2000 * nCostCurr )
		ThisFormSet.frmFormula.Tbase.Value = (nAbase * nCostCurr )
		
		**************************
		PRIVATE cForm, nSize
		cForm	= PrepareSQLtxt(ThisFormSet.frmHPApricing.Form1.Value,'Form',2)
		nSize	= PrepareSQLnum(ThisFormSet.frmHPApricing.Size1.Value,'Size',9,4)
		
		cSQL = "SELECT dbo.FormDescription('"+cForm+"',"+ ALLTRIM(STR(nSize,9,4)) +") AS FormDesc"
		
		IF USED('tmpFormDesc')
			USE IN tmpFormDesc
		ENDIF
		SELECT 0
		
		ThisFormset.frmHPApricing.lblFormCaption.Caption = ''
		ThisFormset.frmFormula.lblFormCaption.Caption = ''
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpFormDesc' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpFormDesc' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFormDesc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpFormDesc")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'tmpFormDesc')
		ELSE
			IF USED('tmpFormDesc')
				IF RECCOUNT('tmpFormDesc')>0
					ThisFormset.frmHPApricing.lblFormCaption.Caption = PrepareSQLtxt(tmpFormDesc.FormDesc,'FormDesc',11)
					ThisFormset.frmFormula.lblFormCaption.Caption = PrepareSQLtxt(tmpFormDesc.FormDesc,'FormDesc',11)
				ENDIF
				USE IN tmpFormDesc
			ENDIF
		ENDIF
		
		
		**************************
		*Check Prev and Next
		PRIVATE nPT_ID
		nPT_ID = PrepareSQLnum(PriceTable.PT_ID,'ID',-3)
		PRIVATE cAlloy, cForm, cThk, nSize, nSize2, nSize3
		cAlloy	= PrepareSQLtxt(ThisFormSet.frmHPApricing.ALLOY1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisFormSet.frmHPApricing.Form1.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisFormSet.frmHPApricing.CC1.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormSet.frmHPApricing.CL1.Value,'CL',1)
		nSize	= PrepareSQLnum(ThisFormSet.frmHPApricing.Size1.Value,'Size',9,4)
		nSize2	= PrepareSQLnum(ThisFormSet.frmHPApricing.Size2.Value,'Size2',8,3)
		nSize3	= PrepareSQLnum(ThisFormSet.frmHPApricing.Size3.Value,'Size3',8,3)
		
		cSQL = "SELECT W0,W5,W10,W25,W50,W100,W200,W500,W1000,W2000,WBASE,PT_ID "
		cSQL = cSQL +" FROM dbo.PriceTable WHERE "
		cSQL = cSQL +" Alloy='"+cAlloy+"'"
		cSQL = cSQL +" AND Form='"+cForm+"'"
		cSQL = cSQL +" AND CC='"+cCC+"'"
		cSQL = cSQL +" AND CL='"+cCL+"'"
		*cSQL = cSQL +" AND [SIZE]="+STR(nSize,9,4)+""
		*cSQL = cSQL +" AND Size2="+STR(nSize2,8,3)+""
		*cSQL = cSQL +" AND Size3="+STR(nSize3,8,3)
		cSQL = cSQL +" ORDER BY Alloy, Form, CC, CL, [Size], Size2, Size3 "
		
			
		IF USED('tmpPT_pn')
			USE IN tmpPT_pn
		ENDIF
		SELECT 0
		
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPT_pn' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPT_pn' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPT_pn")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPT_pn")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'tmpPT_pn')
		ELSE
			IF USED('tmpPT_pn')
				IF RECCOUNT('tmpPT_pn')>0
					LOCATE FOR PT_ID = nPT_ID 
					
					IF FOUND('tmpPT_pn')
						ThisFormset.frmFormula.T0.Value = tmpPT_pn.W0
						ThisFormset.frmFormula.T5.Value = tmpPT_pn.W5
						ThisFormset.frmFormula.T10.Value = tmpPT_pn.W10
						ThisFormset.frmFormula.T25.Value = tmpPT_pn.W25
						ThisFormset.frmFormula.T50.Value = tmpPT_pn.W50
						ThisFormset.frmFormula.T100.Value = tmpPT_pn.W100
						ThisFormset.frmFormula.T200.Value = tmpPT_pn.W200
						ThisFormset.frmFormula.T500.Value = tmpPT_pn.W500
						ThisFormset.frmFormula.T1000.Value = tmpPT_pn.W1000
						ThisFormset.frmFormula.T2000.Value = tmpPT_pn.W2000
						ThisFormset.frmFormula.TBASE.Value = tmpPT_pn.WBASE
					
						IF RECNO('tmpPT_pn')>1
							SKIP -1
							ThisFormset.frmFormula.pW0.Value = tmpPT_pn.W0
							ThisFormset.frmFormula.pW5.Value = tmpPT_pn.W5
							ThisFormset.frmFormula.pW10.Value = tmpPT_pn.W10
							ThisFormset.frmFormula.pW25.Value = tmpPT_pn.W25
							ThisFormset.frmFormula.pW50.Value = tmpPT_pn.W50
							ThisFormset.frmFormula.pW100.Value = tmpPT_pn.W100
							ThisFormset.frmFormula.pW200.Value = tmpPT_pn.W200
							ThisFormset.frmFormula.pW500.Value = tmpPT_pn.W500
							ThisFormset.frmFormula.pW1000.Value = tmpPT_pn.W1000
							ThisFormset.frmFormula.pW2000.Value = tmpPT_pn.W2000
							ThisFormset.frmFormula.pWBASE.Value = tmpPT_pn.WBASE
							SKIP 1
						ELSE
							ThisFormset.frmFormula.pW0.Value = 0
							ThisFormset.frmFormula.pW5.Value = 0
							ThisFormset.frmFormula.pW10.Value = 0
							ThisFormset.frmFormula.pW25.Value = 0
							ThisFormset.frmFormula.pW50.Value = 0
							ThisFormset.frmFormula.pW100.Value = 0
							ThisFormset.frmFormula.pW200.Value = 0
							ThisFormset.frmFormula.pW500.Value = 0
							ThisFormset.frmFormula.pW1000.Value = 0
							ThisFormset.frmFormula.pW2000.Value = 0
							ThisFormset.frmFormula.pWBASE.Value = 0
						ENDIF
						
						IF RECNO('tmpPT_pn') < RECCOUNT('tmpPT_pn')
							SKIP 1
							ThisFormset.frmFormula.nW0.Value = tmpPT_pn.W0
							ThisFormset.frmFormula.nW5.Value = tmpPT_pn.W5
							ThisFormset.frmFormula.nW10.Value = tmpPT_pn.W10
							ThisFormset.frmFormula.nW25.Value = tmpPT_pn.W25
							ThisFormset.frmFormula.nW50.Value = tmpPT_pn.W50
							ThisFormset.frmFormula.nW100.Value = tmpPT_pn.W100
							ThisFormset.frmFormula.nW200.Value = tmpPT_pn.W200
							ThisFormset.frmFormula.nW500.Value = tmpPT_pn.W500
							ThisFormset.frmFormula.nW1000.Value = tmpPT_pn.W1000
							ThisFormset.frmFormula.nW2000.Value = tmpPT_pn.W2000
							ThisFormset.frmFormula.nWBASE.Value = tmpPT_pn.WBASE
							SKIP -1
						ELSE
							ThisFormset.frmFormula.nW0.Value = 0
							ThisFormset.frmFormula.nW5.Value = 0
							ThisFormset.frmFormula.nW10.Value = 0
							ThisFormset.frmFormula.nW25.Value = 0
							ThisFormset.frmFormula.nW50.Value = 0
							ThisFormset.frmFormula.nW100.Value = 0
							ThisFormset.frmFormula.nW200.Value = 0
							ThisFormset.frmFormula.nW500.Value = 0
							ThisFormset.frmFormula.nW1000.Value = 0
							ThisFormset.frmFormula.nW2000.Value = 0
							ThisFormset.frmFormula.nWBASE.Value = 0
						ENDIF
		
					ENDIF
				ENDIF
				USE IN tmpPT_pn
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE checklineal
		*ThisFormSet.CheckLineal()
		
		PRIVATE lnW0,nW5,nW10,nW25,nW50,nW100,nW200,nW500,nW1000,nW2000,nWBase
		lnW0	= PrepareSQLnum(PriceTable.W0,'W0',-5)
		nW5		= PrepareSQLnum(PriceTable.W5,'W5',-5)
		nW10	= PrepareSQLnum(PriceTable.W10,'W10',-5)
		nW25	= PrepareSQLnum(PriceTable.W25,'W25',-5)
		nW50	= PrepareSQLnum(PriceTable.W50,'W50',-5)
		nW100	= PrepareSQLnum(PriceTable.W100,'W100',-5)
		nW200	= PrepareSQLnum(PriceTable.W200,'W200',-5)
		nW500	= PrepareSQLnum(PriceTable.W500,'W500',-5)
		nW1000	= PrepareSQLnum(PriceTable.W1000,'W1000',-5)
		nW2000	= PrepareSQLnum(PriceTable.W2000,'W2000',-5)
		nWBase	= PrepareSQLnum(PriceTable.WBase,'WBase',-5)
		
		
		ThisFormSet.frmFormula.W2000.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W2000.DisabledBackColor=RGB(240,240,240)
		IF nWBase > 0 AND nW2000 > 0
			IF nWBase > nW2000
				ThisFormSet.frmFormula.W2000.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W2000.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
		
		
		ThisFormSet.frmFormula.W1000.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W1000.DisabledBackColor=RGB(240,240,240)
		IF nW2000 > 0 AND nW1000 > 0
			IF nW2000 > nW1000
				ThisFormSet.frmFormula.W1000.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W1000.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
		
		ThisFormSet.frmFormula.W500.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W500.DisabledBackColor=RGB(240,240,240)
		IF nW1000 > 0 AND nW500 > 0
			IF nW1000 > nW500
				ThisFormSet.frmFormula.W500.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W500.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
		
		ThisFormSet.frmFormula.W200.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W200.DisabledBackColor=RGB(240,240,240)
		IF nW500 > 0 AND nW200 > 0
			IF nW500 > nW200
				ThisFormSet.frmFormula.W200.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W200.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
		
		ThisFormSet.frmFormula.W100.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W100.DisabledBackColor=RGB(240,240,240)
		IF nW200 > 0 AND nW100 > 0
			IF nW200 > nW100
				ThisFormSet.frmFormula.W100.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W100.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
		
		ThisFormSet.frmFormula.W50.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W50.DisabledBackColor=RGB(240,240,240)
		IF nW100 > 0 AND nW50 > 0
			IF nW100 > nW50
				ThisFormSet.frmFormula.W50.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W50.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
		
		ThisFormSet.frmFormula.W25.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W25.DisabledBackColor=RGB(240,240,240)
		IF nW50 > 0 AND nW25 > 0
			IF nW50 > nW25
				ThisFormSet.frmFormula.W25.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W25.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
		
		ThisFormSet.frmFormula.W10.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W10.DisabledBackColor=RGB(240,240,240)
		IF nW25 > 0 AND nW10 > 0
			IF nW25 > nW10
				ThisFormSet.frmFormula.W10.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W10.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
		
		ThisFormSet.frmFormula.W5.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W5.DisabledBackColor=RGB(240,240,240)
		IF nW10 > 0 AND nW5 > 0
			IF nW10 > nW5
				ThisFormSet.frmFormula.W5.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W5.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
		
		ThisFormSet.frmFormula.W0.BackColor=RGB(255,255,255)
		ThisFormSet.frmFormula.W0.DisabledBackColor=RGB(240,240,240)
		IF nW5 > 0 AND lnW0 > 0
			IF nW5 > lnW0
				ThisFormSet.frmFormula.W0.BackColor=RGB(255,128,128)
				ThisFormSet.frmFormula.W0.DisabledBackColor=RGB(255,128,128)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Destroy
		SQLDISCONNECT( ThisFormSet.nConnHandle)
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		SET DECIMALS TO 4
		ThisFormSet.PriceTableReLoad(1)
		*ThisFormSet.RefreshPriceTable()
		ThisFormset.ShowAlloySurcharge()
		ThisFormSet.PriceTable_Change_ReLoad(-1)
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisFormSet.PriceTableReLoad(-1)
	ENDPROC

	PROCEDURE pricetableinsert
		PRIVATE cAlloy, cForm, cCC, cCL, cThk, nSize, nSize2, nSize3
		cAlloy	= PrepareSQLtxt(pricetable.alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(pricetable.Form,'Form',2)
		cCC		= PrepareSQLtxt(priceTable.CC,'CC',1)
		cCL		= PrepareSQLtxt(priceTable.CL,'CL',1)
		cThk	= PrepareSQLtxt(pricetable.Thk,'Thk',5)
		nSize	= 9999.9999
		
		IF USED('tmpCntInsert')
			SELECT tmpCntInsert
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT COUNT(*) AS CNTD FROM dbo.PriceTable WHERE "
		cSQL = cSQL +" Alloy='New Insert'"
		*cSQL = cSQL +" Alloy='"+cAlloy+"'"
		*cSQL = cSQL +" AND Form='"+cForm+"'"
		*cSQL = cSQL +" AND CC='"+cCC+"'"
		*cSQL = cSQL +" AND CL='"+cCL+"'"
		*cSQL = cSQL +" AND Size=9999.9999"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCntInsert')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntInsert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntInsert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntInsert")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpCntInsert')
		ENDIF
		
		IF USED('tmpCntInsert')
			IF tmpCntInsert.CNTD > 0
			
				MESSAGEBOX("Alloy='New Insert'"+CHR(13)+"Someone has started a New Insert."+CHR(13)+"Make sure you do not overwrite thier work"+CHR(13)+"or just Edit the record where Alloy='New Insert'",0+48,"NO Insert")
		*		MESSAGEBOX("Alloy="+cAlloy+" Form="+cForm+" CC="+cCC+" CL="+cCL+CHR(13)+"Already Exists!"+CHR(13)+"Insert will Abort!"+CHR(13)+"Edit the Size 9999.9999 record!",0+48,"Not Insert")		
				USE IN tmpCntInsert
				RETURN .F.
			ENDIF
			USE IN tmpCntInsert
		ENDIF
		
		
		PRIVATE nW0, nW5, nW10, nW25, nW50, nW100, nW200, nW500, nW1000, nW2000, nWBase
		PRIVATE nA0, nA5, nA10, nA25, nA50, nA100, nA200, nA500, nA1000, nA2000, nABase
		PRIVATE nH0, nH5, nH10, nH25, nH50, nH100, nH200, nH500, nH1000, nH2000, nHBase
		PRIVATE nCostCurr, nCost2013, nCost2007, nCost2002, nCost1999, cCommSpec
		
		cAlloy	= ' '
		cForm	= '  '
		cCC		= ' '
		cCL		= ''
		cThk	= ' '
		nSize	= 0
		nSize2	= 0
		nSize3	= 0
		
		nW0		= 0
		nW5		= 0
		nW10	= 0
		nW25	= 0
		nW50	= 0
		nW100	= 0
		nW200	= 0
		nW500	= 0
		nW1000	= 0
		nW2000	= 0
		nWBase	= 0
		
		nH0		= 0
		nH5		= 0
		nH10	= 0
		nH25	= 0
		nH50	= 0
		nH100	= 0
		nH200	= 0
		nH500	= 0
		nH1000	= 0
		nH2000	= 0
		nHBase	= 0
		
		nA0		= 0
		nA5		= 0
		nA10	= 0
		nA25	= 0
		nA50	= 0
		nA100	= 0
		nA200	= 0
		nA500	= 0
		nA1000	= 0
		nA2000	= 0
		nABase	= 0
		
		nCostCurr = 0
		nCost2013 = 0
		nCost2007 = 0
		nCost2002 = 0
		nCost1999 = 0
		cCommSpec = ''
		
		cSQL = "EXEC dbo.p_PriceTable_ins "
		cSQL = cSQL +" @Alloy='"+cAlloy+"'"
		cSQL = cSQL +",@Form='"+cForm+"'"
		cSQL = cSQL +",@CC='"+cCC+"'"
		cSQL = cSQL +",@CL='"+cCL+"'"
		cSQL = cSQL +",@Thk='"+cThk+"'"
		cSQL = cSQL +",@Size="+STR(nSize,9,4)
		cSQL = cSQL +",@Size2="+STR(nSize2,8,3)
		cSQL = cSQL +",@Size3="+STR(nSize3,8,3)
		
		cSQL = cSQL +",@W0="+STR(nW0,7,2)
		cSQL = cSQL +",@W5="+STR(nW5,7,2)
		cSQL = cSQL +",@W10="+STR(nW10,7,2)
		cSQL = cSQL +",@W25="+STR(nW25,7,2)
		cSQL = cSQL +",@W50="+STR(nW50,7,2)
		cSQL = cSQL +",@W100="+STR(nW100,7,2)
		cSQL = cSQL +",@W200="+STR(nW200,7,2)
		cSQL = cSQL +",@W500="+STR(nW500,7,2)
		cSQL = cSQL +",@W1000="+STR(nW1000,7,2)
		cSQL = cSQL +",@W2000="+STR(nW2000,7,2)
		cSQL = cSQL +",@WBase="+STR(nWBase,7,2)
		
		cSQL = cSQL +",@H0="+STR(nH0,9,6)
		cSQL = cSQL +",@H5="+STR(nH5,9,6)
		cSQL = cSQL +",@H10="+STR(nH10,9,6)
		cSQL = cSQL +",@H25="+STR(nH25,9,6)
		cSQL = cSQL +",@H50="+STR(nH50,9,6)
		cSQL = cSQL +",@H100="+STR(nH100,9,6)
		cSQL = cSQL +",@H200="+STR(nH200,9,6)
		cSQL = cSQL +",@H500="+STR(nH500,9,6)
		cSQL = cSQL +",@H1000="+STR(nH1000,9,6)
		cSQL = cSQL +",@H2000="+STR(nH2000,9,6)
		cSQL = cSQL +",@HBase="+STR(nHBase,9,6)
		
		cSQL = cSQL +",@A0="+STR(nA0,9,6)
		cSQL = cSQL +",@A5="+STR(nA5,9,6)
		cSQL = cSQL +",@A10="+STR(nA10,9,6)
		cSQL = cSQL +",@A25="+STR(nA25,9,6)
		cSQL = cSQL +",@A50="+STR(nA50,9,6)
		cSQL = cSQL +",@A100="+STR(nA100,9,6)
		cSQL = cSQL +",@A200="+STR(nA200,9,6)
		cSQL = cSQL +",@A500="+STR(nA500,9,6)
		cSQL = cSQL +",@A1000="+STR(nA1000,9,6)
		cSQL = cSQL +",@A2000="+STR(nA2000,9,6)
		cSQL = cSQL +",@ABase="+STR(nABase,9,6)
		
		cSQL = cSQL +",@CostCurr="+STR(nCostCurr,18,10)
		cSQL = cSQL +",@Cost2013="+STR(nCost2013,18,10)
		cSQL = cSQL +",@Cost2007="+STR(nCost2007,18,10)
		cSQL = cSQL +",@CommSpec='"+cCommSpec+"'"
		
		IF USED('tmpPriceTableID')
			SELECT tmpPriceTableID
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTableID' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTableID' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTableID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTableID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'tmpPriceTableID')
		ELSE
			IF USED('tmpPriceTableID')
				IF VARTYPE(tmpPriceTableID.EXP) = 'N'
					IF tmpPriceTableID.EXP > 0
						ThisFormSet.frmHPApricing.PT_ID1.Value = tmpPriceTableID.EXP
						ThisFormSet.nAddRec = tmpPriceTableID.EXP
					ENDIF
				ENDIF
				USE IN tmpPriceTableID
			ENDIF
			*ThisForm.BUTTONSET1.cmdEdit.Click
		ENDIF
		
	ENDPROC

	PROCEDURE pricetablereload
		PARAMETERS pCurrRec, pPT_ID
		*ThisFormset.PricetableReLoad(nRecord,nPT_ID)
		
		PRIVATE nGotoRec 
		IF TYPE("pCurrRec")="N"
			nGotoRec = pCurrRec 
		ELSE
			nGotoRec = 1
		ENDIF
		PRIVATE lINIT
		lINIT = .F.
		
		IF nGotoRec < 0
			lINIT = .T.
			nGotoRec = 1
		ENDIF
		
		IF NOT lINIT 
			ThisFormSet.frmPriceTable.grdAlloyForm.RecordSource = ''
		ENDIF
		
		PRIVATE nPT_ID
		nPT_ID = 0
		IF VARTYPE(pPT_ID) = "N"
			nPT_ID = pPT_ID
		ELSE
			nPT_ID = 0
		ENDIF
		IF nPT_ID < 0
			nPT_ID = 0
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL 
		
		cSQL = "SELECT * FROM dbo.PriceTable ORDER BY Alloy,Form,CC,CL,Size,Size2,Size3"
		IF USED("PriceTable")
			USE IN PriceTable
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PriceTable')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PriceTable')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceTable")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceTable")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'PriceTable')
		ENDIF
		
		IF USED('PriceTable')
			IF NOT lINIT
				ThisFormSet.frmPriceTable.grdAlloyForm.ColumnCount = 7
		
				ThisFormSet.frmPriceTable.grdAlloyForm.RecordSource = 'PriceTable'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column1.Width = 75
				ThisFormSet.frmPriceTable.grdAlloyForm.Column1.ControlSource = 'PriceTable.Alloy'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column1.Header1.Caption = "Alloy"
				ThisFormSet.frmPriceTable.grdAlloyForm.Column2.Width = 35
				ThisFormSet.frmPriceTable.grdAlloyForm.Column2.ControlSource = 'PriceTable.Form'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column2.Header1.Caption = 'Form'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column3.Width = 19
				ThisFormSet.frmPriceTable.grdAlloyForm.Column3.ControlSource = 'PriceTable.CC'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column3.Header1.Caption = 'CC'
		
				ThisFormSet.frmPriceTable.grdAlloyForm.Column4.Width = 19
				ThisFormSet.frmPriceTable.grdAlloyForm.Column4.ControlSource = 'PriceTable.CL'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column4.Header1.Caption = 'CL'
		
				ThisFormSet.frmPriceTable.grdAlloyForm.Column5.Width = 50
				ThisFormSet.frmPriceTable.grdAlloyForm.Column5.ControlSource = 'PriceTable.Size'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column5.Header1.Caption = 'Size'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column5.InputMask = '999.9999'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column6.Width = 50
				ThisFormSet.frmPriceTable.grdAlloyForm.Column6.ControlSource = 'PriceTable.Size2'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column6.Header1.Caption = 'Size2'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column6.InputMask = '999.999'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column7.Width = 50
				ThisFormSet.frmPriceTable.grdAlloyForm.Column7.ControlSource = 'PriceTable.Size3'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column7.Header1.Caption = 'Size3'
				ThisFormSet.frmPriceTable.grdAlloyForm.Column7.InputMask = '999.999'
			ENDIF
		
			SELECT PriceTable
		
			IF nGotoRec > 0
				IF nGotoRec < RECCOUNT("PriceTable")
					GOTO nGotoRec 
				ENDIF
			ENDIF
		
			IF nPT_ID > 0
				LOCATE FOR PT_ID = nPT_ID
			*	LOCATE FOR PT_ID = PADR(ALLTRIM(STR(nPT_ID)),20," ")
			ENDIF
		ENDIF
		
		IF NOT lINIT
			ThisFormSet.RefreshPriceTable()
		ENDIF
	ENDPROC

	PROCEDURE pricetable_change_reload
		PARAMETERS pCurrRec
		*ThisFormSet.PriceTable_Change_ReLoad
		
		PRIVATE nGotoRec 
		IF TYPE("pCurrRec")="N"
			nGotoRec = pCurrRec 
		ELSE
			nGotoRec = 1
		ENDIF
		PRIVATE lINIT
		lINIT = .F.
		
		IF nGotoRec < 0
			lINIT = .T.
			nGotoRec = 1
		ENDIF
		
		*IF NOT lINIT 
			ThisFormset.frmPriceTableChange.grd_Change.RecordSource = ''
		*ENDIF
		
		PRIVATE nSQLEXEC, cSQL 
		
		cSQL = "SELECT [Date],CAST([Text] AS CHAR(250)) AS [Text] FROM dbo.PriceTable_Change ORDER BY [Date] DESC"
		IF USED("PT_Change")
			USE IN PT_Change
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PT_Change')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PT_Change')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PT_Change")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PT_Change")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'PT_Change')
		ELSE
			
		ENDIF
		
		IF USED('PT_Change')
		*	IF NOT lINIT
				ThisFormset.frmPriceTableChange.grd_Change.RecordSource = 'PT_Change'
		*	ENDIF
		
		*	SELECT 'PT_Change'
		
		*	IF nGotoRec > 0
		*		IF nGotoRec < RECCOUNT("PT_Change")
		*			GOTO nGotoRec 
		*		ENDIF
		*	ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE refreshgrades
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT * FROM dbo.ConditionCodeAdjust "
		
		IF USED("tmpConditionCode")
			USE IN tmpConditionCode
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpConditionCode')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'tmpConditionCode')
		ELSE
			
			ThisFormSet.frmConditionCode.txtA.VALUE = tmpConditionCode.A
			ThisFormSet.frmConditionCode.txtB.VALUE = tmpConditionCode.B
			ThisFormSet.frmConditionCode.txtC.VALUE = tmpConditionCode.C
			ThisFormSet.frmConditionCode.txtD.VALUE = tmpConditionCode.D
