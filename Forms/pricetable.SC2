	PROCEDURE frmSurcharge.cmdAdjustWEBSurcharge.Click
		PRIVATE nSQLEXEC, cSQL
		PRIVATE cNi, cCo, nCr, nCu, nMo, nFe, nTi
		
		nNi = ThisForm.txtNiSur.VALUE
		nCo = ThisForm.txtCoSur.VALUE
		nCr = ThisForm.txtCrSur.VALUE
		nCu = ThisForm.txtCuSur.VALUE
		nMo = ThisForm.txtMoSur.VALUE
		nFe = ThisForm.txtFeSur.VALUE
		nTi = ThisForm.txtTiSur.VALUE
		
		IF MESSAGEBOX("Are you sure you want Web Princing to Use the Current Surcharges?",4,"Update Now") = 6
		
			cSQL = "UPDATE dbo.PriceTable SET "
			cSQL = cSQL + " Web0 = CAST( W0 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",Web5 = CAST( W5 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",Web10 = CAST( W10 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",Web25 = CAST( W25 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",Web50 = CAST( W50 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",Web100 = CAST( W100 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",Web200 = CAST( W200 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",Web500 = CAST( W500 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",Web1000 = CAST( W1000 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",Web2000 = CAST( W2000 + dbo.f_Alloy_Surcharge(Alloy) AS CHAR(17) )"
			cSQL = cSQL + ",WebBase =  CASE WBase WHEN 0 THEN 0 ELSE CAST( WBase + dbo.f_Alloy_Surcharge(Alloy) AS DECIMAL(18,0)  ) End"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
				MESSAGEBOX("Did not Save!",0,"Error in SQL")
			ELSE
				MESSAGEBOX("SQL data was Saved!",0,"Surcharge")
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE frmSurcharge.cmdCancelSurchargeEdit.Click
		*IF ThisForm.cmdEditSurcharge.CAPTION = "Save"
		IF This.Caption = "Abort"
			ThisForm.txtNiSur.Enabled = .F.
			ThisForm.txtCoSur.Enabled = .F.
			ThisForm.txtCrSur.Enabled = .F.
			ThisForm.txtCuSur.Enabled = .F.
			ThisForm.txtMoSur.Enabled = .F.
			ThisForm.txtFeSur.Enabled = .F.
			ThisForm.txtTiSur.Enabled = .F.
		
			*ThisForm.cmdEditSurcharge.Caption = "Get"
			ThisForm.cmdEditSurcharge.Caption = "Edit"
			This.Caption = "Hide"
		ELSE
			ThisForm.cmdEditSurcharge.Caption = "Edit"
			*This.Caption = "Abort"
			ThisForm.Visible = .F.
		ENDIF
		
	ENDPROC

	PROCEDURE frmSurcharge.cmdEditSurcharge.Click
		PRIVATE cCaption
		cCaption = THIS.CAPTION
		PRIVATE nSQLEXEC, cSQL
		PRIVATE cNi, cCo, nCr, nCu, nMo, nFe, nTi
		
		DO CASE
		CASE cCaption = "Edit"
		
				cSQL = "SELECT * FROM dbo.AlloySurcharge "
		
				IF USED("tmpAlloySurcharge")
					USE IN tmpAlloySurcharge
				ENDIF
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAlloySurcharge')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAlloySurcharge')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloySurcharge")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAlloySurcharge")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'tmpAlloySurcharge')
				ENDIF
				
				ThisForm.txtNiSur.VALUE = tmpAlloySurcharge.Ni
				ThisForm.txtCoSur.VALUE = tmpAlloySurcharge.Co
				ThisForm.txtCrSur.VALUE = tmpAlloySurcharge.Cr
				ThisForm.txtCuSur.VALUE = tmpAlloySurcharge.Cu
				ThisForm.txtMoSur.VALUE = tmpAlloySurcharge.Mo
				ThisForm.txtFeSur.VALUE = tmpAlloySurcharge.Fe
				ThisForm.txtTiSur.VALUE = tmpAlloySurcharge.Ti
				ThisForm.cmdEditSurcharge.CAPTION = "Save"  &&"Adjust"
		
				
				IF USED("tmpAlloySurcharge")
					USE IN tmpAlloySurcharge 
				ENDIF
		
			
		
		CASE cCaption = "Edit"	&&"Adjust"
			ThisForm.txtNiSur.ENABLED = .T.
			ThisForm.txtNiSur.ReadOnly = .F.
			ThisForm.txtCoSur.ENABLED = .T.
			ThisForm.txtCoSur.ReadOnly = .F.
			ThisForm.txtCrSur.ENABLED = .T.
			ThisForm.txtCrSur.ReadOnly = .F.
			ThisForm.txtCuSur.ENABLED = .T.
			ThisForm.txtCuSur.ReadOnly = .F.
			ThisForm.txtMoSur.ENABLED = .T.
			ThisForm.txtMoSur.ReadOnly = .F.
			ThisForm.txtFeSur.ENABLED = .T.
			ThisForm.txtFeSur.ReadOnly = .F.
			ThisForm.txtTiSur.ENABLED = .T.
			ThisForm.txtTiSur.ReadOnly = .F.
			ThisForm.cmdEditSurcharge.CAPTION = "Save"
			ThisForm.cmdCancelSurchargeEdit.Caption = "Abort"
			
		CASE cCaption = "Save"
			*SAVE
			ThisForm.txtNiSur.ENABLED = .F.
			ThisForm.txtNiSur.ReadOnly = .T.
			ThisForm.txtCoSur.ENABLED = .F.
			ThisForm.txtCoSur.ReadOnly = .T.
			ThisForm.txtCrSur.ENABLED = .F.
			ThisForm.txtCrSur.ReadOnly = .T.
			ThisForm.txtCuSur.ENABLED = .F.
			ThisForm.txtCuSur.ReadOnly = .T.
			ThisForm.txtMoSur.ENABLED = .F.
			ThisForm.txtMoSur.ReadOnly = .T.
			ThisForm.txtFeSur.ENABLED = .F.
			ThisForm.txtFeSur.ReadOnly = .T.
			ThisForm.txtTiSur.ENABLED = .F.
			ThisForm.txtTiSur.ReadOnly = .T.
			
			ThisForm.cmdEditSurcharge.CAPTION = "Edit"  &&"Adjust"
			ThisForm.cmdCancelSurchargeEdit.Caption = "Hide"
			
			nNi = ThisForm.txtNiSur.VALUE
			nCo = ThisForm.txtCoSur.VALUE
			nCr = ThisForm.txtCrSur.VALUE
			nCu = ThisForm.txtCuSur.VALUE
			nMo = ThisForm.txtMoSur.VALUE
			nFe = ThisForm.txtFeSur.VALUE
			nTi = ThisForm.txtTiSur.VALUE
		
		
		
				cSQL = "UPDATE dbo.AlloySurcharge SET Ni = "+ STR(nNi, 9,6)
				cSQL = cSQL + ", Co = "+ STR(nCo, 9,6)
				cSQL = cSQL + ", Cr = "+ STR(nCr, 9,6)
				cSQL = cSQL + ", Cu = "+ STR(nCu, 9,6)
				cSQL = cSQL + ", Mo = "+ STR(nMo, 9,6)
				cSQL = cSQL + ", Fe = "+ STR(nFe, 9,6)
				cSQL = cSQL + ", Ti = "+ STR(nTi, 9,6)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
					MESSAGEBOX("Did not Save!",0,"Error in SQL")
				ELSE
					*MESSAGEBOX("SQL data was Saved!",0,"Surcharge")
				ENDIF
		
		ENDCASE
		
	ENDPROC

	PROCEDURE frmSurcharge.lblElSurcharge.Click
		ThisFormSet.ShowAlloySurcharge()
	ENDPROC

	PROCEDURE frmWeb.cmdNext.Click
		SELECT PriceTable 
		IF !EOF()
			SKIP 1 IN PriceTable 
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN PriceTable 
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE frmWeb.cmdPrev.Click
		SELECT PriceTable 
		IF !EOF()
			SKIP -1 IN PriceTable 
		ENDIF
		IF BOF()
			WAIT WINDOW 'Begining of File' NOWAIT
			GO BOTTOM IN PriceTable 
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
		ThisForm.Refresh
		
	ENDPROC

ENDDEFINE
