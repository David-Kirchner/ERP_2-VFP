			ThisFormSet.frmConditionCode.txtF.VALUE = tmpConditionCode.F
		*	*ThisFormSet.frmConditionCode.txtS.VALUE = tmpConditionCode.S
		*	ThisFormSet.frmConditionCode.txtT.VALUE = tmpConditionCode.T
		*	ThisFormSet.frmConditionCode.txtU.VALUE = tmpConditionCode.U
