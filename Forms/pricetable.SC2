		cSQL = cSQL +",W10="+STR(nT10,9,6)
		cSQL = cSQL +",W25="+STR(nT25,9,6)
		cSQL = cSQL +",W50="+STR(nT50,9,6)
		cSQL = cSQL +",W100="+STR(nT100,9,6)
		cSQL = cSQL +",W200="+STR(nT200,9,6)
		cSQL = cSQL +",W500="+STR(nT500,9,6)
		cSQL = cSQL +",W1000="+STR(nT1000,9,6)
		cSQL = cSQL +",W2000="+STR(nT2000,9,6)
		cSQL = cSQL +",WBase="+STR(nTBase,9,6)
		cSQL = cSQL +" WHERE PT_ID ="+STR( nPT_ID )
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
