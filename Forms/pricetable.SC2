		ELSE
			ThisFormset.frmHPApricing.LBLW20001.ForeColor = RGB(0,0,0)
		ENDIF
		
		ThisFormset.frmHPApricing.LBLWbase1.ForeColor = RGB(0,0,0)
		
	ENDPROC

	PROCEDURE saveupdatechange
		PARAMETERS pSQL
		*ThisFormSet.SaveUpdateChange(cSQL)
		
		IF VARTYPE(pSQL) != "C"
			RETURN .F.
		ENDIF
		IF EMPTY(pSQL)
			RETURN .F.
		ENDIF
		
		pSQL = PrepareSQLtxt(pSQL,'SQL',-1)
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "INSERT dbo.PriceTable_Change ([Text]) VALUES ('"+pSQL+"')"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'')
		ELSE
			ThisFormSet.PriceTable_Change_ReLoad(0)
		ENDIF
		
		RETURN .T.
	ENDPROC

