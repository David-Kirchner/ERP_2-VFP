	PROCEDURE frmPriceTable.cmdNext.Click
		SELECT PriceTable 
		IF !EOF()
			SKIP 1 IN PriceTable 
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN PriceTable 
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE frmPriceTable.cmdPrev.Click
		SELECT PriceTable 
		IF !EOF()
			SKIP -1 IN PriceTable 
		ENDIF
		IF BOF()
			WAIT WINDOW 'Begining of File' NOWAIT
			GO BOTTOM IN PriceTable 
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE frmPriceTable.grdAlloyForm.AfterRowColChange
		LPARAMETERS nColIndex
		ThisFormSet.RefreshPriceTable()
	ENDPROC

	PROCEDURE frmPriceTableChange.Resize
		PRIVATE nDeltaH, nDeltaW
		
		nDeltaH = This.Height - 146
		nDeltaW = This.Width - 374
		
		ThisForm.grd_Change.Height = 143 + nDeltaH 
		ThisForm.grd_Change.Width = 528 + nDeltaW
	ENDPROC

	PROCEDURE frmPrint.cmbAlloy.Init
		*#DEFINE ALLAlloy_LOC "(All)"
		this.clear
		*this.additem(ALLAlloy_LOC)
		
		LOCAL aAlloys,cAlloy
		DIMENSION aAlloys[1]
		
		SELECT DISTINCT alloy FROM pricetable WHERE !DELETED() AND !EMPTY(alloy) ORDER BY Alloy INTO array aAlloys
		* AND ActivePric 
		
		FOR EACH m.cAlloy IN aAlloys
			IF !EMPTY(m.cAlloy)
				this.additem(m.cAlloy)
			ENDIF
		ENDFOR
		
		*THIS.VALUE = ALLAlloy_LOC
		THIS.VALUE = aAlloys(1)
		
		*ThisFormset.DispAlloyFilter=aAlloys(1)
	ENDPROC

	PROCEDURE frmPrint.cmbAlloy.InteractiveChange
		SELECT PriceTable
		PRIVATE cAlloyNow 
		cAlloyNow = PriceTable.Alloy
				
		IF This.Value = "(All)"
			LOCATE FOR Alloy = cAlloyNow 
		ELSE
			LOCATE FOR Alloy = This.Value
		ENDIF
		
		ThisFormset.DispAlloyFilter = This.Value
		
		ThisFormSet.frmAdjustPrice.cmbAlloy.Value = This.Value
		ThisFormSet.frmHPApricing.cmbAlloy.Value = This.Value
		ThisFormSet.frmPrint.cmbAlloy.Value = This.Value
		
		
	ENDPROC

	PROCEDURE frmPrint.cmbForm.GotFocus
		PRIVATE cAlloy
		cAlloy = ThisForm.cmbAlloy.Value
		
		IF LEN(cAlloy) > 0
			This.Clear()
		
			SELECT DISTINCT Form FROM pricetable WHERE !DELETED() AND Alloy = cAlloy ;
				 ORDER BY Form INTO array aForms
			* AND ActivePric 
		
			FOR EACH m.cForm IN aForms
				IF !EMPTY(m.cForm)
					this.additem(m.cForm)
				ENDIF
			ENDFOR
		
		ENDIF
		
	ENDPROC

	PROCEDURE frmPrint.cmbForm.Init
		LOCAL aForms,cForm
		DIMENSION aForms[1]
		
		SELECT DISTINCT Form FROM pricetable WHERE !DELETED() AND !EMPTY(alloy);
			 ORDER BY Form INTO array aForms
		* AND ActivePric 
		
		FOR EACH m.cForm IN aForms
			IF !EMPTY(m.cForm)
				this.additem(m.cForm)
			ENDIF
		ENDFOR
		
	ENDPROC

	PROCEDURE frmPrint.cmbForm.InteractiveChange
		PRIVATE cAlloy, cForm, cCC
		cAlloy 	= ThisForm.cmbAlloy.Value
		cForm	= ThisForm.cmbForm.Value
		cCC		= This.Value
		
		SELECT PriceTable
		LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC
		IF NOT FOUND('PriceTable')
			WAIT WINDOW 'CC not found' NOWAIT
			
			LOCATE FOR Alloy=cAlloy AND Form=cForm 
			IF NOT FOUND('PriceTable')
				WAIT WINDOW 'Form and CC not found' NOWAIT
		
				LOCATE FOR Alloy=cAlloy 
				IF NOT FOUND('PriceTable')
					WAIT WINDOW 'Alloy and Form and CC not found' NOWAIT
				ENDIF
			ENDIF
		ENDIF
				
		ThisFormSet.RefreshPriceTable()
	ENDPROC

	PROCEDURE frmPrint.cmdCheckData.Click
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpPriceCheck')
			USE IN tmpPriceCheck
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.PriceTable "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceCheck')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceCheck')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceCheck")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceCheck")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'tmpPriceCheck')
		ENDIF	
		
		IF USED('tmpPriceCheck')
			SELECT tmpPriceCheck
			BROWSE NOEDIT
			
			USE IN tmpPriceCheck
		ENDIF
		
		SELECT Pricetable 
	ENDPROC

	PROCEDURE frmPrint.cmdLineal.Click
		ThisFormset.CheckLineal()
	ENDPROC

	PROCEDURE frmPrint.cmdPrint.Click
		PRIVATE cAlloy, cForm
		PRIVATE cSQL, cSQLwhere
		
		cAlloy	= THIS.PARENT.cmbAlloy.VALUE
		cForm	= THIS.PARENT.cmbForm.VALUE
		
		cSQLwhere = "FOR Alloy = '" + ALLTRIM(cAlloy) + " '"
		IF cForm != "(All)"
			cSQLwhere = cSQLwhere + " AND Form = '" + ALLTRIM(cForm) + "'"
		ENDIF
		cSQLwhere = cSQLwhere + " AND ActivePric "
		SELECT pricetable 
		
		
		IF FILE('\Reports\PriceTable.FRX')
			REPORT FORM \Reports\PriceTable NOCONSOLE TO PRINTER PROMPT &cSQLwhere
			SET PRINTER TO DEFAULT
			WAIT WINDOW 'PRINTED' NOWAIT
		ELSE
			WAIT WINDOW 'Report form not found' NOWAIT
		ENDIF
		
	ENDPROC

	PROCEDURE frmPrint.cmdReport.Click
		PRIVATE nRecNo 
		nRecNo  = 0
		
		IF USED('PriceTable')
			SELECT PriceTable
			nRecNo = RECNO("PriceTable")
			USE IN PriceTable
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
			
		cSQL = "SELECT * FROM dbo.PriceTable "
		cSQL = cSQL +" WHERE "
		cSQL = cSQL +" W0 < W10  "
		cSQL = cSQL +" OR W10 < W25"
		cSQL = cSQL +" OR W25 < W50"
		cSQL = cSQL +" OR W50 < W100"
		cSQL = cSQL +" OR W100 < W200 "
		cSQL = cSQL +" OR W200 < W500"
		cSQL = cSQL +" OR W500 < W1000"
		cSQL = cSQL +" OR W1000 < W2000"
		
		nSQLEXEC = SQLEXEC( ThisFormset.nConnHandle, cSQL, 'PriceTable')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormset.nConnHandle, cSQL, 'PriceTable')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceTable")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceTable")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormset.nConnHandle, 'PriceTable' )
		ENDIF
		
		IF FILE('Reports\PriceTable.FRX')
			REPORT FORM Reports\PriceTable PREVIEW 
			* Title &cSQL
			SET PRINTER TO DEFAULT
		*	WAIT WINDOW 'PRINTED' NOWAIT
		ELSE
			WAIT WINDOW 'Report form not found' NOWAIT
		ENDIF
		
		ThisFormset.PriceTableReLoad(nRecNo)
		
	ENDPROC

