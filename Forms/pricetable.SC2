	PROCEDURE frmHPApricing.cmbAlloy.Init
		#DEFINE ALLAlloy_LOC "(All)"
		this.clear
		this.additem(ALLAlloy_LOC)
		
		LOCAL aAlloys,cAlloy
		DIMENSION aAlloys[1]
		aAlloys(1) = ''
		
		IF USED('tmpAllAlloy')
			SELECT tmpAllAlloy
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT DISTINCT Alloy FROM dbo.Alloy WHERE ISNULL(HPAStock,0) = 1"
		cSQL = cSQL + " OR Alloy = 'Ni 200'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAllAlloy')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAllAlloy')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAllAlloy")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpAllAlloy")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpAllAlloy')
		ENDIF
		
		IF USED('tmpAllAlloy')
			*SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			SELECT DISTINCT alloy FROM tmpAllAlloy WHERE !EMPTY(alloy)  ORDER BY Alloy INTO array aAlloys
				
			USE IN tmpAllAlloy
		ENDIF
		
		
		FOR EACH m.cAlloy IN aAlloys
			IF !EMPTY(m.cAlloy)
				this.additem(m.cAlloy)
			ENDIF
		ENDFOR
		
		THIS.VALUE = aAlloys(1)
		
		ThisFormset.DispAlloyFilter=aAlloys(1)
	ENDPROC

	PROCEDURE frmHPApricing.cmbAlloy.InteractiveChange
		PRIVATE cAlloy, cForm, cCC
		cAlloy 	= This.Value
		cForm	= ThisForm.cmbForm.Value
		cCC		= ThisForm.cmbCC.Value
		
		SELECT PriceTable
		LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC
		IF NOT FOUND('PriceTable')
		*	WAIT WINDOW 'CC not found' NOWAIT
			*DO NOT wory about CC
			LOCATE FOR Alloy=cAlloy AND Form=cForm 
			IF NOT FOUND('PriceTable')
				*WAIT WINDOW 'Form and CC not found' NOWAIT
				*DO NOT wory about Form
				LOCATE FOR Alloy=cAlloy 
				IF NOT FOUND('PriceTable')
					WAIT WINDOW 'Alloy and Form and CC not found' NOWAIT
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
	ENDPROC

	PROCEDURE frmHPApricing.cmbCC.GotFocus
		ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		
	ENDPROC

	PROCEDURE frmHPApricing.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		*DIMENSION aConditionCode(1,2)
		*aConditionCode(1,1) = "1"
		*aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*this.addListitem('*',1)
		*this.addListitem('All',2)
		This.Value = '*'
		
	ENDPROC

	PROCEDURE frmHPApricing.cmbCC.InteractiveChange
		PRIVATE cAlloy, cForm, cCC
		cAlloy 	= This.Parent.cmbAlloy.Value
		cForm	= This.Parent.cmbForm.Value
		cCC		= This.Value
		
		SELECT PriceTable
		LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC
		IF NOT FOUND('PriceTable')
			WAIT WINDOW 'CC not found' NOWAIT
			
			LOCATE FOR Alloy=cAlloy AND Form=cForm 
			IF NOT FOUND('PriceTable')
				WAIT WINDOW 'Form and CC not found' NOWAIT
		
				LOCATE FOR Alloy=cAlloy 
				IF NOT FOUND('PriceTable')
					WAIT WINDOW 'Alloy and Form and CC not found' NOWAIT
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
	ENDPROC

	PROCEDURE frmHPApricing.cmbCC.LostFocus
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		This.Parent.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		This.Parent.cmbCL.ColumnCount = 2
		This.Parent.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		This.Parent.cmbCL.BoundColumn = 1
		This.Parent.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Parent.cmbCL.Value = cCL1
		
		IF ThisFormSet.CC != PrepareSQLtxt(This.Value,'CC',1)
			ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
			This.Parent.cmbCL.Value = ''
			This.Parent.cmbCL.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE frmHPApricing.cmbCL.GotFocus
		ThisFormSet.CC = PrepareSQLtxt(This.Parent.cmbCC.Value,'CC',1)
		ThisFormSet.CL = PrepareSQLtxt(This.Value,'CL',1)
	ENDPROC

	PROCEDURE frmHPApricing.cmbCL.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
