		*	ThisFormSet.frmConditionCode.txtW1.VALUE = tmpConditionCode.W
		*	ThisFormSet.frmConditionCode.txtX.VALUE = tmpConditionCode.X
		*	ThisFormSet.frmConditionCode.txtY.VALUE = tmpConditionCode.Y
			
			ThisFormSet.frmConditionCode.cmdEditGrades.CAPTION = "Adjust"
		ENDIF
		
		IF USED("tmpConditionCode")
			USE IN tmpConditionCode
		ENDIF
		
	ENDPROC

	PROCEDURE refreshpricetable
		*ThisFormSet.RefreshPriceTable()
		
		*PriceTable record has changed, refresh windows.
		
		ThisFormSet.frmHPApricing.Refresh
		ThisFormSet.Refresh_HPApricing()
		
		IF NOT EOF('PriceTable')
			ThisFormset.frmPriceTable.grdAlloyForm.Refresh
			ThisFormSet.frmHPApricing.Refresh
			IF ThisFormSet.frmFormula.Visible
				ThisFormSet.frmFormula.Refresh
			ENDIF
			****************
			
			****************
		
			ThisFormSet.CalcTestPrice()
		
			ThisFormSet.frmWeb.Refresh
		
		
			ThisFormSet.CheckLineal()
			
			ThisFormset.frmHPApricing.cmbAlloy.Value = pricetable.alloy
			ThisFormset.frmHPApricing.cmbForm.Value = pricetable.form
			ThisFormset.frmHPApricing.cmbCC.Value = pricetable.CC
			ThisFormset.frmHPApricing.cmbCL.Value = pricetable.CL
			
		*	IF ThisFormSet.frmHPApricing.Visible
				ThisFormSet.frmHPApricing.Refresh()
		*	ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refresh_hpapricing
		*ThisFormSet.Refresh_HPApricing()
		*ThisFormset.frmHPApricing.W0.Value = PrepareSQLnum(pricetable.w0,'WO',7,2)
		
		IF ThisFormset.frmHPApricing.W0.Value < ThisFormset.frmHPApricing.W5.Value
