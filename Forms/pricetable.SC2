				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'')
		ENDIF
		
		ThisFormset.PriceTableReLoad(0,nPT_ID)
		*ThisFormSet.RefreshPriceTable()
		
		
		*ThisFormSet.frmHPApricing.ActivePric1.VALUE = .T.
		ThisFormSet.frmHPApricing.LastEdit1.VALUE = DTOC( DATE() )
