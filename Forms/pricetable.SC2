	PROCEDURE frmFormula.CostCurr.Valid
		PRIVATE nCostCurr
		nCostCurr = PrepareSQLnum(ThisForm.CostCurr.Value,'CostCurr',-5)
		IF nCostCurr > 0
			SELECT PriceTable
			REPLACE CostCurr WITH nCostCurr 
		
				
			ThisForm.t0.Value	= ( pricetable.a0 + 1 ) * nCostCurr 
			ThisForm.t5.Value	= ( pricetable.a5 + 1 ) * nCostCurr 
			ThisForm.t10.Value	= ( pricetable.a10 + 1 ) * nCostCurr 
			ThisForm.t25.Value	= ( pricetable.a25 + 1 ) * nCostCurr 
			ThisForm.t50.Value	= ( pricetable.a50 + 1 ) * nCostCurr 
			ThisForm.t100.Value	= ( pricetable.a100 + 1 ) * nCostCurr 
			ThisForm.t200.Value	= ( pricetable.a200 + 1 ) * nCostCurr 
			ThisForm.t500.Value	= ( pricetable.a500 + 1 ) * nCostCurr 
			ThisForm.t1000.Value	= ( pricetable.a1000 + 1 ) * nCostCurr 
			ThisForm.t2000.Value	= ( pricetable.a2000 + 1 ) * nCostCurr 
			ThisForm.tBase.Value	= ( pricetable.aBase + 1 ) * nCostCurr 
		
			ThisForm.txta0.Value	= (ThisForm.W0.Value / nCostCurr ) -1
			ThisForm.txta5.Value	= (ThisForm.W5.Value / nCostCurr ) -1
			ThisForm.txta10.Value	= (ThisForm.W10.Value / nCostCurr ) -1
			ThisForm.txta25.Value	= (ThisForm.W25.Value / nCostCurr ) -1
			ThisForm.txta50.Value	= (ThisForm.W50.Value / nCostCurr ) -1
			ThisForm.txta100.Value	= (ThisForm.W100.Value / nCostCurr ) -1
			ThisForm.txta200.Value	= (ThisForm.W200.Value / nCostCurr ) -1
			ThisForm.txta500.Value	= (ThisForm.W500.Value / nCostCurr ) -1
			ThisForm.txta1000.Value	= (ThisForm.W1000.Value / nCostCurr ) -1
			ThisForm.txta2000.Value	= (ThisForm.W2000.Value / nCostCurr ) -1
			ThisForm.txtaBase.Value	= (ThisForm.WBase.Value / nCostCurr ) -1
		ELSE
		
			ThisForm.t0.Value		= 0
			ThisForm.t5.Value		= 0
			ThisForm.t10.Value		= 0
			ThisForm.t25.Value		= 0
			ThisForm.t50.Value		= 0
			ThisForm.t100.Value		= 0
			ThisForm.t200.Value		= 0
			ThisForm.t500.Value		= 0
			ThisForm.t1000.Value	= 0
			ThisForm.t2000.Value	= 0
			ThisForm.tBase.Value	= 0
		
			ThisForm.txta0.Value	= 0.00
			ThisForm.txta5.Value	= 0.00
			ThisForm.txta10.Value	= 0.00
			ThisForm.txta25.Value	= 0.00
			ThisForm.txta50.Value	= 0.00
			ThisForm.txta100.Value	= 0.00
			ThisForm.txta200.Value	= 0.00
			ThisForm.txta500.Value	= 0.00
			ThisForm.txta1000.Value	= 0.00
			ThisForm.txta2000.Value	= 0.00
			ThisForm.txtaBase.Value	= 0.00
		ENDIF
	ENDPROC

