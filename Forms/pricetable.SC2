	PROCEDURE frmHPApricing.cmbCL.InteractiveChange
		PRIVATE cAlloy, cForm, cCC, cCL
		cAlloy 	= This.Parent.cmbAlloy.Value
		cForm	= This.Parent.cmbForm.Value
		cCC		= This.Parent.cmbCC.Value
		cCL		= PrepareSQLtxt(This.Value,'CL',1)
		
		*IF EMPTY(cCL)
		
		SELECT PriceTable
		LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC AND CL=cCL
		IF NOT FOUND('PriceTable')
			WAIT WINDOW 'CL not found' NOWAIT
			
			LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC 
			IF NOT FOUND('PriceTable')
				WAIT WINDOW 'CC/CL not found' NOWAIT
		
				LOCATE FOR Alloy=cAlloy AND Form=cForm 
				IF NOT FOUND('PriceTable')
					WAIT WINDOW 'Form and CC not found' NOWAIT
		
					LOCATE FOR Alloy=cAlloy 
					IF NOT FOUND('PriceTable')
						WAIT WINDOW 'Alloy and Form and CC not found' NOWAIT
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
	ENDPROC

	PROCEDURE frmHPApricing.cmbCL.LostFocus
		IF ThisFormSet.CL != PrepareSQLtxt(This.Value,'CL',1)
			ThisFormSet.CL = PrepareSQLtxt(This.Value,'CL',1)
		ENDIF
	ENDPROC

	PROCEDURE frmHPApricing.cmbForm.GotFocus
		PRIVATE cAlloy
		cAlloy = ThisForm.cmbAlloy.Value
		
		IF LEN(cAlloy) > 0
			This.Clear()
		
			SELECT DISTINCT Form FROM pricetable WHERE !DELETED() AND Alloy = cAlloy ;
				 ORDER BY Form INTO array aForms
			* AND ActivePric 
		
			FOR EACH m.cForm IN aForms
				IF !EMPTY(m.cForm)
					this.additem(m.cForm)
				ENDIF
			ENDFOR
		
		ENDIF
		
		
		
		
		
		
		************************
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Parent.cmbCC.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
