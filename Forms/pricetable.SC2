				WAIT WINDOW "Getting 365 days of Data!" NOWAIT
				
				cSQL = "SELECT * FROM ("
				cSQL = cSQL +" SELECT Alloy, Form, CC, CL, [Thck], P_Lb"
				cSQL = cSQL +" , dbo.WeightBracket( [Weight] ) AS WB "
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				cSQL = cSQL +" FROM dbo.AllQuotes "
				cSQL = cSQL +" WHERE "
				cSQL = cSQL +" Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				IF nSize2 > 0
					cSQL = cSQL +" AND Thck="+STR(nSize,9,4)
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +" AND Sz2="+STR(nSize2,8,3)
				ENDIF
				cSQL = cSQL +" AND P_Lb > 0"
				cSQL = cSQL +" AND InqDate >= GetDate()-365 "
				cSQL = cSQL +" ) as Source "
				cSQL = cSQL +" PIVOT "
				cSQL = cSQL +" ("
				cSQL = cSQL +" AVG(P_LB) FOR WB IN ( [0],[5],[10],[25],[50],[100],[200],[500],[1000],[2000],[BASE] ) "
				cSQL = cSQL +" ) AS PivotT "
				cSQL = cSQL +" ORDER by Thck"
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				IF USED("QuoteSheet")
					USE IN QuoteSheet
				ENDIF
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'QuoteSheet')
				ENDIF
		
			ENDIF
		ENDIF
		PRIVATE nSetDecimal
		nSetDecimal =  SET("Decimals")
		SET DECIMALS TO 4
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'QuoteSheet')
		ENDIF
		
		IF USED('QuoteSheet')
			IF RECCOUNT('QuoteSheet') > 0
				
		*		IF FILE(SYS(5)+SYS(2003) +"\PriceSheet.XLS")
		*		ENDIF
				*EXPORT TO (SYS(5)+SYS(2003)+"\PriceSheet.XLS") TYPE XLS
				IF "\MEM" $ SYS(2003)
					EXPORT TO (SYS(5)+SYS(2003)+"\QuoteSheet.DIF") TYPE DIF
				ELSE
					EXPORT TO (SYS(5)+SYS(2003)+"\MEM\QuoteSheet.DIF") TYPE DIF
				ENDIF
				
				WAIT WINDOW 'Done' NOWAIT
			
				LOCAL loExcel
				loExcel = CREATEOBJECT("Excel.Application")
		*		loExcel.workbooks.open(SYS(5)+SYS(2003)+"\PriceSheet.XLS")
				IF "\MEM" $ SYS(2003)
					loExcel.workbooks.open(SYS(5)+SYS(2003)+"\QuoteSheet.DIF")
				ELSE
					loExcel.workbooks.open(SYS(5)+SYS(2003)+"\MEM\QuoteSheet.DIF")
				ENDIF
				loExcel.visible = .T.
			
		*!*			IF FILE('Reports\QuoteSheet.FRX')
		*!*				IF nSize3 > 0
		*!*					REPORT FORM Reports\QuoteSheet3 PREVIEW
		*!*				ELSE
		*!*					IF nSize2 > 0
		*!*						REPORT FORM Reports\QuoteSheet2 PREVIEW
		*!*					ELSE
		*!*						REPORT FORM Reports\QuoteSheet PREVIEW
		*!*					ENDIF
		*!*				ENDIF	
		*!*			ELSE
		*!*				WAIT WINDOW 'Report form not found' NOWAIT
		*!*			ENDIF
				
				USE IN QuoteSheet
			ELSE
				MESSAGEBOX("No records where found!",48,"Not found!")
			ENDIF
		ELSE
			MESSAGEBOX("No records where found!",48,"Not found!")
		ENDIF
		
		IF nSetDecimal > 0
			SET DECIMALS TO (nSetDecimal)
		ENDIF
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdRebuildHist.Click
		WAIT WINDOW "Collecting History for HPA_Pricing, this will take a long time." NOWAIT
		PRIVATE cAlloy, cForm, cCC, cCL, nSize, nSize2
		cAlloy	= PrepareSQLtxt(pricetable.alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(pricetable.Form,'Form',2)
		cCC		= PrepareSQLtxt(priceTable.CC,'CC',1)
		cCL		= PrepareSQLtxt(priceTable.CL,'CL',1)
		nSize	= PrepareSQLnum(priceTable.Size,'Size',9,4)
		*nSize2	= PrepareSQLnum(priceTable.Size2,'Size2',8,3)
		nSize2	= 0
		
		PRIVATE cSQL
		*EXEC dbo.p_Fill_HPA_Pricing_New 'HPA N60','10','1', 12, 0
		cSQL = "EXEC HPA_Pricing.dbo.p_Fill_HPA_Pricing_New "
		cSQL = cSQL +" @ptAlloy='"+cAlloy+"'"
		cSQL = cSQL +",@ptForm='"+cForm+"'"
		cSQL = cSQL +",@ptCC='"+cCC+"'"
		cSQL = cSQL +",@ptCL='"+cCL+"'"
		cSQL = cSQL +",@ptSize="+STR(nSize,9,4)
		cSQL = cSQL +",@ptSize2="+STR(nSize2,8,3)
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC )
		ENDIF
		WAIT Clear
		
		MESSAGEBOX("History Table Complete!",64,"Done")
	ENDPROC

	PROCEDURE frmHPApricing.cmdReportCurrentStock.Click
		PRIVATE cHTTP, cAlloy, cForm, cCC, cCL, cThck
		cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.Form1.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.CC1.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.CL1.Value,'CL',1)
		cThck	= STR( PrepareSQLnum(ThisForm.Thk1.Value,'Thck',7,4) ,7,4)
		
		IF EMPTY(cCL)
			cHTTP = get_Report_Server()+"%2fInventory%2fSales+Detail+-+Pounds+by+month"
			cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm+"&CC="+cCC+"&Thck="+cThck
		ELSE
			cHTTP = get_Report_Server()+"%2fInventory%2fSales+Detail+CL+-+Pounds+by+month"
			cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm+"&CC="+cCC+"&CL="+cCL+"&Thck="+cThck
		ENDIF
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = cHTTP
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		WAIT WINDOW "Look for a blinking Internet Explorer to accept the file!" NOWAIT
	ENDPROC

	PROCEDURE frmHPApricing.cmdReportLinear.Click
		PRIVATE cAlloy, cForm, cCC, cCL
		PRIVATE cSQL, cSQLwhere, cSQLfields
		PRIVATE nSQLEXEC
		
		SELECT PriceTable 
		
		cAlloy	= ThisForm.ALLOY1.VALUE
		cForm	= ThisForm.Form1.VALUE
		cCC		= ThisForm.CC1.VALUE
		cCL		= ThisForm.CL1.VALUE
		
		cSQLwhere = " WHERE Alloy = '" + ALLTRIM(cAlloy) + " '"
		cSQLwhere = cSQLwhere + " AND Form = '" + ALLTRIM(cForm) + "'"
		cSQLwhere = cSQLwhere + " AND CC = '"+cCC+"'"
		cSQLwhere = cSQLwhere + " AND CL = '"+cCL+"'"
		
		
		IF EMPTY(cSQLwhere)
		   MESSAGEBOX("Define Which Records to Adjust",0,"Where clause is Empty!")
		   RETURN
		ENDIF
		
		cSQLfields = "Alloy,Form,CC,CL,Size,Size2,Size3,W0"
		cSQLfields = cSQLfields +",W5, SPACE(20) AS W5low "
		cSQLfields = cSQLfields +",W10, SPACE(20) AS W10low "
		cSQLfields = cSQLfields +",W25, SPACE(20) AS W25low "
		cSQLfields = cSQLfields +",W50, SPACE(20) AS W50low "
		cSQLfields = cSQLfields +",W100, SPACE(20) AS W100low "
		cSQLfields = cSQLfields +",W200, SPACE(20) AS W200low "
		cSQLfields = cSQLfields +",W500, SPACE(20) AS W500low "
		cSQLfields = cSQLfields +",W1000, SPACE(20) AS W1000low "
		cSQLfields = cSQLfields +",W2000, SPACE(20) AS W2000low "
		cSQLfields = cSQLfields +",Wbase, SPACE(20) AS Wbaselow "
		
		
		SELECT 0
		SELECT &cSQLfields FROM pricetable ;
			&cSQLwhere ;
			INTO CURSOR TempAdjPriceTable READWRITE
		
		
		***************************
		SELECT TempAdjPriceTable
		GO TOP
		
		*Found Reverse OR Low PriceBreak
		PRIVATE lFoundNL
		lFoundNL = .F.
		SCAN
			IF W0 <= W5 
				REPLACE W5low WITH 'Low '
				lFoundNL = .T.
			ENDIF
			IF W5 <= W10 
				REPLACE W10low WITH 'Low '
				lFoundNL = .T.
			ENDIF
			IF W10 <= W25
				REPLACE W25low WITH 'Low '
				lFoundNL = .T.
			ENDIF
			IF W25 <= W50 
				REPLACE W50low WITH 'Low '
				lFoundNL = .T.
			ENDIF
			IF W50 <= W100
				REPLACE W100low WITH 'Low '
				lFoundNL = .T.
			ENDIF
			IF W100 <= W200 
				REPLACE W200low WITH 'Low '
				lFoundNL = .T.
			ENDIF
			IF W200 <= W500 
				REPLACE W500low WITH 'Low '
				lFoundNL = .T.
			ENDIF
			IF W500 < W1000
				REPLACE W1000low WITH 'Low '
				lFoundNL = .T.
			ENDIF
			IF W1000 <= W2000
				REPLACE W2000low WITH 'Low '
				lFoundNL = .T.
			ENDIF
			IF W2000 <= wBase
				REPLACE Wbaselow WITH 'Low '
				lFoundNL = .T.
			ENDIF
			LOOP
		ENDSCAN
		
		IF lFoundNL
			MESSAGEBOX("There is Pricing issues where a next"+CHR(13)+"PriceBreak is a higher price."+CHR(13)+"You will be shown a report to revue."+CHR(13)+CHR(13)+"You will be asked if you want to:"+CHR(13)+"Raise prices to fix" +CHR(13)+"or Lower prices to fix.",48,"Data needs fixed.")
		ELSE
			MESSAGEBOX("The Pricing is Linear for Alloy: "+ALLTRIM(cAlloy)+"  and Form: "+cForm+" and CC = '"+cCC+"'"+" and CL = '"+cCL+"'",48,"Data is Good.")
			
			IF USED('TempAdjPriceTable')
				USE IN TempAdjPriceTable
			ENDIF
		
			SELECT Pricetable 
			RETURN
		ENDIF
		
		***************************
		
		SELECT TempAdjPriceTable
		*BROWSE TITLE (cSQLwhere)
		*PRINT the Original numbers
		IF FILE('Reports\PriceTableLine.FRX')
			REPORT FORM Reports\PriceTableLine PREVIEW
			*&cSQLwhere
			*SET PRINTER TO DEFAULT
		*	WAIT WINDOW 'PRINTED' NOWAIT
		ENDIF
		
		
		PRIVATE nMess
		nMess = 0
		IF lFoundNL
			nMess = MESSAGEBOX("Do you want the Computer to smooth the non-linear Pricing?"+CHR(13)+"RAISE price of next bracket to smooth out?",4+32,"Data needs fixed.(RAISE)")
			IF nMess = 6
			
				SELECT TempAdjPriceTable
				GO TOP
				SCAN
				
					IF W0 <= W5 
		
						cSQL = "UPDATE dbo.PriceTable SET W5 = case when W5 > (W0+W10)/2 then (W0+W10)/2 else W0-.05 end "
						cSQL = cSQL+" WHERE Alloy = '"+TempAdjPriceTable.Alloy+"'"
						cSQL = cSQL+" AND Form = '"+TempAdjPriceTable.Form+"'" 
						cSQL = cSQL+" AND CC = '"+TempAdjPriceTable.CC+"'"
						cSQL = cSQL+" AND CL = '"+TempAdjPriceTable.CL+"'"
						cSQL = cSQL+" AND Size = "+STR(TempAdjPriceTable.Size,8,3)
						cSQL = cSQL+" AND Size2 = "+STR(TempAdjPriceTable.Size2,8,3)
						cSQL = cSQL+" AND Size3 = "+STR(TempAdjPriceTable.Size3,8,3)
						cSQL = cSQL+" AND W0 <= W5 "
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, '')
						ENDIF
					ENDIF
					
					IF W5 <= W10 
		
						cSQL = "UPDATE dbo.PriceTable SET W10 = case when W10 > (W5+W25)/2 then (W5+W25)/2 else W5-.05 end "
						cSQL = cSQL+" WHERE Alloy = '"+TempAdjPriceTable.Alloy+"'"
						cSQL = cSQL+" AND Form = '"+TempAdjPriceTable.Form+"'" 
						cSQL = cSQL+" AND CC = '"+TempAdjPriceTable.CC+"'"
						cSQL = cSQL+" AND CL = '"+TempAdjPriceTable.CL+"'"
						cSQL = cSQL+" AND Size = "+STR(TempAdjPriceTable.Size,8,3)
						cSQL = cSQL+" AND Size2 = "+STR(TempAdjPriceTable.Size2,8,3)
						cSQL = cSQL+" AND Size3 = "+STR(TempAdjPriceTable.Size3,8,3)
						cSQL = cSQL+" AND W5 <= W10 "
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, '')
						ENDIF
					ENDIF
					
					IF W10 <= W25
		
						cSQL = "UPDATE dbo.PriceTable SET W25 = case when W25 > (W10+W50)/2 then (W10+W50)/2 else W10-.05 end "
						cSQL = cSQL+" WHERE Alloy = '"+TempAdjPriceTable.Alloy+"'"
						cSQL = cSQL+" AND Form = '"+TempAdjPriceTable.Form+"'" 
						cSQL = cSQL+" AND CC = '"+TempAdjPriceTable.CC+"'"
						cSQL = cSQL+" AND CL = '"+TempAdjPriceTable.CL+"'"
						cSQL = cSQL+" AND Size = "+STR(TempAdjPriceTable.Size,8,3)
						cSQL = cSQL+" AND Size2 = "+STR(TempAdjPriceTable.Size2,8,3)
						cSQL = cSQL+" AND Size3 = "+STR(TempAdjPriceTable.Size3,8,3)
						cSQL = cSQL+" AND W10 <= W25 "
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, '')
						ENDIF				
					ENDIF
					
					IF W25 <= W50 
						
						cSQL = "UPDATE dbo.PriceTable SET W50 = case when W50 > (W25+W100)/2 then (W25+W100)/2 else W25-.05 end "
						cSQL = cSQL+" WHERE Alloy = '"+TempAdjPriceTable.Alloy+"'"
						cSQL = cSQL+" AND Form = '"+TempAdjPriceTable.Form+"'" 
						cSQL = cSQL+" AND CC = '"+TempAdjPriceTable.CC+"'"
						cSQL = cSQL+" AND CL = '"+TempAdjPriceTable.CL+"'"
						cSQL = cSQL+" AND Size = "+STR(TempAdjPriceTable.Size,8,3)
						cSQL = cSQL+" AND Size2 = "+STR(TempAdjPriceTable.Size2,8,3)
						cSQL = cSQL+" AND Size3 = "+STR(TempAdjPriceTable.Size3,8,3)
						cSQL = cSQL+" AND W25 <= W50 "
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, '')
						ENDIF
					ENDIF
					
					IF W50 <= W100
						
						cSQL = "UPDATE dbo.PriceTable SET W100 = case when W100 > (W50+W200)/2 then (W50+W200)/2 else W50-.05 end "
						cSQL = cSQL+" WHERE Alloy = '"+TempAdjPriceTable.Alloy+"'"
						cSQL = cSQL+" AND Form = '"+TempAdjPriceTable.Form+"'" 
						cSQL = cSQL+" AND CC = '"+TempAdjPriceTable.CC+"'"
						cSQL = cSQL+" AND CL = '"+TempAdjPriceTable.CL+"'"
						cSQL = cSQL+" AND Size = "+STR(TempAdjPriceTable.Size,8,3)
						cSQL = cSQL+" AND Size2 = "+STR(TempAdjPriceTable.Size2,8,3)
						cSQL = cSQL+" AND Size3 = "+STR(TempAdjPriceTable.Size3,8,3)
						cSQL = cSQL+" AND W50 <= W100 "
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, '')
						ENDIF
					ENDIF
					
					IF W100 <= W200 
						
						cSQL = "UPDATE dbo.PriceTable SET W200 = case when W200 > (W100+W500)/2 then (W100+W500)/2 else W100-.05 end "
						cSQL = cSQL+" WHERE Alloy = '"+TempAdjPriceTable.Alloy+"'"
						cSQL = cSQL+" AND Form = '"+TempAdjPriceTable.Form+"'" 
						cSQL = cSQL+" AND CC = '"+TempAdjPriceTable.CC+"'"
						cSQL = cSQL+" AND CL = '"+TempAdjPriceTable.CL+"'"
						cSQL = cSQL+" AND Size = "+STR(TempAdjPriceTable.Size,8,3)
						cSQL = cSQL+" AND Size2 = "+STR(TempAdjPriceTable.Size2,8,3)
						cSQL = cSQL+" AND Size3 = "+STR(TempAdjPriceTable.Size3,8,3)
						cSQL = cSQL+" AND W100 <= W200 "
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
