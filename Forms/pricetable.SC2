	PROCEDURE update_pricetable
		PARAMETERS pWhat
		*Clone or SAVE
		*ThisFormSet.Update_PriceTable()
		PRIVATE lClone
		lClone = .F.
		IF VARtype(pWhat) = "C"
			lClone = .T.
		ENDIF
		
		PRIVATE cAlloy, cForm, cThk, nSize, nSize2, nSize3
		PRIVATE nW0, nW5, nW10, nW25, nW50, nW100, nW200, nW500, nW1000, nW2000, nWBase
		PRIVATE nA0, nA5, nA10, nA25, nA50, nA100, nA200, nA500, nA1000, nA2000, nABase
		PRIVATE nH0, nH5, nH10, nH25, nH50, nH100, nH200, nH500, nH1000, nH2000, nHBase
		PRIVATE nCostCurr, nCost2013, nCost2007
		PRIVATE cCC, cCL, dHist, cCommSpec, nPT_ID
		
		
		IF lClone
			*Collect Data
			cAlloy	= PrepareSQLtxt(pricetable.alloy,'Alloy',12)
			cForm	= PrepareSQLtxt(pricetable.Form,'Form',2)
			cCC		= PrepareSQLtxt(priceTable.CC,'CC',1)
			cCL		= PrepareSQLtxt(priceTable.CL,'CL',1)
			cThk	= PrepareSQLtxt(pricetable.Thk,'Thk',5)
		*	nSize	= PrepareSQLnum(pricetable.Size,'Size',9,7)
			nSize	= 9999.9999
			nSize2	= PrepareSQLnum(pricetable.Size2,'Size2',8,3)
			nSize3	= PrepareSQLnum(pricetable.Size3,'Size3',8,3)
		
			*Check for existance of Size=9999.9999
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PriceTable WHERE "
			cSQL = cSQL +" Alloy='"+cAlloy+"'"
			cSQL = cSQL +" AND Form='"+cForm+"'"
			cSQL = cSQL +" AND CC='"+cCC+"'"
			cSQL = cSQL +" AND CL='"+cCL+"'"
			cSQL = cSQL +" AND [SIZE]="+STR(nSize,9,4)
			cSQL = cSQL +" AND [SIZE2]="+STR(nSize2,8,3)
			cSQL = cSQL +" AND [SIZE3]="+STR(nSize2,8,3)
			
			IF USED('cntPriceTable')
				USE IN cntPriceTable
			ENDIF
			SELECT 0
			
			PRIVATE nSQLEXEC 
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntPriceTable' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntPriceTable' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntPriceTable")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntPriceTable")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'cntPriceTable')
			ENDIF
			IF USED('cntPriceTable')
				IF cntPriceTable.CNTD > 0
					cSQL = "DELETE * FROM dbo.PriceTable WHERE "
					cSQL = cSQL +" Alloy='"+cAlloy+"'"
					cSQL = cSQL +" AND Form='"+cForm+"'"
					cSQL = cSQL +" AND CC='"+cCC+"'"
					cSQL = cSQL +" AND CL='"+cCL+"'"
					cSQL = cSQL +" AND [SIZE]="+STR(nSize,9,4)
					cSQL = cSQL +" AND [SIZE2]="+STR(nSize2,8,3)
					cSQL = cSQL +" AND [SIZE3]="+STR(nSize2,8,3)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'')
						MESSAGEBOX("Look for a record with Same Alloy, Form with Size of 9999.9999",64,"Most common Error")
					ENDIF
					
				ENDIF	
				USE IN cntPriceTable
			ENDIF
		
		
			nW0		= PrepareSQLnum(pricetable.W0,'W',7,2)
			nW5		= PrepareSQLnum(pricetable.W5,'W',7,2)
			nW10	= PrepareSQLnum(pricetable.W10,'W',7,2)
			nW25	= PrepareSQLnum(pricetable.W25,'W',7,2)
			nW50	= PrepareSQLnum(pricetable.W50,'W',7,2)
			nW100	= PrepareSQLnum(pricetable.W100,'W',7,2)
			nW200	= PrepareSQLnum(pricetable.W200,'W',7,2)
			nW500	= PrepareSQLnum(pricetable.W500,'W',7,2)
			nW1000	= PrepareSQLnum(pricetable.W1000,'W',7,2)
			nW2000	= PrepareSQLnum(pricetable.W2000,'W',7,2)
			nWBase	= PrepareSQLnum(pricetable.WBase,'W',7,2)
		
			nA0		= PrepareSQLnum(pricetable.A0,'A',9,6)
			nA5		= PrepareSQLnum(pricetable.A5,'A',9,6)
			nA10	= PrepareSQLnum(pricetable.A10,'A',9,6)
			nA25	= PrepareSQLnum(pricetable.A25,'A',9,6)
			nA50	= PrepareSQLnum(pricetable.A50,'A',9,6)
			nA100	= PrepareSQLnum(pricetable.A100,'A',9,6)
			nA200	= PrepareSQLnum(pricetable.A200,'A',9,6)
			nA500	= PrepareSQLnum(pricetable.A500,'A',9,6)
			nA1000	= PrepareSQLnum(pricetable.A1000,'A',9,6)
			nA2000	= PrepareSQLnum(pricetable.A2000,'A',9,6)
			nABase	= PrepareSQLnum(pricetable.ABase,'A',9,6)
		
			nH0		= PrepareSQLnum(pricetable.H0,'H',9,6)
			nH5		= PrepareSQLnum(pricetable.H5,'H',9,6)
			nH10	= PrepareSQLnum(pricetable.H10,'H',9,6)
			nH25	= PrepareSQLnum(pricetable.H25,'H',9,6)
			nH50	= PrepareSQLnum(pricetable.H50,'H',9,6)
			nH100	= PrepareSQLnum(pricetable.H100,'H',9,6)
			nH200	= PrepareSQLnum(pricetable.H200,'H',9,6)
			nH500	= PrepareSQLnum(pricetable.H500,'H',9,6)
			nH1000	= PrepareSQLnum(pricetable.H1000,'H',9,6)
			nH2000	= PrepareSQLnum(pricetable.H2000,'H',9,6)
			nHBase	= PrepareSQLnum(pricetable.HBase,'H',9,6)
		
			nCostCurr = PrepareSQLnum(pricetable.costCurr,'CostCurr',-5)
			nCost2013 = PrepareSQLnum(pricetable.cost2013,'Cost2013',-5)
			nCost2007 = PrepareSQLnum(pricetable.cost2007,'Cost2007',-5)
		
			cCommSpec	= pricetable.CommSpec
			IF VARTYPE(cCommSpec) != 'C'
				cCommSpec = ''
			ENDIF
			cCommSpec = LEFT(cCommSpec,20)   &&20 char max
			dHist		= pricetable.Hist  &&Do not INSERT so defaults to GetDate()
			
			*Blank some fields
			ThisFormSet.frmHPApricing.lblCloneThk.Caption = IIF(TYPE('Pricetable.Thk')="C",ThisFormSet.frmHPApricing.THK1.Value,"")
			ThisFormSet.frmHPApricing.lblCloneSz1.Caption = IIF(TYPE('Pricetable.Size')="N",ALLTRIM(STR(ThisFormSet.frmHPApricing.Size1.Value,9,4)),'0')
			ThisFormSet.frmHPApricing.lblCloneSz2.Caption = IIF(IsNull(ThisFormSet.frmHPApricing.Size2.Value),"NULL",ALLTRIM(STR(ThisFormSet.frmHPApricing.Size2.Value,8,3)))
			ThisFormSet.frmHPApricing.lblCloneSz3.Caption = IIF(IsNull(ThisFormSet.frmHPApricing.Size3.Value),"NULL",ALLTRIM(STR(ThisFormSet.frmHPApricing.Size3.Value,8,3)))
		
			*ThisForm.BUTTONSET1.cmdAdd.Click
			ThisFormSet.frmHPApricing.lblCloneThk.Visible = .T.
			ThisFormSet.frmHPApricing.lblCloneSz1.Visible = .T.
			ThisFormSet.frmHPApricing.lblCloneSz2.Visible = .T.
			ThisFormSet.frmHPApricing.lblCloneSz3.Visible = .T.
		
			ThisFormSet.nPT_ID = ThisFormSet.frmHPApricing.PT_ID1.Value
			ThisFormSet.frmHPApricing.PT_ID1.Value = 0
			
			******
			cSQL = "EXEC dbo.p_PriceTable_ins "
			cSQL = cSQL +" @Alloy='"+cAlloy+"'"
			cSQL = cSQL +",@Form='"+cForm+"'"
			cSQL = cSQL +",@CC='"+cCC+"'"
			cSQL = cSQL +",@CL='"+cCL+"'"
			cSQL = cSQL +",@Thk='"+cThk+"'"
			cSQL = cSQL +",@Size="+STR(nSize,9,4)
			cSQL = cSQL +",@Size2="+STR(nSize2,8,3)
			cSQL = cSQL +",@Size3="+STR(nSize3,8,3)
			
			cSQL = cSQL +",@W0="+STR(nW0,7,2)
			cSQL = cSQL +",@W5="+STR(nW5,7,2)
			cSQL = cSQL +",@W10="+STR(nW10,7,2)
			cSQL = cSQL +",@W25="+STR(nW25,7,2)
			cSQL = cSQL +",@W50="+STR(nW50,7,2)
			cSQL = cSQL +",@W100="+STR(nW100,7,2)
			cSQL = cSQL +",@W200="+STR(nW200,7,2)
			cSQL = cSQL +",@W500="+STR(nW500,7,2)
			cSQL = cSQL +",@W1000="+STR(nW1000,7,2)
			cSQL = cSQL +",@W2000="+STR(nW2000,7,2)
			cSQL = cSQL +",@WBase="+STR(nWBase,7,2)
			
			cSQL = cSQL +",@H0="+STR(nH0,9,6)
			cSQL = cSQL +",@H5="+STR(nH5,9,6)
			cSQL = cSQL +",@H10="+STR(nH10,9,6)
			cSQL = cSQL +",@H25="+STR(nH25,9,6)
			cSQL = cSQL +",@H50="+STR(nH50,9,6)
			cSQL = cSQL +",@H100="+STR(nH100,9,6)
			cSQL = cSQL +",@H200="+STR(nH200,9,6)
			cSQL = cSQL +",@H500="+STR(nH500,9,6)
			cSQL = cSQL +",@H1000="+STR(nH1000,9,6)
			cSQL = cSQL +",@H2000="+STR(nH2000,9,6)
			cSQL = cSQL +",@HBase="+STR(nHBase,9,6)
			
			cSQL = cSQL +",@A0="+STR(nA0,9,6)
			cSQL = cSQL +",@A5="+STR(nA5,9,6)
			cSQL = cSQL +",@A10="+STR(nA10,9,6)
			cSQL = cSQL +",@A25="+STR(nA25,9,6)
			cSQL = cSQL +",@A50="+STR(nA50,9,6)
			cSQL = cSQL +",@A100="+STR(nA100,9,6)
			cSQL = cSQL +",@A200="+STR(nA200,9,6)
			cSQL = cSQL +",@A500="+STR(nA500,9,6)
			cSQL = cSQL +",@A1000="+STR(nA1000,9,6)
			cSQL = cSQL +",@A2000="+STR(nA2000,9,6)
			cSQL = cSQL +",@ABase="+STR(nABase,9,6)
		
			cSQL = cSQL +",@CostCurr="+STR(nCostCurr,18,10)
			cSQL = cSQL +",@Cost2013="+STR(nCost2013,18,10)
			cSQL = cSQL +",@Cost2007="+STR(nCost2007,18,10)
			cSQL = cSQL +",@CommSpec='"+cCommSpec+"'"
			**ActivePric is set TRUE here!
			
			IF USED('tmpPriceTableID')
				USE IN tmpPriceTableID
			ENDIF
			SELECT 0
		
			
			PRIVATE nSQLEXEC 
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPriceTableID' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPriceTableID' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTableID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPriceTableID")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
		ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'tmpPriceTableID')
			ELSE
				IF USED('tmpPriceTableID')
					IF VARTYPE(tmpPriceTableID.EXP) = 'N'
						IF tmpPriceTableID.EXP > 0
							ThisFormSet.frmHPApricing.PT_ID1.Value = tmpPriceTableID.EXP
							ThisFormSet.nAddRec = tmpPriceTableID.EXP
						ENDIF
					ENDIF
					USE IN tmpPriceTableID
				ENDIF
				
				ThisFormset.PriceTableReLoad(0,ThisFormSet.frmHPApricing.PT_ID1.Value)
					
				ThisFormset.frmHPApricing.cmdClone.Visible = .F.
				ThisFormset.frmHPApricing.cmdAdd.Visible = .F.
		
				ThisFormSet.frmHPApricing.ActivePric1.VALUE = .T.
				ThisFormSet.frmHPApricing.LastEdit1.VALUE = DTOC( DATE() )
			
				PRIVATE MachineInfo, cLoginUN
				MachineInfo = SYS(0)
				IF MachineInfo = "1"
					cLoginUN = ""
				ELSE
					cLoginUN = RIGHT(MachineInfo,LEN(MachineInfo)-AT("#",MachineInfo) -1 )
				ENDIF
			
				ThisFormSet.frmHPApricing.UserName1.VALUE = cLoginUN 
				
				MESSAGEBOX("Remember to edit Thk, Size1, 'Lbs/In' and ActivePrice"+CHR(13)+"before you save."+CHR(13)+CHR(13)+"If you revert now, the cloned record will still exist!"+CHR(13)+"Only your edits since the clone will revert!", 0+64,"Clone is Ready")
				
				ThisFormSet.frmHPApricing.THK1.SetFocus
				
				*ThisFormset.CloneMode = .T.
			ENDIF
			*end Clone
		ELSE 
			*SAVE PriceTable
			*Save the Edited data	
			PRIVATE MachineInfo, cLoginUN
			MachineInfo = SYS(0)
			IF MachineInfo = "1"
				cLoginUN = ""
			ELSE
				cLoginUN = RIGHT(MachineInfo,LEN(MachineInfo)-AT("#",MachineInfo) -1 )
			ENDIF
		
			cCommSpec= PrepareSQLtxt(ThisFormSet.frmHPApricing.CommSpec1.Value,'Commspec',20)	
			cAlloy	= PrepareSQLtxt(ThisFormSet.frmHPApricing.ALLOY1.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormSet.frmHPApricing.Form1.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormSet.frmHPApricing.CC1.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormSet.frmHPApricing.CL1.Value,'CL',1)
			cThk	= PrepareSQLtxt(ThisFormSet.frmHPApricing.Thk1.Value,'Thk',5)
			nSize	= PrepareSQLnum(ThisFormSet.frmHPApricing.Size1.Value,'Size',9,4)
			nSize2	= PrepareSQLnum(ThisFormSet.frmHPApricing.Size2.Value,'Size2',8,3)
			nSize3	= PrepareSQLnum(ThisFormSet.frmHPApricing.Size3.Value,'Size3',8,3)
		
			
			nW0		= PrepareSQLnum(ThisFormSet.frmHPApricing.W0.Value,'W',7,2)
			nW5		= PrepareSQLnum(ThisFormSet.frmHPApricing.W5.Value,'W',7,2)
			nW10	= PrepareSQLnum(ThisFormSet.frmHPApricing.W10.Value,'W',7,2)
			nW25	= PrepareSQLnum(ThisFormSet.frmHPApricing.W25.Value,'W',7,2)
			nW50	= PrepareSQLnum(ThisFormSet.frmHPApricing.W50.Value,'W',7,2)
			nW100	= PrepareSQLnum(ThisFormSet.frmHPApricing.W100.Value,'W',7,2)
			nW200	= PrepareSQLnum(ThisFormSet.frmHPApricing.W200.Value,'W',7,2)
			nW500	= PrepareSQLnum(ThisFormSet.frmHPApricing.W500.Value,'W',7,2)
			nW1000	= PrepareSQLnum(ThisFormSet.frmHPApricing.W1000.Value,'W',7,2)
			nW2000	= PrepareSQLnum(ThisFormSet.frmHPApricing.W2000.Value,'W',7,2)
			nWBase	= PrepareSQLnum(ThisFormSet.frmHPApricing.WBase.Value,'W',7,2)
		
			lActivePric = PrepareSQLchk(ThisFormSet.frmHPApricing.ActivePric1.Value,'ActivePric',1)
			nbar_lbs_in = PrepareSQLnum(ThisFormSet.frmHPApricing.bar_lbs_in1.Value,'bar_lbs_in',32,16)
			
			nH0		= PrepareSQLnum(ThisFormSet.frmFormula.H0.Value,'H',9,6)
			nH5		= PrepareSQLnum(ThisFormSet.frmFormula.H5.Value,'H',9,6)
			nH10	= PrepareSQLnum(ThisFormSet.frmFormula.H10.Value,'H',9,6)
			nH25	= PrepareSQLnum(ThisFormSet.frmFormula.H25.Value,'H',9,6)
			nH50	= PrepareSQLnum(ThisFormSet.frmFormula.H50.Value,'H',9,6)
			nH100	= PrepareSQLnum(ThisFormSet.frmFormula.H100.Value,'H',9,6)
			nH200	= PrepareSQLnum(ThisFormSet.frmFormula.H200.Value,'H',9,6)
			nH500	= PrepareSQLnum(ThisFormSet.frmFormula.H500.Value,'H',9,6)
			nH1000	= PrepareSQLnum(ThisFormSet.frmFormula.H1000.Value,'H',9,6)
			nH2000	= PrepareSQLnum(ThisFormSet.frmFormula.H2000.Value,'H',9,6)
			nHBase	= PrepareSQLnum(ThisFormSet.frmFormula.HBase.Value,'H',9,6)
		
			nA0		= PrepareSQLnum(ThisFormSet.frmFormula.A0.Value,'A',9,6)
			nA5		= PrepareSQLnum(ThisFormSet.frmFormula.A5.Value,'A',9,6)
			nA10	= PrepareSQLnum(ThisFormSet.frmFormula.A10.Value,'A',9,6)
			nA25	= PrepareSQLnum(ThisFormSet.frmFormula.A25.Value,'A',9,6)
			nA50	= PrepareSQLnum(ThisFormSet.frmFormula.A50.Value,'A',9,6)
			nA100	= PrepareSQLnum(ThisFormSet.frmFormula.A100.Value,'A',9,6)
			nA200	= PrepareSQLnum(ThisFormSet.frmFormula.A200.Value,'A',9,6)
			nA500	= PrepareSQLnum(ThisFormSet.frmFormula.A500.Value,'A',9,6)
			nA1000	= PrepareSQLnum(ThisFormSet.frmFormula.A1000.Value,'A',9,6)
			nA2000	= PrepareSQLnum(ThisFormSet.frmFormula.A2000.Value,'A',9,6)
			nABase	= PrepareSQLnum(ThisFormSet.frmFormula.ABase.Value,'A',9,6)
			
			nCostCurr = PrepareSQLnum(ThisFormSet.frmFormula.costCurr.Value,'CostCurr',-5)
			nCost2013 = PrepareSQLnum(ThisFormSet.frmFormula.cost2013.Value,'Cost2013',-5)
			nCost2007 = PrepareSQLnum(ThisFormSet.frmFormula.cost2007.Value,'Cost2007',-5)
			nCost2002 = PrepareSQLnum(ThisFormSet.frmFormula.cost2002.Value,'Cost2002',-5)
			nCost1999 = PrepareSQLnum(ThisFormSet.frmFormula.cost1999.Value,'Cost1999',-5)
		
			nPT_ID = ThisFormSet.frmFormula.PT_ID1.Value
			IF VARTYPE(nPT_ID) = "C"
				nPT_ID = VAL(PT_ID)
			ENDIF
			
			IF VARTYPE(cCommSpec) != 'C'
				cCommSpec = ''
			ENDIF
			cCommSpec = LEFT(cCommSpec,20)   &&20 char max
		
			cSQL = "UPDATE dbo.PriceTable SET "
			cSQL = cSQL +"Alloy='"+cAlloy+"',Form='"+cForm+"',Thk='"+cThk+"',CC='"+cCC+"',CL='"+cCL+"'"
			cSQL = cSQL +",[SIZE]="+STR(nSize,9,4)+",Size2="+STR(nSize2,8,3)+",Size3="+STR(nSize3,8,3)
			cSQL = cSQL +",W0="+STR(nW0,7,2)+",W5="+STR(nW5,7,2)+",W10="+STR(nW10,7,2)+",W25="+STR(nW25,7,2)+",W50="+STR(nW50,7,2)+",W100="+STR(nW100,7,2)+",W200="+STR(nW200,7,2)+",W500="+STR(nW500,7,2)+",W1000="+STR(nW1000,7,2)+",W2000="+STR(nW2000,7,2)+",WBase="+STR(nWBase,7,2)
			cSQL = cSQL +",ActivePric="+IIF(lActivePric,'1','0')
			cSQL = cSQL +",LastEdit='"+DTOC( DATE() )+"'"
			cSQL = cSQL +",bar_lbs_in="+STR(nbar_lbs_in,32,16)
			cSQL = cSQL +",UserName='"+cLoginUN+"'"
			cSQL = cSQL +",H0="+STR(nH0,9,6)+",H5="+STR(nH5,9,6)+",H10="+STR(nH10,9,6)+",H25="+STR(nH25,9,6)+",H50="+STR(nH50,9,6)+",H100="+STR(nH100,9,6)+",H200="+STR(nH200,9,6)+",H500="+STR(nH500,9,6)+",H1000="+STR(nH1000,9,6)+",H2000="+STR(nH2000,9,6)+",HBase="+STR(nHBase,9,6)
			cSQL = cSQL +",A0="+STR(nA0,9,6)+",A5="+STR(nA5,9,6)+",A10="+STR(nA10,9,6)+",A25="+STR(nA25,9,6)+",A50="+STR(nA50,9,6)+",A100="+STR(nA100,9,6)+",A200="+STR(nA200,9,6)+",A500="+STR(nA500,9,6)+",A1000="+STR(nA1000,9,6)+",A2000="+STR(nA2000,9,6)+",ABase="+STR(nABase,9,6)
			cSQL = cSQL +",CostCurr="+STR(nCostCurr,18,10)+",Cost2013="+STR(nCost2013,18,10)+",Cost2007="+STR(nCost2007,18,10)+",Cost2002="+STR(nCost2002,18,10)+",Cost1999="+STR(nCost1999,18,10)+",CommSpec='"+cCommSpec+"'"
			cSQL = cSQL +" WHERE PT_ID ="+STR( nPT_ID )
		
			PRIVATE nSQLEXEC 
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'')
			ELSE
				IF ThisFormSet.nAddRec = nPT_ID 
					WAIT WINDOW "Collecting History for HPA_Pricing, this will take a long time." TIMEOUT 2
					PRIVATE cSQL
					*EXEC dbo.p_Fill_HPA_Pricing_New 'HPA N60','10','1', 12, 0
					cSQL = "EXEC HPA_Pricing.dbo.p_Fill_HPA_Pricing_New "
					cSQL = cSQL +" @ptAlloy='"+cAlloy+"'"
					cSQL = cSQL +",@ptForm='"+cForm+"'"
					cSQL = cSQL +",@ptCC='"+cCC+"'"
					cSQL = cSQL +",@ptCL='"+cCL+"'"
					cSQL = cSQL +",@ptSize="+STR(nSize,9,4)
					cSQL = cSQL +",@ptSize2="+STR(nSize2,8,3)
					
					PRIVATE nSQLEXEC 
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC )
					ENDIF
					WAIT Clear
		
					MESSAGEBOX("History Table Complete!",64,"Done")
				ENDIF
			ENDIF
			
			ThisFormset.PriceTableReLoad(0,nPT_ID)
			
			ThisFormset.frmHPApricing.cmdClone.Visible = .T.
			ThisFormset.frmHPApricing.cmdAdd.Visible = .T.
				
			ThisFormSet.frmHPApricing.LastEdit1.VALUE = DTOC( DATE() )
		
			ThisFormSet.frmHPApricing.UserName1.VALUE = cLoginUN
				
		ENDIF
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbAlloy.Init
		*#DEFINE ALLAlloy_LOC "(All)"
		this.clear
		*this.additem(ALLAlloy_LOC)
		
		LOCAL aAlloys,cAlloy
		DIMENSION aAlloys[1]
		
		SELECT DISTINCT alloy FROM pricetable WHERE !DELETED() AND !EMPTY(alloy) ORDER BY Alloy INTO array aAlloys
		*AND ActivePric 
		
		FOR EACH m.cAlloy IN aAlloys
			IF !EMPTY(m.cAlloy)
				this.additem(m.cAlloy)
			ENDIF
		ENDFOR
		
		*THIS.VALUE = ALLAlloy_LOC
		THIS.VALUE = aAlloys(1)
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbAlloy.InteractiveChange
		SELECT PriceTable
		PRIVATE cAlloyNow 
		cAlloyNow = PriceTable.Alloy
				
		IF This.Value = "(All)"
			LOCATE FOR Alloy = cAlloyNow 
		ELSE
			LOCATE FOR Alloy = This.Value
		ENDIF
		
		ThisFormset.DispAlloyFilter = This.Value
		
		ThisFormSet.frmAdjustPrice.cmbAlloy.Value = This.Value
		ThisFormSet.frmHPApricing.cmbAlloy.Value = This.Value
		ThisFormSet.frmPrint.cmbAlloy.Value = This.Value
		
		ThisFormSet.RefreshPriceTable()
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbCC.GotFocus
		ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbCC.Init
		this.clear
		
		LOCAL aCC,cForm
		DIMENSION aCC[1]
		
		This.AddItem("*",1)
		
		SELECT DISTINCT CC FROM pricetable WHERE !DELETED() AND !EMPTY(CC);
			 ORDER BY CC INTO array aCC
		* AND ActivePric 
			 
		FOR i = 1 TO ALEN( aCC,1 )
		*FOR EACH i IN aCC
			IF !EMPTY(aCC(i,1))
				this.additem(aCC(i,1))
			ENDIF
		ENDFOR
		
		ThisFormset.DispCCFilter=aCC(1,1)
		
		THIS.VALUE = "*" 	&&aCC(1,1)
		
		
		*!*	PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		*!*	IF USED('ConditionCode')
		*!*		SELECT ConditionCode
		*!*	ELSE
		*!*		SELECT 0
		*!*	ENDIF
		
		*!*	this.clear
		*!*	cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
		*!*	ENDIF
		
		*!*	*DIMENSION aConditionCode(1,2)
		*!*	*aConditionCode(1,1) = "1"
		*!*	*aConditionCode(1,2) = "Anneal"
		
		*!*	IF USED('ConditionCode')
		*!*		SELECT * FROM ConditionCode INTO ARRAY aConditionCode
		*!*		
		*!*		USE IN ConditionCode
		*!*	ENDIF
		
		*!*	This.ColumnCount = 2
		*!*	This.NumberOfElements=ALEN(aConditionCode)
		*!*	This.BoundColumn = 1
		*!*	This.ColumnWidths = "10,115"
		
		*!*	nLoopCount = 1
		
		*!*	FOR EACH cc1 IN aConditionCode
		*!*		IF !EMPTY(cc1)
		*!*			IF LEN(ALLTRIM(cc1)) > 1
		*!*				
		*!*				this.addListitem(ALLTRIM(cc1),nLoopCount,2)
		*!*			ELSE
		*!*				nLoopCount = nLoopCount + 1
		*!*				this.addListitem(ALLTRIM(cc1),nLoopCount,1)
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDFOR
		
		*!*	*this.addListitem('*',1)
		*!*	*this.addListitem('All',2)
		*!*	This.Value = '*'
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbCC.InteractiveChange
		PRIVATE cAlloy, cForm, cCC
		cAlloy 	= This.Parent.cmbAlloy.Value
		cForm	= This.Parent.cmbForm.Value
		cCC		= This.Value
		
		SELECT PriceTable
		LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC
		IF NOT FOUND('PriceTable')
			WAIT WINDOW 'CC not found' NOWAIT
			
			LOCATE FOR Alloy=cAlloy AND Form=cForm 
			IF NOT FOUND('PriceTable')
				WAIT WINDOW 'Form and CC not found' NOWAIT
		
				LOCATE FOR Alloy=cAlloy 
				IF NOT FOUND('PriceTable')
					WAIT WINDOW 'Alloy and Form and CC not found' NOWAIT
				ENDIF
			ENDIF
		ENDIF
		
		This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
		ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		ThisFormSet.RefreshPriceTable()
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbCC.LostFocus
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		This.Parent.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		This.Parent.cmbCL.ColumnCount = 2
		This.Parent.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		This.Parent.cmbCL.BoundColumn = 1
		This.Parent.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Parent.cmbCL.Value = cCL1
		
		IF ThisFormSet.CC != PrepareSQLtxt(This.Value,'CC',1)
			ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
			This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
		*	This.Parent.cmbCL.Value = ''
			This.Parent.cmbCL.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbCL.GotFocus
		ThisFormSet.CC = PrepareSQLtxt(This.Parent.cmbCC.Value,'CC',1)
		ThisFormSet.CL = PrepareSQLtxt(This.Value,'CL',1)
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbCL.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			cCL1 = ''
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Value = cCL1
		*This.Value = ''
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbCL.InteractiveChange
		PRIVATE cAlloy, cForm, cCC, cCL
		cAlloy 	= This.Parent.cmbAlloy.Value
		cForm	= This.Parent.cmbForm.Value
		cCC		= This.Parent.cmbCC.Value
		cCL 	= PrepareSQLtxt(This.Value,'CL',1)
		
		*IF EMPTY(cCL)
		
		SELECT PriceTable
		LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC AND CL=cCL
		IF NOT FOUND('PriceTable')
			WAIT WINDOW 'CL not found' NOWAIT
			
			LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC 
			IF NOT FOUND('PriceTable')
				WAIT WINDOW 'CC/CL not found' NOWAIT
		
		
				LOCATE FOR Alloy=cAlloy AND Form=cForm 
				IF NOT FOUND('PriceTable')
					WAIT WINDOW 'Form and CC not found' NOWAIT
		
					LOCATE FOR Alloy=cAlloy 
					IF NOT FOUND('PriceTable')
						WAIT WINDOW 'Alloy and Form and CC not found' NOWAIT
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbCL.LostFocus
		IF ThisFormSet.CL != PrepareSQLtxt(This.Value,'CL',1)
			ThisFormSet.CL = PrepareSQLtxt(This.Value,'CL',1)
		ENDIF
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbForm.GotFocus
		PRIVATE cAlloy
		cAlloy = ThisForm.cmbAlloy.Value
		
		IF LEN(cAlloy) > 0
			This.Clear()
		
			SELECT DISTINCT Form FROM PriceTable WHERE !DELETED() AND Alloy = cAlloy ;
				 ORDER BY Form INTO array aForms
			* AND ActivePric 
		
			FOR EACH m.cForm IN aForms
				IF !EMPTY(m.cForm)
					this.additem(m.cForm)
				ENDIF
			ENDFOR
		
		ENDIF
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbForm.Init
		
		this.clear
		
		LOCAL aForms,cForm
		DIMENSION aForms[1]
		
		SELECT DISTINCT Form FROM pricetable WHERE !DELETED() AND !EMPTY(alloy);
			 ORDER BY Form INTO array aForms
		* AND ActivePric 
		
		this.additem("(All)")
		
		FOR EACH m.cForm IN aForms
			IF !EMPTY(m.cForm)
				this.additem(m.cForm)
			ENDIF
		ENDFOR
		
		This.Value = "(All)"
	ENDPROC

	PROCEDURE frmAdjustPrice.cmbForm.InteractiveChange
		PRIVATE cAlloy, cForm, cCC
		cAlloy 	= ThisForm.cmbAlloy.Value
		cForm	= This.Value
		cCC		= ThisForm.cmbCC.Value
		
		SELECT PriceTable
		LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC
		IF NOT FOUND('PriceTable')
		*	WAIT WINDOW 'CC not found' NOWAIT
			*DO NOT wory about CC
			LOCATE FOR Alloy=cAlloy AND Form=cForm 
			IF NOT FOUND('PriceTable')
				WAIT WINDOW 'Form and CC not found' NOWAIT
		
				LOCATE FOR Alloy=cAlloy 
				IF NOT FOUND('PriceTable')
					WAIT WINDOW 'Alloy and Form and CC not found' NOWAIT
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmdAdjustAll.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nMinThck, nMaxThck
		PRIVATE cSQL, cSQLwhere, cSQLfields, nCurRec
		nCurRec = RECNO('PriceTable')
		PRIVATE nAdjPer
		nAdjPer = THIS.PARENT.txtAdjustSQL.VALUE
		
		PRIVATE nSQLEXEC
		
		SELECT PriceTable 
		
		IF TYPE('nAdjPer') != "N"
			MESSAGEBOX("Must enter a number (Percentage) to adjust with",0,"No number")
			RETURN .F.
		ENDIF
		
		IF nAdjPer = 1
			MESSAGEBOX("Percent entered as 1"+CHR(13)+"No Change!",0,"Nothing to do!")
			RETURN .F.
		ENDIF
		
		cAlloy	= THIS.PARENT.cmbAlloy.VALUE
		cForm	= THIS.PARENT.cmbForm.VALUE
		cCC		= THIS.PARENT.cmbCC.VALUE
		cCL		= THIS.PARENT.cmbCL.VALUE
		nMinThck= THIS.PARENT.txtMinThck.VALUE
		nMaxThck= THIS.PARENT.txtMaxThck.VALUE
		
		cSQLwhere = " WHERE Alloy = '" + ALLTRIM(cAlloy) + " '"
		IF cForm != "(All)"
			cSQLwhere = cSQLwhere + " AND Form = '" + ALLTRIM(cForm) + "'"
		ENDIF
		IF cCC != "*"
			cSQLwhere = cSQLwhere + " AND CC = '"+cCC+"'"
			cSQLwhere = cSQLwhere + " AND CL = '"+cCL+"'"
		ENDIF
		IF nMinThck > 0
			cSQLwhere = cSQLwhere + " AND (Size) >= " + STR(nMinThck,9,4) + ""
		ENDIF
		IF nMaxThck < 99999
			cSQLwhere = cSQLwhere + " AND (Size) <= " + STR(nMaxThck,9,4) + ""
		ENDIF
		
		IF EMPTY(cSQLwhere)
		   MESSAGEBOX("Define Which Records to Adjust",0,"Where clause is Empty!")
		   RETURN
		ENDIF
		
		cSQLfields = "Alloy,Form,CC,Size,Size2,Size3"
		IF THIS.PARENT.chkW0.VALUE = 1
			cSQLfields = cSQLfields + ",W0,W0*" + STR(nAdjPer,6,4) + " AS NW0"
		ELSE
			cSQLfields = cSQLfields + ",W0,0 AS NW0"
		ENDIF
		IF THIS.PARENT.chkW5.VALUE = 1
			cSQLfields = cSQLfields + ",W5,W5*" + STR(nAdjPer,6,4) + " AS NW5"
		ELSE
			cSQLfields = cSQLfields + ",W5,0 AS NW5"
		ENDIF
		IF THIS.PARENT.chkW10.VALUE = 1
			cSQLfields = cSQLfields + ",W10,W10*" + STR(nAdjPer,6,4) + " AS NW10"
		ELSE
			cSQLfields = cSQLfields + ",W10,0 AS NW10"
		ENDIF
		IF THIS.PARENT.chkW25.VALUE = 1
			cSQLfields = cSQLfields + ",W25,W25*" + STR(nAdjPer,6,4) + " AS NW25"
		ELSE
			cSQLfields = cSQLfields + ",W25,0 AS NW25"
		ENDIF
		IF THIS.PARENT.chkW50.VALUE = 1
			cSQLfields = cSQLfields + ",W50,W50*" + STR(nAdjPer,6,4) + " AS NW50"
		ELSE
			cSQLfields = cSQLfields + ",W50,0 AS NW50"
		ENDIF
		IF THIS.PARENT.chkW100.VALUE = 1
			cSQLfields = cSQLfields + ",W100,W100*" + STR(nAdjPer,6,4) + " AS NW100"
		ELSE
			cSQLfields = cSQLfields + ",W100,0 AS NW100"
		ENDIF
		IF THIS.PARENT.chkW200.VALUE = 1
			cSQLfields = cSQLfields + ",W200,W200*" + STR(nAdjPer,6,4) + " AS NW200"
		ELSE
			cSQLfields = cSQLfields + ",W200,0 AS NW200"
		ENDIF
		IF THIS.PARENT.chkW500.VALUE = 1
			cSQLfields = cSQLfields + ",W500,W500*" + STR(nAdjPer,6,4) + " AS NW500"
		ELSE
			cSQLfields = cSQLfields + ",W500,0 AS NW500"
		ENDIF
		IF THIS.PARENT.chkW1000.VALUE = 1
			cSQLfields = cSQLfields + ",W1000,W1000*" + STR(nAdjPer,6,4) + " AS NW1000"
		ELSE
			cSQLfields = cSQLfields + ",W1000,0 AS NW1000"
		ENDIF
		IF THIS.PARENT.chkW2000.VALUE = 1
			cSQLfields = cSQLfields + ",W2000,W2000*" + STR(nAdjPer,6,4) + " AS NW2000"
		ELSE
			cSQLfields = cSQLfields + ",W2000,0 AS NW2000"
		ENDIF
		IF THIS.PARENT.chkWBase.VALUE = 1
			cSQLfields = cSQLfields + ",WBase,WBase*" + STR(nAdjPer,6,4) + " AS NWBase"
		ELSE
			cSQLfields = cSQLfields + ",WBase,0 AS NWBase"
		ENDIF
		
		cSQLfields = cSQLfields + ",SPACE(100) AS LowBracket"
		
		
		IF THIS.PARENT.chkW0.VALUE +;
		   THIS.PARENT.chkW5.VALUE +;
		   THIS.PARENT.chkW10.VALUE +;
		   THIS.PARENT.chkW25.VALUE +;
		   THIS.PARENT.chkW50.VALUE +;
		   THIS.PARENT.chkW100.VALUE +;
		   THIS.PARENT.chkW200.VALUE +;
		   THIS.PARENT.chkW500.VALUE +;
		   THIS.PARENT.chkW1000.VALUE +;
		   THIS.PARENT.chkW2000.VALUE +;
		   THIS.PARENT.chkWBase.VALUE = 0
		   
		   MESSAGEBOX("Check your Weight Brackets",0,"No Weight Bracket marked")
		   RETURN
		ENDIF
		  	
		
		
		SELECT 0
		SELECT &cSQLfields FROM pricetable ;
			&cSQLwhere ;
			INTO CURSOR TempAdjPriceTable READWRITE NOFILTER
		
		SELECT TempAdjPriceTable
		*BROWSE TITLE (cSQLwhere)
		*PRINT the Original numbers
		IF FILE('Reports\PriceTableAdj.FRX')
			REPORT FORM Reports\PriceTableAdj PREVIEW
			*&cSQLwhere
			SET PRINTER TO DEFAULT
		*	WAIT WINDOW 'PRINTED' NOWAIT
		ENDIF
		
		***************************
		
		SELECT TempAdjPriceTable
		GO TOP
		
		*Found Reverse OR Low PriceBreak
		PRIVATE lReverse
		lReverse = .F.
		SCAN
		*	? RECNO('TempAdjPriceTable')
			DO CASE 
			CASE W0 <=W5 
				REPLACE LowBracket WITH 'Low W5 '
				lReverse = .T.
			CASE W5 <=W10 
				REPLACE LowBracket WITH 'Low W10 '
				lReverse = .T.
			CASE W10 <=W25
				REPLACE LowBracket WITH 'Low W25 '
				lReverse = .T.
			CASE W25 <=W50 
				REPLACE LowBracket WITH 'Low W50 '
				lReverse = .T.
			CASE W50 <=W100
				REPLACE LowBracket WITH 'Low W100 '
				lReverse = .T.
			CASE W100 <=W500 
				REPLACE LowBracket WITH 'Low W500 '
				lReverse = .T.
			CASE W500 <=W1000
				REPLACE LowBracket WITH 'Low W1000 '
				lReverse = .T.
			CASE W1000 <=W2000
				REPLACE LowBracket WITH 'Low W2000 '
				lReverse = .T.
			CASE W2000 <=wBase
				REPLACE LowBracket WITH 'Low Base'
				lReverse = .T.
			OTHERWISE 
				REPLACE LowBracket WITH 'Good row' 
			ENDCASE
			LOOP
		ENDSCAN
		
		IF lReverse
			MESSAGEBOX("The new Pricing has issues were a next PriceBreak is a higher Cost.",48,"Data needs fixed.")
		ENDIF
		***************************
		
		PRIVATE cSQLSet
		cSQLSet = ''
		
		IF MESSAGEBOX("Are these the records you want to UPDATE?",4,"Make Changes")=6
		
			IF THIS.PARENT.chkW0.VALUE = 1
				*start with W0
				IF EMPTY(cSQLSet)
					cSQLSet = " SET W0 = CAST(W0 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,W0 = CAST(W0 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET W0 = CAST(W0 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
		
			ENDIF
		
			IF THIS.PARENT.chkW5.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET W5 = CAST(W5 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,W5 = CAST(W5 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET W5 = CAST(W5 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF THIS.PARENT.chkW10.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET W10 = CAST(W10 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,W10 = CAST(W10 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET W10 = CAST(W10 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF THIS.PARENT.chkW25.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET W25 = CAST(W25 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,W25 = CAST(W25 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET W25 = CAST(W25 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF THIS.PARENT.chkW50.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET W50 = CAST(W50 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,W50 = CAST(W50 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET W50 = CAST(W50 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF THIS.PARENT.chkW100.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET W100 = CAST(W100 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,W100 = CAST(W100 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
				cSQL = "UPDATE dbo.PriceTable SET W100 = CAST(W100 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF THIS.PARENT.chkW200.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET  W200 = CAST(W200 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " , W200 = CAST(W200 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET W200 = CAST(W200 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF THIS.PARENT.chkW500.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET W500 = CAST(W500 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,W500 = CAST(W500 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET W500 = CAST(W500 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF THIS.PARENT.chkW1000.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET W1000 = CAST(W1000 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,W1000 = CAST(W1000 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET W1000 = CAST(W1000 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF THIS.PARENT.chkW2000.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET W2000 = CAST(W2000 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,W2000 = CAST(W2000 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET W2000 = CAST(W2000 * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF THIS.PARENT.chkWBase.VALUE = 1
				IF EMPTY(cSQLSet)
					cSQLSet = " SET WBase = CAST(WBase * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ELSE
					cSQLSet = cSQLSet + " ,WBase = CAST(WBase * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "
				ENDIF
		
				cSQL = "UPDATE dbo.PriceTable SET WBase = CAST(WBase * "+STR(nAdjPer,5,4)+" AS NUMERIC(7,2)) "+ cSQLwhere
				ThisFormSet.SaveUpdateChange(cSQL)
			ENDIF
		
			IF NOT EMPTY(cSQLSet)
				cSQL = "UPDATE dbo.PriceTable "+cSQLSet+" "+cSQLwhere
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'')
				ENDIF
				
			ENDIF
		
		
		
			SELECT TempAdjPriceTable 
			*PRINT the Updates numbers
			IF FILE('Reports\PriceTableAdj.FRX')
				REPORT FORM Reports\PriceTableAdj NOCONSOLE TO PRINTER PROMPT 
				*&cSQLwhere
				SET PRINTER TO DEFAULT
				WAIT WINDOW 'Printed updated numbers' NOWAIT
			ENDIF
			
			IF USED('TempAdjPriceTable')
				USE IN TempAdjPriceTable
			ENDIF
		
			SELECT Pricetable 
			*REFRESH()
			ThisFormset.PricetableReLoad(nCurRec)
			*ThisFormset.PriceTableReLoad( RECNO("PriceTable") )
		ENDIF
		
		
		
		***************************************
		
		ThisFormSet.frmFormula.A0.REFRESH
		ThisFormSet.frmFormula.A5.REFRESH
		ThisFormSet.frmFormula.A10.REFRESH
		ThisFormSet.frmFormula.A25.REFRESH
		ThisFormSet.frmFormula.A50.REFRESH
		ThisFormSet.frmFormula.A100.REFRESH
		ThisFormSet.frmFormula.A200.REFRESH
		ThisFormSet.frmFormula.A500.REFRESH
		ThisFormSet.frmFormula.A1000.REFRESH
		ThisFormSet.frmFormula.A2000.REFRESH
		ThisFormSet.frmFormula.ABase.REFRESH
		
		*!*	ThisFormSet.PricetableReLoad(1) CALL: frmHPApricing_Refresh() 
		*!*	ThisFormSet.frmHPApricing.W0.REFRESH
		*!*	ThisFormSet.frmHPApricing.W5.REFRESH
		*!*	ThisFormSet.frmHPApricing.W10.REFRESH
		*!*	ThisFormSet.frmHPApricing.W25.REFRESH
		*!*	ThisFormSet.frmHPApricing.W50.REFRESH
		*!*	ThisFormSet.frmHPApricing.W100.REFRESH
		*!*	ThisFormSet.frmHPApricing.W200.REFRESH
		*!*	ThisFormSet.frmHPApricing.W500.REFRESH
		*!*	ThisFormSet.frmHPApricing.W1000.REFRESH
		*!*	ThisFormSet.frmHPApricing.W2000.REFRESH
		*!*	ThisFormSet.frmHPApricing.WBase.REFRESH
		
		
		
		
	ENDPROC

	PROCEDURE frmAdjustPrice.cmdSelectAllWeights.Click
		THIS.PARENT.chkW0.VALUE = 1
		THIS.PARENT.chkW5.VALUE = 1
		THIS.PARENT.chkW10.VALUE = 1
		THIS.PARENT.chkW25.VALUE = 1
		THIS.PARENT.chkW50.VALUE = 1
		THIS.PARENT.chkW100.VALUE = 1
		THIS.PARENT.chkW200.VALUE = 1
		THIS.PARENT.chkW500.VALUE = 1
		THIS.PARENT.chkW1000.VALUE = 1
