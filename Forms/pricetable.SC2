	PROCEDURE frmHPApricing.LBLBAR_LBS_IN1.Click
		
		PRIVATE cAlloy, cForm, cStdSize
		PRIVATE nSize2, nSize3, nPounds, nPoundsInCut, cMessage
		PRIVATE cPounds
		cAlloy = ALLTRIM(THIS.PARENT.ALLOY1.VALUE)
		cForm = ALLTRIM(THIS.PARENT.Form1.VALUE)
		cStdSize = ALLTRIM(THIS.PARENT.Thk1.VALUE)
		
		IF cForm = '20'
			cForm = '10'
		ENDIF
		nSize2 = 100
		nSize3 = 1
		nPounds = 0
		nPoundsInCut = 0
		cMessage = ''
		PRIVATE sql_sp
		sql_sp = "{CALL  p_Weight ("
		sql_sp = sql_sp + ""+ "1" + ","
		sql_sp = sql_sp + "'"+ cAlloy+ "',"
		sql_sp = sql_sp + "'"+ cForm+ "',"
		sql_sp = sql_sp + ""+ cStdSize + ","
		*LEFT(STR(nStdSize,9,4),8)+ "," && 3 decimals, not 4
		sql_sp = sql_sp + ""+ STR(nSize2,9,3)+ ","
		sql_sp = sql_sp + ""+ STR(nSize3,9,3)+ ","
		sql_sp = sql_sp + "?@nPounds,"
		sql_sp = sql_sp + "?@nPoundsInCut,"
		sql_sp = sql_sp + "?@cMessage "
		sql_sp = sql_sp + ")}"
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, sql_sp )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'')
		ENDIF
		
		nPounds = nPounds / 100
		cPounds = ALLTRIM(STR(nPounds,28,15))
		IF ISNULL(This.Parent.BAR_LBS_IN1.Value)
			This.Parent.BAR_LBS_IN1.Value = ""
		ENDIF
		
		vBAR_LBS_IN1 = This.Parent.BAR_LBS_IN1.Value
		IF TYPE("vBAR_LBS_IN1") = "N"
			cBAR_LBS_IN1 = ALLTRIM(STR(vBAR_LBS_IN1,28,15))
		ELSE
			cBAR_LBS_IN1 = ALLTRIM(vBAR_LBS_IN1)
		ENDIF
		
		IF VAL(cBAR_LBS_IN1) = 0
			This.Parent.BAR_LBS_IN1.Value = cPounds
			This.Parent.BAR_LBS_IN1.Refresh
		ELSE
			IF MESSAGEBOX( ALLTRIM(cMessage)+CHR(13)+CHR(13)+"Are you sure you want to replace:"+CHR(13)+cBAR_LBS_IN1+" with "+CHR(13)+cPounds,4+32,"" ) = 6
				This.Parent.BAR_LBS_IN1.Value = cPounds
				This.Parent.BAR_LBS_IN1.Refresh
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmHPApricing.mcdPriceQuote.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nSize, nSize2, nSize3
		cAlloy	= PrepareSQLtxt(pricetable.alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(pricetable.Form,'Form',2)
		cCC		= PrepareSQLtxt(priceTable.CC,'CC',1)
		cCL		= PrepareSQLtxt(priceTable.CL,'CL',1)
		nSize	= PrepareSQLnum(pricetable.Size,'Size',9,4)
		nSize2	= PrepareSQLnum(pricetable.Size2,'Size2',8,3)
		nSize3	= PrepareSQLnum(pricetable.Size3,'Size3',8,3)
		
		PRIVATE cSQL
		cSQL = "SELECT * FROM ("
		cSQL = cSQL +" SELECT Alloy, Form, CC, CL, [Thck], 'Q' AS [T], P_Lb"
		cSQL = cSQL +" , dbo.WeightBracket( [Weight] ) AS WB "
		IF nSize2 > 0
			cSQL = cSQL +",Sz2"
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +",Sz3"
		ENDIF
		cSQL = cSQL +" FROM dbo.AllQuotes "
		cSQL = cSQL +" WHERE "
		cSQL = cSQL +" Alloy='"+cAlloy+"'"
		cSQL = cSQL +" AND Form='"+cForm+"'"
		cSQL = cSQL +" AND CC='"+cCC+"'"
		cSQL = cSQL +" AND CL='"+cCL+"'"
		IF nSize2 > 0
			cSQL = cSQL +" AND Thck="+STR(nSize,9,4)
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +" AND Sz2="+STR(nSize2,8,3)
		ENDIF
		cSQL = cSQL +" AND p_lb > 0"
		cSQL = cSQL +" AND InqDate >= GetDate()-120 "
		cSQL = cSQL +" ) as Source "
		cSQL = cSQL +" PIVOT "
		cSQL = cSQL +" ("
		cSQL = cSQL +" AVG(P_LB) FOR WB IN ( [0],[5],[10],[25],[50],[100],[200],[500],[1000],[2000],[BASE] ) "
		cSQL = cSQL +" ) AS PivotT "
		*cSQL = cSQL +" ORDER by Thck"
		IF nSize2 > 0
			cSQL = cSQL +",Sz2"
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +",Sz3"
		ENDIF
		
		
		***
		cSQL = cSQL +" UNION "
		cSQL = cSQL +"SELECT Alloy, Form, CC, CL, [Size] AS [Thck],'P' AS [T]"
		cSQL = cSQL +",W0 AS [0], W5 AS [5], W10 AS [10], W25 AS [25], W50 AS [50], W100 AS [100], W200 AS [200], W500 AS [500], W1000 AS [1000], W2000 AS [2000], WBase AS [Base] "
		*cSQL = cSQL +" ,W0, W5, W10, W25, W50, W100, W200, W500, W1000, W2000, WBase "
		*cSQL = cSQL +",W0/WBase AS X0, W5/WBase AS X5, W10/WBase AS X10, W25/WBase AS X25, W50/WBase AS X50, W100/wBASE AS X100, W200/WBase AS X200, W500/WBase AS X500, W1000/WBase AS X1000, W2000/WBase AS x2000 "
		cSQL = cSQL +" FROM dbo.PriceTable "
		cSQL = cSQL +" WHERE "
		cSQL = cSQL +" Alloy='"+cAlloy+"'"
		cSQL = cSQL +" AND Form='"+cForm+"'"
		cSQL = cSQL +" AND CC='"+cCC+"'"
		cSQL = cSQL +" AND CL='"+cCL+"'"
		IF nSize2 > 0
			cSQL = cSQL +" AND Size="+STR(nSize,9,4)
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +" AND Size2="+STR(nSize2,8,3)
		ENDIF
		
		cSQL = cSQL +" ORDER by Thck"
		
		***
		
		
		IF USED("PriceQuoteSheet")
			USE IN PriceQuoteSheet
		ENDIF
		SELECT 0
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PriceQuoteSheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PriceQuoteSheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceQuoteSheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceQuoteSheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'PriceQuoteSheet')
		ENDIF
		
		IF USED('PriceQuoteSheet')
			IF RECCOUNT('PriceQuoteSheet') < 15
			*	Get more data!	
				WAIT WINDOW "Getting 365 days of Data!" NOWAIT
				
				cSQL = "SELECT * FROM ("
				cSQL = cSQL +" SELECT Alloy, Form, CC, CL, [Thck], 'Q' AS [T], P_Lb"
				cSQL = cSQL +" , dbo.WeightBracket( [Weight] ) AS WB "
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				cSQL = cSQL +" FROM dbo.AllQuotes "
				cSQL = cSQL +" WHERE "
				cSQL = cSQL +" Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				IF nSize2 > 0
					cSQL = cSQL +" AND Thck="+STR(nSize,9,4)
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +" AND Sz2="+STR(nSize2,8,3)
				ENDIF
				cSQL = cSQL +" AND P_Lb > 0"
				cSQL = cSQL +" AND InqDate >= GetDate()-365 "
				cSQL = cSQL +" ) as Source "
				cSQL = cSQL +" PIVOT "
				cSQL = cSQL +" ("
				cSQL = cSQL +" AVG(P_LB) FOR WB IN ( [0],[5],[10],[25],[50],[100],[200],[500],[1000],[2000],[BASE] ) "
				cSQL = cSQL +" ) AS PivotT "
				cSQL = cSQL +" ORDER by Thck"
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				IF USED("PriceQuoteSheet")
					USE IN PriceQuoteSheet
				ENDIF
				SELECT 0
		
		
				***
				cSQL = cSQL +" UNION "
				cSQL = cSQL +"SELECT Alloy, Form, CC, CL, [Size] AS [Thck],'P' AS [T]"
				cSQL = cSQL +",W0 AS [0], W5 AS [5], W10 AS [10], W25 AS [25], W50 AS [50], W100 AS [100], W200 AS [200], W500 AS [500], W1000 AS [1000], W2000 AS [2000], WBase AS [Base] "
				*cSQL = cSQL +" ,W0, W5, W10, W25, W50, W100, W200, W500, W1000, W2000, WBase "
				*cSQL = cSQL +",W0/WBase AS X0, W5/WBase AS X5, W10/WBase AS X10, W25/WBase AS X25, W50/WBase AS X50, W100/wBASE AS X100, W200/WBase AS X200, W500/WBase AS X500, W1000/WBase AS X1000, W2000/WBase AS x2000 "
				cSQL = cSQL +" FROM dbo.PriceTable "
				cSQL = cSQL +" WHERE "
				cSQL = cSQL +" Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				IF nSize2 > 0
					cSQL = cSQL +" AND Size="+STR(nSize,9,4)
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +" AND Size2="+STR(nSize2,8,3)
				ENDIF
		
				cSQL = cSQL +" ORDER by Thck"
		
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PriceQuoteSheet')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PriceQuoteSheet')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceQuoteSheet")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceQuoteSheet")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'PriceQuoteSheet')
				ENDIF
		
			ENDIF
		ENDIF
		PRIVATE nSetDecimal
		nSetDecimal =  SET("Decimals")
		SET DECIMALS TO 4
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PriceQuoteSheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PriceQuoteSheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceQuoteSheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceQuoteSheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'PriceQuoteSheet')
		ENDIF
		
		IF USED('PriceQuoteSheet')
			IF RECCOUNT('PriceQuoteSheet') > 0
				
			
				IF FILE('Reports\PriceQuoteSheet.FRX')
		*			IF nSize3 > 0
		*				REPORT FORM Reports\PriceQuoteSheet3 PREVIEW
		*			ELSE
		*				IF nSize2 > 0
		*					REPORT FORM Reports\PriceQuoteSheet2 PREVIEW
		*				ELSE
							REPORT FORM Reports\PriceQuoteSheet PREVIEW
		*				ENDIF
		*			ENDIF	
				ELSE
					WAIT WINDOW 'Report form not found' NOWAIT
				ENDIF
				
				USE IN PriceQuoteSheet
			ELSE
				MESSAGEBOX("No records where found!",48,"Not found!")
			ENDIF
		ELSE
			MESSAGEBOX("No records where found!",48,"Not found!")
		ENDIF
		
		IF nSetDecimal > 0
			SET DECIMALS TO (nSetDecimal)
		ENDIF
		
	ENDPROC

