			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		This.Parent.cmbCL.ColumnCount = 2
		This.Parent.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		This.Parent.cmbCL.BoundColumn = 1
		This.Parent.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
	ENDPROC

	PROCEDURE frmHPApricing.cmbForm.Init
		LOCAL aForms,cForm
		DIMENSION aForms[1]
		
		SELECT DISTINCT Form FROM pricetable WHERE !DELETED() AND !EMPTY(alloy);
			 ORDER BY Form INTO array aForms
		* AND ActivePric 
		
		FOR EACH m.cForm IN aForms
			IF !EMPTY(m.cForm)
				this.additem(m.cForm)
			ENDIF
		ENDFOR
		
		
	ENDPROC

	PROCEDURE frmHPApricing.cmbForm.InteractiveChange
		PRIVATE cAlloy, cForm, cCC
		cAlloy 	= ThisForm.cmbAlloy.Value
		cForm	= This.Value
		cCC		= ThisForm.cmbCC.Value
		
		SELECT PriceTable
		LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC
		IF NOT FOUND('PriceTable')
		*	WAIT WINDOW 'CC not found' NOWAIT
			*DO NOT wory about CC
			LOCATE FOR Alloy=cAlloy AND Form=cForm 
			IF NOT FOUND('PriceTable')
				WAIT WINDOW 'Form and CC not found' NOWAIT
		
				LOCATE FOR Alloy=cAlloy 
				IF NOT FOUND('PriceTable')
					WAIT WINDOW 'Alloy and Form and CC not found' NOWAIT
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdAdd.Click
		ThisForm.lblCloneThk.Visible = .F.
		ThisForm.lblCloneSz1.Visible = .F.
		ThisForm.lblCloneSz2.Visible = .F.
		ThisForm.lblCloneSz3.Visible = .F.
		ThisForm.cmdClone.Visible = .F.
		
		ThisFormset.PriceTableInsert()
		
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdClone.Click
		ThisFormset.Update_pricetable('CLONE')
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdCurrentStockSummary.Click
		PRIVATE cHTTP, cAlloy, cForm, cCC, cCL, cThck
		cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.Form1.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.CC1.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.CL1.Value,'CL',1)
		cThck	= STR( PrepareSQLnum(ThisForm.Thk1.Value,'Thck',7,4) ,7,4)
		
		cHTTP = get_Report_Server()+"%2fInventory%2fStockLst+Summary+by+Alloy+Form"
		cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = cHTTP 
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		WAIT WINDOW "Look for a blinking Internet Explorer to accept the file!" NOWAIT
	ENDPROC

	PROCEDURE frmHPApricing.cmdDelete.Click
		PRIVATE nSQLEXEC, cSQL, nID
		ThisFormSet.nAddRec = 0
		
		IF NOT ThisFormset.frmHPApricing.cmdClone.Visible
			*Clone mode
			MESSAGEBOX("Aborting Clone",48,"Not saved.")
		
			PRIVATE cAlloy, cForm, cCC, cCL, cThk, nSize, nSize2, nSize3
			cAlloy	= PrepareSQLtxt(pricetable.alloy,'Alloy',12)
			cForm	= PrepareSQLtxt(pricetable.Form,'Form',2)
			cCC		= PrepareSQLtxt(priceTable.CC,'CC',1)
			cCL		= PrepareSQLtxt(priceTable.CL,'CL',1)
			cThk	= PrepareSQLtxt(pricetable.Thk,'Thk',5)
		*	nSize	= PrepareSQLnum(pricetable.Size,'Size',9,7)
			nSize	= 9999.9999
			nSize2	= PrepareSQLnum(pricetable.Size2,'Size2',8,3)
			nSize3	= PrepareSQLnum(pricetable.Size3,'Size3',8,3)
		
		
			cSQL = "DELETE * FROM dbo.PriceTable WHERE "
			cSQL = cSQL +" Alloy='"+cAlloy+"'"
			cSQL = cSQL +" AND Form='"+cForm+"'"
			cSQL = cSQL +" AND CC='"+cCC+"'"
			cSQL = cSQL +" AND CL='"+cCL+"'"
			cSQL = cSQL +" AND [SIZE]="+STR(nSize,9,4)
			cSQL = cSQL +" AND [SIZE2]="+STR(nSize2,8,3)
			cSQL = cSQL +" AND [SIZE3]="+STR(nSize2,8,3)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'')
			ENDIF
			
		
			ThisFormset.frmHPApricing.cmdClone.Visible = .T.
			ThisFormset.frmHPApricing.cmdAdd.Visible = .T.
			ThisFormset.PriceTableReLoad( RECNO("PriceTable") )
			
		ELSE
			IF MESSAGEBOX("Do you want to delete this record?",36,"Remove work?") = 6
				*DELETE
				
				nID = PriceTable.pt_ID
				IF nID < 1
					MESSAGEBOX("No Control ID",0+16,"Cannot Delete")
					RETURN
				ENDIF
		
				cSQL = "DELETE FROM dbo.PriceTable WHERE pt_ID = "+STR(nID)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'')
				ENDIF	
				
				SELECT PriceTable
				ThisFormSet.PriceTableReLoad( RECNO("PriceTable") )
		
		
			ENDIF
		ENDIF
		
		ThisFormSet.CheckLineal()
	ENDPROC

	PROCEDURE frmHPApricing.cmdEditSur.Click
		DO FORM Forms\SQL_Alloy.scx WITH ALLTRIM(ThisForm.ALLOY1.Value)
	ENDPROC

	PROCEDURE frmHPApricing.cmdExit.Click
		ThisFormSet.nAddRec = 0
		*ThisFormSet.Release
		ThisForm.Visible = .f.
	ENDPROC

	PROCEDURE frmHPApricing.cmdImportXLS.Click
		IF FILE(SYS(5)+SYS(2003)+"\tmpPriceTable.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\tmpPriceTable.dbf")
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"\MEM\tmpPriceTable.dbf")
			DELETE FILE(SYS(5)+SYS(2003)+"\MEM\tmpPriceTable.dbf")
		ENDIF
		
		IF "\MEM" $ SYS(2003)
			CREATE TABLE SYS(5)+SYS(2003)+"\tmpPriceTable" FREE ( Alloy C(20), [Form] C(10), [CC] C(1), [CL] C(1), [Size] N(9,4), [Size2] N(9,3), Size3 N(9,3) ;
			,W0 N(9,2), W5 N(9,2), W10 N(9,2), W25 N(9,2), W50 N(9,2), W100 N(9,2), W200 N(9,2), W500 N(9,2), W1000 N(9,2), W2000 N(9,2), Wbase N(9,2) )
		ELSE
			CREATE TABLE SYS(5)+SYS(2003)+"\MEM\tmpPriceTable" FREE ( Alloy C(20), [Form] C(10), [CC] C(1), [CL] C(1), [Size] N(9,4), [Size2] N(9,3), Size3 N(9,3) ;
			,W0 N(9,2), W5 N(9,2), W10 N(9,2), W25 N(9,2), W50 N(9,2), W100 N(9,2), W200 N(9,2), W500 N(9,2), W1000 N(9,2), W2000 N(9,2), Wbase N(9,2) )
		ENDIF
		
		IF NOT USED('tmpPriceTable')
			RETURN .F.
		ENDIF
		
		*APPEND FROM (cFile) TYPE CSV
		APPEND FROM ? TYPE XLS
		*APPEND FROM ? TYPE XL8
		
		PRIVATE cSQL,nSQLEXEC,nPT_ID
				
		PRIVATE cAlloy, cForm, cCC, cCL, cThk, nSize, nSize2, nSize3
		PRIVATE nW0, nW5, nW10, nW25, nW50, nW100, nW200, nW500, nW1000, nW2000, nWBase
		
		PRIVATE MachineInfo, cLoginUN
		MachineInfo = SYS(0)
		IF MachineInfo = "1"
			cLoginUN = ""
		ELSE
			cLoginUN = RIGHT(MachineInfo,LEN(MachineInfo)-AT("#",MachineInfo) -1 )
		ENDIF
		
		IF USED('tmpPriceTable')
			GO top
		
			IF tmpPriceTable.alloy = "alloy"
				DELETE
			ENDIF
			PACK
			BROWSE
			
			SCAN
				SELECT tmpPriceTable
				IF DELETED()
					SKIP
				ENDIF
				cAlloy	= PrepareSQLtxt(tmpPriceTable.Alloy,'Alloy',12)
				cForm	= PrepareSQLtxt(tmpPriceTable.Form,'Form',2)
				cCC		= PrepareSQLtxt(tmpPriceTable.CC,'CC',1)
				cCL		= PrepareSQLtxt(tmpPriceTable.CL,'CL',1)
				cThk	= Proper_Thk(tmpPriceTable.Size)
				nSize	= PrepareSQLnum(tmpPriceTable.Size,'Size',9,4)
				nSize2	= PrepareSQLnum(tmpPriceTable.Size2,'Size2',8,3)
				nSize3	= PrepareSQLnum(tmpPriceTable.Size3,'Size3',8,3)
		
				nW0		= PrepareSQLnum(tmpPriceTable.W0,'W0',9,6)
				nW5		= PrepareSQLnum(tmpPriceTable.W5,'W5',9,6)
				nW10	= PrepareSQLnum(tmpPriceTable.W10,'W10',9,6)
				nW25	= PrepareSQLnum(tmpPriceTable.W25,'W25',9,6)
				nW50	= PrepareSQLnum(tmpPriceTable.W50,'W50',9,6)
				nW100	= PrepareSQLnum(tmpPriceTable.W100,'W100',9,6)
				nW200	= PrepareSQLnum(tmpPriceTable.W200,'W200',9,6)
				nW500	= PrepareSQLnum(tmpPriceTable.W500,'W500',9,6)
				nW1000	= PrepareSQLnum(tmpPriceTable.W1000,'W1000',9,6)
				nW2000	= PrepareSQLnum(tmpPriceTable.W2000,'W2000',9,6)
				nWBase	= PrepareSQLnum(tmpPriceTable.WBase,'W2000',9,6)
		
				IF nSize = 9999.9999
					MESSAGEBOX("Cannot save as Size 9999.9999",16,"No Save")
					SKIP
				ENDIF
				
				IF USED('tmpGetPT_ID')
					USE IN tmpGetPT_ID
				ENDIF
				
				SELECT 0
				**Check for existing
				cSQL = "SELECT PT_ID FROM dbo.PriceTable WHERE "
				cSQL = cSQL +" Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				cSQL = cSQL +" AND Size="+STR(nSize,9,4)
				cSQL = cSQL +" AND Size2="+STR(nSize2,8,3)
				cSQL = cSQL +" AND Size3="+STR(nSize3,8,3)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpGetPT_ID' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpGetPT_ID' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpGetPT_ID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpGetPT_ID")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'tmpGetPT_ID')
				ENDIF		
				
				nPT_ID = 0
				IF USED('tmpGetPT_ID')
					IF RECCOUNT('tmpGetPT_ID') > 0
						nPT_ID = tmpGetPT_ID.PT_ID
					ENDIF
				ENDIF
				
				IF nPT_ID > 0
					cSQL = "UPDATE dbo.PriceTable SET "
					cSQL = cSQL +" Alloy='"+cAlloy+"'"
					cSQL = cSQL +",Form='"+cForm+"'"
					cSQL = cSQL +",CC='"+cCC+"'"
					cSQL = cSQL +",CL='"+cCL+"'"
					cSQL = cSQL +",Thk='"+cThk+"'"
					cSQL = cSQL +",Size="+STR(nSize,9,4)
					cSQL = cSQL +",Size2="+STR(nSize2,8,3)
					cSQL = cSQL +",Size3="+STR(nSize3,8,3)
		
					cSQL = cSQL +",W0="+STR(nW0,9,6)
					cSQL = cSQL +",W5="+STR(nW5,9,6)
					cSQL = cSQL +",W10="+STR(nW10,9,6)
					cSQL = cSQL +",W25="+STR(nW25,9,6)
					cSQL = cSQL +",W50="+STR(nW50,9,6)
					cSQL = cSQL +",W100="+STR(nW100,9,6)
					cSQL = cSQL +",W200="+STR(nW200,9,6)
					cSQL = cSQL +",W500="+STR(nW500,9,6)
					cSQL = cSQL +",W1000="+STR(nW1000,9,6)
					cSQL = cSQL +",W2000="+STR(nW2000,9,6)
					cSQL = cSQL +",WBase="+STR(nWBase,9,6)
		*			cSQL = cSQL +",UserName='"+cLoginUN+"'"
					cSQL = cSQL +" WHERE PT_ID ="+STR( nPT_ID )
				ELSE
					*INSERT
					cSQL = "INSERT dbo.PriceTable (Alloy,Form,CC,CL,Thk,Size,Size2,Size3 "
					cSQL = cSQL +",W0,W5,W10,W25,W50,W100,W200,W500,W1000,W2000,WBase )"
					cSQL = cSQL +" VALUES ("
					cSQL = cSQL +" '"+cAlloy+"'"
					cSQL = cSQL +",'"+cForm+"'"
					cSQL = cSQL +",'"+cCC+"'"
					cSQL = cSQL +",'"+cCL+"'"
					cSQL = cSQL +",'"+cThk+"'"
					cSQL = cSQL +","+STR(nSize,9,4)
					cSQL = cSQL +","+STR(nSize2,8,3)
					cSQL = cSQL +","+STR(nSize3,8,3)
					cSQL = cSQL +","+STR(nW0,9,6)
					cSQL = cSQL +","+STR(nW5,9,6)
					cSQL = cSQL +","+STR(nW10,9,6)
					cSQL = cSQL +","+STR(nW25,9,6)
					cSQL = cSQL +","+STR(nW50,9,6)
					cSQL = cSQL +","+STR(nW100,9,6)
					cSQL = cSQL +","+STR(nW200,9,6)
					cSQL = cSQL +","+STR(nW500,9,6)
					cSQL = cSQL +","+STR(nW1000,9,6)
					cSQL = cSQL +","+STR(nW2000,9,6)
					cSQL = cSQL +","+STR(nWBase,9,6)
					cSQL = cSQL +")"
					
				ENDIF
			
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'')
				ENDIF
				
				
				SELECT tmpPriceTable
				
			ENDSCAN
		
			USE IN tmpPriceTable
			
			IF nPT_ID > 0
				ThisFormset.PriceTableReLoad(0,nPT_ID)
			ELSE
				**All Inserts
				**get last Insert
				cSQL = "SELECT PT_ID FROM dbo.PriceTable WHERE "
				cSQL = cSQL +" Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				cSQL = cSQL +" AND Size="+STR(nSize,9,4)
				cSQL = cSQL +" AND Size2="+STR(nSize2,8,3)
				cSQL = cSQL +" AND Size3="+STR(nSize3,8,3)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpGetPT_ID' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpGetPT_ID' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpGetPT_ID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpGetPT_ID")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'tmpGetPT_ID')
				ENDIF		
				
				nPT_ID = 0
				IF USED('tmpGetPT_ID')
					IF RECCOUNT('tmpGetPT_ID') > 0
						nPT_ID = tmpGetPT_ID.PT_ID
					ENDIF
				ENDIF
				*Show at the new insert!
				ThisFormset.PriceTableReLoad(0,nPT_ID)
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE frmHPApricing.cmdNext.Click
		SELECT PriceTable 
		IF !EOF()
			SKIP 1 IN PriceTable 
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN PriceTable 
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdPrev.Click
		SELECT PriceTable 
		IF !EOF()
			SKIP -1 IN PriceTable 
		ENDIF
		IF BOF()
			WAIT WINDOW 'Begining of File' NOWAIT
			GO BOTTOM IN PriceTable 
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdPriceQuoteExcel.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nSize, nSize2, nSize3
		cAlloy	= PrepareSQLtxt(pricetable.alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(pricetable.Form,'Form',2)
		cCC		= PrepareSQLtxt(priceTable.CC,'CC',1)
		cCL		= PrepareSQLtxt(priceTable.CL,'CL',1)
		nSize	= PrepareSQLnum(pricetable.Size,'Size',9,4)
		nSize2	= PrepareSQLnum(pricetable.Size2,'Size2',8,3)
		nSize3	= PrepareSQLnum(pricetable.Size3,'Size3',8,3)
		
		PRIVATE cSQL
		cSQL = "SELECT * FROM ("
		cSQL = cSQL +" SELECT Alloy, Form, CC, CL, [Thck], P_Lb"
		cSQL = cSQL +" , dbo.WeightBracket( [Weight] ) AS WB "
		IF nSize2 > 0
			cSQL = cSQL +",Sz2"
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +",Sz3"
		ENDIF
		cSQL = cSQL +" FROM dbo.AllQuotes "
		cSQL = cSQL +" WHERE "
		cSQL = cSQL +" Alloy='"+cAlloy+"'"
		cSQL = cSQL +" AND Form='"+cForm+"'"
		cSQL = cSQL +" AND CC='"+cCC+"'"
		cSQL = cSQL +" AND CL='"+cCL+"'"
		IF nSize2 > 0
			cSQL = cSQL +" AND Thck="+STR(nSize,9,4)
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +" AND Sz2="+STR(nSize2,8,3)
		ENDIF
		cSQL = cSQL +" AND p_lb > 0"
		cSQL = cSQL +" AND InqDate >= GetDate()-120 "
		cSQL = cSQL +" ) as Source "
		cSQL = cSQL +" PIVOT "
		cSQL = cSQL +" ("
		cSQL = cSQL +" AVG(P_LB) FOR WB IN ( [0],[5],[10],[25],[50],[100],[200],[500],[1000],[2000],[BASE] ) "
		cSQL = cSQL +" ) AS PivotT "
		cSQL = cSQL +" ORDER by Thck"
		IF nSize2 > 0
			cSQL = cSQL +",Sz2"
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +",Sz3"
		ENDIF
		
		IF USED("QuoteSheet")
			USE IN QuoteSheet
		ENDIF
		SELECT 0
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'QuoteSheet')
		ENDIF
		
		IF USED('QuoteSheet')
			IF RECCOUNT('QuoteSheet') < 15
			*	Get more data!	
				WAIT WINDOW "Getting 365 days of Data!" NOWAIT
				
				cSQL = "SELECT * FROM ("
				cSQL = cSQL +" SELECT Alloy, Form, CC, CL, [Thck], P_Lb"
				cSQL = cSQL +" , dbo.WeightBracket( [Weight] ) AS WB "
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				cSQL = cSQL +" FROM dbo.AllQuotes "
				cSQL = cSQL +" WHERE "
				cSQL = cSQL +" Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				IF nSize2 > 0
					cSQL = cSQL +" AND Thck="+STR(nSize,9,4)
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +" AND Sz2="+STR(nSize2,8,3)
				ENDIF
				cSQL = cSQL +" AND P_Lb > 0"
				cSQL = cSQL +" AND InqDate >= GetDate()-365 "
				cSQL = cSQL +" ) as Source "
				cSQL = cSQL +" PIVOT "
				cSQL = cSQL +" ("
				cSQL = cSQL +" AVG(P_LB) FOR WB IN ( [0],[5],[10],[25],[50],[100],[200],[500],[1000],[2000],[BASE] ) "
				cSQL = cSQL +" ) AS PivotT "
				cSQL = cSQL +" ORDER by Thck"
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				IF USED("QuoteSheet")
					USE IN QuoteSheet
				ENDIF
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'QuoteSheet')
				ENDIF
		
			ENDIF
		ENDIF
		PRIVATE nSetDecimal
		nSetDecimal =  SET("Decimals")
		SET DECIMALS TO 4
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'QuoteSheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "QuoteSheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'QuoteSheet')
		ENDIF
		
		IF USED('QuoteSheet')
			IF RECCOUNT('QuoteSheet') > 0
				
		*		IF FILE(SYS(5)+SYS(2003) +"\PriceSheet.XLS")
		*		ENDIF
				*EXPORT TO (SYS(5)+SYS(2003)+"\PriceSheet.XLS") TYPE XLS
				IF "\MEM" $ SYS(2003)
					EXPORT TO (SYS(5)+SYS(2003)+"\QuoteSheet.DIF") TYPE DIF
				ELSE
					EXPORT TO (SYS(5)+SYS(2003)+"\MEM\QuoteSheet.DIF") TYPE DIF
				ENDIF
				
				WAIT WINDOW 'Done' NOWAIT
			
				LOCAL loExcel
				loExcel = CREATEOBJECT("Excel.Application")
		*		loExcel.workbooks.open(SYS(5)+SYS(2003)+"\PriceSheet.XLS")
				IF "\MEM" $ SYS(2003)
					loExcel.workbooks.open(SYS(5)+SYS(2003)+"\QuoteSheet.DIF")
				ELSE
					loExcel.workbooks.open(SYS(5)+SYS(2003)+"\MEM\QuoteSheet.DIF")
				ENDIF
				loExcel.visible = .T.
			
		*!*			IF FILE('Reports\QuoteSheet.FRX')
		*!*				IF nSize3 > 0
		*!*					REPORT FORM Reports\QuoteSheet3 PREVIEW
		*!*				ELSE
		*!*					IF nSize2 > 0
		*!*						REPORT FORM Reports\QuoteSheet2 PREVIEW
		*!*					ELSE
		*!*						REPORT FORM Reports\QuoteSheet PREVIEW
		*!*					ENDIF
		*!*				ENDIF	
		*!*			ELSE
		*!*				WAIT WINDOW 'Report form not found' NOWAIT
		*!*			ENDIF
				
				USE IN QuoteSheet
			ELSE
				MESSAGEBOX("No records where found!",48,"Not found!")
			ENDIF
		ELSE
			MESSAGEBOX("No records where found!",48,"Not found!")
		ENDIF
		
		IF nSetDecimal > 0
			SET DECIMALS TO (nSetDecimal)
		ENDIF
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdPriceQuoteStock.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nSize, nSize2, nSize3
		cAlloy	= PrepareSQLtxt(pricetable.alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(pricetable.Form,'Form',2)
		cCC		= PrepareSQLtxt(priceTable.CC,'CC',1)
		cCL		= PrepareSQLtxt(priceTable.CL,'CL',1)
		nSize	= PrepareSQLnum(pricetable.Size,'Size',9,4)
		nSize2	= PrepareSQLnum(pricetable.Size2,'Size2',8,3)
		nSize3	= PrepareSQLnum(pricetable.Size3,'Size3',8,3)
		
		*** Quote
		PRIVATE cSQL
		cSQL = "SELECT * FROM ("
		cSQL = cSQL +" SELECT Alloy, Form, CC, CL, [Thck], 'Q' AS [T], P_Lb"
		cSQL = cSQL +" , dbo.WeightBracket( [Weight] ) AS WB "
		IF nSize2 > 0
			cSQL = cSQL +",Sz2"
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +",Sz3"
		ENDIF
		cSQL = cSQL +" FROM dbo.AllQuotes "
		cSQL = cSQL +" WHERE "
		cSQL = cSQL +" Alloy='"+cAlloy+"'"
		cSQL = cSQL +" AND Form='"+cForm+"'"
		cSQL = cSQL +" AND CC='"+cCC+"'"
		cSQL = cSQL +" AND CL='"+cCL+"'"
		IF nSize2 > 0
			cSQL = cSQL +" AND Thck="+STR(nSize,9,4)
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +" AND Sz2="+STR(nSize2,8,3)
		ENDIF
		cSQL = cSQL +" AND p_lb > 0"
		cSQL = cSQL +" AND InqDate >= GetDate()-120 "
		cSQL = cSQL +" ) as Source "
		cSQL = cSQL +" PIVOT "
		cSQL = cSQL +" ("
		cSQL = cSQL +" AVG(P_LB) FOR WB IN ( [0],[5],[10],[25],[50],[100],[200],[500],[1000],[2000],[BASE] ) "
		cSQL = cSQL +" ) AS PivotT "
		*cSQL = cSQL +" ORDER by Thck"
		IF nSize2 > 0
			cSQL = cSQL +",Sz2"
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +",Sz3"
		ENDIF
		
		*** Stock
		cSQL = cSQL +" UNION "
		cSQL = cSQL +"SELECT * FROM ("
		cSQL = cSQL +" SELECT Alloy, Form, CC, CL, [Size] AS [Thck], 'S' AS [T], 1 AS [P_Lb]"
		cSQL = cSQL +" , dbo.WeightBracket( [LBS] ) AS WB "
		IF nSize2 > 0
			cSQL = cSQL +",Sz2"
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +",Sz3"
		ENDIF
		cSQL = cSQL +" FROM dbo.StockLst_LBS "
		cSQL = cSQL +" WHERE "
		cSQL = cSQL +" Alloy='"+cAlloy+"'"
		cSQL = cSQL +" AND Form='"+cForm+"'"
		cSQL = cSQL +" AND CC='"+cCC+"'"
		cSQL = cSQL +" AND CL='"+cCL+"'"
		
		cSQL = cSQL +" AND LBS > 0"
		cSQL = cSQL +" ) as SourceS "
		cSQL = cSQL +" PIVOT "
		cSQL = cSQL +" ("
		cSQL = cSQL +" AVG(P_LB) FOR WB IN ( [0],[5],[10],[25],[50],[100],[200],[500],[1000],[2000],[BASE] ) "
		cSQL = cSQL +" ) AS PivotS "
		*cSQL = cSQL +" ORDER by Thck"
		IF nSize2 > 0
			cSQL = cSQL +",Sz2"
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +",Sz3"
		ENDIF
		
		*** PriceTable
		cSQL = cSQL +" UNION "
		cSQL = cSQL +"SELECT Alloy, Form, CC, CL, [Size] AS [Thck],'P' AS [T]"
		cSQL = cSQL +",W0 AS [0], W5 AS [5], W10 AS [10], W25 AS [25], W50 AS [50], W100 AS [100], W200 AS [200], W500 AS [500], W1000 AS [1000], W2000 AS [2000], WBase AS [Base] "
		*cSQL = cSQL +" ,W0, W5, W10, W25, W50, W100, W200, W500, W1000, W2000, WBase "
		*cSQL = cSQL +",W0/WBase AS X0, W5/WBase AS X5, W10/WBase AS X10, W25/WBase AS X25, W50/WBase AS X50, W100/wBASE AS X100, W200/WBase AS X200, W500/WBase AS X500, W1000/WBase AS X1000, W2000/WBase AS x2000 "
		cSQL = cSQL +" FROM dbo.PriceTable "
		cSQL = cSQL +" WHERE "
		cSQL = cSQL +" Alloy='"+cAlloy+"'"
		cSQL = cSQL +" AND Form='"+cForm+"'"
		cSQL = cSQL +" AND CC='"+cCC+"'"
		cSQL = cSQL +" AND CL='"+cCL+"'"
		IF nSize2 > 0
			cSQL = cSQL +" AND Size="+STR(nSize,9,4)
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +" AND Size2="+STR(nSize2,8,3)
		ENDIF
		
		cSQL = cSQL +" ORDER by Thck"
		
		***
		
		
		IF USED("PQS_Sheet")
			USE IN PQS_Sheet
		ENDIF
		SELECT 0
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PQS_Sheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PQS_Sheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PQS_Sheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PQS_Sheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'PQS_Sheet')
		ENDIF
		
		IF USED('PQS_Sheet')
			IF RECCOUNT('PQS_Sheet') < 15
			*	Get more data!	
				WAIT WINDOW "Getting 365 days of Data!" NOWAIT
				*** Quotes
				cSQL = "SELECT * FROM ("
				cSQL = cSQL +" SELECT Alloy, Form, CC, CL, [Thck], 'Q' AS [T], P_Lb"
				cSQL = cSQL +" , dbo.WeightBracket( [Weight] ) AS WB "
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				cSQL = cSQL +" FROM dbo.AllQuotes "
				cSQL = cSQL +" WHERE "
				cSQL = cSQL +" Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				IF nSize2 > 0
					cSQL = cSQL +" AND Thck="+STR(nSize,9,4)
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +" AND Sz2="+STR(nSize2,8,3)
				ENDIF
				cSQL = cSQL +" AND P_Lb > 0"
				cSQL = cSQL +" AND InqDate >= GetDate()-365 "
				cSQL = cSQL +" ) as Source "
				cSQL = cSQL +" PIVOT "
				cSQL = cSQL +" ("
				cSQL = cSQL +" AVG(P_LB) FOR WB IN ( [0],[5],[10],[25],[50],[100],[200],[500],[1000],[2000],[BASE] ) "
				cSQL = cSQL +" ) AS PivotT "
				cSQL = cSQL +" ORDER by Thck"
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				IF USED("PQS_Sheet")
					USE IN PQS_Sheet
				ENDIF
				SELECT 0
		
				*** Stock
				cSQL = cSQL +" UNION "
				cSQL = cSQL +"SELECT * FROM ("
				cSQL = cSQL +" SELECT Alloy, Form, CC, CL, [Size] AS [Thck], 'S' AS [T], 1 AS [P_Lb]"
				cSQL = cSQL +" , dbo.WeightBracket( [LBS] ) AS WB "
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				cSQL = cSQL +" FROM dbo.StockLst_LBS "
				cSQL = cSQL +" WHERE "
				cSQL = cSQL +" Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				cSQL = cSQL +" AND LBS > 0"
				cSQL = cSQL +" ) as SourceS "
				cSQL = cSQL +" PIVOT "
				cSQL = cSQL +" ("
				cSQL = cSQL +" AVG(P_LB) FOR WB IN ( [0],[5],[10],[25],[50],[100],[200],[500],[1000],[2000],[BASE] ) "
				cSQL = cSQL +" ) AS PivotS "
				*cSQL = cSQL +" ORDER by Thck"
				IF nSize2 > 0
					cSQL = cSQL +",Sz2"
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +",Sz3"
				ENDIF
				*** PriceTable
				cSQL = cSQL +" UNION "
				cSQL = cSQL +"SELECT Alloy, Form, CC, CL, [Size] AS [Thck],'P' AS [T]"
				cSQL = cSQL +",W0 AS [0], W5 AS [5], W10 AS [10], W25 AS [25], W50 AS [50], W100 AS [100], W200 AS [200], W500 AS [500], W1000 AS [1000], W2000 AS [2000], WBase AS [Base] "
				*cSQL = cSQL +" ,W0, W5, W10, W25, W50, W100, W200, W500, W1000, W2000, WBase "
				*cSQL = cSQL +",W0/WBase AS X0, W5/WBase AS X5, W10/WBase AS X10, W25/WBase AS X25, W50/WBase AS X50, W100/wBASE AS X100, W200/WBase AS X200, W500/WBase AS X500, W1000/WBase AS X1000, W2000/WBase AS x2000 "
				cSQL = cSQL +" FROM dbo.PriceTable "
				cSQL = cSQL +" WHERE "
				cSQL = cSQL +" Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				cSQL = cSQL +" AND CL='"+cCL+"'"
				IF nSize2 > 0
					cSQL = cSQL +" AND Size="+STR(nSize,9,4)
				ENDIF
				IF nSize3 > 0
					cSQL = cSQL +" AND Size2="+STR(nSize2,8,3)
				ENDIF
		
				cSQL = cSQL +" ORDER by Thck"
		
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PQS_Sheet')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PQS_Sheet')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PQS_Sheet")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PQS_Sheet")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'PQS_Sheet')
				ENDIF
		
			ENDIF
		ENDIF
		PRIVATE nSetDecimal
		nSetDecimal =  SET("Decimals")
		SET DECIMALS TO 4
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PQS_Sheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PQS_Sheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PQS_Sheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PQS_Sheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'PQS_Sheet')
		ENDIF
		
		IF USED('PQS_Sheet')
			IF RECCOUNT('PQS_Sheet') > 0
				
			
				IF FILE('Reports\PQS_Sheet.FRX')
		*			IF nSize3 > 0
		*				REPORT FORM Reports\PQS_Sheet3 PREVIEW
		*			ELSE
		*				IF nSize2 > 0
		*					REPORT FORM Reports\PQS_Sheet2 PREVIEW
		*				ELSE
							REPORT FORM Reports\PQS_Sheet PREVIEW
		*				ENDIF
		*			ENDIF	
				ELSE
					WAIT WINDOW 'Report form not found' NOWAIT
				ENDIF
				
				USE IN PQS_Sheet
			ELSE
				MESSAGEBOX("No records where found!",48,"Not found!")
			ENDIF
		ELSE
			MESSAGEBOX("No records where found!",48,"Not found!")
		ENDIF
		
		IF nSetDecimal > 0
			SET DECIMALS TO (nSetDecimal)
		ENDIF
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdPricesQuotedReport.Click
		PRIVATE cHTTP, cAlloy, cForm, cCC, cCL, cThck
		cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.Form1.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.CC1.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.CL1.Value,'CL',1)
		*cThck	= STR( PrepareSQLnum(ThisForm.Thk1.Value,'Thck',7,4) ,7,4)
		
		IF NOT EMPTY(cCL)
			cHTTP = get_Report_Server()+"%2fPrice+table%2fPrices+Quoted+Matrix"
			cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm+"&CC="+cCC
		ELSE
			cHTTP = get_Report_Server()+"%2fPrice+table%2fPrices+Quoted+Matrix+CL"
			cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm+"&CC="+cCC+"&CL="+cCL
		ENDIF
		*http://"+cSQLServer+"/ReportServer/Pages/ReportViewer.aspx?%2fPrice+table%2fPrices+Quoted+Matrix&rs:Command=Render&Alloy=400&Form=40&CC=1
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = cHTTP 
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		WAIT WINDOW "Look for a blinking Internet Explorer to accept the file!" NOWAIT
	ENDPROC

	PROCEDURE frmHPApricing.cmdPriceTableSpecificHistory.Click
		PRIVATE cHTTP, cAlloy, cForm, cCC, cCL, cThck
		cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.Form1.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.CC1.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.CL1.Value,'CL',1)
		cThck	= ALLTRIM(STR( PrepareSQLnum(ThisForm.Size1.Value,'Size',9,4) ,7,4))
		*IF LEFT(cThck,1)="0"
		*	cThck = RIGHT(cThck,LEN(cThck)-1)
		*ENDIF
		
		IF EMPTY(cCL)
			cHTTP = get_Report_Server()+"%2fPrice+table%2fPrice+Table+Specific+History"
			cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm+"&CC="+cCC+"&Thck="+cThck
		ELSE
			cHTTP = get_Report_Server()+"%2fPrice+table%2fPrice+Table+Specific+History+CL"
			cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm+"&CC="+cCC+"&Thck="+cThck+"&CL="+cCL
		ENDIF
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = cHTTP 
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		
		WAIT WINDOW "Look for a blinking Internet Explorer to accept the file!" NOWAIT
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdPrintPriceSheet.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nSize, nSize2, nSize3
		cAlloy	= PrepareSQLtxt(pricetable.alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(pricetable.Form,'Form',2)
		cCC		= PrepareSQLtxt(priceTable.CC,'CC',1)
		cCL		= PrepareSQLtxt(priceTable.CL,'CL',1)
		nSize	= PrepareSQLnum(pricetable.Size,'Size',9,4)
		nSize2	= PrepareSQLnum(pricetable.Size2,'Size2',8,3)
		nSize3	= PrepareSQLnum(pricetable.Size3,'Size3',8,3)
		
		PRIVATE cSQL
		cSQL = "SELECT Alloy, Form, CC, CL, [Size], Size2, Size3"
		cSQL = cSQL +" ,W0, W5, W10, W25, W50, W100, W200, W500, W1000, W2000, WBase "
		cSQL = cSQL +",W0/WBase AS X0, W5/WBase AS X5, W10/WBase AS X10, W25/WBase AS X25, W50/WBase AS X50, W100/wBASE AS X100, W200/WBase AS X200, W500/WBase AS X500, W1000/WBase AS X1000, W2000/WBase AS x2000 "
		cSQL = cSQL +" FROM dbo.PriceTable "
		cSQL = cSQL +" WHERE "
		cSQL = cSQL +" Alloy='"+cAlloy+"'"
		cSQL = cSQL +" AND Form='"+cForm+"'"
		cSQL = cSQL +" AND CC='"+cCC+"'"
		cSQL = cSQL +" AND CL='"+cCL+"'"
		IF nSize2 > 0
			cSQL = cSQL +" AND Size="+STR(nSize,9,4)
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +" AND Size2="+STR(nSize2,8,3)
		ENDIF
		
		IF USED("PriceSheet")
			USE IN PriceSheet
		ENDIF
		SELECT 0
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PriceSheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PriceSheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceSheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceSheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'PriceSheet')
		ENDIF
		
		IF USED('PriceSheet')
			IF RECCOUNT('PriceSheet') > 0
			
				IF FILE('Reports\PriceSheet.FRX')
					REPORT FORM Reports\PriceSheet PREVIEW
				ELSE
					WAIT WINDOW 'Report form not found' NOWAIT
				ENDIF
				
				*USE IN PriceSheet
			ELSE
				MESSAGEBOX("No records where found!",48,"Not found!")
			ENDIF
		ELSE
			MESSAGEBOX("No records where found!",48,"Not found!")
		ENDIF
	ENDPROC

	PROCEDURE frmHPApricing.cmdPrintQuoteSheet.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nSize, nSize2, nSize3
