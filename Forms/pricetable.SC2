		ELSE
			ThisFormset.frmHPApricing.LBLW51.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF ThisFormset.frmHPApricing.W10.Value < ThisFormset.frmHPApricing.W25.Value
			ThisFormset.frmHPApricing.LBLW101.ForeColor = RGB(255,0,0)
		ELSE
			ThisFormset.frmHPApricing.LBLW101.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF ThisFormset.frmHPApricing.W25.Value < ThisFormset.frmHPApricing.W50.Value
			ThisFormset.frmHPApricing.LBLW251.ForeColor = RGB(255,0,0)
		ELSE
			ThisFormset.frmHPApricing.LBLW251.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF ThisFormset.frmHPApricing.W50.Value < ThisFormset.frmHPApricing.W100.Value
			ThisFormset.frmHPApricing.LBLW501.ForeColor = RGB(255,0,0)
		ELSE
			ThisFormset.frmHPApricing.LBLW501.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF ThisFormset.frmHPApricing.W100.Value < ThisFormset.frmHPApricing.W200.Value
			ThisFormset.frmHPApricing.LBLW1001.ForeColor = RGB(255,0,0)
		ELSE
			ThisFormset.frmHPApricing.LBLW1001.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF ThisFormset.frmHPApricing.W200.Value < ThisFormset.frmHPApricing.W500.Value
			ThisFormset.frmHPApricing.LBLW2001.ForeColor = RGB(255,0,0)
		ELSE
			ThisFormset.frmHPApricing.LBLW2001.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF ThisFormset.frmHPApricing.W500.Value < ThisFormset.frmHPApricing.W1000.Value
			ThisFormset.frmHPApricing.LBLW5001.ForeColor = RGB(255,0,0)
		ELSE
			ThisFormset.frmHPApricing.LBLW5001.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF ThisFormset.frmHPApricing.W1000.Value < ThisFormset.frmHPApricing.W2000.Value
			ThisFormset.frmHPApricing.LBLW10001.ForeColor = RGB(255,0,0)
		ELSE
			ThisFormset.frmHPApricing.LBLW10001.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF ThisFormset.frmHPApricing.W2000.Value < ThisFormset.frmHPApricing.Wbase.Value
