	ENDPROC

	PROCEDURE frmConditionCode.cmdEditGrades.Click
		PRIVATE cCaption
		cCaption = THIS.CAPTION
		PRIVATE nSQLEXEC, cSQL
		PRIVATE nA, nB, nD, nE
		
		DO CASE
		CASE cCaption = "Get"
			ThisFormset.RefreshGrades()
		
		CASE cCaption = "Adjust"
			THIS.PARENT.txtA.ENABLED = .T.
			THIS.PARENT.txtA.ReadOnly = .F.
			THIS.PARENT.txtB.ENABLED = .T.
			THIS.PARENT.txtB.ReadOnly = .F.
			THIS.PARENT.txtC.ENABLED = .T.
			THIS.PARENT.txtC.ReadOnly = .F.
			THIS.PARENT.txtD.ENABLED = .T.
			THIS.PARENT.txtD.ReadOnly = .F.
			THIS.PARENT.txtE.ENABLED = .T.
			THIS.PARENT.txtE.ReadOnly = .F.
		
			THIS.PARENT.txtF.ENABLED = .T.
			THIS.PARENT.txtF.ReadOnly = .F.
		*	THIS.PARENT.txtS.ENABLED = .T.
		*	*THIS.PARENT.txtS.ReadOnly = .F.
		*	THIS.PARENT.txtT.ENABLED = .T.
		*	THIS.PARENT.txtT.ReadOnly = .F.
		*	THIS.PARENT.txtU.ENABLED = .T.
		*	THIS.PARENT.txtU.ReadOnly = .F.
		*	THIS.PARENT.txtV.ENABLED = .T.
		*	THIS.PARENT.txtV.ReadOnly = .F.
		*	THIS.PARENT.txtW1.ENABLED = .T.
		*	THIS.PARENT.txtW1.ReadOnly = .F.
		*	THIS.PARENT.txtX.ENABLED = .T.
		*	THIS.PARENT.txtX.ReadOnly = .F.
		*	THIS.PARENT.txtY.ENABLED = .T.
		*	THIS.PARENT.txtY.ReadOnly = .F.
			
			THIS.PARENT.cmdEditGrades.CAPTION = "Save"
		CASE cCaption = "Save"
			*SAVE
			THIS.PARENT.txtA.ENABLED = .F.
			THIS.PARENT.txtA.ReadOnly = .T.
			THIS.PARENT.txtB.ENABLED = .F.
			THIS.PARENT.txtB.ReadOnly = .T.
			THIS.PARENT.txtC.ENABLED = .F.
			THIS.PARENT.txtC.ReadOnly = .T.
			THIS.PARENT.txtD.ENABLED = .F.
			THIS.PARENT.txtD.ReadOnly = .T.
			THIS.PARENT.txtE.ENABLED = .F.
			THIS.PARENT.txtE.ReadOnly = .T.
			
			THIS.PARENT.txtF.ENABLED = .F.
			THIS.PARENT.txtF.ReadOnly = .T.
		*	THIS.PARENT.txtS.ENABLED = .F.
		*	*THIS.PARENT.txtS.ReadOnly = .T.
		*	THIS.PARENT.txtT.ENABLED = .F.
		*	THIS.PARENT.txtT.ReadOnly = .T.
		*	THIS.PARENT.txtU.ENABLED = .F.
		*	THIS.PARENT.txtU.ReadOnly = .T.
		*	THIS.PARENT.txtV.ENABLED = .F.
		*	THIS.PARENT.txtV.ReadOnly = .T.
		*	THIS.PARENT.txtW1.ENABLED = .F.
		*	THIS.PARENT.txtW1.ReadOnly = .T.
		*	THIS.PARENT.txtX.ENABLED = .F.
		*	THIS.PARENT.txtX.ReadOnly = .T.
		*	THIS.PARENT.txtY.ENABLED = .F.
		*	THIS.PARENT.txtY.ReadOnly = .T.
			
			THIS.PARENT.cmdEditGrades.CAPTION = "Adjust"
		
			nA = THIS.PARENT.txtA.VALUE
			nB = THIS.PARENT.txtB.VALUE
			nC = THIS.PARENT.txtC.VALUE
			nD = THIS.PARENT.txtD.VALUE
			nE = THIS.PARENT.txtE.VALUE
		
			nF = THIS.PARENT.txtF.VALUE
			*nS = THIS.PARENT.txtS.VALUE
		*	nT = THIS.PARENT.txtT.VALUE
		*	nU = THIS.PARENT.txtU.VALUE
		*	nV = THIS.PARENT.txtV.VALUE
		*	nW = THIS.PARENT.txtW1.VALUE
		*	nX = THIS.PARENT.txtX.VALUE
		*	nY = THIS.PARENT.txtY.VALUE
		
		
			cSQL = "UPDATE dbo.ConditionCodeAdjust SET"
			cSQL = cSQL + " A = " + STR(nA,18,9)
			cSQL = cSQL + ",B = "+ STR(nB,18,9)
			cSQL = cSQL + ",C = "+ STR(nC,18,9)
			cSQL = cSQL + ",D = "+ STR(nD,18,9)
			cSQL = cSQL + ",E = "+ STR(nE,18,9)
		
			cSQL = cSQL + ",F = "+ STR(nF,18,9)
		*	cSQL = cSQL + ",S = "+ STR(nS,18,9)
		*	cSQL = cSQL + ",T = "+ STR(nT,18,9)
		*	cSQL = cSQL + ",U = "+ STR(nU,18,9)
		*	cSQL = cSQL + ",V = "+ STR(nV,18,9)
		*	cSQL = cSQL + ",W = "+ STR(nW,18,9)
		*	cSQL = cSQL + ",X = "+ STR(nX,18,9)
		*	cSQL = cSQL + ",Y = "+ STR(nY,18,9)
					
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC,'')
				MESSAGEBOX("Did not Save!",0,"Error in SQL")
			ELSE
				MESSAGEBOX("SQL data was Saved!",0,"Grade Adjust")
			ENDIF
		
		ENDCASE
		
	ENDPROC

	PROCEDURE frmConditionCode.Init
		ThisFormset.RefreshGrades()
	ENDPROC

	PROCEDURE frmFormula.cmdAdjustAll.Click
		PRIVATE nAdjPer
		nAdjPer = PrepareSQLnum(ThisForm.txtAdjustPercent.VALUE,'AdjustPercent',-1)
		
		IF MESSAGEBOX("Are you ready to replace"+CHR(13)+"the 'Set Formula' with"+CHR(13)+"the Adjustment ?"+CHR(13)+ALLTRIM(STR(nAdjPer))+"%",4+32,"Adjust formula?") != 6
			RETURN .F.
		ENDIF
		IF TYPE('nAdjPer') = "N"
			IF nAdjPer = 1
				messagebox("Percent entered as 1"+CHR(13)+"No Change!"+CHR(13)+"Nothing to do!")
				RETURN .F.
			ENDIF
			
			PRIVATE nCostCurr, nNewCostCurr
			nCostCurr = PrepareSQLnum(ThisForm.CostCurr.Value,'CostCurr',-5)
			nNewCostCurr = nCostCurr*nAdjPer 
			
			IF nCostCurr >= 0
				SELECT PriceTable
				REPLACE CostCurr WITH nNewCostCurr 
			ENDIF
		
			ThisForm.t0.Value	= (ThisForm.W0.Value * nAdjPer )
			ThisForm.t5.Value	= (ThisForm.W5.Value * nAdjPer )
			ThisForm.t10.Value	= (ThisForm.W10.Value * nAdjPer )
			ThisForm.t25.Value	= (ThisForm.W25.Value * nAdjPer )
			ThisForm.t50.Value	= (ThisForm.W50.Value * nAdjPer )
			ThisForm.t100.Value	= (ThisForm.W100.Value * nAdjPer )
			ThisForm.t200.Value	= (ThisForm.W200.Value * nAdjPer )
			ThisForm.t500.Value	= (ThisForm.W500.Value * nAdjPer )
			ThisForm.t1000.Value	= (ThisForm.W1000.Value * nAdjPer )
			ThisForm.t2000.Value	= (ThisForm.W2000.Value * nAdjPer )
			ThisForm.tBase.Value	= (ThisForm.WBase.Value * nAdjPer )
		
			ThisFormSet.CalcTestPrice()
			
			MESSAGEBOX( "You must click Update HPA pricing to finish!"+CHR(13)+CHR(13)+"Nothing is physically saved until you click 'Update'" +CHR(13)+"and then 'Save Price'.",64,"Adjust Price." )
		ELSE
			MESSAGEBOX("Must enter a number (Precentage) to adjust with")
		ENDIF
		
	ENDPROC

	PROCEDURE frmFormula.cmdCalcFormula.Click
		SELECT pricetable
		REPLACE a0 WITH PrepareSQLnum( ThisFormSet.frmFormula.txta0.Value,'A',9,6 )
		REPLACE a5 WITH PrepareSQLnum( ThisFormSet.frmFormula.txta5.Value,'A',9,6 )
		REPLACE a10 WITH PrepareSQLnum( ThisFormSet.frmFormula.txta10.Value,'A',9,6 )
		REPLACE a25 WITH PrepareSQLnum( ThisFormSet.frmFormula.txta25.Value,'A',9,6 )
		REPLACE a50 WITH PrepareSQLnum( ThisFormSet.frmFormula.txta50.Value,'A',9,6 )
		REPLACE a100 WITH PrepareSQLnum( ThisFormSet.frmFormula.txta100.Value,'A',9,6 )
		REPLACE a200 WITH PrepareSQLnum( ThisFormSet.frmFormula.txta200.Value,'A',9,6 )
		REPLACE a500 WITH PrepareSQLnum( ThisFormSet.frmFormula.txta500.Value,'A',9,6 )
		REPLACE a1000 WITH PrepareSQLnum( ThisFormSet.frmFormula.txta1000.Value,'A',9,6 )
