		*!*	nMess = MESSAGEBOX("Do you want the Computer to smooth the non-linear Pricing Breaks in EVERY record?"+CHR(13)+"Raise price of next bracket to smooth out",4+32,"Data needs fixed.")
		*!*	IF nMess = 6
		
		*!*		*EXEC dbo.p_PriceTable_Linear_Fix
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, 'EXEC dbo.p_PriceTable_Linear_Fix' , '')
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, '')
		*!*		ENDIF				
		*!*						
