		REPLACE aBASE WITH PrepareSQLnum( ThisFormSet.frmFormula.txtaBASE.Value,'A',9,6 )
		
		ThisFormSet.frmFormula.a0.Refresh
		ThisFormSet.frmFormula.a5.Refresh
		ThisFormSet.frmFormula.a10.Refresh
		ThisFormSet.frmFormula.a25.Refresh
		ThisFormSet.frmFormula.a50.Refresh
		ThisFormSet.frmFormula.a100.Refresh
		ThisFormSet.frmFormula.a200.Refresh
		ThisFormSet.frmFormula.a500.Refresh
		ThisFormSet.frmFormula.a1000.Refresh
		ThisFormSet.frmFormula.a2000.Refresh
		ThisFormSet.frmFormula.aBASE.Refresh
		
		ThisFormSet.CalcTestPrice()
	ENDPROC

