	PROCEDURE frmFormula.cmdSaveHistory.Click
		SELECT pricetable
		REPLACE h0 WITH PrepareSQLnum(pricetable.a0,'A',9,6)
		
		PRIVATE nPT_ID 
		nPT_ID = ThisFormSet.frmHPApricing.PT_ID1.Value
		
		PRIVATE nH0, nH5, nH10, nH25, nH50, nH100, nH200, nH500, nH1000, nH2000, nHBase
		
		nH0		= PrepareSQLnum(pricetable.H0,'A',9,6)
		nH5		= PrepareSQLnum(pricetable.H5,'A',9,6)
		nH10	= PrepareSQLnum(pricetable.H10,'A',9,6)
		nH25	= PrepareSQLnum(pricetable.H25,'A',9,6)
		nH50	= PrepareSQLnum(pricetable.H50,'A',9,6)
		nH100	= PrepareSQLnum(pricetable.H100,'A',9,6)
		nH200	= PrepareSQLnum(pricetable.H200,'A',9,6)
		nH500	= PrepareSQLnum(pricetable.H500,'A',9,6)
		nH1000	= PrepareSQLnum(pricetable.H1000,'A',9,6)
		nH2000	= PrepareSQLnum(pricetable.H2000,'A',9,6)
		nHBase	= PrepareSQLnum(pricetable.HBase,'A',9,6)
		
		PRIVATE cSQL
		cSQL = "UPDATE dbo.PriceTable SET "
		cSQL = cSQL +" H0="+STR(nH0,9,6)
		cSQL = cSQL +",H5="+STR(nH5,9,6)
		cSQL = cSQL +",H10="+STR(nH10,9,6)
		cSQL = cSQL +",H25="+STR(nH25,9,6)
		cSQL = cSQL +",H50="+STR(nH50,9,6)
		cSQL = cSQL +",H100="+STR(nH100,9,6)
		cSQL = cSQL +",H200="+STR(nH200,9,6)
		cSQL = cSQL +",H500="+STR(nH500,9,6)
		cSQL = cSQL +",H1000="+STR(nH1000,9,6)
		cSQL = cSQL +",H2000="+STR(nH2000,9,6)
		cSQL = cSQL +",HBase="+STR(nHBase,9,6)
		cSQL = cSQL +" WHERE PT_ID ="+STR( nPT_ID )
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'')
		ENDIF
		
		ThisFormset.PriceTableReLoad(0,nPT_ID)
		*ThisFormSet.RefreshPriceTable()
		
		
		*	ThisFormSet.frmHPApricing.ActivePric1.VALUE = .T.
		ThisFormSet.frmHPApricing.LastEdit1.VALUE = DTOC( DATE() )
		PRIVATE MachineInfo, cLoginUN
		MachineInfo = SYS(0)
		IF MachineInfo = "1"
			cLoginUN = ""
		ELSE
			cLoginUN = RIGHT(MachineInfo,LEN(MachineInfo)-AT("#",MachineInfo) -1 )
		ENDIF
		
		ThisFormSet.frmHPApricing.UserName1.VALUE = cLoginUN
		
	ENDPROC

	PROCEDURE frmFormula.cmdSavePrice.Click
		PRIVATE nPT_ID 
		nPT_ID = ThisFormSet.frmHPApricing.PT_ID1.Value
		PRIVATE nCostCurr
		nCostCurr = PrepareSQLnum(ThisForm.CostCurr.Value,'CostCurr',-5)
		
		PRIVATE nT0, nT5, nT10, nT25, nT50, nT100, nT200, nT500, nT1000, nT2000, nTBase
		nT0		= PrepareSQLnum(ThisForm.T0.Value,'T',9,6)
		nT5		= PrepareSQLnum(ThisForm.T5.Value,'T',9,6)
		nT10	= PrepareSQLnum(ThisForm.T10.Value,'T',9,6)
