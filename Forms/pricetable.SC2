	PROCEDURE frmHPApricing.cmdReportServer.Click
		PRIVATE cHTTP, cAlloy, cForm, cCC, cCL, cThck
		cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.Form1.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.CC1.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.CL1.Value,'CL',1)
		*cThck	= STR( PrepareSQLnum(ThisForm.Thk1.Value,'Thck',7,4) ,7,4)
		
		*IF NOT EMPTY(cCL)
			cHTTP = get_Report_Server()+"%2fPrice+table%2fPrice+Table+Spread+Sheet"
			cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm
		*ELSE
		*	cHTTP = get_Report_Server()+"
		*	cHTTP = cHTTP+"%2fPrice+table%2fPrices+Quoted+Matrix+CL"
		*	cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm+"&CC="+cCC+"&CL="+cCL
		*ENDIF
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = cHTTP 
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		
		WAIT WINDOW "Look for a blinking Internet Explorer to accept the file!" NOWAIT
	ENDPROC

	PROCEDURE frmHPApricing.cmdSave.Click
		PRIVATE nPT_ID 
		nPT_ID = ThisForm.PT_ID1.Value
		
		PRIVATE nW0, nW5, nW10, nW25, nW50, nW100, nW200, nW500, nW1000, nW2000, nWBase
		nW0		= PrepareSQLnum(ThisForm.W0.Value,'W',9,6)
		nW5		= PrepareSQLnum(ThisForm.W5.Value,'W',9,6)
		nW10	= PrepareSQLnum(ThisForm.W10.Value,'W',9,6)
		nW25	= PrepareSQLnum(ThisForm.W25.Value,'W',9,6)
		nW50	= PrepareSQLnum(ThisForm.W50.Value,'W',9,6)
		nW100	= PrepareSQLnum(ThisForm.W100.Value,'W',9,6)
		nW200	= PrepareSQLnum(ThisForm.W200.Value,'W',9,6)
		nW500	= PrepareSQLnum(ThisForm.W500.Value,'W',9,6)
		nW1000	= PrepareSQLnum(ThisForm.W1000.Value,'W',9,6)
		nW2000	= PrepareSQLnum(ThisForm.W2000.Value,'W',9,6)
		nWBase	= PrepareSQLnum(ThisForm.WBase.Value,'W',9,6)
		PRIVATE cAlloy, cForm, cCC, cCL, cThk, cCommSpec, nSize, nSize2, nSize3, nBarLbsIn
		cAlloy	= PrepareSQLtxt(ThisForm.alloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.Form1.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.CC1.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.CL1.Value,'CL',1)
		cThk	= PrepareSQLtxt(ThisForm.Thk1.Value,'Thk',5)
		cCommSpec = PrepareSQLtxt(ThisForm.CommSpec1.Value,'CommSpec',20)
		nSize	= PrepareSQLnum(ThisForm.Size1.Value,'Size',9,4)
		nSize2	= PrepareSQLnum(ThisForm.Size2.Value,'Size2',8,3)
		nSize3	= PrepareSQLnum(ThisForm.Size3.Value,'Size3',8,3)
		nBarLbsIn = PrepareSQLnum(ThisForm.BAR_LBS_IN1.Value,'Bar_Lbs_In',18,16)
		PRIVATE lActivePrice
		lActivePrice = PrepareSQLlogic(Thisform.ACTIVEPRIC1.Value,'ActivePrice',.F.)
		
		IF nSize = 9999.9999
			MESSAGEBOX("Cannot save as Size 9999.9999",16,"No Save")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL
		cSQL = "UPDATE dbo.PriceTable SET "
		cSQL = cSQL +" w0="+STR(nW0,9,6)
		cSQL = cSQL +",W5="+STR(nW5,9,6)
		cSQL = cSQL +",W10="+STR(nW10,9,6)
		cSQL = cSQL +",W25="+STR(nW25,9,6)
		cSQL = cSQL +",W50="+STR(nW50,9,6)
		cSQL = cSQL +",W100="+STR(nW100,9,6)
		cSQL = cSQL +",W200="+STR(nW200,9,6)
		cSQL = cSQL +",W500="+STR(nW500,9,6)
		cSQL = cSQL +",W1000="+STR(nW1000,9,6)
		cSQL = cSQL +",W2000="+STR(nW2000,9,6)
		cSQL = cSQL +",WBase="+STR(nWBase,9,6)
		
		cSQL = cSQL +",Alloy='"+cAlloy+"'"
		cSQL = cSQL +",Form='"+cForm+"'"
		cSQL = cSQL +",CC='"+cCC+"'"
		cSQL = cSQL +",CL='"+cCL+"'"
		cSQL = cSQL +",Thk='"+cThk+"'"
		cSQL = cSQL +",CommSpec ='"+cCommSpec+"'"
		cSQL = cSQL +",Size="+STR(nSize,9,4)
		cSQL = cSQL +",Size2="+STR(nSize2,8,3)
		cSQL = cSQL +",Size3="+STR(nSize3,8,3)
		cSQL = cSQL +",bar_lbs_in ="+STR(nBarLbsIn,18,16)
		
		cSQL = cSQL +",ActivePric ="+IIF(lActivePrice,'1','0')
		cSQL = cSQL +" WHERE PT_ID ="+STR( nPT_ID )
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'')
		ENDIF
		
		ThisFormset.PriceTableReLoad(0,nPT_ID)
		*ThisFormSet.RefreshPriceTable()
		
		ThisFormSet.frmHPApricing.LastEdit1.VALUE = DTOC( DATE() )
		PRIVATE MachineInfo, cLoginUN
		MachineInfo = SYS(0)
		IF MachineInfo = "1"
			cLoginUN = ""
		ELSE
			cLoginUN = RIGHT(MachineInfo,LEN(MachineInfo)-AT("#",MachineInfo) -1 )
		ENDIF
		
		ThisFormSet.frmHPApricing.UserName1.VALUE = cLoginUN
		
		ThisForm.lblCloneThk.Visible = .F.
		ThisForm.lblCloneSz1.Visible = .F.
		ThisForm.lblCloneSz2.Visible = .F.
		ThisForm.lblCloneSz3.Visible = .F.
		ThisForm.cmdClone.Visible = .T.
		ThisForm.cmdAdd.Visible = .T.
		
		**************************
		IF USED('tmpStandSize')
			SELECT tmpStandSize
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT Thck, dbo.f_SizeStandard(Thck) AS StandardSize FROM dbo.StandardSize "
		cSQL = cSQL + "WHERE Thck = dbo.f_SizeStandard("+ALLTRIM(STR(nSize,9,3))+") OR dbo.f_SizeStandard(Thck) = "+ALLTRIM(STR(nSize,9,3))
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStandSize' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpStandSize' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStandSize")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpStandSize")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'tmpStandSize')
		ENDIF
		
		IF USED('tmpStandSize')
			IF RECCOUNT('tmpStandSize') > 0
				IF tmpStandSize.Thck = nSize OR tmpStandSize.StandardSize = nSize
					*Its Good
				ELSE
					MESSAGEBOX("Table dbo.StandardSize "+ALLTRIM(STR(tmpStandSize.Thck,9,3))+CHR(13)+"and dbo.f_SizeStandard "+ALLTRIM(STR(tmpStandSize.StandardSize,9,3))+CHR(13)+"are different from your Size:"+ALLTRIM(STR(nSize,9,3)),48,"You might want need to edit function dbo.f_SizeStandard.")
					TrackError("Table dbo.StandardSize "+ALLTRIM(STR(tmpStandSize.Thck,9,3))+CHR(13)+"and dbo.f_SizeStandard "+ALLTRIM(STR(tmpStandSize.StandardSize,9,3))+CHR(13)+"are different from your Size:"+ALLTRIM(STR(nSize,9,3))+CHR(13)+"You might want need to edit function dbo.f_SizeStandard.","frmHPApricing.cmdSave","PriceTable",LINENO(1) )
					*TrackMess( "Table dbo.StandardSize and dbo.f_SizeStandard do not have the Size:"+ALLTRIM(STR(nSize,9,3)) )
				ENDIF
			ELSE
				MESSAGEBOX("Table dbo.StandardSize and dbo.f_SizeStandard do not have the Size:"+ALLTRIM(STR(nSize,9,3)),48,"You need to Edit.")
				TrackError("Table dbo.StandardSize and dbo.f_SizeStandard do not have the Size:"+ALLTRIM(STR(nSize,9,3)),"frmHPApricing.cmdSave","PriceTable",LINENO(1) )
			ENDIF
			USE IN tmpStandSize
		ENDIF
		
		ThisFormSet.Refresh_HPApricing()
		
	ENDPROC

	PROCEDURE frmHPApricing.cmdSpreadSheet.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nSize, nSize2, nSize3
		cAlloy	= PrepareSQLtxt(pricetable.alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(pricetable.Form,'Form',2)
		cCC		= PrepareSQLtxt(priceTable.CC,'CC',1)
		cCL		= PrepareSQLtxt(priceTable.CL,'CL',1)
		nSize	= PrepareSQLnum(pricetable.Size,'Size',9,4)
		nSize2	= PrepareSQLnum(pricetable.Size2,'Size2',8,3)
		nSize3	= PrepareSQLnum(pricetable.Size3,'Size3',8,3)
		
		PRIVATE cSQL
		cSQL = "SELECT Alloy, Form, CC, CL, [Size], Size2, Size3"
		cSQL = cSQL +" ,W0, W5, W10, W25, W50, W100, W200, W500, W1000, W2000, WBase "
		cSQL = cSQL +",W0/WBase AS X0, W5/WBase AS X5, W10/WBase AS X10, W25/WBase AS X25, W50/WBase AS X50, W100/wBASE AS X100, W200/WBase AS X200, W500/WBase AS X500, W1000/WBase AS X1000, W2000/WBase AS x2000 "
		cSQL = cSQL +" FROM dbo.PriceTable "
		cSQL = cSQL +" WHERE "
		cSQL = cSQL +" Alloy='"+cAlloy+"'"
		cSQL = cSQL +" AND Form='"+cForm+"'"
		cSQL = cSQL +" AND CC='"+cCC+"'"
		cSQL = cSQL +" AND CL='"+cCL+"'"
		
		IF nSize2 > 0
			cSQL = cSQL +" AND Size="+STR(nSize,9,4)
		ENDIF
		IF nSize3 > 0
			cSQL = cSQL +" AND Size2="+STR(nSize2,8,3)
		ENDIF
		
		IF USED("PriceSheet")
			USE IN PriceSheet
		ENDIF
		SELECT 0
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'PriceSheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'PriceSheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceSheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "PriceSheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'PriceSheet')
		ENDIF
		
		IF USED('PriceSheet')
			IF RECCOUNT('PriceSheet') > 0
			
		*		IF FILE(SYS(5)+SYS(2003) +"\PriceSheet.XLS")
		*		ENDIF
				*EXPORT TO (SYS(5)+SYS(2003)+"\PriceSheet.XLS") TYPE XLS
				IF "\MEM" $ SYS(2003)
					EXPORT TO (SYS(5)+SYS(2003)+"\PriceSheet.DIF") TYPE DIF
				ELSE
					EXPORT TO (SYS(5)+SYS(2003)+"\MEM\PriceSheet.DIF") TYPE DIF
				ENDIF
				
				WAIT WINDOW 'Done' NOWAIT
			
				LOCAL loExcel
				loExcel = CREATEOBJECT("Excel.Application")
		*		loExcel.workbooks.open(SYS(5)+SYS(2003)+"\PriceSheet.XLS")
				IF "\MEM" $ SYS(2003)
					loExcel.workbooks.open(SYS(5)+SYS(2003)+"\PriceSheet.DIF")
				ELSE
					loExcel.workbooks.open(SYS(5)+SYS(2003)+"\MEM\PriceSheet.DIF")
				ENDIF
				loExcel.visible = .T.
				
				USE IN PriceSheet
			ELSE
				MESSAGEBOX("No records where found!",48,"Not found!")
			ENDIF
		ELSE
			MESSAGEBOX("No records where found!",48,"Not found!")
		ENDIF
	ENDPROC

	PROCEDURE frmHPApricing.cmdStockSales.Click
		
		PRIVATE m.loHyperlink,m.cHyperLink
		
		PRIVATE cHTTP, cAlloy, cForm, cCC, cCL, cThck
		cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.Form1.Value,'Form',2)
		cCC		= PrepareSQLtxt(ThisForm.CC1.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.CL1.Value,'CL',1)
		
		cThck	= STR( PrepareSQLnum(ThisForm.Thk1.Value,'Thck',7,4) ,7,4)
		
		IF EMPTY(cCL)
			cHTTP = get_Report_Server()+"%2fInventory%2fSales+Detail+-+Pounds+by+month"
			cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm+"&CC="+cCC+"&Thck="+cThck
		ELSE
			**add CL
			cHTTP = get_Report_Server()+"%2fInventory%2fSales+Detail+CL+-+Pounds+by+month"
			cHTTP = cHTTP+"&rs:Command=Render&Alloy="+cAlloy+"&Form="+cForm+"&CC="+cCC+"&CL="+cCL+"&Thck="+cThck
		ENDIF
		
		m.cHyperLink = cHTTP 
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		
		WAIT WINDOW "Look for a blinking Internet Explorer to accept the file!" NOWAIT
		
	ENDPROC

