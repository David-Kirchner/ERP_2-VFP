	PROCEDURE frmFormula.cmdNext.Click
		SELECT PriceTable 
		IF !EOF()
			SKIP 1 IN PriceTable 
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN PriceTable 
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE frmFormula.cmdPrev.Click
		SELECT PriceTable 
		IF !EOF()
			SKIP -1 IN PriceTable 
		ENDIF
		IF BOF()
			WAIT WINDOW 'Begining of File' NOWAIT
			GO BOTTOM IN PriceTable 
		ENDIF
		
		ThisFormSet.RefreshPriceTable()
		
		ThisForm.Refresh
		
	ENDPROC

