	PROCEDURE frmFormula.cmdSaveFormulas.Click
		PRIVATE nPT_ID 
		nPT_ID = ThisFormSet.frmHPApricing.PT_ID1.Value
		
		PRIVATE nA0, nA5, nA10, nA25, nA50, nA100, nA200, nA500, nA1000, nA2000, nABase
		
		nA0		= PrepareSQLnum(pricetable.A0,'A',9,6)
		nA5		= PrepareSQLnum(pricetable.A5,'A',9,6)
		nA10	= PrepareSQLnum(pricetable.A10,'A',9,6)
		nA25	= PrepareSQLnum(pricetable.A25,'A',9,6)
		nA50	= PrepareSQLnum(pricetable.A50,'A',9,6)
		nA100	= PrepareSQLnum(pricetable.A100,'A',9,6)
		nA200	= PrepareSQLnum(pricetable.A200,'A',9,6)
		nA500	= PrepareSQLnum(pricetable.A500,'A',9,6)
		nA1000	= PrepareSQLnum(pricetable.A1000,'A',9,6)
		nA2000	= PrepareSQLnum(pricetable.A2000,'A',9,6)
		nABase	= PrepareSQLnum(pricetable.ABase,'A',9,6)
		
		PRIVATE cSQL
		cSQL = "UPDATE dbo.PriceTable SET "
		cSQL = cSQL +" A0="+STR(nA0,9,6)
		cSQL = cSQL +",A5="+STR(nA5,9,6)
		cSQL = cSQL +",A10="+STR(nA10,9,6)
		cSQL = cSQL +",A25="+STR(nA25,9,6)
		cSQL = cSQL +",A50="+STR(nA50,9,6)
		cSQL = cSQL +",A100="+STR(nA100,9,6)
		cSQL = cSQL +",A200="+STR(nA200,9,6)
		cSQL = cSQL +",A500="+STR(nA500,9,6)
		cSQL = cSQL +",A1000="+STR(nA1000,9,6)
		cSQL = cSQL +",A2000="+STR(nA2000,9,6)
		cSQL = cSQL +",ABase="+STR(nABase,9,6)
		cSQL = cSQL +" WHERE PT_ID ="+STR( nPT_ID )
		
		PRIVATE nSQLEXEC 
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
