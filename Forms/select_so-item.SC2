	PROCEDURE Init
		PARAMETERS pSO
		*DO FORM Forms\Select_SO-item WITH nSO TO cSOitem
		*ThisForm.pWhat = "ChooseSO"
		
		IF VARTYPE(pSO) = "N"
			ThisForm.SalesNum = pSO
			
			SELECT ChooseSales_No
			LOCATE FOR SalesNum = pSO
			ThisForm.RefreshScreen()
			
		ELSE
			ThisForm.SalesNum = 0
		ENDIF
		ThisForm.HoldNumber = 0
		
		ThisForm.txtSalesOrder.Value = ChooseSales_No.SalesNum
		ThisForm.txtSalesOrder.SetFocus
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		ThisForm.nConnHandle = get_SQLstringCONNECT()
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("ChooseSales_No")
			USE IN ChooseSales_No
		ENDIF
		SELECT 0
		
		cSQL="SELECT SN.SalesNum,SN.ItemTot,SN.SalesRep,SN.pShipAddr,SN.pSoldAddr,SN.ShipRoute,SN.ShipPay,SN.PayType "
		cSQL=cSQL+",SN.cncld,SN.cmplt,SN.amendment,SN.CreateDate" 
		
		cSQL=cSQL+" ,CASE WHEN (SELECT SUM(CAST(ISNULL(Hold,0) AS INT)) "
		cSQL=cSQL+" FROM dbo.Sales S WITH(NOLOCK) WHERE S.SalesNum = SN.SalesNum)=0 THEN '' ELSE "
		cSQL=cSQL+" ( SELECT TOP 1 ISNULL(What,'') FROM dbo.Sales_Hold_Status SH WHERE SH.SalesNum = SN.SalesNum )"
		cSQL=cSQL+" END AS WhyHold "
		
		cSQL=cSQL+" FROM dbo.Sales_No SN WITH(NOLOCK) "
		cSQL=cSQL+" ORDER BY SN.SalesNum DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ChooseSales_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ChooseSales_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ChooseSales_No' )
		ENDIF
		
		IF USED('ChooseSales_No')
			SELECT ChooseSales_No
			GO TOP
		*	IF RECCOUNT() > 8
		*		SKIP 8
		*	ENDIF
		ELSE
			MESSAGEBOX("Could not load 'Sales_No'",0,"SQL Error")
			RETURN TO MASTER
		ENDIF
	ENDPROC

	PROCEDURE refreshscreen
		ThisForm.txtSalesNum.Refresh
		ThisForm.txtSalesRep.Refresh
		ThisForm.txtpShipAddr.Refresh
		ThisForm.txtpSoldAddr.Refresh
		ThisForm.txtShipRoute.Refresh
		ThisForm.txtShipPay.Refresh
		ThisForm.txtPayType.Refresh
		ThisForm.txtItemTot.Refresh
		
		ThisForm.chkCncld.Refresh
		ThisForm.chkCmplt.Refresh
		
		ThisForm.txtAmendment.Refresh
		ThisForm.txtCreateDate.Refresh
		
		ThisForm.txtWhyHold.Refresh
		
		
		ThisForm.Refresh_grdSOitems()
		*ThisForm.RefreshScreenItem() called in Refresh_grdSOitems()
	ENDPROC

	PROCEDURE refreshscreenitem
		*PARAMETERS pItem
		
		*ThisForm.RefreshScreenItem()
		PRIVATE nItem
		nItem = tmpSOitems.Item
		
		SELECT tmpSalesDescript
		LOCATE FOR Item = nItem
		
		ThisForm.txtItem.Value		= tmpSalesDescript.Item
		ThisForm.txtAlloy.Value		= tmpSalesDescript.Alloy
		ThisForm.txtHeat.Value		= tmpSalesDescript.Heat
		ThisForm.txtDescript.Value	= tmpSalesDescript.Descript
		
		ThisForm.txtShipped.Value	= tmpSalesDescript.Shipped
		ThisForm.txtWO.Value		= tmpSalesDescript.WO
		ThisForm.txtWO_Detail.Value	= tmpSalesDescript.WO_Detail
		
		ThisForm.txtRMA_No.Value		= tmpSalesDescript.RMA_No
		ThisForm.txtRMA_Detail.Value	= tmpSalesDescript.RMA_Detail
		
		ThisForm.chkCncld.Value	= PrepareSQLchk(tmpSalesDescript.Cncld,'Cncld')
		ThisForm.chkCmplt.Value	= PrepareSQLchk(tmpSalesDescript.Cmplt,'Cmplt')
		
		ThisForm.chkPrcp.Value	= PrepareSQLchk(tmpSalesDescript.Prcp,'Prcp')
		ThisForm.chkPrcd.Value	= PrepareSQLchk(tmpSalesDescript.Prcd,'Prcd')
		ThisForm.chkPckd.Value	= PrepareSQLchk(tmpSalesDescript.Pckd,'Pckd')
		
		ThisForm.chkIntP.Value	= PrepareSQLchk(tmpSalesDescript.IntP,'IntP')
		
		ThisForm.chkShipOn.Value	= PrepareSQLchk(tmpSalesDescript.ShipOn,'ShipOn')
		ThisForm.txtShipDue.Value	= tmpSalesDescript.ShipDue
		
		ThisForm.chkHold.Value = PrepareSQLchk(tmpSalesDescript.Hold,'Hold')
		
	ENDPROC

	PROCEDURE refresh_grdsoitems
		PRIVATE nSalesNum
		nSalesNum = ThisForm.txtSalesNum.Value
		
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpSOitems")
			ThisForm.grdItem.RecordSource = ''
			USE IN tmpSOitems
		ENDIF
		SELECT 0
		
		cSQL="SELECT Item"
		cSQL=cSQL+" FROM dbo.Sales WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SalesNum = "+STR(nSalesNum)
		cSQL=cSQL+" ORDER BY Item "
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitems')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitems')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitems")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitems' )
		ENDIF
		
		IF USED('tmpSOitems')
			IF RECCOUNT('tmpSOitems') > 0
				*tmpSOitems
				ThisForm.grdItem.RecordSource = 'tmpSOitems'
				
				********************************
				IF USED("tmpSalesDescript")
					USE IN tmpSalesDescript
				ENDIF
				SELECT 0
		
				cSQL="SELECT S.Item,S.Heat,S.ShipDue,S.Shipped,S.Cncld,S.Cmplt,S.pHeat "
				cSQL=cSQL+" ,ISNULL(S.Prcp,0) AS Prcp,S.Prcd,S.Pckd,S.ShipOn,ISNULL(S.WO,0) AS WO,ISNULL(S.WO_Detail,0) AS WO_Detail "
				cSQL=cSQL+" ,AQ.Alloy "
				cSQL=cSQL+" ,dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS Descript "
				cSQL=cSQL+" ,S.SOitem, S.Hold, S.IntP "
				cSQL=cSQL+" ,ISNULL(S.RMA_No,0) AS RMA_No, ISNULL(S.RMA_Detail,0) AS RMA_Detail "
				cSQL=cSQL+" FROM dbo.Sales S WITH(NOLOCK) "
				cSQL=cSQL+" INNER JOIN dbo.AllQuotes AQ ON AQ.SOitem = S.SOitem "
				cSQL=cSQL+" WHERE S.SalesNum = "+STR(nSalesNum)
		
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesDescript')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesDescript')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesDescript")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesDescript")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesDescript' )
				ENDIF
		
				IF USED('tmpSalesDescript')
					IF RECCOUNT('tmpSalesDescript') > 0
						SELECT tmpSalesDescript
						GO TOP
						ThisForm.grdItem.Value = tmpSalesDescript.Item
						
						ThisForm.RefreshScreenItem()
						
					ENDIF
				ENDIF
				******************************
				
			ENDIF
			*USE IN tmpSOitems
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF USED('ChooseSales_No')
			USE IN ChooseSales_No
		ENDIF
		
		IF USED("Quotes")
			USE IN Quotes
		ENDIF
		
		IF USED("tmpSalesDescript")
			USE IN tmpSalesDescript
		ENDIF
		
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		*RETURN ThisForm.HoldNumber
		
	ENDPROC

	PROCEDURE chkCmplt.Click
		
		PRIVATE lComplete
		lComplete = PrepareSQLlogic( This.Value, 'Cancel',.F.)
		
		PRIVATE cSOitem, nSalesNum, nItemSO
		cSOitem 	= PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		nItem  		= PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',2,0)
		
		IF HavePermission('CompleteSO')
			IF lComplete 
				IF MESSAGEBOX("Are you sure you want to COMPLETE SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Complete ?") = 6
					*
					IF Mark_SOitem_Cmplt(cSOitem, ThisForm.nConnHandle, .F.) &&Default to .F. on UnMark
						Save_SOitem_Status( cSOitem, nSalesNum, 'Complete', 'Select_SO-Item:Mark SO-Item as Complete', ThisForm.nConnHandle )
						REPLACE Cmplt WITH .T. IN tmpSalesDescript
					ENDIF
				ELSE
					This.Value = IIF(lComplete,0,1)
					RETURN .F.
				ENDIF
			ELSE
				IF MESSAGEBOX("Are you sure you want to UN-Complete SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Not Complete?") = 6
					*
					IF Mark_SOitem_Cmplt(cSOitem, ThisForm.nConnHandle, .T.) &&T for Un Mark
						Save_SOitem_Status( cSOitem, nSalesNum, 'UNComplete', 'Select_SO-Item:Mark as UnComplete SO-Item', ThisForm.nConnHandle )
						REPLACE Cmplt WITH .F. IN tmpSalesDescript
					ENDIF
				ELSE
					This.Value = IIF(lComplete,0,1)
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("You do not have Permission to Complete this SO",0+48,"Not Allowed to change!")
			This.Value = IIF(lComplete,0,1)
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE chkCncld.Click
		
		PRIVATE lCancel
		lCancel = PrepareSQLlogic( This.Value, 'Cancel',.F.)
		
		PRIVATE cSOitem, nSalesNum, nItemSO
		cSOitem 	= PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		nItem  		= PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',2,0)
		
		IF lCancel 
			*Check to see if Shipped PRCD!
			IF NOT SOitem_PRCD(cSOitem, ThisForm.nConnHandle)
				*Check for PO
				PRIVATE nCntPOitem 
				nCntPOitem = 0
		
			*	nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle )
				IF USED('tmpPOp')
					USE IN tmpPOp
				ENDIF
		
				SELECT 0
				cSQL = "SELECT COUNT(poItem) AS CNTD FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL + " AND [cancelled] = 0"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOp')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOp' )
				ENDIF
		
				IF USED('tmpPOp')
					IF tmpPOp.CNTD > 0
						nCntPOitem = tmpPOp.CNTD
					ENDIF
					USE IN tmpPOp
				ENDIF
		
				IF nCntPOitem > 0
					MESSAGEBOX( "Found "+ALLTRIM(STR(nCntPOitem))+" Purchase Order item"+IIF(nCntPOitem>1,"s","")+" for this Sales Order item."+CHR(13)+;
					  "Check to see if this PO needs to be cancelled also."+;
					  "These cannot be automatically cancelled, you must check yourself!",0,"Item is still on Order!")
					  
					  *PurchaseOrder_POitem_Cancel( cPOitem, ThisForm.nConnHandle )
				ENDIF
				
				***********************
				
				IF MESSAGEBOX("Are you sure you want to Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"Cancel?") = 6
					*Cancel SO Item
					IF Cancel_SOitem( cSOitem, .T., ThisForm.nConnHandle )	&& .T. to Amend Ver
						REPLACE cncld WITH .T. IN tmpSalesDescript
						Save_SOitem_Status( cSOitem, nSalesNum, 'Cancel, now Not Prnt', 'Select_SO-Item:Cancel SOitem', ThisForm.nConnHandle )
					ENDIF
				ELSE
					This.Value = IIF(lCancel,0,1)
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
		
			IF HaveSODeletePermission(nSalesNum)
				IF MESSAGEBOX("Are you sure you want to UN-Cancel SOitem:"+ALLTRIM(cSOitem)+" ?",4+32,"UN-Cancel?") = 6
					REPLACE cncld WITH .F. IN tmpSalesDescript
					MESSAGEBOX("Not Programmed!",0+48,"No change!")
					*TrackMess("Sales Order Item "+ALLTRIM(cSOitem)+" has been marked as 'UN-Cancelled' on ("+DTOC(DATE())+")" +" EditOrder.chkCancelItem.Click()" )
					Save_SOitem_Status( cSOitem, nSalesNum, 'UNCancel', 'UNCancelled SO-Item', ThisForm.nConnHandle )
				ELSE
					This.Value = IIF(lCancel,0,1)
					RETURN .F.
				ENDIF
			ELSE
				MESSAGEBOX(cMess,0+48,"Not Allowed to change now!")
				This.Value = IIF(lCancel,0,1)
				RETURN .F.
			ENDIF
		
		ENDIF
		
	ENDPROC

	PROCEDURE chkIntP.Click
		*!*	PRIVATE lIntP
		*!*	lIntP = PrepareSQLlogic( This.Value, 'Cancel',.F.)
		
		*!*	PRIVATE cSOitem, nSalesNum, nItemSO
		*!*	cSOitem 	= PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
		*!*	nSalesNum	= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		*!*	nItem  		= PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',2,0)
		
		*!*	PRIVATE nWO
		*!*	nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		*!*	IF HavePermission('CompleteSO') &&Not IntP but same Permissions apply
		*!*		IF lIntP 
		*!*			IF MESSAGEBOX("Are you sure you want to mark SOitem:"+ALLTRIM(cSOitem)+" as an Internal Production?",4+32,"Internal Production ?") = 6
		*!*				*
		*!*				SELECT 0
		*!*				cSQL = "UPDATE dbo.Sales SET "
		*!*				cSQL = cSQL + " IntP=1 "
		*!*				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '' )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0 &&Try again!
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*					DO WHILE nSQLEXEC = 0
