		*!*						IF nSQLEXEC < 0
		*!*							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '' )
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
		*!*				*
		*!*				
		*!*			ELSE
		*!*				This.Value = IIF(lIntP,0,1)
		*!*				RETURN .F.
		*!*			ENDIF
		*!*		ELSE
		*!*			IF MESSAGEBOX("Are you sure you want to UN-Mark SOitem:"+ALLTRIM(cSOitem)+" as an Internal Production?",4+32,"Not Internal Production?") = 6
		*!*				*
		*!*				SELECT 0
		*!*				cSQL = "UPDATE dbo.Sales SET "
		*!*				cSQL = cSQL + " IntP=0 "
		*!*				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
