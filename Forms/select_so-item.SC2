		*!*				This.Value = IIF(lIntP,0,1)
		*!*				RETURN .F.
		*!*			ENDIF
		*!*		ENDIF
		*!*	ELSE
		*!*		MESSAGEBOX("You do not have Permission to Mark this SO",0+48,"Not Allowed to change!")
		*!*		This.Value = IIF(lIntP,0,1)
		*!*		RETURN .F.
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdCancelEdit.Click
		IF This.Caption = "Cancel"
			*place in ReadOnly mode, refresh data
			
			ThisForm.txtShipDue.Enabled = .F.
			ThisForm.cmdEditDate.Caption = "Edit"
			This.Caption = "Return"
			This.Visible = .F.
		ELSE
		
			ThisForm.cmdEditDate.Caption = "Edit"
		
			*ThisForm.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE cmdEditDate.Click
		IF This.Caption = "Edit"
			IF NOT PrepareSQLlogic(ThisForm.chkCmplt.Value,'Complete',.F.)
				*Put in edit Mode
				ThisForm.txtShipDue.Enabled = .T.
				This.Caption = "Save"
				ThisForm.cmdCancelEdit.Caption = "Exit"
				ThisForm.cmdCancelEdit.Visible = .T.
			ELSE
				WAIT WINDOW "Already Delivered" NOWAIT
			ENDIF
		ELSE
			*Save and set Read only.
			PRIVATE cSOitem
			cSOitem = PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
			
			****************************************
			PRIVATE cSQL2, cSQL, nSQLEXEC 
			cSQL2 = ''
			
			PRIVATE dHPA_Date_Update
			dHPA_Date_Update = PrepareSQLdate(ThisForm.txtShipDue.Value,'ShipDue')  &&,.F.,.T.
			
			cSQL = "UPDATE dbo.Sales "
			cSQL = cSQL + " SET ShipDue = '"+DTOC(dHPA_Date_Update)+"'" 
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,'')
			ELSE
				TrackMess( cSQL +" in SalesOreder_Select, Edit due date." )
			ENDIF
			
			****************************************
			
			cSQL = "UPDATE dbo.Sales_No "
			cSQL = cSQL + " SET amendment = amendment+1"
			cSQL = cSQL + ",ShopRecv = 0"
			cSQL = cSQL + " WHERE SalesNum = "+STR(VAL(cSOitem))
			cSQL = cSQL + " AND Changing = 0 "
			cSQL = cSQL + " AND cmplt = 0"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,'')
			ELSE
				PRIVATE nAmendment
				nAmendment = Get_Amendment_Sales_No( VAL(cSOitem), ThisForm.nConnHandle)
				Track_Sales_No_Chng( "SelectSO-item.EditDate ShipDue", VAL(cSOitem), .F., nAmendment )
						
				*TrackMess( cSQL +" in SalesOreder_Select, Edit due date." )
				MESSAGEBOX("This will Require a reprint"+CHR(13)+"Please goto 'SO Edit' and Print",0,"Must Reprint")
				Save_SOitem_Status( cSOitem, VAL(cSOitem), 'ShipDue', "Changed Ship Due Date to "+DTOC(dHPA_Date_Update)+" in Select SO-item", ThisForm.nConnHandle)
			ENDIF
			
			****************************************
			ThisForm.grdItem.Refresh
			ThisForm.txtShipDue.Enabled = .F.
			This.Caption = "Edit"
			*ThisForm.cmdCancelEdit.Caption = "Cancel"
			ThisForm.cmdCancelEdit.Visible = .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdEditHoldStatus.Click
		*ThisFormSet.SalesHistory()
		
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE nSalesNum,cSOitem
		cSOitem 	= PrepareSQLtxt(tmpSalesDescript.SOitem,'SOitem',10)
		nSalesNum	= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		
		IF nSalesNum > 0
			DO FORM Forms\SOitem_Status WITH cSOitem,ThisForm.nConnHandle
			
			ThisForm.Refresh_grdSOitems()
			*ThisForm.RefreshScreenItem() called in Refresh_grdSOitems()
		ENDIF
	ENDPROC

	PROCEDURE cmdFind.Click
		IF ThisForm.txtSalesOrder.Value > 0
			SELECT ChooseSales_No
			*SEEK ThisForm.txtSalesOrder.Value ORDER SalesNum
			LOCATE FOR SalesNum = ThisForm.txtSalesOrder.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				ThisForm.txtSalesOrder.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
			ThisForm.grdSales_No.Refresh
		*	ThisForm.grdSales_No.SetFocus
			ThisForm.RefreshScreen()
			ThisForm.grdSales_No.Refresh
			ThisForm.grdSales_No.clmSO.SetFocus()
		ELSE
			WAIT WINDOW "Enter Number to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE GrdItem.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.RefreshScreenItem()
		*ThisForm.RefreshScreenItem(This.Value)
	ENDPROC

	PROCEDURE GrdItem.Click
		ThisForm.RefreshScreenItem()
		
	ENDPROC

	PROCEDURE grdSales_No.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshScreen()
	ENDPROC

	PROCEDURE lblDatePicker.Click
		IF ThisForm.cmdEditDate.Caption = "Edit"
			RETURN .F.
		ENDIF
		
		PRIVATE dDate1,dDate2
		dDate1 = ThisForm.txtShipDue.Value
		
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		ThisForm.txtShipDue.Value = dDate2
		ThisForm.txtShipDue.Refresh
		ThisForm.txtShipDue.SetFocus
	ENDPROC

	PROCEDURE txtSalesOrder.Valid
		IF !EMPTY(THIS.Value)
			*ThisForm.cmdFind.Click
			SELECT ChooseSales_No
			*SEEK THIS.Value ORDER SalesNum
			LOCATE FOR SalesNum = This.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				THIS.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
		*	ThisForm.grdSales_No.Refresh()
		*	ThisForm.grdSales_No.SetFocus
			ThisForm.RefreshScreen()
			ThisForm.grdSales_No.Refresh()
			ThisForm.grdSales_No.clmSO.Refresh()
		ENDIF
	ENDPROC

ENDDEFINE
