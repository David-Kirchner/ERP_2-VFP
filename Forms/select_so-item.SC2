		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*						
		*!*						IF nSQLEXEC < 0
		*!*							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*								nSQLEXEC = 0
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDDO
		*!*				ENDIF 
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '' )
		*!*				ELSE
		*!*					Save_SOitem_Status( cSOitem, nSalesNum, 'Not IntP', 'Select_SO-Item:Marked as NOT Internal Production', ThisForm.nConnHandle )			
		*!*					REPLACE IntP WITH .F. IN tmpSalesDescript
		*!*					
		*!*					IF nWO > 0
		*!*						cSQL = "UPDATE dbo.WorkOrder SET "
		*!*						cSQL = cSQL + " IntP=0 "
		*!*						cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*						cSQL = cSQL + " AND WO = "+STR(nWO)
		*!*						
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '' )
