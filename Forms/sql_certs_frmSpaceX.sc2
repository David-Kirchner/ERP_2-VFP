	PROCEDURE Init
		LPARAMETERS toFormSet
		IF VARTYPE(toFormSet) = "O"
			ThisForm.oCertFormSet = toFormSet
		ENDIF
	ENDPROC

	PROCEDURE cmdSpaceXEdit.Click
		IF This.Caption = "Edit"
			ThisForm.oCertFormSet.EnableSpaceXHardness(.T.)
			ThisForm.cmdSpaceXExit.Caption = "Abort"
			This.Caption = "Save"
			ThisForm.txt0000.SetFocus
		ELSE
			IF This.Caption = "Save"
				IF ThisForm.oCertFormSet.SaveSpacexHardness()
					ThisForm.oCertFormSet.EnableSpaceXHardness(.F.)
					ThisForm.cmdSpaceXExit.Caption = "Exit"
					This.Caption = "Edit"
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdSpaceXExit.Click
		IF This.Caption = "Exit"
			ThisForm.Visible = .F.
		ELSE
			IF This.Caption = "Abort"
				ThisForm.oCertFormSet.EnableSpaceXHardness(.F.)
				ThisForm.oCertFormSet.ShowSpaceXHardness()
				This.Caption = "Exit"
				ThisForm.cmdSpaceXEdit.Caption = "Edit"
			ENDIF
		ENDIF
	ENDPROC

ENDDEFINE
