	PROCEDURE Init
		PARAMETER cDisplayName
		
		IF TYPE("cDisplayName") = "C"
			IF cDisplayName != "(Select Employee)"
				SELECT Employees
				SEEK UPPER(cDisplayName) ORDER UppDispNam
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_SQL.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('Employee')	
			USE IN Employee
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.Employee WITH(NOLOCK) "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'Employee')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'Employee')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Employee")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Employee")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'Employee')
		ELSE
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		IF USED('Employee')	
			USE IN Employee
		ENDIF
	ENDPROC

	PROCEDURE BUTTONSET1.cmdAdd.Click
		PRIVATE cCaption
		cCaption = This.Caption
		DODEFAULT()
		
		IF cCaption = "Add"
			ThisForm.ID1.Value = VAL( NewID("employeemaint") )
		ENDIF
	ENDPROC

	PROCEDURE cmdPrintScansheet.Click
		*REPORT FORM Reports\EmployeeScanSheet FOR Hourly AND Active TO PRINTER PROMPT
		
		INDEX ON Location + Login TAG EmplyLL
		SET ORDER TO TAG EmplyLL
		
		REPORT FORM Reports\EmployeeScanSheet FOR Hourly AND Active PREVIEW
		
	ENDPROC

ENDDEFINE
