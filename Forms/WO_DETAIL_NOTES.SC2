	PROCEDURE cmdWOD_Connect.Click
		
		PRIVATE cPOitem, nWO, nWOD, lReturn
		cPOitem = PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		cSOitem = PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		nWO		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWOD	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WOD',-3)
		
		PRIVATE nMess
		DO FORM Forms\Connect_Orders WITH nWO,nWOD,cPOitem,cSOitem,"WOD"
		
		
		
		*!*	***********************
		*!*	*Update Record
		*!*	nWO = getWO_with_POitem( cPOitem, ThisForm.nConnHandle) 
		*!*	This.Parent.lblWOnum.Caption = STR(nWO)
		
		*!*	nWO_Detail = getWOD_with_POitem( cPOitem, ThisForm.nConnHandle) 
		*!*	This.parent.lblWO_Dnum.Caption = STR(nWO_Detail)
		
		*!*	*********************
		*!*	IF nWO + nWO_Detail > 0
		*!*		PRIVATE cSQLi 
		*!*		cSQLi = "UPDATE dbo.PurchaseOrder "
		*!*		IF nWO > 0
		*!*			cSQLi = cSQLi + " SET WO="+STR(nWO)
		*!*			IF nWO_Detail > 0
		*!*				cSQLi = cSQLi +", WO_Detail="+STR(nWO_Detail)
		*!*			ENDIF
		*!*		ELSE
		*!*			cSQLi = cSQLi + " SET WO_Detail="+STR(nWO_Detail)
		*!*		ENDIF
		*!*		
		*!*		cSQLi = cSQLi + " WHERE POitem = '"+cPOitem+"'"
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi )
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF 
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC )
		*!*		ELSE
		
		*!*		ENDIF
		*!*	ENDIF
	ENDPROC

