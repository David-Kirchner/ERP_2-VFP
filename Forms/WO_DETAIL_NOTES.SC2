	PROCEDURE chkfCmplt.Click
		
		PRIVATE lCmplt, nWO_Detail 
		lCmplt		= PrepareSQLlogic(This.Value,'Cmplt')
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cUpdate, nSQLEXEC 
		
		IF nWO_Detail> 0
			IF lCmplt
				cUpdate = "UPDATE dbo.WorkOrder_Detail SET"
				cUpdate = cUpdate + " fFinishDate=GetDate()"
				cUpdate = cUpdate + ",fCmplt=1 " 
			 	cUpdate = cUpdate + " WHERE WO_Detail= "+STR(nWO_Detail)
			ELSE
				cUpdate = "UPDATE dbo.WorkOrder_Detail SET"
				cUpdate = cUpdate + " fFinishDate='' "
				cUpdate = cUpdate + ",fCmplt=0 " 
			 	cUpdate = cUpdate + " WHERE WO_Detail= "+STR(nWO_Detail)	
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cUpdate, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cUpdate, ThisFormSet.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cUpdate )
			ELSE
				WAIT WINDOW "Saved" NOWAIT
				*tmpPO_POitem
				IF lCmplt	
					SELECT tmpWO_Detail
					REPLACE tmpWO_Detail.fCmplt WITH .T.
				ELSE
					SELECT tmpWO_Detail
					REPLACE tmpWO_Detail.fCmplt WITH .F.
				ENDIF
			ENDIF
		ENDIF
		*This.Refresh
		
	ENDPROC

