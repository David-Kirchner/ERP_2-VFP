	PROCEDURE lblLotSearch.Click
		PRIVATE loHyperlink,m.cHyperLink
		*m.cHyperLink = HTML_MFG_Log(D,1002,.T.) &&lReturnURL --False is an HTML code.
		*https://raptor/ReportServer/Pages/ReportViewer.aspx?%2fMFG+Log%2fMFG+CC+CL+Search&rs:Command=Render&Alloy=HPA+N60&CC=7&CL=3&fSize=1
		
		PRIVATE cAlloy, cCC, cCL, nfSize
		cAlloy = PrepareSQLtxt(This.Parent.txtfAlloy.Value,'Alloy',12)
		cCC = PrepareSQLtxt(This.Parent.cmbFcc.Value,'CC',1)
		cCL = PrepareSQLtxt(This.Parent.cmbfCL.Value,'CL',1)
		nfSize = PrepareSQLnum(This.Parent.txtfThck.Value,'Thck',9,3)
		
		cHyperLink = HTML_MFG_CC_CL_Search(cAlloy, cCC, cCL, nfSize, .T.)
		
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(m.cHyperLink)
		RELEASE loHyperlink
		
	ENDPROC

	PROCEDURE lblOverSize.Click
		PRIVATE nfThck, nRoughSize, nOverSize
		nfThck		= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',8,3)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		IF nOverSize = 0
			IF nRoughSize > 0 AND nfThck > 0 AND nRoughSize > nfThck 
				nOverSize = nRoughSize - nfThck
				ThisForm.txtOverSize.Value = PrepareSQLnum(nOverSize,'OverSize',5,3)
			ENDIF
		ELSE
			IF nRoughSize = 0
				IF nfThck > 0 
					nRoughSize = nOverSize + nfThck
					ThisForm.txtRoughSize.Value = PrepareSQLnum(nRoughSize,'RoughSize',8,3)
				ENDIF
			ELSE
				*have OverSize and RoughSize
				IF nfThck = 0
					nfThck = nRoughSize - nOverSize 
					ThisForm.txtFThck.Value = PrepareSQLnum(nfThck,'Thck',8,3)
				ENDIF
			ENDIF
		ENDIF
		
		***Check if numbers add up.
		IF nOverSize > 0
			PRIVATE nCalcRoughSize, nCalcfThck
			IF nRoughSize > 0
				nCalcfThck = nRoughSize - nOverSize 
			ENDIF
			IF nfThck > 0
				nCalcRoughSize = nfThck + nOverSize 
			ENDIF
			
			IF nRoughSize > 0 AND nfThck > 0
				IF (nCalcfThck+10)*.9 < (nfThck+10) OR (nCalcfThck+10) > (nfThck+10)*.9
					*Within 10%
				ELSE
					MESSAGEBOX("Thck/Diameter "+ALLTRIM(STR(nfThck,9,3))+CHR(13)+" is more than 10% different than "+CHR(13)+" RoughSize - OverSize "+ALLTRIM(STR(nCalcfThck,9,3))+CHR(13)+"Please correct one of these numbers.",0+48,"Numbers do not Calculate.")
				ENDIF
				
				IF (nCalcRoughSize+10)*.9 < (nRoughSize+10) OR (nCalcRoughSize+10) > (nRoughSize+10)*.9
					*Within 10%
				ELSE
					MESSAGEBOX("Rough Size "+ALLTRIM(STR(RoughSize,9,3))+CHR(13)+" is more than 10% different than "+CHR(13)+" Thck + OverSize "+ALLTRIM(STR(nCalcRoughSize,9,3))+CHR(13)+"Please correct one of these numbers.",0+48,"Numbers do not Calculate.")
				ENDIF
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE lblProj.Click
		IF NOT USED('tmpProjStk')
			ThisFormSet.InitProjStk()
		ENDIF
		
		PRIVATE nStock_Projected_ID
		nStock_Projected_ID = PrepareSQLnum(ThisForm.txtStock_Projected_ID.Value,'Stock_Projected_ID',-3)
		IF nStock_Projected_ID > 0
			ThisFormSet.nStock_Projected_ID = nStock_Projected_ID
			SELECT tmpProjStk
			LOCATE FOR ID = nStock_Projected_ID 
			IF FOUND('tmpProjStk')
				ThisFormSet.frmStock_Projected.cmdNewWO.Visible = .F.
				ThisFormSet.frmStock_Projected.grdProStk.Refresh
			ENDIF
			ThisFormset.ProjStk_Refresh()
		ELSE
			ThisFormSet.nStock_Projected_ID = 0
			ThisFormSet.frmStock_Projected.cmdNewWO.Caption = "Select for WO"
			ThisFormSet.frmStock_Projected.cmdNewWO.Visible = .T.
		ENDIF
		
		ThisFormSet.Refresh_Projected()
		
		
		ThisFormSet.frmStock_Projected.Left = 30
		ThisFormSet.frmStock_Projected.Top = 30
		ThisFormSet.frmStock_Projected.Visible = .T.
		
		ThisFormSet.frmStock_Projected.AlwaysOnTop = .T.
		
		
		
	ENDPROC

	PROCEDURE lblRoughSize.Click
		PRIVATE nfThck,nsThck,nStartSize, nCW, nCWp, nRoughSize, nOverSize
		nfThck		= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',8,3)
		nsThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',8,3)
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		nCWp		= 1+(nCW/100)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		*FIND D2 BY D1 AND RA
		IF nRoughSize = 0 AND nfThck > 0 AND nCW = 0 AND nStartSize = 0
			IF nOverSize = 0
				nOverSize = .050
			ENDIF
			nRoughSize = nfThck + nOverSize 
			ThisForm.txtRoughSize.Value = PrepareSQLnum(nRoughSize,'RoughSize',8,3)
			ThisForm.txtOverSize.Value	= nOverSize 
		ENDIF
		
		IF nRoughSize = 0
			WAIT WINDOW "Calculating RoughSize" NOWAIT
			IF (nStartSize > 0 OR nsThck > 0 ) AND nCW > 0
				*M.A1= 3.14156*M.sD1*M.sD1/4
				*M.A2 = M.A1 - ( M.A1 * M.RA)
				*M.sD2 = SQRT(M.A2*4/3.14156)
				
				*,SQRT(((3.14156*(thck+OverSize)*(thck+OverSize)/4)/(1-(CAST(CW AS Numeric(4,2))/100)))*4/3.14156) CalcD11
				*,(Thck+OverSize)/SQRT(1-(CAST(CW AS Numeric(4,2))/100)) AS Ds1
				IF nStartSize > 0
					nD1 = nStartSize 
				ELSE
					nD1 = nsThck 
					*StartSize = 0, replace with sThck
					ThisForm.txtStartSize.Value = nsThck	
				ENDIF
				
				*M.A1= 3.14156*M.sD1*M.sD1/4
				*M.A2 = M.A1 - ( M.A1 * M.RA)
				*M.sD2 = SQRT(M.A2*4/3.14156)
				PRIVATE nArea2
				nArea2 = (3.14156*nD1*nD1/4 ) - ( 3.14156*nD1*nD1/4 * (nCW/100) )
				nRoughSize = SQRT(nArea2 *4/3.14156)
				
				*nRoughSize = SQRT((3.14156*nD1*nD1/4) - ( (3.14156*nD1*nD1/4) *nCWp) *4/3.14156)
				ThisForm.txtRoughSize.Value = PrepareSQLnum(nRoughSize,'RoughSize',8,3)
			ENDIF
		ENDIF
		
		IF nOverSize > 0
			IF PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)	<> nOverSize
				ThisForm.txtOverSize.Value = nOverSize
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE lblStartDia.Click
		PRIVATE nThck, nfThck, nStartSize, nCW, nCWp, nRoughSize
		nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',8,3)
		nfThck		= PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',8,3)
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		nCWp		= 1+(nCW/100)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		
		IF nStartSize = 0 &&AND nCW = 0
			WAIT WINDOW "Calculating StartSize" NOWAIT
			IF nThck > 0 
				IF nfThck > 0 AND nRoughSize = 0
					nRoughSize = nfThck +.050
					ThisForm.txtRoughSize.Value = PrepareSQLnum(nRoughSize,'RoughSize',8,3)
				ELSE
					IF nCW = 0
						nStartSize = nThck 
						ThisForm.txtStartSize.Value = PrepareSQLnum(nStartSize,'StartSize',8,3)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF nStartSize = 0
			IF nCW > 0
				IF nCWp > 0 AND nRoughSize > 0
					*FIND D1 BY D2 AND RA
					
					*M.A2= 3.14156*M.sD2*M.sD2/4
					*M.A1 = M.A2/(1-M.sRA)
					*M.sD1 = SQRT(M.A1*4/3.14156)
					nStartSize = SQRT( ((3.14156*nRoughSize*nRoughSize/4)/(1-(nCW/100))) *4/3.14156)
					
					*/nStartSize = SQRT( (nStartSize*nStartSize) / nCWp )
					ThisForm.txtStartSize.Value = PrepareSQLnum(nStartSize,'StartSize',8,3)
				ENDIF
			ENDIF
		
		ENDIF
		
	ENDPROC

