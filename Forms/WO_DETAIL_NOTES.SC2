			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMachineLot")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMachineLot")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpMachineLot')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		
			IF USED('tmpMachineLot')
				IF RECCOUNT('tmpMachineLot') > 0
					IF tmpMachineLot.CNTD > 0
						lValidLot = .T.
					ELSE
						MESSAGEBOX("This Machine:"+cMach+"  and Lot:"+ALLTRIM(STR(nLOT))+ " was not found!",16,"Replace with '0' to continue")
					ENDIF
				ENDIF
				USE IN tmpMachineLot
			ENDIF
		ENDIF
		
		RETURN lValidLot
	ENDPROC

