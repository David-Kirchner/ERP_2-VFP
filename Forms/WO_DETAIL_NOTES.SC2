	PROCEDURE cmdCreateLot.Click
		PRIVATE cMach, cFollowMach, nLot, cAlloy, nfThick, cMach1 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'Mach',20)
		cFollowMach = PrepareSQLtxt(ThisForm.cmbFollowM.Value,'FollowMach',20)
		nLot	= PrepareSQLnum(ThisForm.txtFinishLot.Value,'Lot',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtfAlloy.Value,'Alloy',12)
		nfThick = PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',10,4)
		cMach1	= PrepareSQLtxt(ThisForm.cmbFollowM.Value,'Mach',20)
		
		IF EMPTY(cMach)
			IF NOT EMPTY(cFollowMach)
				cMach = cFollowMach 
			ENDIF
		ENDIF
		
		IF EMPTY(cMach)
			cMach = cMach1
			ThisForm.cmbFinishM.Value = cMach
		ENDIF
		
		IF EMPTY(cMach)
			MESSAGEBOX("You must Declare the Machine before inserting a new LOT",16,"Unknown machine")
			RETURN .F.
		ENDIF
		
		******************************
		DO CASE
		CASE cMach = "Draw Bench"
		CASE cMach = "GFM"
		CASE cMach = "Heat Treat"
		CASE cMach = "Open Die"
		CASE cMach = "Rolling"
		CASE cMach = "Swage"
		CASE cMach = "Wire Draw"
		OTHERWISE
			TrackError("Mach is not programmed","No Mach",PROGRAM(),LINENO(1))
			RETURN .f.
		ENDCASE
			
			
		IF nfThick=0 OR EMPTY(cAlloy)
			MESSAGEBOX("Please fill in more of the 'Finish' WO_Detail so a good insert log can be made.",16,"Unknown Alloy or Thickness")
			RETURN .F.
		ENDIF
		IF nLot > 0
			IF MESSAGEBOX("Lot is set to :"+ALLTRIM(STR(nLot))+CHR(13)+"Do you still want to create a NEW lot?",4+32,"Replace LOT number?") != 6
				RETURN .F.
			ENDIF
		ENDIF
		
		********************************
		PRIVATE cMess, nMess
		*nMess = MESSAGEBOX("This 'Create Lot' procedure requires the current WO Detail "+CHR(13)+"to be save to disk."+CHR(13)+"the Save WO Detail routine will be run for you."+CHR(13)+CHR(13)+"Is it OK to Save current DETAIL data?"+CHR(13)+"Has ALL the detail been entered that is needed"+CHR(13)+"to create a Lot?"+CHR(13)+CHR(13)+"Answer No to Abort this Create.",4+32,"OK to Continue?")
		*IF nMess <> 6
		*	RETURN .F.
		*ELSE
			IF NOT ThisFormSet.SaveAddDetail(.F.)
				MESSAGEBOX("This 'Create Lot' procedure requires the current WO Detail "+CHR(13)+"to be save to disk."+CHR(13)+"the Save WO Detail routine will be run for you."+CHR(13)+CHR(13)+"Is it OK to Save current DETAIL data?"+CHR(13)+"Has ALL the detail been entered that is needed"+CHR(13)+"to create a Lot",4+32,"Save failed")
				RETURN .F.
			ENDIF
		*ENDIF
		
		********************************
		PRIVATE nWO,nWO_Detail,nPieces,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,nWeight
		PRIVATE nID_Detail,nID_Detail_Process,cDescript,cSalesRep,cNotes,lRE,cSOitem,cPOitem
		
		
		***********
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWO_Detail = 0
			*Must Save First
			IF MESSAGEBOX("There is no WO_Detail"+CHR(13)+"Is it OK to save current WO/WO_detail data (Y)?"+CHR(13)+"No data to send to new Log!",4+32,"Save WO_Detail now?")=6
				ThisFormSet.SaveAddWO()   &&Saves booth WO and WO_Detail
			ENDIF
		ENDIF
		***********
		
		nWO			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWO_Detail = 0
			RETURN .F.
		ENDIF
		nPieces		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtPieces.Value,'Pieces',-3)
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbCL.Value,'CL',1)
		nThck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtThck.Value,'Thck',14,4)
		nSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz2.Value,'Sz2',13,3)
		nSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtSz3.Value,'Sz3',13,3)
		*nID_Detail	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtID_Detail.Value,'ID_Detail',-3)
		*nID_Detail_Process = PrepareSQLnum(ThisFormSet.frmWorkOrder.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		nWeight		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtWeight.Value,'Weight',11,1)
		cDescript	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtDescript.Value,'Descript',100)
		cSalesRep	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSalesRep.Value,'SalesRep',20)
		cNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtWO_Notes.Value,'Notes',-1)
		
		*lIntP		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')
		lRE			= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkRE.Value,'RE')
		cSOitem		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtSOitem.Value,'SOitem',10)
		cPOitem		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtPOitem.Value,'POitem',12)
		
		*************
		PRIVATE nFPieces,cFAlloy,cHeat,cFForm,cFCC,cFCL,nFThck,nFSz2,nFSz3,nFWeight
		nFPieces	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFPieces.Value,'Pieces',-3)
		
		IF StockLst_Process_Count_WO( nWO, "S", ThisForm.nConnHandle, "SELECTED") > 0
			cHeat = ThisFormSet.getHeat_WO(nWO)
		ELSE
			cHeat	= ''
		ENDIF
		cFAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
		cFForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFForm.Value,'Form',2)
		cFCC		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCC.Value,'CC',1)
		cFCL		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCL.Value,'CL',1)
		nFthck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz2.Value,'Sz2',13,3)
		nFSz3		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFSz3.Value,'Sz3',13,3)
		nFWeight	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFWeight.Value,'Weight',11,1)
		PRIVATE cFDescript, cFNotes, cfCondLevel, cFollowM, nFollowLot, cFinishM, nFinishLot
		cFDescript	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFdescript.Value,'FDescript',50)
		cFNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtfNotes.Value,'FNotes',-1)
		cfCondLevel = PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		cFollowM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFollowM.Value,'FollowM',20)
		nFollowLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFollowLot.Value,'FollowLot',-3)
		cFinishM	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFinishLot.Value,'FinishLot',-3)
		PRIVATE cFSOitem, cFPOitem
		cFSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSOitem.Value,'SOitem',10)
		cFPOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFPOitem.Value,'POitem',12)
		
		PRIVATE nfReceivingID, lfCmplt, cFNotes, nStock_Projected_ID, lfCncld, lStkListed
		nfReceivingID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtfReceivingID.Value,'RecevingID',-3)
		*lIntP		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkIntP.Value,'IntP')  
		lfCmplt		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCmplt.Value,'fCmplt')
		cFNotes		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.edtfNotes.Value,'Notes',-1)
		nStock_Projected_ID	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStock_Projected_ID.Value,'Stock_Projected_ID',-3)
		lfCncld		= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkfCncld.Value,'fCncld')
		lStkListed	= PrepareSQLlogic(ThisFormSet.frmWorkOrder.chkStkListed.Value,'StkListed')
		
		PRIVATE cFSpec, cfCondLevel, nStartSize, nCW, nRoughSize, nOverSize 
		cFSpec		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFSpec.Value,'fSpec',50)
		cfCondLevel	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfCondLevel.Value,'fCondLevel',30)
		nStartSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtOverSize.Value,'OverSize',5,3)
		
		IF nRoughSize = 0 AND nFthck >  0
			nRoughSize = nFthck
			ThisFormSet.frmWorkOrder.txtRoughSize.Value = nRoughSize
		ENDIF
			
		PRIVATE nSalesNum, nItemSO, cSOitem
		nSalesNum = VAL( PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfSOitem.Value,'SOitem',10))
		cSOitem	= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtfSOitem.Value,'SOitem',10)
		nItemSO = VAL( RIGHT(cSOitem,2))
		
		*****************
		*Look For Project restocking Program data
		
		PRIVATE lFoundProj, cProjCompany, cProjSpec_CC,cProjSpec_CL,cProj_ConditionLevel_Spec
		lFoundProj		= .F.
		cProjCompany	= ''
		cProjSpec_CC	= cFCC
		cProjSpec_CL	= cFCL
		cProj_ConditionLevel_Spec = ''
		PRIVATE nMinUTS,nMinYLD,nMinEl,nMinRA,cCmax 
		nMinUTS	= 0
		nMinYLD	= 0
		nMinEl	= 0
		nMinRA	= 0
		cCmax 	= ''
		
		IF nStock_Projected_ID > 0
			IF USED('tmpProjCompany')	
				USE IN tmpProjCompany
			ENDIF
		
			cSQL = "SELECT SP.Company, SP.Spec_CC, SP.Spec_CL, CL.Spec "
			cSQL = cSQL + " ,CL.MinUTS,CL.MinYLD,CL.MinEl,CL.MinRA,CL.Cmax "
			cSQL = cSQL + " FROM dbo.Stock_Projected SP "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.ConditionLevel CL ON SP.Spec_CC = CL.CC AND SP.Spec_CL = CL.CL "
			cSQL = cSQL + " WHERE SP.ID = "+STR(nStock_Projected_ID)
					
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProjCompany')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProjCompany')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProjCompany")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProjCompany")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpProjCompany')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				RETURN 
			ELSE
				IF USED('tmpProjCompany')
					IF RECCOUNT('tmpProjCompany') > 0
						lFoundProj = .T.
						
						cProjCompany	= ShowSQLtxt(tmpProjCompany.Company,'Company',30)
						cProjSpec_CC 	= ShowSQLtxt(tmpProjCompany.Spec_CC,'CC',1)
						cProjSpec_CL 	= ShowSQLtxt(tmpProjCompany.Spec_CL,'CC',1)
						cProj_ConditionLevel_Spec = ShowSQLtxt(tmpProjCompany.Spec,'Spec',50)
						
						nMinUTS = PrepareSQLnum(tmpProjCompany.MinUTS,'MinUTS',-3)
						nMinYLD = PrepareSQLnum(tmpProjCompany.MinYld,'MinYld',-3)
						nMinEl	= PrepareSQLnum(tmpProjCompany.MinEL,'MinEL',-3)
						nMinRA	= PrepareSQLnum(tmpProjCompany.MinRA,'MinRA',-3)
						cCmax	= PrepareSQLtxt(tmpProjCompany.Cmax,'Cmax',3)
						
						cfCondLevel = cfCondLevel + CHR(13)+"Proj Company: "+ALLTRIM(cProjCompany)+", ProjID: "+ALLTRIM(STR(nStock_Projected_ID))
						cfCondLevel = cfCondLevel + CHR(13)+"Min UTS:"+ALLTRIM(STR(nMinUTS,10,0))
						cfCondLevel = cfCondLevel + ",  Min YLD:"+ALLTRIM(STR(nMinYLD,10,0))
						cfCondLevel = cfCondLevel + ",  Min EL:"+ALLTRIM(STR(nMinEL,2,0))
						cfCondLevel = cfCondLevel + ",  Min RA:"+ALLTRIM(STR(nMinRA,2,0))
						IF NOT EMPTY(cCmax)
							cfCondLevel = cfCondLevel + ",  RC Max:"+ALLTRIM(cCMax)
						ENDIF
		
					ENDIF
					USE IN tmpProjCompany
				ENDIF
			ENDIF
		ENDIF
		
		*******************
		IF NOT lFoundProj
			*Use CC and CL to get Strength
		*!*		cProj_ConditionLevel_Spec = ShowSQLtxt(tmpProjCompany.Spec,'Spec',50)
		*!*		
		*!*		nMinUTS = PrepareSQLnum(tmpProjCompany.MinUTS,'MinUTS',-3)
		*!*		nMinYLD = PrepareSQLnum(tmpProjCompany.MinYld,'MinYld',-3)
		*!*		nMinEl	= PrepareSQLnum(tmpProjCompany.MinEL,'MinEL',-3)
		*!*		nMinRA	= PrepareSQLnum(tmpProjCompany.MinRA,'MinRA',-3)
		*!*		cCmax	= PrepareSQLtxt(tmpProjCompany.Cmax,'Cmax',3)
		*!*		
		*!*		cfCondLevel = cfCondLevel + CHR(13)+"Proj Company: "+ALLTRIM(cProjCompany)+", ProjID: "+ALLTRIM(STR(nStock_Projected_ID))
		*!*		cfCondLevel = cfCondLevel + CHR(13)+"Min UTS:"+ALLTRIM(STR(nMinUTS,10,0))
		*!*		cfCondLevel = cfCondLevel + ",  Min YLD:"+ALLTRIM(STR(nMinYLD,10,0))
		*!*		cfCondLevel = cfCondLevel + ",  Min EL:"+ALLTRIM(STR(nMinEL,2,0))
		*!*		cfCondLevel = cfCondLevel + ",  Min RA:"+ALLTRIM(STR(nMinRA,2,0))
		*!*		IF NOT EMPTY(cCmax)
		*!*			cfCondLevel = cfCondLevel + ",  RC Max:"+ALLTRIM(cCMax)
		*!*		ENDIF
		
		ENDIF
		
		*******************
		IF NOT EMPTY(cProj_ConditionLevel_Spec)
			cFDescript = PrepareSQLtxt(  cProj_ConditionLevel_Spec  ,'Spec',50,.F.,.F.)
		ENDIF
		
		
		***********************************************
		*Check Selected Start Stock for Heat
		*************************************************
		
		IF nWO > 0
			IF USED('tmpSelectSTK')	
				USE IN tmpSelectSTK
			ENDIF
		
			cSQL =        "SELECT M.Heat "
			cSQL = cSQL + " FROM dbo.StockLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.Stocklst_Master M ON M.ID = D.ID "
			cSQL = cSQL + " WHERE P.WO = "+ALLTRIM(STR(nWO))
			cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT M.Heat "
			cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M ON D.ID = M.ID "
			cSQL = cSQL + " WHERE P.WO = "+ALLTRIM(STR(nWO))
			cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID='PARTSELECT' )"
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT M.Heat "
			cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
			cSQL = cSQL + " WHERE P.WO = "+ALLTRIM(STR(nWO))
		*	cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
					
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSelectSTK')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSelectSTK')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSelectSTK")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSelectSTK")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSelectSTK')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				
			ELSE
				IF USED('tmpSelectSTK')
					IF RECCOUNT('tmpSelectSTK') > 0
						cHeat = tmpSelectSTK.Heat
					ENDIF
					USE IN tmpSelectSTK
				ENDIF
			ENDIF
		ENDIF
		
		*********************
		* nFollowLot
		PRIVATE cFollowNotes
		cFollowNotes = ""
		IF nFollowLot > 0 AND LEN(cFollowM) > 0
			*get Lot Notes from a Follow Lot!
			
			IF USED('tmpLotNotes')	
				USE IN tmpLotNotes
			ENDIF
			
			DO CASE
			CASE cMach = "Draw Bench"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.Draw_log "
			CASE cMach = "GFM"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.GFMlog "
			CASE cMach = "Heat Treat"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.HT_log "
			CASE cMach = "Open Die"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.LakeErie_log "
			CASE cMach = "Rolling"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.Roll_log "
			CASE cMach = "Swage"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.Swage_log "
			CASE cMach = "Wire Draw"
				cSQL = "SELECT ISNULL(Notes,'') AS Notes, ISNULL(WO,0) AS WO, ISNULL(WO_Detail,0) AS WO_Detail, ISNULL(ProjID,0) AS ProjID FROM "
				cSQL = cSQL + " dbo.Wire_log "
			OTHERWISE
				TrackError("cMach is not programmed"+CHR(13)+cMach ,"No Mach",PROGRAM(),LINENO(1))
				RETURN .f.
			ENDCASE
			cSQL = cSQL + " WHERE LOT = "+ALLTRIM(STR(nFollowLot))
					
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLotNotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLotNotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLotNotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLotNotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpLotNotes')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				
			ELSE
				IF USED('tmpLotNotes')
					IF RECCOUNT('tmpLotNotes') > 0
						cFollowNotes = "Follow "+ShowSQLtxt(tmpLotNotes.Notes,'Notes',-1)+" "+ALLTRIM(STR(nFollowLot))+": "+ tmpLotNotes.Notes
					ENDIF
					USE IN tmpLotNotes
				ENDIF
			ENDIF
			
			
		ENDIF
		*********************
		*Insert WO_Detail as a new LOG
		*cInit = GetMachine_Init( cMach, nConn )
		*cMach = GetMachine_Caption( cInit, nConn )
		
		
		  
		IF USED('tmpCountLot')	
			USE IN tmpCountLot
		ENDIF
		
		cSQL = "SELECT MAX(Lot) AS MaxLot "
		DO CASE
		CASE cMach = "Draw Bench"
			cSQL = cSQL + " FROM dbo.Draw_Log "
		CASE cMach = "GFM" 
			cSQL = cSQL + " FROM dbo.GFMLog "
		CASE cMach = "Heat Treat"
			cSQL = cSQL + " FROM dbo.HT_log "
		CASE cMach = "Open Die"
			cSQL = cSQL + " FROM dbo.LakeErie_log "
		CASE cMach = "Rolling"
			cSQL = cSQL + " FROM dbo.Roll_log "
		CASE cMach = "Swage"
			cSQL = cSQL + " FROM dbo.Swage_Log "
		CASE cMach = "Wire Draw"
			cSQL = cSQL + " FROM dbo.Wire_log "
		OTHERWISE
			MESSAGEBOX("Please Choose the Machine type first",48,"Cannot Select")
			RETURN .F.
		ENDCASE
		
				
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			RETURN 
		ELSE
			IF USED('tmpCountLot')
				IF tmpCountLot.MaxLot > 0
					nLot = tmpCountLot.MaxLot+1
					ThisFormSet.frmWorkOrder.txtFinishLot.Value = nLot
				ENDIF
				USE IN tmpCountLot 
			ENDIF
		ENDIF
		
		*********
		*get Notes
		PRIVATE cLotNotes
		cLotNotes = ""
		IF LEN(cFollowNotes) > 0
			cLotNotes = cFollowNotes +CHR(13) +CHR(13)
		ENDIF
		IF LEN(cfCondLevel) > 0
			cLotNotes = cLotNotes+ cfCondLevel +CHR(13)
		ENDIF
		cLotNotes = cLotNotes +"Starting Stock size is "+Remove0(nThck,9,3)+[" ]
		IF cAlloy = "HPA N60"
			IF cProjSpec_CC = "S" OR cProjSpec_CC ="L"  OR cProjSpec_CC = "R"
				cLotNotes= cLotNotes+ " ESR "
			ENDIF
		ENDIF
		*	IF cAlloy = "HPA N60" OR cAlloy = "HPA N50"
		*		cLotNotes= cLotNotes +CHR(13)+"Anneal 1925-1950F 1/2 Hr WQ or Rapid Air Cool."
		*	ENDIF
		IF nStartSize > 0
			cLotNotes= cLotNotes +CHR(13)+"Start Size is "+Remove0(nStartSize,9,3)+[" ]
		ENDIF
		IF cProjSpec_CC = "S" OR cProjSpec_CC = "L" OR cProjSpec_CC = "F"
			cLotNotes= cLotNotes +CHR(13)+"Work Cold to "+Remove0(nRoughSize,9,3)+[" ]
			
			IF UPPER(cMach) = "GFM" 
				IF VAL(cProjSpec_CL) > 2
					cLotNotes= cLotNotes +CHR(13)+"Do NOT make bars smoke."
					cLotNotes= cLotNotes +CHR(13)+"Use ICE and keep bars FULLY submerged."
					cLotNotes= cLotNotes +CHR(13)+"When using ice, make sure bars are COLD prior ro starting next pass."
				ENDIF
			ENDIF
			cLotNotes= cLotNotes +IIF( NOT EMPTY(cFNotes), CHR(13)+cFNotes, '')
		ELSE
			IF nRoughSize > 0
				cLotNotes= cLotNotes +CHR(13)+"work to "+Remove0(nRoughSize,9,3)+[" ]
			ENDIF
		ENDIF
		
		***********************
		*Add WO_Detail Notes to SHOP workers.
		IF NOT EMPTY(cFNotes)
			cLotNotes= cLotNotes +CHR(13)+CHR(13)+cFNotes
		ENDIF
		
		***********************
		*Testing info
		DO CASE
		CASE cProjSpec_CC = "S"
			IF nFthck <= 1
				cLotNotes= cLotNotes +CHR(13)+CHR(13)+[Cut 1PC 6.5" for SpaceX Mechanical and Hardness Testing. (For Center, Center and Hardness Profile)]+ CHR(13)
			ELSE
				cLotNotes= cLotNotes +CHR(13)+CHR(13)+[Cut 1PC 12.5" for SpaceX Mechanical and Hardness Testing. (For Outer with Outer, Center, Center and Hardness Profile)]+ CHR(13)
			ENDIF
		CASE cProjSpec_CC = "L"
			cLotNotes= cLotNotes +CHR(13)+CHR(13)+[Cut 1PC 4" and 2PC 3" for LMA Mechanical and Hardness Testing. (For Mid Radius of 3 different bars and Grain)]+ CHR(13)
		OTHERWISE
			cLotNotes= cLotNotes +CHR(13)+CHR(13)+[Cut 1PC 4" for Mechanical and Hardness Testing.  (For Hardness Profile) ]+ CHR(13)
		ENDCASE
		
		*********
		*RecordTest('Record Test Data.', PROGRAM(), LINENO(1), PrepareSQLtxt(cLotNotes,'Notes',-1))
		
		DO CASE
		CASE UPPER(cMach) = "DRAW BENCH" 
			cSQL = "INSERT INTO dbo.Draw_log "
		CASE UPPER(cMach) = "GFM" 
			cSQL = "INSERT INTO dbo.GFMlog "
		CASE UPPER(cMach) = "HEAT TREAT" 
			cSQL =  "INSERT INTO dbo.HT_Log "
		CASE UPPER(cMach) = "OPEN DIE" 
			cSQL =  "INSERT INTO dbo.LakeErie_Log "
		CASE UPPER(cMach) = "ROLLING"
			cSQL =  "INSERT INTO dbo.Roll_Log "
		CASE UPPER(cMach) = "SWAGE"
			cSQL =  "INSERT INTO dbo.Swage_Log "
		CASE UPPER(cMach) = "WIRE DRAW" 
			cSQL = "INSERT INTO dbo.WIRE_Log "
		OTHERWISE
			cSQL = ''
		ENDCASE
		
		
		cSQL = cSQL + "(AlloyName, [Date], Heat, Lot"
		cSQL = cSQL + ",Spiece"
		IF UPPER(cMach) != "HEAT TREAT" 
			cSQL = cSQL + ",Fpiece"
		ENDIF
		cSQL = cSQL + ",Ssize"
		DO CASE			&&RoughSize
		CASE UPPER(cMach) = "DRAW BENCH" 
			cSQL = cSQL + ",DRAWsize"
		CASE UPPER(cMach) = "GFM" 
			cSQL = cSQL + ",GFMsize"
		CASE UPPER(cMach) = "HEAT TREAT" 
			*cSQL = cSQL + ",sSize"
		CASE UPPER(cMach) = "OPEN DIE" 
			*cSQL = cSQL + ",fsize"
		CASE UPPER(cMach) = "ROLLING"
			cSQL = cSQL + ",RollSize"
		CASE UPPER(cMach) = "SWAGE"
			cSQL = cSQL + ",SwageSize"
		CASE UPPER(cMach) = "WIRE" 
			cSQL = cSQL + ",DrawSize"
		ENDCASE
		IF UPPER(cMach) = "GFM" OR UPPER(cMach) = "OPEN DIE" OR UPPER(cMach) = "ROLLING" OR UPPER(cMach) = "SWAGE" 
			cSQL = cSQL + ",Flength"
			cSQL = cSQL + ",[Fsize]"
		ENDIF
		cSQL = cSQL + ",Sweight"
		cSQL = cSQL + ",Condition"
		IF UPPER(cMach) != "HEAT TREAT" 
			cSQL = cSQL + ",ColdWork"
		ENDIF
		cSQL = cSQL + ",Spec"
		cSQL = cSQL + ",SalesNum,ItemSO,SOitem"
		cSQL = cSQL + ",Notes"
		cSQL = cSQL + ",WO,WO_Detail,ProjID "
		
		cSQL = cSQL + ") VALUES "
		
		cSQL = cSQL + "('"+cAlloy+"','"+DTOC(DATE())+"','"+cHeat+"',"+STR(nLot,10,0)
		cSQL = cSQL + ","+STR(nPieces,5,1)		&&Spiece
		IF UPPER(cMach) != "HEAT TREAT" 		&&Fpiece
			cSQL = cSQL + ","+STR(nFpieces,5,0)
		ENDIF
		cSQL = cSQL + ","+STR(nThck,9,3) &&Ssize
		
		DO CASE							&&RoughSize
		CASE UPPER(cMach) = "DRAW BENCH" 
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "GFM" 
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "HEAT TREAT" 
			*cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "OPEN DIE" 
			*cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "ROLLING"
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "SWAGE"
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		CASE UPPER(cMach) = "WIRE" 
			cSQL = cSQL + ","+STR(nRoughSize,9,3)
		ENDCASE
		IF UPPER(cMach) = "GFM" OR UPPER(cMach) = "OPEN DIE" OR UPPER(cMach) = "ROLLING" OR UPPER(cMach) = "SWAGE" 
			cSQL = cSQL + ","+STR(nFSz2,9,3)	 &&Flength
			cSQL = cSQL + ","+STR(nFthck,10,3)	 &&Fsize
		ENDIF
		cSQL = cSQL + ","+STR(nFWeight,8,1)
		IF UPPER(cMach) = "HEAT TREAT" 
			cSQL = cSQL + ",'HEAT TREAT'"		&&Condition
		ELSE
			cSQL = cSQL + ",'Cold Red'"			&&Condition
		ENDIF
		IF UPPER(cMach) != "HEAT TREAT" 
			cSQL = cSQL + ","+STR(nCW/100,3,3)+""	&&ColdWork
		ENDIF
		cSQL = cSQL + ",'"+cFDescript+"'"		&&Spec
		cSQL = cSQL + ","+STR(nSalesNum)+","+STR(nItemSO,2,0)+",'"+cSOitem+"'"
		cSQL = cSQL + ",'"+PrepareSQLtxt(cLotNotes,'Notes',-1)+"'" 					 &&Notes
		cSQL = cSQL + ","+STR(nWO)+","+STR(nWO_Detail)+","+STR(nStock_Projected_ID)
		cSQL = cSQL + ")"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			RETURN .F.
		ELSE
		
			ThisFormSet.SaveMachLot( cMach, nLot, nWO_Detail )
			
			*DO FORM Forms\ShowvGFMlog WITH nLot, cAlloy	
			*DO FORM Forms\GFMlog WITH nLot
			*MESSAGEBOX("No functioning yet.",64,"No")
			
			DO CASE
			CASE UPPER(cMach) = "DRAW BENCH" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Draw log Lot "+ALLTRIM(STR(nLot)),0,"Done")
			CASE UPPER(cMach) = "GFM" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the GFMlog Lot "+ALLTRIM(STR(nLot)),0,"Done")
		*			ThisFormSet.ShowGFMlog(PrepareSQLnum(nLot,'Lot',-3))
			CASE UPPER(cMach) = "HEAT TREAT" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Heat Treat log Lot "+ALLTRIM(STR(nLot)),0,"Done")
			CASE UPPER(cMach) = "OPEN DIE" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Lake Erie log Lot "+ALLTRIM(STR(nLot)),0,"Done")
		
			CASE UPPER(cMach) = "ROLLING"
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Roll_log Lot "+ALLTRIM(STR(nLot)),0,"Done")
			CASE UPPER(cMach) = "SWAGE"
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Swage_log Lot "+ALLTRIM(STR(nLot)),0,"Done")
		*			ThisFormSet.ShowSwage_log(PrepareSQLnum(nLot,'Lot',-3))
			CASE UPPER(cMach) = "WIRE DRAW" 
				MESSAGEBOX("Now Open another HPA App session"+CHR(13)+"Edit the Wire_log Lot "+ALLTRIM(STR(nLot)),0,"Done")
		*			ThisFormSet.ShowWire_log(PrepareSQLnum(nLot,'Lot',-3))
			ENDCASE
		
		
			
		ENDIF
		
		*********
		
		
	ENDPROC

	PROCEDURE cmdFcalc.Click
		ThisFormSet.Calc_Weight('FINISH',.F.)
	ENDPROC

	PROCEDURE cmdFinishshow.Click
		PRIVATE cMach, nLot, cLot, cAlloy,nfThick 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'Mach',20)
		nLot	= PrepareSQLnum(ThisForm.txtFinishLot.Value,'Lot',-3)
		cLot	= PrepareSQLtxt(ThisForm.txtFinishLot.Value,'Lot',10)
		*cAlloy	= PrepareSQLtxt(ThisForm.txtfAlloy.Value,'Alloy',12)
		*nfThick = PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',10,4)
		
		IF EMPTY(cMach)
			MESSAGEBOX("You must Declare the Maching before inserting a new LOT",16,"Unknown machine")
			RETURN .F.
		ENDIF
		*!*	IF nfThick=0 OR EMPTY(cAlloy)
		*!*		MESSAGEBOX("Please fill in more the 'Finish' WO_Detail so a good insert log can be made.",16,"Unknown machine")
		*!*		RETURN .F.
		*!*	ENDIF
		
		DO CASE
		*Conversion_Log
		*Draw_Log
		CASE UPPER(LEFT(cMach,1)) = "D"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		*GFMLog
		CASE UPPER(LEFT(cMach,1)) = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		*HT_Lot
		*LakeErie_log
		CASE UPPER(LEFT(cMach,1)) = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		*Roll_log
		CASE UPPER(LEFT(cMach,1)) = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		*Swage_log	
		CASE UPPER(LEFT(cMach,1)) = "S"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		*Wire_log
		CASE UPPER(LEFT(cMach,1)) = "W"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		OTHERWISE
			MESSAGEBOX("Unknown Machine",16,"Unknown machine")
			RETURN .F.
		ENDCASE
		
		
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_MFG_Log(cMach,nLot,.T.)
		
		IF NOT EMPTY(m.cHyperLink)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			WAIT WINDOW "No Report to display" NOWAIT
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE cmdFollowShow.Click
		PRIVATE cMach, nLot, cLot, cAlloy,nfThick 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFollowM.Value,'Mach',20)
		nLot	= PrepareSQLnum(ThisForm.txtFollowLot.Value,'Lot',-3)
		cLot	= PrepareSQLtxt(ThisForm.txtFollowLot.Value,'Lot',10)
		*cAlloy	= PrepareSQLtxt(ThisForm.txtfAlloy.Value,'Alloy',12)
		*nfThick = PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',10,4)
		
		IF EMPTY(cMach)
			MESSAGEBOX("You must Declare the Maching before inserting a new LOT",16,"Unknown machine")
			RETURN .F.
		ENDIF
		
		DO CASE
		*Conversion_Log
		
		*Draw_Log
		CASE UPPER(cMach) = "DRAW BENCH"  
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "D"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		*GFMLog
		CASE UPPER(cMach) = "GFM" 
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		CASE UPPER(cMach) = "HEAT TREAT" 
		*HT_Lot
		
		*LakeErie_log
		CASE UPPER(cMach) = "OPEN DIE" 
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		*Roll_log
		CASE UPPER(cMach) = "ROLLING"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		*Swage_log	
		CASE UPPER(cMach) = "SWAGE"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "S"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		*Wire_log
		CASE UPPER(cMach) = "WIRE DRAW" 
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		CASE UPPER(LEFT(cMach,1)) = "W"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		OTHERWISE
			MESSAGEBOX("Unknown Machine",16,"Unknown machine")
			RETURN .F.
		ENDCASE
		
		
			
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_MFG_Log(cMach,nLot,.T.)
		
		IF NOT EMPTY(m.cHyperLink)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			WAIT WINDOW "No Report to display" NOWAIT
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE cmdRA.Valid
		ThisFormSet.frmRedArea.Visible = .T.
		
		ThisFormSet.frmRedArea.Top = ThisForm.Top
		*ThisFormSet.frmRedArea.Left = ThisForm.Left + ThisForm.Width
		ThisFormSet.frmRedArea.Left = ThisForm.shpDivide.Left
		
		PRIVATE nThck, nSz2, nFthck, nFSz2
		nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',14,4)
		nSz2		= PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',13,3)
		
		nFthck		= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisForm.txtFSz2.Value,'Sz2',13,3)
		
		PRIVATE nStartSize, nCW, nRoughSize, nOverSize
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		IF nThck> 0
			ThisFormSet.frmRedArea.txtD123.Value = nThck
		ENDIF
		IF nSz2 > 0
			ThisFormSet.frmRedArea.txtL124.Value = nSz2
		ENDIF
		IF nFthck > 0
			ThisFormSet.frmRedArea.txtD225.Value = nFthck 
		ENDIF
		IF nFSz2 > 0
			ThisFormSet.frmRedArea.txtL226.Value = nFSz2 
		ENDIF
		
		IF nStartSize>0 AND ( nCW>0 OR nRoughSize>0 )
			ThisFormSet.frmRedArea.txtD123.Value = nStartSize
			IF nRoughSize > 0
				ThisFormSet.frmRedArea.txtD225.Value = nRoughSize
			ENDIF	
			IF nCW > 0
				ThisFormSet.frmRedArea.txtRA36.Value = nCW
			ENDIF
		ENDIF
		
		ThisFormSet.frmRedArea.txtD123.SetFocus()
	ENDPROC

	PROCEDURE cmdResetCW.Click
		PRIVATE nThck, nfThck, nStartSize, nCW, nCWp, nRoughSize
		nThck		= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',8,3)
		nfThck		= PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',8,3)
		*nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		*nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		*nCWp		= 1+(nCW/100)
		*nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nStartSize = nThck
		IF nThck > 0 &&AND nCW = 0
			ThisForm.txtStartSize.Value = nThck
		ENDIF
		
		nRoughSize = nfThck
		IF nfThck > 0
			ThisForm.txtRoughSize.Value = nfThck
		ENDIF
		
		
		IF nStartSize > 0
			IF nRoughSize > 0
				*FIND RA BY DIA'S    (ORIG-FINAL)/ORIG=%
				*M.A1= 3.14156*M.sD1*M.sD1/4
				*M.A2= 3.14156*M.sD2*M.sD2/4
				*M.sRA = (M.A1-M.A2)/M.A1
				nCWp = ((3.14156*nStartSize*nStartSize/4)-(3.14156*nRoughSize*nRoughSize/4))/(3.14156*nStartSize*nStartSize/4)
				nCW = ROUND(nCWp * 100,0)
				ThisForm.txtCW.Value = PrepareSQLnum(nCW,'CW',2,0)
			ENDIF
		ENDIF
		
	ENDPROC

