	PROCEDURE txtRoughSize.Valid
		PRIVATE nRoughSize, nFThck, nOverSize
		nRoughSize  = PrepareSQLnum(This.Value,'nRoughSize',8,3)
		nFThck		= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',9,4)
		nOverSize 	= nRoughSize - nFThck
		
		IF nOverSize > 0 AND nFThck > 0
			ThisForm.txtOverSize.Value = nOverSize
		ENDIF
	ENDPROC

	PROCEDURE txtStock_Projected_ID.Valid
		PRIVATE nStock_Projected_ID
		nStock_Projected_ID = PrepareSQLnum(This.Value,'Stock_Projected_ID',-3)
		ThisFormSet.nStock_Projected_ID = nStock_Projected_ID
		
		ThisFormSet.Refresh_Projected()
	ENDPROC

	PROCEDURE txtWO.DblClick
		PRIVATE nWO
		nWO = PrepareSQLnum(This.Value,'WO',-3)
		
		
		IF nWO > 0
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO(nWO,.T.)
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
			
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		
		ENDIF
	ENDPROC

