	PROCEDURE checksavedetail
		PRIVATE lOK
		lOK = .T.
		
		*****************************
		PRIVATE cFinishM, nFinishLot
		cFinishM	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisForm.txtFinishLot.Value,'FinishLot',-3)
		
		IF nFinishLot > 0
		*	MESSAGEBOX("Make sure you also apply updates to "+cFinishM+" lot "+ALLTRIM(STR(nFinishLot)),64,"Found a Lot")
		ENDIF
		
		*****************************
		*Test CW
		PRIVATE nStartSize,nRoughSize,nCW,nOverSize,nCWp
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'CW',8,3)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'CW',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',2,0)
		nOverSize 	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		IF nStartSize > 0 AND nRoughSize > 0 AND nCW > 0
			nCWp = ((3.14156*nStartSize*nStartSize/4)-(3.14156*nRoughSize*nRoughSize/4))/(3.14156*nStartSize*nStartSize/4)
			nCWcalc = ROUND(nCWp * 100,0)
			IF nCW = nCWcalc 
				*Good
			ELSE
				*Bad
				MESSAGEBOX("The CW between Starting Size to Rough Size"+"Does not add up."+CHR(13)+"CW should be:"+STR(nCWcalc,2,0)+CHR(13)+"CW is listed as:"+STR(nCW,2,0),16,"Math is Off.")
				*lOK = .F.
			ENDIF
		ENDIF
		
		*****************************
		
		PRIVATE nWO_Detail
		nWO_Detail	= PrepareSQlnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		*****************************
		*Check weight
		PRIVATE nWO_LB, nCurWOD_LB, nOthrWOD_LB, nTotF_LB
		*nWO_LB 		= PrepareSQLnum(ThisForm.txtWeight.Value,'Weight',9,1)
		nCurWOD_LB	= PrepareSQLnum(ThisForm.txtfWeight.Value,'Weight',9,1)
		*nOthrWOD_LB	= get_Total_WO_Detail_Weight(nWO,nWO_Detail,ThisFormSet.nConnhandle )
		nTotF_LB	= PrepareSQLnum(ThisForm.txtTotFinishW.Value,'Weight',9,1)
		
		
		
		*lOK = .F. ???
		
		
		
		
		*****************************
		*Check OverSize
		PRIVATE nfThck, nRoughSize, nOverSize
		nfThck		= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',8,3)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		IF nOverSize = 0
			IF nRoughSize > 0 AND nfThck > 0 AND nRoughSize > nfThck 
				nOverSize = nRoughSize - nfThck
				ThisForm.txtOverSize.Value = PrepareSQLnum(nOverSize,'OverSize',5,3)
			ENDIF
		ELSE
			IF nRoughSize = 0
				IF nfThck > 0 
					nRoughSize = nOverSize + nfThck
					ThisForm.txtRoughSize.Value = PrepareSQLnum(nRoughSize,'RoughSize',8,3)
				ENDIF
			ELSE
				*have OverSize and RoughSize
				IF nfThck = 0
					nfThck = nRoughSize - nOverSize 
					ThisForm.txtFThck.Value = PrepareSQLnum(nfThck,'Thck',8,3)
				ENDIF
			ENDIF
		ENDIF
		
		***Check if numbers add up.
		IF nOverSize > 0
			PRIVATE nCalcRoughSize, nCalcfThck
			IF nRoughSize > 0
				nCalcfThck = nRoughSize - nOverSize 
			ENDIF
			IF nfThck > 0
				nCalcRoughSize = nfThck + nOverSize 
			ENDIF
			
			IF nRoughSize > 0 AND nfThck > 0
				IF (nCalcfThck+10)*.9 < (nfThck+10) OR (nCalcfThck+10) > (nfThck+10)*.9
					*Within 10%
				ELSE
					MESSAGEBOX("Thck/Diameter "+ALLTRIM(STR(nfThck,9,3))+CHR(13)+" is more than 10% different than "+CHR(13)+" RoughSize - OverSize "+ALLTRIM(STR(nCalcfThck,9,3))+CHR(13)+"Please correct one of these numbers.",0+48,"Numbers do not Calculate.")
					*lOK = .F. ???
				ENDIF
				
				IF (nCalcRoughSize+10)*.9 < (nRoughSize+10) OR (nCalcRoughSize+10) > (nRoughSize+10)*.9
					*Within 10%
				ELSE
					MESSAGEBOX("Rough Size "+ALLTRIM(STR(RoughSize,9,3))+CHR(13)+" is more than 10% different than "+CHR(13)+" Thck + OverSize "+ALLTRIM(STR(nCalcRoughSize,9,3))+CHR(13)+"Please correct one of these numbers.",0+48,"Numbers do not Calculate.")
					*lOK = .F. ???
				ENDIF
				
			ENDIF
		ENDIF
		
		
		
		**********
		RETURN lOK 
	ENDPROC

	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		nColor = RGB( 255, 255, 255 ) &&WHITE
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pnWO_Detail, nTop, nLeft
		*DO FORM Forms\WO_Detail_Notes WITH nWO_Detail 
		*frmWO_Detail_Notes
		
		*!*	IF VARTYPE(pConn) = "N"
		*!*		ThisForm.nConnHandle = pConn
		*!*	ENDIF
		*!*	IF EMPTY(ThisForm.nConnHandle)
		*!*		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		*!*	ENDIF
		
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pnWO_Detail,'WO_Detail',-3)
		
		****
		IF VARTYPE(nTop) = "N"
			ThisForm.Top = nTop
		ENDIF
		IF VARTYPE(nLeft) = "N"
			ThisForm.Left = nLeft + 15
		ENDIF
		
		
		****
		PRIVATE lFound_WOD 
		lFound_WOD = .F.
		
		IF USED('tmpWO_DetailN')	
			USE IN tmpWO_DetailN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		cSQL = "SELECT WOD.*"
		cSQL = cSQL +" FROM dbo.WorkOrder_Detail WOD "
		cSQL = cSQL +" WHERE WOD.WO_Detail ="+STR(nWO_Detail)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_DetailN')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmpWO_DetailN')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_DetailN")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_DetailN")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpWO_DetailN')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpWO_DetailN')
				IF RECCOUNT('tmpWO_DetailN') > 0
					SELECT tmpWO_DetailN
					LOCATE FOR WO_Detail = nWO_Detail
					IF FOUND()
						lFound_WOD = .T.
					ELSE
						GO TOP
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('tmpWO_DetailN') AND lFound_WOD 
			IF FOUND('tmpWO_DetailN')
				ThisForm.txtWO_Detail.Value = nWO_Detail
				
				ThisForm.txtWO.Value = PrepareSQLnum(tmpWO_DetailN.WO,'WO',-3)
				
				ThisForm.txtFPieces.Value	= PrepareSQLnum(tmpWO_DetailN.fPieces,'Pieces',-3)
				ThisForm.txtFAlloy.Value	= PrepareSQLtxt(tmpWO_DetailN.fAlloy,'Alloy',12)
				ThisForm.cmbFForm.Value		= PrepareSQLtxt(tmpWO_DetailN.fForm,'Form',2)
				*ThisFormSet.RefreshFForms(tmpWO_DetailN.fForm)
				ThisForm.cmbFcc.Value		= PrepareSQLtxt(tmpWO_DetailN.fCC,'CC',1)
				*ThisFormSet.InitcmbFCL()
		
				ThisForm.cmbFCL.Value		= PrepareSQLtxt(tmpWO_DetailN.fCL,'CL',1)
				ThisForm.txtFThck.Value		= PrepareSQLnum(tmpWO_DetailN.fThck,'Thck',10,4)
				ThisForm.txtFSz2.Value		= PrepareSQLnum(tmpWO_DetailN.fSz2,'Sz2',9,3)
				ThisForm.txtFSz3.Value		= PrepareSQLnum(tmpWO_DetailN.fSz3,'Sz3',9,3)
				ThisForm.chkPinFWeight.Value	= PrepareSQLchk(tmpWO_DetailN.pinFWeight,'pinFWeight')
				ThisForm.txtFWeight.Value 	= PrepareSQLnum(tmpWO_DetailN.fWeight,'Weight',9,1)
		
				ThisForm.txtFSpec.Value		= PrepareSQLtxt(tmpWO_DetailN.fSpec,'FSpec',50)
		
				ThisForm.txtStock_Projected_ID.Value = PrepareSQLnum(tmpWO_DetailN.Stock_Projected_ID,'Stock_Projected_ID',-3)
		
				*ThisFormSet.Refresh_Projected()
				
				ThisForm.txtFID_Detail.Value = PrepareSQLnum(tmpWO_DetailN.fID_Detail,'ID_Detail',-3)
				IF PrepareSQLnum(tmpWO_DetailN.fID_Detail,'ID_Detail',-3) > 0
					ThisForm.txtFID_Detail.BackColor = RGB(0,128,255)
				ELSE
					ThisForm.txtFID_Detail.BackColor = RGB(240,240,240)
				ENDIF	
				ThisForm.txtFID_Detail_Process.Value = PrepareSQLnum(tmpWO_DetailN.fID_Detail_Process,'ID_Detail_Process',-3)
				ThisForm.txtfTBL.Value 			= PrepareSQLtxt(tmpWO_DetailN.fTBL,'TBL',1)
				ThisForm.txtfReceivingID.Value 	= PrepareSQLnum(tmpWO_DetailN.fReceivingID,'ReceivingID',-3)
				
				*ThisForm.txtAC_ID_WOD.Value	= PrepareSQLnum(tmpWO_DetailN.AC_ID_WOD,'AC_ID',-3)
				
				ThisForm.txtFSOitem.Value	= PrepareSQLtxt(tmpWO_DetailN.fSOitem,'SOitem',10)
				ThisForm.txtFPOitem.Value	= PrepareSQLtxt(tmpWO_DetailN.fPOitem,'POitem',12)
				
				ThisForm.txtFDescript.Value	= PrepareSQLtxt(tmpWO_DetailN.fDescript,'Descript',100)
				ThisForm.txtfCondLevel.Value= PrepareSQLtxt(tmpWO_DetailN.fCondLevel,'fCondLevel',30)
				
				ThisForm.cmbFollowM.Value	= PrepareSQLtxt(tmpWO_DetailN.FollowM,'FollowM',20)
				ThisForm.txtFollowLot.Value	= PrepareSQLnum(tmpWO_DetailN.FollowLot,'FollowLot',-3)
				ThisForm.cmbFinishM.Value	= PrepareSQLtxt(tmpWO_DetailN.FinishM,'FinishM',20)
				ThisForm.txtFinishLot.Value	= PrepareSQLnum(tmpWO_DetailN.FinishLot,'FinishLot',-3)
				
				ThisForm.txtTestPO.Value	= PrepareSQLtxt(tmpWO_DetailN.TestPO,'POitem',12)
				
				ThisForm.txtStartSize.Value	= PrepareSQLnum(tmpWO_DetailN.StartSize,'StartSize',8,3)
				ThisForm.txtCW.Value		= PrepareSQLnum(tmpWO_DetailN.CW,'CW',-1)
				ThisForm.txtRoughSize.Value = PrepareSQLnum(tmpWO_DetailN.RoughSize,'RoughSize',8,3)
				ThisForm.txtOverSize.Value	= PrepareSQLnum(tmpWO_DetailN.OverSize,'OverSize',5,3)
				
				ThisForm.edtfNotes.Value	= PrepareSQLtxt(tmpWO_DetailN.fNotes,'Notes',-1)
				
			
				ThisForm.txtFDueDate.Value	= PrepareSQLdate(tmpWO_DetailN.fDueDate,'DueDate')
				ThisForm.cmbNextCode.Value	= PrepareSQLtxt(tmpWO_DetailN.NextCode,'NextCode',3)
				ThisForm.txtNextNumber.Value = PrepareSQLtxt(tmpWO_DetailN.NextNumber,'NextNumber',10)
		
				
				ThisForm.chkfCmplt.Value 	= PrepareSQLchk(tmpWO_DetailN.fCmplt,'fCmplt')
				ThisForm.chkfCncld.Value	= PrepareSQLchk(tmpWO_DetailN.fCncld,'fCncld')
				
				ThisForm.chkStkListed.Value = PrepareSQLchk(tmpWO_DetailN.StkListed,'StkListed')
				
				*************************************		
				*ThisformSet.Refresh_frmWorkOrder_FPOitem(tmpWO_DetailN.fPOitem)
		
				*IF ThisFormSet.CheckFinish_ID_Detail()
				*ENDIF
				*IF ThisFormSet.CheckFinish_ID_Detail_Process()
				*ENDIF
				
				**********
				*ThisForm.lstWO_Detail.Value = RECNO('tmpWO_DetailN')
				*ThisForm.lstWO_Detail.Value = ASCAN(gaWO_Detail, nWO_Detail)  &&gaWO_Detail was empty!!
				
				*ThisForm.lstWO_Detail.Visible = .T.
				
				*ThisFormSet.Show_frmStock_Produced(nWO_Detail)
				
				
			ELSE
				MESSAGEBOX("Could not find WO_Detail:"+ALLTRIM(STR(nWO_Detail)),0,"Error")
			ENDIF
			
		ENDIF
			
		
		************
		ThisForm.Visible = .T.
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE refreshlinenumber
		*ThisForm.RefreshLineNumber()
		
		ThisForm.lblRecord.Caption = "Line "+ALLTRIM(STR(RcvPOi.Line))+" of "+ALLTRIM(STR(ThisForm.nRecTotal))
		
	ENDPROC

	PROCEDURE refresh_rcv
		*ThisForm.Refresh_RCV()
		
		IF USED('RcvPOi')
			SELECT RcvPOi
				
			ThisForm.lblCancelled.Visible 	= PrepareSQLlogic(RcvPOi.Cancelld ,'Cancelled')
			ThisForm.txtPOitem.Value 	= PrepareSQLtxt(RcvPOi.POitem,'POitem',12)
			
			DO CASE
			CASE RcvPOi.TBL = "R"
				ThisForm.txtTable.Value 		= "Table: Receving ID"
			CASE RcvPOi.TBL = "S"
				ThisForm.txtTable.Value 		= "Table: Stock"
			CASE RcvPOi.TBL = "B"
				ThisForm.txtTable.Value 		= "Table: Broker"
			CASE RcvPOi.TBL = "W"
				ThisForm.txtTable.Value 		= "Work in Progress"
			CASE RcvPOi.TBL = "H"
				ThisForm.txtTable.Value 		= "Deleted History Table"
			OTHERWISE
				ThisForm.txtTable.Value 		= ""
			ENDCASE
			ThisForm.txtTBL.Value		= PrepareSQLtxt(RcvPOi.TBL,'TBL',1)
			ThisForm.txtWO_Detail.Value = PrepareSQLnum(RcvPOi.WO_Detail,'WO_Detail',-3)
			ThisForm.txtID_D_P.Value 	= PrepareSQLnum(RcvPOi.ID_D_P,'ID_D_P',-3)
			ThisForm.txtHeat.Value 		= PrepareSQLtxt(RcvPOi.Heat,'Heat',50)
		
			ThisForm.txtS_QTY.Value 	= PrepareSQLnum(RcvPOi.Acct_QTY,'S_QTY',-5)
			ThisForm.txtS_PU.Value 		= PrepareSQLnum(RcvPOi.Acct_PU,'S_PU',-1)
			
				
			ThisForm.txtPieces.Value	= PrepareSQLnum(RcvPOi.Pieces,'Pieces',-3)
			ThisForm.txtRID.Value		= PrepareSQLnum(RcvPOi.RID,'RID',-3)
			ThisForm.txtPounds.Value	= PrepareSQLnum(RcvPOi.Pounds,'Pounds',9,1)
			
			ThisForm.txtDescript.Value	= PrepareSQLtxt(RcvPOi.Description,'Description',150)
			ThisForm.txtSpecs.Value 	= PrepareSQLtxt(RcvPOi.Specs,'Specs',150)
			ThisForm.txtComments.Value	= PrepareSQLtxt(RcvPOi.Comments,'Comments',150)
			
			DO CASE
			CASE RcvPOi.Heat = "DUE IN"
				ThisForm.lblIncoming.Visible = .T.
				ThisForm.cmdIncoming.Visible = .T.
				ThisForm.cmdSelect.Visible = .F.
			CASE RcvPOi.TBL = "R"
				ThisForm.lblIncoming.Visible = .F.
				ThisForm.cmdIncoming.Visible = .F.
				ThisForm.cmdSelect.Visible = .T.
			CASE RcvPOi.ID_D_P > 0
				ThisForm.lblIncoming.Visible = .T.
				ThisForm.cmdIncoming.Visible = .T.
				ThisForm.cmdSelect.Visible = .F.
			OTHERWISE
				ThisForm.lblIncoming.Visible = .F.
				ThisForm.cmdIncoming.Visible = .F.
				ThisForm.cmdSelect.Visible = .F.
			ENDCASE
		
		ENDIF
	ENDPROC

	PROCEDURE save_wo_detail
		*ThisForm.Save_WO_Detail()
		
		IF NOT ThisForm.CheckSaveDetail()
			RETURN .F.
		ENDIF
		
		PRIVATE nWO, nWO_Detail
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cFAlloy,cFForm,cFCC,cFCL,nFPieces,nFThck,nFSz2,nFSz3,lpinFWeight,nFWeight,cFSpec
		nFPieces	= PrepareSQLnum(ThisForm.txtFPieces.Value,'Pieces',-3)
		cFAlloy		= PrepareSQLtxt(ThisForm.txtFAlloy.Value,'Alloy',12)
		cFForm		= PrepareSQLtxt(ThisForm.cmbFForm.Value,'Form',2)
		cFCC		= PrepareSQLtxt(ThisForm.cmbFCC.Value,'CC',1)
		cFCL		= PrepareSQLtxt(ThisForm.cmbFCL.Value,'CL',1)
		nFthck		= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',14,4)
		nFSz2		= PrepareSQLnum(ThisForm.txtFSz2.Value,'Sz2',13,3)
		nFSz3		= PrepareSQLnum(ThisForm.txtFSz3.Value,'Sz3',13,3)
		lpinFWeight	= PrepareSQLlogic(ThisForm.chkPinFWeight.Value,'pinFWeight')
		nFWeight	= PrepareSQLnum(ThisForm.txtFWeight.Value,'Weight',9,1)
		cFSpec 		= PrepareSQLtxt(ThisForm.txtFSpec.Value,'FSpec',50)
						
		PRIVATE cFDescript, cfCondLevel, cFollowM, nFollowLot, cFinishM, nFinishLot, cTestPO
		cFDescript	= PrepareSQLtxt(ThisForm.txtFdescript.Value,'Fdescript',100)
		cfCondLevel = PrepareSQLtxt(ThisForm.txtfCondLevel.Value,'fCondLevel',30)
		cFollowM	= PrepareSQLtxt(ThisForm.cmbFollowM.Value,'FollowM',20)
		nFollowLot	= PrepareSQLnum(ThisForm.txtFollowLot.Value,'FollowLot',-3)
		cFinishM	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'FinishM',20)
		nFinishLot	= PrepareSQLnum(ThisForm.txtFinishLot.Value,'FinishLot',-3)
		cTestPO		= PrepareSQLtxt(ThisForm.txtTestPO.Value,'POitem',12)
		PRIVATE cFSOitem, cFPOitem
		cFSOitem	= PrepareSQLtxt(ThisForm.txtFSOitem.Value,'SOitem',10)
		cFPOitem	= PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		
		PRIVATE dfDueDate, nWO_Detail, cfTBL, nFID_Detail, nFID_Detail_Process
		dfDueDate	= PrepareSQLDate(ThisForm.txtfDueDate.Value,'DueDate')
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		IF nWO_Detail = 0
		*	nWO_Detail = 0
		ENDIF
		cfTBL		= ''
		nFID_Detail	= PrepareSQLnum(ThisForm.txtFID_Detail.Value,'ID_Detail',-3)
		nFID_Detail_Process	= PrepareSQLnum(ThisForm.txtFID_Detail_Process.Value,'ID_Detail_Process',-3)
		PRIVATE cNextCode, cNextNumber
		cNextCode 	= PrepareSQLtxt(ThisForm.cmbNextCode.Value,'NextCode',3)
		cNextNumber	= PrepareSQLtxt(ThisForm.txtNextNumber.Value,'NextNumber',10)
		 
		PRIVATE nfReceivingID, lfCmplt
		nfReceivingID	= PrepareSQLnum(ThisForm.txtfReceivingID.Value,'RecevingID',-3)
		*lIntP		= PrepareSQLlogic(ThisForm.chkIntP.Value,'IntP')  &&Used on WO and WO_Detail
		lfCmplt		= PrepareSQLlogic(ThisForm.chkfCmplt.Value,'fCmplt')
		
		*!*	PRIVATE lfPrint, lfPRecv, lfMod, nfRev
		*!*	lfPrint	= PrepareSQLlogic(ThisForm.chkfPrint.Value,'fPrint')
		*!*	lfPRecv	= PrepareSQLlogic(ThisForm.chkfpRecv.Value,'fPRecv')
		*!*	lfMod	= PrepareSQLlogic(ThisForm.chkfMod.Value,'fMod')
		*!*	nfRev	= PrepareSQLnum(ThisForm.txtfRev.Value,'fRev',-1)
		
		PRIVATE cFNotes, nStock_Projected_ID, lfCncld, lStkListed
		cFNotes		= PrepareSQLtxt(ThisForm.edtfNotes.Value,'Notes',-1)
		nStock_Projected_ID	= PrepareSQLnum(ThisForm.txtStock_Projected_ID.Value,'Stock_Projected_ID',-3)
		lfCncld		= PrepareSQLlogic(ThisForm.chkfCncld.Value,'fCncld')
		lStkListed	= PrepareSQLlogic(ThisForm.chkStkListed.Value,'StkListed')
		
		PRIVATE cfCondLevel, nStartSize, nCW, nRoughSize, nOverSize
		cfCondLevel	= PrepareSQLtxt(ThisForm.txtfCondLevel.Value,'fCondLevel',30)
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		
		PRIVATE lWO_DetailExists
		lWO_DetailExists = .F.
		
		PRIVATE cSQL, nSQLEXEC 
		
		*******************
		
		PRIVATE lOK
		lOK = .T.
		
		
		********
		IF nWO_Detail > 0
			*Check WO_Detail Past
				
			*DID lCncld change, is this allowed?
			IF lfCncld 
				*is now Cancelled
				IF Count_WODinWO_detail( nWO_Detail, ThisForm.nConnHandle, "CANCELLED" ) > 0 &&was already cancelled
					*no change
				ELSE
					*Try to mark as Cancelled
					*
				ENDIF	
			ELSE
				*is not Cancelled
				IF Count_WODinWO_detail( nWO_Detail, ThisForm.nConnHandle, "CANCELLED" ) > 0 &&was already cancelled
					*Try to mark as NOT Cancelled
					*
				ELSE
					*no change
				ENDIF	
			ENDIF
		
			*DID lCmplt change, is this allowed?
			IF lfCmplt 
				*is now Complete
				IF Count_WODinWO_detail( nWO_Detail, ThisForm.nConnHandle, "COMPLETE" ) > 0 &&was already Complete
					*no change
				ELSE
					*Try to mark as Complete
					*
				ENDIF	
			ELSE
				*is not Complete
				IF Count_WODinWO_detail( nWO_Detail, ThisForm.nConnHandle, "COMPLETE" ) > 0 &&was already Complete
					*Try to mark as NOT Complete
					*
				ELSE
					*no change
				ENDIF	
			ENDIF
		ENDIF
		
		*****************
		*End Check
		IF NOT lOK
			RETURN .F.
		ENDIF
		*****************
		*Ready for Save.
		
		
		
		IF nWO_Detail > 0
			*The p_WorkOrder_Detail_Ins create the record, now update
			
			cUpdate = "UPDATE dbo.WorkOrder_Detail SET"
			cUpdate = cUpdate + " fStartDate=GetDate()"
		    cUpdate = cUpdate + ",fDueDate='"+IIF(EMPTY(dfDueDate),'',DTOC(dfDueDate))+"'"
		    cUpdate = cUpdate + ",fDescript='"+cFDescript+"'"
		
			cUpdate = cUpdate + ",fSOitem = dbo.f_ProperSOitem('"+cFSoItem+"')"
			cUpdate = cUpdate + ",fPOitem = dbo.f_ProperPOitem('"+cFPoItem+"')"
		    cUpdate = cUpdate + ",fPieces="+STR(nFPieces,7,0)+""
		    cUpdate = cUpdate + ",fAlloy='"+cFAlloy+"'"
		    cUpdate = cUpdate + ",fForm='"+cFForm+"'"
		    cUpdate = cUpdate + ",fCC='"+cFCC+"'"
		    cUpdate = cUpdate + ",fCL='"+cFCL+"'"
		    cUpdate = cUpdate + ",fThck="+STR(nFThck,10,4)+""
		    cUpdate = cUpdate + ",fSz2="+STR(nFSZ2,9,3)+""
		    cUpdate = cUpdate + ",fSz3="+STR(nFSz3,9,3)+""
		    cUpdate = cUpdate + ",fWeight="+STR(nFWeight,8,1)+""
		    cUpdate = cUpdate + ",pinFWeight="+IIF(lpinFWeight,'1','0')
		    cUpdate = cUpdate + ",fTBL='"+cfTBL+"'"
		    cUpdate = cUpdate + ",fID_Detail="+STR(nFID_Detail)+""
		    cUpdate = cUpdate + ",fID_Detail_Process="+STR(nFID_Detail_Process)+""
		    cUpdate = cUpdate + ",fReceivingID="+STR(nfReceivingID)+""
		*    cUpdate = cUpdate + ",fIntP="+IIF(lIntP,'1','0')
		    cUpdate = cUpdate + ",fNotes='"+cfNotes+"'"
		    cUpdate = cUpdate + ",fCondLevel='"+cfCondLevel+"'"
		    cUpdate = cUpdate + ",fCncld="+IIF(lfCncld,'1','0')
		    
		*    cUpdate = cUpdate + ",fPrint=0"
		*    cUpdate = cUpdate + ",fPRecv=0"
		*    *cUpdate = cUpdate + ",fMod=0"
		*    cUpdate = cUpdate + ",fRev="+STR(nfRev)
		    
		    cUpdate = cUpdate + ",StkListed="+IIF(lStkListed,'1','0')
		    cUpdate = cUpdate + ",Stock_Projected_ID="+STR(nStock_Projected_ID)+""
		    
		    cUpdate = cUpdate + ",FollowM='"+cFollowM+"'"
		    cUpdate = cUpdate + ",FollowLot="+STR(nFollowLot)
		    cUpdate = cUpdate + ",FinishM='"+cFinishM+"'"
		    cUpdate = cUpdate + ",FinishLot="+STR(nFinishLot)
		    
		    cUpdate = cUpdate + ",StartSize="+STR(nStartSize,8,3)
		    cUpdate = cUpdate + ",CW="+STR(nCW,2,0)
		    cUpdate = cUpdate + ",RoughSize="+STR(nRoughSize,8,3)
		    cUpdate = cUpdate + ",OverSize="+STR(nOverSize,5,3)
		    cUpdate = cUpdate + ",FSpec='"+cFSpec+"'"  
		    cUpdate = cUpdate + ",TestPO = dbo.f_ProperPOitem('"+cTestPO+"')"
		 *   cUpdate = cUpdate + ",RcvdE="+IIF(lRcvdE,'1','0')
		    cUpdate = cUpdate + ",NextCode='"+cNextCode+"'"
		    cUpdate = cUpdate + ",NextNumber='"+cNextNumber+"'"
		  
		 	cUpdate = cUpdate + " WHERE WO_Detail= "+STR(nWO_Detail)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cUpdate )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cUpdate )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cUpdate, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cUpdate, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cUpdate, ThisForm.nConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cUpdate )
			ELSE
			
				***********************************************
				*Remove WO from All Sales records, then add back if real SOitem.
				
		*		ThisForm.txtTotFinishW.Value = ThisForm.TotalFinishWeight(nWO)
				
				WAIT WINDOW "Saved Work Order Detail "+ALLTRIM(STR(nWO_Detail))+" !" NOWAIT
				
			ENDIF
			
		*!*		***********************************************
		*!*		ThisForm.chkfPrint.Value	= 0
		*!*		ThisForm.chkfpRecv.Value	= 0
		*!*		ThisForm.chkfMod.Value		= 1
		
		*!*		*************************************
		*!*		PRIVATE lComplete, lCancelled,  nWO_Detail
		*!*		lComplete 	= PrepareSQLlogic(ThisForm.chkfCmplt.Value,'fCmplt')
		*!*		lCancelled	= PrepareSQLlogic(ThisForm.chkfCncld.Value,'fCncld')	
		*!*		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		
		*!*		IF NOT ( lCancelled OR lComplete )
		*!*			
		*!*			cSQL = "UPDATE dbo.WorkOrder_Detail SET fPrint=0, fPRecv=0, fMod=1 WHERE WO_Detail = "+STR(nWO_Detail)
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, '')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
		*!*				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		*!*			ENDIF
				
		*!*			ThisForm.chkfPrint.Value	= .F.
		*!*			ThisForm.chkfpRecv.Value	= .F.
		*!*			ThisForm.chkfMod.Value		= .T.
		*!*		ENDIF
			
			
		*!*		ThisForm.Save_WOD_Incm_Prc(nWO_Detail)
		*!*		
		*!*		
		*!*		*************************************
		*!*		
		*!*		ThisForm.Refresh_lstWO_Detail(nWO_Detail)
		*!*		
		*!*		*************************************
		*!*		
		*!*		IF LEN(cFinishM) > 0 AND nFinishLot > 0
		*!*			ThisForm.Reset_MFG_Lot(cFinishM,nFinishLot)
		*!*		ENDIF
			
		*!*	ELSE
		*!*		MESSAGEBOX("No WorkOrder_Detail Number",0+16,"Cannot create WO Detail!")
		ENDIF
		
		*!*	*******************
		*!*	IF nWO_Detail > 0
		*!*			*Save to a table is done in cmd.CreateStock
		*!*		*Check, resave ????
		*!*		ThisForm.ReCheck_StockData_WOD(nWO_Detail)
