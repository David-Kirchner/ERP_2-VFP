	PROCEDURE chkStkListed.Click
		IF ThisFormSet.frmStock_Produced.Visible
			ThisFormSet.frmStock_Produced.Visible = .F.
		ELSE
			PRIVATE nWO_Detail
			nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
			
			ThisFormSet.Show_frmStock_Produced(nWO_Detail)
			
			IF USED('tmpStock_Produced')
				*ThisFormSet.RefreshStockWOD()
				ThisFormSet.RefreshStock_Produced()
				ThisFormSet.frmStock_Produced.Visible = .T.
			ELSE
				MESSAGEBOX("No STK is listed to be made from this WO!",16,"Nothing to Show.")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmbFcc.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'ConditionCode')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		*This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE cmbFcc.InteractiveChange
		PRIVATE cCC
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		
		This.Parent.cmbFCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
		ThisFormSet.fCC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.fCL = PrepareSQLtxt(This.Parent.cmbFCL.Value,'CL',1)
	ENDPROC

	PROCEDURE cmbFcc.LostFocus
		ThisFormSet.InitcmbFCL()
		
	ENDPROC

	PROCEDURE cmbFCL.GotFocus
		ThisFormSet.fCC = PrepareSQLtxt(This.Parent.cmbFCC.Value,'CC',1)
		ThisFormSet.fCL = PrepareSQLtxt(This.Value,'CL',1)
		
	ENDPROC

	PROCEDURE cmbFCL.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'ConditionLevel')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		
		
		IF USED('ConditionLevel')
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionLevel,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		*This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE cmbFCL.LostFocus
		IF ThisFormSet.fCL != PrepareSQLtxt(This.Value,'CL',1)
			ThisFormSet.fCL = PrepareSQLtxt(This.Value,'CL',1)
			
		*!*		ThisFormSet.frmWorkOrder.txtfCondLevel.Value = ''
		*!*		ThisFormSet.frmWorkOrder.txtStartSize.Value = 0
		*!*		ThisFormSet.frmWorkOrder.txtCW.Value	= 0
		*!*		ThisFormSet.frmWorkOrder.txtRoughSize.Value = 0
		*!*		ThisFormSet.frmWorkOrder.txtOverSize.Value	= PrepareSQLnum(0,'OverSize',5,3)
		ENDIF
	ENDPROC

	PROCEDURE cmbFCL.Valid
		*ThisFormSet.Calc_Weight('FINISH')
		
		ThisFormSet.ConditionLevelText()
	ENDPROC

	PROCEDURE cmbFForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE cmbFForm.Valid
		*10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,71,Coupling,72,Flange,75,Fastener,80,Disk,90,Machined
		
		ThisFormSet.RefreshFForms(This.Value)
		* ALSO FOUND IN Quotes,PurchaseOrder Screen
		ThisFormSet.Calc_Weight('FINISH',.F.)
	ENDPROC

	PROCEDURE cmbFinishM.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpMachine')
			SELECT tmpMachine
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT ANS,UN FROM dbo.AppSetup WITH(NOLOCK) "
		cSQL = cSQL + " WHERE PRP = 'Production Machine'"
		
		*---cSQL="SELECT dbo.f_GetMachine_LogList() AS [ANS]"
		
		
		* UPDATE dbo.AppSetup SET ANS = 'Swage'
		* WHERE PRP = 'Production Machine' AND UN ='Swage_Log '
		 
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMachine')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpMachine')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMachine")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMachine")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpMachine')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION atmpMachine(1,2)
		PRIVATE cLogList 
		cLogList = ""
		*cLogList = tmpMachine.ANS
		
		IF USED('tmpMachine')
			SELECT * FROM tmpMachine INTO ARRAY atmpMachine
		
			USE IN tmpMachine
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(atmpMachine,1)+1	&&Add Blank
		This.BoundColumn = 1
		This.ColumnWidths = "70,90"
		
		this.addListitem("",1,1)  &&Add a blank
		this.addListitem("",1,2)
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(atmpMachine,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(atmpMachine(I, 1),I+1,1)
			this.addListitem(atmpMachine(I, 2),I+1,2)
		ENDFOR
	ENDPROC

