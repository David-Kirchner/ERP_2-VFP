		ThisFormSet.Calc_AddTest(14)
		
		
		
			
	ENDPROC

	PROCEDURE lblViewLog.Click
		PRIVATE cForm, cAlloy, nThck, nFThck
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',8,3)
		nFThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',8,3)
		
		PRIVATE cCC,cCL
		cCC	= PrepareSQLtxt(ThisForm.cmbfCC.Value,'CC',1)
		cCL	= PrepareSQLtxt(ThisForm.cmbfCL.Value,'CL',1)
		
		PRIVATE nStartSize, nCW, nRoughSize
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		
		IF nRoughSize = 0
			nRoughSize = nFThck + .050
		ENDIF
		IF nStartSize = 0
			nStartSize = nThck
		ENDIF
		
		ThisFormSet.frmLogView.grdLog.RecordSource = ''
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tLogView')
			SELECT tLogView
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT GFMLog.Lot,sSize,GFMsize,fSize,ColdWork"
		cSQL = cSQL + ",Tensile,Yield,Elongation,Red_Area,RockWell"
		cSQL = cSQL + ",CAST(GFMLog.[Date] AS date) AS sDate"
		cSQL = cSQL + ",GFMLog.Spec,GFMLog.Notes "
		cSQL = cSQL + ",CL.[Text]"
		cSQL = cSQL + " FROM dbo.GFMlog "
		cSQL = cSQL + ", dbo.ConditionLevel CL "
		cSQL = cSQL + " WHERE AlloyName='"+cAlloy+"'"
		cSQL = cSQL + " AND sSize >= "+STR(nStartSize-.5)
		cSQL = cSQL + " AND sSize <= "+STR(nStartSize+.5)
		cSQL = cSQL + " AND GFMSize > "+STR(nRoughSize-.5)
		
		cSQL = cSQL + " AND CL.CC = '"+cCC+"'"
		cSQL = cSQL + " AND CL.CL = '"+cCL+"'"
		cSQL = cSQL + " AND Tensile > CL.MinUTS"
		cSQL = cSQL + " AND Tensile < CL.MaxUTS"
		cSQL = cSQL + " AND Yield > CL.MinYLD"
		cSQL = cSQL + " AND Yield < CL.MaxYLD"
		cSQL = cSQL + " AND ColdWork > 0 "
		
		cSQL = cSQL + " ORDER BY ColdWork ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tLogView')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tLogView')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tLogView")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tLogView")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tLogView')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tLogView')
			ThisFormSet.frmLogView.Visible = .T.
			PRIVATE cMess
			cMess = "Alloy:"+cAlloy + ", CC:"+cCC+", CL:"+cCL
			cMess = cMess + ", "+tLogView.Text
			ThisFormSet.frmLogView.lblLog.Caption = cMess
			ThisFormSet.frmLogView.grdLog.RecordSource = 'tLogView'
		ENDIF
		
	ENDPROC

	PROCEDURE lblViewProj.Click
		PRIVATE cForm, cAlloy, nThck, nFThck
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',8,3)
		nFThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',8,3)
		
		PRIVATE cCC,cCL
		cCC	= PrepareSQLtxt(ThisForm.cmbfCC.Value,'CC',1)
		cCL	= PrepareSQLtxt(ThisForm.cmbfCL.Value,'CL',1)
		
		PRIVATE nStartSize, nCW, nRoughSize
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		
		IF nRoughSize = 0
			nRoughSize = nFThck + .050
		ENDIF
		IF nStartSize = 0
			nStartSize = nThck
		ENDIF
		
		ThisFormSet.frmProjected.grdProjected.RecordSource = ''
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tProjectedV')
			SELECT tProjectedV
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT * "
		cSQL = cSQL + " FROM dbo.Stock_Projected "
		
		cSQL = cSQL + " ORDER BY CC,CL,STR(thck,9,3),Alloy"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tProjectedV')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tProjectedV')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tProjectedV")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tProjectedV")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tProjectedV')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tProjectedV')
			ThisFormSet.frmProjected.Visible = .T.
			PRIVATE cMess
			cMess = "Alloy:"+cAlloy + ", CC:"+cCC+", CL:"+cCL
		
			ThisFormSet.frmProjected.lblLog.Caption = cMess
			ThisFormSet.frmProjected.grdProjected.RecordSource = 'tProjectedV'
		ENDIF
		
	ENDPROC

	PROCEDURE txtFAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtFAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtFAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				
				ThisFormSet.Calc_Weight('FINISH',.F.)
				
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE txtfID_Detail.Click
		
		*cHyperLink = HTML_Stock_ID_Detail(TBL,ID_Detail,pReturnURL)
		PRIVATE cTBL,nID_Detail
		cTBL = "S"
		nID_Detail = PrepareSQLnum(This.Value,'ID_Detail',-3)
		IF nID_Detail > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_Stock_ID_Detail(cTBL,nID_Detail,.T.) &&lReturnURL --not URL is an HTML code.
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			MESSAGEBOX("No number",0,"Error")
		ENDIF
	ENDPROC

	PROCEDURE txtFinishLot.Valid
		*Validate the Lot
		PRIVATE cMach, nLot, cTable 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'Mach',20)
		nLot	= PrepareSQLnum(This.Value,'Lot',-3)
		cTable = ''
		
		PRIVATE cSQL, nSQLEXEC, lValidLot 
		lValidLot = .F.
		
		IF nLot = 0
			lValidLot = .T.
			RETURN lValidLot
		ENDIF
		
		IF NOT EMPTY(cMach)
			IF nLot > 0
		
				IF USED('tmpMachine')
					SELECT tmpMachine
				ELSE
					SELECT 0
				ENDIF
		
				cSQL="SELECT UN FROM dbo.AppSetup WITH(NOLOCK) "
				cSQL = cSQL + " WHERE PRP = 'Production Machine'"
				cSQL = cSQL + " AND ANS='"+cMach+"'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMachine')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpMachine')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMachine")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMachine")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpMachine')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
		
				IF USED('tmpMachine')
					IF RECCOUNT('tmpMachine') > 0
						cTable = tmpMachine.UN
					ENDIF
					USE IN tmpMachine
				ENDIF
			ENDIF
		ENDIF
		
		
		IF NOT EMPTY(cTable)
		
			IF USED('tmpMachineLot')
				SELECT tmpMachineLot
			ELSE
				SELECT 0
			ENDIF
		
			cSQL="SELECT COUNT(*) AS CNTD FROM dbo."+cTable
			cSQL = cSQL + " WHERE LOT = "+STR(nLot)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMachineLot')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpMachineLot')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMachineLot")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMachineLot")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpMachineLot')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		
			IF USED('tmpMachineLot')
				IF RECCOUNT('tmpMachineLot') > 0
					IF tmpMachineLot.CNTD > 0
						lValidLot = .T.
					ELSE
						MESSAGEBOX("This Machine:"+cMach+"  and Lot:"+ALLTRIM(STR(nLOT))+ " was not found!",16,"Replace with '0' to continue")
					ENDIF
				ENDIF
				USE IN tmpMachineLot
			ENDIF
		ENDIF
		
		RETURN lValidLot 
	ENDPROC

	PROCEDURE txtFollowLot.Valid
