	PROCEDURE lblFSz2.Click
		PRIVATE nPieces, cForm, cAlloy, nThck, nSz2, nSz3, nWeight
		nPieces	= PrepareSQLnum(ThisForm.txtPieces.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		
		nThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',8,3)
		nSz2	= PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',8,3)
		nSz3 	= PrepareSQLnum(ThisForm.txtSz3.Value,'Sz3',8,3)
		*nWeight	= PrepareSQLnum(ThisForm.txtWeight.Value,'Weight',7,1)
		
		PRIVATE nFPieces, nFThck, nFSz2, nFSz3, nFWeight
		nFPieces= PrepareSQLnum(ThisForm.txtFPieces.Value,'Pieces',-3)
		nFThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',8,3)
		nFSz2	= PrepareSQLnum(ThisForm.txtFSz2.Value,'Sz2',8,3)
		nFSz3 	= PrepareSQLnum(ThisForm.txtFSz3.Value,'Sz3',8,3)
		nFWeight= PrepareSQLnum(ThisForm.txtFWeight.Value,'Weight',7,1)
		
		PRIVATE nStartSize, nCW, nRoughSize, nOverSize, nVolume
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',-1)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
		nOverSize 	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		
		IF nOverSize  = 0
			nOverSize = .060
			ThisForm.txtOverSize.Value = nOverSize
		ENDIF
		IF nRoughSize = 0
			nRoughSize = nFThck + nOverSize
			ThisForm.txtRoughSize.Value = nRoughSize
		ENDIF
		IF nStartSize = 0
			nStartSize = nThck
		*	ThisForm.txtThck.Value
			ThisForm.txtStartSize.Value = nStartSize 
		ENDIF
		
		nVolume = nPieces * (3.14156*(nThck*nThck)/4) * nSz2
		nFSz2 = nVolume / ( nFPieces * (3.14156*(nRoughSize*nRoughSize)/4) )
		ThisForm.txtfSz2.Value = nFSz2
		ThisFormSet.Calc_Weight('FINISH',.F.)
	ENDPROC

