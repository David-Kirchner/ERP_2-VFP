	PROCEDURE txtFPOitem.Click
		*Show PO on Repoert Server
		PRIVATE nHPApo,cHyperLink,cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.txtFPOitem.Value,'POitem',12)
		nHPApo = VAL( cPOitem )
		
		cHyperLink = HTML_PO(nHPApo,.T.)
		IF nHPApo > 0
			IF LEN(cHyperLink)>0
			
				PRIVATE loHyperlink 
				loHyperlink = CREATEOBJECT("Hyperlink")
				loHyperlink.navigateto(cHyperLink)
				RELEASE loHyperlink 
		
			ELSE
				MESSAGEBOX("No Hyperlink",16,"Cannot show PO")
			ENDIF
		ELSE
			MESSAGEBOX("No ERP PO number",16,"Cannot show PO")
		ENDIF
	ENDPROC

