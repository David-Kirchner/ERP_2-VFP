	PROCEDURE lblConditionLevel.Click
		PRIVATE cfAlloy, cfForm, cfCC, cfCL, nfThck
		cFAlloy		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.txtFAlloy.Value,'Alloy',12)
		cFForm		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFForm.Value,'Form',2)
		cFCC		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCC.Value,'CC',1)
		cFCL		= PrepareSQLtxt(ThisFormSet.frmWorkOrder.cmbFCL.Value,'CL',1)
		nFthck		= PrepareSQLnum(ThisFormSet.frmWorkOrder.txtFThck.Value,'Thck',14,4)
		
		IF EMPTY(cFCC)
			MESSAGEBOX("Need a Condition Code",48,"Exit")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE nCWAvg 
		nCWAvg = 0
		
		cSQL = "SELECT CWMin,CWAvg,CWMedian,CWMax,CWCnt "
		cSQL = cSQL+" FROM dbo.PriceTable "
		cSQL = cSQL+" WHERE Alloy = '"+cfAlloy+"'"
		cSQL = cSQL+" AND Form = '"+cfForm+"'"
		cSQL = cSQL+" AND CC = '"+cfCC+"'"
		cSQL = cSQL+" AND CL = '"+cfCL+"'"
		cSQL = cSQL+" AND Size ="+STR(nFthck,8,3)
		
		IF USED("tmp_CW")	
			USE IN tmp_CW
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_CW')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,	cSQL, 'tmp_CW')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_CW")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_CW")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmp_CW')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmp_CW')
			IF RECCOUNT('tmp_CW') > 0
				nCWAvg = tmp_CW.CWAvg
		
			ENDIF
			USE IN tmp_CW
		ENDIF
		
		
		IF nCWAvg > 0
			
			ThisFormSet.frmWorkOrder.txtCW.Value = nCWAvg
				
			PRIVATE nStartSize, nRoughSize, nOverSize
			nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
			nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
			nOverSize 	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
			
			IF nStartSize = 0
				nStartSize = PrepareSQLnum(ThisForm.txtThck.Value,'Thck',10,4)
			ENDIF
			IF nStartSize = 0
				MESSAGEBOX("Could not calculate Rough Size because there is no StartSize",48,"No StartSize")
				RETURN
			ELSE
				*M.A1= 3.14156*M.sD1*M.sD1/4
				*M.A2 = M.A1 - ( M.A1 * M.RA)
				*M.sD2 = SQRT(M.A2*4/3.14156)
				
				nRoughSize = SQRT( 3.14156*nStartSize*nStartSize/4 - (3.14156*nStartSize*nStartSize/4 * (nCWAvg/100)) *4/3.14156)
				ThisForm.txtRoughSize.Value = nRoughSize
				WAIT WINDOW STR(nRoughSize,9,3) NOWAIT
				
				IF nFthck > 0 AND nOverSize = 0
					nOverSize = nRoughSize - nFthck 
					ThisForm.txtOverSize.Value = nOverSize
				ENDIF
			ENDIF
			
			
			***************
			PRIVATE nSSz2, nFSz2
			nSSz2	= PrepareSQLnum(ThisForm.txtSz2.Value,'Sz2',8,3)
			nFSz2	= PrepareSQLnum(ThisForm.txtFSz2.Value,'Sz2',8,3)
			
			IF nSSz2 = 0 AND nFSz2 > 0
				nVolume = nFPieces * (3.14156*(nRoughSize*nRoughSize)/4) * nFSz2
				nSz2 = nVolume / ( nPieces * (3.14156*(nStartSize*nStartSize)/4) )
				ThisForm.txtSz2.Value = nSz2
				ThisFormSet.Calc_Weight('START',.F.)
			ENDIF
			IF nSSz2 > 0 AND nFSz2 = 0
				nVolume = nPieces * (3.14156*(nThck*nThck)/4) * nSz2
				nFSz2 = nVolume / ( nFPieces * (3.14156*(nRoughSize*nRoughSize)/4) )
				ThisForm.txtfSz2.Value = nFSz2
				ThisFormSet.Calc_Weight('FINISH',.F.)
			ENDIF
			
		ENDIF
		
		PRIVATE cText
		cText = ConditionLevelText(cfCC,cfCL)
		ThisFormSet.frmWorkOrder.txtfCondLevel.Value = cText
		
	ENDPROC

	PROCEDURE lblCW.Click
		PRIVATE nStartSize, nCW, nCWorig, nCWp, nRoughSize
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'StartSize',8,3)
		nCW			= PrepareSQLnum(ThisForm.txtCW.Value,'CW',2,0)
		nCWorig		= nCW
		nCWp		= 1+(nCW/100)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'RoughSize',8,3)
					
		IF nCW <= 0
			WAIT WINDOW "Calculating ColdWork" NOWAIT
			IF nStartSize > 0
				IF nRoughSize > 0
					*FIND RA BY DIA'S    (ORIG-FINAL)/ORIG=%
					*M.A1= 3.14156*M.sD1*M.sD1/4
					*M.A2= 3.14156*M.sD2*M.sD2/4
					*M.sRA = (M.A1-M.A2)/M.A1
					nCWp = ((3.14156*nStartSize*nStartSize/4)-(3.14156*nRoughSize*nRoughSize/4))/(3.14156*nStartSize*nStartSize/4)
					nCW = ROUND(nCWp * 100,0)
				ELSE
					MESSAGEBOX("Cold Work Cannot be 0 to Calculate here.",48,"No Changes")
					RETURN	
				ENDIF
			ELSE
				MESSAGEBOX("Cold Work Cannot be 0 to Calculate here.",48,"No Changes")
				RETURN
			ENDIF
		ENDIF
			
		PRIVATE nStartSizeOrig
		IF nStartSize > 0
			IF nRoughSize > 0
				IF nCW = 0
					*Calc CW from SS and RS
					nCWp = ((3.14156*nStartSize*nStartSize/4)-(3.14156*nRoughSize*nRoughSize/4))/(3.14156*nStartSize*nStartSize/4)
					nCW = ROUND(nCWp * 100,0)
					ThisForm.txtCW.Value = PrepareSQLnum(nCW,'CW',2,0)
				ELSE
					IF nCWorig = nCW
						MESSAGEBOX("Either Start or Rough Size must be 0 to work with ColdWork!",48,"No Changes")
					ELSE
						ThisForm.txtCW.Value = PrepareSQLnum(nCW,'CW',2,0)
					ENDIF
				ENDIF
			ELSE
				*Calc Rough from Start
				IF nStartSize > 0 AND nCW > 0
					nRoughSize = SQRT( (nStartSize*nStartSize)/ nCWp )
					ThisForm.txtRoughSize.Value = PrepareSQLnum(nRoughSize,'RoughSize',8,3)
				ENDIF
			ENDIF
		ELSE
			IF nRoughSize = 0
				MESSAGEBOX("Either Start or Rough size must not be 0 to work with ColdWork!",48,"No Changes")
			ELSE
				*Calc Start from Rough
				IF nRoughSize > 0 AND nCW > 0
					nStartSizeOrig = nStartSize
					nStartSize = SQRT( (nRoughSize*nRoughSize) * nCWp )
					
					IF ((nStartSizeOrig+100)*1.0002 >= (nStartSize+100)) AND ((nStartSizeOrig+100) <= (nStartSize+100)*1.0002)
						*StartSize does not need to be changed from Orig
					ELSE
						WAIT WINDOW "Changing StartSize to "+ALLTRIM(STR(nStartSize,8,3)) NOWAIT
						ThisForm.txtStartSize.Value	= PrepareSQLnum(nStartSize,'StartSize',8,3)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE lblCWavg.Click
		PRIVATE nCW, nOverSize
		nCW 		= PrepareSQLnum(ThisForm.txtCWavg.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		IF nCW = 0
			MESSAGEBOX("No ColdWork number to use!",0+48,"Cannot continue.")
			RETURN .F.
		ELSE
			ThisForm.txtCW.Value = nCW
		ENDIF
		
		PRIVATE nStartSize,nRoughSize,nOverSize,nsThck,nfThck
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'CW',2,0)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'Thick',9,3)
		nsThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3)
		nfThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',9,3)
		
		DO CASE
		CASE nStartSize = 0 AND nRoughSize = 0
			nRoughSize = nfThck + nOverSize
			ThisForm.txtRoughSize.Value = nRoughSize 
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize = 0
			ThisForm.lblRoughSize.Click
		CASE nStartSize = 0 AND nRoughSize > 0
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize > 0
			ThisForm.txtStartSize.Value = 0
			ThisForm.lblStartDia.Click
		ENDCASE	
	ENDPROC

	PROCEDURE lblCWmax.Click
		PRIVATE nCW, nOverSize
		nCW 		= PrepareSQLnum(ThisForm.txtCWavg.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		IF nCW = 0
			MESSAGEBOX("No ColdWork number to use!",0+48,"Cannot continue.")
			RETURN .F.
		ELSE
			ThisForm.txtCW.Value = nCW
		ENDIF
		
		PRIVATE nStartSize,nRoughSize,nOverSize,nsThck,nfThck
		nStartSize	= PrepareSQLnum(ThisForm.txtStartSize.Value,'CW',2,0)
		nRoughSize	= PrepareSQLnum(ThisForm.txtRoughSize.Value,'CW',2,0)
		nOverSize	= PrepareSQLnum(ThisForm.txtOverSize.Value,'OverSize',5,3)
		nsThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,3)
		nfThck	= PrepareSQLnum(ThisForm.txtFThck.Value,'Thck',9,3)
		
		DO CASE
		CASE nStartSize = 0 AND nRoughSize = 0
			nRoughSize = nRoughSize + nOverSize
			ThisForm.txtRoughSize.Value = nRoughSize 
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize = 0
			ThisForm.lblRoughSize.Click
		CASE nStartSize = 0 AND nRoughSize > 0
			ThisForm.lblStartDia.Click
		CASE nStartSize > 0 AND nRoughSize > 0
			ThisForm.txtStartSize.Value = 0
			ThisForm.lblStartDia.Click
		ENDCASE	
	ENDPROC

