	PROCEDURE ERPCert.PF1.pgCert.cmdBrowse.Click
		PRIVATE nID
		nID = ERPCert.ID
		
		IF RECCOUNT('ERPCert') < 2
		*	ThisFormSet.Get_Cert('HEATLOT',ERPCert.Heat,ERPCert.Lot)
			ThisFormSet.Get_Cert('HEAT',ERPCert.Heat)
		ENDIF
		
		SELECT ERPCert
		
		BROWSE FIELDS Alloy,size,Heat,Machine,Lot,spec,uns,ult1,yield1,Elong1,Ra1,Heattreat,Hardness,BHN NODELETE NOEDIT TITLE "Esc to leave" 
		*NOWAIT
		
		IF nID != ERPCert.ID
		
			ThisFormSet.Get_Cert('ID',ERPCert.ID )
			
			ThisForm.PF1.pgCert.Refresh
		ENDIF
		
	ENDPROC

