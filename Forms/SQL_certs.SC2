			ENDIF
				
			IF FILE(cFileName)
				DELETE FILE (cFileName)
			ENDIF
		
		ENDIF
		
		SELECT ERPCert
		IF m.currntrecrd <= RECCOUNT('ERPCert')
			GOTO m.currntrecrd
		ELSE
			GO TOP
		ENDIF
		
	ENDPROC

