	PROCEDURE ERPCert.PF1.pgCert.txttLoc6.Valid
		PRIVATE ctLoc
		ctLoc = UPPER(ShowSQLtxt(This.Value,'tLoc',1))
		IF ctLoc = "C" OR ctLoc = "M" OR ctLoc = "O" OR EMPTY(ctLoc)
			RETURN .T.
		ELSE
			MESSAGEBOX("Test Location must be blank, Center, MidRadius or Outer"+CHR(13)+"'','C','M','O'"+CHR(13)+"cannot be '"+ctLoc+"'.",16,"Cannot Continue")
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE ERPCert.PF1.pgCert.txttLoc6.When
		RETURN ThisFormSet.isediting
	ENDPROC

	PROCEDURE ERPCert.PF1.pgCert.txttLoc7.Valid
