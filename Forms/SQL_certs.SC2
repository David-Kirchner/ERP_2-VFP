	PROCEDURE ERPCert.PF1.pgCert.cmdPrintSpaceX.Valid
		local m.currntrecrd
		
		IF NOT USED("ERPCert_Co")
			MESSAGEBOX("Could not load the Customer Specific Database",0,"Data load Error")
		ENDIF
		
		SELECT ERPCert
		m.currntrecrd = recno('ERPCert')
		PRIVATE nCertID
		nCertID = ERPCert.ID
		
		************************
		*Create Pivot Table of tmpCertProfile
		
		SELECT 0
		IF USED('CertSPX')
			USE IN CertSPX
		ENDIF
		
		IF NOT ThisFormSet.CreateTable_CertSPX(nCertID)
			RETURN .F.
		ENDIF
		*SELECT * FROM ERPCert WHERE ERPCert=nCertID INTO CURSOR 'CertSPX' NOFILTER 
			
		
		SELECT ERPCert
		
		IF PrepareSQLnum(ERPCert.Ult6,'Ult6',-3) > 0
			REPORT FORM Reports\Certs_SpaceX5 RECORD m.currntrecrd TO PRINTER PROMPT NOCONSOLE
		ELSE
			*REPORT FORM Reports\certs RECORD m.currntrecrd TO PRINTER PROMPT NOCONSOLE
