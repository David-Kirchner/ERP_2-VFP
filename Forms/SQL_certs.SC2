		*Reset certain fields in LMA
		ThisFormset.ERPCert.PF1.pgCert.txtBHN.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc1.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness2.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtBHN2.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc2.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness3.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtBHN3.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc3.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl4.Value = ''
		*ThisFormset.ERPCert.PF1.pgCert.txtHardness4.Value = ' '
		*ThisFormset.ERPCert.PF1.pgCert.txtBHN4.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc4.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl5.Value = ''
		*ThisFormset.ERPCert.PF1.pgCert.txtHardness5.Value = ' '
		*ThisFormset.ERPCert.PF1.pgCert.txtBHN5.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc5.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txttLoc6.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txttLoc7.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtSpecLMA.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSpecSpaceX.Value = ''
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpROLLlog')	
			USE IN tmpROLLlog
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Roll_LOG WHERE Lot = "+STR(nLot)
				
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpROLLlog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpROLLlog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpROLLlog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpROLLlog")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpROLLlog')
			RETURN
		ELSE
			IF USED('tmpROLLlog')
				IF RECCOUNT('tmpROLLlog') > 0
		
					IF tmpROLLlog.heat != cHeat
						IF AT('-',tmpROLLlog.heat,1) > 1
							cgfmlogHeat = LEFT(tmpROLLlog.heat,AT('-',tmpROLLlog.heat,1)-1)
						ELSE
							cgfmlogHeat = ALLTRIM(tmpROLLlog.heat)
						ENDIF
						IF AT('-',cHeat,1) > 1
							cCertHeat = LEFT(cHeat,AT('-',cHeat,1)-1)
						ELSE
							cCertHeat = ALLTRIM(cHeat)
						ENDIF
						
						IF cgfmlogHeat != cCertHeat 
							MESSAGEBOX("Roll LOG Heat:"+cgfmlogHeat+" does not match Cert Heat:"+cCertHeat ,16,"Heat numbers do not match!")
						ENDIF
					ENDIF
		
					SELECT ERPCert
					ThisFormset.ERPCert.PF1.pgCert.txtUlt.Value = tmpROLLlog.tensile
					ThisFormset.ERPCert.PF1.pgCert.txtYield.Value = tmpROLLlog.yield
					ThisFormset.ERPCert.PF1.pgCert.txtElong.Value = tmpROLLlog.elongation
					ThisFormset.ERPCert.PF1.pgCert.txtElonInches.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txtRA.Value = tmpROLLlog.red_area
					
					ThisFormset.ERPCert.PF1.pgCert.txtHardness.Value = IIF(!empty(tmpROLLlog.rockwell),"R"+LOWER(tmpROLLlog.rockwell)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN.Value = tmpROLLlog.bhn
					ThisFormset.ERPCert.PF1.pgCert.txttLoc1.Value = '' &&tmpROLLlog.tLoc
					
					ThisFormset.ERPCert.PF1.pgCert.txtLot.Value = nLot
					ThisFormset.ERPCert.PF1.pgCert.txtReference.Value = 'Roll'
					ThisFormset.ERPCert.PF1.pgCert.grpMach.Value = 3
					ThisFormset.ERPCert.PF1.pgCert.txtDateCert.Value = tmpROLLlog.testsent+3
					ThisFormset.ERPCert.PF1.pgCert.txtDateProd.Value = tmpROLLlog.date
					ThisFormset.ERPCert.PF1.pgCert.txtAlloy.Value = tmpROLLlog.ALLOYNAME    &&C12
					ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value =  tmpROLLlog.heat         &&C35
					ThisFormset.ERPCert.PF1.pgCert.txtSize.Value = "Bar"
					ThisFormset.ERPCert.PF1.pgCert.txtSpec.Value = tmpROLLlog.SPEC         &&C40
					
					ThisFormset.ERPCert.PF1.pgCert.txtLabUsed.Value = tmpROLLlog.lab 
					ThisFormset.ERPCert.PF1.pgCert.txtTestPO.Value = tmpROLLlog.TestPO
					ThisFormset.ERPCert.PF1.pgCert.txtLabUsed2.Value = '' &&tmpROLLlog.lab2
					ThisFormset.ERPCert.PF1.pgCert.txtTestPO2.Value = '' &&tmpROLLlog.TestPO2
			
					ThisFormset.ERPCert.PF1.pgCert.txtUlt2.Value = tmpROLLlog.Tensile2
					ThisFormset.ERPCert.PF1.pgCert.txtYld2.Value = tmpROLLlog.Yield2
					ThisFormset.ERPCert.PF1.pgCert.txtEl2.Value = tmpROLLlog.elongation2
					ThisFormset.ERPCert.PF1.pgCert.txtRA2.Value = tmpROLLlog.red_area2
					ThisFormset.ERPCert.PF1.pgCert.txtHardness2.Value = IIF(!empty(tmpROLLlog.rockwell2),"R"+LOWER(tmpROLLlog.rockwell2)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN2.Value = tmpROLLlog.BHN2
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches2.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txttLoc2.Value = '' &&tmpROLLlog.tLoc2
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt3.Value = tmpROLLlog.Tensile3
					ThisFormset.ERPCert.PF1.pgCert.txtYld3.Value = tmpROLLlog.Yield3
					ThisFormset.ERPCert.PF1.pgCert.txtEl3.Value = tmpROLLlog.elongation3
					ThisFormset.ERPCert.PF1.pgCert.txtRA3.Value = tmpROLLlog.red_area3
					ThisFormset.ERPCert.PF1.pgCert.txtHardness3.Value = IIF(!empty(tmpROLLlog.rockwell3),"R"+LOWER(tmpROLLlog.rockwell3)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN3.Value = tmpROLLlog.BHN3
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches3.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txttLoc3.Value = '' &&tmpROLLlog.tLoc3
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt4.Value = 0 &&tmpROLLlog.Tensile4
					ThisFormset.ERPCert.PF1.pgCert.txtYld4.Value = 0 &&tmpROLLlog.Yield4
					ThisFormset.ERPCert.PF1.pgCert.txtEl4.Value = 0 &&tmpROLLlog.elongation4
					ThisFormset.ERPCert.PF1.pgCert.txtRA4.Value = 0 &&tmpROLLlog.red_area4
		*			ThisFormset.ERPCert.PF1.pgCert.txtHardness4.Value = '' &&IIF(!empty(tmpROLLlog.rockwell4),"R"+LOWER(tmpROLLlog.rockwell4)," ")
		*			ThisFormset.ERPCert.PF1.pgCert.txtBHN4.Value = 0 &&tmpROLLlog.BHN3
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches4.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txttLoc4.Value = '' &&tmpROLLlog.tLoc4
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt5.Value = 0 &&tmpROLLlog.Tensile5
					ThisFormset.ERPCert.PF1.pgCert.txtYld5.Value = 0 &&tmpROLLlog.Yield5
					ThisFormset.ERPCert.PF1.pgCert.txtEl5.Value = 0 &&tmpROLLlog.elongation5
					ThisFormset.ERPCert.PF1.pgCert.txtRA5.Value = 0 &&tmpROLLlog.red_area5
		*			ThisFormset.ERPCert.PF1.pgCert.txtHardness5.Value = '' &&IIF(!empty(tmpROLLlog.rockwell5),"R"+LOWER(tmpROLLlog.rockwell5)," ")
		*			ThisFormset.ERPCert.PF1.pgCert.txtBHN5.Value = 0 &&tmpROLLlog.BHN5
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches5.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txttLoc5.Value = '' &&tmpROLLlog.tLoc5
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt6.Value = 0 &&tmpROLLlog.Tensile5
					ThisFormset.ERPCert.PF1.pgCert.txtYld6.Value = 0 &&tmpROLLlog.Yield5
					ThisFormset.ERPCert.PF1.pgCert.txtEl6.Value = 0 &&tmpROLLlog.elongation5
					ThisFormset.ERPCert.PF1.pgCert.txtRA6.Value = 0 &&tmpROLLlog.red_area5
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches6.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txttLoc6.Value = '' &&tmpROLLlog.tLoc5
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt7.Value = 0 &&tmpROLLlog.Tensile5
					ThisFormset.ERPCert.PF1.pgCert.txtYld7.Value = 0 &&tmpROLLlog.Yield5
					ThisFormset.ERPCert.PF1.pgCert.txtEl7.Value = 0 &&tmpROLLlog.elongation5
					ThisFormset.ERPCert.PF1.pgCert.txtRA7.Value = 0 &&tmpROLLlog.red_area5
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches7.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txttLoc7.Value = '' &&tmpROLLlog.tLoc5
					
					
					ThisFormset.ERPCert.PF1.pgCert.txtSpecLMA.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txtSpecSpaceX.Value = ' '
					
					PRIVATE cUNS
					cUNS = GetUNS( tmpROLLlog.ALLOYNAME, ThisFormSet.nConnHandle)
					IF !EMPTY(cUNS)
						ThisFormset.ERPCert.PF1.pgCert.txtUNS.Value = cUNS
					ENDIF
					
					isadding=.T.
					ThisFormSet.SetEditing()
					
					ThisFormset.frmSearch.txtGetHeat.Value = ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value
					
					ThisFormset.frmSearch.txtGetLot.Value = PrepareSQLtxt(ThisFormset.ERPCert.PF1.pgCert.txtLot.Value,'Lot',10)		
					*MESSAGEBOX("Clone is ready")
				ENDIF
				
				USE IN tmpROLLlog
			ELSE
		
		*		Cancel CLONE FROM lot
				ThisFormSet.isediting=.F.
				isadding=.F.
				= MESSAGEBOX("Roll log Not found!  NO DATA CLONED!",16)
				SELECT ERPCert
				SET ORDER TO heat
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE getwirelotprop
		PARAMETERS nLot,cHeat
		*ThisFormSet.GetWireLotProp()
		
		IF VARTYPE(nLot) != 'N'
			RETURN .F.
		ENDIF
		
		*Reset certain fields
		ThisFormset.ERPCert.PF1.pgCert.txtGrainSize.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtCorrosionr.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHeatTreat.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtSrHours.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSrTemp.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSrStress.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSrRa.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSRElong.Value = ''
		*Reset certain fields in LMA
		ThisFormset.ERPCert.PF1.pgCert.txttLoc1.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtBHN.Value = 0
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness2.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtBHN2.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc2.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness3.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtBHN3.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc3.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl4.Value = ''
		*ThisFormset.ERPCert.PF1.pgCert.txtHardness4.Value = ' '
		*ThisFormset.ERPCert.PF1.pgCert.txtBHN4.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc4.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl5.Value = ''
		*ThisFormset.ERPCert.PF1.pgCert.txtHardness5.Value = ' '
		*ThisFormset.ERPCert.PF1.pgCert.txtBHN5.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc5.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txttLoc6.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txttLoc7.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtSpecLMA.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSpecSpaceX.Value = ''
		
		************************************
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpWire_log')	
			USE IN tmpWire_log
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Wire_log WHERE Lot = "+STR(nLot)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWire_log')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpWire_log')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWire_log")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpWire_log")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpWire_log')
			RETURN
		ELSE
			IF USED('tmpWire_log')
				IF RECCOUNT('tmpWire_log') > 0
		
					IF tmpWire_log.heat != cHeat
						IF AT('-',tmpWire_log.heat,1) > 1
							cgfmlogHeat = LEFT(tmpWire_log.heat,AT('-',tmpWire_log.heat,1)-1)
						ELSE
							cgfmlogHeat = ALLTRIM(tmpWire_log.heat)
						ENDIF
						IF AT('-',cHeat,1) > 1
							cCertHeat = LEFT(cHeat,AT('-',cHeat,1)-1)
						ELSE
							cCertHeat = ALLTRIM(cHeat)
						ENDIF
						
						IF cgfmlogHeat != cCertHeat 
							MESSAGEBOX("Wire Lot Heat:"+cgfmlogHeat+" does not match Cert Heat:"+cCertHeat ,16,"Heat numbers do not match!")
						ENDIF
					ENDIF
		
		
					SELECT ERPCert
					ThisFormset.ERPCert.PF1.pgCert.txtUlt.Value		= PrepareSQLnum(tmpWire_log.tensile,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYield.Value	= PrepareSQLnum(tmpWire_log.yield,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtElong.Value	= PrepareSQLnum(tmpWire_log.elongation,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtElonInches.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txtRA.Value		= PrepareSQLnum(tmpWire_log.Red_Area,'Red_Area',4,1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtHardness.Value = IIF(!empty(tmpWire_log.rockwell),"R"+LOWER(tmpWire_log.rockwell)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN.Value = PrepareSQLnum(tmpWire_log.bhn,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txttLoc1.Value = PrepareSQLtxt(tmpWire_log.tLoc,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtLot.Value = nLot
					ThisFormset.ERPCert.PF1.pgCert.txtReference.Value = 'Drawn'
					ThisFormset.ERPCert.PF1.pgCert.grpMach.Value = 2
					ThisFormset.ERPCert.PF1.pgCert.txtDateCert.Value = (tmpWire_log.testsent)+3
					ThisFormset.ERPCert.PF1.pgCert.txtDateProd.Value = tmpWire_log.date
					ThisFormset.ERPCert.PF1.pgCert.txtAlloy.Value = PrepareSQLtxt(tmpWire_log.ALLOYNAME,'Alloy',35)    &&C12
					ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value =  PrepareSQLtxt(tmpWire_log.heat,'Heat',50)       &&C35
					ThisFormset.ERPCert.PF1.pgCert.txtSize.Value = "Wire"			
					ThisFormset.ERPCert.PF1.pgCert.txtSpec.Value = PrepareSQLtxt(tmpWire_log.SPEC,'Spec',-1)        &&C40
		
					ThisFormset.ERPCert.PF1.pgCert.txtTestPO.Value = PrepareSQLtxt(tmpWire_log.TestPO,'POitem',12)
					ThisFormset.ERPCert.PF1.pgCert.txtLabUsed.Value = PrepareSQLtxt(tmpWire_log.lab,'Lab',12)
					ThisFormset.ERPCert.PF1.pgCert.txtTestPO2.Value = PrepareSQLtxt(tmpWire_log.TestPO2,'POitem',12)
					ThisFormset.ERPCert.PF1.pgCert.txtLabUsed2.Value = PrepareSQLtxt(tmpWire_log.Lab2,'Lab',12)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt2.Value = PrepareSQLnum(tmpWire_log.Tensile2,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld2.Value = PrepareSQLnum(tmpWire_log.Yield2,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl2.Value = PrepareSQLnum(tmpWire_log.elongation2,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA2.Value = PrepareSQLnum(tmpWire_log.Red_Area2,'Red_Area',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtHardness2.Value = IIF(!empty(tmpWire_log.rockwell2),"R"+LOWER(tmpWire_log.rockwell2)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN2.Value = PrepareSQLnum(tmpWire_log.BHN2,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches2.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc2.Value = PrepareSQLtxt(tmpWire_log.tLoc2,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt3.Value = PrepareSQLnum(tmpWire_log.Tensile3,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld3.Value = PrepareSQLnum(tmpWire_log.Yield3,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl3.Value = PrepareSQLnum(tmpWire_log.elongation3,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA3.Value = PrepareSQLnum(tmpWire_log.Red_Area3,'Red_Area',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtHardness3.Value = IIF(!empty(tmpWire_log.rockwell3),"R"+LOWER(tmpWire_log.rockwell3)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN3.Value = PrepareSQLnum(tmpWire_log.BHN3,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches3.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc3.Value = PrepareSQLtxt(tmpWire_log.tLoc3,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt4.Value = PrepareSQLnum(tmpWire_log.Tensile4,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld4.Value = PrepareSQLnum(tmpWire_log.Yield4,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl4.Value = PrepareSQLnum(tmpWire_log.elongation4,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA4.Value = PrepareSQLnum(tmpWire_log.Red_Area4,'Red_Area',4,1)
		*			ThisFormset.ERPCert.PF1.pgCert.txtHardness4.Value = IIF(!empty(tmpWire_log.rockwell4),"R"+LOWER(tmpWire_log.rockwell4)," ")
		*			ThisFormset.ERPCert.PF1.pgCert.txtBHN4.Value = PrepareSQLnum(tmpWire_log.BHN4,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches4.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc4.Value = PrepareSQLtxt(tmpWire_log.tLoc4,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt5.Value = PrepareSQLnum(tmpWire_log.Tensile5,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld5.Value = PrepareSQLnum(tmpWire_log.Yield5,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl5.Value = PrepareSQLnum(tmpWire_log.elongation5,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA5.Value = PrepareSQLnum(tmpWire_log.Red_Area5,'Red_Area',4,1)
		*			ThisFormset.ERPCert.PF1.pgCert.txtHardness5.Value = IIF(!empty(tmpWire_log.rockwell5),"R"+LOWER(tmpWire_log.rockwell5)," ")
		*			ThisFormset.ERPCert.PF1.pgCert.txtBHN5.Value = PrepareSQLnum(tmpWire_log.BHN5,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches5.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc5.Value = PrepareSQLtxt(tmpWire_log.tLoc5,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt6.Value = PrepareSQLnum(tmpWire_log.Tensile6,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld6.Value = PrepareSQLnum(tmpWire_log.Yield6,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl6.Value = PrepareSQLnum(tmpWire_log.elongation6,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA6.Value = PrepareSQLnum(tmpWire_log.Red_Area6,'Red_Area',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches6.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc6.Value = PrepareSQLtxt(tmpWire_log.tLoc6,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt7.Value = PrepareSQLnum(tmpWire_log.Tensile7,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld7.Value = PrepareSQLnum(tmpWire_log.Yield7,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl7.Value = PrepareSQLnum(tmpWire_log.elongation7,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA7.Value = PrepareSQLnum(tmpWire_log.Red_Area7,'Red_Area',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches7.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc7.Value = PrepareSQLtxt(tmpWire_log.tLoc7,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtSpecLMA.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txtSpecSpaceX.Value = ' '
					
					PRIVATE cUNS
					cUNS = GetUNS( tmpWire_log.ALLOYNAME, ThisFormSet.nConnHandle)
					IF !EMPTY(cUNS)
						ThisFormset.ERPCert.PF1.pgCert.txtUNS.Value = cUNS
					ENDIF
					
					isadding=.T.
					ThisFormSet.SetEditing()
					
					ThisFormset.frmSearch.txtGetHeat.Value = ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value
					ThisFormset.frmSearch.txtGetLot.Value = PrepareSQLtxt(ThisFormset.ERPCert.PF1.pgCert.txtLot.Value,'Lot',10)
					
					*MESSAGEBOX("Clone is ready")
				ENDIF
				
				USE IN tmpWire_log
			ELSE
		
		*		Cancel CLONE FROM lot
				ThisFormSet.isediting=.F.
				isadding=.F.
				MESSAGEBOX("Wire log Not found!  No data cloned from Wire_Log",16)
				SELECT ERPCert
				SET ORDER TO heat
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE get_cert		&& Replaced GetCert, would cause VFP to Exit.
		PARAMETERS pTitle, pData
		*ThisFormSet.Get_Cert('ID',2)
		
		PRIVATE cTitle, cData
		IF VARTYPE(pTitle) != 'C'
			cTitle = ''
			cData = ''
		ELSE
			DO CASE
			CASE pTitle = 'SEARCHHEAT'
				cTitle = 'SEARCHHEAT'
				cData = pData
			CASE pTitle = 'HEAT'
				cTitle = 'HEAT'
				cData = pData
			CASE pTitle = 'LOT'
				cTitle = 'LOT'
				IF VARTYPE(pData)="N"
					cData = STR(pData)
				ELSE
					cData = pData
				ENDIF
				IF VARTYPE(cData) != 'C'
					cData = ''
				ENDIF
		
			CASE pTitle = 'ID'
				cTitle = 'ID'
				IF VARTYPE(pData)="N"
					cData = STR(pData)
				ELSE
					cData = pData
				ENDIF
				IF VARTYPE(cData) != 'C'
					cData = ''
				ENDIF
			OTHERWISE
				cTitle = ''
				cData = ''
			ENDCASE
		ENDIF
		
		PRIVATE lGotCert, nReturnCount
		lGotCert = .F.
		nReturnCount = 0
		
		IF USED("ERPCert")
			SELECT ERPCert
			TABLEREVERT(.T.,'ERPCert') &&CURSORSETPROP is not used!, rewrite so this old command can be dropped
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC, nHeatCnt, nLotCnt
		
		ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = 0
		
		ThisFormset.frmSearch.txtHeatCount.Value = 0
		ThisFormset.frmSearch.txtLotCount.Value = 0
		
		ThisFormset.ERPCert.PF1.pgCert.cmdBrowse.Visible = .F.
						
		IF EMPTY(cTitle + cData)
			*Just bring back a record
			cSQL = "SELECT TOP 1 * FROM dbo.Cert "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert')
			ELSE
				SELECT ERPCert
				IF RECCOUNT('ERPCert') > 0
					lGotCert = .T.
					nReturnCount = 1
					
					nHeatCnt = Count_Cert_Heat( ERPCert.Heat, ThisFormSet.nConnHandle )
					ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
					nLotCnt = Count_Cert_Heat_Lot( ERPCert.Heat, ERPCert.Lot, ThisFormSet.nConnHandle )
					ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = nLotCnt
					
					ThisFormset.frmSearch.txtHeatCount.Value = nHeatCnt 
					ThisFormset.frmSearch.txtLotCount.Value = nLotCnt 
		
				ENDIF
			ENDIF
		ENDIF
		
		IF cTitle = 'SEARCHHEAT' AND NOT EMPTY(cData) 
			*ThisFormSet.Get_Cert('SEARCHHEAT',cData)
			cData = PrepareSQLtxt(cData,'Heat',40,.F.)
		
			cSQL = "SELECT * FROM dbo.Cert WHERE HEAT LIKE '%"+cData+"%'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'ERPCert')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert')
			ELSE
				SELECT ERPCert
				IF RECCOUNT('ERPCert') > 0
					lGotCert = .T.
				ENDIF
			ENDIF
		
			IF lGotCert 
			
				SELECT ERPCert
				PRIVATE nID
				nID = ERPCert.ID
				*BROWSE FIELDS Alloy,size,Heat,Machine,Lot,spec,spec2,uns,ult1,yield1,Elong1,Ra1,Heattreat,Hardness NODELETE NOEDIT TITLE "Esc to leave" 
				IF nID != ERPCert.ID
					ThisFormSet.Get_Cert('ID',ERPCert.ID )
					ThisForm.PF1.pgCert.Refresh
				ENDIF
		
				nHeatCnt = Count_Cert_Heat( ERPCert.Heat, ThisFormSet.nConnHandle )
				ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
				nLotCnt = Count_Cert_Heat_Lot( ERPCert.Heat, ERPCert.Lot, ThisFormSet.nConnHandle )
				ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = nLotCnt
				
				ThisFormset.frmSearch.txtHeatCount.Value = nHeatCnt 
				ThisFormset.frmSearch.txtLotCount.Value = nLotCnt 
		
				IF nHeatCnt > 1 OR nLotCnt > 1
					ThisFormset.ERPCert.PF1.pgCert.cmdBrowse.Visible = .T.
				ENDIF
			ELSE
				MESSAGEBOX("Heat:"+ALLTRIM(cData)+" was not found!",0+48,"No Heat to show!")
			ENDIF
		ENDIF
		
		IF cTitle = 'HEAT' AND NOT EMPTY(cData) 
			*ThisFormSet.Get_Cert('HEAT',cData)
			cData = PrepareSQLtxt(cData,'Heat',40,.F.)
		
			nHeatCnt = Count_Cert_Heat( cData, ThisFormSet.nConnHandle )
			IF nHeatCnt > 0
				cSQL = "SELECT * FROM dbo.Cert WHERE HEAT = '"+cData+"'"
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert')
				ELSE
					SELECT ERPCert
					IF RECCOUNT('ERPCert') > 0
						lGotCert = .T.
						nReturnCount = nHeatCnt 
					ENDIF
				ENDIF
						
				ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
				nLotCnt = Count_Cert_Heat_Lot( ERPCert.Heat, ERPCert.Lot, ThisFormSet.nConnHandle )
				ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = nLotCnt
				
				ThisFormset.frmSearch.txtHeatCount.Value = nHeatCnt 
				ThisFormset.frmSearch.txtLotCount.Value = nLotCnt 
		
				IF nHeatCnt > 1 OR nLotCnt > 1
					ThisFormset.ERPCert.PF1.pgCert.cmdBrowse.Visible = .T.
				ENDIF
			ENDIF
		ENDIF
		
		IF cTitle = 'LOT' AND NOT EMPTY(cData) 
			*ThisFormSet.Get_Cert('LOT',cData)
			
			cData = PrepareSQLtxt(cData,'LOT',5,.F.)
		
			nLotCnt = Count_Cert_Lot( cData, ThisFormSet.nConnHandle )
			IF nLotCnt > 0
				cSQL = "SELECT * FROM dbo.Cert WHERE LOT = "+ALLTRIM(cData)
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'ERPCert')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert')
				ELSE
					SELECT ERPCert
					IF RECCOUNT('ERPCert') > 0
						lGotCert = .T.
						nReturnCount = nLotCnt 
					ENDIF
				ENDIF
				
				nHeatCnt = Count_Cert_Heat( ERPCert.Heat, ThisFormSet.nConnHandle )
				ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = nLotCnt 
				ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
				
				ThisFormset.frmSearch.txtHeatCount.Value = nHeatCnt 
				ThisFormset.frmSearch.txtLotCount.Value = nLotCnt 
		
				IF nHeatCnt > 1 OR nLotCnt > 1
					ThisFormset.ERPCert.PF1.pgCert.cmdBrowse.Visible = .T.
				ENDIF
			ENDIF
		ENDIF
		
		
		
		IF cTitle = 'ID' AND NOT EMPTY(cData) 
			cData = PrepareSQLtxt(cData,'ID',-3)
			PRIVATE nIDCnt
		*	nIDCnt = Count_Cert_ID( cData, ThisFormSet.nConnHandle )   Fake it!
			nIDCnt = 1
			IF nIDCnt > 0
				cSQL = "SELECT * FROM dbo.Cert WHERE ID = "+ALLTRIM(cData)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'ERPCert')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert')
				ELSE
					SELECT ERPCert
					IF RECCOUNT('ERPCert') > 0
						lGotCert = .T.
						nIDCnt = RECCOUNT('ERPCert')
						nReturnCount = nIDCnt 
						
						nHeatCnt = Count_Cert_Heat( ERPCert.Heat, ThisFormSet.nConnHandle )
						ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = nHeatCnt 
						nLotCnt = Count_Cert_Heat_Lot( ERPCert.Heat, ERPCert.Lot, ThisFormSet.nConnHandle )
						ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = nLotCnt
						
						ThisFormset.frmSearch.txtHeatCount.Value = nHeatCnt 
						ThisFormset.frmSearch.txtLotCount.Value = nLotCnt 
		
						IF nHeatCnt > 1 OR nLotCnt > 1
							ThisFormset.ERPCert.PF1.pgCert.cmdBrowse.Visible = .T.
						ENDIF
						
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*********************
		ThisFormSet.Refresh_ERPCert()	
		*ThisFormSet.Get_Cert_Co()
		***************************************
		SELECT ERPCert
		
		IF lGotCert 
			RETURN nReturnCount 
		ELSE
			RETURN 0
		ENDIF
		
	ENDPROC

	PROCEDURE get_cert_cocompanies
		PARAMETERS nID
		LOCAL loFrmCustomer
		loFrmCustomer = ThisFormSet.GetFrmCustomer()
		*ThisformSet.Get_Cert_CoCompanies(ID)
		
		IF nID < 0
			RETURN .F.
		ENDIF
		
		IF USED("ERPCert_CCo")
			USE IN ERPCert_CCo
		ENDIF
		
		loFrmCustomer.edtCoComp.Value = ''
		
		SELECT 0
		cSQL = "SELECT DISTINCT Company FROM dbo.Cert_Co WITH(NOLOCK) WHERE ID= "+STR(nID)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert_CCo')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert_CCo')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert_CCo")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert_CCo")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert_CCo')
		ENDIF
		
		PRIVATE cCompList
		cCompList = ''
		IF USED('ERPCert_CCo')
			SCAN
				cCompList = cCompList + RTRIM(PrepareSQLtxt(ERPCert_CCo.Company,'Company',50))+" "+CHR(9)
			ENDSCAN
			USE IN ERPCert_CCo
		
			loFrmCustomer.edtCoComp.Value = cCompList 
			
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETER pcHEAT, pcLOT, pcType
		*DO FORMS\Certs WITH pcHEAT, pcLOT, pcType(GFM ROLL LakeErie)
		
		IF VARTYPE(pcHEAT)="C"
			ThisFormSet.pcHEAT = ALLTRIM(pcHEAT)
			ThisFormset.frmSearch.txtGetHeat.Value = ALLTRIM(pcHEAT)
		ELSE
			ThisFormSet.pcHEAT = ""
		ENDIF
		
		IF VARTYPE(pcLOT)="C"
			ThisFormSet.pcLOT = pcLOT
		ELSE
			IF VARTYPE(pcLOT)="N"
				ThisFormSet.pnLOT=pcLOT
				ThisFormSet.pcLOT= ALLTRIM(STR(pcLOT))
			ELSE
				ThisFormSet.pcLOT= ""
			ENDIF
		ENDIF
		ThisFormset.frmAddCert.txtLot.Value = ThisFormSet.pcLOT
		*ThisFormset.frmSearch.txtGetLot.Value = PrepareSQLtxt(ThisFormSet.pcLOT,'Lot',10)
		ThisFormset.frmSearch.txtGetLot.Value = PrepareSQLtxt(ThisFormSet.pcLOT,'Lot',10)
		
		IF VARTYPE(pcType) = "C"
			DO CASE
			CASE pcType = "GFM"
				ThisFormSet.nMachine = 2
			CASE pcType = "ROLL"
				ThisFormSet.nMachine = 3
			CASE pcType = "LakeErie"
				ThisFormSet.nMachine = 4
			OTHERWISE
				ThisFormSet.nMachine = 1
			ENDCASE
			*Machine 1= stnd ,2 GFM, 3 Roll, 4 Lake Erie Press
		ELSE
			ThisFormSet.nMachine = 1
		ENDIF
		
		***************************
		*ThisFormSet.Refresh_ERPCert()
		
		PRIVATE nCount
		nCount = 0
			
		SELECT ERPCert
		DO CASE
		CASE NOT EMPTY(ThisFormSet.pcLOT) AND ThisFormSet.nMachine > 1
			**keep lot up first, most releavent 
			*pcType sets ThisFormSet.nMachine
			nCount = ThisFormSet.Get_Cert('LOT',ThisFormSet.pcLOT)
			IF nCount = 0
				MESSAGEBOX("HPA Cert did not find the Cert you where looking for."+CHR(13)+"Lot "+ThisFormSet.pcLOT,64,"Not found")
			ENDIF
			
		CASE NOT EMPTY(ThisFormSet.pcHEAT)
			nCount = ThisFormSet.Get_Cert('HEAT',ThisFormSet.pcHeat)
			IF nCount = 0
				MESSAGEBOX("HPA Cert did not find the Cert you where looking for."+CHR(13)+"Heat "+ThisFormSet.pcHeat,64,"Not found")
			ENDIF
			
		CASE NOT EMPTY(ThisFormSet.pcLOT) 
			**Try lot again, but pcType is unknown 
			nCount = ThisFormSet.Get_Cert('LOT',ThisFormSet.pcLOT)
			IF nCount = 0
				MESSAGEBOX("HPA Cert did not find the Cert you where looking for."+CHR(13)+"Lot "+ThisFormSet.pcLOT,64,"Not found")
			ENDIF
		OTHERWISE
			*Generic get
			nCount = ThisFormSet.Get_Cert("ID",ERPCert.ID)
		ENDCASE
		
		
		*ThisFormSet.Get_Cert( Calls:ThisFormSet.GetCert_CO(nID)
		*and Calls:ThisFormSet.SelectCertID(nID)
		
		********** Get Cert_Co
		
		*!*	PRIVATE nID
		*!*	nID = PrepareSQLnum(ERPCert.ID,'Id',-3)
		*!*	ThisFormSet.GetCert_CO(nID)
		*!*	ThisFormSet.SelectCertID(nID)
		*!*	ThisformSet.Get_Cert_CoCompanies(nID)
		
		*!*	*ThisFormSet.RefreshERPCertCo(nCO_ID)
		*!*	PRIVATE nCO_ID
		*!*	nCO_ID = PrepareSQLnum(ERPCert_Co.CO_ID,'CO_ID',-3)
		*!*	*ThisFormSet.RefreshERPCertCo(nCO_ID)
		
		
		*ThisFormSet.Get_Cert( Calls:Count_Cert_Heat
		*!*	PRIVATE nHeatCnt
		*!*	nHeatCnt = Count_Cert_Heat( ERPCert.Heat, ThisFormSet.nConnHandle )
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = nHeatCnt
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = Count_Cert_Heat_Lot( ERPCert.Heat, ERPCert.Lot, ThisFormSet.nConnHandle )
		*!*	ThisFormset.frmSearch.txtHeatCount.Value = 0
		*!*	ThisFormset.frmSearch.txtLotCount.Value = 0
		*!*	IF nHeatCnt > 1
		*!*		ThisFormset.ERPCert.PF1.pgCert.cmdBrowse.Visible = .T.
		*!*	ENDIF
		
		
		
	ENDPROC

	PROCEDURE Load
		PUBLIC ARRAY gaCompany(1,2)
		
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT TOP 1 * FROM dbo.Cert WITH(NOLOCK)"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert')
		ENDIF
		
	ENDPROC

	PROCEDURE nlotv		&& Funtion to check Lot numbers
	ENDPROC

	PROCEDURE refreshERPCertco
		PARAMETERS nCO_ID
		LOCAL loFrmCustomer
		loFrmCustomer = ThisFormSet.GetFrmCustomer()
		*ThisFormSet.RefreshERPCertCo(CO_ID)
		
		IF nCO_ID > 0
			loFrmCustomer.txtCO_ID.Value	= ERPCert_Co.CO_ID
			loFrmCustomer.SalesNum.Value	= ERPCert_Co.SalesNum
			loFrmCustomer.ItemSO.Value	= RIGHT(ERPCert_Co.SOitem,2)
			loFrmCustomer.Company.Value	= ERPCert_Co.Company
			loFrmCustomer.POnum.Value		= ERPCert_Co.PONum
			loFrmCustomer.PartNo.Value	= ERPCert_Co.PartNo
			loFrmCustomer.Pcs.Value		= ERPCert_Co.Pcs
			loFrmCustomer.Description.Value	= ERPCert_Co.description
		ELSE
			ThisFormSet.ERPCertCoBlank()
		ENDIF
		
		
	ENDPROC

	PROCEDURE refreshfind_rev
		*ThisForm.RefreshFind_Rev()
		
		PRIVATE cGroup, cSpec, cRev
		cGroup	= ThisformSet.frmCheckSpec.cmbGroup.Value 
		cSpec	= ThisformSet.frmCheckSpec.cmbSpec.Value
		
		DIMENSION aRev(1)
		SELECT DISTINCT Spec_check.rev;
		 FROM spec_check;
		 WHERE Spec_check.Group = cGroup;
		 AND Spec_check.Spec = cSpec;
		 ORDER BY Spec_check.Rev;
		 INTO ARRAY aRev
		 
		ThisformSet.frmCheckSpec.cmbRev.NumberOfElements = ALEN(aRev)
		
		ThisformSet.frmCheckSpec.cmbRev.Value = Spec_Check.Rev
		ThisformSet.frmCheckSpec.cmbRev.Refresh
		
		*******************************
		
		*!*	ThisForm.grdSpecRev.RecordSource='' 
		
		*!*	SELECT DISTINCT Spec_Check.Spec, Spec_Check.Rev;
		*!*	 FROM Spec_Check;
		*!*	 WHERE Spec_Check.group = cGroup;
		*!*	 ORDER BY Spec_Check.Spec, Spec_Check.Rev;
		*!*	 INTO CURSOR cursorSpec
		*!*	 
		*!*	ThisForm.grdSpecRev.RecordSource = 'cursorSpec'
		
		
	ENDPROC

	PROCEDURE refreshfind_spec
		*ThisForm.RefreshFind_Spec()
		PRIVATE cGroup, cSpec, cRev
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		cGroup = ThisFormSet.frmCheckSpec.cmbGroup.Value 
		
		DIMENSION aSpec(1)
		SELECT DISTINCT Spec_check.spec, Spec_check.rev;
		 FROM spec_check;
		 WHERE Spec_check.group = cGroup;
		 ORDER BY Spec_check.spec, Spec_check.rev;
		 INTO ARRAY aSpec
		 
		ThisFormSet.frmCheckSpec.cmbSpec.NumberOfElements = ALEN(aSpec)
		
		cSpec = Spec_Check.Spec
		ThisFormSet.frmCheckSpec.cmbSpec.Value = Spec_Check.Spec
		ThisFormSet.frmCheckSpec.cmbSpec.Refresh
		
		*******************************************************
		ThisFormSet.RefreshFind_Rev()
		
	ENDPROC

	PROCEDURE refresh_ERPCert
		PARAMETERS pcWhat
		*ThisFormSet.Refresh_ERPCert()
		
		ThisFormset.ERPCert.PF1.pgCert.txtID.Value			= PrepareSQLnum(ERPCert.ID,'ID',-3)
		ThisFormset.ERPCert.PF1.pgCert.txtStockLst_ID.Value = PrepareSQLnum(ERPCert.StockLst_ID,'StockLst_ID',-3)
		
		ThisFormset.ERPCert.PF1.pgCert.txtReference.Value	= ERPCert.Reference
		ThisFormset.ERPCert.PF1.pgCert.txtDateCert.Value	= PrepareSQLdate(ERPCert.DateCert,'DateCert',.T.,.T.)
		ThisFormset.ERPCert.PF1.pgCert.txtDateProd.Value	= PrepareSQLdate(ERPCert.DateProd,'DateProd',.T.,.T.)
		ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value	= ERPCert.Heat
		ThisFormset.ERPCert.PF1.pgCert.txtLot.Value		= ERPCert.Lot
		ThisFormset.ERPCert.PF1.pgCert.txtAlloy.Value	= ERPCert.Alloy
		ThisFormset.ERPCert.PF1.pgCert.txtSize.Value	= ERPCert.Size
		ThisFormset.ERPCert.PF1.pgCert.txtSpec.Value	= ShowSQLtxt(ERPCert.Spec,'Spec',-1)
		*ThisFormset.ERPCert.PF1.pgCert.txtSpec2.Value	= ERPCert.Spec2
		ThisFormset.ERPCert.PF1.pgCert.txtSpecLMA.Value	= ShowSQLtxt(ERPCert.SpecLMA,'SpecLMA',40)
		ThisFormset.ERPCert.PF1.pgCert.txtSpecSpaceX.Value= ShowSQLtxt(ERPCert.SpecSpaceX,'SpecSpaceX',80)
		ThisFormset.ERPCert.PF1.pgCert.txtUNS.Value		= ShowSQLtxt(ERPCert.UNS,'UNS',10)
		
		ThisFormset.ERPCert.PF1.pgCert.txtAl.Value		= ERPCert.Al
		ThisFormset.ERPCert.PF1.pgCert.txtB.Value		= ERPCert.B
		ThisFormset.ERPCert.PF1.pgCert.txtC.Value		= ERPCert.C
		ThisFormset.ERPCert.PF1.pgCert.txtCa.Value		= ERPCert.Ca
