		DO PROGS\sql_certs_savespacexhardness WITH ThisFormSet
	ENDPROC

	PROCEDURE searchcertid
		PARAMETERS nID
		*ThisFormSet.SearchCertID()
		
	ENDPROC

	PROCEDURE searchheat
		*ThisFormSet.SearchHeat()
		
		PRIVATE nID, cSearchHeat
		nID 	= PrepareSQLnum(ERPCert.ID,'ID',-3)
		IF nID = 0
			nID 	= PrepareSQLnum(ThisFormset.ERPCert.PF1.pgCert.txtID.Value,'ID',-3)
		ENDIF
		cSearchHeat	= PrepareSQLtxt(ThisFormset.frmSearch.txtGetHeat.Value,'Heat',40)
		
		ThisFormSet.cSearchHeat = cSearchHeat
		
		IF USED("tmpCountERPCert")
			SELECT tmpCountERPCert
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Cert WHERE HEAT LIKE '%"+cSearchHeat+"%'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountERPCert')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCountERPCert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountERPCert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountERPCert")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountERPCert')
		ENDIF
		IF USED('tmpCountERPCert')
			SELECT tmpCountERPCert
			IF tmpCountERPCert.CNTD > 0
				*WAIT WINDOW "Found "+ALLTRIM(STR(tmpCountERPCert.CNTD))+" records contain "+ALLTRIM(cSearchHeat)+" in the Heat name." NOWAIT
				
				ThisFormSet.Get_Cert('SEARCHHEAT',cSearchHeat)
				ThisFormSet.ERPCert.PF1.pgCert.cmdUnFilter.Visible = .T.
				
				ThisFormSet.frmSearch.cmdUnFilter.Caption = "FILTERED"
				ThisFormSet.frmSearch.cmdUnFilter.BackColor = RGB(255,0,0)
					
			ELSE
				MESSAGEBOX("Heat:"+ALLTRIM(cSearchHeat)+" was not found!",0+48,"No Heat to show!")
				ThisFormSet.cSearchHeat = ''
				RETURN
			ENDIF
			USE IN tmpCountERPCert
		ENDIF
		
		
		ThisFormSet.ERPCert.PF1.pgCert.Refresh
		
	ENDPROC

	PROCEDURE searchlot
		*ThisFormSet.SearchLot()
		
		PRIVATE nID, nLot
		nID 	= ERPCert.ID
		nLot	= PrepareSQLnum(ThisFormset.frmSearch.txtGetLot.Value,'Lot',-3)
		
		IF nLot = 0
			PRIVATE cLot
			cLot = PrepareSQLtxt(ThisFormset.frmSearch.txtGetLot.Value,'LOT',10)
		
			IF LEN(cLot)>1
				IF PrepareSQLnum( LEFT(cLot,1),'Lot',1) = 0
					*Drop first letter  Could be 'G4229'
					nLot = PrepareSQLnum( RIGHT(cLot, LEN(cLot)-1 ) ,'Lot',5,0)
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("tmpCountERPCert")
			SELECT tmpCountERPCert
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Cert WHERE LOT = "+STR(nLot)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountERPCert')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCountERPCert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountERPCert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCountERPCert")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountERPCert')
		ENDIF
		IF USED('tmpCountERPCert')
			SELECT tmpCountERPCert
			IF tmpCountERPCert.CNTD > 0
				WAIT WINDOW "Found "+ALLTRIM(STR(tmpCountERPCert.CNTD))+" records with the Lot:"+ALLTRIM(STR(nLot))+"." NOWAIT
				
				
				ThisFormSet.Get_Cert('LOT',nLot)
				ThisFormSet.ERPCert.PF1.pgCert.cmdUnFilter.Visible = .T.
				*ThisFormSet.frmSearch.cmdUnFilter.Visible = .T.
				
				ThisFormSet.frmSearch.cmdUnFilter.Caption = "FILTERED"
				ThisFormSet.frmSearch.cmdUnFilter.BackColor = RGB(255,0,0)
				
			ELSE
				MESSAGEBOX("Lot:"+ALLTRIM(STR(nLot))+" was not found!",0+48,"No Heat to show!")
				RETURN
			ENDIF
			USE IN tmpCountERPCert
		ENDIF
		
		
		ThisFormSet.ERPCert.PF1.pgCert.Refresh
		
		
		
		
	ENDPROC

	PROCEDURE selectcertid
		PARAMETER nID
		*ThisFormSet.SelectCertID(ID)
		
		IF VARTYPE(nID) != 'N'
			nID = 0
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT TOP 1 * FROM dbo.Cert WHERE ID="+STR(nID)
		
		IF USED("ERPCert")
			SELECT ERPCert
			TABLEREVERT(.T.,'ERPCert')  &&CURSORSETPROP is not used!, rewrite so this old command can be dropped
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert')
		ENDIF
		
		
		IF USED('ERPCert')
			ThisFormSet.GetCert_CO(nID)
		ELSE
			ThisFormSet.RefreshERPCertCo(0)
		ENDIF
		
		
	ENDPROC

