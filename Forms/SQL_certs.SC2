	PROCEDURE frmCheckSpec.cmbGroup.Valid
		ThisForm.RefreshFind_Spec()
		
		
		
	ENDPROC

	PROCEDURE frmCheckSpec.cmbSpec.GotFocus
		SELECT DISTINCT Spec_check.spec;
		 FROM spec_check;
		 WHERE Spec_check.group = m.Group;
		 ORDER BY Spec_check.spec;
		 INTO ARRAY aSpec
	ENDPROC

	PROCEDURE frmCheckSpec.cmbSpec.Valid
		ThisForm.RefreshFind_Rev()
		
		DIMENSION aRev(1)
		SELECT DISTINCT Spec_check.rev;
		 FROM spec_check;
		 WHERE Spec_check.Group = m.Group;
		 AND Spec_check.Spec = m.Spec;
		 ORDER BY Spec_check.Rev;
		 INTO ARRAY aRev
		 
		ThisForm.cmbRev.NumberOfElements = ALEN(aRev)
		
		IF VARTYPE(aRev(1)) = "L"
			aRev(1) = ''
		ENDIF
		
		ThisForm.cmbRev.Value = aRev(1)
		ThisForm.cmbRev.Refresh
		
	ENDPROC

	PROCEDURE frmCheckSpec.cmdCheck.Click
		DO PROGS\sql_certs_check_spec WITH ThisForm, ThisFormSet
	ENDPROC

	PROCEDURE frmCheckSpec.cmdQuit.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE frmSearch.cmdFindID.Valid
		PRIVATE nID
		nID = PrepareSQLnum(ThisForm.txtID.Value,'CertID',-3)
		IF nID > 0
			ThisFormSet.SelectCertID(nID)
			*ThisFormSet.SearchCertID(nID)
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmSearch.cmdGetHeat.Valid
		ThisFormSet.SearchHeat()
		
		
	ENDPROC

	PROCEDURE frmSearch.cmdGetLot.Valid
		PRIVATE nLot
		
		nLot = PrepareSQLnum(This.parent.txtGetLot.Value,'Lot',-3)
		IF nLot = 0
			PRIVATE cLot
			cLot = PrepareSQLtxt(This.parent.txtGetLot.Value,'LOT',10)
			IF LEN(cLot)>1
				IF PrepareSQLnum( LEFT(cLot,1),'Lot',1) = 0
					*Drop first letter  Could be 'G4229'
					nLot = PrepareSQLnum( RIGHT(cLot, LEN(cLot)-1 ) ,'Lot',-3)
					IF nLot > 0
						This.parent.txtGetLot.Value = PrepareSQLtxt(nLot,'Lot',10)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF nLot > 0
			ThisFormSet.SearchLot()
		ENDIF
		
	ENDPROC

	PROCEDURE frmSearch.cmdUnFilter.Click
		*This.Visible = .F.
		IF This.Caption = "FILTERED"
			ThisFormset.ERPCert.PF1.pgCert.cmdUnFilter.Visible = .F.
		
			ThisFormSet.cSearchHeat = ''
			*ThisForm.PF1.pgCert.txtHeatCount.Enabled = .T.
			ThisFormSet.frmSearch.txtHeatCount.Enabled = .T.
			
			ThisFormSet.frmSearch.cmdUnFilter.Caption = "All Records"
			ThisFormSet.frmSearch.cmdUnFilter.BackColor = RGB(128,255,128)
		ELSE
			*ThisFormSet.frmSearch.cmdUnFilter.Caption = "FILTERED"
			*ThisFormSet.frmSearch.cmdUnFilter.BackColor = RGB(255,0,0)
		ENDIF
	ENDPROC

	PROCEDURE frmSearch.txtGetHeat.Init
		If used('gfmlog')
			This.Value = gfmlog.heat
		endif
	ENDPROC

	PROCEDURE frmSearch.txtGetHeat.LostFocus
		IF NOT EMPTY(This.Value)	
			ThisFormSet.SearchHeat()
		ENDIF
	ENDPROC

	PROCEDURE frmSearch.txtGetLot.Init
		If used('gfmlog')
			This.Value = gfmlog.lot
		endif
	ENDPROC

	PROCEDURE frmSearch.txtGetLot.LostFocus
		IF NOT EMPTY(This.Value)	
			ThisFormSet.SearchLot()
		ENDIF
	ENDPROC

	PROCEDURE frmSearch.txtHeatCount.Click
		
		IF NOT EMPTY(ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value)
			ThisForm.txtGetHeat.Value = ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value
			
			ThisFormSet.SearchHeat()
		ENDIF	
		
	ENDPROC

ENDDEFINE
