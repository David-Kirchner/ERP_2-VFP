		DO SqlCerts_ReleaseFrmSpaceX IN PROGS\sql_certs_spacex_form.prg WITH ThisFormSet
		ThisForm.Release
		ThisFormSet.Release
	ENDPROC

	PROCEDURE ERPCert.PF1.pgCert.cmdDelete.Valid
		PRIVATE currec
		IF ThisFormSet.isediting 	&&Do not SAVE
			*ABORT
			isadding=.F.
			*************
			ThisFormSet.SetNormal
			ThisFormSet.Refresh_ERPCert()
			WAIT WINDOW 'Edit Cancelled' NOWAIT
		
		ELSE   &&do the record delete
			*DELETE
			
			SELECT ERPCert
			IF EOF() OR BOF()
				WAIT WINDOW 'End of File.' NOWAIT
				RETURN
			ENDIF
			currec = recno()
			
			IF AllowCertDelete(ThisFormSet.nConnHandle)
				IF MESSAGEBOX("Are you sure you want to delete this Cert?",4+32,"Delete Cert") = 6
		
					PRIVATE nID,cSQL,nSQLEXEC 
					nID = ThisForm.PF1.pgCert.txtID.Value
					
					cSQL = "DELETE FROM dbo.Cert_Co WHERE ID = "+STR(nID)
					
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					cSQL = "DELETE FROM dbo.Cert WHERE ID ="+STR(nID)
		
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
					ENDIF
					
					IF EMPTY(ERPCert.Heat)
						ThisFormSet.Refresh_ERPCert('DELETED')
					ELSE
		*				ThisForm.txtGetHeat.Value = ERPCert.Heat
						This.parent.txtGetHeat.Value = ERPCert.Heat
						ThisFormSet.SearchHeat()
					ENDIF
				ENDIF
			ELSE
				MESSAGEBOX('You do not have Permission to delete!',48,'No Delete')
			ENDIF
		
			ThisForm.PF1.pgCert.Refresh
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE ERPCert.PF1.pgCert.cmdEdit.Click
		IF ThisFormSet.isediting
		*	SAVE THIS
			IF ThisFormSet.CheckCert()
				IF ThisFormSet.SaveCert()
				
				ENDIF
			ENDIF
		ELSE &&ThisFormSet.isediting
			SELECT ERPCert
			*Edit !!!
			IF EOF() OR BOF()
				=MESSAGEBOX('End of File',16)
				RETURN
			ENDIF
			
		*	Must match Array in cmdEdit-Save
		*	Start Editting
			SCATTER FIELDS LIKE Al,B,C,Cb,Co,Cr,Cu,Fe,H,Mg,Mo,Mn,N,Na,Ni,O,P,S,Si,Ta,Ti,V,W,Y,CbandTa,NiandCo,Other TO gaChemistry
			*SCATTER FIELDS LIKE grainsizem,hardness,CORROSIONR,ULT1,yield1,elong1,ELONINCHES,ra1,SrTemp,SrStress,SrHours,SrRA,SrElong,HEATTREAT TO gaPhysical
			SCATTER FIELDS LIKE grainsizem,CorrosionR,SrTemp,SrStress,SrHours,SrRA,SrElong,HEATTREAT TO gaPhysical
			SCATTER FIELDS LIKE hardness,BHN,ULT1,yield1,elong1,ELONINCHES,ra1,hardness2,BHN2,ULT2,yield2,elong2,ELONINCHES2,ra2,hardness3,BHN3,ULT3,yield3,elong3,ELONINCHES3,ra3 TO gaMechanical
			SCATTER FIELDS LIKE heat, lot, machine, QA, QARev, MercFree, NoWeld TO gaCert
		
			IF signed
				IF MESSAGEBOX("Editing the chemical or physical properties of this Cert"+CHR(13)+"will remove the signature."+CHR(13)+"Do you want to continue with edit?",4+32,"This Cert is Signed.") = 7
					return
				ENDIF
			ENDIF
			
			WAIT WINDOW "Only user belonging to the 'WINDFALL\Certs' group are allowed to save to the Certs table." NOWAIT
			
		*	IF ISRLOCKED()
		*		ThisFormSet.SetNormal
		*		=MESSAGEBOX('Record could not be Lock for you.  Try again!',16)
		*	ELSE
				ThisFormSet.SetEditing()
		*	ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE ERPCert.PF1.pgCert.cmdEdit.Valid
		IF ThisFormSet.isediting
			ThisForm.PF1.pgCert.txtAlloy.SetFocus
		ENDIF
		ThisForm.PF1.pgCert.Refresh
		
	ENDPROC

	PROCEDURE ERPCert.PF1.pgCert.cmdNext.Click
		
		IF This.parent.cmdUnFilter.Visible
			*Go next of Heat!	
			SELECT ERPCert
			IF RECCOUNT('ERPCert') > RECNO('ERPCert')
		
				SKIP 1
				ThisForm.PF1.pgCert.Refresh
				
				ThisFormSet.Refresh_ERPCert()
				
			ELSE
				MESSAGEBOX("You are at the end of the 'Filtered' view."+CHR(13)+"Unfilter to see other certs.",0+48,"End of View.") 
			ENDIF
		ELSE
			PRIVATE nID
			nID = ERPCert.ID
		
			PRIVATE cSQL, nSQLEXEC,nMaxID 
			nMaxID = 1000
		
		
			cSQL = "SELECT MAX(ID) AS MAXID FROM dbo.Cert "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCert')
			ENDIF
			IF USED("tmpCert")
				nMaxID = tmpCert.MAXID
				USE IN tmpCert
			ENDIF
		
		
			IF USED("ERPCert")
				SELECT ERPCert
			ELSE
				SELECT 0
			ENDIF
		
			**********************
			DO WHILE nID <= nMaxID 
				nID = nID + 1
				IF ThisFormSet.Get_Cert("ID",nID) > 0
					EXIT
				ENDIF
			ENDDO
			**********************
			
			IF nID >= nMaxID 
				MESSAGEBOX('End of File',64,'')
			ENDIF
			ThisForm.PF1.pgCert.Refresh
		ENDIF
	ENDPROC

	PROCEDURE ERPCert.PF1.pgCert.cmdPrev.Click
		
		IF This.parent.cmdUnFilter.Visible
			*Go next of Heat!	
			SELECT ERPCert
			IF RECNO('ERPCert') > 1
				SKIP -1
				ThisForm.PF1.pgCert.Refresh
						
				ThisFormSet.Refresh_ERPCert()
				
			ELSE
				MESSAGEBOX("You are at the begining of the 'Filtered' view."+CHR(13)+"Unfilter to see other certs.",0+48,"Begining of View.") 
			ENDIF
		ELSE
			PRIVATE nID
			nID = ERPCert.ID
		
			PRIVATE cSQL, nSQLEXEC
		
			IF USED("ERPCert")
				SELECT ERPCert
			ELSE
				SELECT 0
			ENDIF
		
			DO WHILE nID > 1
				nID = nID - 1
		
				IF ThisFormSet.Get_Cert("ID",nID) > 0
					EXIT
				ENDIF
			ENDDO
		
			IF nID <= 1
				MESSAGEBOX('Beginning of File',64,'')
			ENDIF
		
			ThisForm.PF1.pgCert.Refresh
		
		ENDIF
	ENDPROC

	PROCEDURE ERPCert.PF1.pgCert.cmdPrint1.Valid
		local m.currntrecrd
		
		IF NOT USED("ERPCert_Co")
			MESSAGEBOX("Could not load the Customer Specific Database",0,"Data load Error")
		ENDIF
		
		PRIVATE cHeatLot, cLot, nMachine
		cHeatLot = PrepareSQLtxt(ERPCert.Heat,'Heat',50)
		cLot	= PrepareSQLtxt(ERPCert.Lot,'Lot',5)
		nMachine = PrepareSQLnum(ERPCert.Machine,'Machine',1,0)
		
		DO CASE
		CASE nMachine = 0
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" "+cLot
			ENDIF
		CASE nMachine = 1
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" G"+cLot
			ENDIF
		CASE nMachine = 2
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" R"+cLot
			ENDIF
		CASE nMachine = 3
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" L"+cLot
			ENDIF
		OTHERWISE
			IF LEN(cLot) > 1
				cHeatLot = ALLTRIM(cHeatLot)+" "+cLot
			ENDIF
		ENDCASE
		
		SELECT ERPCert
		m.currntrecrd = recno('ERPCert')
		*REPORT FORM Reports\certs RECORD m.currntrecrd TO PRINTER PROMPT NOCONSOLE
		REPORT FORM Reports\certs_Set1 RECORD m.currntrecrd TO PRINTER PROMPT NOCONSOLE
		
		*******************************************************
		
		*Works if they are a SalesP!
		PRIVATE cSales
		cSalesP = AppSetup_Get_SalesP()
		
		IF LEN(cSalesP) > 0
		
			PRIVATE nMess
			nMess = MESSAGEBOX("Do you want to Email this Cert?",4+48,"Send thru Email")
			IF nMess = 6
				PRIVATE cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, cNewPDFName
				PRIVATE cEmail, cHomeSalesp 
				cHomeSalesp = ""
				
				cNewPDFName	= "HPA_Cert_"+ALLTRIM(STR(ERPCert.ID))+".PDF"
				cFileName = EmailFileName(cNewPDFName) &&in Proc_ERP - Adds Current DB folder to use.
				cEmailTo	= AppSetup_Get_Email()
				cEmailFrom	= get_Server_Email()
				
				cSubject	= "Cert #"+ALLTRIM(STR( ERPCert.ID ))+" from Space Alloys USA"
				cMessage	= ""
		
				**********************
		
				DO WHILE FILE(cFileName)
					nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
					IF nMess = 7 &&No
						DELETE FILE (cFileName)
					ENDIF
				ENDDO
			
		
				*****************************
				Local loListener As "PdfListener" Of "Pdfx.vcx"
		
				loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
				loListener.cCodePage="CP1252" &&CodePage
				loListener.cTargetFileName = cFileName
				loListener.QuietMode=.F.
				loListener.lCanPrint=.T.
				loListener.lCanEdit=.F.
				loListener.lCanCopy=.T.
				loListener.lCanAddNotes=.F.
				loListener.lEncryptDocument=.F.
				loListener.cMasterPassword=''
				loListener.cUserPassword=''
				loListener.lOpenViewer=.F.
				
				THISFORM.VISIBLE = .F.
		
				REPORT FORM Reports\certs_Set1 RECORD m.currntrecrd Object loListener
				
				RELEASE loListener
				THISFORM.VISIBLE = .T.			
				*******************************
				
				WAIT WINDOW "Making PDF" TIMEOUT 1	
				PRIVATE nCount
				nCount = 0
				DO WHILE NOT FILE(cFileName) AND nCount < 5
					WAIT WINDOW "Waiting for file:"+cFileName+" to be made." TIMEOUT 1
					nCount = nCount + 1
				ENDDO
				
				cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName)
				
				DO CASE
				CASE "Mail queued" $ cAns
					WAIT WINDOW "Mail queued." NOWAIT
					*TrackMess("SO "+ALLTRIM(STR(ThisFormSet.SalesNum))+" Proforma was Emailed to ("+cEmail+") on ("+DTOC(DATE())+")"+" "+PROGRAM() )
					
				CASE NOT LEN(ALLTRIM(cAns))=0
					MESSAGEBOX( cANS,0,"SQL Returned Message!")
				OTHERWISE
					WAIT WINDOW "Email Complete" NOWAIT
					*TrackMess("Proforma "+ALLTRIM(STR(ThisFormSet.SalesNum))+" was Emailed to ("+cEmail+") on ("+DTOC(DATE())+")"+" "+PROGRAM() )
					
				ENDCASE
		
				RELEASE loListener
				
				********************************
				
				IF FILE(cFileName)
					DELETE FILE (cFileName)
				ENDIF
			ENDIF
		ENDIF
		
		*******************
		SELECT ERPCert
		IF m.currntrecrd <= RECCOUNT('ERPCert')
			GOTO m.currntrecrd
		ELSE
			GO TOP
		ENDIF
		
	ENDPROC

	PROCEDURE ERPCert.PF1.pgCert.cmdPrint12.Valid
		local m.currntrecrd
		
		IF NOT USED("ERPCert_Co")
			MESSAGEBOX("Could not load the Customer Specific Database",0,"Data load Error")
		ENDIF
		
		SELECT ERPCert
		m.currntrecrd = recno('ERPCert')
		*REPORT FORM Reports\certs RECORD m.currntrecrd TO PRINTER PROMPT NOCONSOLE
		REPORT FORM Reports\certs12 RECORD m.currntrecrd TO PRINTER PROMPT NOCONSOLE
		
		
		IF MESSAGEBOX("Do you want to send email from Outlook?",4+64,"Email")=6
			
			***************************************
			PRIVATE cFileName, cNewPDFName
			cFileName = EmailFileName("HPA_Cert.PDF")
			cNewPDFName = "HPA_Cert_"+ALLTRIM(STR(ERPCert.ID))+".PDF"
			
			DO WHILE FILE(cFileName)
				nMess = MESSAGEBOX("Email Send is busy."+CHR(13)+"Are you ready to try again? (Y)"+CHR(13)+"Answer No only if you have waited and believe the last email failed and needs to be cleared.",4+48,"Please wait...")
				IF nMess = 7 &&No
					DELETE FILE (cFileName)
				ENDIF
			ENDDO
			
			*****************************
			LOCAL loListener AS "PdfListener" OF "Pdfx.vcx"
		
			loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
			loListener.cCodePage="CP1252" &&CodePage
			loListener.cTargetFileName = cFileName
			loListener.QuietMode=.F.
			loListener.lCanPrint=.T.
			loListener.lCanEdit=.F.
			loListener.lCanCopy=.T.
			loListener.lCanAddNotes=.F.
			loListener.lEncryptDocument=.F.
			loListener.cMasterPassword=''
			loListener.cUserPassword=''
			loListener.lOpenViewer=.F.
		
			THISFORM.VISIBLE = .F.		
		
			REPORT FORM Reports\certs12 RECORD m.currntrecrd Object loListener
				
			RELEASE loListener		
			THISFORM.VISIBLE = .T.
			
			********************************
			IF FILE(cFileName)
				#DEFINE olFolderInbox 6
				#DEFINE olFolderOutbox 4
				#DEFINE olMailItem 0
				#DEFINE olRecipient 4
				#DEFINE olRecipients 17
				#DEFINE IMPORTANCENORMAL 1
				loApp=CreateObject("Outlook.Application")
				IF VARTYPE(loApp)="O"
					loNamespace = loApp.GetNamespace("MAPI")
					loFolder = loNamespace.GetDefaultFolder(olFolderInbox)
					loEMailItem = loFolder.Items.Add(olMailItem)
					loEmailItem.Subject = "HPA Cert"
					loEmailItem.Importance = IMPORTANCENORMAL
					loEmailItem.HTMLBody = [<html><font face = "Arial">];
					+ [<font size = 2> <font color = 0>Space Alloys USA Cert</font></html>]
					
					loEmailItem.Attachments.Add(cFileName)
		
					loemailitem.Display()
					*loEmailItem.Send
					*loApp.Quit()
					RELEASE loApp, loEmailItem
					
					WAIT WINDOW "Click on the blinking Outlook window to address you Email" NOWAIT
				ENDIF
			ELSE
				MESSAGEBOX("Failed to create file."+CHR(13)+cFileName,16,"File not Created.")
			ENDIF	
			IF FILE(cFileName)
				DELETE FILE (cFileName)
			ENDIF
			
		ENDIF
		
		
		SELECT ERPCert
		IF m.currntrecrd <= RECCOUNT('ERPCert')
			GOTO m.currntrecrd
		ELSE
			GO TOP
		ENDIF
		
		
	ENDPROC

