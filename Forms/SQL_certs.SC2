		ThisFormset.ERPCert.PF1.pgCert.txtHeatTreat.Value	= ERPCert.HeatTreat
		
		ThisFormset.ERPCert.PF1.pgCert.txtCorrosionr.Value = ERPCert.Corrosionr
		ThisFormset.ERPCert.PF1.pgCert.txtGrainsize.Value = ERPCert.Grainsize
		ThisFormset.ERPCert.PF1.pgCert.txtTestPO.Value	= PrepareSQLtxt(ERPCert.TestPO,'POitem',12)
		ThisFormset.ERPCert.PF1.pgCert.txtLabUsed.Value = ERPCert.LabUsed
		ThisFormset.ERPCert.PF1.pgCert.txtTestPO2.Value	= PrepareSQLtxt(ERPCert.TestPO2,'POitem',12)
		ThisFormset.ERPCert.PF1.pgCert.txtLabUsed2.Value = ERPCert.LabUsed2
		
		ThisFormset.ERPCert.PF1.pgCert.grpMach.Value	= ERPCert.Machine
		ThisFormset.ERPCert.PF1.pgCert.edtXtraInfo.Value = ERPCert.XtraInfo
