		*cSQL = cSQL +",BHN4="+STR(nBHN4,4,0)
		cSQL = cSQL +",ElonInches4='"+cElonInches4+"'"
		cSQL = cSQL +",tLoc4='"+ctLoc4+"'"
		
		cSQL = cSQL +",Ult5 ="+STR(nUlt5,10,0)
		cSQL = cSQL +",Yield5="+STR(nYield5,10,0)
		cSQL = cSQL +",Elong5="+STR(nElong5,5,1)
		cSQL = cSQL +",RA5="+STR(nRA5,5,1)
		*cSQL = cSQL +",Hardness5='"+cHardness5+"'"
		*cSQL = cSQL +",BHN5="+STR(nBHN5,4,0)
		cSQL = cSQL +",ElonInches5='"+cElonInches5+"'"
		cSQL = cSQL +",tLoc5='"+ctLoc5+"'"
		
		cSQL = cSQL +",Ult6 ="+STR(nUlt6,10,0)
		cSQL = cSQL +",Yield6="+STR(nYield6,10,0)
		cSQL = cSQL +",Elong6="+STR(nElong6,5,1)
		cSQL = cSQL +",RA6="+STR(nRA6,5,1)
		cSQL = cSQL +",ElonInches6='"+cElonInches6+"'"
		cSQL = cSQL +",tLoc6='"+ctLoc6+"'"
		
		cSQL = cSQL +",Ult7 ="+STR(nUlt7,10,0)
		cSQL = cSQL +",Yield7="+STR(nYield7,10,0)
		cSQL = cSQL +",Elong7="+STR(nElong7,5,1)
