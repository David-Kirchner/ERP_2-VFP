		*=MESSAGEBOX("Balance of "+CHR(13)+m.balelement+" is "+STR((100-m.eltot),5,2)+"%",48,'Found Balance.')
		RETURN 100-m.eltot
		
	ENDPROC

	PROCEDURE convertform		&& Form digit to decription.
		PARAMETER pFORM, pTHCK
		
		DO CASE
		CASE pFORM = "10"
			cForm = "Bar"
		CASE pFORM = "20"
			cForm = "Wire"
		CASE pFORM = "40"
			IF pTHCK > .2
				cForm = "Plate"
			ELSE
				cForm = "Sheet"
			ENDIF
		CASE pFORM = "51"
			cForm = "Coil"
		OTHERWISE
			cForm = " "
		ENDCASE 	
		RETURN cForm
		
	ENDPROC

	PROCEDURE createtable_certspx
		PARAMETERS nCertID
		*CreateTable_CertSPX()
		
		PRIVATE lOK
		lOK = .F.
		
		SELECT 0
		IF USED('CertSPX')
			USE IN CertSPX
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT "
		cSQL=cSQL+" ISNULL([-3.875],0) AS N3875,ISNULL([-3.750],0) AS N3750,ISNULL([-3.625],0) AS N3625,ISNULL([-3.500],0) AS N3500"
		cSQL=cSQL+",ISNULL([-3.375],0) AS N3375,ISNULL([-3.250],0) AS N3250,ISNULL([-3.125],0) AS N3125,ISNULL([-3.000],0) AS N3000"
		cSQL=cSQL+",ISNULL([-2.875],0) AS N2875,ISNULL([-2.750],0) AS N2750,ISNULL([-2.625],0) AS N2625,ISNULL([-2.500],0) AS N2500"
		cSQL=cSQL+",ISNULL([-2.375],0) AS N2375,ISNULL([-2.250],0) AS N2250,ISNULL([-2.125],0) AS N2125,ISNULL([-2.000],0) AS N2000"
		cSQL=cSQL+",ISNULL([-1.875],0) AS N1875,ISNULL([-1.750],0) AS N1750,ISNULL([-1.625],0) AS N1625,ISNULL([-1.500],0) AS N1500"
		cSQL=cSQL+",ISNULL([-1.375],0) AS N1375,ISNULL([-1.250],0) AS N1250,ISNULL([-1.125],0) AS N1125,ISNULL([-1.000],0) AS N1000"
		cSQL=cSQL+",ISNULL([-0.875],0) AS N0875,ISNULL([-0.750],0) AS N0750,ISNULL([-0.625],0) AS N0625,ISNULL([-0.500],0) AS N0500"
		cSQL=cSQL+",ISNULL([-0.375],0) AS N0375,ISNULL([-0.250],0) AS N0250,ISNULL([-0.125],0) AS N0125,ISNULL( [0.000],0) AS P0000"
		cSQL=cSQL+",ISNULL([0.125],0) AS P0125,ISNULL([0.250],0) AS P0250,ISNULL([0.375],0) AS P0375"
		cSQL=cSQL+",ISNULL([0.500],0) AS P0500,ISNULL([0.625],0) AS P0625,ISNULL([0.750],0) AS P0750,ISNULL([0.875],0) AS P0875"
		cSQL=cSQL+",ISNULL([1.000],0) AS P1000,ISNULL([1.125],0) AS P1125,ISNULL([1.250],0) AS P1250,ISNULL([1.375],0) AS P1375"
		cSQL=cSQL+",ISNULL([1.500],0) AS P1500,ISNULL([1.625],0) AS P1625,ISNULL([1.750],0) AS P1750,ISNULL([1.875],0) AS P1875"
		cSQL=cSQL+",ISNULL([2.000],0) AS P2000,ISNULL([2.125],0) AS P2125,ISNULL([2.250],0) AS P2250,ISNULL([2.375],0) AS P2375"
		cSQL=cSQL+",ISNULL([2.500],0) AS P2500,ISNULL([2.625],0) AS P2625,ISNULL([2.750],0) AS P2750,ISNULL([2.875],0) AS P2875"
		cSQL=cSQL+",ISNULL([3.000],0) AS P3000,ISNULL([3.125],0) AS P3125,ISNULL([3.250],0) AS P3250,ISNULL([3.375],0) AS P3375"
		cSQL=cSQL+",ISNULL([3.500],0) AS P3500,ISNULL([3.625],0) AS P3625,ISNULL([3.750],0) AS P3750,ISNULL([3.875],0) AS P3875"
		cSQL=cSQL+" "
		cSQL=cSQL+" FROM "
		cSQL=cSQL+"( SELECT Inch,RockC "
		cSQL=cSQL+"	FROM dbo.Cert_RC_profile WHERE CertID="
		cSQL=cSQL+STR(nCertID)
		cSQL=cSQL+" ) AS p "
		cSQL=cSQL+" PIVOT "
		cSQL=cSQL+"(MAX(RockC) FOR Inch IN "
		cSQL=cSQL+"("
		cSQL=cSQL+" [-3.875],[-3.750],[-3.625],[-3.500],[-3.375],[-3.250],[-3.125],[-3.000]"
		cSQL=cSQL+",[-2.875],[-2.750],[-2.625],[-2.500],[-2.375],[-2.250],[-2.125],[-2.000]"
		cSQL=cSQL+",[-1.875],[-1.750],[-1.625],[-1.500],[-1.375],[-1.250],[-1.125],[-1.000]"
		cSQL=cSQL+",[-0.875],[-0.750],[-0.625],[-0.500],[-0.375],[-0.250],[-0.125]"
		cSQL=cSQL+",[0.000],[0.125],[0.250],[0.375],[0.500],[0.625],[0.750],[0.875]"
		cSQL=cSQL+",[1.000],[1.125],[1.250],[1.375],[1.500],[1.625],[1.750],[1.875]"
		cSQL=cSQL+",[2.000],[2.125],[2.250],[2.375],[2.500],[2.625],[2.750],[2.875]"
		cSQL=cSQL+",[3.000],[3.125],[3.250],[3.375],[3.500],[3.625],[3.750],[3.875]"
		cSQL=cSQL+")"
		cSQL=cSQL+") AS pvt; "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CertSPX')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CertSPX')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CertSPX")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CertSPX")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'CertSPX')
		ENDIF
		
		IF USED('CertSPX')
			IF RECCOUNT('CertSPX') > 0
				lOK = .T.
			ELSE
				MESSAGEBOX("Could not get the Hardness profile data"+CHR(13)+"This will not Print!",0+48,"No data")
			ENDIF
		ENDIF
		
		
		RETURN lOK
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE enablespacexhardness
		LPARAMETERS lEnable
		DO SqlCerts_EnableSpaceXHardness IN PROGS\sql_certs_spacex_form.prg WITH ThisFormSet, lEnable
	ENDPROC

	PROCEDURE ERPCertcoblank
		LOCAL loFrmCustomer
		loFrmCustomer = ThisFormSet.GetFrmCustomer()
		
		IF USED("ERPCert_Co")
			USE IN ERPCert_Co
		ENDIF
		
		SELECT 0
		
		
		cSQL = "SELECT * FROM dbo.Cert_Co WITH(NOLOCK) WHERE 0>0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert_Co')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert_Co')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert_Co")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert_Co")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert_Co')
		ENDIF
		
		IF USED('ERPCert_Co')
		
			SELECT ERPCert_Co
		
			loFrmCustomer.txtCO_ID.Value	= ERPCert_Co.CO_ID
			loFrmCustomer.SalesNum.Value	= ERPCert_Co.SalesNum
			loFrmCustomer.ItemSO.Value	= RIGHT(ERPCert_Co.SOitem,2)
			loFrmCustomer.Company.Value	= ERPCert_Co.Company
			loFrmCustomer.POnum.Value		= ERPCert_Co.PONum
			loFrmCustomer.PartNo.Value	= ERPCert_Co.PartNo
			loFrmCustomer.Pcs.Value		= ERPCert_Co.Pcs
			loFrmCustomer.Description.Value	= ERPCert_Co.description
		
		ENDIF
		
		
		ThisFormSet.isediting_co = .T.
		loFrmCustomer.cmdAdd.Caption = "Add"
		loFrmCustomer.cmdEdit.Caption = "Abort"
	ENDPROC

	PROCEDURE getcert_co
		PARAMETER pnCert_ID
		*ThisFormSet.GetCert_CO(Cert_ID)
		
		PRIVATE nCert_ID, nCO_ID
		LOCAL loFrmCustomer
		loFrmCustomer = ThisFormSet.GetFrmCustomer()
		
		IF VARTYPE(pnCert_ID) = "N"
			nCert_ID = pnCert_ID
		ELSE
			nCert_ID = 0
		ENDIF
		
		IF USED("ERPCert_Co")
			loFrmCustomer.grdCO.RecordSource = ""
			USE IN ERPCert_Co
		ENDIF
		SELECT 0
		
		cSQL = "SELECT *, LEFT(Company,20) AS Comp FROM dbo.Cert_Co WHERE ID = "+STR(nCert_ID)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert_Co')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'ERPCert_Co')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert_Co")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert_Co")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert_Co')
		ENDIF
		
		IF USED('ERPCert_Co')
		
			loFrmCustomer.grdCO.RecordSource = "ERPCert_Co"
			loFrmCustomer.grdCO.ColumnCount = 3
			loFrmCustomer.grdCO.Column1.Header1.Caption = "CO_ID"
			loFrmCustomer.grdCO.Column1.ControlSource = "ERPCert_Co.CO_ID"
			loFrmCustomer.grdCO.Column1.Width = 40
			
			loFrmCustomer.grdCO.Column2.Header1.Caption = "Company"
			loFrmCustomer.grdCO.Column2.ControlSource = "ERPCert_Co.Comp"
			loFrmCustomer.grdCO.Column2.Width = 100
		*	loFrmCustomer.grdCO.Column2.Text1.Alignment = 1
			loFrmCustomer.grdCO.Column2.Text1.FontSize = 7
			
			loFrmCustomer.grdCO.Column3.Header1.Caption = "SO item"
			loFrmCustomer.grdCO.Column3.ControlSource = "ERPCert_Co.SOitem"
			loFrmCustomer.grdCO.Column3.Width = 90
		*	loFrmCustomer.grdCO.Column3.Text1.Alignment = 2
			
			nCO_ID = ERPCert_Co.CO_ID
			
			ThisFormSet.RefreshERPCertCo(nCO_ID)
			ThisformSet.Get_Cert_CoCompanies(nCert_ID)
			
		ELSE
			ThisFormSet.RefreshERPCertCo(0)
		ENDIF
		
	ENDPROC

	PROCEDURE GetFrmCustomer
		LOCAL loFrm
		IF VARTYPE(This.oFrmCustomer) = "O" AND !ISNULL(This.oFrmCustomer)
			IF TYPE("This.oFrmCustomer.Name") = "C"
				IF This.oFrmCustomer.DataSessionID = This.DataSessionID
					RETURN This.oFrmCustomer
				ENDIF
				This.oFrmCustomer.Release
				This.oFrmCustomer = .NULL.
			ENDIF
		ENDIF
		DO FORM Forms\sql_certs_frmCustomer WITH This NAME loFrm LINK NOSHOW
		This.oFrmCustomer = loFrm
		RETURN loFrm
	ENDPROC

	PROCEDURE getgfmlotprop
		PARAMETERS nLot,cHeat
		*ThisFormSet.GetGFMlotProp
		
		IF VARTYPE(nLot) != 'N'
			RETURN .F.
		ENDIF
		
		*Reset certain fields
		ThisFormset.ERPCert.PF1.pgCert.txtGrainSize.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtCorrosionr.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHeatTreat.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtSrHours.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSrTemp.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSrStress.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSrRa.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSRElong.Value = ''
		*Reset certain fields in LMA
		ThisFormset.ERPCert.PF1.pgCert.txttLoc1.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtBHN.Value = 0
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness2.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtBHN2.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc2.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness3.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtBHN3.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc3.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl4.Value = ''
		*ThisFormset.ERPCert.PF1.pgCert.txtHardness4.Value = ' '
		*ThisFormset.ERPCert.PF1.pgCert.txtBHN4.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc4.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl5.Value = ''
		*ThisFormset.ERPCert.PF1.pgCert.txtHardness5.Value = ' '
		*ThisFormset.ERPCert.PF1.pgCert.txtBHN5.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc5.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txttLoc6.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txttLoc7.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtSpecLMA.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSpecSpaceX.Value = ''
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpGFMlog')	
			USE IN tmpGFMlog
		ENDIF
		
		cSQL = "SELECT * FROM dbo.GFMlog WHERE Lot = "+STR(nLot)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpGFMlog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpGFMlog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpGFMlog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpGFMlog")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpGFMlog')
			RETURN
		ELSE
			IF USED('tmpGFMlog')
				IF RECCOUNT('tmpGFMlog') > 0
		
					IF tmpGFMlog.heat != cHeat
						IF AT('-',tmpGFMlog.heat,1) > 1
							cgfmlogHeat = LEFT(tmpGFMlog.heat,AT('-',tmpGFMlog.heat,1)-1)
						ELSE
							cgfmlogHeat = ALLTRIM(tmpGFMlog.heat)
						ENDIF
						IF AT('-',cHeat,1) > 1
							cCertHeat = LEFT(cHeat,AT('-',cHeat,1)-1)
						ELSE
							cCertHeat = ALLTRIM(cHeat)
						ENDIF
						
						IF cgfmlogHeat != cCertHeat 
							MESSAGEBOX("GFM LOG Heat:"+cgfmlogHeat+" does not match Cert Heat:"+cCertHeat ,16,"Heat numbers do not match!")
						ENDIF
					ENDIF
		
		
					SELECT ERPCert
					ThisFormset.ERPCert.PF1.pgCert.txtUlt.Value		= PrepareSQLnum(tmpGFMlog.tensile,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYield.Value	= PrepareSQLnum(tmpGFMlog.yield,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtElong.Value	= PrepareSQLnum(tmpGFMlog.elongation,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtElonInches.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txtRA.Value		= PrepareSQLnum(tmpGFMlog.Red_Area,'Red_Area',4,1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtHardness.Value = IIF(!empty(tmpGFMlog.rockwell),"R"+LOWER(tmpGFMlog.rockwell)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN.Value = PrepareSQLnum(tmpGFMlog.bhn,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txttLoc1.Value = PrepareSQLtxt(tmpGFMlog.tLoc,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtLot.Value = nLot
					ThisFormset.ERPCert.PF1.pgCert.txtReference.Value = 'GFM'
					ThisFormset.ERPCert.PF1.pgCert.grpMach.Value = 2
					ThisFormset.ERPCert.PF1.pgCert.txtDateCert.Value = (tmpGFMlog.testsent)+3
					ThisFormset.ERPCert.PF1.pgCert.txtDateProd.Value = tmpGFMlog.date
					ThisFormset.ERPCert.PF1.pgCert.txtAlloy.Value = PrepareSQLtxt(tmpGFMlog.ALLOYNAME,'Alloy',35)    &&C12
					ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value =  PrepareSQLtxt(tmpGFMlog.heat,'Heat',50)       &&C35
					ThisFormset.ERPCert.PF1.pgCert.txtSize.Value = "Bar"			
					ThisFormset.ERPCert.PF1.pgCert.txtSpec.Value = PrepareSQLtxt(tmpGFMlog.SPEC,'Spec',-1)        &&C40
		
					ThisFormset.ERPCert.PF1.pgCert.txtTestPO.Value = PrepareSQLtxt(tmpGFMlog.TestPO,'POitem',12)
					ThisFormset.ERPCert.PF1.pgCert.txtLabUsed.Value = PrepareSQLtxt(tmpGFMlog.lab,'Lab',12)
					ThisFormset.ERPCert.PF1.pgCert.txtTestPO2.Value = PrepareSQLtxt(tmpGFMlog.TestPO2,'POitem',12)
					ThisFormset.ERPCert.PF1.pgCert.txtLabUsed2.Value = PrepareSQLtxt(tmpGFMlog.Lab2,'Lab',12)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt2.Value = PrepareSQLnum(tmpGFMlog.Tensile2,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld2.Value = PrepareSQLnum(tmpGFMlog.Yield2,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl2.Value = PrepareSQLnum(tmpGFMlog.elongation2,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA2.Value = PrepareSQLnum(tmpGFMlog.Red_Area2,'Red_Area',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtHardness2.Value = IIF(!empty(tmpGFMlog.rockwell2),"R"+LOWER(tmpGFMlog.rockwell2)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN2.Value = PrepareSQLnum(tmpGFMlog.BHN2,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches2.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc2.Value = PrepareSQLtxt(tmpGFMlog.tLoc2,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt3.Value = PrepareSQLnum(tmpGFMlog.Tensile3,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld3.Value = PrepareSQLnum(tmpGFMlog.Yield3,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl3.Value = PrepareSQLnum(tmpGFMlog.elongation3,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA3.Value = PrepareSQLnum(tmpGFMlog.Red_Area3,'Red_Area',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtHardness3.Value = IIF(!empty(tmpGFMlog.rockwell3),"R"+LOWER(tmpGFMlog.rockwell3)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN3.Value = PrepareSQLnum(tmpGFMlog.BHN3,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches3.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc3.Value = PrepareSQLtxt(tmpGFMlog.tLoc3,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt4.Value = PrepareSQLnum(tmpGFMlog.Tensile4,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld4.Value = PrepareSQLnum(tmpGFMlog.Yield4,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl4.Value = PrepareSQLnum(tmpGFMlog.elongation4,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA4.Value = PrepareSQLnum(tmpGFMlog.Red_Area4,'Red_Area',4,1)
		*			ThisFormset.ERPCert.PF1.pgCert.txtHardness4.Value = IIF(!empty(tmpGFMlog.rockwell4),"R"+LOWER(tmpGFMlog.rockwell4)," ")
		*			ThisFormset.ERPCert.PF1.pgCert.txtBHN4.Value = PrepareSQLnum(tmpGFMlog.BHN4,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches4.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc4.Value = PrepareSQLtxt(tmpGFMlog.tLoc4,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt5.Value = PrepareSQLnum(tmpGFMlog.Tensile5,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld5.Value = PrepareSQLnum(tmpGFMlog.Yield5,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl5.Value = PrepareSQLnum(tmpGFMlog.elongation5,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA5.Value = PrepareSQLnum(tmpGFMlog.Red_Area5,'Red_Area',4,1)
		*			ThisFormset.ERPCert.PF1.pgCert.txtHardness5.Value = IIF(!empty(tmpGFMlog.rockwell5),"R"+LOWER(tmpGFMlog.rockwell5)," ")
		*			ThisFormset.ERPCert.PF1.pgCert.txtBHN5.Value = PrepareSQLnum(tmpGFMlog.BHN5,'BHN',3,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches5.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc5.Value = PrepareSQLtxt(tmpGFMlog.tLoc5,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt6.Value = PrepareSQLnum(tmpGFMlog.Tensile6,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld6.Value = PrepareSQLnum(tmpGFMlog.Yield6,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl6.Value = PrepareSQLnum(tmpGFMlog.elongation6,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA6.Value = PrepareSQLnum(tmpGFMlog.Red_Area6,'Red_Area',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches6.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc6.Value = PrepareSQLtxt(tmpGFMlog.tLoc6,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt7.Value = PrepareSQLnum(tmpGFMlog.Tensile7,'Tensile',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtYld7.Value = PrepareSQLnum(tmpGFMlog.Yield7,'Yield',6,0)
					ThisFormset.ERPCert.PF1.pgCert.txtEl7.Value = PrepareSQLnum(tmpGFMlog.elongation7,'Elong',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA7.Value = PrepareSQLnum(tmpGFMlog.Red_Area7,'Red_Area',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches7.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txttLoc7.Value = PrepareSQLtxt(tmpGFMlog.tLoc7,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtSpecLMA.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txtSpecSpaceX.Value = ' '
					
					PRIVATE cUNS
					cUNS = GetUNS( tmpGFMlog.ALLOYNAME, ThisFormSet.nConnHandle)
					IF !EMPTY(cUNS)
						ThisFormset.ERPCert.PF1.pgCert.txtUNS.Value = cUNS
					ENDIF
					
					isadding=.T.
					ThisFormSet.SetEditing()
					
					ThisFormset.frmSearch.txtGetHeat.Value = ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value
					ThisFormset.frmSearch.txtGetLot.Value = PrepareSQLtxt(ThisFormset.ERPCert.PF1.pgCert.txtLot.Value,'Lot',10)
					
					*MESSAGEBOX("Clone is ready")
				ENDIF
				
				USE IN tmpGFMlog
			ELSE
		
		*		Cancel CLONE FROM lot
				ThisFormSet.isediting=.F.
				isadding=.F.
				MESSAGEBOX("GFMlog Not found!  NO DATA CLONED FROM GFMLOG",16)
				SELECT ERPCert
				SET ORDER TO heat
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getlakeerielotprop
		PARAMETERS nLot,cHeat
		*ThisFormSet.GetLakeErieLotProp
		
		IF VARTYPE(nLot) != 'N'
			RETURN .F.
		ENDIF
		
		
		*Reset certain fields
		ThisFormset.ERPCert.PF1.pgCert.txtGrainSize.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtCorrosionr.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHeatTreat.Value = ''
		
