			*!*			cMessage = ''
			*!*			
			*!*			cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, ThisFormSet.nConnHandle, cNewPDFName)
			*!*			
			*!*			DO CASE
			*!*			CASE "Mail queued" $ cAns
			*!*				WAIT WINDOW "Mail queued." NOWAIT
			*!*			CASE NOT EMPTY(cAns)
			*!*				MESSAGEBOX( cANS,0,"SQL Returned Message!")
			*!*			OTHERWISE
			*!*				WAIT WINDOW "Email Complete" NOWAIT
			*!*			ENDCASE
				ENDIF
			ELSE
