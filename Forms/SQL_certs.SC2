		cSQL = cSQL +",NiandCo='"+cNiandCo+"'"
		cSQL = cSQL +",Other='"+cOther+"'"
		cSQL = cSQL +",Ult1="+STR(nUlt1,10,0)
		cSQL = cSQL +",Yield1="+STR(nYield1,10,0)
		cSQL = cSQL +",Elong1="+STR(nElong1,5,1)
		cSQL = cSQL +",RA1="+STR(nRA1,5,1)
