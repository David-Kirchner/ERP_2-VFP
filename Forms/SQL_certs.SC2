			loListener.lCanCopy=.T.
			loListener.lCanAddNotes=.F.
			loListener.lEncryptDocument=.F.
			loListener.cMasterPassword=''
			loListener.cUserPassword=''
			loListener.lOpenViewer=.F.
		
