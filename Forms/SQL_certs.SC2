		ThisFormset.ERPCert.PF1.pgCert.txtSrTemp.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSrStress.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSrRa.Value = ''
