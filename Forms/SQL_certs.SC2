				REPORT FORM Reports\Certs_SpaceX5 RECORD m.currntrecrd Object loListener
			ELSE
				REPORT FORM Reports\Certs_SpaceX RECORD m.currntrecrd Object loListener
			ENDIF
			
			RELEASE loListener	
			THISFORM.VISIBLE = .T.
			
			********************************
			IF FILE(cFileName)
				#DEFINE olFolderInbox 6
				#DEFINE olFolderOutbox 4
				#DEFINE olMailItem 0
				#DEFINE olRecipient 4
				#DEFINE olRecipients 17
				#DEFINE IMPORTANCENORMAL 1
