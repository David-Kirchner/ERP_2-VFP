		cSQL = cSQL +",tLoc7='"+ctLoc7+"'"
		
		cSQL = cSQL +",SpecLMA ='"+cSpecLMA+"'"
		cSQL = cSQL +",SpecSpaceX ='"+cSpecSpaceX+"'"
		
		cSQL = cSQL +",TestPO='"+cTestPO+"'"
		cSQL = cSQL +",LabUsed='"+cLabUsed+"'"
		cSQL = cSQL +",TestPO2='"+cTestPO2+"'"
		cSQL = cSQL +",LabUsed2='"+cLabUsed2+"'"
		
		cSQL = cSQL +",Machine="+STR(nMachine)
		cSQL = cSQL +",XtraInfo='"+cXtraInfo+"'"
		cSQL = cSQL +",Signed="+IIF(lSigned,'1','0')
		cSQL = cSQL +",QA="+IIF(lQA,'1','0')
		cSQL = cSQL +",QArev='"+cQArev+"'"
		cSQL = cSQL +",MercFree="+IIF(lMercFree,'1','0')
		cSQL = cSQL +",NoWeld="+IIF(lNoWeld,'1','0')
		cSQL = cSQL +",DFARS="+IIF(lDFARS,'1','0')
		cSQL = cSQL +",SrHours="+STR(nSrHours,5,1)
		cSQL = cSQL +",SrTemp='"+cSrTemp+"'"
		cSQL = cSQL +",SrStress="+STR(nSrStress,10,0)
		cSQL = cSQL +",SrRA="+STR(nSrRA,5,1)
		cSQL = cSQL +",SrElong="+STR(nSrElong,5,1)
		cSQL = cSQL +" WHERE ID="+STR(nID)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			MESSAGEBOX("Try to edit and try to save again."+CHR(13)+"",16,"Record could not be saved")
			* Does not belong to Windfall\Certs AD group
		ELSE
		
			IF lRemoveSignature
				
				cSQL = "UPDATE dbo.Cert SET "
				cSQL = cSQL +" Signed=0"
				cSQL = cSQL +",Sig_ID=NULL"
				cSQL = cSQL +",SignUser=''"
				cSQL = cSQL +",SignDate=''" 
				cSQL = cSQL +" WHERE ID="+STR(nID)
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
				ELSE
					ThisFormset.ERPCert.PF1.pgCert.chkChecked.Refresh
				ENDIF
					
			ENDIF
			
			isadding=.F.
			
			ThisFormSet.SetNormal()
			ThisFormSet.CheckElements()
			
			WAIT WINDOW 'Refreshing your DATA!' NOWAIT
			PRIVATE cGetHeat 
		
			cGetHeat = PrepareSQLtxt(ThisFormset.frmSearch.txtGetHeat.Value,'Heat',40)
			IF UPPER(cGetHeat) = UPPER(cHeat)
				ThisFormSet.Get_Cert('SEARCHHEAT',cHeat)
				ThisFormSet.ERPCert.PF1.pgCert.cmdUnFilter.Visible = .T.
				
				ThisFormSet.frmSearch.cmdUnFilter.Caption = "FILTERED"
				ThisFormSet.frmSearch.cmdUnFilter.BackColor = RGB(255,0,0)
				*ThisFormSet.frmSearch.cmdUnFilter.Visible = .T.
				
				
				SELECT ERPCert
				LOCATE FOR ID = nID
			ELSE
				ThisFormSet.Get_Cert('ID',nID)
			ENDIF
			WAIT CLEAR
			
		ENDIF
		
	ENDPROC

