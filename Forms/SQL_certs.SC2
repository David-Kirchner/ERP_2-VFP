	ENDPROC

	PROCEDURE frmAddCert.Commandgroup1.cmdGFMLot.Click
		ThisFormSet.ReturnWhatMach = "G"
		ThisForm.Commandgroup1.enabled = .F.
		ThisForm.Commandgroup1.cmdGFMLot.enabled = .F.
		ThisForm.Commandgroup1.cmdRollLot.enabled = .F.
		ThisForm.Commandgroup1.cmdClone.enabled = .F.
		ThisForm.Commandgroup1.cmdNew.enabled = .F.
		ThisForm.Commandgroup1.cmdLakeErieLot.enabled = .F.
		ThisForm.Commandgroup1.cmdWireLot.enabled = .F.
		
		ThisForm.cmdTChem.enabled = .T.
		ThisForm.cmdNChem.enabled = .T.
		ThisForm.txtLot.enabled = .T.
		ThisForm.Refresh
		ThisForm.txtLot.SetFocus
		
	ENDPROC

