		ThisFormset.ERPCert.PF1.pgCert.txtUlt2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl2.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness2.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtBHN2.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc2.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl3.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness3.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtBHN3.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc3.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa4.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl4.Value = ''
		*ThisFormset.ERPCert.PF1.pgCert.txtHardness4.Value = ' '
		*ThisFormset.ERPCert.PF1.pgCert.txtBHN4.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc4.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa5.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl5.Value = ''
		*ThisFormset.ERPCert.PF1.pgCert.txtHardness5.Value = ' '
		*ThisFormset.ERPCert.PF1.pgCert.txtBHN5.Value = 0
		ThisFormset.ERPCert.PF1.pgCert.txttLoc5.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl6.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txttLoc6.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtUlt7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtYld7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtRa7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtEl7.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txttLoc7.Value = ''
		
		ThisFormset.ERPCert.PF1.pgCert.txtSpecLMA.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtSpecSpaceX.Value = ''
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpGFMlog')	
			USE IN tmpGFMlog
		ENDIF
		
		cSQL = "SELECT * FROM dbo.LakeErie_LOG WHERE Lot = "+STR(nLot)
				
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpGFMlog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpGFMlog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpGFMlog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpGFMlog")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,'tmpGFMlog')
			RETURN
		ELSE
			IF USED('tmpGFMlog')
				IF RECCOUNT('tmpGFMlog') > 0
		
					IF tmpGFMlog.heat != cHeat
						IF AT('-',tmpGFMlog.heat,1) > 1
							cgfmlogHeat = LEFT(tmpGFMlog.heat,AT('-',tmpGFMlog.heat,1)-1)
						ELSE
							cgfmlogHeat = ALLTRIM(tmpGFMlog.heat)
						ENDIF
						IF AT('-',cHeat,1) > 1
							cCertHeat = LEFT(cHeat,AT('-',cHeat,1)-1)
						ELSE
							cCertHeat = ALLTRIM(cHeat)
						ENDIF
						
						IF cgfmlogHeat != cCertHeat 
							MESSAGEBOX("Roll LOG Heat:"+cgfmlogHeat+" does not match Cert Heat:"+cCertHeat ,16,"Heat numbers do not match!")
						ENDIF
					ENDIF
		
					SELECT ERPCert
					ThisFormset.ERPCert.PF1.pgCert.txtUlt.Value = tmpGFMlog.tensile
					ThisFormset.ERPCert.PF1.pgCert.txtYield.Value = tmpGFMlog.yield
					ThisFormset.ERPCert.PF1.pgCert.txtElong.Value = tmpGFMlog.elongation
					ThisFormset.ERPCert.PF1.pgCert.txtElonInches.Value = "4D"
					ThisFormset.ERPCert.PF1.pgCert.txtRA.Value = tmpGFMlog.red_area
					
					ThisFormset.ERPCert.PF1.pgCert.txtHardness.Value = IIF(!empty(tmpGFMlog.rockwell),"R"+LOWER(tmpGFMlog.rockwell)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN.Value = tmpGFMlog.bhn
					ThisFormset.ERPCert.PF1.pgCert.txttLoc1.Value = '' &&PrepareSQLtxt(tmpGFMlog.tLoc,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtLot.Value = nLot
					ThisFormset.ERPCert.PF1.pgCert.txtReference.Value = 'Roll'
					ThisFormset.ERPCert.PF1.pgCert.grpMach.Value = 3
					ThisFormset.ERPCert.PF1.pgCert.txtDateCert.Value = tmpGFMlog.testsent+3
					ThisFormset.ERPCert.PF1.pgCert.txtDateProd.Value = tmpGFMlog.date
					ThisFormset.ERPCert.PF1.pgCert.txtAlloy.Value = tmpGFMlog.ALLOYNAME    &&C12
					ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value =  tmpGFMlog.heat         &&C35
					ThisFormset.ERPCert.PF1.pgCert.txtSize.Value = "Bar"
					ThisFormset.ERPCert.PF1.pgCert.txtSpec.Value = tmpGFMlog.SPEC         &&C40
		
					ThisFormset.ERPCert.PF1.pgCert.txtTestPO.Value = PrepareSQLtxt(tmpGFMlog.TestPO,'TestPO',12)
					ThisFormset.ERPCert.PF1.pgCert.txtLabUsed.Value = PrepareSQLtxt(tmpGFMlog.lab ,'Lab',12)
					ThisFormset.ERPCert.PF1.pgCert.txtLabUsed2.Value = '' &&PrepareSQLtxt(tmpGFMlog.lab2,'Lab',12)
					ThisFormset.ERPCert.PF1.pgCert.txtTestPO2.Value = '' &&PrepareSQLtxt(tmpGFMlog.TestPO2,'TestPO',12)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt2.Value = tmpGFMlog.Tensile2
					ThisFormset.ERPCert.PF1.pgCert.txtYld2.Value = tmpGFMlog.Yield2
					ThisFormset.ERPCert.PF1.pgCert.txtEl2.Value = tmpGFMlog.elongation2
					ThisFormset.ERPCert.PF1.pgCert.txtRA2.Value = tmpGFMlog.red_area2
					ThisFormset.ERPCert.PF1.pgCert.txtHardness2.Value = IIF(!empty(tmpGFMlog.rockwell2),"R"+LOWER(tmpGFMlog.rockwell2)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN2.Value = tmpGFMlog.bhn2
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches2.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txttLoc2.Value = '' &&PrepareSQLtxt(tmpGFMlog.tLoc2,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt3.Value = tmpGFMlog.Tensile3
					ThisFormset.ERPCert.PF1.pgCert.txtYld3.Value = tmpGFMlog.Yield3
					ThisFormset.ERPCert.PF1.pgCert.txtEl3.Value = tmpGFMlog.elongation3
					ThisFormset.ERPCert.PF1.pgCert.txtRA3.Value = tmpGFMlog.red_area3
					ThisFormset.ERPCert.PF1.pgCert.txtHardness3.Value = IIF(!empty(tmpGFMlog.rockwell3),"R"+LOWER(tmpGFMlog.rockwell3)," ")
					ThisFormset.ERPCert.PF1.pgCert.txtBHN3.Value = tmpGFMlog.bhn3
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches3.Value = ' ' 
					ThisFormset.ERPCert.PF1.pgCert.txttLoc3.Value = '' &&PrepareSQLtxt(tmpGFMlog.tLoc3,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt4.Value = '' &&PrepareSQLnum(tmpGFMlog.Tensile4,'Tensile',-3)
					ThisFormset.ERPCert.PF1.pgCert.txtYld4.Value = '' &&PrepareSQLnum(tmpGFMlog.Yield4,'Yield',-3)
					ThisFormset.ERPCert.PF1.pgCert.txtEl4.Value = '' &&PrepareSQLnum(tmpGFMlog.elongation4,'Elongation',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA4.Value = '' &&PrepareSQLnum(tmpGFMlog.red_area4,'Red_Area',4,1)
		*			ThisFormset.ERPCert.PF1.pgCert.txtHardness4.Value = IIF(!empty(tmpGFMlog.rockwell4),"R"+LOWER(tmpGFMlog.rockwell4)," ")
		*			ThisFormset.ERPCert.PF1.pgCert.txtBHN4.Value = tmpGFMlog.bhn4
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches4.Value = ' ' 
					ThisFormset.ERPCert.PF1.pgCert.txttLoc4.Value = '' &&PrepareSQLtxt(tmpGFMlog.tLoc4,'tLoc',1)
					
					ThisFormset.ERPCert.PF1.pgCert.txtUlt5.Value = '' &&PrepareSQLnum(tmpGFMlog.Tensile5,'Tensile',-3)
					ThisFormset.ERPCert.PF1.pgCert.txtYld5.Value = '' &&PrepareSQLnum(tmpGFMlog.Yield5,'Yield',-3)
					ThisFormset.ERPCert.PF1.pgCert.txtEl5.Value = '' &&PrepareSQLnum(tmpGFMlog.elongation5,'Elongation',4,1)
					ThisFormset.ERPCert.PF1.pgCert.txtRA5.Value = '' &&PrepareSQLnum(tmpGFMlog.red_area5,'Red_Area',4,1)
		*			ThisFormset.ERPCert.PF1.pgCert.txtHardness5.Value = IIF(!empty(tmpGFMlog.rockwell5),"R"+LOWER(tmpGFMlog.rockwell5)," ")
		*			ThisFormset.ERPCert.PF1.pgCert.txtBHN5.Value = tmpGFMlog.bhn5
					ThisFormset.ERPCert.PF1.pgCert.txtEloninches5.Value = ' ' 
					ThisFormset.ERPCert.PF1.pgCert.txttLoc5.Value = '' &&PrepareSQLtxt(tmpGFMlog.tLoc5,'tLoc',1)
					
		*!*				
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtUlt6.Value = ''
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtYld6.Value = ''
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtRa6.Value = ''
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtEl6.Value = ''
		*!*	ThisFormset.ERPCert.PF1.pgCert.txttLoc6.Value = ''
		
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtUlt7.Value = ''
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtYld7.Value = ''
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtRa7.Value = ''
		*!*	ThisFormset.ERPCert.PF1.pgCert.txtEl7.Value = ''
		*!*	ThisFormset.ERPCert.PF1.pgCert.txttLoc7.Value = ''		
			
					ThisFormset.ERPCert.PF1.pgCert.txtSpecLMA.Value = ' '
					ThisFormset.ERPCert.PF1.pgCert.txtSpecSpaceX.Value = ' '
					
					PRIVATE cUNS
					cUNS = GetUNS( tmpGFMlog.ALLOYNAME, ThisFormSet.nConnHandle)
					IF !EMPTY(cUNS)
						ThisFormset.ERPCert.PF1.pgCert.txtUNS.Value = cUNS
					ENDIF
					
					isadding=.T.
					ThisFormSet.SetEditing()
					
					ThisFormset.frmSearch.txtGetHeat.Value = ThisFormset.ERPCert.PF1.pgCert.txtHeat.Value
					
					ThisFormset.frmSearch.txtGetLot.Value = PrepareSQLtxt(ThisFormset.ERPCert.PF1.pgCert.txtLot.Value,'Lot',10)
					
					*MESSAGEBOX("Clone is ready")
				ENDIF
				
				USE IN tmpGFMlog
			ELSE
		
		*		Cancel CLONE FROM lot
				ThisFormSet.isediting=.F.
				isadding=.F.
				= MESSAGEBOX("Lake Erie log Not found!  NO DATA CLONED!",16)
				SELECT ERPCert
				SET ORDER TO heat
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE getrolllotprop
		PARAMETERS nLot,cHeat
		*ThisFormSet.GetRollLotProp
		
		IF VARTYPE(nLot) != 'N'
			RETURN .F.
		ENDIF
		
		
		*Reset certain fields
		ThisFormset.ERPCert.PF1.pgCert.txtGrainSize.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHardness.Value = ' '
		ThisFormset.ERPCert.PF1.pgCert.txtCorrosionr.Value = ''
		ThisFormset.ERPCert.PF1.pgCert.txtHeatTreat.Value = ''
		
