			USE IN ERPCert_Co 
		ENDIF
		
		IF USED("tmpERPCert_Co")
			USE IN tmpERPCert_Co
		ENDIF
		
		IF USED('ERPCert')
			TABLEREVERT(.T.,'ERPCert') &&CURSORSETPROP is not used!, rewrite so this old command can be dropped
			USE IN ERPCert
		ENDIF
	ENDPROC

