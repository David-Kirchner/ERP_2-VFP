		ThisFormset.ERPCert.PF1.pgCert.txtQArev.Value	= ERPCert.QArev
		ThisFormset.ERPCert.PF1.pgCert.chkMercFree.Value = PrepareSQLchk(ERPCert.MercFree,'MercFree')
		ThisFormset.ERPCert.PF1.pgCert.chkNoWeld.Value	= PrepareSQLchk(ERPCert.NoWeld,'NoWeld')
		ThisFormset.ERPCert.PF1.pgCert.chkDFARS.Value	= PrepareSQLchk(ERPCert.DFARS,'DFARS')
		ThisFormset.ERPCert.PF1.pgCert.chkChecked.Value	= PrepareSQLchk(ERPCert.Signed,'Signed')
		ThisFormset.ERPCert.PF1.pgCert.txtsignUser.Value= ERPCert.SignUser
		ThisFormset.ERPCert.PF1.pgCert.txtSignDate.Value= PrepareSQLdate(ERPCert.SignDate,'SignDate',.F.,.T.)
		
		************************************************
		* use tmpCert to count duplicates
		PRIVATE nCurRec, nLot, nCLot, cHeat, nCHeat, nMachine, cTalk
		cHeat	= PrepareSQLtxt(ERPCert.Heat,'Heat',40)
		nLot	= PrepareSQLnum(ERPCert.Lot,'Lot',5,0)
		nMachine= PrepareSQLnum(ERPCert.machine,'Machine',1,0)
		
		IF NOT EMPTY(cHeat)
			IF USED("tmpCert")
				SELECT tmpCert
			ELSE
				SELECT 0
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Cert WHERE HEAT = '"+cHeat+"'"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCert')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCert')
			ENDIF
		
			IF USED('tmpCert')
				ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = tmpCert.Cntd
				USE IN tmpCert
			ELSE
				ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = 0
			ENDIF
			
		ELSE
			ThisFormset.ERPCert.PF1.pgCert.txtHeatCount.Value = 0
		ENDIF
		
		***********************************************************
		
		
		IF NOT nLot=0
			IF nMachine > 0
		*		CALCULATE COUNT() FOR Lot = nLot AND Machine = nMachine  TO nCLot
				IF USED("tmpCert")
					SELECT tmpCert
				ELSE
					SELECT 0
				ENDIF
		
				cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Cert WHERE Lot="+STR(nLot)
				
				IF NOT EMPTY(nMachine)
					cSQL=cSQL+" AND Machine="+STR(nMachine)
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCert')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCert')
				ENDIF
		
				IF USED('tmpCert')
					ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = tmpCert.Cntd
					ThisFormset.frmSearch.txtLotCount.Value = tmpCert.Cntd
		
					USE IN tmpCert
				ELSE
					ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = 0
					ThisFormset.frmSearch.txtLotCount.Value = 0
				ENDIF	
			ELSE
				ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = 0
				ThisFormset.frmSearch.txtLotCount.Value = 0
			ENDIF
		ELSE
			ThisFormset.ERPCert.PF1.pgCert.txtLotCount.Value = 0
			ThisFormset.frmSearch.txtLotCount.Value = 0
		ENDIF
		
		******************************************
		IF USED('ERPCert')
			ThisFormSet.GetCert_CO(ERPCert.ID)
		ELSE
			ThisFormSet.RefreshERPCertCo(0)
		ENDIF
		******************************************
		*!*	PRIVATE nCO_ID
		*!*	nCO_ID = 0
		
		*!*	IF USED("ERPCert_Co")
		*!*		loFrmCustomer.grdCO.RecordSource = ""
		*!*		USE IN ERPCert_Co
		*!*	ENDIF
		*!*	SELECT 0
		
		*!*	cSQL = "SELECT * FROM dbo.Cert_Co WHERE ID = "+STR(ERPCert.ID)
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ERPCert_Co')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'ERPCert_Co')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert_Co")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "ERPCert_Co")
		
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'ERPCert_Co')
		*!*	ENDIF
		
		*!*	IF USED('ERPCert_Co')
		*!*		loFrmCustomer.grdCO.RecordSource = "ERPCert_Co"
		*!*		loFrmCustomer.grdCO.ColumnCount = 3
		*!*		loFrmCustomer.grdCO.Column1.Header1.Caption = "CO_ID"
		*!*		loFrmCustomer.grdCO.Column1.ControlSource = "ERPCert_Co.CO_ID"
		*!*		loFrmCustomer.grdCO.Column2.Header1.Caption = "Company"
		*!*		loFrmCustomer.grdCO.Column2.ControlSource = "ERPCert_Co.Company"
		*!*		loFrmCustomer.grdCO.Column2.Width = 90
		*!*		loFrmCustomer.grdCO.Column2.Text1.Alignment = 0
		
		*!*		loFrmCustomer.grdCO.Column3.Header1.Caption = "SO item"
		*!*		loFrmCustomer.grdCO.Column3.ControlSource = "ERPCert_Co.SOitem"
		*!*		
		*!*		ThisFormSet.RefreshERPCertCo(ERPCert_Co.CO_ID)
		*!*	ELSE
		*!*		ThisFormSet.RefreshERPCertCo(0)
		*!*	ENDIF
		**********************************************
		
		*Show SpaceX Hardness Profile window
		IF USED("tmpCert_RC_Cnt")
			USE IN tmpCert_RC_Cnt
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Cert_RC_Profile WHERE CertID = "+STR(ERPCert.ID)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCert_RC_Cnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpCert_RC_Cnt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_RC_Cnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCert_RC_Cnt")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCert_RC_Cnt')
		ENDIF
		
		IF USED('tmpCert_RC_Cnt')
			IF RECCOUNT('tmpCert_RC_Cnt')>0
				IF tmpCert_RC_Cnt.Cntd > 0
					*ThisFormSet.frmSpaceX.Visible = .T.	
					ThisFormSet.ShowSpaceXHardness()
				ELSE
					IF VARTYPE(ThisFormSet.oFrmSpaceX) = "O"
						ThisFormSet.oFrmSpaceX.Visible = .F.
					ENDIF
				ENDIF
			ELSE
				IF VARTYPE(ThisFormSet.oFrmSpaceX) = "O"
					ThisFormSet.oFrmSpaceX.Visible = .F.
				ENDIF
			ENDIF
			USE IN tmpCert_RC_Cnt
		ELSE
			IF VARTYPE(ThisFormSet.oFrmSpaceX) = "O"
				ThisFormSet.oFrmSpaceX.Visible = .F.
			ENDIF
		ENDIF
		**********************************************
		
		SELECT ERPCert
	ENDPROC

	PROCEDURE reload
	ENDPROC

	PROCEDURE savecert
		*ThisFormSet.SaveCert()
		
		SELECT ERPCert
		
		PRIVATE lSigned,cSignUser,dSignDate
		lSigned		= PrepareSQLchk(ThisFormset.ERPCert.PF1.pgCert.chkChecked.Value,'Signed')
		*cSignature	= 
		cSignUser	= PrepareSQLtxt(ThisFormset.ERPCert.PF1.pgCert.txtSignUser.Value,'SignUser',50)
		dSignDate	= PrepareSQLdate(ThisFormset.ERPCert.PF1.pgCert.txtSignDate.Value,'SignDate',.F.,.T.)
		
		PRIVATE cReference,dDateCert,dDateProd
		PRIVATE cHeat,nLot,cAlloy,cSize,cSpec,cUNS,cSpecLMA,cSpecSpaceX
		PRIVATE cAl,cB1,cBe,cC,cCa,cCb,cCd,cCl,cCo,cCr,cCu,cFe
		PRIVATE cH,cHf,cMg,cMn,cMo,cN,cNa,cNi,cO1,cP,cPb
		PRIVATE cS,cSi,cSn,cTa,cTi,cU1,cV,cW,cY,cZr
		PRIVATE cCbandTa,cNiandCo,cOther
		PRIVATE nUlt1,nYield1,nElong1,nRA1,cHardness1,nBHN1,cElonInches, ctLoc1
		PRIVATE nUlt2,nYield2,nElong2,nRA2,cHardness2,nBHN2,cElonInches2,ctLoc2
		PRIVATE nUlt3,nYield3,nElong3,nRA3,cHardness3,nBHN3,cElonInches3,ctLoc3
		PRIVATE nUlt4,nYield4,nElong4,nRA4,cHardness4,nBHN4,cElonInches4,ctLoc4
		PRIVATE nUlt5,nYield5,nElong5,nRA5,cHardness5,nBHN5,cElonInches5,ctLoc5
		PRIVATE nUlt6,nYield6,nElong6,nRA6,cElonInches6,ctLoc6
		PRIVATE nUlt7,nYield7,nElong7,nRA7,cElonInches7,ctLoc7
		*PRIVATE nTemp2,nSten2,nTime2,nTemp3,nSten3,nTime3
		PRIVATE cHeatTreat
		PRIVATE cCorrosionR,cGrainSize,cTestPO,cLabUsed,cTestPO2,cLabUsed2,nMachine
		PRIVATE cXtrainfo,lQA,cQArev,lMercFree,lNoWeld,lDFARS
		PRIVATE nSrHours,cSrTemp,nSrStress,nSrRA,nSrElong,nID
		
		cReference	= ALLTRIM(PrepareSQLtxt(ThisFormset.ERPCert.PF1.pgCert.txtReference.Value,'Reference',10))
		dDateCert	= PrepareSQLdate(ThisFormset.ERPCert.PF1.pgCert.txtDateCert.Value,'DateCert',.F.,.T.)
