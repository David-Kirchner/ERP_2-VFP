		cSQL = cSQL +",S='"+cS+"'"
		cSQL = cSQL +",Si='"+cSi+"'"
		cSQL = cSQL +",Sn='"+cSn+"'"
		cSQL = cSQL +",Ta='"+cTa+"'"
