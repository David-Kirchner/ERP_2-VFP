	*<DefinedPropArrayMethod>
		*m: addnewcert
		*m: checkcert
		*m: checkelements		&& Summarize Elements on save
		*m: checkspec_balance
		*m: checkspec_hardness
		*m: convertform		&& Form digit to decription.
		*m: createtable_certspx
		*m: enablespacexhardness
		*m: erpcertcoblank
		*m: getcert_co
		*m: getfrmcustomer
		*m: getgfmlotprop
		*m: getlakeerielotprop
		*m: getrolllotprop
		*m: getwirelotprop
		*m: get_cert		&& Replaced GetCert, would cause VFP to Exit.
		*m: get_cert_cocompanies
		*m: nlotv		&& Funtion to check Lot numbers
		*m: refresherpcertco
		*m: refreshfind_rev
		*m: refreshfind_spec
		*m: refresh_erpcert
		*m: reload
		*m: savecert
		*m: savespacexhardness
		*m: searchcertid
		*m: searchheat
		*m: searchlot
		*m: selectcertid
		*m: setcertnew
		*m: setcert_co_edit
		*m: setediting
		*m: setnormal		&& Restores buttons from editing.
		*m: showspacexhardness
		*p: csearchheat
		*p: isediting
		*p: isediting_co
		*p: lfiltered
		*p: nconnhandle
		*p: nmachine		&& 1 std, 2 GFM, 3 Roll
		*p: ofrmcustomer
		*p: ofrmspacex
		*p: pcheat		&& Paramete Char HEAT
		*p: pclot		&& Parameter Char LOT
		*p: pnlot		&& Only the Lot Number
		*p: returnlot		&& From AddCert
		*p: returntype		&& From AddCert
		*p: returnwhatmach
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoRelease = .T.
		csearchheat = <fb2p_value>''&#13;</fb2p_value>
