	PROCEDURE Destroy
		=SQLDISCONNECT(ThisForm.nConnHandle)
		
		IF WEXIST("frmStockLst_SQL_Quotes")
			ACTIVATE WINDOW frmStockLst_SQL_Quotes
		ENDIF
		
		*IF WEXIST("frmShowProcess")
		*	ACTIVATE WINDOW frmShowStockLstProcess
		*	ACTIVATE WINDOW frmShowProcess
		*ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pSOItem
		*DO FORM Forms\ShowvSOitem WITH cSOitem
		
		ThisForm.OrigTable = ALIAS()
		
		IF VARTYPE(pSOitem) != "C"
			MESSAGEBOX("Sales Order Item not passed in.",0,"No SO Item")
			RETURN .F.
		ENDIF
		
		pSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		IF Proper_SO_item(pSOitem) = Proper_SO_item('')
			MESSAGEBOX("Sales Order Item not passed in.",0,"No SO Item")
			RETURN .F.
		ENDIF
		
		ThisForm.nSalesNum = VAL( LEFT(pSOItem,7) )
		
		 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		IF USED('Sales')
		
			IF USED('Sales')
				USE IN Sales
			ENDIF
		
			SELECT 0
			cSQL="SELECT * FROM dbo.Sales WITH(NOLOCK) WHERE SalesNum = "+STR(ThisForm.nSalesNum)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'Sales' )
			ENDIF
			
			ThisForm.OpenedSales = .T.
		ELSE
			ThisForm.OpenedSales = .F.
		ENDIF
		
		
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF USED('tmpAQSOitem')
			USE IN tmpAQSOitem
		ENDIF
		SELECT 0
		cSQL="SELECT * FROM dbo.AllQuotes WHERE SOItem = dbo.f_ProperSOitem('" + pSOItem + "')"
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQSOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQSOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQSOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQSOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpAQSOitem')
		ENDIF
		
		IF USED('vSOItem')
			USE IN vSOItem
		ENDIF
		SELECT 0
		cSQL="SELECT * FROM dbo.Sales WITH(NOLOCK) "
		cSQL = cSQL+" INNER JOIN dbo.AllQuotes WITH(NOLOCK) ON Sales.SOitem = AllQuotes.Soitem "
		cSQL = cSQL+" WHERE sales.SOItem = dbo.f_ProperSOitem('" + pSOItem + "')"
		cSQL = cSQL+" AND AllQuotes.SOItem = sales.SOItem"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'vSOItem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'vSOItem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "vSOItem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "vSOItem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'vSOItem' )
		ENDIF
		
		 
		IF USED("vSOItem")
			SELECT vSOItem
		 	IF RECCOUNT("vSOItem") = 0
			 	MESSAGEBOX("Sales Order Item not found in Sales",0,"No SO Item")
		 		ThisForm.Release
			ENDIF	
		 ELSE
			MESSAGEBOX("Sales Order Item not found in Sales",0,"No SO Item")
		 	ThisForm.Release
		 ENDIF	
		 
		IF NOT USED('Sales_No')
		*	USE HPA!Sales_No IN 0
			IF USED('Sales_No')
				USE IN Sales_No
			ENDIF
		
			SELECT 0
			cSQL="SELECT * FROM dbo.Sales_No WHERE SalesNum = "+STR(ThisForm.nSalesNum)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'Sales_No')
			ENDIF
		
			ThisForm.OpenedSales_No = .T.
		ELSE
			ThisForm.OpenedSales_No = .F.
		ENDIF
		
		ThisForm.AlwaysOnTop = .T.
		ThisForm.AlwaysOnTop = .F.
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF 
		
	ENDPROC

	PROCEDURE Unload
		IF USED('vSOItem')
			USE IN vSOItem
		ENDIF
		
		IF ThisForm.OpenedSales
			IF USED("SALES")
				USE IN Sales
			ENDIF
		ENDIF
		
		IF USED('tmpAQSOitem')
			USE IN tmpAQSOitem
		ENDIF
		
		IF ThisForm.OpenedSales_No 
			IF USED('Sales_No')
				USE IN Sales_No
			ENDIF
		ENDIF
		
		IF !EMPTY(THISFORM.OrigTable)
			IF USED(THISFORM.OrigTable)
				SELECT (THISFORM.OrigTable)
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdReportServer.Click
		WAIT WINDOW "Look for a blinking Internet Explorer to read report!" NOWAIT
		PRIVATE loHyperlink,cHyperLink 
		loHyperlink = Createobject("Hyperlink")
		
		
		PRIVATE cSOitem
		cSOitem = ThisForm.Pgf.PgDetail.sOITEM_A1.Value
		cHyperLink = HTML_SOitem(cSOitem,.T.)
		loHyperlink.NavigateTo( cHyperLink )
		RELEASE loHyperlink
		
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE pgf.pgSales_No.Click
		
		IF USED('Sales_No')
			USE IN Sales_No
		ENDIF
		
		SELECT 0
		cSQL="SELECT * FROM dbo.Sales_No WHERE SalesNum = "+STR(ThisForm.nSalesNum)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'Sales_No')
		ENDIF
		
	ENDPROC

ENDDEFINE
