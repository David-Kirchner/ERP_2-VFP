	PROCEDURE spnSalesP.Init
		LOCAL cSalesP, nLoopCount
		
		this.clear
		
		IF USED('tmpSalesPInit')
			USE IN tmpSalesPInit
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT DISTINCT [ANS] FROM dbo.AppSetup WITH(NOLOCK) "
		cSQL = cSQL+" WHERE LEN( ISNULL([ANS],'') )> 0"
		cSQL = cSQL+" AND [Prp] = 'SalesP'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesPInit')
		ENDIF
		
		IF USED('tmpSalesPInit')
			*SELECT DISTINCT Setup.Un, Setup.Ans FROM tmpSalesPInit WHERE Setup.prp = "SalesP" INTO ARRAY aEmployees
			SELECT ANS FROM tmpSalesPInit INTO ARRAY aSalesP
			
			USE IN tmpSalesPInit
		
		ENDIF
		
		This.ColumnCount =ALEN(aSalesP)
		This.NumberOfElements=ALEN(aSalesP)
		This.BoundColumn = 1
		This.ColumnWidths = "115"
		
		
		*this.addListitem("(All Employees)",1,1)
		nLoopCount = 1
		
		FOR EACH cSalesP IN aSalesP
			IF !EMPTY(cSalesP)
				nLoopCount = nLoopCount + 1
				this.addListitem(ALLTRIM(cSalesP),nLoopCount,1)
			ENDIF
		ENDFOR
		
		
		*THIS.VALUE = "(All Employees)"
		
	ENDPROC

	PROCEDURE spnSalesP.Valid
		cSalesp = UPPER(This.Value)
		
		ThisForm.grdEmails.RecordSource = ''
		
		
		ThisForm.RefreshUserInfo( cSalesp )
		
		ThisForm.Refresh
	ENDPROC

	PROCEDURE txtProfile_Name.Valid
		PRIVATE cProfile_Name
		cProfile_Name = This.Value
		
		IF NOT EMPTY(cProfile_Name)
			
			ThisForm.grdEmails.RecordSource = ''
		
			PRIVATE cSQL
			cSQL = "SELECT ANS AS [Email] FROM dbo.AppSetup WITH(NOLOCK) WHERE PRP = 'Profile_Name' AND UN = '"+cProfile_Name+"'"
		
			IF USED("tmpEmails")
				SELECT tmpEmails
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEmails')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpEmails')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpEmails')
			ENDIF
			
			
			ThisForm.grdEmails.RecordSource = 'tmpEmails'
			ThisForm.grdEmails.Column1.ControlSource = 'tmpEmails.Email'
			ThisForm.grdEmails.Refresh
		*	ThisForm.txtProfile_Name.Value = cProfile_Name
		ENDIF
			
		
	ENDPROC

ENDDEFINE
