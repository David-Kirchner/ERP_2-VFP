	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			ENDIF
		ENDIF
		
		IF TYPE('m.SalesP')="C"
			IF NOT EMPTY(m.SALESP)
				cSalesp = m.SALESP
			ENDIF
		ENDIF
		
		
		m.UserName  = ""
		m.SalesP    = ""
		m.Machine   = ""
		m.ServerDir = ""
		m.HomeDir   = ""
		m.PeachDir  = ""
		m.Email     = ""
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_SQL.prg ADDITIVE
		ENDIF
		IF NOT "PROC_Setup" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_Setup.prg ADDITIVE
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT ANS AS [Email] FROM dbo.AppSetup WITH(NOLOCK) WHERE 0<0"
		
		IF USED("tmpEmails")
			SELECT tmpEmails
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEmails')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpEmails')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpEmails')
		ENDIF
				
				
				
	ENDPROC

	PROCEDURE refreshuserinfo
		PARAMETERS cSalesp 
		*ThisForm.RefreshUserInfo()
		
		IF NOT EMPTY(cSalesp)
		
			cUserName = AppSetup_Get_UserName(cSalesP)
			ThisForm.USERNAME.Text1.Value = cUserName
			
			cMachine = AppSetup_Get_Machine(cUserName)
			ThisForm.MACHINE1.Text1.Value = cMachine
			
			cServerDir = AppSetup_Get_ServerDir()
			ThisForm.ServerDir1.Text1.Value = cServerDir
			
			cHomeDir = AppSetup_Get_HomeDir()
			ThisForm.HomeDir1.Text1.Value = cHomeDir 
			
			cVersion = AppSetup_Get_Machine_Version(cMachine)
			ThisForm.Version1.Text1.Value = cVersion 
			
			cEmail = AppSetup_Get_Email(cUserName)
			ThisForm.Email1.Text1.Value = cEmail 
		
			lActiveSales = AppSetup_Get_Active_Sales(cSalesP)
			ThisForm.chkActiveSales.Value = lActiveSales
			
			
			*get from SQL
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT UN FROM dbo.AppSetup WITH(NOLOCK) WHERE PRP = 'Profile_Name' AND ANS = '"+cEmail+"'"
		
			IF USED("tmpEmails")
				SELECT tmpEmails
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEmails')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpEmails')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpEmails')
			ENDIF
			cProfile_Name = tmpEmails.UN
			
			******
		
			cSQL = "SELECT ANS AS [Email] FROM dbo.AppSetup WITH(NOLOCK) WHERE PRP = 'Profile_Name' AND UN = '"+cProfile_Name+"'"
		
			IF USED("tmpEmails")
				SELECT tmpEmails
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEmails')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpEmails')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpEmails')
			ENDIF
			
			
			ThisForm.grdEmails.RecordSource = 'tmpEmails'
			ThisForm.grdEmails.Column1.ControlSource = 'tmpEmails.Email'
			ThisForm.grdEmails.Refresh
			ThisForm.txtProfile_Name.Value = cProfile_Name
			
		
			
		ELSE
			*get from SQL
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT ANS AS [Email] FROM dbo.AppSetup WITH(NOLOCK) WHERE 0<0"
		
			IF USED("tmpEmails")
				SELECT tmpEmails
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEmails')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpEmails')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpEmails')
			ENDIF
			ThisForm.grdEmails.Refresh
			ThisForm.txtProfile_Name.Value = ''
			
			ThisForm.USERNAME.Text1.Value = ''
			ThisForm.MACHINE1.Text1.Value = ''
			ThisForm.ServerDir1.Text1.Value = ''
			ThisForm.HomeDir1.Text1.Value = ''
			ThisForm.Version1.Text1.Value = ''
			ThisForm.Email1.Text1.Value = ''
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmpEmail')
			USE IN tmpEamils
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
	ENDPROC

	PROCEDURE cmdAdd.Click
		PRIVATE cNewSalesP, cFullName, lHaveSalesP 
		cNewSalesP = ALLTRIM(UPPER(ThisForm.txtNewSalesP.Value))
		cFullName = ThisForm.txtFullName.Value
		
		ThisForm.txtNewSalesP.Value = " "
		ThisForm.txtNewSalesP.Refresh
		ThisForm.txtFullName.Value = ""
		
		lHaveSalesP = .F.
		IF AppSetup_SalesP_Exists(cNewSalesP)
			lHaveSalesP= .T.
			MESSAGEBOX( "Username already exist.",0,"ERROR - Duplicate" )
			*RETURN
		ENDIF
		
		*****************************
		IF NOT lHaveSalesP
			IF EMPTY(cFullName)
				cFullName = ' '
			ENDIF
			PRIVATE cSQL, nSQLEXEC
			cSQL = "INSERT INTO dbo.AppSetup (Un,Prp,Ans) VALUES ('"+cFullName+"','SalesP','"+cNewSalesP+"')"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '' )
			ELSE
				lHaveSalesP = .T.
			ENDIF
		ENDIF
		
		
		
		***************************
		LOCAL cSalesP, nLoopCount, lInsertRec
		lInsertRec = .F.
		
		IF lHaveSalesP
			** Is there a Record to start with
			IF USED('tmpSalesPInit')
				USE IN tmpSalesPInit
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT COUNT(*) AS [ANS] FROM dbo.AllQuotes WITH(NOLOCK) "
			cSQL = cSQL+" WHERE SalesP ='"+cNewSalesP+"'"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesPInit')
			ELSE
				IF USED('tmpSalesPInit')
					IF RECCOUNT('tmpSalesPInit') > 0
						IF tmpSalesPInit.ANS = 0
							lInsertRec = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			
			***********************
			IF lInsertRec 
				IF USED('tmpSalesPInit')
					USE IN tmpSalesPInit
				ENDIF
		
				SELECT 0
				PRIVATE cSQL, nSQLEXEC
		
				cSQL = "SELECT [ANS] FROM dbo.AppSetup WITH(NOLOCK) "
				cSQL = cSQL+" WHERE LEN( ISNULL([ANS],'') )> 0"
				cSQL = cSQL+" AND [Prp] = 'SalesP'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesPInit')
		
				ELSE
					IF Insert_BlankAllQuotes(1000,'1000'+cNewSalesP,cNewSalesP,ThisForm.nConnHandle)
						MESSAGEBOX( "Initail ADDED!"+CHR(13)+"First Inquire record created to get started!",0+64,"Ready to add new 'User Info'")	
					ELSE
						MESSAGEBOX( "Initail ADDED!"+CHR(13)+CHR(13)+"Have another Sales Person pass you an Inquire to get started."+CHR(13)+CHR(13)+"Hit 'Save' when done.",0+64,"Ready to add new 'User Info'")
					ENDIF
				ENDIF
		
				IF USED('tmpSalesPInit')
					*SELECT DISTINCT Setup.Un, Setup.Ans FROM tmpSalesPInit WHERE Setup.prp = "SalesP" INTO ARRAY aEmployees
					SELECT ANS FROM tmpSalesPInit INTO ARRAY aSalesP
					
					USE IN tmpSalesPInit
		
				ENDIF
			ENDIF
			
		ENDIF
		*************************
		ThisForm.spnSalesP.clear
		******************
		ThisForm.spnSalesP.ColumnCount =ALEN(aSalesP)
		ThisForm.spnSalesP.NumberOfElements=ALEN(aSalesP)
		ThisForm.spnSalesP.BoundColumn = 1
		ThisForm.spnSalesP.ColumnWidths = "115"
		
		
		*this.addListitem("(All Employees)",1,1)
		nLoopCount = 1
		
		FOR EACH cSalesP IN aSalesP
			IF !EMPTY(cSalesP)
				nLoopCount = nLoopCount + 1
				ThisForm.spnSalesP.addListitem(ALLTRIM(cSalesP),nLoopCount,1)
			ENDIF
		ENDFOR
		
		
		ThisForm.spnSalesP.Value = cNewSalesP 
		cSalesP = cNewSalesP
		ThisForm.USERNAME.Text1.Value = " "
		ThisForm.MACHINE1.Text1.Value = " "
		ThisForm.EMAIL1.Text1.Value = " "
		
		MESSAGEBOX("Save the Email Address before try to send SQL Emails",0+48,"Email")
		MESSAGEBOX("Add User to MSDB as PUBLIC and DatabaseMailUserRole",0+48,"Email")
		
		
		
		
	ENDPROC

