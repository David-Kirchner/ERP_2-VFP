	PROCEDURE cmdDeleteEmail.Click
		
		
		PRIVATE lGoodSave
		lGoodSave = .T.
		PRIVATE cProfileEmail
		cProfileEmail = PrepareSQLtxt(ThisForm.grdEmails.Column1.txtEmails.Value,'Email',50)
		
		IF EMPTY(cProfileEmail)
			MESSAGEBOX("Not enough info to do a delete",16,"Cannot Delete")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		*cSQL = "DELETE FROM dbo.Profile_Names WHERE Email = '"+cEmail+"'"
		*cSQL = cSQL + " AND Profile_Name = '"+cProfileName+"'"
		cSQL = "DELETE FROM dbo.AppSetup WHERE ANS = '"+cProfileEmail+"'"
		cSQL = cSQL + " AND PRP = 'Profile_Name'"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpEmails')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpEmails')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpEmails")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpEmails')
		ENDIF
		
		
		PRIVATE cSalesp 
		cSalesp = ThisForm.spnSalesP.Value
		
		ThisForm.RefreshUserInfo(cSalesp)
		
		
		
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSave.Click
		
		*cmdSave
		PRIVATE cSalesP, cNewSalesP, cUserName
		cSalesP = ThisForm.spnSalesP.Value
		*cNewSalesP = ThisForm.txtNewSalesP.Value
		cUserName = ALLTRIM( ThisForm.USERNAME.Text1.Value )
		
		IF EMPTY(cSalesP)
			MESSAGEBOX("No SalesPerson",0+16,"Cannot save")
			RETURN 
		ENDIF
		
		IF NOT AppSetup_SalesP_Exists(cSalesP)
			MESSAGEBOX("SalesPerson not found:"+ALLTRIM(cSalesP),0+16,"SalesP Error.")
			RETURN 
		ENDIF
		
		*!*	IF cSalesP = cNewSalesP
		*!*		*Just added NewSalesP
		*!*		
		*!*		IF NOT EMPTY(cUserName)
		*!*			
		*!*			PRIVATE cSQL, nSQLEXEC
		
		
		*!*				IF AppSetup_SalesP_Exists(cNewSalesP)
		
		*!*					*UPDATE SETUP SET Un=cUserName WHERE PRP="SalesP" AND ANS=cSalesP"
		*!*					cSQL = "UPDATE dbo.AppSetup SET [UN]='"+cUserName+"' WHERE [Prp] = 'SalesP' AND [ANS] = '"+cSalesP+"'"
		
		*!*				ELSE
		*!*					*INSERT INTO SETUP (Un,Prp,Ans) VALUES (cUserName, "SalesP", cSalesP )
		*!*					cSQL = "INSERT INTO dbo.AppSetup (Un,Prp,Ans) VALUES ('"+cUserName+"','SalesP','"+cSalesP+"')"
		*!*				ENDIF
		*!*					
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		*!*				ENDDO
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSalesPInit')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPInit")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '' )
		*!*				ENDIF
		*!*				
		*!*		ELSE  &&IF NOT EMPTY(cUserName)
		*!*			MESSAGEBOX("Cannot save a Sales Persons Initial without the User Name!",0,"Name Error")
		*!*		ENDIF  &&IF NOT EMPTY(cUserName)
		*!*	ENDIF
		
		IF NOT HavePermission('EditUserInfo')
			MESSAGEBOX(" You do not have Permission to Edit here!",0,"No Save!")
			RETURN .F.
		ENDIF
		
		PRIVATE lGoodSave
		lGoodSave = .T.
		PRIVATE cMachine,cServerDir,cHomeDir,cEmail,lActiveSales
		cMachine	= PrepareSQLtxt(ThisForm.MACHINE1.Text1.Value,'Machine',30)
		cServerDir	= PrepareSQLtxt(ThisForm.ServerDir1.Text1.Value,'ServerDir',30)
		cHomeDir	= PrepareSQLtxt(ThisForm.HomeDir1.Text1.Value,'HomeDir',30)
		cEmail		= PrepareSQLemail(ThisForm.Email1.Text1.Value,'Email')
		lActiveSales= PrepareSQLlogic(ThisForm.chkActiveSales.Value,'ActiveSales')
		
		PRIVATE cProfileName 
		cProfileName = ThisForm.txtProfile_Name.Value 
		
		*Save Profile
		IF EMPTY(cProfileName) 
			IF NOT EMPTY(cUserName)
				IF LEN(cUserName) > 1
					cProfileName = cUserName
				ENDIF
			ENDIF
		ENDIF
		
		cProfileName = PrepareSQLtxt(cProfileName,'ProfileName',50)
		
		IF NOT EMPTY(cProfileName) 
			IF NOT EMPTY(cEmail)
				AppSetup_Update_Profile_Names( cProfileName, cEmail )
			ENDIF
		ENDIF
		
		*Save userinfo
		
		
		IF NOT EMPTY(cUserName)
			AppSetup_Update_Ans( cSalesP, cUserName, "SalesP" )		
		ENDIF
		IF NOT EMPTY(cMachine)
			AppSetup_Update_Ans( cMachine, cUserName, "Machine" )		
		ENDIF
		IF NOT EMPTY(cServerDir)
			AppSetup_Update_Ans( cServerDir, cUserName, "Server" )
		ENDIF
		IF NOT EMPTY(cHomeDir)
			AppSetup_Update_Ans( cHomeDir, cUserName, "Home" )
		ENDIF
		IF NOT EMPTY(cEmail)
			IF NOT AppSetup_Update_Ans( cEmail, cUserName, "E-mail" )
				lGoodSave = .F.
			ENDIF
		ENDIF
		
		IF lActiveSales
			AppSetup_Update_Ans( cSalesP, cUserName, "ActiveSales" )
		ELSE
			AppSetup_Update_Ans( cSalesP, cUserName, "NotActiveSales" )
		ENDIF
		
		IF lGoodSave
			ThisForm.RefreshUserInfo( cSalesP )
			
			MESSAGEBOX('Save complete',0+64,'Saved')
		ENDIF
		
	ENDPROC

