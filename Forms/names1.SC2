	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisForm.Load_Names()
		
		
		SELECT Names
		
			
	ENDPROC

	PROCEDURE load_names
		PARAMETERS pWhat
		*ThisForm.Load_Names()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		
		IF UPPER(pWhat) ="REFRESH"
			IF USED('Names')
				ThisForm.Grid2.RecordSource = ''
				USE IN Names
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('Names')
			SELECT 0
			
			cSQL = "SELECT * FROM MAIL.dbo.Names WITH(NOLOCK) "
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Names')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Names')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Names")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Names")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'Names' )
			ENDIF
		
		ENDIF
		
		IF USED('Names')
			INDEX ON COMPANY TAG COMPANY OF Names 
			SET ORDER TO COMPANY
			
			IF UPPER(pWhat) ="REFRESH"
				ThisForm.Grid2.RecordSource = 'Names'
			ENDIF
			
		ELSE
			MESSAGEBOX('Failed to load Names',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETERS pWhat
		
		IF VARTYPE( pWhat ) != 'C'
			pWhat = ''
		ENDIF
		
		IF EMPTY(pWhat)
			RETURN .F.
		ENDIF
		
		*!*	[name] [nvarchar](30) NULL,
		*!*	[company] [nvarchar](40) NOT NULL,
		*!*	[address] [nvarchar](40) NULL,
		*!*	[city] [nvarchar](25) NULL,
		*!*	[state] [nvarchar](2) NULL,
		*!*	[zip] [nvarchar](5) NULL,
		*!*	[zip4] [nvarchar](4) NULL,
		*!*	[phone] [nvarchar](12) NULL,
		*!*	[ID] [int] IDENTITY(1,1) NOT NULL
		
		PRIVATE cName,cCompany,cAddress,cCity,cState,cZip,cZip4,cPhone,nID
		
		cName		= PrepareSQLtxt(ThisForm.Name1.Value,'Name',30)
		cCompany	= PrepareSQLtxt(ThisForm.Company1.Value,'Company',40)
		cAddress	= PrepareSQLtxt(ThisForm.Address1.Value,'address',40)
		cCity		= PrepareSQLtxt(ThisForm.City1.Value,'City',25)
		cState		= PrepareSQLtxt(ThisForm.State1.Value,'State',2)
		cZip		= PrepareSQLtxt(ThisForm.Zip1.Value,'Zip',5)
		cZip4		= PrepareSQLtxt(ThisForm.Zip41.Value,'Zip4',4)
		cPhone		= PrepareSQLtxt(ThisForm.Phone1.Value,'Phone',12)
		nID			= Names.ID
		
			
		IF UPPER(pWhat) = "ADD"
			cSQL = "INSERT INTO MAIL.dbo.Names("
			cSQL = cSQL + "Name,Company,Address,City,State,Zip,Zip4,Phone"
			cSQL = cSQL + ") VALUES ("
			cSQL = cSQL + " '"+cName+"'"
			cSQL = cSQL + ",'"+cCompany+"'"
			cSQL = cSQL + ",'"+cAddress+"'"
			cSQL = cSQL + ",'"+cCity+"'"
			cSQL = cSQL + ",'"+cState+"'"
			cSQL = cSQL + ",'"+cZip+"'"
			cSQL = cSQL + ",'"+cZip4+"'"
			cSQL = cSQL + ",'"+cPhone+"'"
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC )
			ENDIF
			
			SELECT 0
			*Get ID
			cSQL = "SELECT ID FROM MAIL.dbo.Names WHERE "
			cSQL = cSQL + " Name='"+cName+"'"
			cSQL = cSQL + " AND Company='"+cCompany+"'"
			cSQL = cSQL + " AND Address='"+cAddress+"'"
			cSQL = cSQL + " AND City='"+cCity+"'"
			cSQL = cSQL + " AND State='"+cState+"'"
			cSQL = cSQL + " AND Zip='"+cZip+"'"
			cSQL = cSQL + " AND Zip4='"+cZip4+"'"
			cSQL = cSQL + " AND Phone='"+cPhone+"'"
		
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpNamesID' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpNamesID' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNamesID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNamesID")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpNamesID' )
			ENDIF
			
			IF USED('tmpNamesID')
				IF VARTYPE(tmpNamesID.ID) = "N"
					ThisForm.ID1.Value = tmpNamesID.ID
					nID = tmpNamesID.ID
				ELSE
					ThisForm.ID1.Value = 0
					nID = 0
				ENDIF
				USE IN tmpNamesID
			ELSE
				ThisForm.ID1.Value = 0
				nID = 0
			ENDIF
		ENDIF
		
		IF UPPER(pWhat) = "SAVE"
			IF nID < 1
				MESSAGEBOX("No Control ID to Update to!",0+16,"Cannot Update")
				RETURN
			ENDIF
			
			cSQL = "UPDATE MAIL.dbo.Names SET"
			cSQL = cSQL + " Name='"+cName+"'"
			cSQL = cSQL + ", Company='"+cCompany+"'"
			cSQL = cSQL + ", Address='"+cAddress+"'"
			cSQL = cSQL + ", City='"+cCity+"'"
			cSQL = cSQL + ", State='"+cState+"'"
			cSQL = cSQL + ", Zip='"+cZip+"'"
			cSQL = cSQL + ", Zip4='"+cZip4+"'"
			cSQL = cSQL + ", Phone='"+cPhone+"'"
			cSQL = cSQL + " WHERE ID = "+STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
			ENDIF	
			
		ENDIF
		
		IF USED('Names')
			ThisForm.Grid2.RecordSource = ''
			USE IN Names
		ENDIF
		
		*Refresh table
		cSQL = "SELECT Name,Company,Address,City,State,Zip,Zip4,Phone,ID FROM MAIL.dbo.Names "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Names' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Names' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Names")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Names")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Names')
		ENDIF
		
		SELECT Names
		INDEX ON COMPANY TAG COMPANY OF Names 
		*INDEX ON [Name] TAG [Name]
		
		IF nID > 0
			LOCATE FOR ID = nID
		ENDIF
		
		ThisForm.Grid2.RecordSource = 'Names'
	ENDPROC

	PROCEDURE Unload
		IF USED('NAMES')
			USE IN NAMES
		ENDIF
		
		
		SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE BUTTONSET1.cmdAdd.Click
		IF THIS.Caption = "\<Save"
			IF ThisForm.ID1.Value = 0
				ThisForm.SaveAdd("Add")
			ELSE
				ThisForm.SaveAdd("Save")
			ENDIF
			THIS.Parent.EditMode = !THIS.Parent.EditMode
			THIS.Parent.AddMode = .F.
			THISFORM.LockScreen = .T.
			THIS.Parent.ButtonRefresh()
			THIS.Parent.NavRefresh()
			THISFORM.LockScreen = .F.
		ELSE
			*Add
			*Data will be cloned!
			ThisForm.ID1.Value = 0
			*ThisForm.SaveAdd("Add")
			THIS.Parent.EditMode = !THIS.Parent.EditMode
			THIS.Parent.AddMode = .F.
			THISFORM.LockScreen = .T.
			THIS.Parent.ButtonRefresh()
			THIS.Parent.NavRefresh()
			THISFORM.LockScreen = .F.
		ENDIF
		
		ThisForm.ID1.Enabled = .F.
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdDelete.Click
		#DEFINE MSGBOX_YES		6
		#DEFINE C_MSGBOX1		36
		C_DELETE_LOC = "Do you want to delete this record?"
		C_DELETE_LOC2 = "Remove work?"
		#DEFINE C_NOLOCK_LOC	"Record could not be deleted because it is being used by someone else."
		
		* Note: Cascading deletes should be handled via RI triggers in DBC!
		IF EMPTY(ALIAS())
			RETURN
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL, nID
		IF ThisForm.CloneMode
			C_DELETE_LOC = "Are you sure you want to remove this record?"
		ENDIF
		PRIVATE nRecNum
		nRecNum = 1
		
		PRIVATE cCountry
		IF MESSAGEBOX(C_DELETE_LOC,C_MSGBOX1,C_DELETE_LOC2 ) = MSGBOX_YES
			*DELETE
		
			nID = Names.ID
		
			IF EMPTY(nID)
				MESSAGEBOX("No ID!",0+16,"Cannot Delete")
				RETURN
			ENDIF
		
			IF USED('Names')
				SKIP -1 IN Names
				nRecNum = RECNO('Names')
				ThisForm.Grid2.RecordSource = ''
				USE IN Names
			ENDIF
			
			cSQL = "DELETE FROM MAIL.dbo.Names WHERE ID = "+ STR(nID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle , cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle , cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Names")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Names")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle ,nSQLEXEC )
			ENDIF	
			
			cSQL = "SELECT * FROM MAIL.dbo.Names "
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Names' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Names' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Names")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Names")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Names')
			ENDIF
			
			SELECT Names
			INDEX ON COMPANY TAG COMPANY OF Names 
			SET ORDER TO COMPANY
			
			IF nRecNum > 0
				GOTO (nRecNum)
			ENDIF
			
			ThisForm.Grid2.RecordSource = 'Names'
			
			THIS.Parent.ButtonRefresh()
			THIS.Parent.NavRefresh()
			
			ThisForm.ID1.Refresh
			ThisForm.Name1.Refresh
			ThisForm.COMPANY1.Refresh
			ThisForm.Address1.Refresh
			ThisForm.City1.Refresh
			ThisForm.State1.Refresh
			ThisForm.Zip1.Refresh
			ThisForm.Zip41.Refresh
			ThisForm.Phone1.Refresh
		
		ENDIF
		
		IF THISFORM.ShowWindow = 2 
			Activate Window (THISFORM.Name)
		ENDIF
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdEdit.Click
		IF THIS.Caption = "\<Edit"
				
			** Editing record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
				
			THIS.Parent.EditMode = !THIS.Parent.EditMode
			THIS.Parent.AddMode = .F.
			THISFORM.LockScreen = .T.
			THIS.Parent.ButtonRefresh()
			THIS.Parent.NavRefresh()
			THISFORM.LockScreen = .F.
			
			ELSE
			*Revert
				** Reverting record
			IF THIS.Parent.EditMode
				* Go back to original place
				SELECT (THIS.Parent.OldAlias)
				IF RECCOUNT() < THIS.Parent.OldRec	&&added record at EOF()
					GO TOP
				ELSE
					GO THIS.Parent.OldRec
				ENDIF
			ELSE
				THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
				THIS.Parent.OldRec = RECNO()	&&save record in case reverting
			ENDIF
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdPrint.Click
		*!*	SELECT HardWood
		
		*!*	PRIVATE cCountry
		*!*	cCountry = HardWood.Country
		
		*!*	IF NOT EMPTY(cCountry)
		*!*		ThisForm.Visible = .F.
		*!*		REPORT FORM \Reports\HardWood FOR Country = cCountry Preview
		*!*		ThisForm.Visible = .T.
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE cmdPack.Click
		PRIVATE msbx
		msbx = MESSAGEBOX("Are you ready to PACK this Table",32+4,"Removing deleted Records")
		IF msbx = 6 &&YES
			thisform.Grid2.RecordSource = ""
			SELECT Names
			IF FLOCK()
				USE MAIL!Names EXCLUSIVE
				SET talk on
				PACK
				USE MAIL!Names SHARED
				GO TOP
			ELSE
				WAIT WINDOW "Could not lock file to pack"
			ENDIF
			thisform.Grid2.RecordSource = "Names"
			thisform.Grid2.Refresh
			thisform.Name1.Refresh
			thisform.COMPANY1.Refresh
			thisform.Address1.Refresh
			thisform.City1.Refresh
			thisform.State1.Refresh
			thisform.Zip1.Refresh
			thisform.Zip41.Refresh
			thisform.Phone1.Refresh
		
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSearch.Click
		ThisForm.Fcompany.Enabled = .T.
	ENDPROC

	PROCEDURE Fcompany.GotFocus
		ThisForm.oldorder = ORDER()
		SET ORDER TO TAG COMPANY
		
	ENDPROC

	PROCEDURE Fcompany.InteractiveChange
		lnInsertionPt = this.SelStart
		lcSearchStr = substr(this.value,1,lnInsertionPt)
		if !empty(lcSearchStr)
			=seek(upper(lcSearchStr),"Names","UPPCOMP")
			if found("Names")
				THIS.VALUE=Names.Company
				=insmode(.f.)
			else
				this.value=lcSearchStr
				=insmode(.t.)
			endif
		else
			this.value=space(0)
		endif
		this.selstart = lnInsertionPt
		
		
	ENDPROC

	PROCEDURE Fcompany.LostFocus
		=insmode(.T.)
		IF NOT EMPTY(ThisForm.oldorder)
			SET ORDER TO (ThisForm.oldorder)
		ENDIF
		
		ThisForm.Name1.Refresh
		ThisForm.COMPANY1.Refresh
		ThisForm.Address1.Refresh
		ThisForm.City1.Refresh
		ThisForm.State1.Refresh
		ThisForm.Zip1.Refresh
		ThisForm.Zip41.Refresh
		ThisForm.Phone1.Refresh
		
		
		ThisForm.Grid2.Refresh
		
	ENDPROC

	PROCEDURE Grid2.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.ID1.Refresh
		ThisForm.Name1.Refresh
		ThisForm.COMPANY1.Refresh
		ThisForm.Address1.Refresh
		ThisForm.City1.Refresh
		ThisForm.State1.Refresh
		ThisForm.Zip1.Refresh
		ThisForm.Zip41.Refresh
		ThisForm.Phone1.Refresh
	ENDPROC

	PROCEDURE Grid2.DblClick
		names.refresh
	ENDPROC

ENDDEFINE
