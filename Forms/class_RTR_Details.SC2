	ENDPROC

	PROCEDURE Unload
		IF USED('tmpRTR_Detail')
			USE IN tmpRTR_Detail
		ENDIF
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		*UniqDBFdel(ThisForm.fnSalesTotal)
		
		*IF "WORKORDER" $ SET("CLASSLIB")
		*	RELEASE CLASSLIB libs\WorkOrder
		*ENDIF
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdRefreshSQL.Click
		ThisForm.Load_RTR()
		ThisForm.Load_RTR_Detail()
		ThisForm.grdRTR_Detail.SetFocus()
	ENDPROC

	PROCEDURE cmdReturnSelect.Click
		ThisForm.nHoldReturn = tmpRTR_Detail.Detail
		ThisForm.Release
		
	ENDPROC

	PROCEDURE grdRTR_Detail.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Show_RTR_Detail()
	ENDPROC

ENDDEFINE
