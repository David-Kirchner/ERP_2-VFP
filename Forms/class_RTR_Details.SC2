	PROCEDURE formsrefresh
	ENDPROC

	PROCEDURE Init
		PARAMETERS biRTR_ID, pWhat
		
		*ThisForm.biRTR_ID = 29494	&&biRTR_ID
		ThisForm.biRTR_ID = PrepareSQLnum(biRTR_ID,'biRTR_ID',-5)
		
		
		IF VARTYPE(pWhat) = "C"
			IF UPPER(pWhat)="SELECT"
				ThisForm.cmdExit.Visible = .F.
				ThisForm.cmdReturnSelect.Visible = .T.
			ENDIF
		ENDIF
		
		
		
		ThisForm.Load_RTR()
		ThisForm.Load_RTR_Detail()
	ENDPROC

	PROCEDURE init_router_detail
		PARAMETERS biRTR_ID
		*ThisForm.INIT_Router_Detail()
		ThisForm.biRTR_ID = PrepareSQLnum(biRTR_ID,'biRTR_ID',-5)
		
		ThisForm.Load_RTR()
		ThisForm.Load_RTR_Detail()
	ENDPROC

	PROCEDURE init_router_detail_select
		PARAMETERS biRTR_ID, pWhat
		*ThisForm.INIT_Router_Detail_Select()
		
		
		ThisForm.biRTR_ID = PrepareSQLnum(biRTR_ID,'biRTR_ID',-5)
		
		
		IF VARTYPE(pWhat) = "C"
			IF UPPER(pWhat)="SELECT"
				ThisForm.cmdExit.Visible = .F.
				ThisForm.cmdReturnSelect.Visible = .T.
			ENDIF
		ENDIF
		
		
		
		ThisForm.Load_RTR()
		ThisForm.Load_RTR_Detail()
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_RTR ADDITIVE
		ENDIF
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT() 
	ENDPROC

	PROCEDURE load_rtr
		*ThisForm.Load_RTR()
		*ThisForm.biRTR_ID = biRTR_ID
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpRTR")
			USE IN tmpRTR
		ENDIF
		SELECT 0
		
		cSQL="SELECT * FROM dbo.rtr "
		cSQL=cSQL+" WHERE ID="+STR(ThisForm.biRTR_ID)
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRTR")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRTR")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRTR' )
		ENDIF
		
		ThisForm.txtRTR_ID.Value = ThisForm.biRTR_ID
		ThisForm.txtCreateDate.Value = ''
		ThisForm.txtCreateTime.Value = 0
		ThisForm.txtOrderType.Value = ''
		ThisForm.txtOrderNum.Value = ''
		ThisForm.chkStarted.Value = 1
		ThisForm.chkFinished.Value = 0
		ThisForm.chkCncld.Value = .null.
		ThisForm.txtNextDetail.Value = 0
		
		IF USED('tmpRTR')
			SELECT tmpRTR
			ThisForm.txtCreateDate.Value= PrepareSQLdate(tmpRTR.CreateDate,'CreateDate')
			ThisForm.txtCreateTime.Value= PrepareSQLtime(tmpRTR.CreateDate,'CreateDate')
			
			DO CASE
			CASE LEN(tmpRTR.SOitem) > 3
				ThisForm.txtOrderType.Value	= 'SO item'
				ThisForm.txtOrderNum.Value	= tmpRTR.SOitem
			CASE tmpRTR.WO > 0
				ThisForm.txtOrderType.Value	= 'Work Order'
				ThisForm.txtOrderNum.Value	= tmpRTR.WO 
		
			CASE tmpRTR.WO_Detail > 0
				ThisForm.txtOrderType.Value	= 'WO Detail'
				ThisForm.txtOrderNum.Value	= tmpRTR.WO_Detail 
		
			CASE tmpRTR.Quote_ID > 0
				ThisForm.txtOrderType.Value	= 'Quote ID'
				ThisForm.txtOrderNum.Value	= tmpRTR.Quote_ID 
		
			ENDCASE
			
			
			ThisForm.chkStarted.Value	= tmpRTR.Started
			ThisForm.chkFinished.Value	= tmpRTR.Finished
			ThisForm.chkCncld.Value		= tmpRTR.cncld
			ThisForm.txtNextDetail.Value = tmpRTR.Next_Detail_Start
		
			USE IN tmpRTR
		ENDIF
		
		
	ENDPROC

	PROCEDURE load_rtr_detail
		*ThisForm.Load_RTR_Detail()
		*ThisForm.biRTR_ID = biRTR_ID
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpRTR_Detail")
			ThisForm.grdRTR_Detail.RecordSource = ''
			USE IN tmpRTR_Detail
		ENDIF
		SELECT 0
		
		cSQL="SELECT * FROM dbo.rtr_Detail "
		cSQL=cSQL+" inner join dbo.rtr_Operation ON rtr_Detail.Oper_ID = rtr_Operation.Oper_ID "
		cSQL=cSQL+" WHERE rtr_ID="+STR(ThisForm.biRTR_ID)
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRTR_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRTR_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRTR_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRTR_Detail' )
		ENDIF
		
		ThisForm.txtDetail.Value = ''
		ThisForm.txtDetail_StartDate.Value = ''
		ThisForm.txtDetail_StartTime.Value = ''
		ThisForm.txtJobType.Value = ''
		ThisForm.chkD_Started.Value = .Null.
		ThisForm.chkD_Finished.Value = .NULL.
		ThisForm.chkD_Cncld.Value = .Null.
		ThisForm.txtOper_ID.Value = ''
		ThisForm.txtDetail_FinishDate.Value = ''
		ThisForm.txtOperation.Value = ''
		ThisForm.txtJobClass.Value = ''
		ThisForm.edtOper_Note.Value = ''
		
		IF USED('tmpRTR_Detail')
			SELECT tmpRTR_Detail
			ThisForm.grdRTR_Detail.RecordSource = 'tmpRTR_Detail'
		
			ThisForm.Show_RTR_Detail()
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE showwo_wodetail
		PARAMETERS nWO_Detail
		*ThisForm.ShowWO_WODetail(tmpWO.WO_Detail)
		
		IF VARTYPE(nWO_Detail) != "N"
			MESSAGEBOX("Bad Parameter",0,"No nWO_Detail")
			RETURN .F.
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE showwo_wod_window
	ENDPROC

	PROCEDURE show_rtr_detail
		*ThisForm.Show_RTR_Detail()
		ThisForm.txtDetail.Value 		= tmpRTR_Detail.Detail
		ThisForm.txtDetail_StartDate.Value = PrepareSQLdate(tmpRTR_Detail.StartDate,'StartDate',.F.)
		ThisForm.txtDetail_StartTime.Value = PrepareSQLtime(tmpRTR_Detail.StartDate,'StartDate',.F.)
		ThisForm.txtJobType.Value 		= tmpRTR_Detail.JobType
		ThisForm.chkD_Started.Value 	= PrepareSQLlogic(tmpRTR_Detail.Started,'Started')
		ThisForm.chkD_Finished.Value 	= PrepareSQLlogic(tmpRTR_Detail.Finished,'Finished')
		ThisForm.chkD_Cncld.Value		= PrepareSQLlogic(tmpRTR_Detail.Cncld,'Cncld')
		ThisForm.txtOper_ID.Value		= tmpRTR_Detail.Oper_ID
		ThisForm.txtDetail_FinishDate.Value = PrepareSQLdateTime(tmpRTR_Detail.FinishDate,'FinishDate',.F.)
		ThisForm.txtOperation.Value		= tmpRTR_Detail.Operation
		ThisForm.txtJobClass.Value		= tmpRTR_Detail.jobClass
		ThisForm.edtOper_Note.Value		= tmpRTR_Detail.Oper_Note
	ENDPROC

