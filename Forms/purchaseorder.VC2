	PROCEDURE pgfPO.pgPODesc.txtItem.Click
		PRIVATE cSalesnum,vSalesnum,nSalesNum
		vSalesnum = This.Parent.txtSalesNum.Value
		nSalesNum = 0
		
		IF VARTYPE(vSalesnum)= "N"
			nSalesNum = vSalesNum
			IF ThisForm.SalesNum = 0
				ThisForm.SalesNum = vSalesNum
			ENDIF
		ELSE
			IF VAL(vSalesNum) > 0
				nSalesNum = VAL(nSalesNum)
				IF ThisForm.SalesNum = 0
					ThisForm.SalesNum = VAL(vSalesNum)
				ENDIF
			ENDIF
		ENDIF
		
		
		PRIVATE nItemSO
		nItemSO = PrepareSQLnum(This.Value,'ItemSO',-1)
		
		IF nSalesNum  > 0
			IF nItemSO > 0
				IF EMPTY(ThisForm.cSOitem)
					ThisForm.cSOitem = Proper_SO_Item(STR(nSalesNum)+"-"+STR(nItemSO))
				ENDIF
			ENDIF
		ENDIF
		
		******************
		ThisForm.importSOitem()
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtItem.Valid
		PRIVATE cSalesnum,vSalesnum,nSalesNum
		vSalesnum = This.Parent.txtSalesNum.Value
		nSalesNum = 0
		
		IF VARTYPE(vSalesnum)= "N"
			nSalesNum = vSalesNum
			IF ThisForm.SalesNum = 0
				ThisForm.SalesNum = vSalesNum
			ENDIF
		ELSE
			IF VAL(vSalesNum) > 0
				nSalesNum = VAL(nSalesNum)
				IF ThisForm.SalesNum = 0
					ThisForm.SalesNum = VAL(vSalesNum)
				ENDIF
			ENDIF
		ENDIF
		
		
		PRIVATE nItemSO
		nItemSO = PrepareSQLnum(This.Value,'ItemSO',-1)
		
		IF nSalesNum  > 0
			IF nItemSO > 0
				ThisForm.cSOitem = Proper_SO_Item(STR(nSalesNum)+"-"+STR(nItemSO))
				
			ENDIF
		ENDIF
		
		******************
		ThisForm.importSOitem()
	ENDPROC

