	PROCEDURE pgfPO.pgPODesc.txtDispAlloy.Valid
		PRIVATE cAlloy ,cAlloyStandard
		cAlloyStandard = ShowSQLtxt(This.Value,'DisplayAlloy',20)
		cAlloy = ShowSQLtxt(This.parent.txtAlloy.Value,'Alloy',12)
		
		IF NOT EMPTY(cAlloy)
			IF NOT EMPTY(cAlloyStandard)
		
				IF NOT CheckDisplayAlloyforAlloy(cAlloy, cAlloyStandard, ThisForm.nConnHandle)
					MESSAGEBOX("Display Alloy to Vendor:"+ALLTRIM(cAlloy)+" has never been purchased as HPA Alloy:"+ALLTRIM(cAlloyStandard)+"!",0+48,"Check your Display Alloy!")
				ENDIF
				
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtDue_max.Valid
		PRIVATE vDate, dDate
		vDate = This.Value
		
		IF VARTYPE(vDate) = "T"
			dDate = TTOD(vDate)
			This.Value = dDate
		ENDIF
		IF VARTYPE(vDate) = "D"
			dDate = vDate
		ENDIF
		IF VARTYPE(vDate) = "C"
			dDate = CTOD(vDate)
			This.Value = dDate
		ENDIF
		
		
		
		IF dDate != CTOD("  /  /  ")
			*Have a date
			IF dDate > DATE() + 1095 
				*3 Years Ahead
				MESSAGEBOX("This date field is for OVER 3 years ahead!",0,"PO Valid")
			ENDIF
			IF dDate < DATE() - 90
				*3 Years Ahead
				MESSAGEBOX("This date field is for 3 months ago!",0,"PO Valid")
			ENDIF
		ENDIF
		
		PRIVATE dDue_Min
		dDue_Min = PrepareSQLDate(This.parent.txtDue_min.Value,'Due_Min',.F.,.T.)
		IF NOT EMPTY(dDue_Min) AND NOT EMPTY(dDate)
			IF dDue_Min > GetLatestDate( dDue_Min, dDate )
				MESSAGEBOX("Your min date("+DTOC(dDue_Min)+") is greater then your max date("+DTOC(dDate)+")!",0+48,"Bad Date!")
			ENDIF
		ENDIF
		
		PRIVATE dHPA_Due_Min
		dHPA_Due_Min = PrepareSQLDate(This.parent.txtHPA_Due_min.Value,'HPA_Due_Min',.F.,.T.)
		IF NOT EMPTY(dHPA_Due_Min) AND NOT EMPTY(dDate)
			IF dDate > GetLatestDate( dHPA_Due_Min, dDate )
				MESSAGEBOX("Your max Vendor ship date("+DTOC(dDate)+") is past the expected min receive date("+DTOC(dHPA_Due_Min)+")!",0+48,"Bad Date!")
			ENDIF
		ENDIF
		
		PRIVATE dHPA_Due_Max
		dHPA_Due_Max = PrepareSQLDate(This.parent.txtHPA_Due_max.Value,'HPA_Due_Max',.F.,.T.)
		IF NOT EMPTY(dHPA_Due_Max) AND NOT EMPTY(dDate)
			IF dDate > GetLatestDate( dHPA_Due_Max, dDate )
				MESSAGEBOX("Your max Vendor ship date("+DTOC(dDate)+") is past the expected max receive date("+DTOC(dHPA_Due_Max)+")!",0+48,"Bad Date!")
			ENDIF
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtDue_min.Valid
		PRIVATE vDate, dDate
		vDate = This.Value
		
		IF VARTYPE(vDate) = "T"
			dDate = TTOD(vDate)
			This.Value = dDate
		ENDIF
		IF VARTYPE(vDate) = "D"
			dDate = vDate
		ENDIF
		IF VARTYPE(vDate) = "C"
			dDate = CTOD(vDate)
			This.Value = dDate
		ENDIF
		
		
		
		IF dDate != CTOD("  /  /  ")
			*Have a date
			IF dDate > DATE() + 1095 
				*3 Years Ahead
				MESSAGEBOX("This date field is for OVER 3 years ahead!",0,"PO Valid")
			ENDIF
			IF dDate < DATE() - 90
				*3 Years Ahead
				MESSAGEBOX("This date field is for 3 months ago!",0,"PO Valid")
			ENDIF
		ENDIF
		
		PRIVATE dDue_Max
		dDue_Max = PrepareSQLDate(This.parent.txtDue_max.Value,'Due_Max',.F.,.T.)
		IF NOT EMPTY(dDue_Max) AND NOT EMPTY(dDate)
			IF dDate > GetLatestDate( dDue_Max, dDate )
				MESSAGEBOX("Your min date("+DTOC(dDate)+")is greater then your max date("+DTOC(dDue_Max)+")!",0+48,"Bad Date!")
			ENDIF
		ENDIF
		
		PRIVATE dHPA_Due_Min
		dHPA_Due_Min = PrepareSQLDate(This.parent.txtHPA_Due_min.Value,'HPA_Due_Min',.F.,.T.)
		IF NOT EMPTY(dHPA_Due_Min) AND NOT EMPTY(dDate)
			IF dDate > GetLatestDate( dHPA_Due_Min, dDate )
				MESSAGEBOX("Your min Vendor ship date("+DTOC(dHPA_Due_Min)+") is past the expected min receive date("+DTOC(dDate)+")!",0+48,"Bad Date!")
			ENDIF
		ENDIF
		
		PRIVATE dHPA_Due_Max
		dHPA_Due_Max = PrepareSQLDate(This.parent.txtHPA_Due_max.Value,'HPA_Due_Max',.F.,.T.)
		IF NOT EMPTY(dHPA_Due_Max) AND NOT EMPTY(dDate)
			IF dDate > GetLatestDate( dHPA_Due_Max, dDate )
				MESSAGEBOX("Your min Vendor ship date("+DTOC(dHPA_Due_Min)+") is past the expected max receive date("+DTOC(dDate)+")!",0+48,"Bad Date!")
			ENDIF
		ENDIF
		
		
	ENDPROC

