	PROCEDURE edit_po		&& Usually ignored as ThisFormSet.EditPO() is the usual.
		PARAMETERS pPOitem
		*ThisFormSet.Edit_PO(cPOitem)
		
		*!*	PRIVATE cPOitem
		*!*	cPOitem = PrepareSQLtxt(PurchaseOrder.POitem,"POitem",13)
		
		IF VARTYPE(pPOitem) != "C"
			*Error
			MESSAGEBOX("EditPO did not receive the POitem",48,"Procedure Error")
			TrackError("Error","EditPO did not receive the parameter POitem","PurchaseOrder:EditPO",LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_item( pPOitem )
		
		IF Proper_PO_Item(cPOitem) = Proper_PO_item('')
			MESSAGEBOX("EditPO did not receive the POitem",48,"Procedure Error")
			TrackError("Error","EditPO did not receive the parameter POitem - Empty.","PurchaseOrder:EditPO",LINENO(1))
			RETURN .F.
		ENDIF
		
		IF NOT PurchaseOrder_Allow_Cancel( cPOitem, ThisFormSet.nConnHandle )
			RETURN .F.
		ENDIF
		
		*************************************
		*Code from Edit button in EditOrder
		ThisFormSet.frmPO.ShowPOitem(cPOitem)
		
		*ThisFormSet.EditPOScreen(.T.)
		*	CALLS:ThisFormSet.frmPO.POScreen("ENABLE")
		
		IF VARTYPE(ThisFormSet.frmPO) = "O"
			ThisFormSet.frmPO.PO_NewAdd = .F.
			ThisFormSet.frmPO.POEditing = .T.
			ThisFormSet.frmPO.POScreen("ENABLE")
			ThisFormSet.frmPO.PO_VALID("EDIT")
		
			*ThisFormSet.frmPO.RefreshPOForms(ThisFormset.frmPO.pgfPO.pgPODesc.cmbForm.Value )
			
			*lstPOitems
			ThisFormSet.Refresh_lstPOitems(cPOitem)
			
			ThisFormSet.frmPO.Visible = .T.
			ThisFormSet.frmPOMaint.pf1.ActivePage = 1
			ThisFormSet.frmPO.pgfPO.pgPODesc.txtCompany.SetFocus()
		ENDIF
	ENDPROC

	PROCEDURE fillvendoraddr
		PARAMETERS nVendCode
		*ThisForm.FillVendorAddr(nVendCode)
		
		IF USED( 'Vendor' )
			USE IN Vendor
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.Vendor "
		cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Vendor')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Vendor' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC)
			RETURN .F.
		ENDIF
				
		IF USED('Vendor') 
			*ThisForm.nVendCode= Vendor.VendCode
			ThisForm.nVendCode = Vendor.VendCode
			ThisForm.pgfPO.pgVendor.txtVendCode.Value = Vendor.VendCode
			ThisForm.pgfPO.pgVendor.txtCompany.Value = Vendor.Company
			ThisForm.pgfPO.pgVendor.txtAddr1.Value = Vendor.Addr1
			ThisForm.pgfPO.pgVendor.txtAddr2.Value = Vendor.Addr2
			ThisForm.pgfPO.pgVendor.txtCity.Value = Vendor.City
			ThisForm.pgfPO.pgVendor.txtST.Value = Vendor.ST
			ThisForm.pgfPO.pgVendor.txtZip.Value = Vendor.Zip
			ThisForm.pgfPO.pgVendor.txtCountry.Value = Vendor.Country
			ThisForm.pgfPO.pgVendor.txtLastEdit.Value = PrepareSQLdate(Vendor.LastEdit,'LastEdit',.F.,.T.)
			ThisForm.pgfPO.pgVendor.QAApproved1.Value	= PrepareSQLnum(Vendor.QAApproved,'QAApproved',-1)
			ThisForm.pgfPO.pgVendor.Metal1.Value 	= PrepareSQLlogic(Vendor.Metal,'Metal',.F.)
			ThisForm.pgfPO.pgVendor.INACTIVE1.Value = PrepareSQLlogic(Vendor.Inactive,'Inactive',.F.)
			
			ThisForm.pgfPO.pgVendor.txtPeachID.Value = getPeachID_VendCode(Vendor.VendCode,ThisForm.nConnHandle)
			ThisForm.pgfPO.pgVendor.chkVendorPOConf.Value	= PrepareSQLlogic(VendorPOConf_POitem(ThisForm.cPOitem ,ThisForm.nConnHandle),'VedorPOConf',.F.)
			
			ThisForm.pgfPO.pgVendor.Vend_Notes.Value = getVendor_Notes_VendCode(Vendor.VendCode,ThisForm.nConnHandle)
			ThisForm.pgfPO.pgVendor.Vend_Print.Value = getVendor_Print_VendCode(Vendor.VendCode,ThisForm.nConnHandle)
			
			ThisForm.pgfPO.pgPODesc.lblVendCode.Caption = STR(nVendCode)
			ThisForm.pgfPO.pgPODesc.lblPeachID.Caption	= getPeachID_VendCode(nVendCode)
							
			RETURN .T.
		ELSE
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE fix_acct_stnd
		*ThisForm.Fix_AcctStnd()
		*Fixes Old P_LB to new S_QTY S_P
		
		*Called before Edit PO
		
		PRIVATE nSalesnum
		nSalesnum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		SELECT Quotes
		SET FILTER TO SalesNum = nSalesNum 
		
		*PRIVATE 
		PRIVATE nQ_P, nQ_QTY, nQ_PU, nQ_Total, nS_Total, nCuts, nOtherP
		PRIVATE nS_P, nS_QTY, nS_PU
		PRIVATE cAlloy,cForm,nPieces,nThck,nSz2,nSz3
		PRIVATE nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, nCuts ,ncWeight
		PRIVATE lUpdateQuotes, cMess, nMess, cInqNumP, nFeet, lExitScan
		lUpdateQuotes = .F.
		lExitScan = .F.
		
		SCAN
			nWeight			= PrepareSQLnum(Quotes.Weight,'Weight',8,1)
			nP_lb			= PrepareSQLnum(Quotes.P_lb,'P_lb',8,2)
			nP_pc			= PrepareSQLnum(Quotes.P_pc,'P_pc',9,2)
			nP_ft			= PrepareSQLnum(Quotes.P_ft,'P_ft',8,2)
			nCuts			= PrepareSQLnum(Quotes.Cuts,'Cuts',6,0)
			cOtherFld		= PrepareSQLtxt(Quotes.OtherFld,'OtherFld',10)
			nOtherP			= PrepareSQLnum(Quotes.OtherP,'OtherP',8,2)
			nLotP			= PrepareSQLnum(Quotes.LotP,'LotP',8,2)
			
			nQ_P		= PrepareSQLnum(Quotes.Q_P,'Q_P',-5)
			nQ_QTY		= PrepareSQLnum(Quotes.Q_QTY,'Q_QTY',-5)
			nQ_PU		= PrepareSQLnum(Quotes.Q_PU,'Q_PU',-1)
			nQ_Total	= PrepareSQLnum(Quotes.Q_Total,'Q_Total',-5)
			
			nCuts		= PrepareSQLnum(Quotes.Cuts,'Cuts',-5)
			nOtherP		= PrepareSQLnum(Quotes.OtherP,'OtherP',10,2)
			
			nS_P		= PrepareSQLnum(Quotes.S_P,'S_P',-5)
			nS_QTY		= PrepareSQLnum(Quotes.S_QTY,'S_QTY',-5)
			nS_PU		= PrepareSQLnum(Quotes.S_PU,'S_PU',-1)
			nS_Total	= PrepareSQLnum(Quotes.S_Total,'S_Total',-5)
			
			cInqNumP	= PrepareSQLtxt(Quotes.InqNumP,'InqNumP',9)
			nFeet = 0
			
			*****
			IF nS_QTY <= 0
				cAlloy		= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
				cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
				nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
				nThck		= PrepareSQLnum(Quotes.Thck,'Thck',10,4)
				nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
				nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		
				nS_QTY	= Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld,gnConnHandle )
				lUpdateQuotes = .T.
				
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
			ENDIF
			*****
			IF nS_PU <= 0 
				cForm	= PrepareSQLtxt(Quotes.Form,'Form',2)
				nS_PU	= nPU_Acct_Form( cForm, gnConnHandle) 
				lUpdateQuotes = .T.
				
			ENDIF
		*	*****
		*	IF nS_P <= 0
		*		nS_P	= IIF(nS_PU=1,nP_lb+(nOtherP/nWeight), IIF(nS_PU=2,nP_Ft+(nOtherP/nFeet),nP_Pc+(nOtherP/nPieces) ))
		*	ENDIF
			*****
			IF nQ_P <= 0
				*Record was still using P_LB..
				nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
				cAlloy		= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
				cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
				nThck		= PrepareSQLnum(Quotes.Thck,'Thck',10,4)
				nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
				nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
						
				nFeet 		= Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
				
				*nQ_P = Get_Qoute_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
				
				*Use old School Calc
				****************************************************
				*Use this Function to return a table with the Quoted Answers
				*This overwrite typical units and uses Units found in OtherFld and OtherP
				IF Get_Quote_Pricing(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
					IF USED('tmpQuote_Pricing')
						*nQ_P		= Get_Quote_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
						nQ_P	= PrepareSQLnum(tmpQuote_Pricing.P,'Q_P',-5)
						nQ_PU	= PrepareSQLnum(tmpQuote_Pricing.PU,'Q_PU',-1)
						nQ_QTY	= PrepareSQLnum(tmpQuote_Pricing.QTY,'Q_QTY',-5)				
						nQ_Total= PrepareSQLnum(tmpQuote_Pricing.Total,'Q_Total',-5)
		
						
						USE IN tmpQuote_Pricing
					ENDIF
				ENDIF
				
				SELECT Quotes
				
				lUpdateQuotes = .T.
			ENDIF
			
			*****
			IF nQ_Total = 0 
				IF ( nQ_P * nQ_QTY ) > 0
					nQ_Total = ( nQ_P * nQ_QTY )
					lUpdateQuotes = .T.
					nItemSale = nQ_Total +nCuts +nOtherP
				ENDIF
			ENDIF
			
			*****
			*Check Values
			*nQ_P, nQ_QTY	
			DO CASE
			CASE nQ_PU = 1
				*Weight must match QTY
				IF ROUND(nWeight,0) <> ROUND(nQ_QTY,0)
					ncWeight	= PrepareSQLnum(Quotes.cWeight,'Weight',8,1)
					IF ROUND(nWeight,0) <> ROUND(ncWeight,0) AND ROUND(ncWeight,0) = ROUND(nQ_QTY,0)
						cMess = "Weight on Quote "+ALLTRIM(STR(nWeight,10,0))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY,10,0))+CHR(13)+" or match Calculated Pounds "+ALLTRIM(STR(nWeight,10,0))+CHR(13)+"and Pricing Units is Per Pound!"+CHR(13)+" for InqNumP="+cInqNumP
						nMess = MESSAGEBOX(cMess+CHR(13)+"Do you want to Replace Weight with QTY Weight?",4+32,"Do you want to Replace?")
						IF nMess = 6
							nWeight = nQ_QTY
						ENDIF
					ENDIF
				ENDIF
				IF ROUND(nWeight,0) <> ROUND(nQ_QTY,0)	
					cMess = "Weight on Quote "+ALLTRIM(STR(nWeight,10,0))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY,10,0))+CHR(13)+"and Pricing Units is Per Pound!"+CHR(13)+" for InqNumP="+cInqNumP
					MESSAGEBOX(cMess,16,"Fix before proceding")
					TrackError(cMess,"Weight and QTY do not match when PU=1", PROGRAM(), LINENO(1))
					lUpdateQuotes = .F.
					lExitScan = .T.
				ENDIF
			CASE nQ_PU = 2
				*Feet must match QTY
				IF nFeet = 0
					nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
					cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
					nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
					nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		
					nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
				ENDIF
				IF nFeet <> nQ_QTY 
					cMess = "Length of Feet on Quote "+ALLTRIM(STR(nFeet ))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY))+CHR(13)+"and Pricing Units is Per Foot!"+CHR(13)+" for InqNumP="+cInqNumP
					MESSAGEBOX(cMess,16,"Fix before proceding")
					TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
					lUpdateQuotes = .F.
					lExitScan = .T.
				ENDIF		
			CASE nQ_PU = 3
				*Pieces must match Q_TY
				nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
				IF nQ_QTY <> nPieces
					cMess = "Pieces on Quote "+ALLTRIM(STR(nPieces))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY))+CHR(13)+"and Pricing Units is Per PC!"+CHR(13)+" for InqNumP="+cInqNumP
					MESSAGEBOX(cMess,16,"Fix before proceding")
					TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
					lUpdateQuotes = .F.
					lExitScan = .T.
				ENDIF
			CASE nQ_PU = 4
				*nLot
				IF nQ_QTY <> 1
					cMess = "QTY is not 1 "+ALLTRIM(STR(nQ_QTY))+CHR(13)+"and Pricing Units is Per LOT!"+CHR(13)+" for InqNumP="+cInqNumP
					MESSAGEBOX(cMess,16,"Fix before proceding")
					TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
					lUpdateQuotes = .F.
					lExitScan = .T.
				ENDIF
			CASE nQ_PU = 5
				*Inched must match QTY 
				IF nFeet = 0
					nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
					cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
					nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
					nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		
					nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
				ENDIF
				
				nInches = ROUND(nFeet/12,0)
				IF ROUND(nInches,0) <> ROUND(nQ_QTY,0) 
					cMess = "Length of Inches on Quote "+ALLTRIM(STR(ROUND(nInches,0)))+CHR(13)+" does not match QTY "+ALLTRIM(STR(ROUND(nQ_QTY,0)))+CHR(13)+"and Pricing Units is Per Inch!"+CHR(13)+" for InqNumP="+cInqNumP
					MESSAGEBOX(cMess,16,"Fix before proceding")
					TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
					lUpdateQuotes = .F.
					lExitScan = .T.
				ENDIF	
			CASE nQ_PU = 6
				*Weight in Kg must match QTY
				nKg = nWeight / 2.205
				IF ROUND(nKg ,0) <> ROUND(nQ_QTY,0)
					cMess = "Weight in Kg on Quote "+ALLTRIM(STR(nKg ,10,0))+CHR(13)+" does not match QTY "+ALLTRIM(STR(nQ_QTY,10,0))+CHR(13)+"and Pricing Units is Per Kg!"+CHR(13)+" for InqNumP="+cInqNumP
					MESSAGEBOX(cMess,16,"Fix before proceding")
					TrackError(cMess,"Weight and QTY do not match when PU=1", PROGRAM(), LINENO(1))
					lUpdateQuotes = .F.
					lExitScan = .T.
				ENDIF
			CASE nQ_PU = 7
				*MTR must match QTY 
				IF nFeet = 0
					nPieces		= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
					cForm		= PrepareSQLtxt(Quotes.Form,'Form',2)
					nSz2		= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
					nSz3		= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		
					nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle) 
				ENDIF
				
				nMeters = ROUND(nFeet/ 3.281,0)
				IF ROUND(nMeters ,0) <> ROUND(nQ_QTY,0) 
					cMess = "Length of Meters on Quote "+ALLTRIM(STR(ROUND(nMeters,0)))+CHR(13)+" does not match QTY "+ALLTRIM(STR(ROUND(nQ_QTY,0)))+CHR(13)+"and Pricing Units is Per Meter!"+CHR(13)+" for InqNumP="+cInqNumP
					MESSAGEBOX(cMess,16,"Fix before proceding")
					TrackError(cMess,"Pieces and QTY do not match when PU=3", PROGRAM(), LINENO(1))
					lUpdateQuotes = .F.
					lExitScan = .T.
				ENDIF				
				
			ENDCASE
			*****
			
			IF lUpdateQuotes 
			
				SELECT Quotes
				REPLACE Weight WITH nWeight
				REPLACE Q_P WITH nQ_P
				REPLACE Q_QTY WITH nQ_QTY
				REPLACE Q_PU WITH nQ_PU
				REPLACE Q_Total WITH nQ_Total
				REPLACE S_QTY WITH nS_QTY
				REPLACE S_P WITH nS_P
				REPLACE S_PU WITH nS_PU
		
				
				PRIVATE cUpdate
				cUpdate = "UPDATE dbo.AllQuotes SET "	
				cUpdate = cUpdate + " Weight="+STR(nWeight,9,1)
				cUpdate = cUpdate + ",Q_P="+STR(nQ_P,18,4)
				cUpdate = cUpdate + ",Q_QTY="+STR(nQ_QTY,18,4)
				cUpdate = cUpdate + ",Q_PU="+STR(nQ_PU,1,0)
				cUpdate = cUpdate + ",Q_Total="+STR(nQ_Total,18,4)
				
				cUpdate = cUpdate + ",S_QTY="+STR(nS_QTY,18,4)
				cUpdate = cUpdate + ",S_P="+STR(nS_P,18,4)
				cUpdate = cUpdate + ",S_PU="+STR(nS_PU)
				cUpdate = cUpdate + " WHERE AllQuotes.ID = " + ALLTRIM(STR(Quotes.ID))
					
				nSQLEXEC = SQLEXEC(gnConnHandle,cUpdate)
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
					RETURN .F.
				ENDIF
				
			ENDIF
			*****
			IF lExitScan
				EXIT
			ENDIF
			
		ENDSCAN
		
		
		GO TOP
		SET FILTER TO
		
		RETURN NOT lExitScan
		**********************
		
		
		
		
	ENDPROC

	PROCEDURE getvendorcontacts
		PARAMETERS nContactID
		*ThisForm.GetVendorContacts(nContactID)
		
		IF VARTYPE(nContactID)!="N"
			nContactID = 0
		ENDIF
		
		PRIVATE nVendCode 
		nVendCode = ThisForm.nVendCode
		*ThisForm.pgfPO.pgVendorContact.lstContactID.Clear
		ThisForm.pgfPO.pgVendorContact.grdContactID.RecordSource = ''
		
		IF USED('tmpVendorContacts')
		*	ThisForm.pgfPO.pgVendorContact.lstContactID.RowSource = ''
			USE IN tmpVendorContacts
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT ContactID,Contact FROM dbo.VendorContact WITH(NOLOCK) "
		cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
		cSQL = cSQL + " AND ISNULL(Inactive,0) = 0"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendorContacts')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpVendorContacts' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendorContacts")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendorContacts")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpVendorContacts' )
		ENDIF
		
		SELECT tmpVendorContacts
		INDEX ON ContactID TAG ContactID
		SET ORDER TO ContactID
		
		*SELECT ContactID,Contact FROM VendorContacts INTO ARRAY gaContactIDs
		GO TOP
		
		*IF RECCOUNT('VendorContacts') < 1
		*	DIMENSION gaContactIDs(1,2)
		*	gaContactIDs(1,1) = 0
		*	gaContactIDs(1,2) = ''
		*ENDIF
		*ThisForm.pgfPO.pgVendorContact.lstContactID.NumberOfElements = ALEN(gaContactIDs,1)
		*ThisForm.pgfPO.pgVendorContact.lstContactID.RowSourceType = 5
		*ThisForm.pgfPO.pgVendorContact.lstContactID.RowSource = 'gaContactIDs'
		
		*ThisForm.pgfPO.pgVendorContact.lstContactID.RowSourceType = 0
		*ThisForm.pgfPO.pgVendorContact.lstContactID.RowSource = ''
		*ThisForm.pgfPO.pgVendorContact.lstContactID.Refresh
		
		*!*	IF USED('tmpVendorContacts')
		*!*		IF RECCOUNT('tmpVendorContacts') > 0
		*!*			
		*!*			ThisForm.nContactID = tmpVendorContacts.ContactID
		*!*			
		*!*			SCAN
		*!*				ThisForm.pgfPO.pgVendorContact.lstContactID.AddItem(tmpVendorContacts.ContactID)
		*!*			ENDSCAN
		*!*		ENDIF
		*!*	ENDIF
		
		ThisForm.pgfPO.pgVendorContact.grdContactID.RecordSource = 'tmpVendorContacts'
		
		*ThisForm.pgfPO.pgVendorContact.lstContactID.Value = ThisForm.nContactID
		
		IF nContactID = 0 AND ThisForm.nContactID > 0
			LOCATE FOR ContactID = ThisForm.nContactID
			IF NOT FOUND()
				GO TOP
				nContactID = 0
				MESSAGEBOX("Did not find an ACTIVE Vendor Contact to display"+CHR(13)+"Please Select a contact "+CHR(13)+"and click [Save Contact to PO].",0+48,"Record not found")
			ELSE
				nContactID = tmpVendorContacts.ContactID	
			ENDIF
		ENDIF
		
		IF nContactID > 0
			ThisForm.ShowVendorContact(nContactID)
		ENDIF
		
	ENDPROC

	PROCEDURE importsoitem
		*ThisForm.importSOitem()
		
		PRIVATE lGetSOitem
		lGetSOitem = .F.
		
		PRIVATE nItemSO
		nItemSO = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtItem.Value,'ItemSO',-1)
		nItemSO = PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',-1)
		IF ThisForm.SalesNum > 0
			IF nItemSO > 0
				PRIVATE cAlloy 
				cAlloy = PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.txtAlloy.Value,'Alloy',12)
				IF EMPTY(cAlloy)
					lGetSOitem = .T.
				ENDIF
			ENDIF
			nSalesNum = ThisForm.SalesNum
		ENDIF
		
		PRIVATE nMess
		IF lGetSOitem
			nMess = MESSAGEBOX("Are you sure you want to use the"+CHR(13)+" Sales Order data in this PO?",4,"Import SO item.") 
			IF nMess != 6
				lGetSOitem = .F.
			ENDIF
		ELSE
			nMess = MESSAGEBOX("Are you sure you want to use the"+CHR(13)+" Sales Order data in this PO?",4,"Import SO item.") 
			IF nMess = 6
				lGetSOitem = .T.
			ENDIF
		ENDIF
		
		IF NOT lGetSOitem
			RETURN
		ENDIF
		*********************************
		
		PRIVATE cSOitem, nAllQuotes_ID
		cSOitem = ThisForm.cSOitem
		nAllQuotes_ID = 0
		
		IF EMPTY(cSOitem)
			cSOitem = Proper_SO_Item(STR(nSalesNum)+"-"+STR(nItemSO))
			ThisForm.cSOitem = Proper_SO_Item(STR(nSalesNum)+"-"+STR(nItemSO))
		ENDIF
		
		IF USED('tmpSOitem')
			USE IN tmpSOitem
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT ID FROM dbo.AllQuotes WHERE SOitem= dbo.f_ProperSOitem('"+cSOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitem' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitem' )
		ENDIF
		
		IF USED('tmpSOitem')
			IF RECCOUNT('tmpSOitem') > 0
				nAllQuotes_ID = PrepareSQLnum(tmpSOitem.ID,'ID',-3)
			ENDIF			
			USE IN tmpSOitem
		ENDIF
		
		*********************************
		IF nAllQuotes_ID > 0
			ThisForm.QuotesID = nAllQuotes_ID
			IF ThisForm.ReturnQuotedTable() &&Uses ThisForm.QuotesID
				SELECT tmpQuoted
			
				ThisForm.pgfPO.pgPOdesc.txtAlloy.VALUE		= tmpQuoted.Alloy
				ThisForm.pgfPO.pgPOdesc.cmbForm.VALUE		= tmpQuoted.Form
				ThisForm.pgfPO.pgPODesc.lblPerUnit.Caption	= FormUnitCaption(tmpQuoted.Form,.F.,.F.,.F.,ThisForm.nConnHandle)
				ThisForm.pgfPO.pgPOdesc.cmbCC.VALUE			= tmpQuoted.CC
				ThisForm.pgfPO.pgPOdesc.cmbCL.VALUE			= tmpQuoted.CL
				
				IF tmpQuoted.CC = 'R'
					ThisForm.pgfPO.pgPODesc.cmbMelt.Value	= "ESR"
					ThisForm.pgfPO.pgPOdesc.cmbCC.VALUE 	= '1'
				ENDIF
				ThisForm.pgfPO.pgPOdesc.txtPieces.VALUE		= tmpQuoted.Pieces
				ThisForm.pgfPO.pgPOdesc.txtThck.VALUE		= tmpQuoted.Thck
				ThisForm.pgfPO.pgPOdesc.txtStandSize.VALUE	= getStandardSize(tmpQuoted.Thck, ThisForm.nConnHandle)
				ThisForm.pgfPO.pgPOdesc.txtSz2.VALUE		= tmpQuoted.Sz2
				ThisForm.pgfPO.pgPOdesc.txtSz3.VALUE		= tmpQuoted.Sz3
				ThisForm.pgfPO.pgPODesc.txtOrder_Qty.Value	= tmpQuoted.Weight
				ThisForm.pgfPO.pgPODesc.cmbOrder_PU.Value	= PrepareSQLtxt( GetPUfromForm(tmpQuoted.Form, ThisForm.nConnHandle), 'Order_PU',1)
				ThisForm.pgfPO.pgPODesc.lblUnitText.Caption	= Get_cPUfrom_nPU(ThisForm.pgfPO.pgPODesc.cmbOrder_PU.Value)
				
				IF tmpQuoted.Form = "40" AND tmpQuoted.Thck < .13
					ThisForm.pgfPO.pgPOdesc.chkSPS1.VALUE = 1
				ELSE
					ThisForm.pgfPO.pgPOdesc.chkSPS1.VALUE = 0
				ENDIF
				
				ThisForm.Comments = '' &&tmpQuoted.comment
				ThisForm.Descript = tmpQuoted.Descript
				
				IF PrepareSQLlogic(tmpQuoted.Metric,'Metric',.F.)
					ThisForm.pgfPO.pgPODesc.chkMetric.Value = 1
					ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.Value = ShowSQLtxt(tmpQuoted.Sz1orig,'Sz1Orig',20)
					ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.Value = ShowSQLtxt(tmpQuoted.Sz2orig,'Sz2Orig',20)
					ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.Value = ShowSQLtxt(tmpQuoted.Sz3orig,'Sz3Orig',20)
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		ThisForm.POShipAddr = 0
		ThisForm.PO_NewAdd = .F.
		ThisForm.PO_NewClone = .F.
		ThisForm.nVendCode = 0
		ThisForm.SalesNum	= 0
		ThisForm.itemNumber = 0
		ThisForm.cSOitem	= ''
		ThisForm.cPOitem	= ''
		
		
		*PUBLIC ARRAY gaContactIDs(1,2)
		*gaContactIDs(1,1) = 0
		*gaContactIDs(1,2) = ''
		
		
		*ThisFormSet.Edit_PO(cPOitem)
		*This is used in the Calling program  ThisFormSet.EditPO(PurchaseOrder.POitem)  !!
		*ThisForm.ShowPOitem(cPOitem) --Is called by Calling Window
		*CALLS: ThisForm.Correct_Acct_Stnd()
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_rtr ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE makenewpoitem
		PARAMETERS pPOitem, pClonePO, pClonePOItem
		*ThisForm.MakeNewPOitem(cPOitem,.T.,.T.)
		*Only CLONE/AddItem need a cPOitem!
		
		PRIVATE lClonePO, lClonePOitem
		lClonePO	= .F.
		lClonePOitem = .F.
		
		PRIVATE cPOitem
		IF VARTYPE(pPOitem)="C"
			cPoItem = Proper_PO_item(pPOitem)
			
			IF VARTYPE(pClonePO) != "L"
				pClonePO = .F.
			ENDIF
			IF VARTYPE(pClonePOItem) != "L"
				pClonePOItem = .F.
			ENDIF
			
			IF pClonePO
				lClonePO = .T.
			ENDIF
				
			IF pClonePOItem 
				lClonePOitem = .T.
			ENDIF
			*Clone PO means to grab the Old PO data and add a new PO number, item 1
			*Clone POitem means to grab old PO data and increment the PO item.
			
		ELSE
			cPOitem = ''
		ENDIF
		
		*******************
		IF NOT (lClonePO OR lClonePOitem)
			*Start new PO - NOT Clone
			
			ThisForm.PO_NewAdd = .T.
			ThisForm.POScreen("CLEAR")
			ThisForm.POScreen("ENABLE")
			*ThisForm.PO_VALID("NEW")
			ThisForm.PO_New()
			
			IF PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtHpapo.Value,'HPApo',-3) = 0
				ThisForm.pgfPO.pgPODesc.txtHpapo.Value = GetNextPurchaseOrder(ThisForm.nConnHandle)
				ThisForm.pgfPO.pgPODesc.txtItempo.Value = 1
			ENDIF
				
			PRIVATE nHPApo, nPOitem_item, cPOitem 
			nHPApo		= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtHpaPo.VALUE,'HPApo',-3)
			nPOitem_item = PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtItemPo.VALUE,'POitem_item',2)
			
			cPOitem = Proper_PO_item( ALLTRIM(STR(nHPApo))+"-"+STR(nPOitem_item) )
			ThisForm.lstPoItems.Value = cPOitem 
			ThisForm.cPOitem = cPOitem
			
			PRIVATE cSOitem
			cSOitem = PrepareSQLtxt(ThisForm.cSOitem,'SOitem',10)
			
			TrackMess("PO "+ALLTRIM(STR(ThisForm.pgfPO.pgPODesc.txtHpapo.Value))+" item "+;
				ALLTRIM(STR(ThisForm.pgfPO.pgPODesc.txtItempo.Value))+;
				" Start new PO or Item - NOT Clone."+;
				IIF(cSOitem=Proper_SO_item(''),"","  SOitem:"+cSOitem)+;
				" PurchaseOrder.MakeNewPOitem()" )
			
		ELSE	
			*Continue with existing PO!  Clone PO or POitem!
			*make sure Vendor/Vendor Contact are filled the same!	
			*POitem is set in ThisForm.pgfPO.pgPODesc.txtHpapo.Value
		
			IF lClonePOitem	
				*Add next item to PO!  
				PRIVATE nCurrHPAPO,nItemPO
				nCurrHPAPO = VAL(cPoItem)
				IF EMPTY(nCurrHPAPO)
					nCurrHPAPO = VAL(cPOitem)
					*nCurrHPAPO = ThisForm.pgfPO.pgPODesc.txtHpapo.Value
				ENDIF
				
				IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
					*Show the old POitem
					ThisForm.ShowPOitem(cPOitem)
				ENDIF		
		
				nItemPO = GetNextPurchaseOrderItem(nCurrHPAPO, ThisForm.nConnHandle)
				ThisForm.pgfPO.pgPODesc.txtItempo.Value = nItemPO
				ThisForm.cPOitem = Proper_PO_Item( STR(nCurrHPAPO)+"-"+ALLTRIM(STR(nItemPO)) )
				
				ThisForm.POsetVendor(nCurrHPAPO)
				
				ThisForm.pgfPO.pgPODesc.txtPO_Rev.Value = 0
				
				ThisForm.pgfPO.pgPODesc.txtStandSize.Value = 0
				
				ThisForm.pgfPO.pgPODesc.txtOrderDate.Value 	= DATE()
				ThisForm.pgfPO.pgPODesc.txtDue_max.Value 	= CTOD("  /  /  ")
				ThisForm.pgfPO.pgPODesc.txtDue_min.Value 	= CTOD("  /  /  ")
				ThisForm.pgfPO.pgPODesc.txtHPA_Due_Max.Value = CTOD("  /  /  ")
				ThisForm.pgfPO.pgPODesc.txtHPA_Due_Min.Value = CTOD("  /  /  ")
				
				ThisForm.pgfPO.pgPOdesc.lblWOnum.Caption	= ''
				ThisForm.pgfPO.pgPOdesc.lblWO_Dnum.Caption	= ''
				
				ThisForm.chkCancelPO.Value		= 0
				ThisForm.chkDeliveredPO.Value	= 0
				ThisForm.lblTBL.Caption			= ''
		
				ThisForm.pgfPO.pgPOdesc.lblReconciled.Visible	= .F.
				ThisForm.pgfPO.pgPOdesc.lblDelivered.Visible	= .F.
				ThisForm.pgfPO.pgPOdesc.lblCancelled.Visible	= .F.
				
				ThisForm.pgfPO.pgPOdesc.txtP_Lb.Value = 0
				ThisForm.pgfPO.pgPOdesc.txtP_pc.Value = 0
				ThisForm.pgfPO.pgPOdesc.txtP_ft.Value = 0
				ThisForm.pgfPO.pgPOdesc.txtLotP.Value = 0
				
				*IF Proper_PO_item(ThisForm.cSOitem) != Proper_PO_item("")
				PRIVATE nItemSO
				nItemSO = PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',-1) &&NOT ThisForm.pgfPO.pgPODesc.txtItem.Value
				IF nItemSO > 0
					nMess = MESSAGEBOX("Is this PO for this Sales Order Item? "+ALLTRIM(STR(nItemSO)),4+32,"Use SOitem?")
					IF nMess = 6
						ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value	= 0
						ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = 0
						ThisForm.pgfPO.pgPODesc.txtOrder_Qty.Value	= 0
						ThisForm.pgfPO.pgPODesc.txtOrder_P.Value	= 0
						ThisForm.pgfPO.pgPODesc.txtPOi_Total.Value	= 0
						
						*Get Sales data.
						ThisForm.ImportSOitem()
		
					ENDIF
				ENDIF
				
				
				
				ThisForm.PO_NewClone = .T.
				TrackMess("PO "+ALLTRIM(STR(nCurrHPAPO ))+" item "+ALLTRIM(STR(nItemPO))+" Clone PO - Add item."+" PurchaseOrder.MakeNewPOitem()")
				
			ENDIF
			**************************************************************
			IF lClonePO	
				IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
					*Show the old POitem
					ThisForm.ShowPOitem(cPOitem)
				ENDIF		
				
		 		*Clone to a new PO	
		 		*Remove some data that should not be carried from clone.
		 		
				PRIVATE nCurrHPAPO,nItemPO
				nCurrHPAPO = VAL(cPoItem)
				IF EMPTY(nCurrHPAPO)
					nCurrHPAPO = VAL(ThisForm.cPOitem)
					*nCurrHPAPO = ThisForm.pgfPO.pgPODesc.txtHpapo.Value
				ENDIF
				
				PRIVATE nNextHPAPO 
				nNextHPAPO = GetNextPurchaseOrder(ThisForm.nConnHandle)
				ThisForm.pgfPO.pgPODesc.txtHpaPo.Value = nNextHPAPO 
			*	ThisForm.pgfPO.pgPODesc.txtItempo.Value = GetNextPurchaseOrderItem(nNextHPAPO, ThisForm.nConnHandle)
				ThisForm.pgfPO.pgPODesc.txtItemPo.Value = 1
				
				cPOitem	= Proper_PO_Item( STR(nNextHPAPO )+"-01" )
				ThisForm.cPOitem = cPOitem
				
				ThisForm.pgfPO.pgPODesc.txtPO_Rev.Value = 0
				
				ThisForm.pgfPO.pgPODesc.txtOrderDate.Value 	= DATE()
				ThisForm.pgfPO.pgPODesc.txtDue_max.Value 	= CTOD("  /  /  ")
				ThisForm.pgfPO.pgPODesc.txtDue_min.Value 	= CTOD("  /  /  ")
				ThisForm.pgfPO.pgPODesc.txtHPA_Due_Max.Value = CTOD("  /  /  ")
				ThisForm.pgfPO.pgPODesc.txtHPA_Due_Min.Value = CTOD("  /  /  ")
				
				ThisForm.pgfPO.pgPOdesc.lblWOnum.Caption	= ''
				ThisForm.pgfPO.pgPOdesc.lblWO_Dnum.Caption	= ''
				
				ThisForm.chkCancelPO.Value		= 0
				ThisForm.chkDeliveredPO.Value	= 0
				ThisForm.lblTBL.Caption 		= ''
				
				ThisForm.pgfPO.pgPOdesc.lblReconciled.Visible	= .F.
				ThisForm.pgfPO.pgPOdesc.lblDelivered.Visible	= .F.
				ThisForm.pgfPO.pgPOdesc.lblCancelled.Visible	= .F.
				
				ThisForm.pgfPO.pgPOdesc.txtP_Lb.Value = 0
				ThisForm.pgfPO.pgPOdesc.txtP_pc.Value = 0
				ThisForm.pgfPO.pgPOdesc.txtP_ft.Value = 0
				ThisForm.pgfPO.pgPOdesc.txtLotP.Value = 0
				
				PRIVATE nItemSO
				*nItemSO = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtItem.Value,'ItemSO',-1)
				nItemSO = PrepareSQLnum(ThisForm.txtItem.Value,'ItemSO',-1)
				IF nItemSO > 0
					nMess = MESSAGEBOX("Is this PO for this Sales Order Item? "+ALLTRIM(STR(nItemSO)),4+32,"Use SOitem?")
					IF nMess = 6
						*Get Sales data.
						ThisForm.ImportSOitem()
						
						ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value	= 0
						ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = 0
						ThisForm.pgfPO.pgPODesc.txtOrder_P.Value	= 0
						ThisForm.pgfPO.pgPODesc.txtOrder_Qty.Value	= 0
						ThisForm.pgfPO.pgPODesc.txtOtherP.Value	= 0
						ThisForm.pgfPO.pgPODesc.txtPOi_Total.Value	= 0
					ENDIF
				ENDIF
		
				ThisForm.PO_NewClone = .T.
				TrackMess("PO "+ALLTRIM(STR(nNextHPAPO))+" Clone to new PO - item 1."+" PurchaseOrder.MakeNewPOitem()")
				
			ENDIF
			
			ThisForm.pgfPO.pgPODesc.txtPO_Rev.Value = 0
			*ThisForm.pgfPO.pgPODesc.txtSalesnum.Value = 0
			*ThisForm.SalesNum = 0
			*ThisForm.pgfPO.pgPODesc.txtItem.Value = 0
				
			ThisForm.POScreen("ENABLE")
			
			ThisForm.PO_NewAdd = .F. &&Not newAdd but CloneAdd
			
			IF ThisForm.pgfPO.ActivePage <> 1
				ThisForm.pgfPO.ActivePage = 1
			ENDIF
			
		
			ThisForm.pgfPO.pgPODesc.txtCompany.SetFocus()
		
		
		ENDIF
		
		**********************
		*Drop Sales Info
		ThisForm.pgfPO.pgPODesc.txtSalesnum.Value = 0
		ThisForm.pgfPO.pgPODesc.txtItem.Value = 0
		ThisForm.SalesNum = 0
		ThisForm.itemNumber = 0
		
		ThisForm.pgfPO.pgPOdesc.lblWOnum.Caption = ''
		ThisForm.pgfPO.pgPOdesc.lblWO_Dnum.Caption = ''
		
		**********************
		PRIVATE nHpaPo,nItemPo
		nHpaPo = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtHPApo.VALUE,'ERP PO',-3,0)
		nItemPo	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtItemPO.Value,'Item PO',2,0)
		
		ThisForm.pgfPO.pgPOAddress.txtHpapo.Value	= nHpaPo
		ThisForm.pgfPO.pgPOAddress.txtItempo.Value  = nItemPo
		ThisForm.cPoItem = Proper_PO_item( STR(nHpaPo)+"-"+STR(nItemPo,2,0) )
		
		ThisForm.POEditing = .T.
		ThisForm.RefreshPOForms( ThisForm.pgfPO.pgPODesc.cmbForm.Value )
		
		
		
	ENDPROC

	PROCEDURE movepoi_lst		&& move a POitem from a Lst to be entered in anther Lst
		PARAMETERS cPoItem, cNewTBL, cTBL
		*Remove a POitem from a Lst to be entered in another Lst
		*lOK = ThisForm.MovePOi_Lst(cPoItem,"B","S")
		
		**********************
		PRIVATE nID_Detail, cSQL, nMaster_ID
		nID_Detail = 0
		nMaster_ID = 0
		
		*First, verify Lst exists to remove 
		IF USED("StkMastCnt")
			USE IN StkMastCnt
		ENDIF
		cSQL="SELECT ID_Detail FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL=cSQL+" dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL=cSQL+" dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL=cSQL+" dbo.WIPLst_Process "
		OTHERWISE
			*No TBL
			RETURN .F.
		ENDCASE
		cSQL=cSQL+" WHERE PO_Item = dbo.f_ProperPOitem('"+cPoItem+"')"
		cSQL=cSQL+" AND Process_ID = 'INCOMING' "
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'StkMastCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StkMastCnt' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StkMastCnt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StkMastCnt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,ThisForm.nConnHandle)
			nStkMastCnt = 0
		ELSE
			IF USED("StkMastCnt")
				nID_Detail = PrepareSQLnum(StkMastCnt.ID_Detail,'ID_Detail',-3)
				USE IN StkMastCnt
			ELSE
				nID_Detail = 0
			ENDIF
		ENDIF
		
		IF nID_Detail > 0
			nMaster_ID = GetIDfromID_Detail( nID_Detail, cTBL, ThisForm.nConnHandle)
		ELSE
			IF LEN( ReceivingTBL_POitem(cPOitem, ThisForm.nConnHandle) )=0
		
				MESSAGEBOX("Did not find an INCOMING process to Move from '"+cTBL+"' .",0,"Move Failed")
				TrackError("Did not find an INCOMING process to Move from '"+cTBL+"' ."+CHR(13)+"Failed to move to '"+cNewTBL+"'","Move Failed", PROGRAM(), LINENO(1))
				RETURN .F.
			ELSE
				*Found the Receiving Record!
			ENDIF
		ENDIF
		
		PRIVATE nID_Detail_Process, lRemovedOldLst 
		nID_Detail_Process = 0
		lRemovedOldLst =.F.
		PRIVATE cMess
		IF nID_Detail > 0
			cMess = "This PO-Item '"+cPoItem+"' was found in "+TableName_TBL(cTBL)+"."+CHR(13)
			cMess = cMess+"The "+TableName_TBL(cTBL)+" record "+CHR(13)
			cMess = cMess+"will be moved with all Process's "+CHR(13)
			cMess = cMess+"to "+TableName_TBL(cNewTBL)+"."+CHR(13)
			cMess = cMess+"the POitem store the new "+TableName_TBL(cNewTBL)+" ID"
			
			MESSAGEBOX( cMess,0+48,"Removing from "+TableName_TBL(cTBL) )
			
			***********************************************************************************
			nID_Detail_Process = Move_Lst_POitem( cPOitem, cTBL, cNewTBL, ThisForm.nConnHandle)
			***********************************************************************************
				
			IF nID_Detail_Process > 100
				
				cSQL="UPDATE dbo.PurchaseOrder "
				cSQL=cSQL+" SET TBL='"+cNewTBL+"'"
				cSQL=cSQL+" ,ID_Detail_Process ="+STR(nID_Detail_Process)
				cSQL=cSQL+" WHERE POitem = dbo.f_ProperPOitem('"+cPoItem+"')"
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpMoveTBL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMoveTBL' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMoveTBL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMoveTBL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,ThisForm.nConnHandle)
				ELSE
					lRemovedOldLst = .T.
				ENDIF
			ENDIF	
		ENDIF
		
		RETURN lRemovedOldLst 
		
		
		
		
	ENDPROC

	PROCEDURE notify_wo		&& Notify need WO  on Conversion Service PO
		*ThisForm.Notify_WO()
		
		*PRIVATE lConvServ, nWO
		*lConvServ = PrepareSQLlogic(ThisForm.pgfPO.pgPOdesc.chkConvServ.Value,'ConvServ',.F.)
		IF Count_HPAPOinPurchaseOrder( Proper_PO(ThisForm.cPOitem),ThisForm.nConnhandle,'ConvServ') > 0
			HPAPOneedsWO(Proper_PO(ThisForm.cPOitem),ThisForm.nConnhandle)
			**Function HPAPOneedsWO loops thru all items and gives warning on each item!
			*getWorkOrder_POitem  getWOD_POitem  getWO_with_POitem  getWOD_with_POitem  get_WO_from_POitem
		ENDIF
		
	ENDPROC

	PROCEDURE poaddress_screen
		PARAMETER WhereWhat
		*ThisForm.POAddress_Screen()
		
		DO CASE
		CASE WhereWhat = "POShipToEdit" 
			*ThisForm.pgfPO.pgPOAddress.txtPOShipAddr
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Caption = "Edit"
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Caption = "Clear"
			ThisForm.pgfPO.pgPOAddress.txtCompany.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtAddr1.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtAddr2.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtCity.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtST.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtZip.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtCountry.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtContact.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtPhone.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtFax.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.txtEmail.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			
			*Enable the page tabs
			ThisForm.pgfPO.pgPODesc.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.Enabled = .T.
			ThisForm.pgfPO.pgVendor.Enabled = .T.
			ThisForm.pgfPO.pgVendorContact.Enabled = .T.
			ThisForm.pgfPO.pgSODist.Enabled = .T.
			ThisForm.pgfPO.pgTestPO.Enabled = .T.
			*Caption will say EDIT
			*ThisForm.cmdPOAdd.ENABLED = .T.
			ThisForm.cmdPODelete.ENABLED = .T.
			ThisForm.cmdPOEdit.ENABLED = .T.
			*ThisForm.cmdPrintPO.ENABLED = .T.
			ThisForm.chkCancelPO.ENABLED = .T.
			ThisForm.chkDeliveredPO.ENABLED = .T.
			ThisForm.cmdPoPrev.ENABLED = .T.
			ThisForm.cmdPoNext.ENABLED = .T.
		
