	ENDPROC

	PROCEDURE pgfPO.pgPODesc.lblSalesnum.Click
		PRIVATE nInqNumP
		DO FORM Forms\SearchQuotes WITH "QUOTES","" TO cInqnumP
		
		IF VARTYPE(cInqNumP) = "C"
			*get SOitem from nInqNumP
			IF LEN(ALLTRIM(cInqNumP)) > 0
				
				PRIVATE nSO,nItemSO,cSOitem
				nSO = 0
				IF USED('tmpSO')
					USE IN tmpSO
				ENDIF
				
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT SOitem,SalesNum,Item FROM dbo.AllQuotes WHERE InqNumP = '"+cInqNumP+"'"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSO' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSO' )
				ENDIF
		
				IF USED('tmpSO')
					IF RECCOUNT('tmpSO') > 0
						cSOitem	= ShowSQLtxt(tmpSO.SOitem,'SOitem',10)
						nSO		= PrepareSQLnum(tmpSO.SalesNum,'SalesNum',-3)
						nItemSO	= PrepareSQLnum(tmpSO.Item,'ItemSO',-1)
						
						IF MESSAGEBOX("Do you want to mark this PO item as a part of "+CHR(13)+"SOitem: "+ALLTRIM(cSOitem)+" ?",4,"Right SOitem?") = 6
							
							This.parent.txtSalesnum.Value	= nSO
							ThisForm.SalesNum 				= nSO
							This.parent.txtItem.Value		= nItemSO
							ThisForm.itemNumber 			= nItemSO
							ThisForm.cSOitem 	= Proper_SO_Item(STR(nSO)+"-"+STR(nItemSO))
							
							This.parent.txtSalesnum.Refresh
							This.parent.txtItem.Refresh
							
							******************
							IF nSO > 0
								IF MESSAGEBOX("Do you want to Import/Overwrite this POitem data?"+CHR(13)+"Get SOitem data.",4+32,"Import SO") = 6
									ThisForm.ImportSOitem()
								ENDIF
							ENDIF
							******************
							
							*update screen to be able to Save, You can click HPA SO when not in edit mode!
							IF ThisForm.cmdPOEdit.Caption = "Edit PO"
								
								ThisForm.POEditing = .T.
								*ThisForm.PO_NewClone = .T.
								ThisForm.POScreen("ENABLE")
								ThisForm.PO_NewAdd = .F. &&Not newAdd but CloneAdd
								ThisForm.pgfPO.pgPODesc.txtCompany.SetFocus()
								
								ThisForm.RefreshPOForms( ThisForm.pgfPO.pgPODesc.cmbForm.Value )
		
							ENDIF
						ENDIF
					ENDIF			
					USE IN tmpSO
				ENDIF
					
			ELSE
				*Did not get new SO
				PRIVATE nSalesNum
				nSalesNum = PrepareSQLnum(This.parent.txtSalesnum.Value,'SalesNum',-3)
				
				IF nSalesNum > 0
					nMess = MESSAGEBOX("Do you want to remove the Sales Number:"+ALLTRIM(STR(nSalesNum))+" from this PO?",4+32,"Remove SO?")
					IF nMess = 6
						This.parent.txtSalesnum.Value = 0
						This.parent.txtItem.Value = 0
						ThisForm.SalesNum 	= 0
						ThisForm.itemNumber = 0
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.lblStockLst_QTY.Click
		ThisForm.SetStockLst_QTY()
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.lblWOnum.DblClick
		PRIVATE nWO
		nWO	= PrepareSQLnum(This.parent.lblWOnum.Caption,'WO',-3)
		IF nWO > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO(nWO,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.lblWO_Detail.Click
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(This.Parent.txtWO_Detail.Value,'WO_Detail',-3)
		
		IF nWO_Detail > 0
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO_Detail(nWO_Detail,.T.)
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
			
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.lblWO_Dnum.DblClick
