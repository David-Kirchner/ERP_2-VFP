	PROCEDURE pgfPO.pgPODesc.lblPerUnit.Click
		PRIVATE cForm, nS_PU, nOrder_PU, cPUcaption
		cForm	= ShowSQLtxt(This.parent.cmbForm.Value,'Form',2)
		nS_PU	= PrepareSQLnum(This.Parent.txtStockLst_PU.Value,'S_PU',-1)
		*GetPUfrom_POitem( returns the Accounting Standard PU from the Form checks Services, ConvServ, Equipment as Lot
		nOrder_PU = PrepareSQLnum(This.Parent.cmbOrder_PU.Value,'Order_PU',1)
		cPUcaption	= PrepareSQLtxt(This.parent.lblPerUnit.Caption,'PerUnit',5)
		
		PRIVATE nOrder_Qty, nStockLst_QTY
		nOrder_Qty		= PrepareSQLnum(This.parent.txtOrder_Qty.Value,'Order_Qty',-5)
		nStockLst_QTY	= PrepareSQLnum(This.parent.txtStockLst_QTY.Value,'StockLst_QTY',-5)
		
		PRIVATE nOrder_P, nStockLst_P, nOtherP
		nOrder_P		= PrepareSQLnum(This.parent.txtOrder_P.Value,'Order_P',-5)
		nStockLst_P		= PrepareSQLnum(This.parent.txtStockLst_P.Value,'StockLst_P',-5)
		nOtherP			= PrepareSQLnum(This.parent.txtOtherP.Value,'OtherP',10,2)
		
		ThisForm.pgfPO.pgPODesc.txtPOi_Total.Value	= ( nOrder_QTY * nOrder_P ) + nOtherP
		PRIVATE nOrder_Total
		nOrder_Total = nOrder_Qty * nOrder_P
		
		PRIVATE nPieces
		nPieces	= PrepareSQLnum(This.parent.txtPieces.VALUE,'Pieces',6,0)
		
		*Get nCalcWeight
		PRIVATE cAlloy, cForm, nThck, nSz2, nSz3, nCalcWeight
		cAlloy			= ShowSQLtxt(This.Parent.txtAlloy.VALUE,'Alloy',12,.F.)
		cForm			= ShowSQLtxt(This.Parent.cmbForm.VALUE,'Form',2,.T.)
		nThck			= PrepareSQLnum(This.Parent.txtThck.VALUE,'Thck',10,4)
		nSz2			= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
		nSz3			= PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
		nCalcWeight = CalcWeight(nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisForm.nConnHandle)
		nCalcWeight = ROUND(nCalcWeight ,1)
		
		** Pounds
		IF EMPTY(This.parent.txtPounds.Value)
			This.parent.txtPounds.Value = nCalcWeight 
		ENDIF
		
		PRIVATE lServicesPO, lConvServ, lEquipment
		lServicesPO = PrepareSQLlogic( This.Parent.chkLab_Service.Value,'ServicesPO',.F. )
		lConvServ = PrepareSQLlogic(This.parent.chkConvServ.Value,'ConvServ',.F.)
		lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
		
		
		PRIVATE nNew_P, nNew_QTY 
		nNew_P = 0
		nNew_QTY = 0
		
		IF nS_PU  = 0
			nS_PU	= GetPUfromForm( cForm, ThisForm.nConnHandle )
		ENDIF
		
		IF lServicesPO OR lConvServ OR lEquipment
			IF nS_PU = 3 OR nS_PU = 4
				*OK
			ELSE
				*
				*Set to Lot
				nS_PU = 4
				nStockLst_QTY	= 1
				This.parent.txtStockLst_QTY.Value = 1
			ENDIF
		ENDIF
		
		**********
		DO CASE
		CASE nS_PU = 1
			* $/Lb
			IF nCalcWeight  = 0
				*get from nOrder values.
				DO CASE
				CASE nOrder_PU = 1	
					IF nOrder_Qty > 0 
						nCalcWeight = ROUND(nOrder_Qty,1)
					ENDIF
				CASE nOrder_PU = 2
				CASE nOrder_PU = 3
				CASE nOrder_PU = 4
				ENDCASE
				
			ENDIF
			
			IF nCalcWeight > 0
				nNew_P 		= ROUND( nOrder_Total / nCalcWeight ,4)
				nNew_QTY	= ROUND(nCalcWeight,1)
			ELSE
				
				MESSAGEBOX("Must have Total Calculated Weight before this can be used.",48,"Cannot fill Price.")
			ENDIF
			
			IF NOT cPUcaption = "$/LB"
				This.parent.lblPerUnit.Caption =  "$/LB"
			ENDIF
			
		**********************************************
		CASE nS_PU = 2
			* $/Ft
			PRIVATE nFtLen, nSigDim
			nFtLen = 0
			nSigDim = getSigDim(cForm, ThisForm.nConnHandle)
			IF nSigDim = 2
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz2/12
			ENDIF
			IF nSigDim = 3
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz3/12
			ENDIF
					
			IF nOrder_PU = 2
				nNew_P = nOrder_P
			ELSE
				*Convert to $/Ft
				nNew_P = nOrder_Total / nFtLen
			ENDIF
			nNew_P = ROUND( nNew_P ,1)
			
			nNew_QTY 	= ROUND(nFtLen,1)
			
			IF NOT cPUcaption = "$/FT"
				This.parent.lblPerUnit.Caption =  "$/FT"
			ENDIF
			
		**********************************************
		CASE nS_PU = 3
			* $/Pc
			IF nOrder_PU = 3
				nNew_P = nOrder_P 
			ELSE
				IF nPieces = 0
					nPieces = 1
					WAIT WINDOW "Calculating using 1 Piece." NOWAIT
				ENDIF
				nNew_P = nOrder_Total / nPieces
			ENDIF
			nNew_P = ROUND( nNew_P ,4)
			
			nNew_QTY = nPieces
			
			IF NOT cPUcaption = "$/PC"
				This.parent.lblPerUnit.Caption =  "$/PC"
			ENDIF
			
		**********************************************
		CASE nS_PU = 4
			* $Lot
			IF nOrder_PU = 4
				nNew_P = nOrder_P 
			ELSE
				IF nPieces = 0
					nPieces = 1
					nStockLst_QTY = 1
					This.parent.txtStockLst_QTY.Value = 1
					WAIT WINDOW "Calculating using 1 Piece ($ LOT)" NOWAIT
				ENDIF
				nNew_P = nOrder_Total
			ENDIF
			nNew_P = ROUND( nNew_P ,4)
			
			nNew_QTY = 1
			
			IF NOT cPUcaption = "$ Lot"
				This.parent.lblPerUnit.Caption =  "$ Lot"
			ENDIF
		**********************************************
		OTHERWISE
			IF NOT cPUcaption = "$ LOT"
				This.parent.lblPerUnit.Caption =  "$ LOT"
			ENDIF
			nNew_P = 0	&&Does not change if 0
			nNew_QTY = 0 &&Does not change if 0
			nStockLst_QTY = 1
		ENDCASE
		*********
		
		IF nNew_P > 0
			This.Parent.txtStockLst_P.Value = nNew_P
			This.Parent.txtStockLst_P.Refresh
		ENDIF
		
		IF nNew_QTY > 0
			This.parent.txtStockLst_QTY.Value = nNew_QTY
			This.parent.txtStockLst_QTY.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.lblPieces.Click
		ThisForm.SetStockLst_QTY()  &&Makes sure txtStockLst_QTY is Filled
		
		
		*!*	PRIVATE nOrder_QTY, nStockLst_QTY, cPUcaption, nS_PU, nPU, nPcs
		*!*	nPounds		= PrepareSQLnum(This.parent.txtPounds.Value,'Pounds',9,1)
