	PROCEDURE pgfPO.pgVendorContact.Click
		*ThisForm.GetVendorContacts(ThisForm.nContactID)
		PRIVATE nContactID
		PRIVATE nVendCode
		nVendCode = PrepareSQLnum(This.Parent.pgVendor.txtVendCode.Value,'VendCode',-3)
		
		IF (ThisForm.nVendCode > 0) OR (nVendCode > 0)
			IF nVendCode <> ThisForm.nVendCode
				ThisForm.Show_VendCode( nVendCode )
			ENDIF
			
			*nContactID = PrepareSQLnum(This.nContactID.Value,'ContactID',-3)
			IF ThisForm.nContactID > 0 
				nContactID = PrepareSQLnum(This.nContactID.Value,'ContactID',-3)
				IF ThisForm.nContactID <> nContactID
					ThisForm.ShowVendorContact( ThisForm.nContactID )
				ENDIF
			ELSE
				ThisForm.GetVendorContacts( 0 )
				*ThisForm.nContactID = nContactID
				*ThisForm.ShowVendorContact( ThisForm.nContactID )
			ENDIF
			
			This.cmdFillVAddr.Visible = .T.
			
		ELSE
			PRIVATE cVendorDesc, cVendorAddr
			cVendorDesc = PrepareSQLtxt(ThisForm.PgfPO.pgPODesc.txtCompany.Value,'Company',100)
			cVendorAddr = PrepareSQLtxt(This.parent.pgVendor.txtCompany.Value,'Company',100)
			
			IF LEN(cVendorDesc) > 0 AND LEN(cVendorAddr ) > 0 AND This.parent.pgVendor.cmdEditAddr.CAPTION = "Save"
			
				MESSAGEBOX("Save the Vendor Name first"+CHR(13)+"The Vendor Address tab has the Vendor name"+CHR(13)+cVendorAddr+CHR(13)+"Save that Vendor so a Vendor number will me made",0+48,"No Vender Code number!")
			ELSE
				WAIT WINDOW "No VendCode, Need Vendor before you can choose Vendor Contact! Any key to continue..." 
			ENDIF
			
			This.cmdFillVAddr.Visible = .F.
			
		ENDIF
		
		
		
			
		*This.lstContactID.SetFocus
				
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.cmdAddVC.Click
		*Add
		
		IF NOT USED('Vendor')
			IF EMPTY(ThisForm.nVendCode) AND NOT EMPTY(PrepareSQLnum(ThisForm.pgfPO.pgPODesc.lblVendCode.Caption,'VendCode',-3))
				ThisForm.nVendCode = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.lblVendCode.Caption,'VendCode',-3)
			ENDIF
			ThisForm.ShowVendCode(ThisForm.nVendCode)
		ENDIF
		IF NOT USED('Vendor')
			MESSAGEBOX("Did not find the Vendor table."+CHR(13)+"Please choose the Vendor first.",64,"No Vendor")
			RETURN .F.
		ENDIF
		
		This.Enabled = .F.
		
		This.parent.cmdEditVC.Caption = "Save"
		This.parent.cmdDeleteVC.Caption = "Cancel"
		
		ThisForm.EditContactScreen( 1 )
		ThisForm.ShowVendorContact( 0 )
		
		This.parent.nContactID.Value = 0
		ThisForm.nContactID = 0
		
		This.parent.cContact.SetFocus
		
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.cmdAddVC.When
		IF ThisForm.nVendCode = 0
			MESSAGEBOX("Add a Vendor First"+CHR(13)+"then add the Vendor Contact.",48,"Cannot Add")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.cmdDeleteVC.Click
		IF THIS.Caption = "Delete"
			*Delete
			PRIVATE nContactID
		*	nContactID = PrepareSQLnum(This.Parent.nContactID.Value,'Contact',-3)
			nContactID = PrepareSQLnum(ThisForm.nContactID,'Contact',-3)
			
			ThisForm.DeleteContactID(nContactID)
			This.parent.cmdAddVC.Enabled = .T.
			This.parent.cmdEditVC.Caption = "Edit"
		*	THIS.Caption = "Cancel"
		ELSE
			*Cancel
			ThisForm.EditContactScreen(0)
			This.parent.cmdAddVC.Enabled = .T.
			This.parent.cmdEditVC.Caption = "Edit"
			THIS.Caption = "Delete"
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.cmdDeleteVC.When
		IF ThisForm.nContactID = 0 AND THIS.Caption = "Delete"
			MESSAGEBOX("No contact to delete.",48,"Cannot Delete")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.cmdEditVC.Click
		IF THIS.Caption = "Edit"
			*Edit
			ThisForm.EditContactScreen( 1 )
			
			This.parent.cmdAddVC.Enabled = .F.
			This.parent.cmdDeleteVC.Caption = "Cancel"
			THIS.Caption = "Save"
		ELSE
			*Save
			IF ThisForm.SaveContactID()
				ThisForm.EditContactScreen(0)
				
				This.parent.cmdAddVC.Enabled = .T.
				This.parent.cmdDeleteVC.Caption = "Delete"
				THIS.Caption = "Edit"
				
				*Save Contact to PO
				This.parent.cmdSavetoPO.Click
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.cmdEditVC.When
		IF ThisForm.nVendCode = 0
			MESSAGEBOX("Add a Vendor First"+CHR(13)+"then edit the Vendor Contact.",48,"Cannot Edit")
			RETURN .F.
		ENDIF
		
		IF ThisForm.nContactID = 0 AND THIS.Caption = "Edit"
			MESSAGEBOX("Add a Contact First.",48,"Cannot Edit")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.cmdFillVAddr.Click
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry
		
		lcCompany = PrepareSQLtxt(THIS.PARENT.PARENT.pgVendor.txtCompany.VALUE,'Company',100)
		lcAddr1 = PrepareSQLtxt(THIS.PARENT.PARENT.pgVendor.txtAddr1.VALUE,'Addr1',100)
		lcAddr2 = PrepareSQLtxt(THIS.PARENT.PARENT.pgVendor.txtAddr2.VALUE,'Addr2',100)
		lcCity  = PrepareSQLtxt(THIS.PARENT.PARENT.pgVendor.txtCity.VALUE,'City',50)
		lcST    = PrepareSQLtxt(THIS.PARENT.PARENT.pgVendor.txtST.VALUE,'St',50)
		lcZip   = PrepareSQLtxt(THIS.PARENT.PARENT.pgVendor.txtZip.VALUE,'Zip',50)
		lcCountry = PrepareSQLtxt(THIS.PARENT.PARENT.pgVendor.txtCountry.VALUE,'Country',50)
		
		This.parent.cAddr1.Value = lcAddr1
		This.parent.cAddr2.Value = lcAddr2
		This.parent.cCity.Value = lcCity
		This.parent.cST.Value = lcST
		This.parent.cZip.Value = lcZip
		This.parent.cCountry.Value = lcCountry
		
		PRIVATE nContactID
		nContactID	= PrepareSQLnum(This.Parent.nContactID.Value,'ContactID',-3)
		
		IF nContactID > 0
			PRIVATE cSQLu
			cSQLu = "UPDATE dbo.VendorContact SET "
			cSQLu = cSQLu + " Addr1='"+lcAddr1+"'"
			cSQLu = cSQLu + ",Addr2='"+lcAddr2+"'"
			cSQLu = cSQLu + ",City='"+lcCity+"'"
			cSQLu = cSQLu + ",ST='"+lcST+"'"
			cSQLu = cSQLu + ",Zip='"+lcZip+"'"
			cSQLu = cSQLu + ",Country='"+lcCountry+"'"
			cSQLu = cSQLu + " WHERE ContactID = "+ALLTRIM(STR(nContactID)) 
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC, '')
				lSaveOK = .F.
			ELSE
				TrackMess( "Updated Vendor Contact Address, ContactID:"+ALLTRIM(STR(nContactID))+" PurchaseOrder.cmdFillVAddr.Click()")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.cmdSavetoPO.Click
		PRIVATE nContactID, cContact, nVendCode, nHPAPO
		nContactID	= PrepareSQLnum(This.parent.nContactID.Value,'ContactID',-3)
		ThisForm.nContactID = nContactID
		cContact	= PrepareSQLtxt(This.parent.cContact.Value,'Contact',20)
		
		IF nContactID = 0
			MESSAGEBOX("Please Select a Contact to Save with this PO.",48,"Cannot save with PO.")
			RETURN .F.
		ENDIF
		
		*nVendCode = ThisForm.nVendCode
		ThisForm.nContactID = nContactID
		nHPAPO	= This.parent.parent.pgPODesc.txtHpaPo.Value
		
		PRIVATE lPOSaveOK 
		lPOSaveOK = .F.
		
		PRIVATE cSQLu
		cSQLu = "UPDATE dbo.PurchaseOrder SET "
		cSQLu = cSQLu + " ContactID="+ALLTRIM(STR(nContactID))
		cSQLu = cSQLu + " ,POsalesP='"+cContact+"'"
		cSQLu = cSQLu + " WHERE HPAPO = "+ALLTRIM(STR(nHPAPO))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
			lPOSaveOK  = .F.
		ELSE
			lPOSaveOK = .T.
		*	TrackMess( "Updated POitem:"+ALLTRIM(cPOitem)+" for SOitem:"+cSOItem+" from EnterOrder.")
		*	Save_SOitem_Status( cSOItem, nHPApo, 'PO', 'Updated POitem:'+ALLTRIM(cPOitem), ThisForm.nConnHandle )
			
			This.parent.parent.pgPODesc.txtPOSalesName.VALUE = cContact
			ThisForm.nContactID = nContactID
			
			MESSAGEBOX("Contact Saved with PO.",64,"Saved!")
		ENDIF
		
		IF lPOSaveOK 
			This.parent.lblSaveContact.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.cmdSavetoPO.When
		IF ThisForm.nVendCode = 0
			MESSAGEBOX("Add a Vendor First"+CHR(13)+"then add the Vendor Contact.",48,"Cannot Save")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.grdContactID.AfterRowColChange
		LPARAMETERS nColIndex
		PRIVATE nContactID
		
		IF VARTYPE(tmpVendorContacts.ContactID) = "N"
		*	nContactID = gaContactIDs(This.Value,1)
			nContactID = tmpVendorContacts.ContactID
			ThisForm.ShowVendorContact( nContactID )
		ENDIF
		
		
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.grdContactID.Click
		PRIVATE nContactID
		
		IF VARTYPE(tmpVendorContacts.ContactID) = "N"
		*	nContactID = gaContactIDs(This.Value,1)
			nContactID = tmpVendorContacts.ContactID
			ThisForm.ShowVendorContact( nContactID )
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.grdContactID.When
		*RETURN ThisForm.POEditing 
	ENDPROC

	PROCEDURE pgfPO.pgVendorContact.lstContactID.InteractiveChange
		PRIVATE nContactID
		
		
		IF VARTYPE(This.Value) = "N"
		*	nContactID = gaContactIDs(This.Value,1)
			nContactID = This.Value
		ENDIF
		IF VARTYPE(This.Value) = "C"
			nContactID = VAL(This.Value)
		ENDIF
		
		ThisForm.ShowVendorContact( nContactID )
	ENDPROC

ENDDEFINE
