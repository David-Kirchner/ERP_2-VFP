	PROCEDURE poi_total		&& calculate POi_Total
		PARAMETERS lGiveDetail
		*ThisForm.POi_Total()
		
		PRIVATE nOrder_P, nOrder_QTY, nOtherP, nVendorTotal
		nOrder_P		= PrepareSQLnum(Thisform.pgfPO.pgPOdesc.txtOrder_P.VALUE,'Order_P',-5)
		nOrder_QTY		= PrepareSQLnum(Thisform.pgfPO.pgPOdesc.txtOrder_Qty.VALUE,'Order_QTY',-5)
		nOtherP			= PrepareSQLnum(Thisform.pgfPO.pgPOdesc.txtOtherP.Value,'OtherP',10,2)
		
		nVendorTotal	= ( nOrder_QTY * nOrder_P ) + nOtherP
		
		PRIVATE nStockLst_P, nStockLst_QTY, nOtherP, nStockLstTotal
		nStockLst_P		= PrepareSQLnum(Thisform.pgfPO.pgPOdesc.txtOrder_P.VALUE,'Order_P',-5)
		nStockLst_QTY	= PrepareSQLnum(Thisform.pgfPO.pgPOdesc.txtOrder_Qty.VALUE,'Order_QTY',-5)
		nOtherP			= PrepareSQLnum(Thisform.pgfPO.pgPOdesc.txtOtherP.Value,'OtherP',10,2)
		
		nStockLstTotal	= ( nStockLst_QTY* nStockLst_P) + nOtherP
		
		IF nVendorTotal = nStockLstTotal
			ThisForm.pgfPO.pgPOdesc.txtPOi_Total.Value = nVendorTotal 
			RETURN .T.
		ELSE
			IF lGiveDetail
				PRIVATE cMess
				cMess =        "Vendor cost is "+ALLTRIM(STR(nVendorTotal,8,2))+CHR(13)
				cMess = cMess +"HPA pricing is "+ALLTRIM(STR(nStockLstTotal,8,2))+CHR(13)
				cMess = cMess +"HPA Standard accounting is pricing by form units"+CHR(13)+CHR(13)
				cMess = cMess +"The $/Unit can be different but totals must be equal"+CHR(13)+CHR(13)
				cMess = cMess +"Look over pricing and correct!"+CHR(13)
				MESSAGEBOX(cMess,16,"Price mismatch")
			ENDIF
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE popounds		&& Use GetWeight for PO item
		*ThisForm.POpounds()
		
		PRIVATE nPieces,cAlloy,cForm,nThck,nSz2,nSz3
		nPieces	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
		cAlloy	= ShowSQLtxt(ThisForm.pgfPO.pgPODesc.txtAlloy.Value,'Alloy',12)
		IF LEN(cAlloy) = 0
			RETURN .F.
		ENDIF
		cForm	= ShowSQLtxt(ThisForm.pgfPO.pgPODesc.cmbForm.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtThck.Value,'Thck',10,4)
		IF nThck = 0
			RETURN .F.
		ENDIF
		nSz2	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSz2.Value,'Sz2',10,3)
		IF nSz2 = 0
			IF usesForm_Dim2(cForm, ThisForm.nConnHandle)
				RETURN .F.
			ENDIF
		ENDIF
		nSz3	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSz3.Value,'Sz3',10,3)
		
		IF nPieces = 0
			nPieces = 1
		ENDIF
		
		PRIVATE nLBS, nCurrLBS, nPounds
		nLBS 	 = PrepareSQLnum(GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,ThisForm.nConnHandle),'Pounds',9,1)
		nCurrLBS = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPounds.Value,'Pounds',9,1)
		
		DO CASE
		CASE nCurrLBS = 0
			ThisForm.pgfPO.pgPODesc.txtPounds.Value = nLBS
		CASE nLBS = 0
			ThisForm.pgfPO.pgPODesc.txtPounds.Value = 0
		CASE nCurrLBS*1.1 > nLBS AND nLBS*1.1 > nCurrLBS
			*within 10%
			ThisForm.pgfPO.pgPODesc.txtPounds.Value = nLBS
		CASE (nCurrLBS+5)*1.1 > nLBS AND (nLBS+5)*1.1 > nCurrLBS
			*within 10% when adusted with extra weight
			ThisForm.pgfPO.pgPODesc.txtPounds.Value = nLBS
		OTHERWISE
			PRIVATE lServicesPO, lOddCut
			lServicesPO = PrepareSQLlogic( ThisForm.pgfPO.pgPODesc.chkLab_Service.Value, 'ServicesPO',.F. )
			lOddCut		= PrepareSQLlogic(ThisForm.pgfPO.pgPOdesc.chkOddCut.VALUE,'OddCut',.F.)
			*IF NOT lServicesPO 
				IF NOT lOddCut
					IF MESSAGEBOX("Calculated Pounds is more than 10% off."+CHR(13)+CHR(13)+"Calc:"+ALLTRIM(STR(nLBS,9,1))+CHR(13)+"Curr:"+ALLTRIM(STR(nCurrLBS,9,1))+CHR(13)+"Do you want to use new Pounds "+ALLTRIM(STR(nLBS,9,1))+"?" ,4,"Do you want to use new Pounds "+ALLTRIM(STR(nLBS,9,1))+"?")=6
						ThisForm.pgfPO.pgPODesc.txtPounds.Value = nLBS
					ENDIF
				ENDIF
			*ENDIF
		ENDCASE	
		
	ENDPROC

