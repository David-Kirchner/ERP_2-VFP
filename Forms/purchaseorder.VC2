	PROCEDURE pgfPO.pgSOdist.cmdDeletePODist.Click
		PRIVATE nPO_SODist_ID, cSOitem
		
		nPO_SODist_ID	= PrepareSQLnum(This.Parent.txtPO_SODist_ID.Value,'PO_SODist_ID',-3)
		cSOitem			= PrepareSQLtxt(This.parent.txtSOitem.Value,'SOitem',10)
		PRIVATE cPOItem
		cPOItem = ThisForm.cPOitem
		cPOItem = Proper_PO_item( cPOItem )
		
		IF NOT EMPTY(cSOitem)
			cSOitem = Proper_SO_item(cSOitem)
		ELSE
			cSOitem = Proper_SO_item('')
		ENDIF
		
		IF nPO_SODist_ID < 1
			IF cSOitem = Proper_SO_item('')
				MESSAGEBOX("Must have ID",16,"Cannot Delete")
				RETURN .F.
			ELSE
				*Clear
				This.Parent.txtPO_SODist_ID.Value = 0
				This.parent.txtSOitem.Value = ''
				This.parent.txtPercent.Value = 0
				This.parent.txtQTY.Value = 0
				RETURN .F.
			ENDIF
		ENDIF
		
		IF cSOitem = Proper_SO_item('')
			MESSAGEBOX(" SOitem:"+cSOitem,16,"Cannot Delete")
			RETURN .F.
		ENDIF
		
		IF MESSAGEBOX("Are you sure you want to Delete the PO Dist for SOitem:"+ALLTRIM(cSOitem)+"?",32,"Delete?")!=6
			RETURN .F.
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "DELETE FROM dbo.PO_SOdist "
		cSQL = cSQL + " WHERE ID="+STR(nPO_SODist_ID)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
			This.parent.grdPO_SOdist.RecordSource = ''
		ELSE
		
			****************
			PRIVATE nDist_QTY
			nDist_QTY = 0
		
			IF USED('tmpPO_DQTY')
				USE IN tmpPO_DQTY
			ENDIF
			
			cSQL = "SELECT SUM(QTY) AS nQTY"
			cSQL = cSQL + " FROM dbo.PO_SOdist WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_DQTY")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_DQTY")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_DQTY' )
			ELSE
				IF USED('tmpPO_DQTY')
					IF RECCOUNT('tmpPO_DQTY') > 0
						nDist_QTY = PrepareSQLnum(tmpPO_DQTY.nQTY,'QTY',18,4)
						*This.txtDist_QTY.Value = nDist_QTY 
						This.Parent.txtDist_QTY.Value = nDist_QTY 
					ENDIF
					USE IN tmpPO_DQTY
				ENDIF
			ENDIF
			**********************
			
			This.Parent.txtPO_Dist.Value	= This.Parent.txtOrder_P.Value * This.Parent.txtDist_QTY.Value
			
			****************
			This.parent.grdPO_SOdist.RecordSource = ''
			
			IF USED('tmpPO_Dist')
				USE IN tmpPO_Dist
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT ID,POitem,SOitem,QTY,P,Total,[who]"
		    cSQL = cSQL + " FROM dbo.PO_SOdist WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_Dist')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_Dist' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_Dist")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_Dist")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_Dist' )
			ELSE
				This.parent.grdPO_SOdist.RecordSource = 'tmpPO_Dist'
			ENDIF
		
		ENDIF
	ENDPROC

