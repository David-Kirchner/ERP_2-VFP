	PROCEDURE pgfPO.pgPODesc.txtOrder_Qty.Valid
		PRIVATE nOrder_Qty
		nOrder_Qty		= PrepareSQLnum(This.VALUE,'Order_Qty',11,3)
		
		PRIVATE lShowMess
		lShowMess = .F.
		IF nOrder_Qty < 1
			lShowMess = .T.
			PRIVATE	lEquipment 
			lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
			IF lEquipment 
				This.Value = 1
				lShowMess = .F.
				RETURN .T.
			ENDIF
		
			IF lShowMess
				MESSAGEBOX("Please enter the number of units to be priced.",48,"Units priced is empty!")
			ENDIF
		ENDIF
	ENDPROC

