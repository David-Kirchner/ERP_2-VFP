	PROCEDURE pgfPO.pgPODesc.txtPOSalesName.InteractiveChange
		PRIVATE cSearchStr, cSearchStrOrig, cTryVContact
		PRIVATE nInsertionPt
		nInsertionPt = THIS.SELSTART
		cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		cSearchStr = ShowSQLtxt(cSearchStrOrig,'Contact',30)
		cTryVContact  = ''
		
		PRIVATE nVendCode
		nVendCode = PrepareSQLnum(ThisForm.nVendCode,'VendCode',-3)
		
		IF nVendCode > 0
			IF !EMPTY(cSearchStr)
				cTryVContact = SearchVendCodeContact( nVendCode, cSearchStr, ThisForm.nConnHandle ) 
				cTryVContact = ALLTRIM( cTryVContact )
				IF NOT EMPTY(cTryVContact)		
					IF UPPER(cSearchStr) = UPPER(SUBSTR(cTryVContact,1,nInsertionPt))
						*Good
						THIS.VALUE=cTryVContact
						THIS.FORECOLOR = RGB(0,0,0)				
					ELSE
						*Not Good
						THIS.VALUE=cSearchStrOrig 
						THIS.FORECOLOR = RGB(255,0,0)
					ENDIF
				ELSE
			*		*No replacement
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
				THIS.VALUE=SPACE(0)
			ENDIF
			THIS.SELSTART = nInsertionPt
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtPOSalesName.LostFocus
		=insmode(.T.)
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtPOSalesName.Valid
		PRIVATE cSearchStr,cSearchStrOrig, cTryVContact
		*PRIVATE nInsertionPt
		*nInsertionPt = THIS.SELSTART
		*cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		cSearchStrOrig = (This.Value)
		cSearchStr = ShowSQLtxt(cSearchStrOrig,'Contact',30)
		cTryVContact  = ''
		
		PRIVATE nVendCode
		nVendCode = PrepareSQLnum(ThisForm.nVendCode,'VendCode',-3)
		
		IF nVendCode > 0
			IF !EMPTY(cSearchStr)
				cTryVContact = SearchVendCodeContact( nVendCode, cSearchStr, ThisForm.nConnHandle ) 
				cTryVContact = ALLTRIM( cTryVContact )
				IF NOT EMPTY(cTryVContact)		
					IF UPPER(cSearchStr) = UPPER(cTryVContact)
						*Good
						THIS.VALUE=cSearchStr
						THIS.FORECOLOR = RGB(0,0,0)		
						ThisForm.nContactID = ContactID_VendCode_Contact(nVendCode, cTryVContact, ThisForm.nConnHandle )
						
						*ThisForm.nVendCode = nVendCode
						ThisForm.PgfPO.pgVendorContact.nContactid.Value = ThisForm.nContactID
						ThisForm.PgfPO.pgVendorContact.cContact.Value = cTryVContact 
					ELSE
						*Not Good
						WAIT WINDOW "This Vendor Contact Does not match contacts available for Vendor" NOWAIT
						THIS.VALUE=cSearchStrOrig 
						THIS.FORECOLOR = RGB(255,0,0)
					ENDIF
				ELSE
			*		*No replacement
					WAIT WINDOW "This Vendor Contact Does not match contacts available for Vendor" NOWAIT
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ENDIF
			IF LEN(cSearchStr) = 1
				MESSAGEBOX("Please Enter a more Descriptive Vendor Contact Name",48,"No Initials for Vendor Name!")
				RETURN .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtP_ft.Valid
		IF This.Value > 0
			IF EMPTY(This.Parent.txtOrder_Qty.VALUE)
				IF This.Parent.txtsZ3.Value > 0
					IF This.Parent.txtPieces.VALUE > 1
						This.Parent.txtOrder_Qty.VALUE = This.Parent.txtPieces.VALUE * This.Parent.txtsZ3.Value / 12
					ELSE
						This.Parent.txtOrder_Qty.VALUE = This.Parent.txtsZ3.Value / 12
					ENDIF
				ELSE
					IF This.Parent.txtSz2.Value > 0
						IF This.Parent.txtPieces.VALUE > 1
							This.Parent.txtOrder_Qty.VALUE = This.Parent.txtPieces.VALUE * This.Parent.txtSz2.Value / 12
						ELSE
							This.Parent.txtOrder_Qty.VALUE = This.Parent.txtSz2.Value / 12
						ENDIF
					ENDIF
				ENDIF
			ELSE
				*WAIT WINDOW "Units to be priced already has value. Clear to recalc!" NOWAIT
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtSalesnum.Valid
		*IF ThisFormSet.POeditMode 
		
		IF ThisForm.POEditing
			PRIVATE cSalesNum, nSalesNum, nItemSO
			cSalesNum= ShowSQLtxt(This.Value,'SalesNum',10)
			nSalesNum = PrepareSQLnum(This.Value,'SalesNum',-3)
			nItemSO = PrepareSQLnum(This.Parent.txtItem.Value,'ItemSO',-1)
			cSOItem = Proper_SO_Item(STR(nSalesNum)+"-"+STR(nItemSO))
			
			IF nSalesNum > 0
				IF nItemSO > 0
					IF Count_SOIteminSales( cSOItem, ThisForm.nConnHandle, '' )
						ThisForm.cSOitem = cSOItem 
						*RETURN .T.
					ELSE
						MESSAGEBOX('Sorry, that SO-Item does not exists!',0+48,"SO Not found")
						RETURN .F.
					ENDIF
				ELSE
					*Check SO Num Exists
					IF Count_SOinSales(nSalesNum, ThisForm.nConnHandle ) > 0
						*RETURN .T.
					ELSE
						MESSAGEBOX("Sorry, that SO does not exists!",0+48,"SO Not found")
		*				This.Value = 0
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
		
			****************
		
			IF UPPER(cSalesNum) = "STOCK" OR UPPER(cSalesNum) = "STCK" OR UPPER(cSalesNum) = "STK"
				This.parent.cmbStock.VALUE ="All for Stock"
			ENDIF
		
		
			******************
			IF nSalesNum > 0
				IF MESSAGEBOX("Do you want to import the SO data over the PO data?",4+32,"Import SO") = 6
					ThisForm.ImportSOitem()
				ENDIF
			ENDIF
			******************
			
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtShipVia.InteractiveChange
		PRIVATE nInsertionPt , lcSearchStr, cSearchStrOrig, lcTryAlloy 
		nInsertionPt  = THIS.SELSTART
		cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		lcSearchStr = ShowSQLtxt(cSearchStrOrig,'ShipVia',20)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchShipViaStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,nInsertionPt )
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=cSearchStrOrig 
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = nInsertionPt 
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtShipVia.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtStockLst_P.LostFocus
		ThisForm.POi_Total()
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtStockLst_P.Valid
		PRIVATE cForm, nS_PU, nOrder_PU
		cForm	= ShowSQLtxt(This.parent.cmbForm.Value,'Form',2)
		nS_PU	= GetPUfromForm( cForm, ThisForm.nConnHandle )
		nOrder_PU = PrepareSQLnum(This.Parent.cmbOrder_PU.Value,'Order_PU',1)
		
		PRIVATE nOrder_Qty, nStockLst_QTY
		nOrder_Qty		= PrepareSQLnum(This.parent.txtOrder_Qty.Value,'Order_Qty',11,3)
		nStockLst_QTY	= PrepareSQLnum(This.parent.txtStockLst_QTY.Value,'StockLst_QTY',-5)
		
		PRIVATE nOrder_P, nStockLst_P, nOtherP
		nOrder_P		= PrepareSQLnum(This.parent.txtOrder_P.Value,'Order_P',-5)
		*nStockLst_P	= PrepareSQLnum(This.parent.txtStockLst_P.Value,'StockLst_P',-5)
		nStockLst_P		= PrepareSQLnum(This.Value,               'StockLst_P',-5)
		nOtherP			= PrepareSQLnum(This.Parent.txtOtherP.Value,'OtherP',10,2)
		
		PRIVATE nOrder_Total, nPOi_Total
		nPOi_Total		= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPOi_Total.Value,'POi_Total',-5)	&& ( nOrder_QTY * nOrder_P ) + nOtherP
		nOrder_Total	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_Total.Value,'Order_Total',-5)	&&( nOrder_QTY * nOrder_P )
		
		IF nOrder_Total = 0
			IF nPOi_Total > 0  
				nOrder_Total = nPOi_Total - nOtherP
			ELSE
				nOrder_Total = nOrder_Qty * nOrder_P
			ENDIF
			ThisForm.pgfPO.pgPODesc.txtOrder_Total.Value = nOrder_Total
		ENDIF
		IF nPOi_Total <> (nOrder_Total - nOtherP)
			IF nOrder_Total > 0
				nPOi_Total = nOrder_Total - nOtherP
				ThisForm.pgfPO.pgPODesc.txtPOi_Total.Value = nPOi_Total 
			ENDIF
		ENDIF
		
		PRIVATE nPieces
		nPieces	= PrepareSQLnum(This.parent.txtPieces.VALUE,'Pieces',-3)
		IF nPieces = 0 
			nPieces = 1
			IF nS_PU = 3 AND nStockLst_QTY > 0 
				nPieces	= nStockLst_QTY
			ENDIF
			IF nS_PU = 4
				nPieces	= 1
			ENDIF
			This.parent.txtPieces.VALUE = nPieces
		ENDIF
		
		
		*Get nCalcWeight
		PRIVATE cAlloy, cForm, nThck, nSz2, nSz3, nCalcWeight
		cAlloy		= ShowSQLtxt(This.Parent.txtAlloy.VALUE,'Alloy',12,.F.)
		cForm		= ShowSQLtxt(This.Parent.cmbForm.VALUE,'Form',2,.T.)
		nThck		= PrepareSQLnum(This.Parent.txtThck.VALUE,'Thck',10,4)
		nSz2		= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
		nSz3		= PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
		nCalcWeight = CalcWeight (nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisForm.nConnHandle)
		
		
		
		PRIVATE nNew_P
		nNew_P = 0.0000
		
		**********************************************
		DO CASE
		CASE nS_PU = 1
			* $/Lb
			IF nOrder_PU = 1
				nNew_P = nOrder_P
			ELSE
				*Convert to $/Lb
				nNew_P = PrepareSQLnum( nOrder_Total / nCalcWeight ,'S_P',-5)
			ENDIF
			nNew_P = ROUND( nNew_P ,1)
			
		CASE nS_PU = 2
			* $/Ft
			PRIVATE nFtLen, nSigDim
			nFtLen = 0
			nSigDim = getSigDim(cForm, ThisForm.nConnHandle)
			IF nSigDim = 2
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz2/12
			ENDIF
			IF nSigDim = 3
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz3/12
			ENDIF
					
			IF nOrder_PU = 2
				nNew_P = nOrder_P
			ELSE
				*Convert to $/Ft
				nNew_P = nOrder_Total / nFtLen
			ENDIF
			nNew_P = ROUND( nNew_P ,1)
			
		CASE nS_PU = 3
			* $/Pc
			IF nOrder_PU = 3
				nNew_P = nOrder_P
			ELSE
				nNew_P = nOrder_Total / nPieces
			ENDIF
			nNew_P = ROUND( nNew_P ,4)
		
		CASE nS_PU = 4
			* $ Lot
			IF nOrder_PU = 4
				nNew_P = nOrder_P
			ELSE
				nNew_P = nOrder_Total / nPieces
			ENDIF
			nNew_P = ROUND( nNew_P ,4)
			
		OTHERWISE
			nNew_P = 0
		ENDCASE
		
		IF nNew_P > 0
		*	WAIT WINDOW "Calculated the Stock List Quantity and saved "+ALLTRIM(STR(nNew_QTY))+" to 'Units to be priced' field." TIMEOUT 1
			This.Value = nNew_P
			This.Refresh
		ENDIF
		
		*****
		PRIVATE lServicesPO,lEquipment
		lServicesPO = PrepareSQLlogic(This.parent.chkLab_Service.Value,'ServicesPO',.F.)
		lEquipment	= PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
		
		IF lServicesPO
			IF nPieces > 1
				*Use Pieces
				nOrder_Qty = nPieces 
				This.parent.txtOrder_Qty.Value = nOrder_Qty 
				nS_PU = 3
				This.Parent.cmbOrder_PU.Value	= PrepareSQLtxt(nS_PU,'S_PU',1)
				This.Parent.lblUnitText.Caption	= Get_cPUfrom_nPU(nS_PU)
				
				IF nOrder_P = 0
					This.parent.txtOrder_P.Value	= nStockLst_P
				ENDIF
		
			ELSE
				*Use $Lot
				nOrder_Qty = 1 
				This.parent.txtOrder_Qty.Value = nOrder_Qty 
				nS_PU = 4
				This.Parent.cmbOrder_PU.Value	= PrepareSQLtxt(nS_PU,'S_PU',1)
				This.Parent.lblUnitText.Caption	= Get_cPUfrom_nPU(nS_PU)
			ENDIF
			**********
		ENDIF
		IF lEquipment
			IF nOrder_Qty = 0 AND nOrder_P = 0
				This.parent.txtOrder_Qty.Value	= 1 &&nOrder_Qty = 0
				This.parent.txtOrder_P.Value	= nStockLst_P
				This.Parent.cmbOrder_PU.Value	= PrepareSQLtxt(nS_PU,'S_PU',1)
				This.Parent.lblUnitText.Caption	= Get_cPUfrom_nPU(nS_PU)
			ENDIF
		ENDIF
		
		**
		IF NOT ( lServicesPO AND lEquipment )
			** Pounds
			IF EMPTY(This.parent.txtPounds.Value)
				This.parent.txtPounds.Value = ROUND(nCalcWeight ,1)
			ENDIF
		ENDIF
		
		IF NOT ( lServicesPO AND lEquipment )
			IF ThisForm.Check_PriceTable()
			*nStockLst_P
			*cSQL = "SELECT ISNULL(dbo.f_GetPriceCC_CL(SM.Alloy,SM.Form, SM.CC,SM.CL, dbo.f_SizeStandard(SM.Size),SD.Dim2,SD.Dim3,SD.[Weight]),0) AS BookPrice "
			ENDIF
		ENDIF
		************************************
		*Need to refresh value!
		This.Value = nStockLst_P
		
		*ThisForm.pgfPO.pgPODesc.txtPOi_Total.Value	= ( nOrder_QTY * nOrder_P ) + nOtherP
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtStockLst_QTY.Valid
		*Service and Equipment PO do not get saved to StockLst
		PRIVATE lServicesPO,lEquipment,lConvServ
		lServicesPO = PrepareSQLlogic(This.parent.chkLab_Service.Value,'ServicesPO',.F.)
		lEquipment	= PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
		lConvServ	= PrepareSQLlogic(This.parent.chkConvServ.Value,'ConvServ',.F.)
		
		PRIVATE nOrder_Qty, nOrder_P, nOtherP
		nOrder_Qty		= PrepareSQLnum(This.parent.txtOrder_Qty.Value,'Order_Qty',-5)
		nOrder_P		= PrepareSQLnum(This.parent.txtOrder_P.Value,'Order_P',-5)
		nOtherP			= PrepareSQLnum(This.parent.txtOtherP.Value,'OtherP',10,2)
		
		PRIVATE cForm, nS_PU
		cForm	= ShowSQLtxt(This.parent.cmbForm.Value,'Form',2)
		nS_PU	= GetPUfromForm( cForm, ThisForm.nConnHandle )
		
		PRIVATE nStockLst_QTY
		nStockLst_QTY	= PrepareSQLnum(This.Value,'StockLst_QTY',-5)
		
		IF lServicesPO
			IF nOrder_Qty = 0 AND nOrder_P = 0
				This.parent.txtOrder_Qty.Value	= 1 &&nOrder_Qty 
				This.parent.txtOrder_P.Value	= This.parent.txtStockLst_P.Value
				This.Parent.cmbOrder_PU.Value	= PrepareSQLtxt(nS_PU,'S_PU',1)
				This.Parent.lblUnitText.Caption	= Get_cPUfrom_nPU(nS_PU)
			ENDIF
			RETURN .T.
		ENDIF
		IF lEquipment
			IF nOrder_Qty = 0 AND nOrder_P = 0
				This.parent.txtOrder_Qty.Value	= 1 &&nOrder_Qty = 0
				This.parent.txtOrder_P.Value	= This.parent.txtStockLst_P.Value
				This.Parent.cmbOrder_PU.Value	= PrepareSQLtxt(nS_PU,'S_PU',1)
				This.Parent.lblUnitText.Caption	= Get_cPUfrom_nPU(nS_PU)
			ENDIF
			RETURN .T.
		ENDIF
		IF lConvServ
			IF nStockLst_QTY > 0
				IF nOrder_Qty > 0
					IF nOrder_Qty < nStockLst_QTY * 1.1  AND  nOrder_Qty > nStockLst_QTY * .9
						WAIT WINDOW "Stock Quantity does not match PO Quantity" NOWAIT
						RETURN .T.
					ENDIF
				ENDIF
			ENDIF
			RETURN .T.
		ENDIF
		*********
		
		
		
		PRIVATE nPieces
		nPieces	= PrepareSQLnum(This.parent.txtPieces.VALUE,'Pieces',6,0)
		*nPieces	= PrepareSQLnum(This.parent.txtPieces.VALUE,'Pieces',6,0)
		
		
		*Get nCalcWeight
		PRIVATE cAlloy, cForm, nThck, nSz2, nSz3, nCalcWeight, nNew_QTY
		cAlloy		= ShowSQLtxt(This.Parent.txtAlloy.VALUE,'Alloy',12,.F.)
		cForm		= ShowSQLtxt(This.Parent.cmbForm.VALUE,'Form',2,.T.)
		nThck		= PrepareSQLnum(This.Parent.txtThck.VALUE,'Thck',10,4)
		nSz2		= PrepareSQLnum(This.Parent.txtSz2.VALUE,'Sz2',9,3)
		nSz3		= PrepareSQLnum(This.Parent.txtSz3.VALUE,'Sz3',9,3)
		nCalcWeight = CalcWeight (nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisForm.nConnHandle)
		nNew_QTY 	= 0.0000
		
		** Pounds
		IF EMPTY(This.parent.txtPounds.Value)
			This.parent.txtPounds.Value = ROUND(nCalcWeight ,1)
		ENDIF
		
		
		**********************************************
		DO CASE
		CASE nS_PU = 1
			* $/Lb
			IF nOrder_Qty > 0
				IF nPieces = 0 
					*nCalcWeight = nOrder_Qty 
					nPieces = nOrder_Qty 
				ELSE
					*may have LBS estimated
					IF nOrder_Qty < nCalcWeight * 1.1  AND  nOrder_Qty > nCalcWeight * .9
						*Calculated LBS are within 10%, use the estimated nOrder_Qty
						nCalcWeight = nOrder_Qty
					ENDIF
				ENDIF 
			ENDIF
			
			nNew_QTY	= ROUND(nCalcWeight,1)
			
		CASE nS_PU = 2
			* $/Ft
			PRIVATE nFtLen, nSigDim
			nFtLen = 0
			nSigDim = getSigDim(cForm, ThisForm.nConnHandle)
			IF nSigDim = 2
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz2/12
			ENDIF
			IF nSigDim = 3
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz3/12
			ENDIF
					
			nNew_QTY 	= ROUND(nFtLen,1)
			
		CASE nS_PU = 3
			* $/Pc
			
			nNew_QTY = nPieces
			
		OTHERWISE
			nNew_QTY = 0
			IF nOrder_Qty > 0
				IF nStockLst_QTY = 0
					*Use the Order Qty
					This.Value = nOrder_Qty
				ENDIF
			ENDIF
		ENDCASE
		
		*********************
		PRIVATE lOddCut
		lOddCut	= PrepareSQLlogic(ThisForm.pgfPO.pgPOdesc.chkOddCut.VALUE,'OddCut',.F.)
		
		IF nNew_QTY > 0
			IF NOT lOddCut
				IF (This.Value+10)*1.05 < nNew_QTY+10 AND (This.Value+10) > (nNew_QTY+10)+1.05
					IF MESSAGEBOX("Calculated the Stock List Quantity as "+ALLTRIM(STR(nNew_QTY))+" Do you want to use this value (Y)",4+32,"Change QTY?") = 6
						This.Value = nNew_QTY
						This.Refresh
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**********************
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtSz2.Valid
		ThisForm.POpounds()
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtSz3.Valid
		ThisForm.POpounds()
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtThck.Valid
		*Only Check for 3 decimal place here
		PRIVATE nTHCK, cAlloy, cForm, cCC, cCL
		nTHCK	= PrepareSQLnum(This.Value,'Thck',10,3)
		cAlloy	= PrepareSQLtxt(This.Parent.TxtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(This.parent.cmbForm.Value,'Form',2)
		cCC		= PrepareSQLtxt(This.parent.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(This.parent.cmbCL.Value,'CL',1)
		
		*Sheet Packing Policy
		IF (VARTYPE(nTHCK)="N" OR VARTYPE(nThck)="Y") AND TYPE('cForm')="C"
			IF nTHCK > 0 AND nTHCK < .125 AND cForm = "40"
				This.Parent.chkSPS1.Value = 1
			ENDIF
		ENDIF
		
		IF TYPE('nTHCK') = "N"  OR VARTYPE(nThck)="Y"
			IF nTHCK > 0
				PRIVATE nCurrStandSize,nStandardSize
				*IF cStock $ "All for Stock,Mostly Stock,Some Stock"
				*lStockLst = isForStock(cStock)
				
				*Only Check for 3 decimal place here
				nCurrStandSize	= PrepareSQLnum(This.parent.txtStandSize.VALUE,'StandSize',10,3)
				nStandardSize	= getStandardSize( nTHCK, ThisForm.nConnHandle)
						
				IF nStandardSize > 0
					PRIVATE nPrevSize, nPrevStandardSize
					
					IF nCurrStandSize = 0
						FOR nPrevSize = nTHCK TO 0 STEP -.001
							nPrevStandardSize = getStandardSize(nPrevSize, ThisForm.nConnHandle)
							IF nPrevStandardSize <= nStandardSize 
								*This.Value = nPrevStandardSize
								This.parent.txtStandSize.Value = nPrevStandardSize
								This.parent.txtStandSize.Refresh
								
								EXIT
							ENDIF
						NEXT nPrevSize 
								
					ENDIF
				ENDIF
				
				IF nStandardSize  = 0
					*nStandardSize = getStandardSize_Alloy_Form( nThck, cAlloy, cForm, ThisForm.nConnHandle)
					*nStandardSize = getPriceTableStandardSize( nThck, cAlloy, cForm, cCC, ThisForm.nConnHandle)
					nStandardSize = getStandardSize_Common_CC_CL( nThck, cAlloy, cForm, cCC, cCL, ThisForm.nConnHandle)
				ENDIF
					
				IF nStandardSize  = 0
					IF nStandardSize != nCurrStandSize 
						*MESSAGEBOX("Not a 'Standard Size'! "+ALLTRIM(STR(nSize,9,4))+CHR(13)+"You may need to adjust your Stand Size!"+CHR(13)+"Please use a dimension that is found in the Pricing table as Standard!",0+16,"Size Entered is not a Standard")
						
						FOR nPrevSize = nTHCK TO 0 STEP -.001
							nPrevStandardSize = getStandardSize(nPrevSize, ThisForm.nConnHandle)
							IF nPrevStandardSize <= nStandardSize 
								*This.Value = nPrevStandardSize
								This.parent.txtStandSize.Value = nPrevStandardSize
								This.parent.txtStandSize.Refresh
								
								EXIT
							ENDIF
						NEXT nPrevSize 
						
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.POpounds()
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtWO_Detail.DblClick
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(This.Value,'WO_Detail',-3)
		
		
		IF nWO_Detail > 0
