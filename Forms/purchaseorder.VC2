		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'chkDeliveredPO' AS checkbox WITH ;
		Alignment = 0, ;
		BackColor = 192,192,192, ;
		Caption = "Received", ;
		DisabledForeColor = 0,0,0, ;
		Enabled = .F., ;
		Height = 17, ;
		Left = 233, ;
		Name = "chkDeliveredPO", ;
		ReadOnly = .T., ;
		TabIndex = 14, ;
		ToolTipText = "Purchased items that are to be 'Received' will be marked when the HPA receiving department officially receives item.  PO's for lab test are automatically listed as received.", ;
		Top = 3, ;
		Width = 72
		*< END OBJECT: BaseClass="checkbox" />

