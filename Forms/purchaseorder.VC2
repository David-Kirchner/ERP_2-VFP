	PROCEDURE posetvendor
		PARAMETERS nHPAPO
		*ThisForm.POsetVendor(nFoundHPAPO)
		
		IF USED('tmpPOs')
			USE IN tmpPOs
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT TOP 1 Company,POSalesP,ShipVia,ShipWhere,POShipAddr,VendCode,ContactID FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOs')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPOs' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOs")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOs")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPOs' )
		ENDIF
		
		IF USED('tmpPOs')
			
			ThisForm.pgfPO.pgPODesc.txtCompany.VALUE		= tmpPOs.Company
			ThisForm.pgfPO.pgPODesc.txtPOSalesName.VALUE	= tmpPOs.POSalesP
			ThisForm.pgfPO.pgPODesc.txtShipVia.VALUE		= tmpPOs.ShipVia
		
			ThisForm.pgfPO.pgPODesc.cmbShipWhere.VALUE 		= tmpPOs.ShipWhere
			ThisForm.pgfPO.pgPOAddress.opgPOShipTo.VALUE 	= tmpPOs.ShipWhere
			IF VARTYPE( tmpPOs.POShipAddr ) = "N"
				ThisForm.POShipAddr = tmpPOs.POShipAddr
				ThisForm.pgfPO.pgPOAddress.txtPOShipAddr.VALUE	= tmpPOs.POShipAddr
				m.POShipAddr = tmpPOs.POShipAddr
				ThisForm.ShowPOShipAddr( tmpPOs.POShipAddr )
			ELSE
				ThisForm.POShipAddr = 0
				ThisForm.pgfPO.pgPOAddress.txtPOShipAddr.VALUE	= 0
				m.POShipAddr = 0
				ThisForm.ShowPOShipAddr( 0 )
			ENDIF
			ThisForm.Show_VendCode( tmpPOs.VendCode )
			ThisForm.ShowVendorContact( tmpPOs.ContactID )
			
			USE IN tmpPOs
		ENDIF
		
	ENDPROC

	PROCEDURE poshipto
		PARAMETER nOption
		*ThisForm.POShipTo()
		
		DO CASE
		CASE nOption = 1
			* HPA, Tipton
			ThisForm.ShowPOShipAddr(1)
			
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			
		CASE nOption = 2
			*Direct, use same as ShipTO
			IF ThisForm.POShipAddr = 1 OR ThisForm.POShipAddr = 2
				ThisForm.POShipAddr = 0
			ENDIF
			IF ThisForm.POShipAddr > 0
				ThisForm.ShowPOShipAddr(ThisForm.POShipAddr)
			ELSE
				**Clear
				ThisForm.ShipToClear()	
				*Code in EditSalesOrder Check for the Customer Address to Show!
			ENDIF
		
			IF ThisForm.POEditing
				ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
				ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
				ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			ELSE
				ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
				ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
				ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			ENDIF
			
			
		CASE nOption = 3
			*Direct, use same as ShipTo
			*Prepare for BLIND statement
			IF ThisForm.POShipAddr = 1 OR ThisForm.POShipAddr = 2
				ThisForm.POShipAddr = 0
			ENDIF
			IF ThisForm.POShipAddr > 0
				ThisForm.ShowPOShipAddr(ThisForm.POShipAddr)
			ELSE
				**Clear
				ThisForm.ShipToClear()
				*Code in EditSalesOrder Check for the Customer Address to Show!
			ENDIF
		
			IF ThisForm.POEditing
				ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
				ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
				ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			ELSE
				ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
				ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
				ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			ENDIF
			
		CASE nOption = 4
			*for Service- Enable Search
			*IF ThisForm.POShipAddr = 1 OR ThisForm.POShipAddr = 2
				*ThisForm.POShipAddr = 0
				*Can be back to HPA!
			*ENDIF
			IF ThisForm.POShipAddr > 0
				ThisForm.ShowPOShipAddr(ThisForm.POShipAddr)
			ELSE
				**Clear
				ThisForm.ShipToClear()	
				*Code in EditSalesOrder Check for the Customer Address to Show!
			ENDIF
			
			IF ThisForm.POEditing
				ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
				ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
				ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			ELSE
				ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
				ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
				ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			ENDIF
			
		CASE nOption = 5
			* HPA, Windfall
			ThisForm.ShowPOShipAddr(2)
			
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			
		CASE nOption = 6
			*Remote Stock
			IF ThisForm.POShipAddr = 1 OR ThisForm.POShipAddr = 2
				ThisForm.POShipAddr = 0
			ENDIF
			IF ThisForm.POShipAddr > 0
				ThisForm.ShowPOShipAddr(ThisForm.POShipAddr)
			ELSE
				**Clear
				ThisForm.ShipToClear()	
				*Code in EditSalesOrder Check for the Customer Address to Show!
			ENDIF
			
			IF ThisForm.POEditing
				ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
				ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
				ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			ELSE
				ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
				ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
				ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			ENDIF
			
		ENDCASE
		
		IF USED('ShipAddr')
			USE IN ShipAddr
		ENDIF
		
	ENDPROC

