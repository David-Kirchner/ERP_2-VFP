	PROCEDURE pgfPO.pgPODesc.cmbCC.GotFocus
		IF NOT USED('tmpConditionLevel')
			*this.clear
			cSQL="SELECT [CL],[text],[CC] FROM dbo.ConditionLevel"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpConditionLevel')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpConditionLevel')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConditionLevel")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConditionLevel")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpConditionLevel')
			ENDIF
		ENDIF
		
		
		
		ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		
		*ThisFormSet.Purchaseorder.CC
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpConditionCode')
			USE IN tmpConditionCode
		ENDIF
		
		*this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		cSQL = cSQL + " WHERE ISNULL(inActive,0) = 0"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM tmpConditionCode INTO ARRAY aConditionCode
			
			USE IN tmpConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = Quotes.CC
		
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbCC.InteractiveChange
		PRIVATE cCC
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		
		
		******************************
		IF USED('tmpConditionLevel')
		
			This.Parent.cmbCL.Clear	
			
			DIMENSION aConditionLevel(1,3)
			aConditionLevel(1,1) = ""	&&Condition Level
			aConditionLevel(1,2) = ""	&&Condition text
			aConditionLevel(1,3) = " "	&&Condition Code
		
			IF NOT EMPTY(m.cCC)
				SELECT * FROM tmpConditionLevel WHERE CC = m.cCC INTO ARRAY aConditionLevel
			ELSE
				SELECT * FROM tmpConditionLevel INTO ARRAY aConditionLevel
			ENDIF
		
			This.ColumnCount = 3
			This.NumberOfElements=ALEN(aConditionLevel)
			This.BoundColumn = 1
			This.ColumnWidths = "10,115,10"
		
			PRIVATE nLoopCount, nCoulmn
			nLoopCount = 1
			nCoulmn = 1
		
			this.addListitem("",nLoopCount,1)	&&CL
			this.addListitem("",nLoopCount,2)	&&Text
			this.addListitem("1",nLoopCount,3)	&&CC
		
			nLoopCount = nLoopCount+1
			
			FOR EACH cc1 IN aConditionLevel
				DO CASE
				CASE nCoulmn = 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,nCoulmn)
				CASE nCoulmn = 2
					this.addListitem(ALLTRIM(cc1),nLoopCount,nCoulmn)
				CASE nCoulmn = 3
					this.addListitem(ALLTRIM(cc1),nLoopCount,nCoulmn)
				ENDCASE
				
				nCoulmn = nCoulmn + 1
				IF nCoulmn >= 4
					nCoulmn = 1
					nLoopCount = nLoopCount + 1
					
				ENDIF
				
			ENDFOR
			
		ENDIF
		******************************
		
		This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
		ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbCC.LostFocus
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Value,'CC',1)
		
		
		This.Parent.cmbCL.Clear
		
		
		DIMENSION aConditionLevel(1,3)
		aConditionLevel(1,1) = ""	&&Condition Level
		aConditionLevel(1,2) = ""	&&Condition text
		aConditionLevel(1,3) = " "	&&Condition Code
			
		IF NOT EMPTY(m.cCC)
			SELECT * FROM tmpConditionLevel WHERE CC = m.cCC INTO ARRAY aConditionLevel
		ELSE
			SELECT * FROM tmpConditionLevel INTO ARRAY aConditionLevel
		ENDIF
			
		This.Parent.cmbCL.ColumnCount = 3
		This.Parent.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		This.Parent.cmbCL.BoundColumn = 1
		This.Parent.cmbCL.ColumnWidths = "10,115,10"
		
		PRIVATE nLoopCount, nCoulmn
		nLoopCount = 1
		nCoulmn = 1
		
		this.addListitem("",nLoopCount,1)	&&CL
		this.addListitem("",nLoopCount,2)	&&Text
		this.addListitem("1",nLoopCount,3)	&&CC
		
		nLoopCount = nLoopCount+1
		
		FOR EACH cc1 IN aConditionLevel
			DO CASE
			CASE nCoulmn = 1
				this.addListitem(ALLTRIM(cc1),nLoopCount,nCoulmn)
			CASE nCoulmn = 2
				this.addListitem(ALLTRIM(cc1),nLoopCount,nCoulmn)
			CASE nCoulmn = 3
				this.addListitem(ALLTRIM(cc1),nLoopCount,nCoulmn)
			ENDCASE
			
			nCoulmn = nCoulmn + 1
			IF nCoulmn >= 4
				nCoulmn = 1
				nLoopCount = nLoopCount + 1
				
			ENDIF
			
		ENDFOR
			
		******************************
		*This.Parent.cmbCL.Value = cCL1
		
		IF ThisFormSet.CC != PrepareSQLtxt(This.Value,'CC',1)
			ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
			This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
			ThisFormSet.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
			This.Parent.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbCL.Init
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tmpConditionLevel')
			USE IN tmpConditionLevel
		ENDIF
		
		*this.clear
		cSQL="SELECT [CL],[text],[CC] FROM dbo.ConditionLevel"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpConditionLevel')
		ENDIF
		
		******************************
		DIMENSION aConditionLevel(1,3)
		aConditionLevel(1,1) = ""	&&Condition Level
		aConditionLevel(1,2) = ""	&&Condition text
		aConditionLevel(1,3) = " "	&&Condition Code
		
		IF USED('tmpCL_Init')
			SELECT * FROM tmpConditionLevel INTO ARRAY aConditionLevel
			
			*USE IN tmpCL_Init
			*keep open for CC InteractiveChange use
		ENDIF
		
		This.ColumnCount = 3
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115,10"
		
		PRIVATE nLoopCount, nCoulmn
		nLoopCount = 1
		nCoulmn = 1
		
		this.addListitem("",nLoopCount,1)	&&CL
		this.addListitem("",nLoopCount,2)	&&Text
		this.addListitem("1",nLoopCount,3)	&&CC
		
		nLoopCount = nLoopCount+1
		
		FOR EACH cc1 IN aConditionLevel
			DO CASE
			CASE nCoulmn = 1
				this.addListitem(ALLTRIM(cc1),nLoopCount,nCoulmn)
			CASE nCoulmn = 2
				this.addListitem(ALLTRIM(cc1),nLoopCount,nCoulmn)
			CASE nCoulmn = 3
				this.addListitem(ALLTRIM(cc1),nLoopCount,nCoulmn)
			ENDCASE
			
			nCoulmn = nCoulmn + 1
			IF nCoulmn >= 4
				nCoulmn = 1
				nLoopCount = nLoopCount + 1
				
			ENDIF
			
		*!*				this.addListitem(ALLTRIM(cc1)
		*!*		IF !EMPTY(cc1)
		*!*			IF LEN(ALLTRIM(cc1)) > 1
		*!*				this.addListitem(ALLTRIM(cc1),nLoopCount,2)
		*!*			ELSE
		*!*				nLoopCount = nLoopCount + 1
		*!*				this.addListitem(ALLTRIM(cc1),nLoopCount,1)
		*!*			ENDIF
		*!*			
		*!*		ENDIF
		ENDFOR
		
		*This.Value = Quotes.CL
		
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC
		IF USED('FormCode')
			USE IN FormCode
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms WITH(NOLOCK)"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		this.clear
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbForm.Valid
		PRIVATE nTHCK, cForm
		nTHCK = This.parent.txtThck.Value
		cForm = This.Value  &&This.parent.cmbForm.Value
		
		IF (TYPE('nthck') = "N" OR VARTYPE(nThck)="Y") AND TYPE('cForm')="C"
			IF nthck > 0 AND nthck < .125 AND cForm = "40"
				This.Parent.chkSPS1.Value = 1
			ENDIF
		ENDIF
		
		
		ThisForm.RefreshPOForms(This.Value)
		*CALLS: ThisForm.Refresh_AC_PU()
		*CALLS: GetPUfromForm()
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbMelt.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpMelt_Type')
			USE IN tmpMelt_Type
		ENDIF
		
		this.clear
		
		cSQL="SELECT RTRIM([Type]) AS [Type] FROM dbo.Melt_Type WITH(NOLOCK) ORDER BY ID "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMelt_Type')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpMelt_Type')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMelt_Type")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMelt_Type")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpMelt_Type')
		ENDIF
		
		DIMENSION aMelt_Type(1)
		
		IF USED('tmpMelt_Type')
			SELECT Type FROM tmpMelt_Type INTO ARRAY aMelt_Type
			
			USE IN tmpMelt_Type 
		ENDIF
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aMelt_Type,1)
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 1
		This.NumberOfElements=nArrayCount 
		This.BoundColumn = 1
		This.ColumnWidths = "50"
		
		
		
		FOR I = 1 TO nArrayCount
			this.addListitem(aMelt_Type(I),I)
		*	this.addListitem(aMelt_Type(I, 2),I,2)
		ENDFOR
		
		This.Value = aMelt_Type(1)
		
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbOrder_PU.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpPU')
			SELECT tmpPU
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT Unit, PU, RTRIM(Label) AS cLabel FROM dbo.PU WITH(NOLOCK) "
		cSQL = cSQL + " ORDER BY PU ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPU')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPU')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPU")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPU")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpPU')
		ENDIF
		
		IF VARTYPE(gaPU)="U"
			PUBLIC gaPU(1,3)
		ENDIF
		
		
		IF USED('tmpPU')
			SELECT Unit, STR(PU,1) AS PU, cLabel FROM tmpPU INTO ARRAY gaPU
			
			USE IN tmpPU
		ENDIF
		
		*This.ColumnCount = ALEN(gaPU,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(gaPU)
		This.BoundColumn = 2
		This.ColumnWidths = "50,10"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(gaPU,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(gaPU(I, 1),I,1)
			this.addListitem(gaPU(I, 2),I,2)
			*do not list gaPU(I, 3)
		ENDFOR
		
		
	ENDPROC

