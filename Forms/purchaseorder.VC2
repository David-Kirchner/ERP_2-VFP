	PROCEDURE testshipwhere		&& Test ShipWhere
		PARAMETERS pShipWhere
		*TestShipWhere(nShipWhere)
		
		PRIVATE nShipWhere, cCity, cForm, cBranchInit 
		nShipWhere	= PrepareSQLnum(pShipWhere,'ShipWhere',1,0)
		cCity		= PrepareSQLtxt(ThisForm.pgfPO.pgPOAddress.txtCity.Value,'City',100)
		cForm 		= PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.cmbForm.Value,'Form',2)
		cBranchInit = GetBRANCHfromForm (cForm, ThisForm.nConnHandle )
		
		*PRIVATE cSOitem
		*cSOitem	= ThisForm.cSOitem
		
		PRIVATE cMess
		cMess = ""
		
		DO CASE
		CASE nShipWhere = 1
			*ERP_Loc1
			IF NOT "TIPTON" $ UPPER(cCity)
				cMess = "This Ship To has not been marked as to Tipton."+CHR(13)
			ENDIF
			IF cBranchInit <> "T"
				cMess = cMess + "Tipton is the typical receiving shop for this form '"+cForm+"'"+CHR(13)+"Please Check the ShipWhere"
			ENDIF
		CASE nShipWhere = 2
			*DIRECT
			IF Proper_SO_Item(ThisForm.cSOitem) = Proper_SO_Item("")
				cMess = "This Ship Direct needs a SO item"
			ENDIF
		CASE nShipWhere = 3
			*Blind
			IF Proper_SO_Item(ThisForm.cSOitem) = Proper_SO_Item("")
				cMess = "This Ship Blind needs a SO item"
			ENDIF
		
		CASE nShipWhere = 4
			*Service
			IF NOT lServicesPO OR lLabService
				cMess = "This Ship To is set to a service Provider, but "
			ENDIF
		CASE nShipWhere = 5
			*ERP_Loc2
			IF NOT "WINDFALL" $ UPPER(cCity)
				cMess = "This Ship To has not been marked as to Windfall."+ CHR(13)
			ENDIF
			
			IF cBranchInit <> "W"
				cMess = cMess + "Windfall is the typical receiving shop for this form '"+cForm+"'"+CHR(13)+"Please Check the ShipWhere"
			ENDIF
		
		CASE nShipWhere = 6
			*RemoteStock
		
		OTHERWISE
			*ShipWhere unidentified.
			cMess = "Ship To is not defined."
		ENDCASE
		
		
		
		IF LEN(cMess) > 0
			MESSAGEBOX(cMess,04+48,"Ship Where -Warning")
		ENDIF
	ENDPROC

	PROCEDURE unify_terms
		PARAMETERS cSOItem, nHPApo, cTerms
		*ThisForm.Unify_Terms(cSOItem, nHPApo, cTerms)
		
		RETURN
		
		
		
		IF USED ('tmpCntPO_SOdist')
			USE IN tmpCntPO_SOdist
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PO_SOdist WHERE POitem = '"+cPOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntPO_SOdist' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCntPO_SOdist' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCntPO_SOdist')
		ENDIF	
		IF USED('tmpCntPO_SOdist')
			lFoundPO_SOdist = tmpCntPO_SOdist.CNTD > 0
			USE IN tmpCntPO_SOdist
		ENDIF
	ENDPROC

