	PROCEDURE didsoitem_usestock
		*ThisForm.didSOitem_UseStock()
		*Reutrn T or F
		
		PRIVATE lReturn
		lReturn = .F.
		
		IF USED('tmpUseINV')
			USE IN tmpUseINV
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS Cntd "
		cSQL = cSQL + " FROM dbo.StockLst_Process "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+ThisForm.SalesNum+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUseINV')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUseINV')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpUseINV')
		ENDIF
		
		IF USED('tmpUseINV')
			IF tmpUseINV.Cntd > 0
				*Found a Inventory selected process!
		*		REPLACE INV WITH .T.
				lReturn = .T.
			ENDIF
			USE IN tmpUseINV
		ENDIF
		
		*ThisFormSet.frmEO.pf1.pgOrder.chkInv.Refresh
		RETURN lReturn
	ENDPROC

	PROCEDURE editcontactscreen
		PARAMETERS nShow
		*ThisForm.EditContactScreen( 1 )
		* 
		
		PRIVATE lShowEdit
		lShowEdit = .F.
		
		IF VARTYPE(nShow) = 'N'
			IF nShow = 0
				lShowEdit = .F.
			ENDIF
			IF nShow = 1
				lShowEdit = .T.
			ENDIF
		ENDIF
		
		IF lShowEdit
		*	ThisForm.Editing = .T.
				
			ThisForm.POAddress_Screen('ContactToSave')
			
			WITH ThisForm.pgfPO.pgVendorContact
				.cContact.ReadOnly = .F.
				.cPhone.ReadOnly = .F.
				.cCellPhone.ReadOnly = .F.
				.cFax.ReadOnly = .F.
				.cEmail.ReadOnly = .F.
				.cAddr1.ReadOnly = .F.
				.cAddr2.ReadOnly = .F.
				.cCity.ReadOnly = .F.
				.cST.ReadOnly = .F.
				.cZip.ReadOnly = .F.
				.cCountry.ReadOnly = .F.
		*		.chkQuality.ReadOnly = .F.
		*		.dLastSurveySent.ReadOnly = .F.
		*		.dLastSurveyReceived.ReadOnly = .F.
				.cJobTitle.ReadOnly = .F.
		*		.nSurveyPriority.ReadOnly = .F.
				.chkVCinactive.ReadOnly = .F.
				.cmdSaveToPO.Enabled = .F.
			ENDWITH
			
		ELSE
		*	ThisForm.Editing = .F.
		
			ThisForm.POAddress_Screen('ContactToEdit')
			
			WITH ThisForm.pgfPO.pgVendorContact
				.cContact.ReadOnly = .T.
				.cPhone.ReadOnly = .T.
				.cCellPhone.ReadOnly = .T.
				.cFax.ReadOnly = .T.
				.cEmail.ReadOnly = .T.
				.cAddr1.ReadOnly = .T.
				.cAddr2.ReadOnly = .T.
				.cCity.ReadOnly = .T.
				.cST.ReadOnly = .T.
				.cZip.ReadOnly = .T.
				.cCountry.ReadOnly = .T.
				.chkQuality.ReadOnly = .T.
				.dLastSurveySent.ReadOnly = .T.
				.dLastSurveyReceived.ReadOnly = .T.
				.cJobTitle.ReadOnly = .T.
				.nSurveyPriority.ReadOnly = .T.
				.chkVCinactive.ReadOnly = .T.
				.cmdSaveToPO.Enabled = .T.
			ENDWITH
		ENDIF
	ENDPROC

