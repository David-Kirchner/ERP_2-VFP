			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO_Detail(nWO_Detail,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtAlloy.InteractiveChange
		PRIVATE nInsertionPt , lcSearchStr, cSearchStrOrig, lcTryAlloy 
		nInsertionPt  = THIS.SELSTART
		cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		lcSearchStr = ShowSQLtxt(cSearchStrOrig,'Alloy',12)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,nInsertionPt )
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=cSearchStrOrig 
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = nInsertionPt 
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
				
				PRIVATE cDisplayAlloy
				cDisplayAlloy = ShowSQLtxt(This.parent.txtDispAlloy.Value,'DisplayAlloy',20)
				
				IF NOT EMPTY(cDisplayAlloy)
					IF NOT CheckDisplayAlloyforAlloy(cDisplayAlloy, cAlloyStandard, ThisForm.nConnHandle)
						MESSAGEBOX("Display Alloy:"+ALLTRIM(cDisplayAlloy)+" has never been purchased as "+CHR(13)+"HPA Alloy:"+ALLTRIM(cAlloyStandard)+"!"+CHR(13)+"Caution!",0+48,"Check your Display Alloy!")
					ENDIF
				ENDIF
				
				
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtCompany.InteractiveChange
		PRIVATE nInsertionPt , lcSearchStr,cSearchStrOrig, lcTryVendor
		nInsertionPt  = THIS.SELSTART
		IF EMPTY(This.Value)
			* Nothing to Validate
			RETURN .T.
		ENDIF
			
		cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		lcSearchStr = ShowSQLtxt(cSearchStrOrig,'Company',100)
		
		lcTryVendor  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryVendor = ALLTRIM(SearchVendorCompany(lcSearchStr,"BEGINS", ThisForm.nConnHandle ))
			IF NOT EMPTY(lcTryVendor)		
				IF UPPER(lcSearchStr) = UPPER(SUBSTR(lcTryVendor,1,nInsertionPt ))
					THIS.VALUE=lcTryVendor
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=cSearchStrOrig
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=cSearchStrOrig
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = nInsertionPt 
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtCompany.LostFocus
		=insmode(.T.)
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.txtCompany.Valid
		PRIVATE lcSearchStr, cSearchStrOrig, lcTryVendor, nInsertionPt 
		nInsertionPt = THIS.SELSTART
		IF EMPTY(This.Value)
			RETURN .T.
		ENDIF
		*cSearchStrOrig = SUBSTR(This.Value,1,nInsertionPt )
		cSearchStrOrig = ShowSQLtxt(This.Value,'Company',100)
		lcSearchStr = RTRIM( ShowSQLtxt(cSearchStrOrig,'Company',100) )
		lcTryVendor  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryVendor = ALLTRIM( SearchVendorCompany(lcSearchStr,"BEGINS",ThisForm.nConnHandle ) )
			IF NOT EMPTY(lcTryVendor)		
				IF UPPER(lcSearchStr) = UPPER(SUBSTR(lcTryVendor,1,nInsertionPt ))
					THIS.VALUE=lcTryVendor
					THIS.FORECOLOR = RGB(0,0,0)
					
					PRIVATE nVendCode 
					nVendCode = getVendCode_Company(lcSearchStr,ThisForm.nConnHandle)
					
		*			IF VARTYPE(ThisForm.nVendCode)!="N"
		*				ThisForm.nVendCode = 0
		*			ENDIF
		*			IF ThisForm.nVendCode = 0
						ThisForm.nVendCode = nVendCode
		*			ENDIF
					
					This.parent.parent.pgVendor.txtVendCode.Value = nVendCode
					
					IF nVendCode > 0
					
						ThisForm.CheckVendCode() &&Check SO item for using a PO for Conversion Services
						
						ThisForm.GetVendorContacts(0)
						
						IF ThisForm.nVendCode != nVendCode
							*IF nVendCode > 0
								PRIVATE cOldVendorCompany, cCurVendorCompany
								cOldVendorCompany = getVendor_Company_VendCode(ThisForm.nVendCode,ThisForm.nConnHandle)
								cCurVendorCompany = getVendor_Company_VendCode(nVendCode,ThisForm.nConnHandle)
								*MESSAGEBOX("This Vendor "+ALLTRIM(cCurVendorCompany)+" has a preferred VendCode of "+ALLTRIM(STR(nVendCode))+CHR(13)+"Vendor was "+ALLTRIM(cOldVendorCompany)+" with VendCode="+ALLTRIM(STR(ThisForm.nVendCode))+CHR(13)+"The Vendor Address was updated on this PO."+CHR(13)+"Check Vendor Contact for this address.",0+48,"Please recheck Vendor Address and Contact")
								
								TrackMess("Salesnum:"+ALLTRIM(STR(Thisform.SalesNum))+" POitem:"+ALLTRIM(ThisForm.cPOitem )+" This Vendor "+ALLTRIM(lcSearchStr)+" has a preferred VendCode of "+ALLTRIM(STR(nVendCode))+CHR(13)+"Vendor was "+ALLTRIM(cOldVendorCompany)+" with VendCode="+ALLTRIM(STR(ThisForm.nVendCode))+CHR(13)+"The Vendor Address was updated on this PO."+CHR(13)+"Check Vendor Contact for this address."+" PurchaseOrder.txtCompany.Valid()")
		
								IF ThisForm.FillVendorAddr(nVendCode)
									*ThisForm.POAddressScreen("VendorEdit")
									ThisForm.POAddress_Screen("VendorEdit")
									*ThisForm.nVendCode = nVendCode
								ENDIF							
		
								
								ThisForm.nContactID = 0
							*ENDIF
						ENDIF
					ENDIF
		
					
					PRIVATE cVendorCompany
					cVendorCompany = ALLTRIM(This.Parent.Parent.PgVendor.txtCompany.Value)
					IF lcTryVendor != cVendorCompany 
						MESSAGEBOX("This Vendor name:"+lcTryVendor +CHR(13)+"is different from the name used on the Vendor Address tab."+CHR(13)+cVendorCompany+CHR(13)+"Please correct Vendor Address name.",0+48,"Different Vendor names.") 
					
					ENDIF
				ELSE
					THIS.VALUE=cSearchStrOrig 
					THIS.FORECOLOR = RGB(255,0,0)
					WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=cSearchStrOrig 
				THIS.FORECOLOR = RGB(255,0,0)
				WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
			ENDIF
		ELSE
			WAIT WINDOW "Need Vendor name to check Approval status per PR-74-01 6.1" TIMEOUT 1
		ENDIF
		
	ENDPROC

