	PROCEDURE pgfPO.pgPODesc.cmbShipWhere.Init
		This.Style = 2
		This.RowSourceType = 1
		This.RowSource = getShipWhereString()
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbShipWhere.InteractiveChange
		
		*ThisForm.Shipwherechange(nShipWhere,cCompany,cCity)
		PRIVATE nShipWhere,cCompany,cCity
		nShipWhere = This.Value
		cCompany = This.parent.parent.pgPOAddress.txtCompany.Value 
		cCity = This.parent.parent.pgPOAddress.txtCity.Value 
		
		*ThisForm.Shipwherechange(This.Value,This.parent.txtCompany.Value,This.parent.txtCity.Value)
		ThisForm.ShipWhereChange(nShipWhere,cCompany,cCity)
		
		*rowsource='ERP_Loc1,Direct2Cust,Blind,Service_Conv,ERP_Loc2'
		*1 ERP_Loc1,2 DIRECT,3 Blind,4 Service,5 ERP_Loc2,6 RemoteStock
		DO CASE
		CASE nShipWhere = 1
			*ERP_Loc1
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 1
			ThisForm.TestShipWhere(nShipWhere)
		CASE nShipWhere = 2
			*DIRECT
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 2
			ThisForm.TestShipWhere(nShipWhere)
		CASE nShipWhere = 3
			*Blind
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 3
			ThisForm.TestShipWhere(nShipWhere)
		CASE nShipWhere = 4
			*Service
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 4
		
		CASE nShipWhere = 5
			*ERP_Loc2
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 5
			ThisForm.TestShipWhere(nShipWhere)
		CASE nShipWhere = 6
			*RemoteStock
			This.parent.parent.pgPOAddress.opgPOShipTo.Value = 6
		
		OTHERWISE
		
		ENDCASE
		
		This.parent.parent.pgPOAddress.opgPOShipTo.Refresh
		*ThisForm.pf.pg_po.pgfPO.pgPODesc.cmbShipWhere.Refresh
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbStock.AddItem
		LPARAMETERS cItem
		*All for Stock,Mostly Stock,Some Stock,No Stock,Not 2 HPA
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmbStock.Valid
		*All for Stock,Mostly Stock,Some Stock,No Stock,Not 2 HPA
		
		PRIVATE cStockType, lNeedSO
		cStockType = PrepareSQLtxt(This.Value,'Stock',13)
		
		DO CASE 
		CASE cStockType = "All for Stock"
			lNeedSO = .F.
		CASE cStockType = "Mostly Stock"
			lNeedSO = .T.
		CASE cStockType = "Some Stock"
			lNeedSO = .T.
		CASE cStockType = "No Stock"
			lNeedSO = .T.
		CASE cStockType = "DO NOT Stock"
			lNeedSO = .T.
		OTHERWISE
			lNeedSO = .F.
		ENDCASE
		
		IF lNeedSO 
			IF PrepareSQLnum(ThisForm.SalesNum,'Salesnum',-3) > 0
				IF PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSalesnum.Value,'Salesnum',-3) = 0
					ThisForm.pgfPO.pgPODesc.txtSalesnum.Value = ThisForm.SalesNum
				ENDIF
			ENDIF
			
			IF PrepareSQLnum(ThisForm.ItemNumber,'ItemNumber',2,0) > 0
				IF PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtItem.Value,'ItemNumber',2,0) = 0
					ThisForm.pgfPO.pgPODesc.txtItem.Value = ThisForm.ItemNumber
				ENDIF
			ENDIF
			
		ELSE
			PRIVATE nSalesNum
			nSalesNum = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSalesnum.Value,'Salesnum',-3)
			IF nSalesNum > 0
				IF MESSAGEBOX("If you do not have a customer,"+CHR(13)+"then you do not need the Customer Sales Number!"+CHR(13)+" Press (Y) to remove the SO:"+ALLTRIM(STR(nSalesNum)),4+48,"Remove SalesNum from PO?") = 6
					ThisForm.pgfPO.pgPODesc.txtSalesnum.Value = 0
					ThisForm.pgfPO.pgPODesc.txtItem.Value = 0
		*			ThisForm.ItemNumber = 0
		*			ThisForm.SalesNum = 0
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

