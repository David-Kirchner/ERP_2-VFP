	PROCEDURE pgfPO.pgPODesc.cmdShowVendors.Click
		PRIVATE cCompany, nVendCode
		nVendCode = PrepareSQLnum(ThisForm.nVendCode,'VendCode',-3)
		cCompany = ShowSQLtxt(This.Parent.txtCompany.Value,'Company',100)
		
		lcCurrTable = ALIAS()
		
		DO FORM Forms\SearchForm WITH "Vendor",cCompany TO nVendCode 
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ENDIF
		EndIF
		
		IF nVendCode > 0
			ThisForm.nVendCode = nVendCode 
			
			ThisForm.CheckVendCode()
			
			IF USED( 'tmpVendor' )
				USE IN tmpVendor
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT Company,PeachID,VendCode  FROM dbo.Vendor "
			cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendor')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpVendor' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendor")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendor")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpVendor')
			ENDIF
					
			IF USED('tmpVendor') 
				IF VARTYPE(tmpVendor.PeachID) = "C"
					This.Parent.lblVendCode.Caption = STR(tmpVendor.VendCode)
					This.Parent.lblPeachID.Caption = ShowSQLtxt(tmpVendor.PeachID,'PeachID',20)
					This.Parent.txtCompany.Value = tmpVendor.Company
					ThisForm.FillVendorAddr(tmpVendor.VendCode)
				ENDIF		
				
				USE IN tmpVendor
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.cmdWorkOrder.Click
		
		PRIVATE cPOitem, nWO, nWO_Detail, lReturn
		cPOitem = PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)
		cSOitem = PrepareSQLtxt(ThisForm.cSOitem,'SOitem',10)
		nWO		= PrepareSQLnum(This.parent.lblWOnum.Caption,'WO',-3)
		nWO_Detail = PrepareSQLnum(This.parent.lblWO_Dnum.Caption,'WOD',-3)
		IF nWO_Detail = 0
			nWO_Detail = PrepareSQLnum(This.parent.txtWO_Detail.Value,'WO_Detail',-3)
		ENDIF
		
		PRIVATE nMess
		DO FORM Forms\Connect_Orders WITH nWO,nWO_Detail,cPOitem,cSOitem,"POitem"
		
		***********************
		*Update Screen after Connect
		*SELECT WO FROM dbo.WorkOrder WITH(NOLOCK) WHERE POitem = '"+cPOitem+"'"
		nWO = getWO_with_POitem( cPOitem, ThisFormSet.nConnHandle) 
		This.Parent.lblWOnum.Caption = STR(nWO)
		
		IF nWO_Detail = 0
			nWO_Detail = getWOD_with_POitem( cPOitem, ThisFormSet.nConnHandle) 
			This.parent.lblWO_Dnum.Caption = STR(nWO_Detail)
			This.Parent.txtWO_Detail.Value = nWO_Detail
		ENDIF
		*Save to dbo.PurchaseOrder
		*********************
		IF nWO + nWO_Detail > 0
			PRIVATE cSQLi 
			cSQLi = "UPDATE dbo.PurchaseOrder "
			IF nWO > 0
				cSQLi = cSQLi + " SET WO="+STR(nWO)
				IF nWO_Detail > 0
					cSQLi = cSQLi +", WO_Detail="+STR(nWO_Detail)
				ENDIF
			ELSE
				cSQLi = cSQLi + " SET WO_Detail="+STR(nWO_Detail)
			ENDIF
			
			cSQLi = cSQLi + " WHERE POitem = '"+cPOitem+"'"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
		
			ENDIF
		ENDIF
	ENDPROC

