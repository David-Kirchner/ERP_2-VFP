	PROCEDURE pgfPO.pgSOdist.cmdSearchSO.Click
		PRIVATE cSOitem
		cSOitem = ''
		
		DO FORM Forms\ChooseSOitem WITH 0 TO cSoItem
		
		IF NOT EMPTY(cSOitem)
			*Get SO QTY
			PRIVATE cSQL, nSQLEXEC 
			PRIVATE nSO_QTY, nAcct_QTY 
			nSO_QTY = 0
			nAcct_QTY = 0
		
			IF USED('tmpSalesQTY')
				USE IN tmpSalesQTY
			ENDIF
				
			cSQL = "SELECT Quoted_QTY, S_QTY "
			cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesQTY')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSalesQTY' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesQTY")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesQTY")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesQTY' )
			ELSE
				IF USED('tmpSalesQTY')
					IF RECCOUNT('tmpSalesQTY') > 0
						nSO_QTY = PrepareSQLnum(tmpSalesQTY.Quoted_QTY,'Quoted_QTY',-5)
						nAcct_QTY = PrepareSQLnum(tmpSalesQTY.S_QTY,'S_QTY',-5)
					ENDIF
					USE IN tmpSalesQTY
				ENDIF
			ENDIF
			*****
			
			This.Parent.txtSOitem.Value = cSOitem
			This.Parent.txtPercent.Value = 0
			This.Parent.txtQTY.Value = nSO_QTY 
			*This.Parent.txtQTY.Value = nAcct_QTY 
			
			*This.Parent.cmdUpdateSOs.Click Wait for Save
			
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.cmdUpdateSOs.Click
		PRIVATE nHpaPo, nItemPo
		nHpaPo	= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtHPApo.VALUE,'ERP PO',-3,0)
		nItemPo	= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtItempo.VALUE,'Item PO',2,0)
		
		PRIVATE	cPoItem, cSOitem
		cPOItem = Proper_PO_item( STR(nHPApo)+"-"+STR(nItemPo,2,0) )
		*cSOitem = "STOCK"
		
		nSalesNum = ThisForm.SalesNum
		nItemSO	  = ThisForm.itemNumber
		
		IF nSalesnum = 0
			cSOItem = "STOCK"
			nSalesNum = 0
			nItemSO = 0
		ENDIF  
		
		IF nSalesnum > 0
			cSOItem = Proper_SO_item( STR(nSalesnum)+"-"+STR(nItemSO,2,0) )
		ENDIF
		
		IF cSOitem = Proper_SO_item( STR(0)+"-"+STR(0) )
			cSOItem = "STOCK"
			nSalesNum = 0
			nItemSO	 = 0
		ENDIF
		
		PRIVATE lServicesPO, lConvServ, lEquipment, lIntP	
		lServicesPO	= PrepareSQLlogic(ThisForm.pgfPO.pgPOdesc.chkLab_Service.VALUE,'ServicesPO',.F.)
		lConvServ	= PrepareSQLlogic(ThisForm.pgfPO.pgPOdesc.chkConvServ.VALUE,'ConvServ',.f.)
		lEquipment	= PrepareSQLlogic(ThisForm.pgfPO.pgPOdesc.chkEquipment.VALUE,'Equipment',.F.)
		lIntP		= PrepareSQLlogic(ThisForm.pgfPO.pgPOdesc.chkIntP.VALUE,'IntP',.F.)
		
		IF nSalesnum = 0
			*cSOItem = "STOCK"
			*No SOitem! Then be more specific if possible
			IF lServicesPO
				cSOItem = "LabService"
			ENDIF
			IF lConvServ
				cSOItem = "ConvertSVC"
			ENDIF
			IF lEquipment
				cSOItem = "Equipment"
			ENDIF
		ENDIF
		
		PRIVATE nOrder_Qty, nOrder_P, nOthrtP
		nOrder_Qty		= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtOrder_Qty.VALUE,'Order_Qty',-5)
		nOrder_P		= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.VALUE,'Order_P',-5)
		nOtherP			= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOtherP.Value,'OtherP',10,2)
		
		PRIVATE nOrder_Total
		nOrder_Total = nOrder_Qty * nOrder_P
		
		
		IF NOT (Proper_PO_Item(cPOitem) = Proper_PO_Item('') OR cPOItem = Proper_PO_item("0-01") )
			*Update Sales bucket with new POCost
			*updateSales_PoCost(cPOitem) dbo.P_updateSales_PoCost
			
			*Look for obvious PO Costs
					
			PRIVATE lUpdatedSO
			lUpdatedSO = .F.
			
			****
			PRIVATE lFoundPO_SOdist
			lFoundPO_SOdist = .F.
			
			IF USED ('tmpCntPO_SOdist')
				USE IN tmpCntPO_SOdist
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PO_SOdist WHERE POitem = '"+cPOitem+"'"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntPO_SOdist' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCntPO_SOdist' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntPO_SOdist")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntPO_SOdist")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCntPO_SOdist')
			ENDIF	
			IF USED('tmpCntPO_SOdist')
				lFoundPO_SOdist = tmpCntPO_SOdist.CNTD > 0
				USE IN tmpCntPO_SOdist
			ENDIF
			
			*Service
			*-- Lab Service 100% cost to SO
			IF lServicesPO AND NOT lUpdatedSO
				IF lFoundPO_SOdist 
					*Update listings in dbo.PO_SOdist for this PO at 100%
					cSQL = "UPDATE dbo.PO_SOdist "
					cSQL = cSQL + " SET QTY="+STR(nOrder_Qty,18,4)
					cSQL = cSQL + " ,P="+STR(nOrder_P,18,4)
					cSQL = cSQL + " ,Total="+STR(nOrder_Total,18,4)
					cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
				ELSE
					*Insert at 100%
					cSQL = "INSERT INTO dbo.PO_SOdist "
					cSQL = cSQL + " (POitem,SOitem,QTY,P,Total )"
					cSQL = cSQL + " VALUES ("
					cSQL = cSQL + "'"+cPOitem+"'"
					cSQL = cSQL + ",'"+cSOitem+"'"
					cSQL = cSQL + ","+STR(nOrder_Qty,18,4)
					cSQL = cSQL + ","+STR(nOrder_P,18,4)
					cSQL = cSQL + ","+STR(nOrder_Total,18,4)
					cSQL = cSQL + ")"
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
				ELSE
					lUpdatedSO = .T.
				ENDIF
			ENDIF
			
			*Equipment
			*- No SO, no update needed.
			IF lEquipment AND NOT lUpdatedSO
				IF lFoundPO_SOdist 
					*Remove listings in dbo.PO_SOdist for this PO
					cSQL = "DELETE FROM dbo.PO_SOdist "
					cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
					ENDIF
				ENDIF
				
				lUpdatedSO = .T.
			ENDIF
			
			*Conversion Service
			*- very complicated, could be applied accross many SO's
			IF lConvServ AND NOT lUpdatedSO
				IF lFoundPO_SOdist 
					*ignore listings in dbo.PO_SOdist for this PO
					*Could be set by SalesPerson, do not guess here.
				ELSE
					*Insert if not found
					cSQL = "INSERT INTO dbo.PO_SOdist "
					cSQL = cSQL + " (POitem,SOitem,QTY,P,Total )"
					cSQL = cSQL + " VALUES ("
					cSQL = cSQL + "'"+cPOitem+"'"
					cSQL = cSQL + ",'"+cSOitem+"'"
					cSQL = cSQL + ","+STR(nOrder_Qty,18,4)
					cSQL = cSQL + ","+STR(nOrder_P,18,4)
					cSQL = cSQL + ","+STR(nOrder_Total,18,4)
					cSQL = cSQL + ")"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
					ENDIF
				ENDIF
				lUpdatedSO = .T.
			ENDIF
		
			*Stock
			
			IF NOT lUpdatedSO
				PRIVATE lStockLst,cStock
				cStock		= PrepareSQLtxt(ThisForm.pgfPO.pgPOdesc.cmbStock.VALUE,'Stock',13,.F.)
				lStockLst	= isForStock(cStock)
				
				
				IF lStockLst
					*- if stock, use quantity of SO for PO costing
					IF lFoundPO_SOdist 
						*Ignore listings in dbo.PO_SOdist for this PO
					ELSE
						*Insert if not found
						cSQL = "INSERT INTO dbo.PO_SOdist "
						cSQL = cSQL + " (POitem,SOitem,QTY,P,Total )"
						cSQL = cSQL + " VALUES ("
						cSQL = cSQL + "'"+cPOitem+"'"
						cSQL = cSQL + ",'"+cSOitem+"'"
						cSQL = cSQL + ","+STR(nOrder_Qty,18,4)
						cSQL = cSQL + ","+STR(nOrder_P,18,4)
						cSQL = cSQL + ","+STR(nOrder_Total,18,4)
						cSQL = cSQL + ")"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
						ENDIF
					ENDIF
					lUpdatedSO = .T.
				ELSE
					*- not for stock, 100% cost to SO as Broker
					IF lFoundPO_SOdist 
					ELSE
						*Insert at 100% if not found
						cSQL = "INSERT INTO dbo.PO_SOdist "
						cSQL = cSQL + " (POitem,SOitem,QTY,P,Total )"
						cSQL = cSQL + " VALUES ("
						cSQL = cSQL + "'"+cPOitem+"'"
						cSQL = cSQL + ",'"+cSOitem+"'"
						cSQL = cSQL + ","+STR(nOrder_Qty,18,4)
						cSQL = cSQL + ","+STR(nOrder_P,18,4)
						cSQL = cSQL + ","+STR(nOrder_Total,18,4)
						cSQL = cSQL + ")"
		
									
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
						ELSE
							lUpdatedSO = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF	
			
			IF lUpdatedSO 
				*Finds All Sales Order Items that have been touched by this POitem 
				*and Updates the dbo.Sales.POCost for each SOitem touched
				
				cSQL = "EXEC dbo.p_UpdateSales_PoCost '"+cPOitem+"'"
					
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
				ENDIF
			ENDIF
			
			IF USED('SalesTotal')
				*EditSales is Open
				*-read back data written by p_UpdateSales_PoCost for SalesTotal
						
				PRIVATE cSOitem
				cSOitem = Proper_SO_Item(SalesTotal.SOitem)
				
				PRIVATE cSQL, nSQLEXEC 
				PRIVATE nSO_POCost
				nSO_POCost = 0
		
				IF USED('tmpSalesPOCost')
					USE IN tmpSalesPOCost
				ENDIF
		
				cSQL = "SELECT POCost FROM dbo.Sales WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = '"+cSOitem +"'"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesPOCost')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSalesPOCost' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPOCost")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesPOCost")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesPOCost' )
				ELSE
					IF USED('tmpSalesPOCost')
						IF RECCOUNT('tmpSalesPOCost') > 0
							nSO_POCost = PrepareSQLnum(tmpSalesPOCost.POCost,'POCost',-5)
						ENDIF
						USE IN tmpSalesPOCost
					ENDIF
				ENDIF
		
		
		
				SELECT SalesTotal
				
				IF nSO_POCost > 0
					REPLACE SalesTotal.POcost WITH nSO_POCost
					REPLACE SalesTotal.ItemCost WITH SalesTotal.POcost + SalesTotal.StkCost
				ENDIF
			ENDIF
			
			
				
				
			WAIT WINDOW 'Saved!' NOWAIT
		ENDIF
		
		************************
		PRIVATE nDist_QTY
		nDist_QTY = 0
		
		IF USED('tmpPO_DQTY')
			USE IN tmpPO_DQTY
		ENDIF
		
		cSQL = "SELECT SUM(QTY) AS nQTY"
		cSQL = cSQL + " FROM dbo.PO_SOdist WITH(NOLOCK) "
		cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_DQTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_DQTY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_DQTY' )
		ELSE
			IF USED('tmpPO_DQTY')
				IF RECCOUNT('tmpPO_DQTY') > 0
					nDist_QTY = PrepareSQLnum(tmpPO_DQTY.nQTY,'QTY',18,4)
					This.Parent.txtDist_QTY.Value = nDist_QTY 
				ENDIF
				USE IN tmpPO_DQTY
			ENDIF
		ENDIF
		**********************
		ThisForm.PgfPO.PgPODesc.txtPOi_Total.Value = nOrder_Total + nOtherP
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.cmdWorkOrder.Click
		
		PRIVATE cPOitem, cSOitem, nWO, nWOD, nID_PO_SODist, lReturn
		cPOitem = PrepareSQLtxt(This.parent.parent.parent.lstPoItems.Value,'POitem',12)
		cSOitem = PrepareSQLtxt(This.Parent.txtSOitem.Value,'SOitem',12)
		nWO		= PrepareSQLnum(This.parent.txtWO_PO_SO_Dist.Value,'WO',-3)
		nWOD = 0
		nID_PO_SODist = PrepareSQLnum(This.Parent.txtPO_SODist_ID.Value,'ID_PO_SODist',-3)
		
		MESSAGEBOX( "A PO Distribution is based on a Sales Order."+CHR(13)+"The Starting WO screen is available,"+CHR(13)+"not the Finish Detail screen.",0+64)
		
		IF nWO > 0
			DO FORM Forms\WorkOrder WITH "EDIT_PO_SO-Start", nWO,nWOD,cPOitem,cSOitem,nID_PO_SODist  
		ELSE
			DO FORM Forms\WorkOrder WITH "ADD_PO_SO-Start", nWO,nWOD,cPOitem,cSOitem,nID_PO_SODist 
		ENDIF
		*PARAMETERS pWhat,pWO,pPOitem,pSOitem,pWhatEver
		
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.grdPO_SOdist.AfterRowColChange
		LPARAMETERS nColIndex
		
		This.Parent.txtPO_SODist_ID.Value = tmpPO_Dist.ID
		This.parent.txtSOitem.Value		= tmpPO_Dist.SOitem
		This.Parent.txtPercent.Value	= 0
		This.Parent.txtQTY.Value		= tmpPO_Dist.QTY
		
		*This.Parent.txtSO_P.Value	= tmpPO_Dist.P
		This.Parent.txtSO_QTY.Value = tmpPO_Dist.QTY
		This.Parent.txtSO_Total.Value = tmpPO_Dist.Total
		
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.Label1.Click
		ThisForm.Show_SO_Dist()
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.lblPOtotal.Click
		ThisForm.Show_SO_Dist()
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.lblPO_Total.Click
		ThisForm.Show_SO_Dist()
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.lblQTY.Click
		IF PrepareSQLnum(This.Parent.txtAcct_QTY.Value,'Acct_QTY',-5) > 0
			This.Parent.txtQTY.Value = PrepareSQLnum(This.Parent.txtAcct_QTY.Value,'Acct_QTY',-5)
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.lblSOitem.Click
		PRIVATE cSOitem, nSalesNum
		cSOitem = ''
		
		nSalesNum = PrepareSQLnum(ThisForm.SalesNum,'SalesNum',-3)
		
		IF nSalesNum = 0
			DO FORM Forms\ChooseSO WITH "ChooseSO" TO nSalesNum 
		ENDIF
		
		IF nSalesNum = 0
			MESSAGEBOX("No Sales Number!"+CHR(13)+"Random typing of a number is not allowed.",48,"Enter Sales Number first.")
			RETURN .F.
		ENDIF
		
		DO FORM Forms\ChooseSOitem WITH nSalesNum TO cSoItem
		cSOitem = Proper_SO_item(cSOitem)
		
		IF cSOitem <> Proper_SO_item('')
			This.parent.txtSOitem.Value = cSOitem
		
			PRIVATE nQTY 
			nQTY = getAcct_QTY_SOitem (cSOitem,ThisFormSet.nConnHandle)  &&Acct QTY
			*nSO_QTY = getQTY_SOitem(cSOitem,ThisFormSet.nConnHandle)  &&Customers QTY
			IF nQTY > 0
				This.Parent.txtnQTY.Value = nQTY 
			ENDIF
			
			SELECT tmpPO_Dist
			LOCATE FOR SOitem = cSOitem
				
			IF FOUND('tmpPO_Dist')
				This.Parent.txtPO_SODist_ID.Value = tmpPO_Dist.ID
		
			
				
		
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.lblSOtotal.Click
		ThisForm.Show_SO_Dist()
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.txtPercent.Valid
		PRIVATE nPercent
		nPercent		= PrepareSQLnum(This.Value,'Percent',2,0)
		
		IF nPercent < 1
			nPercent = PrepareSQLnum(This.Value,'Percent',4,3)
		ELSE
			IF nPercent <= 100
				*Good Percent
				nPercent = nPercent/100
				This.Value = nPercent
			ENDIF
		ENDIF
		
		
		PRIVATE nStockLst_QTY, nQTY
		nStockLst_QTY	= PrepareSQLnum(This.parent.parent.pgPODesc.txtStockLst_QTY.VALUE,'StockLst_QTY',-5)
		nQTY = 0
		
		IF nStockLst_QTY > 0
			IF nPercent > 0
				nQTY = 	nStockLst_QTY * nPercent 
				IF nQTY > 0
					This.Parent.txtQTY.Value = nQTY
				ENDIF
			ENDIF
		ENDIF	
	ENDPROC

	PROCEDURE pgfPO.pgSOdist.txtSOitem.Valid
		IF RECNO('tmpPO_Dist') > 0
			PRIVATE nPO_SODist_ID, cSOitem, cThisSOitem
			nPO_SODist_ID	= PrepareSQLnum(This.Parent.txtPO_SODist_ID.Value,'PO_SODist_ID',-3)
			cThisSOitem		= PrepareSQLtxt(This.Value,'SOitem',10)
			cSOitem			= tmpPO_Dist.SOitem
			
			IF Proper_SO_Item(cThisSOitem) != Proper_SO_Item('')
				IF Proper_SO_Item(cThisSOitem) != Proper_SO_Item(cSOitem)
					This.Parent.txtPO_SODist_ID.Value = 0
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgTestPO.Click
		PRIVATE lcPOitem
		lcPOitem = Proper_PO_Item( This.parent.parent.lstPoItems.Value )
		
		IF ThisForm.POEditing 
			lcPOitem = Proper_PO_Item( STR(This.parent.pgPODesc.txtHpapo.Value)+"-"+STR(This.parent.pgPODesc.txtItemPo.Value) )
		ENDIF
		
		***Refresh PO_Testing screen
		PRIVATE nCountPOTesting
		nCountPOTesting = Count_POIteminPO_Testing( lcPOitem, ThisForm.nConnHandle )
		
		IF nCountPOTesting = 0
			*Add
			IF ThisForm.POEditing 
				IF MESSAGEBOX("Do you want to store Testing info with this PO?",4+32,"Create a Testing PO?")=6
					ThisForm.ShowPOTesting( 'NEW' )
				ELSE
					ThisForm.ShowPOTesting( 'BLANK' )
				ENDIF
			ELSE
				MESSAGEBOX("Nothing to Show."+CHR(13)+"Place the PO in Editing mode to add 'Testing' data.",0+64,"No Testing data to show")
				
				ThisForm.ShowPOTesting( 'BLANK' )
				
			ENDIF
		ELSE
			*Get data
			WAIT WINDOW "Retrieveing PO Testing data" Nowait
			ThisForm.ShowPOTesting( lcPOitem )
			WAIT CLEAR
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgTestPO.pgfTesting.pgMaterial.cmbSetDefaults.Valid
		PRIVATE cDefault
		cDefault = This.Value
		
		IF cDefault != "No change"
			IF MESSAGEBOX("This will overwrite existing data!"+CHR(13)+"Unless you cancel this PO Edit."+CHR(13)+CHR(13)+"Do you want to continue with defaults?",0+32,"Overwrite with new default data?")=7
				RETURN .F.
			ENDIF
		ENDIF
		
		DO CASE
		CASE cDefault = "No change"
			*No Change
		CASE cDefault = "6B"
			This.parent.ogTestType.Value = 2
			This.parent.ogTestPackage.Value = 1
			*This.parent.ogDelivery.Value = 1
			This.parent.ogReturnSamples.Value = 2
			
			This.parent.parent.pgStandards.cmbSpecimen.Value = ""
			This.parent.parent.pgStandards.ogLocation.Value = 1
			This.parent.parent.pgStandards.cmbTensileProc.Value = ""
			This.parent.parent.pgStandards.cmbTensileConf.Value = ""
			This.parent.parent.pgStandards.cmbTensileTemp.Value = ""
			This.parent.parent.pgStandards.cmbSonicProc.Value = ""
			This.parent.parent.pgStandards.ogSonicType.Value = 1
			This.parent.parent.pgStandards.cmbHardProc.Value = ""
			This.parent.parent.pgStandards.cmbHardConf.Value = ""
			This.parent.parent.pgStandards.ogHardProfile.Value = 2
			This.parent.parent.pgStandards.cmbIGCorrProc.Value = ""
			This.parent.parent.pgStandards.cmbStressProc.Value = ""
			This.parent.parent.pgStandards.cmbCharpyProc.Value = ""
			This.parent.parent.pgStandards.cmbCharpyTemp.Value = ""
		CASE cDefault = "N50"
			This.parent.ogTestType.Value = 2
			This.parent.ogTestPackage.Value = 1
			*This.parent.ogDelivery.Value = 1
			This.parent.ogReturnSamples.Value = 2
			
			This.parent.parent.pgStandards.cmbSpecimen.Value = ""
			This.parent.parent.pgStandards.ogLocation.Value = 1
			This.parent.parent.pgStandards.cmbTensileProc.Value = ""
			This.parent.parent.pgStandards.cmbTensileConf.Value = ""
			This.parent.parent.pgStandards.cmbTensileTemp.Value = ""
			This.parent.parent.pgStandards.cmbSonicProc.Value = ""
			This.parent.parent.pgStandards.ogSonicType.Value = 1
			This.parent.parent.pgStandards.cmbHardProc.Value = ""
			This.parent.parent.pgStandards.cmbHardConf.Value = ""
			This.parent.parent.pgStandards.ogHardProfile.Value = 2
			This.parent.parent.pgStandards.cmbIGCorrProc.Value = ""
			This.parent.parent.pgStandards.cmbStressProc.Value = ""
			This.parent.parent.pgStandards.cmbCharpyProc.Value = ""
			This.parent.parent.pgStandards.cmbCharpyTemp.Value = ""
		CASE cDefault = "N60"
			This.parent.ogTestType.Value = 2
			This.parent.ogTestPackage.Value = 1
			*This.parent.ogDelivery.Value = 1
			This.parent.ogReturnSamples.Value = 2
			
			This.parent.parent.pgStandards.cmbSpecimen.Value = ""
			This.parent.parent.pgStandards.ogLocation.Value = 1
			This.parent.parent.pgStandards.cmbTensileProc.Value = ""
			This.parent.parent.pgStandards.cmbTensileConf.Value = ""
			This.parent.parent.pgStandards.cmbTensileTemp.Value = ""
			This.parent.parent.pgStandards.cmbSonicProc.Value = ""
			This.parent.parent.pgStandards.ogSonicType.Value = 1
			This.parent.parent.pgStandards.cmbHardProc.Value = ""
			This.parent.parent.pgStandards.cmbHardConf.Value = ""
			This.parent.parent.pgStandards.ogHardProfile.Value = 2
			This.parent.parent.pgStandards.cmbIGCorrProc.Value = ""
			This.parent.parent.pgStandards.cmbStressProc.Value = ""
			This.parent.parent.pgStandards.cmbCharpyProc.Value = ""
			This.parent.parent.pgStandards.cmbCharpyTemp.Value = ""
		OTHERWISE
			*Blank
			This.parent.ogTestType.Value = 2
			This.parent.ogTestPackage.Value = 1
			This.parent.ogDelivery.Value = 1
			This.parent.ogReturnSamples.Value = 2
			
			This.parent.parent.pgStandards.cmbSpecimen.Value = ""
			This.parent.parent.pgStandards.ogLocation.Value = 1
			This.parent.parent.pgStandards.cmbTensileProc.Value = ""
			This.parent.parent.pgStandards.cmbTensileConf.Value = ""
			This.parent.parent.pgStandards.cmbTensileTemp.Value = ""
			This.parent.parent.pgStandards.cmbSonicProc.Value = ""
			This.parent.parent.pgStandards.ogSonicType.Value = 1
			This.parent.parent.pgStandards.cmbHardProc.Value = ""
			This.parent.parent.pgStandards.cmbHardConf.Value = ""
			This.parent.parent.pgStandards.ogHardProfile.Value = 2
			This.parent.parent.pgStandards.cmbIGCorrProc.Value = ""
			This.parent.parent.pgStandards.cmbStressProc.Value = ""
			This.parent.parent.pgStandards.cmbCharpyProc.Value = ""
			This.parent.parent.pgStandards.cmbCharpyTemp.Value = ""
		ENDCASE
	ENDPROC

	PROCEDURE pgfPO.pgVendor.chkVendorPOConf.Valid
		PRIVATE lThisVal, nHPAPO, cSQL, nSQLEXEC, cPOitem
		nHPAPO	= VAL(cPOitem)
		cPOitem = ThisForm.cPOitem 
		
		IF VARTYPE(This.Value) = "L"
			lThisVal = This.Value
		ELSE
			IF VARTYPE(This.Value) = "N"
				lThisVal = (This.Value=1)
			ENDIF
		ENDIF
		
		IF lThisVal
			IF MESSAGEBOX("Are you sure you want to mark PO:"+ALLTRIM(STR(nHPAPO))+CHR(13)+" as Receipt is Confirmed?",4+32,"Mark as Confirmed?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [VendorPOConf] = 1"
				cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as VendorPOConf for HPAPO:"+STR(nHPAPO)+" in PurchaseOrder" )
					
		*			ThisForm.Show_frmPO()
				ENDIF
				
			ELSE
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to UNmark PO:"+ALLTRIM(STR(nHPAPO))+CHR(13)+" as Receipt Confirmed?",4+32,"Mark as NOT received?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [VendorPOConf] = 0"
				cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as NOT receipt confirmed for HPAPO:"+ALLTRIM(STR(nHPAPO))+" in PurchaseOrder" )
		
		*			ThisForm.Show_frmPO()
				ENDIF
						
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgVendor.Click
		IF ThisForm.nVendCode = 0
			ThisForm.nVendCode = PrepareSQLnum(This.txtVendCode.Value,'VendCode',-3)
		ENDIF
		
		
		IF ThisForm.nVendCode > 0
			PRIVATE nVendCode
			nVendCode = PrepareSQLnum(This.txtVendCode.Value,'VendCode',-3)
			
			IF nVendCode <> ThisForm.nVendCode
				ThisForm.Show_VendCode( ThisForm.nVendCode )
			ELSE
				*Do nothing unless Company and Addr are Empty
				IF EMPTY(PrepareSQLtxt(This.txtCompany.Value,'Company',100)) OR EMPTY(PrepareSQLtxt(This.txtAddr1.Value,'Addr1',100))
					ThisForm.Show_VendCode( ThisForm.nVendCode )
				ENDIF
			ENDIF
			
			PRIVATE nContactID
			IF ThisForm.nContactID > 0 
				nContactID = PrepareSQLnum(This.parent.pgVendorContact.nContactID.Value,'ContactID',-3)
				IF ThisForm.nContactID <> nContactID
					ThisForm.ShowVendorContact( ThisForm.nContactID )
				ENDIF
			ENDIF
		ELSE
			PRIVATE cVendorDesc, cVendorAddr
			cVendorDesc = PrepareSQLtxt(ThisForm.PgfPO.pgPODesc.txtCompany.Value,'Company',100)
			cVendorAddr = PrepareSQLtxt(This.txtCompany.Value,'Company',100)
			
			IF LEN(cVendorDesc) > 0 AND LEN(cVendorAddr ) = 0
				
				This.txtCompany.Value = cVendorDesc 
				
				THISFORM.POAddress_Screen("VendorEdit")
				
				This.cmdPOSearchBuyFrom.ENABLED = .T.
		
				THIS.cmdEditAddr.CAPTION = "Save"
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendor.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		
		IF ThisForm.nVendCode > 0
			lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
		ENDIF
		
		IF lcMessAns = 6
			IF ThisForm.nVendCode <> 0
				THIS.PARENT.txtVendCode.VALUE = 0
				ThisForm.nVendCode= 0
			ENDIF
			
			*THISFORM.POAddressScreen("VendorEdit")
			THISFORM.POAddress_Screen("VendorEdit")
			This.parent.cmdPOSearchBuyFrom.ENABLED = .T.
		
			ThisForm.VendCodeClear()
		ELSE
			IF THIS.PARENT.cmdEditAddr.CAPTION = "Save"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					IF USED( 'tmpVendCode' )
						USE IN tmpVendCode
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.Vendor "
					cSQL = cSQL + " WHERE VendCode = "+STR(ThisForm.nVendCode)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendCode' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpVendCode' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendCode")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendCode")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC)
					ENDIF
					IF USED('tmpVendCode')
						ThisForm.nVendCode				= tmpVendCode.VendCode
						THIS.PARENT.txtVendCode.VALUE	= tmpVendCode.VendCode
						THIS.PARENT.txtCompany.VALUE 	= tmpVendCode.Company
						THIS.PARENT.txtAddr1.VALUE 		= tmpVendCode.Addr1
						THIS.PARENT.txtAddr2.VALUE 		= tmpVendCode.Addr2
						THIS.PARENT.txtCity.VALUE 		= tmpVendCode.City
						THIS.PARENT.txtST.VALUE 		= tmpVendCode.ST
						THIS.PARENT.txtZip.VALUE 		= tmpVendCode.Zip
						THIS.PARENT.txtCountry.VALUE 	= tmpVendCode.Country
		*				THIS.PARENT.txtContact.VALUE 	= tmpVendCode.Contact
		*				THIS.PARENT.txtPhone.VALUE 		= tmpVendCode.Telephone
		*				THIS.PARENT.txtFax.VALUE 		= tmpVendCode.Fax_Number
		*				THIS.PARENT.txtEmail.VALUE 		= tmpVendCode.Email
						THIS.PARENT.txtLastEdit.VALUE	= PrepareSQLdate(tmpVendCode.LastEdit,'LastEdit',.F.,.T.)
		
						This.Parent.Vend_Notes.Value	= tmpVendCode.Vend_Notes
						This.Parent.Vend_Print.Value	= tmpVendCode.Vend_Print
						This.Parent.txtPeachID.Value	= tmpVendCode.PeachID
						*This.Parent.chkVendorPOConf.Value = &&Does not Change
						This.Parent.QAApproved1.Value	= PrepareSQLnum(tmpVendCode.QAApproved,'QAApproved',-1)
						This.Parent.Metal1.Value		= tmpVendCode.Metal
						This.Parent.Inactive1.Value		= tmpVendCode.Inactive	
						
						USE IN tmpVendCode
					ENDIF
					
					*THISFORM.POAddressScreen("VendorEdit")
					THISFORM.POAddress_Screen("VendorEdit")
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendor.cmdEditAddr.Click
		PRIVATE	 maxVendCode, oldSoldCode, SaveAddr, msettalk
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit, lnPOShipAddr 
		*PRIVATE lcContact,lcPhone,lcFax,lcEmail
		PRIVATE cVend_Notes,cVend_Print,cPeachID,lInactive,lMetal
		
		lcCompany = PrepareSQLtxt(THIS.PARENT.txtCompany.VALUE,'Company',100)
		lcAddr1 = PrepareSQLtxt(THIS.PARENT.txtAddr1.VALUE,'Addr1',100)
		lcAddr2 = PrepareSQLtxt(THIS.PARENT.txtAddr2.VALUE,'Addr2',100)
		lcCity  = PrepareSQLtxt(THIS.PARENT.txtCity.VALUE,'City',50)
		lcST    = PrepareSQLtxt(THIS.PARENT.txtST.VALUE,'St',50)
		lcZip   = PrepareSQLtxt(THIS.PARENT.txtZip.VALUE,'Zip',50)
		lcCountry = PrepareSQLtxt(THIS.PARENT.txtCountry.VALUE,'Country',50)
		*lcContact = PrepareSQLtxt(THIS.PARENT.txtContact.VALUE,'Contact',100)
		*lcPhone	  = PrepareSQLtxt(THIS.PARENT.txtPhone.VALUE,'Phone',50)
		*lcFax	  = PrepareSQLtxt(THIS.PARENT.txtFax.VALUE,'Fax',12)
		*lcEmail	  = PrepareSQLtxt(THIS.PARENT.txtEmail.VALUE,'Email',60)
		ldLastEdit = DATE()
		
		cVend_Notes	= PrepareSQLtxt(This.Parent.Vend_Notes.Value,'Vend_Notes',-1)
		cVend_Print	= PrepareSQLtxt(This.Parent.Vend_Print.Value,'Vend_Print',-1)
		cPeachID  	= PrepareSQLtxt(This.Parent.txtPeachID.Value,'PeachID',20)
		lMetal		= PrepareSQLlogic(This.Parent.Metal1.Value,'Metal',.F.)
		lInactive	= PrepareSQLlogic(This.Parent.Inactive1.Value,'Inactive',.f.)
		
		*Check Data
		*ldLastEdit
		
		lnVendCode= IIF(ThisForm.nVendCode > 0, ThisForm.nVendCode, 0)
		IF lnVendCode < 1
			lnVendCode = PrepareSQLnum(This.Parent.txtVendCode.Value, 'VendCode', -3)
		ENDIF
		oldVendCode = lnVendCode
		*POShipAddr
		SaveAddr = .F.
		PRIVATE lSaveAddress
		lSaveAddress = .T.
		oldSoldCode = 0
		
		IF THIS.CAPTION = "Save"
			** Do you have anything to save?
			IF NOT EMPTY(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry))
				lSaveAddress = .T.
			ELSE
				lSaveAddress = .F.
			ENDIF
		
			IF EMPTY(lcCompany)
				MESSAGEBOX("Cannot save without an Company name!",0,'')
				lSaveAddress = .F.
				RETURN .F.
			ENDIF
			
			IF lnVendCode > 0
				*use lnVendCode 
				
				IF USED('cntShipAddr')
					USE IN cntShipAddr
				ENDIF
					
				PRIVATE cSQL, nSQLEXEC
				cSQL = "SELECT COUNT(*) AS CNT FROM dbo.Vendor "
				cSQL = cSQL + " WHERE VendCode = "+STR(lnVendCode)
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC)
				ENDIF
		
				IF USED('cntShipAddr')
					IF cntShipAddr.CNT > 0
						
						*Check for Update
						IF EMPTY(ThisForm.nVendCode)
							*Check everything
		
							IF USED( 'VendCode_Vendor' )
								USE IN VendCode_Vendor
							ENDIF
							
							PRIVATE cSQL, nSQLEXEC
							cSQL = "SELECT VendCode FROM dbo.Vendor "
							cSQL = cSQL + " WHERE "
							cSQL = cSQL + " Company = '"+lcCompany+"'"
							cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
							cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
							cSQL = cSQL + " AND City  = '"+lcCity+"'"
							cSQL = cSQL + " AND ST    = '"+lcST+"'" 
							cSQL = cSQL + " AND Zip   = '"+lcZip+"'"
							cSQL = cSQL + " AND Country = '"+lcCountry+"'" 
							cSQL = cSQL + " AND Vend_Notes= '"+cVend_Notes+"'"
							cSQL = cSQL + " AND PeachID= '"+cPeachID+"'"
							
							SELECT 0
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'VendCode_Vendor' )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'VendCode_Vendor' )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "VendCode_Vendor")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "VendCode_Vendor")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC)
							ENDIF
							IF USED( 'VendCode_Vendor' )
								IF VARTYPE(VendCode_Vendor.VendCode) = "N"
									IF VendCode_Vendor.VendCode > 0
										ThisForm.nVendCode= VendCode_Vendor.VendCode
										THIS.PARENT.txtVendCode.REFRESH
										lSaveAddress = .F.
									ENDIF			
								ENDIF
							
								USE IN VendCode_Vendor
							ENDIF
				
						ENDIF
					ELSE
						lSaveAddress = .T.
					ENDIF
				ELSE
					lSaveAddress = .T.
				ENDIF
				IF USED('cntShipAddr')
					USE IN cntShipAddr
				ENDIF
			ENDIF
			********************************
		
			IF lSaveAddress
				****** big save procedure********
				PRIVATE	cSaveNew
		
				IF lnVendCode > 0
					cSaveNew = MESSAGEBOX("Use NO to save the address edits."+CHR(13)+"Use NEW address only when Company has moved."+CHR(13)+CHR(13)+"Save as new Address?",4+32,"Is this a New Address?")
				ELSE
					**No SoldAddr- must save as new!
					cSaveNew = 6
				ENDIF
		
				IF cSaveNew = 6 && Yes, save as new
				
					IF lnVendCode > 0
						*Check old VendCode to see if anything changed
						IF USED( 'cntShipAddr' )
							USE IN cntShipAddr
						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS cnt FROM dbo.Vendor WHERE "
						cSQL = cSQL + " Company = '"+lcCompany+"'"
						cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
						cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
						cSQL = cSQL + " AND City  = '"+lcCity+"'"
						cSQL = cSQL + " AND ST    = '"+lcST+"'" 
						cSQL = cSQL + " AND Zip   = '"+lcZip+"'"
						cSQL = cSQL + " AND Vend_Notes= '"+cVend_Notes+"'"
						cSQL = cSQL + " AND PeachID= '"+cPeachID+"'"
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC)
						ENDIF
						IF USED('cntShipAddr')
							IF cntShipAddr.Cnt = 0
		*						no change - do not save
								SaveAddr = .F.
							ELSE &&did not match all Fields - Save
								SaveAddr = .T.
								oldVendCode = THISFORM.POShipAddr 
							ENDIF
						ELSE &&failed - add as new
							SaveAddr = .T.
						ENDIF 
					ELSE && No SoldCode just add new if have data
						IF LEN( ALLTRIM(THIS.PARENT.txtCompany.VALUE+THIS.PARENT.txtAddr1.VALUE)) > 1
							SaveAddr = .T.
						ELSE
							SaveAddr = .T.
						ENDIF
					ENDIF
		
		*cVend_Notes,lInactive,lMetal	
					SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
					MaxVendCode=get_MaxVendCode()
					
					IF SaveAddr
						THIS.PARENT.txtVendCode.VALUE = maxVendCode
						ThisForm.nVendCode= maxVendCode	
		
						PRIVATE cSQLi
		
						cSQLi = "EXEC dbo.p_Vendor_ins "
						cSQLi = cSQLi+ "@Company ='"+lcCompany+"'"   
						cSQLi = cSQLi+ ",@Addr1 ='"+lcAddr1+"'"   
						cSQLi = cSQLi+ ",@Addr2 ='"+lcAddr2+"'"   
						cSQLi = cSQLi+ ",@City ='"+lcCity+"'"   
						cSQLi = cSQLi+ ",@ST ='"+lcST+"'"
						cSQLi = cSQLi+ ",@Zip ='"+lcZip+"'"
						cSQLi = cSQLi+ ",@Country ='"+lcCountry+"'"
		
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Master")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Master")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Master')
						ELSE
							=SQLCOMMIT(ThisForm.nConnHandle)
							IF USED("tmpID_Master")
								lnVendCode= tmpID_Master.EXP
								ThisForm.nVendCode= lnVendCode
								This.parent.txtVendCode.Value = lnVendCode
								THIS.PARENT.txtVendCode.REFRESH
								
								USE IN tmpID_Master 
							ENDIF
		
						ENDIF
		
						*THISFORM.UpdateCustID = .T.
		
						THIS.PARENT.txtLastEdit.VALUE = DATE()
						THIS.PARENT.txtLastEdit.REFRESH
		
					ENDIF
				ELSE
					*Save - not as new!
					*REPLACE DATA
		
		
					*THISFORM.UpdateCustID = .T.
					
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.Vendor SET "
					cSQLu= cSQLu+"Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",LastEdit='"+DTOC(DATE())+"'"
					cSQLu= cSQLu+",Vend_Notes='"+cVend_Notes+"'"
					cSQLu= cSQLu+",PeachID='"+cPeachID+"'"
					cSQLu= cSQLu+" WHERE VendCode = "+STR(lnVendCode)
					*User does not have Authority to modify metal or Inactive
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC)
					ENDIF
					
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
		
				ENDIF
			ENDIF
			
			*** Save back to PO Description Page
			PRIVATE cPOCompany
			cPOCompany = This.parent.parent.pgPODesc.txtCompany.Value 
			IF EMPTY( cPOCompany )
				This.parent.parent.pgPODesc.txtCompany.Value = lcCompany
				This.parent.parent.pgPODesc.lblVendCode.Caption = STR(lnVendCode)
				This.parent.parent.pgPODesc.lblPeachID.Caption = cPeachID
			ELSE
				cPOCompany = ALLTRIM(cPOCompany)
				lcCompany = ALLTRIM(lcCompany)
				IF UPPER(cPOCompany) != UPPER(lcCompany)
					IF MESSAGEBOX("Tab PO Description Company is listed as:"+cPOCompany +CHR(13)+;
						 "This Vendor is:"+lcCompany+CHR(13)+"Do you want the PO Description Company"+CHR(13)+;
						 "to be:"+lcCompany+" also?",4+32,"Update tab PO Description 'Company'?")=6
						 
						This.parent.parent.pgPODesc.txtCompany.Value = lcCompany
						This.parent.parent.pgPODesc.lblVendCode.Caption = STR(lnVendCode)
						This.parent.parent.pgPODesc.lblPeachID.Caption = cPeachID
					
					ENDIF
				ENDIF
			ENDIF
			*Refresh Vendor Table!
			ThisForm.FillVendorAddr(lnVendCode)
			
			*THISFORM.POAddressScreen("VendorEdit")
			THISFORM.POAddress_Screen("VendorEdit")
			MESSAGEBOX("This Address has been saved, but you have not saved this address to this PO."+CHR(13)+"Remeber to click 'Save' on PO Desricption page.",0+64,"Remeber to save PO.") 
			
		ELSE &&Caption was Edit
			*THISFORM.POAddressScreen("VendorSave")
			THISFORM.POAddress_Screen("VendorSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgVendor.cmdPOSearchBuyFrom.Click
		Private matchCodes, nNewVendCode , lcCurrTable, cCompany
		nNewVendCode = 0
		matchCodes = 0
		
		lcCurrTable = ALIAS()
		cCompany = ShowSQLtxt(This.parent.parent.pgPODesc.txtCompany.Value,'Company',100)
		cCompany = ALLTRIM(cCompany)
		IF EMPTY( cCompany )
			cCompany = ShowSQLtxt(This.Parent.txtCompany.Value, 'Company',100)
		ENDIF
		
		DO FORM Forms\SearchForm WITH "Vendor", cCompany  TO nNewVendCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ENDIF
		ENDIF
		
		IF nNewVendCode > 0
			IF ThisForm.FillVendorAddr(nNewVendCode)
				*ThisForm.POAddressScreen("VendorEdit")
				ThisForm.POAddress_Screen("VendorEdit")
			ENDIF
			ThisForm.nVendCode = nNewVendCode
			
			PRIVATE cNewCompany, cOldCompany
			cNewCompany = getVendor_Company_VendCode(nNewVendCode)
			cOldCompany = ShowSQLtxt(This.parent.parent.pgPODesc.txtCompany.Value,'Company',100)
			
			IF NOT EMPTY(cOldCompany)
				IF NOT EMPTY(cNewCompany)
					IF UPPER(cNewCompany) <> UPPER(cOldCompany)
						MESSAGEBOX( "The buy from Company name was entered as '"+ALLTRIM(cOldCompany)+"'."+CHR(13)+"Buy from will be replace with '"+ALLTRIM(cNewCompany)+"'.",0+64,"Changed buy from Company name.")
						This.parent.parent.pgPODesc.txtCompany.Value = cNewCompany
						This.parent.parent.pgPODesc.lblVendCode.Caption = STR(nNewVendCode)
						This.parent.parent.pgPODesc.lblPeachID.Caption = getPeachID_VendCode(nNewVendCode)
						
						ThisForm.nVendCode = nNewVendCode
						ThisForm.nContactID = 0
					ENDIF
				ELSE
					*Empty NewCompany
				ENDIF
			ELSE
				*Empty OldCompany- just replace
				This.parent.parent.pgPODesc.txtCompany.Value = cNewCompany
				This.parent.parent.pgPODesc.lblVendCode.Caption = STR(nNewVendCode)
				This.parent.parent.pgPODesc.lblPeachID.Caption = getPeachID_VendCode(nNewVendCode)
				ThisForm.nVendCode = nNewVendCode
				ThisForm.nContactID = 0
			ENDIF
		ELSE
			*Nothing Choosen
			ThisForm.nVendCode = 0
			ThisForm.nContactID = 0
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgVendor.cmdSendPOconf.Click
		PRIVATE cPOitem, nHPAPO, cSalesP, cCover, cPOCompany
		cPOitem = ThisForm.cPOitem 
		nHPAPO	= VAL(cPOitem)
		cSalesP = This.parent.parent.pgPODesc.txtSalesP.Value
		cCover	= This.parent.parent.pgPODesc.txtCover.Value
		cPOCompany = This.parent.parent.pgPODesc.txtCompany.Value
		
		*!*	IF TYPE("LoginServer") != "C"
		*!*		IF "\MEM" $ SYS(2003)
		*!*			IF FILE(SYS(5)+SYS(2003)+"\"+"ERPSetup.mem")
		*!*				RESTORE FROM (SYS(5)+SYS(2003)+"\"+"ERPSetup.mem") ADDITIVE
		*!*			ELSE
		*!*				MESSAGEBOX("RESTORE FROM ERPSetup.mem ADDITIVE",0,"File Not Found!")
		*!*				RETURN .F.
		*!*			ENDIF
		*!*		ELSE	
		*!*			IF FILE(SYS(5)+SYS(2003)+"\MEM\"+"ERPSetup.mem")
		*!*				RESTORE FROM (SYS(5)+SYS(2003)+"\MEM\"+"ERPSetup.mem") ADDITIVE
		*!*			ELSE
		*!*				MESSAGEBOX("RESTORE FROM \MEM\ERPSetup.mem ADDITIVE",0,"File Not Found!")
		*!*				RETURN .F.
		*!*			ENDIF
		*!*		ENDIF	
		*!*		
		*!*	ENDIF
		
		IF nHPAPO = 0
			RETURN .F.
		ENDIF
		
		PRIVATE cEmailTo, nContactID
		cEmailTo = ""
		nContactID = ContactID_PO(nHPAPO,ThisForm.nConnhandle)
		IF nContactID = 0
			MESSAGEBOX("No Vendor Email Address!"+CHR(13)+"Vendor Contact was not saved to PO!",48,"Need Email address.")
			DO FORM Forms\GetNumber WITH cPOCompany, "EMAIL" TO cEmailTo
		ELSE
			cEmailTo = VendorContactEmail_ContactID(nContactID,ThisForm.nConnhandle)
		ENDIF
		IF EMPTY(cEmailTo)
			MESSAGEBOX("Did not get Vendor Email Address!"+CHR(13)+"Vendor Contact may not have been saved to PO!",48,"Need Email address.")
			DO FORM Forms\GetNumber WITH cPOCompany,"EMAIL" TO cEmailTo
		ENDIF
		
		IF EMPTY(cEmailTo)
			MESSAGEBOX("No Email Address",0+16,"Cannot procede")
			RETURN .F.
		ENDIF
		*******************************************
		
		PRIVATE cEmailFrom
		cEmailFrom	= ALLTRIM(SalesPEmail(cSalesP,cCover))  
		
		IF EMPTY(cEmailFrom)
			PRIVATE cUserName
			cUserName = SUBSTR(SYS(0),AT("#",SYS(0))+2)
			cEmailFrom	= ALLTRIM(AppSetup_Get_Email(cUserName))
		
			IF NOT EMPTY(cEmailFrom)
				IF MESSAGEBOX("Did not find an Email for the SalesP '"+cSalesP+"' or Cover '"+cCover+"'."+CHR(13)+"Do you want to send a Receipt Conformation request as"+CHR(13)+cUserName+" "+cEmailFrom+"?",4+32,"Send you You?")=6
					*Good
				ELSE
					cEmailFrom = get_Server_Email()
				ENDIF
			ELSE
				cEmailFrom = get_Server_Email()
			ENDIF
		ENDIF
		
		PRIVATE m.MsgNoteHTML
		m.MsgNoteHTML = CreateHTML_VendorPOConf(nHPAPO,ThisForm.nConnhandle)  &&Proc_Quotes
		
		PRIVATE m.MsgSubject 
		m.MsgSubject = "Purchase Order HPAlloy #"+ALLTRIM(STR(nHPAPO))
		m.MsgSubject = m.MsgSubject + HTML_PO(nHPApo,.F.)
		
		IF MESSAGEBOX("Are you sure want to Email this request for PO Confirmation?",4,"Send Email?") = 6
			Send_HTML_Email(cEmailTo, cEmailFrom, m.MsgSubject, m.MsgNoteHTML, ThisForm.nConnHandle, .T., .T.)   &&Proc_SQL
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgVendor.cmdShowVendors.Click
		PRIVATE m.Company, nVendCode
		nVendCode = PrepareSQLnum(ThisForm.nVendCode,'VendCode',-3)
		m.Company = ShowSQLtxt(This.Parent.txtCompany.Value,'Company',100)
		
		Private nTop
		
		IF nVendCode > 0
			nTop = ThisForm.Top  &&2008-08 Operator/operand type mismatch.
			ThisForm.Top = 400
			DO FORM Forms\Vendor.SCX WITH nVendCode 
			ThisForm.Top = nTop
		ELSE
			IF TYPE("m.Company") = "C"
				nTop = ThisForm.Top
				ThisForm.Top = 400
				IF !EMPTY(m.Company) 
					DO FORM Forms\Vendor.SCX WITH m.Company
				ELSE
					DO FORM Forms\Vendor.SCX
				ENDIF
				ThisForm.Top = nTop
			ELSE
				DO FORM Forms\Vendor.SCX
			ENDIF
		ENDIF
	ENDPROC

