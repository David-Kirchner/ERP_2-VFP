			ENDIF  && lSQLGood AND lNeedSave AND nMaster_ID > 0
			
		ENDIF	&& IF lPOSaveLst AND nShipWhere > 1
		
		*************************************
		*Save Process 'SELECTED'
		PRIVATE nSELECT_Proc_ID
		nSELECT_Proc_ID = 0
		
		IF lSQLgood AND nMaster_ID > 0 AND nID_Detail > 0 
			IF ( Proper_SO_item(cSOitem) <> Proper_SO_item('') AND NOT ( cSOItem == "LabService" OR cSOItem == "ConvertSVC" OR cSOItem == "Equipment" )) OR nWO > 0 
				IF NOT lEquipment OR NOT lServicesPO
					*check for SELECTED Process.
					
					cSQL = "SELECT ID_Detail_Process, ReceivingID FROM "
					DO CASE
					CASE cTBL = "S"
						cSQL = cSQL + "dbo.StockLst_Process WITH(NOLOCK) "
					CASE cTBL = "B"
						cSQL = cSQL + "dbo.BrokerLst_Process WITH(NOLOCK) "
					CASE cTBL = "W"
						cSQL = cSQL + "dbo.WIPLst_Process WITH(NOLOCK) "
					ENDCASE		
					cSQL = cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
					cSQL = cSQL + " AND PO_Item = dbo.f_ProperPOitem('"+cPoItem+"')"
					cSQL = cSQL + " AND ( Process_ID = 'SELECTED' )"
				
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmp_ID_Detail_Pro' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_ID_Detail_Pro")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmp_ID_Detail_Pro")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC,'tmp_ID_Detail_Pro')
					*	lSQLgood = .F.
					ELSE
						IF USED('tmp_ID_Detail_Pro')
							IF RECCOUNT('tmp_ID_Detail_Pro')>0
								nSELECT_Proc_ID = PrepareSQLnum(tmp_ID_Detail_Pro.ID_Detail_Process,'ID_Detail_Process',-3)
							ENDIF
						ENDIF
					ENDIF
					
					IF nSELECT_Proc_ID > 0
						*Update Selected Process
						DO CASE
						CASE cTBL = "S"
							cSQL_ProcUp = "UPDATE dbo.StockLst_Process SET "
						CASE cTBL = "B"
							cSQL_ProcUp = "UPDATE dbo.BrokerLst_Process SET "
						CASE cTBL = "W"
							cSQL_ProcUp = "UPDATE dbo.WIPLst_Process SET "
						ENDCASE
						
						cSQL_ProcUp = cSQL_ProcUp + " SOItem='"+cSOitem+"'"
						cSQL_ProcUp = cSQL_ProcUp + ",PO_Item='"+cPoItem+"'"
						cSQL_ProcUp = cSQL_ProcUp + ",SalesPerson='"+cSalesPerson+"'"
						cSQL_ProcUp = cSQL_ProcUp + ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
						cSQL_ProcUp = cSQL_ProcUp + ",Comment='"+cComment+"'"
						cSQL_ProcUp = cSQL_ProcUp + ",Process_ID='SELECTED'"	&&+cProcess_ID+"'"	
						cSQL_ProcUp = cSQL_ProcUp + ",Processor='"+cProcessor+"'"
						cSQL_ProcUp = cSQL_ProcUp + ",AllowSub='"+cAllowSub+"'"
						cSQL_ProcUp = cSQL_ProcUp + ",PU="+STR(nPU)+""
						cSQL_ProcUp = cSQL_ProcUp + ",QTY="+STR(nStockLst_QTY,18,4)+""
						cSQL_ProcUp = cSQL_ProcUp + ",Pounds="+STR(nPounds,9,1)+""
						cSQL_ProcUp = cSQL_ProcUp + ",ID_Detail="+STR(nID_Detail)+" "
		
						cSQL_ProcUp = cSQL_ProcUp + ",WO="+STR(nWO)+" "
						cSQL_ProcUp = cSQL_ProcUp + ",WO_Detail="+STR(nWO_Detail)+" "
						*cSQL_ProcUp = cSQL_ProcUp + ",QTY_Due="+STR(nQTY_Due,18,4)+""
						
						cSQL_ProcUp = cSQL_ProcUp + ",prc_Form='"+cprc_Form+"'"
						cSQL_ProcUp = cSQL_ProcUp + ",prc_PCs="+STR(nprc_PCs)+""
						cSQL_ProcUp = cSQL_ProcUp + ",prc_Dim1="+STR(nprc_Dim1,10,4)+""
						cSQL_ProcUp = cSQL_ProcUp + ",prc_Dim2="+STR(nprc_Dim2,9,3)+""
						cSQL_ProcUp = cSQL_ProcUp + ",prc_Dim3="+STR(nprc_Dim3,9,3)+""
						
						cSQL_ProcUp = cSQL_ProcUp + ",Ordered_QTY = "+STR(nStockLst_QTY,18,4)
						cSQL_ProcUp = cSQL_ProcUp + ",Ordered_P = "+STR(nStockLst_P,18,4)
							
						cSQL_ProcUp = cSQL_ProcUp + " WHERE ID_Detail_Process = "+ALLTRIM(STR( nSELECT_Proc_ID ))
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL_ProcUp,ThisForm.nConnHandle,nSQLEXEC )
							*lSQLgood = .F.
						ENDIF
						
					ELSE
						*Create
						**INSERT Create SELECTED StockLst_Process
						IF USED("tmpID_Detail_Process")
							USE IN tmpID_Detail_Process
						ENDIF
						
						cSQLi = "EXEC dbo.p_Lst_Process_ins "
						cSQLi = cSQLi + " @TBL = '"+cTBL+"'"
						cSQLi = cSQLi + ",@ID_Detail = "+STR(nID_Detail)+""
						cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
						cSQLi = cSQLi + ",@StartDate = '"+TTOC(DATETIME())+"'"	&&GetDate()"
						cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
						cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"   &&'Y' Computer does not Select the Stock!
						cSQLi = cSQLi + ",@PU	="+STR(nPU)
						cSQLi = cSQLi + ",@QTY	="+STR(nStockLst_QTY,18,4)
						cSQLi = cSQLi + ",@Pounds ="+STR(nPounds,9,1)
						
						cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
						cSQLi = cSQLi + ",@PO_item = '"+cPOitem+"'"
						cSQLi = cSQLi + ",@WO	= "+STR(nWO)
						cSQLi = cSQLi + ",@WO_Detail= "+STR(nWO_Detail)
							
						cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt('SELECTED','Process_ID',10)+"'"
						cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
						cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
						cSQLi = cSQLi + ",@ReceivingID ="+STR(0)
						
						cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
						cSQLi = cSQLi + ",@Prc_PCs  = "+STR(nPrc_PCs)
						cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
						cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
						cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
						
						cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nStockLst_QTY,18,4)
						cSQLi = cSQLi + ",@Ordered_P = "+STR(nStockLst_P,18,4)
							
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
						ENDDO
						IF nSQLEXEC < 0
							*retry
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 1' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
						*	=SQLROLLBACK(ThisForm.nConnHandle)
							SQLEXECError(cSQLi,ThisForm.nConnHandle,'tmpID_Detail_Process')
							TrackError("Could not EXEC dbo.p_"+TableName_TBL(cTBL)+"_Process_ins5","p_"+TableName_TBL(cTBL)+"_Process_ins","PurchaseOrder.SaveStockLst()",LINENO(1))
							*lSQLgood = .F.
						ELSE
							IF USED('tmpID_Detail_Process')
								nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.EXP,'ID_Detail_Process',-3)
								
								*Update Process with data not in Process_INS
								
								DO CASE
								CASE cTBL = "S"
									cSQL_ProcUp = "UPDATE dbo.StockLst_Process SET "
								CASE cTBL = "B"
									cSQL_ProcUp = "UPDATE dbo.BrokerLst_Process SET "
								CASE cTBL = "W"
									cSQL_ProcUp = "UPDATE dbo.WIPLst_Process SET "
								ENDCASE
								
								cSQL_ProcUp = cSQL_ProcUp + " WO="+STR(nWO)+" "
								cSQL_ProcUp = cSQL_ProcUp + ",WO_Detail="+STR(nWO_Detail)+" "
								*cSQL_ProcUp = cSQL_ProcUp + ",QTY_Due="+STR(nQTY_Due,18,4)+""
								
								cSQL_ProcUp = cSQL_ProcUp + ",prc_Form='"+cprc_Form+"'"
								cSQL_ProcUp = cSQL_ProcUp + ",prc_PCs="+STR(nprc_PCs)+""
								cSQL_ProcUp = cSQL_ProcUp + ",prc_Dim1="+STR(nprc_Dim1,10,4)+""
								cSQL_ProcUp = cSQL_ProcUp + ",prc_Dim2="+STR(nprc_Dim2,9,3)+""
								cSQL_ProcUp = cSQL_ProcUp + ",prc_Dim3="+STR(nprc_Dim3,9,3)+""
								
								cSQL_ProcUp = cSQL_ProcUp + ",Ordered_QTY = "+STR(nStockLst_QTY,18,4)
								cSQL_ProcUp = cSQL_ProcUp + ",Ordered_P = "+STR(nStockLst_P,18,4)
							
								cSQL_ProcUp = cSQL_ProcUp + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_ProcUp, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									SQLEXECError(cSQL_ProcUp,ThisForm.nConnHandle,nSQLEXEC )
									*lSQLgood = .F.
								ENDIF
							ELSE
								nID_Detail_Process = 0
							ENDIF
						ENDIF
						
					ENDIF
				ENDIF	
			ENDIF
		ENDIF
		
		****************************
		
		IF lPOSaveOK 
			IF lSQL_Manual 
				IF lSQLgood 
					=SQLCOMMIT(ThisForm.nConnHandle)
				ELSE
					=SQLROLLBACK(ThisForm.nConnHandle)
				ENDIF
				= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1) &&Set Auto transaction
			ENDIF
		ENDIF
		
		****************************
		
		IF lPOSaveOK 
			IF lPOSaveLst
				IF lSQLgood 
					*Find a place to store TBL back to dbo.PurchaseOrder
					IF LEN(cTBL)>0
						ThisForm.lblTBL.Caption = cTBL
							
						cSQL = "UPDATE dbo.PurchaseOrder SET TBL = '"+cTBL+"'"
						IF nID_Detail_Process > 0
							cSQL = cSQL + ", ID_Detail_Process = "+STR(nID_Detail_Process)
						ENDIF
						cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
						ELSE
							TrackMess( "Marked TBL as "+TableName_TBL(cTBL)+" for POitem = '"+cPOitem+"' in PurchaseOrder" )
						ENDIF
						
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		RETURN lPOSaveOK
		
	ENDPROC

	PROCEDURE save_podist
		*ThisFormSet.Save_PODist()
		
		
		PRIVATE nPO_SODist_ID, cSOitem, nPercent, nNew_QTY
		
		nPO_SODist_ID	= PrepareSQLnum(ThisForm.pgfPO.pgSOdist.txtPO_SODist_ID.Value,'PO_SODist_ID',-3)
		cSOitem			= PrepareSQLtxt(ThisForm.pgfPO.pgSOdist.txtSOitem.Value,'SOitem',10)
		nPercent		= PrepareSQLnum(ThisForm.pgfPO.pgSOdist.txtPercent.Value,'Percent',4,3)
		nNew_QTY		= PrepareSQLnum(ThisForm.pgfPO.pgSOdist.txtQTY.Value,'QTY',-5)
		
		
		PRIVATE cPOItem, nSO_QTY, nSO_P, nSO_Total, nSO_PU
		cPOItem = ThisForm.cPOitem
		nSO_QTY	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.VALUE,'StockLst_QTY',-5)
		nSO_P	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_P.VALUE,'StockLst_P',-5)
		nSO_Total = nSO_QTY * nSO_P
		nSO_PU = ThisForm.pgfPO.pgPODesc.cmbOrder_PU.VALUE
		
		
		PRIVATE nNew_QTYtotal
		nNew_QTYtotal = 0
		
		IF NOT EMPTY(cSOitem)
			cSOitem = Proper_SO_item(cSOitem)
		ELSE
			cSOitem = Proper_SO_item('')
		ENDIF
		
		IF cSOitem = Proper_SO_item('')
			MESSAGEBOX("Bad SOitem:"+cSOitem,16,"Cannot Save")
			RETURN .F.
		ENDIF
		
		*See if SoItem exists
		IF Count_SOIteminSales(cSOItem, ThisForm.nConnHandle) = 0
			MESSAGEBOX("Bad SOitem:"+cSOitem+CHR(13)+"Not Found!",16,"Cannot Save")
			RETURN .F.
		ENDIF
		
		IF nPercent <= 0 AND nNew_QTY = 0
			MESSAGEBOX("Must have a Quantity of Percent!",16,"cannot Save")
			RETURN .F.
		ENDIF
		
		**********
		IF nPercent = 0
			IF nNew_QTY > 0
				IF nSO_QTY > 0
					nPercent = nNew_QTY / nSO_QTY
				ELSE
					nPercent = 1
				ENDIF
			ELSE
				nPercent = 1
			ENDIF
		ELSE
			nPercent = 1
		ENDIF
		
		IF nNew_QTY = 0
			nNew_QTY = nSO_QTY * nPercent
		ENDIF
		 
		
		nSO_Total = nNew_QTY * nSO_P
		
		IF USED('tmpPO_SODist_ID')
			USE IN tmpPO_SODist_ID
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		IF nPO_SODist_ID > 0
			*UPDATE
			cSQL = "UPDATE dbo.PO_SOdist SET "
			cSQL = cSQL + "[POitem]='"+cPOItem +"'"
		    cSQL = cSQL + ",[SOitem]='"+cSOitem+"'"
		    cSQL = cSQL + ",[QTY]="+STR(nNew_QTY,18,4)
		    cSQL = cSQL + ",[P]="+STR(nSO_P,18,4)
		    cSQL = cSQL + ",[Total]="+STR(nSO_Total,18,4)
		    cSQL = cSQL + ",[who]=(suser_sname())"
			cSQL = cSQL + " WHERE ID="+STR(nPO_SODist_ID)
		ELSE
			nPO_SODist_ID = 0
			*INSERT
			cSQL="EXEC dbo.p_PO_SOdist_ins "
			cSQL = cSQL + " @POitem = '"+cPOitem+"'"
			cSQL = cSQL + ",@SOitem = '"+cSOitem+"'"
		    cSQL = cSQL + ",@QTY = "+STR(nNew_QTY,18,4)+""
		    cSQL = cSQL + ",@P = "+STR(nSO_P,18,4)+""
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_SODist_ID' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_SODist_ID' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_SODist_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_SODist_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC,'tmpPO_SODist_ID')
			RETURN .F.
		ENDIF
		
		IF nPO_SODist_ID = 0
			IF USED('tmpPO_SODist_ID')
				nPO_SODist_ID = tmpPO_SODist_ID.EXP
				USE IN tmpPO_SODist_ID
				ThisForm.pgfPO.pgSOdist.txtPO_SODist_ID.Value = nPO_SODist_ID
			ENDIF
		ENDIF
		
		****************
		PRIVATE nDist_QTY
		nDist_QTY = 0
		
		IF USED('tmpPO_DQTY')
			USE IN tmpPO_DQTY
		ENDIF
		
		cSQL = "SELECT SUM(QTY) AS nQTY"
		cSQL = cSQL + " FROM dbo.PO_SOdist WITH(NOLOCK) "
		cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		*cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"+" AND POitem = '"+cPOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_DQTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_DQTY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_DQTY' )
		ELSE
			IF USED('tmpPO_DQTY')
				IF RECCOUNT('tmpPO_DQTY') > 0
					nDist_QTY = PrepareSQLnum(tmpPO_DQTY.nQTY,'QTY',18,4)
					*This.txtDist_QTY.Value = nDist_QTY 
					ThisForm.pgfPO.pgSOdist.txtDist_QTY.Value = nDist_QTY 
				ENDIF
				USE IN tmpPO_DQTY
			ENDIF
		ENDIF
		
		****************
		ThisForm.pgfPO.pgSOdist.grdPO_SOdist.RecordSource = ''
		
		IF USED('tmpPO_Dist')
			USE IN tmpPO_Dist
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT [ID]"
		cSQL = cSQL + ",[POitem],[SOitem]"
		cSQL = cSQL + ",[QTY],[P],[Total],[PU]"
		cSQL = cSQL + ",[PO_P],[PO_QTY],[PO_PU],[PO_Total]"
		cSQL = cSQL + ",[SO_P],[SO_QTY],[SO_PU],[SO_Total]"
		cSQL = cSQL + ",[ReconcileTotal],[who],[WO]"
		cSQL = cSQL + " FROM dbo.PO_SOdist WITH(NOLOCK) "
		cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_Dist')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_Dist' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_Dist")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_Dist")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_Dist' )
		ELSE
			ThisForm.pgfPO.pgSOdist.grdPO_SOdist.RecordSource = 'tmpPO_Dist'
		ENDIF
		
		************************
		PRIVATE nDist_QTY
		nDist_QTY = 0
		
		IF USED('tmpPO_DQTY')
			USE IN tmpPO_DQTY
		ENDIF
		
		cSQL = "SELECT SUM(QTY) AS nQTY"
		cSQL = cSQL + " FROM dbo.PO_SOdist WITH(NOLOCK) "
		cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_DQTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_DQTY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_DQTY' )
		ELSE
			IF USED('tmpPO_DQTY')
				IF RECCOUNT('tmpPO_DQTY') > 0
					nDist_QTY = PrepareSQLnum(tmpPO_DQTY.nQTY,'QTY',18,4)
					ThisForm.pgfPO.pgSOdist.txtDist_QTY.Value = nDist_QTY 
				ENDIF
				USE IN tmpPO_DQTY
			ENDIF
		ENDIF
		
		**********************
		** Update SO costs
		*ID,POitem,SOitem,QTY,P,Total,[who]
		PRIVATE nSOitemPOCost, nHPAPO
		nSOitemPOCost = 0
		nHPAPO = 0 
		
		IF USED('tmpPO_Dist')
			SELECT tmpPO_Dist
			SCAN
				cSOitem		= PrepareSQLtxt(tmpPO_Dist.SOitem,'SOitem',10)
				nSOitemPOCost = PrepareSQLnum(tmpPO_Dist.Total,'Total',-5)
				
				IF cSOitem != Proper_SO_item("")
				
					cSQL = "UPDATE dbo.Sales SET POCost = "+STR(nSOitemPOCost,9,2)
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
					ENDIF	
						
					IF USED("SalesQuote")
						nHPAPO = VAL(POitem)
						SELECT SalesQuote
						REPLACE BuyCost WITH nSOitemPOCost FOR SOitem = cSOitem AND HPAPO = nHPAPO
					ENDIF
					
					IF USED("SalesTotal")
						SELECT SalesTotal
						REPLACE ItemPOCost WITH nSOitemPOCost FOR SOitem = cSOitem
					ENDIF
		
					SELECT tmpPO_Dist			
				ENDIF
			ENDSCAN
			
			LOCATE FOR ID = nPO_SODist_ID
		ENDIF
		
		**********************
		
		ThisForm.pgfPO.pgSOdist.txtDist_Total.Value	= ThisForm.pgfPO.pgSOdist.txtPO_P.Value * ThisForm.pgfPO.pgSOdist.txtDist_QTY.Value
		
		*ThisForm.pgfPO.pgSOdist.txtSO_P.Value	= nSO_P
		ThisForm.pgfPO.pgSOdist.txtSO_QTY.Value = nSO_QTY
		ThisForm.pgfPO.pgSOdist.txtSO_Total.Value = nSO_Total
	ENDPROC

	PROCEDURE setpoitems
		PARAMETERS pSOitem, pPOitem
		*ThisForm.SetPoItems(SOitem,POitem)
		*fills lstPoItems with PO's
		
		IF VARTYPE(pSOitem) != "C"
			pSOitem = ''
		ENDIF
		PRIVATE cSOitem 
		cSOitem = pSOitem
		
		ThisForm.lstPoItems.Clear
		
		IF VARTYPE(pPOitem) = 'C'
			IF Proper_SO_item(pSOitem) = Proper_SO_item("") 	&&Only use the PO
				IF Proper_PO_item(pPOitem) != Proper_PO_item("")
					ThisForm.lstPoItems.AddItem(pPOitem)
					ThisForm.cPOitem = pPOitem
					RETURN
				ENDIF
			ENDIF
		ENDIF
		
				
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpPoItems')
			USE IN tmpPoItems
		ENDIF
		
		cSQL = "SELECT TOP 99 POitem "
		cSQL = cSQL + " FROM dbo.PurchaseOrder "
		IF Proper_SO_item(cSOitem) != Proper_SO_item("")
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		ELSE
			cSQL = cSQL + " WHERE 0<0"
		ENDIF
		cSQL = cSQL + " ORDER BY POitem DESC "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPoItems')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPoItems')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpPoItems')
		ENDIF
		
		ThisForm.lstPoItems.Visible = .F.
		
		IF USED('tmpPoItems')
			IF RECCOUNT('tmpPoItems') > 0 
				
				ThisForm.lstPoItems.Visible = .T.		
				ThisForm.cPOitem = tmpPoItems.POitem
				
				SCAN
					ThisForm.lstPoItems.AddItem(tmpPoItems.POitem)
				ENDSCAN
				
			ENDIF
			USE IN tmpPoItems
		ENDIF
		
		ThisForm.lstPoItems.Value = ThisForm.cPOitem
		
		IF Proper_SO_item(cSOitem) != Proper_SO_item("")
			ThisForm.PgfPO.pgPODesc.txtSalesnum.Enabled = .F.
			ThisForm.PgfPO.pgPODesc.txtItem.Enabled 	= .F.
			ThisForm.PgfPO.pgPODesc.lblSalesNum.Enabled = .F.
		ELSE
			ThisForm.PgfPO.pgPODesc.lblSalesNum.Enabled = .T.
		ENDIF
		
	ENDPROC

	PROCEDURE setstocklst_qty
		*ThisForm.SetStockLst_QTY()
		
		*Called from lblPieces.Click, lblStockLst_QTY 
		
		
		PRIVATE nPieces,cAlloy,cForm,nThck,nSz2,nSz3
		nPieces	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
		cAlloy	= ShowSQLtxt(ThisForm.pgfPO.pgPODesc.txtAlloy.Value,'Alloy',12)
		IF LEN(cAlloy) = 0
			RETURN .F.
		ENDIF
		cForm	= ShowSQLtxt(ThisForm.pgfPO.pgPODesc.cmbForm.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtThck.Value,'Thck',10,4)
		IF nThck = 0
			RETURN .F.
		ENDIF
		nSz2	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSz2.Value,'Sz2',10,3)
		IF nSz2 = 0
			IF usesForm_Dim2(cForm, ThisForm.nConnHandle)
				RETURN .F.
			ENDIF
		ENDIF
		nSz3	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSz3.Value,'Sz3',10,3)
		
		IF nPieces = 0
			nPieces = 1
		ENDIF
		
		PRIVATE nLBS, nCurrLBS, nPounds
		nLBS 	 = PrepareSQLnum(GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,ThisForm.nConnHandle),'Pounds',9,1)
		nCurrLBS = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPounds.Value,'Pounds',9,1)
		
		DO CASE
		CASE nCurrLBS = 0
			ThisForm.pgfPO.pgPODesc.txtPounds.Value = nLBS
		CASE nLBS = 0
			IF nCurrLBS > 0
				ThisForm.pgfPO.pgPODesc.txtPounds.Value = nCurrLBS 
				nLBS = nCurrLBS 
			ELSE
				ThisForm.pgfPO.pgPODesc.txtPounds.Value = 0
			ENDIF
		CASE nCurrLBS*1.1 > nLBS AND nLBS*1.1 > nCurrLBS
			*within 10%
			ThisForm.pgfPO.pgPODesc.txtPounds.Value = nLBS
		CASE (nCurrLBS+5)*1.1 > nLBS AND (nLBS+5)*1.1 > nCurrLBS
			*within 10% when adusted with extra weight
			ThisForm.pgfPO.pgPODesc.txtPounds.Value = nLBS
		OTHERWISE
			PRIVATE lServicesPO, lOddCut
			lServicesPO = PrepareSQLlogic( ThisForm.pgfPO.pgPODesc.chkLab_Service.Value, 'ServicesPO',.F. )
			lOddCut		= PrepareSQLlogic(ThisForm.pgfPO.pgPOdesc.chkOddCut.VALUE,'OddCut',.F.)
			IF NOT lServicesPO 
				IF NOT lOddCut
					IF MESSAGEBOX("Calculated Pounds is more than 10% off."+CHR(13)+CHR(13)+"Calc:"+ALLTRIM(STR(nLBS,9,1))+CHR(13)+"Curr:"+ALLTRIM(STR(nCurrLBS,9,1))+CHR(13)+"Do you want to use new Pounds "+ALLTRIM(STR(nLBS,9,1))+"?" ,4,"Do you want to use new Pounds "+ALLTRIM(STR(nLBS,9,1))+"?")=6
						ThisForm.pgfPO.pgPODesc.txtPounds.Value = nLBS
					ENDIF
				ENDIF
			ENDIF
		ENDCASE	
		
		********************
		PRIVATE nS_PU
		nS_PU	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_PU.Value,'S_PU',-1)
		IF nS_PU = 0
			nS_PU	= GetPUfrom_POitem(ThisForm.cPOitem,ThisForm.nConnHandle) &&GetPUfromForm( cForm, ThisForm.nConnHandle )
		ENDIF
		
		PRIVATE lServicesPO, lConvServ, lEquipment
		lServicesPO = PrepareSQLlogic(ThisForm.pgfPO.pgPODesc.chkLab_Service.Value,'ServicesPO',.F. )
		lConvServ = PrepareSQLlogic(ThisForm.pgfPO.pgPODesc.chkConvServ.Value,'ConvServ',.F.)
		lEquipment = PrepareSQLlogic(ThisForm.pgfPO.pgPODesc.chkEquipment.Value,'Equipment',.F.)
		
		
		IF lServicesPO OR lConvServ OR lEquipment
			IF nS_PU = 3 OR nS_PU = 4
				*OK
			ELSE
				*Set to Lot
				nS_PU = 4
			ENDIF
		ENDIF
		
		
		PRIVATE nStockLst_QTY
		nStockLst_QTY = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_QTY,'StockLst_QTY',18,4)
		
		
		DO CASE
		*1 $/LB, 2 $/Ft, 3 $/PC, 4 $lot
		CASE nS_PU = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value	= nLBS
		CASE nS_PU = 2
			*FT
			PRIVATE nFtLen, nSigDim
			nFtLen = 0
			nSigDim = getSigDim(cForm, ThisForm.nConnHandle)
			IF nSigDim = 2
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz2/12
			ENDIF
			IF nSigDim = 3
				nFtLen = IIF(nPieces<1,1,nPieces) * nSz3/12
			ENDIF
					
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value	= ROUND(nFtLen,1)
			
		CASE nS_PU = 3
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value	= nPieces
		CASE nS_PU = 4
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value	= 1
		ENDCASE
	ENDPROC

	PROCEDURE shiptoclear
		*ThisForm.ShipToClear()
		ThisForm.POShipAddr = 0
		ThisForm.pgfPO.pgPOAddress.txtPOShipAddr.Value = 0
		ThisForm.pgfPO.pgPOAddress.txtCompany.VALUE	= ""
		ThisForm.pgfPO.pgPOAddress.txtAddr1.VALUE	= ""
		ThisForm.pgfPO.pgPOAddress.txtAddr2.VALUE	= ""
