	PROCEDURE pgfPO.pgPOAddress.Activate
		* Load estimated freight from dbo.PO_No when Ship to Addr tab gets focus
		PRIVATE nHpaPo, cSQL, nSQLEXEC, nEst
		nHpaPo = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtHpaPo.Value,'HPApo',-3)
		This.txtEst_Frght.Value = 0
		IF nHpaPo < 1
			RETURN
		ENDIF
		IF USED('tmpPO_EstFrght')
			USE IN tmpPO_EstFrght
		ENDIF
		cSQL = "SELECT ISNULL(Est_Frght,0) AS Est_Frght FROM dbo.PO_No WITH(NOLOCK) WHERE HPAPO = "+STR(nHpaPo)
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_EstFrght')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_EstFrght')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_EstFrght')
			RETURN
		ENDIF
		IF USED('tmpPO_EstFrght') AND RECCOUNT('tmpPO_EstFrght') > 0
			SELECT tmpPO_EstFrght
			GO TOP
			This.txtEst_Frght.Value = PrepareSQLnum(tmpPO_EstFrght.Est_Frght,'Est_Frght',12,2)
			USE IN tmpPO_EstFrght
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgPOAddress.Click
		ThisForm.POShipAddr = PrepareSQLnum(This.txtPOShipAddr.Value,'POShipAddr',-3)
		
	ENDPROC

	PROCEDURE pgfPO.pgPOAddress.cmbRemoteStock.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpRemoteStock')
			USE IN tmpRemoteStock
		ENDIF
		
		this.clear
		cSQL="SELECT [Location] FROM dbo.StockLst_Location WITH(NOLOCK) WHERE RemoteStock = 1"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRemoteStock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRemoteStock')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRemoteStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRemoteStock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpRemoteStock')
		ENDIF
		
		DIMENSION aRemoteStock(1)
		*aRemoteStock(1,1) = "1"
		*aRemoteStock(1,2) = "Anneal"
		
		IF USED('tmpRemoteStock')
			SELECT * FROM tmpRemoteStock INTO ARRAY aRemoteStock
			
			USE IN tmpRemoteStock
		ENDIF
		
		This.Clear
		This.ColumnCount = 1
		This.BoundColumn = 1
		This.ColumnWidths = "115"
		
		
		PRIVATE nArrayCount
		nArrayCount = 0
		IF TYPE('aRemoteStock(1)') # 'L'
			nArrayCount = ALEN(aRemoteStock,1)
		ENDIF
		FOR I = 1 TO nArrayCount
			this.addListitem(aRemoteStock(I, 1),I,1)
		ENDFOR
		
		this.addListitem("*",nArrayCount+1,1)
		This.NumberOfElements = nArrayCount + 1
		
		This.Value = "*"
		*This.Value = "1"
		
	ENDPROC

	PROCEDURE pgfPO.pgPOAddress.cmdClearShip.Click
		PRIVATE lcMessAns
		lcMessAns = 6
		PRIVATE nPOShipAddr
		nPOShipAddr = PrepareSQLnum(This.Parent.txtPOShipAddr.Value,'POShipAddr',-3)
		
		IF UPPER(This.Caption) = "CLEAR"
			IF nPOShipAddr > 0
				lcMessAns = MESSAGEBOX("Are you sure you want to Clear the Address?",4+32,"Address present.")
			ENDIF
		
			IF lcMessAns = 6
		
				ThisForm.ShowPOshipAddr(-1)
				
				*THISFORM.POAddressScreen("POShipToSave")
				THISFORM.POAddress_Screen("POShipToSave")
				THIS.PARENT.cmdPOSearchShipTo.ENABLED = .T.
		
			ENDIF	
		ELSE
			IF UPPER(This.Caption) = "ABORT"
			*OR IF UPPER(THIS.PARENT.cmdEditAddr.CAPTION) = "SAVE"
				lcMessAns = MESSAGEBOX("Do you wish to Abort the edit?"+CHR(13)+CHR(10)+"Abort will reset Address to original values.",4+32,"Address set for Editing.")
				IF lcMessAns = 6
					*Refill with old values
		
					IF USED( 'aShipAddr' )
						USE IN aShipAddr
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.ShipAddr "
					cSQL = cSQL + " WHERE ShipCode = "+STR(THISFORM.POShipAddr)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aShipAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aShipAddr")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 	
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
					ENDIF
					IF USED('aShipAddr')
						*thisform.ShipAddr = ShipAddr.ShipCode	
						THISFORM.POShipAddr = aShipAddr.ShipCode
						THIS.PARENT.txtPOShipAddr.VALUE = aShipAddr.ShipCode
						*THIS.PARENT.txtShipCode.VALUE	= aShipAddr.ShipCode
						THIS.PARENT.txtCompany.VALUE 	= aShipAddr.Company
						THIS.PARENT.txtAddr1.VALUE 		= aShipAddr.Addr1
						THIS.PARENT.txtAddr2.VALUE 		= aShipAddr.Addr2
						THIS.PARENT.txtCity.VALUE 		= aShipAddr.City
						THIS.PARENT.txtST.VALUE 		= aShipAddr.ST
						THIS.PARENT.txtZip.VALUE 		= aShipAddr.Zip
						THIS.PARENT.txtCountry.VALUE 	= aShipAddr.Country
						THIS.PARENT.txtContact.VALUE 	= aShipAddr.Contact
						THIS.PARENT.txtPhone.VALUE 		= aShipAddr.Telephone
						THIS.PARENT.txtFax.VALUE 		= aShipAddr.Fax_Number
						THIS.PARENT.txtEmail.VALUE 		= aShipAddr.Email
						THIS.PARENT.txtLastEdit.VALUE	= PrepareSQLdate(aShipAddr.LastEdit,'LastEdit',.F.,.T.)
						
						USE IN aShipAddr
					ENDIF
					
					*THISFORM.POAddressScreen("POShipToEdit")
					THISFORM.POAddress_Screen("POShipToEdit")
		
					ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
					ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Caption = "Edit"
					ThisForm.pgfPO.pgPOAddress.cmdClearShip.Caption = "Clear"
					ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
					
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgPOAddress.cmdEditAddr.Click
		PRIVATE	maxSoldCode, maxShipCode, oldSoldCode, SaveAddr, msettalk
		PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit, lnPOShipAddr 
		PRIVATE lcContact,lcPhone,lcFax,lcEmail
		
		lcCompany =THIS.PARENT.txtCompany.VALUE
		lcAddr1 = THIS.PARENT.txtAddr1.VALUE
		lcAddr2 = THIS.PARENT.txtAddr2.VALUE
		lcCity  = THIS.PARENT.txtCity.VALUE
		lcST    = THIS.PARENT.txtST.VALUE
		lcZip   = THIS.PARENT.txtZip.VALUE
		lcCountry = THIS.PARENT.txtCountry.VALUE
		lcContact = THIS.PARENT.txtContact.VALUE
		lcPhone	  = THIS.PARENT.txtPhone.VALUE
		lcFax	  = THIS.PARENT.txtFax.VALUE
		lcEmail	  = THIS.PARENT.txtEmail.VALUE
		ldLastEdit = DATE()
		
		*Check Data
		lcCompany	= PrepareSQLtxt( lcCompany,'Company',100 )
		lcAddr1		= PrepareSQLtxt( lcAddr1,'Addr1',100 )
		lcAddr2		= PrepareSQLtxt( lcAddr2,'Addr2',100 )
		lcCity		= PrepareSQLtxt( lcCity,'City',50 )
		lcST		= PrepareSQLtxt( lcST,'ST',50 )
		lcZip		= PrepareSQLtxt( lcZip,'Zip',50 )
		lcCountry	= PrepareSQLtxt( lcCountry,'Country',50 )
		lcContact	= PrepareSQLtxt( lcContact,'Contact',100 )
		lcPhone		= PrepareSQLtxt( lcPhone,'Phone',50 )
		lcFax		= PrepareSQLtxt( lcFax,'Fax', 12 )
		lcEmail		= PrepareSQLtxt( lcEmail,'Email', 60 )
		*ldLastEdit
		
		lnPOShipAddr = 0
		IF THISFORM.POShipAddr > 0
			lnPOShipAddr = THISFORM.POShipAddr
		ELSE
			IF ThisForm.POShipAddr > 0
				lnPOShipAddr = ThisForm.POShipAddr
			ELSE
				lnPOShipAddr = PrepareSQLnum( This.Parent.txtPOShipAddr.Value, 'ShipAddr', -3)
			ENDIF
		ENDIF
		
		*POShipAddr
		SaveAddr = .F.
		SaveAddress = .F.
		oldSoldCode = 0
		PRIVATE OLDSHIPCODE
		OLDSHIPCODE = 0
		
		IF THIS.CAPTION = "Save"
			** Do you have anything to save?
			IF NOT EMPTY(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))
				SaveAddress = .T.
			ENDIF
		
			IF EMPTY(lcCompany)
				MESSAGEBOX("Cannot save without an Company name!",0,'')
				SaveAddress = .F.
				RETURN .F.
			ENDIF
		
			IF USED('cntShipAddr')
				USE IN cntShipAddr
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT COUNT(*) AS CNT FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE ShipCode = "+STR(lnPOShipAddr)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
			ENDIF
		
			IF USED('cntShipAddr')
				IF cntShipAddr.CNT > 0
					SaveAddress = .T.
					*Already have exact Address
					IF EMPTY(THISFORM.POShipAddr)
						*Find the ShipCode and display it
		
						IF USED( 'shipcode_ShipAddr' )
							USE IN shipcode_ShipAddr
						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT shipcode FROM dbo.ShipAddr "
						cSQL = cSQL + " WHERE "
						cSQL = cSQL + "Company = '"+lcCompany+"' AND "
						cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
						cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
						cSQL = cSQL + "City  = '"+lcCity+"' AND "
						cSQL = cSQL + "ST    = '"+lcST+"' AND " 
						cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
						cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
						cSQL = cSQL + "Contact = '"+lcContact+"' AND "
						cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
						cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
						cSQL = cSQL + "Email = '"+lcEmail+"'"
		*				cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(lnPOShipAddr ))
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'shipcode_ShipAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'shipcode_ShipAddr' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "shipcode_ShipAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "shipcode_ShipAddr")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 				
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'shipcode_ShipAddr')
						ENDIF
						IF USED( 'shipcode_ShipAddr' )
							IF VARTYPE(shipcode_ShipAddr.shipcode) = "N"
								IF shipcode_ShipAddr.shipcode > 0
									THISFORM.POShipAddr = shipcode_ShipAddr.shipcode
									THIS.PARENT.txtPOShipAddr.REFRESH
								ENDIF			
							ENDIF
						
							USE IN shipcode_ShipAddr
						ENDIF
			
					ENDIF
				ELSE
					SaveAddress = .F.
				ENDIF
			ELSE
				SaveAddress = .F.
			ENDIF
			IF USED('cntShipAddr')
				USE IN cntShipAddr
			ENDIF
		
		
		
			IF SaveAddress
				****** big save procedure********
				PRIVATE	cSaveNew
		
				IF lnPOShipAddr > 0
					IF lnPOShipAddr < 6
						*DO NOT overwrite the HPA locations!
						MESSAGEBOX( "You cannot edit the default HPA address'!"+CHR(13)+"This address will be saved as a new Address Code.",0+48,'Create new address')
						cSaveNew = 6
					ELSE
						cSaveNew = MESSAGEBOX("Save as new Address?"+CHR(13)+"Use NO to be able to save the address edits in the next popup."+CHR(13)+"Only use a NEW address when old Company has moved -Not for edits."+CHR(13)+CHR(13)+"Save as new Address?",4+32,"Is this a New Address?")
					ENDIF
				ELSE
					**No SoldAddr- must save as new!
					cSaveNew = 6
				ENDIF
		
				IF cSaveNew = 6 && Yes, save as new
		
					*	Get maxSoldCode
					*maxSoldCode = THISFORM.maxSoldCode()
					*maxShipCode = THISFORM.maxShipCode()
					MaxSoldCode=get_MaxSoldCode()
					MaxShipCode=get_MaxShipCode()
					
					maxSoldCode= MAX( maxSoldCode, maxShipCode )
					maxSoldCode = maxSoldCode + 2 &&leave space for Shipto Edits
		
		*			IF NOT USED('ShipAddrCode')
		**				USE ShipAddrCode IN 0
		*			ENDIF
		
					IF lnPOShipAddr > 0
						*Check old ShipCode to see if anything changed
						IF USED( 'cntShipAddr' )
							USE IN cntShipAddr
						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS cnt FROM dbo.ShipAddr "
						cSQL = cSQL + " WHERE "
						cSQL = cSQL + "Company = '"+lcCompany+"' AND "
						cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
						cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
						cSQL = cSQL + "City  = '"+lcCity+"' AND "
						cSQL = cSQL + "ST    = '"+lcST+"' AND " 
						cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
						cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
						cSQL = cSQL + "Contact = '"+lcContact+"' AND "
						cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
						cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
						cSQL = cSQL + "Email = '"+lcEmail+"' "
		*				cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(THISFORM.POShipAddr))
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 	
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
						ENDIF
						IF USED('cntShipAddr')
							IF cntShipAddr.Cnt = 0
		*						no change - do not save
								SaveAddr = .F.
							ELSE &&did not match all Fields - Save
								SaveAddr = .T.
								oldShipCode = THISFORM.POShipAddr 
							ENDIF
						ELSE &&failed - add as new
							SaveAddr = .T.
						ENDIF 
					ELSE && No SoldCode just add new if have data
						IF LEN( ALLTRIM(THIS.PARENT.txtCompany.VALUE+THIS.PARENT.txtAddr1.VALUE)) > 1
							SaveAddr = .T.
						ELSE
							SaveAddr = .T.
						ENDIF
					ENDIF
		
		
					IF SaveAddr
						DO WHILE FoundShipCode( maxShipCode, ThisForm.nConnHandle )
							maxShipCode = maxShipCode + 1
						ENDDO
		
						THIS.PARENT.txtPOShipAddr.VALUE = maxShipCode
		*				THIS.PARENT.numSoldAddr.VALUE = maxSoldCode
						ThisForm.POShipAddr = maxSoldCode
		
						Save_ShipAddrCode(maxShipCode, ALLTRIM(STR(maxShipCode,10,0)), oldShipCode, ThisForm.nConnHandle)
						
						PRIVATE cSQLi
						cSQLi = "INSERT INTO dbo.ShipAddr (shipcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number, Email,Customer, LastEdit) VALUES "
						cSQLi = cSQLi+"("+STR(maxShipCode)+""
						cSQLi = cSQLi+",'"+lcCompany+"'"
						cSQLi = cSQLi+",'"+lcAddr1+"'"
						cSQLi = cSQLi+",'"+lcAddr2+"'"
						cSQLi = cSQLi+",'"+lcCity+"'"
						cSQLi = cSQLi+",'"+lcST+"'"
						cSQLi = cSQLi+",'"+lcZip+"'"
						cSQLi = cSQLi+",'"+lcCountry+"'"
						cSQLi = cSQLi+",'"+lcContact+"'"
						cSQLi = cSQLi+",'"+lcPhone+"'"
						cSQLi = cSQLi+",'"+lcFax+"'"
						cSQLi = cSQLi+",'"+lcEmail+"'"
						cSQLi = cSQLi+",''"		&&+STR(maxShipCode)+""
						cSQLi = cSQLi+",'"+IIF(EMPTY(ldLastEdit),'',DTOC(ldLastEdit))+"' )"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 	
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, '')
						ENDIF
						
		
						*THISFORM.UpdateCustID = .T.
		
						THIS.PARENT.txtLastEdit.VALUE = DATE()
						THIS.PARENT.txtLastEdit.REFRESH
		
					ENDIF
				ELSE
					*Save - not as new!
					*REPLACE DATA
		
		*!*	*			UPDATE ShipAddr SET ;
		*!*					Company = lcCompany, ;
		*!*					Addr1 = lcAddr1, ;
		*!*					Addr2 = lcAddr2, ;
		*!*					City  = lcCity, ;
		*!*					ST    = lcST, ;
		*!*					Zip   = lcZip, ;
		*!*					Country = lcCountry, ;
		*!*					Contact = lcContact, ;
		*!*					Telephone = lcPhone, ;
		*!*					Fax_Number = lcFax, ;
		*!*					Email = lcEmail, ;
		*!*					LastEdit = ldLastEdit ;
		*!*					WHERE shipcode =  lnPOShipAddr
		
					*	THISFORM.UpdateCustID = .T.
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.ShipAddr SET "
					cSQLu= cSQLu+"Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
					cSQLu= cSQLu+",Customer=''"
					cSQLu= cSQLu+",LastEdit='"+DTOC(DATE())+"'"
					cSQLu= cSQLu+" WHERE shipcode = "+STR(lnPOShipAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 	
					IF nSQLEXEC < 0
						SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
					ENDIF
					
					THIS.PARENT.txtLastEdit.VALUE = DATE()
					THIS.PARENT.txtLastEdit.REFRESH
		
				ENDIF
			ENDIF
			
		
			
			*THISFORM.POAddressScreen("POShipToEdit")
			THISFORM.POAddress_Screen("POShipToEdit")
		
		
		ELSE &&Caption was Edit
			*THISFORM.POAddressScreen("POShipToSave")
			THISFORM.POAddress_Screen("POShipToSave")
			THIS.PARENT.txtCompany.SETFOCUS()
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgPOAddress.cmdPOSearchShipTo.Click
		Private matchCodes, nNewShipToCode, lcCurrTable 
		nNewShipToCode = 0
		matchCodes = 0
		
		lcCurrTable = ALIAS()
		
		PRIVATE cCompany
		cCompany = This.Parent.txtCompany.Value
		
		IF EMPTY(cCompany)
			cCompany = This.Parent.cmbRemoteStock.Value 
			IF cCompany = "*"
				cCompany = ''
			ENDIF
		ENDIF	
		
		DO FORM Forms\SearchForm WITH "ShipAddr",cCompany  TO nNewShipToCode
		IF USED('TmpSearch')
			USE IN TmpSearch
			IF NOT EMPTY(lcCurrTable)
				SELECT (lcCurrTable)
			ENDIF
		EndIF
		
		IF nNewShipToCode > 0
			IF USED( 'aShipAddr' )
				USE IN aShipAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.ShipAddr "
			cSQL = cSQL + " WHERE ShipCode = "+STR(nNewShipToCode)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aShipAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
			ENDIF
					
			IF USED('aShipAddr') 
				ThisForm.POShipAddr = aShipAddr.ShipCode
				This.Parent.txtPOShipAddr.Value = aShipAddr.ShipCode
		*		This.Parent.numShipAddr.Value = aShipAddr
				This.Parent.txtCompany.Value = aShipAddr.Company
				This.Parent.txtAddr1.Value = aShipAddr.Addr1
				This.Parent.txtAddr2.Value = aShipAddr.Addr2
				This.Parent.txtCity.Value = aShipAddr.City
				This.Parent.txtST.Value = aShipAddr.ST
				This.Parent.txtZip.Value = aShipAddr.Zip
				This.Parent.txtCountry.Value = aShipAddr.Country
				This.Parent.txtContact.Value = aShipAddr.Contact
				This.Parent.txtPhone.Value = aShipAddr.Telephone
				This.Parent.txtFax.Value = aShipAddr.Fax_Number
				This.Parent.txtEmail.Value = aShipAddr.Email
				This.Parent.txtLastEdit.Value = PrepareSQLdate(aShipAddr.LastEdit,'LastEdit',.F.,.T.)
				
				*ThisForm.POAddressScreen("POShipToEdit")
				ThisForm.POAddress_Screen("POShipToEdit")
			EndIf
		
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPOAddress.opgPOShipTo.InteractiveChange
		*!*	PRIVATE cCompany, cCity
		*!*	cCompany = UPPER(ALLTRIM(This.Parent.txtCompany.Value))
		*!*	cCity	= UPPER(ALLTRIM(This.Parent.txtCity.Value))
		
		
		*!*	ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Visible = .T.
		*!*	ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Visible = .T.
		
		*!*	DO CASE
		*!*	CASE This.Value = 1
		*!*		IF NOT ( UPPER(cCompany) = "Space Alloys USA" AND UPPER(cCity) = "TIPTON" )
		*!*			ThisForm.POShipTO(1)
		*!*		ENDIF
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		*!*	CASE This.Value = 5
		*!*		IF NOT ( UPPER(cCompany) = "Space Alloys USA" AND UPPER(cCity) = "WINDFALL" )
		*!*			ThisForm.POShipTO(5)
		*!*		ENDIF
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
		*!*		
		*!*	OTHERWISE
		*!*	*!*		IF !EMPTY(cCompany)
		*!*	*!*			IF MESSAGEBOX( "Do you want to overwrite the current Address",4,"PO Ship to" ) = 6
		*!*	*!*				ThisForm.POShipTO( This.Value)
		*!*	*!*			ENDIF
		*!*	*!*		ELSE
		*!*	*!*			ThisForm.POShipTO( This.Value)
		*!*	*!*		ENDIF
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
		*!*		ThisForm.pf.pg_po.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
		*!*	ENDCASE
		
		ThisForm.ShipWhereChange(This.Value,This.Parent.txtCompany.Value,This.Parent.txtCity.Value)
		**-- ThisForm.ShipWhereChange UPDATES ThisForm.pgfPO.pgPODesc.cmbShipWhere.Value
		
		PRIVATE nShipWhere
		nShipWhere = This.Value
		
		DO CASE
		CASE nShipWhere = 1
			*ERP_Loc1
		*	This.parent.parent.pgDesc.cmbShipWhere
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 1
		CASE nShipWhere = 2
			*DIRECT
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 2
		CASE nShipWhere = 3
			*Blind
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 3
		CASE nShipWhere = 4
			*Service
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 4
		CASE nShipWhere = 5
			*ERP_Loc2
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 5
		CASE nShipWhere = 6
			*RemoteStock
			This.parent.parent.pgPODesc.cmbShipWhere.Value = 6
		ENDCASE
		This.parent.parent.pgPODesc.cmbShipWhere.Refresh
		
		*ThisForm.TestShipWhere(nShipWhere) called in cmbShipWhere
		
		*1 ERP_Loc1,2 DIRECT,3 Blind,4 Service,5 ERP_Loc2,6 RemoteStock
	ENDPROC

	PROCEDURE pgfPO.pgPOAddress.txtEst_Frght.LostFocus
		* Save estimated freight to dbo.PO_No.Est_Frght
		PRIVATE nHpaPo, nEst, cSQL, nSQLEXEC
		nHpaPo = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtHpaPo.Value,'HPApo',-3)
		IF nHpaPo < 1
			RETURN
		ENDIF
		nEst = PrepareSQLnum(This.Value,'Est_Frght',12,2)
		IF isPO_No_Exists(nHpaPo, ThisForm.nConnHandle)
			cSQL = "UPDATE dbo.PO_No SET Est_Frght = "+STR(nEst,12,2)+" WHERE HPAPO = "+STR(nHpaPo)
		ELSE
			cSQL = "INSERT INTO dbo.PO_No (HPAPO, PO_Rev, Changing, Printed, Cancelled, Est_Frght) VALUES ("
			cSQL = cSQL + STR(nHpaPo)+",0,0,0,0,"+STR(nEst,12,2)+")"
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.chkConvServ.InteractiveChange
		
		PRIVATE lServicesPO,lConvServ,lEquipment, lIntP
		lConvServ  = PrepareSQLlogic( This.Value, 'ConvServ',.F. )
		PRIVATE cForm
		cForm = ShowSQLtxt(This.parent.cmbForm.Value,'Form',2)
		lServicesPO = PrepareSQLlogic(This.parent.chkLab_Service.Value,'ServicesPO',.F.)
		lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
		lIntP	= PrepareSQLlogic(This.parent.chkIntP.Value,'IntP',.F.)
		
		This.parent.lblPerUnit.Caption	= FormUnitCaption(cForm,lServicesPO,lConvServ,lEquipment,lIntP,ThisForm.nConnHandle)
		
		IF This.parent.lblPerUnit.Caption = "$ Lot" OR This.parent.lblPerUnit.Caption = "$Lot"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to 1 for 1 LOT" NOWAIT
		ENDIF
		IF This.parent.lblPerUnit.Caption = "$/PC"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to number of Pieces" NOWAIT
		ENDIF
		
		
		**********************
		
		PRIVATE nHpaPo, nItemPo, cPoItem
		nHpaPo	= PrepareSQLnum(This.parent.txtHPApo.VALUE,'ERP PO',-3,0)
		nItemPo	= PrepareSQLnum(This.parent.txtItempo.VALUE,'Item PO',2,0)
		cPOItem = Proper_PO_item( STR(nHPApo)+"-"+STR(nItemPo,2,0) )
		
		PRIVATE nPieces
		nPieces = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
		IF nPieces = 0
			ThisForm.pgfPO.pgPODesc.txtPieces.Value = 1
		ENDIF
		
		***
		IF lConvServ 
			IF cPOItem <> Proper_PO_item('')
				PRIVATE cSQLu
				cSQLu = "UPDATE dbo.PurchaseOrder SET "
				cSQLu = cSQLu + " ConvServ="+IIF(lConvServ,'1','0')
				cSQLu = cSQLu + " WHERE PoItem = '"+cPOItem+"'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
				*	lPOSaveOK  = .F.
				ELSE
				ENDIF
				
				*After PO is updates, Check PU:
				ThisForm.Refresh_PU()
			ENDIF
		ENDIF
		
		PRIVATE nWO, nWO_Detail
		IF lConvServ 
			nWO = PrepareSQLnum(This.Parent.lblWOnum.Caption,'WO',-3)
			nWO_Detail = PrepareSQLnum(This.Parent.lblWO_Dnum.Caption,'WO_Detail',-3)
			IF nWO_Detail = 0
				nWO_Detail = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtWO_Detail.Value,'WO_Detail',-3)
			ENDIF	
			IF nWO = 0 AND nWO_Detail = 0
				*See if WO was Entered
				nWO = get_WO_from_POitem(cPOItem, ThisForm.nConnhandle )
				IF nWO > 0
					This.Parent.lblWOnum.Caption = STR(nWO)
					
				ELSE
					MESSAGEBOX("Please enter a WO when doing an Conversion Service"+CHR(13)+"HPA will be able to better track Inventory movement and cost.",0,"WO is Empty")
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.chkConvServ.Valid
		PRIVATE lServicesPO,lConvServ,lEquipment
		lConvServ  = PrepareSQLlogic(This.Value, 'ConvServ',.F. )
		lServicesPO = PrepareSQLlogic(This.parent.chkLab_Service.Value,'ServicesPO',.F.)
		lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
		
		************************
		IF lServicesPO AND lConvServ
			MESSAGEBOX("This PO item is listed for a Lab Sevices"+CHR(13)+"most likeley for a test report."+CHR(13)+CHR(13)+"This PO item is also listed as Conversion Service"+CHR(13)+"A Converion Service is where HPA Cuts, Forges or Changes the cusromers material."+CHR(13)+CHR(13)+"Both at the same time is not alowed!",48,"Cannot save this")
			This.Value = !This.Value
			RETURN .F.
		ENDIF
		
		IF lServicesPO AND lEquipment 
			MESSAGEBOX("This PO item is listed for a Lab Sevices"+CHR(13)+"most likeley for a test report."+CHR(13)+CHR(13)+"This PO item is also listed as Equipement"+CHR(13)+"Equipement is PO to bring in supplies or machines that are not to be stocked or sold."+CHR(13)+CHR(13)+"Both at the same time is not alowed!",48,"Cannot save this")
			This.Value = !This.Value
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.chkEquipment.InteractiveChange
		
		PRIVATE lServicesPO,lConvServ,lEquipment, lIntP
		lEquipment  = PrepareSQLlogic( This.Value, 'Equipment',.F. )
		PRIVATE cForm
		cForm = ShowSQLtxt(This.parent.cmbForm.Value,'Form',2)
		lServicesPO = PrepareSQLlogic(This.parent.chkLab_Service.Value,'ServicesPO',.F.)
		lConvServ = PrepareSQLlogic(This.parent.chkConvServ.Value,'ConvServ',.F.)
		lIntP	= PrepareSQLlogic(This.parent.chkIntP.Value,'IntP',.F.)
		
		This.parent.lblPerUnit.Caption	= FormUnitCaption(cForm,lServicesPO,lConvServ,lEquipment,lIntP,ThisForm.nConnHandle)
		
		IF This.parent.lblPerUnit.Caption = "$ Lot" OR This.parent.lblPerUnit.Caption = "$Lot"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to 1 for 1 LOT" NOWAIT
		ENDIF
		IF This.parent.lblPerUnit.Caption = "$/PC"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to number of Pieces" NOWAIT
		ENDIF
		
		IF lEquipment
			MESSAGEBOX("This POitem will not use the Alloy, Form or Sizes."+CHR(13)+"Please remember to describe this Item in the Description field.",0,"Equipment")
			
			PRIVATE nPieces
			nPieces = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
			IF nPieces = 0
				ThisForm.pgfPO.pgPODesc.txtPieces.Value = 1
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.chkEquipment.Valid
		PRIVATE lServicesPO,lConvServ,lEquipment
		lConvServ  = PrepareSQLlogic(This.parent.chkConvServ.Value, 'ConvServ',.F. )
		lServicesPO = PrepareSQLlogic(This.parent.chkLab_Service.Value,'ServicesPO',.F.)
		lEquipment = PrepareSQLlogic(This.Value,'Equipment',.F.)
		
		************************
		IF lServicesPO AND lConvServ
			MESSAGEBOX("This PO item is listed for a Lab Sevices"+CHR(13)+"most likeley for a test report."+CHR(13)+CHR(13)+"This PO item is also listed as Conversion Service"+CHR(13)+"A Converion Service is where HPA Cuts, Forges or Changes the cusromers material."+CHR(13)+CHR(13)+"Both at the same time is not alowed!",48,"Cannot save this")
			This.Value = !This.Value
			RETURN .F.
		ENDIF
		
		IF lServicesPO AND lEquipment 
			MESSAGEBOX("This PO item is listed for a Lab Sevices"+CHR(13)+"most likeley for a test report."+CHR(13)+CHR(13)+"This PO item is also listed as Equipement"+CHR(13)+"Equipement is PO to bring in supplies or machines that are not to be stocked or sold."+CHR(13)+CHR(13)+"Both at the same time is not alowed!",48,"Cannot save this")
			This.Value = !This.Value
			RETURN .F.
		ENDIF
		
		****
		IF lEquipment 
		*!*		PRIVATE nPieces
		*!*		nPieces = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
		*!*		IF nPieces = 0
		*!*			ThisForm.pgfPO.pgPODesc.txtPieces.Value = 1
		*!*		ENDIF
			
			***
			PRIVATE nOrder_PU, nOrder_P, nOrder_Qty
			nOrder_PU 	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.cmbOrder_PU.VALUE,'Order_PU',-1)
			nOrder_P	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.VALUE,'Order_P',-5)
			nOrder_Qty	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_Qty.VALUE,'Order_Qty',-5)
			IF nOrder_P = 0 OR nOrder_Qty = 0
				IF nOrder_PU <> 3
					*SET to Lot
					ThisForm.pgfPO.pgPODesc.cmbOrder_PU.Value = 3
				ENDIF
			ENDIF
			
			****
			PRIVATE	nHpaPo, nItemPo, cPoItem
			nHpaPo	= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtHPApo.VALUE,'ERP PO',-3,0)
			nItemPo	= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtItempo.VALUE,'Item PO',2,0)
			cPOItem = Proper_PO_item( STR(nHPApo)+"-"+STR(nItemPo,2,0) )
			
			IF cPOItem <> Proper_PO_item('')
				PRIVATE cSQLu
				cSQLu = "UPDATE dbo.PurchaseOrder SET "
				cSQLu = cSQLu + " Equipment="+IIF(lEquipment,'1','0')
				cSQLu = cSQLu + " WHERE PoItem = '"+cPOItem+"'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
				*	lPOSaveOK  = .F.
				ELSE
				ENDIF
				
				*After PO is updates, Check PU:
				ThisForm.Refresh_PU()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.chkIntP.InteractiveChange
		
		PRIVATE lIntP
		lIntP  = PrepareSQLlogic( This.Value, 'IntP',.F. )
		
		
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.chkLab_Service.InteractiveChange
		PRIVATE lServicesPO, cForm, lConvServ, lEquipment, lIntP
		lServicesPO = PrepareSQLlogic( This.Value, 'ServicesPO',.F. )
		cForm = ShowSQLtxt(This.parent.cmbForm.Value,'Form',2)
		lConvServ = PrepareSQLlogic(This.parent.chkConvServ.Value,'ConvServ',.F.)
		lEquipment = PrepareSQLlogic(This.parent.chkEquipment.Value,'Equipment',.F.)
		lIntP	= PrepareSQLlogic(This.parent.chkIntP.Value,'IntP',.F.)
		
		This.parent.lblPerUnit.Caption	= FormUnitCaption(cForm,lServicesPO,lConvServ,lEquipment,lIntP,ThisForm.nConnHandle)
		
		IF This.parent.lblPerUnit.Caption = "$ Lot" OR This.parent.lblPerUnit.Caption = "$Lot"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to 1 for 1 LOT" NOWAIT
		ENDIF
		IF This.parent.lblPerUnit.Caption = "$/PC"
			*This.Parent.txtStockLst_QTY.Value = 1
			ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
			ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'S_P',-5)
			
			WAIT WINDOW "'Stk QTY' was set to number of Pieces" NOWAIT
		ENDIF
		
		IF lServicesPO 
			MESSAGEBOX("This POitem will not use the Alloy, Form or Sizes."+CHR(13)+"Please remember to describe this Item in the Description field.",0,"Equipment")
		ENDIF
	ENDPROC

	PROCEDURE pgfPO.pgPODesc.chkLab_Service.Valid
		*PurchaseOrder.Services or LabServices
