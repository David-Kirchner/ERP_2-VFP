	PROCEDURE chkCancelPO.InteractiveChange
		PRIVATE nHpaPo, lOk, cPOitem
		nHpaPo = PrepareSQLnum(This.Parent.pgfPO.pgPODesc.txtHpapo.Value,'HPAPO',-3)
		nItemPO = PrepareSQLtxt(This.Parent.pgfPO.pgPODesc.txtItempo.Value,'ItemPO',2)
		*ThisForm.cpoitem
		
		lOk = .T.
		
		IF nHpaPo > 0
			IF NOT PrepareSQLlogic(This.Value,'CancelPO') 
				IF MESSAGEBOX("Are you sure you want to Un-Cancel This PO?",4)= 6
					lOk = THISFORM.PO_Cancel("UNCANCEL")
				ELSE
					THIS.Value = 1
					lOk = .F.
				ENDIF
			ELSE
				IF MESSAGEBOX("Are you sure you want to Cancel This PO Item?",4)= 6
					lOk = THISFORM.PO_Cancel("CANCEL")
				ELSE
					THIS.Value = 0
					lOk = .F.
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX( "No PO Number to cancel!",48,"Cannot Cancel")
			lOk = .F.
		ENDIF
		
		IF lOK
			*Change Screen
			This.Parent.cmdPOEdit.Caption = "Save PO"
			This.Parent.cmdPOEdit.Enabled = .T.
			*This.Parent.cmdPODelete.Caption = "Cancel" 	
			This.Parent.cmdPODelete.Caption = "Abort" 	
			This.Parent.cmdPODelete.Enabled = .T.
		ENDIF
		
		This.Refresh
	ENDPROC

	PROCEDURE cmdPOAdd.Click
		PRIVATE nCurrHPAPO, nMess
		
		IF ThisForm.EditSalesOrder 
			*Called From SalesOrder
			ThisForm.MakeNewPOitem('',.F.,.F.)  &&This Code asks for Clone if has SalesNum.
			
		ELSE
			*SAVE PO
			nCurrHPAPO = VAL(ThisForm.cPOitem)
			IF nCurrHPAPO > 0
				nMess = MESSAGEBOX("Do you want to add another ITEM to this PO "+ALLTRIM(STR(nCurrHPAPO))+" ?",4+32,"Add Another Item?") 
				IF nMess = 6
					ThisForm.MakeNewPOitem(ThisForm.cPOitem,.F.,.T.)
				ELSE
					nMess = MESSAGEBOX("Do you want to CLONE from this PO "+ALLTRIM(STR(nCurrHPAPO))+" ?",4+32,"Clone to another PO?")
					IF nMess = 6
						ThisForm.MakeNewPOitem(ThisForm.cPOitem,.T.,.F.)
					ELSE
						ThisForm.MakeNewPOitem('',.F.,.F.)
					ENDIF	
				ENDIF
		
			ELSE
				*Does SO use a PO -may not be a current
				PRIVATE cPOs, nCountPOs
				cPOs = Get_POinPurchaseOrder_SalesNum(ThisForm.SalesNum, ThisForm.nConnHandle )
				nCountPOs = OCCURS(",",cPOs)
				IF nCountPOs = 0
					ThisForm.MakeNewPOitem()
				ELSE
					IF nCountPOs = 1
						PRIVATE nPO
						nPO = VAL(cPOs)
						
						nMess = MESSAGEBOX("Do you want to add another ITEM to the PO "+ALLTRIM(STR(nPO))+"?",4+32,"Add Another Item?") 
						IF nMess = 6
							cClonePOitem = Proper_PO_item(STR(nPO)+"-01" )
							ThisForm.MakeNewPOitem(cClonePOitem,.F.,.T.)
						ELSE
							ThisForm.MakeNewPOitem()
						ENDIF		
					ELSE
						*Have muliple POs
						nMess = MESSAGEBOX("Do you want to add another ITEM an existing PO?"+CHR(13)+cPOs+CHR(13)+CHR(13)+"Answer Yes to select which PO to add to."+CHR(13)+"Answer No to create a NEW PO.",4+32,"Add Another PO Item?") 
						IF nMess = 6
							DO FORM "Forms\SelectPO_item.scx" WITH nSalesNum TO cPOItem
							ThisForm.MakeNewPOitem(cPOItem,.F.,.T.)
						ELSE
							ThisForm.MakeNewPOitem()
						ENDIF		
						
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdPODelete.Click
		IF THIS.CAPTION = "Delete"
			THISFORM.PO_Cancel("DELETE")
			*THISFORM.POScreen("CLEAR")
		ELSE
		
			*IF THIS.CAPTION = "Cancel" 
			IF THIS.CAPTION = "Abort" &&"ABORT SAVE"
			IF MESSAGEBOX("Do you want to IGNORE any changes since last save?",4+32,"Cancel Edit")=6
				
				*Notify if WO is needed anyway
				ThisForm.Notify_WO()
				
				PRIVATE nHpaPo
				nHpaPo = PrepareSQLnum(This.Parent.pgfPO.pgPODesc.txtHpapo.VALUE,'HPAPO',-3)
				
				IF nHpaPo > 0
					*Does PO_No Changing need to be reset to 0?
					**********************
					PRIVATE cSQL, nSQLEXEC
					
					IF isPO_No_Exists(nHPAPO,ThisForm.nConnHandle) 
						cSQL = "UPDATE dbo.PO_No SET "
						cSQL = cSQL + " [Changing] = 0"  &&Cancel Edit
						cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
					ELSE
						cSQL = "INSERT INTO dbo.PO_No  "
						cSQL = cSQL + " (HPAPO,[Changing]) VALUES "
						cSQL = cSQL + "("+STR(nHPAPO)+",0"
						cSQL = cSQL + ")"
					ENDIF
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
					ELSE
						TrackMess( "Marked as NOT Changing for HPAPO:"+STR(nHPAPO)+" in PO_No -Edit was Aborted." )
					ENDIF
				ENDIF		
				**********************
						
				PRIVATE cPOitem,cSOitem
				cPOitem = Proper_PO_item(ThisForm.cPOitem)
		*		cSOitem = Proper_SO_item(ThisForm.cSOitem)
			
				ThisForm.PO_NewAdd = .F.
				ThisForm.PO_NewClone = .F.
				ThisForm.POEditing = .F.
		
				THISFORM.POScreen("DISABLE")
				*THISFORM.POScreen("CLEAR") &&redundant -fixed within Show_frmPO() call
				
				ThisForm.cPOitem = cPOitem 
		*		ThisForm.cSOitem = cSOitem 
				
				This.Parent.cmdPOEdit.Caption = "Edit PO"
				IF Proper_PO_Item(cPOitem) != Proper_PO_item("")
					This.Parent.cmdPOEdit.Enabled = .T.
				ENDIF
				
				THISFORM.Show_frmPO()
				THISFORM.POTestingScreen("DISABLE") &&Show_frmPO calls ShowPOitem calls POTestingScreen(POitem)
				This.Caption = "Delete"
				
			ENDIF
		  ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdPOEdit.Click
		IF THIS.CAPTION = "Save PO"
			IF THISFORM.PO_VALID("SAVE")
				IF ThisForm.PO_SaveAdd("SAVE")
					ThisForm.Notify_WO()
					ThisForm.PO_NewAdd = .F.
					ThisForm.PO_NewClone = .F.
					ThisForm.POEditing = .F.
					THISFORM.POScreen("DISABLE")
					*ThisForm.Show_frmPO() -Done in PO_SaveAdd()
				ELSE
					ThisForm.PO_NewAdd = .F.
					ThisForm.PO_NewClone = .F.
					ThisForm.POEditing = .T.
					THISFORM.POScreen("ENABLE")
					THISFORM.PO_VALID("EDIT")	
					*ThisForm.PO_SaveAdd("EDIT")
					This.Caption = "Edit PO"
				ENDIF
			ELSE
				*retry
				*ThisForm.ShowPOitem(ThisForm.cPOitem)
				PRIVATE nHPApo, nPOitem_item, lcPOitem 
				nHPApo		= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtHpaPo.VALUE,'HPApo',-3)
				nPOitem_item = PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtItemPo.VALUE,'POitem_item',2)
				lcPOitem = Proper_PO_item( ALLTRIM(STR(nHPApo))+"-"+STR(nPOitem_item) )
				
				IF lcPOitem = Proper_PO_Item( '' )
					MESSAGEBOX("Did not get a PO item!",48,"Nothing to do")
				ELSE
					ThisForm.ShowPOitem(lcPOitem)
				ENDIF
			ENDIF
		ELSE
			*Edit PO
			IF THIS.CAPTION = "Edit PO"
				IF Proper_PO_Item(ThisForm.cPOitem) = Proper_PO_Item('')
					MESSAGEBOX("Did not get a PO item!",48,"No PO to Show")
					RETURN .F.
				ELSE
					ThisForm.PO_NewAdd = .F.
					ThisForm.PO_NewClone = .F.
					ThisForm.POEditing = .T.
					
					ThisForm.ShowPOitem(ThisForm.cPOitem)
		
					THISFORM.POScreen("ENABLE")
					THISFORM.PO_VALID("EDIT")
				ENDIF		
			ENDIF
		ENDIF
		
	ENDPROC

