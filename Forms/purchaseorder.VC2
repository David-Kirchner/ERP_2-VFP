	ENDPROC

	PROCEDURE shipwherechange
		PARAMETERS nShipWhere,cCompany,cCity
		*ThisForm.ShipWhereChange(nShipWhere,cCompany,cCity)
		
		IF VARTYPE( nShipWhere ) != 'N'
			nShipWhere = 1
		ENDIF
		
		PRIVATE cCompany, cCity, cForm, cBranchInit 
		cCompany = ShowSQLtxt(cCompany,'Company',100)
		cCity	= ShowSQLtxt(cCity,'City',30)
		cForm 		= PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.cmbForm.Value,'Form',2)
		cBranchInit = GetBRANCHfromForm (cForm, ThisForm.nConnHandle )
		
		cCompany = UPPER(ALLTRIM(cCompany))
		cCity	= UPPER(ALLTRIM(cCity))
		
		
		ThisForm.pgfPO.pgPOAddress.cmdClearShip.Visible = .T.
		ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Visible = .T.
		*ThisForm.pgfPO.pgPOAddress.cmbRemoteStock.Visible = .F.
		ThisForm.pgfPO.pgPOAddress.cmbRemoteStock.Enabled = .F.
		
		*1 ERP_Loc1,2 DIRECT,3Direct Blind,4 Service,5 ERP_Loc2,6 RemoteStock
		DO CASE
		CASE nShipWhere = 1
			IF NOT ( cCompany = "Space Alloys USA" AND cCity = "TIPTON" )
				ThisForm.POShipTO(1)
			ENDIF
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			*ERP_Loc1
			ThisForm.pgfPO.pgPODesc.cmbShipWhere.Value = 1
			
			IF cBranchInit = "W"
				MESSAGEBOX( "Windfall is the typical receiving shop for this form '"+cForm+"'"+CHR(13)+"Please Check the ShipWhere", 0+64,"Please Check the ShipWhere")
			ENDIF
		CASE nShipWhere = 2
			*Use Customers Address
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			*DIRECT to Customer
			ThisForm.pgfPO.pgPODesc.cmbShipWhere.Value = 2
		*	IF cCompany = "Space Alloys USA" 
				ThisForm.POShipTO(2)
		*	ENDIF
		CASE nShipWhere = 3
			*Use Customers Address
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			*Blind
			ThisForm.pgfPO.pgPODesc.cmbShipWhere.Value = 3
		*	IF cCompany = "Space Alloys USA" 
				ThisForm.POShipTO(3)
		*	ENDIF
		CASE nShipWhere = 4
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			*Service
			ThisForm.pgfPO.pgPODesc.cmbShipWhere.Value = 4
		*	IF cCompany = "Space Alloys USA" 
				ThisForm.POShipTO(4)
		*	ENDIF
		
		CASE nShipWhere = 5
			IF NOT ( cCompany = "Space Alloys USA" AND cCity = "WINDFALL" )
				ThisForm.POShipTO(5)
			ENDIF
			IF cBranchInit = "T"
				MESSAGEBOX( "Tipton is the typical receiving shop for this form '"+cForm+"'"+CHR(13)+"Please Check the ShipWhere", 0+64,"Please Check the ShipWhere")
			ENDIF
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .F.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .F.
			*ERP_Loc2
			ThisForm.pgfPO.pgPODesc.cmbShipWhere.Value = 5
			
		CASE nShipWhere = 6
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			*Remote Stock
			ThisForm.pgfPO.pgPODesc.cmbShipWhere.Value = 6
		
			ThisForm.pgfPO.pgPOAddress.cmbRemoteStock.Visible = .T.
			ThisForm.pgfPO.pgPOAddress.cmbRemoteStock.Enabled = .T.
		*	IF cCompany = "Space Alloys USA" 
				ThisForm.POShipTO(6)
		*	ENDIF
			
		OTHERWISE
			IF cCompany != "Space Alloys USA"
				IF !EMPTY(cCompany)
					IF MESSAGEBOX( "Are you sure you DO NOT want to ship to HPA ?",4,"PO Ship to" ) = 6
						ThisForm.POShipTO( nShipWhere )
					ELSE
						ThisForm.POShipTO( ThisForm.pgfPO.pgPODesc.cmbShipWhere.Value )
					ENDIF
				ELSE
					ThisForm.POShipTO( nShipWhere )
				ENDIF
			ELSE
				ThisForm.POShipTO( nShipWhere )
			ENDIF
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
		ENDCASE
		
		
	ENDPROC

	PROCEDURE showpoitem		&& Reads SQL and places as Value
		PARAMETERS pPOitem
		*ThisForm.ShowPOitem(cPOitem)
		
		IF TYPE("pPOitem") != "C"
		*	Error
			MESSAGEBOX("ShowPOitem did not receive the POitem",48,"Procedure Error")
			TrackError("ShowPOitem did not receive the parameter POitem","Error","PurchaseOrder:ShowPOitem",LINENO(1))
			RETURN .F.
		ENDIF
		
		IF EMPTY(pPOitem)
			MESSAGEBOX("ShowPOitem did not receive the POitem",48,"Procedure Error")
			TrackError("ShowPOitem did not receive the parameter POitem - Empty.","Error","PurchaseOrder:ShowPOitem",LINENO(1))
			RETURN .F.
		ENDIF
		PRIVATE cPOitem
		cPOitem = Proper_PO_item( pPOitem )
		
		PRIVATE nCntPOitem
		nCntPOitem = 0
		
		IF USED('cntPO')
			USE IN cntPO
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntPO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'cntPO' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'cntPO' )
		ENDIF
		
		IF USED('cntPO')
			nCntPOitem = cntPO.CNTD
			USE IN cntPO
		ENDIF
		
		IF nCntPOitem > 0
			IF USED('tmpPO')
				USE IN tmpPO
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT * FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpPO')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'tmpPO' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'tmpPO' )
			ENDIF
		
			IF USED('tmpPO')
				IF NOT EOF('tmpPO')
					*IF NOT ThisForm.PO_NewAdd AND NOT ThisForm.POEditing 
					IF ThisForm.EditSalesOrder
						*Cloned, do not change SOitem
					ELSE
						PRIVATE nSalesNum
						nSalesNum = PrepareSQLnum(tmpPO.SalesNum,'SalesNum',-3)
						IF nSalesNum > 0
							THISFORM.pgfPO.pgPOdesc.txtSalesNum.VALUE 	= nSalesNum
							ThisForm.SalesNum 							= nSalesNum 
							THISFORM.pgfPO.pgPOdesc.txtItem.VALUE		= PrepareSQLnum(tmpPO.ITEM,'Item',2,0)
							ThisForm.cSOitem = Proper_SO_item(STR(nSalesNum)+"-"+PrepareSQLtxt(tmpPO.ITEM,'Item',2) )
						ELSE	
							THISFORM.pgfPO.pgPOdesc.txtSalesNum.VALUE 	= 0
							ThisForm.SalesNum = 0
						ENDIF
					ENDIF
					THISFORM.pgfPO.pgPOdesc.txtHpaPo.VALUE		= PrepareSQLnum(tmpPO.HPAPo,'HPAPO',-3)
					THISFORM.pgfPO.pgPOdesc.txtItempo.VALUE		= PrepareSQLnum(tmpPO.ItemPO,'ItemPO',2,0)
					THISFORM.pgfPO.pgPOdesc.txtPO_Rev.VALUE		= ALLTRIM(STR( getPO_NO_Rev(tmpPO.HPAPo,THISFORM.nConnHandle) ))
					THISFORM.cPOitem 							= PrepareSQLtxt(tmpPO.POitem,'POitem',12)
					ThisForm.pgfPO.pgPODesc.lblWOnum.Caption	= STR(PrepareSQLnum(tmpPO.WO,'WO',-3))
					ThisForm.pgfPO.pgPODesc.lblWO_Dnum.Caption	= STR(PrepareSQLnum(tmpPO.WO_Detail,'WO_Detail',-3))
					ThisForm.pgfPO.pgPODesc.txtWO_Detail.Value	= PrepareSQLnum(tmpPO.WO_Detail,'WO_Detail',-3)
		
					THISFORM.pgfPO.pgPOdesc.txtCompany.VALUE	= ShowSQLtxt(tmpPO.Company,'Company',100)
					THISFORM.pgfPO.pgPOdesc.txtSalesP.VALUE		= ShowSQLtxt(tmpPO.SalesP,'SalesP',1)
					THISFORM.pgfPO.pgPOdesc.txtCover.VALUE		= ShowSQLtxt(tmpPO.Cover,'Cover',1)
		
					THISFORM.pgfPO.pgPOdesc.txtPieces.VALUE		= PrepareSQLnum(tmpPO.Pieces,'Pieces',6,0)
					THISFORM.pgfPO.pgPOdesc.txtAlloy.VALUE		= ShowSQLtxt(tmpPO.Alloy,'Alloy',12)
					THISFORM.pgfPO.pgPOdesc.cmbForm.VALUE		= ShowSQLtxt(tmpPO.FORM,'Form',2)
					THISFORM.pgfPO.pgPOdesc.cmbCC.VALUE			= ShowSQLtxt(tmpPO.CC,'CC',1)
					THISFORM.pgfPO.pgPOdesc.cmbCL.VALUE			= ShowSQLtxt(tmpPO.CL,'CL',1)
					THISFORM.pgfPO.pgPOdesc.txtThck.VALUE		= PrepareSQLnum(tmpPO.Thck,'Thck',10,4)
					THISFORM.pgfPO.pgPOdesc.txtSz2.VALUE		= PrepareSQLnum(tmpPO.Sz2,'Sz2',10,3)
					THISFORM.pgfPO.pgPOdesc.txtSz3.VALUE		= PrepareSQLnum(tmpPO.Sz3,'Sz3',10,3)
					THISFORM.pgfPO.pgPOdesc.chkRandLen.VALUE	= PrepareSQLchk(tmpPO.RandLen,'RandLen')
					THISFORM.pgfPO.pgPOdesc.chkMetric.VALUE		= PrepareSQLchk(tmpPO.Metric,'Metric')
					THISFORM.pgfPO.pgPOdesc.chkOddCut.VALUE		= PrepareSQLchk(tmpPO.OddCut,'OddCut')
		*depricated
					ThisForm.pgfPO.pgPODesc.txtP_lb.VALUE		= PrepareSQLnum(tmpPO.P_lb,'P_Lb',10,2)
					ThisForm.pgfPO.pgPODesc.txtP_pc.VALUE		= PrepareSQLnum(tmpPO.P_pc,'P_Pc',10,2)
					ThisForm.pgfPO.pgPODesc.txtP_ft.VALUE		= PrepareSQLnum(tmpPO.P_ft,'P_Ft',10,2)
					ThisForm.pgfPO.pgPODesc.txtLotP.VALUE		= PrepareSQLnum(tmpPO.LotP,'LotP',10,2)
		*depricated
					THISFORM.pgfPO.pgPOdesc.txtStockLst_QTY.VALUE	= PrepareSQLnum(tmpPO.StockLst_QTY,'StockLst_QTY',-5)
					THISFORM.pgfPO.pgPOdesc.txtStockLst_P.VALUE		= PrepareSQLnum(tmpPO.StockLst_P,'StockLst_P',-5)
					ThisForm.pgfPO.pgPODesc.txtStockLst_PU.VALUE	= PrepareSQLnum(tmpPO.StockLst_PU,'StockLst_PU',-1)
					
					THISFORM.pgfPO.pgPOdesc.lblPerUnit.CAPTION	= FormUnitCaption(tmpPO.FORM,tmpPO.Services,tmpPO.ConvServ,tmpPO.Equipment,tmpPO.IntP, THISFORM.nConnHandle)
		*IF GetPUfromForm(tmpPO.Form, ThisForm.nConnHandle)
		
					THISFORM.pgfPO.pgPOdesc.txtOrder_Qty.VALUE	= PrepareSQLnum(tmpPO.Order_Qty,'Order_QTY',-5)
					THISFORM.pgfPO.pgPOdesc.txtOrder_P.VALUE	= PrepareSQLnum(tmpPO.Order_P,'Order_P',-5)
					THISFORM.pgfPO.pgPOdesc.cmbOrder_PU.VALUE	= PrepareSQLtxt(tmpPO.Order_PU,'Order_PU',1)
					THISFORM.pgfPO.pgPOdesc.lblUnitText.CAPTION	= Get_cPUfrom_nPU(tmpPO.Order_PU)
		
					ThisForm.pgfPO.pgPODesc.txtPOi_Total.Value	= (PrepareSQLnum(tmpPO.Order_Qty,'Order_QTY',-5)*PrepareSQLnum(tmpPO.Order_P,'Order_P',-5) ) + PrepareSQLnum(tmpPO.OtherP,'OtherP',10,2)
						
					THISFORM.pgfPO.pgPOdesc.txtPounds.VALUE		= PrepareSQLnum(tmpPO.Pounds,'Pounds',9,1)
					THISFORM.pgfPO.pgPOdesc.txtCond_Spec.VALUE	= ShowSQLtxt(tmpPO.Cond_Spec,'Cond_Spec',-1)
					ThisForm.pgfPO.pgPODesc.cmbMelt.Value		= ShowSQLtxt(tmpPO.Melt,'Melt',7)
					THISFORM.pgfPO.pgPOdesc.txtMisc_purch.VALUE	= ShowSQLtxt(tmpPO.Misc_purch,'Misc_Purchase',-1)
					
					THISFORM.pgfPO.pgPOdesc.txtOtherP.VALUE		= PrepareSQLnum(tmpPO.OtherP,'OtherP',10,2)
					THISFORM.pgfPO.pgPOdesc.txtOtherFld.VALUE	= ShowSQLtxt(tmpPO.OtherFld,'OtherFld',10)
		
					THISFORM.pgfPO.pgPOdesc.cmbStock.VALUE		= ShowSQLtxt(tmpPO.Stock,'Stock',13)
					THISFORM.pgfPO.pgPOdesc.txtDispAlloy.VALUE	= ShowSQLtxt(tmpPO.DispAlloy,'DispAlloy',20,.F.)
					THISFORM.pgfPO.pgPOdesc.txtStandSize.VALUE	= PrepareSQLnum(tmpPO.StandSize,'StandSize',10,4)
		
					THISFORM.pgfPO.pgPOdesc.chkSPS1.VALUE		= PrepareSQLchk(tmpPO.Sheet_pk,'Sheet_pk')
					THISFORM.pgfPO.pgPOdesc.chkLab_Service.VALUE	= PrepareSQLchk(tmpPO.Services,'Services')
					THISFORM.pgfPO.pgPOdesc.chkConvServ.VALUE	= PrepareSQLchk(tmpPO.ConvServ,'ConvServ')
					THISFORM.pgfPO.pgPOdesc.chkEquipment.VALUE	= PrepareSQLchk(tmpPO.Equipment,'Equipment')
					
					ThisForm.pgfPO.pgPOdesc.lblReconciled.Visible = PrepareSQLlogic(tmpPO.Reconciled,'Reconciled',.F.)
					ThisForm.pgfPO.pgPOdesc.lblDelivered.Visible = PrepareSQLlogic(tmpPO.Delivered,'Delivered',.F.)
					ThisForm.pgfPO.pgPOdesc.lblCancelled.Visible = PrepareSQLlogic(tmpPO.Cancelled,'Cancelled',.F.)
			
					THISFORM.pgfPO.pgPOdesc.chkIntP.VALUE		= PrepareSQLchk(tmpPO.IntP,'IntP')
					
					THISFORM.pgfPO.pgPOdesc.txtOrderDate.VALUE	= PrepareSQLdate(tmpPO.OrderDate,'OrderDate',.F.,.T.)
					THISFORM.pgfPO.pgPOdesc.txtDue_Min.VALUE	= PrepareSQLdate(tmpPO.Due_Min,'Due_Min',.F.,.T.)
					THISFORM.pgfPO.pgPOdesc.txtDue_Max.VALUE	= PrepareSQLdate(tmpPO.Due_Max,'Due_Max',.F.,.T.)
					THISFORM.pgfPO.pgPOdesc.txtHPA_Due_Min.VALUE	= PrepareSQLdate(tmpPO.HPA_Due_Min,'HPA_Due_Min',.F.,.T.)
					THISFORM.pgfPO.pgPOdesc.txtHPA_Due_Max.VALUE	= PrepareSQLdate(tmpPO.HPA_Due_Max,'HPA_Due_Max',.F.,.T.)
		
					THISFORM.pgfPO.pgPOdesc.txtPOSalesName.VALUE	= tmpPO.POSalesP
					THISFORM.pgfPO.pgPOdesc.txtJobNumber.VALUE		= tmpPO.JobNumber
					THISFORM.pgfPO.pgPOdesc.txtShipVia.VALUE		= tmpPO.ShipVia
		
					THISFORM.pgfPO.pgPOdesc.cmbShipWhere.VALUE		= PrepareSQLnum(tmpPO.ShipWhere,'ShipWhere',-1)
					THISFORM.pgfPO.pgPOAddress.opgPOShipTo.VALUE 	= PrepareSQLnum(tmpPO.ShipWhere,'ShipWhere',-1)
					THISFORM.pgfPO.pgPOAddress.txtPOShipAddr.VALUE	= PrepareSQLnum(tmpPO.POShipAddr,'POShipAddr',-3)
		*			ThisForm.ShipWhereChange(tmpPO.ShipWhere)  &&call After getting ShipWhere
		
		
					THISFORM.POShipAddr 			= PrepareSQLnum(tmpPO.POShipAddr,'POShipAddr',-3)
		*ThisForm.ShowPOShipAddr(tmpPO.POShipAddr)  &&Called at end of procedure
					THISFORM.Show_VendCode(tmpPO.VendCode)  &&must call After getting VendCode
		
		
					THISFORM.pgfPO.pgPOAddress.cmbRemoteStock.VALUE = IIF(EMPTY(tmpPO.ShipLocation),'*',tmpPO.ShipLocation)
					THISFORM.pgfPO.pgPOAddress.txtTerms.VALUE 		= ShowSQLtxt(tmpPO.Terms,'Terms',50,.F.)
					THISFORM.pgfPO.pgPOAddress.txtFOB.VALUE 		= ShowSQLtxt(tmpPO.FOB,'FOB',50,.F.)
					THISFORM.pgfPO.pgPOAddress.txtHpaPo.VALUE		= PrepareSQLnum(tmpPO.HPAPo,'HPAPO',-3)
					THISFORM.pgfPO.pgPOAddress.txtItempo.VALUE		= PrepareSQLnum(tmpPO.ItemPO,'ItemPO',2,0)
					THISFORM.pgfPO.pgPOAddress.txtReceipt.VALUE 	= ShowSQLtxt(tmpPO.Receipt,'Reciept',-1,.F.)
		
					THISFORM.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.VALUE 		= ShowSQLtxt(tmpPO.Sz1Orig,'Sz1Orig',20,.F.)
					THISFORM.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.VALUE 		= ShowSQLtxt(tmpPO.Sz2Orig,'Sz2Orig',20,.F.)
					THISFORM.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.VALUE 		= ShowSQLtxt(tmpPO.Sz3Orig,'Sz3Orig',20,.F.)
		
		*Received Heat Cert ProcLoc Receipt Delivered  Cancelled
		
					IF tmpPO.VendCode > 0
						THISFORM.nVendCode	= PrepareSQLnum(tmpPO.VendCode,'VendCode',-3)
						THISFORM.nContactID	= PrepareSQLnum(tmpPO.ContactID,'ContactID',-3)
						THISFORM.pgfPO.pgPOdesc.lblVendCode.CAPTION	= STR(tmpPO.VendCode)
						THISFORM.pgfPO.pgVendor.txtVendCode.VALUE	= tmpPO.VendCode
						THISFORM.pgfPO.pgPOdesc.lblPeachID.CAPTION 	= getPeachID_VendCode(tmpPO.VendCode)
						THISFORM.pgfPO.pgVendor.txtPeachID.VALUE	= getPeachID_VendCode(tmpPO.VendCode)
					ELSE
						THISFORM.nVendCode	= 0
						THISFORM.nContactID	= 0
						THISFORM.pgfPO.pgPOdesc.lblVendCode.CAPTION = ''
						THISFORM.pgfPO.pgVendor.txtVendCode.VALUE	= 0
						THISFORM.pgfPO.pgPOdesc.lblPeachID.CAPTION = ''
						THISFORM.pgfPO.pgVendor.txtPeachID.VALUE	= ''
					ENDIF
		
		*******************************************
		*!*				*Fix Depricated Values
		*!*				PRIVATE nP_Lb,nP_Pc,nP_Ft,nLotP
		*!*				nP_Lb	= PrepareSQLnum(tmpPO.P_lb,'P_Lb',10,2)
		*!*				nP_Pc	= PrepareSQLnum(tmpPO.P_pc,'P_Pc',10,2)
		*!*				nP_Ft	= PrepareSQLnum(tmpPO.P_ft,'P_Ft',10,2)
		*!*				nLotP	= PrepareSQLnum(tmpPO.LotP,'LotP',10,2)
					PRIVATE nOrder_QTY, nOrder_P, nOrder_PU, nOtherP
					nOrder_QTY	= PrepareSQLnum(tmpPO.Order_Qty,'Order_QTY',-5)
					nOrder_P	= PrepareSQLnum(tmpPO.Order_P,'Order_P',-5)
					nOrder_PU	= PrepareSQLnum(tmpPO.Order_PU,'Order_PU',-1)
					nOtherP		= PrepareSQLnum(tmpPO.OtherP,'OtherP',10,2)
		
					THISFORM.pgfPO.pgPOdesc.txtOrder_Qty.VALUE	= nOrder_QTY
					THISFORM.pgfPO.pgPOdesc.txtOrder_P.VALUE	= nOrder_P
					THISFORM.pgfPO.pgPOdesc.cmbOrder_PU.VALUE	= PrepareSQLtxt(nOrder_PU,'Order_PU',1)
					THISFORM.pgfPO.pgPOdesc.lblUnitText.CAPTION	= Get_cPUfrom_nPU(nOrder_PU)
					ThisForm.pgfPO.pgPODesc.txtOtherP.Value		= nOtherP
					ThisForm.pgfPO.pgPODesc.txtPOi_Total.Value	= ( nOrder_QTY * nOrder_P ) + nOtherP
				ENDIF
		
		*******************************************
		
				*Fix Pounds
				IF THISFORM.pgfPO.pgPOdesc.txtPounds.VALUE = 0
					THISFORM.POpounds()
				ENDIF
		
				THISFORM.chkCancelPO.VALUE = PrepareSQLchk(tmpPO.Cancelled,'Cancelled')
				THISFORM.chkCancelPO.ENABLED = .T.
		
				THISFORM.chkDeliveredPO.VALUE = PrepareSQLchk(tmpPO.Delivered,'Delivered')
				ThisForm.lblTBL.Caption		= PrepareSQLtxt(tmpPO.TBL,'TBL',1)
				
				THISFORM.pgfPO.ACTIVEPAGE = 1
		
				THISFORM.pgfPO.pgPOdesc.txtCompany.SETFOCUS()
			ELSE
				*Blank
				THISFORM.POScreen("CLEAR")
				THISFORM.POShipAddr = 1
				THISFORM.cmdPOEdit.ENABLED = .F.
				THISFORM.cmdPODelete.ENABLED = .F.
				THISFORM.chkCancelPO.ENABLED = .F.
				THISFORM.nVendCode = 0
				THISFORM.nContactID = 0
			ENDIF
			USE IN tmpPO
		ENDIF
		
		THISFORM.pgfPO.pgPOAddress.txtHpaPo.VALUE	= THISFORM.pgfPO.pgPOdesc.txtHpaPo.VALUE
		THISFORM.pgfPO.pgPOAddress.txtItempo.VALUE	= THISFORM.pgfPO.pgPOdesc.txtItempo.VALUE
		
		
		THISFORM.ShowPOShipAddr( THISFORM.POShipAddr )
		THISFORM.Show_VendCode( THISFORM.nVendCode )
		THISFORM.GetVendorContacts( THISFORM.nContactID )
		THISFORM.RefreshPOForms( THISFORM.pgfPO.pgPOdesc.cmbForm.VALUE )
		
		ThisForm.Correct_Acct_Stnd()
		
		IF Count_POIteminPO_Testing( cPOitem, THISFORM.nConnHandle ) > 0
			THISFORM.ShowPOTesting( cPOitem )
		ENDIF
		
		
	ENDPROC

	PROCEDURE showposhipaddr
		PARAMETER pnPOShipAddr
		*ThisForm.ShowPOShipAddr
		
		IF VARTYPE(pnPOShipAddr) != 'N'
			MESSAGEBOX('Bad parameter to function ShowPOshipAddr')
			RETURN .F.
		ENDIF
		
		WAIT WINDOW "ShowPOShipAdd" NOWAIT
		*ThisForm.ShowPOShipAddr( POShipAddr )
		PRIVATE nPOshipAddr, lBlank
		lBlank = .F.
		
		nPOshipAddr = pnPOShipAddr 
		**ThisForm.pgfPO.pgPOAddress.txtPOShipAddr.VALUE
		
		IF NOT EMPTY(nPOshipAddr)
			IF TYPE("nPOshipAddr") = "N"
				IF nPOshipAddr > 0
					*Get Address and Show
		
					IF USED( 'aShipAddr' )
						USE IN aShipAddr
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.ShipAddr "
					cSQL = cSQL + " WHERE ShipCode = "+STR(nPOshipAddr)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aShipAddr")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aShipAddr")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'aShipAddr')
					ENDIF
					IF USED('aShipAddr')
						ThisForm.POShipAddr = aShipAddr.ShipCode	
						
						ThisForm.pgfPO.pgPOAddress.txtPOShipAddr.VALUE = aShipAddr.ShipCode
						*ThisForm.pgfPO.pgPOAddress.numShipAddr.Value 	= aShipAddr.ShipCode
						ThisForm.pgfPO.pgPOAddress.txtCompany.VALUE 	= aShipAddr.Company
						ThisForm.pgfPO.pgPOAddress.txtAddr1.VALUE 		= aShipAddr.Addr1
						ThisForm.pgfPO.pgPOAddress.txtAddr2.VALUE 		= aShipAddr.Addr2
						ThisForm.pgfPO.pgPOAddress.txtCity.VALUE 		= aShipAddr.City
						ThisForm.pgfPO.pgPOAddress.txtST.VALUE 		= aShipAddr.ST
						ThisForm.pgfPO.pgPOAddress.txtZip.VALUE 		= aShipAddr.Zip
						ThisForm.pgfPO.pgPOAddress.txtCountry.VALUE 	= aShipAddr.Country
						ThisForm.pgfPO.pgPOAddress.txtContact.VALUE 	= aShipAddr.Contact
						ThisForm.pgfPO.pgPOAddress.txtPhone.VALUE 		= aShipAddr.Telephone
						ThisForm.pgfPO.pgPOAddress.txtFax.VALUE 		= aShipAddr.Fax_Number
						ThisForm.pgfPO.pgPOAddress.txtEmail.VALUE 		= aShipAddr.Email
						ThisForm.pgfPO.pgPOAddress.txtLastEdit.VALUE	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit',.F.,.T.)),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit',.F.,.T.))
						
						*ThisForm.ShipWhereChange(aShipAddr.ShipCode,aShipAddr.Company,aShipAddr.City)
						
						IF USED( 'aShipAddr' )
							USE IN aShipAddr
						ENDIF
					ENDIF
		
				ELSE
					lBlank = .T.
				ENDIF
			ELSE
				lBlank = .T.
			ENDIF
		ELSE
			lBlank = .T.
		ENDIF
		
		IF lBlank
			*Show blanks
			ThisForm.POShipAddr = 0
			ThisForm.pgfPO.pgPOAddress.txtPOShipAddr.VALUE = 0
			*ThisForm.pgfPO.pgPOAddress.numShipAddr.Value = aShipAddr( 1, 1 )
			ThisForm.pgfPO.pgPOAddress.txtCompany.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtAddr1.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtAddr2.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtCity.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtST.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtZip.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtCountry.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtContact.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtPhone.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtFax.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtEmail.VALUE = ""
			ThisForm.pgfPO.pgPOAddress.txtLastEdit.VALUE = CtoD("  /  /  ")
			
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Caption = "Save"
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Caption = "Abort"
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
		ELSE
			ThisForm.pgfPO.pgPOAddress.cmdPOSearchShipTo.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Enabled = .T.
			ThisForm.pgfPO.pgPOAddress.cmdEditAddr.Caption = "Edit"
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Caption = "Clear"
			ThisForm.pgfPO.pgPOAddress.cmdClearShip.Enabled = .T.
		ENDIF
		WAIT CLEAR
		
	ENDPROC

	PROCEDURE showposhipto
		PARAMETERS nShipCode
		*ThisForm.ShowPOShipTo()
		*Depricated - use ShowPOShipAddr()
		
		
		IF VARTYPE(nShipCode) != 'N'
			MESSAGEBOX('Bad parameter to function ShowPOShipTo')
			RETURN .F.
		ENDIF
		
		IF USED( 'aShipAddr' )
			USE IN aShipAddr
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.ShipAddr "
		cSQL = cSQL + " WHERE ShipCode = "+STR(nShipCode)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'aShipAddr' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "aShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, "aShipAddr")
		ENDIF
		
		IF USED('aShipAddr')
			ThisForm.POShipAddr = aShipAddr.ShipCode
			ThisForm.pgfPO.pgPOAddress.txtPOShipAddr.VALUE 	= aShipAddr.ShipCode
			ThisForm.pgfPO.pgPOAddress.txtCompany.VALUE 	= aShipAddr.Company
			ThisForm.pgfPO.pgPOAddress.txtAddr1.VALUE		= aShipAddr.Addr1
			ThisForm.pgfPO.pgPOAddress.txtAddr2.VALUE		= aShipAddr.Addr2
			ThisForm.pgfPO.pgPOAddress.txtCity.VALUE 		= aShipAddr.City
			ThisForm.pgfPO.pgPOAddress.txtST.VALUE			= aShipAddr.ST
			ThisForm.pgfPO.pgPOAddress.txtZip.VALUE			= aShipAddr.Zip
			ThisForm.pgfPO.pgPOAddress.txtCountry.VALUE		= aShipAddr.Country
			ThisForm.pgfPO.pgPOAddress.txtContact.VALUE		= aShipAddr.Contact
			ThisForm.pgfPO.pgPOAddress.txtPhone.VALUE		= aShipAddr.Telephone
			ThisForm.pgfPO.pgPOAddress.txtFax.VALUE			= aShipAddr.Fax_Number
			ThisForm.pgfPO.pgPOAddress.txtEmail.VALUE		= ShowSQLtxt(aShipAddr.Email,'Email',60)
			ThisForm.pgfPO.pgPOAddress.txtLastEdit.VALUE	= IIF(EMPTY(PrepareSQLdate(aShipAddr.LastEdit,'LastEdit',.F.,.T.)),CTOD(''),PrepareSQLdate(aShipAddr.LastEdit,'LastEdit',.F.,.T.))
		*	ThisForm.pgfPO.pgPOAddress.txtLastEdit.VALUE	= aShipAddr.LastEdit &&Do not use PrepareSQL before Init!
		
			IF USED('aShipAddr')
				USE IN aShipAddr
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showpotesting
		PARAMETERS pcType
		*ThisForm.ShowPOTesting( 'NEW' )
		
		IF VARTYPE( pcType ) != "C"
			*pcType = ""
			RETURN
		ENDIF
		
		PRIVATE cPOitem, cSOitem 
		IF NOT EMPTY(ThisForm.pgfPO.pgPODesc.txtHpapo.Value)
			cPOitem = Proper_PO_Item( STR(ThisForm.pgfPO.pgPODesc.txtHpapo.Value)+"-"+STR(ThisForm.pgfPO.pgPODesc.txtItemPo.Value) )
		ELSE
			cPOitem = Proper_PO_Item( ThisForm.lstPoItems.Value )
		ENDIF
		cSOitem = Proper_SO_item( STR(ThisForm.SalesNum)+"-"+STR(ThisForm.itemnumber))
		
		
		IF pcType = "NEW" 
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblPOitem.Caption = cPOitem 
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblSOitem.Caption = cSOitem 
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtAlloy.Value = ThisForm.pgfPO.pgPODesc.txtAlloy.Value
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtHeat.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtLot.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtForm.Value = ThisForm.pgfPO.pgPODesc.cmbForm.Value
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtSize.Value = ThisForm.pgfPO.pgPODesc.txtThck.Value
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtQuantity.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestType.Value = 2
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestPackage.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogDelivery.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogReturnSamples.Value = 2
			
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSpecimen.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.ogLocation.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileConf.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileTemp.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSonicProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.ogSonicType.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardConf.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.ogHardProfile.Value = 2
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbIGCorrProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbStressProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyTemp.Value = ""
			
			ThisForm.POTestingScreen("ENABLE")
			
			RETURN	
		ENDIF
		
		
		IF NOT (pcType = "BLANK" OR pcType = "NEW" ) &&Have POitem
			IF Proper_PO_Item(cPOitem) != Proper_PO_Item("")
				*Show the PO_Testing Data
				
				
				IF USED("tmpPO_Testing")
					USE IN cntSoldAddr
				ENDIF
				
				cSQL = "SELECT * FROM dbo.PO_Testing"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_Testing')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_Testing')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_Testing")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_Testing")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_Testing')
				ENDIF
				IF USED("tmpPO_Testing")
					IF VARTYPE(tmpPO_Testing.POitem) = "C"
						
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblPOitem.Caption = tmpPO_Testing.POitem
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblSOitem.Caption = tmpPO_Testing.SOitem
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtAlloy.Value = tmpPO_Testing.Alloy
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtHeat.Value = tmpPO_Testing.Heat
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtLot.Value = tmpPO_Testing.Lot
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtForm.Value = tmpPO_Testing.Form
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtSize.Value = tmpPO_Testing.Size
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtQuantity.Value = tmpPO_Testing.Quantity
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestType.Value = tmpPO_Testing.TestType
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestPackage.Value = tmpPO_Testing.TestPackage
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogDelivery.Value = tmpPO_Testing.DelivService
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogReturnSamples.Value = tmpPO_Testing.ReturnSamples
						
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSpecimen.Value = tmpPO_Testing.SpeciDia
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.ogLocation.Value = tmpPO_Testing.SpeciLoc
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileProc.Value = tmpPO_Testing.TensileTest
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileConf.Value = tmpPO_Testing.TensileConf
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileTemp.Value = tmpPO_Testing.TensileTemp
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSonicProc.Value = tmpPO_Testing.USonicTest
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.ogSonicType.Value = tmpPO_Testing.USonicType
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardProc.Value = tmpPO_Testing.HardTest
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardConf.Value = tmpPO_Testing.HardConf
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.ogHardProfile.Value = tmpPO_Testing.HardProf
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbIGCorrProc.Value = tmpPO_Testing.IGCorrTest
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbStressProc.Value = tmpPO_Testing.StressTest
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyProc.Value = tmpPO_Testing.CharpyTest
						ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyTemp.Value = tmpPO_Testing.CharpyTemp
						
						ThisForm.POTestingScreen("ENABLE")
					ELSE
						MESSAGEBOX("PO item '"+cPOitem+"' was not found!",0+48,"Not found")
						cPOitem = "BLANK"
					ENDIF
					IF USED("tmpPO_Testing")
						USE IN tmpPO_Testing
					ENDIF
					
					RETURN
					
				ELSE
					*MESSAGEBOX("PO item '"+cPOitem+"' was not found!",0+48,"Not found")
					cPOitem = "BLANK"
				ENDIF
			ELSE
				*No POitem
				cPOitem = "BLANK"
			ENDIF
		ENDIF
		
		
		IF pcType = "BLANK" 
			cPOitem = "BLANK"
		ENDIF
		
		
		IF cPOitem = "BLANK"
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblPOitem.Caption = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.lblSOitem.Caption = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtAlloy.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtHeat.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtLot.Value = 0
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtForm.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtSize.Value = 0
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.txtQuantity.Value = 0
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestType.Value = 2
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogTestPackage.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogDelivery.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.ogReturnSamples.Value = 2
			
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSpecimen.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.ogLocation.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileConf.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbTensileTemp.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbSonicProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.ogSonicType.Value = 1
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbHardConf.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.ogHardProfile.Value = 2
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbIGCorrProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbStressProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyProc.Value = ""
			ThisForm.pgfPO.pgTestPO.pgfTesting.pgStandards.cmbCharpyTemp.Value = ""
			
			ThisForm.POTestingScreen("DISABLE")
			
			RETURN
		ENDIF
	ENDPROC

	PROCEDURE showvendcode
		PARAMETER pnVendCode
		*ThisForm.ShowVendCode(nVendCode)
		
		IF VARTYPE(pnVendCode) != 'N'
			ThisForm.VendCodeClear()
			RETURN .F.
		ENDIF
		
		*WAIT WINDOW "ShowVendCode" NOWAIT
		
		PRIVATE nVendCode, lBlank
		lBlank = .F.
		nVendCode = pnVendCode 
		
		
		IF NOT EMPTY(nVendCode)
			IF TYPE("nVendCode") = "N"
				IF nVendCode > 0
					*Get Address and Show
		
					IF USED( 'Vendor' )
						USE IN Vendor
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.Vendor "
					cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Vendor' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Vendor' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Vendor')
					ENDIF
					IF USED('Vendor')
						ThisForm.nVendCode 	= Vendor.VendCode	
		*				ThisForm.nContactID = 0 && reset!
						ThisForm.pgfPO.pgVendor.txtVendCode.VALUE	= Vendor.VendCode 
						ThisForm.pgfPO.pgVendor.txtCompany.VALUE 	= Vendor.Company
						ThisForm.pgfPO.pgVendor.txtAddr1.VALUE 	= Vendor.Addr1
						ThisForm.pgfPO.pgVendor.txtAddr2.VALUE 	= Vendor.Addr2
						ThisForm.pgfPO.pgVendor.txtCity.VALUE		= Vendor.City
						ThisForm.pgfPO.pgVendor.txtST.VALUE 		= Vendor.ST
						ThisForm.pgfPO.pgVendor.txtZip.VALUE 		= Vendor.Zip
						ThisForm.pgfPO.pgVendor.txtCountry.VALUE 	= Vendor.Country
						ThisForm.pgfPO.pgVendor.txtLastEdit.VALUE	= PrepareSQLdate(Vendor.LastEdit,'LastEdit',.F.,.T.)
						ThisForm.pgfPO.pgVendor.QAApproved1.Value	= PrepareSQLnum(Vendor.QAApproved,'QAApproved',-1)
						ThisForm.pgfPO.pgVendor.Metal1.Value 		= PrepareSQLchk(Vendor.Metal,'Metal')
						ThisForm.pgfPO.pgVendor.Inactive1.Value 	= PrepareSQLchk(Vendor.Inactive,'Inactive')
						ThisForm.pgfPO.pgVendor.txtPeachID.Value 	= ShowSQLtxt(Vendor.PeachID,'PeachID',20)
		*				ThisForm.pgfPO.pgVendor.chkVendorPOConf	= PrepareSQLchk(PurchaseOrder.VendorPOConf,'VedorPOConf')
						ThisForm.pgfPO.pgVendor.chkVendorPOConf.Value	= PrepareSQLchk(VendorPOConf_POitem(ThisForm.cPOitem ,ThisForm.nConnHandle),'VedorPOConf')
						ThisForm.pgfPO.pgVendor.Vend_Notes.Value	= ShowSQLtxt(Vendor.Vend_Notes,'Vend_Notes',-1)
						ThisForm.pgfPO.pgVendor.Vend_Print.Value	= ShowSQLtxt(Vendor.Vend_Print,'Vend_Print',-1)
						
						ThisForm.pgfPO.pgPODesc.lblVendCode.Caption	= STR(Vendor.VendCode)
						ThisForm.pgfPO.pgPODesc.lblPeachID.Caption	= ShowSQLtxt(Vendor.PeachID,'PeachID',20)
						ThisForm.pgfPO.pgPODesc.txtCompany.Value	= Vendor.Company
						
		*				USE IN Vendor
					ENDIF
				ELSE
					lBlank = .T.
				ENDIF
			ELSE
				lBlank = .T.
			ENDIF
		ELSE
			lBlank = .T.
		ENDIF
		
		***********************
		IF lBlank
			*Show blanks
			ThisForm.VendorClear()
		
		ELSE
			ThisForm.pgfPO.pgVendor.cmdPOSearchBuyFrom.Enabled = .T.
			ThisForm.pgfPO.pgVendor.cmdEditAddr.Enabled = .T.
			ThisForm.pgfPO.pgVendor.cmdClearShip.Enabled = .T.
			
		ENDIF
		
		***********************
		IF USED('VendorContacts')
			USE IN VendorContacts
		ENDIF
		
		cSQL = "SELECT * FROM dbo.VendorContact "
		cSQL = cSQL + " WHERE VendCode = "+STR(ThisForm.nVendCode)
		cSQL = cSQL + " AND ISNULL(Inactive,0) = 0"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'VendorContacts' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'VendorContacts' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "VendorContacts")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "VendorContacts")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'VendorContacts')
		ENDIF
		IF USED('VendorContacts')
			INDEX ON ContactID TAG ContactID
			SET ORDER TO TAG ContactID
		ENDIF
		
		
	ENDPROC

	PROCEDURE showvendorcontact
		PARAMETERS nContactID
		*ThisForm.ShowVendorContact(VendorContacts.ContactID)
		
		IF VARTYPE(nContactID)!="N"
			MESSAGEBOX("ThisForm.ShowVendorContact(VendorContacts.ContactID)",16,"Error")
			RETURN
		ENDIF
		
		*IF USED('VendorContacts')	
		*	USE IN VendorContacts
		*ENDIF
		*SELECT 0
		
		PRIVATE nVendCode
		nVendCode = PrepareSQLnum(ThisForm.nVendCode,'VendCode',-3)
		
		*********************************
		IF nContactID = 0
			IF nVendCode > 0
				IF USED('tmpVendorContact1')
					USE IN tmpVendorContact1
				ENDIF
				
				PRIVATE cContact
				cContact = VendorContact_ContactID(nContactID,ThisForm.nConnHandle)
				
				cSQL = "SELECT TOP 1 ContactID FROM dbo.VendorContact WHERE Contact LIKE '%"+ALLTRIM(cContact)+"%'"
				cSQL = cSQL + " AND VendCode = "+ALLTRIM(STR(nVendCode))
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpVendorContact1' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpVendorContact1' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendorContact1")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpVendorContact1")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpVendorContact1' )
					lSaveOK = .F.
				ENDIF
		
				IF USED('VendorContacts')
					IF VARTYPE(tmpVendorContact1.ContactID) = "N"
						nContactID = tmpVendorContact1.ContactID
					ENDIF
							
					USE IN tmpVendorContact1
				
				ENDIF
			ENDIF		
		ENDIF
		
		*********************************	
		PRIVATE lFind_VendCode
		lFind_VendCode = .T.
		IF nVendCode = 0
			lFind_VendCode = .F.
		ENDIF
		
		*********************************	
		IF NOT USED('VendorContacts')
			IF lFind_VendCode
				
				*Have ContactID!	
				cSQL = "SELECT * FROM dbo.VendorContact "
				cSQL = cSQL + " WHERE VendCode = "+ALLTRIM(STR(nVendCode))
				cSQL = cSQL + " AND ISNULL(Inactive,0) = 0"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'VendorContacts' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'VendorContacts' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "VendorContacts")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "VendorContacts")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'VendorContacts' )
				ENDIF
				IF USED('VendorContacts')
					INDEX ON ContactID TAG ContactID
					SET ORDER TO TAG ContactID
				ENDIF
			ENDIF
		ENDIF
		
		*********************************	
		IF lFind_VendCode
			SELECT VendorContacts
			*SEEK nContactID
			LOCATE FOR ContactID = nContactID
			
			IF FOUND('VendorContacts')
				lFind_VendCode = .T.
			ELSE
				lFind_VendCode = .F.
			ENDIF
		ENDIF
		
		*********************************	
		
		IF lFind_VendCode
			ThisForm.nContactID = nContactID
			ThisForm.pgfPO.pgVendorContact.nContactID.Value	= PrepareSQLnum(VendorContacts.ContactID,'ContactID',-3)
			ThisForm.pgfPO.pgVendorContact.cContact.Value	= ShowSQLtxt(VendorContacts.Contact,'Contact',100)
			ThisForm.pgfPO.pgVendorContact.cPhone.Value		= ShowSQLtxt(VendorContacts.Phone,'Phone',50)
			ThisForm.pgfPO.pgVendorContact.cCellPhone.Value	= ShowSQLtxt(VendorContacts.CellPhone,'CellPhone',20)
			ThisForm.pgfPO.pgVendorContact.cFax.Value		= ShowSQLtxt(VendorContacts.Fax,'Fax',20)
			ThisForm.pgfPO.pgVendorContact.cEmail.Value		= ShowSQLtxt(VendorContacts.Email,'Email',60)
			ThisForm.pgfPO.pgVendorContact.cAddr1.Value		= ShowSQLtxt(VendorContacts.Addr1,'Addr1',100)
			ThisForm.pgfPO.pgVendorContact.cAddr2.Value		= ShowSQLtxt(VendorContacts.Addr2,'Addr2',100)
			ThisForm.pgfPO.pgVendorContact.cCity.Value			= ShowSQLtxt(VendorContacts.City,'City',50)
			ThisForm.pgfPO.pgVendorContact.cST.Value			= ShowSQLtxt(VendorContacts.ST,'ST',50)
			ThisForm.pgfPO.pgVendorContact.cZip.Value			= ShowSQLtxt(VendorContacts.Zip,'Zip',50)
			ThisForm.pgfPO.pgVendorContact.cCountry.Value		= ShowSQLtxt(VendorContacts.Country,'Country',50)
			ThisForm.pgfPO.pgVendorContact.chkQuality.Value		= PrepareSQLchk(VendorContacts.Quality,'Quality')
			ThisForm.pgfPO.pgVendorContact.dLastSurveySent.Value	= PrepareSQLdate(VendorContacts.LastSurveySent,'LastSurveySent',.F.,.T.)
			ThisForm.pgfPO.pgVendorContact.dLastSurveyReceived.Value	= PrepareSQLdate(VendorContacts.LastSurveyReceived,'LastSurveyReceived',.F.,.T.)
			ThisForm.pgfPO.pgVendorContact.cJobTitle.Value			= ShowSQLtxt(VendorContacts.JobTitle,'JobTitle',50)
			ThisForm.pgfPO.pgVendorContact.nSurveyPriority.Value	= PrepareSQLnum(VendorContacts.SurveyPriority,'SurveyPriority',-3)
			ThisForm.pgfPO.pgVendorContact.chkVCinactive.Value 	= PrepareSQLchk(VendorContacts.Inactive,'Inactive')
		
			
			PRIVATE nHPAPO
			nHPAPO 	= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtHpaPo.VALUE,'HPAPO',-3)
			IF VendorContactID_PO(nContactID,nHPAPO,ThisForm.nConnHandle)
		*		ThisForm.frmEO.Pageframe1.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .F.
				ThisForm.pgfPO.pgVendorContact.lblSaveContact.Visible = .F.
			ELSE
		*		ThisForm.frmEO.Pageframe1.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .T.
				ThisForm.pgfPO.pgVendorContact.lblSaveContact.Visible = .T.
			ENDIF
		ELSE
			*Not Found!
			IF nContactID > 0 AND nVendCode > 0
				IF MESSAGEBOX("Do you want to Clone this (Y)"+CHR(13)+"otherwise the contact will be clear.",4+32,"Clone Contact")=6
					ThisForm.nContactID = 0	
					ThisForm.pgfPO.pgVendorContact.nContactId.Value = 0
					ThisForm.pgfPO.pgVendorContact.cContact.Value = ''
					ThisForm.pgfPO.pgVendorContact.lblSaveContact.Visible = .T.
				ELSE
					ThisForm.ContactClear()
				ENDIF
			ELSE
				ThisForm.ContactClear()
			ENDIF
		ENDIF
		
		PRIVATE nHPAPO
		nHPAPO 	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtHpapo.VALUE,'HPAPO',-3)
		IF nHPAPO > 0
			IF VendorContactID_PO(nContactID,nHPAPO,ThisForm.nConnHandle)
				ThisForm.pgfPO.pgVendorContact.lblSaveContact.Visible = .F.
		*		ThisForm.frmEO.Pageframe1.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .F.
			ELSE
				ThisForm.pgfPO.pgVendorContact.lblSaveContact.Visible = .T.
		*		ThisForm.frmEO.Pageframe1.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .T.
			ENDIF
		ELSE
			ThisForm.pgfPO.pgVendorContact.lblSaveContact.Visible = .F.
		*	ThisForm.frmEO.Pageframe1.pgAdd.pfAdd.pgVendorContact.lblSaveContact.Visible = .F.
		ENDIF
		
		IF USED('VendorContacts')	
			USE IN VendorContacts
		ENDIF
	ENDPROC

	PROCEDURE show_frmpo
		*ThisForm.Show_frmPO()
		* uses ThisForm.ShowPOitem(cPOitem) and SetPoItems
		
		PRIVATE nCntPOitem 
		nCntPOitem = 0
		
		IF ThisForm.PO_NewAdd OR ThisForm.POEditing 
			*ThisForm.PO_NewClone
			RETURN .F.
		ENDIF
		
		
		
		IF ThisForm.cmdPOEdit.CAPTION = "Edit PO" &&NOT "Save PO"
			PRIVATE cPOitem,cSOitem
			cPOitem = Proper_PO_item(ThisForm.cPOitem)
			cSOitem = Proper_SO_item(ThisForm.cSOitem)
		
			IF VAL(cPOitem) = 0 AND VAL(cSOitem) > 0
				*look in PurchaseOrdes for POitem by SO and SOitem
			
				IF USED('tmpPoItemDetail')
					USE IN tmpPoItemDetail
				ENDIF
				
				PRIVATE cSQL, nSQLEXEC
				
				cSQL = "SELECT TOP 1 PoItem FROM dbo.PurchaseOrder "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL + " ORDER BY PoItem " &&DESC " 
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPoItemDetail')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPoItemDetail' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPoItemDetail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPoItemDetail")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPoItemDetail' )
				ENDIF
		
				IF USED('tmpPoItemDetail')
					IF RECCOUNT('tmpPoItemDetail') > 0
						SELECT tmpPoItemDetail
						cPOitem = tmpPoItemDetail.POitem
						ThisForm.cPOitem = cPOitem
					ENDIF
					USE IN tmpPoItemDetail
				ENDIF
				
			ENDIF
			
			**********************************************	
			
			IF Proper_PO_item(ThisForm.cPOitem) != Proper_PO_item("")
			*IF VAL(cPOitem) > 0
			
				ThisForm.SetPoItems(ThisForm.cSOitem,ThisForm.cPOitem)
				
				IF Proper_PO_item(ThisForm.cPOitem) != Proper_PO_item("")
					*Have good PO item, get Data
		
					IF USED('tmpCountPoItemDetail')
						USE IN tmpCountPoItemDetail
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PurchaseOrder "
					cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+ThisForm.cPOitem+"')"
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountPoItemDetail')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCountPoItemDetail' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountPoItemDetail")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountPoItemDetail")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCountPoItemDetail' )
					ENDIF
					
					IF USED('tmpCountPoItemDetail')
						IF tmpCountPoItemDetail.CNTD > 0
							nCntPOitem = tmpCountPoItemDetail.CNTD
						ENDIF
						USE IN tmpCountPoItemDetail
						*tmpCountPoItemDetail tmpPoItemDetail
					ENDIF
							
					IF nCntPOitem > 0				
					
						**************************************	
						ThisForm.ShowPOitem(ThisForm.cPOitem)
						**************************************
						
						ThisForm.cmdPOEdit.CAPTION = "Edit PO"
						*Check lstPoItems.Click
						ThisForm.cmdPrintPO.Enabled = .T.
						ThisForm.cmdPOEdit.Enabled = .T.
						ThisForm.cmdPODelete.Enabled = .T.
					ELSE
						ThisForm.POScreen("CLEAR")
					ENDIF
				ELSE  && EMPTY(ThisForm.cPOitem)
					ThisForm.POScreen("CLEAR")
				ENDIF
		*		ThisForm.chkCancelPO.Enabled = .T.
			ELSE
				*NO PO item!
				*ThisForm.SetPoItems(ThisForm.cSOitem,ThisForm.cPOitem)	
				ThisForm.lstPoItems.Clear
				ThisForm.POScreen("CLEAR")
			ENDIF
			
			ThisForm.lstPoItems.SETFOCUS
		ENDIF
		
		
		
		*************
		IF NOT EMPTY(ThisForm.cPOitem )
			ThisForm.lstPoItems.Value = ThisForm.cPOitem 
		ENDIF
		WAIT CLEAR
	ENDPROC

	PROCEDURE show_so_dist
		*ThisForm.Show_SO_Dist()
		
		PRIVATE cPOItem
		cPOItem = ThisForm.cPOitem
		
		PRIVATE cThisSO_item
		cThisSO_item = ThisForm.cSOitem
		
		PRIVATE nSO_QTY, nSO_P, nSO_Total   &&Keep as Acct Stnd of SO
		nSO_QTY	= 0
		nSO_P	= 0
		nSO_Total = 0
		PRIVATE nS_P, nS_QTY, nS_Total, nS_PU
		nS_P = 0 
		nS_QTY = 0
		nS_Total = 0
		nS_PU = 0
		
		PRIVATE nQuoted_QTY, nQuoted_P, nQuoted_Total, nQuoted_PU
		PRIVATE nItemSale
		PRIVATE nPT_Total
		nQuoted_QTY = 0	&&Customer Stnd
		nQuoted_P = 0
		nQuoted_Total = 0
		nQuoted_PU = 0
		nItemSale = 0
		nPT_Total = 0
		
		
		IF NOT EMPTY(cThisSO_item)
		
			IF VARTYPE(cThisSO_item) != "C"
		*		RETURN 0
			ENDIF
			IF cThisSO_item = Proper_SO_Item("")
		*		RETURN 0
			ENDIF
		
			PRIVATE cAlias 
			cAlias = ALIAS()
			PRIVATE cSQL, nSQLEXEC 
		
			IF USED("tmpSales_2")
				USE IN tmpSales_2
			ENDIF
			cSQL = "SELECT Quoted_QTY, Quoted_P, Quoted_Total, Quoted_PU, ItemSale "
			cSQL = cSQL + ",S_PU, S_QTY, S_P, S_Total "
			cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOItem = dbo.f_ProperSOitem('"+cThisSO_item+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_2')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_2')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSales_2')
			ENDIF
			
			IF USED("tmpSales_2")
				IF RECCOUNT('tmpSales_2')> 0
					
					nQuoted_QTY	= PrepareSQLnum(tmpSales_2.Quoted_QTY,'Quoted_QTY',-5)
					nQuoted_P	= PrepareSQLnum(tmpSales_2.Quoted_P,'Quoted_P',-5)
					nQuoted_Total = PrepareSQLnum(tmpSales_2.Quoted_Total,'Quoted_Total',-5)
					nQuoted_PU	= PrepareSQLnum(tmpSales_2.Quoted_PU,'Quoted_PU',-1)
					nItemSale	= PrepareSQLnum(tmpSales_2.ItemSale,'ItemSale',-5)
					
					*Use Acct Stnd of SO
					nS_PU		= PrepareSQLnum(tmpSales_2.S_PU,'S_PU',-1)
					nS_QTY 		= PrepareSQLnum(tmpSales_2.S_QTY,'S_QTY',-5)
					nS_P		= PrepareSQLnum(tmpSales_2.S_P,'S_P',-5)
					nS_Total	= nS_QTY * nS_P
					
				ENDIF
				USE IN tmpSales_2
			ENDIF
		
			IF NOT EMPTY(cAlias)
				IF USED(cAlias)
					SELECT (cAlias)
				ENDIF
			ENDIF
		
		ENDIF
		
		ThisForm.pgfPO.pgSOdist.txtDist_QTY.Value = 0
		ThisForm.pgfPO.pgSOdist.txtWO_PO_SO_Dist.Value = 0
		
		***********************
		PRIVATE cForm, nS_PU
		cForm = ThisForm.pgfPO.pgPODesc.cmbForm.Value
		IF LEN(cForm)> 1
			nS_PU = nPU_Acct_Form(cForm,ThisForm.nConnHandle)
		ELSE
			nS_PU = 0
		ENDIF
		
		************************
		PRIVATE nDist_QTY
		nDist_QTY = 0
		
		IF nS_QTY > 0
			IF nQuoted_PU = nS_PU
				*Same PU, Same Value
				nS_QTY = nQuoted_PU
				nS_P   = nQuoted_P
			ELSE
				PRIVATE cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld
				cAlloy			= PrepareSQLtxt(ThisForm.pgfPO.pgPOdesc.txtAlloy.VALUE,'Alloy',12,.F.)
				cForm			= PrepareSQLtxt(ThisForm.pgfPO.pgPOdesc.cmbForm.VALUE,'Form',2,.T.)
				nPieces			= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtPieces.VALUE,'Pieces',6,0)
				nThck			= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtThck.VALUE,'Thck',10,4)
				nSz2			= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtSz2.VALUE,'Sz2',9,3)
				nSz3			= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtSz3.VALUE,'Sz3',9,3)
				cOtherFld		= PrepareSQLtxt(ThisForm.pgfPO.pgPOdesc.txtOtherFld.VALUE,'OtherFld',10,.F.)
				
				nS_QTY = Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld,ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		IF nPT_Total = 0
			IF nQuoted_PU = nS_PU
				*Same
				nPT_Total  = nS_QTY * nQuoted_P
			ELSE
				nPT_Total  = nQuoted_Total 
			ENDIF
		ENDIF
		
		IF nS_QTY > 0
		*	ThisForm.pgfPO.pgSOdist.txtSO_QTY.Value = nS_QTY 
			*Enable
			ThisForm.pgfPO.pgSOdist.grdPO_SOdist.Enabled = .T.
			ThisForm.pgfPO.pgSOdist.cmdNewPODist.Enabled = .T.
			ThisForm.pgfPO.pgSOdist.cmdSavePODist.Enabled = .T.
			ThisForm.pgfPO.pgSOdist.cmdDeletePODist.Enabled = .T.
			ThisForm.pgfPO.pgSOdist.txtSOitem.Enabled = .T.
			ThisForm.pgfPO.pgSOdist.txtPercent.Enabled = .T.
			ThisForm.pgfPO.pgSOdist.txtQTY.Enabled = .T.
			
			****************
			ThisForm.pgfPO.pgSOdist.grdPO_SOdist.RecordSource = ''
			
			IF USED('tmpPO_Dist')
				USE IN tmpPO_Dist
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT ID,POitem,SOitem,QTY,P,Total,[who],WO"
		    cSQL = cSQL + " FROM dbo.PO_SOdist WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_Dist')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_Dist' )
			ENDDO
			
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_Dist' )
			ELSE
				ThisForm.pgfPO.pgSOdist.grdPO_SOdist.RecordSource = 'tmpPO_Dist'
				
				************************
				
				IF USED('tmpPO_DQTY')
					USE IN tmpPO_DQTY
				ENDIF
				
				cSQL = "SELECT SUM(QTY) AS nQTY"
			    cSQL = cSQL + " FROM dbo.PO_SOdist WITH(NOLOCK) "
				cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_DQTY' )
				ENDDO
				
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_DQTY' )
				ELSE
					IF USED('tmpPO_DQTY')
						IF RECCOUNT('tmpPO_DQTY') > 0
							nDist_QTY = PrepareSQLnum(tmpPO_DQTY.nQTY,'QTY',18,4)
						ENDIF
						USE IN tmpPO_DQTY
					ENDIF
				ENDIF
				**********************
				
				SELECT tmpPO_Dist
				GO TOP
				
				ThisForm.pgfPO.pgSOdist.txtWO_PO_SO_Dist.Value	= PrepareSQLnum(tmpPO_Dist.WO,'WO',-3)
		
			ENDIF
		ELSE
			ThisForm.pgfPO.pgSOdist.txtSO_QTY.Value = 0
			*Disable
			ThisForm.pgfPO.pgSOdist.grdPO_SOdist.Enabled = .F.
			ThisForm.pgfPO.pgSOdist.cmdNewPODist.Enabled = .F.
			ThisForm.pgfPO.pgSOdist.cmdSavePODist.Enabled = .F.
			ThisForm.pgfPO.pgSOdist.cmdDeletePODist.Enabled = .F.
			ThisForm.pgfPO.pgSOdist.txtSOitem.Enabled = .F.
			ThisForm.pgfPO.pgSOdist.txtPercent.Enabled = .F.
			ThisForm.pgfPO.pgSOdist.txtQTY.Enabled = .F.
			
			ThisForm.pgfPO.pgSOdist.grdPO_SOdist.RecordSource = ''
		ENDIF
		
		**********************************************
		PRIVATE nPO_Qty, nPO_P, nPO_PU, nPO_Total, nPO_Pounds
		*Use Acct Stnd of PO
		nPO_Qty = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.Value,'S_QTY',-3)
		nPO_P 	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_P.Value,'S_P',-3)
		nPO_PU  = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.cmbOrder_PU.Value,'Order_PU',1,0)
		
		PRIVATE nOrder_QTY, nOrder, nOtherP 
		nOrder_QTY	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_QTY.Value,'Order_Qty',-5)
		nOrder_P	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.Value,'Order_P',-5)
		nOtherP 	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOtherP.Value,'OtherP',10,2)
		
		nPO_Total = ( nOrder_QTY * nOrder_P ) + nOtherP 
		*nPO_Qty * nPO_P
		
		nPO_Pounds = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPounds.Value,'Pounds',7,1)
		
		
		IF nPT_Total > 0
			nSO_Total = nPT_Total 
		ELSE
			IF nS_QTY > 0 AND nSO_P > 0
				nSO_Total = nSO_QTY * nSO_P
			ELSE
				nSO_Total = 0
			ENDIF
		ENDIF
		
		ThisForm.pgfPO.pgSOdist.txtSO_P.Value		= nS_P
		ThisForm.pgfPO.pgSOdist.txtPO_P.Value		= nPO_P
		
		ThisForm.pgfPO.pgSOdist.txtSO_QTY.Value 	= nS_QTY 
		ThisForm.pgfPO.pgSOdist.txtPO_QTY.Value		= nPO_Qty
		ThisForm.pgfPO.pgSOdist.txtDist_QTY.Value	= nDist_QTY 
		
		ThisForm.pgfPO.pgSOdist.txtSO_Total.Value	= nS_TOTAL
		ThisForm.pgfPO.pgSOdist.txtPOi_Total.Value	= nPO_Total 
		ThisForm.pgfPO.pgSOdist.txtDist_Total.Value	= nS_P * nDist_QTY 
		
		ThisForm.pgfPO.pgSOdist.txtReconcileTotal.Value = 0
		
		
	ENDPROC

	PROCEDURE show_vendcode
		PARAMETER pnVendCode
		*ThisForm.Show_VendCode()
		
		IF VARTYPE(pnVendCode) != 'N'
			ThisForm.VendCodeClear()
			RETURN .F.
		ENDIF
		
		*WAIT WINDOW "Show_VendCode" NOWAIT
		
		PRIVATE nVendCode, lBlank
		lBlank = .F.
		nVendCode = pnVendCode 
		
		
		IF NOT EMPTY(nVendCode)
			IF TYPE("nVendCode") = "N"
				IF nVendCode > 0
					*Get Address and Show
		
					IF USED( 'Vendor' )
						USE IN Vendor
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.Vendor "
					cSQL = cSQL + " WHERE VendCode = "+STR(nVendCode)
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Vendor' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Vendor' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Vendor")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Vendor')
					ENDIF
					IF USED('Vendor')
						ThisForm.nVendCode 	= Vendor.VendCode	
		*				ThisForm.nContactID = 0 && reset!
						ThisForm.pgfPO.pgVendor.txtVendCode.VALUE	= Vendor.VendCode 
						ThisForm.pgfPO.pgVendor.txtCompany.VALUE 	= Vendor.Company
						ThisForm.pgfPO.pgVendor.txtAddr1.VALUE 	= Vendor.Addr1
						ThisForm.pgfPO.pgVendor.txtAddr2.VALUE 	= Vendor.Addr2
						ThisForm.pgfPO.pgVendor.txtCity.VALUE		= Vendor.City
						ThisForm.pgfPO.pgVendor.txtST.VALUE 		= Vendor.ST
						ThisForm.pgfPO.pgVendor.txtZip.VALUE 		= Vendor.Zip
						ThisForm.pgfPO.pgVendor.txtCountry.VALUE 	= Vendor.Country
						ThisForm.pgfPO.pgVendor.txtLastEdit.VALUE	= PrepareSQLdate(Vendor.LastEdit,'LastEdit',.F.,.T.)
						ThisForm.pgfPO.pgVendor.QAApproved1.Value	= PrepareSQLnum(Vendor.QAApproved,'QAApproved',-1)
						ThisForm.pgfPO.pgVendor.Metal1.Value 		= PrepareSQLchk(Vendor.Metal,'Metal')
						ThisForm.pgfPO.pgVendor.Inactive1.Value 	= PrepareSQLchk(Vendor.Inactive,'Inactive')
						ThisForm.pgfPO.pgVendor.txtPeachID.Value 	= ShowSQLtxt(Vendor.PeachID,'PeachID',20)
		*				ThisForm.pgfPO.pgVendor.chkVendorPOConf	= PrepareSQLchk(PurchaseOrder.VendorPOConf,'VedorPOConf')
						ThisForm.pgfPO.pgVendor.chkVendorPOConf.Value	= PrepareSQLchk(VendorPOConf_POitem(ThisForm.cPOitem ,ThisForm.nConnHandle),'VedorPOConf')
						ThisForm.pgfPO.pgVendor.Vend_Notes.Value	= ShowSQLtxt(Vendor.Vend_Notes,'Vend_Notes',-1)
						ThisForm.pgfPO.pgVendor.Vend_Print.Value	= ShowSQLtxt(Vendor.Vend_Print,'Vend_Print',-1)
						
						ThisForm.pgfPO.pgPODesc.lblVendCode.Caption	= STR(Vendor.VendCode)
						ThisForm.pgfPO.pgPODesc.lblPeachID.Caption	= ShowSQLtxt(Vendor.PeachID,'PeachID',20)
						ThisForm.pgfPO.pgPODesc.txtCompany.Value	= Vendor.Company
						
		*				USE IN Vendor
					ENDIF
				ELSE
					lBlank = .T.
				ENDIF
			ELSE
				lBlank = .T.
			ENDIF
		ELSE
			lBlank = .T.
		ENDIF
		
		***********************
		IF lBlank
			*Show blanks
			ThisForm.VendorClear()
		
		ELSE
			ThisForm.pgfPO.pgVendor.cmdPOSearchBuyFrom.Enabled = .T.
			ThisForm.pgfPO.pgVendor.cmdEditAddr.Enabled = .T.
			ThisForm.pgfPO.pgVendor.cmdClearShip.Enabled = .T.
			
		ENDIF
		
		***********************
		IF USED('VendorContacts')
			USE IN VendorContacts
		ENDIF
		
		cSQL = "SELECT * FROM dbo.VendorContact "
		cSQL = cSQL + " WHERE VendCode = "+STR(ThisForm.nVendCode)
		cSQL = cSQL + " AND ISNULL(Inactive,0) = 0"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'VendorContacts' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'VendorContacts' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "VendorContacts")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "VendorContacts")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'VendorContacts')
		ENDIF
		IF USED('VendorContacts')
			INDEX ON ContactID TAG ContactID
			SET ORDER TO TAG ContactID
		ENDIF
		
		
	ENDPROC

	PROCEDURE sodistclear
		*SODistClear()
		*Disable
		ThisForm.pgfPO.pgSOdist.grdPO_SOdist.Enabled = .F.
		ThisForm.pgfPO.pgSOdist.cmdNewPODist.Enabled = .F.
		ThisForm.pgfPO.pgSOdist.cmdSavePODist.Enabled = .F.
		ThisForm.pgfPO.pgSOdist.cmdDeletePODist.Enabled = .F.
		ThisForm.pgfPO.pgSOdist.txtSOitem.Enabled = .F.
		ThisForm.pgfPO.pgSOdist.txtPercent.Enabled = .F.
		ThisForm.pgfPO.pgSOdist.txtQTY.Enabled = .F.
		
		ThisForm.pgfPO.pgSOdist.grdPO_SOdist.RecordSource = ''
		
		**
		ThisForm.pgfPO.pgSOdist.txtSO_P.Value		= 0
		ThisForm.pgfPO.pgSOdist.txtPO_P.Value		= 0
		
		ThisForm.pgfPO.pgSOdist.txtSO_QTY.Value 	= 0
		ThisForm.pgfPO.pgSOdist.txtDist_QTY.Value	= 0
		ThisForm.pgfPO.pgSOdist.txtPO_QTY.Value		= 0
		
		ThisForm.pgfPO.pgSOdist.txtSO_Total.Value	= 0
		ThisForm.pgfPO.pgSOdist.txtDist_Total.Value	= 0
		ThisForm.pgfPO.pgSOdist.txtPOi_Total.Value	= 0
		
		ThisForm.pgfPO.pgSOdist.txtWO_PO_SO_Dist.Value	= 0
		
	ENDPROC

	PROCEDURE stocklst_process_custom_save
		PARAMETERS nID_Detail, cSOitem, nWO, cSalesPerson, nPU, nStockLst_QTY, nPounds, dDueDate, cPoItem, cTBL
		*ThisForm.StockLst_Process_Custom_Save( nID_Detail, cSOitem, nWO, cSalesPerson, nPPC, cComment, dDueDate, cPoItem, "S" )
		
		
		*NOT nPieces,nPounds,cComment
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtWO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		PRIVATE cAllowSub
		PRIVATE cProcess_ID, cProcessor, cComment
		
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item("STOCK")
			*Only create a 'SELECTED' process WHEN not for Stock!
			RETURN .T.
		ENDIF
		
		cAllowSub 	= 'N'
		cProcess_ID = "SELECTED"
		
		PRIVATE cMach_User, cUserName 
		cMach_User = SYS(0)
		cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		
		cProcessor	= ShowSQLtxt(cUserName,'User',20)
		cComment = "Custom Stock - Do not substitue!" 
		cComment = cComment+CHR(13)+"This SELECTED process was created for the PO item:"+ALLTRIM(cPoItem)+"."
		
		PRIVATE cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= ''
		nPrc_PCs	= 0
		nPrc_Dim1	= 0
		nPrc_Dim2	= 0
		nPrc_Dim3	= 0
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		**Check for existing Process
		PRIVATE lNewProcess
		lNewProcess =.F.
		PRIVATE nID_Detail_Process, nReceivingID
		nID_Detail_Process = 0
		nReceivingID = 0
		
		cSQL = "SELECT ID_Detail_Process, ReceivingID FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + "dbo.StockLst_Process "
		
		CASE cTBL = "B"
			cSQL = cSQL + "dbo.BrokerLst_Process "
		
		CASE cTBL = "W"
			cSQL = cSQL + "dbo.WIPLst_Process "
		
		ENDCASE
		**cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)  **ID_Detail has changed!!  **Saving the PO, deleted and Recreated the ID,ID_Detail!!
		cSQL = cSQL + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
		*Process_ID = "NOT2HPA"
		
		*cSQL = cSQL + " AND SOitem = dbo.ProperSO('"+cSOitem+"')"
		cSQL = cSQL + " AND PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		*cSQL = cSQL + " AND Comment LIKE '%Custom Stock%'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.ID_Detail_Process,'ID_Detail_Process',-3)
				nReceivingID = PrepareSQLnum(tmpID_Detail_Process.ReceivingID,'ReceivingID ',-3)
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
					
		
		IF nID_Detail_Process = 0
			*New Process
			cProcess_ID = "SELECTED"
			
			cSQLi = "EXEC dbo.p_Lst_Process_ins "
			cSQLi = cSQLi + " @TBL = '"+cTBL+"'"
			cSQLi = cSQLi + ",@ID_Detail = "+STR(nID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
			cSQLi = cSQLi + ",@StartDate = '"+TTOC(DATETIME())+"'"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+PrepareSQLtxt(cAllowSub,'AllowSub',1)+"'"
		
			cSQLi = cSQLi + ",@PU	="+STR(nPU)
			cSQLi = cSQLi + ",@QTY	="+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Pounds ="+STR(nPounds,9,1)
			
			cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
			cSQLi = cSQLi + ",@PO_item = '"+cPOitem+"'"
			cSQLi = cSQLi + ",@WO	= "+STR(nWO)
			cSQLi = cSQLi + ",@WO_Detail= "+STR(nWO_Detail)
				
			cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
			cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
			cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
			cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID)
			
			cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
			cSQLi = cSQLi + ",@Prc_PCs  = "+STR(nPrc_PCs)
			cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
			cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
			cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
			
			cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Ordered_P = "+STR(0,18,4)
				
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			IF nSQLEXEC < 0
				*retry
				WAIT WINDOW 'Slow SQL' TIMEOUT 3
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 1
				SQLExecError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				TrackError("Could not EXEC dbo.p_Lst_Process_ins","p_Lst_Process_ins ","EnterOrder.StockLst_Process_Custom_Save()",LINENO(1))
			ELSE
		
		*		=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpID_Detail_Process")
					nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.exp,'ID_Detail_Process',-3)
					USE IN tmpID_Detail_Process
				ELSE
					nID_Detail_Process = 0
				ENDIF
		
			ENDIF
			
		ELSE
			*Update nID_Detail_Process
			DO CASE
			CASE cTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Process SET "
			CASE cTBL = "B"
				cSQL = "UPDATE dbo.BrokerLst_Process SET "
			CASE cTBL = "W"
				cSQL = "UPDATE dbo.WIPLst_Process SET "
			ENDCASE
			cSQL = cSQL+ " SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL+ ",PO_item = dbo.f_ProperPOitem('"+cPOItem+"')"
			cSQL = cSQL+ ",SalesPerson= '"+cSalesPerson+"'"
			*cSQL = cSQL+ ",StartDate='"+IIF(EMPTY(dtStartDate),'',TTOC(dtStartDate))+"'"
			cSQL = cSQL+ ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQL = cSQL+ ",AllowSub='"+STRTRAN(cAllowSub,"'","''")+"'"
			cSQL = cSQL+ ",PU="+STR(nPU)
			cSQL = cSQL+ ",Process_ID='"+cProcess_ID+"'"
			cSQL = cSQL+ ",Processor='"+cProcessor+"'"
			cSQL = cSQL+ ",Comment='"+STRTRAN(cComment,"'","''")+"'"
			cSQL = cSQL+ ",QTY="+STR(nStockLst_QTY,18,4)
			cSQL = cSQL+ ",Pounds="+STR(nPounds,9,1)
			cSQL = cSQL+ ",ID_Detail="+STR(nID_Detail)
			cSQL = cSQL+ ",WO="+STR(nWO)
			
			cSQLi = cSQLi + ",Prc_Form = '"+cPrc_Form+"'"
			cSQLi = cSQLi + ",Prc_PCs  = "+STR(nPrc_PCs)
			cSQLi = cSQLi + ",Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
			cSQLi = cSQLi + ",Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
			cSQLi = cSQLi + ",Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
			cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nStockLst_QTY,18,4)
		*	cSQLi = cSQLi + ",@Ordered_P = "+STR(0,18,4)
		
			
			cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				lOK = .F.
			ELSE
		
			ENDIF
		ENDIF
		
		IF lOK 
			
		ENDIF
		
	ENDPROC

	PROCEDURE stocklst_process_remove_custom
		PARAMETERS nID_Detail, cPoItem, cTableName
		*ThisForm.StockLst_Process_Remove_Custom( nID_Detail, cPoItem, 'StockLst' )
		* Duplicated in WorkOrder
		
		PRIVATE cSQLi, nSQLEXEC, lOK, cTBL
		lOK = .T.
		
		*cComment = "Custom Stock - Do not select as typical stock!" 
		
		IF UPPER(cTableName) != "STOCKLST"
			*came from Broker- Find nID_Detail of StockLst to Delete
			cTBL="B"
			nID_Detail = 0
			IF USED("tmpID_Detail_ProcessIDD")
				USE IN tmpID_Detail_ProcessIDD
			ENDIF
			
			cSQL = "SELECT ID_Detail FROM dbo.StockLst_Process "
			cSQL = cSQL + " WHERE Process_ID = 'SELECTED'"
			cSQL = cSQL + " AND PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
			cSQL = cSQL + " AND Comment LIKE 'Custom Stock - Do not select as typical stock!%'"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_ProcessIDD')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_ProcessIDD' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_ProcessIDD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_ProcessIDD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_ProcessIDD' )
			ENDIF
		
			IF USED('tmpID_Detail_ProcessIDD')
				IF VARTYPE(tmpID_Detail_ProcessIDD.ID_Detail) = "N"
					nID_Detail = tmpID_Detail_ProcessIDD.ID_Detail
				ENDIF
				USE IN tmpID_Detail_ProcessIDD
			ENDIF
						
			cTableName = "StockLst"
		ELSE
			cTBL = "S"
		ENDIF
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		**Check for existing Proc
		PRIVATE lNewProcess
		lNewProcess =.F.
		PRIVATE nID_Detail_Process
		nID_Detail_Process = 0
		
		cSQL = "SELECT ID_Detail_Process FROM dbo.StockLst_Process "
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		cSQL = cSQL + " AND Process_ID = 'SELECTED'"
		*cSQL = cSQL + " AND SOitem = dbo.ProperSO('"+cSOitem+"')"
		cSQL = cSQL + " AND PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		cSQL = cSQL + " AND Comment LIKE 'Custom Stock - Do not select as typical stock!%'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF VARTYPE(tmpID_Detail_Process.ID_Detail_Process) = "N"
				nID_Detail_Process = tmpID_Detail_Process.ID_Detail_Process
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
					
		IF nID_Detail_Process > 0
			*DELETE
			
			IF Remove_ID_Detail_Process(nID_Detail_Process,"POitem",cPOitem,cTbl,ThisForm.nConnHandle,"CANCELLED")
				lOK = .T.
			ELSE
				lOK = .F.
			ENDIF
		ENDIF
		
		IF lOK 
			
		ENDIF
		RETURN lOK 
		
	ENDPROC

	PROCEDURE stocklst_process_save
		PARAMETERS nID_Detail, cSOitem, cSalesPerson, nPounds, nPieces, nPU, nStockLst_QTY, nPounds, dDueDate, cPoItem, cTBL
		*ThisForm.StockLst_Process_Save       ( nID_Detail, cSOitem, cSalesPerson, nPounds, nPieces, nPU, nStockLst_QTY, nPounds, cComment, dDueDate, cPoItem, 'StockLst' )
		
		*not cComment, nPieces
		DO CASE
		CASE cTBL = "StockLst"
			cTBL = "S"
		CASE cTBL = "BrokerLst"
			cTBL = "B"
		CASE cTBL = "WIPLst"
			cTBL = "W"
		ENDCASE
		
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		PRIVATE cAllowSub
		PRIVATE cProcess_ID, cProcessor
		
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item("STOCK")
			*Only create a 'SELECTED' WHEN not Stock!
			RETURN .T.
		ENDIF
		
		cAllowSub 	= 'N'
		cProcess_ID = "SELECTED"
		
		PRIVATE cMach_User, cUserName 
		cMach_User = SYS(0)
		cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		
		cProcessor	= ShowSQLtxt(cUserName,'User',20)
		cComment	= "This SELECTED process was created for SOitem:"+ALLTRIM(cSOitem)+" when the PO item:"+ALLTRIM(cPoItem)+" was saved."
		
		PRIVATE cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= ''
		nPrc_PCs	= 0
		nPrc_Dim1	= 0
		nPrc_Dim2	= 0
		nPrc_Dim3	= 0
		
		PRIVATE nWO, nWO_Detail
		nWO			= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.lblWOnum.Caption,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.lblWO_Dnum.Caption,'WO_Detail',-3)
		IF nWO_Detail = 0
			nWO_Detail = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtWO_Detail.Value,'WO_Detail',-3)
		ENDIF
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		**Check for existing Proc
		PRIVATE lNewProcess
		lNewProcess =.F.
		PRIVATE nID_Detail_Process, nReceivingID 
		nID_Detail_Process = 0
		nReceivingID = 0
		
		cSQL = "SELECT ID_Detail_Process, ReceivingID FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + "dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = cSQL + "dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = cSQL + "dbo.WIPLst_Process "
		ENDCASE
		
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		cSQL = cSQL + " AND ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
		cSQL = cSQL + " AND SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF VARTYPE(tmpID_Detail_Process.ID_Detail_Process) = "N"
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.ID_Detail_Process,'ID_Detail_Process',-3)
				nReceivingID = PrepareSQLnum(tmpID_Detail_Process.ReceivingID,'ReceivingID ',-3)
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
					
		*SOitem = 'STOCK'
		IF nID_Detail_Process = 0
			*New Process
			cProcess_ID = "SELECTED"
			
			
			cSQLi = "EXEC dbo.p_Lst_Process_ins "
			cSQLi = cSQLi + " @TBL = '"+cTBL+"'"
			cSQLi = cSQLi + ",@ID_Detail = "+STR(nID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+PrepareSQLtxt(cSalesPerson,'SalesPerson',20)+"'"
			cSQLi = cSQLi + ",@StartDate = '"+TTOC(DATETIME())+"'"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+PrepareSQLtxt(cAllowSub,'AllowSub',1)+"'"
		
			cSQLi = cSQLi + ",@PU	="+STR(nPU)
			cSQLi = cSQLi + ",@QTY	="+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Pounds ="+STR(nPounds,9,1)
			
			cSQLi = cSQLi + ",@SOitem = '"+Proper_SO_Item(cSOitem)+"'"
			cSQLi = cSQLi + ",@PO_Item = '"+Proper_PO_item(cPoItem)+"'"
			cSQLi = cSQLi + ",@WO	= "+STR(nWO)
			cSQLi = cSQLi + ",@WO_Detail= "+STR(nWO_Detail)
				
			cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
			cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
			cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
			cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID)
			
			cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
			cSQLi = cSQLi + ",@Prc_PCs  = "+STR(nPrc_PCs)
			cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
			cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
			cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
			
			cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Ordered_P = "+STR(0,18,4)	
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			IF nSQLEXEC < 0
				*retry
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLExecError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				TrackError("Could not EXEC dbo.p_Lst_Process_ins ","p_Lst_Process_ins ","EnterOrder.StockLst_Process_Save()",LINENO(1))
			ELSE
		
		*		=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpID_Detail_Process")
					nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.exp,'ID_Detail_Process',-3)
					USE IN tmpID_Detail_Process
				ELSE
					nID_Detail_Process = 0
				ENDIF
		
			ENDIF
			
		ELSE
			*Update
			IF cTBL = "S"
				cSQL = "UPDATE dbo.StockLst_Process SET "
			ELSE
				cSQL = "UPDATE dbo.BrokerLst_Process SET "
			*	cSQL = "UPDATE dbo.WIPLst_Process SET "???
			ENDIF
			
			cSQL = cSQL+ " SOitem= dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL+ ",PO_item= dbo.f_ProperPOitem('"+cPOItem+"')"
			cSQL = cSQL+ ",SalesPerson='"+PrepareSQLtxt(cSalesPerson,'SalesPerson',20)+"'"
			*cSQL = cSQL+ ",StartDate='"+IIF(EMPTY(dtStartDate),'',TTOC(dtStartDate))+"'"
			cSQL = cSQL+ ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQL = cSQL+ ",AllowSub='"+cAllowSub+"'"
			cSQL = cSQL+ ",PU="+STR(nPU)
			cSQL = cSQL+ ",Process_ID='"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
			cSQL = cSQL+ ",Processor='"+PrepareSQLtxt(cProcessor,'Processor',20)+"'"
			cSQL = cSQL+ ",Comment='"+PrepareSQLtxt(cComment,'Comment',100)+"'"
			cSQL = cSQL+ ",QTY="+STR(nStockLst_QTY,18,4)
			cSQL = cSQL+ ",Pounds="+STR(nPounds,9,1)
			cSQL = cSQL+ ",WO="+STR(nWO)
			*cSQL = cSQL+ ",ID_Detail="+STR(nID_Detail)???
			
			cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				lOK = .F.
			ELSE
		
			ENDIF
		ENDIF
		
		IF lOK 
			*ThisForm.RELEASE
		ENDIF
	ENDPROC

	PROCEDURE stock_select_process
		PARAMETERS nID_Detail, cSOitem, cSalesPerson, nPU, nStockLst_QTY, nPounds, dDueDate, cPoItem, cTBL
		*ThisForm.Stock_Select_Process ( nID_Detail, cSOitem, cSalesPerson, nPPC, cComment, dDueDate, cPoItem, 'StockLst' )
		
		
		*NOT nPieces,nPounds,cComment,cTBL
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		PRIVATE cAllowSub
		PRIVATE cProcess_ID, cProcessor, cComment
		
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item("STOCK")
			*Only create a 'SELECTED' process WHEN not for Stock!
			RETURN .T.
		ENDIF
		
		PRIVATE nWO, nWO_Detail
		nWO	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.lblWOnum.Caption,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.lblWO_Dnum.Caption,'WO_Detail',-3)
		IF nWO_Detail = 0
			nWO_Detail = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtWO_Detail.Value,'WO_Detail',-3)
		ENDIF
		
		PRIVATE nCountSELECTED_SO, nCountSELECTED_WO
		nCountSELECTED_SO = StockLst_Process_Count_SOitem( cSOitem, cTBL, ThisForm.nConnHandle, "SELECTED")
		nCountSELECTED_WO = StockLst_Process_Count_WO( nWO, cTBL, ThisForm.nConnHandle, "SELECTED")
		
		
		cAllowSub 	= 'N'
		cProcess_ID = "SELECTED"
		
		PRIVATE cMach_User, cUserName 
		cMach_User = SYS(0)
		cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		
		cProcessor	= ShowSQLtxt(cUserName,'User',20)
		cComment = "This SELECTED process was created for the PO item:"+ALLTRIM(cPoItem)+"."
		
		PRIVATE cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= ''
		nPrc_PCs	= 0
		nPrc_Dim1	= 0
		nPrc_Dim2	= 0
		nPrc_Dim3	= 0
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		**Check for existing SELECTED Proc  --Using POitem and (SOitem or WO)
		PRIVATE lNewProcess
		lNewProcess =.F.
		PRIVATE nID_Detail_Process, nReceivingID, cTBLselected
		nID_Detail_Process = 0
		nReceivingID = 0
		cTBLselected = ''
		
		cSQL = "SELECT ID_Detail_Process, ReceivingID, 'S' AS TBL "
		cSQL = cSQL + " FROM dbo.StockLst_Process "
		cSQL = cSQL + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
		cSQL = cSQL + " AND PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
			cSQL = cSQL + " AND SOitem = dbo.f_ProperSO('"+cSOitem+"')"
		ENDIF
		IF nWO > 0
			cSQL = cSQL + " AND WO = "+STR(nWO)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT ID_Detail_Process, ReceivingID, 'B' AS TBL "
		cSQL = cSQL + " FROM dbo.BrokerLst_Process "
		cSQL = cSQL + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
		cSQL = cSQL + " AND PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
			cSQL = cSQL + " AND SOitem = dbo.f_ProperSO('"+cSOitem+"')"
		ENDIF
		IF nWO > 0
			cSQL = cSQL + " AND WO = "+STR(nWO)
		ENDIF
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT ID_Detail_Process, ReceivingID, 'W' AS TBL "
		cSQL = cSQL + " FROM dbo.WIPLst_Process "
		cSQL = cSQL + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
		cSQL = cSQL + " AND PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
			cSQL = cSQL + " AND SOitem = dbo.f_ProperSO('"+cSOitem+"')"
		ENDIF
		IF nWO > 0
			cSQL = cSQL + " AND WO = "+STR(nWO)
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
		ENDIF
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process') > 0
				nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.ID_Detail_Process,'ID_Detail_Process',-3)
				nReceivingID = PrepareSQLnum(tmpID_Detail_Process.ReceivingID,'ReceivingID ',-3)
				cTBLselected = PrepareSQLtxt(tmpID_Detail_Process.TBL,'TBL',1)
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		**************************
		
		IF nID_Detail_Process > 0
			IF cTBL <> cTBLselected 
				*Found Selected, but in wrong Table
				*Remove The SELECTED Proc in cTBLselected 
				lOK = StockLst_Process_Delete( nID_Detail_Process, cTBLselected, ThisForm.nConnHandle)
				IF lOK
					nID_Detail_Process = 0
				ENDIF
			ENDIF
		ENDIF
		
		**************************
		IF nID_Detail_Process = 0
			**Check for existing SELECTED Proc  
			*--Just Using POitem and NOT (SOitem or WO)
		
			cSQL = "SELECT ID_Detail_Process, ReceivingID, 'S' AS TBL "
			cSQL = cSQL + " FROM dbo.StockLst_Process "
			cSQL = cSQL + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
			cSQL = cSQL + " AND PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT ID_Detail_Process, ReceivingID, 'B' AS TBL "
			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
			cSQL = cSQL + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
		
			cSQL = cSQL + " UNION "
			cSQL = cSQL + " SELECT ID_Detail_Process, ReceivingID, 'W' AS TBL "
			cSQL = cSQL + " FROM dbo.WIPLst_Process "
			cSQL = cSQL + " WHERE ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
			cSQL = cSQL + " AND PO_item = dbo.f_ProperPOitem('"+cPoItem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Process' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process' )
			ENDIF
		
			IF USED('tmpID_Detail_Process')
				IF RECCOUNT('tmpID_Detail_Process') > 0
					nID_Detail_Process = PrepareSQLnum(tmpID_Detail_Process.ID_Detail_Process,'ID_Detail_Process',-3)
					*nReceivingID = PrepareSQLnum(tmpID_Detail_Process.ReceivingID,'ReceivingID ',-3)
					*cTBLselected = PrepareSQLtxt(tmpID_Detail_Process.TBL,'TBL',1)
				ENDIF
				USE IN tmpID_Detail_Process
			ENDIF
		ENDIF
		
		**************************
		IF nID_Detail_Process = 0
			*Create a New Process
			cProcess_ID = "SELECTED"
				
			
			cSQLi = "EXEC dbo.p_Lst_Process_ins "
			cSQLi = cSQLi + " @TBL = '"+cTBL+"'"
			cSQLi = cSQLi + ",@ID_Detail = "+STR(nID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+PrepareSQLtxt(cSalesPerson,'SalesPerson',20)+"'"
			cSQLi = cSQLi + ",@StartDate = '"+TTOC(DATETIME())+"'"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+PrepareSQLtxt(cAllowSub,'AllowSub',1)+"'"
		
			cSQLi = cSQLi + ",@PU	="+STR(nPU)
			cSQLi = cSQLi + ",@QTY	="+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Pounds ="+STR(nPounds,9,1)
			
			cSQLi = cSQLi + ",@SOitem = '"+Proper_SO_Item(cSOitem)+"'"
			cSQLi = cSQLi + ",@PO_Item = '"+Proper_PO_item(cPoItem)+"'"
			cSQLi = cSQLi + ",@WO	= "+STR(nWO)
			cSQLi = cSQLi + ",@WO_Detail= "+STR(nWO_Detail)
				
			cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
			cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
			cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
			cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID)
			
			cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
			cSQLi = cSQLi + ",@Prc_PCs  = "+STR(nPrc_PCs)
			cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
			cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
			cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
				
			cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nStockLst_QTY,18,4)
			cSQLi = cSQLi + ",@Ordered_P = "+STR(0,18,4)	
				
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			IF nSQLEXEC < 0
				*retry
				WAIT WINDOW 'Slow SQL' TIMEOUT 3
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 1
				SQLExecError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				TrackError("Could not EXEC dbo.p_Lst_Process_ins ","p_Lst_Process_ins ","EnterOrder.StockLst_Process_Custom_Save()",LINENO(1))
			ELSE
		
		*		=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpID_Detail_Process")
					nID_Detail_Process = tmpID_Detail_Process.exp		
					USE IN tmpID_Detail_Process
				ELSE
					nID_Detail_Process = 0
				ENDIF
				IF nID_Detail_Process > 0
					*Update the fields not found in EXEC dbo.p_ _Process_ins
					DO CASE
					CASE cTBL="S"
						cSQL = "UPDATE dbo.StockLst_Process SET "
					CASE cTBL="B"
						cSQL = "UPDATE dbo.BrokerLst_Process SET "
					CASE cTBL="W"
						cSQL = "UPDATE dbo.WIPLst_Process SET "
					ENDCASE
					cSQL = cSQL+ " WO="+STR(nWO)
		
					cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
						lOK = .F.
					ELSE
						lOK = .T.
					ENDIF
					
				ENDIF
			ENDIF
			
		ELSE
			*nID_Detail_Process > 0
			*Update
			DO CASE
			CASE cTBL="S"
				cSQL = "UPDATE dbo.StockLst_Process SET "
			CASE cTBL="B"
				cSQL = "UPDATE dbo.BrokerLst_Process SET "
			CASE cTBL="W"
				cSQL = "UPDATE dbo.WIPLst_Process SET "
			ENDCASE
			cSQL = cSQL+ " SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL+ ",PO_item = dbo.f_ProperPOitem('"+cPOItem+"')"
			cSQL = cSQL+ ",SalesPerson= '"+cSalesPerson+"'"
			*cSQL = cSQL+ ",StartDate='"+IIF(EMPTY(dtStartDate),'',TTOC(dtStartDate))+"'"
			cSQL = cSQL+ ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQL = cSQL+ ",AllowSub='"+STRTRAN(cAllowSub,"'","''")+"'"
			cSQL = cSQL+ ",PU="+STR(nPU)
			cSQL = cSQL+ ",Process_ID='"+cProcess_ID+"'"
			cSQL = cSQL+ ",Processor='"+cProcessor+"'"
			cSQL = cSQL+ ",Comment='"+STRTRAN(cComment,"'","''")+"'"
			cSQL = cSQL+ ",QTY="+STR(nStockLst_QTY,18,4)
			cSQL = cSQL+ ",Pounds="+STR(nPounds,9,1)
			cSQL = cSQL+ ",ID_Detail="+STR(nID_Detail)
			cSQL = cSQL+ ",WO="+STR(nWO)
		
			cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(nID_Detail_Process)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				lOK = .F.
			ELSE
				lOK = .T.
			ENDIF
		ENDIF
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE sumstocklstcost
		*ThisForm.sumStockLstCost()
		RETURN
		
		
		PRIVATE nSO,cSO
		nSO = PrepareSQLnum(ThisForm.SalesNum,'SalesNum',-3)
		
		IF nSO = 0
			RETURN
		ENDIF
		cSO = ALLTRIM(STR(nSO))
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = " SELECT p.SOitem "
		*cSQL = cSQL + ",dbo.f_CalcStkCost(M.Form,P.PPc,D.Dim2,D.Dim3,P.PWeight,D.CostValue) AS Cost "
		cSQL = cSQL + ",dbo.f_CalcStkCost(M.Form,P.PPc,D.Dim2,D.Dim3,P.Pounds,D.CostValue) AS Cost "
		cSQL = cSQL + ",M.PO_item "
		cSQL = cSQL + ",P.Process_ID "
		cSQL = cSQL + ",'S' AS TBL "
		cSQL = cSQL + " FROM dbo.StockLst_Master M "
		cSQL = cSQL + ",dbo.StockLst_Detail D, dbo.StockLst_Process P "
		*cSQL = cSQL + "WHERE M.PO_item LIKE '%502287-[0-9][0-9]'"
		cSQL = cSQL + "WHERE P.SOitem LIKE '%"+cSO+"-'"
		*SOitem <> 'STOCK'
		cSQL = cSQL + "AND D.ID = M.ID AND D.ID_Detail = P.ID_Detail "
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT p.SOitem "
		cSQL = cSQL + ",M.PO_item "
		*cSQL = cSQL + ",dbo.f_CalcStkCost(M.Form,P.PPc,D.Dim2,D.Dim3,P.PWeight,D.CostValue) AS Cost "
		cSQL = cSQL + ",dbo.f_CalcStkCost(M.Form,P.PPc,D.Dim2,D.Dim3,P.Pounds,D.CostValue) AS Cost "
		cSQL = cSQL + ",P.Process_ID "
		cSQL = cSQL + ",'B' AS TBL "
		cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
		cSQL = cSQL + ",dbo.BrokerLst_Detail D, dbo.BrokerLst_Process P "
		*cSQL = cSQL + "WHERE M.PO_item LIKE '%502287-[0-9][0-9]' "
		cSQL = cSQL + "WHERE P.SOitem LIKE '%"+cSO+"-'"  &&SOitem <> 'STOCK'
		cSQL = cSQL + "AND D.ID = M.ID AND D.ID_Detail = P.ID_Detail "
		
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT p.SOitem "
		cSQL = cSQL + ",M.PO_item "
		*cSQL = cSQL + ",dbo.f_CalcStkCost(M.Form,P.PPc,D.Dim2,D.Dim3,P.PWeight,D.CostValue) AS Cost "
		cSQL = cSQL + ",dbo.f_CalcStkCost(M.Form,P.PPc,D.Dim2,D.Dim3,P.Pounds,D.CostValue) AS Cost "
		cSQL = cSQL + ",P.Process_ID "
		cSQL = cSQL + ",'W' AS TBL "
		cSQL = cSQL + " FROM dbo.WIPLst_Master M "
		cSQL = cSQL + ",dbo.WIPLst_Detail D, dbo.WIPLst_Process P "
		*cSQL = cSQL + "WHERE M.PO_item LIKE '%502287-[0-9][0-9]' "
		cSQL = cSQL + "WHERE P.SOitem LIKE '%"+cSO+"-'"  &&SOitem <> 'STOCK'
		cSQL = cSQL + "AND D.ID = M.ID AND D.ID_Detail = P.ID_Detail "
		
		IF USED('tmpSumSoStock')
			USE IN tmpSumSoStock
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSumSoStock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumSoStock')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSumSoStock')
			RETURN
		ENDIF
		
		PRIVATE cCurrSOitem
		SELECT tmpSumSoStock
		IF RECCOUNT("tmpSumSoStock") > 0
			SCAN
				cCurrSOitem = tmpSumSoStock.SOitem
			ENDSCAN
		ENDIF
		
		IF USED('tmpSumSoStock')
			USE IN tmpSumSoStock
		ENDIF
		
		
		IF USED('tmpSelStock')
			USE IN tmpSelStock
		ENDIF
		
		
	ENDPROC

