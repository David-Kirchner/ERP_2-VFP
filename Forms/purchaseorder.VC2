	ENDPROC

	PROCEDURE check4poitem
		*ThisForm.Check4POItem()
		*Checks exist, If found can grab to edit.
		
		PRIVATE nHpaPo,m.nItemPO,m.cPOItem
		*nHpaPo		= ThisForm.frmEO.Pageframe1.pgAdd.pfAdd.pgDesc.txtHPApo.VALUE
		nHpaPo		= ThisForm.pgfPO.pgPODesc.txtHpaPo.Value
		*m.nItemPo		= ThisForm.frmEO.Pageframe1.pgAdd.pfAdd.pgDesc.txtItempo.VALUE
		m.nItemPo		= ThisForm.pgfPO.pgPODesc.txtItempo.Value
		
		IF TYPE('nHpaPo') = "C"
			nHpaPo = VAL(nHpaPo)
		ENDIF
		IF EMPTY(nHpaPo)
			RETURN .F.
		ENDIF
		
		IF TYPE('m.itemPO') = "C"
			m.nItemPO= VAL(m.itemPO)
		ENDIF
			
		PRIVATE nCntPOitem	
		nCntPOitem = 0
		
		IF nHpaPo > 0 AND m.nItemPO > 0
		
			cPOItem = Proper_PO_item( STR(nHpaPo)+"-"+STR(m.nItemPO,2,0) )
			nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisForm.nConnHandle )
				
			*SEEK cPOItem IN PurchaseOrder ORDER POItem
			IF nCntPOitem > 0
				*Found PO Item!
			
		*		ThisForm.frmEO.Pageframe1.pgAdd.pfAdd.pgPODesc.Edit1.Value = "Item "+ALLTRIM(STR(nItemPO,2,0))+" already entered."+CHR(13)+"Found PO :"+m.cPOItem
		*		ThisForm.frmEO.Pageframe1.pgAdd.pfAdd.pgPODesc.Edit1.refresh
				PRIVATE nMessAns
				nMessAns = MESSAGEBOX("PO - Item already entered"+CHR(13)+;
				"Item number '"+STR(nItemPO,2,0)+"' cannot be used again."+CHR(13)+CHR(13)+;
				"Do you want to edit this item?"+CHR(13)+CHR(13)+;
				"Answer no if you need to change Item.",4+32,"Can not enter twice")
				
				IF nMessAns = 6  &&Edit PO Item
					ThisForm.POEditing = .T.
					
					IF USED('tmpPO')
						USE IN tmpPO
					ENDIF
					
					PRIVATE cSQL, nSQLEXEC
					cSQL = "SELECT * FROM dbo.PurchaseOrder "
					cSQL = cSQL + " WHERE POitem = '"+m.cPOItem+"'"
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO' )
					ENDIF
					
					IF USED('tmpPO')
						IF NOT EOF('tmpPO')
		
							ThisForm.pgfPO.pgPODesc.txtSalesNum.VALUE	= tmpPO.SalesNum   &&Keep as String , becuase could be STOCK
							ThisForm.SalesNum 							= tmpPO.SalesNum
							ThisForm.pgfPO.pgPODesc.txtitem.VALUE		= PrepareSQLnum(tmpPO.item,'Item',2,0)
							ThisForm.pgfPO.pgPODesc.txtHpaPo.Value		= PrepareSQLnum(tmpPO.HPAPo,'HPAPO',-3)
							ThisForm.pgfPO.pgPODesc.txtItempo.VALUE		= PrepareSQLnum(tmpPO.ItemPO,'ItemPO',2,0)
							ThisForm.pgfPO.pgPODesc.txtPO_Rev.VALUE		= ALLTRIM(STR( getPO_NO_Rev(nHPAPO,ThisForm.nConnHandle) ))
							ThisForm.cPOitem 							= tmpPO.POitem
		
							ThisForm.pgfPO.pgPODesc.txtCompany.VALUE	= ShowSQLtxt(tmpPO.Company,'Company',100)
							ThisForm.pgfPO.pgPODesc.txtSalesP.VALUE		= ShowSQLtxt(tmpPO.SalesP,'SalesP',1)
							ThisForm.pgfPO.pgPODesc.txtCover.VALUE		= ShowSQLtxt(tmpPO.Cover,'Cover',1)
		
							ThisForm.pgfPO.pgPODesc.txtPieces.VALUE		= PrepareSQLnum(tmpPO.Pieces,'Pieces',6,0)					
							ThisForm.pgfPO.pgPODesc.txtAlloy.VALUE		= ShowSQLtxt(tmpPO.Alloy,'Alloy',12)
							ThisForm.pgfPO.pgPODesc.cmbForm.VALUE		= ShowSQLtxt(tmpPO.Form,'Form',2)
							ThisForm.pgfPO.pgPODesc.cmbCC.VALUE			= ShowSQLtxt(tmpPO.CC,'CC',1)
							ThisForm.pgfPO.pgPODesc.cmbCL.VALUE			= ShowSQLtxt(tmpPO.CL,'CL',1)
							ThisForm.pgfPO.pgPODesc.txtThck.VALUE		= PrepareSQLnum(tmpPO.Thck,'Thck',10,4)
							ThisForm.pgfPO.pgPODesc.txtSz2.VALUE		= PrepareSQLnum(tmpPO.Sz2,'Sz2',10,3)
							ThisForm.pgfPO.pgPODesc.txtSz3.VALUE		= PrepareSQLnum(tmpPO.Sz3,'Sz3',10,3)
							ThisForm.pgfPO.pgPODesc.chkRandLen.VALUE	= PrepareSQLchk(tmpPO.RandLen,'RandLen')
							ThisForm.pgfPO.pgPOdesc.chkMetric.VALUE		= PrepareSQLchk(tmpPO.Metric,'Metric')										
							ThisForm.pgfPO.pgPOdesc.chkOddCut.VALUE		= PrepareSQLchk(tmpPO.OddCut,'OddCut')
					*depricated			
							ThisForm.pgfPO.pgPODesc.txtP_lb.VALUE		= PrepareSQLnum(tmpPO.P_lb,'P_Lb',10,2)
							ThisForm.pgfPO.pgPODesc.txtP_pc.VALUE		= PrepareSQLnum(tmpPO.P_pc,'P_Pc',10,2)
							ThisForm.pgfPO.pgPODesc.txtP_ft.VALUE		= PrepareSQLnum(tmpPO.P_ft,'P_Ft',10,2)
							ThisForm.pgfPO.pgPODesc.txtLotP.VALUE		= PrepareSQLnum(tmpPO.LotP,'LotP',10,2)
					*depricated			
							ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.VALUE	= PrepareSQLnum(tmpPO.StockLst_QTY,'StockLst_QTY',-5)
							ThisForm.pgfPO.pgPODesc.txtStockLst_P.VALUE		= PrepareSQLnum(tmpPO.StockLst_P,'StockLst_P',-5)
							ThisForm.pgfPO.pgPODesc.txtStockLst_PU.VALUE	= PrepareSQLnum(tmpPO.StockLst_PU,'StockLst_PU',-1)
							
							ThisForm.pgfPO.pgPOdesc.lblPerUnit.Caption	= FormUnitCaption(tmpPO.Form,tmpPO.Services,tmpPO.ConvServ,tmpPO.Equipment,tmpPO.IntP,ThisForm.nConnHandle)
		
							ThisForm.pgfPO.pgPODesc.txtOrder_Qty.VALUE	= PrepareSQLnum(tmpPO.Order_Qty,'Order_QTY',-5)
							ThisForm.pgfPO.pgPODesc.txtOrder_P.VALUE	= PrepareSQLnum(tmpPO.Order_P,'Order_P',-5)
							ThisForm.pgfPO.pgPODesc.cmbOrder_PU.VALUE	= PrepareSQLtxt(tmpPO.Order_PU,'Order_PU',1)
							ThisForm.pgfPO.pgPODesc.lblUnitText.CAPTION	= Get_cPUfrom_nPU(tmpPO.Order_PU)
							
							ThisForm.pgfPO.pgPODesc.txtPounds.Value		= PrepareSQLnum(tmpPO.Pounds,'Pounds',9,1)
							ThisForm.pgfPO.pgPODesc.txtCond_Spec.VALUE	= ShowSQLtxt(tmpPO.Cond_Spec,'Cond_Spec',-1)
							ThisForm.pgfPO.pgPODesc.cmbMelt.Value		= ShowSQLtxt(tmpPO.Melt,'Melt',7)
							ThisForm.pgfPO.pgPODesc.txtMisc_purch.VALUE	= ShowSQLtxt(tmpPO.Misc_purch,'Misc_Purchase',-1)
		
							ThisForm.pgfPO.pgPODesc.txtOtherP.VALUE		= PrepareSQLnum(tmpPO.OtherP,'OtherP',10,2)
							ThisForm.pgfPO.pgPODesc.txtOtherFld.VALUE	= ShowSQLtxt(tmpPO.OtherFld,'OtherFld',10)
							
							ThisForm.PgfPO.PgPODesc.txtPOi_Total.Value = ( PrepareSQLnum(tmpPO.Order_Qty,'Order_QTY',-5) * PrepareSQLnum(tmpPO.Order_P,'Order_P',-5) )  + PrepareSQLnum(tmpPO.OtherP,'OtherP',10,2)
						
							ThisForm.pgfPO.pgPODesc.cmbStock.VALUE		= ShowSQLtxt(tmpPO.Stock,'Stock',13)
							ThisForm.pgfPO.pgPODesc.txtDispAlloy.VALUE	= ShowSQLtxt(tmpPO.DispAlloy,'DispAlloy',20,.f.)
							ThisForm.pgfPO.pgPODesc.txtStandSize.VALUE	= PrepareSQLnum(tmpPO.StandSize,'StandSize',10,4)
							
							ThisForm.pgfPO.pgPODesc.chkSPS1.VALUE		= PrepareSQLchk(tmpPO.Sheet_PK,'Sheet_PK')
							ThisForm.pgfPO.pgPODesc.chkLab_Service.VALUE	= PrepareSQLchk(tmpPO.Services,'Services')
							ThisForm.pgfPO.pgPODesc.chkConvServ.VALUE	= PrepareSQLchk(tmpPO.ConvServ,'ConvServ')
							ThisForm.pgfPO.pgPOdesc.chkEquipment.VALUE	= PrepareSQLchk(tmpPO.Equipment,'Equipment')
							ThisForm.pgfPO.pgPOdesc.chkIntP.VALUE		= PrepareSQLchk(tmpPO.IntP,'IntP')
							
							ThisForm.pgfPO.pgPODesc.txtOrderDate.VALUE	= PrepareSQLdate(tmpPO.OrderDate,'OrderDate',.F.,.T.)
							ThisForm.pgfPO.pgPODesc.txtDue_Min.VALUE	= PrepareSQLdate(tmpPO.Due_Min,'Due_Min',.F.,.T.)
							ThisForm.pgfPO.pgPODesc.txtDue_Max.VALUE	= PrepareSQLdate(tmpPO.Due_Max,'Due_Max',.F.,.T.)
							ThisForm.pgfPO.pgPODesc.txtHPA_Due_Min.VALUE	= PrepareSQLdate(tmpPO.HPA_Due_Min,'HPA_Due_Min',.F.,.T.)
							ThisForm.pgfPO.pgPODesc.txtHPA_Due_Max.VALUE	= PrepareSQLdate(tmpPO.HPA_Due_Max,'HPA_Due_Max',.F.,.T.)
							
							ThisForm.pgfPO.pgPODesc.txtPOSalesName.VALUE	= ShowSQLtxt(tmpPO.POSalesP,'POSalesP',20)
							ThisForm.pgfPO.pgPODesc.txtJobNumber.VALUE		= ShowSQLtxt(tmpPO.JobNumber,'JobNumber',20)
							ThisForm.pgfPO.pgPODesc.txtShipVia.VALUE		= ShowSQLtxt(tmpPO.ShipVia,'ShipVia',20)
							
							ThisForm.pgfPO.pgPODesc.cmbShipWhere.VALUE		= PrepareSQLnum(tmpPO.ShipWhere,'ShipWhere',-1)
							ThisForm.pgfPO.pgPOAddress.opgPOShipTo.Value 	= PrepareSQLnum(tmpPO.ShipWhere,'ShipWhere',-1)
							ThisForm.pgfPO.pgPOAddress.txtPOShipAddr.Value	= PrepareSQLnum(tmpPO.POShipAddr,'POShipAddr',-3)
		*					ThisForm.ShipWhereChange(tmpPO.ShipWhere)  &&call After getting POShipAddr
							
							
							ThisForm.POShipAddr 			= PrepareSQLnum(tmpPO.POShipAddr,'POShipAddr',-3)
							ThisForm.ShowPOShipAddr(tmpPO.POShipAddr)
							ThisForm.Show_VendCode(tmpPO.VendCode)  &&must call After getting VendCode
									
							
							ThisForm.pgfPO.pgPOAddress.cmbRemoteStock.Value = IIF(EMPTY(tmpPO.ShipLocation),'*',tmpPO.ShipLocation)
							ThisForm.pgfPO.pgPOAddress.txtTerms.Value 		= ShowSQLtxt(tmpPO.Terms,'Terms',50,.F.)
							ThisForm.pgfPO.pgPOAddress.txtFOB.Value 		= ShowSQLtxt(tmpPO.FOB,'FOB',50,.F.)
							ThisForm.pgfPO.pgPOAddress.txtHpapo.Value		= PrepareSQLnum(tmpPO.HPAPo,'HPAPO',-3)
							ThisForm.pgfPO.pgPOAddress.txtItemPo.Value		= PrepareSQLnum(tmpPO.ItemPO,'ItemPO',2,0)
							ThisForm.pgfPO.pgPOAddress.txtReceipt.Value 	= ShowSQLtxt(tmpPO.Receipt,'Reciept',-1,.F.)			
							
							ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz1.Value 		= ShowSQLtxt(tmpPO.Sz1Orig,'Sz1Orig',20,.F.)
							ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz2.Value 		= ShowSQLtxt(tmpPO.Sz2Orig,'Sz2Orig',20,.F.)
							ThisForm.pgfPO.pgTestPO.pgfTesting.pgMaterial.Sz3.Value 		= ShowSQLtxt(tmpPO.Sz3Orig,'Sz3Orig',20,.F.)
							
		*Received Heat Cert ProcLoc Receipt Delivered  Cancelled 
							
							IF tmpPO.VendCode > 0
								ThisForm.nVendCode	= PrepareSQLnum(tmpPO.VendCode,'VendCode',-3)
								ThisForm.nContactID	= PrepareSQLnum(tmpPO.ContactID,'ContactID',-3)
								ThisForm.pgfPO.pgPODesc.lblVendCode.Caption	= STR(tmpPO.VendCode)
								ThisForm.pgfPO.pgVendor.txtVendCode.Value	= tmpPO.VendCode
								ThisForm.pgfPO.pgPODesc.lblPeachID.Caption 	= getPeachID_VendCode(tmpPO.VendCode)
								ThisForm.pgfPO.pgVendor.txtPeachID.Value	= getPeachID_VendCode(tmpPO.VendCode)
							ELSE
								ThisForm.nVendCode	= 0
								ThisForm.nContactID	= 0
								ThisForm.pgfPO.pgPODesc.lblVendCode.Caption = ''
								ThisForm.pgfPO.pgVendor.txtVendCode.Value	= 0
								ThisForm.pgfPO.pgPODesc.lblPeachID.Caption = ''
								ThisForm.pgfPO.pgVendor.txtPeachID.Value	= ''
							ENDIF
							
		
							
					*******************************************					
		*!*						*Fix Depricated Values
		*!*						PRIVATE nP_Lb,nP_Pc,nP_Ft,nLotP
		*!*						nP_Lb	= PrepareSQLnum(tmpPO.P_lb,'P_Lb',10,2)
		*!*						nP_Pc	= PrepareSQLnum(tmpPO.P_pc,'P_Pc',10,2)
		*!*						nP_Ft	= PrepareSQLnum(tmpPO.P_ft,'P_Ft',10,2)
		*!*						nLotP	= PrepareSQLnum(tmpPO.LotP,'LotP',10,2)
		*!*						PRIVATE nOrder_QTY, nOrder_P, nOrder_PU
		*!*						nOrder_QTY	= PrepareSQLnum(tmpPO.Order_Qty,'Order_QTY',-5)
		*!*						nOrder_P	= PrepareSQLnum(tmpPO.Order_P,'Order_P',-5)
		*!*						nOrder_PU	= PrepareSQLnum(tmpPO.Order_PU,'Order_PU',-1)
		*!*						
		*!*						IF nOrder_PU = 0
		*!*							** Needs fixed to new style
		*!*							DO CASE 
		*!*								CASE nLotP > 0
		*!*									nOrder_PU	= 4
		*!*									nOrder_P	= nLotP
		*!*									nOrder_QTY	= 1
		*!*								CASE nP_Ft > 0
		*!*									nOrder_PU	= 2
		*!*									nOrder_P	= nP_Ft
		*!*									*nOrder_QTY	= nOrder_QTY
		*!*								CASE nP_Pc > 0
		*!*									nOrder_PU	= 3
		*!*									nOrder_P	= nP_Pc
		*!*									*nOrder_QTY	= nOrder_QTY
		*!*								CASE nP_Lb > 0
		*!*									nOrder_PU	= 1
		*!*									nOrder_P	= nP_Lb
		*!*									*nOrder_QTY	= nOrder_QTY
		*!*								OTHERWISE
		*!*									nOrder_PU	= 0
		*!*									nOrder_P	= 0
		*!*									nOrder_QTY	= 0
		*!*							ENDCASE
		*!*							
		*!*							ThisForm.pgfPO.pgPODesc.txtOrder_Qty.VALUE	= nOrder_QTY
		*!*							ThisForm.pgfPO.pgPODesc.txtOrder_P.VALUE	= nOrder_P
		*!*							ThisForm.pgfPO.pgPODesc.cmbOrder_PU.VALUE	= ALLTRIM(STR(nOrder_PU))
		*!*							ThisForm.pgfPO.pgPODesc.lblUnitText.Caption = Get_cPUfrom_nPU(nOrder_PU)
		*!*						ENDIF	
		*!*						*End depricated fix
					*******************************************			
							IF tmpPO.Cancelled
								ThisForm.chkCancelPO.Value = 1
							ELSE
								ThisForm.chkCancelPO.Value = 0
							ENDIF
							ThisForm.chkCancelPO.Enabled = .T.
							
							ThisForm.chkDeliveredPO.Value = PrepareSQLchk(tmpPO.Delivered,'Delivered')
							
							ThisForm.lblTBL.Caption = PrepareSQLtxt(tmpPO.TBL,'TBL',1)
							
							*******
							ThisForm.pgfPO.pgPODesc.txtHpapo.Enabled = .F.
							ThisForm.pgfPO.pgPODesc.txtItempo.Enabled = .F.
							
							ThisForm.pgfPO.pgPODesc.refresh
							
						ENDIF
						USE IN tmpPO
					ENDIF	
				ELSE
					*Do not Edit Found PO item
					
					*Get Next Available PO number
					IF USED('cntPOitemMax')
						USE IN cntPOitemMax
					ENDIF
					
					cSQL = "SELECT MAX(ItemPO) AS MaxItemPO FROM dbo.PurchaseOrder "
					cSQL = cSQL + " WHERE HpaPO = "+STR(nHpaPo)+""
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntPOitemMax')
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPOitemMax' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPOitemMax")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPOitemMax")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntPOitemMax' )
					ENDIF
					
					IF USED('cntPOitemMax')
						m.itemPO = cntPOitemMax.MaxItemPO + 1 
						ThisForm.pgfPO.pgPODesc.txtItempo.Value = m.itemPO
						USE IN cntPOitemMax
					ENDIF
				ENDIF
			ELSE
				**Not found!
				*Check to see if it could be the next PO number to use
				
				*Get Next Available PO number
				PRIVATE nNextPO 
				nNextPO = GetNextPurchaseOrder ( ThisForm.nConnHandle )
				
				IF nHpaPo + 10 < nNextPO 
					ThisForm.pgfPO.pgPODesc.txtHpaPo.Value = nNextPO 
					MESSAGEBOX("Purchase Order number too large:"+ALLTRIM(STR(nHpaPo))+CHR(13)+"A valid Purchase Order number has been inserted:"+ALLTRIM(STR(nNextPO))+CHR(13)+CHR(13)+"If you where trying to edit an exisiting PO, try again."+CHR(13)+"The number used was not found!",48,"Error with Purchase Order number!")
					RETURN .T.
				ELSE
					RETURN .T.
				ENDIF
			ENDIF
		ELSE &&IF nHpaPo > 0 AND nItemPO > 0
			IF nHpaPo = 0 
				MESSAGEBOX("You need a PO number!",0+48,"NO PO number")
			ELSE
				IF nItemPO = 0 
					MESSAGEBOX("You need a PO ITEM number!"+CHR(13)+"This is the 2 digit number after the '-'",0+48,"NO PO ITEM number")
				ENDIF
			ENDIF
			
			** need number first!
			RETURN .T. 
		ENDIF
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE checkvendcode
		*ThisForm.CheckVendCode()
		**Check SO item for using a PO for Conversion Services
		
		*ThisForm.nVendCode = nVendCode 
		PRIVATE lReturn
		lReturn = .T.
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		IF EMPTY(ThisForm.cSOitem)
			RETURN .T.
		ENDIF
		
		PRIVATE nSalesNum,nItem		
		nSalesNum	= VAL(ThisForm.cSOitem)
		nItem		= VAL( RIGHT(ThisForm.cSOitem,LEN(ThisForm.cSOitem) - AT("-",ThisForm.cSOitem)))
		
		IF nSalesNum > 0
		
			IF USED('tmpIsConversion')
				USE IN tmpIsConversion
			ENDIF
			
			*Check SO item for using a PO for Conversion Services
			*SELECT VendCode from dbo.PurchaseOrder PO,  WHERE PO.SOitem = aSOitems( nItemI )
			cSQL = "SELECT dbo.f_Is_IND_Type( V.VendCode, 2048 ) AS IsIND "
			cSQL = cSQL + ",PO.HPApo, PO.POitem, PO.Company "
			cSQL = cSQL + " FROM dbo.PurchaseOrder PO"
			cSQL = cSQL + " INNER JOIN Vendor AS V ON V.VendCode = PO.VendCode"
			cSQL = cSQL + " WHERE PO.SOitem = dbo.f_ProperSOitem('"+ThisForm.cSOitem+"')"
			cSQL = cSQL + " OR ( PO.SalesNum = "+STR(nSalesNum)
			cSQL = cSQL + " AND PO.Item="+ALLTRIM(STR(nItem))+")"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpIsConversion')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpIsConversion' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpIsConversion")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpIsConversion")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpIsConversion' )
			ENDIF
		ENDIF
		
		IF USED('tmpIsConversion')
			IF RECCOUNT('tmpIsConversion') > 0
				*IF tmpIsConversion.IsIND = 1
		*		IF tmpIsConversion.IsIND 
		*			IF VARTYPE(ConverPO ) = 'N'
		*				IF EMPTY(ConverPO)
		**					*Must mark as Conversion
		*					
		*					nHPApo	= tmpIsConversion.HPApo
		*					cPOitem	= tmpIsConversion.POitem
		*					cCompany = tmpIsConversion.Company
		*					MESSAGEBOX("PO:"+ALLTRIM(STR(nHPApo))+" to Company:"+ALLTRIM(cCompany)+CHR(13)+"is a Conversion company!",0+48,"Please fill in Converter information.")
		*				ENDIF
		*			ENDIF
		*		ENDIF
			ENDIF
			USE IN tmpIsConversion
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN lReturn
	ENDPROC

	PROCEDURE check_pricetable
		*Check_PriceTable()
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE lServicesPO,lEquipment
		lServicesPO = PrepareSQLlogic(ThisForm.pgfPO.pgPODesc.chkLab_Service.Value,'ServicesPO',.F.)
		lEquipment	= PrepareSQLlogic(ThisForm.pgfPO.pgPODesc.chkEquipment.Value,'Equipment',.F.)
		
		IF lServicesPO OR lEquipment
			RETURN .T.
		ENDIF
		
		**********************************
		PRIVATE nStockLst_QTY, nStockLst_P
		nStockLst_QTY	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.VALUE,'StockLst_QTY',-5)
		nStockLst_P		= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_P.VALUE,'StockLst_P',-5)
		
		IF nStockLst_QTY <= 0
			RETURN .T.
		ENDIF
		IF nStockLst_P <= 0
			RETURN .T.
		ENDIF
		
		**********************************
		PRIVATE cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3
		cAlloy		= PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.txtAlloy.VALUE,'Alloy',12,.F.)
		cForm		= PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.cmbForm.VALUE,'Form',2,.T.)
		cCC			= PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.cmbCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.cmbCL.Value,'CL',1)
		nThck		= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtThck.VALUE,'Thck',10,4)
		nSz2		= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSz2.VALUE,'Sz2',9,3)
		nSz3		= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtSz3.VALUE,'Sz3',9,3)
		
		IF LEN(ALLTRIM(cAlloy)) = 0 OR LEN(ALLTRIM(cForm)) = 0 OR nThck = 0
			RETURN .T.
		ENDIF
		
		**********************************
		PRIVATE nPieces, nCalcWeight
		nPieces = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.VALUE,'Pieces',-3)
		IF nPieces = 0
			nPieces  = 1
		ENDIF
		nCalcWeight = CalcWeight (nPieces, cAlloy, cForm, nThck, nSz2, nSz3, ThisForm.nConnHandle)
		
		PRIVATE nBook_P 
		nBook_P = 0
		
		****************
		IF USED( 'tmpCheckPT' )
			USE IN tmpCheckPT
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT ISNULL(dbo.f_GetPriceCC_CL("
		cSQL = cSQL + "'"+cAlloy+"','"+cForm+"','"+cCC+"','"+cCL+"'"
		cSQL = cSQL + ",dbo.f_SizeStandard("+STR(nThck,10,4)+")"
		cSQL = cSQL + ","+STR(nSz2,9,3)
		cSQL = cSQL + ","+STR(nSz3,9,3)
		cSQL = cSQL + ","+STR(nCalcWeight)+")"
		cSQL = cSQL + ",0) AS BookPrice "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCheckPT')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCheckPT' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCheckPT")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCheckPT")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCheckPT')
		ENDIF
				
		IF USED('tmpCheckPT') 
			IF RECCOUNT('tmpCheckPT') > 0
				nBook_P = PrepareSQLnum(tmpCheckPT.BookPrice,'StockLst_P',-5)
			ENDIF
			USE IN tmpCheckPT
		ENDIF
		
		IF nBook_P > 0 AND nStockLst_P > 0
			IF nStockLst_P > nBook_P 
				lOK = .F.
				
				cMess = "The HPA Book Price for this is "+CHR(13)+"$"+STR(nBook_P,10,2)+CHR(13)
				cMess = cMess + "This PO item has a price of "+CHR(13)+"$"+STR(nStockLst_P,10,2)
				MESSAGEBOX(cMess,48,"Warning")
				cMess = cMess +CHR(13)+ "for POitem '"+ThisForm.cPOitem+"'"
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
				
			ENDIF
		ENDIF
		
		RETURN lOK
	ENDPROC

	PROCEDURE contactclear
		*ThisForm.ContactClear()
		
		ThisForm.nContactID = 0
		ThisForm.pgfPO.pgVendorContact.nContactId.Value = 0
		ThisForm.pgfPO.pgVendorContact.cContact.Value = ''
		ThisForm.pgfPO.pgVendorContact.cPhone.Value = ''
		ThisForm.pgfPO.pgVendorContact.cCellPhone.Value = ''
		ThisForm.pgfPO.pgVendorContact.cFax.Value = ''
		ThisForm.pgfPO.pgVendorContact.cEmail.Value = ''
		ThisForm.pgfPO.pgVendorContact.cAddr1.Value = ''
		ThisForm.pgfPO.pgVendorContact.cAddr2.Value = ''
		ThisForm.pgfPO.pgVendorContact.cCity.Value = ''
		ThisForm.pgfPO.pgVendorContact.cST.Value = ''
		ThisForm.pgfPO.pgVendorContact.cZip.Value = ''
		ThisForm.pgfPO.pgVendorContact.cCountry.Value = ''
		ThisForm.pgfPO.pgVendorContact.chkQuality.Value = 0
		ThisForm.pgfPO.pgVendorContact.dLastSurveySent.Value = CTOD("  /  /  ")
		ThisForm.pgfPO.pgVendorContact.dLastSurveyReceived.Value = CTOD("  /  /  ")
		ThisForm.pgfPO.pgVendorContact.cJobTitle.Value = ''
		ThisForm.pgfPO.pgVendorContact.nSurveyPriority.Value = 0
		ThisForm.pgfPO.pgVendorContact.chkVCinactive.Value = 0
		
		ThisForm.pgfPO.pgVendorContact.lblSaveContact.Visible = .F.
	ENDPROC

	PROCEDURE correct_acct_stnd
		*ThisForm.Correct_Acct_Stnd()  Called at init to fix oldschool Acct Standard
		PRIVATE nAcct_PU, nAcct_P, nAcct_Qty, nAcct_Total
		nAcct_PU	= GetPUfrom_POitem(cPOitem,ThisForm.nConnHandle)
		nAcct_P		= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_P.VALUE,'Order_P',-5)
		nAcct_Qty	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtStockLst_QTY.VALUE,'Order_Qty',-5)
		nAcct_Total = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtAcct_Total.Value,'StockLst_Total',-5)
		
		PRIVATE nP_LB, nP_Ft, nP_PC, nLot		&&Depricated
		nP_LB	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtP_LB.VALUE,'P_Lb',-5)
		nP_Ft	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtP_Ft.VALUE,'P_Ft',-5)
		nP_PC	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtP_Pc.VALUE,'P_Pc',-5)
		nLot	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtLotP.VALUE,'Lot',-5)
		
		PRIVATE nOrder_PU, nOrder_P, nOrder_Qty, nOrder_Total, nOtherP
		nOrder_PU 	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.cmbOrder_PU.VALUE,'Order_PU',-1)
		nOrder_P	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_P.VALUE,'Order_P',-5)
		nOrder_Qty	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_Qty.VALUE,'Order_Qty',-5)
		nOrder_Total = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOrder_Total.Value,'Order_Total',-5)
		nOtherP 	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtOtherP.VALUE,'OtherP',10,2)
		
		PRIVATE cUnitText, cUnitLabel 
		cUnitText = ''
		cUnitLabel = ''
		
		**************************
		
		PRIVATE cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld
		cAlloy	= PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.txtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.cmbForm.Value,'Form',2)
		nPieces	= PrepareSQlnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
		nThck	= PrepareSQlnum(ThisForm.pgfPO.pgPODesc.txtThck.Value,'Thck',10,4)
		nSz2	= PrepareSQlnum(ThisForm.pgfPO.pgPODesc.txtSz2.Value,'Sz2',10,3)
		nSz3	= PrepareSQlnum(ThisForm.pgfPO.pgPODesc.txtSz3.Value,'Sz3',10,3)
		*nOtherP	= PrepareSQlnum(ThisForm.pgfPO.pgPODesc.txtOther_P.Value,'OtherP',10,2)
		cOtherFld=PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.txtOtherFld.Value,'OtherFld',10)
		
		**************************
		*Use nAcct_Total or nOrder_Total to adjust to new PU
		*The total includes OtherP
		
		IF nOrder_Total = 0
			IF nAcct_Total > 0
				nOrder_Total = nAcct_Total 
			ELSE
				IF nOrder_P * nOrder_Qty > 0
					nOrder_Total = nOrder_P * nOrder_Qty + nOtherP 
				ELSE
					IF nAcct_P * nAcct_Qty > 0
						nOrder_Total = nAcct_P * nAcct_Qty + nOtherP 
					ELSE
						IF nAcct_P = 0
							IF nP_LB + nP_Ft + nP_PC + nLot > 0
							
								PRIVATE cMess
								cMess = "POitem "+ThisForm.cPOitem+" was running in PurchaseOrder:Correct_ACCT_Stnd()"+CHR(13)
								cMess = cMess + " nOrder_Total = 0"+CHR(13)
								cMess = cMess + " nOrder_P * nOrder_Qty = 0"+CHR(13)
								cMess = cMess + " nAcct_P * nAcct_Qty = 0"+CHR(13)
								cMess = cMess + " nP_LB = "+STR(nP_LB,9,2)+CHR(13)
								cMess = cMess + " nP_Ft = "+STR(nP_Ft,9,2)+CHR(13)
								cMess = cMess + " nP_PC = "+STR(nP_PC,9,2)+CHR(13)
								cMess = cMess + " nLot = "+STR(nLot,9,2)+CHR(13)
		
								RecordError( 0,"POitem is using old pricing!",PROGRAM(),LINENO(1), cMess )
								
								DO CASE
								CASE nP_LB > 0
									IF nAcct_PU = 1
										nAcct_P = nP_Lb
										ThisForm.pgfPO.pgPODesc.txtStockLst_P.VALUE = nAcct_P
										
										IF nAcct_Qty = 0
											nAcct_QTY = GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3, ThisForm.nConnHandle) 
											ThisForm.pgfPO.pgPODesc.txtStockLst_Qty.VALUE = nAcct_QTY
										ENDIF
									ENDIF
									
								CASE nP_Ft > 0
									IF nAcct_PU = 2
										nAcct_P = nP_Ft 
										ThisForm.pgfPO.pgPODesc.txtStockLst_P.VALUE = nAcct_P
										
										IF nAcct_Qty = 0
											nAcct_QTY = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisForm.nConnHandle) 
											ThisForm.pgfPO.pgPODesc.txtStockLst_Qty.VALUE = nAcct_QTY
										ENDIF
									ENDIF
									
								CASE nP_PC > 0
									IF nAcct_PU = 3
										nAcct_P = nP_PC 
										ThisForm.pgfPO.pgPODesc.txtStockLst_P.VALUE = nAcct_P
										
										IF nAcct_Qty = 0
											nAcct_QTY = nPieces
											ThisForm.pgfPO.pgPODesc.txtStockLst_Qty.VALUE = nAcct_QTY
										ENDIF
									ENDIF
									
								CASE nLot > 0
									IF nAcct_PU = 4
										IF nOrder_Total = 0
											nOrder_Total = nLot
										ENDIF
										***
										IF nAcct_P = 0
											nAcct_P = nLot
											ThisForm.pgfPO.pgPODesc.txtStockLst_P.VALUE = nAcct_P
										ENDIF
										***
										nAcct_Qty = 1
										ThisForm.pgfPO.pgPODesc.txtStockLst_Qty.VALUE = nAcct_QTY
									ENDIF
								OTHERWISE
									
								ENDCASE
							ENDIF
							
						ELSE
							nOrder_Total = 0
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		****************
		IF nOrder_Total = 0
			RETURN .F.
		ENDIF
		
		**********************
		IF nOrder_PU = 0
			MESSAGEBOX("Please check and Save "+CHR(13)+"as this PO must "+CHR(13)+"use the new Accounting Standards.",48,"Fix and Save!")
			*nOrder_PU = GetPUfromForm( PrepareSQLtxt(ThisForm.pgfPO.pgPODesc.cmbForm.Value,'Form',2), ThisForm.nConnHandle)
			nOrder_PU = GetPUfrom_POitem(ThisForm.cPOitem, ThisForm.nConnHandle)
			ThisForm.pgfPO.pgPODesc.cmbOrder_PU.Value = nOrder_PU
		ENDIF
		
		IF nOrder_PU < 1
			ThisForm.pgfPO.pgPODesc.lblUnitText.Caption = ''
			ThisForm.pgfPO.pgPODesc.lblQTY_Label.Caption = ''
			RETURN .F.
		ENDIF
		
		****************
		IF VARTYPE(gaPU) != "U"
			cUnitText = gaPU(nOrder_PU,1)
			cUnitLabel = gaPU(nOrder_PU,3)
		
			ThisForm.pgfPO.pgPODesc.lblUnitText.Caption = cUnitText 
			ThisForm.pgfPO.pgPODesc.lblQTY_Label.Caption = cUnitLabel 
		ELSE
			*Get_cPUfrom_nPU Get_PUstr_from_nPU
			ThisForm.pgfPO.pgPODesc.lblUnitText.Caption = Get_cPUfrom_nPU(nOrder_PU,ThisForm.nConnHandle)
			ThisForm.pgfPO.pgPODesc.lblQTY_Label.Caption = Get_PUstr_from_nPU(nOrder_PU,ThisForm.nConnHandle)
		ENDIF
		
		**************************************
		*Check These 
		*nAcct_PU, nAcct_P, nAcct_Qty, nAcct_Total 
		
		*Show the Acct Standard UOM
		ThisForm.pgfPO.pgPODesc.lblHPA_PU.Caption = "HPA UOM "+Get_PUstr_from_nPU(nAcct_PU,ThisForm.nConnHandle)
		
		***
		IF nAcct_Qty = 0
			DO CASE
			CASE nAcct_PU = 1
				*Must be Pounds
				nAcct_Qty = Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld,ThisForm.nConnHandle) 
				*nLBS = GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,ThisForm.nConnHandle)
				
			CASE nAcct_PU = 2
				*Must be Feet
				nAcct_Qty = Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld,ThisForm.nConnHandle) 
				*nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisForm.nConnHandle) 
				
			CASE nAcct_PU = 3
				*Must be PC
				nAcct_Qty = PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtPieces.Value,'Pieces',-3)
			CASE nAcct_PU = 4
				*Must be Lot
				nAcct_Qty = 1
			OTHERWISE
				*Conver Service can be by HR or Day
			ENDCASE
			
			IF nAcct_Qty > 0
				ThisForm.pgfPO.pgPODesc.txtStockLst_Qty.VALUE = nAcct_QTY
			ENDIF
		ENDIF
		***
		IF nAcct_P = 0
			IF nAcct_Qty > 0
				nAcct_P = (nOrder_Total - nOtherP) / nAcct_Qty 
				ThisForm.pgfPO.pgPODesc.txtStockLst_P.VALUE = nAcct_P
			ENDIF
		ENDIF
		***
		IF nAcct_Total = 0
			nAcct_Total = (nAcct_P * nAcct_QTY) + nOtherP
			IF nAcct_Total = 0
				nAcct_Total = nOrder_Total 
			ENDIF
			*IF nAcct_Total  > 0
				ThisForm.pgfPO.pgPODesc.txtAcct_Total.Value = nAcct_Total 
			*ENDIF
		ENDIF
		***
		
		*****************************************
		*Check These
		*nOrder_PU, nOrder_P, nOrder_Qty, nOrder_Total, nOtherP
		
		
		***
		IF nOrder_Qty = 0
			DO CASE
			CASE nOrder_PU = 1
				*$/Lb
				nOrder_Qty = GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,ThisForm.nConnHandle)
			CASE nOrder_PU = 2
				*$/Ft
				nOrder_Qty = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisForm.nConnHandle) 
			CASE nOrder_PU = 3
				*$/Pc
				nOrder_Qty  = nPieces 
			CASE nOrder_PU = 4
				*$Lot
				nOrder_Qty = 1
			CASE nOrder_PU = 5
				*$/Inch
				nOrder_Qty = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisForm.nConnHandle) * 12
			CASE nOrder_PU = 6
				*$/Kg
				nOrder_Qty = GetWeight(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,ThisForm.nConnHandle) / 2.205
			CASE nOrder_PU = 7
				*$/Mtr
				nOrder_Qty = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, ThisForm.nConnHandle) / 3.281
			ENDCASE
			
			IF nOrder_Qty > 0
				ThisForm.pgfPO.pgPODesc.txtOrder_Qty.VALUE = nOrder_Qty 
			ENDIF
		ENDIF
		***
		IF nOrder_P = 0
			IF nOrder_Total > 0 AND nOrder_Qty > 0
				nOrder_P = nOrder_Total / nOrder_Qty
			ENDIF
			IF nOrder_P > 0
				ThisForm.pgfPO.pgPODesc.txtOrder_P.Value = nOrder_P
			ENDIF
		ENDIF
		
		
		ThisForm.pgfPO.pgPODesc.txtPOi_Total.Value	= ( nOrder_QTY * nOrder_P ) + nOtherP
	ENDPROC

	PROCEDURE deletecontactid
		PARAMETERS nContactID
		*ThisForm.DeleteContactID(nContactID)
		
		IF VARTYPE(nContactID)!="N"
			MESSAGEBOX("No ContactID in DeleteContactID",16,"Error")
			RETURN .F.
		ENDIF
		IF nContactID < 1
			MESSAGEBOX("No ContactID in DeleteContactID",16,"Error")
			RETURN .F.
		ENDIF
		
		PRIVATE lOKtoDelete,lSaveOK 
		lOKtoDelete = .T.
		lSaveOK 	= .T.
		
		PRIVATE cSQL, nSQLEXEC
		
		*************************
		*Quality Contact
		IF USED('cntVendorContact')	
			USE IN cntVendorContact
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.VendorContact WHERE ContactID = "+ALLTRIM(STR(nContactID)) 
		cSQL = cSQL + " AND Quality = 1"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntVendorContact' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntVendorContact' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntVendorContact' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendorContact')
			IF cntVendorContact.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendorContact
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This ContactID is used in VendorContact table as a QA Contact!",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		
		*************************
		*QASurveyContactID
		IF USED('cntVendorContact')	
			USE IN cntVendorContact
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.Vendor WHERE QASurveyContactID= "+ALLTRIM(STR(nContactID)) 
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntVendorContact' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntVendorContact' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntVendorContact' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendorContact')
			IF cntVendorContact.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendorContact
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This ContactID is used in Vendor table as the QA Contact!",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		
		*************************
		*ContactID use in another PO
		
		PRIVATE nHpaPo
		nHpaPo	= PrepareSQLnum(ThisForm.pgfPO.pgPODesc.txtHpapo.VALUE,'ERP PO',-3,0)
		
		IF USED('cntVendorContact')	
			USE IN cntVendorContact
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS cntd FROM dbo.PurchaseOrder WHERE ContactID= "+ALLTRIM(STR(nContactID)) 
		cSQL = cSQL +" AND HPAPO <>"+ALLTRIM(STR(nHPAPO))
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntVendorContact' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntVendorContact' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntVendorContact' )
			lSaveOK = .F.
		ENDIF
		
		IF USED('cntVendorContact')
			IF cntVendorContact.cntd > 0
				lOKtoDelete = .F.
			ENDIF
					
			USE IN cntVendorContact
			
			IF NOT lOKtoDelete 
				MESSAGEBOX("This ContactID is used in another Purchase Order!",16,"You cannot delete.")
				RETURN .F.
			ENDIF
		ENDIF
		*************************
		*Get Names for ContactID 
		
		IF USED('getVendorContact')	
			USE IN getVendorContact
		ENDIF
		
		cSQL = "SELECT Contact,City,Email,VendCode FROM dbo.VendorContact WHERE ContactID= "+ALLTRIM(STR(nContactID)) 
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'getVendorContact' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'getVendorContact' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'getVendorContact' )
			lSaveOK = .F.
		ENDIF
		
		PRIVATE cHoldData
		cHoldData = ''
		
		IF USED('getVendorContact')
			IF RECCOUNT('getVendorContact') > 0
				cHoldData = ALLTRIM(PrepareSQLtxt(getVendorContact.Contact,'Contact',30))+", "
				cHoldData = cHoldData + ALLTRIM(PrepareSQLtxt(getVendorContact.City,'City',20))+", "
				cHoldData = cHoldData + ALLTRIM(PrepareSQLtxt(getVendorContact.Email,'Email',60))+", "
				cHoldData = cHoldData + "VendCode:"+ALLTRIM(STR(PrepareSQLnum(getVendorContact.VendCode,'VendCode',-3)))
			ENDIF
					
			USE IN getVendorContact
		ENDIF
		
		*************************
		
		cSQL = "DELETE FROM dbo.VendorContact "
		cSQL = cSQL + " WHERE ContactID = "+ALLTRIM(STR(nContactID)) 
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
			lSaveOK = .F.
		ELSE
			TrackMess( "Deleted Vendor Contact "+cHoldData+" ContactID:"+ALLTRIM(STR(nContactID))+" frmEnterOrder.DeleteContactID()" )
			ThisForm.GetVendorContacts(0)
		ENDIF
		
		RETURN .T.
	ENDPROC

