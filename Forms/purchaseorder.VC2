			****
			PRIVATE	nHpaPo, nItemPo, cPoItem
			nHpaPo	= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtHPApo.VALUE,'ERP PO',-3,0)
			nItemPo	= PrepareSQLnum(ThisForm.pgfPO.pgPOdesc.txtItempo.VALUE,'Item PO',2,0)
			cPOItem = Proper_PO_item( STR(nHPApo)+"-"+STR(nItemPo,2,0) )
			
			IF cPOItem <> Proper_PO_item('')
				PRIVATE cSQLu
				cSQLu = "UPDATE dbo.PurchaseOrder SET "
				cSQLu = cSQLu + " Services ="+IIF(lServicesPO,'1','0')
				cSQLu = cSQLu + " WHERE PoItem = '"+cPOItem+"'"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
				*	lPOSaveOK  = .F.
				ELSE
				ENDIF
				
				*After PO is updates, Check PU:
				ThisForm.Refresh_PU()
			ENDIF
		ENDIF
