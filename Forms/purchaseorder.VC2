	PROCEDURE cmdPrintPO.Click
		
		PRIVATE nHpaPo
		nHpaPo = PrepareSQLnum(This.Parent.pgfPO.pgPODesc.txtHpapo.VALUE,'HPAPO',-3)
		ThisForm.PrintPO(nHPApo,.F.)
		
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE cmdPrintPO.When
		IF THIS.CAPTION = "Print PO"
		
			IF EMPTY(This.Parent.pgfPO.pgPODesc.txtHpapo.VALUE)
				WAIT WINDOW 'Enter PO first' NOWAIT
				RETURN .F.
			ENDIF
		
			IF This.Parent.pgfPO.pgPODesc.txtItemPo.VALUE < 1
				=MESSAGEBOX("Item must be larger than 0",16,"Invalid input")
				RETURN .F.
			ENDIF
		
			IF EMPTY(ALLTRIM(This.Parent.pgfPO.pgPODesc.txtCompany.VALUE))
				=MESSAGEBOX("Purchase Order needs the Company Purchased from entered.",16,"Invalid input")
				RETURN .F.
			ENDIF
		ELSE
		
		ENDIF
		
	ENDPROC

	PROCEDURE lstPoItems.Click
		PRIVATE lcPOitem
		lcPOitem = Proper_PO_Item( This.Value )
		IF lcPOitem = Proper_PO_Item( '' )
			MESSAGEBOX("Did not get a PO item!",48,"Nothing to do")
		ELSE
			ThisForm.ShowPOitem(lcPOitem)
		ENDIF
	ENDPROC

