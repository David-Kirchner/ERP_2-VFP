	PROCEDURE Load
		PRIVATE  lOK
		lOK = .F.
		
		
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		STORE get_SQLSTRINGCONNECT() TO ThisForm.nConnHandle
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			RETURN TO MASTER
		ENDIF
		
		IF !USED("Sales")
		*	USE HPA!Sales IN 0 SHARED 
		*	ThisForm.CloseSales = .T.
			ThisForm.LoadSales()
		ENDIF
		IF !USED("Sales_No")
		*	USE HPA!Sales_No IN 0 SHARED NOUPDATE
		*	ThisForm.CloseSales_No = .T.
			ThisForm.LoadSales_No()
		ENDIF
			
		PRIVATE cSQL_Master, cSQL_Detail, cSQL_Process
		PRIVATE nSQLEXEC, cSQL_SO
		
		ThisForm.LoadtmpSO("LOAD")
		SELECT tmpSO
		GO TOP
		
		IF lOK
		
		ELSE
			= MESSAGEBOX('Error getting Data!'+CHR(13)+"Closing NOW!", 16, 'SQL Connect Error')
			RETURN TO MASTER
		ENDIF
		
	ENDPROC

	PROCEDURE loadsales
		*ThisForm.LoadSales()
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT SOitem,CNCLD,CMPLT FROM dbo.Sales"
		
		IF USED("Sales")
			SELECT Sales
		ELSE
			SELECT 0
		ENDIF
		
		WAIT WINDOW 'Loading Sales' NOWAIT
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
