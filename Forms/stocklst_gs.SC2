	PROCEDURE showprocessstocklstdetail
		*PARAMETER pID_Detail
		*ThisForm.ShowProcessStockLstDetail(StockLst_Process_History.ID_Detail)
		PRIVATE pID_Detail_Process, pID_Detail
		pID_Detail_Process	= StockLst_Process_History.ID_Det_Pr
		pID_Detail = StockLst_Process_History.ID_Detail
		
		
		PRIVATE cSQLb, cSQLa, cSQLc, cSQLd
		PRIVATE nSQLEXEC, cItemDescription
		
		
		
		*!*	SELECT CONVERT( CHAR(100),Who) AS Who,What 
		*!*	,ProcessValue,CostValue,PC,Dim1,Dim2,Dim3,Length,Weight,Descript,[when] 
		*!*	,ID_Detail
		*!*	FROM dbo.Ar_Stocklst_Detail_History WHERE ID_Detail_Process IN 
		*!*	( SELECT ID_Detail_Process FROM dbo.Ar_StockLst_Process_History WHERE SOitem = '  38484-01')
		*!*	UNION
		*!*	SELECT 'ERP StockLst' AS Who, 'CURRENT' AS What, CostValue*Weight AS ProcessValue,CostValue,PC,Dim1,Dim2,Dim3,Length,Weight,Descript,GETDATE() AS [when]
		*!*	, ID_Detail
		*!*	FROM dbo.StockLst_Detail
		*!*	WHERE ID_Detail IN
		*!*	( SELECT ID_Detail FROM dbo.Ar_StockLst_Process_History WHERE SOitem = '  38484-01' AND WHAT = 'DELETE' )
		*!*	ORDER BY [When], [What] DESC
		
		*BEFORE
		ThisForm.pf.pgProc_History.txtProcessValueB.Value = 0
		ThisForm.pf.pgProc_History.txtWeightB.Value = 0
		ThisForm.pf.pgProc_History.txtDescriptB.Value = ''
		ThisForm.pf.pgProc_History.txtDimB.Value = 'No Detail Process'
		
		cSQLb = "SELECT ProcessValue,CostValue,PC,Dim1,Dim2,Dim3,Length,Weight,Descript,[when] "
		cSQLb = cSQLb + " FROM dbo.Ar_Stocklst_Detail_History WHERE ID_Detail_Process = "+ALLTRIM(STR(pID_Detail_Process))
		cSQLb = cSQLb + " AND [WHAT] = 'BEFOREEDIT' "
		
		IF USED("tmpStockLstDH")
			USE IN tmpStockLstDH
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLb, 'tmpStockLstDH')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLb, 'tmpStockLstDH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLb, "tmpStockLstDH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLb, "tmpStockLstDH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLb,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstDH')
		ELSE
			SELECT tmpStockLstDH
			IF NOT EOF()
				cItemDescription = ""
				IF tmpStockLstDH.PC > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.pc))+" pc "
				ENDIF
				IF tmpStockLstDH.Dim1 > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.Dim1))+" x "
				ENDIF
				IF tmpStockLstDH.Dim2 > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.Dim2))+" x "
				ENDIF
				IF tmpStockLstDH.Dim3 > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.Dim3))+" "
				ENDIF
				IF !EMPTY(tmpStockLstDH.Length)
					cItemDescription = cItemDescription + ALLTRIM(tmpStockLstDH.Length)
				ENDIF
					
				ThisForm.pf.pgProc_History.txtProcessValueB.Value = (-1) * tmpStockLstDH.ProcessValue
				ThisForm.pf.pgProc_History.txtWeightB.Value = tmpStockLstDH.Weight
				ThisForm.pf.pgProc_History.txtDescriptB.Value = tmpStockLstDH.Descript
				ThisForm.pf.pgProc_History.txtDimB.Value = cItemDescription
			ENDIF
		ENDIF
		
		*AFTER
		ThisForm.pf.pgProc_History.txtProcessValueA.Value = 0
		ThisForm.pf.pgProc_History.txtWeightA.Value = 0
		ThisForm.pf.pgProc_History.txtDescriptA.Value = ''
		ThisForm.pf.pgProc_History.txtDimA.Value = 'No Detail Process'
		
		cSQLa = "SELECT ProcessValue,CostValue,PC,Dim1,Dim2,Dim3,Length,Weight,Descript,[when] "
		cSQLa = cSQLa + " FROM dbo.Ar_Stocklst_Detail_History WHERE ID_Detail_Process = "+ALLTRIM(STR(pID_Detail_Process))
		cSQLa = cSQLa + " AND [WHAT] = 'AFTER EDIT' "
		
		IF USED("tmpStockLstDH")
			USE IN tmpStockLstDH
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLa, 'tmpStockLstDH')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLa, 'tmpStockLstDH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLa, "tmpStockLstDH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLa, "tmpStockLstDH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLa,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstDH')
		ELSE
			SELECT tmpStockLstDH
			IF NOT EOF()
				cItemDescription = ""
				IF tmpStockLstDH.PC > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.pc))+" pc "
				ENDIF
				IF tmpStockLstDH.Dim1 > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.Dim1))+" x "
				ENDIF
				IF tmpStockLstDH.Dim2 > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.Dim2))+" x "
				ENDIF
				IF tmpStockLstDH.Dim3 > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.Dim3))+" "
				ENDIF
				IF !EMPTY(tmpStockLstDH.Length)
					cItemDescription = cItemDescription + ALLTRIM(tmpStockLstDH.Length)
				ENDIF
					
				ThisForm.pf.pgProc_History.txtProcessValueA.Value = tmpStockLstDH.ProcessValue
				ThisForm.pf.pgProc_History.txtWeightA.Value = tmpStockLstDH.Weight
				ThisForm.pf.pgProc_History.txtDescriptA.Value = tmpStockLstDH.Descript
				ThisForm.pf.pgProc_History.txtDimA.Value = cItemDescription
			ENDIF
		ENDIF
		
		*CURRENT
		ThisForm.pf.pgProc_History.txtProcessValueC.Value = 0
		ThisForm.pf.pgProc_History.txtWeightC.Value = 0
		ThisForm.pf.pgProc_History.txtDescriptC.Value = ''
		ThisForm.pf.pgProc_History.txtDimC.Value = 'Not Found'
				
		cSQLc = "SELECT (CostValue*Weight) AS ProcessValue,CostValue,PC,Dim1,Dim2,Dim3,Length,Weight,Descript,GETDATE() AS [when] "
		cSQLc = cSQLc + " FROM dbo.StockLst_Detail WHERE ID_Detail = "+STR(pID_Detail)
		
		IF USED("tmpStockLstDH")
			USE IN tmpStockLstDH
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLc, 'tmpStockLstDH')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLc, 'tmpStockLstDH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLc, "tmpStockLstDH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLc, "tmpStockLstDH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQLc,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstDH')
		ELSE
			SELECT tmpStockLstDH
			IF NOT EOF()
				cItemDescription = ""
				IF tmpStockLstDH.PC > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.pc))+" pc "
				ENDIF
				IF tmpStockLstDH.Dim1 > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.Dim1))+" x "
				ENDIF
				IF tmpStockLstDH.Dim2 > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.Dim2))+" x "
				ENDIF
				IF tmpStockLstDH.Dim3 > 0
					cItemDescription = cItemDescription + ALLTRIM(STR(tmpStockLstDH.Dim3))+" "
				ENDIF
				IF !EMPTY(tmpStockLstDH.Length)
					cItemDescription = cItemDescription + ALLTRIM(tmpStockLstDH.Length)
				ENDIF
					
				ThisForm.pf.pgProc_History.txtProcessValueC.Value = tmpStockLstDH.ProcessValue
				ThisForm.pf.pgProc_History.txtWeightC.Value = tmpStockLstDH.Weight
				ThisForm.pf.pgProc_History.txtDescriptC.Value = tmpStockLstDH.Descript
				ThisForm.pf.pgProc_History.txtDimC.Value = cItemDescription
			ENDIF
		ENDIF
		
		IF USED("tmpStockLstDH")
			USE IN tmpStockLstDH
		ENDIF
		
		IF !EMPTY(ThisForm.pf.pgProc_History.txtProcessValueB.Value) AND !EMPTY(ThisForm.pf.pgProc_History.txtProcessValueA.Value)
			ThisForm.pf.pgProc_History.txtProcessValueD.Value = ThisForm.pf.pgProc_History.txtProcessValueB.Value - ThisForm.pf.pgProc_History.txtProcessValueA.Value
		ELSE
			ThisForm.pf.pgProc_History.txtProcessValueD.Value = 0
		ENDIF
		IF !EMPTY(ThisForm.pf.pgProc_History.txtWeightB.Value) AND !EMPTY(ThisForm.pf.pgProc_History.txtWeightA.Value)
			ThisForm.pf.pgProc_History.txtWeightD.Value = ThisForm.pf.pgProc_History.txtWeightB.Value - ThisForm.pf.pgProc_History.txtWeightA.Value
		ELSE
			ThisForm.pf.pgProc_History.txtWeightD.Value = 0
		ENDIF
		
	ENDPROC

	PROCEDURE showprochistory
		PARAMETER pSOitem
		*ShowProcHistory()
		PRIVATE cSQL,nSQLEXEC
		
		
		*MESSAGEBOX( "pSOitem="+ pSOitem + "  tmpSO.SOitem="+ tmpSO.SOitem )
		This.MousePointer = 11
		
		
		cSQL="SELECT 0 AS Vld,CONVERT( CHAR(100),Who) AS Who,What,[When],SOItem,SalesPerson AS SalesPerso,StartDate,DueDate,Comment,"
		cSQL=cSQL+"Processor,AllowSub,pWeight,pPc,ID_Detail,ID_Detail_Process AS ID_Det_Pr,Removed,ID_Process_History AS ID_Proc_H "
		cSQL=cSQL+" FROM dbo.Ar_StockLst_Process_History WHERE SOitem = '"+pSOitem+"'"
		
		This.pf.pgProc_History.grdStockLst_Process_History.RecordSource = ""
		
		IF USED("StockLst_Process_History")
			USE IN StockLst_Process_History
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process_History')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Process_History')
		ELSE
			SELECT StockLst_Process_History
			GO TOP
			This.pf.pgProc_History.grdStockLst_Process_History.RecordSource = "StockLst_Process_History"
			This.pf.pgProc_History.grdStockLst_Process_History.Refresh
		ENDIF
		
		***************************
		
		
		PRIVATE cSQL
		cSQL="SELECT DISTINCT SD.ID_Detail "
		cSQL=cSQL+"FROM dbo.StockLst_Detail SD JOIN dbo.Ar_StockLst_Process_History SPH ON SD.ID_Detail = SPH.ID_Detail "
		cSQL=cSQL+"WHERE SPH.SOitem = '"+pSOitem+"'"+" ORDER BY SD.ID_Detail "
		
		ThisForm.pf.pgCurrStock.GrdHistory_Details.RecordSource = ""
		
		IF USED("tmpDetails")
			USE IN tmpDetails
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetails')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetails')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpDetails')
		ELSE
			SELECT tmpDetails
			GO TOP
			ThisForm.pf.pgCurrStock.GrdHistory_Details.RecordSource = "tmpDetails"
		*	ThisForm.pf.pgCurrStock.GrdHistory_Details.clmID_Detail.Text1.ControlSource = tmpDetails.ID_Detail
			ThisForm.pf.pgCurrStock.GrdHistory_Details.Refresh
		ENDIF
		
		
		
		This.CalcStockLstMoney()
		
		This.CalcSOitemMoney()
		ThisForm.ShowProcessStockLstDetail()
		This.MousePointer = 0
		
	ENDPROC

