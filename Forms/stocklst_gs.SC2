	PROCEDURE accountingrules
		*Check AccountingRules()
		PRIVATE nACreturn, cSOitem, m.CostValue
		cSOitem = tmpSO.SOitem
		m.CostValue = 1 && No Change
		
		nACreturn = AccountingCosting( 0, StockLst_Process_History.ID_Detail, cSOitem, THISFORM.nConnHandle )
		
		*PARAMETER pID, pID_Detail, pSOitem, pConn   RETURNS Code
		DO CASE
		CASE nACreturn = 0
			*Zero Cost
			*0 if write off
			m.CostValue = 0
			MESSAGEBOX("This stock confirms to the 'Write Off' rules.",0,"AccountingCosting()" )
		CASE nACreturn = 1
			*Keep sames Cost
			m.CostValue = 1
		CASE nACreturn = -1
			*-1 if no ID_Detail
			MESSAGEBOX("No ID_Detail value",0,"Error in 'AccountingCosting()'")
		CASE nACreturn = -2
			*-2 if no Alloy/Form
			MESSAGEBOX("No Alloy/Form value",0,"Error in 'AccountingCosting()'")
		CASE nACreturn = -3
			*-3 IF no Dim1/Dim2
			MESSAGEBOX("No Dim1/Dim2 value"+CHR(13)+"Old Style Inventory!",0,"'AccountingCosting()'")
			*DIM2 is blank
			m.CostValue = 1	
		CASE nACreturn = -4
			*-4 Did not find ID_Detail 
			MESSAGEBOX("No ID_Detail value",0,"Error in 'AccountingCosting()'")
		CASE nACreturn = -5
			*-5 SQL error with tmpMasterAlloyForm or tmpDetailAlloyForm
			MESSAGEBOX("SQL error with tmpMasterAlloyForm or tmpDetailAlloyForm",0,"Error in 'AccountingCosting()'")
		OTHERWISE
			*Error
			MESSAGEBOX("Undefined Error",0,"Error in 'AccountingCosting()'")
		ENDCASE
		
		RETURN m.CostValue
		
	ENDPROC

	PROCEDURE calccost		&& For a SOitem
		PRIVATE nPrcVal,cDetPro
		cDetPro = ""
		
		DECLARE aDetPr(1)
		aDetPr(1) = 0
		
		IF USED("StockLst_Process_History")
			SELECT StockLst_Process_History
		
			SELECT DISTINCT ID_Det_Pr FROM StockLst_Process_History ;
			INTO ARRAY aDetPr
		*	WHERE Vld = 1 ;
		
		
			
			IF aDetPr(1)>0
				FOR i = 1 TO ALEN(aDetPr,1)
					IF EMPTY(cDetPro)
						cDetPro = ALLTRIM(STR( aDetPr(i) ))
					ELSE
						cDetPro = cDetPro + "," + ALLTRIM(STR( aDetPr(i) ))
					ENDIF
					LOOP
				NEXT i
				
				cSQL =        "SELECT SUM(ProcessValue) AS TotProc FROM dbo.Ar_Stocklst_Detail_History "
				cSQL = cSQL + " WHERE ID_Detail_Process IN ("
				cSQL = cSQL + cDetPro + ")"
				
				IF USED("tmpDetail_Process_Report")
					USE IN tmpDetail_Process_Report
				ENDIF
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
				ELSE
					SELECT tmpDetail_Process_Report
					nChange = tmpDetail_Process_Report.TotProc
					IF ISNULL(nChange)
						ThisForm.pf.pgProc_History.txtEstCost.Value = 0
					ELSE
						ThisForm.pf.pgProc_History.txtEstCost.Value = nChange
						**
					ENDIF
				ENDIF
				IF USED("tmpDetail_Process_Report")
					USE IN tmpDetail_Process_Report
				ENDIF
		
			ELSE
		*		MESSAGEBOX( "No records seleted!")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE calcsoitemmoney
		*CalcSOitemMoney
		
		PRIVATE cSOitem
		cSOitem = StockLst_Process_History.SOitem
		
		IF USED("tmpSales_Sum")
			USE IN tmpSales_Sum
		ENDIF
		
		PRIVATE nSO, nItemSale, nItemCost, nProfit
		nSO = VAL( LEFT( cSOitem,7) )
		*SELECT SUM() FROM HPA!Sales WHERE SalesNum = nSO INTO CURSOR tmpSales_No NOFILTER
		*SELECT Sales
		*SET CONSOLE OFF
		*CALCULATE SUM(ItemSale), SUM(ItemCost) TO nItemSale, nItemCost FOR SALESNUM = nSO	
		*SET CONSOLE ON
		IF USED("calcSales")
			USE IN calcSales
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT ISNULL(SUM(ItemSale),0) AS nItemSale, ISNULL(SUM(ItemCost),0) AS nItemCost FROM dbo.Sales "
		cSQL = cSQL + " WHERE SALESNUM = "+STR(nSO)
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'calcSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'calcSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "calcSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "calcSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisForm.nConnHandle, nSQLEXEC, 'calcSales')
		ENDIF
			
		IF USED("calcSales")	
			nProfit = calcSales.nItemSale - calcSales.nItemCost
		
			ThisForm.pf.pgProc_History.txtEstSOSale.Value = calcSales.nItemSale
			ThisForm.pf.pgProc_History.txtEstSOCost.Value = calcSales.nItemCost
			ThisForm.pf.pgProc_History.txtEstSOProfit.Value = nProfit
		
			USE IN calcSales
		ELSE
			ThisForm.pf.pgProc_History.txtEstSOSale.Value = 0
			ThisForm.pf.pgProc_History.txtEstSOCost.Value = 0
			ThisForm.pf.pgProc_History.txtEstSOProfit.Value = 0
		ENDIF
		ThisForm.pf.pgProc_History.txtEstSOSale.Refresh
		ThisForm.pf.pgProc_History.txtEstSOCost.Refresh
		ThisForm.pf.pgProc_History.txtEstSOProfit.Refresh
		
		
		
		*SELECT * FROM HPA!Sales WHERE SOitem = cSOitem INTO CURSOR tmpSales NOFILTER
		IF USED("tmpSales")
			USE IN tmpSales
		ENDIF
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT * FROM dbo.Sales WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem +"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSales')
		ENDIF
		
		PRIVATE nItemProfit
		nItemProfit = tmpSales.ItemSale - tmpSales.ItemCost
		
		ThisForm.pf.pgProc_History.txtEstSale.Value = tmpSales.ItemSale
		ThisForm.pf.pgProc_History.txtEstCost.Value = tmpSales.ItemCost
		ThisForm.pf.pgProc_History.txtEstProfit.Value = nItemProfit
		
		ThisForm.pf.pgProc_History.txtEstSale.Refresh
		ThisForm.pf.pgProc_History.txtEstCost.Refresh
		ThisForm.pf.pgProc_History.txtEstProfit.Refresh
		
	ENDPROC

	PROCEDURE calcstocklstmoney
		*ThisForm.CalcStockLstMoney()
		PRIVATE pID_Detail_Process, pSOItem
		pID_Detail_Process	= StockLst_Process_History.ID_Det_Pr
		pSOItem				= StockLst_Process_History.SOitem
		
		PRIVATE  nChange
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		
		IF TYPE("pSOitem") = "C"
			IF !EMPTY(pSOItem)
				
				cSQL =        "SELECT SUM(SDH.ProcessValue) AS TotCost "
				cSQL = cSQL + "FROM dbo.Ar_Stocklst_Detail_History SDH "
				cSQL = cSQL + "WHERE SDH.ID_Detail_Process IN "
				cSQL = cSQL + "(SELECT ID_Detail_Process FROM dbo.Ar_StockLst_Process_History SPh "
				cSQL = cSQL + "WHERE SPH.SOitem = '"+pSOItem+"')"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
				ELSE
					SELECT tmpDetail_Process_Report
					nChange = -1 * NVL(tmpDetail_Process_Report.TotCost ,0)
			*		nChange = ( nBE - nAE ) + nAD - nDL
					IF ISNULL(nChange)
						ThisForm.pf.pgProc_History.txtActCost.Value = ""
						nChange = 0
					ELSE
						ThisForm.pf.pgProc_History.txtActCost.Value = nChange
					ENDIF
					ThisForm.pf.pgProc_History.txtActCost.Refresh
					
					* Update Sales Record!!!
					IF TYPE("pSOItem") = "C"
						Save_ItemCostinSales( nChange, pSOItem, THISFORM.nConnHandle )
						*UPDATE Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)
					ELSE
						RecordError(0,"Not Associated with a Sales Order Item!" ,PROGRAM(),LINENO(1),"UPDATE Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)"+CHR(13)+cSQL )
					ENDIF
				ENDIF &&nSQLEXEC
			ELSE
				*MESSAGEBOX('Could NOT Calc for SOitem',0,"Empty SOitem!")
				WAIT WINDOW "Could NOT Calc for SOitem" NOWAIT
			ENDIF &&!EMPTY(pSOItem)
		ELSE
			MESSAGEBOX('Could NOT Calc for SOitem',0,"Empty SOitem!")
		ENDIF &&TYPE("pSOitem") = "C"
			
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		
	ENDPROC

