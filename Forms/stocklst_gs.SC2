	PROCEDURE pf.pgCurrStock.cmdAdjInvV.Click
		*Create Process
		*MESSAGEBOX("Insert Work Here!")
		*RETURN
		
		PRIVATE cSQLi, nSQLEXEC , nNewID_Detail_Process1
		PRIVATE m.ID_Detail,m.salesperson,m.startdate,m.duedate
		PRIVATE m.AllowSub,m.pWeight,m.pPc,m.soitem,m.PO_Item,m.process_id,m.processor,m.comment
		
		nNewID_Detail_Process1 = 0
		
		m.ID_Detail 	= STOCKLST_DETAIL_COST.ID_Detail
		m.salesperson 	= "Acct"
		m.startdate 	= DATE() 
		m.duedate 		= DATE() 
		m.AllowSub 		= "N"
		m.pWeight 		= 0
		m.pPc 			= 0
		m.soitem 		= StockLst_Process_History.SOitem
		m.PO_Item		= ''
		*m.process_id 	= ThisForm.process_id1.Value
		m.processor 	= "ACCT"
		m.comment 		= "Accounting Adjustment"
		
		***~Check DATA
		
		*IF ThisForm.ogSOitem.Value = 2
			*INV Correction
			m.salesperson	= LEFT(SUBSTR(SYS(0),AT("#",SYS(0))+1),20)
			m.AllowSub		= "N"
			m.pWeight		= 0
			m.pPc			= 0
			m.startdate		= DATE()
			m.duedate		= DATE()
			m.process_id	= "CORRECTION"
			m.processor		= LEFT( DTOC(date())+" "+time(), 20)
		*ENDIF
		
		*Save Process
			*p_StockLst_Process_ins
			cSQLi = "EXEC dbo.p_Lst_Process_ins0 "
			cSQLi = cSQLi + " @TBL='S'"
			cSQLi = cSQLi + ",@ID_Detail = "+STR(m.ID_Detail)+""
			cSQLi = cSQLi + ",@salesperson = '"+STRTRAN(m.salesperson,"'","''")+"'"
			cSQLi = cSQLi + ",@startdate = '"+DTOC(m.startdate)+"'"
			cSQLi = cSQLi + ",@duedate = '"+IIF(EMPTY(m.duedate),'',DTOC(m.duedate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+STRTRAN(m.AllowSub,"'","''")+"'"
			cSQLi = cSQLi + ",@pWeight = "+STR(m.pWeight,9,1)
			cSQLi = cSQLi + ",@pPc = "+STR(m.pPc)
			cSQLi = cSQLi + ",@soitem = '"+STRTRAN(m.soitem,"'","''")+"'"
			cSQLi = cSQLi + ",@PO_item = '"+STRTRAN(m.PO_item,"'","''")+"'"
			cSQLi = cSQLi + ",@WO = 0"
			cSQLi = cSQLi + ",@process_id = '"+STRTRAN(m.processor,"'","''")+"'"
			cSQLi = cSQLi + ",@processor = '"+STRTRAN(m.processor,"'","''")+"'"
			cSQLi = cSQLi + ",@comment = '"+STRTRAN(m.comment,"'","''")+"'"
			cSQLi = cSQLi + ",@ReceivingID = 0"
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				nNewID_Detail_Process1 = 0
			ELSE
				=SQLCOMMIT(THISFORM.nConnHandle)
				IF USED("tmpID_Detail_Process")
					nNewID_Detail_Process1 = tmpID_Detail_Process.exp
					USE IN tmpID_Detail_Process
				ENDIF	
				
				********************* Show Edit Screen
				DO FORM Forms\Stocklst_Process WITH "EDIT", nNewID_Detail_Process1,      '',      '',         '',   0,    0,        '',       '', "S",m.PO_item,  0  ,m.ID_Detail,      '', 0
		*                                          cWhatDo,                pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO, pID_Detail, pInqNumP, pWO_Detail
				
				*Refresh Shop StockLst Edit
				*ThisForm.RefreshtmpQuotes()
			ENDIF
			
			*This.Enabled = .F.
			*ThisForm.cmdModifyStockLst.Enabled = .T.
			
		*?	ThisForm.RefreshStockLst()
			
			
				
		*ENDIF
		
		
		
		
	ENDPROC

