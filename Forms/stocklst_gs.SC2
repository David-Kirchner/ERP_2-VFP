	PROCEDURE loadtmpso
		PARAMETER pWhat
		
		PRIVATE cNextSOitem 
		cNextSOitem = ''
		
		IF pWhat = "LOAD"
		ENDIF
		
		IF pWhat = "RELOAD"
			ThisForm.pf.pgProc_History.grdTmpSO.RecordSource = ""
		*	ThisForm.pf.pgProc_History.grdStockLst_Detail_History.RecordSource = ""
			IF USED("tmpSO")
				SELECT tmpSO
				IF EOF('tmpSO')
					SKIP -1
				ELSE
					SKIP
				ENDIF
				cNextSOitem = tmpSO.SOitem
			ENDIF
		ENDIF
		
		IF USED("tmpSO_All")
			USE IN tmpSO_All
		ENDIF
		IF USED("tmpSO")
			USE IN tmpSO
		ENDIF
		cSQL = "SELECT DISTINCT SOitem FROM dbo.Ar_StockLst_Process_History WHERE Validated <> 'T' ORDER BY SOitem "
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_All')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_All')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_All")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_All")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSO_All')
		ELSE
			lOK = .T.
		ENDIF
		
		IF NOT USED('Sales')
			ThisForm.LoadSales()
		ENDIF
		
		SELECT 0
		SELECT tmpSO_All.SOitem FROM tmpSO_All, Sales WHERE tmpSO_All.SOitem = Sales.SOitem AND ( Sales.CNCLD OR Sales.CMPLT ) INTO CURSOR tmpSO NOFILTER
		SELECT tmpSO
		
		IF pWhat = "RELOAD"
			IF NOT EMPTY('cNextSOitem')
				LOCATE FOR SOitem = (cNextSOitem)
				ThisForm.ShowProcHistory(tmpSO.SOitem)
			ENDIF
			ThisForm.pf.pgProc_History.grdTmpSO.RecordSource = "tmpSO"
		*	ThisForm.pf.pgProc_History.grdStockLst_Detail_History.RecordSource = ""
		ELSE
		*	ThisForm.ShowProcHistory(tmpSO.SOitem) &&Do not show if called from LOAD
			
			cSQL=     "SELECT ID_Detail_Process "
			cSQL=cSQL+",CONVERT( CHAR(100),Who) AS Who,What "
			cSQL=cSQL+",ProcessValue,CostValue,PC,Dim1,Dim2,Dim3,Length,Weight,Descript,[when] "
			cSQL=cSQL+"FROM dbo.Ar_Stocklst_Detail_History WHERE ID_Detail_Process IN "
			cSQL=cSQL+"( SELECT ID_Detail_Process FROM dbo.Ar_StockLst_Process_History WHERE SOitem ='"+tmpSO.SOitem+"')"
		
		*	This.pf.pgProc_History.grdStockLst_Detail_History.RecordSource = ""
		
			IF USED("StockLst_Detail_History")
				USE IN StockLst_Detail_History
			ENDIF
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail_History')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail_History')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Detail_History")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Detail_History")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_History')
			ENDIF
		ENDIF
		
	ENDPROC

