	PROCEDURE pf.pgProc_History.txtEstSale.Click
		This.Parent.txtActSale.Value = This.Value
		ThisForm.ShowActProfit("",0)
	ENDPROC

	PROCEDURE pf.pgProc_History.txtSO.Valid
		PRIVATE nSO
		nSO = This.Value
		
		IF TYPE("nSO") <> "N"
			IF TYPE("nSO") = "C"
				nSO = VAL(nSO)
			ELSE
				nSO = 0
			ENDIF
		ENDIF
		
		ThisForm.pf.pgProc_History.grdTmpSO.RecordSource = ""
		
		IF USED("tmpSO_All")
			USE IN tmpSO_All
		ENDIF
		PRIVATE cSQL, nSQLEXEC 
		IF nSO = 0
			cSQL= "SELECT DISTINCT SOitem FROM dbo.Ar_StockLst_Process_History WHERE Validated <> 'T' ORDER BY SOitem "
		ELSE
			cSQL= "SELECT DISTINCT SOitem FROM dbo.Ar_StockLst_Process_History "
			cSQL= cSQL +" WHERE  SOitem LIKE '"+STR(nSO,7)+"-%'"
			cSQL= cSQL+" ORDER BY SOitem "
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_All')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_All')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_All")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_All")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSO_All')
		ELSE
			lOK = .T.
		ENDIF
		
		SELECT 0
		*IF nSO = 0
		
			IF USED("tmpSO")
				USE IN tmpSO
			ENDIF
			IF nSO = 0
				cSQL = "SELECT DISTINCT SPH.SOitem FROM dbo.Ar_StockLst_Process_History SPH"
				cSQL = cSQL+", dbo.Sales "
				cSQL = cSQL+" WHERE SPH.Validated <> 'T' "
				cSQL = cSQL+" AND SPH.SOitem = Sales.SOitem "
				cSQL = cSQL+" AND ( Sales.CNCLD=1 OR Sales.CMPLT=1 )"
				cSQL = cSQL+" ORDER BY SPH.SOitem "
			ELSE
				cSQL = "SELECT DISTINCT SPH.SOitem FROM dbo.Ar_StockLst_Process_History SPH"
				cSQL = cSQL+", dbo.Sales "
				cSQL = cSQL+" WHERE SPH.SOitem LIKE '"+STR(nSO,7)+"-%'"
				cSQL = cSQL+" AND SPH.SOitem = Sales.SOitem "
				cSQL = cSQL+" AND ( Sales.CNCLD=1 OR Sales.CMPLT=1 )"
				cSQL = cSQL+" ORDER BY SOitem "
			ENDIF
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSO')
			ELSE
				lOK = .T.
			ENDIF
		
		*	SELECT tmpSO_All.SOitem FROM tmpSO_All, Sales ;
		*	  WHERE tmpSO_All.SOitem = Sales.SOitem ;
		*	  AND ( Sales.CNCLD OR Sales.CMPLT )  INTO CURSOR tmpSO NOFILTER
		*ELSE
		*	SELECT tmpSO_All.SOitem ;
		*	  FROM tmpSO_All, Sales ;
		*	  WHERE tmpSO_All.SOitem = Sales.SOitem ;
		*	  INTO CURSOR tmpSO NOFILTER
		*ENDIF
		  
		SELECT tmpSO
		ThisForm.pf.pgProc_History.grdTmpSO.RecordSource = "tmpSO"
		
		
		ThisForm.ShowProcHistory(tmpSO.SOitem)
	ENDPROC

	PROCEDURE pf.pgSOitem.Click
		PRIVATE cSOitem
		IF ThisForm.Page != "pgSOitem"
			ThisForm.Page = "pgSOitem"
			
			*Show SO item found in Process	
			cSOitem = StockLst_Process_History.SOitem
		*	SELECT * FROM HPA!Sales WHERE SOitem = cSOitem INTO CURSOR tmpSales NOFILTER	
			IF USED("tmpSales")
				USE IN tmpSales
			ENDIF
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "SELECT * FROM dbo.Sales WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem +"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSales')
			ENDIF
			
			
			IF USED("tmpSales_No")
				USE IN tmpSales_No
			ENDIF
			PRIVATE nSO
			nSO = VAL( LEFT( cSOitem,7) )
		*	SELECT * FROM HPA!Sales_No WHERE SalesNum = nSO INTO CURSOR tmpSales_No NOFILTER
			cSQL = "SELECT * FROM dbo.Sales_No WHERE SalesNum = "+STR(nSO)
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_No')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_No')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_No")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_No")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSales_No')
			ENDIF
			
			
			ThisForm.ShowSOitem()
		ELSE
			*Already there
		ENDIF
	ENDPROC

ENDDEFINE
