	PROCEDURE pf.pgProc_History.cmdProcess.Click
		*cmdProcess.Click - Process Marked items
		PRIVATE nPrcVal,cDetPro
		cDetPro = ""
		PRIVATE cSQL, i, cSQL_SO, cSQL_PD, nSQLEXEC 
		
		*cSQL="SELECT 0 AS Vld,CONVERT( CHAR(100),Who) AS Who,What,[When],SOItem,SalesPerson AS SalesPerso,StartDate,DueDate,Comment,"
		*cSQL=cSQL+"Processor,AllowSub,pWeight,pPc,ID_Detail,ID_Detail_Process AS ID_Det_Pr,Removed,ID_Process_History AS ID_Proc_H "
		*cSQL=cSQL+" FROM dbo.Ar_StockLst_Process_History WHERE SOitem = '"+pSOitem+"'"
		
		DECLARE aDetPr(1)
		aDetPr(1) = 0
		
		PRIVATE vSale, nSale
		nSale = 0
		vSale = ThisForm.pf.pgProc_History.txtActSale.Value 
		IF TYPE("vSale") = "N"
			nSale = vSale
		ELSE
			IF VAL("vSale") > 0
				nSale = VAL(vSale)
			ENDIF
		ENDIF
			
		= SQLSETPROP(THISFORM.nConnHandle, 'Transactions', 2)  && Manual transactions
		
		IF USED("StockLst_Process_History")
			SELECT StockLst_Process_History
		
			SELECT DISTINCT ID_Det_Pr FROM StockLst_Process_History WHERE Vld = 1 INTO ARRAY aDetPr
			
			IF aDetPr(1)>0
				
				FOR i = 1 TO ALEN(aDetPr,1)
					IF EMPTY(cDetPro)
						cDetPro = ALLTRIM(STR( aDetPr(i) ))
					ELSE
						cDetPro = cDetPro + "," + ALLTRIM(STR( aDetPr(i) ))
					ENDIF
					LOOP
				NEXT i
				
				cSQL =        "SELECT SUM(ProcessValue) AS TotProc FROM dbo.Ar_Stocklst_Detail_History "
				cSQL = cSQL + " WHERE ID_Detail_Process IN ("
				cSQL = cSQL + cDetPro + ")"
				
				IF USED("tmpDetail_Process_Report")
					USE IN tmpDetail_Process_Report
				ENDIF
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
				ELSE
					SELECT tmpDetail_Process_Report
					nChange = tmpDetail_Process_Report.TotProc
					IF ISNULL(nChange)
						MESSAGEBOX( "No Cost for SO item "+StockLst_Process_History.SOitem,64,"Green Sheet")
						
		*				UPDATE Sales SET GS_Cost = 0 WHERE SOitem = tmpSO.SOitem
						Save_GS_CostinSales( 0, tmpSO.SOitem, THISFORM.nConnHandle )
						
					ELSE
						MESSAGEBOX( "Applying Cost of $"+ALLTRIM(STR( nChange ))+" to SO item "+StockLst_Process_History.SOitem,64,"Green Sheet" )
						**
						*UPDATE Sales SET GS_Cost = nChange WHERE SOitem = tmpSO.SOitem
						Save_GS_CostinSales( nChange, tmpSO.SOitem, THISFORM.nConnHandle )
					ENDIF
					
					FOR i = 1 TO ALEN(aDetPr,1)
						
						cSQL_SO = "UPDATE dbo.Ar_StockLst_Process_History SET Validated = 'T' WHERE ID_Detail_Process = "+STR( aDetPr(i) )
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_SO )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL_SO )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_SO, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_SO, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL_SO,THISFORM.nConnHandle, nSQLEXEC, '')
							= SQLROLLBACK(THISFORM.nConnHandle)  && Cancels any changes 
						ELSE	
							cSQL_PD = "DELETE FROM dbo.StockLst_Process WHERE ID_Detail_Process = "+STR( aDetPr(i) )
			
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_PD )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL_PD )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_PD, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_PD, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 1
								SQLEXECError(cSQL_SO,THISFORM.nConnHandle, nSQLEXEC, '')
								= SQLROLLBACK(THISFORM.nConnHandle)  && Cancels any changes 
							ELSE	
								= SQLCOMMIT(THISFORM.nConnHandle)  && Commit the changes
							ENDIF		
						ENDIF
					NEXT i		
					
					IF nSale > 0
						IF MESSAGEBOX("Found a Sale price of $"+ALLTRIM(STR( nSale,9,2 ))+CHR(13)+;
						   "Do you want to update the Sales price?",4+32,"Sale Price")=6 &&Yes
						   
							Save_GS_SaleinSales( nSale, tmpSO.SOitem, THISFORM.nConnHandle )
		*					UPDATE Sales SET GS_Sale = nSale WHERE SOitem = tmpSO.SOitem
								
						ENDIF
					ENDIF
		
					ThisForm.LoadtmpSO("RELOAD")
					This.Parent.grdTmpSO.SetFocus()			
					
				ENDIF
				IF USED("tmpDetail_Process_Report")
					USE IN tmpDetail_Process_Report
				ENDIF
		
			ELSE
				MESSAGEBOX( "No records seleted!",64,"Green Sheet")
			ENDIF
		ENDIF
		
		= SQLSETPROP(THISFORM.nConnHandle, 'Transactions', 1)  && Auto transactions
	ENDPROC

