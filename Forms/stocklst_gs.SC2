	PROCEDURE showactprofit
		PARAMETER pWHO, pWhat
		
		PRIVATE vSale, vCost
		PRIVATE nSale, nCost, nProfit
		nSale = 0
		nCost = 0
		nProfit = 0
		
		ThisForm.pf.pgProc_History.txtActProfit.Value = "*"
		ThisForm.pf.pgProc_History.txtActProfit.Refresh
		
		
		DO CASE
		CASE pWHO = "SALE"
			IF TYPE("pWHAT") = "N"
				nSale = pWhat
			ELSE
				IF VAL("pWHAT") > 0
					nSale = VAL(pWhat)
				ELSE
					nSale = 0
				ENDIF
			ENDIF
			vCost = ThisForm.pf.pgProc_History.txtActCost.Value 
			IF TYPE("vCost") <> "N"
				nCost = vCost
			ELSE
				IF VAL("vCost") > 0
					nCost = VAL(vCost)
				ELSE
					nCost = 0
				ENDIF
			ENDIF
		CASE pWHO = "COST"
			IF TYPE("pWHAT") = "N"
				nCost = pWhat
			ELSE
				IF VAL("pWHAT") > 0
					nCost = VAL(pWhat)
				ELSE
					nCost = 0
				ENDIF
			ENDIF
			vSale = ThisForm.pf.pgProc_History.txtActSale.Value 
			IF TYPE("vSale") = "N"
				nSale = vSale
			ELSE
				IF VAL("vSale") > 0
					nSale = VAL(vSale)
				ELSE
					nSale = 0
				ENDIF
			ENDIF
		OTHERWISE
			vCost = ThisForm.pf.pgProc_History.txtActCost.Value 
			IF TYPE("vCost") = "N"
				nCost = vCost
			ELSE
				IF VAL("vCost") > 0
					nCost = VAL(vCost)
				ELSE
					nCost = 0
				ENDIF
			ENDIF
			vSale = ThisForm.pf.pgProc_History.txtActSale.Value 
			IF TYPE("vSale") = "N"
				nSale = vSale
			ELSE
				IF VAL("vSale") > 0
					nSale = VAL(vSale)
				ELSE
					nSale = 0
				ENDIF
			ENDIF
		ENDCASE
		
		
		*IF nSale > 0
		*	IF nCost > 0
				nProfit = nSale  - nCost 
				ThisForm.pf.pgProc_History.txtActProfit.Value = nProfit
				ThisForm.pf.pgProc_History.txtActProfit.Refresh
		*	ENDIF
		*ENDIF
		
	ENDPROC

	PROCEDURE showcurrentstock		&& ShowCurrentStock
		PARAMETER pID_Detail
		*ThisForm.ShowCurrentStock( tmpDetails.ID_Detail )
		PRIVATE nID_Detail, cSQL, lUseMasterHistory
		
		IF TYPE("pID_Detail") = "N"
			nID_Detail = pID_Detail
		ELSE
			nID_Detail = tmpDetails.ID_Detail
		ENDIF
		lUseMasterHistory = .F.
		
		
		cSQL = "SELECT DISTINCT ID FROM dbo.StockLst_Detail WHERE ID_Detail = "+ALLTRIM(STR( nID_Detail ))
		
		IF USED("StockLst_ID")
			USE IN StockLst_ID
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'StockLst_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_ID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_ID')
		ELSE
			nStockLst_ID = StockLst_ID.ID
			IF EMPTY(nStockLst_ID)
				cSQL = "SELECT DISTINCT ID FROM dbo.Ar_Stocklst_Detail_History WHERE ID_Detail = "+ALLTRIM(STR( nID_Detail ))
				IF USED("StockLst_ID")
					USE IN StockLst_ID
				ENDIF
				SELECT 0
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'StockLst_ID')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_ID')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_ID')
					nStockLst_ID = 0
				ELSE
					nStockLst_ID = StockLst_ID.ID
					lUseMasterHistory = .T.
				ENDIF
			ENDIF
			IF USED("StockLst_ID")
				USE IN StockLst_ID
			ENDIF
			
			IF lUseMasterHistory
				cSQL = "SELECT * FROM dbo.Ar_Stocklst_Master_History WHERE ID = "+ALLTRIM(STR( nStockLst_ID ))
				ThisForm.pf.pgCurrStock.cmdAdjInvV.Enabled = .F.
			ELSE
				cSQL = "SELECT * FROM dbo.StockLst_Master WHERE ID = "+ALLTRIM(STR( nStockLst_ID ))
		
				ThisForm.pf.pgCurrStock.cmdAdjInvV.Enabled = .T.
			ENDIF
			
			IF USED("StockLst_Master")
				USE IN StockLst_Master
			ENDIF
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'StockLst_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Master')
			ELSE
				ThisForm.ShowCurrentStockMaster()
			ENDIF
		
			IF lUseMasterHistory OR EMPTY(nStockLst_ID)
				cSQL = "SELECT * " 
				cSQL = cSQL +" FROM dbo.StockLst_Detail WHERE 0 = 1"
			ELSE	
				cSQL = "SELECT * "
				cSQL = cSQL +" FROM dbo.StockLst_Detail WHERE ID = "+ALLTRIM(STR( nStockLst_ID ))
			ENDIF
			
			IF USED("STOCKLST_DETAIL_COST")
				USE IN STOCKLST_DETAIL_COST
			ENDIF
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'STOCKLST_DETAIL_COST')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'STOCKLST_DETAIL_COST')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "STOCKLST_DETAIL_COST")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "STOCKLST_DETAIL_COST")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'STOCKLST_DETAIL_COST')
			ELSE
				ThisForm.ShowStocklstdetail()
			ENDIF
		ENDIF
	ENDPROC

