	PROCEDURE frmSalesOrder.lblInvoice.Click
		IF USED('tmpInvoiceNo')
			USE IN tmpInvoiceNo
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT Invoice FROM dbo.Invoice "
		cSQL = cSQL + " WHERE ISNULL(Reconciled,0) = 0 "
		*cSQL = cSQL + " AND PS_ID > 0 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceNo')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpInvoiceNo' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpInvoiceNo' )
		ENDIF
		
		ThisFormSet.frmUnRecInvoice.Visible = .F.
		
		ThisFormset.frmUnRecInvoice.lstInvoiceUNR.Clear
		
		IF USED('tmpInvoiceNo')
			IF RECCOUNT('tmpInvoiceNo') > 0
				SELECT tmpInvoiceNo
				SCAN
					ThisFormset.frmUnRecInvoice.lstInvoiceUNR.AddItem(STR(tmpInvoiceNo.Invoice))
				ENDSCAN
		
				ThisFormset.frmUnRecInvoice.lstInvoiceUNR.Refresh
				
				ThisFormSet.frmUnRecInvoice.Visible = .T.
				
			ENDIF
			USE IN tmpInvoiceNo	
		ENDIF
	ENDPROC

	PROCEDURE frmSalesOrder.lblSalesOrder.Click
		IF USED('tmpSOitemUnRec')
			USE IN tmpSOitemUnRec
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT Distinct SOitem FROM dbo.Sales_Detail "
		cSQL = cSQL + " WHERE Reconciled = 0 "
		cSQL = cSQL + " AND PS_ID > 0 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitemUnRec')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitemUnRec' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitemUnRec' )
		ENDIF
		
		ThisFormSet.frmUnRecSOitems.Visible = .F.
		
		ThisFormset.frmUnRecSOitems.lstSOitemsUNR.Clear
		
		IF USED('tmpSOitemUnRec')
			IF RECCOUNT('tmpSOitemUnRec') > 0
				SELECT tmpSOitemUnRec
				SCAN
					ThisFormset.frmUnRecSOitems.lstSOitemsUNR.AddItem(tmpSOitemUnRec.SOitem)
				ENDSCAN
		
				ThisFormset.frmUnRecSOitems.lstSOitemsUNR.Refresh
				
				ThisFormSet.frmUnRecSOitems.Visible = .T.
				
			ENDIF
			USE IN tmpSOitemUnRec	
		ENDIF
	ENDPROC

	PROCEDURE frmSalesOrder.lstSales_Detail_ID.InteractiveChange
		ThisFormSet.Sales_Detail_ID = PrepareSQLnum(This.Value,'ID',-3)
		ThisFormSet.Refresh_Sales_Detail_ID()
	ENDPROC

	PROCEDURE frmSalesOrder.lstSOitems.InteractiveChange
		
		ThisFormSet.SOitem = This.Value
		ThisFormSet.Init_lstSales_Detail_ID()
		
		
	ENDPROC

	PROCEDURE frmSalesOrder.txtInvoice.Valid
		PRIVATE nInvoice
		nInvoice = This.Value
		
		IF VARTYPE(nInvoice) = 'C'
			nInvoice = VAL(nInvoice)
		ENDIF
		IF VARTYPE(nInvoice) = 'N'
			IF nInvoice > 0
				ThisForm.cmdFindInvoice.Click
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmSalesOrder.txtSalesOrder.Valid
		PRIVATE nSO
		nSO = This.Value
		
		IF VARTYPE(nSO) = 'C'
			nSO = VAL(nSO)
		ENDIF
		IF VARTYPE(nSO) = 'N'
			IF nSO > 0
				IF ThisFormSet.SalesNum <> nSO
					ThisFormSet.SalesNum = nSO
					ThisForm.cmdFindSO.Click
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmSales_Reconcile.cmdSave.Click
		
		PRIVATE nID,cSOitem
		nID			= ThisFormset.frmSales_Reconcile.txtID.Value 		
		cSOitem		= ThisFormset.frmSales_Reconcile.txtSOitem.Value 	
		
		PRIVATE nSale_QTY, nSale_PC, cDescript, nSale_LBS
		nSale_QTY	= ThisFormset.frmSales_Reconcile.txtSale_QTY.Value 	
		nSale_PC	= ThisFormset.frmSales_Reconcile.txtSale_PC.Value 	
		cDescript	= PrepareSQLtxt(ThisFormset.frmSales_Reconcile.txtDescript.Value,'Descript',254)
		nSale_LBS	= ThisFormset.frmSales_Reconcile.txtWeight.Value 	
		
		PRIVATE nQuoted_QTY, nQuoted_PU, nQuoted_P,nQuoted_Total, nQuoted_PC, nQuoted_Dim1, nQuoted_LBS
		nQuoted_QTY		= ThisFormset.frmSales_Reconcile.txtQuoted_QTY.Value
		nQuoted_PU		= Get_PUfromText(ThisFormset.frmSales_Reconcile.txtQuoted_PU.Value)
		nQuoted_P		= ThisFormset.frmSales_Reconcile.txtQuoted_P.Value
		nQuoted_Total	= ThisFormset.frmSales_Reconcile.txtQuoted_Total.Value
		nQuoted_PC		= ThisFormset.frmSales_Reconcile.txtQuoted_PC.Value
		nQuoted_Dim1	= ThisFormset.frmSales_Reconcile.txtQuoted_Dim1.Value
		nQuoted_LBS		= ThisFormset.frmSales_Reconcile.txtQuoted_LBS.Value
		PRIVATE nStockLst_QTY, nStockLst_P, nStockLst_Total, nStockLst_PU
		PRIVATE nStockLst_PC, nStockLst_Dim1, nStockLst_LBS
		nStockLst_QTY	= ThisFormset.frmSales_Reconcile.txtStockLst_QTY.Value
		nStockLst_P		= ThisFormset.frmSales_Reconcile.txtStockLst_P.Value
		nStockLst_Total	= ThisFormset.frmSales_Reconcile.txtStockLst_Total.Value
		nStockLst_PU	= Get_PUfromText(ThisFormset.frmSales_Reconcile.txtStockLst_PU.Value)
		nStockLst_PC	= ThisFormset.frmSales_Reconcile.txtStockLst_PC.Value
		nStockLst_Dim1	= ThisFormset.frmSales_Reconcile.txtStockLst_Dim1.Value
		nStockLst_LBS	= ThisFormset.frmSales_Reconcile.txtStockLst_LBS.Value
		PRIVATE cAlloy, cForm, cCC
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmSales_Reconcile.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmSales_Reconcile.txtForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmSales_Reconcile.txtCC.Value,'CC',1)
		PRIVATE dtStockEdit, dShipped, dInvoiceDate, lReconciled
		dtStockEdit	= PrepareSQLdate(ThisFormset.frmSales_Reconcile.txtStockEdit.Value,'StockEdit')
		dShipped	= PrepareSQLdate(ThisFormset.frmSales_Reconcile.txtPS_Date.Value,'ShipDate')
		dInvoiceDate= PrepareSQLdate(ThisFormset.frmSales_Reconcile.txtInvoiceDate.Value,'InvoiceDate')
		lReconciled	= PrepareSQLchk(ThisFormset.frmSales_Reconcile.chkReconciled.Value,'Reconciled')
		PRIVATE nProfitMargin, nDisc_Allowed, nReconDiff, nInvoice
		nProfitMargin	= ThisFormset.frmSales_Reconcile.txtProfit.Value
		nDisc_Allowed	= ThisFormset.frmSales_Reconcile.txtDisc_Allowed.Value
		PRIVATE nInvoice, nInvoice_Total, nReconDiff
		nInvoice		= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtInvoice.Value,'Invoice',-3)
		nInvoice_Total		= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtInvoice_Total.Value,'Invoice_Total',-5)
		nReconDiff		= PrepareSQLnum(ThisFormset.frmSales_Reconcile.txtReconDiff.Value,'ReconDiff',-5)
		
		IF nID = 0
			*INSERT
			cSQL = "INSERT INTO dbo.Sales_Detail ("
			cSQL = cSQL +" SOitem"
			cSQL = cSQL +",Invoice"
			cSQL = cSQL +",Sale_QTY"
			cSQL = cSQL +",Sale_PC"
			cSQL = cSQL +",Descript"
			cSQL = cSQL +",Sale_LBS"
			
			cSQL = cSQL +",Quoted_QTY"
			cSQL = cSQL +",Quoted_P"
			cSQL = cSQL +",Quoted_Total"
			cSQL = cSQL +",Quoted_PU"
			cSQL = cSQL +",Quoted_PC"
			cSQL = cSQL +",Quoted_Dim1"
			cSQL = cSQL +",Quoted_LBS"
			
			cSQL = cSQL +",StockLst_Qty"
			cSQL = cSQL +",StockLst_P"
			cSQL = cSQL +",StockLst_Total"
			cSQL = cSQL +",StockLst_PU"
			cSQL = cSQL +",StockLst_PC"
			cSQL = cSQL +",StockLst_Dim1"
			cSQL = cSQL +",StockLst_LBS"
		
			cSQL = cSQL +",Alloy"
			cSQL = cSQL +",Form"
			cSQL = cSQL +",CC"
			
			cSQL = cSQL +",StockEdit"
			cSQL = cSQL +",Shipped"
			cSQL = cSQL +",InvoiceDate"
			cSQL = cSQL +",Reconciled"
			
			cSQL = cSQL +",Margin"
			cSQL = cSQL +",Disc_Allowed"
			cSQL = cSQL +",ReconDiff"
			cSQL = cSQL +",Invoice_Total"
			
			cSQL = cSQL +") VALUES ("
			cSQL = cSQL +"'"+cSOitem+"'"
			cSQL = cSQL +","+STR(nInvoice,10)
			cSQL = cSQL +","+STR(nSale_QTY,18,4)
			cSQL = cSQL +","+STR(nSale_PC,18,4)
			cSQL = cSQL +",'"+cDescript+"'"
			cSQL = cSQL +","+STR(nSale_LBS,7,1)
			
			cSQL = cSQL +","+STR(nQuoted_QTY,18,4)
			cSQL = cSQL +","+STR(nQuoted_P,18,4)
			cSQL = cSQL +","+STR(nQuoted_Total,18,4)
			cSQL = cSQL +","+STR(nQuoted_PU)
			cSQL = cSQL +","+STR(nQuoted_PC,18,4)
			cSQL = cSQL +","+STR(nQuoted_Dim1,18,4)
			cSQL = cSQL +","+STR(nQuoted_LBS,7,1)
		
			cSQL = cSQL +","+STR(nStockLst_QTY,18,4)
			cSQL = cSQL +","+STR(nStockLst_P,18,4)
			cSQL = cSQL +","+STR(nStockLst_Total,18,4)
			cSQL = cSQL +","+STR(nStockLst_PU)
			cSQL = cSQL +","+STR(nStockLst_PC)
			cSQL = cSQL +","+STR(nStockLst_Dim1,18,4)
			cSQL = cSQL +","+STR(nStockLst_LBS,7,1)
		
			cSQL = cSQL +",'"+cAlloy+"'"
			cSQL = cSQL +",'"+cForm+"'"
			cSQL = cSQL +",'"+cCC+"'"
			
			cSQL = cSQL +",'"+IIF(dtStockEdit =CTOT("  /  /  "),'',TTOC(dtStockEdit))+"'"
			cSQL = cSQL +",'"+IIF(dShipped    =CTOD("  /  /  "),'',DTOC(dShipped))+"'"
			cSQL = cSQL +",'"+IIF(dInvoiceDate=CTOD("  /  /  "),'',DTOC(dInvoiceDate))+"'"
			cSQL = cSQL +","+IIF(lReconciled,"1","0")
			
			cSQL = cSQL +","+STR(nProfitMargin,18,4)
			cSQL = cSQL +","+STR(nDisc_Allowed,18,4)
			cSQL = cSQL +","+STR(nReconDiff,18,4)
			cSQL = cSQL +","+STR(nInvoice_Total,18,4)
			cSQL = cSQL +")"
		ELSE
			*UPDATE
			cSQL = "UPDATE dbo.Sales_Detail SET "
			cSQL = cSQL +" SOitem='"+cSOitem+"'"
			cSQL = cSQL +",Invoice="+STR(nInvoice)
			cSQL = cSQL +",Sale_QTY="+STR(nSale_QTY,18,4)
			cSQL = cSQL +",Sale_PC="+STR(nSale_PC,18,4)
			cSQL = cSQL +",Descript='"+cDescript+"'"
			cSQL = cSQL +",Sale_LBS="+STR(nSale_LBS,7,1)
			
			cSQL = cSQL +",Quoted_QTY="+STR(nQuoted_QTY,18,4)
			cSQL = cSQL +",Quoted_P="+STR(nQuoted_P,18,4)
			cSQL = cSQL +",Quoted_Total="+STR(nQuoted_Total,18,4)
			cSQL = cSQL +",Quoted_PU="+STR(nQuoted_PU)
			cSQL = cSQL +",Quoted_PC="+STR(nQuoted_PC,18,4)
			cSQL = cSQL +",Quoted_Dim1="+STR(nQuoted_Dim1,18,4)
			cSQL = cSQL +",Quoted_LBS="+STR(nQuoted_LBS,7,1)
		
			cSQL = cSQL +",StockLst_QTY="+STR(nStockLst_QTY,18,4)
			cSQL = cSQL +",StockLst_P="+STR(nStockLst_P,18,4)
			cSQL = cSQL +",StockLst_Total="+STR(nStockLst_Total,18,4)
			cSQL = cSQL +",StockLst_PU="+STR(nStockLst_PU)
			cSQL = cSQL +",StockLst_PC="+STR(nStockLst_PC)
			cSQL = cSQL +",StockLst_Dim1="+STR(nStockLst_Dim1,18,4)
			cSQL = cSQL +",StockLst_LBS="+STR(nStockLst_LBS,7,1)
		
			cSQL = cSQL +",Alloy='"+cAlloy+"'"
			cSQL = cSQL +",Form='"+cForm+"'"
			cSQL = cSQL +",CC='"+cCC+"'"
			
			cSQL = cSQL +",StockEdit='"+IIF(dtStockEdit  =CTOD("  /  /  "),'',TTOC(dtStockEdit))+"'"
			cSQL = cSQL +",Shipped='"+IIF(dShipped    =CTOD("  /  /  "),'',DTOC(dShipped))+"'"
			cSQL = cSQL +",InvoiceDate='"+IIF(dInvoiceDate=CTOD("  /  /  "),'',DTOC(dInvoiceDate))+"'"
			cSQL = cSQL +",Reconciled="+IIF(lReconciled,"1","0")
			
			cSQL = cSQL +",Margin="+STR(nProfitMargin,18,4)
			cSQL = cSQL +",Disc_Allowed="+STR(nDisc_Allowed,18,4)
			cSQL = cSQL +",ReconDiff="+STR(nReconDiff,18,4)
			cSQL = cSQL +",Invoice_Total="+STR(nInvoice_Total,18,4)
			cSQL = cSQL +" WHERE ID="+STR(nID)
			
		ENDIF
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		ELSE
			WAIT WINDOW "Saved" NOWAIT
			
			IF nID = 0
				*Get ID
				IF USED('tmpSales_DetailID')
					USE IN tmpSales_DetailID
				ENDIF
				
				SELECT 0
				cSQL = "SELECT ID FROM dbo.Sales_Detail WHERE "
				cSQL = cSQL +" SOitem='"+cSOitem+"'"
				cSQL = cSQL +" AND Invoice="+STR(nInvoice)
				cSQL = cSQL +" AND Sale_QTY="+STR(nSale_QTY,18,4)
				cSQL = cSQL +" AND Sale_PC="+STR(nSale_PC,18,4)
				cSQL = cSQL +" AND Descript='"+cDescript+"'"
				cSQL = cSQL +" AND Sale_LBS="+STR(nSale_LBS,7,1)
				
				cSQL = cSQL +" AND Quoted_QTY="+STR(nQuoted_QTY,18,4)
				cSQL = cSQL +" AND Quoted_P="+STR(nQuoted_P,18,4)
				cSQL = cSQL +" AND Quoted_Total="+STR(nQuoted_Total,18,4)
				cSQL = cSQL +" AND Quoted_PU="+STR(nQuoted_PU)
				cSQL = cSQL +" AND Quoted_PC="+STR(nQuoted_PC,18,4)
				cSQL = cSQL +" AND Quoted_Dim1="+STR(nQuoted_Dim1,18,4)
				cSQL = cSQL +" AND Quoted_LBS="+STR(nQuoted_LBS,7,1)
		
				cSQL = cSQL +" AND StockLst_QTY="+STR(nStockLst_QTY,18,4)
				cSQL = cSQL +" AND StockLst_P="+STR(nStockLst_P,18,4)
				cSQL = cSQL +" AND StockLst_Total="+STR(nStockLst_Total,18,4)
				cSQL = cSQL +" AND StockLst_PU="+STR(nStockLst_PU)
				cSQL = cSQL +" AND StockLst_PC="+STR(nStockLst_PC)
				cSQL = cSQL +" AND StockLst_Dim1="+STR(nStockLst_Dim1,18,4)
				cSQL = cSQL +" AND StockLst_LBS="+STR(nStockLst_LBS,7,1)
		
				cSQL = cSQL +" AND Alloy='"+cAlloy+"'"
				cSQL = cSQL +" AND Form='"+cForm+"'"
				cSQL = cSQL +" AND CC='"+cCC+"'"
				
				cSQL = cSQL +" AND StockEdit='"+IIF(dtStockEdit    =CTOD("  /  /  "),'',TTOC(dtStockEdit))+"'"
				cSQL = cSQL +" AND Shipped='"+IIF(dShipped    =CTOD("  /  /  "),'',DTOC(dShipped))+"'"
				cSQL = cSQL +" AND InvoiceDate='"+IIF(dInvoiceDate=CTOD("  /  /  "),'',DTOC(dInvoiceDate))+"'"
				cSQL = cSQL +" AND Reconciled="+IIF(lReconciled,"1","0")
				
				cSQL = cSQL +" AND Margin="+STR(nProfitMargin,18,4)
				cSQL = cSQL +" AND Disc_Allowed="+STR(nDisc_Allowed,18,4)
				cSQL = cSQL +" AND ReconDiff="+STR(nReconDiff,18,4)
				cSQL = cSQL +" AND Invoice_Total="+STR(nInvoice_Total,18,4)
				
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL ,'tmpSales_DetailID' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL ,'tmpSales_DetailID' )
					
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC,'tmpSales_DetailID' )
				ENDIF
				IF USED('tmpSales_DetailID')
					IF RECCOUNT('tmpSales_DetailID') > 0
						nID = tmpSales_DetailID.ID
						ThisFormset.frmSales_Reconcile.txtID.Value 	= nID
						ThisFormSet.Init_lstSales_Detail_ID()
					ENDIF
					USE IN tmpSales_DetailID	
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.frmSalesOrder.chkReconciled.Value = IIF(lReconciled,1,0)
		
		ThisFormSet.Save_Invoice_Reconcile(lReconciled)
		ThisFormSet.Save_PackingSlip_Reconcile(lReconciled)
		ThisFormSet.Save_Sales_Stock_Reconcile(lReconciled)
		
		
	ENDPROC

	PROCEDURE frmSales_Reconcile.LBLSOITEM1.Click
		PRIVATE nSaleNum
		*nSalesNum = ThisFormSet.Salesnum 
		DO FORM Forms\EnterOrder WITH ThisFormSet.Salesnum
		*, .T.
	ENDPROC

	PROCEDURE frmSales_Reconcile.txtReconDiff.Valid
		ThisFormSet.ShowSumTotal()
	ENDPROC

	PROCEDURE frmSales_stock.cmdHide.Click
		*ThisFormSet.Release
		ThisForm.Visible = .F.
	ENDPROC

	PROCEDURE frmSales_stock.grdSales_Stock.AfterRowColChange
		LPARAMETERS nColIndex
		ThisFormSet.Show_Sales_Stock()
		
	ENDPROC

	PROCEDURE frmUnRecInvoice.cmdQuit.Click
		ThisForm.Visible =.f.
		ThisFormSet.frmSalesOrder.SetFocus
		
	ENDPROC

	PROCEDURE frmUnRecInvoice.cmdSelectInvoice.Click
		
		PRIVATE nInvoice
		
		nInvoice = ThisForm.lstInvoiceUNR.Value
		
		ThisformSet.frmSalesOrder.txtInvoice.Value = nInvoice 
		
		ThisForm.Visible = .F.
		
		ThisFormSet.frmSalesOrder.cmdfindInvoice.Click
		*ThisFormSet.frmSalesOrder.lstInvoice.Value = nInvoice 
		
		
	ENDPROC

	PROCEDURE frmUnRecSOitems.cmdQuit.Click
		ThisForm.Visible =.f.
		ThisFormSet.frmSalesOrder.SetFocus
		
	ENDPROC

	PROCEDURE frmUnRecSOitems.cmdSelectSO.Click
		
		PRIVATE cSOitem, nSalesNum, cDecimals
		
		cSOitem = ThisForm.lstSOitemsUNR.Value
		nSalesNum = LEFT(cSOitem,AT("-",cSOitem))
		
		cDecimals = SET("Decimals")
		SET DECIMALS TO 0
		nSalesNum = VAL( nSalesNum )
		SET DECIMALS TO (cDecimals)
		
		ThisformSet.frmSalesOrder.txtSalesOrder.Value = nSalesNum
		
		ThisForm.Visible = .F.
		
		ThisFormSet.frmSalesOrder.cmdFindSO.Click
		ThisFormSet.frmSalesOrder.lstSOitems.Value = cSOitem
		
		ThisFormSet.SOitem = cSOitem
		
		
		ThisFormSet.Init_Sales_Stock()
		ThisFormSet.Init_PackingSlip()
		ThisFormSet.Init_Invoice()
		ThisFormSet.Init_lstSales_Detail_ID()
	ENDPROC

ENDDEFINE
