				ThisFormset.frmSales_Reconcile.txtStockLst_P.Value 		= tmpSales_Detail.StockLst_P
				ThisFormset.frmSales_Reconcile.txtStockLst_Total.Value	= tmpSales_Detail.StockLst_Total
				ThisFormset.frmSales_Reconcile.txtStockLst_PC.Value 	= tmpSales_Detail.StockLst_PC
