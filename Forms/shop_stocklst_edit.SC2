	PROCEDURE frmStockLstProcesses.cmdBackWard.Click
		PRIVATE lShowSTK
		lShowSTK = .F.
		
		SELECT tmpProcess
		IF !BOF("tmpProcess")
			SKIP -1 IN tmpProcess
			lShowSTK = .T.
		ENDIF
		IF BOF("tmpProcess")
			WAIT WINDOW 'Top of file' NOWAIT
			GO TOP IN tmpProcess
		ENDIF
		
		ThisFormSet.RefreshStockLstProcesses()
		
		ThisFormSet.IsProcess_Of_Order()
		
		ThisForm.refresh
		THISFORMSET.frmStockLstProcesses.txtRec.Value = RECNO("tmpProcess")
		
		ThisFormSet.Check_ID_Detail_Process()
		
		IF VARTYPE(ThisFormSet.frmStockStatus) = "O"
			ThisFormSet.frmStockStatus.Visible = .F.
		ENDIF
		ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
		ThisFormSet.frmSimiliarSales.Visible = .F.
		
		IF ThisFormSet.frmStocklst_SQL.Visible
			*ThisFormSet.frmStocklst_SQL.GoToID_Detail(tmpProcess.ID_Detail)
			ThisFormSet.frmStocklst_SQL.GoToID_Detail(tmpProcess.ID_Detail,tmpProcess.Prc_Dim2,tmpProcess.Prc_Dim3)
		ENDIF
	ENDPROC

	PROCEDURE frmStockLstProcesses.cmdForward.Click
		PRIVATE lShowSTK
		lShowSTK = .F.
		
		SELECT tmpProcess
		IF !EOF("tmpProcess")
			SKIP 1 IN tmpProcess
			lShowSTK = .T.
		ENDIF
		IF EOF("tmpProcess")
			WAIT WINDOW 'Bottom of file' NOWAIT
			GO BOTTOM IN tmpProcess
		ENDIF
		
		ThisFormSet.RefreshStockLstProcesses()
		ThisFormSet.IsProcess_Of_Order()
		
		ThisForm.refresh
		THISFORMSET.frmStockLstProcesses.txtRec.Value = RECNO("tmpProcess")
		
		ThisFormSet.Check_ID_Detail_Process()
		
		
		IF VARTYPE(ThisFormSet.frmStockStatus) = "O"
			ThisFormSet.frmStockStatus.Visible = .F.
		ENDIF
		ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
		ThisFormSet.frmSimiliarSales.Visible = .F.
		
