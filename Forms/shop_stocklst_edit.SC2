	PROCEDURE frmStockLstProcesses.AllowSub1.Valid
		DO CASE
		CASE ISNULL(This.Value)
			RETURN .T.
		CASE EMPTY(This.Value)
			RETURN .T.
		CASE UPPER(This.Value) = "N"
			RETURN .T.
		CASE UPPER(This.Value) = "Y"
			RETURN .T.
		CASE UPPER(This.Value) = "T" 
			This.Value = "Y"
			RETURN .T.
		CASE UPPER(This.Value) = "F"
			This.Value = "N"
			RETURN .T.
		OTHERWISE		
			RETURN .F.
		ENDCASE
	ENDPROC

	PROCEDURE frmStockLstProcesses.chkFoundStock.Click
		
		PRIVATE lFoundStk
		lFoundStk = PrepareSQLchk(This.Value,'FoundStk')
		
		IF lFoundStk 
			ThisFormSet.Grab_foundStk(lFoundStk)
		ELSE
			PRIVATE nID_Detail_Process
			nID_Detail_Process = PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
			
			PRIVATE cTBL
			cTBL = ThisForm.tbl.Value
			
			*Update Proc --UNDO
			PRIVATE cSQL, nSQLEXEC 
			IF USED("CntProcess")
				USE IN CntProcess
			ENDIF
			SELECT 0
		
			cSQL = ""
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + "UPDATE dbo.StockLst_Process "
			CASE cTBL = "B"
				cSQL = cSQL + "UPDATE dbo.BrokerLst_Process "
			CASE cTBL = "W"
				cSQL = cSQL + "UPDATE dbo.WIPLst_Process "
			OTHERWISE
				MESSAGEBOX("Check_ID_Detail_Process did not recognize Table Name",0+16,"Aborting Save!")
				TrackError("Check_ID_Detail_Process did not recognize Table Name","Check_ID_Detail_Process did not recognize Table Name",PROGRAM(),LINENO(1))
				RETURN .F.
			ENDCASE
		*	IF lFoundStk 
		*		cSQL = cSQL + " SET FoundSTK = GETDATE() "
		*	ELSE
				cSQL = cSQL + " SET FoundSTK = NULL "
		*	ENDIF
			cSQL = cSQL + " WHERE ID_Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))
		
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CntProcess' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CntProcess' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntProcess")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntProcess")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			PRIVATE lOK
			lOK = .T.
			IF nSQLEXEC < 0
				IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'CntProcess')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
					lOK = .F.
				ENDIF
			ENDIF
		
			PRIVATE cSOitem, nSalesNum, cWhat, nWO
			cSOitem		= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.SOitem1.Value,'SOitem',10)
			nSalesNum 	= Proper_SO_item_SO(cSOitem)
			cWhat 		= 'Found Stock' &&CHAR(20)
			nWO			= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.WO1.Value,'WO',-3)
			
			PRIVATE cComment 
			cComment = ''
			IF lOK
				cComment = LEFT(cComment,255)
				IF nSalesNum > 0
		*			IF lFoundStk 
		*				cComment = 'Grabbed '+cComment
		*			ELSE
						cComment = 'RemoveGrab '+cComment
		*			ENDIF
					SaveTo_SOitem_Status( cSOitem, cWhat, cComment, ThisFormSet.nConnHandle )
					lOK = set_rtr_Detail_Oper('SOi',cSOitem,105,522,cComment,.T.,ThisFormSet.nConnHandle)
				ELSE
					IF nWO>0
		*				IF lFoundStk 
		*					cComment = 'Grabbed '+cComment
		*				ELSE
							cComment = 'RemoveGrab '+cComment
		*				ENDIF		
						SaveTo_WorkOrder_Notes(nWO, 0, cComment, ThisFormSet.nConnHandle )
						lOK = set_rtr_Detail_Oper('WO',nWO,105,522,cComment,.T.,ThisFormSet.nConnHandle)
					ENDIF
				ENDIF
		
		
		
				IF ThisFormSet.frmStocklst_SQL.Visible
					ThisFormSet.Show_Selected_INV("FULL_STK_PRC")
					ThisFormSet.frmStocklst_SQL.GoToID_Detail(tmpProcess.ID_Detail,tmpProcess.Prc_Dim2,tmpProcess.Prc_Dim3)
				ENDIF
		
				*Remove Grab Found Stock Process 
				PRIVATE cSQLi 
				cSQLi = "DELETE FROM dbo.StockLst_Process_Grab "
				cSQLi = cSQLi + " WHERE ID_Detail_Process="+STR(nID_Detail_Process)+""
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				
				IF nSQLEXEC < 0 
					This.Value = !This.Value
					MESSAGEBOX("Error with SQL",0,"Did not work")
				ENDIF
			
				MESSAGEBOX("Removed FOUND STOCK Mark from the SELECTED process and Pulled from Rack.",0,"Remove Grab")
			ENDIF
		ENDIF
		
		
		
	ENDPROC

