	PROCEDURE frmStockLstProcesses.cmdIncomingPRC.Click
		PRIVATE cPOitem, cSOitem, nMess, nWO, nWO_Detail, nID_Detail
		nMess = 0
		cPOitem = PrepareSQLtxt(ThisForm.PO_ITEM1.Value,'POitem',12)
		cSOitem = Proper_SO_Item(ThisForm.SOITEM1.Value)
		nWO		= PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		nWO_Detail = PrepareSQLnum(ThisForm.WO_Detail1.Value,'WO_Detail',-3)
		nID_Detail = PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3)
		
		PRIVATE nCurrRec, lFound, cTBL, cMess
		nCurrec = RECNO('tmpSO')
		lFound = .F.
		cTBL = PrepareSQLtxt(ThisForm.Tbl.Value,'TBL',1)
		
		***
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item('') AND nWO = 0 AND nWO_Detail = 0
			MESSAGEBOX("Did not find (POitem, WO or WO_Detail) to start with."+CHR(13)+"",46,"Cannot continue.")
			RETURN
		ENDIF
		*****
		
		***** Check for Incoming that is not to shown at HPA, Return if Found
		
		IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
			lFound = StockLst_Process_Count_POitem( cPOitem, cTBL, ThisFormSet.nConnHandle, "INCOMINGNOT2HPA") > 0
			
			IF lFound 
				cMess = "This POitem:"+ALLTRIM(cPOitem)+CHR(13)+" already has an 'INCOMING' OR 'PARTRECV' OR 'NOT2HPA' process."+CHR(13)+"SO '"+ALLTRIM(STR(ThisFormSet.SalesNum))+"'  TBL '"+cTBL+"'"+CHR(13)+"Use the [Receive] button."
			 	MESSAGEBOX(cMess,0,"Cannot Create Process for this POitem")
			 	RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)	 
			 	ThisForm.cmdReceive.Visible = .T.
			ENDIF
		ENDIF
		***
		IF nWO > 0
			lFound = StockLst_Process_Count_WO( nWO, cTBL, ThisFormSet.nConnHandle, "INCOMINGNOT2HPA") > 0
			
			IF lFound 
				cMess = "This  WO:"+ALLTRIM(STR(nWO))+CHR(13)+" already has an 'INCOMING' OR 'PARTRECV' OR 'NOT2HPA' process."+CHR(13)+"SO '"+ALLTRIM(STR(ThisFormSet.SalesNum))+"'  TBL '"+cTBL+"'"+CHR(13)+"Use the [Receive] button."
			 	MESSAGEBOX(cMess,0,"Cannot Create Process for this WO")
			 	RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)	 	
			 	ThisForm.cmdReceive.Visible = .T.
			ENDIF
		ENDIF
		***
		IF nWO_Detail > 0
			lFound = StockLst_Process_Count_WOD( nWO_Detail, cTBL, ThisFormSet.nConnHandle, "INCOMINGNOT2HPA") > 0
			
			IF lFound 
				cMess = "This  WO_Detail:"+ALLTRIM(STR(nWO_Detail))+CHR(13)+" already has an 'INCOMING' OR 'PARTRECV' OR 'NOT2HPA' process."+CHR(13)+"SO '"+ALLTRIM(STR(ThisFormSet.SalesNum))+"'  TBL '"+cTBL+"'"+CHR(13)+"Use the [Receive] button."
			 	MESSAGEBOX(cMess,0,"Cannot Create Process for this WO_Detail")
			 	RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)	 	
			 	ThisForm.cmdReceive.Visible = .T.
			ENDIF
		ENDIF
		***
		IF Is_ID_Detail(cTBL,nID_Detail,ThisFormSet.nConnhandle,'INCOMING')
			MESSAGEBOX("Found an 'INCOMING' process "+CHR(13)+"Please Receive material first!"+CHR(13)+"Click the Receive button again when 'Process_ID' is 'INCOMING'.",0+48,"Cannot continue.")
			ThisForm.cmdReceive.Visible = .T.
			RETURN .F.
		ENDIF
		****
		*Check Receiving Table
		PRIVATE lUsedWhere
		lUsedWhere = .F.
		
		*nCntPOitem = Count_POIteminReceiving( cPOItem, ThisForm.nConnHandle, cAndSome )
		IF USED("cntRecv")
			USE IN cntRecv
		ENDIF
		
		cSQL = "SELECT ID,POitem,SOitem,WO_Detail  "
		cSQL = cSQL + " FROM dbo.Receiving WITH(NOLOCK) "
		IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
			cSQL = cSQL + " WHERE POItem = dbo.f_ProperPOitem('"+cPOItem+"')"
			lUsedWhere = .T.
		ENDIF
		IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
			IF NOT lUsedWhere
				cSQL = cSQL + " WHERE SOItem = dbo.f_ProperSOitem('"+cSOItem+"')"
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " OR SOItem = dbo.f_ProperSOitem('"+cSOItem+"')"
			ENDIF
		ENDIF
		IF nWO_Detail > 0
			IF NOT lUsedWhere
				cSQL = cSQL + " WHERE WO_Detail= "+STR(nWO_Detail)
				lUsedWhere = .T.
			ELSE
				cSQL = cSQL + " OR WO_Detail= "+STR(nWO_Detail)
			ENDIF
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntRecv')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntRecv')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntRecv')
			RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
		ENDIF
		
		PRIVATE nReceiveID,cMess,nMess
		nReceiveID = 0
		cMess = ''
		nMess = 6	&&Yes
		
		IF USED("cntRecv")
			IF RECCOUNT('cntRecv') > 0
				SCAN
					nReceiveID = PrepareSQLnum(cntRecv.ID,'ReceivingID',-3)
					cMess = "Found "+ALLTRIM(STR(RECCOUNT('cntRecv')))+" records for this"+CHR(13)
					cMess = cMess + "Please look at this Receiving Record"+CHR(13)
		
					IF Proper_PO_Item(cntRecv.POitem) <> Proper_PO_Item('')
						cMess = cMess + "POitem = '"+Proper_PO_Item(cntRecv.POitem)+"'"+CHR(13)
					ENDIF
					IF PrepareSQLnum(cntRecv.WO_Detail,'WO_Detail',-3) > 0
						cMess = cMess + "WO_Detail = "+STR(PrepareSQLnum(cntRecv.WO_Detail,'WO_Detail',-3))+""+CHR(13)
					ENDIF	
					IF Proper_SO_Item(cntRecv.SOitem) <> Proper_SO_Item('')
						cMess = cMess + "SOitem = '"+Proper_SO_Item(cntRecv.SOitem)+"'"+CHR(13)
					ENDIF	
					cMess = cMess +CHR(13)+ "Do NOT change if this is not your item"+CHR(13)+"If you actualy need to Add"+CHR(13)+"another Receive record just Abort here."+CHR(13)+CHR(13)
						
					MESSAGEBOX(cMess,0,"Possible receive Record")
					DO FORM Forms\Receive_Edit WITH 'EDIT',nReceiveID,''
					
				ENDSCAN
			ELSE
				nReceiveID = 0
			ENDIF
			USE IN cntRecv
		ENDIF
		
		*IF nReceiveID > 0
			*DO FORM Forms\ChooseReceivingID WITH cPOitem, 'POitem' TO nReceiveID
			*DO FORM Forms\ChooseReceivingDetails WITH '   509753-04','62878-6RAA',"S"
		*ENDIF
		
		IF LEN(cMess) > 0
			nMess = MESSAGEBOX("Do you still need to add a receiving Record?",4+32,"Add Receiving?")
		ENDIF
		
		***************
		*OR 'NOT2HPA'
		*Add the Incoming Process with the Received Stock!
		
		IF nMess = 6
			IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
				nMess = MESSAGEBOX("Is this the POitem:"+ALLTRIM(cPOitem)+CHR(13)+"you want to Receive Stock for?"+CHR(13)+CHR(13)+"(missing the 'INCOMING' process)"+CHR(13)+"Receive in metal when the Receive process is missing.",4+32,"Receive Stock")
				IF nMess = 6
					PRIVATE nID_D_P 
					nID_D_P = 0
					*cTBL
					*See if S_Process
					nID_D_P = getID_D_P_with_POitem( cPOitem, "S", ThisFormSet.nConnHandle, '')
					IF nID_D_P > 0
						DO FORM Forms\Receive_Edit WITH "S_Process", nID_D_P, 'EDIT'
					ELSE
						*See if B_Process
						nID_D_P = getID_D_P_with_POitem( cPOitem, "B", ThisFormSet.nConnHandle, '')
						IF nID_D_P > 0
							DO FORM Forms\Receive_Edit WITH "B_Process", nID_D_P, 'EDIT'
						ELSE
							*See if W_Process				
							nID_D_P = getID_D_P_with_POitem( cPOitem, "W", ThisFormSet.nConnHandle, '')
							IF nID_D_P > 0
								DO FORM Forms\Receive_Edit WITH "W_Process", nID_D_P, 'EDIT'
							ELSE
								*otherwise
								DO FORM Forms\Receive_Edit WITH "POitem",cPOitem,'ADD'
								** send message that this Order has a SELECTED process !!!
								MESSAGEBOX("Since there was programming confusion receiving material,"+CHR(13)+"please make sure there is not a Duplicate entry now.",0+48,"Check for DUPLICATE stock!")
								
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		
			IF nWO > 0
				nMess = MESSAGEBOX("Is this the WO:"+ALLTRIM(STR(nWO))+CHR(13)+"you want to Receive Stock for?"+CHR(13)+"(missing the 'INCOMING' process)",4+32,"Receive Stock")
				IF nMess = 6
					DO FORM Forms\Receive_Edit WITH "WO",nWO,'ADD'
				ENDIF
			ENDIF
		
			IF nWO_Detail > 0
				nMess = MESSAGEBOX("Is this the WO_Detail:"+ALLTRIM(STR(nWO_Detail))+CHR(13)+"you want to Receive Stock for?"+CHR(13)+"(missing the 'INCOMING' process)",4+32,"Receive Stock")
				IF nMess = 6
					DO FORM Forms\Receive_Edit WITH "WO_Detail",nWO_Detail,'ADD'
				ENDIF
			ENDIF
		ENDIF
		
		THISFORMSET.StockLstProcesses(0,'',"Show")
		
		*DO FORM Forms\Receive_Edit WITH 'EDIT',nRID,''
		*DO FORM Forms\Receive_Edit WITH 'ADD','','ADD' --create RID
		*DO FORM Forms\Receive_Edit WITH 'B_Process', pnID_Detail_process ,cHeat
		*pcWhat = "ADD "EDIT "RMA "POitem "SOitem" tk_Detail "Brk_Detail "S_Process "B_Process" W_Process "WO_Detail "WO"
		
		WAIT WINDOW "Processes have been refreshed!" NOWAIT
	ENDPROC

	PROCEDURE frmStockLstProcesses.cmdModiStock.Click
		*Make sure INCOMING process are taken care of First
		PRIVATE nID, nID_Detail, nID_Detail_Process
		*nID				   = ThisForm.ID.Value
		nID_Detail		   = ThisForm.ID_Detail.Value
		nID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		
		PRIVATE cTBL
		cTBL = ThisForm.Tbl.Value
		
		PRIVATE lFoundStk
		lFoundStk = PrepareSQLchk(ThisForm.chkFoundStock.Value,'FoundStk')
		IF lFoundStk 
			ThisFormSet.Make_Process_Grab(nID_Detail_Process,ThisForm.Tbl.Value)   && run again for check
		ELSE
			ThisFormSet.Grab_foundStk(.T.)
			ThisForm.chkFoundStock.Value = lFoundStk 
		ENDIF
		
		*Forms\Modify_Stock4Order 
		PRIVATE cPOitem, nWO, cSOitem
		cPOitem = PrepareSQLtxt(ThisForm.PO_Item1.Value,'POitem',12)
		nWO		= PrepareSQLnum(ThisFormSet.nWorkOrder,'WO',-3)
		cSOitem = PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		
		
		
		IF Is_ID_Detail(cTBL,nID_Detail,ThisFormSet.nConnhandle,'INCOMING')
			ThisForm.cmdReceive.Visible = .T.
			MESSAGEBOX("Found an 'INCOMING' process "+CHR(13)+"Please Receive material first!"+CHR(13)+"Click the Receive button again when 'Process_ID' is 'INCOMING'.",0+48,"Cannot continue.")
			RETURN .F.
		ENDIF
		
		IF Is_ID_Detail(cTBL,nID_Detail,ThisFormSet.nConnhandle,'NOT2HPA')
			ThisForm.cmdReceive.Visible = .T.
			MESSAGEBOX("There is an 'NOT2HPA' process "+CHR(13)+"Please FAKE Receive material first!"+CHR(13)+"Click the Receive button again when 'Process_ID' is 'NOT2HPA'.",0+48,"Cannot continue.")
			RETURN .F.
		ENDIF
		
		IF Is_ID_Detail(cTBL,nID_Detail,ThisFormSet.nConnhandle,'PARTRECV')	
			ThisForm.cmdReceive.Visible = .T.
			MESSAGEBOX("There is an 'PARTRECV' process."+CHR(13)+"You may need to Receive material first!"+CHR(13)+"Use <> to find 'PARTRECV' process!",0+48,"Warning")
		ENDIF
		
		
		********************************
		PRIVATE lGoodPOitem, lDoneReceiving, cPOitem
		lGoodPOitem = .F.
		lDoneReceiving = .F.
		cPOitem = PrepareSQLtxt(tmpProcess.PO_Item,'POitem',12)
		IF Proper_PO_Item(cPOItem) = Proper_PO_Item('')
			*Not by POitem
			lGoodPOitem = .F.
			lDoneReceiving = .T.
		ELSE
			lGoodPOitem = .T.
			lDoneReceiving = ThisFormSet.CheckReceivingID_Detail_process( nID_Detail_Process, nID_Detail, cTbl, cPOitem, nWO )
		ENDIF
		
		IF lGoodPOitem
			IF NOT lDoneReceiving
				*Try ???
				lDoneReceiving = ThisFormSet.CheckReceiving_POitem( ThisFormSet.Tbl_Process, tmpProcess.PO_Item )
			ENDIF
		ENDIF
		
		IF lGoodPOitem AND lDoneReceiving 
			nCntPOitem = Count_PO_IteminProcess( tmpProcess.PO_Item, ThisFormSet.nConnHandle,"NEEDRECV" )
			IF nCntPOitem > 0
				MESSAGEBOX("There is still another process to be Received on POitem '"+tmpProcess.PO_Item+"'.",64,"Need to Receive another process")
			ENDIF
			
			*nCntPOitem = Count_PO_IteminProcess( tmpProcess.PO_Item, ThisFormSet.nConnHandle,"SELECTED" )
			*IF nCntPOitem = 0
			*	*MESSAGEBOX("There is no SELECTED process to work with on POitem '"+tmpProcess.PO_Item+"'."",64,"Select Stock now.")
			*	WAIT WINDOW "There is no SELECTED process to work with on POitem '"+tmpProcess.PO_Item+"'."+CHR(13)+"Select Stock to continue." NOWAIT
			*ENDIF
			
		ENDIF
		
		**********************
		
		ThisFormSet.ID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		ThisFormSet.Tbl_Process = tmpProcess.Tbl
		*ThisFormSet.ID_Detail_Process_Name = ThisForm.Name
		
		ThisFormSet.Stocklst_ID			= 0 &&PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		ThisFormSet.Stocklst_ID_Detail	= PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3)
		ThisFormSet.StockLst_TBL		= ThisForm.TBL.Value
		
		PRIVATE lAllowSub
		lAllowSub = PrepareSQLlogic(ThisForm.AllowSub1.Value,'AllowSub',.T.)
		
		********************************************
		*Modify Stock
		PRIVATE cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
		cTBL				= PrepareSQLtxt(tmpProcess.TBL,'TBL',1)
		nID_Detail			= PrepareSQLnum(tmpProcess.ID_Detail,'ID_Detail',-3)
		nID_Detail_Process	= PrepareSQLnum(tmpProcess.ID_Detail_Process,'ID_Detail_Process',-3)
		cSOitem				= PrepareSQLtxt(tmpProcess.SOitem,'SOitem',10)
		cPOitem				= PrepareSQLtxt(tmpProcess.PO_item,'POitem',12)
		nWO					= PrepareSQLnum(tmpProcess.WO,'WO',-3)
		
		*ThisFormSet.StockLst_ID_Detail = nID_Detail
		ThisForm.ID_Detail.Value = nID_Detail
		
		IF NOT ThisFormSet.frmSelectedStock.Visible		
			ThisFormSet.Show_Selected_INV("FULL_STK_PRC")
		ENDIF
		
		
		ThisForm.AlwaysOnTop = .F.
		
		DO FORM Forms\Modify_Stock4Order WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
		*DO FORM Forms\Modify_Stocklst_Detail WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
		
		IF TYPE("MODIFY_STOCK4ORDER") = "O"
		*	ThisFormSet.MODIFY_STOCK4ORDER.Release
		ENDIF
		
		
		
		ThisForm.AlwaysOnTop = .T.
		
		*ThisFormSet.RefreshTmpQuotes()
		ThisFormSet.RefreshSO()
		
		*Refresh Stock view
		WAIT WINDOW STR(ThisFormSet.StockLst_ID_Detail) NOWAIT
		
		ThisFormSet.RefreshStockLst("REFRESH", cTBL )	&&Fat Query
		ThisFormSet.Show_Selected_INV("FULL_STK_PRC")	&&2020-02
		
		*******************************************************
		*******************************************************
		**Added back 2020 for Wayne, he complains it take too much time for him to click the Show Stock
		PRIVATE cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,nPC,nLBS,cHeatLot,nQTY,lRL,nID_Detail2
		cAlloy	= ''
		cForm	= ''
		cCC		= ''
		cCL		= ''
		nThck	= 0
		nSz2	= 0
		nSz3	= 0
		nPC		= 0
		nLBS	= 0
		cHeatLot	= ''
		nQTY	= 0	&&QTY Needed for Process
		lRL		= .T.
		nID_Detail2 = 0
		* Get Data for ID_Detail
		
		IF USED('tmpID_Detail_Data')
			USE IN tmpID_Detail_Data
		ENDIF
		SELECT 0
				
		cSQL = "SELECT M.Alloy,M.Form,M.CC,M.CL,M.Size,D.Dim2,D.Dim3,D.PC,D.[Weight],TRIM(M.Heat)+' '+TRIM(M.Lot) AS HeatLot,D.RandLen "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Detail D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "	
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID = M.ID "	
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Detail D WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID = M.ID "	
		ENDCASE
		cSQL = cSQL + " WHERE D.ID_Detail="+STR(nID_Detail)
		
		nSQLEXEC = SQLEXEC(THISFORMset.nConnHandle, cSQL, 'tmpID_Detail_Data' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpID_Detail_Data' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Data")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Data")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Data')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED("tmpID_Detail_Data")
				IF RECCOUNT('tmpID_Detail_Data') > 0
					cAlloy	= tmpID_Detail_Data.Alloy
					cForm	= tmpID_Detail_Data.Form
					cCC		= tmpID_Detail_Data.CC
					cCL		= tmpID_Detail_Data.CL
					nThck	= tmpID_Detail_Data.Size
					nSz2	= tmpID_Detail_Data.Dim2
					nSz3	= tmpID_Detail_Data.Dim3
					nPC		= tmpID_Detail_Data.PC
					nLBS	= tmpID_Detail_Data.Weight
					cHeatLot	= tmpID_Detail_Data.HeatLot
					*nQTY
					lRL	= tmpID_Detail_Data.RandLen
				ENDIF
				USE IN tmpID_Detail_Data
			ENDIF
		ENDIF
				
		*DO FORM Forms\StockLst_SQL_Modal WITH "Browse_ID_Detail",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nID_Detail,nPC,nLBS,cHeatLot,nQTY,lRL,cPOitem TO nID_Detail2
		
		
		*Removed the following block of code 2020-02
		*!*	IF NOT lAllowSub
		*!*		ThisFormSet.Show_Selected_INV()
		*!*	ELSE
		*!*		*Refresh the Table grd 
		*!*		IF ThisFormSet.frmStocklst_SQL.Visible
		*!*			*ThisFormSet.frmStocklst_SQL.
		*!*		ELSE
		*!*			ThisFormSet.Show_StockLst_SQL("BROWSE_ID_Detail")
		*!*		ENDIF
		*!*	ENDIF
		
		*ThisFormSet.StockLstProcesses(nID_Detail, 'SOitem', "SHOW")
		
		This.Visible = .F.
		
		
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.cmdReceive.Click
		ThisForm.Visible = .f.
		
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.PO_Item1.Value,'POitem',12)
		*nWO     = PrepareSQLnum(ThisFormSet.nWorkOrder,'WO',-3)
		
		PRIVATE nID, nID_Detail, nID_Detail_Process, cTBL
		nID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		ThisFormSet.ID_Detail_Process = nID_Detail_Process
		
		ThisFormSet.Tbl_Process = tmpProcess.Tbl
		
		*ThisFormSet.ID_Detail_Process_Name = ThisForm.Name
		nID_Detail = PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3)
		ThisFormSet.Stocklst_ID_Detail	= nID_Detail
		cTBL = ThisForm.TBL.Value
		ThisFormSet.StockLst_TBL = cTBL
		nID = Get_ID_with_ID_Detail(nID_Detail, cTBL, ThisFormSet.nConnHandle) &&PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		ThisFormSet.Stocklst_ID	= nID
		
		PRIVATE lDoneReceiving
		lDoneReceiving = .F.
		lDoneReceiving = ThisFormSet.CheckReceivingID_Detail_Process( nID_Detail_Process, nID_Detail, cTBL, cPOItem, ThisFormSet.nWorkOrder )
		*lDoneReceiving = ThisFormSet.CheckReceivingID_Detail_Process( ThisFormSet.ID_Detail_Process, ThisFormSet.ID_Detail_Process, tmpProcess.PO_Item ) 
		*CALLS: DO FORM Forms\Receive_Edit WITH 'Brk_Detail', nID_Detail ,cHeat
		
		PRIVATE nCntPOitem 
		*MESSAGEBOX("Stop here to debug")
		
		IF NOT lDoneReceiving
			IF Proper_PO_item(tmpProcess.PO_Item) <> Proper_PO_item('')
				lDoneReceiving = ThisFormSet.CheckReceiving_POitem( ThisFormSet.Tbl_Process, tmpProcess.PO_Item )
				*Calls: Forms\Receive_Edit
			endif
		ENDIF
		
		IF lDoneReceiving
			*Count ....Lst_Process WHERE ID_Detail_Process =
			*AND Process_ID='INCOMING'
			*Found to be Incoming
		
			*Count Receiving Where POitem = 
			nCntPOitem = Count_PO_IteminProcess( cPOitem, ThisFormSet.nConnHandle,"NEEDRECV" )
			IF nCntPOitem = 0
				*MESSAGEBOX("Did not find an process to be Received.",64,"Receive what?")
				*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"No process to be Received for POitem '"+cPOitem+"', user clicked cmdReceive")
			ELSE
				MESSAGEBOX("There is still an process to be Received.",64,"Need to Receive another")
				*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"There is still an process to be Received for POitem '"+cPOitem+"' Need to Receive first")
			ENDIF
			nCntPOitem = Count_PO_IteminProcess( cPOitem, ThisFormSet.nConnHandle,"SELECTED" )
			IF nCntPOitem = 0
				*MESSAGEBOX("There is no SELECTED process to work with.",64,"Select Stock now.")
				WAIT WINDOW "There is no SELECTED process to work with."+CHR(13)+"Select Stock to continue." NOWAIT
			ENDIF
			
		*!*	ELSE
		*!*		**Added this check 2007-02
		*!*		lLoadReceiving = ThisFormSet.CheckReceiving_POitem( ThisFormSet.Tbl_Process, tmpProcess.PO_Item )
		*!*		*CALLS: DO FORM Forms\Receive_Edit WITH 'Brk_Detail', nID_Detail ,cHeat
		*!*		
		*!*		IF lLoadReceiving 
		*!*			
		*!*			*Count Receiving Where POitem = 
		*!*			nCntPOitem = Count_PO_IteminProcess( cPOitem, ThisFormSet.nConnHandle,"NEEDRECV" )
		*!*			IF nCntPOitem > 0
		*!*				*MESSAGEBOX("Did not find an 'INCOMING' OR 'NOT2HPA' OR 'PARTRECV' process in "+IIF(ThisFormSet.Tbl_Process="S","StockLst_Process","BrokerLst_Process")+"."+CHR(13)+"Found 'received' record in [Receiving] for POitem '"+tmpProcess.PO_Item+"'",0+64,"Nothing to do!")
		*!*				*MESSAGEBOX("There is still an INCOMING process to be Received.",64,"Need to Receive")
		*!*				WAIT WINDOW "There is still an INCOMING process to be Received."+CHR(13)+"Still need to Receive" NOWAIT
		*!*			ENDIF
		*!*			nCntPOitem = Count_PO_IteminProcess( cPOitem, ThisFormSet.nConnHandle,"SELECTED" )
		*!*			IF nCntPOitem = 0
		*!*				*MESSAGEBOX("There is no SELECTED process to work with.",64,"Select Stock now.")
		*!*				WAIT WINDOW "There is no SELECTED process to work with."+CHR(13)+"Select Stock to continue." NOWAIT
		*!*			ENDIF
		*!*		ELSE
		*!*			
		*!*			*ThisFormSet.ReceivingLoad(cPOitem)
		*!*			*ThisFormSet.ReceivingSaveAdd("ADD")
		*!*			
		*!*		ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.cmdRemoveProcess.Click
		*frmStockLstProcess.cmdRemoveProcess.click
		PRIVATE cTBL, nID_Detail_Process, cMess
		cTBL = ThisFormSet.Tbl_Process
		nID_Detail_Process = ThisFormSet.ID_Detail_Process
		cMess = "ID_Detail_Process "+ALLTRIM(STR(nID_Detail_Process))+" on Table "+cTBL+CHR(13)
		
		PRIVATE cProcess_ID, nWeight, nQTY
		cProcess_ID = PrepareSQLtxt(ThisForm.Process_ID1.Value,'Process_ID',10)
		nWeight	= PrepareSQLnum(ThisForm.pPounds1.Value,'Pounds',9,1)
		nQTY	= PrepareSQLnum(ThisForm.pQTY1.Value,'QTY',-5)
		cMess = cMess + "Process_ID "+cProcess_ID +CHR(13)
		cMess = cMess + "Weight "+ALLTRIM(STR(nWeight,9,1)) +CHR(13)
		cMess = cMess + "QTY "+ALLTRIM(STR(nQTY,9,1))+CHR(13)
		
		PRIVATE nCntNoSub
		nCntNoSub = Count_ProcessbyID_Detail_Process( nID_Detail_Process, cTBL, ThisFormSet.nConnHandle, 'NOSUB' )
		IF nCntNoSub = 0
		*	cMess = cMess +CHR(13)+ "Substitute was Allowed by Sales Rep."
		ELSE
			cMess = cMess +CHR(13)+ "Stock substitute was NOT Allowed by Sales Rep."
			cMess = cMess +CHR(13)+ "Please be carefull of Customers requirements."
		ENDIF
		
		PRIVATE lDeleted
		lDeleted = .F.
		
		IF MESSAGEBOX("Are you sure you want to remove this Process?"+CHR(13)+cMess ,4+32,"Remove Process?") = 6
			*Remove Process
			ThisFormSet.ID_Detail_Process = ThisForm.ID_Detail_Process1.Value
			ThisFormSet.Tbl_Process = tmpProcess.Tbl
		
			PRIVATE cSQLn, cSQLd
		
			*Check to see if a process 
			cSQLn = "SELECT COUNT(*) AS counted FROM "
			DO CASE
			CASE cTBL = "S"
				cSQLn = cSQLn + " dbo.StockLst_Process WITH(NOLOCK) "
			CASE cTBL = "B"
				cSQLn = cSQLn + " dbo.BrokerLst_Process WITH(NOLOCK) "
			CASE cTBL = "W"
				cSQLn = cSQLn + " dbo.WIPLst_Process WITH(NOLOCK) "
			OTHERWISE
				MESSAGEBOX("cmdRemoveProcess.click did not recognize Table Name",0+16,"Aborting Save!")
				TrackError("cmdRemoveProcess.click did not recognize Table Name","cmdRemoveProcess.click did not recognize Table Name",PROGRAM(),LINENO(1))
				RETURN .F.
			ENDCASE
			cSQLn = cSQLn + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+""
		
			IF USED("StockLst_Detail_Count")
				SELECT StockLst_Detail_Count
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLn, 'StockLst_Detail_Count')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLn, "StockLst_Detail_Count")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLn, "StockLst_Detail_Count")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQLn, ThisFormSet.nConnHandle,nSQLEXEC, 'StockLst_Detail_Count')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF StockLst_Detail_Count.Counted > 0
				
					*Remove old Process
					cSQLd = "DELETE FROM "
					DO CASE
					CASE cTBL = "S"
						cSQLd = cSQLd + " dbo.StockLst_Process "
					CASE cTBL = "B"
						cSQLd = cSQLd + " dbo.BrokerLst_Process "
					CASE cTBL = "W"
						cSQLd = cSQLd + " dbo.WIPLst_Process "
					ENDCASE
					cSQLd = cSQLd  + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+""
					 
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 1
						*Could not Delete
						IF NOT SQLEXECError(cSQLd, ThisFormSet.nConnHandle,nSQLEXEC)
							RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLd )
						ELSE
							nSQLEXEC = 1
						ENDIF
					ENDIF
					IF nSQLEXEC > 0
						lDeleted = .T.
						
						DO CASE
						CASE cTBL = "S"
							cSQLd = "UPDATE dbo.Ar_StockLst_Process_History "
						CASE cTBL = "B"
							cSQLd = "UPDATE dbo.Ar_BrokerLst_Process_History "
						CASE cTBL = "W"
							cSQLd = "UPDATE dbo.Ar_WIPLst_Process_History "
						ENDCASE
						cSQLd = cSQLd + " SET [WHAT]='SUBED' WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+ " AND [What] = 'DELETE' "
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQLd, ThisFormSet.nConnHandle,nSQLEXEC)
								RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLd )
							ELSE
								nSQLEXEC = 1
							ENDIF
						ENDIF
						IF nSQLEXEC > 0
							*ThisFormSet.RefreshTmpQuotes()  &&grdSO
							ThisFormSet.RefreshSO()
							WAIT WINDOW "Deleted the Process." NOWAIT
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			IF lDeleted
			
				PRIVATE lFoundStk
				lFoundStk = PrepareSQLchk(ThisForm.chkFoundStock.Value,'FoundStk')
				IF lFoundStk 
					ThisFormSet.Grab_foundStk(.F.)
					ThisForm.chkFoundStock.Value = .F.
				ENDIF
					
				**Refresh open stock windows.
				
				*	ThisFormSet.Show_Selected_INV() 
				*or ThisFormSet.Show_StockLst_SQL()	
				
				IF ThisformSet.frmSelectedStock.Visible
					ThisformSet.frmSelectedStock.Visible = .F.
				ENDIF
				
				IF PrepareSQLnum(ThisForm.txtTot.Value,'TOT',-1) > 1
					ThisFormSet.RefreshStockLstProcesses()
				ELSE
					ThisFormSet.frmSelectedStock.Visible = .F.
					ThisForm.Visible = .F.
				ENDIF
				
				**Move to correct Process before locating ID_Detail
				
				IF ThisFormSet.frmStocklst_SQL.Visible
					ThisFormset.Show_StockLst_SQL("BROWSE")
				ENDIF
			ENDIF
		
			***End Process
			
		*	ThisForm.Visible = .F.
			
			*ThisFormSet.RefreshTmpQuotes()
			*ThisFormSet.RefreshSO()
			
		ENDIF
	ENDPROC

