	PROCEDURE frmShop_StockLst_Edit.cmdStart.Click
		*!*	IF NOT USED('tmpSO')
		*!*		MESSAGEBOX("Cannot continue without a Order",0+16,"No WO or SO!")
		*!*		RETURN .F.
		*!*	ENDIF
		
		PRIVATE nWO, nSO
		nWO	= PrepareSQLnum(ThisFormSet.nWorkOrder,'WO',-3)
		nSO	= PrepareSQLnum(ThisFormSet.SalesNum,'SO',-3)
		
		IF nSO = 0 AND nWO = 0
			MESSAGEBOX("Cannot continue without a Order",0+16,"No WO or SO!")
			RETURN .F.
		ENDIF
		****
		
		IF nSO > 0
			*Check SO on Hold
			IF USED('tmpSalesOnHold')
				USE IN tmpSalesOnHold
			ENDIF
			SELECT 0
			
			PRIVATE cSQLu
			
			cSQLu = "SELECT SOitem, ISNULL(HOLD,0) AS HOLD FROM dbo.Sales "
			cSQLu = cSQLu + " WITH(NOLOCK) "
			cSQLu = cSQLu + " WHERE SalesNum = "+STR(nSO)
			cSQLu = cSQLu + " AND Hold=1 "
			cSQLu = cSQLu + " AND Cncld=0 "
			cSQLu = cSQLu + " AND Cmplt=0 "
			
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQLu, "tmpSalesOnHold" )
			WAIT WINDOW 'SQL' TIMEOUT 1
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnhandle, cSQLu, "tmpSalesOnHold" )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!, long triger
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "tmpSalesOnHold")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "tmpSalesOnHold")
					lReturn = .F.
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "tmpSalesOnHold")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "tmpSalesOnHold")
		
				ENDDO
			ENDIF 
			********************
			IF nSQLEXEC < 0 &&Try again! --has timed out before
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "tmpSalesOnHold")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnhandle, cSQLu, "tmpSalesOnHold")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQLu, ThisFormSet.nConnhandle, nSQLEXEC,'')
					RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQLu )
				ENDIF
			ELSE
				WAIT WINDOW "Long SQL Query..." NOWAIT
			ENDIF
			
			IF USED('tmpSalesOnHold')
				IF RECCOUNT('tmpSalesOnHold') > 0
					PRIVATE lFoundOnHold, cSOitemOnHold 
					lFoundOnHold = .F.
					SCAN
					cSOitem  = PrepareSQLtxt(tmpSalesOnHold.SOitem,'SOitem',10)
					
					IF Is_SOitem_OnHold( cSOitem, "ANY", ThisFormSet.nConnhandle)
						cSOitemOnHold = cSOitem
						lFoundOnHold = .T.
						EXIT
					ENDIF
					
					ENDSCAN
					
					IF lFoundOnHold 
						MESSAGEBOX( "Found an OnHold with SOitem '"+cSOitemOnHold+"'"+CHR(13)+"Next you will be shown the SO Hold Reason."+CHR(13)+"look into the reason, then you can edit HOLD",0,"This SOitem has a HOLD") 
						
						*DO FORM Forms\Late_SO-item WITH nSO
						DO FORM Forms\SOitem_Status WITH cSOitem,ThisFormSet.nConnHandle
						
						*** read again ***
						IF Is_SOitem_OnHold( cSOitem, "ANY", ThisFormSet.nConnhandle)
		
							IF MESSAGEBOX("The SOitem '"+cSOitemOnHold +"' is STILL OnHold "+CHR(13)+"You should NOT Continue here."+CHR(13)+"The program will let you continue."+CHR(13)+CHR(13)+"release this SOitem to Shipping with Caution"+CHR(13)+"make sure this SOitem does not ship while On Hold"+CHR(13)+CHR(13)+"this notice will be recorded under your name.",48,"Continue even thou On Hold")=6
								TrackMess("The SOitem '"+cSOitemOnHold +"' is OnHold and Shop StockLest Edit is being run."+" "+CHR(13)+SYS(16,1))
								RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SOitem '"+cSOitemOnHold +"' is OnHold and Modify Stock 4 Order is being run.") 
								nSalesNum = Proper_SO_Item_SO(cSOitemOnHold )
								Track_Sales_No_Chng("The SOitem '"+cSOitemOnHold +"' is OnHold and Modify Stock 4 Order is being run.",nSalesNum,0,0)
								
								EXIT   &&SCAN
							ENDIF
						ENDIF
		
					ENDIF
				ENDIF
			ENDIF
		ENDIF
				
		*****
		ThisFormSet.frmQuote.Visible = .F.   
		*ThisFormSet.frmStockLst.Visible = .F.
		IF VARTYPE(ThisFormSet.frmStockStatus) = "O"
			ThisFormSet.frmStockStatus.Visible = .F.
		ENDIF
		**
		IF VARTYPE(ThisFormSet.frmSimiliarOrdersProcess) = "O"
			ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
		ELSE
			MESSAGEBOX("Missing Window form, Please restart App.",0+16,"Cannot continue")
			TrackError("Missing Window form, Please restart App. ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.","Missing Code, Please restart App.",PROGRAM(),LINENO(1))
			ThisFormSet.Release
		ENDIF
		ThisFormSet.frmSimiliarSales.Visible = .F.
		THISFORMSET.frmModiProcess.VISIBLE = .F.
		THISFORMSET.frmStockLstProcesses.VISIBLE = .F.
		
		IF ThisFormSet.Check_Order_Status()
			ThisFormSet.ReportAmendmentVer()
		ELSE
			RETURN .F.
		ENDIF
		
		*ThisFormSet.RefreshtmpQuotes()
		ThisFormSet.RefreshSO()
		
		ThisFormset.frmShop_StockLst_Edit.lblItem.Visible = (ThisFormSet.SalesNum > 0)
		ThisFormset.frmShop_StockLst_Edit.lblItem.Caption = PrepareSQLtxt(tmpSO.Item,'Item',2)
		
		IF ThisFormSet.nWorkOrder > 0
			ThisForm.txtSO.Visible = .F.
			ThisForm.lblSO.Visible = .F.
			ThisForm.txtWO.Visible = .T.
			ThisForm.lblWO.Visible = .T.
			ThisForm.txtWO.Top = 3
			ThisForm.lblWO.Top = 6
			
			ThisForm.lblItem.Visible = .F.
		ENDIF
		IF ThisFormSet.SalesNum > 0
			ThisForm.txtSO.Visible = .T.
			ThisForm.lblSO.Visible = .T.
			ThisForm.txtWO.Visible = .F.
			ThisForm.lblWO.Visible = .F.
			ThisForm.txtWO.Top = 18
			ThisForm.lblWO.Top = 20
		
			ThisForm.lblItem.Visible = .T.
		ENDIF
		
		*ThisForm.grdSO.clmPrc.DynamicBackColor = 'ThisFormSet.DynamicBackColor_PRC()'
		*ThisForm.grdSO.clmPrc.BackColor = ThisFormSet.DynamicBackColor_PRC()
		
		*ThisForm.grdSO.clmBrk.DynamicBackColor = 'ThisFormSet.DynamicBackColor_PRC()'
		*ThisForm.grdSO.clmBrk.BackColor = ThisFormSet.DynamicBackColor_PRC()
		
		*ThisForm.grdSO.Refresh
		ThisFormSet.grdSO_AfterRowChange()
		
		
	ENDPROC

	PROCEDURE frmShop_StockLst_Edit.cmdStart.Valid
		*ThisFormSet.frmShop_StockLst_Edit.grdSO.SETFOCUS
		*Memo1: Cannot call SetFocus from within a When, Valid, RangeHigh or RangeLow event.. 
	ENDPROC

	PROCEDURE frmShop_StockLst_Edit.cmdSvc.Click
		*No material or Customer's Material, the SOitem Service is DONE.
		*May need a PackingSlip!!
		
		IF NOT USED('tmpSO')
			MESSAGEBOX("Cannot continue without a Sales Order",0+16,"No SO!")
			RETURN .F.
		ENDIF
		
		PRIVATE m.cSOitem
		m.cSOitem = Proper_SO_Item(tmpSO.SOitem)
		PRIVATE nSalesNum
		nSalesNum = ThisFormSet.SalesNum
		
		IF nSalesNum < 1
			MESSAGEBOX("No Sales Order Found",4+32,"Cannot continue")
			RETURN .F.
		ENDIF
		
		IF MESSAGEBOX("This 'Svc' button replaces the need for a Packing Slip"+CHR(13)+CHR(13);
			+"Are you sure you want to mark this SOitem "+ALLTRIM(m.cSOitem)+" as DONE?"+CHR(13)+CHR(13);
			+"Use this option if there are no:"+CHR(13)+"No edits to Stock List."+CHR(13);
			+"No Packing Slip will be needed!"+CHR(13)+CHR(13);
			+"If you need a Packing Slip"+CHR(13);
			+"Do NOT mark as Complete here! Answer (N) here.";
			+CHR(13)+"and use the Packing Slip program to mark as Complete.",4+32,"Mark as Complete")!=6
			*+CHR(13)+"No PackingSlip will be needed!"
				*Not "Mark as Complete" 
			RETURN .F.
		ENDIF
		
		*!*	IF PrepareSQLbit(tmpSO.Cmplt,'Cmplt') = 1
		*!*		MESSAGEBOX("SOitem "+ALLTRIM(m.cSOitem)+" is already complete!",4+32,"Already Complete")
		*!*		RETURN .F.
		*!*	ENDIF
		
		PRIVATE lS_Complete
		lS_Complete = .F.
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE nCntSOitem 
		
		*******
		nCntSOitem = Count_SOIteminSales(m.cSOItem, ThisFormSet.nConnHandle, "CONVERSIONSERVICE")
		IF nCntSOitem = 0
			MESSAGEBOX("SOitem "+ALLTRIM(m.cSOitem)+" is not a Conversion Service!"+CHR(13)+"Have the Sales Rep mark as a Conversion or Service Order.",4+32,"Cannot Complete as Conversion Service")
			RETURN .F.
		ENDIF
		
		*******
		nCntSOitem = Count_SOIteminSales(m.cSOItem, ThisFormSet.nConnHandle, "CANCEL")
		IF nCntSOitem = 1
			MESSAGEBOX("SOitem "+ALLTRIM(m.cSOitem)+" has been Cancelled!",4+32,"Cannot Complete")
			RETURN .F.
		ENDIF
		
		*******
		nCntSOitem = Count_SOIteminSales(m.cSOItem, ThisFormSet.nConnHandle, "COMPLETE")
		IF nCntSOitem = 1
			MESSAGEBOX("SOitem "+ALLTRIM(m.cSOitem)+" is already complete!",4+32,"Already Complete")
			lS_Complete = .T.
		ENDIF
		
		*******
		IF NOT lS_Complete
			nCntSOitem = Count_SOIteminSales_No(m.cSOItem, ThisFormSet.nConnHandle, 'FINISHED') 
			IF nCntSOitem = 1
				MESSAGEBOX("SOitem "+ALLTRIM(m.cSOitem)+" is already complete!",4+32,"Already Complete")
				lS_Complete = .T.
			ENDIF
		ENDIF
		*******
		PRIVATE lOK
		lOK = .T.
		
		IF lS_Complete
			IF MESSAGEBOX("Do you want to un COMPLETE this 'Conversion' SOitem "+ALLTRIM(m.cSOitem)+"?",4+32,"UM Mark as Complete")=6
			
				cSQL = "UPDATE dbo.Sales SET cmplt = 0"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
				*cSQL = cSQL + " AND (TYP = 'C' OR TYP = "S")"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
						RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
						lOK = .F.
					ELSE
						nSQLEXEC = 1
					ENDIF
				ENDIF
				
				IF lOK
					Save_SOitem_Status( m.cSOitem, VAL(m.cSOitem),'INComplete', 'SVC SOitem was changed to INComplete in Shop StockLst Edit.', ThisFormSet.nConnHandle)
				ENDIF
					
				RETURN lOK
			ELSE
			
				RETURN .F.
			ENDIF
		ENDIF
		*********************
		
		
		*Look for Stock or Broker Process!
		cSQLn = "SELECT COUNT(*) AS counted FROM dbo.StockLst_Process WITH(NOLOCK) WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
		cSQLn = cSQLn + " UNION "
		cSQLn = "SELECT COUNT(*) AS counted FROM dbo.BrokerLst_Process WITH(NOLOCK) WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
		*cSQLn = cSQLn + " UNION "
		*cSQLn = "SELECT COUNT(*) AS counted FROM dbo.WIPLst_Process WITH (NOLOCK) WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
		
		IF USED("StockLst_Detail_Count")
			SELECT StockLst_Detail_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Detail_Count")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Detail_Count")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQLn, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Detail_Count')
				*Just Create a new Process
				*THISFORMSET.Create_StockLst_Process(pID,pID_Detail,"",cTBL)
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLn )
				RETURN .F.
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED("StockLst_Detail_Count")
				IF StockLst_Detail_Count.Counted > 0
					USE IN StockLst_Detail_Count
					MESSAGEBOX("Found Stock or Brokered material selected for this SOitem!"+CHR(13)+"Work on those Process' first!",0,"Cannot process SOitem as done.")
					RecordError(0,"Cannot process SOitem as done." ,PROGRAM(),LINENO(1),"Cannot process SOitem as done."+CHR(13)+"Found Stock or Brokered material selected for this SOitem!"+CHR(13)+"Work on those Process' first!"+CHR(13)+cSQLn )
					RETURN .F.
				ELSE
					USE IN StockLst_Detail_Count
				ENDIF
			ENDIF
		ENDIF	
		
		
		*************************************
		
		PRIVATE lOK
		*Mark table Sales as in progess and processing Done for this SOitem!
		lOK = Update_PrcpPrcdinSales( .F., .T., m.cSOitem, ThisFormSet.nConnHandle ) &&Proc_SQL
		*PRCP=Process in Progress, PRCD=Processing Done
		
		IF lOK
			lOK = Update_CmpltPrcdinSales( .T., m.cSOitem, ThisFormSet.nConnHandle ) &&Proc_SQL
		ENDIF
		
		IF lOK
			lOK = Mark_SOitem_Cmplt(m.cSOitem, ThisFormSet.nConnHandle, .F. )
		ENDIF
		
		IF lOK
			Save_SOitem_Status( m.cSOitem, VAL(m.cSOitem),'Complete', 'SVC SOitem was changed to Complete in Shop StockLst Edit.', ThisFormSet.nConnHandle)
		ENDIF
		
		IF lOK
			*IF ThisFormSet.Stocklst_ID_Detail > 0
			*	*AccountingCosting( m.nID1, m.nID_Detail, cSOitem, ThisFormSet.nConnHandle )
			*	*THISFORMSET.Remove_ID_Detail_Process(nID_Detail_Process, m.cSOitem, ThisFormSet.StockLst_TBL )
			*ENDIF
			
			ThisFormSet.StockLst_TBL = ' '
			ThisFormSet.Stocklst_ID = 0
			ThisFormSet.Stocklst_ID_Detail = 0
		
			ThisFormSet.RefreshSO()
				
			ThisFormSet.Modify_StockLst_How = "DONE"
				
			IF ThisFormSet.frmStockLstProcesses.Visible
				ThisFormSet.frmStockLstProcesses.Visible = .F.
			ENDIF
		
			IF ThisFormSet.frmModiProcess.Visible
				ThisFormSet.frmModiProcess.Visible = .F.
				ThisFormSet.frmShop_StockLst_Edit.grdSO.SetFocus()
			ENDIF
		ELSE
			MESSAGEBOX("Could not update",16,"Error")
			RETURN .F.
		ENDIF
		
		ThisForm.Refresh
		ThisForm.grdSO.Refresh
		
		RETURN .T.
	ENDPROC

