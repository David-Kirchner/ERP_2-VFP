	PROCEDURE frmShop_StockLst_Edit.cmdBkr.Click
		IF NOT USED('tmpSO')
			MESSAGEBOX("Cannot continue without a Sales Order",0+16,"No SO!")
			RETURN .F.
		ENDIF
		
		*ThisFormSet.frmStockLstProcesses.TBL = "B"  --not allowed
		PRIVATE cPOitem, lOK
		cPOitem = PrepareSQLtxt(tmpSO.POitem,'POitem',12)
		lOK = .T.
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
		*	ThisFormSet.CountPOitem_Process(cPOitem)
		ENDIF
		
		ThisFormSet.cTBL = "B"
		lOK = ThisFormSet.Select_Lst_ID_Detail("B")
		*Calls:ThisFormSet.CountPOitem_Process(cPOitem)
		RETURN lOK
		
		*Make sure the Stock List is used in Show_StockLst_SQL()
		*ThisFormSet.frmStockLstProcesses.TBL = "B"
		
		
		
		
		
		
	ENDPROC

	PROCEDURE frmShop_StockLst_Edit.cmdInv.Click
		*IF NOT USED('tmpSO')
		*	MESSAGEBOX("Cannot continue without a Sales Order \ Work Order",0+16,"No SO/WO!")
		*	RETURN .F.
		*ENDIF
		
		*Make sure the Stock List is used in Show_StockLst_SQL()
		*ThisFormSet.frmStockLstProcesses.TBL = "S"  --not allowed
		ThisFormSet.cTBL = "S"
		
		IF USED('tmpSO')
			IF RECCOUNT('tmpSO') = 0
				*MESSAGEBOX("Could not find the Sales Order or Work Order"+CHR(13)+"No records.",0+16,"No SO/WO !")
				WAIT WINDOW "No SO or WO to find!"+CHR(13)+"Opening Stock List at begining" TIMEOUT 1
				
				ThisFormset.Show_StockLst_SQL("BROWSE")
			ELSE
				*SELECT
				ThisFormset.Show_StockLst_SQL("SELECT")
				*CALLS: ThisFormSet.frmStocklst_SQL.Load_StockLst_SQL(cTBL)
				*CALLS: ThisFormSet.frmStockLst_SQL.INIT_pWhat(cFunction)
				*CALLS: ThisFormSet.frmStocklst_SQL.Search('')
			ENDIF
		ELSE
			ThisFormset.Show_StockLst_SQL("BROWSE")
		ENDIF
		
		*ThisFormSet.frmStockLstProcesses.TBL.Value = "S"  &&Do not set here! the tmpProcess is needed here first!
			
		RETURN .F.
		
		*RETURN ThisFormSet.Select_Lst_ID_Detail("S")
		
		
		
		
		
		
		
		*******************************************************
		PRIVATE lCheckForIncoming
		lCheckForIncoming = .F.
		
		PRIVATE cAlloy, cForm, nThck, cCC, cCL
		cAlloy = PrepareSQLtxt(tmpSO.Alloy,'Alloy',12,.T.)
		cForm  = Proper_Form(PrepareSQLtxt(tmpSO.Form,'Form',2,.T.))
		cCC	   = PrepareSQLtxt(tmpSO.CC,'CC',1)
		cCL	   = PrepareSQLtxt(tmpSO.CL,'CL',1)
		
		PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL, cPO_item
		nThck	= PrepareSQLnum(tmpSO.Thck,'Thck',9,3) &&nThck	= PrepareSQLnum(tmpSO.Dim1,'Thck',9,3)
		nSz2	= PrepareSQLnum(tmpSO.Sz2,'Sz2',9,3)	&&nSz2	= PrepareSQLnum(tmpSO.Dim2,'Sz2',9,3)
		nSz3	= PrepareSQLnum(tmpSO.Sz3,'Sz3',9,3)	&&nSz3	= PrepareSQLnum(tmpSO.Dim3,'Sz3',9,3)
		nPC		= PrepareSQLnum(tmpSO.PC,'PC',-3)
		nLBS	= PrepareSQLnum(tmpSO.Weight,'Weight',7,1)
		lRL		= PrepareSQLlogic(tmpSO.RandLen,'RandLen')
		cPO_item= PrepareSQLtxt(tmpSO.POitem,'POitem',12)	&&tmpSO holds PO WHERE 'SELECTED' OR SP.Process_ID = 'PARTSELECT'
		
		******************************************************
		*IF EMPTY(cPO_item)	
		*	Broker needs a PO check!!!
		*	lCheckForIncoming = .T.
		*ENDIF
		******************************************************
		
		PRIVATE cHeatLot
		*cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpSO.Heat)+" "+ALLTRIM(tmpSO.Lot),'HeatLot',60)
		cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpSO.Heat),'HeatLot',60)
		
		PRIVATE nSalesNum, nItem, cSOitem, nQTY, nWO, cWhat
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		nQTY		= PrepareSQLnum(tmpSO.S_Qty,'S_QTY',-5)
		nPU			= PrepareSQLnum(tmpSO.PU,'PU',-1)
		nWO 		= PrepareSQLnum(ThisFormSet.nWorkOrder,'WO',-3)
		IF nWO > 0
			cWhat = "SEL_WO"
			nSalesNum = nWO
		ELSE
			cWhat = "SELECT"
		ENDIF
		
		PRIVATE cTBL,nID_Detail
		cTBL = "S"
		nID_Detail = 0
		
		ThisFormSet.VisibleForms()
		*ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
		ThisFormSet.frmQuote.Visible = .F.
		
		ThisForm.AlwaysOnTop = .F.		
		*USE ThisFormset.Show_StockLst_SQL()		
		DO FORM Forms\StockLst_SQL_Modal WITH cWhat, cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPO_item TO nID_Detail
		*DO FORM Forms\StockLst_SQL_Quotes WITH pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,cSOitem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem
		ThisForm.AlwaysOnTop = .T.
		
		IF PrepareSQLnum(nID_Detail,'ID_Detail',-3) > 0
			*IF lCheckForIncoming = .T.
			*	*The POitem was lost from the SalesNo. 
			*	*POitem was just 'SELECTED' 
			*	*Add 'INCOMING TO Process if Needed.
			*	IF StockLst_Process_Count_POitem( cPOitem, cTBL, ThisFormSet.nConnHandle, 'INCOMING') = 0
			*		*Create an INCOMING Process
			*		
			*		IF ThisFormSet.Receiving_CreateProcess(cTBL,cSOitem,cPOitem,0           ,nID_Detail,'INCOMING' ,'Created Process for POitem:'+cPOitem )
			*                           pStockTable,cSOitem,pPOitem,pReceivingID,pID_Detail,pProcess_ID,pComment
			*		ENDIF
			*		
			*	ENDIF		
			*ENDIF
		ENDIF
		
		ThisFormSet.VisibleFormsReset()
		
		*ThisFormSet.RefreshTmpQuotes()
		ThisFormSet.RefreshSO()
		
		RETURN
		
		
		
		
	ENDPROC

