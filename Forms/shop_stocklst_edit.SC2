			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'StartingStock')
		ENDDO
		IF nSQLEXEC < 0 &&Try again
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StartingStock')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'StartingStock')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StartingStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StartingStock")
					
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'StartingStock')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				RETURN .F.
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE select_lst_id_detail
		PARAMETERS pTBL
		*ThisFormSet.Select_Lst_ID_Detail(TBL)
		
		IF NOT USED('tmpSO') 
			MESSAGEBOX("Cannot continue without a Sales Order or Work Order",0+16,"No SO/WO !")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpSO') = 0
			MESSAGEBOX("Cannot continue without a Sales Order or Work Order",0+16,"No SO/WO !")
			RETURN .F.
		ENDIF
		
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(pTBL,'TBL',1)
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not get TBL")
			RETURN .F.
		ENDIF
		
		*******************************************************
		PRIVATE lCheckForIncoming
		lCheckForIncoming = .F.
		
		PRIVATE cAlloy, cForm, nThck, cCC, cCL
		cAlloy = PrepareSQLtxt(tmpSO.Alloy,'Alloy',12,.T.)
		cForm  = Proper_Form(PrepareSQLtxt(tmpSO.Form,'Form',2,.T.))
		cCC	   = PrepareSQLtxt(tmpSO.CC,'CC',1)
		cCL	   = PrepareSQLtxt(tmpSO.CL,'CL',1)
		
		PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL, cPOitem 
		nThck	= PrepareSQLnum(tmpSO.Thck,'Thck',9,3) &&nThck	= PrepareSQLnum(tmpSO.Dim1,'Thck',9,3)
		nSz2	= PrepareSQLnum(tmpSO.Sz2,'Sz2',9,3)	&&nSz2	= PrepareSQLnum(tmpSO.Dim2,'Sz2',9,3)
		nSz3	= PrepareSQLnum(tmpSO.Sz3,'Sz3',9,3)	&&nSz3	= PrepareSQLnum(tmpSO.Dim3,'Sz3',9,3)
		nPC		= PrepareSQLnum(tmpSO.PC,'PC',-3)
		nLBS	= PrepareSQLnum(tmpSO.Weight,'Weight',7,1)
		lRL		= PrepareSQLlogic(tmpSO.RandLen,'RandLen')
		cPOitem = PrepareSQLtxt(tmpSO.POitem,'POitem',12)	&&tmpSO holds PO WHERE 'SELECTED' OR SP.Process_ID = 'PARTSELECT'
		
		
		******************************************************
		IF EMPTY(cPOitem) AND cTBL = "B"
			*A Broker without a PO!  This is wrong
			*Find the POitem
		
			MESSAGEBOX("This Broker does not have a PO!"+CHR(13)+"This is impossible."+CHR(13)+"Please reconnect the PO item to this Sales Order"+CHR(13)+"next, a window will open to select the correct PO item",0+64,"Find correct PO item.")
			
			ThisFormSet.VisibleForms()
			ThisFormSet.frmShop_StockLst_Edit.Left = ThisFormSet.frmShop_StockLst_Edit.Left + 500
			ThisFormSet.frmQuote.Left = ThisFormSet.frmQuote.Left + 500
			
			ThisFormSet.frmShop_StockLst_Edit.AlwaysOnTop = .F.
			ThisFormSet.frmQuote.AlwaysOnTop = .F.
			
			DO FORM Forms\SelectPO_item WITH ThisFormSet.SalesNum,'SALESNUM' TO cPOitem
				
			ThisFormSet.frmShop_StockLst_Edit.Left = ThisFormSet.frmShop_StockLst_Edit.Left - 500
			ThisFormSet.frmQuote.Left = ThisFormSet.frmQuote.Left - 500
		
			ThisFormSet.VisibleFormsReset()
		
			cPOitem = PrepareSQLtxt(cPOitem,'POitem',12)
			IF EMPTY(cPOitem)
				MESSAGEBOX("Please have the Sales man correct the PO for this Brokered Sales Order.",0,"Cannot continue.")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Please have the Sales man correct the PO for this Brokered Sales Order.")
				RETURN .F.
			ELSE
				*Shop will still be allowed to mark as 'SELECTED'
				*If shop does 'SELECT' check for 'INCOMING' OR cProcess_ID = "NOT2HPA"  because that may also be screwed up.
				lCheckForIncoming = .T.
			ENDIF
		ENDIF
		
		******************************************************
		
		IF cTBL = "B"
			IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
				ThisFormSet.CountPOitem_Process(cPOitem)
			ENDIF
		ENDIF
		
		******************************************************
		
		PRIVATE cHeatLot
		*cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpSO.Heat)+" "+ALLTRIM(tmpSO.Lot),'HeatLot',60)
		cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpSO.Heat),'HeatLot',60)
		
		PRIVATE nSalesNum, nItem, cSOitem, nS_QTY, nWO, cWhat
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		
		nS_QTY		= PrepareSQLnum(tmpSO.S_Qty,'S_QTY',-5)
		
		nWO 		= PrepareSQLnum(ThisFormSet.nWorkOrder,'WO',-3)
		IF nWO > 0
			cWhat = "SEL_WO"
			nSalesNum = nWO
		ELSE
			cWhat = "SELECT"
		ENDIF
		PRIVATE nID_Detail
		nID_Detail = 0
		
		ThisFormSet.VisibleForms()
		ThisFormSet.frmShop_StockLst_Edit.AlwaysOnTop = .F.
		ThisFormSet.frmQuote.AlwaysOnTop = .F.
		
		*USE ThisFormset.Show_StockLst_SQL()
		DO FORM Forms\StockLst_SQL_Modal WITH cWhat,cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nS_QTY,lRL,cPOitem TO nID_Detail
		*DO FORM Forms\StockLst_SQL_Quotes WITH pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,cSOitem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem TO ID_Detail
		
		
		IF PrepareSQLnum(nID_Detail,'ID_Detail',-3) > 0
			IF lCheckForIncoming = .T.
				*The POitem was lost from the SalesNo. 
				*POitem was just 'SELECTED' 
				*Add 'INCOMING TO Process if Needed.
				
				IF StockLst_Process_Count_POitem( cPOitem, cTBL, ThisFormSet.nConnHandle, 'INCOMING') = 0
					*Create an INCOMING Process
					*							   pStockTable,cSOitem,pPOitem,pReceivingID,pID_Detail,pProcess_ID,pComment
		*			IF ThisformSet.Receiving_CreateProcess(cTBL,cSOitem,cPOitem,       0,   nID_Detail,'INCOMING','Created Process for POitem:'+cPOitem )
		*
		*			ENDIF
					
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.VisibleFormsReset()
									
		*ThisFormSet.RefreshTmpQuotes()
		ThisFormSet.RefreshSO()
		
		RETURN .T.
		
		
	ENDPROC

	PROCEDURE setselectedid_detail
		PARAMETERS pWhat,pItem,pTBL
		*ThisFormSet.SetSelectedID_Detail('SOitem',cSOitem,"S")
		*Sets ThisFormSet.StockLst_ID_Detail from Incoming or Selected Process
		
		IF VARTYPE(pWhat) != 'C'
			RETURN .F.
		ENDIF
		
		IF NOT ( pWhat = "SOitem" OR pWhat = "ID_Detail" OR pWhat = "WO" )
			RETURN .F.
		ENDIF
		
		PRIVATE cTBL
		cTBL = UPPER(pTBL)
		
		PRIVATE cSOitem, nID_Detail,nWO
		cSOitem = Proper_SO_item('')
		nID_Detail = 0
		nWO = 0
		
		IF pWhat = "SOitem"
			cSOitem = Proper_SO_item(pItem)
			IF cSOitem = Proper_SO_item('')
				RETURN .F.
			ENDIF
		ENDIF
		IF pWhat = "ID_Detail"
			nID_Detail = PrepareSQLnum(pItem,'ID_Detail',-3)
			IF nID_Detail = 0
				RETURN .F.
			ENDIF
		ENDIF
		IF pWhat = "WO"
			nWO = PrepareSQLnum(pItem,'WO',-3)
			IF nWO = 0
				RETURN .F.
			ENDIF
		ENDIF
			
		PRIVATE lReturn
		lReturn = .F.
		
		**************************
		
		IF pWhat = "SOitem" OR pWhat = "WO"
			PRIVATE cSQL, nSQLEXEC
		
			IF USED('tmpSelectSTK')
				USE IN tmpSelectSTK
			ELSE
				SELECT 0
			ENDIF
		
		
			cSQL = "SELECT ID_Detail "
			IF ThisFormSet.StockLst_TBL = "S"
				cSQL = cSQL +" FROM dbo.StockLst_Process SP WITH(NOLOCK) "
			ELSE
				cSQL = cSQL +" FROM dbo.BrokerLst_Process SP WITH(NOLOCK) "
			ENDIF
			IF pWhat = "SOitem"
				cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ELSE 
				IF pWhat = "WO"
					cSQL = cSQL +" WHERE WO = "+STR(nWO)
				ELSE
					TrackError("Could not select from cSOitem or nWO","cSOitem='"+cSOitem+"'  WO="+ALLTRIM(STR(nWO))+"!",PROGRAM(),LINENO(1))
					RETURN .F.
				ENDIF
			ENDIF
			cSQL = cSQL +" AND (SP.Process_ID = 'SELECTED' OR SP.Process_ID = 'INCOMING' OR SP.Process_ID = 'NOT2HPA' OR SP.Process_ID = 'PARTRECV' OR SP.Process_ID = 'PARTSELECT' ) "
			cSQL = cSQL +" ORDER BY SP.Process_ID,AllowSub "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSelectSTK')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSelectSTK' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSelectSTK")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSelectSTK")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSelectSTK')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
		
			IF USED('tmpSelectSTK')
				IF RECCOUNT('tmpSelectSTK') > 0
					ThisFormSet.StockLst_ID_Detail = tmpSelectSTK.ID_Detail
					nID_Detail = tmpSelectSTK.ID_Detail
					lReturn = .T.
				ENDIF
				USE IN tmpSelectSTK
			ENDIF
		ENDIF
		
		**************************
		
		IF pWhat = "ID_Detail"
			ThisFormSet.StockLst_ID_Detail = nID_Detail
			lReturn = .T.
		ENDIF
		
		
		
		RETURN lReturn
	ENDPROC

	PROCEDURE set_alfmsccss
		PARAMETERS pTBL,pID_Detail
		*ThisFormSet.Set_AlFmsCCsS
		
		PRIVATE cAlloy,cFormSort,nCCSortValue,nSize
