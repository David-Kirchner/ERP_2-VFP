		nID_Detail_Process = 0
		IF ThisFormSet.frmStockLstProcesses.Visible
			nID_Detail = PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail.Value,'ID_Detail',-3)
			nID_Detail_Process = PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
			THISFORMSET.StockLstProcesses(nID_Detail_Process, 'ID_DETAIL_P', "SHOW")
		ELSE
			THISFORMSET.StockLstProcesses(nID_Detail, 'ID_DETAIL', "SHOW")
		ENDIF
		
		*THISFORMSET.StockLstProcesses(nID_Detail, 'ID_DETAIL', "SHOW")
			*CALLS:ThisFormSet.RefreshStockLstProcesses()
			*CALLS:ThisFormSet.IsProcess_Of_Order()
