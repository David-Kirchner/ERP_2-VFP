			ThisForm.lblDueDate1.Visible = .T.
			ThisForm.DueDate1.Visible = .T.
			ThisForm.lblAllowSub.VISIBLE = .T.
			ThisForm.AllowSub1.VISIBLE = .T.
			ThisForm.lblWeight1.Visible = .T.
			ThisForm.pPounds1.Visible = .T.
			ThisForm.lblQTY.Visible = .T.
			ThisForm.pQTY1.Visible = .T.
			ThisForm.PU1.Visible = .T.
			ThisForm.lblProcess_ID1.Visible = .T.
			ThisForm.Process_ID1.Visible = .T.
			ThisForm.lblProcessor1.Visible = .T.
			ThisForm.Processor1.Visible = .T.
		CASE This.Value = 2
			ThisForm.SOITEM1.VISIBLE = .F.
			ThisForm.WO1.VISIBLE = .F.
			ThisForm.WO_Detail1.VISIBLE = .F.
			ThisForm.PO_ITEM1.VISIBLE = .F.
			ThisForm.lblSalesPerson1.Visible = .F.
			ThisForm.SalesPerson1.Visible = .F.
			ThisForm.lblstartDate1.Visible = .F.
			ThisForm.StartDate1.Visible = .F.
			ThisForm.lblDueDate1.Visible = .F.
			ThisForm.DueDate1.Visible = .F.
			ThisForm.lblAllowSub.VISIBLE = .F.
			ThisForm.AllowSub1.VISIBLE = .F.
			ThisForm.lblWeight1.Visible = .F.
			ThisForm.pPounds1.Visible = .F.
			ThisForm.lblQTY.Visible = .F.
			ThisForm.pQTY1.Visible = .F.
			ThisForm.PU1.Visible = .F.
			ThisForm.lblProcess_ID1.Visible = .F.
			ThisForm.Process_ID1.Visible = .F.
			ThisForm.lblProcessor1.Visible = .F.
			ThisForm.Processor1.Visible = .F.
		ENDCASE
	ENDPROC

	PROCEDURE frmQuote.cmdReprintWS.Click
		*Keep the same as EditSales window
		
		IF NOT USED('tmpSO')
			MESSAGEBOX("Cannot Show Processes without a Sales Order or Work Order!",0+16,'No SO or WO!')
			RETURN .F.
		ENDIF
		
		PRIVATE cSOitem, nSalesNum, cSOitem_Item
		cSOitem = PrepareSQLtxt(tmpSO.SOitem,'SOitem',10)
		IF cSOitem = Proper_SO_item('')
			MESSAGEBOX("No SOitem Found!",0,"Cannot continue")
			RETURN .F.
		ENDIF
		nSalesNum = Proper_SO_Item_SO(cSOitem)
		cSOitem_Item = Proper_SO_Item_Item(cSOitem)
		
		PRIVATE nCurrRec
		nCurrec = RECNO('tmpSO')
		
		PRIVATE cSQL, nSQLEXEC, lOK
		lOK = .T.
		*****************************
		IF FILE('REPORTS\WorkSheet.FRX')
			glTrt_Lumber = .F.
			*********************	
			lOK = ThisFormSet.SeekSalesNuminSales_No(nSalesNum)	&&Sales_No
			*********************
			lOK = ThisFormSet.SeekStartingStock(AllQuotes_ID_From_SOitem(cSOitem))	&&StartingStock  AllQuotes.ID
			*********************
			lOK = ThisFormSet.SeekPOitems(cSOitem) 		&&tmpAllPOitems
			*********************
			lOK = ThisFormSet.Refresh_WorkSheet(cSOitem)		&&WorkSheet
			*********************
			lOK = ThisFormSet.Refresh_SalesQuote(cSOitem)		&&SalesQuote
			*********************
			
			IF lOk
				ThisForm.AlwaysOnBottom = .T.
				*SELECT tmpSO  &&WorkSheet Report uses Table WorkSheet
		
				SET PRINTER TO DEFAULT
				WAIT WINDOW "Print Work Sheet to:" NOWAIT
				REPORT FORM reports\WorkSheet NOCONSOLE TO PRINTER PROMPT FOR WorkSheet.SOitem = cSOitem 
				WAIT WINDOW 'Printed Work Sheet' NOWAIT
				ThisForm.AlwaysOnBottom = .F.
				ThisForm.AlwaysOnTop = .T.
				
				Save_SOitem_Status( cSOitem, Proper_SO_Item_SO(cSOitem), "REPRINT", "WorkSheet page was reprinted.", ThisFormSet.nConnhandle )
				
			ENDIF
					
			****************************
			IF USED('Sales_No')
				USE IN Sales_No
			ENDIF
			
			IF USED('StartingStock')
				USE IN StartingStock
			ENDIF
			
			IF USED('tmpAllPOitems')
				USE IN tmpAllPOitems
			ENDIF
		
			IF USED('WorkSheet')
				USE IN WorkSheet
			ENDIF
		
			IF USED('SalesQuote')
				USE IN SalesQuote
			ENDIF
		ELSE
			MESSAGEBOX("Cannot print",0,"Report form not found")
			WAIT WINDOW 'Report form not found' NOWAIT
		ENDIF
		
		SELECT tmpSO
		*GO TOP IN tmpSO
		IF nCurrec  <= RECCOUNT('tmpSO')
			GOTO nCurrec 
		ELSE
			GO TOP
		ENDIF
		
	ENDPROC

	PROCEDURE frmQuote.lblPOitem.Click
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.POitem.Value,'POitem',12)
		
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			ThisFormSet.CountPOitem_Process(cPOitem)
		
		ELSE
			MESSAGEBOX("No POitem Found!",16,"No POitem")
		ENDIF
	ENDPROC

	PROCEDURE frmQuote.Refresh
		**Depricated use RefreshForms()
		IF NOT USED('tmpSO')
			TrackError("tmpSO not Found","tmpSO not Found",PROGRAM(),LINENO(1))
			*ThisFormSet.RefreshTmpQuotes()
			ThisFormSet.RefreshSO()
		ENDIF 
		
		IF USED('tmpSO')
			DO CASE
			*10,Bar,11,Flat Bar,12,Hex Bar,13,Square Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,
			*40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
			CASE tmpSO.Form = "10" &&Bar
				This.LBLTHCK1.Caption = "Dia:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .F.
				This.LBLSZ31.Caption = ""
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Bar"
			CASE tmpSO.Form = "11" &&Flat Bar
				This.LBLTHCK1.Caption = "Bar:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Flat Bar"
			CASE tmpSO.Form = "12" &&Hex Bar
				This.LBLTHCK1.Caption = "Hex:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .F.
				This.LBLSZ31.Caption = ""
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Hex Bar"
			CASE tmpSO.Form = "20" &&Wire Spool
				This.LBLTHCK1.Caption = "Dia:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "Pounds Spool"
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Wire"
			CASE tmpSO.Form = "21" &&Wire Cuts
				This.LBLTHCK1.Caption = "Dia:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = ["Cuts]
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Cut Wire"
			CASE tmpSO.Form = "30" &&Coated Electrodes
				This.LBLTHCK1.Caption = "Dia:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = ["CE]
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Pound Can"
			CASE tmpSO.Form = "40" &&Plate Sheet
				This.LBLTHCK1.Caption = "Thck:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Plate/Sheet"
			CASE tmpSO.Form = "51" &&Strip
				This.LBLTHCK1.Caption = "Thck:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Pounds Strip"
			CASE tmpSO.Form = "60" && Tube
				This.LBLTHCK1.Caption = "OD"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "Wall"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Tube"
			CASE tmpSO.Form = "65" && Pipe
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Pipe"
			CASE tmpSO.Form = "66" && Nipple
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Nipple"
			CASE tmpSO.Form = "67" &&Elbow
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "Deg"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Elbow"
			CASE tmpSO.Form = "68" &&Tee
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .F.
				This.LBLSZ31.Caption = ""
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Tee"
			CASE tmpSO.Form = "69" && Reducer
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "IPS"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "SCH"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Reducer"
			*60 Pipe, 65 Tube, 66 Nipple, 67 Elbow, 68 Tee, 69 Reducer, 70 Fittings, 72 Flange, 75 Fasteners, 80 Disk 	
			CASE tmpSO.Form = "70" &&Fittings
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Fittings"
			CASE tmpSO.Form = "71" &&Coupling
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "LBS"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "X Lg"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Coupling"
			CASE tmpSO.Form = "72" &&Flange
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = " - Lb"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Flange"
			CASE tmpSO.Form = "75" &&Fasteners
				This.LBLTHCK1.Caption = ""
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "-"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Long"
			CASE tmpSO.Form = "80" &&Disk
				This.LBLTHCK1.Caption = "Thck:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "OD:"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "ID:"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Disk"
			CASE tmpSO.Form = "90"
				This.LBLTHCK1.Caption = "Mach:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .F.
				This.LBLSZ41.Caption = ""
			OTHERWISE &&
				This.LBLTHCK1.Caption = "Thck:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .F.
				This.LBLSZ41.Caption = ""
			ENDCASE
		
		ENDIF
	ENDPROC

	PROCEDURE frmRecollectCerts.cmdOpen.Click
		
		RUN EXPLORER "\\Turkey\CERTIFICATION.RAP\"
	ENDPROC

	PROCEDURE frmRecollectCerts.cmdOpenAlloy.Click
		
		IF NOT EMPTY(ThisFormSet.cUNSAlloyDrw)
			cUNSAlloyDrw  = ThisFormSet.cUNSAlloyDrw
			RUN EXPLORER &cUNSAlloyDrw
		ELSE
			RUN EXPLORER "\\Turkey\CERTIFICATION.RAP\"
		ENDIF
		
	ENDPROC

	PROCEDURE frmRecollectCerts.cmdQuit.Click
		ThisForm.Visible = .F.
		ThisFormSet.frmCerts.Visible = .F.
	ENDPROC

	PROCEDURE frmRecollectCerts.cmdSaveLoc.Click
		PRIVATE cLocation
		cLocation = PrepareSQLtxt(ThisForm.txtLocation.Value,'Location',255)
		
		IF "\\Turkey\" = cLocation
			MESSAGEBOX("Only use text past Alloy.FLD",0+64,"No Save")
			RETURN .F.
		ENDIF
		
		PRIVATE cAlloy,cCertAlloy
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cCertAlloy = CertName(cAlloy)
		
		PRIVATE cUNS,cUNSAlloyDrw
		cUNS = PrepareSQLtxt(ThisForm.txtUNS.Value,'UNS',6)
		IF EMPTY(cUNS)
			cUNS =  GetUNS( cAlloy, ThisFormSet.nConnHandle)
		ENDIF
		
		cUNSAlloyDrw = "\\Turkey\CERTIFICATION.RAP\"+cUNS+".DRW\"+cCertAlloy+".FLD"
			
		IF DIRECTORY( cUNSAlloyDrw )
			cTestLocation = cUNSAlloyDrw +IIF( LEFT(cLocation,1)="\",cLocation,"\"+cLocation)
			IF DIRECTORY( cTestLocation )
				*good to Save
				cLocation = cTestLocation 
			ENDIF
		ENDIF
				
		IF !DIRECTORY( cLocation )
			MESSAGEBOX("This location is not VALID",0+64,"No Save")
			RETURN .F.
		ENDIF
		
		
		PRIVATE cForm,nThck,cThck,cHeat,cLot,nStockLst_ID
		cForm	= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,4)
		cThck 	= STR(nThck,8,3)
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',35))
		cLot	= ALLTRIM(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		nStockLst_ID = ThisFormSet.nStockLst_ID
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "INSERT INTO dbo.Recollect_Cert_Loc ("
		cSQL = cSQL + "Alloy,Form,Size,Heat,Lot,UNS,Location,StockLst_ID) VALUES ("
		cSQL = cSQL + " '"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ", "+STR(nThck,9,3)
		cSQL = cSQL + ",'"+cHeat+"'"
		cSQL = cSQL + ",'"+cLot+"'"
		cSQL = cSQL + ",'"+cUNS+"'"
		cSQL = cSQL + ",'"+cLocation+"'"
		cSQL = cSQL + ", "+STR(nStockLst_ID)
		cSQL = cSQL + ")"
		
		
		nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL ,ThisFormset.nConnHandle, nSQLEXEC, '')
				MESSAGEBOX("Could not be saved!"+CHR(13)+"Duplicates can not be saved.",0+64,"SQL Error")
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			WAIT WINDOW "Saved!" NOWAIT
			ThisForm.txtLocation.Value = ''
			ThisForm.txtComment.Value = 'Saved new location:'+cLocation
		ENDIF
		
	ENDPROC

	PROCEDURE frmRecollectCerts.cmdSearch.Click
		PRIVATE lOK, lFoundFile
		lOK = .T.
		lFoundFile = .F.
		
		ThisForm.txtComment.Value = ""
		
		PRIVATE cAlloy,cCertAlloy
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cCertAlloy = CertName(cAlloy)
		ThisForm.txtCertAlloy.Value = cCertAlloy
		
		PRIVATE cForm,nThck,cHeat,cThck,cLot
		cForm	= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,4)
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',40))
		cLot	= ALLTRIM(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		IF cLot='0'
			cLot = ''
		ENDIF
		
		PRIVATE cUNS,cUNSDrw,cUNSAlloyDrw,cFormThicknessHeat,cFormThicknessHeat2 
		cUNS		= ThisForm.txtUNS.Value
		cUNSDrw		= ""
		cUNSAlloyDrw = ""
		
		IF EMPTY(cUNS)
			cUNS =  GetUNS( cAlloy, ThisFormSet.nConnHandle)
		ENDIF
		IF !EMPTY(cUNS)
			ThisForm.txtUNS.Value = cUNS
			WAIT WINDOW "UNS:"+cUNS NOWAIT
		ELSE
			MESSAGEBOX("Could not find the UNS for Alloy:"+cAlloy,0+64,"Bad Alloy UNS")
			ThisForm.txtComment.Value = "Could not find the UNS for Alloy:"+cAlloy
			lOK = .F.
		**	RETURN .F.
		ENDIF
		
		IF lOK
			cUNSDrw = "\\Turkey\CERTIFICATION.RAP\"+cUNS+".DRW"
		
			IF DIRECTORY( cUNSDrw )
				lOK = .T.
			ELSE
				ThisForm.txtComment.Value = "Did not Find UNS Drawer "+cUNSDrw 
				lOK = .F.
				MESSAGEBOX("Did not Find UNS Drawer "+cUNSDrw,0,"Not in Recollect")
				**RETURN .F.
			ENDIF
		ENDIF
		ThisFormSet.cUNSAlloyDrw = ''
		
		IF lOK
			*Find Alloy Drawer
			cUNSAlloyDrw = "\\Turkey\CERTIFICATION.RAP\"+cUNS+".DRW\"+cCertAlloy+".FLD"
			ThisFormSet.cUNSAlloyDrw = cUNSAlloyDrw 
			ThisForm.UNSAlloyDrw.Value = cUNSAlloyDrw 
			
			IF DIRECTORY( cUNSAlloyDrw  )
				WAIT WINDOW "Found UNS\Alloy Drawer "+cUNSAlloyDrw  NOWAIT
				lOK = .T.
			ELSE
				ThisForm.txtComment.Value = "Did not Find UNS\Alloy Drawer "+cUNSAlloyDrw  
				IF EMPTY(cCertAlloy)
					MESSAGEBOX("SQL Alloy table does not have a 'CertName' entry for this alloy! "+cAlloy+CHR(13)+"Use 'HPA-Maintanence-Alloy Standard' to add the CertName!",0,"Could not find.")
				ELSE
					MESSAGEBOX("Did not Find UNS\Alloy Drawer "+cUNSAlloyDrw,0,"Not in Recollect")
				ENDIF
				lOK = .F.
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE cFormThicknessHeat,cFormThicknessHeatLot,cFormThicknessHeat2 
		cFormThicknessHeat = ""
		cFormThicknessHeatLot = ""
		cFormThicknessHeat2 = ""
		
		********************
		IF lOK
			PRIVATE nStockLst_ID
			nStockLst_ID = ThisFormSet.nStockLst_ID
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT Location FROM dbo.Recollect_Cert_Loc WITH(NOLOCK) WHERE "
			cSQL = cSQL + " StockLst_ID="+STR(nStockLst_ID)
		
			IF USED('tmpRecollect_Cert_Loc')
				USE IN tmpRecollect_Cert_Loc
			ENDIF
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecollect_Cert_Loc')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecollect_Cert_Loc')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecollect_Cert_Loc")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecollect_Cert_Loc")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRecollect_Cert_Loc')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF USED('tmpRecollect_Cert_Loc')
					IF VARTYPE(tmpRecollect_Cert_Loc.Location) = 'C'
						 IF NOT EMPTY(tmpRecollect_Cert_Loc.Location)
							cFormThicknessHeatLot = tmpRecollect_Cert_Loc.Location
							cFormThicknessHeat    = tmpRecollect_Cert_Loc.Location
							WAIT WINDOW "Looking for Directory:"+cFormThicknessHeatLot NOWAIT
							IF DIRECTORY( cFormThicknessHeatLot )
								ThisForm.txtComment.Value = "SQL Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
								ThisForm.txtLocation.Value = tmpRecollect_Cert_Loc.Location
								lOK = .T.
								lFoundFile =.T.
							ENDIF
							WAIT CLEAR
						ENDIF
					ENDIF
				USE IN tmpRecollect_Cert_Loc
				ENDIF
			ENDIF
		ENDIF
		********************
		
		IF lOK AND !lFoundFile
			*Find Form Thickness Heat Lot
			IF LEN(cLot) > 0
				cThck = Remove0(nThck,9,4)
				IF nThck < 1
					IF LEFT(cThck,1) != '0'
						cThck = "0"+cThck
					ENDIF
				ENDIF
				cFormThicknessHeatLot = cUNSAlloyDrw + "\"+cForm+" "+cThck +" "+cHeat+" "+cLot+".DOC"
				WAIT WINDOW "Looking for Directory:"+cFormThicknessHeatLot NOWAIT
				IF DIRECTORY( cFormThicknessHeatLot )
					ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
					WAIT WINDOW ThisForm.txtComment.Value NOWAIT
					lFoundFile = .T.
				ELSE
					cFormThicknessHeatLot2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,3) +" "+cHeat+" "+cLot+".DOC"
					IF DIRECTORY( cFormThicknessHeatLot2 )
						cFormThicknessHeatLot = cFormThicknessHeatLot2
						ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
						WAIT WINDOW ThisForm.txtComment.Value NOWAIT
						lFoundFile = .T.
					ELSE
						cFormThicknessHeatLot2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,2) +" "+cHeat+" "+cLot+".DOC"
						IF DIRECTORY( cFormThicknessHeatLot2 )
							cFormThicknessHeatLot = cFormThicknessHeatLot2
							ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
							WAIT WINDOW ThisForm.txtComment.Value NOWAIT
							lFoundFile  = .T.
						ELSE	
							cFormThicknessHeatLot2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,1) +" "+cHeat+" "+cLot+".DOC"
							IF DIRECTORY( cFormThicknessHeatLot2 )
								cFormThicknessHeatLot = cFormThicknessHeatLot2
								ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
								WAIT WINDOW ThisForm.txtComment.Value NOWAIT
								lFoundFile = .T.
							ELSE	
								cFormThicknessHeatLot2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,0) +" "+cHeat+" "+cLot+".DOC"
								IF DIRECTORY( cFormThicknessHeatLot2 )
									cFormThicknessHeatLot = cFormThicknessHeatLot2
									ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
									WAIT WINDOW ThisForm.txtComment.Value NOWAIT
									lFoundFile = .T.
								ELSE	
									cFormThicknessHeatLot2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,3)+"0" +" "+cHeat+" "+cLot+".DOC"
									IF DIRECTORY( cFormThicknessHeatLot2 )
										cFormThicknessHeatLot = cFormThicknessHeatLot2
										ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
										WAIT WINDOW ThisForm.txtComment.Value NOWAIT
										lFoundFile = .T.
									ELSE
										cFormThicknessHeatLot2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,2)+"0"  +" "+cHeat+" "+cLot+".DOC"
										IF DIRECTORY( cFormThicknessHeatLot2 )
											cFormThicknessHeatLot = cFormThicknessHeatLot2
											ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
											WAIT WINDOW ThisForm.txtComment.Value NOWAIT
											lFoundFile = .T.
										ELSE	
											cFormThicknessHeatLot2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,1)+"0"  +" "+cHeat+" "+cLot+".DOC"
											IF DIRECTORY( cFormThicknessHeatLot2 )
												cFormThicknessHeatLot = cFormThicknessHeatLot2
												ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
												WAIT WINDOW ThisForm.txtComment.Value NOWAIT
												lFoundFile = .T.
											ELSE	
												cFormThicknessHeatLot2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,0)+".0"  +" "+cHeat+" "+cLot+".DOC"
												IF DIRECTORY( cFormThicknessHeatLot2 )
													cFormThicknessHeatLot = cFormThicknessHeatLot2
													ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
													WAIT WINDOW ThisForm.txtComment.Value NOWAIT
													lFoundFile = .T.
												ELSE	
													cFormThicknessHeat2Lot  = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,2)+"00"  +" "+cHeat+cLot+".DOC"
													IF DIRECTORY( cFormThicknessHeat2Lot  )
														cFormThicknessHeatLot = cFormThicknessHeat2Lot 
														ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
														WAIT WINDOW ThisForm.txtComment.Value NOWAIT
														lFoundFile = .T.
													ELSE	
														cFormThicknessHeat2Lot  = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,1)+"00"  +" "+cHeat+cLot+".DOC"
														IF DIRECTORY( cFormThicknessHeat2Lot  )
															cFormThicknessHeatLot = cFormThicknessHeat2Lot 
															ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
															WAIT WINDOW ThisForm.txtComment.Value NOWAIT
															lFoundFile = .T.
														ELSE	
															cFormThicknessHeat2Lot  = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,0)+".00"  +" "+cHeat+cLot+".DOC"
															IF DIRECTORY( cFormThicknessHeat2Lot  )
																cFormThicknessHeatLot = cFormThicknessHeat2Lot 
																ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
																WAIT WINDOW ThisForm.txtComment.Value NOWAIT
																lFoundFile = .T.
															ELSE								
																MESSAGEBOX("Did not Find with Lot number:"+cLot+CHR(13)+"UNS,Form,Thickness,Heat,Lot"+CHR(13)+cFormThicknessHeatLot+CHR(13)+"Be carefull to manually check Heat/Lot.",64,"Lot not found")
		*														lFoundFile = .F.
		*														*RETURN .F.
		*														RUN EXPLORER &cUNSAlloyDrw
															ENDIF
														ENDIF
													ENDIF
												ENDIF
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
		
			ENDIF
		ENDIF
		
		
		*************************************
		IF lOK AND !lFoundFile 
			*Find Form Thickness Heat - No Lot
			cThck = Remove0(nThck,9,4)
			IF nThck < 1
				IF LEFT(cThck,1) != '0'
					cThck = "0"+cThck
				ENDIF
			ENDIF
			*? cThck
			cFormThicknessHeat = cUNSAlloyDrw + "\"+cForm+" "+cThck +" "+cHeat+".DOC"
			
			IF DIRECTORY( cFormThicknessHeat )
				ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
				WAIT WINDOW ThisForm.txtComment.Value NOWAIT
				lFoundFile = .T.
			ELSE
				cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,3) +" "+cHeat+".DOC"
				IF DIRECTORY( cFormThicknessHeat2 )
					cFormThicknessHeat = cFormThicknessHeat2
					ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
					WAIT WINDOW ThisForm.txtComment.Value NOWAIT
					lFoundFile = .T.
				ELSE
					cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,2) +" "+cHeat+".DOC"
					IF DIRECTORY( cFormThicknessHeat2 )
						cFormThicknessHeat = cFormThicknessHeat2
						ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
						WAIT WINDOW ThisForm.txtComment.Value NOWAIT
						lFoundFile = .T.
					ELSE	
						cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,1) +" "+cHeat+".DOC"
						IF DIRECTORY( cFormThicknessHeat2 )
							cFormThicknessHeat = cFormThicknessHeat2
							ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
							WAIT WINDOW ThisForm.txtComment.Value NOWAIT
							lFoundFile = .T.
						ELSE	
							cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,0) +" "+cHeat+".DOC"
							IF DIRECTORY( cFormThicknessHeat2 )
								cFormThicknessHeat = cFormThicknessHeat2
								ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
								WAIT WINDOW ThisForm.txtComment.Value NOWAIT
								lFoundFile = .T.
							ELSE	
							
								cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,3)+"0" +" "+cHeat+".DOC"
								IF DIRECTORY( cFormThicknessHeat2 )
									cFormThicknessHeat = cFormThicknessHeat2
									ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
									WAIT WINDOW ThisForm.txtComment.Value NOWAIT
									lFoundFile = .T.
								ELSE
									cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,2)+"0"  +" "+cHeat+".DOC"
									IF DIRECTORY( cFormThicknessHeat2 )
										cFormThicknessHeat = cFormThicknessHeat2
										ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
										WAIT WINDOW ThisForm.txtComment.Value NOWAIT
										lFoundFile = .T.
									ELSE	
										cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,1)+"0"  +" "+cHeat+".DOC"
										IF DIRECTORY( cFormThicknessHeat2 )
											cFormThicknessHeat = cFormThicknessHeat2
											ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
											WAIT WINDOW ThisForm.txtComment.Value NOWAIT
											lFoundFile = .T.
										ELSE	
											cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,0)+".0"  +" "+cHeat+".DOC"
											IF DIRECTORY( cFormThicknessHeat2 )
												cFormThicknessHeat = cFormThicknessHeat2
												ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
												WAIT WINDOW ThisForm.txtComment.Value NOWAIT
												lFoundFile = .T.
											ELSE	
											
												cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,2)+"00"  +" "+cHeat+".DOC"
												IF DIRECTORY( cFormThicknessHeat2 )
													cFormThicknessHeat = cFormThicknessHeat2
													ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
													WAIT WINDOW ThisForm.txtComment.Value NOWAIT
													lFoundFile = .T.
												ELSE	
													cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,1)+"00"  +" "+cHeat+".DOC"
													IF DIRECTORY( cFormThicknessHeat2 )
														cFormThicknessHeat = cFormThicknessHeat2
														ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
														WAIT WINDOW ThisForm.txtComment.Value NOWAIT
														lFoundFile = .T.
													ELSE	
														cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,0)+".00"  +" "+cHeat+".DOC"
														IF DIRECTORY( cFormThicknessHeat2 )
															cFormThicknessHeat = cFormThicknessHeat2
															ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
															WAIT WINDOW ThisForm.txtComment.Value NOWAIT
															lFoundFile = .T.
														ELSE									
															ThisForm.txtComment.Value = "Did not Find UNS,Form,Thickness,Heat "+cFormThicknessHeat 
															lOK = .F.
															*RETURN .F.
															*RUN EXPLORER &cUNSAlloyDrw
														ENDIF
													ENDIF
												ENDIF
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		WAIT Clear
		
		IF !lOK OR !lFoundFile 
			*Look up in SQL with LOT
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT Location FROM dbo.Recollect_Cert_Loc WITH(NOLOCK) WHERE "
			cSQL = cSQL + " UNS='"+cUNS+"'"
			cSQL = cSQL + " AND Form='"+cForm+"'"
			cSQL = cSQL + " AND Size="+STR(nThck,9,3)
			cSQL = cSQL + " AND Heat='"+cHeat+"'"
			cSQL = cSQL + " AND Lot='"+cLot+"'"
			
			IF USED('tmpRecollect_Cert_Loc')
				USE IN tmpRecollect_Cert_Loc
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecollect_Cert_Loc')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecollect_Cert_Loc')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecollect_Cert_Loc")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecollect_Cert_Loc")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRecollect_Cert_Loc')
					lOK = .F.
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF USED('tmpRecollect_Cert_Loc')
					IF VARTYPE(tmpRecollect_Cert_Loc.Location) = 'C'
						 
						cFormThicknessHeatLot = tmpRecollect_Cert_Loc.Location
						cFormThicknessHeat    = tmpRecollect_Cert_Loc.Location
						
						IF DIRECTORY( cFormThicknessHeatLot )
							ThisForm.txtComment.Value = "SQL Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
							ThisForm.txtLocation.Value = tmpRecollect_Cert_Loc.Location
							lOK = .T.
							lFoundFile = .T.
						ENDIF
						
					ENDIF
				USE IN tmpRecollect_Cert_Loc
				ENDIF
			ENDIF
		ENDIF
		
		IF !lOK OR !lFoundFile 
			*Look up in SQL - No Lot
			
			cSQL = "SELECT Location FROM dbo.Recollect_Cert_Loc WITH(NOLOCK) WHERE "
			cSQL = cSQL + " UNS='"+cUNS+"'"
			cSQL = cSQL + " AND Form='"+cForm+"'"
			cSQL = cSQL + " AND Size="+STR(nThck,9,3)
			cSQL = cSQL + " AND Heat='"+cHeat+"'"
			
			IF USED('tmpRecollect_Cert_Loc')
				USE IN tmpRecollect_Cert_Loc
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecollect_Cert_Loc')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpRecollect_Cert_Loc')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecollect_Cert_Loc")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpRecollect_Cert_Loc")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpRecollect_Cert_Loc')
					lOK = .F.
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF USED('tmpRecollect_Cert_Loc')
					IF VARTYPE(tmpRecollect_Cert_Loc.Location) = 'C'
		
						cFormThicknessHeatLot = tmpRecollect_Cert_Loc.Location
						cFormThicknessHeat    = tmpRecollect_Cert_Loc.Location
						
						IF DIRECTORY( cFormThicknessHeatLot )
							ThisForm.txtComment.Value = "SQL Found UNS, Form, Thickness, Heat, NO_Lot "+cFormThicknessHeatLot
							ThisForm.txtLocation.Value = tmpRecollect_Cert_Loc.Location
							lFoundFile = .T.
							lOK = .T.
						ENDIF
							
					ENDIF		
					USE IN tmpRecollect_Cert_Loc
				ENDIF
			ENDIF
		ENDIF
		
		*************************************
		IF lOK AND !lFoundFile AND AT("-",cHeat) > 0
			*Find Form Thickness Heat - No Lot 
			*remove -2C Etc from heat! DropLot
			
			PRIVATE cDropLot 
			cDropLot = RIGHT(cHeat, LEN(cHeat) - AT("-",cHeat))
			cHeat = LEFT(cHeat, AT("-",cHeat)-1)
		
			cFormThicknessHeat = cUNSAlloyDrw + "\"+cForm+" "+cThck +" "+cHeat+".DOC"
			
			IF DIRECTORY( cFormThicknessHeat )
				ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot
				WAIT WINDOW ThisForm.txtComment.Value NOWAIT
				lFoundFile = .T.
			ELSE
				cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,3) +" "+cHeat+".DOC"
				IF DIRECTORY( cFormThicknessHeat2 )
					cFormThicknessHeat = cFormThicknessHeat2
					ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot 
					WAIT WINDOW ThisForm.txtComment.Value NOWAIT
					lFoundFile = .T.
				ELSE
					cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,2) +" "+cHeat+".DOC"
					IF DIRECTORY( cFormThicknessHeat2 )
						cFormThicknessHeat = cFormThicknessHeat2
						ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
						WAIT WINDOW ThisForm.txtComment.Value NOWAIT
						lFoundFile = .T.
					ELSE	
						cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,1) +" "+cHeat+".DOC"
						IF DIRECTORY( cFormThicknessHeat2 )
							cFormThicknessHeat = cFormThicknessHeat2
							ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
							WAIT WINDOW ThisForm.txtComment.Value NOWAIT
							lFoundFile = .T.
						ELSE	
							cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,0) +" "+cHeat+".DOC"
							IF DIRECTORY( cFormThicknessHeat2 )
								cFormThicknessHeat = cFormThicknessHeat2
								ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
								WAIT WINDOW ThisForm.txtComment.Value NOWAIT
								lFoundFile = .T.
							ELSE	
							
								cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,3)+"0" +" "+cHeat+".DOC"
								IF DIRECTORY( cFormThicknessHeat2 )
									cFormThicknessHeat = cFormThicknessHeat2
									ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
									WAIT WINDOW ThisForm.txtComment.Value NOWAIT
									lFoundFile = .T.
								ELSE
									cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,2)+"0"  +" "+cHeat+".DOC"
									IF DIRECTORY( cFormThicknessHeat2 )
										cFormThicknessHeat = cFormThicknessHeat2
										ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
										WAIT WINDOW ThisForm.txtComment.Value NOWAIT
										lFoundFile = .T.
									ELSE	
										cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,1)+"0"  +" "+cHeat+".DOC"
										IF DIRECTORY( cFormThicknessHeat2 )
											cFormThicknessHeat = cFormThicknessHeat2
											ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
											WAIT WINDOW ThisForm.txtComment.Value NOWAIT
											lFoundFile = .T.
										ELSE	
											cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,0)+".0"  +" "+cHeat+".DOC"
											IF DIRECTORY( cFormThicknessHeat2 )
												cFormThicknessHeat = cFormThicknessHeat2
												ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
												WAIT WINDOW ThisForm.txtComment.Value NOWAIT
												lFoundFile = .T.
											ELSE	
											
												cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,2)+"00"  +" "+cHeat+".DOC"
												IF DIRECTORY( cFormThicknessHeat2 )
													cFormThicknessHeat = cFormThicknessHeat2
													ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
													WAIT WINDOW ThisForm.txtComment.Value NOWAIT
													lFoundFile = .T.
												ELSE	
													cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,1)+"00"  +" "+cHeat+".DOC"
													IF DIRECTORY( cFormThicknessHeat2 )
														cFormThicknessHeat = cFormThicknessHeat2
														ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
														WAIT WINDOW ThisForm.txtComment.Value NOWAIT
														lFoundFile = .T.
													ELSE	
														cFormThicknessHeat2 = cUNSAlloyDrw + "\"+cForm+" "+Remove0(nThck,9,0)+".00"  +" "+cHeat+".DOC"
														IF DIRECTORY( cFormThicknessHeat2 )
															cFormThicknessHeat = cFormThicknessHeat2
															ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
															WAIT WINDOW ThisForm.txtComment.Value NOWAIT
															lFoundFile = .T.
														ELSE									
															ThisForm.txtComment.Value = "Did not Find UNS,Form,Thickness,Heat "+cFormThicknessHeat 
															lOK = .F.
															*RETURN .F.
															*RUN EXPLORER &cUNSAlloyDrw
														ENDIF
													ENDIF
												ENDIF
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		WAIT Clear
		
		
		*************************************
		
		
		PRIVATE nCntFoundHeat, i, i2
		nCntFoundHeat = 0
		i = 0
		i2 = 0
		
		IF !lFoundFile 
			IF ADIR(aDirectory, cUNSAlloyDrw+"\*.DOC", "D" ) > 0
				FOR i = 1 TO ALEN(aDirectory,1)
					IF cHeat $ aDirectory(i,1)
						nCntFoundHeat = nCntFoundHeat + 1
						DIMENSION aFoundHeat(nCntFoundHeat)
						aFoundHeat(nCntFoundHeat) = aDirectory(i,1)
						
					ENDIF
				ENDFOR
				
				IF nCntFoundHeat > 0
					FOR i2 = 1 TO nCntFoundHeat 
						IF MESSAGEBOX("Did not find match for your heat."+CHR(13)+"Do you think this is your document?"+CHR(13)+aFoundHeat(i2)+CHR(13)+"Folder "+ALLTRIM(STR(i2))+" of "+ALLTRIM(STR(nCntFoundHeat)),4+32,"Found Similar") = 6
							cFormThicknessHeat =  cUNSAlloyDrw+"\"+aFoundHeat(i2)
							cFormThicknessHeatLot = cUNSAlloyDrw+"\"+aFoundHeat(i2)
							ThisForm.txtComment.Value = "UNS, Form, Thickness, Heat "+cFormThicknessHeat
							WAIT WINDOW ThisForm.txtComment.Value NOWAIT
							
							lFoundFile = .T.
							lOK = .T.
							EXIT
						ENDIF
					ENDFOR
				ENDIF
			ENDIF
		ENDIF
		*************************************
		
		IF !lFoundFile 
			MESSAGEBOX(ThisForm.txtComment.Value +CHR(13)+"An Explorer window will now open so you can search for the cert."+CHR(13)+"Also try the Dead Cert folder.",0+64,"Not Found")
			RUN EXPLORER &cUNSAlloyDrw
		ENDIF
		
		IF lOK AND lFoundFile 
		*cFile = "\\Turkey\CERTIFICATION.RAP\N10276.DRW\c-276.FLD\10 0.5 E1268-1AFA.DOC\ORIG0001.TIF,\\Turkey\CERTIFICATION.RAP\N10276.DRW\c-276.FLD\10 0.5 E1268-1AFA.DOC\ORIG0002.TIF"
		
			**
			IF EMPTY(cFormThicknessHeat)
				IF NOT EMPTY(cFormThicknessHeatLot)
					cFormThicknessHeat = cFormThicknessHeatLot
				ELSE
					TrackError("cFormThicknessHeat and cFormThicknessHeatLot are empty!","cFormThicknessHeat and cFormThicknessHeatLot are empty!",PROGRAM(),LINENO(1))
				ENDIF
			ENDIF
			PRIVATE nFilesTIF,nFilesJPG
			nFilesTIF = ADIR(aFilesTIF,cFormThicknessHeat+'\*.TIF')
			nFilesJPG = ADIR(aFilesJPG,cFormThicknessHeat+'\*.JPG')
			
			IF nFilesTIF + nFilesJPG > 0
				ThisFormset.frmCerts.lstCertImages.Clear
				
				FOR i = 1 TO nFilesTIF
					DIMENSION gaCertImage(i)
					gaCertImage(i) = aFilesTIF(i,1)
					ThisFormset.frmCerts.lstCertImages.AddItem(aFilesTIF(i,1))
					ThisFormset.frmCerts.lstCertImages.Refresh
				ENDFOR
				FOR i = 1 TO nFilesJPG
					DIMENSION gaCertImage(i+nFilesTIF)
					gaCertImage(i+nFilesTIF) = aFilesJPG(i,1)
					ThisFormset.frmCerts.lstCertImages.AddItem(aFilesJPG(i,1))
					ThisFormset.frmCerts.lstCertImages.Refresh
				ENDFOR
				
				ThisFormSet.frmCerts.Visible = .T.
				ThisFormSet.frmCerts.Enabled = .T.
				ThisFormSet.frmCerts.AlwaysOnTop = .T.
				
				ThisFormSet.frmCerts.lstCertImages.Visible = .T.
				ThisFormset.frmCerts.lstCertImages.NumberOfElements = nFilesTIF+nFilesJPG
				IF nFilesTIF > 0
					ThisFormset.frmCerts.lstCertImages.Value = aFilesTIF(1,1)
				ELSE
					ThisFormset.frmCerts.lstCertImages.Value = aFilesJPG(1,1)
				ENDIF
				ThisFormset.frmCerts.lstCertImages.Refresh
				ThisFormSet.frmCerts.lstCertImages.Enabled = .T.
				ThisFormset.frmCerts.lstCertImages.SetFocus
		
				ThisFormSet.nRecollectCertPage = 1
				ThisFormset.frmCerts.txtUJC.Value = cFormThicknessHeat
				ThisFormset.frmCerts.Image1.Picture = cFormThicknessHeat+"\"+ThisFormset.frmCerts.lstCertImages.Value
			ELSE
			
				ThisFormSet.frmCerts.Visible = .F.
				ThisFormSet.frmCerts.Enabled = .F.
		*		ThisFormSet.frmCerts.AlwaysOnTop = .F.
			
			ENDIF
		
		ELSE
			ThisFormSet.frmCerts.Visible = .F.
			ThisFormSet.frmCerts.Enabled = .F.
			ThisFormSet.frmCerts.AlwaysOnTop = .F.
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE frmRecollectCerts.cmdTest.Click
		
		*!*	ThisForm.txtAlloy.Value = "C-276"
		*!*	ThisForm.txtForm.Value = "10"
		*!*	ThisForm.txtThck.Value = ".5"
		*!*	ThisForm.txtHeat.Value = "E1138-1AAA-1"
		
		ThisForm.txtAlloy.Value = "C-276"
		ThisForm.txtForm.Value = "10"
		ThisForm.txtThck.Value = "1"
		ThisForm.txtHeat.Value = "L12C"
		ThisForm.txtUNS.Value = "N10276"
	ENDPROC

	PROCEDURE frmRecollectCerts.txtForm.Valid
		
		** Set to Zero because something could be changed
		ThisFormSet.nStockLst_ID = 0
		*Not safe to keep ID
	ENDPROC

