		ENDIF
		
		IF TYPE("ThisFormSet.frmColorStandards") = "O"
			ThisFormSet.frmColorStandards.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmStockLst_SQL") = "O"
			ThisFormSet.frmStockLst_SQL.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmChoosePOitem") = "O"
			ThisFormSet.frmChoosePOitem.Release
		ENDIF
		
		*IF TYPE("ThisFormSet.frmRecvStock") = "O"
		*	ThisFormSet.frmRecvStock.Release
		*ENDIF
		
		IF TYPE("ThisFormSet.frmStockStatus") = "O"
			ThisFormSet.frmStockStatus.Release
		ENDIF
		
		
		IF TYPE("ThisFormSet.frmSimiliarSales") = "O"
			ThisFormSet.frmSimiliarSales.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmSimiliarOrdersProcess") = "O"
			ThisFormSet.frmSimiliarOrdersProcess.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmRecollectCerts") = "O"
			ThisFormSet.frmRecollectCerts.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmCerts") = "O"
			ThisFormSet.frmCerts.Release
		ENDIF
		
		*IF Modify_Stock4Order
		*	Modify_Stock4Order .Release
		*ENDIF
		
		
		**
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		**
		
	ENDPROC

	PROCEDURE disappear
		PARAMETER lHide
		*ThisFormSet.Disappear( .T. )
		
		IF TYPE("lHide") = "L"
			IF lHide
				ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
				*ThisFormSet.frmStockLst.Visible = .F.
				IF VARTYPE(ThisFormSet.frmStockStatus) = "O"
					ThisFormSet.frmStockStatus.Visible = .F.
				ENDIF
				ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
				ThisFormSet.frmSimiliarSales.Visible = .F.
				ThisFormSet.frmModiProcess.Visible = .F.
				ThisFormSet.frmStockLstProcesses.Visible = .F.
				ThisFormSet.frmChooseSO.Visible = .F.
				ThisFormSet.frmColorStandards.Visible = .F.
		
			ELSE
				ThisFormSet.frmShop_StockLst_Edit.Visible = .T.
				ThisFormSet.frmQuote.Visible = .T.
				*ThisFormSet.frmStockLst.Visible = .F.
				IF VARTYPE(ThisFormSet.frmStockStatus) = "O"
					ThisFormSet.frmStockStatus.Visible = .F.
				ENDIF
				ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
				ThisFormSet.frmSimiliarSales.Visible = .F.
				ThisFormSet.frmModiProcess.Visible = .F.
				ThisFormSet.frmStockLstProcesses.Visible = .F.
				ThisFormSet.frmChooseSO.Visible = .F.
				ThisFormSet.frmColorStandards.Visible = .F.
		
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE dynamicbackcolor_alloy
		PRIVATE nColor
		*DynamicBackColor_Alloy()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		DO CASE
		CASE tmpSO.INV 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		OTHERWISE 
			nColor = RGB( 255,255,128 )  &&Yellow - Due In
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamicbackcolor_bkr
		PRIVATE nColor
		*DynamicBackColor_Bkr
		*Called from grdSO.clmBrk.DynamicBackColor()
		DO CASE
		CASE tmpSO.CnCld 
			nColor = RGB( 0, 0, 0 )  &&Black
		CASE tmpSO.Cmplt
			nColor = RGB( 192, 220, 192 )  &&GREEN
			
		CASE tmpSO.prcp AND !tmpSO.prcd
			nColor = RGB( 255, 255, 128 ) &&YELLOW
			
		CASE !tmpSO.prcp AND tmpSO.prcd
			nColor = RGB( 255,128,64 ) &&ORANGE
			
		CASE tmpSO.pckd
			nColor = RGB( 255, 0, 0 ) &&RED
			
		CASE tmpSO.Bkr > 0
			*Has Process
			nColor = RGB( 128, 255, 255 ) &&Lt Blue
			
		OTHERWISE
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamicbackcolor_form
		PRIVATE nColor
		*DynamicBackColor_Form
		
		DO CASE
		CASE tmpSO.GFM
			nColor = RGB( 0, 128, 128 )  &&Dk GREEN
		CASE tmpSO.Roll
			nColor = RGB( 192, 220, 192 )  &&GREEN
		CASE tmpSO.Mach
			nColor = RGB( 255,128,64 ) &&ORANGE
		CASE tmpSO.CG
			nColor = RGB( 128,255,255 ) &&Lt Blue
		CASE tmpSO.Plasma	
			nColor = RGB( 255,128,255 ) &&Violet
		OTHERWISE
			*nColor = RGB( 192,192,192 ) &&Grey
			nColor = RGB( 255,255,255 ) &&White
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamicbackcolor_prc
		PRIVATE nColor
		*DynamicBackColor_PRC
		
		*Called from grdSO.clmPrc.DynamicBackColor()
		
		*PRCP = Process in Progress
		*PRCD = Processing Done
		*PCKD = Item has been Packaged
		
		DO CASE
		CASE tmpSO.CnCld 
			nColor = RGB( 0, 0, 0 )  &&Black
			*Cancelled
			
		CASE tmpSO.Cmplt
			*Not Cancelled
			nColor = RGB( 192, 220, 192 )  &&GREEN
			*Complete
			
		CASE tmpSO.pckd
			*Not Cancelled, Not Complete
			nColor = RGB( 255, 0, 0 ) &&RED
			*Packed
			
		CASE !tmpSO.prcp AND tmpSO.prcd 
			*Not Cancelled, Not Complete, Not Packed
			nColor = RGB( 255,128,64 ) &&ORANGE
			*Packing
			
		CASE tmpSO.prcp AND !tmpSO.prcd 
			*Not Cancelled, Not Complete, Not Packed
			nColor = RGB( 255, 255, 128 ) &&YELLOW
			*In Progress
			
		CASE tmpSO.Prc > 0
			*Has Process
			nColor = RGB( 128, 255, 255 ) &&Lt Blue
			
		OTHERWISE
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		*	
		*	nColor = RGB( 128, 128, 128 )  &&Grey
		*	nColor = RGB( 255,128,64 ) &&ORANGE
		*	nColor = RGB( 255, 255, 128 ) &&YELLOW
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_frmchoosepoitem_grid		&& Fomr frmChoosePOitem
		PRIVATE nColor
		*DynBC_frmChoosePOitem_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		CASE tmpPOitems.cancelled
			nColor = RGB( 255, 0, 0 ) &&RED	
		CASE tmpPOitems.delivered
			nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

