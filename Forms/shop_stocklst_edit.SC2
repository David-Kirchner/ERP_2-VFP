			ThisFormset.frmChooseWO.Visible = .T.
			ThisFormset.frmChooseWO.grdOpenWO.SetFocus()
		ENDIF
		
		***********
		IF USED("tmpSerBase")
			USE IN tmpSerBase
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ServerProperty('MachineName') AS [Server] ,DB_NAME() AS [Database]"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSerBase')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSerBase')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSerBase")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSerBase")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle,nSQLEXEC, 'tmpSerBase')
				 MESSAGEBOX("Could not'SELECT serverproperty('MachineName')",16,"SQL Error")
			 	RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED("tmpSerBase")
				IF VARTYPE(tmpSerBase.Server) = "C"
					ThisFormset.frmChooseWO.lblServer.Caption = tmpSerBase.Server
					ThisFormset.frmChooseWO.lblDatabase.Caption = tmpSerBase.Database
				ELSE
					ThisFormset.frmChooseWO.lblServer.Caption = ' '
					ThisFormset.frmChooseWO.lblDatabase.Caption = ' ' 
				ENDIF
				USE IN tmpSerBase			
			ELSE
				ThisFormset.frmChooseWO.lblServer.Caption = ' '
				ThisFormset.frmChooseWO.lblDatabase.Caption = ' ' 
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE completeorder
		
