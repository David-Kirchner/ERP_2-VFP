	PROCEDURE show_selected_inv
		PARAMETERS pWhat
		*ThisFormSet.Show_Selected_INV()
		
		PRIVATE cWhat
		cWhat = ''
		IF VARTYPE(pWhat) = "C"
			cWhat = pWhat		&&"FULL_STK_PRC" or "FULL_STK"
		ENDIF
		
		*ThisFormSet.Show_Selected_INV()
		
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.TBL.Value,'TBL',1)
		
		
		IF NOT USED('tmpSO')
			MESSAGEBOX("Need 'tmpSO' to continue"+CHR(13)+"the 'tmpSO' table does not exists",0+16,"No SO/WO !")
			TrackError("Need tmpSO to continue"+CHR(13)+"the tmpSO table does not exists","the tmpSO table does not exists", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			MESSAGEBOX("StockLst_SQL did not recognize Table Name",0+16,"Bad Initialization!")
			TrackError("StockLst_SQL did not recognize Table Name cTBL","StockLst_SQL does not recognize Table Name '"+cTBL+"'.",PROGRAM(),LINENO(1) )
			RETURN .F.
		ENDIF
		
		PRIVATE nTop, nLeft
		IF ThisFormSet.frmStockLstProcesses.Visible
			nTop = ThisFormSet.frmStockLstProcesses.Top + ThisFormSet.frmStockLstProcesses.Height + 20
			nLeft = ThisFormSet.frmStockLstProcesses.Left
		ELSE
			nTop = ThisFormSet.frmShop_StockLst_Edit.Top + ThisFormSet.frmShop_StockLst_Edit.Height + 20
			nLeft = ThisFormSet.frmShop_StockLst_Edit.Left
		ENDIF
		
		IF ThisFormSet.frmSelectedStock.Top < nTop
			ThisFormSet.frmSelectedStock.Top = nTop
		ENDIF
		IF ThisFormSet.frmSelectedStock.Left > nLeft + 100
			ThisFormSet.frmSelectedStock.Left = nLeft
		ENDIF
		IF ThisFormSet.frmSelectedStock.Left < 0
			ThisFormSet.frmSelectedStock.Left = nLeft
		ENDIF
		
		*********************
		
		PRIVATE nID_Detail, nID, nID_Detail_P
		nID_Detail = PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail.Value,'ID_Detail',-3)
		nID	= GetIDfromID_Detail( nID_Detail, cTBL, ThisFormSet.nConnHandle)
		nID_Detail_P = PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		
		*!*	*Done in Show_StockLst_SQL if Called with "FULL_STK_PRC"
		*!*	IF nID_Detail_P > 0
		*!*		cDesc_ID_Detail_P = get_Comment_ID_Detail_Process(nID_Detail_P, cTBL, ThisFormSet.nConnHandle)
		*!*	ENDIF
		*!*	ThisFormSet.frmStockLst_SQL.txtSel_Desc.Value = cDesc_ID_Detail_P 
		
		
		ThisFormSet.frmSelectedStock.lblTBL.Caption = cTBL
		ThisFormSet.frmSelectedStock.lblID.Caption = STR(nID)
		ThisFormSet.frmSelectedStock.lblID_Detail.Caption = STR(nID_Detail)
		ThisFormSet.frmSelectedStock.lbl_ID_Detail_P.Caption = STR(nID_Detail_P)
		
		ThisFormSet.frmSelectedStock.Visible = .T.
		
		*SOitem WO PO_item 
		ThisFormSet.frmSelectedStock.lblSOitem.Caption	= PrepareSQLtxt(tmpSO.SOitem,'SOitem',10,.T.)
		ThisFormSet.frmSelectedStock.lblWO.Caption		= STR(PrepareSQLnum(tmpSO.WO,'WO',-3))
		ThisFormSet.frmSelectedStock.lblPO_Item.Caption	= PrepareSQLtxt(tmpSO.POitem,'POitem',12)
		
		
		PRIVATE cStockM, cStockD, cSold
		cStockM = ''
		cStockD = ''
		cSold   = ''
		
		*cStockM = get_Info_Lst_Master(nID,cTBL,ThisFormSet.nConnHandle)
		*ThisFormSet.frmSelectedStock.txtStockM.Value = cStockM
		
		*cStockD = get_Description_ID_Detail(nID_Detail,cTBL,ThisFormSet.nConnHandle,.F.,.T.)
		*ThisFormSet.frmSelectedStock.txtStockD.Value = cStockD
		
		*******************************************************
		*SOLD
		PRIVATE cAlloy, cForm, nThck, cCC, cCL
		cAlloy = PrepareSQLtxt(tmpSO.Alloy,'Alloy',12,.T.)
		cForm  = Proper_Form(PrepareSQLtxt(tmpSO.Form,'Form',2,.T.))
		cCC	   = PrepareSQLtxt(tmpSO.CC,'CC',1)
		cCL	   = PrepareSQLtxt(tmpSO.CL,'CL',1)
		
		PRIVATE nThck,nSz2,nSz3,nPC,nWeight,lRL
		nThck	= PrepareSQLnum(tmpSO.Thck,'Thck',9,3) &&nThck	= PrepareSQLnum(tmpSO.Dim1,'Thck',9,3)
		nSz2	= PrepareSQLnum(tmpSO.Sz2,'Sz2',9,3)	&&nSz2	= PrepareSQLnum(tmpSO.Dim2,'Sz2',9,3)
		nSz3	= PrepareSQLnum(tmpSO.Sz3,'Sz3',9,3)	&&nSz3	= PrepareSQLnum(tmpSO.Dim3,'Sz3',9,3)
		nPC		= PrepareSQLnum(tmpSO.PC,'PC',-3)
		nWeight	= PrepareSQLnum(tmpSO.Weight,'Weight',7,1)
		lRL		= PrepareSQLlogic(tmpSO.RandLen,'RandLen',.F.)
		
		PRIVATE nQTYSold, cDescriptSold
		nQTYSold = PrepareSQLnum(tmpSO.S_QTY,'S_QTY',-5)
		cDescriptSold = PrepareSQLtxt(tmpSO.Descript2,'Descript',50,.F.,.T.)
		
		ThisFormSet.frmSelectedStock.txtAlloySold.Value = cAlloy
		ThisFormSet.frmSelectedStock.txtFormSold.Value = cForm  
		ThisFormSet.frmSelectedStock.txtCCSold.Value = cCC
		ThisFormSet.frmSelectedStock.txtCLSold.Value = cCL
		ThisFormSet.frmSelectedStock.txtPCSSold.Value = nPC
		ThisFormSet.frmSelectedStock.txtDescriptSold.Value = cDescriptSold
		ThisFormSet.frmSelectedStock.txtLBSSold.Value = nWeight
		ThisFormSet.frmSelectedStock.txtQTYSold.Value = nQTYSold
		
		*!*	PRIVATE cSold
		*!*	cSold = cAlloy +"  Frm_"+cForm +" CC_"+ cCC
		*!*	IF NOT EMPTY(cCL)
		*!*		cSold  = cSold  +"  CL_"+ cCL
		*!*	ENDIF
		
		*!*	PRIVATE cDescript
		*!*	cDescript = ALLTRIM(DescriptionMetricReport(nPC, cForm, nThck, nSZ2, nSZ3, nWeight, lRL, .F., '', '', '', ThisFormSet.nConnHandle))
		*!*	cSold  = cSold  +" " + cDescript 	
		*!*	ThisFormSet.frmSelectedStock.txtSold.Value = cSold
		
		
		
		*******************************************************
		*Stock Master
		PRIVATE cFormM
		cFormM = ''
		
		*RESET*
		*ThisFormSet.frmSelectedStock.txtAlloyM.Value = ''
		*ThisFormSet.frmSelectedStock.txtFormM.Value = ''
		*ThisFormSet.frmSelectedStock.txtCCM.Value = ''
		*ThisFormSet.frmSelectedStock.txtCLM.Value = ''
		*ThisFormSet.frmSelectedStock.txtThckM.Value = ''
		ThisFormSet.frmSelectedStock.txtHeat.Value = 'Not Found'
		ThisFormSet.frmSelectedStock.txtLot.Value = ''
		ThisFormSet.frmSelectedStock.txtCond.Value = ''
		ThisFormSet.frmSelectedStock.txtLBSM.Value = ''
		ThisFormSet.frmSelectedStock.txtQTYM.Value = ''
		
		IF USED("tmpINVMaster")
			USE IN tmpINVMaster
		ENDIF
		SELECT 0
		
		DO CASE
		CASE cTBL = "S"
			cSQL = "SELECT Heat,Lot,Cond,mWeight,mS_QTY FROM dbo.StockLst_Master WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQL = "SELECT Heat,Lot,Cond,mWeight,mS_QTY FROM dbo.BrokerLst_Master WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQL = "SELECT Heat,Lot,Cond,mWeight,mS_QTY FROM dbo.WIPLst_Master WITH(NOLOCK) "
		ENDCASE
		cSQL = cSQL + " WHERE ID="+STR(nID)
		
		nSQLEXEC = SQLEXEC(THISFORMset.nConnHandle, cSQL, 'tmpINVMaster' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpINVMaster' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVMaster")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVMaster")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpINVMaster')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED('tmpINVMaster')
				IF RECCOUNT('tmpINVMaster') > 0
					
					*ThisFormSet.frmSelectedStock.txtAlloyM.Value= PrepareSQLtxt(tmpINVMaster.Alloy,'Alloy',12,.T.)
					*cFormM = PrepareSQLtxt(tmpINVMaster.Form,'Form',2,.T.)
					*ThisFormSet.frmSelectedStock.txtFormM.Value	= cFormM
					*ThisFormSet.frmSelectedStock.txtCCM.Value	= PrepareSQLtxt(tmpINVMaster.CC,'CC',1)
					*ThisFormSet.frmSelectedStock.txtCLM.Value	= PrepareSQLtxt(tmpINVMaster.CL,'CL',1)
		
					*ThisFormSet.frmSelectedStock.txtThckM.Value	= PrepareSQLnum(tmpINVMaster.Size,'Thck',9,3)
					
					ThisFormSet.frmSelectedStock.txtHeat.Value	= PrepareSQLtxt(tmpINVMaster.Heat,'Heat',50)	
					ThisFormSet.frmSelectedStock.txtLot.Value	= PrepareSQLtxt(tmpINVMaster.Lot,'Lot',10)	
					ThisFormSet.frmSelectedStock.txtCond.Value	= PrepareSQLtxt(tmpINVMaster.Cond,'Cond',50)
					
					ThisFormSet.frmSelectedStock.txtLBSM.Value	= PrepareSQLnum(tmpINVMaster.MWeight,'Weight',7,1)
					ThisFormSet.frmSelectedStock.txtQTYM.Value	= PrepareSQLnum(tmpINVMaster.mS_QTY,'QTY',9,1)			
					
				ENDIF
				USE IN tmpINVMaster
			ENDIF
		ENDIF
		
		
		*******************************************************
		*Stock Detail
		PRIVATE nDim1, nDim2, nDim3, nS_QTY
		
		nDim1 = 0
		nDim2 = 0
		nDim3 = 0
		nS_QTY = 0
		
		*RESET*
		ThisFormSet.frmSelectedStock.txtPCSD.Value = ''
		ThisFormSet.frmSelectedStock.txtDescriptD.Value = 'Not Found'
		ThisFormSet.frmSelectedStock.txtLBSD.Value = ''
		ThisFormSet.frmSelectedStock.txtQTYD.Value = ''
		
		IF USED("tmpINVDetail")
			USE IN tmpINVDetail
		ENDIF
		SELECT 0
		
		DO CASE
		CASE cTBL = "S"
			cSQL = "SELECT * FROM dbo.StockLst_Detail WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQL = "SELECT * FROM dbo.BrokerLst_Detail WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQL = "SELECT * FROM dbo.WIPLst_Detail WITH(NOLOCK) "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail ="+STR(nID_Detail)
		
		nSQLEXEC = SQLEXEC(THISFORMset.nConnHandle, cSQL, 'tmpINVDetail' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpINVDetail' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpINVDetail')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED('tmpINVDetail')
				IF RECCOUNT('tmpINVDetail') > 0
		
					nDim1	= PrepareSQLnum(tmpINVDetail.Dim1,'Dim1',10,4)
					nDim2 	= PrepareSQLnum(tmpINVDetail.Dim2,'Dim2',9,3)
					nDim3	= PrepareSQLnum(tmpINVDetail.Dim3,'Dim3',9,3)
					nS_QTY	= PrepareSQLnum(tmpINVDetail.S_QTY,'QTY',9,1)
					
					ThisFormSet.frmSelectedStock.txtPCSD.Value = PrepareSQLnum(tmpINVDetail.PC,'PC',-3)
					
					ThisFormSet.frmSelectedStock.txtLBSD.Value = PrepareSQLnum(tmpINVDetail.Weight,'Weight',7,1)
					
					ThisFormSet.frmSelectedStock.txtQTYD.Value = nS_QTY
					ThisFormSet.frmSelectedStock.txtDescriptD.Value = ItemDescription(cFormM, nDIM1, nDIM2, nDIM3, nS_QTY, .F.)
				
				ENDIF
				USE IN tmpINVDetail
			ENDIF
		ENDIF
		
		*********************
		
		
		*ThisFormSet.frmSelectedStock.cmdHideDone.SetFocus
		IF cWhat = "FULL_STK_PRC" OR cWhat = "FULL_STK" 
			*ThisFormset.Show_StockLst_SQL("BROWSE")	&&For Wayne Roe.  He needs both windows.
			ThisFormset.Show_StockLst_SQL("BROWSE")
		ENDIF
		
		RETURN .T.
		
		
	ENDPROC

	PROCEDURE show_stocklst_sql
		PARAMETERS pWhat
		*ThisFormset.Show_StockLst_SQL()	
		**Replaced DO FORM Forms\StockLst_SQL_Quotes 
		*use StockLst_SQL_modal now
		
		IF VARTYPE(pWhat)!="C"
			pWhat = ''		&&BROWSE or SELECT
		ENDIF
		
		PRIVATE cTBL
		*-- This only works if tmpSO has data and the tmpProcess has data and the form has data --
		cTBL = PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.TBL.Value,'TBL',1)
		
		IF NOT USED('tmpSO')
			MESSAGEBOX("Need 'tmpSO' to continue"+CHR(13)+"the 'tmpSO' table does not exists",0+16,"No SO/WO !")
			TrackError("Need tmpSO to continue"+CHR(13)+"the tmpSO table does not exists","the tmpSO table does not exists", PROGRAM(), LINENO(1))
			RETURN .F.
		ELSE
			IF RECCOUNT('tmpSO') = 0 OR LEN(cTBL)=0
				cTBL = "S"
				*User is checking on Stock, not starting an Stock Edit
			ENDIF
		ENDIF
		
		IF LEN(cTBL) = 0
		*	cTBL = PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.TBL,'TBL',1)
			cTBL = PrepareSQLtxt(ThisFormSet.cTBL,'TBL',1)
		ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			WAIT WINDOW "Defaulting to Stock List table " TIMEOUT 2
			cTBL = "S"
		ENDIF
		
		
		PRIVATE nID_Detail, nID, nID_Detail_P, cDesc_ID_Detail_P 
		nID_Detail = PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail.Value,'ID_Detail',-3)
		nID	= GetIDfromID_Detail( nID_Detail, cTBL, ThisFormSet.nConnHandle)
		nID_Detail_P = PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		cDesc_ID_Detail_P = ""
		
		IF nID_Detail_P > 0
			*SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
			cDesc_ID_Detail_P = get_Comment_ID_Detail_Process(nID_Detail_P, cTBL, ThisFormSet.nConnHandle)
			IF LEN(cDesc_ID_Detail_P) = 0
				cDesc_ID_Detail_P = "No Process Data"	
			ENDIF
		ELSE
			cDesc_ID_Detail_P = "No Process Data"
		ENDIF
		
		ThisFormSet.frmStockLst_SQL.Visible = .T.
		ThisFormSet.frmStockLst_SQL.txtSel_Desc.Value = cDesc_ID_Detail_P 
		
		
		PRIVATE cSOitem, nSalesNum, nWO, lAllowSub, cPOitem
		cSOitem		= Proper_SO_item('')
		nSalesNum 	= 0
		nWO			= 0
		nWO_Detail	= 0
		lAllowSub 	= .T.
		cPOitem		= Proper_PO_item('')
		
		IF USED('tmpProcess')		
			IF RECCOUNT('tmpProcess') > 0
				cSOitem		= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.SOitem1.Value,'SOitem',10)
				nSalesNum 	= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.SOitem1.Value,'SalesNum',-3)
				nWO			= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.WO1.Value,'WO',-3)
				nWO_Detail	= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.WO_Detail1.Value,'WO_Detail',-3)
				lAllowSub 	= PrepareSQLlogic(ThisFormSet.frmStockLstProcesses.AllowSub1.Value,'AllowSub',.F.)
				cPOitem		= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.PO_item1.Value,'POitem',12)
			ELSE
				IF RECNO('tmpSO') > 0
					cSOitem		= PrepareSQLtxt(tmpSO.SOitem,'SOitem',10)
					nSalesNum 	= PrepareSQLnum(tmpSO.SOitem,'SalesNum',-3)
					nWO			= PrepareSQLnum(tmpSO.WO,'WO',-3)
					nWO_Detail	= PrepareSQLnum(tmpSO.WO_Detail,'WO_Detail',-3)
					lAllowSub 	= .F.
					cPOitem		= PrepareSQLtxt(tmpSO.POitem,'POitem',12)
				ENDIF
			ENDIF
		ELSE
			IF RECNO('tmpSO') > 0
				cSOitem		= PrepareSQLtxt(tmpSO.SOitem,'SOitem',10)
				nSalesNum 	= PrepareSQLnum(tmpSO.SOitem,'SalesNum',-3)
				nWO			= PrepareSQLnum(tmpSO.WO,'WO',-3)
				nWO_Detail	= PrepareSQLnum(tmpSO.WO_Detail,'WO_Detail',-3)
				lAllowSub 	= .F.
				cPOitem		= PrepareSQLtxt(tmpSO.POitem,'POitem',12)
			ENDIF
		ENDIF
		
		IF nID_Detail = 0 AND nWO > 0
			*why would nID_Detail be 0
			*-- it is 0 when selecting
		*	IF USED('StockLst_SQL')
		*		nID_Detail = ThisFormSet.frmStocklst_SQL.getBy_WO(nWO)
		*	ELSE
				nID_Detail = get_ID_Detail_with_WO(nWO, cTBL, ThisFormSet.nConnHandle)
		*	ENDIF
		ENDIF
		
		
		********
		PRIVATE cFunction 
		
		IF LEN(pWhat) = 0
			cFunction = "BROWSE"
			
			IF cSOitem != Proper_SO_item('') OR nWO > 0
				IF cSOitem <> Proper_SO_item('')
					cFunction = "SELECT"
				ENDIF
				IF nWO > 0
					cFunction = "SEL_WO"
				ENDIF
			ENDIF
		ELSE
			cFunction = pWhat
		ENDIF
		
		*******************************************
		*
		*Move most of this 'ThisFormSet.frmStocklst_SQL. work back into the Class instead of here.
		*
		*******************************************
		
		*!*	Set parameter variables in ThisFormSet.frmStocklst_SQL
		*!*
		
		PRIVATE cAlloy, cForm, nThck, cCC, cCL
		cAlloy = PrepareSQLtxt(tmpSO.Alloy,'Alloy',12,.T.)
		cForm  = Proper_Form(PrepareSQLtxt(tmpSO.Form,'Form',2,.T.))
		cCC	   = PrepareSQLtxt(tmpSO.CC,'CC',1)
		cCL	   = PrepareSQLtxt(tmpSO.CL,'CL',1)
		
		PRIVATE nThck,nSz2,nSz3,nPC,nWeight,lRL,nS_QTY
		nThck	= PrepareSQLnum(tmpSO.Thck,'Thck',9,3) &&nThck	= PrepareSQLnum(tmpSO.Dim1,'Thck',9,3)
		nSz2	= PrepareSQLnum(tmpSO.Sz2,'Sz2',9,3)	&&nSz2	= PrepareSQLnum(tmpSO.Dim2,'Sz2',9,3)
		nSz3	= PrepareSQLnum(tmpSO.Sz3,'Sz3',9,3)	&&nSz3	= PrepareSQLnum(tmpSO.Dim3,'Sz3',9,3)
		nPC		= PrepareSQLnum(tmpSO.PC,'PC',-3)
		nWeight	= PrepareSQLnum(tmpSO.Weight,'Weight',7,1)
		lRL		= PrepareSQLlogic(tmpSO.RandLen,'RandLen',.F.)
		nS_QTY	= PrepareSQLnum(tmpSO.S_QTY,'QTY',-5)
		
		PRIVATE nQTYSold, cDescriptSold
		nQTYSold = PrepareSQLnum(tmpSO.S_QTY,'S_QTY',-5)
		cDescriptSold = PrepareSQLtxt(tmpSO.Descript2,'Descript',50,.F.,.T.)
		
		ThisFormSet.frmStocklst_SQL.pAlloy = cAlloy 
		ThisFormSet.frmStocklst_SQL.pForm = cForm
		ThisFormSet.frmStocklst_SQL.pCC = cCC
		ThisFormSet.frmStocklst_SQL.cmbCC.Value = cCC
		ThisFormSet.frmStocklst_SQL.pCL = cCL
		ThisFormSet.frmStocklst_SQL.cmbCL.Value = cCL
		*************
		ThisFormSet.frmStocklst_SQL.lblSz1.Visible = .F.
		ThisFormSet.frmStocklst_SQL.lblSz1.Caption = ""
		ThisFormSet.frmStocklst_SQL.pPieces = nPc
		ThisFormSet.frmStocklst_SQL.pThck = nThck
		ThisFormSet.frmStocklst_SQL.lblSz1.Caption = ThisFormSet.frmStocklst_SQL.lblSz1.Caption + " X "+ALLTRIM(Remove0(nSz2,9,3))+'"'
		IF nSz3 > 0
			ThisFormSet.frmStocklst_SQL.lblSz1.Caption = ThisFormSet.frmStocklst_SQL.lblSz1.Caption + " X "+ALLTRIM(remove0(nSz3,9,3))+'"'
		ENDIF
		
		ThisFormSet.frmStocklst_SQL.pWeight = nWeight
		ThisFormSet.frmStocklst_SQL.pQTY 	= nS_QTY
		ThisFormSet.frmStocklst_SQL.pRandLen = lRL
		*!*	lMetric = .F.
		*!*	IF TYPE('pForm') = "C" AND TYPE('pThck') = "N" AND TYPE('pSz2') = "N" AND TYPE('pSz3') = "N"
		*!*		*Overwrite with ItemDescriptionMetric ThisFormSet.frmStocklst_SQL.pThck
		*!*		ThisFormSet.frmStocklst_SQL.ShowAlloyFormCC(pSz2, pSz3)
		*!*	ENDIF
		
		
		
		*******************************************
		
		*IF ThisFormSet.frmStocklst_SQL.cmdMark.Caption = "Select this Record"
		*	ThisFormSet.frmStocklst_SQL.cmdMark.Enabled=.T.
		*ELSE
		*	ThisFormSet.frmStocklst_SQL.cmdMark.Enabled=.F.
		*ENDIF
			
		*******************************************
		
		ThisFormSet.frmStocklst_SQL.pPOitem = PrepareSQLtxt(cPOitem,'PO_item',12)
		
		ThisFormSet.frmStocklst_SQL.txtSOItem.VALUE = cSOItem
		ThisFormSet.frmStocklst_SQL.pSOitem = cSOItem
		ThisFormSet.frmStocklst_SQL.pSOItem = cSOitem
		
		ThisFormSet.frmStocklst_SQL.pSalesNum = nSalesNum
		
		ThisFormSet.frmStocklst_SQL.nWO = nWO
		
		IF ThisFormSet.frmStocklst_SQL.nWO > 0
			ThisFormSet.frmStocklst_SQL.pShipDue = getWO_Detail_DueDate( ThisFormSet.frmStocklst_SQL.nWO, ThisFormSet.frmStocklst_SQL.nConnhandle )
		ELSE
			IF Proper_SO_item(cSOItem) != Proper_SO_item('')
				*ThisFormSet.frmStocklst_SQL.pShipDue = CTOD("  /  /  ")
				*Get SO Ship Due
				dShipDue = Get_From_Sales_SOitem (cSOitem, "ShipDue", ThisFormSet.nConnHandle )
		
				dShipDue = PrepareSQLDate(dShipDue,"ShipDue")
		
				ThisFormSet.frmStocklst_SQL.pShipDue = dShipDue 
			ELSE
				ThisFormSet.frmStocklst_SQL.pShipDue = CTOD("  /  /  ")
			ENDIF
		ENDIF
		
		*********************
		
		*!*		IF cFunction  = "BROWSE_ID_Detail" AND nID_Detail > 0
		*!*			IF ThisFormSet.frmStocklst_SQL.GoToID_Detail(nID_Detail, pSz2, pSz3)
		*!*			ENDIF
		*!*		ENDIF
		
		*!*		IF ThisFormSet.frmStocklst_SQL.pFunction = "SEL_WO"
		*!*			IF ThisFormSet.frmStocklst_SQL.nWO > 0
		*!*				*Look for an ID_Detail by WO
		*!*				nID_Detail = ThisFormSet.frmStocklst_SQL.getBy_WO(ThisFormSet.frmStocklst_SQL.nWO)
		*!*				IF nID_Detail = 0
		*!*					ThisFormSet.frmStocklst_SQL.Search('')
		*!*				ENDIF
		*!*			ENDIF
		*!*		ELSE 
		*!*			*NOT cFunction = "SEL_WO" "BROWSE_ID_Detail" "BROWSELot"
		*!*			*cFunction = "SELECT" "SEL_SS" "GET" "BROWSE" 
		*!*		ENDIF
		
		
		ThisFormSet.frmStocklst_SQL.cTBL = cTBL
		ThisFormSet.frmStocklst_SQL.Load_StockLst_SQL(cTBL)
		
		*******************************************
		ThisFormSet.frmStocklst_SQL.Visible = .T.
		IF nID_Detail > 0
			DO CASE 
			CASE cFunction == "BROWSE"
				ThisFormSet.frmStockLst_SQL.INIT_pWhat("BROWSE_ID_Detail")
				IF NOT ThisFormSet.frmStockLst_SQL.GoToID_Detail(nID_Detail, nSz2, nSz3 )
					ThisFormSet.frmStocklst_SQL.Search('')
				ENDIF
		
			OTHERWISE 
				ThisFormSet.frmStockLst_SQL.INIT_pWhat(cFunction)
				IF NOT ThisFormSet.frmStockLst_SQL.GoToID_Detail(nID_Detail, nSz2, nSz3 )
					ThisFormSet.frmStocklst_SQL.Search('')	
				ENDIF
			ENDCASE 
		ELSE
			ThisFormSet.frmStockLst_SQL.INIT_pWhat(cFunction)
			ThisFormSet.frmStocklst_SQL.Search('')
			
		
			*Options to send:
		*!*		CASE ThisForm.pFunction = "SELECT"
		*!*		*	ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
		*!*		CASE ThisForm.pFunction = "SEL_SS"
		*!*		*	ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
		*!*		CASE ThisForm.pFunction = "SEL_WO"
		*!*		*	ThisForm.cmdMark.Caption = "Mark Stock for this WorkOrder"
		*!*		CASE ThisForm.pFunction = "GET"
		*!*			*Get does not ADD a Select Process!!- only returns the Select ID_Detail
		*!*		CASE ThisForm.pFunction = "BROWSELot"  &&Comes from GFM_Log with Lot number
		*!*		CASE ThisForm.pFunction = "BROWSE_ID_Detail"  
		*!*		CASE ThisForm.pFunction == "BROWSE"
		*!*			ThisForm.cInqNumP)) > 2 "Mark as hold for Quote"
		
		ENDIF
		
		
		*******************************************	
		*IF ThisFormSet.frmStockLst_SQL.nWO > 0
		*	lOK = Is_ID_Detail_SELECTED_WO(StockLst_SQL.ID_Detail, ThisFormSet.frmStockLst_SQL.nWO, ThisFormSet.frmStockLst_SQL.cTBL, ThisFormSet.frmStockLst_SQL.nConnhandle )
		*ENDIF
		
		*now Done in Change StockLst()
		*!*	IF ThisFormSet.frmStockLst_SQL.pSOitem != Proper_SO_item('')
		*!*		IF Is_ID_Detail_SELECTED_SOitem(nID_Detail, ThisFormSet.frmStockLst_SQL.pSOitem, ThisFormSet.frmStockLst_SQL.cTBL, ThisFormSet.frmStockLst_SQL.nConnhandle )
		*!*			lMarkBlue = .T.
		*!*			WAIT WINDOW 'BLUE means this stock line is Selected for this Sales Order Item.' NOWAIT
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF ThisFormSet.frmStockLst_SQL.nWO > 0
		*!*		IF Is_ID_Detail_SELECTED_WO(nID_Detail, ThisFormSet.frmStockLst_SQL.nWO, ThisFormSet.frmStockLst_SQL.cTBL, ThisFormSet.frmStockLst_SQL.nConnhandle )
		*!*			WAIT WINDOW 'BLUE means this stock line is Selected for this Work Order.' NOWAIT
		*!*			lMarkBlue = .T.
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF lMarkBlue
		*!*		ThisFormSet.frmStockLst_SQL.txtDimensions.BackColor = RGB( 0,128,255 )  &&Blue
		*!*		ThisFormSet.frmStockLst_SQL.txtDimensions.DisabledBackColor = RGB( 0,128,255 )
		*!*	ELSE
		*!*		ThisFormSet.frmStockLst_SQL.txtDimensions.BackColor = RGB( 192,192,192 )
		*!*		ThisFormSet.frmStockLst_SQL.txtDimensions.DisabledBackColor = RGB( 192,192,192 )
		*!*	ENDIF
		
		
		*******************************************	
		
		*ThisFormSet.frmStocklst_SQL.grdStockLst.clmAlloy.SetFocus
		IF VARTYPE(ThisFormset.frmStocklst_SQL) != "O"
			TrackError("ThisFormset.frmStocklst_SQL not an Object!", "Lost Form!", Program(), LINENO(1))
		ELSE
			IF HavePermission('EditStockLst',.F.)
				ThisFormSet.frmStocklst_SQL.cmdMasterEdit.Visible = .T.
				ThisFormSet.frmStocklst_SQL.cmdDetailEdit.Visible = .T.
			ENDIF
		
			ThisFormSet.frmStocklst_SQL.grdStockLst.SetFocus
		ENDIF
		
		
	ENDPROC

	PROCEDURE stocklstprocesses		&& StockLst Processes
		PARAMETER pID_Detail, pType, pWhat
		*THISFORMSET.StockLstProcesses(pID_Detail, pType, pWhat)
		*pID_Detail,"ID_DETAIL","CORRECTION"
		*0,'',"SHOW"
		*nID_Detail, "ID_DETAIL", "INCOMING"
		*THISFORMSET.StockLstProcesses(nID_Detail, "ID_DETAIL", "SHOW")
		
		*Use THISFORMSET.Processes() to Just show the Process' on StockLst, NO "CORRECTION"
		
		PRIVATE cType, cWhat
		pID_Detail = PrepareSQLnum(pID_Detail,'ID_Detail',-3)
		cType	= UPPER(PrepareSQLtxt(pType,'Type',15))
		cWhat	= UPPER(PrepareSQLtxt(pWhat,'What',15))
		
		************************************************
		*
		* if the Shop StockLst Edit show a Process and this query cannot find the process, the the middle ID_Detail is missing
		* if the ID_Detail has been delete, the inner join fails, the process cannot show here
		*
		**************************************************
		
		THISFORMSET.frmStockLstProcesses.VISIBLE = .F.
		
		PRIVATE nID_Detail_Process, nID_Detail, lhaveID_Detail, nID_Detail_P 
		nID_Detail = 0
		lHaveID_Detail = .F.
		nID_Detail_P = 0
		
		IF pType == "ID_DETAIL"
			IF pID_Detail > 0
				nID_Detail = pID_Detail 
				lhaveID_Detail = .T.
			ELSE
				nID_Detail = 0
				lHaveID_Detail = .F.
			ENDIF
		ENDIF
		
		IF pType == "ID_DETAIL_P"
			IF pID_Detail > 0
				nID_Detail_P = pID_Detail 
				lhaveID_Detail = .T.
			ELSE
				nID_Detail_P = 0
				lHaveID_Detail = .F.
			ENDIF
			
			nID_Detail = PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail.Value,'ID_Detail',-3)
			IF nID_Detail > 0
				lhaveID_Detail = .T.
			ELSE
				lHaveID_Detail = .F.
			ENDIF	
			
		ENDIF
		
		IF NOT USED('tmpSO')
			MESSAGEBOX("Cannot Show Processes without a Sales Order or Work Order!",0+16,'No SO or WO!')
			RETURN .F.
		ENDIF
		
		PRIVATE cSOitem, nWO, cSQLp 
		cSOitem = Proper_SO_Item(tmpSO.SOitem)
		nWO = PrepareSQLnum(tmpSO.WO,'WO',-3)
		cSQLp = ''
		
		IF USED("tmpProcess")
			USE IN tmpProcess
		ENDIF
		
		IF cWhat = "CORRECTION"
			*a Process without an Order!
			IF nID_Detail > 0
				cSQLp = "SELECT P.*, 'S' AS Tbl"
				cSQLp = cSQLp +", M.Heat "
				cSQLp = cSQLp +" FROM dbo.StockLst_Process P WITH(NOLOCK) "
				cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
				cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
				cSQLp = cSQLp +" WHERE P.ID_Detail = "+ALLTRIM(STR(nID_Detail))+" AND P.Process_ID = 'CORRECTION' AND WO=0"
				IF nWO > 0
					cSQLp = cSQLp +" UNION "
					cSQLp = cSQLp + "SELECT P.*, 'S' AS Tbl"
					cSQLp = cSQLp +", M.Heat "
					cSQLp = cSQLp +" FROM dbo.StockLst_Process P WITH(NOLOCK) "
					cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
					cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
					cSQLp = cSQLp + " WHERE P.WO = "+ALLTRIM(STR(nWO))+" AND P.Process_ID = 'CORRECTION'"
				ENDIF
			ELSE
				IF nWO > 0
					cSQLp = "SELECT P.*, 'S' AS Tbl"
					cSQLp = cSQLp +", M.Heat "
					cSQLp = cSQLp +" FROM dbo.StockLst_Process P WITH(NOLOCK) "
					cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
					cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
					cSQLp = cSQLp +" WHERE P.WO = "+ALLTRIM(STR(nWO))+" AND P.Process_ID = 'CORRECTION'"
				ELSE
					IF MESSAGEBOX("Is this Order Item Complete?"+CHR(13)+"Answer Yes to Comple this Order item."+CHR(13)+"Answer No and Select stock to make a process!",4+64,"No Process found for Order")=6
						*Mark Order item as Complete
						ThisFormSet.MarkOrderComplete("WO",nWO)
					ENDIF
					RETURN .F.
		
				ENDIF
			ENDIF
		ELSE
			**************************************
			*cWhat = "SHOW"
			
			*StockSide
			IF Proper_SO_item(cSOitem)!= Proper_SO_item('')
				cSQLp = "SELECT P.*, 'S' AS Tbl"
				cSQLp = cSQLp +", M.Heat "
				cSQLp = cSQLp +" FROM dbo.StockLst_Process P WITH(NOLOCK) "
				cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
				cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
				cSQLp = cSQLp +" WHERE P.SOitem = dbo.f_ProperSOitem('" + cSOitem + "')"
			ELSE 
				cSQLp  = ""
			ENDIF
			
			IF nWO > 0
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = cSQLp + "SELECT P.*, 'S' AS Tbl"
				cSQLp = cSQLp +", M.Heat "
				cSQLp = cSQLp +" FROM dbo.StockLst_Process P WITH(NOLOCK) "
				cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
				cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
				cSQLp = cSQLp +" WHERE P.WO="+STR(nWO)
			ENDIF
			
			IF nID_Detail > 0
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = cSQLp + "SELECT P.*, 'S' AS Tbl"
				cSQLp = cSQLp +", M.Heat "
				cSQLp = cSQLp +" FROM dbo.StockLst_Process P WITH(NOLOCK) "
				cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
				cSQLp = cSQLp +" INNER JOIN dbo.StockLst_Master M ON D.ID = M.ID "
				cSQLp = cSQLp +" WHERE P.ID_Detail = "+ALLTRIM(STR(nID_Detail))
			ENDIF
			
			**************
			*Broker Side
			IF Proper_SO_item(cSOitem)!= Proper_SO_item('')
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = cSQLp +"SELECT P.*, 'B' AS Tbl"
				cSQLp = cSQLp +", ' ' AS Heat "
				cSQLp = cSQLp +" FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
				cSQLp = cSQLp +" WHERE P.SOitem = dbo.f_ProperSOitem('" + cSOitem + "')"
			ENDIF
			
			IF nWO > 0
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = cSQLp +"SELECT P.*, 'B' AS Tbl"
				cSQLp = cSQLp +", ' ' AS Heat "
				cSQLp = cSQLp +" FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
				cSQLp = cSQLp +" WHERE P.WO="+STR(nWO)
			ENDIF
			
			IF nID_Detail > 0
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = cSQLp +"SELECT P.*, 'B' AS Tbl"
				cSQLp = cSQLp +", ' ' AS Heat "
				cSQLp = cSQLp +" FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
				cSQLp = cSQLp +" WHERE P.ID_Detail = "+ALLTRIM(STR(nID_Detail))
			ENDIF
			
			**************
			*WIP
			IF nWO > 0
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = cSQLp +"SELECT P.*, 'W' AS Tbl"
				cSQLp = cSQLp +", M.Heat "
				cSQLp = cSQLp +" FROM dbo.WIPLst_Process P WITH(NOLOCK) "
				cSQLp = cSQLp +" INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
				cSQLp = cSQLp +" INNER JOIN dbo.WIPLst_Master M ON D.ID = M.ID "
				cSQLp = cSQLp +" WHERE P.WO="+STR(nWO)
			ENDIF
		
			*DirectShip
			*	IF NOT EMPTY(cSQLp)
			*		cSQLp = cSQLp +" UNION "	
			*	ENDIF
			*	cSQLp = cSQLp +"SELECT *, 'D' AS Tbl FROM  WHERE 0>0 "
			
			*****************
			*Order By
			IF NOT EMPTY(cSQLp)
				cSQLp = cSQLp +" ORDER BY Tbl DESC "
			ENDIF
		
			********
		ENDIF
		
		*This is a common 'Bad SQL Connetion' initiation point
		ThisFormSet.nConnHandle = CheckSQLConnection(ThisFormSet.nConnHandle)
		
		SELECT 0
		nSQLEXEC = SQLEXEC( THISFORMSET.nConnHandle, cSQLp, 'tmpProcess' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLp, 'tmpProcess' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLp, "tmpProcess")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLp, "tmpProcess")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			IF NOT SQLEXECError( cSQLp, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess' )
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLp )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED('tmpProcess')
				IF RECCOUNT('tmpProcess') > 0
					SELECT tmpProcess
					IF nID_Detail_P > 0
						LOCATE FOR ID_Detail_Process = nID_Detail_P 
						IF NOT FOUND('tmpProcess')
							GO TOP
						ENDIF
					ENDIF
					
					*SELECT tmpProcess
					nID_Detail_Process = PrepareSQLnum(tmpProcess.ID_Detail_Process,'ID_Detail_Process',-3)
		
					ThisFormSet.Stocklst_ID_Detail	= tmpProcess.ID_Detail
					ThisFormSet.StockLst_TBL		= tmpProcess.TBL
					ThisFormSet.ID_Detail_Process	= tmpProcess.ID_Detail_Process
					ThisFormSet.Stocklst_ID			= Get_ID_with_ID_Detail(tmpProcess.ID_Detail, tmpProcess.TBL, ThisFormSet.nConnHandle)
					ThisFormSet.Tbl_Process 		= tmpProcess.TBL
					
					IF !ThisFormSet.Check_ID_Detail_Process()
						*ThisFormSet.ID_Detail_Process was not found
						MESSAGEBOX("No Process Found"+CHR(13)+"Select stock to make a process!",64,"No Process")
						RETURN .F.
					ENDIF
				ELSE
					*No Process records found
					IF PrepareSQLnum(tmpSO.Prc,'Prc',-3) > 0
						*RefreshSO() found it!
						*TrackError("frmShop_StockLst_Edit.StockLstProcess()"+CHR(13)+"Did found a Process!"+CHR(13)+"-- Probable lost the Detail or Master between Process"+CHR(13)+CHR(10)+cSQLp,"Did not find StockLst Process", PROGRAM(), LINENO(1))
						
						** situation. worker chooses a different stock (Process) -- with new ID_Detail
						** the replacement stock still needs to be Selected!
						
					ENDIF		
					MESSAGEBOX("No Process Found"+CHR(13)+"Select stock to make a process!",64,"No Process")
					RETURN .F.
				ENDIF	
				**nID_Detail is Private localy, but overloaded
			ELSE
		*!*			*TRY DirectShip
		*!*			PRIVATE lFoundDirectShip
		*!*			lFoundDirectShip = .F.
		*!*			
		*!*			IF USED('cntdShip')
		*!*				USE IN cntdShip
		*!*			ENDIF
		*!*			
		*!*			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Sales S "
		*!*			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+SOitem+"')"
		*!*			cSQL = cSQL + " AND dShip = 1 "
		*!*			
		*!*			SELECT 0
		*!*			nSQLEXEC = SQLEXEC( THISFORMSET.nConnHandle, cSQL, 'cntdShip' )
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'cntdShip' )
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProcess")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpProcess")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 	
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntdShip' )
		*!*			ELSE
		*!*				IF USED('cntdShip')
		*!*					IF RECCOUNT('cntdShip') > 0
		*!*						IF cntdShip.CNTD > 0
		*!*							lFoundDirectShip = .T.			
		*!*						ENDIF
		*!*					ENDIF
		*!*					USE IN cntdShip
		*!*				ENDIF
		*!*			ENDIF
		*!*		
		*!*			IF lFoundDirectShip
		*!*				ThisformSet.Show_DirectShip(cSOitem)
		*!*				RETURN 
		*!*			ELSE
				MESSAGEBOX("No Process Found"+CHR(13)+"Select stock to make a process!",64,"No Process")
				RETURN .F.
		*!*			ENDIF
			ENDIF	
		ENDIF
		
		
		IF USED("tmpProcess")
			IF RECCOUNT("tmpProcess") > 0
				SELECT tmpProcess
				
				
				THISFORMSET.frmStockLstProcesses.VISIBLE = .T.
				
				ThisFormSet.RefreshStockLstProcesses()
				
				ThisFormSet.IsProcess_Of_Order()
				*ThisFormSet.frmStockLstProcesses.VISIBLE = .T.
				
				ThisFormSet.ID_Detail_Process = tmpProcess.ID_Detail_process
				ThisFormSet.Check_ID_Detail_Process() &&Does ThisFormSet.ID_Detail_Process exists in SQL table? 
				
				ThisFormSet.Tbl_Process = tmpProcess.Tbl
				
			ELSE  
				*No records
				*Check to see if done!
				IF tmpSO.Cmplt OR (!tmpSO.prcP AND tmpSO.prcD )
					IF MESSAGEBOX("No Process left for this SalesOrder Item"+CHR(13)+CHR(13)+;
					  "This SO item is marked as 'COMPLETE'"+CHR(13)+CHR(13)+;
					  "Do you want to 'ADD' a new process to this item?"+CHR(13)+CHR(13)+"If (Yes), find stock and click"+CHR(13)+"'Mark Current Record For This Order'",4+32+256,"No Process... Complete!") = 6
					  	
					  	IF VARTYPE(ThisFormSet.frmStockStatus) = "O"
							IF ThisFormSet.frmStockStatus.Visible 
								ThisFormSet.frmStockStatus.Visible = .F.
								ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
								ThisFormSet.frmSimiliarSales.Visible = .F.
							ENDIF
						ENDIF
						ThisFormset.frmShop_StockLst_Edit.cmdInv.Click
					ELSE
						*IF MESSAGEBOX("Do you still want try to see the StockLst now?",4+48,"This is not a Process for this SO.")=6
						*	*Show Stock
						*	ThisFormSet.frmStockLst.Visible = .T.
						*ELSE
						*	*Just Show Process'
						*	*THISFORMSET.Processes(pID_Detail)  &&cannot Show for 0
						*ENDIF
					ENDIF
				ELSE
					IF pID_Detail > 0
						IF MESSAGEBOX("No Stock Process found for this SO Item"+CHR(13)+;
						  "Select from StockLst, Mark to create a process! "+CHR(13)+" or just Double Click stock."+CHR(13)+;
						  "'Inventory Corrections' can be made to StockLst."+;
						  CHR(13)+CHR(13)+"Do you still want to TRY to see the StockLst process now?"+CHR(13)+;
						  "Answer No to start to make a stockLst process.",4+48,+;
						  "Select stock then create a process.") = 6
						  
						  *Show Process anyways
						  THISFORMSET.Processes(pID_Detail)
						  
						ELSE 
							IF VARTYPE(ThisFormSet.frmStockStatus) = "O" 
								IF ThisFormSet.frmStockStatus.Visible 
									ThisFormSet.frmStockStatus.Visible = .F.
									ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
									ThisFormSet.frmSimiliarSales.Visible = .F.
								ENDIF
							ENDIF
							ThisFormset.frmShop_StockLst_Edit.cmdInv.Click
						ENDIF
					ELSE  &&Not not ask when ID_Detail is 0
						MESSAGEBOX("No Process for this SO Item"+CHR(13)+;
						  "Select from StockLst, Mark to create a process! "+CHR(13)+" or just Double Click stock."+CHR(13)+;
						  "'Inventory Corrections' can be made to StockLst.",0+48,"Select stock then create a process.")
		
						IF VARTYPE(ThisFormSet.frmStockStatus) = "O"
							IF ThisFormSet.frmStockStatus.Visible 
								ThisFormSet.frmStockStatus.Visible = .F.
								ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
								ThisFormSet.frmSimiliarSales.Visible = .F.
							ENDIF
						ENDIF
						ThisFormset.frmShop_StockLst_Edit.cmdInv.Click
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE stocklst_process_del_correction
		PARAMETER pID, pID_Detail
		*ThisFormSet.StockLst_Process_DEL_Correction()
		
		PRIVATE nID_Detail_OLD, nStockLst_Detail_SOitem,cSOitem
		nID_Detail_OLD = 0
		nStockLst_Detail_SOitem = 0
		cSOitem = PrepareSQLtxt(tmpSO.SOitem,'SOitem',10)
		
		PRIVATE cSQLn, cSQLd, nSQLEXEC, nAns, cTBL, cTable
		DO CASE
		CASE ThisFormSet.StockLst_TBL = "B"
			cTBL = "B"
			cTable = "BrokerLst"
		CASE ThisFormSet.StockLst_TBL = "S"
			cTBL = "S"
			cTable = "StockLst "
		CASE ThisFormSet.StockLst_TBL = "W"
			cTBL = "W"
			cTable = "WIPLst "
		OTHERWISE
			MESSAGEBOX("StockLst_Process_DEL_Correction did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("StockLst_Process_DEL_Correction did not recognize Table Name","StockLst_Process_DEL_Correction did not recognize Table Name",PROGRAM(),LINENO(1))
			RETURN .F.	
		ENDCASE
		
		***********
		*check to see if a Correction Process is for this SOitem
		cSQLn = "SELECT COUNT(*) AS counted FROM "
		DO CASE
		CASE cTBL = "S"
			cSQLn = cSQLn + " dbo.StockLst_Process WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQLn = cSQLn + " dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQLn = cSQLn + " dbo.WIPLst_Process WITH(NOLOCK) "
		ENDCASE
		cSQLn = cSQLn + " WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+" AND Process_ID = 'CORRECTION'"
		IF USED("StockLst_Detail_Count")
			SELECT StockLst_Detail_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLn, "StockLst_Detail_Count")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQLn, "StockLst_Detail_Count")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQLn, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Detail_Count')
			*Just Create a new Process
			*THISFORMSET.Create_StockLst_Process(pID,pID_Detail,"",cTBL)
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLn )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF USED('StockLst_Detail_Count')
			IF StockLst_Detail_Count.Counted > 0
				IF pType = "CORRECTION"
					*Found a Correction Process
		
					nAns = MESSAGEBOX("The "+IIF(cTbl = "S",'StockLst',IIF(cTBL="B",'BrokerLst','WIPLst'))+" Detail has already been marked for a Correction Process."+CHR(13)+;
					"Do want to remove this Correction Process? (Y)"+CHR(13)+CHR(13)+;
					"Answer 'Yes' to remove this Correction Process."+CHR(13)+;
					"Answer 'No' to edit the Correction Process."+CHR(13)+;
					"or 'Cancel'.",3+32,"Found Correction Process.")
					
					IF nAns = 6 &&Yes
						*Remove old Process
						DO CASE
						CASE cTBL = "S"
							cSQLd = "DELETE FROM dbo.StockLst_Process  WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+" AND Process_ID = 'CORRECTION'"
						CASE cTBL = "B"
							cSQLd = "DELETE FROM dbo.BrokerLst_Process  WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+" AND Process_ID = 'CORRECTION'"
						CASE cTBL = "W"
							cSQLd = "DELETE FROM dbo.WIPLst_Process  WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+" AND Process_ID = 'CORRECTION'"
						ENDCASE
						
						nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQLd, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
		
						IF nSQLEXEC < 0
							*Could not Delete
							IF NOT SQLEXECError(cSQLd, ThisFormSet.nConnHandle, nSQLEXEC, '')
								RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLd )
							ELSE
								nSQLEXEC = 1
							ENDIF
						ENDIF
						IF nSQLEXEC > 0
							*Update History with 'SUBED'
							cSQLd = "UPDATE dbo.Ar_"+IIF(cTBL = "S","StockLst","BrokerLst")+"_Process_History SET [WHAT]='SUBED' WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+ " AND [What] = 'DELETE' "+" AND Process_ID = 'CORRECTION'"
							nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQLd, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
		
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQLd, ThisFormSet.nConnHandle, nSQLEXEC, '')
									RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQLd )
								ELSE
									nSQLEXEC = 1
								ENDIF
							ENDIF
							
							IF nSQLEXEC > 0
								THISFORMSET.frmStockLstProcesses.Visible = .F.
								THISFORMSET.frmModiProcess.Visible = .F.
								
								*ThisFormSet.RefreshTmpQuotes()
								ThisFormSet.RefreshSO()
								
								ThisFormSet.StockLst_ID_Detail = pID_Detail
								*ThisFormSet.RefreshStockLst("RELOAD")
							
								WAIT WINDOW "DELETED Correction process." NOWAIT
							ENDIF
						ENDIF
					ENDIF
					IF nAns = 7
						*Just Show Process
						THISFORMSET.StockLstProcesses(pID_Detail,"ID_Detail","CORRECTION")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE sumprocess
		*ThisFormSet.SumProcess()
		PRIVATE nID_DetailS_QTY, nSOS_QTY, nWOS_QTY
		nID_DetailS_QTY = 0
		nSOS_QTY = 0
		nWOS_QTY = 0
		
		PRIVATE nSOitemS_QTY, nSOitemQ_QTY, nSOiSelQTY, nWOQTY, nPartSelect_QTY 
		*nSOitemQTY
		nSOitemS_QTY = 0
		nSOitemQ_QTY = 0
		nSOiSelQTY = 0
		nWOQTY = 0
		nPartSelect_QTY = 0
		
		PRIVATE nID_Detail,cSOitem,nWO,nQTY, cTBL
		nID_Detail = PrepareSQLnum(ThisFormSet.frmModiProcess.ID_Detail1.Value,'ID_Detail',-3)
		cSOitem	= PrepareSQLtxt(ThisFormSet.frmModiProcess.SOitem1.Value,'SOitem',10)
		nWO =  PrepareSQLnum(ThisFormSet.frmModiProcess.WO1.Value,'WO',-3)
		*nWO_Detail =  PrepareSQLnum(ThisFormSet.frmModiProcess.WO_Detail1.Value,'WO_Detail',-3)
		nQTY = PrepareSQLnum(ThisFormSet.frmModiProcess.pQTY1.Value,'StockLst_QTY',-5)
		
		IF THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
			cTBL = "S"
		ELSE
			cTBL = "B"
		ENDIF
		
		
		***
		IF USED("cntStockQty")
			USE IN cntStockQty
		ENDIF
		
		DO CASE
		CASE cTBL = "S"
			cSQL = "SELECT S_QTY FROM dbo.StockLst_Detail WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQL = "SELECT S_QTY FROM dbo.BrokerLst_Detail WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQL = "SELECT S_QTY FROM dbo.WIPLst_Detail WITH(NOLOCK) "
		OTHERWISE
			MESSAGEBOX("SumProcess did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("SumProcess did not recognize Table Name","SumProcess did not recognize Table Name",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)+""
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			IF NOT SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED('cntStockQty')
				IF RECCOUNT('cntStockQty') > 0
					nID_DetailS_QTY = cntStockQty.S_QTY
				ENDIF
				USE IN cntStockQty
			ENDIF
		ENDIF
		
		***
		IF cSOitem	!= Proper_SO_Item('')
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
			
			cSQL = "SELECT SUM(D.S_QTY) AS S_QTY FROM "
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			OTHERWISE
				MESSAGEBOX("SumProcess did not recognize Table Name",0+16,"Aborting Save!")
				TrackError("SumProcessdid not recognize Table Name","SumProcessdid not recognize Table Name",PROGRAM(),LINENO(1))
				RETURN .F.
			ENDCASE
			cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				IF NOT SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nSOS_QTY = cntStockQty.S_QTY
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		IF nWO > 0
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
			
			cSQL = "SELECT SUM(D.S_QTY) AS S_QTY FROM "
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			OTHERWISE
				MESSAGEBOX("SumProcess did not recognize Table Name",0+16,"Aborting Save!")
				TrackError("SumProcess did not recognize Table Name","SumProcess did not recognize Table Name",PROGRAM(),LINENO(1))
				RETURN .F.
			ENDCASE
			
			IF cSOitem	!= Proper_SO_Item('')
				cSQL = cSQL + " WHERE NOT P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID = 'PARTSELECT' )"
			ELSE
				IF nWO > 0
					cSQL = cSQL + " WHERE P.WO = "+STR(nWO)+""
					cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID = 'PARTSELECT' )"
				ELSE
					cSQL =  'SELECT 0 AS S_QTY'
					*cSQL = cSQL + " WHERE Process_ID = 'SELECTED'"
				ENDIF
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				IF NOT SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nWOS_QTY = cntStockQty.S_QTY
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		IF cSOitem	!= Proper_SO_Item('')
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
		
			cSQL = "SELECT S_QTY,Quoted_QTY "
			cSQL = cSQL + " ,Quoted_P, Quoted_Total, Quoted_PU, Quoted_DollarTotal"
			cSQL = cSQL + " FROM dbo.Sales WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				IF NOT SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nSOitemS_QTY = cntStockQty.S_QTY
						nSOitemQ_QTY = cntStockQty.Quoted_QTY
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		
		
		***
		
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
			
			cSQL = "SELECT SUM(S_QTY) AS S_QTY FROM "
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail D WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
			OTHERWISE
				MESSAGEBOX("SumProcess did not recognize Table Name",0+16,"Aborting Save!")
				TrackError("SumProcess did not recognize Table Name","SumProcess did not recognize Table Name",PROGRAM(),LINENO(1))
				RETURN .F.
			ENDCASE
			
			cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID = 'PARTSELECT' )"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				IF NOT SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nSOiSelQTY = cntStockQty.S_QTY
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		IF nWO > 0
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
		
			cSQL = "SELECT sWeight FROM dbo.WorkOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO = "+STR(nWO)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				IF NOT SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				ELSE
					nSQLEXEC = 1
				ENDIF
			ENDIF
			IF nSQLEXEC > 0
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nWOQTY = cntStockQty.sWeight  &&here QTY is always the weight
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		***
		IF USED("cntStockQty")
			USE IN cntStockQty
		ENDIF
		
		cSQL = "SELECT QTY, ISNULL(Ordered_QTY,0) AS Ordered_QTY "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM  dbo.StockLst_Process WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM  dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM  dbo.WIPLst_Process WITH(NOLOCK) "
		OTHERWISE
			MESSAGEBOX("RefreshStockStatus did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("RefreshStockStatus did not recognize Table Name","RefreshStockStatus did not recognize Table Name",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDCASE
		
		IF nWO > 0	
			cSQL = cSQL + " WHERE WO = "+STR(nWO)+""
			cSQL = cSQL + " AND Process_ID = 'PARTSELECT'"
		ELSE
			IF cSOitem	!= Proper_SO_Item('')
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL + " AND Process_ID = 'PARTSELECT'"
			ELSE
				*No WO or SOitem
				cSQL = "SELECT 0 AS QTY"
			ENDIF
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntStockQty")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			IF NOT SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED('cntStockQty')
				IF RECCOUNT('cntStockQty') > 0
					nPartSelect_QTY = cntStockQty.QTY
				ENDIF
				
				USE IN cntStockQty
				
			ENDIF
		ENDIF
		
		***
		
		*nSOitemQ_QTY
		ThisFormSet.frmModiProcess.txtSOitemQTY.Value = nSOitemS_QTY
		ThisFormSet.frmModiProcess.txtSOS_QTY.Value = nSOS_QTY
		
		ThisformSet.frmModiProcess.txtWOQTY.Value = nWOQTY 
		ThisFormSet.frmModiProcess.txtWOS_QTY.Value = nWOS_QTY
		
		ThisFormSet.frmModiProcess.txtID_DetailS_QTY.Value = nID_DetailS_QTY
		
		IF nID_DetailS_QTY > nQTY 
			ThisFormSet.frmModiProcess.txtID_DetailS_QTY.DisabledForeColor = RGB(255,0,0)
		ENDIF
		
		ThisFormSet.frmModiProcess.txtPPbalance.Value = nPartSelect_QTY 
		
	ENDPROC

	PROCEDURE Unload
		IF ThisFormSet.CloseSales 
			IF USED("Sales")
				USE IN Sales
			ENDIF
		ENDIF
		
		IF USED("tmpProcess")
			USE IN tmpProcess 
		ENDIF
		IF USED("tmpSO")
			USE IN tmpSO
		ENDIF
		IF USED("tmpQuotes")
			USE IN tmpQuotes
		ENDIF
		
		
		= SQLDISCONNECT( ThisFormSet.nConnHandle )
		
		
	ENDPROC

