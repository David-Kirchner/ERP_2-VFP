		*************
		
		*Still here
		*just retrive a blank table of fields
		
		cSQL = "SELECT * FROM dbo.StartingStock WITH(NOLOCK) "
		cSQL = cSQL + " WHERE AllQuotes_ID = 0"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StartingStock')
		
