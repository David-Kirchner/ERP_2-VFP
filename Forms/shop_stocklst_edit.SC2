	PROCEDURE frmCerts.cmdIExplorer.Click
		PRIVATE cFileName
		cFileName = ThisForm.txtUJC.Value +"\"+ UPPER(ThisForm.lstCertImages.List(ThisForm.lstCertImages.ListIndex))
		
		WAIT WINDOW "Look for a blinking Internet Explorer to accept the file!" NOWAIT
		
		loIE = Createobject("Hyperlink")
		IF NOT VARTYPE(loIE) = "O"
			MESSAGEBOX("Could not open a web browser",16,"Cannot show")
			RETURN .F.
		ENDIF
		loIE.Visible = .T.
		loIE.Navigate("file://" + cFileName )
		RELEASE loIE
	ENDPROC

	PROCEDURE frmCerts.cmdNext.Click
		IF NOT EMPTY(gaCertImage(1))
			IF ThisFormSet.nRecollectCertPage >= ALEN(gaCertImage,1)
				WAIT WINDOW "At End" NOWAIT
			ELSE
				*ThisFormset.frmCerts.lstCertImages.Value = "ORIG0001.TIF"
				ThisFormSet.nRecollectCertPage = ThisFormSet.nRecollectCertPage + 1
				nCertImage = ThisFormSet.nRecollectCertPage
				
				cFileSelected = gaCertImage(ThisFormSet.nRecollectCertPage)
				cSelected = ThisForm.txtUJC.Value +"\"+ cFileSelected 
		
				ThisForm.image1.Picture = cSelected
				
				ThisForm.lstCertImages.Refresh
			ENDIF
		ELSE
			WAIT WINDOW "No File" NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE frmCerts.cmdOpen.Click
		PRIVATE cFileName
		cFileName = ThisForm.txtUJC.Value +"\"+ UPPER(ThisForm.lstCertImages.List(ThisForm.lstCertImages.ListIndex))
		
		Declare Integer ShellExecute In shell32.Dll ;
		   INTEGER hndWin, ;
		   STRING cAction, ;
		   STRING cFileName, ;
		   STRING cParams, ;
		   STRING cDir, ;
		   INTEGER nShowWin
		   
		   ShellExecute(0,"open",cFileName,"","",1)
		  
		*PRIVATE loHyperlink
		*loHyperlink = Createobject("internetexplorer.application")
		*loHyperlink.NavigateTo("file://" + cFileName )
		
	ENDPROC

	PROCEDURE frmCerts.cmdOpenDirectory.Click
		PRIVATE cSelected
		cSelected = ThisForm.txtUJC.Value +"\"
		
		RUN EXPLORER &cSelected
	ENDPROC

	PROCEDURE frmCerts.cmdPrev.Click
		IF ThisFormSet.nRecollectCertPage < 2
			WAIT WINDOW "At Begining" NOWAIT
		ELSE
			*ThisFormset.frmCerts.lstCertImages.Value = "ORIG0001.TIF"
			ThisFormSet.nRecollectCertPage = ThisFormSet.nRecollectCertPage - 1
			nCertImage = ThisFormSet.nRecollectCertPage
			
			cFileSelected = gaCertImage(ThisFormSet.nRecollectCertPage)
			cSelected = ThisForm.txtUJC.Value +"\"+ cFileSelected 
			
			ThisForm.image1.Picture = cSelected
			
			ThisForm.lstCertImages.Refresh
		ENDIF
	ENDPROC

	PROCEDURE frmCerts.cmdQuit.Click
		*ThisFormSet.Release
		*ThisForm.Release
		ThisForm.Visible = .F.
	ENDPROC

	PROCEDURE frmCerts.Init
		ThisForm.Height = 738
		ThisForm.Width = 933
	ENDPROC

	PROCEDURE frmCerts.lstCertImages.Click
		*unknown = This.Value
		
		cSelected = UPPER(THIS.List(THIS.ListIndex))
		cSelected = ThisForm.txtUJC.Value +"\"+ cSelected 
		
		THISFORM.image1.Picture = cSelected
		
		This.Value = THIS.ListIndex
		
		ThisFormSet.nRecollectCertPage = THIS.ListIndex
		
		*WAIT WINDOW cSelected NOWAIT
	ENDPROC

	PROCEDURE frmCerts.lstCertImages.InteractiveChange
		*wait window "Interactive Change" NOWAIT
	ENDPROC

	PROCEDURE frmCerts.Resize
		PRIVATE nDeltaH, nDeltaW
		
		nDeltaH = ThisForm.Height - 738
		nDeltaW = ThisForm.Width - 933
		
		ThisForm.image1.Height = 708 + nDeltaH 
		ThisForm.image1.Width = 804 + nDeltaW 
	ENDPROC

	PROCEDURE frmChoosePOitem.cmdCancel.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		
		*ThisForm.Release
		ThisForm.Visible = .F.
		
		
		ThisFormset.frmShop_StockLst_Edit.Visible = .T.
		ThisFormset.frmShop_StockLst_Edit.txtSO.SetFocus
		
	ENDPROC

	PROCEDURE frmChoosePOitem.cmdSelect.Click
		ThisFormSet.VisibleForms()
		PRIVATE lAlwaysOnTop
		lAlwaysOnTop = thisform.AlwaysOnTop
		IF lAlwaysOnTop
			thisform.AlwaysOnTop = .F.
		ENDIF
		
		PRIVATE cPOitem, cHeat
		cPOitem = PrepareSQLtxt(tmpPOitems.PoItem,'POitem',12)
		cHeat = PrepareSQLtxt(tmpPOitems.Heat,'Heat',50)
		
		DO FORM Forms\Receive_Edit WITH 'POitem',cPOitem,cHeat
		
		ThisFormSet.VisibleFormsReset()
		thisform.AlwaysOnTop = lAlwaysOnTop
		
		*!*	PRIVATE nItemPO, nPO, nDec
		*!*	nDec = SET("DECIMAL")
		*!*	SET DECIMAL TO 0
		*!*	nItemPO = VAL( RIGHT( cPOitem,2 ) )
		*!*	nPO		= VAL( LEFT(  cPOitem,9 ) )
		*!*	SET DECIMAL TO nDec
		
		*!*	*frmChoosePOitem
		*!*	IF nItemPO > 0 AND nPO > 0
		*!*		ThisFormset.frmReceiving.txtHpaPONum.Value = nPO
		*!*		ThisFormset.frmReceiving.txtHpaPOItem.Value = nItemPO
		*!*		ThisFormset.GetPoItemDetail(cPOitem)
		*!*	ENDIF
		
		*!*	ThisFormset.frmReceiving.Visible = .T.
		
		
		
	ENDPROC

