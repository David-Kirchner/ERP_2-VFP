	PROCEDURE frmStockLstProcesses.cmdStkProc_Correct.Click
		*ThisForm.Visible = .F.
		
		PRIVATE cWhatDo, nID_D_P, cSOitem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO,nInqNumP, nWO_Detail
		
		cWhatDo 	= "EDIT"
		nID_D_P		= PrepareSQLnum(tmpProcess.ID_Detail_Process,'ID_Detail_Process',-3)
		cSOitem		= PrepareSQLtxt(tmpProcess.SOitem,'SOitem',10)
		pSalesP		= ''	&&PrepareSQLtxt(tmpProcess.SalesPerson,'SalesPerson',20)
		pSalesDate	= CTOD('')	&&PrepareSQLDate(tmpProcess.StartDate,'StartDate')
		pLBS		= 0	&&PrepareSQLnum(tmpProcess.QTY,'QTY',-5)
		pQTY		= 0	&&PrepareSQLnum(tmpProcess.QTY,'QTY',-5)
		pComment	= ""
		pShipDue	= CTOD('')	&&PrepareSQLDate(tmpProcess.DueDate,'DueDate')
		pLst		= PrepareSQLtxt(tmpProcess.TBL,'TBL',1)
		pPoItem		= PrepareSQLtxt(tmpProcess.PO_Item,'POitem',12)
		pWO			= PrepareSQLnum(tmpProcess.WO,'WO',-3)
		nWO_Detail =  PrepareSQLnum(tmpProcess.WO_Detail,'WO_Detail',-3)
		nInqNumP 	= ''
		PRIVATE nID_Detail
		nID_Detail	= PrepareSQLnum(tmpProcess.ID_Detail,'ID_Detail',-3)
		
		*ThisForm.Visible = .F.
		ThisForm.AlwaysOnTop = .F.
		DO FORM Forms\Stocklst_Process WITH cWhatDo, nID_D_P, cSOitem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO, nID_Detail, nInqNumP, nWO_Detail
		*                                   cWhatDo, pID_D_P, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO, pID_Detail, pInqNumP, pWO_Detail
		ThisForm.AlwaysOnTop = .T.
		
		ThisFormSet.StockLstProcesses(nID_Detail, "ID_DETAIL", "SHOW")
		*refresh 'tmpProcess'
		
		*IF USED('tmpProcess')
		*ENDIF
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.LBLDUEDATE1.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(ThisForm.DueDATE1.Value)
			dDate1 = ThisForm.DueDATE1.Value 
		ELSE
			dDate1 = DATE()+10
		ENDIF
		ThisForm.AlwaysOnTop = .F.
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		ThisForm.AlwaysOnTop = .T.
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.DueDATE1.Value = dDate2
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.LBLSOITEM1.Click
		PRIVATE vcSOitem, cSOitem, nSO
		cSOitem = PrepareSQLtxt(This.Parent.SOITEM1.Value,'SOitem',10)
		nSO = VAL(cSOitem)
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM Forms\Select_SO-item WITH nSO TO vcSOitem
		ThisForm.AlwaysOnTop = .T.
		
		PRIVATE cText
		cText = ''
		IF VARTYPE(vcSOitem) = "C"
			IF NOT Proper_SO_item(vcSOitem) = Proper_SO_item('')
				vcSOitem = Proper_SO_item('')
			ENDIF
		ELSE
			vcSOitem = Proper_SO_item('')
		ENDIF
		IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
			IF Proper_SO_item(cSOitem) = Proper_SO_item(vcSOitem)
				*Already there.
			ELSE
				cText = "New SOitem="+ALLTRIM(vcSOitem)+"!"
				cText = cText +CHR(13)+"Old SOitem="+ALLTRIM(cSOitem)+"!"
				IF MESSAGEBOX("Do you wish to replace the SOitem?"+CHR(13)+cText,4+32,"Change SO data") = 6
					*needs Permission , verified.
					
					This.Parent.SOItem1.Value = vcSOitem
					
					TrackError("User wished to replace the SOitem. "+cText,"Info",PROGRAM(),LINENO(1))
					TrackMess( "User wished to replace the SOitem. "+cText )
				ENDIF
			ENDIF
		ENDIF
		
		IF vcSOitem = Proper_SO_item('')
			cText = "Old SOitem="+ALLTRIM(cSOitem)+"!"
			IF MESSAGEBOX("Do you wish to Erase this?"+CHR(13)+cText,4+32,"Remove SO data") = 6
				This.Parent.SOItem1.Value = ""
				
				TrackError("User wished to erase the SOitem. "+cText,"Info",PROGRAM(),LINENO(1))
				TrackMess( "User wished to erase the SOitem. "+cText )
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.LBLSTARTDATE1.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(ThisForm.STARTDATE1.Value)
			dDate1 = ThisForm.STARTDATE1.Value 
		ELSE
			dDate1 = DATE()+10
		ENDIF
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		ThisForm.AlwaysOnTop = .T.
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.STARTDATE1.Value = dDate2
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.lblWO.Click
		PRIVATE vnWO, nWO, nWO_Detail
		This.Parent
		nWO = PrepareSQLnum(This.Parent.WO1.Value,'WO',10)
		nWO_Detail = PrepareSQLnum(This.Parent.WO_Detail1.Value,'WO_Detail',10)
		PRIVATE cSOitem, cPOitem 
		cSOitem = PrepareSQLtxt(This.Parent.SOITEM1.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(This.Parent.PO_Item1.Value,'POitem',12)
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM Forms\Select_WorkOrder WITH cSOitem, cPOitem TO vnWO
		ThisForm.AlwaysOnTop = .T.
		
		PRIVATE cText
		cText = ''
		
		IF VARTYPE(vnWO) = "N"
			vcWO = 0
		ENDIF
		
		
		IF nWO = vnWO AND vnWO > 0
			*Already there.
		ELSE
			cText = "New WO="+ALLTRIM(STR(vnWO))+"!"
			cText = cText +CHR(13)+"Old WO="+ALLTRIM(STR(nWO))+"!"
			IF MESSAGEBOX("Do you wish to replace the WO?"+CHR(13)+cText,4+32,"Change WO data") = 6
				*needs Permission , verified.
				
				ThisForm.Parent.WO1.Value = vnWO
							
				TrackError("User wished to replace the WO. "+cText,"Info",PROGRAM(),LINENO(1))
				TrackMess( "User wished to replace the WO. "+cText )
		
			ENDIF
		ENDIF
		
		
		IF vnWO = 0
			cText = "Old WO="+ALLTRIM(STR(nWO))+"!"
			IF MESSAGEBOX("Do you wish to Remove this WO?"+CHR(13)+cText,4+32,"Remove WO data") = 6
				This.Parent.WO1.Value = 0
				
				TrackError("User wished to Remove the WO. "+cText,"Info",PROGRAM(),LINENO(1))
				TrackMess( "User wished to Remove the WO. "+cText )
		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.lblWOD.Click
		PRIVATE vcWO_Detail  
		vcWO_Detail = 0
		
		PRIVATE cSOitem, cPOitem, nWO, nWO_Detail
		cSOitem = PrepareSQLtxt(This.Parent.SOITEM1.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(This.Parent.PO_Item1.Value,'POitem',12)
		nWO		= PrepareSQLnum(This.Parent.WO1.Value,'WO',-3)
		nWO_Detail = PrepareSQLnum(This.Parent.WO_Detail1.Value,'WO_Detail',10)
		
		ThisForm.AlwaysOnTop = .F.
		DO FORM Forms\Select_WorkOrder_Detail WITH cSOitem, cPOitem, nWO TO vnWO_Detail
		ThisForm.AlwaysOnTop = .T.
		
		PRIVATE cText
		cText = ''
		
		IF VARTYPE(vnWO_Detail) = "N"
			vcWO_Detail = 0
		ENDIF
		
		
		IF nWO_Detail = vnWO_Detail AND vnWO_Detail > 0
			*Already there.
		ELSE
			cText = "New WO_Detail="+ALLTRIM(STR(vnWO_Detail))+"!"
			cText = cText +CHR(13)+"Old WO_Detail="+ALLTRIM(STR(nWO_Detail))+"!"
			IF MESSAGEBOX("Do you wish to replace the WO_Detail?"+CHR(13)+cText,4+32,"Change WO_Detail data") = 6
				*needs Permission , verified.
				
				ThisForm.Parent.WO_Detail1.Value = vnWO_Detail
							
				TrackError("User wished to replace the WO_Detail. "+cText,"Info",PROGRAM(),LINENO(1))
				TrackMess( "User wished to replace the WO_Detail. "+cText )
		
			ENDIF
		ENDIF
		
		
		IF vnWO_Detail = 0
			cText = "Old WO_Detail="+ALLTRIM(STR(nWO_Detail))+"!"
			IF MESSAGEBOX("Do you wish to Remove this WO_Detail?"+CHR(13)+cText,4+32,"Remove WO_Detail data") = 6
				This.Parent.WO_Detail1.Value = 0
				
				TrackError("User wished to Remove the WO_Detail. "+cText,"Info",PROGRAM(),LINENO(1))
				TrackMess( "User wished to Remove the WO_Detail. "+cText )
		
			ENDIF
		ENDIF
		
	ENDPROC

