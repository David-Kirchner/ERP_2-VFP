	PROCEDURE frmShop_StockLst_Edit.txtSO.Valid
		PRIVATE nSO
		nSO = This.Value
		
		IF TYPE("nSO") = "C"
			nSO = VAL(nSO)
			IF nSO > 0
				This.Value = nSO
			ENDIF
		ENDIF
		 
		IF TYPE("nSO") = "N"
			IF nSO > 0
				IF ThisFormSet.SalesNum != nSO 
					ThisFormSet.SalesNum = nSO
					ThisFormSet.nWorkOrder	= 0
					ThisForm.cmdStart.Click() && ThisFormSet.Check_Order_Status()
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmShop_StockLst_Edit.txtWO.Valid
		PRIVATE nWO
		nWO = This.Value
		
		IF TYPE("nWO") = "C"
			nWO = VAL(nWO)
			IF nWO > 0
				This.Value = nWO
			ENDIF
		ENDIF
		 
		IF TYPE("nWO") = "N"
			IF nWO > 0
				IF ThisFormSet.nWorkOrder != nWO 
					ThisFormSet.nWorkOrder	= nWO
					ThisFormSet.SalesNum	= 0
					ThisForm.cmdStart.Click()
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

