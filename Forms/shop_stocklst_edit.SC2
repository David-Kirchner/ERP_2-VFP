	PROCEDURE getpoform_poitem
		*!*	*ThisFormSet.getPOForm_POitem()
		
		*!*	*********** Get from PurchaseOrder
		*!*	*ThisForm.ReceivingID
		*!*	PRIVATE lCheckPO
		*!*	lCheckPO = .T.
		
		*!*	IF USED('tmpPO1')
		*!*		USE IN tmpPO1
		*!*	ENDIF
		*!*	SELECT 0
		
		*!*	cSQL = "SELECT Form, CC, Cond_Spec, StandSize, Pieces "
		*!*	cSQL = cSQL + " ,Thck, Sz2, Sz3, RandLen, Cert "
		*!*	cSQL = cSQL + " ,StockLst_P, Order_Qty, Pounds, StockLst_QTY "
		*!*	cSQL = cSQL + " ,dbo.f_BestDate( dbo.f_BestDate(Due_Min,Due_Max), dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max) ) AS PODueDate"
		*!*	cSQL = cSQL + " FROM dbo.PurchaseOrder "
		*!*	cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+ThisFormSet.POitem+"')"
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO1')
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPO1' )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO1' )
		*!*	ENDIF
		
		*!*	IF USED('tmpPO1')
		*!*		IF RECCOUNT('tmpPO1') > 0
		*!*			
		*!*			ThisFormset.frmRecvStock.cmbForm.Value	= tmpPO1.Form
		*!*	*		ThisFormset.frmRecvStock.FormCaptions()
		*!*			ThisFormSet.PORecvFormCaption()
		*!*			ThisFormset.frmRecvStock.cmbCC.Value	= tmpPO1.CC
		*!*			ThisFormset.frmRecvStock.Cond1.Value	= RIGHT(ALLTRIM(tmpPO1.Cond_Spec),20)
		*!*			ThisFormset.frmRecvStock.Size1.Value	= tmpPO1.StandSize
		*!*			ThisFormset.frmRecvStock.PC1.Value		= tmpPO1.Pieces
		*!*			ThisFormset.frmRecvStock.DIM11.Value	= tmpPO1.Thck
		*!*			ThisFormset.frmRecvStock.DIM21.Value	= tmpPO1.Sz2
		*!*			ThisFormset.frmRecvStock.DIM31.Value	= tmpPO1.Sz3
		*!*			ThisFormset.frmRecvStock.chkRandLen.Value	= IIF(tmpPO1.RandLen,1,0)
		*!*			ThisFormset.frmRecvStock.chkCert.Value	= IIF(tmpPO1.Cert,1,0)
		*!*			
		*!*			ThisFormset.frmRecvStock.CostValue1.Value 	= PrepareSQLnum(tmpPO1.StockLst_P,'StockLst_P',-5)
		*!*			ThisFormset.frmRecvStock.S_P.Value			= PrepareSQLnum(tmpPO1.StockLst_P,'StockLst_P',-5)
		*!*				
		*!*			ThisForm.Pounds1.Value 	= tmpPO1.Pounds
		*!*			ThisForm.S_QTY.Value 	= tmpPO1.StockLst_QTY	
		*!*			
		*!*			ThisFormset.frmRecvStock.PODueDate1.Value = tmpPO1.PODueDate
		*!*			IF GetPUfromForm(tmpPO1.Form, ThisFormSet.nConnHandle) = 1
		*!*				ThisFormset.frmRecvStock.Weight1.Value	= PrepareSQLnum(tmpPO1.StockLst_QTY,'StockLst_QTY',-5)
		*!*			ELSE
		*!*				*Object is like Fitting, Fastener or sold per foot like Pipe or Tubing.
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		USE IN tmpPO1
		*!*	ELSE
		*!*		MESSAGEBOX("PO data was not found!"+CHR(13)+"Please check data before saving"+CHR(13)+"Usually more data has been automatically filled in.",0,"Missing Data.")
		*!*	ENDIF
		*!*		
		
	ENDPROC

