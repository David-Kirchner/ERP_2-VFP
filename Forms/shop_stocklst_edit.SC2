	PROCEDURE checkquote_selectedstock
		PARAMETERS cSOitem
		*ThisFormSet.CheckQuote_SelectedStock(SOitem)
		PRIVATE lOK
		lOK =.T.
		
		*Check Alloy,Form in selected Stock to Quote
		PRIVATE cQAlloy, cQForm, cQCC, nQDim1
		cQAlloy	= ''
		cQForm	= ''
		cQCC	= ''
		nQDim1	= 0
		
		cSQL = "SELECT Alloy,Form,CC,Thck,Sz2,Sz3 "
		cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQAlloyFormCC")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQAlloyFormCC")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle ,nSQLEXEC, 'tmpQAlloyFormCC')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED('tmpQAlloyFormCC')
				IF RECCOUNT("tmpQAlloyFormCC") > 0
					cQAlloy	= tmpQAlloyFormCC.Alloy
					cQForm	= Proper_Form(tmpQAlloyFormCC.Form)
					cQCC	= tmpQAlloyFormCC.CC
					nQDim1	= tmpQAlloyFormCC.Thck
					
					
					PRIVATE cMess
					*reportConsumed_Ordered
					IF cQAlloy != cAlloy 
						cMess = "Consumed Stock does not match Sales Order:"+cSOitem+CHR(13)
						cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
						cMess = cMess + " Form Picked:"+cForm+"           Ordered:"+cQForm+CHR(13)
						cMess = cMess + " Condition Code  Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
						cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
						cMess = cMess + " Not Allowed to SAVE:Alloy"+CHR(13)
						TrackMess(cMess)
						MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE:Alloy")
						lOK =.F.
					ENDIF
		
					IF cForm = '40' AND cQForm = '80' 
						*Normally Form 80 is from Plate, but can be from bar!!!
						cQForm	= cForm
					ENDIF
					IF cForm = '10' AND cQForm = '80' 
						cQForm	= cForm
					ENDIF
					
					IF cQForm != cForm AND lOK =.T.
						cMess = "Consumed Stock does not match Sales Order:"+cSOitem+CHR(13)
						cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
						cMess = cMess + " Form Picked:"+cForm+"            Ordered:"+cQForm+CHR(13)
						cMess = cMess + " Condition Code  Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
						cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
						
						IF CheckSOforProduction(cSOitem,ThisFormSet.nConnHandle)
							*Production is allowed to change product form.
						ELSE
							IF NOT (cQForm = '0' OR cQForm = '21' OR cQForm = '22' OR cQForm = '51' OR cQForm = '52' OR cQForm = '53' OR cQForm = '80' OR  cQForm = '90' OR cQForm = '95' OR cQForm = '96' OR cQForm = '97' OR cQForm = '98' OR cQForm = '99' )	
								cMess = cMess + " Allowed to SAVE: Form"+CHR(13)
								TrackMess(cMess)
								TrackError(cMess,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
								MESSAGEBOX(cMess,16,"Allowed to SAVE: Form")
								lOK =.T.
							ELSE
								cMess = cMess + " Allowed to SAVE: Form"+CHR(13)
								TrackMess(cMess)
								*TrackError(cMess,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
								*MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE!")
								*lOK =.F.				
								TrackError(cMess,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
								MESSAGEBOX(cMess,16,"Allowed to SAVE!")
								lOK =.T.	
		
							ENDIF				
						ENDIF
					ENDIF
				ENDIF
				
				USE IN tmpQAlloyFormCC
				
		*		IF NOT lOK
		*			RETURN .F.
		*		ENDIF
			ENDIF
		ENDIF
		
		RETURN lOK
	ENDPROC

	PROCEDURE checkreceivingid_detail_process		&& Look for Receiving record before Modify Stock
		PARAMETER pnID_Detail_process, pnID_Detail, pcTBL, pcPO_Item, pWO
		*ThisFormSet.CheckReceivingID_Detail_process( nID_Detail_process, nID_Detail, cTbl, cPOItem, nWO )
		
		IF TYPE("pnID_Detail_process") != "N"
			RecordError(0,"No pnID_Detail_process " ,PROGRAM(),LINENO(1),"ThisFormSet.CheckReceivingID_Detail_process( nID_Detail_process, nID_Detail, cTbl, cPOItem, nWO)" )
			RETURN .F.
		ENDIF
		IF TYPE("pnID_Detail") != "N"
			RecordError(0,"No pnID_Detail_process " ,PROGRAM(),LINENO(1),"ThisFormSet.CheckReceivingID_Detail_process( nID_Detail_process, nID_Detail, cTbl, cPOItem, nWO)" )
			RETURN .F.
		ENDIF
		IF VARTYPE(pcTbl) != "C"
			TrackError("VARTYPE(pTBL)="+VARTYPE(cTbl),"Bad parameter pTbl- Possible Error",PROGRAM(),LINENO(1))
			RecordError(0,"No Tbl_process " ,PROGRAM(),LINENO(1),"ThisFormSet.CheckReceivingID_Detail_process( nID_Detail_process, nID_Detail, cTbl, cPOItem, nWO)" )
			RETURN .F.
		ENDIF
		PRIVATE nID_Detail_process, nID_Detail, cTBL
		nID_Detail_process = PrepareSQLnum(pnID_Detail_Process,'ID_Detail_Process',-3)
		nID_Detail = PrepareSQLnum(pnID_Detail,'ID_Detail',-3)
		cTBL = PrepareSQLtxt(pcTBL,'TBL',1)
		
		PRIVATE cPOitem, nWO
		cPOitem = PrepareSQLtxt(pcPO_Item,'POitem',12)
		nWO	= PrepareSQLnum(pWO,'WO',-3)
		
		
		pcPO_Item = cPOitem 
		
		
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(pcTBL,'TBL',1)
		
		PRIVATE cSQL
		*cSQL = "SELECT COUNT(*) AS [Counted] FROM "
		cSQL = "SELECT M.Heat, P.Process_ID, P.PO_Item, P.WO, P.ID_Detail_Process  FROM "
		
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process P WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		CASE cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process P WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		
		CASE cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process P WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		OTHERWISE
			MESSAGEBOX("CheckReceivingID_Detail_process did not recognize Table Name",0+16,"Aborting Save!")
			*TrackMess("CheckReceivingID_Detail_process did not recognize Table Name"+CHR(13)+" frmShop_StockLst_Edit:CheckReceivingID_Detail_process")
			TrackError("CheckReceivingID_Detail_process did not recognize Table Name","cTBL",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDCASE
		
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_process)	&&*ID_Detail_Process is the Primary Key
		cSQL = cSQL + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'NOT2HPA' OR Process_ID = 'PARTRECV' )"
		
		IF USED("StockLst_Process_Count")
			SELECT StockLst_Process_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Process_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'StockLst_Process_Count')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Process_Count")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Process_Count")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'StockLst_Process_Count')
				TrackError(cSQL,"Count Process",PROGRAM(),LINENO(1))
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		PRIVATE cHeat, cPO_item, nNew_WO
		cHeat = ''
		cPO_item = ''
		nNew_WO = 0
		*Check here to see if have to Add by ID_Detail
		*IF USED('StockLst_Process_Count')	
			IF RECCOUNT('StockLst_Process_Count') = 0
				*Look for INCOMING on ID_Detail
		
				cSQL = "SELECT M.Heat, P.Process_ID, P.PO_Item, P.WO, P.ID_Detail_Process FROM "
		
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
				CASE cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
		
				CASE cTBL = "W"
					cSQL = cSQL + " dbo.WIPLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
				OTHERWISE
					MESSAGEBOX("CheckReceivingID_Detail_process did not recognize Table Name",0+16,"Aborting Save!")
					*TrackMess("CheckReceivingID_Detail_process did not recognize Table Name"+CHR(13)+" frmShop_StockLst_Edit:CheckReceivingID_Detail_process")
					TrackError("CheckReceivingID_Detail_process did not recognize Table Name","cTBL",PROGRAM(),LINENO(1))
					RETURN .F.
				ENDCASE
		
				cSQL = cSQL + " WHERE P.ID_Detail = "+STR(pnID_Detail)	&&*ID_Detail_Process is the Primary Key
				cSQL = cSQL + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'NOT2HPA' OR Process_ID = 'PARTRECV' )"
				
		*!*			IF nWO > 0 OR cPOitem <> Proper_PO_item('')
		*!*				cSQL = cSQL + " AND ("
		*!*				cSQL = cSQL + " WO = "+STR(nWO)
		*!*				IF cPOitem <> Proper_PO_item('')
		*!*					cSQL = cSQL + " AND PO_item = '"+cPOitem+"'" +")"
		*!*				ELSE
		*!*					cSQL = cSQL + ")"
		*!*				ENDIF
		*!*			ELSE
		*!*				IF nWO > 0 
		*!*					cSQL = cSQL + " AND WO = "+STR(nWO)
		*!*				ENDIF
		*!*				IF cPOitem <> Proper_PO_item('')
		*!*					cSQL = cSQL + " AND PO_item = '"+cPOitem+"'"
		*!*				ENDIF
		*!*			ENDIF
				
				IF USED("StockLst_Process_Count")
					SELECT StockLst_Process_Count
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockLst_Process_Count')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'StockLst_Process_Count')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Process_Count")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockLst_Process_Count")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'StockLst_Process_Count')
						TrackError(cSQL,"Count Process",PROGRAM(),LINENO(1))
						RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
					ELSE
						nSQLEXEC = 1
					ENDIF
				ENDIF
				
			ENDIF
		*ENDIF
		
		
		**Ran SQL twice to find 'Incoming - 
		
		
		IF USED('StockLst_Process_Count')	
			IF RECCOUNT('StockLst_Process_Count') > 0
				
				cHeat=PrepareSQLtxt(StockLst_Process_Count.Heat,'Heat',50)
				cPOitem = PrepareSQLtxt(StockLst_Process_Count.PO_Item,'POitem',12)
				nNew_WO = PrepareSQLnum(StockLst_Process_Count.WO,'WO',-3)
				NewID_Detail_Process = PrepareSQLnum(StockLst_Process_Count.ID_Detail_Process,'ID_Detail_Process',-3)
				
			*- Must Receive first
				WAIT window "Receive in first!" NOWAIT
		
				*Start Receive Process...
				ThisFormSet.ModifyStockLstAfterReceive = .T.
				
				ThisFormSet.VisibleForms()
				ThisFormSet.frmStockLstProcesses.AlwaysOnTop = .F.
				
				IF pnID_Detail_process > 0
					IF Proper_PO_item(cPOitem) <> Proper_PO_item('') AND Proper_PO_item(pcPO_Item) <> Proper_PO_item('') 
						*check Items
						IF cPOitem <> pcPO_Item 
							PRIVATE cMess
							cMess = "You chose to [Receive] by selected "+CHR(13)+"Detail Process "+ALLTRIM(STR(pnID_Detail_process))+CHR(13)
							cMess=cMess+"with POitem of '"+cPOitem+"'."+CHR(13)
							cMess=cMess+"and WorkOrder of "+STR(nNew_WO)+"."+CHR(13)
							cMess=cMess+"Process is for '"+cPOitem+"'!"+CHR(13)
							cMess=cMess+"ID_Detail_Process = "+STR(nID_Detail_Process)+CHR(13)
							cMess=cMess+"NewID_Detail_Process = "+STR(NewID_Detail_Process)+CHR(13)
							
							MESSAGEBOX(cMess,48,"Weird")
							cMess=cMess+CHR(13)+"Shop_StockLst_Edit SOitem='"+PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.SOitem1.Value,'SOitem',10)+"'"
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
						ENDIF
					ENDIF
					DO CASE
					CASE cTBL = "S"
						DO FORM Forms\Receive_Edit WITH 'S_Process', NewID_Detail_Process, cHeat, nWO
					CASE cTBL = "B"
						DO FORM Forms\Receive_Edit WITH 'B_Process', NewID_Detail_Process, cHeat, nWO
					CASE cTBL = "W"
						DO FORM Forms\Receive_Edit WITH 'W_Process', NewID_Detail_Process, cHeat, nWO
					ENDCASE
				ELSE
					DO FORM Forms\Receive_Edit WITH 'POitem', pcPO_Item ,cHeat, nWO
					RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"StockLst_Process_Count.Counted > 0 and pnID_Detail_process NOT > 0"+CHR(13)+cSQL )
				ENDIF		
				
				ThisFormSet.VisibleFormsReset()
				
				RETURN .T.
			ENDIF
			
			USE IN StockLst_Process_Count
		ENDIF
		
		*Incoming process may have been removed, Aborted receive will still delete process!
		*Check Receiving for PO!
		*A WO PO may be used to remove Stock to Send to Converter.  Material is Removed not Received.
		
		IF Proper_PO_Item(pcPO_Item) = Proper_PO_Item('')
			RETURN .F.	
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS [Counted] FROM dbo.Receiving WITH(NOLOCK) WHERE POitem =  dbo.f_ProperPOitem('"+pcPO_Item+"')"
		
		IF USED("cntReceivingPOi")
			SELECT cntReceivingPOi
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntReceivingPOi')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'cntReceivingPOi')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntReceivingPOi")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntReceivingPOi")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'cntReceivingPOi')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		
		IF USED('cntReceivingPOi')	
			IF cntReceivingPOi.Counted = 0
				USE IN cntReceivingPOi
				
			*-  Must Receive first
				PRIVATE nMess
				
				nMess = MESSAGEBOX("Did not find a Receiving entry for this PO-item."+CHR(13)+"Receive this PO-item first! (Y/N)"+CHR(13)+"Answer (N) to skip the receive.",4,"Receive PO now?") 
				IF nMess != 6
					RETURN .F.
				ENDIF
				
				*Start Receive Process...
				* ID_Detail_process, pcTbl, pcPO_Item
				
				ThisFormSet.VisibleForms()
				ThisFormSet.frmStockLstProcesses.AlwaysOnTop = .F.
				IF pnID_Detail_process > 0
					DO CASE
					CASE cTBL = "S"
						DO FORM Forms\Receive_Edit WITH 'S_Process', pnID_Detail_process ,cHeat
					CASE cTBL = "B"
						DO FORM Forms\Receive_Edit WITH 'B_Process', pnID_Detail_process ,cHeat
					CASE cTBL = "W"
						DO FORM Forms\Receive_Edit WITH 'W_Process', pnID_Detail_process ,cHeat
					ENDCASE
				ELSE
					DO FORM Forms\Receive_Edit WITH 'POitem', pcPO_Item ,cHeat
					RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),"StockLst_Process_Count.Counted = 0 and pnID_Detail_process NOT > 0"+CHR(13)+cSQL)
				ENDIF
				ThisFormSet.VisibleFormsReset()
				
				ThisFormSet.ModifyStockLstAfterReceive = .T.
				
				*ThisFormSet.ReceivingLoad(pcPO_Item)
				RETURN .T.
			ELSE
				RETURN .T.
			ENDIF
		ENDIF
		
		
		RETURN .F.
	ENDPROC

	PROCEDURE checkreceiving_poitem		&& Try POitem in Receiving search for 'INCOMING' failes.
		PARAMETER pcTbl, pcPO_Item
		*ThisFormSet.CheckReceiving_POItem( pcTbl, pcPO_Item )
		
		IF VARTYPE(pcTbl) != "C"
			RecordError(0,"No Tbl_process " ,PROGRAM(),LINENO(1),"ThisFormSet.CheckReceiving_POItem( pcTbl, pcPO_Item)" )
			RETURN .F.
		ENDIF
		
		IF VARTYPE(pcPO_Item) != "C"
			pcPO_Item = ''
		ENDIF
		
		IF EMPTY(pcPO_Item)
			RETURN .F.
		ENDIF
		
		IF Proper_PO_Item(pcPO_Item) = Proper_PO_Item('')
			RecordError(0,"No POitem" ,PROGRAM(),LINENO(1),"ThisFormSet.CheckReceiving_POItem( pcTbl, pcPO_Item)" )
			RETURN .F.
		ENDIF
		
		
		cSQL = "SELECT COUNT(*) AS [Counted] FROM dbo.Receiving WITH(NOLOCK) WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+pcPO_Item+"')"
		
		IF USED("Receiving_Count")
			SELECT Receiving_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Receiving_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'Receiving_Count')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Receiving_Count")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "Receiving_Count")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'Receiving_Count')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		IF USED('Receiving_Count')	
			IF Receiving_Count.Counted = 0
				USE IN Receiving_Count
				
				*- Must Receive first
				WAIT window "Receive in first!" NOWAIT
		
				*Start Receive Process...
				ThisFormSet.ModifyStockLstAfterReceive = .T.
				
				PRIVATE cHeat
				cHeat=''
				ThisFormSet.VisibleForms()
				ThisFormSet.frmShop_StockLst_Edit.AlwaysOnTop = .F.
				DO FORM Forms\Receive_Edit WITH 'POitem', pcPO_Item, cHeat
				*ThisFormSet.ReceivingLoad(pcPO_Item)
				ThisFormSet.VisibleFormsReset()
				
				RETURN .F.
			ENDIF
			USE IN Receiving_Count	
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE check_id_detail_process
		*ThisFormSet.Check_ID_Detail_Process()
		
		*Does this process exists in SQL table? 
		PRIVATE nID_Detail_Process
		nID_Detail_Process = ThisFormSet.ID_Detail_Process
		
		IF nID_Detail_Process = 0
			RETURN .F.
		ENDIF
		PRIVATE cTBL,lReturn 
		cTBL = ThisFormSet.Tbl_Process
		lReturn = .F.
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED("CntProcess")
			USE IN CntProcess
		ENDIF
		SELECT 0
		*Check for Incoming ???
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process WITH(NOLOCK) "
		OTHERWISE
			MESSAGEBOX("Check_ID_Detail_Process did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("Check_ID_Detail_Process did not recognize Table Name","Check_ID_Detail_Process did not recognize Table Name",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CntProcess' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CntProcess' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntProcess")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntProcess")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'CntProcess')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF USED('CntProcess')
			IF RECCOUNT('CntProcess') > 0
				IF CntProcess.CNTD > 0
					lReturn = .T.
				ENDIF
			ENDIF
			USE IN CntProcess
		ENDIF
		
		IF NOT lReturn 
			IF MESSAGEBOX("Do you want to remove this bad Process now?",4,"Process points to missing stock!") = 6	
				IF ThisFormSet.Remove_ID_Detail_Process(ThisFormSet.ID_Detail_Process, "", cTbl)
					*CALLS:Remove_ID_Detail_Process(ThisFormSet.ID_Detail_Process, '', cTbl,ThisFormSet.nConnHandle,"CORRECTION")
					IF TYPE("ThisFormSet.frmStockLstProcesses") = "O"
						ThisFormSet.frmStockLstProcesses.Visible = .F.
					ENDIF
				ENDIF				
			ENDIF
		ENDIF
		
		RETURN lReturn 
	ENDPROC

	PROCEDURE check_order_status
		*ThisFormSet.Check_Order_Status()
		
		
		PRIVATE nWO, nSO
		nWO	= PrepareSQLnum(ThisFormSet.nWorkOrder,'WO',-3)
		nSO	= PrepareSQLnum(ThisFormSet.SalesNum,'SO',-3)
		
		IF nSO = 0 AND nWO = 0
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL 
		cSQL = ''
		
		IF USED('tmpOrder_Status')
			SELECT tmpOrder_Status
		ELSE
			SELECT 0
		ENDIF
		
		IF nSO>0
			cSQL = "SELECT ISNULL(Cncld,0) AS cncld, ISNULL(Cmplt,0) AS cmplt, ISNULL(ShopRecv,0) AS ShopRecv "
			cSQL = cSQL + " FROM dbo.Sales_No WITH(NOLOCK) WHERE SalesNum ="+ALLTRIM(STR(nSO))
		ENDIF
		IF nWO>0
			cSQL = "SELECT ISNULL(Cncld,0) AS cncld, ISNULL(Cmplt,0) AS cmplt, ISNULL(ShopRecv,0) AS ShopRecv "
			cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) WHERE WO ="+ALLTRIM(STR(nWO))
			*cSQL = "SELECT ISNULL(fCncld,0) AS cncld, ISNULL(fCmplt,0) AS cmplt, ISNULL(fPRecv,0) AS ShopRecv "
			*cSQL = cSQL + " FROM dbo.WorkOrder_Detail WITH (NOLOCK) WHERE WO ="+ALLTRIM(STR(nWO))
		ENDIF
		
		*This is a common 'Bad SQL Connetion' initiation point
		ThisFormSet.nConnHandle = CheckSQLConnection(ThisFormSet.nConnHandle)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpOrder_Status')
		WAIT WINDOW 'SQL .2' TIMEOUT 2
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL 1' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpOrder_Status')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpOrder_Status")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpOrder_Status")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpOrder_Status')
				MESSAGEBOX("Giving up on SQL connenction",16,"No SQL")
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				RETURN .F.
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		PRIVATE lcncld,lcmplt,lShopRecv, lOK
		lcncld = .F.
		lcmplt = .F.
		lShopRecv = .F.
		lOk = .T.
		
		IF USED('tmpOrder_Status')
			IF RECCOUNT('tmpOrder_Status') > 0
				lcncld = PrepareSQLlogic(tmpOrder_Status.cncld,'cncld')
				lcmplt = PrepareSQLlogic(tmpOrder_Status.cmplt,'cmplt')
				lShopRecv = PrepareSQLlogic(tmpOrder_Status.ShopRecv,'ShopRecv')
				
				IF nSO>0
					IF lcncld 
						MESSAGEBOX("This SO:"+ALLTRIM(STR(nSO))+" is Cancelled.",64,"Weird")
						*MESSAGEBOX("This SO:"+ALLTRIM(STR(nSO))+" is Cancelled.",16,"Cannot continue.")
		*				lOK = .F.
						TRACKMESS("This SO:"+ALLTRIM(STR(nSO))+" is Cancelled. Viewed in Shop_StockLst_Edit." )
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"This SO:"+ALLTRIM(STR(nSO))+" is Cancelled."+CHR(13)+"Weird")
					ENDIF
					IF lcmplt 
						MESSAGEBOX("This SO:"+ALLTRIM(STR(nSO))+" is Complete.",64,"Weird.")
						*lOK = .F.
						TRACKMESS("This SO:"+ALLTRIM(STR(nSO))+" is Complete. Viewed in Shop_StockLst_Edit." )
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"This SO:"+ALLTRIM(STR(nSO))+" is Complete."+CHR(13)+"Weird.")
					ENDIF
					IF NOT lShopRecv 
						IF NOT (lcncld AND lcmplt)
							MESSAGEBOX("This SO:"+ALLTRIM(STR(nSO))+" Paper Work has not been listed as Received by Shop.",64,"Weird")
							*lOK = .F.
							TRACKMESS("This SO:"+ALLTRIM(STR(nSO))+" has not been listed as Received by Shop. Viewed in Shop_StockLst_Edit." )
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"This SO:"+ALLTRIM(STR(nSO))+" has not been listed as Received by Shop."+CHR(13)+"Weird")
						ENDIF
					ENDIF
				ENDIF
				
				IF nWO>0
					IF lcncld 
						MESSAGEBOX("This WO:"+ALLTRIM(STR(nWO))+" is Cancelled.",64,"Weird")
						*MESSAGEBOX("This WO:"+ALLTRIM(STR(nWO))+" is Cancelled.",16,"Cannot continue.")
		*				lOK = .F.
		*				TRACKMESS("This WO:"+ALLTRIM(STR(nWO))+" is Cancelled. Cannot continue with Shop StockLst Edit." )
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"This WO:"+ALLTRIM(STR(nWO))+" is Cancelled."+CHR(13)+"Weird")
					ENDIF
					IF lcmplt 
						MESSAGEBOX("This WO:"+ALLTRIM(STR(nWO))+" is Complete.",64,"Weird.")
						*lOK = .F.
						TRACKMESS("This WO:"+ALLTRIM(STR(nWO))+" is Complete. Viewed in Shop StockLst Edit." )
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"This WO:"+ALLTRIM(STR(nWO))+" is Complete."+CHR(13)+"Weird.")
					ENDIF
					IF NOT lShopRecv 
						IF NOT (lcncld AND lcmplt)
							MESSAGEBOX("This WO:"+ALLTRIM(STR(nWO))+" Paper Work has not been listed as Received by Shop.",64,"Weird")
							*lOK = .F.
							TRACKMESS("This WO:"+ALLTRIM(STR(nWO))+" has not been listed as Received by Shop. Viewed in Shop StockLst Edit." )
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"This WO:"+ALLTRIM(STR(nWO))+" has not been listed as Received by Shop."+CHR(13)+"Weird")
						ENDIF
					ENDIF
					
				ENDIF
				
			ENDIF
			USE IN tmpOrder_Status	
		ENDIF
		
		RETURN lOK
	ENDPROC

	PROCEDURE choosepoitemload		&& Loads Form frmChoosePOitem
		PARAMETER pnHpaPo
		*ThisFormSet.ChoosePOitemLoad(nHPApo)
		
		Private nHpaPo
		IF TYPE("pnHpaPo") = "N"
			nHpaPo = pnHpaPo
		ELSE
			nHpaPo = 0
		ENDIF
		
		IF USED("tmpPOitems")
			USE IN tmpPOitems
		ENDIF
		
		IF nHpaPo > 0
			ThisFormSet.frmChoosePOitem.Caption = ThisFormSet.frmChoosePOitem.Caption+" for PO# "+ALLTRIM(STR( nHpaPo ))
			
			cSQL = "SELECT POitem,SoItem,dbo.f_SalesPDescription(SalesP,Cover) AS SalesMan,Company,Alloy,Pieces"
			cSQL = cSQL + ",dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Order_Qty,RandLen ) AS Description"
			cSQL = cSQL + ",Cond_Spec,heat,OrderDate"
			cSQL = cSQL + ",Received,delivered,cancelled FROM dbo.PurchaseOrder WITH(NOLOCK) " &&INTO CURSOR tmpPOitems;
			cSQL = cSQL + " WHERE HpaPo = "+STR(nHpaPo)
			  
		ELSE
			ThisFormSet.frmChoosePOitem.Caption = "Choose PO item"
			*SELECT All
			cSQL = "SELECT POitem,SoItem,dbo.f_SalesPDescription(SalesP,Cover) AS SalesMan,Company,Alloy,Pieces"
			cSQL = cSQL + ",dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Order_Qty,RandLen) AS Description,Cond_Spec,heat,OrderDate"
			cSQL = cSQL + ",Received,delivered,cancelled FROM dbo.PurchaseOrder WITH(NOLOCK) " &&INTO CURSOR tmpPOitems ORDER BY POitem
			 
		ENDIF
		
		IF USED("tmpPOitems")
			SELECT tmpPOitems 
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOitems')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOitems')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPOitems")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOitems')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		IF nSQLEXEC > 0
			IF USED("tmpPOitems")
				SELECT tmpPOitems
				GO BOTTOM
				IF RECCOUNT() > 10
				 	SKIP -10
				ENDIF 
		
				ThisFormSet.frmChoosePOitem.grdChoosePOitem.RecordSource = "tmpPOitems"
				*ThisForm.grdChoosePOitem.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
				ThisFormSet.frmChoosePOitem.txtAlloy.Value = tmpPOitems.Alloy
				ThisFormSet.frmChoosePOitem.txtDescription.Value = tmpPOitems.Description
		
		
				*ThisForm.grid.SetFocus
		
				IF ThisFormSet.frmChoosePOitem.Top > 1000
					ThisFormSet.frmChoosePOitem.Top = 300
				ENDIF
				
				IF RECCOUNT("tmpPOitems") = 1
					ThisFormset.frmChoosePOitem.cmdSelect.Click()
				ELSE
					ThisFormSet.frmChoosePOitem.Visible = .T.
					IF RECCOUNT("tmpPOitems") = 0
						MESSAGEBOX("Sorry, PO number not Found",32,"No records to Show!")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE chooseso
		*ThisFormSet.ChooseSO
		
		ThisFormSet.frmStockLstProcesses.Visible = .F.
		ThisFormSet.frmModiProcess.Visible = .F.
		ThisFormSet.frmColorStandards.Visible = .F.
		*ThisFormSet.frmStockLst.Visible = .F.
		IF VARTYPE(ThisFormSet.frmStockStatus) = "O"
			ThisFormSet.frmStockStatus.Visible = .F.
		ENDIF
		ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
		ThisFormSet.frmSimiliarSales.Visible = .F.
		*ThisFormSet.frmQuote.Visible = .F.
		
		ThisFormset.frmChooseSO.Top = 30
		ThisFormset.frmChooseSO.Left = 2
		ThisFormset.frmChooseSO.grdOpensales.RecordSource = ""
		
		IF USED("OpenSales")
			USE IN OpenSales
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT S.SOitem, S.ShipDue,S.Shipped"
		*cSQL = cSQL + ",0 AS Qshipped,0 AS QBackOrder "
		cSQL = cSQL + " ,S.prcp,S.Urgent,S.Hold,S.SalesNum "
		cSQL = cSQL +" FROM dbo.Sales S WITH(NOLOCK) "
		cSQL = cSQL +" WHERE ISNULL(S.Cncld,0)=0 "
		*cSQL = cSQL +" AND ISNULL(S.prcp,0)!=0 "
		*cSQL = cSQL +" AND ISNULL(S.prcd,0)!=0 "
		cSQL = cSQL +" AND ISNULL(S.Cmplt,0)=0 "
		cSQL = cSQL +" ORDER BY ISNULL(S.Urgent,' '), ISNULL(ShipDue,GetDate())"
		  
		
		** S.prcp  Process in Progress
		** S.pckd  Process Packaged
		** S.prcd  Process Done
			  
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'OpenSales')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'OpenSales' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "OpenSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "OpenSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'OpenSales')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		
		PRIVATE lFoundRec
		lFoundRec = .F.
		
		IF nSQLEXEC > 0
			IF RECCOUNT('OpenSales') > 0
				lFoundRec = .T.	
			ENDIF
			ThisFormset.frmChooseSO.grdOpensales.RecordSource = "OPENSALES"
			ThisFormset.frmChooseSO.grdOpensales.ColumnCount = 8
			
			ThisFormset.frmChooseSO.grdOpensales.Refresh
			ThisFormset.frmChooseSO.Visible = .T.
			ThisFormset.frmChooseSO.grdOpensales.SetFocus()
		
			ThisFormSet.frmShop_StockLst_Edit.txtWO.Visible = .F.
			ThisFormSet.frmShop_StockLst_Edit.lblWO.Visible = .F.
		ENDIF
		
		***********
		IF USED("tmpSerBase")
			USE IN tmpSerBase
		ENDIF
		SELECT 0
		
		cSQL = "SELECT serverproperty('MachineName') AS [Server] ,DB_NAME() AS [Database]"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSerBase')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSerBase')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSerBase")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSerBase")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
		*	SQLEXECError(cSQL, gnConnHandle,nSQLEXEC, 'tmpSerBase')
			IF NOT RecordError(1, 'SQL Error', PROGRAM(), LINENO(1), "Could not'SELECT serverproperty('MachineName')")
				MESSAGEBOX("Could not'SELECT serverproperty('MachineName')",16,"SQL Error")
			 	RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
			ELSE
				nSQLEXEC = 1
			ENDIF
		ENDIF
		IF nSQLEXEC > 0
			IF USED("tmpSerBase")
				IF VARTYPE(tmpSerBase.Server) = "C"
					ThisFormset.frmChooseSO.lblServer.Caption = tmpSerBase.Server
					ThisFormset.frmChooseSO.lblDatabase.Caption = tmpSerBase.Database
				ELSE
					ThisFormset.frmChooseSO.lblServer.Caption = ' '
					ThisFormset.frmChooseSO.lblDatabase.Caption = ' ' 
				ENDIF
				USE IN tmpSerBase			
			ELSE
				ThisFormset.frmChooseSO.lblServer.Caption = ' '
				ThisFormset.frmChooseSO.lblDatabase.Caption = ' ' 
			ENDIF
		ENDIF
		
	ENDPROC

