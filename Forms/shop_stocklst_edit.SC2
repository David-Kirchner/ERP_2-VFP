	PROCEDURE countpoitem_process
		PARAMETER cPOitem
		*ThisFormSet.CountPOitem_Process(cPOitem)
		PRIVATE cMess
		cMess = ''
		
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			
			IF USED('cntPO_Prc')
				USE IN cntPO_Prc
			ENDIF
			
			SELECT 0
			PRIVATE cSQL, nSQLEXEC 
			
			cSQL = " SELECT COUNT(*) AS CNTD" 
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.Id = D.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE M.PO_Item = '"+cPOitem+"'"
			cSQL = cSQL + " OR P.PO_Item = '"+cPOitem+"'"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntPO_Prc')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'cntPO_Prc')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntPO_Prc")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntPO_Prc")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntPO_Prc')	
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			IF USED('cntPO_Prc')
				IF cntPO_Prc.CNTD = 0
					
					*Count in Received as Complete
					PRIVATE nCnt
					nCnt = Count_POIteminReceiving( cPOItem, ThisFormSet.nConnHandle, 'NOTCANCELLED' )
					
					IF nCnt = 0
						
						cMess = "This POitem '"+cPOitem+"' does not have an active Process!"+CHR(13)+"Have the Sales Rep Edit PO,"+CHR(13)+"and Save the PO to recreate the Process."+CHR(13)+"There is nothing in this Broker List to Select."+CHR(13)
						IF ThisFormSet.nWorkOrder > 0
							cMess = cMess + "Work Order: "+ALLTRIM(STR(ThisFormSet.nWorkOrder))+CHR(13)
						ENDIF
						IF ThisFormSet.SalesNum > 0
							cMess = cMess + "Sales Order: "+ALLTRIM(STR(ThisFormSet.SalesNum))+CHR(13)
						ENDIF
					ELSE
						cMess = "Program will retreive that un-cancelled Receiving record." &&Do not change text
					ENDIF				
				ENDIF
				USE IN cntPO_Prc
			ENDIF
		ELSE
			MESSAGEBOX("No POitem Found!",16,"No POitem")
		ENDIF
		
		PRIVATE cMess2
		cMess2 = ''
		
		**********
		IF LEN(cMess) > 0
			*Check StockLst
			
			IF USED('cntPO_Prc')
				USE IN cntPO_Prc
			ENDIF
			
			SELECT 0
			PRIVATE cSQL, nSQLEXEC 
			
			cSQL = " SELECT COUNT(*) AS CNTD" 
			cSQL = cSQL + " FROM dbo.StockLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.Id = D.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " WHERE M.PO_Item = '"+cPOitem+"'"
			cSQL = cSQL + " OR P.PO_Item = '"+cPOitem+"'"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntPO_Prc')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'cntPO_Prc')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntPO_Prc")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "cntPO_Prc")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntPO_Prc')	
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			IF USED('cntPO_Prc')
				IF cntPO_Prc.CNTD = 0
					*cMess2 = "This POitem '"+cPOitem+"' was not found in Stock!"
					cMess2 = "Try using the Receiving Program"
				ELSE
					cMess2 = "This POitem '"+cPOitem+"' was found as Stock!"+CHR(13)+"Look at Stock instead of Broker"						
				ENDIF
				USE IN cntPO_Prc
			ENDIF
		ENDIF
		
		**********
		IF LEN(cMess) > 0
			IF LEN(cMess2) > 0
				cMess = cMess + CHR(13)+CHR(13)+ cMess2
			ENDIF
			
			IF "Program will retreive that un-cancelled Receiving record." $ cMess
				MESSAGEBOX("No current Process related to POitem."+CHR(13)+"Program will ask to retreive that un-cancelled Receiving POitem record.",0+48,"No current Process related to POitem.")
			ELSE
				MESSAGEBOX(cMess,0+48,"No Process related to POitem.")
				TrackError(cMess+CHR(13)+"Cannot process this Order because PO Broker Process is missing.","No Process related to POitem.", PROGRAM(), LINENO(1))
				*Alert PO issue on Chatter
				*lOK = Chatter_Message(cReceipient,cMessage,ThisFormSet.nConnHandle)
				Send_Chatter('PO_Item_Error',0,cPOitem,"The Shop Stock List Edit program with "+RIGHT(SYS(0),LEN(SYS(0))-AT("#",SYS(0))-1 )+" could no process this POitem "+cPOitem+" No INCOMING Process Found."+CHR(13)+HTML_POitem(cPOitem,.T.) ,ThisFormSet.nConnHandle)
				*PARAMETERS pcType_Name, pnNumber, pcNumber, pcMessage, pConnHandle
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE create_incomingprocess
		PARAMETERS pWhat, pNumber
		*ThisFormSet.Create_IncomingProcess("WO",nWO)
		*When Shop want to Receive Stock without an INCOMING process
		
		
		*!*	MESSAGEBOX("Use menu 'Sales\Receiving' to Select the POitem to Receive to."+CHR(13)+"or menu 'Sales\Work Order' to create a receiving process to receive to."+CHR(13)+"Cannot continue here.",48,"Not programmed here")
		*!*	RETURN
		
		*!*	*Create INCOMING process
		*!*	PRIVATE cSQLi, nSQLEXEC 
		*!*	PRIVATE nID_Detail,cSalesPerson,dStartDate,dDueDate
		*!*	PRIVATE cAllowSub,npWeight,cSOitem,nWO,cPOitem,cProcess_ID,cProcessor,cComment
		*!*	PRIVATE cTbl,cTBL_POi,cTBL_POi_P,cTBL_WO,cTBL_WOD
		
		*!*	cTBL		= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.TBL.Value,'TBL',1)
		*!*	cTBL_POi	= getTBL_POitem(cPOitem, ThisFormSet.nConnhandle ) 
		*!*	cTBL_POi_P	= getTBL_Process_POitem(cPOitem, ThisFormSet.nConnhandle ) 
		*!*	cTBL_WO		= getTBL_WO(nWO, ThisFormSet.nConnhandle )
		*!*	cTBL_WOD	= getTBL_WOD_WO(nWO, ThisFormSet.nConnhandle )
		
		*!*	nID_Detail	 	= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail.Value,'ID_Detail', -3,0 )
		*!*	*nID_Detail_Process
		*!*	cSOitem 		= Proper_SO_Item(ThisFormSet.frmStockLstProcesses.SOitem1.Value)
		*!*	nWO				= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.WO1.Value,'WO',-3)
		*!*	cAllowSub 		= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.AllowSub1.Value,'AllowSub',1)
		*!*	cPOitem			= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.PO_Item1.Value,'POitem',12)
		*!*	npWeight 		= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.pPounds1.Value,'Pounds',9,1)
		*!*	cSalesPerson 	= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.SalesPerson1.Value,'SalesPerson',20)
		
		*!*	nPU				= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.PU1.Value,'PU',-1)
		
		*!*	dStartdate	 	= PrepareSQLdate(ThisFormSet.frmStockLstProcesses.StartDate1.Value,'StartDate') &&DATE()
		*!*	cProcess_ID 	= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.Process_ID1.Value,'Process_ID',10)
		*!*	dDueDate 		= PrepareSQLdate(ThisFormSet.frmStockLstProcesses.DueDate1.Value,'DueDate')
		*!*	cProcessor		= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.Processor1.Value,'Processor',20)
		*!*	cComment 		= "ReCreated Incoming: "+PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.Comment1.Value,'Comment',100)
		
		*!*	PRIVATE nWO_Detail
		*!*	nWO_Detail = 0
		
		
		*!*	***~Check DATA
		
		*!*	*cProcess_ID 	= "INCOMING"
		*!*	IF USED('tmpProcess')
		*!*		PRIVATE nRecnum
		*!*		nRecNum = RECNO('tmpProcess')
		*!*		
		*!*		SELECT tmpProcess
		*!*		IF nWO > 0
		*!*			IF Proper_PO_item(cPOitem) = Proper_PO_item('')
		*!*				LOCATE FOR WO = nWO AND ( Process_ID = "INCOMING" OR Process_ID = "NOT2HPA" OR Process_ID = "PARTRECV" )
		*!*			ELSE
		*!*				LOCATE FOR WO = nWO AND PO_item = cPOitem AND ( Process_ID = "INCOMING" OR Process_ID = "NOT2HPA" OR Process_ID = "PARTRECV" )
		*!*			ENDIF
		*!*		ELSE
		*!*			LOCATE FOR PO_item = cPOitem AND ( Process_ID = "INCOMING" OR Process_ID = "NOT2HPA" OR Process_ID = "PARTRECV" )
		*!*		ENDIF
		*!*		
		*!*		IF FOUND('tmpProcess')
		*!*			MESSAGEBOX("This POitem:"+ALLTRIM(cPOitem)+CHR(13)+"or WO:"+ALLTRIM(STR(nWO))+CHR(13)+"already has an 'INCOMING' OR 'NOT2HPA' OR 'PARTRECV' process.",0,"Cannot Create Process")
		*!*			
		*!*			IF nRecNum > 0
		*!*				GOTO nRecNum
		*!*			ELSE
		*!*				GO TOP
		*!*			ENDIF
		*!*			
		*!*			RETURN
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
		
		*!*	************************************
		*!*	* Make sure Sales is not listed as Cmplt
		*!*	* Sales Update Trigger will DELETE this process if Sales is CMPLT
		*!*	IF Proper_SO_item(cSOitem) != Proper_SO_item('')
		*!*		IF Count_SOIteminSales(cSOItem, ThisFormSet.nConnHandle, "COMPLETE") > 0
		*!*		
		*!*			cSQL = "UPDATE dbo.Sales SET [cmplt] = 0 "
		*!*			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		*!*			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVDetail")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVDetail")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
		*!*					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
		*!*				ELSE
		*!*					nSQLEXEC = 1
		*!*				ENDIF
		*!*			ENDIF
		*!*			IF nSQLEXEC > 0
		*!*				TrackMess("Using Shop StockLst Edit, Setting Sales NOT CMPLT. POitem='"+cPOitem+"', SOitem '"+cSOitem+"'")
		*!*				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Using Shop StockLst Edit, user is adding a incoming process. POitem='"+cPOitem+"'"+CHR(13)+cSQL )
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	************************************
		*!*	* Make sure PurchaseOrder is not listed as Delivered
		*!*	* PurchaseOrder Update trigger will DELETE this Process if PO is Delivered
		*!*	IF Proper_PO_item(cPOitem) != Proper_PO_item('')
		*!*		
		*!*		*Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle )
		*!*		IF Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnHandle,"DELIVERED") > 0
		*!*			
		*!*			cSQL = "UPDATE dbo.PurchaseOrder SET Delivered = 0 "
		*!*			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		*!*			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVDetail")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpINVDetail")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
		*!*					RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
		*!*				ELSE
		*!*					nSQLEXEC = 1
		*!*				ENDIF
		*!*			ENDIF
		*!*			IF nSQLEXEC > 0
		*!*				TrackMess("Shop StockLst Edit is setting PurchaseOrder to NOT Delivered so another INCOMING Process can be added. POitem= '"+cPOitem+"', SOitem '"+cSOitem+"'")
		*!*				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Using Shop StockLst Edit, user is adding a incoming process and setting POitem as NOT Deliverd. POitem='"+cPOitem+"'"+CHR(13)+cSQL )
		*!*			ENDIF
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	************************************
		*!*	* Make sure WO is not listed as Cmplt ??
		*!*	IF nWO > 0
		*!*		IF Count_WOinWO( nWO, ThisFormSet.nConnHandle,"CANCELLED") > 0 OR Count_WOinWO( nWO, ThisFormSet.nConnHandle,"COMPLETE") > 0
		*!*	 	
		*!*	 	ENDIF
		*!*	 ENDIF
		
		*!*	*****************************************
		*!*	IF USED("tmpID_Detail_Process")
		*!*		USE IN tmpID_Detail_Process
		*!*	ENDIF
		
		
		*!*	IF nSQLEXEC < 0
		*!*		IF NOT SQLEXECError(cSQLi, ThisFormSet.nConnHandle,nSQLEXEC,'tmpID_Detail_Process')
		
		*!*		*	nTran = SQLROLLBACK(ThisFormSet.nConnHandle)
		*!*		*	nTran = SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		*!*			RETURN
		*!*			RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
		*!*		ELSE
		*!*			nSQLEXEC = 1
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF nSQLEXEC > 0
		*!*	*	nTran = SQLCOMMIT(ThisFormSet.nConnHandle)
		*!*	*	nTran = SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		*!*	ENDIF	
		
		*!*	IF USED('tmpID_Detail_Process')
		*!*		IF RECCOUNT('tmpID_Detail_Process')>0
		*!*		
		*!*			ThisFormSet.ID_Detail_Process	  = PrepareSQLnum(tmpID_Detail_Process.Exp,'ID_Detail_Process',-3)
		*!*			*ThisForm.ID_Detail_Process1.Value = ThisFormSet.ID_Detail_Process
		*!*			*ThisForm.Create_IncomingProce()
		*!*			
		*!*			USE IN tmpID_Detail_Process
		*!*				
		*!*	*		ThisForm.ID_Detail_Process1.Refresh
		*!*	*		ThisForm.ID_Detail_Process1.Visible = .T.
		*!*				
		*!*			IF Proper_SO_item(cSOitem) != Proper_SO_item('')
		*!*				*UPDATE Sales SET prcp = .T. WHERE SOitem = (m.SOitem)  &&Has trigger to delete Cmplt Processes!!!!
		*!*				Update_PrcpPrcdinSales( .T.,.F.,cSOitem, ThisFormSet.nConnHandle )
		*!*				* && Has trigger to delete Cmplt Processes!!!!
		*!*			ENDIF
		
		*!*			*This.Enabled = .F.
		*!*			*ThisForm.ogSOitem.Enabled = .F.
		*!*			*ThisForm.cmdModifyStockLst.Enabled = .T.
		*!*			*THISFORM.cmdShowStockLst.Enabled = .T.
		*!*			*THISFORM.cmdAddSelectPrc.Enabled = .T.
		*!*			*ThisForm.lblStartDate1.Enabled = .F.
		*!*			*ThisForm.lblDueDate1.Enabled = .F.
		*!*			*ThisForm.Visible = .F.
		*!*					
		
		*!*			ThisFormSet.StockLst_ID_Detail = nID_Detail
		*!*				
		*!*			*ThisFormSet.RefreshtmpQuotes()
		*!*			ThisFormSet.RefreshSO()
		*!*			
		*!*			ThisFormSet.StockLstProcesses(nID_Detail, "ID_Detail", "INCOMING")
		*!*			
		*!*			MESSAGEBOX("Created Incoming Process to Receive to.",0,"Done")
		*!*		ENDIF
		*!*	ENDIF
		
		
	ENDPROC

	PROCEDURE create_stocklst_process
		PARAMETER pID, pID_Detail, pShow, pTBL
		**ThisFormSet.Create_StockLst_Process( ID, ID_Detail, 'NOEDIT', "S" )
		*Show Process' for ID_Detail.
		
		PRIVATE lShow, cSQL, nSQLEXEC 
		lShow = .F.
		
		IF TYPE("pShow") = "C"
			IF pShow = "NOEDIT"
				lShow = .T.
			ENDIF
		ELSE
			pShow = " "
		ENDIF
		
		IF TYPE("pShow")!="C"
			pShow = " "
		ENDIF
		
		PRIVATE cTBL
		IF TYPE("pTBL") != "C"
			cTBL = ""
		ELSE
			cTBL = pTBL
		ENDIF
		
		IF NOT cTBL $ "SBW"
			MESSAGEBOX("Create_StockLst_Process did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("Create_StockLst_Process did not recognize Table Name","Create_StockLst_Process did not recognize Table Name",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		m.ID_Detail_Process = 0
		THISFORMSET.frmModiProcess.ID_Detail_Process1.Value = 0
		THISFORMSET.frmModiProcess.txtHeat.Value = ''
		
		PRIVATE nID_Detail
		nID_Detail = PrepareSQLnum(pID_Detail,'ID_Detail',-3)
		
		IF TYPE("pID") = "N" AND TYPE("nID_Detail") = "N"
		
			IF pID = 0
				RecordError(1, "Trouble!", PROGRAM(), LINENO(1), "ID was set to 0"+CHR(13)+"Parameter pID is 0")
			ENDIF
			IF nID_Detail = 0
				RecordError(1, "Trouble!", PROGRAM(), LINENO(1), "ID_Detail was set to 0")
			ENDIF
			
			THISFORMSET.frmModiProcess.ID1.VALUE = pID
			IF nID_Detail > 0
				THISFORMSET.frmModiProcess.ID_Detail1.VALUE = nID_Detail
				ThisFormSet.StockLst_ID_Detail = nID_Detail
			ELSE
				THISFORMSET.frmModiProcess.ID_Detail1.VALUE = 0
				ThisFormSet.StockLst_ID_Detail = 0
			ENDIF
			
			IF lShow
				IF USED("tmpID_Detail_Process")
					USE IN tmpID_Detail_Process
				ENDIF
				SELECT 0
				
				cSQL = "SELECT P.*,M.Heat "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "	
				CASE cTBL = "B"
					cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID = M.ID "	
				CASE cTBL = "W"
					cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID = M.ID "	
				ENDCASE
				cSQL = cSQL + " WHERE P.ID_Detail="+STR(nID_Detail)
				
				nSQLEXEC = SQLEXEC(THISFORMset.nConnHandle, cSQL, 'tmpID_Detail_Process' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpID_Detail_Process' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Process")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Process")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ELSE
						nSQLEXEC = 1
					ENDIF
				ENDIF
				IF nSQLEXEC > 0
					THISFORMSET.frmModiProcess.SOitem1.VALUE 	= tmpID_Detail_Process.SOitem
					THISFORMSET.frmModiProcess.POitem1.VALUE 	= tmpID_Detail_Process.PO_item
					THISFORMSET.frmModiProcess.SalesPerson1.VALUE=tmpID_Detail_Process.SalesPerson
					THISFORMSET.frmModiProcess.StartDate1.VALUE = tmpID_Detail_Process.StartDATE
					THISFORMSET.frmModiProcess.DueDate1.VALUE 	= tmpID_Detail_Process.DueDATE
					THISFORMSET.frmModiProcess.AllowSub1.VALUE 	= tmpID_Detail_Process.AllowSub
					THISFORMSET.frmModiProcess.pPounds1.VALUE 	= tmpID_Detail_Process.Pounds
					THISFORMSET.frmModiProcess.pQTY1.VALUE 		= tmpID_Detail_Process.QTY
					THISFORMSET.frmModiProcess.PU1.VALUE 		= tmpID_Detail_Process.PU
					THISFORMSET.frmModiProcess.Process_ID1.VALUE= tmpID_Detail_Process.Process_ID
					THISFORMSET.frmModiProcess.Processor1.VALUE	= tmpID_Detail_Process.Processor
					THISFORMSET.frmModiProcess.Comment1.VALUE	= tmpID_Detail_Process.Comment
					THISFORMSET.frmModiProcess.ogSOitem.Value	= IIF(EMPTY(tmpID_Detail_Process.SOitem), 2, 1)
					THISFORMSET.frmModiProcess.ID_Detail_Process1.Value  = tmpID_Detail_Process.ID_Detail_Process
					
					THISFORMSET.frmModiProcess.txtHeat.Value = PrepareSQLtxt(tmpID_Detail_Process.Heat,'Heat',50)
					
					THISFORMSET.frmModiProcess.ogSOitem.Enabled = .F.
					THISFORMSET.frmModiProcess.cmdSave.Enabled = .F.
		
					THISFORMSET.frmModiProcess.cmdShowStockLst.Enabled = .F.
		
					DO CASE
					CASE cTBL = "S"
						ThisFormSet.frmModiProcess.txtTBL.Value = "S"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Show StockLst Process"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .F.
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
					CASE cTBL = "B"
						ThisFormSet.frmModiProcess.txtTBL.Value = "B"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Show BrokerLst Process"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .T.
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify BrokerLst"
					CASE cTBL = "W"
						ThisFormSet.frmModiProcess.txtTBL.Value = "W"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Show WIPLst Process"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .T.
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify WIPLst"
					ENDCASE			
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .F.
					THISFORMSET.frmModiProcess.lblStartDate1.Enabled = .T.
					THISFORMSET.frmModiProcess.lblDueDate1.Enabled = .T.
					
		*			ThisFormSet.StockLstProcesses(nID_Detail, pType, pWhat)  --Refresh window
					
					IF USED("tmpID_Detail_Process")
						USE IN tmpID_Detail_Process
					ENDIF
				ENDIF
			ELSE
				DO CASE
				CASE pShow = "CORRECTION"
					ThisFormset.frmModiProcess.ogSOitem.Value = 2
					ThisFormset.frmModiProcess.ogSOitem.Enabled = .F.
					ThisFormset.frmModiProcess.ogSOitem.Refresh
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .F.
					ThisFormset.frmModiProcess.SOITEM1.VISIBLE = .F.
					ThisFormset.frmModiProcess.WO1.VISIBLE = .F.
					ThisFormset.frmModiProcess.WO_detail1.VISIBLE = .F.
					THISFORMSET.frmModiProcess.POitem1.Visible = .F.
					ThisFormset.frmModiProcess.lblSalesPerson1.Visible = .F.
					ThisFormset.frmModiProcess.SalesPerson1.Visible = .F.
					ThisFormset.frmModiProcess.lblstartDate1.Visible = .F.
					ThisFormset.frmModiProcess.StartDate1.Visible = .F.
					ThisFormset.frmModiProcess.lblDueDate1.Visible = .F.
					ThisFormset.frmModiProcess.DueDate1.Visible = .F.
					ThisFormset.frmModiProcess.lblAllowSub.VISIBLE = .F.
					ThisFormset.frmModiProcess.AllowSub1.VISIBLE = .F.
					ThisFormset.frmModiProcess.lblWeight1.Visible = .F.
					ThisFormset.frmModiProcess.pPounds1.Visible = .F.
					ThisFormset.frmModiProcess.lblQTY.Visible = .F.
					ThisFormset.frmModiProcess.pQTY1.Visible = .F.
					ThisFormset.frmModiProcess.PU1.Visible = .F.
					ThisFormset.frmModiProcess.lblProcess_ID1.Visible = .F.
					ThisFormset.frmModiProcess.Process_ID1.Visible = .F.
					ThisFormset.frmModiProcess.lblProcessor1.Visible = .F.
					ThisFormset.frmModiProcess.Processor1.Visible = .F.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .F.
					THISFORMSET.frmModiProcess.cmdSave.Enabled = .T.
					THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .F.
					THISFORMSET.frmModiProcess.cmdShowStockLst.Enabled = .F.
					
					DO CASE
					CASE cTBL = "S"
						ThisFormSet.frmModiProcess.txtTBL.Value = "S"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create StockLst Correction"
					CASE cTBL = "B"
						ThisFormSet.frmModiProcess.txtTBL.Value = "B"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify BrokerLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create BrokerLst Correction"
					CASE cTBL = "W"
						ThisFormSet.frmModiProcess.txtTBL.Value = "W"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify WIPLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create WIPLst Correction"
					ENDCASE
		
					
				CASE pShow = 'NOEDIT'
					THISFORMSET.frmModiProcess.ogSOitem.Enabled = .T.
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .T.
					
					ThisFormset.frmModiProcess.SOITEM1.VISIBLE = .T.
					ThisFormset.frmModiProcess.WO1.VISIBLE = .T.
					ThisFormset.frmModiProcess.WO_Detail1.VISIBLE = .T.
					THISFORMSET.frmModiProcess.POitem1.Visible = .T.
					ThisFormset.frmModiProcess.lblSalesPerson1.Visible = .T.
					ThisFormset.frmModiProcess.SalesPerson1.Visible = .T.
					ThisFormset.frmModiProcess.lblstartDate1.Visible = .T.
					ThisFormset.frmModiProcess.StartDate1.Visible = .T.
					ThisFormset.frmModiProcess.lblDueDate1.Visible = .T.
					ThisFormset.frmModiProcess.DueDate1.Visible = .T.
					ThisFormset.frmModiProcess.lblAllowSub.VISIBLE = .T.
					ThisFormset.frmModiProcess.AllowSub1.VISIBLE = .T.
					ThisFormset.frmModiProcess.lblWeight1.Visible = .T.
					ThisFormset.frmModiProcess.pPounds1.Visible = .T.
					ThisFormset.frmModiProcess.lblQTY.Visible = .T.
					ThisFormset.frmModiProcess.pQTY1.Visible = .T.
					ThisFormset.frmModiProcess.PU1.Visible = .T.
					ThisFormset.frmModiProcess.lblProcess_ID1.Visible = .T.
					ThisFormset.frmModiProcess.Process_ID1.Visible = .T.
					ThisFormset.frmModiProcess.lblProcessor1.Visible = .T.
					ThisFormset.frmModiProcess.Processor1.Visible = .T.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.
		
					THISFORMSET.frmModiProcess.cmdSave.Enabled = .T.
					THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .F.
					THISFORMSET.frmModiProcess.cmdShowStockLst.Enabled = .F.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.			
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .F.
					
					DO CASE
					CASE cTBL = "S"
						ThisFormSet.frmModiProcess.txtTBL.Value = "S"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "StockLst Process"
					CASE cTBL = "B"
						ThisFormSet.frmModiProcess.txtTBL.Value = "B"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify BrokerLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "BrokerLst Process"
					CASE cTBL = "W"
						ThisFormSet.frmModiProcess.txtTBL.Value = "W"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify WIPLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "WIPLst Process"
					ENDCASE
		
					
				OTHERWISE
					*The standard 
					*NOT  "CORRECTION" nor 'NOEDIT'
					THISFORMSET.frmModiProcess.SOitem1.VALUE 	= tmpSO.SOitem
					THISFORMSET.frmModiProcess.WO1.VALUE 		= tmpSO.WO
					THISFORMSET.frmModiProcess.WO_Detail1.VALUE = tmpSO.WO_Detail
					THISFORMSET.frmModiProcess.POitem1.VALUE 	= tmpSO.POitem
					THISFORMSET.frmModiProcess.SalesPerson1.VALUE = SalesPDescription(tmpSO.SalesP,tmpSO.Cover)
					THISFORMSET.frmModiProcess.StartDate1.VALUE = DATE()
					THISFORMSET.frmModiProcess.DueDate1.VALUE 	= tmpSO.ShipDue
					THISFORMSET.frmModiProcess.AllowSub1.VALUE 	= 'Y'
					THISFORMSET.frmModiProcess.pPounds1.VALUE 	= tmpSO.Weight
					THISFORMSET.frmModiProcess.pQTY1.VALUE 		= tmpSO.S_QTY
					THISFORMSET.frmModiProcess.PU1.VALUE 		= tmpSO.PU
					
					THISFORMSET.frmModiProcess.Process_ID1.VALUE = "SELECTED"
					THISFORMSET.frmModiProcess.Processor1.VALUE	= ShowSQLtxt(SUBSTR(SYS(0),AT("#",SYS(0))+1),'Processor',20)
					THISFORMSET.frmModiProcess.Comment1.VALUE	= ShowSQLtxt(ALLTRIM(STR(tmpSO.Pieces))+"Pc "+ItemDescriptionMetric(tmpSO.Form, tmpSO.Thck, tmpSO.SZ2, tmpSO.SZ3, tmpSO.Weight, .F., .F.,'','','' ),'Comment',100)
		
					THISFORMSET.frmModiProcess.ogSOitem.Value = 1
					THISFORMSET.frmModiProcess.ogSOitem.Enabled = .T.
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .T.
					
					ThisFormset.frmModiProcess.SOITEM1.VISIBLE = .T.
					ThisFormset.frmModiProcess.WO1.VISIBLE = .T.
					ThisFormset.frmModiProcess.WO_Detail1.VISIBLE = .T.
					THISFORMSET.frmModiProcess.POitem1.Visible = .T.
					ThisFormset.frmModiProcess.lblSalesPerson1.Visible = .T.
					ThisFormset.frmModiProcess.SalesPerson1.Visible = .T.
					ThisFormset.frmModiProcess.lblstartDate1.Visible = .T.
					ThisFormset.frmModiProcess.StartDate1.Visible = .T.
					ThisFormset.frmModiProcess.lblDueDate1.Visible = .T.
					ThisFormset.frmModiProcess.DueDate1.Visible = .T.
					ThisFormset.frmModiProcess.lblAllowSub.VISIBLE = .T.
					ThisFormset.frmModiProcess.AllowSub1.VISIBLE = .T.
					ThisFormset.frmModiProcess.lblWeight1.Visible = .T.
					ThisFormset.frmModiProcess.pPounds1.Visible = .T.
					ThisFormset.frmModiProcess.lblQTY.Visible = .T.
					ThisFormset.frmModiProcess.pQTY1.Visible = .T.
					ThisFormset.frmModiProcess.PU1.Visible = .T.
					ThisFormset.frmModiProcess.lblProcess_ID1.Visible = .T.
					ThisFormset.frmModiProcess.Process_ID1.Visible = .T.
					ThisFormset.frmModiProcess.lblProcessor1.Visible = .T.
					ThisFormset.frmModiProcess.Processor1.Visible = .T.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.
		
					THISFORMSET.frmModiProcess.cmdSave.Enabled = .T.
					THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .F.
					THISFORMSET.frmModiProcess.cmdShowStockLst.Enabled = .F.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.			
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .F.
					
					*Set at beginning
					*ThisFormSet.frmModiProcess.ID1.Value =  pID
					*ThisFormSet.frmModiProcess.ID_Detail1.Value = nID_Detail
					*ThisFormSet.frmModiProcess.ID_Detail_Process1.Value = *
					*Set to 0 to Create!
					
					DO CASE
					CASE cTBL = "S"
						ThisFormSet.frmModiProcess.txtTBL.Value = "S"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create StockLst Process"
					CASE cTBL = "B"
						ThisFormSet.frmModiProcess.txtTBL.Value = "B"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify BrokerLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create BrokerLst Process"
					CASE cTBL = "W"
						ThisFormSet.frmModiProcess.txtTBL.Value = "W"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify WIPLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create WIPLst Process"
					ENDCASE
				ENDCASE
			ENDIF
			
			THISFORMSET.frmModiProcess.Processor1.VALUE	= ShowSQLtxt(SUBSTR(SYS(0),AT("#",SYS(0))+1),'Processor',20)
			THISFORMSET.frmModiProcess.VISIBLE = .T.
			
			ThisFormSet.SumProcess()
			
			THISFORMSET.frmModiProcess.StartDate1.SETFOCUS()
		ELSE
			MESSAGEBOX("no ID or ID_Detail for Create_StockLst_Process()",0+16,'No Parameters')
		ENDIF
		
		
		********************************************************
		**Check for correct SO on ID_Detail
		PRIVATE nSO, nWO
		nSO = PrepareSQLnum(ThisFormset.frmShop_StockLst_Edit.txtSO.Value,'SO',-3)
		nWO = PrepareSQLnum(ThisFormset.frmShop_StockLst_Edit.txtWO.Value,'WO',-3)
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		DO CASE
		CASE cTBL = "S"
			cSQL = "SELECT COUNT(*) AS cnt FROM dbo.StockLst_Process WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQL = "SELECT COUNT(*) AS cnt FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQL = "SELECT COUNT(*) AS cnt FROM dbo.WIPLst_Process WITH(NOLOCK) "
		ENDCASE
		cSQL = cSQL+ " WHERE "
		IF nSO > 0
			cSQL = cSQL+ " SOitem LIKE '%"+ALLTRIM(STR(nSO))+"-%' AND "
		ENDIF
		IF nWO > 0
			cSQL = cSQL+ " WO ="+ALLTRIM(STR(nWO))+" AND "
		ENDIF
		
		cSQL = cSQL+ " ID_Detail="+STR(nID_Detail)
		
		nSQLEXEC = SQLEXEC(THISFORMset.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpID_Detail_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		IF USED("tmpID_Detail_Process")
			IF VARTYPE(tmpID_Detail_Process.cnt) = "N"
				IF tmpID_Detail_Process.cnt > 0
					*Found with SO/WO and ID_Detail
				ELSE
					*MESSAGEBOX("This Process does not contain the Sales Order you started with.",0+48,"Warning, not SO:"+ALLTRIM(STR(nSO)))
					WAIT WINDOW "This Process does not contain the Sales Order \ Work Order you started with!" NOWAIT
				ENDIF
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		***********************************************
		*Check for Receiving Record
		PRIVATE lFoundRecvHist
		lFoundRecvHist = .F.
		
		PRIVATE cPOitem 
		cPOitem = PrepareSQLtxt(THISFORMSET.frmModiProcess.POitem1.VALUE,'POitem',12)
		
		IF NOT Proper_PO_item(cPOitem) = Proper_PO_item('')
			IF USED("tmpCntReceiving")
				USE IN tmpCntReceiving
			ENDIF
			SELECT 0
		
			cSQL = "SELECT StockTable,ID_Detail FROM dbo.Receiving WITH(NOLOCK) "
			cSQL = cSQL+ " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		
			nSQLEXEC = SQLEXEC(THISFORMset.nConnHandle, cSQL, 'tmpCntReceiving' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpCntReceiving' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntReceiving")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntReceiving")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCntReceiving')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			IF USED("tmpCntReceiving")
				IF RECCOUNT('tmpCntReceiving') > 0
					*Found Poitem
					
					SCAN
						*cTBL
						IF nID_Detail = PrepareSQLnum(tmpCntReceiving.ID_Detail,'ID_Detail',-3)
							lFoundRecvHist = .T.
						ENDIF
					ENDSCAN		
					
					IF lFoundRecvHist 
						*Found PO in Receiving
						ThisFormset.frmModiProcess.cmdReceiving.Enabled = .F.
					ELSE
						ThisFormset.frmModiProcess.cmdReceiving.Enabled = .T.
						MESSAGEBOX("This 'Process / PO' number "+CHR(13)+"does not contain Receiving Record.",0+48,"Warning, not RECEIVED yet!")
					ENDIF
				ENDIF
				USE IN tmpCntReceiving
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Destroy
