	PROCEDURE show_po
		PARAMETERS cSHOW
		*ThisForm.Show_PO()
		
		IF VARTYPE(cShow) != "C"
			RETURN .f.
		ENDIF
		
		DO CASE
		CASE cShow = "VISIBLE"
			ThisForm.grdWO_P.Visible = .T.
			
		CASE cShow = "INVISIBLE"
			ThisForm.grdWO_P.Visible = .F.
		
		ENDCASE
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpWO_S')
			USE IN tmpWO_S
		ENDIF
		IF USED('tmpWO_P')
			USE IN tmpWO_P
		ENDIF
		IF USED('tmpSO_Proc')
			USE IN tmpSO_Proc
		ENDIF
		
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		*IF ThisForm.pFunction = "GET" OR ThisForm.pFunction = "SELECT" OR ThisForm.pFunction = "SEL_WO"
		*	RETURN This.nReturnID_Detail
		*ELSE
			RETURN 
		*ENDIF
	ENDPROC

	PROCEDURE cmdAddWOtoPOitem.Click
		
		*****************************
		RETURN
		*****************************
		
		PRIVATE nMess, nWO
		nMess = 0
		nWO = PrepareSQLnum(ThisForm.txtWO_P.Value,'WO',-3)
		
		IF nWO > 0
			MESSAGEBOX("Already have WO on this Process",0+48,"Cannot Add WO")
			RETURN .f.
		ENDIF
		
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		IF nWO > 0
		
		
			nMess = MESSAGEBOX("Are you sure you want to Add this WO "+CHR(13)+STR(nWO)+" to this Process?",4+32,"Add WO")
			
			IF nMess = 6
		
				PRIVATE nID_Detail_Process
				nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
				IF StockLst_Process_Add_WO( nID_Detail_Process, nWO, ThisForm.nConnHandle )
					WAIT WINDOW "Complete" TIMEOUT 1
					
					ThisForm.Show_grdSO_Proc()
					
				ENDIF
			ENDIF	
		ELSE
			MESSAGEBOX("No WO listed with this SOitem!"+CHR(13)+"WO not Found!",48,"Cannot Add WO")
		ENDIF
		
	ENDPROC

