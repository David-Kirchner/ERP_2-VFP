	PROCEDURE show_grdso_proc
		*ThisForm.Show_grdSO_Proc()
		
		
		ThisForm.grdSO_Proc.RecordSource = ''
		
		IF USED("tmpWO_S")	
			IF RECCOUNT("tmpWO_S") > 0
				IF Proper_SO_item(tmpWO_S.SOitem) != Proper_SO_item("")
				
					IF USED("tmpSO_Proc")	
						USE IN tmpSO_Proc
					ENDIF
					SELECT 0
		
					cSQL = "SELECT * FROM dbo.StockLst_Process "
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+tmpWO_S.SOitem+"')"
					
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Proc')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Proc')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_Proc")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_Proc")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSO_Proc')
					ENDIF
					IF USED('tmpSO_Proc')
						IF RECCOUNT('tmpSO_Proc') > 0
							lWOPexists = .T.
						ENDIF
						*USE IN tmpWO_S
		
					ENDIF
		
				ENDIF
		
				ThisForm.grdSO_Proc.RecordSource = 'tmpSO_Proc'
				ThisForm.grdSO_Proc.Column1.Header1.Caption = 'SOitem'
				ThisForm.grdSO_Proc.Column1.ControlSource = 'tmpSO_Proc.SOitem'
				ThisForm.grdSO_Proc.Refresh
				
			ENDIF
		ENDIF
		
		ThisForm.RefreshSO_Proc()
	ENDPROC

	PROCEDURE show_grdwo_p
		*ThisForm.Show_grdWO_P()
		
		ThisForm.Show_PO("INVISIBLE")
		
		ThisForm.grdWO_P.RecordSource = ''
		
		IF USED("tmpWO_P")	
			IF RECCOUNT("tmpWO_P")>0
			*	SELECT SOitem FROM tmpWO_S 
				ThisForm.grdWO_P.RecordSource = 'tmpWO_P'
				ThisForm.grdWO_P.Column1.Header1.Caption = 'POitem'
				ThisForm.grdWO_P.Column1.ControlSource = 'tmpWO_P.POitem'
				ThisForm.grdWO_P.Refresh
				
				ThisForm.Show_PO("VISIBLE")
			ENDIF
		ENDIF
		
		ThisForm.RefreshWO_P()
	ENDPROC

