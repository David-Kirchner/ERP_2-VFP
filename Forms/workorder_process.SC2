	PROCEDURE cmdCreatePO_SOdist.Click
		MESSAGEBOX("Please use the PurchaseOrder form to Create the SO_Distribution",0+64,"Cannot do here.")
		*****************************
		RETURN
		*****************************
		*PARAMETER pFunction,pAlloy,pForm,pCC,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pTBL,pQTY,pRL
		PRIVATE m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nPieces,m.nWeight
		PRIVATE m.cSalesP,m.dStartDate,m.dDueDate,m.cCover, m.cOtherFld
		
		PRIVATE m.nWO, m.cSOItem
		nWO  		= PrepareSQLnum(thisForm.txtWO.Value,'WO',-3)
		m.cSOItem	= PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		
		IF Proper_SO_item(m.cSOitem) = Proper_SO_item('')
			MESSAGEBOX("Cannot Create a Process without a SOitem"+CHR(13)+"Create A Sales Order First!",0+48,"Cannot Create.")
			RETURN .F.
		ENDIF
		
		nMess = MESSAGEBOX("Will this PO process use all of the PO item"+CHR(13)+"or just a part of?",0+32,"All of PO item")
		
		*****************************
		RETURN
		*****************************
		
		**Check to See if SOitem already in StockLst_Process
		IF StockLst_Process_Count_SOitem( cSOitem, ThisForm.nConnHandle ) > 0
			MESSAGEBOX("Caution: this SOitem is already being use a Process agains Stock!"+CHR(13)+"Do not Duplicate on the same Stock!",0+64,"SOitem found against Stock")
		ENDIF
		
		PRIVATE lOK 
		lOK = .F.
		
		*Get Sales details
		PRIVATE cSQL, nSQLEXEC
		IF USED('tmpAQ')
			USE IN tmpAQ
		ENDIF
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		SELECT 0
		cSQL = "SELECT Alloy,Form,Thck,Sz2,Sz3,SalesP,SaleDate,Weight,Pieces,ShipDue "
		cSQL = cSQL + ",Cover ,SalesNum, OtherFld "
		cSQL = cSQL + " FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQ' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQ' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQ")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQ")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpAQ')
		*	RETURN 0
		ELSE
			IF USED('tmpAQ')
				IF RECCOUNT('tmpAQ') > 0
					m.cAlloy	= PrepareSQLtxt(tmpAQ.Alloy,'Alloy',12)
					m.cForm		= PrepareSQLtxt(tmpAQ.Form,'Form',2)
					m.cCC		= PrepareSQLtxt(tmpAQ.CC,'CC',1)
					m.cCL		= PrepareSQLtxt(tmpAQ.CL,'CL',1)
					m.nThck		= PrepareSQLnum(tmpAQ.Thck,'Thck',9,4)
					m.nSz2		= PrepareSQLnum(tmpAQ.Sz2,'Sz2',8,3)
					m.nSz3		= PrepareSQLnum(tmpAQ.Sz3,'Sz3',8,3)
					m.nPieces	= PrepareSQLnum(tmpAQ.Pieces,'Pieces',-3)
					m.nWeight	= PrepareSQLnum(tmpAQ.Weight,'Weight',7,1)
					
					m.cSalesP	= PrepareSQLtxt(tmpAQ.SalesP,'SalesP',1)
					m.dStartDate= PrepareSQLDate(tmpAQ.SaleDate,'SaleDate')
					m.dDueDate	= PrepareSQLDate(tmpAQ.ShipDate,'ShipDate')
					m.cCover	= PrepareSQLtxt(tmpAQ.Cover,'Cover',1) 
					m.nSalesNum = PrepareSQLnum(tmpAQ.SalesNum,'SalesNum',-3)
					m.cOtherFld	= PrepareSQLtxt(tmpAQ.OtherFld,'OtherFld',10) 
					lOK = .T.
				ENDIF
				USE IN tmpAQ
			ENDIF
		ENDIF
		
		IF NOT lOK 
			MESSAGEBOX("Could not get the Quote data for this SOitem:'"+m.cSOitem+"'",0+16,"Cannot Create Process")
			RETURN .F.
		ENDIF
		
		PRIVATE nQTY 
		nQTY 	= Calc_QTY(m.cAlloy,m.cForm,m.nPieces,m.nThck,m.nSz2,m.nSz3,m.cOtherFld,ThisForm.nConnHandle)
		PRIVATE nHPAPO
		nHPAPO = VAL(cPoItem)
		PRIVATE cTBL
		cTBL = "S"
		
		IF nWO > 0
			m.nSalesNum	= nWO
		ENDIF
			
		**********************
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		SELECT 0
		
		
		*	(SalesNum N(7), SOItem C(10), PO_num C(17), PCs N(10), Alloy C(12), Heat C(30), DESCRIPT C(80), Weight N(7,1), Kg L, PackWeight N(7,1);
		*	, PackingSli N(10) ,COMPLETE L, PartNo C(100), qShipped N(10), qBackOrder N(10) )
		PRIVATE cMEM
		cMEM = IIF( "\MEM" $ SYS(2003),'','\MEM')
		
		CREATE TABLE (SYS(5)+SYS(2003)+cMEM+"\"+"SalesQuote") FREE ;
			(Alloy C(12),Form C(2),CC C(1),CL C(1),Thck N(10,4),Sz2 N(9,3),Sz3 N(9,3),SalesP C(1),SaleDate D,Weight N(7,1),Pieces N(10),ShipDue D,SOItem_a C(10),Cover C(1))
		*LEFT( REPLACE(suser_sname(),'WINDFALL\',''),20)
		*SELECT Alloy,Form,Thck,Sz2,Sz3,SalesP,SaleDate,Weight,Pieces,ShipDue FROM SalesQuote WHERE SOItem_a = cSOitem	
		IF USED('SalesQuote')
			SELECT SalesQuote
			IF RECCOUNT('SalesQuote') = 0
				INSERT BLANK
			ENDIF
			REPLACE Alloy WITH cAlloy
			REPLACE Form WITH m.cForm
			REPLACE CC WITH m.cCC
			REPLACE CL WITH m.cCL
			REPLACE Thck WITH m.nThck
			REPLACE Sz2 WITH m.nSz2
			REPLACE Sz3 WITH m.nSz3
			REPLACE SalesP WITH m.cSalesP
			REPLACE SaleDate WITH m.dStartDate
			REPLACE Weight WITH m.nWeight
			REPLACE Pieces WITH m.nPieces
			REPLACE ShipDue WITH m.dDueDate
			REPLACE SOItem_a WITH m.cSOitem
			REPLACE Cover WITH m.cCover
			*NewSO_bySO_Finish() NewSO_byPO_Finish() Uses AllQuotes.Cover for frmWorkOrder.txtSalesRep
		ENDIF
		
		PRIVATE pID_Detail, m.nID
		m.nID = 0
		
		PRIVATE cWhat
		cWhat = "ADD_WO"
		
		*old DO FORM Forms\StockLst_SQL_Quotes WITH cWhat,cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''     ,nQTY,.F. TO pID_Detail
		DO FORM Forms\StockLst_SQL_Modal WITH cWhat,cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''     ,nQTY,.F.,'' TO pID_Detail
		*Modal waits for a Return  PARAMETER pFunction,pTBL,  pAlloy,  pForm,  pCC,  pCL,  pThck,  pSz2,  pSz3,pSOItem, pSalesNum,      pPC,    pLBS,pHeatLot,pQTY,pRL,pPOitem
		*																									 	     SaleNum = WO
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		*refresh
		ThisForm.Show_grdSO_Proc()
		
		*!*	PRIVATE lOverWrite
		*!*	lOverWrite = .T.
		
		*!*	IF TYPE("pID_Detail") = "N"
		*!*		IF pID_Detail > 0
		*!*			*Get StockLst
		*!*		
		*!*			PRIVATE cSQL, nSQLEXEC
		*!*			cSQL = "SELECT m.ID,Alloy,Form,CC,CL,PC,Dim1,Dim2,Dim3,Weight,D.ID_Detail"
		*!*			cSQL = cSQL +" FROM dbo.StockLst_Detail D "
		*!*			cSQL = cSQL +" JOIN dbo.StockLst_Master M ON m.id = D.ID "
		*!*			cSQL = cSQL +" WHERE ID_Detail = "+STR(pID_Detail)
		
		*!*			IF USED("tmpStockLst_Detail")
		*!*				SELECT tmpStockLst_Detail
		*!*			ELSE
		*!*				SELECT 0
		*!*			ENDIF
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLst_Detail')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStockLst_Detail')
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQ")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQ")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail')
		*!*			ELSE
		*!*				IF USED("tmpStockLst_Detail")
		*!*					*nID			 			= tmpStockLst_Detail.ID
		*!*					nID_Detail					= tmpStockLst_Detail.ID_Detail
		*!*					ThisForm.txtID_Detail.Value = tmpStockLst_Detail.ID_Detail
		*!*					
		*!*					IF NOT EMPTY(ThisForm.txtAlloy.Value)
		*!*						IF MESSAGEBOX("Do you want to overwrite these Starting dimensions"+CHR(13)+"with the choosen Stock dimensions?",4+32,"Overwrite?") = 6
		*!*							lOverWrite = .T.
		*!*						ELSE
		*!*							lOverWrite = .F.
		*!*						ENDIF
		*!*					ENDIF
		*!*					IF lOverWrite 
		*!*						IF MESSAGEBOX("Do you want to use Alloy:"+ALLTRIM(tmpStockLst_Detail.Alloy)+"?",4+32,"Overwrite?") = 6
		*!*							ThisForm.txtAlloy.Value		= tmpStockLst_Detail.Alloy
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Form:"+ALLTRIM(tmpStockLst_Detail.Form)+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.cmbForm.Value		= tmpStockLst_Detail.Form
		*!*						ENDIf
		*!*						IF MESSAGEBOX("Do you want to use CC:"+ALLTRIM(tmpStockLst_Detail.CC)+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.cmbCC.Value		= tmpStockLst_Detail.CC
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Pc:"+ALLTRIM(STR(tmpStockLst_Detail.PC))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtPieces.Value	= tmpStockLst_Detail.PC
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Thck:"+ALLTRIM(STR(tmpStockLst_Detail.Dim1,10,4))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtThck.Value		= tmpStockLst_Detail.Dim1
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Sz2:"+ALLTRIM(STR(tmpStockLst_Detail.Dim2,9,3))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtSz2.Value		= tmpStockLst_Detail.Dim2
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Sz3:"+ALLTRIM(STR(tmpStockLst_Detail.Dim3,9,3))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtSz3.Value		= tmpStockLst_Detail.Dim3
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Weight:"+ALLTRIM(STR(tmpStockLst_Detail.Weight,7,1))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtWeight.Value	= tmpStockLst_Detail.Weight
		*!*						ENDIF
		*!*					ENDIF
		*!*									
		*!*					ThisFormSet.SaveStockLstID_Detail("START",nID_Detail) &&nID_Detail_Process
		*!*					
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			IF USED("tmpStockLst_Detail")
		*!*				USE IN tmpStockLst_Detail
		*!*			ENDIF
		*!*				
		*!*		ENDIF
		*!*	ENDIF
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE cmdCreateProcessSOitem.Click
		
		PRIVATE m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,m.cSOItem,m.nSalesNum,m.nPieces,m.nWeight
		PRIVATE m.cSalesP,m.dStartDate,m.dDueDate,m.cCover,m.cOtherFld
		
		PRIVATE m.nWO, m.cSOItem
		nWO  		= PrepareSQLnum(thisForm.txtWO.Value,'WO',-3)
		m.cSOItem	= PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		
		IF Proper_SO_item(m.cSOitem) = Proper_SO_item('')
			MESSAGEBOX("Cannot Create a Process without a SOitem"+CHR(13)+"Create A Sales Order First!",0+48,"Cannot Create.")
			RETURN .F.
		ENDIF
		
		**Check to See if SOitem already in StockLst_Process
		IF StockLst_Process_Count_SOitem( cSOitem, ThisForm.nConnHandle ) > 0
			MESSAGEBOX("Caution: this SOitem is already being use a Process agains Stock!"+CHR(13)+"Do not Duplicate on the same Stock!",0+64,"SOitem found against Stock")
		ENDIF
		
		PRIVATE lOK 
		lOK = .F.
		
		*Get Sales details
		PRIVATE cSQL, nSQLEXEC
		IF USED('tmpAQ')
			USE IN tmpAQ
		ENDIF
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		SELECT 0
		cSQL = "SELECT Alloy,Form,Thck,Sz2,Sz3,SalesP,SaleDate,Weight,Pieces,ShipDue "
		cSQL = cSQL + ",Cover ,SalesNum, OtherFld "
		cSQL = cSQL + " FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+m.cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQ' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQ' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQ")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQ")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpAQ')
		*	RETURN 0
		ELSE
			IF USED('tmpAQ')
				IF RECCOUNT('tmpAQ') > 0
					m.cAlloy	= PrepareSQLtxt(tmpAQ.Alloy,'Alloy',12)
					m.cForm		= PrepareSQLtxt(tmpAQ.Form,'Form',2)
					m.cCC		= PrepareSQLtxt(tmpAQ.CC,'CC',1)
					m.cCL		= PrepareSQLtxt(tmpAQ.CL,'CL',1)
					m.nThck		= PrepareSQLnum(tmpAQ.Thck,'Thck',9,4)
					m.nSz2		= PrepareSQLnum(tmpAQ.Sz2,'Sz2',8,3)
					m.nSz3		= PrepareSQLnum(tmpAQ.Sz3,'Sz3',8,3)
					m.nPieces	= PrepareSQLnum(tmpAQ.Pieces,'Pieces',-3)
					m.nWeight	= PrepareSQLnum(tmpAQ.Weight,'Weight',7,1)
					
					m.cSalesP	= PrepareSQLtxt(tmpAQ.SalesP,'SalesP',1)
					m.dStartDate= PrepareSQLDate(tmpAQ.SaleDate,'SaleDate')
					m.dDueDate	= PrepareSQLDate(tmpAQ.ShipDate,'ShipDate')
					m.cCover	= PrepareSQLtxt(tmpAQ.Cover,'Cover',1) 
					m.nSalesNum = PrepareSQLnum(tmpAQ.SalesNum,'SalesNum',-3)
					m.cOtherFld	= PrepareSQLtxt(tmpAQ.OtherFld,'OtherFld',10) 
					lOK = .T.
				ENDIF
				USE IN tmpAQ
			ENDIF
		ENDIF
		
		IF NOT lOK 
			MESSAGEBOX("Could not get the Quote data for this SOitem:'"+m.cSOitem+"'",0+16,"Cannot Create Process")
			RETURN .F.
		ENDIF
		
		PRIVATE nQTY 
		nQTY 	= Calc_QTY(m.cAlloy,m.cForm,m.nPieces,m.nThck,m.nSz2,m.nSz3,m.cOtherFld,ThisForm.nConnHandle)
		PRIVATE nHPAPO
		nHPAPO = VAL(cPoItem)
		PRIVATE cTBL
		cTBL = "S"
		
		IF nWO > 0
			m.nSalesNum	= nWO
		ENDIF
			
		**********************
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		SELECT 0
		
		
		*	(SalesNum N(7), SOItem C(10), PO_num C(17), PCs N(10), Alloy C(12), Heat C(30), DESCRIPT C(80), Weight N(7,1), Kg L, PackWeight N(7,1);
		*	, PackingSli N(10) ,COMPLETE L, PartNo C(100), qShipped N(10), qBackOrder N(10) )
		
		PRIVATE cMEM
		cMEM = IIF( "\MEM" $ SYS(2003),'','\MEM')
		
		CREATE TABLE (SYS(5)+SYS(2003)+cMEM+"\"+"SalesQuote") FREE ;
			(Alloy C(12),Form C(2),CC C(1),CL C(1),Thck N(10,4),Sz2 N(9,3),Sz3 N(9,3),SalesP C(1),SaleDate D,Weight N(7,1),Pieces N(10),ShipDue D,SOItem_a C(10),Cover C(1))
		*LEFT( REPLACE(suser_sname(),'WINDFALL\',''),20)
		*SELECT Alloy,Form,Thck,Sz2,Sz3,SalesP,SaleDate,Weight,Pieces,ShipDue FROM SalesQuote WHERE SOItem_a = cSOitem	
		IF USED('SalesQuote')
			SELECT SalesQuote
			IF RECCOUNT('SalesQuote') = 0
				INSERT BLANK
			ENDIF
			REPLACE Alloy WITH cAlloy
			REPLACE Form WITH m.cForm
			REPLACE CC WITH m.cCC
			REPLACE CL WITH m.cCL
			REPLACE Thck WITH m.nThck
			REPLACE Sz2 WITH m.nSz2
			REPLACE Sz3 WITH m.nSz3
			REPLACE SalesP WITH m.cSalesP
			REPLACE SaleDate WITH m.dStartDate
			REPLACE Weight WITH m.nWeight
			REPLACE Pieces WITH m.nPieces
			REPLACE ShipDue WITH m.dDueDate
			REPLACE SOItem_a WITH m.cSOitem
			REPLACE Cover WITH m.cCover
			*NewSO_bySO_Finish() NewSO_byPO_Finish() Uses AllQuotes.Cover for frmWorkOrder.txtSalesRep
		ENDIF
		
		PRIVATE pID_Detail, m.nID
		m.nID = 0
		
		PRIVATE cWhat
		cWhat = "ADD_WO"
		
		*old DO FORM Forms\StockLst_SQL_Quotes WITH cWhat,cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''     ,nQTY,.F. TO pID_Detail
		*DO FORM Forms\StockLst_SQL_Browse WITH cWhat,cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''     ,nQTY,.F.,'' TO pID_Detail
		DO FORM Forms\StockLst_SQL_Modal WITH cWhat,cTBL,m.cAlloy,m.cForm,m.cCC,m.cCL,m.nThck,m.nSz2,m.nSz3,cSOItem ,nSalesNum,m.nPieces,m.nWeight,''     ,nQTY,.F.,'' TO pID_Detail
		*Modal wait for a retun         PARAMETER pFunction,pTBL,  pAlloy,  pForm,  pCC,  pCL,  pThck,  pSz2,  pSz3,pSOItem ,pSalesNum,      pPC,    pLBS,pHeatLot,pQTY,pRL,pPOitem
		*																							 	  			   SaleNum = WO
		IF USED('SalesQuote')
			USE IN SalesQuote
		ENDIF
		
		*refresh
		ThisForm.Show_grdSO_Proc()
		
		*!*	PRIVATE lOverWrite
		*!*	lOverWrite = .T.
		
		*!*	IF TYPE("pID_Detail") = "N"
		*!*		IF pID_Detail > 0
		*!*			*Get StockLst
		*!*		
		*!*			PRIVATE cSQL, nSQLEXEC
		*!*			cSQL = "SELECT m.ID,Alloy,Form,CC,CL,PC,Dim1,Dim2,Dim3,Weight,D.ID_Detail"
		*!*			cSQL = cSQL +" FROM dbo.StockLst_Detail D "
		*!*			cSQL = cSQL +" JOIN dbo.StockLst_Master M ON m.id = D.ID "
		*!*			cSQL = cSQL +" WHERE ID_Detail = "+STR(pID_Detail)
		
		*!*			IF USED("tmpStockLst_Detail")
		*!*				SELECT tmpStockLst_Detail
		*!*			ELSE
		*!*				SELECT 0
		*!*			ENDIF
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpStockLst_Detail')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,	cSQL, 'tmpStockLst_Detail')
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQ")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQ")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail')
		*!*			ELSE
		*!*				IF USED("tmpStockLst_Detail")
		*!*					*nID			 			= tmpStockLst_Detail.ID
		*!*					nID_Detail					= tmpStockLst_Detail.ID_Detail
		*!*					ThisForm.txtID_Detail.Value = tmpStockLst_Detail.ID_Detail
		*!*					
		*!*					IF NOT EMPTY(ThisForm.txtAlloy.Value)
		*!*						IF MESSAGEBOX("Do you want to overwrite these Starting dimensions"+CHR(13)+"with the choosen Stock dimensions?",4+32,"overwrite?") = 6
		*!*							lOverWrite = .T.
		*!*						ELSE
		*!*							lOverWrite = .F.
		*!*						ENDIF
		*!*					ENDIF
		*!*					IF lOverWrite 
		*!*						IF MESSAGEBOX("Do you want to use Alloy:"+ALLTRIM(tmpStockLst_Detail.Alloy)+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtAlloy.Value		= tmpStockLst_Detail.Alloy
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Form:"+ALLTRIM(tmpStockLst_Detail.Form)+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.cmbForm.Value		= tmpStockLst_Detail.Form
		*!*						ENDIf
		*!*						IF MESSAGEBOX("Do you want to use CC:"+ALLTRIM(tmpStockLst_Detail.CC)+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.cmbCC.Value		= tmpStockLst_Detail.CC
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use CL:"+ALLTRIM(tmpStockLst_Detail.CL)+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.cmbCL.Value		= tmpStockLst_Detail.CL
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Pc:"+ALLTRIM(STR(tmpStockLst_Detail.PC))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtPieces.Value	= tmpStockLst_Detail.PC
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Thck:"+ALLTRIM(STR(tmpStockLst_Detail.Dim1,10,4))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtThck.Value		= tmpStockLst_Detail.Dim1
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Sz2:"+ALLTRIM(STR(tmpStockLst_Detail.Dim2,9,3))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtSz2.Value		= tmpStockLst_Detail.Dim2
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Sz3:"+ALLTRIM(STR(tmpStockLst_Detail.Dim3,9,3))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtSz3.Value		= tmpStockLst_Detail.Dim3
		*!*						ENDIF
		*!*						IF MESSAGEBOX("Do you want to use Weight:"+ALLTRIM(STR(tmpStockLst_Detail.Weight,7,1))+"?",4+32,"overwrite?") = 6
		*!*							ThisForm.txtWeight.Value	= tmpStockLst_Detail.Weight
		*!*						ENDIF
		*!*					ENDIF
		*!*									
		*!*					ThisFormSet.SaveStockLstID_Detail("START",nID_Detail) &&nID_Detail_Process
		*!*					
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			IF USED("tmpStockLst_Detail")
		*!*				USE IN tmpStockLst_Detail
		*!*			ENDIF
		*!*				
		*!*		ENDIF
		*!*	ENDIF
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE cmdDeletePO_SO_Dist.Click
		PRIVATE nWO, cPO_item
		nWO = PrepareSQLnum(ThisForm.txtDWO.Value,'WO',-3)
		cPOitem = PrepareSQLtxt(ThisForm.PO_item.Value,'POitem',12)
		
		IF nWO = 0
			MESSAGEBOX("There is no WO on the PO SO_Dist to Delete.",0+16,"")
			RETURN .F.
		ENDIF
		
		
		
		PRIVATE nMess
		nMess = 0
		
		IF nWO > 0
			nMess = MESSAGEBOX("Are you sure you want to Deletethis WO "+CHR(13)+STR(nWO)+" from this Purchase Order '"+ALLTRIM(cPOitem)+"' ?",4+32,"Remove WO")
			
			IF nMess = 6
				*Remove WO from this PurchaseOrder
				IF PurchaseOrder_SO_Dist_Delete( cPOitem, WO, ThisForm.nConnHandle )
					WAIT WINDOW "Complete" TIMEOUT 1
					
					ThisForm.get_tmpWO_P(1)
					
				ENDIF
			ENDIF	
		ELSE
			MESSAGEBOX("No WO listed with this Process!",48,"Cannot Delete")
		ENDIF
		
	ENDPROC

	PROCEDURE cmdDeleteProcess.Click
		PRIVATE nMess, nWO
		nMess = 0
		nWO = PrepareSQLnum(ThisForm.txtWO_P.Value,'WO',-3)
		
		IF nWO > 0
			nMess = MESSAGEBOX("Are you sure you want to Delete this StockLst Process?",4+32,"Remove StockLst Process?")
			
			IF nMess = 6
				*Remove WO from this Process
				PRIVATE nID_Detail_Process
				nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
				
				IF StockLst_Process_Delete( nID_Detail_Process, ThisForm.nConnHandle )
					WAIT WINDOW "Complete" TIMEOUT 1
					
					ThisForm.Show_grdSO_Proc()
					
				ENDIF
			ENDIF	
		ELSE
			MESSAGEBOX("No WO listed with this Process!",48,"Cannot Remove")
		ENDIF
		
	ENDPROC

	PROCEDURE cmdPOitemHelp.Click
		PRIVATE cMess
		cMess = "A Purchase Order is be marked to be associated with a WO. " 
		cMess = cMess + "Metal brought in for Production is to be marked with the WO number. "
		cMess = cMess + "Evan thou the PO is marked, a Sales Order to HPA must be written so the metal has a historical recording of being received then consumed by the Sales Order. "
		cMess = cMess + "Internal parts like 'Dies' and external Processing PO's are to be marked with this WO. "
		cMess = cMess + CHR(13)+CHR(13)+"By marking all Material with this WO:"+ALLTRIM(STR(ThisForm.nWO))+" full Production work can be accounted for. "
		MESSAGEBOX(cMess,+064,"This screen is about this WO and what this WO touches. ")
	ENDPROC

	PROCEDURE cmdPO_SOhelp.Click
		PRIVATE cMess
		cMess = "A Purchase Order is be marked to be associated with a WO. " 
		cMess = cMess + "When only a part of the POitem is used for the WO or SO, The PO can be divided up. "
		cMess = cMess + "This will be show as the 'PO SO dist'. "
		cMess = cMess + "Try to make the Distribution of the PO accurate knowing only Quantity, Price per Quantity and its Total is all that is recorded in the distribution. "
		cMess = cMess + "A the POitem Total is listed for comparison. "
		cMess = cMess + "A POitem fully consumed for this WO does not need to be Divided up / Distributed. "
		cMess = cMess + CHR(13)+CHR(13)+"By marking all Material with this WO:"+ALLTRIM(STR(ThisForm.nWO))+" full Production work can be accounted for. "
		MESSAGEBOX(cMess,+064,"This screen is about the WO and what this WO touches. ")
	ENDPROC

	PROCEDURE cmdRemoveWO.Click
		PRIVATE nMess, nWO
		nMess = 0
		nWO = PrepareSQLnum(ThisForm.txtWO_P.Value,'WO',-3)
		
		IF nWO > 0
			nMess = MESSAGEBOX("Are you sure you want to Remove this WO "+CHR(13)+STR(nWO)+" from this Process?",4+32,"Remove WO")
			
			IF nMess = 6
				*Remove WO from this Process
				PRIVATE nID_Detail_Process
				nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
				IF StockLst_Process_Remove_WO( nID_Detail_Process, ThisForm.nConnHandle )
					WAIT WINDOW "Complete" TIMEOUT 1
					
					ThisForm.Show_grdSO_Proc()
					
				ENDIF
			ENDIF	
		ELSE
			MESSAGEBOX("No WO listed with this Process!",48,"Cannot Remove")
		ENDIF
		
	ENDPROC

	PROCEDURE cmdRemoveWO_PO.Click
		PRIVATE nWO, cPO_item
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		cPOitem = PrepareSQLtxt(ThisForm.PO_item.Value,'POitem',12)
		
		IF nWO = 0
			MESSAGEBOX("There is no WO on the POitem to Remove.",0+16,"")
			RETURN .F.
		ENDIF
		
		
		
		PRIVATE nMess
		nMess = 0
		
		IF nWO > 0
			nMess = MESSAGEBOX("Are you sure you want to Remove this WO "+CHR(13)+STR(nWO)+" from this Purchase Order '"+ALLTRIM(cPOitem)+"' ?",4+32,"Remove WO")
			
			IF nMess = 6
				*Remove WO from this PurchaseOrder
				IF PurchaseOrder_Remove_WO( cPOitem, WO, ThisForm.nConnHandle )
					WAIT WINDOW "Complete" TIMEOUT 1
					
					ThisForm.get_tmpWO_P(1)
					
				ENDIF
			ENDIF	
		ELSE
			MESSAGEBOX("No WO listed with this Process!",48,"Cannot Remove")
		ENDIF
		
	ENDPROC

	PROCEDURE cmdRemoveWO_SO_Dist.Click
		PRIVATE nWO, cPO_item
