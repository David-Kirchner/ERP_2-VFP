	PROCEDURE get_tmpwo_p
		PARAMETERS nPara
		*ThisForm.get_tmpWO_P()
		
		IF USED("tmpWO_P")	
			USE IN tmpWO_P
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = " SELECT Company,P.POitem,P.SOitem,SalesP,Alloy,P.WO "
		cSQL = cSQL + ",dbo.f_DescriptCL(Alloy,CC,CL,Form,Thck,Sz2,Sz3,StockLst_QTY,RandLen) AS Descript "
		cSQL = cSQL + ",OrderDate, dbo.f_BestDate( dbo.f_BestDate(Due_Min,Due_Max), dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max) ) AS DueDate "
		cSQL = cSQL + ",Delivered,Cancelled,Reconciled,Cond_Spec "
		cSQL = cSQL + ",P.Order_QTY, P.Order_P "
		cSQL = cSQL + ",P.StockLst_QTY, P.StockLst_P, ISNULL(P.StockLst_PU,dbo.f_GetFormPU(P.Form)) AS StockLst_PU "
		cSQL = cSQL + ",ISNULL(P.StockLst_Total,dbo.f_GetPOItem_Total(P.POItem)) AS StockLst_Total "
		cSQL = cSQL + ",D.ID,D.QTY,D.P,D.Total,D.WO AS DWO "
		cSQL = cSQL + "FROM dbo.PurchaseOrder P "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.PO_SOdist d ON d.POitem = P.POitem "
		cSQL = cSQL + "WHERE P.WO = "+STR(nWO)
		cSQL = cSQL + " OR D.WO = "+STR(nWO)
		IF Proper_PO_item(ThisForm.cPOItem) != Proper_PO_item("")
			cSQL = cSQL + " OR P.POitem = dbo.f_ProperPOitem('"+ThisForm.cPOItem+"')"
			cSQL = cSQL + " OR D.POitem = dbo.f_ProperPOitem('"+ThisForm.cPOItem+"')"
		ENDIF
		IF Proper_SO_item(ThisForm.cSOItem) != Proper_SO_item("")
			cSQL = cSQL + " OR P.SOitem = dbo.f_ProperSOitem('"+ThisForm.cSOItem+"')"
			cSQL = cSQL + " OR D.SOitem = dbo.f_ProperSOitem('"+ThisForm.cSOItem+"')"
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_P')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_P')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_P")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_P")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpWO_P')
		ENDIF
		IF USED('tmpWO_P')
			IF RECCOUNT('tmpWO_P') > 0
				lWOPexists = .T.
			ENDIF
			*USE IN tmpWO_S
		ENDIF
		
		
		IF lWOPexists 
			ThisForm.Show_grdWO_P()
		ENDIF
	ENDPROC

	PROCEDURE get_tmpwo_s
		PARAMETERS nPara
		*ThisForm.get_tmpWO_S()
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpWO_S")	
			USE IN tmpWO_S
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.Sales "
		cSQL = cSQL + " WHERE WO = "+STR(nWO)
		IF Proper_SO_item(ThisForm.cSOItem) != Proper_SO_item("")
			cSQL = cSQL + " OR SOitem = dbo.f_ProperSOitem('"+ThisForm.cSOItem+"')"
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_S')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_S')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_S")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_S")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpWO_S')
		ENDIF
		IF USED('tmpWO_S')
			IF RECCOUNT('tmpWO_S') > 0
				lWOSexists = .T.
			ENDIF
		ENDIF
		
		
		IF lWOSexists 
			ThisForm.Show_grdWO_S()
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER  nWO, cSOItem, cPoItem, cTBL, nID_Detail, nID_Detail_Process
		
		IF VARTYPE(nWO) != 'N'
			ThisForm.nWO = 1012
			nWO = 1012
			*RETURN .F.
		ELSE
			ThisForm.nWO = nWO
		ENDIF
		ThisForm.Caption = ThisForm.Caption + " :"+ALLTRIM(STR( nWO ))
		
		IF VARTYPE(cSOItem) != 'C'
			ThisForm.cSOItem = ''
		ELSE
			ThisForm.cSOItem = cSOItem
		ENDIF
		
		IF VARTYPE(cPoItem) != 'C'
			ThisForm.cPoItem = ''
		ELSE
			ThisForm.cPoItem = cPoItem
		ENDIF
		
		
		IF VARTYPE(cTBL) != 'C'
			ThisForm.cTBL = ''
		ELSE
			ThisForm.cTBL = cTBL
		ENDIF
		
		
		IF VARTYPE(nID_Detail) != 'N'
			ThisForm.nID_Detail = 0
		ELSE
			ThisForm.nID_Detail = nID_Detail
		ENDIF
		
		IF VARTYPE(nID_Detail_Process) != 'N'
			ThisForm.nID_Detail_Process = 0
		ELSE
			ThisForm.nID_Detail_Process = nID_Detail_Process
		ENDIF
		***********************
		PRIVATE lWOSexists, lWOPexists 
		lWOSexists = .F.
		lWOPexists = .F.
		
		*************************
		
		ThisForm.get_tmpWO_S(0)
		
		*************************
		
		ThisForm.get_tmpWO_P(0)
		
		*************************
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_QUOTES ADDITIVE
		ENDIF
		
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		
		IF SET('SAFETY') = "ON"
			SET SAFETY OFF
		ENDIF
		
		
		
	ENDPROC

