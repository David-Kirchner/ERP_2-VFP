	PROCEDURE refreshwo_p
		*ThisForm.RefreshWO_P()
		
		*!*	cSQL = " SELECT Company,P.POitem,P.SOitem,SalesP,Alloy,P.WO "
		*!*	cSQL = cSQL + ",dbo.f_Descript(Alloy,CC,CL,Form,Thck,Sz2,Sz3,StockLst_QTY,RandLen) AS Descript "
		*!*	cSQL = cSQL + ",OrderDate, dbo.f_BestDate( dbo.f_BestDate(Due_Min,Due_Max), dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max) ) AS DueDate "
		*!*	cSQL = cSQL + ",Delivered,Cancelled,Reconciled,Cond_Spec "
		*!*	cSQL = cSQL + ",Order_QTY,Order_P "
		*cSQL= cSQL+",StockLst_QTY, StockLst_P, ISNULL(StockLst_PU,dbo.f_GetFormPU(Form)) AS StockLst_PU "
		*cSQL= cSQL+",ISNULL(StockLst_Total,dbo.f_GetPOItem_Total(P.POItem)) AS StockLst_Total "
		*!*	cSQL = cSQL + ",D.ID,D.QTY,D.P,D.Total,D.WO AS DWO "
		*!*	cSQL = cSQL + "FROM dbo.PurchaseOrder P "
		*!*	cSQL = cSQL + " LEFT OUTER JOIN dbo.PO_SOdist d ON d.POitem = P.POitem "
		*!*	cSQL = cSQL + "WHERE P.WO = "+STR(nWO)
		*!*	cSQL = cSQL + " OR D.WO = "+STR(nWO)
		*!*	IF Proper_PO_item(ThisForm.cPOItem) != Proper_PO_item("")
		*!*		cSQL = cSQL + " OR P.POitem = dbo.f_ProperPOitem('"+ThisForm.cPOItem+"')"
		*!*		cSQL = cSQL + " OR D.POitem = dbo.f_ProperPOitem('"+ThisForm.cPOItem+"')"
		*!*	ENDIF
		*!*	IF Proper_SO_item(ThisForm.cSOItem) != Proper_SO_item("")
		*!*		cSQL = cSQL + " OR P.SOitem = dbo.f_ProperSOitem('"+ThisForm.cSOItem+"')"
		*!*		cSQL = cSQL + " OR D.SOitem = dbo.f_ProperSOitem('"+ThisForm.cSOItem+"')"
		*!*	ENDIF
		
		
		IF USED("tmpWO_P")	
			IF RECCOUNT("tmpWO_P") > 0
				ThisForm.txtPOitem.Value = PrepareSQLtxt(tmpWO_P.SOitem,'SOitem',10)
				ThisForm.txtPWO.Value = PrepareSQLnum(tmpWO_P.WO,'WO',-3)	
				
				ThisForm.txtPCompany.Value = PrepareSQLtxt(tmpWO_P.Company,'Company',30)
				
				ThisForm.txtPOrderDate.Value = PrepareSQLdate(tmpWO_P.OrderDate,'OrderDate')
				ThisForm.txtPDueDate.Value = PrepareSQLdate(tmpWO_P.DueDate,'DueDate')
				
				
				ThisForm.chkPDelivered.Value = PrepareSQLchk(tmpWO_P.Delivered,'Delivered')
				ThisForm.chkPCancelled.Value = PrepareSQLchk(tmpWO_P.Cancelled,'Cancelled')
				ThisForm.chkPReconciled.Value = PrepareSQLchk(tmpWO_P.Reconciled,'Reconciled')
				
				ThisForm.txtPDescript.Value = PrepareSQLtxt(tmpWO_P.Descript,'Descript',160)
				ThisForm.txtPCond_Spec.Value = PrepareSQLtxt(tmpWO_P.Cond_Spec,'Cond_Spec',160)
				
				* ,D.ID,D.QTY,D.P,D.Total,D.WO AS DWO 
				ThisForm.txtPO_SOdist.Value = PrepareSQLnum(tmpWO_P.ID,'ID',-3)
				ThisForm.txtDWO.Value	= PrepareSQLnum(tmpWO_P.DWO,'DWO',-3)
				ThisForm.txtQTY.Value	= PrepareSQLnum(tmpWO_P.QTY,'S_QTY',-5)
				ThisForm.txtP.Value		= PrepareSQLnum(tmpWO_P.P,'S_P',-5)
				ThisForm.txtTotal.Value	= PrepareSQLnum(tmpWO_P.Total,'S_Total',-5)
				ThisForm.txtOrder_QTY.Value	= PrepareSQLnum(tmpWO_P.Order_QTY,'Order_QTY',-5)
				ThisForm.txtOrder_P.Value	= PrepareSQLnum(tmpWO_P.Order_P,'Order_P',-5)
				ThisForm.txtPOTotal.Value	= PrepareSQLnum(tmpWO_P.Order_QTY,'Order_QTY',-5) * PrepareSQLnum(tmpWO_P.Order_P,'Order_P',-5) 
		
			ELSE
				ThisForm.txtPOitem.Value	= ''
				ThisForm.txtPWO.Value 		= 0
				ThisForm.txtPCompany.Value	= ''
				ThisForm.txtPOrderDate.Value	= CTOD('')
				ThisForm.txtPDueDate.Value	= CTOD('')
				ThisForm.chkPDelivered.Value	= 0
				ThisForm.chkPCancelled.Value	= 0
				ThisForm.chkPReconciled.Value	= 0
				ThisForm.txtPDescript.Value	= ''
				ThisForm.txtPCond_Spec.Value	= ''
				
				ThisForm.txtPO_SOdist.Value = 0
				ThisForm.txtDWO.Value	= 0
				ThisForm.txtQTY.Value	= 0
				ThisForm.txtP.Value		= 0
				ThisForm.txtTotal.Value	= 0
				ThisForm.txtOrder_QTY.Value	= 0
				ThisForm.txtOrder_P.Value	= 0
				ThisForm.txtPOTotal.Value	= 0
		
			ENDIF
		ELSE
			ThisForm.txtPOitem.Value	= ''
			ThisForm.txtPWO.Value 		= 0
			ThisForm.txtPCompany.Value	= ''
			ThisForm.txtPOrderDate.Value	= CTOD('')
			ThisForm.txtPDueDate.Value	= CTOD('')
			ThisForm.chkPDelivered.Value	= 0
			ThisForm.chkPCancelled.Value	= 0
			ThisForm.chkPReconciled.Value	= 0
			ThisForm.txtPDescript.Value	= ''
			ThisForm.txtPCond_Spec.Value	= ''
				
			ThisForm.txtPO_SOdist.Value = 0
			ThisForm.txtDWO.Value	= 0
			ThisForm.txtQTY.Value	= 0
			ThisForm.txtP.Value		= 0
			ThisForm.txtTotal.Value	= 0
			ThisForm.txtOrder_QTY.Value	= 0
			ThisForm.txtOrder_P.Value	= 0
			ThisForm.txtPOTotal.Value	= 0
		ENDIF
		
		ThisForm.Show_grdSO_Proc()
	ENDPROC

