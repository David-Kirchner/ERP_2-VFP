	PROCEDURE cmdReturn.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdSOitemHelp.Click
		PRIVATE cMess
		cMess = "A HPA Sales Order to HPA is used to get the shop to remove the material from the floor and from the Stock List. " 
		cMess = cMess + "Usually only ONE Sales Order is needed for a WO. "
		cMess = cMess + "This screen can mark more than one Sales Order for a WO. "+CHR(13)
		cMess = cMess + "A SOitem process is used to mark the Stock List with the SOitem and WO. "
		cMess = cMess + "IMPORTANT: This Stock List PROCESS is the key to Identifying what changed the Stock list in the historical recordings. "
		cMess = cMess + "A SOitem Process will show live on the Stock List that this Stock item has been spoken for. "
		cMess = cMess + "(Who, What and How much of it) "
		cMess = cMess + "Until this stock is removed from the Stock List, the Sales Rep will know what amount of this marked stock is not available to sell to other customers. "
		cMess = cMess + CHR(13)+CHR(13)+"By marking all Material with this WO:"+ALLTRIM(STR(ThisForm.nWO))+" full Production work can be accounted for. "
		MESSAGEBOX(cMess,+064,"This screen is about the WO and what this WO touches. ")
		
	ENDPROC

ENDDEFINE
