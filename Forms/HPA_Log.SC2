		*			GO BOTTOM
		*		ENDIF
		*	ENDIF
		*ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE frmBrowseSearch.cmdSelect.Click
		PRIVATE nID
		nID = tmpSearch.ID
		
		PRIVATE nCount, cTalk
		nCount = 0
		cTalk = SET("TALK")
		SET TALK OFF
		SELECT GFMlog
		CALCULATE COUNT() FOR Date < DATE()-365 TO nCount
		
		IF cTalk = "ON"
			SET TALK ON
		ENDIF
		
		IF nCount < 10
			*Get all Records
			IF USED('GFMLog')	
				USE IN GFMLog
			ENDIF
		
			cSQL = "SELECT * FROM dbo.GFMLog "
			*WHERE DATE >= GETDATE()-365 
			cSQL = cSQL +" ORDER BY LOT "
				
			SELECT 0
			WAIT WINDOW "Going back to Server for All Records." NOWAIT
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'GFMLog')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'GFMLog')
			ENDDO
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,THISFORMSET.nConnHandle, nSQLEXEC, 'GFMLog')
				RETURN
			ELSE
				*Code is also used in RefreshReceiving and Reload
				SELECT GFMLog
				INDEX ON LOT TAG LOT
			ENDIF
			SET ORDER TO TAG LOT
		
		ENDIF
		
		SELECT GFMLog
		LOCATE FOR ID=nID
		
		This.Parent.Parent.Hpa_log12.RefreshGFMlog()
		
	ENDPROC

	PROCEDURE frmBrowseSearch.Resize
		ThisForm.grdSearch.Height = ThisForm.Height
		ThisForm.grdSearch.Width  = ThisForm.Width
		
		ThisForm.cmdSelect.Top = ThisForm.Height - 37 &&250 -27  =223
		ThisForm.cmdSelect.Left = ThisForm.Width - 61 &&374 -51 = 323
		
	ENDPROC

	PROCEDURE frmSearch.cmbAlloy.Init
		*#DEFINE ALLAlloy_LOC "(All)"
		this.clear
		*this.additem(ALLAlloy_LOC)
		
		LOCAL aAlloys,cAlloy
		DIMENSION aAlloys[1]
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT DISTINCT AlloyName AS Alloy FROM dbo.GFMlog"
		
		IF USED('tmpAlloyName')
			USE IN tmpAlloyName
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpAlloyName' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpAlloyName' )
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'tmpAlloyName')
			aAlloys(1) = ''
		ELSE
			IF USED('tmpAlloyName')
				SELECT DISTINCT Alloy FROM tmpAlloyName WHERE !DELETED() AND !EMPTY(alloy) ORDER BY Alloy INTO array aAlloys
				
				USE IN tmpAlloyName
			ELSE
				aAlloys(1) = ''
			ENDIF
		ENDIF
		
		FOR EACH m.cAlloy IN aAlloys
			IF !EMPTY(m.cAlloy)
				this.additem(m.cAlloy)
			ENDIF
		ENDFOR
		
		THIS.VALUE = aAlloys(1)
		
	ENDPROC

	PROCEDURE frmSearch.cmbAlloy.InteractiveChange
		*!*	SELECT PriceTable
		*!*	PRIVATE cAlloyNow 
		*!*	cAlloyNow = PriceTable.Alloy
		*!*			
		*!*	IF This.Value = "(All)"
		*!*		LOCATE FOR Alloy = cAlloyNow 
		*!*	ELSE
		*!*		LOCATE FOR Alloy = This.Value
		*!*	ENDIF
		
		*!*	ThisFormset.DispAlloyFilter = This.Value
		
		*!*	ThisFormSet.frmAdjustPrice.cmbAlloy.Value = This.Value
		*!*	ThisFormSet.frmHPApricing.cmbAlloy.Value = This.Value
		*!*	ThisFormSet.frmPrint.cmbAlloy.Value = This.Value
		
		*!*	ThisFormSet.RefreshPriceTable()
	ENDPROC

	PROCEDURE frmSearch.cmdSearch.Click
		PRIVATE cAlloy,nSSmax,nSSmin,nFSmax,nFSmin,nCWmax,nCWmin
		PRIVATE nUTSmax,nUTSmin,nYLDmax,nYLDmin,nELmax,nELmin, nRAmax, nRAmin
		
		cAlloy	= PrePareSQLtxt(ThisForm.cmbAlloy.Value,'Alloy',12)
		nSSmax	= PrepareSQLnum(ThisForm.txtSSMax.Value,'SSmax',-3)
		nSSmin	= PrepareSQLnum(ThisForm.txtSSmin.Value,'SSmin',-3)
		nFSmax	= PrepareSQLnum(ThisForm.txtFSmax.Value,'FSmax',-3)
		nFSmin	= PrepareSQLnum(ThisForm.txtFSmin.Value,'FSmin',-3)
		nCWmax	= PrepareSQLnum(ThisForm.txtCWmax.Value,'CWmax',-3)
		nCWmin	= PrepareSQLnum(ThisForm.txtCWmin.Value,'CWmin',-3)
		nUTSmax	= PrepareSQLnum(ThisForm.txtUTSmax.Value,'UTSmax',-3)
		nUTSmin	= PrepareSQLnum(ThisForm.txtUTSmin.Value,'UTSmin',-3)
		nYLDmax	= PrepareSQLnum(ThisForm.txtYLDmin.Value,'YLDmax',-3)
		nYLDmin	= PrepareSQLnum(ThisForm.txtYLDmin.Value,'YLDmin',-3)
		nELmax	= PrepareSQLnum(ThisForm.txtELmax.Value,'ELmax',-3)
		nELmin	= PrepareSQLnum(ThisForm.txtELmin.Value,'ELmin',-3)
		nRAmax	= PrepareSQLnum(ThisForm.txtRAmax.Value,'RAmax',-3)
		nRAmin	= PrepareSQLnum(ThisForm.txtRAmin.Value,'RAmin',-3)
		
		
		
		IF USED('tmpSearch')
			ThisFormSet.frmBrowseSearch.grdSearch.RecordSource=''
			USE IN tmpSearch
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT AlloyName,Heat,Lot,[date],[ssize],[gfmsize],[condition],[htreat]"
		cSQL = cSQL + ",[coldwork],[soitem],[spec],[po]"
		cSQL = cSQL + ",[tensile],[yield],[elongation],[red_area],[rockwell],[bhn],ID"
		cSQL = cSQL + " FROM dbo.GFMlog WHERE AlloyName='"+cAlloy+"'"
		
		****
		IF nSSmax > 0
			cSQL = cSQL + " AND SSize <= "+STR(nSSmax) 
		ENDIF
		IF nSSmin > 0
			cSQL = cSQL + " AND SSize >= "+STR(nSSmin) 
		ENDIF
		****
		IF nFSmax > 0
			cSQL = cSQL + " AND GFMSize <= "+STR(nFSmax) 
		ENDIF
		IF nFSmin > 0
			cSQL = cSQL + " AND GFMSize >= "+STR(nFSmin) 
		ENDIF
		****
		IF nCWmax > 0
			cSQL = cSQL + " AND ColdWork <= "+STR(nCWmax,3,3) 
		ENDIF
		IF nCWmin > 0
			cSQL = cSQL + " AND ColdWork >= "+STR(nCwmin,3,3) 
		ENDIF
		****
		IF nUTSmax > 0
			cSQL = cSQL + " AND Tensile <= "+STR(nUTSmax) 
		ENDIF
		IF nUTSmin > 0
			cSQL = cSQL + " AND Tensile >= "+STR(nUTSmin) 
		ENDIF
		****
		IF nYLDmax> 0
			cSQL = cSQL + " AND Yeild <= "+STR(nYLDmax) 
		ENDIF
		IF nYLDmin > 0
			cSQL = cSQL + " AND Yeild >= "+STR(nSSmin) 
		ENDIF
		****
		IF nELmax > 0
			cSQL = cSQL + " AND Elongation <= "+STR(nELmax) 
		ENDIF
		IF nELmin > 0
			cSQL = cSQL + " AND Elongation >= "+STR(nELmin) 
		ENDIF
		****
		IF nRAmax > 0
			cSQL = cSQL + " AND Red_Area <= "+STR(nRAmax) 
		ENDIF
		IF nRAmin > 0
			cSQL = cSQL + " AND Red_Area >= "+STR(nRAmin) 
		ENDIF
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSearch' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSearch' )
		ENDDO
		
		ThisFormSet.frmBrowseSearch.Visible = .F.
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle,nSQLEXEC,'tmpSearch')
		ELSE
			IF USED('tmpSearch')
				ThisFormSet.frmBrowseSearch.grdSearch.RecordSource='tmpSearch'
				ThisFormSet.frmBrowseSearch.Visible = .T.
				ThisFormSet.frmBrowseSearch.AlwaysOnTop = .T.
				ThisFormSet.frmBrowseSearch.AlwaysOnTop = .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Hpa_log12.cmdClose.Click
		DODEFAULT()
		ThisFormSet.Release
		
	ENDPROC

ENDDEFINE
