		SCAN FOR NOT DELETED()
			nID = tmpSales_Stock.ID
			cPOitem = PrepareSQLtxt(tmpSales_Stock.StockLst_POitem,'POitem',12)
			lReconciled = pReconciled
			
			cSQL = "UPDATE dbo.Sales_Stock "
			cSQL = cSQL + " SET Reconciled=" + IIF(lReconciled,'1','0')
			cSQL = cSQL + ",Sales_Detail_ID="+ALLTRIM(STR(nSales_Detail_ID))
			IF NOT EMPTY(cPOitem) OR Proper_SO_item(cSOitem) = Proper_SO_item('')
				cSQL = cSQL + ",StockLst_POitem=dbo.f_ProperPOitem('"+cPOitem+"')"
			ENDIF
			cSQL = cSQL + " WHERE ID= "+ALLTRIM(STR( nID ))
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
		ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC  )
				lPassed = .F.
			ENDIF
		
		ENDSCAN
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN lPassed 
	ENDPROC

	PROCEDURE showquotedtotal
		*ThisFormSet.ShowQuotedTotal()
		
		PRIVATE nQuoted_QTY, nQuoted_P, nQuoted_Total, nQuoted_PU, nQuoted_LBS
		nQuoted_QTY	= 0
		nQuoted_P	= 0
		nQuoted_Total= 0
		nQuoted_PU	= 0
		nQuoted_LBS	= 0
		
		IF USED('tmpSales_Detail')
			IF RECCOUNT('tmpSales_Detail') > 0
				nQuoted_QTY	 = PrepareSQLnum(tmpSales_Detail.Quoted_QTY,'Quoted_QTY',-5)
				nQuoted_P	 = PrepareSQLnum(tmpSales_Detail.Quoted_P,'Quoted_P',-5)
				nQuoted_Total= PrepareSQLnum(tmpSales_Detail.Quoted_Total,'Quoted_Total',-5)
				nQuoted_PU	 = PrepareSQLnum(tmpSales_Detail.Quoted_PU,'Quoted_PU',-1)
			ENDIF
		ENDIF
		
		IF Proper_SO_item(ThisFormset.SOitem) != Proper_SO_item("")
			IF nQuoted_QTY = 0
				nQuoted_QTY	= Get_QTYinSales( ThisFormset.SOitem, ThisFormSet.nConnHandle )
			ENDIF
			IF nQuoted_P = 0 AND nQuoted_Total = 0
				nQuoted_Total = Get_ItemSaleinSales( ThisFormset.SOitem, ThisFormSet.nConnHandle )
			ENDIF
		ELSE
			nQuoted_QTY = 0
			nQuoted_Total = 0
		ENDIF
		IF nQuoted_P = 0
			IF nQuoted_QTY > 0
				nQuoted_P	= nQuoted_Total / nQuoted_QTY
			ELSE
				nQuoted_P	= 0
			ENDIF
		ENDIF
		
		IF nQuoted_Total = 0
			nQuoted_Total = nQuoted_QTY * nQuoted_P
		ENDIF
		
		IF nQuoted_PU = 0
			nQuoted_PU	= GetPUfromForm( ThisFormset.frmSales_stock.txtForm.Value , ThisFormSet.nConnHandle )
		ENDIF
		
		nQuoted_LBS = Get_LBSinSales( ThisFormset.SOitem, ThisFormSet.nConnHandle )
		 
		ThisFormset.frmSOitemDetail.txtQuoted_QTY.Value 	= nQuoted_QTY
		ThisFormset.frmSOitemDetail.txtQuoted_PUtxt.Value 		= Get_PUtext( nQuoted_PU )
		ThisFormset.frmSOitemDetail.txtQuoted_P.Value		= nQuoted_P
		ThisFormset.frmSOitemDetail.txtQuoted_Total.Value	= nQuoted_Total
		ThisFormset.frmSOitemDetail.txtQuoted_LBS.Value		= nQuoted_LBS
			
		***********************************
		IF PrepareSQLnum(ThisFormset.frmSOitemDetail.txtQuoted_PC.Value,'Quoted_PC',-3) < 1
			ThisFormset.frmSOitemDetail.txtQuoted_PC.Value	= PrepareSQLnum(ThisFormSet.frmQuote.PIECES1.Value,'Sale_PC',-3)
		ENDIF
				
		IF PrepareSQLnum(ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value,'Quoted_Dim1',10,4) = 0
			ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value	= PrepareSQLnum(ThisFormSet.frmQuote.THCK1.Value,'StockLst_Dim1',10,4)
		ENDIF
		
		
	ENDPROC

	PROCEDURE showsales_stock
		*ThisFormset.ShowSales_Stock()
		PRIVATE nID
		nID = ThisFormSet.frmSales_Stock.grdSales_Stock.Column1.Text1.Value
		
		
		IF USED('tmpSales_Stock')
			IF RECCOUNT('tmpSales_Stock') > 0
				SELECT tmpSales_Stock
				LOCATE FOR ID = nID
				
				IF FOUND()
					ThisFormSet.frmSales_Stock.Visible = .T.
											
					ThisFormSet.frmSales_Stock.txtID.Refresh
					ThisFormSet.frmSales_Stock.txtSOitem.Refresh
					ThisFormSet.frmSales_Stock.txtStockEdit.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_QTY.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_PU.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_P.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_Total.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_PC.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_Dim1.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_Dim2.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_Dim3.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_LBS.Refresh
					ThisFormSet.frmSales_Stock.txtOrig_PC.Refresh
					ThisFormSet.frmSales_Stock.txtOrig_Dim1.Refresh
					ThisFormSet.frmSales_Stock.txtOrig_Dim2.Refresh
					ThisFormSet.frmSales_Stock.txtOrig_Dim3.Refresh
					ThisFormSet.frmSales_Stock.txtOrig_LBS.Refresh
					ThisFormSet.frmSales_Stock.txtStkPaid_P.Refresh
					ThisFormSet.frmSales_Stock.txtStkPaid_Total.Refresh
					ThisFormSet.frmSales_Stock.chkConsumed.Refresh
					ThisFormSet.frmSales_Stock.txtAlloy.Refresh
					ThisFormSet.frmSales_Stock.txtForm.Refresh
					ThisFormSet.frmSales_Stock.txtCC.Refresh
					ThisFormSet.frmSales_Stock.txtCL.Refresh
					ThisFormSet.frmSales_Stock.txtTBL.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_ID.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_ID_Detail.Refresh
					ThisFormSet.frmSales_Stock.txtID_Detail_Process.Refresh
					ThisFormSet.frmSales_Stock.txtStockLst_POitem.Refresh
				ELSE
					MESSAGEBOX("Did not Find Sales_Stock ID "+ALLTRIM(STR(nID)),16,"Cannot Show Sales_Stock ")
					ThisFormSet.frmSales_Stock.Visible = .F.
				ENDIF
			ELSE
				ThisFormSet.frmSales_Stock.Visible = .F.
			ENDIF
		ELSE
			ThisFormSet.frmSales_Stock.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE showsuminvoice
		*ThisFormSet.ShowSumInvoice()
		
		IF NOT USED('tmpInvoice')
			MESSAGEBOX("No 'tmpInvoice' table",0,"Error")
			TrackError("No 'tmpInvoice' table","No table","SO_Invoice:Sales_Detail_EditShowSumInvoice",LINENO(1))
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpInvoice') < 1
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpInvoice
		PRIVATE nRecNo, nCount, nSum
		nRecNo = RECNO('tmpInvoice')
		
		COUNT FOR NOT DELETED() TO nCount
		
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF nCount = 1
			*ThisFormset.frmSOitemDetail.txtInvoiceDate.Value	= tmpInvoice.InvoiceDate
			ThisFormset.frmSOitemDetail.txtInvoice_QTY.Value	= tmpInvoice.Quantity
			ThisFormset.frmSOitemDetail.txtInvoice_P.Value		= tmpInvoice.UnitPrice
			ThisFormset.frmSOitemDetail.txtInvoice_Item.Value	= ABS(tmpInvoice.AR_Amount)
		*	ThisFormset.frmSOitemDetail.txtFreight.Value		= tmpInvoice.Freight &&Done in _Frt
		
			*ThisFormset.frmSOitemDetail.txtFreightTotal.Value	= PrepareSQLnum(tmpInvoice.FreightTotal,'Freight',-5)
			*ThisFormset.frmReconcileTotal.txtFreightTotal.Value= PrepareSQLnum(tmpInvoice.FreightTotal,'Freight',-5)ThisFormSet.CalcFreightInv()
			ThisFormset.frmReconcileTotal.txtFreightTotal.Value	= ThisFormSet.CalcFreightInv()
			*ThisFormset.frmSOitemDetail.txtDisc_Allowed.Value= ABS(tmpInvoice.Disc_Amount)
			ThisFormset.frmReconcileTotal.txtDisc_Allowed.Value= ABS(tmpInvoice.Disc_Amount)
		
		ENDIF
		IF nCount > 1
			PRIVATE nSumInvoice_QTY, nSumUnitPrice, nSumDisc_Allowed
			SET Talk OFF
			*ThisFormset.frmSOitemDetail.txtInvoiceDate.Value	= tmpInvoice.InvoiceDate
			SUM Quantity FOR NOT DELETED() TO nSumInvoice_QTY
			ThisFormset.frmSOitemDetail.txtInvoice_QTY.Value	= nSumInvoice_QTY
			
			ThisFormset.frmSOitemDetail.txtInvoice_P.Value 	= tmpInvoice.UnitPrice 
			SUM Amount FOR NOT DELETED() TO nSumUnitPrice
			ThisFormset.frmSOitemDetail.txtInvoice_Item.Value		= ABS(nSumUnitPrice)
		
		*	SUM Freight FOR NOT DELETED() TO nSum
		*	ThisFormset.frmSOitemDetail.txtFreight.Value		= nSUM
			*ThisFormSet.frmReconcileTotal.txtFreightTotal.Value
			
			SUM Disc_Amount FOR NOT DELETED() TO nSumDisc_Allowed
			*ThisFormset.frmSOitemDetail.txtDisc_Allowed.Value 	= ABS(nSumDisc_Allowed)
			ThisFormset.frmReconcileTotal.txtDisc_Allowed.Value 	= ABS(nSumDisc_Allowed)
		
		ENDIF
		
		SELECT tmpInvoice
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		ThisFormSet.frmInvoice.chkReconciled.Refresh
		ThisFormSet.frmInvoice.chkMarked.Refresh
		*ThisFormSet.frmInvoice.txtPaid.Refresh
		*ThisFormSet.frmInvoice.txtQuantity.Refresh
		
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showsuminvtotal
		*ThisFormSet.ShowSumInvTotal()
		*Use ShowSumInvoice When Invoice has changed!
		
		PRIVATE nStockLst_Total, nQuoted_Total, nInvoice_Total, nReconDiff
		
		nQuoted_Total	= PrepareSQLnum(ThisFormSet.frmSOitemDetail.txtQuoted_Total.Value,'Quoted_Total',18,4)
		*nInvoice_Total	= PrepareSQLnum(ThisFormSet.frmReconcileTotal.txtInvoice_Total.Value,'Invoice_Total',18,4)
		*nInvoice_Item	= PrepareSQLnum(ThisFormSet.frmSOitemDetail.txtInvoice_Item.Value,'Invoice_Item',18,4)
		*nFreightTotal	= PrepareSQLnum(ThisFormSet.frmReconcileTotal.txtFreightTotal.Value,'FreightTotal',18,4)
		nReconDiff		= PrepareSQLnum(ThisFormSet.frmReconcileTotal.txtReconDiff.Value,'ReconDiff',18,4)
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE nInvoice
		nInvoice = PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		
		**********************************
		*get nSD_SOTotal 
		PRIVATE nSD_SOTotal
		nSD_SOTotal = 0
		
		IF USED('tmpSumInvoice')
			USE IN tmpSumInvoice
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT SUM(ISNULL(StockLst_Qty,0)*ISNULL(StockLst_P,0)) AS StockLst_SOTotal "
		cSQL = cSQL +" FROM dbo.Sales_Detail "
		cSQL = cSQL + " WHERE SalesNum = "+STR(VAL(cSOitem))
		*cSQL = cSQL + " WHERE Invoice= "+ALLTRIM(STR( nInvoice))
		*cSQL = cSQL + " and Reconciled=1"
		cSQL = cSQL +" AND ISNULL(Cancelled,0) = 0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumInvoice")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumInvoice")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSumInvoice' )
			lPassed = .F.
		ENDIF
		IF USED('tmpSumInvoice')
			IF RECCOUNT('tmpSumInvoice')>0
				nSD_SOTotal = PrepareSQLnum(tmpSumInvoice.StockLst_SOTotal,'StockLst_SOTotal',-5)
			ENDIF
			USE IN tmpSumInvoice
		ENDIF
		
		**********************************
		*get 	nSD_SOitem_Total
		PRIVATE nSD_SOitem_Total
		*nSD_SOitem_Total = PrepareSQLnum(ThisFormSet.frmSOitemDetail.txtStockLst_Total.Value,'StockLst_ItemTotal',18,4)
		nSD_SOitem_Total = 0
		
		IF USED('tmpSumInvoice')
			USE IN tmpSumInvoice
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT SUM(ISNULL(StockLst_Qty,0)*ISNULL(StockLst_P,0)) AS StockLst_SOItemTotal "
		cSQL = cSQL + " FROM dbo.Sales_Detail "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*cSQL = cSQL + " WHERE Invoice= "+ALLTRIM(STR( nInvoice))
		*cSQL = cSQL + " and ISNULL(Reconciled,0)=1"
		cSQL = cSQL +" AND ISNULL(Cancelled,0) = 0"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumInvoice")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumInvoice")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSumInvoice' )
			lPassed = .F.
		ENDIF
		IF USED('tmpSumInvoice')
			IF RECCOUNT('tmpSumInvoice')>0
				nSD_SOitem_Total = PrepareSQLnum(tmpSumInvoice.StockLst_SOItemTotal,'StockLst_SOItemTotal',-5)
			ENDIF
			USE IN tmpSumInvoice
		ENDIF
		
		**********************************
		*get  nSO_Total
		nInvoice_Total = 0
		PRIVATE nSO_Total
		nSO_Total = 0
		IF USED('tmpSumInvoice')
			USE IN tmpSumInvoice
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT ISNULL(SUM(Paid),0) AS Invoice_ItemTotal "
		cSQL = cSQL + " FROM dbo.Sales_Invoice "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*cSQL = cSQL + " WHERE Invoice= "+ALLTRIM(STR( nInvoice))
		cSQL = cSQL + " and NOT GL_Account = 69000 "
		cSQL = cSQL + " and ISNULL(Reconciled,0)=1"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumInvoice")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumInvoice")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSumInvoice' )
			lPassed = .F.
		ENDIF
		IF USED('tmpSumInvoice')
			IF RECCOUNT('tmpSumInvoice')>0
				nSO_Total = PrepareSQLnum(tmpSumInvoice.Invoice_ItemTotal,'Invoice_ItemTotal',-3)
			ENDIF
			USE IN tmpSumInvoice
		ENDIF
		
		**********************************
		*get  nInvoice_SOTotal
		PRIVATE nInvoice_SOTotal
		nInvoice_SOTotal = 0
		
		IF USED('tmpSumInvoice')
			USE IN tmpSumInvoice
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT ISNULL(SUM(Paid),0) AS Invoice_SOTotal FROM dbo.Sales_Invoice "
		*cSQL = cSQL + " WHERE CAST(LEFT(SOitem,7) AS INT) = CAST(LEFT(dbo.f_ProperSOitem('"+cSOitem+"'),7) AS INT)"
		cSQL = cSQL + " WHERE SalesNum = "+STR(VAL(cSOitem))
		
		*cSQL = cSQL + " WHERE Invoice= "+ALLTRIM(STR( nInvoice))
		cSQL = cSQL + " and ISNULL(Reconciled,0)=1"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSumInvoice' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumInvoice")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSumInvoice")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSumInvoice' )
			lPassed = .F.
		ENDIF
		IF USED('tmpSumInvoice')
			IF RECCOUNT('tmpSumInvoice')>0
				nInvoice_SOTotal = PrepareSQLnum(tmpSumInvoice.Invoice_SOTotal,'Invoice_SOTotal',-5)
			ENDIF
			USE IN tmpSumInvoice
		ENDIF
		
		**************************************
		PRIVATE nSOi_Frt_Total
		*nSOi_Frt_Total	= PrepareSQLnum(ThisFormSet.frmReconcileTotal.txtFreightTotal.Value,'FreightTotal',18,4)
		nSOi_Frt_Total = ThisFormSet.CalcFreightSOitem()
		ThisFormSet.frmReconcileTotal.txtFreightTotal.Value = PrepareSQLnum(nSOi_Frt_Total,'nSOi_Frt_Total',-5)
		*nInvoice_SOTotal = nInvoice_Frt_Total &&Use current table data.  Freight Reconcile has not been saved to Disk
		
		**************************************
		PRIVATE nItemProfitMargin, nSOProfitMargin, nCalcItemTotal, nReconDiff
		
		nCalcItemTotal = nSOi_Frt_Total + nSO_Total
		nCalcSOTotal = nInvoice_SOTotal + nSOi_Frt_Total
		nItemProfitMargin = nCalcItemTotal - nSD_SOitem_Total
		nSOProfitMargin = nCalcSOTotal  - nSD_SOTotal 
		
		IF nCalcItemTotal > 0 AND nSO_Total > 0 
			*nReconDiff = nCalcItemTotal - nSO_Total
			nReconDiff = nCalcSOTotal - nInvoice_SOTotal 
		ENDIF
		
		
		*ThisFormSet.frmSOitemDetail.txtReconDiff.ForeColor = RGB(0,0,0)
		*ThisFormSet.frmSOitemDetail.txtReconDiff.BackColor = RGB(255,255,255)
		ThisFormSet.frmReconcileTotal.txtReconDiff.ForeColor = RGB(0,0,0)
		ThisFormSet.frmReconcileTotal.txtReconDiff.BackColor = RGB(255,255,255)
		
		
		IF nReconDiff > 0
			IF nCalcItemTotal> 0
				IF nCalcItemTotal/10 > nReconDiff
					*RecDiff is more than the 10%
					*ThisFormSet.frmSOitemDetail.txtReconDiff.ForeColor = RGB(255,0,0)
					*ThisFormSet.frmSOitemDetail.txtReconDiff.BackColor = RGB(255,255,128)
					ThisFormSet.frmReconcileTotal.txtReconDiff.ForeColor = RGB(255,0,0)
					ThisFormSet.frmReconcileTotal.txtReconDiff.BackColor = RGB(255,255,128)
				ENDIF
			ENDIF
		ENDIF
		
		*ThisFormSet.frmSOitemDetail.txtReconDiff.Value = nReconDiff
		ThisFormSet.frmReconcileTotal.txtReconDiff.Value = nReconDiff
		
		*ThisFormSet.frmSOitemDetail.txtItemProfitMargin.Value = nItemProfitMargin
		ThisFormSet.frmReconcileTotal.txtItemProfitMargin.Value = nItemProfitMargin
		*ThisFormSet.frmSOitemDetail.txtSOProfitMargin.Value = nSOProfitMargin
		ThisFormSet.frmReconcileTotal.txtSOProfitMargin.Value = nSOProfitMargin
		
		*ThisFormSet.frmSOitemDetail.txtCalcItemTotal.Value = PrepareSQLnum(nCalcItemTotal,'CalcItemTotal',10,2)
		ThisFormSet.frmReconcileTotal.txtCalcItemTotal.Value = PrepareSQLnum(nCalcItemTotal,'CalcItemTotal',10,2)
		*ThisFormSet.frmSOitemDetail.txtCalcSOTotal.Value = PrepareSQLnum(nCalcSOTotal,'CalcSOTotal',10,2)
		ThisFormSet.frmReconcileTotal.txtCalcSOTotal.Value = PrepareSQLnum(nCalcSOTotal,'CalcSOTotal',10,2)
		
		
	ENDPROC

	PROCEDURE showsumpackingslip
		*ThisFormSet.ShowSumPackingSlip()
		
		IF NOT USED('tmpPackingSlip')
			MESSAGEBOX("No 'tmpPackingSlip' table",0,"Error")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpPackingSlip') < 1
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpPackingSlip
		PRIVATE nRecNo, nCount, nSum
		nRecNo = RECNO()
		
		COUNT FOR NOT DELETED() TO nCount
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF nCount = 1
		
			*ThisFormset.frmSOitemDetail.txtPS_Date.Value		= tmpPackingSlip.PS_Date
			ThisFormset.frmSOitemDetail.txtSale_QTY.Value	= PrepareSQLnum(tmpPackingSlip.Weight,'QTY',-5)
			ThisFormset.frmSOitemDetail.txtSale_PC.Value	= PrepareSQLnum(tmpPackingSlip.Pcs,'Pcs',-3)
			ThisFormset.frmSOitemDetail.txtDescript.Value	= PrepareSQLtxt(tmpPackingSlip.Descript,'Descript',80)
			ThisFormset.frmSOitemDetail.txtWeight.Value		= PrepareSQLnum(tmpPackingSlip.Weight,'Weight',9,1)
		
		ENDIF
		IF nCount > 1
			SET Talk OFF
			*ThisFormset.frmSOitemDetail.txtPS_Date.Value		= tmpPackingSlip.PS_Date
			ThisFormset.frmSOitemDetail.txtDescript.Value	= PrepareSQLtxt(tmpPackingSlip.Descript,'Descript',80)
			
			SUM Pcs FOR NOT DELETED() TO nSum
			ThisFormset.frmSOitemDetail.txtSale_QTY.Value 	= PrepareSQLnum(nSum,'QTY',-5)
		
			SUM Pcs FOR NOT DELETED() TO nSum
			ThisFormset.frmSOitemDetail.txtSale_PC.Value 	= PrepareSQLnum(nSum,'Pcs',-3)
		
			SUM Weight FOR NOT DELETED() TO nSum
			ThisFormset.frmSOitemDetail.txtWeight.Value 	= PrepareSQLnum(nSum,'Weight',9,1)
		
		ENDIF
		
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showsumstock
		*ThisFormSet.ShowSumStock()
		
		IF NOT USED('tmpSales_Stock')
			MESSAGEBOX("No 'tmpSales_Stock' table",0,"Error")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpSales_Stock') < 1
		*	ThisFormset.frmSOitemDetail.txtStockEdit.Value		= ''
			ThisFormset.frmSOitemDetail.txtStockLst_QTY.Value 	= 0
			ThisFormset.frmSOitemDetail.txtStockLst_PUtxt.Value 	= ''
			ThisFormset.frmSOitemDetail.txtStockLst_P.Value 		= 0
			
			ThisFormset.frmSOitemDetail.txtStockLst_Total.Value	= 0
			*ThisFormset.frmSOitemDetail.txtStkPaid_total.Value 	= 0
			*ThisFormset.frmReconcileTotal.txtStkPaid_total.Value 	= 0
			ThisFormset.frmSales_Stock.txtStkPaid_Total.Value 	= 0
			
			ThisFormset.frmSOitemDetail.txtStockLst_PC.Value 	= 0
			ThisFormset.frmSOitemDetail.txtStockLst_Dim1.Value	= 0
			ThisFormset.frmSOitemDetail.txtStockLst_LBS.Value 	= 0
			*ThisFormSet.frmSOitemDetail.Visible = .F.
			*ThisFormSet.frmReconcileTotal.Visible = .F.
			
			RETURN .T.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
			
		SELECT tmpSales_Stock
		PRIVATE nRecNo, nCount, nSum
		nRecNo = RECNO()
		
		COUNT FOR NOT DELETED() TO nCount
		
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF DELETED()
			GO TOP
			DO WHILE DELETED()
				SKIP
			ENDDO		
		ENDIF
		
		IF nCount = 1
			*ThisFormset.frmSOitemDetail.txtStockEdit.Value		= tmpSales_Stock.StockEdit
			ThisFormset.frmSOitemDetail.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpSales_Stock.StockLst_QTY,'StockLst_QTY',-5)
			ThisFormset.frmSOitemDetail.txtStockLst_PUtxt.Value 	= Get_PUtext( tmpSales_Stock.StockLst_PU )
			ThisFormset.frmSOitemDetail.txtStockLst_P.Value 		= PrepareSQLnum(tmpSales_Stock.StockLst_P,'StockLst_P',-5)
			ThisFormset.frmSOitemDetail.txtStockLst_Total.Value	= PrepareSQLnum(tmpSales_Stock.StockLst_Total,'StockLst_Total',-5)
			*ThisFormset.frmSOitemDetail.txtStkPaid_total.Value 	= PrepareSQLnum(tmpSales_Stock.StkPaid_Total,'StkPaid_Total',-5)
			*ThisFormset.frmReconcileTotal.txtStkPaid_total.Value 	= PrepareSQLnum(tmpSales_Stock.StkPaid_Total,'StkPaid_Total',-5)
			ThisFormset.frmSales_Stock.txtStkPaid_Total.Value 		= PrepareSQLnum(tmpSales_Stock.StkPaid_Total,'StkPaid_Total',-5)
			
			ThisFormset.frmSOitemDetail.txtStockLst_PC.Value 	= tmpSales_Stock.StockLst_PC
			ThisFormset.frmSOitemDetail.txtStockLst_Dim1.Value	= tmpSales_Stock.StockLst_Dim1
			ThisFormset.frmSOitemDetail.txtStockLst_LBS.Value 	= tmpSales_Stock.StockLst_LBS
		ELSE
			*ThisFormset.frmSOitemDetail.txtStockEdit.Value		= ''
			ThisFormset.frmSOitemDetail.txtStockLst_QTY.Value 	= 0
			ThisFormset.frmSOitemDetail.txtStockLst_PUtxt.Value 	= ''
			ThisFormset.frmSOitemDetail.txtStockLst_P.Value 		= 0
			ThisFormset.frmSOitemDetail.txtStockLst_Total.Value	= 0
			*ThisFormset.frmSOitemDetail.txtStkPaid_total.Value 	= 0
			*ThisFormset.frmReconcileTotal.txtStkPaid_total.Value 	= 0
			ThisFormset.frmSales_Stock.txtStkPaid_Total.Value 		= 0
			
			ThisFormset.frmSOitemDetail.txtStockLst_PC.Value 	= 0
			ThisFormset.frmSOitemDetail.txtStockLst_Dim1.Value	= 0
			ThisFormset.frmSOitemDetail.txtStockLst_LBS.Value 	= 0
		ENDIF
		
		IF nCount > 1
			PRIVATE nSumStockLst_QTY, nSumStockLst_Total, nSumStkPaid_Total
			SET Talk OFF
			*ThisFormset.frmSOitemDetail.txtStockEdit.Value		= tmpSales_Stock.StockEdit
			
			SUM StockLst_QTY FOR NOT DELETED() TO nSumStockLst_QTY
			ThisFormset.frmSOitemDetail.txtStockLst_QTY.Value 	= nSumStockLst_QTY
			
			ThisFormset.frmSOitemDetail.txtStockLst_PUtxt.Value 	= Get_PUtext( tmpSales_Stock.StockLst_PU )
			
			SUM StockLst_Total FOR NOT DELETED() TO nSumStockLst_Total
			ThisFormset.frmSOitemDetail.txtStockLst_Total.Value	= nSumStockLst_Total
			
			SUM StkPaid_Total FOR NOT DELETED() TO nSumStkPaid_Total
			*ThisFormset.frmSOitemDetail.txtStkPaid_Total.Value		= nSumStkPaid_Total
			*ThisFormset.frmReconcileTotal.txtStkPaid_Total.Value	= nSumStkPaid_Total
			*ThisFormset.frmSales_Stock.txtStkPaid_Total.Value 		= nSumStkPaid_Total
			
			PRIVATE nTotal, nQTY
			nTotal = PrepareSQLnum(ThisFormset.frmSOitemDetail.txtStockLst_Total.Value,'StockLst_Total',18,4)
			nQTY   = PrepareSQLnum(ThisFormset.frmSOitemDetail.txtStockLst_QTY.Value,'StockLst_QTY',18,4)
			IF nQTY > 0
				ThisFormset.frmSOitemDetail.txtStockLst_P.Value 		= nTotal / nQTY
			ELSE
				ThisFormset.frmSOitemDetail.txtStockLst_P.Value 		= 0
			ENDIF
			SUM StockLst_PC FOR NOT DELETED() TO nSum
			ThisFormset.frmSOitemDetail.txtStockLst_PC.Value 	= nSum
			SUM StockLst_LBS FOR NOT DELETED() TO nSum
			ThisFormset.frmSOitemDetail.txtStockLst_LBS.Value 	= nSum
			ThisFormset.frmSOitemDetail.txtStockLst_Dim1.Value	= tmpSales_Stock.StockLst_Dim1
		ENDIF
		
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showsum_sales_ps
		*ThisFormSet.ShowSum_Sales_PS()
		
		IF NOT USED('tmpSales_PS')
			MESSAGEBOX("No 'tmpSales_PS' table",0,"Error")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpSales_PS') < 1
			RETURN .F.
		ENDIF
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpSales_PS
		PRIVATE nRecNo, nCount, nSum
		nRecNo = RECNO()
		
		COUNT FOR NOT DELETED() TO nCount
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF nCount = 1
		
			*ThisFormset.frmSOitemDetail.txtPS_Date.Value		= tmpSales_PS.PS_Date
			ThisFormset.frmSOitemDetail.txtSale_QTY.Value	= PrepareSQLnum(tmpSales_PS.Weight,'QTY',-5)
			ThisFormset.frmSOitemDetail.txtSale_PC.Value	= PrepareSQLnum(tmpSales_PS.Pcs,'Pcs',-3)
			ThisFormset.frmSOitemDetail.txtDescript.Value	= PrepareSQLtxt(tmpSales_PS.Descript,'Descript',80)
			ThisFormset.frmSOitemDetail.txtWeight.Value		= PrepareSQLnum(tmpSales_PS.Weight,'Weight',9,1)
		
		ENDIF
		IF nCount > 1
			SET Talk OFF
			*ThisFormset.frmSOitemDetail.txtPS_Date.Value		= tmpSales_PS.PS_Date
			ThisFormset.frmSOitemDetail.txtDescript.Value	= PrepareSQLtxt(tmpSales_PS.Descript,'Descript',80)
			
			SUM Pcs FOR NOT DELETED() TO nSum
			ThisFormset.frmSOitemDetail.txtSale_QTY.Value 	= PrepareSQLnum(nSum,'QTY',-5)
		
			SUM Pcs FOR NOT DELETED() TO nSum
			ThisFormset.frmSOitemDetail.txtSale_PC.Value 	= PrepareSQLnum(nSum,'Pcs',-3)
		
			SUM Weight FOR NOT DELETED() TO nSum
			ThisFormset.frmSOitemDetail.txtWeight.Value 	= PrepareSQLnum(nSum,'Weight',9,1)
		
		ENDIF
		
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE show_invoice
		*ThisFormSet.Show_Invoice()
		PRIVATE nID
		nID = ThisFormSet.frmInvoice.grdInvoice.Column1.Text1.Value
		
		
		IF USED('tmpInvoice')
			IF RECCOUNT('tmpInvoice') > 0
				SELECT tmpInvoice
				LOCATE FOR ID = nID
				
				IF FOUND()
					ThisFormSet.frmInvoice.Visible = .T.
					ThisFormSet.frmInvoice.txtSI_ID.Value		= tmpInvoice.ID
					ThisFormSet.frmInvoice.txtCustomerID.Value 	= tmpInvoice.CustomerID
					ThisFormSet.frmInvoice.txtCustomerName.Value= tmpInvoice.CustomerName
					PRIVATE lReconciled
					lReconciled = PrepareSQLchk(tmpInvoice.Reconciled,'Reconciled')
					ThisFormSet.frmInvoice.chkReconciled.Value	= lReconciled		
		
					IF lReconciled 
						ThisFormSet.frmInvoice.chkMarked.Value	= .T.
					ELSE
						ThisFormSet.frmInvoice.chkMarked.Value	= PrepareSQLchk(tmpInvoice.Marked,'Marked')
						REPLACE Marked WITH lReconciled IN tmpInvoice 
					ENDIF
					*ThisFormSet.frmInvoice.chkMarked.Refresh
					
					ThisFormSet.frmInvoice.txtInvoice.Value 	= PrepareSQLnum(tmpInvoice.Invoice,'Invoice',-3)
					ThisFormSet.frmReconcileTotal.txtInvoice.Value = PrepareSQLnum(tmpInvoice.Invoice,'Invoice',-3)
					ThisformSet.nInvoice						= PrepareSQLnum(tmpInvoice.Invoice,'Invoice',-3)
					ThisFormSet.frmInvoice.txtInvoiceDate.Value = tmpInvoice.InvoiceDate
					ThisFormSet.frmInvoice.txtCustomer_PO.Value = tmpInvoice.Customer_PO
					ThisFormSet.frmInvoice.txtShip_Via.Value 	= tmpInvoice.Ship_Via
					ThisFormSet.frmInvoice.txtSales_Rep.Value 	= tmpInvoice.Sales_Rep
					ThisFormSet.frmInvoice.txtAR_Amount.Value 	= tmpInvoice.AR_Amount
					IF PrepareSQLnum(tmpInvoice.Paid,'Paid',-5) = 0
						*ThisFormSet.frmInvoice.txtPaid.Value 	= ABS(tmpInvoice.AR_Amount)
						ThisFormSet.frmInvoice.txtPaid.Value 	= ABS(tmpInvoice.Amount)
						SELECT tmpInvoice
						nID = tmpInvoice.ID
						*UPDATE tmpInvoice SET Paid = ABS(tmpInvoice.AR_Amount) WHERE ID = nID
						UPDATE tmpInvoice SET Paid = ABS(tmpInvoice.Amount) WHERE ID = nID
						LOCATE FOR ID = nID
					ELSE
						ThisFormSet.frmInvoice.txtPaid.Value 	= tmpInvoice.Paid
					ENDIF
					ThisFormSet.frmInvoice.txtAmount.Value 		= (tmpInvoice.Amount)
					ThisFormSet.frmInvoice.txtDisc_Amount.Value = tmpInvoice.Disc_Amount
					ThisFormSet.frmInvoice.txtItem.Value 		= tmpInvoice.Item
					ThisFormSet.frmInvoice.txtItemTot.Value 	= tmpInvoice.ItemTot
					ThisFormSet.frmInvoice.txtGL_Account.Value 	= tmpInvoice.GL_Account
					ThisFormSet.frmInvoice.txtInvoice_Note.Value= tmpInvoice.Invoice_Note
					ThisFormSet.frmInvoice.txtSOitem.Value 		= tmpInvoice.SOitem
					ThisFormSet.frmInvoice.txtQuantity.Value 	= tmpInvoice.Quantity
					ThisFormSet.frmInvoice.txtUnitPrice.Value 	= tmpInvoice.UnitPrice
					ThisFormSet.frmInvoice.txtTrans_Period.Value = tmpInvoice.Trans_Period
					ThisFormSet.frmInvoice.txtTrans_No.Value 	= tmpInvoice.Trans_No
					ThisFormSet.frmInvoice.txtHeat.Value 		= tmpInvoice.Heat
					ThisFormSet.frmInvoice.txtReturnAuth.Value 	= tmpInvoice.ReturnAuth
					ThisFormSet.frmInvoice.txtDescription.Value	= tmpInvoice.Description
					ThisFormSet.frmInvoice.txtShip_Date.Value 	= tmpInvoice.Ship_Date
					ThisFormSet.frmInvoice.txtDate_Due.Value 	= tmpInvoice.Date_Due
					
					IF PrepareSQLlogic(tmpInvoice.Reconciled,'Reconciled',.F.)
						*ThisFormSet.frmInvoice.cmdSave.Caption = 'Update'
						ThisFormSet.frmReconcileTotal.cmdSaveRec.Caption = 'Update Marked Reconcile'
					ELSE
						*ThisFormSet.frmInvoice.cmdSave.Caption = 'Save'
						ThisFormSet.frmReconcileTotal.cmdSaveRec.Caption = 'Save Marked Reconcile'
					ENDIF
					
					ThisFormSet.Init_InvoiceBrow()
					
					IF DELETED('tmpInvoice') 
						ThisFormset.frmInvoice.BackColor = RGB(255,128,128)
					ELSE
						ThisFormset.frmInvoice.BackColor = RGB(240,240,240)
					ENDIF
				ELSE
					MESSAGEBOX("Did not Find Invoice ID "+ALLTRIM(STR(nID)),16,"Cannot Show Invoice")
					ThisFormSet.frmInvoice.Visible = .F.
				ENDIF
			ELSE
				ThisFormSet.frmInvoice.Visible = .F.
		
			ENDIF
		ELSE
			ThisFormSet.frmInvoice.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE show_invoice_frt
		*ThisFormSet.Show_Invoice_Frt()
		
		PRIVATE nInvoice
		nInvoice = PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		
		IF USED('tmpInvoiceFrt')
			IF RECCOUNT('tmpInvoiceFrt') > 0
				IF nInvoice > 0
					PRIVATE nOldInvoice
					SELECT tmpInvoiceFrt
					nOldInvoice = tmpInvoiceFrt.Invoice
					LOCATE FOR Invoice=nInvoice
					IF NOT FOUND('tmpInvoiceFrt')
						LOCATE FOR Invoice=nOldInvoice
					ENDIF
				ENDIF
				
				ThisFormSet.frmInvoiceFrt.Visible = .T.
						
				ThisFormSet.frmInvoiceFrt.txtSales_Invoice_ID.Value = tmpInvoiceFrt.ID
				ThisFormSet.frmInvoiceFrt.txtInvoice.Value 		= tmpInvoiceFrt.Invoice
				ThisFormSet.frmInvoiceFrt.txtInvoiceDate.Value 	= tmpInvoiceFrt.InvoiceDate
				ThisFormSet.frmInvoiceFrt.txtShip_Via.Value 	= tmpInvoiceFrt.Ship_Via
				ThisFormSet.frmInvoiceFrt.txtAmount.Value 		= tmpInvoiceFrt.Amount
				ThisFormSet.frmInvoiceFrt.txtGL_Account.Value 	= tmpInvoiceFrt.GL_Account
				ThisFormSet.frmInvoiceFrt.txtInvoice_Note.Value	= tmpInvoiceFrt.Invoice_Note
				ThisFormSet.frmInvoiceFrt.txtSOitem.Value 		= tmpInvoiceFrt.SOitem
				ThisFormSet.frmInvoiceFrt.edtDescription.Value	= tmpInvoiceFrt.Description
				
				PRIVATE lReconciled
				lReconciled = PrepareSQLchk(tmpInvoiceFrt.Reconciled,'Reconciled')
				IF lReconciled 
					ThisFormSet.frmInvoiceFrt.chkMarked.Value	= .T.
				ELSE
					ThisFormSet.frmInvoiceFrt.chkMarked.Value	= PrepareSQLchk(tmpInvoiceFrt.Marked,'Marked')
					REPLACE Reconciled WITH lReconciled IN tmpInvoiceFrt
					REPLACE Marked WITH lReconciled IN tmpInvoiceFrt
				ENDIF
				ThisFormSet.frmInvoiceFrt.chkMarked.Refresh
				ThisFormSet.frmInvoiceFrt.chkReconciled.Refresh
			
				IF DELETED('tmpInvoiceFrt') 
					ThisFormset.frmInvoiceFrt.BackColor = RGB(255,128,128)
				ELSE
					ThisFormset.frmInvoiceFrt.BackColor = RGB(240,240,240)
				ENDIF
				
				ThisFormSet.frmReconcileTotal.txtFreightTotal.Value = ThisFormSet.CalcFreightSOitem()
				
			ELSE
				ThisFormSet.frmInvoiceFrt.Visible = .F.
				ThisFormSet.frmReconcileTotal.txtFreightTotal.Value = 0
			ENDIF
		ELSE
			ThisFormSet.frmInvoiceFrt.Visible = .F.
			ThisFormSet.frmReconcileTotal.txtFreightTotal.Value = 0
		ENDIF
		
		
	ENDPROC

	PROCEDURE show_lstsales_detail_id
		*ThisFormSet.Show_lstSales_Detail_ID()
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		*ThisFormSet.Sales_Detail_ID = 0
		
		PRIVATE cSQL, nSQLEXEC
		
		*** Populate lst Sales Reconcile ID
		ThisFormset.frmSalesOrder.lstSales_Detail_ID.Clear
		
		IF USED('tmpSales_Detail_ID')
			USE IN tmpSales_Detail_ID
		ENDIF
		SELECT 0
		
		
		cSQL = "SELECT ID, Reconciled, Cancelled "
		cSQL = cSQL +" FROM dbo.Sales_Detail WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_Detail_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_Detail_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_Detail_ID' )
		ENDIF
		
		ThisFormset.frmSalesOrder.cmdDeleteSales_Rec.Visible = .F.
		
		IF USED('tmpSales_Detail_ID')
			IF RECCOUNT('tmpSales_Detail_ID') > 0
				SELECT tmpSales_Detail_ID
				SCAN
					ThisFormset.frmSalesOrder.lstSales_Detail_ID.AddItem(STR(tmpSales_Detail_ID.ID))
				ENDSCAN
		
				ThisFormset.frmSalesOrder.lstSales_Detail_ID.Refresh
				
				SELECT tmpSales_Detail_ID
				LOCATE FOR ID = ThisFormSet.Sales_Detail_ID 
				IF NOT FOUND()
					GO TOP
				ENDIF
				
				ThisFormset.frmSalesOrder.lstSales_Detail_ID.Value = STR(tmpSales_Detail_ID.ID)
				ThisFormSet.Sales_Detail_ID 				= tmpSales_Detail_ID.ID
				ThisFormSet.frmSOitemDetail.txtID_Sales_Detail.Value	= ThisFormSet.Sales_Detail_ID
				
				
				lReconciled = PrepareSQLchk(tmpSales_Detail_ID.Reconciled,'Reconciled')
				*ThisFormset.frmSalesOrder.chkReconciled.Value = IIF(lReconciled,1,0)
				
				IF RECCOUNT('tmpSales_Detail_ID') > 1
					ThisFormset.frmSalesOrder.cmdDeleteSales_Rec.Visible = .T.
				ENDIF
				
			ELSE
		
				*ThisFormset.frmSalesOrder.chkReconciled.Value = 0
		
			ENDIF		
		ENDIF
		
		
		IF USED('tmpSales_Detail_ID')	
			USE IN tmpSales_Detail_ID	
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE show_packingslip
		*ThisFormSet.Show_PackingSlip()
		
		PRIVATE nPackingSli
		nPackingSli  = ThisFormSet.frmPackingSlip.grdPackingSlip.Column1.Text1.Value
		
		
		*PSn.PS_Date, PSn.TotalWeight
		*Kg,ID_PackingSlip
		
		IF USED('tmpPackingSlip')
			IF RECCOUNT('tmpPackingSlip') > 0
				SELECT tmpPackingSlip
				LOCATE FOR Packingsli = nPackingsli
				
				IF FOUND()
					ThisFormset.frmPackingSlip.Visible = .T.
					ThisFormset.frmPackingSlip.txtPackingsli.Value	= tmpPackingSlip.PackingSli
					ThisFormset.frmPackingSlip.txtSOitem.Value 		= tmpPackingSlip.SOitem
					ThisFormset.frmPackingSlip.txtPS_Date.Value		= tmpPackingSlip.PS_Date
					ThisFormset.frmPackingSlip.txtDescript.Value	= tmpPackingSlip.Descript
		
					*ThisFormset.frmPackingSlip.chkReconciled.Value	= tmpPackingSlip.Reconciled
					ThisFormset.frmPackingSlip.chkReconciled.Refresh
					ThisFormset.frmPackingSlip.chkMarkedPackingSlip.Value = PrepareSQLchk(tmpPackingSlip.Marked,'Marked')
					
					ThisFormset.frmPackingSlip.txtPcs.Value 		= tmpPackingSlip.Pcs
					ThisFormset.frmPackingSlip.txtPO_Num.Value		= tmpPackingSlip.PO_Num
					
					ThisFormset.frmPackingSlip.txtHeat.Value		= tmpPackingSlip.Heat
					ThisFormset.frmPackingSlip.txtAlloy.Value		= tmpPackingSlip.Alloy
					ThisFormset.frmPackingSlip.chkSOitem_cmplt.Value= tmpPackingSlip.SOitem_cmplt
					ThisFormset.frmPackingSlip.txtTotalWeight.Value	= tmpPackingSlip.TotalWeight
					ThisFormset.frmPackingSlip.txtWeight.Value		= tmpPackingSlip.Weight
					
					ThisFormset.frmPackingSlip.txtPT_Qty.Value		= PrepareSQLnum(tmpPackingSlip.PT_Qty,'S_Qty',-5)
					ThisFormset.frmPackingSlip.txtPT_P.Value		= PrepareSQLnum(tmpPackingSlip.PT_P,'PT_P',-5)
					ThisFormset.frmPackingSlip.txtSO_QTY.Value		= PrepareSQLnum(tmpPackingSlip.SO_QTY,'SO_QTY',-5)
					
					ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .T.
					
					*tmpPackingSlip.ID_PackingSlip
					
					***
					IF EMPTY(ThisFormset.frmSOitemDetail.txtDescript.Value)
						ThisFormset.frmSOitemDetail.txtDescript.Value = ThisFormset.frmPackingSlip.txtDescript.Value
					ENDIF
					***
					
					ThisFormSet.ShowSumPackingSlip()
					ThisFormSet.ShowSum_Sales_PS()
							
					IF DELETED('tmpPackingSlip') 
						ThisFormset.frmPackingSlip.BackColor = RGB(255,128,128)
					ELSE
						ThisFormset.frmPackingSlip.BackColor = RGB(240,240,240)
					ENDIF
				ELSE
					ThisFormset.frmPackingSlip.Visible = .F.
					ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .F.
				ENDIF
			ELSE
				ThisFormset.frmPackingSlip.Visible = .F.
				ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .F.
			ENDIF
		ELSE
			ThisFormset.frmPackingSlip.Visible = .F.
			ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .F.
		ENDIF
	ENDPROC

	PROCEDURE show_quote
		*ThisFormSet.Show_Quote()
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tmpQuote')
			USE IN tmpQuote
		ENDIF
		SELECT 0
		
		cSQL = "SELECT Alloy,Form,CC,CL,Pieces,Thck,Sz2,Sz3,Weight "
		cSQL = cSQL +",P_LB,P_PC,P_FT,Cuts,LotP,OtherFLD,OtherP "
		cSQL = cSQL +",RandLen,Metric,Services "
		cSQL = cSQL +" FROM dbo.AllQuotes WHERE  SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuote')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpQuote' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuote")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpQuote")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpQuote' )
		ENDIF
		
		
		IF USED('tmpQuote')
			IF RECCOUNT('tmpQuote') > 0
				ThisFormset.frmQuote.Visible = .T.
				ThisFormset.frmQuote.Alloy1.Value		= tmpQuote.Alloy
				ThisFormset.frmQuote.Form1.Value 		= tmpQuote.Form
				ThisFormset.frmQuote.CC1.Value			= tmpQuote.CC
				ThisFormset.frmQuote.CL1.Value			= tmpQuote.CL
		*		ThisFormset.frmQuote.chkReconciled.Value= tmpQuote.Reconciled
				ThisFormset.frmQuote.Pieces1.Value		= tmpQuote.Pieces
				ThisFormset.frmQuote.Thck1.Value		= tmpQuote.Thck
				ThisFormset.frmQuote.Sz21.Value		= tmpQuote.Sz2
				ThisFormset.frmQuote.Sz31.Value		= tmpQuote.Sz3
				ThisFormset.frmQuote.Weight1.Value 	= tmpQuote.Weight
				
				ThisFormset.frmQuote.P_LB1.Value 	= tmpQuote.P_LB
				ThisFormset.frmQuote.P_PC1.Value 	= tmpQuote.P_PC
				ThisFormset.frmQuote.P_FT1.Value 	= tmpQuote.P_FT
				ThisFormset.frmQuote.Cuts1.Value 	= tmpQuote.Cuts
				ThisFormset.frmQuote.LotP1.Value 	= tmpQuote.LotP
				ThisFormset.frmQuote.OtherFLD1.Value= tmpQuote.OtherFLD
				ThisFormset.frmQuote.OtherP1.Value 	= tmpQuote.OtherP
				
				ThisFormset.frmQuote.chkRL.Value 	= tmpQuote.RandLen
				ThisFormset.frmQuote.chkMetric.Value 	= tmpQuote.Metric
				ThisFormset.frmQuote.chkServices.Value 	= tmpQuote.Services
				
				ThisFormSet.RefreshForms()
				
				IF EMPTY(ThisFormSet.frmSOitemDetail.txtAlloy.Value)
					ThisFormSet.frmSOitemDetail.txtAlloy.Value = tmpQuote.Alloy
				ENDIF
				IF EMPTY(ThisFormSet.frmSOitemDetail.txtForm.Value)
					ThisFormSet.frmSOitemDetail.txtForm.Value = tmpQuote.Form
				ENDIF
				IF EMPTY(ThisFormSet.frmSOitemDetail.txtCC.Value)
					ThisFormSet.frmSOitemDetail.txtCC.Value = PrepareSQLtxt(tmpQuote.CC,'CC',1)
				ENDIF
				IF EMPTY(ThisFormSet.frmSOitemDetail.txtCL.Value)
					ThisFormSet.frmSOitemDetail.txtCL.Value = PrepareSQLtxt(tmpQuote.CL,'CL',1)
				ENDIF
				
				***********************************
				IF EMPTY(PrepareSQLtxt(ThisFormset.frmSOitemDetail.txtQuoted_PUtxt.Value,'Quoted_PU',4))
					PRIVATE cForm, nPU
					cForm = PrepareSQLtxt(ThisFormSet.frmQuote.Form1.Value,'Form',2)
					nPU = GetPUfromForm(cForm,ThisFormSet.nConnHandle)
					ThisFormset.frmSOitemDetail.txtQuoted_PUtxt.Value	= Get_PUtext( n_PU ) &&Get_cPUfrom_nPU()
				ENDIF
				
				IF PrepareSQLnum(ThisFormset.frmSOitemDetail.txtQuoted_PC.Value,'Quoted_PC',-3) < 1
					ThisFormset.frmSOitemDetail.txtQuoted_PC.Value	= PrepareSQLnum(ThisFormSet.frmQuote.PIECES1.Value,'Sale_PC',-3)
				ENDIF
						
				IF PrepareSQLnum(ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value,'Quoted_Dim1',10,4) = 0
					ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value	= PrepareSQLnum(ThisFormSet.frmQuote.THCK1.Value,'StockLst_Dim1',10,4)
				ENDIF
				***********************************
				
				ThisFormSet.frmSalesOrder.cmdHideQuoted.Visible 	= .T.
			ELSE
				ThisFormset.frmQuote.Visible = .F.
				ThisFormSet.frmSalesOrder.cmdHideQuoted.Visible 	= .F.
			ENDIF
		ELSE
			ThisFormset.frmQuote.Visible = .F.
			ThisFormSet.frmSalesOrder.cmdHideQuoted.Visible 	= .F.
		ENDIF
		
		IF ThisFormset.frmQuote.Visible
			IF EMPTY( ThisFormSet.frmSOitemDetail.txtAlloy.Value )
				WAIT WINDOW "Copy Quote data to Sales_Detail form." NOWAIT
				ThisFormSet.CopyQuote2Detail()
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE show_sales_detail
		*ThisFormSet.Show_Sales_Detail()
		
		PRIVATE lCreate_Sales_Reconcile
		lCreate_Sales_Reconcile =.T.
		
		IF ThisFormSet.Sales_Detail_ID > 0
			lCreate_Sales_Reconcile = .F.
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = ThisFormSet.SOitem
		
		PRIVATE cSQL, nSQLEXEC
		
		IF lCreate_Sales_Reconcile
			cSQL = "SELECT * FROM dbo.Sales_Detail "
			IF EMPTY( cSOitem ) OR Proper_SO_item(cSOitem) = Proper_SO_item('')
				cSQL = cSQL +" WITH(NOLOCK) WHERE 0>0 "
			ELSE
				cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL +" AND ISNULL(Invoice,0)> 0 "
			ENDIF
		ELSE
			cSQL = "SELECT * "
			cSQL = cSQL +" FROM dbo.Sales_Detail WHERE ID = "+STR(ThisFormSet.Sales_Detail_ID)
		ENDIF
		cSQL = cSQL +" AND ISNULL(Cancelled,0) = 0"
		
		IF USED('tmpSales_Detail')
			USE IN tmpSales_Detail
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_Detail' )
		ENDIF
		
		IF USED('tmpSales_Detail')
			IF RECCOUNT('tmpSales_Detail') > 0
		
		*		ThisFormset.frmSOitemDetail.Visible = .T.
				*ThisFormset.frmReconcileTotal.Visible = .T.
				
				*ThisFormset.frmSOitemDetail.txtID_Sales_Detail.Value 		= tmpSales_Detail.ID
				ThisFormSet.frmSOitemDetail.txtID_Sales_Detail.Value			= ThisFormSet.Sales_Detail_ID
				ThisFormset.frmSOitemDetail.txtSOitem.Value 		= ThisFormSet.SOitem
		*		ThisFormset.frmSOitemDetail.txtStockEdit.Value 	= tmpSales_Detail.StockEdit
		*		ThisFormset.frmSOitemDetail.txtPS_Date.Value 	= tmpSales_Detail.Shipped
		*		ThisFormset.frmSOitemDetail.txtInvoiceDate.Value	= tmpSales_Detail.InvoiceDate
				
				ThisFormset.frmSOitemDetail.txtAlloy.Value	= tmpSales_Detail.Alloy
				ThisFormset.frmSOitemDetail.txtForm.Value	= tmpSales_Detail.Form
				ThisFormset.frmSOitemDetail.txtCC.Value		= tmpSales_Detail.CC
				ThisFormset.frmSOitemDetail.txtCL.Value		= tmpSales_Detail.CL
				
				ThisFormset.frmSOitemDetail.txtQuoted_QTY.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_QTY,'Quoted_QTY',-5)
				ThisFormset.frmSOitemDetail.txtQuoted_PUtxt.Value 	= Get_PUtext( tmpSales_Detail.Quoted_PU )
				ThisFormset.frmSOitemDetail.txtQuoted_P.Value 		= PrepareSQLnum(tmpSales_Detail.Quoted_P,'Quoted_P',-5)
				ThisFormset.frmSOitemDetail.txtQuoted_Total.Value	= PrepareSQLnum(tmpSales_Detail.Quoted_Total,'Quoted_Total',-5)
				ThisFormset.frmSOitemDetail.txtQuoted_PC.Value 		= PrepareSQLnum(tmpSales_Detail.Quoted_PC,'Quoted_PC',-3)
				ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value	= PrepareSQLnum(tmpSales_Detail.Quoted_Dim1,'Quoted_Dim1',10,4)
				ThisFormset.frmSOitemDetail.txtQuoted_LBS.Value 	= PrepareSQLnum(tmpSales_Detail.Quoted_LBS,'Quoted_LBS',7,2)
				
				ThisFormset.frmSOitemDetail.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpSales_Detail.StockLst_QTY,'StockLst_QTY',-5)
				ThisFormset.frmSOitemDetail.txtStockLst_PUtxt.Value 	= Get_PUtext( tmpSales_Detail.StockLst_PU )
				ThisformSet.frmSOitemDetail.txtSales_PUtxt.Value		= ThisFormset.frmSOitemDetail.txtStockLst_PUtxt.Value
				
				ThisFormset.frmSOitemDetail.txtStockLst_P.Value 		= PrepareSQLnum(tmpSales_Detail.StockLst_P,'StockLst_P',-5)
				
				ThisFormset.frmSOitemDetail.txtStockLst_Total.Value	= PrepareSQLnum(tmpSales_Detail.StockLst_Total,'StockLst_Total',-5)
		*		ThisFormset.frmReconcileTotal.txtStkPaid_Total.Value	= PrepareSQLnum(tmpSales_Detail.StkPaid_Total,'StkPaid_Total',-5)
				ThisFormset.frmSales_Stock.txtStkPaid_Total.Value 	= PrepareSQLnum(tmpSales_Stock.StkPaid_Total,'StkPaid_Total',-5)
				
				ThisFormset.frmSOitemDetail.txtStockLst_PC.Value 	= PrepareSQLnum(tmpSales_Detail.StockLst_PC,'StockLst_PC',-3)
				ThisFormset.frmSOitemDetail.txtStockLst_Dim1.Value	= PrepareSQLnum(tmpSales_Detail.StockLst_Dim1,'StockLst_Dim1',10,4)
				ThisFormset.frmSOitemDetail.txtStockLst_LBS.Value 	= PrepareSQLnum(tmpSales_Detail.StockLst_LBS,'StockLst_LBS',7,2)
				
				*ThisFormset.frmSOitemDetail.txtSale_QTY.Value	= PrepareSQLnum(tmpSales_Detail.Sale_QTY,'Sale_QTY',-5)  &&From PackingSlip  -Shipped
				
				ThisFormset.frmSOitemDetail.txtSale_PC.Value	= PrepareSQLnum(tmpSales_Detail.Sale_PC,'Sale_PC',-3)
				ThisFormset.frmSOitemDetail.txtDescript.Value	= ShowSQLtxt(tmpSales_Detail.Descript,'Descript',254)
				IF EMPTY(ThisFormset.frmSOitemDetail.txtDescript.Value)
					ThisFormset.frmSOitemDetail.txtDescript.Value = ThisFormset.frmPackingSlip.txtDescript.Value
				ENDIF
				ThisFormset.frmSOitemDetail.txtWeight.Value		= PrepareSQLnum(tmpSales_Detail.Sale_LBS,'Sale_LBS',7,1)
				
				ThisFormset.frmSOitemDetail.txtInvoice_QTY.Value	= PrepareSQLnum(tmpSales_Detail.Invoice_QTY,'Invoice_QTY',-5)
				ThisFormset.frmSOitemDetail.txtInvoice_P.Value		= PrepareSQLnum(tmpSales_Detail.Invoice_P,'Invoice_P',-5)
				*ThisFormset.frmSOitemDetail.txtInvoice_Total.Value= PrepareSQLnum(tmpSales_Detail.Invoice_Total,'Invoice_Total',-5)
				ThisFormset.frmReconcileTotal.txtInvoice_Total.Value= PrepareSQLnum(tmpSales_Detail.Invoice_Total,'Invoice_Total',-5)
				
				*ThisFormset.frmSOitemDetail.txtFreightTotal.Value	= PrepareSQLnum(tmpSales_Detail.FreightTotal,'Freight',-5)
				ThisFormset.frmReconcileTotal.txtFreightTotal.Value	= PrepareSQLnum(tmpSales_Detail.FreightTotal,'Freight',-5)
				
				*ThisFormset.frmSOitemDetail.txtReconDiff.Value	= PrepareSQLnum(tmpSales_Detail.ReconDiff,'ReconDiff',-5)
				ThisFormSet.frmReconcileTotal.txtReconDiff.Value	= PrepareSQLnum(tmpSales_Detail.ReconDiff,'ReconDiff',-5)
				
				*ThisFormset.frmSOitemDetail.txtDisc_Allowed.Value= PrepareSQLnum(tmpSales_Detail.Disc_Allowed,'Disc_Allowed',-5)
				ThisFormset.frmReconcileTotal.txtDisc_Allowed.Value	= PrepareSQLnum(tmpSales_Detail.Disc_Allowed,'Disc_Allowed',-5)
				*ThisFormset.frmSOitemDetail.txtSOProfitMargin.Value= PrepareSQLnum(tmpSales_Detail.ProfitMargin,'ProfitMargin',-5)
				ThisFormset.frmReconcileTotal.txtSOProfitMargin.Value= PrepareSQLnum(tmpSales_Detail.ProfitMargin,'ProfitMargin',-5)
				
				
				IF PrepareSQLnum(ThisFormset.frmSOitemDetail.txtQuoted_PC.Value,'Quoted_PC',-3) < 1
					ThisFormset.frmSOitemDetail.txtQuoted_PC.Value	= PrepareSQLnum(ThisFormSet.frmQuote.PIECES1.Value,'Sale_PC',-3)
				ENDIF
				
				IF PrepareSQLnum(ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value,'Quoted_Dim1',10,4) = 0
					ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value	= PrepareSQLnum(ThisFormSet.frmQuote.THCK1.Value,'StockLst_Dim1',10,4)
				ENDIF
			ELSE
		*		ThisFormset.frmSOitemDetail.Visible = .T.
				*ThisFormset.frmReconcileTotal.Visible = .T.
				
				ThisFormset.frmSOitemDetail.txtID_Sales_Detail.Value 			= 0
				ThisFormset.frmSOitemDetail.txtSOitem.Value 		= ThisFormSet.SOitem
		*		ThisFormset.frmSOitemDetail.txtStockEdit.Value 	= CTOD("  /  /  ")
		*		ThisFormset.frmSOitemDetail.txtPS_Date.Value 	= CTOD("  /  /  ")
		*		ThisFormset.frmSOitemDetail.txtInvoiceDate.Value	= CTOD("  /  /  ")
				ThisFormset.frmSOitemDetail.txtAlloy.Value	= ''
				ThisFormset.frmSOitemDetail.txtForm.Value	= ''
				ThisFormset.frmSOitemDetail.txtCC.Value		= ''
				ThisFormset.frmSOitemDetail.txtCL.Value		= ''
				
				ThisFormset.frmSOitemDetail.txtQuoted_QTY.Value 	= 0
				ThisFormset.frmSOitemDetail.txtQuoted_PUtxt.Value 	= Get_PUtext(0)
				ThisFormset.frmSOitemDetail.txtQuoted_P.Value 	= 0
				ThisFormset.frmSOitemDetail.txtQuoted_Total.Value	= 0
				ThisFormset.frmSOitemDetail.txtQuoted_PC.Value 	= 0
				ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value	= 0
				ThisFormset.frmSOitemDetail.txtQuoted_LBS.Value 	= 0
				
				ThisFormset.frmSOitemDetail.txtStockLst_QTY.Value 	= 0
				ThisFormset.frmSOitemDetail.txtStockLst_PUtxt.Value 	= Get_PUtext(0)
				ThisFormset.frmSOitemDetail.txtStockLst_P.Value 		= 0
				
				ThisFormset.frmSOitemDetail.txtStockLst_Total.Value	= 0
				*ThisFormset.frmSOitemDetail.txtStkPaid_Total.Value 	= 0
				*ThisFormset.frmReconcileTotal.txtStkPaid_Total.Value 	= 0
				ThisFormset.frmSales_Stock.txtStkPaid_Total.Value 	= 0
				
				ThisFormset.frmSOitemDetail.txtStockLst_PC.Value 	= 0
				ThisFormset.frmSOitemDetail.txtStockLst_Dim1.Value	= 0
				ThisFormset.frmSOitemDetail.txtStockLst_LBS.Value 	= 0
				
				ThisFormset.frmSOitemDetail.txtSale_QTY.Value	= 0
				ThisFormset.frmSOitemDetail.txtSale_PC.Value		= 0
				ThisFormset.frmSOitemDetail.txtDescript.Value	= ''
				ThisFormset.frmSOitemDetail.txtWeight.Value		= 0
				
				ThisFormset.frmSOitemDetail.txtInvoice_QTY.Value	= 0
				ThisFormset.frmSOitemDetail.txtInvoice_P.Value	= 0
				*ThisFormset.frmSOitemDetail.txtInvoice_Total.Value		= 0
				ThisFormset.frmReconcileTotal.txtInvoice_Total.Value	= 0
				*ThisFormset.frmSOitemDetail.txtFreightTotal.Value		= 0
				ThisFormset.frmReconcileTotal.txtFreightTotal.Value		= 0
				*ThisFormset.frmSOitemDetail.txtReconDiff.Value	= 0
				ThisFormSet.frmReconcileTotal.txtReconDiff.Value	= 0
				*ThisFormset.frmSOitemDetail.txtDisc_Allowed.Value= 0
				ThisFormset.frmReconcileTotal.txtDisc_Allowed.Value= 0
				*ThisFormset.frmSOitemDetail.txtSOProfitMargin.Value	= 0
				ThisFormset.frmReconcileTotal.txtSOProfitMargin.Value	= 0
				
			ENDIF
			**************************************
			
			cSQL = "SELECT S.*,Q.Pieces,Q.Thck,Q.Weight "
			cSQL = cSQL +" ,dbo.f_DescriptCL(Q.Alloy,Q.CC,Q.CL,Q.Form,Q.Thck,Q.Sz2,Q.Sz3,Q.Weight,Q.RandLen) AS Descript "
			cSQL = cSQL +" FROM dbo.Sales S WITH(NOLOCK) "
			cSQL = cSQL +" INNER JOIN dbo.AllQuotes Q WITH(NOLOCK) ON S.Soitem = Q.SOitem "
			IF EMPTY( cSOitem ) OR Proper_SO_item(cSOitem) = Proper_SO_item('')
				cSQL = cSQL +" WHERE 0>0 "
			ELSE
				cSQL = cSQL +" WHERE S.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF
		
			IF USED('tmpSales')
				USE IN tmpSales
			ENDIF
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales' )
			ENDIF
		
			IF USED('tmpSales')
				IF RECCOUNT('tmpSales') > 0
					ThisFormset.frmSOitemDetail.txtSales_QTY.Value 	= PrepareSQLnum(tmpSales.Quoted_QTY,'Quoted_QTY',-5)
					ThisFormset.frmSOitemDetail.txtSales_PUtxt.Value 	= Get_PUtext( tmpSales.Quoted_PU )
					ThisFormset.frmSOitemDetail.txtSales_P.Value 	= PrepareSQLnum(tmpSales.Quoted_P,'Quoted_P',-5)
					ThisFormset.frmSOitemDetail.txtSales_Total.Value= PrepareSQLnum(tmpSales.Quoted_Total,'Quoted_Total',-5)
					
					ThisFormset.frmSOitemDetail.txtSales_PC.Value 	= PrepareSQLnum(tmpSales.Pieces,'Pieces',-3)
					*ThisFormset.frmSOitemDetail.txtSales_Dim1.Value	= PrepareSQLnum(tmpSales.Thck,'Thck',10,4)
					ThisFormset.frmSOitemDetail.txtSales_Descript.Value	= PrepareSQLtxt(tmpSales.Descript,'Descript',-1)
					ThisFormset.frmSOitemDetail.txtSales_LBS.Value 	= PrepareSQLnum(tmpSales.Weight ,'Weight ',7,2)
				ELSE
					ThisFormset.frmSOitemDetail.txtSales_QTY.Value 	= 0
					ThisFormset.frmSOitemDetail.txtSales_PUtxt.Value 	= ''
					ThisFormset.frmSOitemDetail.txtSales_P.Value 	= 0
					ThisFormset.frmSOitemDetail.txtSales_Total.Value = 0
					
					ThisFormset.frmSOitemDetail.txtSales_PC.Value 	= 0
					*ThisFormset.frmSOitemDetail.txtSales_Dim1.Value	= 0
					ThisFormset.frmSOitemDetail.txtSales_Descript.Value	= ''
					ThisFormset.frmSOitemDetail.txtSales_LBS.Value 	= 0		
				ENDIF
				USE IN tmpSales
			ENDIF
				
			**************************************
			ThisFormSet.Show_lstSales_Detail_ID()
			
			*Sum Stock
			ThisFormSet.ShowSumStock()
			
			*Sum PackingSlip
			ThisFormSet.ShowSumPackingSlip()
			ThisFormSet.ShowSum_Sales_PS()
			
			*Sum Invoice
			ThisFormSet.ShowSumInvoice()
			
			*Show Quoted
			ThisFormSet.ShowQuotedTotal()
				
			*AllQuote
			ThisFormSet.Show_Quote()		
			
			*Add up SO item -Actually is summing for Invoice!!!
			ThisFormSet.Sum_Totals()
			
		ELSE
		*	ThisFormset.frmSOitemDetail.Visible = .F.
			*ThisFormset.frmReconcileTotal.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE show_sales_ps
		*ThisFormSet.Show_Sales_PS()
		
		PRIVATE nPackingSli
		nPackingSli  = ThisFormSet.frmSales_PS.grdSales_PS.Column1.Text1.Value
		
		
		*PSn.PS_Date, PSn.TotalWeight
		*Kg,ID_PackingSlip
		
		IF USED('tmpSales_PS')
			IF RECCOUNT('tmpSales_PS') > 0
				SELECT tmpSales_PS
				LOCATE FOR Packingsli = nPackingsli
				
				IF FOUND()
					ThisFormset.frmSales_PS.Visible = .T.
		
					ThisFormset.frmSales_PS.txtPackingsli.Value	= PrepareSQLnum(tmpSales_PS.PackingSli,'PackingSli',-3)
					ThisFormset.frmSales_PS.txtSOitem.Value 	= PrepareSQLtxt(tmpSales_PS.SOitem,'SOitem',10)
					ThisFormset.frmSales_PS.txtPS_Date.Value	= PrepareSQLdate(tmpSales_PS.PS_Date,'PS_Date')
					ThisFormset.frmSales_PS.txtHeat.Value		= PrepareSQLtxt(tmpSales_PS.Heat,'Heat',50)
					
					ThisFormset.frmSales_PS.txtTBL.Value 		= PrepareSQLtxt(tmpSales_PS.TBL,'TBL',1)
					ThisFormset.frmSales_PS.txtID_Detail.Value 		= PrepareSQLnum(tmpSales_PS.ID_Detail,'ID_Detail',-3)
					ThisFormset.frmSales_PS.txtSales_Stock_ID.Value = PrepareSQLnum(tmpSales_PS.Sales_Stock_ID,'Sales_Stock_ID',-3)
			
					ThisFormset.frmSales_PS.chkCmplt.Value 		= PrepareSQLchk(tmpSales_PS.Cmplt,'Cmplt')
					ThisFormset.frmSales_PS.chkReconciled.Value	= PrepareSQLchk(tmpSales_PS.Reconciled,'Reconciled')
					ThisFormset.frmSales_PS.chkCncld.Value 		= PrepareSQLchk(tmpSales_PS.Cncld,'Cncld')
					
		*?			ThisFormset.frmSales_PS.chkMarkedPackingSlip.Value = PrepareSQLchk(tmpSales_PS.Marked,'Marked')
					
					
		*Acct_PU
					ThisFormset.frmSales_PS.txtAcct_QTY.Value 	= PrepareSQLnum(tmpSales_PS.Acct_QTY,'Acct_QTY',-5)
					ThisFormset.frmSales_PS.txtAcct_P.Value 	= PrepareSQLnum(tmpSales_PS.Acct_P,'Acct_P',-5)
					ThisFormset.frmSales_PS.txtAcct_Total.Value 	= PrepareSQLnum(tmpSales_PS.Acct_Total,'Acct_Total',-5)
					ThisFormset.frmSales_PS.txtNeeded_QTY.Value 	= PrepareSQLnum(tmpSales_PS.Needed_QTY,'Needed_QTY',-5)
		
		*Cust_PU
					ThisFormset.frmSales_PS.txtCust_QTY.Value 	= PrepareSQLnum(tmpSales_PS.Cust_QTY,'Cust_QTY',-5)
					ThisFormset.frmSales_PS.txtCust_P.Value 	= PrepareSQLnum(tmpSales_PS.Cust_P,'Cust_P',-5)
					ThisFormset.frmSales_PS.txtCust_Total.Value 	= PrepareSQLnum(tmpSales_PS.Cust_Total,'Cust_Total',-5)
					
		*?			ThisFormset.frmSales_PS.chkSOitem_cmplt.Value= tmpSales_PS.SOitem_cmplt
		
					ThisFormset.frmSales_PS.txtWeight.Value		= PrepareSQLnum(tmpSales_PS.Pounds,'Pounds',9,1)
					
					
					ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .T.
					
					*tmpSales_PS.ID_PackingSlip
					
				***
					
					ThisFormSet.ShowSumPackingSlip()
							
					IF DELETED('tmpSales_PS') 
						ThisFormset.frmSales_PS.BackColor = RGB(255,128,128)
					ELSE
						ThisFormset.frmSales_PS.BackColor = RGB(240,240,240)
					ENDIF
				ELSE
					ThisFormset.frmSales_PS.Visible = .F.
					ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .F.
				ENDIF
			ELSE
				ThisFormset.frmSales_PS.Visible = .F.
				ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .F.
			ENDIF
		ELSE
			ThisFormset.frmSales_PS.Visible = .F.
			ThisFormSet.frmSalesOrder.cmdHideShip.Visible 	= .F.
		ENDIF
	ENDPROC

	PROCEDURE show_sales_stock
		*ThisFormSet.Show_Sales_Stock()
		PRIVATE nID
		nID = ThisFormSet.frmSales_Stock.grdSales_Stock.Column1.Text1.Value
		
		
		IF USED('tmpSales_Stock')
			IF RECCOUNT('tmpSales_Stock') > 0
				SELECT tmpSales_Stock
				LOCATE FOR ID = nID
				
				IF FOUND()
					ThisFormset.frmSales_Stock.Visible = .T.
					ThisFormset.frmSales_Stock.txtID.Value 			= tmpSales_Stock.ID
					ThisFormset.frmSales_Stock.txtSOitem.Value 		= tmpSales_Stock.SOitem
					ThisFormset.frmSales_Stock.txtStockEdit.Value 	= tmpSales_Stock.StockEdit
					
					ThisFormset.frmSales_Stock.chkReconciled.Value 	= tmpSales_Stock.Reconciled
					
					
					ThisFormset.frmSales_Stock.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpSales_Stock.StockLst_QTY,'StockLst_QTY',-5)
					ThisFormset.frmSales_Stock.txtStockLst_PU.Value 	= Get_PUtext( tmpSales_Stock.StockLst_PU )
					ThisFormset.frmSales_Stock.txtStockLst_P.Value 		= PrepareSQLnum(tmpSales_Stock.StockLst_P,'StockLst_P',-5)
					ThisFormset.frmSales_Stock.txtStkPaid_P.Value 		= PrepareSQLnum(tmpSales_Stock.StkPaid_P,'StkPaid_P',-5)
					
					ThisFormset.frmSales_Stock.txtStockLst_Total.Value 	= PrepareSQLnum(tmpSales_Stock.StockLst_Total,'StockLst_Total',-5)
					ThisFormset.frmSales_Stock.txtStkPaid_Total.Value 	= PrepareSQLnum(tmpSales_Stock.StkPaid_Total,'StkPaid_Total',-5)
					ThisFormset.frmSOitemDetail.txtStkPaid_Total.Value	= PrepareSQLnum(tmpSales_Stock.StkPaid_Total,'StkPaid_Total',-5)
					
					ThisFormset.frmSales_Stock.txtStockLst_PC.Value 	= PrepareSQLnum(tmpSales_Stock.StockLst_PC,'StockLst_PC',-3)
					ThisFormset.frmSales_Stock.txtStockLst_Dim1.Value 	= PrepareSQLnum(tmpSales_Stock.StockLst_Dim1,'StockLst_Dim1',10,4)
					ThisFormset.frmSales_Stock.txtStockLst_Dim2.Value 	= PrepareSQLnum(tmpSales_Stock.StockLst_Dim2,'StockLst_Dim2',9,3)
					ThisFormset.frmSales_Stock.txtStockLst_Dim3.Value 	= PrepareSQLnum(tmpSales_Stock.StockLst_Dim3,'StockLst_Dim3',9,3)
					ThisFormset.frmSales_Stock.txtStockLst_LBS.Value 	= PrepareSQLnum(tmpSales_Stock.StockLst_LBS,'StockLst_LBS',7,1)
					
					ThisFormset.frmSales_Stock.txtOrig_PC.Value 		= PrepareSQLnum(tmpSales_Stock.Orig_PC,'Orig_PC',-3)
					ThisFormset.frmSales_Stock.txtOrig_Dim1.Value 		= tmpSales_Stock.Orig_Dim1
					ThisFormset.frmSales_Stock.txtOrig_Dim2.Value 		= tmpSales_Stock.Orig_Dim2
					ThisFormset.frmSales_Stock.txtOrig_Dim3.Value 		= tmpSales_Stock.Orig_Dim3
					ThisFormset.frmSales_Stock.txtOrig_LBS.Value 		= PrepareSQLnum(tmpSales_Stock.Orig_LBS,'Orig_LBS',7,1)
		
					ThisFormSet.frmSales_Stock.txtAlloy.Value 			= tmpSales_Stock.Alloy
					ThisFormSet.frmSales_Stock.txtForm.Value 			= tmpSales_Stock.Form
					ThisFormSet.frmSales_Stock.txtCC.Value 				= tmpSales_Stock.CC
					ThisFormSet.frmSales_Stock.txtCL.Value 				= tmpSales_Stock.CL
					ThisFormSet.frmSales_Stock.chkConsumed.Value 		= tmpSales_Stock.Consumed
						
					ThisFormset.frmSales_Stock.txtTBL.Value				= tmpSales_Stock.TBL
					ThisFormset.frmSales_Stock.txtStockLst_ID.Value		= PrepareSQLnum(tmpSales_Stock.StockLst_ID,'StockLst_ID',-3)
					ThisFormset.frmSales_Stock.txtStockLst_ID_Detail.Value	= tmpSales_Stock.StockLst_ID_Detail		
					ThisFormset.frmSales_Stock.txtID_Detail_Process.Value	= tmpSales_Stock.ID_Detail_Process
					IF ISNULL(tmpSales_Stock.StockLst_POitem)
						*ThisFormset.frmSales_Stock.txtStockLst_POitem.Value 	= get_POitem_StockLstID(tmpSales_Stock.StockLst_ID,tmpSales_Stock.StockLst_Dim1,tmpSales_Stock.Sales_Detail_ID,tmpSales_Stock.TBL,ThisFormSet.nConnHandle)
						ThisFormset.frmSales_Stock.txtStockLst_POitem.Value 	= get_POitem_StockLstID(tmpSales_Stock.StockLst_ID,tmpSales_Stock.Sales_Detail_ID,tmpSales_Stock.TBL,ThisFormSet.nConnHandle)
					ELSE
						ThisFormset.frmSales_Stock.txtStockLst_POitem.Value 	= tmpSales_Stock.StockLst_POitem
					ENDIF
					ThisFormSet.frmSales_Stock.chkMarked.Value	= PrepareSQLchk(tmpSales_Stock.Marked,'Marked')
					*ThisFormSet.frmSales_Stock.chkMarked.Refresh
					
					ThisFormSet.Sales_Detail_ID 						= PrepareSQLnum(tmpSales_Stock.Sales_Detail_ID,'Sales_Detail_ID',-3)
					ThisFormset.frmSalesOrder.lstSales_Detail_ID.Value	= ThisFormSet.Sales_Detail_ID
		
					
					ThisFormSet.frmSalesOrder.cmdHideStock.Visible 	= .T.
					
					ThisFormSet.ShowSumStock()
					
					IF DELETED('tmpSales_Stock') 
						ThisFormset.frmSales_Stock.BackColor = RGB(255,128,128)
					ELSE
						ThisFormset.frmSales_Stock.BackColor = RGB(240,240,240)
					ENDIF
					
				ELSE
					ThisFormset.frmSales_Stock.Visible = .F.
					ThisFormSet.frmSalesOrder.cmdHideStock.Visible 	= .F.
				ENDIF
			ELSE
				ThisFormset.frmSales_Stock.Visible = .F.
				ThisFormSet.frmSalesOrder.cmdHideStock.Visible 	= .F.
			ENDIF
		ELSE
			ThisFormset.frmSales_Stock.Visible = .F.
			ThisFormSet.frmSalesOrder.cmdHideStock.Visible 	= .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE sum_totals
		*ThisFormSet.Sum_Totals()
		
		ThisFormSet.frmTotals.Visible = .T.
		
		**Find Invoices and SalesNum from Invoice that have SalesNum in other Invoices
		nInvoice = PrepareSQLnum( ThisFormSet.frmSalesOrder.txtInvoice.Value,'Invoice',-3)
		*Place the Invoice number on the Totals form
		ThisFormset.frmTotals.txtInvoice.Value = nInvoice
		
		PRIVATE cSQL, nSQLEXEC
		**************************************************************
		PRIVATE nRec_Inv_Total, nRec_Inv_Frt, nRec_Invoices, nRec_SO, nRec_SD
		PRIVATE nMrk_Inv_Total, nMrk_Inv_Frt, nNRec_Invoices, nNRec_SO, nNRec_SD
		PRIVATE nAll_Inv_Total, nAll_Inv_Frt
		nRec_Inv_Total	= 0
		nRec_Inv_Frt	= 0
		nRec_Invoices	= 0
		nRec_SO			= 0
		nRec_SD			= 0
		nMrk_Inv_Total	= 0
		nMrk_Inv_Frt	= 0
		nNRec_Invoices	= 0
		nNRec_SO		= 0
		nNRec_SD		= 0
		nAll_Inv_Total	= 0	&&All does not look at Reconciled at all
		nAll_Inv_Frt	= 0
		
		*1
		*nRec_Inv_Total	**************************************************************
		IF USED('tmpSN_Inv')
			USE IN tmpSN_Inv
		ENDIF
		SELECT 0
		
		cSQL = "SELECT SUM(Amount) AS Total "
		cSQL = cSQL + " FROM dbo.Sales_Invoice "
		cSQL = cSQL + " WHERE Invoice = "+STR(nInvoice)+""
		cSQL = cSQL + " AND ISNULL(Reconciled,0) = 1"
		cSQL = cSQL + " AND GL_Account <> 69000 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSN_Inv')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSN_Inv' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSN_Inv")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSN_Inv")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSN_Inv' )
		ENDIF
		
		IF USED('tmpSN_Inv')
			IF RECCOUNT('tmpSN_Inv') > 0
				nRec_Inv_Total = PrepareSQLnum(tmpSN_Inv.Total,'Amount',-5)
			ENDIF
			
			USE IN 'tmpSN_Inv'
		ENDIF
			
		*2
		*nRec_Inv_Frt **************************************************************
		IF USED('tmpSN_Inv')
			USE IN tmpSN_Inv
		ENDIF
		SELECT 0
		
		cSQL = "SELECT SUM(Amount) AS Total "
		cSQL = cSQL + " FROM dbo.Sales_Invoice "
		cSQL = cSQL + " WHERE Invoice = "+STR(nInvoice)+""
		cSQL = cSQL + " AND ISNULL(Reconciled,0) = 1"
		cSQL = cSQL + " AND GL_Account = 69000 "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSN_Inv')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSN_Inv' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSN_Inv")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSN_Inv")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSN_Inv' )
		ENDIF
		
		IF USED('tmpSN_Inv')
			IF RECCOUNT('tmpSN_Inv') > 0
				nRec_Inv_Frt = PrepareSQLnum(tmpSN_Inv.Total,'Amount',-5)
			ENDIF
			
			USE IN 'tmpSN_Inv'
		ENDIF
		
		*3
		*nRec_Invoices **************************************************************
		IF USED('tmpSN_Inv')
			USE IN tmpSN_Inv
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ISNULL(SUM(Amount),0) AS Total "
