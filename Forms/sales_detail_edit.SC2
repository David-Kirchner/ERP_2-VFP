	PROCEDURE frmInvoice.cmdSOiDelete.Click
		PRIVATE cSOitem, nInvoice, nMess, nInvoice_ID
		nInvoice = PrepareSQLnum(ThisForm.txtInvoice.Value,'Invoice',-3)
		cSOitem = PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		nInvoice_ID = PrepareSQLnum(ThisForm.grdInvoice.Column1.Text1.Value,'Sales_Invoice_ID',-3)
		
		nMess = MESSAGEBOX("Are you sure you want to Delete this Sales_Invoice_ID:"+ALLTRIM(STR(nInvoice_ID))+"?"+CHR(13)+"This delete will be recorded.",4+32,"Delete?")
		IF nMess = 6
		
			cSQL = "DELETE FROM dbo.Sales_Invoice WHERE ID = "+ALLTRIM(STR(nInvoice_ID))
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_Detail_ID')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, '' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '' )
			ELSE
				TrackMess("Sales_Invoice_ID:"+ALLTRIM(STR(nInvoice_ID))+" was be DELETED FROM dbo.Sales_Invoice")
				TrackError("Deleted in Sales_Invoice.","Sales_Invoice_ID:"+ALLTRIM(STR(nInvoice_ID))+" SOitem:"+ALLTRIM(cSOitem)+" was DELETED FROM dbo.Sales_Invoice","Sales_DetailEdit:frmInvoice.cmdSOiDelete",LINENO(1))
				MESSAGEBOX("DELETED."+CHR(13)+"Next use import to get correct data from Sage.",0,"DELETED.")
			ENDIF
		
			ThisFormSet.FindSalesOrder()
			*ThisFormSet.Init_Invoice()
			*ThisFormSet.Show_Invoice()
			
			
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE frmInvoice.grdInvoice.AfterRowColChange
		LPARAMETERS nColIndex
		
		PRIVATE nID
		nID = PrepareSQLnum(tmpInvoice_ID.ID,'ID',-3)
		
		IF USED('tmpInvoice')
			SELECT tmpInvoice
			LOCATE FOR ID = nID 
			
			IF FOUND('tmpInvoice')
		
				ThisFormSet.Show_Invoice()
				ThisFormSet.ShowSumInvoice()
				ThisFormSet.Show_Invoice_Frt()
				
				WAIT WINDOW "Refreshed." NOWAIT
			ELSE
				MESSAGEBOX("Did not Find ID = "+ALLTRIM(STR(nID)),16,"Not Found")
			ENDIF
		ELSE
			MESSAGEBOX("Invoice table not found",16,"Invoice table not found")
		ENDIF
		
	ENDPROC

