	PROCEDURE frmSalesOrder.lstSOitems.InteractiveChange
		
		ThisFormSet.SOitem = This.Value
		ThisFormSet.Init_lstSales_Detail_ID()
		*ThisFormSet.Refresh_Sales_Detail_ID()
		
		WAIT WINDOW "Refreshed." NOWAIT
	ENDPROC

	PROCEDURE frmSalesOrder.txtInvoice.Valid
		PRIVATE nInvoice
		nInvoice = This.Value
		
		IF VARTYPE(nInvoice) = 'C'
			nInvoice = VAL(nInvoice)
		ENDIF
		IF VARTYPE(nInvoice) = 'N'
			IF nInvoice > 0
		*		ThisForm.cmdFindInvoice.Click
				ThisFormSet.nInvoice = nInvoice
		
				ThisFormSet.FindInvoice()
		
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmSalesOrder.txtSalesOrder.Valid
		PRIVATE nSO
		nSO = This.Value
		
		IF VARTYPE(nSO) = 'C'
			nSO = VAL(nSO)
		ENDIF
		IF VARTYPE(nSO) = 'N'
			IF nSO > 0
				IF ThisFormSet.SalesNum <> nSO
					ThisFormSet.SalesNum = nSO
					
					ThisFormSet.FindSalesOrder()
					
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

