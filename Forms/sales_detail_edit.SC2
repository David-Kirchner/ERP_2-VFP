		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSN_Inv' )
		ENDIF
		
		IF USED('tmpSN_Inv')
			IF RECCOUNT('tmpSN_Inv') > 0
				nAll_Inv_Frt = PrepareSQLnum(tmpSN_Inv.Total,'Amount',-5)
			ENDIF
			
			USE IN 'tmpSN_Inv'
		ENDIF
		
		
		
		*********************************************************
		
		ThisFormset.frmTotals.txtRec_Inv_Total.Value= nRec_Inv_Total
		ThisFormset.frmTotals.txtMrk_Inv_Total.Value= nMrk_Inv_Total
		ThisFormset.frmTotals.txtAll_Inv_Total.Value= nAll_Inv_Total
		
		ThisFormset.frmTotals.txtInv_Diff.Value	= nAll_Inv_Total - nRec_Inv_Total - nMrk_Inv_Total
		ThisFormset.frmTotals.txtAll_Invoice.Value	= nAll_Inv_Total + nAll_Inv_Frt
		
		ThisFormset.frmTotals.txtRec_Inv_Frt.Value	= nRec_Inv_Frt
		ThisFormset.frmTotals.txtMrk_Inv_Frt.Value	= nMrk_Inv_Frt
		ThisFormset.frmTotals.txtAll_Inv_Frt.Value	= nAll_Inv_Frt
		
		****
		ThisFormset.frmTotals.txtRec_Invoices.Value	= nRec_Invoices
		ThisFormset.frmTotals.txtRec_SO.Value		= nRec_SO
		ThisFormset.frmTotals.txtRec_SD.Value		= nRec_SD
		
		ThisFormset.frmTotals.txtNRec_Invoices.Value	= nNRec_Invoices
		ThisFormset.frmTotals.txtNRec_SO.Value		= nNRec_SO
		ThisFormset.frmTotals.txtNRec_SD.Value		= nNRec_SD
		
		
		IF nAll_Inv_Total - nRec_Inv_Total - nMrk_Inv_Total = 0
			ThisFormset.frmTotals.cmdSaveRec.Visible = .T.
		ELSE
		*	ThisFormset.frmTotals.cmdSaveRec.Visible = .F.
		ENDIF
		
	ENDPROC

	PROCEDURE unreconcile
		*ThisFormSet.UnReconcile()
		
		PRIVATE lReconciled
		lReconciled = .F.
		
		PRIVATE nSales_Detail_ID,cSOitem,nInvoice,lPassed 
		*nSales_Detail_ID= ThisFormset.frmSOitemDetail.txtID_Sales_Detail.Value 		
		*nSales_Detail_ID= ThisFormset.frmInvoice.txtID ??
		cSOitem			= ThisFormset.frmInvoice.txtSOitem.Value
		nInvoice		= PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		lPassed 		= .T.
		
		PRIVATE cSOitem00
		cSOitem00 = Proper_SO_Item( STR(VAL(cSOitem))+"-00" )
		
		PRIVATE cQSL, nSQLEXEC 
		cSQL = "UPDATE dbo.Sales_Detail SET "
		cSQL = cSQL +" Reconciled=0"
		*cSQL = cSQL +" WHERE ID="+STR(nSales_Detail_ID)
		cSQL = cSQL +" WHERE InvoiceID="+STR(nInvoice)
		cSQL = cSQL + " AND ( SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " OR SOitem = dbo.f_ProperSOitem('"+cSOitem00+"')"
		cSQL = cSQL + " )"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
			lPassed = .F.
		ELSE	
			IF lPassed 
				lPassed = ThisFormSet.Save_PackingSlip_Reconcile(lReconciled, nSales_Detail_ID)
				IF lPassed 
					Save_SOitem_Status( cSOitem, VAL(cSOitem), "UnRecncile", "Sales Detail was marked as Reconciled=0 at SO Invoice screen.", ThisFormSet.nConnHandle)
				ENDIF
			ENDIF
			*nSales_Detail_ID
			*ID_PackingSlip= "+ALLTRIM(STR( nID_PackingSlip))
		
			IF lPassed 
				lPassed = ThisFormSet.Save_Sales_Stock_Reconcile( lReconciled, nSales_Detail_ID )	
			ENDIF
			*nSales_Detail_ID
			*cPOitem
			*dbo.Sales_Stock nID
				
			IF lPassed 
				lPassed = ThisFormSet.Save_Invoice_Frt_Reconcile(lReconciled, nSales_Detail_ID)
			ENDIF
			*nSales_Detail_ID
			*dbo.Sales_Invoice nID
		ENDIF
		
		IF lPassed 
			*ThisFormSet.frmSalesOrder.chkReconciled.Value = 0
			ThisFormSet.frmInvoice.chkReconciled.Value = 0
			ThisFormSet.frmInvoice.chkReconciled.Refresh
			*ThisFormSet.frmInvoice.chkMarked.Value	= 
			
			*ThisFormSet.frmInvoiceFrt.Refresh 
			ThisFormSet.frmSales_stock.chkReconciled.Value = 0
			ThisFormSet.frmSales_stock.chkReconciled.Refresh
			ThisFormSet.frmPackingSlip.chkReconciled.Value = 0
			ThisFormSet.frmPackingSlip.chkReconciled.Refresh
			
			MESSAGEBOX("SOitem-Invoice has been UN Reconciled.",0+64,"Saved.")
		ENDIF
	ENDPROC

	PROCEDURE frmInvoice.chkMarked.Click
