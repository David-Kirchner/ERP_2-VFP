	PROCEDURE frmTotals.cmdMarkAll_Inv.Click
		PRIVATE nInvoice
		nInvoice = ThisForm.txtInvoice.Value
		
		IF nInvoice = 0
			RETURN
		ENDIF
		
		PRIVATE nOldInvoice
		
		IF USED('tmpInvoice')
		
			SELECT tmpInvoice
			nOldInvoice = tmpInvoice.Invoice
			
			SELECT tmpInvoice
			REPLACE Marked WITH .T. FOR Invoice = nInvoice
				
			GO TOP
		
			LOCATE FOR Invoice=nInvoice
			
			IF NOT FOUND('tmpInvoice') AND nOldInvoice > 0
				LOCATE FOR Invoice=nOldInvoice
			ENDIF
			
			ThisFormSet.frmInvoice.chkMarked.Value = 1
			ThisFormSet.frmInvoice.chkMarked.Refresh
		ENDIF
		
		****************
		
		IF USED('tmpInvoiceFrt')
		
			SELECT tmpInvoiceFrt
			nOldInvoice = tmpInvoiceFrt.Invoice
			
			SELECT tmpInvoiceFrt
			REPLACE Marked WITH .T. FOR Invoice = nInvoice
			
			GO TOP
		
			LOCATE FOR Invoice=nInvoice
			
			IF NOT FOUND('tmpInvoiceFrt')
				LOCATE FOR Invoice=nOldInvoice AND nOldInvoice > 0
			ENDIF
		
			ThisFormSet.frmInvoiceFrt.chkMarked.Value = 1	
			ThisFormSet.frmInvoiceFrt.chkMarked.Refresh
		ENDIF
		
		ThisFormSet.Sum_Totals()
		
		
	ENDPROC

	PROCEDURE frmTotals.cmdSaveRec.Click
		IF ThisFormSet.SaveInvoiceAmount()
			IF This.Caption = "Save Marked Reconcile"
				This.Caption = "Update Marked Reconcile"
			ENDIF
			ThisFormSet.Sum_Totals()
		ENDIF
		
		
		
	ENDPROC

