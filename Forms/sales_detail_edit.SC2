	PROCEDURE frmInvoice.txtPaid.Valid
		PRIVATE nQuantity, nID, nPrevQuantity, nAmount, nPaid
		
		nPaid = PrepareSQLnum(This.Value,'Paid',-5)
		nID = tmpInvoice.ID
		
		UPDATE tmpInvoice SET Paid = nPaid WHERE ID = nID
		
		SELECT tmpInvoice
		LOCATE FOR ID=nID
		
		ThisFormSet.Sum_Totals()
	ENDPROC

	PROCEDURE frmInvoice.txtQuantity.Valid
		PRIVATE nQuantity, nID, nPrevQuantity, nAmount
		nQuantity = This.Value
		nID = tmpInvoice.ID
		nPrevQuantity = tmpInvoice.Quantity
		
		UPDATE tmpInvoice SET Quantity = nQuantity WHERE ID = nID
		
		SELECT tmpInvoice
		LOCATE FOR ID=nID
		
	ENDPROC

