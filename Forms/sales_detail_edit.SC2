		ENDIF
		
		PRIVATE nRecNo
		*1b
		*nMrk_Inv_Total	**************************************************************
		IF USED('tmpInvoice')
		
			SELECT tmpInvoice 
			nRecNo = RECNO('tmpInvoice')
			
			*SUM Amount FOR Reconciled = 1 AND GL_Account <> 69000 TO nMrk_Inv_Total
			SUM Amount FOR Marked AND NOT Reconciled TO nMrk_Inv_Total
		
			IF nRecNo > 0 AND nRecNo < RECCOUNT()
				GOTO nRecNo
			ELSE
				GO TOP
			ENDIF
		
		ENDIF
		
		*2b
		*nMrk_Inv_Frt **************************************************************
		IF USED('tmpInvoiceFrt')
			SELECT tmpInvoiceFrt
			nRecNo = RECNO('tmpInvoiceFrt')
				
			*SUM Amount FOR Reconciled = 1 AND GL_Account = 69000 TO nMrk_Inv_Frt 
			SUM Amount FOR Marked AND NOT Reconciled TO nMrk_Inv_Frt 
			
			IF nRecNo > 0 AND nRecNo < RECCOUNT()
				GOTO nRecNo
			ELSE
				GO TOP
			ENDIF
			
		ENDIF
		
		*3b
		*nMrk_Invoices **************************************************************
