				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSN_Inv' )
		ENDIF
		
		IF USED('tmpSN_Inv')
			IF RECCOUNT('tmpSN_Inv') > 0
				*StockLst_Total 
				*Removed_Total 
				nRec_SO = PrepareSQLnum(tmpSN_Inv.Invoice_Total,'Amount',-5)
				*StkPaid_Total 
			ENDIF
			
			USE IN 'tmpSN_Inv'
		ENDIF
		
		*5
		*nRec_SD **************************************************************
		IF USED('tmpSN_Inv')
			USE IN tmpSN_Inv
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ISNULL(SUM(Quoted_Total),0) AS Quoted_Total "
