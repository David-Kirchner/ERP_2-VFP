	PROCEDURE saveinvoiceamount
		*ThisFormSet.SaveInvoiceAmount()
		
		PRIVATE lUpdateSD
		lUpdateSD = .F.
		*IF ThisFormSet.frmInvoice.cmdSave.Caption = "Update"
		IF ThisFormSet.frmReconcileTotal.cmdSaveRec.Caption = 'Update'
			lUpdateSD = .T.
		ENDIF
		
		PRIVATE nID_Sales_Detail,cSOitem,nInvoice
		nID_Sales_Detail= ThisFormset.frmSOitemDetail.txtID_Sales_Detail.Value 		
		cSOitem		= ThisFormset.frmSOitemDetail.txtSOitem.Value 	
		nInvoice	= PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		
		
		PRIVATE nSale_QTY, nSale_PC, cDescript, nSale_LBS
		nSale_QTY	= ThisFormset.frmSOitemDetail.txtSale_QTY.Value 	
		nSale_PC	= ThisFormset.frmSOitemDetail.txtSale_PC.Value 	
		cDescript	= PrepareSQLtxt(ThisFormset.frmSOitemDetail.txtDescript.Value,'Descript',254)
		nSale_LBS	= ThisFormset.frmSOitemDetail.txtWeight.Value 	
		
		PRIVATE nQuoted_QTY, nQuoted_P, nQuoted_Total, nQuoted_PU, nQuoted_PC, nQuoted_Dim1, nQuoted_LBS
		nQuoted_QTY		= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtQuoted_QTY.Value,'Quoted_QTY',-5)
		nQuoted_P		= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtQuoted_P.Value,'Quoted_P',-5)
		nQuoted_Total	= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtQuoted_Total.Value,'Quoted_Total',-5)
		nQuoted_PU		= Get_PUfromText(ThisFormset.frmSOitemDetail.txtQuoted_PUtxt.Value)
		nQuoted_PC		= ThisFormset.frmSOitemDetail.txtQuoted_PC.Value
		nQuoted_Dim1	= ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value
		nQuoted_LBS		= ThisFormset.frmSOitemDetail.txtQuoted_LBS.Value
		PRIVATE nStockLst_QTY, nStockLst_P, nStkPaid_P, nStockLst_Total, nStkPaid_total, nStockLst_PU
		PRIVATE nStockLst_PC, nStockLst_Dim1, nStockLst_LBS
		nStockLst_QTY	= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtStockLst_QTY.Value,'StockLst_QTY',-5)
		nStockLst_P		= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtStockLst_P.Value,'StockLst_P',-5)
		*nStkPaid_P		= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtStkPaid_P.Value,'StkPaid_P',-5)
		nStockLst_P		= getStkPaid_SOitem( cSOitem, ThisFormSet.nConnHandle )
		
		nStockLst_Total	= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtStockLst_Total.Value,'StockLst_Total',-5)
		
		*nStkPaid_Total	= PrepareSQLnum(ThisFormset.frmReconcileTotal.txtStkPaid_Total.Value,'StkPaid_Total',-5)
		nStkPaid_Total 	= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtStkPaid_Total.Value,'StkPaid_Total',-5)
		
		nStockLst_PU	= Get_PUfromText(ThisFormset.frmSOitemDetail.txtStockLst_PUtxt.Value)
		nStockLst_PC	= ThisFormset.frmSOitemDetail.txtStockLst_PC.Value
		nStockLst_Dim1	= ThisFormset.frmSOitemDetail.txtStockLst_Dim1.Value
		nStockLst_LBS	= ThisFormset.frmSOitemDetail.txtStockLst_LBS.Value
		PRIVATE cAlloy, cForm, cCC, cCL
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmSOitemDetail.txtAlloy.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmSOitemDetail.txtForm.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmSOitemDetail.txtCC.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmSOitemDetail.txtCL.Value,'CL',1)
		PRIVATE dtStockEdit, dShipped, dInvoiceDate, nInvoice_QTY, nInvoice_P, nInvoice_Total
		dtStockEdit	= CTOT('') &&PrepareSQLdate(ThisFormset.frmSOitemDetail.txtStockEdit.Value,'StockEdit')
		dShipped	= CTOD('') &&PrepareSQLdate(ThisFormset.frmSOitemDetail.txtPS_Date.Value,'ShipDate')
		dInvoiceDate= CTOD('')  &&PrepareSQLdate(ThisFormset.frmSOitemDetail.txtInvoiceDate.Value,'InvoiceDate')
		nInvoice_QTY= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtInvoice_QTY.Value,'Invoice_QTY',-5)
		nInvoice_P	= PrepareSQLnum(ThisFormset.frmSOitemDetail.txtInvoice_P.Value,'Invoice_P',-5)
		*nInvoice_Total=PrepareSQLnum(ThisFormset.frmSOitemDetail.txtInvoice_Total.Value,'Invoice_Total',-5)
