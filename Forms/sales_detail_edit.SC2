			ENDIF
			
			USE IN 'tmpSN_Inv'
		ENDIF
		
		*4
		*nRec_SO All Sales STK **************************************************************
		IF USED('tmpSN_Inv')
			USE IN tmpSN_Inv
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ISNULL(SUM(StockLst_Total),0) AS StockLst_Total "
		cSQL = cSQL + ",ISNULL(SUM(Removed_Total),0) AS Removed_Total "
		cSQL = cSQL + ",ISNULL(SUM(Invoice_Total),0) AS Invoice_Total "
		cSQL = cSQL + ",ISNULL(SUM(StkPaid_Total),0) AS StkPaid_Total "
		cSQL = cSQL + " FROM dbo.Sales_Stock  WITH(NOLOCK)"
		cSQL = cSQL + " WHERE SalesNum IN ("
		cSQL = cSQL + " SELECT DISTINCT SalesNum FROM dbo.Sales_Invoice WITH(NOLOCK) WHERE Invoice = "+STR(nInvoice)+""
		cSQL = cSQL + " AND ISNULL(Reconciled,0) = 1 )"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSN_Inv')
		
