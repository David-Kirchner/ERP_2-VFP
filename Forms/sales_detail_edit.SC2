	PROCEDURE frmUnRecSOitems.cmdQuit.Click
		ThisForm.Visible =.f.
		ThisFormSet.frmSalesOrder.txtSalesOrder.SetFocus
		
	ENDPROC

	PROCEDURE frmUnRecSOitems.cmdSelectSO.Click
		PRIVATE cSOitem, nSalesNum, cDecimals
		
		cSOitem = ThisForm.lstSOitemsUNR.Value
		nSalesNum = LEFT(cSOitem,AT("-",cSOitem)-1)
		
		cDecimals = SET("Decimals")
		SET DECIMALS TO 0
		nSalesNum = VAL( nSalesNum )
		SET DECIMALS TO (cDecimals)
		
		ThisformSet.frmSalesOrder.txtSalesOrder.Value = nSalesNum
		ThisFormSet.frmSalesOrder.cmdFindSO.Click
		ThisFormSet.frmSalesOrder.lstSOitems.Value = cSOitem
		
		ThisFormSet.SOitem = cSOitem
		
		
		PRIVATE lPassed
		lPassed = .T.
		
		IF lPassed
			lPassed = ThisFormSet.Init_Sales_Stock()
			IF lPassed
				lPassed = ThisFormSet.Init_PackingSlip()
				
				IF lPassed
					lPassed = ThisFormSet.Init_Invoice()
					IF lPassed
						lPassed = ThisFormSet.Init_Invoice_Frt()
						IF lPassed
							lPassed = ThisFormSet.Init_Sales_PS()
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT lPassed
			ThisForm.Visible = .F.
		ELSE
			ThisForm.Visible = .T.
			ThisFormSet.frmQuote.Visible = .F.
			ThisFormSet.frmPackingSlip.Visible = .F.
			ThisFormSet.FrmSales_stock.Visible = .F.
			ThisFormSet.frmInvoice.Visible = .F.
			ThisFormSet.frmInvoiceFrt.Visible = .F.
		*	ThisFormSet.frmSOitemDetail.Visible = .F.
		*	ThisFormSet.frmReconcileTotal.Visible = .F.
			ThisFormSet.frmInvoiceBrow.Visible = .F.
			
			WAIT WINDOW 'Did NOT pass Initiation' NOWAIT
		ENDIF
	ENDPROC

ENDDEFINE
