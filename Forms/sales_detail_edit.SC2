		cSQL = cSQL + " SELECT DISTINCT Invoice FROM dbo.Sales_Invoice WHERE SalesNum IN ("
		cSQL = cSQL + " SELECT DISTINCT SalesNum FROM dbo.Sales_Invoice WHERE Invoice = "+STR(nInvoice)+""
		cSQL = cSQL + " AND ISNULL(Reconciled,0) = 0"
		cSQL = cSQL + " ) AND ISNULL(Reconciled,0) = 0"
		cSQL = cSQL + " ) AND ISNULL(Reconciled,0) = 0"
		
		
