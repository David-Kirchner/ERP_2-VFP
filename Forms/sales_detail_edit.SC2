	PROCEDURE calcfreightinv
		*ThisFormSet.CalcFreightInv()
		
		PRIVATE nTotalFreightInv
		nTotalFreightInv = 0
		
		PRIVATE nInvoice, lReconciled, lMarked
		nInvoice 	= PrepareSQLnum(ThisFormSet.frmInvoiceFrt.txtInvoice.Value,'Invoice',-3)
		lReconciled = PrepareSQLlogic(ThisFormSet.frmInvoiceFrt.chkReconciled.Value,'Reconciled',.F.)
		lMarked		= PrepareSQLlogic(ThisFormSet.frmInvoiceFrt.chkMarked.Value,'Marked',.F.)
		
		IF USED('tmpInvoiceFrt')
			SELECT tmpInvoiceFrt
			
			PRIVATE nRecNo
			nRecNo = RECNO('tmpInvoiceFrt')
			
			SUM Amount FOR GL_Account = 69000 AND Invoice = nInvoice AND Marked = .T. AND NOT DELETED() TO nTotalFreightInv
			
			IF nRecNo > 0 AND nRecNo <= RECCOUNT('tmpInvoiceFrt')
				GOTO RECORD nRecNo
			ENDIF
			
			nTotalFreightInv = -PrepareSQLnum(nTotalFreightInv,'TotalFreightInv',-5)
			
		ENDIF
		
		RETURN nTotalFreightInv
	ENDPROC

	PROCEDURE calcfreightsoitem
		*ThisFormSet.CalcFreightSOitem()
		
		PRIVATE nTotalFreghtSOitem
		nTotalFreghtSOitem = 0
		
		PRIVATE cSOitem, nInvoice, lReconciled, lMarked
		cSOitem		= PrepareSQLtxt(  ThisFormSet.frmInvoiceFrt.txtSOItem.Value,'SOitem',-3)
		nInvoice	= PrepareSQLnum(  ThisFormSet.frmInvoiceFrt.txtInvoice.Value,'Invoice',-3)
		lReconciled = PrepareSQLlogic(ThisFormSet.frmInvoiceFrt.chkReconciled.Value,'Reconciled',.F.)
		lMarked		= PrepareSQLlogic(ThisFormSet.frmInvoiceFrt.chkMarked.Value,'Marked',.F.)
		
		IF USED('tmpInvoiceFrt')
			SELECT tmpInvoiceFrt
			
			PRIVATE nRecNo
			nRecNo = RECNO('tmpInvoiceFrt')
			
			SUM Amount FOR GL_Account = 69000 AND SOitem = cSOitem AND Marked =.T. AND NOT DELETED() TO nTotalFreghtSOitem
			
			IF nRecNo > 0 AND nRecNo <= RECCOUNT('tmpInvoiceFrt')
				GOTO RECORD nRecNo
			ENDIF
			
			nTotalFreghtSOitem = -PrepareSQLnum(nTotalFreghtSOitem,'TotalFreghtSOitem',-5)
			
		ENDIF
		
		RETURN nTotalFreghtSOitem
	ENDPROC

	PROCEDURE clear_stocklst_process
		*ThisFormset.Clear_StockLst_Process()
		
		IF cSOitem = Proper_SO_item('')
			RETURN .F.
		ENDIF
		
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE nInvoice
		nInvoice	= PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		
		*Create a Loop where SOitems are obviously complete (Sales Total matches Invoice Total)
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tmpCompleteSOitem')
			USE IN tmpCompleteSOitem
		ENDIF
		SELECT 0
		
		cSQL = "SELECT SI.SOitem "
		cSQL = cSQL +",SUM(SI.Amount) AS Amount "
		cSQL = cSQL +",SUM(SD.Invoice_Total) AS Invoice_Total "
		cSQL = cSQL +",SUM(SD.Quoted_Total) AS Quoted_Total "
		*cSQL = cSQL +",SI.Invoice, SD.Invoice "
		cSQL = cSQL +" FROM dbo.Sales_Invoice SI "
		cSQL = cSQL +" INNER JOIN dbo.Sales_Detail SD ON SD.SOitem = SI.SOitem "
		cSQL = cSQL +" WHERE SI.Invoice = "+ALLTRIM(STR( nInvoice ))
		cSQL = cSQL +" AND ISNULL(SI.Reconciled,0) = 1 "
		cSQL = cSQL +" AND SI.Invoice = SD.Invoice "
		cSQL = cSQL +" GROUP BY SI.SOitem "
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCompleteSOitem' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCompleteSOitem' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompleteSOitem")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCompleteSOitem")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCompleteSOitem' )
		ENDIF
			
		PRIVATE namount, nInvoice_Total, nQuoted_Total
		IF USED('tmpCompleteSOitem')
		
			SELECT tmpCompleteSOitem
			SCAN
				nAmount			= PrepareSQLnum(tmpCompleteSOitem.Amount,'Amount',-5)
				nInvoice_Total	= PrepareSQLnum(tmpCompleteSOitem.Invoice_Total,'Invoice_Total',-5)
				nQuoted_Total	= PrepareSQLnum(tmpCompleteSOitem.Quoted_Total,'Quoted_Total',-5)
				
				*Complete this code!
		*		IF a match
		*			lOK = Cancel_Detail_Process_SOitem(tmpCompleteSOitem.SOitem,ThisFormSet.nConnHandle)
		*		ENDIF
		
				IF NOT lOK
					EXIT
				ENDIF
			ENDSCAN
		
			USE IN tmpCompleteSOitem
		ENDIF
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE copyquote2detail
		*ThisFormSet.CopyQuote2Detail()
		
		PRIVATE cAlloy, cForm, cCC, cCL
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmQuote.Alloy1.Value,'Alloy',12)
		cForm		= PrepareSQLtxt(ThisFormSet.frmQuote.Form1.Value,'Form',2)
		cCC			= PrepareSQLtxt(ThisFormSet.frmQuote.CC1.Value,'CC',1)
		cCL			= PrepareSQLtxt(ThisFormSet.frmQuote.CC1.Value,'CL',1)
		PRIVATE nQuoted_QTY, nQuoted_PU, nQuoted_P,nQuoted_Total, nQuoted_PC, nQuoted_Dim1, nQuoted_LBS
		nQuoted_QTY		= Get_QTYinSales(ThisFormSet.SOItem, ThisFormSet.nConnHandle)
		nQuoted_PU		= GetPUfromForm(cForm,ThisFormSet.nConnHandle)
		nQuoted_Total	= Get_ItemSaleinSales(ThisFormSet.SOItem, ThisFormSet.nConnHandle)
		nQuoted_PC		= ThisFormSet.frmQuote.Pieces1.Value
		nQuoted_Dim1	= ThisFormSet.frmQuote.Thck1.Value
		nQuoted_LBS		= Get_LBSinSales(ThisFormSet.SOItem, ThisFormSet.nConnHandle)
		
		nQuoted_P		= 0
		IF nQuoted_Total > 0 AND nQuoted_QTY > 0
			nQuoted_P = nQuoted_Total / nQuoted_QTY 
		ENDIF
		
		ThisFormset.frmSOitemDetail.txtAlloy.Value	= cAlloy
		ThisFormset.frmSOitemDetail.txtForm.Value	= cForm
		ThisFormset.frmSOitemDetail.txtCC.Value		= cCC
		ThisFormset.frmSOitemDetail.txtCL.Value		= cCL
		
		ThisFormset.frmSOitemDetail.txtQuoted_QTY.Value 	= nQuoted_QTY
		ThisFormset.frmSOitemDetail.txtQuoted_PUtxt.Value 		= Get_PUtext( nQuoted_PU ) &&Get_cPUfrom_nPU
		ThisFormset.frmSOitemDetail.txtQuoted_P.Value 		= nQuoted_P
		ThisFormset.frmSOitemDetail.txtQuoted_Total.Value	= nQuoted_Total
		ThisFormset.frmSOitemDetail.txtQuoted_PC.Value 		= nQuoted_PC
		ThisFormset.frmSOitemDetail.txtQuoted_Dim1.Value	= nQuoted_Dim1
		ThisFormset.frmSOitemDetail.txtQuoted_LBS.Value 	= nQuoted_LBS
		
	ENDPROC

