							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC,'tmpSales_DetailID' )
				ENDIF
				IF USED('tmpSales_DetailID')
					IF RECCOUNT('tmpSales_DetailID') > 0
						nID_Sales_Detail = tmpSales_DetailID.ID
						ThisFormset.frmSOitemDetail.txtID_Sales_Detail.Value 	= nID_Sales_Detail
						ThisFormSet.Init_lstSales_Detail_ID()
					ENDIF
					USE IN tmpSales_DetailID	
				ENDIF
			ENDIF
		ENDIF
		
		*****************************
		* save nID_Sales_Detail with other Tables
		
		PRIVATE lPassed
		lPassed = .T.
		
		IF VARTYPE(nID_Sales_Detail) != "N"
			MESSAGEBOX("No Sales_Detail_ID ",0,"Error")
			TrackError("No Sales_Detail_ID ","No Save Reconcile!","Sales_Detail_Edit.SaveInvoiceAmount",LINENO(1))
			lPassed = .F.
		ELSE
			IF nID_Sales_Detail < 1
				MESSAGEBOX("No Sales_Detail_ID ",0,"Error")
				TrackError("No Sales_Detail_ID ","No Save Reconcile!","Sales_Detail_Edit.saveInvoiceAmount",LINENO(1))
				lPassed = .F.
			ENDIF
		ENDIF
		
		
		IF lPassed 
			lPassed = ThisFormSet.Save_Invoice_Reconcile(lReconciled,nID_Sales_Detail)
		ENDIF
		IF lPassed 
			lPassed = ThisFormSet.Save_Invoice_Frt_Reconcile(lReconciled,nID_Sales_Detail)
		ENDIF
		IF lPassed 
			lPassed = ThisFormSet.Save_PackingSlip_Reconcile(lReconciled,nID_Sales_Detail)
		ENDIF
		IF lPassed 
			lPassed = ThisFormSet.Save_Sales_Stock_Reconcile(lReconciled,nID_Sales_Detail)
		ENDIF
		
		*!*	IF lPassed 
		*!*		lPassed = ThisFormSet.Update_Current_Stock_Price(lReconciled,nID_Sales_Detail)
		*!*	ENDIF
		
		IF lPassed 
			IF lReconciled
				 ThisFormSet.Clear_StockLst_Process()
			ENDIF
		ENDIF
		
		*******************************
		*check for UnRec records
		
		PRIVATE nFoundUnRec
		nFoundUnRec = 0
		
		*Get UnRec
		IF USED('tmpUnRec')
			USE IN tmpUnRec
		ENDIF
		
		SELECT 0
		cSQL = "SELECT COUNT(*) AS Cntd "
		cSQL = cSQL +" FROM dbo.Sales_Invoice "
		*cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL +" WHERE Invoice ="+STR(nInvoice)
		cSQL = cSQL +" AND ISNULL(Reconciled,0)=0 "
						
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnRec' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpUnRec' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnRec")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpUnRec")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC,'tmpUnRec' )
		ENDIF
		IF USED('tmpUnRec')
			IF RECCOUNT('tmpUnRec') > 0
				nFoundUnRec = tmpUnRec.Cntd 
			ENDIF
			USE IN tmpUnRec	
		ENDIF
			
		********************************
		
		IF lPassed 
			IF nFoundUnRec = 0
				*lReconciled
			
				*ThisFormSet.frmSalesOrder.chkReconciled.Value = IIF(lReconciled,1,0)
				*ThisFormSet.frmSOitemDetail.Visible = .F.
				*ThisFormSet.frmReconcileTotal.Visible = .F.
				ThisformSet.frmTotals.Visible = .F.
				ThisFormSet.frmInvoice.Visible = .F.
				ThisFormSet.frmInvoiceFrt.Visible = .F.
				ThisFormSet.frmSales_stock.Visible = .F.
				ThisFormSet.frmPackingSlip.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
			ENDIF		
			MESSAGEBOX("SOitem-Invoice has been reconciled.",0+64,"Saved.")
			
			SELECT tmpInvoice
			UPDATE tmpInvoice SET Marked = .F., Reconciled = .T. WHERE Marked = .T.
			ThisFormSet.Show_Invoice()
			
			SELECT tmpInvoiceFrt
			UPDATE tmpInvoiceFrt SET Marked = .F., Reconciled = .T. WHERE Marked = .T.
			ThisFormSet.Show_Invoice_Frt()
			
			SELECT tmpSales_Stock
			UPDATE tmpSales_Stock SET Marked = .F., Reconciled = .T. WHERE Marked = .T.
			ThisFormSet.Show_Sales_Stock()
			
			SELECT tmpPackingSlip
			UPDATE tmpPackingSlip SET Marked = .F., Reconciled = .T. WHERE Marked = .T.
			
			ThisFormSet.Show_PackingSlip()
			ThisFormSet.Show_Sales_PS()
		ENDIF
		
		RETURN lPassed
		
	ENDPROC

	PROCEDURE save_invoice_frt_reconcile
		PARAMETERS pReconciled, nSales_Detail_ID
		*ThisFormSet.Save_Invoice_Frt_Reconcile(pReconciled, nSales_Detail_ID)
		
		IF NOT USED('tmpInvoiceFrt')
			*Only used when Freght is paid oustside of SO.
		*	MESSAGEBOX("No 'tmpInvoiceFrt' table",0,"Error")
		*	TrackError("No 'tmpInvoiceFrt' table","No table","SO_Invoice:Sales_Detail_EditSave_Invoice_Reconcile",LINENO(1))
			RETURN .T.
		ENDIF
		IF RECCOUNT('tmpInvoiceFrt') < 1
		*	MESSAGEBOX("No 'tmpInvoiceFrt' table",0,"Error")
		*	TrackError("No 'tmpInvoiceFrt' table","No table","SO_Invoice:Sales_Detail_EditSave_Invoice_Reconcile",LINENO(1))
			RETURN .T.
		ENDIF
		
		PRIVATE lChangeReconcile
		lChangeReconcile = .F.
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpInvoiceFrt
		
		PRIVATE nRecNo
		nRecNo = RECNO()
		PRIVATE lPassed
		lPassed = .T.
		
		PRIVATE nInvoice
		nInvoice	= PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3)
		
		PRIVATE nQuantity, nAmount
		PRIVATE nID, lReconciled 
		PRIVATE cSOitem00
		PRIVATE cSQL, nSQLEXEC 
		
		SCAN FOR NOT DELETED()
			*nID = tmpInvoiceFrt.ID
			IF NOT PrepareSQLlogic(tmpInvoiceFrt.Marked ,'Marked',.F.) 
				lChangeReconcile = .F.
				SKIP
			ELSE
				lChangeReconcile = .T.
			ENDIF
			
			nID = tmpInvoiceFrt.ID
			IF lChangeReconcile 
				lReconciled = pReconciled
			ELSE
				lReconciled = PrepareSQLlogic(tmpInvoiceFrt.Reconciled,'Reconciled',.F.)
			ENDIF
			
			*cSOitem00 = PrepareSQLtxt(tmpInvoiceFrt.SOitem,'SOitem',10)
		
			cSQL = "UPDATE dbo.Sales_Invoice "
			cSQL = cSQL + " SET Reconciled=" + IIF(lReconciled,'1','0')
			cSQL = cSQL + " ,Sales_Detail_ID="+ALLTRIM(STR(nSales_Detail_ID))
			cSQL = cSQL + " WHERE ID = "+ALLTRIM(STR( nID ))
			*cSQL = cSQL + ",Amount="+ALLTRIM(STR(n))
			*cSQL = cSQL + " WHERE Invoice = "+ALLTRIM(STR( nInvoice ))
			*cSQL = cSQL + " AND SOitem = dbo.f_ProperSOitem('"+cSOitem00+"')"
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC  )
				lPassed = .F.
			ENDIF
		
		ENDSCAN
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN lPassed 
	ENDPROC

	PROCEDURE save_invoice_reconcile
		PARAMETERS pReconciled, nSales_Detail_ID
		*ThisFormSet.Save_Invoice_Reconcile(pReconciled, nSales_Detail_ID)
		
		IF NOT USED('tmpInvoice')
			MESSAGEBOX("No 'tmpInvoice' table",0,"Error")
			TrackError("No 'tmpInvoice' table","No table","SO_Invoice:Sales_Detail_Edit.Save_Invoice_Reconcile",LINENO(1))
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpInvoice') < 1
			MESSAGEBOX("No 'tmpInvoice' table",0,"Error")
			TrackError("No 'tmpInvoice' table","No table","SO_Invoice:Sales_Detail_Edit.Save_Invoice_Reconcile",LINENO(1))
			RETURN .F.
		ENDIF
		IF VARTYPE(pReconciled) != "L"
			TrackError("Bad Parameter","Bad Parameter","SO_Invoice:Sales_Detail_Edit.Save_Invoice_Reconcile",LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE lChangeReconcile
		lChangeReconcile = .F.
		
		PRIVATE cAlias
		cAlias = ALIAS()
		
		SELECT tmpInvoice
		
		PRIVATE nRecNo
		nRecNo = RECNO()
		PRIVATE lPassed
		lPassed = .T.
		
		PRIVATE nInvoice
		nInvoice = PrepareSQLnum(ThisFormSet.frmInvoice.txtInvoice.Value,'Invoice',-3) 
		
		PRIVATE nQuantity, nPaid
		PRIVATE nID, lReconciled 
		PRIVATE cSQL, nSQLEXEC 
		
		SCAN FOR NOT DELETED()
			IF NOT PrepareSQLlogic(tmpInvoice.Marked,'Marked',.T.) 
				lChangeReconcile = .F.
				SKIP
			ELSE
				lChangeReconcile = .T.
			ENDIF
			
			nID = tmpInvoice.ID
			IF lChangeReconcile 
				lReconciled = pReconciled
			ELSE
				lReconciled = PrepareSQLlogic(tmpInvoice.Reconciled,'Reconciled',.F.)
			ENDIF
			
			nQuantity 	= PrepareSQLnum(tmpInvoice.Quantity,'Quantity',-3)
			nPaid		= PrepareSQLnum(tmpInvoice.Paid,'Paid',-5)
			
			cSQL = "UPDATE dbo.Sales_Invoice "
			cSQL = cSQL + " SET Reconciled=" + IIF(lReconciled,'1','0')
			cSQL = cSQL + ",Invoice ="+ALLTRIM(STR(nInvoice))
			cSQL = cSQL + ",Sales_Detail_ID="+ALLTRIM(STR(nSales_Detail_ID))
			cSQL = cSQL + ",Quantity ="+ALLTRIM(STR(nQuantity))
			cSQL = cSQL + ",Paid ="+ALLTRIM(STR(nPaid,18,4))
			cSQL = cSQL + " WHERE ID = "+ALLTRIM(STR( nID ))
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC  )
				lPassed = .F.
			ENDIF
		
		ENDSCAN
		IF nRecNo > 0 AND nRecNo < RECCOUNT()
			GOTO nRecNo
		ELSE
			GO TOP
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN lPassed 
	ENDPROC

