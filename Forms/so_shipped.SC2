	PROCEDURE Init
		PARAMETERS pSO, pConnHandle
		
		*DO FORM Forms\SO_Shipped WITH nSalesNum,Conn
		pSO = 100442
		
		PRIVATE nSO, cSOitem
		IF VARTYPE(pSO) = "N"
			nSO = pSO
			cSOitem = ''
		ELSE
			IF VARTYPE(pSO) = "C"
				cSOitem = PrepareSQLtxt(pSO,'SOitem',10)
				nSO = VAL(pSO)
			ENDIF
		ENDIF
		
		IF nSO = 0
			RETURN ''
		ENDIF
		
		IF TYPE("pConnHandle") = "N"
			IF pConnHandle > 0
				ThisForm.nConnHandle = pConnHandle
			ELSE
				ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
				IF ThisForm.nConnHandle > 0
					ThisForm.CloseConn = .T.
				ELSE
					MESSAGEBOX("Could not connect to SQL")
					RETURN ''
				ENDIF
			ENDIF		
		ELSE
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
			IF ThisForm.nConnHandle > 0
				ThisForm.CloseConn = .T.
			ELSE
				MESSAGEBOX("Could not connect to SQL")
				RETURN ''
			ENDIF
		ENDIF
		
		********************************
		
		IF USED('tmpSales_Ship')
			USE IN tmpSales_Ship
		ENDIF
		
		SELECT 0
		cSQL = "SELECT DISTINCT SOitem"
		cSQL = cSQL + ",(SELECT TOP 1 S2.ID FROM dbo.Ship S2 WHERE S2.[When] = Ship.[When] AND S2.Soitem = Ship.SOitem ) AS ID "
		cSQL = cSQL + ",[DueDate],[ShipDate],[ShipVia] "
		cSQL = cSQL + ",[Cncld],[QShipped],[Complete],[RMA_No] "
		cSQL = cSQL + " FROM dbo.Ship "
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(nSO))
		cSQL = cSQL + " ORDER BY [SOitem], [ShipDate] DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales_Ship")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Ship')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Ship")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Ship")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Ship')
		ELSE
			ThisForm.grdShip.RecordSource = "tmpSales_Ship"
		ENDIF
		
		IF NOT USED('tmpSales_Ship')
			MESSAGEBOX( "Could not loading the Ship table.",16,"Program Error")
			RETURN ""
		ENDIF
		
		****************************
		*ON HOLD
		
		IF USED('tmpSales_Packing')
			USE IN tmpSales_Packing
		ENDIF
		
		SELECT 0
		cSQL = "SELECT P.SOitem,P.PackingSli,P.PCs,P.Descript,P.[Weight] "
		cSQL = cSQL + " ,P.Cancld,P.SOitem_Cmplt,PN.ps_date,PN.shippedvia,PN.tracking "
		cSQL = cSQL + " FROM dbo.PackingSlip_No PN "
		cSQL = cSQL + " INNER JOIN dbo.PackingSlip P ON PN.PackingSli = P.PackingSli "
		cSQL = cSQL + " INNER JOIN dbo.Sales S ON P.SOitem = S.SOitem "
		cSQL = cSQL + " WHERE S.SalesNum = "+ALLTRIM(STR(nSO))
		cSQL = cSQL + " ORDER BY P.SOitem, P.[WhenAdd] "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales_Packing")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Packing')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Packing")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Packing")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Packing')
		ELSE	
			ThisForm.grdPacking.RecordSource = 'tmpSales_Packing'
		ENDIF
		
		****************************
		*SELECT tmpSales_Packing
		
		IF USED('tmpSales')
			USE IN tmpSales
		ENDIF
		
		SELECT 0
		cSQL = "SELECT SOitem, ShipDue, Shipped, cncld,cmplt "
		cSQL = cSQL + ",ItemCost, ItemSale, POCost "
		cSQL = cSQL + ",Urgent, ShipOn, Quoted_QTY, Hold"
		cSQL = cSQL + " FROM dbo.Sales "
		cSQL = cSQL + " WHERE SalesNum = "+ALLTRIM(STR(nSO))
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpSales")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales')
		ENDIF
		
		IF NOT USED('tmpSales')
			MESSAGEBOX( "Could not loading the Ship table.",16,"Program Error")
			RETURN ""
		ENDIF
		
		ThisForm.grdSales.RecordSource = "tmpSales"
		*ThisForm.Grid1.Column1.ControlSource = tmpSales_Status.ID
		*ThisForm.Grid1.Column1.Text1.ControlSource = tmpSales_Status.ID
		
		*ThisForm.grdSales.AfterRowColChange
		ThisForm.Refresh_SOitem()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE refresh_packingslip
		*ThisForm.Refresh_PackingSlip
		
		*,P.
		
		IF USED('tmpSales_Packing')
			*ThisForm.grdPacking.RecordSource = "tmpSales_Packing"
			
			ThisForm.txtSOitemP.Value	= ShowSQLtxt(tmpSales_Packing.SOitem,'SOitem',10)
			ThisForm.chkCancldP.Value	= PrepareSQLchk(tmpSales_Packing.Cancld,'Cancld')
			ThisForm.chkSOitem_CmpltP.Value	= PrepareSQLchk(tmpSales_Packing.SOitem_Cmplt,'SOitem_Cmplt')	
			
			ThisForm.txtPS_DateP.Value 	= ShowSQLdate(tmpSales_Packing.ps_date,'ps_date')
			ThisForm.txtTrackingP.Value	= ShowSQLtxt(tmpSales_Packing.tracking,'tracking',50)
			
			ThisForm.txtShipViaP.Value	= ShowSQLtxt(tmpSales_Packing.shippedvia,'shippedvia',20)
			ThisForm.txtPCSP.Value		= PrepareSQLnum(tmpSales_Packing.PCs,'PCs',-3)
			
			ThisForm.txtWeightP.Value	= PrepareSQLnum(tmpSales_Packing.Weight,'Weight',-3)
			ThisForm.txtPackingSliP.Value	= PrepareSQLnum(tmpSales_Packing.PackingSli,'PackingSli',-3)
			
			ThisForm.txtDescriptP.Value	= ShowSQLtxt(tmpSales_Packing.Descript,'Descript',80)
				
		ENDIF
		
	ENDPROC

	PROCEDURE refresh_ship
		*ThisForm.Refresh_Ship()
		IF USED('tmpSales_Ship')
			
			*ThisForm.grdShip.RecordSource = "tmpSales_Ship"
			ThisForm.txtSOitemS.Value	= ShowSQLtxt(tmpSales_Ship.SOitem,'SOitem',10)
			ThisForm.chkCncldS.Value	= PrepareSQLchk(tmpSales_Ship.cncld,'cncld')
			ThisForm.chkCompleteS.Value	= PrepareSQLchk(tmpSales_Ship.Complete,'Complete')	
			
			ThisForm.txtDueDateS.Value 	= ShowSQLdate(tmpSales_Ship.DueDate,'DueDate')
			ThisForm.txtShipDateS.Value = ShowSQLdate(tmpSales_Ship.ShipDate,'ShipDate')
		
			ThisForm.txtShipViaS.Value	= PrepareSQLnum(tmpSales_Ship.ShipVia,'ShipVia',-3)
			ThisForm.txtRMA_NoS.Value	= PrepareSQLnum(tmpSales_Ship.RMA_No ,'RMA_No ',-3)
			ThisForm.txtQShippedS.Value	= PrepareSQLnum(tmpSales_Ship.QShipped,'QShipped',-3)
			ThisForm.txtIDS.Value		= PrepareSQLnum(tmpSales_Ship.ID,'ID',-3)
		
				
		ENDIF
		
		ThisForm.Refresh_PackingSlip()
	ENDPROC

	PROCEDURE refresh_soitem
		*ThisForm.Refresh_SOitem()
		
		SELECT tmpSales
		
		ThisForm.txtSOitem.Value	= ShowSQLtxt(tmpSales.SOitem,'SOitem',10)
		ThisForm.chkCncld.Value		= PrepareSQLchk(tmpSales.cncld,'cncld')
		ThisForm.chkCmplt.Value		= PrepareSQLchk(tmpSales.cmplt,'cmplt')
		ThisForm.chkShipOn.Value	= PrepareSQLchk(tmpSales.ShipOn,'ShipOn')
		ThisForm.chkHold.Value		= PrepareSQLchk(tmpSales.Hold,'Hold')
		
		ThisForm.txtShipDue.Value 	= ShowSQLdate(tmpSales.ShipDue,'ShipDue')
		ThisForm.txtShipped.Value 	= ShowSQLdate(tmpSales.Shipped,'Shipped')
		
		ThisForm.txtQuoted_QTY.Value = PrepareSQLnum(tmpSales.Quoted_QTY,'Quoted_QTY',-3)
		ThisForm.txtUrgent.Value 	= ShowSQLtxt(tmpSales.Urgent,'Urgent',1)
		
		ThisForm.txtItemCost.Value	= PrepareSQLnum(tmpSales.ItemCost,'ItemCost',-3)
		ThisForm.txtItemSale.Value	= PrepareSQLnum(tmpSales.ItemSale,'ItemSale',-3)
		ThisForm.txtPOCost.Value	= PrepareSQLnum(tmpSales.POCost,'POCost',-3)
		
		IF USED('tmpSales_Ship')
			ThisForm.Refresh_Ship()
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		IF USED('CustomerID')
			USE IN CustomerID
		ENDIF
		
		RETURN THISFORM.cReturnValue
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE grdPacking.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.Refresh_SOitem()
		
	ENDPROC

	PROCEDURE grdSales.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.Refresh_SOitem()
		
	ENDPROC

	PROCEDURE grdShip.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.Refresh_SOitem()
		
	ENDPROC

ENDDEFINE
