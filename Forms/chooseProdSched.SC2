	PROCEDURE Init
		PARAMETERS pOType_Num
		*DO FORM Forms\ChooseProdSched WITH cOType_Num TO m.nPdID
		
		PRIVATE cOType_Num
		cOType_Num = ''
		
		
		*cOType_Num = OType_Proper( cType, cOrderNum, ThisForm.nConnHandle )
		
		IF VARTYPE(pOType_Num) != "C"
			pOType_Num = ""
			pOType_Num = "SI 115068-01   " &&use for testing
		ENDIF
		
		PRIVATE cType
		cType = LEFT(pOType_Num,2)
		lIs_OType = Is_OTyp( cType, ThisForm.nConnHandle )
		
		IF lIs_OType
			ThisForm.cType = cType
			ThisForm.cOType_Num = pOType_Num
			ThisForm.cOrderNum = RIGHT(pOType_Num,13)
			
			IF NOT pOType_Num = OType_Proper( ThisForm.cType, ThisForm.cOrderNum, ThisForm.nConnHandle )
				TrackError("Problem Memo: parameter pOType_Num:'"+pOType_Num+"' did not match OType_Proper():'"+OType_Proper( ThisForm.cType, ThisForm.cOrderNum, ThisForm.nConnHandle )+"'","Proper OType issue", PROGRAM(), LINENO(1))
			ENDIF
			
			ThisForm.LoadProdSched()
			
		ELSE
			ThisForm.cType = ''
			ThisForm.cOType_Num = ''
			ThisForm.cOrderNum = ''
			
			MESSAGEBOX("Could not load 'tmpProdSchedID'",0,"SQL Error")
			RETURN TO MASTER
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLstringCONNECT()
		
		
	ENDPROC

	PROCEDURE loadprodsched
		*ThisForm.LoadProdSchedID()
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpProdSchedID")
			ThisForm.grdPdID.RecordSource = ''
			USE IN tmpProdSchedID
		ENDIF
		SELECT 0
		
		cSQL = "SELECT Pd.ID AS PdID FROM dbo.rtr_Schedule Pd WITH(NOLOCK) "
		cSQL=cSQL+" WHERE Pd.OType_Num = '"+ThisForm.cOType_Num+"'"
		cSQL=cSQL+" Order By Pd.OnBoard, Pd.[Position]"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProdSchedID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProdSchedID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProdSchedID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProdSchedID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpProdSchedID' )
		ENDIF
		
		IF USED('tmpProdSchedID')
			SELECT tmpProdSchedID
			ThisForm.grdPdID.RecordSource = 'tmpProdSchedID'
		*	GO TOP
		*	IF RECCOUNT() > 8
		*		SKIP 8
		*	ENDIF
			ThisForm.nPdID = tmpProdSchedID.PdID
			ThisForm.RefreshScreen
		ELSE
			MESSAGEBOX("Could not load 'tmpProdSchedID'",0,"SQL Error")
			RETURN TO MASTER
		ENDIF
	ENDPROC

	PROCEDURE load_productionid
		*ThisForm.Load_ProductionID()
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpProdSched")
			USE IN tmpProdSched
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.rtr_Schedule Pd WITH(NOLOCK) "
		cSQL=cSQL+" WHERE Pd.ID = "+STR(ThisForm.nPdID)
		
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProdSched')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProdSched')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProdSched")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProdSched")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpProdSched' )
		ENDIF
		
		IF USED('tmpProdSched')
			SELECT tmpProdSched
			ThisForm.txtID.Value = tmpProdSched.ID
			ThisForm.txtPosition.Value = tmpProdSched.Position
			ThisForm.txtOper_ID.Value = tmpProdSched.Oper_ID
			ThisForm.txtOType_Num.Value = tmpProdSched.OType_Num
			ThisForm.txtSched_Type.Value = tmpProdSched.Sched_Type
			ThisForm.txtdateOnBoard.Value = tmpProdSched.dateOnBoard
			ThisForm.txtdateInQue.Value = tmpProdSched.dateInQue
			
			DO CASE
			CASE tmpProdSched.Closed
				ThisForm.txtStatus.Value = "Closed"
			CASE tmpProdSched.InQue
				ThisForm.txtStatus.Value = "InQue"
			CASE tmpProdSched.OnBoard
				ThisForm.txtStatus.Value = "OnBoard"
			OTHERWISE
				ThisForm.txtStatus.Value = "Status"
			ENDCASE	
		ENDIF
		 
	ENDPROC

	PROCEDURE refreshscreen
		ThisForm.nPdID = tmpProdSchedID.PdID
		
		ThisForm.Load_ProductionID()
		
		*ThisForm.txtSalesNum.Refresh
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpProdSchedID')
			USE IN tmpProdSchedID
		ENDIF
		
		IF USED("tmpProdSched")
			USE IN tmpProdSched
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.nPdID
		
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.nPdID = 0
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdFind.Click
		IF ThisForm.txtSalesOrder.Value > 0
			SELECT ChooseSales_No
			*SEEK ThisForm.txtSalesOrder.Value ORDER SalesNum
			LOCATE FOR SalesNum = ThisForm.txtSalesOrder.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				ThisForm.txtSalesOrder.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
			ThisForm.grdSales_No.Refresh
		*	ThisForm.grdSales_No.SetFocus
			ThisForm.RefreshScreen()
			ThisForm.grdSales_No.clmSO.SetFocus()
		ELSE
			WAIT WINDOW "Enter Number to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSelect.Click
		ThisForm.nPdID = tmpProdSched.ID
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdSOrtr.Click
		PRIVATE cType,cOrderNum,nTop, nLeft, cCaption
		cType		= ThisForm.cType 
		*ThisForm.cOType_Num
		cOrderNum	= ThisForm.cOrderNum
		nTop		= 0
		nLeft 		= 0
		cCaption	= 'Edit '+ThisForm.cOType_Num
		
		DO FORM Forms\Router WITH "EDIT",cType,cOrderNum ,nTop, nLeft, cCaption
		
		*Refresh
		ThisForm.LoadProdSched()
	ENDPROC

	PROCEDURE grdPdID.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshScreen
	ENDPROC

	PROCEDURE txtSalesOrder.Valid
		IF !EMPTY(THIS.Value)
			*ThisForm.cmdFind.Click
			SELECT ChooseSales_No
			*SEEK THIS.Value ORDER SalesNum
			LOCATE FOR SalesNum = This.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				THIS.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
		*	ThisForm.grdSales_No.Refresh
		*	ThisForm.grdSales_No.SetFocus
			ThisForm.RefreshScreen()
		ENDIF
	ENDPROC

ENDDEFINE
