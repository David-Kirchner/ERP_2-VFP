		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*!*	*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*!*	*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		*!*	DO CASE
		*!*	CASE tmpPOitems.cancelled
		*!*		nColor = RGB( 255, 0, 0 ) &&RED	
		*!*	CASE tmpPOitems.delivered
		*!*		nColor = RGB( 128, 128, 128 )  &&Grey
		*!*	OTHERWISE 
		*!*		nColor = RGB( 255, 255, 255 ) &&WHITE
		*!*	ENDCASE
		
		RETURN nColorr
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE get_desc		&& Get Alloy, Descript, Heat
		PARAMETERS pWhat, pNumber
		*ThisForm.Get_Desc('POitem',cPOitem)
		
		IF USED('tmpDesc')
			USE IN tmpDesc
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		
		DO CASE
		CASE pWhat = "POitem"
			cSQL = "SELECT Alloy, dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Pounds,RandLen) AS Descript, '' AS Heat "
			cSQL = cSQL + ",Company,Services,ConvServ,Equipment"
			cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+pNumber+"')"
		CASE pWhat = "SOitem"
			cSQL = "SELECT Alloy, dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Weight,RandLen) AS Descript, '' AS Heat "
			*cSQL = cSQL + ",Services,ConvServ,Equipment"
			cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pNumber+"')"
		CASE pWhat = "WO"
			cSQL = "SELECT sAlloy AS Alloy, dbo.f_ItemDescription(sForm,sThck,sSz2,sSz3,sWeight,0) AS Descript, '' AS Heat "
			*cSQL = cSQL + ",Services,ConvServ,Equipment"
			cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO = "+STR(pNumber)+""
		CASE pWhat = "WOD"
			cSQL = "SELECT fAlloy AS Alloy, dbo.f_ItemDescription(fForm,fThck,fSz2,fSz3,fWeight,0) AS Descript, '' AS Heat "
			*cSQL = cSQL + ",Services,ConvServ,Equipment"
			cSQL = cSQL + " FROM dbo.WorkOrder_Detail WITH(NOLOCK) "
			cSQL = cSQL + " WHERE WO_Detail = "+STR(pNumber)+""
		ENDCASE
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDesc')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpDesc' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDesc")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDesc")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		*		nSQLEXEC = -1  to Test SQLEXEC
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpDesc' )
		ENDIF
		
		IF USED('tmpDesc')
			IF RECCOUNT('tmpDesc') > 0
				ThisForm.txtAlloy.Value = PrepareSQLtxt(tmpDesc.Alloy,'Alloy',12)
				ThisForm.txtDescription.Value = PrepareSQLtxt(tmpDesc.Descript,'Descript',140)
				ThisForm.txtHeat.Value = PrepareSQLtxt(tmpDesc.Heat,'Heat',50)
				
				PRIVATE cCaption
				cCaption = ''
				DO CASE
				CASE pWhat = "POitem"
					
					cCaption = PrepareSQLtxt(tmpDesc.Company,'Company',30)+" "
					
					IF PrepareSQLbit(tmpDesc.Services,"Services")=1
						cCaption = cCaption + "-Services "
					ENDIF
					IF PrepareSQLbit(tmpDesc.ConvServ,"ConvServ")=1
						cCaption = cCaption + "-ConvServ "
					ENDIF
					IF PrepareSQLbit(tmpDesc.Equipment,"Equipment")=1
						cCaption = cCaption + "-Equipment "
					ENDIF
					cCaption = cCaption +"| "+PrepareSQLtxt(tmpDesc.Descript,'Descript',140)
					
					ThisForm.lblPOitem_desc.Caption = cCaption
				CASE pWhat = "SOitem"
					cCaption = cCaption +"| "+PrepareSQLtxt(tmpDesc.Descript,'Descript',140)
					ThisForm.lblSOitem_desc.Caption = cCaption
				CASE pWhat = "WO"
					cCaption = cCaption +"| "+PrepareSQLtxt(tmpDesc.Descript,'Descript',140)
					ThisForm.lblWO_desc.Caption = cCaption
				CASE pWhat = "WOD"
					cCaption = cCaption +"| "+PrepareSQLtxt(tmpDesc.Descript,'Descript',140)
					ThisForm.lblWOD_desc.Caption = cCaption
				ENDCASE
			ENDIF
			USE IN tmpDesc
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pWO,pWOD,pPOitem,pSOitem,pFromWhere
		*DO FORM Forms\Connect_Orders WITH nWO,nWOD,cPOitem,cSOitem,"POitem"
		*DO FORM Forms\Connect_Orders WITH 0,0,'   509718-01','',"POitem"
		
		PRIVATE nWO,nWOD,cPOitem,cSOitem,cWhat
		nWO		= PrepareSQLnum(pWO,'WO',-3)
		nWOD	= PrepareSQLnum(pWOD,'WO_Detail',-3)
		cPOitem	= PrepareSQLtxt(pPOitem,'POitem',12)
		cSOitem	= PrepareSQLtxt(pSOitem,'SOitem',10)
		cFromWhere = PrepareSQLtxt(pFromWhere,'What',30) &&"POitem","SOitem","WO",WOD"
		
		*!*	*init for testing
		*!*	nWO		= PrepareSQLnum(0,'WO',-3)
		*!*	nWOD	= PrepareSQLnum(0,'WO_Detail',-3)
		*!*	cPOitem	= PrepareSQLtxt('   509718-01','POitem',12)
		*!*	cSOitem	= PrepareSQLtxt('','SOitem',10)
		*!*	pFromWhere= PrepareSQLtxt("POitem",'what',30)
		
		ThisForm.cFromWhere = cFromWhere
		
		*Have POitem
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			ThisForm.txtPOitem.Value = cPOitem
			ThisForm.cPOitem = cPOitem
			
			ThisForm.cmdConnPOitem_WO.Visible = .T.
			ThisForm.cmdNewWO_POitem.Visible = .T.
			ThisForm.cmdEditWO_POitem.Visible = .T.
			
			ThisForm.cmdConnPOitem_WOD.Visible = .T.
			ThisForm.cmdNewWOD_POitem.Visible = .T.
			ThisForm.cmdEditWOD_POitem.Visible = .T.
			
			ThisForm.cmdConnPOitem_SOitem.Visible = .T.
			
			IF ThisForm.cFromWhere = "POitem"
				ThisForm.Get_Desc('POitem',cPOitem)
			ENDIF
		ENDIF
		
		*Have SOitem
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			ThisForm.txtSOitem.Value = cSOitem
			ThisForm.cSOitem = cSOitem
		
			ThisForm.cmdConnSOitem_WO.Visible = .T.
			ThisForm.cmdNewWO_SOitem.Visible = .T.
			ThisForm.cmdEditWO_SOitem.Visible = .T.
			
			ThisForm.cmdConnSOitem_WOD.Visible = .T.
			ThisForm.cmdNewWOD_SOitem.Visible = .T.
			ThisForm.cmdEditWOD_SOitem.Visible = .T.
			
			ThisForm.cmdConnSOitem_POitem.Visible = .T.
			
			IF ThisForm.cFromWhere = "SOitem"
				ThisForm.Get_Desc('SOitem',cSOitem)
			ENDIF
		ENDIF
		
		*Have WO
		IF nWO > 0
			ThisForm.txtWO.Value = nWO
			ThisForm.nWO = nWO
			
			ThisForm.cmdConnWO_SOitem.Visible = .T.
			ThisForm.cmdNewSOitem_WO.Visible = .T.
			ThisForm.cmdEditSOitem_WO.Visible = .T.
			
			ThisForm.cmdConnWO_POitem.Visible = .T.
			ThisForm.cmdNewPOitem_WO.Visible = .T.
			ThisForm.cmdEditPOitem_WO.Visible = .T.
			
			IF ThisForm.cFromWhere == "WO"
				ThisForm.Get_Desc('WO',nWO)
			ENDIF
		ENDIF
		
		*Have WO_Detail
		IF nWOD > 0
			ThisForm.txtWO_Detail.Value = nWOD
			ThisForm.nWO_Detail = nWOD
			
			ThisForm.cmdConnWOD_SOitem.Visible = .T.
			ThisForm.cmdNewSOitem_WOD.Visible = .T.
			ThisForm.cmdEditSOitem_WOD.Visible = .T.
			
			ThisForm.cmdConnWOD_POitem.Visible = .T.
			ThisForm.cmdNewPOitem_WOD.Visible = .T.
			ThisForm.cmdEditPOitem_WOD.Visible = .T.
			
			ThisForm.cmdConnWOD_TestPO.Visible = .T.
			ThisForm.cmdNewTestPO_WOD.Visible = .T.
			ThisForm.cmdEditTestPO_WOD.Visible = .T.
			
			IF ThisForm.cFromWhere = "WOD"
				ThisForm.Get_Desc('WOD',nWOD)
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.OrigTable = ALIAS()
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE Resize
		PRIVATE nHigh, nWidth
		
		nHigh = ThisForm.Height - 281
		nWidth = ThisForm.Width - 592
		
		ThisForm.grdSOitem.Width = 580 + nWidth
	ENDPROC

	PROCEDURE save_poitem_wo
		PARAMETERS pPOitem
		*ThisForm.Save_POitem_WO()
		
		*pPOitem is ThisForm.cPOitem
		
		
		
		
		IF ThisForm.cPOitem = Proper_PO_item('')
			RETURN .F.
		ENDIF
		
		IF ThisForm.nWO = 0
			RETURN .F.
		ENDIF
		
		*Find Current PO's
		PRIVATE cFoundPOitem, cfPOitem, cTestPO, cDescript
		cFoundPOitem	= ''
		cfPOitem= ''
		cTestPO	= ''
		cDescript = ''
		
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT WO.POitem "
		cSQL = cSQL + ",dbo.f_ItemDescription(sForm,sThck,sSz2,sSz3,sWeight,0) AS Descript "
		cSQL = cSQL + " FROM dbo.WorkOrder WO WITH(NOLOCK) "
		cSQL = cSQL + " WHERE WO.WO = "+STR(ThisForm.nWO)+""
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSearch' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSearch' )
		ENDIF
		
		IF USED('tmpSearch')
			IF RECCOUNT('tmpSearch') > 0
				cFoundPOitem = PrepareSQLtxt(tmpSearch.POitem,'POitem',12)
				cDescript = PrepareSQLtxt(tmpSearch.Descript,'Descript',100)
			ENDIF
			USE IN tmpSearch
		ENDIF
		
		PRIVATE cMess, nMess, lGood
		lGood = .T.
		cMess = "Connecting Conversion POitem '"+ThisForm.cPOitem+"'"+CHR(13)+"to WO "+STR(ThisForm.nWO)+CHR(13)
		cMess = cMess + ALLTRIM(cDescript)+CHR(13)
		
		IF Proper_PO_item(cFoundPOitem) <> Proper_PO_item('')
			cMess = cMess + "WO has a Conversion POitem "+cFoundPOitem+CHR(13)
			cMess = cMess + "This will overwrite Conversion POitem "+cFoundPOitem+CHR(13)
			lGood = .T.
		ENDIF
		
		nMess = 6
		IF lGood = .T.
			
			cMess = cMess +CHR(13)+CHR(13)+"Do you still want to Connect? "+ThisForm.cPOitem
			nMess = MESSAGEBOX(cMess,4+32,"Continue")
		ENDIF
		
		IF nMess <> 6
			RETURN .F.
		ENDIF
		
		*!*	PRIVATE nCntPOitem
		*!*	nCntPOitem = Count_POIteminPurchaseOrder( ThisForm.cPOItem, ThisForm.nConnHandle,"SERVICES" )
		*!*	IF nCntPOitem = 1
		*!*		nMess = 6
		*!*	ELSE
		*!*		cMess = "The WorkOrder Detail has 2 places to store POitem"+CHR(13)+"Is this a Testing PO to be saved to the WOD?"+CHR(13)+CHR(13)+"Answer Yes if this is a Lab service testing PO."+CHR(13)+CHR(13)+"Answer No if this PO is anything else."
		*!*		nMess = MESSAGEBOX(cMess,4+32,"Testing PO")
		
		*!*		IF NOT (nMess = 6 OR nMess = 7)
		*!*			RETURN .F.
		*!*		ENDIF
		*!*	ENDIF
		
		*****************************
		IF nMess = 6
			*Save to WO as Conversion work PO
			cSQL = "UPDATE dbo.WorkOrder "
			cSQL = cSQL + " SET POitem = '"+ThisForm.cPOItem+"'"	
			cSQL = cSQL + " WHERE WO = "+STR(ThisForm.nWO)+""
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSearch' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSearch' )
			ELSE
				*Track
				cMess = "Connected WO "+STR(ThisForm.nWO)+" to Conversion POitem "+ThisForm.cPOitem
				MESSAGEBOX(cMess+CHR(13)+"+ Saved to WorkOrder table ",0+64,"Saved!")
				TrackMess( cMess+ThisForm.cPOItem+" in PurchaseOrder" )
				Insert_PO_Item_Notes(ThisForm.cPOItem,cMess,ThisForm.nConnHandle)
				
			ENDIF	
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE save_poitem_wod
		PARAMETER cPoitem, nWO_Detail
		*ThisForm.Save_POitem_WOD(cPoitem, nWO_Detail)
		
		IF Proper_PO_item(cPOitem) = Proper_PO_item('')
			RETURN .F.
		ENDIF
		
		IF PrepareSQLNum(nWO_Detail,'WO_Detail',-3) = 0
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		***********************
		* Save WOD to POitem
		
		*Search for WOD
		IF USED('tmpSearchPO')
			USE IN tmpSearchPO
		ENDIF
		SELECT 0
		
		cSQL = "SELECT WO,WO_Detail "
		cSQL = cSQL + " FROM dbo.PurchaseOrder PO WITH(NOLOCK) "
		cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		 
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearchPO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSearchPO' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearchPO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearchPO")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		*		nSQLEXEC = -1  to Test SQLEXEC
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSearchPO' )
		ENDIF
		
		PRIVATE lFound_POitem, lFound_WOD, nTmp_WOD, cPOis
		lFound_POitem = .F.
		lFound_WOD = .F.
		nTmp_WOD = 0
		cPOis = ''
		
		IF USED('tmpSearchPO')
			IF RECCOUNT('tmpSearchPO') > 0
				SELECT tmpSearchPO
				lFound_POitem = .T.
				SCAN
					nTmp_WOD = PrepareSQLnum(tmpSearchPO.WO_Detail,'WO_Detail',-3)
					IF nTmp_WOD > 0
						IF nWO_Detail = nTmp_WOD 
							lFound_WOD = .T.
						ELSE
							IF LEN(cPOis) = 0
								cPOis = ALLTRIM(STR( nTmp_WOD ))
							ELSE
								cPOis = cPOis +", "+ ALLTRIM(STR( nTmp_WOD ))
							ENDIF
						ENDIF
					ENDIF
				ENDSCAN
			ENDIF
			USE IN 'tmpSearchPO'
		ENDIF
		
		IF lFound_POitem 
			IF lFound_WOD 
				MESSAGEBOX("Notice: The WO Detail "+ALLTRIM(STR(nWO_Detail))+" already listed with POitem "+cPOitem,0+48,"Found in Purchase Order table")
			ELSE
				IF nTmp_WOD  > 0
					MESSAGEBOX("The WO Detail "+ALLTRIM(STR( nTmp_WOD ))+" is already listed with POitem "+cPOitem,0+48,"Found in Purchase Order table")
					*Connect WO_Detail to POitem Process record.
				ENDIF
			ENDIF
		ELSE
			*Connect WO_Detail to POitem Process record.
		ENDIF
		
		
		
		***********************
		*Find PO's with WOD
		PRIVATE cFoundPOitem, cfPOitem, cTestPO, cDescript
		cFoundPOitem	= ''
		cfPOitem= ''
		cTestPO	= ''
		cDescript = ""
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		SELECT 0
		
		cSQL = "SELECT WO.POitem, WOD.fPOitem, WOD.TestPO "
		cSQL = cSQL + ",dbo.f_ItemDescription(fForm,fThck,fSz2,fSz3,fWeight,0) AS Descript "
		cSQL = cSQL + " FROM dbo.WorkOrder_Detail WOD WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.WorkOrder WO WITH(NOLOCK) ON WOD.WO = WO.WO "
		cSQL = cSQL + " WHERE WOD.WO_Detail = "+STR(ThisForm.nWO_Detail)+""
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSearch' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		*		nSQLEXEC = -1  to Test SQLEXEC
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSearch' )
		ENDIF
		
		IF USED('tmpSearch')
			IF RECCOUNT('tmpSearch') > 0
				cFoundPOitem= PrepareSQLtxt(tmpSearch.POitem,'POitem',12)
				cfPOitem	= PrepareSQLtxt(tmpSearch.fPOitem,'POitem',12)
				cTestPO		= PrepareSQLtxt(tmpSearch.TestPO,'POitem',12)
				cDescript 	= PrepareSQLtxt(tmpSearch.Descript,'Descript',100)
			ENDIF
			USE IN tmpSearch
		ENDIF
		
		PRIVATE cMess, nMess, lGood, lOverWrite
		lGood = .T.
		lOverWrite = .F.
		
		cMess = "Connecting POitem '"+ThisForm.cPOitem+"'"+CHR(13)+"to WO_Detail "+STR(ThisForm.nWO_Detail)+CHR(13)
		cMess = cMess + ALLTRIM(cDescript)+CHR(13)
		IF Proper_PO_item(cFoundPOitem) <> Proper_PO_item('')
			cMess = cMess + "WO has a POitem "+cFoundPOitem+CHR(13)
			lGood = .T.
			lOverWrite = .T.
		ENDIF
		IF Proper_PO_item(cfPOitem) <> Proper_PO_item('')
			cMess = cMess + "WOD has a POitem "+cfPOitem+CHR(13)
			lGood = .T.
			lOverWrite = .T.
		ENDIF
		IF Proper_PO_item(cTestPO) <> Proper_PO_item('')
			cMess = cMess + "WOD Testing POitem "+cTestPO+CHR(13)
			lGood = .T.
			lOverWrite = .T.
		ENDIF
		
		nMess = 6
		IF lGood = .T.
			cMess = cMess +CHR(13)+CHR(13)+"Do you still want to Connect?"
			nMess = MESSAGEBOX(cMess,4+32,"Continue")
		ENDIF
		
		IF nMess <> 6
			RETURN .F.
		ENDIF
		
		PRIVATE nCntPOitem
		nCntPOitem = Count_POIteminPurchaseOrder( ThisForm.cPOItem, ThisForm.nConnHandle,"SERVICES" )
		IF nCntPOitem = 1
			nMess = 6
		ELSE
			cMess = "The WorkOrder Detail has 2 places to store POitem"+CHR(13)+"Is this a Testing PO to be saved to the WOD?"+CHR(13)+CHR(13)+"Answer Yes if this is a Lab service testing PO."+CHR(13)+CHR(13)+"Answer No Conversion/Toll PO."+CHR(13)+"Answer No if this PO is anything else."
			nMess = MESSAGEBOX(cMess,4+32,"Testing PO")
		
			IF NOT (nMess = 6 OR nMess = 7)
				RETURN .F.
			ENDIF
		ENDIF
		
		*****************************
		IF nMess = 6
			*Save to TestPO to WO_Detail
			cSQL = "UPDATE dbo.WorkOrder_Detail "
			cSQL = cSQL + " SET TestPO = '"+ThisForm.cPOItem+"'"
			cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)+""
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSearch' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSearch' )
			ELSE
				*Track
				cMess = "Connected WO_Detail "+STR(ThisForm.nWO_Detail)+" to Testing POitem "+ThisForm.cPOitem
				TrackMess( cMess+ThisForm.cPOItem+" in PurchaseOrder" )
				
				MESSAGEBOX(cMess+CHR(13)+"+ Saved to WO_Detail table ",0+64,"Saved!")
				
				IF lOverWrite
					cMess = "User answered to OverWrite Test PO:"+CHR(13)+cMess
					TrackMess(cMess) 
				ENDIF
				Insert_PO_Item_Notes(ThisForm.cPOItem,cMess,ThisForm.nConnHandle)
			ENDIF	
		ENDIF
		
		*****************************
		IF nMess = 7
			*Save to Finish POitem to WO_Detail
			cSQL = "UPDATE dbo.WorkOrder_Detail "
			cSQL = cSQL + " SET fPOitem = '"+ThisForm.cPOItem+"'"
			cSQL = cSQL + " WHERE WO_Detail = "+STR(ThisForm.nWO_Detail)+""
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSearch' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSearch' )
			ELSE
				*Track
				cMess = "Connected WO_Detail "+STR(ThisForm.nWO_Detail)+" to Finish POitem "+ThisForm.cPOItem
				TrackMess( cMess+ThisForm.cPOItem+" in PurchaseOrder" )
				
				MESSAGEBOX(cMess+CHR(13)+"+ Saved to WO_Detail table ",0+64,"Saved!")
				
				IF lOverWrite
					cMess = "User answered to OverWrite Finish PO:"+CHR(13)+cMess
					TrackMess(cMess) 
				ENDIF
				Insert_PO_Item_Notes(ThisForm.cPOItem,cMess,ThisForm.nConnHandle)
			ENDIF	
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE save_wod_soitem
		PARAMETERS nWO_Detail, cSOitem
		*ThisForm.Save_WOD_SOitem(nWO_Detail, cSOitem)
		*Save WO_Detail to SOitem
		nWO_Detail = PrepareSQLnum(nWO_Detail ,"WO_Detail",-3)
		IF nWO_Detail = 0
			RETURN .F.
		ENDIF
		
		IF cSOitem = Proper_SO_item('')
			RETURN .F.
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		
		*Save to WO_Detail Sales
		cSQL = "UPDATE dbo.Sales "
		cSQL = cSQL + " SET WO_Detail = "+STR(nWO_Detail)
		cSQL = cSQL + " WHERE SOitem = '"+cSOItem+"'"	
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '' )
		ELSE
			*Track
			cMess = "Connected WO_Detail "+STR(nWO_Detail)+" to SOitem "+cSOitem
			MESSAGEBOX(cMess+CHR(13)+"+ Saved to Sales table ",0+64,"Saved!")
			TrackMess( cMess+CHR(13)+cSOItem+" in dbo.Sales" )
			SO_Item_Notes(cSOItem,cMess,ThisForm.nConnHandle)
			
		ENDIF	
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmpPOitems')
			USE IN tmpPOitems
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdConnPOitem_SOitem.Click
		IF ThisForm.cPOitem <> Proper_PO_item('')
			PRIVATE nWO_Detail
			*Find WO_Detail to connect to
			*DO FORM Forms\Select_WorkOrder_Detail WITH pSOitem, pPOitem, nWO to nWO_Detail
			DO FORM Forms\Select_WorkOrder_Detail WITH '', ThisForm.cPOitem, ThisForm.nWO to nWO_Detail
			
			nWO_Detail = PrepareSQLnum(nWO_Detail,'WO_Detail',-3)
			IF nWO_Detail > 0
				ThisForm.txtWO_Detail.Value = nWO_Detail
				ThisForm.nWO_Detail = nWO_Detail
				
			ENDIF
		ENDIF
	ENDPROC

