	PROCEDURE cmdNewWO_POitem.Click
		
		PRIVATE cPOitem,cSOitem,nWO,nWOD,lReturn
		cPOitem	= ThisForm.cPOitem
		cSOitem	= ThisForm.cSOitem 
		nWO		= 0
		nWOD	= 0
		lReturn	= .F.
		
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('') 
			DO FORM Forms\WorkOrder WITH "ADD_PO-Finish",nWO,nWOD,cPOitem,cSOitem,'' TO lReturn
			*DO FORM Forms\WorkOrder WITH "ADD",0,0,'501284-01','',''
			
			IF lReturn
				*PRIVATE nWO
				nWO = getWO_with_POitem( cPOitem, ThisForm.nConnHandle) 
		
				IF nWO > 0
					ThisForm.txtWO.Value = nWO
					ThisForm.nWO = nWO
					
					ThisForm.cmdConnWO_SOitem.Visible = .T.
					ThisForm.cmdNewSOitem_WO.Visible = .T.
					ThisForm.cmdEditSOitem_WO.Visible = .T.
					
					ThisForm.cmdConnWO_POitem.Visible = .T.
					ThisForm.cmdNewPOitem_WO.Visible = .T.
					ThisForm.cmdEditPOitem_WO.Visible = .T.
					
					*IF ThisForm.cFromWhere == "WO"
					*	ThisForm.Get_Desc('WO',nWO)
					*ENDIF
					
					MESSAGEBOX("Work Order "+ALLTRIM(STR(nWO))+" is now connected to the POitem '"+cPOitem+"'",0+64,"Saved")
					
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX('No POitem found!',0,"Cannot Add WO from PO data")
		ENDIF
		
		IF lReturn
			MESSAGEBOX("WorkOrder screen failed to create an new WO",0,"Add WO from PO data failed")
		ENDIF
	ENDPROC

	PROCEDURE lblPOitem.Click
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.txtPOitem.Value,'POitem',12)
		
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_POitem(cPOitem,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE lblSOitem.Click
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(Thisform.txtSOitem.Value,'SOitem',10)
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
		
