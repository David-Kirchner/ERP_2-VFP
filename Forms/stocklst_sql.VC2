		*!*	*PRIVATE cDesc_ID_Detail_P
		*!*	*cDesc_ID_Detail_P = get_Comment_ID_Detail_Process(nID_Detail_P,cTBL,ThisForm.nConnHandle)
		
		*!*	IF USED('StockLst_SQL')
		*!*		SELECT StockLst_SQL
		*!*		LOCATE FOR ID_Detail = nID_Detail
		*!*		IF FOUND('StockLst_SQL')
		*!*			lFound = .T.
		*!*		ENDIF
		*!*	ELSE
		*!*		TrackError("Alias 'STOCKLST_SQL' is not found.","Alias 'STOCKLST_SQL' is not found.", Program(), LINENO(1) )
		*!*	ENDIF
		
		*!*	RETURN lFound
	ENDPROC

	PROCEDURE Init
		*ThisForm.INIT_pWhat(pFunction)
		
		*DO FORM Forms\StockLst_SQL_Browse  (See INIT here)
		*	WITH "BROWSE",'S',Quotes.alloy, lcInvForm,Quotes.CC,Quotes.CL,Quotes.thck,Quotes.Sz2,Quotes.Sz3,cSOitem ,Quotes.SalesNum,Quotes.Pieces,Quotes.Weight ,''      ,Quotes.Q_QTY,Quotes.RandLen,'' &&Can Send Quotes.POitem!
		
		*!*	PARAMETER pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem
		*!*	*DO FORM Forms\StockLst_SQL_Quotes WITH "SELECT",'S',"6B","10","1",'',1,0,0,"1234567-01",1234567,1,10,'',0.0,.F.,''
		*!*	*DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE",'S',"718  ","10","1" ,'' ,.875 ,135,    0,     "",       0,   1,33 ,       '', 0.0,.F.,''
		*!*	*DO FORM Forms\StockLst_SQL_Quotes WITH "GET",'S'
		*!*	*DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE",'S',"HPA N50","10",'',"D",1,0,0,"",,1,10,''
		*!*	*DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSELot",'S',"157"
		*!*	*DO FORM Forms\StockLst_SQL_Quotes WITH "GET",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPOitem TO nID_Deatil
		*!*	*pSalesNum can be nWO on pFunction="SEL_WO"
		*!*	*pSalesNum can be ID_Detail on pFunction="Browse_ID_Detail"
		*!*	*
		*!*	*IF ThisForm.pFunction = "GET" OR ThisForm.pFunction = "SELECT" OR ThisForm.pFunction = "SEL_WO"
		*!*	*	RETURN ThisForm.nReturnID_Detail
		*!*	*ELSE
		*!*	*	RETURN ThisForm.nReturnPrice
		
		*!*	**************************************************************************
		*!*	*This Form lives as a Window in Shop_StockLst_Edit - Repeat edit there.
		*!*	**************************************************************************
		
		*!*	PRIVATE nBestItem, cAlloy, cHeatLot
		*!*	PRIVATE cText,lRandLen, lMetric
		
		
		*!*	
		*!*	ThisForm.INIT_pWhat(pFunction)	&&Moved pFunction to new INIT function.
		*!*	
		*!*	IF TYPE('pFunction') = "C"
		*!*		ThisForm.pFunction = pFunction
		*!*	ELSE
		*!*		ThisForm.pFunction= "BROWSE"
		*!*		pFunction = "BROWSE"
		*!*	ENDIF
		
		
		*   ThisForm.Load_StockLst_SQL('')
		
		*!*	********************
		*!*	** repeate Changes here in GetSO()
		*!*	********************
		
		*!*	IF TYPE('pAlloy') = "C"
		*!*		ThisForm.pAlloy = pAlloy
		*!*		ThisForm.txtAlloy.Value = ThisForm.pAlloy
		*!*	ELSE
		*!*		ThisForm.pAlloy = ""
		*!*		ThisForm.txtAlloy.Value = "HPA N60"
		*!*	ENDIF
		*!*	*************
		*!*	IF TYPE('pForm') = "C"
		*!*		ThisForm.pForm = pForm
		*!*	ELSE
		*!*		ThisForm.pForm = ""
		*!*	ENDIF
		*!*	*************
		*!*	PRIVATE cCC
		*!*	IF PrepareSQLtxt(pCC,'CC',1) = "R"
		*!*		pCC = "1"  &&Replace "R" with CC=1
		*!*	ENDIF
		
		*!*	IF TYPE('pCC') = "C"
		*!*		ThisForm.pCC = pCC
		*!*		cCC = pCC
		*!*		ThisForm.cmbCC.Value = cCC
		*!*	ELSE
		*!*		IF TYPE('pCC') = "N"
		*!*			ThisForm.pCC = STR(pCC)
		*!*			cCC = STR(pCC)
		*!*			ThisForm.cmbCC.Value = cCC
		*!*		ELSE
		*!*			ThisForm.pCC = "1"
		*!*			cCC = "1"
		*!*			ThisForm.cmbCC.Value = cCC
		*!*		ENDIF
		*!*	ENDIF
		*!*	*************
		*!*	PRIVATE cCL
		*!*	IF TYPE('pCL') = "C"
		*!*		ThisForm.pCL = pCL
		*!*		cCL = pCL
		*!*		ThisForm.cmbCC.Value = cCC
		*!*	ELSE
		*!*		IF TYPE('pCL') = "N"
		*!*			ThisForm.pCL = STR(pCL)
		*!*			cCL = STR(pCL)
		*!*			ThisForm.cmbCL.Value = cCL
		*!*		ELSE
		*!*			ThisForm.pCL = ""
		*!*			cCL = ""
		*!*			ThisForm.cmbCL.Value = cCL
		*!*		ENDIF
		*!*	ENDIF
		*!*	*************
		*!*	ThisForm.lblSz1.Visible = .F.
		*!*	ThisForm.lblSz1.Caption = ""
		*!*	IF VARTYPE(pPC) = "N"
		*!*		ThisForm.pPieces = pPc
		*!*	ELSE
		*!*		pPC = 0
		*!*	ENDIF
		*!*	*************
		*!*	IF TYPE('pThck') = "N"
		*!*		ThisForm.pThck = pThck
		*!*		IF pThck > 0
		*!*			ThisForm.lblSz1.Caption = ALLTRIM(Remove0(pThck,10,4))+'"'
		*!*			ThisForm.lblSz1.Visible = .T.
		*!*		ENDIF
		*!*	ELSE
		*!*		ThisForm.pThck = 0
		*!*	ENDIF
		*!*	*************
		*!*	IF TYPE('pSz2') = "N"
		*!*		IF pSz2 > 0
		*!*			ThisForm.lblSz1.Caption = ThisForm.lblSz1.Caption + " X "+ALLTRIM(Remove0(pSz2,9,3))+'"'
		*!*		ENDIF
		*!*	ENDIF
		*!*	*************
		*!*	IF TYPE('pSz3') = "N"
		*!*		IF pSz3 > 0
		*!*			ThisForm.lblSz1.Caption = ThisForm.lblSz1.Caption + " X "+ALLTRIM(remove0(pSz3,9,3))+'"'
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*************
		*!*	pLBS = PrepareSQLnum(pLBS,'LBS',7,1)
		*!*	ThisForm.pWeight = pLBS
		*!*	*************
		*!*	IF TYPE('pQTY') = "N" OR TYPE('pQTY') = "Y"
		*!*		pQTY	= PrepareSQLnum(pQTY,'QTY',-5)
		*!*		ThisForm.pQTY = pQTY
		*!*	ELSE
		*!*		ThisForm.pQTY = 0
		*!*	ENDIF
		*!*	*************
		*!*	IF VARTYPE(pRL) = "L"
		*!*		lRandLen = pRL
		*!*	ELSE
		*!*		lRandLen = .F.
		*!*	ENDIF
		*!*	ThisForm.pRandLen = lRandLen 
		*!*	*************
		
		*!*	lMetric = .F.
		*!*	IF TYPE('pForm') = "C" AND TYPE('pThck') = "N" AND TYPE('pSz2') = "N" AND TYPE('pSz3') = "N"
		*!*		*Overwrite with ItemDescriptionMetric ThisForm.pThck
		*!*		ThisForm.ShowAlloyFormCC(pSz2, pSz3)
		*!*	ENDIF
		
		*!*	*************
		*!*	PRIVATE cTBL
		*!*	IF TYPE('pTBL') = "C"
		*!*		cTBL = pTBL
		*!*	ELSE
		*!*		cTBL = ''
		*!*	ENDIF
		*!*	IF VARTYPE(pTBL) != 'C'
		*!*		IF ThisForm.pFunction= "BROWSE"
		*!*			cTBL = 'S'
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
		*!*		MESSAGEBOX("frmStockLst_SQL_Quotes.Init did not recognize Table Name",0+16,"Bad Initialization!")
		*!*		TrackError("frmStockLst_SQL_Quotes.Init did not recognize Table Name","frmStockLst_SQL_Quotes.Init not recognize Table Name '"+CHR(13)+ThisForm.pFunction+" "+cText+CHR(13)+cTBL+"'.","frmShop_StockLst_Edit.Init",LINENO(1))
		*!*	*	RETURN .F.
		*!*	ENDIF
		
		*!*	ThisForm.cTBL = cTBL
		
		*!*	*****
		*!*	ThisForm.Load_StockLst_SQL(ThisForm.cTBL)
		
		*!*	*****
		*!*	DO CASE
		*!*	CASE ThisForm.cTBL = 'S'
		*!*		This.Caption = 'Browse Stock List SQL'
		*!*	CASE ThisForm.cTBL = "B"
		*!*		This.Caption = 'Browse Broker List SQL'
		*!*	CASE ThisForm.cTBL = "W"
		*!*		This.Caption = 'Browse WIP List SQL'
		*!*	ENDCASE
		
		*!*	*********************
		*!*	IF VARTYPE(pSOItem) = "C"
		*!*		IF Proper_SO_item(pSOitem) = Proper_SO_item('')
		*!*			*empty
		*!*			ThisForm.pSOitem = Proper_SO_item('')
		*!*			ThisForm.txtSOItem.VALUE = ''
		*!*		ELSE
		*!*			ThisForm.txtSOItem.VALUE = Proper_SO_item(pSOItem)
		*!*			ThisForm.pSOitem = Proper_SO_item(pSOItem)
		*!*			ThisForm.pSalesNum = VAL( LEFT(ThisForm.pSOItem,7) )
		*!*		ENDIF
		*!*	ELSE
		*!*		ThisForm.txtSOItem.VALUE = "No SO Item"
		*!*		ThisForm.pSOItem = Proper_SO_item("")
		*!*		IF ThisForm.cmdMark.Caption = "Select this Record"
		*!*			ThisForm.cmdMark.Enabled=.T.
		*!*		ELSE
		*!*			ThisForm.cmdMark.Enabled=.F.
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*********************
		*!*	IF VARTYPE(pSalesNum) = "N"
		*!*		ThisForm.pSalesNum = pSalesNum
		*!*	*ELSE	&&Already Done in pSOitem Check
		*!*		*ThisForm.pSalesNum = 0
		*!*	ENDIF
		
		*!*	*********************
		*!*	*IF VARTYPE(pPOitem) != "C"
		*!*	*	ThisForm.pPOitem = ''
		*!*	*ELSE
		*!*		ThisForm.pPOitem = PrepareSQLtxt(pPOitem,'PO_item',12)
		*!*	*ENDIF
		
		*!*	*IF ThisForm.pSOItem = Proper_SO_item('') AND ThisForm.pSalesNum = 0
		
		
		*!*	*********************
		*!*	IF VARTYPE(pHeatLot) = "C"
		*!*		cHeatLot = pHeatLot
		*!*	ELSE
		*!*		cHeatLot = ''
		*!*	ENDIF
		
		*!*	*********************
		*!*	IF ThisForm.pFunction = "SEL_WO"
		*!*		ThisForm.nWO = PrepareSQLnum(pSalesNum,'WO',10)
		*!*		ThisForm.pSalesNum = VAL( PrepareSQLtxt(pSOItem,'SOitem',10) )
		*!*		pSalesNum = ThisForm.pSalesNum
		*!*		ThisForm.pSOItem = Proper_SO_item(pSOitem)
		*!*		
		*!*		IF ThisForm.nWO > 0
		*!*			ThisForm.pShipDue = getWO_Detail_DueDate( ThisForm.nWO, ThisForm.nConnhandle )
		*!*		ELSE
		*!*			ThisForm.pShipDue = CTOD("  /  /  ")
		*!*		ENDIF
		*!*	ELSE 
		*!*		ThisForm.nWO = 0
		*!*		ThisForm.pShipDue = CTOD("  /  /  ")
		*!*	ENDIF
		
		*!*	*********************
		*!*	PRIVATE nID_Detail
		*!*	nID_Detail = 0
		
		*!*	***********
		*!*	IF ThisForm.pFunction = "BROWSELot"
		*!*		ThisForm.SearchHeatLot(cHeatLot)
		*!*		IF NOT( RECNO('Stocklst_SQL') > 0 AND RECNO('Stocklst_SQL') < RECCOUNT('Stocklst_SQL') )
		*!*			*Did not find by LOT
		*!*			ThisForm.Search(cHeatLot)
		*!*		ENDIF
		*!*	ELSE
		*!*		IF !EMPTY(cHeatLot) 
		*!*			IF UPPER(cHeatLot) != "DUE IN"
		*!*				IF !EMPTY(ThisForm.pAlloy)
		*!*					IF !EMPTY(cCC)
		*!*						ThisForm.Search(cHeatLot)
		*!*					ELSE
		*!*						ThisForm.SearchHeatLot(cHeatLot)
		*!*					ENDIF
		*!*				ELSE
		*!*					ThisForm.SearchHeatLot(cHeatLot)
		*!*				ENDIF
		*!*			ELSE
		*!*				ThisForm.Search('')
		*!*			ENDIF
		*!*		ELSE
		*!*			IF ThisForm.pFunction = "BROWSE_ID_Detail" AND Stocklst_SQL.ID_Detail = pSalesNum
		*!*				*ThisForm.pFunction = "BROWSE_ID_Detail"
		*!*				IF ThisForm.pFunction = "BROWSE_ID_Detail"
		*!*				
		*!*					ThisForm.pSalesNum = 0 &&SalesNum not passed, ID_Detail was.
		*!*					IF cTBL = 'S' OR cTBL = 'B' OR cTBL = 'W'
		*!*						nID_Detail	= pSalesNum
		*!*						IF PrepareSQLnum(pSalesNum,'ID_Detail',-3) > 0
		*!*							ThisForm.GoToID_Detail(nID_Detail, pSz2, pSz3)
		*!*						ELSE
		*!*							**---		
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF
		*!*			ELSE		
		*!*				IF ThisForm.pFunction = "SEL_WO"
		*!*					IF ThisForm.nWO > 0
		*!*						*Look for an ID_Detail by WO
		*!*						nID_Detail = ThisForm.getBy_WO(ThisForm.nWO)
		*!*						IF nID_Detail = 0
		*!*							ThisForm.Search('')
		*!*						ENDIF
		*!*					ENDIF
		*!*				ELSE 
		*!*					*NOT pFunction = "SEL_WO" "BROWSE_ID_Detail" "BROWSELot"
		*!*					*pFunction = "SELECT" "SEL_SS" "GET" "BROWSE" 
		*!*					
		*!*					ThisForm.Search('')
		*!*				
		*!*				ENDIF
		
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*ThisForm.grdStockLst.SetFocus
		*!*	ThisForm.grdStockLst.clmAlloy.SetFocus
		
		*!*	*If Admin, Show Edit!
		*!*	IF HavePermission('EditStockLst',.F.)
		*!*		ThisForm.cmdMasterEdit.Visible = .T.
		*!*		ThisForm.cmdDetailEdit.Visible = .T.
		*!*	ENDIF
		
		*!*	****************
		*!*	IF WEXIST("WorkOrder")
		*!*		ThisForm.Top = ThisForm.Top + 250
		*!*	ENDIF
		
		ThisForm.pSOitem = Proper_SO_item("")
		ThisForm.pPOitem = Proper_PO_item("")
		
		ThisForm.lFirstTime = .T.
		
		ThisForm.Width = 745
	ENDPROC

	PROCEDURE initalloy		&& Init cmbAlloy
		*ThisForm.InitAlloy()
		
		IF NOT USED("StockLst_SQL")
			TrackError("Alias 'STOCKLST_SQL' is not found.","Alias 'STOCKLST_SQL' is not found.", Program(), LINENO(1) )
			RETURN .f.
		ENDIF
		
		ThisForm.cmbAlloy.Clear
		
		
		PRIVATE aAlloys,cAlloy
		DIMENSION aAlloys[1]
		
		SELECT DISTINCT alloy FROM StockLst_SQL WHERE !EMPTY(alloy) ORDER BY Alloy INTO array aAlloys
		
		FOR EACH m.cAlloy IN aAlloys
			IF !EMPTY(m.cAlloy)
				ThisForm.cmbAlloy.AddItem(m.cAlloy)
			ENDIF
		ENDFOR
		
		ThisForm.cmbAlloy.Value = StockLst_SQL.Alloy
		ThisForm.cmbAlloy.Refresh
	ENDPROC

	PROCEDURE init_pwhat
		PARAMETERS pWhat
		*ThisForm.INIT_pWhat()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ''
		ENDIF
		
		IF EMPTY(pWhat) 
			ThisForm.pFunction = "BROWSE"
		ELSE
			ThisForm.pFunction = UPPER(pWhat)
		ENDIF
		
		DO CASE
		CASE ThisForm.pFunction = "SELECT"
			ThisForm.cmdMark.Enabled = .T.
			ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
			ThisForm.cmdMark.Visible = .T.
			ThisForm.LblCost.Visible = .T.
			ThisForm.txtSOitem.Visible = .T.
			ThisForm.lblSz1.Visible = .T.
			ThisForm.txtAlloy.Visible = .T.
			ThisForm.cmdPrevItem.Visible = .T.
			ThisForm.cmdNextItem.Visible = .T.
		
		CASE ThisForm.pFunction = "SEL_SS"
			ThisForm.cmdMark.Enabled = .T.
			ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
			ThisForm.cmdMark.Visible = .T.
			ThisForm.LblCost.Visible = .T.
			ThisForm.txtSOitem.Visible = .T.
			ThisForm.lblSz1.Visible = .T.
			ThisForm.txtAlloy.Visible = .T.
			ThisForm.cmdPrevItem.Visible = .T.
			ThisForm.cmdNextItem.Visible = .T.
		
		CASE ThisForm.pFunction = "SEL_WO"
			ThisForm.cmdMark.Enabled = .T.
			ThisForm.cmdMark.Caption = "Mark Stock for this WorkOrder"
			ThisForm.cmdMark.Visible = .T.
			ThisForm.lblCost.Visible = .T.
			ThisForm.txtSOitem.Visible = .T.
			ThisForm.lblSz1.Visible = .T.
			ThisForm.txtAlloy.Visible = .T.
			ThisForm.cmdPrevItem.Visible = .T.
			ThisForm.cmdNextItem.Visible = .T.
			
		CASE ThisForm.pFunction = "GET"
			*Get does not ADD a Select Process!!- only returns the Select ID_Detail
			ThisForm.cmdMark.Enabled = .T.
			ThisForm.cmdMark.Caption = "Select this Record"
			ThisForm.cmdMark.Visible = .T.
			ThisForm.LblCost.Visible = .T.
			ThisForm.txtSOitem.Visible = .T.
			ThisForm.lblSz1.Visible = .T.
			ThisForm.txtAlloy.Visible = .T.
			ThisForm.cmdPrevItem.Visible = .T.
			ThisForm.cmdNextItem.Visible = .T.
		
		CASE ThisForm.pFunction = "BROWSELOT"  &&Comes from GFM_Log with Lot number
			ThisForm.cmdMark.Enabled = .F.
			ThisForm.cmdMark.Visible = .F.
			ThisForm.LblCost.Visible = .F.
			ThisForm.txtSOitem.Visible = .F.
			ThisForm.lblSz1.Visible = .F.
			ThisForm.txtAlloy.Visible = .F.
			ThisForm.cmdPrevItem.Visible = .F.
			ThisForm.cmdNextItem.Visible = .F.
		*	ThisForm.cmdSearch.Visible = .F.
		
		CASE ThisForm.pFunction = "BROWSE_P"  &&
			ThisForm.cmdMark.Enabled = .F.
			ThisForm.cmdMark.Visible = .F.
			ThisForm.LblCost.Visible = .F.
			ThisForm.txtSOitem.Visible = .T.
			ThisForm.lblSz1.Visible = .F.
			ThisForm.txtAlloy.Visible = .F.
			
			ThisForm.cmdPrevItem.Visible = .T.
			ThisForm.cmdNextItem.Visible = .T.
		
		CASE ThisForm.pFunction = "BROWSE_ID_DETAIL"  &&
			ThisForm.cmdMark.Enabled = .F.
			ThisForm.cmdMark.Visible = .F.
			ThisForm.LblCost.Visible = .F.
			ThisForm.txtSOitem.Visible = .T.
			ThisForm.lblSz1.Visible = .F.
			ThisForm.txtAlloy.Visible = .F.
			
			ThisForm.cmdPrevItem.Visible = .T.
			ThisForm.cmdNextItem.Visible = .T.
		
		CASE ThisForm.pFunction == "BROWSE"
			ThisForm.cmdMark.Enabled = .F.
			ThisForm.cmdMark.Visible = .F.
			ThisForm.lblCost.Visible = .F.
			ThisForm.txtSOitem.Visible = .F.
			ThisForm.lblSz1.Visible = .F.
			ThisForm.txtAlloy.Visible = .F.
			
			ThisForm.cmdPrevItem.Visible = .F.
			ThisForm.cmdNextItem.Visible = .F.
			
			IF LEN(ALLTRIM(ThisForm.cInqNumP)) > 2
				ThisForm.cmdMark.Caption = "Mark as hold for Quote"
				ThisForm.cmdMark.Enabled = .T.
				ThisForm.cmdMark.Visible = .T.
				
				ThisForm.cmdPrevItem.Visible = .T.
				ThisForm.cmdNextItem.Visible = .T.
			ENDIF
		ENDCASE
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_QUOTES ADDITIVE
		ENDIF
		
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection for StockLst_SQL', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		IF SET('SAFETY') = "ON"
			SET SAFETY OFF
		ENDIF
		
		*ThisForm.Load_StockLst_SQL('')
		
	ENDPROC

	PROCEDURE load_stocklst_sql		&& load StockLst SQL
		PARAMETERS pTBL
		*ThisForm.Load_StockLst_SQL('S')
		
		PRIVATE cTBL
		cTBL = ''
		IF VARTYPE(pTBL) = 'C'
			cTBL = pTBL
		ENDIF
		
		ThisForm.grdStockLst.RecordSource = ''
		
		PRIVATE lPrime
		lPrime = PrepareSQLlogic(ThisForm.chkPrime.Value,'Prime')
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * "
		DO CASE
		CASE cTBL = 'S'
			cSQL = cSQL +" FROM dbo.vSales_StockLst WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQL = cSQL +" FROM dbo.vSales_BrokerLst WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQL = cSQL +" FROM dbo.vSales_WIPLst WITH(NOLOCK) "
		OTHERWISE
			MESSAGEBOX("RefreshStockLst did not recognize Table Name",0+16,"Abort Refresh!")
			TrackError("RefreshStockLst did not recognize Table Name","RefreshStockLst did not recognize Table Name '"+cTBL+"'.","frmShop_StockLst_Edit.RefreshStockLst ",LINENO(1))
			RETURN .F.
		ENDCASE
		
		IF lPrime 
			cSQL = cSQL +" WHERE Prime = 1 "
		ENDIF
		
		cSQL = cSQL +" ORDER BY Alloy,[FormSort],CCSort,Size,Heat,Lot"
		* C.CCSortValue, dbo.Forms.FormSort, dbo.f_CC_CLsort(M.CC, M.CL) AS CCCL, C.CCSort
		
		*!*	SELECT M.alloy, M.form, M.CC, M.CL, M.size, CAST(D .weight AS DECIMAL(9, 0)) AS dWeight, M.cond, M.specs, M.heat, M.lot, M.Paid, M.id, CASE WHEN poduedate = '01/01/1900' THEN CONVERT(CHAR(10), ' ', 101) 
		*!*	                         ELSE CONVERT(CHAR(10), PoDueDate, 101) END AS cPODueDate, M.mill, M.history, M.num, M.po_item, D .pc, D .size_h, D .dim1, D .size_l, D .dim2, D .dim3, D .length, CAST(ISNULL(D .weight, 0) AS DECIMAL(9, 1)) AS weight, 
		*!*	                         D .costvalue, D .descript, D .location, D .floorstatus, D .class, D .unit, M.Melt,
		*!*	                             (SELECT        COUNT(*) AS Expr1
		*!*	                               FROM            dbo.StockLst_Process AS SP WITH (NOLOCK)
		*!*	                               WHERE        (D .id_detail = id_detail) AND (process_id = 'SELECTED') AND (SOitem != 'STOCK')) AS Prc, 0 AS Bkr, D .id_detail, M.POStatus, M.FROM_ID, CASE WHEN stkdate = '01/01/1900' THEN CONVERT(CHAR(10), ' ', 101) 
		*!*	                         ELSE CONVERT(CHAR(10), stkdate, 101) END AS cStkDate, ISNULL(D .ReceivingID, 0) AS ReceivingID, D .RandLen, ISNULL(M.BrandName, '') AS BrandName, CONVERT(CHAR(10), D .InvCheck, 101) AS cInvCheck, C.CCSortValue, 
		*!*	                         D .Quarantine, dbo.Forms.FormSort, D .InvCheck, ISNULL
		*!*	                             ((SELECT        SUM(SP.QTY)
		*!*	                                 FROM            dbo.StockLst_Process AS SP WITH (NOLOCK)
		*!*	                                 WHERE        (D .id_detail = id_detail) AND (process_id = 'SELECTED') AND (SOitem != 'STOCK')), 0) AS SelectQTY, dbo.f_CC_CLsort(M.CC, M.CL) AS CCCL, C.CCSort
		*!*	FROM            dbo.Stocklst_Master AS M WITH (NOLOCK) INNER JOIN
		*!*	                         dbo.Stocklst_Detail AS D WITH (NOLOCK) ON M.id = D .id INNER JOIN
		*!*	                         dbo.ConditionCode AS C WITH (NOLOCK) ON M.cc = C.cc INNER JOIN
		*!*	                         dbo.Forms WITH (NOLOCK) ON M.form = dbo.Forms.FormNumber
		
		IF USED("StockLst_SQL")
			SELECT StockLst_SQL
		ELSE
			SELECT 0
		ENDIF
		
		
		*This is a common 'Bad SQL Connetion' initiation point
		ThisForm.nConnHandle = CheckSQLConnection(ThisForm.nConnHandle)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_SQL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_SQL')
		ENDDO
		
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'StockLst_SQL')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ELSE
			
			SELECT StockLst_SQL
			
			INDEX ON Alloy TAG Alloy
			
		**** ignore CC CL	
			INDEX ON Alloy+STR(FormSort,2,0)+STR(SIZE,9,3)  TAG AlFmsSz		&& 10 times
			INDEX ON Alloy+STR(FormSort,2,0)+STR(SIZE,9,3)+Heat+Lot TAG AlFmSzHL
			
		*	INDEX ON Alloy+Form+STR(SIZE,9,3) 				TAG AlFmSize
		
		**** Alloy FormSort CC
			INDEX ON Alloy+STR(FormSort,2,0)+CCsort		 TAG AlFmsCs1	&& 2
			INDEX ON Alloy+STR(FormSort,2,0)+CCsort+CCCL TAG AlFmsCCs 	&& 2
			INDEX ON Alloy+STR(FormSort,2,0)+CCCL  		 TAG AlFmsCCL 	&& 8
			
		**** Alloy Form CC Size
		*	INDEX ON Alloy+Form+CCsort+STR(SIZE,9,3) 	  TAG AlFmCCs1 
			INDEX ON Alloy+Form+CCsort+CCCL+STR(SIZE,9,3) TAG AlFmCCLS &&could be confused with AlFmCCsS  3 times
			INDEX ON Alloy+Form+CCsort+CCCL+STR(SIZE,9,3)+Heat+Lot TAG AlFmCLHL
			
			INDEX ON Alloy+Form+CCCL+STR(SIZE,9,3)   	  TAG AlFmCCsS 	&& 3 times
		
		**** Alloy Form C2 Size
		*TOO Slow	INDEX ON Alloy+Form+C2_Sort(CC,ThisForm.nConnHandle)+STR(SIZE,9,3)+Heat+Lot TAG AlFC2LHL
			
		**** Alloy FormSort CC Size	
			INDEX ON Alloy+STR(FormSort,2,0)+CCsort+STR(SIZE,9,3) 	   TAG AlFmsCCsS 	&& 3 times
			INDEX ON Alloy+STR(FormSort,2,0)+CCsort+CCCL+STR(SIZE,9,3) TAG AlFmsCLsS 	&& 10
			INDEX ON Alloy+STR(FormSort,2,0)+CCsort+CCCL+STR(SIZE,9,3)+Heat+Lot TAG A_CCCLHL 	&& 10 +60
			INDEX ON Alloy+STR(FormSort,2,0)+CCCL+STR(SIZE,9,3)  	   TAG AlFmsCCLS 	&& 12
			
		**** for finding Heat or Lot
			INDEX ON Heat TAG Heat
			INDEX ON Lot TAG Lot
			INDEX ON Proper_PO_Item_PO(PO_item) TAG HPAPO
			
			SET ORDER TO TAG A_CCCLHL
			ThisForm.txtIndex.Value = 'A_CCCLHL'
		
			*SET ORDER TO TAG AlFmsCLsS &&CCSort - with CCCL
			*Could write CCSort to include CC and CL for better sorting.
			
			ThisForm.grdStockLst.RecordSource = 'StockLst_SQL'
			
			ThisForm.grdStockLst.clmWOD.ControlSource = 'StockLst_SQL.WO_Detail'
			
			*ThisForm.grdStockLst.SetAll("dynamicbackcolor", "ThisForm.Dynamic_Back_Color()", "Column" )
			*This code works but it is too slow to use on All columns !!!
			
		
		*!*		ThisForm.grdStockLst.SetAll("dynamicbackcolor" ;
		*!*			, "IIF(StockLst_SQL.Alloy = '400', RGB( 196,145,183 ),RGB( 255, 255, 255 ) ";
		*!*			, "clmAlloy")
		
		*!*		ThisForm.grdStockLst.SetAll("dynamicbackcolor" ;
		*!*			, "IIF(StockLst_SQL.Quarantine, RGB( 128,128,128 )"+;
		*!*			",IIF((StockLst_SQL.Prc > 0 and NOT ISNULL(StockLst_SQL.cPODueDate),RGB( 255,128,64 )"+;
		*!*			",IIF((StockLst_SQL.Prc > 0 and ISNULL(StockLst_SQL.cPODueDate), RGB( 255, 0, 0 )"+;
		*!*			",IIF((StockLst_SQL.ReceivingID = 0 AND StockLst_SQL.Heat = 'Due In'), RGB( 255, 255, 128 )"+;
		*!*			",IIF((StockLst_SQL.ReceivingID = 0 AND StockLst_SQL.Heat != 'Due In' and CTOD(StockLst_SQL.cInvCheck) < DATE()-400), RGB( 235, 235, 235 )"+;
		*!*			",IIF((StockLst_SQL.ReceivingID = 0 AND StockLst_SQL.Heat != 'Due In' and CTOD(StockLst_SQL.cInvCheck) = CTOD('1900-01-01 00:00:00.000') ), RGB( 128,64,64 )"+;
		*!*			",IIF((StockLst_SQL.ReceivingID = 0 AND StockLst_SQL.Heat != 'Due In' and CTOD(StockLst_SQL.cInvCheck) = DATE()+1 ), RGB( 128,128,255 )"+;
		*!*			",IIF((StockLst_SQL.ReceivingID = 0 AND StockLst_SQL.Heat != 'Due In' and CTOD(StockLst_SQL.cInvCheck) = DATE()+2 ), RGB( 196,145,183 )"+;
		*!*			",IIF((StockLst_SQL.ReceivingID = 0 AND StockLst_SQL.Heat != 'Due In' and StockLst_SQL.FloorStatus = 'X'),RGB( 192,192,192)"+;
		*!*			",IIF(StockLst_SQL.POStatus = "P",RGB( 213,252,120 ),RGB( 255, 255, 255 )"+;
		*!*			")))))))))))) ";
		*!*			, "Column")
		
		*!*		ThisForm.grdStockLst.SetAll("dynamicbackcolor" ;
		*!*			,"IIF((StockLst_SQL.ReceivingID = 0 AND StockLst_SQL.Heat != 'Due In' and CTOD(StockLst_SQL.cInvCheck) = DATE()+2 ), RGB( 196,145,183 ),"+;
		*!*			"RGB( 255, 255, 255 )) ";
		*!*			, "Column")
		
			IF NOT EMPTY(cTBL)	
				ThisForm.InitAlloy()
			ENDIF	
		ENDIF
		ThisForm.OrderAlloy = .F.
		ThisForm.OrderAlloyForm = .F.
		
		*****
		DO CASE
		CASE cTBL = 'S'
			ThisForm.cTBL = "S"
			ThisForm.Caption = 'Browse Stock List SQL'
		CASE cTBL = "B"
			ThisForm.cTBL = "B"
			ThisForm.Caption = 'Browse Broker List SQL'
		CASE cTBL = "W"
			ThisForm.cTBL="W"
			ThisForm.Caption = 'Browse WIP List SQL'
		ENDCASE
		
		SELECT StockLst_SQL	&&Used to track where this Table is dropped.
	ENDPROC

	PROCEDURE reloadcl
		*ThisForm.ReloadCL()
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			*IF RECCOUNT('ConditionLevel')>0
				SELECT ConditionLevel
			*ELSE
			*	SELECT 0
			*ENDIF
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		
		ThisForm.cmbCL.clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel WITH(NOLOCK) "
		cSQL= cSQL + " WHERE CC='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionLevel')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		*IF VARTYPE(aConditionLevel)='U'
		IF NOT USED('ConditionLevel')
			ThisForm.cmbCL.addListItem("",1,1)
			ThisForm.cmbCL.addListItem("",1,2)
		ELSE
			IF RECCOUNT('ConditionLevel')=0
				ThisForm.cmbCL.addListItem("",1,1)
				ThisForm.cmbCL.addListItem("",1,2)
			ELSE
				*Found a CL to go with CC
				SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
		
				*This.ColumnCount = ALEN(aConditionLevel,2)
				ThisForm.cmbCL.ColumnCount = 2
				ThisForm.cmbCL.NumberOfElements=ALEN(aConditionLevel)
				ThisForm.cmbCL.BoundColumn = 1
				ThisForm.cmbCL.ColumnWidths = "10,115"
		
				*ThisForm.cmbCL.addListitem("(All Employees)",1,1)
				*ThisForm.cmbCL.addListitem("*",1,2)
				nLoopCount = 1
				*nLoopCount = 0
		
				FOR EACH cc1 IN aConditionLevel
					IF !EMPTY(cc1)
				*		nLoopCount = nLoopCount + 1
						IF LEN(ALLTRIM(cc1)) > 1
							
							ThisForm.cmbCL.addListItem(ALLTRIM(cc1),nLoopCount,2)
						ELSE
							nLoopCount = nLoopCount + 1
							ThisForm.cmbCL.addListItem(ALLTRIM(cc1),nLoopCount,1)
						ENDIF
					ENDIF
				ENDFOR
				
				USE IN ConditionLevel
			ENDIF
		ENDIF
		
		SELECT StockLst_SQL
		*This.Value = "*"
		ThisForm.cmbCL.Value = PrepareSQLtxt(StockLst_SQL.CL,'CL',1)
		
	ENDPROC

