		*!*								SKIP IN StockLst_SQL
		*!*							ENDDO
		*!*						
		*!*						ELSE	&&CCCL not found
		*!*							SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort) and CCSort = cCCSort 
		*!*							DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
		*!*								AND StockLst_SQL.FormSort = VAL(cFormSort) ;
		*!*								AND StockLst_SQL.CCSort = cCCSort  ;
