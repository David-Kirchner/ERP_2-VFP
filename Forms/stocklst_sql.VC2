	PROCEDURE Unload
		IF USED('StockLst_SQL')
			USE IN StockLst_SQL
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		DO CASE
		CASE ThisForm.pFunction = "SELECT"
			RETURN ThisForm.nReturnID_Detail
		CASE ThisForm.pFunction = "SEL_WO"
			RETURN ThisForm.nReturnID_Detail
		CASE ThisForm.pFunction = "GET" 
			RETURN ThisForm.nReturnID_Detail
		CASE ThisForm.pFunction = "SEL_SS"
			RETURN ThisForm.nReturnPrice
		CASE ThisForm.pFunction = "BROWSELot"
			RETURN ThisForm.nReturnPrice
		CASE ThisForm.pFunction = "BROWSE_ID_Detail"
			RETURN ThisForm.nReturnPrice
		CASE ThisForm.pFunction == "BROWSE"
			RETURN ThisForm.nReturnPrice
		OTHERWISE
			RETURN ThisForm.nReturnPrice
		ENDCASE
		
	ENDPROC

	PROCEDURE viewcert		&& Try to open a report of the cert by its heat
		*ThisForm.ViewCert()
		
		PRIVATE cAlloy,cForm,nThck,cHeat,cLot,nID
		
		cAlloy	= PrepareSQLtxt(StockLst_SQL.Alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(StockLst_SQL.Form,'Form',2)
		nThck	= PrepareSQLnum(StockLst_SQL.Size,'Size',9,3)
		cHeat	= PrepareSQLtxt(StockLst_SQL.Heat,'Heat',40)
		cLot	= PrepareSQLtxt(StockLst_SQL.Lot,'Lot',10)
		nID		= PrepareSQLnum(StockLst_SQL.ID,'ID',-3)
		
		PRIVATE lAlwaysOnTop
		lAlwaysOnTop = ThisForm.AlwaysOnTop 
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .F.
		ENDIF
		
		IF cLot = "HPA"
			DO FORM "Forms\ERP_CERTS" WITH cHeat, cLot, '' &&pcType(GFM ROLL LakeErie WIRE)
		ELSE	
			*IF MESSAGEBOX("Do you want to use the new Scanned MTR screen?"+CHR(13)+"Answer No to view HPA Certs",4+32,"MTR")=6
			*	DO FORM "forms\MTR.scx" WITH cALLOY,cForm,nThck,cHeat,cLot,nID,ThisForm.nConnHandle
			*ELSE
			
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = "https://hpalloy0.sharepoint.com/sites/HPAScans-Certifications"
			
			IF NOT EMPTY(m.cHyperLink)
				loHyperlink = CREATEOBJECT("Hyperlink")
				loHyperlink.navigateto(m.cHyperLink)
				RELEASE loHyperlink
				WAIT WINDOW "Look for a Blinking Web page with this Report, then search by Heat" NOWAIT
			ELSE
				WAIT WINDOW "No Report to display" NOWAIT
			ENDIF
		
			*"https://hpalloy0.sharepoint.com/sites/HPAScans-Certifications"
			*	DO FORM "forms\Recollect_Certs.scx" WITH cALLOY,cForm,nThck,cHeat,cLot,nID,ThisForm.nConnHandle
			*ENDIF
		ENDIF
		
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .T.
		ENDIF
		
		*2013-02-01 Form is now WindowType 1 MODAL
		*IF WEXIST("frmStockLst_SQL_Quotes")
		*	ACTIVATE WINDOW frmStockLst_SQL_Quotes
		*ENDIF
		
		*ThisForm.AlwaysOnTop = .T.
		*ThisForm.AlwaysOnTop = .F.
		
	ENDPROC

