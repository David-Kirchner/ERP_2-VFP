		*!*	ThisForm.grdStockLst.SetFocus
		
	ENDPROC

	PROCEDURE cmd3Inch.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nLastRec
		cAlloy	= PrepareSQLtxt(ThisForm.cmbAlloy.Value,'Alloy',12,.T.)
		cForm 	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2,.T.)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL 	= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		nLastRec = 0
		
		PRIVATE cFormSort, cCCSort, cCCCL, lCCCL
		cFormSort = ALLTRIM(STR( GetFormSort(cForm,ThisForm.nConnHandle) ,2,0))
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL 	= CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
		
		
		SELECT StockLst_SQL
		
		DIMENSION aResult(1,1) 
		aResult(1,1) = 0
		
		IF NOT lCCCL
			SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
			 Alloy=cAlloy AND STR(FormSort,2,0)=cFormSort AND STR(StockLst_SQL.Size,9,3)=STR(3,9,3) INTO Array aResult
			
			IF aResult(1,1) > 0
				*Found Alloy FormSort Size
				SEEK cAlloy+cFormSort+STR(3,9,3) IN StockLst_SQL ORDER AlFmsSz
				nLastRec = RECNO("StockLst_SQL")	
			ELSE
				*Did not find Alloy FormSort (Size)
				
				SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
				 Alloy=cAlloy AND STR(FormSort,2,0)=cFormSort INTO Array aResult
				
				SELECT StockLst_SQL
				IF aResult(1,1) = 0
					*Alloy and FormSort not found
					
					SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
					 Alloy=cAlloy INTO Array aResult
				
					IF aResult(1,1) > 0
						*Only found Alloy
						MESSAGEBOX("Form not found for Alloy"+CHR(13)+"0 Records",16,"Error")
						TrackError("FormSort "+cFormSort+" was not found for Alloy "+cAlloy+CHR(13)+"and CCCL is Off","No Records", PROGRAM(), LINENO(1))
		
						SEEK cAlloy IN StockLst_SQL ORDER Alloy
					ELSE
						MESSAGEBOX("Form not found for Alloy"+CHR(13)+"0 Records",16,"Error")
						TrackError("3 Inch not found for Alloy "+cAlloy+CHR(13)+"and CCCL is Off","No Records", PROGRAM(), LINENO(1))
					ENDIF
				ELSE
				
					*Found Alloy and FormSort
					SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
					 Alloy=cAlloy AND STR(FormSort,2,0)=cFormSort AND StockLst_SQL.size < 3 INTO Array aResult	
					
					SELECT StockLst_SQL
					SET ORDER TO TAG AlFmsSz 
					ThisForm.txtIndex.Value = 'AlFmsSz'
					
					SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort)
					GO TOP
					nLastRec = RECNO("StockLst_SQL")	
		
					**********************
					*Try to get closer to 3" like 1"
					SEEK cAlloy+cFormSort+STR(1,9,3) IN StockLst_SQL ORDER AlFmsSz 
					IF FOUND('StockLst_SQL')
						nLastRec = RECNO("StockLst_SQL")
					ELSE
						GOTO nLastRec 
					ENDIF
					**********************
		
					IF aResult(1,1) > 0
						*Found Alloy FormSort and Size less than 3"
						*Skip till just under 3"
						
						DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
							AND StockLst_SQL.FormSort = VAL(cFormSort) ;
							AND StockLst_SQL.Size < 3
							
							nLastRec = RECNO("StockLst_SQL")	
							SKIP IN StockLst_SQL
							
						ENDDO
						
						GOTO nLastRec			
						IF 3-1 > PrepareSQLnum(StockLst_SQL.Size,'Size',9,3) 
							MESSAGEBOX("This is the closest found for"+CHR(13)+cAlloy+" and FormSort="+cFormSort+" and Size="+STR(PrepareSQLnum(StockLst_SQL.Size,'Size',9,3),9,3) ,64,"Closest find!")
						ENDIF
						
					ELSE
						*show first record filtered by All FormSort in index AlFmsSz
						GO TOP IN StockLst_SQL
						nLastRec = RECNO("StockLst_SQL")	
					ENDIF
				ENDIF
				
			ENDIF	
		ELSE
			*Use CCCL
			
			SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
			 Alloy=cAlloy AND Form=cForm AND CCCL=cCCCL AND STR(StockLst_SQL.Size,9,3)=STR(3,9,3) INTO Array aResult
			
			IF aResult(1,1) > 0
				*Found THE Alloy Form CCCL Size
				SEEK cAlloy+cForm+cCCCL+STR(3,9,3) IN StockLst_SQL ORDER AlFmCCsS
				nLastRec = RECNO("StockLst_SQL")
			ELSE
				*Did not find Alloy Form CCCL and exact Size
				
				SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
				 Alloy=cAlloy AND Form=cForm AND CCCL=cCCCL INTO Array aResult
				 
				IF aResult(1,1) > 0
					*Found Alloy Form CCCL, not size
					SELECT StockLst_SQL
					SET ORDER TO TAG AlFmCCsS 
					ThisForm.txtIndex.Value = 'AlFmCCsS'
					
					SET FILTER TO Alloy = cAlloy AND Form=cForm AND CCCL=cCCCL
					GO TOP
					nLastRec = RECNO("StockLst_SQL")	
					
					**********************
					*Try to get closer to 3" like 1"
					SEEK cAlloy+cForm+cCCCL+STR(1,9,3) IN StockLst_SQL ORDER AlFmCCsS 
					IF FOUND('StockLst_SQL')
						nLastRec = RECNO("StockLst_SQL")
					ELSE
						GOTO nLastRec 
					ENDIF
					**********************
										
					DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
						AND StockLst_SQL.Form = cForm ;
						AND StockLst_SQL.CCCL = cCCCL  ;
						AND StockLst_SQL.Size < 3
									
						nLastRec = RECNO("StockLst_SQL")	
						SKIP IN StockLst_SQL
					ENDDO
					
					GOTO nLastRec
					IF 3-1 > PrepareSQLnum(StockLst_SQL.Size,'Size',9,3) 
						MESSAGEBOX("This is the closest found for"+CHR(13)+cAlloy+" and Form="+cForm+" and Size="+STR(PrepareSQLnum(StockLst_SQL.Size,'Size',9,3),9,3) ,64,"Closest find!")
					ENDIF
		
				ELSE
					*Did not find Alloy Form AND CCCL
					*Try FormSort and CCCL
					
					SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
					 Alloy=cAlloy AND STR(FormSort,2,0)=cFormSort AND CCCL=cCCCL INTO Array aResult
							
					IF aResult(1,1) > 0
						*Found Alloy FormSort CCCl -NOT Form
						SELECT StockLst_SQL
						SET ORDER TO TAG AlFmsCCLS 
						ThisForm.txtIndex.Value = 'AlFmsCCLS'
						
						SET FILTER TO Alloy = (cAlloy) AND STR(FormSort,2,0)=cFormSort AND CCCL=cCCCL
						GO TOP
						nLastRec = RECNO("StockLst_SQL")	
						
						**********************
						*Try to get closer to 3" like 1"
						SEEK cAlloy+cFormSort+cCCCL+STR(1,9,3) IN StockLst_SQL ORDER AlFmsCCLS 
						IF FOUND('StockLst_SQL')
							nLastRec = RECNO("StockLst_SQL")
						ELSE
							GOTO nLastRec 
						ENDIF
						**********************
						
						DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
							AND StockLst_SQL.FormSort = VAL(cFormSort) ;
							AND StockLst_SQL.CCCL=cCCCL  ;
							AND StockLst_SQL.Size < 3
									
							nLastRec = RECNO("StockLst_SQL")	
							SKIP IN StockLst_SQL
						ENDDO
						
						GOTO nLastRec
						IF 3-1 > PrepareSQLnum(StockLst_SQL.Size,'Size',9,3) 
							MESSAGEBOX("This is the closest found for"+CHR(13)+cAlloy+" and FormSort="+cFormSort+" and Size="+STR(PrepareSQLnum(StockLst_SQL.Size,'Size',9,3),9,3) ,64,"Closest find!")
						ENDIF
		
						
					ELSE
						*Did not find CCCL (Form or FormSort)
						*just go back to Alloy FormSort CCsort --Get too CC
						SELECT StockLst_SQL
						SET ORDER TO TAG AlFmsCCsS 
						ThisForm.txtIndex.Value = 'AlFmsCCsS'
						
						SET FILTER TO Alloy = (cAlloy) AND STR(FormSort,2,0)=cFormSort AND CCsort= cCCSort
						GO TOP
						nLastRec = RECNO("StockLst_SQL")
						
						**********************
						*Try to get closer to 3" like 1"
						SEEK cAlloy+cFormSort+cCCSort+STR(1,9,3) IN StockLst_SQL ORDER AlFmsCCsS 
						IF FOUND('StockLst_SQL')
							nLastRec = RECNO("StockLst_SQL")
						ELSE
							GOTO nLastRec 
						ENDIF
						**********************
						
						DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
							AND StockLst_SQL.FormSort = VAL(cFormSort) ;
							AND StockLst_SQL.CCsort =cCCsort  ;
							AND StockLst_SQL.Size < 3
									
							nLastRec = RECNO("StockLst_SQL")	
							SKIP IN StockLst_SQL
						ENDDO
						
						GOTO nLastRec
						IF 3-1 > PrepareSQLnum(StockLst_SQL.Size,'Size',9,3) 
							MESSAGEBOX("This is the closest found for"+CHR(13)+cAlloy+" and FormSort="+cFormSort+" and Size="+STR(PrepareSQLnum(StockLst_SQL.Size,'Size',9,3),9,3) ,64,"Closest find!")
						ENDIF
		
		
						MESSAGEBOX("Did not Findy Alloy,Form,CC,CL"+CHR(13)+"Showing Record for Alloy,Form,CC",64,"CL not Found")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		SET FILTER TO
						
		IF nLastRec > 0
			GOTO nLastRec
		ENDIF
		
		IF PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
			SET ORDER TO TAG A_CCCLHL 
			ThisForm.txtIndex.Value = 'A_CCCLHL'
		ELSE
			SET ORDER TO TAG AlFmsSz
			ThisForm.txtIndex.Value = 'AlFmsSz'
		ENDIF
		
		
		ThisForm.ChangeStockLst()
		ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus
	ENDPROC

	PROCEDURE cmd9Inch.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nLastRec
		cAlloy	= PrepareSQLtxt(ThisForm.cmbAlloy.Value,'Alloy',12,.T.)
		cForm 	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2,.T.)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL 	= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		nLastRec = 0
		
		PRIVATE cFormSort, cCCSort, cCCCL, lCCCL
		cFormSort = ALLTRIM(STR( GetFormSort(cForm,ThisForm.nConnHandle) ,2,0))
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL 	= CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
		
		
		SELECT StockLst_SQL
		
		IF NOT lCCCL
			SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
			 Alloy=cAlloy AND STR(FormSort,2,0)=cFormSort AND STR(StockLst_SQL.Size,9,3)=STR(9,9,3) INTO Array aResult
			
			SELECT StockLst_SQL
			IF aResult(1,1) > 0
				*Found Alloy FormSort Size
				SEEK cAlloy+cFormSort+STR(9,9,3) IN StockLst_SQL ORDER AlFmsSz
				nLastRec = RECNO("StockLst_SQL")	
			ELSE
				*Did not find Alloy FormSort (Size)
				
				SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
				 Alloy=cAlloy AND STR(FormSort,2,0)=cFormSort INTO Array aResult
		
				IF aResult(1,1) = 0
					*Alloy and FormSort not found
					
					SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
					 Alloy=cAlloy INTO Array aResult
				
					IF aResult(1,1) > 0
						*Only found Alloy
						MESSAGEBOX("Form not found for Alloy"+CHR(13)+"0 Records",16,"Error")
						TrackError("FormSort "+cFormSort+" was not found for Alloy "+cAlloy+CHR(13)+"and CCCL is Off","No Records", PROGRAM(), LINENO(1))
		
						SEEK cAlloy IN StockLst_SQL ORDER Alloy
					ELSE
						MESSAGEBOX("Form not found for Alloy"+CHR(13)+"0 Records",16,"Error")
						TrackError("1 Inch not found for Alloy "+cAlloy+CHR(13)+"and CCCL is Off","No Records", PROGRAM(), LINENO(1))
					ENDIF
				ELSE
				
					*Found Alloy and FormSort
					SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
					 Alloy=cAlloy AND STR(FormSort,2,0)=cFormSort AND StockLst_SQL.size < 9 INTO Array aResult	
		
					SET ORDER TO TAG AlFmsSz
					ThisForm.txtIndex.Value = 'AlFmsSz'
					
					SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort)
					GO TOP
					nLastRec = RECNO("StockLst_SQL")
					
					**********************
					*Try to get closer to 9" like 1"
					SEEK cAlloy+cFormSort+cCCSort+STR(1,9,3) IN StockLst_SQL ORDER AlFmsCCsS 
					IF FOUND('StockLst_SQL')			
						nLastRec = RECNO("StockLst_SQL")
					ELSE
						GOTO nLastRec 
					ENDIF
					**********************
					*Try to get closer to 9" like 2"
					SEEK cAlloy+cFormSort+cCCSort+STR(2,9,3) IN StockLst_SQL ORDER AlFmsCCsS 
					IF FOUND('StockLst_SQL')			
						nLastRec = RECNO("StockLst_SQL")
					ELSE
						GOTO nLastRec 
					ENDIF
					**********************
					*Try to get closer to 9" like 3"
					SEEK cAlloy+cFormSort+cCCSort+STR(3,9,3) IN StockLst_SQL ORDER AlFmsCCsS 
					IF FOUND('StockLst_SQL')			
						nLastRec = RECNO("StockLst_SQL")
					ELSE
						GOTO nLastRec 
					ENDIF
					**********************
					*Try to get closer to 9" like 6"
					SEEK cAlloy+cFormSort+cCCSort+STR(6,9,3) IN StockLst_SQL ORDER AlFmsCCsS 
					IF FOUND('StockLst_SQL')			
						nLastRec = RECNO("StockLst_SQL")
					ELSE
						GOTO nLastRec 
					ENDIF
					**********************
					
					IF aResult(1,1) > 0
						*Found Alloy FormSort and Size less than 9"
						*Skip till just under 9"
						
						DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
							AND StockLst_SQL.FormSort = VAL(cFormSort) ;
							AND StockLst_SQL.Size < 9
							
							nLastRec = RECNO("StockLst_SQL")	
							SKIP IN StockLst_SQL
							
						ENDDO
						
						GOTO nLastRec				
						IF 9-3 > PrepareSQLnum(StockLst_SQL.Size,'Size',9,3) 
							MESSAGEBOX("This is the closest found for"+CHR(13)+cAlloy+" and FormSort="+cFormSort+" and Size="+STR(PrepareSQLnum(StockLst_SQL.Size,'Size',9,3),9,3) ,64,"Closest find!")
						ENDIF
		
					ELSE
						*show first record filtered by All FormSort in index AlFmsSz
						GO TOP IN StockLst_SQL
						nLastRec = RECNO("StockLst_SQL")	
					ENDIF
				ENDIF
				
			ENDIF	
		ELSE
			*Use CCCL
			
			SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
			 Alloy=cAlloy AND Form=cForm AND CCCL=cCCCL ;
			 AND STR(StockLst_SQL.Size,9,3)=STR(9,9,3) INTO Array aResult
			
			SELECT StockLst_SQL
			IF aResult(1,1) > 0
				*Found THE Alloy Form CCCL Size
				SEEK cAlloy+cForm+cCCCL+STR(9,9,3) IN StockLst_SQL ORDER AlFmCCsS
				nLastRec = RECNO("StockLst_SQL")
			ELSE
				*Did not find Alloy Form CCCL and exact Size
				
				SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
				 Alloy=cAlloy AND Form=cForm AND CCCL=cCCCL INTO Array aResult
				 
				IF aResult(1,1) > 0
					*Found Alloy Form CCCL, not size
					
					SET ORDER TO TAG AlFmCCsS
					ThisForm.txtIndex.Value = 'AlFmCCsS'
					
					SET FILTER TO Alloy=cAlloy AND Form=cForm AND CCCL=cCCCL
					GO TOP
					nLastRec = RECNO("StockLst_SQL")	
													
					**********************
					*Try to get closer to 9" like 1"
					SEEK cAlloy+cForm+cCCCL+STR(1,9,3) IN StockLst_SQL ORDER AlFmsCCsS 
					IF FOUND('StockLst_SQL')
						nLastRec = RECNO("StockLst_SQL")
					ELSE		
						GOTO nLastRec 
					ENDIF
					**********************
					*Try to get closer to 9" like 3"
					SEEK cAlloy+cForm+cCCCL+STR(3,9,3) IN StockLst_SQL ORDER AlFmsCCsS 
					IF FOUND('StockLst_SQL')	
						nLastRec = RECNO("StockLst_SQL")
					ELSE
						GOTO nLastRec 
					ENDIF
					**********************
		
					DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
						AND StockLst_SQL.Form = cForm ;
						AND StockLst_SQL.CCCL = cCCCL  ;
						AND StockLst_SQL.Size < 9
									
						nLastRec = RECNO("StockLst_SQL")	
						SKIP IN StockLst_SQL
					ENDDO
					
					GOTO nLastRec
					IF 9-3 > PrepareSQLnum(StockLst_SQL.Size,'Size',9,3) 
						MESSAGEBOX("This is the closest found for"+CHR(13)+cAlloy+" and Form="+cForm+" and Size="+STR(PrepareSQLnum(StockLst_SQL.Size,'Size',9,3),9,3) ,64,"Closest find!")
					ENDIF
		
				ELSE
					*Did not find Alloy Form AND CCCL
					*Try FormSort and CCCL
					
					SELECT count(*) AS CNTD FROM StockLst_SQL WHERE ;
					 Alloy=cAlloy AND STR(FormSort,2,0)=cFormSort AND CCCL=cCCCL INTO Array aResult
							
					IF aResult(1,1) > 0
						*Found Alloy FormSort CCCl -NOT Form
						SET ORDER TO TAG AlFmsCCLS
						ThisForm.txtIndex.Value = 'AlFmsCCLS'
						
						SET FILTER TO Alloy=(cAlloy) AND STR(FormSort,2,0)=cFormSort AND CCCL=cCCCL
						GO TOP
						nLastRec = RECNO("StockLst_SQL")	
						
						**********************
						*Try to get closer to 9" like 1"
						SEEK cAlloy+cFormSort+cCCCL+STR(1,9,3) IN StockLst_SQL ORDER AlFmsCCLS 
						IF FOUND('StockLst_SQL')			
							nLastRec = RECNO("StockLst_SQL")
						ELSE
							GOTO nLastRec 
						ENDIF
						**********************
						*Try to get closer to 9" like 3"
						SEEK cAlloy+cFormSort+cCCCL+STR(3,9,3) IN StockLst_SQL ORDER AlFmsCCLS 
						IF NOT FOUND('StockLst_SQL')	
							nLastRec = RECNO("StockLst_SQL")
						ELSE		
							GOTO nLastRec 
						ENDIF
						**********************
		
						DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
							AND StockLst_SQL.FormSort = VAL(cFormSort) ;
							AND StockLst_SQL.CCCL=cCCCL  ;
							AND StockLst_SQL.Size < 9
									
							nLastRec = RECNO("StockLst_SQL")	
							SKIP IN StockLst_SQL
						ENDDO
						
						GOTO nLastRec
						IF 9-3 > PrepareSQLnum(StockLst_SQL.Size,'Size',9,3) 
							MESSAGEBOX("This is the closest found for"+CHR(13)+cAlloy+" and FormSort="+cFormSort+" and Size="+STR(PrepareSQLnum(StockLst_SQL.Size,'Size',9,3),9,3) ,64,"Closest find!")
						ENDIF
					
					ELSE
						*Did not find CCCL (Form or FormSort)
						*just go back to Alloy FormSort CCsort --Get too CC
					
						SET ORDER TO TAG AlFmsCCsS
						ThisForm.txtIndex.Value = 'AlFmsCCsS'
						
						SET FILTER TO Alloy=(cAlloy) AND STR(FormSort,2,0)=cFormSort AND CCsort= cCCSort
						GO TOP
						nLastRec = RECNO("StockLst_SQL")
						
						**********************
						*Try to get closer to 9" like 1"
						SEEK cAlloy+cFormSort+cCCSort+STR(1,9,3) IN StockLst_SQL ORDER AlFmsCCsS
						IF FOUND('StockLst_SQL')			
							nLastRec = RECNO("StockLst_SQL")
						ELSE
							GOTO nLastRec 
						ENDIF
						**********************
						*Try to get closer to 9" like 2"
						SEEK cAlloy+cFormSort+cCCSort+STR(2,9,3) IN StockLst_SQL ORDER AlFmsCCsS
						IF FOUND('StockLst_SQL')			
							nLastRec = RECNO("StockLst_SQL")
						ELSE
							GOTO nLastRec 
						ENDIF
						**********************
						*Try to get closer to 9" like 3"
						SEEK cAlloy+cFormSort+cCCSort+STR(3,9,3) IN StockLst_SQL ORDER AlFmsCCsS
						IF FOUND('StockLst_SQL')
							nLastRec = RECNO("StockLst_SQL")
						ELSE			
							GOTO nLastRec 
						ENDIF
						**********************
						*Try to get closer to 9" like 6"
						SEEK cAlloy+cFormSort+cCCSort+STR(6,9,3) IN StockLst_SQL ORDER AlFmsCCsS
						IF FOUND('StockLst_SQL')			
							nLastRec = RECNO("StockLst_SQL")
						ELSE
							GOTO nLastRec 
						ENDIF
		
						**********************
						
						DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
							AND StockLst_SQL.FormSort = VAL(cFormSort) ;
							AND StockLst_SQL.CCsort =cCCsort  ;
							AND StockLst_SQL.Size < 9
									
							nLastRec = RECNO("StockLst_SQL")	
							SKIP IN StockLst_SQL
						ENDDO
						
						GOTO nLastRec
						IF 9-3 > PrepareSQLnum(StockLst_SQL.Size,'Size',9,3) 
							MESSAGEBOX("This is the closest found for"+CHR(13)+cAlloy+" and FormSort="+cFormSort+" and Size="+STR(PrepareSQLnum(StockLst_SQL.Size,'Size',9,3),9,3) ,64,"Closest find!")
						ENDIF
		
						MESSAGEBOX("Did not Findy Alloy,Form,CC,CL"+CHR(13)+"Showing Record for Alloy,Form,CC",64,"CL not Found")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		SET FILTER TO
						
		IF nLastRec > 0
			GOTO nLastRec
		ENDIF
		
		IF PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
			SET ORDER TO TAG A_CCCLHL
			ThisForm.txtIndex.Value = 'A_CCCLHL'
		ELSE
			SET ORDER TO TAG AlFmsSz
			ThisForm.txtIndex.Value = 'AlFmsSz'
		ENDIF
		
		
		ThisForm.ChangeStockLst()
		ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus
		
		
		
		
		
		
		
		
		
		*!*		*Use CCCL
		*!*		SEEK cAlloy+cFormSort+cCCCL+STR(9,9,3) IN StockLst_SQL ORDER AlFmsCCLS
		
		*!*		IF NOT FOUND("StockLst_SQL")
		*!*		
		*!*			SEEK cAlloy+cFormSort+STR(9,9,3) IN StockLst_SQL ORDER AlFmsSz
		
		*!*			IF NOT FOUND("StockLst_SQL")
		*!*				SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL
		*!*						
		*!*				IF FOUND("StockLst_SQL")
		*!*					lFoundCCCL = .T.
		*!*				ELSE
		*!*					SEEK cAlloy+cFormSort+cCCSort IN StockLst_SQL ORDER AlFmsCs1
		*!*					lFoundCCCL = .F.
		*!*				ENDIF
		
		
		*!*				IF RECCOUNT("StockLst_SQL") = 0
		*!*					MESSAGEBOX("Filtered to 0 Records",16,"Error")
		*!*					TrackError("Filtered to 0 Records","Filtered to 0 Records", PROGRAM(), LINENO(1))
		*!*				ELSE
		*!*					LOCATE FOR StockLst_SQL.Alloy = (cAlloy) ;
		*!*						AND StockLst_SQL.FormSort = VAL(cFormSort) ;
		*!*						AND CCCL = cCCCL
		*!*					
		*!*					IF FOUND("StockLst_SQL")
		*!*						IF lFoundCCCL
		*!*							SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort) and CCCL = cCCCL
		*!*							DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
		*!*								AND StockLst_SQL.FormSort = VAL(cFormSort) ;
		*!*								AND StockLst_SQL.CCCL = cCCCL ;
		*!*								AND StockLst_SQL.Size < 9
		*!*								
		*!*								nLastRec = RECNO("StockLst_SQL")	
		*!*								SKIP IN StockLst_SQL
		*!*							ENDDO
		*!*						
		*!*						ELSE	&&CCCL not found
		*!*							SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort) and CCSort = cCCSort 
		*!*							DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
		*!*								AND StockLst_SQL.FormSort = VAL(cFormSort) ;
		*!*								AND StockLst_SQL.CCSort = cCCSort  ;
		*!*								AND StockLst_SQL.Size < 9
		*!*								
		*!*								nLastRec = RECNO("StockLst_SQL")	
		*!*								SKIP IN StockLst_SQL
		*!*							ENDDO
		*!*						
		*!*						ENDIF
		*!*						
		*!*						SET FILTER TO
		*!*						
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	ThisForm.ChangeStockLst()
		*!*	ThisForm.grdStockLst.Refresh
		*!*	ThisForm.grdStockLst.SetFocus
		
	ENDPROC

	PROCEDURE cmdColorCode.Click
		PRIVATE lAlwaysOnTop
		lAlwaysOnTop = ThisForm.AlwaysOnTop 
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .F.
		ENDIF
		DO FORM Forms\StockLst_SQL_Quotes_Colors
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .T.
		ENDIF
	ENDPROC

	PROCEDURE cmdDetailEdit.Click
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail
		
		IF TYPE("StockLst_SQL.ID_Detail")="U"
			MESSAGEBOX("Cannot Edit",0,"No record")
		ELSE
			IF StockLst_SQL.ID_Detail < 1
				MESSAGEBOX("Cannot Edit",0,"No record")
			ELSE
				PRIVATE lAlwaysOnTop
				lAlwaysOnTop = ThisForm.AlwaysOnTop 
				IF lAlwaysOnTop
					ThisForm.AlwaysOnTop = .F.
				ENDIF
				DO FORM Forms\StockLst_Detail WITH "EDIT", StockLst_SQL.ID_Detail, 0, 'StockLst', 0 TO nReturn
				IF lAlwaysOnTop
					ThisForm.AlwaysOnTop = .T.
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdDone.Click
		*ThisForm.nReturnPrice = -1
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdMark.Click
		*cmdMark.Click - Mark current record for this Order.
		
		PRIVATE cAlloy, nStoreID_Detail, lOK
		lOK = .T.
		
		IF StockLst_SQL.ID_Detail = 0
			MESSAGEBOX("This line cannot be Selected!",0+16,"No ID IDetail!")
			RETURN .F.
		ENDIF
		
		IF ThisForm.pFunction = "SELECT"
			ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
		ENDIF
		IF ThisForm.pFunction = "SEL_WO"
			*ThisForm.cmdMark.Caption = "Mark Stock for this WorkOrder"
			
			ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
		ENDIF
		IF ThisForm.pFunction == "BROWSE" AND LEN(ThisForm.cInqNumP) > 0
			ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
		ENDIF
		
		***************
		IF ThisForm.pFunction = "GET" 
		**	NOT OR ThisForm.pFunction = "SELECT" OR ThisForm.pFunction = "SEL_WO"
			*ThisForm.cmdMark.Caption = "Select this Record"
			
			ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
			ThisForm.Release
			RETURN ThisForm.nReturnID_Detail  &&DONE in UNLOAD code!
		ENDIF
		*******************
		
		*Check data
		PRIVATE lReturnNow
		lReturnNow = .F.
		
		PRIVATE cTBL
		cTBL = UPPER(PrepareSQLtxt(ThisForm.cTBL,'TBL',1))
		
		PRIVATE nWO
		nWO = PrepareSQLnum(ThisForm.nWO,'WO',-3)
		
		
		*ThisForm.pFunction = "SELECT"  --Used by EnterOrder to mark Stock
		*ThisForm.pFunction = "SEL_WO"  --Used by WorkOrder to mark Stock
		PRIVATE cMess
		cMess = ''
		
		IF StockLst_SQL.Alloy <> ThisForm.pAlloy 
			IF StockLst_SQL.form = ThisForm.pForm 
				IF LEN(ThisForm.cInqNumP) > 0
					cMess = "CAUTION!"+CHR(13)+"Alloy:"+StockLst_SQL.Alloy+" does not match your Inquire"+ThisForm.pAlloy+"!"+CHR(13)+"Do you still want to select?"
				ELSE
					cMess = "CAUTION!"+CHR(13)+"Alloy:"+StockLst_SQL.Alloy+" does not match what was being Ordered "+ThisForm.pAlloy+"!"+CHR(13)+"Do you still want to select?"
				ENDIF
				
				IF MESSAGEBOX(cMess,4+16,"Select this Stock?") != 6 &&Not yes
					lReturnNow = .T. &&RETURN
				ENDIF
			ELSE
		*		IF INLIST(StockLst_SQL.form,"10","40","60","65")
					IF LEN(ThisForm.cInqNumP) > 0
						cMess = "CAUTION!"+CHR(13)+"Alloy:"+StockLst_SQL.Alloy+" and Form does not match your Inquire"+ThisForm.pAlloy+"!"+CHR(13)+"Do you still want to select?"
					ELSE
						cMess = "CAUTION!"+CHR(13)+"Alloy and Form do not match what was being Ordered!"+CHR(13)+"Do you still want to select?"
					ENDIF
					
					IF MESSAGEBOX(cMess,4+64,"Select this Stock?") != 6 &&Not yes
						lReturnNow = .T. &&RETURN
					ENDIF
		*		ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.pCC = StockLst_SQL.CC AND ThisForm.pCL = StockLst_SQL.CL
		
		ELSE
			IF CC_CLsort(StockLst_SQL.CC,StockLst_SQL.CL,ThisForm.nConnHandle) <> CC_CLsort(ThisForm.pCC,ThisForm.pCL,ThisForm.nConnHandle)
				IF LEN(ThisForm.cInqNumP) > 0
					cMess = "CAUTION!"+CHR(13)+"Condition Code "+StockLst_SQL.CC+" CL"+StockLst_SQL.CL+","+CHR(13)+"does not match your Inquire CC"+ThisForm.pCC+" CL"+ThisForm.pCL+"!"+CHR(13)+"Do you still want to select?"+CHR(13)+CHR(13)+"You may need to use the Quotes 'Starting Stock' option."
				ELSE
					cMess = "CAUTION!"+CHR(13)+"Condition Code "+StockLst_SQL.CC+" CL"+StockLst_SQL.CL+","+CHR(13)+"does not match was being Ordered CC"+ThisForm.pCC+" CL"+ThisForm.pCL+"!"+CHR(13)+"Do you still want to select?"+CHR(13)+CHR(13)+"You may need to use the Quotes 'Starting Stock' option."
				ENDIF
		
				IF MESSAGEBOX(cMess,4+64,"Select this Stock?") != 6 &&Not yes
					lReturnNow = .T. &&RETURN
				ENDIF
			ENDIF
		ENDIF
		
		IF ISNULL(StockLst_SQL.cInvCheck) 
			IF MESSAGEBOX("CAUTION! Item is missing!"+CHR(10)+"Make sure an Inventory Check is done ASAP."+CHR(13)+"Do you still want to select?",4+64,"Select this Stock?") != 6 &&Not yes
				lReturnNow = .T. &&RETURN
			ENDIF
		ENDIF
		IF CTOD(StockLst_SQL.cInvCheck) = CTOD('1900-01-01 00:00:00.000')
			IF MESSAGEBOX("CAUTION! Item is missing!"+CHR(10)+"Make sure an Inventory Check is done ASAP."+CHR(13)+"Do you still want to select?",4+64,"Select this Stock?") != 6 &&Not yes
				lReturnNow = .T. &&RETURN
			ENDIF
		ENDIF
		
		*Check SOitem cancelled
		PRIVATE cSOitem, nWO
		cSOitem = PrepareSQLtxt(ThisForm.pSOItem,'SOitem',10)
		ThisForm.pSOItem = cSOitem
		nWO			= PrepareSQLnum(ThisForm.nWO,'WO',-3)
		ThisForm.nWO = nWO
		
		IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
			IF Count_SOIteminSales(cSOItem, ThisForm.nConnHandle, "CANCEL") > 0
				MESSAGEBOX("CAUTION! SO Item is Cancelled!"+CHR(13)+cSOItem,16,"SOitem select this Stock?") 
				TrackError("SOitem '"+cSOItem+"' is Cancelled. Cannot select this Stock","Cancel SOitem select this Stock?", PROGRAM(), LINENO(1))
				lReturnNow = .T. &&RETURN	
			ENDIF
		ENDIF
		
		IF lReturnNow 
			RETURN
		ENDIF
		
		************************************************************
		
		PRIVATE nWO_2, nD_Detail_Process, lEditWO, nID_Detail_Process
		nWO_2 = 0
		nD_Detail_Process = 0
		lEditWO = .F.
		nID_Detail_Process = 0
		**Check For Duplicate or Process_ID = 'PartSelect'
		
		PRIVATE nReversePounds, nReverseQTY
		nReversePounds = 0
		nReverseQTY = 0
		
		PRIVATE cSQLp, nSQLEXEC
		
		cSQLp = "SELECT ID_Detail_Process, WO, Process_ID "
		cSQLp = cSQLp + ",QTY, Ordered_QTY, Pounds "
		DO CASE
		CASE cTBL = "S"
			cSQLp = cSQLp + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		CASE cTBL = "B"
			cSQLp = cSQLp + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		CASE cTBL = "W"
			cSQLp = cSQLp + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
		OTHERWISE
			MESSAGEBOX("cmdMark.Click() did not recognize Table Name",0+16,"Abort Mark.Click!")
			TrackError("cmdMark.Click() did not recognize Table Name","Mark.Click did not recognize Table Name '"+cTBL+"'.","frmShop_StockLst_Edit.Mark.Click",LINENO(1))
			RETURN .F.
		ENDCASE
		
		cSQLp = cSQLp + " WHERE ID_Detail ="+STR(StockLst_SQL.ID_Detail)
		
		IF nWO > 0
			IF Proper_SO_Item(cSOItem) = Proper_SO_Item('')
				*Ignore the SOitem
				cSQLp = cSQLp + " AND WO="+STR(nWO)
			ELSE
				cSQLp = cSQLp + " AND ( WO="+STR(nWO)+" OR SOitem = dbo.f_ProperSOitem('"+cSOItem+"')" +" )"
			ENDIF
		ELSE
			cSQLp = cSQLp + " AND SOitem = dbo.f_ProperSOitem('"+cSOItem+"')" 
		ENDIF
		cSQLp = cSQLp + " AND Process_ID = 'SELECTED  ' "
		*cSQLp = cSQLp + " AND Process_ID != 'PARTSELECT'"	&&Need TO CONFIRM THE USE OF THIS
		
		IF USED("tmpProcess_cnt")
			SELECT tmpProcess_cnt
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLp, 'tmpProcess_cnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLp, 'tmpProcess_cnt')
		ENDDO
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQLp,ThisForm.nConnHandle,nSQLEXEC, 'tmpProcess_cnt')
				lOK = .F.
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLp )
			ENDIF
		ENDIF
		IF lOK
			IF tmpProcess_cnt.ID_Detail_Process > 0
				nID_Detail_Process = PrepareSQLnum(tmpProcess_cnt.ID_Detail_Process,'tmpProcess_cnt',-3)
				*Found ( SOitem OR WO ) and ID_Detail
				PRIVATE nMessA, cMess 
				nMessA = 0
				
				IF nWO > 0
					*Check as WO!
					nWO_2 = PrepareSQLnum(tmpProcess_cnt.WO,'WO',-3)
					IF nWO_2 > 0
						IF nWO_2 = nWO
							cMess = "Already marked!"+CHR(13)+"Answer 'NO' to remove this process from this item."+CHR(13)
							cMess = cMess + CHR(13)+"or 'Cancel' to not do nothing."
							cMess = cMess + TableName_TBL(cTBL)+" item for this WO/SalesOrder Item."
							
							nMessA = MESSAGEBOX(cMess,3,"You have already selected this!")
							IF nMessA = 7
								*remove
							ELSE
								nMessA = 2 && show as cancel
							ENDIF
						ELSE
							cMess = "Do you want to add this WO to this process to this "
							cMess = cMess + TableName_TBL(cTBL) +" Item?"+CHR(13)
							cMess = cMess + "Answer 'NO' to remove the process from this item."+CHR(13)
							cMess = cMess + CHR(13)+"or 'Cancel' to not do nothing."
		
							nMessA = MESSAGEBOX(cMess,3,"You have already selected this.")
							
							IF nMessA = 6
								lEditWO = .T.	&&EditWO
							ELSE
								*Delete or Abort
								lEditWO = .F.  &&AddWO
							ENDIF
						ENDIF
					ELSE
						*Have WO and not in process!
						cMess = "Do you want to add this WO to this process to this "
						cMess = cMess + TableName_TBL(cTBL)+" Item?"+CHR(13)
						cMess = cMess + "Answer 'NO' to remove the process from this item."+CHR(13)
						cMess = cMess + CHR(13)+"or 'Cancel' to not do nothing."
		
						nMessA = MESSAGEBOX(cMess,3+32,"Mark with WorkOrder")
						IF nMessA = 6
		*					lEditWO = .F. &&AddWO
							lEditWO = .T.	&&EditWO
				*		ELSE
				*			nMessA = 2
						ENDIF
					ENDIF
				ENDIF
				
				IF nMessA = 0
					cMess = "Do you want to add another 'SELECT' process to this "
					cMess = cMess + TableName_TBL(cTBL)+" Item?"+CHR(13)
					cMess = cMess + "Answer 'NO' to remove the process from this item."+CHR(13)
					cMess = cMess + CHR(13)+"or 'Cancel' to not do nothing."
		
					nMessA = MESSAGEBOX(cMess,3,"You have already selected this for this SalesOrder Item.")
				ENDIF
				
				IF nMessA = 7 && No
					*Remove Process
					*Get value to reverse (ItemCost) in dbo.Sales
					PRIVATE nReverseNum, nReverseQTY, nReversePounds, nReverseID_Detail, nReverseValue
					nReverseNum = 0
					nReverseQTY = 0
					nReversePounds=0
					nReverseID_Detail=0
					nReverseValue = 0
					
					IF USED('tmpSPtotal')
						USE IN tmpSPtotal
					ENDIF
					SELECT 0
					
					cSQL = "SELECT QTY, PU, Ordered_QTY, Pounds, ID_Detail "
					
					DO CASE
					CASE cTBL = "S"
						cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
					CASE cTBL = "B"
						cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
					CASE cTBL = "W"
						cSQL = cSQL + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
					ENDCASE
			
					cSQL = cSQL + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
					IF nWO > 0
						IF Proper_SO_item(cSOItem) = Proper_SO_Item('')
							cSQLp = cSQLp + " AND WO="+STR(nWO)
						ELSE
							cSQLp = cSQLp + " AND ( WO="+STR(nWO)+" OR SOitem = dbo.f_ProperSOitem('"+cSOItem+"')" +" )"
						ENDIF
					ELSE
						IF cSOItem <> Proper_SO_item('')
							cSQL = cSQL + " AND SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
						ENDIF
					ENDIF
					cSQL = cSQL + " AND (Process_ID = 'SELECTED' OR Process_ID = 'PARTSELECT' OR Process_ID = 'QUOTED' ) "
		
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSPtotal')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSPtotal' )
					ENDDO
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSPtotal')
							lOK = .F.
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						ENDIF
					ENDIF
					
					IF USED('tmpSPtotal')
						IF VARTYPE(tmpSPtotal.ID_Detail) = "N"
							nReverseQTY		= tmpSPtotal.QTY		&&ERP Acct Standard QTY for Process
							nReversePounds	= tmpSPtotal.Pounds
							nReverseID_Detail = tmpSPtotal.ID_Detail 
						ENDIF
						USE IN tmpSPtotal
					ENDIF
					
					IF nReverseID_Detail > 0
						*Get StockLst Process Value to reverse
					
						IF USED('tmpSDValue')
							USE IN tmpSDValue
						ENDIF
						SELECT 0
						
						cSQL = "SELECT S_P, InvoiceValue "
						DO CASE
						CASE cTBL = "S"
							cSQL = cSQL + " FROM dbo.StockLst_Detail WITH(NOLOCK) "
						CASE cTBL = "B"
							cSQL = cSQL + " FROM dbo.BrokerLst_Detail WITH(NOLOCK) "
						CASE cTBL = "W"
							cSQL = cSQL + " FROM dbo.WIPLst_Detail WITH(NOLOCK) "
						ENDCASE
						cSQL = cSQL + " WHERE ID_Detail = "+STR(nReverseID_Detail)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSDValue')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSDValue' )
						ENDDO
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSDValue')
								lOK = .F.
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							ENDIF
						ENDIF
						
						IF USED('tmpSDValue')
							nReverseValue = PrepareSQLnum(tmpSDValue.S_P,'S_P',-5)
							IF nReverseValue = 0
								*Old School
								nReverseValue = PrepareSQLnum(tmpSDValue.InvoiceValue,'InvoiceValue',-5)
							ENDIF
							USE IN tmpSDValue
						ENDIF				
						
						IF lOK
							*Remove the Blue Background
							ThisForm.txtDimensions.BackColor = RGB( 192,192,192 )
							ThisForm.txtDimensions.DisabledBackColor = RGB( 192,192,192 )
						ENDIF	
					ENDIF
					
					*********************
					&&REMOVE Process
					PRIVATE cSQLd2
					
					cSQLd = "DELETE "
					cSQLd2 = "DELETE "
					DO CASE
					CASE cTBL = "S"
						cSQLd = cSQLd + " FROM dbo.StockLst_Process "
						cSQLd2 = cSQLd2 + " FROM dbo.rtr_Detail WHERE rtr_Detail.TBL='S' "
					CASE cTBL = "B"
						cSQLd = cSQLd + " FROM dbo.BrokerLst_Process "
						cSQLd2 = cSQLd2 + " FROM dbo.rtr_Detail WHERE rtr_Detail.TBL='B' "
					CASE cTBL = "W"
						cSQLd = cSQLd + " FROM dbo.WIPLst_Process "
						cSQLd2 = cSQLd2 + " FROM dbo.rtr_Detail WHERE rtr_Detail.TBL='W' "
					ENDCASE
					cSQLd = cSQLd + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
					cSQLd2 = cSQLd2 + " AND ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
					ENDDO
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLd,ThisForm.nConnHandle,nSQLEXEC, '')
							lOK = .F.
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLd )
						ENDIF
					ELSE
						WAIT WINDOW "DELETED Process from StockLst!" NOWAIT
					ENDIF
					
					*********************
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd2)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd2)
					ENDDO
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLd2,ThisForm.nConnHandle,nSQLEXEC, '')
							lOK = .F.
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLd2 )
						ENDIF
					ELSE
						*WAIT WINDOW "DELETED Select Material detail from RTR_Detail!" NOWAIT
					ENDIF
					
					*********************
					
					PRIVATE nTotalReverse, nItemCost, nNewTotal
					nTotalReverse = nReversePounds * nReverseValue 
					nItemCost = 0
					nNewTotal = 0
					IF nTotalReverse > 0 AND lOK
						*Get current total
						IF USED('tmpSitemcost')
							USE IN tmpSitemcost
						ENDIF
						SELECT 0
						
						cSQL = "SELECT S_Total, ItemCost FROM dbo.Sales WITH(NOLOCK) WHERE SOitem = '"+cSOItem+"'"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSitemcost')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSitemcost' )
						ENDDO
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSitemcost')
								lOK = .F.
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							ENDIF
						ENDIF
						
						IF USED('tmpSitemcost')
							nS_Total = PrepareSQLnum(tmpSitemcost.S_Total,'Total',-5)
							nItemCost = PrepareSQLnum(tmpSitemcost.ItemCost,'ItemCost',-5)
							
							USE IN tmpSitemcost
						ENDIF				
						
						IF nItemCost > 0
							nNewTotal = ROUND(nItemCost - nTotalReverse,2)
						ENDIF
					ENDIF
					
					IF nNewTotal > 0 AND lOK
						*cSOitem = ThisForm.pSOItem
						
						cSQLu = "UPDATE dbo.Sales SET ItemCost = "+STR(nNewTotal,18,4)
						cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
						ENDDO
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC, '')
								lOK = .F.
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
							ENDIF
						ENDIF
						IF lOK
							PRIVATE nSO, cWhat, cComment
							nSO = VAL(cSOitem)
							cWhat = "Updated ItemCost"
							cComment = "User UnSelected a process."+" SOitem '"+cSOitem+"' TBL="+cTBL+" ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+" ReverseValue="+ALLTRIM(STR(nReverseValue))
							Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, ThisForm.nConnHandle)
							WAIT WINDOW "Removed Process from Order Cost!" TIMEOUT 1
							MESSAGEBOX("Process has be removed"+CHR(13)+" You can Return or Select stock to Mark",0,"Removed marked stock process")
						ENDIF
					ENDIF
					
					***************************
					RETURN
					***************************
				ENDIF
				IF nMessA = 2 && Cancel
					***************************
					RETURN		
					***************************
				ENDIF
			ENDIF
			
			IF USED("tmpProcess_cnt")
				USE IN tmpProcess_cnt
			ENDIF
		ENDIF
		
		***************************************************
		PRIVATE lAlwaysOnTop
		lAlwaysOnTop = ThisForm.AlwaysOnTop 
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .F.
		ENDIF
		
		PRIVATE cPOitem
		DO CASE
		CASE cTBL = "S"
			cPOitem 	= ThisForm.pPOitem
		CASE cTBL = "B"
			cPOitem		= ThisForm.pPOitem	&&Only the PO of a Broker is important.
		CASE cTBL = "W"
			cPOitem		= ThisForm.pPOitem	&& SEL_WO will call getWorkOrder_POitem
		OTHERWISE
			TrackError("Did not get a TBL parameter","cTBL:"+cTBL,"StockLst_Process:cmdMark.Click ",LINENO(1))
			cPOitem = ThisForm.pPOitem
		ENDCASE
		
		PRIVATE cComment, nID_Detail, nStoreID_Detail 
		cComment	= ALLTRIM(ThisForm.lblSz1.Caption)
		nID_Detail	= PrepareSQLnum(StockLst_SQL.ID_Detail,'ID_Detail',-3)
		nStoreID_Detail = nID_Detail
		
		PRIVATE cSalesP, nSalesNum
		cSalesP = ThisForm.pSalesP
		nSalesNum = ThisForm.pSalesNum 
		PRIVATE cWhat
		cWhat = "ADD_SOLD"
		
		*ThisForm.pFunction
		************************************************************************************************************
		IF ThisForm.pFunction = "SEL_WO"
			*ThisForm.cmdMark.Caption = "Mark Stock for this WorkOrder"
			
			IF lEditWO
				cWhat = "EDIT_WO"
				nID_D_P = nID_Detail_Process
			ELSE
				cWhat = "ADD_WO"
			ENDIF
		
			cSalesP = '9'
			cComment = "WorkOrder:"+ALLTRIM(STR(nWO))+" to Convert: "+cComment
			IF Proper_PO_item(cPOitem) = Proper_PO_item("")
				cPOitem = getWorkOrder_POitem( nWO, ThisForm.nConnhandle ) 
				ThisForm.pPOitem = PrepareSQLtxt(cPOitem,'POitem',12)
			ELSE
				*Using POitem passed in.
				*cPOitem = ThisForm.pPOitem 
			ENDIF
			
			IF nWO > 0
						
				IF USED("tmpWOSel")
					SELECT tmpWOSel
				ELSE
					SELECT 0
				ENDIF
				
				cSQL = "SELECT sWeight "
				cSQL = cSQL+",SalesRep,StartDate "
				cSQL = cSQL+",DueDate "
				cSQL = cSQL+" FROM dbo.WorkOrder WITH(NOLOCK) "
				cSQL = cSQL+" WHERE WO="+STR(nWO)
				
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWOSel')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWOSel')
				ENDDO
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpWOSel')
						lOK = .F.
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
				IF lOK
					IF USED('tmpWOSel')
						IF RECCOUNT('tmpWOSel') > 0
							cSalesRep			= PrepareSQLtxt(tmpWOSel.SalesRep,'SalesRep',20)
							cSalesP 			= AppSetup_Get_SalesP(cSalesRep)
							ThisForm.pSalesDate	= PrepareSQLDate(tmpWOSel.StartDate,'StartDate')
							ThisForm.pWeight	= PrepareSQLnum(tmpWOSel.sWeight,'Weight',9,1)
							ThisForm.pQTY		= PrepareSQLnum(tmpWOSel.sWeight,'Weight',9,1)
							ThisForm.pShipDue	= PrepareSQLDate(tmpWOSel.DueDate,'DueDate')
						ENDIF
						USE IN tmpWOSel
					ENDIF
				ENDIF
			ENDIF
		
		ENDIF
		
		*ThisForm.pFunction************************************************************************************************************
		
		IF ThisForm.pFunction = "SELECT"
			*ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
			
			IF Proper_SO_Item(cSOItem) != Proper_SO_Item('')
				cWhat = "ADD_SOLD"
				
				IF USED("tmpSEL")
					SELECT tmpSEL
				ELSE
					SELECT 0
				ENDIF
				
				cSQL = "SELECT AQ.Weight "
				cSQL = cSQL+",AQ.SalesP,AQ.SaleDate,AQ.Q_QTY "
				cSQL = cSQL+",S.ShipDue "
				cSQL = cSQL+" FROM dbo.AllQuotes AQ WITH(NOLOCK) "
				cSQL = cSQL+" LEFT OUTER JOIN dbo.StartingStock SS WITH(NOLOCK) ON AQ.ID = SS.AllQuotes_ID "
				cSQL = cSQL+" INNER JOIN dbo.Sales S WITH(NOLOCK) ON S.SOitem = AQ.SOitem "
				cSQL = cSQL+" WHERE AQ.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
			
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL')
				ENDDO
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSEL')
						lOK = .F.
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
				IF lOK
					IF USED('tmpSEL')
						IF RECCOUNT('tmpSEL') > 0
							cSalesP				= PrepareSQLtxt(tmpSEL.SalesP,'SalesP',1)
							ThisForm.pSalesDate	= PrepareSQLDate(tmpSEL.SaleDate,'SaleDate')
							ThisForm.pWeight	= PrepareSQLnum(tmpSEL.Weight,'Weight',9,1)
							ThisForm.pQTY		= PrepareSQLnum(tmpSEL.Q_QTY,'Q_QTY',-5)
							ThisForm.pShipDue	= PrepareSQLDate(tmpSEL.ShipDue,'ShipDue')
						ENDIF
						USE IN tmpSEL
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*******************************
		*ThisForm.cInqNumP 
		IF ThisForm.pFunction == "BROWSE" AND LEN(ALLTRIM(ThisForm.cInqNumP)) > 2
			*ThisForm.cmdMark.Caption = "Mark as hold for Quote"
			
			cWhat = "QUOTE"
				
			IF USED("tmpSEL")
				SELECT tmpSEL
			ELSE
				SELECT 0
			ENDIF
			
			cSQL = "SELECT AQ.Weight "
			cSQL = cSQL+",AQ.SalesP"
			cSQL = cSQL+",GetDate() AS SaleDate "
			cSQL = cSQL+",AQ.Q_QTY "
			cSQL = cSQL+",GetDate()+1 AS ShipDue "
			cSQL = cSQL+" FROM dbo.AllQuotes AQ WITH(NOLOCK) "
			cSQL = cSQL+" LEFT OUTER JOIN dbo.StartingStock SS WITH(NOLOCK) ON AQ.ID = SS.AllQuotes_ID "
			cSQL = cSQL+" WHERE AQ.InqNumP = '"+Proper_InqNumP(ThisForm.cInqNumP)+"'"
		
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSEL")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSEL")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSEL')
				lOK = .F.
			ELSE
				IF USED('tmpSEL')
					IF RECCOUNT('tmpSEL') > 0
						cSalesP				= PrepareSQLtxt(tmpSEL.SalesP,'SalesP',1)
						ThisForm.pSalesDate	= PrepareSQLDate(tmpSEL.SaleDate,'SaleDate')
						ThisForm.pWeight	= PrepareSQLnum(tmpSEL.Weight,'Weight',9,1)
						ThisForm.pQTY		= PrepareSQLnum(tmpSEL.Q_QTY,'Q_QTY',-5)
						ThisForm.pShipDue	= PrepareSQLDate(tmpSEL.ShipDue,'ShipDue')
		*				ThisForm.pSOItem	= ''
						cInqNumP		= Proper_InqNumP(ThisForm.cInqNumP)
					ENDIF
					USE IN tmpSEL
				ENDIF
			ENDIF
		
		ENDIF
		
		*ThisForm.pFunction************************************************************************************************************
		
		IF ThisForm.pFunction = "SEL_SS"
			*ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
			
			IF Proper_SO_Item(cSOItem) != Proper_SO_Item('')
				*ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
				cWhat = "ADD_SOLD"
				
				IF USED("tmpSEL_SS")
					SELECT tmpSEL_SS
				ELSE
					SELECT 0
				ENDIF
				
				cSQL = "SELECT SS.Weight "
				cSQL = cSQL+",AQ.SalesP,AQ.SaleDate" &&, AQ.Q_QTY, AQ.S_QTY "
				cSQL = cSQL+",S.ShipDue "
				cSQL = cSQL+",S.S_PU, S.S_QTY, S.S_P, S.S_Total "
				cSQL = cSQL+" FROM dbo.StartingStock SS WITH(NOLOCK) "
				cSQL = cSQL+" INNER JOIN dbo.Sales S WITH(NOLOCK) ON s.SOitem = SS.SOitem "
				cSQL = cSQL+" INNER JOIN dbo.AllQuotes AQ WITH(NOLOCK) ON AQ.ID = SS.AllQuotes_ID "
				cSQL = cSQL+" WHERE SS.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
				
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL_SS')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL_SS')
				ENDDO
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSEL_SS')
						lOK = .F.
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
					ENDIF
				ENDIF
				IF lOK
					IF USED('tmpSEL_SS')
						IF RECCOUNT('tmpSEL_SS') > 0
							cSalesP				= PrepareSQLtxt(tmpSEL_SS.SalesP,'SalesP',1)
							ThisForm.pSalesDate	= PrepareSQLDate(tmpSEL_SS.SaleDate,'SaleDate')
							ThisForm.pWeight	= PrepareSQLnum(tmpSEL_SS.Weight,'Weight',9,1)
							
							nAQ_QTY = PrepareSQLnum(tmpSEL_SS.S_QTY,'S_QTY',-5)		&&Acct QTY from Quotes
							nSO_QTY = PrepareSQLnum(tmpSEL_SS.S_QTY,'S_QTY',-5)	&&Acct QTY from Sales
							
							*nQ_QTY	= PrepareSQLnum(tmpSEL_SS.Q_QTY,'Q_QTY',-5)	&&Customer QTY
							ThisForm.pQTY		= IIF(nSO_QTY> 0, nSO_QTY, nAQ_QTY )
							
							ThisForm.pShipDue	= PrepareSQLDate(tmpSEL_SS.ShipDue,'ShipDue')
						ENDIF
						USE IN tmpSEL_SS
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*ThisForm.pFunction************************************************************************************************************
		
		IF ThisForm.pFunction = "Browse_ID_Detail"
			ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
		ENDIF
		
		***************************
		
		DO FORM Forms\StockLst_Process WITH cWhat, nID_Detail_Process, cSOItem, cSalesP, ThisForm.pSalesDate,ThisForm.pWeight,ThisForm.pQTY,PrepareSQLtxt(cComment,'Comment',-1),ThisForm.pShipDue,cTBL, cPOitem, nWO, nID_Detail, ThisForm.cInqNumP TO nID_Detail_Process
		*PARAMTER                         cWhatDo, pID_D_P           , pSOItem, pSalesP,          pSalesDate,            pLBS,         pQTY,                            pComment,         pShipDue,pLst, pPoItem, pWO, pID_Detail         , pInqNumP
		*PARAMETER cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue,'StockLst',nWO
		
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .T.
		ENDIF
		
		
		IF TYPE("nID_Detail_Process") = "N"
			IF nID_Detail_Process > 0
				
				ThisForm.nReturnID_Detail = nID_Detail_Process
				PRIVATE nCostValue
				nCostValue = PrepareSQLnum(StockLst_SQL.CostValue,'CostValue',10,2)
				ThisForm.nReturnPrice = nCostValue
				ThisForm.lblCost.Caption = "$"+ALLTRIM(STR(nCostValue,10,2))
				
				nStoreID_Detail = StockLst_SQL.ID_Detail
				cAlloy = StockLst_SQL.Alloy
			ENDIF
		ENDIF
		
		IF ThisForm.pFunction = "SEL_WO" AND nID_Detail_Process > 0
			
			SELECT 0
			cSQL = "UPDATE dbo.WorkOrder "
			cSQL = cSQL+" SET lPrc_Stock = 1 "
			cSQL = cSQL+",TBL = '"+cTBL+"'"
			cSQL = cSQL+",sID_Detail ="+STR(nStoreID_Detail)
			cSQL = cSQL+",sID_Detail_Process ="+STR(nID_Detail_Process)
			*cSQL = cSQL+",Heat
			*cSQL = cSQL+",Lot
			cSQL = cSQL+" WHERE WO="+STR(nWO)+";"
			
			*cSQL = cSQL+" UPDATE dbo.WorkOrder_Detail "
			*cSQL = cSQL+" SET Heat = '"++"'"
			*cSQL = cSQL+",Lot = '"++"'"
			*cSQL = cSQL+" WHERE WO="+STR(nWO)
			*cSQL = cSQL+" AND LEN(Heat)=0 "+";"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
					*lOK = .F.
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
			ENDIF
			
			*ThisForm.Release	&&Does not take effect till end of Click routine
			*Do not Release: Let user see the hilighted row and choose return when ready.
			
		ENDIF
		
		ThisForm.grdStockLst.RecordSource = ""
		ThisForm.Load_StockLst_SQL(cTBL)
		ThisForm.grdStockLst.RecordSource = "StockLst_SQL"
		
		SELECT StockLst_SQL 
		LOCATE FOR StockLst_SQL.ID_Detail = nStoreID_Detail 
		
		ThisForm.ChangeStockLst()
		ThisForm.grdStockLst.Refresh
		
		PRIVATE lMarkBlue
		lMarkBlue = .F.
		
		IF PrepareSQLnum(StockLst_SQL.ID_Detail,'ID_Detail',-3) > 0
			IF Proper_SO_item(cSOitem) != Proper_SO_item('')
				IF Is_ID_Detail_SELECTED_SOitem(StockLst_SQL.ID_Detail, cSOitem, cTBL, ThisForm.nConnhandle )
					lMarkBlue = .T.
					WAIT WINDOW 'BLUE means this stock line is Selected for this Sales Order Item.' NOWAIT
				ENDIF
			ENDIF
		
			IF nWO > 0
				IF Is_ID_Detail_SELECTED_WO(StockLst_SQL.ID_Detail, nWO, cTBL, ThisForm.nConnhandle )
					WAIT WINDOW 'BLUE means this stock line is Selected for this Work Order.' NOWAIT
					lMarkBlue = .T.
				ENDIF
			ENDIF
			
			IF LEN(ALLTRIM(ThisForm.cInqNumP)) > 2
				IF Is_ID_Detail_SELECTED_InqNumP(StockLst_SQL.ID_Detail, ThisForm.cInqNumP, cTBL, ThisForm.nConnhandle )
					WAIT WINDOW 'BLUE means this stock line is Selected for this Quote.' NOWAIT
					lMarkBlue = .T.
				ENDIF	
			ENDIF
		ENDIF
		
		IF lMarkBlue
			ThisForm.txtDimensions.BackColor = RGB( 0,128,255 )  &&Blue
			ThisForm.txtDimensions.DisabledBackColor = RGB( 0,128,255 )
		ELSE
			ThisForm.txtDimensions.BackColor = RGB( 192,192,192 )
			ThisForm.txtDimensions.DisabledBackColor = RGB( 192,192,192 )
		ENDIF
		
		ThisForm.txtDimensions.Refresh
		
		Thisform.cmdDone.SetFocus()
		
		
		
		
		
		
		
		
		
		
		****
		
		
		
		
		
		
		
		
		*!*	*cmdMark.Click - Mark current record for this Order.
		
		*!*	PRIVATE cAlloy, nStoreID_Detail, lOK
		*!*	lOK = .T.
		
		*!*	IF StockLst_SQL.ID_Detail = 0
		*!*		MESSAGEBOX("This line cannot be Selected!",0+16,"No ID IDetail!")
		*!*		RETURN .F.
		*!*	ENDIF
		
		*!*	IF ThisForm.pFunction = "SELECT"
		*!*		ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
		*!*	ENDIF
		*!*	IF ThisForm.pFunction = "SEL_WO"
		*!*		*ThisForm.cmdMark.Caption = "Mark Stock for this WorkOrder"
		*!*		
		*!*		ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
		*!*	ENDIF
		*!*	IF ThisForm.pFunction == "BROWSE" AND LEN(ThisForm.cInqNumP) > 0
		*!*		ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
		*!*	ENDIF
		
		*!*	***************
		*!*	IF ThisForm.pFunction = "GET" 
		*!*	**	NOT OR ThisForm.pFunction = "SELECT" OR ThisForm.pFunction = "SEL_WO"
		*!*		*ThisForm.cmdMark.Caption = "Select this Record"
		*!*		
		*!*		ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
		*!*		ThisForm.Release
		*!*		RETURN ThisForm.nReturnID_Detail  &&DONE in UNLOAD code!
		*!*	ENDIF
		*!*	*******************
		
		*!*	*Check data
		*!*	PRIVATE lReturnNow
		*!*	lReturnNow = .F.
		
		*!*	PRIVATE cTBL
		*!*	cTBL = UPPER(PrepareSQLtxt(ThisForm.cTBL,'TBL',1))
		
		*!*	PRIVATE nWO
		*!*	nWO = PrepareSQLnum(ThisForm.nWO,'WO',-3)
		
		
		*!*	*ThisForm.pFunction = "SELECT"  --Used by EnterOrder to mark Stock
		*!*	*ThisForm.pFunction = "SEL_WO"  --Used by WorkOrder to mark Stock
		*!*	PRIVATE cMess
		*!*	cMess = ''
		
		*!*	IF StockLst_SQL.Alloy <> ThisForm.pAlloy 
		*!*		IF StockLst_SQL.form = ThisForm.pForm 
		*!*			IF LEN(ThisForm.cInqNumP) > 0
		*!*				cMess = "CAUTION!"+CHR(13)+"Alloy:"+StockLst_SQL.Alloy+" does not match your Inquire"+ThisForm.pAlloy+"!"+CHR(13)+"Do you still want to select?"
		*!*			ELSE
		*!*				cMess = "CAUTION!"+CHR(13)+"Alloy:"+StockLst_SQL.Alloy+" does not match what was being Ordered "+ThisForm.pAlloy+"!"+CHR(13)+"Do you still want to select?"
		*!*			ENDIF
		*!*			
		*!*			IF MESSAGEBOX(cMess,4+16,"Select this Stock?") != 6 &&Not yes
		*!*				lReturnNow = .T. &&RETURN
		*!*			ENDIF
		*!*		ELSE
		*!*	*		IF INLIST(StockLst_SQL.form,"10","40","60","65")
		*!*				IF LEN(ThisForm.cInqNumP) > 0
		*!*					cMess = "CAUTION!"+CHR(13)+"Alloy:"+StockLst_SQL.Alloy+" and Form does not match your Inquire"+ThisForm.pAlloy+"!"+CHR(13)+"Do you still want to select?"
		*!*				ELSE
		*!*					cMess = "CAUTION!"+CHR(13)+"Alloy and Form do not match what was being Ordered!"+CHR(13)+"Do you still want to select?"
		*!*				ENDIF
		*!*				
		*!*				IF MESSAGEBOX(cMess,4+64,"Select this Stock?") != 6 &&Not yes
		*!*					lReturnNow = .T. &&RETURN
		*!*				ENDIF
		*!*	*		ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF CC_CLsort(StockLst_SQL.CC,StockLst_SQL.CL,ThisForm.nConnHandle) <> CC_CLsort(ThisForm.pCC,ThisForm.pCL,ThisForm.nConnHandle)
		*!*		IF LEN(ThisForm.cInqNumP) > 0
		*!*			cMess = "CAUTION!"+CHR(13)+"Condition Code does not match your Inquire CC!"+CHR(13)+"Do you still want to select?"+CHR(13)+CHR(13)+"You may need to use the Quotes 'Starting Stock' option."
		*!*		ELSE
		*!*			cMess = "CAUTION!"+CHR(13)+"Condition Code does not match what was being Ordered!"+CHR(13)+"Do you still want to select?"+CHR(13)+CHR(13)+"You may need to use the Quotes 'Starting Stock' option."
		*!*		ENDIF
		
		*!*		IF MESSAGEBOX(cMess,4+64,"Select this Stock?") != 6 &&Not yes
		*!*			lReturnNow = .T. &&RETURN
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF ISNULL(StockLst_SQL.cInvCheck) 
		*!*		IF MESSAGEBOX("CAUTION! Item is missing!"+CHR(10)+"Make sure an Inventory Check is done ASAP."+CHR(13)+"Do you still want to select?",4+64,"Select this Stock?") != 6 &&Not yes
		*!*			lReturnNow = .T. &&RETURN
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF CTOD(StockLst_SQL.cInvCheck) = CTOD('1900-01-01 00:00:00.000')
		*!*		IF MESSAGEBOX("CAUTION! Item is missing!"+CHR(10)+"Make sure an Inventory Check is done ASAP."+CHR(13)+"Do you still want to select?",4+64,"Select this Stock?") != 6 &&Not yes
		*!*			lReturnNow = .T. &&RETURN
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*Check SOitem cancelled
		*!*	PRIVATE cSOitem, nWO
		*!*	cSOitem = PrepareSQLtxt(ThisForm.pSOItem,'SOitem',10)
		*!*	ThisForm.pSOItem = cSOitem
		*!*	nWO			= PrepareSQLnum(ThisForm.nWO,'WO',-3)
		*!*	ThisForm.nWO = nWO
		
		*!*	IF Proper_SO_Item(cSOitem) <> Proper_SO_Item('')
		*!*		IF Count_SOIteminSales(cSOItem, ThisForm.nConnHandle, "CANCEL") > 0
		*!*			MESSAGEBOX("CAUTION! SO Item is Cancelled!"+CHR(13)+cSOItem,16,"SOitem select this Stock?") 
		*!*			TrackError("SOitem '"+cSOItem+"' is Cancelled. Cannot select this Stock","Cancel SOitem select this Stock?", PROGRAM(), LINENO(1))
		*!*			lReturnNow = .T. &&RETURN	
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF lReturnNow 
		*!*		RETURN
		*!*	ENDIF
		
		*!*	************************************************************
		
		*!*	PRIVATE nWO_2, nD_Detail_Process, lEditWO, nID_Detail_Process
		*!*	nWO_2 = 0
		*!*	nD_Detail_Process = 0
		*!*	lEditWO = .F.
		*!*	nID_Detail_Process = 0
		*!*	**Check For Duplicate or Process_ID = 'PartSelect'
		
		*!*	PRIVATE nReversePounds, nReverseQTY
		*!*	nReversePounds = 0
		*!*	nReverseQTY = 0
		
		*!*	PRIVATE cSQLp, nSQLEXEC
		
		*!*	cSQLp = "SELECT ID_Detail_Process, WO, Process_ID "
		*!*	cSQLp = cSQLp + ",QTY, Ordered_QTY, Pounds "
		*!*	DO CASE
		*!*	CASE cTBL = "S"
		*!*		cSQLp = cSQLp + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		*!*	CASE cTBL = "B"
		*!*		cSQLp = cSQLp + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		*!*	CASE cTBL = "W"
		*!*		cSQLp = cSQLp + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
		*!*	OTHERWISE
		*!*		MESSAGEBOX("cmdMark.Click() did not recognize Table Name",0+16,"Abort Mark.Click!")
		*!*		TrackError("cmdMark.Click() did not recognize Table Name","Mark.Click did not recognize Table Name '"+cTBL+"'.","frmShop_StockLst_Edit.Mark.Click",LINENO(1))
		*!*		RETURN .F.
		*!*	ENDCASE
		
		*!*	cSQLp = cSQLp + " WHERE ID_Detail ="+STR(StockLst_SQL.ID_Detail)
		
		*!*	IF nWO > 0
		*!*		IF Proper_SO_Item(cSOItem) = Proper_SO_Item('')
		*!*			*Ignore the SOitem
		*!*			cSQLp = cSQLp + " AND WO="+STR(nWO)
		*!*		ELSE
		*!*			cSQLp = cSQLp + " AND ( WO="+STR(nWO)+" OR SOitem = dbo.f_ProperSOitem('"+cSOItem+"')" +" )"
		*!*		ENDIF
		*!*	ELSE
		*!*		cSQLp = cSQLp + " AND SOitem = dbo.f_ProperSOitem('"+cSOItem+"')" 
		*!*	ENDIF
		*!*	cSQLp = cSQLp + " AND Process_ID = 'SELECTED  ' "
		*!*	*cSQLp = cSQLp + " AND Process_ID != 'PARTSELECT'"	&&Need TO CONFIRM THE USE OF THIS
		
		*!*	IF USED("tmpProcess_cnt")
		*!*		SELECT tmpProcess_cnt
		*!*	ELSE
		*!*		SELECT 0
		*!*	ENDIF
		
		*!*	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLp, 'tmpProcess_cnt')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLp, 'tmpProcess_cnt')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		IF NOT SQLEXECError(cSQLp,ThisForm.nConnHandle,nSQLEXEC, 'tmpProcess_cnt')
		*!*			lOK = .F.
		*!*			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLp )
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF lOK
		*!*		IF tmpProcess_cnt.ID_Detail_Process > 0
		*!*			nID_Detail_Process = PrepareSQLnum(tmpProcess_cnt.ID_Detail_Process,'tmpProcess_cnt',-3)
		*!*			*Found ( SOitem OR WO ) and ID_Detail
		*!*			PRIVATE nMessA, cMess 
		*!*			nMessA = 0
		*!*			
		*!*			IF nWO > 0
		*!*				*Check as WO!
		*!*				nWO_2 = PrepareSQLnum(tmpProcess_cnt.WO,'WO',-3)
		*!*				IF nWO_2 > 0
		*!*					IF nWO_2 = nWO
		*!*						cMess = "Already marked!"+CHR(13)+"Answer 'NO' to remove this process from this item."+CHR(13)
		*!*						cMess = cMess + CHR(13)+"or 'Cancel' to not do nothing."
		*!*						cMess = cMess + TableName_TBL(cTBL)+" item for this WO/SalesOrder Item."
		*!*						
		*!*						nMessA = MESSAGEBOX(cMess,3,"You have already selected this!")
		*!*						IF nMessA = 7
		*!*							*remove
		*!*						ELSE
		*!*							nMessA = 2 && show as cancel
		*!*						ENDIF
		*!*					ELSE
		*!*						cMess = "Do you want to add this WO to this process to this "
		*!*						cMess = cMess + TableName_TBL(cTBL) +" Item?"+CHR(13)
		*!*						cMess = cMess + "Answer 'NO' to remove the process from this item."+CHR(13)
		*!*						cMess = cMess + CHR(13)+"or 'Cancel' to not do nothing."
		
		*!*						nMessA = MESSAGEBOX(cMess,3,"You have already selected this.")
		*!*						
		*!*						IF nMessA = 6
		*!*							lEditWO = .T.	&&EditWO
		*!*						ELSE
		*!*							*Delete or Abort
		*!*							lEditWO = .F.  &&AddWO
		*!*						ENDIF
		*!*					ENDIF
		*!*				ELSE
		*!*					*Have WO and not in process!
		*!*					cMess = "Do you want to add this WO to this process to this "
		*!*					cMess = cMess + TableName_TBL(cTBL)+" Item?"+CHR(13)
		*!*					cMess = cMess + "Answer 'NO' to remove the process from this item."+CHR(13)
		*!*					cMess = cMess + CHR(13)+"or 'Cancel' to not do nothing."
		
		*!*					nMessA = MESSAGEBOX(cMess,3+32,"Mark with WorkOrder")
		*!*					IF nMessA = 6
		*!*	*					lEditWO = .F. &&AddWO
		*!*						lEditWO = .T.	&&EditWO
		*!*			*		ELSE
		*!*			*			nMessA = 2
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			IF nMessA = 0
		*!*				cMess = "Do you want to add another 'SELECT' process to this "
		*!*				cMess = cMess + TableName_TBL(cTBL)+" Item?"+CHR(13)
		*!*				cMess = cMess + "Answer 'NO' to remove the process from this item."+CHR(13)
		*!*				cMess = cMess + CHR(13)+"or 'Cancel' to not do nothing."
		
		*!*				nMessA = MESSAGEBOX(cMess,3,"You have already selected this for this SalesOrder Item.")
		*!*			ENDIF
		*!*			
		*!*			IF nMessA = 7 && No
		*!*				*Remove Process
		*!*				*Get value to reverse (ItemCost) in dbo.Sales
		*!*				PRIVATE nReverseNum, nReverseQTY, nReversePounds, nReverseID_Detail, nReverseValue
		*!*				nReverseNum = 0
		*!*				nReverseQTY = 0
		*!*				nReversePounds=0
		*!*				nReverseID_Detail=0
		*!*				nReverseValue = 0
		*!*				
		*!*				IF USED('tmpSPtotal')
		*!*					USE IN tmpSPtotal
		*!*				ENDIF
		*!*				SELECT 0
		*!*				
		*!*				cSQL = "SELECT QTY, PU, Ordered_QTY, Pounds, ID_Detail "
		*!*				
		*!*				DO CASE
		*!*				CASE cTBL = "S"
		*!*					cSQL = cSQL + " FROM dbo.StockLst_Process WITH(NOLOCK) "
		*!*				CASE cTBL = "B"
		*!*					cSQL = cSQL + " FROM dbo.BrokerLst_Process WITH(NOLOCK) "
		*!*				CASE cTBL = "W"
		*!*					cSQL = cSQL + " FROM dbo.WIPLst_Process WITH(NOLOCK) "
		*!*				ENDCASE
		*!*		
		*!*				cSQL = cSQL + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		*!*				IF nWO > 0
		*!*					IF Proper_SO_item(cSOItem) = Proper_SO_Item('')
		*!*						cSQLp = cSQLp + " AND WO="+STR(nWO)
		*!*					ELSE
		*!*						cSQLp = cSQLp + " AND ( WO="+STR(nWO)+" OR SOitem = dbo.f_ProperSOitem('"+cSOItem+"')" +" )"
		*!*					ENDIF
		*!*				ELSE
		*!*					IF cSOItem <> Proper_SO_item('')
		*!*						cSQL = cSQL + " AND SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
		*!*					ENDIF
		*!*				ENDIF
		*!*				cSQL = cSQL + " AND (Process_ID = 'SELECTED' OR Process_ID = 'PARTSELECT' OR Process_ID = 'QUOTED' ) "
		
		*!*				
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSPtotal')
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSPtotal' )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0
		*!*					IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSPtotal')
		*!*						lOK = .F.
		*!*						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*					ENDIF
		*!*				ENDIF
		*!*				
		*!*				IF USED('tmpSPtotal')
		*!*					IF VARTYPE(tmpSPtotal.ID_Detail) = "N"
		*!*						nReverseQTY		= tmpSPtotal.QTY		&&ERP Acct Standard QTY for Process
		*!*						nReversePounds	= tmpSPtotal.Pounds
		*!*						nReverseID_Detail = tmpSPtotal.ID_Detail 
		*!*					ENDIF
		*!*					USE IN tmpSPtotal
		*!*				ENDIF
		*!*				
		*!*				IF nReverseID_Detail > 0
		*!*					*Get StockLst Process Value to reverse
		*!*				
		*!*					IF USED('tmpSDValue')
		*!*						USE IN tmpSDValue
		*!*					ENDIF
		*!*					SELECT 0
		*!*					
		*!*					cSQL = "SELECT S_P, InvoiceValue "
		*!*					DO CASE
		*!*					CASE cTBL = "S"
		*!*						cSQL = cSQL + " FROM dbo.StockLst_Detail WITH(NOLOCK) "
		*!*					CASE cTBL = "B"
		*!*						cSQL = cSQL + " FROM dbo.BrokerLst_Detail WITH(NOLOCK) "
		*!*					CASE cTBL = "W"
		*!*						cSQL = cSQL + " FROM dbo.WIPLst_Detail WITH(NOLOCK) "
		*!*					ENDCASE
		*!*					cSQL = cSQL + " WHERE ID_Detail = "+STR(nReverseID_Detail)
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSDValue')
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSDValue' )
		*!*					ENDDO
		*!*					IF nSQLEXEC < 0
		*!*						IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSDValue')
		*!*							lOK = .F.
		*!*							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*						ENDIF
		*!*					ENDIF
		*!*					
		*!*					IF USED('tmpSDValue')
		*!*						nReverseValue = PrepareSQLnum(tmpSDValue.S_P,'S_P',-5)
		*!*						IF nReverseValue = 0
		*!*							*Old School
		*!*							nReverseValue = PrepareSQLnum(tmpSDValue.InvoiceValue,'InvoiceValue',-5)
		*!*						ENDIF
		*!*						USE IN tmpSDValue
		*!*					ENDIF				
		*!*					
		*!*					IF lOK
		*!*						*Remove the Blue Background
		*!*						ThisForm.txtDimensions.BackColor = RGB( 192,192,192 )
		*!*						ThisForm.txtDimensions.DisabledBackColor = RGB( 192,192,192 )
		*!*					ENDIF	
		*!*				ENDIF
		*!*				
		*!*				*********************
		*!*				&&REMOVE Process
		*!*				PRIVATE cSQLd2
		*!*				
		*!*				cSQLd = "DELETE "
		*!*				cSQLd2 = "DELETE "
		*!*				DO CASE
		*!*				CASE cTBL = "S"
		*!*					cSQLd = cSQLd + " FROM dbo.StockLst_Process "
		*!*					cSQLd2 = cSQLd2 + " FROM dbo.rtr_Detail WHERE rtr_Detail.TBL='S' "
		*!*				CASE cTBL = "B"
		*!*					cSQLd = cSQLd + " FROM dbo.BrokerLst_Process "
		*!*					cSQLd2 = cSQLd2 + " FROM dbo.rtr_Detail WHERE rtr_Detail.TBL='B' "
		*!*				CASE cTBL = "W"
		*!*					cSQLd = cSQLd + " FROM dbo.WIPLst_Process "
		*!*					cSQLd2 = cSQLd2 + " FROM dbo.rtr_Detail WHERE rtr_Detail.TBL='W' "
		*!*				ENDCASE
		*!*				cSQLd = cSQLd + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		*!*				cSQLd2 = cSQLd2 + " AND ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		*!*				
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd)
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0
		*!*					IF NOT SQLEXECError(cSQLd,ThisForm.nConnHandle,nSQLEXEC, '')
		*!*						lOK = .F.
		*!*						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLd )
		*!*					ENDIF
		*!*				ELSE
		*!*					WAIT WINDOW "DELETED Process from StockLst!" NOWAIT
		*!*				ENDIF
		*!*				
		*!*				*********************
		
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd2)
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd2)
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0
		*!*					IF NOT SQLEXECError(cSQLd2,ThisForm.nConnHandle,nSQLEXEC, '')
		*!*						lOK = .F.
		*!*						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLd2 )
		*!*					ENDIF
		*!*				ELSE
		*!*					*WAIT WINDOW "DELETED Select Material detail from RTR_Detail!" NOWAIT
		*!*				ENDIF
		*!*				
		*!*				*********************
		*!*				
		*!*				PRIVATE nTotalReverse, nItemCost, nNewTotal
		*!*				nTotalReverse = nReversePounds * nReverseValue 
		*!*				nItemCost = 0
		*!*				nNewTotal = 0
		*!*				IF nTotalReverse > 0 AND lOK
		*!*					*Get current total
		*!*					IF USED('tmpSitemcost')
		*!*						USE IN tmpSitemcost
		*!*					ENDIF
		*!*					SELECT 0
		*!*					
		*!*					cSQL = "SELECT S_Total, ItemCost FROM dbo.Sales WITH(NOLOCK) WHERE SOitem = '"+cSOItem+"'"
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSitemcost')
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSitemcost' )
		*!*					ENDDO
		*!*					IF nSQLEXEC < 0
		*!*						IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSitemcost')
		*!*							lOK = .F.
		*!*							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*						ENDIF
		*!*					ENDIF
		*!*					
		*!*					IF USED('tmpSitemcost')
		*!*						nS_Total = PrepareSQLnum(tmpSitemcost.S_Total,'Total',-5)
		*!*						nItemCost = PrepareSQLnum(tmpSitemcost.ItemCost,'ItemCost',-5)
		*!*						
		*!*						USE IN tmpSitemcost
		*!*					ENDIF				
		*!*					
		*!*					IF nItemCost > 0
		*!*						nNewTotal = nItemCost - nTotalReverse 
		*!*					ENDIF
		*!*				ENDIF
		*!*				
		*!*				IF nNewTotal > 0 AND lOK
		*!*					*cSOitem = ThisForm.pSOItem
		*!*					
		*!*					cSQLu = "UPDATE dbo.Sales SET ItemCost = "+STR(nNewTotal,18,4)
		*!*					cSQLu = cSQLu + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu)
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		*!*					ENDDO
		*!*					IF nSQLEXEC < 0
		*!*						IF NOT SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC, '')
		*!*							lOK = .F.
		*!*							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
		*!*						ENDIF
		*!*					ENDIF
		*!*					IF lOK
		*!*						PRIVATE nSO, cWhat, cComment
		*!*						nSO = VAL(cSOitem)
		*!*						cWhat = "Updated ItemCost"
		*!*						cComment = "User UnSelected a process."+" SOitem '"+cSOitem+"' TBL="+cTBL+" ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+" ReverseValue="+ALLTRIM(STR(nReverseValue))
		*!*						Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, ThisForm.nConnHandle)
		*!*						WAIT WINDOW "Removed Process from Order Cost!" NOWAIT
		*!*					ENDIF
		*!*				ENDIF
		*!*				
		*!*				***************************
		*!*				RETURN
		*!*				***************************
		*!*			ENDIF
		*!*			IF nMessA = 2 && Cancel
		*!*				***************************
		*!*				RETURN		
		*!*				***************************
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		IF USED("tmpProcess_cnt")
		*!*			USE IN tmpProcess_cnt
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	***************************************************
		*!*	PRIVATE lAlwaysOnTop
		*!*	lAlwaysOnTop = ThisForm.AlwaysOnTop 
		*!*	IF lAlwaysOnTop
		*!*		ThisForm.AlwaysOnTop = .F.
		*!*	ENDIF
		
		*!*	PRIVATE cPOitem
		*!*	DO CASE
		*!*	CASE cTBL = "S"
		*!*		cPOitem 	= ThisForm.pPOitem
		*!*	CASE cTBL = "B"
		*!*		cPOitem		= ThisForm.pPOitem	&&Only the PO of a Broker is important.
		*!*	CASE cTBL = "W"
		*!*		cPOitem		= ThisForm.pPOitem	&& SEL_WO will call getWorkOrder_POitem
		*!*	OTHERWISE
		*!*		TrackError("Did not get a TBL parameter","cTBL:"+cTBL,"StockLst_Process:cmdMark.Click ",LINENO(1))
		*!*		cPOitem = ThisForm.pPOitem
		*!*	ENDCASE
		
		*!*	PRIVATE cComment, nID_Detail, nStoreID_Detail 
		*!*	cComment	= ALLTRIM(ThisForm.lblSz1.Caption)
		*!*	nID_Detail	= PrepareSQLnum(StockLst_SQL.ID_Detail,'ID_Detail',-3)
		*!*	nStoreID_Detail = nID_Detail
		
		*!*	PRIVATE cSalesP, nSalesNum
		*!*	cSalesP = ThisForm.pSalesP
		*!*	nSalesNum = ThisForm.pSalesNum 
		*!*	PRIVATE cWhat
		*!*	cWhat = "ADD_SOLD"
		
		*!*	*ThisForm.pFunction
		*!*	************************************************************************************************************
		*!*	IF ThisForm.pFunction = "SEL_WO"
		*!*		*ThisForm.cmdMark.Caption = "Mark Stock for this WorkOrder"
		*!*		
		*!*		IF lEditWO
		*!*			cWhat = "EDIT_WO"
		*!*			nID_D_P = nID_Detail_Process
		*!*		ELSE
		*!*			cWhat = "ADD_WO"
		*!*		ENDIF
		
		*!*		cSalesP = '9'
		*!*		cComment = "WorkOrder:"+ALLTRIM(STR(nWO))+" to Convert: "+cComment
		*!*		IF Proper_PO_item(cPOitem) = Proper_PO_item("")
		*!*			cPOitem = getWorkOrder_POitem( nWO, ThisForm.nConnhandle ) 
		*!*			ThisForm.pPOitem = PrepareSQLtxt(cPOitem,'POitem',12)
		*!*		ELSE
		*!*			*Using POitem passed in.
		*!*			*cPOitem = ThisForm.pPOitem 
		*!*		ENDIF
		*!*		
		*!*		IF nWO > 0
		*!*					
		*!*			IF USED("tmpWOSel")
		*!*				SELECT tmpWOSel
		*!*			ELSE
		*!*				SELECT 0
		*!*			ENDIF
		*!*			
		*!*			cSQL = "SELECT sWeight "
		*!*			cSQL = cSQL+",SalesRep,StartDate "
		*!*			cSQL = cSQL+",DueDate "
		*!*			cSQL = cSQL+" FROM dbo.WorkOrder WITH(NOLOCK) "
		*!*			cSQL = cSQL+" WHERE WO="+STR(nWO)
		*!*			
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWOSel')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWOSel')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0
		*!*				IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpWOSel')
		*!*					lOK = .F.
		*!*					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*				ENDIF
		*!*			ENDIF
		*!*			IF lOK
		*!*				IF USED('tmpWOSel')
		*!*					IF RECCOUNT('tmpWOSel') > 0
		*!*						cSalesRep			= PrepareSQLtxt(tmpWOSel.SalesRep,'SalesRep',20)
		*!*						cSalesP 			= AppSetup_Get_SalesP(cSalesRep)
		*!*						ThisForm.pSalesDate	= PrepareSQLDate(tmpWOSel.StartDate,'StartDate')
		*!*						ThisForm.pWeight	= PrepareSQLnum(tmpWOSel.sWeight,'Weight',9,1)
		*!*						ThisForm.pQTY		= PrepareSQLnum(tmpWOSel.sWeight,'Weight',9,1)
		*!*						ThisForm.pShipDue	= PrepareSQLDate(tmpWOSel.DueDate,'DueDate')
		*!*					ENDIF
		*!*					USE IN tmpWOSel
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		
		*!*	ENDIF
		
		*!*	*ThisForm.pFunction************************************************************************************************************
		
		*!*	IF ThisForm.pFunction = "SELECT"
		*!*		*ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
		*!*		
		*!*		IF Proper_SO_Item(cSOItem) != Proper_SO_Item('')
		*!*			cWhat = "ADD_SOLD"
		*!*			
		*!*			IF USED("tmpSEL")
		*!*				SELECT tmpSEL
		*!*			ELSE
		*!*				SELECT 0
		*!*			ENDIF
		*!*			
		*!*			cSQL = "SELECT AQ.Weight "
		*!*			cSQL = cSQL+",AQ.SalesP,AQ.SaleDate,AQ.Q_QTY "
		*!*			cSQL = cSQL+",S.ShipDue "
		*!*			cSQL = cSQL+" FROM dbo.AllQuotes AQ WITH(NOLOCK) "
		*!*			cSQL = cSQL+" LEFT OUTER JOIN dbo.StartingStock SS WITH(NOLOCK) ON AQ.ID = SS.AllQuotes_ID "
		*!*			cSQL = cSQL+" INNER JOIN dbo.Sales S WITH(NOLOCK) ON S.SOitem = AQ.SOitem "
		*!*			cSQL = cSQL+" WHERE AQ.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
		*!*		
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0
		*!*				IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSEL')
		*!*					lOK = .F.
		*!*					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*				ENDIF
		*!*			ENDIF
		*!*			IF lOK
		*!*				IF USED('tmpSEL')
		*!*					IF RECCOUNT('tmpSEL') > 0
		*!*						cSalesP				= PrepareSQLtxt(tmpSEL.SalesP,'SalesP',1)
		*!*						ThisForm.pSalesDate	= PrepareSQLDate(tmpSEL.SaleDate,'SaleDate')
		*!*						ThisForm.pWeight	= PrepareSQLnum(tmpSEL.Weight,'Weight',9,1)
		*!*						ThisForm.pQTY		= PrepareSQLnum(tmpSEL.Q_QTY,'Q_QTY',-5)
		*!*						ThisForm.pShipDue	= PrepareSQLDate(tmpSEL.ShipDue,'ShipDue')
		*!*					ENDIF
		*!*					USE IN tmpSEL
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*******************************
		*!*	*ThisForm.cInqNumP 
		*!*	IF ThisForm.pFunction == "BROWSE" AND LEN(ALLTRIM(ThisForm.cInqNumP)) > 2
		*!*		*ThisForm.cmdMark.Caption = "Mark as hold for Quote"
		*!*		
		*!*		cWhat = "QUOTE"
		*!*			
		*!*		IF USED("tmpSEL")
		*!*			SELECT tmpSEL
		*!*		ELSE
		*!*			SELECT 0
		*!*		ENDIF
		*!*		
		*!*		cSQL = "SELECT AQ.Weight "
		*!*		cSQL = cSQL+",AQ.SalesP"
		*!*		cSQL = cSQL+",GetDate() AS SaleDate "
		*!*		cSQL = cSQL+",AQ.Q_QTY "
		*!*		cSQL = cSQL+",GetDate()+1 AS ShipDue "
		*!*		cSQL = cSQL+" FROM dbo.AllQuotes AQ WITH(NOLOCK) "
		*!*		cSQL = cSQL+" LEFT OUTER JOIN dbo.StartingStock SS WITH(NOLOCK) ON AQ.ID = SS.AllQuotes_ID "
		*!*		cSQL = cSQL+" WHERE AQ.InqNumP = '"+Proper_InqNumP(ThisForm.cInqNumP)+"'"
		
		*!*		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL')
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL')
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSEL")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSEL")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF	
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSEL')
		*!*			lOK = .F.
		*!*		ELSE
		*!*			IF USED('tmpSEL')
		*!*				IF RECCOUNT('tmpSEL') > 0
		*!*					cSalesP				= PrepareSQLtxt(tmpSEL.SalesP,'SalesP',1)
		*!*					ThisForm.pSalesDate	= PrepareSQLDate(tmpSEL.SaleDate,'SaleDate')
		*!*					ThisForm.pWeight	= PrepareSQLnum(tmpSEL.Weight,'Weight',9,1)
		*!*					ThisForm.pQTY		= PrepareSQLnum(tmpSEL.Q_QTY,'Q_QTY',-5)
		*!*					ThisForm.pShipDue	= PrepareSQLDate(tmpSEL.ShipDue,'ShipDue')
		*!*	*				ThisForm.pSOItem	= ''
		*!*					cInqNumP		= Proper_InqNumP(ThisForm.cInqNumP)
		*!*				ENDIF
		*!*				USE IN tmpSEL
		*!*			ENDIF
		*!*		ENDIF
		
		*!*	ENDIF
		
		*!*	*ThisForm.pFunction************************************************************************************************************
		
		*!*	IF ThisForm.pFunction = "SEL_SS"
		*!*		*ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
		*!*		
		*!*		IF Proper_SO_Item(cSOItem) != Proper_SO_Item('')
		*!*			*ThisForm.cmdMark.Caption = "Mark current Stock for this Order"
		*!*			cWhat = "ADD_SOLD"
		*!*			
		*!*			IF USED("tmpSEL_SS")
		*!*				SELECT tmpSEL_SS
		*!*			ELSE
		*!*				SELECT 0
		*!*			ENDIF
		*!*			
		*!*			cSQL = "SELECT SS.Weight "
		*!*			cSQL = cSQL+",AQ.SalesP,AQ.SaleDate"  &&, AQ.Q_QTY, AQ.S_QTY "
		*!*			cSQL = cSQL+",S.ShipDue "
		*!*			cSQL = cSQL+",S.S_PU, S.S_QTY, S.S_P, S.S_Total "
		*!*			cSQL = cSQL+" FROM dbo.StartingStock SS WITH(NOLOCK) "
		*!*			cSQL = cSQL+" INNER JOIN dbo.Sales S WITH(NOLOCK) ON s.SOitem = SS.SOitem "
		*!*			cSQL = cSQL+" INNER JOIN dbo.AllQuotes AQ WITH(NOLOCK) ON AQ.ID = SS.AllQuotes_ID "
		*!*			cSQL = cSQL+" WHERE SS.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
		*!*			
		*!*			
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL_SS')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSEL_SS')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0
		*!*				IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSEL_SS')
		*!*					lOK = .F.
		*!*					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*				ENDIF
		*!*			ENDIF
		*!*			IF lOK
		*!*				IF USED('tmpSEL_SS')
		*!*					IF RECCOUNT('tmpSEL_SS') > 0
		*!*						cSalesP				= PrepareSQLtxt(tmpSEL_SS.SalesP,'SalesP',1)
		*!*						ThisForm.pSalesDate	= PrepareSQLDate(tmpSEL_SS.SaleDate,'SaleDate')
		*!*						ThisForm.pWeight	= PrepareSQLnum(tmpSEL_SS.Weight,'Weight',9,1)
		*!*						
		*!*						nAQ_QTY = PrepareSQLnum(tmpSEL_SS.S_QTY,'S_QTY',-5)		&&Acct QTY from Quotes
		*!*						nSO_QTY = PrepareSQLnum(tmpSEL_SS.S_QTY,'QTY',-5)	&&Acct QTY from Sales
		*!*						
		*!*						*nQ_QTY	= PrepareSQLnum(tmpSEL_SS.Q_QTY,'Q_QTY',-5)	&&Customer QTY
		*!*						ThisForm.pQTY		= IIF(nSO_QTY> 0, nSO_QTY, nAQ_QTY )
		*!*						
		*!*						ThisForm.pShipDue	= PrepareSQLDate(tmpSEL_SS.ShipDue,'ShipDue')
		*!*					ENDIF
		*!*					USE IN tmpSEL_SS
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*ThisForm.pFunction************************************************************************************************************
		
		*!*	IF ThisForm.pFunction = "Browse_ID_Detail"
		*!*		ThisForm.nReturnID_Detail = StockLst_SQL.ID_Detail
		*!*	ENDIF
		
		*!*	***************************
		
		*!*	DO FORM Forms\StockLst_Process WITH cWhat, nID_Detail_Process, cSOItem, cSalesP, ThisForm.pSalesDate,ThisForm.pWeight,ThisForm.pQTY,PrepareSQLtxt(cComment,'Comment',-1),ThisForm.pShipDue,cTBL, cPOitem, nWO, nID_Detail, ThisForm.cInqNumP TO nID_Detail_Process
		*!*	*PARAMTER                         cWhatDo, pID_D_P           , pSOItem, pSalesP,          pSalesDate,            pLBS,         pQTY,                            pComment,         pShipDue,      pLst, pPoItem, pWO, pID_Detail         , pInqNumP
		*!*	*PARAMETER cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue,'StockLst',nWO
		
		*!*	IF lAlwaysOnTop
		*!*		ThisForm.AlwaysOnTop = .T.
		*!*	ENDIF
		
		
		*!*	IF TYPE("nID_Detail_Process") = "N"
		*!*		IF nID_Detail_Process > 0
		*!*			
		*!*			ThisForm.nReturnID_Detail = nID_Detail_Process
		*!*			PRIVATE nCostValue
		*!*			nCostValue = PrepareSQLnum(StockLst_SQL.CostValue,'CostValue',10,2)
		*!*			ThisForm.nReturnPrice = nCostValue
		*!*			ThisForm.lblCost.Caption = "$"+ALLTRIM(STR(nCostValue,10,2))
		*!*			
		*!*			nStoreID_Detail = StockLst_SQL.ID_Detail
		*!*			cAlloy = StockLst_SQL.Alloy
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF ThisForm.pFunction = "SEL_WO" AND nID_Detail_Process > 0
		*!*		
		*!*		SELECT 0
		*!*		cSQL = "UPDATE dbo.WorkOrder "
		*!*		cSQL = cSQL+" SET lPrc_Stock = 1 "
		*!*		cSQL = cSQL+",TBL = '"+cTBL+"'"
		*!*		cSQL = cSQL+",sID_Detail ="+STR(nStoreID_Detail)
		*!*		cSQL = cSQL+",sID_Detail_Process ="+STR(nID_Detail_Process)
		*!*		*cSQL = cSQL+",Heat
		*!*		*cSQL = cSQL+",Lot
		*!*		cSQL = cSQL+" WHERE WO="+STR(nWO)
		
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0
		*!*			IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
		*!*				*lOK = .F.
		*!*				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		*ThisForm.Release	&&Does not take effect till end of Click routine
		*!*		*Do not Release: Let user see the hilighted row and choose return when ready.
		*!*		
		*!*	ENDIF
		
		*!*	ThisForm.grdStockLst.RecordSource = ""
		*!*	ThisForm.Load_StockLst_SQL(cTBL)
		*!*	ThisForm.grdStockLst.RecordSource = "StockLst_SQL"
		
		*!*	SELECT StockLst_SQL 
		*!*	LOCATE FOR StockLst_SQL.ID_Detail = nStoreID_Detail 
		
		*!*	ThisForm.ChangeStockLst()
		*!*	ThisForm.grdStockLst.Refresh
		
		*!*	PRIVATE lMarkBlue
		*!*	lMarkBlue = .F.
		
		*!*	IF PrepareSQLnum(StockLst_SQL.ID_Detail,'ID_Detail',-3) > 0
		*!*		IF Proper_SO_item(cSOitem) != Proper_SO_item('')
		*!*			IF Is_ID_Detail_SELECTED_SOitem(StockLst_SQL.ID_Detail, cSOitem, cTBL, ThisForm.nConnhandle )
		*!*				lMarkBlue = .T.
		*!*				WAIT WINDOW 'BLUE means this stock line is Selected for this Sales Order Item.' NOWAIT
		*!*			ENDIF
		*!*		ENDIF
		
		*!*		IF nWO > 0
		*!*			IF Is_ID_Detail_SELECTED_WO(StockLst_SQL.ID_Detail, nWO, cTBL, ThisForm.nConnhandle )
		*!*				WAIT WINDOW 'BLUE means this stock line is Selected for this Work Order.' NOWAIT
		*!*				lMarkBlue = .T.
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		IF LEN(ALLTRIM(ThisForm.cInqNumP)) > 2
		*!*			IF Is_ID_Detail_SELECTED_InqNumP(StockLst_SQL.ID_Detail, ThisForm.cInqNumP, cTBL, ThisForm.nConnhandle )
		*!*				WAIT WINDOW 'BLUE means this stock line is Selected for this Quote.' NOWAIT
		*!*				lMarkBlue = .T.
		*!*			ENDIF	
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF lMarkBlue
		*!*		ThisForm.txtDimensions.BackColor = RGB( 0,128,255 )  &&Blue
		*!*		ThisForm.txtDimensions.DisabledBackColor = RGB( 0,128,255 )
		*!*	ELSE
		*!*		ThisForm.txtDimensions.BackColor = RGB( 192,192,192 )
		*!*		ThisForm.txtDimensions.DisabledBackColor = RGB( 192,192,192 )
		*!*	ENDIF
		
		*!*	ThisForm.txtDimensions.Refresh
		
		*!*	Thisform.cmdDone.SetFocus()
		
		
		
		
		
	ENDPROC

	PROCEDURE cmdMasterEdit.Click
		PRIVATE nReturn
		nReturn = 0 &&ID
		
		IF EMPTY(StockLst_SQL.ID)
			MESSAGEBOX("Cannot Edit",0,"No record")
		ELSE
			IF StockLst_SQL.ID_Detail < 1
				MESSAGEBOX("Cannot Edit",0,"No record")
			ELSE	
				PRIVATE lAlwaysOnTop
				lAlwaysOnTop = ThisForm.AlwaysOnTop 
				IF lAlwaysOnTop
					ThisForm.AlwaysOnTop = .F.
				ENDIF
				DO FORM Forms\StockLst_Master WITH "EDIT", StockLst_SQL.ID,'StockLst' TO nReturn
				IF lAlwaysOnTop
					ThisForm.AlwaysOnTop = .T.
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdNextItem.Click
		ThisForm.GetSOitem(1)
	ENDPROC

	PROCEDURE cmdPrcHist.Click
		IF ThisForm.cTBL = "S"
		
			PRIVATE lAlwaysOnTop
			lAlwaysOnTop = ThisForm.AlwaysOnTop 
			IF lAlwaysOnTop
				ThisForm.AlwaysOnTop = .F.
			ENDIF
			DO FORM Forms\StockLst_History.scx WITH 'S', StockLst_SQL.ID, StockLst_SQL.ID_Detail
			*DO FORM Forms\ProcessHistory WITH 'S', StockLst_SQL.ID,StockLst_SQL.ID_Detail, ThisForm.cTBL
			IF lAlwaysOnTop
				ThisForm.AlwaysOnTop = .F.
			ENDIF
		ELSE
			MESSAGEBOX("History Only available on Stock",0,"Not Stock")
		ENDIF
	ENDPROC

	PROCEDURE cmdPrevItem.Click
		ThisForm.GetSOitem(-1)
	ENDPROC

	PROCEDURE cmdRefresh.Click
		*ThisForm.nReturnPrice = -1
		*MESSAGEBOX(StockLst_SQL.Heat+" "+IIF(StockLst_SQL.Heat = 'A14112' OR StockLst_SQL.Heat = 'A13940' OR StockLst_SQL.Heat = 'A13939',"True","False"),0,'')
		PRIVATE nID
		nID = StockLst_SQL.ID
		ThisForm.Load_StockLst_SQL(ThisForm.cTBL)
		IF nID > 0
			LOCATE FOR ID= nID
			IF FOUND()
				ThisForm.grdStockLst.Refresh
			ELSE
				ThisForm.ChangeStockLst()
			ENDIF
		ELSE
			ThisForm.ChangeStockLst()
		ENDIF
		
	ENDPROC

	PROCEDURE cmdResearch.Click
		PRIVATE cAlloy,cForm,cCC,cThck,loIE
		cAlloy	= PrepareSQLtxt(StockLst_SQL.Alloy,'Alloy',12)
		cForm	= PrepareSQLtxt(StockLst_SQL.Form,'Form',2)
		cCC		= PrepareSQLtxt(StockLst_SQL.CC,'CC',1)
		nThck	= PrepareSQLnum(StockLst_SQL.Size,'Thck',10,4)
		cThck   = ALLTRIM( Remove0(nThck,9,4,.F.) )
		
		SELECT StockLst_SQL
		
		PRIVATE loIE
		IF NOT EMPTY(cAlloy)
		
			loIE = Createobject("internetexplorer.application")
			loIE.Visible = .T.
			
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
				
			loIE.Navigate(get_Report_Server()+"%2fInventory%2fResearch+Item&rs:Command=Render&Alloy="+ALLTRIM(cAlloy)+"&Form="+cForm+"&CC="+cCC+"&Thck="+cThck )
		ENDIF
	ENDPROC

	PROCEDURE cmdSearch.Click
		SELECT StockLst_SQL
		ThisForm.Search('')
		This.Visible = .F.
	ENDPROC

	PROCEDURE cmdsearchHeat.Click
		PRIVATE cHeat
		cHeat = ALLTRIM(PrepareSQLtxt(ThisForm.txtSearchHeat.Value,'Heat',50))
		SELECT Stocklst_SQL
		
		PRIVATE nCurRec
		nCurRec = RECNO('Stocklst_SQL')
		
		PRIVATE nBColor
		nBColor = This.BackColor
		IF nBColor != RGB(240,240,240)	&&GRAY
			*Reset Filter
			ThisForm.txtSearchHeat.Value = ''
			SET FILTER TO
			
			ThisForm.cmdSearchPO.BackColor = RGB(240,240,240)
			*ThisForm.cmdSearchHeat.BackColor = RGB(240,240,240)
			This.BackColor = RGB(240,240,240)
			ThisForm.cmdSearchLot.BackColor = RGB(240,240,240)
			
			IF ThisForm.chkCCCL.Value = 0
				*Do not use CCCL
				SET ORDER TO TAG AlFmSzHL
				ThisForm.txtIndex.Value = 'AlFmSzHL'
			ELSE
				SET ORDER TO TAG A_CCCLHL
				ThisForm.txtIndex.Value = 'A_CCCLHL'
			ENDIF
			
			ThisForm.grdStockLst.Refresh
			ThisForm.grdStockLst.SetFocus()
		
			RETURN .T.
		ENDIF
		
		***********************
		IF EMPTY(cHeat)
			RETURN
		ENDIF
		***********************
		
		PRIVATE cAlloy
		cAlloy	= PrepareSQLtxt(ThisForm.pAlloy,'Alloy',12,.T.)
		
		*IF EMPTY(cAlloy)
			*No Parameters!
			SELECT StockLst_SQL 
			LOCATE FOR LIKE(cHeat+"*",Heat)
			IF FOUND()
				SET ORDER TO TAG Heat
				ThisForm.txtIndex.Value = 'Heat'
				This.BackColor = RGB(250,0,0)
				
		*		SET FILTER TO LIKE(cHeat+"*",Heat)
				ThisForm.grdStockLst.Refresh
				ThisForm.grdStockLst.SetFocus()
				
			ELSE
				*WAIT WINDOW "Heat Not Found" NOWAIT
				MESSAGEBOX( "Heat "+cHeat+" Not Found",0,"Not Found")
				SELECT StockLst_SQL 
				SET ORDER TO TAG Heat
				ThisForm.txtIndex.Value = 'Heat'
				This.BackColor = RGB(250,0,0)
				
				IF nCurRec <= RECCOUNT('Stocklst_SQL')
					GOTO nCurRec
				ELSE
					GO BOTTOM
				ENDIF
			ENDIF	
			
			RETURN
		*ENDIF
		
		************************************
		*have parameters
		
		PRIVATE nFormSort, cFormSort, cForm, nThck, nThckMinus, nThckplus, cCC, cCL
		nFormSort = GetFormSort(ThisForm.pForm, ThisForm.nConnHandle)
		cFormSort = ALLTRIM(STR(nFormSort))
		cForm	= PrepareSQLtxt(nFormSort,'nFormSort',2,.T.)
		nThck	= PrepareSQLnum(Thisform.pThck,'Thck',9,3)
		cCC		= PrepareSQLtxt(ThisForm.pCC,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.pCL,'CL',1)
		
		PRIVATE cCCSort, cCCCL
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL = CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		
		*cAlloy	= PrepareSQLtxt(Stocklst_SQL.Alloy,'Alloy',12,.T.)
		*nFormSort = GetFormSort(Stocklst_SQL.Form, ThisForm.nConnHandle)
		*cForm	= PrepareSQLtxt(nFormSort,'nFormSort',2,.T.)
		*nThck	= PrepareSQLnum(Stocklst_SQL.Size,'Thck',9,3)
		*cCC		= PrepareSQLtxt(Stocklst_SQL.CC,'CC',1)
		*cCL		= PrepareSQLtxt(Stocklst_SQL.CL,'CL',1)
		
		PRIVATE lFoundHeat
		lFoundHeat = .F.
		SELECT StockLst_SQL 
		SET ORDER TO TAG Heat
		ThisForm.txtIndex.Value = 'Heat'
		This.BackColor = RGB(250,0,0)
		*SEEK cHeat IN StockLst_SQL ORDER HEAT
		LOCATE FOR LIKE(cHeat+'*',Heat)
		IF FOUND('Stocklst_SQL')
			lFoundHeat = .T.
		ENDIF
		
		IF NOT lFoundHeat 
			WAIT WINDOW "Heat Not Found" NOWAIT
			IF nCurRec <= RECCOUNT('Stocklst_SQL')
				GOTO nCurRec
			ELSE
				GO BOTTOM
			ENDIF
			
			RETURN
		ENDIF
		
		**************************************
		
		PRIVATE nBestItem 
		nBestItem = 0
		
		SELECT Stocklst_SQL
		IF !EMPTY(cAlloy) AND !EMPTY(cFormSort) AND !EMPTY(cCC) AND !EMPTY(nThck)
		
			*Find Alloy, Form, CCCL and Thickness
			SEEK cAlloy+cForm+cCCCL+STR(nThck,9,3) IN StockLst_SQL ORDER AlFmsCCLS 
			nBestItem = RECNO('StockLst_SQL')
			IF nBestItem > RECCOUNT('StockLst_SQL')
				
				SEEK cAlloy+cFormSort+cCCSort+cCCCL+STR(nThck,9,3) IN StockLst_SQL ORDER AlFmsCLsS  
				nBestItem = RECNO('StockLst_SQL')
				IF nBestItem > RECCOUNT('StockLst_SQL')
					*Check fraction over
					nThckplus = nThck+.001
					
					SEEK cAlloy+cFormSort+cCCCL+STR(nThckplus,9,3) IN StockLst_SQL ORDER AlFmsCCLS
					nBestItem = RECNO('StockLst_SQL')
					IF nBestItem > RECCOUNT('StockLst_SQL')
					
						SEEK cAlloy+cFormSort+cCCSort+cCCCL+STR(nThckplus,9,3) IN StockLst_SQL ORDER AlFmsCLsS  
						nBestItem =RECNO('StockLst_SQL')
						IF nBestItem > RECCOUNT('StockLst_SQL')
							*Check fraction under
							nThckMinus = nThck-.001
							
							SEEK cAlloy+cFormSort+cCCCL+STR(nThckplus,9,3) IN StockLst_SQL ORDER AlFmsCCLS
							nBestItem = RECNO('StockLst_SQL')
							
							IF nBestItem > RECCOUNT('StockLst_SQL')
								SEEK cAlloy+cFormSort+cCCSort+cCCCL+STR(nThckMinus,9,3) IN StockLst_SQL ORDER AlFmsCLsS  
								nBestItem =RECNO('StockLst_SQL')
		
								IF nBestItem > RECCOUNT('StockLst_SQL')
									*Check for Over
									nThckplus = nThck+.1
									
									SEEK cAlloy+cFormSort+cCCCL+STR(nThckplus,9,3) IN StockLst_SQL ORDER AlFmsCCLS
									nBestItem = RECNO('StockLst_SQL')
									
									IF nBestItem > RECCOUNT('Stocklst_SQL')
										SEEK cAlloy+cFormSort+cCCSort+cCCCL+STR(nThckplus,9,3) IN StockLst_SQL ORDER AlFmsCLsS  
										nBestItem = RECNO('StockLst_SQL')
										
										IF nBestItem > RECCOUNT('Stocklst_SQL')
											*Check for under
											nThckMinus = nThck-.1
											
											SEEK cAlloy+cFormSort+cCCCL+STR(nThckMinus,9,3) IN StockLst_SQL ORDER AlFmsCCLS
											nBestItem = RECNO('Stocklst_SQL')
											
											IF nBestItem > RECCOUNT('Stocklst_SQL')
												SEEK cAlloy+cFormSort+cCCSort+cCCCL+STR(nThckMinus,9,3) IN StockLst_SQL ORDER AlFmsCLsS  
												nBestItem = RECNO('Stocklst_SQL')
											ENDIF
										ENDIF	
									ENDIF
								ENDIF
							ENDIF
						ENDIF	
					ENDIF
				ENDIF
			ENDIF
		ELSE
			nBestItem = RECCOUNT('Stocklst_SQL')+1
		ENDIF
		
		**************************
		IF nBestItem < RECCOUNT('Stocklst_SQL')
			*Found a match
			
				SELECT Stocklst_SQL
				LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC and Size=nThck AND UPPER(ALLTRIM(Heat)) = UPPER(ALLTRIM(cHeat))
				IF NOT FOUND('Stocklst_SQL')
					LOCATE FOR Alloy=cAlloy AND Form=cForm AND CCsort=cCCsort and Size=nThck AND UPPER(ALLTRIM(Heat)) = UPPER(ALLTRIM(cHeat))
				ENDIF
				IF NOT FOUND('Stocklst_SQL')
					LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC and Size=nThck AND UPPER(ALLTRIM(Heat)) = UPPER(ALLTRIM(cHeat))
				ENDIF
				IF NOT FOUND('Stocklst_SQL')
					LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CCsort=cCCsort and Size=nThck AND UPPER(ALLTRIM(Heat)) = UPPER(ALLTRIM(cHeat))
				ENDIF
				
				IF FOUND('Stocklst_SQL')
					nBestItem =RECNO('Stocklst_SQL')
				ELSE
					GOTO nBestItem 
				ENDIF
		
		ENDIF
		
		ThisForm.grdStockLst.SetFocus()
		
		*************************
		*!*	LOCATE FOR LIKE(cHeat+'*',Heat)
		*!*	IF FOUND()
		*!*		nLastLocate = RECNO("StockLst_SQL")
		*!*		ThisForm.grdStockLst.Refresh
		*!*		ThisForm.grdStockLst.SetFocus()
		*!*	ELSE
		*!*		WAIT WINDOW "Heat Not Found" NOWAIT
		*!*		GOTO nCurRec
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE cmdSearchID.Click
		PRIVATE nID
		*nID = ThisForm.txtID_Master
		nID = PrepareSQLnum(ThisForm.txtSearchID.Value,'ID',-3)
		
		IF nID > 0
			SELECT Stocklst_SQL
		
			PRIVATE nCurRec
			nCurRec = RECNO('Stocklst_SQL')
		
			SELECT StockLst_SQL 
			LOCATE FOR ID = nID
			ThisForm.grdStockLst.Refresh
			ThisForm.grdStockLst.SetFocus()
				
		ELSE
			MESSAGEBOX("Bad ID to search",0,"No Search")
		ENDIF
		
		*Remove Back color
		ThisForm.cmdSearchPO.BackColor = RGB(240,240,240)
		ThisForm.cmdSearchHeat.BackColor = RGB(240,240,240)
		ThisForm.cmdSearchLot.BackColor = RGB(240,240,240)
		
		
		IF ThisForm.chkCCCL.Value = 0
			*Do not use CCCL
			SET ORDER TO TAG AlFmSzHL
			ThisForm.txtIndex.Value = 'AlFmSzHL'
		ELSE
			SET ORDER TO TAG A_CCCLHL
			ThisForm.txtIndex.Value = 'A_CCCLHL'
		ENDIF
	ENDPROC

	PROCEDURE cmdSearchLot.Click
		PRIVATE cLot
		cLot = UPPER(ALLTRIM(PrepareSQLtxt(ThisForm.txtSearchLot.Value,'Lot',10)))
		SELECT Stocklst_SQL
		
		PRIVATE nCurRec
		nCurRec = RECNO('Stocklst_SQL')
		
		PRIVATE nBColor
		nBColor = This.BackColor
		IF nBColor != RGB(240,240,240)
			*Reset Filter
			ThisForm.txtSearchLot.Value = ''
			SET FILTER TO
			
			This.BackColor = RGB(240,240,240)
			ThisForm.cmdSearchPO.BackColor = RGB(240,240,240)
			ThisForm.cmdSearchHeat.BackColor = RGB(240,240,240)
			*ThisForm.cmdSearchLot.BackColor = RGB(240,240,240)
			This.BackColor = RGB(240,240,240)
			
			IF ThisForm.chkCCCL.Value = 0
				*Do not use CCCL
				SET ORDER TO TAG AlFmSzHL
				ThisForm.txtIndex.Value = 'AlFmSzHL'
			ELSE
				SET ORDER TO TAG A_CCCLHL
				ThisForm.txtIndex.Value = 'A_CCCLHL'
			ENDIF
			
			ThisForm.grdStockLst.Refresh
			ThisForm.grdStockLst.SetFocus()
			
			RETURN .T.
		ENDIF
		
		***********************
		IF EMPTY(cLot)
			RETURN
		ENDIF
		***********************
		
		
		SELECT StockLst_SQL 
		LOCATE FOR LIKE("*"+cLot+"*",Lot)
		
		IF FOUND()
			SET ORDER TO TAG Lot
			ThisForm.txtIndex.Value = 'Lot'
			This.BackColor = RGB(250,0,0)
			
		*	SET FILTER TO LIKE("*"+cLot+"*",Lot)
			ThisForm.grdStockLst.Refresh
			ThisForm.grdStockLst.SetFocus()
			
		ELSE
			*WAIT WINDOW "Lot Not Found" NOWAIT
			MESSAGEBOX( "Lot "+cLot+" Not Found",0,"Not Found")
		*	SELECT StockLst_SQL 
		*	SET ORDER TO TAG Lot
		*	ThisForm.txtIndex.Value = 'Lot'
		*	This.BackColor = RGB(250,0,0)
				
			IF nCurRec <= RECCOUNT('Stocklst_SQL')
				GOTO nCurRec
			ELSE
				GO BOTTOM
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdSearchPO.Click
		PRIVATE nHPApo
		nHPApo = PrepareSQLnum(ThisForm.txtSearchPO.Value,'HPApo',-3)
		SELECT Stocklst_SQL
		
		PRIVATE nCurRec
		nCurRec = RECNO('Stocklst_SQL')
		
		PRIVATE nBColor
		nBColor = This.BackColor
		IF nBColor != RGB(240,240,240)
			*Reset Filter
			ThisForm.txtSearchPO.Value = ''
			SET FILTER TO
			
			*ThisForm.cmdSearchPO.BackColor = RGB(240,240,240)
			This.BackColor = RGB(240,240,240)
			ThisForm.cmdSearchHeat.BackColor = RGB(240,240,240)
			ThisForm.cmdSearchLot.BackColor = RGB(240,240,240)
			
			IF ThisForm.chkCCCL.Value = 0
				*Do not use CCCL
				SET ORDER TO TAG AlFmSzHL
				ThisForm.txtIndex.Value = 'AlFmSzHL'
			ELSE
				SET ORDER TO TAG A_CCCLHL
				ThisForm.txtIndex.Value = 'A_CCCLHL'
			ENDIF
			
			ThisForm.grdStockLst.Refresh
			ThisForm.grdStockLst.SetFocus()
			
			RETURN .T.
		ENDIF
		
		***********************
		IF nHPApo = 0
			RETURN
		ENDIF
		***********************
		
		
		SELECT StockLst_SQL 
		*LOCATE FOR Proper_PO_Item_PO(PO_item) = nHPApo 
		SEEK nHPApo IN StockLst_SQL ORDER HPAPO
		
		IF FOUND()
			SET ORDER TO TAG HPAPO
			ThisForm.txtIndex.Value = 'HPApo'
			This.BackColor = RGB(250,0,0)
			
		*	SET FILTER TO LIKE("*"+cLot+"*",Lot)
			ThisForm.grdStockLst.Refresh
			ThisForm.grdStockLst.SetFocus()
			
		ELSE
			MESSAGEBOX( "PO "+ALLTRIM(STR(nHPApo))+" Not Found",0,"Not Found")
		*	SELECT StockLst_SQL 
		*	SET ORDER TO TAG Lot
		*	ThisForm.txtIndex.Value = 'Lot'
		*	This.BackColor = RGB(250,0,0)
				
			IF nCurRec <= RECCOUNT('Stocklst_SQL')
				GOTO nCurRec
			ELSE
				GO BOTTOM
			ENDIF
			
		ENDIF
		
		
	ENDPROC

