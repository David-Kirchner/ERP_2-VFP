	PROCEDURE grdStockLst.clmLot.Text1.Click
		*Show Log
		
		PRIVATE cLot, cAlloy, cMachine
		cLot = PrepareSQLtxt(StockLst_SQL.lot,'Lot',11)
		cAlloy = PrepareSQLtxt(StockLst_SQL.Alloy,'Alloy',12)
		cLot = UPPER( ALLTRIM( cLot ))
		
		IF LEFT(cLot,4) = "HPA "
			cLot = RIGHT(cLot,LEN(cLot)-4)
		ENDIF
		IF LEFT(cLot,3) = "HPA"
			cLot = RIGHT(cLot,LEN(cLot)-3)
		ENDIF
		
		cMachine = ""
		
		DO CASE
		*Conversion_Log
		*Draw_Log
		CASE "HPAD" $ UPPER(cLot)
			cMachine = "D"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		CASE "D" $ UPPER(cLot)
			cMachine = "D"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("D",cLot)))
		*GFMLog
		CASE "HPAG" $ UPPER(cLot)
			cMachine = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		CASE "G" $ UPPER(cLot)
			cMachine = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("G",cLot)))
		*HT_Lot
		*LakeErie_log
		CASE "HPAL" $ UPPER(cLot)
			cMachine = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		CASE "L" $ UPPER(cLot)
			cMachine = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("L",cLot)))
		*Roll_log
		CASE "HPAR" $ UPPER(cLot)
			cMachine = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		CASE "R" $ UPPER(cLot)
			cMachine = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("R",cLot)))
			
		*Swage_log	
		CASE "HPAS" $ UPPER(cLot)
			cMachine = "S"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		CASE "S" $ UPPER(cLot)
			cMachine = "S"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("S",cLot)))
		*Wire_log
		CASE "HPAW" $ UPPER(cLot)
			cMachine = "W"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		CASE "W" $ UPPER(cLot)
			cMachine = "W"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("W",cLot)))
		OTHERWISE
			WAIT WINDOW "Nothing to Report on the Lot Click "+cLot TIMEOUT 1
		ENDCASE
		
		*!*	PRIVATE lAlwaysOnTop
		*!*	lAlwaysOnTop = ThisForm.AlwaysOnTop 
		*!*	IF lAlwaysOnTop
		*!*		ThisForm.AlwaysOnTop = .F.
		*!*	ENDIF
		
		nLOT = PrepareSQLnum(cLot,'Lot',-3)
		
		
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_MFG_Log(cMachine,nLot,.T.)
		
		IF NOT EMPTY(m.cHyperLink)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			WAIT WINDOW "Look for a Blinking Web page with this Report" NOWAIT
		ELSE
			WAIT WINDOW "No Report to display" NOWAIT
		ENDIF
		
		*!*	DO CASE
		*!*	CASE cMachine = "D"
		*!*		IF VAL(cLOT) > 0
		*!*			DO FORM FORMS\ShowvDraw_Log WITH nLot, cAlloy
		*!*		ENDIF
		*!*	CASE cMachine = "G"
		*!*		IF VAL(cLOT) > 0
		*!*			DO FORM FORMS\ShowvGFMLog WITH nLot, cAlloy
		*!*		ENDIF
		*!*		
		*!*	CASE cMachine = "H"
		*!*		IF VAL(cLOT) > 0
		*!*			DO FORM FORMS\showvHT_log.scx WITH nLot, cAlloy
		*!*		ENDIF
		
		*!*	CASE cMachine = "R"
		*!*		IF VAL(cLOT) > 0
		*!*			DO FORM FORMS\showvROLL_log.scx WITH nLot, cAlloy
		*!*		ENDIF
		*!*	CASE cMachine = "L"
		*!*		IF VAL(cLOT) > 0
		*!*			DO FORM FORMS\showvLake_log.scx WITH nLot, cAlloy
		*!*		ENDIF
		
		*!*	CASE cMachine = "S"
		*!*		IF VAL(cLOT) > 0
		*!*			DO FORM FORMS\showvSwage_log.scx WITH nLot, cAlloy
		*!*		ENDIF
		*!*	CASE cMachine = "W"
		*!*		IF VAL(cLOT) > 0
		*!*			DO FORM FORMS\showvWire_log.scx WITH nLot, cAlloy
		*!*		ENDIF
		
		*!*	ENDCASE
		
		*!*	IF lAlwaysOnTop
		*!*		ThisForm.AlwaysOnTop = .T.
		*!*	ENDIF
		
	ENDPROC

