	PROCEDURE lblNewDue.Click
		IF NOT ISNULL(StockLst_SQL.PO_item)
			IF !EMPTY(StockLst_SQL.PO_item)
				IF Proper_PO_item(StockLst_SQL.PO_item) <> Proper_PO_item('   0-00')
					IF Proper_PO_item(StockLst_SQL.PO_item) <> Proper_PO_item('   0-01')
						PRIVATE lAlwaysOnTop
						lAlwaysOnTop = ThisForm.AlwaysOnTop 
						IF lAlwaysOnTop
							ThisForm.AlwaysOnTop = .F.
						ENDIF
						DO FORM FORMS\SHOWPO WITH StockLst_SQL.PO_item
						IF lAlwaysOnTop
							ThisForm.AlwaysOnTop = .T.
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtExtra.DblClick
		PRIVATE lAlwaysOnTop
		lAlwaysOnTop = ThisForm.AlwaysOnTop 
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .F.
		ENDIF
		
		DO CASE
		CASE This.Value = "Vendor Stock"
		
			IF EMPTY(StockLst_SQL.ID)
				MESSAGEBOX("Cannot Edit",0,"No record")
			ELSE
				IF StockLst_SQL.ID < 1
					MESSAGEBOX("Cannot Edit",0,"No record")
				ELSE	
				
					DO FORM Forms\StockLst_Vendor_Edit WITH StockLst_SQL.ID
					IF lAlwaysOnTop
						ThisForm.AlwaysOnTop = .T.
					ENDIF
		
				ENDIF
			ENDIF
		*CASE This.Value = "Prc Against"
		CASE This.Value = "Process USING"
			IF StockLst_SQL.Prc > 0
				DO FORM Forms\ShowProcess WITH StockLst_SQL.ID_Detail, ThisForm.cTBL
				IF lAlwaysOnTop
					ThisForm.AlwaysOnTop = .T.
				ENDIF
		
			ENDIF
		*CASE This.Value = "Prc Against Late"
		CASE This.Value = "Prc CONSUMES"
			IF StockLst_SQL.Prc > 0
				DO FORM Forms\ShowProcess WITH StockLst_SQL.ID_Detail, ThisForm.cTBL
				IF lAlwaysOnTop
					ThisForm.AlwaysOnTop = .T.
				ENDIF
		
			ENDIF
		CASE This.Value = "eXcess Stck"
			DO FORM Forms\StockLst_Detail WITH 'EDIT', StockLst_SQL.ID, 0, 'StockLst',0
			IF lAlwaysOnTop
				ThisForm.AlwaysOnTop = .T.
			ENDIF
		OTHERWISE
			MESSAGEBOX("'"+This.Value+"' Does not have an Actionable event assigned",0,"Nothing to do")
		ENDCASE
	ENDPROC

