	PROCEDURE search
		PARAMETERS pHeat
		*ThisForm.Search('')
		
		SELECT Stocklst_SQL	&&Test where 'Stocklst_SQL' is lost!
		IF NOT USED('Stocklst_SQL')
			MESSAGEBOX("Lost the StockLst_SQL table."+CHR(13)+"Tell David",16,"Cannot search")
			RETURN .F.
		ENDIF
		
		PRIVATE nID_Detail
		IF Proper_SO_item(ThisForm.pSOitem) != Proper_SO_item('')
			cSOItem = Proper_SO_item(ThisForm.pSOitem)
			*nID_Detail = get_ID_Detail_with_SOitem(cSOitem, cTBL, "SELECTED", ThisForm.nConnHandle)
			nID_Detail = get_ID_Detail_with_SOitem(cSOitem, ThisForm.cTBL, "", ThisForm.nConnHandle)	
			SELECT Stocklst_SQL
			IF nID_Detail > 0
				SELECT Stocklst_SQL
				LOCATE FOR ID_Detail = nID_Detail
				
				IF FOUND('Stocklst_SQL')
					WAIT WINDOW 'Found Process' NOWAIT
					*ThisForm.grdStockLst.SetFocus()
					ThisForm.grdStockLst.Refresh
					
					IF ThisForm.nWO = 0
						WAIT WINDOW "Found SO item" TIMEOUT 1
						RETURN
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.nWO > 0
			nID_Detail = get_ID_Detail_with_WO(ThisForm.nWO, ThisForm.cTBL, ThisForm.nConnHandle)
			IF nID_Detail > 0
				SELECT Stocklst_SQL
				LOCATE FOR ID_Detail = nID_Detail
				
				IF FOUND('Stocklst_SQL')
					WAIT WINDOW 'Found Process' NOWAIT
					*ThisForm.grdStockLst.SetFocus()
					ThisForm.grdStockLst.Refresh
					WAIT WINDOW "Found Work Order" TIMEOUT 1
					RETURN
				ENDIF
			ENDIF
		ENDIF
		
		****************************************
		PRIVATE nBestItem, nThckplus, nThckMinus 
		PRIVATE cAlloy, nFormSort, cForm, nThck, cThck, cCC, cCL, cHeat, cLot
		cAlloy	= PrepareSQLtxt(ThisForm.pAlloy,'Alloy',12,.T.)
		nFormSort = GetFormSort(ThisForm.pForm, ThisForm.nConnHandle)
		cForm	= PrepareSQLtxt(nFormSort,'nFormSort',2,.T.)
		nThck	= PrepareSQLnum(ThisForm.pThck,'Thck',9,3)
		cThck	= STR(nThck,9,3)
		cCC		= PrepareSQLtxt(ThisForm.pCC,'CC',1)
		IF EMPTY(cCC)
			cCC	= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		ENDIF
		cCL		= PrepareSQLtxt(ThisForm.pCL,'CL',1)
		IF EMPTY(cCL)
			cCL	= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		ENDIF
		cHeat	= PrepareSQLtxt(pHeat,'Heat',50)
		cLOT = PrepareSQLtxt(StockLst_SQL.lot,'Lot',11)
		
		PRIVATE cFormSort, cCCSort, cCCCL, lCCCL
		cFormSort = ALLTRIM(STR(nFormSort,2,0))
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL = CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
		
		* dbo.f_CC_CLsort(M.CC, M.CL) AS CCCL
		**********************
		PRIVATE nBestItem 
		nBestItem = 0
		
		******************************************
		*HARD Search -include CC and CL
		IF ThisForm.lFirstTime
			
			*INDEX ON Alloy+STR(FormSort,2,0)+CCCL+STR(SIZE,9,3)  	   TAG AlFmsCCLS 
			*INDEX ON Alloy+Form+CCCL+STR(SIZE,9,3)   	  TAG AlFmCCsS 
			SET ORDER TO TAG AlFmCCsS 
			ThisForm.txtIndex.Value = 'AlFmCCsS'
			
			LOCATE FOR Alloy = cAlloy AND Form = cForm AND CC = cCC AND CL = cCL AND STR(SIZE,9,3)= cThck  
					
			IF FOUND('Stocklst_SQL')
				nBestItem = RECNO('StockLst_SQL')
			ELSE
			
				LOCATE FOR Alloy = cAlloy AND Form = cFormSort AND CC = cCC AND CL = cCL AND STR(SIZE,9,3)= cThck  
				
				IF FOUND('Stocklst_SQL')
					nBestItem = RECNO('StockLst_SQL')
				ELSE
						
					LOCATE FOR Alloy = cAlloy AND Form = cFormSort AND CC = cCC AND CL = cCL
					
					IF FOUND('Stocklst_SQL')
						nBestItem = RECNO('StockLst_SQL')
					ELSE		
					ENDIF
				ENDIF
			ENDIF
			
			ThisForm.Visible = .T.
			IF nBestItem > 0
				Thisform.cmbAlloy.Value = cAlloy
				Thisform.cmbForm.Value = cFormSort
				ThisForm.cmbCC.Value = cCC
				ThisForm.cmbCL.Value = cCL
				WAIT WINDOW STR(RECNO('Stocklst_SQL')) NOWAIT
				ThisForm.grdStockLst.Refresh
				ThisForm.grdStockLst.SetFocus
				WAIT WINDOW STR(RECNO('Stocklst_SQL')) NOWAIT
			ENDIF
		ENDIF
		
		*!*	******************************************
		*!*	*HARD Search -include CC and CL
		*!*	IF cHeat = "HARD" 
		*!*		cHeat  = ''
		*!*	*INDEX ON Alloy+STR(FormSort,2,0)+STR(SIZE,9,3) 			TAG AlFmsSz
		*!*	*INDEX ON Alloy+Form+STR(SIZE,9,3) 							TAG AlFmSize
		*!*	*INDEX ON Alloy+STR(FormSort,2,0)+CCsort+STR(SIZE,9,3) 	   	TAG AlFmsCCsS 
		*!*	*INDEX ON Alloy+STR(FormSort,2,0)+CCsort+CCCL+STR(SIZE,9,3) TAG AlFmsCLsS 
		*!*	*INDEX ON Alloy+STR(FormSort,2,0)+CCCL+STR(SIZE,9,3) 		TAG AlFmsCCLS 	
		*!*	*ThisForm.grdStockLst.SetFocus()
		
		*!*		*SET ORDER TO TAG AlFmsCCLS 
		*		ThisForm.txtIndex.Value = '
		*!*		SET ORDER TO TAG A_CCCLHL
		*!*		
		*!*		LOCATE FOR Alloy = cAlloy AND Form = cFormSort AND STR(SIZE,9,3)= cThck AND CC_CLsort(cCC,cCL,ThisForm.nConnHandle) = cCCCL 
		*!*				
		*!*		IF FOUND('Stocklst_SQL')
		*!*			nBestItem = RECNO('StockLst_SQL')
		*!*		ELSE
		*!*		
		*!*			LOCATE FOR Alloy = cAlloy AND Form = cFormSort AND STR(SIZE,9,3)= cThck AND CC = cCC AND CL = cCL
		*!*			
		*!*			IF FOUND('Stocklst_SQL')
		*!*				nBestItem = RECNO('StockLst_SQL')
		*!*			ELSE
		*!*					
		*!*				LOCATE FOR Alloy = cAlloy AND Form = cForm AND STR(SIZE,9,3)= cThck AND CC = cCC AND CL = cCL
		*!*				
		*!*				IF FOUND('Stocklst_SQL')
		*!*					nBestItem = RECNO('StockLst_SQL')
		*!*				ELSE		
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		ThisForm.Visible = .T.
		*!*		IF nBestItem > 0
		*!*			Thisform.cmbAlloy.Value = cAlloy
		*!*			Thisform.cmbForm.Value = cFormSort
		*!*			ThisForm.cmbCC.Value = cCC
		*!*			ThisForm.cmbCL.Value = cCL
		*!*			WAIT WINDOW STR(RECNO('Stocklst_SQL')) NOWAIT
		*!*			ThisForm.grdStockLst.Refresh
		*!*			ThisForm.grdStockLst.SetFocus
		*!*			WAIT WINDOW STR(RECNO('Stocklst_SQL')) NOWAIT
		*!*		ENDIF
		*!*	ENDIF
		
		******************************************************
		IF nBestItem = 0
			*SELECT Stocklst_SQL
			IF !EMPTY(cAlloy) AND !EMPTY(cFormSort) AND !EMPTY(cCCSort) AND !EMPTY(nThck)
				
				*Find Alloy, Form and Thickness
				SEEK cAlloy+cFormSort+STR(nThck,9,3) IN StockLst_SQL ORDER AlFmsSz
				
				IF FOUND('Stocklst_SQL')
					nBestItem = RECNO('StockLst_SQL')
				ELSE
				
					*Find Alloy, Form, CC and Thickness
					SEEK cAlloy+cFormSort+cCCCL+STR(SIZE,9,3) IN StockLst_SQL ORDER AlFmsCCLS
					*INDEX ON Alloy+STR(FormSort,2,0)+CCCL+STR(SIZE,9,3)   TAG AlFmsCCLS
		
					IF FOUND('Stocklst_SQL')
						nBestItem = RECNO('StockLst_SQL')
					ELSE
						*Find Alloy, FormSort, CCCLSort cCCCL and Thickness
						SEEK cAlloy+cFormSort+cCCSort+cCCCL+STR(nThck,9,3) IN StockLst_SQL ORDER AlFmsCLsS 
						*INDEX ON Alloy+STR(FormSort,2,0)+CCsort+cCCCL+STR(SIZE,9,3) TAG AlFmsCLsS 
								
						IF FOUND('Stocklst_SQL')
							nBestItem = RECNO('StockLst_SQL')
						ELSE	
							SEEK cAlloy+cFormSort+cCCSort+STR(nThck,9,3) IN StockLst_SQL ORDER AlFmsCCsS
							*INDEX ON Alloy+STR(FormSort,2,0)+CCsort+STR(SIZE,9,3) TAG AlFmsCCsS
						ENDIF
								
						IF FOUND('Stocklst_SQL') AND nBestItem = 0
							nBestItem = RECNO('StockLst_SQL')
						ELSE
							*Check for over
							nThckplus = nThck+.001
							
							SEEK cAlloy+cFormSort+cCCCL+STR(nThckplus,9,3) IN StockLst_SQL ORDER AlFmsCCLS
							IF FOUND('Stocklst_SQL')
								nBestItem = RECNO('StockLst_SQL')
							ELSE
								SEEK cAlloy+cFormSort+cCCSort+cCCCL+STR(nThckplus,9,3) IN StockLst_SQL ORDER AlFmsCLsS  
		
								IF FOUND('Stocklst_SQL')
									nBestItem = RECNO('StockLst_SQL')
								ELSE
									SEEK cAlloy+cFormSort+cCCSort+STR(nThckplus,9,3) IN StockLst_SQL ORDER AlFmsCCsS
									
									IF FOUND('Stocklst_SQL')
										nBestItem = RECNO('StockLst_SQL')
									ELSE
										*Check for under
										nThckMinus = nThck-.001
										SEEK cAlloy+cFormSort+cCCCL+STR(nThckMinus,9,3) IN StockLst_SQL ORDER AlFmsCCLS
										
										IF FOUND('Stocklst_SQL')
											nBestItem = RECNO('StockLst_SQL')
										ELSE
											SEEK cAlloy+cFormSort+cCCSort+STR(nThckMinus,9,3) IN StockLst_SQL ORDER AlFmsCCsS
											
											IF FOUND('Stocklst_SQL')
												nBestItem = RECNO('StockLst_SQL')
											ENDIF
										ENDIF
									ENDIF	
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ELSE
				*Not a good source to search with !EMPTY(cAlloy) AND !EMPTY(cFormSort) AND !EMPTY(cCCSort) AND !EMPTY(nThck)
				nBestItem = RECCOUNT('Stocklst_SQL')+1
				
				IF !EMPTY(cAlloy) AND !EMPTY(cFormSort) AND !EMPTY(cCCSort) 
					LOCATE FOR Alloy=cAlloy AND Form=cFormSort AND CCsort=cCCsort 
					
					IF FOUND('Stocklst_SQL')
						nBestItem = RECCOUNT('Stocklst_SQL')
					ELSE
						IF !EMPTY(cAlloy) AND !EMPTY(cFormSort)
							LOCATE FOR Alloy=cAlloy AND Form=cFormSort
							
							IF FOUND('Stocklst_SQL')
								nBestItem = RECCOUNT('Stocklst_SQL')
							ELSE
								IF !EMPTY(cAlloy) 
									LOCATE FOR Alloy=cAlloy
									
									IF FOUND('Stocklst_SQL')
										nBestItem = RECCOUNT('Stocklst_SQL')
									ELSE
										*nBestItem = RECCOUNT('Stocklst_SQL')+1
									ENDIF
								ENDIF
		
							ENDIF
						ENDIF
					ENDIF		
				ENDIF
			ENDIF
		ENDIF
		
		**************************
		IF nBestItem > 0 AND nBestItem < RECCOUNT('Stocklst_SQL')
			*Found a match
			IF NOT EMPTY(cHeat)
				*Now look for Heat!
				*Keep the found alloy,form etc
				PRIVATE cAlloy2, cForm2, cCC2, cCL2, nSize2, cCCCL
				
				cAlloy2	= PrepareSQLtxt(Stocklst_SQL.Alloy,'Alloy',12)
				cForm2	= PrepareSQLtxt(Stocklst_SQL.Form,'Form',2)
				cCC2	= PrepareSQLtxt(Stocklst_SQL.CC,'CC',1)
				cCL2	= PrepareSQLtxt(Stocklst_SQL.CL,'CL',1)
				nSize2	= PrepareSQLnum(Stocklst_SQL.Size,'Thck',9,3)
				
				cFormSort = ALLTRIM(STR( GetFormSort(cForm2,ThisForm.nConnHandle) ,2,0))
				cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
				cCCCL	= CC_CLsort(cCC2,cCL2,ThisForm.nConnHandle)
		
				SELECT Stocklst_SQL
				LOCATE FOR Alloy=cAlloy2 AND Form=cForm2 AND CC=cCC2 and Size=nSize2 AND UPPER(ALLTRIM(Heat)) = UPPER(ALLTRIM(cHeat))
				IF NOT FOUND('Stocklst_SQL')
					LOCATE FOR Alloy=cAlloy2 AND Form=cForm2 AND CCsort=cCCsort and Size=nSize2 AND UPPER(ALLTRIM(Heat)) = UPPER(ALLTRIM(cHeat))
					IF NOT FOUND('Stocklst_SQL')
						LOCATE FOR Alloy=cAlloy2 AND FormSort=VAL(cFormSort) AND CC=cCC2 and Size=nSize2 AND UPPER(ALLTRIM(Heat)) = UPPER(ALLTRIM(cHeat))
						IF NOT FOUND('Stocklst_SQL')
							LOCATE FOR Alloy=cAlloy2 AND FormSort=VAL(cFormSort) AND CCsort=cCCsort and Size=nSize2 AND UPPER(ALLTRIM(Heat)) = UPPER(ALLTRIM(cHeat))
						ENDIF				
					ENDIF
				ENDIF
				
				IF FOUND('Stocklst_SQL')
					nBestItem = RECNO('Stocklst_SQL')
				ELSE
					IF nBestItem > 0
						GOTO nBestItem 
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**************************
		*SELECT StockLst_SQL
		
		PRIVATE lFoundCCCL
		IF nBestItem = 0
			*> RECCOUNT('Stocklst_SQL')
			*did not find all
			*Find Alloy, Form, CC - Any Thickness Search
			
			SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL
			IF NOT FOUND('Stocklst_SQL')
				lFoundCCCL = .T.
			ELSE
				lFoundCCCL = .F.
				SEEK cAlloy+cFormSort+cCCSort+cCCCL IN StockLst_SQL ORDER AlFmsCCs
			ENDIF
			
			IF NOT lFoundCCCL 
				SEEK cAlloy+cFormSort+cCCSort IN StockLst_SQL ORDER AlFmsCs1
			ENDIF
			
			IF FOUND('Stocklst_SQL')
				nBestItem =RECNO("StockLst_SQL")
				
				IF lFoundCCCL
					SET FILTER TO Alloy = cAlloy AND FormSort = VAL(cFormSort) and CCCL = cCCCL 
				ELSE
					SET FILTER TO Alloy = cAlloy AND FormSort = VAL(cFormSort) and CCSort = cCCSort
				ENDIF
				
				GO TOP
				DO WHILE NOT EOF()
					IF nThck < Size
						* IF The thickness you search is Greater than the Stocklist Size,
						* exit- use the previous Best record number as the Best
						EXIT
					ENDIF
					nBestItem = RECNO('Stocklst_SQL')
					SKIP
				ENDDO
				SET FILTER TO 
				
				**** Try exact FORM, and CCCL
				IF cFormSort <> cForm 
					*Check for exact Alloy Form CCCL 
					SET FILTER TO Alloy = cAlloy AND Form = cForm AND CCCL = cCCCL	&&and CCSort = cCCSort cCCSort
					GO TOP
					DO WHILE NOT EOF()
						IF nThck < Size
							* IF The thickness you search is Greater than the Stocklist Size,
							* exit- use the previous Best record number as the Best
							EXIT
						ENDIF
						nBestItem = RECNO('Stocklst_SQL')
						SKIP
					ENDDO
					SET FILTER TO 
				ENDIF
		
				**** Try exact FORM CCsort
				IF cFormSort <> cForm 
					*Check for exact Alloy Form CCSort 
					SET FILTER TO Alloy = cAlloy AND Form = cForm AND CCSort = cCCSort	&&and CCSort = cCCSort cCCSort
					GO TOP
					DO WHILE NOT EOF()
						IF nThck < Size
							* IF The thickness you search is Greater than the Stocklist Size,
							* exit- use the previous Best record number as the Best
							EXIT
						ENDIF
						nBestItem = RECNO('Stocklst_SQL')
						SKIP
					ENDDO
					SET FILTER TO 
				ENDIF
						
				**** Try exact Alloy Form CCCL
				IF cFormSort <> cForm 
					*Check for exact Alloy Form CCCL
					SET FILTER TO Alloy = cAlloy AND Form = cForm AND CCCL = cCCCL
					GO TOP
					DO WHILE NOT EOF()
						IF nThck < Size
							* IF The thickness you search is Greater than the Stocklist Size,
							* exit- use the previous Best record number as the Best
							EXIT
						ENDIF
						IF nBestItem < RECNO('Stocklst_SQL')
							nBestItem = RECNO('Stocklst_SQL')
						ENDIF
						SKIP
					ENDDO
					SET FILTER TO 
				ENDIF
				
				**** Try exact Alloy Form CCsort
				IF cFormSort <> cForm 
					*Check for exact Alloy Form CCSort 
					SET FILTER TO Alloy = cAlloy AND Form = cForm AND CCSort = cCCSort 
					GO TOP
					DO WHILE NOT EOF()
						IF nThck < Size
							* IF The thickness you search is Greater than the Stocklist Size,
							* exit- use the previous Best record number as the Best
							EXIT
						ENDIF
						IF nBestItem < RECNO('Stocklst_SQL')
							nBestItem = RECNO('Stocklst_SQL')
						ENDIF
						SKIP
					ENDDO
					SET FILTER TO 
				ENDIF
				
				GOTO nBestItem
			ENDIF
		ENDIF		
		
		**************************
		SELECT Stocklst_SQL 
		
		IF nBestItem > RECCOUNT('Stocklst_SQL')
			*did not find when including CC
			*Find Alloy, Form and Thickness - Ignore CC
			IF nBestItem > RECCOUNT('Stocklst_SQL')
				
				IF !EMPTY(cAlloy) AND !EMPTY(cFormSort) AND !EMPTY(nThck)
					SEEK cAlloy+cFormSort+STR(nThck,9,3) IN StockLst_SQL ORDER AlFmsSz
					nBestItem = RECNO('StockLst_SQL')
					IF nBestItem > RECCOUNT('StockLst_SQL')
						*Check to see if a fraction under
						nThckplus = nThck+.001
						SEEK cAlloy+cFormSort+STR(nThckplus, 9,3) IN Stocklst_SQL ORDER AlFmsSz
						nBestItem =RECNO('StockLst_SQL')
						IF nBestItem > RECCOUNT('StockLst_SQL')
						*Check to see if a fraction over
							nThckMinus = nThck-.001
							SEEK cAlloy+cFormSort+STR(nThckMinus, 9,3) IN Stocklst_SQL ORDER AlFmsSz
							nBestItem =RECNO('StockLst_SQL')
		
							IF nBestItem > RECCOUNT('StockLst_SQL')
								*Check to see if under
								nThckplus = nThck+.1
								SEEK cAlloy+cFormSort+STR(nThckplus, 9,3) IN Stocklst_SQL ORDER AlFmsSz
								nBestItem = RECNO('StockLst_SQL')
								IF nBestItem > RECCOUNT('Stocklst_SQL')
								*Check to see if over
									nThckMinus = nThck-.1
									SEEK cAlloy+cFormSort+STR(nThckMinus, 9,3)  IN Stocklst_SQL ORDER AlFmsSz
									nBestItem = RECNO('Stocklst_SQL')
								ENDIF	
							ENDIF
		
						ENDIF	
					ENDIF
				ELSE
					nBestItem = RECCOUNT('Stocklst_SQL')+1
				ENDIF
			ENDIF
		ENDIF
		
		***********************
		PRIVATE lFoundForm 
		
		SELECT Stocklst_SQL 
		
		IF nBestItem > RECCOUNT('Stocklst_SQL')
			*did not find all
			*Find Alloy and Form
			IF !EMPTY(cAlloy) AND !EMPTY(cFormSort)
			
				SELECT StockLst_SQL
				
				SET ORDER TO A_CCCLHL 
				ThisForm.txtIndex.Value = 'A_CCCLHL'
				
				LOCATE FOR Alloy = cAlloy AND Form = cForm
				
				IF FOUND('Stocklst_SQL')
					lFoundForm = .T.
				ELSE
					lFoundForm = .F.
					*not by Form, try FormSort
					LOCATE FOR Alloy = cAlloy AND FormSort = VAL(cFormSort)
				ENDIF
				
				IF FOUND('Stocklst_SQL')
					nBestItem = RECNO("StockLst_SQL")
					
					IF lFoundForm 
						SET FILTER TO Alloy = cAlloy AND Form = cForm 
						
						GO TOP
						DO WHILE NOT EOF()
							IF nThck < Size
								* IF The thickness you search is Greater than the Stocklist Size,
								* exit- use the previous records number as Best
								EXIT
							ENDIF
							nBestItem = RECNO('Stocklst_SQL')
							SKIP
						ENDDO
						SET FILTER TO 	
					ENDIF
					
					IF nBestItem > RECCOUNT('Stocklst_SQL')
						*run if NOT lFoundForm or lFoundForm did not find a BestItem
						SET FILTER TO Alloy = cAlloy AND FormSort = VAL(cFormSort) 
						
						GO TOP
						DO WHILE NOT EOF()
							IF nThck < Size
								* IF The thickness you search is Greater than the Stocklist Size,
								* exit- use the previous records number as Best
								EXIT
							ENDIF
							nBestItem = RECNO('Stocklst_SQL')
							SKIP
						ENDDO
						SET FILTER TO 
						
					ENDIF
		
					GOTO nBestItem
				ENDIF
			ELSE
				nBestItem = RECCOUNT('Stocklst_SQL')+1
			ENDIF
		ENDIF
		
		
		**************************
		
		IF nBestItem > RECCOUNT('Stocklst_SQL')
			*find alloy
			IF !EMPTY(cAlloy)
				IF NOT ThisForm.OrderAlloy
					SELECT StockLst_SQL
					INDEX ON Alloy TAG Alloy
					ThisForm.OrderAlloy = .T.
				ENDIF
				SELECT StockLst_SQL
				SET ORDER TO TAG alloy
				ThisForm.txtIndex.Value = 'Alloy'
				
				SEEK cAlloy IN StockLst_SQL ORDER Alloy
				nBestItem =RECNO("StockLst_SQL")
				SELECT StockLst_SQL
				SET ORDER TO TAG AlFmCCsS
				ThisForm.txtIndex.Value = 'AlFmCCsS'
				
				IF FOUND('StockLst_SQL')
					*Found Alloy - get nearest Form!
					DO WHILE NOT EOF('StockLst_SQL')
						SKIP
						IF StockLst_SQL.Alloy != cAlloy
							EXIT
						ENDIF
						IF StockLst_SQL.FormSort > VAL(cFormSort)
							EXIT
						ENDIF
					ENDDO
					SKIP -1
				ENDIF
			ENDIF
			nBestItem =RECNO('StockLst_SQL')
		ENDIF
		
		***************************
		
		IF nBestItem > RECCOUNT('StockLst_SQL')
			*did not find alloy
			IF NOT ThisForm.OrderAlloy
				SELECT StockLst_SQL
				INDEX ON Alloy TAG Alloy
				ThisForm.OrderAlloy = .T.
			ENDIF
			
			SEEK LEFT(cAlloy,3) IN StockLst_SQL ORDER Alloy
		ELSE
			WAIT WINDOW STR(RECNO('Stocklst_SQL')) NOWAIT
		*	ThisForm.grdStockLst.SetFocus()
		*	SELECT StockLst_SQL
		*	GOTO nBestItem 
		ENDIF
		
		PRIVATE lCCCL
		lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
		
		ThisForm.lFirstTime = .F.
		
		SELECT StockLst_SQL
		IF lCCCL
			SET ORDER TO TAG A_CCCLHL 
			ThisForm.txtIndex.Value = 'A_CCCLHL '
		ELSE
			SET ORDER TO TAG AlFmCLHL
			ThisForm.txtIndex.Value = 'AlFmCLHL'
		ENDIF
		
		ThisForm.grdStockLst.Refresh
	ENDPROC

	PROCEDURE searchheatlot
		PARAMETERS pHeatLot
		
		PRIVATE cHeatLot
		IF VARTYPE(pHeatLot)!= "C"
			RETURN
		ELSE
			cHeatLot = ALLTRIM(pHeatLot)
		ENDIF
		
		PRIVATE lFound
		lFound = .F.
		
		**********************
		SELECT Stocklst_SQL
		IF !EMPTY(cHeatLot) AND cHeatLot!= "0"
			LOCATE FOR LOT = cHeatLot
			IF NOT FOUND()
				LOCATE FOR cHeatLot+" " $ LOT
				IF NOT FOUND()
					LOCATE FOR cHeatLot$ LOT
					IF NOT FOUND()
					
						IF LEFT(cHeatLot,1)= "R" OR LEFT(cHeatLot,1) = "G" OR LEFT(cHeatLot,1) = "L"
							cHeatLot = RIGHT(cHeatLot,LEN(cHeatLot)-1)
							LOCATE FOR cHeatLot+" " $ LOT
							IF NOT FOUND()
								LOCATE FOR cHeatLot$ LOT
								IF NOT FOUND()
									MESSAGEBOX("Lot "+cHeatLot+" not found!",0+64,"Search Alloy next")
									IF !EMPTY(ThisForm.pAlloy)
										SELECT StockLst_SQL	&&Used to track where this Table is dropped.
										ThisForm.Search()
									ENDIF
								ENDIF
							ELSE
								lFound = .T.
							ENDIF
						ELSE
							MESSAGEBOX("Lot "+cHeatLot+" not found!",0+64,"Search Alloy next")
							IF !EMPTY(ThisForm.pAlloy)
								SELECT StockLst_SQL	&&Used to track where this Table is dropped.
								ThisForm.Search()
							ENDIF
						ENDIF
					ELSE
						lFound = .T.
					ENDIF
				ELSE
					lFound = .T.
				ENDIF
			ELSE
				lFound = .T.
			ENDIF
			
			ThisForm.grdStockLst.SetFocus()
		ELSE
			MESSAGEBOX("Lot not found!",0+64,"No Lot to search, Search Alloy next.")
			IF !EMPTY(ThisForm.pAlloy)
				SELECT StockLst_SQL	&&Used to track where this Table is dropped.
				ThisForm.Search()
			ENDIF
		ENDIF
		
		SELECT StockLst_SQL
		
		ThisForm.grdStockLst.Refresh
		RETURN lFound
	ENDPROC

	PROCEDURE showalloyformcc
		PARAMETERS  pSz2, pSz3
		*ThisForm.ShowAlloyFormCC(pSz2, pSz3)
		*WHEN ThisForm.GetSOitem() does not have SOitem!
		
		ThisForm.cmdPrevItem.Visible = .T.
		ThisForm.cmdNextItem.Visible = .T.
		
		PRIVATE cWhatDo, cSOitem, nSO, nItem
		cWhatDo = ''
		
		PRIVATE nWeight, cForm, nThck, nSz2, nSz3, cCC, lRandLen, lMetric, cText 
		nWeight = PrepareSQLnum(ThisForm.pWeight,'Weight',7,1)
		cForm	= PrepareSQLtxt(ThisForm.pForm,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.pThck,'Thck',9,4)
		nSz2	= PrepareSQLnum(pSz2,'Sz2',8,3)
		nSz3	= PrepareSQLnum(pSz3,'Sz3',8,3)
		cCC 	= PrepareSQLtxt(ThisForm.pCC,'CC',1)
		lRandLen = ThisForm.pRandLen
		lMetric = .F.
		
		cText = ItemDescriptionMetric(cForm, nThck, nSz2, nSz3, nWeight, lRandLen, lMetric) 
		
		IF PrepareSQLnum(ThisForm.pPieces,'Pieces',-3) > 0
			cText = ALLTRIM( STR( ThisForm.pPieces )) +"Pc "+ cText
		ENDIF
		IF nWeight > 0
			cText = ALLTRIM(cText)+ " " + ALLTRIM( STR(nWeight)) + " Lbs"
		ENDIF
		
		IF cCC != '1' AND NOT EMPTY(cCC)
			cText = cText + " CC:"+cCC
		ENDIF
		
		*IF cCL != '1' AND NOT EMPTY(cCL)
		*	cText = cText + " CL:"+cCL
		*ENDIF
		
		IF NOT EMPTY( ALLTRIM( cText ))
			ThisForm.lblSz1.Caption = cText
		ENDIF
		
		ThisForm.cmdSearch.Visible = .T.
	ENDPROC

