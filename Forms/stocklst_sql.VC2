	PROCEDURE chkCCCL.Click
		*INDEX ON Alloy+STR(FormSort,2,0)+STR(SIZE,9,3) 			TAG AlFmsSz
		*INDEX ON Alloy+Form+STR(SIZE,9,3) 							TAG AlFmSize
		*INDEX ON Alloy+STR(FormSort,2,0)+CCsort+STR(SIZE,9,3) 	   	TAG AlFmsCCsS 
		*INDEX ON Alloy+STR(FormSort,2,0)+CCsort+CCCL+STR(SIZE,9,3) TAG AlFmsCLsS 
		*INDEX ON Alloy+STR(FormSort,2,0)+CCCL+STR(SIZE,9,3) 		TAG AlFmsCCLS 	
		*ThisForm.grdStockLst.SetFocus()
		
		*WAIT WINDOW STR(RECNO('Stocklst_SQL'))
		*?? STR(RECNO('Stocklst_SQL')) AT 1,1
		
		PRIVATE cAlloy, cForm, cCC, cCL, nLastRec 
		cAlloy	= PrepareSQLtxt(StockLst_SQL.Alloy,'Alloy',12,.T.)
		cForm 	= PrepareSQLtxt(StockLst_SQL.Form,'Form',2,.T.)
		*cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		*cCL 	= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		nLastRec = RECNO("StockLst_SQL")
		
		PRIVATE cFormSort, cCCSort, cCCCL, lCCCL
		cFormSort = ALLTRIM(STR( GetFormSort(cForm,ThisForm.nConnHandle) ,2,0))
		*cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		*cCCCL 	= CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		*lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
		
		PRIVATE cHeat, cLot
		cHeat	= PrepareSQLtxt(StockLst_SQL.Heat,'Heat',50)
		cLot = PrepareSQLtxt(StockLst_SQL.lot,'Lot',11)
		*cLot = UPPER( ALLTRIM( cLot ))
		
		SET FILTER TO
		
		SELECT Stocklst_SQL
		IF This.Value = 0
			*Do not use CCCL
			This.BackColor = RGB(255,128,128)  &&lite Red
			
			SET ORDER TO TAG AlFmSzHL
			ThisForm.txtIndex.Value = 'AlFmSzHL'
			
			*SEEK cAlloy+cFormSort+STR(1,9,3) IN StockLst_SQL ORDER AlFmsSz
			SEEK cAlloy+cFormSort+STR(1,9,3) IN StockLst_SQL ORDER AlFmSzHL
			
			*SET ORDER TO TAG AlFmCLHL
			
			IF nLastRec > 0
				GOTO nLastRec
			ENDIF
		
			ThisForm.cmbCC.Visible = .F.
			ThisForm.cmbCL.Visible = .F.
				
			WAIT WINDOW "CC and CL have been REMOVED from the Index" TIMEOUT 1
		ELSE
			This.BackColor = RGB(240,240,240)
			SET ORDER TO TAG A_CCCLHL
			ThisForm.txtIndex.Value = 'A_CCCLHL'
			*SET ORDER TO TAG AlFmsCLsSHL
		*defaul A_CCCLHL	
			ThisForm.cmbCC.Visible = .T.
			ThisForm.cmbCL.Visible = .T.
		
			WAIT WINDOW "'CC and CL' are used in the Index order" TIMEOUT 1
		ENDIF
		
		*WAIT WINDOW STR(RECNO('Stocklst_SQL'))
		*?? STR(RECNO('Stocklst_SQL')) AT 2,1
		
		ThisForm.ChangeStockLst()
		ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus
		
	ENDPROC

	PROCEDURE chkPrime.Click
		IF This.Value = 1
			This.BackColor = RGB(255,128,128) &&Lite Red
			
			DO CASE
			CASE ThisForm.cTBL = 'S'
				ThisForm.Caption = 'Browse Stock List SQL - PRIME ONLY'
			CASE ThisForm.cTBL = "B"
				ThisForm.Caption = 'Browse Broker List SQL - PRIME ONLY'
			CASE ThisForm.cTBL = "W"
				ThisForm.Caption = 'Browse WIP List SQL - PRIME ONLY'
			ENDCASE
		ELSE
			This.BackColor = RGB(240,240,240)
			
			DO CASE
			CASE ThisForm.cTBL = 'S'
				ThisForm.Caption = 'Browse Stock List SQL'
			CASE ThisForm.cTBL = "B"
				ThisForm.Caption = 'Browse Broker List SQL'
			CASE ThisForm.cTBL = "W"
				ThisForm.Caption = 'Browse WIP List SQL'
			ENDCASE
		ENDIF
		
		************
		*Save the Current to Search for
		PRIVATE cAlloy, cForm, nThck, cCC, cCL, cHeat
		cAlloy	= PrepareSQLtxt(Stocklst_SQL.Alloy,'Alloy',12,.T.)
		nFormSort = GetFormSort(Stocklst_SQL.Form, ThisForm.nConnHandle)
		cForm	= PrepareSQLtxt(Stocklst_SQL.FormSort,'FormSort',2,.T.)
		nThck	= PrepareSQLnum(Stocklst_SQL.Size,'Thck',9,3)
		cCC		= PrepareSQLtxt(Stocklst_SQL.CC,'CC',1)
		cCL		= PrepareSQLtxt(Stocklst_SQL.CL,'CL',1)
		cHeat	= PrepareSQLtxt(Stocklst_SQL.Heat,'Heat',50)
		
		ThisForm.cmbAlloy.Value = cAlloy
		ThisForm.cmbForm.Value	= cForm
		ThisForm.cmbCC.Value 	= cCC
		ThisForm.cmbCL.Value	= cCL
		
		ThisForm.pAlloy = cAlloy
		ThisForm.pForm	= cForm
		ThisForm.pThck	= nThck
		
		
		*Reload with the PRIME flag.
		ThisForm.Load_StockLst_SQL(ThisForm.cTBL)
		
		SELECT StockLst_SQL	&&Used to track where this Table is dropped.
		
		*Search. Go back to similar stock
		ThisForm.Search(cHeat)
		
		ThisForm.grdStockLst.SetFocus()
		
	ENDPROC

	PROCEDURE cmbAlloy.InteractiveChange
		PRIVATE cAlloy, cForm, cCC, cCL, nCurrentRecord
		
		cAlloy	= This.Value
		*IF ThisForm.InitAlloy12 = "#12"
		IF RECNO('StockLst_SQL') = 1
			*IGNORE THE FORM, cc AND cL BECUASE IT IS JUST defaulted to the FIRST RECORD.
			cForm	= '10'
			cCC		= '1'
			cCL		= ''
			ThisForm.cmbForm.Value = cForm
			ThisForm.cmbCC.Value = cCC
			ThisForm.cmbCL.Value = cCL
			
		ELSE
			cForm	= ThisForm.cmbForm.Value
			cCC		= ThisForm.cmbCC.Value
			cCL		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		ENDIF
		nCurrentRecord = RECNO('StockLst_SQL')
		
		PRIVATE cFormSort, cCCSort, cCCCL 
		cFormSort = ALLTRIM(STR( GetFormSort(cForm,ThisForm.nConnHandle) ,2,0))
		PRIVATE cCCSort, cCCCL
		cCCSort =  CCSort(cCC, ThisForm.nConnHandle)
		cCCCL 	= CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		
		PRIVATE lFoundCCCL
		SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL
		IF FOUND('StockLst_SQL')
			lFoundCCCL = .T.
		ELSE
			lFoundCCCL = .F.
			SEEK cAlloy+cFormSort+cCCSort+cCCCL IN StockLst_SQL  ORDER AlFmsCCs
		ENDIF
		
		IF NOT FOUND('StockLst_SQL')
			SELECT StockLst_SQL 
			*Just Alloy and Form
			LOCATE FOR Alloy = cAlloy AND FormSort = VAL(cFormSort)
			
			IF NOT FOUND('StockLst_SQL')
				LOCATE FOR Alloy = cAlloy
				IF FOUND('StockLst_SQL')
					*Form not Found- Update!
					ThisForm.cmbForm.Value = StockLst_SQL.Form
				ELSE
					LOCATE FOR LEFT(Alloy,5) = LEFT(cAlloy,5)
					IF FOUND('StockLst_SQL')
						*Form not Found- Update!
						ThisForm.cmbForm.Value = StockLst_SQL.Form			
					ELSE	
						WAIT WINDOW 'Not found!'
						GOTO nCurrentRecord 
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.ChangeStockLst()
		ThisForm.cmdSearch.Visible = .T.
		ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus()
		
	ENDPROC

	PROCEDURE cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode WITH(NOLOCK) "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionCode')	
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)+1
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		PRIVATE nNewRow
		nNewRow = ALEN(aConditionCode,1)+1
		
		this.addListitem('*',nNewRow ,1)
		this.addListitem('Any Code',nNewRow ,2)
		
		*This.Value = "*"
		This.Value = "1"
		
	ENDPROC

	PROCEDURE cmbCC.InteractiveChange
		PRIVATE cAlloy, cForm, nThck, cCC, cCL, nCurrentRecord
		
		cAlloy	= PrepareSQLtxt(ThisForm.cmbAlloy.Value,'Alloy',12,.T.)
		cForm 	= ThisForm.cmbForm.Value
		nThck	= PrepareSQLnum(StockLst_SQL.Size,'Thck',9,3)
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		
		
		PRIVATE cFormSort, cCCSort, cCCCL, lCCCL
		cFormSort = ALLTRIM(STR( GetFormSort(cForm,ThisForm.nConnHandle) ,2,0))
		cCCSort	= CCSort( cCC, ThisForm.nConnHandle)
		cCCCL 	= CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL',.F.)
		
		PRIVATE lC2, cC2
		lC2 = .F.
		cC2 = '0'
		IF cCC = '*'
			cCC='2'
			cC2	= C2_Sort(cCC,ThisForm.nConnHandle)
		
			cCL = ''
			lC2 = .T.
		ENDIF
		
		
		PRIVATE nBestItem
		nBestItem = RECNO('StockLst_SQL')
		nCurrentRecord = RECNO('StockLst_SQL')
		
		SELECT StockLst_SQL
		
		IF lC2 
			*SET ORDER TO TAG AlFC2LHL
			*INDEX ON Alloy+STR(FormSort,2,0)+STR(SIZE,9,3)+Heat+Lot TAG AlFmSzHL 
			SET ORDER TO TAG AlFmSzHL
			ThisForm.txtIndex.Value = 'AlFmSzHL'
			
			LOCATE FOR Alloy=cAlloy AND Form=cForm 
			IF FOUND('StockLst_SQL')
				SET FILTER TO Alloy=cAlloy AND Form=cForm 
				MESSAGEBOX("This Alloy '"+ALLTRIM(cAlloy)+"' and Form "+cForm+" is using Generic 'CC' ",64,"No CC sorting.")
				
				LOCATE FOR Alloy=cAlloy AND Form=cForm AND Size >= nThck
				IF NOT FOUND('StockLst_SQL')
					*GO BACK
					LOCATE FOR Alloy=cAlloy AND Form=cForm &&AND Size < nThck
				ENDIF
				
			ENDIF
		ELSE
			*INDEX ON Alloy+Form+CCsort+CCCL+STR(SIZE,9,3)+Heat+Lot TAG AlFmCLHL
			SET ORDER TO TAG AlFmCLHL
			ThisForm.txtIndex.Value = 'AlFmCLHL'
			
			LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC
		
			IF FOUND('StockLst_SQL')
				SET FILTER TO Alloy=cAlloy AND Form=cForm AND CC=cCC
			ELSE
		
				LOCATE FOR Alloy=cAlloy AND Form=cForm AND CCCL=cCCCL
				IF FOUND('StockLst_SQL')
					SET FILTER TO Alloy=cAlloy AND Form=cForm AND CCCL=cCCCL
				ELSE
					LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CCCL=cCCCL
					IF FOUND('StockLst_SQL')
						SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CCCL=cCCCL
					ELSE
						LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CCsort=cCCsort		
						IF FOUND('StockLst_SQL')
							SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CCsort=cCCsort
							
						ELSE
							*Did not find Alloy, Form and CC  -drop Form
							LOCATE FOR Alloy=cAlloy AND CC=cCC
							IF FOUND('StockLst_SQL')
								SET FILTER TO Alloy=cAlloy AND CC=cCC
								MESSAGEBOX("Form was skipped while setting Alloy to '"+ALLTRIM(cAlloy)+"' CC to '"+cCC+"'.",64,"Different Form.")
							ELSE
								GOTO nBestItem 
								MESSAGEBOX("This Alloy '"+ALLTRIM(cAlloy)+"' does not have a CC of '"+cCC+"'.",48,"Bad combination.")
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF FOUND('StockLst_SQL')
			*Search for best Size match.
			
			nBestItem = RECNO("StockLst_SQL")
			
		*	GO TOP
			DO WHILE NOT EOF()
				IF nThck <= Size
					* IF The thickness you search is Greater than the Stocklist Size,
					* exit- use the previous records number as Best
					EXIT
				ENDIF
				nBestItem = RECNO('Stocklst_SQL')
				SKIP
			ENDDO
			SET FILTER TO 
			GOTO nBestItem
		ENDIF
		
		ThisForm.ChangeStockLst()
		*ThisForm.cmdSearch.Visible = .T.
		ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus
		
	ENDPROC

	PROCEDURE cmbCC.Valid
		ThisForm.ReloadCL()
	ENDPROC

	PROCEDURE cmbCL.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel WITH(NOLOCK) "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionLevel')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF USED('ConditionLevel')
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionLevel,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		This.Value = ""
		
	ENDPROC

	PROCEDURE cmbCL.InteractiveChange
		PRIVATE cAlloy, cForm, nThck, cCC, cCL, nCurrentRecord, nSize
		
		cAlloy	= ThisForm.cmbAlloy.Value
		cForm 	= ThisForm.cmbForm.Value
		nThck	= PrepareSQLnum(StockLst_SQL.Size,'Thck',9,3)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(This.Value,'CL',1)
		nCurrentRecord = RECNO('StockLst_SQL')
		nSize	= StockLst_SQL.Size
		
		PRIVATE cFormSort, cCCSort, cCCCL
		cFormSort = ALLTRIM(STR( GetFormSort(cForm,ThisForm.nConnHandle) ,2,0))
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL = CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		
		PRIVATE nBestItem 
		nBestItem = RECNO('StockLst_SQL')
		PRIVATE lUseCCCL
		lUseCCCL =  .F.
		
		SELECT StockLst_SQL
		SET FILTER TO 
		
		SEEK cAlloy+cFormSort+cCCCL+STR(nThck,9,3) IN StockLst_SQL ORDER AlFmsCCLS 
		
		IF FOUND('StockLst_SQL')
			SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC AND CL=cCL
		ELSE
			SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL 
			
			IF FOUND('StockLst_SQL')
				SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC AND CL=cCL
			ELSE
			
				*Did not find Alloy, Form and CC,CL  -drop Form
				LOCATE FOR Alloy=cAlloy AND CC=cCC AND CL=cCL
				IF FOUND('StockLst_SQL')
					SET FILTER TO Alloy=cAlloy AND CC=cCC AND CL=cCL
					MESSAGEBOX("Form was skipped while setting Alloy to '"+ALLTRIM(cAlloy)+"' CC to '"+cCC+"' and CL to '"+cCL+"'.",64,"Different Form.")
				ELSE
					GOTO nBestItem 
					MESSAGEBOX("This Alloy '"+ALLTRIM(cAlloy)+"' does not have a CC of '"+cCC+"' and CL of '"+cCL+"'.",48,"Bad combination.")
				ENDIF
			
			ENDIF
		ENDIF
		
		SELECT Stocklst_SQL
		
		IF LEN( FILTER('Stocklst_SQL') ) > 0
			*A filter was Set
			
			GO TOP
			IF EOF('Stocklst_SQL')
				MESSAGEBOX("Could not find CL in this Alloy and Form.",0,"No CL")
			ENDIF
			DO WHILE NOT EOF()
				IF nThck < Size
					* IF The thickness you search is Greater than the Stocklist Size,
					* exit- use the previous records number as Best
					EXIT
				ENDIF
				nBestItem = RECNO('Stocklst_SQL')
				SKIP
			ENDDO
			SET FILTER TO 
			GOTO nBestItem
		ENDIF
		
		ThisForm.ChangeStockLst()
		*ThisForm.cmdSearch.Visible = .T.
		ThisForm.grdStockLst.Refresh
		*ThisForm.grdStockLst.SetFocus
		
	ENDPROC

	PROCEDURE cmbCL.Requery
		ThisForm.ReloadCL()
		
	ENDPROC

	PROCEDURE cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			USE IN FormCode
		ENDIF
		
		SELECT 0
		
		*this.clear
		cSQL="SELECT [FormNumber],CAST([FormSort] AS CHAR(2)) AS [FSort],[FormDescription] FROM dbo.Forms WITH(NOLOCK) "
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
				RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
			ENDIF
		ENDIF
		
		IF VARTYPE(gaFormCode) = "U"
			PUBLIC ARRAY gaFormCode(1,3)
			*DIMENSION aFormCode(1,3)
		ENDIF
		
		IF USED('FormCode')
		
			IF RECCOUNT('FormCode') = 0
				*Load again
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
				ENDDO
			ENDIF
			
			IF RECCOUNT('FormCode') = 0
				SELECT '' AS FormNumber,0 AS [FSort],'' AS FormDescription FROM FormCode INTO ARRAY gaFormCode
			ELSE
				SELECT FormNumber,FSort,FormDescription FROM FormCode INTO ARRAY gaFormCode
			ENDIF
				
			
			USE IN FormCode
		ENDIF
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(gaFormCode,1)
		
		This.ColumnCount = 3
		This.NumberOfElements = nArrayCount
		This.BoundColumn = 1
		This.ColumnWidths = "20,20,115"
		
		FOR I = 1 TO nArrayCount
			this.addListitem(gaFormCode(I, 1),I,1)
			this.addListitem(gaFormCode(I, 2),I,2)
			this.addListitem(gaFormCode(I, 3),I,3)
		ENDFOR
		
		This.Value = '10'
		
	ENDPROC

	PROCEDURE cmbForm.InteractiveChange
		PRIVATE cAlloy, cForm, cCC, cCL, nCurrentRecord
		
		cAlloy	= ThisForm.cmbAlloy.Value
		cForm	= This.Value
		cCC		= ThisForm.cmbCC.Value
		cCL		= ThisForm.cmbCL.Value
		
		
		nCurrentRecord = RECNO('StockLst_SQL')
		
		SELECT StockLst_SQL
		PRIVATE cFormSort
		*cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisForm.nConnHandle),2,0))
		nElement = ASCAN(gaFormCode,cForm,1,0,1)
		cFormSort = gaFormCode(nElement+1)
		
		nFormSort = GetFormSort(cForm, ThisForm.nConnHandle)
		cFormSort = ALLTRIM(STR(nFormSort,2,0))
		
		
		PRIVATE cCCSort, cCCCL, lCCCL
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL	= CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
		
		SELECT StockLst_SQL 
		
		*loook for the basics, Alloy and Form.
		LOCATE FOR Alloy = cAlloy AND FORM = cForm
		IF NOT FOUND('StockLst_SQL')
			LOCATE FOR Alloy = cAlloy AND STR(FormSort,2,0) = cFormSort 
		ENDIF
		
		IF NOT FOUND()
			LOCATE FOR Alloy = cAlloy
			WAIT WINDOW "Form "+cForm+" NOT found with Alloy '"+ALLTRIM(cAlloy )+"'"
			RETURN
		ENDIF
		
		*Found Alloy and (Form or FormSort)
		nCurrentRecord = RECNO('StockLst_SQL')
		
		IF lCCCL
			*TRY CC CL
			SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL
			
			IF NOT FOUND('StockLst_SQL')
				SEEK cAlloy+cFormSort+cCCsort+cCCCL IN StockLst_SQL ORDER AlFmsCCs
				
				IF NOT FOUND('StockLst_SQL')
		*			LOCATE FOR Alloy = cAlloy AND Form = cForm 
		*			
		*			IF NOT FOUND('StockLst_SQL')
		*				IF NOT FOUND('StockLst_SQL')
		*					LOCATE FOR Alloy = cAlloy AND STR(FormSort,2,0) = cFormSort 
		*					
		*					IF NOT FOUND('StockLst_SQL')
		*						*LOCATE FOR STR(FormSort,2,0) = cFormSort
		*						LOCATE FOR Alloy = cAlloy 
		*						
		*						WAIT WINDOW 'Form Not found with Alloy '+cAlloy 
								GOTO nCurrentRecord 
		*					ENDIF
		*				ENDIF	
		*			ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		ThisForm.ChangeStockLst()
		*ThisForm.cmdSearch.Visible = .T.
		
		*ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus()
		
	ENDPROC

	PROCEDURE cmbForm.Valid
		*ThisForm.grdStockLst.refresh
		
		
		
		
		
		*!*	*RowSource=10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
		*!*	PRIVATE cAlloy, cForm, cCC, cCL
		*!*	cAlloy = StockLst_SQL.Alloy
		*!*	cForm = This.Value
		*!*	cCC	= This.Parent.cmbCC.Value
		*!*	cCL		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		
		*!*	IF NOT ThisForm.OrderAlloyForm
		*!*		SELECT StockLst_SQL
		*!*		ThisForm.OrderAlloyForm = .T.
		*!*	ENDIF
		
		*!*	PRIVATE cFormSort
		*!*	cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisForm.nConnHandle),2,0))
		*!*	PRIVATE cCCSort, cCCCL
		*!*	cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		*!*	cCCCL = CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		
