	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		
		
		ThisForm.ConnHandle = get_SQLSTRINGCONNECT()
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("ChooseSales")
			USE IN ChooseSales
		ENDIF
		SELECT 0
		
		
		*cSQL="SELECT * FROM dbo.Sales_No "
		*cSQL="SELECT TOP 500 * FROM dbo.Sales_No "
		cSQL="SELECT SOitem,SalesNum,Cncld,cmplt,urgent,GS_Cmplt "
		cSQL=cSQL+" FROM dbo.Sales "
		cSQL=cSQL+" ORDER BY SOitem DESC"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'ChooseSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'ChooseSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ChooseSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'ChooseSales' )
		ENDIF
		
		SELECT ChooseSales
		GO TOP
		IF RECCOUNT() > 8
			SKIP 8
		ENDIF
	ENDPROC

	PROCEDURE refreshscreen
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpSales")
			USE IN tmpSales
		ENDIF
		SELECT 0
		
		
		cSQL="SELECT * "
		cSQL=cSQL+" FROM dbo.Sales "
		cSQL=cSQL+" WHERE SOItem = '"+(ChooseSales.SOitem)+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpSales')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpSales')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'tmpSales' )
		ENDIF
		
		
		
		
		*-!*		[soitem] [char](10) NOT NULL,
		*-!*		[salesnum] [decimal](7, 0) NOT NULL,
		*-!*		[item] [decimal](2, 0) NULL,
		*!*		[orderspec] [char](60) NULL,
		*!*		[s_instrct] [text] NULL,
		*!*		[inv] [bit] NULL,
		*!*		[gfm] [bit] NULL,
		*!*		[roll] [bit] NULL,
		*!*		[mach] [bit] NULL,
		*!*		[cg] [bit] NULL,
		*!*		[plasma] [bit] NULL,
		*!*		[cert] [decimal](1, 0) NULL,
		*-!*		[itemtot] [decimal](2, 0) NULL,
		*-!*		[shipdue] [datetime] NULL,
		*-!*		[shipped] [datetime] NULL,
		*-!*		
		*-!*		
		*-!*		[matlwt] [decimal](9, 1) NULL,
		*-!*		[cncld] [bit] NULL,
		*-!*		[cmplt] [bit] NULL,
		*!*		[partno] [char](100) NULL,
		*-!*		[itemcost] [decimal](9, 2) NULL,
		*-!*		[itemsale] [decimal](9, 2) NULL,
		*-!*		[gs_cost] [decimal](9, 2) NULL,
		*-!*		[gs_sale] [decimal](9, 2) NULL,
		*-!*		[gs_cmplt] [bit] NULL,
		*!*		[rma_no] [decimal](10, 0) NULL,
		*!*		[qa] [bit] NULL,
		*!*		[cofc] [bit] NULL,
		*!*		[merc] [bit] NULL,
		*!*		[ppo] [bit] NULL,
		*!*		[ppn] [bit] NULL,
		*!*		[pheat] [bit] NULL,
		*!*		[pspec] [bit] NULL,
		*!*		[pdesc] [bit] NULL,
		*!*		[pother] [bit] NULL,
		*!*		[other] [char](30) NULL,
		*!*		[prcp] [bit] NULL,
		*!*		[prcd] [bit] NULL,
		*!*		[pckd] [bit] NULL,
		*!*		[urgent] [char](1) NULL,
		*-!*		[shipon] [bit] NULL,
		*!*		[Tol] [varchar](20) NULL,
		*!*		
		ThisForm.txtSalesNum.Value	= tmpSales.SalesNum
		ThisForm.txtItem.Value 		= tmpSales.Item
		ThisForm.txtItemTot.Value	= tmpSales.ItemTot
		ThisForm.txtShipDue.Value	= TTOD(tmpSales.ShipDue)
		ThisForm.txtShipped.Value	= TTOD(tmpSales.Shipped)
		ThisForm.chkShipOn.Value	= IIF(tmpSales.ShipOn,1,0)
		*ThisForm.chkURGENT.Value	= IIF(ISNULL(tmpSales.URGENT),0,tmpSales.URGENT) > 0
		*ThisForm.chkURGENT.Value	= IIF(ISAlpha(IIF(ISNULL(tmpSales.URGENT),'0',tmpSales.URGENT)),STR(IIF(ISNULL(tmpSales.URGENT),'0',tmpSales.URGENT)),IIF(ISNULL(tmpSales.URGENT),'0',tmpSales.URGENT)) > 0
		ThisForm.chkURGENT.Value	= IIF(ISAlpha(IIF(ISNULL(tmpSales.URGENT),'0',tmpSales.URGENT)),VAL(IIF(ISNULL(tmpSales.URGENT),'0',tmpSales.URGENT)),VAL(IIF(ISNULL(tmpSales.URGENT),'0',tmpSales.URGENT))) > 0
		
		ThisForm.chkCncld.Value		= IIF(tmpSales.cncld,1,0)
		ThisForm.chkComplete.Value	= IIF(tmpSales.cmplt,1,0)
		
		ThisForm.txtItemCost.Value	= tmpSales.itemcost
		ThisForm.txtItemSale.Value 	= tmpSales.itemsale
		ThisForm.txtgs_cost.Value	= PrepareSQLnum(tmpSales.gs_cost,'GS_Cost',9,2)
		ThisForm.txtgs_sale.Value 	= PrepareSQLnum(tmpSales.gs_sale,'GS_Sale',9,2)
		ThisForm.txtqshipped.Value 	= PrepareSQLnum(tmpSales.qshipped,'QShipped',10,0)
		ThisForm.txtMatlWt.Value	= PrepareSQLnum(tmpSales.matlwt,'MatlWt',9,1)
		ThisForm.txtJobHours.Value	= PrepareSQLNum(tmpSales.JobHours,'JobHours',4,1)
		
		ThisForm.chkgs_cmplt.Value	= IIF(tmpSales.gs_cmplt,1,0)
		
		
		
		
	ENDPROC

	PROCEDURE soitembackcolor
		PRIVATE nColor
		*SOitemBackColor()
		
		*Cncl,cmplt,urgent
		
		IF ChooseSales.Cncld 
			nColor = RGB( 192,192,192 ) &&GRAY
		ELSE
			IF ChooseSales.Cmplt 
				nColor = RGB( 255, 255, 255 ) &&WHITE
				
			ELSE
				IF ChooseSales.Urgent 
					nColor = RGB( 255, 0, 0 ) &&RED
				ELSE
					*Not complete, Not Urgent, Not Cancelled
					*nColor = RGB( 255,128,64 ) &&ORANGE
					nColor = RGB( 0,255,0) &&Green
				ENDIF
			ENDIF
		ENDIF
		
		RETURN nColor
	ENDPROC

	PROCEDURE Unload
		IF USED('ChooseSales')
			USE IN ChooseSales
		ENDIF
		
		IF USED("Quotes")
			USE IN Quotes
		ENDIF
		
		= SQLDISCONNECT( ThisForm.ConnHandle )
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdFind.Click
		IF ThisForm.txtSalesOrder.Value > 0
			SELECT ChooseSales
			*SEEK ThisForm.txtSalesOrder.Value ORDER SalesNum
			LOCATE FOR SalesNum = ThisForm.txtSalesOrder.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				ThisForm.txtSalesOrder.Value = ChooseSales.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
			ThisForm.grdSales.Refresh
		*	ThisForm.grdSales.SetFocus
			ThisForm.RefreshScreen()
			ThisForm.grdSales.clmSO.SetFocus()
		ELSE
			WAIT WINDOW "Enter Number to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSaveMoney.Click
		PRIVATE cSOitem, nGS_Cost, nGS_Sale, lGS_Cmplt
		cSOitem		= ChooseSales.SOitem
		nGS_Cost	= PrepareSQLnum(ThisForm.txtGS_Cost.Value,"GS_Cost",9,2)
		nGS_Sale	= PrepareSQLnum(ThisForm.txtGS_Sale.Value,"GS_Sale",9,2)
		lGS_Cmplt	= PrepareSQLchk(ThisForm.chkGS_Cmplt.Value,"GS_Cmplt")
		
		IF AllowFinalizeMoney()
			PRIVATE cSQL, nSQLEXEC
		
			cSQL="UPDATE dbo.Sales SET "
			cSQL=cSQL+" GS_Cost="+STR(nGS_Cost,12,2)
			cSQL=cSQL+",GS_Sale="+STR(nGS_Sale,12,2)
			cSQL=cSQL+",GS_Cmplt="+IIF(lGS_Cmplt,'1','0')
			cSQL=cSQL+" WHERE SOItem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.ConnHandle, nSQLEXEC )
				MESSAGEBOX("Update reported an error"+CHR(13)+"Try to save again!",0+16,"Did not Save.")
			ELSE
				MESSAGEBOX("Update SO-item:"+cSOitem,0+64,"Saved.")
			ENDIF
		
		
		ELSE
			MESSAGEBOX("You are not allowed to modify the final 'Money' fields",0+16,"Permission denied!")
		ENDIF
	ENDPROC

	PROCEDURE cmdSaveQuantity.Click
		PRIVATE cSOitem, nQShipped, nMatlWt, nJobHours
		cSOitem		= ChooseSales.SOitem
		nQShipped	= PrepareSQLnum(ThisForm.txtQShipped.Value,"QShipped",10,0)
		nMatlWt		= PrepareSQLnum(ThisForm.txtMatlWt.Value,"MatlWt",9,1)
		nJobHours	= PrepareSQLnum(ThisForm.txtJobHours.Value,"JobHours",4,1)
		
		IF AllowFinalizeQuantity()
			PRIVATE cSQL, nSQLEXEC
		
			cSQL="UPDATE dbo.Sales SET "
			cSQL=cSQL+" QShipped ="+STR(nQShipped,10,0)
			cSQL=cSQL+", MatlWt ="+STR(nMatlWt,11,1)
			cSQL=cSQL+", JobHours ="+STR(nJobHours,6,1)
			cSQL=cSQL+" WHERE SOItem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.ConnHandle, nSQLEXEC )
				MESSAGEBOX("Update reported an error"+CHR(13)+"Try to save again!",0+16,"Did not Save.")
			ELSE
				MESSAGEBOX("Update SO-item:"+cSOitem,0+64,"Saved.")
			ENDIF
		
		
		ELSE
			MESSAGEBOX("You are not allowed to modify the Final Quantities",0+16,"Permission denied!")
		ENDIF
	ENDPROC

	PROCEDURE grdSales.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshScreen()
	ENDPROC

	PROCEDURE Label7.Click
		SELECT ChooseSales
		INDEX ON SOitem TAG SO_ DESCENDING
		SET ORDER TO tag SO_
		ThisForm.grdSales.Refresh
	ENDPROC

	PROCEDURE lblCancelled.Click
		SELECT ChooseSales
		INDEX ON IIF(IIF(ISNULL(Cncld),.F.,Cncld),'0','1')+SOitem TAG SO_Cncld
		SET ORDER TO tag SO_Cncld
		
		ThisForm.grdSales.Refresh
	ENDPROC

	PROCEDURE lblComplete.Click
		SELECT ChooseSales
		INDEX ON IIF(IIF(ISNULL(Cmplt),.F.,Cmplt),'1','0')+IIF(IIF(ISNULL(Cncld),.F.,Cncld),'0','1')+SOitem TAG SO_Cmplt DESCENDING
		SET ORDER TO tag SO_Cmplt
		
		ThisForm.grdSales.Refresh
	ENDPROC

	PROCEDURE lblNoSort.Click
		SELECT ChooseSales
		INDEX ON IIF(IIF(ISNULL(GS_Cmplt),.F.,GS_Cmplt),'0','1')+SOitem TAG SO_Finale DESCENDING
		SET ORDER TO tag SO_Finale
		ThisForm.grdSales.Refresh
	ENDPROC

	PROCEDURE lblOpen.Click
		
		SELECT ChooseSales
		INDEX ON IIF(IIF(ISNULL(Cmplt),.F.,Cmplt),'1','0')+IIF(IIF(ISNULL(Cncld),.F.,Cncld),'1','0')+SOitem TAG SO_Open
		
		SET ORDER TO TAG SO_Open
		ThisForm.grdSales.Refresh
	ENDPROC

	PROCEDURE lblUrgent.Click
		SELECT ChooseSales
		INDEX ON IIF(ISNULL(Urgent),' ',Urgent)+IIF(IIF(ISNULL(Cmplt),.F.,Cmplt),'1','0')+IIF(IIF(ISNULL(Cncld),.F.,Cncld),'1','0')+SOitem TAG SO_Urgent
		SET ORDER TO tag SO_Urgent
		ThisForm.grdSales.Refresh
	ENDPROC

	PROCEDURE txtSalesOrder.Valid
		IF !EMPTY(THIS.Value)
			*ThisForm.cmdFind.Click
			SELECT ChooseSales
			*SEEK THIS.Value ORDER SalesNum
			LOCATE FOR SalesNum = This.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				THIS.Value = ChooseSales.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
		*	ThisForm.grdSales_No.Refresh
		*	ThisForm.grdSales_No.SetFocus
			ThisForm.RefreshScreen()
		ENDIF
	ENDPROC

ENDDEFINE
