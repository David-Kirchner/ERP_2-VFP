	PROCEDURE setediting
		ThisForm.isediting=.T.
		thisform.cmdEdit.caption = 'Save'
		thisform.cmdDelete.caption = 'Abort'
		thisform.cmdDelete.enabled = .T.
		thisform.cmdAdd.enabled = .F.
		thisform.cmdClone.enabled = .F.
		thisform.cmdBrowse.enabled = .F.
		thisform.cmdPrint.enabled = .F.
		thisform.cmdClose.enabled = .F.
		thisform.cmdNext.enabled = .F.
		thisform.cmdPrev.enabled = .F.
		thisform.Refresh
		
	ENDPROC

	PROCEDURE setnormal		&& Sets buttons to Normal -Not edit mode.
		ThisForm.isediting=.F.
		thisform.cmdEdit.caption = 'Edit'
		thisform.cmdDelete.caption = 'Delete'
		thisform.cmdDelete.enabled = .T.
		thisform.cmdAdd.enabled = .T.
		thisform.cmdClone.enabled = .T.
		thisform.cmdBrowse.enabled = .T.
		thisform.cmdPrint.enabled = .T.
		thisform.cmdClose.enabled = .T.
		thisform.cmdNext.enabled = .T.
		thisform.cmdPrev.enabled = .T.
		thisform.Refresh
		
	ENDPROC

	PROCEDURE Unload
		
		
		IF USED('Alloy_Spec')
			USE IN Alloy_Spec
		ENDIF
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdAdd.Valid
		IF NOT HavePermission('EditCert')
			RETURN
		ENDIF
		
		ThisForm.txtID.Value = 0
		
		ThisForm.Refresh
		WAIT WINDOW 'Ready to edit' NOWAIT
		ThisForm.isadding = .T.
		ThisForm.SetEditing()
		
	ENDPROC

	PROCEDURE cmdBrowse.Click
		SELECT Alloy_Spec
		
		BROWSE 
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmdClone.Valid
		IF NOT HavePermission('EditCert')
			RETURN
		ENDIF
		
		ThisForm.txtID.Value = 0
		
		ThisForm.Refresh
		WAIT WINDOW 'Ready to edit' NOWAIT
		ThisForm.isadding =.T.
		ThisForm.SetEditing()
		
	ENDPROC

	PROCEDURE cmdClose.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdClose.Valid
		*!*	WAIT WINDOW " Backing Up file " NOWAIT
		*!*	PRIVATE CURSAFE
		*!*	CURSAFE = set('safety')
		*!*	SET safety off
		
		*!*	COPY TO "c:\Alloy_Spec backup.dbf"
		
		*!*	SET safety &CURSAFE
		*!*	WAIT CLEAR
		
		
	ENDPROC

	PROCEDURE cmdDelete.Valid
		SELECT Alloy_Spec
		
		PRIVATE currec
		IF ThisForm.isediting 	&&Do not SAVE
		*	ThisForm.Load_Alloy_Spec("REFRESH")
		
			ThisForm.isadding = .F.
			ThisForm.isediting = .F.
			
			ThisForm.SetNormal()
			WAIT WINDOW 'Cancelled' NOWAIT
			
		ELSE   &&do the record delete/recall
			SELECT Alloy_Spec
			IF EOF() OR BOF()
				WAIT WINDOW 'End of File.' NOWAIT
				RETURN
			ENDIF
		
			PRIVATE nMess
			nMess = MESSAGEBOX("Are you sure you want to Delete this Spec?",4+32,"Delete")
			IF nMess != 6
				RETURN
			ENDIF
			
			IF NOT HavePermission('EditCert')
				RETURN
			ENDIF
			
			PRIVATE nID
			nID = Alloy_Spec.ID
			
			cSQL = "DELETE FROM dbo.Alloy_Spec WHERE "
			cSQL = cSQL + " ID = "+STR(nID)
			
			
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle )
			ENDIF
			
			
			ThisForm.Load_Alloy_Spec("REFRESH")
			
			
			IF !EOF() 
				Skip 1
			ENDIF
			IF EOF()
				WAIT WINDOW 'End of file.' NOWAIT
				GO BOTTOM
			ENDIF
			thisform.Refresh
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF ThisForm.isediting
		*	SAVE THIS
				
			IF NOT ThisForm.SaveAdd()
				=MESSAGEBOX("Record could not be saved, you can edit and try to save again.",16)
			ELSE
				ThisForm.isadding =.F.
				ThisForm.SetNormal()
			ENDIF
		ELSE
		*	Start Editting
			IF EOF() OR BOF()
				=MESSAGEBOX('End of File',16)
				RETURN
			ENDIF
		
			IF NOT HavePermission('EditCert')
				RETURN
			ENDIF
			
			ThisForm.SetEditing()
		
		
		ENDIF
		
	ENDPROC

	PROCEDURE cmdEdit.Valid
		SELECT Alloy_Spec
		
		IF ThisForm.isediting
			ThisForm.ALLOY1.SetFocus()
		ENDIF
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmdNext.Click
		SELECT Alloy_Spec
		IF !EOF()
			SKIP 1
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM
		ENDIF
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmdPrev.Click
		SELECT Alloy_Spec
		
		IF !BOF()
			SKIP -1
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file' NOWAIT
			GO TOP
		ENDIF
		Thisform.refresh
	ENDPROC

	PROCEDURE cmdPrint.Valid
		SELECT Alloy_Spec
		
		PRIVATE nCurrntrecrd
		nCurrntrecrd = recno()
		*REPORT FORM Forms\Alloy_Spec RECORD nCurrntrecrd  TO PRINTER PROMPT NOCONSOLE
		GOTO nCurrntrecrd 
	ENDPROC

	PROCEDURE Command1.Click
		BROWSE 
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE DESCRIPTION1.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE REV1.When
