			nPbMAX	= PrepareSQLnum(ThisForm.PbMAX1.Value,'PbMax',8,5)
			nSMIN	= PrepareSQLnum(ThisForm.SMIN1.Value,'SMin',8,5)
			nSMAX	= PrepareSQLnum(ThisForm.SMAX1.Value,'SMax',8,5)
			
			nSiMIN	= PrepareSQLnum(ThisForm.SiMIN1.Value,'SiMin',8,5)
			nSiMAX	= PrepareSQLnum(ThisForm.SiMAX1.Value,'SiMax',8,5)
			nTaMIN	= PrepareSQLnum(ThisForm.TaMIN1.Value,'TaMin',8,5)
			nTaMAX	= PrepareSQLnum(ThisForm.TaMAX1.Value,'TaMax',8,5)
			nTiMIN	= PrepareSQLnum(ThisForm.TiMIN1.Value,'TiMin',8,5)
			nTiMAX	= PrepareSQLnum(ThisForm.TiMAX1.Value,'TiMax',8,5)
			lTiREM	= PrepareSQLchk(ThisForm.TiREM1.Value,'TiRem',.F.)
		
			nVMIN	= PrepareSQLnum(ThisForm.VMIN1.Value,'VMin',8,5)
			nVMAX	= PrepareSQLnum(ThisForm.VMAX1.Value,'VMax',8,5)
			nWMIN	= PrepareSQLnum(ThisForm.WMIN1.Value,'WMin',8,5)
			nWMAX	= PrepareSQLnum(ThisForm.WMAX1.Value,'WMax',8,5)
			lWREM	= PrepareSQLchk(ThisForm.WREM1.Value,'WRem',.F.)
		
			nYMIN		= PrepareSQLnum(ThisForm.YMIN1.Value,'YMin',8,5)
			nYMAX		= PrepareSQLnum(ThisForm.YMAX1.Value,'YMax',8,5)
			nCbTaMIN	= PrepareSQLnum(ThisForm.CbTaMIN1.Value,'CbTaMIN',8,5)
			nCbTaMAX	= PrepareSQLnum(ThisForm.CbTaMAX1.Value,'CbTaMAX',8,5)
			nNiCoMIN	= PrepareSQLnum(ThisForm.NiCoMIN1.Value,'NiCoMIN',8,5)
			nNiCoMAX	= PrepareSQLnum(ThisForm.NiCoMAX1.Value,'NiCoMAX',8,5)
			nFeCrNiMIN	= PrepareSQLnum(ThisForm.FeCrNiMIN1.Value,'FeCrNiMIN',8,5)
			nFeCrNiMAX	= PrepareSQLnum(ThisForm.FeCrNiMAX1.Value,'FeCrNiMAX',8,5)
		
			cStabilize	= PrepareSQLtxt(ThisForm.Stabilize.Value,'Stabilize',20)
			cStabilize2	= PrepareSQLtxt(ThisForm.Stabilize2.Value,'Stabilize2',20)
			cMemo1	 	= PrepareSQLtxt(ThisForm.Memo1.Value,'Memo',-1)
			cexception	= PrepareSQLtxt(ThisForm.exception.Value,'exception',-1)
		
			nID 	= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
			
			
			PRIVATE cSQL, nSQLEXEC 
			IF nID = 0
				*INSERT INTO Alloy_Spec;
		
				cSQL = "INSERT INTO dbo.Alloy_Spec "
				cSQL = cSQL + "(ALLOY,[GROUP],SPEC,REV,DESCRIPTION"
				cSQL = cSQL + ",DIAMAX,DIAMIN,UTSMAX,UTSMIN,YLDMAX,YLDMIN,ELMIN,RAMIN"
				cSQL = cSQL + ",BHNMAX,BHNMIN,RCMAX,RCMIN,RBMAX,RBMIN"
				cSQL = cSQL + ",GRAINMAX,GRAINMIN,ALMIN,ALMAX,ALREM"
				cSQL = cSQL + ",BMIN,BMAX,BeMIN,BeMAX,CMIN,CMAX,CbMIN,CbMAX,CoMIN,CoMAX,CoREM"
				cSQL = cSQL + ",CrMIN,CrMAX,CuMIN,CuMAX,CuREM"
				cSQL = cSQL + ",FeMIN,FeMAX,FeREM"
				cSQL = cSQL + ",HMIN,HMAX,MgMIN,MgMAX,MgREM"
				cSQL = cSQL + ",MoMIN,MoMAX,MoREM"
				cSQL = cSQL + ",MnMIN,MnMAX,NMIN,NMAX,NaMIN,NaMAX,NbMIN,NbMAX,NiMIN,NiMAX,NiREM"
				cSQL = cSQL + ",OMIN,OMAX,PMIN,PMAX,PbMIN,PbMAX,SMIN,SMAX"
				cSQL = cSQL + ",SiMIN,SiMAX,TaMIN,TaMAX,TiMIN,TiMAX,TiREM"
				cSQL = cSQL + ",VMIN,VMAX,[WMIN],[WMAX],WREM"
				cSQL = cSQL + ",YMIN,YMAX,CbTaMIN,CbTaMAX"
				cSQL = cSQL + ",NiCoMIN,NiCoMAX,FeCrNiMIN,FeCrNiMAX"
				cSQL = cSQL + ",Stabilize,Stabilize2,Memo1,Exception"
				cSQL = cSQL + "	) VALUES ( "
				cSQL = cSQL + "'"+cALLOY+"'"
				cSQL = cSQL + ",'"+cGROUP+"'"
				cSQL = cSQL + ",'"+cSPEC+"'"
				cSQL = cSQL + ",'"+cREV+"'"
				cSQL = cSQL + ",'"+cDESCRIPTION+"'"
				cSQL = cSQL + ","+STR(nDIAMAX,7,3)
				cSQL = cSQL + ","+STR(nDIAMIN,7,3)
				cSQL = cSQL + ","+STR(nUTSMAX,10,0)
				cSQL = cSQL + ","+STR(nUTSMIN,10,0)
				cSQL = cSQL + ","+STR(nYLDMAX,10,0)
				cSQL = cSQL + ","+STR(nYLDMIN,10,0)
				cSQL = cSQL + ","+STR(nELMIN,10,0)
				cSQL = cSQL + ","+STR(nRAMIN,10,0)
				cSQL = cSQL + ","+STR(nBHNMAX,3,0)
				cSQL = cSQL + ","+STR(nBHNMIN,3,0)
				cSQL = cSQL + ","+STR(nRCMAX,3,0)
