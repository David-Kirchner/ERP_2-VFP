	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisForm.Load_Alloy_Spec()
		
		SELECT Alloy_Spec
		
		
	ENDPROC

	PROCEDURE load_alloy_spec
		PARAMETERS pWhat
		*ThisForm.Load_Alloy_Spec()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		PRIVATE nID
		nID = 1
		
		IF UPPER(pWhat) ="REFRESH"
			
			IF USED('Alloy_Spec')
				nID = Alloy_Spec.ID
				ThisForm.grdAlloy_Spec.RecordSource=''
				USE IN Alloy_Spec
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('Alloy_Spec')
			SELECT 0
			
			cSQL = "SELECT * FROM dbo.Alloy_Spec "
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Alloy_Spec')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Alloy_Spec')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Alloy_Spec')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Alloy_Spec')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'Alloy_Spec' )
			ENDIF
		
		ENDIF
		
		IF USED('Alloy_Spec')
			
			IF UPPER(pWhat) ="REFRESH"
				GOTO nID
				
				ThisForm.grdAlloy_Spec.RecordSource='Alloy_Spec'
				ThisForm.grdSpec_Check.Column1.ControlSource = Alloy_Spec.Alloy
				ThisForm.grdSpec_Check.Column1.Header1.Caption = "Alloy"
				ThisForm.grdSpec_Check.Column2.ControlSource = Alloy_Spec.Group
				ThisForm.grdSpec_Check.Column2.Header1.Caption = "Group"
				
			ENDIF
		ELSE
			MESSAGEBOX('Failed to load Alloy_Spec',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

	PROCEDURE load_spec_check
		PARAMETERS pWhat
		*ThisForm.Load_Spec_Check()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		PRIVATE nID
		nID = 0
		
		IF UPPER(pWhat) ="REFRESH"
			
			IF USED('Spec_Check')
				nID = Spec_Check.ID
				ThisForm.grdSpec_Check.RecordSource=''
				USE IN Spec_Check
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('Spec_Check')
			SELECT 0
			
			cSQL = "SELECT Alloy,Group,Spec,Rev,Decription,DiaMin,DiaMax FROM dbo.Spec_Check "
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Spec_Check')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Spec_Check')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Spec_Check')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Spec_Check')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'Spec_Check' )
			ENDIF
		
		ENDIF
		
		IF USED('Spec_Check')
			
			IF UPPER(pWhat) ="REFRESH"
				GOTO nID
		
				ThisForm.grdSpec_Check.RecordSource='Spec_Check'
				ThisForm.grdSpec_Check.Column1.ControlSource = Spec_Check.Alloy
				ThisForm.grdSpec_Check.Column1.Header1.Caption = "Alloy"
				ThisForm.grdSpec_Check.Column2.ControlSource = Spec_Check.Group
				ThisForm.grdSpec_Check.Column2.Header1.Caption = "Group"
				ThisForm.grdSpec_Check.Column3.ControlSource = Spec_Check.Spec
				ThisForm.grdSpec_Check.Column3.Header1.Caption = "Spec"
			ENDIF	
		ELSE
			MESSAGEBOX('Failed to load Spec_Check',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

