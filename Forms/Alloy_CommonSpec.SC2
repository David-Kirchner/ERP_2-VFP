	PROCEDURE saveadd
		*PARAMETER pSaveType
		*Thisform.SaveAdd()
		
		PRIVATE lAlloy_Spec_saved
		lAlloy_Spec_saved = .F.
		
		SELECT Alloy_Spec
		
		IF ThisForm.CheckData()
		
			PRIVATE cALLOY,cGROUP,cSPEC,cREV,cDESCRIPTION
			PRIVATE nDIAMAX,nDIAMIN,nUTSMAX,nUTSMIN,nYLDMAX,nYLDMIN,nELMIN,nRAMIN
