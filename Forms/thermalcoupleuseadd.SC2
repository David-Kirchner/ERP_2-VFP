		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'USED1' AS textbox WITH ;
		Height = 23, ;
		Left = 84, ;
		Name = "USED1", ;
		Top = 50, ;
		Width = 72
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		
		SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE Init
		PARAMETERS pLog, pLogID, pLot, pLotID
		*ThisFrom.Visible = .T.
		
		IF VARTYPE(pLog) = "C"
			ThisForm.Log = pLog
		ELSE
			ThisForm.Log = ' '
		ENDIF
		IF VARTYPE(pLogID) = "N"
			ThisForm.LogID = pLogID
		ELSE
			ThisForm.LogID = 0
		ENDIF
		
		IF VARTYPE(pLot) = "N"
			ThisForm.Lot = pLot
		ELSE
			ThisForm.Lot = 0
		ENDIF
		IF VARTYPE(pLotID) = "N"
			ThisForm.LotID = pLotID
		ELSE
			ThisForm.LotID = 0
		ENDIF
		
		ThisForm.HPANAME1.Value	= SPACE(30)
		ThisForm.USED1.Value	= DATE()
		ThisForm.Temp1.Value	= 0
		ThisForm.Hours1.Value	= 0
		
		IF NOT EMPTY(ThisForm.Log)
			*Check for Duplicates
			IF USED('tmpCountTC')
				USE IN tmpCountTC
			ENDIF
			SELECT 0
			
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "SELECT SUM(Hours) AS TotalHours FROM dbo.ThermalCoupleUse WHERE"
			cSQL = cSQL + " [Log]='"+ThisForm.Log+"'"
			cSQL = cSQL + " AND [LogId]="+ STR(ThisForm.LogID)+""
			cSQL = cSQL + " AND [Lot]="+ STR(ThisForm.Lot)+""
			cSQL = cSQL + " AND [LotID]="+ STR(ThisForm.LotID)+""
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountTC' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountTC' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountTC")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountTC")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCountTC' )
			ENDIF
			
			IF USED('tmpCountTC')
				IF VARTYPE(tmpCountTC.TotalHours) = "N"
					IF tmpCountTC.TotalHours > 0
						IF MESSAGEBOX("This Log already has "+ALLTRIM(STR(tmpCountTC.TotalHours))+" TC hours entered."+CHR(13)+"Do you still want to add another TC use? Y/N",4+32,"Found ThermalCouple entry.") != 6
							*USE IN tmpCountTC
							RETURN TO MASTER
						ENDIF
					ENDIF
				ENDIF
				
				USE IN tmpCountTC
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_SQL.prg ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE saveadd
		PRIVATE nUseID, cHPAName, dUsed, nTemp, nHours
		
		*nUseID = ThisForm.UseID1.Value
		cHPAName	= PrepareSQLtxt(ThisForm.HPAName1.Value,'HPAName',50)
		dUsed		= PrepareSQLdate(ThisForm.Used1.Value,'USED')
		nTemp		= PrepareSQLnum(ThisForm.Temp1.Value,'Temp',-2)
		nHours		= PrepareSQLnum(ThisForm.Hours1.Value,'Hours',-1)
		
		*Check Values
		IF EMPTY(cHPAName)
			MESSAGEBOX("You must enter the thermal couple name.",0,"No TC name.")
			RETURN .F.
		ENDIF
		IF VARTYPE(dUsed) != "D"
			MESSAGEBOX("You must enter the Date used.",0,"Not a date.")
			RETURN .F.
		ENDIF
		IF dUsed - 100 > DATE()
			MESSAGEBOX("You must enter the Date used."+CHR(13)+"Date is more than 100 days in future.",0,"Invalid Date.")
			RETURN .F.
		ENDIF
		IF dUsed + 365 < DATE()
			MESSAGEBOX("You must enter the Date used."+CHR(13)+"Date is more than one year old.",0,"Invalid Date.")
			RETURN .F.
		ENDIF
		IF nTemp < 0
			MESSAGEBOX("You must enter the temp used.",0,"Bad temp.")
			RETURN .F.
		ENDIF
		IF nTemp > 2300
			MESSAGEBOX("You must enter the temp used."+CHR(13)+"Oven not capable of over 2300 F.",0,"Bad temp.")
			RETURN .F.
		ENDIF
		IF nHours < 0
			MESSAGEBOX("You must enter the hours used.",0,"Invalid Hours.")
			RETURN .F.
		ENDIF
		IF nHours > 250
			MESSAGEBOX("You must enter the hours used."+CHR(13)+"Not capable of storing over 250 Hours.",0,"Invalid Hours.")
			RETURN .F.
		ENDIF
		
		PRIVATE cLog, nLogId, nLot, nLotID
		cLog	= ThisForm.Log
		nLogId	= ThisForm.LogID 
		nLot	= ThisForm.Lot
		nLotID	= ThisForm.LotID
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "INSERT INTO dbo.ThermalCoupleUse ("
		cSQL = cSQL + "[HPAName], [Used], [Temp], [Hours], [Log], [LogId], [Lot], [LotID]) VALUES ("
		cSQL = cSQL + " '"+ cHPAName+"'"
		cSQL = cSQL + ",'"+ DTOC(dUsed)+"'"
		cSQL = cSQL + ","+ STR(nTemp)+""
		cSQL = cSQL + ","+ STR(nHours)+""
		cSQL = cSQL + ",'"+ cLog +"'"
		cSQL = cSQL + ","+ STR(nLogId)+""
		cSQL = cSQL + ","+ STR(nLot)+""
		cSQL = cSQL + ","+ STR(nLotID)+""
		cSQL = cSQL + ")"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		ENDIF
		
		
		IF IsAMS2750(cHPAName,ThisForm.nConnHandle)
			WAIT WINDOW ALLTRIM(cHPAName)+" is still within AMS 2750" NOWAIT
		ELSE
			MESSAGEBOX( ALLTRIM(cHPAName)+" is NOT within AMS 2750."+CHR(13)+"Please remove this set to do AMS 2750 work.",0+48,"Thermal Couples have expired!" )
		ENDIF
		
	ENDPROC

	PROCEDURE cmdExit.Click
		*ThisFrom.Visible = .F.
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSave.Click
		IF ThisForm.SaveAdd()
			*ThisFrom.Visible = .F.
			ThisForm.Release
		ENDIF
			
		
	ENDPROC

	PROCEDURE Label3.Click
		PRIVATE dDate1,dDate2
		
		dDate1 = ThisForm.USED1.Value
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		ThisForm.USED1.Value = dDate2
	ENDPROC

	PROCEDURE lblTCName.Click
		PRIVATE cHPAName, cTCName
		cHPAname = ThisForm.HPANAME1.Value
		cTCName = ''
		
		DO FORM \Forms\ThermalCoupleNameBrowse WITH cHPAname, ThisForm.nConnHandle TO cTCName
		
		IF NOT EMPTY(cTCName)
			ThisForm.HPANAME1.Value = cTCName
		ENDIF
		
	ENDPROC

ENDDEFINE
