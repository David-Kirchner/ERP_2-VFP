	PROCEDURE checksave
		*ThisForm.CheckSave()
		PRIVATE nLot, cAlloyName, cLotAlloy, nID
		nLot		= PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		cAlloyName	= PrepareSQLtxt(ThisForm.txtAlloyName.Value,'AlloyName',12)
		nID			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		IF nID = 0
			*Add
			IF nLot > 0
				*Check Alloy
				cLotAlloy = GetAlloyName_fromLot(nLot,"R",ThisForm.nConnHandle)
				cLotAlloy = PrepareSQLtxt(cLotAlloy,'AlloyName',12)
				IF cAlloyName != cLotAlloy 
					MESSAGEBOX("This Lot:"+ALLTRIM(STR(nLot))+" for Alloy:'"+ALLTRIM(cLotAlloy)+"'."+CHR(13)+"This LOT cannot be saved with alloy name of '"+ALLTRIM(cAlloyName)+"'.",0+16,"Cannot have different Alloys on same LOT Number!")
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			*Update!	
		ENDIF
		
		
		***** Test PO
		PRIVATE nSrvcPO, nTestPO, nTestitemPO, cLab
		nSrvcPO		= PrepareSQLnum(ThisForm.txtSrvcPO.Value,'SrvcPO',-3)
		nTestPO		= PrepareSQLnum(ThisForm.txtTestPO.Value,'TestPO',-3)
		nTestitemPO	= PrepareSQLnum(ThisForm.txtTestItemPO.Value,'TestItemPO',2,0)
		cLab		= PrepareSQLtxt(ThisForm.txtLab.Value,'Lab',12)
		
		PRIVATE cPOitem, cCountPOItem 
		*Check for POitem
		IF nTestitemPO > 0
			cPOitem = Proper_PO_Item( STR(nTestPO)+"-"+STR(nTestitemPO,2,0) )
			IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
				cCountPOItem = Count_POIteminPurchaseOrder( cPoItem, ThisForm.nConnHandle)
				IF cCountPOItem = 0
					MESSAGEBOX("Test POitem:"+ALLTRIM(cPOitem)+" was not found."+CHR(13)+"Change Test PO or item.",0,+"Cannot Save!")
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		
		IF nTestPO > 0
			IF Count_HPAPOinPurchaseOrder(nTestPO, ThisForm.nConnHandle) = 0
				MESSAGEBOX("Test PO:"+ALLTRIM(STR(nTestPO))+" was not found."+CHR(13)+"Change Test PO.",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		
		IF nSrvcPO > 0
			IF Count_HPAPOinPurchaseOrder(nSrvcPO, ThisForm.nConnHandle) = 0
				MESSAGEBOX("Srvc PO:"+ALLTRIM(STR(nSrvcPO))+" was not found."+CHR(13)+"Change Test PO.",0,+"Cannot Save!")
				RETURN .F.
			ENDIF
		ENDIF
		
		
		
		
		
		
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE Destroy
		IF USED('tmpTesting_Log')
			USE IN tmpTesting_Log
		ENDIF
		
		IF USED('GFMLabs')
			USE IN GFMlabs
		ENDIF
		
		IF WEXIST("frmLog_Detail")
			RELEASE WINDOWS frmLog_Detail
		ENDIF
		
		IF ThisForm.lOpenShip AND USED('Ship')
			USE IN Ship
		ENDIF
	ENDPROC

	PROCEDURE duplots		&& Count the number of within this lot
		*ThisForm.DupLots()
		
		
		PRIVATE nLot
		*nLot = tmpTesting_Log.Lot
		nLot = PrepareSQLnum(ThisForm.txtLot.Value,'Lot',-3)
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpCountLot')	
			USE IN tmpCountLot
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Testing_log WHERE LOT ="+ALLTRIM(STR(nLot))
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCountLot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountLot")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountLot')
		ELSE
			IF USED('tmpCountLot')
		*		IF tmpCountLot.Cntd > 0
					ThisForm.Lots.Caption = ALLTRIM(STR(tmpCountLot.Cntd))
		*		ENDIF
				USE IN tmpCountLot 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE getallrecords
		*ThisForm.getAllrecords()
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpTesting_Log')	
			USE IN tmpTesting_Log
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.Testing_log ORDER BY ID "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTesting_Log')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTesting_Log')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTesting_Log")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTesting_Log")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpTesting_Log')
			RETURN .F.
		ELSE
			*MESSAGEBOX("All records are now loaded",0+64,"See All tmpTesting_Log records!")
			WAIT WINDOW 'Loading All records' NOWAIT
			SELECT tmpTesting_Log
			INDEX ON ID TAG ID
			SET ORDER TO TAG ID
			ThisForm.lSeeAll = .T.
			WAIT CLEAR
		ENDIF
		
		RETURN .T.
	ENDPROC

