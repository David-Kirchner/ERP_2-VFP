	PROCEDURE cmdSO.Valid
		PRIVATE cSOitem, nSalesNum, nItemSO
		nSalesNum	= ThisForm.txtSalesNum.Value
		nItemSO		= ThisForm.txtItemSO.Value
		
		cSOitem = Proper_SO_Item( STR(nSalesNum)+"-"+STR(nItemSO) )
		IF NOT EMPTY('cSOitem')
			DO FORM Forms\ShowvSOitem WITH cSOitem
		ENDIF
		Return
		
		*!*	PRIVATE m.psalesnum, M.CREC
		*!*	m.CREC = RECNO()
		*!*	  IF NOT USED('INQSOLD')
		*!*	    SELECT 0
		*!*	    USE  HPA!inqsold NOUPDATE shared
		*!*	  ELSE
		*!*	    SELECT inqsold
		*!*	  ENDIF
		*!*	  IF USED('INQSOLD')
		*!*	    &&may be locked by another
		*!*	    SELECT tmpTesting_Log
		*!*	    GO TOP
		*!*	    DO WHILE NOT EOF()
		*!*	      IF tmpTesting_Log.salesnum > 0 
		*!*	      *AND EMPTY(tmpTesting_Log.company)
		*!*	      *IF tmpTesting_Log.salesnum > 0
		*!*	        m.psalesnum = tmpTesting_Log.salesnum
		
		*!*	        SELECT inqsold
		
		*!*	        LOCATE FOR salesnum = tmpTesting_Log.salesnum
		*!*	        IF FOUND()
		*!*	          m.company  = inqsold.company
		*!*	          m.shipped  = inqsold.shipped
		*!*	          m.shipdate = inqsold.shipdate
		*!*	          m.SALESP   = inqsold.salesp
		*!*	          M.PO_NUM   = INQSOLD.PO_NUM
		*!*	          M.SALEDATE = INQSOLD.SALEDATE
		
		*!*	          SELECT tmpTesting_Log
		*!*	          SHOW GETS
		*!*	          REPLACE tmpTesting_Log.company  WITH m.company
		*!*	          REPLACE tmpTesting_Log.shipped  WITH m.shipped
		*!*	          REPLACE tmpTesting_Log.shipdate WITH m.shipdate
		*!*	          REPLACE tmpTesting_Log.SALESP   WITH m.SALESP
		*!*	          REPLACE tmpTesting_Log.PO_NUM   WITH M.PO_NUM
		*!*	          REPLACE tmpTesting_Log.SALEDATE WITH M.SALEDATE
		*!*	        ELSE
		*!*	          WAIT WINDOW 'DID NOT FIND SALES NUMBER'+STR(m.psalesnum) NOWAIT
		*!*	        ENDIF
		*!*	      ELSE
		*!*	        *WAIT WINDOW 'NO SALES NUMBER!!' NOWAIT
		*!*	        IF tmpTesting_Log.salesnum = 0 AND NOT EMPTY(tmpTesting_Log.company)
		*!*	          SELECT tmpTesting_Log
		*!*	          REPLACE tmpTesting_Log.company  WITH ""
		*!*	          REPLACE tmpTesting_Log.shipped  WITH .F.
		*!*	          REPLACE tmpTesting_Log.shipdate WITH CTOD("  /  /  ")
		*!*	          REPLACE tmpTesting_Log.SALESP   WITH " "
		*!*	        ENDIF
		*!*	      ENDIF
		*!*	      SELECT tmpTesting_Log
		*!*	      SKIP
		*!*	    ENDDO
		*!*	  ELSE
		*!*	    WAIT WINDOW 'COULD NOT OPEN INQSOLD' NOWAIT
		*!*	  ENDIF
		
		
		*!*	IF USED('INQSOLD')
		*!*	  USE IN Inqsold
		*!*	ENDIF
		*!*	SELECT tmpTesting_Log
		
		*!*	GOTO M.CREC
		*!*	ThisForm.Refresh
	ENDPROC

