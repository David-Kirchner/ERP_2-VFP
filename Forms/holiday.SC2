	PROCEDURE filterbyyear
		IF TYPE("ThisForm.cYear") = "C"
			SELECT HOLIDAY
			SET FILTER TO YEAR(HoliDate) = VAL(ThisForm.cYear)
		ELSE
			WAIT WINDOW "NO YEAR TO FILTER TO" NOWAIT 
			SET FILTER TO
		ENDIF
		
		ThisForm.WIZSCROLLGRID1.Refresh
	ENDPROC

	PROCEDURE nextid
	ENDPROC

	PROCEDURE refreshgrd		&& When Year changes
	ENDPROC

	PROCEDURE BUTTONSET1.cmdAdd.Click
		PRIVATE cCaption
		cCaption = This.Caption
		DODEFAULT()
		
		IF cCaption = "\<Add"
			SELECT Holiday
			REPLACE Holiday.ID WITH VAL( NewID("HOLIDAY") )
			REPLACE Holiday.HoliDate WITH DATE()
			ThisForm.WIZSCROLLGRID1.Column1.CONTAINER1.HOLIDAY1.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE BUTTONSET1.CMDPRINT.Click
		
		SELECT Holiday
		REPORT FORM Quotes\Reports\Holiday.frx TO PRINTER PROMPT
	ENDPROC

	PROCEDURE cmbYear.Init
		PRIVATE nYear, nCurrYear
		nCurrYear = YEAR( DATE() )
		
		IF nCurrYear > 2000
			FOR nYear = 2000 TO nCurrYear
				this.additem(ALLTRIM(STR(nYear)))
			ENDFOR
			This.Value = ALLTRIM(STR(nCurrYear))
			ThisForm.cYear = ALLTRIM(STR(nCurrYear))
			
			ThisForm.FilterByYear()
			
		ELSE
			this.additem('2000')
			This.Value = '2000'
			ThisForm.cYear = '2000'
		ENDIF
	ENDPROC

	PROCEDURE cmbYear.InteractiveChange
		ThisForm.cYear = This.Value
		ThisForm.FilterByYear()
		
	ENDPROC

	PROCEDURE cmdCreateYear.Click
		PRIVATE nYear
		nYear = YEAR( DATE() )
		cYear = ALLTRIM(STR(nYear))
		
		SELECT COUNT(*) AS CntRcds FROM Holiday WHERE YEAR(HoliDate) = nYear AND !DELETED() INTO ARRAY anCntRcds
		
		IF anCntRcds(1) > 0
			MESSAGEBOX( ALLTRIM(STR(anCntRcds(1)))+" records exit for the year "+cYear +"."+CHR(13)+"Change your system clock ahead to create a future year."+CHR(13)+"Or delete entered dates to Create new." ,0,"This Year already Exits!" )
		ELSE
			INSERT INTO Holiday (ID,Holiday,HoliDate) VALUES (VAL(NewID("HOLIDAY")), "New Years Day", CTOD("01/01/"+cYear) )
			INSERT INTO Holiday (ID,Holiday,HoliDate) VALUES (VAL(NewID("HOLIDAY")), "Memorial Day ", CTOD("05/31/"+cYear) )
			INSERT INTO Holiday (ID,Holiday,HoliDate) VALUES (VAL(NewID("HOLIDAY")), "July 4th", CTOD("07/04/"+cYear) )
			INSERT INTO Holiday (ID,Holiday,HoliDate) VALUES (VAL(NewID("HOLIDAY")), "Labor Day ", CTOD("09/06/"+cYear) )
			INSERT INTO Holiday (ID,Holiday,HoliDate) VALUES (VAL(NewID("HOLIDAY")), "Thanksgiving", CTOD("11/25/"+cYear) )
			INSERT INTO Holiday (ID,Holiday,HoliDate) VALUES (VAL(NewID("HOLIDAY")), "Thanksgiving - Day after", CTOD("11/26/"+cYear) )
			INSERT INTO Holiday (ID,Holiday,HoliDate) VALUES (VAL(NewID("HOLIDAY")), "Christmas Eve", CTOD("12/24/"+cYear) )
			INSERT INTO Holiday (ID,Holiday,HoliDate) VALUES (VAL(NewID("HOLIDAY")), "Christmas Day", CTOD("12/25/"+cYear) )
			INSERT INTO Holiday (ID,Holiday,HoliDate) VALUES (VAL(NewID("HOLIDAY")), "New Years Eve", CTOD("12/31/"+cYear) )
			
			ThisForm.FilterByYear()
			
			MESSAGEBOX("Dates needs to be adjusted !",0,"Some dates are not a consistant date!")
			
		ENDIF
	ENDPROC

ENDDEFINE
