	PROCEDURE lblBrandName.Click
		PRIVATE cAlloy, cBrandName
		cAlloy = ThisForm.ALLOY1.Value
		cBrandName = ""
		
		IF USED('AlloyBrandName')
			SELECT AlloyBrandName
		ELSE
			SELECT 0
		ENDIF
		
		IF !EMPTY(cAlloy)
			cSQL = "SELECT [BrandName] FROM dbo.Alloy WHERE Alloy = '"+cAlloy+"'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AlloyBrandName')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AlloyBrandName')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AlloyBrandName')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AlloyBrandName')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "AlloyBrandName")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "AlloyBrandName")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'AlloyBrandName')
			ENDIF
		
		
			IF USED("AlloyBrandName")
				IF NOT ISNULL(AlloyBrandName.BrandName)
					cBrandName = AlloyBrandName.BrandName
				ENDIF
				USE IN AlloyBrandName
			ENDIF
		
			IF NOT EMPTY(cBrandName)
			
		*		IF UPPER(lcSearchStr) = SUBSTR(cBrandName,1,lnInsertionPt)
					ThisForm.BrandName1.Value = cBrandName
		*			THIS.FORECOLOR = RGB(0,0,0)
		*		ELSE
		*			THIS.FORECOLOR = RGB(255,0,0)
		*		ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE lblCalcmS_QTY.Click
		PRIVATE m.nID,nmS_QTY
		m.nID	= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3,0)
		nmS_QTY = Calc_Master_QTY( m.nID, ThisForm.cTBL, ThisForm.nConnHandle )
		
		IF nmS_QTY > 0
			ThisForm.mS_QTY1.Value = nmS_QTY
			WAIT WINDOW "mS_QTY = "+ALLTRIM(STR(nmS_QTY)) NOWAIT
		ELSE
			MESSAGEBOX("Did not Count any Detail Quantity belonging to this Master!",32,"QTY is Empty")
		ENDIF
	ENDPROC

	PROCEDURE lblGetMWeight.Click
		PRIVATE m.nID,nMWeight
		m.nID	= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3,0)
		nMWeight = CalcMasterWeight( m.nID, ThisForm.Lst, ThisForm.nConnHandle )
		
		IF nMWeight > 0
			ThisForm.MWEIGHT1.Value = nMWeight
			WAIT WINDOW "MWeight = "+ALLTRIM(STR(nMWeight)) NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE LBLPODUEDATE1.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(ThisForm.PODUEDATE1.Value)
			dDate1 = ThisForm.PODUEDATE1.Value 
		ELSE
			dDate1 = DATE()
		ENDIF
		
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.PODUEDATE1.Value = dDate2
	ENDPROC

	PROCEDURE LBLPO_ITEM1.Click
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(ThisForm.PO_Item1.Value,'PO_Item',13)
		IF Proper_PO_Item(cPOitem) != Proper_PO_Item("")
			DO FORM Forms\ShowPO WITH cPOitem
		ENDIF
		
	ENDPROC

	PROCEDURE lblProjID.Click
		PRIVATE nProjID
		nProjID= PrepareSQLnum(This.Parent.ProjID1.Value,'ProjID',-3)
		
		IF nProjID > 0
			DO FORM Forms\Stock_Projected WITH "SHOW","Stock_Projected_ID",nProjID
		ELSE
			MESSAGEBOX("No nProjID number.",0,"Cannot show 'Stock_Projected' window.")
		ENDIF
		
	ENDPROC

	PROCEDURE LBLSPECS1.Click
		PRIVATE cSQL, nSQLEXEC, lOK, cPOitem
		lOK = .T.
		cPOitem = ''
		
		*IF EMPTY(ThisForm.RecvStockPOitem)
			cPOitem = Proper_PO_item(ThisForm.PO_ITEM1.Value)
		*	IF NOT EMPTY(cPOitem)
		*		ThisForm.RecvStockPOitem = cPOitem
		*	ENDIF
		*ENDIF
		
		IF NOT EMPTY(cPOitem)
			
			DO CASE
			CASE ThisForm.Lst = "StockLst"
				cSQL = "SELECT specs FROM dbo.StockLst_Master WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+cPOitem+"')"
			CASE ThisForm.Lst = "BrokerLst"
				cSQL = "SELECT specs FROM dbo.BrokerLst_Master WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+cPOitem+"')"
			CASE ThisForm.Lst = "WIPLst"
				cSQL = "SELECT specs FROM dbo.WIPLst_Master WHERE dbo.f_ProperPOitem(PO_item) = dbo.f_ProperPOitem('"+cPOitem+"')"
			ENDCASE
		
			*Like '%"+ALLTRIM(THISFORcPOitem)+"'"
			*"+ThisForm.Lst+"
			IF USED("tmpLst_Master")
				SELECT tmpLst_Master
			ELSE
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLst_Master' )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLst_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLst_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpLst_Master')
				lOK = .F.
			ELSE
				IF USED("tmpLst_Master")
					MESSAGEBOX("PO "+ALLTRIM(cPOitem)+" was written to the Spec:"+CHR(13)+tmpLst_Master.specs,0,"PO on Spec")
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("tmpLst_Master")
			USE IN tmpLst_Master
		ENDIF
		
	ENDPROC

	PROCEDURE lblWO_Detail.Click
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(This.Parent.WO_Detail1.Value,'WO_Detail',-3)
		
		IF nWO_Detail > 0
			DO FORM Forms\WorkOrder WITH "EDIT",0,nWO_Detail,'','',''
		ELSE
			MESSAGEBOX("No WO Detail number.",0,"Cannot show 'WO Detail' window.")
		ENDIF
	ENDPROC

	PROCEDURE LOT1.GotFocus
		this.InputMask = ""
	ENDPROC

	PROCEDURE LOT1.LostFocus
		this.InputMask = "XXXXXXXXXX"
	ENDPROC

	PROCEDURE LOT1.Valid
		PRIVATE cLOT
		cLot = PrepareSQLtxt(This.Value,'Lot',10)
		cLot = ALLTRIM(cLot)
		
		IF THISFORM.txtTableName.VALUE = "StockLst"
			IF THISFORM.WhatDo = "ADD"
				IF NOT EMPTY(cLot)
					
					IF "HPA" $ UPPER(cLot)
						*Check Heat
						PRIVATE cSQL
		
						cSQL = "SELECT DISTINCT Heat FROM dbo.[AR.StockLst_Master_History WHERE LOT = '"+cLot+"' ORDER BY Heat "
		
						IF USED("tmpStockLst_Master_Heat")
							SELECT tmpStockLst_Master_Heat
						ELSE
							SELECT 0
						ENDIF
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_Heat')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_Heat')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_Heat")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 1' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_Heat")
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_Heat")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_Heat")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master_Heat')
						ELSE
							IF USED("tmpStockLst_Master_ID")
								IF RECCOUNT('tmpStockLst_Master_Heat') > 0
									
									cMess = "Lot number check!"+CHR(13)+"Found other heats with this LOT, Please do not duplicate!"+CHR(13)
									SCAN
										cMess = cMess + tmpStockLst_Master_Heat.Heat+CHR(13)
									ENDSCAN
									cMess = cMess + CHR(13) + "Answer (N) to not check DELETED history also."
									IF MESSAGEBOX(cMess,4+48,"Do you have a new Heat\Lot?") = 7
										RETURN .F.
									ENDIF
									
		
								ELSE
									*Check current - Should be done as Add, not completly new.
								
								ENDIF
								USE IN tmpStockLst_Master_Heat
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE MWEIGHT1.GotFocus
		this.InputMask = "99999999.99"
	ENDPROC

	PROCEDURE MWEIGHT1.LostFocus
		this.InputMask = "99,999,999.99"
	ENDPROC

	PROCEDURE MWEIGHT1.Valid
		IF THISFORM.WhatDo = "ADD" 
			IF PrepareSQLnum(This.Value,'mWeight',9,1) > 0
				MESSAGEBOX( "This weight should be 0 when adding a new Master, each detail added later will show up here automatically",0,"New Add should be 0")
				*This.Value = 0	
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE PAID1.GotFocus
		this.InputMask = "99999999.99"
	ENDPROC

	PROCEDURE PAID1.LostFocus
		this.InputMask = "99,999,999.99"
	ENDPROC

	PROCEDURE PO_ITEM1.GotFocus
		This.InputMask='999999999-99'
	ENDPROC

	PROCEDURE PO_ITEM1.LostFocus
		This.InputMask='' &&999999999-99
		
	ENDPROC

	PROCEDURE PO_ITEM1.Valid
		IF NOT EMPTY(This.Value)
			PRIVATE cPO_Item, nItem
			cPO_Item = This.Value
			*If Item is ignored, insert 01
			nItem = VAL( RIGHT( ALLTRIM(cPO_Item),2 ) )
			IF nItem = 0
				cPO_Item = LEFT( cPO_Item, LEN(cPO_Item)-3 )+"-01"
			ENDIF
			cPO_Item = Proper_PO_item( cPO_Item )
			IF cPO_Item = Proper_PO_item( '1-01' ) OR cPO_Item = Proper_PO_item( '0-01' ) OR cPO_Item = '       -1-01'
				WAIT WINDOW "Removing bad PO-item" NOWAIT
				cPO_Item = Proper_PO_item( '0-00' )
			ENDIF
			This.Value = cPO_Item
		ENDIF
	ENDPROC

	PROCEDURE SIZE1.GotFocus
		this.InputMask = "9999999.999"
	ENDPROC

	PROCEDURE SIZE1.LostFocus
		this.InputMask = "9,999,999.999"
	ENDPROC

	PROCEDURE SIZE1.Valid
		PRIVATE nSize
		nSize = PrepareSQLnum(This.Value,'Size',9,3)
		
		IF nSize = 0
			MESSAGEBOX( "You must enter a valid size",0+16,"No Size!")
			RETURN -1
		ENDIF
		
		PRIVATE cAlloy,cForm
		cAlloy = PrepareSQLtxt(ThisForm.ALLOY1.Value,'Alloy',12)
		cForm = PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		
		PRIVATE cCC, cCL
		cCC = PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL = PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		
		PRIVATE nStandardSize 
		nStandardSize = getStandardSize_Common_CC_CL(nSize,cAlloy,cForm,cCC,cCL,ThisForm.nConnHandle)
		
		IF nStandardSize = 0
			nStandardSize = getStandardSize_Alloy_Form(nSize, cAlloy, cForm, ThisForm.nConnHandle)  &&Check Price Table!
			*nStandardSize = getPriceTableStandardSize( nSize, cAlloy, cForm, cCC, ThisForm.nConnHandle)
		ENDIF
		
		IF nStandardSize = 0
			nStandardSize = getStandardSize(nSize, ThisForm.nConnHandle)
		ENDIF
		
		IF nStandardSize > 0
			IF nStandardSize != nSize
				IF cForm = '10' OR cForm = '40'
					MESSAGEBOX("Not a 'Standard Size'! "+ALLTRIM(STR(nSize,9,4))+CHR(13)+"You may need to adjust your Size Entered!"+CHR(13)+"A 'Standard' Size would be its PriceTable size!"+CHR(13)+[Example: A plate that mic's .995" would still be priced as 1" plate.],0+16,"Size Entered is not a Price Table Standard")
					RecordTest('Record Test Data.', "StockLst_Master.Size1.Valid", LINENO(1), "Not a Standard Size!"+" Size tried was "+ALLTRIM(STR(nSize,9,4))+"  Alloy "+ALLTRIM(cAlloy)+"  Form "+cForm )
					*TrackError("Not a Standard Size!"+":StockLst_Master.Size1.Valid Size tried was "+ALLTRIM(STR(nSize,9,4)),"Not a Standard Size","frmStockLst_Master.SIZE1.Valid",14)
					*MESSAGEBOX("A 'Standard' Size would be its PriceTable size!"+CHR(13)+[Example: A plate that mic's .995" would still be priced as 1" plate.],0+48,"What is STANDARD.")
					
					
					FOR nPrevSize = nSize TO 0 STEP -.001
						nPrevStandardSize = getStandardSize(nPrevSize, ThisForm.nConnHandle)
						IF nPrevStandardSize <= nStandardSize 
							This.Value = nPrevStandardSize
							EXIT
						ENDIF
					NEXT nPrevSize 
				ENDIF
							
		*		RETURN -1
			ENDIF
		ENDIF
		
		
		
		IF nStandardSize = 0
			PRIVATE nMess
			nMess= MESSAGEBOX("Could not get a Standard Price Table Size!"+CHR(13)+"Do you want to override the SizeStandard ? (Y/N)"+CHR(13)+CHR(13)+"You may need to adjust your Size entered!"+CHR(13)+"Answer No to enter another Size."+CHR(13)+"Answer yes to override and this will be recorded as an error!",0+4+256,"Override Price Table Standard Size?") 
			IF nMess = 6 &&Yes
		*	TrackMess("Could not get a Standard Size!"+":StockLst_Master.Size1.Valid Size tried was "+ALLTRIM(STR(nSize,9,4)))
				PRIVATE nID
				nID = PrepareSQLnum(ThisForm.id1.Value,'ID',-3)
				TrackError("Could not get a Price Table Standard Size! ",":Size1 Size tried was "+ALLTRIM(STR(nSize,9,4))+CHR(13)+" ID:"+ALLTRIM(STR(nID))+CHR(13)+" Form:"+cForm+CHR(13)+"Could not get a Standard Size!"+CHR(13)+"User Override.","frmStockLst_Master.SIZE1.Valid",LINENO(1))
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
	ENDPROC

ENDDEFINE
