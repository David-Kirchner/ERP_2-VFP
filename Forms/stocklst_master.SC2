	PROCEDURE countdetail
		*ThisForm.CountDetail()
		
		PRIVATE nReturn
		nReturn = 0
		
		PRIVATE cSQL, nSQLEXEC
		
		DO CASE
		CASE ThisForm.Lst = "StockLst"
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.StockLst_Detail WHERE ID = "+	STR(THISFORM.ID)
		CASE ThisForm.Lst = "BrokerLst"
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.BrokerLst_Detail WHERE ID = "+ STR(THISFORM.ID)
		CASE ThisForm.Lst = "WIPLst"
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WIPLst_Detail WHERE ID = "+ STR(THISFORM.ID)
		ENDCASE
		
		IF USED("cntStockLst_Detail")
			SELECT cntStockLst_Detail
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockLst_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockLst_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockLst_Detail' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntStockLst_Detail' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockLst_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntStockLst_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntStockLst_Detail')
		ELSE
			IF USED("cntStockLst_Detail")
				
				IF ThisForm.WhatDo != "ADD"
					IF RECCOUNT('cntStockLst_Detail') > 0
						nReturn = cntStockLst_Detail.CNTD
					ENDIF
				ENDIF
				USE IN cntStockLst_Detail
			ENDIF
		ENDIF
		RETURN nReturn
	ENDPROC

	PROCEDURE getbyid
		PRIVATE cSQL, nSQLEXEC
		
		DO CASE
		CASE ThisForm.cTBL 	= "S"
			cSQL = "SELECT * FROM dbo.StockLst_Master WHERE ID = "+	STR(THISFORM.ID)
		CASE ThisForm.cTBL 	= "B"
			cSQL = "SELECT * FROM dbo.BrokerLst_Master WHERE ID = "+ STR(THISFORM.ID)
		CASE ThisForm.cTBL 	= "W"
			cSQL = "SELECT * FROM dbo.WIPLst_Master WHERE ID = "+ STR(THISFORM.ID)
		ENDCASE
		
		
		IF USED("tmpStockLst_Master")
			SELECT tmpStockLst_Master
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master')
		ELSE
			IF USED("tmpStockLst_Master")
		
				IF ThisForm.WhatDo = "ADD"
					ThisForm.From_ID1.Value	= tmpStockLst_Master.ID
					THISFORM.ID = 0
					ThisForm.ID1.Value = 0
					
					ThisForm.PO_Item1.Value		= ""
					ThisForm.PODueDate1.Value	= DATE()
					ThisForm.Paid1.Value		= 0
					ThisForm.MWeight1.Value		= 0
					ThisForm.mS_QTY1.Value		= 0
				ELSE
					*Edit
					THISFORM.ID 			= PrepareSQLnum(tmpStockLst_Master.ID,"ID",-3)
					ThisForm.ID1.Value		= PrepareSQLnum(tmpStockLst_Master.ID,"ID",-3)
					ThisForm.From_ID1.Value	= PrepareSQLnum(tmpStockLst_Master.From_ID,"From_ID",-3)
					
					ThisForm.PO_Item1.Value		= Proper_PO_item( IIF(ISNULL(tmpStockLst_Master.PO_Item ),'',tmpStockLst_Master.PO_Item ))
					ThisForm.PODueDate1.Value	= TTOD(IIF(ISNULL(tmpStockLst_Master.PODueDate),CTOT('  /  /  '),IIF(tmpStockLst_Master.PODueDate=CTOD('01/01/1900'),CTOT('  /  /  '),tmpStockLst_Master.PODueDate)))
					ThisForm.Paid1.Value		= IIF(ISNULL(tmpStockLst_Master.Paid),0,tmpStockLst_Master.Paid)
					PRIVATE nMWeight, nmS_QTY
					nMWeight	= IIF(ISNULL(tmpStockLst_Master.MWeight),0,tmpStockLst_Master.MWeight)
					nmS_QTY		= PrepareSQLnum(tmpStockLst_Master.mS_QTY,'mS_QTY',-5)
					IF nMWeight = 0
						nMWeight = CalcMasterWeight(  ThisForm.ID, ThisForm.Lst, ThisForm.nConnHandle ) &&CalcMasterWeight should be using cTBL!
					ENDIF
					IF nmS_QTY = 0
						nmS_QTY = Calc_Master_QTY( ThisForm.ID, ThisForm.cTBL, ThisForm.nConnHandle )
					ENDIF
					ThisForm.MWeight1.Value		= nMWeight
					ThisForm.mS_QTY1.Value		= nmS_QTY
				ENDIF
				*IIF(ISNULL(tmpStockLst_Master.),0,tmpStockLst_Master.)
				ThisForm.Alloy1.Value		= ShowSQLtxt(tmpStockLst_Master.Alloy,'Alloy',12)
				ThisForm.cmbForm.Value		= ShowSQLtxt(tmpStockLst_Master.Form,'Form',2)
				ThisForm.cmbCC.Value		= ShowSQLtxt(tmpStockLst_Master.CC,'CC',1)
				ThisForm.cmbCL.Value		= ShowSQLtxt(tmpStockLst_Master.CL,'CL',1)
				ThisForm.Cond1.Value		= ShowSQLtxt(tmpStockLst_Master.Cond,'Cond',50)
				ThisForm.Size1.Value		= PrepareSQLnum(tmpStockLst_Master.Size,'Size',9,3)
				ThisForm.Specs1.Value		= ShowSQLtxt(tmpStockLst_Master.specs,'Specs',160)
				ThisForm.Heat1.Value		= ShowSQLtxt(tmpStockLst_Master.Heat,'Heat',50)
				ThisForm.Lot1.Value			= ShowSQLtxt(tmpStockLst_Master.Lot,'Lot',10)
				ThisForm.History1.Value		= ShowSQLtxt(tmpStockLst_Master.History,'History',20)
				ThisForm.Mill1.Value		= ShowSQLtxt(tmpStockLst_Master.Mill,'Mill',10)
		*		IF ThisForm.WhatDo = "EDIT"
		*			ThisFormset.frmStockLst_Sum.cmbForm.Value = ThisFormset.QUOTES.cmbForm.Value
		*			ThisForm.cmbForm
		*		ENDIF
		*		ThisForm.StkDate1.Value		= TTOD(IIF(ISNULL(tmpStockLst_Master.StkDate),'  /  /  ',tmpStockLst_Master.StkDate))
				ThisForm.StkDate1.Value		= TTOD(IIF(ISNULL(tmpStockLst_Master.StkDate),CTOT('  /  /  '),IIF(tmpStockLst_Master.StkDate=CTOD('01/01/1900'),CTOT('  /  /  '),tmpStockLst_Master.StkDate)))
				ThisForm.Num1.Value			= PrepareSQLnum(tmpStockLst_Master.Num,'Num',-3)
				ThisForm.ProjID1.Value		= PrepareSQLnum(tmpStockLst_Master.ProjID,'ProjID',-3)
				ThisForm.WO_Detail1.Value	= PrepareSQLnum(tmpStockLst_Master.WO_Detail,'WO_Detail',-3)
				
				ThisForm.cmbMelt.Value		= RTRIM(IIF(ISNULL(tmpStockLst_Master.Melt),'-',tmpStockLst_Master.Melt))
				ThisForm.cmbPOStatus.Value 	= ShowSQLtxt(tmpStockLst_Master.POStatus,'POStatus',1)
				ThisForm.BrandName1.Value	= ShowSQLtxt(tmpStockLst_Master.BrandName,'BrandName',20)
				ThisForm.chkMillTrace.Value = PrepareSQLlogic(tmpStockLst_Master.MillTrace,'MillTrace',.NULL.)
		
			ELSE
				THISFORM.InitMemVar()
			ENDIF
		
		
		ENDIF
		
		IF USED("tmpStockLst_Master")
			USE IN tmpStockLst_Master
		ENDIF
		
	ENDPROC

	PROCEDURE getbyid_detailinhistory
		PARAMETERS nID_History
		*ThisForm.GetByID_DetailinHistory
		
		
		IF VARTYPE(nID_History) != "N"
			nID_History = 0
		ENDIF
		
		IF nID_History < 1
			MESSAGEBOX("Cannot Retrieve History",0,"Parameter Error")
			THISFORM.InitMemVar()
			RETURN .F.
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		
		
		DO CASE
		CASE ThisForm.Lst = "StockLst"
			cSQL = "SELECT alloy,form,cc,CL,size,cond,mweight,specs,heat,lot,Paid,po_item,poduedate,mill,stkdate,history,num,POStatus,BrandName,MillTrace,FROM_ID,Melt,id"
			cSQL = cSQL + " FROM dbo.[AR.StockLst_Master_History WHERE ID_History = "+	STR(nID_History)
		CASE ThisForm.Lst = "BrokerLst"
			cSQL = "SELECT alloy,form,cc,CL,size,cond,mweight,specs,heat,lot,Paid,po_item,poduedate,mill,stkdate,history,num,POStatus,BrandName,MillTrace,FROM_ID,Melt,id"
			cSQL = cSQL + " FROM dbo.[AR.BrokerLst_Master_History WHERE ID_History = "+	STR(nID_History)
		CASE ThisForm.Lst = "WIPLst"
			cSQL = "SELECT alloy,form,cc,CL,size,cond,mweight,specs,heat,lot,Paid,po_item,poduedate,mill,stkdate,history,num,POStatus,BrandName,MillTrace,FROM_ID,Melt,id"
			cSQL = cSQL + " FROM dbo.[AR.WIPLst_Master_History WHERE ID_History = "+	STR(nID_History)
		ENDCASE
		
		IF USED("tmpStockLst_Master")
			SELECT tmpStockLst_Master
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master')
		ELSE
			IF USED("tmpStockLst_Master")
		*		IF ThisForm.WhatDo = "ADD"
		*			ThisForm.From_ID1.Value	= tmpStockLst_Master.ID
		*			THISFORM.ID = 0
		*			ThisForm.ID1.Value = 0
		*			
		*			ThisForm.PO_Item1.Value		= ""
		*			ThisForm.PODueDate1.Value	= DATE()
		*			ThisForm.Paid1.Value		= 0
		*			ThisForm.MWeight1.Value		= 0
		*			ThisForm.mS_QTY1.Value 		= 0
		*		ELSE
					*Edit
					ThisForm.ID_History	= nID_History
					THISFORM.ID 			= tmpStockLst_Master.ID
					ThisForm.ID1.Value		= tmpStockLst_Master.ID
					ThisForm.From_ID1.Value	= tmpStockLst_Master.From_ID
					
					ThisForm.PO_Item1.Value		= Proper_PO_item( IIF(ISNULL(tmpStockLst_Master.PO_Item ),'',tmpStockLst_Master.PO_Item ))
		*			ThisForm.PODueDate1.Value	= TTOD(IIF(ISNULL(tmpStockLst_Master.PODueDate),'  /  /  ',tmpStockLst_Master.PODueDate))
					ThisForm.PODueDate1.Value	= TTOD(IIF(ISNULL(tmpStockLst_Master.PODueDate),CTOT('  /  /  '),IIF(tmpStockLst_Master.PODueDate=CTOD('01/01/1900'),CTOT('  /  /  '),tmpStockLst_Master.PODueDate)))
					ThisForm.Paid1.Value		= PrepareSQLnum(tmpStockLst_Master.Paid,'Paid',-5)
					ThisForm.MWeight1.Value		= PrepareSQLnum(tmpStockLst_Master.MWeight,'MWeight',18,8)	
					ThisForm.mS_QTY1.Value		= PrepareSQLnum(tmpStockLst_Master.mS_QTY,'mS_QTY',-5)		
		*		ENDIF
		
				ThisForm.Alloy1.Value		= ShowSQLtxt(tmpStockLst_Master.Alloy,'Alloy',12)
				ThisForm.cmbForm.Value		= ShowSQLtxt(tmpStockLst_Master.Form,'Form',2)
				ThisForm.cmbCC.Value		= ShowSQLtxt(tmpStockLst_Master.CC,'CC',1)
				ThisForm.cmbCL.Value		= ShowSQLtxt(tmpStockLst_Master.CL,'CL',1)
				ThisForm.Cond1.Value		= ShowSQLtxt(tmpStockLst_Master.Cond,'Cond',50)
				ThisForm.Size1.Value		= ShowSQLtxt(tmpStockLst_Master.Size,'Size',9,3)
				ThisForm.Specs1.Value		= ShowSQLtxt(tmpStockLst_Master.specs,'Specs',160)
				ThisForm.Heat1.Value		= ShowSQLtxt(tmpStockLst_Master.Heat,'Heat',50)
				ThisForm.Lot1.Value			= ShowSQLtxt(tmpStockLst_Master.Lot,'Lot',10)
				ThisForm.History1.Value		= ShowSQLtxt(tmpStockLst_Master.History,'History',20)
				ThisForm.Mill1.Value		= ShowSQLtxt(tmpStockLst_Master.Mill,'Mill',10)
				
		*		ThisForm.StkDate1.Value		= TTOD(IIF(ISNULL(tmpStockLst_Master.StkDate),'  /  /  ',tmpStockLst_Master.StkDate))
				ThisForm.StkDate1.Value		= TTOD(IIF(ISNULL(tmpStockLst_Master.StkDate),CTOT('  /  /  '),IIF(tmpStockLst_Master.StkDate=CTOD('01/01/1900'),CTOT('  /  /  '),tmpStockLst_Master.StkDate)))
				ThisForm.Num1.Value			= PrepareSQLnum(tmpStockLst_Master.Num,'Num',-3)
				ThisForm.ProjID1.Value		= PrepareSQLnum(tmpStockLst_Master.ProjID,'ProjID',-3)
				ThisForm.WO_Detail1.Value	= PrepareSQLnum(tmpStockLst_Master.WO_Detail,'WO_Detail',-3)
		
				ThisForm.cmbMelt.Value 		= RTRIM(IIF(ISNULL(tmpStockLst_Master.Melt),'-',tmpStockLst_Master.Melt))
				ThisForm.cmbPOStatus.Value 	= ShowSQLtxt(tmpStockLst_Master.POStatus,'POstatus',1)
				ThisForm.BrandName1.Value	= ShowSQLtxt(tmpStockLst_Master.BrandName,'BrandName',20)
				ThisForm.chkMillTrace.Value = PrepareSQLlogic(tmpStockLst_Master.MillTrace,'MillTrace',.NULL.)
				
			ELSE
				THISFORM.InitMemVar()
				RETURN .F.
			ENDIF
		
		ENDIF
		
		IF USED("tmpStockLst_Master")
			USE IN tmpStockLst_Master
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE getby_master_id
	ENDPROC

	PROCEDURE Init
		PARAMETER cWhatDo, nID, pTableName
		**DO FORM Forms\StockLst_Master WITH "EDIT", 1000, "StockLst"
		*DO FORM Forms\StockLst_Master WITH "EDIT", 6237, "StockLst"  &&HAS CC of 'C'
		*DO FORM Forms\StockLst_Master WITH "ADD", nID, "StockLst"
		IF TYPE('cWhatDo') = "C"
			DO CASE
			CASE cWhatDo= "ADD"
				ThisForm.WhatDo = "ADD"
			CASE cWhatDo= "EDIT"
				ThisForm.WhatDo = "EDIT"
		*	CASE cWhatDo= "VIEW"
		*		ThisForm.WhatDo = "VIEW"
			OTHERWISE
				MESSAGEBOX("Need PARAMETER: 'EDIT', nID_Master",0,"ERROR")
				CANC
			ENDCASE
		ELSE
			MESSAGEBOX("Need PARAMETER: 'EDIT', nID_Master",0,"ERROR")
			CANC
		ENDIF
		
		
		Load_postatusdef(ThisForm.nConnHandle)
		*Load_Alloys(ThisForm.nConnHandle)
		
		
		IF TYPE("pTableName") != "C"
			pTableName = "StockLst"
		ENDIF
		DO CASE
		CASE pTableName = "StockLst" OR  pTableName = "S"
			ThisForm.txtTableName.Value = "StockLst"
			ThisForm.Lst 	= "StockLst"
			ThisForm.cTBL 	= "S"
			ThisForm.cmdSaveToStock.Visible = .F.
			
		CASE pTableName = "BrokerLst" OR  pTableName = "B"
			ThisForm.txtTableName.Value = "BrokerLst"
			ThisForm.Lst 	= "BrokerLst"
			ThisForm.cTBL 	= "B"
			ThisForm.cmdSaveToStock.Visible = .T.
			
		CASE pTableName = "WIPLst" OR pTableName = "W"
			ThisForm.txtTableName.Value = "WIPLst" 
			ThisForm.Lst 	= "WIPLst"
			ThisForm.cTBL 	= "W"
			ThisForm.cmdSaveToStock.Visible = .T.
		ENDCASE
		
		ThisForm.ID = 0
		*IF TYPE("nID") = "N"
			IF ThisForm.WhatDo = "ADD"
				ThisForm.ID = PrepareSQLnum(nID,'Master_ID',-3)
			ENDIF
			IF ThisForm.WhatDo = "EDIT"
				ThisForm.ID = PrepareSQLnum(nID,'Master_ID',-3)
			ENDIF
		*ELSE
			
		*ENDIF
		
		ThisForm.cmdSearch.Visible = .F.
		
		IF ThisForm.WhatDo = "ADD"
			ThisForm.cmdSearch.Visible = .T.
			
			IF ThisForm.ID = 0
				ThisForm.InitMemVar()
			ELSE
				*Clone!
				ThisForm.GetByID()
			ENDIF
		ENDIF
		
		IF ThisForm.WhatDo = "EDIT"
			ThisForm.GetByID()
			IF ThisForm.ID = 0
				MESSAGEBOX("ID Not Found to Edit",0,"Nothing to do")
				ThisForm.cmdSave.Visible = .F.
				ThisForm.cmdSaveToStock.Visible = .F.
				ThisForm.cmdPrint.Visible = .F.
				ThisForm.cmdDelete.Visible = .F.
			ELSE
				IF ThisForm.CountDetail() = 0
					MESSAGEBOX("There is a problem with this record."+CHR(13)+"The stock list is made of many tables."+CHR(13)+"This Master record (Heat) should have detail records (cut length)."+CHR(13)+"No detail records where found!",48,"Broken record!")
					ThisForm.cmdDelete.Visible = .T.
				ENDIF
			ENDIF
		ENDIF
		
		*ThisForm.Specs1.SetFocus
		ThisForm.Alloy1.Setfocus
		
	ENDPROC

	PROCEDURE initcmbcl
		*ThisForm.InitcmbCL()
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		ThisForm.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		ThisForm.cmbCL.ColumnCount = 2
		ThisForm.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		ThisForm.cmbCL.BoundColumn = 1
		ThisForm.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					ThisForm.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					ThisForm.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		ThisForm.cmbCL.Value = cCL1
		
		IF ThisForm.CC != PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
			ThisForm.CC = PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		*	This.Parent.cmbCL.Value = ''
			ThisForm.cmbCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
			ThisForm.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE initmemvar
		ThisForm.ID1.Value			= THISFORM.ID
		ThisForm.Alloy1.Value		= ""
		ThisForm.cmbForm.Value		= ""
		ThisForm.cmbCC.Value		= "1"
		ThisForm.cmbCL.Value		= ""
		ThisForm.Cond1.Value		= ""
		ThisForm.Size1.Value		= 0
		ThisForm.Paid1.Value		= 0
		ThisForm.MWeight1.Value		= 0
		ThisForm.mS_QTY1.Value		= 0
		ThisForm.Specs1.Value		= ""
		ThisForm.Heat1.Value		= ""
		ThisForm.Lot1.Value			= ""
		ThisForm.PO_Item1.Value		= ""
		ThisForm.PODueDate1.Value	= CTOD("  /  /  ")
		ThisForm.History1.Value		= ""
		ThisForm.Mill1.Value		= ""
		ThisForm.StkDate1.Value		= DATE()
		ThisForm.Num1.Value			= 0
		ThisForm.From_ID1.Value 	= 0
		ThisForm.ProjID1.Value 		= 0
		thisform.cmbMelt.Value		= "-"
		ThisForm.cmbPOStatus.Value 	= " "
		ThisForm.BrandName1.Value	= ""
		ThisForm.chkMillTrace.Value = .NULL.
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF USED("AlloyBrandName")
			USE IN AlloyBrandName
		ENDIF
		IF USED('postatusdef')
			USE IN postatusdef
		ENDIF
		
		IF USED('Alloys')
			USE IN Alloys
		ENDIF
		IF USED('Alloy')
			USE IN Alloy
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
		RETURN ThisForm.ID
	ENDPROC

	PROCEDURE ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE BrandName1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, cAlloy, cBrandName
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		cAlloy = ThisForm.ALLOY1.Value
		cBrandName = ""
		
		IF USED('AlloyBrandName')
			SELECT AlloyBrandName
		ELSE
			SELECT 0
		ENDIF
		
		IF !EMPTY(lcSearchStr)
			cSQL = "SELECT [BrandName] FROM dbo.Alloy WHERE Alloy = '"+cAlloy+"'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AlloyBrandName')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL , 'AlloyBrandName')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AlloyBrandName')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AlloyBrandName')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "AlloyBrandName")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "AlloyBrandName")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'AlloyBrandName')
			ENDIF
		
		
			IF USED("AlloyBrandName")
				IF NOT ISNULL(AlloyBrandName.BrandName)
					cBrandName = AlloyBrandName.BrandName
				ENDIF
				USE IN AlloyBrandName
			ENDIF
		
			IF NOT EMPTY(cBrandName)
			
				IF UPPER(lcSearchStr) = SUBSTR(cBrandName,1,lnInsertionPt)
					THIS.VALUE=cBrandName
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE cmbCC.Destroy
		RELEASE aConditionCode
	ENDPROC

	PROCEDURE cmbCC.GotFocus
		ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisForm.CL = PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
	ENDPROC

	PROCEDURE cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		This.clear
		
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Value = "1"
		
	ENDPROC

	PROCEDURE cmbCC.InteractiveChange
		PRIVATE cCC, cCL_default
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		cCL_default	= Default_CL_CC(cCC,ThisForm.nConnHandle)
		
		This.Parent.cmbCL.Value = cCL_default
		ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisForm.CL = cCL_default
	ENDPROC

	PROCEDURE cmbCC.LostFocus
		ThisForm.InitcmbCL()
		
	ENDPROC

	PROCEDURE cmbCL.GotFocus
		ThisForm.CC = PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		ThisForm.CL = PrepareSQLtxt(This.Value,'CL',1)
	ENDPROC

	PROCEDURE cmbCL.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			cCL1 = ''
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Value = cCL1 
		*This.Value = ""
		
	ENDPROC

	PROCEDURE cmbCL.LostFocus
		IF ThisForm.CL != PrepareSQLtxt(This.Value,'CL',1)
			ThisForm.CL = PrepareSQLtxt(This.Value,'CL',1)
		ENDIF
	ENDPROC

	PROCEDURE cmbForm.Init
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		this.clear
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
			
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE cmbMelt.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpMelt_Type')
			SELECT tmpMelt_Type
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		
		cSQL="SELECT RTRIM([Type]) AS [Type] FROM dbo.Melt_Type ORDER BY ID"
		 
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMelt_Type')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpMelt_Type')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMelt_Type')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMelt_Type')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMelt_Type")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMelt_Type")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpMelt_Type')
		ENDIF
		
		DIMENSION aMelt_Type(1)
		
		IF USED('tmpMelt_Type')
			SELECT Type FROM tmpMelt_Type INTO ARRAY aMelt_Type
			
			USE IN tmpMelt_Type 
		ENDIF
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aMelt_Type,1)
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 1
		This.NumberOfElements=nArrayCount 
		This.BoundColumn = 1
		This.ColumnWidths = "50"
		
		
		
		FOR I = 1 TO nArrayCount
			this.addListitem(aMelt_Type(I),I)
		*	this.addListitem(aMelt_Type(I, 2),I,2)
		ENDFOR
		
		This.Value = aMelt_Type(1)
		
		
	ENDPROC

	PROCEDURE cmdAbort.Click
		ThisForm.ID = 0
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdDelete.Click
		IF ThisForm.CountDetail() = 0
			PRIVATE nMess
			nMess = MESSAGEBOX("Are you sure you want to Delete this Record?",4+32,"Delete")
			IF nMess = 6
				PRIVATE lForceDelete,pFrom,pWhy
				lForceDelete = .T.
				pFrom = 'StockLst_Master.scx'
				pWhy = 'No Detail records Found!'
				
				Remove_Lst_ID(ThisForm.cTBL,ThisForm.ID,ThisForm.nConnHandle,lForceDelete,pFrom,pWhy)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE cmdPrint.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nSize, cCond
		PRIVATE nMWeight, nmS_QTY, cSpecs, cHeat, cLot, nPaid, cPO_Item, dPODueDate
		PRIVATE cMill, dStkDate, cHistory, nNum, cPOStatus,cBrandName, nFrom_ID, nProjID, cMelt, nID
		
		cAlloy		= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		cForm 		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		cCC 		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1,.T.)
		cCL 		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1,.T.)
		cCond		= PrepareSQLtxt(ThisForm.Cond1.Value,'Cond',30)	
		nSize 		= PrepareSQLnum(ThisForm.Size1.Value,'Size',9,3)
		nPaid		= PrepareSQLnum(ThisForm.Paid1.Value,'Paid',9,2)
		nMWeight	= PrepareSQLnum(ThisForm.MWeight1.Value,'MWeight',9,2)
		nmS_QTY		= PrepareSQLnum(ThisForm.mS_QTY1.Value,'mS_QTY',-5)
		cSpecs		= PrepareSQLtxt(ThisForm.Specs1.Value,'Specs',160)
		cHeat		= PrepareSQLtxt(ThisForm.Heat1.Value,'Heat',50)
		cLot		= PrepareSQLtxt(ThisForm.Lot1.Value,'Lot',10)
		cPO_Item	= Proper_PO_item(ThisForm.PO_Item1.Value)
		dPODueDate	= PrepareSQLdate(ThisForm.PODueDate1.Value,'PODueDate',.F.,.T.)
		cHistory	= PrepareSQLtxt(ThisForm.History1.Value,'History',20)
		cMill		= PrepareSQLtxt(ThisForm.Mill1.Value,'Mill',10)
		dStkDate	= PrepareSQLdate(ThisForm.StkDate1.Value,'StkDate',.F.,.T.)
		nNum 		= PrepareSQLnum(ThisForm.Num1.Value,'Num',8,0)
		cPOStatus 	= PrepareSQLtxt(ThisForm.cmbPOStatus.Value,'POStatus',1)
		cBrandName	= PrepareSQLtxt(ThisForm.BrandName1.Value,'BrandName',20)
		lMillCert   = PrepareSQLlogic(ThisForm.chkMillTrace.Value,'MillTrace',.NULL.)
		
		nFrom_ID  	= PrepareSQLnum(ThisForm.From_ID1.Value,'From_ID',-3,0)
		nProjID		= PrepareSQLnum(ThisForm.ProjID1.Value,'ProjID',-3,0)
		cMelt		= RTRIM(PrepareSQLtxt(ThisForm.cmbMelt.Value,'Melt',7))
		nID			= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3,0)
		
		IF USED('fstockLst_Master')
			USE IN fstockLst_Master 
		ENDIF
		
		PRIVATE cMEM
		cMEM = IIF( "\MEM" $ SYS(2003),'','\MEM')
		
		CREATE TABLE (SYS(5)+SYS(2003)+cMEM+"\"+"fStockLst_Master") FREE (;
			[alloy] [char](12),;
			[form] [char](2),;
			[cc] [char](1),;
			[CL] [char](1),;
			[size] [numeric](9, 3),;
			[cond] [varchar](50),;
			[mweight] [numeric](18, 8),;
			[mS_QTY]  [numeric](18, 8),;
			[specs] [varchar](160),;
			[heat] [varchar](50),;
			[lot] [char](10),;
			[Paid] [Numeric](18,4), ;
			[po_item] [char](12),;
			[poduedate] [datetime],;
			[mill] [char](10),;
			[stkdate] [datetime],;
			[history] [char](20),;
			[num] [Numeric](8, 0),;
			[POStatus] [char](1),;
			[BrandName] [char](20),;
			[FROM_ID] [int],;
			[ProjID] [INT],;
			[Melt] [Char](7),;
			[id] [int])
			
		INSERT INTO fstockLst_Master (;
			Alloy, Form, CC, CL, Size, Cond;
			,MWeight, mS_QTY, Specs, Heat, Lot, Paid, PO_Item, PODueDate;
			,Mill, StkDate, History, Num, POStatus,BrandName, From_ID, ProjID, Melt, ID);
			 VALUES (;
			cAlloy, cForm, cCC, cCL, nSize, cCond;
			,nMWeight, nmS_QTY, cSpecs, cHeat, cLot, nPaid, cPO_Item, dPODueDate;
			,cMill, dStkDate, cHistory, nNum, cPOStatus,cBrandName, nFrom_ID, nProjID, cMelt, nID)
		
		REPORT FORM Reports\StockLst_Master PREVIEW
		
		IF USED('fstockLst_Master')
			USE IN fstockLst_Master 
		ENDIF
		
	ENDPROC

	PROCEDURE cmdReport.Click
		PRIVATE nID, cTBL
		nID = ThisForm.ID1.Value
		cTBL = ThisForm.txtTableName.Value
		
		
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = cHyperLink = HTML_Stock_ID(cTBL,nID,.T.) &&lReturnURL --not URL is an HTML code.
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(m.cHyperLink)
		RELEASE loHyperlink
		MESSAGEBOX("Look for Open Web Browser for this Report",0,"Report Complete")
	ENDPROC

	PROCEDURE cmdSave.Click
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		
		PRIVATE m.cAlloy, m.cForm, m.cCC, m.cCL, m.nSize, m.cCond
		PRIVATE m.nMWeight, m.nmS_QTY, m.cSpecs, m.cHeat, m.cLot, m.nPaid, m.cPO_Item, m.dPODueDate
		PRIVATE m.cMill, m.dStkDate, m.cHistory, m.nNum, m.cMelt, m.cPOStatus,m.cBrandName,m.lMillTrace, m.nFrom_ID, m.nProjID, m.nID
		
		m.cAlloy	= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		m.cForm 	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		m.cCC 		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1,.T.)
		m.cCL 		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1,.T.)
		m.cCond		= PrepareSQLtxt(ThisForm.Cond1.Value,'Cond',30)	
		m.nSize 	= PrepareSQLnum(ThisForm.Size1.Value,'Size',9,3)
		m.nPaid		= PrepareSQLnum(ThisForm.Paid1.Value,'Paid',9,2)
		m.nMWeight	= PrepareSQLnum(ThisForm.MWeight1.Value,'MWeight',9,2)
		m.nmS_QTY	= PrepareSQLnum(ThisForm.mS_QTY1.Value,'mS_QTY',-5)
		m.cSpecs	= PrepareSQLtxt(ThisForm.Specs1.Value,'Specs',160)
		m.cHeat		= PrepareSQLtxt(ThisForm.Heat1.Value,'Heat',50)
		m.cLot		= PrepareSQLtxt(ThisForm.Lot1.Value,'Lot',10)
		m.cPO_Item	= Proper_PO_item(ThisForm.PO_Item1.Value)
		m.dPODueDate= PrepareSQLdate(ThisForm.PODueDate1.Value,'PODueDate',.F.,.T.)  &&Could be editing Old Data!
		m.cHistory	= PrepareSQLtxt(ThisForm.History1.Value,'History',20)
		m.cMill		= PrepareSQLtxt(ThisForm.Mill1.Value,'Mill',10)
		m.dStkDate	= PrepareSQLdate(ThisForm.StkDate1.Value,'StkDate',.F.,.T.)  &&Could be editing Old Data!
		m.nNum 		= PrepareSQLnum(ThisForm.Num1.Value,'Num',8,0)
		m.cPOStatus = PrepareSQLtxt(ThisForm.cmbPOStatus.Value,'POStatus',1)
		m.cBrandName= PrepareSQLtxt(ThisForm.BrandName1.Value,'BrandName',20)
		m.lMillTrace=PrepareSQLlogic(ThisForm.chkMillTrace.Value,'MillTrace',.NULL.)
		
		m.nFrom_ID  = PrepareSQLnum(ThisForm.From_ID1.Value,'From_ID',-3,0)
		m.nProjID	= PrepareSQLnum(ThisForm.ProjID1.Value,'ProjID',-3,0)
		m.cMelt		= RTRIM(PrepareSQLtxt(ThisForm.cmbMelt.Value,'Melt',7))
		m.nID		= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3,0)
		
		**********************************
		*Data Check
		Private cMess,cOKtoSave
		cMess = ""
		cOKtoSave = .T.
		
		PRIVATE cPOitemTest
		cPOitemTest = Proper_PO_item( m.cPO_Item )
		IF cPOitemTest = Proper_PO_item( '1-01' ) ;
		  OR cPOitemTest = Proper_PO_item( '0-01' ) ;
		  OR cPOitemTest = '       -1-01' ;
		  OR cPOitemTest = Proper_PO_item('        0-00')
		  	IF cPOitemTest = Proper_PO_item('        0-00')
			  	m.cPO_Item = Proper_PO_item( '0-00' )
		  	ELSE
				cMess = cMess + "'"+Proper_PO_Item( cPOitemTest )+"' is not valid."+CHR(13)
				cMess = cMess + "PO-item is being placed with '0-00'"+CHR(13)
				m.cPO_Item = Proper_PO_item( '0-00' )
			ENDIF
		ENDIF
		*!* PrepareSQLtxt strips the leading spaces, cannot compare!
		*!*	IF m.cPO_Item != Proper_PO_Item(m.cPO_Item)
		*!*		cMess = cMess + Proper_PO_Item(m.cPO_Item)+" is not in the Proper PO-item format '501234-01'"+CHR(13)
		*!*		cOKtoSave = .F.
		*!*	ENDIF
		
		**************************
		*IS CL a CC Type?
		IF LEN(m.cCC)>0 
			IF LEN(m.cCL) > 0
				IF NOT isCL_CC(cCL,cCC,ThisForm.nConnHandle)
					cMess = cMess + "That Condition Code '"+cCC+"' needs a matching Condition Level."+CHR(13)
					cOKtoSave = .f.
				ENDIF
			ENDIF
		ELSE
			cMess = cMess + "Stock needs Condition Code."+CHR(13)
			cOKtoSave = .f.
		ENDIF
		
		**************************
		*End of Data Check
		IF cOKtoSave
			IF NOT EMPTY( cMess )
				IF MESSAGEBOX( cMess+CHR(13)+"Do you still want to save?",4,"Data has been changed.") != 6
					RETURN -1
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX( cMess, 0 ,"Cannot Save!") 
			RETURN -1
		ENDIF
		
		**********************************
		IF THISFORM.WhatDo = "ADD"
			*Check History. If metal was found on floor, it probably has a History to match up with. 
			PRIVATE m.cTestHeat 
			m.cTestHeat = m.cHeat 
			IF NOT EMPTY(m.cHeat)
				IF AT("-",m.cHeat) > 5
					m.cTestHeat = LEFT(m.cHeat,AT("-",m.cHeat)-1)
				ENDIF
			ENDIF
			
			IF USED('tmpStocklst_Master_History')
				USE IN tmpStocklst_Master_History
			ENDIF
			SELECT 0
		
			cSQL = "SELECT * "
			cSQL = cSQL+" FROM [dbo].[Ar.Stocklst_Master_History]"
			cSQL = cSQL+" WHERE [WHAT] = 'DELETE'"
			cSQL = cSQL+" AND Alloy = '"+m.cAlloy+"'"
			cSQL = cSQL+" AND [Form] = '"+m.cForm+"'"
			cSQL = cSQL+" AND ( [size] >="+STR(m.nSize-.0500,18,4)
			cSQL = cSQL+" AND [size] <="+STR(m.nSize+.0500,18,4)+ " ) "
			cSQL = cSQL+" AND ( heat LIKE '%"+ALLTRIM(m.cTestHeat )+"%'"
			IF NOT EMPTY(cLot)
				cSQL = cSQL+" OR Lot LIKE '%"+ALLTRIM(m.cLot)+"%'"
			ENDIF
			cSQL = cSQL+" ) "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStocklst_Master_History')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStocklst_Master_History')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStocklst_Master_History")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStocklst_Master_History")
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStocklst_Master_History")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStocklst_Master_History")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStocklst_Master_History')
			ELSE
				IF USED("tmpStocklst_Master_History")
					IF RECCOUNT("tmpStocklst_Master_History") > 0 
						PRIVATE nID_History
						nID_History = 0
						IF RECCOUNT("tmpStocklst_Master_History") = 1
							nID_History = tmpStocklst_Master_History.ID_History
							m.nID		= tmpStocklst_Master_History.ID
						ELSE 
							DO FORM Forms\SelectMaster_from_DeletedHistory TO nID_History
							IF nID_History > 0
								m.nID = GetIDfromDeletedHistory_ID_History(nID_History,ThisForm.nConnHandle)
							ENDIF
						ENDIF				
						IF VARTYPE(nID_History) = "N"
							IF nID_History > 0
								*Then bring back from History, do not Add as new ID!
								THISFORM.WhatDo = "EDIT_OLD"
								ThisForm.ID_History = nID_History
								
							ENDIF		
						ENDIF
					ENDIF
					USE IN tmpStocklst_Master_History
				ENDIF
			ENDIF	
		ENDIF
		
		IF THISFORM.WhatDo = "ADD"
			*m.nMWeight Should only equal what is already in Details
			*m.nMWeight = 0
			IF ThisForm.Lst = "StockLst"
				cSQLi = "EXEC dbo.p_StockLst_Master_ins "
			ELSE
				cSQLi = "EXEC dbo.p_BrokerLst_Master_ins "
			ENDIF
			cSQLi = cSQLi+ " @Alloy ='"+m.cAlloy+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Form ='"+ALLTRIM(m.cForm)+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@cc ='"+ALLTRIM(IIF(ISNULL(m.cCC),"1",m.cCC))+"'"   &&NOT NULL	
			cSQLi = cSQLi+ ",@Cond ='"+ALLTRIM(m.cCond)+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Size ="+STR(m.nSize,9,3)+""   &&NOT NULL
			cSQLi = cSQLi+ ",@PAID ="+STR(m.nPAID,9,2)+""
			cSQLi = cSQLi+ ",@MWeight ="+STR(m.nMWeight,9,2)+""
			cSQLi = cSQLi+ ",@specs ='"+ALLTRIM(m.cSpecs)+"'"
			cSQLi = cSQLi+ ",@Heat ='"+ALLTRIM(m.cHeat)+"'"   &&NOT NULL
			cSQLi = cSQLi+ ",@Lot ='"+ALLTRIM(m.cLot)+"'"
			cSQLi = cSQLi+ ",@PO_Item ='"+ALLTRIM(m.cPO_Item)+"'"
			cSQLi = cSQLi+ ",@PODueDate ='"+IIF(EMPTY(m.dPODueDate),'',DTOC(m.dPODueDate))+"'"
			cSQLi = cSQLi+ ",@History ='"+ALLTRIM(m.cHistory)+"'"
			cSQLi = cSQLi+ ",@Mill ='"+ALLTRIM(m.cMill)+"'"
			cSQLi = cSQLi+ ",@StkDate ='"+IIF(EMPTY(m.dStkDate),'',DTOC(m.dStkDate))+"'"
			cSQLi = cSQLi+ ",@Num ="+STR(m.nNum,8,0)+""
			cSQLi = cSQLi+ ",@POStatus ='"+ALLTRIM(m.cPOStatus)+"'"
			cSQLi = cSQLi+ ",@BrandName ='"+ALLTRIM(m.cBrandName)+"'"
			*m.lMillTrace not here
			cSQLi = cSQLi+ ",@From_ID ="+STR(m.nFrom_ID)+""
			cSQLi = cSQLi+ ",@Melt ='"+ALLTRIM(m.cMelt)+"'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Master')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Master")
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Master')
			ELSE
				=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpID_Master")
					ThisForm.ID = tmpID_Master.EXP
					USE IN tmpID_Master 
					
					*****************************
					*UPDATE the Extras - Keep old stored Procedure and add new fields here.
					DO CASE
					CASE ThisForm.Lst = "StockLst"
						cSQL = "UPDATE dbo.StockLst_Master SET "
					CASE ThisForm.Lst = "BrokerLst"
						cSQL = "UPDATE dbo.BrokerLst_Master SET "
					CASE ThisForm.Lst = "WIPLst"
						cSQL = "UPDATE dbo.WIPLst_Master SET "
					ENDCASE
					cSQL = cSQL+" ProjID="+STR(m.nProjID)
					cSQL = cSQL+",Melt='"+ALLTRIM(m.cMelt)+"'"   
					cSQL = cSQL+",mS_QTY="+STR(m.nmS_QTY,18,4)
					cSQL = cSQL+",CL='"+m.cCL+"'"
					
					IF ISNULL(m.lMillTrace)
						*	Do not update MillTrace 
					ELSE
						IF m.lMillTrace
							cSQL = cSQL+",MillTrace = 1"
						ELSE
							cSQL = cSQL+",MillTrace = 0"
						ENDIF
					ENDIF
					
					cSQL = cSQL+" WHERE ID="+STR(ThisForm.ID)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 1' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
						lOK = .F.
					ELSE
						*=SQLCOMMIT(ThisForm.nConnHandle)
					ENDIF
				ENDIF
			ENDIF
			
		ENDIF
		IF THISFORM.WhatDo == "EDIT"
			*Recheck Weight
			nMWeight = CalcMasterWeight( m.nID, ThisForm.Lst, ThisForm.nConnHandle )
			
			DO CASE
			CASE ThisForm.Lst = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Master SET "
			CASE ThisForm.Lst = "BrokerLst"
				cSQL = "UPDATE dbo.BrokerLst_Master SET "
			CASE ThisForm.Lst = "WIPLst"
				cSQL = "UPDATE dbo.WIPLst_Master SET "
			ENDCASE
			
			cSQL = cSQL+" Alloy='"+ALLTRIM(m.cAlloy)+"'"   &&NOT NULL
			cSQL = cSQL+",Form='"+ALLTRIM(m.cForm)+"'"   &&NOT NULL
			cSQL = cSQL+",CC='"+ALLTRIM(m.cCC)+"'"   &&NOT NULL
			cSQL = cSQL+",CL='"+ALLTRIM(m.cCL)+"'"  
			cSQL = cSQL+",Cond='"+ALLTRIM(m.cCond)+"'"   &&NOT NULL
			cSQL = cSQL+",Size="+STR(m.nSize,9,3)+""   &&NOT NULL
			cSQL = cSQL+",PAID="+STR(m.nPAID,9,2)+""
			cSQL = cSQL+",MWeight="+STR(m.nMWeight,9,2)+""
			cSQL = cSQL+",mS_QTY="+STR(m.nmS_QTY,18,4)+""
			cSQL = cSQL+",specs='"+ALLTRIM(m.cSpecs)+"'"
			cSQL = cSQL+",Heat='"+ALLTRIM(m.cHeat)+"'"   &&NOT NULL
			cSQL = cSQL+",Lot='"+ALLTRIM(m.cLot)+"'"
			cSQL = cSQL+",PO_Item='"+m.cPO_Item+"'"
			cSQL = cSQL+",PODueDate='"+IIF(EMPTY(m.dPODueDate),'',DTOC(m.dPODueDate))+"'"
			cSQL = cSQL+",History='"+ALLTRIM(m.cHistory)+"'"
			cSQL = cSQL+",Mill='"+ALLTRIM(m.cMill)+"'"
			cSQL = cSQL+",StkDate='"+IIF(EMPTY(m.dStkDate),'',DTOC(m.dStkDate))+"'"
			cSQL = cSQL+",Num="+STR(m.nNum,8,0)+""
			cSQL = cSQL+",POStatus='"+ALLTRIM(m.cPOStatus)+"'"
			cSQL = cSQL+",BrandName='"+ALLTRIM(m.cBrandName)+"'"
		
					IF ISNULL(m.lMillTrace)
						*	Do not update MillTrace 
					ELSE
						IF m.lMillTrace
							cSQL = cSQL+",MillTrace = 1"
						ELSE
							cSQL = cSQL+",MillTrace = 0"
						ENDIF
					ENDIF
			
			cSQL = cSQL+",From_ID="+STR(m.nFrom_ID)+""	
			cSQL = cSQL+",ProjID="+STR(m.nProjID)
			cSQL = cSQL+",Melt='"+ALLTRIM(m.cMelt)+"'"	
			cSQL = cSQL+" WHERE ID="+STR(m.nID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "" )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "" )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
				lOK = .F.
				MESSAGEBOX("Could not Save",16,"Error")
			ELSE
				=SQLCOMMIT(ThisForm.nConnHandle)
				*Send Email
				*HTML_Stock_ID_Detail
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQL) 
				TrackMess(cSQL+" "+CHR(13)+SYS(16,1))
				
			ENDIF
		ENDIF
		
		IF THISFORM.WhatDo = "EDIT_OLD"
			*recreate this ID in StockLst Table
		*	cSQL = cSQL+ " WHERE ID="+STR(m.nID)
			
			IF USED('tmpStockLst_Master_ReAdd')
				USE IN tmpStockLst_Master_ReAdd
			ENDIF
			SELECT 0
			
			cSQLi = "EXEC dbo.p_StockLst_Master_ReAdd "
			cSQLi = cSQLi+ "@ID_History ="+STR(ThisForm.ID_History)+""
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpStockLst_Master_ReAdd')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpStockLst_Master_ReAdd')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpStockLst_Master_ReAdd' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpStockLst_Master_ReAdd')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpStockLst_Master_ReAdd")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpStockLst_Master_ReAdd")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master_ReAdd')
			ELSE
				IF USED("tmpStockLst_Master_ReAdd")
					IF VARTYPE(tmpStockLst_Master_ReAdd.EXP) = "N"
						IF tmpStockLst_Master_ReAdd.EXP > 0
							*Worked
							m.nFrom_ID = m.nID
							ThisForm.ID = tmpStockLst_Master_ReAdd.EXP
							m.nID =  tmpStockLst_Master_ReAdd.EXP
							
							ThisForm.ID1.Value = m.nID
							ThisForm.From_ID1.Value = m.nFrom_ID
						ELSE
							MESSAGEBOX("Recovery Procedure Failed"+CHR(13)+"Did not get new ID to use.",0,"SQL Error")
							m.nID = 0
							ThisForm.ID = 0
						ENDIF
					USE IN tmpStockLst_Master_ReAdd
					ENDIF
				ENDIF
			ENDIF	
			
			nMWeight = 0
			
			cSQL = "UPDATE dbo.StockLst_Master SET "
			cSQL = cSQL+" Alloy='"+ALLTRIM(m.cAlloy)+"'"   &&NOT NULL
			cSQL = cSQL+",Form='"+ALLTRIM(m.cForm)+"'"   &&NOT NULL
			cSQL = cSQL+",CC='"+ALLTRIM(m.cCC)+"'"   &&NOT NULL
			cSQL = cSQL+",CL='"+ALLTRIM(m.cCL)+"'"  
			cSQL = cSQL+",Cond='"+ALLTRIM(m.cCond)+"'"   &&NOT NULL
			cSQL = cSQL+",Size="+STR(m.nSize,9,3)+""   &&NOT NULL
			cSQL = cSQL+",PAID="+STR(m.nPAID,9,2)+""
			cSQL = cSQL+",MWeight="+STR(m.nMWeight,9,2)+""
			cSQL = cSQL+",mS_QTY="+STR(m.nmS_QTY,18,4)+""
			cSQL = cSQL+",specs='"+ALLTRIM(m.cSpecs)+"'"
			cSQL = cSQL+",Heat='"+ALLTRIM(m.cHeat)+"'"   &&NOT NULL
			cSQL = cSQL+",Lot='"+ALLTRIM(m.cLot)+"'"
			cSQL = cSQL+",PO_Item='"+Proper_PO_item(m.cPO_Item)+"'"
			cSQL = cSQL+",PODueDate='"+IIF(EMPTY(m.dPODueDate),'',DTOC(m.dPODueDate))+"'"
			cSQL = cSQL+",History='"+ALLTRIM(m.cHistory)+"'"
			cSQL = cSQL+",Mill='"+ALLTRIM(m.cMill)+"'"
			cSQL = cSQL+",StkDate='"+IIF(EMPTY(m.dStkDate),'',DTOC(m.dStkDate))+"'"
			cSQL = cSQL+",Num="+STR(m.nNum,8,0)+""
			cSQL = cSQL+",BrandName='"+ALLTRIM(m.cBrandName)+"'"
			
					IF ISNULL(m.lMillTrace)
						*	Do not update MillTrace 
					ELSE
						IF m.lMillTrace
							cSQL = cSQL+",MillTrace = 1"
						ELSE
							cSQL = cSQL+",MillTrace = 0"
						ENDIF
					ENDIF
		
			cSQL = cSQL+",From_ID="+STR(m.nFrom_ID)+""	
			cSQL = cSQL+",ProjID="+STR(m.nProjID)+""
			cSQL = cSQL+",Melt='"+ALLTRIM(m.cMelt)+"'"	
			cSQL = cSQL+" WHERE ID="+STR(m.nID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '')
				lOK = .F.
			ELSE
				=SQLCOMMIT(ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		IF lOK 
			THISFORM.RELEASE
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSaveToStock.Click
		
		PRIVATE nID,nID_Detail,nID_Detail1,nID_Detail2, cTBL
		nID 		= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		nID_Detail	= 0
		nID_Detail1 = 0
		nID_Detail2	= 0
		cTBL 		= ThisForm.cTBL
		
		IF cTBL = "S"
			MESSAGEBOX("Item is already in Stock List",0,"Cannot")
			This.Visible = .F.
			RETURN .F.
		ENDIF
		
		*Get_ID_Detail_by_ReceivingID  get_ID_Detail_with_POitem  get_ID_Detail_with_WO_Detail
		PRIVATE cPOitem
		cPOitem = Proper_PO_item(ThisForm.PO_ITEM1.Value)
		IF cPOitem != Proper_PO_item('')
			*have POitem	
			nID_Detail2 = get_ID_Detail_with_POitem(cPOitem,cTBL,ThisForm.nConnHandle,.F.)
		ENDIF
		
		nID_Detail11 = getHighestID_DetailbyID(nID,cTBL,ThisForm.nConnHandle)
		** All Details will be MOVED!
		
		IF nID_Detail1 > 0
			IF nID_Detail2 = 0
				nID_Detail = nID_Detail1
			ELSE
				IF nID_Detail <> nID_Detail2
					TrackError("Move Broker to Stock"+CHR(13)+"Screen had nID_Detail="+STR(nID_Detail)+CHR(13)+"get_ID_Detail_with_POitem () = nID_Detail2="+STR(nID_Detail2)+CHR(13)+" Using nID_Detail2" ,"Move Broker to Stock Error", PROGRAM(), LINENO(1))
					nID_Detail = nID_Detail2
				ENDIF
			ENDIF
		ELSE
			nID_Detail  = nID_Detail2
		ENDIF 
		
		IF nID_Detail = 0
			MESSAGEBOX("Cannot move from Broker."+CHR(13)+"No ID_Detail found.",16,"No ID_Detail")
			RETURN .F.
		ENDIF
		
		
		PRIVATE nNewID_Master
		nNewID_Master = 0
		IF cTBL = "B"
			nNewID_Master = Move_BrokerLst_StockLst( nID, nID_Detail, ThisForm.nConnHandle )
		ELSE
			IF cTBL = "W"
				nNewID_Master = Move_WIPLst_StockLst( nID, nID_Detail, ThisForm.nConnHandle )
			ELSE
			*
			ENDIF
		ENDIF
		
		IF nNewID_Master > 0
		
			WAIT WINDOW "Saved, Done." TIMEOUT 1
			ThisForm.ID = -nNewID_Master 
			ThisForm.Release
		
		ELSE
			MESSAGEBOX("Move Failed!",0,"Error" )
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE cmdSearch.Click
		PRIVATE cSQL, nSQLEXEC, lOK
		lOK = .T.
		
		PRIVATE cAlloy, cForm, cCC, cCL, nSize, cCond
		PRIVATE cSpecs, cHeat, cLot, cPO_Item, cMill
		
		cAlloy		= PrepareSQLtxt(ThisForm.Alloy1.Value,'Alloy',12)
		cForm 		= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
		cCC 		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1,.T.)
		cCL 		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1,.T.)
		cCond		= PrepareSQLtxt(ThisForm.Cond1.Value,'Cond',30)	
		nSize 		= PrepareSQLnum(ThisForm.Size1.Value,'Size',9,3)
		cSpecs		= PrepareSQLtxt(ThisForm.Specs1.Value,'Specs',160)
		cHeat		= PrepareSQLtxt(ThisForm.Heat1.Value,'Heat',50)
		cLot		= PrepareSQLtxt(ThisForm.Lot1.Value,'Lot',10)
		cPO_Item	= Proper_PO_item(ThisForm.PO_Item1.Value)
		cMill		= PrepareSQLtxt(ThisForm.Mill1.Value,'Mill',10)
		
		***************************
		
		PRIVATE lUsedWhere
		lUsedWhere = .F.
		
		cSQL = "SELECT DISTINCT ID FROM dbo.[AR.StockLst_Master_History "
		
		IF NOT EMPTY(cAlloy)
			IF lUsedWhere
				cSQL=cSQL+" AND Alloy = '"+cAlloy+"'"
			ELSE
				cSQL=cSQL+" WHERE Alloy = '"+cAlloy+"'"
				lUsedWhere = .T.
			ENDIF
		ENDIF
		IF NOT EMPTY(cForm )
			IF lUsedWhere
				cSQL=cSQL+" AND Form = '"+cForm +"'"
			ELSE
				cSQL=cSQL+" WHERE Form = '"+cForm +"'"
				lUsedWhere = .T.
			ENDIF
		ENDIF
		*!*	IF NOT EMPTY(cCC)
		*!*		IF lUsedWhere
		*!*			cSQL=cSQL+" AND CC = '"+cCC+"'"
		*!*		ELSE
		*!*			cSQL=cSQL+" WHERE CC  = '"+cCC+"'"
		*!*			lUsedWhere = .T.
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF NOT EMPTY(cCond)
		*!*		IF lUsedWhere
		*!*			cSQL=cSQL+" AND Cond LIKE '%"+cCond+"%'"
		*!*		ELSE
		*!*			cSQL=cSQL+" WHERE Cond = '%"+cCond+"%'"
		*!*			lUsedWhere = .T.
		*!*		ENDIF
		*!*	ENDIF
		
		IF nSize > 0
			IF lUsedWhere
				cSQL=cSQL+" AND Size <= "+STR(nSize+.5,9,3)+" AND Size >= "+STR(nSize-.5,9,3)
			ELSE
				cSQL=cSQL+" WHERE Size <= "+STR(nSize+.5,9,3)+" AND Size >= "+STR(nSize-.5,9,3)
				lUsedWhere = .T.
			ENDIF
		ENDIF
		
		*!*	IF NOT EMPTY(cSpecs)
		*!*		IF lUsedWhere
		*!*			cSQL=cSQL+" AND Specs LIKE '%"+cSpecs+"%'"
		*!*		ELSE
		*!*			cSQL=cSQL+" WHERE Specs LIKE '%"+cSpecs+"%'"
		*!*			lUsedWhere = .T.
		*!*		ENDIF
		*!*	ENDIF
		IF NOT EMPTY(cHeat)
			IF AT("-",cHeat) > 5
				cHeat = LEFT(cHeat,AT("-",cHeat)-1)
			ENDIF
			IF lUsedWhere
				cSQL=cSQL+" AND Heat LIKE '%"+ALLTRIM(cHeat)+"%'"
			ELSE
				cSQL=cSQL+" WHERE Heat LIKE '%"+ALLTRIM(cHeat)+"%'"
				lUsedWhere = .T.
			ENDIF
		ENDIF
		*!*	IF NOT EMPTY(cLot)
		*!*		IF lUsedWhere
		*!*			cSQL=cSQL+" AND Lot = '"+cLot+"'"
		*!*		ELSE
		*!*			cSQL=cSQL+" WHERE Lot = '"+cLot+"'"
		*!*			lUsedWhere = .T.
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF NOT EMPTY(cPO_Item)
		*!*		IF cPO_Item = Proper_PO_item('')
		*!*			cPO_Item = ''
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF NOT EMPTY(cPO_Item)
		*!*		IF lUsedWhere
		*!*			cSQL=cSQL+" AND PO_Item = '"+cPO_Item+"'"
		*!*		ELSE
		*!*			cSQL=cSQL+" WHERE PO_Item = '"+cPO_Item+"'"
		*!*			lUsedWhere = .T.
		*!*		ENDIF
		*!*	ENDIF
		*!*	IF NOT EMPTY(cMill)
		*!*		IF lUsedWhere
		*!*			cSQL=cSQL+" AND Mill LIKE '%"+cMill+"%'"
		*!*		ELSE
		*!*			cSQL=cSQL+" WHERE Mill LIKE '%"+cMill+"%'"
		*!*			lUsedWhere = .T.
		*!*		ENDIF
		*!*	ENDIF
		
		IF lUsedWhere
			cSQL=cSQL+" AND [WHAT] = 'DELETE    '"
		ELSE
			cSQL=cSQL+" WHERE [WHAT] = 'DELETE    '"
			lUsedWhere = .T.
		ENDIF
		
		
		
		PRIVATE nReccords 
		PRIVATE nReturnID
		nReturnID = 0
		
		IF USED('tmpMasterID')
			USE IN tmpMasterID
		ENDIF
		
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL ' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpMasterID')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMasterID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpMasterID')
		ELSE
		
			IF USED("tmpMasterID")
				*ThisForm.ID = tmpMasterID.ID
				nReccords = RECCOUNT('tmpMasterID')
				
				IF nReccords > 0
					IF nReccords > 30
						IF MESSAGEBOX("Search Found "+ALLTRIM(STR(nReccords))+" matching records."+CHR(13)+"Please add criteria to your Search"+CHR(13)+"Answer No to see all results.",4+32,"Retry Search?") = 7
							DO FORM Forms\SelectMasterID WITH cSQL TO nReturnID
						ELSE
							MESSAGEBOX("The Search is on Fields:"+CHR(13)+"Alloy,"+CHR(13)+"Form,"+CHR(13)+"CC,"+CHR(13)+"Size,"+CHR(13)+"Cond,"+CHR(13)+"Specs,"+CHR(13)+"Heat,"+CHR(13)+"Lot,"+CHR(13)+"PO_Item"+CHR(13)+"Mill",0+64,"Fine tune your search!")
						ENDIF
					ELSE
						DO FORM Forms\SelectMasterID WITH cSQL TO nReturnID
					ENDIF
				ELSE
					MESSAGEBOX("No records Found"+CHR(13)+"Try using an abbreviated heat.",0+64,"Not Found")
					MESSAGEBOX("The Search is on Fields:"+CHR(13)+"Alloy,"+CHR(13)+"Form,"+CHR(13)+"CC,"+CHR(13)+"Size,"+CHR(13)+"Cond,"+CHR(13)+"Specs,"+CHR(13)+"Heat,"+CHR(13)+"Lot,"+CHR(13)+"PO_Item"+CHR(13)+"Mill",0+64,"Fine tune your search!")
				ENDIF
				USE IN tmpMasterID
			ELSE
				MESSAGEBOX("No records Found"+CHR(13)+"Try using an abbreviated heat.",0+64,"Not Found")
				MESSAGEBOX("The Search is on Fields:"+CHR(13)+"Alloy,Form,Size,Heat",0+64,"Fine tune your search!")
			ENDIF
		
		ENDIF
		
		ThisForm.ID_History = 0
		
		IF VARTYPE(nReturnID) = "N"
			IF nReturnID > 0
				*Use the new ID!
				IF MESSAGEBOX("Are you sure you want to use this record as a source of this new StockLst Add?"+CHR(13)+"Found as a Deleted StockLst Item",4+32,"Use found item?") = 6
				
					IF ThisForm.GetByID_DetailinHistory(nReturnID)
						ThisForm.WhatDo = "EDIT_OLD"
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE HEAT1.Valid
		PRIVATE cHeat
		cHeat = ALLTRIM(THIS.VALUE)
		
		IF THISFORM.txtTableName.VALUE = "StockLst"
			IF THISFORM.WhatDo = "ADD"
				IF NOT EMPTY(cHeat)
		
		*			Check Similair Heats
					PRIVATE cSQL,cSimpleHeat
					cSimpleHeat = IIF(AT('/',cHeat)>4,LEFT(cHeat,AT('/',cHeat)-1),cHeat)
					cSimpleHeat = IIF(AT('\',cSimpleHeat)>4,LEFT(cSimpleHeat,AT('\',cSimpleHeat)-1),cSimpleHeat)
					cSimpleHeat = IIF(AT('?',cSimpleHeat)>4,LEFT(cSimpleHeat,AT('?',cSimpleHeat)-1),cSimpleHeat)
					cSimpleHeat = IIF(AT(',',cSimpleHeat)>4,LEFT(cSimpleHeat,AT(',',cSimpleHeat)-1),cSimpleHeat)
					cSimpleHeat = IIF(AT('(',cSimpleHeat)>4,LEFT(cSimpleHeat,AT('(',cSimpleHeat)-1),cSimpleHeat)
					cSimpleHeat = IIF(AT('&',cSimpleHeat)>4,LEFT(cSimpleHeat,AT('&',cSimpleHeat)-1),cSimpleHeat)
					cSimpleHeat = IIF(AT('  ',cSimpleHeat)>4,LEFT(cSimpleHeat,AT('  ',cSimpleHeat)-2),cSimpleHeat)
					
					cSimpleHeat = IIF(AT('HPA',cSimpleHeat)>4,LEFT(cSimpleHeat,AT('HPA',cSimpleHeat)-3),cSimpleHeat)
					
					cSQL = "SELECT DISTINCT TOP 30 Heat FROM dbo.StockLst_Master WHERE HEAT Like '%"+cSimpleHeat+"%' ORDER BY Heat "
		
					IF USED("tmpStockLst_Master_Heat")
						SELECT tmpStockLst_Master_Heat
					ELSE
						SELECT 0
					ENDIF
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_Heat')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_Heat')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_Heat' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 1' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_Heat' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_Heat")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_Heat")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master_Heat')
					ELSE
						IF USED("tmpStockLst_Master_Heat")
							IF RECCOUNT('tmpStockLst_Master_Heat') > 0
								*SELECT Heat FROM tmpStockLst_Master_Heat IN ARRAY aHeats
								cMess = "Similiar heats where found, Please do not duplicate!"+CHR(13)
								SCAN
									cMess = cMess + tmpStockLst_Master_Heat.Heat+CHR(13)
								ENDSCAN
								cMess = cMess + CHR(13) + "Answer (N) to not check DELETED history also."
								IF MESSAGEBOX(cMess,4+48,"Do you have a new Heat?") = 7
									RETURN .F.
								ENDIF
								
							ENDIF
							USE IN tmpStockLst_Master_Heat
						ENDIF
					ENDIF
				
				
				
		*			Check History
					PRIVATE cSQL
					cSQL = "SELECT COUNT(*) AS cnt FROM dbo.[AR.StockLst_Master_History WHERE HEAT = '"+cHeat+"' AND [What] = 'DELETE'"
					
					IF USED("tmpStockLst_Master_ID")
						SELECT tmpStockLst_Master_ID
					ELSE
						SELECT 0
					ENDIF
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_ID')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_ID')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_ID")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 1' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_ID")
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_ID")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_ID")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master_ID')
					ELSE
						IF USED("tmpStockLst_Master_ID")
							IF tmpStockLst_Master_ID.CNT > 0
								IF MESSAGEBOX("This Heat was found in the DELETED history"+CHR(13)+;
								  "and has been removed from StockLst."+CHR(13)+CHR(13)+;
								  "Is this an 'Add' for 'FOUND' inventory?"+CHR(13)+CHR(13)+;
								  "Answer No if this material just arrived from a supplier"+CHR(13)+;
								  "or this is a reworked/machined from another making a new LOT."+CHR(13)+;
								  "The 'Search' button has a better selection of the DELETED history.";
								  ,4+16,"Import found Stock from DELETED history?") = 6
								  
		*							cSQL = "SELECT * FROM dbo.[AR.StockLst_Master_History WHERE HEAT = '"+cHeat+"' AND [What] = 'DELETE'"
									cSQL = "SELECT * FROM dbo.[AR.StockLst_Master_History "
									cSQL=cSQL+" WHERE HEAT = '"+cHeat+"'"
									cSQL=cSQL+" AND ( [What] = 'DELETE' OR dbo.f_ProperPOitem(po_item) != dbo.f_ProperPOitem('0-00') )"
									cSQL=cSQL+" ORDER BY PO_item DESC, [When] DESC"
		
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_ID')
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master_ID')
									ENDDO
									IF nSQLEXEC < 0 &&Try again!
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_ID")
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL 1' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_ID")
										ENDDO
									ENDIF
									IF nSQLEXEC < 0 &&Try again!
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_ID")
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL 2' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master_ID")
											
											IF nSQLEXEC < 0
												IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
													nSQLEXEC = 0
												ENDIF
											ENDIF
										ENDDO
									ENDIF 
									IF nSQLEXEC < 0
										SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master_ID')
									ELSE
										*ThisForm.ID1.Value			= tmpStockLst_Master_ID.ID
										THISFORM.Alloy1.VALUE		= ShowSQLtxt(tmpStockLst_Master_ID.Alloy,'Alloy',12)
										THISFORM.cmbForm.VALUE		= ShowSQLtxt(tmpStockLst_Master_ID.FORM,'Form',2)
										THISFORM.cmbCC.VALUE		= ShowSQLtxt(tmpStockLst_Master_ID.CC,'CC',1)
										THISFORM.cmbCC.VALUE		= ShowSQLtxt(tmpStockLst_Master_ID.CL,'CL',1)
										THISFORM.Cond1.VALUE		= ShowSQLtxt(tmpStockLst_Master_ID.Cond,'Cond',50)
										THISFORM.Size1.VALUE		= PrepareSQLnum(tmpStockLst_Master_ID.SIZE,'Size',9,3)
										THISFORM.Paid1.VALUE		= PrepareSQLnum(tmpStockLst_Master_ID.Paid,'Paid',-5)
										THISFORM.MWeight1.VALUE		= PrepareSQLnum(tmpStockLst_Master_ID.MWeight,'MWeight',18,8)
										THISFORM.mS_QTY1.Value		= PrepareSQLnum(tmpStockLst_Master_ID.mS_QTY,'mS_QTY',-5)
										THISFORM.Specs1.VALUE		= ShowSQLtxt(tmpStockLst_Master_ID.specs,'Specs',160)
		*								ThisForm.Heat1.Value		= ShowSQLtxttmpStockLst_Master_ID.Heat,'Heat',50)
										THISFORM.Lot1.VALUE			= ShowSQLtxt(tmpStockLst_Master_ID.Lot,'Lot',10)
										THISFORM.PO_Item1.VALUE		= Proper_PO_item( tmpStockLst_Master_ID.PO_Item )
										THISFORM.PODueDate1.VALUE	= PrepareSQLdate(tmpStockLst_Master_ID.PODueDate,'PODueDate',.F.,.T.)
										THISFORM.History1.VALUE		= ShowSQLtxt(tmpStockLst_Master_ID.HISTORY,'History',20)
										THISFORM.Mill1.VALUE		= ShowSQLtxt(tmpStockLst_Master_ID.Mill,'Mill',10)
		*								ThisForm.StkDate1.Value		= tmpStockLst_Master_ID.StkDate
										THISFORM.Num1.VALUE			= PrepareSQLnum(tmpStockLst_Master_ID.Num,'Num',-3)
										THISFORM.From_ID1.VALUE		= PrepareSQLnum(tmpStockLst_Master_ID.ID,'FromID',-3)
										THISFORM.ProjID1.VALUE		= PrepareSQLnum(tmpStockLst_Master_ID.ProjID,'ProjID',-3)
										ThisForm.cmbMelt.Value 		= PrepareSQLtxt(tmpStockLst_Master_ID.Melt,'Melt',7)
		*								ThisForm.cmbPOStatus.Value 	= ShowSQLtxt(tmpStockLst_Master_ID.POStatus,'POStatus',1)
										THISFORM.BrandName1.Value	= ShowSQLtxt(tmpStockLst_Master_ID.BrandName,'BrandName',20)
										ThisForm.chkMillTrace.Value = PrepareSQLlogic(tmpStockLst_Master_ID.MillTrace,'MillTrace',.NULL.)
									ENDIF
								ENDIF
							ELSE
								*Check current - Should be done as Add, not completly new.
							
							ENDIF
							USE IN tmpStockLst_Master_ID
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

