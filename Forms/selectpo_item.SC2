		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS vParameter, vWhat
		*DO FORM Forms\SelectPO_item WITH nHPAPO,'HPAPO' TO cPOItem
		*DO FORM Forms\SelectPO_item WITH cPOitem,'POitem' TO cPOItem
		*could Add Parameter nWO nWOD ???
		
		*ThisForm.cReturnValue = tmpPO_top1000.POItem
		
		PRIVATE cWhat 
		cWhat = UPPER(PrepareSQLtxt(vWhat,'What',10))
		
		********
		PRIVATE nSalesNum, nOrderNum, nHPAPO, cPOitem, nWO, nWOD
		nSalesNum = 0
		nOrderNum = 0
		nHPAPO	= 0
		cPOitem = Proper_PO_item('')
		nWO		= 0
		nWOD	= 0
		DO CASE
		CASE cWhat = "SALESNUM"
			nSalesNum = PrepareSQLnum(vParameter,'SalesNum',-3)
		CASE cWhat = "HPAPO"
			nOrderNum = PrepareSQLnum(vParameter,'HPAPO',-3)
			nHPAPO	= PrepareSQLnum(vParameter,'HPAPO',-3)
		CASE cWhat = "POITEM"
			cPOitem = PrepareSQLtxt(vParameter,'POitem',12)
		CASE cWhat = "WOD"
			nWOD = PrepareSQLnum(vParameter,'WOD',-3)
		CASE cWhat = "WO"
			nWO = PrepareSQLnum(vParameter,'WO',-3)
		OTHERWISE
			*Old  -show all
		
		ENDCASE
		
		IF USED('tmpPO_top1000')
			USE IN tmpPO_top1000
		ENDIF
		
		SELECT 0
		cSQL = "SELECT TOP 1000 * FROM dbo.PurchaseOrder "
		DO CASE
		CASE nSalesNum > 0
			cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
			ThisForm.txtSalesNum.Value = nSalesNum 
		CASE nHPAPO > 0
			cSQL = cSQL + " WHERE HPApo = "+STR(nHPAPO)
			ThisForm.txtHPAPO.Value = nHPAPO 
		CASE cPOitem <> Proper_PO_item('')
			nHPAPO = Proper_PO_Item_PO(cPOitem)
			cSQL = cSQL + " WHERE HPApo = "+STR(nHPAPO)
			ThisForm.txtHPAPO.Value = nHPAPO 
		CASE nWO > 0
			cSQL = cSQL + " WHERE WO = "+STR(nWO)
			*ThisForm.txtWO.Value	= nWO 
		CASE nWOD > 0
			cSQL = cSQL + " WHERE WO_Detail = "+STR(nWOD)
			*ThisForm.txtWOD.Value	= nWOD
		OTHERWISE
			
		ENDCASE
		
		*cSQL = cSQL + " ORDER BY POitem DESC"
		cSQL = cSQL + " ORDER BY HPAPO DESC, ItemPO ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpPO_top1000")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_top1000')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_top1000")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_top1000")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpPO_top1000')
		ENDIF
		
		IF NOT USED('tmpPO_top1000') OR RECCOUNT('tmpPO_top1000') = 0
			MESSAGEBOX("Did not find any records with Init Parameter."+CHR(13)+"Showing top 5000.",0+48,"Top 5000")
			*get All
			
			SELECT 0
			cSQL = "SELECT TOP 5000 * FROM dbo.PurchaseOrder "
			cSQL = cSQL + " ORDER BY HPAPO DESC, ItemPO ASC"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpPO_top1000")
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_top1000')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_top1000")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_top1000")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpPO_top1000')
			ENDIF
		ENDIF
		
		IF NOT USED('tmpPO_top1000')
			MESSAGEBOX( "Could not load dbo.PurchaseOrder the table.","Program Error")
			RETURN ""
		ENDIF
		
		SELECT tmpPO_top1000
		*SET ORDER TO Company
		
		IF Proper_PO_item(cPOitem) != Proper_PO_item('')
			*showing all PO items, find correct Item
			LOCATE FOR POitem = cPOitem
		ENDIF
		
		
		ThisForm.grid1.RecordSource = "tmpPO_top1000"
		*!*	ThisForm.grdSourceCompany.Company.ControlSource = "SourcePH.Company"
		*!*	ThisForm.grdSourceCompany.Person.ControlSource  = "SourcePH.Person"
		*!*	ThisForm.grdSourceCompany.Phone.ControlSource   = "SourcePH.Phone"
		*!*	ThisForm.grdSourceCompany.Fax.ControlSource     = "SourcePH.Fax"
		*!*	ThisForm.grdSourceCompany.Email.ControlSource   = "SourcePH.Email"
		*!*	ThisForm.grdSourceCompany.Email2.ControlSource  = "SourcePH.Email2"
		
		ThisForm.txtHPApo.SetFocus
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		*IF VARTYPE(gnConnHandle) = "N"
		*	ThisForm.CloseConn = .F.
		*	ThisForm.nConnHandle = gnConnHandle
		*ELSE
			ThisForm.CloseConn = .T.
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		*ENDIF
		
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDWidth,nDHeight
		nDWidth = This.Width - 464
		nDHeight = This.Height - 282
		
		ThisForm.grid1.Width = 468 +nDWidth 
		ThisForm.grid1.Height = 228 +nDHeight
		
		ThisForm.lblHPAPOfind.Top = 228 + nDHeight
		ThisForm.lblCompanyfind.Top = 228 + nDHeight
		ThisForm.lblSalesNumFind.Top = 228 + nDHeight
		ThisForm.lblPOSalesPFind.Top = 228 + nDHeight
		
		ThisForm.txtHPAPO.Top = 243 + nDHeight
		ThisForm.txtCompany.Top = 243 + nDHeight
		ThisForm.txtSalesNum.Top = 243 + nDHeight
		ThisForm.txtPOSalesP.Top = 243 + nDHeight
		
		ThisForm.cmdSelect.Top = 240 + nDHeight
		ThisForm.cmdCancel.Top = 240 + nDHeight
		
		
		ThisForm.cmdFindHPAPO.Top = 262 + nDHeight
		ThisForm.cmdFindCompany.Top = 262 + nDHeight
		ThisForm.cmdNextCompany.Top = 262 + nDHeight
		ThisForm.cmdFindSO.Top = 262 + nDHeight
		ThisForm.cmdFindRep.Top = 262 + nDHeight
		ThisForm.cmdNextPOSalesP.Top = 262 + nDHeight
		
		
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		IF USED('tmpPO_top1000')
			USE IN tmpPO_top1000
		ENDIF
		
		RETURN ThisForm.cReturnValue
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdFindCompany.Click
		PRIVATE cCompany
		cCompany = UPPER(PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30))
		
		ThisForm.cmdNextCompany.Visible = .F.
		ThisForm.cmdNextPOSalesP.Visible = .F.
		ThisForm.cLocateFor = ''
		
		IF LEN(cCompany) > 0
			SELECT tmpPO_top1000
		
			LOCATE FOR UPPER(Company) = cCompany 
			IF FOUND()
				ThisForm.cLocateFor = cCompany
				ThisForm.cmdNextCompany.Visible = .T.
			ELSE
				LOCATE FOR UPPER(LEFT(Company,10)) = LEFT(cCompany,10)
				IF FOUND()
					ThisForm.cLocateFor = LEFT(cCompany,10)
					ThisForm.cmdNextCompany.Visible = .T.
				ELSE
					LOCATE FOR UPPER(LEFT(Company,7)) = LEFT(cCompany,7)
					IF FOUND()
						ThisForm.cLocateFor = LEFT(cCompany,7)
						ThisForm.cmdNextCompany.Visible = .T.
					ELSE
						LOCATE FOR UPPER(LEFT(Company,5)) = LEFT(cCompany,5)
						IF FOUND()
							ThisForm.cLocateFor = LEFT(cCompany,5)
							ThisForm.cmdNextCompany.Visible = .T.
						ELSE
						
							LOCATE FOR LEFT(cCompany,7) $ UPPER(Company)
							IF FOUND()
								ThisForm.cLocateFor = LEFT(cCompany,7)
								ThisForm.cmdNextCompany.Visible = .T.
							ELSE
						
								LOCATE FOR UPPER(LEFT(Company,4)) = LEFT(cCompany,4)
								IF FOUND()
									ThisForm.cLocateFor = LEFT(cCompany,4)
									ThisForm.cmdNextCompany.Visible = .T.
								ELSE
									WAIT WINDOW "Not Found!" NOWAIT
									ThisForm.cLocateFor = ''
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ELSE
			WAIT WINDOW "Enter Company to search." TIMEOUT 2
		ENDIF
		
		ThisForm.grid1.Refresh
	ENDPROC

	PROCEDURE cmdFindHPAPO.Click
		PRIVATE nHPAPO
		nHPAPO = PrepareSQLnum(ThisForm.txtHPAPO.Value,'HPAPO',-3)
		
		ThisForm.cmdNextCompany.Visible = .F.
		ThisForm.cmdNextPOSalesP.Visible = .F.
		ThisForm.cLocateFor = ''
		
		IF nHPAPO > 0
			SELECT tmpPO_top1000
			*SEEK ThisForm.txtSalesOrder.Value ORDER SalesNum
			LOCATE FOR HPAPO = nHPAPO 
			IF !FOUND()
				WAIT WINDOW "Not Found in Top 1000!" NOWAIT
				
				
				IF nHPAPO > 500000 AND nHPAPO < 700000
					*Bring in more records.
					
					IF USED('cntPO')
						USE IN cntPO
					ENDIF
					
					SELECT 0
					cSQL = "SELECT COUNT(*) as cntd FROM dbo.PurchaseOrder "
					cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"cntPO")
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPO')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPO")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPO")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'cntPO')
					ENDIF
		
					IF USED('cntPO')
						IF RECCOUNT('cntPO') > 0
							IF cntPO.CNTD > 0
								**Select more Records
		
								ThisForm.grid1.RecordSource = ""
								
								IF USED('tmpPO_top1000')
									USE IN tmpPO_top1000
								ENDIF
		
								SELECT 0
								cSQL = "SELECT * FROM dbo.PurchaseOrder "
								cSQL = cSQL + " WHERE HPAPO >= "+STR(nHPAPO -100)
								cSQL = cSQL + " ORDER BY HPAPO DESC, ItemPO ASC"
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpPO_top1000")
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_top1000')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_top1000")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_top1000")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpPO_top1000')
								ENDIF
		
								IF NOT USED('tmpPO_top1000')
									MESSAGEBOX( "Could not loading the table.","Program Error")
									RETURN ""
								ENDIF
		
								SELECT tmpPO_top1000
								ThisForm.grid1.RecordSource = "tmpPO_top1000"
								ThisForm.Caption = "Purchase Orders -to ERP PO "+ALLTRIM(STR(nHPAPO))
								
								LOCATE FOR HPAPO = nHPAPO 
								ThisForm.grid1.Refresh
								
							ENDIF
						ENDIF
					ENDIF
				ENDIF
		
			ELSE
				ThisForm.grid1.Refresh
			ENDIF
		ELSE
			WAIT WINDOW "Enter PO Number to search." TIMEOUT 2
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE cmdFindRep.Click
		PRIVATE cPOSalesP
		cPOSalesP = UPPER(PrepareSQLtxt(ThisForm.txtPOSalesP.Value,'POSalesP',20))
		
		ThisForm.cmdNextCompany.Visible = .F.
		ThisForm.cmdNextPOSalesP.Visible = .F.
		ThisForm.cLocateFor = ''
		
		IF LEN(cPOSalesP) > 0
			SELECT tmpPO_top1000
		
			LOCATE FOR UPPER(POSalesP) = cPOSalesP
			IF FOUND()
				ThisForm.cLocateFor = cPOSalesP
				ThisForm.cmdNextPOSalesP.Visible = .T.
			ELSE
				LOCATE FOR UPPER(LEFT(POSalesP,10)) = LEFT(cPOSalesP,10)
				IF FOUND()
					ThisForm.cLocateFor = LEFT(cPOSalesP,10)
					ThisForm.cmdNextPOSalesP.Visible = .T.
				ELSE
					LOCATE FOR UPPER(LEFT(POSalesP,7)) = LEFT(cPOSalesP,7)
					IF FOUND()
						ThisForm.cLocateFor = LEFT(cPOSalesP,7)
						ThisForm.cmdNextPOSalesP.Visible = .T.
					ELSE
						LOCATE FOR UPPER(LEFT(POSalesP,5)) = LEFT(cPOSalesP,5)
						IF FOUND()
							ThisForm.cLocateFor = LEFT(cPOSalesP,5)
							ThisForm.cmdNextPOSalesP.Visible = .T.
						ELSE
						
							LOCATE FOR LEFT(cPOSalesP,7) $ UPPER(POSalesP)
							IF FOUND()
								ThisForm.cLocateFor = LEFT(cPOSalesP,7)
								ThisForm.cmdNextPOSalesP.Visible = .T.
							ELSE
						
								LOCATE FOR UPPER(LEFT(POSalesP,4)) = LEFT(cPOSalesP,4)
								IF FOUND()
									ThisForm.cLocateFor = LEFT(cPOSalesP,4)
									ThisForm.cmdNextPOSalesP.Visible = .T.
								ELSE
									WAIT WINDOW "Not Found!" NOWAIT
									ThisForm.cLocateFor = ''
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ELSE
			WAIT WINDOW "Enter PO Rep to search." TIMEOUT 2
		ENDIF
		ThisForm.grid1.Refresh
	ENDPROC

	PROCEDURE cmdFindSO.Click
		PRIVATE nSalesNum
		nSalesNum= PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		
		ThisForm.cmdNextCompany.Visible = .F.
		ThisForm.cmdNextPOSalesP.Visible = .F.
		ThisForm.cLocateFor = ''
		
		IF nHPAPO > 0
			SELECT tmpPO_top1000
			*SEEK ThisForm.txtSalesOrder.Value ORDER SalesNum
			LOCATE FOR SalesNum = nSalesNum
			IF !FOUND()
				WAIT WINDOW "Not Found in 1000!" NOWAIT
				
				
				IF nHPAPO > 500000 AND nHPAPO < 700000
					*Bring in more records.
					
					IF USED('cntPO')
						USE IN cntPO
					ENDIF
					
					SELECT 0
					cSQL = "SELECT COUNT(*) as cntd FROM dbo.PurchaseOrder "
					cSQL = cSQL + " WHERE SalesNum  = "+STR(nSalesNum)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"cntPO")
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntPO')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPO")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntPO")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'cntPO')
					ENDIF
		
					IF USED('cntPO')
						IF RECCOUNT('cntPO') > 0
							IF cntPO.CNTD > 0
								**Select more Records
		
								ThisForm.grid1.RecordSource = ""
								
								IF USED('tmpPO_top1000')
									USE IN tmpPO_top1000
								ENDIF
		
								SELECT 0
								cSQL = "SELECT * FROM dbo.PurchaseOrder "
								cSQL = cSQL + " WHERE SalesNum >= "+STR(nSalesNum -100)
								cSQL = cSQL + " ORDER BY HPAPO DESC, ItemPO ASC"
		
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"tmpPO_top1000")
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_top1000')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_top1000")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_top1000")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpPO_top1000')
								ENDIF
		
								IF NOT USED('tmpPO_top1000')
									MESSAGEBOX( "Could not loading the table.","Program Error")
									RETURN ""
								ENDIF
		
								SELECT tmpPO_top1000
								ThisForm.grid1.RecordSource = "tmpPO_top1000"
								ThisForm.Caption = "Purchase Orders -to HPA SO "+ALLTRIM(STR(nSalesNum))
								
								LOCATE FOR SalesNum = nSalesNum 
								ThisForm.grid1.Refresh
								
							ENDIF
						ENDIF
					ENDIF
				ENDIF		
				
			ELSE
				ThisForm.grid1.Refresh
			ENDIF
		ELSE
			WAIT WINDOW "Enter SO Number to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE cmdNextCompany.Click
		PRIVATE cCompany 
		cCompany = ThisForm.cLocateFor 
		
		CONTINUE
		ThisForm.grid1.Refresh
	ENDPROC

	PROCEDURE cmdNextPOSalesP.Click
		PRIVATE cPOSalesP 
		cPOSalesP = ThisForm.cLocateFor 
		
		CONTINUE
		ThisForm.grid1.Refresh
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF USED("tmpPO_top1000")
			IF VARTYPE(tmpPO_top1000.POitem) = "C"
				ThisForm.cReturnValue = tmpPO_top1000.POItem
			ELSE
				MESSAGEBOX( "No POitem Selected",0+48,"Nothing will be returned.")
			ENDIF
		ELSE
			MESSAGEBOX("No POitem Selected"+CHR(13)+"Did not find tmpPO_top1000 table.",0+48,"Nothing will be returned.")
		ENDIF
		ThisForm.Release
	ENDPROC

ENDDEFINE
