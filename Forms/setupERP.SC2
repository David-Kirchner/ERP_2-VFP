		DO FORM "Forms\companyprofile_maint.scx"
		ThisForm.Visible = .T.
	ENDPROC

	PROCEDURE DatabaseDir.Valid
		LOCAL lcRoot
		IF ThisForm.LoginDatabase <> ALLTRIM(This.Value)
			ThisForm.LoginDatabase = ALLTRIM(This.Value)
			ThisForm.DatabaseDirMem = ALLTRIM(This.Value)
		ENDIF
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "APPLYSETUPERP", ThisForm
		ENDIF
	ENDPROC

	PROCEDURE HomeDir.Valid
		IF ThisForm.LoginHome <> AllTrim(This.Value)
			ThisForm.LoginHome	= ALLTRIM(This.Value)
		ENDIF
		
		
	ENDPROC

	PROCEDURE lblDatabase.Click
		LOCAL lcRoot
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "PICKDATABASE", ThisForm
			ThisForm.Refresh
		ENDIF
		
		ThisForm.cmdChangeDatabase.Caption = "Save"
	ENDPROC

	PROCEDURE lblHome.Click
		LOCAL lcAppPath 
		lcAppPath = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		
		*Strip lcAppPath to ERP_2
		DO CASE
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "forms"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "libs"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "mem"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "menus"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "progs"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "reports"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "tools"
		        lcAppPath = JUSTPATH(lcAppPath)
		ENDCASE
		
		ThisForm.HomeDir.Value = lcAppPath 
		
		ThisForm.cmdChangeHome.Caption = "Save"
	ENDPROC

	PROCEDURE lblProfile.Click
		LOCAL lcRoot
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "PICKPROFILE", ThisForm
			ThisForm.Refresh
		ENDIF
	ENDPROC

	PROCEDURE lblServer.Click
		LOCAL lcRoot
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
		IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "PICKSERVER", ThisForm
			ThisForm.Refresh
		ENDIF
		
		ThisForm.cmdChangeServer.Caption = "Save"
	ENDPROC

	PROCEDURE ServerDir.Valid
		LOCAL lcRoot
		IF ThisForm.LoginServer <> ALLTRIM(This.Value)
			ThisForm.LoginServer = ALLTRIM(This.Value)
			ThisForm.ServerDirMem = ALLTRIM(This.Value)
		ENDIF
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "APPLYSETUPERP", ThisForm
		ENDIF
	ENDPROC

ENDDEFINE
