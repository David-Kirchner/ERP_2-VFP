DEFINE CLASS hpasetup AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdDone" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblHome" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblServer" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="HomeDir" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="ServerDir" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdChangeHome" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdChangeServer" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="SalespTXT" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSalesp" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdRHPA" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdRMAIL" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdUserInfo" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdRunScripts" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdTiptonPrinter" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblLoginUN" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdUserPermission" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: homedirmem		&& Location of home, normally "C:\Program Files\VFP"
		*p: loginhome
		*p: loginpc
		*p: loginpeachinv
		*p: loginserver
		*p: loginun		&& User Name
		*p: safetyset		&& Setting of SAFETY, Set off in INIT.
		*p: salesp		&& From c:\Salesp.mem
		*p: serverdirmem		&& Location of the Server, normally "E:\Quotes"
		*p: serverpeachinv
	*</DefinedPropArrayMethod>

	*<PropValue>
		AlwaysOnTop = .T.
		AutoCenter = .T.
		Caption = "ERP Setup"
		DataSession = 2
		DoCreate = .T.
		Height = 174
		Icon = ..\ico\options.ico
		loginhome = ""
		loginpc = ""
		loginpeachinv = ""
		loginserver = ""
		loginun = "
		Name = "HPASETUP"
		serverpeachinv = ""
		Width = 428
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdChangeHome' AS commandbutton WITH ;
