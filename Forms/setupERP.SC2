		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblServer' AS label WITH ;
		Caption = "Server", ;
		Height = 17, ;
		Left = 34, ;
		Name = "lblServer", ;
		TabIndex = 8, ;
		ToolTipText = "May be passed over with a XML file entry.", ;
		Top = 66, ;
		Visible = .T., ;
		Width = 40
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'SalespTXT' AS textbox WITH ;
		ControlSource = "ThisForm.SalesP", ;
		Height = 23, ;
		Left = 292, ;
		MaxLength = 1, ;
		Name = "SalespTXT", ;
		TabIndex = 3, ;
		Top = 12, ;
		Width = 24
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'ServerDir' AS textbox WITH ;
		ControlSource = "ThisForm.ServerDirMem", ;
		Height = 23, ;
		Left = 77, ;
		Name = "ServerDir", ;
		TabIndex = 9, ;
		Top = 62, ;
		Visible = .T., ;
		Width = 240
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		*HPASETUP.INIT.
		
		SET EXCLUSIVE OFF 
		This.Safetyset = SET('SAFETY')
		SET SAFETY OFF
		
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO (SYS(5)+SYS(2003)+"\PROGS\Proc_ERP.prg") ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO (SYS(5)+SYS(2003)+"\PROGS\Proc_Quotes.prg") ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")
			SET PROCEDURE TO (SYS(5)+SYS(2003)+"\PROGS\Proc_Setup.prg") ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")
			SET PROCEDURE TO (SYS(5)+SYS(2003)+"\PROGS\Proc_SQL.prg") ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")
			SET PROCEDURE TO (SYS(5)+SYS(2003)+"\Progs\Proc_StockLst.prg") ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")
			SET PROCEDURE TO (SYS(5)+SYS(2003)+"\Progs\Proc_WO.prg") ADDITIVE
		ENDIF
		
		
		
		
		LOCAL MachineInfo, LoginPC1, LoginUN1
		LOCAL LoginHome1
		
		PRIVATE chngHome,ChngServer
		chngHome = .F.
		ChngServer = .T.
		
		MachineInfo = SYS(0)
		IF MachineInfo = "1"
			*USER IS NOT LOGGED INTO SERVER!!!
			ThisForm.LoginPC = ""
			ThisForm.LoginUN = ""
		ELSE
			ThisForm.LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
			LoginPC1 = ThisForm.LoginPC
			ThisForm.LoginUN = RIGHT(MachineInfo,LEN(MachineInfo)-AT("#",MachineInfo) -1 )
			*ThisForm.LoginUN = SUBSTR(SYS(0),AT("#",SYS(0))+2)
			LoginUN1 = ThisForm.LoginUN
		ENDIF
		ThisForm.LoginHome = "C:\Program Files\VFP\"
		LoginHome1 = "C:\Program Files\VFP\"
		
		
		
		
		IF VARTYPE(gGlobalServer) != "C"
			*This code will get correct Server!
			nConnHandle = get_SQLSTRINGCONNECT()
			RELEASE nConnHandle 
		ENDIF
			
		IF VARTYPE(gGlobalServer) != "C"
			ThisForm.LoginServer = gGlobalServer
			LoginServer1 = gGlobalServer
		ENDIF
		
		IF FILE( SYS(5)+SYS(2003)+"\HPASetup.mem" )
			RESTORE FROM SYS(5)+SYS(2003)+"\HPASetup.mem" ADDITIVE
		ELSE
			IF FILE( SYS(5)+SYS(2003)+"\MEM\HPASetup.mem" )
				RESTORE FROM SYS(5)+SYS(2003)+"\MEM\HPASetup.mem" ADDITIVE
			ELSE
				MESSAGEBOX("Could not Restore the HPASetup Memory Variables."+CHR(13)+"Called from SetupERP.SCX Init."+CHR(13)++CHR(13)+"You will need to make the FILE!"+CHR(13)+"Line "+STR(LINENO(1))+CHR(13)+"Possible the first time the Setup App is run.",0+16,"HPASetup.MEM File not found")
			ENDIF
		ENDIF
		
		*********************
		IF VARTYPE(LoginPC)!="C"
			LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
		ENDIF
		IF VARTYPE(LoginPC)!="C"
			LoginPC = ''
		ENDIF
		
		IF VARTYPE(LoginUN)!="C"
			LoginUN = SUBSTR(SYS(0),AT("#",SYS(0))+2)
		ENDIF
		IF VARTYPE(LoginHome)!="C"
			LoginHome = ''
		ENDIF
		*IF VARTYPE(LoginServer) != "C"
		*	LoginServer = gGlobalServer
		*	ThisForm.LoginServer = gGlobalServer
		*ENDIF
		*********************
		
		
		*IF FILE(SYS(5)+SYS(2003) +"\HPASetup.mem")
		*	RESTORE FROM (SYS(5)+SYS(2003) +"\HPASetup.mem") ADDITIVE
		
		IF VARTYPE(LoginPC)="C" AND;
			VARTYPE(LoginUN)="C" AND;
			VARTYPE(LoginHome)="C" 
			* AND VARTYPE(LoginServer)="C" 
			
			IF VARTYPE(LoginPC)!="C"
				LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
			ENDIF
			IF VARTYPE(LoginPC)!="C"
				LoginPC = ''
			ENDIF
		
			IF VARTYPE(LoginUN)!="C"
				LoginUN = SUBSTR(SYS(0),AT("#",SYS(0))+2)
			ENDIF
			IF VARTYPE(LoginHome)!="C"
				LoginHome = ''
			ENDIF
		*	IF VARTYPE(LoginServer) != "C"
		*		LoginServer = gGlobalServer
		*		ThisForm.LoginServer = gGlobalServer
		*	ENDIF
			
			**Double Check
			IF VARTYPE(LoginPC)!="C"
				LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
				IF VARTYPE(LoginPC)!="C"
					LoginPC = ''
					MESSAGEBOX("Could not get the name of you Computer you are logged in at!",0,"Windows Error")
				ENDIF
			ENDIF
			
		*!*		IF VARTYPE(LoginServer) != "C"
		*!*			LoginServer = ''
		*!*		ENDIF
		*!*		IF EMPTY(LoginServer)
		*!*			ThisForm.LoginServer = gGlobalServer
		*!*		ENDIF
		*!*		
			
			ThisForm.LoginPC		= LoginPC
			ThisForm.LoginUN		= LoginUN
			ThisForm.LoginHome		= LoginHome
			ThisForm.LoginServer	= gGlobalServer
			
		ELSE
			IF VARTYPE(LoginPC)!="C"
				LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
				ThisForm.LoginPC		= LoginPC
			ENDIF
		
			IF VARTYPE(LoginUN)!="C"
				LoginUN = SUBSTR(SYS(0),AT("#",SYS(0))+2)
				ThisForm.LoginUN		= LoginUN
			ENDIF
			IF VARTYPE(LoginHome)!="C"
				LoginHome = ''
			ENDIF
			IF VARTYPE(LoginServer) != "C"
				ThisForm.LoginServer = gGlobalServer
			ENDIF
			
			ThisForm.cmdChangeHome.Caption = "Save"
			ThisForm.cmdChangeServer.Caption = "Save"
		ENDIF
		
		
		
		IF ThisForm.LoginUN <> LoginUN1
			*Username change
			DO CASE
			CASE EMPTY(ThisForm.LoginUN)
				*Current User is not listed
			CASE EMPTY(LoginUN1)
				*User name is new
				WAIT window "New User name" NOWAIT
				LoginPC			= ThisForm.LoginPC
				LoginUN			= ThisForm.LoginUN
				LoginHome		= ThisForm.LoginHome
		*		LoginServer		= ThisForm.LoginServer
				SAVE ALL LIKE Login* TO (SYS(5)+SYS(2003) +"\HPASetup.MEM")
			OTHERWISE
				*User name has changed
			ENDCASE
		ENDIF
		
		ThisForm.lblLoginUN.Caption = ThisForm.LoginUN
		
		***************
		IF VARTYPE(ThisForm.LoginHome) != "C"
			IF VARTYPE(LoginHome) = "C"
				ThisForm.LoginHome = 'LoginHome'
			ELSE
				ThisForm.LoginHome = ''
				LoginHome = ''
			ENDIF
		ENDIF
		****************
		
		IF "\" $ ThisForm.LoginHome
			IF FILE(ThisForm.LoginHome+"ERP.EXE")
				*Home is Correct
			ELSE
				IF FILE("C:\Program Files (x86)\VFP\"+"ERP.EXE")
					ThisForm.LoginHome = "C:\Program Files (x86)\VFP\"
					LoginHome = ThisForm.LoginHome
				ELSE
					IF FILE(SYS(5)+"\Program Files (x86)\VFP\"+"ERP.EXE")
						ThisForm.LoginHome = SYS(5)+"\Program Files (x86)\VFP\"
						LoginHome = ThisForm.LoginHome
					ENDIF			
				ENDIF
			ENDIF
		ENDIF
		****************
		
		IF LEN(ThisForm.LoginHome) < 4
			IF FILE(ThisForm.LoginHome+"ERP.EXE")
				*Home is Correct
			ELSE
				IF FILE("C:\Program Files (x86)\VFP\"+"ERP.EXE")
					ThisForm.LoginHome = "C:\Program Files (x86)\VFP\"
					LoginHome = ThisForm.LoginHome
				ELSE
					IF FILE(SYS(5)+"\Program Files (x86)\VFP\"+"ERP.EXE")
						ThisForm.LoginHome = SYS(5)+"\Program Files (x86)\VFP\"
						LoginHome = ThisForm.LoginHome
					ELSE
						IF FILE(SYS(5)+SYS(2003)+"\ERP.EXE")
							ThisForm.LoginHome = SYS(5)+SYS(2003)+"\"
							LoginHome = ThisForm.LoginHome
						ELSE
							IF "MEM" $ ThisForm.LoginHome
								IF FILE(SUBSTR( UPPER(LoginHome), 1, AT("MEM",UPPER(LoginHome))-1 )+"ERP.EXE")
									ThisForm.LoginHome = SUBSTR( UPPER(LoginHome), 1, AT("MEM",UPPER(LoginHome))-1 )
									LoginHome = ThisForm.LoginHome
								ENDIF
							ENDIF
						ENDIF
					ENDIF			
				ENDIF
			ENDIF
		ENDIF
		****************
		PRIVATE cFindHome
		cFindHome = ''
		
		IF FILE(ThisForm.LoginHome+"ERP.EXE")
			*Home is Correct
		ELSE
			*SETUP HOME
			WAIT WINDOW "Open the ERP.EXE in your home directory" NOWAIT
			cFindHome = LOCFILE("ERP.EXE","EXE","Find your Home dirctory with file ERP.EXE")
			IF !EMPTY(cFindHome) AND FILE(cFindHome)
				ThisForm.LoginHome = LEFT(cFindHome,AT("ERP.EXE",cFindHome)-1)
				WAIT window "Setting Home Directory" NOWAIT
				LoginPC			= ThisForm.LoginPC
				LoginUN			= ThisForm.LoginUN
				LoginHome		= ThisForm.LoginHome
		*		LoginServer		= ThisForm.LoginServer
		
				SAVE ALL LIKE Login* TO (SYS(5)+SYS(2003) +"\HPASetup.MEM")
				ThisForm.cmdChangeHome.Caption = "Save"
				chngHome = .T.
			ENDIF
		ENDIF
		
		*!*	IF VARTYPE(ThisForm.LoginServer)="C" 
		*!*		*Server is correct
		*!*	ELSE
		*!*		*SETUP SERVER
		*!*		
		*!*		*IF !EMPTY(FindServer) AND FILE(FindServer)
		*!*		*	ThisForm.LoginServer = LEFT(FindServer,AT("HPA.DBC",FindServer)-1)
		*!*		*	WAIT WINDOW "Setting Server Drive" NOWAIT
		*!*	*		LoginPC			= ThisForm.LoginPC
		*!*	*		LoginUN			= ThisForm.LoginUN
		*!*	*		LoginHome		= ThisForm.LoginHome
		*!*	*		LoginServer		= ThisForm.LoginServer
		*!*	*		SAVE ALL LIKE Login* TO (SYS(5)+SYS(2003) +"\HPASetup.MEM")
		*!*		*	thisform.cmdChangeServer.Caption = "Save"
		*!*		*	ChngServer = .T.
		*!*		*ENDIF
		*!*	ENDIF
		
		
		ThisForm.HomeDirMem   = ThisForm.LoginHome
		ThisForm.ServerDirMem = ThisForm.LoginServer
		
		
		LoginPC = LEFT( SYS(0), AT(" #",SYS(0)))
		AppSetup_Login(ThisForm.LoginUN,LoginPC,ThisForm.LoginHome,ThisForm.LoginServer)
		
		
		
		IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			IF TYPE("SALESP") = "C"
				ThisForm.SALESP = SALESP
			ELSE
				ThisForm.SALESP = "0"
			ENDIF
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
				IF TYPE("SALESP") = "C"
					ThisForm.SALESP = SALESP
				ELSE
					ThisForm.SALESP = "0"
				ENDIF
			ELSE
				ThisForm.SALESP = "0"
			ENDIF
		ENDIF
		
		IF FILE(SYS(5)+SYS(2003) +"\Scripts.mem")
			ThisForm.cmdRunScripts.Enabled = .T.
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		
		_SCREEN.Icon = "\GRAPHICS\HPAlloy.ICO"
		_SCREEN.Caption="Shop Edit StockLst"
		
		*_SCREEN.Height = 1
		*_SCREEN.Width = 200
		
		*DO (SYS(5)+SYS(2003)+"\Progs\CreateHPAdsn.prg")
		*DO \Progs\CreateHPAdsn.prg
		
		PUSH MENU _msysmenu
		*DO \Menus\SetupERP.mpr
		DO (SYS(5)+SYS(2003)+"\menus\SetupERP.mpr")
		
		
		
	ENDPROC

	PROCEDURE cmdChangeHome.Click
		IF TYPE('ThisForm.LoginHome')="U"
			ThisForm.LoginHome= ""
		ENDIF
		
		PRIVATE cFindHome
		cFindHome = ''
		
		IF This.Caption = "Change"
			LoginHome1 = ThisForm.LoginHome
		*	cFindHome = LOCFILE("C:\ERP.EXE","EXE","Find your Home directory with file ERP.EXE")
			cFindHome = GETFILE("EXE","ERP.EXE","Select",0,"Find your Home directory with file ERP.EXE")
			IF !EMPTY(cFindHome) AND FILE(cFindHome)
				ThisForm.LoginHome = ALLTRIM(LEFT(cFindHome,AT("ERP.EXE",cFindHome)-1))
				ThisForm.HomeDirMem = ThisForm.LoginHome
				
				IF LoginHome1 <> ThisForm.LoginHome
					This.Caption = "Save"
					ThisForm.HomeDir.Value = ALLTRIM(ThisForm.LoginHome)
				ENDIF
			ENDIF
		ELSE
		*This.Caption = "Save"
			LoginPC			= ThisForm.LoginPC
			LoginUN			= ThisForm.LoginUN
			LoginHome		= ThisForm.LoginHome
		*	LoginServer		= ThisForm.LoginServer
			
			IF "\MEM" $ SYS(2003)
				SAVE ALL LIKE Login* TO (SYS(5)+SYS(2003) +"\HPASetup.MEM")
				WAIT WINDOW "SAVE ALL LIKE Login* TO "+(SYS(5)+SYS(2003) +"\HPASetup.MEM   Any key to continue..." ) 
			ELSE
				SAVE ALL LIKE Login* TO (SYS(5)+SYS(2003) +"\MEM\HPASetup.MEM")
				WAIT WINDOW "SAVE ALL LIKE Login* TO "+(SYS(5)+SYS(2003) +"\MEM\HPASetup.MEM   Any key to continue..." ) 
			ENDIF
			This.Caption = "Change"
		
		ENDIF
		
		AppSetup_Update_Ans( (ThisForm.LoginHome),(ThisForm.LoginUN),"Home" )
		
		ThisForm.Refresh
	ENDPROC

	PROCEDURE cmdChangeServer.Click
		IF VARTYPE(ThisForm.LoginServer)!="C"
			ThisForm.LoginServer= ""
		ENDIF
		PRIVATE cLoginServer
		cLoginServer = ''
		PRIVATE cFindHome
		cFindHome = ''
		
		IF This.Caption = "Change"
			cLoginServer = ThisForm.LoginServer
		
			*Read XML files only once	
			IF FILE( "\\Windfall.HPA.local\SQL\HPAdata.xml" )
				*READ file
				TRY
					XMLTOCURSOR( "\\Windfall.HPA.local\SQL\HPAdata.xml", 'HPAdata', 512)
					
					IF USED('HPAdata')
						IF VARTYPE( HPAdata.WindfallServer ) = "C"
							cWindfallServer1 = RTRIM(HPAdata.WindfallServer)
							*gDefaultSQLserver = cWindfallServer1 
							gGlobalServer = cWindfallServer1 
							lFoundWindfall = .T.
						ENDIF
						
						
						IF VARTYPE( HPAdata.TiptonServer ) = "C"
							cTiptonServer1 = RTRIM(HPAdata.TiptonServer)
						ENDIF
		
						IF VARTYPE( HPAdata.BackUpServer ) = "C"
							cBackUpServer = RTRIM(HPAdata.BackUpServer)
						ENDIF
						
						USE IN HPAdata
					ENDIF
				CATCH
					MESSAGEBOX("Tell IT department."+CHR(13)+CHR(13)+"ERROR Reading XML file."+CHR(13)+[XMLTOCURSOR( ]+CHR(13)+["\\Windfall.HPA.local\SQL\HPAdata.xml"]+CHR(13)+[, 'HPAdata', 512)],16,"Could not get DFS file")
				ENDTRY
				
				
				DO FORM "Forms\SetServer.scx"
				
			ENDIF
			
		*	IF !EMPTY(cFindHome) AND !FILE(cFindHome)
		*		cFindHome = GETFILE("TXT","Find your SQL Server directory with file LoginServer.txt")
		*	ENDIF
			
			*cLoginServer = gDefaultSQLserver 
			cLoginServer = gGlobalServer
		*	IF !EMPTY(cFindHome) AND FILE(cFindHome)
		*		ThisForm.LoginServer = ALLTRIM(LEFT(cFindHome,AT("LOGINSERVER.TXT",UPPER(cFindHome))-1))
				
				IF cLoginServer <> ThisForm.LoginServer 
					ThisForm.LoginServer = cLoginServer
					*This.Caption = "Save"
					ThisForm.ServerDir.Value = cLoginServer
					*ThisForm.HomeDir.Value = ALLTRIM(ThisForm.LoginHome)
				ENDIF
		*	ENDIF
		ELSE
			*This.Caption = "Save"
		
			*This.Caption = "Change"
		
		ENDIF
		
		AppSetup_Update_Ans( (ThisForm.LoginServer ),(ThisForm.LoginUN),"Server" )
		
		ThisForm.Refresh
	ENDPROC

	PROCEDURE cmdDone.Click
		IF ThisForm.cmdChangeHome.Caption = "Save" AND ThisForm.cmdChangeServer.Caption = "Save"
			RETURN .F.
		ENDIF
		
		IF ThisForm.cmdChangeHome.Caption = "Save"
			=MESSAGEBOX('You must SAVE the Home location first!',16,"")
			RETURN .F.
		ENDIF
		*IF ThisForm.cmdChangeServer.Caption = "Save"
		*	=MESSAGEBOX('You must SAVE the Server location first!',16,"")
		*	RETURN .F.
		*ENDIF
		
		***Double check SalesP.MEM
		IF NOT FILE(SYS(5)+SYS(2003) +"\SalesP.MEM") OR FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
			SalesP = UPPER(ALLTRIM(ThisForm.SalesP))
			IF EMPTY(SalesP)
				SalesP="0"
			ENDIF
			
			* Does it need the "\MEM"
			IF FILE( SYS(5)+SYS(2003)+"\HPASetup.mem" )	
				SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\SalesP.MEM")
			ELSE
				IF FILE( SYS(5)+SYS(2003)+"\MEM\HPASetup.mem" )	
					SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				ENDIF
			ENDIF
			
			IF SalesP!="0"
				AppSetup_Update_Ans( SalesP, ThisForm.SalesP, "SalesP" )
			ENDIF
		ENDIF
		
		
		
		
		IF ThisForm.Safetyset = "ON"
			SET SAFETY ON
		ENDIF
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdRHPA.Click
		WAIT WINDOW "Validating the Database" NOWAIT
		OPEN DATABASE (ThisForm.ServerDirMem)+"HPA" SHARED VALIDATE
		WAIT CLEAR
	ENDPROC

	PROCEDURE cmdRMAIL.Click
		WAIT WINDOW "Validating the Database" NOWAIT
		OPEN DATABASE (ThisForm.ServerDirMem)+"MAIL" SHARED VALIDATE
		WAIT CLEAR
	ENDPROC

	PROCEDURE cmdRunScripts.Click
		WAIT WINDOW "Running Scripts" NOWAIT
		
		IF FILE(SYS(5)+SYS(2003) +"\Scripts.mem")
			RESTORE FROM (SYS(5)+SYS(2003) +"\Scripts.mem") ADDITIVE
			IF TYPE("script1") = "C"
				&script1
			ENDIF
			IF TYPE("script2") = "C"
				&script2
			ENDIF
			IF TYPE("script3") = "C"
				&script3
			ENDIF
			IF TYPE("script4") = "C"
				&script4
			ENDIF
			IF TYPE("script5") = "C"
				&script5
			ENDIF
			IF TYPE("script6") = "C"
				&script6
			ENDIF
			IF TYPE("script7") = "C"
				&script7
			ENDIF
			IF TYPE("script8") = "C"
				&script8
			ENDIF
			IF TYPE("script9") = "C"
				&script9
			ENDIF
		
			DELETE FILE (SYS(5)+SYS(2003) +"\Scripts.mem")
		ENDIF
		
		WAIT CLEAR
		This.enabled = .F.
	ENDPROC

	PROCEDURE cmdSalesp.Click
		PRIVATE cSalesPinit
		cSalesPinit = UPPER(ALLTRIM(ThisForm.SalesP))
		IF EMPTY(cSalesPinit)
			cSalesPinit="0"
		ENDIF
		SalesP = cSalesPinit
		
		IF "\MEM" $ SYS(2003)
			SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\SalesP.MEM")
		ELSE
			SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
		ENDIF
			
		
		*IF cSalesPinit != "0"
		*	AppSetup_Update_Ans( cSalesPinit, ThisForm.LoginUN, "SalesP" )
		*	*AppSetup_Update_Ans( pcAns, pcUN, pcPRP, pConn )
		*ENDIF
		
		wait window 'Stored to disk' nowait
		ThisForm.SalespTXT.Value = cSalesPinit
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmdTiptonPrinter.Click
		WAIT WINDOW "Checking for a Printer in Tipton" NOWAIT
		
		PRIVATE lTipton
		lTipton = .F.
		
		PRIVATE nPrinters
		nPrinters = APRINTERS(aaPrinters)
		
		IF nPrinters > 0
			FOR CT = 1 TO nPrinters
				IF "TIPTON " $ UPPER(aaPrinters(ct,1))
					TRY
						SET PRINTER TO &aaPrinters(ct,1)
						MESSAGEBOX("Found Printer Called:"+(aaPrinters(ct,1)),0+64,"Tipton Printer")
						lTipton = .T.
						*EXIT
					CATCH
						MESSAGEBOX("Tell David Printer '"+ALLTRIM(aaPrinters(ct,1))+"' caused an Error."+CHR(13)+"Default printer will be used.",0+48,"Printer Error")		
					FINALLY
						SET PRINTER TO DEFAULT
					ENDTRY
				ENDIF
				
			NEXT CT
		
		ENDIF
		
		IF lTipton
			WAIT WINDOW "Done looking for a Tipton printer" NOWAIT
		ELSE
			WAIT WINDOW "Did not find a Tipton printer!"
		ENDIF
		
	ENDPROC

	PROCEDURE cmdUserInfo.Click
		ThisForm.Visible = .F.
		DO FORM 'Forms\UserInfo.scx'
		ThisForm.Visible = .T.
		
	ENDPROC

	PROCEDURE cmdUserPermission.Click
		ThisForm.Visible = .F.
		DO FORM "Forms\Show_User_Permission.scx"
		ThisForm.Visible = .T.
	ENDPROC

	PROCEDURE HomeDir.InteractiveChange
			ThisForm.cmdChangeHome.Caption = "Save"
	ENDPROC

	PROCEDURE HomeDir.Valid
		IF ThisForm.LoginHome <> AllTrim(This.Value)
			ThisForm.LoginHome	= ALLTRIM(This.Value)
		ENDIF
		
		
	ENDPROC

	PROCEDURE lblHome.Click
		ThisForm.HomeDir.Value = "C:\Program Files (x86)\HPA\"
		ThisForm.cmdChangeHome.Caption = "Save"
	ENDPROC

	PROCEDURE lblServer.Click
		ThisForm.ServerDir.Value = "PEREGRINE"
		ThisForm.cmdChangeServer.Caption = "Save"
	ENDPROC

	PROCEDURE ServerDir.InteractiveChange
		ThisForm.cmdChangeServer.Caption = "Save"
	ENDPROC

	PROCEDURE ServerDir.Valid
		IF ThisForm.LoginServer	<> ALLTRIM(This.Value)
			ThisForm.LoginServer	= ALLTRIM(This.Value)
		ENDIF
		
		
		
	ENDPROC

ENDDEFINE
