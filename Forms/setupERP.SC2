		Width = 132
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'HomeDir' AS textbox WITH ;
		ControlSource = "ThisForm.HomeDirMem", ;
		Height = 23, ;
		Left = 77, ;
		Name = "HomeDir", ;
		TabIndex = 6, ;
		Top = 37, ;
