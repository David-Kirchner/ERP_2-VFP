		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblHome' AS label WITH ;
		Caption = "Home", ;
		Height = 17, ;
		Left = 35, ;
		Name = "lblHome", ;
		TabIndex = 5, ;
		ToolTipText = "Used in Main.prg as SET DEFAULT TO (LoginAppHome) and SET PATH TO (LoginAppHome)", ;
		Top = 40, ;
