	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		*ERPSETUP.INIT.
		
		SET EXCLUSIVE OFF 
		This.Safetyset = SET('SAFETY')
		SET SAFETY OFF
		
		LOCAL lcRoot
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO (lcRoot + "PROGS\Proc_ERP.prg") ADDITIVE
		ENDIF
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")
			SET PROCEDURE TO (lcRoot + "PROGS\Proc_Setup.prg") ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")
			SET PROCEDURE TO (lcRoot + "PROGS\Proc_SQL.prg") ADDITIVE
		ENDIF
		IF FILE(lcRoot + "PROGS\load_ERP_Environment.prg")
			SET PROCEDURE TO (lcRoot + "PROGS\load_ERP_Environment.prg") ADDITIVE
		ENDIF
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			SET PROCEDURE TO (lcRoot + "PROGS\ERP_Environment_UI.prg") ADDITIVE
		ENDIF
		
		LOCAL lcAppRoot, MachineInfo, LoginPC1, LoginUN1
		lcAppRoot = lcRoot
		DO CASE
		    CASE LOWER(JUSTFNAME(lcAppRoot)) == "forms"
		        lcAppRoot = JUSTPATH(lcAppRoot)
		    CASE LOWER(JUSTFNAME(lcAppRoot)) == "libs"
		        lcAppRoot = JUSTPATH(lcAppRoot)
		    CASE LOWER(JUSTFNAME(lcAppRoot)) == "mem"
		        lcAppRoot = JUSTPATH(lcAppRoot)
		    CASE LOWER(JUSTFNAME(lcAppRoot)) == "menus"
		        lcAppRoot = JUSTPATH(lcAppRoot)
		    CASE LOWER(JUSTFNAME(lcAppRoot)) == "progs"
		        lcAppRoot = JUSTPATH(lcAppRoot)
		    CASE LOWER(JUSTFNAME(lcAppRoot)) == "reports"
		        lcAppRoot = JUSTPATH(lcAppRoot)
		    CASE LOWER(JUSTFNAME(lcAppRoot)) == "tools"
		        lcAppRoot = JUSTPATH(lcAppRoot)
		ENDCASE
		lcAppRoot = ADDBS(lcAppRoot)
		IF VARTYPE(LoginAppHome) = "U"
			PUBLIC LoginAppHome
		ENDIF
		IF VARTYPE(gERPAppHome) = "U"
			PUBLIC gERPAppHome
		ENDIF
		IF FILE(lcAppRoot + "ERP_Environment.xml")
			LoginAppHome = lcAppRoot
			gERPAppHome = lcAppRoot
		ENDIF
		IF FILE(lcRoot + "PROGS\load_ERP_Environment.prg")
			= load_ERP_Environment(.T.)
		ENDIF
		
		
		LOCAL LoginHome1
		
		PRIVATE chngHome,ChngServer
		chngHome = .F.
		ChngServer = .T.
		
		MachineInfo = SYS(0)
		IF MachineInfo = "1"
			*USER IS NOT LOGGED INTO SERVER!!!
			ThisForm.LoginPC = ""
			ThisForm.LoginUN = ""
		ELSE
			ThisForm.LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
			LoginPC1 = ThisForm.LoginPC
			ThisForm.LoginUN = RIGHT(MachineInfo,LEN(MachineInfo)-AT("#",MachineInfo) -1 )
			*ThisForm.LoginUN = SUBSTR(SYS(0),AT("#",SYS(0))+2)
			LoginUN1 = ThisForm.LoginUN
		ENDIF
		
		lcAppPath = lcRoot	
		*JUSTPATH(SYS(16, 0))
		*? lcAppPath 
		
		*Strip lcAppPath to ERP_2
		DO CASE
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "forms"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "libs"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "mem"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "menus"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "progs"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "reports"
		        lcAppPath = JUSTPATH(lcAppPath)
		    CASE LOWER(JUSTFNAME(lcAppPath)) == "tools"
		        lcAppPath = JUSTPATH(lcAppPath)
		ENDCASE
		
		*? SET("DEFAULT")
		SET DEFAULT TO (lcAppPath)
		
		ThisForm.LoginHome = lcAppPath
		LoginHome1 = lcAppPath
		
		
		
		
		IF VARTYPE(gGlobalServer) != "C"
			*This code will get correct Server!
			nConnHandle = get_SQLSTRINGCONNECT()
			RELEASE nConnHandle 
		ENDIF
			
		IF VARTYPE(gGlobalServer) != "C"
			ThisForm.LoginServer = gGlobalServer
			LoginServer1 = gGlobalServer
		ENDIF
		
		IF FILE( SYS(5)+SYS(2003)+"\ERPSetup.mem" )
			RESTORE FROM SYS(5)+SYS(2003)+"\ERPSetup.mem" ADDITIVE
			ThisForm.LoginPC		= LoginPC
			ThisForm.LoginUN		= LoginUN
			ThisForm.LoginHome		= LoginHome
			ThisForm.LoginServer	= gGlobalServer
			ThisForm.LoginDatabase	= gGlobalDatabase
		ELSE
			IF FILE( SYS(5)+SYS(2003)+"\MEM\ERPSetup.mem" )
				RESTORE FROM SYS(5)+SYS(2003)+"\MEM\ERPSetup.mem" ADDITIVE
				ThisForm.LoginPC		= LoginPC
				ThisForm.LoginUN		= LoginUN
				ThisForm.LoginHome		= LoginHome
				ThisForm.LoginServer	= gGlobalServer
				ThisForm.LoginDatabase	= gGlobalDatabase
			
			ELSE
				MESSAGEBOX("Could not Restore the ERPSetup Memory Variables."+CHR(13)+"Called from SetupERP.SCX Init."+CHR(13)++CHR(13)+"You will need to make the FILE!"+CHR(13)+"Line "+STR(LINENO(1))+CHR(13)+"Possible the first time the Setup App is run.",0+16,"ERPSetup.MEM File not found")
			ENDIF
		ENDIF
		
		*********************
		*IF VARTYPE(LoginPC)!="C"
			LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
		*ENDIF
		IF VARTYPE(LoginPC)!="C"
			LoginPC = ''
		ENDIF
		
		*IF VARTYPE(LoginUN)!="C"
			LoginUN = SUBSTR(SYS(0),AT("#",SYS(0))+2)
		*ENDIF
		IF VARTYPE(LoginHome)!="C"
			LoginHome = ''
		ENDIF
		*IF VARTYPE(LoginServer) != "C"
		*	LoginServer = gGlobalServer
		*	ThisForm.LoginServer = gGlobalServer
		*ENDIF
		*********************
		
		
		*IF FILE(SYS(5)+SYS(2003) +"\ERPSetup.mem")
		*	RESTORE FROM (SYS(5)+SYS(2003) +"\ERPSetup.mem") ADDITIVE
		
		IF VARTYPE(LoginPC)="C" AND;
			VARTYPE(LoginUN)="C" AND;
			VARTYPE(LoginHome)="C" 
			* AND VARTYPE(LoginServer)="C" 
			
			IF VARTYPE(LoginPC)!="C"
				LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
			ENDIF
			IF VARTYPE(LoginPC)!="C"
				LoginPC = ''
			ENDIF
		
			IF VARTYPE(LoginUN)!="C"
				LoginUN = SUBSTR(SYS(0),AT("#",SYS(0))+2)
			ENDIF
			IF VARTYPE(LoginHome)!="C"
				LoginHome = ''
			ENDIF
		*	IF VARTYPE(LoginServer) != "C"
		*		LoginServer = gGlobalServer
		*		ThisForm.LoginServer = gGlobalServer
		*	ENDIF
			
			**Double Check
			IF VARTYPE(LoginPC)!="C"
				LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
				IF VARTYPE(LoginPC)!="C"
					LoginPC = ''
					MESSAGEBOX("Could not get the name of you Computer you are logged in at!",0,"Windows Error")
				ENDIF
			ENDIF
			
		*!*		IF VARTYPE(LoginServer) != "C"
		*!*			LoginServer = ''
		*!*		ENDIF
		*!*		IF EMPTY(LoginServer)
		*!*			ThisForm.LoginServer = gGlobalServer
		*!*		ENDIF
		*!*		
			
			ThisForm.LoginPC		= LoginPC
			ThisForm.LoginUN		= LoginUN
			ThisForm.LoginHome		= LoginHome
			IF VARTYPE(gGlobalServer)="C" AND !EMPTY(ALLTRIM(gGlobalServer))
				ThisForm.LoginServer = gGlobalServer
			ENDIF
			IF VARTYPE(gGlobalDatabase)="C" AND !EMPTY(ALLTRIM(gGlobalDatabase))
				ThisForm.LoginDatabase = gGlobalDatabase
			ENDIF
			
		ELSE
			IF VARTYPE(LoginPC)!="C"
				LoginPC = LEFT(MachineInfo,AT("#",MachineInfo)-1 )
				ThisForm.LoginPC		= LoginPC
			ENDIF
		
			IF VARTYPE(LoginUN)!="C"
				LoginUN = SUBSTR(SYS(0),AT("#",SYS(0))+2)
				ThisForm.LoginUN		= LoginUN
			ENDIF
			IF VARTYPE(LoginHome)!="C"
				LoginHome = ''
			ENDIF
			IF VARTYPE(LoginServer) != "C"
				ThisForm.LoginServer = gGlobalServer
			ENDIF
			
		ENDIF
		
		
		
		IF ThisForm.LoginUN <> LoginUN1
			*Username change
			DO CASE
			CASE EMPTY(ThisForm.LoginUN)
				*Current User is not listed
			CASE EMPTY(LoginUN1)
				*User name is new
				WAIT window "New User name" NOWAIT
				LoginPC			= ThisForm.LoginPC
				LoginUN			= ThisForm.LoginUN
				LoginHome		= ThisForm.LoginHome
		*		LoginServer		= ThisForm.LoginServer
				SAVE ALL LIKE Login* TO (SYS(5)+SYS(2003) +"\ERPSetup.MEM")
			OTHERWISE
				*User name has changed
			ENDCASE
		ENDIF
		
		ThisForm.lblLoginUN.Caption = ThisForm.LoginUN
		
		***************
		IF VARTYPE(ThisForm.LoginHome) != "C"
			IF VARTYPE(LoginHome) = "C"
				ThisForm.LoginHome = 'LoginHome'
			ELSE
				ThisForm.LoginHome = ''
				LoginHome = ''
			ENDIF
		ENDIF
		****************
		
		*!*	IF "\" $ ThisForm.LoginHome
		*!*		IF FILE(ThisForm.LoginHome+"ERP Home.txt")
		*!*			*Home is Correct
		*!*		ELSE
		*!*			IF FILE("C:\Program Files (x86)\VFP\"+"ERP Home.txt")
		*!*				ThisForm.LoginHome = "C:\Program Files (x86)\VFP\"
		*!*				LoginHome = ThisForm.LoginHome
		*!*			ELSE
		*!*				IF FILE(SYS(5)+"\Program Files (x86)\VFP\"+"ERP Home.txt")
		*!*					ThisForm.LoginHome = SYS(5)+"\Program Files (x86)\VFP\"
		*!*					LoginHome = ThisForm.LoginHome
		*!*				ENDIF			
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		****************
		
		*!*	IF LEN(ThisForm.LoginHome) < 4
		*!*		IF FILE(ThisForm.LoginHome+"ERP Home.txt")
		*!*			*Home is Correct
		*!*		ELSE
		*!*			IF FILE("C:\Program Files (x86)\VFP\"+"ERP Home.txt")
		*!*				ThisForm.LoginHome = "C:\Program Files (x86)\VFP\"
		*!*				LoginHome = ThisForm.LoginHome
		*!*			ELSE
		*!*				IF FILE(SYS(5)+"\Program Files (x86)\VFP\"+"ERP Home.txt")
		*!*					ThisForm.LoginHome = SYS(5)+"\Program Files (x86)\VFP\"
		*!*					LoginHome = ThisForm.LoginHome
		*!*				ELSE
		*!*					IF FILE(SYS(5)+SYS(2003)+"\ERP Home.txt")
		*!*						ThisForm.LoginHome = SYS(5)+SYS(2003)+"\"
		*!*						LoginHome = ThisForm.LoginHome
		*!*					ELSE
		*!*						IF "MEM" $ ThisForm.LoginHome
		*!*							IF FILE(SUBSTR( UPPER(LoginHome), 1, AT("MEM",UPPER(LoginHome))-1 )+"ERP Home.txt")
		*!*								ThisForm.LoginHome = SUBSTR( UPPER(LoginHome), 1, AT("MEM",UPPER(LoginHome))-1 )
		*!*								LoginHome = ThisForm.LoginHome
		*!*							ENDIF
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDIF			
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		****************
		PRIVATE cFindHome
		cFindHome = ''
		
		*!*	IF FILE(ThisForm.LoginHome+"ERP Home.txt")
		*!*		*Home is Correct
		*!*	ELSE
		*!*		*SETUP HOME
		*!*		WAIT WINDOW "Open the ERP Home.txt in your home directory" NOWAIT
		*!*		cFindHome = LOCFILE("ERP Home.txt","EXE","Find your Home dirctory with file ERP Home.txt")
		*!*		IF !EMPTY(cFindHome) AND FILE(cFindHome)
		*!*			ThisForm.LoginHome = LEFT(cFindHome,AT("ERP Home.txt",cFindHome)-1)
		*!*			WAIT window "Setting Home Directory" NOWAIT
		*!*			LoginPC			= ThisForm.LoginPC
		*!*			LoginUN			= ThisForm.LoginUN
		*!*			LoginHome		= ThisForm.LoginHome
		*!*	*		LoginServer		= ThisForm.LoginServer
		
		*!*			SAVE ALL LIKE Login* TO (SYS(5)+SYS(2003) +"\ERPSetup.MEM")
		*!*			ThisForm.cmdChangeHome.Caption = "Save"
		*!*			chngHome = .T.
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF VARTYPE(ThisForm.LoginServer)="C" 
		*!*		*Server is correct
		*!*	ELSE
		*!*		*SETUP SERVER
		*!*		
		*!*		*IF !EMPTY(FindServer) AND FILE(FindServer)
		*!*		*	ThisForm.LoginServer = LEFT(FindServer,AT("HPA.DBC",FindServer)-1)
		*!*		*	WAIT WINDOW "Setting Server Drive" NOWAIT
		*!*	*		LoginPC			= ThisForm.LoginPC
		*!*	*		LoginUN			= ThisForm.LoginUN
		*!*	*		LoginHome		= ThisForm.LoginHome
		*!*	*		LoginServer		= ThisForm.LoginServer
		*!*	*		SAVE ALL LIKE Login* TO (SYS(5)+SYS(2003) +"\ERPSetup.MEM")
		*!*		*	thisform.cmdChangeServer.Caption = "Save"
		*!*		*	ChngServer = .T.
		*!*		*ENDIF
		*!*	ENDIF
		
		
		ThisForm.HomeDirMem   = ThisForm.LoginHome
		ThisForm.ServerDirMem = ThisForm.LoginServer
		IF VARTYPE(ThisForm.LoginDatabase) != "C"
			ThisForm.LoginDatabase = ""
		ENDIF
		ThisForm.DatabaseDirMem = ThisForm.LoginDatabase
		
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "INITSETUPERP", ThisForm
		ENDIF
		
		LoginPC = LEFT( SYS(0), AT(" #",SYS(0)))
		AppSetup_Login(ThisForm.LoginUN,LoginPC,ThisForm.LoginHome,ThisForm.LoginServer)
		IF !EMPTY(ALLTRIM(ThisForm.LoginDatabase))
			AppSetup_Update_Ans(ThisForm.LoginDatabase, ThisForm.LoginUN, "Database")
		ELSE
			IF VARTYPE(gGlobalDatabase) = "C" AND NOT EMPTY(gGlobalDatabase)
				AppSetup_Update_Ans(gGlobalDatabase, ThisForm.LoginUN, "Database")
			ENDIF
		ENDIF
		
		
		
		IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			IF TYPE("SALESP") = "C"
				ThisForm.SALESP = SALESP
			ELSE
				ThisForm.SALESP = "0"
			ENDIF
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
				IF TYPE("SALESP") = "C"
					ThisForm.SALESP = SALESP
				ELSE
					ThisForm.SALESP = "0"
				ENDIF
			ELSE
				ThisForm.SALESP = "0"
			ENDIF
		ENDIF
		
		IF FILE(SYS(5)+SYS(2003) +"\Scripts.mem")
			ThisForm.cmdRunScripts.Enabled = .T.
		ENDIF
		
		* Load report Name (dbo.AppUsers.DisplayName) for this login
		ThisForm.cDisplayName = AppUsers_Get_DisplayName(ThisForm.LoginUN)
		IF EMPTY(ThisForm.cDisplayName)
			ThisForm.cDisplayName = AppSetup_Login_DisplayName(ThisForm.LoginUN)
			IF UPPER(ALLTRIM(ThisForm.cDisplayName)) == UPPER(ALLTRIM(ThisForm.LoginUN))
				ThisForm.cDisplayName = ""
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		LOCAL lcRoot, lcMenu
		
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		lcMenu = lcRoot + "MENUS\SETUP_ERP.mpr"
		IF !FILE(lcMenu)
			lcMenu = lcRoot + "menus\Setup_ERP.mpr"
		ENDIF
		
		IF TYPE("ApplyCompanyIconToForm") = "F"
			= ApplyCompanyIconToForm(_SCREEN)
		ELSE
			_SCREEN.Icon = GetCompanyIconPath()
		ENDIF
		_SCREEN.Caption = "ERP Setup"
		
		PUSH MENU _msysmenu
		IF FILE(lcMenu)
			DO (lcMenu)
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE cmdChangeDatabase.Click
		LOCAL lcRoot
		IF This.Caption # "Save"
			RETURN
		ENDIF
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "SAVEDATABASE", ThisForm
		ENDIF
	ENDPROC

	PROCEDURE cmdChangeHome.Click
		LOCAL lcRoot, lcFindHome, lcHome, lcMemFile
		IF TYPE('ThisForm.LoginHome')="U"
			ThisForm.LoginHome = ""
		ENDIF
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			lcFindHome = GETFILE("TXT","ERP Home.txt","Select",0,"Find folder containing ERP Home.txt")
			IF EMPTY(lcFindHome)
				RETURN
			ENDIF
			lcHome = ALLTRIM(LEFT(lcFindHome, RAT("ERP Home.txt", lcFindHome) - 1))
			IF EMPTY(lcHome)
				lcHome = ALLTRIM(JUSTPATH(lcFindHome))
			ENDIF
			ThisForm.LoginHome = ADDBS(lcHome)
			ThisForm.HomeDirMem = ThisForm.LoginHome
			IF VARTYPE(LoginAppHome) = "U"
				PUBLIC LoginAppHome
			ENDIF
			IF VARTYPE(gERPAppHome) = "U"
				PUBLIC gERPAppHome
			ENDIF
			LoginAppHome = ThisForm.LoginHome
			gERPAppHome = ThisForm.LoginHome
			IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
				lcMemFile = ""
				DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "SAVELOGINMEM", ThisForm
			ENDIF
			AppSetup_Update_Ans(ThisForm.LoginHome, ThisForm.LoginUN, "Home")
			MESSAGEBOX("Home saved to:" + CHR(13) + ThisForm.LoginHome, 64, "ERP Setup")
			
			ThisForm.Refresh
		ENDIF
		IF This.Caption = "Save"
			ThisForm.LoginHome = ADDBS(ALLTRIM(ThisForm.HomeDir.Value))
			ThisForm.HomeDirMem = ThisForm.LoginHome
			IF VARTYPE(LoginAppHome) = "U"
				PUBLIC LoginAppHome
			ENDIF
			IF VARTYPE(gERPAppHome) = "U"
				PUBLIC gERPAppHome
			ENDIF
			LoginAppHome = ThisForm.LoginHome
			gERPAppHome = ThisForm.LoginHome
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "SAVELOGINMEM", ThisForm
			AppSetup_Update_Ans(ThisForm.LoginHome, ThisForm.LoginUN, "Home")
			MESSAGEBOX("Home saved to:" + CHR(13) + ThisForm.LoginHome, 64, "ERP Setup")
		ENDIF	
	ENDPROC

	PROCEDURE cmdChangeServer.Click
		LOCAL lcRoot
		IF This.Caption # "Save"
			RETURN
		ENDIF
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "SAVESERVER", ThisForm
		ENDIF
	ENDPROC

	PROCEDURE cmdDone.Click
		***Double check SalesP.MEM
		IF NOT FILE(SYS(5)+SYS(2003) +"\SalesP.MEM") OR FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
			SalesP = UPPER(ALLTRIM(ThisForm.SalesP))
			IF EMPTY(SalesP)
				SalesP="0"
			ENDIF
			
			* Does it need the "\MEM"
			IF FILE( SYS(5)+SYS(2003)+"\ERPSetup.mem" )	
				SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\SalesP.MEM")
			ELSE
				IF FILE( SYS(5)+SYS(2003)+"\MEM\ERPSetup.mem" )	
					SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				ENDIF
			ENDIF
			
			IF SalesP!="0"
				AppSetup_Update_Ans( SalesP, ThisForm.SalesP, "SalesP" )
			ENDIF
		ENDIF
		
		
		
		
		LOCAL lcRoot
		lcRoot = ADDBS(IIF(VARTYPE(gERPAppHome)="C" AND !EMPTY(gERPAppHome), gERPAppHome, ;
			IIF(VARTYPE(LoginAppHome)="C" AND !EMPTY(LoginAppHome), LoginAppHome, SYS(5)+SYS(2003))))
		IF FILE(lcRoot + "PROGS\ERP_Environment_UI.prg")
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "APPLYSETUPERP", ThisForm
			DO (lcRoot + "PROGS\ERP_Environment_UI.prg") WITH "SAVELOGINMEM", ThisForm
		ENDIF
		
		IF ThisForm.Safetyset = "ON"
			SET SAFETY ON
		ENDIF
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdRHPA.Click
		WAIT WINDOW "Validating the Database" NOWAIT
		OPEN DATABASE (ThisForm.ServerDirMem)+"HPA" SHARED VALIDATE
		WAIT CLEAR
	ENDPROC

	PROCEDURE cmdRMAIL.Click
		WAIT WINDOW "Validating the Database" NOWAIT
		OPEN DATABASE (ThisForm.ServerDirMem)+"MAIL" SHARED VALIDATE
		WAIT CLEAR
	ENDPROC

	PROCEDURE cmdRunScripts.Click
		WAIT WINDOW "Running Scripts" NOWAIT
		
		IF FILE(SYS(5)+SYS(2003) +"\Scripts.mem")
			RESTORE FROM (SYS(5)+SYS(2003) +"\Scripts.mem") ADDITIVE
			IF TYPE("script1") = "C"
				&script1
			ENDIF
			IF TYPE("script2") = "C"
				&script2
			ENDIF
			IF TYPE("script3") = "C"
				&script3
			ENDIF
			IF TYPE("script4") = "C"
				&script4
			ENDIF
			IF TYPE("script5") = "C"
				&script5
			ENDIF
			IF TYPE("script6") = "C"
				&script6
			ENDIF
			IF TYPE("script7") = "C"
				&script7
			ENDIF
			IF TYPE("script8") = "C"
				&script8
			ENDIF
			IF TYPE("script9") = "C"
				&script9
			ENDIF
		
			DELETE FILE (SYS(5)+SYS(2003) +"\Scripts.mem")
		ENDIF
		
		WAIT CLEAR
		This.enabled = .F.
	ENDPROC

	PROCEDURE cmdSalesp.Click
		PRIVATE cSalesPinit
		cSalesPinit = UPPER(ALLTRIM(ThisForm.SalesP))
		IF EMPTY(cSalesPinit)
			cSalesPinit="0"
		ENDIF
		SalesP = cSalesPinit
		
		IF "\MEM" $ SYS(2003)
			SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\SalesP.MEM")
		ELSE
			SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
		ENDIF
			
		
		*IF cSalesPinit != "0"
		*	AppSetup_Update_Ans( cSalesPinit, ThisForm.LoginUN, "SalesP" )
		*	*AppSetup_Update_Ans( pcAns, pcUN, pcPRP, pConn )
		*ENDIF
		
		wait window 'Stored to disk' nowait
		ThisForm.SalespTXT.Value = cSalesPinit
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmdStoreName.Click
		LOCAL lcName, lcUN, lcPC, llOk
		lcName = ALLTRIM(ThisForm.cDisplayName)
		lcUN = ALLTRIM(ThisForm.LoginUN)
		lcPC = ALLTRIM(ThisForm.LoginPC)
		IF EMPTY(lcUN)
			MESSAGEBOX("Login user is empty — cannot store Name.", 48, "ERP Setup")
			RETURN
		ENDIF
		IF EMPTY(lcName)
			MESSAGEBOX("Enter a Name (e.g. David Kirchner) first.", 48, "ERP Setup")
			RETURN
		ENDIF
		llOk = AppUsers_Save_DisplayName(lcUN, lcName, lcPC)
		IF llOk
			WAIT WINDOW "Name stored for login '" + lcUN + "'" NOWAIT
			ThisForm.cDisplayName = AppUsers_Get_DisplayName(lcUN)
			ThisForm.Refresh()
		ELSE
			MESSAGEBOX("Could not save Name to dbo.AppUsers. Check SQL connection.", 16, "ERP Setup")
		ENDIF
	ENDPROC

	PROCEDURE cmdTiptonPrinter.Click
		WAIT WINDOW "Checking for a Printer in Tipton" NOWAIT
		
		PRIVATE lTipton
		lTipton = .F.
		
		PRIVATE nPrinters
		nPrinters = APRINTERS(aaPrinters)
		
		IF nPrinters > 0
			FOR CT = 1 TO nPrinters
				IF "TIPTON " $ UPPER(aaPrinters(ct,1))
					TRY
						SET PRINTER TO &aaPrinters(ct,1)
						MESSAGEBOX("Found Printer Called:"+(aaPrinters(ct,1)),0+64,"Tipton Printer")
						lTipton = .T.
						*EXIT
					CATCH
						MESSAGEBOX("Tell David Printer '"+ALLTRIM(aaPrinters(ct,1))+"' caused an Error."+CHR(13)+"Default printer will be used.",0+48,"Printer Error")		
					FINALLY
						SET PRINTER TO DEFAULT
					ENDTRY
				ENDIF
				
			NEXT CT
		
		ENDIF
		
		IF lTipton
			WAIT WINDOW "Done looking for a Tipton printer" NOWAIT
		ELSE
			WAIT WINDOW "Did not find a Tipton printer!"
		ENDIF
		
	ENDPROC

	PROCEDURE cmdUserInfo.Click
		ThisForm.Visible = .F.
		DO FORM 'Forms\UserInfo.scx'
		ThisForm.Visible = .T.
		
	ENDPROC

