		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblLoginUN' AS label WITH ;
		Caption = "LoginUN", ;
		Height = 17, ;
		Left = 4, ;
		Name = "lblLoginUN", ;
		TabIndex = 5, ;
