	PROCEDURE grdStockLst.clmLot.Text1.Click
		*Show Log
		
		PRIVATE cLOT, nLOT, cAlloy, cMachine
		cLOT = PrepareSQLtxt(StockLst_SQL.lot,'Lot',11)
		cAlloy = PrepareSQLtxt(StockLst_SQL.Alloy,'Alloy',12)
		
		cLot = UPPER( ALLTRIM( cLot ))
		
		IF LEFT(cLot,4) = "HPA "
			cLot = RIGHT(cLot,LEN(cLot)-4)
		ENDIF
		IF LEFT(cLot,3) = "HPA"
			cLot = RIGHT(cLot,LEN(cLot)-3)
		ENDIF
		
		cMachine = ""
		
		DO CASE
		CASE "HPAG" $ UPPER(cLot)
			cMachine = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		CASE "G" $ UPPER(cLot)
			cMachine = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("G",cLot)))
		CASE "HPAR" $ UPPER(cLot)
			cMachine = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		CASE "R" $ UPPER(cLot)
			cMachine = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("R",cLot)))
		CASE "HPAL" $ UPPER(cLot)
			cMachine = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		CASE "L" $ UPPER(cLot)
			cMachine = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("L",cLot)))
		ENDCASE
		
		PRIVATE lAlwaysOnTop
		lAlwaysOnTop = ThisForm.AlwaysOnTop 
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .F.
		ENDIF
		
		nLOT = PrepareSQLnum(cLot,'Lot',-3)
		
		DO CASE
		CASE cMachine = "G"
			IF VAL(cLOT) > 0
				DO FORM FORMS\ShowvGFMLog WITH nLot, cAlloy
			ENDIF
		CASE cMachine = "L"
			IF VAL(cLOT) > 0
				DO FORM FORMS\showvLakelog.scx WITH nLot, cAlloy
			ENDIF
		CASE cMachine = "R"
			IF VAL(cLOT) > 0
				DO FORM FORMS\showvROLLlog.scx WITH nLot, cAlloy
			ENDIF
		ENDCASE
		
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .T.
		ENDIF
		
	ENDPROC

