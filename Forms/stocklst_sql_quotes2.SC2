			USE IN ConditionLevel
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionLevel,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		This.Value = ""
		
	ENDPROC

	PROCEDURE cmbCL.InteractiveChange
		PRIVATE cAlloy, cForm, nThck, cCC, cCL, nCurrentRecord, nSize
		
		cAlloy	= ThisForm.cmbAlloy.Value
		cForm 	= ThisForm.cmbForm.Value
		nThck	= PrepareSQLnum(StockLst_SQL.Size,'Thck',9,3)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(This.Value,'CL',1)
		nCurrentRecord = RECNO('StockLst_SQL')
		nSize	= StockLst_SQL.Size
		
		PRIVATE cFormSort, cCCSort, cCCCL
		cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisForm.nConnHandle),2,0))
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL = CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		
		PRIVATE nBestItem 
		nBestItem = RECNO('StockLst_SQL')
		PRIVATE lUseCCCL
		lUseCCCL =  .F.
		
		SELECT StockLst_SQL
		SET FILTER TO 
		
		SEEK cAlloy+cFormSort+cCCCL+STR(nThck,9,3) IN StockLst_SQL ORDER AlFmsCCLS 
		
		IF FOUND('StockLst_SQL')
			SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC AND CL=cCL
		ELSE
			SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL 
			
			IF FOUND('StockLst_SQL')
				SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC AND CL=cCL
			ELSE
				LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC 
				
				IF FOUND('StockLst_SQL')
					SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC
				ELSE
					LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CCSort=cCCSort
					
					IF FOUND('StockLst_SQL')
						SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CCSort=cCCSort
					ELSE
						*LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) 
						*
						*IF FOUND('StockLst_SQL')
						*	SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) 
						*ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		SELECT Stocklst_SQL
		
		IF LEN( FILTER('Stocklst_SQL') ) > 0
			*A filter was Set
			
			GO TOP
			IF EOF('Stocklst_SQL')
				MESSAGEBOX("Could not find CL in this Alloy and Form.",0,"No CL")
			ENDIF
			DO WHILE NOT EOF()
				IF nThck < Size
					* IF The thickness you search is Greater than the Stocklist Size,
					* exit- use the previous records number as Best
					EXIT
				ENDIF
				nBestItem = RECNO('Stocklst_SQL')
				SKIP
			ENDDO
			SET FILTER TO 
			GOTO nBestItem
		ENDIF
		
		ThisForm.ChangeStockLst()
		*ThisForm.cmdSearch.Visible = .T.
		ThisForm.grdStockLst.Refresh
		*ThisForm.grdStockLst.SetFocus
		
	ENDPROC

	PROCEDURE cmbCL.Requery
		ThisForm.ReloadCL()
		
	ENDPROC

	PROCEDURE cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			USE IN FormCode
		ENDIF
		
		SELECT 0
		
		*this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms WITH(NOLOCK) "
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
		
			IF RECCOUNT('FormCode') = 0
				*Load again
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
			ENDIF
			
			IF RECCOUNT('FormCode') = 0
				SELECT '' AS FormNumber,'' AS FormDescription FROM FormCode INTO ARRAY aFormCode
			ELSE
				SELECT FormNumber,FormDescription FROM FormCode INTO ARRAY aFormCode
			ENDIF
				
			
			USE IN FormCode
		ENDIF
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		
		This.ColumnCount = 2
		This.NumberOfElements = nArrayCount
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
		
		This.Value = '10'
		
	ENDPROC

	PROCEDURE cmbForm.InteractiveChange
		PRIVATE cAlloy, cForm, cCC, cCL, nCurrentRecord
		
		cAlloy	= ThisForm.cmbAlloy.Value
		cForm	= This.Value
		cCC		= ThisForm.cmbCC.Value
		cCL		= ThisForm.cmbCL.Value
		
		
		nCurrentRecord = RECNO('StockLst_SQL')
		
		SELECT StockLst_SQL
		PRIVATE cFormSort
		cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisForm.nConnHandle),2,0))
		
		PRIVATE cCCSort, cCCCL, lCCCL
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL	= CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
		
		SELECT StockLst_SQL 
		
		IF NOT lCCCL
			LOCATE FOR Alloy = cAlloy AND FORM = cForm
			IF NOT FOUND('StockLst_SQL')
				LOCATE FOR Alloy = cAlloy AND STR(FormSort,2,0) = cFormSort 
			ENDIF
		ELSE
			*TRY CC CL
			SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL
			
			IF NOT FOUND('StockLst_SQL')
				SEEK cAlloy+cFormSort+cCCsort+cCCCL IN StockLst_SQL ORDER AlFmsCCs
				
				IF NOT FOUND('StockLst_SQL')
					LOCATE FOR Alloy = cAlloy AND Form = cForm 
					
					IF NOT FOUND('StockLst_SQL')
						IF NOT FOUND('StockLst_SQL')
							LOCATE FOR Alloy = cAlloy AND STR(FormSort,2,0) = cFormSort 
							
							IF NOT FOUND('StockLst_SQL')
								*LOCATE FOR STR(FormSort,2,0) = cFormSort
								LOCATE FOR Alloy = cAlloy 
								
								WAIT WINDOW 'Form Not found with Alloy '+cAlloy 
								GOTO nCurrentRecord 
							ENDIF
						ENDIF	
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		ThisForm.ChangeStockLst()
		*ThisForm.cmdSearch.Visible = .T.
		ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus()
		
	ENDPROC

	PROCEDURE cmbForm.Valid
		*!*	*RowSource=10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
		*!*	PRIVATE cAlloy, cForm, cCC, cCL
		*!*	cAlloy = StockLst_SQL.Alloy
		*!*	cForm = This.Value
		*!*	cCC	= This.Parent.cmbCC.Value
		*!*	cCL		= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		
		*!*	IF NOT ThisForm.OrderAlloyForm
		*!*		SELECT StockLst_SQL
		*!*		ThisForm.OrderAlloyForm = .T.
		*!*	ENDIF
		
		*!*	PRIVATE cFormSort
		*!*	cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisForm.nConnHandle),2,0))
		*!*	PRIVATE cCCSort, cCCCL
		*!*	cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		*!*	cCCCL = CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		
		*!*	PRIVATE lExactAlloyForm
		*!*	LOCATE FOR Alloy = cAlloy AND Form = cForm
		*!*	IF FOUND('StockLst_SQL')
		*!*		lExactAlloyForm = .T.
		*!*	ELSE
		*!*		lExactAlloyForm = .F.
		*!*	ENDIF
		
		*!*	SELECT StockLst_SQL
		*!*	SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL
		
		*!*	IF NOT FOUND('StockLst_SQL')
		*!*		SEEK cAlloy+cFormSort+cCCSort+cCCCL IN StockLst_SQL ORDER AlFmsCCs
		
		*!*		IF FOUND('StockLst_SQL')
		*!*			LOCATE FOR Alloy = cAlloy AND Form = cForm AND CCSort = cCCSort	
		*!*			IF NOT FOUND('StockLst_SQL')
		*!*				IF lExactAlloyForm 
		*!*					LOCATE FOR Alloy = cAlloy AND Form = cForm 
		*!*				ELSE
		*!*					LOCATE FOR Alloy = cAlloy
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*		ELSE
		*!*			IF lExactAlloyForm 
		*!*				*try For CC
		*!*				LOCATE FOR Alloy = cAlloy AND Form = cForm AND CC = cCC
		*!*				IF NOT FOUND('StockLst_SQL')
		*!*					*go back to Alloy Form
		*!*					LOCATE FOR Alloy = cAlloy AND Form = cForm
		*!*					
		*!*				ENDIF
		*!*			ELSE
		*!*				LOCATE FOR Alloy = cAlloy 
		*!*			ENDIF
		*!*		ENDIF
		*!*	ELSE
		*!*		IF lExactAlloyForm 
		*!*			LOCATE FOR Alloy = cAlloy AND Form = cForm
		*!*		ELSE
		*!*			LOCATE FOR Alloy = cAlloy 
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	*ThisForm.grdStockLst.SetFocus &&Cannot run from Valid
		ThisForm.grdStockLst.refresh
	ENDPROC

	PROCEDURE cmd1Inch.Click
		PRIVATE cAlloy, cForm, cCC, nLastRec
		cAlloy	= PrepareSQLtxt(ThisForm.cmbAlloy.Value,'Alloy',12,.T.)
		cForm 	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2,.T.)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL 	= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		nLastRec = 0
		
		PRIVATE cFormSort, cCCSort, cCCCL, lCCCL
		cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisForm.nConnHandle),2,0))
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL 	= CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
		
		SELECT StockLst_SQL
		*WAIT WINDOW cAlloy+cForm+cCC+cCL+STR(Size,9,3)+STR(RECNO('StockLst_SQL'))
		
		IF NOT lCCCL
			SEEK cAlloy+cFormSort+STR(1,9,3) IN StockLst_SQL ORDER AlFmsSz
		
			IF NOT FOUND("StockLst_SQL")
				SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort)
				DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
					AND StockLst_SQL.FormSort = VAL(cFormSort) ;
					AND StockLst_SQL.Size < 1
					
					nLastRec = RECNO()	
					SKIP IN StockLst_SQL
					
				ENDDO	
			ENDIF	
		ELSE
			SEEK cAlloy+cForm+cCCCL+STR(1,9,3) IN StockLst_SQL ORDER AlFmCCsS
		
			IF NOT FOUND("StockLst_SQL")
				
				SEEK cAlloy+cFormSort+cCCCL+STR(1,9,3) IN StockLst_SQL ORDER AlFmsCCLS
				
				IF FOUND("StockLst_SQL")
					SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort) and CCCL = cCCCL
					
					DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
							AND StockLst_SQL.FormSort = VAL(cFormSort) ;
							AND StockLst_SQL.CCCL = cCCCL ;
							AND StockLst_SQL.Size < 1
						nLastRec = RECNO()
						SKIP IN StockLst_SQL
					ENDDO
		
					SET FILTER TO
				ELSE
					SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL
					IF FOUND("StockLst_SQL")
						SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort) AND CCCL = cCCCL
		
						DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
								AND StockLst_SQL.FormSort = VAL(cFormSort) ;
								AND StockLst_SQL.CCCL = cCCCL ;
								AND StockLst_SQL.Size < 1
							nLastRec = RECNO()
							SKIP IN StockLst_SQL
						ENDDO
		
						SET FILTER TO
					ENDIF		
				ENDIF
			ENDIF
		ENDIF
		
		IF nLastRec > 0
			GOTO nLastRec
		ENDIF
		
		*WAIT WINDOW cAlloy+cForm+cCC+cCL+STR(Size,9,3)+STR(RECNO('StockLst_SQL'))
		
		ThisForm.ChangeStockLst()
		ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus
	ENDPROC

	PROCEDURE cmd25Inch.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nLastRec
		cAlloy	= PrepareSQLtxt(ThisForm.cmbAlloy.Value,'Alloy',12,.T.)
		cForm 	= PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2,.T.)
		cCC		= PrepareSQLtxt(ThisForm.cmbCC.Value,'CC',1)
		cCL 	= PrepareSQLtxt(ThisForm.cmbCL.Value,'CL',1)
		nLastRec = 0
		
		PRIVATE cFormSort, cCCSort, cCCCL, lCCCL
		cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisForm.nConnHandle),2,0))
		cCCSort	= CCsort(cCC,ThisForm.nConnHandle)
		cCCCL	= CC_CLsort(cCC,cCL,ThisForm.nConnHandle)
		lCCCL	= PrepareSQLlogic(ThisForm.chkCCCL.Value,'CCCL')
		
		PRIVATE lFoundCCCL
		SELECT StockLst_SQL
		
		IF NOT lCCCL
			SEEK cAlloy+cFormSort+STR(.25,9,3) IN StockLst_SQL ORDER AlFmsSz
		
			IF NOT FOUND("StockLst_SQL")
				SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort)
				DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
					AND StockLst_SQL.FormSort = VAL(cFormSort) ;
					AND StockLst_SQL.Size < .25
					
					nLastRec = RECNO()	
					SKIP IN StockLst_SQL
					
				ENDDO	
			ENDIF	
		ELSE
			SEEK cAlloy+cFormSort+cCCCL+STR(.25,9,3) IN StockLst_SQL ORDER AlFmsCCLS
		
			IF NOT FOUND("StockLst_SQL")
			
				SEEK cAlloy+cFormSort+STR(.25,9,3) IN StockLst_SQL ORDER AlFmsSz
		
				IF NOT FOUND("StockLst_SQL")
					SEEK cAlloy+cFormSort+cCCCL IN StockLst_SQL ORDER AlFmsCCL
							
					IF FOUND("StockLst_SQL")
						lFoundCCCL = .T.
					ELSE
						SEEK cAlloy+cFormSort+cCCSort IN StockLst_SQL ORDER AlFmsCs1
						lFoundCCCL = .F.
					ENDIF
					
					IF FOUND("StockLst_SQL")
						IF lFoundCCCL
							SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort) and CCCL = cCCCL
							DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
								AND StockLst_SQL.FormSort = VAL(cFormSort) ;
								AND StockLst_SQL.CCCL = cCCCL ;
								AND StockLst_SQL.Size < .25
								nLastRec = RECNO()	
								SKIP IN StockLst_SQL
							ENDDO
						
						ELSE
							SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort) and CCSort = cCCSort 
							DO WHILE StockLst_SQL.Alloy = (cAlloy) ;
								AND StockLst_SQL.FormSort = VAL(cFormSort) ;
								AND StockLst_SQL.CCSort = cCCSort  ;
								AND StockLst_SQL.Size < .25
								
								nLastRec = RECNO()	
								SKIP IN StockLst_SQL
							ENDDO
						
						ENDIF
						
						SET FILTER TO
						
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF nLastRec > 0
			GOTO nLastRec
		ENDIF
		
		ThisForm.ChangeStockLst()
		ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus
	ENDPROC

