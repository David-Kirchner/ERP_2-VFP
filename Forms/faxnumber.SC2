DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="2" />

	*<PropValue>
		DataSource = .NULL.
		Height = 0
		Left = 0
		Name = "Dataenvironment"
		Top = 0
		Width = 0
	*</PropValue>

ENDDEFINE

DEFINE CLASS frmfaxnumber AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdDone" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdFind" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkBillTo" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkShipTo" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkQuote" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkOther" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtPhone" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: billto
		*p: company
		*p: cother
		*p: holdnumber		&& Nmber to return
		*p: holdtype
		*p: quote
		*p: shipto
		*p: soldto
	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth.ico
		AutoCenter = .T.
		billto =  
		Caption = "Choose Phone Number"
		company =  
		cother =  
		DataSession = 2
		DoCreate = .T.
		Height = 163
		holdtype =  
		Name = "frmFaxNumber"
		quote =  
		shipto =  
		soldto =  
		Width = 241
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'chkBillTo' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "Bill To   :", ;
		Enabled = .F., ;
		Height = 17, ;
		Left = 12, ;
		Name = "chkBillTo", ;
		TabIndex = 1, ;
		Top = 12, ;
		Width = 204
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'chkOther' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "Other:", ;
		Enabled = .T., ;
		Height = 17, ;
		Left = 12, ;
		Name = "chkOther", ;
		TabIndex = 4, ;
		Top = 84, ;
		Width = 60
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'chkQuote' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "Quote   :", ;
		Enabled = .F., ;
		Height = 17, ;
		Left = 12, ;
		Name = "chkQuote", ;
		TabIndex = 3, ;
		Top = 60, ;
		Width = 204
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'chkShipTo' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "Ship To:", ;
		Enabled = .F., ;
		Height = 17, ;
		Left = 12, ;
		Name = "chkShipTo", ;
		TabIndex = 2, ;
		Top = 36, ;
		Width = 204
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'cmdCancel' AS commandbutton WITH ;
		Caption = "Cancel", ;
		ForeColor = 0,0,0, ;
		Height = 24, ;
		Left = 36, ;
		Name = "cmdCancel", ;
		TabIndex = 7, ;
		TerminateRead = .T., ;
		Top = 132, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdDone' AS commandbutton WITH ;
		Caption = "Done", ;
		ForeColor = 0,0,0, ;
		Height = 24, ;
		Left = 144, ;
		Name = "cmdDone", ;
		TabIndex = 8, ;
		TerminateRead = .T., ;
		Top = 132, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdFind' AS commandbutton WITH ;
		Caption = "Search", ;
		Height = 18, ;
		Left = 12, ;
		Name = "cmdFind", ;
		TabIndex = 6, ;
		Top = 104, ;
		Width = 48
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'txtPhone' AS textbox WITH ;
		Height = 23, ;
		Left = 72, ;
		Name = "txtPhone", ;
		TabIndex = 5, ;
		Top = 81, ;
		Value =  , ;
		Width = 144
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETER pBillTo, pShipto, pQuote, pCompany, pType
		
		PRIVATE lChecked
		lChecked = .F.
		
		IF TYPE("pBillTo") = "C"
			IF NOT EMPTY(ALLTRIM(pBillTo))
				ThisForm.BillTo = pBillTo
				ThisForm.chkBillTo.Caption = ThisForm.chkBillTo.Caption + pBillTo
				ThisForm.chkBillTo.Enabled = .T.
				ThisForm.chkBillTo.Value = 1
			lChecked = .T.
			ELSE
				ThisForm.BillTo = ""
			ENDIF
		ELSE
			ThisForm.BillTo = ""
		ENDIF
		
		IF TYPE("pShipto") = "C"
			IF NOT EMPTY(ALLTRIM(pShipto))
				ThisForm.Shipto = pShipto
				ThisForm.chkShipto.Caption = ThisForm.chkShipto.Caption + pShipto
				ThisForm.chkShipto.Enabled = .T.
				IF !lChecked 
					ThisForm.chkShipto.Value = 1
					lChecked = .T.
				ENDIF
			ELSE
				ThisForm.Shipto = ""
			ENDIF
		ELSE
			ThisForm.Shipto = ""
		ENDIF
		
		IF TYPE("pQuote") = "C"
			IF NOT EMPTY(ALLTRIM(pQuote))
				ThisForm.Quote = pQuote
				ThisForm.chkQuote.Caption = ThisForm.chkQuote.Caption + pQuote
				ThisForm.chkQuote.Enabled = .T.
				IF !lChecked 
					ThisForm.chkQuote.Value = 1
					lChecked = .T.
				ENDIF
			ELSE
				ThisForm.Quote = ""
			ENDIF
		ELSE
			ThisForm.Quote = ""
		ENDIF
		
		IF TYPE("pCompany") = "C"
			ThisForm.Company = pCompany
		ELSE
			ThisForm.Company = ""
		ENDIF
		
		
		
		IF TYPE("pType") = "C"
			ThisForm.HoldType = pType
		ELSE
			ThisForm.HoldType = ""
		ENDIF
	ENDPROC

	PROCEDURE Unload
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE chkBillTo.Click
		IF This.Value = 1
			ThisForm.chkShipTo.Value = 0
			ThisForm.chkQuote.Value = 0
			ThisForm.chkOther.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE chkQuote.Click
		IF This.Value = 1
			ThisForm.chkBillTo.Value = 0
			ThisForm.chkShipTo.Value = 0
			ThisForm.chkOther.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE chkShipTo.Click
		IF This.Value = 1
			ThisForm.chkBillTo.Value = 0
			ThisForm.chkQuote.Value = 0
			ThisForm.chkOther.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdDone.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		DO CASE
		CASE ThisForm.chkBillTo.Value = 1
			cHoldNumber = ThisForm.BillTo
		CASE ThisForm.chkShipTo.Value = 1
			cHoldNumber = ThisForm.ShipTo
		CASE ThisForm.chkQuote.Value = 1
			cHoldNumber = ThisForm.Quote
		CASE ThisForm.chkOther.Value = 1
			cHoldNumber = ThisForm.cOther
		OTHERWISE
			*
		ENDCASE
		
		*IF TYPE(cHoldNumber) = "N"
		*	cHoldNumber = STR(cHoldNumber,10,0)
		*ENDIF
		ThisForm.HoldNumber = cHoldNumber 
		IF EMPTY(ThisForm.HoldNumber)
			WAIT WINDOW "No number / Address !!!" TIMEOUT 3
		ENDIF
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdFind.Click
		DO FORM Forms\GetNumber WITH ThisForm.Company, ThisForm.HoldType TO Q_faxnm
		IF TYPE("Q_faxnm") = "C"
			ThisForm.txtPhone.Value = Q_faxnm
			
			ThisForm.chkBillTo.Value = 0
			ThisForm.chkShipTo.Value = 0
			ThisForm.chkQuote.Value = 0
			ThisForm.chkOther.Value = 1
		
			ThisForm.cOther = Q_faxnm
		ELSE
			ThisForm.chkOther.Value = 0
			ThisForm.txtPhone.Value = ""
		ENDIF
	ENDPROC

	PROCEDURE txtPhone.InteractiveChange
		ThisForm.cOther = This.Value
	ENDPROC

	PROCEDURE txtPhone.Valid
		IF !EMPTY(This.Value)
			ThisForm.chkBillTo.Value = 0
			ThisForm.chkShipTo.Value = 0
			ThisForm.chkQuote.Value = 0
			ThisForm.chkOther.Value = 1
		ENDIF
	ENDPROC

ENDDEFINE
