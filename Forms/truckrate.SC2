	PROCEDURE Pageframe1.Page3.cmdCCX.Click
		*!*	<RateRequest>
		*!*	<OriginZip country='us'>97006</OriginZip> 
		*!*	<DestinationZip country='us'>33179</DestinationZip> 
		*!*	<CustNmbr shipcode="S">883885</CustNmbr>
		*!*	<ChargeCode>P</ChargeCode> 
		*!*	<DiscountRate>100</DiscountRate> 
		*!*	<EffectiveDate>10/12/04</EffectiveDate> 
		
		*!*	<Item> 
		*!*	<CmdtyClass>775</CmdtyClass> 
		*!*	<Weight unit='lbs'>667</Weight> 
		*!*	</Item> 
		
		*!*	<Item> 
		*!*	<CmdtyClass>100</CmdtyClass> 
		*!*	<Weight unit='lbs'>555</Weight> 
		*!*	</Item> 
		
		*!*	<Accessorial>SSC</Accessorial> 
		*!*	<Accessorial>ZHM</Accessorial> 
		*!*	<Accessorial>DNC</Accessorial>	 
		*!*	<Accessorial>GUR</Accessorial> 
		
		*!*	</RateRequest>
		
		***************************************************************************************
		
		*!*	-------------------------------------------------------------------------------------
		*!*	<%@ Language=VBScript %>
		*!*	<%
		*!*	' Declare Variables
		*!*	Option Explicit
		*!*	Dim rateRequest 'a string to hold XML RateRequest document
		*!*	Dim httpConn    'an object for the HTTP connection to www.con-way.com
		*!*	Dim rateQuote   'an XML DOM object to hold the RateQuote document
		*!*	Dim userId      'for authentication to Con-Way secure site
		*!*	Dim passWd      'for authentication to Con-Way secure site
		*!*	Dim netCharge   'sample variable to demonstrate how to pull values out of XML elements
		*!*	Dim today       'String to hold today's date
		
		*!*	' replace the "userId" & "passWd" String values with your Con-Way username and password
		*!*	userId = "userId"
		*!*	passWd = "passWd"
		*!*	today = Date()
		
		*!*	'*Build Rate Request
		*!*	'   In actual use, you would probably populate the Rating Request 
		*!*	'   parameters (Weights, Classes, Zip Codes, etc.) from data submitted
		*!*	'   via an on-line order form or database.
		*!*	'   For this sample we will just hard code some dummy data.
		
		*!*	rateRequest="<RateRequest>" &_
		*!*	               "<OriginZip country=""us"">97006</OriginZip>" &_
		*!*	               "<DestinationZip country=""us"">33179</DestinationZip>" &_
		*!*	               "<ChargeCode>P</ChargeCode>" &_
		*!*	               "<DiscountRate>100</DiscountRate>" &_
		*!*	               "<EffectiveDate>" & today & "</EffectiveDate>" &_
		*!*	               "<Item>" &_
		*!*	                 "<CmdtyClass>775</CmdtyClass>" &_
		*!*	                 "<Weight unit=""lbs"">667</Weight>" &_
		*!*	               "</Item>" &_
		*!*	               "<Item>" &_
		*!*	                 "<CmdtyClass>100</CmdtyClass>" &_
		*!*	                 "<Weight unit=""lbs"">555</Weight>" &_
		*!*	               "</Item>" &_
		*!*	               "<Accessorial>SSC</Accessorial>" &_
		*!*	               "<Accessorial>ZHM</Accessorial>" &_
		*!*	               "<Accessorial>DNC</Accessorial>" &_
		*!*	               "<Accessorial>GUR</Accessorial>" &_
		*!*	             "</RateRequest>"
		
		*!*	' Convert characters to proper format for post
		*!*	rateRequest = Server.URLEncode(rateRequest)
		
		*!*	'*Call Con-Way XML Rating Interface.
		*!*	'   The xhttp classes used here are availible from Microsoft and
		*!*	'   are autmatically installed and registered with Internet Explorer 5.5
		*!*	'   for more info on how to use these classes please see
		*!*	'     http://msdn.microsoft.com/xml/index.asp
		
		*!*	set httpConn = Server.CreateObject("MSXML2.ServerXMLHTTP")
		*!*	' or alternately:
		*!*	'set httpConn = Server.CreateObject("Microsoft.XMLHTTP")
		
		
		*!*	' open synchronous connection to X-Rate
		*!*	httpConn.open "POST","http://www.con-way.com/XMLj/X-Rate",false,userId,passWd
		
		*!*	'set post data type, and post data
		*!*	httpConn.setRequestHeader "Content-type","application/x-www-form-urlencoded" 
		*!*	httpConn.Send "RateRequest=" & rateRequest
		
		*!*	'*Parse the response
		*!*	'   This example uses the MS XML DOM classes that ship with IE 5.5 or the XML SDK
		*!*	'   to create an XML document.  Here we simple redisplay the XML data, but in a real
		*!*	'   world scenario you will parse the document to locate the data you wish to display 
		*!*	'   or save, such as the net charge, transit time, and disclaimer.
		
		*!*	'*For more info on how to use the MS XML SDK please see
		*!*	'   http://msdn.microsoft.com/xml/index.asp
		*!*	'   If you need only the final net charge of the quote you might find it easier
		*!*	'   in some cases to use a simpler method such as 'InStr'.
		
		*!*	set rateQuote = Server.CreateObject("MSXML2.DOMDocument")  'create XML DOM object
		*!*	' or alternately:
		*!*	'set rateQuote = Server.CreateObject("Microsoft.XMLDOM")
		*!*	'set rateQuote = Server.CreateObject("MSXML2.DOMDocument.3.0")  'create XML DOM object
		
		*!*	set rateQuote = httpConn.responseXML
		
		*!*	'Here is how to a value out of a specific XML element using MS XML:
		*!*	netCharge = rateQuote.getElementsByTagName("NetCharge").item(0).text
		
		*!*	%>
		
		*!*	<HTML>
		*!*	<HEAD>
		*!*	<TITLE>Sample ASP for Con-Way XML Rating</TITLE>
		*!*	</HEAD>
		*!*	<BODY>
		*!*	<CENTER>
		*!*	<B><FONT face="arial" size="+1"><I>Sample ASP Con-Way Rate Getter</I></FONT></B>
		*!*	</CENTER>
		*!*	<BR>
		*!*	<b>Here is the RateQuote XML output:</b>
		*!*	<BR>
		*!*	<code><%=rateQuote.xml%></code>
		*!*	<BR>
		*!*	<!--- Print the tag value we extracted --->
		*!*	<b>Here is the data extracted from an XML tag:  Shipping Charges: <%=netCharge%></b>
		*!*	</BODY>
		*!*	</HTML>
		*!*	-------------------------------------------------------------------------------------
		
		**************************************************************************************
		return
		
		
		
		PRIVATE cText
		PRIVATE coCity, coState, coZIP, coCountry
		coCity	= LEFT(ThisForm.Pageframe1.Page1.txtOrigCity.Value, 26) 
		coState	= UPPER(LEFT(ThisForm.Pageframe1.Page1.txtOrigState.Value,2))
		coZIP	= LEFT(ThisForm.Pageframe1.Page1.txtOrigZIP.Value,5)
		IF TYPE("coZIP") = "N"
			coZIP= STR( coZIP,5,0 )
		ENDIF
		coCountry = UPPER(LEFT(ThisForm.Pageframe1.Page1.txtOrigCountry.Value,3))
		IF EMPTY(ALLTRIM(coCountry))
			coCountry= "USA"
		ENDIF
		IF coCountry = "US"
			coCountry = "USA"
		ENDIF
		
		cText = "http://my.roadway.com/public/cgi-bin/pub_redir?redir=/tfq504&O_CITY="
		cText = cText + coCity
		cText = cText + " &O_STATE="
		cText = cText + coState
		cText = cText + " &O_ZIP="
		cText = cText + coZIP
		cText = cText + " &O_CTRY="
		cText = cText + coCountry
		
		PRIVATE cdCity, cdState, cdZIP, cdCountry
		cdCity	= LEFT(ThisForm.Pageframe1.Page1.txtDestCity.Value, 26) 
		cdState	= UPPER(LEFT(ThisForm.Pageframe1.Page1.txtDestState.Value,2))
		cdZIP	= LEFT(ThisForm.Pageframe1.Page1.txtDestZIP.Value,5)
		IF TYPE("cdZIP") = "N"
			cdZIP= STR( cdZIP,5,0 )
		ENDIF
		cdCountry = UPPER(LEFT(ThisForm.Pageframe1.Page1.txtDestCountry.Value,3))
		
		cText = cText + " &D_CITY= "
		cText = cText + cdCity
		cText = cText + " &D_STATE="
		cText = cText + cdState
		cText = cText + "&D_ZIP="
		cText = cText + cdZIP
		cText = cText + "&D_CTRY="
		cText = cText + cdCountry
		
		PRIVATE vWeight, cWeight
		vWeight	= ThisForm.Pageframe1.Page1.txtWeight.Value
		*,6) &&nnnnnn
		IF TYPE("vWeight") = "N"
			cWeight = STR( vWeight,6,0 )
			nWeight = vWeight
		ELSE
			IF TYPE("vWeight") = "C"
				cWeight = ALLTRIM(vWeight)
				nWeight = VAL(vWeight)
			ELSE
				cWeight = '0'
				nWeight = 0
			ENDIF
		ENDIF
		
		IF VAL(cWEIGHT) < 1
			IF nWeight < 1
				MESSAGEBOX( "No Weight!", 0,"Error" )
				ThisForm.Pageframe1.Page1.txtWeight.Value = 0
				This.Parent.Parent.ActivePage = 1
				RETURN
			ELSE
				cWeight = STR( nWeight,6,0 )
			ENDIF
		ENDIF
		cWeight = ALLTRIM(cWeight)
		cWeight = SPACE(6-LEN(cWeight))+cWeight
		
		PRIVATE cClass	
		cClass	= ThisForm.Pageframe1.Page1.txtClass.Value
		IF TYPE("cClass") = "N"
			cClass = STR( cClass,4,0)
		ENDIF
		IF VAL(cClass) < 1
			MESSAGEBOX( "No Class!" )
		ENDIF
		cClass = ALLTRIM(cClass)
		cClass = SPACE(6-LEN(cClass))+cClass
		
		cText = cText + "&WGT1=" + cWeight
		cText = cText + "&CLASS1=" + cClass
		cText = cText + "&OPT_SS=on"
		cText = cText + "&OPT_NTFY=off"
		cText = cText + "&OPT_HAZM=off"
		cText = cText + "&OPT_ID=off"
		cText = cText + "&OPT_IP=off"
		cText = cText + "&OPT_HOMD=off"
		cText = cText + "&OPT_HOMP=off"
		cText = cText + "&OPT_LFTO=off"
		cText = cText + "&OPT_LFTD=off"
		cText = cText + "&PU_DATE="
		cCentury = SET("CENTURY")
		SET CENTURY OFF
		cText = cText + DTOC( CTOD(ThisForm.Pageframe1.Page1.txtPUDate.Value) )
		IF cCentury = "ON"
			SET CENTURY ON
		ENDIF
		cText = cText + "&DISCOUNT=55.0"
		cText = cText + "&CURRENCY=USD" &&nnn  (USD or CAD)
		cText = cText + "&COMPUTE=QUOTE" 
		cText = cText + "&DISPLAY=PAGE"
		 
		PRIVATE loHyperlink 
		*loHyperlink = CREATEOBJECT("Hyperlink")
		*loHyperlink.navigateto(cText)
		RELEASE loHyperlink 
	ENDPROC

