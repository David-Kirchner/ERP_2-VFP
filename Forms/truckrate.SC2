	PROCEDURE Pageframe1.pgRoadWay.cmdRoadway.Click
		PRIVATE cText
		PRIVATE coCity, coState, coZIP, coCountry
		coCity	= LEFT(ThisForm.Pageframe1.Page1.txtOrigCity.Value, 26) 
		coState	= UPPER(LEFT(ThisForm.Pageframe1.Page1.txtOrigState.Value,2))
		coZIP	= LEFT(ThisForm.Pageframe1.Page1.txtOrigZIP.Value,5)
		IF TYPE("coZIP") = "N"
			coZIP= STR( coZIP,5,0 )
		ENDIF
		coCountry = UPPER(LEFT(ThisForm.Pageframe1.Page1.txtOrigCountry.Value,3))
		IF EMPTY(ALLTRIM(coCountry))
			coCountry= "USA"
		ENDIF
		IF coCountry = "US"
			coCountry = "USA"
		ENDIF
		
		cText = "http://my.roadway.com/public/cgi-bin/pub_redir?redir=/tfq504&O_CITY="
		cText = cText + coCity
		cText = cText + " &O_STATE="
		cText = cText + coState
		cText = cText + " &O_ZIP="
		cText = cText + coZIP
		cText = cText + " &O_CTRY="
		cText = cText + coCountry
		
		PRIVATE cdCity, cdState, cdZIP, cdCountry
		cdCity	= LEFT(ThisForm.Pageframe1.Page1.txtDestCity.Value, 26) 
		cdState	= UPPER(LEFT(ThisForm.Pageframe1.Page1.txtDestState.Value,2))
		cdZIP	= LEFT(ThisForm.Pageframe1.Page1.txtDestZIP.Value,5)
		IF TYPE("cdZIP") = "N"
			cdZIP= STR( cdZIP,5,0 )
		ENDIF
		cdCountry = UPPER(LEFT(ThisForm.Pageframe1.Page1.txtDestCountry.Value,3))
		
		cText = cText + " &D_CITY= "
		cText = cText + cdCity
		cText = cText + " &D_STATE="
		cText = cText + cdState
		cText = cText + "&D_ZIP="
		cText = cText + cdZIP
		cText = cText + "&D_CTRY="
		cText = cText + cdCountry
		
		PRIVATE vWeight, cWeight
		vWeight	= ThisForm.Pageframe1.Page1.txtWeight.Value
		*,6) &&nnnnnn
		IF TYPE("vWeight") = "N"
			cWeight = STR( vWeight,6,0 )
			nWeight = vWeight
		ELSE
			IF TYPE("vWeight") = "C"
				cWeight = ALLTRIM(vWeight)
				nWeight = VAL(vWeight)
			ELSE
				cWeight = '0'
				nWeight = 0
			ENDIF
		ENDIF
		
		IF VAL(cWEIGHT) < 1
			IF nWeight < 1
				MESSAGEBOX( "No Weight!", 0,"Error" )
				ThisForm.Pageframe1.Page1.txtWeight.Value = 0
				This.Parent.Parent.ActivePage = 1
				RETURN
			ELSE
				cWeight = STR( nWeight,6,0 )
			ENDIF
		ENDIF
		cWeight = ALLTRIM(cWeight)
		cWeight = SPACE(6-LEN(cWeight))+cWeight
		
		
		PRIVATE cClass
		cClass	= ThisForm.Pageframe1.Page1.txtClass.Value
		IF TYPE("cClass") = "N"
			cClass = STR( cClass,4,0)
		ENDIF
		IF VAL(cClass) < 1
			MESSAGEBOX( "No Class!" )
		ENDIF
		cClass = ALLTRIM(cClass)
		cClass = SPACE(6-LEN(cClass))+cClass
		
		cText = cText + "&WGT1=" + cWeight
		cText = cText + "&CLASS1=" + cClass
		cText = cText + "&OPT_SS=on"
		cText = cText + "&OPT_NTFY=off"
		cText = cText + "&OPT_HAZM=off"
		cText = cText + "&OPT_ID=off"
		cText = cText + "&OPT_IP=off"
		cText = cText + "&OPT_HOMD=off"
		cText = cText + "&OPT_HOMP=off"
		cText = cText + "&OPT_LFTO=off"
		cText = cText + "&OPT_LFTD=off"
		*cText = cText + "&OPT_COD=off"
		*cText = cText + "&COD=0.00"
		cText = cText + "&PU_DATE="
		cCentury = SET("CENTURY")
		SET CENTURY OFF
		cText = cText + DTOC( CTOD(ThisForm.Pageframe1.Page1.txtPUDate.Value) )
		IF cCentury = "ON"
			SET CENTURY ON
		ENDIF
		cText = cText + "&DISCOUNT=55.0"
		cText = cText + "&CURRENCY=USD" &&nnn  (USD or CAD)
		cText = cText + "&COMPUTE=QUOTE" 
		cText = cText + "&DISPLAY=PAGE"
		 
		*!*	OPT_SS   =	Single Shipment
		*!*	OPT_NTFY =	Notify Before Delivery
		*!*	OPT_HAZM =	Hazardous Materials
		*!*	OPT_ID   =	Inside Delivery  
		*!*	OPT_IP   =	Inside Pickup   
		*!*	OPT_HOMD =	Non-commercial Delivery  
		*!*	OPT_HOMP =	Non-commercial Pickup  
		*!*	OPT_LFTO =	Liftgate at Origin 
		*!*	OPT_LFTD =	Liftgate at Destination
		*!*	OPT_COD  =	COD Fee AND COD amount MUST BE USED TOGETHER
		
		PRIVATE loHyperlink 
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(cText)
		RELEASE loHyperlink 
	ENDPROC

	PROCEDURE Pageframe1.pgRoadWay.Command1.Click
		*oInet=CREATEOBJECT("InternetExplorer.Application")
		*oInet.Navigate("www.google.com")
		*do while oInet.busy
		*    wait "busy" window nowait timeout 1
		*enddo
		*? oinet.document.body.InnerHtml
		*release oInet
		
		
		*Create Cursor xtemp (mtemp m)
		*Append Blank
		*Replace mtemp With ReadURL( "http://www.microsoft.com" )
		*Procedure ReadURL
		*Lparameters pcUrlName
		*Set Step On
		
		pcUrlName = "http://www.microsoft.com" 
		Declare Integer InternetOpen In wininet.Dll String sAgent, ;
		    INTEGER lAccessType, String sProxyName, ;
		    STRING sProxyBypass, Integer lFlags
		
		Declare Integer InternetOpenUrl In wininet.Dll ;
		    INTEGER hInternetSession, String sUrl, String sHeaders, ;
		    INTEGER lHeadersLength, Integer lFlags, Integer lContext
		
		Declare Integer InternetReadFile In wininet.Dll Integer hfile, ;
		    STRING @sBuffer, Integer lNumberofBytesToRead, Integer @lBytesRead
		Declare short InternetCloseHandle In wininet.Dll Integer hInst
		#Define INTERNET_OPEN_TYPE_PRECONFIG 0
		#Define INTERNET_OPEN_TYPE_DIRECT 1
		#Define INTERNET_OPEN_TYPE_PROXY 3
		#Define SYNCHRONOUS 0
		#Define INTERNET_FLAG_RELOAD 2147483648
		#Define CR Chr(13)
		Local lsAgent, lhInternetSession, lhUrlFile, llOk, lnOk, lcRetVal, lcReadBuffer, lnBytesRead
		lsAgent = "VPF 7.0"
		lhInternetSession = InternetOpen( lsAgent, INTERNET_OPEN_TYPE_PRECONFIG, ;
		    '', '', SYNCHRONOUS)
		If lhInternetSession = 0
		    Wait Window "Internet session cannot be established" Time 2
		    Return .Null.
		Endif
		lhUrlFile = InternetOpenUrl( lhInternetSession, pcUrlName, '', 0, ;
		    INTERNET_FLAG_RELOAD, 0)
		If lhUrlFile = 0
		    Wait Window "URL cannot be opened"
		    Return .Null.
		Endif
		lcRetVal = ""
		llOk = .T.
		Do While llOk
		    lsReadBuffer = Space(32767)
		    lnBytesRead = 0
		    lnOk = InternetReadFile( lhUrlFile, @lsReadBuffer, Len(lsReadBuffer), @lnBytesRead)
		    If ( lnBytesRead > 0 )
		        lcRetVal = lcRetVal + Left( lsReadBuffer, lnBytesRead )
		    Endif
		    llOk = ( lnOk = 1 ) And ( lnBytesRead > 0 )
		Enddo
		InternetCloseHandle( lhUrlFile )
		InternetCloseHandle( lhInternetSession )
		Return lcRetVal
		
		
	ENDPROC

ENDDEFINE
