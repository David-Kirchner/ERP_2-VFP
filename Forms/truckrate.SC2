	PROCEDURE Init
		ThisForm.Pageframe1.Page1.txtOrigCity.Value = "Tipton"
		ThisForm.Pageframe1.Page1.txtOrigState.Value = "IN"
		ThisForm.Pageframe1.Page1.txtOrigZIP.Value = "46072"
		ThisForm.Pageframe1.Page1.txtOrigCountry.Value = "USA"
		
		ThisForm.Pageframe1.Page1.txtWeight.Value = 0
		ThisForm.Pageframe1.Page1.txtWeight.BackColor = RGB(255,255,128)
		
		ThisForm.Pageframe1.Page1.txtClass.Value = 70
		ThisForm.Pageframe1.Page1.txtPUDate.Value = DTOC( DATE() )
		
		ThisForm.Pageframe1.Page1.txtDestCity.SetFocus()
		
		IF USED("ShipAddr")
			ThisForm.Pageframe1.Page1.txtDestCity.Value = ShipAddr.City
			ThisForm.Pageframe1.Page1.txtDestState.Value = ShipAddr.St
			ThisForm.Pageframe1.Page1.txtDestZIP.Value = ShipAddr.Zip
			ThisForm.Pageframe1.Page1.txtDestCountry.Value = IIF(EMPTY(ShipAddr.Country),"USA",ShipAddr.Country)
			
			ThisForm.Pageframe1.Page1.txtWeight.SetFocus()
		ELSE
			ThisForm.Pageframe1.Page1.txtDestCity.BackColor = RGB(255,255,128)
			ThisForm.Pageframe1.Page1.txtDestState.BackColor = RGB(255,255,128)
			ThisForm.Pageframe1.Page1.txtDestZIP.BackColor = RGB(255,255,128)
			ThisForm.Pageframe1.Page1.txtDestCountry.BackColor = RGB(255,255,128)
		ENDIF
		
		
	ENDPROC

