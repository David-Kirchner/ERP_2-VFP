	PROCEDURE Pageframe1.Page5.cmdFedExFrt.Click
		PRIVATE cText
		PRIVATE coCity, coState, coZIP, coCountry
		coCity	= LEFT(ThisForm.Pageframe1.Page1.txtOrigCity.Value, 26) 
		coState	= UPPER(LEFT(ThisForm.Pageframe1.Page1.txtOrigState.Value,2))
		coZIP	= LEFT(ThisForm.Pageframe1.Page1.txtOrigZIP.Value,5)
		IF TYPE("coZIP") = "N"
			coZIP= STR( coZIP,5,0 )
		ENDIF
		coCountry = UPPER(LEFT(ThisForm.Pageframe1.Page1.txtOrigCountry.Value,3))
		IF coCountry = "USA"
			coCountry = "US"
		ENDIF
		
		PRIVATE cdCity, cdState, cdZIP, cdCountry
		cdCity	= LEFT(ThisForm.Pageframe1.Page1.txtDestCity.Value, 26) 
		cdState	= UPPER(LEFT(ThisForm.Pageframe1.Page1.txtDestState.Value,2))
		cdZIP	= LEFT(ThisForm.Pageframe1.Page1.txtDestZIP.Value,5)
		IF TYPE("cdZIP") = "N"
			cdZIP= STR( cdZIP,5,0 )
		ENDIF
		cdCountry = UPPER(LEFT(ThisForm.Pageframe1.Page1.txtDestCountry.Value,3))
		IF EMPTY(ALLTRIM(cdCountry))
			cdCountry = "US"
		ENDIF
		IF cdCountry = "USA"
			cdCountry = "US"
		ENDIF
		
		
		PRIVATE vWeight, cWeight
		vWeight	= ThisForm.Pageframe1.Page1.txtWeight.Value
		*,6) &&nnnnnn
		IF TYPE("vWeight") = "N"
			cWeight = STR( vWeight,6,0 )
			nWeight = vWeight
		ELSE
			IF TYPE("vWeight") = "C"
				cWeight = ALLTRIM(vWeight)
				nWeight = VAL(vWeight)
			ELSE
				cWeight = '0'
				nWeight = 0
			ENDIF
		ENDIF
		IF VAL(cWEIGHT) < 1
			IF nWeight < 1
				MESSAGEBOX( "No Weight!", 0,"Error" )
				ThisForm.Pageframe1.Page1.txtWeight.Value = 0
				This.Parent.Parent.ActivePage = 1
				RETURN
			ELSE
				cWeight = STR( nWeight,6,0 )
			ENDIF
		ENDIF
		cWeight = ALLTRIM(cWeight)
		cWeight = SPACE(6-LEN(cWeight))+cWeight
		
		*****cWeight = PADR(ALLTRIM(cWeight),6," ") &&nnnnnn 
		
		PRIVATE cClass
		cClass	= ThisForm.Pageframe1.Page1.txtClass.Value
		IF TYPE("cClass") = "N"
			cClass = STR( cClass,2,0)
		ELSE
			cClass = ALLTRIM( cClass )
		ENDIF
		IF VAL(cClass) < 1
			MESSAGEBOX( "No Class!" )
		ENDIF
		
		cText = "http://fxf.fedex.com/XMLRating.jsp?"
		cText = cText + "as_shzip=" + coZIP
		cText = cText + "&as_shipterms=" + "prepaid"
		cText = cText + "&as_shcntry=" + coCountry
		cText = cText + "&as_cnzip=" + cdZIP
		cText = cText + "&as_cncntry=" + cdCountry
		cText = cText + "&as_class1=0" + cClass
		cText = cText + "&as_weight1=" + cWeight
		cText = cText + "&as_actnbr=12954723"
		
		PRIVATE loHyperlink 
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(cText)
		RELEASE loHyperlink 
		
		*!*	XML Rating Syntax for FEDEXFREIGHT.FEDEX.COM
		*!*	FedEx Freight rate quotes are available as XML strings by following this set of guidelines, which
		*!*	describes the syntax used to request a quote.
		*!*	URL:
		*!*	http://www.fedexfreight.fedex.com/XMLRating.jsp
		*!*	Parameters:
		*!*	*as_shipterms Terms of the shipment [prepaid or collect]
		*!*	*as_shzip Origin (shipper) 5 digit (US) 6 character (CA) zip code
		*!*	*as_shcntry Origin (shipper) country code [US or CA]
		*!*	*as_cnzip Destination (consignee) 5 digit (US) 6 character (CA) zip code
		*!*	*as_cncntry Destination (consignee) country code [US or CA]
		*!*	*as_class1 First item's freight class.
		*!*	*as_weight1 First item's weight.
		*!*	as_pcs1 First item's piece count
		*!*	as_descr1 First item's commodity description line
		*!*	as_nmfc1 First item's National Motor Freight Classification number
		*!*	as_haz1 First item's hazardous indicator [Y or N]
		*!*	Note: Up to 6 freight items are allowed (as_class2, as_class3, etc.). Class and weight are
		*!*	required for each item.
		*!*	as_iamthe Indicates if the role of the requestor [shipper or consignee]
		*!*	as_actnbr Account number of the requestor
		*!*	as_decvalue Declared value of the shipment
		*!*	as_units Number of handling units
		*!*	as_codamount COD dollar amount to be collected
		*!*	as_codfee COD terms (prepaid or collect) [CFP or CFC]
		*!*	as_insidedelivery Indicates if this is an inside delivery and the terms (prepaid or collect)
		*!*	[IDP or IDC]
		*!*	as_insidepickup Indicates if this is an inside pickup and the terms (prepaid or collect) [IPP
		*!*	or IPC]
		*!*	as_residentialpickup Indicates if this a residential pickup [Y or N]
		*!*	as_residentialdelivery Indicates if this a residential delivery [Y or N]
		*!*	as_freezable Indicates if freezable protection is required [Y or N]
		*!*	as_callbefore Indicates if notification prior to delivery is required [Y or N]
		*!*	as_liftgate Indicates if a lift gate is required for pickup or delivery [Y or N]
		*!*	as_singleshipment Indicates if this a single shipment [Y or N]
		*!*	as_limitedaccesspickup Shipment requires limited access pickup [Y or N]
		*!*	as_limitedaccessdelivery Shipment requires limited access delivery [Y or N]
		*!*	*Required Parameters:
		
	ENDPROC

