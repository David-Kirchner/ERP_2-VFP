	PROCEDURE cmbClass.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpStockClass')
			SELECT tmpStockClass
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [Value],[Definition] FROM dbo.StockLst_Definition WHERE [Table] = 'StockLst_Detail' AND [Column]='Class' "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockClass')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpStockClass')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockClass')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT tmpStockFloorStatus
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockClass')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockClass")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockClass")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpStockClass')
		ENDIF
		
		DIMENSION a_Class(1,2)
		
		IF USED('tmpStockClass')
			SELECT LEFT(Value,1), IIF(Definition="Empty",SPACE(50),Definition) FROM tmpStockClass INTO ARRAY a_Class
			
			USE IN tmpStockClass
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(a_Class)+2
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(a_Class,1)
		*Add a Blank
		this.addListitem(" ",1,1)
		this.addListitem(" ",1,2)
		
		FOR I = 1 TO nArrayCount
			this.addListitem(a_Class(I, 1),I+1,1)
			this.addListitem(a_Class(I, 2),I+1,2)
		ENDFOR
	ENDPROC

