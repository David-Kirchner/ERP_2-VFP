			USE IN FormCode
		ENDIF
		
		this.clear
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
			
		PRIVATE nArrayCount
