	PROCEDURE SIZE_H1.GotFocus
		this.InputMask = "99,999.9999"
	ENDPROC

	PROCEDURE SIZE_H1.LostFocus
		this.InputMask = "999,999.9999"
	ENDPROC

	PROCEDURE SIZE_H1.Valid
		IF This.Value > 0
			IF ThisForm.DIM11.Value > 0
				IF ThisForm.DIM11.Value > This.Value
					WAIT WINDOW "The High Tolerance is usually higher than the Dim 1" NOWAIT
					*,0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The High Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE SIZE_L1.GotFocus
		this.InputMask = "99,999.9999"
	ENDPROC

	PROCEDURE SIZE_L1.LostFocus
		this.InputMask = "999,999.9999"
	ENDPROC

	PROCEDURE SIZE_L1.Valid
		IF This.Value > 0
			IF ThisForm.DIM11.Value > 0
				IF ThisForm.DIM11.Value < This.Value
					WAIT WINDOW "The Low Tolerance is usually below the Dim 1" NOWAIT
					*,0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The Low Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

