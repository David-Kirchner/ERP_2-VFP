				ThisForm.cmbClass.Value		= PrepareSQLtxt(tmpStockLst_Detail.CLASS,'Class',1)
				ThisForm.Location1.Value	= PrepareSQLtxt(tmpStockLst_Detail.Location,'Location',10)
				ThisForm.cmbLocation1.Value	= PrepareSQLtxt(tmpStockLst_Detail.Location,'Location',10)
			
				ThisForm.txtReceivingID.Value	= PrepareSQLnum(tmpStockLst_Detail.ReceivingID,'ReceivingID',-3)
				ThisForm.txtInvCheck1.Value		= PrepareSQLdate(tmpStockLst_Detail.InvCheck,'InvCheck')
				*ThisForm.chkMarkInvCheck.Value	= 0
				*ThisForm.chkMarkInvMiss.Value	= 0
				ThisForm.chkQuarantine.Value		= PrepareSQLchk(tmpStockLst_Detail.Quarantine,'Quarantine')
