	PROCEDURE convertto
		LPARAMETERS tnFileType
		
		#DEFINE cnWORD 					         		1
		#DEFINE cnHTML               			 		2
		#DEFINE cnRTF               			 		3
		#DEFINE cnEXCEL               			 		4
		#DEFINE cnXML	               			 	    5
		#DEFINE cnPREVIEW               			 	6		&& FRX2ANY Print Preview
		#DEFINE cnPDF	               			 	    7
		#DEFINE cnIMAGE									8
		
		#DEFINE cnOK 	     				     		0       && Everything is OK.
		#DEFINE cnNO_PARAMETERS    				 		1       && No parameter
		#DEFINE cnREP_FILE_NOT_FOUND			 		2       && Report file not found
		#DEFINE cnNO_BANDS_DEFINED 				 		3       && No bands defined in FRX file (corrupted?)
		#DEFINE cnNO_OPEN_TABLE    				 		4       && No open table and no dataenviroment cursors in FRX file
		#DEFINE cnEOF           				 		5       && Main alias at EOF() and no dataenvironment cursors
		#DEFINE cnCANNOT_INSTANCE_WORD_APP				6
		#DEFINE cnNO_HEADER_RECORD 				 		7       && No header record in FRX file (corrupted?)
		#DEFINE cnNO_ANY_OBJECTS   				 		8       && No labels, fields, or images.
		#DEFINE cnERR_CREATING_FILE				 		9  	 	&& Error creating fle
		#DEFINE cnUSER_INTERRUPTED				 		10  	&& User interrupted
		#DEFINE cnINVALID_BANDTYPE_PARAMETER	 		11
		#DEFINE cnINVALID_ARRAY_REPORT_OBJ_PARAMETER	12
		#DEFINE cnINVALID_NUMBER_OF_PARAMETER			13
		#DEFINE cnINVALID_TYPE_OF_PARAMETER	 			14
		#DEFINE cnINVALID_SPECIFIED_OBJECT_TYPE			15
		#DEFINE cnWRONG_EXPORT_FILE_TYPE				16
		#DEFINE cnDE_INIT_RETURN_FALSE					17		&& DE Init metod return false
		#DEFINE cnCANNOT_INSTANCE_EXCEL_APP		 		18      && Cannot instance a Excel.Application
		#DEFINE cnCANNOT_INSTANCE_PREVIEW_FORM          19      && Cannot instance a Preview Form
		#DEFINE cnCANNOT_INSTANCE_OUTLOOK_APP		 	20      && Cannot instance a Outlook.OutPut
		#DEFINE cnCANNOT_INSTANCE_HTML_FILE				21
		#DEFINE cnPAGEHEADER_BAND_IS_TOO_LARGE		 	22      && Page Header band is too large to fit on page
		#DEFINE cnTITLE_BAND_IS_TOO_LARGE		 	    23      && Title band is too large to fit on page
		#DEFINE cnCANNOT_INSTANCE_IMAGE_FILE			24
		#DEFINE cnCANNOT_CREATE_COMPATIBLE_BITMAP		25
		#DEFINE cnCOMPATIBLE_BITMAP_SELECTION_FAILED	26
		#DEFINE cnFORM_TO_COMPATIBLE_BIT_FAILED			27
		#DEFINE cnWRONG_DEVICE_CONTEXT					28
		#DEFINE cnBITMAP_FAILED							29
		#DEFINE cnCANNOT_FIND_WINDOW					30
		#DEFINE cnOUT_OF_PAGES_RANGE					31
		#DEFINE cnTHERE_IS_NO_PAGES_TO_PRINT			32
		#DEFINE cnCANNOT_CREATE_IMAGE_FILE				33
		#DEFINE cnCANNOT_INSTANCE_PDF_FILE				34
		#DEFINE cnCANNOT_INSTANCE_XML_FILES				35
		
		#DEFINE cnSCOPE_CLAUSE_ALL		         		1
		#DEFINE cnSCOPE_CLAUSE_NEXT		         		2
		#DEFINE cnSCOPE_CLAUSE_RECORD	         		3
		#DEFINE cnSCOPE_CLAUSE_REST 	         		4
		
		#DEFINE cnOUTPUT_SCREEN			         		1
		#DEFINE cnOUTPUT_PRINT			         		2
		#DEFINE cnOUTPUT_EMAIL			         		3
		#DEFINE cnOUTPUT_FILE		 	         		4
		
		#DEFINE cnPREVIEW_WINDOW_TOOLBAR_NOTDOCKED      -1
		#DEFINE cnPREVIEW_WINDOW_TOOLBAR_TOP            0
		#DEFINE cnPREVIEW_WINDOW_TOOLBAR_LEFT           1
		#DEFINE cnPREVIEW_WINDOW_TOOLBAR_RIGHT          2
		#DEFINE cnPREVIEW_WINDOW_TOOLBAR_BOTTOM         3
		
		*-- Preview's Window WindowState types
		#DEFINE cnPREVIEW_WINDOW_STATE_NORMAL		 	0
		#DEFINE cnPREVIEW_WINDOW_STATE_MIN				1
		#DEFINE cnPREVIEW_WINDOW_STATE_MAX				2
		
		#DEFINE cnEXCEL_OUTPUT_OBJECT                   1
		#DEFINE cnEXCEL_OUTPUT_PLAIN					2
		#DEFINE cnEXCEL_OUTPUT_FULL_PLAIN				3
		#DEFINE cnEXCEL_OUTPUT_DRAFT					4
		#DEFINE cnEXCEL_OUTPUT_XMLSPREADSHEET			5
		
		#DEFINE cnIMAGE_OUTPUT_FILE_FORMAT_BMP          1
		#DEFINE cnIMAGE_OUTPUT_FILE_FORMAT_JPG			2
		#DEFINE cnIMAGE_OUTPUT_FILE_FORMAT_GIF			3
		#DEFINE cnIMAGE_OUTPUT_FILE_FORMAT_TIF			4
		#DEFINE cnIMAGE_OUTPUT_FILE_FORMAT_PNG			5
		
		#DEFINE cnRTF_OUTPUT_OBJECT   	               	1
		#DEFINE cnRTF_OUTPUT_PLAIN						2
		
		
		
		LOCAL loFile
		LOCAL loOutPutOptions
		LOCAL loPreviewOptions
		
		LOCAL lcReportFullName
		LOCAL lcReportFile
		LOCAL lcExportPath
		LOCAL lcErrorMessage
		LOCAL lcVersion
		
		WITH THISFORM
		
			lcReportFullName = ALLTRIM(.txtReportPath.VALUE)
			lcReportFullName = FORCEEXT(lcReportFullName, 'FRX')
			
			lcReportFile 	 = IIF(EMPTY(.txtOutputFileName.VALUE), JUSTSTEM(lcReportFullName), JUSTSTEM(.txtOutputFileName.VALUE)) 
			lcExportPath 	 = IIF(EMPTY(.txtOutputPath.VALUE),ADDBS(JUSTPATH(lcReportFullName)), ADDBS((.txtOutputPath.VALUE)))
		
			IF !FILE(lcReportFullName)
				lcErrorMessage = 'File ' + lcReportFullName + ' does not exist.'
				=MESSAGEBOX(lcErrorMessage, 16, 'Error')
			ELSE
		
				lcLastSetPath = SET('PATH')
				lcLastSetDir  = SET('DIRECTORY')
		
		
		*-- Set up the path so we can instantiate the FRX2ANY object
				lcSys16       = SYS(16)
				lcProgram     = SUBSTR(lcSys16, AT(":", lcSys16) - 1)
		
				CD LEFT(lcProgram, RAT("\", lcProgram))
		
				SET PATH TO .., ..\LIB, ..\PRG, ..\BMP, ..\CURSOR, ..\ICO, ..\FORM, ..\INCLUDE
		
				SET CLASSLIB TO '..\LIB\FRX2Any' ADDITIVE
				SET CLASSLIB TO '..\LIB\PRINTPREVIEW' ADDITIVE		
				
		*-- 10.12.01		
				SET PROCEDURE TO '..\PRG\GridDefinition' ADDITIVE
		
				DO CASE
					CASE tnFileType = cnWORD
						loFile = CREATEOBJECT('WordFile')
		
					CASE tnFileType = cnRTF
						loFile = CREATEOBJECT('RTFFile')
		
					CASE tnFileType = cnHTML
						loFile = CREATEOBJECT('HTMLFile')
		
					CASE tnFileType = cnEXCEL
						loFile = CREATEOBJECT('EXCELFile')
		
					CASE tnFileType = cnPREVIEW
						loFile = CREATEOBJECT('PREVIEWFile')
		
					CASE tnFileType = cnPDF
						loFile = CREATEOBJECT('PDFFile')
		
					CASE tnFileType = cnXML
						loFile = CREATEOBJECT('XMLFile')
						
					CASE tnFileType = cnIMAGE
						loFile = CREATEOBJECT('IMAGEFile')
		
				ENDCASE
		
				IF TYPE('loFile') = 'O'
				
				
				
					.CAPTION = 'FRX2Any v.' + loFile.GetVersion()		
		
				*-- Unlock FRX2Any
					loFile.Unlock('xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx-xxxxxx') 
					
					
					loFile.cExportFileName = lcReportFile
					loFile.cSaveFolder     = lcExportPath
		
		*-- Here we can get current version of FRX2ANY
					lcVersion = loFile.GetVersion()
		
		*-- Set up Report Scope
					IF INLIST(.opgScope.VALUE, cnSCOPE_CLAUSE_ALL, cnSCOPE_CLAUSE_NEXT, cnSCOPE_CLAUSE_RECORD, cnSCOPE_CLAUSE_REST)
						loFile.nScopeClauseType = .opgScope.VALUE
					ELSE
						loFile.nScopeClauseType = cnSCOPE_CLAUSE_ALL
					ENDIF
		
					DO CASE
						CASE loFile.nScopeClauseType = cnSCOPE_CLAUSE_NEXT
							loFile.nScopeRecords = .txtNextRecords.VALUE
						CASE loFile.nScopeClauseType = cnSCOPE_CLAUSE_RECORD
							loFile.nScopeRecordNumber = .txtRecord.VALUE
					ENDCASE
		
					IF !EMPTY(.txtFORExpression.VALUE)
						loFile.cFORExpression = ALLTRIM(.txtFORExpression.VALUE)
					ENDIF
		
					IF !EMPTY(.txtWHILEExpression.VALUE)
						loFile.cWHILEExpression = ALLTRIM(.txtWHILEExpression.VALUE)
					ENDIF
		
					IF !EMPTY(.txtHeading.VALUE)
						loFile.cHeadingText = ALLTRIM(.txtHeading.VALUE)
					ENDIF
		
					loFile.lPlain   = IIF(.opgPlain.VALUE = 1, .T., .F.)
					loFile.lSummary = IIF(.opgSummary.VALUE = 1, .T., .F.)
		
					DO CASE
						CASE  tnFileType = cnPREVIEW
		
							DO FORM PreviewOptions NAME loPreviewOptions LINKED
							
							IF TYPE('loPreviewOptions') = 'O' AND !ISNULL(loPreviewOptions)
							
								loFile.cLocalization     = IIF(EMPTY(loPreviewOptions.txtLocalization.TEXT), '', ALLTRIM(loPreviewOptions.txtLocalization.TEXT))
		*-- Set up Default ToolBar and Print Preview Form settings
								loFile.lToolBarDisplay   = loPreviewOptions.chkDisplay.VALUE
		
								loFile.lToolBarFind      = loPreviewOptions.chkFind.VALUE
								loFile.lToolBarPrint     = loPreviewOptions.chkPrint.VALUE
								loFile.lToolBarZoom      = loPreviewOptions.chkZoom.VALUE
								loFile.lToolBarFRX2Word  = loPreviewOptions.chkFRX2Word.VALUE
								loFile.lToolBarFRX2Excel = loPreviewOptions.chkFRX2Excel.VALUE
								loFile.lToolBarFRX2RTF   = loPreviewOptions.chkFRX2RTF.VALUE
								loFile.lToolBarFRX2HTML  = loPreviewOptions.chkFRX2HTML.VALUE
								loFile.lToolBarFRX2IMAGE = loPreviewOptions.chkFRX2IMAGE.VALUE
								loFile.lToolBarFRX2PDF   = loPreviewOptions.chkFRX2PDF.VALUE
								loFile.lToolBarFRX2XML   = loPreviewOptions.chkFRX2XML.VALUE
		
		
								DO CASE
									CASE loPreviewOptions.opgDockOptions.VALUE = 2
										loFile.nToolBarDockType = cnPREVIEW_WINDOW_TOOLBAR_TOP
		
									CASE loPreviewOptions.opgDockOptions.VALUE = 3
										loFile.nToolBarDockType = cnPREVIEW_WINDOW_TOOLBAR_LEFT
		
									CASE loPreviewOptions.opgDockOptions.VALUE = 4
										loFile.nToolBarDockType = cnPREVIEW_WINDOW_TOOLBAR_RIGHT
		
									CASE loPreviewOptions.opgDockOptions.VALUE = 5
										loFile.nToolBarDockType = cnPREVIEW_WINDOW_TOOLBAR_BOTTOM
		
									OTHERWISE
										loFile.nToolBarDockType = cnPREVIEW_WINDOW_TOOLBAR_NOTDOCKED
		
								ENDCASE
		
								loFile.nToolBarPositionTop       = loPreviewOptions.spnToolBarTop.VALUE
								loFile.nToolBarPositionLeft      = loPreviewOptions.spnToolBarLeft.VALUE
		
								loFile.cPrintPreviewFormTitle    = IIF(EMPTY(loPreviewOptions.txtWindowTitle.TEXT), '', ALLTRIM(loPreviewOptions.txtWindowTitle.TEXT))
								loFile.cPrintPreviewToolBarTitle = IIF(EMPTY(loPreviewOptions.txtToolBarTitle.TEXT), '', ALLTRIM(loPreviewOptions.txtToolBarTitle.TEXT))
								loFile.nDefaultPageNumber        = loPreviewOptions.spnDefaultPage.VALUE
								loFile.nBackGroundColor          = loPreviewOptions.cntBackGroundColor.BACKCOLOR
		
								DO CASE
									CASE loPreviewOptions.opgStateOptions.VALUE = 2
										loFile.nWindowState = cnPREVIEW_WINDOW_STATE_MIN
									CASE loPreviewOptions.opgStateOptions.VALUE = 3
										loFile.nWindowState = cnPREVIEW_WINDOW_STATE_MAX
									OTHERWISE
										loFile.nWindowState = cnPREVIEW_WINDOW_STATE_NORMAL
								ENDCASE
		
								loFile.lMaxButton = .T.
								loFile.lMinButton = .T.
		
							ENDIF
		
						OTHERWISE
		
							DO FORM OutPutOptions NAME loOutPutOptions LINKED WITH tnFileType
		
							IF TYPE('loOutPutOptions') = 'O' AND !ISNULL(loOutPutOptions)
		*-- Force FRX2ANY to display or not convertation process
								loFile.lDisplayStatus = loOutPutOptions.chkDisplayStatus.VALUE
		
								DO CASE
								
									CASE loFile.nExportFileType = cnRTF
									
		*!*								loFile.nCodePage = 1250
								
										WITH loOutPutOptions.pgfOutPutType.pgRTF
		
											DO CASE
												CASE .chkPlainRTF.VALUE
													loFile.nRTFOutPutType = cnRTF_OUTPUT_PLAIN
		
												OTHERWISE
													loFile.nRTFOutPutType = cnRTF_OUTPUT_OBJECT
		
											ENDCASE
		
		
										ENDWITH
		
									CASE loFile.nExportFileType = cnEXCEL
		
										WITH loOutPutOptions.pgfOutPutType.pgXLS
		
											DO CASE
												CASE .chkPlainExcel.VALUE
													loFile.nExcelOutPutType = cnEXCEL_OUTPUT_PLAIN
		
												CASE .chkPlainExcelFull.VALUE
													loFile.nExcelOutPutType = cnEXCEL_OUTPUT_FULL_PLAIN
		
												CASE .chkExcelDraft.VALUE
													loFile.nExcelOutPutType = cnEXCEL_OUTPUT_DRAFT
		
												CASE .chkXMLSS.VALUE
													loFile.nExcelOutPutType = cnEXCEL_OUTPUT_XMLSPREADSHEET
		
												OTHERWISE
													loFile.nExcelOutPutType = cnEXCEL_OUTPUT_OBJECT
		
											ENDCASE
		
											loFile.lMultiWorkSheet   = .chkMultiWorkSheet.VALUE
											loFile.lSuppressExtraRow = .chkSuppressExtraRow.VALUE
		
										ENDWITH
										
									CASE loFile.nExportFileType = cnIMAGE
																	
										WITH loOutPutOptions.pgfOutPutType.pgIMAGE
		
											loFile.nImageFileType = .opgOptions.VALUE
		
											loFile.nPixelFormat   = .opgPixelFormat.VALUE
											
											loFile.lMultiPageTiff = .chkMultiPageTifFile.Value
											
										ENDWITH
			
									CASE loFile.nExportFileType = cnHTML
		*-- Force FRX2ANY to include or not used image(s) into HTML output file. In this case MHT file will be created
										loFile.lEmbedImage = loOutPutOptions.pgfOutPutType.pgHTML.chkEmbedImageInHTML.VALUE
									
									CASE loFile.nExportFileType = cnPDF
		*-- Force FRX2ANY to include or not used font(s) into PDF output file
										loFile.lIncludeFont = loOutPutOptions.pgfOutPutType.pgPDF.chkIncludeFontIntoPDF.VALUE
		
										loFile.lTranslateFontStyle = loOutPutOptions.pgfOutPutType.pgPDF.chkFontName.VALUE
		
										loFile.cAddTo       = loOutPutOptions.pgfOutPutType.pgPDF.txtPDFPath.VALUE								
										loFile.nAddToType   = loOutPutOptions.pgfOutPutType.pgPDF.opgOptions.VALUE								
		
								ENDCASE
		
		
								DO CASE
									CASE loOutPutOptions.opgOptions.VALUE = 1
		*--Screen
										loFile.nOutPutType = cnOUTPUT_SCREEN
		
									CASE loOutPutOptions.opgOptions.VALUE = 2
		*--Print
										loFile.nOutPutType = cnOUTPUT_PRINT
		
									CASE loOutPutOptions.opgOptions.VALUE = 3
		*--E-Mail
										loFile.nOutPutType         = cnOUTPUT_EMAIL
										loFile.lAsAttachment       = loOutPutOptions.chkAttachment.VALUE
										loFile.lDisplayBeforeEMail = loOutPutOptions.chkDisplay.VALUE
										loFile.cSendTo             = loOutPutOptions.txtSendTo.VALUE
										loFile.cSendCC             = loOutPutOptions.txtCc.VALUE
										loFile.cSubject            = loOutPutOptions.txtSubject.VALUE
										
									OTHERWISE
		*--File
										loFile.nOutPutType = cnOUTPUT_FILE
								ENDCASE
		
							ELSE
		
								loFile.RELEASE()
								loFile = .NULL.
		
								RETURN
		
							ENDIF
		
					ENDCASE
		
		
		*-- Init DE
					lnSuccess = loFile.InitDataEnvironment(lcReportFullName)
		
					DO CASE
						CASE lnSuccess = cnDE_INIT_RETURN_FALSE
						OTHERWISE
		
							DO CASE
								CASE lnSuccess = cnNO_OPEN_TABLE
									USE ?
							ENDCASE
		
							lnSuccess  		 = loFile.SAVE(lcReportFullName)
		
							loFile.RELEASE()
							loFile 			 = .NULL.
		
					ENDCASE
		
		
					DO CASE
						CASE lnSuccess = cnDE_INIT_RETURN_FALSE
							lcErrorMessage = 'Init method of dataenvironment returned false.'
							=MESSAGEBOX(lcErrorMessage, 16, 'Error')
		
						CASE lnSuccess = cnNO_OPEN_TABLE
							lcErrorMessage = 'No open table and no dataenvironment cursors in FRX file.'
							=MESSAGEBOX(lcErrorMessage, 16, 'Error')
					ENDCASE
				ELSE
					lcErrorMessage = 'Could not instatiate Frx2Any object.'
					=MESSAGEBOX(lcErrorMessage, 16, 'Error')
				ENDIF
		
				SET PATH TO (lcLastSetPath)
				CD (lcLastSetDir)
		
			ENDIF
		
		ENDWITH
		
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		THISFORM.RELEASE()
	ENDPROC

	PROCEDURE cmdExcel.Click
		#DEFINE cnEXCEL       4
		
		THISFORM.ConvertTo(cnEXCEL)
	ENDPROC

	PROCEDURE cmdF2APreview.Click
		#DEFINE cnPREVIEW       6
		
		THISFORM.ConvertTo(cnPREVIEW)
	ENDPROC

	PROCEDURE cmdHTML.Click
		#DEFINE cnHTML      2
		
		THISFORM.ConvertTo(cnHTML)
	ENDPROC

	PROCEDURE cmdIMG.Click
		#DEFINE cnIMAGE	     8
		
		THISFORM.ConvertTo(cnIMAGE)
	ENDPROC

	PROCEDURE cmdPDF.Click
		#DEFINE cnPDF	     7
		
		THISFORM.ConvertTo(cnPDF)
	ENDPROC

	PROCEDURE cmdPickUpOutputPath.Click
		LOCAL loNULL
		
		ON ERROR loNULL = .NULL.
		THISFORM.txtOutputPath.VALUE=GETDIR()
		ON ERROR
		
	ENDPROC

	PROCEDURE cmdPickUpReport.Click
		LOCAL loNULL
		
		ON ERROR loNULL = .NULL.
		THISFORM.txtReportPath.VALUE=GETFILE('FRX;FRM')
		ON ERROR
		
	ENDPROC

	PROCEDURE cmdPreview.Click
		***************************************************************************************************************************
		*-- The scope clauses types
		***************************************************************************************************************************
		#DEFINE cnSCOPE_CLAUSE_ALL		         		1
		#DEFINE cnSCOPE_CLAUSE_NEXT		         		2
		#DEFINE cnSCOPE_CLAUSE_RECORD	         		3
		#DEFINE cnSCOPE_CLAUSE_REST 	         		4
		***************************************************************************************************************************
		
		LOCAL lcReportFullName
		LOCAL lcReportFormCommand
		
		LOCAL lnScopeClauseType
		LOCAL lnScopeRecords
		LOCAL lnScopeRecordNumber
		
		CLOSE TABLES ALL
		CLOSE DATABASES ALL
		
		WITH THISFORM
		
			lcReportFormCommand = ''
		
			lcReportFullName = ALLTRIM(.txtReportPath.VALUE)
			lcReportFullName = FORCEEXT(lcReportFullName, 'FRX')
		
			IF FILE(lcReportFullName)
		
		*-- Set up Report Scope
				IF INLIST(.opgScope.VALUE, cnSCOPE_CLAUSE_ALL, cnSCOPE_CLAUSE_NEXT, cnSCOPE_CLAUSE_RECORD, cnSCOPE_CLAUSE_REST)
					lnScopeClauseType = .opgScope.VALUE
				ELSE
					lnScopeClauseType = cnSCOPE_CLAUSE_ALL
				ENDIF
		
				DO CASE
					CASE lnScopeClauseType = cnSCOPE_CLAUSE_NEXT
						lnScopeRecords = .txtNextRecords.VALUE
		
						lcReportFormCommand = 'REPORT FORM (lcReportFullName) NEXT lnScopeRecords'
		
					CASE lnScopeClauseType = cnSCOPE_CLAUSE_RECORD
						lnScopeRecordNumber = .txtRecord.VALUE
		
						lcReportFormCommand = 'REPORT FORM (lcReportFullName) RECORD lnScopeRecordNumber'
		
					CASE lnScopeClauseType = cnSCOPE_CLAUSE_REST
						lnScopeRecords = .txtNextRecords.VALUE
		
						lcReportFormCommand = 'REPORT FORM (lcReportFullName) REST'
		
					OTHERWISE
		
						lcReportFormCommand = 'REPORT FORM (lcReportFullName)'
		
				ENDCASE
		
				IF !EMPTY(.txtFORExpression.VALUE)
					lcReportFormCommand = lcReportFormCommand + ' FOR ' + ALLTRIM(.txtFORExpression.VALUE)
				ENDIF
		
				IF !EMPTY(.txtWHILEExpression.VALUE)
					lcReportFormCommand = lcReportFormCommand + ' WHILE ' + ALLTRIM(.txtWHILEExpression.VALUE)
				ENDIF
		
				IF !EMPTY(.txtHeading.VALUE)
					lcReportFormCommand = lcReportFormCommand + ' HEADING ' + '[' + ALLTRIM(.txtHeading.VALUE)+ ']'
				ENDIF
		
				IF .opgPlain.VALUE = 1
					lcReportFormCommand = lcReportFormCommand + ' PLAIN '
				ENDIF
		
				IF .opgSummary.VALUE = 1
					lcReportFormCommand = lcReportFormCommand + ' SUMMARY '
				ENDIF
		
				lcReportFormCommand = lcReportFormCommand + ' PREVIEW'
		
				&lcReportFormCommand
			ENDIF
		
		ENDWITH
		
	ENDPROC

	PROCEDURE cmdRTF.Click
		#DEFINE cnRTF 		3
		
		THISFORM.ConvertTo(cnRTF)
	ENDPROC

	PROCEDURE cmdWORD.Click
		#DEFINE cnWORD 		1
		
		THISFORM.ConvertTo(cnWORD)
	ENDPROC

	PROCEDURE cmdXML.Click
		#DEFINE cnXML	     5
		
		THISFORM.ConvertTo(cnXML)
	ENDPROC

	PROCEDURE opgScope.Click
		WITH THISFORM
			.txtNextRecords.ENABLED = (THIS.VALUE == 2)
			.txtRecord.ENABLED      = (THIS.VALUE == 3)
		ENDWITH
		
	ENDPROC

	PROCEDURE txtReportPath.InteractiveChange
		WITH THIS
			THISFORM.txtOutputPath.VALUE = ADDBS(JUSTPATH(.VALUE))
		
			THISFORM.txtOutputFileName.VALUE = JUSTSTEM(.VALUE)
		
		ENDWITH
		
	ENDPROC

	PROCEDURE txtReportPath.ProgrammaticChange
		THIS.INTERACTIVECHANGE()
		
	ENDPROC

ENDDEFINE
