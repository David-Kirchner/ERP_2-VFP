	PROCEDURE txtSQLMax.Valid
		
		PRIVATE nSizeMin
		nSizeMin = PrepareSQLnum(ThisForm.txtSQLMin.Value,'Size',9,3)
		
		PRIVATE nSizeMax
		nSizeMax = PrepareSQLnum(This.Value,'Size',9,3)
		
		
		IF NOT EMPTY(nSizeMin)
			IF NOT EMPTY(nSizeMax)
				IF nSizeMin > nSizeMax
					MESSAGEBOX("Your MIN is Greater than your MAX.",0+64,"Bad value")
				ENDIF
			ENDIF	
		ENDIF
		
		
	ENDPROC

	PROCEDURE txtSQLMin.Valid
		
		PRIVATE nSizeMin
		nSizeMin = PrepareSQLnum(This.Value,'Size',9,3)
		
		PRIVATE nSizeMax
		nSizeMax = PrepareSQLnum(ThisForm.txtSQLMax.Value,'Size',9,3)
		
		
		IF NOT EMPTY(nSizeMin)
			IF NOT EMPTY(nSizeMax)
				IF nSizeMin > nSizeMax
					MESSAGEBOX("Your MIN is Greater than your MAX.",0+64,"Bad value")
				ENDIF
			ENDIF	
		ENDIF
		
		
	ENDPROC

ENDDEFINE
