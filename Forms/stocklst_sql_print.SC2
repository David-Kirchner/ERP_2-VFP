	PROCEDURE Command1.Click
		PRIVATE cSQL
		cSQL = ThisForm.MakeSQL()
		
		IF USED("StockLst_SQL")
			SELECT StockLst_SQL
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'StockLst_SQL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'StockLst_SQL')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_SQL")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_SQL")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC ,'StockLst_SQL')
		ELSE
		*!*		INDEX ON Alloy TAG Alloy
		*!*		INDEX ON Alloy+FORM TAG AlloyForm
		*!*		INDEX ON Alloy+FORM+STR(SIZE,9,3) TAG StockLst
		*!*		SET ORDER TO TAG StockLst
			PRIVATE cMEM
			cMEM = IIF( "\MEM" $ SYS(2003),'','\MEM')
		
			SELECT StockLst_SQL
			EXPORT TO SYS(5)+SYS(2003)+cMEM+"\"+"StockLst.xls" TYPE XLS
			
			LOCAL loExcel
			TRY
				loExcel = CREATEOBJECT("Excel.Application")
				loExcel.workbooks.open(SYS(5)+SYS(2003)+cMEM+"\"+"StockLst.xls")
				loExcel.visible = .T.
			CATCH
				MESSAGEBOX("Look in "+SYS(5)+SYS(2003)+cMEM+"\"+" for StockLst.xls!",0,"Exported as file.")
			ENDTRY
			
		ENDIF
		
		IF USED('StockLst_SQL')
			USE IN StockLst_SQL
		ENDIF
	ENDPROC

