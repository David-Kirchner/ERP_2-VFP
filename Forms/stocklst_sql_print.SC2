	PROCEDURE cmdPrintLocations.Click
		PRIVATE cSQL
		cSQL = "SELECT DISTINCT [Location] FROM dbo.StockLst_Detail "
		cSQL = cSQL + " WHERE NOT ( [Location] LIKE '%&%' OR [Location] LIKE '%/%' OR [Location] LIKE '%,%') ORDER BY [Location]"
		
		IF USED("location_SQL")
			SELECT location_SQL
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'location_SQL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'location_SQL')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "location_SQL")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "location_SQL")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
