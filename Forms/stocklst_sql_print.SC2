				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='72')"
					ELSE
						cSQL = cSQL + " WHERE Form='72'"
					ENDIF
