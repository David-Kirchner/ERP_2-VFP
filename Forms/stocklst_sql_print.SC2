					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='95')"
					ELSE
						cSQL = cSQL + " OR Form='95'"
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk97.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND (Form='96' or Form='97'))"
					ELSE
						cSQL = cSQL + " WHERE (Form='96' or Form='97')"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND (Form='96' or Form='97'))"
					ELSE
						cSQL = cSQL + " OR (Form='96' or Form='97')"
					ENDIF
				ENDIF
			ENDIF
