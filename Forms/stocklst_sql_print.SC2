					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk30.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='30')"
					ELSE
						cSQL = cSQL + " WHERE Form='30'"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='30')"
					ELSE
						cSQL = cSQL + " OR Form='30'"
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk40.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='40')"
					ELSE
						cSQL = cSQL + " WHERE Form='40'"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='40')"
					ELSE
						cSQL = cSQL + " OR Form='40'"
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk50.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='50')"
					ELSE
						cSQL = cSQL + " WHERE Form='50'"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='50')"
