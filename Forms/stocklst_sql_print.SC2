					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND (Form='98' or Form='99'))"
					ELSE
						cSQL = cSQL + " WHERE (Form='98' or Form='99')"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND(Form='98' or Form='99'))"
					ELSE
						cSQL = cSQL + " OR (Form='98' or Form='99')"
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE cCC
		cCC = ThisForm.cmbCC.Value
		IF cCC != "0"
			IF " WHERE " $ cSQL
		*		IF cCC = "1"
		*			*Nitronic 60 uses 'R' for Anneled ESR
		*			cSQL = cSQL + " AND (CC = '1' OR CC = 'R')"
		*		ELSE
					cSQL = cSQL + " AND CC = '"+cCC+"'"
		*		ENDIF
			ELSE
		*		IF cCC = "1"
		*			cSQL = cSQL + " WHERE (CC = '1' OR CC = 'R')"		
		*		ELSE
					cSQL = cSQL + " WHERE CC = '"+cCC+"'"
		*		ENDIF
			ENDIF
		ENDIF
		
		PRIVATE nSizeMin
		nSizeMin = PrepareSQLnum(ThisForm.txtSQLMin.Value,'Size',9,3)
		IF NOT EMPTY(nSizeMin)
			IF nSizeMin > 0
				IF " WHERE " $ cSQL
					cSQL = cSQL + " AND Size >= "+STR(nSizeMin,14,3)
				ELSE
					cSQL = cSQL + " WHERE  Size >= "+STR(nSizeMin,14,3)
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE nSizeMax
		nSizeMax = PrepareSQLnum(ThisForm.txtSQLMax.Value,'Size',9,3)
		IF NOT EMPTY(nSizeMax)
			IF nSizeMax > 0
				IF " WHERE " $ cSQL
					cSQL = cSQL + " AND Size <= "+STR(nSizeMax,14,3)
				ELSE
					cSQL = cSQL + " WHERE Size <= "+STR(nSizeMax,14,3)
				ENDIF
			ENDIF
		ENDIF
		
		IF nInvCheck = 2
			IF " WHERE " $ cSQL
				cSQL = cSQL + " AND InvCheck IS NULL "
			ELSE
				cSQL = cSQL + " WHERE InvCheck IS NULL "
			ENDIF
		ENDIF
		IF nInvCheck = 3
			IF " WHERE " $ cSQL
				cSQL = cSQL + " AND ( InvCheck IS NULL "
				cSQL = cSQL + " OR InvCheck+365 < GETDATE() )"
			ELSE
				cSQL = cSQL + " WHERE ( InvCheck IS NULL "
				cSQL = cSQL + " OR InvCheck+365 < GETDATE() )"
			ENDIF
		ENDIF
		IF nInvCheck = 4
			IF " WHERE " $ cSQL
				cSQL = cSQL + " AND ( InvCheck IS NULL "
				cSQL = cSQL + " OR InvCheck+30 < GETDATE() )"
			ELSE
				cSQL = cSQL + " WHERE ( InvCheck IS NULL "
				cSQL = cSQL + " OR InvCheck+30 < GETDATE() )"
			ENDIF
		ENDIF
		
		
		
		IF lAbove1000
			IF " WHERE " $ cSQL
				cSQL = cSQL + " AND dbo.f_GetStockLst_Detail_CurrentCost (Unit,PC,dim3,Weight,CostValue) > 1000 "
			ELSE
				cSQL = cSQL + " WHERE dbo.f_GetStockLst_Detail_CurrentCost (Unit,PC,dim3,Weight,CostValue) > 1000 "
			ENDIF
			lAbove200 = .F.
		ENDIF
		IF lAbove200
			IF " WHERE " $ cSQL
				cSQL = cSQL + " AND dbo.f_GetStockLst_Detail_CurrentCost (Unit,PC,dim3,Weight,CostValue) > 200 "
			ELSE
				cSQL = cSQL + " WHERE dbo.f_GetStockLst_Detail_CurrentCost (Unit,PC,dim3,Weight,CostValue) > 200 "
			ENDIF
		ENDIF
		
		IF lQuarantine &&PrepareSQLlogic(ThisForm.chkQuarantine.Value,'Quarantine')
			IF " WHERE " $ cSQL
				cSQL = cSQL + " AND ISNULL(Quarantine,0)=1"
			ELSE
				cSQL = cSQL + " WHERE ISNULL(Quarantine,0)=1"
			ENDIF
		ENDIF
		
		
		IF lSortLocation
			IF lIgnoreCC
				IF nInvCheck = 5
					cSQL = cSQL + " ORDER BY ISNULL(InvCheck,'1900-01-01'), alloy, form, [Location], size, cc, heat "
				ELSE
					cSQL = cSQL + " ORDER BY alloy, form, [Location], size, cc, heat "
				ENDIF
			ELSE
				IF nInvCheck = 5
					cSQL = cSQL + " ORDER BY ISNULL(InvCheck,'1900-01-01'), alloy, form, [Location], cc, size, heat "
				ELSE
					cSQL = cSQL + " ORDER BY alloy, form, [Location], cc, size, heat "
				ENDIF
			ENDIF
		ELSE	
			*Not Sorted by location
			IF lIgnoreCC
				IF nInvCheck = 5
					cSQL = cSQL + " ORDER BY ISNULL(InvCheck,'1900-01-01'), alloy, form, size, cc, heat "
				ELSE
					cSQL = cSQL + " ORDER BY alloy, form, size, cc, heat "
				ENDIF
			ELSE
				IF nInvCheck = 5
					cSQL = cSQL + " ORDER BY ISNULL(InvCheck,'1900-01-01'), alloy, form, cc, size, heat "
				ELSE
					cSQL = cSQL + " ORDER BY alloy, form, cc, size, heat "
				ENDIF
			ENDIF
		ENDIF
		
			
		
		RETURN cSQL
	ENDPROC

