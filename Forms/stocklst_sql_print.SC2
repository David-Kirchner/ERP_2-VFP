	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE formchanged
		PARAMETERS plValue
		*ThisForm.FormChanged( This.Value )
		
		IF plValue = 0
			ThisForm.chkFormAll.Value = 0
		ELSE
			IF ThisForm.chkFormAll.Value = 0
				*IF ALL OTHERS ARE 1, change all to 1
				IF ThisForm.chk10.Value = 1;
					AND ThisForm.chk11.Value = 1;
					AND ThisForm.chk12.Value = 1;
					AND ThisForm.chk13.Value = 1;
					AND ThisForm.chk20.Value = 1;
					AND thisForm.chk21.Value = 1;
					AND ThisForm.chk22.Value = 1;
					AND ThisForm.chk23.Value = 1;
					AND ThisForm.chk30.Value = 1;
					AND ThisForm.chk40.Value = 1;
					AND ThisForm.chk50.Value = 1;
					AND ThisForm.chk51.Value = 1;
					AND ThisForm.chk52.Value = 1;
					AND ThisForm.chk60.Value = 1;
					AND ThisForm.chk65.Value = 1;
					AND ThisForm.chk70.Value = 1;
					AND ThisForm.chk71.Value = 1;
					AND ThisForm.chk72.Value = 1;
					AND ThisForm.chk75.Value = 1;
					AND ThisForm.chk80.Value = 1;
					AND ThisForm.chk90.Value = 1;
					AND ThisForm.chk95.Value = 1;
					AND ThisForm.chk97.Value = 1;
					AND ThisForm.chk99.Value = 1 
				
					ThisForm.chkFormAll.Value = 1
				ENDIF
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		PRIVATE  lOK
		lOK = .F.
		
		PRIVATE cSQL_Master, cSQL_Detail, cSQL_Process
		PRIVATE nSQLEXEC
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountDetail")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountDetail")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF		
		
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQLd,ThisForm.nConnHandle, nSQLEXEC ,'')
		*!*	ENDIF
					
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SETUP ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		
		
	ENDPROC

	PROCEDURE makesql
		*ThisForm.MakeSQL()
		PRIVATE cSQL, nSQLEXEC
		PRIVATE lAddWhere, lAddAND, lAddOR
		lAddWhere = .T.
		lAddAlloy = .F.
		lAddOR	= .T.
		
		PRIVATE lAbove200, lAbove1000, lExtraSpace, lIgnoreCC, lQuarantine, lSortLocation
		lAbove200	= PrepareSQLchk(ThisForm.chkAbove200.Value,'Above200')
		lAbove1000	= PrepareSQLchk(ThisForm.chkAbove1000.Value,'Above1000')
		*lExtraSpace	= PrepareSQLchk(ThisForm.chkInvCheck.Value,'ExtraSpace')
		lIgnoreCC	= PrepareSQLchk(ThisForm.chkIgnoreCC.Value,'IgnoreCC')
		lQuarantine = PrepareSQLchk(ThisForm.chkQuarantine.Value,'Quarantine')
		lSortLocation = PrepareSQLchk(ThisForm.chkSortLocation.Value,'SortLocation')
		
		PRIVATE cLocation
		cLocation = ThisForm.cmbLocation.Value
		IF UPPER(cLocation) != "ALL"
		
			IF ThisForm.opgLst.Value = 1
				*IF ThisForm.Lst = "StockLst"
				cSQL = "SELECT * FROM dbo.StockLst_View WHERE [Location] = '"+cLocation+"'"
			ELSE
				IF ThisForm.opgLst.Value = 2
					cSQL = "SELECT * FROM dbo.BrokerLst_View WHERE [Location] = '"+cLocation+"'"
				ELSE
					IF ThisForm.opgLst.Value = 3
						cSQL = "SELECT * FROM dbo.WIPLst_View WHERE [Location] = '"+cLocation+"'"
					ENDIF
				ENDIF
			ENDIF
		
		*!*		IF ThisForm.Lst = "StockLst"
		*!*			cSQL = "SELECT * FROM dbo.StockLst_View WHERE [Location] = '"+cLocation+"'" 
		*!*		ELSE
		*!*			cSQL = "SELECT * FROM dbo.BrokerLst_View WHERE [Location] = '"+cLocation+"'" 
		*!*		ENDIF
			
			IF lAbove1000
				cSQL = cSQL + " AND dbo.f_GetStockLst_Detail_CurrentCost (Unit,PC,dim3,Weight,CostValue) > 1000 "			
				lAbove200 = .F.
			ENDIF
			IF lAbove200
				cSQL = cSQL + " AND dbo.f_GetStockLst_Detail_CurrentCost (Unit,PC,dim3,Weight,CostValue) > 200 "
			ENDIF	
		
			cSQL = cSQL + " ORDER BY alloy, form, size, cc, heat "
						
			
			*Return
			WAIT WINDOW "All items from one Location selected and possible limit to min price" TIMEOUT 1 
			RETURN cSQL
		ELSE
			*Continue with Other Options
		ENDIF
		
		PRIVATE cRack
		cRack = ThisForm.cmbRack.Value
		IF UPPER(cRack) != "ALL"
			IF UPPER(cRack) = "CONVERSION"
				IF ThisForm.opgLst.Value = 1
					*IF ThisForm.Lst = "StockLst"
					cSQL = "SELECT * FROM dbo.StockLst_View"
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Location SL ON SL.Location = StockLst_View.Location "
					cSQL = cSQL + " WHERE ISNULL(SL.RemoteStock,0) = 1" 
				ELSE
					IF ThisForm.opgLst.Value = 2
						cSQL = "SELECT * FROM dbo.BrokerLst_View "
						cSQL = cSQL + " INNER JOIN dbo.StockLst_Location SL ON SL.Location = StockLst_View.Location "
						cSQL = cSQL + " WHERE ISNULL(SL.RemoteStock,0) = 1" 
					ELSE
						IF ThisForm.opgLst.Value = 3
							cSQL = "SELECT * FROM dbo.WIPLst_View "
							cSQL = cSQL + " INNER JOIN dbo.StockLst_Location SL ON SL.Location = StockLst_View.Location "
							cSQL = cSQL + " WHERE ISNULL(SL.RemoteStock,0) = 1" 
		
						ENDIF
					ENDIF
				ENDIF
			
			ELSE
				IF ThisForm.opgLst.Value = 1
					*IF ThisForm.Lst = "StockLst"
					cSQL = "SELECT * FROM dbo.StockLst_View WHERE [Location] LIKE '"+cRack+"%'" 
				ELSE
					IF ThisForm.opgLst.Value = 2
						cSQL = "SELECT * FROM dbo.BrokerLst_View WHERE [Location] LIKE '"+cRack+"%'" 
					ELSE
						IF ThisForm.opgLst.Value = 3
							cSQL = "SELECT * FROM dbo.WIPLst_View WHERE [Location] LIKE '"+cRack+"%'" 
						ENDIF
					ENDIF
				ENDIF
		
			ENDIF
			
			IF lAbove1000
				cSQL = cSQL + " AND dbo.f_GetStockLst_Detail_CurrentCost (Unit,PC,dim3,Weight,CostValue) > 1000 "
				lAbove200 = .F.
			ENDIF
			IF lAbove200
				cSQL = cSQL + " AND dbo.f_GetStockLst_Detail_CurrentCost (Unit,PC,dim3,Weight,CostValue) > 200 "
			ENDIF	
			cSQL = cSQL + " ORDER BY alloy, form, size, cc, heat "
			
			*Return
			WAIT WINDOW "All items from a Rack selected and possible limit to min price" TIMEOUT 1
			RETURN cSQL
		ELSE
			*Continue with Other Options
		ENDIF
		
		PRIVATE nInvCheck 
		nInvCheck = ThisForm.ogInvCheck.Value
		*nInvCheck 
		*1='Do not Use InvCheck
		*2='NotFound' list
		*3=Over a year Since 'Inv Check'
		*4=Over a month Since 'Inv Check'
		*5=Order by InvCheck
		
		IF ThisForm.opgLst.Value = 1
			*IF ThisForm.Lst = "StockLst"
			cSQL = "SELECT * FROM dbo.StockLst_View "
		ELSE
			IF ThisForm.opgLst.Value = 2
				cSQL = "SELECT * FROM dbo.BrokerLst_View "
			ELSE
				IF ThisForm.opgLst.Value = 3
					cSQL = "SELECT * FROM dbo.WIPLst_View "
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.cmbAlloy.Value <> "All Alloys"
			lAddAlloy = .T.
		ENDIF
		
		IF ThisForm.chkFormAll.Value = 1
			*All Forms
			IF lAddAlloy 
				*No Form
				cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"')"
				lAddWhere = .F.
			ELSE
				*No Alloy, No form
				cSQL = cSQL
				lAddWhere = .F.
			ENDIF
		ELSE
			IF ThisForm.chk10.Value = 1
				IF lAddWhere 
					IF lAddAlloy 
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='10')"
					ELSE
						cSQL = cSQL + " WHERE Form='10'"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='10')"
					ELSE
						cSQL = cSQL + " OR Form='10'"	
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk11.Value = 1
				IF lAddWhere 
					IF lAddAlloy 
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='11')"	
					ELSE
						cSQL = cSQL + " WHERE Form='11'"	
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='11')"
					ELSE
						cSQL = cSQL + " OR Form='11'"		
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk12.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='12')"
					ELSE
						cSQL = cSQL + " WHERE Form='12'"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='12')"
					ELSE
						cSQL = cSQL + " OR Form='12'"
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk13.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='13')"
					ELSE
						cSQL = cSQL + " WHERE Form='13'"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='13')"
					ELSE
						cSQL = cSQL + " OR Form='13'"
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk20.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='20')"
					ELSE
						cSQL = cSQL + " WHERE Form='20'"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='20')"
					ELSE
						cSQL = cSQL + " OR Form='20'"
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk21.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='21')"
					ELSE
						cSQL = cSQL + " WHERE Form='21'"
					ENDIF
					lAddWhere = .F.
				ELSE
					IF lAddAlloy 
						cSQL = cSQL + " OR (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='21')"
					ELSE
						cSQL = cSQL + " OR Form='21'"
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk22.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='22')"
					ELSE
