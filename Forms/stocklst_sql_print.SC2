	PROCEDURE cmbAlloy.Init
		#DEFINE ALLAlloy_LOC "All Alloys"
		this.clear
		this.additem(ALLAlloy_LOC) 
		
		LOCAL aAlloys,cAlloy
		DIMENSION aAlloys[1]
		
		PRIVATE cSQL_Master_a, cSQL_Detail, cSQL_Process
		PRIVATE nSQLEXEC
		
		cSQL_Master_A="SELECT DISTINCT Alloy FROM dbo.StockLst_Master ORDER BY Alloy"
		
		IF USED('StockLst_Master_a')
			USE IN StockLst_Master_a
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_A, 'StockLst_Master_A')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_A, 'StockLst_Master_A')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_A, "StockLst_Master_A")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Master_A, "StockLst_Master_A")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_Master_A,ThisForm.nConnHandle, nSQLEXEC ,'StockLst_Master_A')
		ELSE
		
			SELECT DISTINCT alloy FROM StockLst_Master_A WHERE !EMPTY(alloy) INTO array aAlloys
		
			FOR EACH m.cAlloy IN aAlloys
				IF !EMPTY(m.cAlloy)
					this.additem(m.cAlloy)
				ENDIF
			ENDFOR
		
			*THIS.VALUE = ALLAlloy_LOC
			*THIS.VALUE = aAlloys(1)
		
		ENDIF
		
		IF USED('StockLst_Master_a')
			USE IN StockLst_Master_a
		ENDIF
		
		THIS.VALUE = ALLAlloy_LOC
		*ThisForm.DispAlloyFilter=aAlloys(1)
		
		
		
		
	ENDPROC

	PROCEDURE cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "0"
		aConditionCode(1,2) = "ALL"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		
		nLoopCount = 1
		this.addListitem("0",nLoopCount,1)
		this.addListitem("All Conditions",nLoopCount,2)
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount+1,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount+1,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Value = "0"
		
	ENDPROC

	PROCEDURE cmbLocation.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpLocation')
			SELECT tmpLocation
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		*cSQL="SELECT DISTINCT [Location] FROM dbo.StockLst_Detail WHERE NOT ( [Location] LIKE '%&%' OR [Location] LIKE '%/%' OR [Location] LIKE '%,%') ORDER BY [Location]"
		
		cSQL = "SELECT DISTINCT [Location] FROM ( "
		cSQL=cSQL+" SELECT [Location] FROM dbo.StockLst_Location "
		cSQL=cSQL+" UNION "
		cSQL=cSQL+" SELECT DISTINCT [Location] FROM dbo.StockLst_Detail WHERE NOT ( [Location] LIKE '%&%' OR [Location] LIKE '%/%' OR [Location] LIKE '%,%') "
		cSQL=cSQL+" ) t "
		cSQL=cSQL+" ORDER BY [Location]"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpLocation')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpLocation')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLocation")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpLocation")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpLocation')
		ENDIF
		DIMENSION aLocation[1]
		aLocation(1) = "ALL"
		
		IF USED('tmpLocation')
			SELECT * FROM tmpLocation WHERE !EMPTY(Location) INTO ARRAY aLocation
			
			USE IN tmpLocation
		ENDIF
		
		This.ColumnCount = 1
		This.NumberOfElements=ALEN(aLocation)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		
		nLoopCount = 1
		this.addListitem("All",nLoopCount,1)
		
		FOR EACH cc1 IN aLocation
			IF !EMPTY(cc1)
				this.addListitem(ALLTRIM(cc1),nLoopCount+1)
				nLoopCount = nLoopCount + 1
			ENDIF
		ENDFOR
		
		This.Value = "All"
		
	ENDPROC

	PROCEDURE cmbRack.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpRack')
			SELECT tmpRack
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT DISTINCT LEFT([Location],5) AS Rack FROM dbo.StockLst_Detail "
		cSQL=cSQL+" WHERE [Location] LIKE 'WESR%' "
		cSQL=cSQL+" UNION "
		cSQL=cSQL+" SELECT DISTINCT LEFT([Location],5) AS Rack FROM dbo.StockLst_Detail "
		cSQL=cSQL+" WHERE [Location] LIKE 'WSSR%' "
		cSQL=cSQL+" UNION"
		cSQL=cSQL+" SELECT DISTINCT LEFT([Location],3) AS Rack FROM dbo.StockLst_Detail "
		cSQL=cSQL+" WHERE [Location] LIKE 'TR%'"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRack')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRack')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRack")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRack")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpRack')
		ENDIF
		DIMENSION aRack[1]
		aRack(1) = "ALL"
		
		IF USED('tmpRack')
			SELECT * FROM tmpRack WHERE !EMPTY(Rack) INTO ARRAY aRack
			
			USE IN tmpRack
		ENDIF
		
		PRIVATE nRackTotal
		nRackTotal = ALEN(aRack)+1
		DIMENSION aRack[nRackTotal]
		aRack(nRackTotal) = "Conversion"
		
		This.ColumnCount = 1
		This.NumberOfElements=ALEN(aRack)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		
		nLoopCount = 1
		this.addListitem("All",nLoopCount,1)
		
		FOR EACH cc1 IN aRack
			IF !EMPTY(cc1)
				this.addListitem(ALLTRIM(cc1),nLoopCount+1)
				nLoopCount = nLoopCount + 1
			ENDIF
		ENDFOR
		
		*cmbRack
		This.Value = "All"
		
	ENDPROC

