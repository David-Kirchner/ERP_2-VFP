					ELSE
						cSQL = cSQL + " OR Form='22'"
					ENDIF
				ENDIF
			ENDIF
			IF ThisForm.chk23.Value = 1
				IF lAddWhere 
					IF lAddAlloy
						cSQL = cSQL + " WHERE (Alloy = '"+ThisForm.cmbAlloy.Value+"' AND Form='23')"
					ELSE
