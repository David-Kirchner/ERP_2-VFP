		Name = "txtWho", ;
		ReadOnly = .T., ;
		Top = 150, ;
		Width = 211
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pnLogID, pcTable
		
		*DO FORM Forms\UTscan WITH 2706,'GFMLOG'
		IF TYPE("pnLogID") != "N"
			MESSAGEBOX("No ID parameter.")
			RETURN 0
		ENDIF
		IF TYPE("pcTable") != "C"
			MESSAGEBOX("No table name parameter.")
			RETURN 0
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		This.Caption = This.Caption + pcTable
		This.cSearchTable = pcTable
		
		ThisForm.nLogID = pnLogID
		ThisForm.cTable = pcTable
		
		
		DO CASE
		CASE pcTable = "GFMLOG"
		*	ThisForm.TableName = "GFMlog"
		ENDCASE
		
		ThisForm.searchNow(pnLogID,pcTable)
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE refreshut
		*[UTPass],[Operator],[comment],[Who],[When]
		
		IF tmpSearch.UTPass 
			ThisForm.chkUTpass.Value = 1
		ELSE
			ThisForm.chkUTpass.Value = 0
		ENDIF
		ThisForm.txtOperator.Value	= tmpSearch.Operator
		ThisForm.edtComment.Value	= tmpSearch.Comment
		ThisForm.txtWho.Value	= tmpSearch.Who
		ThisForm.txtWhen.Value	= tmpSearch.When
		
		ThisForm.nID = tmpSearch.ID
	ENDPROC

	PROCEDURE searchnow
		PARAMETER nLogID,cTable
		*ThisForm.searchNow(nLogID,cTable)
		
		PRIVATE cSQL
		cSQL = "SELECT [UTPass],[Operator],[comment],[Who],[When],ID FROM "
		cSQL = cSQL + " dbo.UTlog "
		cSQL = cSQL + " WHERE LogType ='" + cTable + "' AND LogID=" + ALLTRIM(STR(nLogID)) + ' '
		
			
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		
		SELECT 0
		
		*This is a common 'Bad SQL Connetion' initiation point
		ThisForm.nConnHandle = CheckSQLConnection(ThisForm.nConnHandle)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, 'tmpSearch')
		ENDIF
		
		
		
		THISFORM.grdUT.ENABLED = .T.
		THISFORM.grdUT.RECORDSOURCE = 'tmpSearch'
		THISFORM.grdUT.REFRESH()
		
		*!*	IF ThisForm.TableName = "Vendor"
		*!*		THISFORM.grdUT.SetAll("dynamicbackcolor"," IIF( INACTIVE, RGB(255,0,0), IIF(Approved, RGB(128,255,128),RGB(255,255,255)))", "Column")
		*!*	ENDIF
		
		IF USED('tmpSearch')
			IF RECCOUNT('tmpSearch')>0
				ThisForm.nID = tmpSearch.ID		
			ELSE
				WAIT WINDOW "No records." NOWAIT
				ThisForm.nID = 0
			ENDIF
		ELSE
			WAIT WINDOW "No records." NOWAIT
			ThisForm.nID = 0
		ENDIF
	ENDPROC

	PROCEDURE cmdDelete.Click
		PRIVATE nId
		nID = ThisForm.nID
		
		*!*		PRIVATE nLogID, cTable
		*!*		nLogID		= ThisForm.nLogID
		*!*		cTable	= ThisForm.cTable
		*!*		
		*!*		PRIVATE lUTPass,cOperator,cComment
		*!*		lUTPass		= PrepareSQLchk(ThisForm.chkUTPass.Value,'UTPass',.F.)
		*!*		cOperator	= PrepareSQLtxt(ThisForm.txtOperator.Value,'Operator',20)
		*!*		cComment	= PrepareSQLtxt(ThisForm.edtComment.Value,'Comment',-1)
		
		PRIVATE cSQL	
		cSQL = "DELETE dbo.UTlog WHERE ID = "+ALLTRIM(STR(nID))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle)
		ENDIF
		
		
		ThisForm.searchNow(nLogID,cTable)
		
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = 'Edit'
			ThisForm.chkUTPass.ReadOnly = .F.
			ThisForm.txtOperator.ReadOnly = .F.
			ThisForm.grdUT.Enabled = .F.	
			ThisForm.CmdNew.Caption = "Abort"
			This.Caption = 'Save'
		ELSE
			*SAVE
			PRIVATE nLogID, cTable
			nLogID	= ThisForm.nLogID
			cTable	= ThisForm.cTable
			
			PRIVATE nID	
			nId = ThisForm.nID
		
			PRIVATE lUTPass,cOperator,cComment
			lUTPass		= PrepareSQLchk(ThisForm.chkUTPass.Value,'UTPass',.F.)
			cOperator	= PrepareSQLtxt(ThisForm.txtOperator.Value,'Operator',20)
			cComment	= PrepareSQLtxt(ThisForm.edtComment.Value,'Comment',-1)
		
			IF nId = 0
				*Add	
				cSQL = "INSERT INTO dbo.UTlog([LogType],[LogID],[UTPass],[Operator],[comment]) VALUES ("
				cSQL = cSQL + "'"+cTable+"',"+STR(nLogID)+","
				cSQL = cSQL + IIF(lUTPass,'1','0')
				cSQL = cSQL + ",'"+cOperator+"','"+cComment+"')"
			
			ELSE
				*Update
				cSQL = "UPDATE dbo.UTlog SET LogType='"+cTable+"'"
				cSQL = cSQL + ",LogID="+STR(nLogID)+""
				cSQL = cSQL + ",UTPass="+IIF(lUTPass,'1','0')
				cSQL = cSQL + ",Operator='"+cOperator+"'"
				cSQL = cSQL + ",comment='"+cComment+"'"
				cSQL = cSQL + " WHERE ID = "+STR(nID)
				
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle)
			ENDIF
		
			
			ThisForm.chkUTPass.ReadOnly = .T.
			ThisForm.txtOperator.ReadOnly = .T.
			
			ThisForm.grdUT.Enabled = .T.
		
			ThisForm.CmdNew.Caption = 'New'
				
			ThisForm.searchNow(nLogID,cTable)
		
		
			This.Caption = 'Edit'
		ENDIF
	ENDPROC

	PROCEDURE cmdExit.Click
		*ThisForm.nReturnKey = -1
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdNew.Click
		IF This.Caption = 'New'
			ThisForm.chkUTPass.ReadOnly = .F.
			ThisForm.chkUTPass.Value = 1
			ThisForm.txtOperator.ReadOnly = .F.
			ThisForm.txtOperator.Value = ''
			ThisForm.edtComment.Value = ''
			ThisForm.txtWho.Value = ''
			ThisForm.txtWhen.Value = ''
		
			ThisForm.nID = 0
			ThisForm.grdUT.Enabled = .F.	
		
			ThisForm.cmdEdit.Caption = 'Save'
			This.Caption = 'Abort'
		ELSE
			*Abort
			
			ThisForm.chkUTPass.ReadOnly = .T.
			ThisForm.txtOperator.ReadOnly = .T.
		
			ThisForm.grdUT.Enabled = .T.	
		
			ThisForm.cmdEdit.Caption = 'Edit'
			This.Caption = 'New'
			
			PRIVATE nLogID, cTable
			nLogID		= ThisForm.nLogID
			cTable	= ThisForm.cTable
			ThisForm.searchNow(nLogID,cTable)
			
		ENDIF
	ENDPROC

	PROCEDURE grdUT.ActivateCell
		LPARAMETERS nRow, nCol
		
	ENDPROC

	PROCEDURE grdUT.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshUT()
	ENDPROC

ENDDEFINE
