DEFINE CLASS frmutscan AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdExit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdUT" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtOperator" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtWho" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtWhen" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="edtComment" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdNew" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkUTPass" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdEdit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdDelete" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: refreshut
		*m: searchnow
		*p: csearchtable		&& Parameter, name of table to searc.
		*p: ctable
		*p: nconnhandle
		*p: nid
		*p: nlogid
		*p: tablename
	*</DefinedPropArrayMethod>

	*<PropValue>
		AlwaysOnTop = .T.
		AutoCenter = .T.
		Caption = "UT Scan:"
		Closable = .T.
		ControlBox = .F.
		csearchtable = ""
		ctable = 
		DataSession = 2
		DoCreate = .T.
		Height = 338
		Name = "frmUTscan"
		nconnhandle = 0
		nid = 0
		nlogid = <fb2p_value>0&#13;</fb2p_value>
		tablename = .F.
		Width = 606
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'chkUTPass' AS checkbox WITH ;
		Alignment = 0, ;
