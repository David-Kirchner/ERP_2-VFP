	PROCEDURE Init
		PARAMETER pSOitem
		*DO FORM Forms\ShowSelectedProcess WITH SOitem
		
		PRIVATE cSOitem
		cSOitem =''
		
		IF TYPE("pSOitem")="C"
			cSOitem = pSOitem 
		ENDIF
		
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		PRIVATE nConn
		nConn = get_SQLSTRINGCONNECT()
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.StockLst_Process SP "
		cSQL = cSQL + " WHERE SP.SOitem = dbo.ProperPO('"+cSOitem+"')"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT * FROM dbo.BrokerLst_Process BP "
		cSQL = cSQL + " WHERE BP.SOitem = dbo.ProperPO('"+cSOitem+"')"
		
		
		IF USED("StockLst_Process")
			SELECT StockLst_Process
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'StockLst_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'StockLst_Process')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, 'StockLst_Process' )
			RETURN
		ENDIF
		
		
		SELECT StockLst_Process
		INDEX ON SOitem TAG SOitem
		GO TOP
		SCATTER MEMVAR 
		This.Refresh
		
		PUBLIC ARRAY gaProcess(1,1)
		IF nID_Detail = 0
		*	SELECT SOitem FROM StockLst_Process INTO ARRAY gaProcess ORDER BY SOitem 
			gaProcess(1,1) = "None"
		ELSE
			SELECT SOitem FROM StockLst_Process WHERE ID_Detail = nID_Detail INTO ARRAY gaProcess ORDER BY SOitem 
		ENDIF
		
		ThisForm.lstItems.RowSource = "gaProcess"
		ThisForm.lstItems.ColumnCount = ALEN(gaProcess,1)
		
		IF ALEN(gaProcess,1) > 0
			ThisForm.lstItems.Value = gaProcess(1,1)
			ThisForm.lstItems.SetFocus
		ENDIF
		
		MasterLB		= 0
		MasterProcLB	= 0
		DetailLB		= 0
		DetailProcLB	= 0
		
		cSQL_SP = "{CALL P_Process_LBs ("
		cSQL_SP = cSQL_SP +STR(nID_Detail)
		cSQL_SP = cSQL_SP +",?@MasterLB"
		cSQL_SP = cSQL_SP +",?@MasterProcLB"
		cSQL_SP = cSQL_SP +",?@DetailLB"
		cSQL_SP = cSQL_SP +",?@DetailProcLB"
		cSQL_SP = cSQL_SP +")}"
		
		nSQLEXEC = SQLEXEC(nConn, cSQL_SP )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL_SP )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_SP, ThisForm.ConnHandle, nSQLEXEC, '' )
		ELSE
			*Display
			IF NOT ISNULL(MasterLB)
				ThisForm.lblMasterLB.Caption = ALLTRIM(STR(MasterLB))
			ENDIF
			IF NOT ISNULL(MasterProcLB)
				ThisForm.lblMasterProcLB.Caption = ALLTRIM(STR(MasterProcLB))
			ENDIF
			IF NOT ISNULL(MasterLB) AND NOT ISNULL(MasterProcLB)
				ThisForm.lblMasterBalance.Caption = ALLTRIM(STR(MasterLB-MasterProcLB))
				ThisForm.lblMasterB.Caption = "Balance"
				IF (MasterLB-MasterProcLB) < 0
					ThisForm.lblMasterB.ForeColor = RGB(255,0,0)
					ThisForm.lblMasterBalance.ForeColor = RGB(255,0,0)
				ENDIF
			ENDIF
			IF NOT ISNULL(DetailLB)
				ThisForm.lblDetailLB.Caption = ALLTRIM(STR(DetailLB))
			ENDIF
			IF NOT ISNULL(DetailProcLB)
				ThisForm.lblDetailProcLB.Caption = ALLTRIM(STR(DetailProcLB))
			ENDIF
			IF NOT ISNULL(DetailLB) AND NOT ISNULL(DetailProcLB)
				ThisForm.lblDetailBalance.Caption = ALLTRIM(STR(DetailLB-DetailProcLB))
				ThisForm.lblDetailB.Caption = "Balance"
				IF (DetailLB-DetailProcLB) < 0
					ThisForm.lblDetailB.ForeColor = RGB(255,0,0)
					ThisForm.lblDetailBalance.ForeColor = RGB(255,0,0)
				ENDIF
			ENDIF
		ENDIF
		
		SQLDISCONNECT(nConn)
		
		ThisForm.AlwaysOnTop = .T.
		ThisForm.AlwaysOnTop = .F.
		
	ENDPROC

	PROCEDURE Unload
		IF NOT EMPTY( ThisForm.PrevTable )
			IF USED( ThisForm.PrevTable )
				SELECT (ThisForm.PrevTable)
			ENDIF
		ENDIF
		
		*IF WEXIST("frmStockLst_SQL_Quotes")
		*	ACTIVATE WINDOW frmStockLst_SQL_Quotes
		*ENDIF
		
	ENDPROC

	PROCEDURE AllowSub1.Valid
		DO CASE
		CASE ISNULL(This.Value)
			RETURN .T.
		CASE EMPTY(This.Value)
			RETURN .T.
		CASE UPPER(This.Value) = "N"
			RETURN .T.
		CASE UPPER(This.Value) = "Y"
			RETURN .T.
		CASE UPPER(This.Value) = "T" 
			This.Value = "Y"
			RETURN .T.
		CASE UPPER(This.Value) = "F"
			This.Value = "N"
			RETURN .T.
		OTHERWISE		
			RETURN .F.
		ENDCASE
	ENDPROC

	PROCEDURE cmdDelete.Valid
		*cmdDelete.Valid -Unselect
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail_Process
		
		PRIVATE nID_Detail_Process
		nID_Detail_Process = ThisForm.ID_Detail_Process1.Value
		
		PRIVATE nConn
		nConn = get_SQLSTRINGCONNECT()
		
		PRIVATE lExit
		lExit = .F.
		
		IF TYPE("nID_Detail_Process") = "N"
		
			IF EMPTY(nID_Detail_Process)
				MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
			ELSE
				*DO FORM Forms\StockLst_Process WITH "DELETE", nID_Detail_Process TO nReturn
				PRIVATE cMach_User, cLoginUserName
				cMach_User = SYS(0)
				cLoginUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		
				IF USED('tmpCntProcess')
					USE IN tmpCntProcess
				ENDIF
				SELECT 0
				IF ThisForm.lblTable.Caption = "StockLst"
					cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.StockLst_Process WHERE ID_Detail_Process = "+STR(nID_Detail_Process )
				ELSE
					cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.BrokerLst_Process WHERE ID_Detail_Process = "+STR(nID_Detail_Process )
				ENDIf
				cSQL = cSQL + " AND SalesPerson = '"+cLoginUserName+"'"
				cSQL = cSQL + " AND Process_ID = 'SELECTED' "
				
				nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpCntProcess')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(nConn, cSQL, 'tmpCntProcess')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, nConn, nSQLEXEC, 'tmpCntProcess' )
					SQLDISCONNECT(nConn)
					RETURN
				ENDIF
		
				IF USED('tmpCntProcess')
					
					IF tmpCntProcess.Cntd > 0
						*User has permision to delete his own Process
						IF ThisForm.lblTable.Caption = "StockLst"
							cSQL = "DELETE FROM dbo.StockLst_Process WHERE " 
						ELSE
							cSQL = "DELETE FROM dbo.BrokerLst_Process WHERE " 
						ENDIF
						cSQL = cSQL + " ID_Detail_Process = "+STR(nID_Detail_Process)
						cSQL = cSQL + " AND SalesPerson = '"+cLoginUserName+"'"
						cSQL = cSQL + " AND Process_ID = 'SELECTED' "
						
						nSQLEXEC = SQLEXEC(nConn, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(nConn, cSQL )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, nConn, nSQLEXEC )
						ELSE
							PRIVATE cTable
							cTable = ThisForm.lblTable.Caption 
							MESSAGEBOX("Close and reopen "+cTable+" to refresh data.",48,"Deleted!")
							lExit = .T.
						ENDIF
					ELSE
						MESSAGEBOX('Did not find any record you have PERMISSION to Delete',48,'No Delete')
					ENDIF
				USE IN tmpCntProcess
				ENDIF
			ENDIF
		ENDIF
		
		IF nConn > 0
			SQLDISCONNECT(nConn)
		ENDIF
		
		IF lExit 
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE cmdEdit.Valid
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail_Process
		
		PRIVATE nID_Detail_Process
		nID_Detail_Process = ThisForm.ID_Detail_Process1.Value
		
		IF TYPE("nID_Detail_Process") = "N"
		
			IF EMPTY(nID_Detail_Process)
				MESSAGEBOX("Cannot Edit"+CHR(13)+"Add First",0,"No record")
			ELSE
				IF ThisForm.lblTable.Caption = "StockLst"
											*cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem
					DO FORM Forms\StockLst_Process WITH "EDIT",nID_Detail_Process,'','','',0,0,'','','StockLst','' TO nReturn
				ELSE
					DO FORM Forms\StockLst_Process WITH "EDIT",nID_Detail_Process,'','','',0,0,'','','BrokerLst','' TO nReturn
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdShowSO.Click
		PRIVATE cSOitem
		
		cSOitem = ThisForm.SOitem1.Value
		
		IF TYPE("cSOitem") = "C"
			IF EMPTY(cSOitem)
				MESSAGEBOX("Cannot Show",0,"No record")
			ELSE
				DO FORM Forms\ShowvSOitem WITH cSOitem
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE lstItems.Click
		PRIVATE cSOitem
		cSOitem = This.Value
		
		SEEK cSOitem ORDER SOitem IN StockLst_Process
		IF FOUND("StockLst_Process")
			SELECT StockLst_Process
			SCATTER MEMVAR 
		ELSE
			SCATTER MEMVAR BLANK 
		ENDIF
		
		This.Parent.REFRESH
		
	ENDPROC

ENDDEFINE
