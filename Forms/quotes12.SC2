	PROCEDURE frmPMI.cmdNext.Valid
		SELECT Quotes
		IF !EOF()
			SKIP 1 IN Quotes
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN Quotes
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE frmPMI.cmdPrev.Valid
		SELECT Quotes
		IF !BOF()
			SKIP -1 IN Quotes
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file' NOWAIT
			GO TOP IN Quotes
		ENDIF
		*	SCATTER MEMO MEMVAR
		
		ThisFormSet.QuotesRecordChanged()
		
		ThisForm.refresh
	ENDPROC

	PROCEDURE frmPMI.cmdSave.Click
		
		PRIVATE nQuotes_ID 
		nQuotes_ID = Quotes.ID
		PRIVATE nPMIi, nPMIc, cGp
		nPMIi = PrepareSQLnum(ThisForm.spnPMIi.Value,'PMIi',-1)
		nPMIc = PrepareSQLnum(ThisForm.spnPMIc.Value,'PMIc',-1)
		cGp = PrepareSQLtxt(ThisForm.cmbGp.Value,'Gp',1)
		
		PRIVATE nAQ_ID_Orig, nAQ_ID_Curr
		nAQ_ID_Orig = PrepareSQLnum(ThisForm.lblOrig.Caption,'AQ_ID_Orig',-3)
		nAQ_ID_Curr = Quotes.ID 
		
		PRIVATE nPMIcount
		nPMIcount = 0
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD "
		cSQL = cSQL + " FROM dbo.Quotes_PMI WITH(NOLOCK) "
		cSQL = cSQL + " WHERE AQ_ID_Curr = "+STR(nQuotes_ID)
		
		IF USED("tmpPMIcount")
			USE IN tmpPMIcount
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpPMIcount')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpPMIcount')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPMIcount")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPMIcount")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'tmpPMIcount')
		ENDIF
		
		IF USED('tmpPMIcount')
			IF RECCOUNT('tmpPMIcount') > 0
				nPMIcount = tmpPMIcount.CNTD
			ENDIF
			USE IN tmpPMIcount
		ENDIF
		
		IF nPMIcount = 0
			*not found
			IF nPMIi + nPMIc = 0
				*Nothing to Add
				cSQL = "SELECT ''"
			ELSE
				cSQL = "INSERT INTO dbo.Quotes_PMI "
				cSQL = cSQL +" (AQ_ID_Orig, AQ_ID_Curr, PMIi, PMIc, Gp ) VALUES ("
				cSQL = cSQL +" "+STR(nAQ_ID_Orig)+""
				cSQL = cSQL +","+STR(nAQ_ID_Curr)+""
				cSQL = cSQL +","+STR(nPMIi)
				cSQL = cSQL +","+STR(nPMIc)
				cSQL = cSQL +",'"+cGp+"')"
			ENDIF
		ELSE
			*Found
			IF nPMIi + nPMIc = 0
				*Delete
				cSQL = "DELETE FROM dbo.Quotes_PMI "
				cSQL = cSQL + " WHERE AQ_ID_Curr = "+STR(nQuotes_ID)
			ELSE
				*Update
				cSQL = "UPDATE dbo.Quotes_PMI SET "
				cSQL = cSQL + " PMIi="+STR(nPMIi)
				cSQL = cSQL + ",PMIc="+STR(nPMIc)
				cSQL = cSQL + ",Gp='"+cGp+"'"
				cSQL = cSQL + " WHERE AQ_ID_Curr = "+STR(nQuotes_ID)
			ENDIF
		ENDIF
		
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, gnConnHandle, nSQLEXEC )
		ENDIF
		
		*	ThisForm.Visible = .F.
		WAIT WINDOW "Saved" NOWAIT
			
		*ThisFormSet.ShowPricingPMI()
		ThisFormSet.Quotes.Pf1.pagePricing.txtPMIi.Value = nPMIi
		ThisFormSet.Quotes.Pf1.pagePricing.txtPMIc.Value = nPMIc
		
		
	ENDPROC

