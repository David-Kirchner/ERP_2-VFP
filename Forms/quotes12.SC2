	PROCEDURE frmSources.cmdOldStyle.Click
		PRIVATE cAlloy
		cAlloy = ALLTRIM(ThisFormSet.Quotes.AllOY1.Value)
		
		
			cSQL = "SELECT SPH.Company,Alloy,Alloy_AKA,UNS,Spec,f10,f20,f30,f40,f60,f65,f70,f75,Stk,MK,Sources.Notes "
			cSQL = cSQL + " ,SPH.Phone,SPH.Fax,SPH.Person,SPH.Email "
			cSQL = cSQL + " ,VC.Branch,VC.Contact,VC.Phone,VC.Fax,VC.Email "
			cSQL = cSQL + "  FROM dbo.Sources WITH(NOLOCK) "
			cSQL = cSQL + "  LEFT JOIN dbo.SourcePH SPH WITH(NOLOCK) ON Sources.ID = SPH.ID "
			cSQL = cSQL + "  LEFT JOIN dbo.VendorContact VC WITH(NOLOCK) ON VC.ContactID = SPH.ContactID "
			cSQL = cSQL + "  WHERE Sources.Alloy = '"+cAlloy+"'"
			cSQL = cSQL + "  ORDER BY Sources.Alloy, SPH.Company "
			 
			IF USED("vSources")
				USE IN vSources
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'vSources')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'vSources')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "vSources")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "vSources")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'vSources')
			ENDIF
		
			IF !USED('vSources')
				=MESSAGEBOX('vSources data not found.',16,"No Data")
			*	WAIT WINDOW 'Returning to program' NOWAIT
				RETURN
			ENDIF
			IF VARTYPE(vSources.Alloy) != "C"
				=MESSAGEBOX('vSources data not found.',16,"No Data")
			*	WAIT WINDOW 'Returning to program' NOWAIT
				RETURN
			ENDIF
		
			*SET ORDER TO TAG alloy
			SELECT vSources
			Activate SCREEN
			MODIFY MEMO notes NOWAIT
			BROW LAST NOEDIT NOAPP NODELETE TITLE 'Sources' &&NORMAL  &&TIMEOUT 240  &&Alloy is the clean field
		
			IF USED('vSources')
				USE IN vSources
			ENDIF
	ENDPROC

	PROCEDURE frmSources.cmdSGetVendor.Click
		Private nNewVendCode, nOldVendCode, lcCurrTable, cCompany
		nNewVendCode = 0
		nOldVendCode = PrepareSQLnum(ThisForm.txtSVendCode.Value,'VendCode',-3)
		lcCurrTable = ALIAS()
		cCompany = ALLTRIM( PrepareSQLtxt(ThisForm.txtSCompany.Value,'Company',30) )
		
		IF EMPTY(cCompany)
			MESSAGEBOX("Enter a Company first",48,"No Company")
			RETURN .F.
		ELSE
			DO FORM Forms\SearchForm WITH "Vendor", cCompany  TO nNewVendCode
			IF USED('TmpSearch')
				USE IN TmpSearch
				IF NOT EMPTY(lcCurrTable)
					SELECT (lcCurrTable)
				ENDIF
			ENDIF
		ENDIF
		
		IF nNewVendCode > 0
			ThisForm.txtSVendCode.Value = nNewVendCode 
		ELSE
			IF nOldVendCode > 0
				IF MESSAGEBOX("Do you wish to remove the VendCode (Y)?",4+16,"No Vendor Code!") = 6
					ThisForm.txtSVendCode.Value = 0
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

