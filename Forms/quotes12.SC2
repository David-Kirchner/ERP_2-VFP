	PROCEDURE frmRemoveORDER.cmdYes.Click
		
		PRIVATE cSQL,nSQLEXEC, lRollBack
		lRollBack = .F.
		PRIVATE nSalesNum
		*nSalesNum = PrepareSQLnum(ThisFormset.nSalesNum,'SalesNum',-3)
		nSalesNum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		
		
		IF nSalesNum = 0
			= MESSAGEBOX('Cannot Cancel', 16, 'Bad SalesNum')
			RETURN .F.
		ENDIF
		
		IF gnConnHandle < 1
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			RETURN .F.
		ENDIF
		
		TrackMess("Attempting to Remove SalesNum "+ALLTRIM(STR(nSalesNum)))
		RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Attempting to Remove SalesNum "+ALLTRIM(STR(nSalesNum)) )
		
		
		*!*	IF Cancel_SO( nSalesNum, gnConnHandle, "REMOVE")
		*!*		*Checks for Allowed and have Permission
		*!*		*Records the SO Reason.
		*!*	ELSE
		*!*		MESSAGEBOX('Cannot REMOVE', 16, 'Remove Error')
		*!*		RETURN
		*!*	ENDIF
		
		*--REMOVE_SO_Permission 
		IF Allow_REMOVE_SO( nSalesNum, gnConnHandle )
		
			*********
			*Check for history that prevents a Delete
			IF USED('tmpUserTrack')
				USE IN tmpUserTrack
			ENDIF
			SELECT 0
		
			cSQL = "SELECT COUNT(*) AS CNTD FROM HPAlloyNR.dbo.UserTrack WITH(NOLOCK)"
			cSQL = cSQL + " WHERE MESS1 LIKE 'Sales_No ShopRecv now True for SalesNum "+ALLTRIM(STR(nSalesNum))+"%'"
		
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpUserTrack' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL,'tmpUserTrack' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpUserTrack")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpUserTrack")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				IF NOT SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'tmpUserTrack')
					RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
				ENDIF
			ENDIF
			
			IF USED('tmpUserTrack')
				IF RECCOUNT('tmpUserTrack') > 0
					IF tmpUserTrack.CNTD > 0
						MESSAGEBOX("Cannot REMOVE"+CHR(13)+"Found a history of Shop receiving the Paper work!", 16, 'Remove Error')
						TrackMess("Failed to Remove SalesNum "+ALLTRIM(STR(nSalesNum))+", Found a history of Shop receiving the Paper work!")
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Failed to Remove SalesNum "+ALLTRIM(STR(nSalesNum)) +", Found a history of Shop receiving the Paper work!")
						USE IN tmpUserTrack
						RETURN .F.
					ENDIF
					USE IN tmpUserTrack
				ENDIF
			ENDIF
			
			****
			*If you cannot Cancel, then do not Delete
			IF NOT Cancel_SO(nSalesNum, gnConnHandle, "DELETE" )
				MESSAGEBOX('Cannot REMOVE', 16, 'Remove Error')
				TrackMess("Cannot Remove SalesNum "+ALLTRIM(STR(nSalesNum)))
				RETURN .F.
			ENDIF
			****
		
		ELSE
			MESSAGEBOX('Cannot REMOVE', 16, 'Remove Error')
			TrackMess("Cannot Remove SalesNum "+ALLTRIM(STR(nSalesNum)))
			RETURN
		ENDIF
		
		****************
		*collect SOitems
		IF USED('tmpSOitems')
			USE IN tmpSOitems
		ENDIF
		SELECT 0
		
		cSQL = "SELECT dbo.f_ProperSOitem(SOitem) AS SOitem FROM dbo.Sales WITH(NOLOCK)"
		cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		*		cSQL = cSQL + " AND Cncld = '0'"
		*		cSQL = cSQL + ", ShopRecv='1'"
		
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSOitems' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL,'tmpSOitems' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOitems")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			IF NOT SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, '')
				RecordError(nSQLEXEC,"SQL Error","Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
			ENDIF
		ENDIF
		
		****
		
		= SQLSETPROP(gnConnHandle, 'Transactions', 2) && Manual transactions
		
		cSQL = "UPDATE dbo.ALLQuotes SET "
		cSQL = cSQL + " SalesNum = 0,"
		cSQL = cSQL + "SoItem = '',"
		cSQL = cSQL + "Item = 0,"
		cSQL = cSQL + "HPAPO = 0,"
		cSQL = cSQL + "BUYFROM = '',"
		cSQL = cSQL + "BuyFrom2 = '',"
		cSQL = cSQL + "BuyCost = 0,"
		cSQL = cSQL + "HPAPO2 = 0,"
		cSQL = cSQL + "PO_Num = '',"
		cSQL = cSQL + "SaleDate = ''"  &&+CTOD("  /  /  ")
		cSQL = cSQL + " WHERE SalesNum ="+ALLTRIM(STR( nSalesNum ))
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
			lRollBack = .T.
		ENDIF
		
		*Do not forget to change local Quotes dbf
		*see bottom
																	
		IF NOT lRollBack 
			cSQL = "DELETE FROM dbo.Sales WHERE SalesNum = "+STR(nSalesNum)
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
				lRollBack = .T.
			ELSE
		
			ENDIF
		ENDIF
		
		IF NOT lRollBack 
			cSQL = "DELETE FROM Router.dbo.rtr WHERE ID IN ("
			cSQL = cSQL + " SELECT DISTINCT ID FROM Router.dbo.rtr "
			cSQL = cSQL + " INNER JOIN dbo.Sales S ON rtr.SOitem = S.SOitem"
			cSQL = cSQL + " WHERE S.SalesNum = "+STR(nSalesNum)
			cSQL = cSQL + " ) "
		*	Send_HTML_Email( 'DavidKirchner@yahoo.com','David.Kirchner@hpalloy.com','Test Delete Router.dbo.rtr','Remove Sales Order'+CHR(13)+cSQL ,gnConnHandle,.T.,.T.)
		
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
		*		lRollBack = .T.	--rtr is not critical yet!
			ENDIF
		ENDIF
		
		IF NOT lRollBack 
			cSQL = "DELETE FROM Router.dbo.rtr_Detail WHERE rtr_ID IN ("
			cSQL = cSQL + " SELECT DISTINCT ID FROM Router.dbo.rtr "
			cSQL = cSQL + " INNER JOIN dbo.Sales S ON rtr.SOitem = S.SOitem "
			cSQL = cSQL + " WHERE S.SalesNum = "+STR(nSalesNum)
			cSQL = cSQL + " ) "
		
			*Send_HTML_Email( 'DavidKirchner@yahoo.com','David.Kirchner@hpalloy.com','Test Delete Router.dbo.rtr_Detail','Remove Sales Order'+CHR(13)+cSQL ,gnConnHandle,.T.,.T.)
			
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
			ENDDO
