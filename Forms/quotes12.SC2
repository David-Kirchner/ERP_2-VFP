					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
				lRollBack = .T.
			ENDIF
		ENDIF
		
		IF NOT lRollBack 
			cSQL = "DELETE FROM dbo.SOitem_Hrs WHERE SalesNum = "+STR(nSalesNum)
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
				lRollBack = .T.
			ENDIF
		ENDIF
		
		IF NOT lRollBack 
			cSQL = "DELETE FROM dbo.Ship WHERE SalesNum = "+STR(nSalesNum)
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
				lRollBack = .T.
			ENDIF
		ENDIF
		
		IF NOT lRollBack 
			cSQL = "DELETE FROM dbo.Mach_Detail WHERE SalesNum = "+STR(nSalesNum)
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
				lRollBack = .T.
			ENDIF
		ENDIF
		
		IF NOT lRollBack 
			cSQL = "DELETE FROM dbo.Mach_Shop WHERE SalesNum = "+STR(nSalesNum)
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
				lRollBack = .T.
			ENDIF
		ENDIF
		
		IF NOT lRollBack 
			IF NOT Remove_Process_for_Cancelled_SO(nSalesNum,gnConnHandle)
				lRollBack = .T.
			ENDIF
		ENDIF
		
		********************
		*now remove by item
		*
		IF USED('tmpSOitems')
			IF RECCOUNT('tmpSOitems') > 0
				PRIVATE cSOitem
				SELECT tmpSOitems
				SCAN
					cSOitem = PrepareSQLtxt(tmpSOitems.SOitem,'SOitem',10)
					
					*This was probably delete with SalesNum!
					cSQL = "DELETE FROM dbo.Sales WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
						lRollBack = .T.
					ENDIF
					**
					cSQL = "DELETE FROM dbo.Sales_Detail WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
						*lRollBack = .T.
					ENDIF
					**
					cSQL = "DELETE FROM dbo.Sales_Hold_Status WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL,gnConnHandle, nSQLEXEC, '')
						*lRollBack = .T.
					ENDIF
					**
					SELECT tmpSOitems
				ENDSCAN
			ENDIF
			USE IN tmpSOitems
		ENDIF
		
		
		
		IF lRollBack 
			*SQLEXEC(gnConnHandle, "ROLLBACK TRANSACTION RemoveSO") --names the Transaction
			
			SQLROLLBACK(gnConnHandle)
			= SQLSETPROP(gnConnHandle, 'Transactions', 1) && Auto transactions
			MESSAGEBOX( "The SO:"+ALLTRIM(STR(nSalesNum))+" could not be removed because of error.",16,"Removal failed!")
			
			TrackMess("Remove SalesNum "+ALLTRIM(STR(nSalesNum))+" Failed!")
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Remove SalesNum "+ALLTRIM(STR(nSalesNum))+" Failed!" )
			
		ELSE
			
			*SQLEXEC(gnConnHandle, "COMMIT TRANSACTION RemoveSO") --names the Transaction
			= SQLCOMMIT(gnConnHandle)
			= SQLSETPROP(gnConnHandle, 'Transactions', 1) && Auto transactions
			
			TrackMess("Removed Sales Order:"+ALLTRIM(STR(nSalesNum)) )
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Removed Sales Order:"+ALLTRIM(STR(nSalesNum)) )
				
			*Update Current view
			SELECT Quotes
			REPLACE Quotes.SalesNum WITH 0
			REPLACE Quotes.SoItem WITH ''
			REPLACE Quotes.Item WITH 0
			REPLACE Quotes.HPAPO WITH 0
			REPLACE Quotes.BUYFROM WITH ''
			REPLACE Quotes.BuyFrom2 WITH ''
			REPLACE Quotes.BuyCost WITH 0
			REPLACE Quotes.HPAPO2 WITH 0
			REPLACE Quotes.PO_Num WITH ''
		*	REPLACE Quotes.SaleDate WITH ''
		ENDIF
		
		IF NOT lRollBack 
			IF USED('tID_Detail_Pr')
				USE IN tID_Detail_Pr
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT SOitem, 'S' AS TBL FROM dbo.StockLst_Process WITH(NOLOCK) "
			cSQL = cSQL +" WHERE SOitem LIKE '%"+STR(nSalesNum)+"-%' "
			cSQL = cSQL +" UNION "
			cSQL = cSQL +" SELECT SOitem, 'B' AS TBL FROM dbo.BrokerLst_Process WITH(NOLOCK) "
			cSQL = cSQL +" WHERE SOitem LIKE '%"+STR(nSalesNum)+"-%' "
			cSQL = cSQL +" UNION "
			cSQL = cSQL +" SELECT SOitem, 'W' AS TBL FROM dbo.WIPLst_Process WITH(NOLOCK) "
			cSQL = cSQL +" WHERE SOitem LIKE '%"+STR(nSalesNum)+"-%' "
		
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tID_Detail_Pr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tID_Detail_Pr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tID_Detail_Pr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tID_Detail_Pr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try same query again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tID_Detail_Pr')
			ENDIF
		
			IF USED('tID_Detail_Pr')
				IF RECCOUNT('tID_Detail_Pr') > 0
					PRIVATE cSOitem
					SCAN
						cSOitem = tID_Detail_Pr.SOitem 
						IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
							IF Cancel_Detail_Process_SOitem(cSOitem,gnConnHandle) &&nSalesNum
								*Calls Remove_ID_Detail_Process(nID_Detail_Process, "SOitem", cSOitem, cTBL, nConn, 'CANCELLED')
								
								*Remove_Process_for_Cancelled_SO 
								
							ELSE			
								*Could not Delete
							ENDIF
						ENDIF
					ENDSCAN
				ENDIF
				USE IN tID_Detail_Pr
			ENDIF
		
		ENDIF
		
		IF NOT lRollBack 
			*Done After Lock is released.
			Save_Sales_Status( nSalesNum, "Delete", "Deleted SO from Quotes, Remove Sales Order screen", gnConnHandle)
			*Save_SOitem_Status( cSOitem, nSO, cWhat, cComment, gnConnHandle )
		
		ENDIF
		
		IF NOT lRollBack 
			SELECT Quotes
		
			*Update the view
			THISFORMSET.Quotes.LOCKSCREEN = .T.
			SELECT Quotes
			nCurInqNum = Quotes.InqNumP
			
			USE IN Quotes
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
			ENDIF
		
			SELECT Quotes
			LOCATE FOR InqNumP = nCurInqNum
			*ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
			ThisFormSet.QUOTES.cboTgq82.Value = 1
			
			THISFORMSET.Quotes.LOCKSCREEN = .F.
			
			ThisFormSet.QUOTES.pf1.PageSales.SetFocus()
			THISFORMSET.QuotesRecordChanged()
			
			*This.Parent.Parent.PageStatus.SetFocus()
			
		
		ENDIF
		
		THISFORMSET.Quotes.LOCKSCREEN = .F.
		
		*ThisForm.Release
		ThisFormSet.Removeorders_destroy
		
	ENDPROC

	PROCEDURE frmRFQ.cmdCancel.Click
		
		ThisForm.Visible = .f.
	ENDPROC

	PROCEDURE frmRFQ.cmdSave.Click
		IF ThisFormSet.SupplierQuoteCheck()
			PRIVATE nPieces, nPU, nWeight, nUnitPriceOld
		
		
			PRIVATE nID
			PRIVATE cSupplier,cContact,cNotes,nUnitPrice,nQuantity,nPcPrice,dDueDate,dSaveDate
			PRIVATE cInqnumP,cAlloy, cForm, cCC, cCL, nThck, nSz2, nSz3
			nID 		= PrepareSQLnum(ThisForm.lblID.Caption,'ID',-3)
			cSupplier	= PrepareSQLtxt(ThisForm.txtSupplier.Value,'Supplier',30)
			cContact	= PrepareSQLtxt(ThisForm.txtContact.Value,'Contact',30)
			cNotes		= PrepareSQLtxt(ThisForm.txtNotes.Value,'Notes',30)
			nUnitPrice	= PrepareSQLnum(ThisForm.txtUnitPrice.Value,'UnitPrice',-5)
			nQuantity	= PrepareSQLnum(ThisForm.txtQuantity.Value,'Quantity',9,1)
			nPcPrice	= PrepareSQLnum(ThisForm.txtPcPrice.Value,'PcPrice',9,2)
			dDueDate	= PrepareSQLdate(ThisForm.txtDueDate.Value,'DueDate')
		
			dSaveDate	= DATE() &&PrepareSQLdate('','SaveDate')
		
			cInqNumP= PrepareSQLtxt(Quotes.InqNumP,'InqNumP',9)
			cAlloy	= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
			cForm	= PrepareSQLtxt(Quotes.Form,'From',2) 
			cCC		= PrepareSQLtxt(Quotes.CC,'CC',1) 
			cCL		= PrepareSQLtxt(Quotes.CL,'CL',1) 
			nThck	= PrepareSQLnum(Quotes.Thck,'Thck',10,4)
			nSz2	= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
			nSz3	= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		
			nUnitPriceOld = nUnitPrice 
			IF nUnitPrice = 0 AND nQuantity > 1 AND nPcPrice > 0
				nUnitPrice = nPcPrice / nQuantity 
			ENDIF
			IF nUnitPrice > 0 AND nQuantity > 1 AND nPcPrice > 0
				nPieces = PrepareSQLnum(quotes.pieces,'Pieces',-3)
				nPU 	= GetPUfromForm(quotes.Form, gnConnHandle) 
				nWeight	= PrepareSQLnum(quotes.Weight,'Weight',9,1)
				IF nPU = 1 AND nWeight > 1
					nUnitPrice = (nPcPrice * nPieces) / nWeight
					IF (nUnitPriceOld+10)*1.15 < (nUnitPrice+10) OR (nUnitPriceOld+10) > (nUnitPrice+10)*1.15
						MESSAGEBOX("UnitPrice is to be in $/LB"+CHR(13)+"Calculated (PcPrice * Pieces) / Weight"+CHR(13)+"Calculated $/LB to be "+ALLTRIM(STR(nUnitPrice)),0+64,"Saving calculate number.")
					ENDIF
				ENDIF
				IF nPU = 3 AND nPcPrice > 0
					nUnitPrice = nPcPrice
				ENDIF
			ENDIF
			
			IF nID = 0
				mSQL = "INSERT INTO dbo.SupplierQuotes "
				mSQL = mSQL +" (Supplier,Contact,Notes,UnitPrice,PcPrice,Quantity,DueDate,SaveDate"
				mSQL = mSQL +",InqNumP,Alloy,Form,CC,CL,Thck,Sz2,Sz3) VALUES "
				mSQL = mSQL +" ('"+cSupplier+"'"
				mSQL = mSQL +", '"+cContact+"'"
				mSQL = mSQL +", '"+cNotes+"'"
				mSQL = mSQL +", "+STR(nUnitPrice,12,4)+""
				mSQL = mSQL +", "+STR(nQuantity,9,1)+""
				mSQL = mSQL +", "+STR(nPcPrice,12,4)+""
				mSQL = mSQL +", '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
				mSQL = mSQL +", '"+IIF(EMPTY(dSaveDate),'',DTOC(dSaveDate))+"'"
				mSQL = mSQL +", '"+cInqNumP+"'"
				mSQL = mSQL +", '"+cAlloy+"'"
				mSQL = mSQL +", '"+cForm+"'"
				mSQL = mSQL +", '"+cCC+"'"
				mSQL = mSQL +", '"+cCL+"'"
				mSQL = mSQL +", "+STR(nThck,10,4)
				mSQL = mSQL +", "+STR(nSz2,9,3)
				mSQL = mSQL +", "+STR(nSz3,9,3)+")"
		
			ELSE
				*Have ID, Update
				mSQL = "UPDATE dbo.SupplierQuotes SET "
				mSQL = mSQL +" Supplier='"+cSupplier+"'"
				mSQL = mSQL +", Contact='"+cContact+"'"
				mSQL = mSQL +", Notes='"+cNotes+"'"
				mSQL = mSQL +", UnitPrice="+STR(nUnitPrice,12,4)+""
				mSQL = mSQL +", Quantity="+STR(nQuantity,9,1)+""
				mSQL = mSQL +", PcPrice="+STR(nPcPrice,12,4)+""
				IF NOT EMPTY(dDueDate)
					mSQL = mSQL +", DueDate='"+DTOC(dDueDate)+"'"
				ENDIF
			*	mSQL = mSQL +", SaveDate='"+DTOC(dSaveDate)+"'"
				mSQL = mSQL +", INQnumP='"+cINQnumP+"'"
				mSQL = mSQL +", Alloy='"+cAlloy+"'"
				mSQL = mSQL +", Form='"+cForm+"'"
				mSQL = mSQL +", CC='"+cCC+"'"
				mSQL = mSQL +", CL='"+cCL+"'"
				mSQL = mSQL +", Thck="+STR(nThck,10,4)
				mSQL = mSQL +", Sz2="+STR(nSz2,9,3)
				mSQL = mSQL +", Sz3="+STR(nSz3,9,3)+""
				mSQL = mSQL +" WHERE ID = "+STR(nID)
			ENDIF
		
			nSQLEXEC = SQLEXEC( gnConnHandle, mSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, mSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, mSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, mSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(mSQL, gnConnHandle, nSQLEXEC, '')
			ENDIF
		
			ThisForm.Visible = .F.
		
			*ThisFormSet.ShowSources()
			ThisFormSet.QuotesRecordChanged()
		
		
		ENDIF
	ENDPROC

	PROCEDURE frmRFQ.lblDueDate.Click
		PRIVATE dDate1,dDate2
		
		*dDate1 = PrepareSQLdate(ThisForm.txtDueDate.Value,'DueDate')
		dDate1 = PrepareSQLdate(ThisForm.txtDueDate.Value,'DueDate',.F.,.T.)
		
		
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		dDate2 = PrepareSQLdate(dDate2,'DueDate',.F.,.T.)
		
		ThisForm.txtDueDate.Value = dDate2
		ThisForm.txtDueDate.Refresh
	ENDPROC

	PROCEDURE frmRFQ.txtContact.InteractiveChange
		PRIVATE lSearchFound
		lSearchFound = .F.
		
		PRIVATE lnInsertionPt, lcSearchStr, lcSearchStrSQL, lcFoundStr
		lnInsertionPt = IIF(this.SelStart=0,10,this.SelStart)
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcSearchStrSQL = STRTRAN(lcSearchStr,"'","''")
		lcFoundStr = ''
		
		PRIVATE cSupplier
		cSupplier = ThisForm.txtSupplier.Value
		
		IF !EMPTY(cSupplier)
		
			IF !EMPTY(lcSearchStrSQL)
				*lcTryString = SearchAlloyStandard(lcSearchStr, gnConnHandle )
				IF USED('tmpSupQuote')
					USE IN tmpSupQuote
				ENDIF
		
				cSQL = "SELECT Contact "
				cSQL = cSQL + " FROM dbo.SupplierQuotes WITH(NOLOCK) WHERE Supplier = '"+cSupplier+"'" 
				cSQL = cSQL + " AND Contact LIKE '"+lcSearchStrSQL+"%'" 
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSupQuote' )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSupQuote' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSupQuote")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSupQuote")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSupQuote')
				ENDIF
				IF USED('tmpSupQuote')
					IF VARTYPE( tmpSupQuote.Contact) = "C"
						IF NOT EMPTY(tmpSupQuote.Contact)
							lcFoundStr  = tmpSupQuote.Contact
							*this.VALUE = tmpSupQuote.Contact
							=insmode(.f.)
							lSearchFound = .T.
						ENDIF
					ENDIF
					USE IN tmpSupQuote
				ENDIF		
		
				
				IF NOT EMPTY(lcFoundStr)		
					IF UPPER(lcSearchStr) = UPPER(SUBSTR(lcFoundStr,1,lnInsertionPt))
						THIS.VALUE=lcFoundStr
						THIS.FORECOLOR = RGB(0,0,0)
					ELSE
						THIS.VALUE=lcSearchStr
						THIS.FORECOLOR = RGB(255,0,0)
					ENDIF
				ELSE
			*		*No replacement
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
				THIS.VALUE=SPACE(0)
			ENDIF
			THIS.SELSTART = lnInsertionPt
		
		ENDIF
	ENDPROC

