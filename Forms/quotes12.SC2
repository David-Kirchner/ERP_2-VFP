	PROCEDURE refresh_ordertracking
		*ThisFormSet.Refresh_OrderTracking()
		
		ThisFormSet.frmOrderTracking.Visible = .T.
		ThisFormSet.frmOrderTracking.Left = ThisFormSet.QUOTES.Left
		ThisFormSet.frmOrderTracking.Top = ThisFormSet.QUOTES.Top + ThisFormSet.QUOTES.Height + 5
		
		*ThisFormSet.frmShop_Hrs.AlwaysOnTop = .T.
		
		
		PRIVATE cSOitem
		cSOitem   = PrepareSQLtxt(Quotes.SOItem,'SOitem',10)
		
		*ThisFormSet.frmOrderTracking.lblSOitem.Caption = "SO item '"+ALLTRIM(cSOItem)+"'"
		ThisFormSet.frmOrderTracking.txtJobId.Value		= 0
		ThisFormSet.frmOrderTracking.txtType.Value		= ''
		ThisFormSet.frmOrderTracking.txtDescription.Value	= ''
		ThisFormSet.frmOrderTracking.txtStartTime.Value		= ''
		ThisFormSet.frmOrderTracking.txtStopTime.Value		= ''
		
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpOTrack")
			ThisFormSet.frmOrderTracking.grdOT.RecordSource = ''
			USE IN tmpOTrack
		ENDIF
		
		cSQL = "SELECT dbo.f_ProperSOitem(o.OrderNumber) AS SOitem "
		cSQL = cSQL + " ,o.JobId "
		*cSQL = cSQL + ",otot.* "
		cSQL = cSQL + ",otj.Description, otj.Type "
		cSQL = cSQL + ",ott.StartTime,ott.StopTime,ott.Start_StatusId, ott.Stop_StatusId "
		cSQL = cSQL + " FROM HPAlloy.dbo.OTracking AS o "
		cSQL = cSQL + " LEFT OUTER JOIN HPAlloy.dbo.OTracking_OrderType AS otot ON o.OrderTypeId = otot.OrderTypeId "
		cSQL = cSQL + " LEFT OUTER JOIN HPAlloy.dbo.OTracking_Job AS otj ON o.JobId = otj.JobId "
		cSQL = cSQL + " INNER JOIN HPAlloy.dbo.OTracking_Times AS ott ON o.TrackId = ott.TrackId "
		
		cSQL = cSQL + " WHERE o.OrderNumber= '"+ALLTRIM(cSOItem)+"'"
		cSQL = cSQL + " ORDER BY ott.StartTime DESC "
			
		SELECT 0
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpOTrack')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpOTrack')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpOTrack")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpOTrack")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tmpOTrack')
		ENDIF
		IF USED("tmpOTrack")
			IF RECCOUNT('tmpOTrack') > 0
				ThisFormSet.frmOrderTracking.grdOT.RecordSource = 'tmpOTrack'
				ThisFormSet.Refresh_OrderTracking_OTrack()
			ENDIF
		ENDIF
			
	ENDPROC

	PROCEDURE refresh_ordertracking_otrack
		*Refresh_OrderTracking_OTrack
		
		ThisFormSet.frmOrderTracking.lblSOitem.Caption = "SO item '"+ALLTRIM(tmpOTrack.SOItem)+"'"
		ThisFormSet.frmOrderTracking.txtJobId.Value		= PrepareSQLnum(tmpOTrack.JobID,'JobID',-3)
		ThisFormSet.frmOrderTracking.txtType.Value		= PrepareSQLtxt(tmpOTrack.Type,'Type',50)
		ThisFormSet.frmOrderTracking.txtDescription.Value	= PrepareSQLtxt(tmpOTrack.Description,'Description',50)
		ThisFormSet.frmOrderTracking.txtStartTime.Value		= PrepareSQLdateTime(tmpOTrack.StartTime,'StartTime', .F.,.T.)
		ThisFormSet.frmOrderTracking.txtStopTime.Value		= PrepareSQLdateTime(tmpOTrack.StopTime,'StopTime', .F.,.T.)
		
		
		*!*	Start_StatusId
		*!*	Stop_StatusId
	ENDPROC

