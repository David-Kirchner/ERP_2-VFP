	PROCEDURE frmSources.cmdAddVC.Click
		Private nNewContactID, nCurrentContactID,nDefaultContactID, lcCurrTable, nVendCode
		nNewContactID = 0
		nCurrentDefaultContactID = PrepareSQLnum(ThisForm.txtSContactID.Value,'ContactID',-3)
		nDefaultContactID	= PrepareSQLnum(ThisFormSet.frmSources.txtContactID.Value,'ContactID',-3)
		lcCurrTable = ALIAS()
		nVendCode = PrepareSQLnum(ThisForm.txtSVendCode.Value,'VendCode',-3)
		cCompany = ALLTRIM( PrepareSQLtxt(ThisForm.txtSCompany.Value,'Company',30) )
		
		IF EMPTY(nVendCode)
			MESSAGEBOX("Enter a Company first",48,"No Company")
			RETURN .F.
		ELSE
			DO FORM Forms\SearchForm WITH "VendorContact", nVendCode TO nNewContactID
			IF USED('TmpSearch')
				USE IN TmpSearch
				IF NOT EMPTY(lcCurrTable)
					SELECT (lcCurrTable)
				ENDIF
			ENDIF
		ENDIF
		
		IF nNewContactID > 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT VC.* ,V.Company "
			cSQL = cSQL + " FROM dbo.VendorContact VC WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN Vendor V ON V.VendCode = VC.VendCode "
			cSQL = cSQL + " WHERE VC.VendCode = "+STR(nNewContactID)
		
			IF USED("tmpVendorContact")
				USE IN tmpVendorContact
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpVendorContact')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpVendorContact')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpVendorContact")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpVendorContact")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tmpVendorContact')
			ENDIF
		
			IF USED('tmpVendorContact')
				ThisFormSet.frmSources.txtContactID.Value= PrepareSQLnum(tmpVendorContact.ContactID,'ContactID',-3)
				ThisFormSet.frmSources.txtBranch.Value	= ShowSQLtxt(tmpVendorContact.Branch,'Branch',30)
				ThisFormSet.frmSources.txtCompany.Value	= ShowSQLtxt(tmpVendorContact.Company,'Company',30)
				ThisFormSet.frmSources.txtContact.Value	= ShowSQLtxt(tmpVendorContact.Contact,'Contact',30)
				ThisFormSet.frmSources.txtPhone.Value	= ShowSQLtxt(tmpVendorContact.Phone,'Phone',20)
				ThisFormSet.frmSources.txtCellPhone.Value	= ShowSQLtxt(tmpVendorContact.CellPhone,'CellPhone',20)
				ThisFormSet.frmSources.txtEmail.Value	= ShowSQLtxt(tmpVendorContact.Email,'Email',60)
				ThisFormSet.frmSources.txtFax.Value		= ShowSQLtxt(tmpVendorContact.Fax,'Fax',20)
			
				ThisFormSet.Show_Sources('EditVendorContact')
				
			ENDIF
		ELSE
			IF nDefaultContactID > 0
		
			ENDIF
		ENDIF
	ENDPROC

