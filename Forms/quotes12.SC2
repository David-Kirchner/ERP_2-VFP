	PROCEDURE QUOTES.pf1.pageProcess.cmdEdit_rtr.Click
		PRIVATE biRTR_ID
		biRTR_ID = PrepareSQLnum(ThisFormset.QUOTES.pf1.pageProcess.txtrtr_ID.Value,'rtr_ID',-4)
		
		*DO FORM Forms\Router WITH "EDIT","SOI",cSOitem
		IF biRTR_ID > 0
			DO FORM Forms\Router WITH "EDIT","ROUTER",biRTR_ID
		ELSE
			PRIVATE cSOitem
			cSOitem   = PrepareSQLtxt(Quotes.SOItem,'SOitem',10)
			IF Proper_SO_item(cSOitem) != Proper_SO_item("")
				*Make Router for SOitem
		
				biRTR_ID = PrepareSQLnum( Create_rtr_SOitem(cSOitem,gnConnHandle),'rtr_ID',-4)
				
				IF biRTR_ID > 0
					DO FORM Forms\Router WITH "EDIT","ROUTER",biRTR_ID 
				ELSE
					MESSAGEBOX("No Router ID Found"+CHR(13)+"Failed to Create",48,"No ID")
				ENDIF
			ELSE
				MESSAGEBOX("No Router ID Found"+CHR(13)+"Show ALL",48,"No ID")
				DO FORM Forms\Router WITH "SHOW","ALL",0
			ENDIF
