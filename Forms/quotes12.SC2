	PROCEDURE QUOTES.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms WITH(NOLOCK) "
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE QUOTES.cmbForm.Valid
		ThisFormSet.RefreshForms()
		*10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,71,Coupling,72,Flange,75,Fastener,80,Disk,90,Machined
		* ALSO FOUND IN PurchaseOrder Screen
		IF ThisFormset.QUOTES.THCK1.Value * ThisFormset.QUOTES.SZ21.Value > 0
			IF NOT ThisFormset.QUOTES.SZ31.Visible
		*		IF ThisFormset.QUOTES.SZ21.Value > 0
					ThisFormSet.CalcInv(2)
		*		ENDIF
			ELSE
				IF ThisFormset.QUOTES.SZ31.Value > 0
					ThisFormSet.CalcInv(3) 
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.cmbForm.When
		IF ThisFormSet.isediting
			ThisFormSet.MetricGOTFocus  = "cmbForm"
			ThisFormSet.GOTFocusLast  = "cmbForm"
		ENDIF
		RETURN ThisFormSet.isediting
	ENDPROC

	PROCEDURE QUOTES.cmdAdd.Valid
		
		gnConnHandle = CheckSQLConnection(gnConnHandle)
		
		PRIVATE nINQMAX, nNext_Inq, cUseThisName
		SELECT Quotes
		IF EOF('Quotes')
			IF NOT BOF('Quotes')
				SKIP -1
			ELSE
				MESSAGEBOX("Found problem with Quotes file."+CHR(13)+"Add failed!",0+16,"Try again")
				TrackError("EOF in Quotes file.","Could not get Quotes.SalesP",PROGRAM(),LINENO(1) )
				RETURN .F.
			ENDIF
		ENDIF
		
		
		cUseThisName = Quotes.SalesP
		cUseThisName = ThisForm.txtSalesP.Value
		
		
		PRIVATE cCover
		cCover = PrepareSQLtxt(Quotes.Cover,'Cover',1)
		
		PRIVATE cHomeSalesp
		IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			cHomeSalesp = ALLTRIM(m.salesp)
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
				cHomeSalesp = ALLTRIM(m.salesp)
			ELSE
				MESSAGEBOX(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM not set.")
				WAIT WINDOW "Type your HPA initial now." TO cHomeSalesp
				cHomeSalesp = UPPER(cHomeSalesp)
			ENDIF
		ENDIF
		
		IF EMPTY(cUseThisName) &&AND RECCOUNT('Quotes') = 0
			IF TYPE(ThisForm.cmbFilterSalesP.Value) = "C"
				cUseThisName = UPPER(ALLTRIM(ThisForm.cmbFilterSalesP.Value))
			ELSE
				cUseThisName = cHomeSalesp
			ENDIF
		*IF MESSAGEBOX("Did not find any records for this username '"+UPPER(ALLTRIM(ThisForm.cmbFilterSalesP.Value))+"'."+CHR(10)+"Do you want to use the default for this machine '"+cHomeSalesp+"' ?",4+32,"Use default SalesP?") = 6 &&Yes
		ENDIF
		
		IF EMPTY('cUseThisName')
			TrackError("cUseThisName is EMPTY","bad variable",PROGRAM(),LINENO(1))
		ENDIF
		
		IF EMPTY(cHomeSalesp)
			WAIT WINDOW "Type your HPA SalesPerson initial now." TO cHomeSalesp
			cHomeSalesp = UPPER(cHomeSalesp)
		ENDIF
		
		IF EMPTY(cHomeSalesp)
			cHomeSalesp = '_'
		ENDIF
		
		
		
		
		
		
		
		
		
		
		
		IF cUseThisName != cHomeSalesp AND cHomeSalesp != "*"
			PRIVATE cMess
			cMess = "This pc was Setup for Sales Person '"+cHomeSalesp+"'."+CHR(13)
			cMess = cMess + "This new record is to be added to "+cUseThisName+"'s records thou!"+CHR(13)
			IF NOT EMPTY(cCover)
				cMess = cMess +CHR(13)+"You may have need to move to another record before you Add."+CHR(13)
				cMess = cMess +"becuse this record was COVERED for by "+cCover+"!"+CHR(13)+CHR(13)
			ENDIF
			cMess = cMess + "Do you still want to ADD?"+CHR(13)+CHR(13)
			cMess = cMess + "Press YES to continue adding."+CHR(13)
			cMess = cMess + "Press NO to cancel this add."
			
			IF MESSAGEBOX(cMess ,4+48,"Caution, Are you adding to the right User data?")=7
				RETURN		   
			 ENDIF  
		ENDIF
		
		IF EMPTY(ThisFormSet.SalesP) 
			IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
				IF EMPTY(M.SalesP)
					DELETE FILE (SYS(5)+SYS(2003) +"\SalesP.MEM")
				ELSE
					ThisFormSet.SalesP = ALLTRIM(M.SalesP)
					ThisFormSet.SetUserInfo(ALLTRIM(M.SalesP))
				ENDIF
			ELSE
				IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
					RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
					IF EMPTY(M.SalesP)
						DELETE FILE (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
					ELSE
						ThisFormSet.SalesP = ALLTRIM(M.SalesP)
						ThisFormSet.SetUserInfo(ALLTRIM(M.SalesP))
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF EMPTY(ThisFormSet.SalesP) AND NOT EMPTY(gcSalesP)
			ThisFormSet.SalesP = gcSalesP
			ThisFormSet.SetUserInfo(ALLTRIM(M.SalesP))
		ENDIF
			
		IF EMPTY(ThisFormSet.SalesP)
			WAIT WINDOW "ENTER YOUR INITAIL" TO M.SalesP
			ThisFormSet.SalesP = UPPER(M.SalesP)
			
			IF "\MEM" $ SYS(2003)
				IF NOT FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
					SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\SalesP.MEM")
				ENDIF
			ELSE
				IF NOT FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
					SAVE ALL LIKE SalesP TO (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				ENDIF
			ENDIF
			ThisFormSet.SalesP = gcSalesP
			
			ThisFormSet.SetUserInfo(gcSalesP)
		ENDIF
		
		IF USED('MaxInqNum')
			USE IN MaxInqNum
		ENDIF
		
		PRIVATE cSQLMaxInqNum
		cSQLMaxInqNum = "SELECT MAX(InqNum) AS MaxInqN FROM dbo.AllQuotes WITH(NOLOCK) WHERE SalesP = '"+cUseThisName+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum') 
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, "MaxInqNum")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, "MaxInqNum")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 	
		IF nSQLEXEC < 0
			SQLEXECError(cSQLMaxInqNum,gnConnHandle,nSQLEXEC, 'MaxInqNum')
		ENDIF	
			
		IF USED('MaxInqNum')
			IF VARTYPE( MaxInqNum.MaxInqN ) = "N"
				IF MaxInqNum.MaxInqN > 1000
					nINQMAX = PrepareSQLnum(MaxInqNum.MaxInqN,'MaxInqN',-3)
				ELSE
					nINQMAX = 1000
				ENDIF
			ELSE
				nINQMAX = 1000
			ENDIF
		ELSE
			nINQMAX=1000
		ENDIF
		
		
		IF nINQMAX=1000 OR nINQMAX=1001
			*try again
			cSQLMaxInqNum = "SELECT MAX(InqNum) AS MaxInqN FROM dbo.AllQuotes WHERE SalesP = '"+cUseThisName+"'"
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum') 
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, "MaxInqNum")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, "MaxInqNum")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLMaxInqNum,gnConnHandle,nSQLEXEC, 'MaxInqNum')
			ENDIF	
			
			*******************************
			IF MaxInqNum.MaxInqN > 1000
				nINQMAX = PrepareSQLnum(MaxInqNum.MaxInqN,'MaxInqN',-3)
			ELSE
				nINQMAX=1000
			ENDIF
		ENDIF
					
		IF USED('MaxInqNum')
			USE IN MaxInqNum
		ENDIF
		
		IF ISNULL(nINQMAX)
			nINQMAX = 1000
			MESSAGEBOX("If this is the first Inquire, then you are fine."+CHR(13)+"If this is not your first Inquire,"+CHR(13)+"something is wrong and you will not be able to save!",48,"Error, did not find last inquire.")
			TrackError("Did not find inquire for SalesP = '"+cUseThisName+"'"+CHR(13)+"Using InqNum=1000","Using InqNum=1000",PROGRAM(),LINENO(1) )
		ENDIF
		
		nNext_Inq = nINQMAX + 1
		
		*add record
		THISFORMSET.isadding=.T.
		THISFORMSET.SetLabelEdit()
		*ThisFormSet.AutoName = .T.
		*ThisForm.cmdAutoName.Picture = "graphics\spell.bmp"
		
		THISFORMSET.Quotes.LOCKSCREEN = .T.
		SELECT Quotes
		nCurInqNum = nNext_Inq
		USE IN Quotes
		
		PRIVATE m.cInqnumP
		m.cInqnumP = STR(nNext_Inq,8,0)+cUseThisName
		
		
		IF Insert_BlankAllQuotes(nNext_inq,cInqNumP,cUseThisName,gnConnHandle)
			IF SQLCOMMIT(gnConnHandle) < 1
				SQLExecError("Cannot commit."+CHR(13)+cInsert,gnConnHandle)
			ENDIF
		ELSE
			TrackError("Add Quote record."+CHR(13)+cInsert,"Did not insert new record",PROGRAM(),LINENO(1))
		ENDIF
		
		
		SELECT 0
		*refresh Quotes table
		nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
		ENDIF
		
		
		SELECT Quotes
		LOCATE FOR InqNumP = m.cInqnumP
		
		SELECT Quotes
		IF !FOUND( ) OR EOF( )
			GO BOTTOM
		ENDIF
		
		ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened 
		THISFORMSET.Quotes.LOCKSCREEN = .F.
		
		ThisFormSet.QuotesRecordChanged()
		
		*!*	IF NOT USED('Customer')
		*!*		USE Customer SHARED NOUPDATE IN 0 ORDER TAG Customer
		*!*	ENDIF
		SELECT Quotes
		
		THISFORM.REFRESH
		THISFORM.Name1.SETFOCUS
		
		THISFORMSET.Name1StartEmpty = .T.
		
		
		
	ENDPROC

	PROCEDURE QUOTES.cmdAutoName.Click
		PRIVATE cUserName
		cUserName = AppSetup_Get_UserName(gcSalesP)
		IF ThisFormSet.AutoName
			This.Picture = "graphics\strikthr.bmp"
			ThisFormSet.AutoName = !ThisFormSet.AutoName
			AppSetup_Update_Ans( "OFF", cUserName, "AutoName", gnConnHandle)
		ELSE
			This.Picture = "graphics\spell.bmp"
			ThisFormSet.AutoName = !ThisFormSet.AutoName
			AppSetup_Update_Ans( "ON", cUserName, "AutoName", gnConnHandle)
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.cmdBrowOpen.Click
		*PRIVATE currOrder
		SELECT Quotes
		** Cannot order on a buffered table
		*currOrder = ORDER()
		*SET ORDER TO
		** Enable Table buff so multable records can be updated
		*= CURSORSETPROP('Buffering', 5, 'Quotes' )  && Enable 3row 5table buffering
		PRIVATE nCurRecNo, nCountFound
		nCurRecNo = RECNO()
		nCountFound = 0
		COUNT TO nCountFound FOR Quotes.open_ = .T.
		IF nCountFound > 0 THEN
			BROWSE FIELDS Company,Quotes.name,alloy,Quotes.form,CC,CL,pieces,thck,sz2,sz3,weight,descript,p_lb,p_pc,p_ft,cuts,otherfld,otherp,lotp ;
			NODELETE NOMODIFY NOAPPEND FOR Quotes.open_ = .T.
		
		ELSE
			MESSAGEBOX("You have no open Quotes to view.",48)
			SELECT Quotes
			IF nCurRecNo > 0
				GOTO (nCurRecNo)
			ENDIF
		ENDIF
		
		*IF TABLEUPDATE(1,.F.,"Quotes")
			*
		*ELSE
		*	=MESSAGEBOX("Data will not be saved to disk",0+16,"Found error")
		*	=TABLEREVERT(.T.,"Quotes")
		*ENDIF
		** reset to row buff
		*= CURSORSETPROP('Buffering', 3, 'Quotes' )  && Enable 3row 5table buffering
		*SET ORDER TO currOrder
		
		ThisFormSet.refresh
	ENDPROC

	PROCEDURE QUOTES.cmdBrowOpen.When
		IF ThisFormSet.isediting
			WAIT WINDOW 'Save your Edit first!' NOWAIT
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdClone.Valid
		PRIVATE RC,INQMAX,m.next_inq,TALKPROP, cUseThisName
		PRIVATE lClone2Self, cOrigSalesP, cOrigInqnumP
		lClone2Self = .F.
		cOrigSalesP = Quotes.SalesP 
		cOrigInqnumP = Quotes.InqNumP
		
		SELECT Quotes
		
		PRIVATE cHomeSalesp,cUseThisName
		IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			cHomeSalesp = ALLTRIM(SalesP)
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
				cHomeSalesp = ALLTRIM(SalesP)
			ELSE
				MESSAGEBOX(SYS(5)+SYS(2003) +"\MEM\SalesP.mem not set.")
				WAIT WINDOW "Type your HPA initial now." TO cHomeSalesp
				cHomeSalesp = UPPER(cHomeSalesp)
			ENDIF
		ENDIF
		
		IF EMPTY(cHomeSalesp)
			WAIT WINDOW "Type your HPA SalesPerson initial now." TO cHomeSalesp
			cHomeSalesp = UPPER(cHomeSalesp)
		ENDIF
		
		IF EMPTY(cHomeSalesp)
			cHomeSalesp = '_'
		ENDIF
			
		IF EMPTY(ThisFormSet.SalesP) OR ThisFormSet.SalesP = "*"
		 	IF FILE(SYS(5)+SYS(2003)+"\SALESP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003)+"\SALESP.MEM") ADDITIVE
				ThisFormSet.SalesP = ALLTRIM(m.salesp)
			ELSE
			 	IF FILE(SYS(5)+SYS(2003)+"\MEM\SALESP.MEM")
					RESTORE FROM (SYS(5)+SYS(2003)+"\MEM\SALESP.MEM") ADDITIVE
					ThisFormSet.SalesP = ALLTRIM(m.salesp)
				ENDIF
			ENDIF
		ENDIF
		
		
		IF !THISFORMSET.isediting &&add record
			PRIVATE cCompany,cName,cPhone,cPhone_Ext,cFax,cEmail,cAlloy,cForm
			PRIVATE cCC,cCL,nPieces,nThck,nSz2,nSz3,nWeight,cDescript,nP_lb,nP_pc,nP_ft
			PRIVATE nCuts,cOtherFld,nOtherP,nLotP,nLotCost,cLeadTime ,nBracket
			PRIVATE cCustID,cQuoteMemo,cComments,cCountryC,cCountry,lServices,lRandLen,lMetric,cSZ1Orig,cSZ2Orig,cSZ3Orig
			PRIVATE nCutHR, nQ_P, nQ_QTY, nStandardSize, nCustDisc
			
			cCompany		= PrepareSQLtxt(Quotes.Company,'Company',30)
			cName			= PrepareSQLtxt(Quotes.Name,'Name',25)
			cPhone	 		= PrepareSQLtxt(Quotes.Phone,'Phone',10)
			cPhone_Ext		= PrepareSQLtxt(Quotes.Phone_ext,'Phone_ext',6)
			cFax			= PrepareSQLtxt(Quotes.Fax,'Fax',10)
			cEmail			= PrepareSQLtxt(Quotes.Email,'Email',60)
			cAlloy			= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
			cForm			= PrepareSQLtxt(Quotes.Form,'Form',2)
			cCC				= PrepareSQLtxt(Quotes.CC,'CC',1)
			cCL				= PrepareSQLtxt(Quotes.CL,'CL',1)
			nPieces			= PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
			nThck			= PrepareSQLnum(Quotes.Thck,'Thck',10,4)
			nSz2			= PrepareSQLnum(Quotes.Sz2,'Sz2',9,3)
			nSz3			= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
			nWeight			= PrepareSQLnum(Quotes.Weight,'Weight',8,1)
			cDescript		= PrepareSQLtxt(Quotes.Descript,'Descript',50)
			nP_lb			= PrepareSQLnum(Quotes.P_lb,'P_lb',8,2)
			nP_pc			= PrepareSQLnum(Quotes.P_pc,'P_pc',9,2)
			nP_ft			= PrepareSQLnum(Quotes.P_ft,'P_ft',8,2)
			nCuts			= PrepareSQLnum(Quotes.Cuts,'Cuts',6,0)
			cOtherFld		= PrepareSQLtxt(Quotes.OtherFld,'OtherFld',10)
			nOtherP			= PrepareSQLnum(Quotes.OtherP,'OtherP',8,2)
			nLotP			= PrepareSQLnum(Quotes.LotP,'LotP',8,2)
			nLotCost		= PrepareSQLnum(Quotes.LotCost,'LotCost',8,2)
			cLeadTime		= PrepareSQLtxt(Quotes.LeadTime,'LeadTime',15)
		*	cLine1			= PrepareSQLtxt(Quotes.Line1,'Line1',60)
			nBracket		= PrepareSQLnum(Quotes.Bracket,'Bracket',-1)
			cCustID			= PrepareSQLtxt(Quotes.CustID,'CustID',20)
		*	cQuoteMemo		= PrepareSQLtxt(Quotes.QuoteMemo,'QuoteMemo',-1)
			cQuoteMemo		= " "
			cComments		= PrepareSQLtxt(Quotes.Comments,'Comments',-1)
			cComments		= ALLTRIM(cComments)
			
			cCountryC		= PrepareSQLtxt(Quotes.CountryC,'CountryC',10)
			cCountry		= PrepareSQLtxt(Quotes.Country,'Country',20)
			lServices		= PrepareSQLlogic(Quotes.Services,'Services',.F.)
			*lServices		= .F.
			lRandLen		= PrepareSQLlogic(Quotes.RandLen,'RandLen',.F.)
			*lRandLen		= .F.
			lMetric			= PrepareSQLlogic(Quotes.Metric,'Metric',.F.)
			*lMetric			= .F.
			cSZ1Orig		= PrepareSQLtxt(Quotes.SZ1Orig,'SZ1Orig',20)
			cSZ2Orig		= PrepareSQLtxt(Quotes.SZ2Orig,'SZ2Orig',20)
			cSZ3Orig		= PrepareSQLtxt(Quotes.SZ3Orig,'SZ3Orig',20)
		
			nCutHR		= PrepareSQLnum(Quotes.CutHR,'CutHR',-2)
			nQ_P		= Get_Qoute_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
			nQ_QTY		= Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld, gnConnHandle )
			nStandardSize =	getStandardSize_Common_CC_CL( nThck, cAlloy, cForm, cCC, cCL, gnConnHandle)
			nStandardSize = PrepareSQLnum( nStandardSize,'StandSize',9,3)
			IF nStandardSize = 0
				*nStandardSize = getStandardSize_Alloy_form(nThck, cAlloy, cForm, gnConnHandle)  &&Checks Price Table!
				*nStandardSize = getPriceTableStandardSize( nThck, cAlloy, cForm, cCC, gnConnHandle)
				
				nStandardSize = PrepareSQLnum( getStandardSize( Quotes.StandardSize, gnConnHandle ) ,'StandSize',9,3)
			ENDIF
			nCustDisc	= PrepareSQLnum(Quotes.CustDisc,'CustDisc',3,2)
			
			*ThisFormSet.AutoName = .T.
			*ThisForm.cmdAutoName.Picture = "graphics\spell.bmp"
		
			IF EMPTY(ThisFormSet.SalesP) OR ThisFormSet.SalesP = "*"
				WAIT WINDOW "PRESS A KEY TO ENTER YOUR INITAIL" TO M.salesp
				ThisFormSet.SalesP = PrepareSQLtxt(m.salesp,'SalesP',1)
			ENDIF
			
			IF cHomeSalesp != ThisFormSet.SalesP AND cHomeSalesP != "*"
				IF MESSAGEBOX("This computer was setup to be used by Sales Person ' "+cHomeSalesP+" '."+CHR(13)+CHR(13)+;
				  "Do you want to clone this as "+cHomeSalesP+"'s file."+CHR(13)+;
				  "Answer no to clone as ' "+ThisFormSet.SalesP+" '.",4+32,"Clone for Whom?") = 6 &&Yes
				  
				    lClone2Self = .T.
					cUseThisName = cHomeSalesP
				ELSE
					lClone2Self = .F.
					cUseThisName = ThisFormSet.SalesP
				ENDIF
			ELSE
				cUseThisName = ThisFormSet.SalesP
			ENDIF
		
			IF USED('MaxInqNum')
				USE IN MaxInqNum
			ENDIF
			
			SELECT 0
			
			PRIVATE cSQLMaxInqNum
			cSQLMaxInqNum = "SELECT MAX(InqNum) FROM dbo.AllQuotes WHERE SalesP = '"+cUseThisName+"'"
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, "MaxInqNum")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, "MaxInqNum")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQLMaxInqNum,gnConnHandle,nSQLEXEC, 'MaxInqNum')
				INQMAX=1000
			ELSE
				IF USED('MaxInqNum')
					INQMAX = MaxInqNum.EXP
					USE IN MaxInqNum
				ENDIF
			ENDIF
			
			IF INQMAX=1000
				*Second Try
				cSQLMaxInqNum = "SELECT MAX(InqNum) FROM dbo.AllQuotes WHERE SalesP = '"+cUseThisName+"'"
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQLMaxInqNum, 'MaxInqNum')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, "MaxInqNum")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQLMaxInqNum, "MaxInqNum")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQLMaxInqNum,gnConnHandle,nSQLEXEC, 'MaxInqNum')
					INQMAX=1000
				ELSE
					IF USED('MaxInqNum')
						INQMAX = MaxInqNum.EXP
						USE IN MaxInqNum
					ENDIF
				ENDIF
			ENDIF
		
			THISFORMSET.Quotes.LOCKSCREEN = .T.
			m.next_inq = INQMAX + 1
			PRIVATE m.cInqnumP
			m.cInqnumP = STR(m.next_inq,8,0)+cUseThisName
			
			
			*Clone not Insert_BlankAllQuotes(next_inq, cInqNumP, cUseThisName, gnConnHandle)
			
			PRIVATE cInsert
			cInsert = "INSERT INTO dbo.AllQuotes ("
			cInsert = cInsert + "COMPANY,"
			cInsert = cInsert + "NAME,"
			cInsert = cInsert + "PHONE,"
			cInsert = cInsert + "PHONE_EXT,"
			cInsert = cInsert + "FAX,"
			cInsert = cInsert + "EMAIL,"
			cInsert = cInsert + "PO_NUM,"
			cInsert = cInsert + "ALLOY,"
			cInsert = cInsert + "FORM,"
			cInsert = cInsert + "CC,"
			cInsert = cInsert + "CL,"
			cInsert = cInsert + "PIECES,"
			cInsert = cInsert + "THCK,"
			cInsert = cInsert + "SZ2,"
			cInsert = cInsert + "SZ3,"
			cInsert = cInsert + "Weight,"
			cInsert = cInsert + "DESCRIPT,"
			cInsert = cInsert + "P_lb,"
			cInsert = cInsert + "P_pc,"
			cInsert = cInsert + "P_ft,"
			cInsert = cInsert + "cuts,"
			cInsert = cInsert + "OtherFld,"
			cInsert = cInsert + "OtherP,"
			*new line
			cInsert = cInsert + "LotP,"
			cInsert = cInsert + "LotCost,"
			cInsert = cInsert + "LeadTime,"
			cInsert = cInsert + "cWeight,"
			cInsert = cInsert + "cP_lb,"
			cInsert = cInsert + "cP_pc,"
			cInsert = cInsert + "cP_Pcc,"
			cInsert = cInsert + "cTHK,"
			cInsert = cInsert + "cLotP,"
			cInsert = cInsert + "cLotCp,"
			cInsert = cInsert + "cCut,"
		*	cInsert = cInsert + "Line1,"
			*new line
		*	cInsert = cInsert + "InqDate,"
			cInsert = cInsert + "InqNum,"
			cInsert = cInsert + "InqNumP,"
			cInsert = cInsert + "SalesP,"
			*new line
			cInsert = cInsert + "SalesNum,"
			cInsert = cInsert + "SOitem,"
			cInsert = cInsert + "Item,"
			cInsert = cInsert + "HPApo,"
			cInsert = cInsert + "SaleDate,"
			cInsert = cInsert + "BuyFrom,"
		*	cInsert = cInsert + "ShipDate,"
			cInsert = cInsert + "BuyCost,"
			cInsert = cInsert + "BuyFrom2,"
			cInsert = cInsert + "HPApo2,"
			cInsert = cInsert + "Open_,"
			cInsert = cInsert + "Bracket,"
			*new line
			cInsert = cInsert + "CustID,"
			cInsert = cInsert + "QuoteMemo,"
			cInsert = cInsert + "Comments,"
			cInsert = cInsert + "CountryC,"
			cInsert = cInsert + "Country,"
			cInsert = cInsert + "Services,"
			cInsert = cInsert + "RandLen,"
			cInsert = cInsert + "Metric,"
			cInsert = cInsert + "SZ1Orig,"
			cInsert = cInsert + "SZ2Orig,"
			cInsert = cInsert + "SZ3Orig"
			cInsert = cInsert + ",Q_P"
			cInsert = cInsert + ",Q_QTY"
			cInsert = cInsert + ",StandardSize"
			cInsert = cInsert + ",CustDisc"
			
			cInsert = cInsert + ") VALUES ("
			cInsert = cInsert + "'" +cCOMPANY+"'"
			cInsert = cInsert + ",'"+cName+"'"
			cInsert = cInsert + ",'"+cPhone+"'"
			cInsert = cInsert + ",'"+cPhone_Ext+"'"
			cInsert = cInsert + ",'"+cFax+"'"
			cInsert = cInsert + ",'"+cEmail+"'"
			cInsert = cInsert + ",''"
			cInsert = cInsert + ",'"+cAlloy+"'"
			cInsert = cInsert + ",'"+cForm+"'"
			cInsert = cInsert + ",'"+cCC+"'"
			cInsert = cInsert + ",'"+cCL+"'"
			cInsert = cInsert + ","+STR(nPieces,7,0)
			cInsert = cInsert + ","+STR(nThck,10,4)
			cInsert = cInsert + ","+STR(nSz2,9,3)
			cInsert = cInsert + ","+STR(nSz3,9,3)
			cInsert = cInsert + ","+STR(nWeight,8,1)
			cInsert = cInsert + ",'"+cDescript+"'"
			cInsert = cInsert + ","+STR(nP_lb,8,2)
			cInsert = cInsert + ","+STR(nP_pc,9,2)
			cInsert = cInsert + ","+STR(nP_ft,8,2)
			cInsert = cInsert + ","+STR(nCuts,6,0)
			cInsert = cInsert + ",'"+cOtherFld+"'"
			cInsert = cInsert + ","+STR(nOtherP,8,2)
			cInsert = cInsert + ","+STR(nLotP,9,2)
			cInsert = cInsert + ","+STR(nLotCost,9,2)
			cInsert = cInsert + ",'"+cLeadTime+"'"
			cInsert = cInsert + ",0,0,0,0,'',0,0,0"  &&cWeight,cP_lb,cP_pc,cP_Pcc,cTHK,cLotP,cLotCp,cCut
		*	cInsert = cInsert + ",'"+cLine1+"'"
			cInsert = cInsert + ","+STR(m.next_inq)+",'"+m.cInqnumP+"','"+cUseThisName+"',"
			cInsert = cInsert + "0,'',0,0,'',''"  &&SalesNum,SOitem,Item,HPApo,SaleDate,BuyFrom
		*	cInsert = cInsert + ",''"  &&ShipDate
			cInsert = cInsert + ",0,'',0,1,"+STR(nBracket)
			cInsert = cInsert + ",'"+cCustID+"'"
			cInsert = cInsert + ",'"+cQuoteMemo+"'"
			cInsert = cInsert + ",'"+cComments+"'"
			cInsert = cInsert + ",'"+cCountryC+"'"
			cInsert = cInsert + ",'"+cCountry+"'"
			cInsert = cInsert + ","+IIF(lServices,'1','0')
			cInsert = cInsert + ","+IIF(lRandLen,'1','0')
			cInsert = cInsert + ","+IIF(lMetric,'1','0')
			cInsert = cInsert + ",'"+IIF(lMetric, cSZ1Orig, "" )+"'"
			cInsert = cInsert + ",'"+IIF(lMetric, cSZ2Orig, "" )+"'"
			cInsert = cInsert + ",'"+IIF(lMetric, cSZ3Orig, "" )+"'"
			cInsert = cInsert + ","+STR(nQ_P,18,4)
			cInsert = cInsert + ","+STR(nQ_QTY,18,4)
			cInsert = cInsert + ","+STR(nStandardSize,9,3)
			cInsert = cInsert + ","+STR(nCustDisc,3,2)
			cInsert = cInsert + ")"
		
		
			nSQLEXEC = SQLEXEC(gnConnHandle,cInsert)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cInsert)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cInsert, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cInsert, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cInsert,gnConnHandle,nSQLEXEC,'')
				ThisFormSet.IsAdding = .F.
			ELSE
		*		IF SQLCOMMIT(gnConnHandle) < 1
		*			SQLExecError("Cannot commit."+CHR(13)+cInsert,gnConnHandle)
		*		ELSE
					*EDIT NEW CLONE
							
					** cUseThisName != cHomeSalesP AND cHomeSalesP != "*" AND
					IF lClone2Self 
						MESSAGEBOX("Record was coppied under your records."+CHR(13)+;
						  "Use the SalesP[] combo box at top right of screen to view your records.")
						  ThisFormSet.IsAdding = .F.
					ELSE
					
						THISFORMSET.IsAdding =.T.
						THISFORMSET.setLabelEdit()
						
						IF USED("Quotes")
							USE IN Quotes
						ENDIF
						SELECT 0
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
							ThisFormSet.IsAdding = .F.
						ENDIF
		
						LOCATE FOR InqNumP = m.cInqnumP
						
						IF !FOUND( ) OR EOF( )
							GO BOTTOM
						ENDIF
						ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
						THISFORMSET.Quotes.LOCKSCREEN = .F.
						
						ThisFormSet.QuotesRecordChanged()
						
						TrackMess("Quote was cloned from '"+ALLTRIM(cOrigInqnumP)+"' to '"+ALLTRIM(m.cInqnumP)+"'"  )
						
						THISFORM.Alloy1.SETFOCUS
						THISFORM.REFRESH
						WAIT WINDOW 'RECORD IS READY TO MODIFY' NOWAIT
					ENDIF
		*		ENDIF
				THISFORMSET.Quotes.LOCKSCREEN = .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.cmdCompanyHistory.Click
		PRIVATE nLastRecNum
		nLastRecNum = RECNO("Quotes")
		PUBLIC nSelectID
		nSelectID = 0
		DO FORM FORMS\CompanyHistory WITH Quotes.Company,Quotes.alloy TO nSelectID
		SELECT Quotes
		
		PRIVATE cSQL
		
		IF nSelectID > 0
			IF !THISFORMSET.isediting
				IF USED('tmpSQL')
					USE IN tmpSQL
				ENDIF
		
				IF gcSalesP = "*"
					cSQL = "SELECT Company,inqDate FROM dbo.AllQuotes WHERE ID = "+ STR(nSelectID)
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSQL')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSQL')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpSQL')
					ENDIF
					IF NOT EMPTY(tmpSQL.Company)
						gcQuotesOR = " OR ( Company = '"+STRTRAN(tmpSQL.Company,"'","''")+"' AND InqDate = '"+DTOC( tmpSQL.InqDate )+"')"
						USE IN tmpSQL
					ELSE
						gcQuotesOR = gcQuotesOR + " OR InqNum = " + STR(rtnInqNum)
					ENDIF
		
		
					gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
					gcSQL=gcSQL +" WHERE ( InqDate > "+gcShowFromDate +")"
					gcSQL=gcSQL + gcQuotesOR
					*gcSQL=gcSQL +" ORDER BY InqNumP"
					gcSQL=gcSQL +" ORDER BY InqDate"
				ELSE
					cSQL = "SELECT Company,inqDate,SalesP FROM dbo.AllQuotes WHERE ID = "+ STR(nSelectID)
					**InqNumP = '"+ STR(rtnInqNum,8,0)+ALLTRIM(gcSalesp)+"'"
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSQL')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSQL')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpSQL')
					ENDIF
					IF NOT EMPTY(tmpSQL.Company)
						gcQuotesOR = " OR ( Company = '"+STRTRAN(tmpSQL.Company,"'","''")+"' AND InqDate = '"+DTOC( tmpSQL.InqDate )+"')"
						IF tmpSQL.SalesP <> gcSalesP
							MESSAGEBOX("History brought back records from '"+tmpSQL.SalesP+"'."+CHR(13)+"These have been added to your currently selected records.",0,"Caution, not all these records are yours!" )
						ENDIF
						USE IN tmpSQL
					ELSE
						= MESSAGEBOX("Record has been deleted or has not been CREATED"+CHR(13)+"Cannot go to that number!",0,"Inquire Number not found!")
						*gcQuotesOR = gcQuotesOR + " OR InqNumP = '"+ STR(rtnInqNum,8,0)+ALLTRIM(gcSalesp)+"'"
						THIS.VALUE = nPastInqNum
					ENDIF
								
					gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
					gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
					gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
					gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
					gcSQL=gcSQL + gcQuotesOR
					*gcSQL=gcSQL +" ORDER BY InqNumP"
					gcSQL=gcSQL +" ORDER BY InqDate"
				ENDIF
		
				THISFORMSET.Quotes.LOCKSCREEN = .T.
				SELECT Quotes
				*			nCurInqNum = Quotes.InqNumP
				USE IN Quotes
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
				ENDIF
				
				SELECT Quotes
				LOCATE FOR ID = nSelectID
				THISFORM.cboTgq82.VALUE = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
				THISFORMSET.Quotes.LOCKSCREEN = .F.
		
				IF NOT FOUND('Quotes')
					**Reset
					IF nLastRecNum > RECCOUNT('Quotes')
						GO TOP
					ELSE
						GOTO nLastRecNum
					ENDIF
					WAIT WINDOW 'Did not find!' NOWAIT
				ENDIF
			
				THISFORMSET.REFRESH
			ELSE
				MESSAGEBOX("Finish your Edits first."+CHR(13)+"Save,then try again!",0+16,"Edit mode")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.cmdCustomerInfo.Click
		
		PRIVATE cCompany, loIE 
		cCompany = PrepareSQLtxt(ThisForm.Company1.Value,'Company',30)
		cCompany = HTML_Escape(cCompany)
		
		IF NOT EMPTY(cCompany)
		
			loIE = Createobject("internetexplorer.application")
			loIE.Visible = .T.
			
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
				
			loIE.Navigate(get_Report_Server()+"%2fCustomer%2fCustomer+Info&rs:Command=Render&customer="+ALLTRIM(cCompany) )
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdCustomerTerms.Click
		PRIVATE cCompany
		cCompany = AllTrim(Quotes.Company)
		
		
		IF FILE("forms\customerterms.scx")
			DO FORM forms\customerterms WITH cCompany 
		ELSE
			IF FILE("\forms\customerterms.scx")
				DO FORM \forms\customerterms WITH cCompany 
			ELSE
				IF FILE("\forms\customerterms.scx")
					DO FORM \forms\customerterms WITH cCompany 
				ELSE
					IF FILE("forms\customerterms.scx")
						DO FORM forms\customerterms WITH cCompany 
					ELSE
						IF FILE("customerterms.scx")
							DO FORM customerterms WITH cCompany 
						ELSE	
							MESSAGEBOX("FILE customerterms.scx NOT FOUND!")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdDel.Valid
		*.PRIVATE nCount
		PRIVATE cSQLDelete, cCurInqNumP
		PRIVATE cDeleteInqNumP 
		SELECT Quotes
		IF THISFORMSET.isediting 	&&cancel Edit or Add
		
			IF THISFORMSET.isadding
				IF MESSAGEBOX("Are you sure you want to delete?"+CHR(13)+CHR(13)+"No will cancel Edit",4+16,"Permantly Remove this record") = 6
					THISFORMSET.Quotes.LOCKSCREEN = .T.
					SELECT Quotes
					nQuoteID   = Quotes.ID
					
					IF RECNO('Quotes') > 1
						SKIP -1
						cCurInqNumP = Quotes.InqNumP
					ELSE
						IF RECNO('Quotes') < RECCOUNT('Quotes')
							SKIP 1
							cCurInqNumP = Quotes.InqNumP
						ELSE
							cCurInqNumP = " "
						ENDIF
					ENDIF
					
					USE IN Quotes
		
					***************
					cSQLDelete = "DELETE FROM dbo.AllQuotes WHERE ID = "+ STR(nQuoteID)
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQLDelete)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQLDelete,gnConnHandle ,nSQLEXEC,'')
					ELSE
		*				IF SQLCOMMIT(gnConnHandle) < 1
		*					SQLExecError("Cannot commit."+CHR(13)+cSQLDelete,gnConnHandle)
		*				ENDIF
					ENDIF
					
					
					SELECT 0
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 			
					IF nSQLEXEC < 0
						SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
					ENDIF
					
					****************
					ThisFormSet.ShowSources()
					
					SELECT Quotes
					LOCATE FOR InqNumP = cCurInqNumP
					ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
					THISFORMSET.Quotes.LOCKSCREEN = .F.
				ENDIF
				THISFORM.REFRESH()
				THISFORMSET.isadding=.F.
				
				THISFORMSET.SetLabelNormal()
				WAIT WINDOW 'Cancelled' NOWAIT
			ELSE
				*Stop the Edit!
				*the PricingPage ogCutting may have changed the local table, Refresh from SQL table.
				ThisFormSet.RevertPricingData()
				*reset the screen
				ThisFormSet.QuotesRecordChanged()
				ThisFormSet.SetLabelNormal()
			ENDIF
		
		ELSE
			*Edit Mode
			*delete record
			IF ISNULL(Quotes.SalesNum)
				IF MESSAGEBOX("Are you sure you want to delete?",4+16,"Permantly Remove this record") = 6
		
					THISFORMSET.Quotes.LOCKSCREEN = .T.
					SELECT Quotes
					cDeleteInqNumP = Quotes.InqNumP
					SKIP -1
					cCurInqNumP = Quotes.InqNumP
					USE IN Quotes
					
					*Romove from StartingStock
					cSQLDelete = "DELETE FROM dbo.StartingStock WHERE InqNumP = '"+ cDeleteInqNumP +"'"
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQLDelete)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 		
					IF nSQLEXEC < 0
						SQLExecError( cSQLDelete, gnConnHandle,nSQLEXEC,'' )
					ENDIF
		
		
					*Remove from AllQuotes
					cSQLDelete = "DELETE FROM dbo.AllQuotes WHERE InqNumP = '"+ cDeleteInqNumP +"'"
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQLDelete)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 	
					IF nSQLEXEC < 0
						SQLExecError( cSQLDelete, gnConnHandle,nSQLEXEC,'' )
					ELSE
		*				IF SQLCOMMIT(gnConnHandle) < 1
		*					SQLExecError("Cannot commit."+CHR(13)+cSQLDelete,gnConnHandle)
		*				ENDIF
					ENDIF
					
					
					*Get new Data
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 	
					IF nSQLEXEC < 0
						SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
					ENDIF
					
					SELECT Quotes
					LOCATE FOR InqNumP = cCurInqNumP
					ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
					THISFORMSET.Quotes.LOCKSCREEN = .F.
					
					ThisFormSet.QuotesRecordChanged()
				ELSE
					**do not delete
				ENDIF
			ELSE
				IF EMPTY(Quotes.SalesNum)
					IF MESSAGEBOX("Are you sure you want to delete?",4+16,"Permantly Remove this record") = 6
		
						THISFORMSET.Quotes.LOCKSCREEN = .T.
						SELECT Quotes
						cDeleteInqNumP = Quotes.InqNumP
						IF RECNO() > 1
							SKIP -1
						ENDIF
						cCurInqNumP = Quotes.InqNumP
						USE IN Quotes
						cSQLDelete = "DELETE FROM dbo.AllQuotes WHERE InqNumP = '"+ cDeleteInqNumP +"'"
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQLDelete)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQLDelete, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 	
						IF nSQLEXEC < 0
							SQLExecError( cSQLDelete, gnConnHandle,nSQLEXEC,'' )
						ELSE
		*					IF SQLCOMMIT(gnConnHandle) < 1
		*						SQLExecError("Cannot commit."+CHR(13)+cSQLDelete,gnConnHandle)
		*					ENDIF
						ENDIF
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 	
						IF nSQLEXEC < 0
							SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
						ENDIF
						
						ThisFormSet.ShowSources()
						
						SELECT Quotes
						LOCATE FOR InqNumP = cCurInqNumP
						ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
						THISFORMSET.Quotes.LOCKSCREEN = .F.
					ELSE
						**do not delete
					ENDIF
				ELSE
					MESSAGEBOX("This Record is part of order:"+ALLTRIM(STR(Quotes.SalesNum))+CHR(13)+"You cannot delete this record!")
				ENDIF
			ENDIF
		
		ENDIF
		
		THISFORMSET.REFRESH()
		
	ENDPROC

	PROCEDURE QUOTES.cmdDropEmail.OLEDragDrop
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord
		
		
		LOCAL lcString,lo,loX,loItem,lcText
		IF oDataObject.GETFORMAT( 1 )
			lcString = oDataObject.GETDATA( 1)
			
			IF MEMLINES(lcString) > 0 AND "Subject"$MLINE(lcString,1)
				lo = CREATEOBJECT("outlook.application")
				loX = lo.ActiveExplorer
				loItem = lox.Selection.Item(1)
				** loItem is now a pointer to the mail item
				lcText = loItem.Body
				*ThisFormset.QUOTES.Userinfo1.salesp
				*gcSalesP
				AddQuoteFromEmailDrop( lcText, gnConnHandle, Quotes.SalesP )
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdDropEmail.OLEDragOver
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord, nState
		
		
		IF oDataObject.GETFORMAT(1)
		   THIS.OLEDROPHASDATA = 1
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdEdit.Valid
		ThisFormSet.ShowCustomerTerms("NOWAIT")
		ThisFormSet.EditSave()
		
		tControlSource=""
	ENDPROC

	PROCEDURE QUOTES.cmdEdit.When
		*Edit or Save
		
		gnConnHandle = CheckSQLConnection(gnConnHandle)
		
		IF !ThisFormSet.IsInit
			IF !THISFORMSET.isediting
				*Wants to Edit
				IF NOT ISNULL(quotes.salesnum)
					IF NOT EMPTY(quotes.salesnum)
						
						IF USED('tmpShip')
							USE IN tmpShip
						ENDIF
						
									
						cSQL = "SELECT ShipDate,ShipVia FROM dbo.Ship WITH(NOLOCK) "
						cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+Quotes.SOItem+"')"
						
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpShip')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpShip')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpShip")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpShip")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpShip')
						ENDIF
						
						IF USED('tmpShip')
							IF RECCOUNT('tmpShip') > 0
								DECLARE aShipItem(1,2)
								aShipItem(1,1) = ""
								*Ship is used shared noupdate in Quotes.Load
								SELECT ShipDate,ShipVia FROM tmpShip INTO ARRAY aShipItem
								
								*IF (VARTYPE(aShipItem(1,1))='T' OR VARTYPE(aShipItem(1,1)='D') )
								IF PrepareSQLdate(aShipItem(1,1),'ShipDate',.F.,.T.) != PrepareSQLdate('','ShipDate',.F.,.T.)
									*Found a record 
									IF  aShipItem(1,1)=CTOD("  /  /  ") OR aShipItem(1,1)=CTOD("01/01/1900") OR aShipItem(1,1)=CTOT("  /  /  ") OR aShipItem(1,1)=CTOT("01/01/1900") 
										*ShipDate is blank!
		
										IF ThisFormset.QUOTES.pf1.PageStatus.chkPrintSO.Value = 0
											** Order has not been printed, Edit Away
											USE IN tmpShip
											RETURN .T.
										ELSE
											IF MESSAGEBOX("If you need to edit this Order, you will also need to reprint the ORDER!"+CHR(13)+;
											  "Any Edits here will need to be tracked down on any paperwork previously printed."+CHR(13)+;
											  "The 'Printed' flag will be undone for this order."+CHR(13)+CHR(13)+;
											  "Are you sure you want to Edit this record?",4+32,"Edit Record") = 6 &&Yes
												USE IN tmpShip
												Save_PrintedSOinSales_No( .F., quotes.salesnum, gnConnHandle )
												RETURN .T.
											ELSE
												USE IN tmpShip
												RETURN .F.
											ENDIF
										ENDIF
									ELSE &&Found Ship Date
										MESSAGEBOX( "Some or All of this order has been shipped!"+CHR(13)+"Do not change this order.",0,"Edit not allowed" )
										USE IN tmpShip
										RETURN .F.
									ENDIF
								ELSE
									** Order has not been printed, Edit Away
									USE IN tmpShip
									RETURN .T.
								ENDIF
							ELSE
								** Order has not been printed, Edit Away
								USE IN tmpShip
								RETURN .T.
							ENDIF
							
							IF USED('tmpShip')
								USE IN tmpShip
							ENDIF
						ENDIF
					ELSE
						RETURN .T.
					ENDIF
				ELSE
					RETURN .T.
				ENDIF
			ELSE
				*SAVE
				RETURN .T.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdEdit2.Valid
		tControlSource=""
		ThisFormSet.EditSave()
		
	ENDPROC

	PROCEDURE QUOTES.cmdEditQuickCompany.Click
		PRIVATE cCompany
		cCompany= AllTrim(Quotes.Company)
		
		IF FILE("forms\QCompany.scx")
			DO FORM forms\QCompany WITH cCompany
		ELSE
			MESSAGEBOX("Could not find 'QCompany' form to run",0+16,"Error")
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdEnd.Valid
		SELECT Quotes
		GO BOTTOM IN Quotes
		WAIT WINDOW 'End of File' NOWAIT
		
		ThisFormSet.RefreshAllQuotes(.F.)
		*ThisFormSet.QuotesRecordChanged()  &&Called from RefreshAllQuotes
		
		ThisForm.refresh
		
	ENDPROC

	PROCEDURE QUOTES.cmdExit.Click
		m.bailout=.T.	&&this is needed if used with FoxApp ?????2015
		
		PRIVATE lcCursafe
		PRIVATE cHomeSalesp 
		IF FILE(SYS(5)+SYS(2003) +"\SALESP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			cHomeSalesp = ALLTRIM(m.salesp)
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\MEM\SALESP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
				cHomeSalesp = ALLTRIM(m.salesp)
			ELSE
				cHomeSalesp =""
			ENDIF	
		ENDIF
		
		IF cHomeSalesp = ThisFormSet.SalesP
			*do not backup others, wipeing out yours!
			WAIT WINDOW 'BACKING UP' NOWAIT
			IF USED('Quotes') 
				SELE Quotes
				lcCursafe = SET('SAFETY')
				SET SAFETY OFF
				
				PRIVATE nSalesNum &&Error says nSalesNum not Found on line: Copy to
				nSalesNum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
				
				IF "\MEM" $ SYS(2003)
					COPY TO (SYS(5)+SYS(2003) +"\Quotes.dbf") FOR inqdate > (DATE()-90)
				ELSE
					COPY TO (SYS(5)+SYS(2003) +"\MEM\Quotes.dbf") FOR inqdate > (DATE()-90)
				ENDIF
				
				IF lcCursafe = "ON"
					SET SAFETY ON
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.Visible = .F.
		ThisFormSet.frmShutDown.Visible = .T.
		ThisFormSet.frmShutDown.AlwaysOnTop = .T.
		
		WAIT WINDOW 'Closing' TIMEOUT 1
		
		IF USED('Quotes')
			SELECT Quotes
		ENDIF
		*ThisFormSet.Quotes.Release
		ThisFormSet.Release
	ENDPROC

	PROCEDURE QUOTES.cmdExit.When
		IF WEXIST('SENDINQUIRE')
			=MESSAGEBOX("You must finish your work in"+CHR(13)+"'Send Inquire'",0+16,"Close Send Inquire")
			RETURN .F.
		ENDIF
		IF WEXIST('SENDQUOTE')
			=MESSAGEBOX("You must finish your work in"+CHR(13)+"'Send Quote'",0+16,"Close Send Quote")
			RETURN .F.
		ENDIF
		IF WEXIST('OrderEntry')
			=MESSAGEBOX("You must finish your work in"+CHR(13)+"'Order Entry'",0+16,"Close Order Entry")
			RETURN .F.
		ENDIF
		IF WEXIST('frmStockLst_SQL_Quotes')
			=MESSAGEBOX("You must finish your work in"+CHR(13)+"'Stock List'",0+16,"Close StockLst")
			RETURN .F.
		ENDIF
		IF WEXIST('frmChooseAlloySources')
			=MESSAGEBOX("You must finish your work.",0+16,"Close Choose Alloy screen.")
			RETURN .F.
		ENDIF
		IF WEXIST('frmSearchForm')
			=MESSAGEBOX("You must finish your work.",0+16,"Close Search Window.")
			RETURN .F.
		ENDIF
		
		IF WEXIST('frmStockLst_SQL_Quotes')
			=MESSAGEBOX("You must finish your work.",0+16,"Close StockLst.")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdFind.Click
		PRIVATE cReturnInqNumP, cCompanyName, cP, cQSL
		SELECT Quotes
		
		*This is a common 'Bad SQL Connetion' initiation point
		gnConnHandle = CheckSQLConnection(gnConnHandle)
		
		cCompanyName = Quotes.Company
		DO FORM forms\SearchQuotes WITH "QUOTES",cCompanyName TO cReturnInqNumP
		SELECT Quotes
		** do not AllTrim cReturnInqNumP
		
		PRIVATE cInqNum,cInqNumP
		
				
		IF VARTYPE(cReturnInqNumP) = "C"
			IF LEN(cReturnInqNumP)>1 AND NOT cReturnInqNumP = "-" && -   Means returned no selection
		
				IF USED('tmpSQL')
					USE IN tmpSQL
				ENDIF
		
				cP = RIGHT( ALLTRIM(cReturnInqNumP), 1)
				
				IF ALLTRIM(cP) = "'"
					*RecordError(0,"SalesP is '" ,PROGRAM(),LINENO(1),"SalesP is '"+cReturnInqNumP+"'" )
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"SalesP is ["+cReturnInqNumP+"]")
					cP = '*'
				ENDIF
				
				cInqnum = ALLTRIM(cReturnInqNumP)
				cInqnum = LEFT(cInqNum,LEN(cInqnum)-1)   && take SP out
				cInqnum = STRTRAN(cInqnum,"'"," ")
				cInqnum = PADL(cInqnum ,8," ")  && MUST USE LEFT SPACES!!!
				cInqNumP = cInqNum+cP			&&put SP back in
				
				DO CASE
				CASE gcSalesP = cP
					lRecNum = RECNO()
					LOCATE FOR InqNumP = cInqNumP
					IF NOT FOUND('Quotes') OR Quotes.SalesNum > 0
						*Go to SQL to get all related records!
						
						cSQL = "SELECT Company,inqDate,SalesNum FROM dbo.AllQuotes WHERE InqNumP = '"+cInqNumP+"'"
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpSQL')
						ENDIF
						**
						IF VARTYPE( gcQuotesOR ) = 'L' OR VARTYPE( gcQuotesOR ) = "U"
							gcQuotesOR = ' '
						ENDIF
						**
						IF USED('tmpSQL')
							IF tmpSQL.SalesNum > 0
								gcQuotesOR = " OR SalesNum=" + ALLTRIM(STR(tmpSQL.SalesNum)) 
							ELSE
								IF !EMPTY(tmpSQL.Company)
									IF ISNULL(tmpSQL.InqDate)
										gcQuotesOR = " OR ( Company = '"+STRTRAN(tmpSQL.COMPANY,"'","''")+"' AND SalesP='"+cP+"')"
									ELSE
										gcQuotesOR = " OR ( Company = '"+STRTRAN(tmpSQL.COMPANY,"'","''")
										gcQuotesOR = gcQuotesOR + "' AND InqDate >= '"+DTOC( tmpSQL.InqDate )+"' AND SalesP='"+cP+"')"
									ENDIF
								ELSE
									gcQuotesOR = gcQuotesOR + " OR InqNumP = '"+cInqNumP+"'"
								ENDIF
							ENDIF
						ENDIF
										
						gcSQL="SELECT * FROM dbo.AllQuotes "
						gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
						gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
						gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
						gcSQL=gcSQL + gcQuotesOR
						*gcSQL=gcSQL +" ORDER BY InqNumP"
						gcSQL=gcSQL +" ORDER BY InqDate"
		
						THISFORMSET.Quotes.LOCKSCREEN = .T.
						SELECT Quotes
						USE IN Quotes
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes') 
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF  
						IF nSQLEXEC < 0
							SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
						ENDIF
		
						LOCATE FOR InqNumP = cInqNumP
						ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
						THISFORMSET.Quotes.LOCKSCREEN = .F.
						
						IF NOT FOUND('Quotes')
							**Reset
							GOTO lRecNum
						ENDIF
					ENDIF
				CASE gcSalesP = "*"
					lRecNum = RECNO()
					LOCATE FOR InqNumP = cInqNumP
					IF NOT FOUND('Quotes')
		
						cSQL = "SELECT Company,inqDate,SalesNum FROM dbo.AllQuotes WHERE InqNumP = '"+cInqNumP+"'"
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSQL') 
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF  
						IF nSQLEXEC < 0
							SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpSQL')
						ENDIF
						**
						IF VARTYPE( gcQuotesOR ) = 'L' OR VARTYPE( gcQuotesOR ) = "U"
							gcQuotesOR = ''
						ENDIF
						**
						IF tmpSQL.SalesNum > 0
							gcQuotesOR = " OR SalesNum=" + ALLTRIM(STR(tmpSQL.SalesNum)) 
						ELSE
							IF !EMPTY(tmpSQL.Company)
								gcQuotesOR = " OR ( Company = '"+STRTRAN(tmpSQL.COMPANY,"'","''")+"' AND InqDate >= '"+DTOC( tmpSQL.InqDate )+"')"
							ELSE
								gcQuotesOR = gcQuotesOR + " OR InqNumP = '"+cInqNumP+"'"
							ENDIF
						ENDIF
						
						gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
						gcSQL=gcSQL +" WHERE InqDate > "+gcShowFromDate 
						gcSQL=gcSQL + gcQuotesOR
						*gcSQL=gcSQL +" ORDER BY InqNumP"
						gcSQL=gcSQL +" ORDER BY InqDate"
						
						THISFORMSET.Quotes.LOCKSCREEN = .T.
						SELECT Quotes
						USE IN Quotes
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF  
						IF nSQLEXEC < 0
							SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
						ENDIF
		
						LOCATE FOR InqNumP = cInqNumP
						ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
						THISFORMSET.Quotes.LOCKSCREEN = .F.
						
						IF NOT FOUND('Quotes')
							**Reset
							GOTO lRecNum
						ENDIF
					ENDIF
				OTHERWISE
					*Return someone else- Switch SalesP
					
					********************************************
					** Check with cmbFilterSalesP for changes **
					********************************************
								
					MESSAGEBOX("The record you selected belongs to "+cP+"."+CHR(13)+;
						"Their data will be retrieved now..."+CHR(13)+;
						"To get back to your data, Change the SalesP at the top.",0+64,"Change SalesP" )
						
					ThisFormSet.SalesP = cP
					ThisForm.cmbFilterSalesP.Value = cP
					ThisForm.SALESP1.Value = cP
					ThisForm.txtSalesP.Value = cP
					gcSalesP = cP
					
					
					lRecNum = RECNO()
					LOCATE FOR InqNumP = cInqNumP
					IF NOT FOUND('Quotes')
		
						cSQL = "SELECT Company,inqDate,SalesNum FROM dbo.AllQuotes WHERE InqNumP = '"+cInqNumP+"'"
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSQL') 
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF  
						IF nSQLEXEC < 0
							SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSQL')
						ENDIF
						**
						IF VARTYPE( gcQuotesOR ) = 'L' OR VARTYPE( gcQuotesOR ) = "U"
							gcQuotesOR = ''
						ENDIF
						**
						IF USED('tmpSQL')
							IF VARTYPE(tmpSQL.SalesNum) = "N"
								IF tmpSQL.SalesNum > 0
									gcQuotesOR = " OR SalesNum=" + ALLTRIM(STR(tmpSQL.SalesNum)) 
								ELSE
									IF !EMPTY(tmpSQL.Company)
										gcQuotesOR = " OR ( Company = '"+STRTRAN(tmpSQL.COMPANY,"'","''")+"' AND InqDate >= '"+DTOC( tmpSQL.InqDate )+"')"
									ELSE
										gcQuotesOR = gcQuotesOR + " OR InqNumP = '"+cInqNumP+"'"
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
						
					gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
					gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP="*","%"+"'",ALLTRIM(gcSalesP)+"'" )
					gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
					gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
					gcSQL=gcSQL + gcQuotesOR
					*gcSQL=gcSQL +" ORDER BY InqNumP"
					gcSQL=gcSQL +" ORDER BY InqDate"
					
					THISFORMSET.salesp = gcSalesP
		
					*Update the view
					ThisFormSet.Quotes.LockScreen = .T.
					SELECT Quotes
					*nCurInqNum = Quotes.InqNumP
					
					USE IN Quotes
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF  
					IF nSQLEXEC < 0
						SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
					ENDIF
					*LOCATE FOR InqNumP = nCurInqNum 
					ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
					ThisFormSet.Quotes.LockScreen = .F.			
		
					GO BOTTOM
			
					THISFORMSET.SetUserInfo(gcSalesP)
					
					SELECT Quotes
					LOCATE FOR InqNumP = cInqNumP
					IF NOT FOUND('Quotes')
							
						cSQL = "SELECT Company,inqDate FROM dbo.AllQuotes WHERE InqNumP = '"+cInqNumP+"'"
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF  
						IF nSQLEXEC < 0
							SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpSQL')
						ENDIF
						IF !EMPTY(tmpSQL.Company)
							gcQuotesOR = " OR ( Company = '"+STRTRAN(tmpSQL.COMPANY,"'","''")+"' AND InqDate >= '"+DTOC( tmpSQL.InqDate )+"')"
						ELSE
							*gcQuotesOR = gcQuotesOR + " OR InqNumP = '"+cInqNumP+"'" &&Do not carry over 'gcQuotesOR'
							gcQuotesOR = " OR InqNumP = '"+cInqNumP+"'"
						ENDIF
		
						gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
						gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
						gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
						gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
						gcSQL=gcSQL + gcQuotesOR
						*gcSQL=gcSQL +" ORDER BY InqNumP"
						gcSQL=gcSQL +" ORDER BY InqDate"
						
						THISFORMSET.Quotes.LOCKSCREEN = .T.
						SELECT Quotes
						USE IN Quotes
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes') 
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, GcSQL, "Quotes")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, GcSQL, "Quotes")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF  
						IF nSQLEXEC < 0
							SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
						ENDIF
		
						LOCATE FOR InqNumP = cInqNumP
						ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
						THISFORMSET.Quotes.LOCKSCREEN = .F.
						
						IF NOT FOUND('Quotes')
							**Reset
							Go Bottom
							MESSAGEBOX("Any Key to continue.",0+48,"Not Found!")
						ENDIF
					ENDIF
				ENDCASE	
				IF USED('tmpSQL')
					USE IN tmpSQL
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()
		
		ThisFormSet.Refresh
	ENDPROC

	PROCEDURE QUOTES.cmdFind.Valid
		ThisFormSet.Refresh
	ENDPROC

