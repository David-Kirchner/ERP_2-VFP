	PROCEDURE QUOTES.OtherP1.GotFocus
		WITH ThisForm.tempfield
			.Alignment = 2
			.Height = This.Height
			.Left = This.Left
			.Width = This.Width
			.Value = STR(This.Value,10,4)
			.Top = This.Top
			.Enabled = .T.
			.Visible = .T.
			.TabIndex = This.TabIndex
		ENDWITH
		
		*ThisFormSet.MetricGOTFocus  = "OtherP1"
		
		ThisForm.tempfield.SetFocus()
		
		
	ENDPROC

