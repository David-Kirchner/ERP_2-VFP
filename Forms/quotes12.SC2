	PROCEDURE removeordercheckso
		*ThisformSet.RemoveOrderCheckSO()
		
		PRIVATE lOK2Remove
		lOK2Remove = .T.
		ThisFormset.frmRemoveORDER.cmdYes.Enabled = .F.
		
		*** Add Rules here
		* Must be SalesPerson or Admin
		PRIVATE nSalesNum
		nSalesNum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		IF HaveSODeletePermission(nSalesNum)
			lOK2Remove = .T.
		ELSE
			lOK2Remove = .F.
		ENDIF
		
		* Must be no Packingslip entry
		IF lOK2Remove
			IF Count_SOinPackingSlip_No( nSalesNum, gnConnHandle ) = 0
				lOK2Remove = .T.
				WAIT CLEAR
			ELSE
				lOK2Remove = .F.
				WAIT WINDOW 'Found Packing Slip - Cannot Delete!' NOWAIT
			ENDIF
		ENDIF
		
		*!*	IF lOK2Remove
		*!*		IF Cancel_SO( nSalesNum, gnConnHandle)
		*!*			lOK2Remove = .T.
		*!*		ELSE
		*!*			lOK2Remove = .F.
		*!*		ENDIF
		*!*	ENDIF
		
		IF lOK2Remove
		*	SELECT Quotes
		*	REPLACE Quotes.SalesNum WITH 0
		*	ThisFormSet.nSalesnum = 0
			ThisFormset.frmRemoveORDER.cmdYes.Enabled = .T.
		ENDIF
		
		RETURN lOK2Remove 
	ENDPROC

