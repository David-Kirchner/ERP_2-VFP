	PROCEDURE QUOTES.pf1.PageQA.cmdPrintQA.Click
		PRIVATE nQuote_No_ID
		nQuote_No_ID = PrepareSQLnum( This.parent.txtQuote_No_ID.Value, "Quote_No", -3)
		
		IF nQuote_No_ID > 0
			
			PRIVATE cSQL, nSQLEXEC 
			IF USED("Quote_No")
				USE IN Quote_No
			ENDIF
		
			SELECT 0
			cSQL = "SELECT * FROM [dbo].[Quote_No] "
			cSQL = cSQL + " WHERE ID = "+STR(nQuote_No_ID)
		
		
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quote_No' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quote_No' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Quote_No")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Quote_No")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle,nSQLEXEC,'Quote_No' )
			ENDIF
		
			IF USED("Quote_No")
				IF NOT "PRINTPREVIEW" $ SET("CLASSLIB")  &&Added for when Quotes is run without HPA menu.
					SET CLASSLIB TO Libs\PrintPreview ADDITIVE
				ENDIF
				oPForm = CREATEOBJECT('PrintPreview')
				oPform.Visible = .T. 
		
				REPORT FORM Reports\Quote_No PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview
				
				IF VARTYPE(oPform) = "O"
					oPform.Visible = .F.
					RELEASE ALL LIKE oPform
				ENDIF
		
				USE IN Quote_No
			ENDIF
		
		ENDIF
		
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageQA.cmdPrintQA.When
