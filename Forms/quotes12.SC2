	PROCEDURE QUOTES.pf1.PagePricing.cmbPU.Valid
		
		PRIVATE cQuotesCompany, cHoldQuotesName, nCustID, nPU
		cQuotesCompany	= PrepareSQLtxt(QUOTES.Company,'Company',30)
		cCustID			= PrepareSQLtxt(ThisForm.CustID1.Value,'CustID',20)
		nPU				= PrepareSQLnum(This.Value,'PU',1)
		
		IF nPU >= 0 AND nPU <= 6
			*0,NA,1,$/#,2,$/FT,3,$/PC,4,$/Lot,5,$/Inch,6,Remove
			
			cSQL = "UPDATE dbo.QuickCompany "
			IF nPU = 6
				cSQL = cSQL + " SET PU=0"
			ELSE
				cSQL = cSQL + " SET PU="+STR( nPU )
			ENDIF
			
			cSQL = cSQL + " WHERE Company LIKE '"+cQuotesCompany+"%'"
			IF NOT EMPTY(cCustID)
				cSQL = cSQL + " AND Customer = '"+cCustID+"'"
			ENDIF
			
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle, nSQLEXEC  )
			ENDIF
			
			IF nPU = 6
				This.Value = 0 &&Not on the list!!!
			ENDIF
		ENDIF
	ENDPROC

