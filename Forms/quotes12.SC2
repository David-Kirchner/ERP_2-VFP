	PROCEDURE QUOTES.Init
		PRIVATE cUserName
		ThisFormSet.Select4Order1.Enabled = .F.
		ThisFormSet.Select4Order1.Visible = .F.
		
		
		
		*isediting,isadding,
		ThisFormSet.isediting = .F.
		ThisFormSet.isadding = .F.
		ThisFormSet.CompanyChanged = .F.
		
		IF "\MEM" $ SYS(2003)
			IF FILE(SYS(5)+SYS(2003) +"\autoname.mem")
				RESTORE FROM (SYS(5)+SYS(2003) +"\autoname.mem") ADDITIVE
				cUserName = AppSetup_Get_UserName(gcSalesP)
				IF m.autoname = "ON"
					AppSetup_Update_Ans( "ON", cUserName, "AutoName", gnConnHandle)
				ELSE
					AppSetup_Update_Ans( "OFF", cUserName, "AutoName", gnConnHandle)
				ENDIF
				RELEASE m.AutoName
				DELETE FILE SYS(5)+SYS(2003) +"\autoname.mem"
			ENDIF
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\MEM\autoname.mem")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\autoname.mem") ADDITIVE
				cUserName = AppSetup_Get_UserName(gcSalesP)
				IF m.autoname = "ON"
					AppSetup_Update_Ans( "ON", cUserName, "AutoName", gnConnHandle)
				ELSE
					AppSetup_Update_Ans( "OFF", cUserName, "AutoName", gnConnHandle)
				ENDIF
				RELEASE m.AutoName
				DELETE FILE SYS(5)+SYS(2003) +"\MEM\autoname.mem"
			ENDIF
		ENDIF
		
		IF AppSetup_Get_AutoName(gcSalesP)
			ThisFormSet.AutoName = .T.
			ThisForm.cmdAutoName.Picture = "graphics\spell.bmp"
		ELSE
			ThisFormSet.AutoName = .F.
			ThisForm.cmdAutoName.Picture = "graphics\strikthr.bmp"
		ENDIF
		
		
		
		ThisFormSet.SetUserInfo( gcSalesP )
		
		
		SELECT Quotes
		
		ThisForm.pf1.PagePricing.cmbBracket.Value = Quotes.bracket
		ThisForm.cmbCC.Value = Quotes.CC
		ThisForm.cmbCL.Value = Quotes.CL
		
		IF Quotes.StartStock 
			ThisFormset.QUOTES.lblStartingStock.BackColor = RGB(255,255,128)
		ELSE
			ThisFormset.QUOTES.lblStartingStock.BackColor = RGB(192,192,192)
		ENDIF
		
		ThisFormSet.StockLst_Sum_Reload()
		
		ThisFormSet.QuotesRecordChanged()
		ThisFormSet.RefreshForms()
		
		ThisForm.cmbForm.Refresh
		ThisForm.cmbCC.Refresh
		ThisForm.cmbCL.Refresh
		
		ThisForm.cmdEdit.SetFocus()
		
	ENDPROC

