	PROCEDURE QUOTES.pf1.PagePricing.lblCommSpec.Click
		IF ThisFormSet.isediting AND NOT EMPTY(This.Caption)
			IF 48-LEN(ALLTRIM(ThisForm.DESCRIPT1.Value)) < LEN(ALLTRIM(This.Caption))
				IF EMPTY(ThisForm.Comments.Value)
					ThisForm.Comments.Value = ALLTRIM(This.Caption)
				ELSE
					ThisForm.Comments.Value = ThisForm.Comments.Value+CHR(10)+ALLTRIM(This.Caption)
				ENDIF
				ThisForm.Comments.Refresh
			ELSE
				IF LEN(ALLTRIM(ThisForm.DESCRIPT1.Value)) = 0
					ThisForm.DESCRIPT1.Value = ALLTRIM(This.Caption)
				ELSE
					ThisForm.DESCRIPT1.Value = ALLTRIM(ThisForm.DESCRIPT1.Value)+" "+ALLTRIM(This.Caption)
				ENDIF
				ThisForm.DESCRIPT1.Refresh
			ENDIF
		ENDIF
	ENDPROC

