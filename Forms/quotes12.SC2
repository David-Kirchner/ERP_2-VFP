	PROCEDURE QUOTES.pf1.PageQA.chkRegret.Click
		
		PRIVATE nQuotesID
		nQuotesID = Quotes.ID
		
		PRIVATE lRegret
		lRegret = PrepareSQLlogic(This.Value,'Regret',.F.)
		
		PRIVATE cUpdate
		cUpdate = "UPDATE dbo.AllQuotes SET "
		cUpdate = cUpdate + " Regret="+IIF(lRegret,'1','0')
		cUpdate = cUpdate + " WHERE AllQuotes.ID = " + ALLTRIM(STR(nQuotesID))
		
		nSQLEXEC = SQLEXEC(gnConnHandle,cUpdate)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
		ELSE
			SELECT Quotes
			Replace Regret WITH lRegret
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.pf1.PageQA.chkRegret.When
		*RETURN ThisFormSet.isediting
	ENDPROC

