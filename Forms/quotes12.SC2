	PROCEDURE QUOTES.Destroy
		ON KEY
		ON SHUTDOWN
		
		*RELEASE PROCEDURE Proc_Quotes
		
		IF FILE(SYS(5)+SYS(2003) +"\QuotesSet.Mem")
			TRY
			DELETE FILE (SYS(5)+SYS(2003) +"\QuotesSet.MEM")
			ENDTRY
		ENDIF
		IF FILE(SYS(5)+SYS(2003) +"\MEM\QuotesSet.Mem")
			TRY
			DELETE FILE (SYS(5)+SYS(2003) +"\MEM\QuotesSet.MEM")
			ENDTRY
		ENDIF
		
		*!*	IF USED('Customer')
		*!*		USE IN Customer
		*!*	ENDIF
		IF USED('Stocklst')
			USE IN Stocklst
		ENDIF
		IF USED('Alloy')
			USE IN Alloy
		ENDIF
		IF USED('Alloys')
			USE IN Alloys
		ENDIF
		IF USED('Hardness')
			USE IN Hardness
		ENDIF
		IF USED('PriceTable')
