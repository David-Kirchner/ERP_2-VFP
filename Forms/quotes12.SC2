		*GOTO RECORD RECNO('tmpSources') IN tmpMark
		*ThisForm.grdMark.Refresh
	ENDPROC

	PROCEDURE frmSelectSendInq.Resize
		PRIVATE nHeight, nWidth
		
		nHeight = This.Height - 307
		nWidth	= This.Width - 669
		
		PRIVATE nHalfHeight1, nHalfHeight2
		nHalfHeight1 = FLOOR( nHeight/2 )
		nHalfHeight2 = CEILING( nHeight/2 )
		
		ThisForm.grdSource.Width = 669 + nWidth
		
		ThisForm.cmdSend.Left = 555 + nWidth
		ThisForm.cmdCancel.Left = 555 + nWidth
		ThisForm.edtNotes.Width = 468 + nWidth
		
		
		ThisForm.grdSource.Height = 144 + nHalfHeight1 
		
		ThisForm.cmdSend.Top = 194 + nHalfHeight2 
		ThisForm.cmdCancel.Top = 242 + nHalfHeight2 
		ThisForm.edtNotes.Top = 158 + nHalfHeight2 
		
		ThisForm.edtNotes.Height = 144 + nHalfHeight2 
	ENDPROC

	PROCEDURE frmSendInquire.cmdAdd.Click
		Private m.cmp
		ThisFormSet.SendInquire_Qbody()
		
		ThisFormSet.nInquireSelectSend=ThisFormSet.nInquireSelectSend+1
		DIMENSION paQuotesInqNo(ThisFormSet.nInquireSelectSend)
		paQuotesInqNo(ThisFormSet.nInquireSelectSend)= Quotes.INQNUM
		
		WAIT WINDOW "past record was ADDED - this record is ready to be accepted" NOWAIT
		
		SELECT Quotes
		
		M.CMP = Quotes.COMPANY
		IF NOT EOF()
			SKIP 1
			IF NOT EOF()
				IF M.CMP <> Quotes.COMPANY
					WAIT WINDOW "record was ADDED - last of this company" NOWAIT
					SKIP -1
				ELSE
		*			SHOW GETS LEVEL 1
				ENDIF
			ELSE
				WAIT WINDOW "record was ADDED - LAST RECORD!" NOWAIT
				SKIP -1
			ENDIF	
		ELSE
			WAIT WINDOW "record was ADDED - LAST RECORD!" NOWAIT
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()
		
		*ThisFormSet.SendInquire_Firstadd = .F.
		ThisForm.cmdEdit.Enabled=.T.
		ThisForm.cmdSend.Enabled=.T.
		
		*ThisForm.Refresh
		ThisFormSet.Quotes.refresh
	ENDPROC

	PROCEDURE frmSendInquire.cmdAddAll.Click
		PRIVATE m.Recn, m.Company, m.INQdate
		WAIT WINDOW "PLEASE WAIT" NOWAIT
		SELECT Quotes
		M.RECN = RECNO()
		M.COMPANY = Quotes.COMPANY
		M.INQDATE = Quotes.INQDATE
		SET FILTER TO COMPANY=M.COMPANY AND INQDATE=M.INQDATE
		GO TOP
		
		DO WHILE NOT EOF()
			ThisFormSet.SendInquire_Qbody() 
		
			ThisFormSet.nInquireSelectSend=ThisFormSet.nInquireSelectSend+1
			DIMENSION paQuotesInqNo(ThisFormSet.nInquireSelectSend)
			paQuotesInqNo(ThisFormSet.nInquireSelectSend)=Quotes.INQNUM
		
			SELECT Quotes
			SKIP IN Quotes
		ENDDO
		
		SET FILTER TO
		WAIT WINDOW "ADDED ALL" NOWAIT
		
		SELECT Quotes
		GOTO M.RECN
		
		*ThisFormSet.SendInquire_Firstadd = .F.
		ThisForm.cmdEdit.Enabled=.T.
		ThisForm.cmdSend.Enabled=.T.
		
		ThisForm.cmdEdit.SetFocus
		*ThisForm.Refresh
		ThisFormSet.Quotes.refresh
	ENDPROC

	PROCEDURE frmSendInquire.cmdAttachFile.Click
		*CREATE TABLE (SYS(5)+SYS(2003)+"\QuoteAttach.DBF") FREE (UNCFile C(254))
		*USE (SYS(5)+SYS(2003)+"\QuoteAttach.DBF") EXCL
		
		ThisForm.Visible = .F.
		DO FORM Forms\QuoteAttach
		ThisForm.Visible = .T.
		
		IF USED('QuoteAttach')
			
			ThisForm.lstAttach.Clear
			ThisForm.lstAttach.Visible = .F.
			
			SELECT QuoteAttach
			SCAN
				IF NOT EMPTY(QuoteAttach.UNCFile)
					ThisForm.lstAttach.Visible = .T.
					ThisForm.lstAttach.AddItem(QuoteAttach.FileName)
				ENDIF
			ENDSCAN
			ThisForm.lstAttach.Refresh
		ENDIF
	ENDPROC

	PROCEDURE frmSendInquire.cmdAttachFile.OLECompleteDrag
