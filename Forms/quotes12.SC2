	PROCEDURE frmQAQuote.cmdPrintQAQuote.Click
		*ThisForm.LoadQuote_No()
		*LoadQuote_No()
		PRIVATE nQuote_No_ID 
		nQuote_No_ID = PrepareSQLnum(ThisForm.txtQuote_No_ID.Value,"Quote_No",-3)
		
		IF nQuote_No_ID > 0
			PRIVATE cSQL, nSQLEXEC 
			
			*****************************
			
			IF USED("Quotes_No_Addr")
				USE IN Quotes_No_Addr
			ENDIF
			
			cSQL = "SELECT * "
			cSQL = cSQL + " FROM [dbo].[Quote_No_Addr] QN WITH(NOLOCK) WHERE Quote_No_ID = "+STR(nQuote_No_ID)
			
			SELECT 0
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quotes_No_Addr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quotes_No_Addr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Quotes_No_Addr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Quotes_No_Addr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle,nSQLEXEC, 'Quotes_No_Addr')
			ENDIF
				
			*****************************
			
			IF USED("Quotes_QA")
				USE IN Quotes_QA
			ENDIF
			
			cSQL = "SELECT QN.revision,QN.ExpireDate,QN.ProdReqDefine,QN.DiffResolved,QN.HPAcapable,QN.Comments"
		*,Inqnum,SalesP
			cSQL = cSQL + ",QN.InqNumP,QN.InitDate,QN.Contents "
			cSQL = cSQL + " FROM [dbo].[Quote_No] QN WITH(NOLOCK) WHERE ID = "+STR(nQuote_No_ID)
			
			SELECT 0
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quotes_QA')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Quotes_QA')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Quotes_QA")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Quotes_QA")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle,nSQLEXEC, 'Quotes_QA')
			ENDIF
			
			SELECT Quotes_QA
			
			**********************
		
			IF FILE('\REPORTS\quoteReprint.FRX')
				REPORT FORM \reports\quoteReprint NOCONSOLE TO PRINTER PROMPT
				WAIT WINDOW 'PRINTED' NOWAIT
			ELSE
				IF FILE('REPORTS\quoteReprint.FRX')
					REPORT FORM reports\quoteReprint NOCONSOLE TO PRINTER PROMPT
					WAIT WINDOW 'PRINTED' NOWAIT
				ELSE
					WAIT WINDOW 'Report form not found' NOWAIT
				ENDIF
			ENDIF
		
			**********************
		
			IF USED("Quotes_QA")
				USE IN Quotes_QA
			ENDIF
			IF USED("Quotes_No_Addr")
				USE IN Quotes_No_Addr
			ENDIF
		
		ELSE
			MESSAGEBOX(" No nQuote_No_ID to Print ")
		ENDIF
		
		SELECT Quotes
		
		
	ENDPROC

