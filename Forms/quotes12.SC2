	PROCEDURE QUOTES.pf1.PageQuote.edtQuotememo.OLEDragDrop
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord
		
		*RETURN ThisFormSet.isediting
		
		
		LOCAL lcString,lo,loX,loItem,lcText
		TRY
			IF oDataObject.GETFORMAT( 1 )
				lcString = oDataObject.GETDATA( 1)
				
				IF MEMLINES(lcString) > 0 AND "Subject"$MLINE(lcString,1)
					lo = CREATEOBJECT("outlook.application")
					loX = lo.ActiveExplorer
					loItem = lox.Selection.Item(1)
					** loItem is now a pointer to the mail item
					lcText = loItem.Body
					*ThisFormset.QUOTES.Userinfo1.salesp
					*gcSalesP
					*AddQuotedFromEmailDrop( lcText, gnConnHandle, Quotes.SalesP )
					
					*UPDATE
					PRIVATE cQuoteMemo
					cQuoteMemo  = ShowSQLtxt(This.Parent.edtQuoteMemo.Value,'QuoteMemo',-1)
					*ShowSQL before running PrepareSQL!
					
					lcText = StripHTML(lcText)
					cQuoteMemo  = PrepareSQLtxt(cQuoteMemo+CHR(13)+lcText ,'QuoteMemo',-1)
					
					PRIVATE cUpdate,nSQLEXEC 
					cUpdate = "UPDATE dbo.AllQuotes SET "
					cUpdate = cUpdate + " QuoteMemo='"+cQuoteMemo+"'"
					cUpdate = cUpdate + " WHERE AllQuotes.ID = " + ALLTRIM(STR(Quotes.ID))
					
					nSQLEXEC = SQLEXEC(gnConnHandle,cUpdate)
						
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
					ELSE
						This.Parent.edtQuoteMemo.Value = cQuoteMemo
					ENDIF
					
				ENDIF
			ENDIF
		
		CATCH
			MESSAGEBOX("Only works with MS Outlook installed!",0+16,"Cannot process Email Drop")
			
		ENDTRY
		
	ENDPROC

