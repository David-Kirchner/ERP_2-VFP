	PROCEDURE QUOTES.Comments.OLEDragDrop
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord
		*IF NOT ThisFormSet.isediting
		IF oDataObject.GETFORMAT( 1 )
			lc = oDataObject.GETDATA( 1)
		
			IF MEMLINES(lc) >= 3 AND "Subject"$MLINE(lc,1)
				lo = CREATEOBJECT("outlook.application")
				loX = lo.ActiveExplorer
				loItem = loX.SELECTION.ITEM(1)
				** loItem is now a pointer to the mail item
				lcText = loItem.Body
		
				IF "This form was submitted on your website" $ lcText
					lnFrom = AT('This form was submitted on your website',lcText, 1)
					lcBody = RIGHT( lcText, LEN(lcText) -lnFrom -38 )	
				ENDIF	
				
				lcBody = STRTRAN( lcBody, CHR(13), "")
				lcBody = STRTRAN( lcBody, CHR(10), "")
				
				
				IF LEN(lcBody) > 0		
					*This.Value = "-/\-"+CHR(10)+CHR(13)+lcBody+CHR(10)+CHR(13)+"-\/-"
					*WAIT WINDOW 'AddQuoteFromEmailDrop' NOWAIT 
					*Proc_Quotes
					IF AddQuoteFromEmailDrop( lcBody, gnConnHandle, Quotes.SalesP )
						WAIT WINDOW "Refresh Records" TIMEOUT 1
						ThisFormSet.RefreshAllQuotes(.F.)
						ThisForm.pf1.PageQuote.SetFocus
						
					ENDIF
				ENDIF
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.Comments.When
		IF ThisFormSet.isediting
			ThisFormSet.MetricGOTFocus  = "COMMENTS"
			ThisFormSet.GOTFocusLast  = "COMMENTS"
		ENDIF
		RETURN ThisFormSet.isediting
	ENDPROC

	PROCEDURE QUOTES.COMPANY1.GotFocus
		ThisFormSet.ICustID = Quotes.CustID
		ThisFormSet.IName = Quotes.Name
		ThisFormSet.ICompany = Quotes.Company
	ENDPROC

	PROCEDURE QUOTES.COMPANY1.InteractiveChange
		PRIVATE lSearchFound
		lSearchFound = .F.
		
		PRIVATE lnInsertionPt, lcSearchStr, lcSearchStrSQL
		lnInsertionPt = IIF(this.SelStart=0,30,this.SelStart)
		lcSearchStr = substr(this.value,1,lnInsertionPt)
		*lcSearchStrSQL = PrepareSQLtxt(lcSearchStr,'Company',30)
		lcSearchStrSQL = STRTRAN(lcSearchStr,"'","''")
		
		PRIVATE lcName, llFoundName
		lcName = ALLTRIM(PrepareSQLtxt(ThisForm.NAME1.Value,'Name',25))
		llFoundName = .F.
		
		IF !empty(lcSearchStr)
			IF USED('tmpQcompanyComp')
				USE IN tmpQcompanyComp
			ENDIF
		
			IF NOT EMPTY(lcName)
				*Find Name and Company
				cSQL = "SELECT company "
				cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '"+lcSearchStrSQL+"%'"  &&Do not TRIM! Interactive means user is still typing in new charaters.
				cSQL = cSQL + " AND Name LIKE '"+lcName+"%'"
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompanyComp' )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompanyComp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompanyComp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompanyComp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompanyComp')
				ENDIF
				IF USED('tmpQcompanyComp')
					IF VARTYPE( tmpQcompanyComp.Company ) = "C"
						IF NOT EMPTY(tmpQcompanyComp.Company)
							this.VALUE = tmpQcompanyComp.company			
							=insmode(.f.)
							llFoundName = .T.
						ENDIF
					ENDIF
				ENDIF		
			ENDIF	
				
			IF NOT llFoundName
			
				cSQL = "SELECT company "
				cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '"+lcSearchStrSQL+"%'"  &&Do not TRIM!
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompanyComp' )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompanyComp' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompanyComp")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompanyComp")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompanyComp')
				ENDIF
				IF USED('tmpQcompanyComp')
					IF RECCOUNT('tmpQcompanyComp') > 0
						IF NOT EMPTY(tmpQcompanyComp.Company)
							this.VALUE = tmpQcompanyComp.company
		*					REPLACE quotes.custid with tmpQcompanyXcomp.Customer IN Quotes
							=insmode(.f.)
						ELSE
							this.value=lcSearchStr
							ThisFormSet.CompanyChanged = .T.
							=insmode(.t.)
						ENDIF
					ELSE
						this.value=lcSearchStr
		*				REPLACE quotes.custid with "" IN Quotes
						ThisFormSet.CompanyChanged = .T.
						=insmode(.t.)
					ENDIF
					USE IN tmpQcompanyComp
				ELSE
					this.value=lcSearchStr
					ThisFormSet.CompanyChanged = .T.
					=insmode(.t.)
				ENDIF
			ENDIF
		ENDIF
		
		this.selstart = lnInsertionPt
		
	ENDPROC

	PROCEDURE QUOTES.COMPANY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE QUOTES.COMPANY1.Valid
		PRIVATE lCorrectCompanyandName, nQcompMatches, cHoldQuotesCompany, cHoldQuotesName
		PRIVATE cHoldQcompanyName, cHoldQcompanyCompany, nHoldQcompanyRecord, nQcompanyMax, cQuotesCompany
		PRIVATE m.QcompanyID, m.tCompName, cQIDComp, cQIDName
		
		nQcompMatches = 0
		cHoldQuotesCompany = ThisForm.Company1.Value
		cQuotesCompany	= ALLTRIM(PrepareSQLtxt(cHoldQuotesCompany,'Company',30))
		cHoldQuotesName	= ALLTRIM(PrepareSQLtxt(ThisForm.Name1.Value,'Name',25))
		lCorrectCompanyandName = .F.
		PRIVATE cNewfromQcompNAME
		cNewfromQcompNAME = ""
				
		IF NOT EMPTY(cQuotesCompany)
			PRIVATE nSQLEXEC, cSQL
			
			IF USED('tmpQcompany')
				USE IN tmpQcompany
			ENDIF
			*Customer is Sage ID name
			cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID, Notes "
			cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '"+cQuotesCompany+"%'"
			IF NOT EMPTY(cHoldQuotesName)
				cSQL = cSQL + " AND [NAME] Like '"+ALLTRIM(cHoldQuotesName)+"%'"  &&Alltrim here because user has finished typing the name.
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0  &&Try again. Problem query.
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
			ENDIF
			
			IF USED('tmpQcompany')
				IF RECCOUNT('tmpQcompany') = 0
					*Try again
					cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID, Notes "
					cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '%"+cQuotesCompany+"%'"
					cSQL = cSQL + " ORDER BY [Name]"
					SELECT 0
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
					ENDIF
				ENDIF
			ENDIF
			
			IF USED('tmpQcompany')
				IF RECCOUNT('tmpQcompany') > 1
					GO TOP
					SCAN
						cNewfromQcompNAME = PrepareSQLtxt(tmpQcompany.NAME,'Name',25)
					
						IF cHoldQuotesName $ cNewfromQcompNAME 
							*found Company and correct name
							lCorrectCompanyandName = .T.
							ThisForm.PHONE1.Value	= tmpQcompany.phone
							ThisForm.EXT1.Value		= tmpQcompany.Phone_ext
							ThisForm.FAX1.Value		= tmpQcompany.Fax
							ThisForm.Email1.Value	= tmpQcompany.Email
							ThisForm.CountryCode1.Value	= tmpQcompany.CountryC
							
							ThisForm.CustID1.Value	= PrepareSQLtxt(tmpQcompany.Customer,'Customer',20)
							IF NOT EMPTY(ThisForm.CustID1.Value)
								ThisFormSet.ShowCustomerTerms("NOWAIT")
							ENDIF
							
							IF ISNULL(tmpQcompany.Notes)
								ThisFormset.frmCustomer.edtCustomer.Value = ''
							ELSE
								ThisFormset.frmCustomer.edtCustomer.Value = tmpQcompany.Notes 
							ENDIF
							ThisFormset.frmCustomer.edtCustomer.ReadOnly = .T.
							ThisFormset.frmCustomer.cmdEditSave.Caption = "Edit"
							
							*******
							EXIT
						ENDIF
					ENDSCAN
		
		
					IF lCorrectCompanyandName
		
					ELSE
						SELECT tmpQcompany  &&tmpQcompn
						GO TOP
						
						DO FORM FORMS\QcompanyID TO m.QcompanyID    &&m.QcompanyID is Company30+Name25+xtra
		
						IF NOT EMPTY(ALLTRIM(m.QcompanyID))
							tCompName = LEFT( m.QcompanyID,55 ) 
							cQIDComp = PrepareSQLtxt(LEFT( m.QcompanyID,30 ),'Company',30)
							*cQIDName = PrepareSQLtxt(RIGHT( tCompName ,25 ),'Name',25)
							cQIDName = PrepareSQLtxt(SUBSTR( tCompName,31,25 ),'Name',25)
							tcID10 	 = RIGHT(m.QcompanyID,10)
							
							IF RIGHT(m.QcompanyID,8)="keepname"
								IF USED('tmpQcompany')
									USE IN tmpQcompany
								ENDIF
								
								cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer "
								cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '"+RTRIM(cQIDComp)+"%'"
								cSQL = cSQL + " AND Name LIKE '"+RTRIM(cQIDName)+"%'"
								cSQL = cSQL + " ORDER BY [Name]"
								
								SELECT 0
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
								
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
								ENDIF
								IF USED('tmpQcompany')
									IF RECCOUNT('tmpQcompany') > 0	
										*found Company and correct name
										lCorrectCompanyandName = .T.
										ThisForm.PHONE1.Value	= tmpQcompany.phone
										ThisForm.EXT1.Value		= tmpQcompany.Phone_ext
										ThisForm.FAX1.Value		= tmpQcompany.Fax
										ThisForm.Email1.Value	= tmpQcompany.Email
										ThisForm.CountryCode1.Value	= tmpQcompany.CountryC
										ThisForm.CustID1.Value	= tmpQcompany.Customer
										ThisForm.COMPANY1.Value	= tmpQcompany.Company 
		
									ENDIF
									USE IN tmpQcompany
								ENDIF			
							ELSE &&Replace Name
								IF USED('tmpQcompany')
									USE IN tmpQcompany
								ENDIF
								
								cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID "
								cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '"+RTRIM(cQIDComp)+"%'"
								cSQL = cSQL + " AND [Name] LIKE '"+RTRIM(cQIDName)+"%'"
								*cSQL = cSQL + " ORDER BY [Name]"
								
								SELECT 0
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
								
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
								ENDIF
								IF USED('tmpQcompany')
									IF RECCOUNT('tmpQcompany') > 0
										ThisForm.PHONE1.Value	= tmpQcompany.phone
										ThisForm.EXT1.Value		= tmpQcompany.Phone_ext
										ThisForm.FAX1.Value		= tmpQcompany.Fax
										ThisForm.Email1.Value	= tmpQcompany.Email
										ThisForm.CountryCode1.Value	= tmpQcompany.CountryC
										ThisForm.CustID1.Value	= tmpQcompany.Customer
										ThisForm.COMPANY1.Value	= tmpQcompany.Company 
										ThisForm.NAME1.Value	= tmpQcompany.NAME
									ENDIF
									USE IN tmpQcompany
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ELSE  &&RECCOUNT('tmpQcompany') > 1
					IF RECCOUNT('tmpQcompany') = 1
						*** ONLY ONE RECORD for This ID
						IF NOT ALLTRIM(cHoldQuotesName) $ cNewfromQcompNAME  AND !EMPTY(cHoldQuotesName )
							IF SOUNDEX(LEFT(cHoldQuotesName,5)) = SOUNDEX(LEFT(cNewfromQcompNAME ,5))
								nAns = MESSAGEBOX("I found a smiliar sounding name used for this company "+TRIM(cHoldQuotesCompany)+CHR(13)+;
									"Answer (Yes) to keep the name you entered "+TRIM(cHoldQuotesName)+CHR(13)+;
									"              and correct the other name in the system."+CHR(13)+;
									"Answer (No) to use the name found in the system "+TRIM(cHoldQuotesName)+CHR(13)+;
									"(Cancel) to use the name you entered and leave the other name alone.",3+32,"Found duplicate names.")
								IF nAns = 2 &&Cancel
								ENDIF
								IF nAns = 6 &&Yes
									IF !THISFORMSET.FoundXcomp( tmpQcompany.phone+SOUNDEX(tmpQcompany.NAME) )
																		
										cSQL = "UPDATE dbo.QuickCompany SET "
										cSQL = cSQL + " [NAME] = '"+cNewfromQcompNAME +"'"
										cSQL = cSQL + " WHERE [NAME] = '"+cHoldQuotesName+"'"
										cSQL = cSQL + " AND [Company] = '"+cHoldQuotesCompany+"'"
										
										nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
										
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL' TIMEOUT 1
											nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
										ENDDO
										IF nSQLEXEC < 0 &&Try again!
											nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL 2' TIMEOUT 1
												nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
												
												IF nSQLEXEC < 0
													IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
														nSQLEXEC = 0
													ENDIF
												ENDIF
											ENDDO
										ENDIF 
										IF nSQLEXEC < 0
											SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
										ENDIF								
										**
										cHoldQcompanyName	= cNewfromQcompNAME 
										cHoldQcompanyCompany = tmpQcompany.company
									ENDIF
								ENDIF
								IF nAns = 7 &&No
									ThisForm.NAME1.Value = tmpQcompany.NAME
								ENDIF
							ELSE
								IF NOT EMPTY( ThisForm.PHONE1.Value + ThisForm.FAX1.Value	)
									WAIT WINDOW "Found a new name, no replacements" NOWAIT
								ELSE
									ThisForm.PHONE1.Value	= tmpQcompany.phone
									ThisForm.EXT1.Value		= tmpQcompany.Phone_ext
									ThisForm.FAX1.Value		= tmpQcompany.Fax
									ThisForm.Email1.Value	= tmpQcompany.Email
									ThisForm.CountryCode1.Value	= tmpQcompany.CountryC
									ThisForm.CustID1.Value	= tmpQcompany.Customer
			*							ThisForm.COMPANY1.Value	= tmpQcompany.Company 
			*							ThisForm.NAME1.Value	= tmpQcompany.NAME
								ENDIF
							ENDIF
						ELSE  && cHoldQuotesName = tmpQcompanyXcomp.Name AND !EMPTY(cHoldQuotesName )
							IF RECCOUNT('tmpQcompany') > 0
								ThisForm.PHONE1.Value	= tmpQcompany.phone
								ThisForm.EXT1.Value		= tmpQcompany.Phone_ext
								ThisForm.FAX1.Value		= tmpQcompany.Fax
								ThisForm.Email1.Value	= tmpQcompany.Email
								ThisForm.CountryCode1.Value	= tmpQcompany.CountryC
								ThisForm.CustID1.Value	= tmpQcompany.Customer
								ThisForm.COMPANY1.Value	= tmpQcompany.Company 
								ThisForm.NAME1.Value	= tmpQcompany.NAME
							ELSE
								WAIT WINDOW "Not in QuickCompany yet!" NOWAIT
							ENDIF				
						ENDIF
					ELSE
						*No records!
						
					ENDIF
				ENDIF  &&RECCOUNT('tmpQcompany') > 1
				
				THISFORMSET.CompanyChanged = .F.
				THISFORMSET.REFRESH
			
			
			ENDIF
			
			ThisFormSet.RefreshSalesPOverlap(cQuotesCompany)
			
		ENDIF
		
		IF lCorrectCompanyandName
			ThisForm.NAME1.ForeColor = RGB(0,0,0)
		ENDIF
		
		IF USED('tmpQcompany')
			USE IN tmpQcompany
		ENDIF
		
		ThisFormSet.ShowPricingPU()
		
		IF NOT EMPTY(ThisForm.CustID1.Value)
			ThisFormSet.ShowCustomerTerms('WAIT')
		ENDIF
		
		**************************************
		ThisFormSet.ShowBrokerHistory()
		
										
										
										
										
										
										
										
										
										
	ENDPROC

