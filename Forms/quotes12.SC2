	ENDPROC

	PROCEDURE frmSendInquire.cmdAttachFile.OLEDragDrop
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord
		
		LOCAL cFile, afiles[ 1 ]
		 
		IF oDataObject.GETFORMAT( 15 )
		   oDataObject.GETDATA( 15, @afiles )
		   FOR EACH cFile IN afiles
		      ** Do something with the file
		      
		        PRIVATE cUNC, cFileName, nFileSize 
				PRIVATE nLastSlash, nAtLastSlash 
				nLastSlash = OCCURS("\",cFile)
				nAtLastSlash = AT("\",cFile,nLastSlash)
		
				IF nLastSlash = 0
					cFileName = cFile
					cUNC = ""
				ELSE
					cFileName = RIGHT(cFile,LEN(cFile)-nAtLastSlash)
					cUNC = LEFT(cFile,LEN(cFile)-LEN(cFileName))
				ENDIF
		
				nFileSize = PrepareSQLnum( FSEEK(FOPEN(cFile),0,2) / 1000000 ,'FileSize',8,2)
				*nMeg = nFileSize / 1000000
				
				SELECT QuoteAttach
				INSERT INTO QuoteAttach (UNCFile, FileName, FileSize ) VALUES (cUNC, cFileName, nFileSize )
				
				ThisForm.lstAttach.Visible = .T.
				ThisForm.lstAttach.AddItem(cFileName)
				ThisForm.lstAttach.Refresh
				
				
		   NEXT
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE frmSendInquire.cmdAttachFile.OLEDragOver
		LPARAMETERS oDataObject, nEffect, nButton, nShift, nXCoord, nYCoord, nState
		
		IF oDataObject.GETFORMAT(15)
		   THIS.OLEDROPHASDATA = 1
		ENDIF
	ENDPROC

	PROCEDURE frmSendInquire.cmdEdit.Click
		PRIVATE mLinesLeft, mGotoLine
		
		SELECT QDB
		PACK
		SET INDEX TO && use stand order - no index
		GO TOP
		*CREATE TABLE ( SYS(5)+SYS(2003)+"\"+quotedb ) FREE (LINE C(80), recnum N(8) )
		mLinesLeft = RECCOUNT('QDB')
		mGotoLine = 36
		DO WHILE mLinesLeft > 35
			GOTO (mGotoLine)
			INSERT BLANK
			REPLACE LINE WITH "***** Page Break *****     This line will be deleted"
			DELETE
			mLinesLeft = mLinesLeft - 36
			mGotoLine = mGotoLine + 36
		ENDDO
		
		ThisForm.Visible = .F.
		GO TOP
		ON KEY LABEL CTRL+I INSERT BLANK
		BROW LAST WIDTH 76 TITLE "Ctrl+W SAVE . Esc NOT SAVE . Ctrl+T DELETE . Ctrl+I INSERT . Ctrl+Y ADD AT END" WINDOW Quotes
		ON KEY LABEL CTRL+I 
		
		PRIVATE nRemovePos
		
		IF USED('QDB')
			SELECT QDB
			PACK
			SELECT DISTINCT RECNUM FROM QDB WHERE RecNum > 0 INTO ARRAY paQuotesInqNo
			IF VARTYPE(paQuotesInqNo) = "L"
				ThisFormSet.nInquireSelectSend = 0	
			ELSE
				ThisFormSet.nInquireSelectSend = ALEN( paQuotesInqNo,1 )
			ENDIF
			GO BOTTOM
		ENDIF
		ThisForm.Visible = .T.
		SELECT Quotes
	ENDPROC

	PROCEDURE frmSendInquire.cmdExit.Click
		IF USED('QDB')
			SELECT QDB
			DELETE ALL IN QDB
			USE IN QDB
			
			IF NOT EMPTY(Thisformset.fnINQUIRE4)
				IF FILE(SYS(5)+SYS(2003)+"\"+Thisformset.fnINQUIRE4)
					DELETE FILE (SYS(5)+SYS(2003)+"\"+Thisformset.fnINQUIRE4)
				ENDIF
				IF FILE(SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnINQUIRE4)
					DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnINQUIRE4)
				ENDIF
			ENDIF
			ThisFormSet.fnINQUIRE4 = ''
		ENDIF
		
		*******************************************
		
		IF USED('QuoteAttach')
			*Remove files from server
			SELECT QuoteAttach
			SCAN
				cFileName = ALLTRIM(QuoteAttach.FileName)
				**********
		*!*			PRIVATE cSQLServer, cFullSQLPath 
		*!*			IF VARTYPE(gGlobalServer)="C"
		*!*				cSQLServer = gGlobalServer 
		*!*			ELSE
		*!*			 	cSQLServer = "BOBWHITE"
		*!*			ENDIF
		*!*			cFullSQLPath = "\\"+cSQLServer+"\Email\"
				cFullSQLPath = get_Email_ServerDir()
		
				IF FILE(cFullSQLPath +cFileName)
					DELETE FILE (cFullSQLPath+cFileName)
				ENDIF
			ENDSCAN	
		
			
			ZAP IN QuoteAttach
			USE IN QuoteAttach
			
			IF NOT EMPTY(Thisformset.fnQuoteAttach )
				IF FILE(SYS(5)+SYS(2003)+"\"+Thisformset.fnQuoteAttach )
					DELETE FILE (SYS(5)+SYS(2003)+"\"+Thisformset.fnQuoteAttach )
				ENDIF
				IF FILE(SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnQuoteAttach )
					DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnQuoteAttach )
				ENDIF
			ENDIF
			ThisFormSet.fnQuoteAttach = ''
			
		ENDIF
		
		ThisForm.lstAttach.Clear
		ThisForm.lstAttach.Visible = .F.
			
			
		IF USED('Quotes')
			SELECT Quotes
		ENDIF
		
		*ThisForm.Release
		
		ThisForm.Visible = .F.
		ThisForm.Enabled = .F.
		ThisFormSet.Quotes.Enabled = .t.
		ThisFormSet.Quotes.Open1.Refresh
		
		ThisFormSet.QuotesRecordChanged()
		
		*RELEASE paQuotesInqNo 
		ThisFormSet.nInquireSelectSend = 0
		DIMENSION paQuotesInqNo(1)
		paQuotesInqNo(1) = .F.
	ENDPROC

	PROCEDURE frmSendInquire.cmdNext.Click
		SELECT Quotes
		IF !EOF()
			SKIP 1 IN Quotes
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of file' NOWAIT
			GO BOTTOM IN Quotes
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()
		*Quotes97.refresh
		*ThisForm.refresh
		ThisFormSet.Quotes.refresh
	ENDPROC

	PROCEDURE frmSendInquire.cmdPrev.Click
		SELECT Quotes
		IF !BOF()
			SKIP -1 IN Quotes
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file' NOWAIT
			GO TOP IN Quotes
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()
		
		*Quotes97.refresh
		*ThisForm.refresh
		ThisFormSet.Quotes.refresh
	ENDPROC

