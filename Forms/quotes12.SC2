	PROCEDURE QUOTES.Load
		*PUBLIC aQrecNitem &&For Select4Order
		PUBLIC gcSalesP, gcSQL,gcShowFromDate, gnQuotesShowDays, gcQuotesOR 
		IF VARTYPE(gnConnHandle) = "U"
			PUBLIC gnConnHandle
		ENDIF
		
		IF NOT "QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_Setup" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		IF "\MEM" $ SYS(2003)
			IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
			ENDIF
		ELSE
			IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
			ENDIF
		ENDIF
		
		IF TYPE('m.SalesP')="C"
			IF NOT EMPTY(m.SALESP)
				ThisFormSet.SalesP = ALLTRIM(m.SALESP)
				gcSalesP = ALLTRIM(m.SALESP)
			ELSE
				gcSalesP = "*" &&If there is not Names, look at all records
			ENDIF
		ELSE
			gcSalesP = "*" &&If there is not Names, look at all records
		ENDIF
		
		*close tables
		m.currdbc = IIF(EMPTY(DBC()),"",DBC())
		
		*!*	IF "\MEM" $ SYS(2003)
		*!*		IF FILE(SYS(5)+SYS(2003) +"\HPASetup.MEM")
		*!*			RESTORE FROM (SYS(5)+SYS(2003) +"\HPASetup.MEM") ADDITIVE
		*!*		ENDIF
		*!*	ELSE
		*!*		IF FILE(SYS(5)+SYS(2003) +"\MEM\HPASetup.MEM")
		*!*			RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\HPASetup.MEM") ADDITIVE
		*!*		ENDIF
		*!*	ENDIF
		
		IF USED('Stocklst')
			USE IN StockLst
		ENDIF
		
		IF USED('Quotes')
			USE IN Quotes
		ENDIF
		IF USED('Quotes2')
			USE IN Quotes2
		ENDIF
		IF USED('Quotes3')
			USE IN Quotes3
		ENDIF
		IF USED('Quotes4')
			USE IN Quotes4
		ENDIF
		IF USED('QSOPO')
			USE IN QSOPO
		ENDIF
		
		SET TALK ON
		
		gnConnHandle = get_SQLSTRINGCONNECT()
		
		IF gnConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		gnQuotesShowDays = 90
		gcShowFromDate = "'"+DTOC(DATE() - gnQuotesShowDays )+"'"
		gcQuotesOR = " "
		
		IF gcSalesP = "*"
			gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) WHERE InqDate > "+gcShowFromDate+gcQuotesOR+" ORDER BY InqDate"
		ELSE
			gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
			gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
			gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
			gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
			gcSQL=gcSQL + gcQuotesOR
			*gcSQL=gcSQL +" ORDER BY InqNumP"
			gcSQL=gcSQL +" ORDER BY InqDate"
			
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
		ENDIF
		**ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
		*ThisFormSet.QUOTES.cboTgq82.Value = 3  Cannot call in LOAD
		
		IF NOT USED('Quotes')
			nans = 0
			nans = MESSAGEBOX("Data table Quotes not Found!"+CHR(13)+"Do you want to try to find a backup? (Y/N)",4+32,'View backup ?')
			IF nans = 6
				*IF "\MEM" $ SYS(2003)
				USE LOCFILE(SYS(5)+SYS(2003) +'\Quotes.dbf','DBF',"Locate your Quotes Backup file!") ALIAS Quotes IN 0 SHARED NOUPDATE
				IF USED('Quotes')
					=MESSAGEBOX("You can not edit or save.",0+16,"Backup file is being used.")
				ELSE
					QUIT
				ENDIF
			ENDIF
		ELSE
			IF RECCOUNT('Quotes') = 0
				*****************
				WAIT WINDOW 'Did not find current quote, going back for more....' NOWAIT
				gcShowFromDate = "'"+DTOC(DATE() - (gnQuotesShowDays + 365) )+"'"
				
				gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
				gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
				gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
				gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
				gcSQL=gcSQL + gcQuotesOR
				*gcSQL=gcSQL +" ORDER BY InqNumP"
				gcSQL=gcSQL +" ORDER BY InqDate"
				
				SELECT Quotes
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
				ENDIF
				*****************
				IF USED('Quotes')
					IF RECCOUNT('Quotes') > 0
						gnQuotesShowDays = gnQuotesShowDays + 365
					ELSE
						*****************
						WAIT WINDOW 'Did not find current quote, going back for even more....' NOWAIT
						
						gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
						gcSQL=gcSQL +" WHERE ( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
						gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
						*gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
						gcSQL=gcSQL + gcQuotesOR
						*gcSQL=gcSQL +" ORDER BY InqNumP"
						gcSQL=gcSQL +" ORDER BY InqDate"
						
						SELECT Quotes
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
						ENDIF
						*****************
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		SELECT Quotes
		*SET MULTILOCKS ON  && Must be on for table buffering
		
		SELECT Quotes
		*INDEX ON InqNum TAG InqNum && Coumpound is use in Send Quote- to find quote to update the send info
		INDEX ON InqDate TAG InqDate
		GO BOTTOM
		
		*IF !USED('QuotesID')
		*	USE HPA!QuotesID IN 0 SHARED
		*ENDIF
		*SELECT QuotesID
		
		SELECT Quotes
		
	ENDPROC

	PROCEDURE QUOTES.LOTP1.GotFocus
		WITH ThisForm.tempfield
			.Alignment = 2
			.Height = This.Height
			.Left = This.Left
			.Width = This.Width
			.Value = STR(This.Value,9,2)
			.Top = This.Top
			.Enabled = .T.
			.Visible = .T.
			.TabIndex = This.TabIndex
		ENDWITH
		
		*ThisFormSet.MetricGOTFocus  = "LOTP1"
		
		ThisForm.tempfield.SetFocus()
		
		
	ENDPROC

	PROCEDURE QUOTES.LOTP1.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		ThisFormSet.GOTFocusLast = "LOTP1"
		*ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast
	ENDPROC

	PROCEDURE QUOTES.LOTP1.When
		IF ThisFormSet.isediting
			ThisFormSet.MetricGOTFocus  = "LOTP1"
		*	ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast
		ENDIF
		RETURN ThisFormSet.isediting
	ENDPROC

	PROCEDURE QUOTES.Move
		LPARAMETERS nLeft, nTop, nWidth, nHeight
		
	ENDPROC

	PROCEDURE QUOTES.Moved
		
		IF ThisFormSet.frmStartingStock.Visible
			ThisFormSet.frmStartingStock.AlwaysOnTop = .T.
			ThisFormSet.frmStartingStock.LEFT = ThisFormSet.Quotes.Left + 4
			ThisFormSet.frmStartingStock.TOP = ThisFormSet.Quotes.Top + 130
			ThisFormSet.frmStartingStock.AlwaysOnTop = .F.
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.NAME1.InteractiveChange
		*************New SQL
		IF ThisFormSet.AutoName
			PRIVATE lSearchFound
			lSearchFound = .F.
		
			PRIVATE lnInsertionPt, lcSearchStr, lcSearchStrSQL
			lnInsertionPt = IIF(this.SelStart=0,25,this.SelStart)
			lcSearchStr = SUBSTR(this.value,1,lnInsertionPt) &&Trim to insertion point
			*lcSearchStrSQL = PrepareSQLtxt(lcSearchStr,'Name',25)
			lcSearchStrSQL = STRTRAN(lcSearchStr,"'","''")
		
			PRIVATE lcCompany, llFoundCompany,	llFoundName 
			lcCompany = ALLTRIM(PrepareSQLtxt(ThisForm.Company1.Value,'Company',30))
			llFoundCompany = .F.
			llFoundName = .F.
			
			IF !empty(lcSearchStr)
				IF USED('tmpQname')
					USE IN tmpQname
				ENDIF
		
				IF NOT EMPTY(lcCompany)
					*Find LIKE Name and Company
					cSQL = "SELECT Name "
					cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Name LIKE '"+lcSearchStrSQL+"%'"  &&Do not TRIM!
					cSQL = cSQL + " AND Company LIKE '"+lcCompany+"%'"
		
					SELECT 0
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQname' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQname' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 	
					IF nSQLEXEC < 0
						SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQname')
					ENDIF
					*******************
					IF USED('tmpQname')
						IF VARTYPE( tmpQname.Name ) = "C"
							IF NOT EMPTY(tmpQname.Name )
								this.VALUE = tmpQname.Name 	
								THIS.FORECOLOR = RGB(0,0,0)		
								=insmode(.f.)
								llFoundCompany = .T.
							ENDIF
						ENDIF
						USE IN tmpQname
					ENDIF		
				ENDIF	
					
				IF NOT EMPTY(lcCompany)
					*Find EXACT Name and Company
					cSQL = "SELECT Name "
					cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Name = '"+ALLTRIM(lcSearchStrSQL)+"'"  
					cSQL = cSQL + " AND Company = '"+ALLTRIM(lcCompany)+"%'"
		
					SELECT 0
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQname' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQname' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 	
					IF nSQLEXEC < 0
						SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQname')
					ENDIF
					****************************
					IF USED('tmpQname')
						IF VARTYPE( tmpQname.Name ) = "C"
							IF NOT EMPTY(tmpQname.Name )
								this.VALUE = tmpQname.Name 	
								THIS.FORECOLOR = RGB(0,0,0)		
								=insmode(.f.)
								llFoundCompany = .T.
							ENDIF
						ENDIF
						USE IN tmpQname
					ENDIF		
				ENDIF	
		
				IF NOT llFoundCompany 
					
					cSQL = "SELECT Name "
					cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Name LIKE '"+lcSearchStrSQL+"%'"  &&Do not TRIM!
					
					SELECT 0
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQname' )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQname' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 	
					IF nSQLEXEC < 0
						SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQname')
					ENDIF
					******************************
					IF USED('tmpQname')
						IF RECCOUNT('tmpQname') > 0
							IF NOT EMPTY(tmpQname.Name)
								this.VALUE = tmpQname.Name
								THIS.FORECOLOR = RGB(0,0,0)
			*					REPLACE quotes.custid with tmpQnameXcomp.Customer IN Quotes
								llFoundName = .T.
								=insmode(.f.)
							ELSE
								this.value=lcSearchStr
								THIS.FORECOLOR = RGB(255,0,0)
								*ThisFormSet.CompanyChanged = .T.
								llFoundName = .F.
								=insmode(.t.)
							ENDIF
						ELSE
							this.value=lcSearchStr
							THIS.FORECOLOR = RGB(255,0,0)
			*				REPLACE quotes.custid with "" IN Quotes
							*ThisFormSet.CompanyChanged = .T.
							llFoundName = .F.
							=insmode(.t.)
						ENDIF
						USE IN tmpQname
					ELSE
						this.value=lcSearchStr
						THIS.FORECOLOR = RGB(255,0,0)
						*ThisFormSet.CompanyChanged = .T.
						llFoundName = .F.
						=insmode(.t.)
					ENDIF
				ELSE
					llFoundName = .T.
				ENDIF
				
				
		*!*			IF NOT llFoundName 
		*!*				
		*!*				cSQL = "SELECT Name "
		*!*				cSQL = cSQL + " FROM dbo.QuickCompany WITH (NOLOCK) WHERE Name ='"+ALLTRIM(lcSearchStrSQL)+"'"
		*!*				
		*!*				SELECT 0
		*!*				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQname' )
		*!*				
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQname' )
		*!*				ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 	
		*!*				IF nSQLEXEC < 0
		*!*					SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQname')
		*!*				ENDIF
		*!*				IF USED('tmpQname')
		*!*					IF RECCOUNT('tmpQname') > 0
		*!*						IF NOT EMPTY(tmpQname.Name)
		*!*							this.VALUE = tmpQname.Name
		*!*							THIS.FORECOLOR = RGB(0,0,0)
		*!*		*					REPLACE quotes.custid with tmpQnameXcomp.Customer IN Quotes
		*!*							llFoundName = .T.
		*!*							=insmode(.f.)
		*!*						ELSE
		*!*							this.value=lcSearchStr
		*!*							THIS.FORECOLOR = RGB(255,0,0)
		*!*							*ThisFormSet.CompanyChanged = .T.
		*!*							llFoundName = .F.
		*!*							=insmode(.t.)
		*!*						ENDIF
		*!*					ELSE
		*!*						this.value=lcSearchStr
		*!*						THIS.FORECOLOR = RGB(255,0,0)
		*!*		*				REPLACE quotes.custid with "" IN Quotes
		*!*						*ThisFormSet.CompanyChanged = .T.
		*!*						llFoundName = .F.
		*!*						=insmode(.t.)
		*!*					ENDIF
		*!*					USE IN tmpQname
		*!*				ELSE
		*!*					this.value=lcSearchStr
		*!*					THIS.FORECOLOR = RGB(255,0,0)
		*!*					*ThisFormSet.CompanyChanged = .T.
		*!*					llFoundName = .F.
		*!*					=insmode(.t.)
		*!*				ENDIF
		*!*			
		*!*			ENDIF
					
			ENDIF
		
			this.selstart = lnInsertionPt
		ENDIF
		
		
	ENDPROC

	PROCEDURE QUOTES.NAME1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE QUOTES.NAME1.Valid
		***New SQL
		IF ThisFormSet.AutoName
		
			PRIVATE cQuotesName, cQuotesCompany
			cQuotesCompany	= ALLTRIM(PrepareSQLtxt(ThisForm.Company1.Value,'Company',30))
			cQuotesName		= ALLTRIM(PrepareSQLtxt(ThisForm.Name1.Value,'Name',25))
					
			IF NOT EMPTY(cQuotesName) AND NOT EMPTY(cQuotesCompany)
				PRIVATE nSQLEXEC, cSQL
				
				IF USED('tmpQName')
					USE IN tmpQName
				ENDIF
				
				cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, Notes "
				cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Name LIKE '"+cQuotesName+"%'"
				*IF NOT EMPTY(cQuotesCompany)
					cSQL = cSQL + " AND Company = '"+cQuotesCompany+"'"
				*ENDIF
		
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQName' )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQName' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQName")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQName')
				ENDIF
				
				IF USED('tmpQName')
					IF RECCOUNT('tmpQName') > 1
						GO TOP
						
						PRIVATE lFoundExactCompany
						lFoundExactCompany= .F.
						SCAN
							IF cQuotesCompany = tmpQName.Company
								lFoundExactCompany = .T.
							ENDIF
						ENDSCAN
						SCAN
							IF lFoundExactCompany
								THIS.FORECOLOR = RGB(0,0,0)
								
								IF cQuotesCompany = tmpQName.Company
									*found name and Company 
									ThisForm.PHONE1.Value	= tmpQName.phone
									ThisForm.EXT1.Value		= tmpQName.Phone_ext
									ThisForm.FAX1.Value		= tmpQName.Fax
									ThisForm.Email1.Value	= tmpQName.Email
									ThisForm.CountryCode1.Value	= tmpQName.CountryC
									ThisForm.CustID1.Value	= tmpQName.Customer
									
									IF ISNULL(tmpQName.Notes)
										ThisFormset.frmCustomer.edtCustomer.Value = ''
									ELSE
										ThisFormset.frmCustomer.edtCustomer.Value = tmpQName.Notes 
									ENDIF
									
									ThisFormset.frmCustomer.edtCustomer.ReadOnly = .T.
									ThisFormset.frmCustomer.cmdEditSave.Caption = "Edit"
								
									EXIT
								ENDIF
							ELSE
								IF cQuotesCompany $ tmpQName.Company
									*found name and Company 
									ThisForm.PHONE1.Value	= tmpQName.phone
									ThisForm.EXT1.Value		= tmpQName.Phone_ext
									ThisForm.FAX1.Value		= tmpQName.Fax
									ThisForm.Email1.Value	= tmpQName.Email
									ThisForm.CountryCode1.Value	= tmpQName.CountryC
									ThisForm.CustID1.Value	= tmpQName.Customer
									
									IF ISNULL(tmpQName.Notes)
										ThisFormset.frmCustomer.edtCustomer.Value = ''
									ELSE
										ThisFormset.frmCustomer.edtCustomer.Value = tmpQName.Notes 
									ENDIF
									
									ThisFormset.frmCustomer.edtCustomer.ReadOnly = .T.
									ThisFormset.frmCustomer.cmdEditSave.Caption = "Edit"
									THIS.FORECOLOR = RGB(0,0,0)
									
									EXIT
								ENDIF
							ENDIF
						ENDSCAN
		
					ENDIF  &&RECCOUNT('tmpQName') > 1
					THISFORMSET.REFRESH
					
					IF USED('tmpQName')
						USE IN tmpQName
					ENDIF
				ENDIF  &&IF USED('tmpQName')
			ENDIF  &&IF NOT EMPTY(cQuotesName) AND NOT EMPTY(cQuotesCompany)
		ENDIF &&ThisFormSet.AutoName
		
		
		IF NOT EMPTY(ThisForm.CustID1.Value)
			ThisFormSet.ShowCustomerTerms('WAIT')
		ENDIF
	ENDPROC

