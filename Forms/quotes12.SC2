	PROCEDURE QUOTES.pf1.PageQA.QuoteDays.Init
		This.Value = gnQuotesShowDays
	ENDPROC

	PROCEDURE QUOTES.pf1.PageQA.QuoteDays.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		ThisFormSet.GOTFocusLast = This.Name
	ENDPROC

	PROCEDURE QUOTES.pf1.PageQA.QuoteDays.Valid
		PRIVATE nDays
		nDays = THIS.VALUE
		IF VARTYPE(nDays) = "N"
			IF nDays  > 0
				IF MESSAGEBOX("Are you sure you want to change the 'Days Shown' to "+ALLTRIM(STR(nDays))+" ?",4) = 6
					gnQuotesShowDays = nDays
					gcShowFromDate = "'"+DTOC(DATE() - gnQuotesShowDays )+"'"
		
					IF gcSalesP = "*"
						gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) WHERE InqDate > "+gcShowFromDate+gcQuotesOR+" ORDER BY InqDate"
					ELSE
						gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
						gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
						gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
						gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
						gcSQL=gcSQL + gcQuotesOR
						*gcSQL=gcSQL +" ORDER BY InqNumP"
						gcSQL=gcSQL +" ORDER BY InqDate"
		
					ENDIF
		
		
					THISFORMSET.Quotes.LOCKSCREEN = .T.
					SELECT Quotes
					PRIVATE nCurInqNumP
					nCurInqNumP = Quotes.InqNumP
					USE IN Quotes
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(gcSQL, gnConnHandle,nSQLEXEC, 'Quotes')
					ENDIF
		
					SELECT Quotes
					LOCATE FOR InqNumP = nCurInqNumP
					THISFORM.cboTgq82.VALUE = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
					THISFORMSET.Quotes.LOCKSCREEN = .F.
				
					ThisFormSet.QuotesRecordChanged()
					
				ELSE
					*THIS.VALUE = gnQuotesShowDays
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		RETURN .T.
	ENDPROC

