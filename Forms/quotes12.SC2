	PROCEDURE QUOTES.pf1.PageSales.cmdRemoveSO.Click
		PRIVATE nSalesNum
		nSalesNum = PrepareSQLnum(Quotes.Salesnum,'SalesNum',-3)
		
		SELECT Quotes
		*nOrigRec = RECNO()
		
		IF nSalesNum > 0
		
			******************************************
			*Check to see if Invoiced
			IF SO_Invoiced( nSalesNum, gnConnHandle )
				MESSAGEBOX("Cannot change this SO!"+CHR(13)+"SO has been Invoiced.",32,"Cannot Cancel?") 
				RETURN .F.
			ENDIF
			
			
			******************************************
			*Check to see if Prcd!
			IF SO_PRCD( nSalesNum, gnConnHandle )
				MESSAGEBOX("Cannot change this SO!"+CHR(13)+"SO item has Process.",32,"Cannot Cancel?") 
				RETURN .F.
			ENDIF
		
			
		
			ThisFormset.frmRemoveORDER.lblSO.Caption = AllTrim(STR(nSalesNum))
		
			ThisFormSet.RemoveOrderCheckSO()
			ThisFormset.frmRemoveORDER.AlwaysOnTop = .T.
			ThisFormset.frmRemoveORDER.Visible = .T.
			
			ThisFormset.Quotes.LOCKSCREEN = .T.
		ENDIF
		
		*!*	IF RECNO('Quotes') > 1
		*!*		SKIP 1 IN Quotes
		*!*		SKIP -1 IN Quotes
		*!*	ENDIF
		
		*!*	THISFORMSET.QuotesRecordChanged()
		*!*	This.Parent.Parent.PageStatus.SetFocus()
		
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.cmdRemoveSO.When
		IF ThisFormSet.isediting
			WAIT WINDOW "Save first" nowait
			RETURN .F.
		ENDIF
		IF ISNULL(Quotes.salesnum)
			WAIT WINDOW "No Sales Number!" NOWAIT
			RETURN .F.
		ELSE
			IF EMPTY(Quotes.Salesnum)
				WAIT WINDOW "No Sales Number!" NOWAIT
				RETURN .F.
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.cmdRMA.Click
		PRIVATE nRMA_No
		nRMA_No = PrepareSQLnum(This.Parent.RMA1.Value,'RMA_No',-3)
		
		IF nRMA_No > 0
			DO FORM Forms\RMA WITH nRMA_No
		ELSE
			PRIVATE cSOitem
			cSOitem = PrepareSQLtxt(Quotes.SOitem,'SOitem',10)
		
			IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
				PRIVATE nCntSOitem
				nCntSOitem = Count_ItemsinSales (Quotes.Salesnum, gnConnHandle, 'RMA')
				IF nCntSOitem > 0
					nRMA_No = get_RMA_from_SalesNum(Quotes.Salesnum, gnConnHandle) 
					PRIVATE nMess
					nMess =  MESSAGEBOX("This SalesNumber has a RMA on a different Item"+CHR(13)+"Do you want to add this Item to that RMA?"+CHR(13)+"RMA "+ALLTRIM(STR(nRMA_No))+CHR(13)+"Answer (N)o to get a another RMA number.",4+32,"Add to RMA")=6
					IF nMess <> 6
						nRMA_No = 0
					ENDIF
				ENDIF
				
				DO FORM Forms\RMA_Start WITH nRMA_No, Quotes.SOitem
				*ThisForm.cReturnKey = ThisForm.cReturnKey + ";" + tmpQuotes.soItem
				MESSAGEBOX("Now Edit Sales Order detail if you need to cancel this item!"+CHR(13)+"You can also print the 'Conformation' to send to customer with RMA number.",0,"Order Details")
			ELSE
				DO FORM Forms\RMA
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.cmdRMA.When
		RETURN !ThisFormSet.isediting
	ENDPROC

