	PROCEDURE QUOTES.pf1.PageQuote.cmdEmailRead.Click
		
		PRIVATE nSQLEXEC, cSQL
		
		IF USED('tmpReadEmailQ')
			USE IN tmpReadEmailQ
		ENDIF
		
		cSQL = "SELECT TOP 1 dateEntered "
		cSQL = cSQL + " FROM [HPAlloyNR].[dbo].[EmailTracker] WITH(NOLOCK) "
		cSQL = cSQL + " WHERE QuoteID = "+STR(Quotes.ID)
		cSQL = cSQL + " AND EmailKey = 'Quote'"
		cSQL = cSQL + " AND ipAddress NOT LIKE '192.168.%'"
		cSQL = cSQL + " ORDER BY dateEntered "
		
		nSQLEXEC = SQLEXEC(gnConnHandle,cSQL , 'tmpReadEmailQ' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpReadEmailQ' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpReadEmailQ")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpReadEmailQ")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL ,gnConnHandle,nSQLEXEC, 'tmpReadEmailQ')
		ENDIF
		nItemSale = 0
		IF USED('tmpReadEmailQ')
			IF RECCOUNT('tmpReadEmailQ') > 0
				IF VARTYPE(tmpReadEmailQ.dateEntered) = "T"
					cDateEntered = TTOC(tmpReadEmailQ.dateEntered)
					MESSAGEBOX("First record of customer"+CHR(13)+"viewing the Quoted Email was"+CHR(13)+""+cDateEntered+".",64,"Email was Read")
				ENDIF
			ELSE
				MESSAGEBOX("Cannot verify Quoted Email was read.",48,"No record was found")
			ENDIF
			USE IN tmpReadEmailQ
		ENDIF
		
	ENDPROC

