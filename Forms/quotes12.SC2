		IF Quotes.HpaPo > 0
			DO FORM Forms\ShowPO WITH quotes.HPApo
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.LBLHPAPO21.Click
		IF Quotes.HpaPo2 > 0
			DO FORM Forms\ShowPO WITH quotes.HPApo2
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.PO_NUM1.When
		
		IF ThisFormSet.isediting
			IF ISNULL(Quotes.salesnum)
				RETURN .F.
			ELSE
				IF EMPTY(Quotes.salesnum)
					RETURN .F.
				ELSE
					RETURN .T.
				ENDIF
			ENDIF
		ELSE
			*Not in edit mode
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.SALEDATE1.When
		IF ThisFormSet.isediting
			IF ISNULL(Quotes.salesnum)
				RETURN .F.
			ELSE
				IF EMPTY(Quotes.salesnum)
					RETURN .F.
				ELSE
					IF NOT EMPTY(Quotes.Salesnum) AND EMPTY(Quotes.SaleDate)
						REPLACE SaleDate WITH DATE() IN Quotes
					ENDIF
					RETURN .T.
				ENDIF
			ENDIF
		ELSE
			*Not in edit mode
			RETURN .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.SALESNUM1.Valid
		IF PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3) > 0
			REPLACE Quotes.Open_ WITH .F. IN Quotes
			ThisFormSet.Open1.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.SALESNUM1.When
		RETURN .f.
		*ThisFormSet.isediting
		
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSold.Click
		ThisFormSet.ShowSold()
		This.REFRESH
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSold.cmdEditSO.Click
		*This.Parent.Parent.PageSales.cmdEditSO.Click
		
		PRIVATE nNumSN,nFirstRec,nLastRec,nNumRecs
		PRIVATE nSalesnum
		nSalesNum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		nNumSN = 0
		
		SELECT Quotes
		
		PRIVATE nOrigRec, nCurInqNum, nCurInqNumP
		nOrigRec = Recno('Quotes')
		nCurInqNum  = Quotes.InqNum
		nCurInqNumP = Quotes.InqNumP
		
		COUNT TO nNumSN FOR Salesnum = nSalesnum 
		IF nNumSN > 0
			SET FILTER TO Salesnum = nSalesnum 
			GO TOP
			nFirstRec = Recno()
			GO BOTTOM
			nLastRec = Recno()
			nNumRecs = (nLastRec - nFirstRec)+1
			
			*FLUSH
			RELEASE compflda
			
			IF USED("AllQuotes")
				USE IN AllQuotes
			ENDIF
			
			DO Form Forms\EditSalesOrder WITH nSalesnum
			
			IF WVISIBLE('frmEO')
		*		MESSAGEBOX( "If you did not just leave the 'Select from Inventory' window,"+;
		*		  CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+;
		*		  "and remember what was done before this message appearred."+CHR(13)+CHR(13)+;
		*		  "Thank you for helping debug this program.",32,"frmEO is Visible")
		*		ACTIVATE WINDOW frmEO TOP
				TrackMess( "Quotes12:cmdEditSO:Click WVISIBLE('frmEO')")
			ENDIF
			
			
			IF USED("AllQuotes")
				USE IN AllQuotes
			ENDIF
		
		*	SELECT Quotes
		*	GOTO nFirstRec
		*	IF nOrigRec > 0
		*		GOTO nOrigRec
		*	ENDIF
			
			SELECT Quotes
			SET FILTER TO
			
			*Update the view
			WAIT WINDOW "Refreshing 'Quotes' table" NOWAIT
		*	ThisFormSet.Quotes.LockScreen = .T.
			USE IN Quotes
			
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
			ENDIF
			
			IF USED('Quotes')
				SELECT Quotes
				LOCATE FOR InqNumP = nCurInqNumP
				IF FOUND('Quotes')
					ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
				ELSE
					TrackMess( "Quotes12:cmdEditSO:Click LOCATE FOR InqNumP = "+nCurInqNumP )
				ENDIF
			ELSE
				MESSAGEBOX('You lost contact with Database',0+16,'Closing down now!')
				CLEAR READ
				RETURN TO MASTER
			ENDIF
			WAIT CLEAR
		*	ThisFormSet.Quotes.LockScreen = .F.		
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()
		
		
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSold.cmdEditSO.When
		IF ThisFormSet.isediting
			WAIT WINDOW "Save first" nowait
			RETURN .F.
		ENDIF
		IF ISNULL(Quotes.salesnum)
			WAIT WINDOW "No Sales Number!" NOWAIT
			RETURN .F.
		ELSE
			IF EMPTY(Quotes.Salesnum)
				WAIT WINDOW "No Sales Number!" NOWAIT
				RETURN .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSold.cmdReprintSO.Click
		IF VARTYPE(glTrt_lumber) = "U"
			*This Global is used in the Report Form
			PUBLIC glTrt_lumber
		ENDIF
		glTrt_lumber = .F.
		
		SELECT Quotes
		PRIVATE nSalesNum, nAmendment
		nSalesNum	= PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		nAmendment	= Get_Amendment_Sales_No( nSalesNum, gnConnHandle)
		
		
		IF nSalesNum > 0
			IF FILE('REPORTS\SalesOrder02.FRX')
		
				IF Count_SOinSales_No(nSalesNum, gnConnHandle, 'trt_lumber') > 0
				
					*cTrt_Lumber_Co = ThisFormSet.Treated_Lumber_Country()
					*cTrt_Lumber_Co = ThisFormSet.Treated_Lumber_Country()
					*ThisFormSet.LoadHardwood()
					
					
					*IF NOT LEN(ALLTRIM(cTrt_Lumber_Co))=0
					*	glTrt_lumber = .T.
					*ELSE
						glTrt_lumber = .F.
					*ENDIF	
				ELSE
					glTrt_lumber = .F.
				ENDIF
		
				MESSAGEBOX("This print does not increment the SO Version."+CHR(13)+"QA will repremind you if you are caught."+CHR(13)+"Destroy paper evidence as soon as possible.",0+48,"Warning- This is for just a quick view of SO.")
				*Load SalesQuote		&&SalesQuote opened here just to print SO. Close when done!		
				IF USED('SalesQuote')
					USE IN SalesQuote
				ENDIF
		
				cSQL = "SELECT   A.*"
				cSQL = cSQL + " ,A.SalesNum AS SalesNum_a, A.SOitem AS SOitem_a, A.Item AS Item_a "
				cSQL = cSQL + " ,S.* "
				cSQL = cSQL + " ,SN.* "
				cSQL = cSQL + "  FROM dbo.AllQuotes A "
				cSQL = cSQL + " INNER JOIN dbo.Sales S ON A.SOitem = S.SOitem "
				cSQL = cSQL + " INNER JOIN dbo.Sales_No SN ON A.SalesNum = SN.SalesNum "	&&added Sales_No only here
				cSQL = cSQL + " WHERE A.SalesNum = "+STR(nSalesNum)
				cSQL = cSQL + " ORDER BY A.Item "
		
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'SalesQuote')
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'SalesQuote')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "SalesQuote")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "SalesQuote")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'SalesQuote')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1), cSQL )
				ENDIF
		
				*LOAD
		
				PRIVATE cCurrSOitem
				cCurrSOitem = PrepareSQLtxt(Quotes.SoItem,'SOitem',10)
		
				**********************
				ThisFormset.SeekSoldCodeinSoldAddr(SalesQuote.pSoldAddr)
				
				*********************	
				ThisFormset.SeekShipCodeinShipAddr(SalesQuote.pShipAddr)
				
				*********************	
				ThisFormset.SeekSalesNuminSales_No(nSalesNum)	
				
				*********************
				ThisFormset.SeekStartingStockSalesNum(nSalesNum)	
				*ThisFormSet.SeekStartingStock(SalesQuote.ID)	
				
				*********************
				
				SET PRINTER OFF
				SET PRINTER TO DEFAULT
				
				SELECT SalesQuote
				WAIT WINDOW "Print SalesOrder to:" NOWAIT
				
				REPORT FORM reports\SalesOrder02 NOCONSOLE TO PRINTER PROMPT
						
				****
				************
		
				IF USED('tmpSOitem_Len')
					USE IN tmpSOitem_Len
				ENDIF
		
				cSQL = "SELECT SOitem, LEN( CAST(Comments AS CHAR(1024)) ) AS Lngth "
				cSQL = cSQL + " FROM dbo.AllQuotes "
				cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
				cSQL = cSQL + " ORDER BY SOitem"
		
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSOitem_Len')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSOitem_Len')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOitem_Len")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOitem_Len")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'tmpSOitem_Len')
					RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
				ENDIF
		
		
				IF USED('tmpSOitem_Len')
					SELECT tmpSOitem_Len
					COPY TO ARRAY aSOitem_Len
					USE IN tmpSOitem_Len
				ELSE
					DECLARE aSOitem_Len(1,2)
					aSOitem_Len(1,1) = nSalesNum
					aSOitem_Len(1,2) = " "
				ENDIF
		
				********************************
		
				GO TOP IN SalesQuote
				
				PRIVATE nItem
				
				**********************************
				*Print WorkSheet
				*
				ThisFormSet.Load_WorkSheet()
				
				IF FILE('REPORTS\WorkSheet.FRX')
		*			IF nAnsPrint= 6
		*				SetPrinterTo("TIPTONSHOP")
		*			ENDIF
					***********************************
					
					PRIVATE nLenaSOitem
					nLenaSOitem = ALEN(aSOitem_Len,1)
					IF nLenaSOitem > 0
						*Loop thru Items
						FOR nItem = 1 TO nLenaSOitem
						
							SELECT SalesQuote
							LOCATE FOR Item = nItem 
							*IF FOUND()
							*	cCurrSOitem = SalesQuote.SoItem_A	
							*ELSE
							*	cCurrSOitem = Proper_SO_item(STR(nSalesNum)+"-"+STR(nItem,2,0))
							*ENDIF
							cCurrSOitem = aSOitem_Len(nItem,1)
							
							**********
							*see if WO_Production 
							*lWO_Production = Is_Production_WO_SOi(cCurrSOitem,gnConnHandle)
							*--Internal Production is now recorded as WorkOrder--
							
							*********************
							ThisFormSet.Load_SO_POitems(SalesQuote.SoItem_A) &&tmpAllPOitems.AllPOtext
		
							*********************
							
							SELECT WorkSheet
							WAIT WINDOW "Print Work Sheet to:" NOWAIT
							REPORT FORM reports\Worksheet NOCONSOLE TO PRINTER PROMPT FOR Worksheet.SoItem_A = aSOitem_Len(nItem,1)
							
							WAIT WINDOW "Work Sheet Page: "+ALLTRIM(STR(nItem)) TIMEOUT 3
							
							*Check For Extension page needs, count comeents lines to print
							lWOext = .F.
							IF USED('tmpSOitem_Len2')
								USE IN tmpSOitem_Len2
							ENDIF
							
							cSQL = "SELECT Comments "
							cSQL = cSQL + " FROM dbo.AllQuotes "
							cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+aSOitem_Len(nItem,1)+"')"
							cSQL = cSQL + " OR ( SalesNum = "+STR(nSalesNum)
							cSQL = cSQL + " AND Item="+ALLTRIM(STR(nItem))+")"
							
							SELECT 0
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSOitem_Len2')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSOitem_Len2')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOitem_Len2")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOitem_Len2")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'tmpSOitem_Len2')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
							ENDIF
		
		
							IF USED('tmpSOitem_Len2')
								IF LinesToPrint(tmpSOitem_Len2.Comments,50) >= 5
									lWOext = .T.
								ENDIF
								USE IN tmpSOitem_Len2
							ENDIF
							
							****************************
							
							SELECT SalesQuote
							LOCATE FOR Item = nItem 
							
							**Check for Extension
							IF lWOext 
								SELECT WorkSheet
								WAIT WINDOW "Print WorkSheet EXTRA sheet to:" NOWAIT
								REPORT FORM reports\WorkSheet_Ext NOCONSOLE TO PRINTER PROMPT FOR WorkSheet.SoItem_A = aSOitem_Len(nItem,1)
							ENDIF
							
							****************************
							
							SELECT SalesQuote
							LOCATE FOR Item = nItem 
							
							**Check for Production WorkOrder
							
							*IF lWO_Production 
							
								IF USED('tmpWO_SOi')
									USE IN tmpWO_SOi
								ENDIF
								
								cSQL = "SELECT WO.*,WOD.*"
								cSQL = cSQL + ",ISNULL(sPO.Company,'') AS sPOCompany "
								cSQL = cSQL + ",ISNULL(fPO.Company,'') AS fPOCompany "
								cSQL = cSQL + " FROM dbo.WorkOrder WO "
								cSQL = cSQL + " INNER JOIN dbo.WorkOrder_Detail WOD ON WOD.WO = WO.WO "
								cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder sPO ON WO.POitem = sPO.POitem "
								cSQL = cSQL + " LEFT OUTER JOIN dbo.PurchaseOrder fPO ON WOD.fPOitem = fPO.POitem "
								cSQL = cSQL + " WHERE WO.SOitem = dbo.f_ProperSOitem('"+aSOitem_Len(nItem,1)+"')"
		
								SELECT 0
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpWO_SOi')
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpWO_SOi')
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpWO_SOi")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpWO_SOi")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'tmpWO_SOi')
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								ENDIF
					
								IF USED('tmpWO_SOi')
									WAIT WINDOW "Print WorkOrder Prod Detail sheet to:" NOWAIT
									REPORT FORM reports\WorkOrder_Prod_Detail NOCONSOLE TO PRINTER PROMPT 
									
									WAIT WINDOW "Print WorkOrder Production sheet to:" NOWAIT
									REPORT FORM reports\WorkOrder_Production NOCONSOLE TO PRINTER PROMPT 
							
								ENDIF
							*ENDIF
							
							****************************
							SELECT SalesQuote
							
						NEXT nItem
					ENDIF
				ENDIF
				*****
			
				Check_SO_Terms(nSalesNum,gnConnHandle)
				
				*ThisFormSet.lPrintedSO = .T.
				*ThisFormSet.frmEO.pf1.pgBillTo.chkPrintedSO.Value = .T.
				*REPLACE PrintedSO WITH .T. IN Sales_No
				
				WAIT WINDOW 'PRINTED' NOWAIT
			ELSE
				WAIT WINDOW "Report form 'REPORTS\SalesOrder02.FRX' not found." NOWAIT
			ENDIF
		
		*!*		IF glTrt_lumber
		*!*			IF NOT LEN(ALLTRIM(cTrt_Lumber_Co))=0
		*!*	*			IF nAnsPrint= 6
		*!*	*				SetPrinterTo("TIPTONSHOP")
		*!*	*			ENDIF
		*!*				
		*!*				IF NOT USED('HardWood')
		*!*					ThisFormSet.LoadHardwood()
		*!*				ENDIF
		*!*				SELECT HardWood
		*!*				
		*!*				WAIT WINDOW "Print Hard Wood statement to:" NOWAIT
		*!*				REPORT FORM reports\HardWood FOR Country = cTrt_Lumber_Co NOCONSOLE TO PRINTER PROMPT
		*!*				WAIT WINDOW "Hard Wood Packaging Statement printed." NOWAIT
		*!*				
		*!*			ELSE
		*!*				MESSAGEBOX("Hard Wood Packaging Statement did not print for this Counrty",0,"Print Error")
		*!*			ENDIF
		*!*		ENDIF
			
			****************************************************
			*Track Usage
			TrackMess("SO "+ALLTRIM(STR(nSalesNum))+" was printed in complete form on ("+DTOC(DATE())+")" +" Quotes.cmdRePrintSO.Click()"+" Amendment:"+ALLTRIM(STR(nAmendment)) )
			Save_Sales_Status( nSalesNum, 'Print', 'Print Sales Order', gnConnHandle )
			
			**********
			*unload
			IF USED('StartingStock')
				USE IN StartingStock
			ENDIF
		
			IF USED('SalesQuote')
				USE IN SalesQuote
			ENDIF
			
			IF USED('ShipAddr')
				USE IN ShipAddr
			ENDIF
			IF USED('SoldAddr')
				USE IN SoldAddr
			ENDIF
		
			IF USED('Sales_No')
				USE IN Sales_No
			ENDIF
			
			IF USED('WorkSheet')
				USE IN WorkSheet
			ENDIF
		
			IF USED('tmpWO_SOi')
				USE IN tmpWO_SOi
			ENDIF
		
		ENDIF
		
		RELEASE glTrt_lumber
	ENDPROC

