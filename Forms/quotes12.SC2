	PROCEDURE QUOTES.cmdQuoted.Click
		
		SELECT Quotes
		*IF ORDER()="OPEN"
		*	=MESSAGEBOX("WARNING: TAG is set to OPEN"+CHR(13)+"this will effect your next record",48)
		*ENDIF
		IF Quotes.OPEN_
			IF CloseQuote(Quotes.ID,gnConnHandle)
				REPLACE Quotes.OPEN_ WITH .F. IN Quotes
			ELSE
				MESSAGEBOX("FAILED TO MARK record as quoted.",48,"Error")
			ENDIF
		ELSE
			IF CloseQuote(Quotes.ID,gnConnHandle,.T.)
				REPLACE Quotes.OPEN_ WITH .T. IN Quotes
				WAIT WINDOW 'Marking record as not yet quoted' NOWAIT
			ELSE
				MESSAGEBOX("FAILED TO MARK record as not yet quoted.",48,"Error")
			ENDIF
		ENDIF
		
		
		THISFORMSET.Quotes.LOCKSCREEN = .T.
		SELECT Quotes
		nCurInqNum = Quotes.InqNumP
		USE IN Quotes
		nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
		ENDIF
		
		LOCATE FOR InqNumP = nCurInqNum
		ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
		THISFORMSET.Quotes.LOCKSCREEN = .F.
		
		THISFORMSET.REFRESH
		
	ENDPROC

	PROCEDURE QUOTES.cmdSeekCompany.Click
		PRIVATE tCompName, m.QcompanyID, cQIDComp, cQIDName 
		PRIVATE cTCompany
		
		IF USED('tmpQcompN')
			USE IN tmpQcompN 
		ENDIF
		
		cTCompany = ALLTRIM(PrepareSQLtxt(ThisForm.COMPANY1.Value,'Company',30))
		
		PRIVATE nSQLEXEC, cSQL
		
		IF USED('tmpQcompany')
			USE IN tmpQcompany
		ENDIF
		
		cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID  "
		cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '"+cTCompany +"%'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
		ENDIF
		
		IF USED('tmpQcompany')
			SELECT company,NAME,phone,Phone_ext,Email,ID FROM tmpQcompany INTO CURSOR tmpQcompN NOFILTER
		
		*	WHERE SOUNDEX(LEFT(cTCompany,nTCompanyLen)) = SOUNDEX(LEFT(Company,nTCompanyLen));
		*	INTO CURSOR tmpQcompN NOFILTER
		
			SELECT tmpQcompN
			GO TOP
			
			m.tCompID = ""
			DO FORM FORMS\QcompanyIDN TO m.QcompanyID &&m.tCompID is Company+Name+ID10
		
			IF NOT EMPTY(m.QcompanyID)
				tCompName = LEFT( m.QcompanyID,55 ) 
				cQIDComp = LEFT( m.QcompanyID,30 )
				cQIDName = RIGHT( tCompName ,25 )
				tcID10 	 = RIGHT(m.QcompanyID,10)
				*m.QcompanyID = UPPER(tmpQcompN.Company+tmpQcompN.Name)
				cQIDComp = PrepareSQLtxt(cQIDComp,'Company',30)
				cQIDName = PrepareSQLtxt(cQIDName,'Name',25)
				
				PRIVATE nID10 
				IF VAL(tcID10) > 1000
					nID10 = PrepareSQLnum(tcID10,'ID',-3)
				ELSE
					nID10 = 0
				ENDIF
				
				IF USED('tmpQcompany')
					USE IN tmpQcompany
				ENDIF
				
				IF nID10 > 0
					cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID "
					cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE ID="+STR(nID10)
				ELSE
					cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID "
					cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '"+(cQIDComp)+"%'"
					cSQL = cSQL + " AND Name LIKE '"+(cQIDName)+"%'"
				ENDIF
						
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
				ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
				ENDIF
				IF USED('tmpQcompany')
					IF RECCOUNT('tmpQcompany') = 0
						*not found
						WAIT WINDOW "Not found! - trimming Company" NOWAIT
						
						cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID "
						cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '"+ALLTRIM(cQIDComp)+"%'"
						cSQL = cSQL + " AND Name LIKE '"+(cQIDName)+"%'"
						
						SELECT 0
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
						
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
						ENDIF
					ENDIF
					IF USED('tmpQcompany')
						IF RECCOUNT('tmpQcompany') = 0
							*Not Found
							WAIT WINDOW "Not found! - trimming Company and Name" NOWAIT
							
							cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID "
							cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company LIKE '"+ALLTRIM(cQIDComp)+"%'"
							cSQL = cSQL + " AND Name LIKE '"+ALLTRIM(cQIDName)+"%'"
							
							SELECT 0
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
							
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
							ENDIF
						ENDIF
						IF USED('tmpQcompany')
							IF RECCOUNT('tmpQcompany') > 0
								IF VARTYPE(tmpQcompany.company) = "C"
									ThisForm.PHONE1.Value	= tmpQcompany.phone
									ThisForm.EXT1.Value		= tmpQcompany.Phone_ext
									ThisForm.FAX1.Value		= tmpQcompany.Fax
									ThisForm.Email1.Value	= tmpQcompany.Email
									ThisForm.CountryCode1.Value	= tmpQcompany.CountryC
									ThisForm.CustID1.Value	= tmpQcompany.Customer
									ThisForm.COMPANY1.Value	= tmpQcompany.Company 
										
									ThisForm.CustID1.Refresh
									ThisForm.COMPANY1.Refresh
									ThisForm.NAME1.Refresh
									ThisForm.CountryCode1.Refresh
									ThisForm.PHONE1.Refresh
									ThisForm.EXT1.Refresh
									ThisForm.FAX1.Refresh
									ThisForm.Email1.Refresh
									
								ENDIF
							ELSE
								*not found
								WAIT WINDOW "Not found at ALL!" NOWAIT
							ENDIF
						USE IN tmpQcompany
						ENDIF
					ENDIF
				ENDIF	
			
			ENDIF
		ENDIF
		
		SELECT Quotes
		RETURN
		
	ENDPROC

	PROCEDURE QUOTES.cmdSeekCompany.When
		RETURN ThisFormSet.isediting
	ENDPROC

	PROCEDURE QUOTES.cmdShowBillToAddress.Click
		PRIVATE cCompany
		cCompany = PrepareSQLtxt(ThisForm.Company1.Value,'Company',30)
		
		*See if Company exits
		IF USED('cntCompanyAddr')
			USE IN cntCompanyAddr
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNT FROM dbo.SoldAddr WHERE company = '"+cCompany+"' AND ISNULL(inactive,0) < 1 "
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'cntCompanyAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'cntCompanyAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "cntCompanyAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "cntCompanyAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'cntCompanyAddr')
		ENDIF
		IF USED('cntCompanyAddr')
			IF cntCompanyAddr.CNT > 0
				
				IF cntCompanyAddr.CNT > 1
					MESSAGEBOX("Found "+ALLTRIM(STR(cntCompanyAddr.CNT))+" version of the same company!",0+48,"Please remove duplicates")
				ENDIF
				
				IF USED('tmpCompanyAddr')
					USE IN tmpCompanyAddr
				ENDIF
				SELECT 0
				
				cSQL = "SELECT SoldCode FROM dbo.SoldAddr WHERE company = '"+cCompany+"' AND ISNULL(inactive,0) < 1 "
				
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpCompanyAddr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpCompanyAddr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCompanyAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCompanyAddr")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'tmpCompanyAddr')
				ENDIF
				
				IF USED('tmpCompanyAddr')
					IF VARTYPE(tmpCompanyAddr.SoldCode) = 'N'
						DO FORM Forms\SoldAddr WITH tmpCompanyAddr.SoldCode
					ENDIF
					USE IN tmpCompanyAddr
					
				ENDIF
			ELSE
				IF MESSAGEBOX("Did not Find SoldTo Company as '"+cCompany+CHR(13)+"Answer (Y)es for Search window to open",4+32,"Search Company name?") = 6
		
					DO FORM Forms\SearchForm WITH "SoldAddr", Quotes.company TO nNewSoldToCode
					IF USED('TmpSearch')
						USE IN TmpSearch
					ENDIF
				
				ENDIF
			ENDIF
		ENDIF
		
		
		IF USED('Quotes')
			SELECT Quotes
		ENDIF
		
		
		
	ENDPROC

