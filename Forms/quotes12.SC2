		ENDIF
		
	ENDPROC

	PROCEDURE dynamic_backcolor_companyhistory
		*ThisFormSet.Dynamic_Backcolor_Company_History 
		PRIVATE nColor
		
		nColor = RGB( 255, 255, 255 ) &&WHITE
		
		IF USED("tmpCustomerHistory")
			IF tmpCustomerHistory.SalesNum > 0
				nColor = RGB(0,255,128)  &&Green
			ENDIF
		ENDIF
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamic_backcolor_vendorsources
		*Dynamic_BackColor_VendorSources
		PRIVATE nColor
		
		nColor = RGB( 255, 255, 255 ) &&WHITE
		
		IF USED("VendorSources")
			IF VendorSources.VendCode = 0
				*nColor = RGB(0,255,128)  &&Green
				*nColor = RGB(255,0,0)  &&Red
				nColor = RGB(192,192,192) && Grey
			ENDIF
		ENDIF
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE editsave		&& Edit or Save from either button.
		*ThisFormSet.EditSave()
		
		PRIVATE mholdRecord, mholdQuoteToSave, mholdOldData
		PRIVATE cSQL
		PRIVATE nCurInqNumP
		
		
		PRIVATE lUpdateViewQuotes
		lUpdateViewQuotes = .F.
		SELECT Quotes
		IF THISFORMSET.isediting &&Save form data
			
			**SAVE
			
			IF NOT ThisFormSet.AllowEdit('SAVE') &&Makes sure not a SO, etc..
			
				ThisFormSet.QuotesRecordChanged()
				THISFORMSET.Quotes.LOCKSCREEN = .F.
		
				THISFORMSET.SetLabelNormal() &&reset buttons
				MESSAGEBOX("Not Allowed to Save",48,"Quotes.EditSave()")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Not Allowed to Save")
				RETURN .F.
			ENDIF
			
			IF !THISFORMSET.Quotes.SZ31.VISIBLE OR !THISFORMSET.Quotes.SZ31.ENABLED
				*If  the form can not use SZ3, set to 0 - may have been there from a clone/ Form change
				*2012-03-09 Still saved Sz3 on form 10 - Used second test with nSz3 
				SELECT Quotes
				REPLACE Quotes.sz3 WITH 0 IN Quotes
			ENDIF
			
			**************************************
			*Force a recalc
			ThisFormSet.CalcInv(0)
			**************************************
			
			PRIVATE cCustomerID
			cCustomerID = PrepareSQLtxt(ThisFormset.QUOTES.CustID1.Value,'CustID',20)
		
			IF NOT EMPTY(cCustomerID)
				IF THISFORMSET.isadding
					IF NOT EMPTY(cCustomerID)
						INSERT_Customer_List_Date(ThisFormset.QUOTES.CustID1.Value,gnConnHandle)
						* "INSERT INTO dbo.Customer_List_Call (CustomerID)
					ENDIF
				ENDIF
			ENDIF
			
			*Check need to save Company info
			IF !EMPTY(Quotes.company)
				ThisFormSet.CheckAlteredCompanyInfo()
			ENDIF
			
			SELECT Quotes
			**Save Quote1 to AllQuotes
			*SCATTER NAME oQ MEMO
			
			PRIVATE cCover,cSalesP
			cCover = PrepareSQLtxt(ThisFormset.QUOTES.pf1.PageSales.cmbCoverSalesP.Value,'Cover',1,.T.)
			cSalesP = PrepareSQLtxt(Quotes.SalesP,'SalesP',1)
			IF cCover = cSalesP
				cCover = ''
			ENDIF
			
			PRIVATE cCompany,cName,cPhone,cPhone_Ext,cFax,cEmail,cAlloy,cForm
			PRIVATE cCC,cCL,nPieces,nThck,nSz2,nSz3,nWeight,cDescript,nP_lb,nP_pc,nP_ft
			PRIVATE ncWeight, ncP_lb, ncP_pc, ncP_ft, ncP_Pcc, ccThk, ncLotP, ncLotCp, ncCut
			PRIVATE nS_QTY, nS_P, nS_PU
			PRIVATE cCutM
			PRIVATE cKerfD
			PRIVATE nCuts,cOtherFld,nOtherP,nLotP,nLotCost,cLeadTime
			PRIVATE cCustID,cQuoteMemo
			cCompany		= PrepareSQLtxt(ThisFormSet.Quotes.Company1.Value,'Company',30)
			cName			= PrepareSQLtxt(ThisFormSet.Quotes.Name1.Value,'Name',25)
			cPhone	 		= PrepareSQLtxt(ThisFormSet.Quotes.Phone1.Value,'Phone',10)
			cPhone_Ext		= PrepareSQLtxt(ThisFormSet.Quotes.Ext1.Value,'Phone_ext',6)
			cFax			= PrepareSQLtxt(ThisFormSet.Quotes.Fax1.Value,'Fax',10)
			cEmail			= PrepareSQLtxt(ThisFormSet.Quotes.Email1.Value,'Email',60)
			cAlloy			= PrepareSQLtxt(ThisFormSet.Quotes.Alloy1.Value,'Alloy',12)
			cForm			= PrepareSQLtxt(ThisFormSet.Quotes.cmbForm.Value,'Form',2)
			cCC				= PrepareSQLtxt(ThisFormSet.Quotes.cmbCC.Value,'CC',1)
			cCL				= PrepareSQLtxt(ThisFormSet.Quotes.cmbCL.Value,'CL',1)
			nPieces			= PrepareSQLnum(ThisFormSet.Quotes.Pieces1.Value,'Pieces',7,0)
			nThck			= PrepareSQLnum(ThisFormSet.Quotes.Thck1.Value,'Thck',10,4)
			nSz2			= PrepareSQLnum(ThisFormSet.Quotes.Sz21.Value,'Sz2',9,3)
			nSz3			= PrepareSQLnum(ThisFormSet.Quotes.Sz31.Value,'Sz3',9,3)
			nWeight			= PrepareSQLnum(ThisFormSet.Quotes.Weight1.Value,'Weight',8,1)
			cDescript		= PrepareSQLtxt(ThisFormSet.Quotes.Descript1.Value,'Descript',50)
			nP_lb			= PrepareSQLnum(ThisFormSet.Quotes.P_lb1.Value,'P_lb',8,2)
			nP_pc			= PrepareSQLnum(ThisFormSet.Quotes.P_pc1.Value,'P_pc',9,2)
			nP_ft			= PrepareSQLnum(ThisFormSet.Quotes.P_ft1.Value,'P_ft',8,2)
			nCuts			= PrepareSQLnum(ThisFormSet.Quotes.Cuts1.Value,'Cuts',6,0)
			cOtherFld		= PrepareSQLtxt(ThisFormSet.Quotes.OtherFld1.Value,'OtherFld',10)
			nOtherP			= PrepareSQLnum(ThisFormSet.Quotes.OtherP1.Value,'OtherP',8,2)
			nLotP			= PrepareSQLnum(ThisFormSet.Quotes.LotP1.Value,'LotP',8,2)
		*	nLotCost		= PrepareSQLnum(ThisFormSet.Quotes.LotCost1.Value,'LotCost',8,2)
		
			ncWeight		= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cWEIGHT1.Value,'cWeight',8,1)
		
			nS_QTY	= Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld,gnConnHandle )
			nS_PU	= nPU_Acct_Form( cForm, gnConnHandle) 
			
			PRIVATE nOtherP_per_QTY
			
			DO CASE
			CASE nS_PU=1
				nOtherP_per_QTY = (nOtherP/nWeight)
				IF nOtherP_per_QTY > 0
					nS_P = nP_lb + nOtherP_per_QTY 
				ELSE
					nS_P = nP_lb
				ENDIF
			CASE nS_PU=2
				PRIVATE nFeet &&Proc_HPA
				nFeet = Calc_Feet(nPieces, cForm, nSZ2, nSZ3, gnConnHandle)
				nOtherP_per_QTY = (nOtherP/nFeet)
				IF nOtherP_per_QTY > 0
					nS_P = nP_Ft + nOtherP_per_QTY 
				ELSE
					nS_P = nP_Ft
				ENDIF
			CASE nS_PU=3
				nOtherP_per_QTY = (nOtherP/nPieces)
				IF nOtherP_per_QTY > 0
					nS_P = nP_Pc+ nOtherP_per_QTY 
				ELSE
					nS_P = nP_Pc
				ENDIF
			OTHERWISE
				nS_P = 0
			ENDCASE
				
			ncP_lb			= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cP_lb1.Value,'cP_lb',9,2)
			ncP_pc			= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cP_Pc1.Value,'cP_Pc',9,2)
		*	ncP_ft			= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cP_FT1.Value,'cP_Ft',9,2)
			ncP_Pcc			= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cP_PCc1.Value,'cP_PCc',9,2)
			ccThk			= PrepareSQLtxt(ThisFormSet.QUOTES.pF1.PagePricing.cTHK1.Value,'cTHK',9)
			ncLotP			= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cLotP1.Value,'cLotP',9,2)
			ncLotCP			= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cLotCP1.Value,'cLotCP',9,2)
			ncCut			= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cCut1.Value,'cCut',8,1)
			ncCutM			= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cCutM1.Value,'cCutM',10,2)
			ncKerfD			= PrepareSQLnum(ThisFormSet.QUOTES.pF1.PagePricing.cKerfD.Value,'cKerfD',10,2)
			
			cLeadTime		= PrepareSQLtxt(Quotes.LeadTime,'LeadTime',15)
		*	cLine1			= PrepareSQLtxt(Quotes.Line1,'Line1',60)
			cCustID			= PrepareSQLtxt(Quotes.CustID,'CustID',20)
			cQuoteMemo 		= PrepareSQLtxt(ThisFormSet.Quotes.pf1.PageQuote.edtQuoteMemo.Value,'QuoteMemo',-1)
		
			PRIVATE lOpen_,nBracket,cCustID,cComments,cCountryC,cCountry
			PRIVATE lServices,lRandLen,lMetric,lTN,lStartStock
			PRIVATE cSZ1Orig,cSZ2Orig,cSZ3Orig,cCutOptions,nSurcharge,lRegret
			lOpen_		= PrepareSQLlogic(Quotes.Open_,'Open_',.F.)
			nBracket	= PrepareSQLnum(Quotes.Bracket,'Bracket',-1)
			cCustID		= PrepareSQLtxt(Quotes.CustID,'CustID',20)
			cComments	= PrepareSQLtxt(Quotes.Comments,'Comments',-1)
			cCountryC	= PrepareSQLtxt(Quotes.CountryC,'CountryC',10)
			cCountry	= PrepareSQLtxt(Quotes.Country,'Country',20)
			lServices	= PrepareSQLlogic(Quotes.Services,'Services',.F.)
			lRandLen	= PrepareSQLlogic(Quotes.RandLen,'RandLen',.F.)
			lMetric		= PrepareSQLlogic(Quotes.Metric,'Metric',.F.)
			lTN			= PrepareSQLlogic(Quotes.TN,'TN',.F.)
			lStartStock	= PrepareSQLlogic(Quotes.StartStock,'StartStock',.F.)
			cSZ1Orig	= PrepareSQLtxt(Quotes.SZ1Orig,'SZ1Orig',20)
			cSZ2Orig	= PrepareSQLtxt(Quotes.SZ2Orig,'SZ2Orig',20)
			cSZ3Orig	= PrepareSQLtxt(Quotes.SZ3Orig,'SZ3Orig',20)
			cCutOptions	= PrepareSQLtxt(Quotes.CutOptions,'CutOptions',75)
			nSurcharge	= PrepareSQLnum(Quotes.Surcharge,'Surcharge',-5)
			lRegret		= PrepareSQLlogic(Quotes.Regret,'Regret',.F.)
			
			***
			PRIVATE cNoNoiseName, cNewNoNoiseName
			cNoNoiseName = PrepareSQLtxt(Quotes.NoNoiseName,'NoNoiseName',30,.T.) &&Pad
			cNewNoNoiseName = get_NoNoiseName(cCompany, gnConnHandle)
			IF cNoNoiseName = cNewNoNoiseName 
				*good
			ELSE
				IF LEN(ALLTRIM(cNoNoiseName)) = 0 AND LEN(cCompany) > 0
					REPLACE NoNoiseName WITH cNewNoNoiseName IN Quotes
					cNoNoiseName = cNewNoNoiseName 
				ENDIF
			ENDIF
				
			***
			PRIVATE m.cCut, nCutHR
			m.cCut 		= GetCut_Letter_Number(ThisFormset.QUOTES.pf1.PagePricing.ogCutting.value)
			nCutHR		= PrepareSQLnum(Quotes.CutHR,'CutHR',-2)
		
			PRIVATE  nQ_P, nQ_PU, nQ_QTY, nQ_Total
			nQ_P = 0
			nQ_PU = 0 
			nQ_QTY = 0 
			nQ_Total = 0
		*	nQ_P	= Get_Qoute_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
		*	nQ_QTY	= nS_QTY	&&Set to Form based QTY, then change to Quoted QTY in Get_Quote_Pricing()
			
			****************************************************
			*Use this Function to return a table with the Quoted Answers
			*This overwrite typical units and uses Units found in OtherFld and OtherP
			IF Get_Quote_Pricing(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
				IF USED('tmpQuote_Pricing')
					*nQ_P		= Get_Quote_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
					nQ_P	= PrepareSQLnum(tmpQuote_Pricing.P,'Q_P',-5)
					nQ_PU	= PrepareSQLnum(tmpQuote_Pricing.PU,'Q_PU',-1)
					nQ_QTY	= PrepareSQLnum(tmpQuote_Pricing.QTY,'Q_QTY',-5)
					nQ_Total= PrepareSQLnum(tmpQuote_Pricing.Total,'Q_Total',-5)
		
					USE IN tmpQuote_Pricing
				ENDIF
			ENDIF
			SELECT Quotes
			
			PRIVATE nStandardSize, nCustDisc
			nStandardSize = PrepareSQLnum(getStandardSize( nThck, gnConnHandle ),'StandardSize',9,3,)
			nCustDisc	= PrepareSQLnum(Quotes.CustDisc,'CustDisc',3,2)
					
			************************************************************************
			***CHECK
			
			ThisFormSet.CheckPU_Quoted()
			
			IF NOT Uses3rdDim(cForm,gnConnHandle)
				nSz3 = 0 
			ENDIF
			
			IF cForm = '21' OR cForm = '51' OR cForm = '52' OR cForm = '53'   &&dbo.Forms txt3 = 'Lbs'
				* nWeight = nSz3
				IF nWeight = 0
					nWeight = nSz3
				ENDIF
				IF nSz3 = 0
					nSz3 = nWeight
				ENDIF
			ENDIF
			
			CheckCut_Letter_toForm(m.cCut,cForm)
			
			*Remove Nasties- Not sure what ascii it removes?  PrepareSQLtxt is used!
			cQuoteMemo = ALLTRIM(cQuoteMemo)
			PRIVATE cNewQuoteMemo, mCurrChar, i
			cNewQuoteMemo = ''
			FOR i = 1 TO LEN(cQuoteMemo)
				mCurrChar = SUBST( cQuoteMemo, i, 1)
				IF ASC(mCurrChar) > 0
					cNewQuoteMemo = cNewQuoteMemo + mCurrChar
				ELSE
					TrackError("ASC( SUBST( cQuoteMemo, "+ALLTRIM(STR(i))+", 1)) returned a bad ASC() number. '"+mCurrChar+"'","Invalid Character",PROGRAM(),LINENO(1))
				ENDIF
			NEXT i
			cQuoteMemo = cNewQuoteMemo
			
			***************************************************************************
			*Check Save routine!
			*
			PRIVATE cMess
			cMess = ""
			
			IF nWeight = 0
				IF ncWeight > 1
					cMess = cMess + "Replacing empty Weight field with Calculated  "+ALLTRIM(STR(CEILING(ncWeight)))+" LBS. "+ CHR(13)+ CHR(13)
					nWeight = CEILING(ncWeight)
				ENDIF
			ENDIF
			
			
			*Check sigDim
			PRIVATE nSigDim 
			nSigDim = getSigDim(cForm, gnConnHandle )
			
			DO CASE 
			CASE nSigDim = 0
				*Nothing can be wrong here
			CASE nSigDim = 1
				IF nTHCK <= 0
					cMess = cMess + "This Form '"+cForm+"' requires a Thickness/Diameter."+ CHR(13)
				ENDIF
			CASE nSigDim = 2
				IF nTHCK <= 0
					cMess = cMess + "This Form '"+cForm+"' requires a Thickness/Diameter."+ CHR(13)
					IF nSZ2 < 0
						cMess = cMess + "and requires a length."+ CHR(13)
					ENDIF
				ELSE
					IF nSZ2 <= 0
						cMess = cMess + "This Form '"+cForm+"' requires a length."+ CHR(13)
					ENDIF
				ENDIF
			CASE nSigDim = 3
				IF nTHCK <= 0
					cMess = cMess + "This Form '"+cForm+"' requires a Thickness/Diameter."
					IF nSZ2 <= 0
						cMess = cMess + "and requires a second Dimension." + CHR(13)
						IF nSZ3 <= 0
							cMess = cMess + "and requires a third Dimension." + CHR(13)
						ENDIF
					ELSE
						IF nSZ3 <= 0
							cMess = cMess + "and also requires a third Dimension."+ CHR(13)
						ENDIF
					ENDIF
				ELSE
					IF nSZ2 <= 0
						cMess = cMess + "This Form '"+cForm+"' requires a length." + CHR(13)
						IF nSZ3 <= 0
							cMess = cMess + "and requires a third Dimension." + CHR(13)
						ENDIF
					ELSE
						IF nSZ3 <= 0
							cMess = cMess + "This Form '"+cForm+"' also requires a third Dimension."+ CHR(13)
						ENDIF
					ENDIF
				ENDIF
		
			CASE nSigDim = 6
				*same as 3???
				IF nTHCK <= 0
					cMess = cMess + "This Form '"+cForm+"' requires a Thickness/Diameter." + CHR(13)
					IF nSZ2 <= 0
						cMess = cMess + "and requires a second Dimension." + CHR(13)
						IF nSZ3 <= 0
							cMess = cMess + "and requires a third Dimension." + CHR(13)
						ENDIF
					ELSE
						IF nSZ3 <= 0
							cMess = cMess + "and also requires a third Dimension."+ CHR(13)
						ENDIF
					ENDIF
				ELSE
					IF nSZ2 <= 0
						cMess = cMess + "This Form '"+cForm+"' requires a length." + CHR(13)
						IF nSZ3 <= 0
							cMess = cMess + "and requires a third Dimension."+ CHR(13)
						ENDIF
					ELSE
						IF nSZ3 <= 0
							cMess = cMess + "This Form '"+cForm+"' also requires a third Dimension."+ CHR(13)
						ENDIF
					ENDIF
				ENDIF		
			*OTHERWISE
			ENDCASE
			
			IF LEN(cMess)>0
				MESSAGEBOX(cMess+CHR(13)+"This data will be Saved."+CHR(13)+"Please correct before using this Quote in an Order!",0+64,"Dimension check." )
			ENDIF
			
			***************************************************************************
			
			**Check for Problem Customers
			Customer_Check(cCompany,cName,cPhone,cEmail)
			
			***************************************************************************
			
			***Save
			PRIVATE cUpdate
			cUpdate = "UPDATE dbo.AllQuotes SET "
			cUpdate = cUpdate + " COMPANY='"+cCompany+"'"
			cUpdate = cUpdate + ",NAME='"+cName+"'"
			cUpdate = cUpdate + ",PHONE='"+cPhone+"'"
			cUpdate = cUpdate + ",PHONE_EXT='"+cPhone_Ext+"'"
			cUpdate = cUpdate + ",FAX='"+cFax+"'"
			cUpdate = cUpdate + ",EMAIL='"+cEmail+"'"
		*	cUpdate = cUpdate + ",PO_NUM='"+cPO_NUM+"'"
			cUpdate = cUpdate + ",ALLOY='"+cAlloy+"'"
			cUpdate = cUpdate + ",FORM='"+ALLTRIM(cForm)+"'"
			cUpdate = cUpdate + ",CC='"+ALLTRIM(cCC)+"'"
			cUpdate = cUpdate + ",CL='"+ALLTRIM(cCL)+"'"
			cUpdate = cUpdate + ",PIECES="+STR(nPieces,7,0)+""
			cUpdate = cUpdate + ",THCK="+STR(nTHCK,10,4)+""
			cUpdate = cUpdate + ",SZ2="+STR(nSZ2,9,3)+""
			cUpdate = cUpdate + ",SZ3="+STR(nSz3,9,3)+""
			cUpdate = cUpdate + ",Weight="+STR(nWeight,8,1)+""
			cUpdate = cUpdate + ",DESCRIPT='"+cDESCRIPT+"'"
			cUpdate = cUpdate + ",P_lb="+STR(nP_lb,8,2)+""
			cUpdate = cUpdate + ",P_pc="+STR(nP_pc,9,2)+""
			cUpdate = cUpdate + ",P_ft="+STR(nP_ft,8,2)+""
			cUpdate = cUpdate + ",cuts="+STR(nCuts,6,0)+""
			cUpdate = cUpdate + ",OtherFld='"+cOtherFld+"'"
			cUpdate = cUpdate + ",OtherP="+STR(nOtherP,8,2)+""
			cUpdate = cUpdate + ",LotP="+STR(nLotP,9,2)+""
		*	cUpdate = cUpdate + ",LotCost="+STR(nLotCost,9,2)+""
			cUpdate = cUpdate + ",LeadTime='"+cLeadTime+"'"
			cUpdate = cUpdate + ",cWeight="+STR(ncWeight,8,1)+""
			cUpdate = cUpdate + ",cP_lb="+STR(ncP_lb,8,2)+""
			cUpdate = cUpdate + ",cP_pc="+STR(ncP_pc,9,2)+""
			cUpdate = cUpdate + ",cP_Pcc="+STR(ncP_Pcc,9,2)+""
			cUpdate = cUpdate + ",cTHK='"+ALLTRIM(ccThk)+"'"
			cUpdate = cUpdate + ",cLotP="+STR(ncLotP,9,2)+""
			cUpdate = cUpdate + ",cLotCp="+STR(PrepareSQLnum(ncLotCp,'cLotCp',9,2,.T.,.T.),9,2)+""
			cUpdate = cUpdate + ",cCut="+STR(ncCut,6,2)+""
			
			cUpdate = cUpdate + ",cCutM="+STR(ncCutM,10,2)+""
			cUpdate = cUpdate + ",cKerfD="+STR(ncKerfD,10,2)+""
			
			*		cUpdate = cUpdate + ",Line1='"+PrepareSQLtxt(oQ.Line1,'Line1',60)+"'"
			*-		cUpdate = cUpdate + ",InqDate='"+ALLTRIM(DTOC(oQ.InqDate))+"'"
			*-		cUpdate = cUpdate + ",InqNum="+ALLTRIM(STR(oQ.InqNum,8,0))+""
			*-		cUpdate = cUpdate + ",InqNumP='"+(oQ.InqNumP)+"'"
			*-		cUpdate = cUpdate + ",SalesP='"+ALLTRIM(oQ.SalesP)+"'"
		
			*so		cUpdate = cUpdate + ",SalesNum="+ALLTRIM(STR(oQ.SalesNum,7,0))+""
			*so		cUpdate = cUpdate + ",SOitem='"+(oQ.SOitem)+"'"
			*so		cUpdate = cUpdate + ",Item="+ALLTRIM(STR(oQ.Item,2,0))+""
			*so		cUpdate = cUpdate + ",HPApo="+ALLTRIM(STR(oQ.HPApo,9,0))+""
			*so		cUpdate = cUpdate + ",SaleDate='"+ALLTRIM(DTOC(oQ.SaleDate))+"'"
			*so		cUpdate = cUpdate + ",ShipDate='"+ALLTRIM(DTOC(oQ.ShipDate))+"'"
			*so		cUpdate = cUpdate + ",BuyFrom='"+STRTRAN(ALLTRIM(oQ.BuyFrom),"'","''")+"'"
			*so		cUpdate = cUpdate + ",BuyCost="+ALLTRIM(STR(oQ.BuyCost,10,2))+""
			*so		cUpdate = cUpdate + ",BuyFrom2='"+STRTRAN(ALLTRIM(oQ.BuyFrom2),"'","''")+"'"
			*so		cUpdate = cUpdate + ",HPApo2="+ALLTRIM(STR(oQ.HPApo2,9,0))+""
			cUpdate = cUpdate + ",Open_="+IIF(lOpen_,"1","0")+""
			cUpdate = cUpdate + ",Bracket="+ALLTRIM(STR(nBracket,2,0))+""
			cUpdate = cUpdate + ",CustID='"+cCustID+"'"
			cUpdate = cUpdate + ",QuoteMemo='"+cQuoteMemo+"'"
			cUpdate = cUpdate + ",Comments='"+cComments+"'"
			cUpdate = cUpdate + ",CountryC='"+cCountryC+"'"
			cUpdate = cUpdate + ",Country='"+cCountry+"'"
			cUpdate = cUpdate + ",Services="+IIF(lServices,"1","0")+""
			cUpdate = cUpdate + ",RandLen="+IIF(lRandLen,"1","0")+""
			cUpdate = cUpdate + ",Metric="+IIF(lMetric,"1","0")+""
			cUpdate = cUpdate + ",TN="+IIF(lTN,"1","0")+""
			cUpdate = cUpdate + ",StartStock="+IIF(lStartStock,"1","0")+""
			cUpdate = cUpdate + ",SZ1Orig='"+cSZ1Orig+"'"
			cUpdate = cUpdate + ",SZ2Orig='"+cSZ2Orig+"'"
			cUpdate = cUpdate + ",SZ3Orig='"+cSZ3Orig+"'"
			cUpdate = cUpdate + ",Cover='"+cCover+"'"
			cUpdate = cUpdate + ",Cut='"+m.cCut+"'"
			cUpdate = cUpdate + ",CutHR="+STR(nCutHR)+""
			cUpdate = cUpdate + ",CutOptions='"+cCutOptions+"'"
			cUpdate = cUpdate + ",Surcharge="+STR(nSurcharge,18,4)+""  &&-5 is Money
			cUpdate = cUpdate + ",Regret="+IIF(lRegret,"1","0")+""
			
			cUpdate = cUpdate + ",NoNoiseName='"+cNoNoiseName+"'"
			
			cUpdate = cUpdate + ",Q_P="+STR(nQ_P,18,4)
			cUpdate = cUpdate + ",Q_QTY="+STR(nQ_QTY,18,4)
			cUpdate = cUpdate + ",Q_PU="+STR(nQ_PU,1,0)
			cUpdate = cUpdate + ",Q_Total="+STR(nQ_Total,18,4)
			
			cUpdate = cUpdate + ",S_QTY="+STR(nS_QTY,18,4)
			cUpdate = cUpdate + ",S_P="+STR(nS_P,18,4)
			cUpdate = cUpdate + ",S_PU="+STR(nS_PU,1,0)
			
			cUpdate = cUpdate + ",StandardSize="+STR(nStandardSize,9,3)+""	
			cUpdate = cUpdate + ",CustDisc="+STR(nCustDisc,3,2)+""	
			cUpdate = cUpdate + " WHERE AllQuotes.ID = " + ALLTRIM(STR(Quotes.ID))
			
			nSQLEXEC = SQLEXEC(gnConnHandle,cUpdate)
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
			ELSE
			
				IF Quotes.StartStock
					ThisFormSet.StartingStockSave()
					ThisFormSet.frmStartingStock.Visible = .F.
				ENDIF
			
		*		IF SQLCOMMIT(gnConnHandle) < 1
		*			SQLExecError("Cannot commit."+CHR(13)+cUpdate,gnConnHandle)
		*		ENDIF
			ENDIF
		
			*RELEASE oQ
		
			*Update the view
			THISFORMSET.Quotes.LOCKSCREEN = .T.
			SELECT Quotes
			nCurInqNumP = Quotes.InqNumP
			IF USED('Quotes')
				USE IN Quotes
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
			ENDIF
		
			SELECT Quotes	
			LOCATE FOR InqNumP = nCurInqNumP
			ThisFormSet.Quotes.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
		
		
			******************************************************************
			*Have SalesNum
			PRIVATE lHaveSO
			lHaveSO = .F.
			IF NOT EMPTY(Quotes.SOitem)
				IF ALLTRIM(Proper_SO_Item('')) != "0-00"
					lHaveSO = .T.
				ENDIF
			ENDIF
			IF lHaveSO
				cUpdate = "UPDATE dbo.Ship "
				cUpdate = cUpdate+ " SET SalesP = '"+PrepareSQLtxt(Quotes.Salesp,'SalesP',1)+"'"
				cUpdate = cUpdate+ ",Company = '"+PrepareSQLtxt(Quotes.company,'Company',30)+"'"
				cUpdate = cUpdate+ ",PO_NUM = '"+PrepareSQLtxt(Quotes.PO_NUM,'PO_Num',17)+"'"
				cUpdate = cUpdate+ ",Alloy = '"+PrepareSQLtxt(Quotes.Alloy,'Alloy',12)+"'"
				cUpdate = cUpdate+ ",OrderDate = '"+IIF(EMPTY(Quotes.SaleDate),'',DTOC(Quotes.SaleDate))+"'"
				cUpdate = cUpdate+ " WHERE SOitem = dbo.f_ProperSOitem('"+Quotes.SOitem+"')"
		
				nSQLEXEC = SQLEXEC(gnConnHandle,cUpdate)
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
				ENDIF
		
				*Update Sales with Cutting preference m.cCut
				DO CASE
				CASE m.cCut = "W"
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL +" Wjet = 1"
					cSQL = cSQL +",Plasma = 0"
					cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+Quotes.SOitem +"')"
					
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLExecError(cSQL ,gnConnHandle,nSQLEXEC,'')
					ENDIF
				CASE m.cCut = "P"
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL +" Wjet = 0"
					cSQL = cSQL +",Plasma = 1"
					cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+Quotes.SOitem +"')"
					
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLExecError(cSQL ,gnConnHandle,nSQLEXEC,'')
					ENDIF
				OTHERWISE
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL +" Wjet = 0"
					cSQL = cSQL +",Plasma = 0"
					cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+Quotes.SOitem +"')"
					
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLExecError(cSQL ,gnConnHandle,nSQLEXEC,'')
					ENDIF
				ENDCASE
				
				*Compare edits with the SO 
				PRIVATE nItemTotal
				nItemTotal = ThisFormSet.TotalItem()
				*REPLACE cLotP WITH ThisForm.CalcLotp() IN SalesQuote
				*SalesQuote.ItemSale
				
				PRIVATE nItemSale, cSQL
				
				IF USED('ItemSaleSales')
					USE IN ItemSaleSales
				ENDIF
				
				cSQL = "SELECT ItemSale FROM dbo.Sales WITH(NOLOCK) WHERE SOitem = dbo.f_ProperSOitem('"+Quotes.SOitem +"')"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle,cSQL , 'ItemSaleSales' )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'ItemSaleSales' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ItemSaleSales")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ItemSaleSales")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL ,gnConnHandle,nSQLEXEC, 'ItemSaleSales')
				ENDIF
				nItemSale = 0
				IF USED('ItemSaleSales')
					IF VARTYPE(ItemSaleSales.ItemSale) = "N" OR VARTYPE(ItemSaleSales.ItemSale) = "Y"
						nItemSale = ItemSaleSales.ItemSale
					ENDIF
					USE IN ItemSaleSales
				ENDIF
			
				
				IF nItemSale = 0 
					IF nItemTotal > 0
		
						IF MESSAGEBOX("Your Edited data has a value of $"+ALLTRIM(STR(nItemTotal,7,2))+CHR(13)+;
						  "Your Sales Order has this item valued at $"++ALLTRIM(STR(nItemSale ,7,2))+CHR(13)+;
						  +CHR(13)+;
						  "Do you want to save $"+ALLTRIM(STR(nItemTotal,7,2))+" to your Sales Order now ?";
						  ,4+32,"Do you want to save to Sales Order?")=6 &&6 yes
							*Save to Sales
							*UPDATE Sales SET ItemSale = nItemTotal  WHERE SOitem = Quotes.SOitem
							cSQL = "UPDATE dbo.Sales SET ItemSale = "+STR(nItemTotal,9,2)
							cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+Quotes.SOitem +"')"
							
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
							
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								SQLExecError(cSQL ,gnConnHandle,nSQLEXEC,'')
							ENDIF
						ENDIF
					ENDIF
				ELSE
					IF nItemSale <> nItemTotal 
						IF MESSAGEBOX("Your Edited data has a value of $"+ALLTRIM(STR(nItemTotal,7,2))+CHR(13)+;
						  "Your Sales Order has this item valued at $"++ALLTRIM(STR(nItemSale ,7,2))+CHR(13)+;
						  +CHR(13)+;
						  "Do you want to save $"+ALLTRIM(STR(nItemTotal,7,2))+" to your Sales Order now ?";
						  ,4+32,"Do you want to save to Sales Order?")=6 &&6 yes
							*Save to Sales
							*UPDATE Sales SET ItemSale = nItemTotal  WHERE SOitem = Quotes.SOitem
							cSQL = "UPDATE dbo.Sales SET ItemSale = "+STR(nItemTotal,9,2)
							cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+Quotes.SOitem +"')"
							
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
							
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								SQLExecError(cSQL ,gnConnHandle,nSQLEXEC,'')
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				IF NOT ISNULL(Quotes.SalesNum)
					IF Quotes.SalesNum > 0
						MESSAGEBOX("This SalesOrder will now be listed as "+CHR(13)+"'NOT Printed' and "+CHR(13)+"Changing and "+CHR(13)+"Shop not received.",0+64,"You must reprint with the new edit.")
						Set_Sales_No_Changing( Quotes.SalesNum, gnConnHandle )
						
					ENDIF
				ENDIF
			ENDIF  &&NOT EMPTY(Quotes.SOitem)
		
			ThisFormSet.QuotesRecordChanged()
			THISFORMSET.Quotes.LOCKSCREEN = .F.
		
			THISFORMSET.SetLabelNormal() &&reset buttons
			**************************************************************************************************************	
		
			
		ELSE &&Edit Form
			*Edit
			SELECT Quotes
			
			IF ThisFormSet.AllowEdit('WARN')
			
				THISFORMSET.isadding = .F.  && if Adding, Cancel will DELETE the record
				THISFORMSET.SetLabelEdit
				THISFORMSET.Quotes.Name1.SETFOCUS
				THISFORMSET.CompanyChanged = .F.  &&Initialize
				THISFORMSET.Name1StartEmpty = .F.
				
			ELSE
			
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE foundxcomp		&& Return T/F
		PARAMETER pXcomp
		PRIVATE laResult
		
		IF VARTYPE(pXcomp) = "C"
			IF LEN(pXcomp) < 1
				RETURN .F.
			ENDIF
		ELSE
			RETURN .F.	
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		
		IF USED('tmpQXcomp')
			USE IN tmpQXcomp
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS Cntd "
		cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Xcomp = '"+pXcomp+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQXcomp' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQXcomp' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQXcomp")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQXcomp")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQXcomp')
		ENDIF
		
		IF USED('tmpQXcomp')
			IF tmpQXcomp.Cntd > 0
				USE IN tmpQXcomp
				RETURN .T.
			ELSE
				USE IN tmpQXcomp
			ENDIF
		ENDIF
		
		RETURN .F.
	ENDPROC

	PROCEDURE inch2ft		&& Inches to foot conversion.
		PARAMETER pnLength
		PRIVATE cANS, nFT, nIN
		***inch2ft()
		cANS = " "
		IF pnLength > 0
			nFT = INT(pnLength/12)
			IF nFT > 0
				IF nFT = 1
					cANS = ALLTRIM(STR(nFT))+' Foot'
				ELSE
					cANS = ALLTRIM(STR(nFT))+' Feet'
				ENDIF
				IF pnLength-(nFT*12) > 0
					*Remainder Inches
					nIN = remove0(pnLength-(nFT*12),5,3)
					cANS = cANS+ ', '+ nIN+ ' Inches '
				ELSE
					cANS = cANS+ ' '
				ENDIF
			ELSE
				nIN = remove0(pnLength,5,3)
				IF pnLength >= 1
					cANS = cANS+ nIN +' Inch '
				ELSE
					cANS = cANS+ nIN +' Inches '
				ENDIF
			ENDIF
			cANS = cANS + 'long'
		ENDIF
		
		RETURN cANS
	ENDPROC

	PROCEDURE Init
		SET EXCLUSIVE OFF
		SET TALK OFF
		SET SAFETY OFF
		SET DELETED OFF
		
		PUBLIC tControlSource
		tControlSource = ""
		
		ON KEY LABEL F2 DO FORM Forms\MATHFUNC.SCX WITH (tControlSource) 
		ON KEY LABEL F3 DO Progs\SAVEHEATLOTCERT.PRG
		ON KEY LABEL F4 DO Progs\SAVELOTGFM.PRG
		
		*SET DECIMAL TO 4	&&see in Main.PRG and .LOAD()
		
		
		PUSH MENU _msysmenu
		DO CASE
		CASE FILE('\Menus\quotes.mpr')
			DO \Menus\quotes.mpr
		CASE FILE('Menus\quotes.mpr')
			DO Menus\quotes.mpr
		CASE FILE('\HPA\Menus\quotes.mpr')
			DO \HPA\Menus\quotes.mpr
		*CASE FILE('C:\Program Files\HPA\Menus\quotes.mpr')
		*	DO 'C:\Program Files\HPA\Menus\quotes.mpr'
		*CASE FILE('\Program Files\VFP\Quotes\Menus\quotes.mpr')
		*	DO '\Program Files\VFP\Quotes\Menus\quotes.mpr'
		OTHERWISE
			DO LOCFILE('Quotes','MPR',' Find Quotes.mpr')
		ENDCASE
		
		SET NULLDISPLAY TO ""
		SET REPROCESS TO AUTOMATIC
		
		
		*!*	IF !DBUSED('HPA')
		*!*		DO CASE
		*!*		CASE FILE( "\HPA.DBC" )
		*!*			OPEN DATABASE ("\HPA.DBC") SHARED
		*!*		CASE FILE( "MEM\HPA.DBC" )
		*!*			OPEN DATABASE ("MEM\HPA.DBC") SHARED
		*!*		CASE FILE( "HPA\HPA.DBC" )
		*!*			OPEN DATABASE ("HPA\HPA.DBC") SHARED
		*!*		CASE FILE( "\HPA\MEM\HPA.DBC" )
		*!*			OPEN DATABASE ("\HPA\MEM\HPA.DBC") SHARED
		*!*		OTHERWISE 
		*!*			MESSAGEBOX("Foxpro Database HPA not opened",0+48,"Error")
		*!*		ENDCASE
		*!*	ENDIF
		
		IF USED('tmpShopRecv')
			USE IN tmpShopRecv
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT COUNT(*) AS CNT "
		cSQL = cSQL + " FROM dbo.Sales_No SN WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.AllQuotes Q WITH(NOLOCK) ON SN.SalesNum = Q.SalesNum "
		cSQL = cSQL + " AND ISNULL(SN.ShopRecv,0) = 0 "
		cSQL = cSQL + " AND Q.SalesP = '"+gcSalesP+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpShopRecv')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpShopRecv')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpShopRecv")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpShopRecv")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpShopRecv')
		ENDIF
		IF USED('tmpShopRecv')
			IF tmpShopRecv.CNT > 0
				USE IN tmpShopRecv 
				DO FORM Reports\R_ShopRecv WITH gcSalesP
			ENDIF
		ENDIF
		
		PUBLIC glOutlook
		
		ThisFormSet.frmStockLst_Sum.Left = 220
		ThisFormSet.frmStockLst_Sum.Top = 20
		
		ThisFormSet.frmRemoveORDER.Left = 400
		ThisFormSet.frmRemoveORDER.Top = 300
		
		ThisFormSet.frmShop_Hrs.Visible = .T.
		ThisFormSet.frmShop_Hrs.Left = 0
		ThisFormSet.frmShop_Hrs.Top = 290
		ThisFormSet.RefreshShop_HRS()
		
		ThisFormSet.frmSalesP_Customer.Visible = .T.
		ThisFormSet.frmSalesP_Customer.Left = 0
		ThisFormSet.frmSalesP_Customer.Top = 410
		ThisFormSet.RefreshSalesP_Customer()
	ENDPROC

	PROCEDURE initcmbcl
		*ThisForm.InitcmbCL()
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(ThisFormSet.QUOTES.cmbCC.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			USE IN ConditionLevel
		ENDIF
		
		ThisFormSet.QUOTES.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel WITH(NOLOCK) "
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		ThisFormSet.QUOTES.cmbCL.ColumnCount = 2
		ThisFormSet.QUOTES.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		ThisFormSet.QUOTES.cmbCL.BoundColumn = 1
		ThisFormSet.QUOTES.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					ThisFormSet.QUOTES.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					ThisFormSet.QUOTES.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		ThisFormSet.QUOTES.cmbCL.Value = cCL1
		
		IF ThisFormSet.CC != PrepareSQLtxt(ThisFormSet.QUOTES.cmbCC.Value,'CC',1)
			ThisFormSet.CC = PrepareSQLtxt(ThisFormSet.QUOTES.cmbCC.Value,'CC',1)
		*	This.Parent.cmbCL.Value = ''
			ThisFormSet.QUOTES.cmbCL.Value = Default_CL_CC(cCC,gnConnHandle)
			ThisFormSet.QUOTES.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE inventoryform		&& Returns the 'Form Number' used by the Inventory.
		PARAMETER lcForm
		*InventoryForm
		
		
		*, pReturnDescript
		*lcInvForm =""
		*FormDescription( lcForm, lcInvForm )
		
		**************************************************
		** Use to convert Quotes Forms to Forms used by Inventory
		*10,Bar,11,Flat Bar,12,Hex Bar,13,Square Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
		PRIVATE lcInvForm
		DO CASE
		CASE lcForm= "10" && bar
			lcInvForm = "10"
			lcDescript = "Bar"
		CASE lcForm= "11" && Flat bar
			lcInvForm = "11"	
			lcDescript = "Flat bar"
		CASE lcForm= "12" && Hex bar
			lcInvForm = "12"	
			lcDescript = "Hex bar"
		CASE lcForm= "13" && Square bar
			lcInvForm = "13"	
			lcDescript = "Square bar"
		CASE lcForm= "20" && Wire Spool
			lcInvForm = "20"
			lcDescript = "Wire Spool"
		CASE lcForm= "21" && Wire Spool
			lcInvForm = "20"
			lcDescript = "Wire Cuts"
		CASE lcForm= "30" && Coated Electrodes
			lcInvForm = "30"
			lcDescript = "Coated Electrodes"
		CASE lcForm= "40" && Plate/Sheet
			lcInvForm = "40"
			lcDescript = "Plate/Sheet"
		CASE lcForm= "51" && Strip
			lcInvForm = "40"
			lcDescript = "Strip"
		CASE lcForm= "60" && Tube
			lcInvForm = "60"
			lcDescript = "Tube"
		CASE lcForm= "65" && Pipe
			lcInvForm = "65"
			lcDescript = "Pipe"
		CASE lcForm = "66" && Nipple
			lcInvForm = "65"
			lcDescript = "Nipple"
		CASE lcForm = "67" && Elbow
			lcInvForm = "65"
			lcDescript = "Elbow"
		CASE lcForm = "68" && tee
			lcInvForm = "65"
			lcDescript = "Tee"
		CASE lcForm = "69" && reducer
			lcInvForm = "65"	
			lcDescript = "Reducer"
		CASE lcForm= "70" && Flanges
			lcInvForm = "70"
			lcDescript = "Flanges"
		CASE lcForm= "72" && Machined Flange
			lcInvForm = "72"
			lcDescript = "Machined Flange"
		CASE lcForm= "75" && Fasteners
			lcInvForm = "75"
			lcDescript = "Fasteners"
		CASE lcForm = "80"  &&Cut Disk
			lcInvForm = "40"
			lcDescript = "Cut Disk"
		CASE lcForm = "90"  &&Machined
			lcInvForm = "10"
			lcDescript = "Machined"
		OTHERWISE
			lcInvForm = lcForm
			lcDescript = lcForm
		ENDCASE
		
		*IF pReturnDescript
		*	RETURN lcDescript
		*ELSE
			RETURN lcInvForm 
		*ENDIF
		
	ENDPROC

	PROCEDURE Load
		SET DECIMALS TO 4
	ENDPROC

	PROCEDURE loadquote_no
		*LoadQuote_No()
		IF USED('Quote_No')
			USE IN Quote_No
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT "
		cSQL = cSQL + " QN.Revision "
		cSQL = cSQL + ",QN.ExpireDate "
		cSQL = cSQL + ",QN.ProdReqDefine "
		cSQL = cSQL + ",QN.DiffResolved "
		cSQL = cSQL + ",QN.HPAcapable "
		cSQL = cSQL + ",QN.Comments "
		cSQL = cSQL + " FROM [dbo].[Quote_No] QN WITH(NOLOCK)"
		cSQL = cSQL + " INNER JOIN dbo.[Quote_No_AQID] AQID WITH(NOLOCK) ON QN.ID= AQID.Quote_No_ID "
		cSQL = cSQL + " AND AQID.AllQuotes_ID = "+STR(Quotes.ID)
		
		SELECT 0
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL,'Quote_No' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL,'Quote_No' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Quote_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Quote_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, gnConnHandle,nSQLEXEC,'Quote_No' )
		ENDIF
		
	ENDPROC

	PROCEDURE load_so_poitems		&& For Printing SO
		PARAMETERS cSOitem
		*ThisFormSet.SeekPOitems(SalesQuote.SoItem_A)
		*ThisFormSet.Load_SO_POitems()
		
		IF VARTYPE(cSOitem) != "C"
			cSOitem = ''
			*RETURN .F.
		ENDIF
		IF Proper_SO_item(cSOitem) = Proper_SO_item('')
			*RETURN .F.
		ENDIF
		
		IF USED( 'tmpPOitems' )
			USE IN tmpPOitems
		ENDIF
		
		IF Proper_PO_item(cSOitem) != Proper_PO_item('')
			cSQL = "SELECT LTRIM(p.POitem)+' ' "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.Services,0) = 1 then '{Service} ' else '' end "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.ConvServ,0) = 1 then '{Conversion} ' else '' end "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.WO_Detail,0) > 0 then '{WO_Detail'+RTRIM( CAST(p.WO_Detail AS CHAR(10) ))+'} ' else '' end "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.WO,0) > 0 then '{WO'+RTRIM( CAST(p.WO AS CHAR(10) ))+'} ' else '' end "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.Equipment,0) = 1 then '{Equipment} ' else '' end "
			cSQL = cSQL + " +LTRIM(p.Company) "
			cSQL = cSQL + " +CASE WHEN ISNULL(p.Stock,'') = 'All for Stock' OR ISNULL(p.Stock,'') = 'Mostly Stock' then ' [Stock]' else '' end "
			cSQL = cSQL + " AS POtext "
			cSQL = cSQL + " FROM dbo.PurchaseOrder p "
			cSQL = cSQL + " WHERE p.SOitem = '"+cSOitem+"'"
			cSQL = cSQL + " AND p.Cancelled = 0 "
		ELSE
			*Collect blanks
			cSQL = "SELECT ' ' AS POtext FROM dbo.PurchaseOrder p WITH(NOLOCK) "
			cSQL = cSQL + " WHERE 0>0"
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpPOitems')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpPOitems')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPOitems")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'tmpPOitems')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		ENDIF
		
		************************
		IF USED( 'tmpAllPOitems' )
			USE IN tmpAllPOitems
		ENDIF
		
		cSQL = "SELECT CAST(' ' AS VarChar(MAX)) AS AllPOtext"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpAllPOitems')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpAllPOitems')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpAllPOitems")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpAllPOitems")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'tmpAllPOitems')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM()+" Called:Load_SO_POitems",LINENO(1),cSQL )
		ENDIF
		
		IF USED('tmpAllPOitems')
			IF USED('tmpPOitems')
				SELECT tmpPOitems
				SCAN
					REPLACE AllPOtext WITH ALLTRIM(tmpAllPOitems.AllPOtext) + "|PO "+ ALLTRIM(tmpPOitems.POtext) + " |" IN tmpAllPOitems
					*+CHR(10)+CHR(13)
				ENDSCAN
				USE IN tmpPOitems
			ENDIF
		ELSE
			MESSAGEBOX("Could not load the POitem data that whas used with this SOitem '"+cSOitem+"'",0,"Report will not work")
			RecordTest("Record Test Data.", PROGRAM()+" Called:Load_SO_POitems", LINENO(1),"No data returned. "+CHR(13)+cSQL)
		ENDIF
		
	ENDPROC

	PROCEDURE load_userinfo
		*ThisForm.Load_UserInfo()
		PRIVATE cLegelFileName
		cLegelFileName = ''
		IF USED('UserInfo')
			USE IN UserInfo
		ENDIF
		
		
		PRIVATE cFullFileName 
		cLegelFileName= SYS(3)
		IF "\MEM" $ SYS(2003)
			cFullFileName = SYS(5)+SYS(2003)+"\"+cLegelFileName+".DBF"
		ELSE
			cFullFileName = SYS(5)+SYS(2003)+"\MEM\"+cLegelFileName+".DBF"
		ENDIF
		
		SELECT 0
		
		IF FILE(cFullFileName)
			DELETE FILE cFullFileName
		ENDIF
		
		IF NOT FILE(cFullFileName)
			CREATE TABLE (cFullFileName ) FREE ;
				( UserName C(20), Machine C(20), ServerDir C(20), HOMEDIR C(20), PeachDir C(20), SalesP C(1), Email C(60) )
			USE 
			
			USE (cFullFileName) EXCLUSIVE ALIAS UserInfo
			
			PRIVATE cUserName, cMachine, cServerDir, cHOMEDIR, cPeachDir, cEmail	
			cEmail		= ThisFormset.QUOTES.Userinfo1.email
			cHOMEDIR	= ThisFormset.QUOTES.Userinfo1.homedir
			cMachine	= ThisFormset.QUOTES.Userinfo1.machine
			csalesp		= ThisFormset.QUOTES.Userinfo1.salesp		
			cServerDir	= ThisFormset.QUOTES.Userinfo1.serverdir
			cUserName	= ThisFormset.QUOTES.Userinfo1.username	
				
			APPEND BLANK IN UserInfo
			
			REPLACE UserInfo.UserName WITH cUserName IN UserInfo
			REPLACE UserInfo.SalesP WITH csalesp IN UserInfo
			IF NOT EMPTY(cMachine)
				REPLACE UserInfo.Machine WITH cMachine
			ENDIF
			IF NOT EMPTY(cServerDir)
				REPLACE UserInfo.ServerDir WITH cServerDir
			ENDIF
			IF NOT EMPTY(cHomeDir)
				REPLACE UserInfo.HOMEDIR WITH cHomeDir
			ENDIF	
			IF NOT EMPTY(cEmail)
				REPLACE UserInfo.Email WITH cEmail 
			ENDIF
		
		*	INDEX ON SalesP TAG SalesP 
		ELSE
			MESSAGEBOX("Could not open UserInfo at '"+cFullFileName+"'",0+16,"Error")
		ENDIF
		
		RETURN cLegelFileName
		
	ENDPROC

	PROCEDURE load_worksheet		&& for SO reprint
		PARAMETERS nRecNo
		*ThisFormSet.Load_WorkSheet(1)
		
		IF VARTYPE(nRecNo) != "N"
			nRecNo = 1
		ENDIF
		
		PRIVATE nSalesNum
		nSalesNum	= PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		
		IF USED('WorkSheet')
			USE IN WorkSheet
		ENDIF
		
		cSQL = " SELECT "
		cSQL = cSQL + "  A.Company,A.name,A.phone,A.phone_ext,A.fax,A.phone_ext,A.email,A.PO_num,A.alloy,a.form,A.cc,A.CL,A.pieces,A.thck,A.Sz2,A.sz3,A.weight,A.descript"
		cSQL = cSQL + " ,a.p_lb,A.p_pc,A.p_ft,a.cuts,A.otherfld,A.otherp,A.lotp,A.lotcost,A.leadtime,A.cweight,A.cp_lb,A.cp_lb,A.cp_pcc,A.cthk"
		cSQL = cSQL + " ,A.clotcp,A.clotp,A.ccut,A.Inqdate,A.Inqnum,A.InqNumP,A.SalesP"
		cSQL = cSQL + " ,A.HPApo,A.POitem,A.saledate,A.shipdate,A.buyfrom,A.buycost,A.buyfrom2,A.HPApo2,A.open_,A.Bracket,A.CustID,A.QuoteMemo,A.Comments"
		cSQL = cSQL + " ,A.CountryC,A.Country,A.Services,A.RandLen,A.Metric,A.StartStock,A.TN,A.sz1orig,A.sz2orig,A.sz3orig,A.QuoteDate"
		cSQL = cSQL + " ,A.Cover,A.cut,A.ID,A.line1,A.WO,A.CutOptions,A.Cut,A.CutHR "
		cSQL = cSQL + " ,A.SalesNum AS SalesNum_a, A.SOitem AS SOitem_a, A.Item AS Item_a "
		cSQL = cSQL + " ,S.soitem,S.salesnum,S.item,S.orderspec,S.S_Instrct,S.inv,S.gfm,S.roll,S.press,S.mach,S.cg,S.plasma,S.WJet,S.cert,S.heat"
		*cSQL = cSQL + " ,S.converpo,S.converter,S.conversion,S.converfrt,S.conversent,S.converretu"
		cSQL = cSQL + " ,S.itemtot,S.shipdue,S.shipped,S.qshipped,S.qbackorder,S.matlwt "
		cSQL = cSQL + " ,S.cncld,S.cmplt,S.partno,S.itemcost,S.itemsale,S.gs_cost,S.gs_sale,S.gs_cmplt,S.rma_no,S.qa,S.cofc,s.merc,S.ppo,S.ppn,S.pheat,S.pspec,S.pdesc,S.pother,S.other "
		cSQL = cSQL + " ,S.prcp,S.prcd,S.pckd,S.Urgent,S.shipon,S.Tol,S.JobHours,S.ProcLoc,S.DShip,S.Typ "
		cSQL = cSQL + " ,S.WO,S.StkPaid,S.WO_Detail "
		cSQL = cSQL + " ,S.ProductionWO, S.IntP, S.Export, S.StkCost, S.POCost "
		
		cSQL = cSQL + " ,SP.QTY,SP.AllowSub "
		cSQL = cSQL + " ,SD.Location,SD.FloorStatus,SD.Class "
		cSQL = cSQL + " ,SM.Cond,SM.Specs,SM.Heat AS Heat2 "
		
		cSQL = cSQL + " FROM dbo.AllQuotes A "
		cSQL = cSQL + " INNER JOIN dbo.Sales S ON A.SOitem = S.SOitem "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process SP ON A.SOitem = SP.SOitem "
		cSQL = cSQL + " AND ( SP.Process_ID = 'SELECTED' OR SP.Process_ID='PARTSELECT' )"
		cSQL = cSQL + " AND SP.AllowSub = 'N' "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Detail SD ON SP.ID_Detail = SD.ID_Detail "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Master SM ON SD.ID = SM.ID "
		cSQL = cSQL + " WHERE A.SalesNum = "+STR(nSalesNum)
		cSQL = cSQL + " ORDER BY A.Item "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'WorkSheet')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'WorkSheet')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "WorkSheet")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "WorkSheet")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'WorkSheet')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		ENDIF
		
		
		IF nRecNo <= RECCOUNT('WorkSheet')
			GOTO nRecNo IN WorkSheet
		ENDIF
		
	ENDPROC

	PROCEDURE plasmacut
		PARAMETERS cWHAT
		*ThisFormSet.PlasmaCut()
		*Duplicate code in WaterJet
		
		PRIVATE lDefault
		lDefault = .F.
		IF VARTYPE(cWHAT) = "C"
			IF cWHAT = "DEFAULT"
				lDefault = .T.
			ENDIF
		ENDIF
		
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE cAlloy,cCC,cCL,cForm,nPieces,nThick,nSz2,nSz3
		
		cAlloy	= PrepareSQLtxt(ALLTRIM(Quotes.alloy),'Alloy',12)
		cCC		= PrepareSQLtxt(Quotes.CC,'CC',1)
		cCL		= PrepareSQLtxt(Quotes.CL,'CL',1)
		cForm	= PrepareSQLtxt(Quotes.Form,'Form',2)
		
		nPieces = PrepareSQLnum(Quotes.pieces,'Pieces',10,0)
		nThick	= PrepareSQLnum(Quotes.thck,'Thck',10,4)
		nSz2	= PrepareSQLnum(Quotes.Sz2,'sz2',9,3)
		nSz3	= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		
		IF EMPTY('cAlloy')
			IF NOT lDefault 
				MESSAGEBOX("Alloy has not been entered!",0+64,"Enter Alloy!")
			ENDIF
			RETURN
		ENDIF
		IF EMPTY('cForm')
			IF NOT lDefault 
				MESSAGEBOX("Form has not been entered!",0+64,"Enter Form!")
			ENDIF
			RETURN
		ENDIF
		
		IF NOT ( cForm = "11" OR cForm = "40" OR cForm = "80" )
			IF NOT lDefault 
				MESSAGEBOX("Form must be Flat!",0+64,"Wrong Form!")
			ENDIF
			RETURN
		ENDIF
		
		IF cForm = "90"
			MESSAGEBOX( "Cutting Price Table does not calculate Machined part.",48,"No Cut Price" )
			RETURN .F.
		ENDIF
		
		*************
		ThisFormSet.frmWaterJet.Caption = "Plasma Cutting"
		ThisFormSet.frmWaterJet.lblKerf.Caption = "Kerf="+ALLTRIM(STR(nThick+.050,10,3))+["] &&keep Kerf= to Parse
		ThisFormSet.frmWaterJet.pfQuality.pg80.Enabled = .F.
		ThisFormSet.frmWaterJet.pfQuality.pg60.Enabled = .F.
		ThisFormSet.frmWaterJet.pfQuality.pg40.Enabled = .F.
		ThisFormSet.frmWaterJet.pfQuality.pg20.Enabled = .F.
		**************
		
		IF USED('tmpWaterJet')
			USE IN tmpWaterJet
		ENDIF
		SELECT 0
		
		getWaterJet(nThick,gnConnHandle)	&&'tmpWaterJet'
		
		*ThisForm.txtKerfDollar.Value = ThisFormSet.CalcKerfDollar()
		
		ThisFormSet.BlankBackColorCutting()
		
		IF USED('tmpWaterJet')
			IF NOT lDefault 
				ThisFormSet.frmWaterJet.Visible = .T.
				ThisFormSet.frmWaterJet.AlwaysOnTop = .T.
			ENDIF
			
			ThisFormSet.frmWaterJet.txtThick.Value = nThick
			*100 Percent
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtInch_Min.Value 	= tmpWaterJet.Inch100
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtP_Inch.Value 	= 1/tmpWaterJet.Min100
			
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutWidthDollar.Value 	= PrepareSQLnum(tmpWaterJet.Inch100 * nSz2 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutWidthMin.Value 	= 1/tmpWaterJet.Min100 * nSz2
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLengthDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch100 * nSz3 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLengthMin.Value 	= 1/tmpWaterJet.Min100 * nSz3
		
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLWDollar.Value 	= PrepareSQLnum(tmpWaterJet.Inch100 * (nSz2+nSz3) ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLWMin.Value 		= 1/tmpWaterJet.Min100 * (nSz2+nSz3)
		
		
			ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch100 * (nSz2+nSz2+nSz3+nSz3)  ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedMin.Value		= (1/tmpWaterJet.Min100 * (nSz2+nSz2+nSz3+nSz3) ) 
			
			IF nPieces > 0
				ThisFormSet.frmWaterJet.pfQuality.pg100.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombMin.Visible = .T.
		
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombDollar.Value	= PrepareSQLnum( (tmpWaterJet.Inch100 * (nSz2+nSz3+nSz3) * nPieces ) + ( tmpWaterJet.Inch100 * nSz2 ) ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombMin.Value		= (1/tmpWaterJet.Min100 * (nSz2+nSz3+nSz3) * nPieces ) + ( 1/tmpWaterJet.Min100 * nSz2 )
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg100.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombMin.Visible = .F.
			ENDIF
			
			IF cForm = "80"
				ThisFormSet.frmWaterJet.pfQuality.pg100.lblDisk.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskMin.Visible = .T.
				
				*Remove 4 Sided		
				ThisFormSet.frmWaterJet.pfQuality.pg100.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombMin.Visible = .F.
		
				IF nSz3 > 0
					ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch100  * ((3.14 * nSz2)+(3.14 * nSz3)) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskMin.Value	= 1/tmpWaterJet.Min100 * ((3.14 * nSz2)+(3.14 * nSz3))
				ELSE
					ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch100  * (3.14 * nSz2) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskMin.Value	= 1/tmpWaterJet.Min100 * (3.14 * nSz2)
				ENDIF
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg100.lblDisk.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskMin.Visible = .F.
			ENDIF
		
		
		
			*************
			ThisFormSet.frmWaterJet.AlwaysOnTop = .F.
			ThisFormset.frmWaterJet.pfQuality.ActivePage = 1
			USE IN tmpWaterJet
			
			**********************************************************************************************************************
			*Hi Lite stored selection
			PRIVATE cCutOptions,cCutOptions1,nCutOption ,cCutOptionsSpeed
			cCutOptions = PrepareSQLtxt(Quotes.CutOptions,'CutOptions',75,.T.)
			
			*Plasma cut along length+width $35.44 +0.125" -0
			IF UPPER(LEFT(cCutOptions,10))="PLASMA CUT"
				cCutOptions1 = RIGHT(cCutOptions,39)
				DO CASE
				CASE UPPER(LEFT(cCutOptions1,12)) = "ALONG WIDTH "
					nCutOption = 1
					cCutOptions1 = RIGHT(cCutOptions1,28)
				CASE UPPER(LEFT(cCutOptions1,13)) = "ALONG LENGTH "
					nCutOption = 2
					cCutOptions1 = RIGHT(cCutOptions1,27)
				CASE UPPER(LEFT(cCutOptions1,18)) = "ALONG LENGTH+WIDTH"
					nCutOption = 3
					cCutOptions1 = RIGHT(cCutOptions1,22)
				CASE UPPER(LEFT(cCutOptions1,8)) = "COMBINED"
					nCutOption = 5
					cCutOptions1 = RIGHT(cCutOptions1,31)
				CASE UPPER(LEFT(cCutOptions1,6)) = "4 SIDE"
					nCutOption = 4
					cCutOptions1 = RIGHT(cCutOptions1,34)
				CASE UPPER(LEFT(cCutOptions1,8)) = "CUT DISK"
					nCutOption = 6
					cCutOptions1 = RIGHT(cCutOptions1,32)
				OTHERWISE
					nCutOption = 0
				ENDCASE	
					
				cCutOptionsSpeed = SUBSTR(cCutOptions1, AT('@',cCutOptions1)+1,3)
		
		
		*		ThisFormset.frmWaterJet.pfQuality.ActivePage = 1
				DO CASE
				CASE nCutOption = 1
					ThisFormset.frmWaterJet.pfQuality.Pg100.txtOneCutWidthDollar.BackColor = RGB(255,255,128)
				CASE nCutOption = 2
					ThisFormset.frmWaterJet.pfQuality.Pg100.txtOneCutLengthDollar.BackColor = RGB(255,255,128)
				CASE nCutOption = 3
					ThisFormset.frmWaterJet.pfQuality.Pg100.txtOneCutLWDollar.BackColor = RGB(255,255,128)
				CASE nCutOption = 4
					ThisFormset.frmWaterJet.pfQuality.Pg100.txt4SidedDollar.BackColor = RGB(255,255,128)
				CASE nCutOption = 5
					ThisFormset.frmWaterJet.pfQuality.Pg100.txt4SidedCombDollar.BackColor = RGB(255,255,128)
				CASE nCutOption = 6
					ThisFormset.frmWaterJet.pfQuality.Pg100.txtDiskDollar.BackColor = RGB(255,255,128)
				ENDCASE			
		
			ENDIF
			
		ELSE
			MESSAGEBOX("Could not retrieve Cutting Tables.",48,"SQL Error")
			TrackError("Could not retrieve Plasma Cutting Tables in frmQuotes.","PlasmaCut",PROGRAM(),LINENO(1) )
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		IF lDefault 
			ThisFormSet.frmWaterJet.pfQuality.Pg100.lblDisk.Click
			ThisFormset.frmWaterJet.cmdSave.Click
		ENDIF
	ENDPROC

	PROCEDURE pricebracket		&& Chose another pricing bracket.
		IF USED('PriceTable')
			SELECT PriceTable
			USE
		ENDIF
		SELECT 0
		*USE pricetbl INDEX pricetbl SHARED
		USE PriceTable SHARED
		INDEX ON alloy+FORM+LTRIM(STR(VAL(thk),9,3)) TAG PriceTable
		SET ORDER TO TAG PriceTable
		
		m.iform  = IIF(Quotes.FORM='80','40',Quotes.FORM)
		SEEK Quotes.alloy+ m.iform+ LTRIM( STR( Quotes.thck,10,4))
		
		
		IF NOT FOUND()
			SEEK Quotes.alloy+m.iform
			IF FOUND()
				SET FILTER TO alloy=Quotes.alloy .AND. FORM = m.iform
				DO WHILE (Quotes.thck- (Quotes.thck* .05)) > VAL(PriceTable.thk) .AND. .NOT. EOF()
					SKIP
				ENDDO
			ENDIF
		ENDIF
		
		
		
		IF Quotes.alloy = PriceTable.alloy AND m.iform = PriceTable.FORM
			IF PriceTable.stkbase > PriceTable.BASE
		*		? CHR(7)
		*		? CHR(7)
		*		? CHR(7)
				WAIT WINDOW 'HIGH INVENTORY COST '+TRIM(STR(PriceTable.stkbase,7,2))+'  any key to continue...'
			ENDIF
		
		DEFINE WINDOW pricebrkt FROM 12,1 TO 16,78 IN SCREEN TITLE "PRICE BRACKETTES" DOUBLE
		ACTIVATE WINDOW pricebrkt
		@ 0,1 SAY 'Bracket:' COLOR +2/1
		@ 1,1 SAY thk
		@ 0,13 SAY '1' COLOR +2/1
		@ 1,14 SAY '0#'
		@ 2,10 SAY w0
		@ 0,22 SAY '2' COLOR +2/1
		@ 1,22 SAY ' 10#'
		@ 2,20 SAY w10
		@ 0,32 SAY '3' COLOR +2/1
		@ 1,32 SAY ' 25#'
		@ 2,30 SAY w25
		@ 0,42 SAY '4' COLOR +2/1
		@ 1,42 SAY ' 50#'
		@ 2,40 SAY w50
		@ 0,51 SAY '5' COLOR +2/1
		@ 1,51 SAY '100#'
		@ 2,50 SAY w100
		@ 0,60 SAY '6' COLOR +2/1
		@ 1,60 SAY ' 200#'
		@ 2,60 SAY w200
		@ 0,70 SAY '7' COLOR +2/1
		@ 1,70 SAY ' 400#'
		@ 2,70 SAY w400
		
		WAIT WINDOW 'Enter BRACKET number to change to, or any key to continue' TO BLANK
		
		DEACTIVATE WINDOW pricebrkt
		RELEASE WINDOW pricebrkt
		IF VAL(BLANK) > 0
			SELECT Quotes
			REPLACE Quotes.bracket WITH VAL(BLANK) IN Quotes
			*ThisFormset.QUOTES.pf1.PagePricing.spnPriceBracket
			DO CASE
			CASE VAL(BLANK) = 1
				newpplb = w0
			CASE VAL(BLANK) = 2
				newpplb = w10
			CASE VAL(BLANK) = 3
				newpplb = w25
			CASE VAL(BLANK) = 4
				newpplb = w50
			CASE VAL(BLANK) = 5
				newpplb = w100
			CASE VAL(BLANK) = 6
				newpplb = w200
			CASE VAL(BLANK) = 7
				newpplb = w400
			OTHERWISE
				newpplb = Quotes.cp_lb
				SELECT Quotes
				REPLACE Quotes.bracket WITH 0 IN Quotes
			ENDCASE
			IF newpplb = 0
				WAIT WINDOW 'This bracket is empty' NOWAIT
			ELSE
				oldpplb = Quotes.cp_lb
				SELECT Quotes
				REPLACE Quotes.cp_lb WITH newpplb IN Quotes
				REPLACE Quotes.cp_pc WITH IIF(Quotes.cp_pc=0,0, (Quotes.cp_pc/oldpplb)*newpplb) IN Quotes
				REPLACE Quotes.cp_pcc WITH IIF(Quotes.cp_pcc=0,0, (Quotes.cp_pcc/oldpplb)*newpplb) IN Quotes
				REPLACE Quotes.clot WITH IIF(Quotes.clot=0,0,(Quotes.clot /oldpplb)*newpplb) IN Quotes
				REPLACE Quotes.clotc WITH IIF(Quotes.clotc=0,0,(Quotes.clotc /oldpplb)*newpplb) IN Quotes
				REPLACE Quotes.ccut WITH IIF(Quotes.ccut=0,0,(Quotes.ccut /oldpplb)*newpplb) IN Quotes
		
		
				*			ThisFormSet.QUOTES.pf1.PagePricing.cp_lb1.Refresh
				*			ThisFormSet.QUOTES.pf1.PagePricing.cp_pc1.Refresh
				*			ThisFormSet.QUOTES.pf1.PagePricing.cp_pcc1.Refresh
				*			ThisFormSet.QUOTES.pf1.PagePricing.clot1.Refresh
				*			ThisFormSet.QUOTES.pf1.PagePricing.clotc1.Refresh
				*			ThisFormSet.QUOTES.pf1.PagePricing.ccut1.Refresh
				*			ThisFormSet.QUOTES.pf1.PagePricing.bracket1.Refresh
			ENDIF
		ENDIF
		ELSE
			WAIT WINDOW "NOT FOUND" NOWAIT
		ENDIF
		
		USE
		IF USED('Quotes')
			SELECT Quotes
		ENDIF
		
	ENDPROC

	PROCEDURE quotesdescription		&& Builds the discription line.
		PARAMETER lcForm, lnThck, lnSz2, lnSz3
		PRIVATE lcDiscript
		lcDiscript = ""
		********************************************************************
		** ThisFormSet.QuotesDescription( Quotes.Form, Quotes.thck, Quotes.sz2, Quotes.sz3 )
		********************************************************************
		DO CASE
			CASE lcForm = '51'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'" X '+ Remove0(lnSz2,9,3,.F.)+'"Wide Strip'
			CASE lcForm = '52'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'" X '+ Remove0(lnSz2,9,3,.F.)+'"Wide Coil'
			CASE lcForm = '53'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'" X '+ Remove0(lnSz2,9,3,.F.)+'"Wide Hot Band'
			CASE lcForm = '60'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'"OD x '+ Remove0(lnSz2,9,3,.F.)+'"WALL x '+ ThisFormSet.inch2ft(lnSz3)
			CASE Quotes.form = '65'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'" SCH'+ Remove0(lnSz2,9,3,.F.)+' x '+ ThisFormSet.inch2ft(lnSz3)
			CASE Quotes.form = '66'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'" SCH'+ Remove0(lnSz2,9,3,.F.)+' x '+ ThisFormSet.inch2ft(lnSz3)+' Nipple'
			CASE Quotes.form = '67'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'" SCH'+ Remove0(lnSz2,9,3,.F.)+' x '+ ThisFormSet.inch2ft(lnSz3)+' Degree Elbow'
			CASE Quotes.form = '68'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'" SCH'+ Remove0(lnSz2,9,3,.F.)+' Tee'
			CASE Quotes.form = '69'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +' X '+ Remove0(lnSz2,9,3,.F.)
				IF lnSz3 > 0
					lcDiscript = lcDiscript + ' " SCH ' +ThisFormSet.inch2ft(lnSz3)
				ENDIF
				lcDiscript = lcDiscript + ' Reducer'
			CASE Quotes.form = '70'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'" '
				IF lnSz2 > 0
					lcDiscript = lcDiscript + Remove0(lnSz2,9,3,.F.) + " Lb"
				ENDIF
				lcDiscript = lcDiscript + ' Flange'
			CASE lcForm = '72'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) +'" '
				IF lnSz2 > 0
					lcDiscript = lcDiscript + Remove0(lnSz2,9,3,.F.)+'# '
				ENDIF
				IF lnSz3 > 0
					lcDiscript = lcDiscript + Remove0(lnSz3,9,3,.F.)
				ENDIF
				lcDiscript = lcDiscript + '  Flange'
			CASE lcForm = '75'
				lcDiscript = ThisFormSet.Dec2Frac(lnThck) 
				IF lnSz2 > 0
					lcDiscript = lcDiscript + '"-'+ Remove0(lnSz2,9,3,.F.)
				ENDIF
				IF lnSz3 > 0
					lcDiscript = lcDiscript + ' x '+Remove0(lnSz3,9,3,.F.)+'"Lg '
				ENDIF
			CASE lcForm = '80'
		***************
				REPLACE Quotes.weight   WITH mdlbr IN Quotes
				mdlb = dlbcut+mdlb
		****************
				REPLACE Quotes.cweight  WITH mdlb IN Quotes
				m.iqdesc = ;
					Remove0(lnThck,10,4,.F.)+'"THK x '+;
					Remove0(lnSz2,9,3,.F.)+'"OD '
				IF !EMPTY(lnSz3)
					m.iqdesc= m.iqdesc +'x '+ Remove0(lnSz3,9,3)+'"ID '
				ENDIF
				lcDiscript = m.iqdesc +IIF(lnSz3=0,' DISK',' RING')
			CASE lcForm = "90"
			lcDiscript = ""
		ENDCASE
		RETURN lcDiscript
	ENDPROC

	PROCEDURE quotesrecordchanged
		*ThisFormSet.QuotesRecordChanged()
		
		ThisFormset.QUOTES.CustID1.Refresh
		IF EMPTY(Quotes.CustID)
			ThisFormset.QUOTES.CustID1.BackColor = RGB(255,0,0)
		ELSE
			ThisFormset.QUOTES.CustID1.BackColor = RGB(255,255,255)
		ENDIF
		
		DO CASE
		CASE ThisFormSet.QUOTES.pf1.ActivePage = 1
			*PageOutSource
			ThisFormSet.ShowSources()
		CASE ThisFormSet.QUOTES.pf1.ActivePage = 2
			*PageQuote
			ThisFormSet.ShowQuote()
		CASE ThisFormSet.QUOTES.pf1.ActivePage = 3
			*PagePricing
			ThisFormSet.ShowPricing()
		CASE ThisFormSet.QUOTES.pf1.ActivePage = 4
			*PageSales
			ThisFormSet.ShowSales()
		CASE ThisFormSet.QUOTES.pf1.ActivePage = 5
			*PageSold
			ThisFormSet.ShowSold()
		CASE ThisFormSet.QUOTES.pf1.ActivePage = 6
			*PageStatus
			ThisFormSet.ShowStatus()
		CASE ThisFormSet.QUOTES.pf1.ActivePage = 7
			*PageQA
			ThisFormSet.ShowQA()
		CASE ThisFormSet.QUOTES.pf1.ActivePage = 8
			*PageProcess
			ThisFormSet.ShowProcess()
		ENDCASE
		
		IF VARTYPE(ThisFormSet.frmStockLst_Sum)="O"
			IF ThisFormSet.frmStockLst_Sum.Visible
				ThisFormSet.StockLst_Sum_ReLoad()
			ENDIF
		ENDIF
		
		*IF ThisFormSet.frmQA.Visible
		*	ThisFormSet.ShowQA_frmQA(0,Quotes.ID)
		*ENDIF
		
		IF ThisFormSet.frmQAQuote.Visible
			ThisFormSet.ShowQAQuote()
		ENDIF
		
		IF Quotes.StartStock 
			ThisFormset.QUOTES.lblStartingStock.BackColor = RGB(255,255,128)
			ThisFormSet.ShowStartStock()
		ELSE
			ThisFormset.QUOTES.lblStartingStock.BackColor = RGB(192,192,192)
			ThisFormSet.ShowStartStock('EMPTY')
		ENDIF
		
		ThisFormSet.ShowCustomerNotes()
		*ThisFormSet.ShowCustomerTerms('NOWAIT')  &&Called later
		ThisFormSet.WarnSalesOrder()
		ThisFormSet.RefreshShop_HRS()
		ThisFormSet.RefreshSalesP_Customer()
		
		IF ThisFormSet.frmCustomerHistory.Visible
			ThisFormSet.ShowCustomerHistory()
		ENDIF
		
		ThisFormSet.RefreshSalesPOverlap('')
		
		ThisFormSet.ShowPricingPMI()
		
		IF ThisFormSet.frmDupQoute.Visible
			ThisFormSet.CheckCompanyAlloyDuplicate(Quotes.Alloy)
		ENDIF
		
		ThisFormSet.ShowCustomerTerms('NOWAIT')
	ENDPROC

	PROCEDURE refreshallquotes
		PARAMETERS lStayOnRecord
		*ThisFormSet.RefreshAllQuotes()
		
		IF VARTYPE(lStayOnRecord) != "L"
			lStayOnRecord = .F.
		ENDIF
		PRIVATE cCurrentInqNumP
		cCurrentInqNumP = Quotes.InqNumP
		
		PRIVATE cmbSalesp
		cmbSalesp = UPPER(ALLTRIM(ThisFormset.QUOTES.cmbFilterSalesP.VALUE))
		
		IF EMPTY(cmbSalesp)
			cmbSalesp = gcSalesP
		ENDIF
		
		*************************************************************
		**Also See cmdFind.Click, can change SalesP from there !!! **
		*************************************************************
		
		
		WAIT WINDOW 'Selecting Records' NOWAIT
		IF cmbSalesp = "*"
			gcSalesP = ""
			gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) WHERE InqDate > "+gcShowFromDate+" ORDER BY InqDate"
			*gcQuotesOR+
		ELSE
			gcSalesP = cmbSalesp
			
			gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
			gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
			gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
			gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
			gcSQL=gcSQL + gcQuotesOR
			*gcSQL=gcSQL +" ORDER BY InqNumP"
			gcSQL=gcSQL +" ORDER BY InqDate"
						
		ENDIF
		
		ThisFormSet.QUOTES.cboTgq82.Value = 3 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
		
		ThisFormSet.SalesP = gcSalesP
		ThisFormSet.QUOTES.cmbFilterSalesP.Refresh
		ThisFormSet.QUOTES.SalesP1.Refresh
		ThisFormSet.QUOTES.txtSalesP.Refresh
		
		*ThisFormset.QUOTES.txtSalesP.Value = gcSalesP
		THISFORMSET.SetUserInfo(gcSalesP)
		
		*Update the view
		ThisFormSet.Quotes.LockScreen = .T.
		IF USED('Quotes')
			SELECT Quotes
			*nCurInqNum = Quotes.InqNumP
		
			USE IN Quotes
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, "Quotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, "Quotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(gcSQL, gnConnHandle,nSQLEXEC, 'Quotes')
		ENDIF
		
		ThisFormset.QUOTES.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
		ThisFormSet.Quotes.LockScreen = .F.			
		
		IF NOT USED('Quotes')
			*TRY again
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, "Quotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, "Quotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(gcSQL, gnConnHandle,nSQLEXEC, 'Quotes')
			ENDIF
		ELSE
			IF RECCOUNT('Quotes') = 0
				*****************
				WAIT WINDOW 'Did not find current quote, going back for more....' NOWAIT
				gcShowFromDate = "'"+DTOC(DATE() - (gnQuotesShowDays + 365) )+"'"
				
				gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
				gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
				gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
				gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
				gcSQL=gcSQL + gcQuotesOR
				*gcSQL=gcSQL +" ORDER BY InqNumP"
				gcSQL=gcSQL +" ORDER BY InqDate"
				
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, "Quotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, "Quotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
				ENDIF
				*****************
				IF USED('Quotes')
					IF RECCOUNT('Quotes') > 0
						gnQuotesShowDays = gnQuotesShowDays + 365
					ELSE
						*****************
						WAIT WINDOW 'Did not find current quote, going back for even more....' NOWAIT
						
						gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
						gcSQL=gcSQL +" WHERE ( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
						gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
						*gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
						gcSQL=gcSQL + gcQuotesOR
						*gcSQL=gcSQL +" ORDER BY InqNumP"
						gcSQL=gcSQL +" ORDER BY InqDate"
						
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, "Quotes")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, "Quotes")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
						ENDIF
						*****************
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.QUOTES.cboTgq82.Value = 3
		
		SELECT Quotes
		IF lStayOnRecord 
			IF VARTYPE(cCurrentInqNumP ) = "C"
				LOCATE FOR InqNumP = cCurrentInqNumP 
			ELSE
				GO BOTTOM
			ENDIF
		ELSE
			GO BOTTOM
		ENDIF
		
		
		ThisFormSet.QuotesRecordChanged()
		
		SELECT Quotes
		
		WAIT WINDOW "At the end of the database list" NOWAIT
		ThisFormset.QUOTES.REFRESH
		
		
	ENDPROC

	PROCEDURE refreshforms
		PARAMETERS pSS
		*ThisFormSet.RefreshForms()
		*********************************************************************************
		** CHANGES HERE MUST BE REPLICATED TO WorkOrder, PurchaseOrder and PackingSlip
		** Form Changes must be made to Proc_Quotes.prg **
		*********************************************************************************
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		
		IF VARTYPE(pSS) != 'N'
			pSS = 0
		ENDIF
		
		IF pSS = 0
			pForm = Quotes.Form
			
			IF EMPTY(pForm)
				pForm = ThisFormset.QUOTES.cmbForm.Value
			ENDIF
			IF NOT EMPTY(pForm)
				IF GetFormCaptions(pForm,gnConnHandle)
					IF USED('tmpFormCaptions')
						ThisFormset.QUOTES.LBLTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
						ThisFormset.QUOTES.LBLSZ21.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormset.QUOTES.LBLSZ21.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormset.QUOTES.LBLSZ31.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormset.QUOTES.LBLSZ31.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormset.QUOTES.SZ31.Visible 	= tmpFormCaptions.use3rdDim
						ThisFormset.QUOTES.SZ31.Enabled 	= tmpFormCaptions.Sz3Enable
						ThisFormset.QUOTES.LBLSZ41.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormset.QUOTES.LBLSZ41.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ELSE
						TrackMess( "tmpFormCaptions is not used!")
					ENDIF
				ELSE
					TrackMess("GetFormCaptions returned False!")
				ENDIF
			ELSE
				TrackMess("GetFormCaptions did not have a Form!")
			ENDIF
			IF NOT EMPTY(lCurrentTable)
				IF USED(lCurrentTable)
					SELECT (lCurrentTable)
				ENDIF
			ENDIF
		
		ELSE
			**Pass (1) to get SS
			pForm = ThisFormset.frmStartingStock.sscmbForm.Value
			IF NOT EMPTY(pForm)
				IF GetFormCaptions(pForm,gnConnHandle)
					IF USED('tmpFormCaptions')
		
						ThisFormset.frmStartingStock.ssLBLTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
						ThisFormset.frmStartingStock.ssLBLSZ21.Caption 	= RTRIM(tmpFormCaptions.txt2)
						ThisFormset.frmStartingStock.ssLBLSZ21.Visible 	= tmpFormCaptions.lblSz2Vis
						ThisFormset.frmStartingStock.ssLBLSZ31.Caption 	= RTRIM(tmpFormCaptions.txt3)
						ThisFormset.frmStartingStock.ssLBLSZ31.Visible 	= tmpFormCaptions.lblSz3Vis
						ThisFormset.frmStartingStock.ssSZ31.Visible 	= tmpFormCaptions.use3rdDim
						ThisFormset.frmStartingStock.ssSZ31.Enabled 	= tmpFormCaptions.Sz3Enable
						ThisFormset.frmStartingStock.ssLBLSZ41.Caption	= RTRIM(tmpFormCaptions.txt4)
						ThisFormset.frmStartingStock.ssLBLSZ41.Visible 	= tmpFormCaptions.lblSz4Vis
						
						USE IN tmpFormCaptions
					ELSE
						TrackMess( "tmpFormCaptions is not used!")
					ENDIF
				ELSE
					TrackMess("GetFormCaptions returned False!")
				ENDIF
			ELSE
				TrackMess("GetFormCaptions did not have a Form!")	
			ENDIF
			IF NOT EMPTY(lCurrentTable)
				IF USED(lCurrentTable)
					SELECT (lCurrentTable)
				ENDIF
			ENDIF
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE refreshsalespoverlap
		PARAMETERS cCompany
		*ThisFormSet.RefreshSalesPOverlap()
		
		IF EMPTY(cCompany)
			IF VARTYPE(ThisFormSet.frmSalesPOverlap) = "O"
				ThisFormSet.frmSalesPOverlap.Visible = .F.
			ENDIF
			RETURN	
		ENDIF
		
		PRIVATE cSalesP
		cSalesP = Quotes.salesp
		    
		IF USED('tmpSalesPOverlap')
			ThisFormset.frmSalesPOverlap.grdSalesP.RecordSource = ""
			USE IN tmpSalesPOverlap
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT SalesP AS SP, COUNT(SalesP) AS Cnt "
		cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
		cSQL = cSQL + " WHERE LEFT(company,10) = LEFT('"+ cCompany +"',10)"
		cSQL = cSQL + " AND inqdate > GETDATE()-90 "
		cSQL = cSQL + " AND salesp != '"+cSalesP+"'"
		cSQL = cSQL + " Group By SalesP "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSalesPOverlap')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSalesPOverlap')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesPOverlap")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesPOverlap")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSalesPOverlap')
		ENDIF
		
		
		IF NOT USED('tmpSalesPOverlap')
			MESSAGEBOX( "Could not loading the SalesP Overlap table.","Program Error")
			TrackError("Could not loading the SalesP Overlap table.","Could not loading the SalesP Overlap table.", PROGRAM(), LINENO(1))
			RETURN ""
		ENDIF
		IF VARTYPE(tmpSalesPOverlap.SP) != "C"
			MESSAGEBOX( "Could not loading the SalesP Overlap table.","Program Error")
			TrackError("SalesP Overlap table has bad data.","Could not loading the SalesP Overlap table.", PROGRAM(), LINENO(1))
			RETURN ""
		ENDIF
		
		SELECT tmpSalesPOverlap
		IF VARTYPE(ThisFormSet.frmSalesPOverlap)="O"
			ThisFormset.frmSalesPOverlap.grdSalesP.RecordSource = "tmpSalesPOverlap"
			ThisFormSet.frmSalesPOverlap.Caption = '   SalesP 90 days.'
			ThisFormSet.frmSalesPOverlap.Top  = ThisFormSet.QUOTES.Top  + ThisFormSet.QUOTES.Height - ThisFormSet.frmSalesPOverlap.Height
			ThisFormSet.frmSalesPOverlap.Left = ThisFormSet.QUOTES.Left + ThisFormSet.QUOTES.Width + 6
		
			ThisFormset.frmSalesPOverlap.Visible = .T.
			*ThisFormset.frmSalesPOverlap.AlwaysOnTop = .T.
		ELSE
			MESSAGEBOX("Program lost the 'SalesP Overlap' Window"+CHR(13)+"Please resart the program",0,"Lost ThisFormSet.frmSalesPOverlap Object")
			TrackError("Lost ThisFormSet.frmSalesPOverlap Object"+CHR(13)+"Program lost the 'SalesP Overlap' Window"+CHR(13)+"Please resart the program","Lost ThisFormSet.frmSalesPOverlap Object", PROGRAM(), LINENO(1))
		ENDIF
	ENDPROC

	PROCEDURE refreshsalesp_customer
		*ThisFormSet.RefreshSalesP_Customer
		
		*IF ThisFormSet.frmSalesP_Customer.Visible
			
			
			PRIVATE cCustomer, cNoNoiseName, cSalesP, cCustID
			cCustomer	= PrepareSQLtxt(Quotes.Company,'Company',30)
			cNoNoiseName= PrepareSQLtxt(Quotes.NoNoiseName,'NoNoiseName',30,.T.)
			cSalesP		= PrepareSQLtxt(Quotes.SalesP,'SalesP',1)
			cCustID		= PrepareSQLtxt(Quotes.CustID,'CustID',20)
			
			IF EMPTY(cCustomer+cNoNoiseName)
				ThisFormSet.frmSalesP_Customer.Visible = .F.
			ELSE
				PRIVATE cSQL, nSQLEXEC 
				cSQL = ''
				
				IF USED('tmpSalesP_Customer')
					ThisFormSet.frmSalesP_Customer.grdSPC.RecordSource = ''
					USE IN tmpSalesP_Customer
				ENDIF
				
				SELECT 0
				
			*	cSQL = "SELECT 'SoldCode' AS [Type], COUNT(*) AS CNT, '*' AS Sp FROM dbo.SalesP_Customer WITH (NOLOCK) WHERE SoldCode = 43064
			*	cSQL = cSQL+" UNION "
				cSQL = cSQL+" SELECT 'NoNoise' AS [Type], COUNT(*) AS CNT, '*' AS Sp FROM dbo.SalesP_Customer WITH(NOLOCK) WHERE NoNoiseName = '"+cNoNoiseName+"'"
				cSQL = cSQL+" UNION "
				cSQL = cSQL+" SELECT 'Company' AS [Type], COUNT(*) AS CNT, '*' AS Sp FROM dbo.SalesP_Customer WITH(NOLOCK) WHERE Customer = '"+cCustomer+"'"
				cSQL = cSQL+" UNION "
				cSQL = cSQL+" SELECT 'Cust ID' AS [Type], COUNT(*) AS CNT, '*' AS Sp FROM dbo.SalesP_Customer WITH(NOLOCK) WHERE CustID = '"+cCustID+"'"
				cSQL = cSQL+" UNION "
			*	cSQL = cSQL+" SELECT 'SoldCode' AS [Type], COUNT(*) AS CNT, '"+cSalesP+"' AS Sp FROM dbo.SalesP_Customer WITH (NOLOCK) WHERE SoldCode = 43064
			*	cSQL = cSQL+" AND SalesP = '"+cSalesP+"'"
			*	cSQL = cSQL+" UNION "
				cSQL = cSQL+" SELECT 'NoNoise' AS [Type], COUNT(*) AS CNT, '"+cSalesP+"' AS Sp FROM dbo.SalesP_Customer WITH(NOLOCK) WHERE NoNoiseName = '"+cNoNoiseName+"'"
				cSQL = cSQL+" AND SalesP = '"+cSalesP+"'"
				cSQL = cSQL+" UNION "
				cSQL = cSQL+" SELECT 'Company' AS [Type], COUNT(*) AS CNT, '"+cSalesP+"' AS Sp FROM dbo.SalesP_Customer WITH(NOLOCK) WHERE Customer = '"+cCustomer+"'"
				cSQL = cSQL+" AND SalesP = '"+cSalesP+"'"
				cSQL = cSQL+" UNION "
				cSQL = cSQL+" SELECT 'Cust ID' AS [Type], COUNT(*) AS CNT, '*' AS Sp FROM dbo.SalesP_Customer WITH(NOLOCK) WHERE CustID = '"+cCustID+"'"
				cSQL = cSQL+" AND SalesP = '"+cSalesP+"'"
		
				cSQL = cSQL+" ORDER BY [Type], Sp"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSalesP_Customer' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSalesP_Customer' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesP_Customer")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesP_Customer")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSalesP_Customer')
				ENDIF
		
				IF USED('tmpSalesP_Customer')
					ThisFormSet.frmSalesP_Customer.grdSPC.RecordSource = 'tmpSalesP_Customer'
					
				ELSE
					ThisFormSet.frmSalesP_Customer.Visible = .F.
				ENDIF
			ENDIF
		*ENDIF
	ENDPROC

