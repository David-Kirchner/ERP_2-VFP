	PROCEDURE startingstocksave
		*ThisFormSet.StartingStockSave()
		
		PRIVATE cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
		cssAlloy	= PrepareSQLtxt(ThisFormset.frmStartingStock.ssALLOY1.Value,'Alloy',12)
		cssForm		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbForm.Value,'Form',2)
		cssCC		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbCC.Value,'CC',1)
		cssCL		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbCL.Value,'CL',1)
		nssPieces	= PrepareSQLnum(ThisFormset.frmStartingStock.ssPieces1.Value,'Pieces',9,0)
		nssThck		= PrepareSQLnum(ThisFormset.frmStartingStock.ssThck1.Value,'Thck',10,4)
		nssSz2		= PrepareSQLnum(ThisFormset.frmStartingStock.ssSZ21.Value,'Sz2',9,3)
		nssSz3		= PrepareSQLnum(ThisFormset.frmStartingStock.ssSZ31.Value,'Sz3',9,3)
		nssWeight	= PrepareSQLnum(ThisFormset.frmStartingStock.ssWeight1.Value,'Weight',8,1)
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpCountStartingStock')
			USE IN tmpCountStartingStock
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.StartingStock WITH(NOLOCK) "
		cSQL = cSQL + " WHERE AllQuotes_ID = "+ALLTRIM(STR(Quotes.ID))
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpCountStartingStock' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpCountStartingStock' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCountStartingStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCountStartingStock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpCountStartingStock' )
		ELSE
		
			IF USED('tmpCountStartingStock')
				IF tmpCountStartingStock.CNTD = 1
					IF NOT EMPTY(cssAlloy)
						*UPDATE
						cSQL = "UPDATE dbo.StartingStock SET "
						cSQL = cSQL + " Alloy='"+cssAlloy+"'"
						cSQL = cSQL + ",Form='"+cssForm+"'"
						cSQL = cSQL + ",CC='"+cssCC+"'"
						cSQL = cSQL + ",CL='"+cssCL+"'"
						cSQL = cSQL + ",Pieces="+STR(nssPieces,10,0)
						cSQL = cSQL + ",Thck="+STR(nssThck,9,4)
						cSQL = cSQL + ",Sz2="+STR(nssSz2,9,3)
						cSQL = cSQL + ",Sz3="+STR(nssSz3,9,3)
						cSQL = cSQL + ",Weight="+STR(nssWeight,8,1)
						cSQL = cSQL + ",InqNumP='"+Quotes.InqNumP+"'"
						cSQL = cSQL + " WHERE AllQuotes_ID = "+ALLTRIM(STR(Quotes.ID))
		
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cSQL, gnConnHandle, nSQLEXEC )
						ENDIF
					ELSE
						*Alloy is blank, Remove!
						cSQL = "DELETE FROM dbo.StartingStock "
						cSQL = cSQL + " WHERE AllQuotes_ID = "+ALLTRIM(STR(Quotes.ID))
		
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cSQL, gnConnHandle, nSQLEXEC )
						ENDIF				
						
						SELECT Quotes
						REPLACE Quotes.StartStock WITH .F.
						ThisFormset.QUOTES.lblStartingStock.BackColor = RGB(192,192,192)
						
						PRIVATE cUpdate
						cUpdate = "UPDATE dbo.AllQuotes SET "
						cUpdate = cUpdate + "StartStock="+IIF(Quotes.StartStock,"1","0")+""
						cUpdate = cUpdate + " WHERE ID = " + ALLTRIM(STR(Quotes.ID))
						
						nSQLEXEC = SQLEXEC(gnConnHandle,cUpdate)
						
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
						ENDIF
					ENDIF
				ELSE
				
					IF NOT EMPTY(cssAlloy)
						*INSERT
						cSQL = "INSERT INTO dbo.StartingStock "
						cSQL = cSQL + "(Alloy,Form,CC,CL,Pieces,Thck,Sz2,Sz3,Weight,InqNumP,AllQuotes_ID ) VALUES ("
						cSQL = cSQL + "'"+cssAlloy+"'"
						cSQL = cSQL + ",'"+cssForm+"'"
						cSQL = cSQL + ",'"+cssCC+"'"
						cSQL = cSQL + ",'"+cssCL+"'"
						cSQL = cSQL + ","+STR(nssPieces,10,0)
						cSQL = cSQL + ","+STR(nssThck,9,4)
						cSQL = cSQL + ","+STR(nssSz2,9,3)
						cSQL = cSQL + ","+STR(nssSz3,9,3)
						cSQL = cSQL + ","+STR(nssWeight,8,1)
						cSQL = cSQL + ",'"+Quotes.InqNumP+"'"
						cSQL = cSQL + ","+STR(Quotes.ID)+")"
		
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cSQL, gnConnHandle, nSQLEXEC )
						ENDIF			
					ELSE
						*Do not Insert a blank
					ENDIF
				ENDIF
				
				USE IN tmpCountStartingStock	
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE stocklst_sum_reload		&& Reload Contents
		PARAMETERS P
		*ThisFormSet.StockLst_Sum_Reload()
		
		IF TYPE('p') = 'C'
			IF p = "+"
				ThisFormSet.iAdjustStockLstSum = ThisFormSet.iAdjustStockLstSum + 1
			ENDIF
			IF p = "-"
				ThisFormSet.iAdjustStockLstSum = ThisFormSet.iAdjustStockLstSum - 1
			ENDIF
		ELSE
			p = ""
			ThisFormSet.iAdjustStockLstSum = 0
		ENDIF
		
		IF USED('tmpStockLstSum')
			USE IN tmpStockLstSum
		ENDIF
		ThisFormset.frmStockLst_Sum.grdStockLstSum.RecordSource = ''
		
		ThisFormset.frmStockLst_Sum.txtAlloy.Value = QUOTES.ALLOY
		ThisFormset.frmStockLst_Sum.txtForm.Value = QUOTES.Form
		IF p != "NewForm"
			ThisFormset.frmStockLst_Sum.cmbForm.Value = QUOTES.Form
		ENDIF
		IF p != "NewCC"
			ThisFormset.frmStockLst_Sum.cmbCC.Value = QUOTES.CC
		ENDIF
		IF p != "NewCL"
			ThisFormset.frmStockLst_Sum.cmbCL.Value = QUOTES.CL
		ENDIF
		ThisFormset.frmStockLst_Sum.txtWeight.Value = QUOTES.Weight
		ThisFormset.frmStockLst_Sum.txtPieces.Value = QUOTES.Pieces
		ThisFormset.frmStockLst_Sum.txtThck.Value = QUOTES.THCK
		ThisFormset.frmStockLst_Sum.txtSz2.Value = QUOTES.SZ2
		ThisFormset.frmStockLst_Sum.txtSz3.Value = QUOTES.SZ3
		*ThisFormset.frmStockLst_Sum.lblcTHCK.Visible = .F.
		
		PRIVATE cAlloy, cForm, nThck, nSz2, nSz3, cCC, cCL
		cAlloy	= PrepareSQLtxt(ThisFormset.frmStockLst_Sum.txtAlloy.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisFormset.frmStockLst_Sum.cmbForm.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisFormset.frmStockLst_Sum.txtThck.Value,'Thck',10,4)
		nSz2	= PrepareSQLnum(ThisFormset.frmStockLst_Sum.txtSz2.Value,'Sz2',9,3)
		nSz3	= PrepareSQLnum(ThisFormset.frmStockLst_Sum.txtSz3.Value,'Sz2',9,3)
		cCC		= PrepareSQLtxt(ThisFormset.frmStockLst_Sum.cmbCC.Value,'CC',1)
		cCL		= PrepareSQLtxt(ThisFormset.frmStockLst_Sum.cmbCL.Value,'CL',1)
		
		*cCC		= '1'
		*IF cAlloy = "NI50 HS" OR cAlloy = "NI60 HS"
		*	cCC = '2'
		*ENDIF
		
		PRIVATE pcurdbf 
		pcurdbf = ALIAS()
		
		IF ThisFormSet.iAdjustStockLstSum > 0
			IF nThck < 1
				nThck = nThck + (ThisFormSet.iAdjustStockLstSum * .25)
			ELSE
				nThck = nThck + (ThisFormSet.iAdjustStockLstSum * .5)
			ENDIF
			ThisFormset.frmStockLst_Sum.lblcTHCK.Caption = STR( nTHCK ,5,3)
		*	ThisFormset.frmStockLst_Sum.lblcTHCK.Visible = .T.
		ENDIF
		IF ThisFormSet.iAdjustStockLstSum < 0
			IF nThck < 1
				nThck = nThck + (ThisFormSet.iAdjustStockLstSum * .25)
			ELSE
				nThck = nThck + (ThisFormSet.iAdjustStockLstSum * .5)
			ENDIF
			IF nThck < 0
				MESSAGEBOX("Thickness set to .000 Inch"+CHR(13)+"All will be seen!",0+64,"Too thin")
				nThck = .000
			ENDIF
			ThisFormset.frmStockLst_Sum.lblcTHCK.Caption = STR( nTHCK ,5,3)
		*	ThisFormset.frmStockLst_Sum.lblcTHCK.Visible = .T.
		ENDIF
		
		ThisFormset.frmStockLst_Sum.lblcTHCK.Caption = STR( nTHCK ,5,3)
		PRIVATE cSQLp,nSQLEXEC 
		cSQLp = "EXEC dbo.p_Show_StockLst_sumCL "
		cSQLp = cSQLp + "@cAlloy = '"+cAlloy+"',"
		cSQLp = cSQLp + "@cForm = '"+cForm+"',"
		cSQLp = cSQLp + "@cCC = '"+cCC+"',"
		cSQLp = cSQLp + "@cCL = '"+cCL+"',"
		cSQLp = cSQLp + "@nThickness = "+STR(nThck,9,4)+","
		cSQLp = cSQLp + "@nSize2 = "+STR(nSz2,18,4)+","
		cSQLp = cSQLp + "@nSize3 = "+STR(nSz3,18,4)+""
		
		*!*	@cAlloy char(12),
		*!*	@cForm CHAR(2),
		*!*	@cCC CHAR(1),
		*!*	@nThickness DECIMAL(9,4),
		*!*	@nSize2 DECIMAL(18,4),
		*!*	@nSize3 DECIMAL(18,4)
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQLp, 'tmpStockLstSum')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQLp, 'tmpStockLstSum')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQLp, "tmpStockLstSum")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLp, "tmpStockLstSum")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQLp,gnConnHandle,nSQLEXEC, 'tmpStockLstSum')
		ENDIF
		
		IF USED('tmpStockLstSum')
			ThisFormset.frmStockLst_Sum.grdStockLstSum.RecordSource = 'tmpStockLstSum'
			ThisFormset.frmStockLst_Sum.grdStockLstSum.column1.Width = 51
			ThisFormset.frmStockLst_Sum.grdStockLstSum.column2.Width = 41
			ThisFormset.frmStockLst_Sum.grdStockLstSum.column3.Width = 32
			*ThisFormset.frmStockLst_Sum.grdStockLstSum.column3.ToolTipText = 'Different Heats'
			ThisFormset.frmStockLst_Sum.grdStockLstSum.column4.Width = 55
			*ThisFormset.frmStockLst_Sum.grdStockLstSum.column4.ToolTipText = 'Lbs of Stock'
			ThisFormset.frmStockLst_Sum.grdStockLstSum.column5.Width = 55
			*ThisFormset.frmStockLst_Sum.grdStockLstSum.column5.ToolTipText = 'Lbs from SO'
			ThisFormset.frmStockLst_Sum.grdStockLstSum.column6.Width = 55
			*ThisFormset.frmStockLst_Sum.grdStockLstSum.column6.ToolTipText = 'Lbs on PO'
			ThisFormset.frmStockLst_Sum.grdStockLstSum.column7.Width = 55
			*ThisFormset.frmStockLst_Sum.grdStockLstSum.column7.ToolTipText = 'All Quotes in last 30 days'
			ThisFormset.frmStockLst_Sum.grdStockLstSum.column7.Header1.Caption='Quote30'
			
		ENDIF
		ThisFormset.frmStockLst_Sum.grdStockLstSum.Refresh
		
		IF NOT EMPTY(pcurdbf) AND USED(pcurdbf)
			SELECT (pcurdbf)
		ENDIF
	ENDPROC

	PROCEDURE supplierquotecheck		&& SupplierQuoteCheck
		PRIVATE cSupplier,cContact,cNotes,nUnitPrice,nQuantity,nPcPrice,dDueDate,dSaveDate
		cSupplier	= PrepareSQLtxt(ThisFormset.frmRFQ.txtSupplier.Value,'Supplier',30)
		*cContact	= PrepareSQLtxt(ThisFormset.frmRFQ.txtContact.Value,'Contact',30)
		*cNotes		= PrepareSQLtxt(ThisFormset.frmRFQ.txtNotes.Value,'Notes',30)
		nUnitPrice	= PrepareSQLnum(ThisFormset.frmRFQ.txtUnitPrice.Value,'UnitPrice',-5)
		nQuantity	= PrepareSQLnum(ThisFormset.frmRFQ.txtQuantity.Value,'Quantity',9,1)
		nPcPrice	= PrepareSQLnum(ThisFormset.frmRFQ.txtPcPrice.Value,'PcPrice',-5)
		dDueDate	= PrepareSQLdate(ThisFormset.frmRFQ.txtDueDate.Value,'DueDate')
		
		IF EMPTY(cSupplier)
			MESSAGEBOX("No Supplier Entered.",0+16,"Cannot save.")
			RETURN .F.
		ENDIF
		*!*	IF EMPTY(cContact)
		*!*		MESSAGEBOX("No contact Entered",0+16,"Cannot save.")
		*!*		RETURN .F.
		*!*	ENDIF
		IF nUnitPrice <= 0 AND nPcPrice <= 0 
			MESSAGEBOX("No UnitPrice OR PC Price entered.",0+16,"Cannot save.")
			RETURN .F.
		ENDIF
		*IF nUnitPrice <= 0
		*	MESSAGEBOX("No UnitPrice entered.",0+16,"Cannot save.")
		*	RETURN .F.
		*ENDIF
		IF nQuantity <= 0 
			MESSAGEBOX("No Quantity entered.",0+16,"Cannot save.")
			RETURN .F.
		ENDIF
		IF dDueDate != CtoD("  /  /  ")
			IF dDueDate > DATE() + 3650  OR dDueDate < DATE() - 3650
				MESSAGEBOX("DueDate out of range, Reset to today.",0+64,"Check before saveing.")
				ThisFormset.frmRFQ.txtDueDate.Value = DATE()
				RETURN .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE tenminutereport		&& Runs every 10 Minutes
		*ThisFormSet.TenMinuteReport()
		*Check to see if already ran in less than 10 minutes
		
		RETURN .T.
		
		IF AppSetup_10Min(gnConnHandle)
		*	ThisFormSet.ReportTenMin()
			IF LEN(ThisFormset.QUOTES.Userinfo1.SalesP) > 0
				ReportTenMin(ThisFormset.QUOTES.Userinfo1.SalesP, gnConnHandle)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE tmpfieldkeypress
		PARAMETERS nKeyCode, nShiftAltCtrl
		
		Private lnReturnVal
		IF INLIST(nKeyCode, 9, 13, 10, 24, 145, 160 )
			*Down Arrow 24 50 145 160
			*TAB 9
			*ENTER  13 13 10 
			*RIGHT ARROW 4 54 2 
			*Key that makes you go to next object
			
			lnReturnVal = ThisFormSet.ConvertThis(This.Value,)
			ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"F"
			DO CASE
				CASE ThisFormSet.MetricGotFocus = "THCK1"
					ThisForm.THCK1.Value = lnReturnVal
					ThisFormSet.CalcInv(2)
				CASE ThisFormSet.MetricGotFocus = "SZ21"
					ThisForm.SZ21.Value = lnReturnVal
					ThisFormSet.CalcInv(2)
				CASE ThisFormSet.MetricGotFocus = "SZ31"
					ThisForm.SZ31.Value = lnReturnVal
					ThisFormSet.CalcInv(3)
					
				CASE ThisFormSet.MetricGotFocus = "WEIGHT1"
					ThisForm.WEIGHT1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "P_LB1"
					ThisForm.P_LB1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "P_PC1"
					ThisForm.P_PC1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "P_FT1"
					ThisForm.P_FT1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "CUTS1"
					ThisForm.CUTS1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "OtherP1"
					ThisForm.OtherP1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "LOTP1"
					ThisForm.LOTP1.Value = lnReturnVal
					
				CASE ThisFormSet.MetricGotFocus = "ssTHCK1"
					ThisFormset.frmStartingStock.ssTHCK1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "ssSZ21"
					ThisFormset.frmStartingStock.ssSZ21.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "ssSZ31"
					ThisFormset.frmStartingStock.ssSZ31.Value = lnReturnVal
			ENDCASE
			ThisFormset.QUOTES.tempfield.Value = ''
		
		*ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast
		
		ENDIF
		
		IF INLIST(nKeyCode, 15, 5, 141, 152)
			ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"B"
			*Keys that make you goto PREV object
			*TAB Shift 15
			*left 19 52 26 
			*up 5 56 141 152 
			lnReturnVal = ThisFormSet.ConvertThis(This.Value)	
			
			DO CASE
				CASE ThisFormSet.MetricGotFocus = "THCK1"
					ThisForm.THCK1.Value = lnReturnVal
					ThisForm.THCK1.refresh()
				CASE ThisFormSet.MetricGotFocus = "SZ21"
					ThisForm.SZ21.Value = lnReturnVal
					ThisForm.SZ21.refresh()
				CASE ThisFormSet.MetricGotFocus = "SZ31"
					ThisForm.SZ31.Value = lnReturnVal
					ThisForm.SZ31.refresh()
				CASE ThisFormSet.MetricGotFocus = "WEIGHT1"
					ThisForm.WEIGHT1.Value = lnReturnVal
					ThisForm.WEIGHT1.refresh()
				CASE ThisFormSet.MetricGotFocus = "P_LB1"
					ThisForm.P_LB1.Value = lnReturnVal
					ThisForm.P_LB1.refresh()
				CASE ThisFormSet.MetricGotFocus = "P_PC1"
					ThisForm.P_PC1.Value = lnReturnVal
					ThisForm.P_PC1.refresh()
				CASE ThisFormSet.MetricGotFocus = "P_FT1"
					ThisForm.P_FT1.Value = lnReturnVal
					ThisForm.P_FT1.refresh()
				CASE ThisFormSet.MetricGotFocus = "CUTS1"
					ThisForm.CUTS1.Value = lnReturnVal
					ThisForm.CUTS1.refresh()
				CASE ThisFormSet.MetricGotFocus = "OtherP1"
					ThisForm.OtherP1.Value = lnReturnVal
					ThisForm.OtherP1.refresh()
				CASE ThisFormSet.MetricGotFocus = "LOTP1"
					ThisForm.LOTP1.Value = lnReturnVal
					ThisForm.LOTP1.refresh()
					
				CASE ThisFormSet.MetricGotFocus = "ssTHCK1"
					ThisFormset.frmStartingStock.ssTHCK1.Value = lnReturnVal
					ThisFormset.frmStartingStock.ssTHCK1.refresh()
				CASE ThisFormSet.MetricGotFocus = "ssSZ21"
					ThisFormset.frmStartingStock.ssSZ21.Value = lnReturnVal
					ThisFormset.frmStartingStock.ssSZ21.refresh()
				CASE ThisFormSet.MetricGotFocus = "ssSZ31"
					ThisFormset.frmStartingStock.ssSZ31.Value = lnReturnVal
					ThisFormset.frmStartingStock.ssSZ31.refresh()
		
			ENDCASE
			ThisFormset.QUOTES.tempfield.Value = ''
			
		*ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast	
			
		ENDIF
		
	ENDPROC

	PROCEDURE totalitem		&& RETURNS Item Total
		*ThisFormSet.TotalItem()
		PRIVATE m.lblTotal
		
		m.lblTotal = 0
		DO CASE
			CASE Quotes.P_LB > 0 AND (Quotes.Weight + Quotes.Cweight > 0 )
				m.lblTotal=	Quotes.P_LB * (IIF(Quotes.weight > 0,Quotes.weight,Quotes.Cweight))  
			CASE Quotes.P_PC > 0 AND Quotes.Pieces > 0
				m.lblTotal= Quotes.P_PC * Quotes.Pieces
			CASE Quotes.P_FT > 0 AND (Quotes.SZ2+Quotes.SZ3 > 0)
				m.lblTotal= Quotes.P_FT / 12 * IIF(Quotes.SZ3 > 0,Quotes.SZ3,Quotes.SZ2) * IIF(Quotes.Pieces > 0,Quotes.Pieces,1)
			CASE Quotes.LOTP > 0
				m.lblTotal= Quotes.LOTP
		ENDCASE
		
		
		IF Quotes.CUTS > 0
			m.lblTotal = m.lblTotal + Quotes.CUTS 
		ENDIF
		
		IF Quotes.OtherP > 0
			m.lblTotal = m.lblTotal + Quotes.OtherP
		ENDIF
		
		RETURN m.lblTotal
	ENDPROC

	PROCEDURE warnsalesorder
		*ThisFormSet.WarnSalesOrder()
		
		PRIVATE nSalesNum
		nSalesNum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		
		IF nSalesNum > 0
		
			PRIVATE cSQL, nSQLEXEC 
			IF USED("tmpSALES_No2")
				USE IN tmpSALES_No2
			ENDIF
			
			cSQL = "SELECT PrintedSO,ShopRecv,pSoldAddr,pShipAddr"
			cSQL = cSQL + ",cncld,cmplt"
			cSQL = cSQL + " FROM dbo.Sales_No WITH(NOLOCK) WHERE "
			cSQL = cSQL + " SalesNum = "+ALLTRIM(STR(nSalesNum))
		
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSALES_No2' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSALES_No2' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSALES_No2")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSALES_No2")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSALES_No2')
			ENDIF
		
			IF USED('tmpSALES_No2')
				IF RECCOUNT('tmpSALES_No2') > 0
					
					PRIVATE npSoldAddr 
					npSoldAddr = PrepareSQLnum(tmpSALES_No2.pSoldAddr,'pSoldaddr',-3)
					IF npSoldAddr = 0
						WAIT WINDOW "'SoldTo Address' has not been saved to Sales Order!" NOWAIT
						*MESSAGEBOX("'SoldTo Address' has not been saved to Sales Order!",48,"Incomplete, add SoldTo Address to SO.")			
					ENDIF
		
				
					IF NOT tmpSALES_No2.PrintedSO
						IF NOT PrepareSQLlogic(tmpSALES_No2.cncld,'cncld',.F.) 
							IF NOT PrepareSQLlogic(tmpSALES_No2.cmplt,'cmplt',.F.)
								WAIT WINDOW "Sales Order not PRINTED !" NOWAIT
							ENDIF
						ENDIF
					ELSE
						IF NOT PrepareSQLlogic(tmpSALES_No2.ShopRecv,'ShopRecv',.F.)
							IF NOT PrepareSQLlogic(tmpSALES_No2.cncld,'cncld',.F.) 
								IF NOT PrepareSQLlogic(tmpSALES_No2.cmplt,'cmplt',.F.)
									WAIT WINDOW "Sales Order has NOT been received by Shop!" NOWAIT
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				USE IN tmpSALES_No2
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE waterjetcut
		PARAMETERS cWHAT
		*ThisFormSet.WaterJetCut()
		*Duplicate code in PlasmaCut
		
		PRIVATE lDefault
		lDefault = .F.
		IF VARTYPE(cWHAT) = "C"
			IF cWHAT = "DEFAULT"
				lDefault = .T.
			ENDIF
		ENDIF
		
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE cAlloy,cCC,cCL,cForm,nPieces,nThick,nSz2,nSz3
		
		cAlloy	= PrepareSQLtxt(ALLTRIM(Quotes.alloy),'Alloy',12)
		cCC		= PrepareSQLtxt(Quotes.CC,'CC',1)
		cCL		= PrepareSQLtxt(Quotes.CL,'CL',1)
		cForm	= PrepareSQLtxt(Quotes.Form,'Form',2)
		
		nPieces = PrepareSQLnum(Quotes.pieces,'Pieces',10,0)
		nThick	= PrepareSQLnum(Quotes.thck,'Thck',10,4)
		nSz2	= PrepareSQLnum(Quotes.Sz2,'sz2',9,3)
		nSz3	= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		
		IF EMPTY('cAlloy')
			MESSAGEBOX("Alloy has not been entered!",0+64,"Enter Alloy!")
			RETURN .F.
		ENDIF
		IF EMPTY('cForm')
			MESSAGEBOX("Form has not been entered!",0+64,"Enter Form!")
			RETURN .F.
		ENDIF
		
		IF NOT ( cForm = "11" OR cForm = "40" OR cForm = "80" )
			MESSAGEBOX("Form must be Flat!",0+64,"Wrong Form!")
			RETURN .F.
		ENDIF
		
		IF cForm = "90"
			MESSAGEBOX( "Waterjet Cutting Price Table does not calculate Machined part.",48,"No Cut Price" )
			RETURN .F.
		ENDIF
		
		*************
		ThisFormSet.frmWaterJet.Caption = "Waterjet Cutting"
		ThisFormSet.frmWaterJet.lblKerf.Caption = [Kerf=.045"]  &&keep Kerf= to Parse
		ThisFormSet.frmWaterJet.pfQuality.pg80.Enabled = .T.
		ThisFormSet.frmWaterJet.pfQuality.pg60.Enabled = .T.
		ThisFormSet.frmWaterJet.pfQuality.pg40.Enabled = .T.
		ThisFormSet.frmWaterJet.pfQuality.pg20.Enabled = .T.
		**************
			
		IF USED('tmpWaterJet')
			USE IN tmpWaterJet
		ENDIF
		SELECT 0
		
		PRIVATE lOK
		lOK = getWaterJet(nThick,gnConnHandle)  &&Opens 'tmpWaterJet' table
		
		*ThisForm.txtKerfDollar.Value = ThisFormSet.CalcKerfDollar()
		
		ThisFormSet.BlankBackColorCutting()
		
		IF USED('tmpWaterJet')
			ThisFormSet.frmWaterJet.Visible = .T.
			ThisFormSet.frmWaterJet.AlwaysOnTop = .T.
			
			ThisFormSet.frmWaterJet.txtThick.Value = nThick
			
			*******************************************************************************
			*100 Percent
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtP_Inch.Value		= tmpWaterJet.Inch100
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtInch_Min.Value	= 1/tmpWaterJet.Min100
			
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutWidthDollar.Value 	= PrepareSQLnum(tmpWaterJet.Inch100  * nSz2 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutWidthMin.Value 	= 1/tmpWaterJet.Min100 * nSz2
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLengthDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch100  * nSz3 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLengthMin.Value 	= 1/tmpWaterJet.Min100 * nSz3
		
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLWDollar.Value 	= PrepareSQLnum(tmpWaterJet.Inch100  * (nSz2+nSz3) ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLWMin.Value 		= 1/tmpWaterJet.Min100 * (nSz2+nSz3)
		
		
			ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch100  * (nSz2+nSz2+nSz3+nSz3)  ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedMin.Value		= (1/tmpWaterJet.Min100 * (nSz2+nSz2+nSz3+nSz3) ) 
			
			IF nPieces > 0
				ThisFormSet.frmWaterJet.pfQuality.pg100.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombMin.Visible = .T.
		
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombDollar.Value	= PrepareSQLnum((tmpWaterJet.Inch100  * (nSz2+nSz3+nSz3) * nPieces ) + ( tmpWaterJet.Inch100 * nSz2 ) ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombMin.Value		= (1/tmpWaterJet.Min100 * (nSz2+nSz3+nSz3) * nPieces ) + ( 1/tmpWaterJet.Min100 * nSz2 )
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg100.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombMin.Visible = .F.
			ENDIF
			
			IF cForm = "80"
				ThisFormSet.frmWaterJet.pfQuality.pg100.lblDisk.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskMin.Visible = .T.
				
				ThisFormSet.frmWaterJet.pfQuality.pg100.lblOneCutLength.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLengthDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLengthMin.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.lblOneCutLengthWidth.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLWDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLWMin.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch100  * (nSz2+nSz2+nSz2+nSz2)  ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedMin.Value		= (1/tmpWaterJet.Min100 * (nSz2+nSz2+nSz2+nSz2) ) 
				ThisFormSet.frmWaterJet.pfQuality.pg100.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombMin.Visible = .F.
		
				IF nSz3 > 0
					ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch100  * ((3.14 * nSz2) + (3.14 * nSz3)) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskMin.Value	= 1/tmpWaterJet.Min100 * ((3.14 * nSz2) + (3.14 * nSz3))
				ELSE
					ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch100  * (3.14 * nSz2) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskMin.Value	= 1/tmpWaterJet.Min100 * (3.14 * nSz2)
				ENDIF
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg100.lblDisk.Visible 	= .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtDiskMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.lblOneCutWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutWidthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutWidthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.lblOneCutLength.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLengthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLengthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.lblOneCutLengthWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLWDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txtOneCutLWMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg100.txt4SidedCombMin.Visible = .T.
			ENDIF
		
			*******************************************************************************
			*80 Percent
			ThisFormSet.frmWaterJet.pfQuality.pg80.txtP_Inch.Value 		= tmpWaterJet.Inch80
			ThisFormSet.frmWaterJet.pfQuality.pg80.txtInch_Min.Value	= 1/tmpWaterJet.Min80
				
			ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutWidthDollar.Value 	= PrepareSQLnum(tmpWaterJet.Inch80 * nSz2 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutWidthMin.Value 		= 1/tmpWaterJet.Min80 * nSz2
			ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLengthDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch80 * nSz3  ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLengthMin.Value 	= 1/tmpWaterJet.Min80 * nSz3
		
			ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLWDollar.Value 		= PrepareSQLnum(tmpWaterJet.Inch80 * (nSz2+nSz3) ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLWMin.Value 		= 1/tmpWaterJet.Min80 * (nSz2+nSz3)
		
			ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch80 * (nSz2+nSz2+nSz3+nSz3)  ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedMin.Value		= 1/tmpWaterJet.Min80 * (nSz2+nSz2+nSz3+nSz3) 
			
			IF nPieces > 0
				ThisFormSet.frmWaterJet.pfQuality.pg80.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombMin.Visible = .T.
		
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombDollar.Value	= PrepareSQLnum((tmpWaterJet.Inch80 * (nSz2+nSz3+nSz3) * nPieces ) + ( tmpWaterJet.Inch80 * nSz2 ) ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombMin.Value		= (1/tmpWaterJet.Min80 * (nSz2+nSz3+nSz3) * nPieces ) + ( 1/tmpWaterJet.Min80 * nSz2 )
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg80.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombMin.Visible = .F.
			ENDIF
			
			IF cForm = "80"
				ThisFormSet.frmWaterJet.pfQuality.pg80.lblDisk.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtDiskDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtDiskMin.Visible = .T.
				
				*Remove 1 cut along Width
				ThisFormSet.frmWaterJet.pfQuality.pg80.lblOneCutWidth.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutWidthDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutWidthMin.Visible = .F.
				*Remove 1 cut along Length
				ThisFormSet.frmWaterJet.pfQuality.pg80.lblOneCutLength.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLengthDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLengthMin.Visible = .F.
				*Remove 1 cut along WL
				ThisFormSet.frmWaterJet.pfQuality.pg80.lblOneCutLengthWidth.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLWDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLWMin.Visible = .F.
				*Redo 4 Side / Cut to show a Sqaure Cut
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch80  * (nSz2+nSz2+nSz2+nSz2)  ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedMin.Value		= (1/tmpWaterJet.Min80 * (nSz2+nSz2+nSz2+nSz2) ) 
				*Remove 4 Sided Combined			
				ThisFormSet.frmWaterJet.pfQuality.pg80.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombMin.Visible = .F.
		
				IF nSz3 > 0
					ThisFormSet.frmWaterJet.pfQuality.pg80.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch80 *  ((3.14 * nSz2) + (3.14 * nSz3)) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg80.txtDiskMin.Value		= 1/tmpWaterJet.Min80 * ((3.14 * nSz2) + (3.14 * nSz3))
				ELSE
					ThisFormSet.frmWaterJet.pfQuality.pg80.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch80 *  (3.14 * nSz2) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg80.txtDiskMin.Value		= 1/tmpWaterJet.Min80 * (3.14 * nSz2)
				ENDIF
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg80.lblDisk.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtDiskDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtDiskMin.Visible = .F.
		
				ThisFormSet.frmWaterJet.pfQuality.pg80.lblOneCutWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutWidthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutWidthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.lblOneCutLength.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLengthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLengthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.lblOneCutLengthWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLWDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txtOneCutLWMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg80.txt4SidedCombMin.Visible = .T.
			ENDIF
		
			*******************************************************************************	
			*60 Percent
			ThisFormSet.frmWaterJet.pfQuality.pg60.txtP_Inch.Value 		= tmpWaterJet.Inch60
			ThisFormSet.frmWaterJet.pfQuality.pg60.txtInch_Min.Value 	= 1/tmpWaterJet.Min60
				
			ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutWidthDollar.Value 	= PrepareSQLnum(tmpWaterJet.Inch60 * nSz2 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutWidthMin.Value 		= 1/tmpWaterJet.Min60 * nSz2
			ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLengthDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch60 * nSz3 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLengthMin.Value 	= 1/tmpWaterJet.Min60 * nSz3
		
			ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLWDollar.Value 		= PrepareSQLnum(tmpWaterJet.Inch60 * (nSz2+nSz3) ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLWMin.Value 		= 1/tmpWaterJet.Min60 * (nSz2+nSz3)
		
			ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch60 * (nSz2+nSz2+nSz3+nSz3) ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedMin.Value		= 1/tmpWaterJet.Min60 * (nSz2+nSz2+nSz3+nSz3) 
			
			IF nPieces > 0
				ThisFormSet.frmWaterJet.pfQuality.pg60.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombMin.Visible = .T.
		
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombDollar.Value	= PrepareSQLnum((tmpWaterJet.Inch60 * (nSz2+nSz3+nSz3) * nPieces ) + ( tmpWaterJet.Inch60 * nSz2 ) ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombMin.Value		= (1/tmpWaterJet.Min60 * (nSz2+nSz3+nSz3) * nPieces ) + ( 1/tmpWaterJet.Min60 * nSz2 )
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg60.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombMin.Visible = .F.
			ENDIF
			
			IF cForm = "80"
				ThisFormSet.frmWaterJet.pfQuality.pg60.lblDisk.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtDiskDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtDiskMin.Visible = .T.
				
				*Remove 1 cut along Width
				ThisFormSet.frmWaterJet.pfQuality.pg60.lblOneCutWidth.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutWidthDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutWidthMin.Visible = .F.
				*Remove 1 cut along Length
				ThisFormSet.frmWaterJet.pfQuality.pg60.lblOneCutLength.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLengthDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLengthMin.Visible = .F.
				*Remove 1 cut along WL
				ThisFormSet.frmWaterJet.pfQuality.pg60.lblOneCutLengthWidth.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLWDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLWMin.Visible = .F.
				*Redo 4 Side / Cut to show a Sqaure Cut
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch60  * (nSz2+nSz2+nSz2+nSz2)  ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedMin.Value		= (1/tmpWaterJet.Min60 * (nSz2+nSz2+nSz2+nSz2) ) 
				*Remove 4 Sided Combined		
				ThisFormSet.frmWaterJet.pfQuality.pg60.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombMin.Visible = .F.
		
				IF nSz3 > 0
					ThisFormSet.frmWaterJet.pfQuality.pg60.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch60 *  ((3.14 * nSz2) + (3.14 * nSz3)) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg60.txtDiskMin.Value		= 1/tmpWaterJet.Min60 * ((3.14 * nSz2) + (3.14 * nSz3))
				ELSE
					ThisFormSet.frmWaterJet.pfQuality.pg60.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch60 *  (3.14 * nSz2) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg60.txtDiskMin.Value		= 1/tmpWaterJet.Min60 * (3.14 * nSz2)
				ENDIF
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg60.lblDisk.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtDiskDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtDiskMin.Visible = .F.
			
				ThisFormSet.frmWaterJet.pfQuality.pg60.lblOneCutWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutWidthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutWidthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.lblOneCutLength.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLengthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLengthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.lblOneCutLengthWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLWDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txtOneCutLWMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg60.txt4SidedCombMin.Visible = .T.
			ENDIF
			
			*******************************************************************************
			*40 Percent
			ThisFormSet.frmWaterJet.pfQuality.pg40.txtP_Inch.Value 		= tmpWaterJet.Inch40
			ThisFormSet.frmWaterJet.pfQuality.pg40.txtInch_Min.Value 	= 1/tmpWaterJet.Min40
				
			ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutWidthDollar.Value 	= PrepareSQLnum(tmpWaterJet.Inch40 * nSz2 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutWidthMin.Value 		= 1/tmpWaterJet.Min40 * nSz2
			ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLengthDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch40 * nSz3 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLengthMin.Value 	= 1/tmpWaterJet.Min40 * nSz3
		
			ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLWDollar.Value 		= PrepareSQLnum(tmpWaterJet.Inch40 * (nSz2+nSz3) ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLWMin.Value 		= 1/tmpWaterJet.Min40 * (nSz2+nSz3)
		
			ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch40 * (nSz2+nSz2+nSz3+nSz3) ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedMin.Value		= 1/tmpWaterJet.Min40 * (nSz2+nSz2+nSz3+nSz3) 
			
			IF nPieces > 0
				ThisFormSet.frmWaterJet.pfQuality.pg40.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombMin.Visible = .T.
		
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombDollar.Value	= PrepareSQLnum((tmpWaterJet.Inch40 * (nSz2+nSz3+nSz3) * nPieces ) + ( tmpWaterJet.Inch40 * nSz2 ) ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombMin.Value		= (1/tmpWaterJet.Min40 * (nSz2+nSz3+nSz3) * nPieces ) + ( 1/tmpWaterJet.Min40 * nSz2 )
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg40.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombMin.Visible = .F.
			ENDIF
			
			IF cForm = "80"
				ThisFormSet.frmWaterJet.pfQuality.pg40.lblDisk.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtDiskDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtDiskMin.Visible = .T.
				
				*Remove 1 cut along Width
				ThisFormSet.frmWaterJet.pfQuality.pg40.lblOneCutWidth.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutWidthDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutWidthMin.Visible = .F.
				*Remove 1 cut along Length
				ThisFormSet.frmWaterJet.pfQuality.pg40.lblOneCutLength.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLengthDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLengthMin.Visible = .F.
				*Remove 1 cut along WL
				ThisFormSet.frmWaterJet.pfQuality.pg40.lblOneCutLengthWidth.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLWDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLWMin.Visible = .F.
				*Redo 4 Side / Cut to show a Sqaure Cut
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch40  * (nSz2+nSz2+nSz2+nSz2)  ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedMin.Value		= (1/tmpWaterJet.Min40 * (nSz2+nSz2+nSz2+nSz2) ) 
				*Remove 4 Sided Combined			
				ThisFormSet.frmWaterJet.pfQuality.pg40.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombMin.Visible = .F.
		
				IF nSz3 > 0
					ThisFormSet.frmWaterJet.pfQuality.pg40.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch40  * ((3.14 * nSz2) + (3.14 * nSz3)) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg40.txtDiskMin.Value		= 1/tmpWaterJet.Min40 * ((3.14 * nSz2) + (3.14 * nSz3))
				ELSE
					ThisFormSet.frmWaterJet.pfQuality.pg40.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch40  * (3.14 * nSz2) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg40.txtDiskMin.Value		= 1/tmpWaterJet.Min40 * (3.14 * nSz2)
				ENDIF
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg40.lblDisk.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtDiskDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtDiskMin.Visible = .F.
			
				ThisFormSet.frmWaterJet.pfQuality.pg40.lblOneCutWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutWidthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutWidthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.lblOneCutLength.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLengthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLengthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.lblOneCutLengthWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLWDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txtOneCutLWMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombMin.Visible = .T.
			ENDIF
			
			*******************************************************************************	
			*20 Percent
			ThisFormSet.frmWaterJet.pfQuality.pg20.txtP_Inch.Value 		= tmpWaterJet.Inch20
			ThisFormSet.frmWaterJet.pfQuality.pg20.txtInch_Min.Value 	= 1/tmpWaterJet.Min20
				
			ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutWidthDollar.Value 	= PrepareSQLnum(tmpWaterJet.Inch20 * nSz2 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutWidthMin.Value 		= 1/tmpWaterJet.Min20 * nSz2
			ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLengthDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch20 * nSz3 ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLengthMin.Value 	= 1/tmpWaterJet.Min20 * nSz3
		
			ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLWDollar.Value 		= PrepareSQLnum(tmpWaterJet.Inch20 * (nSz2+nSz3) ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLWMin.Value 		= 1/tmpWaterJet.Min20 * (nSz2+nSz3)
		
			ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch20 * (nSz2+nSz2+nSz3+nSz3) ,'Dollar',-5)
			ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedMin.Value		= 1/tmpWaterJet.Min20 * (nSz2+nSz2+nSz3+nSz3) 
			
			IF nPieces > 0
				ThisFormSet.frmWaterJet.pfQuality.pg20.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedCombMin.Visible = .T.
		
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedCombDollar.Value	= PrepareSQLnum((tmpWaterJet.Inch20 * (nSz2+nSz3+nSz3) * nPieces ) + ( tmpWaterJet.Inch20 * nSz2 ) ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedCombMin.Value		= (1/tmpWaterJet.Min20 * (nSz2+nSz3+nSz3) * nPieces ) + ( 1/tmpWaterJet.Min20 * nSz2 )
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg20.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedCombMin.Visible = .F.
			ENDIF
			
			IF cForm = "80"
				ThisFormSet.frmWaterJet.pfQuality.pg20.lblDisk.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtDiskDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtDiskMin.Visible = .T.
				
				*Remove 1 cut along Width
				ThisFormSet.frmWaterJet.pfQuality.pg20.lblOneCutWidth.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutWidthDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutWidthMin.Visible = .F.
				*Remove 1 cut along Length
				ThisFormSet.frmWaterJet.pfQuality.pg20.lblOneCutLength.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLengthDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLengthMin.Visible = .F.
				*Remove 1 cut along WL
				ThisFormSet.frmWaterJet.pfQuality.pg20.lblOneCutLengthWidth.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLWDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLWMin.Visible = .F.
				*Redo 4 Side / Cut to show a Sqaure Cut
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch20  * (nSz2+nSz2+nSz2+nSz2)  ,'Dollar',-5)
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedMin.Value		= (1/tmpWaterJet.Min20 * (nSz2+nSz2+nSz2+nSz2) ) 
				*Remove 4 Sided Combined			
				ThisFormSet.frmWaterJet.pfQuality.pg20.lbl4SidedCutComb.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedCombDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedCombMin.Visible = .F.
		
				IF nSz3 > 0
					ThisFormSet.frmWaterJet.pfQuality.pg20.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch20 *  ((3.14 * nSz2) + (3.14 * nSz3)) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg20.txtDiskMin.Value		= 1/tmpWaterJet.Min20 * ((3.14 * nSz2) + (3.14 * nSz3))
				ELSE
					ThisFormSet.frmWaterJet.pfQuality.pg20.txtDiskDollar.Value	= PrepareSQLnum(tmpWaterJet.Inch20 *  (3.14 * nSz2) ,'Dollar',-5)
					ThisFormSet.frmWaterJet.pfQuality.pg20.txtDiskMin.Value		= 1/tmpWaterJet.Min20 * (3.14 * nSz2)
				ENDIF
			ELSE
				ThisFormSet.frmWaterJet.pfQuality.pg20.lblDisk.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtDiskDollar.Visible = .F.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtDiskMin.Visible = .F.
			
				ThisFormSet.frmWaterJet.pfQuality.pg20.lblOneCutWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutWidthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutWidthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.lblOneCutLength.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLengthDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLengthMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.lblOneCutLengthWidth.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLWDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txtOneCutLWMin.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.lbl4SidedCutComb.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg20.txt4SidedCombDollar.Visible = .T.
				ThisFormSet.frmWaterJet.pfQuality.pg40.txt4SidedCombMin.Visible = .T.
			ENDIF
			
			
			ThisFormSet.frmWaterJet.AlwaysOnTop = .F.
			ThisFormset.frmWaterJet.pfQuality.ActivePage = 2
			USE IN tmpWaterJet
			
			**********************************************************************************************************************
			*Hi Lite stored selection
			PRIVATE m.cCutOptions,m.cCutOptions1,nCutOption ,m.cCutOptionsSpeed,m.cCutOptionsTol
			m.cCutOptions = PrepareSQLtxt(Quotes.CutOptions,'CutOptions',75,.T.)
			
			*Waterjet 4 side cut $698.14/Pc @40% +0.016" -0
			IF UPPER(LEFT(m.cCutOptions,8))="WATERJET"
				*m.cCutOptions1 = RIGHT(m.cCutOptions,41)
				m.cCutOptions1 = RTRIM(SUBSTR(cCutOptions,10,LEN(m.cCutOptions)-10))
				DO CASE
				CASE UPPER(LEFT(m.cCutOptions1,20)) = "ONE CUT ALONG WIDTH "
					nCutOption = 1
					m.cCutOptions1 = RIGHT(m.cCutOptions1,20)
				CASE UPPER(LEFT(m.cCutOptions1,21)) = "ONE CUT ALONG LENGTH "
					nCutOption = 2
					m.cCutOptions1 = RIGHT(m.cCutOptions1,19)
				CASE UPPER(LEFT(m.cCutOptions1,26)) = "ONE CUT ALONG LENGTH+WIDTH"
					nCutOption = 3
					m.cCutOptions1 = RIGHT(m.cCutOptions1,14)
				CASE UPPER(LEFT(m.cCutOptions1,16)) = "4 SIDES COMBINED"
					nCutOption = 5
					m.cCutOptions1 = RIGHT(m.cCutOptions1,24)
				CASE UPPER(LEFT(m.cCutOptions1,10)) = "4 SIDE CUT"
					nCutOption = 4
					m.cCutOptions1 = RIGHT(m.cCutOptions1,30)
				CASE UPPER(LEFT(m.cCutOptions1,8)) = "CUT DISK"
					nCutOption = 6
					m.cCutOptions1 = RIGHT(m.cCutOptions1,32)
				OTHERWISE
					nCutOption = 0
					TrackError("No case Match "+cCutOptions1,"Hi Lite stored selection",PROGRAM(),LINENO(0) )
				ENDCASE	
					
				m.cCutOptionsSpeed = SUBSTR(m.cCutOptions1, AT('@',m.cCutOptions1)+1,3)
				DO CASE
				CASE VAL(m.cCutOptionsSpeed) = 0
					*Not Found
					ThisFormset.frmWaterJet.pfQuality.ActivePage = 2
				CASE VAL(m.cCutOptionsSpeed) = 100
					ThisFormset.frmWaterJet.pfQuality.ActivePage = 1
					DO CASE
					CASE nCutOption = 1
						ThisFormset.frmWaterJet.pfQuality.Pg100.txtOneCutWidthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 2
						ThisFormset.frmWaterJet.pfQuality.Pg100.txtOneCutLengthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 3
						ThisFormset.frmWaterJet.pfQuality.Pg100.txtOneCutLWDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 4
						ThisFormset.frmWaterJet.pfQuality.Pg100.txt4SidedDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 5
						ThisFormset.frmWaterJet.pfQuality.Pg100.txt4SidedCombDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 6
						ThisFormset.frmWaterJet.pfQuality.Pg100.txtDiskDollar.BackColor = RGB(255,255,128)
					OTHERWISE
						TrackError("BackColor. No case Match nCutOption="+STR(nCutOption),"BackColor",PROGRAM(),LINENO(0) )
					ENDCASE			
		
				CASE VAL(m.cCutOptionsSpeed) = 80
					ThisFormset.frmWaterJet.pfQuality.ActivePage = 2
					DO CASE
					CASE nCutOption = 1
						ThisFormset.frmWaterJet.pfQuality.Pg80.txtOneCutWidthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 2
						ThisFormset.frmWaterJet.pfQuality.Pg80.txtOneCutLengthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 3
						ThisFormset.frmWaterJet.pfQuality.Pg80.txtOneCutLWDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 4
						ThisFormset.frmWaterJet.pfQuality.Pg80.txt4SidedDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 5
						ThisFormset.frmWaterJet.pfQuality.Pg80.txt4SidedCombDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 6
						ThisFormset.frmWaterJet.pfQuality.Pg80.txtDiskDollar.BackColor = RGB(255,255,128)
					OTHERWISE
						TrackError("BackColor. No case Match nCutOption="+STR(nCutOption),"BackColor",PROGRAM(),LINENO(0) )
					ENDCASE			
		
				CASE VAL(m.cCutOptionsSpeed) = 60
					ThisFormset.frmWaterJet.pfQuality.ActivePage = 3
					DO CASE
					CASE nCutOption = 1
						ThisFormset.frmWaterJet.pfQuality.Pg60.txtOneCutWidthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 2
						ThisFormset.frmWaterJet.pfQuality.Pg60.txtOneCutLengthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 3
						ThisFormset.frmWaterJet.pfQuality.Pg60.txtOneCutLWDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 4
						ThisFormset.frmWaterJet.pfQuality.Pg60.txt4SidedDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 5
						ThisFormset.frmWaterJet.pfQuality.Pg60.txt4SidedCombDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 6
						ThisFormset.frmWaterJet.pfQuality.Pg60.txtDiskDollar.BackColor = RGB(255,255,128)
					OTHERWISE
						TrackError("BackColor. No case Match nCutOption="+STR(nCutOption),"BackColor",PROGRAM(),LINENO(0) )
					ENDCASE			
				CASE VAL(m.cCutOptionsSpeed) = 40
					ThisFormset.frmWaterJet.pfQuality.ActivePage = 4
					DO CASE
					CASE nCutOption = 1
						ThisFormset.frmWaterJet.pfQuality.Pg40.txtOneCutWidthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 2
						ThisFormset.frmWaterJet.pfQuality.Pg40.txtOneCutLengthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 3
						ThisFormset.frmWaterJet.pfQuality.Pg40.txtOneCutLWDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 4
						ThisFormset.frmWaterJet.pfQuality.Pg40.txt4SidedDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 5
						ThisFormset.frmWaterJet.pfQuality.Pg40.txt4SidedCombDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 6
						ThisFormset.frmWaterJet.pfQuality.Pg40.txtDiskDollar.BackColor = RGB(255,255,128)
					OTHERWISE
						TrackError("BackColor. No case Match nCutOption="+STR(nCutOption),"BackColor",PROGRAM(),LINENO(0))
					ENDCASE			
		
				CASE VAL(m.cCutOptionsSpeed) = 20
					ThisFormset.frmWaterJet.pfQuality.ActivePage = 5
					DO CASE
					CASE nCutOption = 1
						ThisFormset.frmWaterJet.pfQuality.Pg20.txtOneCutWidthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 2
						ThisFormset.frmWaterJet.pfQuality.Pg20.txtOneCutLengthDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 3
						ThisFormset.frmWaterJet.pfQuality.Pg20.txtOneCutLWDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 4
						ThisFormset.frmWaterJet.pfQuality.Pg20.txt4SidedDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 5
						ThisFormset.frmWaterJet.pfQuality.Pg20.txt4SidedCombDollar.BackColor = RGB(255,255,128)
					CASE nCutOption = 6
						ThisFormset.frmWaterJet.pfQuality.Pg20.txtDiskDollar.BackColor = RGB(255,255,128)
					OTHERWISE
						TrackError("BackColor. No case Match nCutOption="+STR(nCutOption),"BackColor",PROGRAM(),LINENO(0))
					ENDCASE			
		
				ENDCASE
						
		*		m.cCutOptionsTol = RIGHT(m.cCutOptions1, LEN(m.cCutOptions1)-AT('+',m.cCutOptions1)-1 )
			ENDIF
		ELSE
			MESSAGEBOX("Could not retrieve Cutting Tables.",48,"SQL Error")
			TrackError("Could not retrieve waterjet Cutting Tables in frmQuotes.Waterjet."+CHR(13)+"lOK = getWaterJet(nThick,gnConnHandle)"+CHR(13)+"lOK = "+IIF(lOK,"True","False"),"Waterjet Cutting Tables",PROGRAM(),LINENO(1) )
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		IF lDefault 
			ThisFormSet.frmWaterJet.pfQuality.Pg80.lblDisk.Click
			*ThisFormset.frmWaterJet.cmdSave.Click  --let User Click to SAVE
		ENDIF
	ENDPROC

	PROCEDURE frmCustomer.cmdEditSave.Click
		
		
		IF This.Caption = "Edit"
			ThisForm.edtCustomer.ReadOnly = .F.
			This.Caption = "Save"
			IF EMPTY(ThisForm.edtCustomer.Value)
				ThisForm.edtCustomer.Value = ALLTRIM(STR(YEAR(DATE())))+" "
			ENDIF
			
			ThisForm.edtCustomer.SetFocus
			
		ELSE
			This.Caption = "Edit"
			ThisForm.edtCustomer.ReadOnly = .T.
			
			ThisFormSet.SaveCustomerNotes(ThisForm.edtCustomer.Value)	
		
		ENDIF
	ENDPROC

	PROCEDURE frmCustomerChanged.cmdEdit.Click
		IF This.Caption = 'Edit'
			ThisForm.txtCountryCNew.ReadOnly = .F.
			ThisForm.txtPhoneNew.ReadOnly = .F.
			ThisForm.txtPhone_ExtNew.ReadOnly = .F.
			ThisForm.txtFaxNew.ReadOnly = .F.
			ThisForm.txtEmailNew.ReadOnly = .F.
			This.Caption = 'Save'
			ThisForm.txtCountryCNew.SetFocus
		ELSE
			ThisForm.txtCountryCNew.ReadOnly = .T.
			ThisForm.txtPhoneNew.ReadOnly = .T.
			ThisForm.txtPhone_ExtNew.ReadOnly = .T.
			ThisForm.txtFaxNew.ReadOnly = .T.
			ThisForm.txtEmailNew.ReadOnly = .T.
		
			This.Caption = 'Edit'
		ENDIF
	ENDPROC

	PROCEDURE frmCustomerChanged.cmdUpdate.Click
		
		
		PRIVATE cCustID,cCompany,cName,cCountryCOld,cCountryCNew
		PRIVATE cPhoneOld,cPhoneNew,cPhone_extOld,cPhone_extNew,cFaxNew,cFaxOld,cEmailOld,cEmailNew
		cCustID		= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtCustID.Value,'CustID',20)
		cCompany 	= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtCompany.Value,'Company',30)
		cName 		= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtName.Value,'Name',25)
		cCountryCold= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtCountryCold.Value,'CountryC',10)
		cCountryCNew= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtCountryCNew.Value,'CountryC',10)
		cPhoneOld 	= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtPhoneOld.Value,'Phone',10)
		cPhoneNew 	= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtPhoneNew.Value,'Phone',10)
		cPhone_extOld = PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtPhone_extOld.Value,'Phone_Ext',6)
		cPhone_extNew =	PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtPhone_extNew.Value,'Phone_Ext',6)
		cFaxOld		= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtFaxOld.Value,'Fax',10)
		cFaxNew		= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtFaxNew.Value,'Fax',10)
		cEmailOld 	= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtEmailOld.Value,'Email',60)
		cEmailNew 	= PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtEmailNew.Value,'Email',60)
		
		PRIVATE cNotes
		cNotes 		= PrepareSQLtxt(ThisFormSet.frmCustomer.edtCustomer.Value,'Notes',-1)
		
		PRIVATE xCompName, xCompNameNew
		xCompName = PrepareSQLtxt(ThisFormSet.frmCustomerChanged.txtXCompName.Value,'Email',60)
		xCompNameNew = GetxCompName(cPhoneNew,cCompany,cName,gnConnHandle)
		
		PRIVATE lUpdateViewQuotes 
		lUpdateViewQuotes = .F.
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF ThisForm.chkQTAll.Value = 1
			*save to Quick Company
		
		
			IF USED('tmpCntxCompName')	
				USE IN tmpCntxCompName
			ENDIF
			
			*Does xCompName exist?
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.QuickCompany WITH(NOLOCK) "	
			cSQL = cSQL + "  WHERE xCompName= '"+xCompName+"'"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpCntxCompName' )
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpCntxCompName' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCntxCompName")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCntxCompName")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpCntxCompName')
			ENDIF	
			IF USED('tmpCntxCompName')
				IF tmpCntxCompName.Cntd > 0
					*to keep there from being more than one, 
					*you deleted all, 
					*then add back one.
					
					*You may loose Status
					
					cSQL = "DELETE FROM dbo.QuickCompany "
					cSQL = cSQL + "  WHERE xCompName= '"+xCompName+"'"
		
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
		
					IF nSQLEXEC < 0
						SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
					ENDIF	
				ENDIF
				USE IN tmpCntxCompName
				
				*Insert
				cSQL = "INSERT INTO dbo.QuickCompany (Customer,Company,Name,CountryC"
				cSQL = cSQL + ",Phone,Phone_ext,Fax,Email,xCompName,Notes) VALUES ("
				cSQL = cSQL + " '"+cCustID+"'"
				cSQL = cSQL + ",'"+cCompany+"'"
				cSQL = cSQL + ",'"+cName+"'"
			    cSQL = cSQL + ",'"+cCountryCNew+"'"
				cSQL = cSQL + ",'"+cPhoneNew+"'"
				cSQL = cSQL + ",'"+cPhone_ExtNew+"'"    
				cSQL = cSQL + ",'"+cFaxNew+"'"
				cSQL = cSQL + ",'"+cEmailNew+"'"
				cSQL = cSQL + ",'"+xCompNameNew+"'"
				cSQL = cSQL + ",'"+cNotes+"'"
				cSQL = cSQL + ")"
		
		*!*				cSQL = "UPDATE dbo.QuickCompany SET "
		*!*				cSQL = cSQL + " [Customer] = '"+cCustID+"'"
		*!*				cSQL = cSQL + " [Company] = '"+cCompany+"'"
		*!*				cSQL = cSQL + ",[Name] = '"+cName+"'"
		*!*			    cSQL = cSQL + ",[CountryC] = '"+cCountryCNew+"'"
		*!*				cSQL = cSQL + ",[Phone] = '"+cPhoneNew+"'"
		*!*				cSQL = cSQL + ",[Phone_Ext] = '"+cPhone_ExtNew+"'"    
		*!*				cSQL = cSQL + ",[Fax] = '"+cFaxNew+"'"
		*!*				cSQL = cSQL + ",[Email] = '"+cEmailNew+"'"
		*!*				cSQL = cSQL + ",[xCompName] = '"+xCompNameNew+"'"
		*!*				cSQL = cSQL + "  WHERE xCompName= '"+xCompName+"'"
		
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
		
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
				ENDIF	
			ELSE
				MESSAGEBOX("SQL error",16,"Error")
			ENDIF
		ENDIF
		
		PRIVATE cUpdate 
		IF ThisForm.chkAQCountryC.Value = 1
			cUpdate = "UPDATE dbo.AllQuotes SET "
			cUpdate = cUpdate + " CountryC ='"+cCountryCNew+"'"
			cUpdate = cUpdate + " WHERE AllQuotes.CountryC ='"+cCountryCOld+"'"
			cUpdate = cUpdate + " AND AllQuotes.Company ='"+cCompany+"'"
			cUpdate = cUpdate + " AND AllQuotes.Name ='"+cName+"'"
			cUpdate = cUpdate + " AND AllQuotes.CustID ='"+cCustID+"'"
		
			nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate)
			DO WHILE nSQLEXEC = 0
