	PROCEDURE frmSelectSendInq.cmdSend.Click
		PRIVATE cLegelFileName
		cLegelFileName = THISFORMSET.Load_UserInfo()
		
		SELECT UserInfo
		GO TOP
		
		SELECT tmpSources
		WAIT WINDOW 'GATHERING THE COMPANY(S) YOU SELECTED' NOWAIT
		** RECORD SELECED RECORDS
		COUNT ALL FOR Mrk TO aCNT   &&AND (ThisForm.SalesP = q.p) TO acnt
		
		PRIVATE lnSendToLoop, asrcs
		LOCAL txtGcompany, txtGphone, txtGfax,	txtGperson,	txtGemail,	txtGemail2, txtGalloy
		LOCAL m.ifax, m.faxnum
		m.ifax = SPACE(10)
		m.faxnum = SPACE(11)
		
		LOCAL m.icompany, m.iphone, m.ifaxnum, m.iperson, m.iemail, m.iemail2
		PRIVATE m.ieAlloy, m.iVendCode
		
		IF aCNT > 0
		*DO Progs\Gathersend.prg WITH ThisForm.SalesP, .F., paQuotesInqNo
			SELECT tmpSources
			SCAN
				IF Mrk
					m.icompany	= ShowSQLtxt(tmpSources.Company,'Company',30)
					m.iphone	= PrepareSQLphone(tmpSources.Phone,'Phone')
					m.ifaxnum	= PrepareSQLphone(tmpSources.Fax,'Fax')
					m.iperson	= ShowSQLtxt(tmpSources.Person,'Person',15)
					m.iemail	= PrepareSQLemail(tmpSources.Email,'Email',60)
					m.iemail2	= PrepareSQLemail(tmpSources.Email,'Email2',60)
					m.ieAlloy	= ShowSQLtxt(tmpSources.Alloy,'Alloy',12)
					m.iVendCode = PrepareSQLnum(tmpSources.VendCode,'VendCode',-3)
					
					m.iphone  = IIF(EMPTY(m.iphone ),SPACE(11),"1"+m.iphone )
					m.ifaxnum = IIF(EMPTY(m.ifaxnum),SPACE(11),"1"+m.ifaxnum)
		
					DO FORM FORMS\GatherSend WITH m.icompany,m.iphone,m.ifaxnum,m.iperson,m.iemail,m.iemail2, paQuotesInqNo, Quotes.SalesP, m.ieAlloy, m.iVendCode
				ENDIF
			ENDSCAN
		
		ELSE
			msgGS = MESSAGEBOX("Do you want to address your own Inquire ?",4+32,"No names selected")
			IF msgGS = 6
				*DO Progs\Gathersend.prg WITH ThisForm.SalesP, .T., paQuotesInqNo
				txtGcompany	= SPACE(30)
				txtGphone	= SPACE(11)
				txtGfax		= SPACE(11)
				txtGperson	= "Sales"+SPACE(10)
				txtGemail	= SPACE(60)
				txtGemail2	= SPACE(60)
				IF USED('Quotes')
					txtGalloy	= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
				ELSE
					txtGalloy	= ""
				ENDIF
		
			*	SAVE ALL LIKE txtG* TO c:\GatherSend
				DO FORM FORMS\GatherSend WITH txtGcompany,txtGphone,txtGfax,txtGperson,txtGemail,txtGemail2, paQuotesInqNo, Quotes.SalesP, txtGalloy, 0
			ENDIF
		ENDIF
		
		
		IF USED('UserInfo')
			USE IN UserInfo
			IF FILE(SYS(5)+SYS(2003)+"\"+cLegelFileName+".DBF")
				DELETE FILE (SYS(5)+SYS(2003)+"\"+cLegelFileName+".DBF")
			ENDIF
			IF FILE(SYS(5)+SYS(2003)+"\MEM\"+cLegelFileName+".DBF")
				DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+cLegelFileName+".DBF")
			ENDIF
		ENDIF
		
		
		IF USED('tmpSources')
		*	SELECT tmpSources &&sourcePH
		*	ThisForm.grdSource.RecordSource = ""
		*	USE IN tmpSources
		ENDIF
		
		THISFORM.VISIBLE = .F.
		THISFORM.ALWAYSONTOP = .F.
		*RELEASE paQuotesInqNo
		
	ENDPROC

