	PROCEDURE QUOTES.cmbCC.Destroy
		RELEASE aConditionCode
	ENDPROC

	PROCEDURE QUOTES.cmbCC.GotFocus
		ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		
	ENDPROC

	PROCEDURE QUOTES.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ISNULL(inActive,0) = 0"
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE QUOTES.cmbCC.InteractiveChange
		PRIVATE cCC, cCL_default
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		cCL_default	= Default_CL_CC(cCC,gnConnHandle)
		
		This.Parent.cmbCL.Value = cCL_default
		ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.CL = cCL_default
	ENDPROC

	PROCEDURE QUOTES.cmbCC.LostFocus
		ThisFormSet.InitcmbCL()
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		This.Parent.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel WITH(NOLOCK) "
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		This.Parent.cmbCL.ColumnCount = 2
		This.Parent.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		This.Parent.cmbCL.BoundColumn = 1
		This.Parent.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		
		IF AllowedCCLevel(cCC,cCL1)
			This.Parent.cmbCL.Value = cCL1
		ELSE
			This.Parent.cmbCL.Value = Default_CL_CC(cCC,gnConnHandle)
		ENDIF
		
		IF ThisFormSet.CC != PrepareSQLtxt(This.Value,'CC',1)
			ThisFormSet.CC = PrepareSQLtxt(This.Value,'CC',1)
		*	This.Parent.cmbCL.Value = ''
		*	This.Parent.cmbCL.Value = Default_CL_CC(cCC,gnConnHandle)
		*	This.Parent.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmbCC.Valid
		IF ThisFormset.QUOTES.THCK1.Value * ThisFormset.QUOTES.SZ21.Value > 0
			IF NOT ThisFormset.QUOTES.SZ31.Visible
		*		IF ThisFormset.QUOTES.SZ21.Value > 0
					ThisFormSet.CalcInv(2)
		*		ENDIF
			ELSE
				IF ThisFormset.QUOTES.SZ31.Value > 0
					ThisFormSet.CalcInv(3) 
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.cmbCC.When
		IF ThisFormSet.isediting
			ThisFormSet.MetricGOTFocus  = "cmbCC"
			ThisFormSet.GOTFocusLast  = "cmbCC"
		ENDIF
		RETURN ThisFormSet.isediting
	ENDPROC

	PROCEDURE QUOTES.cmbCL.GotFocus
		ThisFormSet.CC = PrepareSQLtxt(This.Parent.cmbCC.Value,'CC',1)
		ThisFormSet.CL = PrepareSQLtxt(This.Value,'CL',1)
		
		*******************************
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		This.Parent.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel WITH(NOLOCK) "
		cSQL=cSQL+" WHERE [CC]='"+ThisFormSet.CC+"'"
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					This.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					This.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		
		*******************************
		IF AllowedCCLevel(ThisFormSet.CC,ThisFormSet.CL)
			This.Value = ThisFormSet.CL
		ELSE
			This.Value = Default_CL_CC(ThisFormSet.CC,gnConnHandle)
		ENDIF
	ENDPROC

