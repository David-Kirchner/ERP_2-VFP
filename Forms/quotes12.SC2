	PROCEDURE seekstartingstocksalesnum
		PARAMETERS nSalesNum
		*ThisFormSet.SeekStartingStockSalesNum()	
		
		IF USED('StartingStock')
			USE IN StartingStock
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT SS.*, AQ.SOitem FROM dbo.AllQuotes AQ LEFT OUTER JOIN "
		cSQL = cSQL + " dbo.StartingStock SS ON AQ.ID = SS.AllQuotes_ID "
		cSQL = cSQL + " WHERE AQ.SalesNum = "+STR(nSalesNum)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'StartingStock')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'StartingStock')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "StartingStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "StartingStock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'StartingStock')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		ENDIF
		
		IF USED('StartingStock')
			SELECT StartingStock
			INDEX ON SOitem TAG SOitem
			SET ORDER TO TAG SOitem
			
			*Called from Print SO
			SELECT SalesQuote
			SET RELATION TO SOitem INTO StartingStock
		ENDIF
		
		
	ENDPROC

	PROCEDURE selectsendinq_reload		&& Load
		PARAMETERS pcAlloy
		*, pAQrecN
		*ThisFormSet.SelectSendINQ_reload(Alloy)
		
		IF VARTYPE(pcAlloy)!="C"
			pcAlloy = '6B'
		ENDIF
		
		*thisformset.SendInquireFile = "INQUIRE4"+salesp
		*thisformset.SendInquireFile0 = thisformset.SendInquireFile + ".DBF"
		    
		    
		IF USED('tmpSources')
			ThisFormset.frmSelectSendInq.grdSource.RecordSource = ""
			ThisFormset.frmSelectSendInq.edtNotes.Value = ""
			USE IN tmpSources
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT CAST( 0 AS BIT) AS Mrk"
		cSQL = cSQL + ",CASE WHEN LEN(ISNULL(SourcePH.Company,''))<1 THEN SourcePh.Company ELSE SourcePH.Company END AS Company"
		cSQL = cSQL + ",Alloy,Alloy_AKA,UNS,Spec,f10,f20,f30,f40,f60,f65,f70,f75"
		cSQL = cSQL + ",Stk,MK"
		cSQL = cSQL + ",SourcePH.VendCode"
		
		*cSQL = cSQL + ",VC.Phone,VC.Fax,VC.Contact AS Person,VC.Email "
		cSQL = cSQL + ",Phone,Fax,Person,Email "
		
		cSQL = cSQL + ",SourcePh.ID,Sources.Notes "
		cSQL = cSQL + " FROM dbo.Sources WITH(NOLOCK) "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.SourcePh WITH(NOLOCK) ON Sources.ID = SourcePh.ID"
		*cSQL = cSQL + " LEFT OUTER JOIN dbo.Vendor V ON V.VendCode = SourcePh.VendCode"
		*cSQL = cSQL + " LEFT OUTER JOIN dbo.VendorContact VC ON VC.VendCode = SourcePH.VendCode"
		*cSQL = cSQL + " LEFT OUTER JOIN dbo.VendorContact VC2 ON VC2.VendCode = V.VendCode"
		cSQL = cSQL + " WHERE Sources.Alloy = '"+pcAlloy+"'"
		*cSQL = cSQL + " AND VC.Quality=0 AND VC.Inactive = 0"
		*cSQL = cSQL + " AND VC2.Quality=0 AND VC2.Inactive = 0"
		cSQL = cSQL + " ORDER BY CASE WHEN ISNULL(SourcePH.VendCode,0)=0 THEN 1 ELSE 0 END, SourcePH.Company "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSources')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSources')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSources")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSources")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSources')
		ENDIF
		
		
		IF NOT USED('tmpSources')
			MESSAGEBOX( "No records FOUND!"+CHR(13)+"Try a different Alloy"+CHR(13)+"or Could not load the Sources and SourcePH table.","Program Error")
			RETURN ""
		ENDIF
		IF RECCOUNT('tmpSources') = 0
			MESSAGEBOX( "No records FOUND!"+CHR(13)+"Could not load the Sources and SourcePH table.","Program Error")
			RETURN ""
		ENDIF
		
		SELECT tmpSources
		ThisFormset.frmSelectSendInq.Visible = .T.
		ThisFormset.frmSelectSendInq.grdSource.RecordSource = "tmpSources"
		ThisFormset.frmSelectSendInq.grdSource.Column1.CurrentControl = "Check1"
		
		ThisFormset.frmSelectSendInq.edtNotes.Value = tmpSources.Notes
		
		ThisFormset.frmSelectSendInq.Visible = .T.
		
		ThisFormset.frmSelectSendInq.AlwaysOnTop = .T.
	ENDPROC

	PROCEDURE sendinquire_marksent
		PARAMETER m.cmksd
		*ThisFormSet.SendInquire_marksent()
		
		*marksent
		SELECT qdb
		WAIT WINDOW 'RECORDING TO WHOM' NOWAIT
		*IF FCOUNT() = 1
		*	WAIT WINDOW 'YOU NEED TO UPDATE QUOTEFM.DBF TO TRACK FAXES'
		*	RETURN
		*ENDIF
		
		PRIVATE m.rcc
		COUNT TO m.rcc FOR RECNUM > 0
		DIMENSION paMarkSendRecordNo(m.rcc)
		
		*PUBLIC ARRAY aQuotesInqNumP(1)
		*aQuotesInqNumP(1) = ''
		*SELECT DISTINCT InqNumP FROM QDB WHERE RecNum > 0 INTO ARRAY aQuotesInqNumP
		
		CNT = 1
		GO TOP
		DO WHILE NOT EOF()
			IF QDB.recnum > 0
				paMarkSendRecordNo(CNT) = recnum
				CNT = CNT+1
			ENDIF
			SKIP
		ENDDO
		
		IF USED('Quotes')
		  SELECT Quotes
		  PRIVATE nNextInArray
		  IF CNT > 1
			FOR nNextInArray = 1 TO CNT -1
				GOTO paMarkSendRecordNo(nNextInArray)
		
				IF EMPTY(line3)
					REPLACE line3 WITH "Waiting for:"+m.cmksd
				ELSE
					REPLACE line3 WITH RTRIM(line3)+","+m.cmksd
				ENDIF
				FLUSH
		
				SELECT Quotes
			NEXT nNextInArray
			SELECT qdb   &&USE &quotedb EXCL ALIAS qdb
		  ENDIF
		ENDIF
	ENDPROC

	PROCEDURE sendinquire_qbody
		*ThisFormSet.SendInquire_Qbody
		PRIVATE ZcForm, ZcPieces
		PRIVATE cAlloy, cZAlloy, cCC, cCL, cZCC
		
		IF NOT USED('QDB')
			SELECT 0
			*quotedb = ALLTRIM(UPPER("INQUIRE4" + m.salesp ))+".DBF"
			*quotedb = SYS(3)
			ThisFormSet.fnINQUIRE4 = UniqDBF("INQUIRE4")
			quotedb = ThisFormSet.fnINQUIRE4
			
			IF "\MEM" $ SYS(2003)
				CREATE TABLE ( SYS(5)+SYS(2003)+"\"+quotedb ) FREE (LINE C(80), recnum N(8), InqNumP C(9) )
				USE (SYS(5)+SYS(2003)+"\"+quotedb) EXCL ALIAS QDB
			ELSE
				CREATE TABLE ( SYS(5)+SYS(2003)+"\MEM\"+quotedb ) FREE (LINE C(80), recnum N(8), InqNumP C(9) )
				USE (SYS(5)+SYS(2003)+"\MEM\"+quotedb) EXCL ALIAS QDB
			ENDIF
		ENDIF
		
		
		SELECT QDB
		APPEND BLANK
		IF FCOUNT('QDB') > 1
			REPLACE RECNUM  WITH Quotes.INQNUM
			REPLACE InqNumP WITH Quotes.InqNumP
		ELSE
			WAIT WINDOW "UPDATE QUOTEFM.DBF"
		ENDIF
		
		
		*******
		*Check for StartingStock!
		PRIVATE lStartingStock 
		lStartingStock = PrepareSQLlogic(Quotes.StartStock,'StartStock',.F.)
		
		IF lStartingStock
			nMess = MESSAGEBOX("Do you want to use the"+CHR(13)+"Starting Stock for this Inquire?",4+32,"Use Starting Stock?")
			IF nMess = 7
				lStartingStock = .F.
			ENDIF
		ENDIF
		
		
		IF lStartingStock
			*Use Starting Stock for Inquire	
			IF USED('tmpStartStock')
				USE IN tmpStartStock
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
			
			cSQL = "SELECT * FROM dbo.StartingStock WITH(NOLOCK) "
			cSQL = cSQL + " WHERE AllQuotes_ID = "+STR(Quotes.ID)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpStartStock')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpStartStock')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "tmpStartStock")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "tmpStartStock")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpStartStock')
			ENDIF
			IF USED('tmpStartStock')
				IF RECCOUNT('tmpStartStock') > 0
				
				ELSE
					MESSAGEBOX("Could not get the Starting Stock",0,"Data Error")
					TrackError("Could not get the Starting Stock data","Data Error",PROGRAM(),LINENO(1))
					RETURN .F.
				ENDIF
		*		USE IN tmpStartStock
			ELSE
				MESSAGEBOX("Could not get the Starting Stock",0 ,"Data Error")
				TrackError("Could not get the Starting Stock","Data Error",PROGRAM(),LINENO(1))
				RETURN .F.
			ENDIF
		
			SELECT QDB
				
			cAlloy	= PrepareSQLtxt(tmpStartStock.Alloy,'Alloy',12)
			cCC		= PrepareSQLtxt(tmpStartStock.CC,'CC',2)
			cCL		= PrepareSQLtxt(tmpStartStock.CL,'CL',2)
			
			IF EMPTY(cCC)
				cZCC = ''
			ELSE
				IF EMPTY(ALLTRIM(cCL))
					cZCC = ConditionCodeText(cCC)+" "
				ELSE
					cZCC = ConditionLevelText(cCC,cCL)+" "
				ENDIF
			ENDIF
		
			*Do not Duplicate Alloy when Field with Alloy starts with Alloy
			IF UPPER(RIGHT(cAlloy,5)) = "ALLOY"
				cZAlloy = cAlloy
			ELSE
				cZAlloy = "Alloy: "+cAlloy+" "
			ENDIF
			
			cZAlloy = ALLTRIM(cZAlloy) +" "+cZCC+" "
			
			IF PrepareSQLlogic(Quotes.TN,'TN',.F.)
				cZAlloy = cZAlloy + ALLTRIM(BrandName( cAlloy ))
			ENDIF
			cZAlloy = cZAlloy + ' - '+ ALLTRIM(UniversalName( cAlloy ))
		
			ZcForm = ""
			*ZcForm = FormDescription( Quotes.Form, Quotes.Thck) Do not use Thck in Description
			ZcForm = FormDescription( tmpStartStock.Form, tmpStartStock.Thck )
		
		
			IF tmpStartStock.Pieces > 0
				*ZcForm = ALLTRIM(ZcForm)
				ZcPieces = "Pieces: "+LTRIM(STR(tmpStartStock.Pieces,7,0))
			ELSE
				IF tmpStartStock.Weight > 0 AND tmpStartStock.Form <> "51"
					ZcPieces = " "+ALLTRIM(STR( tmpStartStock.Weight ,7,2))+ " Pounds"
				ELSE 
					ZcPieces = " "
				ENDIF
			ENDIF
			
			SELECT QDB
			REPLACE LINE WITH cZAlloy +"  Form: "+ZcForm
			APPEND BLANK
			REPLACE LINE WITH ZcPieces 
		
		
			PRIVATE cReturnD
			cReturnD = ""
			cReturnD = ItemDescriptionMetric(tmpStartStock.Form, tmpStartStock.Thck, tmpStartStock.SZ2, tmpStartStock.SZ3, tmpStartStock.Weight, Quotes.RandLen, .F.,'','','') 
																							&&Quotes.Metric, Quotes.Sz1orig, Quotes.Sz2orig, Quotes.Sz3orig)
			APPEND BLANK
			*REPLACE LINE WITH M.T1+Unit1+M.S2+Unit2+M.S3+Unit3
			REPLACE LINE WITH cReturnD
		
		
		
		ELSE  &&*Check for StartingStock!
		
			cAlloy	= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
			cCC		= PrepareSQLtxt(Quotes.CC,'CC',2)
			cCL		= PrepareSQLtxt(Quotes.CL,'CL',2)
			
			IF EMPTY(cCC)
				cZCC = ''
			ELSE
				IF EMPTY(ALLTRIM(cCL))
					cZCC = ConditionCodeText(cCC)+" "
				ELSE
					cZCC = ConditionLevelText(cCC,cCL)+" "
				ENDIF
			ENDIF
			
			*Do not Duplicate Alloy when Field with Alloy starts with Alloy
			IF UPPER(RIGHT(cAlloy,5)) = "ALLOY"
				cZAlloy = cAlloy
			ELSE
				cZAlloy = "Alloy: "+cAlloy+" "
			ENDIF
		
			cZAlloy = ALLTRIM(cZAlloy ) +" "+cZCC+" "
			
			
			IF PrepareSQLlogic(Quotes.TN,'TN',.F.)
				cZAlloy = cZAlloy + ALLTRIM(BrandName( cAlloy ))
			ENDIF
			cZAlloy = cZAlloy + ' - '+ ALLTRIM(UniversalName( cAlloy ))
		
			ZcForm = ""
			*ZcForm = FormDescription( Quotes.Form, Quotes.Thck) Do not use Thck in Description
			ZcForm = FormDescription( Quotes.Form, Quotes.Thck )
		
		
			IF Quotes.Pieces > 0
				*ZcForm = ALLTRIM(ZcForm)
				ZcPieces = "Pieces: "+LTRIM(STR(Quotes.Pieces,7,0))
			ELSE
				IF Quotes.Weight > 0 AND Quotes.Form <> "51"
					ZcPieces = " "+ALLTRIM(STR( Quotes.Weight ,7,2))+ " Pounds"
				ELSE 
					ZcPieces = " "
				ENDIF
			ENDIF
			
			SELECT QDB
			REPLACE LINE WITH cZAlloy +"  Form: "+ZcForm
			APPEND BLANK
			REPLACE LINE WITH ZcPieces 
		
		
			PRIVATE cReturnD
			cReturnD = ""
			cReturnD = ItemDescriptionMetric(Quotes.Form, Quotes.Thck, Quotes.SZ2, Quotes.SZ3, Quotes.Weight, Quotes.RandLen, Quotes.Metric, Quotes.Sz1orig, Quotes.Sz2orig, Quotes.Sz3orig)
			APPEND BLANK
			*REPLACE LINE WITH M.T1+Unit1+M.S2+Unit2+M.S3+Unit3
			REPLACE LINE WITH cReturnD
		
			IF Quotes.Metric
				PRIVATE cReturnM
				cReturnM = IIF( EMPTY(Quotes.sz1Orig+Quotes.sz2Orig+Quotes.sz3Orig),"","   Metric Size wanted: " + IIF( EMPTY(Quotes.sz1Orig),"",ALLTRIM(Quotes.sz1Orig)) + IIF( EMPTY(Quotes.sz2Orig),"", " x "+ ALLTRIM(Quotes.sz2Orig) ) + IIF( EMPTY(Quotes.sz3Orig),"", " x "+ ALLTRIM(Quotes.sz3Orig) ) )
				APPEND BLANK
				REPLACE LINE WITH cReturnM
				RELEASE cReturnM
			ENDIF
		
			IF Quotes.Services
				APPEND BLANK
				REPLACE LINE WITH "Sevice Only, No material cost involved."
			ENDIF
		
			IF !EMPTY(TRIM(Quotes.Descript))
				APPEND BLANK
				REPLACE LINE WITH Quotes.Descript
			ENDIF
		
			PRIVATE nComLine, nForLoop, c70Chars, nSpaceLocation
			IF !EMPTY(Quotes.Comments)
				nComLine = ALINES(aComments, Quotes.Comments, .T. )
				FOR nForLoop = 1 TO nComLine
				
					cAllChars = aComments(nForLoop)
					DO WHILE LEN( cAllChars ) > 0
						IF LEN(cAllChars) <= 72
							c70Chars = cAllChars
							cAllChars = ""
						ELSE
							nSpaceLocation = 72
							nSpaceLocation = ATCC( " ",SUBSTRC(cAllChars,58,14) )
							IF nSpaceLocation = 0
								nSpaceLocation = 72
							ELSE
								nSpaceLocation = 57 + nSpaceLocation 
							ENDIF
							c70Chars = LEFT( cAllChars ,nSpaceLocation)
							cAllChars = RIGHT( cAllChars, LEN( cAllChars) - LEN(c70Chars) )
						ENDIF
		
						APPEND BLANK
						REPLACE LINE WITH c70Chars 
					ENDDO
				ENDFOR
			ENDIF
		
		ENDIF
		
		SELECT QDB
		APPEND BLANK
		APPEND BLANK
		REPLACE LINE WITH REPLICATE("_",93)
		
		RETURN
	ENDPROC

	PROCEDURE sendinquire_reload
		PRIVATE m.salesp, quotedb
		*ThisFormet.SendInquire_Reload()
		
		IF VARTYPE(Quotes.SalesP) = "C"
			m.salesp = Quotes.salesp
		ENDIF
		
		IF VARTYPE(Salesp) = "U"
			DO CASE
			CASE FILE(SYS(5)+SYS(2003) +"\SALESP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\SALESP.MEM") ADDITIVE
			CASE FILE(SYS(5)+SYS(2003) +"\MEM\SALESP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SALESP.MEM") ADDITIVE
		
			OTHERWISE
				WAIT WINDOW "Type your Initial now" TO BLANK
				IF NOT EMPTY(Blank)
					m.salesp = UPPER(Blank)
				ELSE
					m.salesp = "~"
				ENDIF
			ENDCASE
		ELSE
			IF EMPTY(m.salesp)
				IF FILE(SYS(5)+SYS(2003) +"\SALESP.MEM")
					RESTORE FROM (SYS(5)+SYS(2003) +"\SALESP.MEM") ADDITIVE
				ELSE
					IF FILE(SYS(5)+SYS(2003) +"\MEM\SALESP.MEM")
						RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SALESP.MEM") ADDITIVE
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		*hisform.salesp = m.salesp
		*********
		
		
		
		
		IF USED('QuoteAttach')
			USE IN QuoteAttach
			IF NOT EMPTY(Thisformset.fnQuoteAttach)
				IF FILE(SYS(5)+SYS(2003)+"\"+Thisformset.fnQuoteAttach)
					DELETE FILE (SYS(5)+SYS(2003)+"\"+Thisformset.fnQuoteAttach)
				ENDIF
				IF FILE(SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnQuoteAttach)
					DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnQuoteAttach)
				ENDIF
			ENDIF
			
			Thisformset.fnQuoteAttach = ""
		ENDIF
		
		Thisformset.fnQuoteAttach = UniqDBF("QuoteAttach")
		
		
		IF "\MEM" $ SYS(2003)
			CREATE TABLE (SYS(5)+SYS(2003)+"\"+Thisformset.fnQuoteAttach) FREE (UNCFile C(254), FileName C(254), FileSize N(8,2) )
			USE (SYS(5)+SYS(2003)+"\"+Thisformset.fnQuoteAttach) EXCL ALIAS QuoteAttach
		ELSE
			CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnQuoteAttach) FREE (UNCFile C(254), FileName C(254), FileSize N(8,2) )
			USE (SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnQuoteAttach) EXCL ALIAS QuoteAttach
		ENDIF
		
		
		
		*!*	IF USED('QuoteAttach')
		*!*		PRIVATE lNewVersion
		*!*		lNewVersion = .F.
		*!*		
		*!*		FOR gnCount = 1 TO FCOUNT( )  && Loop for number of fields
		*!*	   		IF FIELD(gnCount) = "FILESIZE"
		*!*		   		lNewVersion = .T.
		*!*	   		ENDIF
		*!*		NEXT
		*!*		
		*!*		IF lNewVersion
		*!*			&&Create file
		*!*			SELECT 0
		*!*			IF "\MEM" $ SYS(2003)
		*!*				CREATE TABLE (SYS(5)+SYS(2003)+"\QuoteAttach.DBF") FREE (UNCFile C(254), FileName C(254), FileSize N(8,2) )
		*!*			ELSE
		*!*				CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\QuoteAttach.DBF") FREE (UNCFile C(254), FileName C(254), FileSize N(8,2) )
		*!*			ENDIF
		*!*		ELSE	
		*!*			USE IN QuoteAttach
		*!*			IF FILE(SYS(5)+SYS(2003)+"\QuoteAttach.DBF") 
		*!*				DELETE FILE (SYS(5)+SYS(2003)+"\QuoteAttach.DBF")
		*!*			ENDIF
		*!*			IF FILE(SYS(5)+SYS(2003)+"\MEM\QuoteAttach.DBF") 
		*!*				DELETE FILE (SYS(5)+SYS(2003)+"\MEM\QuoteAttach.DBF")
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		
		IF USED('QuoteAttach')
			SELECT QuoteAttach
		*	INSERT INTO QuoteAttach (UNCFile) VALUES ("")
		ENDIF
		
		********
		
		IF USED('QDB')
			SELECT QDB
			USE IN QDB
			
			IF NOT EMPTY(Thisformset.fnINQUIRE4)
				IF FILE(SYS(5)+SYS(2003)+"\"+Thisformset.fnINQUIRE4)
					DELETE FILE (SYS(5)+SYS(2003)+"\"+Thisformset.fnINQUIRE4)
				ENDIF
				IF FILE(SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnINQUIRE4)
					DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+Thisformset.fnINQUIRE4)
				ENDIF
			ENDIF
			ThisFormSet.fnINQUIRE4 = ''
		ENDIF
		
		*!*	quotedb = ALLTRIM(UPPER("INQUIRE4" + m.salesp ))+".DBF"
		*!*	IF USED(quotedb)
		*!*		SELECT (quotedb)
		*!*		USE
		*!*		*ThisFormSet.fnINQUIRE4 = ''
		*!*	ENDIF
		
		*!*	IF FILE(SYS(5)+SYS(2003)+"\"+quotedb)
		*!*		DELETE FILE (SYS(5)+SYS(2003)+"\"+quotedb)
		*!*	ENDIF
		*!*	IF FILE(SYS(5)+SYS(2003)+"\MEM\"+quotedb)
		*!*		DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+quotedb)
		*!*	ENDIF
		
		*!*	IF FILE(SYS(5)+SYS(2003)+"\"+quotedb) &&Clean the file
		*!*		SELECT 0
		*!*		USE (SYS(5)+SYS(2003)+"\"+quotedb) EXCL ALIAS QDB
		*!*		PACK
		*!*		IF USED(quotedb)
		*!*			ZAP
		*!*		ENDIF
		*!*	ELSE &&Create file
		
		ThisFormSet.fnINQUIRE4 = UniqDBF("INQUIRE4")
		
		IF "\MEM" $ SYS(2003)
			CREATE TABLE ( SYS(5)+SYS(2003)+"\"+ThisFormSet.fnINQUIRE4) FREE (LINE C(80), recnum N(8), InqNumP C(9) )
			USE (SYS(5)+SYS(2003)+"\"+ThisFormSet.fnINQUIRE4) EXCL ALIAS QDB
		ELSE
			CREATE TABLE ( SYS(5)+SYS(2003)+"\MEM\"+ThisFormSet.fnINQUIRE4) FREE (LINE C(80), recnum N(8), InqNumP C(9) )
			USE (SYS(5)+SYS(2003)+"\MEM\"+ThisFormSet.fnINQUIRE4) EXCL ALIAS QDB
		ENDIF
		*ENDIF
		*!*	ENDIF
		
		*thisform.Firstadd=.T.
		ThisFormSet.nInquireSelectSend = 0
		
		ThisFormset.frmSendInquire.cmdEdit.Enabled=.F.
		ThisFormset.frmSendInquire.cmdSend.Enabled=.F.
		
		RELEASE paQuotesInqNo
		PUBLIC paQuotesInqNo
		
		RELEASE paMarkSendRecordNo
		PUBLIC paMarkSendRecordNo
		
	ENDPROC

