	PROCEDURE frmSources.cmdDeleteSource.Click
		IF This.Caption = "Delete"
			PRIVATE cSCompany
			cSCompany = VendorSources.Company
			IF MESSAGEBOX("Are you sure you want to delete '"+ALLTRIM(cSCompany)+"'"+CHR(13)+"listing for this alloy?",4+32,"Delete?") = 6
				PRIVATE nID_Sources,cAlloy,nVendCode
				nID_Sources = VendorSources.ID_Sources
				cAlloy		= VendorSources.Alloy
				nVendCode	= VendorSources.VendCode
				
				IF nID_Sources > 0
					PRIVATE cSQL, nSQLEXEC
		
					cSQL = "DELETE FROM dbo.Sources"
					cSQL = cSQL + " WHERE ID_Sources = "+STR(nID_Sources)
		
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
					ELSE
						WAIT WINDOW 'Deleted' NOWAIT
						
						ThisFormSet.ShowVendorSources(cAlloy,nVendCode)
						
					ENDIF
				ENDIF
				
			ENDIF
		ELSE
			*Cancel Add/Edit
			ThisFormSet.Show_Sources('RestoreSource')
		ENDIF
	ENDPROC

	PROCEDURE frmSources.cmdDeleteSPH.Click
		IF This.Caption = "Remove"
			PRIVATE cPHCompany
			cPHCompany = ThisForm.txtPHCompany.Value
			IF MESSAGEBOX("Are you sure you want to remove Source PH '"+ALLTRIM(cPHCompany )+"' ?",4+32,"Remove?") = 6
				PRIVATE nID_Sources,nContactID,cAlloy 
				nID_Sources 	= VendorSources.ID_Sources
				nContactID		= PrepareSQLnum( VendorSources.ID, 'ID', -3 )
				cAlloy	 		= VendorSources.Alloy
				
				IF nID_Sources > 0
					PRIVATE cSQL, nSQLEXEC
		
					cSQL = "UPDATE dbo.Sources SET ID = 0"
					cSQL = cSQL + " WHERE ID_Sources = "+STR(nID_Sources)
		
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
					ELSE
						WAIT WINDOW 'Removed Source PH' NOWAIT
						ThisFormSet.ShowVendorSources(cAlloy)
					ENDIF
				ENDIF		
			ENDIF
		ELSE
			*Cancel Add/Edit
			ThisFormSet.Show_Sources('RestoreSource')
		ENDIF
	ENDPROC

	PROCEDURE frmSources.cmdDeleteVC.Click
		IF This.Caption = "Remove"
			PRIVATE cContact
			cContact	= ThisForm.txtContact.Value
		
			IF NOT EMPTY(cContact)
				IF MESSAGEBOX("Are you sure you want to remove Vendor Contact '"+ALLTRIM(cContact)+"' ?",4+32,"Remove?") = 6
					PRIVATE nSphId, nID_Sources,cAlloy 
					nSphId			= VendorSources.ID
					nID_Sources 	= VendorSources.ID_Sources
					cAlloy	 		= VendorSources.Alloy
					
					IF nID_Sources > 0
						PRIVATE cSQL, nSQLEXEC
		
						cSQL = "UPDATE dbo.SourcePH SET ContactID = NULL"
						*cSQL = cSQL + ",VendCode = NULL"
						cSQL = cSQL + " WHERE ID = "+STR(nSphID)
		
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
						ELSE
							WAIT WINDOW 'Removed Default Vendor Contact' NOWAIT
							ThisFormSet.ShowVendorSources(cAlloy)
						ENDIF
					ENDIF		
				ENDIF
			ELSE
				MESSAGEBOX( "No Contact to Remove" )
			ENDIF
		ELSE
			*Cancel Add/Edit
			ThisFormSet.Show_Sources('RestoreSource')
		ENDIF
	ENDPROC

	PROCEDURE frmSources.cmdEditByCompany.Click
		DO FORM Forms\SourceCompany
	ENDPROC

	PROCEDURE frmSources.cmdEditSource.Click
		IF This.Caption = "Edit"
			ThisFormSet.Show_Sources('EditSource')
			This.Caption = "Save"
		ELSE
			*Save
			
			PRIVATE nID_Sources,nSphID,cSCompany,cSAlloy,cSAlloy_AKA,cSUNS,cSSpec
			PRIVATE cNotes,lF10,lF20,lF30,lF40,lF60,lF65,lF70,lF75,lStk,lMK, nVendCode
			
			nID_Sources	= PrepareSQLnum(ThisForm.txtID_Sources.Value,'ID_Sources',-3)
			nSphID		= PrepareSQLnum(ThisForm.txtSphID.Value,'ID',-3)
			cSCompany 	= PrepareSQLtxt(ThisForm.txtSCompany.Value,'Company',30)
			cSAlloy_AKA	= PrepareSQLtxt(ThisForm.txtSAlloy.Value,'Alloy_AKA',12)
			cSAlloy = PrepareSQLtxt(ThisForm.txtSAlloy.Value,'Alloy',12)
			cSUNS	= PrepareSQLtxt(ThisForm.txtSUNS.Value,'UNS',6)
			cSSpec	= PrepareSQLtxt(ThisForm.txtSSpec.Value,'Spec',50)
			cNotes	= PrepareSQLtxt(ThisForm.edtNotes.Value,'Notes',-3)
			lF10	= PrepareSQLlogic(ThisForm.chk10.Value,'F10',.F.)
			lF20	= PrepareSQLlogic(ThisForm.chk20.Value,'F20',.F.)
			lF30	= PrepareSQLlogic(ThisForm.chk30.Value,'F30',.F.)
			lF40	= PrepareSQLlogic(ThisForm.chk40.Value,'F40',.F.)
			lF60	= PrepareSQLlogic(ThisForm.chk60.Value,'F60',.F.)
			lF65	= PrepareSQLlogic(ThisForm.chk65.Value,'F65',.F.)
			lF70	= PrepareSQLlogic(ThisForm.chk70.Value,'F70',.F.)
			lF75	= PrepareSQLlogic(ThisForm.chk75.Value,'F75',.F.)
			lStk	= PrepareSQLlogic(ThisForm.chkStock.Value,'STK',.F.)
			lMK		= PrepareSQLlogic(ThisForm.chkMake.Value,'MK',.F.)
			nVendCode= PrepareSQLnum(ThisForm.txtSVendCode.Value,'VendCode',-3)
			
			PRIVATE cSQL, nSQLEXEC
			DO CASE
			CASE nSphID < 1
				nSphID = -(nSphID)
				ThisForm.txtSphID.Value = nSphID
				*INSERT
				
				cSQL = "INSERT INTO dbo.Sources ("
				cSQL = cSQL + "Alloy,Alloy_AKA,UNS,Spec"
				cSQL = cSQL + ",Notes,F10,F20,F30,F40,F60,F65,F70,F75,Stk,MK,ID"
				cSQL = cSQL + ") VALUES ("
		*		cSQL = cSQL + " '"+cSCompany+"'"
				cSQL = cSQL + " '"+cSAlloy+"'"
				cSQL = cSQL + ",'"+cSAlloy_AKA+"'"
				cSQL = cSQL + ",'"+cSUNS+"'"
				cSQL = cSQL + ",'"+cSSpec+"'"
				cSQL = cSQL + ",'"+cNotes+"'"
				cSQL = cSQL + ","+IIF(lF10,'1','0')
				cSQL = cSQL + ","+IIF(lF20,'1','0')
				cSQL = cSQL + ","+IIF(lF30,'1','0')
				cSQL = cSQL + ","+IIF(lF40,'1','0')
				cSQL = cSQL + ","+IIF(lF60,'1','0')
				cSQL = cSQL + ","+IIF(lF65,'1','0')
				cSQL = cSQL + ","+IIF(lF70,'1','0')
				cSQL = cSQL + ","+IIF(lF75,'1','0')
				cSQL = cSQL + ","+IIF(lStk,'1','0')
				cSQL = cSQL + ","+IIF(lMK,'1','0')
		*		cSQL = cSQL + ","+STR(nVendCode)
				cSQL = cSQL + ","+STR(nSphID)
				cSQL = cSQL + ")"
				
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
				ELSE
					WAIT WINDOW 'Added' NOWAIT
					ThisFormSet.ShowVendorSources(cSAlloy,nVendCode)
		
					SELECT VendorSources
					IF nSphID > 0
						LOCATE FOR ID = nSphID
					ELSE
						IF NOT EMPTY(cSCompany)
							LOCATE FOR Company = cSCompany
						ENDIF
					ENDIF
				ENDIF
				
			CASE nSphID = 0
				*INSERT
				*Do SourcePH First!
				
				IF NOT EMPTY(cSCompany)
					IF nVendCode < 1
						MESSAGEBOX("Cannot save without the Vendor Code "+CHR(13)+"or Matching Company name ID."+CHR(13)+CHR(13)+"Click the Company button to get the right Company ID.",0,"No Save")
						RETURN .F.
					ENDIF
					
					*Insert into SourcePH
					cSQL = "INSERT INTO dbo.SourcePH ("
					cSQL = cSQL + "Company,VendCode"
					cSQL = cSQL + ") VALUES ("
					cSQL = cSQL + " '"+cSCompany+"'"
					cSQL = cSQL + ","+STR(nVendCode)
					cSQL = cSQL + ")"
					
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
		
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
					ELSE
						*Get SourcePH.ID to save to Sources!
						
						IF USED('tmpSPHID')
							USE IN tmpSPHID
						ENDIF
						
						cSQL = "SELECT ID FROM dbo.SourcePH WITH(NOLOCK) WHERE "
						cSQL = cSQL + " Company='"+cCompany+"'"
						cSQL = cSQL + " AND VendCode = "+STR(nVendCode)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSPHID' )
						
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSPHID' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSPHID")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSPHID")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLExecError(cSQL ,gnConnHandle,nSQLEXEC, 'tmpSPHID')
						ENDIF
						IF USED('tmpSPHID')
							IF RECCOUNT() > 0
								nSphID = tmpSPHID.ID
							ENDIF
							USE IN tmpSPHID
						ENDIF
					ENDIF
					
					IF nSphID > 0
						cSQL = "INSERT INTO dbo.Sources ("
						cSQL = cSQL + "Alloy,Alloy_AKA,UNS,Spec"
						cSQL = cSQL + ",Notes,F10,F20,F30,F40,F60,F65,F70,F75,Stk,MK,ID"
						cSQL = cSQL + ") VALUES ("
				*		cSQL = cSQL + " '"+cSCompany+"'"
						cSQL = cSQL + " '"+cSAlloy+"'"
						cSQL = cSQL + ",'"+cSAlloy_AKA+"'"
						cSQL = cSQL + ",'"+cSUNS+"'"
						cSQL = cSQL + ",'"+cSSpec+"'"
						cSQL = cSQL + ",'"+cNotes+"'"
						cSQL = cSQL + ","+IIF(lF10,'1','0')
						cSQL = cSQL + ","+IIF(lF20,'1','0')
						cSQL = cSQL + ","+IIF(lF30,'1','0')
						cSQL = cSQL + ","+IIF(lF40,'1','0')
						cSQL = cSQL + ","+IIF(lF60,'1','0')
						cSQL = cSQL + ","+IIF(lF65,'1','0')
						cSQL = cSQL + ","+IIF(lF70,'1','0')
						cSQL = cSQL + ","+IIF(lF75,'1','0')
						cSQL = cSQL + ","+IIF(lStk,'1','0')
						cSQL = cSQL + ","+IIF(lMK,'1','0')
				*		cSQL = cSQL + ","+STR(nVendCode)
						cSQL = cSQL + ","+STR(nSphID)
						cSQL = cSQL + ")"
						
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF				
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
						ELSE
							WAIT WINDOW 'Added' NOWAIT
							ThisFormSet.ShowVendorSources(cSAlloy,nVendCode)				
							
							SELECT VendorSources
							IF nSphID > 0
								LOCATE FOR ID = nSphID
							ELSE
								IF NOT EMPTY(cSCompany)
									LOCATE FOR Company = cSCompany
								ENDIF
							ENDIF
						ENDIF	
					ENDIF
				ENDIF
			
			CASE nSphID > 1
				*UPDATE
				cSQL = "UPDATE dbo.Sources SET"
		*		cSQL = cSQL + " Company='"+cSCompany+"'"
				cSQL = cSQL + " Alloy='"+cSAlloy+"'"
				cSQL = cSQL + ",Alloy_AKA='"+cSAlloy_AKA+"'"
				cSQL = cSQL + ",UNS='"+cSUNS+"'"
				cSQL = cSQL + ",Spec='"+cSSpec+"'"
				cSQL = cSQL + ",Notes='"+cNotes+"'"
				cSQL = cSQL + ",F10="+IIF(lF10,'1','0')
				cSQL = cSQL + ",F20="+IIF(lF20,'1','0')
				cSQL = cSQL + ",F30="+IIF(lF30,'1','0')
				cSQL = cSQL + ",F40="+IIF(lF40,'1','0')
				cSQL = cSQL + ",F60="+IIF(lF60,'1','0')
				cSQL = cSQL + ",F65="+IIF(lF65,'1','0')
				cSQL = cSQL + ",F70="+IIF(lF70,'1','0')
				cSQL = cSQL + ",F75="+IIF(lF75,'1','0')
				cSQL = cSQL + ",Stk="+IIF(lStk,'1','0')
				cSQL = cSQL + ",MK="+IIF(lMK,'1','0')
		*		cSQL = cSQL + ",VendCode="+STR(nVendCode)
				cSQL = cSQL + " WHERE ID_Sources="+STR(nID_Sources)
				
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
				ELSE
					****
					*UPDATE SourcePH
					cSQL = "UPDATE dbo.SourcePH SET "
					cSQL = cSQL + " Company='"+cSCompany+"'"
					cSQL = cSQL + ",VendCode="+STR(nVendCode)
					cSQL = cSQL + " WHERE ID = "+STR(nSphID)
					
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
					ENDIF
					****
					WAIT WINDOW 'Saved' NOWAIT
					ThisFormSet.ShowVendorSources(cSAlloy,nVendCode)
		
					SELECT VendorSources
					IF nID_Sources > 0
						LOCATE FOR ID_Sources = nID_Sources
					ELSE
						IF NOT EMPTY(cSCompany)
							LOCATE FOR Company = cSCompany
						ENDIF
					ENDIF
								
				ENDIF
			ENDCASE
			
			This.Caption = "Edit"
			ThisFormSet.Show_Sources('RESTORESOURCE')
			ThisForm.grdSources.Refresh
			ThisFormSet.ShowSourceContact()
			
		ENDIF
		
	ENDPROC

	PROCEDURE frmSources.cmdEditSPH.Click
		IF This.Caption = "Edit"
			ThisFormSet.Show_Sources('EditSourcePH')
			This.Caption = "Save"
		ELSE
			*Save
			
			PRIVATE cPHCompany,cPHPerson,cPHPhone,cPHFax,cPHEmail
			nID			= PrepareSQLnum(VendorSources.ID, 'ID',-3)
			cPHCompany	= PrepareSQLtxt(ThisFormSet.frmSources.txtPHCompany.Value,'Company',30)
			cPHPerson	= PrepareSQLtxt(ThisFormSet.frmSources.txtPHPerson.Value,'Person',15)
			cPHPhone	= PrepareSQLtxt(ThisFormSet.frmSources.txtPHPhone.Value,'Phone',10)
			cPHFax		= PrepareSQLtxt(ThisFormSet.frmSources.txtPHFax.Value,'Fax',10)
			cPHEmail	= PrepareSQLtxt(ThisFormSet.frmSources.txtPHEmail.Value,'Email',60)
			
			PRIVATE cAlloy, nVendCode, nID_Sources
			cAlloy		= PrepareSQLtxt( VendorSources.Alloy,'Alloy',12)
			nVendCode	= PrepareSQLnum( VendorSources.VendCode,'VendCode',-3)
			nID_Sources	= PrepareSQLnum( VendorSources.ID_Sources,'ID_Sources',-3) 
			
			PRIVATE cSQL, nSQLEXEC
			
			IF EMPTY(cPHCompany)
				MESSAGEBOX("Please add a Company name to Save!!",0+48,"cannot Save.")
				RETURN .F.
			ENDIF
			IF nID > 0
				cSQL = "UPDATE dbo.SourcePH SET"
				cSQL = cSQL + " Company='"+cPHCompany+"'"
				cSQL = cSQL + ",Person='"+cPHPerson+"'"
				cSQL = cSQL + ",Phone='"+cPHPhone+"'"
				cSQL = cSQL + ",Fax='"+cPHFax+"'"
				cSQL = cSQL + ",Email='"+cPHEmail+"'"
				cSQL = cSQL + " WHERE ID="+STR(nID)
			ELSE
				cSQL = "INSERT INTO dbo.SourcePH "
				cSQL = cSQL + " (Company,Person,Phone,Fax,Email,VendCode) VALUES ("
				cSQL = cSQL + "'"+cPHCompany+"'"
				cSQL = cSQL + ",'"+cPHPerson+"'"
				cSQL = cSQL + ",'"+cPHPhone+"'"
				cSQL = cSQL + ",'"+cPHFax+"'"
				cSQL = cSQL + ",'"+cPHEmail+"'"
				cSQL = cSQL + ","+STR(nVendCode)+")"
			ENDIF		
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
			ELSE
				WAIT WINDOW 'Saved' NOWAIT
				ThisFormSet.ShowVendorSources( cAlloy, nVendCode )
			ENDIF
			
			This.Caption = "Edit"
			ThisFormSet.Show_Sources('RestoreSourcePH')
		ENDIF
	ENDPROC

	PROCEDURE frmSources.cmdEditVC.Click
		IF This.Caption = "Edit"
			ThisFormSet.Show_Sources('EditVendorContact')
			This.Caption = "Save"
		ELSE
			*Save
			PRIVATE nVC_SourcePH_ID,nVC_VendCode,nVC_ID_Sources	
			PRIVATE cVC_Branch,cVC_Company,cVC_Contact,cVC_Phone,cVC_CellPhone,cVC_Email,cVC_Fax
			nVC_ContactID	= PrepareSQLnum(ThisFormSet.frmSources.txtContactID.Value,'ContactID',-3)
			nVC_VendCode	= PrepareSQLnum(ThisFormSet.frmSources.txtSVendCode.Value,'VendCode',-3)
			nVC_ID_Sources	= PrepareSQLnum(ThisFormSet.frmSources.txtSphID.Value,'ID',-3)
			cVC_Branch		= PrepareSQLtxt(ThisFormSet.frmSources.txtBranch.Value,'Branch',30)
			cVC_Company		= PrepareSQLtxt(ThisFormSet.frmSources.txtCompany.Value,'Company',30)
			cVC_Contact		= PrepareSQLtxt(ThisFormSet.frmSources.txtContact.Value,'Contact',30)
			cVC_Phone		= PrepareSQLtxt(ThisFormSet.frmSources.txtPhone.Value,'Phone',20)
			cVC_CellPhone	= PrepareSQLtxt(ThisFormSet.frmSources.txtCellPhone.Value,'CellPhone',20)
			cVC_Email		= PrepareSQLtxt(ThisFormSet.frmSources.txtEmail.Value,'Email',60)
			cVC_Fax			= PrepareSQLtxt(ThisFormSet.frmSources.txtFax.Value,'Fax',20)
		
			IF nVC_VendCode > 0
				PRIVATE cSQL, nSQLEXEC
				IF nVC_ContactID = 0
					*INSERT
					cSQL = "INSERT INTO dbo.VendorContact ("
					cSQL = cSQL + "VendCode,Branch,Company,Contact,Phone,CellPhone,Email,Fax"
					cSQL = cSQL + ") VALUES ("
					cSQL = cSQL + " "+STR(nVC_VendCode)+""
					cSQL = cSQL + ",'"+cVC_Branch+"'"
					cSQL = cSQL + ",'"+cVC_Company+"'"
					cSQL = cSQL + ",'"+cVC_Contact+"'"
					cSQL = cSQL + ",'"+cVC_Phone+"'"
					cSQL = cSQL + ",'"+cVC_CellPhone+"'"
					cSQL = cSQL + ",'"+cVC_Email+"'"
					cSQL = cSQL + ",'"+cVC_Fax+"'"
					cSQL = cSQL + ")"
					
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
					ELSE
						WAIT WINDOW 'Added' NOWAIT
			*			ThisFormSet.ShowVendorSources(cSAlloy)
					ENDIF
				ELSE
					*UPDATE
					cSQL = "UPDATE dbo.VendorContact SET"
					cSQL = cSQL + " Branch='"+cVC_Branch+"'"
					*cSQL = cSQL + ",Company='"+cVC_Company+"'"
					cSQL = cSQL + ",Contact='"+cVC_Contact+"'"
					cSQL = cSQL + ",Phone='"+cVC_Phone+"'"
					cSQL = cSQL + ",CellPhone='"+cVC_CellPhone+"'"
					cSQL = cSQL + ",Email='"+cVC_Email+"'"
					cSQL = cSQL + ",Fax='"+cVC_Fax+"'"
					cSQL = cSQL + " WHERE ContactID="+STR(nContactID)
					
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, gnConnHandle, nSQLEXEC )
					ELSE
						WAIT WINDOW 'Saved' NOWAIT
			*			ThisFormSet.ShowVendorSources(cSAlloy)
					ENDIF
				ENDIF
				
				
		*!*			***************
		*!*			*UPDATE Sources default
		
		*!*			cSQL = "UPDATE dbo.Sources SET"
		*!*			cSQL = cSQL + " ContactID="+STR(nVC_ContactID)
		*!*			cSQL = cSQL + " WHERE ID_Sources="+STR(nVC_ID_Sources)
		*!*			
		*!*			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
		*!*			ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpVendorContact")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpVendorContact")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF
				***************
				This.Caption = "Edit"
				ThisFormSet.Show_Sources('RestoreVendorContact')
			ELSE
				MESSAGEBOX("Need VendCode",48,"Not Saved.")
			ENDIF
		ENDIF
		
	ENDPROC

