					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
		
			IF nSQLEXEC < 0
				SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
			ELSE
		*		IF SQLCOMMIT(gnConnHandle) < 1
		*			SQLExecError("Cannot commit."+CHR(13)+cUpdate,gnConnHandle)
		*		ELSE
					lUpdateViewQuotes = .T.
		*		ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.chkAQPhone_ext.Value = 1
			cUpdate = "UPDATE dbo.AllQuotes SET "
			cUpdate = cUpdate + " Phone_Ext ='"+cPhone_ExtNew+"'"
			cUpdate = cUpdate + " WHERE AllQuotes.Phone_Ext ='"+cPhone_ExtOld+"'"
			cUpdate = cUpdate + " AND AllQuotes.Company ='"+cCompany+"'"
			cUpdate = cUpdate + " AND AllQuotes.Name ='"+cName+"'"
			cUpdate = cUpdate + " AND AllQuotes.CustID ='"+cCustID+"'"
		
			nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
			ELSE
		*		IF SQLCOMMIT(gnConnHandle) < 1
		*			SQLExecError("Cannot commit."+CHR(13)+cUpdate,gnConnHandle)
		*		ELSE
					lUpdateViewQuotes = .T.
		*		ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.chkAQFax.Value = 1
			cUpdate = "UPDATE dbo.AllQuotes SET "
			cUpdate = cUpdate + " Fax ='"+cfaxNew+"'"
			cUpdate = cUpdate + " WHERE AllQuotes.Fax ='"+cFaxOld+"'"
			cUpdate = cUpdate + " AND AllQuotes.Company ='"+cCompany+"'"
			cUpdate = cUpdate + " AND AllQuotes.Name ='"+cName+"'"
			cUpdate = cUpdate + " AND AllQuotes.CustID ='"+cCustID+"'"
		
			nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
			ELSE
		*		IF SQLCOMMIT(gnConnHandle) < 1
		*			SQLExecError("Cannot commit."+CHR(13)+cUpdate,gnConnHandle)
		*		ELSE
					lUpdateViewQuotes = .T.
		*		ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.chkAQEmail.Value = 1
			cUpdate = "UPDATE dbo.AllQuotes SET "
			cUpdate = cUpdate + " Email ='"+cEmailNew+"'"
			cUpdate = cUpdate + " WHERE AllQuotes.Email ='"+cEmailOld+"'"
			cUpdate = cUpdate + " AND AllQuotes.Company ='"+cCompany+"'"
			cUpdate = cUpdate + " AND AllQuotes.Name ='"+cName+"'"
			cUpdate = cUpdate + " AND AllQuotes.CustID ='"+cCustID+"'"
		
			nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
			ELSE
		*		IF SQLCOMMIT(gnConnHandle) < 1
		*			SQLExecError("Cannot commit."+CHR(13)+cUpdate,gnConnHandle)
		*		ELSE
					lUpdateViewQuotes = .T.
		*		ENDIF
			ENDIF
		ENDIF
		
		
		
		
		ThisForm.Visible = .F.
		thisForm.AlwaysOnTop = .F.
		
		IF lUpdateViewQuotes 
			ThisFormSet.RefreshAllQuotes(.T.)
		ENDIF
		
	ENDPROC

