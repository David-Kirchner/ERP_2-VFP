	PROCEDURE QUOTES.pf1.PageSales.cmbCoverSalesP.Destroy
		RELEASE GACover
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.cmbCoverSalesP.GotFocus
		
		This.ColumnCount = ALEN(gaCover,2)
		This.FirstElement  = 1
		This.IncrementalSearch = .F.
		This.NumberOfElements = ALEN(gaCover,1)
		This.RowSource = "gaCover"
		This.RowSourceType = 5
		
		This.Value = Quotes.Cover
		
		This.Refresh
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.cmbCoverSalesP.Init
		PUBLIC ARRAY gaCover(1)
		*DIMENSION gaCover(1)
		*gaCover(1) = " "
		
		IF AppSetup_TopTableofSalesP()
			IF USED('tmpSalesP')
				SELECT tmpSalesP
				SELECT ANS,UN FROM tmpSalesP WHERE ANS != " " INTO ARRAY gaCover
				
				USE IN tmpSalesP
			ENDIF
		ENDIF	
		
		PRIVATE nCoverLen
		nCoverLen = ALEN(gaCover,1)
		DIMENSION gaCover( nCoverLen+1,2 )
		gaCover(nCoverLen+1,1) = " "
		gaCover(nCoverLen+1,2) = "NA"
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.cmbCoverSalesP.Valid
		PRIVATE cCover,cSalesP
		cCover = PrepareSQLtxt(This.Value,'Cover',1,.T.)
		cSalesP = PrepareSQLtxt(Quotes.SalesP,'SalesP',1)
		IF cCover = cSalesP
			cCover = ''
		ENDIF
		
		PRIVATE cUpdate,nSQLEXEC 
		cUpdate = "UPDATE dbo.AllQuotes SET "
		cUpdate = cUpdate + " Cover='"+cCover+"'"
		cUpdate = cUpdate + " WHERE AllQuotes.ID = " + ALLTRIM(STR(Quotes.ID))
		
		nSQLEXEC = SQLEXEC(gnConnHandle,cUpdate)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
		ELSE
			SELECT Quotes
			REPLACE Quotes.Cover WITH cCover
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.cmbCoverSalesP.When
		*IF NOT ThisFormSet.isediting
		*	MESSAGEBOX("Must be in edit mode to edit!",0+64,"Not in edit mode!")
		*ENDIF
		*RETURN ThisFormSet.isediting
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.cmdEditSO.Click
		PRIVATE nNumSN,nFirstRec,nLastRec,nNumRecs
		PRIVATE nSalesnum
		nSalesnum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		nNumSN = 0
		
		IF nSalesNum = 0
			MESSAGEBOX("Sales Number not found",16,"Cannot continue")
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Sales Number not found while salesRep clicked EditSO in Quotes.") 
			RETURN .F.
		ENDIF
		
		gnConnHandle = CheckSQLConnection(gnConnHandle)
		
		IF Find_SOitem00(nSalesnum,gnConnHandle)
			IF Count_ItemsinSales (nSalesNum, gnConnHandle, '') = 1
				*Only one to fix.
				
				*Update AllQuotes
				PRIVATE cSQL, nSQLEXEC, cSOitem
				cSOitem = Proper_SO_item(STR(nSalesnum)+'-01')
				
				Save_SOitem_Status( cSOitem, nSalesNum, 'Edit', 'Corrected Item from -00 to -01', gnConnHandle )
				
				cSQL = "UPDATE dbo.AllQuotes SET Item = 1, SOitem = '"+cSOitem+"'"
				cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesnum)
				cSQL = cSQL + " AND Item = 0 "
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL,gnConnHandle,nSQLEXEC,'')
				ENDIF
				
				*Update Sales	
				cSQL = "UPDATE dbo.Sales SET Item = 1, SOitem = '"+cSOitem+"'"
				cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesnum)
				cSQL = cSQL + " AND Item = 0 "
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL)
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL,gnConnHandle,nSQLEXEC,'')
				ENDIF
				
				**********************************
				*Refresh Quotes
				WAIT WINDOW "Refreshing 'Quotes' table" NOWAIT
		
				IF USED('Quotes')
					USE IN Quotes
				ENDIF
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
				ENDIF
				
			ELSE
				MESSAGEBOX("This Salesnumber has a bad Item=00 "+CHR(13)+"cannot continue.",16,"This needs to be fixed first")
				RETURN .F.
			ENDIF
		ENDIF
		
		
		SELECT Quotes
		
		PRIVATE nOrigRec, nCurInqNum, nCurInqNumP
		nOrigRec = Recno('Quotes')
		nCurInqNum  = Quotes.InqNum
		nCurInqNumP = Quotes.InqNumP
		
		COUNT TO nNumSN FOR SalesNum = nSalesNum 
		IF nNumSN > 0
			SET FILTER TO SalesNum = nSalesNum 
			GO TOP
			nFirstRec = Recno()
			GO BOTTOM
			nLastRec = Recno()
			nNumRecs = (nLastRec - nFirstRec)+1
			
			*FLUSH
			RELEASE compflda
			
			IF USED("AllQuotes")
				USE IN AllQuotes
			ENDIF
			
			DO Form Forms\EditSalesOrder WITH nSalesNum
			
			IF WVISIBLE('frmEO')
		*		MESSAGEBOX( "If you did not just leave the 'Select from Inventory' window,"+;
		*		  CHR(13)+"Tell David that this screen popped up at the wrong time,"+CHR(13)+;
		*		  "and remember what was done before this message appearred."+CHR(13)+CHR(13)+;
		*		  "Thank you for helping debug this program.",32,"frmEO is Visible")
		*		ACTIVATE WINDOW frmEO TOP
				TrackMess( "Quotes12:cmdEditSO:Click WVISIBLE('frmEO')")
			ENDIF
			
			
			IF USED("AllQuotes")
				USE IN AllQuotes
			ENDIF
		
			*Update the view
			WAIT WINDOW "Refreshing 'Quotes' table" NOWAIT
		*	ThisFormSet.Quotes.LockScreen = .T.
			IF USED('Quotes')
				USE IN Quotes
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
			ENDIF
			
			IF USED('Quotes')
				SELECT Quotes
				LOCATE FOR InqNumP = nCurInqNumP
				IF FOUND('Quotes')
					ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
				ELSE
					TrackError ("No Quotes table after DO Form Forms\EditSalesOrder WITH nSalesNum "+STR(nSalesNum)+CHR(13)+gcSQL,"Could not get the 'Quotes' data",PROGRAM(),LINENO(1))
				ENDIF
			ELSE
				MESSAGEBOX('You lost contact with Database',0+16,'Closing down now!')
				TrackError ("No Quotes table after DO Form Forms\EditSalesOrder WITH nSalesNum "+STR(nSalesNum)+CHR(13)+gcSQL,"Could not get the 'Quotes' data",PROGRAM(),LINENO(1))
				CLEAR READ
				RETURN TO MASTER
			ENDIF
			WAIT CLEAR
		*	ThisFormSet.Quotes.LockScreen = .F.		
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.cmdEditSO.When
		IF ThisFormSet.isediting
			WAIT WINDOW "Save first" nowait
			RETURN .F.
		ENDIF
		
		MESSAGEBOX("Only use newest code for Orders"+CHR(13)+"use Quotes21",0+48,"Only use newest code for Orders")
		RETURN .F.
		
		IF NOT USED("Quotes")
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
			ENDIF
			
			SELECT Quotes
			PRIVATE nSalesNum
			nSalesNum = PrepareSQLnum(This.parent.SALESNUM1.Value,'SalesNum',-3)
			*nSalesNum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
			LOCATE FOR SalesNum = nSalesNum
			
		ENDIF
						
		IF VARTYPE(Quotes.Salesnum)!="N"
			WAIT WINDOW "No Sales Number!" NOWAIT
			RETURN .F.
		ELSE
			IF EMPTY(Quotes.Salesnum)
				WAIT WINDOW "No Sales Number!" NOWAIT
				RETURN .F.
			ENDIF
		ENDIF
		
		
	ENDPROC

