	PROCEDURE QUOTES.pf1.PagePricing.ogCutting.opPlasma.Click
		
		ThisFormSet.ShowPricingCutFields()
		
		PRIVATE cForm
		cForm = ThisForm.cmbForm.Value
		
		IF cForm = '80'
			PRIVATE nCalcCutOnlyLotTotal, nCalcLotPriceCut, nCalcPricePerPieceCut, lnPieces, nCalcLotPrice
			
			nCalcLotPriceCut	= PrepareSQLnum(This.parent.parent.CLOTCP1.Value,'CLOTCP',9,2,.T.,.T.) &&Negative,Quite
			nCalcPricePerPieceCut= PrepareSQLnum(This.parent.parent.CP_PCC1.Value,'CP_PCC',9,2,.T.,.T.)
			lnPieces 			= PrepareSQLnum(ThisForm.PIECES1.Value,'Pieces',-3)
			IF lnPieces = 0
				lnPieces = 1
			ENDIF
			nCalcLotPrice	= PrepareSQLnum(This.parent.parent.CLOTP1.Value,'CLOTP',9,2)
			
			***
			ThisFormSet.PlasmaCut('DEFAULT')
			***
			
			nCalcCutOnlyLotTotal = ThisFormset.QUOTES.pf1.PagePricing.CCut1.Value
			nCalcLotPriceCut = nCalcLotPrice + nCalcCutOnlyLotTotal 
			nCalcPricePerPieceCut = nCalcLotPriceCut / lnPieces
			
			This.parent.parent.CLOTCP1.Value	= nCalcLotPriceCut
			This.parent.parent.CP_PCC1.Value	= nCalcPricePerPieceCut
			
		ELSE
			ThisFormSet.PlasmaCut()
		ENDIF
	ENDPROC

