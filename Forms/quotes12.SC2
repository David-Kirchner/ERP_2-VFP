	PROCEDURE frmStartingStock.tempfield.GotFocus
		IF ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"F"
			KEYBOARD '{DNARROW}' CLEAR
		ELSE
			IF ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"B"
				KEYBOARD '{UPARROW}' CLEAR
			ELSE
			***
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmStartingStock.tempfield.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		PRIVATE cOldSelect, cInputValue
		
		cOldSelect = ALIAS()
		cInputValue = This.Value
		ThisFormSet.GotFocusNow = ThisFormSet.MetricGotFocus
		
		Private lnReturnVal
		IF INLIST(nKeyCode, 9, 13, 10, 24, 145, 160 )
			*Down Arrow 24 50 145 160
			*TAB 9
			*ENTER  13 13 10 
			*RIGHT ARROW 4 54 2 
			*Key that makes you go to next object
		
			lnReturnVal = ThisFormSet.ConvertThis(This.Value)
			ThisFormSet.GotFocusLast = ThisFormSet.MetricGotFocus+"F"
			SELECT Quotes
			DO CASE
				CASE ThisFormSet.MetricGotFocus = "ssTHCK1"
					ThisForm.ssTHCK1.Value = lnReturnVal
					ThisFormSet.CalcInv(11)
				CASE ThisFormSet.MetricGotFocus = "ssSZ21"
					ThisForm.ssSZ21.Value = lnReturnVal
					ThisFormSet.CalcInv(12)
				CASE ThisFormSet.MetricGotFocus = "ssSZ31"
					ThisForm.ssSZ31.Value = lnReturnVal
					ThisFormSet.CalcInv(13)
				CASE ThisFormSet.MetricGotFocus = "ssWEIGHT1"
					ThisForm.ssWEIGHT1.Value = lnReturnVal
					
		*			IF Quotes.Form = "51" OR Quotes.Form = "20" 
		*				REPLACE Quotes.Sz3 WITH lnReturnVal
		*				ThisForm.ssSZ31.Refresh
		*			ENDIF
			ENDCASE
			This.Value = '`'
			IF !EMPTY(cOldSelect)
				IF USED(cOldSelect)
					SELECT (cOldSelect)
				ENDIF
			ENDIF
		ENDIF
		
		IF INLIST(nKeyCode, 15, 5, 141, 152)
			ThisFormSet.GotFocusLast = ThisFormSet.MetricGotFocus+"B"
			*Keys that make you goto PREV object
			*TAB Shift 15
			*left 19 52 26 
			*up 5 56 141 152 
			lnReturnVal = ThisFormSet.ConvertThis(This.Value)	
			
			DO CASE
				CASE ThisFormSet.MetricGotFocus = "ssTHCK1"
					ThisForm.ssTHCK1.Value = lnReturnVal
					ThisForm.ssTHCK1.refresh()
					ThisFormSet.CalcInv(11)
				CASE ThisFormSet.MetricGotFocus = "ssSZ21"
					ThisForm.ssSZ21.Value = lnReturnVal
					ThisForm.ssSZ21.refresh()
					ThisFormSet.CalcInv(12)
				CASE ThisFormSet.MetricGotFocus = "ssSZ31"
					ThisForm.ssSZ31.Value = lnReturnVal
					ThisForm.ssSZ31.refresh()
					ThisFormSet.CalcInv(13)
				CASE ThisFormSet.MetricGotFocus = "ssWEIGHT1"
					ThisForm.ssWEIGHT1.Value = lnReturnVal
					ThisForm.ssWEIGHT1.refresh()
			ENDCASE
			This.Value = '`'
		ENDIF
		
	ENDPROC

	PROCEDURE frmStartingStock.tempfield.LostFocus
		IF This.Value="`"
			This.Value = ''
		ELSE
		*IF NOT EMPTY(ALLTRIM(This.Value))
			PRIVATE lnReturnVal 
			lnReturnVal = ThisFormSet.ConvertThis(This.Value)
		*	ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"F"
		*	ThisFormSet.GotFocusNow = ThisFormSet.MetricGotFocus
			DO CASE
				CASE ThisFormSet.GotFocusNow = "THCK1"
					ThisForm.THCK1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "SZ21"
					ThisForm.SZ21.Value = lnReturnVal
					ThisFormSet.CalcInv(2)
				CASE ThisFormSet.GotFocusNow = "SZ31"
					ThisForm.SZ31.Value = lnReturnVal
					ThisFormSet.CalcInv(3)
				CASE ThisFormSet.GotFocusNow = "WEIGHT1"
					ThisForm.WEIGHT1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "P_LB1"
					ThisForm.P_LB1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "P_PC1"
					ThisForm.P_PC1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "P_FT1"
					ThisForm.P_FT1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "CUTS1"
					ThisForm.CUTS1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "OtherP1"
					ThisForm.OtherP1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "LOTP1"
					ThisForm.LOTP1.Value = lnReturnVal
			ENDCASE
			This.Value = ''
		ENDIF
		
		ThisFormSet.GotFocusNow = ''
		
		This.Visible = .F.
		
	ENDPROC

	PROCEDURE frmStockLst_Sum.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ISNULL(inActive,0) = 0"
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		
		*THIS.VALUE = "(All Employees)"
		*This.Value = "*"
		This.Value = "1"
		
	ENDPROC

	PROCEDURE frmStockLst_Sum.cmbCC.InteractiveChange
		ThisFormSet.StockLst_Sum_Reload('NewCC')
	ENDPROC

	PROCEDURE frmStockLst_Sum.cmbCL.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel WITH(NOLOCK) "
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionLevel")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "ConditionLevel")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			cCL1 = ''
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Value = cCL1
	ENDPROC

