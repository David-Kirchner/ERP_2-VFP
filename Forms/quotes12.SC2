	PROCEDURE QUOTES.pf1.PageOutSource.pgFrmSources.pgSourceUsed.cmdRFQ.Click
		PRIVATE cvAlloy,cvForm, Zform, cTitle
		cvAlloy = PrepareSQLtxt(Quotes.Alloy ,'Alloy',12)
		cvForm  = PrepareSQLtxt(Quotes.Form,'Form',2)
		
		Zform = ""
		*DO FormDescription IN PROC_Quotes WITH cvForm , Zform
		Zform = FormDescription(cvForm,Quotes.Thck)
		
		cTitle = "Report for Alloy: "+ALLTRIM(cvAlloy)+" and Form: "+ALLTRIM(Zform)
		
		
		IF USED('vSupplierQ')
			USE IN vSupplierQ
		ENDIF
		
		mSQL = "SELECT Supplier,Contact,Notes,UnitPrice,Quantity,PcPrice,DueDate,SaveDate,INQnumP,Alloy,Form,CC,CL,Thck,Sz2,Sz3"
		mSQL = mSQL +"  FROM dbo.SupplierQuotes WITH(NOLOCK) WHERE"
		mSQL = mSQL +" ALLOY='" + cvAlloy + "'"
		mSQL = mSQL +" AND Form='" + cvForm + "'"
		*	mSQL = mSQL +" AND THCK>=" + STR(Quotes.THCK - .05 ,9,4) + " AND THCK<=" + STR(Quotes.THCK + .05 ,9,4)
		mSQL = mSQL +" ORDER BY Thck DESC"
		
		SELECT 0
		nSQLEXEC = SQLEXEC( gnConnHandle, mSQL, 'vSupplierQ')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, mSQL, 'vSupplierQ')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, mSQL, "vSupplierQ")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, mSQL, "vSupplierQ")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError(mSQL, gnConnHandle, nSQLEXEC, 'vSupplierQ')
		ENDIF
		**************************
		IF USED('vSupplierQ')
			IF RECCOUNT('vSupplierQ') > 0
				IF VAL(cvForm) > 50
					BROWSE Fields Thck,Sz2,Sz3,Supplier,Contact,unitPrice,Quantity,PcPrice,DueDate,SaveDate IN SCREEN TITLE (cTitle)
				ELSE
					BROWSE Fields Thck,Supplier,Contact,unitPrice,Quantity,PcPrice,DueDate,SaveDate IN SCREEN TITLE (cTitle)
				ENDIF
			ELSE
				=MESSAGEBOX("No records",0+48,"Empty!")
			ENDIF
			
			USE IN vSupplierQ
		ENDIF
		
		SELECT Quotes
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageOutSource.pgFrmSources.pgSourceUsed.cmdRFQAdd.Click
		ThisFormset.frmRFQ.lblID.Caption = '0'
		ThisFormset.frmRFQ.txtSupplier.Value = ''
		ThisFormset.frmRFQ.txtContact.Value = ''
		ThisFormset.frmRFQ.txtNotes.Value = ''
		ThisFormset.frmRFQ.txtUnitPrice.Value = 0
		ThisFormset.frmRFQ.txtQuantity.Value = Quotes.Q_QTY
		ThisFormset.frmRFQ.txtPcPrice.Value = 0
		ThisFormset.frmRFQ.txtDueDate.Value = DATE()
		
		ThisFormSet.frmRFQ.AlwaysOnTop = .T.
		ThisFormSet.frmRFQ.Visible = .T.
		ThisFormSet.frmRFQ.AlwaysOnTop = .F.
		ThisFormset.frmRFQ.lblID.Visible = .F.
		
		ThisFormset.frmRFQ.txtSupplier.SetFocus
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageOutSource.pgFrmSources.pgSourceUsed.cmdRFQDelete.Click
		IF USED('SupplierQuotes')
			IF RECCOUNT('SupplierQuotes') > 0
				PRIVATE nID
				nID = SupplierQuotes.ID
				
				IF nID > 0
					PRIVATE mSQL, nSQLEXEC 
				
					mSQL = "DELETE FROM dbo.SupplierQuotes WHERE"
					mSQL = mSQL +" ID = " + STR( nID )
			
					nSQLEXEC = SQLEXEC( gnConnHandle, mSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, mSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, mSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, mSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLExecError( mSQL, gnConnHandle, nSQLEXEC )
					ENDIF
				
				ENDIF
			ENDIF
		ENDIF
		ThisFormSet.ShowSources()
		*ThisFormSet.QuotesRecordChanged()
	ENDPROC

	PROCEDURE QUOTES.pf1.PageOutSource.pgFrmSources.pgSourceUsed.cmdRFQEdit.Click
		*IF USED('SupplierQuotes')
			ThisFormset.frmRFQ.lblID.Caption 	  = STR(SupplierQuotes.ID)
			ThisFormset.frmRFQ.txtSupplier.Value  = SupplierQuotes.Supplier
			ThisFormset.frmRFQ.txtContact.Value   = SupplierQuotes.Contact
			ThisFormset.frmRFQ.txtNotes.Value 	  = ShowSQLtxt(SupplierQuotes.Notes,'Notes',30)
			IF ThisFormset.frmRFQ.txtNotes.Value="ComputerAd"
				ThisFormset.frmRFQ.txtNotes.Value = " "
			ENDIF
			ThisFormset.frmRFQ.txtUnitPrice.Value = SupplierQuotes.UnitPrice
			IF PrepareSQLnum(SupplierQuotes.Quantity,'Quantity',-5) > 0
				ThisFormset.frmRFQ.txtQuantity.Value  = SupplierQuotes.Quantity
			ELSE
				ThisFormset.frmRFQ.txtQuantity.Value  = Quotes.Q_Qty
			ENDIF
			ThisFormset.frmRFQ.txtPcPrice.Value = SupplierQuotes.PcPrice
			IF ISNULL(SupplierQuotes.DueDate)
				ThisFormset.frmRFQ.txtDueDate.Value = DATE()
			ENDIF
			IF EMPTY(SupplierQuotes.DueDate)
				ThisFormset.frmRFQ.txtDueDate.Value = DATE()
			ELSE
				ThisFormset.frmRFQ.txtDueDate.Value = SupplierQuotes.DueDate
			ENDIF
			ThisFormSet.frmRFQ.AlwaysOnTop = .T.
			ThisFormSet.frmRFQ.Visible = .T.
			ThisFormSet.frmRFQ.AlwaysOnTop = .F.
			ThisFormset.frmRFQ.lblID.Visible = .T.
			
			ThisFormset.frmRFQ.txtSupplier.SetFocus
		*ELSE
		*	MESSAGEBOX("Cannot Edit",0+48,'No data'))
		*ENDIF
		
	ENDPROC

