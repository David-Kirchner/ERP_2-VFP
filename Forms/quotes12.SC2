	PROCEDURE QUOTES.OtherFLD1.Valid
		*cOtherFld		= PrepareSQLtxt(ThisFormSet.Quotes.OtherFld1.Value,'OtherFld',10)
		*nQ_P		= Get_Qoute_P(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
		*Get_Quote_Pricing(nPieces,cAlloy,cForm,nThck,nSz2,nSz3,nWeight,nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP, gnConnHandle)
		*nQ_QTY		= Calc_QTY(cAlloy,cForm,nPieces,nThck,nSz2,nSz3,cOtherFld,gnConnHandle )
		
		
		*ThisFormSet.CheckPU_Quoted()
		PRIVATE cOtherFld
		cOtherFld = PrepareSQLtxt(This.Value,'OtherFLD',10)
		
		PRIVATE nQ_PU, cQ_PU 
		DO CASE
		CASE UPPER(cOtherFld) = "PER MR" OR UPPER(cOtherFld) = "PER MTR"
			nQ_PU = 7
			cQ_PU = "$/Mtr"
		CASE UPPER(cOtherFld) = "PER KG"
			nQ_PU = 6
			cQ_PU = "$/Kg"
		CASE UPPER(cOtherFld) = "PER INCH"
			nQ_PU = 5
			cQ_PU = "$/In"
		CASE UPPER(cOtherFld) = "PER FT"
			nQ_PU = 2
			cQ_PU = "$/Ft"
		CASE "$/FT" $ UPPER(cOtherFld)
		CASE "$/PC" $ UPPER(cOtherFld)
		CASE "$/MT" $ UPPER(cOtherFld)
		CASE "$/KG" $ UPPER(cOtherFld)
		CASE "$/IN" $ UPPER(cOtherFld)
		CASE "PER " $ UPPER(cOtherFld)
			MESSAGEBOX("your entry looks like it could be $/Inch or simulair, but the cumputer cannot tell. Please use a standard",64,"Not a standard entry.")
		CASE "$/"	$ UPPER(cOtherFld)
			MESSAGEBOX("your entry looks like it could be $/Inch or simulair, but the cumputer cannot tell. Please use a standard",64,"Not a standard entry.")
		OTHERWISE 
			 
		ENDCASE
		
			
			
	ENDPROC

