		ThisFormSet.BlankBackColorCutting()
		This.BackColor = RGB(255,255,128)
	ENDPROC

	PROCEDURE QUOTES.ALLOY1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		IF lnInsertionPt = 11
			*Having Trouble with the last character.
			lnFakeInsertionPt = 12
		ELSE
			lnFakeInsertionPt = lnInsertionPt 
		ENDIF
		
		*lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnFakeInsertionPt)
		lcTryAlloy  = ''
		
		*IF LEN(lcSearchStr)>=11
		*	WAIT WINDOW '12 Char' 
		*ENDIF
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, gnConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE QUOTES.ALLOY1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE QUOTES.ALLOY1.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pCurAlloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy,  gnConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
			
				ThisFormSet.CheckCompanyAlloyDuplicate(cAlloyStandard)
				
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				MESSAGEBOX("Alloy '"+pCurAlloy+"' is unknown."+CHR(13)+"Use HPA Menu 'Quotes/Alloys Standard' program to add a new Alloy."+CHR(13)+"You cannot move off this Alloy field with this value"+CHR(13)+"Blank the Alloy or type 'Plastic', 'Steel' or 'MISC'",0+64,"Unkown Alloy.")
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE QUOTES.ALLOY1.When
		IF ThisFormSet.isediting
			ThisFormSet.MetricGOTFocus  = "ALLOY1"
			ThisFormSet.GOTFocusLast  = "ALLOY1"
		ENDIF
		RETURN ThisFormSet.isediting
	ENDPROC

	PROCEDURE QUOTES.cboTgq82.GotFocus
		ThisFormSet.MetricGOTFocus  = "cboTqg82"
	ENDPROC

	PROCEDURE QUOTES.cboTgq82.Valid
		PRIVATE currec
		SELECT Quotes
		currec = RECNO()
		DO CASE
		CASE tgQ  = 1 &&"Record#"
			SET ORDER TO
		CASE tgQ  = 2 &&"Inquire#
			INDEX ON InqNum TAG InqNum
			SET ORDER TO InqNum	
		CASE tgQ  = 3 &&"InqDate
			INDEX ON InqDate TAG Inqdate
			SET ORDER TO InqDate
			
		CASE tgQ  = 4 &&"Company"
			INDEX ON Company TAG Company
			SET ORDER TO Company
		CASE tgQ  = 5 &&"Name"
			INDEX ON Name TAG Name
			SET ORDER TO Name
		CASE tgQ  = 6 &&"Sales #"
			INDEX ON Salesnum TAG Salesnum
			SET ORDER TO Salesnum
		CASE tgQ  = 7 &&"PO #"
			INDEX ON PO_Num TAG PO_Num
			SET ORDER TO PO_Num
		CASE tgQ  = 8 &&"Alloy"
			INDEX ON Alloy TAG Alloy
			SET ORDER TO Alloy
		CASE tgQ  = 9 &&"opened"
			INDEX ON OPEN_ TAG OPEN_
			SET ORDER TO OPEN_
		OTHERWISE
			SET ORDER TO
		ENDCASE
		
		GOTO currec
		
	ENDPROC

	PROCEDURE QUOTES.cboTgq82.When
		RETURN !ThisFormSet.isediting
	ENDPROC

