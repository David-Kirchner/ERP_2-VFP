	PROCEDURE dec2frac		&& Decimal to Fraction conversion.
		PARAMETER RNUMBER
		PRIVATE WNUMBER, RNUMBER, XNUMBER, NNUMBER, YNUMBER, SNUMBER
		***dec2frac(
		WNUMBER = INT(RNUMBER)
		XNUMBER = RNUMBER - WNUMBER
		NNUMBER = IIF(WNUMBER=0, '', ALLTRIM(STR(WNUMBER,10,0))+"-")
		
		
		DO CASE
		CASE XNUMBER = .064
			YNUMBER = '1/16'
		CASE XNUMBER = .125
			YNUMBER = '1/8'
		CASE XNUMBER = .187
			YNUMBER = '3/16'
		CASE XNUMBER = .25
			YNUMBER = '1/4'
		CASE XNUMBER = .312
			YNUMBER = '5/16'
		CASE XNUMBER = .375
			YNUMBER = '3/8'
		CASE XNUMBER = .437
			YNUMBER = '7/16'
		CASE XNUMBER = .5
			YNUMBER = '1/2'
		CASE XNUMBER = .562
			YNUMBER = '9/16'
		CASE XNUMBER = .625
			YNUMBER = '5/8'
		CASE XNUMBER = .687
			YNUMBER = '11/16'
		CASE XNUMBER = .75
			YNUMBER = '3/4'
		CASE XNUMBER = .812
			YNUMBER = '13/16'
		CASE XNUMBER = .875
			YNUMBER = '7/8'
		CASE XNUMBER = .937
			YNUMBER = '15/16'
		OTHERWISE
			SNUMBER = remove0(RNUMBER,10,3,.F.)
			RETURN SNUMBER
		ENDCASE
		
		SNUMBER = NNUMBER+YNUMBER
		*WAIT WINDOW SNUMBER NOWAIT
		RETURN SNUMBER
		
		
	ENDPROC

