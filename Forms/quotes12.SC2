	PROCEDURE frmSendInquire.cmdSeeCerts.Valid
		*+
		PRIVATE cAlloy,cForm,nThck,cHeat,cLot,nID,nConn
		IF USED('Quotes')
			cAlloy	= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
			cForm	= PrepareSQLtxt(Quotes.Form,'Form',2)
			nThck	= PrepareSQLnum(Quotes.Thck,'Thck',9,3)
		ELSE
			cAlloy	= ''
			cForm	= ''
			nThck	= 0
		ENDIF
		
		cHeat	= ''
		cLot	= ''
		nConn	= gnConnHandle
		nID		= 0
			
		PRIVATE lAlwaysOnTop
		lAlwaysOnTop = ThisForm.AlwaysOnTop 
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .F.
		ENDIF
		
		IF MESSAGEBOX("Do you want to use the new Scanned MTR screen?"+CHR(13)+"Answer No to view Recollect",4+32,"MTR")=6
			DO FORM "forms\MTR.scx" WITH cALLOY,cForm,nThck,cHeat,cLot,nID,nConn
		ELSE
			DO FORM "forms\Recollect_Certs.scx" WITH cALLOY,cForm,nThck,cHeat,cLot,nID,nConn
		ENDIF
		
		IF lAlwaysOnTop
			ThisForm.AlwaysOnTop = .T.
		ENDIF
		
	ENDPROC

	PROCEDURE frmSendInquire.cmdSend.Click
		*DODEFAULT( )
		
		**Get Alloy
		cInqAlloy = ""
		IF FILE("Quotes\Forms\ChooseAlloySources.SCX")
			DO FORM "Quotes\Forms\ChooseAlloySources.SCX" WITH Quotes.alloy TO cInqAlloy
		ELSE
			DO FORM Forms\ChooseAlloySources WITH Quotes.alloy TO cInqAlloy
		ENDIF
		
		
		IF VARTYPE(cInqAlloy) <> "C"
			cInqAlloy = " "
		ENDIF
		
		
		
		*******************************************
		*Send Inquire
		
		*DO FORM Forms\SelectSendInq WITH cInqAlloy, paQuotesInqNo, Quotes.SalesP
		ThisFormSet.SelectSendinq_reload( cInqAlloy )
		
		*DO FORM Forms\GatherSend
		
		*******************************************
		
		
		
		IF USED("TmpQuoteM")
			USE IN TmpQuoteM
		ENDIF
		
		PRIVATE cSQLu, cCurrTable
		cCurrTable = DBF()
		SELECT 0
		
		cSQLu = "SELECT QuoteMemo FROM dbo.AllQuotes "
		cSQLu = cSQLu+ " WHERE AllQuotes.ID = " + ALLTRIM(STR(Quotes.ID))
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "TmpQuoteM")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu, "TmpQuoteM")
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "TmpQuoteM")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "TmpQuoteM")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQLu,gnConnHandle,nSQLEXEC, "TmpQuoteM")
		ENDIF
		
		IF USED("TmpQuoteM")
			IF !EMPTY(tmpQuoteM.QuoteMemo)
				ThisFormset.QUOTES.pf1.PageQuote.edtQuoteMemo.Value = tmpQuoteM.QuoteMemo
				ThisFormset.QUOTES.pf1.PageQuote.edtQuoteMemo.Refresh
			ENDIF
			USE IN TmpQuoteM
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()  &&DO FORM Forms\GatherSend 
		
		IF !EMPTY(cCurrTable)
			IF USED(cCurrTable)
				SELECT (cCurrTable)
			ENDIF
		ENDIF
	ENDPROC

