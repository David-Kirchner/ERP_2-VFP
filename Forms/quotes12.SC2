	PROCEDURE frmSalesP_Customer.cmdEdit.Click
		PRIVATE nSalesNum, nSoldAddr, cSalesP
		nSalesNum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		nSoldAddr = 0
		cSalesP = PrepareSQLtxt(Quotes.SalesP,'SalesP',1)
		
		PRIVATE cCompany, cCustID
		cCompany = PrepareSQLtxt(Quotes.Company,'Company',30)
		cCustID	 = PrepareSQLtxt(Quotes.CustID,'CustID',20)
			
		
		IF nSalesNum > 0
			IF USED('tmpSalesNAddr')
				USE IN tmpSalesNAddr
			ENDIF
			
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT pSoldAddr FROM dbo.Sales_No WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSalesNAddr')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSalesNAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesNAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesNAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSalesNAddr')
			ENDIF
			IF USED('tmpSalesNAddr')
				IF RECCOUNT('tmpSalesNAddr') > 0
					nSoldAddr = tmpSalesNAddr.pSoldAddr 
				ENDIF
				USE IN tmpSalesNAddr
			ENDIF
		ENDIF
		
		IF nSoldAddr > 0
			DO FORM Forms\SalesP_Customer WITH nSoldAddr, cSalesP, cCompany, cCustID
			
			ThisFormSet.Refreshsalesp_customer()
			
		ELSE
			MESSAGEBOX("Edit After this record is an ORDER.",46,"No Sold to Address.")
		ENDIF
		
	ENDPROC

	PROCEDURE frmSearchSources.cmdOK.Click
		PRIVATE cSQL, nSQLEXEC
		
		PRIVATE cAlloy, cUNS
		cAlloy = ALLTRIM(ThisForm.txtAlloy.VALUE)
		
		
		IF ThisForm.chkAutoAlloy.Value 
			IF UPPER(LEFT(ALLTRIM(cAlloy),3)) = "UNS"
				m.IAA = ALLTRIM(cAlloy)
				cUNS = UPPER(RIGHT(M.IAA,LEN(M.IAA)-4))
		
				*SEEK M.SUNS ORDER TAG UNS IN Sources
				*LOCATE FOR cUNS$UNS
				cSQL = "SELECT Alloy FROM dbo.Sources WITH(NOLOCK) WHERE UNS = '"+cUNS+"'"
				
				IF USED("UnsSources")
					SELECT UnsSources
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'UnsSources')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL , 'UnsSources')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "UnsSources")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "UnsSources")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'UnsSources')
				ENDIF
		
				IF USED('UnsSources')
					IF VARTYPE(UnsSources.Alloy) = "C"
						cAlloy = UnsSources.Alloy
					ELSE
						WAIT WINDOW 'UNS not found!!!!!!' NOWAIT
					ENDIF
					USE IN UnsSources
				ELSE
					WAIT WINDOW 'UNS not found!!!!!!' NOWAIT
				ENDIF
				
			ENDIF
		
			IF UPPER(LEFT(ALLTRIM(cAlloy),4)) = "SPEC"
				m.IAA = UPPER(ALLTRIM(cAlloy))
				cUNS = RIGHT(M.IAA,LEN(M.IAA)-5)
		
				*LOCATE FOR cUNS$SPEC
				cSQL = "SELECT Alloy FROM dbo.Sources WITH(NOLOCK) WHERE SPEC LIKE '%"+cUNS+"%'"
				
				IF USED("SpecSources")
					SELECT SpecSources
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'SpecSources')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL , 'SpecSources')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "SpecSources")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "SpecSources")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'SpecSources')
				ENDIF
		
				IF USED('SpecSources')
					IF VARTYPE(SpecSources.Alloy) = "C"
						cAlloy = SpecSources.Alloy
					ELSE
						WAIT WINDOW 'SPECIFICATION not found!!!!!!' NOWAIT
					ENDIF
				
					USE IN SpecSources
				ELSE
					WAIT WINDOW 'SPECIFICATION not found!!!!!!' NOWAIT
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.Visible = .F.
		
		*IF MESSAGEBOX("Do you want to try the new VendorSources? (Y)",4+64+256,"Try new") = 6
			ThisFormSet.ShowVendorSources(cAlloy)
		*ELSE
		
		
		*!*	cSQL = "SELECT Sources.Company,Alloy,Alloy_AKA,UNS,Spec,f10,f20,f30,f40,f60,f65,f70,f75,Stk,MK,Sources.Notes,Sourceph.Company,Phone,Fax,Person,Email "
		*!*	cSQL = cSQL + " FROM dbo.sources, dbo.sourceph "
		*!*	cSQL = cSQL + " WHERE Sources.ID = Sourceph.ID "
		*!*	cSQL = cSQL + " AND Sources.Alloy = '"+cAlloy+"'"
		*!*	cSQL = cSQL + " ORDER BY Sources.alloy, Sources.company"
		
		*ENDIF
		
		
	ENDPROC

