	PROCEDURE frmQA.cmdSignQA.Click
		PRIVATE nQuote_No_ID 
		nQuote_No_ID = PrepareSQLnum(ThisForm.txtQuote_No_ID.Value,"Quote_No",-3)
		
		PRIVATE nRevision, lProdReqDefine, lDiffResolved, lHPAcapable, dExpireDate, cComments
		
		nRevision		= PrepareSQLnum(ThisForm.txtQuote_NoRev.Value,'Revision',-2)
		dExpireDate		= PrepareSQLdate(ThisForm.txtExpireDate.Value,'ExpireDate')
		lProdReqDefine	= PrepareSQLlogic(ThisForm.chkProdReqDefine.Value,'ProdReqDefine',.F.)
		lDiffResolved	= PrepareSQLlogic(ThisForm.chkDiffResolved.Value,'ProdReqDefine',.F.)
		lHPAcapable		= PrepareSQLlogic(ThisForm.chkHPAcapable.Value,'HPAcapable',.F.)
		cComments		= PrepareSQLtxt(ThisForm.txtComments.Value,'Comments',100)
		
		nRevision = nRevision + 1
		
		*!*	IF EMPTY(dExpireDate)
		*!*		MESSAGEBOX("Please enter a 'Quote Expite Date'"+CHR(13)+"10 days from today has been entered",0+48,"Expire Date error.")
		*!*		ThisForm.txtExpireDate.Value = DATE()+10
		*!*		RETURN .F.
		*!*	ENDIF
		
		IF nQuote_No_ID > 0
			PRIVATE cSQL, nSQLEXEC 
			IF USED("tmpQuote_No")
				USE IN tmpQuote_No
			ENDIF
		
			SELECT 0
			cSQL = "UPDATE [dbo].[Quote_No] SET "
			cSQL = cSQL + " Revision = "+STR(nRevision)
			cSQL = cSQL + ",ExpireDate = '"+IIF(EMPTY(dExpireDate),'',DTOC(dExpireDate))+"'"
			cSQL = cSQL + ",ProdReqDefine = '"+IIF(lProdReqDefine,'1','0')+"'"
			cSQL = cSQL + ",DiffResolved = '"+IIF(lDiffResolved,'1','0')+"'"
			cSQL = cSQL + ",HPAcapable = '"+IIF(lHPAcapable,'1','0')+"'"
			cSQL = cSQL + ",Comments ='"+cComments+"'"
			cSQL = cSQL + ",LastEdit = GetDate()"
			cSQL = cSQL + " WHERE ID = "+STR(nQuote_No_ID)
		
		
		
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle,nSQLEXEC )
			ENDIF
		
		ENDIF
		
		
		
		ThisForm.Visible = .F.
	ENDPROC

