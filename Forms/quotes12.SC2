	PROCEDURE QUOTES.tempfield.GotFocus
		IF ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"F"
			KEYBOARD '{DNARROW}' CLEAR
		ELSE
			IF ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"B"
				KEYBOARD '{UPARROW}' CLEAR
			ELSE
			***
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.tempfield.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		PRIVATE cOldSelect, cInputValue
		
		cOldSelect = ALIAS()
		cInputValue = This.Value
		ThisFormSet.GotFocusNow = ThisFormSet.MetricGotFocus
		
		Private lnReturnVal
		IF INLIST(nKeyCode, 9, 13, 10, 24, 145, 160 )
			*Down Arrow 24 50 145 160
			*TAB 9
			*ENTER  13 13 10 
			*RIGHT ARROW 4 54 2 
			*Key that makes you go to next object
		
			lnReturnVal = ThisFormSet.ConvertThis(cInputValue)
			ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"F"
			SELECT Quotes
			DO CASE
				CASE ThisFormSet.MetricGotFocus = "THCK1"
					IF EMPTY(Quotes.Sz1Orig)
						REPLACE Quotes.Sz1Orig WITH cInputValue IN Quotes
					ELSE 
		*				IF PrepareSQLlogic(Quotes.Metric,'Metric',.F.)
							IF "M" $ UPPER(cInputValue)
								REPLACE Quotes.Sz1Orig WITH cInputValue IN Quotes
								REPLACE Quotes.Metric WITH .T. IN Quotes
		*					ELSE
		*						*Keep the Metric Equal
		*						cMetricValue = "Near "
		*						REPLACE Quotes.Sz1Orig WITH cMetricValue IN Quotes
							ENDIF
		*				ENDIF
					ENDIF
					ThisForm.THCK1.Value = lnReturnVal
					
		*			ThisFormSet.QUOTES.pf1.PageQA.Sz1Orig.Refresh
		*			ThisFormSet.QUOTES.chkMetric.Refresh
					
				CASE ThisFormSet.MetricGotFocus = "SZ21"
					IF EMPTY(Quotes.Sz2Orig)
						REPLACE Quotes.Sz2Orig WITH cInputValue IN Quotes
					ELSE 
						IF "M" $ UPPER(cInputValue)
							Replace Quotes.Sz2Orig WITH cInputValue IN Quotes 
							REPLACE Quotes.Metric WITH .T. IN Quotes
						ENDIF
					ENDIF
					
					PRIVATE cForm
					cForm = PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
					IF isLBSonSZ2( cForm,gnConnHandle )
						REPLACE Quotes.Weight WITH lnReturnVal*PrepareSQLnum(Quotes.Pieces,'Pieces',7,0) IN Quotes
						ThisForm.Weight1.Refresh
					ENDIF
		
					ThisForm.SZ21.Value = lnReturnVal
					ThisFormSet.CalcInv(2)
					
		*			ThisFormSet.QUOTES.pf1.PageQA.Sz2Orig
		*			ThisFormSet.QUOTES.chkMetric.Refresh
					
				CASE ThisFormSet.MetricGotFocus = "SZ31"
					IF EMPTY(Quotes.Sz3Orig)
						REPLACE Quotes.Sz3Orig WITH cInputValue IN Quotes
					ELSE 
						IF "M" $ UPPER(cInputValue)
							Replace Quotes.Sz3Orig WITH cInputValue IN Quotes 
							REPLACE Quotes.Metric WITH .T. IN Quotes
						ENDIF
					ENDIF
					ThisForm.SZ31.Value = lnReturnVal
					
					PRIVATE cForm
					cForm = PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
					IF isLBSonSZ3( cForm,gnConnHandle )
					*IF Quotes.Form = "51" OR Quotes.Form = "20" 
						REPLACE Quotes.Weight WITH lnReturnVal*PrepareSQLnum(Quotes.Pieces,'Pieces',7,0) IN Quotes
						ThisForm.Weight1.Refresh
					ENDIF
					ThisFormSet.CalcInv(3)
								
		*			ThisFormSet.QUOTES.pf1.PageQA.Sz3Orig.Refresh
		*			ThisFormSet.QUOTES.chkMetric.Refresh
					
				CASE ThisFormSet.MetricGotFocus = "WEIGHT1"
					ThisForm.WEIGHT1.Value = lnReturnVal
					
					PRIVATE cForm
					cForm = PrepareSQLtxt(ThisForm.cmbForm.Value,'Form',2)
					IF isLBSonSZ2( cForm,gnConnHandle )
						REPLACE Quotes.Weight WITH lnReturnVal IN Quotes
						lnPieces = PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
						IF lnPieces < 1
							lnPieces = 1
						ENDIF
						REPLACE Quotes.Sz2 WITH lnReturnVal / lnPieces IN Quotes
						ThisForm.SZ21.Refresh
					ENDIF
					IF isLBSonSZ3( cForm,gnConnHandle )
						REPLACE Quotes.Weight WITH lnReturnVal IN Quotes
						lnPieces = PrepareSQLnum(Quotes.Pieces,'Pieces',7,0)
						IF lnPieces < 1
							lnPieces = 1
						ENDIF
						REPLACE Quotes.Sz3 WITH lnReturnVal / lnPieces IN Quotes
						ThisForm.SZ31.Refresh
					ENDIF
					
				CASE ThisFormSet.MetricGotFocus = "P_LB1"
					ThisForm.P_LB1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "P_PC1"
					ThisForm.P_PC1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "P_FT1"
					ThisForm.P_FT1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "CUTS1"
					ThisForm.CUTS1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "OtherP1"
					ThisForm.OtherP1.Value = lnReturnVal
				CASE ThisFormSet.MetricGotFocus = "LOTP1"
					ThisForm.LOTP1.Value = lnReturnVal
			ENDCASE
			
			This.Value = '`'
			*cInputValue = '`'
			IF !EMPTY(cOldSelect)
				IF USED(cOldSelect)
					SELECT (cOldSelect)
				ENDIF
			ENDIF
		*ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast
		
		ENDIF
		
		IF INLIST(nKeyCode, 15, 5, 141, 152)
			ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"B"
			*Keys that make you goto PREV object
			*TAB Shift 15
			*left 19 52 26 
			*up 5 56 141 152 
			lnReturnVal = ThisFormSet.ConvertThis(cInputValue)	
			
			DO CASE
				CASE ThisFormSet.MetricGotFocus = "THCK1"
					ThisForm.THCK1.Value = lnReturnVal
					ThisForm.THCK1.refresh()
				CASE ThisFormSet.MetricGotFocus = "SZ21"
					ThisForm.SZ21.Value = lnReturnVal
					ThisForm.SZ21.refresh()
				CASE ThisFormSet.MetricGotFocus = "SZ31"
					ThisForm.SZ31.Value = lnReturnVal
					ThisForm.SZ31.refresh()
				CASE ThisFormSet.MetricGotFocus = "WEIGHT1"
					ThisForm.WEIGHT1.Value = lnReturnVal
					ThisForm.WEIGHT1.refresh()
				CASE ThisFormSet.MetricGotFocus = "P_LB1"
					ThisForm.P_LB1.Value = lnReturnVal
					ThisForm.P_LB1.refresh()
				CASE ThisFormSet.MetricGotFocus = "P_PC1"
					ThisForm.P_PC1.Value = lnReturnVal
					ThisForm.P_PC1.refresh()
				CASE ThisFormSet.MetricGotFocus = "P_FT1"
					ThisForm.P_FT1.Value = lnReturnVal
					ThisForm.P_FT1.refresh()
				CASE ThisFormSet.MetricGotFocus = "CUTS1"
					ThisForm.CUTS1.Value = lnReturnVal
					ThisForm.CUTS1.refresh()
				CASE ThisFormSet.MetricGotFocus = "OtherP1"
					ThisForm.OtherP1.Value = lnReturnVal
					ThisForm.OtherP1.refresh()
				CASE ThisFormSet.MetricGotFocus = "LOTP1"
					ThisForm.LOTP1.Value = lnReturnVal
					ThisForm.LOTP1.refresh()
			ENDCASE
			This.Value = '`'
			
		*ThisForm.Caption = ThisFormSet.MetricGOTFocus+" : "+ThisFormSet.GOTFocusLast	
			
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.tempfield.LostFocus
		IF This.Value="`"
			This.Value = ''
		ELSE
		*IF NOT EMPTY(ALLTRIM(This.Value))
			PRIVATE lnReturnVal 
			lnReturnVal = ThisFormSet.ConvertThis(This.Value)
		*	ThisFormSet.gotfocuslast = ThisFormSet.MetricGotFocus+"F"
		*	ThisFormSet.GotFocusNow = ThisFormSet.MetricGotFocus
			DO CASE
				CASE ThisFormSet.GotFocusNow = "THCK1"
					ThisForm.THCK1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "SZ21"
					ThisForm.SZ21.Value = lnReturnVal
					ThisFormSet.CalcInv(2)
				CASE ThisFormSet.GotFocusNow = "SZ31"
					ThisForm.SZ31.Value = lnReturnVal
					ThisFormSet.CalcInv(3)
				CASE ThisFormSet.GotFocusNow = "WEIGHT1"
					ThisForm.WEIGHT1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "P_LB1"
					ThisForm.P_LB1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "P_PC1"
					ThisForm.P_PC1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "P_FT1"
					ThisForm.P_FT1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "CUTS1"
					ThisForm.CUTS1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "OtherP1"
					ThisForm.OtherP1.Value = lnReturnVal
				CASE ThisFormSet.GotFocusNow = "LOTP1"
					ThisForm.LOTP1.Value = lnReturnVal
			ENDCASE
			This.Value = ''
		ENDIF
		
		ThisFormSet.GotFocusNow = ''
		
		This.Visible = .F.
		
	ENDPROC

	PROCEDURE QUOTES.THCK1.GotFocus
		WITH ThisForm.tempfield
			.Alignment = 2
			.Height = This.Height
			.Left = This.Left
			.Width = This.Width
			.Value = STR(This.Value,10,4)
			.Top = This.Top
			.Enabled = .T.
			.Visible = .T.
			.TabIndex = This.TabIndex 
		ENDWITH
		
		*ThisFormSet.MetricGOTFocus  = "THCK1"
		
		ThisForm.tempfield.SetFocus()
	ENDPROC

	PROCEDURE QUOTES.THCK1.MouseUp
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		ThisFormSet.GOTFocusLast = This.Name
	ENDPROC

	PROCEDURE QUOTES.THCK1.When
		IF ThisFormSet.isediting
			ThisFormSet.MetricGOTFocus  = "THCK1"
		ENDIF
		RETURN ThisFormSet.isediting
		
		
	ENDPROC

