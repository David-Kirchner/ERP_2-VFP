	PROCEDURE frmStockLst_Sum.cmdNext.Click
		SELECT Quotes
		IF !EOF()
			SKIP 1 IN Quotes
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN Quotes
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()
		
		ThisFormSet.Quotes.Refresh
		
		
	ENDPROC

	PROCEDURE frmStockLst_Sum.cmdPrev.Click
		SELECT Quotes
			IF !BOF()
				SKIP -1 IN Quotes
			ENDIF
			IF BOF()
				WAIT WINDOW 'Top of file' NOWAIT
				GO TOP IN Quotes
			ENDIF
		*	SCATTER MEMO MEMVAR
		
		ThisFormSet.QuotesRecordChanged()
		
		ThisFormSet.Quotes.refresh
		
		
		
	ENDPROC

