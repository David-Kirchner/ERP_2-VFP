	PROCEDURE QUOTES.cmdInventory.Click
		PRIVATE lcInvForm
		
		lcInvForm = ThisFormSet.InventoryForm( Quotes.Form )
		
		IF Quotes.StartStock 
		
			PRIVATE cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			cssAlloy	= ''
			cssForm		= ''
			cssCC		= ''
			cssCL		= ''
			cssCL		= ''
			nssPieces	= 0
			nssThck		= 0
			nssSz2		= 0
			nssSz3		= 0
			nssWeight	= 0
			
			*in Proc_SQL - Loads these memvars!
			DO GetStartingStock WITH Quotes.ID,gnConnHandle,cssAlloy,cssForm,cssCC,cssCL,nssPieces,nssThck,nssSz2,nssSz3,nssWeight
			
			*PARAMETER                           pFunction,pTBL,  pAlloy,   pForm,  pCC,  pCL,  pThck,  pSz2,  pSz3,      pSOItem,      pSalesNum,      pPC,     pLBS,pHeatLot,pQTY     ,pRL,pPOitem 	&&Can Send Quotes.POitem!
			DO FORM Forms\StockLst_SQL_Browse WITH "BROWSE",'S',cssAlloy, cssForm,cssCC,cssCL,nssThck,nssSz2,nssSz3,Quotes.SOitem,Quotes.SalesNum,nssPieces,nssWeight,      '',nssWeight,.F.,''
		ELSE
			DO FORM Forms\StockLst_SQL_Browse WITH "BROWSE",'S',Quotes.alloy, lcInvForm,Quotes.CC,Quotes.CL,Quotes.thck,Quotes.Sz2,Quotes.Sz3,Quotes.SOitem,Quotes.SalesNum,Quotes.Pieces,Quotes.Weight ,''      ,Quotes.Q_QTY,Quotes.RandLen,'' &&Can Send Quotes.POitem!
			*DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE",'S',Quotes.alloy, lcInvForm,Quotes.CC,Quotes.CL,Quotes.thck,Quotes.Sz2,Quotes.Sz3,Quotes.SOitem,Quotes.SalesNum,Quotes.Pieces,Quotes.Weight ,''      ,Quotes.Q_QTY,Quotes.RandLen,'' &&Can Send Quotes.POitem!
			*PARAMETER                           pFunction,pTBL,      pAlloy,     pForm,      pCC,      pCL,      pThck,      pSz2,      pSz3,      pSOItem,      pSalesNum,          pPC,          pLBS,pHeatLot,        pQTY,           pRL,pPOitem
		ENDIF
		*SELECT QUOTES
		*PARAMETER pFunction,pAlloy,pForm,pCond,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS
		*SELECT QUOTES
		ThisFormSet.CheckPU_Quoted()
	ENDPROC

	PROCEDURE QUOTES.cmdJump.Valid
		*.PRIVATE currOrder
		SELECT Quotes
		*. Cannot order on a buffered table
		*.currOrder = ORDER()
		*.SET ORDER TO
		*. Enable Table buff so multable records can be updated
		*.= CURSORSETPROP('Buffering', 5, 'Quotes' )  && Enable 3row 5table buffering
		
		BROWSE NOAPPEND NOEDIT NODELETE
		
		*.IF TABLEUPDATE(1,.F.,"Quotes")
		*.	*
		*.ELSE
		*.	=MESSAGEBOX("Data will not be saved to disk",0+16,"Found error")
		*.	=TABLEREVERT(.T.,"Quotes")
		*.ENDIF
		* reset to row buff
		*.= CURSORSETPROP('Buffering', 3, 'Quotes' )  && Enable 3row 5table buffering
		*.SET ORDER TO currOrder
		
		ThisFormSet.QuotesRecordChanged()
		
		ThisFormSet.refresh
		
	ENDPROC

	PROCEDURE QUOTES.cmdNext.Valid
		SELECT Quotes
		IF !EOF()
			SKIP 1 IN Quotes
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN Quotes
		ENDIF
		
		ThisFormSet.QuotesRecordChanged()
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE QUOTES.cmdOrderHistory.Click
		ThisFormSet.ShowBrokerHistory()
		IF ThisFormSet.frmSalesPOverlap.Visible = .F.
			WAIT WINDOW "Not Found!" NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdPeach.Click
		PRIVATE cCompany, cCustID
		cCompany= AllTrim(Quotes.Company)
		cCustID = AllTrim(Quotes.CustID)
		
		
		DO FORM forms\MatchCustomerID WITH cCustID, cCompany
		
		IF USED('tmpSqlAns')
			USE IN tmpSqlAns
		ENDIF
		
		SELECT 0
		
		PRIVATE cCompany, cCustomer
		cCompany = PrepareSQLtxt(Quotes.Company,'Company',30)
		cCustomer = ''  &&Char(20)
		
		cSQL = "SELECT TOP 1 Customer FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company = '"+cCompany+"'"
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSqlAns' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSqlAns' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSqlAns")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSqlAns")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSqlAns')
		ENDIF
		
		IF USED('tmpSqlAns')
			IF RECCOUNT('tmpSqlAns') > 0
				IF VARTYPE(tmpSqlAns.Customer) = "C"
					cCustomer = PrepareSQLtxt(tmpSqlAns.Customer,'Customer',20)
				ENDIF
			ENDIF
			USE IN tmpSqlAns
		ENDIF
		
		IF Is_CustID_NotFirst(cCustomer,gnConnHandle)
			IF NOT EMPTY(cCustomer)
				
				ThisForm.CustID1.Value = cCustomer
				ThisForm.CustID1.Refresh
				
				ThisFormSet.ShowPricingPU()
				ThisFormSet.ShowCustomerTerms("NOWAIT")
				
				IF NOT ThisFormSet.isediting
					MESSAGEBOX("If you did not choose to update AllQuotes, then"+CHR(13)+"Please Click Edit and then Save this record with CustomerID.",0+64,"Not in Edit Mode!")
				ENDIF
			ENDIF
		ELSE
			**too many companies where set to the first record 
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.cmdPrev.Valid
		SELECT Quotes
		IF !BOF()
			SKIP -1 IN Quotes
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file' NOWAIT
			GO TOP IN Quotes
		ENDIF
		*	SCATTER MEMO MEMVAR
		
		ThisFormSet.QuotesRecordChanged()
		
		ThisForm.refresh
	ENDPROC

