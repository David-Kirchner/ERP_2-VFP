	PROCEDURE frmDial.cmdDial.Click
		
		PRIVATE cPhone, cCountryCode, cDial
		cPhone 		= ALLTRIM(PrepareSQLtxt(ThisFormset.QUOTES.PHONE1.Value,'Phone',10))
		cCountryCode= ALLTRIM(PrepareSQLtxt(ThisFormset.QUOTES.CountryCode1.Value,'CountryCode',10))
		IF EMPTY(cCountryCode)
			IF LEN(cPhone) = 7
				IF LEFT(cPhone,3) = '945' OR LEFT(cPhone,3) = '675'
					cPhone = cPhone 
				ELSE
					cPhone = "1" + cPhone 
				ENDIF
			ELSE
				cPhone = "1" + cPhone 
			ENDIF
		ELSE
			IF LEFT(cCountryCode,3)!='011'
				cCountryCode = '011'+cCountryCode
			ENDIF
		ENDIF
		
		cDial 		= "9w"+cCountryCode +cPhone
		
		*this.Parent.oleTAPIEx.makeCall(cDial)
		mline = ThisForm.oleTAPIEx.Lines(ThisFormSet.TAPIID)  
		mLine.open
		
		*currCall = mLine.makeCall(cDial)
		gTAPIObj = mLine.makeCall(cDial)
		
		*!*	thisform.etLine1.Object.CallPhoneNumber = cDial 
		
		*!*	If thisform.etLine1.Object.CallDial Then
			thisform.cmdDial.Enabled = .F.
			thisform.cmdHangup.Enabled = .T.
			ThisForm.lblDial.Caption = "Dial: "+cDial 
		*!*	Else
		*!*	    thisform.etLine1.Object.CallHangup &&Just in case the device didn't drop the call
		*!*	    ThisForm.lblDial.Caption = "Dial failed!"
		*!*	EndIf
		
	ENDPROC

	PROCEDURE frmDial.cmdHangup.Click
		*currCall.drop
		gTAPIObj.Drop
		
		thisform.cmdDial.Enabled = .T.
		thisform.cmdHangup.Enabled = .F.
		ThisForm.lblDial.Caption = "Hang Up" 
	ENDPROC

