			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.pf1.PagePricing.cmdReportSimilar.Click
		PRIVATE lcCurrentDBF, lcInqNumP
		PRIVATE lcAlloy, lcForm, lnThckMin, lnThckMax, lnThck, lcThck
		lcCurrentDBF=""
		lcCurrentDBF=ALIAS()
		lcInqNumP	= PrepareSQLtxt(Quotes.InqNumP,'InqNumP',9)
		lcAlloy		= PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
		lcForm		= PrepareSQLtxt(Quotes.FORM,'Form',2)
		lnThck		= PrepareSQLnum(Quotes.Thck,'Thck',10,4)
		lnThckMin	= lnThck * .8
		lnThckMax	= lnThck * 1.2
		lcThck		= Remove0( lnThck,9,4 )
		*SZ3
		IF USED('tmpQuotesReport')
			USE IN tmpQuotesReport
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL= "SELECT *"
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Weight, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig) AS Description "
		cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) WHERE Alloy = '"+lcAlloy+"' AND Form = '"+lcForm+"' AND Thck > "+;
		  STR( lnThckMin ,10,4)+" AND Thck < "+STR( lnThckMax ,10,4)+" AND inqdate > "+DTOC( DATE()-90 )+" ORDER BY InqDate DESC"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQuotesReport')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQuotesReport')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQuotesReport")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQuotesReport")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpQuotesReport')
			return
		ENDIF
		
		IF USED('tmpQuotesReport')
			IF RECCOUNT('tmpQuotesReport') < 1
				WAIT WINDOW "No Records" NOWAIT
			ELSE
				
				IF FILE('REPORTS\SimilarQuotesSalesP.FRX')
					
					IF NOT "PRINTPREVIEW" $ SET("CLASSLIB")  &&Added for when Quotes is run without HPA menu.
						SET CLASSLIB TO Libs\PrintPreview ADDITIVE
					ENDIF
					oPForm = CREATEOBJECT('PrintPreview')
					oPform.Visible = .T. 
					
					REPORT FORM REPORTS\SimilarQuotesSalesP PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview HEADING "Search for Alloy:"+lcAlloy+" Form:"+lcForm+" Thickness :"+lcThck
					*FOR Alloy=lcAlloy AND FORM=lcForm AND Thck > lnThckMin AND Thck < lnThckMax
					
					TRACKMESS("Similar Quotes by Alloy:"+lcAlloy+" Form:"+lcForm+" Thickness :"+lcThck+" InqNumP:"+lcInqNumP)
					
					IF VARTYPE(oPform) = "O"
						oPform.Visible = .F.
						RELEASE ALL LIKE oPform
					ENDIF
			
				ELSE
					WAIT WINDOW 'Report not found' NOWAIT
				ENDIF
			ENDIF
			IF USED('tmpQuotesReport')
				USE IN tmpQuotesReport
			ENDIF
		ENDIF
		
		IF NOT EMPTY(lcCurrentDBF)
			IF USED(lcCurrentDBF)
				SELECT (lcCurrentDBF)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PagePricing.cmdReportSimilar.When
		IF ThisFormSet.isediting
			MESSAGEBOX("Save Your work First",0,"Edit Mode")
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.pf1.PagePricing.cmdReportSimilarCC.Click
		PRIVATE lcCurrentDBF
		PRIVATE lcAlloy, lcForm, lnThckMin, lnThckMax, lnThck, lcThck, lcCC, lcCL
		lcCurrentDBF=""
		lcCurrentDBF=ALIAS()
		
		lcAlloy   = PrepareSQLtxt(Quotes.Alloy,'Alloy',12)
		lcForm    = PrepareSQLtxt(Quotes.FORM,'Form',2)
		lnThck    = PrepareSQLnum(Quotes.Thck,'Thck',10,4)
		lcThck	  = STR( lnThck,10,4 )
		lnThckMin = lnThck *.8
		lnThckMax = lnThck *1.2
		lcCC	= PrepareSQLtxt(Quotes.CC,'CC',1)
		lcCL	= PrepareSQLtxt(Quotes.CL,'CL',1)
		
		IF USED('tmpQuotesReport')
			USE IN tmpQuotesReport
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL="SELECT *"
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Weight, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig) AS Description "
		cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) WHERE Alloy = '"+lcAlloy+"' AND Form = '"+lcForm+"' AND Thck > "+;
		  STR( lnThckMin ,10,4)+" AND Thck < "+STR( lnThckMax ,10,4)+;
		  " AND CC = '"+lcCC+"'"+;
		  " AND inqdate > "+DTOC( DATE()-3000 )+ " ORDER BY InqDate DESC"
		  
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQuotesReport')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQuotesReport')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQuotesReport")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQuotesReport")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpQuotesReport')
			return
		ENDIF
		
		IF USED('tmpQuotesReport')
			IF RECCOUNT('tmpQuotesReport') < 1
				WAIT WINDOW "No Reocords" NOWAIT
			ELSE
				IF FILE('REPORTS\SimilarQuotesSalesP.FRX')
					IF NOT "PRINTPREVIEW" $ SET("CLASSLIB")  &&Added for when Quotes is run without HPA menu.
						SET CLASSLIB TO Libs\PrintPreview ADDITIVE
					ENDIF
					oPForm = CREATEOBJECT('PrintPreview')
					oPform.Visible = .T.
					
					REPORT FORM 'REPORTS\SimilarQuotesSalesP.FRX' PREVIEW WINDOW PrintPreview IN WINDOW PrintPreview HEADING "Search for Alloy:"+lcAlloy+" Form:"+lcForm+" Thickness :"+lcThck
					
					IF VARTYPE(oPform) = "O"
						oPform.Visible = .F.
						RELEASE ALL LIKE oPform
					ENDIF
		
					*FOR Alloy=lcAlloy AND FORM=lcForm AND Thck > lnThckMin AND Thck < lnThckMax
				ELSE
					WAIT WINDOW 'Report not found' NOWAIT
				ENDIF
			ENDIF
		
			USE IN tmpQuotesReport
		ENDIF
		
		IF NOT EMPTY(lcCurrentDBF)
			SELECT (lcCurrentDBF)
		ENDIF
		
	ENDPROC

