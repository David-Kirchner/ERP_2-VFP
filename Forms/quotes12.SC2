	PROCEDURE frmRFQ.txtSupplier.Valid
		PRIVATE lSearchFound
		lSearchFound = .F.
		
		PRIVATE cSupplier
		cSupplier = This.Value
		
		IF !EMPTY(cSupplier)
		
		
			*lcTryString = SearchAlloyStandard(lcSearchStr, gnConnHandle )
			IF USED('tmpSupQuote')
				USE IN tmpSupQuote
			ENDIF
		
			cSQL = "SELECT TOP 1 Contact "
			cSQL = cSQL + " FROM dbo.SupplierQuotes WITH(NOLOCK) WHERE Supplier = '"+cSupplier+"'" 
			cSQL = cSQL + " AND LEN(Contact)>1" 
			cSQL = cSQL + " ORDER BY SaveDate Desc" 		
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSupQuote' )
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSupQuote' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSupQuote")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSupQuote")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSupQuote')
			ENDIF
			IF USED('tmpSupQuote')
				IF VARTYPE( tmpSupQuote.Contact) = "C"
					IF NOT EMPTY(tmpSupQuote.Contact)
						lcFoundStr  = tmpSupQuote.Contact
						ThisForm.txtContact.Value = lcFoundStr
						ThisForm.txtContact.FORECOLOR = RGB(0,0,0)
					ENDIF
				ENDIF
				USE IN tmpSupQuote
			ENDIF		
		
		ENDIF
	ENDPROC

