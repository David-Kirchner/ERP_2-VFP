	PROCEDURE QUOTES.pf1.PageSales.lblAddEditPO.Click
		
		IF ThisFormSet.isediting
			WAIT WINDOW "Save first" nowait
			RETURN .F.
		ENDIF
		
		PRIVATE nHPApo
		nHPApo = PrepareSQLnum(Quotes.HpaPo,'HPApo',-3)
		
		IF nHPApo > 0
			*Edit
			MESSAGEBOX("Do not have too many windows open!",0+48,"Caution")
			DO FORM Forms\PurchaseOrder14 WITH nHPApo, "EDIT"
		ELSE
			IF MESSAGEBOX("No HPA PO Found"+CHR(13)+"Do you want to Add a new PO now?",0+4,"Add PO?") = 6
				nHPApo = ThisFormSet.CreatePOfromQuote()
				IF nHPApo > 0
					DO FORM Forms\PurchaseOrder14 WITH nHPApo, "EDIT"
				ELSE 
					MESSAGEBOX("Failed to Create a HPA PO",16,"Error")
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.lblConnectPO.Click
		
		IF ThisFormSet.isediting
			WAIT WINDOW "Save first" nowait
			RETURN .F.
		ENDIF
		
		PRIVATE nHPApo,cPoItem, cBuyFrom1, nBuyCost1
		nHPApo = PrepareSQLnum(Quotes.HpaPo,'HPApo',-3)
		cPoItem = ''
		cBuyFrom1 = ''
		nBuyCost1 = 0
		
		IF nHPApo = 0
			WAIT WINDOW "Getting Records..." NOWAIT
			DO FORM Forms\ChoosePOitem WITH '' TO cPoItem
			
			IF Proper_PO_item(cPoItem) != Proper_PO_item('')
				nHPApo = VAL(cPoItem)
				cBuyFrom1 = Get_BuyfrominPurchaseOrder(nHPApo,gnConnHandle)
				cBuyFrom1 = PrepareSQLtxt(cBuyFrom1,'BuyFrom',15)
				
				nBuyCost1 = Get_PurchaseOrderCost(cPoItem,gnConnHandle)
				nBuyCost1 = PrepareSQLnum(nBuyCost1,'BuyCost',10,2)
				
				PRIVATE cUpdate,nSQLEXEC 
				cUpdate = "UPDATE dbo.AllQuotes SET "		
				cUpdate = cUpdate + " HPApo="+STR(nHPApo)+""
				cUpdate = cUpdate + ",BuyFrom='"+cBuyFrom1+"'"
				cUpdate = cUpdate + ",BuyCost="+STR(nBuyCost1,10,2)+""
				cUpdate = cUpdate + " WHERE AllQuotes.ID = " + ALLTRIM(STR(Quotes.ID))
				
				nSQLEXEC = SQLEXEC(gnConnHandle,cUpdate)
			
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
				ELSE
					SELECT Quotes
					REPLACE HPApo WITH nHPApo
					REPLACE BuyFrom WITH cBuyFrom1
					REPLACE BuyCost WITH nBuyCost1
					
					This.parent.BUYFROM1.Refresh
					This.parent.BUYCost1.Refresh
					This.parent.HPAPO1.Refresh
					
				ENDIF
				
				
			ENDIF
		ELSE
			MESSAGEBOX("Already have a PO:"+STR(nHPAPO)+" connected to this Quote.",0+64,"No NEW Connection.")
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.pf1.PageSales.lblCover.Click
		MESSAGEBOX("Enter the Quote as the SalesP who knows the Customer."+CHR(13)+;
		"Then mark yourself as the person who knows this quote."+CHR(13)+CHR(13)+;
		"Use 'Cover' to cover for another SalesP."+CHR(13)+CHR(13)+;
		"If you need to send this quote to the correct SalesP, use the 'Move Quote' short cut and mark yourself as the Cover."+CHR(13)+CHR(13)+;
		"A Covered Quoted will have a copy sent to the listed SalesP and to the Cover SalesP email.";
		,0+64,"Cover Help Info")
		
	ENDPROC

