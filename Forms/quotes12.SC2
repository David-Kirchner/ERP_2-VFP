	PROCEDURE QUOTES.SpnInqnum.GotFocus
		PRIVATE cCurSalesP, cStndSalesP
		*cCurSalesP	= PrepareSQLtxt(ThisForm.cmbFilterSalesP.Value,'SalesP',1)
		cCurSalesP	= PrepareSQLtxt(ThisForm.SalesP1.Value,'SalesP',1)
		cStndSalesP	= PrepareSQLtxt(ThisForm.txtSalesP.Value,'SalesP',1)
		
		IF LEN(ALLTRIM( cStndSalesP ))>0
			IF cCurSalesP <> cStndSalesP
				WAIT WINDOW "Caution! This Inqnum is not for you "+cStndSalesP+", it is for "+cStndSalesP+". Using this Spinner probably will not work for you." Timeout 1
				WAIT WINDOW "Caution! This Inqnum is not for you "+cStndSalesP+", it is for "+cStndSalesP+". Using this Spinner probably will not work for you." Nowait
			ENDIF
		ENDIF
		
				
				
	ENDPROC

	PROCEDURE QUOTES.SpnInqnum.Valid
		PRIVATE rtnInqNum
		rtnInqNum = PrepareSQLnum(THIS.VALUE,'InqNum',-3)
		IF rtnInqNum = 0
			WAIT WINDOW "InqNum Error.  Press any key to continue..." 
			RETURN .F.
		ENDIF
		
		PRIVATE cCurSalesP
		cCurSalesP = PrepareSQLtxt(ThisForm.txtSalesp.Value,'SalesP',1)
		
		PRIVATE nRecNum, nPastInqNum
		SELECT Quotes
		nRecNum = RECNO("Quotes")
		nPastInqNum = Quotes.InqNum
		
		PRIVATE cInqNum,cSQL,nSQLEXEC
		cInqnum =  ALLTRIM(STR(rtnInqNum))
		cInqnum = PADL(cInqnum ,8," ")
				
		LOCATE FOR InqNum = rtnInqNum
		IF NOT FOUND("Quotes")
			*Build the gcQuotesOR clause
			
			IF USED('tmpSQL_AQ')
				USE IN tmpSQL_AQ
			ENDIF
		
			IF gcSalesP = "*"
				
				cSQL = "SELECT Company, inqDate FROM dbo.AllQuotes WITH(NOLOCK) WHERE InqNum = "+ cInqNum
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSQL_AQ')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSQL_AQ')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL_AQ")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL_AQ")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 			
				IF nSQLEXEC < 0
					SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpSQL_AQ')
				ENDIF
				
				IF USED('tmpSQL_AQ')
					IF RECCOUNT('tmpSQL_AQ') > 0
						PRIVATE cTmpCompany 
						cTmpCompany = PrepareSQLtxt(tmpSQL_AQ.COMPANY,'Company',30)
						
						IF NOT EMPTY(cTmpCompany)
						
							PRIVATE dInqDate
							dInqDate = PrepareSQLdate(tmpSQL_AQ.InqDate,'InqDate',.F.,.T.)
							
							IF dInqDate < CTOD("01/01/1984")
								gcQuotesOR = " OR Company = '"+cTmpCompany 
							ELSE
								gcQuotesOR = " OR ( Company = '"+cTmpCompany 
								gcQuotesOR = gcQuotesOR + "' AND InqDate >= '"+DTOC( dInqDate )+"')"
							ENDIF
						ELSE
							gcQuotesOR = gcQuotesOR + " OR InqNum = " + STR(rtnInqNum)
						ENDIF
						
					ENDIF
					USE IN tmpSQL_AQ
				ENDIF
				****
				gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
				gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
				gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
				gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
				gcSQL=gcSQL + gcQuotesOR
				gcSQL=gcSQL +" ORDER BY InqDate"
				
			ELSE  
				*NOT gcSalesP = "*"
				
				cSQL = "SELECT Company,inqDate FROM dbo.AllQuotes WITH(NOLOCK) "
				cSQL  = cSQL  +" WHERE InqNumP = '"+cInqNum+ALLTRIM(gcSalesp)+"'"
				cSQL  = cSQL  +" OR InqNumP = '"+cInqNum+ALLTRIM(cCurSalesP)+"'" 
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSQL_AQ')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSQL_AQ')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL_AQ")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSQL_AQ")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 	
				IF nSQLEXEC < 0
					SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpSQL_AQ')
				ENDIF
				***
				IF USED('tmpSQL_AQ')
					IF RECCOUNT('tmpSQL_AQ') > 0
						PRIVATE cTmpCompany 
						cTmpCompany = PrepareSQLtxt(tmpSQL_AQ.COMPANY,'Company',30)
						
						IF NOT EMPTY(cTmpCompany)
						
							PRIVATE dInqDate
							dInqDate = PrepareSQLdate(tmpSQL_AQ.InqDate,'InqDate',.F.,.T.)
							
							IF dInqDate < CTOD("01/01/1984")
								gcQuotesOR = " OR Company = '"+cTmpCompany 
							ELSE
								gcQuotesOR = " OR ( Company = '"+cTmpCompany 
								gcQuotesOR = gcQuotesOR + "' AND InqDate >= '"+DTOC( dInqDate )+"')"
							ENDIF
							*USE IN tmpSQL_AQ
						ELSE
							gcQuotesOR = gcQuotesOR + " OR InqNum = " + STR(rtnInqNum)
						ENDIF
						
						USE IN tmpSQL_AQ
					ELSE
						 MESSAGEBOX("Record has been deleted or is not is your current list."+CHR(13)+CHR(13)+"On green Inventory tab, 'Quote days shown' maybe too small."+CHR(13)+CHR(13)+"Cannot go to that number!",0,"Inquire Number not found!")
						This.Value = nPastInqNum
					ENDIF
				ELSE
					This.Value = nPastInqNum
				ENDIF
				
				gcSQL="SELECT * FROM dbo.AllQuotes WITH(NOLOCK) "
				gcSQL=gcSQL +" WHERE (( SalesP Like '"+ IIF(gcSalesP='*','%',ALLTRIM(gcSalesP)+"'" )
				gcSQL=gcSQL +" OR Cover = '"+ALLTRIM(gcSalesP)+"' )"
				gcSQL=gcSQL +" AND InqDate > "+gcShowFromDate +")"
				gcSQL=gcSQL + gcQuotesOR
				gcSQL=gcSQL +" ORDER BY InqDate"
		
			ENDIF  &&IF gcSalesP = "*"
		
			THISFORMSET.Quotes.LOCKSCREEN = .T.
		
			IF USED('Quotes')
				USE IN Quotes
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, gcSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, gcSQL, "Quotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 			
			IF nSQLEXEC < 0
				SQLExecError(gcSQL,gnConnHandle,nSQLEXEC, 'Quotes')
			ENDIF
			
			IF NOT USED('Quotes')
				MESSAGEBOX("Oops."+CHR(13)+"Something has gone wrong."+CHR(13)+"The Quotes table will be reset."+CHR(13)+"Try again.",0+16,"Lost Quotes Table.")
				IF LEN(cCurSalesP) < 1
					*Lost SalesP and 'Quotes' cannot be Querried
					ThisForm.txtSalesp.Value = ThisForm.cmbFilterSalesP.Value
				ENDIF
				
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Lost Quotes Table. Something has gone wrong. The Quotes table will be reset."+CHR(13)+"cCurSalesP ='"+cCurSalesP+"'")
				
				ThisFormSet.RefreshAllQuotes()
				RETURN .F.
			ENDIF
			
			SELECT Quotes
			LOCATE FOR InqNum = VAL(cInqNum)
			
			IF FOUND('Quotes')
				ThisForm.cboTgq82.Value = 1 &&Record#,Inquire#,Company,Name,Sales #,PO #,Alloy,opened
				THISFORM.LOCKSCREEN = .F.
				ThisFormSet.QuotesRecordChanged()
			ELSE
				**Reset
				IF nRecNum <= RECCOUNT("Quotes")
					*going to a record count for a new table, not exact.
					GOTO nRecNum IN "Quotes"
					WAIT WINDOW 'Did not find!' NOWAIT
				ELSE
					GO BOTTOM	&&lost table error
				ENDIF
			ENDIF
		ELSE
			*Found, done
		ENDIF
		
		THISFORMSET.REFRESH
		
	ENDPROC

