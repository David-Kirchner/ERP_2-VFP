		IF USED('tmpValue')
			USE IN tmpValue
		ENDIF
		IF USED('Graph')
			USE IN Graph
		ENDIF
		ThisFormSet.frmRemoveORDER.Visible = .F.
		ThisFormset.frmRemoveORDER.AlwaysOnTop = .F.
	ENDPROC

	PROCEDURE revertpricingdata		&& Pricing functions can update the local table, but upon a cancelled edit (Abort). The SQL table needs to return pricing data to the local table.
		*ThisFormSet.RevertPricingData()
		
		PRIVATE cCurInqNum 
		SELECT Quotes
		cCurInqNum = Quotes.InqNumP
		
		IF USED('tmpAllQuote')
			USE IN tmpAllQuote
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT cP_PCC,cCut,cLotCP,CutHR,CutOptions,Surcharge FROM dbo.AllQuotes WITH(NOLOCK) WHERE InqNumP = '"+cCurInqNum+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpAllQuote')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpAllQuote')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpAllQuote")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpAllQuote")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL,gnConnHandle,nSQLEXEC, 'tmpAllQuote')
		ENDIF
		
		IF USED('tmpAllQuote')
			ThisFormset.QUOTES.pf1.PagePricing.cP_PCC1.Value	= tmpAllQuote.cP_PCC
			ThisFormset.QUOTES.pf1.PagePricing.cCUT1.Value		= tmpAllQuote.cCut
			ThisFormset.QUOTES.pf1.PagePricing.cLOTCP1.Value	= tmpAllQuote.cLotCP
			ThisFormset.QUOTES.pf1.PagePricing.CutHR.Value		= tmpAllQuote.CutHR
			ThisFormset.QUOTES.pf1.PagePricing.CutOptions.Value	= tmpAllQuote.CutOptions
			ThisFormset.QUOTES.pf1.PagePricing.LblSurcharge.Caption	= "Surcharge: "+ALLTRIM(STR(PrepareSQLnum(tmpAllQuote.Surcharge,'Surcharge',9,3),9,3))
			
			USE IN tmpAllQuote
			
			*ThisFormSet.ShowPricingCutFields()
			ThisFormSet.ShowPricing()
		ENDIF
		
		
		SELECT Quotes	
		*LOCATE FOR InqNumP = nCurInqNum
		
		
	ENDPROC

	PROCEDURE saleshistory
		*ThisFormSet.SalesHistory()
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE nSO,cSOitem
		nSO = Quotes.SalesNum
		cSOitem	= Quotes.SOitem
		
		PRIVATE cSQL
		*cSQL = "SELECT [SOitem],[Who],[What],[When],[Comment] FROM dbo.Sales_Status WHERE SalesNum ="+ALLTRIM(STR(nSO))+" ORDER BY SOitem "
		cSQL = "SELECT [SOitem],CAST([Who] AS VarChar(100)) AS [Who],[What],[When],[Comment] "
		cSQL = cSQL + " FROM dbo.Sales_Status WITH(NOLOCK) WHERE Soitem ='"+cSOitem+"' "
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT HPAlloy.dbo.f_ProperSOitem(OrderItem) AS [SOitem]"
		cSQL = cSQL + " ,CAST(t.Name AS VarChar(100)) AS [Who]"
		cSQL = cSQL + " ,(SELECT TOP (1) [status] FROM HPAlloyNR.dbo.OrderTrackingTime ott WITH(NOLOCK) "
		cSQL = cSQL + " 	WHERE (time > GETDATE() - 365) AND (trackID = o.trackID) "
		cSQL = cSQL + " 	ORDER BY time DESC) AS [What] "
		cSQL = cSQL + " ,(SELECT TOP (1) [time] FROM HPAlloyNR.dbo.OrderTrackingTime ott WITH(NOLOCK) "
		cSQL = cSQL + " 	WHERE ([time] > GETDATE() - 365) AND (trackID = o.trackID) "
		cSQL = cSQL + " 	ORDER BY time DESC) AS [When] "
		cSQL = cSQL + " ,otj.jobDescription AS [Comment] "
		cSQL = cSQL + " FROM HPAlloyNR.dbo.OrderTracking o WITH(NOLOCK) " 
		cSQL = cSQL + " INNER JOIN HPAlloyNR.dbo.OrderTrackingJob otj WITH(NOLOCK) ON o.jobID = otj.jobID "
		cSQL = cSQL + " INNER JOIN HPAlloyNR.dbo.OrderTrackingEmployee ote WITH(NOLOCK) ON o.trackID = ote.trackID "
		cSQL = cSQL + " INNER JOIN HPAlloyNR.dbo.TimeClockID t WITH(NOLOCK) ON t.EmployeeId = ote.EmployeeId "
		cSQL = cSQL + " WHERE o.orderItem  = '"+ALLTRIM(cSOitem)+"'"
		cSQL = cSQL + " ORDER BY [When] DESC "
		
		IF USED('tmpSalesHistory')
			USE IN tmpSalesHistory
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSalesHistory')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSalesHistory')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesHistory")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSalesHistory")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSalesHistory')
		ENDIF
		
		
		IF USED('tmpSalesHistory')
			IF RECCOUNT('tmpSalesHistory') > 0
				ThisFormSet.frmSalesHistory.Grid1.ColumnCount = 2
				ThisFormSet.frmSalesHistory.Grid1.RecordSource = 'tmpSalesHistory'
				ThisFormSet.frmSalesHistory.Grid1.Column1.Header1.Caption = 'SOitem'
				ThisFormSet.frmSalesHistory.Grid1.Column1.ControlSource = 'tmpSalesHistory.SOitem'
				ThisFormSet.frmSalesHistory.Grid1.Column2.Header1.Caption = 'What'
				ThisFormSet.frmSalesHistory.Grid1.Column2.ControlSource = 'tmpSalesHistory.What'
				
				ThisFormSet.frmSalesHistory.Grid1.ReadOnly = .T.
				
				ThisFormSet.frmSalesHistory.txtWho.Value = tmpSalesHistory.Who
				ThisFormSet.frmSalesHistory.txtWhen.Value = tmpSalesHistory.When
				ThisFormSet.frmSalesHistory.edtComment.Value = tmpSalesHistory.Comment
				
				ThisFormSet.frmSalesHistory.AlwaysOnTop = .T.
				ThisFormSet.frmSalesHistory.VISIBLE = .t.
				ThisFormSet.frmSalesHistory.AlwaysOnTop = .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE savecustomernotes
		PARAMETERS pCustomerNotes
		*SaveCustomerNotes()
		
		
		IF VARTYPE(pCustomerNotes) != "C"
			RETURN .F.
		ENDIF
		
		PRIVATE cCustomerText
		cCustomerText = PrepareSQLtxt(pCustomerNotes,'Customer Notes',-1)
		PRIVATE lFound
		lFound  = .F.
		
		PRIVATE cQuotesCompany,cHoldQuotesName,cCustID
		cQuotesCompany 	= PrepareSQLtxt(ThisFormset.QUOTES.Company1.Value,'Company',30)
		cHoldQuotesName	= PrepareSQLtxt(ThisFormset.QUOTES.NAME1.Value,'Name',25)
		cCustID			= PrepareSQLtxt(ThisFormSet.Quotes.CustID1.Value,'CustID',20)
		
		IF NOT EMPTY(cQuotesCompany ) AND NOT EMPTY(cHoldQuotesName) AND NOT EMPTY(cCustomerText)
			PRIVATE nSQLEXEC, cSQL
			IF USED('tmpCntQC')
				USE IN tmpCntQC
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company = '"+cQuotesCompany+"' AND Name = '"+cHoldQuotesName+"'"
			IF NOT EMPTY(cCustID)
				cSQL = cSQL + " AND customer = '"+cCustID+"'"
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpCntQC' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpCntQC' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "tmpCntQC")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, "tmpCntQC")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpCntQC')
			ENDIF
		
			IF USED('tmpCntQC')
				IF VARTYPE(tmpCntQC.Cntd) = 'N'
					IF tmpCntQC.Cntd > 0
						lFound = .T.
					ENDIf
				ENDIF
				USE IN 'tmpCntQC'
			ENDIF
		
			IF lFound
				cSQL = "UPDATE dbo.QuickCompany SET Notes = '"+cCustomerText+"' WHERE Company LIKE '"+cQuotesCompany+"%' AND Name LIKE '"+cHoldQuotesName+"%'"
				IF NOT EMPTY(cCustID)
					cSQL = cSQL + " AND customer = '"+cCustID+"'"
				ENDIF
		
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
				ENDIF
			ELSE
				cSQL = "INSERT INTO dbo.QuickCompany (Customer,company,NAME,CountryC,Phone,Phone_Ext,Fax,Email,Xcomp,Notes) VALUES ( "
				cSQL = cSQL + " '"+PrepareSQLtxt(Quotes.CustID,'CustID',20)+"'"
				cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.company,'Company',30)+"'"
				cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.NAME,'Name',25)+"'"								
				cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.CountryC,'CountryC',10)+"'"
				cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.Phone,'Phone',10)+"'"
				cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.Phone_Ext,'Phone_Ext',6)+"'"
				cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.Fax,'Fax',10)+"'"
				cSQL = cSQL + ",'"+PrepareSQLtxt(Quotes.Email,'Email',60)+"'"
				cSQL = cSQL + ",'"+Quotes.Phone+SOUNDEX(Quotes.NAME)+"'"
				cSQL = cSQL + ",'"+cCustomerText+"'"
				cSQL = cSQL + ")"
										
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
				ENDIF												
			ENDIF
		ELSE
			WAIT WINDOW 'Cannot save without unique Company or Name or NO Content' NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE saveprocessnotes
		PARAMETERS pProcessNotes
		*ThisFormSet.SaveProcessNotes(ThisForm.edtProcessNotes.Value)
		
		IF VARTYPE(pProcessNotes) != "C"
			RETURN .F.
		ENDIF
		
		PRIVATE cCustomerText
		cProcessNotes = PrepareSQLtxt(pProcessNotes,'Process Notes',-1)
		PRIVATE lFound
		lFound  = .F.
		
		PRIVATE cSOitem
		cSOitem	= Quotes.SOItem
		
		IF Proper_SO_Item( cSOitem ) != Proper_SO_Item('')
			PRIVATE nSQLEXEC, cSQL
			IF USED('tmpCntPN')
				USE IN tmpCntPN
			ENDIF
			
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.SO_ProcessNotes WITH(NOLOCK) WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpCntPN' )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpCntPN' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCntPN")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCntPN")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpCntPN')
			ENDIF
		
			IF USED('tmpCntPN')
				IF VARTYPE(tmpCntPN.Cntd) = 'N'
					IF tmpCntPN.Cntd > 0
						lFound = .T.
					ENDIf
				ENDIF
				USE IN 'tmpCntPN'
			ENDIF
		
			IF lFound
				IF EMPTY(cProcessNotes)
					cSQL = "DELETE dbo.SO_ProcessNotes WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				ELSE
					cSQL = "UPDATE dbo.SO_ProcessNotes SET Notes = '"+cProcessNotes+"' WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				ENDIF
				
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
				ENDIF
			ELSE
				cSQL = "INSERT INTO dbo.SO_ProcessNotes (SOitem,Notes) VALUES ( "
				cSQL = cSQL + "'"+cSOitem+"'"
				cSQL = cSQL + ",'"+cProcessNotes+"'"
				cSQL = cSQL + ")"
										
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
				
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
				ENDIF												
			ENDIF
		ELSE
			WAIT WINDOW 'Cannot save without Sales Order Number' NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE seeksalesnuminsales_no
		PARAMETERS nSalesNum
		*ThisFormSet.SeekSalesNuminSales_No(nSalesNum)
		
		IF USED( 'Sales_No' )
			IF RECCOUNT('Sales_No') > 0
				*Updated 8/14/18 to keep Sales_No open.
				RETURN .T.
			ENDIF
		ENDIF
			
		IF USED('Sales_No')
			USE IN Sales_No
		ENDIF
		
		cSQL = "SELECT * FROM dbo.Sales_No "
		cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'Sales_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'Sales_No')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Sales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "Sales_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle, nSQLEXEC, 'Sales_No')
			RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		ENDIF
		
		IF !USED( 'Sales_No' )
