	PROCEDURE Sendquotes12.cmdNewHTML.Click
		PRIVATE cLegelFileName
		cLegelFileName = ThisFormSet.Load_UserInfo()
		
		IF USED('UserInfo')
			SELECT UserInfo
			GO TOP
		
			DODEFAULT()
		ELSE
			MESSAGEBOX("UserInfo Table was lost",0+16,"Cannot send")
		ENDIF
		
		IF USED('UserInfo')
			USE IN UserInfo
			IF FILE(SYS(5)+SYS(2003)+"\"+cLegelFileName+".DBF")
				DELETE FILE (SYS(5)+SYS(2003)+"\"+cLegelFileName+".DBF")
			ENDIF
			IF FILE(SYS(5)+SYS(2003)+"\MEM\"+cLegelFileName+".DBF")
				DELETE FILE (SYS(5)+SYS(2003)+"\MEM\"+cLegelFileName+".DBF")
			ENDIF
		ENDIF
		
		SELECT Quotes
	ENDPROC

