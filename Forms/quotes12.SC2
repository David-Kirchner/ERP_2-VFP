		*ThisFormSet.Quotes.Enabled = .t.
		
	ENDPROC

	PROCEDURE frmWaterJet.cmdSave.Click
		PRIVATE cCutOption, nCutChoice
		cCutOption = ThisFormset.QUOTES.pf1.PagePricing.CutOptions.Value 
		nCutChoice = ThisformSet.Quotes.pf1.PagePricing.ogCutting.Value
		
		PRIVATE lWaterJet,m.lcCut
		lWaterJet = .T.
		m.lcCut = ''
		
		DO CASE
		CASE nCutChoice = 4
			lWaterJet = .F.
			m.lcCut = 'P'
			IF UPPER(LEFT(cCutOption,8)) = "WATERJET"
				cCutOption = ''
			ENDIF
		CASE nCutChoice = 5
			lWaterJet = .T.
			m.lcCut = 'W'
			IF UPPER(LEFT(cCutOption,5)) = "PLASMA"
				cCutOption = ''
			ENDIF
		OTHERWISE
			TrackError("Lost nCutChoice","nCutChoice is not 4 or 5.",PROGRAM(),LINENO(1))
		ENDCASE
		
		PRIVATE nCutOption
		DO CASE
		CASE " cut along width " $ cCutOption 
			*Cut Width
			nCutOption = 1
		CASE " cut along length " $ cCutOption 
			*Cut Length
			nCutOption = 2
		CASE " along length+width " $ cCutOption 
			*one cut on Width and Length
			nCutOption = 3
		CASE " 4 side " $ cCutOption 
			*Cut 4 side
			nCutOption = 4
		CASE " 4 sides combined " $ cCutOption 
			nCutOption = 5
			*Waterjet cuts combined
		CASE " combined " $ cCutOption 
			nCutOption = 5
			*Plasma cuts combined	
		CASE " Cut Disk " $ cCutOption 
			nCutOption = 6
			*Cut disk
		OTHERWISE
			MESSAGEBOX("Please Click on the text box for the cut option you want to save first!"+CHR(13)+"Like:"+CHR(13)+"One cut along width ",0+64,"Did not find what cut option to use.")
			RETURN .F.
		ENDCASE
		
		
		*************************************************0****
		*Policy Change 11/02/2012 Do not Use seperate cutting price by default.
		*IF nCutTotal > 0
		*	ThisFormSet.QUOTES.CutS1.Value = ROUND(nCutTotal,2)
		*ENDIF
		
		
		**************
		PRIVATE nKerfTot, nCutMprice, nCutTot, nCP_PC, nCLOTP, nPieces
		nKerfTot = PrepareSQLnum(ThisFormset.QUOTES.pf1.PagePricing.CCUT1.Value,'CP_PC',16,2,.T.,.T.)
		nCutMprice = PrepareSQLnum(ThisForm.txtDollar.Value,'Dollars',16,2,.T.,.T.)
		nCutTot	= nKerfTot + nCutMprice 
		nCP_PC	= PrepareSQLnum(ThisFormset.QUOTES.pf1.PagePricing.CP_PC1.Value,'CP_PC',16,2,.T.,.T.)
		nCLOTP	= PrepareSQLnum(ThisFormset.QUOTES.pf1.PagePricing.CLotP1.Value,'CLotP',16,2,.T.,.T.)
		nPieces	= PrepareSQLnum(ThisFormset.QUOTES.Pieces1.Value,'Pieces',-3)
		
		*Update the screen.
		ThisFormset.QUOTES.pf1.PagePricing.cutOptions.Value = cCutOption
		*ThisFormset.QUOTES.pf1.PagePricing.cCut1.Value		= nKerfTot 
		*ThisFormset.QUOTES.pf1.PagePricing.cCutM1.Value		= nCutMprice 
		*ThisFormset.QUOTES.pf1.PagePricing.CutS1.Value		= nCutTot
		
		PRIVATE nCP_PCC1, nCLotCP1 
		IF nCutOption = 5
			*Cut charge is lot " combined "
			IF nPieces > 1
				nCP_PCC1 = PrepareSQLnum(nCP_PC + (nKerfTot / nPieces) + (nCutMprice / nPieces),'cP_pc',10,2)
			ELSE
				nCP_PCC1 = nCP_PC + nCutTot 
			ENDIF
			ThisFormset.QUOTES.pf1.PagePricing.CP_PCC1.Value 	= nCP_PCC1
			
			ThisFormset.QUOTES.pf1.PagePricing.CCutM1.Value		= nCutMprice 
			nCLotCP1 = nCLOTP + nCutTot
			ThisFormset.QUOTES.pf1.PagePricing.CLotCP1.Value	= nCLotCP1 
			
		ELSE
			*CutCharge is per piece
			nCP_PCC1 = PrepareSQLnum(nCP_PC + nCutMprice + (nKerfTot / nPieces),'cP_pc',10,2)
			ThisFormset.QUOTES.pf1.PagePricing.CP_PCC1.Value	= nCP_PCC1 
			
			IF nPieces > 1
				ThisFormset.QUOTES.pf1.PagePricing.CCutM1.Value		= (nCutMprice * nPieces)
				nCLotCP1 =  nCLOTP + (nCutMprice * nPieces)
				ThisFormset.QUOTES.pf1.PagePricing.CLotCP1.Value	= nCLotCP1 
			ELSE
				ThisFormset.QUOTES.pf1.PagePricing.CCutM1.Value		= nCutMprice * 1
				nCLotCP1 = nCLOTP + nCutMprice * 1
				ThisFormset.QUOTES.pf1.PagePricing.CLotCP1.Value	= nCLotCP1 
			ENDIF
		ENDIF
		
		****************************
		PRIVATE nMinutes, nCutHR
		nMinutes = PrepareSQLnum(ThisForm.txtMin.Value,'Minutes',-3)
		IF nMinutes < 1
			nCutHR = 0
		ELSE
			nCutHR = ROUND(nMinutes/60,0)
		ENDIF
		
		ThisFormSet.Quotes.pf1.PagePricing.CutHR.Value = nCutHR
		
		****************************
		
		PRIVATE nQuotesID
		nQuotesID = Quotes.ID
		
		PRIVATE cUpdate
		cUpdate = "UPDATE dbo.AllQuotes SET "
		*cUpdate = cUpdate + ",cuts="+STR(PrepareSQLnum(oQ.cuts,'Cuts',6,0),6,0)+""
		*cUpdate = cUpdate + ",OtherFld='"+PrepareSQLtxt(oQ.OtherFld,'OtherFld',10)+"'"
		*cUpdate = cUpdate + ",OtherP="+STR(PrepareSQLnum(oQ.OtherP,'OtherP',8,2),8,2)+""
		*cUpdate = cUpdate + ",LotP="+STR(PrepareSQLnum(oQ.LotP,'LotP',9,2),9,2)+""
		*cUpdate = cUpdate + ",LotCost="+STR(PrepareSQLnum(oQ.LotCost,'LotCost',9,2),9,2)+""
		*cUpdate = cUpdate + ",LeadTime='"+PrepareSQLtxt(oQ.LeadTime,'LeadTime',15)+"'"
		*cUpdate = cUpdate + ",cWeight="+STR(PrepareSQLnum(oQ.cWeight,'Weight',8,1),8,1)+""
		*cUpdate = cUpdate + ",cP_lb="+STR(PrepareSQLnum(oQ.cP_lb,'cP_Lb',8,2),8,2)+""
		*cUpdate = cUpdate + ",cP_pc="+STR(PrepareSQLnum(oQ.cP_pc,'cP_Pc',9,2),9,2)+""
		*cUpdate = cUpdate + ",cP_Pcc="+STR(PrepareSQLnum(oQ.cP_Pcc,'cP_Pcc',9,2),9,2)+""
		*cUpdate = cUpdate + ",cTHK='"+ALLTRIM(oQ.cThk)+"'"
		*cUpdate = cUpdate + ",cLotP="+STR(PrepareSQLnum(oQ.cLotP,'cLotP',9,2),9,2)+""
		*cUpdate = cUpdate + ",Cut='"+pcCut+"'"
		
		cUpdate = cUpdate + " CutOptions='"+PrepareSQLtxt(cCutOption,'CutOptions',75)+"'"
		cUpdate = cUpdate + ",Cut='"+m.lcCut+"'"
		cUpdate = cUpdate + ",CutHR="+STR(PrepareSQLnum(nCutHR,'CutHR',-2))
		
		cUpdate = cUpdate + ",cP_PcC="+STR(PrepareSQLnum(nCP_PCC1,'CP_PCC',9,2,.T.,.T.),9,2)+""
		*cUpdate = cUpdate + ",Cuts="
		*cUpdate = cUpdate + ",cCut="+STR(PrepareSQLnum(nKerfTot,'cCut',9,2,.T.,.T.),9,2)+""
		
		cUpdate = cUpdate + ",cCutM="+STR(PrepareSQLnum(nCutMprice,'cCutM',9,2,.T.,.T.),9,2)+""
		cUpdate = cUpdate + ",cLotCP="+STR(PrepareSQLnum(nCLotCP1,'CLotCP',9,2,.T.,.T.),9,2)+""
		
		cUpdate = cUpdate + " WHERE AllQuotes.ID = " + ALLTRIM(STR(nQuotesID))
		
		nSQLEXEC = SQLEXEC(gnConnHandle,cUpdate)
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cUpdate)
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cUpdate, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cUpdate,gnConnHandle,nSQLEXEC, '')
		ELSE
		
		ENDIF
		************************
		
		*ThisForm.Visible = .F.
		ThisForm.Visible = .F.
		
		
	ENDPROC

