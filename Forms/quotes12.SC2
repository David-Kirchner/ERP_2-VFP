	PROCEDURE QUOTES.pf1.PageStatus.cmdEditHoldStatus.Click
		*ThisFormSet.SalesHistory()
		
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE nSO,cSOitem
		nSO = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		cSOitem	= PrepareSQLtxt(Quotes.SOitem,'SOitem',10)
		
		IF nSO > 0
			DO FORM Forms\SOitem_Status WITH cSOitem,gnConnHandle
			
			IF Is_SOitem_OnHold( cSOitem, 'ANY', gnConnHandle)
				This.parent.chkHold.Value = 1
				*REPLACE HOLD WITH 1 IN Sales
			ELSE
				This.parent.chkHold.Value = 0
				*REPLACE HOLD WITH 0 IN Sales
			ENDIF
			This.parent.chkHold.Refresh
			
		ENDIF
	ENDPROC

