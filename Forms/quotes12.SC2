	PROCEDURE frmQAQuote.Label2.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(This.Parent.txtExpireDate.Value)
			dDate1 = This.Parent.txtExpireDate.Value 
		ELSE
			dDate1 = DATE()+10
		ENDIF
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		This.parent.txtExpireDate.Value = dDate2
		
		*This.parent.txtExpireDate.Value = DATE()+10
		
	ENDPROC

