	PROCEDURE QUOTES.pf1.PagePricing.lblPMI.Click
		IF ThisFormSet.isediting
			MESSAGEBOX("Please finish the Quote edit."+CHR(13)+"This way you can then choose multiple Quotes to be grouped/combined.",0+64,"Finish the Edit first.")
		ELSE
			ThisFormSet.frmPMI.Left = ThisFormSet.QUOTES.Left +ThisFormSet.QUOTES.Width +6
			ThisFormSet.frmPMI.Top  = ThisFormSet.QUOTES.Top +6
			
			IF ThisFormSet.frmPMI.Visible
				ThisFormSet.frmPMI.Visible = .F.
			ELSE
				
				PRIVATE nPMIi, nPMIc
				nPMIi = PrepareSQLnum(This.parent.txtPMIi.value,'PMIi',-1)
				nPMIc = PrepareSQLnum(This.parent.txtPMIc.value,'PMIc',-1)
				
				IF nPMIi+nPMIc = 0
					*Add
					*ThisFormSet.frmPMI.cmdSave.Caption = 'Add'
					ThisFormset.frmPMI.lblOrig.Caption = PrepareSQLtxt(Quotes.ID,'ID',10)
				ELSE
					*ThisFormSet.frmPMI.cmdSave.Caption = 'Save'
				ENDIF
				ThisFormSet.frmPMI.Visible = .T.
			ENDIF
		ENDIF
		
	ENDPROC

