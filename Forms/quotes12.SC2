	PROCEDURE QUOTES.pf1.PageStatus.INQDATE1.When
		IF ThisFormSet.isediting
			IF ISNULL(Quotes.salesnum)
				RETURN .F.
			ELSE
				IF EMPTY(Quotes.salesnum)
					RETURN .F.
				ELSE
					RETURN .T.
				ENDIF
			ENDIF
		ELSE
			*Not in edit mode
			RETURN .F.
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageStatus.Item1.When
		RETURN .F.
		
	ENDPROC

	PROCEDURE QUOTES.pf1.PageStatus.SALEDATE1.When
		IF ThisFormSet.isediting
			IF ISNULL(Quotes.salesnum)
				RETURN .F.
			ELSE
				IF EMPTY(Quotes.salesnum)
					RETURN .F.
				ELSE
					IF NOT EMPTY(Quotes.Salesnum) AND EMPTY(Quotes.SaleDate)
						REPLACE SaleDate WITH DATE() IN Quotes
					ENDIF
					RETURN .T.
				ENDIF
			ENDIF
		ELSE
			IF This.Value < CTOD('01/01/1901')
				This.Value = ' '
			ENDIF
		
			*Not in edit mode
			RETURN .F.
		
		ENDIF
		
	ENDPROC

