	PROCEDURE frmStartingStock.sscmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms WITH(NOLOCK) "
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE frmStartingStock.sscmbForm.Valid
		ThisFormSet.RefreshForms(10)
		*10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,71,Coupling,72,Flange,75,Fastener,80,Disk,90,Machined
		* ALSO FOUND IN PurchaseOrder Screen
		IF ThisForm.ssTHCK1.Value * ThisForm.ssSZ21.Value > 0
			IF NOT ThisForm.ssSZ31.Visible
		*		IF ThisForm.ssSZ21.Value > 0
					ThisFormSet.CalcInv(12)
		*		ENDIF
			ELSE
				IF ThisForm.ssSZ31.Value > 0
					ThisFormSet.CalcInv(13) 
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

