	PROCEDURE abrasivecut
		*ThisFormSet.AbrasiveCut()
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE cAlloy,cCC,cCL,cForm,nPieces,nThck,nSz2,nSz3,nForceBracket,cCustID
		
		cAlloy	= PrepareSQLtxt(ALLTRIM(Quotes.alloy),'Alloy',12)
		cCC		= PrepareSQLtxt(Quotes.CC,'CC',1)
		cCL		= PrepareSQLtxt(Quotes.CL,'CL',1)
		cForm	= PrepareSQLtxt(Quotes.Form,'Form',2)
		
		nPieces = PrepareSQLnum(Quotes.pieces,'Pieces',10,0)
		nThck	= PrepareSQLnum(Quotes.thck,'Thck',10,4)
		nSz2	= PrepareSQLnum(Quotes.Sz2,'sz2',9,3)
		nSz3	= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		nForceBracket = .F.
		cCustID	= PrepareSQLtxt(Quotes.CustID,'CustID',20)
		
		IF EMPTY(nPieces)
			nPieces = 1
		ENDIF
		IF EMPTY('cAlloy')
			cAlloy = 'HPA N60'
		ENDIF
		IF EMPTY('cForm')
			MESSAGEBOX("Form has not been entered!",0+64,"Enter Form!")
			RETURN
		ENDIF
		IF EMPTY(cCC)
			cCC = '1'
		ENDIF
		
		*****************
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",'"+cCL+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',2,0),2,0)
		cSQL = cSQL + ",'"+cCustID+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'tmpPriceTbl')
		ENDIF
		
		*!*	SELECT @nPounds AS Pounds, @lnSurcharge AS Surcharge, @nCutPounds AS CutPounds
		*!*	, @nPrice AS Price, @nBracket AS Bracket
		*!*	, @nStdSize AS StdSize
		*!*	, @cAlloy AS StdAlloy
		*!*	, @nDensity AS Density
		*!*	, @cMessage AS WeightMess
		*!*	, @cPTMessage AS PriceMess, @bActivePrice AS ActivePrice
		
		IF USED('tmpPriceTbl')
		
			nCalcWeight			= tmpPriceTbl.Pounds
			nSurCharge 			= tmpPriceTbl.Surcharge
			nCalcCutPounds		= tmpPriceTbl.CutPounds	&&Abrasive Only .375 Kerf
			nCalcPricePerPound	= tmpPriceTbl.Price		
			
			USE IN tmpPriceTbl
		ELSE
			*Error in SQL
			nCalcWeight			= 0
			nSurCharge			= 0
			nCalcCutPounds		= 0
			nCalcPricePerPound	= 0
		ENDIF
		
		IF INLIST(cForm, '10','11','12','13','20','21','40','80','90')
			IF nCalcPricePerPound > 0
				nCalcPricePerPound = nCalcPricePerPound + nSurCharge
			ENDIF
		ENDIF	
		
		*******************
		PRIVATE nKerfAdjust, nCut_Tol_Lost 
		nKerfAdjust = 1
		*nCalcCutPounds is based on .3 which is good for .015
		nKerfAdjust = KerfAdjust('A',cForm,nThck)
		nCut_Tol_Lost = Cut_Tol_Lost('A',cForm,nThck)
		
		*******************	
		nCalcLotPrice = ( nCalcPricePerPound * nCalcWeight )
		nCalcPricePerPiece = nCalcLotPrice  / nPieces 	
		**
		nCalcCutOnlyTotal = ( nCalcPricePerPound * nCalcCutPounds * nKerfAdjust )
		nCalcLotPriceCut = nCalcLotPrice + ( nCalcPricePerPound * nCalcCutPounds * nKerfAdjust )
		nCalcPricePerPieceCut = nCalcLotPriceCut / nPieces 
			
			
		IF USED('Quotes')
			SELECT Quotes
		ENDIF
		
		REPLACE Quotes.cp_lb    WITH nCalcPricePerPound IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cWEIGHT1.Refresh
		
		REPLACE Quotes.cp_pc    WITH nCalcPricePerPiece IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cP_LB1.Refresh
		
		REPLACE Quotes.cp_pcc   WITH nCalcPricePerPieceCut IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cP_PCC1.Refresh
			
		REPLACE Quotes.clotp    WITH nCalcLotPrice IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cLOTP1.Refresh
		
		REPLACE Quotes.clotcp   WITH nCalcLotPriceCut IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cLOTCP1.Refresh
			
		REPLACE Quotes.ccut     WITH nCalcCutOnlyTotal IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.CCUT1.Refresh
		ThisFormset.QUOTES.pf1.PagePricing.CutHR.Value = 0
		
		
		REPLACE Quotes.CutOptions WITH "Abrasive Cut Kerf=.3 +Tol loss of "+Remove0(nCut_Tol_Lost,4,3)
		ThisFormSet.QUOTES.pf1.PagePricing.CutOptions.Refresh
		
		ThisFormSet.Refresh
		
		
	ENDPROC

	PROCEDURE allowedit		&& Some Edits are not Allowed
		PARAMETERS cType
		*ThisFormSet.AllowEdit('SAVE')
		
		PRIVATE lSaveType, lOK
		lSaveType = .F.
		lOK = .T.
		IF VARTYPE(cType) != "C"
			cType = ""
		ENDIF
		IF cType = "SAVE"
			lSaveType = .T.
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		
		*Check to see if Order
		IF NOT EMPTY(Quotes.SOItem)
			IF Count_SOIteminSales(Quotes.SOItem, gnConnHandle) > 0
			
				PRIVATE nSalesNum 
				nSalesNum = PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		
				*Check to see if Order has been printed
				IF USED('tmpSOprint')
					USE IN tmpSOprint
				ENDIF
		
				cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Sales_No WITH(NOLOCK) "
				cSQL = cSQL + " WHERE Salesnum = "+ALLTRIM(STR(nSalesNum))
				cSQL = cSQL + " AND ISNULL(Cncld,0) = 0 "
				cSQL = cSQL + " AND ISNULL(PrintedSO,0) = 1 "
				
				SELECT 0
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSOprint' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSOprint' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOprint")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOprint")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSOprint')
				ENDIF
		
				IF USED('tmpSOprint')
					IF tmpSOprint.Cntd > 0
						*Sales Order has been Printed 
						lOK = .F.		
					ENDIF
					USE IN tmpSOprint
				ENDIF
				
				IF NOT lOK 
					*Order has been Printed
					*Check to see if Order has been Received.
					IF USED('tmpSOprint')
						USE IN tmpSOprint
					ENDIF
		
					cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Sales_No WITH(NOLOCK) "
					cSQL = cSQL + " WHERE Salesnum = "+ALLTRIM(STR(nSalesNum))
					*cSQL = cSQL + " AND ISNULL(Cncld,0) = 0 "
					cSQL = cSQL + " AND ISNULL(ShopRecv,0) = 1 "
					cSQL = cSQL + " AND NOT ISNULL(Changing,0) = 1 "
					
					SELECT 0
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpSOprint' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpSOprint' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOprint")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpSOprint")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpSOprint')
					ENDIF
		
					IF USED('tmpSOprint')
						IF tmpSOprint.Cntd > 0
							*Sales Order has been Printed 
							*Sales or has been reveived by shop!
							lOK = .F.
							MESSAGEBOX("This Quote page cannot be edited"+CHR(13)+"because it is an Order that has been printed"+CHR(13)+"and received by the shop."+CHR(13)+CHR(13)+"To enable editing, go to Edit Sales Order detail."+CHR(13)+"Click 'Save' and do not print Yet."+CHR(13)+"If you have Permission to increment the SalesOrder version number,"+CHR(13)+"you will be able to make this Quote editable again.",16,"Cannot Edit Quote.")
						ELSE
							*Can be edited, just message at warn
							IF NOT lSaveType
								MESSAGEBOX("This Quote can be edited."+CHR(13)+"It is an Order that has not been printed"+CHR(13)+"or received by the shop.",64,"Warning. This belongs to a Sales Order!")
								lOK = .T.
							ENDIF
						ENDIF
						USE IN tmpSOprint
					ENDIF
				ELSE
					IF NOT lSaveType 
						*WARN
						MESSAGEBOX("This Quote can be edited."+CHR(13)+"It is an Order that has not been printed"+CHR(13)+"or received by the shop.",64,"Warning. This belongs to a Sales Order!")
					ENDIF			
				ENDIF
			ENDIF
		ENDIF
		
		IF lOK
			*Check to see if SalesPerson Allowed to Edit
			
			IF lSaveType
				IF Proper_SO_Item(Quotes.SOItem) <> Proper_SO_Item('')
					*Write trackuser on save
					TrackMess("Sales Order Item "+ALLTRIM(Quotes.SOItem)+" InqNumP:"+ALLTRIM(Quotes.InqnumP)+" has been edited.")
				ENDIF
			ENDIF
		ENDIF
		
		*IF lSaveType
			*Trying to Save an Edit
			IF lOK
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		*ELSE
			*Just testing at start of Save!
		*ENDIF
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE bandsawcut
		*ThisFormSet.BandSawCut()
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE cAlloy,cCC,cCL,cForm,nPieces,nThck,nSz2,nSz3,nForceBracket,cCustID
		
		cAlloy	= PrepareSQLtxt(ALLTRIM(Quotes.alloy),'Alloy',12)
		cCC		= PrepareSQLtxt(Quotes.CC,'CC',1)
		cCL		= PrepareSQLtxt(Quotes.CL,'CL',1)
		cForm	= PrepareSQLtxt(Quotes.Form,'Form',2)
		
		nPieces = PrepareSQLnum(Quotes.pieces,'Pieces',10,0)
		nThck	= PrepareSQLnum(Quotes.thck,'Thck',10,4)
		nSz2	= PrepareSQLnum(Quotes.Sz2,'sz2',9,3)
		nSz3	= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		nForceBracket = .F.
		cCustID	= PrepareSQLtxt(Quotes.CustID,'CustID',20)
		
		
		IF EMPTY(nPieces)
			nPieces = 1
		ENDIF
		IF EMPTY('cAlloy')
			cAlloy = 'HPA N60'
		*	RETURN
		ENDIF
		IF EMPTY('cForm')
			MESSAGEBOX("Form has not been entered!",0+64,"Enter Form!")
			RETURN
		ENDIF
		IF EMPTY(cCC)
			cCC = '1'
		ENDIF
		
		*****************
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
		cSQL = cSQL + STR(nPieces)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",'"+cCL+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',2,0),2,0)
		cSQL = cSQL + ",'"+cCustID+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'tmpPriceTbl')
		ENDIF
		
		*!*	SELECT @nPounds AS Pounds, @lnSurcharge AS Surcharge, @nCutPounds AS CutPounds
		*!*	, @nPrice AS Price, @nBracket AS Bracket
		*!*	, @nStdSize AS StdSize
		*!*	, @cAlloy AS StdAlloy
		*!*	, @nDensity AS Density
		*!*	, @cMessage AS WeightMess
		*!*	, @cPTMessage AS PriceMess, @bActivePrice AS ActivePrice
		
		IF USED('tmpPriceTbl')
		
			nCalcWeight			= tmpPriceTbl.Pounds
			nSurCharge 			= tmpPriceTbl.Surcharge
			nCalcCutPounds		= tmpPriceTbl.CutPounds	&&Abrasive Only .375 Kerf
			nCalcPricePerPound	= tmpPriceTbl.Price		
			
			USE IN tmpPriceTbl
		ELSE
			*Error in SQL
			nCalcWeight			= 0
			nSurCharge			= 0
			nCalcCutPounds		= 0
			nCalcPricePerPound	= 0
		ENDIF
		
		IF INLIST(cForm, '10','11','12','13','20','21','40','80','90')
			IF nCalcPricePerPound > 0
				nCalcPricePerPound = nCalcPricePerPound + nSurCharge
			ENDIF
		ENDIF	
		
		*******************
		PRIVATE nKerfAdjust, nCut_Tol_Lost 
		nKerfAdjust = 1
		*nCalcCutPounds is based on .3 which is good for .015
		nKerfAdjust = KerfAdjust('B',cForm,nThck)
		nCut_Tol_Lost = Cut_Tol_Lost('B',cForm,nThck)
		
		*******************	
		nCalcLotPrice = ( nCalcPricePerPound * nCalcWeight )
		nCalcPricePerPiece = nCalcLotPrice  / nPieces 	
		**
		nCalcCutOnlyTotal = ( nCalcPricePerPound * nCalcCutPounds * nKerfAdjust )
		nCalcLotPriceCut = nCalcLotPrice + ( nCalcPricePerPound * nCalcCutPounds * nKerfAdjust )
		nCalcPricePerPieceCut = nCalcLotPriceCut / nPieces 
			
			
		IF USED('Quotes')
			SELECT Quotes
		ENDIF
		
		REPLACE Quotes.cp_lb    WITH nCalcPricePerPound IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cWEIGHT1.Refresh
		
		REPLACE Quotes.cp_pc    WITH nCalcPricePerPiece IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cP_LB1.Refresh
		
		REPLACE Quotes.cp_pcc   WITH nCalcPricePerPieceCut IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cP_PCC1.Refresh
			
		REPLACE Quotes.clotp    WITH nCalcLotPrice IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cLOTP1.Refresh
		
		REPLACE Quotes.clotcp   WITH nCalcLotPriceCut IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.cLOTCP1.Refresh
			
		REPLACE Quotes.ccut     WITH nCalcCutOnlyTotal IN Quotes
		ThisFormset.QUOTES.pf1.PagePricing.CCUT1.Refresh
		ThisFormset.QUOTES.pf1.PagePricing.CutHR.Value = 0
		
		REPLACE Quotes.CutOptions WITH "Band Saw Cut Kerf=.156 +Tol loss of "+Remove0(nCut_Tol_Lost,4,3)
		ThisFormSet.QUOTES.pf1.PagePricing.CutOptions.Refresh
		
		ThisFormSet.Refresh
		
		
	ENDPROC

	PROCEDURE blankbackcolorcutting
		*ThisFormSet.BlankBackColorCutting()
		
		WITH ThisFormSet.frmWaterJet.PfQuality
			.Pg100.txtOneCutWidthDollar.BackColor = RGB(255,255,255)
			.Pg80.txtOneCutWidthDollar.BackColor = RGB(255,255,255)
			.Pg60.txtOneCutWidthDollar.BackColor = RGB(255,255,255)
			.Pg40.txtOneCutWidthDollar.BackColor = RGB(255,255,255)
			.Pg20.txtOneCutWidthDollar.BackColor = RGB(255,255,255)
			
			.Pg100.txtOneCutLengthDollar.BackColor = RGB(255,255,255)
			.Pg80.txtOneCutLengthDollar.BackColor = RGB(255,255,255)
			.Pg60.txtOneCutLengthDollar.BackColor = RGB(255,255,255)
			.Pg40.txtOneCutLengthDollar.BackColor = RGB(255,255,255)
			.Pg20.txtOneCutLengthDollar.BackColor = RGB(255,255,255)
			
			.Pg100.txtOneCutLWDollar.BackColor = RGB(255,255,255)
			.Pg80.txtOneCutLWDollar.BackColor = RGB(255,255,255)
			.Pg60.txtOneCutLWDollar.BackColor = RGB(255,255,255)
			.Pg40.txtOneCutLWDollar.BackColor = RGB(255,255,255)
			.Pg20.txtOneCutLWDollar.BackColor = RGB(255,255,255)
			
			.Pg100.txt4SidedDollar.BackColor = RGB(255,255,255)
			.Pg80.txt4SidedDollar.BackColor = RGB(255,255,255)
			.Pg60.txt4SidedDollar.BackColor = RGB(255,255,255)
			.Pg40.txt4SidedDollar.BackColor = RGB(255,255,255)
			.Pg20.txt4SidedDollar.BackColor = RGB(255,255,255)
		
			.Pg100.txt4SidedCombDollar.BackColor = RGB(255,255,255)
			.Pg80.txt4SidedCombDollar.BackColor = RGB(255,255,255)
			.Pg60.txt4SidedCombDollar.BackColor = RGB(255,255,255)
			.Pg40.txt4SidedCombDollar.BackColor = RGB(255,255,255)
			.Pg20.txt4SidedCombDollar.BackColor = RGB(255,255,255)
			
			.Pg100.txtDiskDollar.BackColor = RGB(255,255,255)
			.Pg80.txtDiskDollar.BackColor = RGB(255,255,255)
			.Pg60.txtDiskDollar.BackColor = RGB(255,255,255)
			.Pg40.txtDiskDollar.BackColor = RGB(255,255,255)
			.Pg20.txtDiskDollar.BackColor = RGB(255,255,255)
			
		ENDWITH
	ENDPROC

	PROCEDURE calcinv		&& Calculate Item weight and pricing
		PARAMETER pnField, nNewBracket
		*ThisFormSet.CalcInv(2)
		
		*************************************** 
		** repeat changes in SetPriceBracket **
		*************************************** 
		WAIT WINDOW 'Calc Price' NOWAIT &&TIMEOUT 1
		
		
		**pnField = 0 for Calculate on Save - Do not get picky
		IF VARTYPE(pnField) != 'N'
			pnField = 0
		ENDIF
		IF VARTYPE(nNewBracket) != 'N'
			nNewBracket = 0
		ENDIF
		
		IF nNewBracket = 0
			*No bracket Change
			IF pnField = 2 AND ( ThisFormset.QUOTES.SZ31.Visible AND ThisFormset.QUOTES.SZ31.Enabled )
				RETURN &&Only calcutlate field 2 when field 3 is not Visible/Enabled
			ENDIF
			IF pnField = 12 AND ( ThisFormset.frmStartingStock.ssSZ31.Visible AND ThisFormset.frmStartingStock.ssSZ31.Enabled )
				RETURN &&Only calcutlate field 2 when field 3 is not Visible/Enabled
			ENDIF
		ELSE	
			*Using the ForcedBracket
		ENDIF
		
		
		PRIVATE pcurdbf,cCurrTable,pcuralloy,nDensity 
		PRIVATE nCalcWeight,nCalcPricePerPound,nCalcLotPrice,cThickness
		PRIVATE nCalcPricePerPiece,nCalcPricePerPieceCut
		PRIVATE nKerfLostLBS, nKerfDollar 
		PRIVATE nCutMachineTotal,nCalcLotPriceCut
		PRIVATE cCC,cCL,nThck,nSz2,nSz3, nS_QTY, nS_P
		PRIVATE nPiecesA, nCalcMachWeight, cCommonSpec 
		PRIVATE nPriceBracket, nForceBracket
		PRIVATE cForm,local_cCut, cCutOptions
		PRIVATE cCustID, nCustDiscount
		
		*nCalcMachWeight = 0
		
		PRIVATE lOpenedAlloy
		lOpenedAlloy = .F.
		
		nPiecesA = PrepareSQLnum(Quotes.pieces,'Pieces',-3)
		IF nPiecesA < 1
			nPiecesA = 1
		ENDIF
		
		
		nDensity 		= 0
		nCalcWeight		= 0
		nCalcPricePerPound	= 0
		nCalcLotPrice   = 0
		nCalcLotPriceCut = 0
		
		*nStandardThickness   = AlLTRIM(Remove0( Quotes.thck,9,3,.F. ))
		nCalcPricePerPiece	= 0
		nCalcPricePerPieceCut= 0
		nKerfLostLBS		= 0
		nKerfDollar  		= 0	 &&ThisFormSet.CalcKerfDollar()
		
		nCutMachineTotal = 0
		*nCalcLotCut   	= 0
		nForceBracket 	= nNewBracket
		nCustDiscount = 0
		
		PRIVATE nSurCharge,cWeightMess,cPriceMess,lActivePrice
		nSurCharge	= 0
		cWeightMess	= ''
		cPriceMess	= ''
		lActivePrice= .F.
		
		cCurrTable = ALIAS()
		
		IF pnField > 10	&&Must be StartingStock
			pcuralloy = PrepareSQLtxt(ThisFormset.frmStartingStock.ssALLOY1.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbForm.Value,'Form',2)
			cCC		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbCC.Value,'CC',1)
			cCL		= PrepareSQLtxt(ThisFormset.frmStartingStock.sscmbCL.Value,'CL',1)
			nThck	= PrepareSQLnum(ThisFormset.frmStartingStock.ssThck1.Value,'Thck',10,4)
			nSz2	= PrepareSQLnum(ThisFormset.frmStartingStock.ssSz21.Value,'sz2',9,3)
			nSz3	= PrepareSQLnum(ThisFormset.frmStartingStock.ssSz31.Value,'Sz3',9,3)
		ELSE
			pcuralloy = PrepareSQLtxt(ALLTRIM(Quotes.alloy),'Alloy',12)
			cForm	= PrepareSQLtxt(Quotes.Form,'Form',2)
			cCC		= PrepareSQLtxt(Quotes.CC,'CC',1)
			cCL		= PrepareSQLtxt(Quotes.CL,'CL',1)
			nThck	= PrepareSQLnum(Quotes.thck,'Thck',10,4)
			nSz2	= PrepareSQLnum(Quotes.Sz2,'sz2',9,3)
			nSz3	= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		ENDIF
		
		**************************************
		local_cCut	= GetCut_Letter_Number(ThisFormset.QUOTES.pf1.PagePricing.ogCutting.value)
		cCutOptions = PrepareSQLtxt(Quotes.CutOptions,'CutOptions',75,.T.)
		cCustID		= PrepareSQLtxt(Quotes.CustID,'CustID',20)
		
		IF LEN(cForm) < 2 AND pnField > 0
			MESSAGEBOX("Form has not been entered!",0+64,"Enter Form!")
			RETURN .F.
		ENDIF
		IF nThck <= 0
			RETURN .F.
		ENDIF
		*lUse2ndDim = UsesForm_Dim2( cForm, gnConnHandle)
		*lUse3rdDim = Uses3rdDim( cForm, gnConnHandle)
		
		**************************************
		*Check Data
		**************************************
		
		DO CASE
			CASE cForm = '60' AND pnField > 0
				IF nSz2*2>= nThck
					MESSAGEBOX("The form 'Tube' cannot have a wall thickness greater than the Radius of OD",0,"Form Error")
					RETURN .F.
				ENDIF
			CASE cForm = '65' AND pnField > 0
				IF nSz2 = 5 OR nSz2 = 10 OR nSz2 = 20 OR nSz2 = 30 OR nSz2 = 40 OR nSz2 = 60 OR nSz2 = 80 OR nSz2 = 100 OR nSz2 = 120 OR nSz2 = 140 OR nSz2 = 160 
					*OK
				ELSE
					MESSAGEBOX("The Pipe form has a nonstandard Schedule."+CHR(13)+"Cannot get a Standard Price.",16,"Form Pipe")
					*RETURN .F.
				ENDIF
		ENDCASE
		
		
		
		**************************************
		*Could test Sizes, Sizes type-o will have arithmetic overflow ???
		*
		IF nThck > 100
			WAIT WINDOW "Your Thickness of "+ALLTRIM(STR(nThck,10,4))+" is not standard."+CHR(13)+"This could break the weight Calculation." TIMEOUT 1
		ENDIF
		IF nSz2 > 300
			WAIT WINDOW "Your 2nd dimension of "+ALLTRIM(STR(nSz2,9,3))+" is not standard."+CHR(13)+"This could break the weight Calculation." TIMEOUT 1
		ENDIF
		IF nSz3 > 300
			WAIT WINDOW "Your 3nd dimension of "+ALLTRIM(STR(nSz3,9,3))+" is not standard."+CHR(13)+"This could break the weight Calculation." TIMEOUT 1
		ENDIF
		
		**************************************
		
		IF USED('tmpPriceTbl')
			USE IN tmpPriceTbl
		ENDIF
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.[p_GetFullQuoteCL] "
		cSQL = cSQL + STR(nPiecesA)
		cSQL = cSQL + ",'"+pcuralloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ",'"+cCC+"'"
		cSQL = cSQL + ",'"+cCL+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nThck,'nThck',10,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz2,'nSz2',9,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nSz3,'nSz3',9,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nForceBracket,'ForceBracket',2,0),2,0)
		cSQL = cSQL + ",'"+cCustID+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpPriceTbl')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpPriceTbl')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPriceTbl")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpPriceTbl")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'tmpPriceTbl')
		ENDIF
		
		*!*	SELECT @nPounds AS Pounds, @lnSurcharge AS Surcharge, @nCutPounds AS CutPounds
		*!*	, @nPrice AS Price, @nBracket AS Bracket
		*!*	, @nStdSize AS StdSize
		*!*	, @cAlloy AS StdAlloy
		*!*	, @nDensity AS Density
		*!*	, @cMessage AS WeightMess
		*!*	, @cPTMessage AS PriceMess, @bActivePrice AS ActivePrice
		
		IF USED('tmpPriceTbl')
		
			IF EMPTY(tmpPriceTbl.Density)
				IF NOT EMPTY(pcuralloy) AND pnField > 0
					MESSAGEBOX("USING .290 DENSITY  - THE REAL FIGURE SHOULD BE PROGRAMED",0+64,"Alloy Density not found")
				ENDIF
				nDensity = .29
			ELSE 
				nDensity = tmpPriceTbl.Density
			ENDIF
		
			nCalcWeight			= tmpPriceTbl.Pounds
			nSurCharge 			= tmpPriceTbl.Surcharge
			nKerfLostLBS		= tmpPriceTbl.CutPounds	&&Abrasive Only calculated with .375 Kerf 
			nCalcPricePerPound	= tmpPriceTbl.Price		
			nPriceBracket		= tmpPriceTbl.Bracket
			nStandardSize		= tmpPriceTbl.StdSize
			*@cAlloy AS StdAlloy
			*@nDensity AS Density
			cCommonSpec			= tmpPriceTbl.CommonSpec
			cWeightMess			= tmpPriceTbl.WeightMess
			cPriceMess			= tmpPriceTbl.PriceMess
			lActivePrice		= tmpPriceTbl.ActivePrice
			nCustDiscount		= tmpPriceTbl.Discount
			nS_QTY				= tmpPriceTBL.QTY
			nS_P				= tmpPriceTBL.Price
			
			*Pounds,Surcharge,CutPounds,Price,Bracket,StdSize,StdAlloy,Density,CommonSpec,WeightMess,PriceMess,ActivePrice,Discount
			
			IF NOT lActivePrice AND pnField > 0
				*MESSAGEBOX( "Using Price Estimate - Price is not Active.",0+48,"Old Price")
				WAIT WINDOW "Using Price Estimate - Price is not Active." TIMEOUT 2
			ENDIF
			
			*Look for a returned error message
			IF pnField > 0
				IF NOT EMPTY( ALLTRIM(cWeightMess)+ALLTRIM(cPriceMess) )
					IF NOT EMPTY( ALLTRIM(cWeightMess))
						IF NOT EMPTY(ALLTRIM(cPriceMess) )
							MESSAGEBOX(ALLTRIM(cWeightMess)+CHR(13)+ALLTRIM(cPriceMess),0+64,"Weight\Price Message")
						ELSE
							MESSAGEBOX(ALLTRIM(cWeightMess),0+64,"Weight Message")
						ENDIF
					ELSE
						MESSAGEBOX(cPriceMess,0+64,"Price Message")
					ENDIF
				ENDIF
			ENDIF
			
			
			*** remember to Duplicate changes to SetPriceBracket
			
			PRIVATE nSurCharge
			nSurCharge = tmpPriceTbl.Surcharge
			IF INLIST(cForm, '10','11','12','13','20','21','40','80','90')
			*	nSurCharge = AlloySurcharge(pcuralloy)
				ThisFormset.QUOTES.pf1.PagePricing.lblSurcharge.Caption = "Surcharge: "+ALLTRIM(STR(nSurCharge,9,3))
				IF nCalcPricePerPound > 0
					nCalcPricePerPound = nCalcPricePerPound + nSurCharge
				ENDIF
			ELSE
				IF pnField < 10
					ThisFormset.QUOTES.pf1.PagePricing.lblSurcharge.Caption = "Surcharge: "
				ENDIF
			ENDIF
		
			*IF nPriceBracket > 0
			*	IF PriceTable.stkbase > PriceTable.base
			*		? CHR(7)
			*		WAIT WINDOW 'HIGH INVENTORY COST '+LTRIM(STR(PriceTable.stkbase,7,2)) NOWAIT
			*	ENDIF
			*ENDIF
				
			nKerfDollar  = nKerfLostLBS * nCalcPricePerPound 
			
			IF pnField < 10
				IF EMPTY(cCommonSpec ) OR ISNULL(cCommonSpec )
					ThisFormset.QUOTES.pf1.PagePricing.lblCommSpec.Caption = '  '
					ThisFormset.QUOTES.pf1.PagePricing.lblCommSpec.BackColor = RGB(0,255,255)
				ELSE
					ThisFormset.QUOTES.pf1.PagePricing.lblCommSpec.Caption = cCommonSpec 
					ThisFormset.QUOTES.pf1.PagePricing.lblCommSpec.BackColor = RGB(255,255,255)
				ENDIF
			ENDIF
			
			USE IN tmpPriceTbl
		ELSE
			*Error in SQL
			nCalcPricePerPound	= 0
			nPriceBracket		= 0
			nKerfLostLBS		= 0
			nKerfDollar  		= 0
			nCalcWeight			= 0
			cCommonSpec			= ''
			nStandardSize		= 0
			nCalcLotPriceCut	= 0
			nCustDiscount		= 0
			nS_QTY				= 0
			nS_P 				= 0
			nCutMachineTotal	= 0
		ENDIF
		
		**************************************
		*This rewrites the nCalcWeight returned by EXEC dbo.[p_GetFullQuoteCL]   Not needed here.
		*nCalcWeight = GetWeight(nPiecesA,pcuralloy,cForm,nThck,nSz2,nSz3, gnConnHandle)
		
		IF cForm = '80' 
			IF LEN( PrepareSQLtxt(quotes.cutOptions,'CutOptions',75) ) < 1 OR LEN( PrepareSQLtxt(quotes.Cut,'Cut',1)) < 1
				
				
				PRIVATE nWeight_Square, nWeight_OD, nWeight_ID, nWeight_Disk
				nWeight_Square	= GetWeight(nPiecesA,pcuralloy,'40',nThck,nSz2,nSz2, gnConnHandle) 
				nWeight_OD		= GetWeight(nPiecesA,pcuralloy,'10',nSz2,nThck,0, gnConnHandle)
				nWeight_ID		= GetWeight(nPiecesA,pcuralloy,'10',nSz3,nThck,0, gnConnHandle)
				nWeight_Disk	= nWeight_OD - nWeight_ID
				
				nCalcWeight	= nWeight_Square  &&uses the Square weight without adding .375 kerf.
				nKerfLostLBS = nCalcWeight - nWeight_Disk
				*nKerfDollar  = nKerfLostLBS * nCalcPricePerPound 
				
				REPLACE Quotes.weight	WITH PrepareSQLnum( nWeight_Disk,'Weight',9,1) IN Quotes
				ThisFormset.QUOTES.WEIGHT1.Refresh
			ELSE
				*A specific cut has been specified.
			ENDIF
		ENDIF
			
		**************************************
		IF USED('Quotes')
			SELECT Quotes
		ENDIF
		
		IF pnField > 0
			IF nStandardSize > nThck*1.1 OR nStandardSize < nThck/1.1
				*Warn if Standard is far from Thck
				*MESSAGEBOX("Your Quote is for Size: "+ALLTRIM(STR(nThck,9,4))+CHR(13)+"The Price Table Standard Size is: "+ALLTRIM(STR(nStandardSize,9,4)),64,"Non Standard Size")
				WAIT WINDOW "Your Quote is for Size: "+ALLTRIM(STR(nThck,9,4))+". The Price Table Standard Size is: "+ALLTRIM(STR(nStandardSize,9,4)) NOWAIT
			ENDIF
		ENDIF
		
		**********************************
		nCalcLotPrice = ( nCalcPricePerPound * nCalcWeight )
		nCalcPricePerPiece = ( nCalcPricePerPound * nCalcWeight )  / nPiecesA 	
		
		*The above cuts where based on abrasive Cutting. Check CutOption for Detailed cut charge!
		PRIVATE nCuttingCharge
		nCuttingCharge = 0
		
		IF NOT EMPTY(cCutOptions)
			PRIVATE cCutType, cCutOptions1, cCutPrice, cCutUnit, cCutSpeed
			PRIVATE nCutPcPrice, cCut 
			cCutType	= LEFT(cCutOptions, AT(" ",cCutOptions))
			cCutType 	= UPPER(ALLTRIM(cCutType))
			cCutOptions1 = RIGHT(cCutOptions,LEN(cCutOptions)-AT('$',cCutOptions))
			IF AT('/',cCutOptions1) > 0
				cCutPrice	= LEFT(cCutOptions1,AT('/',cCutOptions1)-1)
				cCutUnit	= SUBSTR(cCutOptions1,AT('/',cCutOptions1)+1,2)
			ELSE
				*" combined " $ cCutOptions
				cCutPrice	= LEFT(cCutOptions1,AT('Total',cCutOptions1)-1)
				cCutUnit = "LOT"
			ENDIF
		
			IF AT('%',cCutOptions1) > 0
				cCutSpeed = SUBSTR(cCutOptions1,AT('@',cCutOptions1)+1,3)
				IF '%' $ cCutSpeed 
					cCutSpeed = LEFT(cCutSpeed,2)
				ENDIF
			ELSE
				cCutSpeed	= ''
			ENDIF
			
			nCutMachineTotal = PrepareSQLnum(cCutPrice,'CutPrice',10,2)
			
		ENDIF
		
		*************************************************
		
		PRIVATE nKerfAdjust 
		nKerfAdjust = KerfAdjust(local_cCut,cForm,nThck)
			*Uses KerfAdjustTol(local_cCut,cForm,nThck) and nThck to fine tune Kerf
		
		*Quote.Cut = N-not specified, A-abrasive, B-band saw, S-shear, P-plasma, W-waterjet
		DO CASE
		CASE local_cCut  = 'A'
			nKerfDollar  			= ( nCalcPricePerPound * nKerfLostLBS * nKerfAdjust )
			nCutMachineTotal		= 0
			nCuttingCharge 			= nKerfDollar 
			nCalcLotPriceCut 		= nKerfDollar  
			nCalcPricePerPieceCut 	= nCalcLotPriceCut / nPiecesA 
			
		CASE local_cCut  = 'B'
			nKerfDollar  			= ( nCalcPricePerPound * nKerfLostLBS * nKerfAdjust )
			nCutMachineTotal		= 0
			nCuttingCharge 			= nKerfDollar 
			nCalcLotPriceCut		= nKerfDollar  
			nCalcPricePerPieceCut 	= nCalcLotPriceCut / nPiecesA 
			
		CASE local_cCut  = 'P'
		
			IF cForm = '80'
		*		IF EMPTY(cCutOptions)
					ThisFormSet.PlasmaCut('DEFAULT')			
		*		ENDIF
			ENDIF
			
			nCutMachineTotal		= PrepareSQLnum(ThisFormset.QUOTES.pf1.PagePricing.CCutM1.Value,'CCutM1',10,2)		
			nKerfDollar  			= PrepareSQLnum(ThisFormset.QUOTES.pf1.PagePricing.cKerfD.Value,'CCut1',10,2)
			nCuttingCharge 			= nKerfDollar  + nCutMachineTotal
			nCalcLotPriceCut		= nCalcLotPrice + ( nCuttingCharge * nPiecesA )
			nCalcPricePerPieceCut	= nCalcLotPriceCut / nPiecesA
			
		CASE local_cCut  = 'W'
		
			IF cForm = '80'
				IF EMPTY(cCutOptions)
					*Waterjet Cut Disk $"+"/PC @100% "
					ThisFormSet.WaterJetCut('DEFAULT')						
				ENDIF	
			ENDIF	
			nCutMachineTotal		= PrepareSQLnum(ThisFormset.QUOTES.pf1.PagePricing.CCutM1.Value,'CCutM1',10,2)
			nKerfDollar   			= PrepareSQLnum(ThisFormset.QUOTES.pf1.PagePricing.cKerfD.Value,'CCut1',10,2)
			nCuttingCharge			= nKerfDollar + nCutMachineTotal
			nCalcLotPriceCut 		= nCalcLotPrice + ( nCuttingCharge * nPiecesA )
			nCalcPricePerPieceCut 	= nCalcLotPriceCut / nPiecesA
			
		OTHERWISE
			*try Abrasive numbers 
		*	nCircleCutLoss = 3.14 * ( nSz2 + .375 +.375 )  && 3/8 plasma Kerf
			nKerfDollar   			= ( nCalcPricePerPound * nKerfLostLBS )
			nCutMachineTotal		= 0
			nCuttingCharge 			= nKerfDollar + nCutMachineTotal
			nCalcLotPriceCut  		= nCalcPricePerPound * ( nCalcWeight + nKerfLostLBS )
			nCalcPricePerPieceCut 	= nCalcLotPriceCut / nPiecesA 
			
		ENDCASE
		
		***************
		
		IF pnField < 10
			REPLACE Quotes.cWeight  WITH nCalcWeight IN Quotes
		
			REPLACE Quotes.cP_lb    WITH nCalcPricePerPound IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.cWEIGHT1.Refresh
			
			REPLACE Quotes.cP_pc    WITH nCalcPricePerPiece IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.cP_LB1.Refresh
			
			REPLACE Quotes.cP_pcc   WITH nCalcPricePerPieceCut IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.cP_PCC1.Refresh
				
			REPLACE Quotes.cLotp    WITH nCalcLotPrice IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.cLOTP1.Refresh
			
			REPLACE Quotes.cLotcp   WITH nCalcLotPriceCut IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.cLOTCP1.Refresh
			
			cStandardThickness = ALLTRIM(Remove0( nStandardSize,9,4 ))	
			REPLACE Quotes.cThk     WITH cStandardThickness IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.cTHK1.Refresh
			
			REPLACE Quotes.cKerfD     WITH nKerfDollar   IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.cKerfD.Refresh
			
			REPLACE Quotes.ccut     WITH nCuttingCharge	IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.CCUT1.Refresh
			
			REPLACE Quotes.ccutM     WITH nCutMachineTotal IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.CCUTM1.Refresh
		
			REPLACE Quotes.bracket  WITH nPriceBracket IN Quotes
			ThisFormset.QUOTES.pf1.PagePricing.cmbBracket.Value = Quotes.bracket
		
			REPLACE Quotes.Surcharge  WITH nSurcharge IN Quotes
			*ThisFormSet.Quotes.pf1.PagePricing.
			
			REPLACE Quotes.CustDisc	WITH nCustDiscount IN Quotes
			ThisFormSet.Quotes.pf1.PagePricing.CustDisc1.Refresh
			
			*REPLACE Quotes.Q_P WITH IN Quotes
			REPLACE Quotes.S_QTY WITH nS_QTY IN Quotes
			
			REPLACE Quotes.S_P WITH nS_P IN Quotes
			
			IF ThisFormSet.frmStockLst_Sum.Visible
				ThisFormSet.StockLst_Sum_Reload()
			ENDIF
			
		ELSE
		
			ThisFormset.frmStartingStock.ssWeight1.Value = nCalcWeight
			ThisFormset.frmStartingStock.ssWeight1.Refresh
		ENDIF
		
		**********************************
		IF NOT EMPTY(cCurrTable)
			IF USED(cCurrTable)
				SELECT (cCurrTable)
			ENDIF
		ENDIF
		
		ThisFormSet.QUOTES.pf1.PagePricing.ZOrder()
		ThisFormSet.Refresh
		
		RETURN .T.
	ENDPROC

	PROCEDURE calckerfdollar
		*ThisFormSet.CalcKerfDollar()
		PRIVATE cSides, nReturnDollar
		cSides = ""
		nReturnDollar = 0
		
		PRIVATE cAlloy,cForm,nPieces,nThck,nSz2,nSz3
		cAlloy	= PrepareSQLtxt(ALLTRIM(Quotes.alloy),'Alloy',12)
		cForm	= PrepareSQLtxt(Quotes.Form,'Form',2)
		nPieces = PrepareSQLnum(Quotes.pieces,'Pieces',10,0)
		nThck	= PrepareSQLnum(Quotes.thck,'Thck',10,4)
		nSz2	= PrepareSQLnum(Quotes.Sz2,'sz2',9,3)
		nSz3	= PrepareSQLnum(Quotes.Sz3,'Sz3',9,3)
		
		IF LEN(cAlloy) < 2
			RETURN 0
		ENDIF
		IF LEN(cForm) < 2
			RETURN 0
		ENDIF
		IF nPieces < 1
			nPieces = 1
		ENDIF
		IF nThck <= 0
			RETURN 0
		ENDIF
		
		IF UsesForm_Dim2( cForm, gnConnHandle )
			IF nSz2 <= 0
				RETURN 0
			ENDIF
		ENDIF
		
		PRIVATE lUses3rdDim
		lUses3rdDim = Uses3rdDim( cForm, gnConnHandle )
		IF lUses3rdDim 
			IF nSz3 <= 0
				RETURN 0
			ENDIF
		ENDIF
		
		**
		PRIVATE m.ncP_LB
		m.ncP_LB = PrepareSQLnum(Quotes.cP_LB,'cP_LB',8,3)
		IF m.ncP_LB = 0	
			*need Price/LB before Kerf Dollars can be calc'ed.
			RETURN 0
		ENDIF
		
		*****************
		
		PRIVATE cCutType, cCutOptions, cCutOptions1, nCutOption, cCutPrice, cCutUnit, cCutSpeed
		nCutOption = 0
		PRIVATE nCutPcPrice, m.cCut, nCutSpeed 
		m.cCut = PrepareSQLtxt(Quotes.Cut,'Cut',1)
		*N-not specified, A-abrasive, B-band saw, S-shear, P-plasma, W-waterjet
		
		IF LEN(m.cCut)<1
			m.cCut = 'N'
		ENDIF
		nCutSpeed = 0	&&used by WaterJet
		
		PRIVATE nKerf, nKerfCI 
		nKerf = 0
		nKerfCI = 0
		
		****************
		IF lUses3rdDim
		
			*look at CutOptions text
			cCutOptions = PrepareSQLtxt(ThisFormset.QUOTES.pf1.PagePricing.CutOptions.Value,'CutOptions',75,.T.)
			
			IF LEN(cCutOptions)>0
				*PARSE CutOptions
				cCutType	= LEFT(cCutOptions, AT(" ",cCutOptions))
				cCutType 	= UPPER(ALLTRIM(cCutType))
				
				cCutOptions1 = RIGHT(cCutOptions,LEN(cCutOptions)-AT('$',cCutOptions))
				IF AT('/',cCutOptions1) > 0
					cCutPrice	= LEFT(cCutOptions1,AT('/',cCutOptions1)-1)
					cCutUnit	= SUBSTR(cCutOptions1,AT('/',cCutOptions1)+1,2)
				ELSE
					*" combined " $ cCutOptions
					cCutPrice	= LEFT(cCutOptions1,AT('Total',cCutOptions1)-1)
					cCutUnit = "LOT"
				ENDIF
				
				***
				IF AT('%',cCutOptions1) > 0
					cCutSpeed = SUBSTR(cCutOptions1,AT('@',cCutOptions1)+1,3)
					IF '%' $ cCutSpeed 
						cCutSpeed = LEFT(cCutSpeed,2)
					ENDIF
				ELSE
					cCutSpeed	= ''
				ENDIF
				nCutSpeed = VAL(cCutSpeed)
		
				nCutPrice = PrepareSQLnum(cCutPrice,'CutPrice',10,2)
				
				*Plasma cut along length+width $35.44 +0.125" -0
				IF UPPER(LEFT(cCutOptions,10))="PLASMA CUT"
					cCutOptions1 = RIGHT(cCutOptions,39)
					m.cCut = "P"
				ELSE
					IF UPPER(LEFT(m.cCutOptions,8))="WATERJET"
						m.cCutOptions1 = RIGHT(m.cCutOptions,41)
						m.cCut="W"
						*m.cCutOptions1 = RTRIM(SUBSTR(cCutOptions,10,LEN(m.cCutOptions)-10))
						*CASE UPPER(LEFT(m.cCutOptions1,20)) = "ONE CUT ALONG WIDTH "
					ENDIF
				ENDIF
				
				DO CASE
				CASE UPPER(LEFT(cCutOptions1,12)) = "ALONG WIDTH "
					nCutOption = 1
					cCutOptions1 = RIGHT(cCutOptions1,28)
				CASE UPPER(LEFT(cCutOptions1,13)) = "ALONG LENGTH "
					nCutOption = 2
					cCutOptions1 = RIGHT(cCutOptions1,27)
				CASE UPPER(LEFT(cCutOptions1,18)) = "ALONG LENGTH+WIDTH"
					nCutOption = 3
					cCutOptions1 = RIGHT(cCutOptions1,22)
				CASE UPPER(LEFT(cCutOptions1,6)) = "4 SIDE"
					nCutOption = 4
					cCutOptions1 = RIGHT(cCutOptions1,34)
				CASE UPPER(LEFT(cCutOptions1,8)) = "COMBINED"
					nCutOption = 5
					cCutOptions1 = RIGHT(cCutOptions1,31)
				CASE UPPER(LEFT(cCutOptions1,8)) = "CUT DISK"
					nCutOption = 6
					cCutOptions1 = RIGHT(cCutOptions1,32)
				OTHERWISE
					nCutOption = 0
				ENDCASE	
			ELSE
				
			ENDIF
			
			nKerf = Kerf_Loss(m.cCut, nThck, nCutSpeed)
		
			*Plasma, WaterJet, Shear, Abrasive
			DO CASE
			CASE nCutOption = 1
				nKerfCI = nKerf * nSz2 * nPieces
			CASE nCutOption = 2
				nKerfCI = nKerf * nSz3 * nPieces
			CASE nCutOption = 3
				nKerfCI = nKerf * ( nSz2 + nSz3 ) * nPieces
			CASE nCutOption = 4
				nKerfCI = nKerf * ( nSz2 + nSz3 + nSz2 + nSz3 ) * nPieces
			CASE nCutOption = 5	&&Combine -do not duplicate width cut.
				nKerfCI = nKerf * ( nSz2 + nSz3 + nSz3 ) * nPieces
			CASE nCutOption = 6
				nKerfCI = nKerf * 3.14 * nSz2 * nPieces
			OTHERWISE
				nKerfCI = 0
			ENDCASE	
			
		ELSE
			*Does not use 3rdDim
			*BandSaw, AbrasiveSaw OR Lathe
			PRIVATE nCubicInch
			nCubicInch = CubicInch_Form(cForm,nThck,nSz2)
			
			DO CASE
			CASE nCubicInch = 0
				nKerfCI = 0
			CASE m.cCut = 'N'
				*Guess at Abrasive
				nKerfCI = .375 * nCubicInch
			CASE m.cCut = 'A'
				nKerfCI = .375 * nCubicInch
			CASE m.cCut = 'B'
				nKerfCI = .175 * nCubicInch
			CASE m.cCut = 'L'
				*Lathe - need tolerence ???
				nKerfCI = .375 * nCubicInch
			OTHERWISE
				nKerfCI = .375 * nCubicInch
			ENDCASE
		ENDIF
		
		nReturnDollar = PrepareSQLnum( nKerfCI * m.ncP_LB ,'cKerfD',10,2)
		
		ThisFormset.QuOTES.pf1.PagePricing.cKerfD.Value = nReturnDollar 
		
		RETURN nReturnDollar
	ENDPROC

	PROCEDURE checkalteredcompanyinfo		&& Give opertunity to update Company phone,Fax,email...
		*ThisFormSet.CheckAlteredCompanyInfo()
		
				
		PRIVATE cQIDComp, cQIDName
		cQIDComp = ALLTRIM(PrepareSQLtxt(ThisFormset.QUOTES.Company1.Value,'Company',30))
		cQIDName = ALLTRIM(PrepareSQLtxt(ThisFormset.QUOTES.NAME1.Value,'Name',25))
		
		PRIVATE cCustID, cCompany, cName,cCountryC,cPhone,cPhone_Ext,cFax,cEmail
		cCustID		= PrepareSQLtxt(Quotes.CustID,'CustID',20)
		cCompany	= PrepareSQLtxt(Quotes.company,'Company',30)
		cName		= PrepareSQLtxt(Quotes.Name,'Name',25)
		cCountryC	= PrepareSQLtxt(Quotes.CountryC,'CountryC',10)
		cPhone		= PrepareSQLtxt(Quotes.Phone,'phone',10)
		cPhone_Ext	= PrepareSQLtxt(Quotes.Phone_Ext,'phone_ext',6)
		cFax		= PrepareSQLtxt(Quotes.Fax,'Fax',10)
		cEmail		= PrepareSQLtxt(Quotes.Email,'Email',60)
					
		IF EMPTY(cCompany)
			WAIT WINDOW "No Company" NOWAIT
			RETURN .F.
		ENDIF
			
		IF EMPTY(cName)
			WAIT WINDOW "No Name" NOWAIT
			RETURN .F.
		ENDIF
		
		IF USED('tmpQcompany')
			USE IN tmpQcompany
		ENDIF
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT company, [NAME], phone, Phone_ext, Fax, Email, CountryC, Customer, XCompName, ID "
		cSQL = cSQL + " FROM dbo.QuickCompany WITH(NOLOCK) WHERE Company = '"+(cQIDComp)+"'"
		cSQL = cSQL + " AND Name = '"+(cQIDName)+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQcompany' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQcompany' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQcompany")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQcompany')
		ENDIF
		IF USED('tmpQcompany')
			IF RECCOUNT('tmpQCompany') = 0
				*Not Found
				IF NOT EMPTY(cPhone) OR NOT EMPTY(cEmail) OR NOT EMPTY(cFax)
					*Save new company info				
					cSQL = "INSERT INTO dbo.QuickCompany (Customer,Company,[Name],CountryC,Phone,Phone_Ext,Fax,Email) VALUES ( "
					cSQL = cSQL + " '"+cCustID+"'"
					cSQL = cSQL + ",'"+cCompany+"'"
					cSQL = cSQL + ",'"+cName+"'"
					cSQL = cSQL + ",'"+cCountryC+"'"
					cSQL = cSQL + ",'"+cPhone+"'"
					cSQL = cSQL + ",'"+cPhone_Ext+"'"
					cSQL = cSQL + ",'"+cFax+"'"
					cSQL = cSQL + ",'"+cEmail+"'" +")"
					
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
					ENDIF	
				ENDIF
			
			ELSE 
				*Found Company and name!
				IF RECCOUNT('tmpQCompany') = 1
					*check for differences in phone, phone-ext, fax, email, CountryC 
					IF ALLTRIM(tmpQcompany.CountryC) 	!= ALLTRIM(Quotes.CountryC) ;
						OR ALLTRIM(tmpQcompany.Phone) 	!= ALLTRIM(Quotes.Phone) ;
						OR ALLTRIM(tmpQCompany.Phone_Ext) != ALLTRIM(Quotes.Phone_Ext) ;
						OR ALLTRIM(tmpQCompany.Fax) 	!= ALLTRIM(Quotes.Fax) ;
						OR ALLTRIM(tmpQCompany.Email) 	!= ALLTRIM(Quotes.Email)
						
						ThisFormSet.frmCustomerChanged.txtCompany.Value		= tmpQcompany.Company
						ThisFormSet.frmCustomerChanged.txtName.Value		= tmpQcompany.Name 
						ThisFormSet.frmCustomerChanged.txtCountryCold.Value	= tmpQcompany.CountryC
						ThisFormSet.frmCustomerChanged.txtCountryCNew.Value	= Quotes.CountryC 
						ThisFormSet.frmCustomerChanged.txtPhoneOld.Value	= tmpQcompany.Phone
						ThisFormSet.frmCustomerChanged.txtPhoneNew.Value	= Quotes.Phone
						ThisFormSet.frmCustomerChanged.txtPhone_extOld.Value	= tmpQCompany.Phone_Ext
						ThisFormSet.frmCustomerChanged.txtPhone_extNew.Value	= Quotes.Phone_Ext
						ThisFormSet.frmCustomerChanged.txtFaxOld.Value		= tmpQCompany.Fax
						ThisFormSet.frmCustomerChanged.txtFaxNew.Value		= Quotes.Fax
						ThisFormSet.frmCustomerChanged.txtEmailOld.Value	= tmpQCompany.Email
						ThisFormSet.frmCustomerChanged.txtEmailNew.Value	= Quotes.Email
					
						ThisFormset.frmCustomerChanged.chkQTAll.Value	= 1
						
						IF ALLTRIM(tmpQcompany.CountryC) 	!= ALLTRIM(Quotes.CountryC) 
							ThisFormset.frmCustomerChanged.chkAQCountryC.Value = 1
							*WAIT WINDOW "New Country Code" NOWAIT
						ELSE
							ThisFormset.frmCustomerChanged.chkAQCountryC.Value = 0			
						ENDIF
						IF ALLTRIM(tmpQcompany.Phone) 	!= ALLTRIM(Quotes.Phone) 
							ThisFormset.frmCustomerChanged.chkAQPhone.Value = 1
							*WAIT WINDOW "New Phone" NOWAIT
						ELSE
							ThisFormset.frmCustomerChanged.chkAQPhone.Value = 0			
						ENDIF
						IF ALLTRIM(tmpQCompany.Phone_Ext) != ALLTRIM(Quotes.Phone_Ext) 
							ThisFormset.frmCustomerChanged.chkAQPhone_Ext.Value = 1
							*WAIT WINDOW "New Phone_Ext" NOWAIT
						ELSE
							ThisFormset.frmCustomerChanged.chkAQPhone_Ext.Value = 0			
						ENDIF
						IF ALLTRIM(tmpQCompany.Fax) 	!= ALLTRIM(Quotes.Fax) 
							ThisFormset.frmCustomerChanged.chkAQFax.Value = 1
							*WAIT WINDOW "New Fax" NOWAIT
						ELSE
							ThisFormset.frmCustomerChanged.chkAQFax.Value = 0			
						ENDIF
						IF ALLTRIM(tmpQCompany.Email) 	!= ALLTRIM(Quotes.Email)
							ThisFormset.frmCustomerChanged.chkAQEmail.Value = 1
							*WAIT WINDOW "New Email" NOWAIT
						ELSE
							ThisFormset.frmCustomerChanged.chkAQEmail.Value = 0			
						ENDIF
						ThisFormSet.frmCustomerChanged.txtXcompNameOld.Value = tmpQCompany.xCompName
						
						PRIVATE cXCompName
						cXCompName = GetxCompName(Quotes.Phone,Quotes.Company,Quotes.Name,gnConnHandle)
						ThisFormSet.frmCustomerChanged.txtXCompName.Value = cXCompName
						
						
						ThisFormSet.frmCustomerChanged.Top = 100
						ThisFormSet.frmCustomerChanged.LEFT = 100
						ThisFormSet.frmCustomerChanged.Visible = .T.
						ThisFormSet.frmCustomerChanged.AlwaysOnTop = .T.
						
					ENDIF
				ELSE
					*Found more than 1 Company-Name in QuickCompany
					
					**Delete all and add back 1
					cSQL = "DELETE FROM dbo.QuickCompany WHERE Company = '"+(cQIDComp)+"'"
					cSQL = cSQL + " AND Name = '"+(cQIDName)+"'"
		
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
					ENDIF
					
					********************
					*Save as a new company - clean up duplicates
					cSQL = "INSERT INTO dbo.QuickCompany (Customer,Company,[Name],CountryC,Phone,Phone_Ext,Fax,Email) VALUES ( "
					cSQL = cSQL + " '"+cCustID+"'"
					cSQL = cSQL + ",'"+cCompany+"'"
					cSQL = cSQL + ",'"+cName+"'"
					cSQL = cSQL + ",'"+cCountryC+"'"
					cSQL = cSQL + ",'"+cPhone+"'"
					cSQL = cSQL + ",'"+cPhone_Ext+"'"
					cSQL = cSQL + ",'"+cFax+"'"
					cSQL = cSQL + ",'"+cEmail+"'" +")"
					
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
					
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLExecError(cSQL, gnConnHandle, nSQLEXEC)
					ELSE
						MESSAGEBOX("This is not an Error."+CHR(13)+"Found too many listings for "+ALLTRIM(cName)+" at "+ALLTRIM(cCompany)+"."+CHR(13)+"Only allowed to have one quick phone for them (Company+Person)."+CHR(13)+"All old listings where removed."+CHR(13)+"This Phone, Fax, Email will be the new standard.",64,"Cleaned up QuickCompany listing.")
					ENDIF	
		
				ENDIF
			ENDIF
			
			THISFORMSET.CompanyChanged = .F.
		
			IF USED('tmpQcompany')
				USE IN tmpQcompany
			ENDIF
		ENDIF
				**************************
		
		
		
	ENDPROC

	PROCEDURE checkcompanyalloyduplicate
		PARAMETERS cAlloy
		*ThisFormSet.CheckCompanyAlloyDuplicate()
		
		IF VARTYPE(cAlloy)!="C"
			RETURN
		ENDIF
		IF EMPTY(cAlloy)
			RETURN
		ENDIF
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE cForm
		*cAlloy	= PrepareSQLtxt(ALLTRIM(Quotes.alloy),'Alloy',12)
		cForm	= PrepareSQLtxt(Quotes.Form,'Form',2)
		
		PRIVATE cCompany,cEmail,cSalesP
		cCompany= PrepareSQLtxt(Quotes.Company,'Company',30)
		cEmail  = PrepareSQLtxt(Quotes.Email,'Email',60)
		cSalesP = PrepareSQLtxt(Quotes.SalesP,'SalesP',1)
		
		IF EMPTY(cCompany)
			RETURN
		ENDIF
		
		IF USED('tmpDupQuote')
			ThisFormSet.frmDupQoute.grid1.RecordSource = ''
			USE IN tmpDupQuote
		ENDIF
		
		PRIVATE cSQL
		cSQL = "SELECT LEFT(Name,12) AS Name"
		*cSQL = cSQL + " ,dbo.f_Descript(Alloy,CC,CL,Form,Thck,Sz2,Sz3,Weight,RandLen) AS Descript "
		cSQL = cSQL + " ,LEFT(dbo.f_DescriptionMetricReport(Pieces, Form, Thck, SZ2, SZ3, Weight, RandLen, Metric, Sz1orig, Sz2orig, Sz3orig),20) AS Descript "
		cSQL = cSQL + " ,CAST(InqDate AS CHAR(12)) AS InqDate, InqNumP "
		cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
		cSQL = cSQL + " WHERE Alloy = '"+cAlloy+"'"
		
		IF LEN(cEmail) > 1
			IF LEN(cCompany) > 1
				cSQL = cSQL + " AND ( Email LIKE '%"+ALLTRIM(cEmail)+"%'"
				cSQL = cSQL + " OR Company LIKE '%"+ALLTRIM(cCompany)+"%' )"
			ELSE
				cSQL = cSQL + " AND Email LIKE '%"+ALLTRIM(cEmail)+"%'"
			ENDIF
		ELSE
			cSQL = cSQL + " AND Company LIKE '%"+ALLTRIM(cCompany)+"%'"
		ENDIF
		
		cSQL = cSQL + " AND SalesP != '"+cSalesP+"'"
		cSQL = cSQL + " AND Cover != '"+cSalesP+"'"
		cSQL = cSQL + " AND InqDate > GetDate()-30 "
		cSQL = cSQL + " ORDER BY InqDate Desc "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpDupQuote')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpDupQuote')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpDupQuote")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpDupQuote")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,gnConnHandle,nSQLEXEC, 'tmpDupQuote')
		ELSE
			IF USED('tmpDupQuote')
				IF RECCOUNT('tmpDupQuote')>0
					ThisFormSet.frmDupQoute.Left = ThisFormSet.Quotes.Left +264
					ThisFormSet.frmDupQoute.Top = ThisformSet.Quotes.Top +400
					ThisFormSet.frmDupQoute.Visible = .T.
					ThisFormSet.frmDupQoute.grid1.RecordSource = 'tmpDupQuote'
					Thisformset.frmDupQoute.txtCompany.Value = cCompany
					Thisformset.frmDupQoute.txtAlloy.Value = cAlloy
				ENDIF
				*USE IN tmpDupQuote
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE checkpu_quoted		&& CheckPU_Quoted
		*ThisFormSet.CheckPU_Quoted()
		
		PRIVATE nQ_PU, cQ_PU
		nQ_PU = 0
		cQ_PU = ''
		
		PRIVATE nP_lb,nP_pc,nP_ft,nLotP,cOtherFld,nOtherP
		nP_lb			= PrepareSQLnum(ThisFormSet.Quotes.P_lb1.Value,'P_lb',8,2)
		nP_pc			= PrepareSQLnum(ThisFormSet.Quotes.P_pc1.Value,'P_pc',9,2)
		nP_ft			= PrepareSQLnum(ThisFormSet.Quotes.P_ft1.Value,'P_ft',8,2)
		*nCuts			= PrepareSQLnum(ThisFormSet.Quotes.Cuts1.Value,'Cuts',6,0)
		nLotP			= PrepareSQLnum(ThisFormSet.Quotes.LotP1.Value,'LotP',8,2)
		cOtherFld		= PrepareSQLtxt(ThisFormSet.Quotes.OtherFld1.Value,'OtherFld',10)
		nOtherP			= PrepareSQLnum(ThisFormSet.Quotes.OtherP1.Value,'OtherP',8,2)
		
		
		*Check Data
		PRIVATE cMess
		DO CASE
		CASE UPPER(cOtherFld) = "PER MR" OR UPPER(cOtherFld) = "PER MTR" OR "$/MTR" $ UPPER(cOtherFld) OR "$/MR" $ UPPER(cOtherFld)
			nQ_PU = 7
			cQ_PU = "$/Mtr"
			cMess = "This Quote has the text 'Per MTR' in the 'Other Price' field."
			IF nOtherP <= 0
				cMess = cMess + CHR(13)+"The Per Inch price has not been entered!"
				IF nP_lb > 0
					cMess = cMess + CHR(13)+"The $/Lb number will be ignored."
				ENDIF
				IF nP_pc > 0
					cMess = cMess + CHR(13)+"The $/PC number will be ignored."
				ENDIF
				IF nP_ft > 0
					cMess = cMess + CHR(13)+"The $/Ft number will be ignored."
				ENDIF
				IF nLotP > 0
					cMess = cMess + CHR(13)+"The $Lot number will be ignored."
				ENDIF
				cMess = cMess +CHR(13)+"Please only use the 'Other' to hold the $/Mtr price."
			ELSE
				IF nP_lb > 0
					cMess = cMess + "$/Lb number will be ignored."
				ENDIF
				IF nP_pc > 0
					cMess = cMess + "$/Pc number will be ignored."
				ENDIF
				IF nP_ft > 0
					cMess = cMess + "$/Ft number will be ignored."
				ENDIF
				IF nLotP > 0
					cMess = cMess + "$Lot number will be ignored."
				ENDIF
			ENDIF
			IF nP_lb + nP_pc + nP_ft + nLotP > 0
				MESSAGEBOX( cMess, 32,"Bad combination of Quote price.")
			ENDIF
		CASE UPPER(cOtherFld) = "PER KG" OR "$/KG" $ UPPER(cOtherFld)
			nQ_PU = 6
			cQ_PU = "$/Kg"
			cMess = "This Quote has the text 'Per Kg' in the 'Other Price' field."
			IF nOtherP <= 0
				cMess = cMess + CHR(13)+"The Per Inch price has not been entered!"
				IF nP_lb > 0
					cMess = cMess + CHR(13)+"The $/Lb number will be ignored."
				ENDIF
				IF nP_pc > 0
					cMess = cMess + CHR(13)+"The $/PC number will be ignored."
				ENDIF
				IF nP_ft > 0
					cMess = cMess + CHR(13)+"The $/Ft number will be ignored."
				ENDIF
				IF nLotP > 0
					cMess = cMess + CHR(13)+"The $Lot number will be ignored."
				ENDIF
				cMess = cMess +CHR(13)+"Please only use the 'Other' to hold the $/Kg price."
			ELSE
				IF nP_lb > 0
					cMess = cMess + "$/Lb number will be ignored."
				ENDIF
				IF nP_pc > 0
					cMess = cMess + "$/Pc number will be ignored."
				ENDIF
				IF nP_ft > 0
					cMess = cMess + "$/Ft number will be ignored."
				ENDIF
				IF nLotP > 0
					cMess = cMess + "$Lot number will be ignored."
				ENDIF
			ENDIF
			IF nP_lb + nP_pc + nP_ft + nLotP > 0
				MESSAGEBOX( cMess, 32,"Bad combination of Quote price.")
			ENDIF
		CASE UPPER(cOtherFld) = "PER INCH" OR "$/IN" $ UPPER(cOtherFld)
			nQ_PU = 5
			cQ_PU = "$/In"
			cMess = "This Quote has the text 'Per Inch' in the 'Other Price' field."
			IF nOtherP <= 0
				cMess = cMess + CHR(13)+"The Per Inch price has not been entered!"
				IF nP_lb > 0
					cMess = cMess + CHR(13)+"The $/Lb number will be ignored."
				ENDIF
				IF nP_pc > 0
					cMess = cMess + CHR(13)+"The $/PC number will be ignored."
				ENDIF
				IF nP_ft > 0
					cMess = cMess + CHR(13)+"The $/Ft number will be ignored."
				ENDIF
				IF nLotP > 0
					cMess = cMess + CHR(13)+"The $Lot number will be ignored."
				ENDIF
				cMess = cMess +CHR(13)+"Please only use the 'Other' to hold the $/Inch price."
			ELSE
				IF nP_lb > 0
					cMess = cMess + "$/Lb number will be ignored."
				ENDIF
				IF nP_pc > 0
					cMess = cMess + "$/Pc number will be ignored."
				ENDIF
				IF nP_ft > 0
					cMess = cMess + "$/Ft number will be ignored."
				ENDIF
				IF nLotP > 0
					cMess = cMess + "$Lot number will be ignored."
				ENDIF
			ENDIF
			IF nP_lb + nP_pc + nP_ft + nLotP > 0
				MESSAGEBOX( cMess, 32,"Bad combination of Quote price.")
			ENDIF
		CASE UPPER(cOtherFld) = "PER FOOT" OR "$/FT" $ UPPER(cOtherFld)
			nQ_PU = 2
			cQ_PU = "$/Ft"
			cMess = "This Quote has the text 'Per Foot' in the 'Other Price' field."
			IF nOtherP <= 0
				cMess = cMess + CHR(13)+"The Per Foot price has not been entered!"
				IF nP_lb > 0
					cMess = cMess + CHR(13)+"The $/Lb number will be ignored."
				ENDIF
				IF nP_pc > 0
					cMess = cMess + CHR(13)+"The $/PC number will be ignored."
				ENDIF
				IF nP_ft > 0
					cMess = cMess + CHR(13)+"The $/Ft number will be ignored."
				ENDIF
				IF nLotP > 0
					cMess = cMess + CHR(13)+"The $Lot number will be ignored."
				ENDIF
				cMess = cMess +CHR(13)+"Please only use the 'Other' to hold the $/Inch price."
			ELSE
				IF nP_lb > 0
					cMess = cMess + "$/Lb number will be ignored."
				ENDIF
				IF nP_pc > 0
					cMess = cMess + "$/Pc number will be ignored."
				ENDIF
				IF nP_ft > 0
					cMess = cMess + "$/Ft number will be ignored."
				ENDIF
				IF nLotP > 0
					cMess = cMess + "$Lot number will be ignored."
				ENDIF
			ENDIF
			IF nP_lb + nP_pc + nP_ft + nLotP > 0
				MESSAGEBOX( cMess, 32,"Bad combination of Quote price.")
			ENDIF
		CASE nLotP > 0
			nQ_PU = 4
			cQ_PU = "$Lot"
			IF nP_lb > 0
				MESSAGEBOX("This Quote has a Lot Price."+CHR(13)+"The $/Lb number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
			IF nP_pc > 0
				MESSAGEBOX("This Quote has a Lot Price."+CHR(13)+"The $/Pc number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
			IF nP_ft > 0
				MESSAGEBOX("This Quote has a Lot Price."+CHR(13)+"The $/Ft number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
		
		CASE nP_lb > 0
			nQ_PU = 1
			cQ_PU = "$/# "
			IF nP_pc > 0
				MESSAGEBOX("This Quote has a $/Lb Price."+CHR(13)+"The $/Pc number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
			IF nP_ft > 0
				MESSAGEBOX("This Quote has a $/Lb Price."+CHR(13)+"The $/Ft number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
			IF nLotP > 0
				MESSAGEBOX("This Quote has a $/Lb Price."+CHR(13)+"The $Lot number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
		
		CASE nP_Ft > 0
			nQ_PU = 2
			cQ_PU = "$/Ft"
			IF nP_lb > 0
				MESSAGEBOX("This Quote has a $/Ft Price."+CHR(13)+"The $/Lb number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
			IF nP_pc > 0
				MESSAGEBOX("This Quote has a $/Ft Price."+CHR(13)+"The $/Pc number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
			IF nLotP > 0
				MESSAGEBOX("This Quote has a $/Ft Price."+CHR(13)+"The $Lot number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
			
		CASE nP_Pc > 0
			nQ_PU = 3
			cQ_PU = "$/PC"
			IF nP_lb > 0
				MESSAGEBOX("This Quote has a $/Pc Price."+CHR(13)+"The $/Lb number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
			IF nP_ft > 0
				MESSAGEBOX("This Quote has a $/Pc Price."+CHR(13)+"The $/Ft number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
			IF nLotP > 0
				MESSAGEBOX("This Quote has a $/Pc Price."+CHR(13)+"The $Lot number will be ignored."+CHR(13)+"Please only use one price.",32,"Bad combination of Quote price.")
			ENDIF
		
		OTHERWISE 
			
			 
		ENDCASE
		
		
		
		
		
		*Check for Prefered PU
		PRIVATE cQuotesCompany, nCustID, nPU, cPU
		cQuotesCompany	= PrepareSQLtxt(ThisFormSet.Quotes.COMPANY1.Value,'Company',30)
		cCustID			= PrepareSQLtxt(ThisFormSet.Quotes.CustID1.Value,'CustID',20)
		nPU = 0
		cPU = ''
		
		PRIVATE nSQLEXEC, cSQL
		
		IF USED("tmpQC_PU")
			USE IN tmpQC_PU
		ENDIF
		
		cSQL = "SELECT PU FROM dbo.QuickCompany WITH(NOLOCK) "
		cSQL = cSQL + " WHERE Company LIKE '"+cQuotesCompany+"%'"
		IF NOT EMPTY(cCustID)
			cSQL = cSQL + " AND Customer = '"+cCustID+"'"
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpQC_PU' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpQC_PU' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQC_PU")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpQC_PU")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tmpQC_PU' )
		ENDIF
		
		IF USED('tmpQC_PU')
			IF RECCOUNT('tmpQC_PU') > 0
				nPU	= PrepareSQLnum(tmpQC_PU.PU,'PU',1)
				ThisFormset.QUOTES.pf1.PagePricing.cmbPU.Value = nPU
				ThisFormset.QUOTES.pf1.PagePricing.cmbPU.Refresh
		*		ThisFormset.QUOTES.pf1.PagePricing.cmbPU.Refresh
			ELSE
				*MESSAGEBOX("Cannot verify Quoted Email was read.",48,"No record was found")
			ENDIF
			USE IN tmpQC_PU
		ENDIF
		
		
		IF nPU > 0 AND nQ_PU > 0
			*IF nQ_PU <> nPU
			cPU = Get_cPUfrom_nPU(nQ_PU, gnConnHandle)
			IF ALLTRIM(cPU) <> ALLTRIM(cQ_PU)
				WAIT WINDOW "This is not the Preferred (PU) Price Unit."+CHR(13)+CHR(13)+cQ_PU+" is the Prefered PU for this Company. "+CHR(13)+cPU+" is the PU for this Quote."+CHR(13)+CHR(13)+"The Preferred PU is set in the Quick Company table." +CHR(13)+"Any key to continue..."
				*MESSAGEBOX("The Prefered PU for this Company is "+cQ_PU+CHR(13)+"This Quote is for PU "+cPU+CHR(13)+CHR(13)+"The Preferred PU is set in the Quick Qoutes table.",48,"This is not the Preferred Price Unit.")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE convertthis		&& Metric conversions and math functions.
		PARAMETER lcInputValue
		*ThisFormSet.ConvertThis()
		
		PRIVATE lcUPPERInputValue, nCalcValue, nStartVal 
		PRIVATE nDecimal
		lcUPPERInputValue = UPPER(ALLTRIM(lcInputValue))
		IF "/" $ lcUPPERInputValue 
			PRIVATE nSpacePos, nDividePos, nPreSpaceValue, cAfterSpace, nAfterSpaceValue, nCalcValue 
			PRIVATE nNominator ,nDeNominator
			*Check for a space like 2 1/2"
			nDividePos = AT("/",lcUPPERInputValue)
			nSpacePos = AT(" ", (lcUPPERInputValue) )
			IF nSpacePos > 0 AND nSpacePos < nDividePos &&Check for a space before divide like 2 1/2"
				*Save the space pre space value
				nPreSpaceValue = VAL( LEFT( ( lcUPPERInputValue ), nSpacePos ) )
				cAfterSpace    = ALLTRIM( RIGHT( ( lcUPPERInputValue ), LEN(( lcUPPERInputValue )) - nSpacePos ) )
				
				nDividePos = AT("/", cAfterSpace )
				nAfterSpaceValue = VAL( LEFT( cAfterSpace, nDividePos ) ) / VAL( RIGHT( cAfterSpace, LEN(cAfterSpace) - nDividePos ) )
				lcInputValue = STR( nPreSpaceValue + nAfterSpaceValue, 10, 3)
			ELSE
				nNominator =  VAL( LEFT( lcUPPERInputValue , nDividePos ) )
				nDeNominator = VAL( RIGHT( lcUPPERInputValue , LEN(lcUPPERInputValue ) - nDividePos ) )
				lcInputValue = STR( nNominator  / nDeNominator , 9, 3)
				*If $/LB,$/Pc,$/Ft and Denomator is fraction like .85, Store Nominator to QuoteMemo Field
				IF INLIST(ThisFormSet.MetricGOTFocus,"P_FT1","P_PC1","P_LB1")
					IF nDeNominator < 1 and nDeNominator > .6
						IF NOT ALLTRIM(STR(nNominator,9,0)) $ ALLTRIM(ThisFormset.QUOTES.pf1.PageQuote.edtQuoteMemo.Value)
							PRIVATE cFraction
							cFraction = ALLTRIM(STR(nNominator,9,2))+ IIF(ThisFormSet.MetricGOTFocus="P_FT1","/FT",IIF(ThisFormSet.MetricGOTFocus="P_PC1","/PC",IIF(ThisFormSet.MetricGOTFocus="P_LB1","/LB","")))
							ThisFormset.QUOTES.pf1.PageQuote.edtQuoteMemo.Value = ALLTRIM(ThisFormset.QUOTES.pf1.PageQuote.edtQuoteMemo.Value)+CHR(13)+cFraction
							TrackMess( "Quotes12:ConvertThis() "+ShowSQLtxt(ThisFormset.QUOTES.pf1.PageQuote.edtQuoteMemo.Value,'QuoteMemo',-1) )
							*Tried CHR(13), changed to CHR(10) on 2004-7-21
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE nMathPos
		IF "*" $ lcUPPERInputValue 
			nMathPos= AT("*",lcUPPERInputValue)
			lcInputValue = STR( VAL( LEFT( lcUPPERInputValue , nMathPos) ) * VAL( RIGHT( lcUPPERInputValue , LEN(lcUPPERInputValue ) - nMathPos) ), 9, 3)
		ENDIF
		IF "+" $ lcUPPERInputValue 
			nMathPos= AT("+",lcUPPERInputValue)
			lcInputValue = STR( VAL( LEFT( lcUPPERInputValue , nMathPos) ) + VAL( RIGHT( lcUPPERInputValue , LEN(lcUPPERInputValue ) - nMathPos) ), 9, 3)
		ENDIF
		IF "-" $ lcUPPERInputValue 
			nMathPos= AT("-",lcUPPERInputValue)
			lcInputValue = STR( VAL( LEFT( lcUPPERInputValue , nMathPos) ) - VAL( RIGHT( lcUPPERInputValue , LEN(lcUPPERInputValue ) - nMathPos) ), 9, 3)
		ENDIF
		
		
		PRIVATE nDecimal
		nDecimal = SET("Decimal")
		IF ThisFormSet.MetricGotFocus = "THCK1" OR ThisFormSet.MetricGotFocus = "ssTHCK1"	
			SET DECIMAL TO 4
		ELSE
			SET DECIMAL TO 3
		ENDIF
		***
		nCalcValue = VAL(lcInputValue)
		***
		IF ThisFormSet.MetricGotFocus = "THCK1" OR ThisFormSet.MetricGotFocus = "ssTHCK1"
			SET DECIMAL TO (nDecimal)
		ENDIF
		
		DO CASE
		CASE "'" $ lcUPPERInputValue OR "FT" $ lcUPPERInputValue OR "FEET" $ lcUPPERInputValue 
			nCalcValue = VAL(lcInputValue) * 12
		CASE "CM" $ lcUPPERInputValue 
			nCalcValue = VAL(lcInputValue) * .3937
		CASE "MM" $ lcUPPERInputValue 
			nCalcValue = VAL(lcInputValue) * .03937
		CASE "M" $ lcUPPERInputValue 
			IF LEFT(lcUPPERInputValue,1) = "M"
				IF ThisFormSet.MetricGotFocus = "THCK1"
					ThisFormset.QUOTES.ChkMetric.Value = 1
					ThisFormset.QUOTES.ChkMetric.Refresh
				ENDIF
				nCalcValue = VAL(RIGHT(lcInputValue,LEN(lcInputValue)-1))
			ELSE
				nCalcValue = VAL(lcInputValue) * 39.37
			ENDIF
		CASE "KG" $ lcUPPERInputValue 
			nCalcValue = VAL(lcInputValue) * 2.2
		CASE "G" $ lcUPPERInputValue 
			*Gage
			nStartVal = VAL(lcInputValue)
				DO CASE
				CASE nStartVal  = 0
					nCalcValue = .312
				CASE nStartVal  = 1
					nCalcValue = .281
				CASE nStartVal  = 2
					nCalcValue = .265
				CASE nStartVal  = 3
					nCalcValue = .25
				CASE nStartVal  = 4
					nCalcValue = .234
				CASE nStartVal  = 5
					nCalcValue = .218
				CASE nStartVal  = 6
					nCalcValue = .203
				CASE nStartVal  = 7
					nCalcValue = .187
				CASE nStartVal  = 8
					nCalcValue = .172
				CASE nStartVal  = 9
					nCalcValue = .156
				CASE nStartVal  = 10
					nCalcValue = .141
				CASE nStartVal  = 11
					nCalcValue = .125
				CASE nStartVal  = 12
					nCalcValue = .109
				CASE nStartVal  = 13
					nCalcValue = .094
				CASE nStartVal  = 14
					nCalcValue = .078
				CASE nStartVal  = 15
					nCalcValue = .070
				CASE nStartVal  = 16
					nCalcValue = .063
				CASE nStartVal  = 17
					nCalcValue = .056
				CASE nStartVal  = 18
					nCalcValue = .050
				CASE nStartVal  = 19
					nCalcValue = .044
				CASE nStartVal  = 20
					nCalcValue = .038
				CASE nStartVal  = 21
					nCalcValue = .034
				CASE nStartVal  = 22
					nCalcValue = .031
				CASE nStartVal  = 23
					nCalcValue = .028
				CASE nStartVal  = 24
					nCalcValue = .025
				CASE nStartVal  = 25
					nCalcValue = .020
				CASE nStartVal  = 26
					nCalcValue = .018
					
				CASE nStartVal  = 27
					nCalcValue = .017
				CASE nStartVal  = 28
					nCalcValue = .0156
				CASE nStartVal  = 29
					nCalcValue = .014
				CASE nStartVal  = 30
					nCalcValue = .0125
				CASE nStartVal  = 31
					nCalcValue = .011
				CASE nStartVal  = 32
					nCalcValue = .010
				CASE nStartVal  = 33
					nCalcValue = .009
				CASE nStartVal  = 34
					nCalcValue = .0085
				CASE nStartVal  = 35
					nCalcValue = .0078
				CASE nStartVal  = 36
					nCalcValue = .007
				CASE nStartVal  = 38
					nCalcValue = .006
					
					
				OTHERWISE
					wait window "Gage not Programed!"
				ENDCASE		
		OTHERWISE
		
			IF PrepareSQLlogic(Quotes.Metric,'Metric',.F.)
			*IF PrepareSQLlogic( ThisformSet.Quotes.chkMetric.Value ,'Metric',.F.)
				IF NOT "M" $ UPPER(lcInputValue)
					*Keep the Metric Equalvant
					cMetricValue = "Near "+ ThisFormSet.ConvertToMetric( lcInputValue )
					DO CASE
					CASE ThisFormSet.MetricGotFocus = "THCK1"
						REPLACE Quotes.Sz1Orig WITH cMetricValue IN Quotes
						ThisFormSet.QUOTES.pf1.PageQA.Sz1Orig.Refresh
						
					CASE ThisFormSet.MetricGotFocus = "SZ21"
						REPLACE Quotes.Sz2Orig WITH cMetricValue IN Quotes
						ThisFormSet.QUOTES.pf1.PageQA.Sz2Orig.Refresh
						
					CASE ThisFormSet.MetricGotFocus = "SZ31"
						REPLACE Quotes.Sz3Orig WITH cMetricValue IN Quotes
						ThisFormSet.QUOTES.pf1.PageQA.Sz3Orig.Refresh
						
					ENDCASE
				ENDIF
			ENDIF
		ENDCASE
		
		RETURN nCalcValue
	ENDPROC

	PROCEDURE converttometric		&& ConvertToMetric
		PARAMETERS pcInch
		*ThisFormSet.ConvertToMetric()
		
		PRIVATE nInch, cReturnMetric
		
		PRIVATE nDecimal
		nDecimal = SET("Decimal")
		SET DECIMAL TO 4
		
		nInch  = VAL(pcInch)
		
		DO CASE
		CASE nInch < 1
			cReturnMetric = REMOVE0((nInch * 25.4),10,1)+"mm"
		CASE nInch < 39.4
			cReturnMetric = REMOVE0((nInch * 2.54),10,2)+"cm"
		OTHERWISE	
			cReturnMetric = REMOVE0((nInch * 0.0254),10,3)+"m"
		ENDCASE
		
		SET DECIMAL TO (nDecimal)
		RETURN cReturnMetric
	ENDPROC

