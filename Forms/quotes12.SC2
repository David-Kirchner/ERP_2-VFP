	ENDPROC

	PROCEDURE QUOTES.INQNUM1.Click
		PRIVATE cCurSalesP, cStndSalesP
		*cCurSalesP	= PrepareSQLtxt(ThisForm.cmbFilterSalesP.Value,'SalesP',1)
		cCurSalesP	= PrepareSQLtxt(ThisForm.SalesP1.Value,'SalesP',1)
		cStndSalesP	= PrepareSQLtxt(ThisForm.txtSalesP.Value,'SalesP',1)
		
		IF LEN(ALLTRIM( cStndSalesP ))>0
			IF cCurSalesP <> cStndSalesP
				WAIT WINDOW "Caution! This Inqnum is not for you "+cStndSalesP+", it is for "+cStndSalesP+"." Timeout 1
			ENDIF
		ENDIF
		
				
				
	ENDPROC

	PROCEDURE QUOTES.LBLDESCRIPT1.Click
		PRIVATE cText
		*cText = ThisFormSet.QuotesDescription( Quotes.Form, Quotes.thck, Quotes.sz2, Quotes.sz3 )
		*IF EMPTY(cText)
		*	cText = "No description Detail to show!"
		*ENDIF
		*MESSAGEBOX( cText,0+64,"Description" )
		
		
		cText = ItemDescriptionMetric(Quotes.Form, Quotes.Thck, Quotes.SZ2, Quotes.SZ3, Quotes.Weight, Quotes.RandLen, Quotes.Metric, Quotes.Sz1orig, Quotes.Sz2orig, Quotes.Sz3orig) 
		IF EMPTY(cText)
			MESSAGEBOX( "No description Detail to show!", 64)
		ELSE
			IF ThisFormSet.isediting
				IF MESSAGEBOX( cText+CHR(13)+CHR(13)+"Do you want to copy to Description line?",4+32,"Description" ) = 6
					ThisForm.DESCRIPT1.Value = cText
				ENDIF
			ELSE
				MESSAGEBOX( cText,0+64,"Description" )
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE QUOTES.lblExportSearch.Click
		*RUN [\\Windfall\HPA.local\Installs\HPA_App\ExportSearch.exe "n:High Performance Alloys" "a:1985E 500N" f:True ]
		DECLARE INTEGER ShellExecute IN shell32.dll INTEGER hndWin, STRING cAction, STRING cFileName, STRING cParams, STRING cDir, INTEGER nShowWin
		PRIVATE cFileName, cAction, cParameters
		cFileName = "\\Windfall.HPA.local\Installs\HPA_App\ExportSearch.Exe"
		cAction = "open"
		cParameters = ''
		
		PRIVATE cCompany, cCustID, cAddress, cPO_num, nSalesNum, cInqNumP
		cCompany	= PrepareSQLtxt(Quotes.Company,'Company',50)
		cCustID 	= PrepareSQLtxt(Quotes.CustID,'CustId',20)
		*cAddress	= "1985E 500N"
		cAddress	= GetStreetAddress(cCompany,cCustID,gnConnHandle)
		
		cPO_num		= PrepareSQLtxt(Quotes.PO_Num,'POnum',17)
		nSalesNum	= PrepareSQLnum(Quotes.SalesNum,'SalesNum',-3)
		cInqNumP	= PrepareSQLtxt(Quotes.InqNumP,'InqNumP',11)
		
		IF NOT EMPTY(cCompany)
			cParameters = cParameters+[ "n:]+ALLTRIM(cCompany)+["]
			IF NOT EMPTY(cAddress)
				cParameters = cParameters+[ "a:]+ALLTRIM(cAddress)+["]
			ENDIF
			
			cParameters = cParameters+[ f:True]
			
			IF NOT EMPTY(cPO_Num)
				cParameters = cParameters+[ p:]+ALLTRIM(cPO_num)
			ENDIF
			IF nSalesNum > 0
				cParameters = cParameters+[ s:]+ALLTRIM(STR(nSalesNum))
			ENDIF
			IF NOT EMPTY(cInqNumP)
				cParameters = cParameters+[ i:]+ALLTRIM(cInqNumP)
			ENDIF
		
			cParameters = cParameters+[ v:3 ]
		
			ShellExecute(0,cAction,cFileName,cParameters,"",1)
			
		ENDIF
	ENDPROC

