	ENDPROC

	PROCEDURE frmSources.lblSCompany.Click
		PRIVATE cReturnValue  
		DO FORM Forms\SelectSourceCompany TO cReturnValue  
		*SourcePH.Person+SourcePH.Company+SourcePH.Phone+SourcePH.fax+SourcePH.email+SourcePH.email2
		
		IF NOT EMPTY( cReturnValue )
		*	cPerson  = SUBSTR( cReturnValue, 1, 15 )
			cCompany = SUBSTR( cReturnValue, 16, 30 )
		*	cPhone   = SUBSTR( cReturnValue, 46, 10 )
		*	cFax     = SUBSTR( cReturnValue, 56, 10 )
		*	cEmail   = SUBSTR( cReturnValue, 66, 60 )
		*	cEmail2  = SUBSTR( cReturnValue, 126, 60 )
		
			ThisForm.txtSCompany.Value = ShowSQLtxt(cCompany,'Company',30)
			
			
			PRIVATE nID 
			nID = 0
			*Get nID from cCompany.
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT ID FROM dbo.SourcePH WITH(NOLOCK) "
			cSQL = cSQL + " WHERE Company = '"+ALLTRIM(cCompany)+"'"
			
			IF USED("tmpID_Sources")
				USE IN tmpID_Sources
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpID_Sources')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpID_Sources')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpID_Sources")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpID_Sources")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tmpID_Sources')
			ELSE
				IF USED("tmpID_Sources")
					IF RECCOUNT('tmpID_Sources') > 0
						nID	= -(tmpID_Sources.ID)  &&Send as Negative to trigger Insert.
					ENDIF
					USE IN tmpID_Sources
				ENDIF
			ENDIF
			
			ThisForm.txtSphID.Value = nID
			
		ENDIF
		
	ENDPROC

