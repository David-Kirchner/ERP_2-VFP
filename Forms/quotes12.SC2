		*ThisFormSet.Refresh_Router() \hpa\libs\router.vcx"
		PRIVATE cSOitem, biID
		cSOitem   = PrepareSQLtxt(Quotes.SOItem,'SOitem',10)
		biID = '0'
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED("tmpID_Router")
			USE IN tmpID_Router
		ENDIF
		
		cSQL = "SELECT ID FROM Router.dbo.rtr "
		cSQL = cSQL + " WHERE rtr.SOitem = '"+cSOitem+"'"
		
			
		SELECT 0
		nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpID_Router')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpID_Router')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpID_Router")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpID_Router")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, gnConnHandle, nSQLEXEC, 'tmpID_Router')
		ENDIF
		IF USED("tmpID_Router")
