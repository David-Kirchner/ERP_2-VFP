	PROCEDURE cmdDeleteAlloy.Click
		*ThisForm.AlloyDelete()
		PRIVATE cAlloy, lOK
		cAlloy = ThisForm.txtAlloy.Value
		lOK = .T.
		
		*Check to see if Alloy is in use!
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.AllQuotes WHERE Alloy = '"+cAlloy+"'"
		
		IF USED("cntAlloy")
			SELECT cntAlloy
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
		ENDIF
		
		
		IF USED("cntAlloy")
			IF cntAlloy.Cntd > 0
				lOK = .F.
				MESSAGEBOX( "Alloy exist in AllQuotes table",0,"Cannot Delete Alloy")
			ENDIF
			USE IN cntAlloy
		ENDIF
		
		
		IF lOK
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.StockLst_Master WHERE Alloy = '"+cAlloy+"'"
		
			IF USED("cntAlloy")
				SELECT cntAlloy
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
			ENDIF
		
		
			IF USED("cntAlloy")
				IF cntAlloy.Cntd > 0
					lOK = .F.
					MESSAGEBOX( "Alloy exist in StockLst_Master table",0,"Cannot Delete Alloy")
				ENDIF
				USE IN cntAlloy
			ENDIF
		ENDIF
		
		
		IF lOK
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.BrokerLst_Master WHERE Alloy = '"+cAlloy+"'"
		
			IF USED("cntAlloy")
				SELECT cntAlloy
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
			ENDIF
		
		
			IF USED("cntAlloy")
				IF cntAlloy.Cntd > 0
					lOK = .F.
					MESSAGEBOX( "Alloy exist in BrokerLst_Master table",0,"Cannot Delete Alloy")
				ENDIF
				USE IN cntAlloy
			ENDIF
		ENDIF
		
		IF lOK
			PRIVATE cMess
			cMess = WhereisAlloyUsed(cAlloy, ThisForm.nConnHandle )
			IF NOT EMPTY(cMess)
				IF MESSAGEBOX(cMess+CHR(13)+CHR(13)+"Do you want to continue (Y)",4+32,"All places Alloy was found") = 7
					lOK = .F.
				ENDIF
			ENDIF
		ENDIF
		
		
		IF lOK
			IF MESSAGEBOX("Are you sure you want to delete alloy:"+cAlloy,4+32,"Delete Alloy?") = 6
				
				cSQL = "DELETE FROM dbo.Alloys WHERE Alloy = '"+cAlloy+"'"
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
				ENDIF
				********
				
				cSQL = "DELETE FROM dbo.Alloy WHERE Alloy = '"+cAlloy+"'"
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
					MESSAGEBOX("Could not delete",16,"Error")
				ENDIF
				********
				SELECT Alloy
				Skip -1
				cAlloy = Alloy.Alloy
			
				ThisForm.grdAlloy.RecordSource = ""
				ThisForm.LoadAlloy()  &&Need to refresh data!
		
				IF USED("Alloy")
					SELECT Alloy
					LOCATE FOR Alloy = cAlloy
									
					ThisForm.grdAlloy.RecordSource = "Alloy"	
					ThisForm.AlloyChanged()
					ThisForm.grdAlloy.SetFocus
					
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

