	PROCEDURE alloychanged		&& Refresh After Alloy Change
		PARAMETERS pAlloy
		*ThisForm.AlloyChanged()
		
		IF VARTYPE(pAlloy) != "C"
			*Parameter only needed when Alloy is renamed!
			pAlloy = ""
		ENDIF
		
		ThisForm.cmdEditAlloy.Caption = "Edit"
		ThisForm.txtAlloy.ReadOnly = .T.
		ThisForm.txtBrandName.ReadOnly = .T.
		ThisForm.txtUName.ReadOnly = .T.
		ThisForm.txtCertName.ReadOnly = .T.
		ThisForm.txtUNS.ReadOnly = .T.
		ThisForm.txtDensity.ReadOnly = .T.
		ThisForm.chkInventory.ReadOnly = .T.
		ThisForm.chkSurcharge.ReadOnly = .T.
		ThisForm.txtCo.ReadOnly = .T.
		ThisForm.txtCr.ReadOnly = .T.
		ThisForm.txtCu.ReadOnly = .T.
		ThisForm.txtFe.ReadOnly = .T.
		ThisForm.txtMo.ReadOnly = .T.
		ThisForm.txtMn.ReadOnly = .T.
		ThisForm.txtNb.ReadOnly = .T.
		ThisForm.txtNi.ReadOnly = .T.
		ThisForm.txtTi.ReadOnly = .T.
		ThisForm.txtV1.ReadOnly = .T.
		ThisForm.txtW1.ReadOnly = .T.
		
		IF USED('Alloy')
			IF NOT EMPTY(pAlloy)
				SELECT Alloy
				LOCATE FOR Alloy = pAlloy
				IF NOT FOUND('Alloy')
					WAIT WINDOW 'Alloy '+ALLTRIM(pAlloy)+' was not found!' NOWAIT
					GO BOTTOM
				ENDIF
			ENDIF
			
			ThisForm.txtAlloy.Value = Alloy.Alloy
			ThisForm.txtBrandName.Value = IIF( ISNULL(Alloy.BrandName),'',Alloy.BrandName)
			ThisForm.txtUName.Value = IIF( ISNULL(Alloy.UName),'',Alloy.UName)
			ThisForm.txtCertName.Value = IIF( ISNULL(Alloy.CertName),'',Alloy.CertName)
			ThisForm.txtUNS.Value = IIF( ISNULL(Alloy.UNS),'',Alloy.UNS)
			ThisForm.txtDensity.Value = IIF( ISNULL(Alloy.Density),0,Alloy.Density)
			ThisForm.chkInventory.Value = IIF( ISNULL(Alloy.Inventory),0,IIF(Alloy.Inventory="Y",1,0))
			ThisForm.chkSurcharge.Value = Alloy.Surcharge
			ThisForm.txtCo.Value = IIF( ISNULL(Alloy.Co),0,Alloy.Co)
			ThisForm.txtCr.Value = IIF( ISNULL(Alloy.Cr),0,Alloy.Cr)
			ThisForm.txtCu.Value = IIF( ISNULL(Alloy.Cu),0,Alloy.Cu)
			ThisForm.txtFe.Value = IIF( ISNULL(Alloy.Fe),0,Alloy.Fe)
			ThisForm.txtMo.Value = IIF( ISNULL(Alloy.Mo),0,Alloy.Mo)
			ThisForm.txtMn.Value = IIF( ISNULL(Alloy.Mn),0,Alloy.Mn)
			ThisForm.txtNb.Value = IIF( ISNULL(Alloy.Nb),0,Alloy.Nb)
			ThisForm.txtNi.Value = IIF( ISNULL(Alloy.Ni),0,Alloy.Ni)
			ThisForm.txtTi.Value = IIF( ISNULL(Alloy.Ti),0,Alloy.Ti)
			ThisForm.txtV1.Value = IIF( ISNULL(Alloy.V),0,Alloy.V)
			ThisForm.txtW1.Value = IIF( ISNULL(Alloy.W),0,Alloy.W)
			ThisForm.GetAlloys( Alloy.Alloy )
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE alloyedit
		IF ThisForm.cmdEditAlloy.Caption = "Edit"
			ThisForm.txtAlloy.ReadOnly = .F.
			ThisForm.txtBrandName.ReadOnly = .F.
			ThisForm.txtUName.ReadOnly = .F.
			ThisForm.txtCertName.ReadOnly = .F.
			ThisForm.txtUNS.ReadOnly = .F.
			ThisForm.txtDensity.ReadOnly = .F.
			ThisForm.chkInventory.ReadOnly = .F.
			ThisForm.chkSurcharge.ReadOnly = .F.
			ThisForm.txtCo.ReadOnly = .F.
			ThisForm.txtCr.ReadOnly = .F.
			ThisForm.txtCu.ReadOnly = .F.
			ThisForm.txtFe.ReadOnly = .F.
			ThisForm.txtMo.ReadOnly = .F.
			ThisForm.txtMn.ReadOnly = .F.
			ThisForm.txtNb.ReadOnly = .F.
			ThisForm.txtNi.ReadOnly = .F.
			ThisForm.txtTi.ReadOnly = .F.
			ThisForm.txtV1.ReadOnly = .F.
			ThisForm.txtW1.ReadOnly = .F.
			
			ThisForm.cmdEditAlloy.Caption = "Save"
			ThisForm.txtBrandName.SetFocus
		ELSE
		
			*Save Data
			PRIVATE cAlloy,cBrandName,cUName,cCertName
			PRIVATE nDensity, lInventory, lSurcharge
			PRIVATE nCo,nCu,nCr,nFe,nNi,nMo,nTi
			
			cAlloy = PrepareSQLtxt( ThisForm.txtAlloy.Value, "Alloy", 12)
			cBrandName = PrepareSQLtxt( ThisForm.txtBrandName.Value, "Brand Name", 20)
			cUName = PrepareSQLtxt( ThisForm.txtUName.Value, "Unified Name", 20)
			cCertName = PrepareSQLtxt( ThisForm.txtCertName.Value, "Cert Name", 20)
			cUNS = PrepareSQLtxt( ThisForm.txtUNS.Value, "UNS", 6)
			nDensity = PrepareSQLnum( ThisForm.txtDensity.Value, "Density", 5, 3)
			lInventory = PrepareSQLchk( ThisForm.chkInventory.Value, "Inventory")
			lSurcharge = PrepareSQLchk( ThisForm.chkSurcharge.Value, "Surcharge")
			nCo = PrepareSQLnum( ThisForm.txtCo.Value, "Co", 0, 6 )
			nCr = PrepareSQLnum( ThisForm.txtCr.Value, "Cr", 0, 6 )
			nCu = PrepareSQLnum( ThisForm.txtCu.Value, "Cu", 0, 6 )
			nFe = PrepareSQLnum( ThisForm.txtFe.Value, "Fe", 0, 6 )
			nMo = PrepareSQLnum( ThisForm.txtMo.Value, "Mo", 0, 6 )
			nMn = PrepareSQLnum( ThisForm.txtMn.Value, "Mn", 0, 6 )
			nNb = PrepareSQLnum( ThisForm.txtNb.Value, "Nb", 0, 6 )
			nNi = PrepareSQLnum( ThisForm.txtNi.Value, "Ni", 0, 6 )
			nTi = PrepareSQLnum( ThisForm.txtTi.Value, "Ti", 0, 6 )
			nV  = PrepareSQLnum( ThisForm.txtV1.Value, "V", 0, 6 )
			nW  = PrepareSQLnum( ThisForm.txtW1.Value, "W", 0, 6 )
			
			cSQL = "UPDATE dbo.Alloy SET "
			cSQL = cSQL+" BrandName='"+cBrandName+"'"	
			cSQL = cSQL+",UName='"+cUName+"'"	
			cSQL = cSQL+",CertName='"+cCertName+"'"
			cSQL = cSQL+",UNS='"+cUNS+"'"
			cSQL = cSQL+",Density="+STR(nDensity,5,3)
			cSQL = cSQL+",Inventory='"+IIF(lInventory,'Y','N')+"'"
			cSQL = cSQL+",Surcharge='"+IIF(lSurcharge,'1','0')+"'"
			cSQL = cSQL+",Co="+STR(nCo,9,6)
			cSQL = cSQL+",Cr="+STR(nCr,9,6)
			cSQL = cSQL+",Cu="+STR(nCu,9,6)
			cSQL = cSQL+",Fe="+STR(nFe,9,6)
			cSQL = cSQL+",Mo="+STR(nMo,9,6)
			cSQL = cSQL+",Mn="+STR(nMn,9,6)
			cSQL = cSQL+",Nb="+STR(nNb,9,6)
			cSQL = cSQL+",Ni="+STR(nNi,9,6)
			cSQL = cSQL+",Ti="+STR(nTi,9,6)
			cSQL = cSQL+",V="+STR(nV,9,6)
			cSQL = cSQL+",W="+STR(nW,9,6)
			cSQL = cSQL+" WHERE Alloy = '"+cAlloy+"'"
			
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
			ENDIF
		
			ThisForm.txtAlloy.ReadOnly = .T.
			ThisForm.txtBrandName.ReadOnly = .T.
			ThisForm.txtUName.ReadOnly = .T.
			ThisForm.txtCertName.ReadOnly = .T.
			ThisForm.txtUNS.ReadOnly = .T.
			ThisForm.txtDensity.ReadOnly = .T.
			ThisForm.chkInventory.ReadOnly = .T.
			ThisForm.chkSurcharge.ReadOnly = .T.
			ThisForm.txtCo.ReadOnly = .T.
			ThisForm.txtCr.ReadOnly = .T.
			ThisForm.txtCu.ReadOnly = .T.
			ThisForm.txtFe.ReadOnly = .T.
			ThisForm.txtMo.ReadOnly = .T.
			ThisForm.txtMn.ReadOnly = .T.
			ThisForm.txtNb.ReadOnly = .T.
			ThisForm.txtNi.ReadOnly = .T.
			ThisForm.txtTi.ReadOnly = .T.
			ThisForm.txtV1.ReadOnly = .T.
			ThisForm.txtW1.ReadOnly = .T.
			ThisForm.cmdEditAlloy.Caption = "Edit"
			
			ThisForm.grdAlloy.RecordSource = ""
			ThisForm.LoadAlloy()  &&Need to refresh data!
			
			IF USED("Alloy")
				SELECT Alloy
				LOCATE FOR Alloy = cAlloy
				ThisForm.grdAlloy.RecordSource = "Alloy"	
				ThisForm.grdAlloy.SetFocus
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE alloysedit
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE getalloys		&& refreshes tmpAlloys for sent Alloy
		PARAMETER pAlloy
		*ThisForm.GetAlloys( Alloy )
		IF VARTYPE(pAlloy) != "C"
			RETURN
		ENDIF
		
		ThisForm.grdAlloys.RecordSource = ""
		
		IF USED('tmpAlloys')
			USE IN tmpAlloys
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT Alloys FROM dbo.Alloys WHERE Alloy = '"+pAlloy+"'"
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpAlloys')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'tmpAlloys')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloys')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloys')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpAlloys')
		ENDIF
		
		ThisForm.grdAlloys.RecordSource = "tmpAlloys"
	ENDPROC

	PROCEDURE Init
		*DO FORM Forms\AlloyStandard
		
		PRIVATE cUser
		cUser = SYS(0)
		IF "David Kirchner" $ cUser
			ThisForm.cmdRenameAlloy.Visible = .T.
			ThisForm.cmdCombine.Enabled = .T.
		ENDIF
		
		ThisForm.AlloyChanged()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		ThisForm.LoadAlloy()
		ThisForm.LoadAlloys()
		
		SELECT Alloy
		*SET RELATION TO Alloy INTO Alloys
		*SET SKIP TO Alloys
	ENDPROC

	PROCEDURE loadalloy
		PRIVATE cSQL, nSQLEXEC
		*ThisForm.LoadAlloy()
		
		cSQL = "SELECT * FROM dbo.Alloy WITH(NOLOCK) ORDER BY Alloy "
		
		IF USED("Alloy")
			SELECT Alloy
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'Alloy')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'Alloy')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Alloy')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Alloy')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Alloy')
		ENDIF
		
		
		IF USED("Alloy")
			SELECT Alloy
			INDEX ON UPPER(Alloy) TAG UppAlloy
		ENDIF
		
	ENDPROC

	PROCEDURE loadalloys
		PRIVATE cSQL, nSQLEXEC
		*ThisForm.LoadAlloys()
		
		cSQL = "SELECT * FROM dbo.Alloys WITH(NOLOCK) ORDER BY Alloy "
		
		IF USED("Alloys")
			SELECT Alloys
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'Alloys')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'Alloys')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Alloys')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Alloys')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Alloys')
		ENDIF
		
		
		IF USED("Alloys")
			SELECT Alloys
			INDEX ON UPPER(Alloys) TAG UppAlloys
		ENDIF
		
	ENDPROC

	PROCEDURE showalloystandard
		*ShowAlloyStandard()
		
		ThisForm.cmdRetrun.Enabled = .T.
		
		ThisForm.cmdAddAlloy.Enabled = .T.
		ThisForm.cmdEditDensity.Enabled = .T.
		ThisForm.cmdRenameAlloy.Enabled = .T.
