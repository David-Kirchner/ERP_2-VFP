	PROCEDURE cmdFind.Click
		PRIVATE cFindAlloy
		cFindAlloy= ALLTRIM( PrepareSQLtxt(ThisForm.txtFindAlloy.Value,'Alloy',12) )
		
		PRIVATE lOK, lFound
		lOK = .T.
		lFound = .F.
		
		IF NOT EMPTY(cFindAlloy) 
			*Check Alloy in Alloys
			cSQL = "SELECT Alloy FROM dbo.Alloys WHERE Alloy = '"+cFindAlloy+"'"
			
			IF USED("cntAlloy")
				SELECT cntAlloy
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
			ENDIF
		
			IF USED("cntAlloy")
				IF NOT EMPTY(cntAlloy.Alloy)
					lFound = .T.
					SELECT Alloy
					LOCATE FOR Alloy = cntAlloy.Alloy
					IF NOT FOUND()
						MESSAGEBOX("This Alloy is messed up."+CHR(13)+"Found in Alloys (as Alloy)"+CHR(13)+" but not in Alloy table."+CHR(13)+"Try another spelling"+CHR(13)+CHR(13)+"Proc_SQL:UpdateAlloy( cOldAlloy, cNewAlloyName )",16,"Error")
						TrackMess( "Found in Alloys but not Alloy table:"+cFindAlloy )
						USE IN cntAlloy
						RETURN .F.
					ELSE
						
						ThisForm.grdAlloy.Refresh
						ThisForm.AlloyChanged()
					ENDIF				
					
					RETURN .T.
				ENDIF
			ENDIF
		
			IF NOT lFound
				*Check Alloy in Alloys
				cSQL = "SELECT Alloy FROM dbo.Alloys WHERE Alloys = '"+cFindAlloy+"'"
				
				IF USED("cntAlloy")
					SELECT cntAlloy
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
				ENDIF
		
				IF USED("cntAlloy")
					IF RECCOUNT("cntAlloy")> 0
						SELECT Alloy
						LOCATE FOR Alloy = cntAlloy.Alloy
		
						ThisForm.grdAlloy.Refresh
						ThisForm.AlloyChanged()
						USE IN cntAlloy
						RETURN .T.
					ENDIF
				ENDIF
			ENDIF
		
			************************
			*LIKE
				*Check Alloy in Alloys
				cSQL = "SELECT Alloy FROM dbo.Alloys WHERE Alloys LIKE '%"+cFindAlloy+"%'"
				
				IF USED("cntAlloy")
					SELECT cntAlloy
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
				ENDIF
		
				IF USED("cntAlloy")
					IF RECCOUNT("cntAlloy")> 0
					
						
						SELECT Alloy
						LOCATE FOR Alloy = cntAlloy.Alloy
						ThisForm.grdAlloy.Refresh
						ThisForm.AlloyChanged()
						USE IN cntAlloy
						RETURN .T.
					ELSE
						MESSAGEBOX("Alloy '"+ALLTRIM(cFindAlloy)+"' not Found",0+48,"Alloy not Found")
					ENDIF
				ELSE
					MESSAGEBOX("Alloy '"+ALLTRIM(cFindAlloy)+"' not Found",0+48,"Alloy not Found")
				ENDIF
		
		
		ENDIF
		
	ENDPROC

	PROCEDURE cmdRenameAlloy.Click
		ThisForm.cmdRetrun.Enabled = .F.
		
		ThisForm.cmdAddAlloy.Enabled = .F.
		ThisForm.cmdEditDensity.Enabled = .F.
		ThisForm.cmdRenameAlloy.Enabled = .F.
		ThisForm.cmdCombine.Enabled = .F.
		ThisForm.cmdEditAlloy.Enabled = .F.
		ThisForm.cmdDeleteAlloy.Enabled = .F.
		ThisForm.grdAlloy.Enabled = .F.
		
		ThisForm.cmdAddAlloys.Enabled = .F.
		ThisForm.cmdEditAlloys.Enabled = .F.
		ThisForm.cmdDeleteAlloys.Enabled = .F.
		ThisForm.grdAlloys.Enabled = .F.
		
		ThisForm.cmdSave.Enabled = .T.
		ThisForm.cmdAbort.Enabled = .T.
		ThisForm.cmdSave.VISIBLE = .T.
		ThisForm.cmdAbort.Visible = .T.
		
		ThisForm.LabelA.Caption = "Old Alloy"
		ThisForm.LabelA.ENABLED = .T.
		ThisForm.LabelA.Visible = .T.
		ThisForm.LabelB.Caption = "New Name"
		ThisForm.LabelB.Visible = .T.
		ThisForm.LabelB.Enabled = .T.
		
		ThisForm.TextA.Value = Alloy.Alloy
		ThisForm.TextA.Enabled = .F.
		ThisForm.TextA.Visible = .T.
		ThisForm.TextB.Value = Alloy.Alloy
		ThisForm.TextB.Enabled = .T.
		ThisForm.TextB.Visible = .T.
		
		ThisForm.TextA.SetFocus
	ENDPROC

	PROCEDURE cmdRetrun.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSave.Click
		PRIVATE cAlloy, cAlloys, nDensity
		cAlloy = ALLTRIM( PrepareSQLtxt(ThisForm.TextA.Value,'Alloy',12) )
		cAlloys = PrepareSQLtxt(ThisForm.TextB.Value,'Alloys',12)
		nDensity = 0
		
		PRIVATE lOK
		lOK = .T.
		PRIVATE cDoWhat , cMess
		cMess = ''
		
		
		DO CASE
		CASE ThisForm.LabelB.Caption = "AKA"
			cDoWhat = "AddAlloys"
		CASE ThisForm.LabelB.Caption = "Density Edit"
			cDoWhat = "DensityEdit"
			nDensity = PrepareSQLnum(ThisForm.TextB.Value,'Density',5,3)
		CASE ThisForm.LabelB.Caption = "Density"
			cDoWhat = "AddAlloy_"
			nDensity = PrepareSQLnum(ThisForm.TextB.Value,'Density',5,3)
		CASE ThisForm.LabelB.Caption = "New Name"
			cDoWhat = "RenameAlloy"
		CASE ThisForm.LabelB.Caption = "Combine as"
			cDoWhat = "Combine"
		OTHERWISE
			cDoWhat = ""
		ENDCASE
		PRIVATE lUpdateEdit
		lUpdateEdit = .f.
		
		DO CASE
		CASE cDoWhat = "AddAlloys"
			*Save Alloys AKA
			cAlloys = ALLTRIM( cAlloys )
			IF NOT EMPTY(cAlloy) AND NOT EMPTY(cAlloys)
				PRIVATE cTestAlloyStandard
				cTestAlloyStandard = GetAlloyStandard(cAlloys,ThisForm.nConnHandle) 
				IF NOT EMPTY( cTestAlloyStandard )
					lOK = .F.
					lUpdateEdit = .T.			 
					MESSAGEBOX( "Alloy AKA already exist in Alloys table"+CHR(13)+"for "+cTestAlloyStandard+CHR(13)+"This must be removed from Alloy Table first",0,"Cannot save Alloy AKA")
				ENDIF
				
				IF lOK
					PRIVATE cMess
					cMess = WhereisAlloyUsed(cAlloys, ThisForm.nConnHandle )
					IF NOT EMPTY(cMess)
						MESSAGEBOX("This name:"+ALLTRIM(cAlloys)+" will be as an Alias for "+ALLTRIM(cAlloy)+"."+CHR(13)+CHR(13)+cMess,0+48 ,"All places AKA was found") 
					ENDIF
					
					cMess = WhereisAlloyUsed(cAlloy, ThisForm.nConnHandle )
					IF NOT EMPTY(cMess)
						MESSAGEBOX(cMess+CHR(13)+CHR(13)+"This name:"+ALLTRIM(cAlloys)+" will be as an Alias for "+ALLTRIM(cAlloy)+".",0+48 ,"All places Alloy was found") 
					ENDIF
				ENDIF
					
				IF lOK
				*Save to Alloys
					cSQL = "INSERT INTO dbo.Alloys (Alloy,Alloys) VALUES ('"+cAlloy+"','"+cAlloys+"')"
				
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						lOK = .F.
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
					ENDIF
					
					ThisForm.GetAlloys( ThisForm.txtAlloy.Value )
					ThisForm.ShowAlloyStandard()
					
				ENDIF
				IF lOK
					*Update            old     new     &&in Proc_SQL, updates all Alloy in all tables!
					lOK = UpdateAlloy(cAlloys, cAlloy, ThisForm.nConnHandle )
				ENDIF
				IF lUpdateEdit
					*in Proc_SQL, updates all Alloy in all tables!
					lOK = UpdateAlloy(cAlloys, cAlloy, ThisForm.nConnHandle )
					IF lOK
						MESSAGEBOX('Updated History files with this Alloy.',64,'Updated.')
						ThisForm.ShowAlloyStandard()
					ENDIF
				ENDIF
			ELSE
				MESSAGEBOX("Cannot save",0,"")
				lOK = .F.
			ENDIF
		
		CASE cDoWhat = "AddAlloy_"
			*Add Alloy
		
			IF NOT EMPTY(cAlloy) 
				*Check Alloy in Alloy
				cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Alloy WHERE Alloy = '"+cAlloy+"'"
				
				IF USED("cntAlloy")
					SELECT cntAlloy
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
				ENDIF
		
		
				IF USED("cntAlloy")
					IF cntAlloy.Cntd > 0
						lOK = .F.
						MESSAGEBOX( "Alloy already exist in Alloy table",0,"Cannot save Alloy")
					ENDIF
					USE IN cntAlloy
				ENDIF
		
				*Check Alloy in Alloys
				cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Alloys WHERE Alloys = '"+cAlloy+"'"
				
				IF USED("cntAlloy")
					SELECT cntAlloy
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
				ENDIF
		
		
				IF USED("cntAlloy")
					IF cntAlloy.Cntd > 0
						lOK = .F.
						MESSAGEBOX( "Alloy already exist in Alloys table",0,"Cannot save Alloy")
					ENDIF
					USE IN cntAlloy
				ENDIF
				
				IF lOK
					*Save to Alloy
					cSQL = "INSERT INTO dbo.Alloy (Alloy,Density) VALUES ('"+cAlloy+"',"+STR(nDensity,5,3)+")"
				
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
					ENDIF
		
					*Save to Alloys
					cSQL = "INSERT INTO dbo.Alloys (Alloy,Alloys) VALUES ('"+cAlloy+"','"+cAlloy+"')"
				
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
					ENDIF
					
					ThisForm.grdAlloy.RecordSource = ""
					ThisForm.LoadAlloy()  &&Need to refresh data!
			
					IF USED("Alloy")
						SELECT Alloy
						LOCATE FOR Alloy = cAlloy
		
						ThisForm.grdAlloy.RecordSource = "Alloy"	
						ThisForm.AlloyChanged()
						ThisForm.grdAlloy.SetFocus
						
					ENDIF
					
					ThisForm.ShowAlloyStandard()
					
				ENDIF
			ELSE
				MESSAGEBOX("Cannot save Alloy.",0,"")
				lOK = .F.
			ENDIF
			
		CASE cDoWhat = "RenameAlloy" 
		
			cAlloys = ALLTRIM( cAlloys )
			IF NOT EMPTY(cAlloy) AND NOT EMPTY(cAlloys)
				PRIVATE lCreateAKA, cNewAlloyNAme, nCountNewNameinAlloys, nCountNewNameinAlloy
				lCreateAKA = .T.
				cNewAlloyName = cAlloys
				nCountNewNameinAlloys = 0
				nCountNewNameinAlloy = 0
				
				*Check Alloy in Alloys for AKA
				cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Alloys WHERE Alloys = '"+cNewAlloyName +"'"
				
				IF USED("cntAlloys")
					SELECT cntAlloys
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloys')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloys')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloys')
					lOK = .F.
				ENDIF
				
				IF USED('cntAlloys')
					nCountNewNameinAlloys = cntAlloys.Cntd
					USE IN cntAlloys
				ENDIF
				
				IF nCountNewNameinAlloys > 0
					MESSAGEBOX( "The New alloy name is already in use."+CHR(13)+"Use the [Combine] option!",0+32,"Cannot rename.")
					lUpdateAlloy = .F.
					lOK = .F.
				ENDIF
				
				IF lOK
					*Check for NewAlloyName in Alloy 
					PRIVATE lUpdateAlloy
					lUpdateAlloy = .T.
					
					cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Alloy WHERE Alloy = '"+cNewAlloyName +"'"
					
					IF USED("cntAlloy")
						SELECT cntAlloy
					ELSE
						SELECT 0
					ENDIF
		
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
						lOK = .F.
					ENDIF
					
					IF USED('cntAlloys')
						nCountNewNameinAlloy = cntAlloy.Cntd
						IF cntAlloy.Cntd > 0
							lUpdateAlloy = .F.
							lOK = .F.
						ENDIF
						USE IN cntAlloys
					ENDIF
					
					= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && Manual transactions
				ENDIF			
				IF lOK 
		
					IF nCountNewNameinAlloy > 0
						MESSAGEBOX( "The New alloy name is already listed as an alloy",0+32,"Error")
						lOK = .F.
					ELSE
						
						cSQL = "UPDATE dbo.Alloys SET Alloy = '"+cNewAlloyName+"' WHERE Alloy ='"+cAlloy+"'"	
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
							lOK = .F.
						ENDIF
					
					
						*cSQL = "DELETE FROM dbo.Alloy WHERE Alloy ='"+cAlloy+"'"
						cSQL = "UPDATE dbo.Alloy SET Alloy = '"+cNewAlloyName+"' WHERE Alloy ='"+cAlloy+"'"
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
							lOK = .F.
						ENDIF
		
					ENDIF
		
				ENDIF
		
		
				
				cMess = WhereisAlloyUsed(cAlloy, ThisForm.nConnHandle )
				IF NOT EMPTY(cMess)
					IF MESSAGEBOX(cMess+CHR(13)+CHR(13)+"Do you want to continue (Y)",4+32,"Rename Alloy in all these places?") = 7
						lOK = .F.
					ENDIF
				ENDIF
				
				**RENAME**
				*Update Alloy
			
				IF lOK
					*run Update Alloy in Proc_SQL
					lOK = UpdateAlloy( cAlloy, cNewAlloyName, THISFORM.nConnHandle )
				ENDIF
		
				***********************************
				
				IF lOK
					= SQLCOMMIT(ThisForm.nConnHandle)
				ELSE
					= SQLROLLBACK(ThisForm.nConnHandle)
				ENDIF
				
				= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && Auto transactions
				
				ThisForm.grdAlloy.RecordSource = ""
				ThisForm.LoadAlloy()  &&Need to refresh data!
		
				IF USED("Alloy")
					SELECT Alloy
					IF lOK
						LOCATE FOR Alloy = (cNewAlloyName)
					ELSE
						LOCATE FOR Alloy = (cAlloys)
					ENDIF
		
					IF NOT FOUND('Alloy')
						GO TOP
					ENDIF
					
					ThisForm.grdAlloy.RecordSource = "Alloy"	
					ThisForm.AlloyChanged(cNewAlloyName)
					ThisForm.grdAlloy.SetFocus
					
				ENDIF
				
				ThisForm.ShowAlloyStandard()
				
				
			ELSE
				MESSAGEBOX("Cannot Save!",0,"")
				lOK = .F.
			ENDIF
			
		CASE cDoWhat = "Combine"
			
			cAlloys = ALLTRIM( cAlloys )
			IF EMPTY(cAlloy) 
				MESSAGEBOX("Did not get the Old Alloy",0,"Cannot run")
				ThisForm.ShowAlloyStandard()
				RETURN .F.
			ENDIF
			IF EMPTY(cAlloys)
				MESSAGEBOX("Did not get the Combine Alloy",0,"Cannot run")
				ThisForm.ShowAlloyStandard()
				RETURN .F.
			ENDIF
		
			PRIVATE lCreateAKA, cNewAlloyNAme, nCountNewNameinAlloys, nCountNewNameinAlloy
			lCreateAKA = .T.
			cNewAlloyName = cAlloys
			nCountNewNameinAlloys = 0
			nCountNewNameinAlloy = 0
			
			*Check Alloy in Alloys for AKA
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Alloys WHERE Alloys = '"+cNewAlloyName +"'"
			
			IF USED("cntAlloys")
				SELECT cntAlloys
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloys')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloys')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloys')
				lOK = .F.
			ENDIF
			
			IF USED('cntAlloys')
				nCountNewNameinAlloys = cntAlloys.Cntd
				USE IN cntAlloys
			ENDIF
			
			IF nCountNewNameinAlloys = 0
				MESSAGEBOX( "The New alloy name is not in use."+CHR(13)+"Use the [Rename] option!",0+32,"Cannot Combine.")
				lUpdateAlloy = .F.
				lOK = .F.
			ENDIF
			
			IF lOK
				*Check for NewAlloyName in Alloy 
				PRIVATE lUpdateAlloy
				lUpdateAlloy = .T.
				
				cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.Alloy WHERE Alloy = '"+cNewAlloyName +"'"
				
				IF USED("cntAlloy")
					SELECT cntAlloy
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'cntAlloy')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL , 'cntAlloy')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntAlloy')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntAlloy')
					lOK = .F.
				ENDIF
				
				IF USED('cntAlloys')
					nCountNewNameinAlloy = cntAlloy.Cntd
					IF cntAlloy.Cntd > 0
						lUpdateAlloy = .F.
						lOK = .F.
					ENDIF
					USE IN cntAlloys
				ENDIF
			ENDIF
					
			IF lOK 
				
				= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && Manual transactions
					
				*IF nCountNewNameinAlloy > 0
				*	MESSAGEBOX( "The New alloy name is already listed as an alloy",0+32,"Error")
				*	lOK = .F.
				*ELSE
					
				cSQL = "UPDATE dbo.Alloys SET Alloy = '"+cNewAlloyName+"' WHERE Alloy ='"+cAlloy+"'"	
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
					lOK = .F.
				ENDIF
			
			
				cSQL = "DELETE FROM dbo.Alloy WHERE Alloy ='"+cAlloy+"'"
				*cSQL = "UPDATE dbo.Alloy SET Alloy = '"+cNewAlloyName+"' WHERE Alloy ='"+cAlloy+"'"
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
					lOK = .F.
				ENDIF
		
				*ENDIF
		
			ENDIF
		
		
				
			cMess = WhereisAlloyUsed(cAlloy, ThisForm.nConnHandle )
			IF NOT EMPTY(cMess)
				IF MESSAGEBOX(cMess+CHR(13)+CHR(13)+"Do you want to continue (Y)",4+32,"Rename/Combine Alloy name in all these places?") = 7
					lOK = .F.
				ENDIF
			ENDIF
			
			**RENAME**
			*Update Alloy
		
			IF lOK
				*run Update Alloy in Proc_SQL
				lOK = UpdateAlloy( cAlloy, cNewAlloyName, THISFORM.nConnHandle )
			ENDIF
		
			***********************************
			
			IF lOK
				= SQLCOMMIT(ThisForm.nConnHandle)
			ELSE
				= SQLROLLBACK(ThisForm.nConnHandle)
			ENDIF
			
			= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && Auto transactions
			
			ThisForm.grdAlloy.RecordSource = ""
			ThisForm.LoadAlloy()  &&Need to refresh data!
		
			IF USED("Alloy")
				SELECT Alloy
				IF lOK
					LOCATE FOR Alloy = (cNewAlloyName)
				ELSE
					LOCATE FOR Alloy = (cAlloys)
				ENDIF
		
				IF NOT FOUND('Alloy')
					GO TOP
				ENDIF
				
				ThisForm.grdAlloy.RecordSource = "Alloy"	
				ThisForm.AlloyChanged(cNewAlloyName)
				ThisForm.grdAlloy.SetFocus
				
			ENDIF
			
			ThisForm.ShowAlloyStandard()
			
		CASE cDoWhat = "DensityEdit"
			*Edit Density
		
			IF NOT EMPTY(cAlloy) 
				*Update Density
				cSQL = "UPDATE dbo.Alloy SET Density = "+STR(nDensity,5,3)
				cSQL = cSQL+" WHERE Alloy = '"+cAlloy+"'"
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC)
				ENDIF
		
		
				
				ThisForm.grdAlloy.RecordSource = ""
				ThisForm.LoadAlloy()  &&Need to refresh data!
		
				IF USED("Alloy")
					SELECT Alloy
					LOCATE FOR Alloy = cAlloy
		
					ThisForm.grdAlloy.RecordSource = "Alloy"	
					ThisForm.AlloyChanged()
					ThisForm.grdAlloy.SetFocus
					
				ENDIF
				
				ThisForm.ShowAlloyStandard()
				
			ELSE
				MESSAGEBOX("Cannot save Alloy.",0,"")
			ENDIF
			
		ENDCASE
	ENDPROC

	PROCEDURE grdAlloy.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.AlloyChanged()
	ENDPROC

	PROCEDURE txtCertName.Valid
		PRIVATE cUN
		cUN = UPPER(This.Value)
		IF LEFT( cUN ,4 ) = "UNS "
			IF EMPTY(ThisForm.txtUNS.Value)
				ThisForm.txtUNS.Value = SUBSTR( cUNS, 5, 6 )
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE txtFindAlloy.Valid
		IF NOT EMPTY( This.Value )
			ThisForm.cmdFind.Click()
		ENDIF
	ENDPROC

	PROCEDURE txtUName.Valid
		PRIVATE cUN
		cUN = UPPER(This.Value)
		IF LEFT( cUN ,4 ) = "UNS "
			IF EMPTY(ThisForm.txtUNS.Value)
				ThisForm.txtUNS.Value = SUBSTR( cUN, 5, 6 )
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE
