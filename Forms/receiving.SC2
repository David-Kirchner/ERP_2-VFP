	PROCEDURE pf.pgRejectReason.txtReceived.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE('dDate') = "C"
				dDate = CtoD(ALLTRIM(This.Value))
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
				This.Value = DATE()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pf.pgRejectReason.txtReceivingID.Valid
		*!*	PRIVATE nID
		*!*	nID = This.Value
		
		*!*	IF TYPE("nID") = "U"
		*!*		nID = 0
		*!*	ENDIF
		*!*	IF TYPE("nID") = "C"
		*!*		nID = VAL(nID)
		*!*	ENDIF
		
		*!*	IF nID > 0
		*!*		ThisForm.GetBy_ReceivingID(nID)
		*!*	ENDIF
	ENDPROC

	PROCEDURE pf.pgRejectReason.txtSOitem.Valid
		PRIVATE cSOitem, nSalesNum, nItemSo
		cSOitem = PrepareSQLtxt(This.parent.parent.pgRejectReason.txtSOitem.Value,'SOitem',10)
		nSalesNum = Proper_SO_Item_SO(cSOitem)
		nItemSO = Proper_SO_Item_Item(cSOitem)
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		cPOitem = PrepareSQLtxt(This.parent.parent.pgRejectReason.txtPOitem.Value,'POitem',12)
		nHpaPo = Proper_PO_Item_PO(cPOitem)
		nItemPo = Proper_PO_Item_Item(cPOitem)
		
		IF nSalesNum > 0 AND nHpaPo=0 AND nItemPo=0
			ThisForm.GetSoItemDetail(cSOitem)
		ENDIF
	ENDPROC

