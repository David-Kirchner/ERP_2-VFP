		*!*			IF MESSAGEBOX("Do you want to look for a PO that used this heat number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
		*!*				PRIVATE nReceivingID
		*!*				nReceivingID	= This.Parent.txtReceivingID.Value
		*!*				*nReceivingID	= Receiving.ID
