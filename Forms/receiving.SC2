	ENDPROC

	PROCEDURE receive_workorder
		PARAMETERS nWO_Detail
		*ThisForm.Receive_WorkOrder(pnRMA)
		
		IF EMPTY(nWO_Detail)
			MESSAGEBOX("Cannot get WO.",0+32,"No WorkOrder")
			RETURN .F.
		ENDIF
		
		
		PRIVATE cPOitem, cSOitem
		cPOitem = ''
		cSOitem = ''
		
		cSOitem = PrepareSQLtxt(pcSOitem,'SOitem',10)
		
		IF cSOitem = Proper_SO_item('')
			MESSAGEBOX("Cannot process RMA return without the SOitem!"+CHR(13)+"RMA:"+ALLTRIM(STR(nRMA))+".",0+32,"No SO-item")
			RETURN .F.
		ENDIF
		
		PRIVATE nSalesNum, nItemSo
		nSalesNum = Proper_SO_Item_SO(cSOitem)
		nItemSO = Proper_SO_Item_Item(cSOitem)
		
		ThisForm.pf.pgRejectReason.txtSOnum.Value = nSalesNum 
		ThisForm.pf.pgRejectReason.txtSOitem.Value = nItemSo 
		
		
		
		*Get ID_Detail
		IF USED('tmpStockLst_Process_History')
			USE IN tmpStockLst_Process_History
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT ID_Detail, 'S' AS TBL FROM dbo.Ar_StockLst_Process_History WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ([WHAT] = 'SUBED     ' OR [WHAT] = 'DELETE')"
		
		cSQL = cSQL + " UNOIN "
		cSQL = cSQL + " SELECT ID_Detail, 'B' AS TBL FROM dbo.Ar_StockLst_Process_History WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ([WHAT] = 'SUBED     ' OR [WHAT] = 'DELETE')"
		
		cSQL = cSQL + " UNOIN "
		cSQL = cSQL + " SELECT ID_Detail, 'W' AS TBL FROM dbo.Ar_WIPLst_Process_History WITH(NOLOCK) "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ([WHAT] = 'SUBED     ' OR [WHAT] = 'DELETE')"
		
		cSQL = cSQL + " ORDER BY [WHAT] DESC "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process_History')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Process_History')
			MESSAGEBOX("Cannot process RMA return.",0+32,"No ID_Detail")
			RETURN .F.
		ENDIF
		
		PRIVATE nID_Detail, cTBL
		nID_Detail = 0
		cTBL =''
		IF USED('tmpStockLst_Process_History')
			IF VARTYPE(tmpStockLst_Process_History.ID_Detail) = "N"
				nID_Detail = tmpStockLst_Process_History.ID_Detail
				cTBL = PrepareSQLtxt(tmpStockLst_Process_History.TBL,'TBL',1)
			ENDIF
			USE IN tmpStockLst_Process_History
		ENDIF
		
		
		PRIVATE nStockLst_ID
		nStockLst_ID = Get_ID_with_ID_Detail(nID_Detail,cTBL,ThisForm.nConnHandle)
		
		
		**************** StockLst_Master 
		IF nStockLst_ID = 0
			MESSAGEBOX("Could not retrieve ID.",0+32,"No StockLst info")
			*RETURN .F.
		ENDIF
		
		DO CASE
		CASE cTBL = "S"
			cSQL = "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.StockLst_Master WITH(NOLOCK) WHERE ID = "+STR(nStockLst_ID)
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.Ar_Stocklst_Master_History WITH(NOLOCK) WHERE ID = "+STR(nStockLst_ID)
		CASE cTBL = "B"
			cSQL = "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.BrokerLst_Master WITH(NOLOCK) WHERE ID = "+STR(nStockLst_ID)
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.Ar_BrokerLst_Master_history WITH(NOLOCK) WHERE ID = "+STR(nStockLst_ID)
		CASE cTBL = "W"
			cSQL = "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.WIPLst_Master WITH(NOLOCK) WHERE ID = "+STR(nStockLst_ID)
			cSQL = cSQL + " UNION "
			cSQL = cSQL + "SELECT Alloy,Heat,Lot,Specs,Mill FROM dbo.Ar_WIPLst_Master_History WITH(NOLOCK) WHERE ID = "+STR(nStockLst_ID)
		OTHERWISE
			RETURN .F.
		ENDCASE
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstID')
			MESSAGEBOX("Could not retrieve ID Info.",0+32,"No StockLst info")
		ENDIF
		
		
		IF USED('tmpStockLstID')
			IF VARTYPE(tmpStockLstID.Alloy)="C" &&Alloy
				IF !EMPTY(tmpStockLstID.Alloy)
					ThisForm.pf.pgRejectReason.txtAlloy.Value = tmpStockLstID.Alloy
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Heat)="C" &&Heat
				IF !EMPTY(tmpStockLstID.Heat)
					ThisForm.pf.pgRejectReason.txtHeat.Value = tmpStockLstID.Heat
				ENDIF
			ENDIF
			
			IF VARTYPE(tmpStockLstID.Lot)="C" &&Lot
				IF !EMPTY(tmpStockLstID.Lot)
					ThisForm.pf.pgRejectReason.txtLot.Value = tmpStockLstID.Lot
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Specs)="C"  &&Specs
				IF !EMPTY(tmpStockLstID.Specs)
					ThisForm.pf.pgRejectReason.edtSpecs.Value = tmpStockLstID.Specs
				ENDIF
			ENDIF
		
			IF VARTYPE(tmpStockLstID.Mill)="C"  &&Mill 
				IF !EMPTY(tmpStockLstID.Mill)
					ThisForm.pf.pgRejectReason.txtVendor.Value = tmpStockLstID.Mill 
				ENDIF
			ENDIF
		
			USE IN tmpStockLstID
		ENDIF
		
		*************** StockLst_Detail 
		
		IF USED('tmpStockLstDetail')
			USE IN tmpStockLstDetail
		ENDIF
		
		DO CASE
		CASE cTBL = "S"
			cSQL = "SELECT PC, dbo.f_ItemDescription(dbo.f_StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.StockLst_Detail WITH(NOLOCK) WHERE ID_Detail ="+STR(nID_Detail)
			cSQL = cSQL + " Union "
			cSQL = cSQL + "SELECT PC, dbo.f_ItemDescription(dbo.f_StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.Ar_Stocklst_Detail_History WITH(NOLOCK) WHERE ID_Detail ="+STR(nID_Detail)
		CASE cTBL = "B"
			cSQL = "SELECT PC, dbo.f_ItemDescription(dbo.f_BrokerLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.BrokerLst_Detail WITH(NOLOCK) WHERE ID_Detail ="+STR(nID_Detail)
			cSQL = cSQL + " Union "
			cSQL = cSQL + "SELECT PC, dbo.f_ItemDescription(dbo.f_BrokerLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.Ar_BrokerLst_Detail_History WITH(NOLOCK) WHERE ID_Detail ="+STR(nID_Detail)
		CASE cTBL = "W"
			cSQL = "SELECT PC, dbo.f_ItemDescription(dbo.f_WIPLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.WIPLst_Detail WITH(NOLOCK) WHERE ID_Detail ="+STR(nID_Detail)
			cSQL = cSQL + " Union "
			cSQL = cSQL + "SELECT PC, dbo.f_ItemDescription(dbo.f_WIPLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.Ar_WIPlst_Detail_History WITH(NOLOCK) WHERE ID_Detail ="+STR(nID_Detail)
		ENDCASE
		*SELECT PC, dbo.f_ItemDescription(dbo.f_StockLstIDform(ID),dim1,dim2,dim3,Weight,RandLen) AS Description FROM dbo.StockLst_Detail WITH (NOLOCK) WHERE ID_Detail = 5657
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstDetail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstDetail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstDetail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstDetail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstDetail')
			MESSAGEBOX("Could not retrieve ID Detail Info.",0+32,"No StockLst info")
		ENDIF
		
		IF USED('tmpStockLstDetail')
			GO TOP
			IF VARTYPE(tmpStockLstDetail.PC)="N"  &&Pieces
				IF tmpStockLstDetail.PC > 0
					ThisForm.pf.pgRejectReason.txtPieces.Value = tmpStockLstDetail.PC
				ENDIF
			ENDIF
			IF VARTYPE(tmpStockLstDetail.Description)="C"  &&Description
				IF !EMPTY(tmpStockLstDetail.Description)
					ThisForm.pf.pgRejectReason.edtDescription.Value = tmpStockLstDetail.Description
				ENDIF
			ENDIF
			
			USE IN tmpStockLstDetail
		
		ENDIF
		
		********** Sales
		
		ThisForm.pf.pgRejectReason.txtActualW.Value		= 0
		ThisForm.pf.pgRejectReason.txtBillW.Value 		= 0
		
		cSQL = "SELECT matlwt FROM dbo.Sales WITH(NOLOCK) WHERE SOitem = '"+cSOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesWt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesWt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesWt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesWt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesWt')
			MESSAGEBOX("Could not retrieve Sales Weight.",0+32,"No info")
		ENDIF
		
		IF USED('tmpSalesWt')
			GO TOP
			IF VARTYPE(tmpSalesWt.matlwt)="N"  &&Pieces
				IF tmpSalesWt.matlwt > 0
					ThisForm.pf.pgRejectReason.txtActualW.Value = tmpSalesWt.matlwt 
					ThisForm.pf.pgRejectReason.txtBillW.Value = tmpSalesWt.matlwt 
				ENDIF
			ENDIF
			
			USE IN tmpSalesWt
		ENDIF
		
		*************** AllQuotes
		IF USED('tmpAllQuotes')
			USE IN tmpAllQuotes
		ENDIF
		
		cSQL = "SELECT Alloy,Pieces,dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Weight,RandLen) AS Description,Weight FROM dbo.AllQuotes WITH(NOLOCK) WHERE SOitem ='"+cSOitem+"'"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAllQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAllQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpAllQuotes')
			MESSAGEBOX("Could not retrieve AllQuotes Info.",0+32,"No StockLst info")
		ENDIF
		
		IF USED('tmpAllQuotes')
			GO TOP
			IF VARTYPE(tmpAllQuotes.Alloy)="C" &&Alloy
				IF !EMPTY(tmpAllQuotes.Alloy)
					ThisForm.pf.pgRejectReason.txtAlloy.Value = tmpAllQuotes.Alloy
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Pieces)="N"  &&Pieces
				IF tmpAllQuotes.Pieces > 0
					ThisForm.pf.pgRejectReason.txtPieces.Value = tmpAllQuotes.Pieces
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Description)="C"  &&Description
				IF !EMPTY(tmpAllQuotes.Description)
					ThisForm.pf.pgRejectReason.edtDescription.Value = tmpAllQuotes.Description
				ENDIF
			ENDIF
			IF VARTYPE(tmpAllQuotes.Weight)="N"  &&Weight 
				IF tmpAllQuotes.Weight > 0
					ThisForm.pf.pgRejectReason.txtActualW.Value = tmpAllQuotes.Weight 
					ThisForm.pf.pgRejectReason.txtBillW.Value = tmpAllQuotes.Weight 
				ENDIF
			ENDIF
			USE IN tmpAllQuotes
		ENDIF
			
		SELECT Receiving
		
	ENDPROC

	PROCEDURE receivingrefreshreceiving		&& RefreshReceiving
		*ThisForm.ReceivingRefreshReceiving()
		*Clears Form, reloads data
		ThisForm.pf.pgEdit.grdReceiving.RecordSource = ""
		ThisForm.pf.pgEdit.txtReceived.Value = ''
		ThisForm.pf.pgEdit.txtPOitem.Value = ''
		ThisForm.pf.pgEdit.txtSOitem.Value = ''
		ThisForm.pf.pgEdit.txtWO_Detail.Value = ''
		ThisForm.pf.pgEdit.txtVendor.Value = ''
		ThisForm.pf.pgEdit.txtAlloy.Value = ''
		ThisForm.pf.pgEdit.txtHeat.Value = ''
		ThisForm.pf.pgEdit.txtLot.Value = ''
		ThisForm.pf.pgEdit.chkCert.Value = 0
		ThisForm.pf.pgEdit.edtDescription.Value = ''
		ThisForm.pf.pgEdit.txtInit.Value = ''
		ThisForm.pf.pgEdit.txtDate.Value = ''
		ThisForm.pf.pgEdit.chkPass.Value = 0
		ThisForm.pf.pgEdit.edtSpecs.Value = ''
		ThisForm.pf.pgEdit.txtActualW.Value = ''
		ThisForm.pf.pgEdit.edtComments.Value = ''
		ThisForm.pf.pgEdit.txtBillW.Value = ''
		ThisForm.pf.pgEdit.chkCancel.Value = 0
		ThisForm.pf.pgEdit.chkMillTrace.Value = 0
		ThisForm.cmdDeleteReceiving.Enabled = PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		
		ThisForm.pf.pgBrowse.GridBR.RecordSource = ""
		
		ThisForm.pf.pgEdit.txtRejectPC.Value = ''
		ThisForm.pf.pgEdit.txtRejectReason.Value = ''
		
		ThisForm.pf.pgEdit.txtID_Detail.Value = 0
		
		PRIVATE nCurrRecvID
		nCurrRecvID = PrepareSQLnum(ThisForm.pf.pgEdit.txtReceivingID.Value,'RID',-3)
		IF nCurrRecvID = 0
			IF USED('Receiving')	
				nCurrRecvID = Receiving.ID
			ENDIF
		ENDIF
		IF USED('Receiving')	
			USE IN Receiving
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.Receiving ORDER BY ID"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Receiving')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Receiving')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Receiving")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Receiving")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Receiving')
			RETURN
		ELSE
			SELECT Receiving
			INDEX ON Received TAG RecvDate
			INDEX ON POitem TAG POitem
			INDEX ON INT(VAL(LEFT(PoItem,9))) TAG HPAPO
			INDEX ON INT(VAL(LEFT(SoItem,7))) TAG SalesNum
			
			INDEX ON UPPER(Vendor) TAG UppVendor
			INDEX ON UPPER(HEAT) TAG UppHeat
			INDEX ON SOitem TAG SOitem
			INDEX ON ID_Master TAG ID_Master
			INDEX ON ID TAG rID
			INDEX ON WO_Detail TAG WO_Detail
			INDEX ON RMA_NO TAG RMA_No
			INDEX ON RMA_Detail TAG RMA_Detail
			INDEX ON WO TAG WO
			
			SET ORDER TO TAG rID
			
			IF nCurrRecvID > 0
				SEEK nCurrRecvID ORDER TAG rID
			ENDIF
			SET ORDER TO RecvDate
		ENDIF
		
		
		ThisForm.pf.pgEdit.grdReceiving.RecordSource = "Receiving"
		*ThisForm.SetGridReceiving()
		
		ThisForm.pf.pgBrowse.GridBR.RecordSource = "Receiving"
		
		ThisForm.SetGridReceiving()
		
		ThisForm.RefreshEditTab()
		SELECT Receiving
		IF nCurrRecvID > 0
			LOCATE FOR ID = nCurrRecvID 
		ENDIF
	ENDPROC

	PROCEDURE refreshedittab
		*ThisForm.RefreshEditTab()
		PRIVATE cWhoAdd, cStkID, cStk, nID
		cWhoAdd = Receiving.WhoAdd
		IF NOT EMPTY(cWhoAdd)
			ThisForm.pf.pgEdit.txtWhoAdd.Value = ALLTRIM(cWhoAdd)
		ELSE
			ThisForm.pf.pgEdit.txtWhoAdd.Value = ''
		ENDIF
		
		cStkID = ''
		cStk = Receiving.StockTable
		IF NOT EMPTY( cStk )
			cStkID = ALLTRIM(cStk)
		ELSE
			cStk = ''
		ENDIF
		nID = Receiving.ID_Master
		IF nID > 0
			cStkID = ALLTRIM(cStk)+ALLTRIM(STR(nID))
			ThisForm.pf.pgEdit.cmdEditStockLst.Visible = .F.
		ELSE
			*Do not show for test reports, Equipement
			IF PO_POitem_Cnt(Receiving.POitem, ThisForm.nConnHandle ,'NotReceive') > 0
				ThisForm.pf.pgEdit.cmdEditStockLst.Visible = .T.
			ELSE
				ThisForm.pf.pgEdit.cmdEditStockLst.Visible = .F.
			ENDIF
		ENDIF
		
		ThisForm.pf.pgEdit.txtStkID.Value = cStkID
		
		ThisForm.pf.pgEdit.txtReceived.Refresh
		ThisForm.pf.pgEdit.txtPOitem.Refresh
		IF PrepareSQLtxt(Receiving.POitem,'POitem',12) = Proper_PO_item('')
			ThisForm.pf.pgEdit.txtPOitem.Visible = .F.
			ThisForm.pf.pgEdit.lblHpaPOnum.Visible = .F.
		ELSE
			ThisForm.pf.pgEdit.txtPOitem.Visible = .T.
			ThisForm.pf.pgEdit.lblHpaPOnum.Visible = .T.
		ENDIF
		
		ThisForm.pf.pgEdit.txtWO_Detail.Refresh
		IF PrepareSQLnum(Receiving.WO_Detail,'WO_Detail',-3) > 0
			ThisForm.pf.pgEdit.txtWO_Detail.Visible = .T.
		ELSE
			ThisForm.pf.pgEdit.txtWO_Detail.Visible = .F.
		ENDIF
		
		ThisForm.pf.pgEdit.txtSOitem.Refresh
		ThisForm.pf.pgEdit.txtVendor.Refresh
		ThisForm.pf.pgEdit.txtAlloy.Refresh
		ThisForm.pf.pgEdit.txtHeat.Refresh
		ThisForm.pf.pgEdit.txtLot.Refresh
		
		ThisForm.pf.pgEdit.chkAcctFinish.Refresh
		ThisForm.pf.pgEdit.chkCert.Refresh
		ThisForm.pf.pgEdit.chkPass.Refresh
		
		ThisForm.pf.pgEdit.edtDescription.Refresh
		ThisForm.pf.pgEdit.txtInit.Refresh
		ThisForm.pf.pgEdit.txtDate.Refresh
		
		ThisForm.pf.pgEdit.edtSpecs.Refresh
		ThisForm.pf.pgEdit.txtActualW.Refresh
		ThisForm.pf.pgEdit.edtComments.Refresh
		
		ThisForm.pf.pgEdit.txtRejectReason.Refresh
		
		ThisForm.pf.pgEdit.txtBillW.Refresh
		ThisForm.pf.pgEdit.txtPieces.Refresh
		ThisForm.pf.pgEdit.txtRejectPC.Refresh
		
		ThisForm.pf.pgEdit.txtWhoAdd.Refresh
		ThisForm.pf.pgEdit.txtWhenAdd.Refresh
		ThisForm.pf.pgEdit.txtReceivingID.Refresh
		ThisForm.pf.pgEdit.txtID_Detail.Refresh
		
		ThisForm.pf.pgEdit.chkPOcomplete.Value = ThisForm.PO_Complete()
		ThisForm.pf.pgEdit.chkCancel.Refresh
		ThisForm.pf.pgEdit.chkMillTrace.Value = PrepareSQLlogic(Receiving.MillTrace,'MillTrace')
		ThisForm.pf.pgEdit.chkOnHold.Value 	= PrepareSQLlogic(Receiving.Hold,'Hold')
		
		ThisForm.cmdDeleteReceiving.Enabled = PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		
		ThisForm.pf.pgEdit.txtRejectReason.Value = Receiving.RejectReason
		
		
		SELECT Receiving
	ENDPROC

	PROCEDURE refreshstocklst
		*ThisForm.RefreshStockLst()
		
		*ThisForm.cmdDeleteReceiving.Visible = .F.
		
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE nID_Master, nID_Detail, cTBL
		nID_Master = PrepareSQLnum(Receiving.ID_Master,'ID',-3)
		nID_Detail = PrepareSQLnum(Receiving.ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(Receiving.StockTable,'TBL',1)
		
		*--Clear Screen
		PRIVATE lFoundMasterHeat 
		lFoundMasterHeat = .F.
		*Reset
		*ThisForm.pf.pgStockLst.BackColor = RGB(240,240,240)
		ThisForm.pf.pgStockLst.ID1.DisabledBackColor = RGB(255,255,255)
		ThisForm.pf.pgStockLst.ID_Detail1.DisabledBackColor = RGB(255,255,255)
		
		ThisForm.pf.pgStockLst.Alloy1.Value		= ''
		ThisForm.pf.pgStockLst.ID1.Value		= 0
		ThisForm.pf.pgStockLst.ID_Detail1.Value		= 0
		ThisForm.pf.pgStockLst.txtTBL.Value		= ''
		ThisForm.pf.pgStockLst.Lot1.Value		= ''
		ThisForm.pf.pgStockLst.PO_Item1.Value	= ''
		ThisForm.pf.pgStockLst.txtForm.Value	= ' '
		ThisForm.pf.pgStockLst.txtCC.Value		= ''
		ThisForm.pf.pgStockLst.Specs1.Value		= ''
		ThisForm.pf.pgStockLst.Cond1.Value		= ''
		ThisForm.pf.pgStockLst.Heat1.Value		= ''
		ThisForm.pf.pgStockLst.Lot1.Value		= ''
		
		ThisForm.pf.pgStockLst.Size1.Value		= 0
		ThisForm.pf.pgStockLst.Paid1.Value		= 0
		ThisForm.pf.pgStockLst.MWeight1.Value		= 0
		
		ThisForm.pf.pgStockLst.PODueDate1.Value	= CTOD("  /  /  ")
		ThisForm.pf.pgStockLst.History1.Value	= ''
		ThisForm.pf.pgStockLst.StkDate1.Value	= CTOD("  /  /  ")
		ThisForm.pf.pgStockLst.txtPOStatus.Value= ''
		
		ThisForm.pf.pgStockLst.Mill1.Value		= ''
		ThisForm.pf.pgStockLst.Num1.Value		= 0
		ThisForm.pf.pgStockLst.From_ID1.Value	= 0
		
		ThisForm.pf.pgStockLst.PC1.Value 	= 0
		ThisForm.pf.pgStockLst.Size_L1.Value = 0
		ThisForm.pf.pgStockLst.Dim11.Value 	= 0
		ThisForm.pf.pgStockLst.Size_H1.Value = 0
		ThisForm.pf.pgStockLst.Dim21.Value 	= 0
		ThisForm.pf.pgStockLst.Dim31.Value 	= 0
		
		ThisForm.pf.pgStockLst.S_Qty.Value = 0
		ThisForm.pf.pgStockLst.Pounds1.Value = 0
		ThisForm.pf.pgStockLst.Descript1.Value = ''
		ThisForm.pf.pgStockLst.S_P.Value 	= 0
		ThisForm.pf.pgStockLst.InvoiceValue1.Value = 0
		
		ThisForm.pf.pgStockLst.chkPrime.Value = 0
		ThisForm.pf.pgStockLst.chkRandLen.Value = 0
		
		ThisForm.pf.pgStockLst.cmdRemoveDetail.Visible = .F.
		
		**cTBL
		***************************************
		IF USED("tmpStockLst_Master")
			USE IN tmpStockLst_Master
		ENDIF
		IF USED("tmpStockLst_Detail")
			USE IN tmpStockLst_Detail
		ENDIF
		
		IF nID_Master > 0
			cSQL = "SELECT *"
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + " ,'S' AS TBL "
				cSQL = cSQL + " FROM dbo.StockLst_Master "
			CASE cTBL = "B"
				cSQL = cSQL + " ,'B' AS TBL "
				cSQL = cSQL + " FROM dbo.BrokerLst_Master "
			CASE cTBL = "W"
				cSQL = cSQL + " ,'W' AS TBL "
				cSQL = cSQL + " FROM dbo.WIPLst_Master "
			ENDCASE
			cSQL = cSQL + " WITH(NOLOCK) WHERE ID = " + STR(nID_Master)
		
			lFoundMasterHeat = .T.
			*IF ThisForm.RefreshStockLst_Heat()
			ThisForm.pf.pgStockLst.ID1.Value = STR(nID_Master)
		
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master')
			ELSE
				IF USED("tmpStockLst_Master")
					IF RECCOUNT('tmpStockLst_Master') = 0
						ThisForm.pf.pgStockLst.ID1.DisabledBackColor = RGB(255,0,0)
					ENDIF
					
					ThisForm.pf.pgStockLst.Alloy1.Value		= PrepareSQLtxt(tmpStockLst_Master.Alloy,'Alloy',12)
					ThisForm.pf.pgStockLst.txtForm.Value	= PrepareSQLtxt(tmpStockLst_Master.Form,'Form',2)
					ThisForm.pf.pgStockLst.txtCC.Value		= PrepareSQLtxt(tmpStockLst_Master.CC,'CC',1)
					ThisForm.pf.pgStockLst.Cond1.Value		= PrepareSQLtxt(tmpStockLst_Master.Cond,'Cond',50)
					ThisForm.pf.pgStockLst.Size1.Value		= PrepareSQLnum(tmpStockLst_Master.Size,'Size',-5)
					ThisForm.pf.pgStockLst.Paid1.Value		= PrepareSQLnum(tmpStockLst_Master.Paid,'Paid',-5)
					ThisForm.pf.pgStockLst.MWeight1.Value	= PrepareSQLnum(tmpStockLst_Master.MWeight,'MWeight',-5)
					ThisForm.pf.pgStockLst.Specs1.Value		= PrepareSQLtxt(tmpStockLst_Master.specs,'Specs',160)
					ThisForm.pf.pgStockLst.Heat1.Value		= PrepareSQLtxt(tmpStockLst_Master.Heat,'Heat',50)
					ThisForm.pf.pgStockLst.Lot1.Value		= PrepareSQLtxt(tmpStockLst_Master.Lot,'Lot',10)
					ThisForm.pf.pgStockLst.PO_Item1.Value	= PrepareSQLtxt(tmpStockLst_Master.PO_Item,'PO_Item',12)
					ThisForm.pf.pgStockLst.PODueDate1.Value	= PrepareSQLdate(tmpStockLst_Master.PODueDate,'PODueDate',.F.,.T.)
					ThisForm.pf.pgStockLst.History1.Value	= PrepareSQLtxt(tmpStockLst_Master.History,'History',20)
					ThisForm.pf.pgStockLst.Mill1.Value		= PrepareSQLtxt(tmpStockLst_Master.Mill,'Mill',10)
					ThisForm.pf.pgStockLst.StkDate1.Value	= PrepareSQLdate(tmpStockLst_Master.StkDate,'StkDate',.F.,.T.)
					ThisForm.pf.pgStockLst.Num1.Value		= PrepareSQLnum(tmpStockLst_Master.Num,'Num',-3)
					ThisForm.pf.pgStockLst.txtPOStatus.Value 	= PrepareSQLtxt(tmpStockLst_Master.POStatus,'POStatus',1)
				
				ENDIF
		
			ENDIF
		ENDIF
		
		*IF USED("tmpStockLst_Master")
		*	USE IN tmpStockLst_Master
		*ENDIF
		**************************************
		*Reset
		ThisForm.pf.pgStockLst.PC1.Value			= ''
		ThisForm.pf.pgStockLst.Size_H1.Value		= 0
		ThisForm.pf.pgStockLst.Dim11.Value		= 0
		ThisForm.pf.pgStockLst.Size_L1.Value		= 0
		ThisForm.pf.pgStockLst.Dim21.Value		= 0
		ThisForm.pf.pgStockLst.Dim31.Value		= 0
		ThisForm.pf.pgStockLst.chkRandLen.Value	= 0
		ThisForm.pf.pgStockLst.chkPrime.Value		= 0
		ThisForm.pf.pgStockLst.S_QTY.Value		= 0
		ThisForm.pf.pgStockLst.Pounds1.Value		= 0
		ThisForm.pf.pgStockLst.Descript1.Value	= ''
		ThisForm.pf.pgStockLst.S_P.Value			= 0
		ThisForm.pf.pgStockLst.InvoiceValue1.Value= 0
		
		IF nID_Detail> 0
			cSQL = "SELECT *"
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + " ,'S' AS TBL "
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
			CASE cTBL = "B"
				cSQL = cSQL + " ,'B' AS TBL "
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
			CASE cTBL = "W"
				cSQL = cSQL + " ,'W' AS TBL "
				cSQL = cSQL + " FROM dbo.WIPLst_Detail "
			ENDCASE
			cSQL = cSQL + " WITH(NOLOCK) WHERE ID_Detail = " + STR(nID_Detail)
		
			lFoundMasterHeat = .T.
			Thisform.pf.pgStockLst.ID_Detail1.Value	= nID_Detail
			
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail')
			ELSE
				IF USED("tmpStockLst_Detail")
					IF RECCOUNT('tmpStockLst_Detail')=0
						ThisForm.pf.pgStockLst.ID_Detail1.DisabledBackColor = RGB(255,0,0)
					ENDIF
									
					Thisform.pf.pgStockLst.PC1.Value		= PrepareSQLnum(tmpStockLst_Detail.PC,'PC',-3)
					ThisForm.pf.pgStockLst.Size_H1.Value	= PrepareSQLnum(tmpStockLst_Detail.Size_H,'Size_H',-5)
					ThisForm.pf.pgStockLst.Dim11.Value		= PrepareSQLnum(tmpStockLst_Detail.Dim1,'Dim1',-5)
					ThisForm.pf.pgStockLst.Size_L1.Value	= PrepareSQLnum(tmpStockLst_Detail.Size_L,'Size_L',-5)
					ThisForm.pf.pgStockLst.Dim21.Value		= PrepareSQLnum(tmpStockLst_Detail.Dim2,'Dim2',-5)
					ThisForm.pf.pgStockLst.Dim31.Value		= PrepareSQLnum(tmpStockLst_Detail.Dim3,'Dim3',-5)
					ThisForm.pf.pgStockLst.chkRandLen.Value	= PrepareSQLchk(tmpStockLst_Detail.RandLen,'RandLen')
					ThisForm.pf.pgStockLst.chkPrime.Value	= PrepareSQLchk(tmpStockLst_Detail.Prime,'Prime')
					ThisForm.pf.pgStockLst.S_QTY.Value		= PrepareSQLnum(tmpStockLst_Detail.S_QTY,'S_QTY',-5)
					ThisForm.pf.pgStockLst.Pounds1.Value	= PrepareSQLnum(tmpStockLst_Detail.Weight,'Weight',-5)
					ThisForm.pf.pgStockLst.Descript1.Value	= PrepareSQLtxt(tmpStockLst_Detail.DESCRIPT,'DESCRIPT',20,.F.,.T.)
					ThisForm.pf.pgStockLst.S_P.Value		= PrepareSQLnum(tmpStockLst_Detail.S_P,'S_P',-5)
					ThisForm.pf.pgStockLst.InvoiceValue1.Value	= PrepareSQLnum(tmpStockLst_Detail.InvoiceValue,'InvoiceValue',-5)
					
					PRIVATE lCancelled
					lCancelled = PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
					IF lCancelled AND PrepareSQLnum(tmpStockLst_Detail.ID_Detail,'ID_Detail',-3)=0
						lCancelled = .F.  &&Do not show if no ID_Detail
					ENDIF
					ThisForm.pf.pgStockLst.cmdRemoveDetail.Visible = lCancelled		
						
				ENDIF
			ENDIF
		ENDIF
		
		
		*******************
		DO CASE
		CASE cTBL = "S"
			ThisForm.pf.pgStockLst.txtTBL.Value		= "S"
		CASE cTBL = "B"
			ThisForm.pf.pgStockLst.txtTBL.Value		= "B"
		CASE cTBL = "W"
			ThisForm.pf.pgStockLst.txtTBL.Value		= "W"
		OTHERWISE
			ThisForm.pf.pgStockLst.txtTBL.Value		= ''
		ENDCASE
		
		
		SELECT Receiving
	ENDPROC

	PROCEDURE refreshstocklst_heat
		*ThisForm.RefreshStockLst_Heat()
		PRIVATE cHeat
		cHeat = PrepareSQLtxt(Receiving.Heat,'Heat',50)
		IF EMPTY(cHeat)
			RETURN .F.
		ENDIF
		IF UPPER(cHeat) = "DUE IN"
			RETURN .F.
		ENDIF
		PRIVATE lFoundHeat
		lFoundHeat = .F.
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT *,'S' AS TBL FROM dbo.StockLst_Master WITH(NOLOCK) WHERE Heat LIKE '"+ALLTRIM(cHeat)+"%'"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + "SELECT *,'B' AS TBL FROM dbo.BrokerLst_Master WITH(NOLOCK) WHERE Heat LIKE '"+ALLTRIM(cHeat)+"%'"
		
		IF USED("tmpStockLst_Master")
			SELECT tmpStockLst_Master
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Master')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Master')
		ELSE
			IF USED("tmpStockLst_Master")
				IF RECCOUNT("tmpStockLst_Master")>0
					lFoundHeat = .T.
					ThisForm.pf.pgStockLst.txtTBL.Value 	= PrepareSQLtxt(tmpStockLst_Master.TBL,'TBL',1)
					ThisForm.pf.pgStockLst.ID1.Value		= PrepareSQLnum(tmpStockLst_Master.ID,'ID',-5)
						
					ThisForm.pf.pgStockLst.Alloy1.Value		= PrepareSQLtxt(tmpStockLst_Master.Alloy,'Alloy',12)
					ThisForm.pf.pgStockLst.txtForm.Value	= PrepareSQLtxt(tmpStockLst_Master.Form,'Form',2)
					ThisForm.pf.pgStockLst.txtCC.Value		= PrepareSQLtxt(tmpStockLst_Master.CC,'CC',1)
					ThisForm.pf.pgStockLst.Cond1.Value		= PrepareSQLtxt(tmpStockLst_Master.Cond,'Cond',50)
					ThisForm.pf.pgStockLst.Size1.Value		= PrepareSQLnum(tmpStockLst_Master.Size,'Size',-5)
					ThisForm.pf.pgStockLst.Paid1.Value		= PrepareSQLnum(tmpStockLst_Master.Paid,'Paid',-5)
					ThisForm.pf.pgStockLst.MWeight1.Value	= PrepareSQLnum(tmpStockLst_Master.MWeight,'MWeight',-5)
					ThisForm.pf.pgStockLst.Specs1.Value		= PrepareSQLtxt(tmpStockLst_Master.specs,'Specs',160)
					ThisForm.pf.pgStockLst.Heat1.Value		= PrepareSQLtxt(tmpStockLst_Master.Heat,'Heat',50)
					ThisForm.pf.pgStockLst.Lot1.Value		= PrepareSQLtxt(tmpStockLst_Master.Lot,'Lot',10)
					ThisForm.pf.pgStockLst.PO_Item1.Value	= PrepareSQLtxt(tmpStockLst_Master.PO_Item,'PO_Item',12)
					ThisForm.pf.pgStockLst.PODueDate1.Value	= PrepareSQLdate(tmpStockLst_Master.PODueDate,'PODueDate',.F.,.T.)
					ThisForm.pf.pgStockLst.History1.Value	= PrepareSQLtxt(tmpStockLst_Master.History,'History',20)
					ThisForm.pf.pgStockLst.Mill1.Value		= PrepareSQLtxt(tmpStockLst_Master.Mill,'Mill',10)
					ThisForm.pf.pgStockLst.StkDate1.Value	= PrepareSQLdate(tmpStockLst_Master.StkDate,'StkDate',.F.,.T.)
					ThisForm.pf.pgStockLst.Num1.Value		= PrepareSQLnum(tmpStockLst_Master.Num,'Num',-3)
					ThisForm.pf.pgStockLst.txtPOStatus.Value 	= PrepareSQLtxt(tmpStockLst_Master.POStatus,'POStatus',1)
				ENDIF
			ENDIF
		ENDIF
		
		RETURN lFoundHeat 
	ENDPROC

	PROCEDURE refresrejectreasontab
		*ThisForm.RefresRejectReasonTab()
		
		ThisForm.pf.pgRejectReason.txtReceivingID.Value = PrepareSQLnum(Receiving.ID,'ID',-3)
		
		ThisForm.pf.pgRejectReason.txtReceived.Value = PrepareSQLdate(Receiving.Received,'Received',.F.,.T.)
		
		ThisForm.pf.pgRejectReason.txtPOitem.Value = PrepareSQLtxt(Receiving.POitem,'POitem',12)
		ThisForm.pf.pgRejectReason.txtSOitem.Value = PrepareSQLtxt(Receiving.SOitem,'SOitem',10)
		
		ThisForm.pf.pgRejectReason.txtAlloy.Value = PrepareSQLtxt(Receiving.Alloy,'Alloy',12)
		ThisForm.pf.pgRejectReason.txtHeat.Value = PrepareSQLtxt(Receiving.Heat,'Heat',50,.F.)
		ThisForm.pf.pgRejectReason.txtLot.Value = PrepareSQLtxt(Receiving.Lot,'Lot',10)
		
		ThisForm.pf.pgRejectReason.chkCert.Value = PrepareSQLchk(Receiving.Cert,'Cert')
		ThisForm.pf.pgRejectReason.txtPieces.Value = PrepareSQLnum(Receiving.Pieces,'Pieces',-3)
		
		ThisForm.pf.pgRejectReason.txtRejectPC.Value = PrepareSQLnum(Receiving.RejectPC,'RejectPC',-3)
		ThisForm.pf.pgRejectReason.txtRejectReason.Value = PrepareSQLtxt(Receiving.RejectReason,'RejectReason',255)
		
		ThisForm.pf.pgRejectReason.edtPOitem.Value = ''
		ThisForm.pf.pgRejectReason.edtSOitem.Value = ''
		
		PRIVATE cPOitem, cSOitem
		cPOitem = Proper_PO_Item(ThisForm.pf.pgRejectReason.txtPOitem.Value)
		cSOitem = Proper_SO_item(ThisForm.pf.pgRejectReason.txtSOitem.Value)
		
		
		PRIVATE cSQL, nSQLEXEC
		
		****
		ThisForm.pf.pgRejectReason.edtPOitem.Value = ''
		
		ThisForm.pf.pgRejectReason.cmdPOedit.Visible = .F.
		ThisForm.pf.pgRejectReason.cmdPOabort.Visible = .F.
		
		
		IF Proper_PO_item(cPOitem) != Proper_PO_item('')
			IF USED('tmpPOnotes')
				USE IN tmpPOnotes
			ENDIF
		
			cSQL = "SELECT Notes FROM dbo.PO_ProcessNotes WITH(NOLOCK) WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOnotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOnotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOnotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOnotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpPOnotes')
			ELSE
				IF USED("tmpPOnotes")
					IF RECCOUNT("tmpPOnotes") > 0
						ThisForm.pf.pgRejectReason.edtPOitem.Value = tmpPOnotes.Notes
						ThisForm.pf.pgRejectReason.cmdPOedit.Visible = .T.
					ENDIF
					USE IN tmpPOnotes
				ENDIF
			ENDIF
		ENDIF
		
		****
		ThisForm.pf.pgRejectReason.edtSOitem.Value = ""
		
		ThisForm.pf.pgRejectReason.cmdSOedit.Visible = .F.
		ThisForm.pf.pgRejectReason.cmdSOabort.Visible = .F.
		
		IF Proper_SO_item(cSOitem) != Proper_SO_item('')
			IF USED('tmpSOnotes')
				USE IN tmpSOnotes
			ENDIF
		
			cSQL = "SELECT Notes FROM dbo.SO_ProcessNotes WITH(NOLOCK) WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			SELECT 0
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOnotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOnotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOnotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOnotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpSOnotes')
			ELSE
				IF USED("tmpSOnotes")
					IF RECCOUNT("tmpSOnotes") > 0
						ThisForm.pf.pgRejectReason.edtSOitem.Value = tmpSOnotes.Notes
						ThisForm.pf.pgRejectReason.cmdSOedit.Visible = .T.
					ENDIF
					USE IN tmpSOnotes
				ENDIF
			ENDIF
		ENDIF
		****
		SELECT Receiving
	ENDPROC

	PROCEDURE reload
		PARAMETERS nRID
		*thisForm.reLoad(nRID)
		
		ThisForm.pf.pgEdit.grdReceiving.RecordSource = ''
		ThisForm.pf.pgBrowse.GridBR.RecordSource = ''
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('Receiving')	
			USE IN Receiving
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.Receiving "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Receiving')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Receiving')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Receiving")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Receiving")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Receiving')
			RETURN
		ELSE
			SELECT Receiving
			INDEX ON Received TAG RecvDate
			INDEX ON POitem TAG POitem
			INDEX ON INT(VAL(LEFT(PoItem,9))) TAG HPAPO
			INDEX ON INT(VAL(LEFT(SoItem,7))) TAG SalesNum
			
			INDEX ON UPPER(Vendor) TAG UppVendor
			INDEX ON UPPER(HEAT) TAG UppHeat
			INDEX ON SOitem TAG SOitem
			INDEX ON ID_Master TAG ID_Master
			INDEX ON ID TAG rID
			INDEX ON WO_Detail TAG WO_Detail
			INDEX ON RMA_NO TAG RMA_NO
			INDEX ON RMA_Detail TAG RMA_Detail
			INDEX ON WO TAG WO
			
		ENDIF
		SET ORDER TO TAG rID
		
		ThisForm.pf.pgEdit.Refresh
		
		ThisForm.pf.pgEdit.grdReceiving.RecordSource = 'Receiving'
		ThisForm.pf.pgBrowse.GridBR.RecordSource = 'Receiving'
		ThisForm.SetGridReceiving()
		
		IF VARTYPE(nRID) = "N"
			LOCATE FOR ID = nRID
			IF NOT FOUND()
				GO BOTTOM
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE remove_incoming_process
	ENDPROC

	PROCEDURE remove_receive_hold
		PARAMETERS ReceivingID
		*ThisForm.Remove_Receive_Hold(ReceivingID)
		PRIVATE lOnHold, lOK 
		lOnHold = PrepareSQLlogic(Receiving.Hold,'Hold')
		lOK = .T.
		
		IF lOnHold 
			*Remove Hold
			PRIVATE cSQL, nSQLEXEC 
			
			cSQL = "UPDATE dbo.Receiving SET "
			cSQL = cSQL + " [hold] = 0"
			cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				lOK = .F.
			ELSE
				lOK = .T.
				
				REPLACE hold WITH .F. IN Receiving
				ThisForm.pf.pgEdit.chkOnHold.Value 	= .F.
				
				Send_Chatter("ReceivingID_Hold",nReceivingID,"BLANK","The receiving material for ReceivingID "+ALLTRIM(STR(nReceivingID))+", is OFF Receive OnHold."+CHR(13)+HTML_ReceivingID(nReceivingID,.T.),ThisForm.nConnHandle)
				
			
				
				ThisForm.Check_POitem_Hold(nReceivingID)
				
			ENDIF
			
		ELSE
			WAIT WINDOW "No Hold to remove!"
		ENDIF
		
	ENDPROC

	PROCEDURE Resize
		PRIVATE nHeight, nWidth
		nHeight	= This.Height - 371
		nWidth	= This.Width - 649
		
		ThisForm.cmdDeleteReceiving.Top	= 330 + nHeight
		ThisForm.cmdReportReceiving.Top = 318 + nHeight
