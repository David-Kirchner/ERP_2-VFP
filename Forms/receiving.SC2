	PROCEDURE pf.pgRejectReason.txtAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE pf.pgRejectReason.txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE pf.pgRejectReason.txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE pf.pgRejectReason.txtHeat.Valid
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat
		
		nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HpaPO',10)
		nItemPo = PrepareSQLnum(This.Parent.txtHpaPOItem.Value,'Item',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		*STR(nHPApo,9,0)+"-"+IIF(nItemPo<10,"0"+STR(nItemPo,1,0),+STR(nItemPo,2,0))
		SET DECIMAL TO nDec
		
		*cHeat = ALLTRIM(ThisForm.txtHeat.Value)
		cHeat = This.Value
		
		IF NOT EMPTY(cHeat) 
			IF nItemPo < 1 OR nHpaPo < 1
				*Only run here if bad POitem
				IF MESSAGEBOX("Do you want to look for a PO that used this heat number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
					PRIVATE nReceivingID
					nReceivingID	= This.Parent.txtReceivingID.Value
					*nReceivingID	= Receiving.ID
					
					IF NOT ThisForm.GetFromReceiving(cPOitem, cHeat)
						*RETURN to old RID
					ENDIF
					
					IF USED('Receiving')
						SELECT Receiving
						LOCATE FOR ID = nReceivingID
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

