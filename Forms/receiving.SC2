	PROCEDURE add_po_receive
		PARAMETERS nHPAPO
		*ThisForm.Add_PO_Receive(lnText2Find)
		
		PRIVATE cPOitem
		cPOitem	= Proper_PO_Item( STR(nHPAPO) + "-01")
		
		PRIVATE nCount_PO, nHpaPo, nCntPO_Stock, nCntPOitems
		nCntPOitems = 0
		nCount_PO = Count_HPAPOinPurchaseOrder( nHPAPO, ThisForm.nConnHandle )
		
		IF nCount_PO = 0
			MESSAGEBOX("PO Not Found"+CHR(13)+"PO ="+cPOitem+" has not been entered!"+CHR(13)+"Have this PO added in PurchaseOrder screen",0+16,"Stop this receive and enter the PO first!")
			RETURN .F.
		ELSE
			*nHpaPo = Proper_PO_Item_PO(cPOitem)
			nCntPOitems = Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle ,"NOTCANCELLED")
			
			IF nCntPOitems > 1
				*Show list of Item to Choose
				DO FORM Forms\ChoosePOitem WITH nHpaPo TO cPoItem
		
				cPOitem	= Proper_PO_Item( cPoItem )
				IF Proper_PO_Item(cPOitem) = Proper_PO_Item( '' )
					RETURN .F.
				ENDIF
			ENDIF
			PRIVATE nCntPO_Stock, nCntPO_NotStock 
			nCntPO_Stock = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, "FORSTOCK" )
			nCntPO_NotStock = Count_POIteminPurchaseOrder( cPOitem, ThisForm.nConnHandle, "NOTSTOCK" )
			
			IF nCntPO_Stock > 0 OR nCntPO_NotStock > 0
				PRIVATE nCountInLst
				nCountInLst = Count_POitem_StockLst( cPOitem, "S", ThisForm.nConnHandle )
				IF nCountInLst = 0
					nCountInLst = Count_POitem_StockLst( cPOitem, "B", ThisForm.nConnHandle )
				ENDIF
				IF nCountInLst = 0
					nCountInLst = Count_POitem_StockLst( cPOitem, "W", ThisForm.nConnHandle )
				ENDIF
				
				IF nCountInLst = 0 AND nCntPO_NotStock = 0
					*IF nCntPO_NotStock = 0
					MESSAGEBOX("POitem link NOT Found in StockLst"+CHR(13)+"POitem ="+cPoitem+" was not found in StockLst\BrokerLst list."+CHR(13)+"Have this PO edited in PurchaseOrder screen"+CHR(13)+"so ALL PO related tables are updated!",0+16,"Stop receiving and Edit PO first!")
					RETURN .F.
					*ENDIF
				ELSE
					* nCntPO_NotStock could be greater than 0
					
					PRIVATE nMess, cMess
					cMess = "Poitem ="+cPOitem+" was not found as Received."+CHR(13)+CHR(13)
					IF nCntPO_Stock > 0
						cMess = cMess+"Do you want to Receive Material to Stock now?"
					ENDIF
					IF nCntPO_NotStock > 0
						cMess = cMess+"Do you want to Receive in now?"
					ENDIF
					
					nMess = MESSAGEBOX(cMess,4+32,"Receive")
					IF nMess = 6
						IF Count_POItem_DueIn( cPOitem, ThisForm.nConnHandle ) = 0 AND nCntPO_NotStock = 0
							MESSAGEBOX("Sorry, POitem link was NOT Found in StockLst as 'DUE IN'."+CHR(13)+"POitem ='"+cPOitem+"' was not found in StockLst\BrokerLst list."+CHR(13)+"Have this PO edited in PurchaseOrder screen"+CHR(13)+"so ALL PO related tables are updated!"+CHR(13)+" or the Item number is wrong!",0+16,"Stop receiving and Edit PO first!")
							RETURN .F.
						ENDIF
		
						IF Proper_PO_Item(cPOItem) != Proper_PO_Item("")
							ThisForm.Visible = .F.
							DO FORM Forms\Receive_Edit WITH 'POitem',cPOitem,'ADD',0
							ThisForm.Visible = .T.
							ThisForm.ReceivingRefreshReceiving()
							RETURN
						ENDIF
					ENDIF					
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE add_wod_receive
		PARAMETERS pnWO_Detail
		*ThisForm.Add_WOD_Receive(lnText2Find)
		
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(pnWO_Detail,'WO_Detail',-3)
		
		PRIVATE nCount_WO_Detail, nCount_WO_Detail_Stk
		nCount_WO_Detail = Count_WODinWO_Detail( nWO_Detail, ThisForm.nConnHandle, '' )
		
		IF nCount_WO_Detail = 0
			MESSAGEBOX(" Not Found"+CHR(13)+"WO_Detail ="+ALLTRIM(STR(nWO_Detail))+" has not been entered!"+CHR(13)+"Have this WO_Detail added in WO screen",0+16,"Stop this receive and enter the WO_Detail first!")
			RETURN .F.
		ELSE
				
			PRIVATE nMess 
			nMess = MESSAGEBOX("WO_Detail ="+ALLTRIM(STR(nWO_Detail))+" was not found as Received."+CHR(13)+"Do you want to Receive in this Stock now?",4+32,"Receive of new stock")
			IF nMess = 6
				
				ThisForm.Visible = .F.
				DO FORM Forms\Receive_Edit WITH 'WO_Detail',nWO_Detail,'ADD',0
				ThisForm.Visible = .T.
				ThisForm.ReceivingRefreshReceiving()
				*RETURN
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE add_wo_receive
		PARAMETERS pnWO
		*ThisForm.Add_WO_Receive(lnText2Find)
		
		PRIVATE nWO
		nWO = PrepareSQLnum(pnWO,'WO',-3)
		
		PRIVATE nCount_WO, nCount_WO_Stk
		nCount_WO = Count_WOinWO( nWO, ThisForm.nConnHandle, 'NOTCANCELLED' )	&&SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		
		IF nCount_WO = 0
			MESSAGEBOX("Not Found"+CHR(13)+"WO ="+ALLTRIM(STR(nWO))+" has not been entered!"+CHR(13)+"Have this WO added in Work Order screen",0+16,"Stop this receive and enter the WO first!")
			RETURN .F.
		ELSE
				
			PRIVATE nMess 
			nMess = MESSAGEBOX("WO ="+ALLTRIM(STR(nWO))+" was not found as Received."+CHR(13)+"Do you want to Receive this metal now?",4+32,"Receive of new metal")
			IF nMess = 6
				
				ThisForm.Visible = .F.
				DO FORM Forms\Receive_Edit WITH 'WO',nWO,'ADD',0
				ThisForm.Visible = .T.
				ThisForm.ReceivingRefreshReceiving()
				*RETURN
				
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE checksave
	ENDPROC

	PROCEDURE check_poitem_hold
		PARAMETERS nReceivingID
		*ThisForm.Check_POitem_Hold
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(Receiving.POitem,'POitem',12)
		IF PrepareSQLtxt(Receiving.POitem,'POitem',12) = Proper_PO_item('')
			*Not a POitem
			RETURN -1
		ENDIF
		
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpCNTPOi')	
			USE IN tmpCNTPOi
		ENDIF 
		SELECT 0
		
		cSQL = "SELECT ID,[Hold] FROM dbo.Receiving "
		cSQL = cSQL + " WHERE POitem = '"+cPOitem+"'"
		*cSQL = cSQL + " AND ID != nReceivingID
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpCNTPOi' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL,'tmpCNTPOi' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "'tmpCNTPOi'")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "'tmpCNTPOi'")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC,'tmpCNTPOi')
			lOK = .F.
		ENDIF
		
		IF lOK
			SELECT 'tmpCNTPOi'
			PRIVATE nCnt
			nCnt = 0
			
			IF RECCOUNT('tmpCNTPOi')>0
				SCAN
					IF tmpCNTPOi.ID != nReceivingID
						IF PrepareSQLlogic(tmpCNTPOi.Hold,'Hold')
							nCnt = nCnt + 1
						ENDIF
					ENDIF
				ENDSCAN
			ENDIF
			
			USE IN 'tmpCNTPOi')
			
			IF nCnt > 0
				MESSAGEBOX("This Receive is not ON Hold."+CHR(13)+"But there are "+ALLTRIM(STR(nCnt))+" other Receives On Hold",64,"POitem still OnHold")
			ELSE
				*REMOVE HOLD on POitem
				POitem_Hold(cPOitem, .F., ThisForm.nConnHandle)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pcSOitem, pnRMA, pcPOitem, pcHeat, pnRID
		*DO FORM Forms\Receiving WITH cSOitem, nRMA, cPOitem, cHeat, nRID
		
		*grdReceiving renamed frmReceiving
		
		IF VARTYPE(pnRMA) != "N"
			pnRMA = 0
		ENDIF
		ThisForm.nRMA = pnRMA
		
		
		IF VARTYPE(pcSOitem) = "C"
			IF pcSOitem = "WORKORDER"
				ThisForm.Receive_WorkOrder(pnRMA)
				ThisForm.pf.ActivePage = 1
			ELSE
				IF ThisForm.nRMA > 0
					ThisForm.RMA_Receive(pcSOitem)
				ELSE
					nSO = Proper_SO(pcSOitem)
					IF nSO < 505000
						ThisForm.ShowPOitem(pcPOitem)
						*Make sure to send in DO FORM forms\Receiving  WITH '',0,cPOitem,'',0
						*RMA=0 to get to ShowPOitem
					ELSE
						*POitem was sent as SOitem!!
						ThisForm.ShowPOitem(pcSOitem)
					ENDIF
				
				ENDIF
						
				ThisForm.SetGridReceiving()
				ThisForm.RefreshEditTab()
				ThisForm.pf.ActivePage = 1
				*ThisForm.pf.pgStockLst.Vcr1.CmdNext.Enabled = .T.
				ThisForm.pf.pgEdit.Vcr1.cmdNext.Enabled = .t.
				
			ENDIF	
		ENDIF
		
		ThisForm.SetGridReceiving()
		
		*ThisForm.GetBy_ReceivingID( Receiving.ID )
		
		ThisForm.pf.ActivePage = 1
		nHPAPO = Proper_PO_Item_PO(Receiving.POitem)
		IF nHPAPO > 0
			ThisForm.pf.pgEdit.txtFindText.Value = ALLTRIM(STR(nHPAPO))
		ELSE
			ThisForm.pf.pgEdit.txtFindText.Value = ''
		ENDIF
		
		*ThisForm.pf.pgEdit.txtFindText.SetFocus
		ThisForm.pf.pgEdit.grdReceiving.SetFocus
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_RTR ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('Receiving')	
			USE IN Receiving
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.Receiving WITH(NOLOCK) ORDER BY ID"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Receiving')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Receiving')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Receiving")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Receiving")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Receiving')
			RETURN TO MASTER
			ThisForm.Release 
			
		ELSE
			*Code is also used in ReceivingRefreshReceiving and Reload
			SELECT Receiving
			INDEX ON Received TAG RecvDate
			INDEX ON POitem TAG POitem
			INDEX ON INT(VAL(LEFT(PoItem,9))) TAG HPAPO
			INDEX ON INT(VAL(LEFT(SoItem,7))) TAG SalesNum
			
			INDEX ON UPPER(Vendor) TAG UppVendor
			INDEX ON UPPER(HEAT) TAG UppHeat
			INDEX ON SOitem TAG SOitem
			INDEX ON ID_Master TAG ID_Master
			INDEX ON ID TAG rID
			INDEX ON WO_Detail TAG WO_Detail
			INDEX ON RMA_NO TAG RMA_NO
			INDEX ON RMA_Detail TAG RMA_Detail
			INDEX ON WO TAG WO
			
			SET ORDER TO TAG rID
		ENDIF
		
		IF !USED('poStatusDef')
			Load_postatusdef(ThisForm.nConnHandle)
		ENDIF
		
		SELECT Receiving
		*SET ORDER TO TAG POitem
		GO BOTTOM
		*SET MULTILOCKS ON  && Must be on for table buffering
		*= CURSORSETPROP('Buffering', 3, 'purchaseorder' )  && Enable 3row 5table buffering
		*
		
	ENDPROC

	PROCEDURE onhold
		*ThisForm.OnHold()
		
		PRIVATE lOnHold
		lOnHold = PrepareSQLlogic(Receiving.Hold,'Hold')
		
		RETURN lOnHold
		
	ENDPROC

	PROCEDURE po_complete
		*PARAMETERS cPOitem
		*ThisForm.PO_Complete(Receiving.POitem)
		
		PRIVATE cPOItem
		cPOItem	= PrepareSQLtxt(Receiving.POitem,'POitem',12)
		
		IF Proper_PO_item(cPOItem) = Proper_PO_item('')
			RETURN .F.
		ENDIF
		 
		PRIVATE nSQLEXEC, cSQL
		IF USED('tmpPOcmplt')	
			USE IN tmpPOcmplt
		ENDIF
		
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT Delivered FROM dbo.PurchaseOrder WITH(NOLOCK) WHERE PoItem = dbo.f_ProperPOitem('"+cPOItem+"')"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOcmplt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPOcmplt')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOcmplt")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPOcmplt")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpPOcmplt')
			RETURN .F.
		ENDIF
		
		PRIVATE lOK
		lOK = .T.
		IF USED('tmpPOcmplt')
			IF RECCOUNT('tmpPOcmplt') > 0
				lOK = PrepareSQLchk(tmpPOcmplt.Delivered,'Delivered')
			ENDIF
			USE IN tmpPOcmplt
		ENDIF
		
		RETURN lOK
		
	ENDPROC

