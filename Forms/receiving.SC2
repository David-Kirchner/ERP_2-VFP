	PROCEDURE pf.pgEdit.Vcr1.recordpointermoved
		This.Parent.txtReceived.Refresh
		This.Parent.txtPOitem.Refresh
		This.Parent.txtWO_Detail.Refresh
		IF PrepareSQLnum(Receiving.WO_Detail,'WO_Detail',-3) > 0
			This.Parent.txtWO_Detail.Visible = .T.
			This.Parent.lblWO_Detail.Visible = .T.
			
			This.Parent.txtPOitem.Visible = .F.
			This.Parent.lblHpaPOnum.Visible = .F.
		ELSE
			This.Parent.txtWO_Detail.Visible = .F.
			This.Parent.lblWO_Detail.Visible = .F.
			
			This.Parent.txtPOitem.Visible = .T.
			This.Parent.lblHpaPOnum.Visible = .T.
		ENDIF
		This.Parent.txtSOitem.Refresh
		This.Parent.txtVendor.Refresh
		This.Parent.txtAlloy.Refresh
		This.Parent.txtHeat.Refresh
		This.Parent.txtLot.Refresh
		
		This.Parent.edtDescription.Refresh
		This.Parent.txtInit.Refresh
		This.Parent.txtDate.Refresh
		This.Parent.edtSpecs.Refresh
		This.Parent.edtComments.Refresh
		This.Parent.txtActualW.Refresh
		This.Parent.txtBillW.Refresh
		
		This.Parent.txtRejectPC.Refresh
		This.Parent.txtRejectReason.Refresh
		
		This.Parent.txtWhoAdd.Refresh
		This.Parent.txtWhenAdd.Refresh
		This.Parent.txtReceivingID.Refresh
		
		This.Parent.chkCert.Refresh
		This.Parent.chkPass.Refresh
		
		This.Parent.chkPOcomplete.Value = ThisForm.PO_Complete()
		This.Parent.chkPOcomplete.Refresh
		This.Parent.chkCancel.Refresh
		This.Parent.chkMillTrace.Value = PrepareSQLlogic(Receiving.MillTrace,'MillTrace')
		This.Parent.chkMillTrace.Refresh
		This.Parent.chkOnHold.Value = PrepareSQLlogic(Receiving.Hold,'Hold')
		
		ThisForm.cmdDeleteReceiving.Enabled = PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		
		This.Parent.grdReceiving.REFRESH
		This.Parent.grdReceiving.SetFocus
	ENDPROC

