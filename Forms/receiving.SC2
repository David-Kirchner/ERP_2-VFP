	PROCEDURE pf.pgEdit.txtID_Detail.DblClick
		PRIVATE nID_Detail, cTBL, cHyperLink
		nID_Detail = PrepareSQLnum(This.Value,'ID_Detail',-3)
		cTBL	=	 PrepareSQLtxt(Receiving.StockTable,'TBL',1)
		
		IF nID_Detail > 0
			cHyperLink = HTML_Stock_ID_Detail(cTBL,nID_Detail,.T.)
		
			IF LEN(cHyperLink)>0
			
				PRIVATE loHyperlink 
				loHyperlink = CREATEOBJECT("Hyperlink")
				loHyperlink.navigateto(cHyperLink)
				RELEASE loHyperlink 
		
			ELSE
				MESSAGEBOX("No Hyperlink",16,"Cannot show nID_Detail")
			ENDIF
		ELSE
			MESSAGEBOX("No ID_Detail number",16,"Cannot show nID_Detail")
		ENDIF
	ENDPROC

