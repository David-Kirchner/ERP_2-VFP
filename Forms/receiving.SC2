		ThisForm.Pf.pgEdit.grdReceiving.Height = 114 + nHeight
		
		ThisForm.Pf.pgEdit.lblOrderdate.Top = 117 + nHeight
		ThisForm.Pf.pgEdit.txtStkID.Top = 128 + nHeight
		ThisForm.Pf.pgEdit.txtReceived.Top = 119 + nHeight
