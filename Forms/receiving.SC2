	PROCEDURE pf.pgEdit.cmdEditStockLst.Click
		*Visible for No Stock ID
		
		PRIVATE nReceivingID,cPOItem,cComments,dDate,dReceived,cInit,cHeat,cLot
		PRIVATE lCert,cSOitem,cVendor,cComments,cDescription,nPieces,nRMA, nActualW 
		
		nReceivingID	= receiving.ID
		cPOItem			= receiving.POitem
		cComments		= receiving.Comments
		dDate			= receiving.Date
		dReceived		= receiving.Received
		cInit			= receiving.Init
		cHeat			= receiving.Heat
		cLot			= receiving.Lot
		
		lCert			= receiving.Cert
		cSOitem			= receiving.SOitem
		cVendor			= receiving.Vendor
		cComments		= receiving.Comments
		cDescription	= receiving.Description
		nPieces			= receiving.Pieces
		nRMA 			= 0
		nActualW		= receiving.ActualW
		
		PRIVATE nID_Master, cTBL
		nID_Master = 0 &&PrepareSQLnum(ThisForm.pf.pgEdit.txtStkID.Value,'ID',-3)
		cTBL = ''  &&UPPER(PrepareSQLtxt(ThisForm.pf.pgEdit.txtStkID.Value,'TBL',1))
		*Receiving.StockTable
		*Receiving.ID_Master
		
		IF nReceivingID > 0
			PRIVATE lAlready_Saved, lFoundStockUpdateReceiving,lCompleteReceive
			lAlready_Saved = .F.
			lFoundStockUpdateReceiving = .F.
			nPOcomplete = 0
			
			*Open PO Receive StockLst window
			ThisForm.SaveAdd_PurchaseOrder(nReceivingID,cPOItem,cComments,cDescription,dReceived,cInit,cHeat,cLot,lCert,cSOitem,cVendor,cComments,nPieces,nRMA,lAlready_Saved ,nActualW, lFoundStockUpdateReceiving,nPOcomplete )
		
			*Save info to current table - otherwise you will need to reload table data.
			PRIVATE cStkTable_MasterID, cStkTable, cStkTable_MasterID2
			cStkTable_MasterID = Get_STK_MasterID_by_ReceivingID(nReceivingID,ThisForm.nConnHandle)
			cStkTable	= PrepareSQLtxt(LEFT(cStkTable_MasterID,1),'StockTable',1)
			
			cStkTable_MasterID2 = RIGHT(cStkTable_MasterID,LEN(cStkTable_MasterID)-1)
			cStkTable_MasterID2 = VAL(cStkTable_MasterID2)
			nID_Master	= PrepareSQLnum(cStkTable_MasterID2,'ID',-3)
			
			IF nID_Master = 0
				This.Visible = .T.
			ELSE
				This.Visible = .F.
				
		*!*			PRIVATE cSQLu 
		*!*			cSQLu = "UPDATE dbo.Receiving SET"
		*!*			cSQLu = cSQLu +" StockTable = '"+cStkTable+"'"
		*!*			cSQLu = cSQLu +" ID_Master = "+STR(nID_Master)
		*!*			cSQLu = cSQLu +" WHERE ID = "+STR(nReceiveID)
		*!*			
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Quotes")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Quotes")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
		*!*			ENDIF
				
				ThisForm.ReceivingRefreshReceiving()
		
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pf.pgEdit.cmdFindcmboText.Valid
		PRIVATE IntcmbFind, recb4find, nBestFind
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace m.FindText
		
		PRIVATE nDec
		nDec = SET("DECIMAL")
		SET DECIMAL TO 0
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		*IF TYPE('laText2Find') = "N"
			lnText2Find = PrepareSQLnum(laText2Find,'Number',-3)
			lcText2Find = ALLTRIM(PrepareSQLtxt(laText2Find,'Text',200))
		*ENDIF
		*IF TYPE('laText2Find') = "C"
		*	lcText2Find = ALLTRIM(laText2Find)
		*	lnText2Find = VAL(laText2Find)
		*ENDIF
		SET DECIMAL TO nDec
		
		*m.ncmbFind = This.Parent.cmbFind.Value
		m.ncmbFind = This.Parent.cmboFind.Value
		IntcmbFind = INT(m.ncmbFind)
		
		recb4find = 0
		recb4find = RECNO('Receiving')
		
		SELECT Receiving
		DO CASE
		*Purchase Order,Sales Order,Vendor,Heat,ID_Master
		CASE IntcmbFind = 1
			*POitem
			SET ORDER TO TAG HPAPO
			SEEK lnText2Find  IN 'Receiving' ORDER HPAPO
			SET ORDER TO POitem	&&More logicall 
			
			IF FOUND('Receiving')
				*Go to Item 1
				PRIVATE cFindPOitem
				cFindPOitem = Proper_PO_item(STR(lnText2Find)+"-01")
				SEEK cFindPOitem IN 'Receiving' ORDER POitem
				
				IF NOT FOUND('Receiving')
					*--undo POitem
					SET ORDER TO TAG HPAPO
					SEEK lnText2Find  IN 'Receiving' ORDER HPAPO
					SET ORDER TO POitem	&&More logicall 
				ENDIF
			ELSE
				ThisForm.Add_PO_Receive(lnText2Find)
			ENDIF
			
		CASE IntcmbFind = 2
			*SOitem
			SET ORDER TO TAG Salesnum
			SEEK lnText2Find IN 'Receiving' ORDER Salesnum
			IF FOUND('Receiving')
				nRecord = RECNO('Receiving')
				COUNT FOR INT(VAL(LEFT(SoItem,7))) = lnText2Find TO nCount
				IF nCount > 0
					MESSAGEBOX("The SalesNum "+ALLTRIM(STR(lnText2Find))+" was found "+ALLTRIM(STR(nCount))+" times",64,"Found SO")
				ENDIF
				GOTO (nRecord)
			ELSE 
				MESSAGEBOX("The SalesNum "+ALLTRIM(STR(lnText2Find))+" was not found.",64,"No SO found")
			ENDIF
		CASE IntcmbFind = 3
			*Vendor c,30
			SET ORDER TO TAG UppVendor
			SEEK UPPER(lcText2Find) IN 'Receiving' ORDER UppVendor
			IF NOT FOUND('Receiving')
				MESSAGEBOX("The Vendor "+ALLTRIM(lcText2Find)+" was not found.",64,"No Vendor found")
			ENDIF
		CASE IntcmbFind = 4
			*Heat c,30
			SET ORDER TO TAG UppHeat
			SEEK UPPER(lcText2Find) IN 'Receiving' ORDER UppHeat
			IF NOT FOUND('Receiving')
				MESSAGEBOX("The Heat "+ALLTRIM(lcText2Find)+" was not found.",64,"No Heat found")
			ENDIF
		CASE IntcmbFind = 5
			*ID_Master INT
			SET ORDER TO TAG ID_Master
			SEEK lnText2Find IN 'Receiving' ORDER ID_Master
			IF NOT FOUND('Receiving')
				MESSAGEBOX("The Stock ID "+ALLTRIM(STR(lnText2Find))+" was not found.",64,"No Stock found")
			ENDIF
		CASE IntcmbFind = 6
			*ReceiveID INT
			SET ORDER TO TAG rID 
			SEEK lnText2Find IN 'Receiving' ORDER rID 
			IF NOT FOUND('Receiving')
				MESSAGEBOX("The Receiving ID "+ALLTRIM(STR(lnText2Find))+" was not found.",64,"No Receiving found")
			ENDIF
			
		CASE IntcmbFind = 7
			*WO_Detail INT
			SET ORDER TO TAG WO_Detail
			SEEK lnText2Find IN 'Receiving' ORDER WO_Detail
			IF NOT FOUND('Receiving')
				*MESSAGEBOX("The WO Detail "+ALLTRIM(STR(lnText2Find))+" was not found.",64,"No WO_Detail found")
				ThisForm.Add_WOD_Receive(lnText2Find)
			ENDIF
		CASE IntcmbFind = 8
			*RMA_NO INT
			SET ORDER TO TAG RMA_NO
			SEEK lnText2Find IN 'Receiving' ORDER RMA_NO
			IF NOT FOUND('Receiving')
				MESSAGEBOX("The RMA_NO "+ALLTRIM(STR(lnText2Find))+" was not found.",64,"No RMA_NO found")
			ENDIF
		CASE IntcmbFind = 9
			*RMA_Detail INT
			SET ORDER TO TAG RMA_Detail
			SEEK lnText2Find IN 'Receiving' ORDER RMA_Detail
			IF NOT FOUND('Receiving')
				MESSAGEBOX("The RMA_Detail "+ALLTRIM(STR(lnText2Find))+" was not found.",64,"No RMA_Detail found")
			ENDIF
		*Purchase Order,Sales Order,Vendor,Heat,ID_Master,ReceivingID,WO_Detail,RMA_NO,RMA_Detail,WO
		CASE IntcmbFind = 10
			*WO INT
			SET ORDER TO TAG WO
			SEEK lnText2Find IN 'Receiving' ORDER WO
			IF NOT FOUND('Receiving')
				*MESSAGEBOX("The WO "+ALLTRIM(STR(lnText2Find))+" was not found.",64,"No WO found")
				ThisForm.Add_WO_Receive(lnText2Find)
			ENDIF
		
		ENDCASE
		
		***********************************
		IF NOT FOUND('Receiving')
			nBestFind = RECNO(0)
			IF nBestFind > 0 AND nBestFind <= RECCOUNT("Receiving")
				GOTO nBestFind 
			ENDIF
			IF EOF('Receiving')
				WAIT WINDOW 'Not Found' NOWAIT
				IF recb4find > 0 AND recb4find <= RECCOUNT("Receiving")
					GO recb4find
				ENDIF
			ELSE
				WAIT WINDOW 'closest match' NOWAIT
			ENDIF
		ENDIF
		
		This.Parent.grdReceiving.Refresh
		
		ThisForm.RefreshEditTab()
		
		
		
		
		*This.Parent.grdReceiving.Setfocus
		This.Parent.grdReceiving.Column1.Text1.SetFocus
	ENDPROC

