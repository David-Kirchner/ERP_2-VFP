		ThisForm.RefresRejectReasonTab()
	ENDPROC

	PROCEDURE pf.pgStockLst.Click
		ThisForm.pf.pgStockLst.Vcr1.CmdNext.Enabled = .T.
		
		ThisForm.RefreshStockLst()
		
		
	ENDPROC

	PROCEDURE pf.pgStockLst.cmdEditDetail.Click
		PRIVATE nID_Detail, cTBL, nRID
		nID_Detail = PrepareSQLnum(ThisForm.Pf.PgStockLst.ID_Detail1.Value,'ID_Detail',-3)
		cTBL = UPPER(PrepareSQLtxt(ThisForm.pf.pgStockLst.txtTBL.Value,'TBL',1))
		nRID = 0
		
		IF nReceivingID > 0
			IF nID_Detail = 0
		
				MESSAGEBOX("No Master ID",16,"Cannot Edit")
				
			ELSE
				DO FORM Forms\StockLst_Detail WITH "EDIT", nID_Detail, 0, cTBL, nRID
				*DO FORM Forms\StockLst_Detail WITH "EDIT", nID_Detail, cTBL 
				*MESSAGEBOX("Already have a Receiving to StockList connection."+CHR(13)+"Cannot Edit Stock here.",0+64,"Cannot Add/Edit Stock here.")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pf.pgStockLst.cmdEditStockLst.Click
		PRIVATE nReceivingID,cPOItem,cComments,dDate,dReceived,cInit,cHeat,cLot,lCert,cSOitem,cVendor,cComments,nPieces,nRMA, nActualW 
		
		nReceivingID	= receiving.ID
		cPOItem			= receiving.POitem
		cComments		= receiving.Comments
		dDate			= receiving.Date
		dReceived		= receiving.Received
		cInit			= receiving.Init
		cHeat			= receiving.Heat
		cLot			= receiving.Lot
		
		lCert			= receiving.Cert
		cSOitem			= receiving.SOitem
		cVendor			= receiving.Vendor
		cComments		= receiving.Comments
		nPieces			= receiving.Pieces
		nRMA 			= 0
		nActualW		= receiving.ActualW
		
		PRIVATE nID_Master, cTBL
		nID_Master = PrepareSQLnum(ThisForm.Pf.PgStockLst.ID1.Value,'ID',-3)
		cTBL = UPPER(PrepareSQLtxt(ThisForm.pf.pgStockLst.txtTBL.Value,'TBL',1))
		*Receiving.StockTable
		*Receiving.ID_Master
		
		IF nReceivingID > 0
			IF nID_Master = 0
				PRIVATE lAlready_Saved, lFoundStockUpdateReceiving,nPOcomplete
				lAlready_Saved = .F.
				lFoundStockUpdateReceiving = .F.
				nPOcomplete = 0
		*		ThisForm.SaveAdd_PurchaseOrder(nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA,lAlready_Saved ,nActualW, lFoundStockUpdateReceiving, nPOcomplete )
		
				*Save info to current table - otherwise you will need to reload table data.
		*		SELECT receiving
		*		PRIVATE nCurRec
		*		nCurRec = RECNO()
		*		UPDATE receiving SET ID_Master = nID_Master, StockTable = cTBL  WHERE ID = nReceivingID
		*		GOTO nCurRec
				
				*This will update the screen
				*This.parent.parent.pgStockLst.Click
				*This.parent.parent.pgStockLst.Click
				MESSAGEBOX("No Master ID",16,"Cannot Edit")
				
			ELSE
				DO FORM Forms\StockLst_Master WITH "EDIT", nID_Master, cTBL 
				*MESSAGEBOX("Already have a Receiving to StockList connection."+CHR(13)+"Cannot Edit Stock here.",0+64,"Cannot Add/Edit Stock here.")
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pf.pgStockLst.cmdInventory.Click
		IF NOT USED('tmpStockLst_Master')
			RETURN .f.
		ENDIF
		IF NOT USED('tmpStockLst_Detail')
			RETURN .f.
		ENDIF
		
		PRIVATE cSOitem,nSalesNum,cHeat, cLot
		cSOitem		= PrepareSQLtxt(Receiving.SOitem,'SOitem',10)
		nSalesNum	= INT(VAL(LEFT(cSOitem,7)))
		cHeat = ALLTRIM(PrepareSQLtxt(tmpStockLst_Master.Heat,'Heat',50))
		cLot = ALLTRIM(PrepareSQLtxt(tmpStockLst_Master.Lot,'Lot',10))
		
		PRIVATE nDim2, nDim3, nPC
		nDim2	= 0
		nDim3	= 0
		nPC		= 0
		
		IF RECCOUNT('tmpStockLst_Detail') > 0
			nDim2 = PrepareSQLnum(tmpStockLst_Detail.Dim2,'Dim2',-5)
			nDim3 = PrepareSQLnum(tmpStockLst_Detail.Dim3,'Dim3',-5)
			nPC	= PrepareSQLnum(tmpStockLst_Detail.PC,'PC',-3)
		ENDIF
		
		
		IF NOT EMPTY(tmpStockLst_Master.ID)
		
		*!*	old	DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE",tmpStockLst_Master.TBL,tmpStockLst_Master.Alloy,tmpStockLst_Master.Form,tmpStockLst_Master.CC;
		*!*		,tmpStockLst_Master.CL,tmpStockLst_Master.Size, nDim2, nDim3, cSOitem, nSalesNum, nPC;
		*!*		,tmpStockLst_Master.MWeight,cHeatLot;
		*!*		,tmpStockLst_Detail.S_QTY,tmpStockLst_Detail.RandLen,tmpStockLst_Master.PO_item
		
			DO FORM Forms\StockLst_SQL_Browse WITH "BROWSE",tmpStockLst_Master.TBL,tmpStockLst_Master.Alloy,tmpStockLst_Master.Form,tmpStockLst_Master.CC;
				,tmpStockLst_Master.CL,tmpStockLst_Master.Size, nDim2, nDim3, cSOitem, nSalesNum, nPC;
				,tmpStockLst_Master.MWeight,cHeat;
				,tmpStockLst_Detail.S_QTY,tmpStockLst_Detail.RandLen,tmpStockLst_Master.PO_item
			* PARAMETER pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem
		
		ENDIF
	ENDPROC

	PROCEDURE pf.pgStockLst.cmdRemoveDetail.Click
		PRIVATE nReceivingID, lCancelled, nID_Master, cTBL
		nReceivingID	= PrepareSQLnum(Receiving.ID,'ID',-3)
		lCancelled 		= PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		nID_Master		= PrepareSQLnum(Receiving.ID_Master,'ID_Master',-3)
		cTBL			= PrepareSQLtxt(Receiving.StockTable,'TBL',1)
		
		PRIVATE nID_Detail
		nID_Detail = 0
		nID_Detail = PrepareSQLnum(Receiving.ID_Detail,'ID_Detail',-3)
		
		IF nReceivingID > 0
			IF lCancelled 
				IF nID_Master > 0
					*Get_ID_Detail_by_ReceivingID
					*nID_Detail = Get_ID_Detail_by_ReceivingID(nReceivingID,cTBL,ThisForm.nConnHandle) 
					*** too many, not distinct
					PRIVATE lForceDelete
					lForceDelete = .F.
					
					IF nID_Detail > 0
						PRIVATE cFrom, cWhy
						cFrom = "Deleted Receiving"
						cWhy = "Deleted ReceivingID:"+ALLTRIM(STR(nReceivingID))
		
						PRIVATE lExists 
						lExists = ID_Detail_Exists(nID_Detail,cTBL,ThisForm.nConnHandle)
						IF lExists 
							IF Remove_Lst_Detail_by_ID_Detail(cTBL,nID_Detail,ThisForm.nConnHandle, cFrom, cWhy)
								Remove_Lst_ID(cTBL,nID_Master,ThisForm.nConnHandle,lForceDelete,cFrom,cWhy)
							ELSE
								MESSAGEBOX("Could not Remove StockLst Detail record.",0,"Error")
							ENDIF
		
						ENDIF
					ELSE
						MESSAGEBOX("Could not get the ID_Detail to Remove!!",0,"Error")
					ENDIF
				ELSE
					MESSAGEBOX("Did not get the Master ID!!",0,"Error")
				ENDIF
			ELSE
				MESSAGEBOX("Receiving is not Cancelled!!",0,"Error")
			ENDIF
		ENDIF
		
		ThisForm.pf.PgEdit.SetFocus
		
		
	ENDPROC

	PROCEDURE pf.pgStockLst.id1.Click
		PRIVATE nID, cTBL
		nID = This.Value
		cTBL = This.parent.txtTBL.Value
		
		IF nID>0 AND LEN(cTBL)>0
			********************************************************
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = cHyperLink = HTML_Stock_ID(cTBL,nID,.T.) &&lReturnURL --not URL is an HTML code.
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ENDIF
	ENDPROC

	PROCEDURE pf.pgStockLst.lblHistory.Click
		PRIVATE cTBL,nID,nID_Detail
		cTBL = PrepareSQLtxt(This.Parent.TxtTBL.Value,'TBL',1)
		nID = PrepareSQLnum(This.Parent.ID1.Value,'ID',-3)
		
		IF nID > 0
			DO FORM Forms\StockLst_History.scx WITH cTBL,nID, 0
		ELSE
			DO FORM Forms\StockLst_History.scx WITH 0, 0
		ENDIF
	ENDPROC

	PROCEDURE pf.pgStockLst.lblHist_ID_Detail.Click
		PRIVATE cTBL,nID,nID_Detail
		cTBL	= PrepareSQLtxt(This.Parent.TxtTBL.Value,'TBL',1)
		nID		= PrepareSQLnum(This.Parent.ID1.Value,'ID',-3)
		nID_Detail =  PrepareSQLnum(This.Parent.ID_Detail1.Value,'ID_Detail',-3)
		
		IF nID_Detail > 0
			DO FORM Forms\StockLst_History.scx WITH cTBL,nID,nID_Detail
		ELSE
			DO FORM Forms\StockLst_History.scx WITH cTBL, nID, 0
		ENDIF
	ENDPROC

	PROCEDURE pf.pgStockLst.PO_ITEM1.DblClick
		PRIVATE cPOitem
		cPOitem = This.Value
		
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_POitem(cPOitem,.T.) &&lReturnURL --not URL is an HTML code.
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
			WAIT WINDOW "Look for a blinking Internet Explorer!" NOWAIT
		*	loIE.Navigate(get_Report_Server()+"%2fHPA+Purchasing+Reports%2fPurchaseOrders&rs:Command=Render&hpapo="+ALLTRIM(STR(nPO)) )
		
		ENDIF
	ENDPROC

	PROCEDURE pf.pgStockLst.SIZE_H1.GotFocus
		this.InputMask = "99,999.9999"
	ENDPROC

	PROCEDURE pf.pgStockLst.SIZE_H1.LostFocus
		this.InputMask = "999,999.9999"
	ENDPROC

	PROCEDURE pf.pgStockLst.SIZE_H1.Valid
		IF This.Value > 0
			IF This.parent.DIM11.Value > 0
				IF This.parent.DIM11.Value > This.Value
					WAIT WINDOW "The High Tolerance is usually higher than the Dim 1" NOWAIT
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The High Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE pf.pgStockLst.SIZE_L1.GotFocus
		this.InputMask = "99,999.9999"
	ENDPROC

	PROCEDURE pf.pgStockLst.SIZE_L1.LostFocus
		this.InputMask = "999,999.9999"
	ENDPROC

	PROCEDURE pf.pgStockLst.SIZE_L1.Valid
		IF This.Value > 0
			IF This.parent.DIM11.Value > 0
				IF This.parent.DIM11.Value < This.Value
					WAIT WINDOW "The Low Tolerance is usually below the Dim 1" NOWAIT
					*,0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The Low Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE pf.pgStockLst.Vcr1.Click
		SELECT Receiving
		DODEFAULT()
	ENDPROC

	PROCEDURE pf.pgStockLst.Vcr1.Init
		SELECT Receiving
		DODEFAULT()
	ENDPROC

	PROCEDURE pf.pgStockLst.Vcr1.recordpointermoved
		ThisForm.RefreshStockLst()
	ENDPROC

ENDDEFINE
