		cMachine = Proper_Heat_Lot_Machine(cHT_Lot)
		nLot	 = Proper_Heat_Lot_Lot(cHT_Lot)
		
		
		IF nLot > 0
			cHyperLink = HTML_MFG_Log(cMachine,nLot, .T.)
			IF LEN(cHyperLink)>0
			
				PRIVATE loHyperlink 
				loHyperlink = CREATEOBJECT("Hyperlink")
				loHyperlink.navigateto(cHyperLink)
				RELEASE loHyperlink 
		
			ELSE
				MESSAGEBOX("No Hyperlink",16,"Cannot show Lot")
			ENDIF
		ELSE
			MESSAGEBOX("No Lot number",16,"Cannot show Lot")
		ENDIF
	ENDPROC

	PROCEDURE pf.pgEdit.txtReceivingID.DblClick
