	PROCEDURE pf.pgEdit.Refresh
		This.txtStkID.Refresh
		This.txtReceived.Refresh
		This.txtPOitem.Refresh
		This.txtSOitem.Refresh
		This.txtVendor.Refresh
		This.txtAlloy.Refresh
		This.txtHeat.Refresh
		This.txtLot.Refresh
		This.edtDescription.Refresh
		This.txtInit.Refresh
		This.txtDate.Refresh
		This.chkAcctFinish.Refresh
		This.chkCert.Refresh
		This.chkPass.Refresh
		
		This.chkPOcomplete.Value = ThisForm.PO_Complete()
		This.chkCancel.Refresh
		*This.chkMillTrace.Refresh
		This.chkOnHold.Value 	= PrepareSQLlogic(Receiving.Hold,'Hold')
		
		This.edtSpecs.Refresh
		This.txtActualW.Refresh
		This.txtWhoAdd.Refresh
		This.edtComments.Refresh
		This.txtBillW.Refresh
		This.txtWhenAdd.Refresh
		This.txtReceivingID.Refresh
		This.txtRejectReason.Refresh
		This.txtPieces.Refresh
		This.txtRejectPC.Refresh
		
		This.txtID_Detail.Refresh
	ENDPROC

