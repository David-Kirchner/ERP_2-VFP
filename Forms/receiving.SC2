	ENDPROC

	PROCEDURE showpoitem
		PARAMETERS pcPOitem
		*ThisForm.ShowPOitem(cPOitem)
		
		PRIVATE cPOitem, cSOitem
		cPOitem = ''
		
		IF VARTYPE(pcPOitem) = "C"
			cPOitem = Proper_PO_Item( pcPOitem )
		ENDIF
		
		IF EMPTY(cPOitem )
			MESSAGEBOX("Cannot get PO.",0+32,"No PO-item")
			RETURN .F.
		ENDIF
		
		PRIVATE lnText2Find  
		lnText2Find  = VAL(LEFT(cPOitem,AT("-",cPOitem)-1))
		
		ThisForm.pf.pgEdit.txtFindText.Value = ALLTRIM(STR(lnText2Find))
		
		SELECT Receiving
		*POitem
		SET ORDER TO TAG HPAPO
		SEEK lnText2Find  IN 'Receiving' ORDER HPAPO
		
		IF NOT FOUND('Receiving')
			IF Count_HPAPOinPurchaseOrder( lnText2Find, ThisForm.nConnHandle ) = 0
				MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" has not been entered!"+CHR(13)+"Have this PO added in PurchaseOrder screen",0+16,"PO Not Found, Stop receiving and enter PO first!")
			ELSE
				IF Count_HPAPOinStockLst( lnText2Find, ThisForm.nConnHandle ) = 0
					MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" was not found in StockLst\BrokerLst list."+CHR(13)+"Have this PO edited in PurchaseOrder screen"+CHR(13)+"so ALL PO related tables are updated!",0+16,"PO Not Found, Stop receiving and enter PO first!")
				ELSE
					MESSAGEBOX(	"Po ="+ALLTRIM(STR(lnText2Find))+" was not found."+CHR(13)+CHR(13)+"But was found in PurchaseOrder and StockLst/BrokerLst!.",0+64,"Not found in Receiving.")
				ENDIF
			ENDIF
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('Receiving')	
			USE IN Receiving 
		ENDIF
		
		IF USED('poStatusDef')
			USE IN poStatusDef
		ENDIF
		
		IF USED("tmpStockLst_Master")
			USE IN tmpStockLst_Master
		ENDIF
		*Private Data
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
	ENDPROC

	PROCEDURE viewtab
		PARAMETER pParm
		*ThisForm.ViewTab(pParm)
		
		IF TYPE("pParm") != "C"
			RETURN .F.
		ENDIF
		
		DO CASE
		CASE pParm = "CANCEL"
			MESSAGEBOX("This will not effect the StockLst"+CHR(13)+"You must make StockLst edits throu StockLst program",0,"Cancel ?")
			
			RETURN .F.
		CASE pParm = "UNCANCEL"
			
			
			RETURN .F.
		ENDCASE
		RETURN .F.
	ENDPROC

	PROCEDURE wild_search_poitem
		PARAMETERS nReceivingID
		*ThisForm.Wild_Search_POitem(nReceivingID)
		
		IF nCntPOitemStock > 0
			IF nReceivingID > 0
					*Count for that POitem Process on Stock!
				IF nReceivingID > 0
					cSQL = " SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
					*Stock Master
					cSQL = cSQL + " SELECT TOP 1 "
					cSQL = cSQL + " (SELECT Count(*) AS CNT"
					cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  ) AS CNT "
					cSQL = cSQL + " , 'S' AS TBL, M.Heat, M.Lot "
					cSQL = cSQL + " ,D.ID_Detail ,'StockLst_M' AS Process_ID, 0 AS ID_Detail_Process "
					cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
					cSQL = cSQL + " UNION "
					*Stock History
					cSQL = cSQL + " SELECT TOP 1 "
					cSQL = cSQL + " (SELECT Count(*) AS CNT "
					cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
					cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' AND M.[heat] != 'DUE IN'"
					cSQL = cSQL + "  ) AS CNT "
					cSQL = cSQL + ", 'A' AS TBL, M.Heat, M.Lot "
					cSQL = cSQL + " ,D.ID_Detail ,'Stock_M_H' AS Process_ID, 0 AS ID_Detail_Process "
					cSQL = cSQL + " FROM dbo.Ar_Stocklst_Master_History M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + " WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  AND M.[WHAT] = 'DELETE' AND M.[heat] != 'DUE IN'"
		
					cSQL = cSQL + " UNION "
					*Stock Process
					cSQL = cSQL + " SELECT TOP 1 "
					cSQL = cSQL + " (SELECT Count(*) AS CNT "
					cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
					cSQL = cSQL + "  ) AS CNT "
					cSQL = cSQL + " , 'S' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
					cSQL = cSQL + " ,D.ID_Detail ,P.Process_ID AS Process_ID, P.ID_Detail_Process "
					cSQL = cSQL + " FROM dbo.StockLst_Process P WITH(NOLOCK) "
					*LEFT OUTER ?
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
					cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
					
		
					cSQL = cSQL + " UNION "
					*Broker Master
					cSQL = cSQL + " SELECT TOP 1 "
					cSQL = cSQL + " (SELECT Count(*) AS CNT"
					cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  ) AS CNT "
					cSQL = cSQL + " , 'B' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
					cSQL = cSQL + " ,D.ID_Detail ,'BrokerLsM' AS Process_ID, 0 AS ID_Detail_Process "
					cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"') "
		
					cSQL = cSQL + " UNION "
					*Broker Process
					cSQL = cSQL + " SELECT TOP 1 "
					cSQL = cSQL + " (SELECT Count(*) AS CNT "
					cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
					cSQL = cSQL + "  ) AS CNT "
					cSQL = cSQL + " , 'B' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
					cSQL = cSQL + " ,D.ID_Detail ,P.Process_ID AS Process_ID, P.ID_Detail_Process "
					cSQL = cSQL + " FROM dbo.BrokerLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
					cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
					cSQL = cSQL + " UNION "
					*WIP Master
					cSQL = cSQL + " SELECT TOP 1 "
					cSQL = cSQL + " (SELECT Count(*) AS CNT"
					cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  ) AS CNT "
					cSQL = cSQL + " , 'W' AS TBL, M.Heat, ISNULL(M.Lot,'') AS Lot "
					cSQL = cSQL + " ,D.ID_Detail ,'WIPLst_Mas' AS Process_ID, 0 AS ID_Detail_Process "
					cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON M.ID = D.ID "
					cSQL = cSQL + "  WHERE M.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		
					cSQL = cSQL + " UNION "
					*WIP Process
					cSQL = cSQL + " SELECT TOP 1 "
					cSQL = cSQL + " (SELECT Count(*) AS CNT "
					cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"	
					cSQL = cSQL + "  ) AS CNT "
					cSQL = cSQL + " , 'W' AS TBL, ISNULL(M.Heat,'') AS Heat, ISNULL(M.Lot,'') AS Lot "
					cSQL = cSQL + " ,D.ID_Detail ,'INCOMING' AS Process_ID, P.ID_Detail_Process "
					cSQL = cSQL + " FROM dbo.WIPLst_Process P WITH(NOLOCK) "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D WITH(NOLOCK) ON P.ID_Detail = D.ID_Detail "
					cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M WITH(NOLOCK) ON D.ID = M.ID "
					cSQL = cSQL + "  WHERE P.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQL = cSQL + "  AND ( P.Process_ID = 'INCOMING' OR P.Process_ID = 'PartRecv' )"
		
					cSQL = cSQL + " UNION "
					*Recieving  --May need TOP 1
					cSQL = cSQL + " SELECT 1 AS CNT "
					cSQL = cSQL + " , 'R' AS TBL, ISNULL(R.Heat,'') AS Heat, ISNULL(R.Lot,'') AS Lot"
					cSQL = cSQL + " , ISNULL(R.ID_Detail,0) AS ID_Detail, 'Receiving' AS Process_ID, 0 AS ID_Detail_Process "
					cSQL = cSQL + " FROM dbo.Receiving R WITH(NOLOCK) "
					cSQL = cSQL + "  WHERE R.POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
					
				ENDIF
				*IF nWO_Detail > 0
					*This is a POitem method, do not check WO_Detail here
					*Count for that WO_Detail Process on Stock!
				*" SELECT DISTINCT CNT, TBL, Heat, Lot, ID_Detail, Process_ID, ID_Detail_Process FROM ( "
				*cSQL = cSQL + " ) t ORDER BY TBL, Heat, Lot "
				cSQL = cSQL + " ) t ORDER BY [Process_ID] DESC, Heat, Lot "
				
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO_ProcessCNT')
			WAIT WINDOW 'TIMEOUT1' TIMEOUT 1
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 2
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPO_ProcessCNT' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_ProcessCNT")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 2
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPO_ProcessCNT")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				TrackError(cSQL,"Get POitem Detail, Bad Query", PROGRAM(), LINENO(1))
		
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPO_ProcessCNT' )	
			ENDIF
		ENDIF
		
		IF USED('tmpPO_ProcessCNT')
			IF RECCOUNT('tmpPO_ProcessCNT') > 1
				
				PRIVATE nCountIncm, cHistHeat 
				nCountIncm= 0
				
				SELECT tmpPO_ProcessCNT
		
				LOCATE FOR TBL = 'A'
				IF FOUND('tmpPO_ProcessCNT')
					lDelHistPOstk = .T.
					cHistHeat = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
					IF NOT cHistHeat = "DUE IN"
						cMess = cMess + "Found '"+ALLTRIM(cHistHeat)+"' in Archive. "+CHR(13)
						cMess = cMess + "        The Archive data will not be used. "+CHR(13)
						DELETE FROM tmpPO_ProcessCNT WHERE Heat = cHistHeat 
					ENDIF
				ENDIF
								
				COUNT ALL FOR Process_ID="INCOMING" AND NOT DELETED() TO nCountIncm
				GO TOP
				
				IF nCountIncm > 1
					PRIVATE cMess
					cMess = "Found many records"+CHR(13)+"you do not need to take action"+CHR(13)+"This could get messy:"+CHR(13)+CHR(13)
				ENDIF
				
				GO TOP
				
				PRIVATE cHeatNew,cLotNew, nID_DetailNew
				
				SCAN
					IF DELETED('tmpPO_ProcessCNT')
						LOOP
					ENDIF
					IF PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1) = "A"
						LOOP
					ENDIF
					IF tmpPO_ProcessCNT.CNT = 0
						LOOP
					ENDIF
					*IF NOT lChoosePOstk 
						IF PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1) = "R"
							*Found a Heat in Receiving and PO_item
							lFoundHeatRecv = .T.
					*		lChoosePOstk = .T.
							
							cHeatNew = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
							cLotNew	= PrepareSQLtxt(tmpPO_ProcessCNT.Lot,'Lot',10)
							nID_DetailNew = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail,'ID_Detail',-3)
							
							IF LEN(cHeat) > 0 AND LEN(cHeatNew) > 0 AND cHeat<>cHeatNew AND NOT cHeatNew = 'DUE IN' AND NOT cHeat = 'DUE IN' 
								cMess = cMess + "Found Heat '"+ALLTRIM(cHeatNew)+"' when looking for the Heat '"+cHeat+"'."+CHR(13)
								*MESSAGEBOX( "The Heat '"+cHeat+"' is being changed to '"+cHeatNew+"' ",48,"Could be a problem")
							ENDIF
							IF LEN(cHeatNew) > 0 AND NOT cHeatNew = 'DUE IN'
								cHeat = cHeatNew
							ENDIF
							
					*		MESSAGEBOX("Found POitem in Receiving 'R'"+CHR(13)+"Received Heat='"+cHeat+"'",64,"Found in Receiving")
							cMess = cMess + "Found '"+ALLTRIM(cHeat)+"', Lot '"+ALLTRIM(cLotNew)+"', ID_Detail="+ALLTRIM(STR(nID_DetailNew))+"' in Receiving. "+CHR(13)
							LOOP
						ENDIF
					
					
					*Found in S,B,W AND not in DELETED History
					cTBL = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
					IF LEN(cTBLOld) > 0
						IF cTBLOld <> cTBL
							cMess = cMess +CHR(13)+ "Found POitem in different tables:"+CHR(13)
							cMess = cMess + "Tables '"+cTBL+"' and '"+cTBLOld+"'"+CHR(13)
							cMess = cMess + "This is a weird, you could see incorrect data after this receive."+CHR(13)
							cMess = cMess + "Please double check stock after edit."+CHR(13)+CHR(13)
						ENDIF
					ENDIF
					cTBLOld = PrepareSQLtxt(tmpPO_ProcessCNT.TBL,'TBL',1)
					IF cTBL = "S" OR cTBL = "B" OR cTBL = "W" 
						*lChoosePOstk = .T.
						cHeat = PrepareSQLtxt(tmpPO_ProcessCNT.Heat,'Heat',50)
						cLot  = PrepareSQLtxt(tmpPO_ProcessCNT.Lot,'Lot',10)
						nID_Detail = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail,'ID_Detail',-3)
						
						cMess = cMess + "Found Heat '"+ALLTRIM(cHeat)+"', Lot '"+cLot+"' in Table '"+cTBL+"'. "+CHR(13)
						cProcess_ID = PrepareSQLtxt(tmpPO_ProcessCNT.Process_ID,'Process_ID',10)
						IF LEN(cProcess_ID) = 0
							cMess = cMess + "   without an Incoming Process_ID ."+CHR(13)
							nID_D_P = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
							IF nID_D_P > 0
								cMess = cMess + " nID_Detail_Process = "+ALLTRIM(STR(nID_D_P))+CHR(13)+CHR(13)
								IF nID_Detail_Process = 0
									nID_Detail_Process = nID_D_P
								ENDIF
							ENDIF
						ELSE
		
							cMess = cMess + "   with a Process_ID of '"+cProcess_ID+"'."+CHR(13)
							cMess = cMess + " nID_Detail = "+ALLTRIM(STR(nID_Detail))+CHR(13)
							IF cProcess_ID = "INCOMING"
								*Use this nID_Detail_Process !
								nID_Detail_Process = PrepareSQLnum(tmpPO_ProcessCNT.ID_Detail_Process,'ID_Detail_Process',-3)
								cMess = cMess + "INCOMING nID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+CHR(13)+CHR(13)
							ENDIF
						ENDIF
					ENDIF
				
				ENDSCAN
				
				IF nID_Detail_Process = 0
					cMess = cMess + CHR(13)+"Did not find an Incoming Process to receive to!"+CHR(13)
				ELSE
					cMess = cMess + CHR(13)+"Using Incoming Process "+ALLTRIM(STR(nID_Detail_Process))+" to receive to!"+CHR(13)
					IF nID_D_P > 0
						cMess = cMess + CHR(13)+"Where did Process "+ALLTRIM(STR(nID_D_P))+" come from!?!"+CHR(13)
					ENDIF
				ENDIF
				
				PRIVATE lFoundHeatRecv 
				lFoundHeatRecv = .F.
		
				IF nID_Detail_Process > 0
					cMess = cMess + CHR(13)+"Incomming Process "+ALLTRIM(STR(nID_Detail_Process))+" will be choosen to be used."
				ENDIF
				cMess = cMess + CHR(13)+"You may get another screen"+CHR(13)+" where you can choose "+CHR(13)+"to EDIT a Certain Heat"
				
				IF ( NOT lFoundHeatRecv AND RECCOUNT('tmpPO_ProcessCNT') = 1 )
					MESSAGEBOX(cMess,48,"Found for POitem '"+cPOitem+"'")
					RecordTest( 'Record Test Data.', PROGRAM(), LINENO(1),cMess)
				ENDIF
				lChoosePOstk = .T.
			ENDIF
			USE IN tmpPO_ProcessCNT
		ENDIF
		
	ENDPROC

	PROCEDURE cmdAddNewRecv.Valid
		WAIT WINDOW 'Loading Receive_Edit Window' NOWAIT
		
		DO FORM Forms\Receive_Edit WITH 'ADD','','',0
		*USE DO FORM Forms\Receive_Edit WITH 'POitem',cPOitem,'ADD' when the POitem is Known
		
		ThisForm.ReceivingRefreshReceiving()  &&Clears Form, reloads data
		
		ThisForm.pf.ActivePage = 5
		ThisForm.RefreshStockLst()
		
		
		RETURN .T.
		
		
	ENDPROC

	PROCEDURE cmdDeleteReceiving.Valid
		PRIVATE lCancelled 
		lCancelled 	= PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		
		IF NOT lCancelled
			MESSAGEBOX('Record needs to be Cancelled before you can Delete.'+CHR(13)+"Only Duplicate Receives on POitems and one is Cancelled will be Deleteable",0,"Cannot Delete")
			RETURN .F.
		ENDIF
		
		PRIVATE nCurrRec 
		SELECT Receiving 
		nCurrRec = RECNO()
		
		PRIVATE cPOitem, cSOitem, nReceivingID, nWO_Detail, nID_Master, cTBL
		cPOitem		= PrepareSQLtxt(Receiving.POitem,'POitem',12)
		cSOitem 	= PrepareSQLtxt(Receiving.Soitem,'SOitem',10)
		nReceivingID	= PrepareSQLnum(Receiving.ID,'ID',-3)
		nWO_Detail	= PrepareSQLnum(Receiving.WO_Detail,'WO_Detail',-3)
		nID_Master	= PrepareSQLnum(Receiving.ID_Master,'ID_Master',-3)
		nID_Detail	= PrepareSQLnum(Receiving.ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(Receiving.StockTable,'TBL',1)
		
		PRIVATE cMess
		cMess = "Are you Sure You want to Delete this Receiving record:"+ALLTRIM(STR(nReceivingID))+CHR(13)
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			cMess = cMess+"for PO item:"+cPOitem+"?"+CHR(13)
		ENDIF
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			cMess = cMess+"for SO item:"+cSOitem+"?"+CHR(13)
		ENDIF
		IF nWO_Detail > 0
			cMess = cMess+"for WO Detail:"+STR(nWO_Detail)+"?"+CHR(13)
		ENDIF
		
		
		
		IF MESSAGEBOX(cMess+CHR(13)+"This action will send Email alerts!",4,"Delete?") != 6
			RETURN .F.
		ENDIF
		
		PRIVATE lRollBack
		lRollBack = .F.
		
		
		*See if Duplicate
		PRIVATE  nID_Detail_Process
		nID_Detail_Process=0
		
		PRIVATE cSQL
		*!*	IF USED("cntRecvPOitem")
		*!*		USE IN cntRecvPOitem
		*!*	ENDIF
		*!*	SELECT 0
		
		*!*	cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Receiving WITH(NOLOCK) WHERE "
		*!*	IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
		*!*		cSQL = cSQL+" POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		*!*		IF nWO_Detail > 0
		*!*			cSQL = cSQL+" OR WO_Detail = "+STR(nWO_Detail)
		*!*		ENDIF
		*!*	ELSE
		*!*		IF nWO_Detail > 0
		*!*			cSQL = cSQL+" WO_Detail = "+STR(nWO_Detail)
		*!*		ELSE
		*!*			TrackError("Could not Count in dbo.Receive no POitem or WO_Detail to look for to delete","Could not Count in dbo.Receive ", PROGRAM(), LINENO(1))
		*!*		ENDIF
		*!*	ENDIF	
		
		*!*	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntRecvPOitem')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntRecvPOitem')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntRecvPOitem")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntRecvPOitem")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntRecvPOitem')
		*!*		*lRollBack = .T.
		*!*	ENDIF
		
		*!*	IF USED("cntRecvPOitem")
		*!*		IF RECCOUNT("cntRecvPOitem") > 0
		*!*			IF cntRecvPOitem.Cntd < 2
		*!*				MESSAGEBOX("Only Duplicate Receives on PO items Deleteable."+CHR(13)+"Delete the bad record after a correct 'duplicate' has been added."+CHR(13)+"Tell David or just leave as Cancelled",0,"Cannot Delete")
		*!*				RETURN .F.
		*!*			ENDIF
		*!*		ENDIF
		*!*		USE IN cntRecvPOitem
		*!*	ENDIF
		
		
		*************************
		
		*!*	IF cTBL='N' AND nID_Detail = 0
		*!*		*This combo is 
		*!*	ELSE
		*!*		IF nID_Detail = 0
		*!*			MESSAGEBOX("Sorry this Delete needs an ID_Detail"+CHR(13)+"This receive may have been create before ID_Detail was recorded here."+CHR(13)+"You could Ask David to update the ID_Detail.",48,"Cannot Delete")
		*!*			RETURN .F.
		*!*		ENDIF
		*!*		IF EMPTY(cTBL)
		*!*			MESSAGEBOX("Sorry this Delete needs an Table"+CHR(13)+"This receive may have been create before TABLE was recorded here."+CHR(13)+"You could Ask David to update the ID_Detail.",48,"Cannot Delete")
		*!*			RETURN .F.
		*!*		ENDIF
		*!*	ENDIF
		
		******************************************
		IF nID_Detail > 0
			*COUNT Stock
			PRIVATE nCountStock
			nCountStock = 0
			IF USED('cntRecvWOD')
				USE IN cntRecvWOD
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS CNTD FROM "
			DO CASE 
			CASE cTBL = "S"
				cSQL = cSQL+" dbo.StockLst_Detail D "
			CASE cTBL = "B"
				cSQL = cSQL+" dbo.BrokerLst_Detail D "
			CASE cTBL = "W"
				cSQL = cSQL+" dbo.WIPLst_Detail D "
			ENDCASE	
			cSQL = cSQL + " WHERE ID_Detail="+STR(nID_Detail)
			cSQL = cSQL + " AND ReceivingID = "+STR(nReceivingID)
		
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntRecvWOD')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntRecvWOD')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntRecvWOD")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntRecvWOD")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntRecvWOD')
				*lRollBack = .T.
			ENDIF
		
			IF USED("cntRecvWOD")
				IF RECCOUNT("cntRecvWOD") > 0
					IF cntRecvWOD.Cntd > 0
						nCountStock = PrepareSQLnum(cntRecvWOD.Cntd,'CNTD',-3)
						*MESSAGEBOX("Only Duplicate Receives on PO items Deleteable."+CHR(13)+"Delete the bad record after a correct 'duplicate' has been added."+CHR(13)+"Tell David or just leave as Cancelled",0,"Cannot Delete")
						*RETURN .F.
					ENDIF
				ENDIF
				USE IN cntRecvWOD
			ENDIF
		
		
			PRIVATE cMess, nMess
			nMess = 0
		
			IF nCountStock > 0
				cMess = "Deleting the receiving record will remove the Stock received."+CHR(13)+CHR(13)
				cMess = cMess+"Table '"+TableName_TBL(cTBL)+"'"+CHR(13)
				cMess = cMess+" AND ID_Detail="+ALLTRIM(STR(nID_Detail))+CHR(13)
				cMess = cMess+"will be Deleted!"+CHR(13)
				
				nMess = MESSAGEBOX(cMess+CHR(13)+"Are you Sure You want to Delete this record?"+CHR(13)+"And Remove the Stock",4,"Delete Receiving?") 
			ELSE
				nMess = MESSAGEBOX("Are you Sure You want to Delete this record?",4,"Delete Receiving?") 
			ENDIF
		
			IF nMess != 6
				RETURN .F.
			ENDIF
		ENDIF
		
		**************************************************
		
		*One transaction
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && Manual transactions
		
		
		**************************************************
		IF nID_Detail > 0
			PRIVATE lForceDelete,cFrom,cWhy
			lForceDelete = .F.
			cFrom = "Deleted Receiving"
			cWhy = "Deleted ReceivingID:"+ALLTRIM(STR(nReceivingID))
		
			PRIVATE lExists 
			lExists = ID_Detail_Exists(nID_Detail,cTBL,ThisForm.nConnHandle)
			IF lExists 
				*Only need to remove Stock! ???
				IF cTBL = "S"
					IF Remove_Lst_Detail_by_ID_Detail(cTBL,nID_Detail,ThisForm.nConnHandle, cFrom, cWhy)
						IF NOT Remove_Lst_ID(cTBL,nID_Master,ThisForm.nConnHandle,lForceDelete,cFrom,cWhy)			
							lRollBack = .T.
						ENDIF
					ELSE
						lRollBack = .T.
					ENDIF
						
					TrackMess(cMess)
					cMess=cMess+CHR(13)+"Receiving:cmdDeleteReceiving.Valid()"
				ENDIF
			ENDIF
		ENDIF
		
		
		**************************************************
		
		*Delete the receive Record
		PRIVATE nSQLEXEC, cSQLu 
		IF NOT lRollBack
			cSQLu = "DELETE FROM dbo.Receiving "
			cSQLu = cSQLu +" WHERE ID = "+STR(nReceivingID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
				lRollBack = .T.
				RETURN .F.
			ELSE 
				TrackMess("Deleted Receiving ID"+ALLTRIM(STR(nReceivingID))+", PO:"+ALLTRIM(cPOitem)+", SO:"+ALLTRIM(cSOitem)+", TBL:"+cTBL+", ID_Master:"+ALLTRIM(STR(nID_Master))+", ID_Detail:"+ALLTRIM(STR(nID_Detail)) )
				*Refresh cache
			ENDIF
		ENDIF
		
		
		**********************************************************************************
		
		*!*	*reCREATE a StockLst Process
		*!*	IF NOT lRollBack
		*!*		nMess = 0
		*!*		DO CASE
		*!*		CASE cTBL = "S"
		*!*			nMess = MESSAGEBOX("Do you want to create an INCOMING record?"+CHR(13)+"Is more Receiving "+CHR(13)+"needed right now?",4+48,"Create Incoming?") 
		*!*		ENDCASE
		*!*		
		*!*		IF nMess = 6
		*!*			PRIVATE cUser, cSalesPerson, cAllowSub,nWeight,nPc,dStartDate,dDueDate
		*!*			cUser		= LEFT( SUBSTR(SYS(0), AT("#",SYS(0))+1 ), 20)
		*!*			cSalesPerson		= PrepareSQLtxt( cUser,'SalesPerson', 20)
		*!*			cAllowSub	= "Y"
		*!*			nWeight		= 0
		*!*			nPounds		= 0
		*!*			nPc			= 0
		*!*			dStartDate	= DATE()
		*!*			dDueDate	= DATE()
		*!*			
		*!*			PRIVATE nPU, nStockLst_QTY
		*!*			nPU			= 0
		*!*			nStockLst_QTY = 0
		*!*			
		*!*			PRIVATE  cProcess_ID,cProcessor,cComment 
		*!*			cProcess_ID		= "Receiving"  &&Used in Searches, DO NOT change
		*!*			cProcessor		= LEFT( ALLTRIM(SYS(0))+" "+DTOC(date())+" "+time(), 20)
		*!*			cProcessor		= PrepareSQLtxt( cProcessor,'Processor',20)
		*!*			cComment 		= "Created DELETE Process for ReceivingID "+ALLTRIM(STR(nReceivingID))
		
		
		*!*			IF USED('tmpID_Detail_Process')
		*!*				USE IN tmpID_Detail_Process
		*!*			ENDIF
		*!*			SELECT 0
		
		*!*			*IF cTBL="S"
		*!*				cSQLi = "EXEC dbo.p_StockLst_Process_ins5 "
		*!*			*	cSQLi = "EXEC dbo.p_BrokerLst_Process_ins5 "
		*!*			*ENDIF
		*!*			cSQLi = cSQLi + " @ID_Detail = "+STR(nID_Detail)+""
		*!*			cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		*!*			cSQLi = cSQLi + ",@StartDate = '"+DTOC( DATE() )+"'"
		*!*			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		*!*			cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"
		*!*			cSQLi = cSQLi + ",@PU = "+STR(nPU)
		*!*			cSQLi = cSQLi + ",@QTY = "+STR(nStockLst_QTY,18,4)
		*!*			cSQLi = cSQLi + ",@Pounds= "+STR(nPounds,9,1)
		*!*			cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		*!*			cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
		*!*			cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"
		*!*			cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		*!*			cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		*!*			cSQLi = cSQLi + ",@ReceivingID= "+STR(nReceivingID)+""
		*!*					
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLi, ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
		*!*				lRollBack = .T.
		*!*			ELSE
		*!*				PRIVATE cText
		*!*				cText="INFO: Created DELETE Process for ReceivingID "+ALLTRIM(STR(nReceivingID))
		*!*				cText=cText+' frmReceiving.ReceivingSaveID_Master'+"Process_ID="+STR(tmpID_Detail_Process.EXP)
		*!*				cText=cText+" StockTable="+cTBL+" PO item="+cPOitem
		*!*				TrackMess(cText)
		*!*			ENDIF
		
		*!*			IF USED('tmpID_Detail_Process')
		*!*				USE IN tmpID_Detail_Process
		*!*			ENDIF
		*!*			
		*!*		ENDIF
		*!*	ENDIF
		
		***************************************************************************************
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			* Update PurchaseOrders as not Received.
			IF NOT lRollBack
				PRIVATE lDelivered
				lDelivered = .F.
				*IS POitem listed as Delivered?
				
				cSQL = "SELECT ISNULL(Delivered,0) AS Delivered "
				cSQL = cSQL + " FROM dbo.PurchaseOrder WITH(NOLOCK) "
				cSQL = cSQL + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOItem+"')"
				
				IF USED("tmpCountPOD")
					USE IN tmpCountPOD
				ENDIF
				SELECT 0
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountPOD')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCountPOD')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountPOD")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCountPOD")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCountPOD')
					*TrackMess("Error with Add Receiving ID:"+ALLTRIM(STR(nReceivingID)) )
				ELSE
					IF USED("tmpCountPOD")
						IF RECCOUNT("tmpCountPOD") > 0
							lDelivered = PrepareSQLlogic(tmpCountPOD.Delivered,'Delivered')
						ENDIF
						USE IN tmpCountPOD
					ENDIF
				ENDIF
				
				
				IF lDelivered
					nMess = 6
					nMess = MESSAGEBOX("Do you want to list POitem"+CHR(13)+"as Not Delivered?",4+48,"UN mark POitem delivered?") 
					
					IF nMess = 6		
						PRIVATE cSQLu
						cSQLu = "UPDATE dbo.PurchaseOrder SET "
						cSQLu = cSQLu + " Receipt ='Receiving record was deleted.'"
						cSQLu = cSQLu + ",Received =''"		
						cSQLu = cSQLu + ",ReceivedBy =' '"
						cSQLu = cSQLu + ",Heat =' '"
						cSQLu = cSQLu + ",Delivered=0"
						cSQLu = cSQLu + ",Cert=0"
						cSQLu = cSQLu + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOItem+"')"
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQLu, ThisForm.nConnHandle, nSQLEXEC )
							lRollBack = .T.
						ELSE
							TrackMess( "Deleted Receiving ID:"+ALLTRIM(STR(nReceivingID))+" Updated POitem:"+ALLTRIM(cPOitem)+" to not Delivered in PurchaseOrders.")
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		************************************************
		
		IF nWO_Detail > 0
			* Update WorkOrder_Detail as not Received.
			IF NOT lRollBack
					*IS WO_Detail listed as Delivered?
			ENDIF
		ENDIF
		
		************************************************
		
		IF lRollBack 
			=SQLROLLBACK(ThisForm.nConnHandle)
			MESSAGEBOX('Nothing has been saved!',0+16,"Rollback")
		ELSE
			IF SQLCOMMIT(ThisForm.nConnHandle) < 1
				SQLExecError("Cannot save or 'commit' to SQL database."+CHR(13)+cInsert,ThisForm.nConnHandle,nSQLEXEC,'')
				MESSAGEBOX('Nothing has been saved!',0+16,"SQL Error")
			ELSE
				IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
					TrackMess( "DELETED Receiving ID:"+ALLTRIM(STR(nReceivingID))+" for POitem:"+ALLTRIM(cPOitem))
					MESSAGEBOX("You can Edit the PO item and Save to recreated a missing Stock/Broker listing if needed.",64,"Successfully removed Receiving data")
				ENDIF
				IF  nWO_Detail > 0
					TrackMess( "DELETED Receiving ID:"+ALLTRIM(STR(nReceivingID))+" for WO_Detail:"+ALLTRIM(STR(nWO_Detail)) )
					*MESSAGEBOX("Completed removal of receiving."+CHR(13)+"Now Edit POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrders"+CHR(13)+"and SAVE so proper StockLst entries can be recreated."+CHR(13)+"Then a new receive can be done to the correct stock.",0+48,"Successfully removed all Receiving data")
					*MESSAGEBOX("You can Edit the PO item and Save to recreated a missing Stock/Broker listing if needed.",64,"Successfully removed Receiving data")
				ENDIF
			ENDIF
		ENDIF
		
		*SQLROLLBACK( )
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && Auto transactions
		
		**************************************************
		
		ThisForm.ReLoad()  &&No nRID
		*Refresh
		SELECT Receiving
		IF nCurrRec < RECCOUNT()
			GOTO nCurrRec
		ELSE 	
			GO BOTTOM
		ENDIF
		
		ThisForm.pf.pgEdit.Vcr1.RecordPointerMoved
		*ThisForm.RefreshEditTab()
		*ThisForm.pf.pgEdit.grdReceiving.Refresh
		ThisForm.pf.pgEdit.chkCancel.Refresh
		
		ThisForm.cmdDeleteReceiving.Enabled = PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		
	ENDPROC

	PROCEDURE cmdPrintPO.Valid
		PRIVATE nRecNo
		SELECT Receiving 
		nRecNo = RECNO()
		
		IF FILE('reports\Receiving.FRX')
			REPORT FORM reports\Receiving.FRX FOR RECNO() = nRecNo PREVIEW &&TO PRINTER NOCONSOLE
		ELSE
			WAIT WINDOW "Report form 'reports\Receiving.FRX' not found" NOWAIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdQuit.Click
		*!*	IF USED('receiving')
		*!*		cUsed = ALIAS()
		*!*		SELECT receiving
		*!*		lcSafety = SET('SAFETY')
		*!*		SET SAFETY OFF
		*!*		
		*!*	*	WAIT WINDOW "Saving to C:\receiving" NOWAIT
		*!*		COPY TO C:\receiving FOR Received > DATE()-14
		
		*!*		IF NOT EMPTY(lcSafety)
		*!*			IF lcSafety = "ON"
		*!*				SET SAFETY ON
		*!*			ENDIF
		*!*		ENDIF
		*!*		IF NOT EMPTY(cUsed)
		*!*			SELECT (cUsed)
		*!*		ENDIF
		*!*	ENDIF
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdReportReceiving.Valid
		PRIVATE nReceivingID, cPOitem
		nReceivingID = PrepareSQLnum(Receiving.ID,'ReceivingID',-3)
		cPOitem	= PrepareSQLtxt(Receiving.POitem,'POitem',12)
		
		PRIVATE loHyperlink,m.cHyperLink
		IF cPOitem <> Proper_PO_Item('')
			m.cHyperLink = HTML_Receiving_POitem(cPOitem,.T.) &&lReturnURL --not URL is an HTML code.
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			MESSAGEBOX("Look for Open Web Browser for this Report",0,"Report Complete")
		ELSE
			m.cHyperLink = HTML_ReceivingID(nReceivingID,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			MESSAGEBOX("Look for Open Web Browser for this Report",0,"Report Complete")
		ENDIF
		
		RELEASE loHyperlink,m.cHyperLink
	ENDPROC

	PROCEDURE cmdSelectedReport.Click
		PRIVATE m.cHyperLink, m.cPOitem, loHyperlink
		
		m.cPOitem = ThisForm.pf.pgEdit.txtPOitem.Value
		IF Proper_PO_item(m.cPOitem) <> Proper_PO_item('')
		
			m.cHyperLink = HTML_Receiving_SELECTED_SOitem(m.cPOitem,.T.)
		
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			MESSAGEBOX("Did not find the POitem",0,'Not a PO')
		ENDIF
	ENDPROC

	PROCEDURE pf.AddObject
		LPARAMETERS cName, cClass
		
		
	ENDPROC

	PROCEDURE pf.pgBrowse.Click
		SELECT Receiving
		SET ORDER TO TAG rID
		*This.GridBR.RecordSourceType = 1
		*This.GridBR.RecordSource = "Receiving"
		This.GridBR.Refresh
		This.GridBR.setfocus
		ThisForm.cmdPrintPO.Enabled = .T.
		ThisForm.cmdDeleteReceiving.Visible = .F.
		
		
	ENDPROC

	PROCEDURE pf.pgEdit.chkCancel.Click
		PRIVATE lCancelled, lCancelClick, nReceivingID
		lCancelled 	= PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		lCancelClick = PrepareSQLlogic(This.Value,'Cancelled')
		nReceivingID = PrepareSQLnum(Receiving.ID,'ReceivingID',-3)
		
		IF nReceivingID < 1
			MESSAGEBOX("Lost Receiving ID.",16,"Cannot continue")
			RETURN .F.
		ENDIF
		
		PRIVATE nMess, cMess, cSQL, nSQLEXEC
		
		IF lCancelClick 
			nMess = MESSAGEBOX("Are you sure you want to Cancel this Receiving record:"+ALLTRIM(STR(nReceivingID)),32+4,"Cancel Receive?")
			IF nMess = 6
				
				cSQL = "UPDATE dbo.Receiving SET "
				cSQL = cSQL + " [Cancelled] = 1"
				cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as Cancelled for ID="+ALLTRIM(STR(nReceivingID))+" in Receiving" )
					ThisForm.cmdDeleteReceiving.Enabled = .T.
					MESSAGEBOX("The Delete Receiving Record is now available."+CHR(13)+CHR(13)+"Look for the red button"+CHR(13)+"at bottom left of this screen"+CHR(13)+CHR(13)+"[Delete Receiving Record]",0+48,"Delete is now Available")			
				ENDIF
			ENDIF
		ELSE
			nMess = MESSAGEBOX("Are you sure you want to UN-Cancel this Receive?",32+4,"UN Cancel Receive?")
			IF nMess = 6
				
				cSQL = "UPDATE dbo.Receiving SET "
				cSQL = cSQL + " [Cancelled] = 0"
				cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as UNCancelled for ID="+ALLTRIM(STR(nReceivingID))+" in Receiving" )
					ThisForm.cmdDeleteReceiving.Enabled = .F.
				ENDIF
			ENDIF
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE pf.pgEdit.chkMillTrace.Click
		PRIVATE lCancelled, nReceivingID
		lCancelled 	= PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		*lMillTrace = PrepareSQLlogic(This.Value,'MillTrace')
		lMillTrace = PrepareSQLlogic(Receiving.MillTrace,'MillTrace')
		nReceivingID = PrepareSQLnum(Receiving.ID,'ReceivingID',-3)
		
		IF nReceivingID < 1
			MESSAGEBOX("Lost Receiving ID.",16,"Cannot continue")
			RETURN .F.
		ENDIF
		
		PRIVATE nMess, cMess, cSQL, nSQLEXEC
		PRIVATE lOK 
		lOK = .T.
		
		IF lMillTrace 
			nMess = MESSAGEBOX("Are you sure you want to "+CHR(13)+"Remove the Mill Trace stamp for this Receive?"+CHR(13)+"this Receiving record:"+ALLTRIM(STR(nReceivingID)),32+4,"Remove Mill Traceable stamp from Receive?")
			IF nMess = 6
				
		*!*			cSQL = "UPDATE dbo.Receiving SET "
		*!*			cSQL = cSQL + " [MillTrace] = 0"
		*!*			cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
		*!*				lOK  = .F.
		*!*			ELSE
					
					lOK = Receiving_Stock_MillTrace(.F.,nReceivingID,ThisForm.nConnHandle)
					*Updates StockLst
		*		ENDIF
				IF lOK 
					REPLACE MillTrace WITH .F. IN Receiving
					This.Refresh
					MESSAGEBOX("Saved."+CHR(13)+"Place this On HOLD so you get reminders",0+64,"On HOLD")
					TrackMess( "Marked as not Full Mill Traceable for Receiving_ID="+ALLTRIM(STR(nReceivingID))+" in Receiving" )
					ThisForm.cmdDeleteReceiving.Enabled = .T.
					MESSAGEBOX("un Marked Full Mill Traceable",0,"Saved")
				ELSE
					*Backout the MillTrace update!
					cSQL = "UPDATE dbo.Receiving SET "
					cSQL = cSQL + " [MillTrace] = 1"
					cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
					ENDIF
					REPLACE MillTrace WITH .T. IN Receiving
					
				ENDIF
			ENDIF
		ELSE
			nMess = MESSAGEBOX("Are you sure you want mark "+CHR(13)+"this receive to have full "+CHR(13)+"Mill Cert Traceable?",32+4,"Mill Traceable")
			IF nMess = 6
				
		*!*			cSQL = "UPDATE dbo.Receiving SET "
		*!*			cSQL = cSQL + " [MillTrace] = 1"
		*!*			cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
		*!*				lOK = .F.
		*!*			ELSE
					lOK = Receiving_Stock_MillTrace(.T.,nReceivingID,ThisForm.nConnHandle)
						*Calls: Stock_Mark_MillTrace(lMark, nReceivingID, cTBL, nID, nID_Detail, nConn )
						*Updates StockLst
		*		ENDIF
				IF lOK 
					REPLACE MillTrace WITH .T. IN Receiving
					This.Refresh
					TrackMess( "Marked Full Mill Traceable for Receiving_ID="+ALLTRIM(STR(nReceivingID))+" in Receiving" )
					MESSAGEBOX("Marked Full Mill Traceable",0,"Saved")
					
					ThisForm.Remove_Receive_Hold(nReceivingID)
					
				ELSE
					*Backout the MillTrace update!
					cSQL = "UPDATE dbo.Receiving SET "
					cSQL = cSQL + " [MillTrace] = 0"
					cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
					ENDIF
					REPLACE MillTrace WITH .F. IN Receiving
				ENDIF
			ENDIF
		ENDIF
		
		This.Refresh
		
		
	ENDPROC

	PROCEDURE pf.pgEdit.chkOnHold.Click
		*PRIVATE lOnHold
		*lOnHold = PrepareSQLlogic(This.Value,'Hold')
		*MESSAGEBOX("This button has not been programed."+CHR(13)+"Fix the CofC or Mill Trace to remove hold.",0,"")
		
		PRIVATE lCancelled, nReceivingID, lMillTrace, lOnHold
		lCancelled 	= PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		nReceivingID = PrepareSQLnum(Receiving.ID,'ReceivingID',-3)
		lMillTrace = PrepareSQLlogic(Receiving.MillTrace,'MillTrace')
		lOnHold = PrepareSQLlogic(Receiving.Hold,'OnHold')
		
		IF nReceivingID < 1
			MESSAGEBOX("Lost Receiving ID.",16,"Cannot continue")
			RETURN .F.
		ENDIF
		
		PRIVATE nMess, cMess, cSQL, nSQLEXEC
		PRIVATE lOK 
		lOK = .T.
		
		
		IF lOnHold 
			nMess = MESSAGEBOX("Are you sure you want to "+CHR(13)+"Remove the OnHold stamp for this Receive?"+CHR(13)+"this Receiving record:"+ALLTRIM(STR(nReceivingID)),32+4,"Remove OnHold stamp from Receive?")
			IF nMess = 6
				
				cSQL = "UPDATE dbo.Receiving SET "
				cSQL = cSQL + " [Hold] = 0"
				cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
					lOK  = .F.
				ELSE
					lOK = .T.
					*lOK = Receiving_Stock_MillTrace(.F.,nReceivingID,ThisForm.nConnHandle)
					*Updates StockLst
				ENDIF
				IF lOK 
					REPLACE Hold WITH .F. IN Receiving
					This.Refresh
					*MESSAGEBOX("Saved."+CHR(13)+"Place this On HOLD so you get reminders",0+64,"On HOLD")
					TrackMess( "Marked as not OnHold for Receiving_ID="+ALLTRIM(STR(nReceivingID))+" in Receiving" )
					*ThisForm.cmdDeleteReceiving.Enabled = .T.
					MESSAGEBOX("un Marked OnHold Traceable",0,"Saved")
				ELSE
					REPLACE Hold WITH .T. IN Receiving
					This.Refresh
				ENDIF
			ENDIF
		ELSE
			nMess = MESSAGEBOX("Are you sure you want mark "+CHR(13)+"this receive as Hold?",32+4,"Hold")
			IF nMess = 6
				
				cSQL = "UPDATE dbo.Receiving SET "
				cSQL = cSQL + " [Hold] = 1"
				cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
					lOK = .F.
				ELSE
					lOK = .T.
		*			lOK = Receiving_Stock_MillTrace(.T.,nReceivingID,ThisForm.nConnHandle)
						*Calls: Stock_Mark_MillTrace(lMark, nReceivingID, cTBL, nID, nID_Detail, nConn )
						*Updates StockLst
				ENDIF
				IF lOK 
					REPLACE Hold  WITH .T. IN Receiving
					This.Refresh
					TrackMess( "Marked Hold for Receiving_ID="+ALLTRIM(STR(nReceivingID))+" in Receiving" )
					MESSAGEBOX("Marked Hold",0,"Saved")
					
					*ThisForm.Remove_Receive_Hold(nReceivingID)
					
				ELSE
		
					REPLACE HOLD WITH .F. IN Receiving
					This.Refresh
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pf.pgEdit.chkPOcomplete.Valid
		*Change Similar code in Ship - SO complete
		
		*IF MESSAGEBOX("Are you sure you want to change this PO?",4+32,"Change PO Status") = 6  &&Yes
		
		
		
		PRIVATE lComplete, cPOitem, dReceived, cSQL, nSQLEXEC
		*lComplete	= PrepareSQLlogic(This.Value,'Complete',.F.)
		lComplete	= ThisForm.PO_Complete()
		
		cPOitem 	= PrepareSQLtxt(Receiving.POitem,'POitem',12)
		IF Proper_PO_item(cPOitem) = Proper_PO_item('')
			MESSAGEBOX('No valid PO number found',0+16,"No PO")
			RETURN .F.
		ENDIF
		
		dReceived	= PrepareSQLdate(Receiving.Received,'Received')
		
		IF EMPTY(dReceived)
			dReceived = DATE()
		ENDIF
		
		IF NOT lComplete 
			IF MESSAGEBOX("Are you sure you want to mark POitem:"+ALLTRIM(cPOitem)+" as Complete?",4+32,"Mark as Complete?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [Delivered] = 1"
				cSQL = cSQL +" ,Received = '"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"	
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as Complete for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					
		*!*	*TRIGGER [dbo].[PurchaseOrder_After_Update] ON dbo.PurchaseOrder  		
		*!*	IF UPDATE([Delivered])  
		*!*		IF EXISTS (SELECT * FROM inserted WHERE inserted.Delivered = 1) 
		*!*			BEGIN
		*!*			DELETE FROM dbo.BrokerLst_Process
		*!*				FROM inserted
		*!*				WHERE inserted.POitem = BrokerLst_Process.PO_item 
		*!*				AND BrokerLst_Process.Process_ID = 'INCOMING  '
		*!*				AND inserted.Delivered = 1
		*!*			DELETE FROM dbo.StockLst_Process
		*!*				FROM inserted
		*!*				WHERE inserted.POitem = StockLst_Process.PO_item 	
		*!*				AND StockLst_Process.Process_ID = 'INCOMING  '
		*!*				AND inserted.Delivered = 1
		
						
					*ENDIF
				ENDIF
				
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to UNmark POitem:"+ALLTRIM(cPOitem)+" as Complete?",4+32,"Mark as NOT Complete?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [Delivered] = 0"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as NOT Complete for POitem="+ALLTRIM(cPOitem)+" in Ship table, Ship screen" )
					
		
				ENDIF
				
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE pf.pgEdit.Click
		SELECT Receiving
		SET ORDER TO TAG rID
		ThisForm.Refresh
		This.grdReceiving.SetFocus
		ThisForm.cmdPrintPO.Enabled = .T.
		ThisForm.cmdDeleteReceiving.Visible = .T.
		*ThisForm.cmdDeleteReceiving.Enabled = PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		
	ENDPROC

	PROCEDURE pf.pgEdit.cmboFind.Valid
		*RowSource=Purchase Order,Sales Order,Vendor,Heat,ID_Master,ReceivingID,WO_Detail
		PRIVATE IntcmbFind
		IntcmbFind = INT(This.Value)
		*Purchase Order,Sales Order,Vendor,Heat,ID_Master
		DO CASE
		CASE IntcmbFind = 1
			*HPApo n,9
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"999999999"
		CASE IntcmbFind = 2
			*SalesNum N,7
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999"
		CASE IntcmbFind = 3
			*Vendor c,30
			m.FindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 4
			*Heat c,30
			m.FindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 5
			*ID_Master INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"99999999999"
		CASE IntcmbFind = 6
			*ReceiveID INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"999999999"
		CASE IntcmbFind = 7
			*WO_Detail INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"999999999"
		CASE IntcmbFind = 8
			*RMA_NO INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"999999999"
		CASE IntcmbFind = 9
			*RMA_Detail INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"999999999"
		ENDCASE
		This.Parent.txtFindText.Refresh
	ENDPROC

	PROCEDURE pf.pgEdit.cmdAdmin.Click
		IF This.Parent.txtReceived.ReadOnly 
			*Edit
			ThisForm.pf.pg_Edit.txtReceived.ReadOnly = .F.
			
			ThisForm.pf.pg_Edit.txtVendor.ReadOnly = .F.
			ThisForm.pf.pg_Edit.edtDescription.ReadOnly = .F.
			ThisForm.pf.pg_Edit.edtSpecs.ReadOnly = .F.
			ThisForm.pf.pg_Edit.edtComments.ReadOnly = .F.
			ThisForm.pf.pg_Edit.txtHeat.ReadOnly = .F.
			ThisForm.pf.pg_Edit.txtLot.ReadOnly = .F.
			ThisForm.pf.pg_Edit.txtInit.ReadOnly = .F.
			ThisForm.pf.pg_Edit.txtDate.ReadOnly = .F.
			ThisForm.pf.pg_Edit.txtActualW.ReadOnly = .F	&&Problem with With/EndWith
			ThisForm.pf.pg_Edit.txtBillW.ReadOnly = .F.
		
			ThisForm.pf.pg_Edit.txtPieces.ReadOnly = .F.
			ThisForm.pf.pg_Edit.txtRejectReason.ReadOnly = .F.
			ThisForm.pf.pg_Edit.txtRejectPC.ReadOnly = .F.
		
			ThisForm.pf.pg_Edit.chkPass.Enabled = .T.
			ThisForm.pf.pg_Edit.chkCert.Enabled = .T.
		ELSE
			*Save
			PRIVATE nReceiveID
			nReceiveID = Receiving.ID
			
			IF nReceiveID > 0
				PRIVATE dReceived, cHeat, cLot, lCert, cDescription, cPOitem
				PRIVATE cSpecs, cComments, cInit, dDate, lPass, lGoodPapers, nActualW, nBillW
				PRIVATE nPieces, cVendor, nRejectPC, cRejectReason
				dReceived	= PrepareSQLdate(ThisForm.pf.pg_Edit.txtReceived.Value,'Received',.F.,.T.)
				cHeat		= PrepareSQLtxt(ThisForm.pf.pg_Edit.txtHeat.Value,'Heat',50)
				cLot		= PrepareSQLtxt(ThisForm.pf.pg_Edit.txtLot.Value,'Lot',10)
				lCert		= PrepareSQLchk(ThisForm.pf.pg_Edit.chkCert.Value,'Cert')
				cDescription= PrepareSQLtxt(ThisForm.pf.pg_Edit.edtDescription.Value,'Description',-1)
				cSpecs		= PrepareSQLtxt(ThisForm.pf.pg_Edit.edtSpecs.Value,'Specs',-1)
				cComments	= PrepareSQLtxt(ThisForm.pf.pg_Edit.edtComments.Value,'Comments',-1)
				cInit		= PrepareSQLtxt(ThisForm.pf.pg_Edit.txtInit.Value,'Init',10)
				dDate		= PrepareSQLdate(ThisForm.pf.pg_Edit.txtDate.Value,'Date',.F.,.T.)
				lPass		= PrepareSQLchk(ThisForm.pf.pg_Edit.chkPass.Value,'Pass')
				lGoodPapers	= PrepareSQLchk(ThisForm.pf.pg_Edit.chkGoodPapers.Value,'GoodPapers')
				nActualW	= PrepareSQLnum(ThisForm.pf.pg_Edit.txtActualW.Value,'ActualW',9,1)
				nBillW		= PrepareSQLnum(ThisForm.pf.pg_Edit.txtBillW.Value,'BillW',9,1)
				nPieces		= PrepareSQLnum(ThisForm.pf.pg_Edit.txtPieces.Value,'Pieces',-3)
				cVendor		= PrepareSQLtxt(ThisForm.pf.pg_Edit.txtVendor.Value,'Vendor',30)
				nRejectPC	= PrepareSQLnum(ThisForm.pf.pg_Edit.txtRejectPC.Value,'RejectPC',-3)
				cRejectReason= PrepareSQLtxt(ThisForm.pf.pg_Edit.txtRejectReason.Value,'RejectReason',255)
				
				IF nRejectPC < 1
					nRejectPC = 0
				ENDIF
				
				*Update 
				cSQLu = "UPDATE dbo.Receiving SET"
				cSQLu = cSQLu +" Received='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"
				*cSQLu = cSQLu +",POitem=dbo.f_ProperPOitem('"+cPOitem+"')"
				*cSQLu = cSQLu +",SOitem=dbo.ProperSO('"+cSOitem+"')"
				*cSQLu = cSQLu +",Alloy='"+cAlloy+"'"
				cSQLu = cSQLu +",Heat='"+cHeat+"'"
				cSQLu = cSQLu +",Lot='"+cLot+"'"
				cSQLu = cSQLu +",Cert="+IIF(lCert,'1','0')+""	&&BIT
				cSQLu = cSQLu +",Pieces="+STR(nPieces)
				cSQLu = cSQLu +",Description='"+cDescription+"'"
				cSQLu = cSQLu +",Specs='"+cSpecs+"'"
				cSQLu = cSQLu +",Comments='"+cComments+"'"
				cSQLu = cSQLu +",Init='"+cInit+"'"
				cSQLu = cSQLu +",[Date]='"+IIF(EMPTY(dDate),'',DTOC(dDate))+"'"
				cSQLu = cSQLu +",Pass="+IIF(lPass,'1','0')
				cSQLu = cSQLu +",GoodPapers="+IIF(lGoodPapers,'1','0')
				cSQLu = cSQLu +",ActualW="+STR(nActualW)
				cSQLu = cSQLu +",BillW="+STR(nBillW)
				cSQLu = cSQLu +",Vendor='"+cVendor+"'"
				cSQLu = cSQLu +",RejectPC="+STR(nRejectPC)
				cSQLu = cSQLu +",RejectReason='"+cRejectReason+"'"
				cSQLu = cSQLu +" WHERE ID = "+STR(nReceiveID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
				ELSE
					WAIT WINDOW "Saved, Close screen to refresh" TIMEOUT 2
				ENDIF
			ELSE
				MESSAGEBOX("Could not Find ID",0,"Could not Save")
			ENDIF
		
		
			ThisForm.pf.pg_Edit.txtReceived.ReadOnly = .T.
			ThisForm.pf.pg_Edit.txtVendor.ReadOnly = .T.
			ThisForm.pf.pg_Edit.edtDescription.ReadOnly = .T.
			ThisForm.pf.pg_Edit.edtSpecs.ReadOnly = .T.
			ThisForm.pf.pg_Edit.edtComments.ReadOnly = .T.
			ThisForm.pf.pg_Edit.txtHeat.ReadOnly = .T.
			ThisForm.pf.pg_Edit.txtLot.ReadOnly = .T.
			ThisForm.pf.pg_Edit.txtInit.ReadOnly = .T.
			ThisForm.pf.pg_Edit.txtDate.ReadOnly = .T.
			ThisForm.pf.pg_Edit.txtActualW.ReadOnly = .T.	
			ThisForm.pf.pg_Edit.txtBillW.ReadOnly = .T.
			ThisForm.pf.pg_Edit.txtPieces.ReadOnly = .T.
			ThisForm.pf.pg_Edit.txtRejectReason.ReadOnly = .T.
			ThisForm.pf.pg_Edit.txtRejectPC.ReadOnly = .T.
			
			ThisForm.pf.pg_Edit.chkPass.Enabled = .F.
			ThisForm.pf.pg_Edit.chkCert.Enabled = .F.
		ENDIF
		
	ENDPROC

