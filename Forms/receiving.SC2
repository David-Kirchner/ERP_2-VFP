	PROCEDURE pf.pgFind.cmbFind.Valid
		PRIVATE IntcmbFind
		IntcmbFind = INT(This.Value)
		DO CASE
		CASE IntcmbFind = 1
			*HPAPO n,9
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"999999999"
		CASE IntcmbFind = 2
			*Salesnum n,7
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"9999999"
		CASE IntcmbFind = 3
			*Vendor c,30
			m.FindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 4
			*Heat c,30
			m.FindText = SPACE(30)
			This.Parent.txtFindText.InputMask =	"XXXXXXXXXXXXXXXXXXXXXXXXXXX"
		CASE IntcmbFind = 5
			*ID_Master INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"99999999999"
		CASE IntcmbFind = 6
			*ReceiveID INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"99999999999" 
		CASE IntcmbFind = 7
			*WO_Detail INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"99999999999" 
		CASE IntcmbFind = 8
			*RMA_NO INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"99999999999" 
		CASE IntcmbFind = 9
			*RMA_Detail INT
			m.FindText = 0
			This.Parent.txtFindText.InputMask =	"99999999999" 
		ENDCASE
		
		This.Parent.txtFindText.Refresh
		*This.Parent.txtFindText.SetFocus
	ENDPROC

	PROCEDURE pf.pgFind.cmdFindcmbText.Valid
		PRIVATE IntcmbFind,ncomp
		PRIVATE laText2Find, lcText2Find, lnText2Find  &&replace m.FindText
		
		PRIVATE nDec
		nDec = SET("DECIMAL")
		SET DECIMAL TO 0
		
		lcText2Find = ""
		lnText2Find = 0
		laText2Find = This.Parent.txtFindText.Value
		IF TYPE('laText2Find') = "N"
			lnText2Find = laText2Find
			lcText2Find = ALLTRIM(STR(laText2Find))
		ENDIF
		IF TYPE('laText2Find') = "C"
			lcText2Find = ALLTRIM(laText2Find)
			lnText2Find = VAL(laText2Find)
		ENDIF
		SET DECIMAL TO nDec
		
		IntcmbFind = This.Parent.cmbFind.Value
		*Purchase Order,Sales Order,Customer,SalesOrder-Item
		*SET EXACT OFF
		SELECT Receiving
		DO CASE
		CASE IntcmbFind = 1
			*PO 
			SELECT COUNT(*) FROM Receiving WHERE Proper_PO_item_PO(PoItem) = lnText2Find INTO ARRAY anFound
			
			IF anFound(1) > 0
				BROW for Proper_PO_item_PO(PoItem) = lnText2Find TITLE "Click X to close this find window." NOEDIT NOAPPEND
			ELSE
				IF Count_HPAPOinPurchaseOrder( lnText2Find, ThisForm.nConnHandle ) = 0
					MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" has not been entered!"+CHR(13)+"Have this PO added in PurchaseOrder screen",0+16,"PO Not Found, Stop receiving and enter PO first!")
				ELSE
					IF Count_HPAPOinStockLst( lnText2Find, ThisForm.nConnHandle ) = 0
						MESSAGEBOX("Po ="+ALLTRIM(STR(lnText2Find))+" was not found in StockLst or BrokerLst list."+CHR(13)+"Have this PO edited in PurchaseOrder screen"+CHR(13)+"so ALL PO related tables are updated!",0+16,"PO Not Found, Stop receiving and enter PO first!")
					ELSE
						MESSAGEBOX(	"Po ="+ALLTRIM(STR(lnText2Find))+" was not found."+CHR(13)+CHR(13)+"But was found in PurchaseOrder and StockLst/BrokerLst!.",0+64,"Not found in Receiving.")
					ENDIF
				ENDIF
			ENDIF
		CASE IntcmbFind = 2
			SELECT COUNT(*) FROM Receiving WHERE Proper_SO_item_SO(SoItem) = lnText2Find INTO ARRAY anFound
			IF anFound(1) > 0
				*SalesNum n,7
				BROWSE for Proper_SO_item_SO(SoItem) = lnText2Find TITLE "Click X to close this find window." NOEDIT NOAPPEND
			ELSE
				MESSAGEBOX("SalesNum ="+ALLTRIM(STR(lnText2Find)),0,"Not Found")
			ENDIF	
		CASE IntcmbFind = 3
			*Vendor c,30
			COUNT TO ncomp for UPPER(Vendor) = UPPER(lcText2Find)
			IF ncomp > 0
				BROW for UPPER(Vendor) = UPPER(lcText2Find) TITLE "Click X to close this find window." NOEDIT NOAPPEND
			ELSE
				COUNT TO ncomp for LEFT(UPPER(Vendor),4) = LEFT(UPPER(lcText2Find ),4)
				IF ncomp > 0
					BROW for LEFT(UPPER(Vendor),4) = LEFT(UPPER(lcText2Find ),4) TITLE "Click X to close. Matched first 4 letters." NOEDIT NOAPPEND
				ELSE
					COUNT TO ncomp for LEFT(UPPER(Vendor),2) = LEFT(UPPER(lcText2Find ),2)
					IF ncomp > 0
						BROW for LEFT(UPPER(Vendor),2) = LEFT(UPPER(lcText2Find ),2) TITLE "Click X to close. Matched first 2 letters." NOEDIT NOAPPEND
					ELSE
						BROW for LEFT(UPPER(Vendor),1) = LEFT(UPPER(lcText2Find ),1) TITLE "Click X to close. Matched first 1 letter only." NOEDIT NOAPPEND
					ENDIF
				ENDIF
			ENDIF
		CASE IntcmbFind = 4
			*Heat c,30
			COUNT TO ncomp for UPPER(Heat) = UPPER(lcText2Find)
			IF ncomp > 0
				BROW for UPPER(Heat) = UPPER(lcText2Find) TITLE "Click X to close this find window." NOEDIT NOAPPEND
			ELSE
				COUNT TO ncomp for LEFT(UPPER(Heat),15) = LEFT(UPPER(lcText2Find ),15)
				IF ncomp > 0
					BROW for LEFT(UPPER(Heat),8) = LEFT(UPPER(lcText2Find ),8) TITLE "Click X to close. Matched first 4 letters." NOEDIT NOAPPEND
				ELSE
					COUNT TO ncomp for LEFT(UPPER(Heat),6) = LEFT(UPPER(lcText2Find ),6)
					IF ncomp > 0
						BROW for LEFT(UPPER(Heat),4) = LEFT(UPPER(lcText2Find ),4) TITLE "Click X to close. Matched first 2 letters." NOEDIT NOAPPEND
					ELSE
						BROW for LEFT(UPPER(Heat),2) = LEFT(UPPER(lcText2Find ),2) TITLE "Click X to close. Matched first 1 letter only." NOEDIT NOAPPEND
					ENDIF
				ENDIF
			ENDIF
		CASE IntcmbFind = 5
			*ID_Master INT
			SET ORDER TO TAG ID_Master
			SEEK lnText2Find IN 'Receiving' ORDER ID_Master
		CASE IntcmbFind = 6
			*ReceiveID INT
			SET ORDER TO TAG rID 
			SEEK lnText2Find IN 'Receiving' ORDER rID 
		CASE IntcmbFind = 7
			*WO_Detail INT
			SET ORDER TO TAG WO_Detail
			SEEK lnText2Find IN 'Receiving' ORDER WO_Detail
		CASE IntcmbFind = 8
			*RMA_NO INT
			SET ORDER TO TAG RMA_NO
			SEEK lnText2Find IN 'Receiving' ORDER RMA_NO
		CASE IntcmbFind = 9
			*RMA_Detail INT
			SET ORDER TO TAG RMA_Detail
			SEEK lnText2Find IN 'Receiving' ORDER RMA_Detail	
		CASE IntcmbFind = 10
			*WO_Detail INT
			SET ORDER TO TAG WO
			SEEK lnText2Find IN 'Receiving' ORDER WO
		
		ENDCASE
		*SET EXACT ON
	ENDPROC

