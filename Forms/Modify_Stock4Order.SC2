	ENDPROC

	PROCEDURE txtS_P.GotFocus
		This.InputMask = "999999999.9999"
	ENDPROC

	PROCEDURE txtS_P.LostFocus
		This.InputMask = "999,999,999.9999"
	ENDPROC

	PROCEDURE txtS_QTY.GotFocus
		ThisForm.nQTY = PrepareSQLnum(This.Value,'QTY',-5)
	ENDPROC

	PROCEDURE txtS_QTY.Valid
		PRIVATE nQTY
		nQTY = PrepareSQLnum(This.Value,'QTY',-5)
		
		IF nQTY > 0
			*ThisForm.Calc_StockDetail_1()   &&Do not reCalculate, overwriting the users input!
			ThisForm.EnterS_QTY = .T.
			
			PRIVATE cMess
			cMess = "QTY changed to "+ALLTRIM(STR(nQTY,18,4))
			*cMess = cMess + " SOitem:"+PrepareSQLtxt(ThisForm.cSOitem,'SOitem',10)
			
			IF nQTY <> ThisForm.nQTY 
				ThisForm.TrackUserEdit(cMess)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtWeight1.GotFocus
		ThisForm.nWeight = PrepareSQLnum(This.Value,'Weight',-5)
	ENDPROC

	PROCEDURE txtWeight1.Valid
		PRIVATE nWeight
		nWeight = PrepareSQLnum(This.Value,'Weight',-5)
		
		IF nWeight <> ThisForm.nWeight 
			IF nWeight > 0
				ThisForm.EnterWeight1 = .T.
				
				*ThisForm.Calc_StockDetail_1()  &&Do not Calculate and overwriting the users input!
				PRIVATE cMess
				cMess = "Weight changed to "+ALLTRIM(STR(nWeight,7,1))
				
				
				ThisForm.TrackUserEdit(cMess)
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE txtWeight2.Valid
		PRIVATE nSub, nCurr, nCalc
		nSub = This.Value
		IF VARTYPE(nSub)="C"
			nSub = VAL(nSUB)
		ENDIF
		
		nCurr = ThisForm.txtWeight1.Value
		IF VARTYPE(nCurr)="C"
			nCurr= VAL(nCurr)
		ENDIF
		
		nCalc = 0
		
		IF (VARTYPE(nSub) = "N" OR VARTYPE(nSub) = "Y") AND ( VARTYPE(nCurr) = "N" OR VARTYPE(nCurr) = "Y")
			nCalc = nCurr - nSub
			This.Value = 0
			
			IF nCalc > 0	
				ThisForm.txtWeight1.Value = nCalc
				ThisForm.txtWeight1.Refresh
				
				ThisForm.Calc_StockDetail_1()
				WAIT WINDOW "Math: "+ALLTRIM(STR(nCurr,7,1))+" - "+ALLTRIM(STR(nSub,7,1))+" = "+ALLTRIM(STR(nCalc,7,1)) NOWAIT
				
				PRIVATE cMess
				cMess = "Pounds changed from "+ALLTRIM(STR(nCurr,7,1))+" to "+ALLTRIM(STR(nCalc,7,1))
				ThisForm.TrackUserEdit(cMess)
			
				IF GetPUfromForm(ThisForm.txtForm1.Value, ThisForm.nConnHandle) = 1	&&LB
					ThisForm.txtS_Qty.Value = ROUND(nCalc,1)
				ENDIF
			ELSE
				WAIT WINDOW "Not updated!" NOWAIT
			ENDIF
		ENDIF
		
		ThisForm.EnterWeight1 = .T.
	ENDPROC

	PROCEDURE txtWeight3.Valid
		IF PrepareSQLnum(This.Value,'Weight',-5) > 0
			*  &&Do not reCalculate, overwriting the users input!
			*ThisForm.Calc_StockDetail_3('QTY')
			
			ThisForm.EnterWeight3 = .T.
		ENDIF
	ENDPROC

ENDDEFINE
