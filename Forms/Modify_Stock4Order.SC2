		IF nSQLEXEC > 0
			**************************
			*Get the New ID_Detail (nNewWIP_ID_Detail) from nNewWIP_ID
			
			IF USED("tmpID_WIP_D")
				IF RECCOUNT("tmpID_WIP_D") = 0
					TrackError("Reccount=0, INSERT INTO dbo.WIPLst_Detail Copy_Stock_WIP() "+CHR(13)+CHR(13)+cSQL,"Reccount=0, dbo.WIPLst_Detail Copy_Stock_WIP()", PROGRAM(), LINENO(1))
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Reccount=0, INSERTed INTO dbo.WIPLst_Detail Copy_Stock_WIP() "+cSQL)
				ELSE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Reccount>0, INSERTed INTO dbo.WIPLst_Detail Copy_Stock_WIP() "+cSQL)	
				ENDIF 
				USE IN tmpID_WIP_D
			ENDIF
			
			SELECT 0
			
			PRIVATE cSQLid
			cSQLid = "SELECT ID_Detail FROM dbo.WIPLst_Detail "
			cSQLid = cSQLid + " WITH(NOLOCK) " &&could be in transaction lock
			cSQLid = cSQLid + " WHERE ID = "+STR(nNewWIP_ID)
			cSQLid = cSQLid + " AND WO = "+STR(nWO)
			cSQLid = cSQLid + " AND ReceivingID = "+STR(nRandNum) 
			  
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQLid, "tmpID_WIP_D")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQLid, "tmpID_WIP_D")
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP_D")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP_D")
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP_D")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP_D")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLid, ThisForm.nConnhandle, nSQLEXEC, "tmpID_WIP_D")
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), "nNewWIP_ID = "+STR(nNewWIP_ID)+CHR(13)+cSQLid )
				 
				lOK	= .F.
			ENDIF
			IF USED('tmpID_WIP_D')
				IF RECCOUNT('tmpID_WIP_D') > 0
					*lMultiReceive = .T.
					SCAN
						nNewWIP_ID_Detail = PrepareSQLnum(tmpID_WIP_D.ID_Detail,'ID_Detail',-3)
						IF nNewWIP_ID_Detail > 0
						
							cSQL = "INSERT INTO dbo.WIPLst_D_Ext "
							cSQL = cSQL + "( [WIP_M_ID]"
							cSQL = cSQL + ",[WIP_ID_Detail] "
							cSQL = cSQL + ",sTBL "
							cSQL = cSQL + ",[sID_Detail] "
							cSQL = cSQL + ",WO "
							cSQL = cSQL + " ) VALUES ( "
							cSQL = cSQL + ""+STR(nNewWIP_ID)+""
							cSQL = cSQL + ","+STR(nNewWIP_ID_Detail)+""
							cSQL = cSQL + ",'"+cTBL+"'"		
							cSQL = cSQL + ","+STR(nWO)+""
							cSQL = cSQL + " ) "
							
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "")
								RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL)
								*lOK	= .F.
							ENDIF
						ENDIF
									
					ENDSCAN
					*nID_FoundWIP = PrepareSQLnum(tmpID_WIP_D.ID,'ID',-3)
				
					**************************************
					*Track
					*TrackMess(cSQL+ CHR(13)+PROGRAM() )
					*TrackMess(cSQLid+ CHR(13)+PROGRAM() )
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQL) 
					*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQLid) 
				ENDIF
				USE IN tmpID_WIP_D
					
			ENDIF
		ENDIF
		
		IF lOK
			IF nNewWIP_ID_Detail > 0
				*Reset Tracking Data
				cSQL = "UPDATE dbo.WIPLst_Detail "
				cSQL = cSQL + " SET [ReceivingID] = 0 "
				*IF lMultiReceive 
					*cSQL = cSQL + " WHERE [ID_Detail] = "+STR(nNewWIP_ID_Detail)  		
				*ENDIF
				cSQL = cSQL + " WHERE [ID] = "+STR(nNewWIP_ID)
				cSQL = cSQL + " AND [ReceivingID] ="+STR(nRandNum)  &&Still have this ID
			 
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "")
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL)
					*lOK	= .F.
				ENDIF
				
			ELSE
				TrackError("nNewWIP_ID = "+STR(nNewWIP_ID)+CHR(13)+"Select for the new ID_Detail failed."+CHR(13)+CHR(13)+"Assume Could not INSERT INTO dbo.WIPLst_Detail"+CHR(13)+CHR(13)+cSQL,"WIP ID_Detail was 0",PROGRAM(),LINENO(1))
				lOK = .F.
			ENDIF
		
		ENDIF
		
		
		*********************************************************************
		*****************	
		
		PRIVATE dStartDate
		dStartDate	= DATE()
		PRIVATE nNewWIP_ID_D_Process  
		nNewWIP_ID_D_Process   = 0
		
		****************************
		*get WO data to make WIP Process
		IF lOK 
			IF nNewWIP_ID_Detail > 0
				PRIVATE cSOitem, cPO_item, cSalesPerson, dDueDate, cComment
				PRIVATE cProcess_ID, cProcessor, cAllowSub ,nPU, nQTY, nPounds
			    PRIVATE nReceivingID, nWO_Detail, cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
			    
			    cPO_item = ''
			    cPrc_Form	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
			    nPrc_PCs	= PrepareSQLnum(ThisForm.txtPc1.Value,'PC',-3)
			    nPrc_Dim1	= PrepareSQLnum(ThisForm.txtDim11.Value,'Dim1',10,4)
			    nPrc_Dim2	= PrepareSQLnum(ThisForm.txtDim21.Value,'DIM2',9,3)
			    nPrc_Dim3	= PrepareSQLnum(ThisForm.txtDim31.Value,'Dim3',9,3)
			    nPU = nPU_Acct_Form(cPrc_Form, ThisForm.nConnhandle)
			    
			    *get WO data to make WIP Process
			   	IF USED("tmpWO_Info")
					USE IN tmpWO_Info
				ENDIF
				SELECT 0
		
				cSQL = "SELECT WO.*, WOD.fSOitem, WOD.WO_Detail "
				cSQL = cSQL + " FROM dbo.WorkOrder WO "
				cSQL = cSQL + " WITH(NOLOCK) " &&could be in transaction lock
				cSQL = cSQL + " INNER JOIN dbo.WorkOrder_Detail WOD WITH(NOLOCK) ON WO.WO = WOD.WO "
				cSQL = cSQL + " WHERE WO.WO = "+STR(nWO)
				  
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpWO_Info")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpWO_Info")
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_Info")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_Info")
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_Info")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_Info")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpWO_Info")
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					lOK	= .F.
				ENDIF
				IF USED('tmpWO_Info')
					IF RECCOUNT('tmpWO_Info') > 0
						
						SCAN
							*Check for Different WO_Detail!!!
							nWO_Detail		= PrepareSQLnum(tmpWO_Info.WO_Detail,'WO_Detail',-3)
							*IF nWO_Detail does NOT already has an incoming process for Stock
							IF getID_D_P_Incoming( "WO_Detail", nWO_Detail, "S", ThisForm.nConnhandle) > 0
								cSOitem		= PrepareSQLtxt(tmpWO_Info.SOitem,'SOitem',10)
								cfSOitem	= PrepareSQLtxt(tmpWO_Info.fSOitem,'SOitem',10)
								cPOitem		= PrepareSQLtxt(tmpWO_Info.POitem,'POitem',12)
								cSalesPerson	= PrepareSQLtxt(tmpWO_Info.SalesRep,'SalesRep',20)
								IF LEN(cSalesPerson) = 0
									cSalesPerson = RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
								ENDIF
								dStartDate	= DATE()
								dDueDate	= PrepareSQLdate(tmpWO_Info.DueDate,'DueDate')
								cComment	= PrepareSQLtxt(tmpWO_Info.Descript,'Comment',100)
								cProcess_ID	= "SELECTED"
								
								*cProcessor	= PrepareSQLtxt(RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ),'Processor',20)
								cProcessor	= PrepareSQLtxt(SUBSTR(SYS(0),AT("#",SYS(0))+2),'Processor',20)
								
								cAllowSub	= "N"
								nPU 		= GetPUfromForm(tmpWO_Info.sForm, ThisForm.nConnhandle)
								nQTY		= PrepareSQLnum(tmpWO_Info.sWeight,'Weight',-5)
								nPounds		= PrepareSQLnum(tmpWO_Info.sWeight,'Weight',-5)
					    		*nReceivingID	= PrepareSQLnum(tmpWO_Info.sReceivingID,'ReceivingID',-3)
					    		nReceivingID	= nRandNum
					    		nWO_Detail		= PrepareSQLnum(tmpWO_Info.WO_Detail,'WO_Detail',-3)
					    		*nPrc_QTY		= PrepareSQLnum(tmpWO_Info.sWeight,'Weight',-5)
								cPrc_Form	= PrepareSQLtxt(tmpWO_Info.sForm,'Form',2)
								nPrc_PCs	= PrepareSQLnum(tmpWO_Info.sPieces,'Pieces',-3)
								*nPrc_Dim1	= 0
								nPrc_Dim2	= PrepareSQLnum(tmpWO_Info.sSz2,'Sz2',9,3)
								nPrc_Dim3	= PrepareSQLnum(tmpWO_Info.sSz3,'Sz3',9,3)
												
												
							     *dbo.WIPLst_Process SET SOitem = ' 130068-01' WHERE WO = 1567 AND WO_Detail = 1878
								cSQL = "INSERT INTO dbo.WIPLst_Process ("
								cSQL = cSQL + " SOitem"
								cSQL = cSQL + ",PO_item"
								cSQL = cSQL + ",SalesPerson"
								cSQL = cSQL + ",StartDate"
								cSQL = cSQL + ",DueDate"
								cSQL = cSQL + ",Comment"
								
								cSQL = cSQL + ",Process_ID"
								cSQL = cSQL + ",Processor"
								cSQL = cSQL + ",AllowSub"
								cSQL = cSQL + ",PU"
								cSQL = cSQL + ",QTY"
								cSQL = cSQL + ",Pounds"
								
								cSQL = cSQL + ",ID_Detail"
								cSQL = cSQL + ",ReceivingID"
								cSQL = cSQL + ",WO"
								cSQL = cSQL + ",WO_Detail"
		
								cSQL = cSQL + ",Prc_Form"
								cSQL = cSQL + ",Prc_PCs"
								cSQL = cSQL + ",Prc_Dim1"
								cSQL = cSQL + ",Prc_Dim2"
								cSQL = cSQL + ",Prc_Dim3"
								cSQL = cSQL + " ) VALUES ( "
								cSQL = cSQL + "''"	&& AS [SOitem] "
								cSQL = cSQL + ",''"	&& AS [PO_item] "
								cSQL = cSQL + ",'"+cSalesPerson+"'"	&& AS [SalesPerson] "
								cSQL = cSQL + ",'"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"	&& AS [StartDate] "
								cSQL = cSQL + ",'"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"	&& AS [DueDate] "
								cSQL = cSQL + ",'"+cComment+"'"	&& AS [Comment] "
								
								cSQL = cSQL + ",'SELECTED'"	&& AS [Process_ID] "
								cSQL = cSQL + ",'"+cProcessor+"'"	&& AS [Processor] "
								cSQL = cSQL + ",'N'"	&& AS [AllowSub] "
								cSQL = cSQL + ","+STR(nPU,2,0)+""	&& AS [PU] "
								cSQL = cSQL + ","+STR(nQTY,18,4)+""	&& AS [QTY] "
								cSQL = cSQL + ","+STR(nPounds,9,1)+""	&& AS [Pounds] "
		
								cSQL = cSQL + ","+STR(nNewWIP_ID_Detail)+""	&& AS [ID_Detail] "
								cSQL = cSQL + ","+STR(nRandNum)+""	&& AS [ReceivingID] "
								cSQL = cSQL + ","+STR(nWO)+""	&& AS WO "
								cSQL = cSQL + ","+STR(nWO_Detail)+""	&& AS [WO_Detail]"
		
								cSQL = cSQL + ",'"+cPrc_Form+"'"	&& AS [Prc_Form] "
								cSQL = cSQL + ","+STR(nPrc_PCs)+""	&& AS [Prc_PCs] "
								cSQL = cSQL + ","+STR(nPrc_Dim1,10,4)+" "	&& AS [Prc_Dim1] "
								cSQL = cSQL + ","+STR(nPrc_Dim2,9,3)+""	&& AS [Prc_Dim2] "
								cSQL = cSQL + ","+STR(nPrc_Dim3,9,3)+""	&& AS [Prc_Dim3] "
		
								cSQL = cSQL + " )"
							
								nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "")
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									ENDDO
								ENDIF
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "")
									RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
									lOK	= .F.
									**************************************
									*Track
									*TrackMess(cSQL + CHR(13)+PROGRAM() )
									RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not move to WIP list."+CHR(13)+cSQL)
								ELSE
									*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"moved to WIP list."+CHR(13)+cSQL)
									
								ENDIF
														
							ENDIF
		***********************************************************
							
							***************************
							*Get the new Process
		
							IF lOK
								
								*had already Reset Tracking Data in dbo.WIPLst_Detail SET [ReceivingID] = 0 "
								*Get the [ID_Detail_Process]
								
								IF USED("tmpID_WIP_DP")
									USE IN tmpID_WIP_DP
								ENDIF
								SELECT 0
								
								PRIVATE cSQLid
								cSQLid = "SELECT ID_Detail_Process FROM dbo.WIPLst_Process "
								cSQLid = cSQLid + " WITH(NOLOCK) " &&could be in transaction lock
								cSQLid = cSQLid + " WHERE ID_Detail = "+STR(nNewWIP_ID_Detail)
								*&&Could have mnore than 1 detail/Process
								cSQLid = cSQLid + " AND WO = "+STR(nWO)
								cSQLid = cSQLid + " AND [ReceivingID] ="+STR(nRandNum)
								 
								nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQLid, "tmpID_WIP_DP")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQLid, "tmpID_WIP_DP")
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP_DP")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP_DP")
									ENDDO
								ENDIF
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP_DP")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP_DP")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQLid, ThisForm.nConnhandle, nSQLEXEC, "tmpID_WIP_DP")
									RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), "nNewWIP_ID = "+STR(nNewWIP_ID)+CHR(13)+cSQLid )
									 
									lOK	= .F.
								ENDIF
								IF USED('tmpID_WIP_DP')
									IF RECCOUNT('tmpID_WIP_DP') > 0
										SCAN
											nNewWIP_ID_D_Process  = PrepareSQLnum(tmpID_WIP_DP.ID_Detail_Process,'ID_Detail_Process',-3)
										
											IF nNewWIP_ID_Detail > 0
												
												*Add a dbo.WIPLst_Process_Detail for link with dbo.Ar_WIPlst_Detail_History
												cSQL = "INSERT INTO dbo.WIPLst_Process_Detail "
												cSQL = cSQL + "( ID, ID_Detail, ID_Detail_Process, What, WO ) VALUES ("
												cSQL = cSQL + ""+STR(nNewWIP_ID)+""
												cSQL = cSQL + ","+STR(nNewWIP_ID_Detail)+""
												cSQL = cSQL + ","+STR(nNewWIP_ID_D_Process)+""
												cSQL = cSQL + ","+STR(nWO)+""
												cSQL = cSQL + ",'WO to WIP'"+")"
																
												nSQLEXEC = SQLEXEC( ThisForm.nConnhandle, cSQL )
												DO WHILE nSQLEXEC = 0
													WAIT WINDOW 'SQL' TIMEOUT 1
													nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL )
												ENDDO
												IF nSQLEXEC < 0 &&Try again!
													nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
													DO WHILE nSQLEXEC = 0
														WAIT WINDOW 'SQL 2' TIMEOUT 1
														nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
													ENDDO
												ENDIF
												IF nSQLEXEC < 0 &&Try again!
													nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
													DO WHILE nSQLEXEC = 0
														WAIT WINDOW 'SQL 2' TIMEOUT 1
														nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
														
														IF nSQLEXEC < 0
															IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
																nSQLEXEC = 0
															ENDIF
														ENDIF
													ENDDO
												ENDIF 	
											ENDIF
										ENDSCAN
									
										**************************************
										*Track
										*TrackMess(cSQL+ CHR(13)+PROGRAM() )
										*TrackMess(cSQLid+ CHR(13)+PROGRAM() )
										*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQL) 
										*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQLid) 
									ELSE 
										RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not INSERT to WIPLst_Process_Detail ."+CHR(13)+cSQLid)
									ENDIF
									USE IN tmpID_WIP_DP
								ELSE
									RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not INSERT to WIPLst_Process_Detail."+CHR(13)+cSQLid)
								ENDIF
							ENDIF	
		
		****************************
						ENDSCAN
					ENDIF
					USE IN tmpWO_Info
				ENDIF
		
				WAIT WINDOW "Successfully copied to the WIP tables." NOWAIT
				
			ELSE
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not move to WIP list.")
				*TrackError("Could not INSERT INTO dbo.WIPLst_Process"+CHR(13)+cSQL,"ID_Detail was 0",PROGRAM(),LINENO(1))
			ENDIF
		ENDIF
			
		*Do the Regulare stock DELETE after this Copy_Stock_WP().
		*	IF NOT Remove_Lst_Detail_by_ID_Detail(cTBL,nID_Detail, ThisForm.nConnHandle, 'Copy_Stock_WIP', 'WO '+ALLTRIM(STR(nWO)) )
		
		*******************************************************************
		************************************************************************************
		*******************************************************************
		
		
		IF lOK
			***********
			*Update WO StkConsumed = 1
		
		
			IF USED("updateWO")
				USE IN updateWO
			ENDIF
			SELECT 0
		
			cSQL = "UPDATE dbo.WorkOrder"
			cSQL = cSQL + " SET StkConsumed = 1 "
			cSQL = cSQL + " ,lPrc_Stock = 1 "
			cSQL = cSQL + " ,Cmplt = 1 "
			cSQL = cSQL + " WHERE WO="+STR(ThisForm.nWO)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "updateWO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "updateWO")
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "updateWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "updateWO")
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "updateWO")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "updateWO")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "updateWO")
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
		ENDIF
		
		IF lOK
			* P3 — GrabLb + CONSUME ledger row
			IF NOT "PROC_WO" $ UPPER(SET("PROCEDURE"))
				SET PROCEDURE TO PROGS\proc_wo ADDITIVE
			ENDIF
			PRIVATE nGrabLb, cGrabHeat, cGrabLot, nWOD
			nGrabLb = 0
			IF USED("tmpStkSum") AND RECCOUNT("tmpStkSum") > 0
				SELECT tmpStkSum
				CALCULATE SUM(Weight) TO nGrabLb
			ENDIF
			IF nGrabLb = 0
				nGrabLb = PrepareSQLnum(ThisForm.txtWeight3.Value,'Weight',9,1)
			ENDIF
			cGrabHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
			cGrabLot = PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
			nWOD = PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3)
			= WO_SetGrab(ThisForm.nWO, nGrabLb, cGrabHeat, cGrabLot, cTBL, nID_Detail, ThisForm.nConnHandle)
			IF nWOD > 0
				= WO_Ledger_Add(ThisForm.nWO, nWOD, "CONSUME", nGrabLb, nGrabLb, cGrabLot, "", ;
					"", 0, 0, "", 0, nNewWIP_ID_Detail, "Consume to WIP", ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		IF lOK
		*!*		*Show the WIP
		*!*		PRIVATE cHeat, cLot
		*!*		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		*!*		cLot	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10)
		*!*		
		*!*		*DO FORM "forms\Recv_Stock.scx" WITH pPOitem, pTableName, pnReceivingID, pnRMA_Detail, pnID_Detail      , pHeat, pLot, pnID_Master, pnWO_Detail
		*!*		DO FORM "forms\Recv_Stock.scx" WITH ''		, 'W'       ,           nWO,            0, nNewWIP_ID_Detail, cHeat, cLot,  nNewWIP_ID, 0
		*!*		
		ENDIF
		
		RETURN nNewWIP_ID_Detail
		
		
	ENDPROC

	PROCEDURE create_aconsumeqty
		PARAMETERS pWhat
		*ThisForm.Create_aConsumeQTY(pWhat) -- Get Process QTY
		
		*WAS ThisForm.ConsumeQTY(pWhat)
		*NOT ThisForm.ConsumeStock(lScrap)
		*fill array aConsumeQTY(14) only 13 used
		
		pWhat = PrepareSQLtxt(pWhat,'What',10)
		
		PRIVATE nDetail_PC, nDetail_Weight, nDetail_QTY
		nDetail_PC	= 0
		nDetail_Weight = 0
		nDetail_QTY = 0
		PRIVATE nQTYLeft, nWeightLeft, nPCLeft
		nQTYLeft = 0
		nWeightLeft = 0
		nPCLeft = 0
		PRIVATE nProcessPCs, nProcessPU, nProcessQTY, nProcessPounds
		nProcessPCs = 0
		nProcessPU = 0
		nProcessQTY = 0
		nProcessPounds = 0
		PRIVATE cProcessForm, nProcessDim2, nProcessDim3
		cProcessForm	= ''
		nProcessDim1	= 0
		nProcessDim2	= 0
		nProcessDim3	= 0
		
		PRIVATE lAllowSub
		lAllowSub = .F.
		
		PRIVATE cTbl
		cTbl = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		
		PRIVATE nID, nID_Detail, nID_Detail_Process
		nID					= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail			= PrepareSQLnum(THISFORM.txtID_Detail.VALUE,'ID_Detail',-3,0)
		nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3,0)
		
		PRIVATE cSOitem, nWO, nWO_Detail, cUserEdit
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		*WAIT WINDOW cSOitem NOWAIT
		cSOitem	= Proper_SO_Item(cSOItem)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3)
		cUserEdit	= PrepareSQLtxt(ThisForm.edtUserEdit.Value,'UserEdit',-1)
		
		PRIVATE lRandLen
		lRandLen = PrepareSQLlogic(ThisForm.chkRandLen.Value,'RandLen')
		
		IF nID = 0
			TrackError("No ID "+STR(13)+"pWhat= "+pWhat,"No ID",PROGRAM(),LINENO(0))
			RETURN .F.
		ENDIF
		IF nID_Detail = 0
			TrackError("No ID_Detail "+STR(13)+"pWhat= "+pWhat,"No ID_Detail",PROGRAM(),LINENO(0))
			RETURN .F.
		ENDIF
		IF nID_Detail_Process = 0
			TrackError("No ID_Detail_Process "+STR(13)+"pWhat= "+pWhat,"No ID_Detail_Process",PROGRAM(),LINENO(0))
			RETURN .F.
		ENDIF
		
		**********************************
		*Get Thck with SOitem  
		PRIVATE nCurrDim1, nSOiDim1
		nCurrDim1 = PrepareSQLnum(ThisForm.txtDim11.Value,'Dim1',10,4)
		nSOiDim1 = 0
			
		IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
			*Does Dim1 match?
		
			IF USED('tmpSO_Dim1')
				USE IN tmpSO_Dim1
			ENDIF
			SELECT 0
			cSQL = "SELECT Thck FROM dbo.AllQuotes WITH(NOLOCK) WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Dim1' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Dim1' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Dim1' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Dim1' )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_Dim1")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_Dim1")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpSO_Dim1')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
			ELSE 
				IF USED('tmpSO_Dim1')
					IF RECCOUNT('tmpSO_Dim1') > 0
						nSOiDim1 = tmpSO_Dim1.Thck
					ENDIF
				 	USE IN tmpSO_Dim1
				ENDIF
			ENDIF
			
		ENDIF
		
		****************************************************************
		*Get Process QTY, Weight and P QTY   *Read in data of Process
		*compare to consumed QTY and Weight.
		
		PRIVATE cSQL
		cSQL="SELECT AllowSub,PU,QTY,Pounds,Ordered_QTY"
		cSQL=cSQL+",Prc_Form,Prc_PCs,Prc_Dim1,Prc_Dim2,Prc_Dim3 " && use this new data ???
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process "
		ENDCASE
		cSQL=cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		cSQL=cSQL + " AND ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))  &&belts and suspenders
		
		IF USED("tmpProcessWeight")
			USE IN tmpProcessWeight
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessWeight')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessWeight')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessWeight' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessWeight' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessWeight")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessWeight")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpProcessWeight')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpProcessWeight')
				IF RECCOUNT('tmpProcessWeight')>0
					lAllowSub		= PrepareSQLLogic(tmpProcessWeight.AllowSub,'AllowSub',.F.)
					nProcessPU		= PrepareSQLnum(tmpProcessWeight.PU,'PU',-1)
					nProcessQTY		= PrepareSQLnum(tmpProcessWeight.QTY,'QTY',-5)
					nOrdered_QTY	= PrepareSQLnum(tmpProcessWeight.Ordered_QTY,'QTY',-5)
					nProcessPounds	= PrepareSQLnum(tmpProcessWeight.Pounds,'Pounds',7,1)
					cProcessForm	= PrepareSQLtxt(tmpProcessWeight.Prc_Form,'Form',2)
					nProcessPCs		= PrepareSQLnum(tmpProcessWeight.Prc_PCs,'PCs',-3)
					nProcessDim1	= PrepareSQLnum(tmpProcessWeight.Prc_Dim1,'Dim1',10,4)
					nProcessDim2	= PrepareSQLnum(tmpProcessWeight.Prc_Dim2,'Dim2',9,3)
					nProcessDim3	= PrepareSQLnum(tmpProcessWeight.Prc_Dim3,'Dim3',9,3)
					
					IF nProcessDim1 = 0
						nProcessDim1 = nSOiDim1 
					ENDIF
					IF nProcessPU = 0 AND LEN(cProcessForm)>1
						nProcessPU = GetPUfromForm(cProcessForm,ThisForm.nConnHandle)
					ENDIF
					
				ENDIF
				USE IN tmpProcessWeight
			ENDIF
		ENDIF
		
		****************************************************************
		*Get Remove Stock Summ totals
		*compare to consumed QTY and PC.
		SELECT tmpStkSum
		SET TALK OFF
		
		PRIVATE nRemove_PC_Total, nRemove_LBS_Total, nRemove_QTY_Total
		SUM PCs		TO nRemove_PC_Total
		SUM Weight	TO nRemove_LBS_Total
		SUM QTY		TO nRemove_QTY_Total  &&nRemove_QTY_Total 	= aConsumeQTY(7)
		
		nRemove_PC_Total	= PrepareSQLnum(nRemove_PC_Total,'PC',-3)
		nRemove_LBS_Total	= PrepareSQLnum(nRemove_LBS_Total,'Pounds',8,1)
		nRemove_QTY_Total	= PrepareSQLnum(nRemove_QTY_Total,'QTY',18,4)
		
		***************************************************************
		PRIVATE nCurRec, nRecNo3
		nCurRec = RECNO('tmpStkSum')
		nRecNo3	= PrepareSQLnum(ThisForm.txtRecNo3.Value,'RecNo',-3)
		
		IF nCurRec <> nRecNo3
			IF nRecNo3 > 0 
				IF nRecNo3 <= RECCOUNT('tmpStkSum')
					GOTO nRecNo3 
				ENDIF
			ENDIF
		ENDIF
		
		***************************************************************
		*PriceUnit 1=$/#, 2= $/FT, 3= $/PC
		IF nProcessPCs = 0
			*Just assume 1pc with many pounds
			nProcessPCs = 1
		ENDIF
		
		
		***
		*The Orig number are Displayed as txtPc, txtQTY and txtWeight
		PRIVATE nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3, nD_QTY, nDWeight
		nDPieces= PrepareSQLnum(ThisForm.txtPC1.Value,'Pieces',-3)
		cDAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cDForm	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		nDSize1	= PrepareSQLnum(ThisForm.txtDim11.Value,'DIM11',10,4)
		nDSize2	= PrepareSQLnum(ThisForm.txtDim21.Value,'DIM21',9,3)
		nDSize3	= PrepareSQLnum(ThisForm.txtDim31.Value,'DIM31',9,3)
		nD_QTY  = PrepareSQLnum(ThisForm.txtS_QTY.Value,'QTY',-5)
		nDWeight= PrepareSQLnum(ThisForm.txtWeight1.Value,'Weight',9,1)
		*
		IF nDWeight > 0
			nDetail_Weight  = nDWeight 
		ELSE
			IF EMPTY(nDetail_Weight)
				nDetail_Weight = GetWeight(nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3, ThisForm.nConnHandle)
			ENDIF
		ENDIF
		*
		IF nD_QTY > 0
			nDetail_QTY = nD_QTY 
		ELSE
			IF EMPTY(nDetail_QTY)
				nDetail_QTY = GetUnitQty(nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3, ThisForm.nConnHandle)
			ENDIF
		ENDIF
		*
		IF nDPieces > 0
			nDetail_PC = nDPieces
		ELSE
			IF PrepareSQLnum(ThisForm.txtPC.Value,'Pieces',-3) > 0
				nDetail_PC = PrepareSQLnum(ThisForm.txtPC.Value,'Pieces',-3) 
			ELSE
				nDetail_PC = 1
			ENDIF
		ENDIF
		
		***
		*check QTY and Pounds are good Calculated Vs Detail stored.	
		PRIVATE nCalc_LBS, nCalc_QTY, nMess
		nCalc_LBS = GetWeight(nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3, ThisForm.nConnHandle)
		nCalc_QTY = GetUnitQty(nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3, ThisForm.nConnHandle)
		
		PRIVATE cDDescript, cMess, nMess
		cDDescript = DescriptionMetricReport(nDPieces, cDForm, nDSize1, nDSize2, nDSize3, nDetail_Weight,.F.,.F.,'','','',ThisForm.nConnHandle )
		cMess = ''
		nMess = 0
		
		IF (nDetail_QTY+10)*.8 > (nCalc_QTY+10) OR (nDetail_QTY+10) < (nCalc_QTY+10)*.8
			cMess = "Detail QTY is : "+ALLTRIM(STR(nDetail_QTY))+" "+CHR(13)+" and Calculeted QTY is : "+ALLTRIM(STR(nCalc_QTY))+" "+CHR(13)
			cMess = cMess + cDDescript+" "+CHR(13)
			
			IF lRandLen
				cMess = cMess + "Item has Random Length checked! "+CHR(13)
			ELSE
				IF UPPER(pWhat) = "CONSUME"
					cMess = cMess +"Continue with Consume?"
				ELSE
					cMess = cMess +"Continue with Edit?"
				ENDIF
			ENDIF
				
			nMess = MESSAGEBOX(cMess,4+32,"Continue with Edit?") 
			IF nMess = 6
				*fix
			ENDIF
			RecordTest('Record Test Data.',PROGRAM(), LINENO(1), cMess +" "+CHR(13)+"Answered with "+STR(nMess,1))
		ENDIF
		
		IF (nDetail_Weight+10)*.8 > (nCalc_LBS+10) OR (nDetail_Weight+10) < (nCalc_LBS+10)*.8 AND nMess = 0
			
			IF nProcessPCs = 1
				cMess = "Detail LBS is : "+ALLTRIM(STR(nDetail_Weight))+" "+CHR(13)+" and Calculeted LBS is : "+ALLTRIM(STR(nCalc_LBS))+" "+CHR(13)
				cMess = cMess + cDDescript+" "+CHR(13)
				
				IF lRandLen
					cMess = cMess + "Item has Random Length checked! "+CHR(13)
				ELSE
					IF UPPER(pWhat) = "CONSUME"
						cMess = cMess +"Continue with Consume?"
					ELSE
						cMess = cMess +"Continue with Edit?"
					ENDIF
				ENDIF
				
				nMess = MESSAGEBOX(cMess,4+32,"Continue Edit?") 
				IF nMess = 6
					*fix
				ENDIF
				RecordTest('Record Test Data.', PROGRAM(), LINENO(1), cMess +" "+CHR(13)+"Answered with "+STR(nMess,1))
			ENDIF
		ENDIF
		
		***
		
		IF UPPER(pWhat) = "CONSUME"
			nQTYLeft	= 0
			nWeightLeft	= 0
			nPCLeft  	= 0
		ELSE
			IF nRemove_QTY_Total > 0
				nQTYLeft = nDetail_QTY - nRemove_QTY_Total
			ELSE
				nQTYLeft = nDetail_QTY - nProcessQTY 
			ENDIF
			IF nQTYLeft < 1
				nQTYLeft = 1
			ENDIF
			***
			IF nRemove_LBS_Total > 0
				nWeightLeft	= nDetail_Weight - nRemove_LBS_Total
			ELSE
				nWeightLeft	= nDetail_Weight - nProcessPounds 
			ENDIF
			IF nWeightLeft < 1
				nWeightLeft = 1
			ENDIF
			***
			IF nRemove_PC_Total > 0
				nPCLeft = nDetail_PC - nRemove_PC_Total
			ELSE
				nPCLeft = nDetail_PC - nProcessPCs
			ENDIF
			IF nPCLeft < 1
				nPCLeft = 1
			ENDIF
			***
		ENDIF
		
		***********************************
		IF VARTYPE(aConsumeQTY) = "U"
			PUBLIC ARRAY aConsumeQTY(14)
		ENDIF
		
		aConsumeQTY(1) = nQTYLeft
		aConsumeQTY(2) = nWeightLeft
		aConsumeQTY(3) = nPCLeft  
		
		aConsumeQTY(4) = nDetail_QTY 
		aConsumeQTY(5) = nDetail_Weight
		aConsumeQTY(6) = nDetail_PC
		
		aConsumeQTY(7) = nRemove_QTY_Total
		aConsumeQTY(8) = nRemove_PC_Total
		aConsumeQTY(9) = nRemove_LBS_Total
		
		aConsumeQTY(10) = nProcessQTY
		*aConsumeQTY(11) = nProcessPrc_QTY
		aConsumeQTY(11) = nProcessPCs
		aConsumeQTY(12) = nProcessPounds
		aConsumeQTY(13) = lAllowSub
		
		
		
		
		
		
		
		
		
		
		*******************************************
		PRIVATE nCntProcess
		nCntProcess = 0
		
		*Check to see if other Details are there 
		*then send Email report of other SO's that also use this Detail
		
		cSQLsID = "SELECT COUNT(*) AS Cntd "
		DO CASE
		CASE cTBL = "S"
			cSQLsID = cSQLsID + " FROM dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQLsID = cSQLsID + " FROM dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQLsID = cSQLsID + " FROM dbo.WIPLst_Process "
		ENDCASE
		
		cSQLsID = cSQLsID + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		cSQLsID = cSQLsID + " AND ( NOT ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		
		*WAIT WINDOW cSOitem NOWAIT
		IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
			cSQLsID = cSQLsID + " AND ( SOitem != dbo.f_ProperSOitem('"+cSOitem +"')"
			cSQLsID = cSQLsID + " AND dbo.f_getSalesNum_SOitem(SOitem)>0 )"
			
			IF nWO > 0
				cSQLsID = cSQLsID + " OR NOT WO="+STR(nWO)+" )"
			ELSE
				cSQLsID = cSQLsID + " ) "
			ENDIF
		ELSE
			IF nWO > 0
				cSQLsID = cSQLsID + " OR NOT WO="+STR(nWO)+" )"
			ELSE
				cSQLsID = cSQLsID + " ) "
			ENDIF
		ENDIF
		
		* cSQLsID = cSQLsID + ") "
		
		IF USED("tmp")
			USE IN tmp
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, 'tmp')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, 'tmp')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, 'tmp' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, 'tmp' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, "tmp")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, "tmp")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLsID, ThisForm.nConnHandle,nSQLEXEC,'tmp')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLsID )
		ELSE
			
			****************************
			*Find other SO's that are also used on this Detail
			IF USED("tmp")
				IF tmp.Cntd > 0
					nCntProcess = tmp.Cntd
							
					*cSQLsID 
					IF nCntProcess > 100
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Too many counted in Query:"+CHR(13)+cSQLsID)
						*Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'HPA App Alert',"Too many in Query:"+CHR(13)+cSQLsID+CHR(13)+"Modify_StockLst_Detail.Create_aConsumeQTY()  Line:"+ALLTRIM(STR( LINENO(1) )) ,ThisForm.nConnHandle,.T.,.F.)
					ENDIF
		
				ENDIF
				USE IN tmp
			ENDIF
		ENDIF
		
		****************************
		IF nCntProcess > 0
			*run email report
			*Alert the other Orders that created a process to this Detail record
		ENDIF
		
		************************************************************************************
		*Collect SO and WO for Email
		PRIVATE cSOitemtmpProcess, nWOtmpProcess
		PRIVATE cSOitemS, cSOitemS_HTML
		cSOitemS = ''
		cSOitemS_HTML = ''
		
			
		cSQL = "SELECT dbo.f_ProperSOitem(SOitem) AS [SOitem], ISNULL(WO,0) AS WO "
		DO CASE
		CASE cTbl = "S"
			cSQL = cSQL +" FROM dbo.StockLst_Process "
		CASE cTbl = "B"
			cSQL = cSQL +" FROM dbo.BrokerLst_Process "
		CASE cTbl = "W"
			cSQL = cSQL +" FROM dbo.WIPLst_Process "
		ENDCASE
		cSQL = cSQL +" WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		cSQL = cSQL +" AND ( NOT ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
			
		IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
			cSQL = cSQL +" AND ( (SOitem != dbo.f_ProperSOitem('"+cSOitem +"')"
			cSQL = cSQL +" AND dbo.f_getSalesNum_SOitem(SOitem)>0  )"
			IF nWO > 0
				cSQL = cSQL +" OR ( ISNULL(WO,0) != "+STR(nWO)+" AND ISNULL(WO,0) != ISNULL(WO,0) )"
				cSQL = cSQL +") "
			ELSE
				cSQL = cSQL +") "
			ENDIF
		ELSE
			IF nWO > 0
				cSQL = cSQL +" AND ( ISNULL(WO,0) != "+STR(nWO)+" AND ISNULL(WO,0) != ISNULL(WO,0) )"
				*cSQL = cSQL +") "
			ELSE
				*cSQL = cSQL +") "
			ENDIF				
		ENDIF		
		cSQL = cSQL +" )"
		
		IF USED("tmpProcess")
			USE IN tmpProcess
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcess")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcess")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpProcess')	
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tmpProcess')	
			IF RECCOUNT('tmpProcess') > 0
				*Build cSOitemS cSOitemS_HTML cMess2
				PRIVATE cMess2, cCompany, cSalesP
				cMess2= ''
				cCompany = ''
				cSalesP =''
				
				SCAN
					cSOitemtmpProcess = PrepareSQLtxt(tmpProcess.SOitem,"SOitem",10)
					IF NOT cSOitemtmpProcess = Proper_SO_item("")
						IF VAL(cSOitem) > 0  &&Just check WO
							cCompany = getFromQuotesSO( Proper_SO_Item_SO(cSOitemtmpProcess) ,"COMPANY",ThisForm.nconnhandle)
							cSalesP  = getFromQuotesSO( Proper_SO_Item_SO(cSOitemtmpProcess) ,"SP",ThisForm.nconnhandle)
							IF EMPTY(cSOitemS) &&Then it is the first add
								cSOitemS = ALLTRIM(cSOitemtmpProcess)
								cSOitemS_HTML = HTML_SOitem(cSOitemtmpProcess,.F.)+" "+get_Description("SOitem",cSOitemtmpProcess,ThisForm.nConnHandle)
								cMess2 =  ALLTRIM(cSOitemtmpProcess)+LEFT(cCompany,10)+" "+cSalesP+CHR(13)
							ELSE
								cSOitemS = cSOitemS + "," +ALLTRIM(cSOitemtmpProcess)
								cSOitemS_HTML = cSOitemS_HTML+CHR(13)+", "+HTML_SOitem(cSOitemtmpProcess,.F.)+" "+get_Description("SOitem",cSOitemtmpProcess,ThisForm.nConnHandle)
								cMess2 = cMess2+ ALLTRIM(cSOitemtmpProcess)+LEFT(cCompany,10)+" "+cSalesP+CHR(13)
							ENDIF
						ELSE
							&&Just check WO
						ENDIF
					ENDIF
					
					nWOtmpProcess = PrepareSQLnum(tmpProcess.WO,'WO',-3)
					IF nWOtmpProcess > 0
						IF EMPTY(cSOitemS)
							cSOitemS = ALLTRIM(STR(nWOtmpProcess))
							cSOitemS_HTML = HTML_WO(nWOtmpProcess,.F.)+" "+get_Description("WO",nWOtmpProcess,ThisForm.nConnHandle)
						ELSE
							cSOitemS = cSOitemS + "," +ALLTRIM(STR(nWOtmpProcess))
							cSOitemS_HTML = cSOitemS_HTML+CHR(13)+", "+HTML_WO(nWOtmpProcess,.F.)+" "+get_Description("WO",nWOtmpProcess,ThisForm.nConnHandle)
						ENDIF
					ENDIF
					
					IF LEN(cSOitemS) > 250
						EXIT
					ENDIF
				ENDSCAN
			ENDIF
			USE IN 'tmpProcess'
		ENDIF			
		
		*UPPER(pWhat) = "CONSUME" OR "SAVE"
		IF UPPER(pWhat) = "CONSUME"
			
			IF nCntProcess = 0
				*--Skip
				lOK = .T.
			ELSE
				lOK = MESSAGEBOX("This Detail Item will be removed!"+CHR(13);
				  +ALLTRIM(STR(nCntProcess))+" Other Sales Order Items or Work Order Items listed use this StockLst Detail"+CHR(13);
				  +cSOitemS+CHR(13);
				  +"Are you still sure you want to consume? (Y/N)"+CHR(13)+CHR(13);
				  +"An Email will be sent to those Sales Reps who wanted this stock.",4+16,"Continue to consume?")=6
				  
				  *+"If an Inventory Correction is pending for this Detail, that will also be removed!"+CHR(13)
			ENDIF
			  
			IF lOK
				PRIVATE cBody
				cBody = "This ID_Detail:"+ALLTRIM(STR(nID_Detail))+" will be consumed!"+CHR(13)
				IF Proper_SO_item(cSOitem) != Proper_SO_item('')
					cBody = cBody + " by SOitem :"+HTML_SOitem(cSOitem,.F.)+" "
					cBody = cBody + " "+get_Description("SOitem",cSOitem,ThisForm.nConnHandle)+CHR(13)
				ENDIF
				IF nWO > 0
					cBody = cBody + " by WorkOrder :"+HTML_WO(nWO,.F.)
					cBody = cBody + " "+get_Description("WO",nWO,ThisForm.nConnHandle)+CHR(13)
				ENDIF
				cBody = cBody + ALLTRIM(STR(nCntProcess))+" other items were to use this StockLst Detail."+CHR(13)
				cBody = cBody + "Messed up SOitem's:"+CHR(13)+cSOitemS_HTML+CHR(13)
				
				TrackMess(LEFT(cBody,254))
				cBody = cBody + " "+ALLTRIM(SYS(0))+"." +CHR(13)+"Modify_StockLst_Detail.Create_aConsumeQTY()   Line:"+ALLTRIM(STR( LINENO(1) ))
				cBody = cBody + CHR(13)+cSQL 
				
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cBody )
				*Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'HPA App Alert',cBody,ThisForm.nConnHandle,.T.,.F.)
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE getbyid_detail_process
		PARAMETER pTbl, nID_Detail_Process
		*ThisForm.GetByID_Detail_Process()
		*Also used in Shop_StockLst_Edit
		
		ThisForm.nID_Detail_Process = nID_Detail_Process
		
		IF VARTYPE(pTbl) != "C"
			TrackError("Bad parameter pTbl- Possible Error","VARTYPE(pTBL)="+VARTYPE(cTbl),PROGRAM(),LINENO(1))
		ENDIF
		
		PRIVATE cTbl
		cTbl = pTbl 
		ThisForm.txtTbl.Value = cTBL
		
		PRIVATE cSOitem, nWO
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
						
		PRIVATE pOrderType, pOrderNumber
		pOrderType = "CORRECTION"
		pOrderNumber = ""
		IF nWO > 0
			pOrderType	= "WO"
			pOrderNumber = STR(nWO)
		ELSE
			IF cSOItem <> Proper_SO_Item("") 
				pOrderType	= "SOitem"
				pOrderNumber = cSOitem
			ENDIF
		ENDIF
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE cSQLpID, nSQLEXEC, cSQLmpID 
		** may have to check History!
		cSQLpID = "SELECT D.Size_H,D.Size_L,D.PC,D.DIM1,D.DIM2,D.DIM3,D.Length,D.Weight,D.Descript,D.[Location],D.FloorStatus,D.Class"
		cSQLpID = cSQLpID + ",D.ID,D.ID_Detail, D.Quarantine"
		cSQLpID = cSQLpID + ",P.SoItem"
		cSQLpID = cSQLpID + ",P.PO_Item, D.ReceivingID, D.InvoiceValue, D.S_QTY, D.S_P, D.S_Total, D.S_PU"
		cSQLpID = cSQLpID + ",M.Alloy,m.Form,D.Prime,D.RandLen,P.Process_ID"
		cSQLpID = cSQLpID + ",P.QTY, P.Pounds, P.Ordered_QTY "
		cSQLpID = cSQLpID + ",P.Prc_Form, P.Prc_PCs, P.Prc_Dim1, P.Prc_Dim2, P.Prc_Dim3 "
		cSQLpID = cSQLpID + ",P.AllowSub "
		
		DO CASE
		CASE cTBL = "S"
			cSQLpID = cSQLpID + " FROM dbo.StockLst_Process P"
			cSQLpID = cSQLpID + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQLpID = cSQLpID + " INNER JOIN dbo.StockLst_Master M ON M.ID = D.ID "
		CASE cTBL = "B"
			cSQLpID = cSQLpID + " FROM dbo.BrokerLst_Process P"
			cSQLpID = cSQLpID + " INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQLpID = cSQLpID + " INNER JOIN dbo.BrokerLst_Master M ON M.ID = D.ID "
		CASE cTBL = "W"
			cSQLpID = cSQLpID + " FROM dbo.WIPLst_Process P"
			cSQLpID = cSQLpID + " INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQLpID = cSQLpID + " INNER JOIN dbo.WIPLst_Master M ON M.ID = D.ID "
		ENDCASE
		
		cSQLpID = cSQLpID + " WHERE P.ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		
		ThisForm.txtHeat.Visible = .F.
		ThisForm.lblHeat.Visible = .F.
		ThisForm.txtLot.Visible = .F.
		ThisForm.lblLot.Visible = .F.
		
		IF USED("StockLst_Detail_P")
			SELECT StockLst_Detail_P
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'StockLst_Detail_P')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'StockLst_Detail_P')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'StockLst_Detail_P')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'StockLst_Detail_P')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, "StockLst_Detail_P")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, "StockLst_Detail_P")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		PRIVATE lQuarantine
		lQuarantine = .F.
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQLpID, ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_P' )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLpID)
		ELSE
			PRIVATE cMess
			IF USED("StockLst_Detail_P")
				SELECT StockLst_Detail_P
				GO TOP
				IF StockLst_Detail_P.ID = 0
					* Found a blank!
					LOCATE FOR ID > 0  
				ENDIF
				IF StockLst_Detail_P.ID > 0		
					*PC,DIM1,DIM2,DIM3,Length,Weight,[Location],FloorStatus,Class,Unit
					
					lQuarantine = PrepareSQLLogic(StockLst_Detail_P.Quarantine,'Quarantine',.F.)
					IF lQuarantine 
						ThisForm.txtQuarantine.Visible = .T.
					ENDIF
					
					ThisForm.txtPc.Value = PrepareSQLnum(StockLst_Detail_P.PC,'Pc',-3)
					ThisForm.txtDIM1.Value = PrepareSQLnum(StockLst_Detail_P.DIM1,'Dim1',-5)
					ThisForm.txtDIM2.Value = PrepareSQLnum(StockLst_Detail_P.DIM2,'Dim2',-5)
					ThisForm.txtDIM3.Value = PrepareSQLnum(StockLst_Detail_P.DIM3,'Dim3',-5)
		
					ThisForm.txtQTY.Value 	 = PrepareSQLnum(StockLst_Detail_P.S_QTY,'QTY',-5)
					ThisForm.txtWeight.Value = PrepareSQLnum(StockLst_Detail_P.Weight,'Weight',9,1)
					ThisForm.txtStk_P.Value = PrepareSQLnum(StockLst_Detail_P.S_P,'S_P',-5)
					ThisForm.txtLocation.Value = ShowSQLtxt(StockLst_Detail_P.Location,'Location',10)
					ThisForm.txtFloorStatus.Value = ShowSQLtxt(StockLst_Detail_P.FloorStatus,'FloorStatus',1)
					ThisForm.txtClass.Value = ShowSQLtxt(StockLst_Detail_P.Class,'Class',1)
					
					PRIVATE cForm, nS_PU
					cForm = ShowSQLtxt(StockLst_Detail_P.Form,'Form',2)
					nS_PU = PrepareSQLnum(StockLst_Detail_P.S_PU,'S_PU',-1)
					
					IF nS_PU = 0
						nS_PU = GetPUfromForm(cForm, ThisForm.nConnHandle)  
					ENDIF
					ThisForm.txtS_PU.Value = PrepareSQLtxt(nS_PU,'S_PU',1)
		
					ThisForm.txtSize_H.Value = PrepareSQLnum(StockLst_Detail_P.Size_H,'Size_H',9,4)
					ThisForm.txtSize_L.Value = PrepareSQLnum(StockLst_Detail_P.Size_L,'Size_L',9,4)
					ThisForm.txtDescript.Value = ShowSQLtxt(StockLst_Detail_P.Descript,'Descript',20)
					
					ThisForm.txtID.Value 		= PrepareSQLnum(StockLst_Detail_P.ID,'ID',-3)
					ThisForm.txtID_Detail.Value = PrepareSQLnum(StockLst_Detail_P.ID_Detail,'ID_Detail',-3)
					ThisForm.nID_Detail			= PrepareSQLnum(StockLst_Detail_P.ID_Detail,'ID_Detail',-3)
					ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(ThisForm.nID_Detail_Process,'ID_Detail_Process',-3)
					ThisForm.txtSOitem.Value  = ShowSQLtxt(StockLst_Detail_P.SOitem,'SOitem',10)
					ThisForm.txtPOitem.Value = ShowSQLtxt(StockLst_Detail_P.PO_Item,'POItem',12)
					
					ThisForm.txtPc1.Value = PrepareSQLnum(StockLst_Detail_P.PC,'Pc',-3)
					ThisForm.txtDIM11.Value = PrepareSQLnum(StockLst_Detail_P.DIM1,'Dim1',-5)
					ThisForm.txtDIM21.Value = PrepareSQLnum(StockLst_Detail_P.DIM2,'Dim2',-5)
					ThisForm.txtDIM31.Value = PrepareSQLnum(StockLst_Detail_P.DIM3,'Dim3',-5)
					ThisForm.txtLength1.Value = ShowSQLtxt(StockLst_Detail_P.Length,'Length',160)
					ThisForm.txtWeight1.Value = PrepareSQLnum(StockLst_Detail_P.Weight,'Weight',9,1)
					
					*ThisForm.txtPc2.Value = PrepareSQLnum(StockLst_Detail_P.pPc,'pPc',-3)
					ThisForm.txtPc2.Value = 0 &&PrepareSQLnum(StockLst_Detail_P.PC,'Pc',-3)
					
					ThisForm.txtDIM22.Value = 0
					ThisForm.txtDIM32.Value = 0
					ThisForm.txtWeight2.Value = 0
					
					ThisForm.txtForm3.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_Form,'Form',2)
					IF UPPER(PrepareSQLtxt(StockLst_Detail_P.AllowSub,'AllowSub',1))= 'N'
						ThisForm.txtPC3.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_PCs,'PCS',10)
					ELSE
						ThisForm.txtPC3.Value	= ThisForm.txtPC1.Value
					ENDIF
					IF PrepareSQLnum(StockLst_Detail_P.Prc_Dim1,'Dim1',9,4) > 0
						ThisForm.txtDim13.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_Dim1,'Dim1',9,4)
					ELSE
						ThisForm.txtDim13.Value = ThisForm.txtDIM1.Value
					ENDIF
					ThisForm.txtDim23.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_Dim2,'DIM2',8,3)
					ThisForm.txtDim33.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_Dim3,'DIM3',8,3)
					ThisForm.txtQTY3.Value		= PrepareSQLnum(StockLst_Detail_P.QTY,'QTY',-5)
					ThisForm.txtWeight3.Value	= PrepareSQLnum(StockLst_Detail_P.Pounds,'Weight',9,1)
		
		*			ThisForm.txtLocation1.Value = IIF( ISNULL(StockLst_Detail_P.[Location]),'',StockLst_Detail_P.[Location])
					ThisForm.cmbLocation1.Value = ShowSQLtxt(StockLst_Detail_P.Location,'Location',10)
					ThisForm.txtFloorStatus1.Value = ShowSQLtxt(StockLst_Detail_P.FloorStatus,'FloorStatus',1)
					ThisForm.txtClass1.Value = ShowSQLtxt(StockLst_Detail_P.Class,'Class',1)
		
					ThisForm.txtSize_H1.Value = PrepareSQLnum(StockLst_Detail_P.Size_H,'Size_H',9,4)
					ThisForm.txtSize_L1.Value = PrepareSQLnum(StockLst_Detail_P.Size_L,'Size_L',9,4)
					ThisForm.txtDescript1.Value = ShowSQLtxt(StockLst_Detail_P.Descript,'Descript',20)
					ThisForm.chkPrime.Value		= PrepareSQLchk(StockLst_Detail_P.Prime,'Prime',.F.)
					ThisForm.chkRandLen.Value	= PrepareSQLchk(StockLst_Detail_P.RandLen,'RandLen',.F.)
					
					ThisForm.txtAlloy1.Value = ShowSQLtxt(StockLst_Detail_P.Alloy,'Alloy',12)
					ThisForm.txtForm1.Value = cForm
					
					PRIVATE nReceivingID
					nReceivingID = PrepareSQLnum(StockLst_Detail_P.ReceivingID,'ReceivingID',-3)
					IF nReceivingID = 0
						nReceivingID = getReceivingIDHistory_ID_Detail(ThisForm.nID_Detail, cTBL, ThisForm.nConnHandle)
					ENDIF
					
					ThisForm.txtReceivingID.Value = nReceivingID
					
					IF ThisForm.txtReceivingID.Value = 0
						*Some stock never had ReceivingID recorded.
						*TrackError("No ReceivingID "+CHR(13)+"nReceivingID=0 TBL="+cTbl+" ID_Detail_Process="+ALLTRIM(STR(ThisForm.nID_Detail_Process))+" "+CHR(10)+CHR(13)+cSQLpID,"Bad ReceivingID nReceivingID=0 TBL="+cTbl+" ID_Detail_Process="+ALLTRIM(STR(ThisForm.nID_Detail_Process)) ,PROGRAM(),LINENO(1))
						*RecordTest("Record Test Data.", PROGRAM(), LINENO(1), "Did not find ReceivingID with Stock, but Some stock never had ReceivingID recorded."+CHR(13)+"nReceivingID=0 TBL="+cTbl+" ID_Detail_Process="+ALLTRIM(STR(ThisForm.nID_Detail_Process))+" "+CHR(13)+cSQLpID+CHR(10)+CHR(13)+"SELECT [When] FROM  dbo.Ar_Stocklst_Detail_History WHERE [What] = 'ADD' AND ID_Detail_Process = "+ALLTRIM(STR(ThisForm.nID_Detail_Process)) )
					ENDIF
					
					PRIVATE nS_P, nS_QTY
					nS_P 			= PrepareSQLnum(StockLst_Detail_P.S_P,'S_P',-5)
					nInvoiceValue	= PrepareSQLnum(StockLst_Detail_P.InvoiceValue,'InvoiceValue',-5)
					nS_QTY			= PrepareSQLnum(StockLst_Detail_P.S_QTY,'QTY',-5)
					
					IF nInvoiceValue = 0
						nInvoiceValue = nS_P * nS_QTY
					ENDIF
					ThisForm.txtInvoiceValue.Value	= nInvoiceValue
					
					ThisForm.txtProcess_ID.Value	= PrepareSQLtxt(StockLst_Detail_P.Process_ID,'Process_ID',10)
					
					PRIVATE m.nS_QTY, m.nS_P 
					m.nS_QTY = PrepareSQLnum(StockLst_Detail_P.S_QTY,'S_QTY',-5)
					m.nS_P	= PrepareSQLnum(StockLst_Detail_P.S_P,'S_P',-5)
					ThisForm.txtS_QTY.Value = IIF( m.nS_QTY=0,PrepareSQLnum(ThisForm.txtWeight1.Value,'S_QTY',9,1),m.nS_QTY)
					*ThisForm.txtS_P.Value = IIF( m.nS_P=0,PrepareSQLnum(ThisForm.txtStk_P.Value,'S_P',-5),m.nS_P)
					ThisForm.txtS_P.Value = PrepareSQLnum(StockLst_Detail_P.S_P,'S_P',-5)
					
					ThisForm.Calc_StockDetail_0()
					ThisForm.Calc_StockDetail_1()
					*ThisForm.Calc_StockDetail_3()  && done later in method
					
					ThisForm.Visible = .T.
					*ThisForm.RefreshForm()
					ThisForm.txtPc.SetFocus()
					
					ThisForm.getSalesProcess()
					
					IF cTbl = "S"
						*Get Heat from Master************
						cSQLmpID = "SELECT Heat,Lot FROM dbo.StockLst_Master WITH(NOLOCK) WHERE ID = "+ALLTRIM(STR(StockLst_Detail_P.ID))
		
						IF USED("StockLst_Detail_P")
							SELECT StockLst_Detail_P
						ELSE
							SELECT 0
						ENDIF
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, 'StockLst_M_P')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, 'StockLst_M_P')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, 'StockLst_M_P')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, 'StockLst_M_P')
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, "StockLst_M_P")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, "StockLst_M_P")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQLmpID, ThisForm.nConnHandle, nSQLEXEC, 'StockLst_M_P')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLmpID)
						ELSE
							IF USED("StockLst_M_P")
								ThisForm.txtHeat.Value = IIF( ISNULL(StockLst_M_P.HEAT),'',StockLst_M_P.Heat)
								ThisForm.txtHeat.Visible = .T.
								ThisForm.lblHeat.Visible = .T.
								ThisForm.txtLot.Value = IIF( ISNULL(StockLst_M_P.Lot),'',StockLst_M_P.Lot)
								ThisForm.txtLot.Visible = .T.
								ThisForm.lblLot.Visible = .T.
							ENDIF
						ENDIF
					ENDIF
					IF USED("StockLst_M_P")
						USE IN StockLst_M_P
					ENDIF
		
				ELSE
		
					=Remove_ID_Detail_Process(ThisForm.nID_Detail_Process, pOrderType,pOrderNumber, cTbl,ThisForm.nConnHandle,'Not Found')
					lOK = .F.
					ThisForm.Visible = .T.
					ThisForm.RefreshForm()
					ThisForm.txtPc.SetFocus()
		
				ENDIF
			ELSE
				=Remove_ID_Detail_Process(ThisForm.nID_Detail_Process,  pOrderType,pOrderNumber, cTbl ,ThisForm.nConnHandle,'CORRECTION')
				lOK = .F.
				ThisForm.Visible = .T.
				ThisForm.RefreshForm()
				ThisForm.txtPc.SetFocus()
		
			ENDIF
		ENDIF
		
		IF USED("StockLst_Detail_P")
			USE IN StockLst_Detail_P
		ENDIF
		
		
		***************************************
		*fill in txtPC3 what is left to be Removed
		*Check PartSelect, Then SOitem in AllQuotes then WorkOrder
		
		***************************************
		*Fill Process 3 data
		PRIVATE cSQL, nSQLEXEC, nID_Detail 
		nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		
		PRIVATE npPcs, npSize1, npSize2, npSize3, nQTY3, npWeight 
		npPcs	= PrepareSQLnum(ThisForm.txtPC3.Value,'Peices',10)
		npSize1	= PrepareSQLnum(ThisForm.txtDim13.Value,'DIM1',10,4)
		npSize2	= PrepareSQLnum(ThisForm.txtDim23.Value,'DIM2',9,3)
		npSize3	= PrepareSQLnum(ThisForm.txtDim33.Value,'DIM3',9,3)
		npQTY3	= PrepareSQLnum(ThisForm.txtQTY3.Value,'QTY',18,4)
		npWeight = PrepareSQLnum(ThisForm.txtWeight3.Value,'Weight',7,1)
		
		*!*	*******************
		*!*	PRIVATE nCalcD_QTY, nCalcD_LBS
		*!*	nCalcD_QTY	= GetUnitQty(nDPCs, cAlloy, cForm, nDDim1, nDDim2, nDDim3, ThisForm.nConnHandle)
		*!*	nCalcD_LBS	= GetWeight(nDPCs, cAlloy, cForm, nDDim1, nDDim2, nDDim3, ThisForm.nConnHandle)
		
		*!*	*******************
		*!*	PRIVATE nCalc_QTY, nCalc_Weight
		*!*	nCalc_QTY	 = GetUnitQty(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		*!*	nCalc_Weight = CalcWeight(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		*!*	nCalc_Weight = GetWeight(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		
		
		IF npSize2 = 0	&&Fix Process Dims
			IF Proper_SO_Item(ThisForm.cSOitem) != Proper_SO_Item('') AND ThisForm.nWO = 0
			
				IF USED("tmpSOitemDesc")
					SELECT tmpSOitemDesc
				ELSE
					SELECT 0
				ENDIF
				cSQL = "SELECT Pieces,Thck,Sz2,Sz3,Q_Qty,cWeight"
				cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = '"+ThisForm.cSOitem+"'"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitemDesc' )
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					IF USED("tmpSOitemDesc")
						IF RECCOUNT("tmpSOitemDesc") > 0
		
							ThisForm.txtPC3.Value	= tmpSOitemDesc.Pieces
							ThisForm.txtDim13.Value	= tmpSOitemDesc.Thck
							ThisForm.txtDim23.Value	= tmpSOitemDesc.Sz2
							ThisForm.txtDim33.Value	= tmpSOitemDesc.Sz3
							ThisForm.txtQTY3.Value	= tmpSOitemDesc.Q_Qty		&&Filled with Process Data
							ThisForm.txtWeight3.Value	= tmpSOitemDesc.cWeight	&&Filled with Process Data
		
						ENDIF
					ENDIF
				ENDIF
			ELSE
				IF ThisForm.nWO > 0
		
					PRIVATE cSQL, nSQLEXEC 
		
					IF USED("tmpSOitemDesc")
						SELECT tmpSOitemDesc
					ELSE
						SELECT 0
					ENDIF
					cSQL = "SELECT sPieces,sThck,sSz2,sSz3,sWeight,sWeight"
					cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) "
					cSQL = cSQL + " WHERE WO = "+STR(ThisForm.nWO)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitemDesc' )
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ELSE
						IF USED("tmpSOitemDesc")
							IF RECCOUNT("tmpSOitemDesc") > 0
		
								ThisForm.txtPC3.Value	= tmpSOitemDesc.sPieces
								ThisForm.txtDim13.Value	= tmpSOitemDesc.sThck
								ThisForm.txtDim23.Value	= tmpSOitemDesc.sSz2
								ThisForm.txtDim33.Value	= tmpSOitemDesc.sSz3
								ThisForm.txtQTY3.Value	= tmpSOitemDesc.sWeight
								ThisForm.txtWeight3.Value	= tmpSOitemDesc.sWeight
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			**Check new numbers
			PRIVATE nCalcQTY, nCalcLBS, nPieces, cAlloy, cForm, nSize1, nSize2, nSize3
			nPieces	= PrepareSQLnum(ThisForm.txtPC3.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
			cForm	= Proper_Form(PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2))
			nSize1	= PrepareSQLnum(ThisForm.txtDim13.Value,'DIM1',10,4)
			nSize2	= PrepareSQLnum(ThisForm.txtDim23.Value,'DIM2',9,3)
			nSize3	= PrepareSQLnum(ThisForm.txtDim33.Value,'DIM3',9,3)
		
			nCalcQTY = GetUnitQty(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
			*nCalcLBS = CalcWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
			nCalcLBS = GetWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
			
			ThisForm.txtQTY3.Value	  = nCalcQTY 
			ThisForm.txtWeight3.Value = nCalcLBS 
		ENDIF
		
		ThisForm.Calc_StockDetail_3() &&no tmpStkSum 
		
		ThisForm.EnterWeight3 = .F.
		ThisForm.EnterQTY3 = .F.
		
		RETURN lOK
	ENDPROC

	PROCEDURE getsalesprocess
		*ThisForm.GetSalesProcess()
		*Also used in Shop_StockLst_Edit
		
		ThisForm.ShowSalesProcess(.F.)
		
		IF USED("tmpSalesProcess")
			SELECT tmpSalesProcess
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE cSOitem
		cSOitem	= ThisForm.cSOitem
		
		PRIVATE cSQL
		cSQL = "SELECT Inv,GFM,Roll,Press,Mach,CG,Plasma,WJet "
		cSQL=cSQL+" FROM dbo.Sales WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesProcess')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesProcess')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesProcess')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesProcess')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesProcess")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesProcess")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesProcess' )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED("tmpSalesProcess")
				SELECT tmpSalesProcess
				GO TOP
				IF RECCOUNT('tmpSalesProcess') > 0
		
					*ThisForm.txtPc.Value = IIF( ISNULL(tmpSalesProcess.PC),'',tmpSalesProcess.PC)
					ThisForm.chkINV.Value		= tmpSalesProcess.INV
					ThisForm.lblSOitem.Caption	= cSOitem
					ThisForm.chkGFM.Value		= tmpSalesProcess.GFM
					ThisForm.chkRoll.Value		= tmpSalesProcess.Roll
					ThisForm.chkPress.Value		= tmpSalesProcess.Press
					ThisForm.chkMach.Value		= tmpSalesProcess.Mach
					ThisForm.chkCG.Value		= tmpSalesProcess.CG
					ThisForm.chkPlasma.Value	= tmpSalesProcess.Plasma
					ThisForm.chkWJet.Value		= tmpSalesProcess.WJet
					
					ThisForm.ShowSalesProcess(.T.)			
				ENDIF
			ENDIF
		ENDIF			
	ENDPROC

	PROCEDURE grab_foundstk		&& Same code as Shop_StockLst_Edit
		PARAMETERS lFoundStk 
		*ThisForm.Mark_FoundStock()
		
		PRIVATE cSOitem, nSalesNum, nWO, cPOitem, cWhat 
		cSOitem		= PrepareSQLtxt(ThisForm.cSOitem,'SOitem',10)
		nSalesNum 	= Proper_SO_item_SO(cSOitem)
		nWO			= PrepareSQLnum(ThisForm.nWO.Value,'WO',-3)
		cPOitem		= PrepareSQLtxt(ThisForm.cPOitem,'POitem',12)
		
		PRIVATE nID, nID_Detail, nID_Detail_Process, cTBL
		nID_Detail		   = PrepareSQLnum(ThisForm.nID_Detail,'ID_Detail',-3)
		nID_Detail_Process = PrepareSQLnum(ThisForm.nID_Detail_Process,'ID_Detail_Process',-3)
		cTBL 				= ThisForm.cTBL
		nID			= Get_ID_with_ID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle)
		
		cWhat 		= 'Found Stock' &&CHAR(20)
		cComment = "Stock:"+cTBL+" "+ALLTRIM(STR(nID))+" "+ALLTRIM(STR(nID_Detail))+" Prc:"+ALLTRIM(STR(nID_Detail_Process))
		IF nWO>0
			cComment = cComment + " WO:"+ALLTRIM(STR(nWO))
		ENDIF
		
		*PRIVATE lFoundStk
		*lFoundStk = PrepareSQLchk(ThisFormSet.frmStockLstProcesses.chkFoundStock.Value,'FoundStk')
		
		*Update Proc
		PRIVATE cSQL, nSQLEXEC 
		IF USED("CntProcess")
			USE IN CntProcess
		ENDIF
		SELECT 0
		
		cSQL = ""
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + "UPDATE dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = cSQL + "UPDATE dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = cSQL + "UPDATE dbo.WIPLst_Process "
		OTHERWISE
			MESSAGEBOX("Check_ID_Detail_Process did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("Check_ID_Detail_Process did not recognize Table Name","Check_ID_Detail_Process did not recognize Table Name",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDCASE
		IF lFoundStk 
			cSQL = cSQL + " SET FoundSTK = GETDATE() "
		ELSE
			cSQL = cSQL + " SET FoundSTK = NULL "
		ENDIF
		cSQL = cSQL + " WHERE ID_Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'CntProcess' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'CntProcess' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CntProcess")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CntProcess")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		PRIVATE lOK
		lOK = .T.
		IF nSQLEXEC < 0
			IF NOT SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'CntProcess')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				lOK = .F.
			ENDIF
		ENDIF
		
		IF lOK
		
		
			cComment = LEFT(cComment,255)
			IF nSalesNum > 0
				IF lFoundStk 
					cComment = 'Grabbed '+cComment
				ELSE
					cComment = 'RemoveGrab '+cComment
				ENDIF
				SaveTo_SOitem_Status( cSOitem, cWhat, cComment, ThisFormSet.nConnHandle )
				lOK = set_rtr_Detail_Oper('SOi',cSOitem,105,522,cComment,.T.,ThisFormSet.nConnHandle)
			ELSE
				IF nWO>0
					IF lFoundStk 
						cComment = 'Grabbed '+cComment
					ELSE
						cComment = 'RemoveGrab '+cComment
					ENDIF		
					SaveTo_WorkOrder_Notes(nWO, 0, cComment, ThisFormSet.nConnHandle )
					lOK = set_rtr_Detail_Oper('WO',nWO,105,522,cComment,.T.,ThisFormSet.nConnHandle)
				ENDIF
			ENDIF
		
		
		
		*	IF ThisFormSet.frmStocklst_SQL.Visible
		*		ThisFormSet.Show_Selected_INV("FULL_STK_PRC")
		*		ThisFormSet.frmStocklst_SQL.GoToID_Detail(tmpProcess.ID_Detail,tmpProcess.Prc_Dim2,tmpProcess.Prc_Dim3)
		*	ENDIF
		
			IF lFoundStk 
				ThisFormSet.Make_Process_Grab(nID_Detail_Process,cTBL)   && run again for check
			ELSE
			*Remove Grab Found Stock Process 
				PRIVATE cSQLi 
				cSQLi = "DELETE FROM dbo.StockLst_Process_Grab "
				cSQLi = cSQLi + " WHERE ID_Detail_Process="+STR(nID_Detail_Process)+""
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
		
		
			
				MESSAGEBOX("Removed FOUND STOCK Mark from the SELECTED process and Pulled from Rack.",0,"Remove Grab")
			ENDIF
		ELSE
			*This.Value = !This.Value
			MESSAGEBOX("Error with SQL",0,"Did not work")
		ENDIF
		
		
		
		
		*!*	PRIVATE lFoundStk
		*!*	lFoundStk = PrepareSQLchk(This.Value,'FoundStk')
		
		*!*	IF lFoundStk 
		*!*		ThisFormSet.Grab_foundStk(lFoundStk)
		*!*	ELSE
		*!*		PRIVATE nID_Detail_Process
		*!*		nID_Detail_Process = PrepareSQLnum(ThisFormSet.frmStockLstProcesses.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		*!*		
		*!*		PRIVATE cTBL
		*!*		cTBL = ThisForm.tbl.Value
		*!*		
		*!*		*Update Proc --UNDO
		*!*		PRIVATE cSQL, nSQLEXEC 
		*!*		IF USED("CntProcess")
		*!*			USE IN CntProcess
		*!*		ENDIF
		*!*		SELECT 0
		
		*!*		cSQL = ""
		*!*		DO CASE
		*!*		CASE cTBL = "S"
		*!*			cSQL = cSQL + "UPDATE dbo.StockLst_Process "
		*!*		CASE cTBL = "B"
		*!*			cSQL = cSQL + "UPDATE dbo.BrokerLst_Process "
		*!*		CASE cTBL = "W"
		*!*			cSQL = cSQL + "UPDATE dbo.WIPLst_Process "
		*!*		OTHERWISE
		*!*			MESSAGEBOX("Check_ID_Detail_Process did not recognize Table Name",0+16,"Aborting Save!")
		*!*			TrackError("Check_ID_Detail_Process did not recognize Table Name","Check_ID_Detail_Process did not recognize Table Name",PROGRAM(),LINENO(1))
		*!*			RETURN .F.
		*!*		ENDCASE
		*!*	*	IF lFoundStk 
		*!*	*		cSQL = cSQL + " SET FoundSTK = GETDATE() "
		*!*	*	ELSE
		*!*			cSQL = cSQL + " SET FoundSTK = NULL "
		*!*	*	ENDIF
		*!*		cSQL = cSQL + " WHERE ID_Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))
		
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CntProcess' )
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CntProcess' )
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntProcess")
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CntProcess")
		*!*				
		*!*				IF nSQLEXEC < 0
		*!*					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*						nSQLEXEC = 0
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDDO
		*!*		ENDIF 
		*!*		PRIVATE lOK
		*!*		lOK = .T.
		*!*		IF nSQLEXEC < 0
		*!*			IF NOT SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'CntProcess')
		*!*				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
		*!*				lOK = .F.
		*!*			ENDIF
		*!*		ENDIF
		
		*!*		PRIVATE cSOitem, nSalesNum, cWhat, nWO
		*!*		cSOitem		= PrepareSQLtxt(ThisFormSet.frmStockLstProcesses.SOitem1.Value,'SOitem',10)
		*!*		nSalesNum 	= Proper_SO_item_SO(cSOitem)
		*!*		cWhat 		= 'Found Stock' &&CHAR(20)
		*!*		nWO			= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.WO1.Value,'WO',-3)
		*!*		
		*!*		PRIVATE cComment 
		*!*		cComment = ''
		*!*		IF lOK
		*!*			cComment = LEFT(cComment,255)
		*!*			IF nSalesNum > 0
		*!*	*			IF lFoundStk 
		*!*	*				cComment = 'Grabbed '+cComment
		*!*	*			ELSE
		*!*					cComment = 'RemoveGrab '+cComment
		*!*	*			ENDIF
		*!*				SaveTo_SOitem_Status( cSOitem, cWhat, cComment, ThisFormSet.nConnHandle )
		*!*				lOK = set_rtr_Detail_Oper('SOi',cSOitem,105,522,cComment,.T.,ThisFormSet.nConnHandle)
		*!*			ELSE
		*!*				IF nWO>0
		*!*	*				IF lFoundStk 
