					cSQLid = cSQLid+ ",UserEdit='Consumed Stock.'"
					cSQLid = cSQLid+ " WHERE ID="+STR(nSales_Stock_ID)
					
					*nSales_Stock_ID = 0
					PRIVATE cMess_Title
					cMess_Title = "Found Sales_Stock from PackingSlip!?!"+" Sales_Stock.ID="+STR(nSales_Stock_ID)
					
					TrackError(cMess_Title+" "+CHR(13)+cSQLid ,cMess_Title,PROGRAM(),LINENO(0))
					RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "Found Sales_Stock from PackingSlip!?!"+" Sales_Stock.ID="+STR(nSales_Stock_ID)+" "+CHR(13)+cSQLid )
					
				ENDIF
					
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid , '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid , '')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLid, ThisForm.nConnHandle,nSQLEXEC)
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLid )
					lOK =.F.
				ELSE
					IF nSales_Stock_ID = 0
						*Get nSales_Stock_ID
		
						IF USED('tmpSales_Stock_ID')
							USE IN tmpSales_Stock_ID
						ENDIF
						
						cSQL = "SELECT ID FROM dbo.Sales_Stock WITH(NOLOCK) WHERE "
		*				cSQL=cSQL+" StockLst_Qty="+STR(nStockLst_Qty,18,4)	*depricated
		*				cSQL=cSQL+" AND StockLst_P="+STR(nStockLst_P,18,4)
