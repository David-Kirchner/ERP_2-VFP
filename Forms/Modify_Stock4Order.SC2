		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, '')
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0 &&Try again!
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
		*!*					
		*!*					IF nSQLEXEC < 0
		*!*						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*							nSQLEXEC = 0
		*!*						ENDIF
		*!*					ENDIF
		*!*				ENDDO
		*!*			ENDIF 
		*!*			
		*!*			IF nSQLEXEC < 0 
		*!*				This.Value = !This.Value
		*!*				MESSAGEBOX("Error with SQL",0,"Did not work")
		*!*			ENDIF
		*!*		
		*!*			MESSAGEBOX("Removed FOUND STOCK Mark from the SELECTED process and Pulled from Rack.",0,"Remove Grab")
		*!*		ENDIF
		*!*	ENDIF
		
		
		
	ENDPROC

	PROCEDURE hide_stksum
		PARAMETERS lHide
		*thisForm.Hide_StkSum(.T.)
		
		IF lHide
			ThisForm.DoneWith_StkSum = .T.
			ThisForm.lblSalesDetail.Visible = .F.
			ThisForm.lblenterEach.Visible = .F.
			ThisForm.lblPC3.Visible = .F.
			ThisForm.lblSz13.Visible = .F.
			ThisForm.lblSz23.Visible = .F.
			ThisForm.lblSz33.Visible = .F.
			ThisForm.lblQty3.Visible = .F.
			ThisForm.lblLBS.Visible = .F.
			ThisForm.txtPC3.Visible = .F.
			ThisForm.txtDim13.Visible = .F.
			ThisForm.txtDim23.Visible = .F.
			ThisForm.txtDim33.Visible = .F.
			ThisForm.txtQTY3.Visible = .F.
			ThisForm.txtWeight3.Visible = .F.
			ThisForm.cmdAddSum.Visible = .F.
			ThisForm.cmdGetSOitemDesc.Visible = .F.
			ThisForm.cmdEditSum.Visible = .F.
			ThisForm.cmdDelSum.Visible = .F.
			ThisForm.lblSummDetail.Visible = .F.
			ThisForm.grdSummary.Visible = .F.
			ThisForm.lblPSAccount.Visible = .F.
			ThisForm.shpSTKsum.Visible = .F.
			*ThisForm.edtUserEdit.Visible = .F.
			ThisForm.edtUserEdit.Width = ThisForm.edtUserEdit.Width - (531-925)
			ThisForm.edtUserEdit.Value = ''
			**Set to '' before the next call of
			**ThisForm.SaveStockLstEdit_tmpStkSum(lConsumed, lScrap, lMovetoStock)
		
			
			ThisForm.Width = 531
		ELSE
			ThisForm.Width = 925
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pTBL, pID_Detail, pID_Detail_Process, pSOitem, pPOitem, pWO, pWO_Detail, pRID, pHeat
		***  Make sure you 'Grab' Stock before CALLing this! ***
		
		*DO FORM Forms\modify_stock4order WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO, nWO_Detail, nRID, cHeat
		*DO FORM Forms\modify_stock4order WITH "S", 30440, 125503, '', '  504500-01', 1021
		
		*DO FORM Forms\modify_stock4order WITH "S", 30440, 125503,         '', '  504500-01', 1021
		*DO FORM Forms\modify_stock4order WITH "B", 13412,  33834,' 141759-02',' 511962-01' ,    0,.F., .F., .F.
		
		IF VARTYPE(pTBL) != "C"
			TrackError("Error","TableName parameter Not Found",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF VARTYPE(pID_Detail) != "N"
			TrackError("Error","pID_Detail parameter Not Found",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		PRIVATE nID_Detail_Process
		nID_Detail_Process=0
		IF VARTYPE(pID_Detail_Process) != "N"
			TrackError("Error","pID_Detail_Process parameter Not Found",PROGRAM(),LINENO(1))
			RETURN .F.
		ELSE
			nID_Detail_Process = pID_Detail_Process
		ENDIF
		
		PRIVATE lCheckGrab 
		lCheckGrab = .F.
		
		IF VARTYPE(pTBL) = "C"
			ThisForm.cTBL = pTBL
			ThisForm.TxtTbl.Value = pTBL
		ELSE
			ThisForm.cTBL = ''
			ThisForm.txtTBL.Value = ''
		ENDIF
		
		IF VARTYPE(pID_Detail) = "N"
			ThisForm.nID_Detail = pID_Detail
			ThisForm.txtID_Detail.Value = pID_Detail
			
			PRIVATE nID	
			nID = Get_ID_by_ID_Detail(pID_Detail, ThisForm.cTBL, ThisForm.nConnHandle)
			ThisForm.txtID.Value = nID
		ENDIF
		IF VARTYPE(nID_Detail_Process) = "N"
			ThisForm.nID_Detail_Process = nID_Detail_Process
			ThisForm.txtID_Detail_Process.Value = nID_Detail_Process
		ENDIF
		IF VARTYPE(pSOitem) = "C"
			ThisForm.cSOitem = pSOitem
			ThisForm.txtSOitem.Value = pSOitem
			IF Proper_SO_item(pSOitem) <> Proper_SO_item('')
				IF Is_SOitem_OnHold( pSOitem, "ANY", ThisForm.nConnhandle)
					MESSAGEBOX("This SOitem '"+pSOitem+"' is OnHold"+CHR(13)+"You can continue, but this will be record!",32,"Continue")
					TrackMess("The SOitem '"+pSOitem+"' is OnHold and Modify Stock 4 Order is being run."+" "+CHR(13)+SYS(16,1))
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"The SOitem '"+pSOitem+"' is OnHold and Modify Stock 4 Order is being run.") 
					nSalesNum = Proper_SO_Item_SO(pSOitem)
					Track_Sales_No_Chng("The SOitem '"+pSOitem+"' is OnHold and Modify Stock 4 Order is being run.",nSalesNum,0,0)
				ENDIF
				ThisForm.ShowOrdered("SOitem")
				lCheckGrab = .T.
			ENDIF
		ENDIF
		IF VARTYPE(pPOitem) = "C"
			ThisForm.cPOitem = pPOitem
			ThisForm.txtPOitem.Value = pPOitem
		ENDIF
		
		IF VARTYPE(pWO) = "N"
			ThisForm.txtWO.Value = PrepareSQLnum(pWO,'WO',-3)
			ThisForm.nWO = PrepareSQLnum(pWO,'WO',-3)
			
			ThisForm.chkMarkInvCheck.Visible = .F.
			
			IF ThisForm.nWO > 0
				ThisForm.ShowOrdered("WO")
				lCheckGrab = .T.
			ENDIF
		ENDIF
		
		IF VARTYPE(pWO_Detail) = "N"
			*ThisForm.txtWO_Detail.Value = pWO_Detail
			ThisForm.nWO_Detail = PrepareSQLnum(pWO_Detail,'WO_Detail',-3)
			
			ThisForm.chkMarkInvCheck.Visible = .F.
		ENDIF
		
		ThisForm.EnterWeight1 	= .F.
		ThisForm.EnterS_QTY 	= .F.
		ThisForm.EnterWeight3 	= .F.
		ThisForm.EnterQTY3 		= .F.
		
		ThisForm.txtHeat.Value = PrepareSQLtxt(pHeat,'Heat',50,.f.)
		ThisForm.txtLot.Value = ''
		
		PRIVATE lOK
		lOK = .T.
		
		IF NOT EMPTY(ALLTRIM(ThisForm.cTBL))
			lOK = ThisForm.GetByID_Detail_Process(ThisForm.cTBL,nID_Detail_Process)
			IF NOT lOK
				* decide what to do here when Process not found!
			ENDIF
		ELSE
			TrackError("Could not find cTBL value?","Could not find cTBL value?",Program(),LINENO())
		ENDIF
		
		IF lCheckGrab 
			ThisForm.check_Grab_Stock()
		ENDIF
		
		ThisForm.RefreshForm()
		
		ThisForm.AddDetailSum()
		
		ThisForm.PopUp_PackingSlip()
		
		*ThisForm.Visible = .T.
		*ThisForm.AlwaysOnTop = .T.
		*ThisForm.AlwaysOnTop = .F.
		**ThisForm.txtPC3.SetFocus
		*ThisForm.cmdAddSum.SetFocus
		ThisForm.cmdDone.SetFocus
		
		ThisForm.DoneWith_StkSum = .F.
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_QUOTES ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ UPPER( SET("PROCEDURE") )
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		IF NOT "PROC_RTR" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_rtr ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF SET('SAFETY') = "ON"
			SET SAFETY OFF
		ENDIF
		
		PUBLIC ARRAY aConsumeQTY(14)
		
		
	ENDPROC

	PROCEDURE make_process_grab
		PARAMETERS nID_Detail_Process, cTBL
		*ThisForm.Make_Process_Grab(nID_Detail_Process,cTBL) 
		
		*check for Process_Grab to see if Insert is needed.
		PRIVATE cSQL, nSQLEXEC 
		IF USED("cntProcessGrb")
			USE IN cntProcessGrb
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ID_Detail "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process_Grab "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM  dbo.BrokerLst_Process_Grab "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process_Grab "
		OTHERWISE
			MESSAGEBOX("Make_Process_Grab() did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("Make_Process_Grab() did not recognize Table Name","Make_Process_Grab() did not recognize Table Name",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntProcessGrb' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntProcessGrb' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntProcessGrb")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntProcessGrb")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		PRIVATE lOK
		lOK = .T.
		IF nSQLEXEC < 0
			IF NOT SQLEXECError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'cntProcessGrb')
				RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(1),cSQL )
				lOK = .F.
			ENDIF
		ENDIF
		PRIVATE lInsert
		lInsert = lOK   &&should be True
		
		IF USED('cntProcessGrb')
			IF RECCOUNT('cntProcessGrb')>0
				IF cntProcessGrb.ID_Detail > 0
					lInsert = .F.
				ENDIF
			ENDIF
			USE IN cntProcessGrb
		ENDIF
		
		IF lInsert
			PRIVATE cSQLi 
			cSQLi = "EXEC dbo.p_Lst_Process_Grab_ins "
			cSQLi = cSQLi + "@ID_Detail_Process="+STR(nID_Detail_Process)+""
			cSQLi = cSQLi + ",@TBL='"+cTBL+"'"
			*INSERT INTO dbo.StockLst_Process_Grab 
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ELSE 
				*MESSAGEBOX("Made the SELECTED process as Process_Grab",0,"Grabbed")
				WAIT WINDOW "created Process_Grab record" NOWAIT
			ENDIF 
		ENDIF
		
		
	ENDPROC

	PROCEDURE modify_brokerlst_detail_report
		PARAMETER pID_Detail_Process, pSOItem
		*ThisForm.Modify_BrokerLst_Detail_Report
		*Modify_BrokerLst_Detail_Report(m.ID_Detail_Process, m.SOItem)
		*- reports Process Value
		**********************************
		**********************************
		RETURN .T.
		
		
		
		
		
		
		
		
		
		
		
		PRIVATE cSOitem, nWO
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		
		**********************************
		**********************************
		
		IF VARTYPE(pID_Detail_Process) != 'N'
			pID_Detail_Process = 0
		ENDIF
		
		PRIVATE nMess
		nMess = 6
		
		PRIVATE nBE, nAE, nAD, nDL, nChange
		nChange = 0
		*****Just this Process
		PRIVATE cSQL
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		*
		
		IF pID_Detail_Process > 0
		*	cSQL = "SELECT SUM(ProcessValue) AS TotProc "
		*	cSQL = cSQL+" FROM dbo.Ar_BrokerLst_Detail_History WITH(NOLOCK) "
		*	cSQL = cSQL+" WHERE ID_Detail_Process = "+ STR(pID_Detail_Process)
			
			cSQL = " SELECT SUM(QTY) AS TotProc "
			cSQL=cSQL+" FROM dbo.StockLst_Process_Grab WITH(NOLOCK) "
			IF nWO > 0
				cSQL=cSQL+" WHERE WO="+STR(nWO)
			ELSE
				cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF
			cSQL=cSQL+" AND Process_ID = 'SELECTED  '"
				
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				SELECT tmpDetail_Process_Report
				nChange = tmpDetail_Process_Report.TotProc
		
				IF ISNULL(nChange)
					nChange = 0
				ENDIF
				nChange = -( nChange )
				IF nChange = 0 
		*			MESSAGEBOX("There was no cost, or change in cost to apply to this order item from this Process."+CHR(13)+;
						"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
				ELSE
		*			MESSAGEBOX("The cost to apply to this order item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process."+CHR(13)+;
						"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
				ENDIF
			ENDIF
		
			IF USED("tmpDetail_Process_Report")
				USE IN tmpDetail_Process_Report
			ENDIF
		ENDIF
		
		PRIVATE cSOitem, nWO
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		******** Look for Other Process on this pSOItem
		IF TYPE("pSOitem") = "C"
			IF !EMPTY(pSOItem)
				SELECT 0
				
		*		cSQL =  "SELECT SUM(ProcessValue) AS TotProc "
		*		cSQL = cSQL+" FROM dbo.Ar_BrokerLst_Detail_History  WITH(NOLOCK)"
		*		cSQL = cSQL + " WHERE ID_Detail_Process IN (SELECT ID_Detail_Process FROM dbo.BrokerLst_process "
		*		*cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pSOItem + "'))"
		*		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pSOItem + "'))"
			
				cSQL = " SELECT SUM(QTY) AS TotProc "
				cSQL=cSQL+" FROM dbo.StockLst_Process_Grab WITH(NOLOCK) "
				IF nWO > 0
					cSQL=cSQL+" WHERE WO="+STR(nWO)
				ELSE
					cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+pSOitem+"')"
				ENDIF
				cSQL=cSQL+" AND Process_ID = 'SELECTED  '"
			
			
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					SELECT tmpDetail_Process_Report
					nChange = tmpDetail_Process_Report.TotProc
					IF ISNULL(nChange)
						nChange = 0
					ENDIF
					nChange = -( nChange )
					IF nChange = 0
						* First zero Message was enough
					ELSE
		*				nMess = MESSAGEBOX("The cost to apply to this Sales Order Item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process.",4+32,"Sales Order Item Total")
					ENDIF
					
		*********** Update Sales Record!!!
					IF nMess = 6 &&Yes 
						IF TYPE("pSOItem") = "C"
					
							*UPDATE HPA!Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)
							IF Proper_SO_Item(pSOItem) != Proper_SO_Item("")
								Save_ItemCostinSales( nChange, pSOitem, ThisForm.nConnHandle )
							ELSE
								RecordError(0,"Not Associated with a Sales Order Item!",PROGRAM(),LINENO(1),"UPDATE Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)","frmShop_BrokerLst_Edit.Modify_BrokerLst_Detail_Report")
							ENDIF				
						ELSE
							RecordError(0,"Not Associated with a Sales Order Item!",PROGRAM(),LINENO(1),"UPDATE Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)","frmShop_BrokerLst_Edit.Modify_BrokerLst_Detail_Report")
						ENDIF
					ENDIF
				ENDIF &&nSQLEXEC
			ELSE
				MESSAGEBOX('Could NOT Calc for SOitem',0,"Empty SOitem!")
			ENDIF &&!EMPTY(pSOItem)
		ELSE
			MESSAGEBOX('Could NOT Calc for SOitem',0,"Empty SOitem!")
		ENDIF &&TYPE("pSOitem") = "C"
			
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		
	ENDPROC

	PROCEDURE modify_stocklst_detail
		PARAMETER cHow
		*ThisForm.Modify_StockLst_Detail( "EDIT" )
		*Also used in Shop_StockLst_Edit
		
		DO CASE
		CASE cHow = "DEL" OR cHow = "SAVE" OR cHow = "ABORT"
		
			IF ThisForm.txtQuarantine.Visible
				ThisForm.cmdConsumeStock.ENABLED = .F.
				ThisForm.cmdEdit.ENABLED = .F.
				ThisForm.cmdAdd.ENABLED = .F.
				
				ThisForm.cmdAbort.ENABLED = .T.
			ELSE
				ThisForm.cmdConsumeStock.ENABLED = .T.
				ThisForm.cmdEdit.ENABLED = .T.
				ThisForm.cmdAdd.ENABLED = .T.
				
				ThisForm.cmdAbort.ENABLED = .F.
			ENDIF
			ThisForm.cmdDone.ENABLED = .T.
			ThisForm.cmdSave.ENABLED = .F.
				
		*	ThisForm.cfrmModifyStockLst.mdReset.ENABLED = .F.
		
			ThisForm.txtPc1.ENABLED = .F.
