				    cSQLid = cSQLid+ ",Alloy='"+cAlloy+"'"
					cSQLid = cSQLid+ ",Form='"+cForm+"'"
					cSQLid = cSQLid+ ",Heat='"+cHeat+"'"
					cSQLid = cSQLid+ ",Lot='"+cLot+"'"
					cSQLid = cSQLid+ ",CC='"+cCC+"'"
					cSQLid = cSQLid+ ",CL='"+cCL+"'"
					cSQLid = cSQLid+ ",RandLen="+IIF(lRandLen,'1','0')
					
					cSQLid = cSQLid+ ",Orig_PC="+STR(nStk_PC)  &&Orig
					cSQLid = cSQLid+ ",Orig_Dim1="+STR(nStk_Dim1,18,4)
					cSQLid = cSQLid+ ",Orig_Dim2="+STR(nStk_Dim2,17,3)
					cSQLid = cSQLid+ ",Orig_Dim3="+STR(nStk_Dim3,17,3)
					cSQLid = cSQLid+ ",Orig_LBS="+STR(nStk_LBS,15,1)
					cSQLid = cSQLid+ ",Orig_Qty="+STR(nStockLst_Qty,18,4)		
					cSQLid = cSQLid+ ",Orig_P="+STR(nStockLst_P,18,4)
					cSQLid = cSQLid+ ",Orig_PU="+STR(nStockLst_PU)
					
					*cSQLid = cSQLid + ",Sales_Detail_ID="+STR(nSales_Detail_ID)
						
					cSQLid = cSQLid+ ",StkPaid_P="+STR(nStkPaid_P,18,4)
					cSQLid = cSQLid+ ",StkPaid_Total="+STR(nRemoved_Paid_Total,18,4)
					
					cSQLid = cSQLid+ ",Left_PC="+STR(nStk_PC,10)  &&Orig
					cSQLid = cSQLid+ ",Left_Dim1="+STR(nStk_Dim1,10,4)
					cSQLid = cSQLid+ ",Left_Dim2="+STR(nStk_Dim2,9,3)
					cSQLid = cSQLid+ ",Left_Dim3="+STR(nStk_Dim3,9,3)
					cSQLid = cSQLid+ ",Left_LBS="+STR(nStk_LBS,9,1)
					cSQLid = cSQLid+ ",Left_QTY="+STR(nStk_QTY,18,4)
					
					cSQLid = cSQLid+ ",WO="+STR(nWO)	
					cSQLid = cSQLid+ ",WO_Detail="+STR(nWO_Detail)
					cSQLid = cSQLid+ ",'"+ cUseredit +"'"
					
					cSQLid = cSQLid+ " WHERE ID="+STR(nSales_Stock_ID)
					
					PRIVATE cMessTitle
					cMessTitle = "Found Sales_Stock from PackingSlip!?!"+" Sales_Stock.ID="+STR(nSales_Stock_ID)
					TrackError(cMessTitle+" "+CHR(13)+cSQLid,cMessTitle,PROGRAM(),LINENO(1))
					RecordTest('Record Test Data.',PROGRAM(),LINENO(1),cMessTitle+" "+CHR(13)+cSQLid)
				ENDIF
					
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLid, ThisForm.nConnHandle,nSQLEXEC)
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLid )
					lOK =.F.
				ELSE
					IF nSales_Stock_ID = 0
						*Get nSales_Stock_ID
						
						IF USED('tmpSales_Stock_ID')
							USE IN tmpSales_Stock_ID
						ENDIF
						
						cSQL = "SELECT ID FROM dbo.Sales_Stock  WITH(NOLOCK) WHERE "
						cSQL=cSQL+" StockLst_Qty="+STR(nStockLst_Qty,18,4)
						
		*				cSQL=cSQL+" AND [StockLst_POitem]= dbo.f_ProperPOitem('"+cPOitem+"')"
		*				cSQL=cSQL+" AND Consumed=1" &&Consumed  -------------------------
		*				cSQL=cSQL+" AND StkBack=0" &&StkBack
						cSQL=cSQL+" AND StockEdit=GetDate()" &&StockEdit
						cSQL=cSQL+" AND TBL='"+IIF(cTBL="S","S",IIF(cTBL="B","B","W"))+"'"
						cSQL=cSQL+" AND StockLst_ID="+STR(nID)
						cSQL=cSQL+" AND StockLst_ID_Detail="+STR(nID_Detail)
						cSQL=cSQL+" AND ID_Detail_Process="+STR(nID_Detail_Process)
						cSQL=cSQL+" AND Removed_PC="+STR(nRemoved_PC,10)
						cSQL=cSQL+" AND Removed_Dim1="+STR(nRemoved_Dim1,10,4)
						cSQL=cSQL+" AND Removed_Dim2="+STR(nRemoved_Dim2,9,3)
						cSQL=cSQL+" AND Removed_Dim3="+STR(nRemoved_Dim3,9,3)
				    	cSQL=cSQL+" AND Removed_QTY="+STR(nRemoved_Qty,18,4)
				    	cSQL=cSQL+" AND Removed_LBS="+STR(nRemoved_LBS,9,1)
				    	cSQL=cSQL+" AND Removed_Paid_Total="+STR(nRemoved_Paid_Total,18,4)
				    	cSQL=cSQL+" AND Removed_Total="+STR(nRemoved_Total,18,4)
				    
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Stock_ID' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Stock_ID' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Stock_ID')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Stock_ID')
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Stock_ID")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Stock_ID")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL , ThisForm.nConnHandle,nSQLEXEC,'tmpSales_Stock_ID')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						ENDIF
		
						IF USED('tmpSales_Stock_ID')
							IF RECCOUNT('tmpSales_Stock_ID') > 0
								nSales_Stock_ID = PrepareSQLnum(tmpSales_Stock_ID.ID,'Sales_Stock_ID',-3)
							ENDIF
							USE IN tmpSales_Stock_ID
						ENDIF
		
		
				
					ENDIF
				ENDIF
			ENDSCAN
		ENDIF
		*now have nSales_Stock_ID
		
		**************************
		*get ReceivingID
		PRIVATE nReceivingID, nS_QTY, nS_P, nS_Total, nMaster_ID
		nReceivingID = 0
		nS_QTY	= 0
		nS_P	= 0
		nS_Total= 0
		nMaster_ID = 0
		
		IF lOK 
		*	SELECT tmpStkSum
		*	SCAN
				IF USED("tmpID_Detail_Qty")
					USE IN tmpID_Detail_Qty
				ENDIF
				SELECT 0
		
				cSQL = "SELECT ID,ReceivingID,S_QTY,S_P,S_Total,[Weight] FROM "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Detail WITH(NOLOCK) "
				CASE cTBL = "B"
					cSQL = cSQL + " dbo.StockLst_Detail WITH(NOLOCK) "
				CASE cTBL = "W"
					cSQL = cSQL + " dbo.StockLst_Detail WITH(NOLOCK) "
				ENDCASE
				
				cSQL = cSQL + " WHERE ID_Detail ="+STR(nID_Detail)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpID_Detail_Qty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpID_Detail_Qty")
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Qty')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Qty')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Qty")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Qty")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpID_Detail_Qty")
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
				IF USED('tmpID_Detail_Qty')
					IF RECCOUNT('tmpID_Detail_Qty') > 0
						nReceivingID = PrepareSQLnum(tmpID_Detail_Qty.ReceivingID,'ReceivingID',-3)
						nS_QTY	= PrepareSQLnum(tmpID_Detail_Qty.S_QTY,'S_QTY',-3)
						nS_P	= PrepareSQLnum(tmpID_Detail_Qty.S_P,'S_P',-3)
						nS_Total= PrepareSQLnum(tmpID_Detail_Qty.S_Total ,'S_Total',-3)
						nMaster_ID = PrepareSQLnum(tmpID_Detail_Qty.ID,'Master_ID',-3)
					ENDIF
					USE IN tmpID_Detail_Qty
				ENDIF
			*ENDSCAN	
		ENDIF
			
		*nOrig_QTY	= PrepareSQLnum(tmpStk_QTY.S_QTY,'QTY',18,4)
		*nOrig_LBS	= PrepareSQLnum(tmpStk_QTY.Weight,'LSB',8,1)	
		
		************************************************************************************************************************************
		* INSERT INTO dbo.Sales_Detail
		* when there is no past record
		************************************************************************************************************************************
		PRIVATE cSQLid, nReturnPackingSli
		nReturnPackingSli = 0
		IF lOK
			*Get AllQuote date, INSERT InTO Sales_Detail
			PRIVATE nSalesNum
			nSalesNum = VAL(cSOitem)
			
			PRIVATE nQuoted_PC,nQuoted_Dim1,nQuoted_LBS,nQuoted_Qty
			*Default to tmpStkSum, if found in Allquotes, Overwrite.
			
			SELECT tmpStkSum
			SCAN
			
				nRemoved_PC		= PrepareSQLnum(tmpStkSum.PCs,'PC',-3)
				nRemoved_Dim1	= PrepareSQLnum(tmpStkSum.Dim1,'Dim1',10,4)
				nRemoved_Dim2	= PrepareSQLnum(tmpStkSum.Dim2,'Dim2',9,3)
				nRemoved_Dim3	= PrepareSQLnum(tmpStkSum.Dim3,'Dim3',9,3)
				nRemoved_Qty	= PrepareSQLnum(tmpStkSum.QTY,'QTY',-5)
				nRemoved_LBS	= PrepareSQLnum(tmpStkSum.Weight,'LBS',9,1)
				
				**
				IF nRemoved_LBS = 0
					DO CASE
					CASE nStockLst_PU = 1
						*LBS is QTY
						nRemoved_LBS	= nRemoved_Qty
					CASE nStockLst_PU = 2
						*Calc /FT weight
					 	*nRemoved_LBS = CalcWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					 	nRemoved_LBS = GetWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					CASE nStockLst_PU = 3
						*Calc /PC Weight
					 	*nSale_LBS = GetWeight(nStk_PC, cAlloy, cForm, nStk_Dim1, nStk_Dim2, nStk_Dim3, ThisForm.nConnHandle)
					 	*No weight chart ready fasteners/fittings
						nRemoved_LBS	= nRemoved_PC
					OTHERWISE
						nRemoved_LBS= 0
					ENDCASE
				ENDIF
				**
				
				IF nRemoved_Qty = 0
					nRemoved_Total	= nRemoved_LBS * nStockLst_P
				ELSE
					nRemoved_Total	= nRemoved_Qty * nStockLst_P
				ENDIF
					
				*Go to AllQuotes for Values
				IF USED('tmpAQpc')
					USE IN tmpAQpc
				ENDIF
				SELECT 0
				
				cSQL = "SELECT [Pieces] AS PC, [Thck] AS Dim1, [Weight], dbo.f_Get_QTY_SOitem(SOitem) as Quoted_QTY, cWeight "
				cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQpc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQpc' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQpc' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQpc'  )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQpc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQpc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL , ThisForm.nConnHandle,nSQLEXEC,'tmpAQpc')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
				
				IF USED('tmpAQpc')
					IF RECCOUNT('tmpAQpc')>0
						nQuoted_PC	= PrepareSQLnum(tmpAQpc.PC,'PC',-3)
						nQuoted_Dim1= PrepareSQLnum(tmpAQpc.Dim1,'Dim1',10,4)
						nQuoted_LBS	= PrepareSQLnum(tmpAQpc.Weight,'Weight',9,1)
						nQuoted_Qty	= PrepareSQLnum(tmpAQpc.Quoted_QTY,'Quoted_QTY',-5)
						nQuoted_LBS	= PrepareSQLnum(tmpAQpc.cWeight,'cWeight',-5)
					ENDIF
					USE IN tmpAQpc
				ENDIF
				*WAIT WINDOW cSOitem NOWAIT		
				IF NOT ( Proper_SO_Item(cSOitem) = Proper_SO_Item('') AND nWO = 0 )
					
					cSQLid = "INSERT INTO dbo.Sales_Detail ("
					cSQLid = cSQLid+ " SOitem"   
					cSQLid = cSQLid+ ",SalesNum"
					cSQLid = cSQLid+ ",WO"
					
					cSQLid = cSQLid+ ",Quoted_PC"
					cSQLid = cSQLid+ ",Quoted_Dim1"
					cSQLid = cSQLid+ ",Quoted_LBS"
					cSQLid = cSQLid+ ",Quoted_Qty"
					
					cSQLid = cSQLid+ ",StockLst_Qty"
					cSQLid = cSQLid+ ",StockLst_P"
					cSQLid = cSQLid+ ",StockLst_Total"
					cSQLid = cSQLid+ ",StockLst_PU"
					
					cSQLid = cSQLid+ ",StockLst_PC"
					cSQLid = cSQLid+ ",StockLst_Dim1"
					cSQLid = cSQLid+ ",StockLst_Dim2"
					cSQLid = cSQLid+ ",StockLst_Dim3"
				    cSQLid = cSQLid+ ",StockLst_LBS"
		
					cSQLid = cSQLid+ ",Removed_PC"
					cSQLid = cSQLid+ ",Removed_Dim1"
					cSQLid = cSQLid+ ",Removed_Dim2"
					cSQLid = cSQLid+ ",Removed_Dim3"
				    cSQLid = cSQLid+ ",Removed_LBS"
				    cSQLid = cSQLid+ ",Removed_Qty"
				    cSQLid = cSQLid+ ",Removed_Paid_Total"
				    cSQLid = cSQLid+ ",Removed_Total"
				    
					cSQLid = cSQLid+ ",Alloy"
					cSQLid = cSQLid+ ",Form"
					cSQLid = cSQLid+ ",Heat"
					cSQLid = cSQLid+ ",Lot"
				    cSQLid = cSQLid+ ",CC"
					cSQLid = cSQLid+ ",CL"
		
					cSQLid = cSQLid+ ",TBL"
					cSQLid = cSQLid+ ",StockLst_ID"
					cSQLid = cSQLid+ ",StockLst_ID_Detail"
					cSQLid = cSQLid+ ",ID_Detail_Process"
					
					cSQLid = cSQLid+ ",Sales_Stock_ID"
				    cSQLid = cSQLid+ ",StockEdit"
				    
					cSQLid = cSQLid+ ",StkPaid_P"
					cSQLid = cSQLid+ ",StkPaid_Total"
		
					cSQLid = cSQLid+ ") VALUES ("
					cSQLid = cSQLid+ "'"+cSOitem+"'"
					cSQLid = cSQLid+ ","+STR(nSalesNum)
					cSQLid = cSQLid+ ","+STR(nWO)
		
					cSQLid = cSQLid+ ","+STR(nQuoted_PC)
					cSQLid = cSQLid+ ","+STR(nQuoted_Dim1,10,4)
					cSQLid = cSQLid+ ","+STR(nQuoted_LBS,9,1)
					cSQLid = cSQLid+ ","+STR(nQuoted_Qty,18,4)
		
					cSQLid = cSQLid+ ","+STR(nStockLst_QTY,18,4)
					cSQLid = cSQLid+ ","+STR(nStockLst_P,18,4)
					cSQLid = cSQLid+ ","+STR(nRemoved_Total,18,4)
					cSQLid = cSQLid+ ","+STR(nStockLst_PU)		
		
					cSQLid = cSQLid+ ","+STR(tmpStkSum.PCs,10)
					cSQLid = cSQLid+ ","+STR(tmpStkSum.Dim1,10,4)
					cSQLid = cSQLid+ ","+STR(tmpStkSum.Dim2,9,3)
					cSQLid = cSQLid+ ","+STR(tmpStkSum.Dim3,9,3)
				    cSQLid = cSQLid+ ","+STR(tmpStkSum.Weight,9,1)
		
					cSQLid = cSQLid+ ","+STR(nRemoved_PC,10,0)
					cSQLid = cSQLid+ ","+STR(nRemoved_Dim1,10,4)
					cSQLid = cSQLid+ ","+STR(nRemoved_Dim2,9,3)
					cSQLid = cSQLid+ ","+STR(nRemoved_Dim3,9,3)
				    cSQLid = cSQLid+ ","+STR(nRemoved_LBS,9,1)
				    cSQLid = cSQLid+ ","+STR(nRemoved_Qty,18,4)
				    cSQLid = cSQLid+ ","+STR(nRemoved_Paid_Total,18,4)
					cSQLid = cSQLid+ ","+STR(nRemoved_Total,18,4)
		
					cSQLid = cSQLid+ ",'"+cAlloy+"'"
					cSQLid = cSQLid+ ",'"+cForm+"'"
					cSQLid = cSQLid+ ",'"+cHeat+"'"
					cSQLid = cSQLid+ ",'"+cLot+"'"
				    cSQLid = cSQLid+ ",'"+cCC+"'"
				    cSQLid = cSQLid+ ",'"+cCL+"'"
				    
					cSQLid = cSQLid+ ",'"+IIF(UPPER(cTbl)="S","S","B")+"'"
					cSQLid = cSQLid+ ","+STR(nID)
					cSQLid = cSQLid+ ","+STR(nID_Detail)
					cSQLid = cSQLid+ ","+STR(nID_Detail_Process)
					cSQLid = cSQLid+ ","+STR(nSales_Stock_ID)
				    cSQLid = cSQLid+ ",GetDate()" &&StockEdit
				    		
					cSQLid = cSQLid+ ","+STR(nStkPaid_P,18,4)
					cSQLid = cSQLid+ ","+STR(Removed_Paid_Total,18,4)
					cSQLid = cSQLid+ ")"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQLid, ThisForm.nConnHandle,nSQLEXEC)
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLid )
						*lOK = .F.
					ENDIF
					
					***********************************************
					*WAIT WINDOW cSOitem NOWAIT
					IF Proper_SO_Item(cSOitem) = Proper_SO_Item('')
						IF USED('tmpSales_Detail_PackingSlip')
							USE IN tmpSales_Detail_PackingSlip 
						ENDIF
						
						*See if PackingSlip is found
						cSQL = "SELECT COUNT(*) AS CNTD "
						cSQL = cSQL +" FROM dbo.Sales_Detail_PackingSlip WITH(NOLOCK) "
						cSQL = cSQL +" WHERE SOitem = '"+cSOitem+"'"
						*cSQL = cSQL +" Heat = '"+cHeat+"'"
						*cSQL = cSQL +" Lot = '"+cLot+"'"
						
						SELECT 0
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_PackingSlip')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_PackingSlip')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_PackingSlip')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_PackingSlip')
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Detail_PackingSlip")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Detail_PackingSlip")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Detail_PackingSlip')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						ENDIF
						IF USED('tmpSales_Detail_PackingSlip')
							IF RECCOUNT('tmpSales_Detail_PackingSlip')>0
								
								MESSAGEBOX("Found Packing Slip record for this SOitem '"+cSOitem+"'"+CHR(13)+"View the records now and correct for Accounting."+CHR(13)+"Connect this SO Item Stock edit to the Proper Packing Slip. "+CHR(13)+"If you find a match, select the Packing Slip record with this 'Removed Stock'."+CHR(13)+"A new window will open.",64,"Select the Packing Slip records with this Sales_Detail.")
								DO FORM Forms\ChooseSD_PackingSli WITH cSOitem, nSales_Stock_ID TO nReturnPackingSli
								*"UPDATE dbo.Sales_Detail SET RMA_Detail_ID = "+STR(nRMA_Detail_ID)
								*ThisForm.HoldNumber = nPackingSli    -nReturnPackingSli is not used here???
							ENDIF
							USE IN tmpSales_Detail_PackingSlip
						ENDIF
		
					ELSE
						*No PackingSlip on WorkOrder
					ENDIF
					***********************************************
				ENDIF
			ENDSCAN
		ENDIF
		
		IF lOK 
			*WAIT WINDOW cSOitem NOWAIT
			IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
				** Sales_Cost Delete and Update have a trigger! 
				** no after insert trigger!
				
				**Update Sales with the new Sales_Stock Cost data!
				*cSQL = "EXEC dbo.p_Sales_Stock_UPDATE_Sales( dbo.f_ProperSOitem('"+cSOitem+"') )"
				cSQL = "EXEC dbo.p_Sales_Stock_UPDATE_Sales '"+cSOitem+"'"
				
		*!*	SET @StkCost_Sales = ISNULL(dbo.f_CalcStkCost_Sales_Stock(@SOitem),0)
		*!*	SELECT @StkCost_Select = ISNULL(dbo.f_CalcStkCost_SOitem(@SOitem),0)
		*!*	SELECT @POCost = ISNULL(dbo.f_CalcPOCost_SOitem(@SOitem),0)
		*!*	SELECT @ItemCost = ( @StkCost_Select + @StkCost_Sales + @POCost )
		
		*!*	UPDATE dbo.Sales
		*!*		SET ItemCost = @ItemCost
		*!*		,StkCost = ( @StkCost_Select + @StkCost_Sales )
		*!*		,POCost = @POCost
			
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
				
			ENDIF	
		ENDIF
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE save_workorder_stock		&& Save_WorkOrder_Stock
		*ThisForm.Save_WorkOrder_Stock
		
		PRIVATE nID, nID_Detail, nID_Detail_Process
		nID					= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail			= ThisForm.nID_Detail
		nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3,0)
		
		PRIVATE nWO, cTBL
		nWO	= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3,0)
		cTBL= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		
		IF nWO = 0
			RETURN .T.
			*Nothing to do here
		ENDIF
		IF ThisForm.Saved_WorkOrder_Stock
			*already Saved!!!
			RETURN .T.
		ENDIF
		
		
		PRIVATE nReceivingID, nS_QTY, nS_P, nS_Total
		nReceivingID = 0
		nS_QTY	= 0
		nS_P	= 0
		nS_Total= 0
		
		
		IF USED("tmpID_Detail_Qty")
			USE IN tmpID_Detail_Qty
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ID,ReceivingID,S_QTY,S_P,S_Total "
		DO CASE	&&Should this ALL be for StockLst ????????????????????
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Detail "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.StockLst_Detail "
			*cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.StockLst_Detail "
			*cSQL = cSQL + " FROM dbo.WIPLst_Detail "
		ENDCASE
		
		cSQL = cSQL + " WHERE ID_Detail ="+STR(nID_Detail)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpID_Detail_Qty")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpID_Detail_Qty")
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Qty")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Qty")
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Qty")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Qty")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpID_Detail_Qty")
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpID_Detail_Qty')
			IF RECCOUNT('tmpID_Detail_Qty') > 0
				nReceivingID = PrepareSQLnum(tmpID_Detail_Qty.ReceivingID,'ReceivingID',-3)
				nS_QTY	= PrepareSQLnum(tmpID_Detail_Qty.S_QTY,'S_QTY',-3)
				nS_P	= PrepareSQLnum(tmpID_Detail_Qty.S_P,'S_P',-3)
				nS_Total= PrepareSQLnum(tmpID_Detail_Qty.S_Total ,'S_Total',-3)
				nMaster_ID = PrepareSQLnum(tmpID_Detail_Qty.ID,'Master_ID',-3)
			ENDIF
			USE IN tmpID_Detail_Qty
		ENDIF
		
		IF nWO > 0
		
			cSQL = "INSERT INTO dbo.WorkOrder_Stock "
			cSQL = cSQL +" (WO,sTBL,sMaster_ID,sID_Detail,sID_Detail_Process,sReceivingID"
			cSQL = cSQL +" ,S_QTY,S_P,S_Total,stkConsumed,[what]) VALUES ( "
			cSQL = cSQL +" "+STR(ThisForm.nWO)
			cSQL = cSQL +",'"+cTBL+"'"
			cSQL = cSQL +","+STR(nMaster_ID)
			cSQL = cSQL +","+STR(nID_Detail)
			cSQL = cSQL +","+STR(nID_Detail_Process)
			cSQL = cSQL +","+STR(nReceivingID)
			cSQL = cSQL +","+STR(nS_QTY,18,4)
			cSQL = cSQL +","+STR(nS_P,18,4)
			cSQL = cSQL +","+STR(nS_Total,18,4)
			cSQL = cSQL +",1"
			cSQL = cSQL +",'WO Consume'"
			cSQL = cSQL +")"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				ThisForm.Saved_WorkOrder_Stock = .T.
			ENDIF
		
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE showordered
		PARAMETERS pWhat
		
		ThisForm.lblOrder.Visible = .F.
		ThisForm.txtQPc.Visible = .F.
		ThisForm.txtQDIM1.Visible = .F.
		ThisForm.txtQDIM2.Visible = .F.
		ThisForm.txtQDIM3.Visible = .F.
		ThisForm.txtQQTY.Visible = .F.
		ThisForm.txtQWeight.Visible = .F.
		
		IF NOT (pWhat = "SOitem" OR pWhat = "WO")
			RETURN .T.
		ENDIF
		
		
		
		IF USED("tmpStock_Ordered")
			SELECT tmpStock_Ordered
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE cSQLpID, nSQLEXEC 
		IF pWhat = "SOitem" 
			cSQLpID = "SELECT [Pieces],[Thck],[Sz2],[Sz3],[S_QTY],[Weight] "
			cSQLpID = cSQLpID + " FROM dbo.AllQuotes WITH (NOLOCK) "
			cSQLpID = cSQLpID + " WHERE SOitem = '"+ThisForm.cSOitem+"'"
		ENDIF
		IF pWhat = "WO"
			cSQLpID = "SELECT [sPieces] AS Pieces, [sThck] AS Thck, [sSz2] AS Sz2, [sSz3] AS Sz3, [sWeight] AS S_Qty, [sWeight] AS Weight"
			cSQLpID = cSQLpID + " FROM dbo.WorkOrder WITH (NOLOCK) "
			cSQLpID = cSQLpID + " WHERE WO = "+STR(ThisForm.nWO)
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'tmpStock_Ordered')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'tmpStock_Ordered')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'tmpStock_Ordered')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'tmpStock_Ordered')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, "tmpStock_Ordered")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, "tmpStock_Ordered")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		PRIVATE lQuarantine
		lQuarantine = .F.
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQLpID, ThisForm.nConnHandle, nSQLEXEC, 'tmpStock_Ordered' )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLpID)
		ELSE
			IF USED("tmpStock_Ordered")
				SELECT tmpStock_Ordered
				
				ThisForm.lblOrder.Visible = .T.
				ThisForm.txtQPc.Visible = .T.
				ThisForm.txtQDIM1.Visible = .T.
				ThisForm.txtQDIM2.Visible = .T.
				ThisForm.txtQDIM3.Visible = .T.
				ThisForm.txtQQTY.Visible = .T.
				ThisForm.txtQWeight.Visible = .T.
				
				ThisForm.txtQPc.Value = PrepareSQLnum(tmpStock_Ordered.Pieces,'Pc',-3)
				ThisForm.txtQDIM1.Value = PrepareSQLnum(tmpStock_Ordered.Thck,'Dim1',-5)
				ThisForm.txtQDIM2.Value = PrepareSQLnum(tmpStock_Ordered.Sz2,'Dim2',-5)
				ThisForm.txtQDIM3.Value = PrepareSQLnum(tmpStock_Ordered.Sz3,'Dim3',-5)
				ThisForm.txtQQTY.Value 	 = PrepareSQLnum(tmpStock_Ordered.S_QTY,'QTY',-5)
				ThisForm.txtQWeight.Value = PrepareSQLnum(tmpStock_Ordered.Weight,'Weight',9,1)
			
				USE IN tmpStock_Ordered
			ENDIF
		ENDIF
	ENDPROC

