								ENDIF
								
								SELECT 0
								
								cSQL = "SELECT "
		
								cSQL = cSQL + " P.SOitem"
								cSQL = cSQL + ",CAST(P.SOitem as CHAR(7) ) AS cSalesNum"
								cSQL = cSQL + ",P.QTY AS S_QTY"
								cSQL = cSQL + ",D.S_P AS S_P"
								cSQL = cSQL + ",(P.QTY * D.S_P) AS S_Total"
		
								cSQL = cSQL + ",P.QTY AS StockLst_LBS"
								cSQL = cSQL + ",P.PO_Item AS StockLst_POitem"
								
		*--,Pick_P,Pick_Total,Pick_PU,Pick_PC,Pick_Dim1,Pick_Dim2,Pick_Dim3,Pick_LBS,Pick_QTY
		*--,Edited,Added,Consumed,StkBack,Scrap,StockEdit
		*--,RecDate	--Keep as the PackingSlip Recorded DateTime!
		
								cSQL = cSQL + ",D.ID AS StockLst_ID"
								cSQL = cSQL + ",D.ID_Detail AS StockLst_ID_Detail"
								cSQL = cSQL + ",ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process "
								
		*--,Removed_PC,Removed_Dim1,Removed_Dim2,Removed_Dim3,Removed_QTY,Removed_LBS,Removed_Paid_Total
		
								cSQL = cSQL + ",M.Alloy"	&&Keep as the PackingSlip Recorded 
								cSQL = cSQL + ",M.Form"		&&Keep as the PackingSlip Recorded 
								cSQL = cSQL + ",M.Heat"
								cSQL = cSQL + ",M.Lot"		&&Keep as the PackingSlip Recorded 
								cSQL = cSQL + ",M.CC"		&&Keep as the PackingSlip Recorded 
								cSQL = cSQL + ",M.CL"		&&Keep as the PackingSlip Recorded 
		
								cSQL = cSQL + ",AQ.RandLen"
						
		*--,Shipped
								cSQL = cSQL + ",D.Pc"
								cSQL = cSQL + ",D.Dim1"
								cSQL = cSQL + ",D.Dim2"
								cSQL = cSQL + ",D.Dim3"
								cSQL = cSQL + ",D.Weight"
								cSQL = cSQL + ",D.S_QTY"
		*--,Sales_Detail_ID
							
								cSQL = cSQL + ",M.Paid"	&& AS StkPaid_P"
								cSQL = cSQL + ",M.Paid*P.QTY "	&&AS StkPaid_Total"
								*cSQL = cSQL + "--,PackingSli"		&&Keep as the PackingSlip Recorded 
						
		*--,Left_PC,Left_Dim1,Left_Dim2,Left_Dim3,Left_LBS,Left_QTY
										
								cSQL = cSQL + ",AQ.POitem"
								cSQL = cSQL + ",AQ.BuyFrom"
								cSQL = cSQL + ",AQ.BuyCost"
								cSQL = cSQL + ",AQ.BuyFrom2"
								cSQL = cSQL + ",AQ.HPApo2"
								
								cSQL = cSQL + ",ISNULL(P.WO_Detail,0)"	&& AS WO_Detail "
														
								DO CASE
								CASE cTBL = "S"
									cSQL = cSQL + ",'S' AS TBL, D.WO "
									cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.Stocklst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.AllQuotes AQ WITH(NOLOCK) ON P.SOitem = AQ.SOitem AND NOT P.SOitem IS NULL"
								CASE cTBL = "B"
									cSQL = cSQL + ",'B' AS TBL, 0 AS WO "
									cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.Brokerlst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.AllQuotes AQ WITH(NOLOCK) ON P.SOitem = AQ.SOitem AND NOT P.SOitem IS NULL"
								CASE cTBL = "W"
									cSQL = cSQL + ",'W' AS TBL, 0 AS WO "
									cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.WIPlst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.AllQuotes AQ ON P.SOitem = AQ.SOitem AND NOT P.SOitem IS NULL"
								ENDCASE
								cSQL = cSQL + " WHERE D.ID_Detail="+STR(nID_Detail)
								cSQL = cSQL + " AND ( ISNULL(P.Process_ID,'SELECTED')='SELECTED' OR ISNULL(P.Process_ID,'')='PARTSELECT' )"
											
