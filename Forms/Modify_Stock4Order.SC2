	PROCEDURE calc_stockdetail_3
		PARAMETERS pWhat
		*ThisForm.Calc_StockDetail_3
		*ThisForm.reCalc_QTY('QTY')
		
		PRIVATE nCalcQTY, nCalcLBS, nPieces, cAlloy, cForm, nSize1, nSize2, nSize3
		nPieces	= PrepareSQLnum(ThisForm.txtPC3.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		cForm3	= PrepareSQLtxt(ThisForm.txtForm3.Value,'Form',2)
		nSize1	= PrepareSQLnum(ThisForm.txtDim13.Value,'DIM1',10,4)
		nSize2	= PrepareSQLnum(ThisForm.txtDim23.Value,'DIM2',9,3)
		nSize3	= PrepareSQLnum(ThisForm.txtDim33.Value,'DIM3',9,3)
		
		IF EMPTY(cForm3)
			cForm3 = cForm
		ENDIF
		
		nCalcQTY = GetUnitQty(nPieces, cAlloy, cForm3, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		*nWeight = CalcWeight(nPieces, cAlloy, cForm3, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		nCalcLBS = GetWeight(nPieces, cAlloy, cForm3, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		
		*INSERT INTO tmpStkSum (PCs, Dim1, Dim2, Dim3, QTY, Weight) ;
		SELECT tmpStkSum
		
		PRIVATE nCurRec, nRecNo3
		
		IF USED('tmpStkSum')
			nCurRec = RECNO('tmpStkSum')
			nRecNo3	= PrepareSQLnum(ThisForm.txtRecNo3.Value,'RecNo',-3)
		
			IF nCurRec <> nRecNo3
				IF nRecNo3 > 0 
					IF nRecNo3 <= RECCOUNT('tmpStkSum')
						GOTO nRecNo3 
					ENDIF
				ENDIF
			ENDIF
		
			****************
			IF nCalcQTY > 0
				ThisForm.txtQTY3.Value = nCalcQTY
				ThisForm.EnterQTY3 = .T.
				REPLACE QTY  WITH nCalcQTY
			ENDIF
		
			****************
			IF nCalcLBS > 0
				ThisForm.txtWeight3.Value = nCalcLBS
				REPLACE Weight WITH nCalcLBS
			ENDIF
		ENDIF
		
		ThisForm.txtQTY3.Value = nCalcQTY
		ThisForm.txtWeight3.Value = nCalcLBS
		
		ThisForm.EnterWeight3 = .T.
		
	ENDPROC

	PROCEDURE checksave
		
		PRIVATE cSQL, cSQLs, cSQLid, cSQLdd, nSQLEXEC 
		PRIVATE nID, m.nID1,m.nID_Detail,m.nID_Detail_Process
		nID 			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		m.nID1 			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		m.nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		m.nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		IF m.nID1 = 0 
			MESSAGEBOX("Can not Change!",4,"Lost StockLst ID!")
			TrackError("No ID_Detail value","frmModiStockLst.cmdSave()",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF m.nID_Detail = 0 AND NOT lScrapOverRide 
			MESSAGEBOX("Can not Change!",4,"Lost StockLst ID_Detail!")
			TrackError("No ID_Detail value","frmModiStockLst.cmdSave()",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE cTbl
		cTbl = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		
		IF TYPE("cTbl") <> "C"
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			TrackError("No TBL value","Lost 'Tbl' !",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF EMPTY(cTbl)
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			TrackError("no TBL value","Lost 'Tbl' !",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		*- Needs full Tbl coding
		
		PRIVATE nPC,nSize_H,nDim1,nSize_L,nDim2,nDim3,nWeight,cDescript,cLength
		PRIVATE cFloorStatus,cClass,cLocation
		PRIVATE nReceivingID, nInvoiceValue
		PRIVATE lMarkInvCheck, lPrime, lRandLen &&Not used yet!
		*frmModify_StockLst_Detail
		nPC			= PrepareSQLnum(ThisForm.txtPc1.Value,'Pc',-3)
		nSize_H		= PrepareSQLnum(ThisForm.txtSize_H1.Value,'Size_H',-5)
		nDim1		= PrepareSQLnum(ThisForm.txtDim11.Value,'Dim1',-5)
		nSize_L		= PrepareSQLnum(ThisForm.txtSize_L1.Value,'Size_L',-5)
		nDim2		= PrepareSQLnum(ThisForm.txtDim21.Value,'Dim2',-5)
		nDim3		= PrepareSQLnum(ThisForm.txtDim31.Value,'Dim3',-5)
		nWeight		= PrepareSQLnum(ThisForm.txtWeight1.Value,'Weight',9,1)
		cDescript	= PrepareSQLtxt(ThisForm.txtDescript1.Value,'Descript',20)
		cLength		= PrepareSQLtxt(ThisForm.txtLength1.Value,'Length',160)
		cFloorStatus= PrepareSQLtxt(ThisForm.txtFloorStatus1.Value,'FloorStatus',1)
		cClass		= PrepareSQLtxt(ThisForm.txtClass1.Value,'Class',1)
		*cLocation	= PrepareSQLtxt(ThisForm.txtLocation1.Value,'Location',10)
		cLocation	= PrepareSQLtxt(ThisForm.cmbLocation1.Value,'Location',10)
		lMarkInvCheck	= PrepareSQLlogic(ThisForm.chkMarkInvCheck.Value,'MarkInvCheck',.F.)
		lPrime			= PrepareSQLlogic(ThisForm.chkPrime.Value,'Prime',.F.)
		lRandLen 		= PrepareSQLlogic(ThisForm.chkRandLen.Value,'RandLen')
		nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		nInvoiceValue	= PrepareSQLnum(ThisForm.txtInvoiceValue.Value,'InvoiceValue',-5)
		
		PRIVATE cSOitem
		cSOitem = ThisForm.cSOitem
		
		*Collect Screen Stock Sizes
		PRIVATE nPC_OLD, nDim1_OLD, nDim2_OLD, nWeight_OLD, nQTY_Old, nWeight_Calc
		nPC_OLD		= PrepareSQLnum( ThisForm.txtPc.Value,'PC',-3)
		nDim1_OLD	= PrepareSQLnum( ThisForm.txtDim1.Value,'Dim1',-5)
		nDim2_OLD	= PrepareSQLnum( ThisForm.txtDim2.Value,'Dim2',-5)
		nWeight_OLD	= PrepareSQLnum( ThisForm.txtWeight.Value,'Pounds',9,1)
		nQTY_Old	= PrepareSQLnum( ThisForm.txtQTY.Value,'QTY',-5)
		nWeight_Calc = PrepareSQLnum( ThisForm.lblCalcPounds.Caption,'Pounds',9,1)
		
		PRIVATE nQTY_NEW, nPC_NEW,nDim1_NEW,nDim2_NEW,nDim3_NEW
		nPC_NEW		= PrepareSQLnum( ThisForm.txtPC1.Value,'PC',-3)
		nDim1_NEW	= PrepareSQLnum( ThisForm.txtDim11.Value,'Dim1',-5)
		nDim2_NEW	= PrepareSQLnum( ThisForm.txtDim21.Value,'Dim2',-5)
		nDim3_NEW	= PrepareSQLnum( ThisForm.txtDim31.Value,'Dim3',-5)
		nQTY_NEW	= PrepareSQLnum( ThisForm.txtS_QTY.Value,'S_Qty',-5)
		**
		PRIVATE nStockLst_QTY, nStockLst_P, nS_Total
		nStockLst_QTY	= PrepareSQLnum( ThisForm.txtS_QTY.Value,'S_QTY',-5)
		nStockLst_P		= PrepareSQLnum( ThisForm.txtS_P.Value,'S_P',-5)
		nS_Total		= nStockLst_QTY * nStockLst_P
		*PRIVATE nS_QTY, nS_P, nS_Total, nS_PU
		
		PRIVATE cForm, nS_PU
		cForm 	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		IF EMPTY(cForm)
			cForm 	= getFormbyMasterID( m.nID1, cTBL, ThisForm.nConnHandle)
		ENDIF
		nS_PU	= GetPUfromForm(cForm, ThisForm.nConnHandle)
		
		*******************************************
		*Check Values
		*nPC_NEW
		IF nDim1_NEW <= 0
			MESSAGEBOX("No Thickness"+CHR(13)+"Cannot save to Stock!"+CHR(13)+"Is this Scrap?",0+48,"Cannot Save")
			RETURN .F.
		ENDIF
		IF nDim2_NEW <= 0
			*Check Forms.useDim2 
			IF UsesForm_Dim2(cForm,ThisForm.nConnHandle)
				MESSAGEBOX("No Second Dimension."+CHR(13)+"Cannot save to Stock!"+CHR(13)+"Is this Scrap?",0+48,"Cannot Save")
				TrackError("No Dim2","No Second Dimension. Cannot save to Stock! Is this Scrap?",PROGRAM(),LINENO(1))
				RETURN .F.
			ENDIF
		ENDIF
		
		IF nDim3_NEW <= 0
			*
		ENDIF
		
		
		RETURN .T.
	ENDPROC

	PROCEDURE check_grab_stock
		*ThisForm.check_Grab_Stock()
		
		
		*SELECT FoundSTK FROM dbo.StockLst_Process WHERE ID_Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))
		*-- FoundSTK is DATE
		
		*SELECT * FROM dbo.StockLst_Process_Grab "
		*WHERE WO =  or SOitem =''
		******************************************************************
		PRIVATE lHaveSOitem, lFoundGrab
		lHaveSOitem = .F.
		lFoundGrab = .F.
		
		PRIVATE cSOitem, nWO, cTBL
		cSOitem	= PrepareSQLtxt(ThisForm.cSOitem,"SOitem",10)
		nWO		= PrepareSQLnum(ThisForm.nWO,'WO',-3)
		cTBL	= ThisForm.ctbl
		
		IF cSOitem != Proper_SO_Item('')
			lHaveSOitem = .T.
		ENDIF
		
		IF USED("tmpProc_Grab")
			USE IN tmpProc_Grab
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ID_Detail_Process, SOitem, SalesPerson, StartDate, DueDate, WO, FoundStk, Gone, MS4O "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process_Grab "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process_Grab "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process_Grab "
		ENDCASE
		
		*cSQL = cSQL + "	WHERE ID_Detail_Process = "+STR(ThisForm.nID_Detail_Process)
		IF lHaveSOitem
			IF nWO > 0
				cSQL = cSQL + "	WHERE WO = "+STR(nWO)+" OR SOitem=dbo.f_ProperSOitem('"+cSOitem+"')"
			ELSE
				cSQL = cSQL + "	WHERE SOitem=dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF
		ELSE
			IF nWO > 0
				cSQL = cSQL + "	WHERE WO = "+STR(nWO)
			ELSE
				*RETURN .T.
				cSQL = cSQL + "	WHERE ID_Detail_Process = "+STR(ThisForm.nID_Detail_Process)
			ENDIF
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpProc_Grab")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpProc_Grab")
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_Grab')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_Grab')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_Grab")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_Grab")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpProc_Grab")
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		IF USED('tmpProc_Grab')
			IF RECCOUNT('tmpProc_Grab') > 0
				nID_D_P_G = PrepareSQLnum(tmpProc_Grab.ID_Detail_Process,'ID_Detail_Process',-3)
				lFoundGrab = .T.
			ENDIF
			USE IN tmpProc_Grab
		ENDIF
		
		*********************
		IF NOT lFoundGrab 
			*Look for SELECTED Process and Grab it
			IF USED("tmpProc_G_Selected")
				USE IN tmpProc_G_Selected
			ENDIF
			SELECT 0
		
			cSQL = "SELECT  ID_Detail_Process, SOitem, PO_item, WO, WO_Detail, AllowSub, FoundStk "
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + " FROM dbo.StockLst_Process "
			CASE cTBL = "B"
				cSQL = cSQL + " FROM dbo.BrokerLst_Process "
			CASE cTBL = "W"
				cSQL = cSQL + " FROM dbo.WIPLst_Process "
			ENDCASE
		
			*cSQL = cSQL + "	WHERE ID_Detail_Process = "+STR(ThisForm.nID_Detail_Process)
			IF lHaveSOitem
				IF nWO > 0
					cSQL = cSQL + "	WHERE WO = "+STR(nWO)+" OR SOitem=dbo.f_ProperSOitem('"+cSOitem+"')"
				ELSE
					cSQL = cSQL + "	WHERE SOitem=dbo.f_ProperSOitem('"+cSOitem+"')"
				ENDIF
			ELSE
				IF nWO > 0
					cSQL = cSQL + "	WHERE WO = "+STR(nWO)
				ELSE
					*RETURN .T.
					cSQL = cSQL + "	WHERE ID_Detail_Process = "+STR(ThisForm.nID_Detail_Process)
				ENDIF
			ENDIF
			cSQL = cSQL + " AND Process_ID='SELECTED' "
			cSQL = cSQL + " AND AllowSub = 'N' "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpProc_G_Selected")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpProc_G_Selected")
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_G_Selected')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProc_G_Selected')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_G_Selected")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProc_G_Selected")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpProc_G_Selected")
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ENDIF
			IF USED('tmpProc_G_Selected')
				IF RECCOUNT('tmpProc_G_Selected') > 0
					nID_D_P_G = PrepareSQLnum(tmpProc_G_Selected.ID_Detail_Process,'ID_Detail_Process',-3)
					
					** Do the Grab Stock routine --For AllowSub = 'N'
					lOK = ThisForm.Make_Process_Grab(nID_D_P_G, cTBL )
					IF lOK
						lFoundGrab = .T.
					ENDIF
				ENDIF
				USE IN tmpProc_G_Selected
			ENDIF
			
			
		ENDIF
		
		**********************
		IF lFoundGrab 
		*	MESSAGEBOX("Found ID_Detail_Process "+ALLTRIM(STR(ThisForm.nID_Detail_Process))+" as Grabbed",0,"Order has grabbed stock!")
		ELSE
			cMess = "Modify Stock for Order TBL:'"+ThisForm.cTBL+"'"
			cMess = cMess + " ID_Detail:"+STR(ThisForm.nID_Detail)
			cMess = cMess + " ID_Detail_P:"+STR(ThisForm.nID_Detail_Process)
			cMess = cMess + " SOitem:'"+ThisForm.cSOitem+"'"
			cMess = cMess + " POitem:'"+ThisForm.cPOitem+"'"
			cMess = cMess + " WO:"+ STR(ThisForm.nWO)
			cMess = cMess + " WO_Detail:"+ STR(ThisForm.nWO_Detail)
			cMess = cMess + " "	
			
			MESSAGEBOX("Did not find where Stock has been Found Stock or Grabbed!"+CHR(13)+CHR(13)+"Instruct Shop Workers to Click the 'Found Stock' in Processes"+CHR(13)+CHR(13)+"Found or Grab records lead this Modify Stock screen, Packing Slip screen and fill cost in Sales Reports!",0+16,"The Stock has NOT been Found/Grabbed!")
			TrackError(cMess+CHR(13)+cSQL,"Did not find as Grabbed", PROGRAM(), LINENO(1))
		ENDIF
		
		***************************				
	ENDPROC

	PROCEDURE check_weight1_qty		&& Check_Weight1_QTY
		*ThisForm.Check_Weight1_QTY()
		*Stock weight is not tracked well, use calculated or QTY when empty
		*weight1 is the value that is going to be saved on 'SAVE'
		
		PRIVATE nPU
		nPU 		= PrepareSQLnum(ThisForm.txtS_PU.Value,'PU',-1)
		
		PRIVATE nPCs, cAlloy, cForm, nDim1, nDim2, nDim3
		nPCs	= PrepareSQLnum(ThisForm.txtPC1.Value,'Pc',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		nDim1	= PrepareSQLnum(ThisForm.txtDim11.Value,'Dim1',-5)
		nDim2	= PrepareSQLnum(ThisForm.txtDim21.Value,'Dim2',-5) 
		nDim3	= PrepareSQLnum(ThisForm.txtDim31.Value,'Dim3',-5)
		
		PRIVATE nQTY, nPounds, nCalc_QTY, nCalc_Weight 
		nQTY	= PrepareSQLnum(ThisForm.txtS_QTY.Value,'QTY',-5)
		nPounds	= PrepareSQLnum(ThisForm.txtWeight1.Value,'Pounds',9,1)
		nCalc_QTY	 = GetUnitQty(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		*nCalc_Weight = CalcWeight(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		nCalc_Weight = GetWeight(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		
		IF nPounds = 0
			IF nCalc_Weight > 0
				nPounds = nCalc_Weight
				ThisForm.txtWeight1.Value = nPounds
			ENDIF
		ENDIF
		IF nQTY = 0
			IF nCalc_QTY > 0
				nQTY = nCalc_QTY
				ThisForm.txtS_QTY.Value = nQTY
			ENDIF
		ENDIF
		***
		IF (nQTY+10)*.8 > (nCalc_QTY+10) OR (nQTY+10) < (nCalc_QTY+10)*.8
			*fix
			nQTY = nCalc_QTY
			ThisForm.txtS_QTY.Value = nQTY
		ENDIF
		
		IF (nPounds+10)*.8 > (nCalc_Weight+10) OR (nPounds+10) < (nCalc_Weight+10)*.8
			*fix
			nPounds = nCalc_Weight
			ThisForm.txtWeight1.Value = nPounds
		ENDIF
		
		***
		
		
		*!*	IF (nPounds+10)*.8 > (nCalc_Weight+10) OR (nPounds+10) < (nCalc_Weight+10)*.8
		
		
		*!*		******* FIX BY PU 
		*!*		DO CASE 
		*!*		CASE nPU = 1
		*!*			*Lbs try QTY
		*!*			IF (nDWeight+10)*.8 > (nDQTY+10) OR (nDWeight+10) < (nDQTY+10)*.8
		*!*				* ???
		*!*			ELSE
		*!*				*Within 20%
		*!*				nDWeight = nDQTY
		*!*			ENDIF
		*!*		CASE nPU = 2
		*!*			*FT
		*!*			nDWeight = nCalc_Weight
		*!*		CASE nPU = 3
		*!*			*PC
		*!*			nDWeight = nCalc_Weight
		*!*		*CASE nPU = 4
		*!*			*Lot
		*!*		OTHERWISE
		*!*			TrackError("Did not get a PU","Form:"+cForm,PROGRAM(),LINENO(1))
		*!*		ENDCASE
		*!*		
		*!*	ENDIF
		
		
		*ThisForm.txtWeight1.Value = nDWeight
	ENDPROC

