		*		ThisForm.txtForm1.Value = ''		&&KEEP
				ThisForm.chkMarkInvCheck.Value=0
				ThisForm.chkPrime.Value = 0
				ThisForm.chkRandLen.Value = 0
				
				ThisForm.cmdScrap.Enabled = .T.
				
			ENDIF
			IF cHow = "EDIT" 
				*ThisForm.chkMarkInvCheck.Value=0
				ThisForm.chkMarkInvCheck.Value=0
				*ThisForm.chkPrime.Value()   &&Write a check to test for Prime
			ENDIF
			
		ENDCASE
		
	ENDPROC

	PROCEDURE modify_stocklst_detail_report
		PARAMETER pID_Detail_Process
		*ThisForm.Modify_StockLst_Detail_Report(m.ID_Detail_Process )
		*- reports Process Value
		
		IF VARTYPE(pID_Detail_Process) != 'N'
			pID_Detail_Process = 0
		ENDIF
		
		PRIVATE cSOitem, nWO
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		PRIVATE nMess
		nMess = 6
		
		PRIVATE nBE, nAE, nAD, nDL, nChange
		nChange = 0
		*****Just this Process
		PRIVATE cSQL
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		SELECT 0
		
		IF pID_Detail_Process > 0
		*	cSQL =  "SELECT SUM(ProcessValue) AS TotProc "
		*	cSQL = cSQL+" FROM dbo.Ar_Stocklst_Detail_History WITH(NOLOCK) "
		*	cSQL = cSQL+"  WHERE ID_Detail_Process = "+ STR(pID_Detail_Process)
		
			cSQL = " SELECT SUM(QTY) AS TotProc "
			cSQL=cSQL+" FROM dbo.StockLst_Process_Grab WITH(NOLOCK) "
			IF nWO > 0
				cSQL=cSQL+" WHERE WO="+STR(nWO)
			ELSE
				cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF
			cSQL=cSQL+" AND Process_ID = 'SELECTED  '"
				
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				SELECT tmpDetail_Process_Report
				nChange = PrepareSQLnum(tmpDetail_Process_Report.TotProc,'TotProc',-3)
		
				nChange = -( nChange )
				IF nChange = 0 
		*			MESSAGEBOX("There was no cost, or change in cost to apply to this order item from this Process."+CHR(13)+;
						"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
				ELSE
		*			MESSAGEBOX("The cost to apply to this order item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process."+CHR(13)+;
						"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
				ENDIF
			ENDIF
		
			IF USED("tmpDetail_Process_Report")
				USE IN tmpDetail_Process_Report
			ENDIF
		ENDIF
		
		******** Look for Other Process on this 
		IF cSOItem <> Proper_SO_Item("") OR nWO > 0
		
			SELECT 0
			
		*	cSQL =  "SELECT SUM(ProcessValue) AS TotProc "
		*	cSQL = cSQL+" FROM dbo.Ar_Stocklst_Detail_History WITH(NOLOCK) "
		*	cSQL = cSQL+" WHERE ID_Detail_Process IN (SELECT ID_Detail_Process FROM dbo.StockLst_process WITH(NOLOCK) "
		*	IF nWO > 0
		*		cSQL = cSQL + " WHERE WO = "+STR(nWO)+")"
		*	ELSE
		*		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOItem + "'))"
		*	ENDIF
		
			cSQL = " SELECT SUM(QTY) AS TotProc "
			cSQL=cSQL+" FROM dbo.StockLst_Process_Grab WITH(NOLOCK) "
			IF nWO > 0
				cSQL=cSQL+" WHERE WO="+STR(nWO)
			ELSE
				cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF
			cSQL=cSQL+" AND Process_ID = 'SELECTED  '"
				
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				SELECT tmpDetail_Process_Report
				nChange = PrepareSQLnum(tmpDetail_Process_Report.TotProc,'TotProc',-3)
				
				nChange = -( nChange )
				IF nChange = 0
					* First zero Message was enough
				ELSE
		*				nMess = MESSAGEBOX("The cost to apply to this Sales Order Item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process.",4+32,"Sales Order Item Total")
				ENDIF
			ENDIF &&nSQLEXEC
				
			*********** Update Sales/WO Record!!!
			IF nMess = 6 &&Yes 
				
				IF nWO > 0
					Save_ItemCost_WO( nChange, nWO, ThisForm.nConnHandle )
				ELSE
					Save_ItemCostinSales( nChange, cSOitem, ThisForm.nConnHandle )
				ENDIF
			ENDIF
			
		
		ELSE
			MESSAGEBOX("Could NOT Calc Historical use",0,"Empty Order Number!")
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could NOT Calc Historical use by WO or SOitem")
		ENDIF &&TYPE("cSOitem") = "C"
			
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		
	ENDPROC

	PROCEDURE modify_wiplst_detail_report
		PARAMETERS nID_Detail_Process
		*ThisForm.Modify_WIPLst_Detail_Report(
		*- reports Process Value
		
		PRIVATE cSOitem, nWO
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
	ENDPROC

	PROCEDURE partial_id_detail_process
		PARAMETER lConsume
		*ThisFormSet.Partial_ID_Detail_Process(lConsume)
		*NOT ThisForm.ConsumeStock(lScrap)
		*NOT ThisForm.ConsumeQTY(pWhat)
		*NOT ThisForm.Create_aConsumeQTY(pWhat) -- Get Process QTY
		
		**********************************************************************
		PRIVATE cWhat
		cWhat = "Sell Stock"
		IF nWO > 0
			cWhat = "Work Order"
			lOK = Remove_ID_Detail_Process(nID_Detail_Process,"WO",nWO,cTbl,ThisForm.nConnHandle,cWhat )
		ELSE
			*Remove_ID_Detail_Process() Removes and adds a WHAT Comment for history
			lOK = Remove_ID_Detail_Process(nID_Detail_Process,"SOitem",cSOitem,cTbl,ThisForm.nConnHandle,cWhat )
		ENDIF
		WAIT WINDOW "Removed the 'Selected' Process!" NOWAIT
		**************************************************************************
		
		IF VARTYPE(lConsume) <> "L"	
			lConsume = .F.
		ENDIF
		
		*Complete current process AS 'Shipped' 
		*create a new 'PartSelect' process with balance values 
		*Reset current  Process_ID = 'PartSelect' to lesser value (subtract what was Shipped!)
		
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE nID, nID_Detail, nID_Detail_Process
		nID					= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail			= PrepareSQLnum(THISFORM.txtID_Detail.VALUE,'ID_Detail',-3,0)
		nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3,0)
		
		PRIVATE cSOitem, nWO, nWO_Detail, cUserEdit
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		*WAIT WINDOW cSOitem NOWAIT
		cSOitem	= Proper_SO_Item(cSOItem)
		
		nWO 	= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail ,'WO_Detail',-3)
		cUserEdit	= PrepareSQLtxt(ThisForm.edtUserEdit.Value,'UserEdit',-1)
		
		PRIVATE cTbl
		cTbl = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		
		**************************************
		PRIVATE nQTYLeft, nWeightLeft, nPCLeft, nDetail_QTY, nDetail_Weight, nDetail_PC 
		PRIVATE nRemove_QTY_Total, nSTK_PC_Total, nRemove_LBS_Total, nProcessQTY, nProcessPC, nProcessPounds
		PRIVATE  lAllowSub
		*PUBLIC ARRAY aConsumeQTY()  Filled by ThisForm.Create_aConsumeQTY()
		nQTYLeft 	= aConsumeQTY(1)
		nWeightLeft = aConsumeQTY(2)
		nPCLeft  	= aConsumeQTY(3)
		
		nDetail_QTY	= aConsumeQTY(4)
		nDetail_Weight = aConsumeQTY(5)
		nDetail_PC 	= aConsumeQTY(6)
		
		nRemove_QTY_Total 	= aConsumeQTY(7)
		nRemove_PC_Total	= aConsumeQTY(8)
		nRemove_LBS_Total 	= aConsumeQTY(9)
		
		nProcessQTY 	= aConsumeQTY(10)
		*nProcessPrc_QTY	= aConsumeQTY(11)
		nProcessPC		= aConsumeQTY(11)
		nProcessPounds	= aConsumeQTY(12)
		lAllowSub		= aConsumeQTY(13)
		
		*!*				nPU			= PrepareSQLnum(tmpID_Detail_Process.PU,'PU',-1)
		*!*				nQTY		= PrepareSQLnum(tmpID_Detail_Process.QTY,'QTY',-5)
		*!*				nPounds		= PrepareSQLnum(tmpID_Detail_Process.Pounds,'Pounds',9,1
		
		********************** 
		PRIVATE cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		nPrc_PCs	= PrepareSQLnum(ThisForm.txtPC1.Value,'PC',-3)
		nPrc_Dim1	= PrepareSQLnum(ThisForm.txtDim11.Value,'Dim1',10,4)
		nPrc_Dim2	= PrepareSQLnum(ThisForm.txtDim21.Value,'Dim2',9,3)
		nPrc_Dim3	= PrepareSQLnum(ThisForm.txtDim31.Value,'Dim3',9,3)
		
		*************************
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE lUpdatePartSelect
		lUpdatePartSelect = .F.
		PRIVATE nPpQTY, nPpPounds
		nPpQTY = 0
		nPpPounds = 0
		
		PRIVATE cPOitem, dDueDate, nPU, nReceivingID
		cPOitem 	= ''
		dDueDate	= CTOD('')
		nPU = 0
		nReceivingID = 0
		
		**********************************************************************
		* Collect QTY if there is a PartSelect
		* use dbo.Sales Selected_QTY instead
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpPartSelect")
			USE IN tmpPartSelect
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WHERE "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WHERE  "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WHERE  "
		ENDCASE
		*cSQL = cSQL +" ID_Detail_Process = "+STR(nID_Detail_Process)
		IF nWO > 0
			cSQL = cSQL + " ( WO="+STR(nWO)
			*WAIT WINDOW cSOitem NOWAIT
			IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
				cSQL = cSQL + " OR SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"+" )"
			ELSE
				cSQL = cSQL +" )"
			ENDIF
		ELSE
			*WAIT WINDOW cSOitem NOWAIT
			IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
				cSQL = cSQL + " SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF
		ENDIF
		cSQL = cSQL + " AND Process_ID = 'PARTSELECT'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpPartSelect")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpPartSelect")
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPartSelect')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPartSelect')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPartSelect")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPartSelect")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpPartSelect")
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED("tmpPartSelect")
				IF RECCOUNT("tmpPartSelect")>0
					
					
					*SCAN
					nPpQTY		= PrepareSQLnum(tmpPartSelect.QTY,'QTY',-5)
					nPpPounds	= PrepareSQLnum(tmpPartSelect.Pounds,'Pounds',9,1)
		*			nPpPrc_QTY	= PrepareSQLnum(tmpPartSelect.Prc_QTY,'QTY',-5)
					
					cPOitem		= PrepareSQLtxt(tmpPartSelect.PO_Item,'PO_Item',12)
					dDueDate	= PrepareSQLdate(tmpPartSelect.DueDate,'DueDate')
					nPU			= PrepareSQLnum(tmpPartSelect.PU,'PU',-1)
					
					nReceivingID = PrepareSQLnum(tmpPartSelect.ReceivingID,'ReceivingID',-3)
					
					*ENDSCAN
				ENDIF
				USE IN tmpPartSelect
			ENDIF
		ENDIF
		
		*********************************************************
		*Check need for a PartSelect. 
		
		*If there are still 'SELECTED' then no need for Partial Yet.
		PRIVATE lNeedPartial
		lNeedPartial = .T.
		
		IF USED("cntSELECTEDP")
			USE IN cntSELECTEDP
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNTD "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process WHERE "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process WHERE  "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process WHERE  "
		ENDCASE
		
		IF nWO > 0
			cSQL = cSQL + " ( WO="+STR(nWO)
			*WAIT WINDOW cSOitem NOWAIT
			IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
				cSQL = cSQL + " OR SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"+" )"
			ELSE
				cSQL = cSQL + " )"
			ENDIF
		ELSE
			*WAIT WINDOW cSOitem NOWAIT
			IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
				cSQL = cSQL + " SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ENDIF
		ENDIF
		cSQL = cSQL + " AND Process_ID = 'SELECTED'"  && OR Process_ID='PartSelect' )
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "cntSELECTEDP")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "cntSELECTEDP")
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSELECTEDP')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSELECTEDP')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSELECTEDP")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSELECTEDP")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "cntSELECTEDP")
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED("cntSELECTEDP")
				IF RECCOUNT("cntSELECTEDP") > 0
					IF cntSELECTEDP.CNTD > 0 
						lNeedPartial = .F.
					ENDIF
				ENDIF
				USE IN cntSELECTEDP
			ENDIF
		ENDIF
		
		***************************************************************
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		
		IF lNeedPartial AND lConsume
			*Still could need another partial 'PARTSELECT' after a Detail item is consumed.
			*
			*Check if Remove_ID_Detail_Process() had removed all that the Order Needs
			PRIVATE lNeedMoreSelected
			lNeedMoreSelected = .F.
			*nStckPrc_Qty = get_PartialPick_QTY(cSOitem,nWO,ThisForm.nConnHandle)
			*nGrabbed_QTY = get_QTY_Grab(cTBL,cSOitem,nWO,ThisForm.nConnHandle)
			*Remove_ID_Detail_Process(nID_Detail_Process
			
			*lAnswer = is_Order_Stock_Process(nWO, cSOitem,  pConnHandle)
			
			
			
			IF lNeedMoreSelected
				PRIVATE cMess   &&, cTLB
				PRIVATE nSOi_Total, nStckPrc_Qty, nGrabbed_QTY, nNeed_QTY
				nSOi_Total	= Calc_QTY_SOitem(cSOitem,ThisForm.nConnHandle)
				IF nWO>0
					nWO_Total  = Calc_QTY_WO(nWO,ThisForm.nConnHandle)
					nSOi_Total = 0
				ELSE
					nWO_Total  = 0
					nSOi_Total = Calc_QTY_SOitem(cSOitem,ThisForm.nConnHandle)
				ENDIF
				nStckPrc_Qty = get_PartialPick_QTY(cSOitem,nWO,ThisForm.nConnHandle)
				nGrabbed_QTY = get_QTY_Grab(cTBL,cSOitem,nWO,ThisForm.nConnHandle)
				nNeed_QTY = nSOi_Total-(nStckPrc_Qty+nGrabbed_QTY)
				
				IF nWO > 0
					cMess="WorkOrder:"+STR(nWO)
					cMess=cMess+"' Requires "+ALLTRIM(STR(nWO_Total))+" for the Customer"+CHR(13)+CHR(10)+CHR(13)
				ELSE
					cMess = "SOitem:"+cSOitem+CHR(13)
					cMess=cMess+"' Requires "+ALLTRIM(STR(nSOi_Total))+" for the Customer"+CHR(13)+CHR(10)+CHR(13)
				ENDIF	
				cMess=cMess+"After this consume of stock Process: "+CHR(13)+CHR(10)
				cMess=cMess+STR(nStckPrc_Qty,10) +" is Still SELECTED"+CHR(13)+CHR(10)
				cMess=cMess+STR(nGrabbed_QTY ,10)+" has been SELECTED"+CHR(13)+CHR(10)
				cMess=cMess+STR(nNeed_QTY ,10)+" is still needed for Order!"+CHR(13)+CHR(10)
				
				MESSAGEBOX(cMess,0,"select next Stock")
			ENDIF
		ENDIF
		
		
		***************************************************************
		*Did this Process Finish the WO/SOitem??????
		*Check WO, SOitem and PartSelect for QTY
		*See if This Stock QTY would cover it.
		
		PRIVATE nWoQTY, nWoPounds
		nWoQTY		= 0
		nWoPounds	= 0
		
		IF nWO > 0
			*GET nWoQTY, nWoPounds
			IF USED("tmpWO_QTY")
				USE IN tmpWO_QTY
			ENDIF
			SELECT 0
		
			cSQL = "SELECT sWeight "
			cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) WHERE "
			cSQL = cSQL + " WO="+STR(nWO)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpWO_QTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpWO_QTY")
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_QTY')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_QTY')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_QTY")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_QTY")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpWO_QTY")
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED("tmpWO_QTY")
					IF RECCOUNT("tmpWO_QTY")>0
					
						nWoQTY		= PrepareSQLnum(tmpWO_QTY.sWeight ,'QTY',-5)
						nWoPounds	= PrepareSQLnum(tmpWO_QTY.sWeight ,'Pounds',9,1)
						
					ENDIF
					USE IN tmpWO_QTY
				ENDIF
			ENDIF
		
		ELSE 
			nWoQTY = 0
			nWoPounds = 0
		ENDIF
		
		*************
		PRIVATE nSOiQTY, nSOiPounds, nSOiPU
		nSOiQTY = 0
		nSOiPounds = 0
		nSOiPU = 0
		PRIVATE nS_QTY, nS_PU
		nS_QTY = 0
		nS_PU = 0
		
		*nS_Qty = GetPUfromForm( cPrc_Form, ThisForm.nConnhandle )		
		
		*WAIT WINDOW cSOitem NOWAIT
		
		IF cSOitem = Proper_SO_Item(cSOitem) AND cSOitem != Proper_SO_Item('')
			*GET nSOiQTY, nSOiPounds, nSOiPU
			IF USED("tmpSOi_QTY")
				USE IN tmpSOi_QTY
			ENDIF
			SELECT 0
		
			cSQL = "SELECT S.Quoted_QTY, S.Quoted_PU "
			cSQL = cSQL + ", AQ.[Weight] ,AQ.S_PU, AQ.S_QTY "
			cSQL = cSQL + " FROM dbo.Sales S WITH(NOLOCK) "
			cSQL = cSQL + " inner join dbo.AllQuotes AQ WITH(NOLOCK) ON S.SOitem = AQ.SOitem "
			cSQL = cSQL + " WHERE S.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpSOi_QTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpSOi_QTY")
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOi_QTY')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOi_QTY')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOi_QTY")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOi_QTY")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpSOi_QTY")
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED("tmpSOi_QTY")
					IF RECCOUNT("tmpSOi_QTY")>0
					
						nSOiQTY		= PrepareSQLnum(tmpSOi_QTY.Quoted_QTY,'QTY',-5)  &&Customer
						nSOiPU		= PrepareSQLnum(tmpSOi_QTY.Quoted_PU,'S_PU',-1)
						nSOiPounds	= PrepareSQLnum(tmpSOi_QTY.Weight,'Pounds',9,1)
										
						nS_QTY		= PrepareSQLnum(tmpSOi_QTY.S_QTY,'QTY',-5)	&&Acct
						nS_PU = PrepareSQLnum(tmpSOi_QTY.S_PU,'S_PU',-1)
						*IF nS_PU = 0
						*	***
						*ENDIF
					ENDIF
					USE IN tmpSOi_QTY
				ENDIF
			ENDIF
		ENDIF
		
		IF nS_PU = 0
			*Should always be based on Form in Acct Stnd
			nS_PU = GetPUfromForm( cPrc_Form, ThisForm.nConnhandle )					
		ENDIF
		
		*************
		* Passed in as Items Entered the are being removed form the stock.
		* nSTK_PC_Total, nRemove_LBS_Total, nRemove_QTY_Total
		
		*IF Remove_QTY_Total > tmpPartSelect.Prc_QTY + tmpWO_QTY.sWeight + tmpSOi_QTY.Quoted_QTY
		
		
		*nRemove_QTY_Total = aConsumeQTY(7)
		*nPpQTY = FROM dbo.StockLst_Process WHERE " AND Process_ID = 'PARTSELECT'"
		*nWoQTY = SELECT sWeight FROM dbo.WorkOrder
		*nSOiQTY = SELECT Quoted_QTY from Sales
		*nS_QTY = SELECT S_Qty from AllQuotes
		
		IF nRemove_QTY_Total * 1.15 >= ( nWoQTY + nS_QTY )- nPpQTY
			lNeedPartial = .F.
			*do not need partial.
		ELSE 	
			lNeedPartial = .T.
		ENDIF
		
		PRIVATE nNew_QTY
		nNew_QTY = ROUND( (nWoQTY + nS_QTY)- nPpQTY - nRemove_QTY_Total ,0) 
		IF nNew_QTY < 0
			nNew_QTY = 0
		ENDIF
		
		******************************************
		**while Testing, TrackMess
		PRIVATE pMessMemo
		*     (    INT, C(254),    C(254),      INT,      MEMO)
		
		pMessMemo = "This data is for test, see if anything looks odd."+CHR(10)+CHR(13)
		pMessMemo = pMessMemo + "lNeedPartial = IF nRemove_QTY_Total * 1.15 >= ( nWoQTY + nS_QTY )- nPpQTY "+CHR(10)+ CHR(13)
		pMessMemo = pMessMemo + "nRemove_QTY_Total * 1.15 ="  +ALLTRIM(STR(nRemove_QTY_Total * 1.15,10,0))+CHR(10)+ CHR(13)
		pMessMemo = pMessMemo + "( nWoQTY + nS_QTY )- nPpQTY ="+ALLTRIM(STR((nWoQTY + nS_QTY)-nPpQTY,10,0))+CHR(10)+ CHR(13)
		
		IF lNeedPartial 
			pMessMemo = pMessMemo + "lNeedPartial is True."+CHR(10)+ CHR(13)
		ELSE
			pMessMemo = pMessMemo + "lNeedPartial is False."+CHR(10)+ CHR(13)
		ENDIF
		
		pMessMemo = pMessMemo + CHR(13)
		pMessMemo = pMessMemo + STR(nRemove_QTY_Total,10,1)+" Stock QTY to remove entered into table tmpStkSum."+CHR(13)+CHR(13)
		pMessMemo = pMessMemo + STR(nPpQTY ,10,1)+" Last Partial Select QTY."+CHR(13)
		pMessMemo = pMessMemo + STR(nWoQTY ,10,1)+" Starting WO QTY."+CHR(13)
		pMessMemo = pMessMemo + STR(nS_QTY,10,1)+" SOitem QTY."+CHR(13)+CHR(13)
		
		pMessMemo = pMessMemo + STR(nNew_QTY,10,1)+" QTY to SELECT next."+CHR(13)+CHR(13)
		
		pMessMemo = pMessMemo + STR(nDetail_QTY,10,1)+" QTY available in Detail record."+CHR(13)+CHR(13)
		pMessMemo = pMessMemo + STR(nQTYLeft,10,1)+" QTY left for Detail record."+CHR(13)+CHR(13)
		
		pMessMemo = pMessMemo + CHR(13)+CHR(13)
		pMessMemo = pMessMemo + STR(nPpPounds,10,1)+" Last Partial Select LBS."+CHR(13)
		pMessMemo = pMessMemo + STR(nWoPounds,10,1)+" Starting WO LBS."+CHR(13)
		pMessMemo = pMessMemo + STR(nSOiPounds,10,1)+" SOitem LBS sold."+CHR(13)+CHR(13)
		pMessMemo = pMessMemo + STR(nRemove_QTY_Total,10,1)+" LBS to remove entered into table tmpStkSum."+CHR(13)+CHR(13)
		pMessMemo = pMessMemo + STR(nDetail_Weight,10,1)+" LBS available in Detail record."+CHR(13)+CHR(13)
		pMessMemo = pMessMemo + STR(nWeightLeft,10,1)+" LBS left for Detail record."+CHR(13)+CHR(13)
		
		pMessMemo = pMessMemo + CHR(13)
		pMessMemo = pMessMemo + STR(nRemove_PC_Total,10,1)+" PCs to remove entered into table tmpStkSum."+CHR(13)
		pMessMemo = pMessMemo + STR(nDetail_PC,10,1)+" PCs available in Detail record."+CHR(13)  
		pMessMemo = pMessMemo + STR(nPCLeft,10,1)+" PCs left for Detail record."+CHR(13)+CHR(13)
		pMessMemo = pMessMemo + STR(nSOiPU)+" S_PU."+ CHR(13)
		
		pMessMemo = pMessMemo + CHR(13)
		pMessMemo = pMessMemo + "cSOitem = '"+cSOitem+"'." + CHR(13)
		IF Proper_PO_item(cSOitem) != Proper_PO_item("")
			pMessMemo = pMessMemo + "ReportServer '"+HTML_SOitem(cSOitem,.F.)+"'" + CHR(13)
			pMessMemo = pMessMemo + "ReportServer '"+HTML_SOitem(cSOitem,.T.)+"'" + CHR(13)
		ENDIF
		pMessMemo = pMessMemo + "nWO = "+ALLTRIM(STR(nWO))+"."+CHR(13)
		IF nWO > 0
			pMessMemo = pMessMemo + "ReportServer '"+HTML_WO(nWO,.F.)+"'" + CHR(13)
			pMessMemo = pMessMemo + "ReportServer '"+HTML_WO(nWO,.T.)+"'" + CHR(13)
		ENDIF
		pMessMemo = pMessMemo + "nID_Detail_Process = "+STR(nID_Detail_Process)+CHR(13)
		
		
		RecordTest('Record Test Data.',PROGRAM(), LINENO(1), pMessMemo)
		
		*************
		PRIVATE cAllowSub, cProcess_ID, cProcessor, cComment, cSalesPerson
		IF lNeedPartial 
			nMess = MESSAGEBOX("The program thinks a PARTIAL SELECT process is needed."+CHR(13)+"If you know you just completed this order item"+CHR(13)+"Answer 'N' to NOT add a process."+CHR(13)+CHR(13)+"Answer yes to let program Add a PARTIAL SELECT"+CHR(13)+"for the next QTY= "+ALLTRIM(STR(nNew_QTY)),4+32,"Add a Partial Process")
			IF nMess = 7
				lNeedPartial = .F.
				pMessMemo = "The program thinks a PARTIAL SELECT process is needed."+CHR(13)+"If you know you just completed this order item"+CHR(13)+"Answer 'N' to NOT add a process."+CHR(13)+CHR(13)+"Answer yes to let program Add a PARTIAL SELECT"+CHR(13)+"for the next QTY= "+ALLTRIM(STR(nNew_QTY))+CHR(13)+"User selected 'No'"+CHR(13)+pMessMemo 
				RecordTest('Record Test Data.', PROGRAM(), LINENO(1), pMessMemo )
			ENDIF
		ENDIF
		
		IF lNeedPartial 
			*Create new 'Partial Balance -still Needed' Process
			
			cAllowSub	= 'Y'  &&Computer generated selected
			cProcess_ID = 'SELECTED'   &&was 'SELECTED' PARTSELECT
			cProcessor  = PrepareSQLtxt("Partail "+STR(nID_Detail_Process),'Processor',20)
			cComment 	= PrepareSQLtxt("Selected Stock was used, but more stock is needed to finish. Old nID_Detail_Process="+STR(nID_Detail_Process),'Comment',100)
			*cSalesPerson = PrepareSQLtxt( RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 ), 'SalesPerson',20)
			cSalesPerson = PrepareSQLtxt( SUBSTR(SYS(0),AT("#",SYS(0))+2) , 'SalesPerson',20)
			
			nID_Detail = 0 &&Not Attached to STOCK, Reference by WO,SO,PO
			
			
			IF USED('tmpID_Detail_Process')
				USE IN tmpID_Detail_Process
			ENDIF
			SELECT 0
				
			cSQLi = "EXEC dbo.p_Lst_Process_ins "
			cSQLi = cSQLi + " @TBL = '"+cTBL+"'"
			cSQLi = cSQLi + ",@ID_Detail ="+STR(nID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
			cSQLi = cSQLi + ",@StartDate = '"+DTOC(DATETIME())+"'"	&&GetDate()"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate)," ",DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"   &&'Y' Computer does not Select the Stock!
		
			cSQLi = cSQLi + ",@PU	= "+STR(nPU)
			cSQLi = cSQLi + ",@QTY	= "+STR(nWeightLeft,18,4)
			cSQLi = cSQLi + ",@Pounds ="+STR(nWeightLeft,9,1)
		
			cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
			cSQLi = cSQLi + ",@PO_Item = '"+cPoItem+"'"
			cSQLi = cSQLi + ",@WO 	= "+STR(nWO)
			cSQLi = cSQLi + ",@WO_Detail= "+STR(nWO_Detail)	
		
			cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(cProcess_ID,'Process_ID',10)+"'"
			cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(cProcessor,'User',20)+"'"
			cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(cComment,'Comment',100)+"'"
		
			cSQLi = cSQLi + ",@ReceivingID ="+STR(nReceivingID)
			
			cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
			cSQLi = cSQLi + ",@Prc_PCs  = "+STR(nPrc_PCs )
			cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1,10,4)
			cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2,9,3)
			cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3,9,3)
		
			cSQLi = cSQLi + ",@Ordered_QTY = "+STR(nWeightLeft,18,4)
			cSQLi = cSQLi + ",@Ordered_P = "+STR(0)
			***
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi, ThisForm.nConnhandle, nSQLEXEC, 'tmpID_Detail_Process')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLi )
			ENDIF
		
		ENDIF
		
		*MESSAGEBOX("The Sales Order item is only partailly complete."+CHR(13)+"Please create a new process that would finish this order"+CHR(13)+"or have the SalesPerson order more material and then mark that PO as a process against it.",64,"Remember to enter the next process to complete this SOitem.")
		
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		
		RETURN lOK 
		
	ENDPROC

	PROCEDURE popup_packingslip
		*ThisForm.PopUp_PackingSlip()
		
		IF Proper_SO_item(ThisForm.cSOitem) = Proper_SO_item('')
			RETURN
		ENDIF
		
		PRIVATE cHeat, cLot
		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50,.f.)
		cLot	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10,.f.)
		
		IF EMPTY(cHeat)
			RETURN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpSales_Detail_Packed')
			USE IN tmpSales_Detail_Packed
		ENDIF
		
		*See if found when PackingSlip is done before Stock is edited by order.
		cSQL = "SELECT COUNT(*) AS CNTD "
		cSQL = cSQL +" FROM dbo.Sales_Detail_PackingSlip WITH(NOLOCK) "
		cSQL = cSQL +" WHERE SOitem = '"+ThisForm.cSOitem+"'"
		cSQL = cSQL +" OR ( "
		cSQL = cSQL +" Heat LIKE '"+ALLTRIM(cHeat)+"%'"
		cSQL = cSQL +" AND [When] > GETDATE()-90 "
		*IF LEN(cLot)> 0	&&Lot is combined into heat at packingSlip
		*	cSQL = cSQL +" AND LOT = '"+cLot+"'"
		*ENDIF
		cSQL = cSQL +" ) "
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_Packed')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_Packed')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_Packed')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_Packed')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Detail_Packed")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Detail_Packed")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Detail_Packed')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tmpSales_Detail_Packed')
			*IF RECCOUNT('tmpSales_Detail_Packed')>0
			IF tmpSales_Detail_Packed.CNTD > 0
				DO FORM Forms\Sales_Detail_Packed WITH ThisForm.cSOitem, cHeat 
			ENDIF
			USE IN 'tmpSales_Detail_Packed'
		ENDIF
	ENDPROC

	PROCEDURE recalc_qty
		PARAMETERS pWhat
		*ThisForm.reCalc_QTY('QTY')
		*Calc_StockDetail_3
		PRIVATE nCalcQTY, nLBS, nPieces, cAlloy, cForm, nSize1, nSize2, nSize3
		nPieces	= PrepareSQLnum(ThisForm.txtPC3.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		nSize1	= PrepareSQLnum(ThisForm.txtDim13.Value,'DIM1',10,4)
		nSize2	= PrepareSQLnum(ThisForm.txtDim23.Value,'DIM2',9,3)
		nSize3	= PrepareSQLnum(ThisForm.txtDim33.Value,'DIM3',9,3)
		
		nCalcQTY = GetUnitQty(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		*nWeight = CalcWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		nWeight = GetWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		
		SELECT tmpStkSum
		
		PRIVATE nCurRec, nRecNo3
		nCurRec = RECNO('tmpStkSum')
		nRecNo3	= PrepareSQLnum(ThisForm.txtRecNo3.Value,'RecNo',-3)
		
		IF nCurRec <> nRecNo3
			IF nRecNo3 > 0 
				IF nRecNo3 <= RECCOUNT('tmpStkSum')
					GOTO nRecNo3 
				ENDIF
			ENDIF
		ENDIF
		
		****************
		IF nCalcQTY > 0
			ThisForm.txtQTY3.Value = nCalcQTY
			ThisForm.EnterQTY3 = .T.
			
			REPLACE QTY  WITH nCalcQTY
			
		ENDIF
		
		****************
		IF nWeight > 0
			ThisForm.txtWeight3.Value = nWeight
			ThisForm.EnterWeight3 = .T.
				
			REPLACE Weight WITH nWeight
		
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE refreshform
		*ThisForm.RefreshForm()
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		
		PRIVATE cForm
		cForm= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		
		IF NOT EMPTY(cForm)
			IF GetFormCaptions(cForm,ThisForm.nConnHandle)
				IF USED('tmpFormCaptions')
					ThisForm.lblDim11.Caption	= RTRIM(tmpFormCaptions.txt1)
					ThisForm.lblSz1.Caption		= RTRIM(tmpFormCaptions.txt1)
					ThisForm.lblSz13.Caption	= RTRIM(tmpFormCaptions.txt1)
					
					ThisForm.lblDim21.Caption	= RTRIM(tmpFormCaptions.txt2)
					ThisForm.lblDim21.Visible 	= tmpFormCaptions.lblSz2Vis
					ThisForm.lblSZ2.Caption 	= RTRIM(tmpFormCaptions.txt2)
					ThisForm.lblSZ2.Visible 	= tmpFormCaptions.lblSz2Vis
					ThisForm.lblSZ23.Caption 	= RTRIM(tmpFormCaptions.txt2)
					ThisForm.lblSZ23.Visible 	= tmpFormCaptions.lblSz2Vis
					
					ThisForm.lblDim31.Caption 	= RTRIM(tmpFormCaptions.txt3)
					ThisForm.lblDim31.Visible 	= tmpFormCaptions.lblSz3Vis
					ThisForm.lblSZ3.Caption 	= RTRIM(tmpFormCaptions.txt3)
					ThisForm.lblSZ3.Visible 	= tmpFormCaptions.lblSz3Vis
					ThisForm.lblSZ33.Caption 	= RTRIM(tmpFormCaptions.txt3)
					ThisForm.lblSZ33.Visible 	= tmpFormCaptions.lblSz3Vis
					
					ThisForm.txtDim3.Visible 	= tmpFormCaptions.use3rdDim
					ThisForm.txtDim3.Enabled 	= tmpFormCaptions.Sz3Enable
					
					ThisForm.txtDim3.Visible 	= tmpFormCaptions.use3rdDim
					ThisForm.txtQDim3.Enabled 	= tmpFormCaptions.Sz3Enable
					
					IF ThisForm.txtDim11.Visible
						ThisForm.txtDim31.Visible 	= tmpFormCaptions.use3rdDim
						ThisForm.txtDim31.Enabled 	= tmpFormCaptions.Sz3Enable
					
						ThisForm.txtDim32.Visible 	= tmpFormCaptions.use3rdDim
						ThisForm.txtDim32.Enabled 	= tmpFormCaptions.Sz3Enable
					ENDIF
					
					ThisForm.txtDim33.Visible 	= tmpFormCaptions.use3rdDim
					ThisForm.txtDim33.Enabled 	= tmpFormCaptions.Sz3Enable
					
					ThisForm.lblSZ4.Caption		= RTRIM(tmpFormCaptions.txt4)
					ThisForm.lblSZ4.Visible 	= tmpFormCaptions.lblSz4Vis
					
					
					USE IN tmpFormCaptions
				ELSE
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"tmpFormCaptions is not used!")
				ENDIF
			ELSE
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"GetFormCaptions returned False!")
			ENDIF
		ELSE
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"GetFormCaptions did not have a Form!")
		ENDIF
		
		IF NOT EMPTY(lCurrentTable)
			IF USED(lCurrentTable)
				SELECT (lCurrentTable)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Release
		RELEASE aConsumeQTY
		
	ENDPROC

	PROCEDURE sales_detail_consumestock
		*ThisForm.Sales_Detail_ConsumeStock()
		*** Save data to dbo.Sales_Detail
		*also see dbo.Sales_Stock in SaveStockLstEdit_to_Sales_Stock()
		*also see dbo.StockLst_Process_Grab
		
		PRIVATE lScrap 
		lScrap = .F.
		
		PRIVATE nID, nID_Detail, nID_Detail_Process
		nID					= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail			= ThisForm.nID_Detail
		nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3,0)
		
		PRIVATE nWO, nWO_Detail, cTBL
		*nWO	= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3,0)
		nWO			= PrepareSQLnum(ThisForm.nWO,'WO',-3,0)
		nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3,0)
		cTBL		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		
		PRIVATE cSOitem,cPOitem
		cSOitem	= ThisForm.cSOitem
		cPOitem = ThisForm.cPOitem
		
		*need PRIVATE nSales_Detail_ID
		
		*****************************
		*Get Stock Data: alloy,Form,Heat,Lot,CC,CL,S_P
		PRIVATE lOK
		lOK = .T.
		
		IF USED('tmpAlloyFormCC')
			USE IN tmpAlloyFormCC
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT M.Alloy,M.Form,M.Heat,M.Lot,M.CC,M.CL,M.Paid ,D.S_P ,D.RandLen"
		DO CASE
		CASE cTbl = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON D.ID = m.ID "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON D.ID = m.ID "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON D.ID = m.ID "
		ENDCASE
		cSQL = cSQL + " WHERE D.ID_Detail = "+ALLTRIM(STR(nID_Detail))
			
		PRIVATE cAlloy, cForm, cHeat, cLot, cCC, cCL, nS_P, lRandLen
		cAlloy	= ''
		cForm	= ''
		cHeat	= ''
		cLot	= ''
		cCC		= ''
		cCL		= ''
		nS_P	= 0
		lRandLen = .F.
		
		PRIVATE nStkPaid_P, nStkPaid_Total, nMasterPaid
		nStkPaid_P = 0
		nStkPaid_Total = 0
		nMasterPaid = 0
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyFormCC")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyFormCC")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpAlloyFormCC')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpAlloyFormCC')
				IF RECCOUNT("tmpAlloyFormCC") > 0
					cAlloy	= tmpAlloyFormCC.Alloy
					cForm	= PrepareSQLtxt(tmpAlloyFormCC.Form,'Form',2)
					cHeat	= PrepareSQLtxt(tmpAlloyFormCC.Heat,'Heat',50)
					cLot	= PrepareSQLtxt(tmpAlloyFormCC.Lot,'Lot',10)
					cCC		= PrepareSQLtxt(tmpAlloyFormCC.CC,'CC',1)
					cCL		= PrepareSQLtxt(tmpAlloyFormCC.CL,'CL',1)
					nStkPaid_P 	= PrepareSQLnum(tmpAlloyFormCC.Paid,'Paid',-5)
					IF cLot =  '0         '
						cLot = ''
					ENDIF
					nS_P		= PrepareSQLnum(tmpAlloyFormCC.S_P,'S_P',-5)
					lRandLen	= PrepareSQLlogic(tmpAlloyFormCC.RandLen,'RandLen')
					
				ENDIF
				USE IN tmpAlloyFormCC
			ENDIF
		ENDIF
		
		*****************************************************
		*Get new StockLst_Total  *Collect Screen data
		PRIVATE nStockLst_Qty,nStockLst_P,nStockLst_Total,nStockLst_PU, nWeight
		nStockLst_Qty	= PrepareSQLnum( ThisForm.txtQTY.Value,'StockLst_Qty',18,4)
		IF nStockLst_Qty = 0
			nStockLst_Qty	= PrepareSQLnum( ThisForm.txtS_QTY.Value,'StockLst_Qty',18,4)
		ENDIF
		
		nStockLst_P		= PrepareSQLnum( ThisForm.txtS_P.Value,'StockLst_P',-5) &&current Price per unit
		nStockLst_Total	= nStockLst_Qty * nStockLst_P
		
		nStockLst_PU	= PrepareSQLnum(ThisForm.txtS_PU.Value,'PU',-1)
		IF nStockLst_PU = 0
			IF NOT EMPTY(cForm)
				nStockLst_PU	=  PrepareSQLnum(getPUfromForm( cForm, ThisForm.nConnHandle ),'PU',-1)
			ENDIF
		ENDIF
		
		nWeight = PrepareSQLnum(ThisForm.txtWeight1.Value,'Weight',9,1)
		
		******* Verify PU before accepting the StockLst_QTY
		DO CASE 
		CASE nStockLst_PU = 1
			*Lb
			IF (nStockLst_Qty+10)*1.2 > nWeight+10
				IF (nStockLst_Qty+10) < (nWeight+10)*1.2
					*Within 20%
				ENDIF
			ENDIF
		CASE nStockLst_PU = 2
			*FT
		CASE nStockLst_PU = 3
			*PC
		CASE nStockLst_PU = 4
			*Lot
		OTHERWISE
			TrackError("Did not get a PU","Did not get a PU "+CHR(13)+"Form:"+cForm,PROGRAM(),LINENO(1))
		ENDCASE
		
		
		*****************************************************
		*Get new Dims from Screen
		PRIVATE nStk_PC,nStk_Dim1,nStk_Dim2,nStk_Dim3,nStk_QTY,nStk_LBS
		nStk_PC		= PrepareSQLnum( ThisForm.txtPC1.Value,'Pc',-3)
		nStk_Dim1	= PrepareSQLnum( ThisForm.txtDim11.Value,'Dim1',10,4)
		nStk_Dim2	= PrepareSQLnum( ThisForm.txtDim2.Value,'Dim2',9,3)
		nStk_Dim3	= PrepareSQLnum( ThisForm.txtDim3.Value,'Dim3',9,3)
		nStk_QTY	= PrepareSQLnum( ThisForm.txtS_QTY.Value,'QTY',-5)
		nStk_LBS	= PrepareSQLnum( ThisForm.txtWeight1.Value,'LBS',9,1)
		
		*****************************************************
		*WAIT WINDOW cSOitem NOWAIT
		IF Proper_SO_Item(cSOitem) != Proper_SO_Item('') OR nWO > 0
			*Check Alloy in selected Stock to Quote.SOitem or WorkOrder.WO
			PRIVATE cQAlloy, cQForm, cQCC, cQCL, nQDim1, lQRandLen
			cQAlloy	= ''
			cQForm	= ''
			cQCC	= ''
			cQCL	= ''
			nQDim1	= 0
			lRandLen = .F.
			
			IF nWO = 0
				cSQL = "SELECT Alloy,Form,CC,CL,Thck,Sz2,Sz3 ,RandLen "
				cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ELSE
				cSQL = "SELECT sAlloy AS Alloy,sForm AS Form,sCC AS CC,sCL AS CL,sThck AS Thck,sSz2 AS Sz2,sSz3 AS Sz3, 0 AS RandLen "
				cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) "
				cSQL = cSQL + " WHERE WO = "+STR(nWO)
			ENDIF
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQAlloyFormCC")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQAlloyFormCC")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpQAlloyFormCC')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpQAlloyFormCC')
					IF RECCOUNT("tmpQAlloyFormCC") > 0
						cQAlloy	= PrepareSQLtxt(tmpQAlloyFormCC.Alloy,'Alloy',12)
						cQForm	= PrepareSQLtxt(tmpQAlloyFormCC.Form,'Form',2)
						cQCC	= PrepareSQLtxt(tmpQAlloyFormCC.CC,'CC',1)
						cQCL	= PrepareSQLtxt(tmpQAlloyFormCC.CL,'CL',1)
						nQDim1	= PrepareSQLnum(tmpQAlloyFormCC.Thck,'Thck',10,4)
						lQRandLen = PrepareSQLlogic(tmpQAlloyFormCC.RandLen,'RandLen')
						&&See save code in SaveStockLstEdit_to_Sales_Stock()
						PRIVATE cMess				
						*reportConsumed_Ordered
						IF cQAlloy != cAlloy
							IF nWO = 0
								cMess = "Consumed Stock does not match Sales Order Item:"+cSOitem+CHR(13)
							ELSE
								cMess = "Consumed Stock does not match WorkOrder:"+STR(nWO)+CHR(13)
							ENDIF
							cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
							cMess = cMess + " Form Picked:"+cForm+"  Ordered:"+cQForm+CHR(13)
							cMess = cMess + "  Condition Code Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
							cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
							cMess = cMess + " Not Allowed to SAVE:Alloy"+CHR(13)
							TrackMess(LEFT(cMess,254))
							TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
							RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "Consumed Stock does not match Sales Order "+CHR(13)+cMess )
							
							MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE Alloy")
							lOK =.F.
						ENDIF
						
						***
						IF cForm = '40' AND tmpQAlloyFormCC.Form = '80' 
							*Normally Form 80 is from Plate, but can be from bar!!!
							cQForm	= cForm
						ENDIF
						IF cForm = '10' AND tmpQAlloyFormCC.Form = '80' 
							cQForm	= cForm
						ENDIF
						***
						
						IF cQForm != cForm AND lOK =.T. AND cForm!='80'  &&cQForm is corrected but Stock may still be listed as 80
							IF nWO = 0
								cMess = "Consumed Stock does not match Sales Order Item:"+cSOitem+CHR(13)
							ELSE
								cMess = "Consumed Stock does not match WorkOrder:"+STR(nWO)+CHR(13)
							ENDIF
							cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
							cMess = cMess + " Form Picked:"+cForm+"  Ordered:"+cQForm+CHR(13)
							cMess = cMess + "  Condition Code Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
							cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
							
							PRIVATE lProduction
							lProduction = .F.
							IF nWO > 0
								*lProduction = CheckWOforProduction(nWO,ThisForm.nConnHandle)
								lProduction = .T.  &&WorkOrders are Production
							ELSE
								lProduction = CheckSOforProduction(cSOitem,ThisForm.nConnHandle)
							ENDIF
							
							IF lProduction
								*Production is allowed to change product form.
							ELSE
								IF NOT (cQForm = '0' OR cQForm = '21' OR cQForm = '22' OR cQForm = '51' OR cQForm = '52' OR cQForm = '53' OR cQForm = '80' OR  cQForm = '90' OR cQForm = '95' OR cQForm = '96' OR cQForm = '97' OR cQForm = '98' OR cQForm = '99' )	
									cMess = cMess + " Allowed to SAVE:Standard Form"+CHR(13)
									TrackMess(LEFT(cMess,254))
									TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
									RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "Consumed Stock does not match Sales Order "+CHR(13)+cMess )
									MESSAGEBOX(cMess,16,"Allowed to SAVE:Standard Form")
									lOK =.T.
								ELSE
									cMess = cMess + " Allowed to SAVE:Unusual Form"+CHR(13)
									TrackMess(LEFT(cMess,254))
									*TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Order",PROGRAM(),LINENO(1))
									*MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE!")
									*lOK =.F.				
									TrackError(cMess,"Consumed Stock does not match Order",PROGRAM(),LINENO(1))
									RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "Consumed Stock does not match Order "+CHR(13)+cMess+CHR(13)+cSQL )
									MESSAGEBOX(cMess,16,"Allowed to SAVE!")
									lOK =.T.	
		
								ENDIF				
							ENDIF
						ENDIF
					ENDIF
					
					USE IN tmpQAlloyFormCC
					
					IF NOT lOK
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************************************
		PRIVATE nStkPaid_P
		nStkPaid_P = 0
		nStkPaid_P = getInvoiceValue_ID_Detail( nID_Detail,cTBL,ThisForm.nConnHandle )
		
		*******************
		*Check tmpStkSum
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "NOT USED('tmpStkSum') "+CHR(13)+"Please Enter each item removed from this Detail record "+CHR(13)+"Need a Remove Summary")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpStkSum') < 1
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "RECCOUNT('tmpStkSum') < 1 "+CHR(13)+"Please Enter each item removed from this Detail record "+CHR(13)+"Need a Remove Summary")
			RETURN .F.
		ENDIF
		
		**************************************************************************************************************************************
		*  dbo.Sales_Stock
		**************************************************************************************************************************************
		
		PRIVATE cSQLid, nSales_Stock_ID
		PRIVATE nRemoved_PC,nRemoved_Dim1,nRemoved_Dim2,nRemoved_Dim3,nRemoved_Qty,nRemoved_LBS,nRemoved_Paid_Total,nRemoved_Total
		
		PRIVATE cMess, nMess, lUpdateSales_Stock
		cMess = ''
		nMess = 0
		lUpdateSales_Stock = .F.
		
		IF lOK
			SELECT tmpStkSum
			SCAN
				*Remove Detail_Stock selected	
				nRemoved_PC		= PrepareSQLnum(tmpStkSum.PCs,'PC',-3)
				nRemoved_Dim1	= PrepareSQLnum(tmpStkSum.Dim1,'Dim1',10,4)
				nRemoved_Dim2	= PrepareSQLnum(tmpStkSum.Dim2,'Dim2',9,4)
				nRemoved_Dim3	= PrepareSQLnum(tmpStkSum.Dim3,'Dim3',9,4)
				nRemoved_Qty	= PrepareSQLnum(tmpStkSum.QTY,'QTY',18,4)
				nRemoved_LBS	= PrepareSQLnum(tmpStkSum.Weight,'Weight',8,1)
				nRemoved_Paid_Total	= nRemoved_Qty * nStkPaid_P
				nRemoved_Total	= nRemoved_Qty * nStockLst_P
				nStockLst_Total = nRemoved_Qty * nStockLst_P
		
				
				**
				IF nRemoved_LBS = 0
					DO CASE
					CASE nStockLst_PU = 1
						nRemoved_LBS	= nRemoved_Qty
					CASE nStockLst_PU = 2
						*Calc /FT weight
					 	*nRemoved_LBS = CalcWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					 	nRemoved_LBS = GetWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					CASE nStockLst_PU = 3
						*Calc /PC Weight
					 	*nSale_LBS = GetWeight(nStk_PC, cAlloy, cForm, nStk_Dim1, nStk_Dim2, nStk_Dim3, ThisForm.nConnHandle)
					 	*No weight chart ready fasteners/fittings
						nRemoved_LBS	= nRemoved_PC
					OTHERWISE
						nRemoved_LBS= 0
					ENDCASE
				ENDIF
				**
				
				
				*******************
				*A SO can be shipped to the customer.  
				*A WO modifying or Consuming Stock will not ship to a customer
				*Check for PackingSlip that was created before Shop Stock Edit!!
				PRIVATE cSQL, nSQLEXEC 
				*WAIT WINDOW cSOitem NOWAIT
				IF cSOitem = Proper_SO_item('')
					IF nWO = 0
						MESSAGEBOX("No WorkOrder or SOitem",16,"Error")
						TrackError("No WorkOrder or SOitem","No WorkOrder or SOitem",PROGRAM(),LINENO(1))
					ENDIF
				ELSE
					IF USED('tmpSales_StockP')
						USE IN tmpSales_StockP
					ENDIF
					SELECT 0
		
					cSQL = "SELECT PackingSli,PS_PC,PS_Form,PS_Dim1,PS_Dim2,PS_Dim3,PS_Lbs,WO,Heat,Lot "
					cSQL = cSQL + " ,Orig_QTY,Orig_P,Orig_Total,Orig_PC"
					cSQL = cSQL + " ,Orig_Dim1,Orig_Dim2,Orig_Dim3,Orig_LBS,ID "
					cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
					cSQL = cSQL + " AND ISNULL(StockEdit,0) = 0"
					cSQL = cSQL + " AND ISNULL(PackingSli,0)>0 "
					cSQL = cSQL + " AND ISNULL(Removed_Qty,0) = 0"  &&Removed QTY needs to be updated
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_StockP")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_StockP")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_StockP')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						lOK =.F.
					ENDIF
		
		
					*SCAN tmpStkSum
					IF USED('tmpSales_StockP')
