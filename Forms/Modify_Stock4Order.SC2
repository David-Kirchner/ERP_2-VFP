					cSQLid = cSQLid+ ",Orig_LBS="+STR(nStk_LBS,15,1)
					cSQLid = cSQLid+ ",StkPaid_P="+STR(nStkPaid_P,18,4)
					cSQLid = cSQLid+ ",StkPaid_Total="+STR(nRemoved_Paid_Total,18,4)
		
					*cSQLid = cSQLid+ ",Sales_Detail_ID="+STR(nSales_Detail_ID)
					
					cSQLid = cSQLid+ ",Left_PC="+STR(nStk_PC,10)  &&Orig
					cSQLid = cSQLid+ ",Left_Dim1="+STR(nStk_Dim1,10,4)
					cSQLid = cSQLid+ ",Left_Dim2="+STR(nStk_Dim2,9,3)
					cSQLid = cSQLid+ ",Left_Dim3="+STR(nStk_Dim3,9,3)
					cSQLid = cSQLid+ ",Left_LBS="+STR(nStk_LBS,9,1)
