	PROCEDURE stocklst_process_consume
		PARAMETER cTBL,nID_Detail
		
		* Edit the Grab Found Stk Process as Consumed
		
		*!*	-- Mark StockLst_Process_Grab as Gone on Delete of ID_Detail
		
		**********************************
		*get Process3 data --Use to update Process --this data is better than what the Process had.
		PRIVATE nCalcQTY3, nCalcLBS3, nPieces3, cAlloy3, cForm3, nSize13, nSize23, nSize33, nStockLst_PU3
		nPieces3	= PrepareSQLnum(ThisForm.txtPC3.Value,'Pieces',-3)
		cAlloy3	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cForm3	= PrepareSQLtxt(ThisForm.txtForm3.Value,'Form',2)
		nSize13	= PrepareSQLnum(ThisForm.txtDim13.Value,'DIM1',10,4)
		nSize23	= PrepareSQLnum(ThisForm.txtDim23.Value,'DIM2',9,3)
		nSize33	= PrepareSQLnum(ThisForm.txtDim33.Value,'DIM3',9,3)
		nStockLst_PU3 = PrepareSQLnum(ThisForm.txtS_PU.Value,'PU',-1)
		
		nCalcQTY3 = GetUnitQty(nPieces3, cAlloy3, cForm3, nSize13, nSize23, nSize33, ThisForm.nConnHandle)
		nCalcLBS3 = GetWeight(nPieces3, cAlloy3, cForm3, nSize13, nSize23, nSize33, ThisForm.nConnHandle)
		
		
		PRIVATE cSQL,nSQLEXEC 
		IF USED("tmpProcess_Grabd")
			USE IN tmpProcess_Grabd
		ENDIF
		SELECT 0
		
		IF nID_Detail > 0
			DO CASE
			CASE cTBL="S"
				cSQL = "UPDATE dbo.StockLst_Process_Grab "
			CASE cTBL="B"
				cSQL = "UPDATE dbo.BrokerLst_Process_Grab "
			CASE cTBL="W"
				cSQL = "UPDATE dbo.WIPLst_Process_Grab "
			ENDCASE	
			cSQL=cSQL+" SET [MS4O] = 1"
			
		    cSQL=cSQL+",[QTY]="+STR(nCalcQTY3)
		    cSQL=cSQL+",[Pounds]="+STR(nCalcLBS3,8,1)
		    cSQL=cSQL+",[Prc_Form]='"+cForm3+"'"
		    cSQL=cSQL+",[Prc_PCs]="+STR(nPieces3)
		    cSQL=cSQL+",[Prc_Dim1]="+STR(nSize13,10,4)
		    cSQL=cSQL+",[Prc_Dim2]="+STR(nSize23,9,3)
		    cSQL=cSQL+",[Prc_Dim3]="+STR(nSize33,9,3)
		
		    *cSQL=cSQL+",[SS_ID]="+STR(nSales_Stock_ID)
			*cSQL=cSQL+",[_ID]="+STR()
			    
			cSQL=cSQL+" WHERE ID_Detail ="+STR(nID_Detail)
			cSQL=cSQL+" AND ID_Detail_Process ="+STR(ThisForm.nID_Detail_Process)
				
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess_Grabd' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess_Grabd' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess_Grabd')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess_Grabd')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcess_Grabd")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcess_Grabd")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpProcess_Grabd')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				
			ENDIF
		
			IF USED("tmpProcess_Grabd")
				USE IN tmpProcess_Grabd
			ENDIF
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE trackuseredit
		PARAMETERS cMess
		*Thisform.TrackUserEdit(cMess)
		
		cMess = PrepareSQLtxt(cMess,'UserEdit',-1)
		
		PRIVATE cMessOld
		cMessOld = ShowSQLtxt(ThisForm.edtUserEdit.Value,'UserEdit',-1)
		
		IF LEN( cMessOld ) = 0
			ThisForm.edtUserEdit.Value = cMess
		ELSE
			ThisForm.edtUserEdit.Value = cMess +". " + CHR(13) + cMessOld
		ENDIF
		
	ENDPROC

