			ThisForm.lblLen.VISIBLE = .F.
			ThisForm.lblLocation1.VISIBLE = .F.
			ThisForm.lblFloorStatus1.VISIBLE = .F.
			ThisForm.lblMic1.VISIBLE = .F.
			ThisForm.lblDesctript1.VISIBLE = .F.
		
		*	ThisForm.txtPc1.VISIBLE = .F.
		*	ThisForm.txtDIM11.VISIBLE = .F.
		*	ThisForm.txtDIM21.VISIBLE = .F.
		*	ThisForm.txtDIM31.VISIBLE = .F.
			ThisForm.txtLength1.VISIBLE = .F.
		*	ThisForm.txtWeight1.VISIBLE = .F.
		*	ThisForm.txtS_Qty.VISIBLE = .F.
		*	ThisForm.txtS_P.VISIBLE = .F.
		*	ThisForm.txtS_PU.VISIBLE = .F.
		*	ThisForm.txtClass1.Visble = .F.
			
			ThisForm.txtPc2.VISIBLE = .F.
			ThisForm.txtDIM22.VISIBLE = .F.
			ThisForm.txtDIM32.VISIBLE = .F.
			ThisForm.txtWeight2.VISIBLE = .F.
			ThisForm.lblUsedQuantity.VISIBLE = .F.
			ThisForm.shpHltBar.VISIBLE = .F.
		*	ThisForm.cmdReset.Visible = .F.
			
		*	ThisForm.txtLocation1.VISIBLE = .F.
			ThisForm.cmbLocation1.ENABLED = .F.
			ThisForm.cmbLocation1.Visible = .F.
			ThisForm.txtFloorStatus1.VISIBLE = .F.
		
			ThisForm.txtSize_H1.VISIBLE = .F.
			ThisForm.txtSize_L1.VISIBLE = .F.
			ThisForm.txtDescript1.VISIBLE = .F.
			ThisForm.chkMarkInvCheck.Visible = .F.
			ThisForm.chkPrime.Visible = .F.
			ThisForm.chkRandLen.Visible = .T.
			
		CASE cHow = "EDIT" OR cHow = "ADD"
			
			ThisForm.cmdConsumeStock.Enabled = .F.
			ThisForm.cmdEdit.Enabled = .F.
			ThisForm.cmdAdd.Enabled = .F.
