		*now have nSales_Stock_ID 
		
		**************************
		*
		lOK = ThisForm.Save_WorkOrder_Stock()	
		*	
		************************************************************************************************************************************
		*  dbo.Sales_Detail 
		* Need to down size: dbo.Sales_Stock dbo.Sales_Detail dbo.StockLst_Process_Grab
		* dbo.Sales_Stock will have Process_Grab_ID INT and Sales_Detail_ID INT
		* dbo.StockLst_Process_Grab will have SS_ID INT
		* get RID of dbo.Sales_Detail????   
		*--but Sales_Detail has a Sales_Detail_PackingSlip for when it is packed before it has been taken off Stock
		************************************************************************************************************************************
		
		IF lOK
			*Get AllQuote date, INSERT Into Sales_Detail
			PRIVATE nSalesNum
			nSalesNum = VAL(cSOitem)
			
			PRIVATE nQuoted_PC,nQuoted_Dim1,nQuoted_Dim2,nQuoted_Dim3,nQuoted_LBS,nQuoted_Qty
			*Default to tmpStkSum, if found in Allquotes, Overwrite.
			
			SELECT tmpStkSum
			SCAN
				
				nRemoved_PC		= PrepareSQLnum(tmpStkSum.PCs,'PC',-3)
				nRemoved_Dim1	= PrepareSQLnum(tmpStkSum.Dim1,'Dim1',10,4)
				nRemoved_Dim2	= PrepareSQLnum(tmpStkSum.Dim2,'Dim2',9,3)
				nRemoved_Dim3	= PrepareSQLnum(tmpStkSum.Dim3,'Dim3',9,3)
				nRemoved_Qty	= PrepareSQLnum(tmpStkSum.QTY,'QTY',-5)
				nRemoved_LBS	= PrepareSQLnum(tmpStkSum.Weight,'LBS',9,1)
				
				**
				IF nRemoved_LBS = 0
					DO CASE
					CASE nStockLst_PU = 1
						*LBS is QTY
						nRemoved_LBS	= nRemoved_Qty
					CASE nStockLst_PU = 2
						*Calc /FT weight
					 	*nRemoved_LBS = CalcWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					 	nRemoved_LBS = GetWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					CASE nStockLst_PU = 3
						*Calc /PC Weight
					 	*nSale_LBS = GetWeight(nStk_PC, cAlloy, cForm, nStk_Dim1, nStk_Dim2, nStk_Dim3, ThisForm.nConnHandle)
					 	*No weight chart ready fasteners/fittings
						nRemoved_LBS	= nRemoved_PC
					OTHERWISE
						nRemoved_LBS= 0
					ENDCASE
				ENDIF
				**
				
				IF nRemoved_Qty = 0
					nRemoved_Total	= nRemoved_LBS * nStockLst_P
				ELSE
					nRemoved_Total	= nRemoved_Qty * nStockLst_P
				ENDIF
				
				*Go to AllQuotes for Values
				IF USED('tmpAQpc')
					USE IN tmpAQpc
				ENDIF
				SELECT 0
				
				cSQL = "SELECT [Pieces] AS PC, [Thck] AS Dim1, [Weight], dbo.f_Get_QTY_SOitem(SOitem) as Quoted_QTY, cWeight "
				cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQpc')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQpc')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQpc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQpc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL , ThisForm.nConnHandle,nSQLEXEC,'tmpAQpc')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
				
				IF USED('tmpAQpc')
					IF RECCOUNT('tmpAQpc')>0
						nQuoted_PC	= PrepareSQLnum(tmpAQpc.PC,'PC',-3)
						nQuoted_Dim1= PrepareSQLnum(tmpAQpc.Dim1,'Dim1',10,4)
						nQuoted_LBS	= PrepareSQLnum(tmpAQpc.Weight,'Weight',9,1)
						nQuoted_Qty	= PrepareSQLnum(tmpAQpc.Quoted_QTY,'Quoted_QTY',-5)
						nQuoted_LBS	= PrepareSQLnum(tmpAQpc.cWeight,'cWeight',-5)
					ENDIF
					USE IN tmpAQpc
				ENDIF
				*WAIT WINDOW cSOitem NOWAIT
				IF NOT ( Proper_SO_Item(cSOitem) = Proper_SO_Item('') AND nWO = 0 )
					
					cSQLid = "INSERT INTO dbo.Sales_Detail ("
					cSQLid = cSQLid+ " SOitem"   
					cSQLid = cSQLid+ ",SalesNum"   
					cSQLid = cSQLid+ ",WO"   
					
					cSQLid = cSQLid+ ",Quoted_PC"
					cSQLid = cSQLid+ ",Quoted_Dim1"
					cSQLid = cSQLid+ ",Quoted_LBS"
					cSQLid = cSQLid+ ",Quoted_Qty"
					
		*			cSQLid = cSQLid+ ",StockLst_Qty"  &depricatd
		*			cSQLid = cSQLid+ ",StockLst_P"
		*			cSQLid = cSQLid+ ",StockLst_Total"
		*			cSQLid = cSQLid+ ",StockLst_PU"
		*			
		*			cSQLid = cSQLid+ ",StockLst_PC"
		*			cSQLid = cSQLid+ ",StockLst_Dim1"
		*			cSQLid = cSQLid+ ",StockLst_Dim2"
		*			cSQLid = cSQLid+ ",StockLst_Dim3"
		*		    cSQLid = cSQLid+ ",StockLst_LBS"
		
					cSQLid = cSQLid+ ",Removed_PC"
					cSQLid = cSQLid+ ",Removed_Dim1"
					cSQLid = cSQLid+ ",Removed_Dim2"
					cSQLid = cSQLid+ ",Removed_Dim3"
				    cSQLid = cSQLid+ ",Removed_LBS"
				    cSQLid = cSQLid+ ",Removed_Qty"
				    cSQLid = cSQLid+ ",Removed_Paid_Total"
				    cSQLid = cSQLid+ ",Removed_Total"
				    
					cSQLid = cSQLid+ ",Alloy"
					cSQLid = cSQLid+ ",Form"
					cSQLid = cSQLid+ ",Heat"
					cSQLid = cSQLid+ ",Lot"
				    cSQLid = cSQLid+ ",CC"
					cSQLid = cSQLid+ ",CL"
		
					cSQLid = cSQLid+ ",TBL"
					cSQLid = cSQLid+ ",StockLst_ID"
					cSQLid = cSQLid+ ",StockLst_ID_Detail"
					cSQLid = cSQLid+ ",ID_Detail_Process"
				    cSQLid = cSQLid+ ",StockEdit"
				    
					cSQLid = cSQLid+ ",StkPaid_P"
					cSQLid = cSQLid+ ",StkPaid_Total"
					
					cSQLid = cSQLid+ ",Orig_Qty"  
					cSQLid = cSQLid+ ",Orig_P"
					cSQLid = cSQLid+ ",Orig_Total"
					cSQLid = cSQLid+ ",Orig_PU"
					
					cSQLid = cSQLid+ ",Orig_PC"
					cSQLid = cSQLid+ ",Orig_Dim1"
					cSQLid = cSQLid+ ",Orig_Dim2"
					cSQLid = cSQLid+ ",Orig_Dim3"
				    cSQLid = cSQLid+ ",Orig_LBS"
				    
					cSQLid = cSQLid+ ") VALUES ("
					cSQLid = cSQLid+ "'"+cSOitem+"'"
					cSQLid = cSQLid+ ","+STR(nSalesNum) 
					cSQLid = cSQLid+ ","+STR(nWO) 
					
					cSQLid = cSQLid+ ","+STR(nQuoted_PC)
					cSQLid = cSQLid+ ","+STR(nQuoted_Dim1,10,4)
					cSQLid = cSQLid+ ","+STR(nQuoted_LBS,9,1)
					cSQLid = cSQLid+ ","+STR(nQuoted_Qty,18,4)
		
		*			cSQLid = cSQLid+ ","+STR(nStockLst_QTY,18,4)	&Depricated
		*			cSQLid = cSQLid+ ","+STR(nStockLst_P,18,4)
		*			cSQLid = cSQLid+ ","+STR(nRemoved_Total,18,4)
		*			cSQLid = cSQLid+ ","+STR(nStockLst_PU)		
		*
		*			cSQLid = cSQLid+ ","+STR(tmpStkSum.PCs,10)
		*			cSQLid = cSQLid+ ","+STR(tmpStkSum.Dim1,10,4)
		*			cSQLid = cSQLid+ ","+STR(tmpStkSum.Dim2,9,3)
		*			cSQLid = cSQLid+ ","+STR(tmpStkSum.Dim3,9,3)
		*		    cSQLid = cSQLid+ ","+STR(tmpStkSum.Weight,9,1)
		
					cSQLid = cSQLid+ ","+STR(nRemoved_PC,10,0)
					cSQLid = cSQLid+ ","+STR(nRemoved_Dim1,10,4)
					cSQLid = cSQLid+ ","+STR(nRemoved_Dim2,9,3)
					cSQLid = cSQLid+ ","+STR(nRemoved_Dim3,9,3)
				    cSQLid = cSQLid+ ","+STR(nRemoved_LBS,9,1)
				    cSQLid = cSQLid+ ","+STR(nRemoved_Qty,18,4)
				    cSQLid = cSQLid+ ","+STR(nRemoved_Paid_Total,18,4)
					cSQLid = cSQLid+ ","+STR(nRemoved_Total,18,4)
		
					cSQLid = cSQLid+ ",'"+cAlloy+"'"
					cSQLid = cSQLid+ ",'"+cForm+"'"
					cSQLid = cSQLid+ ",'"+cHeat+"'"
					cSQLid = cSQLid+ ",'"+cLot+"'"
				    cSQLid = cSQLid+ ",'"+cCC+"'"
				    cSQLid = cSQLid+ ",'"+cCL+"'"
				    
					cSQLid = cSQLid+ ",'"+IIF(UPPER(cTbl)="S","S","B")+"'"
					cSQLid = cSQLid+ ","+STR(nID)
					cSQLid = cSQLid+ ","+STR(nID_Detail)
					cSQLid = cSQLid+ ","+STR(nID_Detail_Process)
					cSQLid = cSQLid+ ","+STR(nSales_Stock_ID)
				    cSQLid = cSQLid+ ",GetDate()" &&StockEdit
				    		
					cSQLid = cSQLid+ ","+STR(nStkPaid_P,18,4)
					cSQLid = cSQLid+ ","+STR(Removed_Paid_Total,18,4)
					
					cSQLid = cSQLid+ ","+STR(nStockLst_QTY,18,4)	
					cSQLid = cSQLid+ ","+STR(nStockLst_P,18,4)
					cSQLid = cSQLid+ ","+STR(nRemoved_Total,18,4)
					cSQLid = cSQLid+ ","+STR(nStockLst_PU)		
		
					cSQLid = cSQLid+ ","+STR(tmpStkSum.PCs,10)
					cSQLid = cSQLid+ ","+STR(tmpStkSum.Dim1,10,4)
					cSQLid = cSQLid+ ","+STR(tmpStkSum.Dim2,9,3)
					cSQLid = cSQLid+ ","+STR(tmpStkSum.Dim3,9,3)
				    cSQLid = cSQLid+ ","+STR(tmpStkSum.Weight,9,1)
		
					cSQLid = cSQLid+ ")"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLid, ThisForm.nConnHandle,nSQLEXEC)
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLid )
						*lOK = .F.
					ENDIF
					
					***********************************************
					*WAIT WINDOW cSOitem NOWAIT
					IF Proper_SO_Item(cSOitem) = Proper_SO_Item('')
						IF USED('tmpSales_Detail_PackingSlip')
							USE IN Sales_Detail_PackingSlip 
						ENDIF
						
						*See if PackingSlip is found
						cSQL = "SELECT COUNT(*) AS CNTD "
						cSQL = cSQL +" FROM dbo.Sales_Detail_PackingSlip WITH(NOLOCK) "
						cSQL = cSQL +" WHERE SOitem = '"+cSOitem+"'"
						*cSQL = cSQL +" AND Heat = '"+cHeat+"'"
						*cSQL = cSQL +" AND Lot = '"+cLot+"'"
						SELECT 0
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_PackingSlip')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_PackingSlip')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_PackingSlip')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_Detail_PackingSlip')
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Detail_PackingSlip")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Detail_PackingSlip")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Detail_PackingSlip')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						ENDIF
						IF USED('tmpSales_Detail_PackingSlip')
							IF RECCOUNT('tmpSales_Detail_PackingSlip')>0
								
								IF RECCOUNT('tmpSales_Detail_PackingSlip')>1
									IF LEN(cHeat)>0
										LOCATE FOR Heat = cHeat
										IF FOUND('tmpSales_Detail_PackingSlip')
											IF LEN(cLott)>0
												LOCATE FOR Heat = cHeat AND Lot = cLot
												IF FOUND('tmpSales_Detail_PackingSlip')
												*
												ELSE
												*	Go back to just Heat
													LOCATE FOR Heat = cHeat
												ENDIF							
											ENDIF
										ENDIF
									ENDIF
									
									MESSAGEBOX("Found Packing Slip record for this SOitem '"+cSOitem+"'"+CHR(13)+"View the records now and correct for Accounting."+CHR(13)+"Connect this SO Item Stock edit to the Proper Packing Slip. "+CHR(13)+"If you find a match, select the Packing Slip record with this 'Removed Stock'."+CHR(13)+"A new window will open.",64,"Select the Packing Slip records with this Sales_Detail.")
								ENDIF
								
								DO FORM Forms\ChooseSD_PackingSli WITH cSOitem, nSales_Stock_ID 
								
							ENDIF
							USE IN tmpSales_Detail_PackingSlip
						ENDIF
		
					ELSE
						*No PackingSlip on WorkOrder
					ENDIF
					***********************************************
				ENDIF
			ENDSCAN
		ENDIF
		
		IF lOK 
			*WAIT WINDOW cSOitem NOWAIT
			IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
				** Sales_Cost Delete and Update have a trigger! 
				** no after insert trigger!
				
				**Update Sales with the new Sales_Stock Cost data!
				*cSQL = "EXEC dbo.p_Sales_Stock_UPDATE_Sales( dbo.f_ProperSOitem('"+cSOitem+"') )"
				cSQL = "EXEC dbo.p_Sales_Stock_UPDATE_Sales '"+cSOitem+"'"
		
		
		*!*	SET @StkCost_Sales = ISNULL(dbo.f_CalcStkCost_Sales_Stock(@SOitem),0)
		*!*	SELECT @StkCost_Select = ISNULL(dbo.f_CalcStkCost_SOitem(@SOitem),0)
		*!*	SELECT @POCost = ISNULL(dbo.f_CalcPOCost_SOitem(@SOitem),0)
		*!*	SELECT @ItemCost = ( @StkCost_Select + @StkCost_Sales + @POCost )
		
		*!*	UPDATE dbo.Sales
		*!*		SET ItemCost = @ItemCost
		*!*		,StkCost = ( @StkCost_Select + @StkCost_Sales )
		*!*		,POCost = @POCost
					
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, '')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
			ENDIF	
		ENDIF
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE savestockdetail
		PARAMETERS plScrapOverRide
		*ThisForm.SaveStockDetail(lScrap)
		*Creates a Sales_Detail Record.  Needed even if scrapping!
		*Comes from cmdSave.Valid or cmdScrap.Valid
		
		IF VARTYPE(plScrapOverRide) != "L"
			plScrapOverRide = .F.
		ENDIF
		PRIVATE lScrapOverRide
		IF plScrapOverRide
			lScrapOverRide = .T.
			*scrap this
		ELSE
			lScrapOverRide = .F.
		ENDIF
		
		*****************
		PRIVATE lOK, cSOitem, nWO, cPOitem
		lOK = .T.
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)	&&ThisForm.cSOitem
		cSOitem	= Proper_SO_Item(cSOItem)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		cPOitem = ThisForm.cPOitem
		
		*****************
		PRIVATE m.nID1,m.nID_Detail,m.nID_Detail_Process
		m.nID1 			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		m.nID_Detail	= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		m.nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		IF m.nID1 = 0 
			MESSAGEBOX("Can not Change!",4,"Lost StockLst ID!")
			TrackError("frmModiStockLst.cmdSave()","No ID_Detail value",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF m.nID_Detail = 0 AND NOT lScrapOverRide 
			MESSAGEBOX("Can not Change!",4,"Lost StockLst ID_Detail!")
			TrackError("frmModiStockLst.cmdSave()","No ID_Detail value",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		
		IF TYPE("cTBL") <> "C"
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			TrackError("frmModiStockLst.cmdSave.click()","No TBL value",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF EMPTY(cTBL)
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			TrackError("frmModiStockLst.SaveStockDetail()","no TBL value",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		*- Needs full Tbl coding
		
		****************
		PRIVATE cSQL, cSQLs, cSQLid, cSQLdd, nSQLEXEC 
		PRIVATE nPC,nSize_H,nDim1,nSize_L,nDim2,nDim3,nWeight,cDescript,cLength
		PRIVATE nStk_P,cFloorStatus,cClass,cLocation
		PRIVATE nReceivingID, nInvoiceValue
		PRIVATE lMarkInvCheck, lPrime, lRandLen &&Not used yet!
		*frmModify_StockLst_Detail
		nPC			= PrepareSQLnum(ThisForm.txtPc1.Value,'Pc',-3)
		nSize_H		= PrepareSQLnum(ThisForm.txtSize_H1.Value,'Size_H',-5)
		nDim1		= PrepareSQLnum(ThisForm.txtDim11.Value,'Dim1',-5)
		nSize_L		= PrepareSQLnum(ThisForm.txtSize_L1.Value,'Size_L',-5)
		nDim2		= PrepareSQLnum(ThisForm.txtDim21.Value,'Dim2',-5)
		nDim3		= PrepareSQLnum(ThisForm.txtDim31.Value,'Dim3',-5)
		nWeight		= PrepareSQLnum(ThisForm.txtWeight1.Value,'Weight',9,1)
		cDescript	= PrepareSQLtxt(ThisForm.txtDescript1.Value,'Descript',20)
		cLength		= PrepareSQLtxt(ThisForm.txtLength1.Value,'Length',160)
		nStk_P		= PrepareSQLnum(ThisForm.txtStk_P.Value,'Stk_P',-5)
		cFloorStatus= PrepareSQLtxt(ThisForm.txtFloorStatus1.Value,'FloorStatus',1)
		cClass		= PrepareSQLtxt(ThisForm.txtClass1.Value,'Class',1)
		*cLocation	= PrepareSQLtxt(ThisForm.txtLocation1.Value,'Location',10)
		cLocation	= PrepareSQLtxt(ThisForm.cmbLocation1.Value,'Location',10)
		lMarkInvCheck	= PrepareSQLlogic(ThisForm.chkMarkInvCheck.Value,'MarkInvCheck',.F.)
		lPrime			= PrepareSQLlogic(ThisForm.chkPrime.Value,'Prime',.F.)
		lRandLen 		= PrepareSQLlogic(ThisForm.chkRandLen.Value,'RandLen')
		nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		nInvoiceValue	= PrepareSQLnum(ThisForm.txtInvoiceValue.Value,'InvoiceValue',-5)
		*lRandLen = .F.
		
		
		*Collect Screen Stock Sizes
		PRIVATE nPC_OLD, nDim1_OLD, nDim2_OLD, nWeight_OLD, nQTY_Old, nWeight_Calc
		nPC_OLD		= PrepareSQLnum( ThisForm.txtPc.Value,'PC',-3)
		nDim1_OLD	= PrepareSQLnum( ThisForm.txtDim1.Value,'Dim1',-5)
		nDim2_OLD	= PrepareSQLnum( ThisForm.txtDim2.Value,'Dim2',-5)
		nWeight_OLD	= PrepareSQLnum( ThisForm.txtWeight.Value,'Pounds',9,1)
		nQTY_Old	= PrepareSQLnum( ThisForm.txtQTY.Value,'QTY',-5)
		nWeight_Calc = PrepareSQLnum( ThisForm.lblCalcPounds.Caption,'Pounds',9,1)
		
		PRIVATE nQTY_NEW, nPC_NEW,nDim1_NEW,nDim2_NEW,nDim3_NEW
		nPC_NEW		= PrepareSQLnum( ThisForm.txtPC1.Value,'PC',-3)
		nDim1_NEW	= PrepareSQLnum( ThisForm.txtDim11.Value,'Dim1',-5)
		nDim2_NEW	= PrepareSQLnum( ThisForm.txtDim21.Value,'Dim2',-5)
		nDim3_NEW	= PrepareSQLnum( ThisForm.txtDim31.Value,'Dim3',-5)
		nQTY_NEW	= PrepareSQLnum( ThisForm.txtS_QTY.Value,'S_Qty',-5)
		**
		PRIVATE nStockLst_QTY, nStockLst_P, nS_Total
		nStockLst_QTY	= PrepareSQLnum( ThisForm.txtS_QTY.Value,'S_QTY',-5)
		nStockLst_P		= PrepareSQLnum( ThisForm.txtS_P.Value,'S_P',-5)
		IF nStockLst_P = 0
			nStockLst_P = nStk_P
		ENDIF
		nS_Total		= nStockLst_QTY * nStockLst_P
		PRIVATE cForm, nS_PU
		cForm 	= getFormbyMasterID( m.nID1, cTBL, ThisForm.nConnHandle)
		nS_PU	= GetPUfromForm(cForm, ThisForm.nConnHandle)
		
		*******************************************
		*Check Values
		PRIVATE cMess
		cMess =''
		PRIVATE lAddStockBack
		lAddStockBack = .T.
		
		IF ThisForm.Modify_StockLst_How = "ADD"
			lAddStockBack = .T.
		ENDIF
		IF EMPTY(ThisForm.Modify_StockLst_How)
			ThisForm.Modify_StockLst_How = "EDIT"
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1), "Bad ThisForm.Modify_StockLst_How "+CHR(13)+"Set to 'EDIT'" )
		ENDIF
		
		
		*IF lRandLen
		
		IF NOT lScrapOverRide 
			IF nWeight > 0
				IF nWeight_OLD > 0
					IF nWeight > nWeight_OLD +1
						IF lAddStockBack
							IF EMPTY(cMess)
								cMess = "Weight is Odd"+CHR(13)+"Weight "+ALLTRIM(STR(nWeight))+"# for Master is now greater than"+CHR(13)+"before you added Stock BACK! "+ALLTRIM(STR(nWeight_OLD))+"#"
							ELSE
								cMess = cMess+CHR(13)+"Weight is Odd"+CHR(13)+"Weight "+ALLTRIM(STR(nWeight))+"# for Master is now greater than"+CHR(13)+"before you added Stock BACK! "+ALLTRIM(STR(nWeight_OLD))+"#"
							ENDIF	
						ELSE
							IF EMPTY(cMess)
								cMess = "Weight is Odd"+CHR(13)+"Weight "+ALLTRIM(STR(nWeight))+"# is now greater than"+CHR(13)+"what you started with! "+ALLTRIM(STR(nWeight_OLD))+"#"
							ELSE
								cMess = cMess+ CHR(13)+"Weight is Odd"+CHR(13)+"Weight "+ALLTRIM(STR(nWeight))+"# is now greater than"+CHR(13)+"what you started with! "+ALLTRIM(STR(nWeight_OLD))+"#"
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				IF nWeight_Calc > 0
					IF (nWeight_Calc+10)*1.3 < nWeight +10
						*Weight now greater 
						IF NOT lAddStockBack
							IF EMPTY(cMess)
								cMess = "Entered Weight "+ALLTRIM(STR(nWeight))+"# is more then 30% greater than"+CHR(13)+"Calculated Weight! "+ALLTRIM(STR(nWeight_Calc))+"#"
							ELSE
								cMess = cMess+ CHR(13)+"Entered Weight "+ALLTRIM(STR(nWeight))+"# is more then 30% greater than"+CHR(13)+"Calculated Weight! "+ALLTRIM(STR(nWeight_Calc))+"#"
							ENDIF
						ENDIF
					ENDIF
					IF (nWeight_Calc+10) > (nWeight +10)*1.3
						*Weight now greater 
						IF NOT lAddStockBack
							IF EMPTY(cMess)
								cMess = "Entered Weight "+ALLTRIM(STR(nWeight))+"# is more then 30% less than"+CHR(13)+"Calculated Weight! "+ALLTRIM(STR(nWeight_Calc))+"#"
							ELSE
								cMess = cMess+ CHR(13)+"Entered Weight "+ALLTRIM(STR(nWeight))+"# is more then 30% less than"+CHR(13)+"Calculated Weight! "+ALLTRIM(STR(nWeight_Calc))+"#"
							ENDIF
						ENDIF
					ENDIF
					
				ENDIF
			ENDIF
			***
			IF nDim1 > 0
				IF nDim1_OLD > 0
					IF NOT lAddStockBack		
						IF (nDim1+1)*1.3 < nDim1_OLD+1
							*now too small 
							IF EMPTY(cMess)
								cMess = "Entered Dim1 "+ALLTRIM(STR(nDim1_OLD,10,3))+" is 30% less than"+CHR(13)+"Original Dim1! "+ALLTRIM(STR(nDim1,10,3))
							ELSE
								cMess = cMess+ CHR(13)+"Entered Dim1 "+ALLTRIM(STR(nDim1_OLD,10,3))+" is 30% less than"+CHR(13)+"Original Dim1! "+ALLTRIM(STR(nDim1,10,3))
							ENDIF
						ENDIF
						IF (nDim1+1) > (nDim1_OLD+1)*1.3
							*Greater
							IF EMPTY(cMess)
								cMess = "Entered Dim1 "+ALLTRIM(STR(nDim1_OLD,10,3))+" is more then 30% greater than"+CHR(13)+"Original Dim1! "+ALLTRIM(STR(nDim1,10,3))
							ELSE
								cMess = cMess+ CHR(13)+"Entered Dim1 "+ALLTRIM(STR(nDim1_OLD,10,3))+" is more then 30% greater than"+CHR(13)+"Original Dim1! "+ALLTRIM(STR(nDim1,10,3))
							ENDIF
						ENDIF
					ENDIF		
				ENDIF
			ENDIF
			***
			IF nDim2 > 0
				IF nDim2_OLD > 0
					IF NOT lAddStockBack		
						IF (nDim2+1) > (nDim2_OLD+1)*1.3
							*Greater
							IF EMPTY(cMess)
								cMess = "Entered Dim2 "+ALLTRIM(STR(nDim2_OLD,10,3))+" is more then 30% greater than"+CHR(13)+"Original Dim2! "+ALLTRIM(STR(nDim2,10,3))
							ELSE
								cMess = cMess+ CHR(13)+"Entered Dim2 "+ALLTRIM(STR(nDim2_OLD,10,3))+" is more then 30% greater than"+CHR(13)+"Original Dim2! "+ALLTRIM(STR(nDim2,10,3))
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			***
			IF nPC > 0
				IF nPC_OLD > 0
					IF NOT lAddStockBack
						IF (nPC+1) > (nPC_OLD+1)*1.1
							*Greater
							IF EMPTY(cMess)
								cMess = "Entered PCs "+ALLTRIM(STR(nPC_OLD,10,3))+" is more then 10% greater than"+CHR(13)+"Original PCs! "+ALLTRIM(STR(nPC))
							ELSE
								cMess = cMess+ CHR(13)+"Entered PCs "+ALLTRIM(STR(nPC_OLD,10,3))+" is more then 10% greater than"+CHR(13)+"Original PCs! "+ALLTRIM(STR(nPC))
							ENDIF
						ENDIF
					ENDIF				
				ENDIF
			ENDIF
		ELSE
			*Scrap This lScrapOverRide
		ENDIF
		
		******************
		PRIVATE nMess
		nMess = 0
		
		PRIVATE nDeleteID
		nDeleteID = 0
		PRIVATE cHeat, cLot, lPOStatus, nRID 
		cHeat	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',30,.f.)
		cLot 	= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10,.f.)
		lPOStatus = .F. &&( M.POStatus LIKE 'D' OR M.POStatus LIKE 'P' OR M.POStatus IS NULL )
		nRID = 0		&&Can this be looked up?
		
		*****************
		*Check Table
		PRIVATE cSaveToTBL, lMovetoStock, lRemoveOldLst
		cSaveToTBL = cTBL
		lMovetoStock = .F.
		lRemoveOldLst = .F.
		DO CASE
		CASE cTBL = "B"
			*nMess = MESSAGEBOX("This Stock Detail was found in 'BrokerLst'"+CHR(13)+"Change where this data is stored."+CHR(13)+CHR(13)+"Do you want to save to Stock List?",4+32,"Save to Stock")
			*IF nMess = 6
				MESSAGEBOX("This Stock Detail was found in 'BrokerLst'"+CHR(13)+"Changing where this data is stored."+CHR(13)+CHR(13)+"Saving to Stock List",0,"Save to Stock")
				cSaveToTBL = "S"
				lMovetoStock = .T.
				lRemoveOldLst = .T.
				ThisForm.Modify_StockLst_How = "ADD"
				
				*Add a master if not already there
				IF ThisForm.nWO_Detail > 0	&&WO_Detail is ready
					nDeleteID = get_ID_with_WO_Detail( ThisForm.nWO_Detail, "S", ThisForm.nConnHandle )
				ELSE
					*Try to the POitem
					IF NOT ThisForm.cPOitem = Proper_PO_Item("")
						nDeleteID = Get_ID_Master_with_POitem(ThisForm.cPOitem, cTBL, ThisForm.nConnHandle, cHeat, lPOStatus, nRID ) 
					ENDIF
				ENDIF
					
				*Remove old StockLst ID_Detail and move over Processes After Add
			*ELSE
			*	TrackError("This Stock Detail was found in 'BrokerLst'"+CHR(13)+"Do you want to save to Stock List? was Answered as NO","Did not SAVE to Stock", PROGRAM(), LINENO(1))
			*ENDIF
			
		CASE cTBL = "W"
		*	nMess = MESSAGEBOX("This Stock Detail was found in 'WIPLst'"+CHR(13)+"Change where this data is stored."+CHR(13)+CHR(13)+"Do you want to save to Stock List?",4+32,"Save to Stock")
		*	IF nMess = 6
				MESSAGEBOX("This Stock Detail was found in 'WIP List'"+CHR(13)+"Changing where this data is stored."+CHR(13)+CHR(13)+"Saving to Stock List",0,"Save to Stock")
				cSaveToTBL = "S"
				lMovetoStock = .T.
				lRemoveOldLst = .T.
				ThisForm.Modify_StockLst_How = "ADD"
				
				*Add a master if not already there
				IF ThisForm.nWO_Detail > 0	&&WO_Detail is ready
					nDeleteID = get_ID_with_WO_Detail( ThisForm.nWO_Detail, "S", ThisForm.nConnHandle )
				ELSE
					*Try to the POitem
					IF NOT ThisForm.cPOitem = Proper_PO_Item("")
						nDeleteID = Get_ID_Master_with_POitem(ThisForm.cPOitem, cTBL, ThisForm.nConnHandle, cHeat, lPOStatus, nRID ) 
					ENDIF
				ENDIF
					
				*Remove old StockLst ID_Detail and move over Processes After Add
		*	ELSE
		*		TrackError("This Stock Detail was found in 'BrokerLst'"+CHR(13)+"Do you want to save to Stock List? was Answered as NO","Did not SAVE to Stock", PROGRAM(), LINENO(1))
		*	ENDIF
		ENDCASE
		
		*******************
		IF NOT EMPTY(cMess)
		
			**while Testing, TrackMessage, not an ERROR
			PRIVATE pMess, pMessMemo
			*     (    INT, C(254),    C(254),      INT,      MEMO)
			pMess = "This data is for test, see if anything looks odd."
			pMessMemo = "This data is for test, see if anything looks odd."+" "+PROGRAM()+" "+CHR(13)
			
			pMessMemo = pMessMemo + "Modify_StockLst_How = '"+PrepareSQLtxt(ThisForm.Modify_StockLst_How,'HOW',10) +"'"+CHR(13)
			pMessMemo = pMessMemo + cMess + CHR(13)
		
			pMessMemo = pMessMemo + "m.nID1="+STR(m.nID1) + CHR(13)
			pMessMemo = pMessMemo + "m.nID_Detail="+STR(m.nID_Detail) + CHR(13)
			pMessMemo = pMessMemo + "m.nID_Detail_Process="+STR(m.nID_Detail_Process) + CHR(13)
			pMessMemo = pMessMemo + "cTBL='"+cTBL+"'" + CHR(13)
			pMessMemo = pMessMemo + "nPC="+STR(nPC) + CHR(13)
			pMessMemo = pMessMemo + "nDim1="+STR(nDim1,9,3) + CHR(13)
			pMessMemo = pMessMemo + "nDim2="+STR(nDim2,9,3) + CHR(13)
			pMessMemo = pMessMemo + "nDim3="+STR(nDim3,9,3) + CHR(13)
			pMessMemo = pMessMemo + "nWeight="+STR(nWeight,9,1) + CHR(13)
			pMessMemo = pMessMemo + "cDescript='"+cDescript+"'" + CHR(13)
			pMessMemo = pMessMemo + "cLength='"+cLength+"'" + CHR(13)
			pMessMemo = pMessMemo + "nStockLst_P="+STR(nStockLst_P) + CHR(13)
			pMessMemo = pMessMemo + "nReceivingID="+STR(nReceivingID) + CHR(13)
			pMessMemo = pMessMemo + "nInvoiceValue="+STR(nInvoiceValue,9,3) + CHR(13)
			pMessMemo = pMessMemo + "cSOitem='"+cSOitem+"'" + CHR(13)
			pMessMemo = pMessMemo + CHR(13)
			pMessMemo = pMessMemo + "nPC_OLD    ="+STR(nPC_OLD) + CHR(13)
			pMessMemo = pMessMemo + "nDim1_OLD  ="+STR(nDim1_OLD,9,3) + CHR(13)
			pMessMemo = pMessMemo + "nDim2_OLD  ="+STR(nDim2_OLD,9,3) + CHR(13)
			pMessMemo = pMessMemo + "nWeight_OLD="+STR(nWeight_OLD,9,1) + CHR(13)
			pMessMemo = pMessMemo + "nQTY_Old   ="+STR(nQTY_Old,9,3) + CHR(13)
			pMessMemo = pMessMemo + "nWeight_Calc="+STR(nWeight_Calc,9,1) + CHR(13)
			pMessMemo = pMessMemo + CHR(13)
			pMessMemo = pMessMemo + "nQTY_NEW ="+STR(nQTY_NEW,9,3) + CHR(13)
			pMessMemo = pMessMemo + "nPC_NEW  ="+STR(nPC_NEW) + CHR(13)
			pMessMemo = pMessMemo + "nDim1_NEW="+STR(nDim1_NEW,9,3) + CHR(13)
			pMessMemo = pMessMemo + "nDim2_NEW="+STR(nDim2_NEW,9,3) + CHR(13)
			pMessMemo = pMessMemo + "nDim3_NEW="+STR(nDim3_NEW,9,3) + CHR(13)
			pMessMemo = pMessMemo + CHR(13)
			pMessMemo = pMessMemo + "nStockLst_QTY="+STR(nStockLst_QTY,18,4) + CHR(13)
			pMessMemo = pMessMemo + "nStockLst_P ="+STR(nStockLst_P,18,4) + CHR(13)
			pMessMemo = pMessMemo + "nS_Total="+STR(nS_Total,18,4) + CHR(13)
		
			pMessMemo = pMessMemo + "getFormbyMasterID='"+cForm+"'" + CHR(13)
			pMessMemo = pMessMemo + "GetPUfromForm="+STR(nS_PU) + CHR(13)
		
			IF cTBL <> cSaveToTBL OR lMovetoStock
				IF cSaveToTBL = "S"
					IF ThisForm.Modify_StockLst_How = "ADD"
						pMessMemo = pMessMemo +""+ CHR(13)
						pMessMemo = pMessMemo +"Table was changed from '"+cTBL+"' to '"+cSaveToTBL+"'"+ CHR(13)
						pMessMemo = pMessMemo +""+ CHR(13)
						pMessMemo = pMessMemo +""+ CHR(13)
					ENDIF
				ENDIF
			ENDIF
			
			RecordTest('Record Test Data.', PROGRAM(), LINENO(1), pMessMemo)
		
			*************
			IF ThisForm.Modify_StockLst_How = "ADD"
				IF MESSAGEBOX(cMess+CHR(13)+CHR(13)+"Do you need to go back and Change Add? (Y)"+CHR(13)+"(No) to Save - and not Stop the Add",4+32,"Do you need to STOP ADD?") = 6
					RETURN .F.
				ENDIF	
			ELSE
				IF MESSAGEBOX(cMess+CHR(13)+CHR(13)+"Do you need to go back and Edit? (Y)"+CHR(13)+"(No) to Save -and not Stop the Add",4+32,"Do you need to STOP Edit?") = 6
					RETURN .F.
				ENDIF
			ENDIF
		ENDIF
		
		IF nStockLst_P = 0
			** Needs Work !!!
			IF NOT lScrapOverRide
				IF nInvoiceValue > 0
					IF Is_InvoiceValue_Valid(nInvoiceValue,nS_PU,ThisForm.nConnHandle)
						** Is_InvoiceValue_Valid Checks Max_P for PU **
						
						*Need Real Accounting Check here !!!
						*nStockLst_P = nInvoiceValue
						
					ELSE 
						*nInvoiceValue is OVER MAX for PU !
					ENDIF
				ENDIF
			ENDIF	
		ENDIF
		
		PRIVATE nACreturn 
		nACreturn = 0
		PRIVATE lConsumed
		lConsumed = .F.
		
		*Save
		*******************************************
		
		IF nStockLst_P > 0 AND cTBL = "S" AND NOT lScrapOverRide
			*Check StockLst_P Rules in AccountingCosting
			
			nACreturn = AccountingCosting( m.nID1, m.nID_Detail, cSOitem, ThisForm.nConnHandle )
			*PARAMETER pID, pID_Detail, pSOitem, pConn   RETURNS Code
			cMess = PROGRAM()+' AccountingCosting:'
			IF m.nID1>0
				cMess = cMess + " ID="+ALLTRIM(STR(m.nID1))+" "
			ENDIF
			IF m.nID1>0
				cMess = cMess + " ID_Detail="+ALLTRIM(STR(m.nID_Detail))+" "
			ENDIF
			IF LEN(cSOitem)>0
				cMess = cMess + " SOitem="+ALLTRIM(cSOitem)+" "
			ENDIF
			
			IF VARTYPE(cMess) != "C"
				cMess = "Lost cMess Data"
			ENDIF
			IF EMPTY(cMess) 
				cMess = "cMess is empty"
			ENDIF
			
		
			
			DO CASE
			CASE nACreturn = 0
				*Zero Cost
				*0 if write off
				nStockLst_P = 0
				WAIT WINDOW "This drop confirms to the 'Zero out Cost' rules." NOWAIT
				cMess = cMess + CHR(13) + "This drop confirms to the 'Zero out Cost' rules."
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
		
			CASE nACreturn = 1
				*Keep sames Cost
				cMess = cMess  + CHR(13) + "Keeps sames Cost."
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cMess)
		
			CASE nACreturn = -1
				*-1 if no ID_Detail
				MESSAGEBOX("No ID_Detail value",0,"Error in 'AccountingCosting()'")
				TrackError(cMess+CHR(13)+"no ID_Detail value","AccountingCosting()",PROGRAM(),LINENO(1))
				
			CASE nACreturn = -2
				*-2 if no Alloy/Form
				MESSAGEBOX("No Alloy/Form value",0,"Error in 'AccountingCosting()'")
				TrackError(cMess+CHR(13)+"no Alloy/Form value","AccountingCosting()",PROGRAM(),LINENO(1))
				
			CASE nACreturn = -3
				*-3 IF no Dim1/Dim2
				*MESSAGEBOX("No Dim1/Dim2 value",0,"Error in 'AccountingCosting()'")
				*DIM2 is Blank
				TrackError(cMess+CHR(13)+"No Dim1 or Dim2 value","AccountingCosting()",PROGRAM(),LINENO(1))
				
			CASE nACreturn = -4
				*-4 Did not find ID_Detail 
				MESSAGEBOX("No ID_Detail value",0,"Error in 'AccountingCosting()'")
				TrackError(cMess+CHR(13)+"No ID_Detail value","AccountingCosting()",PROGRAM(),LINENO(1))
				
			CASE nACreturn = -5
				*-5 SQL error with tmpMasterAlloyForm or tmpDetailAlloyForm
				MESSAGEBOX("SQL error with tmpMasterAlloyForm or tmpDetailAlloyForm",0,"Error in 'AccountingCosting()'")
				TrackError(cMess+CHR(13)+"SQL error with tmpMasterAlloyForm or tmpDetailAlloyForm","AccountingCosting()",PROGRAM(),LINENO(1))
				
			OTHERWISE
				*Error
				MESSAGEBOX("Undefined Error",0,"Error in 'AccountingCosting()'")
				TrackError(cMess+CHR(13)+"Undefined Error","AccountingCosting()",PROGRAM(),LINENO(1))
				*OK to save
			ENDCASE
		ENDIF
		
		IF nReceivingID = 0
			IF NOT EMPTY(cHeat)
				*Use with caution, could be the wrong ID.
				nReceivingID = getReceivingIDfromHeat(cHeat,ThisForm.nConnHandle) &&Proc_StockLst
			ENDIF
		ENDIF
		
		IF nReceivingID = 0
			IF m.nID_Detail > 0
				nReceivingID = getReceivingIDHistory_ID_Detail(m.nID_Detail, cTBL, ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		IF nReceivingID = 0
			*Track ReceivingID = 0 Error
			cMess2 = " TBL:"+cTBL+" ID:" + ALLTRIM(STR(m.nID1))+CHR(13)
			cMess2 = cMess2 + " ID_Detail:" + ALLTRIM(STR(m.nID_Detail))+CHR(13)
			cMess2 = cMess2 + " ID_Detail_Process:" + ALLTRIM(STR(m.nID_Detail_Process))
		
			PRIVATE cMess
			PRIVATE cPOitem
			cPOitem	= Proper_PO_Item( ThisForm.txtPOitem.Value )
			*WAIT WINDOW cSOitem NOWAIT
			
			PRIVATE cAlloy,cDescription
			cAlloy		= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12,.F.)
			*cHeat		= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50,.f.)
			*cLot		= PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10,.f.)
			cDescription= PrepareSQLtxt(ThisForm.txtDescript1.Value,'Description',-1,.F.)
			
			cMess = ""
			cMess = cMess + "SOitem "+ALLTRIM(cSOitem)+CHR(13)
			cMess = cMess + "POitem "+ALLTRIM(cPOitem)+CHR(13)
			*cMess = cMess + "RMA "+ALLTRIM(STR(nRMA))+CHR(13)
			cMess = cMess + "Alloy "+ALLTRIM(cAlloy)+CHR(13)
			cMess = cMess + "Heat "+ALLTRIM(cHeat)+CHR(13)
			cMess = cMess + "Lot "+ALLTRIM(cLot)+CHR(13)
			cMess = cMess + "Desc "+ALLTRIM(LEFT(cDescription,20))
			IF lMovetoStock
				cMess = cMess + CHR(13) + "To be saved in StockLst"
			ENDIF
			cMess = ShowSQLtxt(cMess,'Mess',-1)  &&Added 6/5/2015 - : No Message parameter passed to TrackError.
			cMess2 = ShowSQLtxt(cMess2,'Mess',-1)
			
			*TrackError("nReceivingID is 0, Trying to Save a StockLst Edit"+CHR(13)+cMess2+CHR(13)+cMess,"bad variable",PROGRAM(),LINENO(1))
			TrackMess(LEFT("nReceivingID is 0, Trying to Save a StockLst Edit"+CHR(13)+cMess2+CHR(13)+cMess,254))
			RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "nReceivingID is 0, Saving to "+TableName_TBL(cTBL)+"_Detail  "+CHR(10)+CHR(13)+cMess2+" "+CHR(13)+cMess )
			
		ENDIF
		
		*************************************************************
		
		PRIVATE nWO, lOK
		nWO		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3,0)
		lOK = .T.
		
		IF lOK
			IF nWO > 0
				ThisForm.nWO = nWO
				lOK = ThisForm.Save_WorkOrder_Stock()
				IF NOT lOK
					TrackError("Save_WorkOrder_Stock Failed","Save_WorkOrder_Stock Failed", PROGRAM(), LINENO(1))
					lOK = .T.
				ENDIF
			ENDIF
		ENDIF
		
		
		****************************
		* Start the Save
		*	
		***********************************************************************************************
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		***********************************************************************************************
		
		PRIVATE lRollback
		lRollback = .F.
		
		
		IF USED('tmpStkSum')
			lOK = ThisForm.SaveStockLstEdit_tmpStkSum(lConsumed, lScrapOverRide, lMovetoStock)	
			*Collect Screen data
			*Get Orig Dims from Screen
			*	nRemoved_Qty	= PrepareSQLnum(tmpStkSum.QTY,'QTY',18,4)
			*	nRemoved_LBS	= PrepareSQLnum(tmpStkSum.Weight,'Weight',8,1)
			*Find and update PackingSlip Entry in Sales_Edit
			*cSQLid = "INSERT INTO dbo.Sales_Stock
			*cSQLid = "UPDATE dbo.Sales_Detail SET "
		ENDIF	&&IF NOT lScrapOverRide
		
		
		
		*************************************************************
		
		DO CASE 
		CASE lScrapOverRide 
			* Do not save
				
		CASE ThisForm.Modify_StockLst_How = "ADD"
			IF NOT lScrapOverRide
				IF lMovetoStock
					*Need to Move Master ID to StockLst_Master
					cSQL = "EXEC dbo.p_Lst_Master_Clone @ID="+STR(m.nID1)+" ,@TBL='"+cTBL+"' ,@mS_QTY="+STR(nQTY_NEW)+" ,@Heat='"+cHeat+"', @Lot='"+cLot+"'"
					
					m.nID1 = 0
					*nReceivingID = 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_ins' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_ins' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_ins')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_ins')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master_ins")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master_ins")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'StockLst_Master_ins')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL)
						cSQLi = ShowSQLtxt(cSQL,'cSQL',-1) &&Added 6/5/2015 - : No Message parameter passed to TrackError.
						TrackError(cSQL,"EXEC dbo.p_Lst_Master_Clone",PROGRAM(),LINENO(1))
						lRollback = .T.
						lOK = .F.
					ELSE
						IF USED('StockLst_Master_ins')
							IF RECCOUNT('StockLst_Master_ins') > 0
								m.nID1 = PrepareSQLnum(StockLst_Master_ins.exp,'ID',-3)
							ENDIF
							USE IN StockLst_Master_ins
						ELSE
							TrackError(cSQL,"EXEC dbo.p_Lst_Master_Clone",PROGRAM(),LINENO(1))
						ENDIF
						
						IF m.nID1 = 0
							IF USED('StockLst_Master_ins2')
								IF RECCOUNT('StockLst_Master_ins2') > 0
									m.nID1 = PrepareSQLnum(StockLst_Master_ins2.exp,'ID',-3)
								ENDIF
								USE IN StockLst_Master_ins2
							ENDIF
						
						ENDIF
					ENDIF
				ENDIF
				
				******************************************
				IF lOK
					SELECT 0
					DO CASE
					CASE cSaveToTBL = "S"
						cSQLi = "EXEC dbo.p_StockLst_Detail_ins2 "
					CASE cSaveToTBL = "B"
						cSQLi = "EXEC dbo.p_BrokerLst_Detail_ins2 "
					CASE cSaveToTBL = "W"
						cSQLi = "EXEC dbo.p_WIPLst_Detail_ins2 "
					ENDCASE
					
					cSQLi = cSQLi+ " @size_h	= "+STR(nSize_H,9,4)	&&decimal(9, 4),
					cSQLi = cSQLi+ ",@size_l = "+STR(nSize_L,9,4)	&&decimal(9, 4),
					cSQLi = cSQLi+ ",@pc = "+STR(nPC)		&&INT,
					cSQLi = cSQLi+ ",@dim1 = "+STR(nDim1,18,4)		&&decimal(18, 4),
					cSQLi = cSQLi+ ",@dim2 = "+STR(nDim2,18,4)		&&decimal(18, 4),
					cSQLi = cSQLi+ ",@dim3 = "+STR(nDim3,18,4)		&&decimal(18, 4),
					cSQLi = cSQLi+ ",@length ='"+cLength+"'"		&&varchar(160)
					cSQLi = cSQLi+ ",@weight = "+STR(nWeight,18,4)		&&decimal(9, 2),
					IF nACreturn = 0
						cSQLi = cSQLi+ ",@costvalue	= "+STR(nStockLst_P,18,4)	&&decimal(9, 4),
					ELSE
						cSQLi = cSQLi+ ",@costvalue	= "+STR(nStockLst_P,18,4)	&&decimal(9, 4),
					ENDIF
					cSQLi = cSQLi+ ",@descript ='"+cDescript+"'"	&&varchar(20),
					cSQLi = cSQLi+ ",@location ='"+cLocation+"'"	&&varchar(10),
					cSQLi = cSQLi+ ",@floorstatus ='"+cFloorStatus+"'"	&&char(1),
					cSQLi = cSQLi+ ",@class	 ='"+cClass+"'"		&&char(1),
					cSQLi = cSQLi+ ",@unit =''"		&&varchar(6),
					cSQLi = cSQLi+ ",@RandLen =0"			&&Bit
					cSQLi = cSQLi+ ",@Id ="+STR(m.nID1)		&&int
					cSQLi = cSQLi+ ",@ReceivingID="+STR(nReceivingID)	
					cSQLi = cSQLi+ ",@InvoiceValue="+STR(nInvoiceValue,18,4)
					cSQLi = cSQLi+ ",@ID_Detail_Process =0 "  &&New, Process should be 0 m.nID_Detail_Process
					*Specs
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "StockLst_Detail_ins")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "StockLst_Detail_ins")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLi, ThisForm.nConnHandle,nSQLEXEC, 'StockLst_Detail_ins')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLi)
						cSQLi = ShowSQLtxt(cSQLi,'cSQL',-1) &&Added 6/5/2015 - : No Message parameter passed to TrackError.
						TrackError(cSQLi,"EXEC dbo.p_StockLst_Detail_ins2",PROGRAM(),LINENO(1))
						lRollback = .T.
						lOK = .F.
					ELSE
						IF USED('StockLst_Detail_ins')
							IF RECCOUNT('StockLst_Detail_ins') > 0
								m.nID_Detail = PrepareSQLnum(StockLst_Detail_ins.exp,'ID_Detail',-3)
								
								ThisForm.txtID_Detail.Value = m.nID_Detail
								ThisForm.nID_Detail = m.nID_Detail
								
								IF USED("StockLst_Detail_ins")
									USE IN StockLst_Detail_ins
								ENDIF
								
								PRIVATE cSQL_Detail_Update 
								*Now update what does not fit in p_ Lst_Detail_ins ************
								DO CASE
								CASE cSaveToTBL = "S"
									cSQL_Detail_Update = "UPDATE dbo.StockLst_Detail SET "
								CASE cSaveToTBL = "B"
									cSQL_Detail_Update = "UPDATE dbo.BrokerLst_Detail SET "
								CASE cSaveToTBL = "W"
									cSQL_Detail_Update = "UPDATE dbo.WIPLst_Detail SET "
								ENDCASE
								
								cSQL_Detail_Update = cSQL_Detail_Update +" S_QTY = " + STR(nStockLst_QTY,18,4) + ""
								IF nACreturn = 0
									cSQL_Detail_Update = cSQL_Detail_Update +",S_P = 0 " 
									cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = 0"
								ELSE
									cSQL_Detail_Update = cSQL_Detail_Update +",S_P = " + STR(nStockLst_P,18,4) + ""
									cSQL_Detail_Update = cSQL_Detail_Update +",S_Total = " + STR(nS_Total,18,4) + ""
								ENDIF
								cSQL_Detail_Update = cSQL_Detail_Update +",S_PU = " + STR(nS_PU) + ""
								cSQL_Detail_Update = cSQL_Detail_Update +" WHERE ID_Detail = "+STR(m.nID_Detail)
								
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update )
									ENDDO
								ENDIF
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL_Detail_Update, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQL_Detail_Update,ThisForm.nConnHandle,nSQLEXEC )
									RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL_Detail_Update)
									TrackError(cSQL_Detail_Update,"Update what does not fit in p_Lst_Detail_ins",PROGRAM(),LINENO(1))
									lOK = .F.
								ELSE
									**************************************
									*Update dbo.StockLst_Detail_Insert
									IF cSaveToTBL = "S"
										
										PRIVATE cOrderType, cOrderNum
										cOrderType = get_OrderType(ThisForm.cSOitem,ThisForm.cPOitem,ThisForm.nWO,ThisForm.nWO_Detail)
										cOrderNum  = get_OrderNum(ThisForm.cSOitem,ThisForm.cPOitem,ThisForm.nWO,ThisForm.nWO_Detail)
								
										PRIVATE cSQLu		
										cSQLu = "UPDATE dbo.StockLst_Detail_Inserted "
										cSQLu = cSQLu + " SET OrderType = '"+cOrderType+"'"
										cSQLu = cSQLu + " ,OrderNum = '"+cOrderNum+"'"
										cSQLu = cSQLu + " WHERE ID_Detail = "+STR(m.nID_Detail)
										
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
										ENDDO
										IF nSQLEXEC < 0 &&Try again!
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL 2' TIMEOUT 1
												nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
											ENDDO
										ENDIF
										IF nSQLEXEC < 0 &&Try again!
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL 2' TIMEOUT 1
												nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
												
												IF nSQLEXEC < 0
													IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
														nSQLEXEC = 0
													ENDIF
												ENDIF
											ENDDO
										ENDIF
										IF nSQLEXEC < 0
											SQLEXECError(cSQLu , ThisForm.nConnHandle,nSQLEXEC)
											RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
											lOK = .F.
										ENDIF
										
									ENDIF
									
									**************************************
									*Track
									PRIVATE cMess
									IF lOK
										cMess = "Ran SQL "
									ELSE
										cMess = "Failed SQL. tried to "
									ENDIF
									
									DO CASE
									CASE cSaveToTBL = "S"
										cMess = cMess + "UPDATE dbo.StockLst_Detail"
									CASE cSaveToTBL = "B"
										cMess = cMess + "UPDATE dbo.BrokerLst_Detail"
									CASE cSaveToTBL = "W"
										cMess = cMess + "UPDATE dbo.WIPLst_Detail"
									ENDCASE
									cMess = cMess + " WHERE ID_Detail = "+STR(m.nID_Detail)
									cMess = cMess + CHR(13)+"and "+cSQLi
									cMess = cMess + CHR(13)+"Modify_StockLst_Detail:SaveStockDetail LINE "+ALLTRIM(STR(LINENO(1)))
									
									TrackMess(LEFT(cMess,254))
									*TrackError(cSQLi,"This SQL worked!",PROGRAM(),LINENO(1))
									RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "This SQL worked! "+CHR(13)+cSQLi)
								ENDIF
							ELSE
								* RECCOUNT('StockLst_Detail_ins') > 0
								TrackError(cSQLi,"RECCOUNT('StockLst_Detail_ins')=0",PROGRAM(),LINENO(1))
							ENDIF
						ELSE
							*USED('StockLst_Detail_ins')
							TrackError(cSQLi,"USED('StockLst_Detail_ins')=.F.",PROGRAM(),LINENO(1))
						ENDIF
					ENDIF
				ENDIF
			ENDIF
					
			IF lOK
				ThisForm.Hide_StkSum(.T.)
			ENDIF
			
			IF lOK AND lRemoveOldLst
				*cTBL <> cSaveToTBL
				*Edit was saved to new table
				*Delete old ID and ID_Detail listing from old table
				
				*m.nID1
				IF nDeleteID > 0
					PRIVATE cFrom,cWhy, cWhy2
					
					IF ThisForm.nWO > 0
						cWhy2= "WO "+ALLTRIM(STR(ThisForm.nWO))
					ELSE
						*Try to the POitem
						cWhy2= ThisForm.cSOitem
					ENDIF
		
					cFrom = cWhy2
					cWhy = "Stock was removed for "+cWhy2+" after Order and this record was then deleted."
					lOK = Remove_Lst_Detail_by_MasterID(cTBL,nDeleteID,ThisForm.nConnHandle,cFrom,cWhy)
					IF lOK
						lOK = Remove_Lst_ID(cTBL,nDeleteID,ThisForm.nConnHandle,cFrom,cWhy)
					ENDIF
					
				ENDIF	
			ENDIF
			
		CASE ThisForm.Modify_StockLst_How = "EDIT"
			IF lOK
				IF m.nID_Detail > 0
					DO CASE
					CASE cTBL = "S"
						cSQLid = "INSERT INTO dbo.StockLst_Process_Detail "
					CASE cTBL = "B"
						cSQLid = "INSERT INTO dbo.BrokerLst_Process_Detail "
					CASE cTBL = "W"
						cSQLid = "INSERT INTO dbo.WIPLst_Process_Detail "
					ENDCASE
					
					cSQLid = cSQLid+ "(ID, ID_Detail, ID_Detail_Process, What, SOitem, WO ) VALUES ("
					cSQLid = cSQLid+ ""+STR(m.nID1)+""
					cSQLid = cSQLid+ ","+STR(m.nID_Detail)+""
					cSQLid = cSQLid+ ","+STR(m.nID_Detail_Process)+""
					cSQLid = cSQLid+ ",'"+"EDIT"+"'"	
					cSQLid = cSQLid+ ",'"+cSOitem+"'"
					cSQLid = cSQLid+ ","+STR(ThisForm.nWO)+")"
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid , "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid , "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLid, ThisForm.nConnHandle,nSQLEXEC)
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLid)
						*cSQLid = ShowSQLtxt(cSQLid,'cSQL',-1) &&Added 6/5/2015 - : No Message parameter passed to TrackError.
						*TrackError(cSQLid,"INSERT INTO dbo.BrokerLst_Process_Detail",PROGRAM(),LINENO(1))
						lRollback = .T.
						lOK = .F.
					ELSE
						DO CASE
						CASE cTBL = "S"
							cSQL = "UPDATE dbo.StockLst_Detail SET "
						CASE cTBL = "B"
							cSQL = "UPDATE dbo.BrokerLst_Detail SET "
						CASE cTBL = "W"
							cSQL = "UPDATE dbo.WIPLst_Detail SET "
						ENDCASE
							
						cSQL = cSQL+ "ID="+STR(m.nID1)+","
						cSQL = cSQL+ "PC="+STR(nPC)+","
						cSQL = cSQL+ "Size_H="+STR(nSize_H,9,4)+","
						cSQL = cSQL+ "Dim1="+STR(nDim1,18,4)+","
						cSQL = cSQL+ "Size_L="+STR(nSize_L,9,4)+","
						cSQL = cSQL+ "Dim2="+STR(nDim2,18,4)+","
						cSQL = cSQL+ "Dim3="+STR(nDim3,18,4)+","
						cSQL = cSQL+ "Weight="+STR(nWeight,18,4)+","
						cSQL = cSQL+ "Descript='"+cDescript+"',"
						cSQL = cSQL+ "Length='"+cLength+"',"
						cSQL = cSQL+ "FloorStatus='"+cFloorStatus+"',"
						cSQL = cSQL+ "class='"+cClass+"',"
						cSQL = cSQL+ "[Location]='"+cLocation+"' "
						IF nReceivingID > 0
							cSQL = cSQL+ ",ReceivingID="+STR(nReceivingID)
						ENDIF
						cSQL = cSQL+ ",InvoiceValue="+STR(nInvoiceValue,18,4)
						IF lMarkInvCheck
							cSQL = cSQL+ ",InvCheck=GetDate()"
						ENDIF
						cSQL = cSQL+",S_QTY = " + STR(nStockLst_QTY,18,4) + ""
						cSQL = cSQL+",S_P = " + STR(nStockLst_P,18,4) + ""
						cSQL = cSQL+",S_Total = " + STR(nS_Total,18,4) + ""
						cSQL = cSQL+",S_PU = " + STR(nS_PU) + ""
						cSQL = cSQL+",Prime = "+IIF(lPrime,'1','2')
						
						cSQL  = cSQL+ " WHERE ID_Detail="+STR(m.nID_Detail)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Could PERMISSION be a problem?"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL)
							lRollback = .T.
							lOK = .F.
						ENDIF
						
						PRIVATE cSQLo 
						cSQLo = ''
						*****************
						IF lOK AND ThisForm.nWO > 0
							*OLD
							cSQLo = "UPDATE dbo.WorkOrder "
							cSQLo = cSQLo +" SET StkConsumed=1 "
							cSQLo = cSQLo +" WHERE WO="+STR(ThisForm.nWO)
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLo )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLo )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLo )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLo )
								ENDDO
							ENDIF
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLo, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLo, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLExecError(cSQLo, ThisForm.nConnHandle,nSQLEXEC)
								RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLo)
							ELSE
								ThisForm.CompareWO_LBS_to_Consume()
							ENDIF
							
						
						ENDIF
					ENDIF
						
					*****************
					IF lOK 
					
						ThisForm.Hide_StkSum(.T.)
						
						**************************************
						*Track
						*TrackMess(cSQL)
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQL) 
						*TrackMess(cSQLid)
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQLid) 
						IF NOT EMPTY(cSQLo)
							TrackMess(cSQLo)
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQLo) 
						ENDIF
						
					ENDIF
					
				ELSE
					*m.nID_Detail is 0
					TrackError("SaveStockDetail()Failed"+CHR(13)+cSQL_Detail_Update,"nID_Detail is 0",PROGRAM(),LINENO(1))
				ENDIF
		
			ENDIF
				
		OTHERWISE
			IF NOT lScrapOverRide 
				MESSAGEBOX("Could not tell if this save was for ADD or EDIT",0,"ERROR")
				
				*SQLROLLBACK(ThisForm.nConnHandle)
				*= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
				
				TrackError("ThisForm.Modify_StockLst_How='' Could not tell if this save was for ADD or EDIT! ","Modify StockLst_Detail-Save",PROGRAM(),LINENO(1))
				*RETURN .F.
				lRollback = .T.
			ENDIF
				
		ENDCASE
		
		******************
		
		IF cTBL <> cSaveToTBL AND NOT lRollback 
			IF cSaveToTBL = "S"
				IF ThisForm.Modify_StockLst_How = "ADD"
					*Remove old ID,ID_Detail and move over Processes
					
				ENDIF
			ENDIF
		ENDIF
		
		*************************************************************************************
		
		IF lRollback 
			MESSAGEBOX("SQL Transaction Rolled Back",0,"Could not save!")
			=SQLROLLBACK(ThisForm.nConnHandle)
			TrackError("Shop_StockLst_Edit-Modify StockLst_Detail-Save: Could not save!","SQL Transaction Rolled Back",PROGRAM(),LINENO(1))
			= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1) 
			RETURN .F.
		ELSE
			WAIT WINDOW "Saved!" NOWAIT
			=SQLCOMMIT(ThisForm.nConnHandle)
			
		ENDIF
		
		***************************************************************************************
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		***************************************************************************************
		
		ThisForm.Modify_StockLst_Detail( "SAVE" )
		ThisForm.Modify_StockLst_How = "SAVE"
		
		PRIVATE cTableName
		cTableName 	= IIF(cTBL = "S",'StockLst',IIF(cTBL="B",'BrokerLst','WIPLst'))
		
		**********************************
		PRIVATE lConsumeQTY_OK
		lConsumeQTY_OK = ThisForm.Create_aConsumeQTY('SAVE')  &&Set ARRAY aConsumeQTY(14)
		*lConsumeQTY_OK is not being checked here! Only 'CONSUME' parameter needs checked
		
		**********************************
		*IF Remove_ID_Detail_Process(m.nID_Detail_Process,"SOitem",cSOitem,cTBL,ThisForm.nConnHandle,"Sell Stock")  &&Check for Excess metal to Stock!
		PRIVATE lConsume
		lConsume = .F.
		IF NOT lScrapOverRide
			IF ThisForm.Partial_ID_Detail_Process(lConsume)
			
			ENDIF
		ENDIF
		
		**********************************
		IF MESSAGEBOX("Did this "+cTableName+" complete the selected process?"+CHR(13)+"Answer 'Yes' and the 'Process' will show as complete."+CHR(13)+"Answer 'Yes' for Inventory correction."+CHR(13)+"Answer 'No' when the SO item is not done."+CHR(13)+"Answer 'No' when you need to Add a drop back.",4,"Process Complete?") = 6
			*Yes
			*ThisForm.Release
		
			ThisForm.cmdDone.Click()
		ELSE
			*Refresh Screen Data
			ThisForm.txtPc.Value		= nPC
			ThisForm.txtDim1.Value		= nDim1
			ThisForm.txtDim2.Value		= nDim2
			ThisForm.txtDim3.Value		= nDim3
			ThisForm.txtQTY.Value		= nStockLst_QTY
			ThisForm.txtWeight.Value	= nWeight
			ThisForm.txtStk_P.Value		= nStk_P
			ThisForm.txtClass.Value		= cClass
			ThisForm.txtLength1.Value	= cLength
			ThisForm.txtLocation.Value	= cLocation
			ThisForm.txtFloorStatus.Value	= cFloorStatus
			ThisForm.txtSize_L.Value	= nSize_L
			ThisForm.txtSize_H.Value	= nSize_H
			ThisForm.txtDescript.Value	= cDescript
			
			ThisForm.nPc		= nPC
			ThisForm.nDim1		= nDim1
			ThisForm.nDim2		= nDim2
			ThisForm.nDim3		= nDim3
			ThisForm.nQTY		= nStockLst_QTY
			ThisForm.nWeight	= nWeight
		
		
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE savestocklstedit_tmpstksum
		PARAMETERS lConsumed, lScrap, lMovetoStock
		*ThisForm.SaveStockLstEdit_tmpStkSum(lConsumed, lScrap, lMovetoStock)
		
		*Checks Packing Slip, updates dbo.Sales_Stock
		*Scans tmpStkSum Cursor  -makes a Sales_Detail.ID
		*INSERT INTO dbo.Sales_Detail
		
		
		IF VARTYPE(lConsumed) != "L"
			lConsumed = .F.
		ENDIF
		
		IF VARTYPE(lScrap) != "L"
			lScrap = .F.
		ENDIF
		
		IF VARTYPE(lMovetoStock) != "L"
			lMovetoStock = .F.
		ENDIF
		
		PRIVATE lStkBack, lStkBackValued, lEdited
		lStkBack = .F.
		lStkBackValued = .T.
		lEdited = .T.
		IF lConsumed 
			lEdited = .F.
			lStkBack = .F.
		ENDIF
		IF lScrap
			lEdited = .T.
			lStkBack = .F.
		ENDIF
		
		dtGetDate = Get_SQL_DateTime()
		
		******************************************
		
		PRIVATE nID, nID_Detail, nID_Detail_Process, nSales_Detail_ID
		nID					= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail 			= ThisForm.nID_Detail
		nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3,0)
		nSales_Detail_ID	= 0
		
		PRIVATE nWO, nWO_Detail, cUserEdit
		nWO		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3,0)
		nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3,0)
		cUserEdit	= PrepareSQLtxt(ThisForm.edtUserEdit.Value,'UserEdit',-3)
		IF lMovetoStock
			cUserEdit = cUserEdit + CHR(13) + "Saving drops from Brokerlst to StockLst"
		ENDIF
		
		PRIVATE cSOitem,cPOitem,cTBL
		cSOitem	= Proper_SO_Item(ThisForm.cSOitem)
		cPOitem = Proper_PO_item(ThisForm.cPOitem)
		cTBL	= ThisForm.cTBL
		
		
		*****************************
		*  Grab Stored Data of Alloy,Form,Heat,Lot,CC,CL 
				
		
		PRIVATE lOK
		lOK = .T.
		
		IF USED('tmpAlloyFormCC')
			USE IN tmpAlloyFormCC
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT M.Alloy,M.Form,M.Heat,M.Lot,M.CC,M.CL,M.Paid ,D.S_P ,D.RandLen"
		cSQL = cSQL + " ,f.FormSort "
		DO CASE
		CASE cTbl = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.Forms F ON M.Form = F.FormNumber "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON D.ID = m.ID "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.Forms F ON M.Form = F.FormNumber "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON D.ID = m.ID "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Master M "
			cSQL = cSQL + " INNER JOIN dbo.Forms F ON M.Form = F.FormNumber "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail D ON D.ID = m.ID "
		ENDCASE
		cSQL = cSQL + " WHERE D.ID_Detail = "+ALLTRIM(STR(nID_Detail))
			
		PRIVATE cAlloy, cForm, cFormSort, cHeat, cLot, cCC, cCL, nS_P, lRandLen
		cAlloy	= ''
		cForm	= ''
		cFormSort= ''
		cHeat	= ''
		cLot	= ''
		cCC		= ''
		cCL		= ''
		lRandLen = .F.
		
		PRIVATE nStkPaid_P, nStkPaid_Total, nMasterPaid
		nStkPaid_P = 0
		nStkPaid_Total = 0
		nMasterPaid = 0
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyFormCC")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyFormCC")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpAlloyFormCC')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpAlloyFormCC')
				IF RECCOUNT("tmpAlloyFormCC") > 0
					cAlloy	= PrepareSQLtxt(tmpAlloyFormCC.Alloy,'Alloy',12)
					cForm	= PrepareSQLtxt(tmpAlloyFormCC.Form,'Form',2)  &&Could Convert form 80 to 40
					cFormSort = PrepareSQLtxt(tmpAlloyFormCC.FormSort,'Form',2)
					cHeat	= PrepareSQLtxt(tmpAlloyFormCC.Heat,'Heat',50)
					cLot	= PrepareSQLtxt(tmpAlloyFormCC.Lot,'Lot',10)
					cCC		= PrepareSQLtxt(tmpAlloyFormCC.CC,'CC',1)
					cCL		= PrepareSQLtxt(tmpAlloyFormCC.CL,'CL',1)
					nStkPaid_P 	= PrepareSQLnum(tmpAlloyFormCC.Paid,'Paid',-5)
					IF cLot =  '0         '
						cLot = ''
					ENDIF
					nS_P		= PrepareSQLnum(tmpAlloyFormCC.S_P,'S_P',-5)
					lRandLen	= PrepareSQLlogic(tmpAlloyFormCC.RandLen,'RandLen')
		
				ENDIF
				USE IN tmpAlloyFormCC
			ENDIF
		ENDIF
		
		*****************************************************
		*Collect Screen data
		PRIVATE nStockLst_Qty, nStockLst_P, nStockLst_Total, nStockLst_PU, nWeight
		nStockLst_Qty	= PrepareSQLnum( ThisForm.txtQTY.Value,'StockLst_Qty',18,4)
		IF nStockLst_Qty = 0
			nStockLst_Qty	= PrepareSQLnum( ThisForm.txtS_QTY.Value,'StockLst_Qty',18,4)
		ENDIF
		
		*Get Screen data to Total
		nStockLst_P	= PrepareSQLnum( ThisForm.txtS_P.Value,'StockLst_P',18,4) &&current Price per unit
		nStockLst_Total	= nStockLst_Qty * nStockLst_P
		nStockLst_PU	= PrepareSQLnum(ThisForm.txtS_PU.Value,'S_PU',-1)
		IF nStockLst_PU = 0
			IF NOT EMPTY(cForm)
				nStockLst_PU	= getPUfromForm( cForm, ThisForm.nConnHandle )
			ENDIF
		ENDIF
		
		nWeight = PrepareSQLnum(ThisForm.txtWeight1.Value,'Weight',9,1)
		
		***************
		IF nStockLst_Qty > NTOM(0)
			IF nStkPaid_P > NTOM(0)
				nStkPaid_Total = nStkPaid_P * nStockLst_Qty 
			ELSE
				nStkPaid_P = nStockLst_P 
				nStkPaid_Total = nStockLst_P * nStockLst_Qty 
			ENDIF
		ELSE
			IF nWeight > 0
				IF nStkPaid_P > 0
					nStkPaid_Total = nStkPaid_P * nWeight 
				ELSE
					nStkPaid_P = nStockLst_P 
					nStkPaid_Total = nStockLst_P * nWeight 
				ENDIF
			ENDIF
		ENDIF
		IF nStkPaid_Total = NTOM(0)
			nStkPaid_Total = nStockLst_Total
		ENDIF
		
		******* Verify PU before accepting the StockLst_QTY
		DO CASE 
		CASE nStockLst_PU = 1
			*Lb
			IF (nStockLst_Qty+10)*1.2 > nWeight+10
				IF (nStockLst_Qty+10) < (nWeight+10)*1.2
					*Within 20%
				ENDIF
			ENDIF
		CASE nStockLst_PU = 2
			*FT
			
		CASE nStockLst_PU = 3
			*PC
		CASE nStockLst_PU = 4
			*Lot
		OTHERWISE
			TrackError("Did not get a PU","Form:"+cForm,PROGRAM(),LINENO(1))
		ENDCASE
		
		
		
		*****************************************************
		*Get Orig Dims from Screen
		PRIVATE nOrig_PC, nOrig_Dim1, nOrig_Dim2, nOrig_Dim3, nOrig_QTY, nOrig_P, nOrig_LBS
		nOrig_PC	= PrepareSQLnum(ThisForm.txtPC.Value,'Pc',-3)
		nOrig_Dim1	= PrepareSQLnum(ThisForm.txtDim1.Value,'Dim1',18,4)
		nOrig_Dim2	= PrepareSQLnum(ThisForm.txtDim2.Value,'Dim2',17,3)
		nOrig_Dim3	= PrepareSQLnum(ThisForm.txtDim3.Value,'Dim3',17,3)
		nOrig_QTY	= PrepareSQLnum(ThisForm.txtQTY.Value,'QTY',-5)
		nOrig_P		= PrepareSQLnum(ThisForm.txtStk_P.Value,'S_P',-5)
		nOrig_LBS	= PrepareSQLnum(ThisForm.txtWeight.Value,'LBS',9,1)
		
		
		IF nOrig_Dim1 = 0
			MESSAGEBOX("There will not be a dbo.Sales_Detail insert because the Dim1 is 0.",0+16,"No Dim1 value")
			TrackError("here will not be a dbo.Sales_Detail insert because the Dim1 is 0.";
			+CHR(13)+"SOitem '"+cSOitem+"',' POitem '"+cPOitem+"', TBL='"+cTBL+"'";
			+CHR(13)+"ID ="+STR(nID)+", ID Detail="+STR(nID_Detail)+", ID Detail_Process="+STR(nID_Detail_Process);
			+"No Dim1 value", PROGRAM(), LINENO(1))
		ENDIF
		
		*Get the 'to be saved' Dims from Screen
		PRIVATE nNewStk_PC,nNewStk_Dim1,nNewStk_Dim2,nNewStk_Dim3,nNewStk_QTY,nNewStk_LBS
		IF lConsumed OR lScrap 
			nNewStk_PC = 0
			nNewStk_Dim1 = 0
			nNewStk_Dim2 = 0
			nNewStk_Dim3 = 0
			nNewStk_QTY = NTOM(0)
			nNewStk_LBS = 0
		ELSE
			*Edited or Added -Not Consumed, not Scrap
			nNewStk_PC		= PrepareSQLnum(ThisForm.txtPC1.Value,'Pc',-3)
			nNewStk_Dim1	= PrepareSQLnum(ThisForm.txtDim11.Value,'Dim1',18,4)
			nNewStk_Dim2	= PrepareSQLnum(ThisForm.txtDim21.Value,'Dim2',17,3)
			nNewStk_Dim3	= PrepareSQLnum(ThisForm.txtDim31.Value,'Dim3',17,3)
			nNewStk_QTY		= PrepareSQLnum(ThisForm.txtS_QTY.Value,'QTY',-5)
			nNewStk_LBS		= PrepareSQLnum(ThisForm.txtWeight1.Value,'LBS',9,1)
		ENDIF
		
		*CREATE Detailed Message to Email
		PRIVATE cMess, cHTML
		*****************************************************
		*WAIT WINDOW cSOitem NOWAIT
		IF ( Proper_SO_Item(cSOitem) != Proper_SO_Item('') OR nWO > 0 ) AND NOT lScrap 
			*Have SOitem or WO
			*Check Alloy in selected Stock to Quote.SOitem or WorkOrder.WO
			PRIVATE cQAlloy, cQForm, cQFormSort, cQCC, cQCL, nQDim1, lQRandLen, cPriceName
			cQAlloy	= ''
			cQForm	= ''
			cQFormSort = ''
			cQCC	= ''
			cQCL	= ''
			nQDim1	= 0
			lRandLen = .F.
			cPriceName = ''
			IF nWO = 0	
				*use the cSOitem 
				cSQL = "SELECT AQ.Alloy,AQ.Form,AQ.CC,AQ.CL,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.RandLen "
				cSQL = cSQL + " ,dbo.f_Price_Alloy(AQ.Alloy) AS PriceName "
				cSQL = cSQL + " ,F.FormSort "
				cSQL = cSQL + " FROM dbo.AllQuotes AQ WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.Forms F WITH(NOLOCK) ON AQ.Form = F.FormNumber "
				cSQL = cSQL + " WHERE AQ.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ELSE
				*use the nWO
				cSQL = "SELECT WO.sAlloy AS Alloy,WO.sForm AS Form,WO.sCC AS CC,WO.sCL AS CL,WO.sThck AS Thck,WO.sSz2 AS Sz2,WO.sSz3 AS Sz3, 0 AS RandLen "
				cSQL = cSQL + " ,dbo.f_Price_Alloy(WO.sAlloy) AS PriceName "
				cSQL = cSQL + " ,F.FormSort "
				cSQL = cSQL + " FROM dbo.WorkOrder WO WITH(NOLOCK) "
				cSQL = cSQL + " INNER JOIN dbo.Forms F WITH(NOLOCK) ON WO.sForm = F.FormNumber "
				cSQL = cSQL + " WHERE WO.WO = "+STR(nWO)
			ENDIF
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQAlloyFormCC")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQAlloyFormCC")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpQAlloyFormCC')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpQAlloyFormCC')
					IF RECCOUNT("tmpQAlloyFormCC") > 0
						cQAlloy	= PrepareSQLtxt(tmpQAlloyFormCC.Alloy,'Alloy',12)
						cQForm	= PrepareSQLtxt(tmpQAlloyFormCC.Form,'Form',2)
						cQFormSort=PrepareSQLtxt(tmpQAlloyFormCC.FormSort,'Form',2)
						cQCC	= PrepareSQLtxt(tmpQAlloyFormCC.CC,'CC',1)
						cQCL	= PrepareSQLtxt(tmpQAlloyFormCC.CL,'CL',1)
						nQDim1	= PrepareSQLnum(tmpQAlloyFormCC.Thck,'Thck',10,4)
						lQRandLen = PrepareSQLlogic(tmpQAlloyFormCC.RandLen,'RandLen')
						cPriceName = PrepareSQLtxt(tmpQAlloyFormCC.PriceName,'PriceName',12)
						&&See save code in SaveStockLstEdit_to_Sales_Stock()
									
						*reportConsumed_Ordered
						IF cPriceName = PriceName(cQAlloy,ThisForm.nConnHandle)
							cAlloy = cQAlloy
							*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"cAlloy ='"+cAlloy+"'. cQAlloy ='"+cQAlloy+"'. cPriceName = '"+cPriceName+"'.")
						ELSE
							*Stupid Alloy names. Make a function to cure!
							IF cQAlloy = 'NI 200 / 201' AND ( cAlloy = 'NI 200' OR cAlloy = 'NI 201' )
								cQAlloy = cAlloy
							ENDIF
							IF ( cQAlloy = 'NI 200' OR cQAlloy = 'NI 201' ) AND cAlloy = 'NI 200 / 201'
								cAlloy = cQAlloy
							ENDIF
							IF cQAlloy = 'NI 200' AND (cAlloy = 'NI 200 / 201' OR cAlloy = 'NI 200' OR cAlloy = 'NI 201' )
								cAlloy = cQAlloy
							ENDIF
							IF cQAlloy = 'NI 200' AND (cAlloy = '200/201' OR cAlloy = '200' OR cAlloy = '201')
								cAlloy = cQAlloy
							ENDIF
							IF cQAlloy = 'NI 201' AND cAlloy = 'NI 200 / 201'
								cAlloy = cQAlloy
							ENDIF
							
							IF cQAlloy = '316L S.S.' AND cAlloy = '316 S.S.'
								cQAlloy = '316 S.S.'
							ENDIF
							IF cQAlloy = '316 S.S.' AND cAlloy = '316L S.S.'
								cQAlloy = '316L S.S.'
							ENDIF
							
							IF cQAlloy = '800HT' AND cAlloy = '800H/HT'
								cQAlloy = '800HT'
							ENDIF
							IF cQAlloy = '800H/HT' AND cAlloy = '800HT'
								cQAlloy = '800H/HT'
							ENDIF
						ENDIF
						
						
						cHTML = HPA_HTML_Header()
						
						IF cQAlloy != cAlloy
							PRIVATE lLetAlloyThru
							lLetAlloyThru = .F.
							DO CASE
							CASE nWO > 0
								cMess = " Edited Stock does not match WorkOrder:"+STR(nWO)+" "+CHR(13)
								cHTML = cHTML + " Edited Stock does not match WorkOrder:"+STR(nWO)+" "+CHR(13)+[<br />]
								
								lLetAlloyThru = .T.
								
							CASE nWO_Detail > 0
								cMess = " Edited Stock does not match WorkOrder Detail:"+STR(nWO_Detail)+" "+CHR(13)
								cHTML = cHTML + " Edited Stock does not match WorkOrder:"+STR(nWO_detail)+" "+CHR(13)+[<br />]
							
								lLetAlloyThru = .T.
							OTHERWISE
								cMess = " Edited Stock does not match Sales Order Item:"+cSOitem+" "+CHR(13)
								cHTML = cHTML + " Edited Stock does not match Sales Order Item:"+cSOitem+" "+CHR(13)+[<br />]
							ENDCASE
							
							
							cMess = cMess + CHR(10)
							cMess = cMess + "Alloy Picked: {"+cAlloy+"}  Quoted:{"+cQAlloy+"} "+CHR(13)
							cMess = cMess + " Form Picked: {"+cForm+"}  Quoted:{"+cQForm+"} "+CHR(13)
							cMess = cMess + "  Condition Code Picked: {"+cCC+"}  Quoted:{"+cQCC+"} "+CHR(13)
							cMess = cMess + " Condition Level Picked: {"+cCL+"}  Quoted:{"+cQCL+"} "+CHR(13)
							cMess = cMess + " Not Allowed to SAVE: Alloy"+" "+CHR(13)
							cMess = cMess + " TBL="+cTBL+" ID_Detail="+ALLTRIM(STR(nID_Detail))+"."+CHR(13)
							
							TrackMess(LEFT(cMess,254))
							*TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
							
							cHTML = cHTML + "Alloy Picked: {"+cAlloy+"}  Quoted:{"+cQAlloy+"} "+[<br />]
							cHTML = cHTML + " Form Picked: {"+cForm+"}  Quoted:{"+cQForm+"} "+[<br />]
							cHTML = cHTML + "  Condition Code Picked: {"+cCC+"}  Quoted:{"+cQCC+"} "+[<br />]
							cHTML = cHTML + " Condition Level Picked: {"+cCL+"}  Quoted:{"+cQCL+"} "+[<br />]
							IF NOT lLetAlloyThru
								cHTML = cHTML + " Not Allowed to SAVE: Alloy"+" "+[<br />]
							ENDIF
							
							IF nWO > 0
								cHTML = cHTML + HTML_WO(nWO,.T.)+[<br />]
							ENDIF
							IF nWO_Detail > 0
								cHTML = cHTML + HTML_WO_Detail(nWO_detail,.T.)+[<br />]
							ENDIF
							IF Proper_SO_item(cSOitem) <> Proper_SO_item("")
								cHTML = cHTML + HTML_SOitem(cSOitem,.T.)+[<br />]
							ENDIF
							
							cHTML = cHTML + SYS(0)+" "+[<br />]
							
							cHTML = cHTML + HPA_HTML_Footer()
							*Send Email
							*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Long Message: "+cHTML )
							*TrackError(cHTML +CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
							Send_HTML_Email( 'DavidKirchner@yahoo.com','David.Kirchner@SpaceAlloysUSA.com',"Not Allowed to modify stock, wrong Alloy",cHTML ,ThisForm.nConnHandle,.T.,.T.)
							
							****************************************************
							IF NOT lLetAlloyThru 
								MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE: Wrong Alloy")
								lOK =.F.
								
								IF Proper_SO_item(cSOitem) <> Proper_SO_item("")
							
									PRIVATE m.loHyperlink,m.cHyperLink
									m.cHyperLink = "https://internal.highperformancealloys.com/onHoldSales/"+ALLTRIM(cSOitem)
									m.loHyperlink = CREATEOBJECT("Hyperlink")
									m.loHyperlink.navigateto(m.cHyperLink)
									RELEASE m.loHyperlink
									
									MESSAGEBOX("You are not allowed to proceed with edit."+CHR(13)+"Please place this SOitem on 'INV Hold'"+CHR(13)+"untill this is fixed on the SO side!"+CHR(13)+CHR(13)+"Look for a blinking Internet Explorer",0+48,"Place a hold on SO untill fixed.")
								ENDIF
							ENDIF
		
						ENDIF
						
						
		*				***
		*				IF cForm = '40' AND tmpQAlloyFormCC.Form = '80' 
		*					*Normally Form 80 is from Plate, but can be from bar!!!
		*					cQForm	= cForm
		*				ENDIF
		*				IF cForm = '10' AND tmpQAlloyFormCC.Form = '80' 
		*					cQForm	= cForm
		*				ENDIF
		*				***
						
						IF lOK 
		*					IF cQForm != cForm AND cForm!='80'   &&cQForm is corrected but Stock may still be listed as 80
							IF cQFormSort <> cFormSort
								IF nWO = 0
									cMess = "Consumed Stock does not match Sales Order Item:"+cSOitem+CHR(13)+CHR(10)
								ELSE
									cMess = "Consumed Stock does not match WorkOrder:"+STR(nWO)+CHR(13)+CHR(10)
								ENDIF
								cMess = cMess +cAlloy +" Alloy Picked"+CHR(13)
								cMess = cMess +cQAlloy+" Alloy Quoted:"+CHR(13)+CHR(10)
								cMess = cMess +cForm +" Form Picked"+CHR(13)
								cMess = cMess +cQForm+" Form Quoted"+CHR(13)+CHR(10)
								IF LEN( ALLTRIM(cCC)+ALLTRIM(cQCC) ) > 0
									cMess = cMess +cCC+ " Condition Code Picked"+CHR(13)
									cMess = cMess +cQCC+" Condition Code Quoted"+CHR(13)+CHR(10)
								ENDIF
								IF LEN( ALLTRIM(cCL)+ALLTRIM(cQCL) ) > 0
									cMess = cMess +cCL+ " Condition Level Picked"+CHR(13)
									cMess = cMess +cQCL+" Condition Level Quoted"+CHR(13)+CHR(10)
								ENDIF						
								cMess = cMess + " TBL="+cTBL+" ID_Detail="+ALLTRIM(STR(nID_Detail))+"."+CHR(13)
								
								cMess = cMess + "SYS(0) " + SYS(0) + "."+CHR(13)
								
								PRIVATE lProduction
								lProduction = .F.
								IF nWO > 0
									*lProduction = CheckWOforProduction(nWO,ThisForm.nConnHandle)
									lProduction = .T.  &&WorkOrders are Production
								ELSE
									lProduction = CheckSOforProduction(cSOitem,ThisForm.nConnHandle)
								ENDIF
								
								IF lProduction
									*Production is allowed to change product form.
								ELSE
									IF NOT (cQForm = '0' OR cQForm = '21' OR cQForm = '22' OR cQForm = '51' OR cQForm = '52' OR cQForm = '53' OR cQForm = '80' OR  cQForm = '90' OR cQForm = '95' OR cQForm = '96' OR cQForm = '97' OR cQForm = '98' OR cQForm = '99' )	
										cMess = cMess + " Allowed to SAVE:Std Form"+CHR(13)
										MESSAGEBOX(cMess,16,"Allowed to SAVE:Std Form")
										cMess = cMess + CHR(13)+HTML_SOitem(cSOitem,.T.)+CHR(10)
										cMess = cMess + CHR(13)+HTML_Stock_ID_Detail(cTBL,nID_Detail,.T.)
										
										TrackMess(LEFT(cMess,254))
										TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order Item",PROGRAM(),LINENO(1))
										
										lOK =.T.
									ELSE
										cMess = cMess + " Allowed to SAVE:Unusual Form"+CHR(13)
										TrackMess(LEFT(cMess,254))
										*TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Order","PROGRAM(),LINENO(1))
										*MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE!")
										*lOK =.F.	
										IF cQForm = '0' OR cQForm = '80' OR cQForm = '90' OR cQForm = '95'		
											*Thes are ALWAYS UNusual form.
											lOK =.T.
										ELSE
											TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Order",PROGRAM(),LINENO(1))
											MESSAGEBOX(cMess,16,"Allowed to SAVE!")
											lOK =.T.	
										ENDIF
										
									ENDIF				
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					
					USE IN tmpQAlloyFormCC
					
					IF NOT lOK
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************************************
		PRIVATE nStkPaid_P2
		nStkPaid_P2 = 0
		IF NOT lScrap 
			nStkPaid_P2 = getInvoiceValue_ID_Detail( nID_Detail, cTBL, ThisForm.nConnHandle ) &&This code needs checked!
		ENDIF
		IF nStkPaid_P = 0
			nStkPaid_P = nStkPaid_P2
		ENDIF
		
		*******************
		*Check tmpStkSum
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpStkSum') < 1
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		
		**************************************************************************************************************************************
		*  dbo.Sales_Stock
		**************************************************************************************************************************************
		*added Quoted_Dim3 and Prev_QTY 12/6/23
		*
		*Quoted_   From AllQuotes
		*StockLst_ From NewStk, what left to be relisted
		*Removed_  From Removed, the tmpStkSum details
		
		PRIVATE cSQLid, nSales_Stock_ID
		PRIVATE nRemoved_PC,nRemoved_Dim1,nRemoved_Dim2,nRemoved_Dim3,nRemoved_Qty,nRemoved_LBS,nRemoved_Paid_Total,nRemoved_Total
		
		PRIVATE cMess, nMess, lUpdateSales_Stock
		cMess = ''
		nMess = 0
		lUpdateSales_Stock = .F.
		
		PRIVATE lAdded
		lAdded = .F.
		PRIVATE nRandNum
		nRandNum = INT(100000*RAND( ))
		
		IF lOK
			SELECT tmpStkSum
			SCAN
				*Scan tmpStkSum
				*Remove Detail_Stock selected
				*ThisForm.Modify_StockLst_How = "DELETE" for ConsumeStock
				******************************************************	
				*-- IF ThisForm.Modify_StockLst_How = "DELETE"
				*-- Removed_ is the detail of the SO item --Not the remove from the Item
				
				IF ThisForm.Modify_StockLst_How = "ADD" AND NOT lMovetoStock
					*Special mode after first Edit, allows drops to be added
					lAdded			= .T.
					nRemoved_PC		= 0
					nRemoved_Dim1	= 0
					nRemoved_Dim2	= 0
					nRemoved_Dim3	= 0
					nRemoved_Qty	= 0
					nRemoved_LBS	= 0
					nRemoved_Paid_Total	= 0
					nRemoved_Total	= 0
					nStockLst_Total = 0
				ELSE
					*lMovetoStock Even thou it is an Add to Stock, the Removed Broker data is needed.
					lAdded			= .F.
					nRemoved_PC		= PrepareSQLnum(tmpStkSum.PCs,'PC',-3)
					nRemoved_Dim1	= PrepareSQLnum(tmpStkSum.Dim1,'Dim1',10,4)
					nRemoved_Dim2	= PrepareSQLnum(tmpStkSum.Dim2,'Dim2',9,4)
					nRemoved_Dim3	= PrepareSQLnum(tmpStkSum.Dim3,'Dim3',9,4)
					nRemoved_Qty	= PrepareSQLnum(tmpStkSum.QTY,'QTY',18,4)
					nRemoved_LBS	= PrepareSQLnum(tmpStkSum.Weight,'Weight',8,1)
					nRemoved_Paid_Total	= nRemoved_Qty * nStkPaid_P
					nRemoved_Total	= nRemoved_Qty * nStockLst_P
					nStockLst_Total = nStockLst_Qty * nStockLst_P
		
					**
					IF nRemoved_LBS = 0
						DO CASE
						CASE nStockLst_PU = 1
							nRemoved_LBS	= nRemoved_Qty
						CASE nStockLst_PU = 2
							*Calc /FT weight
						 	*nRemoved_LBS = CalcWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
						 	nRemoved_LBS = GetWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
						CASE nStockLst_PU = 3
							*Calc /PC Weight
						 	*nSale_LBS = GetWeight(nStk_PC, cAlloy, cForm, nStk_Dim1, nStk_Dim2, nStk_Dim3, ThisForm.nConnHandle)
						 	*No weight chart ready fasteners/fittings
							nRemoved_LBS	= nRemoved_PC
						OTHERWISE
							nRemoved_LBS= 0
						ENDCASE
					ENDIF
					**
				ENDIF
						
				*******************
				*A SO can be shipped to the customer.  
				*A WO modifying or Consuming Stock will not ship to a customer
				*
				*Check for PackingSlip that was created before Shop Stock Edit!!
				PRIVATE cSQL, nSQLEXEC 
				*WAIT WINDOW cSOitem NOWAIT
				IF cSOitem = Proper_SO_item('')
					IF nWO = 0
						MESSAGEBOX("No WorkOrder or SOitem",16,"Error")
						TrackError("No WorkOrder or SOitem","No SOitem to find the packingSlip entry in Sales_Stock ",PROGRAM(),LINENO(1))
					ENDIF
				ELSE
					*Find and update PackingSlip Entry in Sales_Edit
					IF USED('tmpSales_StockP')
						USE IN tmpSales_StockP
					ENDIF
					SELECT 0
		
					cSQL = "SELECT PackingSli,PS_PC,PS_Form,PS_Dim1,PS_Dim2,PS_Dim3,PS_Lbs,WO,Heat,Lot "
					*cSQL = cSQL + " ,StockLst_QTY,StockLst_P,StockLst_Total,StockLst_PC"	&&Depricated StockLst_
					*cSQL = cSQL + " ,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3,StockLst_LBS,ID "
					
					cSQL = cSQL + " ,Orig_QTY,Orig_P,Orig_Total,Orig_PC"	&&Depricated StockLst_
					cSQL = cSQL + " ,Orig_Dim1,Orig_Dim2,Orig_Dim3,Orig_LBS,ID "
		
					*cSQL = cSQL + ",UserEdit "
					cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
					cSQL = cSQL + " AND ISNULL(StockEdit,0) = 0"
					cSQL = cSQL + " AND ISNULL(PackingSli,0)>0 "
					cSQL = cSQL + " AND ISNULL(Removed_Qty,0) = 0"  &&Removed QTY needs to be updated
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_StockP")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_StockP")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_StockP')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						lOK =.F.
					ENDIF
		
		
					*SCAN tmpStkSum 
					IF USED('tmpSales_StockP')
						IF RECCOUNT('tmpSales_StockP')>0
							*SCAN Sales_Stock.PackingSli > 0
							cMess = "Found similar in PackingSlip"+CHR(13)+"Could this have already been Shipped ?"+CHR(13)
							cMess = cMess + ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Dim1,'PS_Dim1',10,4),10,4))
							cMess = cMess + " X "+ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Dim2,'PS_Dim2',9,3),9,3))
							cMess = cMess + " X "+ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Dim3,'PS_Dim3',9,3),9,3))+CHR(13)
							
							cMess = cMess + " "+ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Lbs,'PS_Lbs',9,1),9,1))+"Lbs. "
							cMess = cMess + "  SOitem '"+cSOitem+"'"+CHR(13)
							cMess = cMess + " Heat: "+ALLTRIM( PrepareSQLtxt(tmpSales_StockP.Heat,'Heat',50) )
							IF NOT EMPTY(PrepareSQLtxt(tmpSales_StockP.Lot,'Lot',10))
								cMess = cMess + " Lot: "+ALLTRIM( PrepareSQLtxt(tmpSales_StockP.Lot,'Lot',10) )
							ENDIF
							
							nMess = MESSAGEBOX(cMess,4+32,"Update using this PackingSlip Data?")
							IF nMess = 6
								lUpdateSales_Stock = .T.
														
								*Get Master,Detail,Process for ID_Detail
								IF USED('tmpStk_QTY')
									USE IN tmpStk_QTY
								ENDIF
								
								SELECT 0
								
								cSQL = "SELECT "
								cSQL = cSQL + " S_QTY, S_P ,S_Total "
								cSQL = cSQL + ",PC,Dim1,Dim2,Dim3,[Weight]"
								cSQL = cSQL + ",D.ID, D.ID_Detail, M.Lot"
								cSQL = cSQL + ",ISNULL(P.PO_item,'') AS PO_item "
								cSQL = cSQL + ",ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process "
								DO CASE
								CASE cTBL = "S"
									cSQL = cSQL + ",'S' AS TBL "
									cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.Stocklst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
								CASE cTBL = "B"
									cSQL = cSQL + ",'B' AS TBL "
									cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.Brokerlst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
								CASE cTBL = "W"
									cSQL = cSQL + ",'W' AS TBL "
									cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.WIPlst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
								ENDCASE
								cSQL = cSQL + " WHERE D.ID_Detail="+STR(nID_Detail)
								cSQL = cSQL + " AND ( ISNULL(P.Process_ID,'SELECTED')='SELECTED' OR ISNULL(P.Process_ID,'')='PARTSELECT' )"
											
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY' )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY')
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY')
									ENDDO
								ENDIF
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStk_QTY")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStk_QTY")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpStk_QTY')
									RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
									lOK =.F.
								ENDIF
		
								IF USED('tmpStk_QTY')
									IF RECCOUNT('tmpStk_QTY')>0
										*nID_Detail_Process = 0
										*Do not overwrite the Packing Slip entry PS_
										*Pick_	  like Quoted_
										
										cSQL = "UPDATE dbo.Sales_Stock SET "
		*								cSQL = cSQL + " StockLst_LBS="+STR(PrepareSQLnum(tmpStk_QTY.S_QTY,'S_QTY',-5),18,4) &&depricated
										cSQL = cSQL + " StockLst_POitem ='"+PrepareSQLtxt(tmpStk_QTY.PO_item,'PO_item',12)+"'"					
										
										cSQL = cSQL + ",[Edited]="+IIF(lEdited,"1","0") &&Edited
										cSQL = cSQL + ",[Added]="+IIF(lAdded,"1","0") &&Added
										cSQL = cSQL + ",Consumed="+IIF(lConsumed,"1","0") &&Consumed 
										cSQL = cSQL + ",StkBack="+IIF(lStkBackValued,"1","0") &&StkBack
		
										*cSQL = cSQL + ",StockEdit=GetDate()"
										cSQL = cSQL + ",StockEdit='"+TTOC(dtGetDate)+"'"
										cSQL = cSQL + ",TBL='"+tmpStk_QTY.TBL+"'"
										cSQL = cSQL + ",StockLst_ID="+STR(PrepareSQLnum(tmpStk_QTY.ID,'Master_ID',-3))
										cSQL = cSQL + ",StockLst_ID_Detail="+STR(PrepareSQLnum(tmpStk_QTY.ID_Detail,'ID_Detail',-3))
										cSQL = cSQL + ",ID_Detail_Process="+STR(PrepareSQLnum(tmpStk_QTY.ID_Detail_Process,'ID_Detail_Process',-3))
										
										cSQL = cSQL + ",Lot='"+PrepareSQLtxt(tmpStk_Qty.Lot,'Lot',10)+"'"
										
										cSQL = cSQL + ",Orig_PC  ="+STR(PrepareSQLnum(nOrig_PC,'PC',10),10)
										cSQL = cSQL + ",Orig_Dim1="+STR(PrepareSQLnum(nOrig_Dim1,'Dim1',10,4),10,4)
										cSQL = cSQL + ",Orig_Dim2="+STR(PrepareSQLnum(nOrig_Dim2,'Dim2',9,3),9,3)
										cSQL = cSQL + ",Orig_Dim3="+STR(PrepareSQLnum(nOrig_Dim3,'Dim3',9,3),9,3)
										cSQL = cSQL + ",Orig_LBS ="+STR(PrepareSQLnum(nOrig_LBS,'Weight',9,1),9,1)
										cSQL = cSQL + ",Orig_QTY ="+STR(PrepareSQLnum(nOrig_QTY,'QTY',18,4),18,4)
										cSQL = cSQL + ",Orig_P ="  +STR(PrepareSQLnum(nOrig_P,'P',18,4),18,4)
										cSQL = cSQL + ",Orig_PU =" +STR(PrepareSQLnum(nStockLst_PU,'PU',-1),2)
										
										cSQL = cSQL + ",Left_PC="  +STR(PrepareSQLnum(nNewStk_PC,'PC',10),10)
										cSQL = cSQL + ",Left_Dim1="+STR(PrepareSQLnum(nNewStk_Dim1,'Dim1',10,4),10,4)
										cSQL = cSQL + ",Left_Dim2="+STR(PrepareSQLnum(nNewStk_Dim2,'Dim2',9,3),9,3)
										cSQL = cSQL + ",Left_Dim3="+STR(PrepareSQLnum(nNewStk_Dim3,'Dim3',9,3),9,3)
										cSQL = cSQL + ",Left_LBS=" +STR(PrepareSQLnum(nNewStk_LBS,'Weight',9,1),9,1)
										cSQL = cSQL + ",Left_QTY=" +STR(PrepareSQLnum(nNewStk_QTY,'QTY',-5),18,4)
										
										cSQL = cSQL + ",StkPaid_P="+STR(PrepareSQLnum(tmpStk_QTY.S_P,'S_P',-5),18,4)
										cSQL = cSQL + ",StkPaid_Total="+STR(PrepareSQLnum(tmpStk_QTY.S_Total,'S_Total',-5),18,4)
		*tmpStk_QTY.S_P = 0 ???
		*tmpStk_QTY.S_Total = 0 ???
									
										cSQL = cSQL + ",WO="+STR(PrepareSQLnum(nWO,'WO',-3))
										cSQL = cSQL + ",WO_Detail="+STR(PrepareSQLnum(nWO_Detail,'WO_Detail',-3))
										cSQL = cSQL + ",UserEdit='"+PrepareSQLtxt(cUserEdit,"UserEdit",-1)+"'"
										*cSQL = cSQL + ",UserEdit=ISNULL(UserEdit,'')+' "+PrepareSQLtxt(cUserEdit,"UserEdit",-1)+"'"
										
										cSQL = cSQL + " WHERE ID = "+STR(PrepareSQLnum(tmpSales_StockP.ID,'ID',-3))
										
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
										ENDDO
										IF nSQLEXEC < 0 &&Try again!
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL 2' TIMEOUT 1
												nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
											ENDDO
										ENDIF
										IF nSQLEXEC < 0 &&Try again!
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL 2' TIMEOUT 1
												nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
												
												IF nSQLEXEC < 0
													IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
														nSQLEXEC = 0
													ENDIF
												ENDIF
											ENDDO
										ENDIF
										IF nSQLEXEC < 0
											SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, '')
											RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
											lOK =.F.
										ENDIF
										
									ENDIF
									USE IN tmpStk_QTY
								ENDIF
							ENDIF				
							
						ENDIF
					ENDIF
					USE IN 'tmpSales_StockP'
				ENDIF
				
				******************************************************	
				*Get nSales_Stock_ID 
				* ID = "+STR(PrepareSQLnum(tmpSales_StockP.ID,'ID',-3))
				nSales_Stock_ID = Check_PS_Entry(cSOitem,nWO,ThisForm.nConnHandle)
				** Should not find by WO in a PackingSlip entry screen
				
				******************************************************	
				*DO Accounting Check
				*Does New drop have value, or is it to be written off
				IF lScrap 
					lStkBackValued = .F.
				ELSE
					IF nStkPaid_P > 0
						lStkBackValued = .T.
					ELSE
						lStkBackValued = .F.
					ENDIF
				ENDIF
				
				
				******************************************************	
				
				*IF NOT lUpdateSales_Stock   
				*nSales_Stock_ID = Check_PS_Entry(cSOitem,nWO,ThisForm.nConnHandle)
				IF nSales_Stock_ID = 0
					*Insert
					*A WO would never have a SOitem PackingSlip create a dbo.Sales_Stock entry to UPDATE
					*A WO will always be INSERT
					
					cSQLid = "INSERT INTO dbo.Sales_Stock ("
					cSQLid = cSQLid+ " Invoice "
					cSQLid = cSQLid+ ",SOitem"
		*			cSQLid = cSQLid+ ",StockLst_Qty"	&&depricated
		*			cSQLid = cSQLid+ ",StockLst_P"
		*			cSQLid = cSQLid+ ",StockLst_Total"
		*			cSQLid = cSQLid+ ",StockLst_PU"
		*			cSQLid = cSQLid+ ",StockLst_PC"
		*			cSQLid = cSQLid+ ",StockLst_Dim1"
		*			cSQLid = cSQLid+ ",StockLst_Dim2"
		*			cSQLid = cSQLid+ ",StockLst_Dim3"
		*			cSQLid = cSQLid+ ",StockLst_LBS"
					cSQLid = cSQLid+ ",[StockLst_POitem]"	
					cSQLid = cSQLid+ ",[Edited]"
					cSQLid = cSQLid+ ",[Added]"
					cSQLid = cSQLid+ ",Consumed"
					cSQLid = cSQLid+ ",StkBack"
					cSQLid = cSQLid+ ",Scrap"
					cSQLid = cSQLid+ ",StockEdit"
					cSQLid = cSQLid+ ",TBL"
					cSQLid = cSQLid+ ",StockLst_ID"
					cSQLid = cSQLid+ ",StockLst_ID_Detail"
					cSQLid = cSQLid+ ",ID_Detail_Process"
					
					*the tmpStkSum details nRemoved_ --need to use scan to get all records.
					cSQLid = cSQLid+ ",Removed_PC"
					cSQLid = cSQLid+ ",Removed_Dim1"
					cSQLid = cSQLid+ ",Removed_Dim2"
					cSQLid = cSQLid+ ",Removed_Dim3"
				    cSQLid = cSQLid+ ",Removed_LBS"
				    cSQLid = cSQLid+ ",Removed_Qty"
				    cSQLid = cSQLid+ ",Removed_Paid_Total"
				    cSQLid = cSQLid+ ",Removed_Total"
				    
					cSQLid = cSQLid+ ",Alloy"
					cSQLid = cSQLid+ ",Form"
					cSQLid = cSQLid+ ",Heat"
					cSQLid = cSQLid+ ",Lot"
					cSQLid = cSQLid+ ",CC"
					cSQLid = cSQLid+ ",CL"
					
					*Before ShopStockLstEdit removed
					cSQLid = cSQLid+ ",RandLen"
					cSQLid = cSQLid+ ",Orig_PC"
					cSQLid = cSQLid+ ",Orig_Dim1"
					cSQLid = cSQLid+ ",Orig_Dim2"
					cSQLid = cSQLid+ ",Orig_Dim3"
					cSQLid = cSQLid+ ",Orig_LBS"
					cSQLid = cSQLid+ ",Orig_QTY"
					cSQLid = cSQLid+ ",Orig_P"
					cSQLid = cSQLid+ ",Orig_PU"
					cSQLid = cSQLid+ ",StkPaid_P"
					cSQLid = cSQLid+ ",StkPaid_Total"
					
					*Edits left on the screen, NewStk_
					cSQLid = cSQLid+ ",Left_PC"
					cSQLid = cSQLid+ ",Left_Dim1"
					cSQLid = cSQLid+ ",Left_Dim2"
					cSQLid = cSQLid+ ",Left_Dim3"
					cSQLid = cSQLid+ ",Left_LBS"
					cSQLid = cSQLid+ ",Left_QTY"
					
					cSQLid = cSQLid+ ",WO"
					cSQLid = cSQLid+ ",WO_Detail"
					cSQLid = cSQLid+ ",UserEdit "
					
				*cSQLid = cSQLid+ ",Sale_PC,Sale_Dim1,Sale_Dim2,Sale_Dim3,Sale_LBS"
					cSQLid = cSQLid+ ") VALUES ("
					cSQLid = cSQLid+ " "+STR(nRandNum)	&&+" AS [Invoice]"
					cSQLid = cSQLid+ ",'"+cSOitem+"'"
		*			cSQLid = cSQLid+ ","+STR(nStockLst_Qty,18,4)   &&StockLst_QTY
		*			cSQLid = cSQLid+ ","+STR(nStockLst_P,18,4)	   &&StockLst_P
		*			cSQLid = cSQLid+ ","+STR(nStockLst_Total,18,4) &&StockLst_Total
		*			cSQLid = cSQLid+ ","+STR(nStockLst_PU)		&&StockLst_PU
		*			cSQLid = cSQLid+ ","+STR(nOrig_PC,10,0) 	&&StockLst_PC
		*			cSQLid = cSQLid+ ","+STR(nOrig_Dim1,18,4)	&&StockLst_Dim1
		*			cSQLid = cSQLid+ ","+STR(nOrig_Dim2,17,3)	&&StockLst_Dim2
		*			cSQLid = cSQLid+ ","+STR(nOrig_Dim3,17,3)	&&StockLst_Dim3
		*			cSQLid = cSQLid+ ","+STR(nOrig_LBS,15,1)	&&StockLst_LBS
					cSQLid = cSQLid+ ",'"+cPOitem+"'"
					cSQLid = cSQLid+ ","+IIF(lEdited,"1","0") &&Edited
					cSQLid = cSQLid+ ","+IIF(lAdded,"1","0") &&Added
					cSQLid = cSQLid+ ","+IIF(lConsumed,"1","0") &&Consumed 
					IF NOT lScrap 
						cSQLid = cSQLid+ ","+IIF(lStkBackValued,"1","0") &&StkBack
						cSQLid = cSQLid+ ","+IIF(lScrap,"1","0") &&Scrap
					ELSE
						cSQLid = cSQLid+ ", 0" &&StkBack
						cSQLid = cSQLid+ ", 1" &&Scrap
					ENDIF
		*StkBackValued, Added drop back to StockLst with 0 - written off drop
					
				    *cSQLid = cSQLid+ ",GetDate()" &&StockEdit
				    cSQLid = cSQLid + ",'"+TTOC(dtGetDate)+"'"
				    
					cSQLid = cSQLid+ ",'"+IIF(cTBL="S","S",IIF(cTBL="B","B","W"))+"'"
					cSQLid = cSQLid+ ","+STR(nID)
					cSQLid = cSQLid+ ","+STR(nID_Detail)
					cSQLid = cSQLid+ ","+STR(nID_Detail_Process)
					
					*the tmpStkSum details nRemoved_ --need to use scan to get all records.
					*nRemoved_PC,nRemoved_Dim1,nRemoved_Dim2,nRemoved_Dim3,nRemoved_Qty,nRemoved_LBS,nRemoved_Paid_Total,nRemoved_Total
					cSQLid = cSQLid+ ","+STR(nRemoved_PC,10)		&&Removed
					cSQLid = cSQLid+ ","+STR(nRemoved_Dim1,10,4)	&&Removed
					cSQLid = cSQLid+ ","+STR(nRemoved_Dim2,9,3)		&&Removed
					cSQLid = cSQLid+ ","+STR(nRemoved_Dim3,9,3)		&&Removed
				    cSQLid = cSQLid+ ","+STR(nRemoved_LBS,8,1)		&&Removed
				    cSQLid = cSQLid+ ","+STR(nRemoved_Qty,18,4)		&&Removed
				    cSQLid = cSQLid+ ","+STR(nRemoved_Paid_Total,18,4)	&&Removed
				    cSQLid = cSQLid+ ","+STR(nRemoved_Total,18,4)		&&Removed
				    
					cSQLid = cSQLid+ ",'"+cAlloy+"'"
					cSQLid = cSQLid+ ",'"+cForm+"'"
					cSQLid = cSQLid+ ",'"+cHeat+"'"
					cSQLid = cSQLid+ ",'"+cLot+"'"
					cSQLid = cSQLid+ ",'"+cCC+"'"
					cSQLid = cSQLid+ ",'"+cCL+"'"
					cSQLid = cSQLid+ ","+IIF(lRandLen,'1','0')
					
					*Before ShopStockLstEdit removed, from unedited screen data
					cSQLid = cSQLid+ ","+STR(nOrig_PC,10)		&&Orig
					cSQLid = cSQLid+ ","+STR(nOrig_Dim1,10,4)	&&Orig
					cSQLid = cSQLid+ ","+STR(nOrig_Dim2,9,3)	&&Orig
					cSQLid = cSQLid+ ","+STR(nOrig_Dim3,9,3)	&&Orig
					cSQLid = cSQLid+ ","+STR(nOrig_LBS,9,1)		&&Orig
					cSQLid = cSQLid+ ","+STR(nOrig_QTY,18,4)	&&Orig
					cSQLid = cSQLid+ ","+STR(nStockLst_P,18,4)		&&Orig
					cSQLid = cSQLid+ ","+STR(nStockLst_PU)		&&Orig
					
					cSQLid = cSQLid+ ","+STR(nStkPaid_P,18,4)
					cSQLid = cSQLid+ ","+STR(nRemoved_Paid_Total,18,4)	
					
					*Edits left on the screen, NewStk_
					cSQLid = cSQLid+ ","+STR(nNewStk_PC)  		&&Left_PC
					cSQLid = cSQLid+ ","+STR(nNewStk_Dim1,18,4)	&&Left_Dim1  --Actually Dim1 on Screen
					cSQLid = cSQLid+ ","+STR(nNewStk_Dim2,17,3)	&&Left_Dim2  --Actually Dim2 on Screen
					cSQLid = cSQLid+ ","+STR(nNewStk_Dim3,17,3)	&&Left_Dim3  --Actually Dim3 on Screen
					cSQLid = cSQLid+ ","+STR(nNewStk_LBS,9,1)	&&Left_LBS
					cSQLid = cSQLid+ ","+STR(nNewStk_QTY,18,4)	&&Left_QTY
					
					cSQLid = cSQLid+ ","+STR(nWO)
					cSQLid = cSQLid+ ","+STR(nWO_Detail)
					cSQLid = cSQLid+ ",'"+cUserEdit+"'"
					
					cSQLid = cSQLid+ ")"
					
				ELSE
				
					cSQLid = "UPDATE dbo.Sales_Stock SET "
		*			cSQLid = cSQLid+ " SOitem="+"'"+cSOitem+"'"
		*			cSQLid = cSQLid+ " StockLst_Qty="+STR(nStockLst_Qty,18,4)	&&Depricated
		*			cSQLid = cSQLid+ ",StockLst_P="+STR(nStockLst_P,18,4)
		*			cSQLid = cSQLid+ ",StockLst_Total="+STR(nStockLst_Total,18,4)   &&nRemoved_Total
		*			cSQLid = cSQLid+ ",StockLst_PU="+STR(nStockLst_PU)
		*			cSQLid = cSQLid+ ",StockLst_PC="+STR(nOrig_PC,10,0) &&StockLst_PC nOrig_PC
		*			cSQLid = cSQLid+ ",StockLst_Dim1="+STR(nOrig_Dim1,10,4)
		*			cSQLid = cSQLid+ ",StockLst_Dim2="+STR(nOrig_Dim2,9,3)
		*			cSQLid = cSQLid+ ",StockLst_Dim3="+STR(nOrig_Dim3,9,3)
		*			cSQLid = cSQLid+ ",StockLst_LBS="+STR(nOrig_LBS,9,1)
					cSQLid = cSQLid+ " [StockLst_POitem]=dbo.f_ProperPOitem('"+cPOitem+"')"
					cSQLid = cSQLid+ ",[Edited]="+IIF(lEdited,"1","0") &&Edited
					cSQLid = cSQLid+ ",[Added]="+IIF(lAdded,"1","0") &&Added
					cSQLid = cSQLid+ ",Consumed="+IIF(lConsumed,"1","0") &&Consumed 
					cSQLid = cSQLid+ ",StkBack="+IIF(lStkBackValued,"1","0") &&StkBack
					
					*cSQLid = cSQLid+ ",StockEdit=GetDate()" &&StockEdit
					cSQLid = cSQLid+ ",StockEdit='"+TTOC(dtGetDate)+"'"
					
					cSQLid = cSQLid+ ",TBL='"+IIF(cTBL="S","S",IIF(cTBL="B","B","W"))+"'"
					cSQLid = cSQLid+ ",StockLst_ID="+STR(nID)
					cSQLid = cSQLid+ ",StockLst_ID_Detail="+STR(nID_Detail)
					cSQLid = cSQLid+ ",ID_Detail_Process="+STR(nID_Detail_Process)
					
					*the tmpStkSum details nRemoved_ --need to use scan to get all records.
					*nRemoved_PC,nRemoved_Dim1,nRemoved_Dim2,nRemoved_Dim3,nRemoved_Qty,nRemoved_LBS,nRemoved_Paid_Total,nRemoved_Total
					cSQLid = cSQLid+ ",Removed_PC="+STR(nRemoved_PC,10)
					cSQLid = cSQLid+ ",Removed_Dim1="+STR(nRemoved_Dim1,10,4)
					cSQLid = cSQLid+ ",Removed_Dim2="+STR(nRemoved_Dim2,9,3)
					cSQLid = cSQLid+ ",Removed_Dim3="+STR(nRemoved_Dim3,9,3)
				    cSQLid = cSQLid+ ",Removed_QTY="+STR(nRemoved_Qty,18,4)
				    cSQLid = cSQLid+ ",Removed_LBS="+STR(nRemoved_LBS,9,1)
				    cSQLid = cSQLid+ ",Removed_Paid_Total="+STR(nRemoved_Paid_Total,18,4)
				    cSQLid = cSQLid+ ",Removed_Total="+STR(nRemoved_Total,18,4)
				    
				    cSQLid = cSQLid+ ",Alloy='"+cAlloy+"'"
					cSQLid = cSQLid+ ",Form='"+cForm+"'"
					cSQLid = cSQLid+ ",Heat='"+cHeat+"'"
					cSQLid = cSQLid+ ",Lot='"+cLot+"'"
					cSQLid = cSQLid+ ",CC='"+cCC+"'"
					cSQLid = cSQLid+ ",CL='"+cCL+"'"
					cSQLid = cSQLid+ ",RandLen="+IIF(lRandLen,'1','0')
					
					*Before ShopStockLstEdit removed, from unedited screen data
					cSQLid = cSQLid+ ",Orig_PC="+STR(nOrig_PC)  &&Orig
					cSQLid = cSQLid+ ",Orig_Dim1="+STR(nOrig_Dim1,18,4)
					cSQLid = cSQLid+ ",Orig_Dim2="+STR(nOrig_Dim2,17,3)
					cSQLid = cSQLid+ ",Orig_Dim3="+STR(nOrig_Dim3,17,3)
					cSQLid = cSQLid+ ",Orig_LBS ="+STR(nOrig_LBS,15,1)
					cSQLid = cSQLid+ ",Orig_Qty="+STR(nStockLst_Qty,18,4)	
					cSQLid = cSQLid+ ",Orig_P="+STR(nStockLst_P,18,4)
		*			cSQLid = cSQLid+ ",Orig_Total="+STR(nStockLst_Total,18,4)   &&Computed
					cSQLid = cSQLid+ ",Orig_PU="+STR(nStockLst_PU)
					
					
					cSQLid = cSQLid+ ",StkPaid_P="+STR(nStkPaid_P,18,4)
					cSQLid = cSQLid+ ",StkPaid_Total="+STR(nRemoved_Paid_Total,18,4)
					
					*Edits left on the screen, NewStk_
					cSQLid = cSQLid+ ",Left_PC="+STR(nNewStk_PC,10)  &&Orig
					cSQLid = cSQLid+ ",Left_Dim1="+STR(nNewStk_Dim1,10,4)
					cSQLid = cSQLid+ ",Left_Dim2="+STR(nNewStk_Dim2,9,3)
					cSQLid = cSQLid+ ",Left_Dim3="+STR(nNewStk_Dim3,9,3)
					cSQLid = cSQLid+ ",Left_LBS="+STR(nNewStk_LBS,9,1)
					cSQLid = cSQLid+ ",Left_QTY="+STR(nNewStk_QTY,18,4)
		
					cSQLid = cSQLid+ ",WO="+STR(nWO)
					cSQLid = cSQLid+ ",WO_Detail="+STR(nWO_Detail)
					cSQLid = cSQLid+ ",UserEdit='"+cUserEdit+"'"
					*cSQLid = cSQLid+ ",UserEdit= ISNULL(UserEdit,'') + '"+cUserEdit+"'"
																	
					cSQLid = cSQLid+ " WHERE ID="+STR(nSales_Stock_ID)
					
					*nSales_Stock_ID = 0
		*			TrackError(cSQLid,"Found Sales_Stock from PackingSlip!?!"+" Sales_Stock.ID="+STR(nSales_Stock_ID),PROGRAM(),LINENO(0))
					RecordTest('Record Test Data.',PROGRAM(),LINENO(0),"Found Sales_Stock from PackingSlip!?!"+" Sales_Stock.ID="+STR(nSales_Stock_ID)+" "+CHR(13)+cSQLid)
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLid, ThisForm.nConnHandle,nSQLEXEC)
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					lOK =.F.
				ENDIF
						
		
				
				IF nSales_Stock_ID = 0
					*now find the INSERTed nSales_Stock_ID
							
					IF USED('tmpSales_Stock_ID')
						USE IN tmpSales_Stock_ID
					ENDIF
					
					cSQL = "SELECT ID FROM dbo.Sales_Stock "
					cSQL=cSQL+" WITH(NOLOCK) "
					cSQL=cSQL+" WHERE [Invoice] = "+STR(nRandNum)
					
					cSQL=cSQL+ " AND [TBL] = '"+IIF(cTBL="S","S",IIF(cTBL="B","B","W"))+"'"
					cSQL=cSQL+ " AND [StockLst_ID] ="+STR(nID)
					cSQL=cSQL+ " AND [StockLst_ID_Detail] ="+STR(nID_Detail)
					cSQL=cSQL+ " AND [ID_Detail_Process] ="+STR(nID_Detail_Process)
					
					*These are specific to the SCAN tmpStkSum
					cSQL=cSQL+ " AND [Removed_PC]="+STR(nRemoved_PC,10)
					cSQL=cSQL+ " AND [Removed_Dim1]="+STR(nRemoved_Dim1,10,4)
					cSQL=cSQL+ " AND [Removed_Dim2]="+STR(nRemoved_Dim2,9,3)
					cSQL=cSQL+ " AND [Removed_Dim3]="+STR(nRemoved_Dim3,9,3)
				    cSQL=cSQL+ " AND [Removed_QTY]="+STR(nRemoved_Qty,18,4)
				    cSQL=cSQL+ " AND [Removed_LBS]="+STR(nRemoved_LBS,9,1)
					    
			*!*			*cSQL=cSQL+" AND [StockEdit]='"+TTO_SQL_C(dtGetDate)+"'"
			*!*	*				cSQL=cSQL+" AND StkPaid_P="+STR(nStkPaid_P,18,4)
			*!*	*				cSQL=cSQL+" AND StkPaid_Total="+STR(nRemoved_Paid_Total,18,4)
			*!*			cSQL=cSQL+" AND [WO]="+STR(nWO)
			*!*			cSQL=cSQL+ " AND [WO_Detail] ="+STR(nWO_Detail)
			*!*			cSQL=cSQL+ " AND [UserEdit] ='"+cUserEdit+"'"
				
					
					SELECT 0
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpSales_Stock_ID' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpSales_Stock_ID' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpSales_Stock_ID' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpSales_Stock_ID' )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Stock_ID")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Stock_ID")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL , ThisForm.nConnHandle,nSQLEXEC,'tmpSales_Stock_ID')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ENDIF
		
					IF USED('tmpSales_Stock_ID')
						IF RECCOUNT('tmpSales_Stock_ID') > 0
							nSales_Stock_ID = PrepareSQLnum(tmpSales_Stock_ID.ID,'Sales_Stock_ID',-3)
						ENDIF
						USE IN tmpSales_Stock_ID
					ENDIF
				ENDIF
				*now have nSales_Stock_ID 
				
				****
				IF ThisForm.nWO > 0 AND nSales_Stock_ID > 0
					PRIVATE lOutSource
					lOutSource = is_WO(ThisForm.nWO,ThisForm.nConnhandle,'OutSource')
					
					IF lOutSource 
						PRIVATE nMess, cMess
						*Most WOs will be internal and also kept in WIP
						cMess = "This Stock Edit was for a WO "+ALLTRIM(STR(nWO))+CHR(13)+"Is this stock going to outside processing?"
						nMess = MESSAGEBOX(cMess,3+32,"OutSource ?")
						
						* Lst_Process_Grab has data
						
						*Insert into OutSource
						cSQL = "INSERT INTO dbo.WO_OutSource "
						cSQL = cSQL + "([WO]"
				      	cSQL = cSQL + ",[SOitem]"
				*      	cSQL = cSQL + ",[Converter]"
				*      	cSQL = cSQL + ",[ConvertPOi]"
				      	cSQL = cSQL + ",[ConvertSent]"
				      	cSQL = cSQL + ",[Stock_TBL]"
				      	cSQL = cSQL + ",[Stock_ID]"
				      	cSQL = cSQL + ",[Stock_ID_D]"
				      	cSQL = cSQL + ",[Stock_ID_D_P]"
				      	cSQL = cSQL + ",[Stock_QTY]"
				      	cSQL = cSQL + ",[Stock_PU]"
				      	
				      	cSQL = cSQL + ",[Sales_Detail_ID]"
				      	cSQL = cSQL + ",[Sales_Stock_ID]"
				      	cSQL = cSQL + ",[StockEdit]"
						cSQL = cSQL + ") VALUES ("
						
						cSQL = cSQL + " "+STR(ThisForm.nWO)
				      	cSQL = cSQL + ",'"+cSOitem+"'"
				*      	cSQL = cSQL + ",[Converter]
				*      	cSQL = cSQL + ",[ConvertPOi]
				
				      	*cSQL = cSQL + ",GetDate()"
				      	cSQL = cSQL + ",'"+TTOC(dtGetDate)+"'"
				      	
				      	cSQL = cSQL + ",'"+cTBL+"'"
				      	cSQL = cSQL + ","+STR(nID)
				      	cSQL = cSQL + ","+STR(nID_Detail)
				      	cSQL = cSQL + ","+STR(nID_Detail_Process)
				      	cSQL = cSQL + ","+STR(nStockLst_QTY)
				      	cSQL = cSQL + ","+STR(nStockLst_PU)
				      	
				      	cSQL = cSQL + ",0"	&&[Sales_Detail_ID]  -not know yet
				      	cSQL = cSQL + ","+STR(nSales_Stock_ID)
				      	cSQL = cSQL + ",'"+TTOC(dtGetDate)+"'"
						cSQL = cSQL + ")"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'' )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'' )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						ENDIF
						
					ENDIF
				ENDIF
		
			ENDSCAN  &&tmpStkSum
		ENDIF
		*have nSales_Stock_ID 
		
		************************************************************************************************************************************
		*  Update dbo.Sales_Detail 
		************************************************************************************************************************************
		
		IF lOK
			*Collect Old Stock for dbo.Sales_Detail
			PRIVATE nSalesNum
			nSalesNum = VAL(cSOitem)
			
			PRIVATE nQuoted_PC,nQuoted_Dim1,nQuoted_Dim2,nQuoted_Dim3,nQuoted_LBS,nQuoted_Qty
			*Default to tmpStkSum, if found in Allquotes, Overwrite.
			
			SELECT tmpStkSum
		
			SCAN
				*Collect AllQuotes SOitem data
				IF USED('tmpAQpc')
					USE IN tmpAQpc
				ENDIF
				SELECT 0
				
				*IF cSOitem != Proper_SO_item('')
				IF nWO = 0
					cSQL = "SELECT [Pieces] AS PC, [Thck] AS Dim1, [Sz2] AS Dim2, [Sz3] AS Dim3, [Weight]"
					cSQL = cSQL + ",ISNULL(dbo.f_Get_QTY_SOitem(SOitem),0) AS Quoted_QTY, cWeight"
					cSQL = cSQL + ",Form, dbo.f_GetWeightDisk(Pieces,Alloy,Form,Thck,Sz2,Sz3) AS DiskLBS"
					cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				*ENDIF
				*IF nWO > 0
				ELSE
					cSQL = "SELECT [sPieces] AS PC, [sThck] AS Dim1, [sSz2] AS Dim2, [sSz3] AS Dim3, [sWeight] AS [Weight]"
					cSQL = cSQL + ",[sWeight] as Quoted_QTY "
					cSQL = cSQL + ",sWeight AS cWeight "
					cSQL = cSQL + ",sForm AS Form, 0 AS DiskLBS "
					cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) "
					cSQL = cSQL + " WHERE WO = "+STR(nWO) 
				ENDIF		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQpc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQpc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpAQpc')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					nQuoted_Dim1 = 0
					IF USED('tmpAQpc')
						IF RECCOUNT('tmpAQpc')>0
							nQuoted_PC	= PrepareSQLnum(tmpAQpc.PC,'PC',-3)
							nQuoted_Dim1= PrepareSQLnum(tmpAQpc.Dim1,'Dim1',10,4)
							nQuoted_Dim2= PrepareSQLnum(tmpAQpc.Dim2,'Dim2',9,3)
							nQuoted_Dim3= PrepareSQLnum(tmpAQpc.Dim3,'Dim3',9,3)
							nQuoted_LBS	= PrepareSQLnum(tmpAQpc.Weight,'Weight',9,1)
							nQuoted_Qty	= PrepareSQLnum(tmpAQpc.Quoted_QTY,'Quoted_QTY',-5)
							nQuoted_LBS	= PrepareSQLnum(tmpAQpc.cWeight,'cWeight',-5)
							cQuoted_Form= PrepareSQLtxt(tmpAQpc.Form,'Form',2)
							IF cQuoted_Form = '80'
								nQuoted_LBS = PrepareSQLnum(tmpAQpc.DiskLBS,'DiskLBS',-5)
							ENDIF
						ENDIF
						USE IN tmpAQpc
					ENDIF
					
					*WAIT WINDOW cSOitem NOWAIT
					
					IF (Proper_SO_Item(cSOitem) != Proper_SO_Item('') OR nWO > 0 ) 
						*makes a Sales_Detail_ID
						
						cSQLi = "EXEC dbo.p_Sales_Detail_ins @SOitem='"+cSOitem+"', @WO="+STR(nWO)
						*Just returns the Scope_Identity
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpSales_Detail_ID')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpSales_Detail_ID')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpSales_Detail_ID")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpSales_Detail_ID")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Detail_ID')
								RecordError(nSQLEXEC,"SQL Error",PROGRAM(),LINENO(),cSQLi )
								TrackError("Could not EXEC dbo.p_Sales_Detail_ins"+CHR(13)+cSQLi,"p_Sales_Detail_ins","Proc_StockLst:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
							ELSE
								nSQLEXEC = 1
							ENDIF
						ENDIF
						IF nSQLEXEC > 0
							IF USED("tmpSales_Detail_ID")
								nSales_Detail_ID = PrepareSQLnum(tmpSales_Detail_ID.Exp,'Sales_Detail_ID',-3)
								USE IN tmpSales_Detail_ID
							ENDIF
						ENDIF
						*****************
						
						IF nSales_Detail_ID > 0
							*Update
							PRIVATE cSQLid
							cSQLid = "UPDATE dbo.Sales_Detail SET "
							cSQLid = cSQLid+ " SOitem='"+cSOitem+"'"
							cSQLid = cSQLid+ ",SalesNum="+STR(nSalesNum) 
							*cSQLid = cSQLid+ ",Invoice="
							cSQLid = cSQLid+ ",WO="+STR(nWO)
							
							*From AllQuotes
							cSQLid = cSQLid+ ",Quoted_PC="+STR(nQuoted_PC,10,0)	&&Quoted_PC
							cSQLid = cSQLid+ ",Quoted_Dim1="+STR(nQuoted_Dim1,10,4)	&&Quoted_Dim1
							cSQLid = cSQLid+ ",Quoted_Dim2="+STR(nQuoted_Dim2,9,3)	&&Quoted_Dim2
							cSQLid = cSQLid+ ",Quoted_Dim3="+STR(nQuoted_Dim3,9,3)	&&Quoted_Dim3
							cSQLid = cSQLid+ ",Quoted_LBS="+STR(nQuoted_LBS,9,1)	&&Quoted_LBS
							cSQLid = cSQLid+ ",Quoted_Qty="+STR(nQuoted_Qty,18,4)	&&Quoted_Qty
							
							*From NewStk_, what left to be relisted
							cSQLid = cSQLid+ ",StockLst_Qty="+STR(nNewStk_QTY,18,4)	&&StockLst_Qty
							cSQLid = cSQLid+ ",StockLst_P="+STR(nStockLst_P,18,4)		&&StockLst_P
							cSQLid = cSQLid+ ",StockLst_Total="+STR(nStockLst_Total,18,4)	&&StockLst_Total
							cSQLid = cSQLid+ ",StockLst_PU="+STR(nStockLst_PU)			&&StockLst_PU
							
							
							cSQLid = cSQLid+ ",StockLst_PC="  +STR(nNewStk_PC,10)		&&StockLst_PC
							cSQLid = cSQLid+ ",StockLst_Dim1="+STR(nNewStk_Dim1,10,4)	&&StockLst_Dim1
							cSQLid = cSQLid+ ",StockLst_Dim2="+STR(nNewStk_Dim2,9,3)	&&StockLst_Dim2
							cSQLid = cSQLid+ ",StockLst_Dim3="+STR(nNewStk_Dim3,9,3)	&&StockLst_Dim3
						    cSQLid = cSQLid+ ",StockLst_LBS="+STR(nNewStk_LBS,9,1)	&&StockLst_LBS
		
							cSQLid = cSQLid+ ",Removed_PC="  +STR(nRemoved_PC,10,0)	
							cSQLid = cSQLid+ ",Removed_Dim1="+STR(nRemoved_Dim1,10,4)
							cSQLid = cSQLid+ ",Removed_Dim2="+STR(nRemoved_Dim2,9,3)	
							cSQLid = cSQLid+ ",Removed_Dim3="+STR(nRemoved_Dim3,9,3)	
							cSQLid = cSQLid+ ",Removed_Qty="+STR(nRemoved_Qty,18,4)	
							cSQLid = cSQLid+ ",Removed_LBS="+STR(nRemoved_LBS,9,1)	
							cSQLid = cSQLid+ ",Removed_P="  +STR(nStockLst_P,18,4)	
							cSQLid = cSQLid+ ",Removed_Paid_Total="+STR(nRemoved_Paid_Total,18,4)
				    		cSQLid = cSQLid+ ",Removed_Total="+STR(nRemoved_Total,18,4)
				    
		
							cSQLid = cSQLid+ ",Alloy='"+cAlloy+"'"
							cSQLid = cSQLid+ ",Form='"+cForm+"'"
							cSQLid = cSQLid+ ",Heat='"+cHeat+"'"
							cSQLid = cSQLid+ ",Lot='"+cLot+"'"
						    cSQLid = cSQLid+ ",CC='"+cCC+"'"
						    cSQLid = cSQLid+ ",CL='"+cCL+"'"
		
							cSQLid = cSQLid+ ",TBL='"+IIF(cTBL="S","S",IIF(cTBL="B","B","W"))+"'"
							cSQLid = cSQLid+ ",StockLst_ID="+STR(nID)
							cSQLid = cSQLid+ ",StockLst_ID_Detail="+STR(nID_Detail)
							cSQLid = cSQLid+ ",ID_Detail_Process="+STR(nID_Detail_Process)
							cSQLid = cSQLid+ ",ID_Sales_Stock="+STR(nSales_Stock_ID)
						    *cSQLid = cSQLid+ ",StockEdit=GetDate()"
						    cSQLid = cSQLid + ",StockEdit='"+TTOC(dtGetDate)+"'"
						    
							cSQLid = cSQLid+ ",StkPaid_P="+STR(nStkPaid_P,18,4)
							cSQLid = cSQLid+ ",StkPaid_Total="+STR(nStkPaid_Total,18,4)
							cSQLid = cSQLid+ ",UserEdit='"+cUserEdit+"'"
							cSQLid = cSQLid+ " WHERE ID="+STR(nSales_Detail_ID )
							*? From NewStk_, screen data left to be relisted ?
							
						ELSE
							*insert
							PRIVATE cSQLid
							cSQLid = "INSERT INTO dbo.Sales_Detail ("
							cSQLid = cSQLid+ " SOitem"   
							cSQLid = cSQLid+ ",SalesNum"
							*cSQLid = cSQLid+ ",Invoice"
							cSQLid = cSQLid+ ",WO"
							
							*From AllQuotes
							cSQLid = cSQLid+ ",Quoted_PC"
							cSQLid = cSQLid+ ",Quoted_Dim1"
							cSQLid = cSQLid+ ",Quoted_Dim2"
							cSQLid = cSQLid+ ",Quoted_Dim3"
							cSQLid = cSQLid+ ",Quoted_LBS"
							cSQLid = cSQLid+ ",Quoted_Qty"
							
							
							cSQLid = cSQLid+ ",StockLst_Qty"
							cSQLid = cSQLid+ ",StockLst_P"
							cSQLid = cSQLid+ ",StockLst_Total"
							cSQLid = cSQLid+ ",StockLst_PU"
							
							*From NewStk_, what left to be relisted
							cSQLid = cSQLid+ ",StockLst_PC"
							cSQLid = cSQLid+ ",StockLst_Dim1"
							cSQLid = cSQLid+ ",StockLst_Dim2"
							cSQLid = cSQLid+ ",StockLst_Dim3"
						    cSQLid = cSQLid+ ",StockLst_LBS"
							
							cSQLid = cSQLid+ ",Removed_PC"
							cSQLid = cSQLid+ ",Removed_Dim1"
							cSQLid = cSQLid+ ",Removed_Dim2"
							cSQLid = cSQLid+ ",Removed_Dim3"
							cSQLid = cSQLid+ ",Removed_Qty"
							cSQLid = cSQLid+ ",Removed_LBS"
							cSQLid = cSQLid+ ",Removed_P"
							cSQLid = cSQLid+ ",Removed_Paid_Total"
				    		cSQLid = cSQLid+ ",Removed_Total"
		
							cSQLid = cSQLid+ ",Alloy"
							cSQLid = cSQLid+ ",Form"
							cSQLid = cSQLid+ ",Heat"
							cSQLid = cSQLid+ ",Lot"
						    cSQLid = cSQLid+ ",CC"
						    cSQLid = cSQLid+ ",CL"
		
							cSQLid = cSQLid+ ",TBL"
							cSQLid = cSQLid+ ",StockLst_ID"
							cSQLid = cSQLid+ ",StockLst_ID_Detail"
							cSQLid = cSQLid+ ",ID_Detail_Process"
							cSQLid = cSQLid+ ",ID_Sales_Stock"
						    cSQLid = cSQLid+ ",StockEdit"
						    
							cSQLid = cSQLid+ ",StkPaid_P"
							cSQLid = cSQLid+ ",StkPaid_Total"
							cSQLid = cSQLid+ ",UserEdit"
		
							cSQLid = cSQLid+ ") VALUES ("
							cSQLid = cSQLid+ "'"+cSOitem+"'"
							cSQLid = cSQLid+ ","+STR(nSalesNum) 
							*cSQLid = cSQLid+ ","+STR(nInvoice)
							cSQLid = cSQLid+ ","+STR(nWO)
							
							*From AllQuotes
							cSQLid = cSQLid+ ","+STR(nQuoted_PC,10,0)	&&Quoted_PC
							cSQLid = cSQLid+ ","+STR(nQuoted_Dim1,10,4)	&&Quoted_Dim1
							cSQLid = cSQLid+ ","+STR(nQuoted_Dim2,9,3)	&&Quoted_Dim2
							cSQLid = cSQLid+ ","+STR(nQuoted_Dim3,9,3)	&&Quoted_Dim3
							cSQLid = cSQLid+ ","+STR(nQuoted_LBS,9,1)	&&Quoted_LBS
							cSQLid = cSQLid+ ","+STR(nQuoted_Qty,18,4)	&&Quoted_Qty
		
							cSQLid = cSQLid+ ","+STR(nNewStk_QTY,18,4)	&&StockLst_Qty
							cSQLid = cSQLid+ ","+STR(nStockLst_P,18,4)		&&StockLst_P
							cSQLid = cSQLid+ ","+STR(nStockLst_Total,18,4)	&&StockLst_Total
							cSQLid = cSQLid+ ","+STR(nStockLst_PU)			&&StockLst_PU
							
							*From NewStk_, whats left to be relisted
							cSQLid = cSQLid+ ","+STR(nNewStk_PC,10)		&&StockLst_PC
							cSQLid = cSQLid+ ","+STR(nNewStk_Dim1,10,4)	&&StockLst_Dim1
							cSQLid = cSQLid+ ","+STR(nNewStk_Dim2,9,3)	&&StockLst_Dim2
							cSQLid = cSQLid+ ","+STR(nNewStk_Dim3,9,3)	&&StockLst_Dim3
						    cSQLid = cSQLid+ ","+STR(nNewStk_LBS,9,1)	&&StockLst_LBS
		
							cSQLid = cSQLid+ ","+STR(nRemoved_PC,10,0)	
							cSQLid = cSQLid+ ","+STR(nRemoved_Dim1,10,4)
							cSQLid = cSQLid+ ","+STR(nRemoved_Dim2,9,3)	
							cSQLid = cSQLid+ ","+STR(nRemoved_Dim3,9,3)	
							cSQLid = cSQLid+ ","+STR(nRemoved_Qty,18,4)	
							cSQLid = cSQLid+ ","+STR(nRemoved_LBS,9,1)	
							cSQLid = cSQLid+ ","+STR(nStockLst_P,18,4)	
							cSQLid = cSQLid+ ","+STR(nRemoved_Paid_Total,18,4)
				    		cSQLid = cSQLid+ ","+STR(nRemoved_Total,18,4)
							
							cSQLid = cSQLid+ ",'"+cAlloy+"'"
							cSQLid = cSQLid+ ",'"+cForm+"'"
							cSQLid = cSQLid+ ",'"+cHeat+"'"
							cSQLid = cSQLid+ ",'"+cLot+"'"
						    cSQLid = cSQLid+ ",'"+cCC+"'"
						    cSQLid = cSQLid+ ",'"+cCL+"'"
						    
							cSQLid = cSQLid+ ",'"+IIF(cTBL="S","S",IIF(cTBL="B","B","W"))+"'"
							cSQLid = cSQLid+ ","+STR(nID)
							cSQLid = cSQLid+ ","+STR(nID_Detail)
							cSQLid = cSQLid+ ","+STR(nID_Detail_Process)
							cSQLid = cSQLid+ ","+STR(nSales_Stock_ID)
						    *cSQLid = cSQLid+ ",GetDate()" &&StockEdit
						    cSQLid = cSQLid + ",'"+TTOC(dtGetDate)+"'"
						    		
							cSQLid = cSQLid+ ","+STR(nStkPaid_P,18,4)
							cSQLid = cSQLid+ ","+STR(nStkPaid_Total,18,4)
							cSQLid = cSQLid+ ",'"+cUserEdit+"'"
							
							cSQLid = cSQLid+ ")"
							
						ENDIF
						IF nOrig_Dim1 = 0 &&run check here to fill cSQLid.
							IF lScrap
								TrackError("Not saved to dbo.Sales_Detail. "+CHR(13)+CHR(10)+cSQLid,"No Orig_Dim1 value --Scrap.",PROGRAM(),LINENO(1))
							ELSE
								TrackError("Not saved to dbo.Sales_Detail. "+CHR(13)+CHR(10)+IIF(lConsumed,"Detail was Consumed!"+CHR(13),"")+CHR(13)+CHR(10)+"No Orig_Dim1 value --"+CHR(13)+CHR(10)+cSQLid,"No Orig_Dim1 value. Screen did not have Dim1!",PROGRAM(),LINENO(1))
							ENDIF
						ELSE
		
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid  )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid  )
								ENDDO
							ENDIF
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								SQLEXECError(cSQLid, ThisForm.nConnHandle,nSQLEXEC)
								RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLid )
								*lOK = .F.
							ENDIF
							
						ENDIF
						
					ENDIF
				ENDIF
				
				*nSales_Detail_ID 
				
				IF ThisForm.nWO > 0 AND nSales_Detail_ID > 0
					PRIVATE lOutSource
					lOutSource = is_WO(ThisForm.nWO,ThisForm.nConnhandle,'OutSource')
					
					IF lOutSource 	
						*Update OutSource
						cSQL = "UPDATE dbo.WO_OutSource "
						cSQL = cSQL + " SET Sales_Detail_ID ="+STR(nSales_Detail_ID)
						cSQL = cSQL + " WHERE "
				      	cSQL = cSQL + " Stock_TBL='"+cTBL+"'"
				      	cSQL = cSQL + " AND Stock_ID="+STR(nID)
				      	cSQL = cSQL + " AND Stock_ID_D="+STR(nID_Detail)
				      	cSQL = cSQL + " AND Stock_ID_D_P="+STR(nID_Detail_Process)
				      	cSQL = cSQL + " AND	Stock_QTY="+STR(nStockLst_QTY)
				      	cSQL = cSQL + " AND	Stock_PU="+STR(nStockLst_PU)
				      	IF nSales_Stock_ID > 0
					      	cSQL = cSQL + " AND	Sales_Stock_ID="+STR(nSales_Stock_ID)
				        ENDIF
				        
				      	*cSQL = cSQL + " AND StockEdit='"+TTO_SQL_C(dtGetDate)+"'"
				      	cSQL = cSQL + " AND Sales_Detail_ID = 0 "
				      	
				      	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL)
							*lOK = .F.
						ENDIF
						
				   ENDIF
				ENDIF  
				
				
			ENDSCAN
			ThisForm.txtRecNo3.Value	= RECNO('tmpStkSum')
			
		ENDIF
		
		*********************************
		*Add to Router
		*********************************
		
		*nSales_Stock_ID
		
							
		PRIVATE lOK_SS, cMess
		lOK_SS = .T.
		cMess = ''
		cMess = cTBL  + " ID:"+ALLTRIM(STR(nID))
		cMess = cMess + " ID_D:"+ALLTRIM(STR(nID_Detail))
		cMess = cMess + " ID_D_P:"+ALLTRIM(STR(nID_Detail_Process))
		cMess = cMess + " SS_ID:"+ALLTRIM(STR(nSales_Stock_ID))
		cMess = cMess + " SD_ID:"+ALLTRIM(STR(nSales_Detail_ID))
		
		*LIKE( UPPER("*Modified this Stock*"), UPPER(cOper_Note) ) --do not change text
		* read by Set_rtr_Detail_Oper
		IF ThisForm.nWO > 0			
			lOK_SS = set_rtr_Detail_Oper('WO',ThisForm.nWO,190,522,"WO:"+ALLTRIM(STR(ThisForm.nWO))+" Modified this Stock. "+cMess,.T.,ThisForm.nConnHandle)
		ENDIF
		IF cSOitem <> Proper_SO_item('')
			lOK_SS = set_rtr_Detail_Oper('SOi',cSOitem,190,522,"SOitem:"+cSOitem+" Modified this Stock. "+cMess,.T.,ThisForm.nConnHandle)
		ENDIF
		
		IF NOT lOK_SS
			TrackError(cMess,"Could not set this RTR Operation", PROGRAM(), LINENO(1))
		ENDIF
		
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE savestocklstedit_to_sales_stock
		PARAMETERS cSOitem,nID,nID_Detail,nID_Detail_Process,cTBL,nQTY_NEW,nPC_NEW,nDim1_NEW,nDim2_NEW,nDim3_NEW,lRandLen,cWhat
		*SaveStockLstEdit_to_Sales_Stock()
		*** Save data to dbo.Sales_Stock, can read from dbo.Sales_Detail 
		* also INSERT INTO dbo.Sales_Detail
		
		*also see dbo.StockLst_Process_Grab
		*also see dbo.Sales_Detail in ThisForm.Sales_Detail_ConsumeStock()
		
		IF VARTYPE(nID) != "N"
			TrackError( "Bad Parameter", "nID", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		IF VARTYPE(cWhat) != "C"
			TrackError( "Bad Parameter", "cWhat", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE nID, nID_Detail_Process
		nID					= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3,0)
		PRIVATE nWO, nWO_Detail, cUserEdit
		nWO		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3,0)
		nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3)
		cUserEdit	= PrepareSQLtxt(ThisForm.edtUserEdit.Value,'UserEdit',-1)
		
		PRIVATE cSOitem,cPOitem,cTBL,nID_Detail
		cSOitem	= ThisForm.cSOitem
		cPOitem = ThisForm.cPOitem
		cTBL	= ThisForm.cTBL
		nID_Detail = ThisForm.nID_Detail
		
		nQTY_NEW	= PrepareSQLnum(nQTY_NEW,'QTY',18,4) &&*Use negative QTY to reverse the remove
		nPC_NEW		= PrepareSQLnum(nPC_NEW,'PC',-3)
		nDim1_NEW	= PrepareSQLnum(nDim1_NEW,'Dim1',18,4)
		nDim2_NEW	= PrepareSQLnum(nDim2_NEW,'Dim2',17,3)
		nDim3_NEW	= PrepareSQLnum(nDim3_NEW,'Dim3',17,3)
		
		*****************************
		*Get current Stock Master: Data alloy,Form,Heat,Lot,CC,CL
		PRIVATE lOK
		lOK = .T.
		
		IF USED('tmpAlloyFormCC')
			USE IN tmpAlloyFormCC
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT M.Alloy,M.Form,M.Heat,M.Lot,M.CC,M.CL,M.Paid "
		IF UPPER(cTbl) = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Master M  WITH(NOLOCK)"
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON D.ID = m.ID "
		ELSE
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK)"
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON D.ID = m.ID "
		ENDIF
		cSQL = cSQL + " WHERE D.ID_Detail = "+ALLTRIM(STR(nID_Detail))
			
		PRIVATE cAlloy, cForm, cHeat, cLot, cCC, cCL, lRandLen
		cAlloy	= ''
		cForm	= ''
		cHeat	= ''
		cLot	= ''
		cCC		= ''
		cCL		= ''
		lRandLen = .F.
		
		PRIVATE nStkPaid_P, nStkPaid_Total, nMasterPaid
		nStkPaid_P = 0
		nStkPaid_Total = 0
		nMasterPaid = 0
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyFormCC")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyFormCC")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpAlloyFormCC')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpAlloyFormCC')
				IF RECCOUNT("tmpAlloyFormCC") > 0
					cAlloy	= tmpAlloyFormCC.Alloy
					cForm	= PrepareSQLtxt(tmpAlloyFormCC.Form,'form',2)
					cHeat	= PrepareSQLtxt(tmpAlloyFormCC.Heat,'Heat',50)
					cLot	= PrepareSQLtxt(tmpAlloyFormCC.Lot,'Lot',10)
					cCC		= tmpAlloyFormCC.CC
					cCL		= tmpAlloyFormCC.CL
					nStkPaid_P 	= PrepareSQLnum(tmpAlloyFormCC.Paid,'Paid',-5)
					IF cLot =  '0         '
						cLot = ''
					ENDIF
				ENDIF
				USE IN tmpAlloyFormCC
			ENDIF
		ENDIF
		
		*****************************************************
		PRIVATE nStockLst_Qty,nStockLst_P,nStockLst_Total,nStockLst_PU
		nStockLst_Qty	= PrepareSQLnum( ThisForm.txtQTY.Value,'StockLst_Qty',18,4)
		IF nStockLst_Qty = 0
			nStockLst_Qty	= PrepareSQLnum( ThisForm.txtS_QTY.Value,'StockLst_Qty',18,4)
		ENDIF
		
		nStockLst_P		= PrepareSQLnum( ThisForm.txtS_P.Value,'StockLst_P',18,4) &&current Price per unit
		nStockLst_Total	= nStockLst_Qty * nStockLst_P
		
		nStockLst_PU	= PrepareSQLnum(ThisForm.txtS_PU.Value,'S_PU',-1)
		IF nStockLst_PU = 0
			IF NOT EMPTY(cForm)
				nStockLst_PU	= getPUfromForm( cForm, ThisForm.nConnHandle )
			ENDIF
		ENDIF
		
		****************************
		PRIVATE nSigDim  &&0 Pc, 1 QTY, 2 Dim2, 3 Dim3, 4-,5-, 6 dim2*3
		nSigDim = getSigDim(cForm,ThisForm.nConnHandle)
		PRIVATE nStockLst_LBS
		nStockLst_LBS = 0
		
		PRIVATE nStkBack
		nStkBack = 0
		
		*****************************************************
		*PRIVATE nStk_PC,nStk_Dim1,nStk_Dim2,nStk_Dim3,nStk_QTY,nStk_LBS
		*nStk_PC		= PrepareSQLnum( ThisForm.txtPC.Value,'Pc',-3)
		*nStk_Dim1	= PrepareSQLnum( ThisForm.txtDim1.Value,'Dim1',18,4)
		*nStk_Dim2	= PrepareSQLnum( ThisForm.txtDim2.Value,'Dim2',17,3)
		*nStk_Dim3	= PrepareSQLnum( ThisForm.txtDim3.Value,'Dim3',17,3)
		*nStk_QTY	= 0
		*nStk_LBS	= 0
		
		*****************************************************
		*get Alloy,Form,CC,CL,Thck,Sz2,Sz3 FROM dbo.AllQuotes
		*
		*WAIT WINDOW cSOitem NOWAIT
		IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
			*Check Alloy in selected Stock to Quote SOitem
			PRIVATE cQAlloy, cQForm, cQCC, cQCL, nQDim1
			cQAlloy	= ''
			cQForm	= ''
			cQCC	= ''
			cQCL	= ''
			nQDim1	= 0
		
			cSQL = "SELECT Alloy,Form,CC,CL,Thck,Sz2,Sz3 "
			cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQAlloyFormCC")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQAlloyFormCC")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpQAlloyFormCC')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpQAlloyFormCC')
					IF RECCOUNT("tmpQAlloyFormCC") > 0
						cQAlloy	= tmpQAlloyFormCC.Alloy
						cQForm	= PrepareSQLtxt(tmpQAlloyFormCC.Form,'Form',2)
						cQCC	= tmpQAlloyFormCC.CC
						cQCL	= tmpQAlloyFormCC.CL
						nQDim1	= tmpQAlloyFormCC.Thck
						
						&&See save code in SaveStockLstEdit_to_Sales_Stock()
						PRIVATE cMess				
						*reportConsumed_Ordered
						IF cQAlloy != cAlloy
							cMess = "Consumed Stock does not match Sales Order:"+cSOitem+CHR(13)
							cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
							cMess = cMess + " Form Picked:"+cForm+"  Ordered:"+cQForm+CHR(13)
							cMess = cMess + " Condition Code Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
							cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
							cMess = cMess + " Not Allowed to SAVE:Alloy"+CHR(13)
							
							cMess = cMess + " TBL="+cTBL+" ID_Detail="+ALLTRIM(STR(nID_Detail))+"."+CHR(13)
							
							TrackMess(LEFT(cMess,254))
							TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
							RecordTest('Record Test Data.', PROGRAM(), LINENO(1), cMess+CHR(13)+cSQL)
							MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE Alloy")
							lOK =.F.
						ENDIF
		
						IF cForm = '40' AND tmpQAlloyFormCC.Form = '80' 
							*Normally Form 80 is from Plate, but can be from bar!!!
							cQForm	= cForm
						ENDIF
						IF cForm = '10' AND tmpQAlloyFormCC.Form = '80' 
							cQForm	= cForm
						ENDIF
						
						IF cQForm != cForm AND lOK =.T.
							cMess = "Consumed Stock does not match Sales Order:"+cSOitem+CHR(13)
							cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
							cMess = cMess + " Form Picked:"+cForm+"  Ordered:"+cQForm+CHR(13)
							cMess = cMess + " Condition Code Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
							cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
							
							cMess = cMess + " TBL="+cTBL+" ID_Detail="+ALLTRIM(STR(nID_Detail))+"."+CHR(13)
							
							IF CheckSOforProduction(cSOitem,ThisForm.nConnHandle)
								*Production is allowed to change product form.
							ELSE
								IF NOT (cQForm = '0' OR cQForm = '21' OR cQForm = '22' OR cQForm = '51' OR cQForm = '52' OR cQForm = '53' OR cQForm = '80' OR  cQForm = '90' OR cQForm = '95' OR cQForm = '96' OR cQForm = '97' OR cQForm = '98' OR cQForm = '99' )	
									cMess = cMess + " Allowed to SAVE:Form"+CHR(13)
									TrackMess(LEFT(cMess,254))
									TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
									RecordTest('Record Test Data.',PROGRAM(),LINENO(1),"Consumed Stock does not match Sales Order "+CHR(13)+cMess+CHR(13)+cSQL)
									MESSAGEBOX(cMess,16,"Allowed to SAVE:Form")
									lOK =.T.
								ELSE
									cMess = cMess + " Allowed to SAVE:Form"+CHR(13)
									TrackMess(LEFT(cMess,254))
									*TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
									*MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE!")
									*lOK =.F.				
									TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
									RecordTest('Record Test Data.',PROGRAM(),LINENO(1),"Consumed Stock does not match Sales Order "+CHR(13)+cMess+CHR(13)+cSQL)
									MESSAGEBOX(cMess,16,"Allowed to SAVE!")
									lOK =.T.	
		
								ENDIF				
							ENDIF
						ENDIF
					ENDIF
					
					USE IN tmpQAlloyFormCC
					
					IF NOT lOK
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************************************
		*PRIVATE nStkPaid_P
		IF nStkPaid_P = 0
			nStkPaid_P = getInvoiceValue_ID_Detail( nID_Detail,cTBL,ThisForm.nConnHandle )
		ENDIF
		
		
		*******************
		*Check tmpStkSum
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpStkSum') < 1
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		
		*******************
		
		*Get FROM dbo.StockLst_Master and _Detail
		*
		PRIVATE nStockLst_P
		nStockLst_P = 0
		PRIVATE nPU_OLD,nPc_Old,nDim1_OLD,nDim2_OLD,nDim3_OLD,nQTY_OLD,nS_P,nStockLst_PU
		nPU_OLD		= 0
		nPc_Old		= 0
		nDim1_OLD	= 0
		nDim2_OLD	= 0
		nDim3_OLD	= 0
		nQTY_OLD	= 0
		nS_P		= 0
		nStockLst_PU= 0
		PRIVATE nPC_DIF, nDim1_DIF, nDim2_DIF, nDim3_DIF, nWeight_DIF
		nPc_DIF 	= 0
		nDim1_DIF	= 0
		nDim2_DIF 	= 0
		nDim3_DIF	= 0
		nWeight_DIF	= 0
		
		*	nStkBack = 0
		
		IF USED("tmpStkOrig")
			USE IN tmpStkOrig
		ENDIF
		SELECT 0
		IF UPPER(cTbl) = "S"
			cSQL = "SELECT PC,Dim1,Dim2,Dim3,Weight,S_QTY,S_P,S_PU,InvoiceValue"
			cSQL = cSQL + " ,StockLst_Master.Paid " 
			cSQL = cSQL + " FROM dbo.StockLst_Detail WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master WITH(NOLOCK) ON StockLst_Detail.ID = StockLst_Master.ID "
			cSQL = cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		ELSE
			cSQL = "SELECT PC,Dim1,Dim2,Dim3,Weight,S_QTY,S_P,S_PU,InvoiceValue"
			cSQL = cSQL + " ,BrokerLst_Master.Paid "
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master WITH(NOLOCK) ON BrokerLst_Detail.ID = BrokerLst_Master.ID "
			cSQL = cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkOrig' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkOrig' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkOrig')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkOrig')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkOrig")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkOrig")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpStkOrig')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpStkOrig')
				IF RECCOUNT("tmpStkOrig") > 0
					
					nStockLst_P			= PrepareSQLnum( tmpStkOrig.S_P,'S_P',-5)
					nPU_OLD 			= getPUfromForm( cForm,ThisForm.nConnHandle )
					nPc_OLD				= PrepareSQLnum( tmpStkOrig.Pc,'Pc',-3)
					nDim1_OLD			= PrepareSQLnum( tmpStkOrig.Dim1,'Dim1',-5)
					nDim2_OLD			= PrepareSQLnum( tmpStkOrig.Dim2,'Dim2',17,3)
					nDim3_OLD			= PrepareSQLnum( tmpStkOrig.Dim3,'Dim3',17,3)
					nQTY_OLD			= PrepareSQLnum( tmpStkOrig.S_QTY,'S_QTY',-5)
					nS_P				= PrepareSQLnum( tmpStkOrig.S_P,'S_P',-5) 	&&Same as nStockLst_P
					nStockLst_PU		= PrepareSQLnum( tmpStkOrig.S_PU,'S_PU',-1)
					nStkPaid_P			= PrepareSQLnum( tmpStkOrig.InvoiceValue,'InvoiceValue',-5)
					nMasterPaid			= PrepareSQLnum( tmpStkOrig.Paid,'Paid',-5)
					
					IF nStkPaid_P = 0
						nStkPaid_P = nMasterPaid
					ENDIF
					
					nPc_DIF			= nPc_OLD   - nPc_NEW
					nQTY_DIFF		= nQTY_OLD  - nQTY_NEW
					
					DO CASE
					*Can Dim1 be changed, ex fasteners can only change Pc
					*nDim1_DIF		= nDim1_OLD - nDim1_NEW
					CASE nSigDim = 0
						*PC/ Item/ bolt
						nDim2_DIF	= 0
						nDim3_DIF	= 0
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= nStkPaid_P * nPc_DIF &&nStkPaid_P, nStkPaid_Total
					CASE nSigDim = 1
						nDim2_DIF	= 0
						nDim3_DIF	= 0
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= nStkPaid_P * nPc_DIF
					CASE nSigDim = 2
						*Bar
						nDim2_DIF	= nDim2_OLD - nDim2_NEW
						nDim3_DIF	= 0
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= nStkPaid_P * nStockLst_LBS
					CASE nSigDim = 3
						*Flat bar/ Pipe
						nDim2_DIF 	= 0
						nDim3_DIF	= nDim3_OLD - nDim3_NEW
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_OLD, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_OLD, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= IIF(nDim3_DIF < .1, 0, nStkPaid_P * nDim3_DIF / 12)
					CASE nSigDim = 6
						*Plate/ Sheet
						nDim2_DIF	= nDim2_OLD - nDim2_NEW
						nDim3_DIF	= nDim3_OLD - nDim3_NEW
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= nStkPaid_P * nStockLst_LBS
					ENDCASE
					
					lOK = .T.
				ENDIF
				USE IN tmpStkOrig
			ENDIF
		ENDIF
		
		PRIVATE nRDS_Paid_Total 
		nRDS_Paid_Total = 0
		
		*******************
		*Check tmpStkSum
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpStkSum') < 1
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		
		**************************************************************************************************************************************
		*  dbo.Sales_Stock
		* dbo.Sales_Stock and dbo.StockLst_Process_Grab work together
		* NOT the Sames as dbo.Sales_Detail 
		* Sales_Detail has a dbo.Sales_Detail_PackingSlip when packed before this remove
		**************************************************************************************************************************************
		
		* checks for Previous dbo.PackingSlip and dbo.Sales_Stock then UPDATE dbo.Sales_Stock 
		* Insert dbo.Sales_Stock 
		PRIVATE cSQLid, nSales_Stock_ID
		PRIVATE nRemoved_PC,nRemoved_Dim1,nRemoved_Dim2,nRemoved_Dim3,nRemoved_Qty,nRemoved_LBS,nRemoved_Paid_Total,nRemoved_Total
		
		PRIVATE cMess, nMess, lUpdateSS
		cMess = ''
		nMess = 0
		lUpdateSS = .F.
		
		IF lOK
			SELECT tmpStkSum
			SCAN
			
				nRemoved_PC		= PrepareSQLnum(tmpStkSum.PCs,'PC',-3)
				nRemoved_Dim1	= PrepareSQLnum(tmpStkSum.Dim1,'Dim1',10,4)
				nRemoved_Dim2	= PrepareSQLnum(tmpStkSum.Dim2,'Dim2',9,4)
				nRemoved_Dim3	= PrepareSQLnum(tmpStkSum.Dim3,'Dim3',9,4)
				nRemoved_Qty	= PrepareSQLnum(tmpStkSum.QTY,'QTY',18,4)
				nRemoved_LBS	= PrepareSQLnum(tmpStkSum.Weight,'Weight',8,1)
				nRemoved_Paid_Total	= nRemoved_Qty * nStkPaid_P
				nRemoved_Total	= nRemoved_Qty * nStockLst_P
				nStockLst_Total = nRemoved_Qty * nStockLst_P
		
				
				**
				IF nRemoved_LBS = 0
					DO CASE
					CASE nStockLst_PU = 1
						nRemoved_LBS	= nRemoved_Qty
					CASE nStockLst_PU = 2
						*Calc /FT weight
					 	*nRemoved_LBS = CalcWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					 	nRemoved_LBS = GetWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					CASE nStockLst_PU = 3
						*Calc /PC Weight
					 	*nSale_LBS = GetWeight(nStk_PC, cAlloy, cForm, nStk_Dim1, nStk_Dim2, nStk_Dim3, ThisForm.nConnHandle)
					 	*No weight chart ready fasteners/fittings
						nRemoved_LBS	= nRemoved_PC
					OTHERWISE
						nRemoved_LBS= 0
					ENDCASE
				ENDIF
				**
				
				*******************
				*a SO can be shipped to the customer.  A WO modifying or Consuming Stock will not ship to a customer
				*Check for PackingSlip that was created before Shop Stock Edit!!
				
				PRIVATE cSQL, nSQLEXEC 
				*WAIT WINDOW cSOitem NOWAIT
				IF cSOitem = Proper_SO_item('')
					IF nWO = 0
						MESSAGEBOX("No WorkOrder or SOitem",16,"Error")
						TrackError("No WorkOrder or SOitem","No WorkOrder or SOitem",PROGRAM(),LINENO(1))
					ENDIF
				ELSE
					IF USED('tmpSales_StockP')
						USE IN tmpSales_StockP
					ENDIF
					SELECT 0
		
					cSQL = "SELECT PackingSli,PS_PC,PS_Form,PS_Dim1,PS_Dim2,PS_Dim3,PS_Lbs,WO,Heat,Lot "
					*depricate StockLst
					*cSQL = cSQL + " ,StockLst_QTY,StockLst_P,StockLst_Total,StockLst_PC"
					*cSQL = cSQL + " ,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3,StockLst_LBS,ID "
					
					cSQL = cSQL + " ,Orig_QTY,Orig_P,Orig_Total,Orig_PC"
					cSQL = cSQL + " ,Orig_Dim1,Orig_Dim2,Orig_Dim3,Orig_LBS,ID "
					*Check that Orig_ is being read from table tmpSalesStockP
					
					cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
					cSQL = cSQL + " AND ISNULL(StockEdit,0) = 0"
					cSQL = cSQL + " AND ISNULL(PackingSli,0)>0 "
					cSQL = cSQL + " AND ISNULL(Removed_Qty,0) = 0"  &&No Removed QTY entered. Needs to be updated
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_StockP")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_StockP")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_StockP')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						lOK =.F.
					ENDIF
		
		
					*SCAN tmpStkSum
					IF USED('tmpSales_StockP')
						IF RECCOUNT('tmpSales_StockP')>0
							*SCAN
							cMess = "Found similar in PackingSlip"+CHR(13)+"Could this have already been Shipped ?"+CHR(13)
							cMess = cMess + ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Dim1,'PS_Dim1',10,4),10,4))
							cMess = cMess + " X "+ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Dim2,'PS_Dim2',9,3),9,3))
							cMess = cMess + " X "+ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Dim3,'PS_Dim3',9,3),9,3))+CHR(13)
							
							cMess = cMess + " "+ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Lbs,'PS_Lbs',9,1),9,1))+"Lbs. "
							cMess = cMess + "  SOitem '"+cSOitem+"'"+CHR(13)
							cMess = cMess + " Heat: "+ALLTRIM( PrepareSQLtxt(tmpSales_StockP.Heat,'Heat',50) )
							IF NOT EMPTY(PrepareSQLtxt(tmpSales_StockP.Lot,'Lot',10))
								cMess = cMess + " Lot: "+ALLTRIM( PrepareSQLtxt(tmpSales_StockP.Lot,'Lot',10) )
							ENDIF
							
							nMess = MESSAGEBOX(cMess,4+32,"Update using this PackingSlip Data?")
							IF nMess = 6
								lUpdateSS = .T.
														
								*Get Master,Detail,Process for ID_Detail
								IF USED('tmpStk_QTY')
									USE IN tmpStk_QTY
								ENDIF
								
								SELECT 0
								
								cSQL = "SELECT S_QTY, S_P ,S_Total "
								cSQL = cSQL + ",PC,Dim1,Dim2,Dim3,[Weight]"
								cSQL = cSQL + ",D.ID, D.ID_Detail, M.Heat, M.Lot"
								cSQL = cSQL + ",ISNULL(P.PO_item,'') AS PO_item "
								cSQL = cSQL + ",ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process "
								cSQL = cSQL + ",D.ReceivingID "
								DO CASE
								CASE cTBL = "S"
									cSQL = cSQL + ",'S' AS TBL, D.WO "
									cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.Stocklst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
								CASE cTBL = "B"
									cSQL = cSQL + ",'B' AS TBL, 0 AS WO "
									cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.Brokerlst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
								CASE cTBL = "W"
									cSQL = cSQL + ",'W' AS TBL, 0 AS WO "
									cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.WIPlst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
								ENDCASE
								cSQL = cSQL + " WHERE D.ID_Detail="+STR(nID_Detail)
								cSQL = cSQL + " AND ( ISNULL(P.Process_ID,'SELECTED')='SELECTED' OR ISNULL(P.Process_ID,'')='PARTSELECT' )"
											
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY' )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY')
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY')
									ENDDO
								ENDIF
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStk_QTY")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStk_QTY")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpStk_QTY')
									RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
									lOK =.F.
								ENDIF
		
								IF USED('tmpStk_QTY')
									IF RECCOUNT('tmpStk_QTY')>0
										*nID_Detail_Process = 0
										
										cSQL = "UPDATE dbo.Sales_Stock SET "
										cSQL = cSQL + " StockLst_LBS="+STR(PrepareSQLnum(tmpStk_QTY.S_QTY,'S_QTY',-5),18,4)
										cSQL = cSQL + ",StockLst_POitem ='"+PrepareSQLtxt(tmpStk_QTY.PO_item,'PO_item',12)+"'"					
		*								cSQL = cSQL + ",Edited,Added,Consumed,StockBack"
										cSQL = cSQL + ",StockEdit=GetDate()"
										cSQL = cSQL + ",TBL='"+tmpStk_QTY.TBL+"'"
										cSQL = cSQL + ",StockLst_ID="+STR(PrepareSQLnum(tmpStk_QTY.ID,'Master_ID',-3))
										cSQL = cSQL + ",StockLst_ID_Detail="+STR(PrepareSQLnum(tmpStk_QTY.ID_Detail,'D_Detail',-3))
										cSQL = cSQL + ",ID_Detail_Process="+STR(PrepareSQLnum(tmpStk_QTY.ID_Detail_Process,'ID_Detail_Process',-3))
										cSQL = cSQL + ",ReceivingID="+STR(PrepareSQLnum(tmpStk_QTY.ReceivingID,'ReceivingID',-3))
										
										cSQL = cSQL + ",Heat='"+PrepareSQLtxt(tmpStk_Qty.Heat,'Heat',50)+"'"
										cSQL = cSQL + ",Lot='"+PrepareSQLtxt(tmpStk_Qty.Lot,'Lot',10)+"'"
										
										
			*							cSQL = cSQL + ",Orig_PC="+STR(PrepareSQLnum(tmpStk_QTY.PC,'PC',10),10)
			*							cSQL = cSQL + ",Orig_Dim1="+STR(PrepareSQLnum(tmpStk_QTY.Dim1,'Dim1',10,4),10,4)
			*							cSQL = cSQL + ",Orig_Dim2="+STR(PrepareSQLnum(tmpStk_QTY.Dim2,'Dim2',9,3),9,3)
			*							cSQL = cSQL + ",Orig_Dim3="+STR(PrepareSQLnum(tmpStk_QTY.Dim3,'Dim3',9,3),9,3)
			*							cSQL = cSQL + ",Orig_LBS="+STR(PrepareSQLnum(tmpStk_QTY.Weight,'Weight',9,1),9,1)
		
			*							cSQL = cSQL + ",Sales_Detail_ID="+STR(nSales_Detail_ID)
								
										cSQL = cSQL + ",Left_PC=0"		&&+STR(PrepareSQLnum(tmpStk_QTY.PC,'PC',10),10)
										cSQL = cSQL + ",Left_Dim1=0"	&&+STR(PrepareSQLnum(tmpStk_QTY.Dim1,'Dim1',10,4),10,4)
										cSQL = cSQL + ",Left_Dim2=0"	&&+STR(PrepareSQLnum(tmpStk_QTY.Dim2,'Dim2',9,3),9,3)
										cSQL = cSQL + ",Left_Dim3=0"	&&+STR(PrepareSQLnum(tmpStk_QTY.Dim3,'Dim3',9,3),9,3)
										cSQL = cSQL + ",Left_LBS=0"		&&+STR(PrepareSQLnum(tmpStk_QTY.Weight,'Weight',9,1),9,1)
										cSQL = cSQL + ",Left_QTY=0"		&&+STR(PrepareSQLnum(tmpStk_QTY.S_QTY,'QTY',-5),18,4)
										
										cSQL = cSQL + ",StkPaid_P="+STR(PrepareSQLnum(tmpStk_QTY.S_P,'S_P',-5),18,4)
										cSQL = cSQL + ",StkPaid_Total="+STR(PrepareSQLnum(tmpStk_QTY.S_Total,'S_Total',-5),18,4)
										
										cSQL = cSQL + ",WO="+STR(PrepareSQLnum(tmpStk_QTY.WO,'WO',-3))
										*cSQL = cSQL + ",UserEdit='"+cUserEdit+"'"
										cSQL = cSQL + " WHERE ID = "+STR(PrepareSQLnum(tmpSales_StockP.ID,'ID',-3))
										
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
										ENDDO
										IF nSQLEXEC < 0 &&Try again!
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL 2' TIMEOUT 1
												nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
											ENDDO
										ENDIF
										IF nSQLEXEC < 0 &&Try again!
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL 2' TIMEOUT 1
												nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
												
												IF nSQLEXEC < 0
													IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
														nSQLEXEC = 0
													ENDIF
												ENDIF
											ENDDO
										ENDIF
										IF nSQLEXEC < 0
											SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, '')
											RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
											lOK =.F.
										ENDIF
		
									ENDIF
									USE IN tmpStk_QTY
								ENDIF
