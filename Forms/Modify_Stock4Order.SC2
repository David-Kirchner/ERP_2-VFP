					cSQLid = cSQLid+ ",StockLst_ID_Detail="+STR(nID_Detail)
					cSQLid = cSQLid+ ",ID_Detail_Process="+STR(nID_Detail_Process)
					
					*nRemoved_PC,nRemoved_Dim1,nRemoved_Dim2,nRemoved_Dim3,nRemoved_Qty,nRemoved_LBS,nRemoved_Paid_Total,nRemoved_Total
					cSQLid = cSQLid+ ",Removed_PC="+STR(nRemoved_PC,10)
					cSQLid = cSQLid+ ",Removed_Dim1="+STR(nRemoved_Dim1,10,4)
					cSQLid = cSQLid+ ",Removed_Dim2="+STR(nRemoved_Dim2,9,3)
					cSQLid = cSQLid+ ",Removed_Dim3="+STR(nRemoved_Dim3,9,3)
				    cSQLid = cSQLid+ ",Removed_QTY="+STR(nRemoved_Qty,18,4)
				    cSQLid = cSQLid+ ",Removed_LBS="+STR(nRemoved_LBS,9,1)
