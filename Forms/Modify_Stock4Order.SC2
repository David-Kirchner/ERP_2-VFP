	PROCEDURE cmbLocation1.GotFocus
		ThisForm.cLocation = PrepareSQLtxt(This.Value,'Location',10)
		
	ENDPROC

	PROCEDURE cmbLocation1.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('StandLocation')
			SELECT StandLocation
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [Location], SUBSTRING(Description,1,20) AS DESCR FROM dbo.StockLst_Location WITH(NOLOCK) "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StandLocation')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'StandLocation')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StandLocation")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StandLocation")
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StandLocation")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StandLocation")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'StandLocation')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		DIMENSION aStandLocation(1,2)
		
		IF USED('StandLocation')
			SELECT Location, IIF(ISNULL(DESCR)," ",DESCR) FROM StandLocation INTO ARRAY aStandLocation
			
			USE IN StandLocation
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aStandLocation)
		This.BoundColumn = 1
		This.ColumnWidths = "80,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aStandLocation,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aStandLocation(I, 1),I,1)
			this.addListitem(aStandLocation(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE cmbLocation1.Valid
		PRIVATE cLocation
		cLocation= PrepareSQLtxt(This.Value,'Location',10)
		
		IF cLocation <> ThisForm.cLocation
			
			PRIVATE cMess
			cMess = "Location changed to "+cLocation 
			
			ThisForm.TrackUserEdit(cMess)
			
		ENDIF
	ENDPROC

	PROCEDURE cmdAbort.Click
		PRIVATE cHow
		cHow = ThisForm.Modify_StockLst_How
		PRIVATE cTbl
		cTbl = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		IF TYPE("cTbl") <> "C"
			cTbl = ""
		ENDIF
		IF EMPTY(cTbl)
			cTbl = "S"
		ENDIF
		
		IF NOT( cHow = "SAVE" OR cHow = "ABORT" OR cHow = "" )
			IF MESSAGEBOX("Aborting now will only get you out of"+CHR(13)+"the last '"+cHow+"' you started."+CHR(13)+;
				"Are you sure you want to Abort?",4+32,"Abort?") = 6
				ThisForm.TrackUserEdit("Abort")
				ThisForm.Modify_StockLst_Detail( "ABORT" )
				ThisForm.Modify_StockLst_How = "ABORT"
			ENDIF
		ELSE
			ThisForm.TrackUserEdit("Abort")
			ThisForm.Modify_StockLst_Detail( "ABORT" )
			ThisForm.Modify_StockLst_How = "ABORT"
		ENDIF
		
	ENDPROC

	PROCEDURE cmdAdd.Click
		PRIVATE nID, nID_Detail
		nID = PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		
		IF VARTYPE(ThisForm.txtID.Value) != "N"
			ThisForm.txtID.Value = nID 
		ENDIF
		IF VARTYPE(ThisForm.txtID_Detail.Value) != "N"
			ThisForm.txtID_Detail.Value = nID_Detail 
		ENDIF
		
		IF nID = 0 OR nID_Detail = 0
			MESSAGEBOX("Can not Change!",4,"Lost StockLst ID!")
			RETURN
		ENDIF
		
		PRIVATE cTbl
		cTbl = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		IF TYPE("cTbl") <> "C"
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			RETURN
		ENDIF
		IF EMPTY(cTbl)
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			RETURN
		ENDIF
		
		ThisForm.EnterS_QTY = .F.
		ThisForm.EnterWeight1 = .F.
		
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Enter the 'Stock Removed' details."+CHR(13)+"Click Add to Summary",4,"No Stock Details in Summary!")
			ThisForm.txtPC3.SetFocus
			RETURN
		ELSE
			IF RECCOUNT('tmpStkSum') = 0
				MESSAGEBOX("Enter the 'Stock Removed' Details."+CHR(13)+"Click Add to Summary",4,"No Stock Details in Summary!")
				ThisForm.txtPC3.SetFocus
				RETURN	
			ENDIF
		ENDIF
		
		
		ThisForm.Modify_StockLst_Detail( "ADD" ) &&Changes screen to Add mode
		ThisForm.Modify_StockLst_How = "ADD"
		
		ThisForm.cmdConsumeStock.Enabled = .F.
		
		ThisForm.cmdSave.ENABLED = .T.
		ThisForm.cmdAbort.ENABLED = .T.
			
		ThisForm.txtPC1.SetFocus()
	ENDPROC

	PROCEDURE cmdAddSum.Click
		ThisForm.AddDetailSum()
		
		*ThisForm.EnterWeight3 = .F.
		*ThisForm.EnterQTY3 = .F.
		
	ENDPROC

	PROCEDURE cmdConsumeStock.Click
		*frmModify_StockLst_Detail.cmdConsumeStock.Click
		PRIVATE lOK
		lOK = .T.
		***************
		*Check if ready to Edit
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Enter the 'Stock Removed' details."+CHR(13)+"Click Add to Summary",4,"No Stock Details in Summary!")
			ThisForm.txtPC3.SetFocus
			RETURN .F.
		ELSE
			IF RECCOUNT('tmpStkSum') = 0
				MESSAGEBOX("Enter the 'Stock Removed' Details."+CHR(13)+"Click Add to Summary",4,"No Stock Details in Summary!")
				ThisForm.txtPC3.SetFocus
				RETURN .F.
			ENDIF
		ENDIF
		
		ThisForm.TrackUserEdit("Consume Stock")
			
		PRIVATE lScrap
		lScrap = .F.
		IF ThisForm.ConsumeStock(lScrap)
			lOK = .T.
		ELSE
			lOK = .F.
		ENDIF
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE cmdDelSum.Click
		IF This.Caption = "Abort Edit"
			ThisForm.cmdEditSum.Caption = "Edit"
			ThisForm.cmdAddSum.Enabled = .T.
			This.Caption = "Delete"
			
		ELSE
			*Delete
			IF MESSAGEBOX("Are you Sure you want to Delete this row (Y)",4+32,"Delete?") = 6
				SELECT tmpStkSum
				DELETE IN tmpStkSum		
				
				PACK 
				
				ThisForm.txtPC3.Value	= 0
				ThisForm.txtDim13.Value	= 0
				ThisForm.txtDim23.Value	= 0
				ThisForm.txtDim33.Value	= 0
				ThisForm.txtQTY3.Value	= 0
				ThisForm.txtWeight3.Value	= 0
				
				
				SELECT tmpStkSum
				IF RECCOUNT('tmpStkSum') = 0
					ThisForm.grdSummary.RecordSource='tmpStkSum'
					ThisForm.grdSummary.Refresh
					This.Enabled = .F.
				ELSE
					GO TOP
					ThisForm.grdSummary.RecordSource='tmpStkSum'
					ThisForm.grdSummary.Refresh
					
				ENDIF
				
				ThisForm.txtPC3.Value	= tmpStkSum.PCs
				ThisForm.txtDim13.Value	= tmpStkSum.Dim1
				ThisForm.txtDim23.Value	= tmpStkSum.Dim2
				ThisForm.txtDim33.Value	= tmpStkSum.Dim3
				ThisForm.txtQTY3.Value	= tmpStkSum.QTY
				ThisForm.txtWeight3.Value	= tmpStkSum.Weight
				ThisForm.txtRecNo3.Value	= RECNO('tmpStkSum')
			ENDIF	
		ENDIF
		
		ThisForm.EnterWeight3 = .F.
		ThisForm.EnterQTY3 = .F.
	ENDPROC

	PROCEDURE cmdDone.Click
		PRIVATE m.ID_Detail_Process, cSOitem, nID_Detail
		m.ID_Detail_Process = ThisForm.txtID_Detail_Process.Value
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		*WAIT WINDOW cSOitem NOWAIT
		cSOitem	= Proper_SO_Item(cSOItem)
		nID_Detail = THISFORM.txtID_Detail.VALUE
		
		PRIVATE cTBL 
		cTBL = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		IF VARTYPE(cTBL) <> "C"
			MESSAGEBOX("Can not Change!",4,"Lost 'TBL' !")
			TrackError("No TBL value","TBL",PROGRAM(),LINENO(1))
		ENDIF
		
		ThisForm.Modify_StockLst_How = "DONE"
		
		DO CASE
		CASE cTBL = "S"
			ThisForm.Modify_StockLst_Detail_Report(ThisForm.nID_Detail_Process)
		CASE cTBL = "B"
			ThisForm.Modify_BrokerLst_Detail_Report(ThisForm.nID_Detail_Process)
		CASE cTBL = "W"
			ThisForm.Modify_WIPLst_Detail_Report(ThisForm.nID_Detail_Process)
		ENDCASE
		
		
		ThisForm.Visible = .F.
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdEdit.Click
		PRIVATE nID, nID_Detail
		nID = PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		
		IF VARTYPE(ThisForm.txtID.Value) != "N"
			ThisForm.txtID.Value = nID 
		ENDIF
		IF VARTYPE(ThisForm.txtID_Detail.Value) != "N"
			ThisForm.txtID_Detail.Value = nID_Detail 
		ENDIF
		
		IF nID = 0 OR nID_Detail = 0
			MESSAGEBOX("Can not Change!",4,"Lost StockLst ID!")
			RETURN
		ENDIF
		
		***************
		*Check if ready to Edit
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Enter the 'Stock Removed' details."+CHR(13)+"Click Add to Summary",4,"No Stock Details in Summary!")
			ThisForm.txtPC3.SetFocus
			RETURN
		ELSE
			IF RECCOUNT('tmpStkSum') = 0
				MESSAGEBOX("Enter the 'Stock Removed' Details."+CHR(13)+"Click Add to Summary",4,"No Stock Details in Summary!")
				ThisForm.txtPC3.SetFocus
				RETURN	
			ENDIF
		ENDIF
		
		******************
		PRIVATE cTbl
		cTbl = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		IF TYPE("cTbl") <> "C"
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			RETURN
		ENDIF
		IF EMPTY(cTbl)
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			RETURN
		ENDIF
		
		ThisForm.Modify_StockLst_Detail( "EDIT" )	&&puts screen in EDIT mode.
		ThisForm.Modify_StockLst_How = "EDIT"
		
		ThisForm.Visible = .T.
		
		IF PrepareSQLnum(ThisForm.txtPC3.Value,'PCs',-3) > 0
			*ThisForm.txtPC2.Value = PrepareSQLnum(ThisForm.txtPC3.Value,'PCs',-3)
			ThisForm.txtPC2.Value = 0
		ENDIF
		IF PrepareSQLnum(ThisForm.txtDim23.Value,'Sz2',9,3) > 0
			*ThisForm.txtDim22.Value = PrepareSQLnum(ThisForm.txtDim23.Value,'Sz2',9,3)
			ThisForm.txtDim22.Value = 0
		ENDIF
		IF PrepareSQLnum(ThisForm.txtDim33.Value,'Sz2',9,3) > 0
			*ThisForm.txtDim32.Value = PrepareSQLnum(ThisForm.txtDim33.Value,'Sz3',9,3)
			ThisForm.txtDim32.Value = 0
		ENDIF
		
		***********
		
		
		ThisForm.RefreshForm()
		
		ThisForm.txtPC3.SetFocus
		
	ENDPROC

	PROCEDURE cmdEditSum.Click
		IF This.Caption = "Edit"
			SELECT tmpStkSum
			
			ThisForm.txtPC3.Value	= tmpStkSum.PCs
			ThisForm.txtDim13.Value	= tmpStkSum.Dim1
			ThisForm.txtDim23.Value	= tmpStkSum.Dim2
			ThisForm.txtDim33.Value	= tmpStkSum.Dim3
			ThisForm.txtQTY3.Value	= tmpStkSum.QTY
			ThisForm.txtWeight3.Value	= tmpStkSum.Weight
			ThisForm.txtRecNo3.Value	= RECNO('tmpStkSum')
			
			This.Caption = "Save Edit"
			ThisForm.cmdAddSum.Enabled = .F.
			ThisForm.cmdDelSum.Caption = "Abort Edit"
			
			ThisForm.EnterQTY3 = .F.
			ThisForm.EnterWeight3 = .F.
		ELSE
			*save Edit
			PRIVATE nPCs, nDim1, nDim2, nDim3, nQTY3, nWeight
			nPCs	= PrepareSQLnum(ThisForm.txtPC3.Value,'Pc',-3)
			nDim1	= PrepareSQLnum(ThisForm.txtDim13.Value,'Dim1',8,3)
			nDim2	= PrepareSQLnum(ThisForm.txtDim23.Value,'Dim2',8,3) 
			nDim3	= PrepareSQLnum(ThisForm.txtDim33.Value,'Dim3',8,3)
			nQTY3	= PrepareSQLnum(ThisForm.txtQTY3.Value,'QTY',18,4)
			nWeight = PrepareSQLnum(ThisForm.txtWeight3.Value,'Weight',7,1)
			
			SELECT tmpStkSum
			REPLACE PCs WITH nPCs
			REPLACE Dim1 WITH nDim1
			REPLACE Dim2 WITH nDim2
			REPLACE Dim3 WITH nDim3
			REPLACE QTY  WITH nQTY3
			REPLACE Weight WITH nWeight
				
			ThisForm.grdSummary.Refresh
			*ThisForm.txtRecNo3.Value	= RECNO('tmpStkSum')
			This.Caption = "Edit"
			ThisForm.cmdAddSum.Enabled = .T.
			ThisForm.cmdDelSum.Caption = "Delete"
		ENDIF
		
		ThisForm.EnterWeight3 = .F.
		ThisForm.EnterQTY3 = .F.
	ENDPROC

	PROCEDURE cmdGetSOitemDesc.Click
		*WAIT WINDOW ThisForm.cSOitem NOWAIT
		IF Proper_SO_Item(ThisForm.cSOitem) != Proper_SO_Item('')
			*use SO, not WO
			PRIVATE cSQL, nSQLEXEC 
		
			IF USED("tmpSOitemDesc")
				SELECT tmpSOitemDesc
			ELSE
				SELECT 0
			ENDIF
			cSQL = "SELECT Pieces,Thck,Sz2,Sz3,Q_Qty,cWeight"
			cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = '"+ThisForm.cSOitem+"'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitemDesc' )
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED("tmpSOitemDesc")
					IF RECCOUNT("tmpSOitemDesc") > 0
		
						ThisForm.txtPC3.Value	= tmpSOitemDesc.Pieces
						ThisForm.txtDim13.Value	= tmpSOitemDesc.Thck
						ThisForm.txtDim23.Value	= tmpSOitemDesc.Sz2
						ThisForm.txtDim33.Value	= tmpSOitemDesc.Sz3
						ThisForm.txtQTY3.Value	= tmpSOitemDesc.Q_Qty
						ThisForm.txtWeight3.Value	= tmpSOitemDesc.cWeight
					ENDIF
				ENDIF
			ENDIF
		ELSE
			IF ThisForm.nWO > 0
				*use WO
				PRIVATE cSQL, nSQLEXEC 
		
				IF USED("tmpSOitemDesc")
					SELECT tmpSOitemDesc
				ELSE
					SELECT 0
				ENDIF
				cSQL = "SELECT sPieces,sThck,sSz2,sSz3,sWeight,sWeight"
				cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) "
				cSQL = cSQL + " WHERE WO = "+STR(ThisForm.nWO)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitemDesc' )
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					IF USED("tmpSOitemDesc")
						IF RECCOUNT("tmpSOitemDesc") > 0
		
							ThisForm.txtPC3.Value	= tmpSOitemDesc.sPieces
							ThisForm.txtDim13.Value	= tmpSOitemDesc.sThck
							ThisForm.txtDim23.Value	= tmpSOitemDesc.sSz2
							ThisForm.txtDim33.Value	= tmpSOitemDesc.sSz3
							ThisForm.txtQTY3.Value	= tmpSOitemDesc.sWeight
							ThisForm.txtWeight3.Value	= tmpSOitemDesc.sWeight
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		ThisForm.EnterWeight3 = .F.
		ThisForm.EnterQTY3 = .F.
	ENDPROC

	PROCEDURE cmdReset.Click
		ThisForm.GetByID_Detail_Process("S")
	ENDPROC

	PROCEDURE cmdSave.Valid
		*frmModiStockLst
		PRIVATE lOK
		lOK = .T.
		
		PRIVATE lScrap
		lScrap = .F.
		
		lOK = ThisForm.CheckSave()
		
		IF lOK
			IF NOT ThisForm.DoneWith_StkSum 
				PRIVATE nWO
				nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
				IF nWO > 0
					*Make a WIP listing for Summary items
					lOK = ThisForm.Add_StkSum_WIP(nWO)
				ENDIF
			ENDIF
		ENDIF
		
		
		IF lOK
			ThisForm.TrackUserEdit("Save")
			lOK = ThisForm.SaveStockDetail(lScrap)
			*Calls: ThisForm.Hide_StkSum(.T.)
			*CALLS:ThisForm.SaveStockLstEdit_tmpStkSum(lConsumed, lScrap, lMovetoStock)
			*SETS ThisForm.DoneWith_StkSum = .T.
		ENDIF
		
		IF lOK
			*Make sure tmpStkSum does not run again
		*	lOK = ThisForm.ClearStockDetail(lScrap)
		ENDIF
		
		
		IF lOK
			
			
			*The tmpStkSum table data has been saved.
			*The balance of Stock line has been Saved.
			*Simplify screen data.
		
			Thisform.cmdConsumeStock.Visible = .F.
			ThisForm.cmdEdit.Visible = .F.
		
			Thisform.cmdAdd.Visible = .T.
			ThisForm.cmdScrap.Visible = .T.
			ThisForm.cmdDone.Visible = .T.
		
			ThisForm.chkMarkInvCheck.Value=1
			*ThisForm.chkMarkInvCheck.Visible = 
			ThisForm.chkPrime.Value = 0
			*ThisForm.chkPrime.Visible = .F.
			*ThisForm.chkRandLen.Value
			
			Thisform.shpSalesProcess.Visible = .F.
			ThisForm.lblSOitem.Visible = .F.
			ThisForm.cmdSavetoSales.Visible = .F.
			ThisForm.chkINV.Visible = .F.
			ThisForm.chkGFM.Visible = .F.
			ThisForm.chkMach.Visible = .F.
			ThisForm.chkPlasma.Visible = .F.
			ThisForm.chkRoll.Visible = .F.
			ThisForm.chkCG.Visible = .F.
			ThisForm.chkWJet.Visible = .F.
			ThisForm.chkWJet.Visible = .F.
			ThisForm.chkPress.Visible = .F.
		
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSavetoSales.Click
		PRIVATE cSOitem
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		*WAIT WINDOW cSOitem NOWAIT
		cSOitem	= Proper_SO_Item(cSOItem)
		
		PRIVATE lINV,lGFM,lRoll,lPress,lMach,lCG,lPlasma,lWJet
		lINV	= PrepareSQLchk(ThisForm.chkINV.Value,'INV') &&chkFromStock
		lGFM	= PrepareSQLchk(ThisForm.chkGFM.Value,'GFM')
		lRoll	= PrepareSQLchk(ThisForm.chkRoll.Value,'Roll')
		lPress	= PrepareSQLchk(ThisForm.chkPress.Value,'Press')
		lMach	= PrepareSQLchk(ThisForm.chkMach.Value,'Mach')
		lCG		= PrepareSQLchk(ThisForm.chkCG.Value,'CG')
		lPlasma	= PrepareSQLchk(ThisForm.chkPlasma.Value,'Plasma')
		lWJet	= PrepareSQLchk(ThisForm.chkWJet.Value,'WJet')
		
		PRIVATE cSQL
		cSQL = "UPDATE dbo.Sales SET "
		cSQL = cSQL + " Inv="+IIF(lINV,'1','0')
		cSQL = cSQL + ",GFM="+IIF(lGFM,'1','0')
		cSQL = cSQL + ",Roll="+IIF(lRoll,'1','0')
		cSQL = cSQL + ",Press="+IIF(lPress,'1','0')
		cSQL = cSQL + ",Mach="+IIF(lMach,'1','0')
		cSQL = cSQL + ",CG="+IIF(lCG,'1','0')
		cSQL = cSQL + ",Plasma="+IIF(lPlasma,'1','0')
		cSQL = cSQL + ",WJet="+IIF(lWJet,'1','0')
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			WAIT WINDOW "Saved Process' to Sales table." NOWAIT
		ENDIF			
	ENDPROC

	PROCEDURE cmdScrap.Valid
		***************
		*Check if ready to Edit
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Enter the 'Stock Removed' details.",0,"No Stock Details in Summary!")
			ThisForm.txtPC3.SetFocus
			RETURN
		ELSE
			IF RECCOUNT('tmpStkSum') = 0
				MESSAGEBOX("Enter the 'Stock Removed' Details.",0,"No Stock Details in Summary!")
				ThisForm.txtPC3.SetFocus
				RETURN	
			ENDIF
		ENDIF
		
		PRIVATE lScrap
		lScrap = .T.
		
		ThisForm.TrackUserEdit("Scrap Drops")
		
		IF ThisForm.SaveStockDetail(lScrap)	&&Drops
			RETURN .T.
		ENDIF
		
		RETURN .F.
		
	ENDPROC

	PROCEDURE cmdStock.Click
		PRIVATE nID,nID_Detail, cTbl
		nID 		= ThisForm.txtID.Value
		nID_Detail	= ThisForm.txtID_Detail.Value
		cTbl 		= PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		
		IF cTbl = "S"
			MESSAGEBOX("Can only move WorkInProgress or Brokered items to Stock",0,"This process is not listed as WIP/Brokered")
			RETURN
		ENDIF
		
		PRIVATE nNewID_Master
		nNewID_Master = 0
		IF cTbl = "B"
			ThisForm.TrackUserEdit("Moving from Broker ID:"+ALLTRIM(STR(nID))+" to Stock")
			nNewID_Master = Move_BrokerLst_StockLst( nID, nID_Detail, ThisForm.nConnHandle )
		ENDIF
		IF cTbl = "W"
			ThisForm.TrackUserEdit("Moving from WIP ID:"+ALLTRIM(STR(nID))+" to Stock")
			nNewID_Master = Move_WIPLst_StockLst( nID, nID_Detail, ThisForm.nConnHandle )
		ENDIF

		IF nNewID_Master  > 0
			IF cTbl = "W"
				* P3 — REMNANT / WIP→Stock ledger
				IF NOT "PROC_WO" $ UPPER(SET("PROCEDURE"))
					SET PROCEDURE TO PROGS\proc_wo ADDITIVE
				ENDIF
				PRIVATE nWORem, nWODRem
				nWORem = PrepareSQLnum(ThisForm.nWO,'WO',-3)
				nWODRem = PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3)
				IF nWORem > 0 AND nWODRem > 0
					= WO_Ledger_Add(nWORem, nWODRem, "REMNANT", 0, 0, "", "", ;
						"", 0, 0, "", 0, nID_Detail, "WIP to Stock", ThisForm.nConnHandle)
				ENDIF
			ENDIF
			ThisForm.Modify_StockLst_How = "DONE"
			*- Write Report
			ThisForm.Visible = .F.
		ELSE
			ThisForm.TrackUserEdit("Transfer Failed")
			MESSAGEBOX("Transfer Failed!"+CHR(13)+"Error "+ALLTRIM(STR(SQLreturn.Exp)),0,"Error" )
			TrackError("cTbl = '"+cTBL+"'"+" Move_BrokerLst_StockLst( nID, nID_Detail "+STR(nID)+","+STR(nID_Detail)+".","Transfer Failed!",PROGRAM(),LINENO(1))
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE grdSummary.AfterRowColChange
		LPARAMETERS nColIndex
		IF USED('tmpStkSum')
			IF RECCOUNT('tmpStkSum')>0
				SELECT tmpStkSum
				
				ThisForm.txtPC3.Value	= tmpStkSum.PCs
				ThisForm.txtDim13.Value	= tmpStkSum.Dim1
				ThisForm.txtDim23.Value	= tmpStkSum.Dim2
				ThisForm.txtDim33.Value	= tmpStkSum.Dim3
				ThisForm.txtQTY3.Value	= tmpStkSum.QTY
				ThisForm.txtWeight3.Value	= tmpStkSum.Weight
				ThisForm.txtRecNo3.Value	= RECNO('tmpStkSum')
			ENDIF
		ENDIF
		
	ENDPROC

