	PROCEDURE txtLocation.GotFocus
			*ThisForm.nLocation	= cLocation
	ENDPROC

	PROCEDURE txtPC1.GotFocus
		ThisForm.nPC = PrepareSQLnum(This.Value,'Pieces',-3)
	ENDPROC

	PROCEDURE txtPC1.Valid
		*ThisForm.Calc_StockDetail_1()
		
		PRIVATE nQTY, nWeight, nPieces, cAlloy, cForm, nSize1, nSize2, nSize3
		nPieces	= PrepareSQLnum(This.Value,'Pieces',-3)
		
		IF nPieces <> ThisForm.nPC
			cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
			cForm	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
			nSize1	= PrepareSQLnum(ThisForm.txtDim11.Value,'DIM1',10,4)
			nSize2	= PrepareSQLnum(ThisForm.txtDim21.Value,'DIM2',9,3)
			nSize3	= PrepareSQLnum(ThisForm.txtDim31.Value,'DIM3',9,3)
		
			nQTY = 0
			nWeight = 0
		
			IF nPieces > 0
				IF NOT EMPTY(cForm)
					IF nSize1 > 0
						IF nSize2 > 0
							nQTY = GetUnitQty(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
							*nWeight = CalcWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
							nWeight = GetWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		
			PRIVATE cMess
			cMess = "PC changed to "+ALLTRIM(STR(nPieces))
			
			IF nQTY > 0
				IF NOT ThisForm.EnterS_QTY
					ThisForm.txtS_QTY.Value = nQTY
				ENDIF
			ENDIF
			IF nWeight > 0
				IF NOT ThisForm.EnterWeight1
					ThisForm.txtWeight1.Value = nWeight 
					ThisForm.lblCalcPounds.Caption = ALLTRIM(STR(nWeight))+"#"
				ENDIF
			ENDIF
			
			ThisForm.TrackUserEdit(cMess)
		ENDIF
		
	ENDPROC

	PROCEDURE txtPC2.Valid
		PRIVATE nSub, nCurr, nCalc
		nSub = This.Value
		IF VARTYPE(nSub)="C"
			nSub = VAL(nSUB)
		ENDIF
		
		nCurr = ThisForm.txtPC1.Value
		IF VARTYPE(nCurr)="C"
			nCurr = VAL(nCurr)
		ENDIF
		
		nCalc = 0
		
		*PRIVATE nPC
		*nPC = PrepareSQLnum(ThisForm.txtPC1.Value,'PC',-3)
		*IF nPC = 1
		
		IF (VARTYPE(nSub) = "N" OR VARTYPE(nSub) = "Y") AND ( VARTYPE(nCurr) = "N" OR VARTYPE(nCurr) = "Y")
			nCalc = nCurr - nSub
			This.Value = 0
			
			IF nCalc > 0	
				ThisForm.txtPC1.Value = nCalc
				ThisForm.txtPC1.Refresh
				
				ThisForm.Calc_StockDetail_1()
				WAIT WINDOW "Math: "+ALLTRIM(STR(nCurr))+" - "+ALLTRIM(STR(nSub))+" = "+ALLTRIM(STR(nCalc)) NOWAIT
				
				PRIVATE cMess
				cMess = "PC changed from "+ALLTRIM(STR(nCurr))+" to "+ALLTRIM(STR(nSub))
				ThisForm.TrackUserEdit(cMess)
				IF GetPUfromForm(ThisForm.txtForm1.Value, ThisForm.nConnHandle) = 3		&&PC
					ThisForm.txtS_Qty.Value = ROUND(nCalc,0)
				ENDIF
			ELSE
				WAIT WINDOW "Not updated!" NOWAIT
			ENDIF
		ENDIF
		
		
		
		
		
	ENDPROC

	PROCEDURE txtPC3.Valid
		PRIVATE nPieces
		nPieces	= PrepareSQLnum(This.Value,'Pieces',-3)
		
		SELECT tmpStkSum
		REPLACE PCs WITH nPieces
		
		ThisForm.Calc_StockDetail_3('PC3')
		
	ENDPROC

