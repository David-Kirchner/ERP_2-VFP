			ThisForm.txtPc1.Visible = .T.
			ThisForm.txtDIM11.Visible = .T.
			ThisForm.txtDIM21.Visible = .T.
			ThisForm.txtDIM31.Visible = .T.
			ThisForm.txtLength1.Visible = .T.
