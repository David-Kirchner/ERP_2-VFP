			ThisForm.txtSize_H1.ENABLED = .F.
			ThisForm.txtSize_L1.ENABLED = .F.
			ThisForm.txtDescript1.ENABLED = .F.
		
		*	ThisForm.lblPc1.Visible = .F.
		*	ThisForm.lblSz1.Visible = .F.
		*	ThisForm.lblSz2.Visible = .F.
		*	ThisForm.lblSz3.Visible = .F.
		*	ThisForm.lblSz4.Visible = .F.
		*	ThisForm.lblWeight1.Visible = .F.
		*	ThisForm.lblCalcPounds.Visible = .F.
			
			ThisForm.lblCalcPounds.Visible = .F.
