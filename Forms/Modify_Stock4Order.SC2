		*!*	*				ELSE
		*!*						cComment = 'RemoveGrab '+cComment
		*!*	*				ENDIF		
		*!*					SaveTo_WorkOrder_Notes(nWO, 0, cComment, ThisFormSet.nConnHandle )
		*!*					lOK = set_rtr_Detail_Oper('WO',nWO,105,522,cComment,.T.,ThisFormSet.nConnHandle)
		*!*				ENDIF
		*!*			ENDIF
		
		
		
		*!*			IF ThisFormSet.frmStocklst_SQL.Visible
		*!*				ThisFormSet.Show_Selected_INV("FULL_STK_PRC")
		*!*				ThisFormSet.frmStocklst_SQL.GoToID_Detail(tmpProcess.ID_Detail,tmpProcess.Prc_Dim2,tmpProcess.Prc_Dim3)
		*!*			ENDIF
		
