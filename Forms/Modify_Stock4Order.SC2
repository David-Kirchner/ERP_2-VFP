	ENDPROC

	PROCEDURE txtDim21.Valid
		ThisForm.Calc_StockDetail_1()
		PRIVATE nSub
		nSub = PrepareSQLnum(ThisForm.txtDim21.Value,'DIM21',9,3)
		
		IF nSub <> ThisForm.nDim2
			PRIVATE cMess
			cMess = "DIM2 changed to "+ALLTRIM(STR(nSub,9,3))
		
			ThisForm.TrackUserEdit(cMess)
		ENDIF
	ENDPROC

	PROCEDURE txtDim22.Valid
		PRIVATE nSub, nCurr, nCalc
		nSub = PrepareSQLnum(This.Value,'Sz2',9,3)
		IF VARTYPE(nSub)="C"
			nSub = VAL(nSUB)
		ENDIF
		
		nCurr = PrepareSQLnum(ThisForm.txtDim21.Value,'Sz2',9,3)
		IF VARTYPE(nCurr)="C"
			nCurr = VAL(nCurr)
		ENDIF
		
		nCalc = 0
		
		PRIVATE nPC
		nPC = PrepareSQLnum(ThisForm.txtPC1.Value,'PC',-3)
		IF nPC = 1
			IF (VARTYPE(nSub) = "N" OR VARTYPE(nSub) = "Y") AND ( VARTYPE(nCurr) = "N" OR VARTYPE(nCurr) = "Y")
				This.Value = 0	&&Reset to 0 because it is being subtracted from Dim21
				
				nCalc = nCurr - nSub
				IF nCalc > 0 AND nCalc < 999999999.999
					ThisForm.txtDim21.Value = nCalc
					ThisForm.txtDim21.Refresh
					
					ThisForm.Calc_StockDetail_1()
					WAIT WINDOW "Math: "+ALLTRIM(STR(nCurr,9,3))+" - "+ALLTRIM(STR(nSub,9,3))+" = "+ALLTRIM(STR(nCalc,9,3)) NOWAIT
					
					PRIVATE cMess
					cMess = "DIM2 changed from "+ALLTRIM(STR(nCurr,9,3))+" to "+ALLTRIM(STR(nCalc,9,3))
					
					ThisForm.TrackUserEdit(cMess)
		
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE txtDim23.Valid
		PRIVATE nSize2
		nSize2	= PrepareSQLnum(This.Value,'DIM2',9,3)
		
		SELECT tmpStkSum
		REPLACE Dim2 WITH nSize2
		
		ThisForm.Calc_StockDetail_3('DIM2')
		
	ENDPROC

