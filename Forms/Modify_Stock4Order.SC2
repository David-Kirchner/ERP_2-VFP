					cSQLid = cSQLid+ ",0"	&&Left_Dim3
					cSQLid = cSQLid+ ",0"	&&Left_LBS
					cSQLid = cSQLid+ ",0"	&&Left_Qty
					
					cSQLid = cSQLid+ ","+STR(nWO)
