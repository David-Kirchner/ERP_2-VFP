		***********************************
		**StockLst_Process  .ActivePAge = 3
		ThisForm.pf.pgStockLst_Process.grdStockLst_Process.RecordSource = ''
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT [SOitem],P.[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment],[Process_ID],[Processor],[AllowSub]"
		*cSQL = cSQL + ",[pWeight],[pPc]"
		cSQL = cSQL + ",[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3]"
		cSQL = cSQL + ",[ID_Detail_Process] "
		cSQL = cSQL + " FROM "
		*IF ThisForm.ogTBL.Value=1
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process P"
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process P"
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process P"
		ENDCASE
		cSQL = cSQL + " WHERE P.ID_Detail ="+STR(nID_Detail)
		cSQL = cSQL + " AND 0 < "+STR(nID_Detail)
		cSQL = cSQL + " UNION "
		cSQL = cSQL + " SELECT [SOitem],PH.[PO_item],[SalesPerson],[StartDate],[DueDate],[Comment],[Process_ID],[Processor],[AllowSub]"
		*cSQL = cSQL + " ,[pWeight],[pPc]"
		cSQL = cSQL + ",[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3]"
		cSQL = cSQL + ",[ID_Detail_Process] "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.Ar_StockLst_Process_History PH"
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.Ar_BrokerLst_Process_History PH"
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.Ar_WIPLst_Process_History PH"
		ENDCASE
		cSQL = cSQL + " WHERE PH.ID_Detail ="+STR(nID_Detail)
		cSQL = cSQL + " ORDER BY [SOitem] DESC"
		
		
		
		IF USED("StockLst_Process")
			SELECT StockLst_Process
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Process')
		ELSE
			IF RECCOUNT("StockLst_Process") > 0
				ThisForm.pf.pgStockLst_Process.grdStockLst_Process.RecordSource = 'StockLst_Process'
				*ThisForm.StockLst_Process_Change()
			ENDIF
		ENDIF
		
		ThisForm.pf.pgStockLst_Process.grdStockLst_Process.Refresh
		
		
		***********************************
		**Sales_Detail  .ActivePAge = 4
		ThisForm.pf.pgSales_Detail.grdSales_Detail.RecordSource = ''
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT [ID],[SOitem],[SalesNum],[Invoice],[Sale_QTY],[Sale_PC],[Descript],[Sale_LBS]"
		cSQL = cSQL + " ,[Quoted_QTY],[Quoted_P],[Quoted_Total],[Quoted_PU],[Quoted_PC],[Quoted_Dim1],[Quoted_LBS]"
		cSQL = cSQL + " ,[StockLst_Qty],[StockLst_P],[StockLst_Total],[StockLst_PU],[StockLst_PC],[StockLst_Dim1],[StockLst_LBS]"
		cSQL = cSQL + " ,[Alloy],[Form],[CC],[Heat],[Lot],[TBL],[StockLst_ID],[StockLst_ID_Detail],[ID_Detail_Process]"
		cSQL = cSQL + " ,[StockEdit],[Shipped],[InvoiceDate],[Invoice_QTY],[Invoice_P],[Invoice_Total]"
		cSQL = cSQL + " ,[ProfitMargin],[Disc_Allowed],[ReconDiff],[Freight],[RecDate],[Reconciled]"
		cSQL = cSQL + " ,[PackingSli],[StkPaid_P],[StkPaid_Total]"
