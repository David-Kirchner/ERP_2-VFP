	PROCEDURE dynamic_back_color_what
		*ThisForm.Dynamic_Back_Color_What()
		PRIVATE nColor
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		DO CASE
		CASE StockLst_Master_HISTORY.What = 'BEFOREEDIT'
			nColor = RGB( 255,128,255 ) 
		CASE StockLst_Master_HISTORY.What = 'AFTER EDIT'
			nColor = RGB( 0,255,128 )
		OTHERWISE
			nColor = RGB( 255,255,255 )
		ENDCASE
		RETURN nColor
	ENDPROC

	PROCEDURE dynamic_back_color_who
		*ThisForm.Dynamic_Back_Color_Who()
		PRIVATE nColor, nN
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		nN = RIGHT(StockLst_Master_HISTORY.WHO,11)
		nN = SOUNDEX(nN)
		nN = RIGHT(nN,3)
		nN = VAL(nN)
		*IF nN > 255
			nN = nN/4
		*ENDIF
		nN = ROUND(nN,0)
		
		nR = nN
		*nG = ABS(255- nN/10)
		nG = 200
		nB = ABS(255- nN)
		
		nColor = RGB( nR,nG,nB ) 
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamic_back_color_who_detail
		*ThisForm.Dynamic_Back_Color_Who_Detail()Process_History
		PRIVATE nColor
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		IF ISNULL(StockLst_Detail.WHO)
			nN = "A"
		ELSE
			nN = RIGHT(StockLst_Detail.WHO,11)
		ENDIF
		nN = SOUNDEX(nN)
		nN = RIGHT(nN,3)
		nN = VAL(nN)
		nN = nN/4
		nN = ROUND(nN,0)
		
		nR = nN
		nG = 200
		nB = ABS(255- nN)
		
		nColor = RGB( nR,nG,nB ) 
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamic_back_color_who_process_history
		*ThisForm.Dynamic_Back_Color_Who_Process_History()
		
		PRIVATE nColor
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		nN = RIGHT(Process_History.WHO,11)
		nN = SOUNDEX(nN)
		nN = RIGHT(nN,3)
		nN = VAL(nN)
		nN = nN/4
		nN = ROUND(nN,0)
		
		nR = nN
		nG = 200
		nB = ABS(255- nN)
		
		nColor = RGB( nR,nG,nB ) 
		
		RETURN nColor
	ENDPROC

	PROCEDURE getidfromid_detail
		PARAMETER pID_Detail
		
		PRIVATE nID_Detail
		nID_Detail = 0
		
		
		IF TYPE("pID_Detail") = "C"
			pID_Detail = VAL(pID_Detail)
		ENDIF
		
		IF TYPE("pID_Detail") = "N"
			nID_Detail = pID_Detail
		ELSE
			nID_Detail = 0
		ENDIF
		
		IF nID_Detail = 0
			RETURN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL=        "SELECT ID FROM "
		DO CASE
		CASE ThisForm.cTBL = "S"
		*IF ThisForm.ogTBL.Value=1
			cSQL=cSQL+"dbo.StockLst_Detail"
		CASE ThisForm.cTBL = "B"
			cSQL=cSQL+"dbo.BrokerLst_Detail"
		CASE ThisForm.cTBL = "W"
			cSQL=cSQL+"dbo.WIPLst_Detail"
		ENDCASE
		cSQL=cSQL+" WHERE ID_Detail = "+STR(nID_Detail)
		
		cSQL=cSQL+" UNION "
		cSQL=cSQL+"SELECT ID FROM "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL=cSQL+"dbo.Ar_Stocklst_Detail_History"
		CASE ThisForm.cTBL = "B"
			cSQL=cSQL+"dbo.Ar_BrokerLst_Detail_History"
		CASE ThisForm.cTBL = "W"
			cSQL=cSQL+"dbo.Ar_WIPlst_Detail_History"
		ENDCASE
		cSQL=cSQL+" WHERE ID_Detail = "+STR(nID_Detail)
		
		IF USED("StockLst_ID")
			SELECT StockLst_ID
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_ID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_ID')
		ELSE
			IF RECCOUNT("StockLst_ID") > 0
				SELECT StockLst_ID
				IF StockLst_ID.ID > 0
					ThisForm.txtMaster_ID.Value = StockLst_ID.ID
					ThisForm.txtID.Value = StockLst_ID.ID
				ELSE
					ThisForm.txtMaster_ID.Value = 0
					ThisForm.txtID.Value = 0
				ENDIF
			ELSE
				*NO ID
				ThisForm.txtMaster_ID.Value = 0
				ThisForm.txtID.Value = 0
			ENDIF
		ENDIF
		
		IF USED("StockLst_ID")
			USE IN StockLst_ID
		ENDIF
		
	ENDPROC

	PROCEDURE getid_detailsfromid
		PARAMETER pID
		
		PRIVATE nID
		nID = 0
		
		
		IF TYPE("pID") = "C"
			pID = VAL(pID)
		ENDIF
		
		IF TYPE("pID") = "N"
			nID = pID
		ELSE
			nID = 0
		ENDIF
		
		IF nID = 0
			RETURN
		ENDIF
		
		
		PRIVATE nItemId
		nItemId = ThisForm.lstID_Detail.ListCount
		DO WHILE nItemId > 0
			ThisForm.lstID_Detail.RemoveItem(nItemId)
			nItemId = ThisForm.lstID_Detail.ListCount
		ENDDO
		
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL=        "SELECT ID_Detail, 'C' AS Stk FROM "  &&C urrent or H istory
		DO CASE
		CASE ThisForm.cTBL = "S"
		*IF ThisForm.ogTBL.Value=1
			cSQL=cSQL+" dbo.StockLst_Detail"
		CASE ThisForm.cTBL = "B"
			cSQL=cSQL+" dbo.BrokerLst_Detail"
		CASE ThisForm.cTBL = "W"
			cSQL=cSQL+" dbo.WIPLst_Detail"
		ENDCASE
		cSQL=cSQL+" WHERE ID = "+STR(nID)
		
		cSQL=cSQL+" UNION "
		cSQL=cSQL+"SELECT ID_Detail, 'H' AS Stk FROM "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL=cSQL+" dbo.Ar_Stocklst_Detail_History"
		CASE ThisForm.cTBL = "B"
			cSQL=cSQL+" dbo.Ar_BrokerLst_Detail_History"
		CASE ThisForm.cTBL = "W"
			cSQL=cSQL+" dbo.Ar_WIPlst_Detail_History"
		ENDCASE
		
		cSQL=cSQL+" WHERE ID = "+STR(nID)
		cSQL=cSQL+" ORDER BY ID_Detail "
		
		IF USED("StockLst_ID")
			SELECT StockLst_ID
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_ID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_ID')
		ELSE
			IF RECCOUNT("StockLst_ID") > 0
				SELECT StockLst_ID
				GO TOP
				IF StockLst_ID.ID_Detail > 0
					SCAN  &&C urrent or H istory
					IF StockLst_ID.Stk = "C"
						ThisForm.lstID_Detail.AddListItem(STR(StockLst_ID.ID_Detail)+"+")
					ELSE
						ThisForm.lstID_Detail.AddListItem(STR(StockLst_ID.ID_Detail)+"-")
					ENDIF
					ENDSCAN
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("StockLst_ID")
			USE IN StockLst_ID
		ENDIF
		
		ThisForm.ID_Detail_Changed(ThisForm.lstID_Detail.List(1))
		ThisForm.lstID_Detail.Refresh
	ENDPROC

	PROCEDURE id_detail_changed
		PARAMETER pID_Detail
		
		*ThisForm.ID_Detail_Changed(This.Value)
		IF TYPE("pID_Detail") != "C"
			RETURN
		ENDIF
		
		PRIVATE clst 
		IF RIGHT(pID_Detail,1) = "+"
			*current
			clst = "C"
		ELSE
			clst = "H"
		ENDIF
		
		PRIVATE nID_Detail
		nID_Detail = VAL( pID_Detail )
		
		***********************************
		**StockLst_Detail .ActivePAge = 1
		ThisForm.pf.pgStockLst_Detail.grdStockLst_Detail.RecordSource = ''
		PRIVATE cSQL, nSQLEXEC 
		IF clst = "C"
			cSQL = "SELECT 0 AS ID_Detail_Process"
		*	cSQL = cSQL+", ISNULL(I.[WHO],' ') AS [WHO]"
			cSQL = cSQL+", ISNULL(LEFT( (SELECT TOP 1 ISNULL(I.[WHO],' ') FROM dbo.StockLst_Detail_Inserted I WHERE I.ID_Detail = D.ID_Detail AND I.Master_ID = D.ID ),25),'') AS [WHO]"
			cSQL = cSQL+", 'AAA Current' AS [WHAT],GETDATE() AS [WHEN],0 AS [ProcessValue]"
			cSQL = cSQL+",size_h, size_l,pc,dim1,dim2,dim3 "
			cSQL = cSQL+",length, weight, costvalue, descript, location, floorstatus, [class], RandLen, unit"
			cSQL = cSQL+", D.[id], D.[id_detail], 0 AS ID_Detail_History"
		*	cSQL = cSQL+",0 AS ID_Detail_Process"
			cSQL = cSQL+",S_QTY,S_P,S_Total,S_PU"
			cSQL = cSQL+",ReceivingID"
			cSQL = cSQL+" FROM "
			
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL+"dbo.StockLst_Detail D "
		*		cSQL = cSQL+" LEFT OUTER JOIN dbo.StockLst_Detail_Inserted I ON D.ID_Detail = I.ID_Detail "
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL+"dbo.BrokerLst_Detail D "
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL+"dbo.WIPLst_Detail D "
			ENDCASE
			cSQL = cSQL+" WHERE D.ID_Detail = "+STR(nID_Detail)
			cSQL = cSQL+" AND 0 < "+STR(nID_Detail)
			cSQL = cSQL+" ORDER BY [When] DESC, [What] ASC"
		ELSE
			cSQL = "SELECT ISNULL(ID_Detail_Process,0) AS ID_Detail_Process,LEFT([Who],25) AS [WHO], [What], [When], ProcessValue,"
			cSQL = cSQL+" size_h, size_l, pc, dim1, dim2, dim3"
			cSQL = cSQL+",length, weight, costvalue, descript, location, floorstatus "
			cSQL = cSQL+",[class], RandLen, unit, [id], id_detail, ID_Detail_History "
		*	cSQL = cSQL+",0 AS ID_Detail_Process"
			cSQL = cSQL+",S_QTY,S_P,S_Total,S_PU"
			cSQL = cSQL+",ReceivingID"
			cSQL = cSQL+" FROM "
			*IF ThisForm.ogTBL.Value=1
			DO CASE
			CASE ThisForm.cTBL = "S"
				cSQL = cSQL+" dbo.Ar_Stocklst_Detail_History D "
			CASE ThisForm.cTBL = "B"
				cSQL = cSQL+" dbo.Ar_BrokerLst_Detail_History D "
			CASE ThisForm.cTBL = "W"
				cSQL = cSQL+" dbo.Ar_WIPlst_Detail_History D "
			ENDCASE
			cSQL = cSQL+" WHERE D.ID_Detail = "+STR(nID_Detail)
			cSQL = cSQL+" AND 0 < "+STR(nID_Detail)
			cSQL = cSQL+" ORDER BY ID_Detail_History DESC"
		ENDIF
		
		IF USED("StockLst_Detail")
			SELECT StockLst_Detail
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail')
		ELSE
			IF RECCOUNT("StockLst_Detail") > 0
				ThisForm.pf.pgStockLst_Detail.grdStockLst_Detail.RecordSource = 'StockLst_Detail'
				ThisForm.txtID_Detail.Value = STR(nID_Detail)
				*ThisForm.StockLst_Detail_Change()
			ENDIF
		ENDIF
		ThisForm.pf.pgStockLst_Detail.grdStockLst_Detail.Refresh
		
		***********************************
		** History of Detail_Process  .ActivePAge = 2
		ThisForm.pf.pgDetail_Process.grdDetail_Process.RecordSource = ''
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT "
		cSQL = cSQL + "' ' AS [Who]"
		cSQL = cSQL + ",'AAA Current' AS [What]"
		cSQL = cSQL + ",GetDate() AS [When]"
		cSQL = cSQL + ",SOitem"
		cSQL = cSQL + ",PO_item"
		cSQL = cSQL + ",SalesPerson"
		cSQL = cSQL + ",startdate"
		cSQL = cSQL + ",[duedate]"
		cSQL = cSQL + ",[comment]"
		cSQL = cSQL + ",process_ID"
		cSQL = cSQL + ",processor"
		cSQL = cSQL + ",AllowSub"
		*cSQL = cSQL + ",PWeight"
		*cSQL = cSQL + ",PPc"
		cSQL = cSQL + ",QTY"
		cSQL = cSQL + ",Pounds"
		cSQL = cSQL + ",[id_detail]"
		cSQL = cSQL + ",[id_detail_process]"
		cSQL = cSQL + ",[ReceivingID]"
		cSQL = cSQL + ",[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3]"
		cSQL = cSQL + ",GetDate() AS [Removed]"
		*cSQL = cSQL + ",'F' AS [Validated]"
		*cSQL = cSQL + ",GetDate() AS [Valid_When]"
		cSQL = cSQL + ",0 AS ID_Process_History"
		cSQL = cSQL + ",WO"
		cSQL = cSQL + "	FROM "
		*IF ThisForm.ogTBL.Value=1
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL+"dbo.StockLst_Process"
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL+"dbo.BrokerLst_Process"
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL+"dbo.WIPLst_Process"
		ENDCASE
		cSQL = cSQL + "	WHERE ID_Detail ="+STR(nID_Detail)
		cSQL = cSQL + " AND 0 < "+STR(nID_Detail)
		cSQL = cSQL + "UNION SELECT "
		cSQL = cSQL + "LEFT([who],20) AS [WHO]"
		cSQL = cSQL + ",[what]"
		cSQL = cSQL + ",[when]"
		cSQL = cSQL + ",soitem"
		cSQL = cSQL + ",po_item"
		cSQL = cSQL + ",SalesPerson"
		cSQL = cSQL + ",startdate"
		cSQL = cSQL + ",[duedate]"
		cSQL = cSQL + ",[comment]"
		cSQL = cSQL + ",process_id"
		cSQL = cSQL + ",processor"
		cSQL = cSQL + ",AllowSub"
		*cSQL = cSQL + ",PWeight"
		*cSQL = cSQL + ",PPc"
		cSQL = cSQL + ",QTY"
		cSQL = cSQL + ",Pounds"
		cSQL = cSQL + ",[ID_Detail]"
