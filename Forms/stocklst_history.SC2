		cSQL = cSQL + ",[ReceivingID]"
		cSQL = cSQL + ",[Prc_Form],[Prc_PCs],[Prc_Dim1],[Prc_Dim2],[Prc_Dim3]"
		cSQL = cSQL + ",[removed]"
		*cSQL = cSQL + ",[Validated]"
		*cSQL = cSQL + ",[Valid_When]"
		cSQL = cSQL + ",[ID_Process_History]"
		cSQL = cSQL + ",WO"
		cSQL = cSQL + "	FROM "
		
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " dbo.Ar_StockLst_Process_History "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " dbo.Ar_BrokerLst_Process_History "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " dbo.Ar_WIPLst_Process_History "
		ENDCASE
		cSQL = cSQL + "	WHERE ID_Detail ="+STR(nID_Detail)
		cSQL = cSQL + " AND 0 < "+STR(nID_Detail)
		cSQL = cSQL + " ORDER BY [WHEN] DESC, [What] ASC"
		
		
		IF USED("Process_History")
