	PROCEDURE Unload
		
		IF USED("StockLst_Master_HISTORY")
			USE IN StockLst_Master_HISTORY
		ENDIF
		
		IF USED("StockLst_Detail")
			USE IN StockLst_Detail
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
		RETURN 
	ENDPROC

