	PROCEDURE process_history_change
		*ThisForm.Process_History_Change()
		
		PRIVATE cSOitem, cPOitem
		
		cSOitem = PrepareSQLtxt(Process_History.SOItem,'SOitem',10)
		ThisForm.txtSOitem.Value = cSOitem
		
		cPOitem = PrepareSQLtxt(Process_History.PO_Item,'POitem',13)
		ThisForm.txtPOitem.Value = cPOitem
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDeltaH, nDeltaW
		
		nDeltaH = This.Height - 500
		nDeltaW = This.Width - 750
		*nStockLst_History_Height = 415
		*nStockLst_History_Width = 750
		
		*pf Width = 600
		*pf Height = 300
		
		*grdStockLst Master Height = 270
		*grdStockLst Master Width = 597
		
		
		IF This.Height > 415
		*							212 - 415=200
		*!*		ThisForm.pf.Height = This.Height - 200
		*!*	*	ThisForm.grdStocklst_master.Height = This.Height - 145
		*!*		ThisForm.pf.pgStockLst_Detail.grdStockLst_Detail.Height = This.Height - 145
		*!*		ThisForm.pf.pgDetail_Process.grdDetail_Process.Height = This.Height - 145
		*!*		ThisForm.pf.pgCurProcess_Detail.grdCurProcess_Detail.Height = This.Height - 145
		*!*		ThisForm.pf.pgStockLst_Process.grdStockLst_Process.Height = This.Height - 145
		*	ThisForm.grdStocklst_master.Height = 
			ThisForm.pf.Height = 215 + nDeltaH 
			ThisForm.pf.pgStockLst_Detail.grdStockLst_Detail.Height = 185 + nDeltaH 
			ThisForm.pf.pgDetail_Process.grdDetail_Process.Height = 185 + nDeltaH 
			ThisForm.pf.pgStockLst_Process.grdStockLst_Process.Height = 185 + nDeltaH 
			ThisForm.pf.pgSales_Detail.grdSales_Detail.Height = 185 + nDeltaH 
			ThisForm.pf.pgSales_Invoice.grdSales_Invoice.Height = 185 + nDeltaH 
			ThisForm.pf.pgSales_Stock.grdSales_Stock.Height = 185 + nDeltaH 
			ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.Height = 185 + nDeltaH 
			ThisForm.pf.pgSOitem_Stock.grdSOitem_S_Stock.Height = 185 + nDeltaH 	
			ThisForm.pf.pgSOitem_Detail.grdSOitem_S_Detail.Height = 185 + nDeltaH 	
			ThisForm.shpID_DetailTabs.Height = 226 + nDeltaH 
		ENDIF
		IF This.Width >  750
		*!*		ThisForm.pf.Width = This.Width - 150
		*!*		ThisForm.grdStocklst_master.Width = This.Width - 153
		*!*		ThisForm.pf.pgStockLst_Detail.grdStockLst_Detail.Width = This.Width - 153
		*!*		ThisForm.pf.pgDetail_Process.grdDetail_Process.Width = This.Width - 153
		*!*		ThisForm.pf.pgCurProcess_Detail.grdCurProcess_Detail.Width = This.Width - 153
		*!*		ThisForm.pf.pgStockLst_Process.grdStockLst_Process.Width = This.Width - 153
			
			ThisForm.pf.Width = 612 + nDeltaW
			ThisForm.grdStocklst_master.Width = 616 + nDeltaW
			ThisForm.pf.pgStockLst_Detail.grdStockLst_Detail.Width = 608 + nDeltaW
			ThisForm.pf.pgDetail_Process.grdDetail_Process.Width = 608 + nDeltaW
			ThisForm.pf.pgStockLst_Process.grdStockLst_Process.Width = 608 + nDeltaW
			ThisForm.pf.pgSales_Detail.grdSales_Detail.Width = 608 + nDeltaW
			ThisForm.pf.pgSales_Invoice.grdSales_Invoice.Width = 608 + nDeltaW
			ThisForm.pf.pgSales_Stock.grdSales_Stock.Width = 608 + nDeltaW
			ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.Width = 608 + nDeltaW
			ThisForm.pf.pgSOitem_Stock.grdSOitem_S_Stock.Width = 608 + nDeltaH 	
			ThisForm.pf.pgSOitem_Detail.grdSOitem_S_Detail.Width = 608 + nDeltaH 	
			ThisForm.shpID_DetailTabs.Width = 757 + nDeltaW
		ENDIF
		
	ENDPROC

	PROCEDURE restoreid_detail
		PARAMETER nID_Detail
		*ThisForm.RestoreID_Detail()
		*Must have ID
		
		PRIVATE nID, nID_Master, cTBL
		nID = PrepareSQLnum(ThisForm.txtMaster_ID.Value,'ID',-3)
		cTBL = ThisForm.cTBL
		
		PRIVATE nID_Detail_Process, nID_Detail_History 
		nID_Detail_Process = 0
		nID_Detail_History = 0
		
		PRIVATE lOK
		lOK = .T.
		
		IF USED("StockLst_Detail")
			SELECT StockLst_Detail
			LOCATE FOR ID_Detail = nID_Detail AND ALLTRIM(UPPER(WHAT))='DELETE'
			
			IF NOT FOUND("StockLst_Detail")
				MESSAGEBOX("Sorry, could not locate the 'DELETE' record to restore!",64,"Cannot contine")
				GO TOP
				RETURN .F.
			ENDIF
		
			nID_Master 		   = PrepareSQLnum(StockLst_Detail.ID,'ID',-3)
			nID_Detail_Process = PrepareSQLnum(StockLst_Detail.ID_Detail_Process,'ID_Detail_Process',-4)
			nID_Detail_History = PrepareSQLnum(StockLst_Detail.ID_Detail_History,'ID_Detail_History',-4)
			
			*******************************************
			*Check Stock for ID_Detail that still exists
			PRIVATE nCount
			nCount = Count_Lst_Detail_by_ID_Detail(cTBL, nID_Detail, ThisForm.nConnHandle)
			IF nCount > 0
				MESSAGEBOX("Found the ID_Detail "+STR(nID_Detail)+" already exists in "+TableName_TBL(cTBL)+"." ,16,"Cannot Continue.")
				RETURN .F.		
			ENDIF
		
		ENDIF	
		
		
		*******************************************
		*Check current Stock for ID that still exists
		
		PRIVATE lFoundID
		lFoundID = .F.
		
		IF USED('cntID')
			USE IN cntID
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL +" dbo.StockLst_Master "
		CASE cTBL = "B"
			cSQL = cSQL +" dbo.BrokerLst_Master "
		CASE cTBL = "W"
			cSQL = cSQL +" dbo.WIPLst_Master "
		ENDCASE
		cSQL = cSQL +" WHERE ID ="+STR(nID_Master)+"; "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntID')
			MESSAGEBOX("SQL FAILED!",16,"Cannot Continue.")
			lOK = .F.
			nID = 0 &&use as failure
			lFoundID = .F.
		ENDIF
		
		IF USED('cntID')
			IF RECCOUNT('cntID') > 0
				IF cntID.CNTD > 0
					*the nID is good
					lFoundID = .T.
				ELSE
					nID = 0
				ENDIF
			ELSE
				nID = 0
			ENDIF
			USE IN cntID
		ELSE
			nID = 0
		ENDIF
		
		*****************************
		PRIVATE lRestored_ID 
		lRestored_ID = .F.
		
		IF nID = 0
			IF MESSAGEBOX("No current Master record to attach the Detail to."+CHR(13)+"Cannot restore without Master."+CHR(13)+CHR(13)+"Do you want to restore the Master record? (Y)",4+32,"Did not find.") = 6
				
				IF ThisForm.RestoreID_Master(cTBL,nID_Master)
					lRestored_ID = .T.
					lFoundID = .T.
					nID = nID_Master 
					RecordTest("Restore Detail Stock, Master nID_Master="+STR(nID_Detail)+CHR(13)+cSQL, PROGRAM(), LINENO(1),cSQL)
				ELSE
					*RecordTest("Restore Detail in "+cTBL+" Failed, ID_Detail="+STR(nID_Detail), PROGRAM(), LINENO(1),"Not found."+CHR(13)+cSQL)
					TrackError("Restore Detail in "+cTBL+" Failed, ID_Detail="+STR(nID_Detail)+CHR(13)+CHR(13)+'Did not get to try to restore Detail.'+CHR(13)+cSQL,"SQL Error", PROGRAM(), LINENO(1))
					RETURN .F.		
				ENDIF
				
			ELSE
				*RecordTest("Restore Detail in "+cTBL+" Failed, ID_Detail="+STR(nID_Detail), PROGRAM(), LINENO(1),"Not found."+CHR(13)+cSQL)
				TrackError("Restore Detail in "+cTBL+" Failed, ID_Detail="+STR(nID_Detail)+CHR(13)+CHR(13)+'Did not get to try to restore Detail.'+CHR(13)+cSQL,"SQL Error", PROGRAM(), LINENO(1))
				RETURN .F.
			ENDIF
		ENDIF
		
		*IF lRestored_ID 
		PRIVATE nMess
		nMess = 7
		IF nID_Detail_History > 0
			nMess = MESSAGEBOX("Are you sure you want to place this historic record "+ALLTRIM(STR(nID_Detail_History))+CHR(13)+"for ID_Detail "+ALLTRIM(STR(nID_Detail))+CHR(13)+"back into "+TableName_TBL(cTBL)+"?"+CHR(13)+"This action will be recorded.",4+32,"Continue with RESTORE")
			*
		ENDIF
		
		IF nMess = 6
			*Does Master exists
			IF NOT lFoundID 
			ELSE
					
				*************************************************************
				*Add a message to History
				*Insert back into Table
				cSQL = " INSERT INTO "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +"dbo.Ar_Stocklst_Master_History "
				CASE cTBL = "B"
					cSQL = cSQL +"dbo.Ar_BrokerLst_Master_history "
				CASE cTBL = "W"
					cSQL = cSQL +"dbo.Ar_WIPLst_Master_History "
				ENDCASE
				cSQL = cSQL +" ( [What]"
				cSQL = cSQL +",[Alloy]"
			    cSQL = cSQL +",[Form]"
			    cSQL = cSQL +",[CC]"
				cSQL = cSQL +",[CL]"
			    cSQL = cSQL +",[Size]"
			    cSQL = cSQL +",[Cond]"
			    cSQL = cSQL +",[MWeight]"
			    cSQL = cSQL +",[Heat]"
			    cSQL = cSQL +",[Lot]"
			    cSQL = cSQL +",[Paid]"
			    cSQL = cSQL +",[PO_item]"
			    cSQL = cSQL +",[Mill]"
			    cSQL = cSQL +",[PoDueDate]"
			    cSQL = cSQL +",[Mill]"
			    cSQL = cSQL +",[StkDate]"
		
			    cSQL = cSQL +",[History]"
			    cSQL = cSQL +",[Num]"
			    cSQL = cSQL +",[POStatus]"
			    cSQL = cSQL +",[BrandName]"
			    cSQL = cSQL +",[FROM_ID]"
			    cSQL = cSQL +",[Melt]"
			    cSQL = cSQL +",[ID]"
			    cSQL = cSQL +",[mS_QTY]"
			    cSQL = cSQL +",[WO_Detail]"
			    cSQL = cSQL +",[ProjID]"
			    cSQL = cSQL +" )"
				
				cSQL = cSQL +" SELECT "
				cSQL = cSQL +" 'REVIVED'"	&&***************************************************************
				cSQL = cSQL +",[Alloy]"
			    cSQL = cSQL +",[Form]"
			    cSQL = cSQL +",[CC]"
				cSQL = cSQL +",[CL]"
			    cSQL = cSQL +",[Size]"
			    cSQL = cSQL +",[Cond]"
			    cSQL = cSQL +",[MWeight]"
			    cSQL = cSQL +",[Heat]"
			    cSQL = cSQL +",[Lot]"
			    cSQL = cSQL +",[Paid]"
			    cSQL = cSQL +",[PO_item]"
			    cSQL = cSQL +",[PoDueDate]"
			    cSQL = cSQL +",[Mill]"
			    cSQL = cSQL +",[StkDate]"
		
			    cSQL = cSQL +",[History]"
			    cSQL = cSQL +",[Num]"
			    cSQL = cSQL +",[POStatus]"
			    cSQL = cSQL +",[BrandName]"
			    cSQL = cSQL +",[FROM_ID]"
			    cSQL = cSQL +",[Melt]"
			    cSQL = cSQL +",[ID]"
			    cSQL = cSQL +",[mS_QTY]"
			    cSQL = cSQL +",[WO_Detail]"
			    cSQL = cSQL +",[ProjID]"
				cSQL = cSQL +" FROM "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +"dbo.Ar_Stocklst_Master_History "
				CASE cTBL = "B"
					cSQL = cSQL +"dbo.Ar_BrokerLst_Master_history "
				CASE cTBL = "W"
					cSQL = cSQL +"dbo.Ar_WIPLst_Master_History "
				ENDCASE
				
				cSQL = cSQL +" WHERE ID ="+STR( nID )
				cSQL = cSQL +" AND What = 'DELETE'; "
				
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
					
			ENDIF
			
			******
			IF lOK
				*Insert Detail
				*Only list as Stock to be able to modify
				*Turn ID Insert ON
				
				DO CASE
				CASE cTBL = "S"
					cSQL = "SET IDENTITY_INSERT dbo.StockLst_Detail ON; "
				CASE cTBL = "B"
					cSQL = "SET IDENTITY_INSERT dbo.BrokerLst_Detail ON; "
				CASE cTBL = "W"
					cSQL = "SET IDENTITY_INSERT dbo.WIPLst_Detail ON; "
				ENDCASE
				
				*Insert back into Table
				cSQL = cSQL + " INSERT INTO "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +"dbo.StockLst_Detail"
				CASE cTBL = "B"
					cSQL = cSQL +"dbo.BrokerLst_Detail"
				CASE cTBL = "W"
					cSQL = cSQL +"dbo.WIPLst_Detail"
				ENDCASE
				cSQL = cSQL +" ( [Size_H]"
			    cSQL = cSQL +",[Size_L]"
			    cSQL = cSQL +",[PC]"
				cSQL = cSQL +",[Dim1]"
			    cSQL = cSQL +",[Dim2]"
			    cSQL = cSQL +",[Dim3]"
			    cSQL = cSQL +",[Length]"
			    cSQL = cSQL +",[Weight]"
			    cSQL = cSQL +",[CostValue]"
			    cSQL = cSQL +",[Descript]"
			    cSQL = cSQL +",[Location]"
			    cSQL = cSQL +",[FloorStatus]"
			    cSQL = cSQL +",[Class]"
			    cSQL = cSQL +",[Unit]"
			    cSQL = cSQL +",[RandLen]"
			    cSQL = cSQL +",[InvCheck]"
			    cSQL = cSQL +",[ID]"
			    cSQL = cSQL +",[ID_Detail]"
			    cSQL = cSQL +",[ReceivingID]"
			    cSQL = cSQL +",[InvoiceValue]"
			    cSQL = cSQL +",[LiveCheck]"
			    cSQL = cSQL +",[AccountingCheck]"
			    cSQL = cSQL +",[Quarantine]"
			    cSQL = cSQL +",[S_QTY]"
			    cSQL = cSQL +",[S_P]"
			    cSQL = cSQL +",[S_Total]"
			    cSQL = cSQL +",[S_PU]"
			    cSQL = cSQL +",[Prime]"
			    cSQL = cSQL +",[WO] )"
				
				cSQL = cSQL +" SELECT "
				cSQL = cSQL +" [Size_H]"
			    cSQL = cSQL +",[Size_L]"
			    cSQL = cSQL +",[PC]"
				cSQL = cSQL +",ISNULL([Dim1],0) AS [Dim1]"
			    cSQL = cSQL +",[Dim2]"
			    cSQL = cSQL +",[Dim3]"
			    cSQL = cSQL +",[Length]"
			    cSQL = cSQL +",ISNULL([Weight],0) AS [Weight]"
			    cSQL = cSQL +",[CostValue]"
			    cSQL = cSQL +",[Descript]"
			    cSQL = cSQL +",[Location]"
			    cSQL = cSQL +",[FloorStatus]"
			    cSQL = cSQL +",[Class]"
			    cSQL = cSQL +",[Unit]"
			    cSQL = cSQL +",ISNULL([RandLen],0) AS [RandLen]"
			    cSQL = cSQL +",[InvCheck]"
			    cSQL = cSQL +",[ID]"
			    cSQL = cSQL +",[ID_Detail]"
			    cSQL = cSQL +",[ReceivingID]"
			    cSQL = cSQL +",ISNULL([InvoiceValue],0) AS [InvoiceValue]"
			    cSQL = cSQL +",ISNULL([LiveCheck],0) AS [LiveCheck]"
			    cSQL = cSQL +",ISNULL([AccountingCheck],0) AS [AccountingCheck]"
			    cSQL = cSQL +",ISNULL([Quarantine],0) AS [Quarantine]"
			    cSQL = cSQL +",[S_QTY]"
			    cSQL = cSQL +",[S_P]"
			    cSQL = cSQL +",[S_Total]"
			    cSQL = cSQL +",[S_PU]"
			    cSQL = cSQL +",[Prime]"
			    cSQL = cSQL +",[WO]"
				cSQL = cSQL +" FROM "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +"dbo.Ar_Stocklst_Detail_History"
				CASE cTBL = "B"
					cSQL = cSQL +"dbo.Ar_BrokerLst_Detail_History"
				CASE cTBL = "W"
					cSQL = cSQL +"dbo.Ar_WIPlst_Detail_History"
				ENDCASE
				
				cSQL = cSQL +" WHERE ID_Detail_History ="+STR( nID_Detail_History )+"; "
		
				*Turn ID Insert OFF
				cSQL = cSQL + ""
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + "SET IDENTITY_INSERT dbo.StockLst_Detail OFF; "
				CASE cTBL = "B"
					cSQL = cSQL + "SET IDENTITY_INSERT dbo.BrokerLst_Detail OFF; "
				CASE cTBL = "W"
					cSQL = cSQL + "SET IDENTITY_INSERT dbo.WIPLst_Detail OFF; "
				ENDCASE
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					MESSAGEBOX("" ,16,"Cannot Continue.")
					*RETURN .F.	
					*make sure to turn Identity_Insert OFF
					lOK = .F.
				ENDIF
				
				IF lOK
					*Record back to History
					cSQL = " INSERT INTO "
					DO CASE
					CASE cTBL = "S"
						cSQL = cSQL +"dbo.Ar_Stocklst_Detail_History"
					CASE cTBL = "B"
						cSQL = cSQL +"dbo.Ar_BrokerLst_Detail_History"
					CASE cTBL = "W"
						cSQL = cSQL +"dbo.Ar_WIPlst_Detail_History"
					ENDCASE
					cSQL = cSQL +" ( [WHAT]"
					cSQL = cSQL +",[Size_H]"
				    cSQL = cSQL +",[Size_L]"
				    cSQL = cSQL +",[PC]"
					cSQL = cSQL +",[Dim1]"
				    cSQL = cSQL +",[Dim2]"
				    cSQL = cSQL +",[Dim3]"
				    cSQL = cSQL +",[Length]"
				    cSQL = cSQL +",[Weight]"
				    cSQL = cSQL +",[CostValue]"
				    cSQL = cSQL +",[Descript]"
				    cSQL = cSQL +",[Location]"
				    cSQL = cSQL +",[FloorStatus]"
				    cSQL = cSQL +",[Class]"
				    cSQL = cSQL +",[Unit]"
				    cSQL = cSQL +",[RandLen]"
				    cSQL = cSQL +",[InvCheck]"
				    cSQL = cSQL +",[ID]"
				    cSQL = cSQL +",[ID_Detail]"
				    cSQL = cSQL +",[ReceivingID]"
				    cSQL = cSQL +",[InvoiceValue]"
				    cSQL = cSQL +",[LiveCheck]"
				    cSQL = cSQL +",[AccountingCheck]"
				    cSQL = cSQL +",[Quarantine]"
				    cSQL = cSQL +",[S_QTY]"
				    cSQL = cSQL +",[S_P]"
				    cSQL = cSQL +",[S_Total]"
				    cSQL = cSQL +",[S_PU]"
				    cSQL = cSQL +",[Prime]"
				    cSQL = cSQL +",[WO] )"
					
					cSQL = cSQL +" SELECT "
					cSQL = cSQL +" 'REVIVED'"	&&*************************************
					cSQL = cSQL +",[Size_H]"
				    cSQL = cSQL +",[Size_L]"
				    cSQL = cSQL +",[PC]"
					cSQL = cSQL +",ISNULL([Dim1],0) AS [Dim1]"
				    cSQL = cSQL +",[Dim2]"
				    cSQL = cSQL +",[Dim3]"
				    cSQL = cSQL +",[Length]"
				    cSQL = cSQL +",ISNULL([Weight],0) AS [Weight]"
				    cSQL = cSQL +",[CostValue]"
				    cSQL = cSQL +",[Descript]"
				    cSQL = cSQL +",[Location]"
				    cSQL = cSQL +",[FloorStatus]"
				    cSQL = cSQL +",[Class]"
				    cSQL = cSQL +",[Unit]"
				    cSQL = cSQL +",ISNULL([RandLen],0) AS [RandLen]"
				    cSQL = cSQL +",[InvCheck]"
				    cSQL = cSQL +",[ID]"
				    cSQL = cSQL +",[ID_Detail]"
				    cSQL = cSQL +",[ReceivingID]"
				    cSQL = cSQL +",ISNULL([InvoiceValue],0) AS [InvoiceValue]"
				    cSQL = cSQL +",[LiveCheck]"
				    cSQL = cSQL +",ISNULL([AccountingCheck],0) AS [AccountingCheck]"
				    cSQL = cSQL +",ISNULL([Quarantine],0) AS [Quarantine]"
				    cSQL = cSQL +",[S_QTY]"
				    cSQL = cSQL +",[S_P]"
				    cSQL = cSQL +",[S_Total]"
				    cSQL = cSQL +",[S_PU]"
				    cSQL = cSQL +",[Prime]"
				    cSQL = cSQL +",[WO]"
					cSQL = cSQL +" FROM "
					DO CASE
					CASE cTBL = "S"
						cSQL = cSQL +"dbo.Ar_Stocklst_Detail_History"
					CASE cTBL = "B"
						cSQL = cSQL +"dbo.Ar_BrokerLst_Detail_History"
					CASE cTBL = "W"
						cSQL = cSQL +"dbo.Ar_WIPlst_Detail_History"
					ENDCASE
					
					cSQL = cSQL +" WHERE ID_Detail_History ="+STR( nID_Detail_History )+"; "
						
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
								lOK = .F.
							ENDIF
						ENDDO
					ENDIF			
					
				ENDIF
		
				IF lOK
					PRIVATE  nProcessID, nRID
					nProcessID	 = 0
					nRID	= PrepareSQLnum(ThisForm.txtReceivingID.Value ,'RID',-3)
					
					DO FORM Forms\StockLst_Detail WITH 'EDIT', nID_Detail, nProcessID, 'StockLst', nRID
					
					*--now Refresh Data!
					ThisForm.ShowID( nID )
					
				ENDIF
			ENDIF
		ELSE
		*******
		****************************
		***********************************
			IF lRestored_ID 
				*Undo the Restore Master here
		
				*****************
				cSQL = "UPDATE "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +"dbo.Ar_Stocklst_Master_History"
				CASE cTBL = "B"
					cSQL = cSQL +"dbo.Ar_BrokerLst_Master_history"
				CASE cTBL = "W"
					cSQL = cSQL +"dbo.Ar_WIPLst_Master_History"
				ENDCASE
				cSQL = cSQL +" SET [What] = 'DELETE'"
				cSQL = cSQL +" WHERE ID = "+STR(nID)
				cSQL = cSQL +" AND [WHAT] = 'RECOVERED' ; "		
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					MESSAGEBOX("SQL FAILED!",16,"Cannot Continue.")
					lOK = .F.
				ENDIF
		
				*****************
						
				*Undo the Restore here
				cSQL = "DELETE FROM "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL +"dbo.StockLst_Master "
				CASE cTBL = "B"
					cSQL = cSQL +"dbo.BrokerLst_Master "
				CASE cTBL = "W"
					cSQL = cSQL +"dbo.WIPLst_Master "
				ENDCASE
				cSQL = cSQL +" WHERE ID ="+STR( nID )
				cSQL = cSQL +" AND [History] = 'Recovered'" +"; "
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					MESSAGEBOX("SQL FAILED!",16,"Cannot Continue.")
					lOK = .F.
				ENDIF
				
				*****************
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE restoreid_master
		PARAMETERS cTBL, nID_Master
		*ThisForm.RestoreID_Master(cTBL,nID_Master)
		
		*******************************************
		*Check History for ID_Maste
		
		PRIVATE lFoundID, lOK, nID
		lFoundID = .F.
		lOK = .F.
		nID = 0
		
		IF USED('cntID')
			USE IN cntID
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL +"dbo.Ar_Stocklst_Master_History "
		CASE cTBL = "B"
			cSQL = cSQL +"dbo.Ar_BrokerLst_Master_history "
		CASE cTBL = "W"
			cSQL = cSQL +"dbo.Ar_WIPLst_Master_History "
		ENDCASE
					
		cSQL = cSQL +" WHERE ID ="+STR(nID_Master)
		cSQL = cSQL +" AND [What] = 'DELETE'" +"; "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 2
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 2
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 2
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntID')
			MESSAGEBOX("SQL FAILED!",16,"Cannot Continue.")
			lOK = .F.
			nID = 0 &&use as failure
			lFoundID = .F.
		ENDIF
		
		IF USED('cntID')
			IF RECCOUNT('cntID') > 0
				IF cntID.CNTD > 0
					*the nID is good
					lFoundID = .T.
					nID = nID_Master
				ELSE
					nID = 0
				ENDIF
			ELSE
				nID = 0
			ENDIF
			USE IN cntID
		ELSE
			nID = 0
		ENDIF
		
		
		*****************************
		IF nID = 0
			MESSAGEBOX("Restore Master to "+cTBL+" Failed, ID="+STR(nID_Master),16,"Did not find as [What]=DELETE.")
			TrackError("Restore Master in "+cTBL+" Failed, ID="+STR(nID_Master)+CHR(13)+cSQL,"SQL Error", PROGRAM(), LINENO(1))
			*RecordTest("Restore Master to "+cTBL+" Failed, ID="+STR(nID_Master)+CHR(13)+"No DELETE record found", PROGRAM(), LINENO(1),"Not found."+CHR(13)+cSQL)
			RETURN .F.		
		ENDIF
			
		****************************
		IF USED('tmpReturnID')
			USE IN tmpReturnID 
		ENDIF
		SELECT 0
		
		cSQL = "EXEC dbo.p_Lst_Restore_Master "
		cSQL = cSQL +" @ID="+STR(nID)
		cSQL = cSQL +",@TBL='"+cTBL+"' ;"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReturnID')
		WAIT WINDOW 'a. SQL 2' TIMEOUT 2
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'b. SQL 3' TIMEOUT 3
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReturnID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			WAIT WINDOW 'c. SQL 3' TIMEOUT 3
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReturnID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 2
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReturnID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			WAIT WINDOW 'd. SQL 4' TIMEOUT 4
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReturnID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 4' TIMEOUT 4
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReturnID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		
		**********************************************
		*This has been a trouble area.  Resubmit query
		PRIVATE nTestSQLEXEC
		nTestSQLEXEC = 0
		IF nSQLEXEC < 0
			*run a test Query
			nTestSQLEXEC = SQLEXEC(ThisForm.nConnHandle, "SELECT GETDATE()", 'tmpReturnID')
			DO WHILE nTestSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nTestSQLEXEC = SQLEXEC(ThisForm.nConnHandle, "SELECT GETDATE()", 'tmpReturnID')
			ENDDO
			IF nTestSQLEXEC = 0
				*Record as Error
				SQLEXECError("SELECT GETDATE() --Failed in Stock_History.RestoreID_Master",ThisForm.nConnHandle, nTestSQLEXEC, 'tmpReturnID')
			ENDIF
			IF USED('tmpReturnID')
				USE IN tmpReturnID
			ENDIF
			
			*Resubmit query
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReturnID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 5
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpReturnID')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReturnID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 2
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReturnID")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReturnID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 3' TIMEOUT 2
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpReturnID")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		ENDIF
		**********************************************
		
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpReturnID')
			MESSAGEBOX("SQL FAILED!",16,"Cannot Continue.")
			lOK = .F.
		ENDIF
		
		IF USED('tmpReturnID')
			IF RECCOUNT('tmpReturnID') > 0
				IF PrepareSQLnum(tmpReturnID.EXP,'ID',-3) = -1
					MESSAGEBOX("dbo.p_Lst_Restore_Master SQL did not work."+CHR(13)+"Either the history was not found "+CHR(13)+" or you do not have Permission to INSERT",0+16,"Cannot continue")
					lOK = .F.
					TrackError("dbo.p_Lst_Restore_Master SQL did not work."+CHR(13)+"Either the history was not found "+CHR(13)+" or you do not have Permission to INSERT"+CHR(13)+cSQL,"SQL Failed", PROGRAM(), LINENO(1))
				ENDIF
				IF nID = PrepareSQLnum(tmpReturnID.EXP,'ID',-3)
					lOK = .T.
				ENDIF
			ENDIF
			USE IN tmpReturnID
		ENDIF
		
		RETURN lOK
	ENDPROC

