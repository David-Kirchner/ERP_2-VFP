	PROCEDURE cmdFindHeat.Click
		PRIVATE nReturnID
		nReturnID = 0
		
		PRIVATE cHeat
		IF USED('StockLst_Master_HISTORY')
			cHeat = PrepareSQLtxt( StockLst_Master_HISTORY.Heat,'Heat',50 )
		ELSE
			cHeat = ''
		ENDIF
		
		*DO FORM Forms\StockLst_Heat_Search WITH "" TO nReturnID
		DO FORM Forms\StockLst_Search WITH cHeat,"HEAT" TO nReturnID
		
		IF nReturnID > 0
			ThisForm.txtID.Value = nReturnID
			ThisForm.SearchbyID( ThisForm.txtID.Value )
		ENDIF
		
	ENDPROC

	PROCEDURE cmdFindPOitem.Click
		PRIVATE nReturnMasterID
		nReturnMasterID = 0
		
		PRIVATE cPO_item
		IF USED('StockLst_Master_HISTORY')
			cPO_item= PrepareSQLtxt( StockLst_Master_HISTORY.PO_Item,'PO_Item',12 )
		ELSE
			cPO_item= ""
		ENDIF
		
		DO FORM Forms\Lst_Search WITH cPO_item,"PO_ITEM" TO nReturnMasterID
		
		IF nReturnMasterID > 0
			ThisForm.cTBL = 'S'
			ThisForm.ogTBL.Value = 1
			ThisForm.txtID.Value = nReturnMasterID
			ThisForm.SearchbyID( ThisForm.txtID.Value )
		ENDIF
		IF nReturnMasterID < 0
			ThisForm.cTBL = 'B'
			ThisForm.ogTBL.Value = 2
			ThisForm.txtID.Value = - nReturnMasterID
			ThisForm.SearchbyID( ThisForm.txtID.Value )
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdFindWO.Click
		PRIVATE nReturnMasterID
		nReturnMasterID = 0
		
		PRIVATE cWO
		IF USED('Process_History')
			cWO = PrepareSQLtxt( Process_History.WO,'WO',10 )
		ELSE
			cWO = ""
		ENDIF
		
		DO FORM Forms\StockLst_Search WITH cWO,"WORKORDER" TO nReturnMasterID
		
		IF nReturnMasterID > 0
			ThisForm.txtID.Value = nReturnMasterID
			ThisForm.SearchbyID( ThisForm.txtID.Value )
		ENDIF
		
	ENDPROC

	PROCEDURE cmdPopUpCurrProc.Click
		PRIVATE nProcess_History_ID, nID_Detail
		nProcess_History_ID = PrepareSQLnum(Process_History.ID_Process_History,'ID_Process_History',-3)
		nID_Detail	= PrepareSQLnum(Process_History.ID_Detail,'ID_Detail',-3)
		
		PRIVATE pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO
		pSOItem	= PrepareSQLtxt(Process_History.SOitem,'SOitem',10)
		pSalesP	= ''
		pSalesDate	= ''
		pLBS	= 0
		pQTY	= 0
		pComment	= ''
		pShipDue	= ''
		pLst	= 'S'
		pPoItem	= PrepareSQLtxt(Process_History.po_item,'po_item',12)
		pWO		= 0
		PRIVATE nWO_Detail
		nWO_Detail = 0
		
		IF nProcess_History_ID > 0
			*                                  cWhatDo,            pID_D_P,  pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO, pID_Detail, pInqNumP, pWO_Detail
			DO FORM Forms\Stocklst_Process WITH "SHOW", nProcess_History_ID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO, nID_Detail,       '', nWO_Detail
		ELSE
			MESSAGEBOX('nProcess_History_ID Not Found')
		ENDIF
	ENDPROC

	PROCEDURE cmdPrint.Click
		
		ThisForm.Visible = .f.
		
		SELECT StockLst_Master_HISTORY
		REPORT FORM Reports\STOCKLST_MASTER_HISTORY.FRX TO PRINT PREVIEW
		
		
		DO CASE
		CASE ThisForm.pf.ActivePage = 1
			SELECT StockLst_Detail
			REPORT FORM Reports\SH_StockLst_Detail TO PRINTER PREVIEW
			*REPORT FORM Reports\STOCKLST_MASTER_HISTORY.FRX TO PRINT PREVIEW
		CASE ThisForm.pf.ActivePage = 2
			SELECT Process_History
			REPORT FORM Reports\SH_Process_History TO PRINTER PREVIEW
		CASE ThisForm.pf.ActivePage = 3
			SELECT StockLst_Process
			REPORT FORM Reports\SH_StockLst_Process TO PRINTER PREVIEW
		CASE ThisForm.pf.ActivePage = 4
			SELECT Sales_Detail
			REPORT FORM Reports\SH_Sales_Detail TO PRINTER PREVIEW
		CASE ThisForm.pf.ActivePage = 5
			SELECT Sales_Invoice
			REPORT FORM Reports\SH_Sales_Invoice TO PRINTER PREVIEW
		CASE ThisForm.pf.ActivePage = 6
			SELECT Sales_Stock
			REPORT FORM Reports\SH_Sales_Stock TO PRINTER PREVIEW
		ENDCASE
		ThisForm.Visible = .T.
	ENDPROC

	PROCEDURE cmdQuit.Click
		nInt = ThisForm.ogTBL.Value
		
		
		ThisForm.Release
	ENDPROC

