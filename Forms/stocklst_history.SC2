	PROCEDURE cmdShowPOInvoice.Click
		PRIVATE nHPAPO
		nHPAPO = PrepareSQLnum(StockLst_Master_HISTORY.PO_Item,'HPAPO',-3)
		
		IF nHPAPO > 0
			WAIT WINDOW "ERP PO "+ALLTRIM(STR(nHPAPO)) NOWAIT
			DO FORM forms\Purchase_Invoices WITH nHPAPO
		ELSE
			MESSAGEBOX("No ERP PO found",0,"No data")
		ENDIF
	ENDPROC

	PROCEDURE cmdShowRSpoitem.Click
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt( ThisForm.txtPOitem.Value,'POitem',13)
		
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_POitem(cPOitem,.T.)
		
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		
		ENDIF
	ENDPROC

	PROCEDURE cmdShowRSsoitem.Click
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt( ThisForm.txtSOitem.Value,'SOitem',10)
		
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_SOitem(cSOitem,.T.)
		
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		
		ENDIF
		
		
		*!*	IF NOT EMPTY(cHyperLink)
		*!*		DECLARE INTEGER ShellExecute IN shell32.dll ;
		*!*		   INTEGER hndWin, STRING cAction, STRING cFileName, ;
		*!*		   STRING cParams, STRING cDir, INTEGER nShowWin
		
		*!*		ShellExecute(0,"open",cHyperLink,"","",1)
		
		*!*		*1=SW_SHOWNORMAL 5=SW_SHOW  10=SW_SHOWDEFAULT 
		*!*	ENDIF
	ENDPROC

	PROCEDURE Command1.Click
		PRIVATE nHPAPO, cPoitem
		nHPAPO = PrepareSQLnum(StockLst_Master_HISTORY.PO_Item,'HPAPO',-3)
		cPoitem = PrepareSQLtxt(StockLst_Master_HISTORY.PO_Item,'POitem',12)
		
		IF nHPAPO > 0
			WAIT WINDOW "ERP PO "+ALLTRIM(STR(nHPAPO)) NOWAIT
			DO FORM forms\Receiving  WITH '',0,cPOitem,'',0
		ELSE
			MESSAGEBOX("No ERP PO found",0,"No data")
		ENDIF
	ENDPROC

	PROCEDURE lblRestoreDetail.Click
		PRIVATE nID_Detail
		nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		
		
		IF ThisForm.RestoreID_Detail(nID_Detail)
			WAIT WINDOW 'Refreshing Screen' NOWAIT
			ThisForm.SearchbyID( This.Parent.txtID.Value )
		ELSE
			MESSAGEBOX("You must have:"+CHR(13)+"Stock List or"+CHR(13)+"Shop management Permisions.",64,"Permisions are needed here.")
		ENDIF
		
	ENDPROC

