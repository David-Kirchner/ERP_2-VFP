				*ThisForm.pf.pgSOitem_Detail.txtSOitem_NaN.Value = "SO item not found!"
				ThisForm.pf.pgSOitem_Detail.txtSOitem_NaN.Visible = .T.
			ELSE 
				ThisForm.pf.pgSOitem_Detail.txtSOitem_NaN.Visible = .F.
						
				*.grdStockLst.clmReceivingID.Dynamic_Back_Color(ThisForm.Dynamic_Back_Color())
				
		
			ENDIF
		ELSE 
			ThisForm.pf.pgSOitem_Detail.txtSOitem_NaN.Visible = .T.
		ENDIF
	ENDPROC

	PROCEDURE soitem_s_stock_change
		*ThisForm.SOitem_S_Stock_Change()
