	PROCEDURE workorder_stock_change
		*ThisFormSet.WorkOrder_Stock_Change()
		IF USED("WorkOrder_Stock")
			IF RECCOUNT('WorkOrder_Stock') = 0
				ThisForm.pf.pgWorkOrder.txtWO_NaN.Visible = .T.
			ELSE 
				ThisForm.pf.pgWorkOrder.txtWO_NaN.Visible = .F.
				
				ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.Column1.Text1.ForeColor = RGB(0,0,255)
				ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.Column1.Text1.ToolTipText = "Double click to view"
				*ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.Column1.Text1.DblClick = "Wait Window 'Double Click'"
				
				ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.column1.Refresh
				
				ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.Refresh		
			ENDIF
		ELSE 
			ThisForm.pf.pgWorkOrder.txtWO_NaN.Visible = .T.
		ENDIF
	ENDPROC

	PROCEDURE cmdFindbySOitem.Click
		PRIVATE nReturnMasterID
		nReturnMasterID = 0
		
		PRIVATE cSOitem
		IF USED('Process_History')
			cSOitem = PrepareSQLtxt(Process_History.SOItem,'SOitem',10)
		ELSE
			cSOitem = ''
		ENDIF
		
		DO FORM Forms\StockLst_Search WITH cSOitem,"SOITEM" TO nReturnMasterID
		
		IF nReturnMasterID > 0
			ThisForm.txtID.Value = nReturnMasterID
			ThisForm.SearchbyID( ThisForm.txtID.Value )
		ENDIF
		
	ENDPROC

