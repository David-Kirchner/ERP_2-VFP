	PROCEDURE searchbyid
		PARAMETER pID
		
		PRIVATE nID
		nID = 0
		
		
		IF TYPE("pID") = "C"
			pID = VAL(pID)
		ENDIF
		
		IF TYPE("pID") = "N"
			nID = pID
		ELSE
			nID = 0
		ENDIF
		
		IF nID = 0
			RETURN
		ENDIF
		
		PRIVATE nID_Detail
		nID_Detail = 0
		
		ThisForm.txtMaster_ID.Value = nID
		
		ThisForm.GetID_DetailsfromID( nID )
		ThisForm.ShowID( nID )
		
		ThisForm.txtMaster_ID.Refresh
		ThisForm.cmdPrint.Visible = .T.
		
	ENDPROC

	PROCEDURE searchbyid_detail
		PARAMETER pID_Detail
		
		PRIVATE nID_Detail
		nID_Detail = 0
		
		
		IF TYPE("pID_Detail") = "C"
			pID_Detail = VAL(pID_Detail)
		ENDIF
		
		IF TYPE("pID_Detail") = "N"
			nID_Detail = pID_Detail
		ELSE
			nID_Detail = 0
		ENDIF
		
		IF nID_Detail = 0
			RETURN
		ENDIF
		
		
		ThisForm.GetIDfromID_Detail( nID_Detail )
		
		PRIVATE nID, cTBL
		nID = PrepareSQLnum(ThisForm.txtMaster_ID.Value,'ID',-3)
		cTBL = ThisForm.cTBL
		
		*IF nID = 0
		*	IF cTBL = "S" OR cTBL = "B" OR cTBL = "W"
		*		nID = GetIDfromID_Detail(nID_Detail, cTBL, ThisForm.nConnHandle )
		*	ENDIF
		*ENDIF
		
		IF nID > 0
			ThisForm.GetID_DetailsfromID( nID )
			ThisForm.ShowID( nID )
		ENDIF
		
		ThisForm.cmdPrint.Visible = .T.
	ENDPROC

	PROCEDURE searchbyreceivingid
		PARAMETER pReceivingID
		*ThisForm.SearchByReceivingID
		
		PRIVATE nReceivingID 
		nReceivingID = 0
		
		IF TYPE("pReceivingID") = "C"
			nReceivingID = VAL(pReceivingID)
		ENDIF
		
		IF TYPE("pReceivingID") = "N"
			nReceivingID = pReceivingID
		ELSE
			nReceivingID = 0
		ENDIF
		
		IF nReceivingID = 0
			RETURN
		ENDIF
		
		PRIVATE nID, nID_Detail
		nID = 0
		nID_Detail = 0
		
		*Look for Receiving ID
		****************************************
		*Check Receiving Log first
		PRIVATE lFoundRcv
		lFoundRcv = .F.
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT ID FROM dbo.Receiving "
		cSQL = cSQL +" WHERE ID = "+STR(nReceivingID)
		
		IF USED("tmpRecvID")
			SELECT tmpRecvID
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRecvID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRecvID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRecvID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRecvID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRecvID')
		ELSE
			IF RECCOUNT("tmpRecvID") > 0
				SELECT tmpRecvID
				IF tmpRecvID.ID > 0
					lFoundRcv = .T.
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("tmpRecvID")
			USE IN tmpRecvID
		ENDIF
		
		IF lFoundRcv
			******************************************
			*Get ID_Detail
			
			PRIVATE lFoundDetail
			lFoundDetail = .F.
			
			cSQL = "SELECT DISTINCT ID_Detail,'S' AS TBL FROM "
			cSQL = cSQL +" dbo.Ar_Stocklst_Detail_History "
			cSQL = cSQL +" WHERE ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL +" AND ISNULL(ID_Detail,0)>0 "
			cSQL = cSQL +" UNION "
			cSQL = cSQL +" SELECT DISTINCT ID_Detail,'B' AS TBL FROM "
			cSQL = cSQL +" dbo.Ar_BrokerLst_Detail_History "
			cSQL = cSQL +" WHERE ReceivingID = "+STR(nReceivingID)
			cSQL = cSQL +" AND ISNULL(ID_Detail,0)>0 "
			
			IF USED("tmpRecvID")
				SELECT tmpRecvID
			ELSE
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRecvID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRecvID')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRecvID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRecvID")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRecvID')
			ELSE
				IF RECCOUNT("tmpRecvID") > 0
					SELECT tmpRecvID
					lFoundDetail = .T.
					
					DO CASE
					CASE RECCOUNT("tmpRecvID") = 1
						nID_Detail = tmpRecvID.ID_Detail
						cTBL = tmpRecvID.TBL
					CASE RECCOUNT("tmpRecvID") = 2
						PRIVATE nID_Detail2, cTBL2, nMess
						GOTO 1
						nID_Detail = tmpRecvID.ID_Detail
						cTBL = tmpRecvID.TBL
						GOTO 2
						nID_Detail2 = tmpRecvID.ID_Detail
						cTBL2 = tmpRecvID.TBL
						
						nMess = MESSAGEBOX("Found 2 Instances of Receiving ID "+ALLTRIM(STR(nReceivingID));
							+CHR(13)+"Answer yes if you want to select the first ID_Detail to show";
							+CHR(13)+"1. Table "+cTBL+STR(nID_Detail);
							+CHR(13)+"2. Table "+cTBL2+STR(nID_Detail2);
							,4+32,"Choose First?")
							
						IF nMess != 6
							nID_Detail = nID_Detail2
							cTBL	= cTBL2
						ENDIF
						
					CASE RECCOUNT("tmpRecvID") > 2	
						**Too many, have use try ID_Detail them self
						PRIVATE nID_Detail2, cTBL2, nMess, nID_Detail3, cTBL3, nID_Detail4, cTBL4, nID_Detail5, cTBL5, nID_Detail6, cTBL6, cMess, nCount
						nCount = RECCOUNT("tmpRecvID")
						
						cMess = "Found "+ALLTRIM(STR(nCount))+" Instances of Receiving ID "+ALLTRIM(STR(nReceivingID))+CHR(13)
						cMess = cMess +"Please write down the ID_Detail"+CHR(13)
						cMess = cMess +"and Enter it in the ID_Detail to search."+CHR(13)+CHR(13)
						GOTO 1
						nID_Detail = tmpRecvID.ID_Detail
						cTBL = tmpRecvID.TBL
						cMess = cMess +"1. Table "+cTBL+STR(nID_Detail)+CHR(13)
						GOTO 2
						nID_Detail2 = tmpRecvID.ID_Detail
						cTBL2 = tmpRecvID.TBL
						cMess = cMess +"2. Table "+cTBL2+STR(nID_Detail2)+CHR(13)
						GOTO 3
						nID_Detail3 = tmpRecvID.ID_Detail
						cTBL3 = tmpRecvID.TBL
						cMess = cMess +"3. Table "+cTBL3+STR(nID_Detail3)+CHR(13)
						
						IF nCount > 3
							GOTO 4
							nID_Detail4 = tmpRecvID.ID_Detail
							cTBL4 = tmpRecvID.TBL
							cMess = cMess +"4. Table "+cTBL4+STR(nID_Detail4)+CHR(13)
						ENDIF
						IF nCount > 4
							GOTO 5
							nID_Detail5 = tmpRecvID.ID_Detail
							cTBL5 = tmpRecvID.TBL
							cMess = cMess +"5. Table "+cTBL5+STR(nID_Detail5)+CHR(13)
						ENDIF
						IF nCount > 5
							GOTO 6
							nID_Detail6 = tmpRecvID.ID_Detail
							cTBL6 = tmpRecvID.TBL
							cMess = cMess +"6. Table "+cTBL6+STR(nID_Detail6)+CHR(13)
						ENDIF				
						nMess = MESSAGEBOX(cMess,4+32,"")
						
						lFoundDetail = .F.
					ENDCASE
				ENDIF
			ENDIF
		
			IF USED("tmpRecvID")
				USE IN tmpRecvID
			ENDIF
			******************************************
			IF lFoundDetail 
				ThisForm.GetIDfromID_Detail( nID_Detail )
		
				IF ThisForm.txtMaster_ID.Value > 0
					nID = ThisForm.txtMaster_ID.Value
					ThisForm.GetID_DetailsfromID( nID )
					ThisForm.ShowID( nID )
				ENDIF
		
				ThisForm.cmdPrint.Visible = .T.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE showid
		PARAMETER pID
		*ThisForm.ShowID( nID )
		
		PRIVATE nID
		nID = 0
		
		IF TYPE("pID") = "C"
			pID = VAL(pID)
		ENDIF
		
		IF TYPE("pID") = "N"
			nID = pID
		ELSE
			nID = 0
		ENDIF
		
		IF nID = 0
			RETURN
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		*cSQL= "SELECT 'Current' AS [WHAT],'*' AS [WHO], GETDATE() AS [WHEN],*,0 AS [ID_History] FROM dbo.StockLst_Master "
		*cSQL=cSQL+" WHERE ID = "+STR(nID)+" UNION "
		*cSQL=cSQL+"SELECT * FROM dbo.Ar_Stocklst_Master_History WHERE ID = "+STR(nID)
		*cSQL=cSQL+" ORDER BY [WHEN] DESC"
		
		
		*cSQL = "SELECT [Who],[what],[when],[alloy],[form],[cc],[size],[cond],[mweight],[specs],[heat],[lot],[Paid],[po_item],[poduedate],[mill],[stkdate],[history],[num],[POStatus],[BrandName],[FROM_ID],[id],[ID_History]"
		cSQL = "SELECT * "
		*IF ThisForm.ogTBL.Value=1
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Master_Union "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Master_Union "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Master_Union "
		ENDCASE
		cSQL = cSQL + " WHERE ID = "+STR(nID)+" ORDER BY [MWhen] DESC, [What] "
		
		
		IF USED("StockLst_Master_HISTORY")
			ThisForm.grdStocklst_master.RecordSource = ""
			USE IN StockLst_Master_HISTORY
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_HISTORY')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Master_HISTORY')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master_HISTORY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Master_HISTORY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Master_HISTORY')
		ELSE
			IF RECCOUNT("StockLst_Master_HISTORY") > 0
				ThisForm.grdStocklst_master.RecordSource = "StockLst_Master_HISTORY"
				
				*ThisForm.grdStocklst_master.Column1.DynamicBackColor = ThisForm.Dynamic_Back_Color_Who()
				*ThisForm.grdStocklst_master.Column1.text1.Alignment = 1
				
				ThisForm.txtMaster_ID.Value = nID
				ThisForm.txtID.Value 		= nID
					
				ThisForm.StockLst_Master_Change()
				
			ENDIF
		ENDIF
		
		ThisForm.grdStocklst_master.Refresh
		
		
		
		
	ENDPROC

