				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "WorkOrder_Stock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'WorkOrder_Stock')
		ELSE
			IF RECCOUNT("Sales_Detail") > 0
		
				ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.RecordSource = 'WorkOrder_Stock'
				*ThisForm.Sales_Stock_Change()
			ENDIF
		ENDIF
		
		ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.Refresh
		
		
		
		***********************************
		**StockLst_Process  .ActivePAge = 8
		ThisForm.pf.pgSOitem_Stock.grdSOitem_S_Stock.RecordSource = ''
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED("SOitem_S_Stock")
			SELECT SOitem_S_Stock
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT * " 
		cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) "
		cSQL = cSQL + " WHERE StockLst_ID_Detail ="+STR(nID_Detail)
		cSQL = cSQL + " AND TBL = '"+ThisForm.cTBL+"'"
		cSQL = cSQL + " ORDER BY [ID] DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SOitem_S_Stock')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SOitem_S_Stock')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SOitem_S_Stock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SOitem_S_Stock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SOitem_S_Stock')
		ELSE
			IF RECCOUNT("SOitem_S_Stock") > 0
		
				ThisForm.pf.pgSOitem_Stock.grdSOitem_S_Stock.RecordSource = 'SOitem_S_Stock'
				ThisForm.pf.pgSOitem_Stock.grdSOitem_S_Stock.column2.Text1.ForeColor = RGB(0,0,255)
				ThisForm.pf.pgSOitem_Stock.grdSOitem_S_Stock.column2.Text1.ToolTipText = "Double click to view"
				*ThisForm.pf.pgSOitem_Stock.grdSOitem_S_Stock.column2.Text1.DblClick = "Wait Window 'Double Click'"
		
				*ThisForm.SOitem_S_Stock_Change()
			ENDIF
		ENDIF
		
		ThisForm.pf.pgSOitem_Stock.grdSOitem_S_Stock.Refresh
		
		
		***********************************
		**StockLst_Process  .ActivePAge = 9
		ThisForm.pf.pgSOitem_Detail.grdSOitem_S_Detail.RecordSource = ''
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED("SOitem_S_Detail")
			SELECT SOitem_S_Detail
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT * " 
		cSQL = cSQL + " FROM dbo.Sales_Detail WITH(NOLOCK) "
		cSQL = cSQL + " WHERE StockLst_ID_Detail ="+STR(nID_Detail)
		cSQL = cSQL + " AND TBL = '"+ThisForm.cTBL+"'"
		cSQL = cSQL + " ORDER BY [ID] DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SOitem_S_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'SOitem_S_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SOitem_S_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SOitem_S_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'SOitem_S_Detail')
		ELSE
			IF RECCOUNT("SOitem_S_Detail") > 0
				ThisForm.pf.pgSOitem_Detail.grdSOitem_S_Detail.RecordSource = 'SOitem_S_Detail'
				*ThisForm.SOitem_S_Detail_Change()
				ThisForm.pf.pgSOitem_Detail.grdSOitem_S_Detail.column2.Text1.ForeColor = RGB(0,0,255)
				ThisForm.pf.pgSOitem_Detail.grdSOitem_S_Detail.column2.Text1.ToolTipText = "Double click to view"
				*ThisForm.pf.pgSOitem_Detail.grdSOitem_S_Detail.column2.Text1.DblClick = "Wait Window 'Double Click'"
		
			ENDIF
		ENDIF
		
		ThisForm.pf.pgSOitem_Detail.grdSOitem_S_Detail.Refresh
		
		
		***********************************
		***********************************
		
		DO CASE 
		CASE ThisForm.pf.ActivePage = 1
			ThisForm.StockLst_Detail_Change()  &&grdStockLst_Detail
		CASE ThisForm.pf.ActivePage = 2
			ThisForm.Process_History_Change()  &&grdDetail_Process
		CASE ThisForm.pf.ActivePage = 3
			ThisForm.StockLst_Process_Change()  &&grdStockLst_Process
			*ThisForm.StockLst_Process_Detail_Change()  &&grdCurProcess_Detail
		CASE ThisForm.pf.ActivePage = 4
			ThisForm.Sales_Detail_Change()  &&grdSales_Detail
		CASE ThisForm.pf.ActivePage = 5
			ThisForm.Sales_Invoice_Change()  &&grdSales_Invoice
		CASE ThisForm.pf.ActivePage = 6
			ThisForm.Sales_Stock_Change()  &&grdSales_Stock
		CASE ThisForm.pf.ActivePage = 7
			ThisForm.WorkOrder_Stock_Change()  &&grdSales_Stock
		CASE ThisForm.pf.ActivePage = 8
			ThisForm.SOitem_S_Stock_Change()  &&grdSOitem_S_Stock
		CASE ThisForm.pf.ActivePage = 9
			ThisForm.SOitem_S_Detail_Change() &&grdSOitem_S_Detail
		ENDCASE
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pTBL, pID, pID_Detail
		*DO FORM Forms\StockLst_History.scx WITH cTBL, nId, nID_Detail
		
		** set to Modal so WO can call and not proceed till this is closed.
		** 12/19/22
		
		PRIVATE cTBL
		IF VARTYPE(pTBL) = "C"
			cTBL = UPPER(pTBL)
		ELSE
			cTBL = 'S'
		ENDIF
		
		IF VARTYPE(pID) != "N"
			pID = 0
		ENDIF
		IF VARTYPE(pID_Detail) != "N"
			pID_Detail= 0
		ENDIF
		
		DO CASE
		CASE cTBL = 'S'
			ThisForm.ogTBL.Value = 1
			ThisForm.cTBL = "S"
		CASE cTBL = 'B'
			ThisForm.ogTBL.Value = 2
			ThisForm.cTBL = "B"
		CASE cTBL = 'W'
			ThisForm.ogTBL.Value = 3
			ThisForm.cTBL = "W"
		ENDCASE
		
		***********************************
		ThisForm.Load_TBL("")
		***********************************
		
		*ThisForm.pf.pgDetail_Process.grdDetail_Process.RecordSource = 'Process_History'
		*ThisForm.pf.pgStockLst_Process.grdStockLst_Process.RecordSource = 'StockLst_Process'
		*ThisForm.pf.pgSales_Detail.grdSales_Detail.RecordSource = 'Sales_Detail'
		*ThisForm.pf.pgSales_stock.grdSales_Stock.RecordSource = 'Sales_Stock'
		*ThisForm.pf.pgWorkOrder.grdWorkOrder_Stock.RecordSource = 'WorkOrder_Stock'
			
		ThisForm.txtID.SetFocus
		
		IF pID > 0
			ThisForm.txtID.Value = pID
			ThisForm.cmdSearchID.Click
		ELSE
			IF pID_Detail > 0
				ThisForm.txtID_Detail.Value = pID_Detail
				ThisForm.cmdSearchID_Detail.Click
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		***********************************
		
		*ThisForm.Load_TBL("")
		
	ENDPROC

