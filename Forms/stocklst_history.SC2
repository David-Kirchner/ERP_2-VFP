		**Invoice   .ActivePAge = 5
		ThisForm.pf.pgSales_Invoice.grdSales_Invoice.RecordSource = ''
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = cSQL + " SELECT SI.[ID]"
		cSQL = cSQL + ",SI.[Invoice]"
		cSQL = cSQL + ",SI.[InvoiceDate]"
		cSQL = cSQL + ",SI.[SOitem]"
		cSQL = cSQL + ",SI.[SalesNum]"
		cSQL = cSQL + ",SI.[CustomerID]"
		cSQL = cSQL + ",SI.[CustomerName]"
		cSQL = cSQL + ",SI.[Customer_PO]"
		cSQL = cSQL + ",SI.[Ship_Via]"
		cSQL = cSQL + ",SI.[Disc_Amount]"
		cSQL = cSQL + ",SI.[Sales_Rep]"
		cSQL = cSQL + ",SI.[AR_Amount]"
		cSQL = cSQL + ",SI.[Invoice_Note]"
		cSQL = cSQL + ",SI.[Amount]"
		cSQL = cSQL + ",SI.[ItemTot]"
		cSQL = cSQL + ",SI.[Item]"
		cSQL = cSQL + ",SI.[Quantity]"
		cSQL = cSQL + ",SI.[GL_Account]"
		cSQL = cSQL + ",SI.[UnitPrice]"
		cSQL = cSQL + ",SI.[Trans_Period]"
		cSQL = cSQL + ",SI.[Trans_No]"
		cSQL = cSQL + ",SI.[ReturnAuth]"
		cSQL = cSQL + ",SI.[Description]"
		cSQL = cSQL + ",SI.[Ship_Date]"
		cSQL = cSQL + ",SI.[Date_Due]"
		cSQL = cSQL + ",SI.[Reconciled]"
		cSQL = cSQL + ",SI.[Sales_Detail_ID]"
		cSQL = cSQL + ",SI.[Paid]"
		cSQL = cSQL + " FROM dbo.[Sales_Detail] SD"
		cSQL = cSQL + " INNER JOIN dbo.[Sales_Invoice] SI ON SD.ID = SI.Sales_Detail_ID"
		cSQL = cSQL + " WHERE SD.StockLst_ID_Detail = "+STR(nID_Detail)
		cSQL = cSQL + " AND 0 < "+STR(nID_Detail)
		cSQL = cSQL + " AND SI.Description <> 'Freight Amount'"
		
		
		IF USED("Sales_Invoice")
			SELECT Sales_Invoice
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_Invoice')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_Invoice')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_Invoice")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_Invoice")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Sales_Invoice')
		ELSE
			IF RECCOUNT("Sales_Detail") > 0
				ThisForm.pf.pgSales_Invoice.grdSales_Invoice.RecordSource = 'Sales_Invoice'
				*ThisForm.Sales_Invoice_Change()
			ENDIF
		ENDIF
		
