	PROCEDURE Destroy
		
		IF USED('tmpPermissions')
			USE IN tmpPermissions
		ENDIF
		
		=SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE Init
		
		SELECT 0
		IF USED('tmpPermissions')
			USE IN tmpPermissions
		ENDIF
		
		cSQL = "SELECT IS_MEMBER('Windfall\Accounting') AS [Accounting]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\Certs') AS [Certs]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\HPA') AS [HPA]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\MFG_Log') AS [MFG_Log]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\Quotes') AS [Quotes]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\Receiving') AS [Receiving]"
		*cSQL = cSQL + ", IS_MEMBER('Windfall\Sales') AS [Sales]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\Shipping') AS [Shipping]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\Shop_Management') AS [Shop_Management]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\StockLst') AS [StockLst]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\Warehouse') AS [Warehouse]"
		cSQL = cSQL + ", IS_MEMBER('Windfall\WorkOrderManager') AS [WorkOrderManager];"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPermissions')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPermissions')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPermissions")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPermissions")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpPermissions')
		ENDIF
		
		IF NOT USED('tmpPermissions')
			RETURN .F.
		ELSE
			ThisForm.lblUser.Caption = SYS(0)
			SELECT tmpPermissions
			
			ThisForm.chkHPA.Value		= PrepareSQLbit(tmpPermissions.HPA,'HPA')
			ThisForm.chkAccounting.Value	= PrepareSQLbit(tmpPermissions.Accounting,'Accounting')
			ThisForm.chkCerts.Value		= PrepareSQLbit(tmpPermissions.Certs,'Certs')
			ThisForm.chkMFG_Log.Value	= PrepareSQLbit(tmpPermissions.MFG_Log,'MFG_Log')
			ThisForm.chkQuotes.Value	= PrepareSQLbit(tmpPermissions.Quotes,'Quotes')
			ThisForm.chkReceiving.Value	= PrepareSQLbit(tmpPermissions.Receiving,'Receiving')
			ThisForm.chkShipping.Value	= PrepareSQLbit(tmpPermissions.Shipping,'Shipping')
			ThisForm.chkStockLst.Value	= PrepareSQLbit(tmpPermissions.StockLst,'StockLst')
			ThisForm.chkWarehouse.Value	= PrepareSQLbit(tmpPermissions.Warehouse,'Warehouse')
			ThisForm.chkShop_Management.Value	= PrepareSQLbit(tmpPermissions.Shop_Management,'Shop_Management')
			ThisForm.chkWorkOrderManager.Value	= PrepareSQLbit(tmpPermissions.WorkOrderManager,'WorkOrderManager')
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVEF
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

ENDDEFINE
