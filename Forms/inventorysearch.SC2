	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE detailbuttons
		Parameter lcPass
		
		DO CASE
		CASE lcPass = "ENABLE"
			ThisForm.cmdEditDetail.Visible = .T.
			ThisForm.cmdDeleteDetail.Visible = .T.
			ThisForm.cmdAddDetail.Visible = .T.
		CASE lcPass = "DISABLE"
			ThisForm.cmdEditDetail.Visible = .F.
			ThisForm.cmdDeleteDetail.Visible = .F.
			ThisForm.cmdAddDetail.Visible = .F.
		ENDCASE
		
		
	ENDPROC

	PROCEDURE Init
		ThisForm.grdSql_inventory_master.Visible = .F.
		ThisForm.grdSql_inventory_detail.Visible = .F.
		ThisForm.MasterButtons("DISABLE")
		ThisForm.DetailButtons("DISABLE")
		ThisForm.txtID.SetFocus
	ENDPROC

	PROCEDURE Load
		
		ThisForm.ConnHandle = SQLstringCONNECT("HPA") 
		IF ThisForm.ConnHandle <= 0
		   = MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
		   RETURN TO MASTER
		ENDIF
		
	ENDPROC

	PROCEDURE masterbuttons
		Parameter lcPass
		
		DO CASE
		CASE lcPass = "ENABLE"
			ThisForm.cmdEditMaster.Visible = .T.
			ThisForm.cmdDeleteMaster.Visible = .T.
			ThisForm.cmdAddMaster.Visible = .T.
		CASE lcPass = "DISABLE"
			ThisForm.cmdEditMaster.Visible = .F.
			ThisForm.cmdDeleteMaster.Visible = .F.
			ThisForm.cmdAddMaster.Visible = .F.
		ENDCASE
	ENDPROC

	PROCEDURE Resize
		*This.Width  = 635
		*This.Height = 450
		
		
		*ThisForm.cmdSearch.Left = This.Width - 114
		
		ThisForm.grdSql_inventory_master.Width = This.Width - 19
		ThisForm.grdSql_inventory_master.Height = ( This.height - 160 ) / 2
		
		ThisForm.cmdEditMaster.top = This.Height - (This.Height-160)/2 - 42 - 35
		ThisForm.cmdDeleteMaster.top = This.Height - (This.Height-160)/2 - 42 - 35
		ThisForm.cmdAddMaster.top = This.Height - (This.Height-160)/2 - 42 - 35
		
		ThisForm.grdSql_inventory_detail.Width = This.Width - 19
		ThisForm.grdSql_inventory_detail.Height = ( This.height - 160 ) / 2
		ThisForm.grdSql_inventory_detail.Top = This.Height - 45 - ThisForm.grdSql_inventory_detail.Height
		
		
		ThisForm.cmdExit.Left = This.Width - 107
		ThisForm.cmdExit.top = This.Height - 30
		
		*ThisForm.cmdEditDetail.Left = This.Width - 511
		ThisForm.cmdEditDetail.top = This.Height - 30
		
		*ThisForm.cmdDeleteDetail.Left = This.Width - 415
		ThisForm.cmdDeleteDetail.top = This.Height - 30
		
		*ThisForm.cmdAddDetail.Left = This.Width - 319
		ThisForm.cmdAddDetail.top = This.Height - 30
		
	ENDPROC

	PROCEDURE Unload
		IF USED("InvMaster")
			USE IN InvMaster
		ENDIF
		IF USED("InvDetail")
			USE IN InvDetail
		ENDIF
		
		SQLDISCONNECT(ThisForm.ConnHandle)
		
	ENDPROC

	PROCEDURE cmbAlloy.Init
		#DEFINE ALL_LOC "(All)"
		this.clear
		this.additem(ALL_LOC)
		
		LOCAL aAlloys,cAlloy
		DIMENSION aAlloys[1]
		
		*SELECT DISTINCT alloy FROM Alloys WHERE !DELETED() INTO array aAlloys
		*FOR EACH m.cAlloy IN aAlloys
		*	IF !EMPTY(m.cAlloy)
		*		this.additem(m.cAlloy)
		*	ENDIF
		*ENDFOR
		
		cSQL = "SELECT DISTINCT alloy FROM StockLst_master ORDER BY Alloy"
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, "Sql_Alloys")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, "Sql_Alloys")
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sql_Alloys")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sql_Alloys")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError( cSQL, ThisForm.nConnHandle )
		ENDIF
		
		
			SELECT Sql_Alloys
			SCAN
				this.additem(Sql_Alloys.Alloy)
			ENDSCAN
		
		
		THIS.VALUE = ALL_LOC
		
	ENDPROC

	PROCEDURE cmbForm.Init
		PRIVATE cSQL, nSQLEXEC
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.ConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.ConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		this.clear
		this.addListitem("(ALL)",1,1)
		this.addListitem("All Forms",1,2)
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)+1
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I+1,1)
			this.addListitem(aFormCode(I, 2),I+1,2)
		ENDFOR
	ENDPROC

	PROCEDURE cmdEditDetail.Click
		
		DO FORM Forms\StockLst_Detail WITH "EDIT", Sql_Inventory_Detail.ID_Detail, 0, 'StockLst', 0
		
		
	ENDPROC

	PROCEDURE cmdEditMaster.Click
		*DO FORM Forms\InventoryMasterEdit WITH Sql_inventory_master.ID
		DO FORM Forms\StockLst_Master WITH "EDIT", Sql_inventory_master.ID, "StockLst"
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSearch.Click
		PRIVATE lnID, lcAlloy, lcForm, lnThickness, lcHeat
		PRIVATE lcSQL, lcSQLWhere
		lcSQLWhere = ""
		
		lnID = ThisForm.txtID.Value
		IF NOT IsNull(lnID) 
			IF TYPE("lnID") = "N" 
				IF lnID > 0
					lcSQLWhere = lcSQLWhere + "ID = " + ALLTRIM(STR( lnID ))
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.cmbAlloy.VALUE <> "(All)"
			lcAlloy= ThisForm.cmbAlloy.Value
			IF TYPE("lcAlloy") = "C" 
				IF NOT EMPTY(lcAlloy)
					IF LEN(lcSQLWhere) > 0 
						lcSQLWhere  = lcSQLWhere +" AND"
					ENDIF
					lcSQLWhere = lcSQLWhere + " Alloy = '" + ALLTRIM(lcAlloy) + "'"
				ENDIF
			ENDIF
		ENDIF
		
		IF ThisForm.cmbForm.VALUE <> "(All)"
			lcForm= ThisForm.cmbForm.Value
			IF TYPE("lcForm") = "C" 
				IF NOT EMPTY(lcForm)
					IF LEN(lcSQLWhere) > 0 
						lcSQLWhere  = lcSQLWhere +" AND"
					ENDIF
					lcSQLWhere = lcSQLWhere + " Form = '" + ALLTRIM(lcForm) + "'"
				ENDIF
			ENDIF
		ENDIF
		
		lnThickness = ThisForm.txtThickness.Value
		IF NOT IsNull(lnThickness ) 
			IF TYPE("lnThickness ") = "N" 
				IF lnThickness > 0
					IF LEN(lcSQLWhere) > 0 
						lcSQLWhere  = lcSQLWhere +" AND"
					ENDIF
					*lcSQLWhere = lcSQLWhere + " ( size_l >= " + STR( lnThickness,9,4 ) + " AND  size_h <= " + STR( lnThickness,9,4 ) + " )"
					lcSQLWhere = lcSQLWhere + " size = " + STR( lnThickness,9,4 )
				ENDIF
			ENDIF
		ENDIF
		
		lcHeat = ThisForm.txtHeat.Value
		IF NOT IsNull(lcHeat ) 
			IF TYPE("lcHeat ") = "C" 
				IF NOT EMPTY(lcHeat )
					IF LEN(lcSQLWhere) > 0 
						lcSQLWhere  = lcSQLWhere +" AND"
					ENDIF
					lcSQLWhere = lcSQLWhere + " Heat LIKE '%" + ALLTRIM(lcHeat ) + "%'"
				ENDIF
			ENDIF
		ENDIF
		
		*ThisForm.lblSQL.Caption = lcSQLWhere
		
		IF EMPTY(lcSQLWhere)
			lcSQLWhere = "0=0"
		ENDIF
		
		IF NOT EMPTY(lcSQLWhere)
			lcSQL = "SELECT * FROM StockLst_master WHERE " + lcSQLWhere
			
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, lcSQL, "Sql_inventory_master")
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, lcSQL, "Sql_inventory_master")
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, lcSQL, "Sql_inventory_master")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, lcSQL, "Sql_inventory_master")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError( lcSQL, ThisForm.nConnHandle )
			ELSE
				SELECT Sql_inventory_master
				IF NOT EOF("Sql_inventory_master")
					ThisForm.grdSql_inventory_detail.RecordSource=""
					ThisForm.grdSql_inventory_detail.Visible = .F.
					ThisForm.DetailButtons("DISABLE")
					
					ThisForm.grdSql_inventory_master.RecordSource="Sql_inventory_master"
					ThisForm.grdSql_inventory_master.Visible = .T.
					*ThisForm.MasterButtons("ENABLE")
				ELSE
					ThisForm.grdSql_inventory_detail.RecordSource=""
					ThisForm.grdSql_inventory_detail.Visible = .F.
					ThisForm.DetailButtons("DISABLE")
					
					ThisForm.grdSql_inventory_master.Visible = .F.
					ThisForm.grdSql_inventory_master.RecordSource=""
					ThisForm.MasterButtons("DISABLE")
					
					= messagebox(" Not Found! ")
				ENDIF
				ThisForm.grdSql_inventory_master.Refresh
			ENDIF
		ELSE
			ThisForm.grdSql_inventory_detail.RecordSource=""
			ThisForm.grdSql_inventory_detail.Visible = .F.
			ThisForm.DetailButtons("DISABLE")
			
			ThisForm.grdSql_inventory_master.Visible = .F.
			ThisForm.grdSql_inventory_master.RecordSource=""
			ThisForm.MasterButtons("DISABLE")
					
			= messagebox(" Not Found! ")
		
		ENDIF
	ENDPROC

	PROCEDURE grdSql_inventory_detail.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.DetailButtons("ENABLE")
	ENDPROC

	PROCEDURE grdSql_inventory_master.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.MasterButtons("ENABLE")
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT * FROM stocklst_detail WHERE ID ="+ ALLTRIM(STR(Sql_inventory_master.ID)) 
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, "Sql_inventory_Detail")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, "Sql_inventory_Detail")
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sql_inventory_master")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sql_inventory_master")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError( cSQL, ThisForm.nConnHandle )
		ENDIF
			
		IF nSQLEXEC > 0
			SELECT Sql_inventory_Detail
			IF NOT EOF("Sql_inventory_Detail")
				ThisForm.grdSql_inventory_detail.RecordSource="Sql_inventory_Detail"
				ThisForm.grdSql_inventory_detail.Visible = .T.
				ThisForm.DetailButtons("DISABLE")
			ELSE
				ThisForm.grdSql_inventory_detail.RecordSource=""
				ThisForm.grdSql_inventory_detail.Visible = .F.
				ThisForm.DetailButtons("DISABLE")
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE
