DEFINE CLASS frmgetreason AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="edtComment" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdDone" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdCancel" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: creturn
		*p: lforceanswer
	*</DefinedPropArrayMethod>

	*<PropValue>
		AlwaysOnTop = .T.
		Caption = "Enter Reason."
		Closable = .F.
		ControlBox = .F.
		creturn = 
		DoCreate = .T.
		Height = 76
		Left = 124
		lforceanswer = .F.
		Name = "frmGetReason"
		ShowTips = .T.
		Top = 58
		Width = 377
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdCancel' AS commandbutton WITH ;
		BackColor = 255,128,128, ;
		Caption = "Abort", ;
		ForeColor = 0,0,0, ;
		Height = 24, ;
		Left = 288, ;
		Name = "cmdCancel", ;
		TabIndex = 2, ;
		TerminateRead = .T., ;
		Top = 12, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdDone' AS commandbutton WITH ;
		BackColor = 128,255,128, ;
		Caption = "Done", ;
		ForeColor = 0,0,0, ;
		Height = 24, ;
		Left = 288, ;
		Name = "cmdDone", ;
		TabIndex = 3, ;
		TerminateRead = .T., ;
		Top = 36, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'edtComment' AS editbox WITH ;
		Height = 48, ;
		Left = 8, ;
		MaxLength = 240, ;
		Name = "edtComment", ;
		OLEDragPicture = ..\, ;
		OLEDropEffects = 1, ;
		OLEDropMode = 0, ;
		OLEDropTextInsertion = 0, ;
		Top = 12, ;
		Value = , ;
		Width = 276
		*< END OBJECT: BaseClass="editbox" />
	
	PROCEDURE Init
		PARAMETERS pCaption, pComment, lForceAnswer
		
		*DO FORM Forms\GetReason WITH "Reprint Sales Order Reason",'',.f. TO cReturnMess
		*DO FORM Forms\GetReason WITH pCaption, pComment, lForceAnswer TO cReturnMess
		
		IF VARTYPE(pCaption) = "C"
			This.Caption = pCaption
		ELSE
		
		ENDIF
		
		IF VARTYPE(pComment) = "C"
			ThisForm.edtComment.Value = pComment
		ENDIF
		
		IF VARTYPE(lForceAnswer)= "L"
			ThisForm.lForceAnswer = lForceAnswer
		ELSE
			ThisForm.lForceAnswer = .F.
		ENDIF
	ENDPROC

	PROCEDURE Unload
		RETURN ThisForm.cReturn
	ENDPROC

	PROCEDURE cmdCancel.Click
		
		ThisForm.cReturn = ''
		
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdDone.Click
		
		PRIVATE cComment
		cComment = PrepareSQLtxt(ThisForm.edtComment.Value,'Comment',-1)
		
		IF ThisForm.lForceAnswer
			IF EMPTY(cComment)
				MESSAGEBOX("The Window will not allow a blank!.",48,"No Reason")
				RETURN .F.
			ENDIF
		ENDIF
				
		ThisForm.cReturn = cComment
		
		ThisForm.Release
		
	ENDPROC

ENDDEFINE
