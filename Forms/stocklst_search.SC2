	PROCEDURE findheat
		PARAMETERS pHeat
		
		IF VARTYPE(pHeat) = "C"
			pHeat = ALLTRIM(pheat)
			IF RIGHT(pHeat,1) = "'"OR RIGHT(pHeat,1) = ["]
				pHeat = LEFT(pHeat, LEN(pHeat)-1 )
			ENDIF
			IF LEFT(pHeat,1) = "'" OR LEFT(pHeat,1) = ["]
				pHeat = RIGHT(pHeat, LEN(pHeat)-1 )
			ENDIF
		ENDIF
		
		IF TYPE("pHeat") = "C"
			IF NOT EMPTY( ALLTRIM( pHeat ))	
				ThisForm.grdStockLst.RecordSource = ""
				
				PRIVATE lFoundCurrent 
				lFoundCurrent = .F.
				
				PRIVATE cHeat
				cHeat = ALLTRIM( pHeat )
				
				PRIVATE cSQL,nSQLEXEC
				
		*		cSQL = "SELECT 'T' as [Current], ' ' as [WHO], ' ' as [WHAT], GetDate() as [WHEN], *, 0 as [ID_History] FROM dbo.StockLst_Master "
		*		cSQL = cSQL + " WHERE HEAT LIKE '%" + cHeat + "%'"
		*		cSQL = cSQL + " UNION SELECT 'F' as [Current], * FROM dbo.[AR.StockLst_Master_History"
		*		cSQL = cSQL + " WHERE HEAT LIKE '%" + cHeat + "%'"
				*cSQL = cSQL = " AND [WHAT] = 'DELETE'"
		*		cSQL = cSQL + " ORDER BY Alloy,Form,cc,Size,Heat,[Current],[What] "
		
				cSQL = "SELECT * FROM dbo.StockLst_Master_union WHERE HEAT LIKE '%" + cHeat + "%'"
				cSQL = cSQL + " ORDER BY id, alloy, form, cc, size, heat, What"
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				WAIT WINDOW "SELECT * FROM dbo.StockLst_Master_union WITH(NOLOCK) WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ENDIF
				ENDIF
				
				***************
				***************
				IF NOT lFoundCurrent 
					PRIVATE nMess
					nMess = MESSAGEBOX("Your heat was not found"+CHR(13)+"Do you want to search "+CHR(13)+"History?",4+32,"Your heat was not found")
					IF nMess = 6
						cSQL = "SELECT * FROM dbo.[AR.StockLst_Master_History WITH(NOLOCK) "
						cSQL = cSQL + " WHERE HEAT LIKE '%" + cHeat + "%'"
						cSQL = cSQL + " AND What = 'DELETE' "
						cSQL = cSQL + " ORDER BY id, alloy, form, cc, size, heat, What"
						IF USED("tStockLst_SQL")
							USE IN tStockLst_SQL
						ENDIF
		
						SELECT 0
						WAIT WINDOW "SELECT * FROM dbo.[AR.StockLst_Master WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
						ELSE
							IF RECCOUNT('tStockLst_SQL') > 0
								lFoundCurrent = .T.
							ELSE
								MESSAGEBOX("Your Heat was not found in History?",0+32,"Your Heat was not found")
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
				***************
				***************
				
				IF lFoundCurrent 
					ThisForm.showDistinctID()
					SELECT tStockLst_SQL	
					ThisForm.grdStockLst.RecordSource = "tStockLst_SQL"
					ThisForm.grdStockLst.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE findpo_item
		PARAMETERS pPO_item
		
		PRIVATE nItem
		
		IF Proper_PO_Item(pPO_item) = Proper_PO_Item('')
			*empty
			MESSAGEBOX("Not a proper PO item",0,"Cannot find")
			RETURN .F.
		ENDIF
		PRIVATE nHPAPO, nItem, cPOitem
		nHPAPO	= Proper_PO_Item_PO(pPO_item)
		nItem	= Proper_PO_Item_Item(pPO_item)
		cPOitem	= Proper_PO_Item(pPO_item)
		
		IF Proper_PO_Item(cPOitem) = Proper_PO_Item('')
			*empty
			MESSAGEBOX("Not a proper PO item",0,"Cannot find")
			RETURN .F.
		ENDIF
		
		IF nHPAPO = 0
			*empty
			MESSAGEBOX("Not a proper PO item",0,"Cannot find")
			RETURN .F.
		ENDIF
		IF nItem = 0
			DO FORM Forms\ChoosePOitem WITH nHPAPO TO pPo_Item
		ENDIF
		
		
		
		
		PRIVATE lFoundCurrent 
		lFoundCurrent = .F.
		
		ThisForm.txtText.Value = cPOitem
		
		ThisForm.grdStockLst.RecordSource = ""
				
		PRIVATE cSQL,nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.StockLst_Master_Union WITH(NOLOCK) "
		cSQL = cSQL + " WHERE ID IN ( "
		cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.StockLst_Detail_Union WITH(NOLOCK) WHERE ID_Detail IN ("
		cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.[AR.StockLst_Process_History WITH(NOLOCK) "
		cSQL = cSQL + " WHERE StockLst_Process_History.PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
		cSQL = cSQL + " )) ORDER BY id, alloy, form, cc, size, heat, What"
		
		IF USED("tStockLst_SQL")
			USE IN tStockLst_SQL
		ENDIF
		
		SELECT 0
		WAIT WINDOW "SELECT StockLst_Master_Union.* FROM dbo.StockLst_Master_Union " NOWAIT
		
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
		ELSE
			IF RECCOUNT('tStockLst_SQL') > 0
				lFoundCurrent = .T.
			ENDIF
		ENDIF
		***************
		***************
		IF NOT lFoundCurrent 
			PRIVATE nMess
			nMess = MESSAGEBOX("Your PO item was not found"+CHR(13)+"Do you want to search again in "+CHR(13)+"History?",4+32,"Your PO item was not found")
			IF nMess = 6
				cSQL = "SELECT * FROM dbo.[AR.StockLst_Master_History WITH(NOLOCK) "
				cSQL = cSQL + " WHERE PO_item = dbo.f_ProperPOitem('"+cPOitem+"')"
				cSQL = cSQL + " AND What = 'DELETE' "
				
				cSQL = cSQL + " ORDER BY id, alloy, form, cc, size, heat, What"
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				*WAIT WINDOW "SELECT * FROM dbo.[AR.StockLst_Master WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ELSE
						MESSAGEBOX("Your PO item was not found in History?",4+32,"Your Purchase Order item was not found")
					ENDIF
				ENDIF		
			ENDIF
		ENDIF
		***************
		***************
		
		
		IF lFoundCurrent 
			SELECT tStockLst_SQL	
			ThisForm.grdStockLst.RecordSource = "tStockLst_SQL"
			ThisForm.grdStockLst.Refresh
		ENDIF
			
		
		
	ENDPROC

	PROCEDURE findsoitem
		PARAMETERS pSOitem
		
		PRIVATE nItem
		
		IF TYPE("pSOitem") = "N"
			pSOitem = STR(pSOitem)
		ENDIF
		
		PRIVATE nSO, nItem, cSOitem
		cSOitem = Proper_SO_item(pSOitem)
		nSO	= Proper_SO_Item_SO(cSOitem)
		nItem	= Proper_SO_Item_Item(cSOitem)
		
		
		IF cSOitem <> Proper_SO_item('')
			IF NOT EMPTY( ALLTRIM( pSOitem))	
				IF AT("-",pSOitem) = 0
					pSOitem = ALLTRIM(pSOitem)+"-01"
					cSOitem = Proper_SO_item(pSOitem)
					nSO	= Proper_SO_Item_SO(cSOitem)
					nItem	= Proper_SO_Item_Item(cSOitem)
					
					*MESSAGEBOX("No Item entered"+CHR(13)+"You must enter the Item after the salesNumber"+"Item has been defaulted to 1",0+64,"Item defaulted to 1")
					WAIT WINDOW "No 'Item Number' entered, You should enter the Item after the SalesNumber, Item has been defaulted to -01" TIMEOUT 2
				ENDIF
		
				PRIVATE lFoundCurrent 
				lFoundCurrent = .F.
		
				ThisForm.txtText.Value = cSOitem
			
				ThisForm.grdStockLst.RecordSource = ""
				
		
				PRIVATE cSQL,nSQLEXEC
		
				cSQL = "SELECT * FROM dbo.StockLst_Master_Union M WITH(NOLOCK) "
				cSQL = cSQL + " WHERE ID IN ( "
				cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.StockLst_Detail WITH(NOLOCK) WHERE ID_Detail IN ("
				cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.[AR.StockLst_Process_History WITH(NOLOCK) "
				cSQL = cSQL + " WHERE StockLst_Process_History.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
				cSQL = cSQL + " )) ORDER BY M.id, M.alloy, M.form, M.cc, M.size, M.heat, M.What"
				
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				WAIT WINDOW "SELECT StockLst_Master_Union.* FROM dbo.StockLst_Master_Union " NOWAIT
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ENDIF
				ENDIF
				
				**************
				***************
				IF NOT lFoundCurrent 
					PRIVATE nMess
					nMess = MESSAGEBOX("Your SOitem was not found"+CHR(13)+"Do you want to search again in "+CHR(13)+"History?",4+32,"Your SO item was not found")
					IF nMess = 6
						cSQL = "SELECT * FROM dbo.[AR.StockLst_Master_History M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.[AR.StockLst_Detail_History D WITH(NOLOCK) ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.[AR.StockLst_Process_History P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOItem+"')"
						cSQL = cSQL + " AND M.What = 'DELETE' "
						cSQL = cSQL + " AND D.What = 'DELETE' "
						cSQL = cSQL + " AND P.What = 'DELETE' "
						
						cSQL = cSQL + " ORDER BY M.id, M.alloy, M.form, M.cc, M.size, M.heat, M.What"
						
						IF USED("tStockLst_SQL")
							USE IN tStockLst_SQL
						ENDIF
		
						SELECT 0
						*WAIT WINDOW "SELECT * FROM dbo.[AR.StockLst_Master WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
						ELSE
							IF RECCOUNT('tStockLst_SQL') > 0
								lFoundCurrent = .T.
							ELSE
								MESSAGEBOX("Your SO item was not found in History?",4+32,"Your Sales Order Item was not found")
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
				***************
				***************
								
				IF lFoundCurrent 
					ThisForm.showDistinctID()
					SELECT tStockLst_SQL	
					ThisForm.grdStockLst.RecordSource = "tStockLst_SQL"
					ThisForm.grdStockLst.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE findworkorder
		PARAMETERS pWO
		
		IF TYPE("pWO") = "C"
			pWO = VAL(pWO)
		ENDIF
		
		IF TYPE("pWO") = "N"
			IF pWO > 0
			
				PRIVATE lFoundCurrent 
				lFoundCurrent = .F.
		
				ThisForm.txtText.Value = pWO
			
				ThisForm.grdStockLst.RecordSource = ""
				
				PRIVATE cSQL,nSQLEXEC
				
				cSQL = "SELECT StockLst_Master_Union.* FROM dbo.StockLst_Master_Union WITH(NOLOCK) "
				cSQL = cSQL + " WHERE ID IN ( "
				cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.StockLst_Detail_Union WITH(NOLOCK) WHERE ID_Detail IN ("
				cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.[AR.StockLst_Process_History WITH(NOLOCK)  "
		
				cSQL = cSQL + " WHERE StockLst_Process_History.WO = "+STR(pWO)
				cSQL = cSQL + " )) ORDER BY id, alloy, form, cc, size, heat, What"
				
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				WAIT WINDOW "SELECT StockLst_Master_Union.* FROM dbo.StockLst_Master_Union " NOWAIT
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ENDIF
				ENDIF
				
				***************
				***************
				IF NOT lFoundCurrent 
					PRIVATE nMess
					nMess = MESSAGEBOX("Your WO was not found"+CHR(13)+"Do you want to search again in "+CHR(13)+"History?",4+32,"Your Work Order was not found")
					IF nMess = 6
						cSQL = "SELECT * FROM dbo.[AR.StockLst_Master_History M WITH(NOLOCK) "
						cSQL = cSQL + " INNER JOIN dbo.[AR.StockLst_Detail_History D WITH(NOLOCK) ON M.ID = D.ID "
						cSQL = cSQL + " INNER JOIN dbo.[AR.StockLst_Process_History P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
						cSQL = cSQL + " WHERE P.WO = "+STR(pWO)
						cSQL = cSQL + " AND M.What = 'DELETE' "
						cSQL = cSQL + " AND D.What = 'DELETE' "
						cSQL = cSQL + " AND P.What = 'DELETE' "
						
						cSQL = cSQL + " ORDER BY M.id, M.alloy, M.form, M.cc, M.size, M.heat, M.What"
						IF USED("tStockLst_SQL")
							USE IN tStockLst_SQL
						ENDIF
		
						SELECT 0
						*WAIT WINDOW "SELECT * FROM dbo.[AR.StockLst_Master WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
						ELSE
							IF RECCOUNT('tStockLst_SQL') > 0
								lFoundCurrent = .T.
							ELSE
								MESSAGEBOX("Your WO was not found in History?",4+32,"Your Work Order was not found")
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
		
				***************
				***************
						
				IF lFoundCurrent 
					ThisForm.showDistinctID()
					SELECT tStockLst_SQL	
					ThisForm.grdStockLst.RecordSource = "tStockLst_SQL"
					ThisForm.grdStockLst.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE findwo_detail
		PARAMETERS pWO_Detail
		
		IF TYPE("pWO_Detail") = "C"
			pWO_Detail = VAL(pWO_Detail)
		ENDIF
		
		IF TYPE("pWO_Detail") = "N"
			IF pWO_Detail > 0
				PRIVATE lFoundCurrent 
				lFoundCurrent = .F.
		
				ThisForm.txtText.Value = pWO_Detail
			
				ThisForm.grdStockLst.RecordSource = ""
				
				PRIVATE cSQL,nSQLEXEC
				
				cSQL = "SELECT StockLst_Master_Union.* FROM dbo.StockLst_Master_Union WITH(NOLOCK) "
				cSQL = cSQL + " WHERE ID IN ( "
				cSQL = cSQL + " SELECT DISTINCT ID FROM dbo.StockLst_Detail_Union WITH(NOLOCK) WHERE ID_Detail IN ("
				cSQL = cSQL + " SELECT DISTINCT ID_Detail FROM dbo.[AR.StockLst_Process_History WITH(NOLOCK) "
		
				cSQL = cSQL + " WHERE StockLst_Process_History.WO_Detail = "+STR(pWO_Detail)
				cSQL = cSQL + " )) ORDER BY id, alloy, form, cc, size, heat, What"
				
				IF USED("tStockLst_SQL")
					USE IN tStockLst_SQL
				ENDIF
		
				SELECT 0
				WAIT WINDOW "SELECT StockLst_Master_Union.* FROM dbo.StockLst_Master_Union " NOWAIT
				
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 1
					SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
				ELSE
					IF RECCOUNT('tStockLst_SQL') > 0
						lFoundCurrent = .T.
					ENDIF
				ENDIF
				
				***************
				***************
				IF NOT lFoundCurrent 
					PRIVATE nMess
					nMess = MESSAGEBOX("Your WO Detail was not found"+CHR(13)+"Do you want to search again in "+CHR(13)+"History?",4+32,"Your WO Detail was not found")
					IF nMess = 6
						cSQL = "SELECT * FROM dbo.[AR.StockLst_Master_History WITH(NOLOCK) "
						cSQL = cSQL + " WHERE WO_Detail = "+STR(pWO_Detail)
						cSQL = cSQL + " AND What = 'DELETE' "
								
						cSQL = cSQL + " ORDER BY id, alloy, form, cc, size, heat, What"
						IF USED("tStockLst_SQL")
							USE IN tStockLst_SQL
						ENDIF
		
						SELECT 0
						WAIT WINDOW "SELECT * FROM dbo.[AR.StockLst_Master WHERE HEAT LIKE '%"+cHeat+"%'" NOWAIT
						
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tStockLst_SQL')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tStockLst_SQL")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 1
							SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tStockLst_SQL')
						ELSE
							IF RECCOUNT('tStockLst_SQL') > 0
								lFoundCurrent = .T.
							ELSE
								MESSAGEBOX("Your WO_Detail was not found in History?",4+32,"Your Work Order Detail was not found")
							ENDIF
						ENDIF		
					ENDIF
				ENDIF
		
				***************
				***************
						
				IF lFoundCurrent 
					ThisForm.showDistinctID()
					SELECT tStockLst_SQL	
					ThisForm.grdStockLst.RecordSource = "tStockLst_SQL"
					ThisForm.grdStockLst.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pText,pWhat
		*DO FORM "c:\program files (x86)\hpa\forms\stocklst_search.scx" WITH '',"SOITEM"
		*DO FORM "c:\program files (x86)\hpa\forms\stocklst_search.scx" WITH '','HEAT'
		
		*Call Lst_search to get Stock or Broker
		
		IF VARTYPE(pWhat) != "C"
			MESSAGEBOX("What to search for what?"+CHR(13)+"Defaulting to 'Heat'",0+48,"Need 'what' parameter!")
			*RETURN -1  Does not work
			 pWhat =  "HEAT"
		ENDIF
		IF VARTYPE(pText) != "C"
			pText = ""
		ENDIF
		
		IF pWhat =  "HEAT"
			ThisForm.lblText.Caption = "Heat"
			IF NOT EMPTY(pText)
				ThisForm.txtText.Value = pText 
				ThisForm.FindHeat( This.txtText.Value )
			ENDIF
		ENDIF
			
		IF pWhat =  "SOITEM"
			ThisForm.lblText.Caption = "SO Item"
			IF NOT EMPTY(pText)
				ThisForm.txtText.Value = pText 
				ThisForm.FindSOitem( This.txtText.Value )
			ENDIF
		ENDIF
			
		IF pWhat =  "WORKORDER"
			ThisForm.lblText.Caption = "Work Order"
			IF NOT EMPTY(pText)
				ThisForm.txtText.Value = pText 
				ThisForm.FindWorkOrder( This.txtText.Value )
			ENDIF
		ENDIF
		
		IF pWhat =  "WO_DETAIL"
			ThisForm.lblText.Caption = "Work Order Detail"
			IF NOT EMPTY(pText)
				ThisForm.txtText.Value = pText 
				ThisForm.FindWO_Detail( This.txtText.Value )
			ENDIF
		ENDIF
		
		IF pWhat =  "PO_ITEM"
			ThisForm.lblText.Caption = "ERP PO item"
			IF NOT EMPTY(pText)
				ThisForm.txtText.Value = pText 
				ThisForm.FindPO_item( This.txtText.Value )
			ENDIF
		ENDIF
		
		ThisForm.txtText.SetFocus
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		THISFORM.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		
		IF THISFORM.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDeltaH, nDeltaW
		
		*frm .Height = 245
		nDeltaH = ThisForm.Height - 245
		*frm .Width = 561
		nDeltaW = ThisForm.Width - 561
		
		ThisForm.grdStockLst.Height = 192 + nDeltaH
		ThisForm.grdStockLst.Width = 540 + nDeltaW 
	ENDPROC

	PROCEDURE showdistinctid		&& showDistinctID
		*Called after a Search
		
		IF USED('tDistinctID')
			USE IN tDistinctID
		ENDIF
		
		*SELECT tStockLst_SQL
		
		SELECT Distinct ID FROM tStockLst_SQL INTO CURSOR tDistinctID
		
		
		IF USED('tDistinctID')
			PRIVATE cIDlist
			cIDlist = "ID:"
			
			DO WHILE NOT EOF('tDistinctID')
				IF cIDlist == "ID:"
					cIDlist = cIDlist +" "+ALLTRIM(STR(tDistinctID.ID))
				ELSE
					cIDlist = cIDlist +", "+ALLTRIM(STR(tDistinctID.ID))
				ENDIF
				IF LEN(cIDlist) > 200
					EXIT
				ENDIF
				SKIP 1
			ENDDO
			
			USE IN tDistinctID
		ENDIF
		
		PRIVATE nCapLength
		nCapLength = 75 * (ThisForm.lblDistinctID.Width/534)  &&make purportional with resizing
		ThisForm.lblDistinctID.Caption = LEFT(cIDlist,nCapLength)
		ThisForm.showID()
	ENDPROC

	PROCEDURE showid
		*ThisForm.showID()
		
		ThisForm.txtID.Value = tStockLst_SQL.ID
	ENDPROC

	PROCEDURE Unload
		IF USED("tStockLst_SQL")
			USE IN tStockLst_SQL
		ENDIF
		
		RETURN ThisForm.nReturn
	ENDPROC

	PROCEDURE cmdReturn.Click
		PRIVATE dReturnDate
		
		ThisForm.nReturn = 0
		
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdSearch.Click
		DO CASE
		CASE ThisForm.LblText.Caption = "Heat"
			ThisForm.FindHeat( This.Parent.txtText.Value )
		CASE ThisForm.LblText.Caption = "SO Item"
			ThisForm.FindSOitem( This.Parent.txtText.Value )
		CASE ThisForm.LblText.Caption = "Work Order"
			ThisForm.FindWorkOrder( This.Parent.txtText.Value )
		CASE ThisForm.LblText.Caption = "Work Order Detail"
			ThisForm.FindWO_Detail( This.Parent.txtText.Value )
		CASE ThisForm.LblText.Caption = "ERP PO item"
			ThisForm.FindPO_item( This.Parent.txtText.Value )
		ENDCASE
	ENDPROC

	PROCEDURE cmdselect.Click
		PRIVATE nID
		
		IF USED('tStockLst_SQL')
			nID = PrepareSQLnum(tStockLst_SQL.ID,'ID',-3)
			ThisForm.nReturn = nID
			ThisForm.Release
		ENDIF
		
	ENDPROC

	PROCEDURE grdStockLst.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.showID()
	ENDPROC

	PROCEDURE txtText.Valid
		IF LEN(PrepareSQLtxt(This.Value,'text',100)) > 0
			This.Parent.cmdSearch.Click
		*	ThisForm.grdStockLst.SetFocus()
		ENDIF
	ENDPROC

ENDDEFINE
