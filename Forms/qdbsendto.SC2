	PROCEDURE Init
		IF !USED('QDBSendTo')
			ThisForm.cmdSave.Enabled = .F.
			RETURN
		ENDIF
		
		ThisForm.txtName.value		= QDBSendTo.name
		ThisForm.txtCompany.value 	= QDBSendTo.Company
		ThisForm.txtphone.value 	= QDBSendTo.phone
		ThisForm.txtPhoneext.value 	= QDBSendTo.phone_ext
		ThisForm.txtFax.value		= QDBSendTo.fax
		ThisForm.txtEmail.value 	= QDBSendTo.email
	ENDPROC

	PROCEDURE Load
		
		IF !USED('QDBsendto')
			wait window "Did not find table 'QDBSendto'"
			RETURN
		ENDIF
		
		SELECT QDBsendto
		GO TOP
		
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSave.Click
		REPLACE QDBSendTo.name		WITH ThisForm.txtName.value
		REPLACE QDBSendTo.Company	WITH ThisForm.txtCompany.value
		REPLACE QDBSendTo.phone		WITH ThisForm.txtphone.value   		
		REPLACE QDBSendTo.phone_ext	WITH ThisForm.txtPhoneext.value 	
		REPLACE QDBSendTo.fax		WITH ThisForm.txtFax.value 		
		REPLACE QDBSendTo.email		WITH ThisForm.txtEmail.value		
		
		ThisForm.Release
	ENDPROC

