	PROCEDURE Init
		PARAMETERS pWhat
		*DO FORM Forms\SalesOrder_Select WITH "ChooseSO" TO nSO
		*ThisForm.pWhat = "ChooseSO"
		
		IF VARTYPE(pWhat) = "C"
			ThisForm.pWhat = pWhat
		ELSE
			ThisForm.pWhat = ''
		ENDIF
		ThisForm.HoldNumber = 0
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		
		ThisForm.ConnHandle = get_SQLstringCONNECT()
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("ChooseSales_No")
			USE IN ChooseSales_No
		ENDIF
		SELECT 0
		
		cSQL="SELECT SalesNum,ItemTot,SalesRep,pShipAddr,pSoldAddr,ShipRoute,ShipPay,PayType "
		cSQL=cSQL+" FROM dbo.Sales_No WITH(NOLOCK) "
		cSQL=cSQL+" ORDER BY SalesNum DESC"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'ChooseSales_No')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'ChooseSales_No')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'ChooseSales_No' )
		ENDIF
		
		IF USED('ChooseSales_No')
			SELECT ChooseSales_No
			GO TOP
			IF RECCOUNT() > 8
				SKIP 8
			ENDIF
		ELSE
			MESSAGEBOX("Could not load 'Sales_No'",0,"SQL Error")
			RETURN TO MASTER
		ENDIF
	ENDPROC

	PROCEDURE refreshscreen
		ThisForm.txtSalesNum.Refresh
		ThisForm.txtItemTot.Refresh
		ThisForm.txtSalesRep.Refresh
		ThisForm.txtpShipAddr.Refresh
		ThisForm.txtpSoldAddr.Refresh
		ThisForm.txtShipRoute.Refresh
		ThisForm.txtShipPay.Refresh
		ThisForm.txtPayType.Refresh
		
	ENDPROC

	PROCEDURE Unload
		IF USED('ChooseSales_No')
			USE IN ChooseSales_No
		ENDIF
		
		IF USED("Quotes")
			USE IN Quotes
		ENDIF
		
		= SQLDISCONNECT( ThisForm.ConnHandle )
		
		IF ThisForm.pWhat = "ChooseSO"
			RETURN ThisForm.HoldNumber
		ENDIF
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdFind.Click
		IF ThisForm.txtSalesOrder.Value > 0
			SELECT ChooseSales_No
			*SEEK ThisForm.txtSalesOrder.Value ORDER SalesNum
			LOCATE FOR SalesNum = ThisForm.txtSalesOrder.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				ThisForm.txtSalesOrder.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
			ThisForm.grdSales_No.Refresh
		*	ThisForm.grdSales_No.SetFocus
			ThisForm.RefreshScreen()
			ThisForm.grdSales_No.clmSO.SetFocus()
		ELSE
			WAIT WINDOW "Enter Number to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE cmdItem.Click
		
		PRIVATE nSO
		nSO = PrepareSQLnum(ThisForm.txtSalesNum.Value,'SalesNum',-3)
		DO FORM Forms\Select_SO-item WITH nSO
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF ThisForm.pWhat = "ChooseSO"
			ThisForm.HoldNumber = Choosesales_No.SalesNum
			ThisForm.Release
		ELSE
		
			PRIVATE cSQL, nSQLEXEC
		
			IF USED("Quotes")
				SELECT Quotes
			ELSE
				SELECT 0
			ENDIF
		
			cSQL="SELECT * FROM dbo.AllQuotes WHERE SalesNum = "+ALLTRIM(STR(ChooseSales_No.Salesnum))
		
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'Quotes')
			ENDIF
			
			DO FORM Forms\EditSalesOrder WITH ChooseSales_No.Salesnum
			*DO FORM Forms\EnterOrder WITH ChooseSales_No.Salesnum
			*DO FORM Forms\EditOrderFS WITH Choosesales_No.SalesNum
		
			*DO FORM Forms\EnterOrder WITH ChooseSales_No.Salesnum, .T. &&No Edit
		ENDIF
	ENDPROC

	PROCEDURE cmdViewTrack.Click
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpSOtrack")
			SELECT tmpSOtrack
		ELSE
			SELECT 0
		ENDIF
		
		nSalesNum = ChooseSales_No.Salesnum
		
		cSQL = "Select mess1, errordate, Machine FROM dbo.NR_UserTrack WHERE mess1 LIKE '%"+ ALLTRIM(STR(nSalesNum)) +"%' "
		cSQL = cSQL + " AND mess1 NOT LIKE 'Quote was cloned to %'"
		cSQL = cSQL + " ORDER BY ErrorDate DESC"
		
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpSOtrack')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpSOtrack')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'tmpSOtrack')
		ENDIF
		
		IF USED('tmpSOtrack')
			IF RECCOUNT('tmpSOtrack') > 0
				BROWSE
			ELSE
				MESSAGEBOX("Not Found",64,"No Data")
			ENDIF
		ENDIF
			
		
	ENDPROC

	PROCEDURE grdSales_No.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshScreen
	ENDPROC

	PROCEDURE txtSalesOrder.Valid
		IF !EMPTY(THIS.Value)
			*ThisForm.cmdFind.Click
			SELECT ChooseSales_No
			*SEEK THIS.Value ORDER SalesNum
			LOCATE FOR SalesNum = This.Value
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
				THIS.Value = ChooseSales_No.SalesNum
				ThisForm.txtSalesOrder.Refresh
			ENDIF
		*	ThisForm.grdSales_No.Refresh
		*	ThisForm.grdSales_No.SetFocus
			ThisForm.RefreshScreen()
		ENDIF
	ENDPROC

ENDDEFINE
