	PROCEDURE lstRID.Click
		Thisform.ShowReceiving(This.Value)
		
		
	ENDPROC

	PROCEDURE txtRejectPC.Valid
		PRIVATE cSOitem, nSalesNum, nItemSo
		PRIVATE nDec
		nDec = SET("DECIMAL")
		SET DECIMAL TO 0
		
		nSalesNum = This.Value
		IF TYPE("nSalesNum") = "C"
			nSalesNum = VAL(nSalesNum)
		ENDIF
		*This.Parent.
		nItemSo = ThisForm.pf.pg_Add.txtSOItem.Value
		IF TYPE("nItemSo") = "C"
			nItemSo = VAL(nItemSo)
		ENDIF
		cSOitem = STR(nSalesNum,7,0)+"-"+IIF(nItemSo<10,"0"+STR(nItemSo,1,0),+STR(nItemSo,2,0))
		
		
		PRIVATE nHpaPo, nItemPo
		nHpaPo = ThisForm.pf.pg_Add.txtHpaPONum.Value
		IF TYPE("nHpaPo") = "C"
			nHpaPo = VAL(nHpaPo)
		ENDIF
		nItemPo = ThisForm.pf.pg_Add.txtHpaPOItem.Value
		IF TYPE("nItemPo") = "C"
			nItemPo = VAL(nItemPo)
		ENDIF
		SET DECIMAL TO nDec
		
		IF nSalesNum > 0 AND nHpaPo=0 AND nItemPo=0
			ThisForm.GetSoItemDetail(cSOitem)
		ENDIF
	ENDPROC

ENDDEFINE
