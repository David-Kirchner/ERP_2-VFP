	PROCEDURE cmdEditStockLst.Click
		*Visible for No Stock ID
		
		PRIVATE nReceivingID,cPOItem,cComments,dDate,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,cDescription,nPieces,nRMA, nActualW 
		
		nReceivingID	= receiving.ID
		cPOItem			= receiving.POitem
		cComments		= receiving.Comments
		dDate			= receiving.Date
		dReceived		= receiving.Received
		cInit			= receiving.Init
		cHeat			= receiving.Heat
		lCert			= receiving.Cert
		cSOitem			= receiving.SOitem
		cVendor			= receiving.Vendor
		cComments		= receiving.Comments
		cDescription	= receiving.Description
		nPieces			= receiving.Pieces
		nRMA 			= receiving.RMA_No
		nActualW		= receiving.ActualW
		nR_QTY			= PrepareSQLnum(receiving.R_QTY,'R_QTY',-5)
		
		PRIVATE nID_Master, cTBL
		nID_Master = 0 &&PrepareSQLnum(ThisForm.pf.pgEdit.txtStkID.Value,'ID',-3)
		cTBL = ''  &&UPPER(PrepareSQLtxt(ThisForm.pf.pgEdit.txtStkID.Value,'TBL',1))
		*Receiving.StockTable
		*Receiving.ID_Master
		
		IF nReceivingID > 0
			PRIVATE lAlready_Saved, lFoundStockUpdateReceiving,lCompleteReceive
			lAlready_Saved = .F.
			lFoundStockUpdateReceiving = .F.
			nPOcomplete = 0
			
			*Open PO Receive StockLst window
			ThisForm.SaveAdd_PurchaseOrder(nReceivingID,cPOItem,cComments,cDescription,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA,lAlready_Saved ,nActualW, lFoundStockUpdateReceiving,nPOcomplete )
		
			*Save info to current table - otherwise you will need to reload table data.
			PRIVATE cStkTable_MasterID, cStkTable, cStkTable_MasterID2
			cStkTable_MasterID = Get_STK_MasterID_by_ReceivingID(nReceivingID,ThisForm.nConnHandle)
			cStkTable	= PrepareSQLtxt(LEFT(cStkTable_MasterID,1),'StockTable',1)
			
			cStkTable_MasterID2 = RIGHT(cStkTable_MasterID,LEN(cStkTable_MasterID)-1)
			cStkTable_MasterID2 = VAL(cStkTable_MasterID2)
			nID_Master	= PrepareSQLnum(cStkTable_MasterID2,'ID',-3)
			
			IF nID_Master = 0
				This.Visible = .T.
			ELSE
				This.Visible = .F.
				
		*!*			PRIVATE cSQLu 
		*!*			cSQLu = "UPDATE dbo.Receiving SET"
		*!*			cSQLu = cSQLu +" StockTable = '"+cStkTable+"'"
		*!*			cSQLu = cSQLu +" ID_Master = "+STR(nID_Master)
		*!*			cSQLu = cSQLu +" WHERE ID = "+STR(nReceiveID)
		*!*			
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Quotes")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Quotes")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQLu,ThisForm.nConnHandle, nSQLEXEC, '')
		*!*			ENDIF
				
				ThisForm.ReceivingRefreshReceiving()
		
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdPrintPO.Valid
		PRIVATE nHpaPo, lClosePurchaseOrder, lCloseShipAddr
		lClosePurchaseOrder = .F.
		lCloseShipAddr = .F.
		
		nHpaPo = PrepareSQLnum(THIS.PARENT.txtHpapo.VALUE,'HPApo',-3)
				
		IF USED('PurchaseOrder')
			USE IN PurchaseOrder
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE HPAPO = "+STR(nHPAPO)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PurchaseOrder')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PurchaseOrder' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PurchaseOrder")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpRIDs
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PurchaseOrder")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'PurchaseOrder' )
		ENDIF
		
		lClosePurchaseOrder = .T.
		
		PRIVATE lFoundVendor
		*SEEK UPPER(PurchaseOrder.Company) IN VENDOR ORDER TAG UPPCompany
		lFoundVendor = SelectVendor(PurchaseOrder.VendCode, PurchaseOrder.Company, ThisForm.nConnHandle)
		
		
		IF !USED('ShipAddr')
		*		USE HPA!ShipAddr IN 0
			lCloseShipAddr = .T.
		ENDIF
		*SELECT ShipAddr
		*SEEK PurchaseOrder.POShipAddr IN ShipAddr ORDER TAG ShipCode
		
		IF USED( 'ShipAddr' )
			USE IN ShipAddr
		ENDIF
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT * FROM dbo.ShipAddr "
		cSQL = cSQL + " WHERE ShipCode = "+STR(PurchaseOrder.POShipAddr)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpRIDs
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ShipAddr'  )
		ENDIF
		
		**Get VendorContact **
		SelectVendorContact(PurchaseOrder.ContactID,ThisForm.nConnHandle)
		
		SELECT purchaseOrder
		IF nHpaPo > 0
		
			REPORT FORM reports\PurchaseOrder14.FRX FOR purchaseOrder.HpaPo = nHpaPo PREVIEW
			*NOCONSOLE TO PRINTER
		
		ELSE
			MESSAGEBOX("No ERP PO Number!!!")
		ENDIF
		
		IF lClosePurchaseOrder
			IF USED('PurchaseOrder')
				USE IN purchaseOrder
			ENDIF
		ENDIF
		IF lCloseShipAddr
			IF USED('ShipAddr')
				USE IN ShipAddr
			ENDIF
		ENDIF
		IF USED('SoldAddr')	
			USE IN SoldAddr
		ENDIF
		
		IF USED('Vendor')
			USE IN Vendor
		ENDIF
		
		ThisForm.cmdReturn.SetFocus
		
		
	ENDPROC

	PROCEDURE cmdPrintPO.When
		
			IF EMPTY(THIS.PARENT.txtHpapo.VALUE)
				WAIT WINDOW 'Enter PO first' NOWAIT
				RETURN .F.
			ENDIF
		
			IF THIS.PARENT.txtItemPo.VALUE < 1
				=MESSAGEBOX("Item must be larger than 0",16,"Invalid input")
				RETURN .F.
			ENDIF
		
			IF EMPTY(ALLTRIM(THIS.PARENT.txtCompany.VALUE))
				=MESSAGEBOX("Purchase Order needs the Company Purchased from entered.",16,"Invalid input")
				RETURN .F.
			ENDIF
		
	ENDPROC

