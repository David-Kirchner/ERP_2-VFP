		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		*IF WEXIST("frmStockLst_SQL_Quotes")
		*	ACTIVATE WINDOW frmStockLst_SQL_Quotes
		*ENDIF
		
	ENDPROC

	PROCEDURE chkCancel.Click
		PRIVATE lCancelled, lCancelClick, nReceivingID
		lCancelled 	= PrepareSQLlogic(Receiving.Cancelled,'Cancelled')
		lCancelClick = PrepareSQLlogic(This.Value,'Cancelled')
		nReceivingID = PrepareSQLnum(Receiving.ID,'ReceivingID',-3)
		
		IF nReceivingID < 1
			MESSAGEBOX("Lost Receiving ID.",16,"Cannot continue")
			RETURN .F.
		ENDIF
		
		PRIVATE nMess, cMess, cSQL, nSQLEXEC
		
		IF lCancelClick 
			nMess = MESSAGEBOX("Are you sure you want to Cancel this Receive?",32+4,"Cancel Receive?")
			IF nMess = 6
				
				cSQL = "UPDATE dbo.Receiving SET "
				cSQL = cSQL + " [Cancelled] = 1"
				cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as Cancelled for ID="+ALLTRIM(STR(nReceivingID))+" in Receiving" )
					ThisForm.cmdDeleteReceiving.Enabled = .T.
					MESSAGEBOX("The Delete Receiving Record is now available.",0+48,"Delete")			
				ENDIF
			ENDIF
		ELSE
			nMess = MESSAGEBOX("Are you sure you want to UN-Cancel this Receive?",32+4,"UN Cancel Receive?")
			IF nMess = 6
				
				cSQL = "UPDATE dbo.Receiving SET "
				cSQL = cSQL + " [Cancelled] = 0"
				cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as UNCancelled for ID="+ALLTRIM(STR(nReceivingID))+" in Receiving" )
					ThisForm.cmdDeleteReceiving.Enabled = .F.
				ENDIF
			ENDIF
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE chkPOcomplete.Valid
		*Change Similar code in Ship - SO complete
		
		*IF MESSAGEBOX("Are you sure you want to change this PO?",4+32,"Change PO Status") = 6  &&Yes
		
		
		
		PRIVATE lComplete, cPOitem, dReceived, cSQL, nSQLEXEC
		lComplete	= PrepareSQLlogic(This.Value,'Complete',.F.)
		cPOitem 	= Receiving.POitem
		dReceived	= PrepareSQLdate(Receiving.Received,'Received')
		
		IF EMPTY(dReceived)
			dReceived = DATE()
		ENDIF
		
		IF NOT lComplete 
			IF MESSAGEBOX("Are you sure you want to mark POitem:"+ALLTRIM(cPOitem)+" as Complete?",4+32,"Mark as Complete?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [Delivered] = 1"
				cSQL = cSQL +",Received = '"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"	
				cSQL = cSQL + " WHERE POitem= dbo.f_ProperPOitem('"+cPOitem+"')"
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as Complete for POitem="+ALLTRIM(cPOitem)+" in PurchaseOrder" )
					
		*!*	*TRIGGER [dbo].[PurchaseOrder_After_Update] ON dbo.PurchaseOrder  		
		*!*	IF UPDATE([Delivered])  
		*!*		IF EXISTS (SELECT * FROM inserted WHERE inserted.Delivered = 1) 
		*!*			BEGIN
		*!*			DELETE FROM dbo.BrokerLst_Process
		*!*				FROM inserted
		*!*				WHERE inserted.POitem = BrokerLst_Process.PO_item 
		*!*				AND BrokerLst_Process.Process_ID = 'INCOMING  '
		*!*				AND inserted.Delivered = 1
		*!*			DELETE FROM dbo.StockLst_Process
		*!*				FROM inserted
		*!*				WHERE inserted.POitem = StockLst_Process.PO_item 	
		*!*				AND StockLst_Process.Process_ID = 'INCOMING  '
		*!*				AND inserted.Delivered = 1
		
						
					*ENDIF
				ENDIF
				
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ELSE
			IF MESSAGEBOX("Are you sure you want to UNmark POitem:"+ALLTRIM(cPOitem)+" as Complete?",4+32,"Mark as NOT Complete?") = 6
		
				cSQL = "UPDATE dbo.PurchaseOrder SET "
				cSQL = cSQL + " [Delivered] = 0"
				cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					TrackMess( "Marked as NOT Complete for POitem="+ALLTRIM(cPOitem)+" in Ship table, Ship screen" )
					
		
				ENDIF
				
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
	ENDPROC

