	PROCEDURE Label6.Click
		PRIVATE m.dDate1,m.dDate2
		
		m.dDate1 = This.Parent.txtNotified.Value
		DO FORM "forms\popupdate.scx" WITH m.dDate1 TO m.dDate2
		This.Parent.txtNotified.Value = m.dDate2
		This.Parent.txtNotified.Refresh
		This.Parent.txtNotified.SetFocus
		
		
	ENDPROC

	PROCEDURE Label7.Click
		PRIVATE cSOitem, nSO
		PRIVATE lCloseAllQuotes, lCloseQuotes
		lCloseAllQuotes = .F.
		lCloseQuotes = .F.
		
		PRIVATE nDec
		nDec = SET("DECIMAL")
		SET DECIMAL TO 0
		
		cSOitem = Proper_SO_Item( Receiving.SOitem )
		nSO = VAL( LEFT( cSOitem,7) )
		
		SET DECIMAL TO nDec
		
		IF nSO > 0
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_SO(nSO,.T.) &&lReturnURL --not URL is an HTML code.
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
		
		*	loIE.Navigate(get_Report_Server()+"%2fHPA+Sales+Reports%2fSalesOrders&rs:Command=Render&soNum="+ALLTRIM(STR(nSO)) )
			WAIT WINDOW "Look for a blinking Internet Explorer!" NOWAIT
			
		ENDIF
	ENDPROC

	PROCEDURE Label7.DblClick
		PRIVATE cSOitem, nSO
		PRIVATE lCloseAllQuotes, lCloseQuotes
		lCloseAllQuotes = .F.
		lCloseQuotes = .F.
		
		PRIVATE nDec
		nDec = SET("DECIMAL")
		SET DECIMAL TO 0
		
		cSOitem = Proper_SO_Item( Receiving.SOitem )
		nSO = VAL( LEFT( cSOitem,7) )
		
		SET DECIMAL TO nDec
		
		IF nSO > 0
			PRIVATE cSQL, nSQLEXEC
		
			IF !USED("AllQuotes")
				USE AllQuotes IN 0 SHARED
				lCloseAllQuotes = .T.
			ENDIF
			
			IF USED("Quotes")
				SELECT Quotes
			ELSE
				lCloseQuotes = .T.
				SELECT 0
			ENDIF
		
			cSQL="SELECT * FROM dbo.AllQuotes WHERE SalesNum = "+ALLTRIM(STR(nSO))
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Quotes')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Quotes')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Quotes")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Quotes")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'Quotes')
			ELSE
				DO FORM Forms\EDITSALESORDER WITH nSO
				*DO FORM Forms\EnterOrder WITH nSO 
				*DO FORM Forms\EditOrderFS WITH nSO 
			ENDIF
			
			IF lCloseQuotes 
				IF USED("Quotes")
					USE IN Quotes
				ENDIF
			ENDIF
			IF lCloseAllQuotes 
				IF USED("AllQuotes")
					USE IN AllQuotes
				ENDIF
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE lblHpaPOnum.Click
		PRIVATE nPO
		nPO = VAL(LEFT( Receiving.POitem ,9))
		
		IF NOT EMPTY(nPO)
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_PO(nPO,.T.) &&lReturnURL --not URL is an HTML code.
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
		
		-	loIE.Navigate(get_Report_Server()+"%2fHPA+Purchasing+Reports%2fPurchaseOrders&rs:Command=Render&hpapo="+ALLTRIM(STR(nPO)) )
			WAIT WINDOW "Look for a blinking Internet Explorer!" NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE lblHpaPOnum.DblClick
		PRIVATE nPOnum
		
		nPOnum = VAL(LEFT( Receiving.POitem ,9))
		
		
		IF NOT EMPTY(nPOnum )
			DO FORM Forms\PurchaseOrder.scx WITH nPOnum 
		ENDIF
	ENDPROC

	PROCEDURE lblSOnum.Click
		PRIVATE cSOitem, nSO
		PRIVATE lCloseAllQuotes, lCloseQuotes
		lCloseAllQuotes = .F.
		lCloseQuotes = .F.
		
		PRIVATE nDec
		nDec = SET("DECIMAL")
		SET DECIMAL TO 0
		
		cSOitem = Proper_SO_Item( Receiving.SOitem )
		nSO = VAL( LEFT( cSOitem,7) )
		
		SET DECIMAL TO nDec
		
		IF nSO > 0
		
			WAIT WINDOW "Look for a blinking Internet Explorer!" NOWAIT
			PRIVATE loHyperlink
			loHyperlink = Createobject("Hyperlink")
		
			loHyperlink.NavigateTo(get_Report_Server()+"%2fHPA+Sales+Reports%2fSalesOrders&rs:Command=Render&soNum="+ALLTRIM(STR(nSO)) )
			RELEASE loHyperlink
		ENDIF
	ENDPROC

