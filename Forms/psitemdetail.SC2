	PROCEDURE Destroy
		IF USED('tmpPSItemDone')
			USE IN tmpPSItemDone
		ENDIF
		
	ENDPROC

	PROCEDURE getsoitemdesc
		PARAMETERS cSOitem
		*ThisForm.getSOitemDesc()
		
		PRIVATE cDescript
		cDescript = ''
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		
		IF USED('tmpDescript')
			SELECT tmpDescript
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT Pieces,dbo.f_DescriptCL(Alloy,CC,CL,Form,Thck,Sz2,Sz3,Weight,RandLen) AS Descript FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDescript')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpDescript')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDescript")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDescript")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpDescript')
		ENDIF
		
		
		IF USED('tmpDescript')
			IF RECCOUNT('tmpDescript') > 0
				IF VARTYPE(tmpDescript.Pieces) = "N"
					cDescript = ALLTRIM(STR(tmpDescript.Pieces))
					
					DO CASE 
					CASE tmpDescript.Pieces = 0
						cDescript = ALLTRIM(tmpDescript.Descript)
					CASE tmpDescript.Pieces = 1
						cDescript = cDescript + " PC "+ALLTRIM(tmpDescript.Descript)
					OtherWise
						cDescript = cDescript + " PCs "+ALLTRIM(tmpDescript.Descript)
					ENDCASE
				ENDIF
			ENDIF
			USE IN tmpDescript
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN cDescript 
		
	ENDPROC

	PROCEDURE get_shippedpcs
		PARAMETERS cSOitem
		*get_ShippedPcs(tmpPSItem.SOItem)
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE nPCShip, nPCSold
		nPCShip = 0
		nPCSold = 0
		
		******************************
		
		IF USED('tmpPCSold')
			SELECT tmpPCSold
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT Pieces FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPCSold')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPCSold')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPCSold")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPCSold")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpPCSold')
		ENDIF
		
		
		IF USED('tmpPCSold')
			IF RECCOUNT('tmpPCSold') > 0
				IF VARTYPE(tmpPCSold.Pieces) = "N"
					nPCSold = tmpPCSold.Pieces
				ENDIF
			ENDIF
			USE IN tmpPCSold
		ENDIF
		
		
		
		
		*******************************
		
		IF USED('tmpSumPCS')
			SELECT tmpSumPCS
		ELSE
			SELECT 0
		ENDIF
		
		cSQL="SELECT SUM(qshipped) AS PCShip FROM dbo.Ship "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		cSQL = cSQL + " AND ISNULL(Cncld,0) = 0"
		cSQL = cSQL + " AND ISNULL(Complete,0) = 0"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSumPCS')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSumPCS')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSumPCS")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSumPCS")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSumPCS')
		ENDIF
		
		
		IF USED('tmpSumPCS')
			IF RECCOUNT('tmpSumPCS') > 0
				IF VARTYPE(tmpSumPCS.PCShip) = "N"
					nPCShip = tmpSumPCS.PCShip
				ENDIF
			ENDIF
			USE IN tmpSumPCS
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		RETURN nPCSold - nPCShip 
	ENDPROC

	PROCEDURE Init
		
		IF NOT USED('tmpPSitem')
			RETURN .F.
			*Created in PackingSlip.scx
			*USE (SYS(5)+SYS(2003)+"\"+ThisForm.Uniq_PSItem) EXCL ALIAS tmpPSItem
		ENDIF
		*ThisForm.GrdComplete.clmPcs.Text1
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"tmpPSItem") FREE ;
		*(SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12), Form C(2), Heat C(50), CC C(1), CL, DESCRIPT C(80), Weight N(7,1), Kg L, PackWeight N(7,1);
		*,Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3),RandLen L,Metric L, PO_num C(17), PackingSli N(10);
		*,PartNo C(100),tmpPSnum N(10), SOi_cmplt L )
		
		ThisForm.grdtmpPSItem.clmPcs.ControlSource 		= "tmpPSItem.Pcs"
		ThisForm.grdtmpPSItem.clmHeat.ControlSource 	= "tmpPSItem.Heat"
		ThisForm.grdtmpPSItem.clmLot.ControlSource 		= "tmpPSItem.Lot"
		ThisForm.grdtmpPSItem.clmDescript.ControlSource	= "tmpPSItem.Descript"
		ThisForm.grdtmpPSItem.clmWeight.ControlSource 	= "tmpPSItem.Weight"
		
		ThisForm.ReturnLPosted = .F.
		ThisForm.txtSOItem.Value	= tmpPSItem.SOItem
		ThisForm.txtAlloy.Value		= tmpPSItem.Alloy
		ThisForm.txtSS_ID.Value		= tmpPSItem.SS_ID
		ThisForm.lblAQDescript.Caption = tmpPSItem.AQDescript
		ThisForm.txtPO_Num.Value	= tmpPSItem.PO_Num
		ThisForm.txtHeat.Value = tmpPSItem.Heat
		
		
		
		
		*tmpPSItemDone SELECT Pcs,Heat,Descript,Weight,Kg FROM dbo.PackingSlip 
		ThisForm.grdComplete.RecordSource ='tmpPSItemDone'
		ThisForm.grdComplete.clmPcs.ControlSource 		= "tmpPSItemDone.Pcs"
		ThisForm.grdComplete.clmHeat.ControlSource 		= "tmpPSItemDone.Heat"
		ThisForm.grdComplete.clmLot.ControlSource 		= "tmpPSItemDone.Lot"
		ThisForm.grdComplete.clmDescript.ControlSource	= "tmpPSItemDone.Descript"
		ThisForm.grdComplete.clmWeight.ControlSource 	= "tmpPSItemDone.Weight"
		
		ThisForm.txtDescription.Value = ThisForm.getSOitemDesc(tmpPSItem.SOItem)
		
		*!*	SELECT tmpPSItem
		*!*	SCAN
		*!*		ThisForm.RefreshDescription()
		*!*	ENDSCAN
		*!*	GO TOP
		
		IF ThisForm.PSItemsDone > 0
			ThisForm.grdComplete.Enabled = .T.
			ThisForm.grdComplete.Visible = .T.
			ThisForm.lblComplete.Visible = .T.
		ELSE
			ThisForm.grdComplete.Enabled = .F.
			ThisForm.grdComplete.Visible = .F.
			ThisForm.lblComplete.Visible = .F.
		ENDIF
		
		SELECT 0
		IF Count_SOIteminSales(tmpPSItem.SOItem, ThisForm.nConnHandle) > 0
			*Populate PartNo
			ThisForm.txtPartNo.Value = get_PartNoinSales(tmpPSItem.SOItem,ThisForm.nConnHandle)
		ENDIF
		
		IF USED('tmpPSItemDone')
			GO TOP IN tmpPSItemDone
			
			*Mark the Kg flag if Customer wants weight also reported in Kg
			IF VARTYPE(tmpPSItemDone.Kg) = "L"
				ThisForm.chkKg.Value = PrepareSQLchk(tmpPSItemDone.Kg,'KG')
			ENDIF
		ENDIF
		
		ThisForm.LockScreen = .F.
		
		*ThisForm.ParseDescription()
		ThisForm.RefreshPSitem()
		ThisForm.RefreshForms()
		ThisForm.RefreshTotals()
		
		Select tmpPSItem 
		ThisForm.RefreshDescription()
		
		ThisForm.PCs1.SetFocus
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		IF !USED("tmpPSItem")
			MESSAGEBOX("Table 'tmpPSItem' was not ready")
			RETURN TO MASTER
		ENDIF 
		
		IF EMPTY(tmpPSItem.SOItem)
			MESSAGEBOX("Lost SO-Item."+CHR(13)+"If you continue, you will see incorrect data.",16,"SQL Error")
		ENDIF
		
		ThisForm.PSItemsDone = Count_SOiteminPackingSlip( tmpPSItem.SOItem,ThisForm.nConnHandle )
		
		
		**************************************************
		IF USED('tmpPSItemDone')
			USE IN tmpPSItemDone
		ENDIF
		
		SELECT 0
		cSQL = "SELECT Pcs,Heat,Lot,Descript,Weight,Kg FROM dbo.PackingSlip "
		cSQL = cSQL + " WHERE PackingSlip.SOItem = dbo.f_ProperSOitem('"+tmpPSItem.SOItem+"')  AND PackingSlip.Cancld = 0"
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPSItemDone')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPSItemDone')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDone")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDone")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle)
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE parsedescription
		*ThisForm.ParseDescription()
		*PARAMETER cDescript
		
		IF LEN(ALLTRIM(tmpPSitem.Descript)) < 10
			RETURN .F.
		ENDIF
		
		PRIVATE cDescript, cDescriptOrig
		cDescript = tmpPSitem.Descript
		cDescriptOrig = cDescript
		* cDescript = [SHEET: 0.062" Thick x 1.375" x 120"]
		* cDescript = [BAR: 0.25"Dia x 13 FT]
		
		IF AT(":",cDescript) = 0
			RETURN .F.
		ENDIF
		
		PRIVATE cForm, nDim1, nDim2, nDim3, lRandLen
		PRIVATE cDim1, cDim2, cDim3, nFT, nInch
		cForm	= LEFT(cDescript,AT(":",cDescript)-1)
		cDescript = RIGHT(cDescript,LEN(cDescript)-1-AT(":",cDescript))
		cDim1 	= LEFT(cDescript,AT('"',cDescript)-1 )
		nDim1	= VAL(cDim1)
		cDescript = RIGHT(cDescript,LEN(cDescript)-1-AT("x",cDescript))
		
		nFT		= AT("FT",cDescript) 
		nInch 	= AT(["],cDescript)
		IF nFT > 0
			IF nInch > 0
				IF nFT < nInch
					*Use Foot
					cDim2 	= LEFT(cDescript,AT('FT',cDescript)-1 )
					nDim2	= VAL(cDim2)*12
				ELSE
					cDim2 	= LEFT(cDescript,AT('"',cDescript)-1 )
					nDim2	= VAL(cDim2)
				ENDIF
			ELSE
				*No inch, Use Foot
				cDim2 	= LEFT(cDescript,AT('FT',cDescript)-1 )
				nDim2	= VAL(cDim2)*12
			ENDIF
		ELSE
			*No Foot use inch
			cDim2 	= LEFT(cDescript,AT('"',cDescript)-1 )
			nDim2	= VAL(cDim2)
		ENDIF
		
		IF AT("x",cDescript) > 0
			*have 3rd dim
			cDescript = RIGHT(cDescript,LEN(cDescript)-1-AT("x",cDescript))
		
			nFT		= AT("FT",cDescript) 
			nInch 	= AT(["],cDescript)
			IF nFT > 0
				IF nInch > 0
					IF nFT < nInch
						*Use Foot
						cDim3 	= LEFT(cDescript,AT('FT',cDescript)-1 )
						nDim3	= VAL(cDim3)*12
					ELSE
						cDim3 	= LEFT(cDescript,AT('"',cDescript)-1 )
						nDim3	= VAL(cDim3)
					ENDIF
				ELSE
					*No inch, Use Foot
					cDim3 	= LEFT(cDescript,AT('FT',cDescript)-1 )
					nDim3	= VAL(cDim3)*12
				ENDIF
			ELSE
				*No Foot use inch
				cDim3 	= LEFT(cDescript,AT('"',cDescript)-1 )
				nDim3	= VAL(cDim3)
			ENDIF
		ELSE
			nDim3 = 0
		ENDIF
		lRandLen = [R/L] $ cDescriptOrig
		
		
		
		WAIT WINDOW cDescriptOrig+CHR(13)+"Form:"+FormNumber_FormDescription(cForm)+" "+cForm+CHR(13)+"Dim1:"+STR(nDim1,14,4)+CHR(13)+"Dim2:"+STR(nDim2,14,4)+CHR(13)+"Dim3:"+STR(nDim3,14,4)+CHR(13)+"RandLen:"+IIF(lRandLen,"Y","N") NOWAIT
		
		ThisForm.cmbForm.Value	= FormNumber_FormDescription(cForm)
		ThisForm.Thck1.Value	= Remove0(nDim1,14,4)
		ThisForm.Sz21.Value		= Remove0(nDim2,14,3)
		ThisForm.Sz31.Value		= Remove0(nDim3,14,3)
		ThisForm.chkRL.Value	= lRandLen
		
		
	ENDPROC

	PROCEDURE refreshdescription
		*ThisForm.RefreshDescription()
		
		PRIVATE cAlloy,nPCs
		PRIVATE cForm, nDim1, nDim2, nDim3,lRandLen,lMetric,nLBS,nQTY,nHPA_QTY
		cAlloy	= ThisForm.txtAlloy.Value
		cCC 	= ThisForm.txtCC.Value
		cCL 	= ThisForm.txtCL.Value
		nPCs	= ThisForm.PCS1.Value
		cForm	= ThisForm.cmbForm.Value
		nDim1	= ThisForm.Thck1.Value
		nDim2	= ThisForm.Sz21.Value
		nDim3	= ThisForm.Sz31.Value
		lRandLen= ThisForm.chkRL.Value
		lMetric	= tmpPSItem.Metric
		nLBS	= PrepareSQLnum(ThisForm.LBS1.Value,'LBS',7,1)
		nQTY	= PrepareSQLnum(ThisForm.QTY1.Value,'QTY',18,4)
		nHPA_QTY= PrepareSQLnum(ThisForm.HPA_QTY.Value,'S_QTY',18,4)
		
		PRIVATE cSOitem
		cSOitem = tmpPSitem.SOitem
		
		IF nLBS = 0
			*No Description weight!
			IF USED('tmpPriceTbl')
				USE IN tmpPriceTbl
			ENDIF
			SELECT 0
		
			PRIVATE cSQL
			cSQL = "EXEC dbo.p_GetFullQuote "
			cSQL = cSQL + STR(nPCs)
			cSQL = cSQL + ",'"+cAlloy+"'"
			cSQL = cSQL + ",'"+cForm+"'"
			cSQL = cSQL + ",'1'"
			cSQL = cSQL + ","+STR(PrepareSQLnum(nDim1,'nThck',14,4),10,4)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nDim2,'Sz2',12,3),9,3)
			cSQL = cSQL + ","+STR(PrepareSQLnum(nDim3,'nSz3',12,3),9,3)
			cSQL = cSQL + ",0" &&Force Bracket
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPriceTbl')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpPriceTbl')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPriceTbl")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPriceTbl")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpPriceTbl')
			ENDIF
		
			IF USED('tmpPriceTbl')
				*nLBS = ROUND(tmpPriceTbl.Pounds,1)
				nLBS = PrepareSQLnum(tmpPriceTbl.Pounds,'Pounds',9,1)
				ThisForm.LBS1.Value = nLBS
				ThisForm.LBS1.Refresh
				
				USE IN tmpPriceTbl
				
				SELECT tmpPSitem
				IF EMPTY(tmpPSitem.Weight)
					REPLACE tmpPSitem.Weight WITH nLBS		
				ENDIF
			ENDIF
			
		ENDIF
		
		****************
		PRIVATE nCalcQTY
		nCalcQTY = 0
		
		IF USED('tmpCalcQTY')
			USE IN tmpCalcQTY
		ENDIF
		SELECT 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.p_Get_HPA_UnitQty "
		cSQL = cSQL + STR(nPCs)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nDim1,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nDim2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nDim3,'nSz3',12,3),9,3)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCalcQTY')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCalcQTY')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCalcQTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCalcQTY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpCalcQTY')
		ENDIF
		
		IF USED('tmpCalcQTY')
			IF RECCOUNT('tmpCalcQTY')>0
				nCalcHPA_QTY = PrepareSQLnum(tmpCalcQTY.UnitQty,'S_QTY',-5)
			ENDIF
			USE IN tmpCalcQTY
		ENDIF
		
		IF nCalcQTY	> 0
			PRIVATE nMess
			IF NOT DELETED('tmpPSitem')
				IF (nCalcQTY+30) > (nHPA_QTY+30)*1.05 OR (nCalcQTY+30)*1.05 < (nHPA_QTY +30)
		*			nMess = MESSAGEBOX("The listed HPA QTY is "+ALLTRIM(STR(nHPA_QTY,18,2))+CHR(13)+"The Calculated QTY is "+ALLTRIM(STR(nCalcQTY ,18,2))+CHR(13)+"Do you want to use the Calculated ?", 4+32, "Replace with Calulated QTY")
		*			IF nMess = 6
						
		*				SELECT tmpPSitem
		*				REPLACE tmpPSitem.SL_QTY WITH nCalcHPA_QTY 	
		*				ThisForm.HPA_QTY.Value = nCalcHPA_QTY
		*			ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		****************
		PRIVATE nCustomerQTY
		nCustomerQTY = 0
		
		IF USED('tmpCustQTY')
			USE IN tmpCustQTY
		ENDIF
		SELECT 0
		
		PRIVATE nCustPU, nCustomerQTY 
		nCustPU = 0
		
		PRIVATE cSQL
		cSQL = "EXEC dbo.p_Calc_Cust_UnitQty "
		cSQL = cSQL + STR(nPCs)
		cSQL = cSQL + ",'"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ","+STR(PrepareSQLnum(nDim1,'nThck',14,4),10,4)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nDim2,'Sz2',12,3),9,3)
		cSQL = cSQL + ","+STR(PrepareSQLnum(nDim3,'nSz3',12,3),9,3)
		cSQL = cSQL + ",'"+cSOitem+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCustQTY')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCustQTY')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCustQTY")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCustQTY")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpCustQTY')
		ENDIF
		
		IF USED('tmpCustQTY')
			IF RECCOUNT('tmpCustQTY')>0
				nCalcCust_QTY  = PrepareSQLnum(tmpCustQTY.UnitQty,'QTY',-5)
			ENDIF
			USE IN tmpCustQTY
		ENDIF
		
		IF nCalcCust_QTY 	> 0
			PRIVATE nCust_QTY, nMess
			nCust_QTY= PrepareSQLnum(ThisForm.QTY1.Value,'QTY',-5)
			IF NOT DELETED('tmpPSitem')
				IF nCalcCust_QTY  > nCust_QTY*1.05 OR nCalcCust_QTY *1.05 < nCust_QTY
					nMess = MESSAGEBOX("The listed Customers_QTY is "+ALLTRIM(STR(nCust_QTY,18,2))+CHR(13)+"The Calculated QTY is "+ALLTRIM(STR(nCalcCust_QTY ,18,2))+CHR(13)+"Do you want to use the Calculated ?", 4+32, "Replace with Calulated QTY")
					IF nMess = 6
						
						SELECT tmpPSitem
						REPLACE tmpPSitem.QTY WITH nCalcCust_QTY 	
						ThisForm.QTY1.Value = nCalcCust_QTY 
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		************	
		cFormDescription = ALLTRIM(FormDescription(cForm, nDim1))
		cDescript = ItemDescriptionMetric(cForm, nDim1, nDim2, nDim3, nLBS, lRandLen, lMetric)
		cDescript = PADL(TRIM(cFormDescription),11)+': '+cDescript
		
		SELECT tmpPSitem
		REPLACE tmpPSitem.Descript	WITH cDescript 
		
		ThisForm.RefreshTotals()
		
		ThisForm.grdtmpPSItem.Refresh
		
	ENDPROC

	PROCEDURE refreshforms
		*ThisForm.RefreshForms()
		
		PRIVATE lCurrentTable
		lCurrentTable = ALIAS()
		
		pForm = ThisForm.cmbForm.Value
			
		IF EMPTY(pForm)
			RETURN .F.
		ENDIF
		
		IF NOT EMPTY(pForm)
			IF GetFormCaptions(pForm,ThisForm.nConnHandle)
				IF USED('tmpFormCaptions')
					ThisForm.LBLTHCK1.Caption = RTRIM(tmpFormCaptions.txt1)
					ThisForm.LBLSZ21.Caption 	= RTRIM(tmpFormCaptions.txt2)
					ThisForm.LBLSZ21.Visible 	= tmpFormCaptions.lblSz2Vis
					ThisForm.LBLSZ31.Caption 	= RTRIM(tmpFormCaptions.txt3)
					ThisForm.LBLSZ31.Visible 	= tmpFormCaptions.lblSz3Vis
					ThisForm.SZ31.Visible 	= tmpFormCaptions.use3rdDim
					ThisForm.SZ31.Enabled 	= tmpFormCaptions.Sz3Enable
					ThisForm.LBLSZ41.Caption	= RTRIM(tmpFormCaptions.txt4)
					ThisForm.LBLSZ41.Visible 	= tmpFormCaptions.lblSz4Vis
					
					USE IN tmpFormCaptions
				ELSE
					TrackMess( "tmpFormCaptions is not used!")
				ENDIF
			ELSE
				TrackMess("GetFormCaptions returned False!")
			ENDIF
		ELSE
			TrackMess("GetFormCaptions did not have a Form!")
		ENDIF
		
		IF NOT EMPTY(lCurrentTable)
			IF USED(lCurrentTable)
				SELECT (lCurrentTable)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE refreshpsitem
		*ThisForm.RefreshPSitem()
		
		SELECT tmpPSitem
		ThisForm.txtSS_ID.Value	= tmpPSItem.SS_ID
		ThisForm.PCS1.Value		= tmpPSitem.PCs
		ThisForm.cmbForm.Value	= tmpPSitem.Form
		ThisForm.Thck1.Value	= tmpPSitem.Dim1
		ThisForm.Sz21.Value		= tmpPSitem.Dim2
		ThisForm.Sz31.Value		= tmpPSitem.Dim3
		ThisForm.chkRL.Value	= tmpPSitem.RandLen
		ThisForm.LBS1.Value		= tmpPSitem.Weight
		
		ThisForm.QTY1.Value		= tmpPSitem.QTY
		ThisForm.HPA_QTY.Value	= tmpPSitem.SL_QTY	&&ERP Acct Stnd
		
		ThisForm.lblAQDescript.Caption = tmpPSItem.Descript
		
		*ThisForm.txtPartNo.Value = tmpPSitem.PartNo
		*ThisForm.txtPO_Num.Value = tmpPSitem.PO_Num
		ThisForm.txtHeat.Value 	= tmpPSitem.Heat
		ThisForm.txtLot.Value	= tmpPSitem.Lot
	ENDPROC

	PROCEDURE refreshtotals
		*ThisForm.RefreshTotals()
		
		******* Add Sales_Stock Total ??????????????
		
		
		ThisForm.txtPQTY.Value	= 0
		ThisForm.txtPWeight.Value= 0
		ThisForm.txtSQTY.Value	= 0
		ThisForm.txtSWeight.Value= 0
		
		IF USED('tmpPSitem')
			IF RECCOUNT('tmpPSitem') =0
				ThisForm.txtPQTY.Value	= 0
				ThisForm.txtPWeight.Value=0
				ThisForm.txtSQTY.Value	= 0
				ThisForm.txtSWeight.Value=0
			ELSE
				
				PRIVATE nRecNum
				nRecNum = RECNO('tmpPSitem')
				
				PRIVATE nPWeight	
				nPWeight = 0
				
				PRIVATE cTalk 
				cTalk = SET('TALK')
				SET TALK OFF
				
				SELECT tmpPSitem
		
				SUM Weight TO nPWeight
				*AVERAGE QTY TO nPQTY
				SUM QTY TO nPQTY
				
				GOTO (nRecNum)
				
				IF cTalk = "ON"
					SET TALK ON
				ENDIF
				
				
				PRIVATE cSOitem, nSWeight, nSQTY
				cSOitem = tmpPSitem.SOitem
				nSWeight = 0
				nSQTY = 0
				
				PRIVATE cSQL, nSQLEXEC 
		
				IF USED("tmpSO_QTY")
					USE IN tmpSO_QTY
				ENDIF
		
				cSQL = "SELECT dbo.f_Get_Units(Pieces,Alloy,Form,Thck,Sz2,Sz3) AS QTY "
				cSQL = cSQL + ",Weight FROM dbo.AllQuotes WHERE "
				cSQL = cSQL + " SOItem = dbo.f_ProperSOitem('"+cSOItem+"')"
		
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisForm.nConnhandle, cSQL, 'tmpSO_QTY')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnhandle, cSQL, 'tmpSO_QTY')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_QTY")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_QTY")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, 'tmpSO_QTY')
				ENDIF
		
				IF USED("tmpSO_QTY")
					IF RECCOUNT('tmpSO_QTY') > 0
						nSWeight= tmpSO_QTY.Weight
						nSQTY	= tmpSO_QTY.QTY
					ENDIF
					USE IN tmpSO_QTY
				ENDIF
				
				ThisForm.txtPQTY.Value	= nPQTY
				ThisForm.txtPWeight.Value=nPweight
				
				ThisForm.txtSQTY.Value	= nSQTY
				ThisForm.txtSWeight.Value=nSWeight
				
			ENDIF		
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		IF ThisForm.ReturnLPosted
			Returned = "1"+ThisForm.PartNo
		ELSE
			Returned = "0"
		ENDIF
		RETURN Returned
		
	ENDPROC

	PROCEDURE chkRL.Click
		ThisForm.RefreshForms()
	ENDPROC

	PROCEDURE chkRL.Valid
		SELECT tmpPSitem
		REPLACE tmpPSitem.RandLen WITH This.Value
		
		ThisForm.RefreshDescription()
	ENDPROC

	PROCEDURE cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			SELECT FormCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
			SELECT * FROM FormCode INTO ARRAY aFormCode
			
			USE IN FormCode
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aFormCode)
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE cmbForm.Valid
		SELECT tmpPSitem
		REPLACE tmpPSitem.Form WITH This.Value
		
		ThisForm.RefreshForms()
		
	ENDPROC

	PROCEDURE cmdAbort.Click
		
		IF USED('tmpPSItem')
			SELECT tmpPSItem
			SCAN
				nTmpPSnum= PrepareSQLnum(tmpPSItem.tmpPSnum,'tmpPSnum',-3)
				IF nTmpPSnum > 0
					IF nTmpPSnum < 0
						*2147000000
						*use tmp Packing Slip
						
		*!*					cSQL = "UPDATE dbo.Sales_Stock SET PackingSli = 0 "
		*!*					cSQL = cSQL + " WHERE PackingSli ="+STR(nTmpPSnum)
		*!*					cSQL = cSQL + " AND ISNULL(Reconciled,0) = 0"
		*!*					
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		*!*					DO WHILE nSQLEXEC = 0
		*!*						WAIT WINDOW 'SQL' TIMEOUT 1
		*!*						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		*!*					ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDone")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDone")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*					IF nSQLEXEC < 0
		*!*						SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC )
		*!*					ELSE
		*!*						SELECT tmpSales_Stock 
		*!*						UPDATE tmpSales_Stock SET PackingSli=0 WHERE PackingSli = nTmpPSnum
		*!*					ENDIF
		
					ENDIF
				ENDIF
			ENDSCAN
		ENDIF
		*nPackingSli = *2147483647 0 - VAL( SYS(2) ) &&Seconds since Midnight
		*REPLACE tmpPSItem.PackingSli 	WITH nPackingSli 	
		
		
		ThisForm.ReturnLPosted = .F.
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdCopy.Click
		****************************
		*!*	CREATE TABLE (SYS(5)+SYS(2003)+"\"+"tmpPSItem") FREE ;
		*!*		(SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12), Form C(2),Heat C(50), CC C(1),CL C(1),DESCRIPT C(80), AQDescript C(50)
		*!*		, Weight N(7,1), Kg L, PackWeight N(7,1);
		*!*		,Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3),RandLen L,Metric L, PO_num C(17), PackingSli N(10);
		*!*		,PartNo C(100), QTY N(18,4), PU N(1), SS_ID N(10), tmpPSnum N(10)
		*!*		TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4), SOi_cmplt L )
		*,cTBL, nSL_ID, nSL_ID_D, nID_D_Proc, nSL_P, nSL_QTY &&ERP Acct Standard
		*,PS_QTY N(18,4) )
		
		
		SELECT tmpPSItem
		PRIVATE nMinSS_ID, nCurrSS_ID
		nCurrSS_ID = tmpPSItem.SS_ID
		
		SET TALK OFF
		
		CALCULATE MIN(SS_ID) TO nMinSS_ID
		
		LOCATE FOR SS_ID = nCurrSS_ID
		
		IF nMinSS_ID > 0
			nMinSS_ID = 0
		ENDIF
		nMinSS_ID = nMinSS_ID -1
		
		PRIVATE nPCs,cAlloy,cForm,nDim1,nDim2,nDim3
		
		SELECT tmpPSItem
		IF RECCOUNT("tmpPSItem") > 0
			SCATTER MEMVAR
			APPEND BLANK
			GATHER MEMVAR
			REPLACE SS_ID WITH nMinSS_ID 
			
			PRIVATE nPieces, nWeight, nPS_QTY, nHPA_QTY
			CALCULATE SUM(PCs)    TO nPieces  FOR NOT SS_ID = nMinSS_ID
			CALCULATE SUM(Weight) TO nWeight  FOR NOT SS_ID = nMinSS_ID
			CALCULATE SUM(QTY)    TO nPS_QTY  FOR NOT SS_ID = nMinSS_ID
			CALCULATE SUM(SL_QTY) TO nHPA_QTY FOR NOT SS_ID = nMinSS_ID
		
			LOCATE FOR SS_ID = nMinSS_ID 
			
			REPLACE PCs WITH PrepareSQLnum(ThisForm.txtSQTY.Value,'PQTY',-3) - nPieces
			REPLACE Weight WITH PrepareSQLnum(ThisForm.txtPWeight.Value,'PWeight',9,1) - nWeight
			
			PRIVATE nSL_QTY
			nSL_QTY = PrepareSQLnum(ThisForm.txtSQTY.Value,'S_QTY',-3) - nQTY 
			REPLACE SL_QTY WITH nSL_QTY
		
			nPCs	= tmpPSItem.PCs
			cAlloy	= tmpPSItem.Alloy
			cForm	= tmpPSItem.Form
			nDim1	= tmpPSItem.Dim1
			nDim2	= tmpPSItem.Dim2
			nDim3	= tmpPSItem.Dim3
		ELSE
			APPEND BLANK
		ENDIF
		
		****************************
		SELECT tmpPSItem
		
		DO CASE 
		CASE EMPTY(tmpPSItem.TBL)
			*Look for Stock or Broker
			
		CASE tmpPSItem.TBL="S"
			*Choose more Stock!
			* Get new nSL_ID, nSL_ID_D, nID_D_Proc, nSL_P, nSL_QTY
			
		CASE tmpPSItem.TBL="B"
			*Just spread QTY around.
			*keep nSL_ID, nSL_ID_D, nID_D_Proc, nSL_P, nSL_QTY
		ENDCASE
			
		GO BOTTOM
		
		************************
		
		*!*	PRIVATE nCalcQTY
		*!*	nCalcQTY = 0
		
		*!*	IF USED('tmpCalcQTY')
		*!*		USE IN tmpCalcQTY
		*!*	ENDIF
		*!*	SELECT 0
		
		*!*	PRIVATE cSQL
		*!*	cSQL = "EXEC dbo.p_GetUnitQty "
		*!*	cSQL = cSQL + STR(nPCs)
		*!*	cSQL = cSQL + ",'"+cAlloy+"'"
		*!*	cSQL = cSQL + ",'"+cForm+"'"
		*!*	cSQL = cSQL + ","+STR(PrepareSQLnum(nDim1,'nThck',14,4),10,4)
		*!*	cSQL = cSQL + ","+STR(PrepareSQLnum(nDim2,'Sz2',12,3),9,3)
		*!*	cSQL = cSQL + ","+STR(PrepareSQLnum(nDim3,'nSz3',12,3),9,3)
		
		*!*	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCalcQTY')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCalcQTY')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDone")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDone")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpCalcQTY')
		*!*	ENDIF
		
		*!*	IF USED('tmpCalcQTY')
		*!*		IF RECCOUNT('tmpCalcQTY')>0
		*!*			nCalcQTY = tmpCalcQTY.UnitQty
		*!*		ENDIF
		*!*		USE IN tmpCalcQTY
		*!*	ENDIF
		
		*!*	IF nCalcQTY	> 0
		*!*		SELECT tmpPSitem
		*!*		REPLACE tmpPSitem.SL_QTY WITH nSL_QTY
		*!*		REPLACE tmpPSitem.QTY WITH nCalcQTY 	
		*!*		ThisForm.QTY1.Value = nCalcQTY 
		*!*	ENDIF
		
		***********************************
		
		ThisForm.grdtmpPSItem.Refresh
		ThisForm.grdtmpPSItem.SetFocus
		ThisForm.PCS1.SetFocus
		
		
	ENDPROC

	PROCEDURE cmdProcess.Click
		PRIVATE m.nPcs,m.tDesc,m.nSalesNum,m.tSOItem,m.tAlloy,m.tHeat,m.nPackingSli
		PRIVATE m.nWeight, lKg, m.nPackWeight,m.tPO_Num,m.lComplete
		PRIVATE cForm, nQTY, nStockLst_PU, nSale_Dim1, nSale_Dim2, nSale_Dim3 
		*PRIVATE nSales_Detail_ID
		PRIVATE ok2Save
		ok2Save = .T.
		
		ThisForm.grdtmpPSItem.RecordSource = ""
		
		SELECT tmpPSItem
		IF UPPER(ALIAS()) = UPPER("tmpPSItem")
			PACK 
		ENDIF
		ThisForm.grdtmpPSItem.RecordSource = "tmpPSItem"
		
		ThisForm.grdtmpPSItem.clmPcs.ControlSource 		= "tmpPSItem.Pcs"
		ThisForm.grdtmpPSItem.clmHeat.ControlSource 	= "tmpPSItem.Heat"
		ThisForm.grdtmpPSItem.clmDescript.ControlSource	= "tmpPSItem.Descript"
		ThisForm.grdtmpPSItem.clmWeight.ControlSource 	= "tmpPSItem.Weight"
		
		
		SELECT tmpPSItem
		IF RECCOUNT("tmpPSItem") = 0
			ok2Save = .F.
			=MESSAGEBOX("No Records to process",0,"Cannot Save, Abort instead.")
		ENDIF
		
		m.lComplete = ( ThisForm.chkComplete.Value = 1 )
		IF NOT m.lComplete
			IF MESSAGEBOX("You did not mark item as 'Complete'."+CHR(13)+CHR(13)+"Answer (Y)es here to mark this item as complete right now."+CHR(13)+"other wise the answer No",4+48+256,"Did you forget to mark as complete?") = 6
				m.lComplete = .T.
			ENDIF
		ENDIF
		
		lKg = PrepareSQLlogic(ThisForm.chkKg.Value,'Kg',.F.)
		
		IF ok2Save
			SELECT tmpPSItem
			GO TOP
			SCAN
				SELECT tmpPSItem
				m.nPcs			= tmpPSItem.PCs 
				
				IF m.nPcs < 1
					=MESSAGEBOX("Bad Piece Number."+CHR(13)+"Cannot Print out Packing Slip when there are no Pieces!",0,"Cannot Print out. Packing Slip when no Pieces")
				ENDIF
				m.tHeat			= tmpPSItem.Heat
				m.tLot			= tmpPSItem.Lot
				m.tDesc			= tmpPSItem.Descript
				m.nWeight		= tmpPSItem.Weight
			*	m.nPackWeight	= tmpPSItem.PackWeight 
			*	m.tAlloy 		= tmpPSItem.Alloy
			*	m.nPackingSli   = tmpPSItem.PackingSli 	
			*	m.lComplete 	= tmpPSItem.SOi_cmplt
				m.nSalesNum		= tmpPSItem.SalesNum
				m.tSOItem		= tmpPSItem.SOItem &&STR(Salesnum,7,0)+"-"+IIF(Item<10,"0"+STR(item,1,0), STR(item,2,0) )
				m.cForm 		= tmpPSItem.Form
			
				**** Mark each tmpPSitem with the Global fields
				REPLACE tmpPSItem.PO_num 	WITH PrepareSQLtxt(ThisForm.txtPO_Num.Value,'PO_Num',20)
				REPLACE tmpPSItem.Kg 		WITH lKg
				REPLACE tmpPSItem.SOi_cmplt	WITH m.lComplete &&See the Update all line
				REPLACE tmpPSItem.PartNo	WITH PrepareSQLtxt(ThisForm.txtPartNo.Value,'PartNo',100)
				
				*** Get QTY and Save
				nStockLst_PU= getPUfromForm( cForm, ThisForm.nConnHandle )
				*nPcs  		= PrepareSQLnum( tmpPSitem.PCs,'Pc',-3)
				nSale_Dim1	= PrepareSQLnum( tmpPSitem.Dim1,'Dim1',18,4)
				nSale_Dim2	= PrepareSQLnum( tmpPSitem.Dim2,'Dim2',17,3)
				nSale_Dim3	= PrepareSQLnum( tmpPSitem.Dim3,'Dim3',17,3)
		
				DO CASE
				CASE nStockLst_PU = 1
					*nQTY is Wieght in LBS
					nQTY = PrepareSQLnum( tmpPSitem.Weight,'Weight',7,1)
				CASE nStockLst_PU = 2
					*nQTY = Feet
					IF Uses3rdDim( m.cForm, ThisForm.nConnHandle)
				 		nQTY  = nPcs * (nSale_Dim3 / 12)
				 	ELSE
				 		nQTY  = nPcs * (nSale_Dim2 / 12)
				 	ENDIF
				CASE nStockLst_PU = 3
					*nQTY is PCs
					nQTY  = m.nPcs
				OTHERWISE
					nQTY  = 0
				ENDCASE
				
				REPLACE tmpPSItem.QTY WITH nQTY
				REPLACE tmpPSItem.PU  WITH nStockLst_PU 
				
				***
						
				IF LEN(ALLTRIM(m.tDesc)) = 0
					ok2Save = .F.
					=MESSAGEBOX("Bad Item description",0,"Cannot Save")
				ENDIF
		
				IF m.nSalesNum < 1
					ok2Save = .F.
					=MESSAGEBOX("Bad SO Number",0,"Cannot Save")
				ENDIF
				IF EMPTY(m.tSOItem)
					ok2Save = .F.
					=MESSAGEBOX("Bad SO Item",0,"Cannot Save")
				ENDIF
				
				IF ok2Save
					IF "HPA-" $ UPPER(tHeat)
						IF MESSAGEBOX("The Production Lot number standard no longer uses a dash 'HPA-'"+CHR(10)+"Answer Yes and you can edit the Heat.",4+32,"Revise the heat field?") = 6
							ok2Save = .F.		
						ENDIF
					ENDIF
				ENDIF		
				IF ok2Save
					IF "HPAG" $ UPPER(tHeat)
						IF MESSAGEBOX("The Production Lot number standard now uses a space like 'HPA G999'"+CHR(10)+"Answer Yes and you can edit the Heat.",4+32,"Revise the heat field?") = 6
							ok2Save = .F.		
						ENDIF
					ENDIF
				ENDIF		
				IF ok2Save
					IF "HPAR" $ UPPER(tHeat)
						IF MESSAGEBOX("The Production Lot number standard now uses a space like 'HPA R999'"+CHR(10)+"Answer Yes and you can edit the Heat.",4+32,"Revise the heat field?") = 6
							ok2Save = .F.		
						ENDIF
					ENDIF
				ENDIF		
				IF ok2Save
					IF "HPAL" $ UPPER(tHeat)
						IF MESSAGEBOX("The Production Lot number standard now uses a space like 'HPA L999'"+CHR(10)+"Answer Yes and you can edit the Heat.",4+32,"Revise the heat field?") = 6
							ok2Save = .F.		
						ENDIF
					ENDIF
				ENDIF		
				
				SELECT tmpPSItem
				
				
				IF PrepareSQLnum(tmpPSItem.tmpPSnum,'tmpPSnum',-3) > 0 AND ThisForm.nTmpPSnum = 0
					ThisForm.nTmpPSnum = PrepareSQLnum(tmpPSItem.tmpPSnum,'tmpPSnum',-3)
				ENDIF
				nTmpPSnum = PrepareSQLnum(ThisForm.nTmpPSnum,'tmpPSnum',-3)
				
				IF nTmpPSnum = 0
					*Get Unique nPackingSli
					nTmpPSnum = 0 - VAL( SYS(2) ) &&Seconds since Midnight
					ThisForm.nTmpPSnum = nTmpPSnum
				ENDIF
				
				REPLACE tmpPSItem.tmpPSnum	WITH nTmpPSnum		
							
			ENDSCAN
			
			**************************************
				
			IF OK2Save	 
				IF AQ_SOitem_Cnt(cSOitem,ThisForm.nConnhandle," SERVICES") = 0
					*Do not show if Services where found!
			*		DO FORM Forms\ChooseSales_Stock_Ship WITH cSOitem, nTmpPSnum
					*DO FORM Forms\ChooseSales_Detail_Ship WITH cSOitem, nTmpPSnum
				ENDIF
			ENDIF
			
			IF m.lComplete
				UPDATE tmpPSItem SET SOi_cmplt =.T. WHERE SOitem = m.tSOItem
			ENDIF
			
		ENDIF
		
		IF ok2Save
			
			*Save to PackingSlipItem	
			SELECT PackingSlipItem
			DELETE ALL FOR EMPTY(PackingSlipItem.Descript) IN PackingSlipItem
			PACK
			
			IF USED('tmpPSItem')
		*IF "\MEM" $ SYS(2003)
		*CREATE TABLE (SYS(5)+SYS(2003)+"\"+"PackingSlipItem") FREE ;
			( SalesNum N(7), SOItem C(10), PCs N(10), Alloy C(12);
			 ,Heat C(50), Lot C(10),DESCRIPT C(80), Weight N(7,1);
			 ,PackingSli N(10), PartNo C(100),PackWeight N(7,1) ;
			 ,Form C(2), CC C(1), CL C(1), AQDescript C(50), Kg L;
			 ,Dim1 N(18,4),Dim2 N(17,3),Dim3 N(17,3);
			 ,RandLen L,Metric L, PO_num C(17);
			 , QTY N(18,4);
			 ,PU N(1), SS_ID N(10), tmpPSnum N(10),SOi_cmplt L ;
			 ,TBL C(1),SL_ID I,SL_ID_D I,ID_D_Proc I, SL_P N(18,4), SL_QTY N(18,4)	 )
		
				ThisForm.PartNo =ALLTRIM(ThisForm.txtPartNo.Value)	
				**Field Order is Crutial *******************************************************
				INSERT INTO PackingSlipItem ;
					SELECT SalesNum,SOItem,PCs,Alloy;
					,Heat,Lot,DESCRIPT,Weight;
					,PackingSli,PartNo,PackWeight;
					,Form,CC,CL,AQDescript,Kg;
					,Dim1,Dim2,Dim3;
					,RandLen,Metric,PO_num;
					,QTY;
					,PU,SS_ID,tmpPSnum,SOi_cmplt ;
					,TBL,SL_ID,SL_ID_D,ID_D_Proc, SL_P, SL_QTY ;
					FROM tmpPSitem
				
				SELECT PackingSlipItem 
				
				ThisForm.ReturnLPosted = .T.
				ThisForm.Release
				
			ELSE
				ThisForm.ReturnLPosted = .F.
				MESSAGEBOX("Nothing to return"+CHR(13)+"Could not find 'tmpPSItem' data.",0+16,"Table not found!")
			ENDIF
			
		ELSE
			ThisForm.ReturnLPosted = .F.
			MESSAGEBOX("Error in code",0,"Could not Process.")
		ENDIF
	ENDPROC

	PROCEDURE cmdRemove.Click
		SELECT tmpPSItem
		PRIVATE nSS_ID
		
		ThisForm.grdtmpPSItem.RecordSource = ""
		SELECT tmpPSItem
		SCAN
			IF DELETED('tmpPSItem')
				nSS_ID = tmpPSItem.SS_ID
		*!*			cSQL = "UPDATE dbo.Sales_Stock "
		*!*			cSQL = cSQL+" SET SOitem = dbo.f_ProperSOitem('')"
		*!*			cSQL = cSQL+" WHERE ID="+STR(nSS_ID)
		*!*			
		*!*			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, '')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC( THISFORM.nConnHandle, cSQL, '')
		*!*			ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDone")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpPSItemDone")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*			IF nSQLEXEC < 0
		*!*				SQLExecError( cSQL, THISFORM.nConnHandle,nSQLEXEC, '' )
		*!*			ELSE
		*!*			SELECT tmpSales_Stock 
		*!*			DELETE FOR ID = nSS_ID
				Pack
		*			ENDIF
				
			ENDIF
		ENDSCAN
		
		IF UPPER(ALIAS()) = UPPER("tmpPSItem")
			PACK 
		ENDIF
		
		SELECT tmpPSItem
		GO TOP
		
		ThisForm.grdtmpPSItem.RecordSource = "tmpPSItem"
		ThisForm.grdtmpPSItem.clmPcs.ControlSource 		= "tmpPSItem.Pcs"
		ThisForm.grdtmpPSItem.clmHeat.ControlSource 	= "tmpPSItem.Heat"
		ThisForm.grdtmpPSItem.clmDescript.ControlSource	= "tmpPSItem.Descript"
		ThisForm.grdtmpPSItem.clmWeight.ControlSource 	= "tmpPSItem.Weight"
		
		ThisForm.grdtmpPSItem.Refresh
		
		*****
		ThisForm.txtSOItem.Value	= tmpPSItem.SOItem
		ThisForm.txtAlloy.Value		= tmpPSItem.Alloy
		
		ThisForm.txtSS_ID.Value	= tmpPSItem.SS_ID
		ThisForm.chkKg.Value 	= PrepareSQLchk(tmpPSItem.Kg,'KG')
		
		ThisForm.PCS1.Value		= tmpPSitem.PCs
		ThisForm.cmbForm.Value	= tmpPSitem.Form
		ThisForm.Thck1.Value	= tmpPSitem.Dim1
		ThisForm.Sz21.Value		= tmpPSitem.Dim2
		ThisForm.Sz31.Value		= tmpPSitem.Dim3
		ThisForm.chkRL.Value	= tmpPSitem.RandLen
		ThisForm.LBS1.Value		= tmpPSitem.Weight
		
		ThisForm.lblAQDescript.Caption = tmpPSItem.AQDescript
		
		IF Proper_SO_Item(tmpPSItem.SOItem) = Proper_SO_Item("")
			ThisForm.txtPartNo.Value = ''
		ELSE
			ThisForm.txtPartNo.Value = get_PartNoinSales(tmpPSItem.SOItem,ThisForm.nConnHandle)
		ENDIF
		
		ThisForm.txtPO_Num.Value	= tmpPSItem.PO_Num
		ThisForm.txtHeat.Value 	= tmpPSItem.Heat
		
		ThisForm.txtDescription.Value = ThisForm.getSOitemDesc(tmpPSItem.SOItem)
		
		ThisForm.RefreshTotals()
	ENDPROC

	PROCEDURE grdtmpPSItem.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshPSitem()
		
	ENDPROC

	PROCEDURE grdtmpPSItem.clmDescript.Text1.Valid
		ThisForm.lblAQDescript.Caption = tmpPSItem.Descript
	ENDPROC

	PROCEDURE HPA_QTY.Valid
		SELECT tmpPSitem
		REPLACE tmpPSitem.SL_QTY WITH This.Value  &&HPA QTY
		
		ThisForm.RefreshDescription()
	ENDPROC

	PROCEDURE lblAQDescript.DblClick
		PRIVATE cAQDescript
		cAQDescript = ALLTRIM(This.Caption)
		ThisForm.txtPartNo.Value = ALLTRIM(ThisForm.txtPartNo.Value)+ " " + cAQDescript 
	ENDPROC

	PROCEDURE lblSODescript.DblClick
		PRIVATE cAQDescript
		cAQDescript = ALLTRIM(ThisForm.lblAQDescript.Caption)
		ThisForm.txtPartNo.Value = cAQDescript 
	ENDPROC

	PROCEDURE LBS1.Valid
		SELECT tmpPSitem
		REPLACE tmpPSitem.Weight WITH This.Value
		
		ThisForm.RefreshDescription()
	ENDPROC

	PROCEDURE PCS1.Valid
		SELECT tmpPSitem
		REPLACE tmpPSitem.PCs WITH This.Value
		
		ThisForm.RefreshDescription()
	ENDPROC

	PROCEDURE QTY1.Valid
		SELECT tmpPSitem
		REPLACE tmpPSitem.QTY WITH This.Value  &&Customer QTY
		
		ThisForm.RefreshDescription()
	ENDPROC

	PROCEDURE SZ21.Valid
		SELECT tmpPSitem
		REPLACE tmpPSitem.Dim2 WITH This.Value
		
		ThisForm.RefreshDescription()
	ENDPROC

	PROCEDURE SZ31.Valid
		SELECT tmpPSitem
		REPLACE tmpPSitem.Dim3 WITH This.Value
		
		ThisForm.RefreshDescription()
	ENDPROC

	PROCEDURE THCK1.Valid
		SELECT tmpPSitem
		REPLACE tmpPSitem.Dim1 WITH This.Value
		
		ThisForm.RefreshDescription()
	ENDPROC

	PROCEDURE txtHeat.Valid
		SELECT tmpPSitem
		PRIVATE cHeat
		cHeat = This.Value
		
		REPLACE tmpPSitem.Heat WITH ALLTRIM(cHeat)
		
		ThisForm.grdtmpPSItem.Refresh
		
	ENDPROC

	PROCEDURE txtLot.Valid
		SELECT tmpPSitem
		PRIVATE cLot
		cLot = This.Value
		
		REPLACE tmpPSitem.Lot WITH ALLTRIM(cLot)
		
		ThisForm.grdtmpPSItem.Refresh
		
	ENDPROC

ENDDEFINE
