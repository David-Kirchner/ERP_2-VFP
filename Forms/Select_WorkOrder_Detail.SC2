	PROCEDURE lblWO.Click
		PRIVATE nWO
		nWO = PrepareSQLnum(tmpWorkOrders.WO,'WO',-3)
		IF nWO > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO(nWO,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE lblWO_Detail.Click
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(tmpWorkOrders.WO_Detail,'WO_Detail',-3)
		IF nWO_Detail > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO_Detail(nWO_Detail,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE txtLot.Valid
		PRIVATE nWO
		nWO = PrepareSQLnum(this.Parent.txtOrder.Value,'WO',-3)
		
		IF nWO > 0
			SELECT tmpWorkOrders
			
			LOCATE FOR WO = nWO 
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
			ENDIF
			ThisForm.RefreshScreen()
		ENDIF
	ENDPROC

	PROCEDURE txtOrder.Valid
		PRIVATE nWO
		nWO = PrepareSQLnum(this.Parent.txtOrder.Value,'WO',-3)
		
		IF nWO > 0
			SELECT tmpWorkOrders
			
			LOCATE FOR WO = nWO 
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
			ENDIF
			ThisForm.RefreshScreen()
		ENDIF
	ENDPROC

ENDDEFINE
