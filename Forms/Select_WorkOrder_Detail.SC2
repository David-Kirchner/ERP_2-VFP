	PROCEDURE Init
		PARAMETERS pSOitem, pPOitem, pWO
		*DO FORM Forms\Select_WorkOrder_Detail WITH pSOitem, pPOitem, nWO to nWO_Detail
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(pPOitem,'POitem',12)
		
		PRIVATE nWO
		nWO = PrepareSQLnum(pWO,'WO',-3)
		
		
		PRIVATE lFound, nCurrRec
		lFound = .F.
		nCurrRec = RECNO('tmpWorkOrders')
		
		IF nWO > 0
			SELECT tmpWorkOrders
			LOCATE FOR WO=nWO
			IF FOUND('tmpWorkOrders')
				lFound = .T.
			ELSE
				GOTO nCurrRec 
			ENDIF
		ENDIF
		
		IF NOT lFound
			IF cSOitem <> Proper_SO_Item('')
				SELECT tmpWorkOrders
				*Search Finish SOitem
				LOCATE FOR fSOitem = cSOitem
				IF FOUND('tmpWorkOrders')
					lFound = .T.
				ELSE
					GOTO nCurrRec 
				ENDIF
				
				IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
					SELECT tmpWorkOrders
					LOCATE FOR fSOitem = cSOitem AND fPOitem = cPOitem 
					
					IF NOT FOUND()
						IF lFound 
							LOCATE FOR fSOitem = cSOitem
						ELSE
							LOCATE FOR fPOitem = cPOitem OR TestPO = cPOitem
							IF NOT FOUND() 
								GOTO nCurrRec 
							ENDIF
						ENDIF
					ENDIF
					
				ENDIF
				
				IF nCurrRec = RECNO('tmpWorkOrders')
					*SO is probable used in Starting, not Finishing
					LOCATE FOR SOitem = cSOitem
					IF FOUND('tmpWorkOrders')
						lFound = .T.
					ELSE
						GOTO nCurrRec 
					ENDIF
				ENDIF
				
			ELSE
				IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
					SELECT tmpWorkOrders
					LOCATE FOR fPOitem = cPOitem OR TestPO = cPOitem
					
					IF FOUND('tmpWorkOrders')
						lFound = .T.
					ELSE
						GOTO nCurrRec 
					ENDIF
				ENDIF
			ENDIF
			
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLstringCONNECT()
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpWorkOrders")
			USE IN tmpWorkOrders
		ENDIF
		SELECT 0
		
		cSQL=" SELECT * "
		cSQL=cSQL+" ,CAST(LEFT(ISNULL(WO.SOitem,''),7) AS INT) AS SalesNum "
		cSQL=cSQL+" ,dbo.f_ItemDescription(sForm,sThck,sSz2,sSz3,sWeight,0) AS sDesc "
		cSQL=cSQL+" ,dbo.f_ItemDescription(fForm,fThck,fSz2,fSz3,fWeight,0) AS fDesc "
		cSQL=cSQL+" FROM dbo.WorkOrder WO WITH(NOLOCK) "
		cSQL=cSQL+" INNER JOIN dbo.WorkOrder_Detail WOD ON WO.WO = WOD.WO "
		cSQL=cSQL+" WHERE WO.Cncld = 0 "
		*cSQL=cSQL+" AND WO.Cmplt = 0 "
		cSQL=cSQL+" AND ISNULL(fCncld,1) = 0 "
		cSQL=cSQL+" ORDER BY WO.WO DESC "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWorkOrders')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWorkOrders')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWorkOrders")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWorkOrders")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpWorkOrders' )
		ENDIF
		
		IF USED('tmpWorkOrders')
			IF RECCOUNT('tmpWorkOrders') > 0
				SELECT tmpWorkOrders
				GO TOP
				IF RECCOUNT() > 8
					SKIP 8
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE refreshscreen
		*tmpWorkOrders.WO,EnterDate,StartDate,DueDate,FinishDate,Descript,InqNumP,SOitem,POitem
		*Thisform.txtSalesOrder.Refresh
		ThisForm.txtWO.Refresh
		ThisForm.txtWO_Detail.Refresh
		ThisForm.txtFinishM.Refresh
		ThisForm.txtFinishLot.Refresh
		*ThisForm.txtEnterDate.Refresh
		ThisForm.txtStartDate.Refresh
		ThisForm.txtDueDate.Refresh
		ThisForm.txtsAlloy.Refresh
		
		ThisForm.txtDescS.Refresh
		ThisForm.txtDescript.Refresh
		
		ThisForm.txtSOitem.Refresh
		ThisForm.txtPOitem.Refresh
		ThisForm.txtTestPO.Refresh
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpWorkOrders')
			USE IN tmpWorkOrders
		ENDIF
		
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN THISFORM.nReturn
	ENDPROC

	PROCEDURE cmdAdd.Click
		*DO FORM Forms\workorder WITH tmpWorkOrders.WO
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.nReturn = 0
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdFind.Click
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(this.Parent.txtOrder.Value,'WO_Detail',-3)
		
		IF nWO_Detail > 0
			SELECT tmpWorkOrders
			
			LOCATE FOR WO_Detail = nWO_Detail 
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No WO_Detail")
				GO BOTTOM
			ENDIF
			ThisForm.grdWO.Refresh
			ThisForm.RefreshScreen()
		ELSE
			WAIT WINDOW "Enter WO_Detail to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE cmdFindLot.Click
		PRIVATE nLot
		nLot = PrepareSQLnum(this.Parent.txtLot.Value,'Lot',-3)
		
		IF nLot > 0
			SELECT tmpWorkOrders
			
			LOCATE FOR FinishLot = nLot 
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No Lot Found")
				GO BOTTOM
			ENDIF
			ThisForm.grdWO.Refresh
			ThisForm.RefreshScreen()
		ELSE
			WAIT WINDOW "Enter an Lot number to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSelect.Click
		*DO FORM Forms\workorder WITH tmpWorkOrders.WO
		PRIVATE nWO_Detail
		nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		ThisForm.nReturn = nWO_Detail
		
		ThisForm.Release
		
		
	ENDPROC

	PROCEDURE grdWO.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshScreen
	ENDPROC

	PROCEDURE lblPOitem.Click
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(tmpWorkOrders.fPOitem,'POitem',12)
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_POitem(cPOitem,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE lblSOitem.Click
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(tmpWorkOrders.fSOitem,'SOitem',10)
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_SOitem(cSOitem,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
