	ADD OBJECT 'frmConditionLevel.txtThck' AS textbox WITH ;
		Comment = "", ;
		ControlSource = "", ;
		Enabled = .F., ;
		Format = "K", ;
		Height = 20, ;
		InputMask = "99,999.999", ;
		Left = 99, ;
		Name = "txtThck", ;
