	ENDPROC

	PROCEDURE frmConditionLevel.cmbCC.Valid
		ThisFormSet.ReloadCL()
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.frmConditionLevel.cmbCL.Value = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
		
	ENDPROC

	PROCEDURE frmConditionLevel.cmbCL.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpConditionCodeCL')
			SELECT tmpConditionCodeCL
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpConditionCodeCL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpConditionCodeCL')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpConditionCodeCL')
		ENDIF
		
		
		
		IF USED('tmpConditionCodeCL')
			SELECT * FROM tmpConditionCodeCL INTO ARRAY aConditionCode
			
			USE IN tmpConditionCodeCL
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		*This.Value = Quotes.CC
		
	ENDPROC

	PROCEDURE frmConditionLevel.cmbCL.InteractiveChange
		*LOCATE FOR
		
		*ThisForm.grdStockLst.Refresh
		*ThisForm.grdStockLst.SetFocus
	ENDPROC

	PROCEDURE frmConditionLevel.cmbCL.Requery
		ThisFormSet.ReloadCL()
		
	ENDPROC

	PROCEDURE frmConditionLevel.cmdRetunr.Click
		ThisForm.Release
		ThisFormSet.Release
	ENDPROC

	PROCEDURE frmConditionLevel.Load
		
		
	ENDPROC

ENDDEFINE
