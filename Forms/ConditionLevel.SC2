		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETERS pCC, pCL
		*DO FORM Forms\ConditionLevel WITH cCC, cCL TO cSpec
		
		
		PRIVATE cCC, cCL
		
		IF VARTYPE(pCC) = "U"
			cCC = '1'
		ENDIF
		IF VARTYPE(pCC) = "N"
			cCC = VAL(pCC)
		ENDIF
		IF VARTYPE(pCC) != "C"
			cCC = '1'
		ENDIF
		
		
		IF VARTYPE(pCL) = "U"
			cCL = ' '
		ENDIF
		IF VARTYPE(pCL) = "N"
			cCL = VAL(pCL)
		ENDIF
		IF VARTYPE(pCL) != "C"
			cCL = ' '
		ENDIF
		
		
		
		
		ThisFormSet.frmConditionLevel.cmbCC.Value = cCC
		ThisFormSet.ReloadCL()
		ThisFormSet.frmConditionLevel.cmbCL.Value = cCL
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
	ENDPROC

	PROCEDURE reloadcl
		*ThisFormSet.ReloadCL()
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpConditionLevelCL')
			SELECT tmpConditionLevelCL
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE cCC
		cCC = PrepareSQLtxt(ThisFormSet.frmConditionLevel.cmbCC.Value,'CC',1)
		
		ThisFormSet.frmConditionLevel.cmbCL.clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL= cSQL + " WHERE CC='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpConditionLevelCL')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpConditionLevelCL')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpConditionLevelCL')
		ENDIF
		
		*IF VARTYPE(aConditionLevel)='U'
		IF NOT USED('tmpConditionLevelCL')
			ThisFormSet.frmConditionLevel.cmbCL.addListItem("",1,1)
			ThisFormSet.frmConditionLevel.cmbCL.addListItem("",1,2)
		ELSE
			IF RECCOUNT('tmpConditionLevelCL')=0
				ThisFormSet.frmConditionLevel.cmbCL.addListItem("",1,1)
				ThisFormSet.frmConditionLevel.cmbCL.addListItem("",1,2)
			ELSE
				SELECT * FROM tmpConditionLevelCL INTO ARRAY aConditionLevel
		
				*This.ColumnCount = ALEN(aConditionLevel,2)
				ThisFormSet.frmConditionLevel.cmbCL.ColumnCount = 2
				ThisFormSet.frmConditionLevel.cmbCL.NumberOfElements=ALEN(aConditionLevel)
				ThisFormSet.frmConditionLevel.cmbCL.BoundColumn = 1
				ThisFormSet.frmConditionLevel.cmbCL.ColumnWidths = "10,115"
		
				*ThisFormSet.frmConditionLevel.cmbCL.addListitem("(All Employees)",1,1)
				*ThisFormSet.frmConditionLevel.cmbCL.addListitem("*",1,2)
				nLoopCount = 1
				*nLoopCount = 0
		
				FOR EACH cc1 IN aConditionLevel
					IF !EMPTY(cc1)
				*		nLoopCount = nLoopCount + 1
						IF LEN(ALLTRIM(cc1)) > 1
							
							ThisFormSet.frmConditionLevel.cmbCL.addListItem(ALLTRIM(cc1),nLoopCount,2)
						ELSE
							nLoopCount = nLoopCount + 1
							ThisFormSet.frmConditionLevel.cmbCL.addListItem(ALLTRIM(cc1),nLoopCount,1)
						ENDIF
					ENDIF
				ENDFOR
				
				USE IN tmpConditionLevelCL
			ENDIF
		ENDIF
		
		*This.Value = "*"
		ThisFormSet.frmConditionLevel.cmbCL.Value = aConditionLevel(1)
		
	ENDPROC

	PROCEDURE frmConditionLevel.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpConditionLevelCC')
			SELECT tmpConditionLevelCC
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpConditionLevelCC')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpConditionLevelCC')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'tmpConditionLevelCC')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('tmpConditionLevelCL')
			SELECT * FROM tmpConditionLevelCC INTO ARRAY aConditionCode
			
			USE IN tmpConditionLevelCC
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		This.Value = '1'
		
	ENDPROC

	PROCEDURE frmConditionLevel.cmbCC.InteractiveChange
		
		*LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) 
		*IF FOUND('StockLst_SQL')
		
		
		
		*ThisFormSet.frmConditionLevel.grdStockLst.Refresh
