	PROCEDURE Destroy
		
		
		IF "RA_CALC" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\RA_CALC"
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pWhat,pField,pID
		*DO FORM Forms\Stock_Projected WITH "SHOW","Stock_Projected_ID",1004
		
		*For Testing *******************
		IF VARTYPE(pWhat) != "C"
			pWhat="SHOW"
			pField="Stock_Projected_ID"
			pID=20
		ENDIF
		*For Testing *******************
		
		
		pWhat = UPPER(PrepareSQLtxt(pWhat,'What',100))
		pField= UPPER(PrepareSQLtxt(pField,'Field',100))
		pID   = PrepareSQLnum(pID,'ID',-3)
		
		IF EMPTY(pWhat) 
			MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
			TrackError("Parameter error!","Did not get a proper pWhat. '"+pcWhat+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))	
		ENDIF
		IF EMPTY(pField) 
			MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
			TrackError("Parameter error!","Did not get a proper pField. '"+pField+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))	
		ENDIF
		IF pID < 1
			MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
			TrackError("Parameter error!","Did not get a proper pID. '"+STR(pID)+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))	
		ENDIF
		
		ThisFormSet.pWhat = pWhat
		ThisFormSet.pField = pField
		ThisFormSet.pID	= pID
		
		ThisFormSet.frmStocK_Proj.Initprojstock()
		*InitProjStock()
		
		IF USED('tmpProjStk')
			DO CASE 
		**********************************************************	
			CASE pField = 'STOCK_PROJECTED_ID'
				DO CASE
				CASE pWhat = "SHOW"
					IF pID > 0
						SELECT tmpProjStk
						LOCATE FOR ID = pID
						*ThisFormset.frmProjectedStock.grdProStk.Refresh
						*ThisFormSet.ProjStk_Refresh()
						ThisFormSet.frmStocK_Proj.grdProStk.Refresh
						ThisFormSet.frmStocK_Proj.ProjStk_Refresh()
					ELSE
						MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
						TrackError("Parameter error!","Did not get a proper pID. '"+STR(pID)+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))	
					ENDIF
				CASE pWhat = "EDIT"
					IF pID > 0
						SELECT tmpProjStk
						LOCATE FOR ID = pID
						IF FOUND()
							*ThisFormset.frmProjectedStock.grdProStk.Refresh
							*ThisFormSet.ProjStk_Refresh()
							*ThisFormSet.SetStock_Projected('EDIT')
							ThisFormSet.frmStocK_Proj.grdProStk.Refresh
							ThisFormSet.frmStocK_Proj.ProjStk_Refresh()
							ThisFormSet.frmStocK_Proj.SetStock_Projected('EDIT')
						ENDIF
					ELSE
						MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
						TrackError("Parameter error!","Did not get a proper pID. '"+STR(pID)+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))	
					ENDIF
				CASE pWhat = "ADD"
					*ThisFormSet.Stock_Projected_Init('ADD')
					*ThisFormSet.SetStock_Projected('EDIT')		
					ThisFormSet.frmStocK_Proj.Stock_Projected_Init('ADD')
					ThisFormSet.frmStocK_Proj.SetStock_Projected('EDIT')
				OTHERWISE
					MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
					TrackError("Parameter error!","Did not get a proper pWhat. '"+pcWhat+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))	
				ENDCASE
		**********************************************************
			CASE pField = 'WORKORDER'
				IF pWhat = "ADD"
					IF pID > 0
						*ThisFormset.CreateStock_Projected_WO(pID)
						*Calls ThisFormSet.SetStock_Projected('EDIT')
					ELSE
						MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
						TrackError("Parameter error!","Did not get a proper pID. '"+STR(pID)+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))				
					ENDIF
				ELSE
					MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
					TrackError("Parameter error!","Did not get a proper pWhat. '"+pcWhat+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))	
				ENDIF
		**********************************************************
			CASE pField = 'WORKORDER_DETAIL'
				IF pWhat = "ADD"
					IF pID > 0
						*ThisFormset.CreateStock_Projected_WOD(pID)
						*Calls ThisFormSet.SetStock_Projected('EDIT')
					ELSE
						MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
						TrackError("Parameter error!","Did not get a proper pID. '"+STR(pID)+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))				
					ENDIF
				ELSE
					MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
					TrackError("Parameter error!","Did not get a proper pWhat. '"+pcWhat+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))	
				ENDIF
		**********************************************************
			OTHERWISE
				MESSAGEBOX("Parameters should look like this."+CHR(13)+"\Stock_Projected WITH 'SHOW','Stock_Projected_ID',nID",16,"Bad Parameters")
				TrackError("Parameter error!","Did not get a proper pField. '"+pField+"'"+CHR(13)+"\Stock_Projected WITH 'pWhat', 'pField', pID","Stock_Projected.Init", LINENO(1))	
			ENDCASE
		**********************************************************
			
		
		ENDIF
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "FormCode")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		IF ThisFormSet.nConnhandle > 0
			= SQLDISCONNECT(ThisFormSet.nConnhandle)
		ENDIF
	ENDPROC

	PROCEDURE frmStocK_Proj.cmdQuit.Click
		DODEFAULT()
		ThisForm.Release
		ThisFormSet.Release
		
	ENDPROC

	PROCEDURE frmStocK_Proj.cmdRA.Click
		ThisFormSet.Ra_calc12.Visible = .T.
		ThisFormSet.Ra_calc12.TxtD123.SetFocus()
	ENDPROC

	PROCEDURE Ra_calc12.cmdClose.Click
		ThisForm.Visible = .F.
	ENDPROC

