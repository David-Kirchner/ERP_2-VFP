DEFINE CLASS frmcheckemail AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdRefresh" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdQuit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Grid1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Timer1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lbl10Min" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblSeconds" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSQLEmailReport" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtDesc" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: refreshtables
		*p: cemailto		&& Email Recipient Parameter
		*p: dtstart		&& Start DateTime
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth.ico
		AlwaysOnTop = .T.
		Caption = "Checking your Email sent status"
		cemailto = ''
		DataSession = 2
		DoCreate = .T.
		dtstart = 
		Height = 246
		Left = 12
		Name = "frmCheckEmail"
		nconnhandle = 0
		Top = 0
		Width = 657
		WindowType = 0
	*</PropValue>

	ADD OBJECT 'cmdQuit' AS commandbutton WITH ;
		Caption = "Quit", ;
		Height = 27, ;
		Left = 556, ;
		Name = "cmdQuit", ;
		Top = 9, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdRefresh' AS commandbutton WITH ;
		Caption = "Refresh", ;
		Height = 27, ;
		Left = 17, ;
		Name = "cmdRefresh", ;
		Top = 9, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSQLEmailReport' AS commandbutton WITH ;
		Caption = "See all Email Report", ;
		Height = 27, ;
		Left = 472, ;
		Name = "cmdSQLEmailReport", ;
		Top = 36, ;
		Width = 168
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Grid1' AS grid WITH ;
		Height = 200, ;
		Left = 4, ;
		Name = "Grid1", ;
		Top = 41, ;
		Visible = .F., ;
		Width = 320
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'lbl10Min' AS label WITH ;
		Alignment = 2, ;
		Caption = "This window will close if no Error is found in 10 Minutes.", ;
		ForeColor = 0,0,0, ;
		Height = 17, ;
		Left = 158, ;
		Name = "lbl10Min", ;
		Top = 16, ;
		Width = 390
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblSeconds' AS label WITH ;
		Caption = "0", ;
		Height = 17, ;
		Left = 108, ;
		Name = "lblSeconds", ;
		Top = 13, ;
		Width = 48
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Timer1' AS timer WITH ;
		Height = 23, ;
		Interval = 6000, ;
		Left = 327, ;
		Name = "Timer1", ;
		Top = 52, ;
		Width = 23
		*< END OBJECT: BaseClass="timer" />

	ADD OBJECT 'txtDesc' AS editbox WITH ;
		Height = 168, ;
		Left = 348, ;
		Name = "txtDesc", ;
		Top = 72, ;
		Visible = .F., ;
		Width = 300
		*< END OBJECT: BaseClass="editbox" />
	
	PROCEDURE Init
		PARAMETERS vcEmailTo 
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		ThisForm.Height = 66
		
		IF VARTYPE(vcEmailTo) = "C"
			ThisForm.cEmailTo = vcEmailTo 
			ThisForm.Caption = ThisForm.Caption+" for "+vcEmailTo 
		ELSE
			ThisForm.cEmailTo = ''
		ENDIF
		
		ThisForm.AlwaysOnTop = .T.
		ThisForm.AlwaysOnTop = .F.
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.dtStart = DATETIME()
	ENDPROC

	PROCEDURE refreshtables
		*ThisForm.RefreshTables()
		
		ThisForm.Grid1.RecordSource = ''
		IF USED('tmpData')
			USE IN tmpData
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC, cUser, cNetworkUser
		cNetworkUser = SYS(0)
		cUser = 'WINDFALL\'+ RIGHT(cNetworkUser,LEN(cNetworkUser)-AT("#",cNetworkUser)-1)
		
		*cSQL = "SELECT CAST(Recipients AS CHAR(30)) AS Recipnts,CAST([Subject] as CHAR(20)) AS [Subjt],Send_Request_Date FROM MSDB.dbo.sysmail_faileditems as items WHERE items.send_request_date > GETDATE()-7 AND Send_Request_User = '"+cUser+"'"
		cSQL = "SELECT CAST(Recipients AS CHAR(30)) AS SendTo,CAST([Subject] as CHAR(20)) AS [Subjt],Send_Request_Date FROM MSDB.dbo.sysmail_faileditems as items WHERE items.send_request_date > CURRENT_TIMESTAMP-.05 AND Send_Request_User = '"+cUser+"'"
		IF NOT EMPTY(ThisForm.cEmailTo)
			cSQL = cSQL +" AND Recipients = '"+ALLTRIM(ThisForm.cEmailTo)+"'"
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpData')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpData' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesPartNo")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSalesPartNo")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpData' )
		ENDIF
		
		IF USED('tmpData')
			IF RECCOUNT('tmpData') > 0
				ThisForm.Grid1.RecordSource = 'tmpData'
				ThisForm.Grid1.Visible = .T.
				
				ThisForm.Height = 246
				
			ELSE
				ThisForm.Grid1.Visible = .F.
			ENDIF
		ELSE
			ThisForm.Grid1.Visible = .F.
		ENDIF
		
		
		
		*The mail could not be sent to the recipients because of the mail server failure. (Sending Mail using Account 3 (2009-01-27T13:40:47). Exception Message: Cannot send mails to mail server. (Mailbox unavailable. The server response was: 5.1.1 <davidkirchner@yahoocom> recipient invalid domain). )
		
		IF USED('tmpDataError')
			USE IN tmpDataError
		ENDIF
		
		SELECT 0
		*cSQL = "SELECT [description] FROM MSDB.dbo.sysmail_event_log WHERE Last_Mod_date  > CURRENT_TIMESTAMP-.05 AND Event_Type = 'error'"
		cSQL = "SELECT TOP 1 [description] FROM MSDB.dbo.sysmail_event_log WHERE Last_Mod_date  > CURRENT_TIMESTAMP-.05 AND Event_Type = 'error' ORDER BY Log_Date DESC"
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDataError')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpDataError' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDataError")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDataError")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpDataError' )
		ENDIF
		
		IF USED('tmpDataError')
			IF RECCOUNT('tmpDataError') > 0
				ThisForm.txtDesc.Value= tmpDataError.description
				ThisForm.txtDesc.Visible = .T.
				ThisForm.lbl10Min.Caption = "You can Quit now that you have seen the Error!"
				ThisForm.lbl10Min.ForeColor = RGB(255,0,0)
				
				ThisForm.Height = 246
				
			ELSE
				ThisForm.txtDesc.Visible = .F.
			ENDIF
		ELSE
			ThisForm.txtDesc.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmpData')
			USE IN tmpData
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdRefresh.Click
		ThisForm.RefreshTables()
	ENDPROC

	PROCEDURE cmdSQLEmailReport.Click
		DO FORM Reports\R_SQL_Email
	ENDPROC

	PROCEDURE Timer1.Timer
		
		ThisForm.lblSeconds.Caption = STR( (DATETIME() - ThisForm.dtStart))
		
		IF ThisForm.txtDesc.Visible
			*Keep Till manually closed
		ELSE
			
			IF DATETIME() - ThisForm.dtStart > 600  &&10 Min
				ThisForm.Release
			ENDIF
			
			ThisForm.RefreshTables()
			
		ENDIF
	ENDPROC

ENDDEFINE
