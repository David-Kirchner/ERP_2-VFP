	PROCEDURE Destroy
		SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE Init
		PARAMETER pParameter
		*DO FORM Forms\SourcePH WITH SourcePH_ID OR Company
		
		PRIVATE nID
		nID = 0
		
		IF VARTYPE(pParameter) = "N"
			nID = pParameter
			IF nID > 0
				SELECT SourcePH
				LOCATE FOR ID = nID
				
				IF NOT FOUND()
					MESSAGEBOX("ID "+ALLTRIM(STR(nID))+" was not found",0,"SourcePH not found!")
				ENDIF	
			ENDIF
		ENDIF
		IF VARTYPE(pParameter) = "C"
			SELECT SourcePH
			LOCATE FOR UPPER(Company) = UPPER(ALLTRIM( pParameter))
			
			IF NOT FOUND()
				MESSAGEBOX("Company "+ALLTRIM(pParameter)+" was not found",0,"SourcePH not found!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		
		
		ThisForm.nConnHandle  = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle  < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('SourcePH')	
			USE IN SourcePH
		ENDIF
		
		cSQL = "SELECT * FROM dbo.SourcePH ORDER BY Company"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'SourcePH')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'SourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'SourcePH')
		ELSE
			*SELECT SourcePH
		ENDIF
		
	ENDPROC

	PROCEDURE refreshtable
		PARAMETERS pRecNo
		*ThisForm.RefreshTable( RECNO() )
		IF VARTYPE(pRecNo) != "N"
			pRecNo = 0
		ENDIF
		
		IF USED('SourcePH')	
			USE IN SourcePH
		ENDIF
		
		cSQL = "SELECT * FROM dbo.SourcePH ORDER BY Company"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'SourcePH')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'SourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'SourcePH')
		ENDIF
		
		DO CASE
		CASE pRecNo = -1
			GO BOTTOM
		CASE pRecNo = 0
			* do not move
		CASE pRecNo <= RECCOUNT('SourcePH')
			GOTO pRecNo
		ENDCASE
		
		ThisForm.ID1.Refresh
		ThisForm.Company1.Refresh
		ThisForm.Phone1.Refresh
		ThisForm.Fax1.Refresh
		ThisForm.Person1.Refresh
		ThisForm.Email.Refresh
		ThisForm.Email2.Refresh
		ThisForm.INACTIVE1.Refresh
	ENDPROC

	PROCEDURE reload
		PARAMETERS pnID
		*ThisForm.Reload(nID)
		
		PRIVATE nnID_Sources
		IF VARTYPE(pnID_Sources) = "N"
			nID = pnID
		ELSE
			nID = 0
		ENDIF
			
		PRIVATE nSQLEXEC, cSQL
		IF USED('SourcePH')	
			USE IN SourcePH
		ENDIF
		
		cSQL = "SELECT * FROM dbo.SourcePH ORDER BY Company"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'SourcePH')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'SourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle , nSQLEXEC, 'SourcePH')
			RETURN
		ELSE
			*Code is also used in RefreshReceiving and Reload
			SELECT SourcePH
			*INDEX ON ID TAG rID
		*	INDEX ON UPPER(Company) TAG UppCompany
		*	SET ORDER TO TAG UppCompany
			
			IF nID > 0
				LOCATE FOR ID = nID
				IF NOT FOUND()
					IF RECNO(0) > 0
						GO RECNO(0)
					ENDIF
				ENDIF
			ENDIF
		
		ENDIF
		
		ThisForm.BUTTONSET1.NavRefresh()
		
	ENDPROC

	PROCEDURE resetform
		*ThisForm.ResetForm
		
		ThisForm.ID1.Value = 0
		ThisForm.Company1.Value = ''
		ThisForm.Phone1.Value = ''
		ThisForm.Fax1.Value = ''
		ThisForm.Person1.Value = ''
		ThisForm.Email1.Value = ''
		ThisForm.Email2.Value = ''
		ThisForm.INACTIVE1.Value = 0
		
	ENDPROC

	PROCEDURE saveadd
		PARAMETERS pWhat
		*ThisForm.SaveAdd()  'Add' 'Save'
		
		IF VARTYPE( pWhat ) != 'C'
			pWhat = ''
		ENDIF
		
		IF EMPTY(pWhat)
			RETURN .F.
		ENDIF
		
		IF UPPER(pWhat) = "ADD"
			PRIVATE nNewID
			nNewID = 0
		
			PRIVATE nSQLEXEC, cSQL
			IF USED('ID_SourcePH')	
				USE IN ID_SourcePH
			ENDIF
		
			cSQL = "EXEC [dbo].[p_SourcePH_ins] "
			cSQL = cSQL + "@Company='"+''+"'"
			cSQL = cSQL + ",@Phone='"+''+"'"
			cSQL = cSQL + ",@Fax='"+''+"'"
			cSQL = cSQL + ",@Person='"+''+"'"
			cSQL = cSQL + ",@Email='"+''+"'"
			cSQL = cSQL + ",@Email2='"+''+"'"
				
			SELECT 0
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'ID_SourcePH')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'ID_SourcePH')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ID_SourcePH")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ID_SourcePH")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'ID_SourcePH')
				MESSAGEBOX('Unable to Add SQL record',0+48,'Error')
				RETURN
			ELSE
				IF USED('ID_SourcePH')
					IF VARTYPE(ID_SourcePH.EXP) = "N"
						nNewID = ID_SourcePH.EXP
						ThisForm.ID1.Value = nNewID
					ENDIF
					USE IN ID_SourcePH
				ENDIF
			ENDIF
		
			IF nNewID > 0
				ThisForm.Reload( nNewID )
			ENDIF
		
		ENDIF
		IF UPPER(pWhat) = "SAVE"
			PRIVATE nRecNum
			nRecnum = RECNO()
			
			PRIVATE nID,cCompany,cPhone,cFax,cPerson,cEmail,cEmail2,lInActive
			
			nID			= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
			cCompany	= PrepareSQLtxt(ThisForm.Company1.Value,'Company',30)
			cPhone		= PrepareSQLtxt(ThisForm.Phone1.Value,'Phone',10)
			cFax		= PrepareSQLtxt(ThisForm.Fax1.Value,'Fax',10)
			cPerson		= PrepareSQLtxt(ThisForm.Person1.Value,'Person',15)
			cEmail		= PrepareSQLtxt(ThisForm.Email.Value,'Person',50)
			cEmail2		= PrepareSQLtxt(ThisForm.Email2.Value,'Email2',50)
			lInActive	= PrepareSQLlogic(ThisForm.INACTIVE1.Value,'Inactive')
		
			cSQL = "UPDATE dbo.SourcePH SET "
			cSQL = cSQL + "	[Company]='"+cCompany+"'"
			cSQL = cSQL + ",[Phone]='"+cPhone+"'"
			cSQL = cSQL + ",[Fax]='"+cFax+"'"
			cSQL = cSQL + ",[Person]='"+cPerson+"'"
			cSQL = cSQL + ",[Email]='"+cEmail+"'"
			cSQL = cSQL + ",[Email2]='"+cEmail2+"'"
			cSQL = cSQL + ",[InActive]="+IIF(lInActive,"1","0")
			cSQL = cSQL + " WHERE [ID] = "+STR( nID )
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC )
			ENDIF
			
			*************Reload********
			ThisForm.RefreshTable(nRecnum )
		ENDIF
	ENDPROC

	PROCEDURE saverecord
		*ThisForm.SaveRecord()
		
		PRIVATE cCompany,cPhone,cFax,cPerson,cEmail,cEmail2, nID, lInActive
		
		cCompany	= PrepareSQLtxt(ThisForm.Company1.Value,'Company',30)
		cPhone		= PrepareSQLtxt(ThisForm.Phone1.Value,'Phone',10)
		cFax		= PrepareSQLtxt(ThisForm.Fax1.Value,'Fax',10)
		cPerson		= PrepareSQLtxt(ThisForm.Person1.Value,'Person',15)
		cEmail		= PrepareSQLtxt(ThisForm.Email.Value,'Person',50)
		cEmail2		= PrepareSQLtxt(ThisForm.Email2.Value,'Email2',50)
		nID			= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		lInActive	= PrepareSQLlogic(ThisForm.INACTIVE1.Value,'Inactive')
		
		
		cSQL = "UPDATE dbo.SourcePH SET "
		cSQL = cSQL + "	[Company]='"+cCompany+"'"
		cSQL = cSQL + ",[Phone,]='"+cPhone+"'"
		cSQL = cSQL + ",[Fax,]='"+cFax+"'"
		cSQL = cSQL + ",[Person,]='"+cPerson+"'"
		cSQL = cSQL + ",[Email]='"+cEmail+"'"
		cSQL = cSQL + ",[Email2]='"+cEmail2+"'"
		cSQL = cSQL + ",[InActive]="+IIF(lInActive,"1","0")
		cSQL = cSQL + " WHERE [ID] = "+STR( nID )
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL  )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle , nSQLEXEC )
		ENDIF
		
		ThisForm.Reload(nID)
		
	ENDPROC

	PROCEDURE Unload
		IF USED('SourcePH')
			USE IN SourcePH
		ENDIF
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdAdd.Click
		IF THIS.Caption = "\<Add"
			*ThisForm.cmbCompany.Enabled = .T.
		ELSE
			*ThisForm.cmbCompany.Enabled = .F.
		ENDIF
		
		DO CASE
		CASE THIS.Parent.EditMode
		
			** Code for saving record
			*ThisForm.SaveRecord()
			ThisForm.SaveAdd("Save")
			
		CASE EMPTY(THIS.Parent.GridRef)		&& not using Grid object
		
			** Code for adding record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
			ThisForm.SaveAdd("Add")
			
		OTHERWISE
		
			** Code for adding record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
			lPrimeKey = .F.					&&is child key primary index
			ThisForm.SaveAdd("Add")
			
		ENDCASE
		
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = THIS.Parent.EditMode
		THIS.Parent.TopFile = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		THISFORM.LockScreen = .F.
		ThisForm.ID1.Enabled = .F.
	ENDPROC

	PROCEDURE BUTTONSET1.cmdDelete.Click
		IF MESSAGEBOX( "Are you sure you want to Delete?",4+32,"DELETE") != 6
			RETURN .F.
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		
		***Double check for Duplicates
		IF USED('tmpCntSourcePH')
			USE IN tmpCntSourcePH
		ENDIF
		
		PRIVATE cCompany, cPerson, nID, nNewID
		nNewID = 0
		SELECT 0
		
		cCompany	= SourcePH.Company
		cPerson		= SourcePH.Person
		nID			= SourcePH.ID
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.SourcePH WHERE Company = '"+cCompany+"'"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCntSourcePH')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCntSourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSourcePH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle , nSQLEXEC, 'tmpCntSourcePH')
			RETURN  .F.
		ELSE
			IF USED('tmpCntSourcePH')
				IF tmpCntSourcePH.CNTD > 1
					*Found More than 1
					*MESSAGEBOX("This Company was found "+ALLTRIM(STR(tmpCntSourcePH.CNTD)+" times."+CHR(13)+"Are you Deleteing redundant records?")
					*assume they want to delete out redundant records. 
					*Find Lowest ID# to update Sources ID with as replacement for deleted.
					IF USED('tmpTOPCntSourcePH')
						USE IN tmpTOPCntSourcePH
					ENDIF
					
					cSQL = "SELECT TOP 1 ID FROM dbo.SourcePH WHERE Company = '"+cCompany+"'" 
					cSQL = cSQL +" AND ID <> "+ALLTRIM(STR(nID))
			
					SELECT 0
					nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpTOPCntSourcePH')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpTOPCntSourcePH')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTOPCntSourcePH")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTOPCntSourcePH")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC, 'tmpTOPCntSourcePH')
						RETURN .F.
					ELSE
						IF USED('tmpTOPCntSourcePH')
							nNewID = tmpTOPCntSourcePH.ID
							USE IN tmpTOPCntSourcePH
						ENDIF
					ENDIF
					
					IF nNewID > 0
						cSQL = "UPDATE dbo.Sources "
						cSQL = cSQL + " SET ID = "+STR(nNewID)
						cSQL = cSQL + " WHERE ID = "+STR(nID)
							
						nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL,THISFORM.nConnHandle , nSQLEXEC )
							RETURN .F.
						ELSE
							*Sources are correct - delete now
							*OK to delete
							
							
						ENDIF
					ENDIF			
				ENDIF
				USE IN tmpCntSourcePH
			ENDIF
		ENDIF
		
		
		*****
		*is ID Still used in Sources?
		
		IF USED('tmpCntSources')
			USE IN tmpCntSources
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.Sources WHERE ID = "+STR(nID)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCntSources')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpCntSources')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSources")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSources")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,THISFORM.nConnHandle , nSQLEXEC, 'tmpCntSources')
		ELSE
			IF USED('tmpCntSources')
				IF tmpCntSources.CNTD > 0
					MESSAGEBOX("This record is being used in 'Sources'!"+CHR(13)+CHR(13)+"If this is a duplicate you are trying to delete:"+CHR(13)+"Delete the highest ID first or"+CHR(13)+"Rename this company to match the duplicate record"+CHR(13)+"then the sources will updated to use the similiar record allowing this record to be deleted.",0+32,"Cannot Delete")
					RETURN .F.
				ENDIF
				USE IN tmpCntSources
			ENDIF
		ENDIF
		
		
		PRIVATE nNextID
		nNextID = ThisForm.ID1.Value
		
		IF nNextID > 0
			
		
			cSQL = "DELETE FROM dbo.SourcePH WHERE ID ="+STR(nNextID)
				
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,THISFORM.nConnHandle, nSQLEXEC )
				RETURN
			ELSE
				ThisForm.RefreshTable( RECNO('SourcePH') )
				MESSAGEBOX('Deleted SourcePH ID = '+ALLTRIM(STR(nNextID))+'!',48,'Deleted')
			ENDIF
			
		
		*	IF THISFORM.ShowWindow = 2 
		*		Activate Window (THISFORM.Name)
		*	ENDIF
		ENDIF
	ENDPROC

	PROCEDURE BUTTONSET1.cmdEdit.Click
		IF THIS.Caption = "\<Edit"
			*Stop Editing
		ELSE
			*Revert
			PRIVATE nNewID
			nNewID = ThisForm.ID1.Value 
			
			cSQL = "DELETE dbo.SourcePH "
			cSQL = cSQL + " WHERE [ID] = "+STR( nNewID )
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC )
			ENDIF
			
			ThisForm.Reload(0)
		ENDIF
		
		*!*	** Reverting record
		*!*	IF THIS.Parent.EditMode
		*!*	* Go back to original place
		*!*		SELECT (THIS.Parent.OldAlias)
		*!*		IF RECCOUNT() < THIS.Parent.OldRec	&&added record at EOF()
		*!*			GO TOP
		*!*		ELSE
		*!*			GO THIS.Parent.OldRec
		*!*		ENDIF
		*!*	ELSE
		*!*		THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
		*!*		THIS.Parent.OldRec = RECNO()	&&save record in case reverting
		*!*	ENDIF
		
		** Editing record
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		THISFORM.LockScreen = .F.
		
		ThisForm.ID1.Enabled = .F.
		
		
		
	ENDPROC

ENDDEFINE
