	PROCEDURE getbyid
		PRIVATE cSQL, nSQLEXEC
		
		*ThisForm.ID_Detail_Process
		*ThisForm.ID_Process_History
		*ThisForm.SOitem
		IF ThisForm.Lst = "StockLst"
			cSQL = "SELECT * FROM dbo.[AR.StockLst_Detail_History "
		ELSE
			cSQL = "SELECT * FROM dbo.[AR.BrokerLst_Detail_History "
		ENDIF
		
		IF TYPE("THISFORM.ID_Detail_Process")="N"
		  IF THISFORM.ID_Detail_Process > 0
		 	IF ThisForm.Lst = "StockLst"
				cSQL = "SELECT * FROM dbo.[AR.StockLst_Detail_History WHERE ID_Detail_Process = "+STR(ThisForm.ID_Detail_Process)
			ELSE
				cSQL = "SELECT * FROM dbo.[AR.BrokerLst_Detail_History WHERE ID_Detail_Process = "+STR(ThisForm.ID_Detail_Process)
			ENDIF
		  ENDIF
		ENDIF
		
		IF USED("tmpStockLst_Detail_History")
			SELECT tmpStockLst_Detail_History
		ELSE 
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpStockLst_Detail_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpStockLst_Detail_History')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_Process,THISFORM.ConnHandle, nSQLEXEC, 'tmpStockLst_Detail_History')
		ELSE
			IF USED("tmpStockLst_Detail_History")
				THISFORM.ID_Detail_History= tmpStockLst_Detail_History.ID_Detail
		*		THISFORM.ID = tmpStockLst_Detail.ID
		
				ThisForm.id1.Value			= tmpStockLst_Detail_History.ID
				ThisForm.ID_DETAIL1.value	= tmpStockLst_Detail_History.ID_Detail
				ThisForm.PC1.value			= tmpStockLst_Detail_History.PC
				ThisForm.Size_H1.value		= tmpStockLst_Detail_History.Size_H
				ThisForm.Dim11.value		= tmpStockLst_Detail_History.Dim1
				ThisForm.Size_L1.value		= tmpStockLst_Detail_History.Size_L
				ThisForm.Dim21.value		= tmpStockLst_Detail_History.Dim2
				ThisForm.Dim31.value		= tmpStockLst_Detail_History.Dim3
				ThisForm.Pounds1.value		= tmpStockLst_Detail_History.Weight
				
				*ThisForm.S_QTY.Value		= IIF(ISNULL(tmpStockLst_Detail_History.Weight),0,tmpStockLst_Detail_History.Weight)
				IF NOT ISNULL(tmpStockLst_Detail_History.S_QTY)
					** use QTY
					IF tmpStockLst_Detail_History.S_QTY = tmpStockLst_Detail_History.S_P  &&Had mistakenly saved S as QTY!!!! untill 9/11/2015
						*Use Weight to fill QTY
						ThisForm.S_QTY.Value		= IIF(ISNULL(tmpStockLst_Detail_History.Weight),0,tmpStockLst_Detail_History.Weight)
					ELSE
						* use the correct S_QTY
						ThisForm.S_QTY.Value		= IIF(ISNULL(tmpStockLst_Detail_History.S_P),0,tmpStockLst_Detail_History.S_P)
					ENDIF
				ELSE	
					*Use Weight to fill QTY
					ThisForm.S_QTY.Value		= IIF(ISNULL(tmpStockLst_Detail_History.Weight),0,tmpStockLst_Detail_History.Weight)
				ENDIF
		
		
				ThisForm.Descript1.value	= tmpStockLst_Detail_History.DESCRIPT
				ThisForm.Length1.value		= tmpStockLst_Detail_History.LENGTH
		* depricated		ThisForm.CostValue1.value	= tmpStockLst_Detail_History.CostValue
		* depricated		ThisForm.Unit1.value		= tmpStockLst_Detail_History.Unit
				ThisForm.S_P.Value			= IIF(ISNULL(tmpStockLst_Detail_History.S_P),0,tmpStockLst_Detail_History.S_P)
				ThisForm.InvoiceValue1.Value	= IIF(ISNULL(tmpStockLst_Detail_History.InvoiceValue),0,tmpStockLst_Detail_History.InvoiceValue)
				
				ThisForm.FloorStatus1.value	= tmpStockLst_Detail_History.FloorStatus
				ThisForm.Class1.value		= tmpStockLst_Detail_History.CLASS
				ThisForm.Location1.value	= tmpStockLst_Detail_History.Location
				ThisForm.InvCheck1.value	= tmpStockLst_Detail_History.InvCheck
				ThisForm.chkRandLen.value	= tmpStockLst_Detail_History.RandLen
				ThisForm.chkPrime.value	= tmpStockLst_Detail_History.Prime
				
				ThisForm.Who1.value			= tmpStockLst_Detail_History.Who
				ThisForm.When1.value		= tmpStockLst_Detail_History.When
				
			ELSE
				THISFORM.InitMemVar()
			ENDIF
		
		ENDIF
		
		IF USED("tmpStockLst_Detail_History")
			USE IN tmpStockLst_Detail_History
		ENDIF
		
	ENDPROC

	PROCEDURE getprocess		&& Show in Edit Box
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT DH.What, DH.ID_Detail_History, PH.ID_Process_History, PH.ID_Detail_Process"
		IF ThisForm.Lst = "StockLst"
			cSQL = cSQL + " FROM dbo.[AR.StockLst_Detail_History DH, dbo.[AR.StockLst_Process_History PH "
		ELSE
			cSQL = cSQL + " FROM dbo.[AR.BrokerLst_Detail_History DH, dbo.[AR.BrokerLst_Process_History PH "
		ENDIF
		cSQL = cSQL + " WHERE PH.SOitem = '"+ThisForm.SOitem+"' AND DH.ID_Detail_Process = PH.ID_Detail_Process "
		cSQL = cSQL + " AND DH.WHAT != 'BEFOREEDIT'"
		
		IF USED("tmpStockLst_Detail")
			USE IN tmpStockLst_Detail
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpStockLst_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpStockLst_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_Process,THISFORM.ConnHandle,nSQLEXEC, 'tmpStockLst_Detail')
		ELSE
			IF USED("tmpStockLst_Detail")
				
				*INITIALIZE to first record
				SELECT tmpStockLst_Detail
				GO TOP
				IF NOT EOF()
				
					THISFORM.ID_Process_History = tmpStockLst_Detail.ID_Process_History
					THISFORM.ID_Detail_Process = tmpStockLst_Detail.ID_Detail_Process
					
					DIMENSION gaPOIprocess(1)
					gaPOIprocess(1) = ""
		
					*SELECT What, ID_Detail_History, ID_Process_History FROM tmpStockLst_Detail INTO ARRAY gaPOIprocess
					SELECT STR(ID_Process_History,12)+" "+What FROM tmpStockLst_Detail INTO ARRAY gaPOIprocess
					
					ThisForm.lstPOIProcess.NumberOfElements = ALEN(gaPOIprocess,1)
		*			ThisForm.lstPOIProcess.RowSource = gaPOIprocess
					ThisForm.lstPOIProcess.REFRESH
					ThisForm.lstPOIProcess.Enabled = .T.
					
					
				ELSE
					ThisForm.lstPOIProcess.Enabled = .F.
				ENDIF
			ELSE
				ThisForm.lstPOIProcess.Enabled = .F.
			ENDIF
		ENDIF
		IF USED("tmpStockLst_Detail")
			USE IN tmpStockLst_Detail
		ENDIF
		
	ENDPROC

	PROCEDURE getsoitem		&& Parameter nID_Detail_Process
		PARAMETER nID_Detail_Process
		*ThisForm.GetSOitem(pnID_Detail_Process)
		
		PRIVATE cSQL, nSQLEXEC
		
		IF ThisForm.Lst = "StockLst"
			cSQL = "SELECT SOitem FROM dbo.StockLst_Process WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		ELSE
			cSQL = "SELECT SOitem FROM dbo.BrokerLst_Process WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		ENDIF
		
		IF USED("tmpStockLst_Process")
			USE IN tmpStockLst_Process 
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpStockLst_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpStockLst_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_Process,THISFORM.ConnHandle,nSQLEXEC, 'tmpStockLst_Process' )
		ELSE
			IF USED("tmpStockLst_Process")
				SELECT tmpStockLst_Process
				GO TOP
				ThisForm.SOitem = tmpStockLst_Process.SOitem
			ELSE
				MESSAGEBOX("No SO Item Found",0,"Error getting SO item?")
			ENDIF
		ENDIF
		IF USED("tmpStockLst_Process")
			USE IN tmpStockLst_Process 
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETER pcSOitem, pnID_Detail_Process, pLst
		*DO FORM Forms\StockLst_Detail_History WITH '  44756-01'
		
		IF TYPE("pcSOitem") <> "C" 
			MESSAGEBOX("Send Parameter 'SO-Item'",0, "Bad Parameter")
			CANC
		ENDIF
		
		ThisForm.SOitem = pcSOitem
		
		IF VARTYPE(pLst) != "C"
			pLst = "StockLst"
		ENDIF
		
		IF pLst = "StockLst"
			ThisForm.txtLst.Value = "StockLst"
			ThisForm.Lst 		  = "StockLst"
		ELSE
			ThisForm.txtLst.Value = "BrokerLst"
			ThisForm.Lst 		  = "BrokerLst"
		ENDIF
		
		PUBLIC ARRAY gaPOIprocess(1)
		gaPOIprocess(1) = ""
		
		PUBLIC m.ID
		PUBLIC m.ID_Detail
		PUBLIC m.PC
		PUBLIC m.Size_H
		PUBLIC m.Dim1
		PUBLIC m.Size_L
		PUBLIC m.Dim2
		PUBLIC m.Dim3
		PUBLIC m.Weight
		PUBLIC m.Descript
		PUBLIC m.Length
		PUBLIC m.FloorStatus
		PUBLIC m.Class
		PUBLIC m.Location
		PUBLIC m.InvCheck
		
		IF EMPTY(pcSOitem)
			IF TYPE("pnID_Detail_Process") = "N"
				ThisForm.GetSOitem(pnID_Detail_Process)
			ELSE
				MESSAGEBOX("Send Parameter 'SO-Item',nID_Detail_Process,'StockLst'",0, "Bad Parameter")
				CANC
			ENDIF
		ENDIF
		
		IF TYPE("pnID_Detail_Process") = "N"
			ThisForm.ID_Detail_Process = pnID_Detail_Process
		ENDIF
		
		ThisForm.GetProcess()
		ThisForm.GetByID()
		
		
	ENDPROC

	PROCEDURE initmemvar
		ThisForm.id1.Value			= 0
		ThisForm.ID_DETAIL1.value	= THISFORM.ID_Detail_History
		ThisForm.PC1.value			= 1
		ThisForm.Size_H1.value		= 0
		ThisForm.Dim11.value		= 0
		ThisForm.Size_L1.value		= 0
		ThisForm.Dim21.value		= 0
		ThisForm.Dim31.value		= 0
		ThisForm.Pounds1.value		= 0
		ThisForm.S_QTY.Value		= 0
		ThisForm.Descript1.value	= ""
		ThisForm.Length1.value		= ""
		*ThisForm.CostValue1.value	= 0
		*ThisForm.Unit1.value		= ""
		ThisForm.S_P.Value			= 0
		ThisForm.InvoiceValue1.Value	= 0
		ThisForm.FloorStatus1.value	= ""
		ThisForm.Class1.value		= ""
		ThisForm.Location1.value	= ""
		ThisForm.InvCheck1.value	= CTOD('')
		
		ThisForm.Who1.value			= ""
		ThisForm.When1.value		= CTOD('')
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.ConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.ConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.ConnHandle )
		
		
		RETURN &&ThisForm.ID_Detail
	ENDPROC

	PROCEDURE cmdAbort.Click
		ThisForm.ID_Detail_History = 0
		ThisForm.Release
	ENDPROC

	PROCEDURE DIM11.Valid
		IF This.Value > 0
			IF ThisForm.Size_H1.Value > 0
				IF ThisForm.Size_H1.Value < This.Value
					MESSAGEBOX( "The High Tolerance is usually above the Dim 1.",0,"Caution")
				ENDIF
			ENDIF
			IF ThisForm.Size_L1.Value > 0
				IF ThisForm.Size_L1.Value > This.Value
					MESSAGEBOX( "The Low Tolerance is usually below the Dim 1.",0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The Dim 1 is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE InvoiceValue1.GotFocus
		this.InputMask = ""
	ENDPROC

	PROCEDURE InvoiceValue1.LostFocus
		this.InputMask = "99,999,999.9999"
	ENDPROC

	PROCEDURE lblQuantity.Click
		ThisForm.GetWeight("S_QTY")
	ENDPROC

	PROCEDURE lstPOIProcess.Click
		PRIVATE nID_Process_History,cWhat
		nID_Process_History = VAL(LEFT(This.Value,12))
		cWhat = RIGHT(This.Value,LEN(This.Value)-13 )
		
		*StockLst_Detail_History from ID_Process_History
		*select * from dbo.[AR.StockLst_Process_History WHERE ID_Process_History = 
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT DH.*, PH.ID_Process_History "
		 IF ThisForm.Lst = "StockLst"
			cSQL = cSQL + " FROM dbo.[AR.StockLst_Detail_History DH"
		ELSE
			cSQL = cSQL + " FROM dbo.[AR.BrokerLst_Detail_History DH"
		ENDIF
		cSQL = cSQL + ",dbo.[AR.StockLst_Process_History PH  "
		cSQL = cSQL + " WHERE DH.ID_Detail_Process = PH.ID_Detail_Process "
		cSQL = cSQL + " AND ID_Process_History = "+STR(nID_Process_History)
		cSQL = cSQL + " AND DH.WHAT = '"+cWhat +"'"
		
		IF USED("tmpStockLst_Detail_History")
			SELECT tmpStockLst_Detail_History
		ELSE 
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpStockLst_Detail_History')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.ConnHandle, cSQL, 'tmpStockLst_Detail_History')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail_History")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail_History")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_Process,THISFORM.ConnHandle, nSQLEXEC, 'tmpStockLst_Detail_History')
		ELSE
			IF USED("tmpStockLst_Detail_History")
				THISFORM.ID_Detail_History	= tmpStockLst_Detail_History.ID_Detail
				*THISFORM.ID 				= tmpStockLst_Detail_History.ID
		
				ThisForm.id1.Value			= tmpStockLst_Detail_History.ID
				ThisForm.ID_DETAIL1.value	= tmpStockLst_Detail_History.ID_Detail
				ThisForm.PC1.value			= tmpStockLst_Detail_History.PC
				ThisForm.Size_H1.value		= tmpStockLst_Detail_History.Size_H
				ThisForm.Dim11.value		= tmpStockLst_Detail_History.Dim1
				ThisForm.Size_L1.value		= tmpStockLst_Detail_History.Size_L
				ThisForm.Dim21.value		= tmpStockLst_Detail_History.Dim2
				ThisForm.Dim31.value		= tmpStockLst_Detail_History.Dim3
				ThisForm.S_QTY.Value		= IIF(ISNULL(tmpStockLst_Detail_History.S_QTY),0,tmpStockLst_Detail_History.S_QTY)
				ThisForm.Pounds1.value		= tmpStockLst_Detail_History.Weight
				ThisForm.Descript1.value	= tmpStockLst_Detail_History.DESCRIPT
				ThisForm.Length1.value		= tmpStockLst_Detail_History.LENGTH
		* depricated		ThisForm.CostValue1.value	= tmpStockLst_Detail_History.CostValue
		* depricated		ThisForm.Unit1.value		= tmpStockLst_Detail_History.Unit
				ThisForm.S_P.Value			= IIF(ISNULL(tmpStockLst_Detail_History.S_P),0,tmpStockLst_Detail_History.S_P)
				ThisForm.InvoiceValue1.Value	= IIF(ISNULL(tmpStockLst_Detail_History.InvoiceValue),0,tmpStockLst_Detail_History.InvoiceValue)
				
				ThisForm.FloorStatus1.value	= tmpStockLst_Detail_History.FloorStatus
				ThisForm.Class1.value		= tmpStockLst_Detail_History.CLASS
				ThisForm.Location1.value	= tmpStockLst_Detail_History.Location
				ThisForm.InvCheck1.value	= tmpStockLst_Detail_History.InvCheck
				ThisForm.chkRandLen.value	= tmpStockLst_Detail_History.RandLen
				ThisForm.chkPrime.value		= tmpStockLst_Detail_History.Prime
				
				ThisForm.Who1.value			= tmpStockLst_Detail_History.Who
				ThisForm.When1.value		= tmpStockLst_Detail_History.When
				
			ELSE
				THISFORM.InitMemVar()
			ENDIF
		
		ENDIF
		
		IF USED("tmpStockLst_Detail_History")
			USE IN tmpStockLst_Detail_History
		ENDIF
		
	ENDPROC

	PROCEDURE SIZE_H1.Valid
		PRIVATE nSize_H1 
		
		nSize_H1 = This.Value
		IF VARTYPE(nSize_H1) != 'N'
			This.Value = 0
			nSize_H1  = 0
		ENDIF
			
		IF nSize_H1  > 0
			IF ThisForm.DIM11.Value > 0
				IF ThisForm.DIM11.Value > This.Value
					MESSAGEBOX( "The High Tolerance is usually higher than the Dim 1",0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF nSize_H1 < 0
				MESSAGEBOX( "The High Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE SIZE_L1.Valid
		IF This.Value > 0
			IF ThisForm.DIM11.Value > 0
				IF ThisForm.DIM11.Value < This.Value
					MESSAGEBOX( "The Low Tolerance is usually below the Dim 1",0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The Low Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE S_P.GotFocus
		this.InputMask = ""
	ENDPROC

	PROCEDURE S_P.LostFocus
		this.InputMask = "99,999,999.9999"
	ENDPROC

	PROCEDURE S_QTY.GotFocus
		this.InputMask = "99999999.99"
	ENDPROC

	PROCEDURE S_QTY.LostFocus
		this.InputMask = "99,999,999.99"
	ENDPROC

ENDDEFINE
