				IF NOT EMPTY(m.CoverEmail)
					m.SendToEmail = ALLTRIM(m.SendToEmail)+";"+m.CoverEmail
				ENDIF
				ThisForm.Send_SQL_Email(m.SendFromEmail, m.SendToEmail, m.MsgSubject ,m.MsgNoteText)
				
