				IF NOT EMPTY(cAns)
					MESSAGEBOX( cAns,0,"SQL Returned Message!")
				ELSE
					WAIT WINDOW "Email 2 Complete" NOWAIT
					TrackMess("Inquire "+cInqNumP+" was Emailed to ("+cEmailTo+") from ("+cEmailFrom+") on ("+DTOC(DATE())+")"  )
				ENDIF
