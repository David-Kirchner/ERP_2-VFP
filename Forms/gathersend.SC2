	ENDPROC

	PROCEDURE cmdSave.Valid
		PRIVATE m.icompany, m.phone, m.faxnm, m.iperson, m.Email, m.Email2
		PRIVATE nVendCode
		nVendCode = ThisForm.nVendCode
		
		WAIT WINDOW 'SAVING' NOWAIT
		m.icompany= PrepareSQLtxt(ThisForm.txtGCompany.Value,'Company',30)
		m.phone = PrepareSQLtxt(ThisForm.txtGPhone.Value,'Phone',11)
		m.faxnm = PrepareSQLtxt(ThisForm.txtGFax.Value,'Fax',11)
		m.iperson= PrepareSQLtxt(ThisForm.txtGPerson.Value,'Name',15)
		m.Email = PrepareSQLtxt(ThisForm.txtGEmail.Value,'Email',60)
		m.Email2 = PrepareSQLtxt(ThisForm.txtGEmail2.Value,'Email',60)
		
		
		IF EMPTY(m.icompany)
			MESSAGEBOX("Bad company name",0,"Can not Save")
			RETURN
		ENDIF
		
		IF LEFT(m.phone,1) = "1"
			m.phone = SUBSTR(m.phone,2,10)
		ELSE
			m.phone = LEFT(m.phone,10)
		ENDIF
		
		IF LEFT(m.faxnm,1) = "1"
			m.faxnm = SUBSTR(m.faxnm,2,10)
		ELSE
			m.faxnm = LEFT(m.faxnm,10)
		ENDIF
		
		
		*!*	IF EMPTY(m.phone)
		*!*		MESSAGEBOX("Bad PHONE number",0,"Can not Save phone!")
		*!*	ENDIF
		
		*!*	IF EMPTY(m.faxnm)
		*!*		MESSAGEBOX("Bad FAX number",0,"Can not Save Fax!")
		*!*	ENDIF
		
		*!*	IF EMPTY(m.Email)
		*!*		MESSAGEBOX("Bad EMAIL name",0,"Can not Save Email")
		*!*	ENDIF
		
		*!*	IF !EMPTY(m.Email)
		*!*		IF NOT ( "@" $ m.Email)
		*!*			MESSAGEBOX("Bad EMAIL name"+CHR(13)+"An Email address should have an @ sign.",0,"Can not Save Email")
		*!*			m.Email= ""
		*!*		ENDIF
		*!*	ENDIF
		
		
		
		
		PRIVATE lFoundCompany, cSQL, nSQLEXEC, cSQLu, cSQLi
		lFoundCompany = .F.
		
		
		IF USED('tmpCntSourcePH')
			USE IN tmpCntSourcePH
		ENDIF
		
		SELECT 0
		IF nVendCode > 0
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.SourcePH WHERE VendCode = "+STR(nVendCode)
		ELSE
			cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.SourcePH WHERE Company = '"+ALLTRIM(m.icompany)+"'"
		ENDIF
		
		nSQLEXEC = SQLEXEC(gnConnHandle,cSQL ,"tmpCntSourcePH")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpCntSourcePH' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCntSourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpCntSourcePH")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			SQLEXECError(cRefresh, gnConnHandle, nSQLEXEC, 'tmpCntSourcePH' )
		ENDIF
		
		IF USED("tmpCntSourcePH")
			IF VARTYPE(tmpCntSourcePH.Cntd) = "N"
				IF tmpCntSourcePH.Cntd > 0
					lFoundCompany = .T.
				ENDIF
			ENDIF
			USE IN tmpCntSourcePH
		ENDIF
		
		SELECT 0
		IF lFoundCompany 
			
			cSQLu = "UPDATE dbo.SourcePH SET "
			cSQLu = cSQLu + " phone='"+m.phone+"'"
			cSQLu = cSQLu + ",fax ='"+m.faxnm+"'"
			cSQLu = cSQLu + ",person='"+m.iperson+"'"
			cSQLu = cSQLu + ",email='"+m.Email+"'"
			cSQLu = cSQLu + ",email2='"+m.Email2+"'"
			IF nVendCode > 0
				cSQLu = cSQLu + ",Company='"+ALLTRIM(m.icompany)+"'"
				cSQLu = cSQLu + " WHERE VendCode ="+STR(nVendCode)
			ELSE
				cSQLu = cSQLu + " WHERE Company = '"+ALLTRIM(m.icompany)+"'"
			ENDIF
			
			nSQLEXEC = SQLEXEC(gnConnHandle,cSQLu, '' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQLu, '' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu, gnConnHandle, nSQLEXEC )
			ENDIF
		
		ELSE
			cSQLi = "EXEC [dbo].[p_SourcePH_ins] "
			cSQLi = cSQLi + "@Company='"+m.icompany+"'"
			cSQLi = cSQLi + ",@Phone='"+m.phone+"'"
			cSQLi = cSQLi + ",@fax='"+m.faxnm+"'"
			cSQLi = cSQLi + ",@Person='"+m.iperson+"'"
			cSQLi = cSQLi + ",@Email='"+m.Email+"'"
			cSQLi = cSQLi + ",@Email2='"+m.Email2+"'"
			
			nSQLEXEC = SQLEXEC(gnConnHandle,cSQLi )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQLi, '' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLi, gnConnHandle, nSQLEXEC )
			ENDIF
		ENDIF
		WAIT WINDOW 'SAVED' NOWAIT
		
		*Show after trims
		ThisForm.txtGPerson.Value	= m.iperson
		ThisForm.txtGCompany.Value	= m.icompany
		*ThisForm.txtGPhone.Value	= m.iphone
		*ThisForm.txtGFax.Value		= m.faxnm
		ThisForm.txtGEmail.Value	= m.Email
		ThisForm.txtGEmail2.Value	= m.Email2
		
		This.Enabled = .F.
		SELECT qdb  &&USE &quotedb EXCL ALIAS qdb
		
	ENDPROC

	PROCEDURE cmdSaveAlloy.Valid
		PRIVATE m.icompany, m.alloy, m.phone, m.faxnm, m.iperson, m.Email, m.Email2
		
		WAIT WINDOW 'SAVING' NOWAIT
		m.icompany	= PrepareSQLtxt(ThisForm.txtGCompany.Value,'Company',30)
		m.phone 	= PrepareSQLtxt(ThisForm.txtGPhone.Value,'Phone',11) &&Add 1 for Long Distance
		m.faxnm 	= PrepareSQLtxt(ThisForm.txtGFax.Value,'Fax',11)	&&Add 1 for Long Distance
		m.iperson	= PrepareSQLtxt(ThisForm.txtGPerson.Value,'Name',15)
		m.Email 	= PrepareSQLemail(ThisForm.txtGEmail.Value,'Email',60)
		m.Email2 	= PrepareSQLemail(ThisForm.txtGEmail2.Value,'Email',60)
			
		m.alloy= PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		
		IF EMPTY(m.Alloy)
			MESSAGEBOX("Bad Alloy name",0,"Can not Save")
			RETURN
		ENDIF
		
		IF EMPTY(m.icompany)
			MESSAGEBOX("Bad company name",0,"Can not Save")
			RETURN
		ENDIF
		
		IF LEFT(m.phone,1) = "1"
			m.phone = RIGHT(m.phone,10)
		ELSE
			m.phone = LEFT(m.phone,10)
		ENDIF
		
		IF LEFT(m.faxnm,1) = "1"
			m.faxnm = RIGHT(m.faxnm,10)
		ELSE
			m.faxnm = LEFT(m.faxnm,10)
		ENDIF
		
		
		PRIVATE lFoundCompany
		lFoundCompany = .F.
		PRIVATE  cSQL, nSQLEXEC, cSQLu, cSQLi
		PRIVATE lSaveGood
		lSaveGood = .T.
		
		IF USED('tmpCntSourcePH')
			USE IN tmpCntSourcePH
		ENDIF
		
		SELECT 0
		cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.SourcePH WHERE Company = '"+ALLTRIM(m.icompany)+"'"
		
		nSQLEXEC = SQLEXEC(gnConnHandle, cSQL ,"tmpCntSourcePH")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCntSourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntSourcePH")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 1
			SQLEXECError(cRefresh, gnConnHandle, nSQLEXEC, 'tmpCntSourcePH' )
		ENDIF
		
		IF USED("tmpCntSourcePH")
			IF VARTYPE(tmpCntSourcePH.Cntd) = "N"
				IF tmpCntSourcePH.Cntd > 0
					lFoundCompany = .T.
				ENDIF
			ENDIF
			USE IN tmpCntSourcePH
		ENDIF
		
		PRIVATE nNewSourcePH_ID 
		nNewSourcePH_ID = 0
		
		IF lFoundCompany 
		
			cSQLu = "UPDATE dbo.SourcePH SET "
			cSQLu = cSQLu + " phone='"+m.phone+"'"
			cSQLu = cSQLu + ",fax ='"+m.faxnm+"'"
			cSQLu = cSQLu + ",person='"+m.iperson+"'"
			cSQLu = cSQLu + ",email='"+m.Email+"'"
			cSQLu = cSQLu + ",email2='"+m.Email2+"'"
			cSQLu = cSQLu + " WHERE Company = '"+ALLTRIM(icompany)+"'"
			
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQLu )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu, gnConnHandle, nSQLEXEC )
				lSaveGood = .F.
			ELSE
				IF USED('tmpNewSourcePH_ID')
					USE IN tmpNewSourcePH_ID
				ENDIF
				SELECT 0
				
				cSQLi = "SELECT ID FROM dbo.SourcePH "
				cSQLi = cSQLi + " WHERE Company='"+m.icompany+"'"
				cSQLi = cSQLi + " AND Phone='"+m.phone+"'"
				cSQLi = cSQLi + " AND fax='"+m.faxnm+"'"
				cSQLi = cSQLi + " AND Person='"+m.iperson+"'"
				cSQLi = cSQLi + " AND Email='"+m.Email+"'"
				cSQLi = cSQLi + " AND Email2='"+m.Email2+"'"
				
				nSQLEXEC = SQLEXEC(gnConnHandle,cSQLi,'tmpNewSourcePH_ID' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQLi, 'tmpNewSourcePH_ID')
				ENDDO
		
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "tmpNewSourcePH_ID")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "tmpNewSourcePH_ID")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
		
				IF nSQLEXEC < 1
					SQLEXECError(cSQLi, gnConnHandle, nSQLEXEC, 'tmpNewSourcePH_ID' )
					lSaveGood = .F.
				ELSE
					IF USED('tmpNewSourcePH_ID')
						IF RECCOUNT('tmpNewSourcePH_ID') > 0
							nNewSourcePH_ID = tmpNewSourcePH_ID.ID
						ENDIF
						USE IN tmpNewSourcePH_ID
					ENDIF
				ENDIF
			ENDIF
		
		ELSE
			IF USED('tmpNewSourcePH_ID')
				USE IN tmpNewSourcePH_ID
			ENDIF
			SELECT 0
			
			cSQLi = "EXEC [dbo].[p_SourcePH_ins] "
			cSQLi = cSQLi + "@Company='"+m.icompany+"'"
			cSQLi = cSQLi + ",@Phone='"+m.phone+"'"
			cSQLi = cSQLi + ",@fax='"+m.faxnm+"'"
			cSQLi = cSQLi + ",@Person='"+m.iperson+"'"
			cSQLi = cSQLi + ",@Email='"+m.Email+"'"
			cSQLi = cSQLi + ",@Email2='"+m.Email2+"'"
			
			nSQLEXEC = SQLEXEC(gnConnHandle,cSQLi,'tmpNewSourcePH_ID' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQLi, 'tmpNewSourcePH_ID')
			ENDDO
		
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "tmpNewSourcePH_ID")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "tmpNewSourcePH_ID")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLi, gnConnHandle, nSQLEXEC, 'tmpNewSourcePH_ID' )
				lSaveGood = .F.
			ELSE
				IF USED('tmpNewSourcePH_ID')
					IF RECCOUNT('tmpNewSourcePH_ID') > 0
						nNewSourcePH_ID = tmpNewSourcePH_ID.EXP
					ENDIF
					USE IN tmpNewSourcePH_ID
				ENDIF
			ENDIF
		ENDIF
		
		IF lSaveGood
		
			PRIVATE cPerson, cLogin
			cLogin = SYS(0)
			cPerson = RIGHT( cLogin, LEN(cLogin) - AT("#",cLogin) -1)
			
			SELECT 0
			cSQLi = cSQLi + "INSERT INTO dbo.Sources"
			cSQLi = cSQLi + "(Alloy,Alloy_AKA,Notes,ID) VALUES ("
			cSQLi = cSQLi + " '"+m.Alloy+"'"
			cSQLi = cSQLi + ",'"+m.Alloy+"'"
			cSQLi = cSQLi + ",'"+ALLTRIM(cPerson)+" Added this Source when sending an Inquire ("+DTOC(DATE())+") Please Edit Details.'"
			cSQLi = cSQLi + ","+STR(nNewSourcePH_ID)
			cSQLi = cSQLi + ")"
			
			nSQLEXEC = SQLEXEC(gnConnHandle,cSQLi,'' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQLi, '')
			ENDDO
		
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQLi, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 1
				SQLEXECError(cSQLi, gnConnHandle, nSQLEXEC )
				lSaveGood = .F.
			ENDIF
		ENDIF
		
		
		IF lSaveGood
			WAIT WINDOW 'SAVED' NOWAIT
		ENDIF
		
		*Show after trims
		ThisForm.txtGPerson.Value	= m.iperson
		ThisForm.txtGCompany.Value	= m.icompany
		*ThisForm.txtGPhone.Value	= m.iphone
		*ThisForm.txtGFax.Value		= m.faxnm
		ThisForm.txtGEmail.Value	= m.Email
		ThisForm.txtGEmail2.Value	= m.Email2
			
		ThisForm.txtGPerson.Refresh
		ThisForm.txtGCompany.Refresh
		*ThisForm.txtGPhone.Refresh
		*ThisForm.txtGFax.Refresh
		ThisForm.txtGEmail.Refresh
		ThisForm.txtGEmail2.Refresh
		
		This.Enabled = .F.
		SELECT qdb  &&USE &quotedb EXCL ALIAS qdb
		
	ENDPROC

	PROCEDURE cmdSearchCompany.Click
		PRIVATE cSelectedCompany
		cSelectedCompany = ""
		
		DO FORM Forms\SelectSourceCompany.SCX TO cSelectedCompany
		
		
		IF NOT EMPTY( cSelectedCompany )
			m.txtGperson  = SUBSTR( cSelectedCompany, 1, 15 )
			m.txtGcompany = SUBSTR( cSelectedCompany, 16, 30 )
			m.txtGphone   = "1"+SUBSTR( cSelectedCompany, 46, 10 )
			m.txtGfax     = "1"+SUBSTR( cSelectedCompany, 56, 10 )
			m.txtGemail   = SUBSTR( cSelectedCompany, 66, 60 )
			m.txtGemail2  = SUBSTR( cSelectedCompany, 126, 60 )
			
			ThisForm.txtGcompany.Value	= PrepareSQLtxt(m.txtGcompany,'Company',30)
			ThisForm.txtGphone.Value 	= PrepareSQLtxt(m.txtGphone,'Phone',11)
			ThisForm.txtGfax.Value   	= PrepareSQLtxt(m.txtGfax,'Fax',11)
			ThisForm.txtGperson.Value	= PrepareSQLtxt(m.txtGperson,'Name',25)
			ThisForm.txtGemail.Value 	= PrepareSQLtxt(m.txtGemail,'Email',60)
			ThisForm.txtGemail2.Value	= PrepareSQLtxt(m.txtGemail2,'Email',60)
		
			ThisForm.CheckMarks()
			
			ThisForm.Refresh()
		ELSE
			WAIT WINDOW 'Did not Receive data!' nowait
		ENDIF
	ENDPROC

	PROCEDURE txtGCompany.InteractiveChange
		ThisForm.cmdSave.Enabled = .T.
	ENDPROC

