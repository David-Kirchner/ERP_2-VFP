	PROCEDURE cmdAccept.Click
		PRIVATE cUserName, lcSendHow
		lcSendHow = ""
		IF NOT EMPTY(ThisForm.SalesP)
			cUserName = AppSetup_Get_UserName(ThisForm.SalesP)
		ELSE
			PRIVATE cMachineInfo 
			cMachineInfo = SYS(0)
			IF cMachineInfo = "1"
				*USER IS NOT LOGGED INTO SERVER!!!
				WAIT WINDOW "No login user name found to list on Inquire" 
				cUserName = " "
			ELSE
				cUserName = RIGHT(cMachineInfo,LEN(cMachineInfo)-AT("#",cMachineInfo) -1 )
				ThisForm.SalesP = AppSetup_Login_SalesP 
			ENDIF
		ENDIF
			
			
			
		PRIVATE m.SendFromEmail, m.CoverEmail
		IF NOT EMPTY(ThisForm.cCover)
			m.SendFromEmail = SalesPEmail(ThisForm.SalesP,ThisForm.cCover,.F.)  &&.T. to use both
			m.CoverEmail = SalesPEmail(ThisForm.cCover)  &&.T. to use both
		ELSE
			m.SendFromEmail = SalesPEmail(ThisForm.SalesP,'')
			m.CoverEmail = ''
		ENDIF
		
		PRIVATE m.txtGcompany, m.txtGphone, m.txtGfax, m.txtGperson, m.txtGemail, m.txtGemail2, m.txtGEmailVC, m.txtGEmailVC2
		
		m.txtGcompany= PrepareSQLtxt(ThisForm.txtGCompany.Value,'Company',30)
		m.txtGphone	 = PrepareSQLtxt(ThisForm.txtGPhone.Value,'Phone',11)
		m.txtGfax    = PrepareSQLtxt(ThisForm.txtGfax.Value,'Fax',11)
		m.txtGperson = PrepareSQLtxt(ThisForm.txtGperson.Value,'Name',25)
		m.txtGemail	 = PrepareSQLtxt(ThisForm.txtGemail.Value,'Email',60)
		m.txtGemail2 = PrepareSQLtxt(ThisForm.txtGemail2.Value,'Email',60)
		m.txtGEmailVC= PrepareSQLtxt(ThisForm.txtGemailVC.Value,'Email',60)
		m.txtGEmailVC2= PrepareSQLtxt(ThisForm.txtGemailVC2.Value,'Email',60)
		
		IF NOT USED('QDBsendto')
			thisform.QDBsendto()
		
			SELECT QDBsendto
			REPLACE QDBsendto.Company 	WITH ThisForm.txtGcompany.VALUE
			REPLACE QDBsendto.fax 		WITH ThisForm.txtGfax.VALUE
			REPLACE QDBsendto.name 		WITH ThisForm.txtGperson.VALUE
			REPLACE QDBsendto.Phone 	WITH ThisForm.txtGphone.VALUE
			*REPLACE phone_ext	WITH ThisForm.txtG.VALUE
			*REPLACE po_num 	WITH ThisForm.txGt.VALUE
			
			IF USED('Quotes')
				REPLACE QDBsendto.SalesP 	WITH Quotes.SalesP
				IF VARTYPE(Quotes.InqNum) = "N"
					REPLACE QDBsendto.InqNum WITH Quotes.InqNum
				ELSE
					REPLACE QDBsendto.InqNum WITH 0
				ENDIF
			ELSE
				REPLACE QDBsendTo.SalesP		WITH ThisForm.SalesP
				REPLACE QDBsendto.InqNum 		WITH 0
			ENDIF
			
		ENDIF
		
		***********************
		
		PRIVATE nLineItems
		nLineItems = 0
		
		SELECT qdb
		COUNT FOR LEFT(LINE,6) = "Alloy:" TO nLineItems
		
		***********************
		***********************
		IF ThisForm.chkPrint.value = 1
			WAIT window 'Printing' NOWAIT
			IF FILE('REPORTS\sndINQUIRE.FRX')
				SELECT qdb
				REPORT FORM 'REPORTS\sndINQUIRE' NOCONSOLE TO PRINTER
				
				WAIT WINDOW 'PRINTED' NOWAIT
			ELSE
				WAIT WINDOW 'Report form not found' NOWAIT
			ENDIF
			SELECT Quotes
			lcSendHow = lcSendHow + "Print "
		ENDIF
		***********************
		***********************
		IF ThisForm.chkFax.VALUE = 1
			WAIT WINDOW 'Fax' NOWAIT
			
			IF FILE('REPORTS\sndINQUIRE.FRX')
				MESSAGEBOX("Choose a Fax Printer."+CHR(13)+"Fax Number:"+m.txtGfax,0,"Print to FAX Printer")
				SELECT qdb
				REPORT FORM 'REPORTS\sndINQUIRE' NOCONSOLE TO PRINTER PROMPT
				
				WAIT WINDOW 'PRINTED' NOWAIT
			ELSE
				WAIT WINDOW 'Report form not found' NOWAIT
			ENDIF
			SELECT Quotes
		
			lcSendHow = lcSendHow + "Fax "
		ENDIF
		
		
		
		*!*		DO wfxpara32 WITH m.txtGfax,m.delytime,(m.DelyDate),m.txtGperson,m.txtGcompany, "inquiry","FAX",m.fxinqnum,"sndinquire",.T.,.T.
		*!*		*PARAMETERxnum,xtime,xdate,xname,xcomp,xsubj,xkeyw,xbill,filename,highsres,prntsetup
		
		PRIVATE cReturnEmailHTML 
		***********************
		*IF ThisForm.chkEmail.VALUE = 1 OR ThisForm.chkEmail2.VALUE = 1
			WAIT WINDOW 'Email' NOWAIT
			PRIVATE txtLine,MachineInfo,cUserName,cCoverName,cReturnEmail,cRefNum
			txtLine = ""
			
			*cReturnEmailHTML = AppSetup_Get_Email(cUserName)
			cReturnEmailHTML = SalesPEmail(ThisForm.SalesP,ThisForm.cCover,.T.)  &&.T. to use both
			cReturnEmail = SalesPEmail(ThisForm.SalesP,ThisForm.cCover,.T.)
			IF NOT EMPTY(cReturnEmailHTML)
				cReturnEmailHTML = ""+cReturnEmailHTML+CHR(10)+CHR(13)
				*cReturnEmailHTML = cReturnEmailHTML+CHR(10)+CHR(13)
			ELSE
				cReturnEmailHTML = "Sales@SpaceAlloysUSA.com" +CHR(10)+CHR(13)
			ENDIF
			
			IF NOT EMPTY(ThisForm.cCover)
				cCoverName = AppSetup_Get_UserName(ThisForm.cCover)
			ELSE
				cCoverName = ''
			ENDIF
			
			IF USED('Quotes')
				cRefNum = ALLTRIM(STR(Quotes.InqNum,8,0))
			ELSE
				cRefNum = ALLTRIM(DTOC(DATE()))
			ENDIF
			
			PRIVATE cInqNumP
			cInqNumP = cRefNum+ThisForm.SalesP
			lcEmailFrom = m.SendFromEmail
		*ENDIF
		
		***********************
		***********************
		IF ThisForm.chkEmail.VALUE = 1
			IF ThisForm.chkPDFx.Value = 1 AND ThisForm.chkPDFx.Enabled = .T.
				*Email PDF
				WAIT window 'Email PDF' NOWAIT
				
				PRIVATE cFileName
				*cFileName	= cServerDrive+"\SendPDF\"+cHomeSalesp+"\HPA_Inquire.pdf"
				cFileName = EmailFileName("HPA_Inquire.PDF")
				
				Local loListener As "PdfListener" Of "Pdfx.vcx"
				loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
				loListener.cCodePage="CP1252" &&CodePage
				loListener.cTargetFileName = cFileName
				loListener.QuietMode=.F.
				loListener.lCanPrint=.T.
				loListener.lCanEdit=.F.
				loListener.lCanCopy=.T.
				loListener.lCanAddNotes=.F.
				loListener.lEncryptDocument=.F.
				loListener.cMasterPassword=''
				loListener.cUserPassword=''
				loListener.lOpenViewer=.T.
				
				IF FILE('REPORTS\sndINQUIRE.FRX')
					SELECT qdb
					REPORT FORM 'REPORTS\sndINQUIRE' Object loListener
					
					WAIT WINDOW 'PRINTED' NOWAIT
				ELSE
					WAIT WINDOW 'Report form not found' NOWAIT
				ENDIF
				SELECT Quotes
				lcSendHow = lcSendHow + "Email PDF "
				
				PRIVATE cEmailTo, cEmailFrom, cSubject, cMessage, cNewPDFName
				cEmailTo	= m.txtGemail
				IF NOT EMPTY(m.CoverEmail)
					cEmailTo = ALLTRIM(cEmailTo)+";"+m.CoverEmail
				ENDIF
				cEmailFrom	= cReturnEmail
				cSubject	= "Inquire "+cInqNumP+" from Space Alloys USA "
				cMessage	= ""
				cMessage = cMessage +"The following inquiry is from " + cUserName +CHR(10)+CHR(13)
				IF NOT EMPTY(cCoverName)
					cMessage = cMessage +"Assisted by " + cCoverName + "  "
				ENDIF
				cMessage = cMessage +cReturnEmailHTML +CHR(10)+CHR(13)
				cMessage = cMessage +CHR(10)+CHR(13)
				cMessage = cMessage + CreateHTML_Inquire_Header()
				cMessage = cMessage +CHR(10)+CHR(13)
				cMessage = cMessage +"Please quote price and delivery to this reference number:"
				cMessage = cMessage +(cInqNumP)+" "+CHR(10)+CHR(13)
				IF nLineItems > 0
					cMessage = cMessage +"Number of Line Items: "+ALLTRIM(STR(nLineItems))+" "+REPLICATE("-",47)+" "
				ENDIF
				cMessage = cMessage +CHR(10)+CHR(13)
				cNewPDFName	= "HPA_Inquire_"+cInqNumP
				
				PRIVATE cAns
				cAns = ''
				cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, gnConnHandle, cNewPDFName)
		
				IF NOT EMPTY(cAns)
					MESSAGEBOX( cAns,0,"SQL Returned Message!")
				ELSE
					WAIT WINDOW "Email Complete" NOWAIT
					TrackMess("Inquire "+cInqNumP+" was Emailed to ("+cEmailTo+") from ("+cEmailFrom+") on ("+DTOC(DATE())+")"  )
				ENDIF
				RELEASE loListener
			ELSE
				*Email - Not PDF
				PRIVATE m.SendToEmail, m.MsgSubject ,m.MsgNoteText
				PRIVATE txtLine
				
					m.MsgSubject = "Inquire "+cInqNumP+" from Space Alloys USA "
					m.MsgNoteText = ""
					m.MsgNoteText = m.MsgNoteText +"The following inquiry is from " + cUserName +CHR(10)+CHR(13)
					IF NOT EMPTY(cCoverName)
						m.MsgNoteText = m.MsgNoteText +"Assisted by " + cCoverName + "  "
					ENDIF
					m.MsgNoteText = m.MsgNoteText +cReturnEmailHTML +CHR(10)+CHR(13)
					m.MsgNoteText = m.MsgNoteText +CHR(10)+CHR(13)
					m.MsgNoteText = m.MsgNoteText + CreateHTML_Inquire_Header()
					m.MsgNoteText = m.MsgNoteText +CHR(10)+CHR(13)
					m.MsgNoteText = m.MsgNoteText +"Please quote price and delivery to this reference number:"
					m.MsgNoteText = m.MsgNoteText +cInqNumP+" "+CHR(10)+CHR(13)
					IF nLineItems > 0
						m.MsgNoteText = m.MsgNoteText +"Number of Line Items: "+ALLTRIM(STR(nLineItems))+" "+REPLICATE("-",47)+" "
					ENDIF
					m.MsgNoteText = m.MsgNoteText +CHR(10)+CHR(13)
				SELECT qdb
				SCAN
					txtLine=txtLine + (qdb.Line)+CHR(10)+CHR(13)
				ENDSCAN
				m.MsgNoteText = m.MsgNoteText + txtLine
				IF USED('Quotes')
					SELECT Quotes
				ENDIF
				m.MsgNoteText = m.MsgNoteText +CHR(10)+CHR(13)
				m.MsgNoteText = m.MsgNoteText +"Unless otherwise specified, these items are combined."
				m.MsgNoteText = m.MsgNoteText +CHR(10)+CHR(13)
		
				m.SendToEmail = ALLTRIM(ThisForm.txtGemail.Value)
				IF NOT EMPTY(m.CoverEmail)
					m.SendToEmail = ALLTRIM(m.SendToEmail)+";"+m.CoverEmail
				ENDIF
				
				ThisForm.Send_SQL_Email(m.SendFromEmail, m.SendToEmail, m.MsgSubject ,m.MsgNoteText)
				
				lcSendHow = lcSendHow + "Email "
			ENDIF
		ENDIF
		***********************
		***********************
		IF ThisForm.chkEmail2.VALUE = 1
			IF ThisForm.chkPDFx2.Value = 1 AND ThisForm.chkPDFx2.Enabled = .T.
				*Email PDF
				WAIT window 'Email PDF2' NOWAIT
				
				PRIVATE cFileName
				*cFileName	= cServerDrive+"\SendPDF\"+cHomeSalesp+"\HPA_Inquire.pdf"
				cFileName = EmailFileName("HPA_Inquire.PDF")
				
				Local loListener As "PdfListener" Of "Pdfx.vcx"
				loListener = NewObject('PdfListener', 'LIBS\PDFx.vcx')
				loListener.cCodePage="CP1252" &&CodePage
				loListener.cTargetFileName = cFileName
				loListener.QuietMode=.F.
				loListener.lCanPrint=.T.
				loListener.lCanEdit=.F.
				loListener.lCanCopy=.T.
				loListener.lCanAddNotes=.F.
				loListener.lEncryptDocument=.F.
				loListener.cMasterPassword=''
				loListener.cUserPassword=''
				loListener.lOpenViewer=.T.
				
				IF FILE('REPORTS\sndINQUIRE.FRX')
					SELECT qdb
					REPORT FORM 'REPORTS\sndINQUIRE' Object loListener
					
					WAIT WINDOW 'PRINTED' NOWAIT
				ELSE
					WAIT WINDOW 'Report form not found' NOWAIT
				ENDIF
				SELECT Quotes
				lcSendHow = lcSendHow + "Email PDF "
				
				PRIVATE cEmailTo, cEmailFrom, cSubject, cMessage, cNewPDFName
				cEmailTo	= m.txtGEmail2
				IF NOT EMPTY(m.CoverEmail)
					cEmailTo = ALLTRIM(cEmailTo)+";"+m.CoverEmail
				ENDIF
		
				cEmailFrom	= cReturnEmail
				cSubject	= "Inquire "+cInqNumP+" from Space Alloys USA "
				cMessage	= ""
				cMessage = cMessage +"The following inquiry is from " + cUserName +CHR(10)+CHR(13)
				IF NOT EMPTY(cCoverName)
					cMessage = cMessage +"Assisted by " + cCoverName + "  "
				ENDIF
				cMessage = cMessage +cReturnEmailHTML +CHR(10)+CHR(13)
				cMessage = cMessage +CHR(10)+CHR(13)
				cMessage = cMessage + CreateHTML_Inquire_Header()
				cMessage = cMessage +CHR(10)+CHR(13)
				cMessage = cMessage +"Please quote price and delivery to this reference number:"
				cMessage = cMessage +cInqNumP+" "+CHR(10)+CHR(13)
				IF nLineItems > 0
					cMessage = cMessage +"Number of Line Items: "+ALLTRIM(STR(nLineItems))+" "+REPLICATE("-",47)+" "
				ENDIF
				cMessage = cMessage +CHR(10)+CHR(13)
				cNewPDFName	= "HPA_Inquire_"+cInqNumP
				
				PRIVATE Ans
				cAns = SendPDFEmail(cEmailTo, cEmailFrom, cFileName, cSubject, cMessage, gnConnHandle, cNewPDFName)
		
				IF NOT EMPTY(cAns)
					MESSAGEBOX( cAns,0,"SQL Returned Message!")
				ELSE
					WAIT WINDOW "Email 2 Complete" NOWAIT
					TrackMess("Inquire "+cInqNumP+" was Emailed to ("+cEmailTo+") from ("+cEmailFrom+") on ("+DTOC(DATE())+")"  )
				ENDIF
				RELEASE loListener
			ELSE
				*Email -Not PDF, SQL
				WAIT WINDOW 'Email 2' NOWAIT
				
				PRIVATE m.SendToEmail, m.MsgSubject ,m.MsgNoteText
				PRIVATE txtLine
				
				m.MsgSubject = "Inquire "+cInqNumP+" from Space Alloys USA "
				m.MsgNoteText = ""
				m.MsgNoteText = m.MsgNoteText +"The following inquiry is from " + cUserName +CHR(10)+CHR(13)
				IF NOT EMPTY(cCoverName)
					m.MsgNoteText = m.MsgNoteText +"Assisted by " + cCoverName + "  "
				ENDIF
				m.MsgNoteText = m.MsgNoteText +cReturnEmailHTML +CHR(10)+CHR(13)
				m.MsgNoteText = m.MsgNoteText +CHR(10)+CHR(13)
				m.MsgNoteText = m.MsgNoteText + CreateHTML_Inquire_Header()
				m.MsgNoteText = m.MsgNoteText +CHR(10)+CHR(13)
				m.MsgNoteText = m.MsgNoteText +"Please quote price and delivery to this reference number:"
				m.MsgNoteText = m.MsgNoteText +cInqNumP+" "+CHR(10)+CHR(13)
				IF nLineItems > 0
					m.MsgNoteText = m.MsgNoteText +"Number of Line Items: "+ALLTRIM(STR(nLineItems))+" "+REPLICATE("-",47)+" "
				ENDIF
				m.MsgNoteText = m.MsgNoteText +CHR(10)+CHR(13)
				
				SELECT qdb
				SCAN
					txtLine=txtLine + (qdb.Line)+CHR(10)+CHR(13)
				ENDSCAN
				m.MsgNoteText = m.MsgNoteText + txtLine
				IF USED('Quotes')
