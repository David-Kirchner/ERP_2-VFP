				m.SendToEmail = ALLTRIM(ThisForm.txtGEmailVC.Value)
				IF NOT EMPTY(m.CoverEmail)
					m.SendToEmail = ALLTRIM(m.SendToEmail)+";"+m.CoverEmail
				ENDIF
				ThisForm.Send_SQL_Email(m.SendFromEmail, m.SendToEmail, m.MsgSubject ,m.MsgNoteText)
				
				lcSendHow = lcSendHow + "Email "
				
			ENDIF
		ENDIF
		***********************
		IF ThisForm.chkEmailVC2.VALUE = 1
			IF ThisForm.chkPDFx4.Value = 1 AND ThisForm.chkPDFx4.Enabled = .T.
				*Email PDF
				WAIT window 'Email PDF4' NOWAIT
				
				PRIVATE cFileName
				*cFileName	= cServerDrive+"\SendPDF\"+cHomeSalesp+"\HPA_Inquire.pdf"
				cFileName = EmailFileName("HPA_Inquire.PDF")
				
				Local loListener As "PdfListener" Of "Pdfx.vcx"
