	PROCEDURE checkmarks		&& Sets Check marks
		
		IF EMPTY(ThisForm.txtGfax.Value)
			ThisForm.chkFax.Value      = 0
			ThisForm.chkFax.Enabled    = .F.
		ELSE
			ThisForm.chkFax.Value      = 1
			ThisForm.chkFax.Enabled    = .T.
		ENDIF	
		
		IF EMPTY(ThisForm.txtGEmail.Value)
			ThisForm.chkEmail.Value      = 0
			ThisForm.chkEmail.Enabled    = .F.
		ELSE
			ThisForm.chkEmail.Value      = 1
			ThisForm.chkEmail.Enabled    = .T.
			ThisForm.chkFax.Value        = 0
		ENDIF	
		
		IF EMPTY(ThisForm.txtGemail2.Value)
			ThisForm.chkEmail2.Value      = 0
			ThisForm.chkEmail2.Enabled    = .F.
		ELSE
			ThisForm.chkEmail2.Value      = 0
			ThisForm.chkEmail2.Enabled    = .T.
			ThisForm.chkFax.Value         = 0
		ENDIF	
		
		IF NOT ThisForm.chkEmail.Enabled AND NOT ThisForm.chkEmail2.Enabled
			IF !EMPTY(ThisForm.txtGemailVC.Value)
				ThisForm.chkEmailVC.Value      = 1
			ENDIF
			IF !EMPTY(ThisForm.txtGemailVC2.Value)
				ThisForm.chkEmailVC2.Value      = 1
			ENDIF
		ENDIF
		
		IF !EMPTY(ThisForm.txtGemailVC.Value)
			ThisForm.chkEmailVC.Enabled    = .T.
		ENDIF
			
		IF !EMPTY(ThisForm.txtGemailVC2.Value)
			ThisForm.chkEmailVC2.Enabled    = .T.
		ENDIF
		
			
		
		
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(qaQrecN) != "U"
			RELEASE qaQrecN
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETER pGcompany,pGphone,pGfax,pGperson,pGemail,pGemail2,paQrecNumS, pcSalesP, pAlloy, pVendCode
		*DO FORM Forms\GatherSend WITH
		
		PUBLIC gaQrecN
		IF TYPE("paQrecNumS")="L"
			DIMENSION gaQrecN(1)
			gaQrecN[1] = 0
		ELSE
			DIMENSION gaQrecN( aLEN('paQrecNumS') )
			aCOPY(paQrecNumS,gaQrecN)
		ENDIF
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		*PUBLIC m.txtGcompany,m.txtGphone,m.txtGfax,m.txtGperson,m.txtGemail,m.txtGemail2
		*PUBLIC m.delytime, m.delydate
		
		ThisForm.txtGcompany.Value	= PrepareSQLtxt(pGcompany,'Company',30)
		ThisForm.txtGphone.Value 	= PrepareSQLtxt(pGphone,'Phone',11)	&&Add 1 for Long Distance
		ThisForm.txtGfax.Value   	= PrepareSQLtxt(pGfax,'Fax',11)		&&Add 1 for Long Distance
		ThisForm.txtGperson.Value	= PrepareSQLtxt(pGperson,'Name',25)
		ThisForm.txtGemail.Value 	= PrepareSQLtxt(pGemail,'Email',60)
		ThisForm.txtGemail2.Value	= PrepareSQLtxt(pGemail2,'Email',60)
		
		ThisForm.txtGemailVC.Value = ''
		ThisForm.txtGemailVC2.Value = ''
		*****
		IF VARTYPE(pVendCode) = "N"
			IF pVendCode > 0
			
				ThisForm.nVendCode = pVendCode
				PRIVATE cSQL, nSQLEXEC
				IF USED('tmpVC')	
					USE IN tmpVC
				ENDIF
				SELECT 0
		
				cSQL = "SELECT Email"
				cSQL = cSQL + " FROM dbo.VendorContact VC "
				cSQL = cSQL + " WHERE VC.VendCode ="+STR(pVendCode)
				cSQL = cSQL + " AND ISNULL(VC.Inactive,0) = 0 "
				cSQL = cSQL + " AND ISNULL(VC.Quality,0) < 1 "
				cSQL = cSQL + " AND LEN(Email) > 1"
		
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, 'tmpVC' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( gnConnHandle, cSQL, 'tmpVC' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpVC")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "tmpVC")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, gnConnHandle,nSQLEXEC,'tmpVC')
				ENDIF
		
				IF USED('tmpVC')	
					IF RECCOUNT('tmpVC') > 0
						ThisForm.txtGemailVC.Value	= ALLTRIM(PrepareSQLtxt(tmpVC.Email,'Email',60))
						IF RECCOUNT('tmpVC') > 0
							SKIP 1
							ThisForm.txtGemailVC2.Value	= ALLTRIM(PrepareSQLtxt(tmpVC.Email,'Email',60))
						ENDIF		
					ENDIF
					USE IN tmpVC
				ENDIF
			ENDIF
		ENDIF
		
		*****
		ThisForm.chkPrint.Value    = 0
		
		ThisForm.CheckMarks()
		
		ThisForm.SalesP = ''
		ThisForm.cCover = ''
		
		PRIVATE lSendAsCover
		lSendAsCover = .T.
		
		IF USED('Quotes')
			ThisForm.lblEmailName.Caption = SalesPEmail(Quotes.SalesP,Quotes.Cover,lSendAsCover)
			ThisForm.SalesP = Quotes.SalesP
			ThisForm.cCover = Quotes.Cover
		ELSE
			IF VARTYPE(pcSalesP) = "C"
				ThisForm.lblEmailName.Caption = SalesPEmail(pcSalesP,'',.F.)
				ThisForm.SalesP = pcSalesP 
			ELSE
				ThisForm.lblEmailName.Caption = "Sales@SpaceAlloysUSA.com"
			ENDIF
		ENDIF
		
		IF VARTYPE(pAlloy) = "C"
			ThisForm.txtAlloy.Value = PrepareSQLtxt(pAlloy,'Alloy',12)
			ThisForm.txtAlloy.Visible = .T.
			ThisForm.txtAlloy.Enabled = .T.
			ThisForm.lblAlloy.Visible = .T.
			ThisForm.cmdSaveAlloy.Visible = .T.
		ELSE
			ThisForm.txtAlloy.Value = ''
			ThisForm.txtAlloy.Visible = .F.
			ThisForm.txtAlloy.Enabled = .F.
			ThisForm.lblAlloy.Visible = .F.
			ThisForm.cmdSaveAlloy.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
	ENDPROC

	PROCEDURE load_userinfo
	ENDPROC

	PROCEDURE qdbsendto		&& Load the Send to Database.
		Private pcurcer,pcurdata
		pcurdata=SET('DATABASE')
		
		IF NOT USED('QDBsendto')
			SELECT 0
			CREATE CURSOR 'QDBsendto' (Name C(25),	Company C(30),	Phone C(11), Phone_Ext C(4), Fax C(11),Email C(60),PO_Num C(17),SalesP C(1),InqNum N(8),CountryC C(10) )
		ENDIF
		SELECT QDBsendTo
		ZAP
		APPEND BLANK
		
		
	ENDPROC

	PROCEDURE send_sql_email		&& Send SQL Email
		PARAMETER pcFrom, pcTo, pcMessage, pcBody
		*Send_Sql_Email(pcFrom, pcTo, pcMessage, pcBody)
		PRIVATE lReturn
		lReturn = .T.
		
		IF USED('QuoteAttach')
			IF RECCOUNT('QuoteAttach') > 0
			*IF MESSAGEBOX("Do you still want to Email this Attached Files?",4,"Send Email?") = 6
				lReturn = ThisForm.Send_SQL_Email_Attach(pcFrom, pcTo, pcMessage, pcBody)
				RETURN lReturn
			ENDIF
		ENDIF
		*@from VARCHAR(8000),
		*@to VARCHAR(8000),
		*@subject VARCHAR(8000),
		*@body VARCHAR(8000)
		*Send_SQL_Email()
		
		
		*pcFrom	= "DavidCorrosion.net"
		*pcTo	= "David@SpaceAlloysUSA.com"
		*pcMessage = "Email from SQL"
		*pcBody	= "This is the Body"
		
		*PRIVATE nConnHandle
		PRIVATE lcResults, outParam, sql_sp, nSQLEXEC
		lcResults = ""
		
		pcFrom	= PrepareSQLemail(pcFrom,"EmailFrom")
		pcTo	= PrepareSQLemail(pcTo,"EmailTo")
		pcMessage=PrepareSQLtxt(pcMessage,"Message",8000)
		*pcBody	= PrepareSQLtxt(pcBody,"Body",8000)
		pcBody	= PrepareSQLtxt(pcBody,"Body",-1)
		
		
		sql_sp = "EXEC dbo.p_eMail_Send "
		sql_sp = sql_sp + "'"+ pcFrom + "',"
		sql_sp = sql_sp + "'"+ pcTo + "'," 
		sql_sp = sql_sp + "'"+ pcMessage + "',"
		sql_sp = sql_sp + "'"+ pcBody + "',"
		sql_sp = sql_sp + "'TEXT'"
		*sql_sp = sql_sp + ",?@outParam"
		*sql_sp = Sql_sp + ")}"
		*? "SQL_SP= "+SQL_SP
		
		nSQLEXEC = SQLEXEC(gnConnHandle, sql_sp)
		
		*DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 2
		*	nSQLEXEC = SQLEXEC( gnConnHandle, sql_sp, '')
		*ENDDO
		*IF nSQLEXEC < 0 &&Try again!
		*	nSQLEXEC = SQLEXEC(gnConnHandle, sql_sp, "")
		*	DO WHILE nSQLEXEC = 0
		*		WAIT WINDOW 'SQL 2' TIMEOUT 1
		*		nSQLEXEC = SQLEXEC(gnConnHandle, sql_sp, "")
		
		*		IF nSQLEXEC < 0
		*			IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*				nSQLEXEC = 0
		*			ENDIF
		*		ENDIF
		*	ENDDO
		*ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(sql_sp,gnConnHandle,nSQLEXEC, '')
		ENDIF
		
		IF nSQLEXEC = -1
			AERROR(aErr1)
			*disp memo like aErr1
			MESSAGEBOX("Error:"+ALLTRIM(STR(aErr1(1,1)))+CHR(13)+aErr1(1,2)+CHR(13)+aErr1(1,3),0,"SQL - Email Send Error")
			lReturn = .F.
		ENDIF
		
		RETURN lReturn
	ENDPROC

	PROCEDURE send_sql_email_attach
		PARAMETER pcFrom, pcTo, pcMessage, pcBody
		*Send_SQL_Email_Attach
		
		*PRIVATE pcFrom, pcTo, pcMessage, pcBody
		pcFrom	= PrepareSQLemail(pcFrom,"EmailFrom")
		pcTo	= PrepareSQLemail(pcTo,"EmailTo")
		pcMessage= PrepareSQLtxt(pcMessage,"Message",8000)
		*pcBody	= PrepareSQLtxt(pcBody,"Body",8000)
		pcBody	= PrepareSQLtxt(pcBody,"Body",-1)
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE lUseAttach
		lUseAttach = .F.
		
		IF USED('QuoteAttach')
			IF RECCOUNT('QuoteAttach') > 0
				lUseAttach = .T.
			ENDIF
		ENDIF
		
		IF lUseAttach
			
			PRIVATE m.cFile_Attach
			m.cFile_Attach = ""
			
			*Find file
			PRIVATE cLocation, cFileName, cFile
			SELECT QuoteAttach
			SCAN
				*UNCFile C(254), FileName C(254)
				cLocation = ALLTRIM(QuoteAttach.UNCFile)
				IF RIGHT(cLocation,1)!="\"
					IF LEN(cLocation) > 1
						cLocation = cLocation + "\"
					ENDIF
				ENDIF
				cFileName = ALLTRIM(QuoteAttach.FileName)
				cFile = cLocation + cFileName
				
				**********
				cFullSQLPath = get_Email_ServerDir()
		
				IF FILE(cFile)
					*look for same file name on Server
					DO WHILE FILE(cFullSQLPath+cFileName)
						IF MESSAGEBOX("File '"+cFullSQLPath+cFileName+"' is already on the Server."+CHR(13)+"Please wait for other user to finish sending file."+CHR(13)+"If you are sure this file can be removed,"+CHR(13)+"answer Yes, default is No.",4+32+256,"Delete old file?") = 6
							DELETE FILE cFullSQLPath+cFileName
						ELSE
							WAIT WINDOW "Waiting to see if file gets deleted." TIMEOUT 5
						ENDIF
					ENDDO
					
					*Copy to server
					TRY
						COPY FILE ["]+cFile+["] TO ["]+cFullSQLPath+cFileName+["]
					CATCH
						MESSAGEBOX("You do not have Permission to copy file "+CHR(13)+cFile+" to the SQL server."+CHR(13)+"This file will not be sent!",0,"Attach Error")
						TrackError("You do not have Permission to copy file "+cFile+" to the SQL server.",'No Copy','GatherSend:Send_SQL_Email_Attach',LINENO(1))
					ENDTRY
					
					WAIT WINDOW "copy file" TIMEOUT 1
					
					IF FILE(cFullSQLPath+cFileName)
						*Add to serverlist
						*Use ; to indicate End of filename in SQL program
		*					IF EMPTY(cFile_Attach)
		*						m.cFile_Attach = cFileName +";"
		*					ELSE
							m.cFile_Attach = m.cFile_Attach + cFileName +";"  &&Use ; to indicate End of filename in SQL program
		*					ENDIF
					ELSE
						MESSAGEBOX( "File did not copy to server!"+CHR(13)+"COPY FILE "+cFile+" TO "+cFullSQLPath+cFileName+".",16,"Copy file Error")
						
					ENDIF
				ELSE
					MESSAGEBOX("File:"+ALLTRIM(cFile)+" was not found!",64,"No file")
				ENDIF
			ENDSCAN
			
			
			IF EMPTY(cFile_Attach)
				MESSAGEBOX("Did not get any files to send."+CHR(13)+"Aborting the [p_eMail_Send_Attachments] procedure.",16,"Cannot continue.")
				RETURN .F.
			ENDIF
			
			PRIVATE m.SendFromEmail,m.ReciptEmail, m.MsgSubject, m.MsgNoteHTML
			m.SendFromEmail = pcFrom
			m.ReciptEmail	= pcTo
			m.MsgSubject 	= pcMessage
			m.MsgNoteHTML	= pcBody
			
			*Execute SQL procedure
			
			cSQL = "EXEC dbo.p_eMail_Send_Attachments "
			cSQL = cSQL + " @FromEmail=N'"+ m.SendFromEmail +"'"
			cSQL = cSQL + ",@ToEmail=N'"+ m.ReciptEmail +"'"
			cSQL = cSQL + ",@BCC=N''"
		*	cSQL = cSQL + ",@BCC=N'4012785@bcc.hubspot.com'"
			cSQL = cSQL + ",@SubjectEmail=N'"+ m.MsgSubject +"'"
			cSQL = cSQL + ",@BodyEmail=N'"+ m.MsgNoteHTML + "'"
			cSQL = cSQL + ",@Body_Format=N'HTML'"
			cSQL = cSQL + ",@File_Attach=N'"+ m.cFile_Attach  +"'"
			
		*	IF LEN(cSQL) >= 8000
		*		TrackError(cSQL,"cSQL String TOO big","GatherSend:Send_SQL_Email_Atach()",LINENO(1) )
		*	ENDIF
		
			nSQLEXEC = SQLEXEC(gnConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( gnConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(gnConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, gnConnHandle,nSQLEXEC)
				STRTOFILE(cSQL,"SQLError.TXT")
				TrackMess(cSQL)
			ELSE
				WAIT WINDOW "SENT E-mail to "+m.ReciptEmail NOWAIT
				addQuoteMemo( "Email Color HTML", gnConnHandle )
			ENDIF
			
			****
			*Done in Inquire window Exit code.
		*!*		*Remove files from server
		*!*		SELECT QuoteAttach
		*!*		SCAN
		*!*			cFileName = ALLTRIM(QuoteAttach.FileName)
		*!*			
		*!*			IF FILE(cFullSQLPath"+cFileName)
		*!*				DELETE FILE (cFullSQLPath+cFileName)
		*!*			ENDIF
		*!*		ENDSCAN	
				
			*SELECT QuoteAttach
			*DELETE IN QuoteAttach
			*PACK
			
		ENDIF	
	ENDPROC

	PROCEDURE Unload
		IF USED('QDBsendto')
			USE IN QDBsendTo 
		ENDIF
	ENDPROC

