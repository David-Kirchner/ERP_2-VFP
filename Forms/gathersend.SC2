	PROCEDURE txtGFax.Valid
		*IF LEFT(This.Value,1)="1" or LEFT(This.Value,1)="0"
		*	ThisForm.fax = This.Value
		*ELSE
		*	IF NOT EMPTY(This.Value)
		*	wait window "Please enter 1 + the areacode to this phone number"
		*	ENDIF
		*	ThisForm.fax = This.Value
		*ENDIF
		
