				ENDIF
				cMessage = cMessage +cReturnEmailHTML +CHR(10)+CHR(13)
				
				cMessage = cMessage + CreateHTML_Inquire_Header()
		
				cMessage = cMessage +CHR(10)+CHR(13)
				cMessage = cMessage +"Please quote price and delivery to this reference number:"
				cMessage = cMessage +cInqNumP+" "+CHR(10)+CHR(13)
				IF nLineItems > 0
					cMessage = cMessage +"Number of Line Items: "+ALLTRIM(STR(nLineItems))+" "+REPLICATE("-",47)+" "
				ENDIF
