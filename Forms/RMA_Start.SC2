		ThisForm.txtRefunded.Value = nItemSale
		
	ENDPROC

	PROCEDURE lstSOitem.InteractiveChange
		PRIVATE nElem
		IF ThisForm.chkSameReason.Value=0
			nElem = ASCAN(aSoItems, This.Value)
		
			IF TYPE("gaReason(nElem)") = "L"
				gReason = ""
			ELSE
				gReason = gaReason(nElem)
			ENDIF
			
			ThisForm.txtReason.Refresh
		ENDIF
		
		IF !EMPTY(This.Value)
			ThisForm.SOitem = This.Value
		ELSE
			ThisForm.SOitem = ""
		ENDIF
		
		ThisForm.RMA_Detail_Refresh()
	ENDPROC

	PROCEDURE txtAuth_By.LostFocus
		IF EMPTY(This.Value)
			PRIVATE cMach_User, cUserName
			cMach_User = SYS(0)
			cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
			This.Value = cUserName
		ENDIF
	ENDPROC

	PROCEDURE txtReason.LostFocus
		
		
	ENDPROC

	PROCEDURE txtReason.Valid
		IF ThisForm.chkSameReason.Value=0
			gaReason(ASCAN(aSoItems, ThisForm.lstSOitem.Value )) = This.Value
		ELSE
			gaReason(1) = This.Value
		ENDIF
	ENDPROC

	PROCEDURE txtReturnTo.Valid
		PRIVATE cReturnTo
		cReturnTo = UPPER( PrepareSQLtxt(This.Value,'ReturnTo',1) )
		
		IF cReturnTo = "T" OR cReturnTo = "W"
		
		ELSE
			IF NOT EMPTY(cReturnTo)
				MESSAGEBOX("Return to is limited to 'Tipton or Windfall'",0,"Ignore input")
				This.Value = ''
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtRMA_No.Valid
		IF !EMPTY(This.Value) &&AND !EMPTY(ThisForm.txtItempo.Value)
		*	ThisForm.Check4POItem()
		ENDIF
	ENDPROC

