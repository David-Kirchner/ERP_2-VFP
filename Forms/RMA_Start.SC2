	PROCEDURE cmdOpenSelect.Click
		PRIVATE cSelectSOItem, nSO, cCurrSOitem
		nSO = 0
		
		cCurrSOitem = PrepareSQLtxt(ThisForm.SOitem,'SOitem',SOitem)
		IF NOT EMPTY(cCurrSOitem )
			nSO = VAL( LEFT( cCurrSOitem , 7 ) )
		ENDIF
		
		IF nSO  > 0
			DO FORM Forms\ChooseSOitem WITH nSO  TO cSelectSOItem 
		ELSE
			cSelectSOItem = ''
		ENDIF
			
		PRIVATE lGoodToAdd
		lGoodToAdd = .F.
		IF Proper_SO_item(cSelectSOItem) != Proper_SO_item('')
			IF Proper_SO_item(cSelectSOItem) != Proper_SO_item(cCurrSOitem)
				IF ASCAN(aSOItems, pSOitem) = 0 &&Not Found
					IF ThisForm.txtRMA_No.Value = 0 
						IF ALEN(aSoItems,1) = 0
							lGoodToAdd = .T.
						ELSE
							MESSAGEBOX("Make sure you save for SOitem '"+cCurrSOitem+"' before you add '"+cSelectSOItem+"'",0+64,"")
						ENDIF
					ENDIF
					*
				ENDIF
			ENDIF
		ENDIF
		
		IF lGoodToAdd 
		
		ENDIF
	ENDPROC

	PROCEDURE cmdRemoveItem.Click
		PRIVATE cSOitem,nRMA_No
		cSOitem = ThisForm.lstSOitem.Value
		IF EMPTY(cSOitem)
			cSOitem = ThisForm.SOitem 
		ENDIF
		cSOitem = Proper_SO_Item( cSOitem  )
		
		nRMA_No = PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		IF nRMA_No < 1 
			MESSAGEBOX("Not able to remove.",16,"No RMA_No")
			RETURN .F.
		ENDIF
		
		IF MESSAGEBOX( "Do you want to remove "+ALLTRIM(cSOitem)+CHR(13)+"from this RMA? ("+ALLTRIM(STR(nRMA_No))+")"+CHR(13)+"All listings of this SO item will be gone."+CHR(13)+"and the RMA number will be removed from dbo.Sales table for this SO item.",4+32,"Remove SO-item") = 6&&yes
			PRIVATE cSQL, nSQLEXEC
			cSQL = "DELETE FROM dbo.RMA_Detail "
			cSQL = cSQL + " WHERE RMA_No="+STR(nRMA_No)
			cSQL = cSQL + " AND SO_item='"+cSoItem+"'"
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			ENDIF
		
			************************
			
			IF cSOitem != Proper_SO_Item( "" )
				cSQL = "UPDATE dbo.Sales SET "
				cSQL = cSQL + " RMA_No = 0"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL + " and RMA_No = "+STR(nRMA_No)
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
				ENDIF
			ENDIF
			
			************************
			PRIVATE nCount, nDrop
			nCount = 0
			nDrop = 0
			
			FOR i = 1 TO ALEN(aSOItems,1)
				IF aSOItems(i) != cSOitem
					nCount = nCount + 1
					DIMENSION aSOItemsNew(nCount)
					aSOItemsNew(nCount) = aSOItems(i)
					
					DIMENSION aReasonNew(nCount)
					aReasonNew(nCount) = gaReason(i)
				ELSE
					nDrop = i
				ENDIF
			ENDFOR
		
			IF nCount = 0
				DIMENSION aSOItems(1)
				aSOItems(1) = " "
				DIMENSION gaReason(1)
				gaReason(1) = " "
			ELSE
				DIMENSION aSOItems(nCount)
				ACOPY(aSOItemsNew,aSOitems)
				
				DIMENSION gaReason(nCount)
				ACOPY(aReasonNew,gaReason)
			ENDIF
			
			ThisForm.lstSOitem.NumberOfElements = ALEN(aSoItems)
			ThisForm.lstSOitem.Refresh
			
			IF nDrop - 1 > 0
				IF AELEMENT(aSoItems,1) < nDrop
					ThisForm.SOitem = aSoItems( AELEMENT(aSoItems,1) )  &&lAST ONE
				ELSE
					ThisForm.SOitem = aSoItems( nDrop - 1)
				ENDIF
			ENDIF
			IF nDrop = 0 AND nCount > 0
				ThisForm.SOitem = aSoItems(1)
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdSaveAdd.Click
		IF ThisForm.InsertRMA
			*check to see RMA_No is still available 
		ENDIF
			
		
		PRIVATE nItems, nItems2, lFoundEmpty, nArrayItems, nAddNextItem
		DECLARE anSalesCnt(1)
		
		nArrayItems = ALEN(aSoItems,1)
		DIMENSION aSOitems2(nArrayItems)
		lFoundEmpty = .F.
		nItems2 = 0
		
		*DO WHILE .T.
		FOR nItems = 1 TO ALEN(aSoItems,1)
		
		*	SELECT COUNT(*) FROM HPA!Sales Where Sales.SOItem = aSoItems(nItems) INTO ARRAY anSalesCnt
			IF USED("cntSales_3")
				SELECT cntSales_3
			ELSE
				SELECT 0
			ENDIF
			cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.Sales WITH(NOLOCK) WHERE "
			cSQL = cSQL + " SOItem = dbo.f_ProperSOitem('"+aSoItems(nItems)+"')"
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSales_3')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSales_3')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_3")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_3")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'cntSales_3')
			ENDIF
			IF USED('cntSales_3')
				SELECT COUNT(*) FROM cntSales_3 INTO ARRAY anSalesCnt	
				IF anSalesCnt(1) < 1
					lFoundEmpty = .T.
					*Remove from Array
					nArrayItems = nArrayItems - 1
					IF nArrayItems = 0
						EXIT
					ENDIF
					DIMENSION aSOitems2(nArrayItems)
				ELSE
					FOR nAddNextItem = 1 TO ALEN( anSalesCnt,1 )
						nItems2 = nItems2 + 1		
						aSOitems2(nItems2) = anSalesCnt(nAddNextItem,1)
					ENDFOR
				ENDIF
			ENDIF
		ENDFOR
		*ENDDO
		
		IF ALEN(aSoItems,1) > 0
			ACOPY(aSOitems2,anSalesCnt)
			
			IF ThisForm.CheckData()
				IF ThisForm.SaveAdd("ADD")
				
					*This.Caption = "\<Add"
					*ThisForm.ResetAddVars()	
					ThisForm.SavedRMAScreen()
					This.Visible = .F.
					
					SELECT RMA
					nRMA = ThisForm.txtRMA_No.Value
					MESSAGEBOX("This RMA "+ALLTRIM(STR(nRMA))+" has been Saved."+CHR(13)+CHR(13)+"QA will be alerted of this RMA."+CHR(13)+"Please Mark the PackingSlip now."+CHR(13)+"Then you may Return out of RMA",64,"Saved")
					
					*ThisForm.lblGetPackingSlip.SetFocus()
					ThisForm.txtPackingSli.SetFocus()
				ENDIF
			ELSE
				WAIT WINDOW "Not Saved" NOWAIT
			ENDIF	
		ELSE
			MESSAGEBOX( "No Valid SO items", 0,"Cannot Save")
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdSaveAdd.When
		IF ALEN(aSoItems,1) <= 0
			MESSAGEBOX("You need to Select a SO item first!",0,"CANNOT SAVE - No Sales Order Item!")
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSaveItemReason.Click
		PRIVATE nRMA_No
		nRMA_No = PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		IF nRMA_No < 1 
			MESSAGEBOX("Not able to Save.",16,"No RMA_No")
			RETURN .F.
