		*IF nRMA_Detail  < 1 
		*	MESSAGEBOX("Not able to Save.",16,"No RMA_Detail ")
		*	RETURN .F.
		*ENDIF
		
		ThisForm.SaveRMA_Detail(nRMA_Detail)
		
		
	ENDPROC

	PROCEDURE cmdShowApproved.Click
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		IF USED("tmpSetup")
			USE IN tmpSetup
		ENDIF
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT UN FROM dbo.AppSetup WITH(NOLOCK) "
		cSQL = cSQL + " WHERE PRP = 'YES' AND ANS = 'RMA_Approval'"
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSetup')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSetup')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSetup")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSetup")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSetup')
		ENDIF
		
		PRIVATE cNameList
		cNameList = ''
		
		IF USED("tmpSetup")
			IF RECCOUNT("tmpSetup")>0
				SCAN
					IF EMPTY(cNameList)
						cNameList = ALLTRIM(tmpSetup.UN)
					ELSE
						cNameList = cNameList+CHR(13)+""+ALLTRIM(tmpSetup.UN)
					ENDIF
				ENDSCAN	
			ENDIF
			USE IN tmpSetup
		ENDIF
			
		IF NOT EMPTY(cNameList)
			MESSAGEBOX("Users allowed to approve RMA:"+CHR(13)+cNameList,64,"Approve RMA")
		ELSE
			MESSAGEBOX("No users where found!",64,"Error")
		ENDIF
	ENDPROC

	PROCEDURE lblCompany.Click
		PRIVATE nSalesNum 
		nSalesNum = VAL( LEFT( aSoItems(1), 7))
		
		IF nSalesNum > 0
		
			IF USED('Sales_No_SoldAddr')
				USE IN Sales_No_SoldAddr
			ENDIF
			SELECT 0
		
			cSQL = "SELECT SoldAddr.Company FROM dbo.Sales_No, dbo.SoldAddr WHERE Sales_No.SalesNum="+STR(nSalesNum)+" AND Sales_No.pSoldAddr = SoldAddr.SoldCode "
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No_SoldAddr')
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Sales_No_SoldAddr')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No_SoldAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Sales_No_SoldAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'Sales_No_SoldAddr')
			ENDIF
			IF USED('Sales_No_SoldAddr')
				IF VARTYPE(Sales_No_SoldAddr.Company) = "C"
					ThisForm.txtCompany.Value = Sales_No_SoldAddr.Company
				ENDIF
		
				USE IN Sales_No_SoldAddr
			ENDIF
			
			
		ENDIF
	ENDPROC

