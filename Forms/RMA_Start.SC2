	PROCEDURE lblGetPackingSlip.Click
		PRIVATE cSOitem,nRMA_Detail,nPackingSli 
		cSOitem = ThisForm.lstSOitem.Value
		*nRMA_Detail = PrepareSQLnum(RMA_Detail.RMA_Detail_ID,'RMA_Detail_ID',-3)
		nRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail_ID',-3)
		nPackingSli = 0
		
		IF nRMA_Detail = 0
			MESSAGEBOX("Please Save this RMA first."+CHR(13)+"Then get the PackingSlip number"+CHR(13)+"and Save Item Reason",0,"Need to get a RMA number")
			
		ELSE
			IF cSOitem <> Proper_SO_item('')
				ThisForm.SOitem = cSOitem 
				DO FORM Forms\ChooseSD_PackingSli WITH cSOitem,-nRMA_Detail TO nPackingSli 
			ENDIF
			
			nPackingSli = PrepareSQLnum(nPackingSli,'PackingSli',-3)
			IF nPackingSli > 0
				ThisForm.txtPackingSli.Value = nPackingSli  
				
				ThisForm.SaveRMA_Detail(nRMA_Detail)
				*UPDATE RMA_Detail SET PackingSli = nPackingSli  
		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE lblOrderdate.Click
		PRIVATE m.dDate1,m.dDate2
		
		m.dDate1 = ThisForm.txtNotified.Value
		DO FORM "forms\popupdate.scx" WITH m.dDate1 TO m.dDate2
		IF VARTYPE(m.dDate2) = "D"
			ThisForm.txtNotified.Value = m.dDate2
		ENDIF
		IF VARTYPE(m.dDate2) = "T"
			ThisForm.txtNotified.Value = CTOD(TTOC(m.dDate2))
		ENDIF
		
		ThisForm.txtNotified.Refresh
		ThisForm.txtNotified.SetFocus
		
		
	ENDPROC

