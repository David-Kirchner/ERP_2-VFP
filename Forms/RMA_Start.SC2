	PROCEDURE checkdata
		*ThisForm.CheckData()
		
		PRIVATE lSave
		lSave = .T.
		PRIVATE cReason
		cReason = ALLTRIM(PrepareSQLtxt(ThisForm.txtReason.Value,'Reason',-1))
		IF LEN(cReason) = 0
			MESSAGEBOX( "You need to enter a Reason",0,"No Save")
			RETURN .F.
		ENDIF
		
		
		PRIVATE dNotified, dAprv_Date 
		dNotified = PrepareSQLdate(ThisForm.txtNotified.Value,'Notified')
		
		*IF TYPE("RMA.Notified") = "C"
		*	dNotified = CtoD(RMA.dNotified)
		*ENDIF
		
		IF TYPE("dNotified") <> "D" OR EMPTY(dNotified)
			MESSAGEBOX( "You need an 'Notified' date!"+CHR(13)+"Set to todays date.",0,"OK to Save")
			dNotified = DATE()
			ThisForm.txtNotified.Refresh
		*	RETURN .F.
		ENDIF
		
		*!*	IF TYPE("RMA.Aprv_Date") = "C"
		*!*		dAprv_Date = CtoD(RMA.Aprv_Date)
		*!*	ENDIF
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(ThisForm.lstSOitem.Value,'SOitem',10)
		
		
		IF Proper_SO_item(cSOitem) = Proper_SO_item("")
		*IF ALEN(aSoItems) = 0
			MESSAGEBOX( "You have no SO Items selected!"+CHR(13)+"Click 'Select Items' to find the item to be returned.",0,"No Save" )
			RETURN .F.
		ENDIF
		
		*Get return location
		cReturnTo = PrepareSQLtxt(ThisForm.txtReturnTo.Value,'ReturnTo',1)
		IF LEN(cReturnTo) = 0
			*get cReturnTo 
			*Get_From_Sales_SOitem  
			PRIVATE cForm
			cForM = PrepareSQLtxt( Get_From_AllQuote_SOitem(cSOitem, "Form", ThisForm.nConnHandle ),'Form',2)
			IF LEN(cForm)>0
				PRIVATE cBranchInit 
				cBranchInit = GetBRANCHfromForm (cForm, ThisForm.nConnHandle )  
				IF LEN(cBranchInit) > 0
					cReturnTo = cBranchInit 
					ThisForm.txtReturnTo.Value = cReturnTo 
				ENDIF
			ENDIF
		
		ENDIF
		IF LEN(cReturnTo) > 0 AND NOT ( cReturnTo = "T" OR cReturnTo = "W" )
			MESSAGEBOX("Bad choice to return RMA Meterail to."+CHR(13)+cReturnTo+CHR(13)+"Reseting to empty",0+64,"Return To error")
			cReturnTo = ''
			ThisForm.txtReturnTo.Value = cReturnTo 
		ENDIF
		
		
		RETURN lSave
	ENDPROC

	PROCEDURE createrma_receive
		PARAMETERS nRMA_Detail,nPackingSlip
		*lOK = ThisForm.CreateRMA_Receive(nRMA_Detail,nPackingSlip)
		
		* See if already exists nRMA_Detail,nPackingSlip in dbo.RMA_Receive
		
		* populate table now so RMA screen can be used to choose to Use or Not Use.
		
		*The Sales_Detail and PackingSlip no can shoe the Receiving team exactly what to expext back.
		
		*insert into  dbo.RMA_Receive
		
		*!*		,[RMA_Detail_ID]
		*!*	      ,[ReceivingID]
		*!*	      ,[SOitem]
		*!*	      ,[Stk_ID_Detail]
		*!*	      ,[Who]
		*!*	      ,[WHEN]
		*!*	      ,[Sales_Detail_ID]
		*!*	      ,[Descrip]
		*!*	      ,[DoNotUse]
		
		RETURN .T.
	ENDPROC

	PROCEDURE getcompanysoitem		&& Fills Company, contact
		PARAMETER pSOitem
		*ThisForm.GetCompanySOitem(pSOitem)
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT Company,Name,Phone,Fax,Email,SalesP,Cover "
		*cSQL = cSQL + ",dbo.f_Descript(AQ.Alloy,AQ.CC,AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen) AS Descript "
		*cSQL = cSQL + ",AQ.SalesP"
		cSQL = cSQL + " FROM dbo.Allquotes AQ WHERE AQ.SOitem = '"+pSOitem+"'"
		
		IF USED("tmpAllQuotes")
			USE IN tmpAllQuotes
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAllQuotes')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAllQuotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAllQuotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpAllQuotes')
			*error
		ELSE
			IF USED("tmpAllQuotes")
				SELECT tmpAllQuotes
				IF NOT EOF('tmpAllQuotes')
					ThisForm.txtCompany.Value = tmpAllQuotes.Company
					ThisForm.txtContact.Value = tmpAllQuotes.Name
					ThisForm.txtEmail.Value = tmpAllQuotes.Email
					ThisForm.txtPhone.Value = tmpAllQuotes.Phone
					ThisForm.txtFax.Value = tmpAllQuotes.Fax
					
					ThisForm.txtAuth_By.Value = SalesPDescription(tmpAllQuotes.SalesP,tmpAllQuotes.Cover)
					
					*ThisForm.Load_SOitem_Detail(pSOitem)
					
					*Get RMA with SOitem.
					IF USED('tmpRMASoitem')
						USE IN tmpRMASoitem
					ENDIF
		
					SELECT 0
		
					cSQL = "SELECT RMA_No FROM dbo.RMA_Detail "
					cSQL = cSQL + " WHERE SO_item = '"+pSOitem+"'"
		
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMASoitem')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMASoitem')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMASoitem")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMASoitem")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpRMASoitem')
					ENDIF
		
					IF USED('tmpRMASoitem')
						IF RECCOUNT('tmpRMASoitem') > 0
							IF ThisForm.txtRMA_No.Value > 0
								IF ThisForm.txtRMA_No.Value <> tmpRMASoitem.RMA_No
									PRIVATE nMess
									nMess = MESSAGEBOX("This SOitem '"+pSOitem+"' is already atached "+CHR(13)+" to RMA "+ALLTRIM(STR(tmpRMASoitem.RMA_No))+CHR(13)+"Do you want to have this POitem to be for "+CHR(13)+" RMA "+ALLTRIM(STR(ThisForm.txtRMA_No.Value))+" ?",4+32,"Use another RMA number?") 
									IF nMess = 6
										ThisForm.txtRMA_No.Value = tmpRMASoitem.RMA_No
									ENDIF
								ENDIF
							ELSE
								ThisForm.txtRMA_No.Value = tmpRMASoitem.RMA_No
							ENDIF
						ELSE
							ThisForm.txtRMA_No.Value = 0
						ENDIF
						USE IN tmpRMASoitem
					ELSE
						ThisForm.txtRMA_No.Value = 0
					ENDIF
				ENDIF
			ENDIF
		
		
			USE IN tmpAllQuotes
		ENDIF
		
		
	ENDPROC

	PROCEDURE getnextrma
		*ThisForm.GetNextRMA()
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpRMAmax')
			USE IN tmpRMAmax
		ENDIF
		
		SELECT 0
		cSQL = "SELECT MAX(rma_no) as nMAX "
		cSQL = cSQL +" FROM dbo.RMA "
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMAmax')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMAmax')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMAmax")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMAmax")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpRMAmax')
		ENDIF
		
		PRIVATE nMax
		nMax = 0
		
		IF USED('tmpRMAmax')
			IF RECCOUNT('tmpRMAmax') > 0
				nMax = PrepareSQLnum(tmpRMAmax.nMAX,'RMA_No',-3)
				IF nMax > 0
					nMax = nMax + 1
					ThisForm.txtRMA_No.Value = nMax
					ThisForm.InsertRMA = .T.
				ENDIF
			ENDIF
		ENDIF
		
		RETURN nMax
	ENDPROC

	PROCEDURE get_asoitems
		PARAMETERS pRMA_No,pSOitem
		*ThisForm.get_aSOitems(pRMA_No,pSOitem)
		
		PRIVATE nRMA_No,cSOitem
		IF VARTYPE(pRMA_No) != "N"
			nRMA_NO = 0
		ELSE
			nRMA_NO = pRMA_NO
		ENDIF
		cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpRMA_Detail')
			USE IN tmpRMA_Detail
		ENDIF
		
		SELECT 0
		IF Proper_PO_item(cSOitem) != Proper_PO_item('') AND  nRMA_No > 0
			cSQL = "SELECT DISTINCT RMA_Detail.SO_Item"
			cSQL = cSQL +" ,CONVERT( CHAR(10), RMA_Detail.Returned, 101 ) AS Returned"
		
			cSQL = cSQL +" ,RMA_Detail.Cancelled, RMA_Detail.Reason, RMA_Detail.Inspect "
			cSQL = cSQL +" ,SD.Alloy,SD.Descript"
			cSQL = cSQL + ",SD.PackingSli"
			cSQL = cSQL +" FROM dbo.RMA_Detail "
			cSQL = cSQL +" LEFT OUTER JOIN dbo.Sales_Detail SD ON SD.Soitem = RMA_Detail.SO_item "
			
			cSQL = cSQL +" WHERE SOitem = '"+cSOitem+"'"
			cSQL = cSQL +" AND RMA_No = "+STR(nRMA_No)
			
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_Detail")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpRMA_Detail')
			ENDIF
		ENDIF
		
		IF NOT USED('tmpRMA_Detail')
		*	Try again
		*	IF RECCOUNT('tmpRMA_Detail') = 0
				
				cSQL = "SELECT DISTINCT RMA_Detail.SO_Item"
				cSQL = cSQL +" ,CONVERT( CHAR(10), RMA_Detail.Returned, 101 ) AS Returned"
		
				cSQL = cSQL +" ,RMA_Detail.Cancelled, RMA_Detail.Reason, RMA_Detail.Inspect "
				cSQL = cSQL +" ,SD.Alloy,SD.Descript"
				cSQL = cSQL + ",SD.PackingSli"
				cSQL = cSQL +" FROM dbo.RMA_Detail "
				cSQL = cSQL +" LEFT OUTER JOIN dbo.Sales_Detail SD ON SD.Soitem = RMA_Detail.SO_item "
				IF nRMA_No > 0
					cSQL = cSQL +" WHERE  RMA_No = "+STR(nRMA_No)
				ELSE
					cSQL = cSQL +" WHERE 0>0"
				ENDIF
				
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_Detail')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_Detail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_Detail")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpRMA_Detail')
				ENDIF
		
			*ENDIF
		ENDIF
		
		IF USED('tmpRMA_Detail')
			IF RECCOUNT('tmpRMA_Detail') = 0
				MESSAGEBOX("No Records Found",64,"No data to display")
				*RecordError(nSQLEXEC,"No Records Found" ,PROGRAM(),LINENO(1),cSQL )
			ELSE
		
				*ThisForm.RMA_Detail_Load()	&&RMA_Detail
				ThisForm.RMA_No_Refresh()	&&RMA_Detail
				
				ThisForm.lstSOitem.RowSource	= ""
				
				*This is pulling from tmpRMA_Detail not RMA_Detail !?!
				SELECT SO_item FROM tmpRMA_Detail INTO ARRAY aSoItems
				
				ThisForm.lstSOitem.NumberOfElements	= ALEN(aSoItems,1)
				ThisForm.lstSOitem.RowSource	= "aSoItems"
				ThisForm.lstSOitem.Value = tmpRMA_Detail.SO_Item
				ThisForm.lstSOitem.Refresh
				
				*ThisForm.txtRMA_Detail.Value = 
			ENDIF
		ELSE
		
			IF Proper_SO_item(cSOitem) != Proper_SO_item('')
					
				cSQL = "SELECT Company, Name, Phone,Fax,Email,PO_Num,Alloy,SalesP,Q_Total"
				cSQL = cSQL + ",dbo.f_Descript(AQ.Alloy,AQ.CC,AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen) AS Descript "
				cSQL = cSQL + ", ISNULL((SELECT TOP 1 PackingSli FROM dbo.PackingSlip WHERE SOitem = AQ.SOitem),0) AS PackingSli "
				
				cSQL = cSQL +" FROM dbo.AllQuotes AQ WITH(NOLOCK) "
				cSQL = cSQL +" WHERE SOitem = '"+cSOitem+"'"
				
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_Detail')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_Detail')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_Detail")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_Detail")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpRMA_Detail')
				ENDIF
			
				IF USED('tmpRMA_Detail')
					IF RECCOUNT('tmpRMA_Detail') > 0
						ThisForm.txtRMA_No.Value = nRMA_NO 
						ThisForm.txtCompany.Value = tmpRMA_Detail.Company
						ThisForm.txtContact.Value = tmpRMA_Detail.Name
						ThisForm.txtEmail.Value	= tmpRMA_Detail.Email
						ThisForm.txtPhone.Value = tmpRMA_Detail.Phone
						ThisForm.txtFax.Value	= tmpRMA_Detail.Fax
						*ThisForm.txtEmail.Value = tmpRMA_Detail.Email
						*ThisForm. tmpRMA_Detail.PO_Num
						* tmpRMA_Detail.Alloy
						ThisForm.txtSalesP.Value =  tmpRMA_Detail.SalesP
						ThisForm.txtItemSale.Value = PrepareSQLnum(tmpRMA_Detail.Q_Total,'Q_Total',-5)
						* tmpRMA_Detail.Descript 
						ThisForm.txtPackingSli.Value = PrepareSQLnum(tmpRMA_Detail.PackingSli,'PackingSli',-3)
						
						ThisForm.txtAuth_By.Value = ALLTRIM(  RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )  )
					ELSE
						ThisForm.GetCompanySOitem(cSOitem)		
					ENDIF
				ENDIF
		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETER pRMA_No, pSOitem
		*DO FORM Forms\RMA_Start WITH nRMA_No, SOitem
		*DO FORM Forms\RMA_Start WITH 0,' 129405-01
		
		PRIVATE nRMA_No 
		nRMA_No = PrepareSQLnum(pRMA_No,'RMA_No',-3)
		PRIVATE cSOitem 
		cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		ThisForm.SOitem = cSOitem
		*Force parameters for testing
		*	pRMA_No = 0
		*	cSOitem = ' 116804-03'
		ThisForm.Visible = .T.
		
		IF Proper_SO_item(cSOitem) != Proper_SO_item('')
			ThisForm.Caption = ThisForm.Caption + " for SOitem "+cSOitem
		ELSE
			MESSAGEBOX("Did not get a SOitem",0,"Cannot continue")
			RETURN .F.
		ENDIF
		
		**** PUBLIC aSoItems(1) gaReason(1)
		IF nRMA_No > 0
			ThisForm.Get_aSoItems(nRMA_No,cSOitem) &&tmpRMA_Detail
		ENDIF
		
		ThisForm.Load_RMA(nRMA_No)	&&RMA, RMA_Detail
		*ThisForm.RMA_Refresh() -done in Load_RMA()
		*ThisForm.RMA_Detail_Load()
		
		RELEASE m.ncmbFind,m.FindText
		Public m.ncmbFind,m.FindText
		m.ncmbFind = 1
		m.FindText = 0
		
		ThisForm.OleDate = DATE()
		
		IF nRMA_No > 0
			SELECT RMA
			*SEEK nRMA_No ORDER RMA_No IN RMA
			LOCATE FOR RMA_No = nRMA_No
		ENDIF
		PRIVATE nRMA_Detail_ID
		nRMA_Detail_ID = 0
		IF USED('RMA_Detail')
			nRMA_Detail_ID = PrepareSQLnum(RMA_Detail.RMA_Detail_ID,'RMA_Detail_ID',-3)
		ENDIF
		
		IF nRMA_Detail_ID = 0
			*INIT nRMA_Detail_ID by SOitem
			*Get From Quotes program!
			
			ThisForm.GetCompanySOitem(cSOitem)	&&tmpAllQuotes, tmpRMASoitem
			
		*	IF ThisForm.txtRMA_No.Value = 0
				*ThisForm.txtRMA_No.Value = ThisForm.GetNextRMA()
				*--keep at 0 till Saved.
		
				ThisForm.txtNotified.Value = DATE()
		
				*Add SOitem
				ThisForm.Load_SOitem_Detail(cSOitem)
				
		*	ENDIF
		ELSE
			*ThisForm.nRMA_Detail_ID = nRMA_Detail_ID
		ENDIF
		
		
		
		*ThisForm.RefreshEditTab()
		
		ThisForm.lstSOitem.RowSource			= "aSoItems"
		ThisForm.lstSOitem.NumberOfElements	= ALEN(aSoItems,1)
		ThisForm.lstSOitem.Refresh
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		
		PUBLIC aSoItems(1)
		aSoItems(1)=" "
		
		PUBLIC gaReason(1)
		gaReason(1) = " "
		
		
	ENDPROC

	PROCEDURE load_rma
		PARAMETERS pRMA_No
		*ThisForm.Load_RMA()
		
		PRIVATE nRMA_NO
		IF VARTYPE(pRMA_No) != "N"
			nRMA_NO = 0
		ELSE
			nRMA_NO = pRMA_NO
		ENDIF
		
		IF USED('RMA')
			USE IN RMA
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.RMA "
		IF nRMA_NO = 0
			cSQL = cSQL + " WHERE 0>0"
		ELSE
			cSQL = cSQL + " WHERE RMA_No ="+STR(nRMA_NO )
		ENDIF
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'RMA')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'RMA')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "RMA")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "RMA")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'RMA' )
		ENDIF
		
		
		IF USED('RMA')
			*show the data!
			IF RECCOUNT('RMA') = 0	
				*dNotified = DATE()
				ThisForm.txtNotified.Value = DATE()
			ELSE
			
			ENDIF
			ThisForm.RMA_Refresh()
			
		ELSE
			MESSAGEBOX('Failed to load RMA',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		IF USED('RMA_Detail')
			SELECT RMA_Detail
		ELSE
			SELECT 0
		ENDIF
		
		cSQL = "SELECT DISTINCT RMA_Detail.* "
		cSQL = cSQL + " ,SD.Alloy, SD.Sale_PC, SD.Descript, SD.Heat "
		cSQL = cSQL + " ,SD.PackingSli"
		cSQL = cSQL + " FROM dbo.RMA_Detail "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales_Detail SD ON SD.Soitem = RMA_Detail.SO_item"
		IF nRMA_NO = 0
			cSQL = cSQL + " WHERE 0>0"
		ELSE
			cSQL = cSQL + " WHERE RMA_Detail.RMA_No ="+STR(nRMA_NO)
		ENDIF
		
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'RMA_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'RMA_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "RMA_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "RMA_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'RMA_Detail' )
		ENDIF
		
		
		IF USED('RMA_Detail')
			*Show RMA_Detail
			ThisForm.RMA_Detail_Refresh()
			
		ELSE
			MESSAGEBOX('Failed to load RMA_Detail',0+16,"Error")
			RETURN .F.	
		ENDIF
	ENDPROC

	PROCEDURE load_soitem_detail		&& Loads the SOitem in the RM_Detail
		PARAMETERS pSOitem
		*ThisForm.Load_SOitem_Detail(pSOitem)
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT Company,Name,Phone,Fax "
		cSQL = cSQL + ",dbo.f_Descript(AQ.Alloy,AQ.CC,AQ.Form,AQ.Thck,AQ.Sz2,AQ.Sz3,AQ.Q_QTY,AQ.RandLen) AS Descript "
		cSQL = cSQL + ",AQ.SalesP,AQ.Q_Total "
		cSQL = cSQL + ",S.ItemSale,S.ItemCost "
		cSQL = cSQL + ",S.Cncld,S.Cmplt "
		cSQL = cSQL + " FROM dbo.Allquotes AQ WITH(NOLOCK) "
		cSQL = cSQL + " INNER JOIN dbo.Sales S WITH(NOLOCK) ON AQ.SOitem = S.SOitem "
		cSQL = cSQL + " WHERE AQ.SOitem = '"+pSOitem+"'"
		
		IF USED("tmpAQSOi")
			USE IN tmpAQSOi
		ENDIF
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQSOi')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAQSOi')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQSOi")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQSOi")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpAQSOi')
			*error
		ELSE
			IF USED("tmpAQSOi")
				SELECT tmpAQSOi
				IF RECCOUNT('tmpAQSOi')>0
					ThisForm.lblDescript.Caption = tmpAQSOi.Descript 
					ThisForm.txtReason.Value = 'Need to Enter Customers Reason here.'
					ThisForm.txtItemSale.Value = PrepareSQLnum(tmpAQSOi.ItemSale,'ItemSale',9,2)
					ThisForm.txtRefunded.Value = PrepareSQLnum(tmpAQSOi.ItemSale*.8,'ItemSale',9,2)
					ThisForm.txtSalesP.Value = tmpAQSOi.SalesP
					ThisForm.spnSP_Fault.Value = 0
					ThisForm.chkSameReason.Value = 1
					
					ThisForm.chkCancelSOitem.Value = PrepareSQLbit(tmpAQSOi.Cncld,'Cncld SOitem')
					
					*****************************************
					*Does SOitem need to be added to lstSOitem
					
					IF ASCAN(aSOItems, pSOitem) = 0 &&Not Found
						*add SOitem
						IF ALEN(aSoItems,1)=1 AND aSoItems(1) = ""
							aSoItems(1) = pSOitem
						ELSE
							PRIVATE nLenaSoItems
							nLenaSoItems = ALEN(aSoItems,1)
							DIMENSION aSoItems(nLenaSoItems +1)
							aSoItems(nLenaSoItems +1) = pSOitem
						ENDIF
						
						IF ALEN(gaReason,1)=1 AND gaReason(1) = ""
							gaReason(1) = ThisForm.txtReason.Value
						ELSE
							PRIVATE nLenaSoItems
							nLenaSoItems = ALEN(gaReason,1)
							DIMENSION gaReason(nLenaSoItems +1)
							gaReason(nLenaSoItems +1) = ThisForm.txtReason.Value
						ENDIF
						
					ENDIF
					ThisForm.lstSOitem.Value = pSOitem
					ThisForm.lstSOitem.Refresh
					
					ThisForm.txtReason.SetFocus
				ENDIF	
		
				USE IN tmpAQSOi
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE refreshedittab
		*ThisForm.RefreshEditTab()
		
		*ThisForm.RMA_No_refresh()
		*ThisForm.get_aSOitems()
		
	ENDPROC

	PROCEDURE resetaddvars
		
		
		*ThisForm.RMA_No_refresh()
		*ThisForm.get_aSOitems()
		
	ENDPROC

	PROCEDURE rma_detail_load
		*ThisForm.RMA_Detail_Load()
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE nRMA_No
		nRMA_No = PrepareSQLnum(RMA.RMA_No,'RMA_No',-3)
		
		aSoItems(1) = ""
		ThisForm.SOitem = aSoItems(1)
		
		IF USED('RMA_Detail')
			USE IN RMA_Detail
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT DISTINCT RMA_Detail.* "
		cSQL = cSQL + ", SD.Alloy, SD.Sale_PC, SD.Descript, SD.Heat "
		cSQL = cSQL + " ,SD.PackingSli"
		cSQL = cSQL + " FROM dbo.RMA_Detail "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.Sales_Detail SD ON SD.Soitem = RMA_Detail.SO_item"
		cSQL = cSQL + " WHERE RMA_Detail.RMA_No = "+STR(nRMA_No)
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'RMA_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'RMA_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "RMA_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "RMA_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'RMA_Detail')
		ENDIF
		
		ThisForm.RMA_Detail_Refresh
		
	ENDPROC

	PROCEDURE rma_detail_refresh
		*ThisForm.RMA_Detail_Refresh()
		
		IF USED('RMA_Detail')
			IF RECCOUNT('RMA_Detail') > 0
				ThisForm.txtRMA_Detail.Value = PrepareSQLnum(RMA_Detail.RMA_Detail_ID,'RMA_Detail',-3)
				ThisForm.txtReturned.Value	= IIF(EMPTY(RMA_Detail.Returned),'',RMA_Detail.Returned)
				ThisForm.txtReason.Value	= ShowSQLtxt(RMA_Detail.Reason,'Reason',-1)
				
				ThisForm.txtItemSale.Value	= PrepareSQLnum(RMA_Detail.ItemSale,'ItemSale',9,2)
				ThisForm.txtRefunded.Value	= PrepareSQLnum(RMA_Detail.Refunded,'Refunded',9,2)
				ThisForm.txtSalesP.Value 	= PrepareSQLtxt(RMA_Detail.SalesP,'SalesP',1)
				ThisForm.spnSP_Fault.Value	= PrepareSQLnum(RMA_Detail.SP_Fault,'SP_Fault',-1)
				ThisForm.chkCancelSOitem.Value = PrepareSQLbit(RMA_Detail.cncSO_item,'cncSO_item')
				ThisForm.txtPackingSli.Value	= PrepareSQLnum(RMA_Detail.PackingSli,'PackingSli',-3)
				ThisForm.txtReturnTo.Value	= PrepareSQLtxt(RMA_Detail.ReturnTo,'ReturnTo',1)
				*SELECT TOP 1 RTRIM(AQ.Alloy)+' '+dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) FROM dbo.AllQuotes AQ WHERE AQ.SOitem = RMA_Detail.SO_item) AS DescriptM 
				
			ELSE
				ThisForm.txtRMA_Detail.Value = 0
				ThisForm.txtReturned.Value	= CTOD('')
				ThisForm.txtReason.Value	= ''
				
				ThisForm.txtItemSale.Value	= 0
				ThisForm.txtRefunded.Value	= 0
				ThisForm.txtSalesP.Value 	= ''
				ThisForm.spnSP_Fault.Value	= 0
				ThisForm.chkCancelSOitem.Value = 1
				ThisForm.txtPackingSli.Value	= 0
				ThisForm.txtReturnTo.Value	= ''
					
				ThisForm.chkSameReason.Value = 1
			ENDIF
			
			SELECT SO_item FROM RMA_Detail INTO ARRAY aSoItems
			ThisForm.lstSOitem.Refresh
			ThisForm.SOitem = aSoItems(1)
		
			ThisForm.chkSameReason.Value = get_RMA_Detail_SameReason(RMA_Detail.RMA_No,ThisForm.nConnHandle)
				
		ELSE
			ThisForm.lstSOitem.Refresh
		ENDIF
		
		
	ENDPROC

	PROCEDURE rma_no_refresh
		*ThisForm.RMA_No_refresh()
		
		
		ThisForm.RMA_Detail_Refresh()
		
		
	ENDPROC

	PROCEDURE rma_refresh
		*ThisForm.RMA_Refresh()
		
		ThisForm.txtRMA_No.Value	= RMA.RMA_No
		ThisForm.txtCompany.Value	= RMA.Company
		ThisForm.txtContact.Value	= RMA.Contact
		ThisForm.txtEmail.Value		= RMA.Email
		ThisForm.txtPhone.Value		= RMA.Phone
		ThisForm.txtFax.Value		= RMA.Fax
		ThisForm.txtNotified.Value	= RMA.Notified
		ThisForm.txtAPRV_Date.Value	= RMA.APRV_Date
		ThisForm.txtAPRV_By.Value	= RMA.APRV_By
		ThisForm.txtAUTH_By.Value	= RMA.AUTH_By
		ThisForm.txtMoney.Value		= RMA.Money
		
		IF NOT ( VARTYPE(ThisForm.txtNotified.Value) = "T" OR VARTYPE(ThisForm.txtNotified.Value) = "D" )
			ThisForm.txtNotified.Value = DATE()
		ENDIF
	ENDPROC

	PROCEDURE saveadd
		PARAMETER pSaveType
		*ThisForm.SaveAdd()
		
		PRIVATE m.shipcomplete, lRMAsaved
		PRIVATE nCurrRec
		PRIVATE lnSalesNum
		PRIVATE lActionRequest, nSalesNum
		
		lRMAsaved = .F.
		lActionRequest = .T.
		nSalesNum = VAL( LEFT( aSoItems(1), 7))
		IF ALEN( aSoItems ) > 100
			MESSAGEBOX("Over 100 Items were Selected."+CHR(13)+"The program feels this is an Error and will reject the SAVE!",0,"No Save")
			RETURN
		ENDIF
		
		PRIVATE nRMA_No,cCompany,cContact,cEmail,cPhone,cFax,dNotified
		PRIVATE dAPRV_Date,dAPRV_By,cAuth_By,cMoney
		nRMA_No		= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		cCompany	= PrepareSQLtxt(ThisForm.txtCompany.Value,'Company',30)
		cContact	= PrepareSQLtxt(ThisForm.txtContact.Value,'Contact',20)
		cEmail		= PrepareSQLtxt(ThisForm.txtEmail.Value,'Email',100)
		cPhone		= PrepareSQLtxt(ThisForm.txtPhone.Value,'Phone',20)
		cFax		= PrepareSQLtxt(ThisForm.txtFax.Value,'Fax',20)
		dNotified	= PrepareSQLDate(ThisForm.txtNotified.Value,'Notified')
		dAPRV_Date	= PrepareSQLDate(ThisForm.txtAPRV_Date.Value,'APRV_Date')
		cAPRV_By	= PrepareSQLtxt(ThisForm.txtAPRV_By.Value,'APRV_By',20)  &&Insert uses 'Not Approved'
		
		cAuth_By	= PrepareSQLtxt(ThisForm.txtAuth_By.Value,'Auth_By',20)
		cMoney		= PrepareSQLtxt(ThisForm.txtMoney.Value,'Money',-1)
		
		*PRIVATE nCancelled,dReturned,cReason
		*nCancelled	= ThisForm.txt.Value
		*dReturned	= PrepareSQLDate(ThisForm.txtReturned.Value,'Returned')
		*cReason	= ALLTRIM(PrepareSQLtxt(RMA_Detail.Reason,'Reason',-1))
		
		***********Check Values
		
		IF EMPTY(nRMA_No)
			*	Must be an Insert!
			ThisForm.InsertRMA = .T.
			nRMA_No = 0
			*	nRMA_No = ThisForm.GetNextRMA()
		ENDIF
		
		IF TYPE("nSalesNum") <> "N"
			nSalesNum = 0
		ENDIF
		
		IF TYPE("dNotified") <> "D" OR EMPTY(dNotified)
			MESSAGEBOX( "You need an 'Notified' date!"+CHR(13)+"Set to todays date.",0,"No Save")
			ThisForm.txtNotified.Value = DATE()
			ThisForm.txtNotified.Refresh
			RETURN .F.
		ENDIF
		
		IF ALEN(aSoItems) = 0
			MESSAGEBOX( "You have no SO Items selected!"+CHR(13)+"Click 'Select Items' to find the item to be returned.",0,"No Save" )
			RETURN .F.
		ENDIF
		
		IF EMPTY(cAuth_By)
			PRIVATE cMach_User
			cMach_User = SYS(0)
			cAuth_By = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		ENDIF
		
		IF NOT ThisForm.InsertRMA AND nRMA_No > 0
			*Update
			*ThisForm.Edit1.VALUE = "UPDATE RMA #"+ALLTRIM(STR(m.nRMA_No))+"."
		
			dAPRV_Date= CTOD('')
			cAPRV_By	= 'Not Approved'
		
			cSQL = "UPDATE dbo.RMA SET "
			cSQL = cSQL + " Company='"+cCompany+"'"
			cSQL = cSQL + ",contact='"+cContact+"'"
			cSQL = cSQL + ",Email='"+cEmail+"'"
			cSQL = cSQL + ",Phone='"+cPhone+"'"
			cSQL = cSQL + ",Fax='"+cFax+"'"
			cSQL = cSQL + ",Notified='"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
			cSQL = cSQL + ",APRV_Date='"+IIF(EMPTY(dAPRV_Date),'',DTOC(dAPRV_Date))+"'"
			cSQL = cSQL + ",APRV_By='"+cAPRV_By+"'"
			cSQL = cSQL + ",Auth_By='"+cAuth_By+"'"
			cSQL = cSQL + ",Money='"+cMoney+"'"
			cSQL = cSQL + " WHERE RMA_No = "+STR(nRMA_No)
		
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				lRMAsaved = .T.
			ENDIF
		ENDIF
		
		
		
		
		IF ThisForm.InsertRMA OR nRMA_No = 0
			*INSERT
			*nRMA_No = 0
		
			m.dAPRV_Date= CTOD('')
			m.cAPRV_By	= 'Not Approved'
		
			cSQL = "INSERT INTO dbo.RMA (Company,contact,Email,Phone,Fax,Notified,APRV_Date,APRV_By,Auth_By,Money,Cancelled) VALUES  ("
			cSQL = cSQL + " '"+cCompany+"'"
			cSQL = cSQL + ",'"+cContact+"'"
			cSQL = cSQL + ",'"+cEmail+"'"
			cSQL = cSQL + ",'"+cPhone+"'"
			cSQL = cSQL + ",'"+cFax+"'"
			cSQL = cSQL + ",'"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
			cSQL = cSQL + ",'"+IIF(EMPTY(dAPRV_Date),'',DTOC(dAPRV_Date))+"'"
			cSQL = cSQL + ",'"+cAPRV_By+"'"
			cSQL = cSQL + ",'"+cAuth_By+"'"
			cSQL = cSQL + ",'"+cMoney+"'"
			cSQL = cSQL + ",0"
			cSQL = cSQL + ")"
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
			ELSE
				lRMAsaved = .T.
			ENDIF
		
			IF lRMAsaved
				**Get nRMA_No
				IF USED('tmpRMA_No')
					USE IN tmpRMA_No
				ENDIF
				SELECT 0
				cSQL = "SELECT RMA_No FROM dbo.RMA WHERE "
				cSQL = cSQL + " Company='"+cCompany+"'"
				cSQL = cSQL + " AND contact='"+cContact+"'"
				cSQL = cSQL + " AND Email='"+cEmail+"'"
				cSQL = cSQL + " AND Phone='"+cPhone+"'"
				cSQL = cSQL + " AND Fax='"+cFax+"'"
				cSQL = cSQL + " AND Notified='"+IIF(EMPTY(dNotified),'',DTOC(dNotified))+"'"
				cSQL = cSQL + " AND Auth_By='"+cAuth_By+"'"
				cSQL = cSQL + " AND Money='"+cMoney+"'"
		
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_No')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_No' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_No")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_No")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpRMA_No' )
				ENDIF
				IF USED('tmpRMA_No')
					IF VARTYPE(tmpRMA_No.RMA_No) = 'N'
						nRMA_No = tmpRMA_No.RMA_No
						*ThisForm.Edit1.Value = "New RMA is:"+ALLTRIM(STR(nRMA_No))+CHR(13)+ThisForm.Edit1.Value
						ThisForm.txtRMA_No.Value = nRMA_No
					ELSE
						lRMAsaved = .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		PRIVATE cSOitem
		*cSOitem = Proper_SO_Item( aSoItems(nItems) )
		cSOitem = PrepareSQLtxt(ThisForm.lstSOitem.Value,'SOitem',10)
		PRIVATE nRMA_Detail
		nRMA_Detail = 0
		
		IF lRMAsaved
			*Save Details **************
			PRIVATE lcReason, dReturned, nItemSale, nRefunded, nPackingSlip, cReturnTo, cSalesP, nSP_Fault, lcncSO_item
			lcReason = PrepareSQLtxt(ThisForm.txtReason.Value,'Reason',-1)
			nItems = ALEN(gaReason)
			
		*	FOR nItems = 1 TO ALEN(aSoItems,1)
		*read screen data, not from aSoItems(nItems))
				*IF NOT EMPTY(ALLTRIM(aSoItems(nItems)))
				IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
				
					*Do not let blank SOitems into RMA_Detail
					IF lcReason <> gaReason(nItems)
						IF nItems = 1
							gaReason(1) = lcReason 
						ENDIF
					ENDIF
					
					*IF Is_RMA_Detail_RMA_N0andSO_item(nRMA_No,aSoItems(nItems),ThisForm.nConnHandle) = 0 cSOitem
					IF Is_RMA_Detail_RMA_N0andSO_item(nRMA_No,cSOitem,ThisForm.nConnHandle) = 0 
						*Insert
						lcReason = ALLTRIM(PrepareSQLtxt(ThisForm.txtReason.Value,'Reason',-1))
						dReturned = PrepareSQLDate(ThisForm.txtReturned.Value,'Returned')
						nItemSale = PrepareSQLnum(ThisForm.txtItemSale.Value,'ItemSale',-5)
						IF nItemSale = 0
							nItemSale = Get_ItemSaleinSales(aSoItems(nItems), ThisForm.nConnHandle)
						ENDIF
						nRefunded = PrepareSQLnum(ThisForm.txtRefunded.Value,'Refunded',-5)
						nPackingSlip = PrepareSQLnum(ThisForm.txtPackingSli.Value,'PackingSli',-3)
						cReturnTo	= PrepareSQLtxt(ThisForm.txtReturnTo.Value,'ReturnTo',1)
						cSalesP	 = PrepareSQLtxt(ThisForm.txtSalesP.Value,'SalesP',1)
						nSP_Fault = PrepareSQLnum(ThisForm.spnSP_Fault.Value,'SP_Fault',1)
						lcncSO_item = PrepareSQLchk(ThisForm.chkCancelSOitem.Value,'cncSO_item')
						
						cSQL = "INSERT INTO RMA_Detail "
						cSQL = cSQL + "(RMA_No, SO_item, ItemSale, Refunded, Reason, Inspect, cncSO_item, Cancelled "
						cSQL = cSQL + ",PackingSli, ReturnTo, SalesP, SP_Fault) VALUES ("
						cSQL = cSQL + " "+STR(nRMA_No)
						*cSQL = cSQL + ",'"+aSoItems(nItems)+"'"
						cSQL = cSQL + ",'"+cSOitem+"'"
						cSQL = cSQL + ","+STR(nItemSale,18,4)
						cSQL = cSQL + ","+STR(nRefunded,18,4)
						cSQL = cSQL + ",'"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'"	&&cReason
						cSQL = cSQL + ",''" &&Inspect
						cSQL = cSQL + ","+IIF(lcncSO_item,"1","0")
						cSQL = cSQL + ",0" && Cancelled 
						cSQL = cSQL + ","+STR(nPackingSlip)
						cSQL = cSQL + ",'"+cReturnTo+"'"
						cSQL = cSQL + ",'"+cSalesP+"'"
						cSQL = cSQL + ","+STR(nSP_Fault)
						cSQL = cSQL + ")"
		
		
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
						ELSE
							*Get RMA_Detail
							IF USED("tmpRMA_D_ID")
								USE IN tmpRMA_D_ID
							ENDIF
							SELECT 0
							
							cSQL = "SELECT RMA_Detail_ID FROM dbo.RMA_Detail WITH(NOLOCK) "
							cSQL = cSQL + " WHERE RMA_No="+STR(nRMA_No)
							cSQL = cSQL + " AND SO_item='"+aSoItems(nItems)+"'"
											
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_D_ID')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRMA_D_ID')
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_D_ID")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpRMA_D_ID")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpRMA_D_ID')
							ENDIF
							IF USED('tmpRMA_D_ID')
								nRMA_Detail = PrepareSQLnum(tmpRMA_D_ID.RMA_Detail_ID,'RMA_Detail_ID',-3)
								ThisForm.txtRMA_Detail.Value = nRMA_Detail
								USE IN tmpRMA_D_ID
							ENDIF	
						ENDIF
					ELSE
						
						nRMA_Detail = PrepareSQLnum(ThisForm.txtRMA_Detail.Value,'RMA_Detail',-3)
						ThisForm.SaveRMA_Detail(nRMA_Detail)
						
						cSQL = "UPDATE dbo.RMA_Detail SET "
						cSQL = cSQL + " Reason='"+PrepareSQLtxt(gaReason(nItems),'Reason',-1)+"'" &&cReason
						cSQL = cSQL + ",ItemSale="+STR(nItemSale)
						cSQL = cSQL + ",Refunded ="+STR(nRefunded)
						cSQL = cSQL + ",cncSO_item="+IIF(lcncSO_item,"1","0")
						cSQL = cSQL + ",PackingSli ="+STR(nPackingSlip)
						cSQL = cSQL + ",SalesP = '"+cSalesP+"'"
						cSQL = cSQL + ",SP_Fault="+STR(nSP_Fault)
						cSQL = cSQL + ",ReturnTo= '"+cReturnTo+"'"
						
						
						cSQL = cSQL + " WHERE RMA_Detail_ID="+STR(nRMA_Detail)
						*cSQL = cSQL + " AND SO_item='"+aSoItems(nItems)+"'"
						*cSQL = cSQL + " AND SO_item='"+cSOitem+"'"
		
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
						ENDIF
					ENDIF
		
		
					nSalesNum = VAL( LEFT( aSoItems(nItems), 7))
				
				ENDIF
		
		
				IF !EMPTY( aSoItems(nItems) )
					lCancelled = .F.
					*UpdateSalesWithRMA_No( aSoItems(nItems), nRMA_No, lCancelled , ThisForm.nConnHandle)
					UpdateSalesWithRMA_No( cSoItem, nRMA_No, lCancelled , ThisForm.nConnHandle)
				ENDIF
		*	ENDFOR
		
			*ThisForm.Edit1.VALUE = "RMA #"+ALLTRIM(STR(nRMA_No))+" saved."
			*ThisForm.Edit1.REFRESH
		ENDIF
		
		IF lRMAsaved
		
			*Save To dbo.Sales
			*FOR nItems = 1 TO ALEN(aSoItems,1)
				*cSOitem = Proper_SO_Item( aSoItems(nItems) )
		
				IF cSOitem <> Proper_SO_Item( "" )
					cSQL = "UPDATE dbo.Sales SET "
					cSQL = cSQL + " RMA_No = "+STR(nRMA_No)
					cSQL = cSQL + ",RMA_Detail = "+STR(nRMA_Detail)
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
		
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
					ENDIF
				ENDIF
			*ENDFOR
		
			IF pSaveType = "ADD"
				ThisForm.ResetAddVars()
			ENDIF
			
			ThisForm.REFRESH
		
		ENDIF
		
		
		IF USED("ActionRequest")
			USE IN ActionRequest
		ENDIF
		RETURN .T.
		
	ENDPROC

