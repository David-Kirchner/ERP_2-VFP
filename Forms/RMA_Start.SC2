	ENDPROC

	PROCEDURE saverma_detail
		PARAMETERS pnRMA_Detail
		*ThisForm.SaveRMA_Detail(nRMA_Detail)
		
		PRIVATE nRMA_No,nRMA_Detail,cSOitem
		nRMA_No	= PrepareSQLnum(ThisForm.txtRMA_No.Value,'RMA_No',-3)
		nRMA_Detail = PrepareSQLnum(pnRMA_Detail,'RMA_Detail',-3)
		cSOitem = PrepareSQLtxt(ThisForm.lstSOitem.Value,'SOitem',10)
		IF Proper_SO_item(cSOitem) = Proper_SO_item("")
			cSOitem = PrepareSQLtxt(ThisForm.SOitem,'SOitem',10)
		ENDIF
		
		PRIVATE cReason
		cReason	= PrepareSQLtxt(ThisForm.txtReason.Value,'Reason',-1)
		PRIVATE dReturned, nItemSale, nRefunded, cReturnTo, cSalesP, nSP_Fault, lcncSO_item, nPackingSlip 
		*dReturned = PrepareSQLdate(ThisFormset.frmRMA.pf1.pgAddEdit.txtReturned.Value,'Returned')
		nItemSale = PrepareSQLnum(ThisForm.txtItemSale.Value,'ItemSale',-5)
		nRefunded = PrepareSQLnum(ThisForm.txtRefunded.Value,'Refunded',-5)
		cReturnTo =	PrepareSQLtxt(ThisForm.txtReturnTo.Value,'ReturnTo',1)
		
		cSalesP	 = PrepareSQLtxt(ThisForm.txtSalesP.Value,'SalesP',1)
		nSP_Fault = PrepareSQLnum(ThisForm.spnSP_Fault.Value,'SP_Fault',1)
		lcncSO_item = PrepareSQLchk(ThisForm.chkCancelSOitem.Value,'cncSO_item')
		
		nPackingSlip = PrepareSQLnum(ThisForm.txtPackingSli.Value,'PackingSli',-3)
		
		IF nRMA_Detail = 0
			IF USED("tmpNewRMA_Detail")
				USE IN tmpNewRMA_Detail
			ENDIF
			SELECT 0
							
			cSQL = "EXEC dbo.p_INS_RMA_Detail "
			cSQL = cSQL + ""+ STR(nRMA_No) + ","
			cSQL = cSQL + "'"+ cSOitem + "'" 
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpNewRMA_Detail')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 2
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpNewRMA_Detail')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewRMA_Detail")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpNewRMA_Detail")
				ENDDO
			ENDIF
		
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpNewRMA_Detail')
			ENDIF
			IF USED('tmpNewRMA_Detail')
				IF RECCOUNT('tmpNewRMA_Detail') > 0
					nRMA_Detail = PrepareSQLnum(tmpNewRMA_Detail.RMA_Detail_ID,'RMA_Detail_ID',-3)
					ThisForm.txtRMA_Detail.Value = nRMA_Detail
				ENDIF
				USE IN tmpNewRMA_Detail
			ENDIF
		ENDIF
		
		IF nRMA_Detail = 0
			MESSAGEBOX('Could not save RMA_Detail',0,'error')
			RecordError( 0, 'Could not save RMA_Detail', PROGRAM(), LINENO(),"VFP message: Could not save RMA_Detail")
			RETURN .T.
		ENDIF
		*IF EXISTS()
		
		PRIVATE lOK
		lOK = .T.
		
		*,[returned],[inspect],[cancelled]
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "UPDATE dbo.RMA_Detail SET "
		*cSQL = cSQL + " RMA_No="+STR(nRMA_No)
		cSQL = cSQL + " SO_item='"+cSoItem+"'"
		cSQL = cSQL + ",ItemSale="+STR(nItemSale,18,2)
		cSQL = cSQL + ",Refunded ="+STR(nRefunded,18,2)
		cSQL = cSQL + ",Reason='"+cReason+"'"
		*cSQL = cSQL + ",Inspect
		cSQL = cSQL + ",cncSO_item="+IIF(lcncSO_item, "1","0")
		
		cSQL = cSQL + ",PackingSli ="+STR(nPackingSlip)
		cSQL = cSQL + ",SalesP = '"+cSalesP+"'"
		cSQL = cSQL + ",SP_Fault="+STR(nSP_Fault)
		
		*cSQL = cSQL + ",[ReceivingID]
		*cSQL = cSQL + ",[RMA_E]
		cSQL = cSQL + ",ReturnTo='"+cReturnTo+"'"
		*cSQL = cSQL + ",Descrip='"+cDescrip+"'"
		
		cSQL = cSQL + " WHERE RMA_Detail_ID = "+STR(nRMA_Detail)
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		ELSE
			lOK = SaveTo_SOitem_Status( cSOitem, "RMA "+ALLTRIM(STR(nRMA_No)), "Initiated RMA "+ALLTRIM(STR(nRMA_No))+" RMA_Detail "+ALLTRIM(STR(nRMA_Detail)), ThisForm.nConnHandle)
			MESSAGEBOX("SOitem '"+cSoItem+"' was saved for "+CHR(13)+"RMA_No "+ALLTRIM(STR(nRMA_No))+CHR(13)+"RMA_Detail "+ALLTRIM(STR(nRMA_Detail)),0,"Saved")
		ENDIF
		
		IF lOK 
			IF nRMA_Detail > 0 AND nPackingSlip > 0
				lOK = ThisForm.CreateRMA_Receive(nRMA_Detail,nPackingSlip)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE selecteditems
		PARAMETERS cSelectSOItem
		*ThisForm.SelectedItems(cSelectSOItem)
		
		PRIVATE i, i2, aSOItem2
		i = 0
		
		IF !EMPTY(cSelectSOItem)
			DO WHILE LEN(cSelectSOItem) > 0
				i=i+1
				DIMENSION aSOItem2(i)
				aSOItem2(i) = LEFT(cSelectSOItem,10)
				cSelectSOItem = RIGHT(cSelectSOItem , LEN(cSelectSOItem)-11)
			ENDDO
		ENDIF
		
		PRIVATE nCurrSOitem
		FOR i2 = 1 TO i
			IF ASCAN(aSOItems, aSOItem2(i2)) = 0 &&Not Found
				IF EMPTY(aSoItems(1))
					aSoItems(1) = aSOItem2(i2)
		
					ThisForm.lstSOitem.Refresh
				ELSE
					nLenaSoItems = ALEN(aSoItems,1)
		
					DIMENSION aSoItems(nLenaSoItems +1)
					aSoItems(nLenaSoItems +1) = aSOItem2(i2)
					
					ThisForm.lstSOitem.Refresh
				ENDIF
			ENDIF 	
		ENDFOR
		
		
		ThisForm.lstSOitem.NumberOfElements = ALEN(aSoItems)
		ThisForm.lstSOitem.Refresh
		
		DIMENSION gaReason(ALEN(aSoItems))
		
		IF USED("tmpQuotes")
			USE IN tmpQuotes
		ENDIF
		IF !EMPTY(aSoItems(1))
		
			IF EMPTY( ThisForm.txtCompany.Value )
				cSQL = "SELECT Company FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1) +"'"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpQuotes')
				ENDIF
				ThisForm.txtCompany.Value = tmpQuotes.Company
			ENDIF
			***
			IF EMPTY( ThisForm.txtContact.Value )
				cSQL = "SELECT Name FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisForm.txtContact.Value = tmpQuotes.Name
			ENDIF
			***
			IF EMPTY( ThisForm.txtEmail.Value )
				cSQL = "SELECT Email FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisForm.txtEmail.Value = tmpQuotes.Email
			ENDIF
			***
			IF EMPTY( ThisForm.txtPhone.Value )
				cSQL = "SELECT Phone FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisForm.txtPhone.Value = tmpQuotes.Phone 
			ENDIF
			IF EMPTY( ThisForm.txtFax.Value )
				cSQL = "SELECT Fax FROM dbo.AllQuotes WHERE SOitem = '"+ aSoItems(1)+"'"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQuotes')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQuotes")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpQuotes')
				ENDIF
				ThisForm.txtFax.Value = tmpQuotes.Fax 
			ENDIF
			
			IF EMPTY( ThisForm.txtNotified.Value )
				ThisForm.txtNotified.Value = DATE()
			ENDIF
			
			IF USED("tmpQuotes")
				USE IN tmpQuotes
			ENDIF
		ENDIF
		
	ENDPROC

