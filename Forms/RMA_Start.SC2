		ThisForm.txtItemSale.Visible = .T.
		ThisForm.lblRefunded.Visible = .T.
		ThisForm.txtRefunded.Visible = .T.
		ThisForm.lblSalesP.Visible = .T.
		ThisForm.txtSalesP.Visible = .T.
