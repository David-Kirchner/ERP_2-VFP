	PROCEDURE Init
		PARAMETERS pSOitem, pPOitem
		*DO FORM Forms\Select_WorkOrder WITH pSOitem, pPOitem TO nWO
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(pPOitem,'POitem',12)
		
		IF cSOitem = Proper_SO_Item('')
			SELECT tmpWorkOrders
			LOCATE FOR SOitem = cSOitem
			IF Proper_PO_Item(cPOitem) = Proper_PO_Item('')
				SELECT tmpWorkOrders
				LOCATE FOR SOitem = cSOitem AND POitem = cPOitem 
			ENDIF
		ELSE
			IF Proper_PO_Item(cPOitem) = Proper_PO_Item('')
				SELECT tmpWorkOrders
				LOCATE FOR POitem = cPOitem 
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.ConnHandle = get_SQLstringCONNECT()
		
		PRIVATE cSQL, nSQLEXEC
		
		IF USED("tmpWorkOrders")
			USE IN tmpWorkOrders
		ENDIF
		SELECT 0
		
		cSQL="SELECT * "
		cSQL=cSQL+" ,CAST(LEFT(ISNULL(SOitem,''),7) AS INT) AS SalesNum "
		cSQL=cSQL+" ,dbo.f_ItemDescription(sForm,sThck,sSz2,sSz3,sWeight,0) AS sDesc "
		cSQL=cSQL+" FROM dbo.WorkOrder WITH(NOLOCK) "
		cSQL=cSQL+" ORDER BY WO DESC"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpWorkOrders')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.ConnHandle, cSQL, 'tmpWorkOrders')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWorkOrders")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWorkOrders")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.ConnHandle, nSQLEXEC, 'tmpWorkOrders' )
		ENDIF
		
		IF USED('tmpWorkOrders')
			IF RECCOUNT('tmpWorkOrders') > 0
		
				SELECT tmpWorkOrders
				GO TOP
				IF RECCOUNT() > 8
					SKIP 8
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE refreshscreen
		*tmpWorkOrders.WO,EnterDate,StartDate,DueDate,FinishDate,Descript,InqNumP,SOitem,POitem
		
		*Thisform.txtSalesOrder.Refresh
		ThisForm.txtWO.Refresh
		ThisForm.txtEnterDate.Refresh
		ThisForm.txtStartDate.Refresh
		ThisForm.txtDueDate.Refresh
		ThisForm.txtFinishDate.Refresh
		ThisForm.txtsAlloy.Refresh
		
		ThisForm.txtDescS.Refresh
		ThisForm.txtDescript.Refresh
		Thisform.txtHeat.Refresh
		
		ThisForm.txtSOitem.Refresh
		ThisForm.txtPOitem.Refresh
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpWorkOrders')
			USE IN tmpWorkOrders
		ENDIF
		
		
		= SQLDISCONNECT( ThisForm.ConnHandle )
		
		RETURN THISFORM.nReturn
	ENDPROC

	PROCEDURE cmdAdd.Click
		*DO FORM Forms\workorder WITH tmpWorkOrders.WO
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.nReturn = 0
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdFind.Click
		PRIVATE nWO
		nWO = PrepareSQLnum(this.Parent.txtOrder.Value,'WO',-3)
		
		IF nWO > 0
			SELECT tmpWorkOrders
			
			LOCATE FOR WO = nWO 
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No WO")
				GO BOTTOM
			ENDIF
			ThisForm.grdWO.Refresh
			ThisForm.RefreshScreen()
		ELSE
			WAIT WINDOW "Enter WO to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSelect.Click
		*DO FORM Forms\workorder WITH tmpWorkOrders.WO
		PRIVATE nWO
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		ThisForm.nReturn = nWO
		
		ThisForm.Release
		
		
	ENDPROC

	PROCEDURE grdWO.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshScreen
	ENDPROC

	PROCEDURE lblPOitem.Click
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(tmpWorkOrders.POitem,'POitem',12)
		IF Proper_PO_item(cPOitem) <> Proper_PO_item('')
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_POitem(cPOitem,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE lblSOitem.Click
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(tmpWorkOrders.SOitem,'SOitem',10)
		IF Proper_SO_item(cSOitem) <> Proper_SO_item('')
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_SOitem(cSOitem,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE lblWO.Click
		PRIVATE nWO
		nWO = PrepareSQLnum(tmpWorkOrders.WO,'WO',-3)
		IF nWO > 0
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_WO(nWO,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
			
		ENDIF
	ENDPROC

	PROCEDURE txtOrder.Valid
		PRIVATE nWO
		nWO = PrepareSQLnum(this.Parent.txtOrder.Value,'WO',-3)
		
		IF nWO > 0
			SELECT tmpWorkOrders
			
			LOCATE FOR WO = nWO 
			IF !FOUND()
				MESSAGEBOX("Not Found!",0,"No SO")
				GO BOTTOM
			ENDIF
			ThisForm.RefreshScreen()
		ENDIF
	ENDPROC

