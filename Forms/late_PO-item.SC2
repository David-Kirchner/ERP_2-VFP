	PROCEDURE frmLatePO.cmdComplete.Click
		PRIVATE cPOitem, lComplete
		cPOitem = tmpPO.POItem
		lComplete = tmpPO.Cmplt
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE nMess
		
		IF NOT HavePermission('EditPOLate')
			*Allow is same SalesRep
			PRIVATE cSalesP,cSalesPlogin
			cSalesP = PrepareSQLtxt(ThisForm.txtSalesP.Value,'SalesP',1)
			cSalesPlogin = AppSetup_Login_SalesP()
			IF NOT cSalesP==cSalesPlogin
				MESSAGEBOX("Your Login does not match the SalesRep '"+cSalesP+"'"+CHR(13)+"You do not have Permision to change POitem '"+cPOitem +"'.",0,"Not Allowed.")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Your Login does not match the SalesRep '"+cSalesP+"'"+CHR(13)+"You do not have Permision to change POitem '"+cPOitem +"'.") 
				RETURN .F.
			ENDIF
		ENDIF
		
		IF lComplete
			nMess = MESSAGEBOX("This SOitem is already marked as Complete"+CHR(13)+"POitem '"+cPOitem+"'"+CHR(13)+"Do you need to mark as UNcomplete?",4+32,"UN MARK?")
		ELSE
			nMess = MESSAGEBOX("Are you sure you want to mark as Complete"+CHR(13)+"POitem '"+cPOitem+"'"+CHR(13)+CHR(13)+"Do you want to mark as complete?",4+32,"Complete?")
		ENDIF
		
		IF nMess <> 6
			RETURN .F.
		ENDIF
		
		IF NOT lComplete
			************************************
			*leave a history mark about cancelling poitem stock
			***********************
			PRIVATE cSQLi
		
		
			*Test for BrokerLst, add a process detail for the History
			IF USED('tmpCntBroker')
				USE IN tmpCntBroker
			ENDIF
			SELECT 0
		
			cSQL = "SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOitem+"'"
			cSQL = cSQL+" AND M.Heat = 'DUE IN'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCntBroker')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntBroker' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntBroker")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntBroker")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCntBroker' )
			ENDIF
		
			IF USED('tmpCntBroker')
				IF RECCOUNT('tmpCntBroker') > 0
					IF VARTYPE(tmpCntBroker.ID_Detail) ="N"
					
						SCAN
						*Add Reason to BrokerLst Process
						cSQLi = "INSERT INTO dbo.BrokerLst_Process (SOitem,PO_Item,SalesPerson"
						cSQLi = cSQLi + ",Comment,process_id,processor,ID_Detail,ReceivingID) VALUES ("
						*cSQLi = cSQLi + "'RECEIVED',"
						cSQLi = cSQLi + "''" &&SOitem
						cSQLi = cSQLi + ",'"+cPOItem+"'"
						cSQLi = cSQLi + ",' '"  &&SalesP
						cSQLi = cSQLi + ",'No Receiving. Marked Complete with Late PO screen.'"  &&Comment
						cSQLi = cSQLi + ",'CORRECTION'"   &&Process_ID
						cSQLi = cSQLi + ",'Late PO:PO Complete'"   &&Processor
						cSQLi = cSQLi + ","+ALLTRIM(STR(tmpCntBroker.ID_Detail))+"" &&ID_Detail
						cSQLi = cSQLi + ",0"  &&ReceivingID
						cSQLi = cSQLi + ")"
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi, ThisFormSet.nConnHandle, nSQLEXEC )
						ELSE
							*Now Remove Process
							cSQL = "DELETE FROM dbo.BrokerLst_Process "
							cSQL = cSQL+" WHERE ID_Detail="+STR(tmpCntBroker.ID_Detail)
							cSQL = cSQL+" AND Process_ID='CORRECTION'"
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							ENDIF
		
						ENDIF				
						ENDSCAN
					ENDIF
				ENDIF
				USE IN tmpCntBroker
			ENDIF
		
			***********************
			*Test for StockLst, add a process detail for the History trail
			IF USED('tmpCntStock')
				USE IN tmpCntStock
			ENDIF
			SELECT 0
		
		
			cSQL = "SELECT DISTINCT D.ID_Detail "
			cSQL = cSQL+" FROM dbo.StockLst_Master M WITH(NOLOCK) "
			cSQL = cSQL+"  LEFT OUTER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON D.ID = M.ID"
			cSQL = cSQL+"  WHERE M.PO_item ='"+cPOitem+"'"
			cSQL = cSQL+" AND M.Heat = 'DUE IN'"
			cSQL = cSQL+"  AND D.ID_Detail > 0 "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCntStock')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCntStock' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntStock")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpCntStock")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCntStock' )
			ENDIF
		
			IF USED('tmpCntStock')
				IF RECCOUNT('tmpCntStock') > 0
					IF VARTYPE(tmpCntStock.ID_Detail) ="N"
						SCAN
						*Add Reason Correction to StockLst Process
						cSQLi = "INSERT INTO dbo.StockLst_Process (SOitem,PO_Item,SalesPerson"
						cSQLi = cSQLi + ",Comment,Process_ID,Processor,QTY"
						cSQLi = cSQLi + ",ID_Detail,ReceivingID) VALUES ("
						*cSQLi = cSQLi + "'RECEIVED',"
						cSQLi = cSQLi + "''" &&SOitem
						cSQLi = cSQLi + ",'"+cPOItem+"'"
						cSQLi = cSQLi + ",' '"  &&SalesP
						cSQLi = cSQLi + ",'No Receiving. Marked Complete with Late PO screen.'"  &&Comment
						cSQLi = cSQLi + ",'CORRECTION'"   &&Process_ID
						cSQLi = cSQLi + ",'Late PO:PO Complete'"   &&Processor
						cSQLi = cSQLi + ",0" &&QTY
						cSQLi = cSQLi + ","+ALLTRIM(STR(tmpCntStock.ID_Detail))+"" &&ID_Detail
						cSQLi = cSQLi + ",0"  &&ReceivingID
						cSQLi = cSQLi + ")"
		
		
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLi )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQLi, ThisFormSet.nConnHandle, nSQLEXEC )
						ELSE
							*Now Remove Process
							cSQL = "DELETE FROM dbo.StockLst_Process "
							cSQL = cSQL+" WHERE ID_Detail="+STR(tmpCntStock.ID_Detail)
							cSQL = cSQL+" AND Process_ID='CORRECTION'"
							
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
							ENDIF
		
						ENDIF				
						ENDSCAN
						
					ENDIF
				ENDIF
				USE IN tmpCntStock
			ENDIF
		ENDIF
		
		************************************
		cSQL = "UPDATE PurchaseOrder "
		IF lComplete
			cSQL = cSQL+" SET Cmplt = 0 "
		ELSE
			cSQL = cSQL+" SET Cmplt = 1 "
			cSQL = cSQL+" ,Delivered = 1"
		ENDIF
		cSQL = cSQL+" WHERE POitem ='"+cPOitem+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		ELSE
			TrackMess(cSQL+" "+CHR(13)+SYS(16,1))
			*send an Email to receiving department about this.
			ThisFormSet.Send_Email_Receiving(cPOitem,lComplete )
			MESSAGEBOX("Mark complete is done.",0+64,"Success")
		ENDIF
		
		*ThisFormSet.Refresh_LatePO()
		ThisFormSet.Load_PO(cPOitem)
	ENDPROC

	PROCEDURE frmLatePO.cmdCustInfo.Click
		
		PRIVATE cComapny
		cCompany = PrepareSQLtxt(ThisForm.txtCompany.Value,"Company",30)
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = get_Report_Server()+[%2fCustomer%2fCustomer+Info&rs:Command=Render]+"&"+[customer=]+ALLTRIM(cCompany)
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		
		WAIT WINDOW "Look for a blinking Internet Explorer to read report!" NOWAIT
	ENDPROC

	PROCEDURE frmLatePO.cmdDeepTrack.Click
		
		PRIVATE cSearch
		cSearch = ALLTRIM(tmpPO.POItem)
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_Tracking_Mess(cSearch,.T.)
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		
		WAIT WINDOW "This report takes a long time."+CHR(13)+"Look for a blinking Internet Explorer to read report!" NOWAIT
	ENDPROC

	PROCEDURE frmLatePO.cmdFind.Click
		PRIVATE nPO
		nPO = PrepareSQLnum(ThisForm.txtPOrder.Value,'HPAPO',-3)
		
		IF nPO > 0
			
			ThisFormSet.Load_PO(nPO)
			*ThisFormSet.frmLatePO.grdLatePO.SetFocus()
			
		ELSE
			WAIT WINDOW "Enter PO Number to search." TIMEOUT 2
		ENDIF
		
	ENDPROC

	PROCEDURE frmLatePO.cmdQuit.Click
		ThisFormSet.Release
		
	ENDPROC

	PROCEDURE frmLatePO.cmdReportServer.Click
		
		PRIVATE m.loHyperlink,m.cHyperLink
		m.cHyperLink = get_Report_Server()+"%2FHPA%20Sales%20Reports%2FSales%20and%20Purchase%20Orders%20Late&rs%3AParameterLanguage=en-US"
		m.loHyperlink = CREATEOBJECT("Hyperlink")
		m.loHyperlink.navigateto(m.cHyperLink)
		RELEASE m.loHyperlink
		
		WAIT WINDOW "Look for a blinking Internet Explorer to read report!" NOWAIT
	ENDPROC

	PROCEDURE frmLatePO.cmdSendEmail.Click
		IF MESSAGEBOX("Do you want to send email from Outlook?",4+64,"Email")=6
		
			TRY	
				PRIVATE cPOitem,cSalesP,cCompany,cAlloy,cDesc,cSoldTo,cOrderDate,cDue_Min,cDue_Max,cReceived,cShipWhere
				cPOitem		= tmpPO.POItem
				cSalesP		= AppSetup_Get_SalesRep_SalesP(tmpPO.SalesP)
				cCompany	= tmpPO.Buy_From
				cAlloy		= tmpPO.Alloy
				cDesc		= tmpPO.Description
				cSoldTo		= tmpPO.Sold_To
				cOrderDate	= tmpPO.OrderDate
				cDue_Min	= tmpPO.Due_Min
				cDue_Max	= tmpPO.Due_Max
				cReceived	= tmpPO.Received
				cShipWhere	= tmpPO.ShipWhere
		
				#DEFINE olFolderInbox 6
				#DEFINE olFolderOutbox 4
				#DEFINE olMailItem 0
				#DEFINE olRecipient 4
				#DEFINE olRecipients 17
				#DEFINE IMPORTANCENORMAL 1
				loApp=CreateObject("Outlook.Application")
				loNamespace = loApp.GetNamespace("MAPI")
				loFolder = loNamespace.GetDefaultFolder(olFolderInbox)
				loEMailItem = loFolder.Items.Add(olMailItem)
				loEmailItem.Subject = "Purchase Order"+cPOitem
				loEmailItem.Importance = IMPORTANCENORMAL
				
				PRIVATE B
				B = [<html><font face = "Arial">]
				B=B+[<font size = 2> <font color = 0>Space Alloys USA PO item:]+ALLTRIM(cPOitem)+[</font><Br>]
				B=B+[Sales Person:]+cSalesP+[<Br>]
				B=B+[Company:]+cCompany+[<Br>]
				B=B+[Alloy:]+cAlloy+[ ]+cDesc+[<Br>]
				B=B+[Order Date:]+cOrderDate+[  DueMin:]+cDue_Min+[  DueMax:]+cDue_Max+[<Br>]
				B=B+[Received:]+cReceived+[<Br>]
				B=B+[</html>]
				
				loEmailItem.HTMLBody = B
		*		loEmailItem.Attachments.Add(cFileName)
		
				loEmailitem.Display()
				*loEmailItem.Send
				*loApp.Quit()
				release loApp, loEmailItem
				
				WAIT WINDOW "Click on the blinking Outlook window to address you Email" NOWAIT
			CATCH
				MESSAGEBOX("Could not start Outlook")
			ENDTRY
		
		ENDIF
	ENDPROC

	PROCEDURE frmLatePO.cmdShowPO.Click
		PRIVATE cPOitem
		cPOitem = tmpPO.POItem
		
		DO FORM Forms\ShowPO WITH cPOitem
		
	ENDPROC

	PROCEDURE frmLatePO.cmdShowSO.Click
		PRIVATE cSOitem
		cSOitem	= tmpPO.SOitem
		
		IF NOT EMPTY(cSOitem)
			DO FORM Forms\ShowvSOitem WITH cSOitem
		ENDIF
	ENDPROC

