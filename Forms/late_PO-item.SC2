	PROCEDURE Init
		PARAMETERS pPO
		*DO FOROM forms\late_po-item WITH HPAPO
		
		PRIVATE cPOitem, lUseParameter
		lUseParameter = .F.
		
		IF VARTYPE(pPO) = 'N'
			cPOitem = Proper_PO_Item(ALLTRIM(STR(pPO))+"-01")
			IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
				IF ThisFormSet.Load_PO(pPO)
					lUseParameter = .T.	
				ENDIF
			ENDIF
		
		ENDIF	
		
		IF VARTYPE(pPO) = 'C'
			cPOitem = pPO
			IF Proper_PO_Item(cPOitem) != Proper_PO_Item('')
				IF ThisFormSet.Load_PO(cPOitem)
					lUseParameter = .T.	
				ENDIF
			ENDIF
		ENDIF	
		
		IF NOT lUseParameter 
			ThisFormSet.Load_PO('')
		ENDIF
		
	ENDPROC

	PROCEDURE latepo_changed
		*ThisFormSet.LatePO_Changed()
		
		PRIVATE cPOitem, nHPAPO
		cPOitem = tmpPO.POItem
		nHPAPO	= tmpPO.HPApo
		
		ThisFormSet.frmLatePO.txtPOitem.Value = tmpPO.POItem
		ThisFormSet.frmLatePO.txtSalesP.Value = tmpPO.SalesP
		ThisFormSet.frmLatePO.txtVendor.Value = tmpPO.Company
		ThisFormSet.frmLatePO.txtAlloy.Value = tmpPO.Alloy
		ThisFormSet.frmLatePO.txtDescription.Value = tmpPO.Description
		
		ThisFormSet.frmLatePO.chkPOiCmplt.Value = tmpPO.Cmplt
		ThisFormSet.frmLatePO.chkPOiDeliv.Value = tmpPO.Delivered
		ThisFormSet.frmLatePO.chkPOiCanc.Value = tmpPO.Cancelled
		ThisFormSet.frmLatePO.chkPOiHold.Value = tmpPO.Hold
		
		
		PRIVATE cSQL, nSQLEXEC
		
		**********
		*HPAPO
		ThisFormSet.frmPO_No.Grid1.RecordSource = ''
		IF USED('tmpPO_No')
			USE IN tmpPO_No
		ENDIF
		
		SELECT 0
		cSQL = "SELECT [HPAPO],[EoPage],[PO_Rev],[Cancelled],[Reconciled]"
		cSQL = cSQL + ",[Rec_Date],[Rec_Who],[Changing],[Printed]"
		cSQL = cSQL + ",[SentUnAproved],[SentCondAprv],[Who],[When]"
		cSQL = cSQL + " FROM dbo.PO_No WITH(NOLOCK) WHERE HPAPO="+STR(nHPAPO)
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPO_No' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO_No' )
		ENDIF
		
		IF USED('tmpPO_No')	
			ThisFormSet.frmPO_No.Grid1.RecordSource = 'tmpPO_No'
			ThisFormSet.frmPO_No.Grid1.Visible = .T.
		
		ELSE
			ThisFormSet.frmPO_No.Grid1.Visible = .F.
		ENDIF
		
		
		**********
		ThisFormSet.frmStock.grdStockHistory.RecordSource = ''
		IF USED('StockHistory')
			USE IN StockHistory
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT LEFT([Who],20) AS [Who],[What],[When],[StkDate],'Stock ' AS STK,ID FROM dbo.Ar_Stocklst_Master_History WITH(NOLOCK) "
		cSQL = cSQL + " WHERE po_item = '"+cPOitem+"'"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + "SELECT LEFT([Who],20) AS [Who],[What],[When],[StkDate],'Broker' AS STK,ID FROM dbo.Ar_BrokerLst_Master_history WITH(NOLOCK) "
		cSQL = cSQL + " WHERE po_item = '"+cPOitem+"'"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + "SELECT LEFT([Who],20) AS [Who],[What],[When],[StkDate],'WIP   ' AS STK,ID FROM dbo.Ar_WIPLst_Master_History WITH(NOLOCK) "
		cSQL = cSQL + " WHERE po_item = '"+cPOitem+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'StockHistory')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'StockHistory' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockHistory")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "StockHistory")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'StockHistory' )
		ENDIF
		
		IF USED('StockHistory')	
			ThisFormSet.frmStock.grdStockHistory.RecordSource = 'StockHistory'
			ThisFormSet.frmStock.grdStockHistory.Visible = .T.
		
		ELSE
			ThisFormSet.frmStock.grdStockHistory.Visible = .F.
		ENDIF
		
		**********
		ThisFormSet.frmCurrStock.Grid1.RecordSource = ''
		
		IF USED('CurrStock')
			USE IN CurrStock
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT 'S' AS TBL,* FROM dbo.StockLst_Master WITH(NOLOCK) "
		cSQL = cSQL + " WHERE po_item = '"+cPOitem+"'"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + "SELECT 'B' AS TBL,* FROM dbo.BrokerLst_Master WITH(NOLOCK) "
		cSQL = cSQL + " WHERE po_item = '"+cPOitem+"'"
		cSQL = cSQL + " UNION "
		cSQL = cSQL + "SELECT 'W' AS TBL,* FROM dbo.WIPLst_Master WITH(NOLOCK) "
		cSQL = cSQL + " WHERE po_item = '"+cPOitem+"'"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CurrStock')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CurrStock' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CurrStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "CurrStock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
