				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales' )
		ENDIF
		
		IF USED('tmpSales')
			IF RECCOUNT('tmpSales') > 0
				ThisFormSet.frmLatePO.lblSales.Visible = .T.
				ThisFormSet.frmLatePO.txtSOitem.Visible = .T.
				ThisFormSet.frmLatePO.txtSoldTo.Visible = .T.
				ThisFormSet.frmLatePO.lblQtyShip.Visible = .T.
				ThisFormSet.frmLatePO.txtqShipped.Visible = .T.
				ThisFormSet.frmLatePO.ChkSalesCncld.Visible = .T.
				ThisFormSet.frmLatePO.chkSalesCmplt.Visible = .T.
				ThisFormSet.frmLatePO.txtHeat.Visible = .T.
				ThisFormSet.frmLatePO.txtPartNo.Visible = .T.
				
				ThisFormSet.frmLatePO.txtSOitem.Value	= tmpPO.SOitem
				ThisFormSet.frmLatePO.txtSoldTo.Value	= tmpPO.Sold_To
				
				ThisFormSet.frmLatePO.txtqShipped.Value	= tmpSales.qShipped
				ThisFormSet.frmLatePO.ChkSalesCncld.Value= tmpSales.cncld
				ThisFormSet.frmLatePO.chkSalesCmplt.Value= tmpSales.cmplt 
				ThisFormSet.frmLatePO.txtHeat.Value		= tmpSales.Heat
				ThisFormSet.frmLatePO.txtPartNo.Value	= tmpSales.PartNo
		
			USE IN tmpSales
			ENDIF
		ENDIF
		************************************************
		
		IF USED('tmpSales_No')
			USE IN tmpSales_No
		ENDIF
		SELECT 0
		
		cSQL = "SELECT cncld,cmplt,ShopRecv "
		cSQL = cSQL + " FROM dbo.Sales_No WITH(NOLOCK) "
		cSQL = cSQL + "  WHERE Salesnum ="+STR(nSalesNum)
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSales_No')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSales_No' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_No")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpSales_No")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSales_No' )
		ENDIF
			
		IF USED('tmpSales_No')
			IF RECCOUNT('tmpSales_No') > 0
				ThisFormSet.frmLatePO.lblSales_No.Visible = .T.
				ThisFormSet.frmLatePO.chkSales_NoCncld.Visible = .T.
				ThisFormSet.frmLatePO.chkSales_NoCmplt.Visible = .T.
				ThisFormSet.frmLatePO.chkSales_NoShopRecv.Visible = .T.
				
