	PROCEDURE frmLatePO.cmdCancelled.Click
		PRIVATE cPOitem,lCancelled
		cPOitem = tmpPO.POItem
		lCancelled = tmpPO.Cancelled
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE nMess
		
		IF NOT HavePermission('EditPOLate')
			*Allow if same SalesRep
			PRIVATE cSalesP,cSalesPlogin
			cSalesP = PrepareSQLtxt(ThisForm.txtSalesP.Value,'SalesP',1)
			cSalesPlogin = AppSetup_Login_SalesP()
			IF NOT cSalesP==cSalesPlogin
				MESSAGEBOX("Your Login does not match the SalesRep '"+cSalesP+"'"+CHR(13)+"You do not have Permision to change POitem '"+cPOitem +"'.",0,"Not Allowed.")
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Your Login does not match the SalesRep '"+cSalesP+"'"+CHR(13)+"You do not have Permision to Cancel POitem '"+cPOitem +"'.") 
				RETURN .F.
			ENDIF
		ENDIF
		
		PRIVATE lCancelPOi 
		IF lCancelled 
			nMess = MESSAGEBOX("This POitem is already marked as Cancelled"+CHR(13)+"POitem '"+cPOitem+"'"+CHR(13)+"Do you need to mark as UNcancel?",4+32,"UN CANCEL?")
			lCancelPOi = .F.
		ELSE
			nMess = MESSAGEBOX("Are you sure you want to mark as Cancelled"+CHR(13)+"POitem '"+cPOitem+"'"+CHR(13)+CHR(13)+"Do you want to mark as Cancelled?",4+32,"Cancel?")
			lCancelPOi = .T.	
		ENDIF
		
		IF nMess <> 6
			RETURN .F.
		ENDIF
		
		**************************
		*Cancel the POitem
		PRIVATE lSQLgood 
		lSQLgood = .T.
		*lSQLgood = PurchaseOrder_Allow_Cancel( cPOitem, ThisFormSet.nConnhandle )	&&Done with HavePermission('EditPOLate')
		IF lSQLgood 
			lSQLgood = PurchaseOrder_POitem_Cancel( cPOitem, ThisFormSet.nConnhandle, !lCancelPOi  ) &&cPOitem, pConnHandle, plUnCancel
			*			CALLS:PurchaseOrder_Allow_Cancel()
			*Calls: "UPDATE dbo.PurchaseOrder SET [Cancelled] 
			*Calls: DO FORM Forms\GetReason
			*Calls: TrackMess
			*Calls: PurchaseOrder_POitem_Remove_StockLst( cPOitem, nConn ) 
				**Check to see if exists in Receiving, if Received - do not Delete Stock!
				*Calls: Cancel_Detail_Process_POitem
					*Calls: Remove_ID_Detail_Process
				*Calls:Remove_Stock_listed_POitem
					*Calls:Remove_ID_Detail_Process
			*Remove from Allquotes
		ENDIF
		IF lSQLgood
			MESSAGEBOX("POitem '"+cPOitem+"' has been "+IIF(lCancelPOi,"Cancelled.","UnCancelled."),0+64,IIF(lCancelPOi,"Cancelled","UnCancelled"))
		ELSE
			MESSAGEBOX("POitem '"+cPOitem+"' Error."+CHR(13)+" not "+IIF(lCancelPOi,"Cancelled.","UnCancelled."),0+64,IIF(lCancelPOi,"Not Cancelled","Not UnCancelled"))
		ENDIF
		
		
		
		ThisFormSet.Load_PO(cPOitem)
		RETURN
		
		*!*	*******************
		*!*	IF NOT lCancelled 
		*!*		*********************************************************
		*!*		*leave a history mark about cancelling poitem stock
		*!*		***********************
