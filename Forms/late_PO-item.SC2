				ThisFormSet.frmLatePO.chkSales_NoCmplt.Value = tmpSales_No.cmplt
				ThisFormSet.frmLatePO.chkSales_NoShopRecv.Value = tmpSales_No.ShopRecv 
		
			USE IN tmpSales_No
			ENDIF
		ENDIF
		
		**********
		ThisFormSet.frmPO_Item_Notes.Grid1.RecordSource = ''
