	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE load_po
		PARAMETERS pPOitem
		*ThisFormSet.Load_PO()
		*REPLACED ThisFormSet.Refresh_LatePO()
		
		PRIVATE cPOitem, nPO
		IF VARTYPE(pPOitem) = "N"
			nPO = pPOitem
			cPOitem = PrepareSQLtxt(  ALLTRIM(STR(pPOitem))+"-01"  ,'POitem',12)
		ELSE
			nPO = Proper_PO_Item_PO(pPOitem)
			cPOitem = PrepareSQLtxt(pPOitem,'POitem',12)
		ENDIF
		
		PRIVATE lLate, lcmplt, lOnHold
		lLate = PrepareSQLlogic(ThisFormSet.frmLatePO.chkFLate.Value,'Late')
		lOnHold	= PrepareSQLlogic(ThisFormSet.frmLatePO.chkFOnHold.Value,'HOLD')
		lcmplt = PrepareSQLlogic(ThisFormSet.frmLatePO.chkFcmplt.Value,'CMPLT')
		
		*PRIVATE nRecNo
		*nRecNo = 0
		*IF USED('tmpPO')
		*	nRecNo = RECNO('tmpPO')
		*	USE IN tmpPO
		*ENDIF
		
		ThisFormSet.frmLatePO.grdLatePO.RecordSource = ''
		
		PRIVATE lReturn 
		lReturn = .T.
		
		PRIVATE cSQL, nSQLEXEC
		
		IF nPO > 0
			cSQL = "SELECT "
		ELSE
			IF lLate OR lOnHold OR lcmplt
				cSQL = "SELECT TOP 100 "
			ELSE
				cSQL = "SELECT TOP 10 "
			ENDIF
		ENDIF
		
		cSQL = cSQL + " P.POitem "
		cSQL = cSQL + ",P.SalesP,P.Company" && AS [Buy From]"
		cSQL = cSQL + ",P.Alloy"
		cSQL = cSQL + ",dbo.ItemDescription(P.Form,P.thck,P.Sz2,P.Sz3,P.RandLen) AS Description"
		cSQL = cSQL + ",CASE LEFT(P.SOitem,8) 	WHEN '      0-' THEN 'STOCK' 	ELSE P.SOitem END AS SOitem"
		cSQL = cSQL + ",(SELECT TOP 1 ISNULL(AQ.Company,'Na') FROM dbo.AllQuotes AQ WHERE SOitem = P.SOitem) AS [Sold_To]"
		cSQL = cSQL + ",CONVERT(CHAR(10),P.OrderDate,1) AS OrderDate"
		cSQL = cSQL + ",CONVERT(CHAR(10),P.Due_Min,1) AS Due_Min"
		cSQL = cSQL + ",CONVERT(CHAR(10),P.Due_Max,1) AS Due_Max"
		cSQL = cSQL + ",ISNULL(CASE P.Received"
		cSQL = cSQL + "	WHEN '1900-01-01 00:00:00.000' THEN ''"
		cSQL = cSQL + "	WHEN '1899-12-30 00:00:00.000' THEN ''"
		cSQL = cSQL + "	ELSE CONVERT(CHAR(10),P.Received,1) "
		cSQL = cSQL + " END,'') AS Received"
		cSQL = cSQL + ",dbo.[ShipWhereDescription](P.ShipWhere) AS ShipWhere"
		cSQL = cSQL + ",ISNULL(CONVERT(CHAR(10),P.HPA_Due_Min,1),'') AS HPA_Due_Min"
		cSQL = cSQL + ",(CASE WHEN P.HPA_Due_Max <= GETDATE() THEN '*'"
		cSQL = cSQL + "	ELSE ' ' END ) AS L"
		cSQL = cSQL + ",ISNULL(CONVERT(CHAR(10),P.HPA_Due_Max,1),'') AS HPA_Due_Max"
		cSQL = cSQL + ",P.HPAPO,P.Cmplt,P.Delivered,P.Cancelled,P.Hold "
		cSQL = cSQL + " FROM dbo.PurchaseOrder P "
		*cSQL = cSQL + " LEFT OUTER JOIN dbo.AllQuotes AQ ON P.SOitem = AQ.SOitem "
		IF nPO > 0
			cSQL=cSQL+" WHERE P.HPAPO = "+STR(nPO)
		ELSE
			IF NOT ( lLate OR lOnHold OR lcmplt )
				IF NOT cPOitem = PrepareSQLtxt('','POitem',12)
					cSQL=cSQL+" WHERE POitem ='"+cPOitem+"'"
				ENDIF
			ELSE
				cSQL=cSQL+" WHERE "
				
				IF lLate 
					cSQL=cSQL+" ( "
					cSQL = cSQL + " ISNULL(P.Cmplt,0) = 0"
					cSQL = cSQL + " AND ISNULL(P.Cancelled,0) = 0"
					cSQL = cSQL + " AND ISNULL(P.Services,0) = 0"
					cSQL = cSQL + " AND dbo.f_BestDate(P.HPA_Due_Min, dbo.f_BestDate(P.HPA_Due_Max, dbo.f_BestDate(P.Due_Min,P.Due_Max))) < GetDate()"
					cSQL=cSQL+" ) "
				ENDIF
				IF lOnHold 
					IF lLate 
						cSQL=cSQL+" AND ISNULL(P.Hold,0) = 1 "
					ELSE
						cSQL=cSQL+" ISNULL(P.Hold,0) = 1 "
					ENDIF
				ENDIF
				IF lcmplt
					IF lLate OR lOnHold 
						cSQL=cSQL+" AND ( ISNULL(P.Cancelled,0) = 1 AND ISNULL(P.Cmplt,0) = 1 ) "
					ELSE
						cSQL=cSQL+" ( ISNULL(P.Cancelled,0) = 1 AND ISNULL(P.Cmplt,0) = 1 )"
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*cSQL = cSQL + " ORDER BY POitem "
		cSQL = cSQL + " ORDER BY P.HPAPO DESC, P.ItemPO "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPO' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpPO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO' )
		ENDIF
		
		IF USED('tmpPO')
			IF RECCOUNT('tmpPO') > 0
				ThisFormSet.frmLatePO.grdLatePO.RecordSource = 'tmpPO'
				ThisFormSet.frmLatePO.grdLatePO.Visible = .T.
				
				*IF nRecNo > 0
				*	IF nRecNo < RECCOUNT('tmpPO')
				*		GOTO (nRecNo)
				*	ELSE
				*		GO BOTTOM
				*	ENDIF
				*ENDIF
				
				IF Proper_PO_Item(cPOitem) <> Proper_PO_Item('')
					SELECT tmpPO
					LOCATE FOR POitem = cPOitem
					IF NOT FOUND('tmpPO')
		
						PRIVATE lLate, lcmplt, lOnHold
						lLate = PrepareSQLlogic(ThisFormSet.frmLatePO.chkFLate.Value,'Late')
						lOnHold	= PrepareSQLlogic(ThisFormSet.frmLatePO.chkFOnHold.Value,'HOLD')
						lcmplt = PrepareSQLlogic(ThisFormSet.frmLatePO.chkFcmplt.Value,'CMPLT')
		
						PRIVATE cMess 
						cMess = "Did not find POitem '"+cPOitem+"' to show!"+CHR(13)
						cMess = cMess +"This will not be shown in the current records set."+CHR(13)
						IF lLate
							cMess = cMess +"FILTER is set to Late."+CHR(13)
						ENDIF
						IF lOnHold
							cMess = cMess +"FILTER is set to On Hold."+CHR(13)
						ENDIF
						IF lcmplt 
							cMess = cMess +"FILTER is set to Complete AND Cancelled."+CHR(13)
						ENDIF
						MESSAGEBOX(cMess,0,"No PO")
						
					ENDIF
				ENDIF
				
				*ThisFormSet.frmLatePO.grdLatePO.SetFocus()
				
				ThisFormSet.LatePO_Changed()
				
			ELSE
				ThisFormSet.frmLatePO.grdLatePO.Visible = .F.
				RETURN .F.
			ENDIF
		ELSE
			ThisFormSet.frmLatePO.grdLatePO.Visible = .F.
			RETURN .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE send_email_receiving
		PARAMETERS cPOitem, lComplete
		*ThisForm.Send_Email_Receiving 
		
		PRIVATE cMess
		cMess = "POitem '"+cPOitem+"' has been listed as Complete by "
		
		PRIVATE cMach_User, cUserName, cMach
		cMach_User = SYS(0)
		cUserName = ALLTRIM(  RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )  )
		
		cMess = cMess + ALLTRIM(cUserName)+". <br />"
		cMess = cMess + "The Receiving department did not list item as complete! <br />"
		cMess = cMess +"PO Data:"
		cMess = cMess +"<br />"+ HTML_POitem(cPOitem,.F.)+"<br />"
		cMess = cMess +"Receiving Data:"
		cMess = cMess +"<br />"+ HTML_Receiving_POitem(cPOitem,.F.)+"<br />"
		
		lOK = Send_HTML_Email("Receiving@SpaceAlloysUSA.com", "DoNotReply@SpaceAlloysUSA.com", "POitem '"+cPOitem+"' has been listed as Complete", cMess, ThisFormSet.nConnHandle, .T., .F.)
	ENDPROC

	PROCEDURE Unload
		
		IF USED('tmpPO')
			USE IN tmpPO
		ENDIF
		
		IF USED('tmpPO_No')
			USE IN tmpPO_No
		ENDIF
		
		IF USED('StockHistory')
			USE IN StockHistory
		ENDIF
		
		IF USED('tmpSales')
			USE IN tmpSales
		ENDIF
		
		IF USED('tmpSales_No')
			USE IN tmpSales_No
		ENDIF
		
		IF USED('tmpPO_Item_Notes')
			USE IN tmpPO_Item_Notes
		ENDIF
		
		IF USED('tmpPO_Receiving')
			USE IN tmpPO_Receiving
		ENDIF
		
		
		
		= SQLDISCONNECT(ThisFormSet.nConnHandle)
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmCurrStock.Resize
		*		71					75
		This.Grid1.Height = This.Height-4
			*		947				951
		This.Grid1.Width = This.Width - 4
	ENDPROC

