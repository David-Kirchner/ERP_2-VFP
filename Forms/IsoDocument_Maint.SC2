DEFINE CLASS frmisodocument_maint AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*< OBJECTDATA: ObjPath="lblHint" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmReportKey.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmReportKey.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmIsoCode.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmIsoCode.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmIsoCodeRev.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmIsoCodeRev.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmTitle.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmTitle.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmActive.Header1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmActive.Text1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdIso.clmActive.chkActive" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAdd" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdDelete" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdReload" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSave" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdClose" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		Caption = "ISO Document Numbers (Report FM / REV)"
		DoCreate = .T.
		Height = 480
		Icon = ICO\earth-globe.ico
		Name = "frmIsoDocument_Maint"
		nconnhandle = 0
		Width = 820
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdAdd' AS commandbutton WITH ;
		Caption = "Add row", ;
		Height = 27, ;
		Left = 12, ;
		Name = "cmdAdd", ;
		Top = 430, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdClose' AS commandbutton WITH ;
		Cancel = .T., ;
		Caption = "Close", ;
		Height = 27, ;
		Left = 710, ;
		Name = "cmdClose", ;
		Top = 430, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdDelete' AS commandbutton WITH ;
		Caption = "Delete", ;
		Height = 27, ;
		Left = 104, ;
		Name = "cmdDelete", ;
		Top = 430, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdReload' AS commandbutton WITH ;
		Caption = "Reload", ;
		Height = 27, ;
		Left = 200, ;
		Name = "cmdReload", ;
		Top = 430, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSave' AS commandbutton WITH ;
		Caption = "Save", ;
		Height = 27, ;
		Left = 520, ;
		Name = "cmdSave", ;
		Top = 430, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'grdIso' AS grid WITH ;
		ColumnCount = 5, ;
		DeleteMark = .F., ;
		Height = 370, ;
		Left = 12, ;
		Name = "grdIso", ;
		RecordMark = .F., ;
		RecordSource = "", ;
		ScrollBars = 3, ;
		Top = 48, ;
		Width = 792, ;
		Column1.ControlSource = "", ;
		Column1.Name = "clmReportKey", ;
		Column1.ReadOnly = .F., ;
		Column1.Width = 170, ;
		Column2.ControlSource = "", ;
		Column2.Name = "clmIsoCode", ;
		Column2.ReadOnly = .F., ;
		Column2.Width = 130, ;
		Column3.ControlSource = "", ;
		Column3.Name = "clmIsoCodeRev", ;
		Column3.ReadOnly = .F., ;
		Column3.Width = 50, ;
		Column4.ControlSource = "", ;
		Column4.Name = "clmTitle", ;
		Column4.ReadOnly = .F., ;
		Column4.Width = 300, ;
		Column5.ControlSource = "", ;
		Column5.CurrentControl = "chkActive", ;
		Column5.Name = "clmActive", ;
		Column5.ReadOnly = .F., ;
		Column5.Sparse = .F., ;
		Column5.Width = 60
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'grdIso.clmActive.chkActive' AS checkbox WITH ;
		Alignment = 0, ;
		Caption = "", ;
		Name = "chkActive", ;
		ReadOnly = .F.
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'grdIso.clmActive.Header1' AS header WITH ;
		Caption = "Active", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdIso.clmActive.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1", ;
		ReadOnly = .T., ;
		Visible = .F.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdIso.clmIsoCode.Header1' AS header WITH ;
		Caption = "ISO Code", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdIso.clmIsoCode.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdIso.clmIsoCodeRev.Header1' AS header WITH ;
		Caption = "Rev", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdIso.clmIsoCodeRev.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdIso.clmReportKey.Header1' AS header WITH ;
		Caption = "Report Key (FRX stem)", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdIso.clmReportKey.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'grdIso.clmTitle.Header1' AS header WITH ;
		Caption = "Title / notes", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'grdIso.clmTitle.Text1' AS textbox WITH ;
		BorderStyle = 0, ;
		Name = "Text1"
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'lblHint' AS label WITH ;
		Autosize = .F., ;
		Caption = "ISO Code = FM number only (FM-74-04-01). Rev = letter only (B). Print uses CompanyReport_IsoDoc() -> ""FM-74-04-01 REV.B""", ;
		Height = 32, ;
		Left = 12, ;
		Name = "lblHint", ;
		Top = 10, ;
		Width = 792
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE ConfigureGrid
		WITH This.grdIso
			.clmReportKey.ControlSource = "csrIso.reportkey"
			.clmIsoCode.ControlSource = "csrIso.isocode"
			.clmIsoCodeRev.ControlSource = "csrIso.isocoderev"
			.clmTitle.ControlSource = "csrIso.title"
			WITH .clmActive
				.ControlSource = "active"
				.Sparse = .F.
				.ReadOnly = .F.
				.CurrentControl = "chkActive"
				.Text1.Visible = .F.
				.chkActive.Caption = ""
			ENDWITH
		ENDWITH
	ENDPROC

	PROCEDURE Destroy
		IF USED("csrIso")
			USE IN csrIso
		ENDIF
		IF VARTYPE(ERP_Menu) = "O"
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE EnsureCursor
		IF USED("csrIso")
			USE IN csrIso
		ENDIF
		CREATE CURSOR csrIso (isodocid I, reportkey C(80), isocode C(80), isocoderev C(10), title C(200), active L, dirty L)
	ENDPROC

	PROCEDURE Init
		This.EnsureCursor()
		This.nConnHandle = get_SQLSTRINGCONNECT()
		IF This.nConnHandle < 1
			MESSAGEBOX("Could not connect to SQL.", 16, "ISO Documents")
			RETURN .F.
		ENDIF
		This.LoadRows()
		This.grdIso.RecordSource = "csrIso"
		This.ConfigureGrid()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO PROGS\proc_setup ADDITIVE
		ENDIF
		SET PROCEDURE TO PROGS\IsoDocument_maint ADDITIVE
		This.EnsureCursor()
	ENDPROC

	PROCEDURE LoadRows
		LOCAL lcSQL, lnRet
		This.EnsureCursor()
		SELECT csrIso
		ZAP
		lcSQL = "SELECT IsoDocId, ReportKey, IsoCode, ISNULL(IsoCodeRev,'') AS IsoCodeRev, "
		lcSQL = lcSQL + "ISNULL(Title,'') AS Title, Active "
		lcSQL = lcSQL + "FROM dbo.IsoDocument WITH (NOLOCK) "
		lcSQL = lcSQL + "ORDER BY SortOrder, ReportKey"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpIso")
		IF lnRet < 1
			MESSAGEBOX("Could not load dbo.IsoDocument."+CHR(13)+ ;
				"Run MEM\SQL\Config\16_IsoDocument.sql if the table is missing.", 48, "ISO Documents")
			RETURN
		ENDIF
		SELECT tmpIso
		SCAN
			INSERT INTO csrIso (isodocid, reportkey, isocode, isocoderev, title, active, dirty) ;
				VALUES (tmpIso.IsoDocId, ALLTRIM(tmpIso.ReportKey), ALLTRIM(tmpIso.IsoCode), ;
					ALLTRIM(tmpIso.IsoCodeRev), ALLTRIM(tmpIso.Title), tmpIso.Active, .F.)
		ENDSCAN
		USE IN tmpIso
		SELECT csrIso
		GO TOP
	ENDPROC

	PROCEDURE SqlOk
		LPARAMETERS tnRet, tcSQL
		IF tnRet >= 0
			RETURN .T.
		ENDIF
		MESSAGEBOX("SQL error."+CHR(13)+LEFT(EVL(tcSQL,""),200), 16, "ISO Documents")
		RETURN .F.
	ENDPROC

	PROCEDURE cmdAdd.Click
		SELECT csrIso
		APPEND BLANK
		REPLACE active WITH .T., dirty WITH .T., reportkey WITH "NewReport", ;
			isocode WITH "FM-??-??", isocoderev WITH "A"
		This.grdIso.SetFocus()
	ENDPROC

	PROCEDURE cmdClose.Click
		ThisForm.Release()
	ENDPROC

	PROCEDURE cmdDelete.Click
		LOCAL lnId, lcSQL, lnRet
		IF NOT USED("csrIso") OR EOF("csrIso")
			RETURN
		ENDIF
		IF MESSAGEBOX("Delete selected ISO row from SQL?", 4+32, "ISO Documents") # 6
			RETURN
		ENDIF
		lnId = csrIso.isodocid
		IF lnId > 0
			lcSQL = "DELETE FROM dbo.IsoDocument WHERE IsoDocId = " + ALLTRIM(STR(lnId))
			lnRet = SQLEXEC(This.nConnHandle, lcSQL)
			IF NOT This.SqlOk(lnRet, lcSQL)
				RETURN
			ENDIF
		ENDIF
		SELECT csrIso
		DELETE
		PACK
		GO TOP
	ENDPROC

	PROCEDURE cmdReload.Click
		This.LoadRows()
		This.ConfigureGrid()
		IF TYPE("CompanyReport_ReloadIsoDocs()") # "U"
			= CompanyReport_ReloadIsoDocs()
		ENDIF
	ENDPROC

	PROCEDURE cmdSave.Click
		LOCAL lcSQL, lnRet, lcKey, lcCode, lcRev, lcTitle, lnId, llAct
		IF NOT USED("csrIso")
			RETURN
		ENDIF
		SELECT csrIso
		GO TOP
		SCAN
			lcKey = ALLTRIM(csrIso.reportkey)
			lcCode = ALLTRIM(csrIso.isocode)
			lcRev = UPPER(ALLTRIM(csrIso.isocoderev))
			lcTitle = ALLTRIM(csrIso.title)
			llAct = csrIso.active
			lnId = csrIso.isodocid
			IF EMPTY(lcKey) OR EMPTY(lcCode)
				LOOP
			ENDIF
			* Keep IsoCode free of embedded REV text
			IF ATC(" REV.", UPPER(lcCode)) > 0
				IF EMPTY(lcRev)
					lcRev = ALLTRIM(SUBSTR(lcCode, ATC(" REV.", UPPER(lcCode)) + 5))
				ENDIF
				lcCode = ALLTRIM(LEFT(lcCode, ATC(" REV.", UPPER(lcCode)) - 1))
			ENDIF
			IF lnId > 0
				lcSQL = "UPDATE dbo.IsoDocument SET ReportKey = " + IsoDocument_SQLQuote(lcKey)
				lcSQL = lcSQL + ", IsoCode = " + IsoDocument_SQLQuote(lcCode)
				lcSQL = lcSQL + ", IsoCodeRev = " + IsoDocument_SQLQuote(lcRev)
				lcSQL = lcSQL + ", Title = " + IsoDocument_SQLQuote(lcTitle)
				lcSQL = lcSQL + ", Active = " + IIF(llAct, "1", "0")
				lcSQL = lcSQL + ", ModifiedDate = SYSUTCDATETIME() "
				lcSQL = lcSQL + "WHERE IsoDocId = " + ALLTRIM(STR(lnId))
			ELSE
				lcSQL = "IF EXISTS (SELECT 1 FROM dbo.IsoDocument WHERE ReportKey = " + IsoDocument_SQLQuote(lcKey) + ") "
				lcSQL = lcSQL + "UPDATE dbo.IsoDocument SET IsoCode = " + IsoDocument_SQLQuote(lcCode)
				lcSQL = lcSQL + ", IsoCodeRev = " + IsoDocument_SQLQuote(lcRev)
				lcSQL = lcSQL + ", Title = " + IsoDocument_SQLQuote(lcTitle)
				lcSQL = lcSQL + ", Active = " + IIF(llAct, "1", "0")
				lcSQL = lcSQL + ", ModifiedDate = SYSUTCDATETIME() "
				lcSQL = lcSQL + "WHERE ReportKey = " + IsoDocument_SQLQuote(lcKey) + " "
				lcSQL = lcSQL + "ELSE INSERT INTO dbo.IsoDocument (ReportKey, IsoCode, IsoCodeRev, Title, Active, ModifiedDate) VALUES ("
				lcSQL = lcSQL + IsoDocument_SQLQuote(lcKey) + ", " + IsoDocument_SQLQuote(lcCode) + ", "
				lcSQL = lcSQL + IsoDocument_SQLQuote(lcRev) + ", " + IsoDocument_SQLQuote(lcTitle) + ", "
				lcSQL = lcSQL + IIF(llAct, "1", "0") + ", SYSUTCDATETIME())"
			ENDIF
			lnRet = SQLEXEC(This.nConnHandle, lcSQL)
			IF NOT This.SqlOk(lnRet, lcSQL)
				RETURN
			ENDIF
			REPLACE dirty WITH .F.
		ENDSCAN
		This.LoadRows()
		This.ConfigureGrid()
		IF TYPE("CompanyReport_ReloadIsoDocs()") # "U"
			= CompanyReport_ReloadIsoDocs()
		ENDIF
		MESSAGEBOX("ISO documents saved.", 64, "ISO Documents")
	ENDPROC

ENDDEFINE
