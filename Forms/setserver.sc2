		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'txtWindfall1' AS textbox WITH ;
		Height = 23, ;
		Left = 7, ;
		Name = "txtWindfall1", ;
		Top = 79, ;
		Width = 130
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		************************
		*Where Am I
		************************
		*!*	PRIVATE oAdapters, oWMI
		*!*	PRIVATE lInWindfall,lInTipton
		*!*	lInWindfall = .F.
		*!*	lInTipton	= .F.
		
		*!*	oWMI = getobject("winmgmts:")
		*!*	oAdapters = oWMI.ExecQuery("Select * from Win32_NetworkAdapterConfiguration where IPEnabled=True")
		
		*!*	FOR EACH oAdapter in oAdapters
		*!*		IF NOT isnull(oAdapter.ipaddress)
		*!*			FOR EACH cAddress in oAdapter.ipaddress
		*!*				IF "192.168.1." $ cAddress
		*!*					lInWindfall= .T.
		*!*					ThisForm.lblWhereAmI.Caption = "in WINDFALL"
		*!*				ENDIF
		*!*				IF "192.168.2." $ cAddress
		*!*					lInTipton = .T.
		*!*					ThisForm.lblWhereAmI.Caption = "in TIPTON"
		*!*				ENDIF
		*!*			NEXT 
		*!*		ENDIF 
		*!*	NEXT 
		
		*!*	RELEASE oAdapters 
		*!*	RELEASE oWMI
		
		*!*	*****************
		*!*	*Force lInWindfall= .T. for now
		*!*	lInWindfall= .T.
		*!*	lInTipton = .F.
		*******************
		
		*********************
		* Read XML
		*********************
		PRIVATE ccWindfallServer, cTiptonServer, cBackupServer
		PRIVATE lFoundWindfall, lFoundTipton
		lFoundWindfall	= .F.
		lFoundTipton	= .F.
		
		IF USED('SQLdata')
			USE IN SQLdata
		ENDIF
		
		SET DEFAULT TO (SYS(5)+SYS(2003))
		IF FILE(SYS(5)+SYS(2003) +"\MEM\SQLdata.xml")
			*READ file
			XMLTOCURSOR( SYS(5)+SYS(2003)+"\MEM\SQLdata.xml", 'SQLdata', 512)
			
			IF USED('SQLdata')
				IF VARTYPE( SQLdata.WindfallServer ) = "C"
					cWindfallServer = RTRIM(SQLdata.WindfallServer)
					lFoundWindfall = .T.
					ThisForm.txtWindfall1.Value = cWindfallServer 
				ENDIF
				IF VARTYPE( SQLdata.TiptonServer ) = "C"
					cTiptonServer = RTRIM(SQLdata.TiptonServer)
					ThisForm.txtTipton1.Value = cTiptonServer 
				ENDIF
				TRY
					IF VARTYPE( SQLdata.BackupServer ) = "C"
						cBackupServer = RTRIM(SQLdata.BackupServer)
						ThisForm.txtBackupServer1.Value = cBackupServer
					ENDIF
				CATCH
					ThisForm.txtBackupServer1.Value = ''
				ENDTRY
				
				USE IN SQLdata
			ENDIF
		ENDIF
		
		
		*!*	IF FILE( "\\Windfall.HPA.local\SQL\HPAdata.xml" )
		*!*		*READ file
		*!*		XMLTOCURSOR( "\\Windfall.HPA.local\SQL\HPAdata.xml", 'HPAdata', 512)
		*!*		
		*!*		IF USED('HPAdata')
		*!*			IF VARTYPE( HPAdata.WindfallServer ) = "C"
		*!*				cWindfallServer = RTRIM(HPAdata.WindfallServer)
		*!*				lFoundWindfall = .T.
		*!*				ThisForm.txtWindfall1.Value = cWindfallServer 
		*!*			ENDIF
		*!*			IF VARTYPE( HPAdata.TiptonServer ) = "C"
		*!*				cTiptonServer = RTRIM(HPAdata.TiptonServer)
		*!*				ThisForm.txtTipton1.Value = cTiptonServer 
		*!*			ENDIF
		*!*			TRY
		*!*				IF VARTYPE( HPAdata.BackupServer ) = "C"
		*!*					cBackupServer = RTRIM(HPAdata.BackupServer)
		*!*					ThisForm.txtBackupServer1.Value = cBackupServer
		*!*				ENDIF
		*!*			CATCH
		*!*				ThisForm.txtBackupServer1.Value = ''
		*!*			ENDTRY
		*!*			
		*!*			USE IN HPAdata
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	IF FILE( "\\PEREGRINE\HPAapp\HPAdata.xml" )
		*!*		*READ file
		*!*		XMLTOCURSOR( "\\PEREGRINE\HPAapp\HPAdata.xml", 'HPAdata', 512)
		*!*		
		*!*		IF USED('HPAdata')
		*!*			IF VARTYPE( HPAdata.WindfallServer ) = "C"
		*!*				cWindfallServer = RTRIM(HPAdata.WindfallServer)
		*!*				lFoundWindfall = .T.
		*!*				ThisForm.txtWindfall1.Value = cWindfallServer 
		*!*			ENDIF
		*!*			IF VARTYPE( HPAdata.TiptonServer ) = "C"
		*!*				cTiptonServer = RTRIM(HPAdata.TiptonServer)
		*!*				ThisForm.txtTipton1.Value = cTiptonServer 
		*!*			ENDIF
		*!*			
		*!*			USE IN HPAdata
		*!*		ENDIF
		*!*	ENDIF
		*!*		
		
		
		IF lInWindfall
			*Try to use the Windfall Server
			IF lFoundWindfall
				ThisForm.txtWindfall1.BackColor = RGB(255,255,128)
				ThisForm.cServer = ThisForm.txtWindfall1.Value
			ELSE
				ThisForm.txtBackupServer1.BackColor = RGB(255,255,128)
				ThisForm.cServer = ThisForm.txtBackupServer1.Value
			ENDIF
		ENDIF
		IF lInTipton
			*Try to use the Tipton Server
			IF lFoundTipton
				ThisForm.txtTipton1.BackColor = RGB(255,255,128)
				ThisForm.cServer = ThisForm.txtTipton1.Value
			ELSE
				ThisForm.txtBackupServer1.BackColor = RGB(255,255,128)
				ThisForm.cServer = ThisForm.txtBackupServer1.Value
			ENDIF
		ENDIF
		*******
		ThisForm.lblGlobalServer.Caption = ''
		IF VARTYPE(gGlobalServer) = "C"
			IF NOT EMPTY(gGlobalServer)
				ThisForm.lblGlobalServer.Caption = gGlobalServer
			ENDIF
		ENDIF
		
		************
		*PRIVATE cMach_User, cUserName 
		*cMach_User = SYS(0)
		*cUserName = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		*IF cUserName = "David Kirchner" OR cUserName = "Sean Lykins" OR cUserName = "Administrator"
		IF AllowAdmin()
			ThisForm.cmdWrite1.Visible = .T.
			
			ThisForm.lblTable.Visible = .T.
			ThisForm.txtTable.Visible = .T.
			ThisForm.cmdSetTable.Visible = .T.
			ThisForm.cmdTest.Visible = .T.
		ENDIF	
		
		************
		
		ThisForm.txtTable.Value = IIF(VARTYPE(gGlobalDatabase)="C", gGlobalDatabase, "ERP_1")
		
		IF FILE(SYS(5)+SYS(2003)+"PROGS\load_ERP_Environment.prg")
			SET PROCEDURE TO PROGS\load_ERP_Environment ADDITIVE
		ENDIF
		IF FILE(SYS(5)+SYS(2003)+"PROGS\ERP_Environment_UI.prg")
			SET PROCEDURE TO PROGS\ERP_Environment_UI ADDITIVE
			DO ERP_Environment_UI WITH "InitSetServer", THISFORM
		ENDIF
		
	ENDPROC

	PROCEDURE cmdTest.Click
		IF FILE(SYS(5)+SYS(2003)+"PROGS\ERP_Environment_UI.prg")
			SET PROCEDURE TO PROGS\ERP_Environment_UI ADDITIVE
			DO ERP_Environment_UI WITH "TestConnection"
		ELSE
			test_ERP_SQL_Connection(ALLTRIM(ThisForm.txt1.Value), ALLTRIM(ThisForm.txtTable.Value))
		ENDIF
	ENDPROC

	PROCEDURE cmd4.Click
		LOCAL lcProf
		lcProf = ERP_ShowProfilePicker()
		IF !EMPTY(lcProf)
			save_ERP_ActiveProfile(lcProf)
			DO ERP_Environment_UI WITH "InitSetServer", THISFORM
		ELSE
			IF VARTYPE(gGlobalServer) = "U"
				PUBLIC gGlobalServer
			ENDIF
			gGlobalServer = ALLTRIM(ThisForm.txt1.Value)
			ThisForm.lblGlobalServer.Caption = gGlobalServer
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdSetBackupServer.Click
		IF VARTYPE(gGlobalServer) = "U"
			PUBLIC gGlobalServer
		ENDIF
		gGlobalServer = ALLTRIM(ThisForm.txtBackupServer1.Value)
		ThisForm.lblGlobalServer.Caption = gGlobalServer
		
		*IF VARTYPE(gDefaultSQLserver)="C"
		*	*This is set in get_SQLSTRINGCONNECT and get_SQL_ServerName 
		*	IF gGlobalServer != gDefaultSQLserver 
		*		gDefaultSQLserver = gGlobalServer 
		*	ENDIF
		*ENDIF
	ENDPROC

	PROCEDURE cmdSetTable.Click
		IF VARTYPE(GlobalTable) = "U"
			PUBLIC GlobalTable
			GlobalTable		= ""
		ENDIF
		GlobalTable	= ALLTRIM(ThisForm.txtTable.Value)
	ENDPROC

	PROCEDURE cmdSetTipton1.Click
		IF VARTYPE(gGlobalServer) = "U"
			PUBLIC gGlobalServer
		ENDIF
		gGlobalServer = ALLTRIM(ThisForm.txtTipton1.Value)
		ThisForm.lblGlobalServer.Caption = gGlobalServer
		
		
		*IF VARTYPE(gDefaultSQLserver)="C"
		*	*This is set in get_SQLSTRINGCONNECT and get_SQL_ServerName 
		*	IF gGlobalServer != gDefaultSQLserver 
		*		gDefaultSQLserver = gGlobalServer 
		*	ENDIF
		*ENDIF
	ENDPROC

	PROCEDURE cmdSetWindfall1.Click
		IF VARTYPE(gGlobalServer) = "U"
			PUBLIC gGlobalServer
		ENDIF
		gGlobalServer = ALLTRIM(ThisForm.txtWindfall1.Value)
		ThisForm.lblGlobalServer.Caption = gGlobalServer
		
		
		*IF VARTYPE(gDefaultSQLserver)="C"
		*	*This is set in get_SQLSTRINGCONNECT and get_SQL_ServerName 
		*	IF gGlobalServer != gDefaultSQLserver 
		*		gDefaultSQLserver = gGlobalServer 
		*	ENDIF
		*ENDIF
	ENDPROC

	PROCEDURE cmdTest.Click
		PRIVATE cServer
		cServer = ""
		IF VARTYPE(gGlobalServer) = "C"
			IF NOT EMPTY(gGlobalServer)
				cServer = gGlobalServer
			ENDIF
		ENDIF
		
		IF EMPTY(cServer)
			cServer = ThisForm.cServer 
		ENDIF
		
		***
		PRIVATE cDatabaseTable
		cDatabaseTable = ThisForm.txtTable.Value
		*
		
		
		WAIT WINDOW "Testing Server:"+cServer+" Table:"+cDatabaseTable NOWAIT
		PRIVATE nReturn
		nReturn = SQLStringConnect("Driver={SQL Server};Server="+cServer+";Database="+cDatabaseTable+";Trusted_Connection=yes;",.T.)
		
		IF nReturn < 1
			MESSAGEBOX("Could not talk to server."+CHR(13)+"",0+16,"Server Error",100000)
		ELSE
			MESSAGEBOX("Server:"+ALLTRIM(cServer)+CHR(13)+"Table:"+cDatabaseTable+CHR(13)+"Connected!",0+64,"SQL Connetion!")
			SQLDISCONNECT( nReturn )
		ENDIF
	ENDPROC

	PROCEDURE cmdWrite1.Click
		IF FILE( "\\Windfall.HPA.local\SQL\HPAdata.xml" )
			DELETE FILE "\\Windfall.HPA.local\SQL\HPAdata.xml"
		ENDIF
		
		
		IF DIRECTORY( "\\Windfall.HPA.local\SQL\")
			*Create file
			CREATE CURSOR HPAdata (WindfallServer C(20), TiptonServer C(20), BackupServer C(20) )
			
			PRIVATE cWindfall1, cTipton1, cBackupServer
			cWindfall1 = ALLTRIM(ThisForm.txtWindfall1.Value)
			cTipton1 = ALLTRIM(ThisForm.txtTipton1.Value)
			cBackupServer = ALLTRIM(ThisForm.TxtBackupServer1.Value)
			INSERT INTO HPAdata (WindfallServer,TiptonServer,BackupServer) VALUES ( cWindfall1, cTipton1, cBackupServer )
					
			PRIVATE nBytes 
			nBytes = 0
			nBytes = CURSORTOXML( 'HPAdata', "\\Windfall.HPA.local\SQL\HPAdata.xml", 1, 512, 0, "1" )
			IF VARTYPE( nBytes ) = 'N'
				MESSAGEBOX( "Saved \\Windfall.HPA.local\SQL\HPAdata.xml"+CHR(13)+STR(nBytes)+" bytes written.",0+64,"Saved")
			ENDIF
			
			USE IN HPAdata
		ENDIF
	ENDPROC

ENDDEFINE
