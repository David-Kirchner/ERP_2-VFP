		*!*								"The Packing Slip database will be updated with this new address.",0+48,"")
		
		*!*								Update_ShipCodeinPackingSlip_No( nUseShipCode, ThisForm.SalesNum, ThisForm.nConnHandle )
		
		*!*							ENDIF
		*!*						ENDIF		
							******************
							IF lOK
								ThisForm.LastEdit.VALUE = DATE()
								ThisForm.LastEdit.REFRESH
							ENDIF
						ENDIF
						WAIT CLEAR
					ENDIF
				ELSE   &&IF nSaveNew = 6 && Yes
					*Save - not as new!
					*REPLACE DATA
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.ShipAddr SET "
					cSQLu= cSQLu+" Company='"+lcCompany+"'"
					cSQLu= cSQLu+",Addr1='"+lcAddr1+"'"
					cSQLu= cSQLu+",Addr2='"+lcAddr2+"'"
					cSQLu= cSQLu+",City='"+lcCity+"'"
					cSQLu= cSQLu+",ST='"+lcST+"'"
					cSQLu= cSQLu+",Zip='"+lcZip+"'"
					cSQLu= cSQLu+",Country='"+lcCountry+"'"
					cSQLu= cSQLu+",Contact='"+lcContact+"'"
					cSQLu= cSQLu+",Telephone='"+lcPhone+"'"
					cSQLu= cSQLu+",Fax_Number='"+lcFax+"'"
					cSQLu= cSQLu+",Email='"+lcEmail+"'"
					cSQLu= cSQLu+",Customer="+ALLTRIM(STR(nUseShipCode,10,0))+""
					cSQLu= cSQLu+",LastEdit='"+DTOC(DATE())+"'"
					cSQLu= cSQLu+" WHERE ShipAddr.ShipCode = "+STR(lnShipAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
							lOK = .F.
						ENDIF
					ENDIF
						
					IF lOK
		*				ThisForm.UpdateCustID = .T.
						ThisForm.LastEdit.VALUE = DATE()
						ThisForm.LastEdit.REFRESH
					ENDIF
				ENDIF  &&  &&IF nSaveNew = 6 && Yes
				
				
				IF lOK AND lnShipAddr > 0
				*Update the Rest of the Fields
					**lcCustomer, llBlind, lcPayment, lcFrtPayment, lcShipRoute, lcInsrtct
					PRIVATE cSQLu
					cSQLu= "UPDATE dbo.ShipAddr SET "
					cSQLu= cSQLu+" Customer='"+lcCustomer+"'"
					cSQLu= cSQLu+",Blind="+IIF(llBlind,'1','0')+""
					cSQLu= cSQLu+",PayType='"+lcPayment+"'"
					cSQLu= cSQLu+",ShipPay='"+lcFrtPayment+"'"
					cSQLu= cSQLu+",ShipRoute='"+lcShipRoute+"'"
					cSQLu= cSQLu+",instrct='"+lcInsrtct+"'"
					
					cSQLu= cSQLu+" WHERE ShipAddr.ShipCode = "+STR(lnShipAddr)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
								
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						IF NOT SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
							lOK = .F.
						ENDIF
					ENDIF
					
				ENDIF	
			ENDIF &&IF lSaveAddress
		
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		IF USED('ShipAddr')	
			USE IN ShipAddr
		ENDIF
	ENDPROC

	PROCEDURE cmdAll.Click
		ThisForm.GetAllRecords()
	ENDPROC

	PROCEDURE cmdDuplicates.Click
		Private lcCurrTable 
		lcCurrTable = ALIAS()
		
		DO FORM Forms\removeduplicate WITH "ShipAddr",shipaddr.ShipCode
		
		IF USED('TmpSearch')
			USE IN TmpSearch
		EndIF
		
		SELECT ShipAddr
		
		*!*	IF nNewSoldToCode > 0
		*!*		LOCATE FOR ShipCode = nNewSoldToCode 
		*!*		ThisForm.Refresh
		*!*	ENDIF
	ENDPROC

	PROCEDURE cmdSearchSoldTo.Click
		Private lcCurrTable 
		lcCurrTable = ALIAS()
		
		IF ThisForm.cmdAll.Visible
			ThisForm.GetAllRecords()
		ENDIF
		
		DO FORM Forms\SearchForm WITH "ShipAddr",shipaddr.company  TO nNewSoldToCode
		
		IF USED('TmpSearch')
			USE IN TmpSearch
		EndIF
		
		SELECT ShipAddr
		
		IF nNewSoldToCode > 0
			LOCATE FOR ShipCode = nNewSoldToCode 
			ThisForm.Refresh
		ENDIF
	ENDPROC

	PROCEDURE Txtbtns1.cmdAdd.Click
		#DEFINE OPT_CANCEL			0
		#DEFINE OPT_ADD_PARENT		1
		#DEFINE OPT_ADD_CHILD		2
		#DEFINE OPT_ADD_BOTH		3
		#DEFINE MB_Q_YESNO			36
		#DEFINE MB_A_YES			6
		#DEFINE C_KEYFLDNOUPDATE_LOC	"The field relating the grid's view to the parent data source is not updatable. "+;
			"Do you just want to add a new record to the parent table?"
		#DEFINE C_BADCHILDKEY_LOC		"The fields relating the parent and child tables are not the same data type. "+;
			"Do you just want to add a new record to the parent table?"
		#DEFINE C_NOCHILDUPDATE_LOC		"The child data source is a view and does not send updates. "+;
			"Do you just want to add a new record to the parent table?"
		#DEFINE C_NOOBJ_LOC		"Failed create the Add Record form class. Check or reinstall your WIZSTYLE.VCX file."
		#DEFINE C_NOUPDATE_LOC	"You cannot add a new record because the view(s) selected does not send updates."
		#DEFINE C_NOUPDATE2_LOC	"You cannot add a new record because the view(s) selected does not send updates and the child data source has a primary key."
		
		LOCAL oSearchDlog,oAddRec,cChildAlias,cPapaAlias,i,lPrimeKey
		LOCAL cPapaKey,cChildKey,nSaveSess,oRel,cTagName,lBadViewKey,nSaveRec,nSaveRec2
		LOCAL lBadChildKey,lUpdatableParentKey,lNoSendParentUpdates,lNoSendChildUpdates
		
		DO CASE
		CASE THIS.Parent.EditMode
		
			** Code for saving record
			*THIS.Parent.UpdateRows()
			ThisForm.SaveAdd("Save")
		
		CASE EMPTY(THIS.Parent.GridRef)		&& not using Grid object
		
			** Code for adding record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
		*	APPEND BLANK
			ThisForm.SaveAdd("Add")
		OTHERWISE
		
			** Code for adding record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
			lPrimeKey = .F.					&&is child key primary index
			
			ThisForm.SaveAdd("Add")
		
		ENDCASE
		
		ThisForm.cmdAll.Enabled = .T.
		
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = THIS.Parent.EditMode
		THIS.Parent.TopFile = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE Txtbtns1.cmdAdd.Valid
		DODEFAULT( ) 
		*!*	PRIVATE maxShipCode 
		*!*	IF This.Caption = "\<Save"
		*!*		IF EMPTY(ThisForm.SHIPCODE1.Value)
		*!*			*redundant
		*!*			ThisForm.SHIPCODE1.Value = get_MaxShipCode()
		*!*		ENDIF
		*!*		ThisForm.LastEdit.Value = DATE()
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE Txtbtns1.cmdDelete.Click
		PRIVATE nShipCode
		nShipCode = ThisForm.ShipCODE1.Value
		
		IF nShipCode < 10
			MESSAGEBOX( 'You cannot delete this Address Standard.',16,'Not allowed')
			RETURN
		ENDIF
		
		IF Count_pShipAddrinSales_No( nShipCode ,ThisForm.nConnHandle) > 0
			MESSAGEBOX( 'You cannot delete this Address!'+CHR(13)+"This address has a SalesOrder history to it!",16,'Not allowed')
			RETURN
		ENDIF
			
			*See if a filter was used to refilter.
			PRIVATE m.cGetExpr
			m.cGetExpr = ""
			cGetExpr = SET('FILTER')
				
		PRIVATE nSQLEXEC, cSQL
		cSQL = "DELETE FROM dbo.ShipAddr WHERE ShipCode = "+STR(nShipCode)
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
			RETURN -1
		ENDIF
		
		*ThisForm.RefreshTable( RECNO(ShipAddr) )
		WAIT WINDOW 'Deleted ShipCode = '+ALLTRIM(STR(nShipCode))+'!'
		
		
		cSQL = "SELECT * "
		cSQL = cSQL + " FROM dbo.ShipAddr "
		cSQL = cSQL + " ORDER BY Company"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ShipAddr' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
		ENDIF
		
		IF !EMPTY(m.cGetExpr)
			SET FILTER TO &cGetExpr
			LOCATE
			IF EOF() &&Last of Filter!
				SET FILTER TO
			ENDIF
		ENDIF
		
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		
	ENDPROC

	PROCEDURE Txtbtns1.CMDEDIT.Click
		** Reverting record
		IF THIS.Parent.EditMode
			
			
			* Go back to original place
			SELECT (THIS.Parent.OldAlias)
			IF RECCOUNT() < THIS.Parent.OldRec	&&added record at EOF()
				GO TOP
			ELSE
				GO THIS.Parent.OldRec
			ENDIF
			
			ThisForm.cmdAll.Enabled = .T.
		ELSE
		
			* Check to see if view allows updates
		
			
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
			
			
			ThisForm.cmdAll.Enabled = .F.
		ENDIF
		
		** Editing record
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		THISFORM.LockScreen = .F.
	ENDPROC

ENDDEFINE
