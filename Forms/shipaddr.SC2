						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.Sales_No WITH(NOLOCK) "
						cSQL = cSQL + " WHERE pShipAddr= "+STR(lnShipAddr )
						cSQL = cSQL + " AND Sales_No.CNCLD = 0 AND Sales_No.CMPLT = 0"
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntSales_No' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntSales_No' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_No")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntSales_No")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntSales_No')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								lOK = .F.
							ENDIF
						ENDIF
						IF USED('cntSales_No')
							IF cntSales_No.cnt > 0
								
								MESSAGEBOX("There are Orders that have not shipped that will be changed!"+CHR(13)+CHR(13)+;
								ALLTRIM(STR(cntSales_No.cnt))+" unshipped Order(s) use the Address number "+;
								ALLTRIM(STR(lnShipAddr))+".",0+16,"CAUTION")
								
							ENDIF
		
							USE IN cntSales_No
						ENDIF
						
						*SELECT Sales_No	&&Sales_No does not have items detail
						*REPLACE pShipAddr WITH lnShipAddr IN Sales_No
						
						ThisForm.ShipAddr = lnShipAddr 
						*REPLACE pShipAddr WITH ThisForm.ShipAddr IN Sales_No
					ENDIF
					
		*!*				IF nSaveNew = 6 && Yes
		*!*					*Not needed in this window
		*!*					IF MESSAGEBOX("Do you want to mark the old Address as INACTIVE ?"+CHR(13)+CHR(13)+;
		*!*						"Inactive address will not show when you search for an address."+CHR(13)+;
		*!*						"If the company has moved,"+CHR(13)+;
		*!*						"permantly leaving the address,"+CHR(13)+;
		*!*						"please mark the old address as inactive now.",4,"") = 6
		*!*						
		*!*						
