		*!*						cSQLu= cSQLu+" WHERE ShipCode = "+STR(lnShipAddr)
		*!*						
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu )
		
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLu)
		*!*						ENDDO
		*!*						IF nSQLEXEC < 0 &&Try again!
		*!*							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLu, "")
		*!*									
		*!*								IF nSQLEXEC < 0
		*!*									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*										nSQLEXEC = 0
		*!*									ENDIF
		*!*								ENDIF
		*!*							ENDDO
		*!*						ENDIF
		*!*						IF nSQLEXEC < 0
		*!*							IF NOT SQLEXECError(cSQLu ,ThisForm.nConnHandle, nSQLEXEC, '')
		*!*								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLu )
		*!*								lOK = .F.
		*!*							ENDIF
		*!*						ENDIF
		*!*						
		*!*					ENDIF
		*!*				ENDIF
				ELSE
					**No SoldAddr- must save as new!
					nSaveNew = 6
				ENDIF
		
				IF nSaveNew = 6 AND lOK	&& Yes, save as new
					****** big save procedure********
					IF ThisForm.ShipAddr > 0 &&Check old ShipCode to see if anything changed.
						*Check old ShipCode to see if anything changed
						IF USED( 'cntShipAddr' )
							USE IN cntShipAddr
						ENDIF
						
						PRIVATE cSQL, nSQLEXEC
						cSQL = "SELECT COUNT(*) AS cnt FROM dbo.ShipAddr WITH(NOLOCK) "
						cSQL = cSQL + " WHERE "
						cSQL = cSQL + "Company = '"+lcCompany+"' AND "
						cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
						cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
						cSQL = cSQL + "City  = '"+lcCity+"' AND "
						cSQL = cSQL + "ST    = '"+lcST+"' AND " 
						cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
						cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
						cSQL = cSQL + "Contact = '"+lcContact+"' AND "
						cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
						cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
						cSQL = cSQL + "Email = '"+lcEmail+"' "
		*				cSQL = cSQL + " AND shipcode = "+STR(ThisForm.ShipAddr)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								lOK = .F.
							ENDIF
						ENDIF
						IF USED('cntShipAddr')
							IF cntShipAddr.Cnt = 0
		*						*-no change - do not save
								*Did not find - Save
								lSaveAddr1 = .T.
								nOldShipCode = ThisForm.ShipCode1.Value
							ELSE 
								*Found match - do not need to save
								lSaveAddr1 = .F.
							ENDIF
						ELSE &&failed - add as new
							lSaveAddr1 = .T.
						ENDIF 
						
					ELSE && No ShipCode - add if have data
						IF LEN( ALLTRIM(ThisForm.COMPANY1.VALUE + ThisForm.ADDR11.VALUE)) > 1
							lSaveAddr1 = .T.
						ELSE
							*No Company or Address to save! Clear!!!
							lSaveAddr1 = .F.
						ENDIF
					ENDIF
		
					IF lSaveAddr1 AND lOK
						WAIT WINDOW "Saving 'Ship To' address." NOWAIT
		
						*save same as SoldCode (if avalable)
		*!*					IF ThisForm.SoldAddr <> ThisForm.ShipAddr
		*!*					
		*!*						IF USED("cntShipCode")
		*!*							USE IN cntShipCode
		*!*						ENDIF
		*!*						
		*!*						cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.ShipAddr WITH(NOLOCK)"
		*!*						cSQL = cSQL + " WHERE ShipCode = "+STR(ThisForm.SoldAddr)
		*!*						
		*!*						SELECT 0
		*!*						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipCode')
		*!*						DO WHILE nSQLEXEC = 0
		*!*							WAIT WINDOW 'SQL' TIMEOUT 1
		*!*							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipCode')
		*!*						ENDDO
		*!*						IF nSQLEXEC < 0 &&Try again!
		*!*							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipCode")
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipCode")
		*!*									
		*!*								IF nSQLEXEC < 0
		*!*									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*										nSQLEXEC = 0
		*!*									ENDIF
		*!*								ENDIF
		*!*							ENDDO
		*!*						ENDIF
		*!*						IF nSQLEXEC < 0
		*!*							IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipCode')
		*!*								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*							ENDIF
		*!*						ENDIF
		*!*						IF USED("cntShipCode")
		*!*							IF cntShipCode.cnt = 0
		*!*								*Not Found
		*!*								nUseShipCode = ThisForm.SoldAddr
		*!*							ENDIF
		*!*							USE IN cntShipCode
		*!*						ELSE
		*!*						ENDIF
		*!*					ENDIF
		
						IF nUseShipCode = 0 &&need to find a ShipCode
							*			Get next code nMaxShipCode
		
							*nMaxSoldCode = ThisForm.maxSoldCode()
							*nMaxShipCode = ThisForm.maxShipCode()
							nMaxShipCode = get_MaxShipCode()
							*nUseShipCode = MAX( nMaxSoldCode, nMaxShipCode )
		
						ENDIF
						IF nUseShipCode > 0 &&Save here
							ThisForm.ShipAddr = nUseShipCode
							*REPLACE pShipAddr WITH ThisForm.ShipAddr IN Sales_No
							ThisForm.SHIPCODE1.VALUE = nUseShipCode
		*					THIS.PARENT.numShipAddr.VALUE = nUseShipCode
							lnShipAddr = nUseShipCode
							
							*Save_ShipAddrCode(nUseShipCode, "ShipAddr", nOldShipCode, ThisForm.nConnHandle)
							
		*!*						IF ThisForm.SalesNum > 0
		*!*							*Save ShipCode now to Sales_No
		*!*							*so the ShipAddr insert trigger knows what Sales_No in email.
		*!*							cSQL = "UPDATE dbo.Sales_No "
		*!*							cSQL = cSQL + " SET pShipAddr = "+STR(nUseShipCode)
		*!*							cSQL = cSQL + " WHERE SalesNum = "+STR(ThisForm.SalesNum)
		*!*							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL 1' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*							ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipCode")
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipCode")
		*!*									
		*!*								IF nSQLEXEC < 0
		*!*									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*										nSQLEXEC = 0
		*!*									ENDIF
		*!*								ENDIF
		*!*							ENDDO
		*!*						ENDIF
		*!*							DO WHILE nSQLEXEC = 0
		*!*								WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*							ENDDO
		*!*							
		*!*							IF nSQLEXEC < 0 &&Try again!, long triger
		*!*								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
		*!*								DO WHILE nSQLEXEC = 0
		*!*									WAIT WINDOW 'SQL' TIMEOUT 1
		*!*									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
		*!*								ENDDO
		*!*							ENDIF
		*!*							
		*!*							IF nSQLEXEC < 0
		*!*								IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC)
		*							RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
		*!*							ENDIF
		
		*!*							SELECT Sales_No	&&Sales_No does not have items detail
		*!*							REPLACE pShipAddr WITH nUseShipCode IN Sales_No
		*!*						ENDIF
							
							PRIVATE cSQLi
							cSQLi = "INSERT INTO dbo.ShipAddr (shipcode, Company, Addr1, Addr2, City, ST, Zip, Country, Contact, Telephone, Fax_Number, Email, Customer, LastEdit) VALUES "
							cSQLi = cSQLi+"("+STR(nUseShipCode)+""
							cSQLi = cSQLi+",'"+lcCompany+"'"
							cSQLi = cSQLi+",'"+lcAddr1+"'"
							cSQLi = cSQLi+",'"+lcAddr2+"'"
							cSQLi = cSQLi+",'"+lcCity+"'"
							cSQLi = cSQLi+",'"+lcST+"'"
							cSQLi = cSQLi+",'"+lcZip+"'"
							cSQLi = cSQLi+",'"+lcCountry+"'"
							cSQLi = cSQLi+",'"+lcContact+"'"
							cSQLi = cSQLi+",'"+lcPhone+"'"
							cSQLi = cSQLi+",'"+lcFax+"'"
							cSQLi = cSQLi+",'"+lcEmail+"'"
							cSQLi = cSQLi+",''"		&&+ALLTRIM(STR(nUseShipCode,10,0))+""
							cSQLi = cSQLi+",'"+DTOC(DATE())+"' )"
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQLi)
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
										
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								IF NOT SQLEXECError(cSQLi ,ThisForm.nConnHandle, nSQLEXEC ,'')
									RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQLi )
									lOK = .F.
								ENDIF
							ENDIF
							
							
		*!*						IF ThisForm.SoldAddr > 0 AND lOK
		*!*							Save_Sold_Ship(ThisForm.SoldAddr, nUseShipCode,ThisForm.nConnHandle)
		*!*						ENDIF
							
		*!*						*****************
		*!*						
		*!*						IF ThisForm.SalesNum > 0 AND lOK
		*!*							IF Count_SOinPackingSlip_No( ThisForm.SalesNum, ThisForm.nConnHandle ) > 0
