	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE getallrecords
		
		*ThisForm.GetAllRecords()
		
		PRIVATE nAddrCode
		nAddrCode = 0
		
		IF USED('ShipAddr')
			nAddrCode = ShipAddr.ShipCode
			USE IN ShipAddr
		ENDIF
		SELECT 0
		
		WAIT WINDOW "Getting ALL records now!" NOWAIT
				
		cSQL = "SELECT * FROM dbo.ShipAddr ORDER BY Company"
			
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
		ELSE
			IF nAddrCode > 0
				LOCATE FOR ShipCode = nAddrCode
			ENDIF
		
			ThisForm.Txtbtns1.Topfile = .F.
			ThisForm.Txtbtns1.navrefresh()
		
			ThisForm.Txtbtns1.CMDTOP.Enabled = .T.
			ThisForm.txtbtns1.CMDPrev.Enabled = .T.
			
		ENDIF
		
		ThisForm.cmdAll.Visible = .F.
	ENDPROC

	PROCEDURE Init
		PARAMETERS pShipCode
		*DO FORM Forms\ShipAddr WITH 1024
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('ShipAddr')	
			USE IN ShipAddr
		ENDIF
		SELECT 0
		
		PRIVATE lFound
		lFound = .F.
		IF VARTYPE(pShipCode) = "N"
			IF pShipCode > 0
			
				cSQL = "SELECT S1.* FROM dbo.ShipAddr S1, dbo.ShipAddr S2 "
				cSQL = cSQL + " WHERE S2.ShipCode="+ALLTRIM(STR(pShipCode))
				cSQL = cSQL + " AND S1.Company = S2.Company "
				
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
				ENDIF
			
				SELECT ShipAddr
				LOCATE FOR ShipCode = pShipCode
				IF FOUND()
					lFound = .T.
					IF EOF()
						ThisForm.Txtbtns1.Endfile = .T.
					ELSE
						ThisForm.Txtbtns1.Endfile = .f.
					ENDIF
					IF BOF()
						ThisForm.Txtbtns1.Topfile = .T.
					ELSE
						ThisForm.Txtbtns1.Topfile = .F.
					ENDIF
					ThisForm.Txtbtns1.navrefresh()
		
		
					ThisForm.cmdAll.Visible = .T.
				ENDIF
			ENDIF
		ELSE
			*MESSAGEBOX("Parameters should look like this."+CHR(13)+"\ShipAddr WITH nShipCode",16,"Bad Parameters")
		ENDIF
		
		IF NOT lFound
			ThisForm.GetAllRecords()
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_Setup.prg ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('ShipAddr')	
			USE IN ShipAddr
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM dbo.ShipAddr WITH(NOLOCK) WHERE 0>0"
			
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
		ENDIF
		
		RETURN !THIS.HadError
		
		
	ENDPROC

	PROCEDURE refreshtable
		PARAMETERS pRecNo
		*ThisForm.RefreshTable( RECNO(ShipAddr) )
		
		IF USED('ShipAddr')	
			USE IN ShipAddr
		ENDIF
		
		cSQL = "SELECT * FROM dbo.ShipAddr"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ShipAddr')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ShipAddr")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'ShipAddr')
		ENDIF
		
		IF VARTYPE(pRecNo) = 'N'
			IF pRecNo < RECCOUNT(ShipAddr)
				GOTO pRecNo
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE saveadd
		PARAMETERS pWhat
		*SaveAdd()  'Add' 'Save'
		
		IF VARTYPE( pWhat ) != 'C'
			pWhat = ''
		ENDIF
		
		IF EMPTY(pWhat)
			RETURN .F.
		ENDIF
		
		IF UPPER(pWhat) = "ADD"
			*get a new ShipCode
			
			PRIVATE useShipCode, maxSoldCode
			*thisform.maxSoldCode()
			*Get next code maxShipCode
		
			IF USED('cntShipAddr')
				USE IN cntShipAddr
			ENDIF
			SELECT 0
		
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT MAX(ShipCode) AS Cntd FROM dbo.ShipAddr "
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntShipAddr')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'cntShipAddr' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "cntShipAddr")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'cntShipAddr')
			ENDIF
		
			IF USED('cntShipAddr')
				IF cntShipAddr.Cntd > 0
					useShipCode = cntShipAddr.Cntd + 1
					ThisForm.ShipCODE1.Value = useShipCode
					ThisForm.ShipAddr = useShipCode
				ELSE
					useShipCode = 1000
				ENDIF
			ENDIF
		
			IF USED('cntShipAddr')
				USE IN cntShipAddr
			ENDIF
			
			Thisform.SHIPCODE1.Value = useShipCode 
			Thisform.LASTEDIT.Value = DATE()
			ThisForm.chkInactive.Value = 0
			Thisform.COMPANY1.Value = ''
			Thisform.ADDR11.Value = ''
			Thisform.AddR21.Value = ''
			Thisform.CITY1.Value = ''
			Thisform.ST1.Value = ''
			Thisform.ZIP1.Value = ''
			
			Thisform.COUNTRY1.Value = ''
			Thisform.CONTACT1.Value = ''
			Thisform.TELEPHONE1.Value = ''
			Thisform.FAX_NUMBER1.Value = ''
			Thisform.EMAIL1.Value = ''
			
			Thisform.CUSTOMER1.Value = ''
			Thisform.txtInstrct.Value = ''
			Thisform.chkBlind.Value = 0
			Thisform.cmbPayment.Value = ''
			Thisform.cmbFrtPayment.Value = ''
			Thisform.SHIPROUTE.Value = ''
				
			*RETURN useShipCode
		ENDIF
		
		****************************************************
		IF UPPER(pWhat) = "SAVE"
		*	MESSAGEBOX("Not Programmed")
			*SAVE
			PRIVATE	nMaxShipCode, nmaxSoldCode, nOldShipCode, nUseShipCode, lSaveAddr1
			PRIVATE lcCompany,lcAddr1,lcAddr2,lcCity,lcST,lcZip,lcCountry,ldLastEdit,lnShipAddr,lcInsrtct
			PRIVATE lcContact,lcPhone,lcFax,lcEmail
			PRIVATE lcCustomer, llBlind, lcPayment, lcFrtPayment, lcShipRoute
			PRIVATE mHoldRecordNum
			nMaxShipCode = 0
			lSaveAddr1 = .F.
			nOldShipCode = 0
			nUseShipCode = 0
			
			*ShowSQLtxt("Space Alloys USA'",'Company',25)
			lcCompany =PrepareSQLtxt(Thisform.COMPANY1.VALUE,'Company',100)
			lcAddr1 = PrepareSQLtxt(Thisform.ADDR11.VALUE,'Addr1',100)
			lcAddr2 = PrepareSQLtxt(Thisform.ADDR21.VALUE,'Addr2',100)
			lcCity  = PrepareSQLtxt(Thisform.CITY1.VALUE,'City',100)
			lcST    = PrepareSQLtxt(Thisform.ST1.VALUE,'State',50)
			lcZip   = PrepareSQLtxt(Thisform.ZIP1.VALUE,'Zip',50)
			lcCountry = UPPER(ALLTRIM(PrepareSQLtxt(Thisform.COUNTRY1.VALUE,'Country',50)))
			lcContact = PrepareSQLtxt(Thisform.CONTACT1.VALUE,'Contact',101)
			lcPhone = PrepareSQLtxt(Thisform.TELEPHONE1.VALUE,'Phone',50)
			lcFax	 = PrepareSQLtxt(Thisform.FAX_NUMBER1.VALUE,'Fax',12)
			lcEmail = PrepareSQLtxt(Thisform.EMAIL1.VALUE,'Email',60)
			*lcCustomer, llBlind, lcPayment, lcFrtPayment, lcShipRoute, lcInsrtct
			lcCustomer	= PrepareSQLtxt(Thisform.CUSTOMER1.VALUE,'Customer',20)
			llBlind		= PrepareSQLlogic(Thisform.chkBlind.Value,'Blind')
			lcPayment	= PrepareSQLtxt(ThisForm.cmbPayment.Value,'Payment',10)
			lcFrtPayment= PrepareSQLtxt(ThisForm.cmbFrtPayment.Value,'FrtPayment',12)
			lcShipRoute	= PrepareSQLtxt(Thisform.ShipRoute.Value,'ShipRoute',50)
			lcInsrtct	= PrepareSQLtxt(ThisForm.txtInstrct.Value,'Inscrt',100)
			*Thisform.CUSTOMER1
			ldLastEdit = DATE()
			lnShipAddr = PrepareSQLnum(ThisForm.ShipCode1.Value,'ShipAddr',-3)
			lSaveAddress = .F.
		
			** Do you have anything to save?
			IF NOT LEN(ALLTRIM(lcCompany+lcAddr1+lcAddr2+lcCity+lcST+lcZip+lcCountry+lcContact))=0
				lSaveAddress = .T.
			ENDIF
		
			IF LEN(ALLTRIM(lcCompany))=0
				MESSAGEBOX("Cannot save without an Company name!")
				lSaveAddress = .F.
			ENDIF
			
			PRIVATE lOK
			lOK = .T.
			
			IF lSaveAddress 
				IF USED( 'delShipAddr' )
					USE IN delShipAddr
				ENDIF
				
				cSQL = "SELECT COUNT(*) AS Cnt FROM dbo.ShipAddr WITH(NOLOCK) "
				cSQL = cSQL + " WHERE "
				cSQL = cSQL + "Company = '"+lcCompany+"' AND "
				cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
				cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
				cSQL = cSQL + "City = '"+lcCity+"' AND "
				cSQL = cSQL + "ST = '"+lcST+"' AND " 
				cSQL = cSQL + "Zip = '"+lcZip+"' AND "
				cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
				cSQL = cSQL + "Contact = '"+lcContact+"' AND "
				cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
				cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
				cSQL = cSQL + "Email = '"+lcEmail+"' "
		*		cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(lnShipAddr))
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'delShipAddr' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'delShipAddr' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "delShipAddr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "delShipAddr")
							
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'delShipAddr')
						RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
						lOK = .F.
					ENDIF
				ENDIF
				
				IF USED('delShipAddr')
					IF delShipAddr.Cnt < 1
						lSaveAddress = .T.
						
						*Override - Save as HPA Production Work
						IF lcCompany = "Space Alloys USA" OR lcCompany = "HPA "
						*	This.parent.parent.pgBillTo.txtSoldCode.Value = 1
							lnShipAddr = 1
							lSaveAddress = .F.
						ENDIF
					ELSE
						lSaveAddress = .F.
						*Already have exact Address
						
						IF USED("tmpCntShipCode")
							USE IN tmpCntShipCode
						ENDIF
						
						cSQL = "SELECT ShipCode FROM dbo.ShipAddr WITH(NOLOCK)"
						cSQL = cSQL + " WHERE Company = '"+lcCompany +"'"
						cSQL = cSQL + " AND Addr1 = '"+lcAddr1+"'"
						cSQL = cSQL + " AND Addr2 = '"+lcAddr2+"'"
						cSQL = cSQL + " AND City = '"+lcCity+"'"
						cSQL = cSQL + " AND ST = '"+lcST+"'"
						cSQL = cSQL + " AND Zip = '"+lcZip+"'"
						cSQL = cSQL + " AND Country = '"+lcCountry+"'"
						cSQL = cSQL + " AND Contact = '"+lcContact+"'"
						cSQL = cSQL + " AND Telephone = '"+lcPhone+"'"
						cSQL = cSQL + " AND Fax_Number= '"+lcFax+"'"
						cSQL = cSQL + " AND Email = '"+lcEmail+"'"
					*	cSQL = cSQL + " AND shipcode = "+ALLTRIM(STR(lnShipAddr))
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntShipCode')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCntShipCode')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntShipCode")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntShipCode")
									
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpCntShipCode')
								RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
								lOK = .F.
							ENDIF
						ENDIF
						
						IF USED("tmpCntShipCode")
							IF VARTYPE(tmpCntShipCode.ShipCode) = 'N'
								lnShipAddr = tmpCntShipCode.ShipCode
								ThisForm.ShipAddr = lnShipAddr
							*	REPLACE pShipAddr WITH ThisForm.ShipAddr IN Sales_No
							ENDIF
							USE IN tmpCntShipCode
						ENDIF
							
							
						*****
						IF lOK
							IF ThisForm.ShipAddr = 0
		
								*Find the ShipCode and display it
								IF USED( 'shipcodeShipAddr' )
									USE IN shipcodeShipAddr
								ENDIF
								
								PRIVATE cSQL, nSQLEXEC
								cSQL = "SELECT shipcode FROM dbo.ShipAddr WITH(NOLOCK) "
								cSQL = cSQL + " WHERE "
								cSQL = cSQL + "Company = '"+lcCompany+"' AND "
								cSQL = cSQL + "Addr1 = '"+lcAddr1+"' AND "
								cSQL = cSQL + "Addr2 = '"+lcAddr2+"' AND "
								cSQL = cSQL + "City  = '"+lcCity+"' AND "
								cSQL = cSQL + "ST    = '"+lcST+"' AND " 
								cSQL = cSQL + "Zip   = '"+lcZip+"' AND "
								cSQL = cSQL + "Country = '"+lcCountry+"' AND " 
								cSQL = cSQL + "Contact = '"+lcContact+"' AND "
								cSQL = cSQL + "Telephone = '"+lcPhone+"' AND "
								cSQL = cSQL + "Fax_Number = '"+lcFax+"' AND "
								cSQL = cSQL + "Email = '"+lcEmail+"'"
								
								SELECT 0
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'shipcodeShipAddr' )
		
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'shipcodeShipAddr' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "shipcodeShipAddr")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "shipcodeShipAddr")
											
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									IF NOT SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'shipcodeShipAddr')
										RecordError(nSQLEXEC,"SQL Error" ,PROGRAM(),LINENO(1),cSQL )
										lOK = .F.
									ENDIF
								ENDIF
		
								IF USED('shipcodeShipAddr')
									IF shipcodeShipAddr.shipcode > 0
										ThisForm.ShipAddr = shipcodeShipAddr.shipcode
										ThisForm.ShipCode1.REFRESH
										*REPLACE pShipAddr WITH ThisForm.ShipAddr IN Sales_No
										
										*ThisForm.Set_Sales_No_Chng()
										
									ENDIF
									USE IN shipcodeShipAddr
								ENDIF
							ENDIF  &&EMPTY(ThisForm.ShipAddr)
						ENDIF &&lOK
						
					ENDIF &&delShipAddr.Cnt
					
					USE IN delShipAddr
				ELSE &&USE IN delShipAddr
					lSaveAddress = .F.
				ENDIF
			ENDIF &&IF lSaveAddress
			
			*****
			
			IF lSaveAddress AND lOK
				PRIVATE	cSaveNew
		
				IF lnShipAddr > 0
					nSaveNew = MESSAGEBOX("Save as new Address?"+CHR(13)+;
					"Answer 'YES' to save as new address"+CHR(13)+;
					"when the Company has moved or"+CHR(13)+;
					"when this is a different address location."+CHR(13)+CHR(13)+;
					"Answer 'No' if you are correcting typeing error.";
					,4+32,"New Address?")
					
					IF nSaveNew = 7 && No
						IF USED( 'cntSales_No' )
