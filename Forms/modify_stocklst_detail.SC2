	PROCEDURE txtDim32.Valid
		PRIVATE nSub, nCurr, nCalc
		nSub = PrepareSQLnum(This.Value,'Sz3',9,3)
		IF VARTYPE(nSub)="C"
			nSub = VAL(nSUB)
		ENDIF
		
		nCurr = PrepareSQLnum(ThisForm.txtDim31.Value,'Sz3',9,3)
		IF VARTYPE(nCurr)="C"
			nCurr = VAL(nCurr)
		ENDIF
		
		nCalc = 0
		
		PRIVATE nPC
		nPC = PrepareSQLnum(ThisForm.txtPC1.Value,'PC',-3)
		IF nPC = 1
		
			IF (VARTYPE(nSub) = "N" OR VARTYPE(nSub) = "Y") AND ( VARTYPE(nCurr) = "N" OR VARTYPE(nCurr) = "Y")
				nCalc = nCurr - nSub
				This.Value = 0
				
				IF nCalc > 0	
					ThisForm.txtDim31.Value = nCalc
					ThisForm.txtDim31.Refresh
					
					ThisForm.Calc_StockDetail_1()
							
					PRIVATE cMess
					cMess = "DIM3 changed from "+ALLTRIM(STR(nCurr,9,3))+" to "+ALLTRIM(STR(nCalc,9,3))
					ThisForm.TrackUserEdit(cMess)
		
				ELSE
					WAIT WINDOW "Not updated!" NOWAIT
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

