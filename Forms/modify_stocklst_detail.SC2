					cSQLid = cSQLid+ ",Heat='"+cHeat+"'"
					cSQLid = cSQLid+ ",Lot='"+cLot+"'"
					cSQLid = cSQLid+ ",CC='"+cCC+"'"
					cSQLid = cSQLid+ ",CL='"+cCL+"'"
					
					cSQLid = cSQLid+ ",RandLen="+IIF(lRandLen,'1','0')
					cSQLid = cSQLid+ ",Orig_PC="+STR(nOrig_PC)  &&Orig
					cSQLid = cSQLid+ ",Orig_Dim1="+STR(nOrig_Dim1,18,4)
					cSQLid = cSQLid+ ",Orig_Dim2="+STR(nOrig_Dim2,17,3)
					cSQLid = cSQLid+ ",Orig_Dim3="+STR(nOrig_Dim3,17,3)
					cSQLid = cSQLid+ ",Orig_LBS ="+STR(nOrig_LBS,15,1)
					cSQLid = cSQLid+ ",StkPaid_P="+STR(nStkPaid_P,18,4)
					cSQLid = cSQLid+ ",StkPaid_Total="+STR(nRemoved_Paid_Total,18,4)
		
					cSQLid = cSQLid+ ",Left_PC="+STR(nNewStk_PC,10)  &&Orig
					cSQLid = cSQLid+ ",Left_Dim1="+STR(nNewStk_Dim1,10,4)
					cSQLid = cSQLid+ ",Left_Dim2="+STR(nNewStk_Dim2,9,3)
					cSQLid = cSQLid+ ",Left_Dim3="+STR(nNewStk_Dim3,9,3)
					cSQLid = cSQLid+ ",Left_LBS="+STR(nNewStk_LBS,9,1)
					cSQLid = cSQLid+ ",Left_QTY="+STR(nNewStk_QTY,18,4)
		
					cSQLid = cSQLid+ ",WO="+STR(nWO)
					cSQLid = cSQLid+ ",WO_Detail="+STR(nWO_Detail)
					cSQLid = cSQLid+ ",UserEdit='"+cUserEdit+"'"
					*cSQLid = cSQLid+ ",UserEdit= ISNULL(UserEdit,'') + '"+cUserEdit+"'"
																	
					cSQLid = cSQLid+ " WHERE ID="+STR(nSales_Stock_ID)
					
					*nSales_Stock_ID = 0
		*			TrackError(cSQLid,"Found Sales_Stock from PackingSlip!?!"+" Sales_Stock.ID="+STR(nSales_Stock_ID),PROGRAM(),LINENO(0))
					RecordTest('Record Test Data.',PROGRAM(),LINENO(0),"Found Sales_Stock from PackingSlip!?!"+" Sales_Stock.ID="+STR(nSales_Stock_ID)+" "+CHR(13)+cSQLid)
				ENDIF
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQLid, ThisForm.nConnHandle,nSQLEXEC)
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					lOK =.F.
				ELSE
					IF nSales_Stock_ID = 0
						*Get nSales_Stock_ID
						
						IF USED('tmpSales_Stock_ID')
							USE IN tmpSales_Stock_ID
						ENDIF
						
						cSQL = "SELECT ID FROM dbo.Sales_Stock "
						cSQL=cSQL+" WITH(NOLOCK) "
						cSQL=cSQL+" WHERE StockLst_Qty="+STR(nStockLst_Qty,18,4)
						cSQL=cSQL+" AND StockLst_P="+STR(nStockLst_P,18,4)
						cSQL=cSQL+" AND StockLst_Total="+STR(nStockLst_Total,18,4)   &&nRemoved_Total
						cSQL=cSQL+" AND StockLst_PU="+STR(nStockLst_PU)
		*				cSQL=cSQL+" AND StockLst_PC="+STR(nNewStk_PC,10,0) &&StockLst_PC
		*				cSQL=cSQL+" AND StockLst_Dim1="+STR(nNewStk_Dim1,10,4)
		*				cSQL=cSQL+" AND StockLst_Dim2="+STR(nNewStk_Dim2,9,3)
		*				cSQL=cSQL+" AND StockLst_Dim3="+STR(nNewStk_Dim3,9,3)
		*				cSQL=cSQL+" AND StockLst_LBS="+STR(nNewStk_LBS,9,1)
		*				cSQL=cSQL+" AND [StockLst_POitem]=dbo.f_ProperPOitem('"+cPOitem+"')"
						cSQL=cSQL+" AND Consumed="+IIF(lConsumed,"1","0") &&Consumed 
						cSQL=cSQL+" AND StkBack="+IIF(lStkBackValued,"1","0") &&StkBack
					
		*				cSQL=cSQL+" AND StockEdit=GetDate()" &&StockEdit
						cSQL=cSQL+" AND StockEdit='"+TTO_SQL_C(dtGetDate)+"'"
						
						cSQL=cSQL+" AND TBL='"+IIF(cTBL="S","S",IIF(cTBL="B","B","W"))+"'"
						cSQL=cSQL+" AND StockLst_ID="+STR(nID)
						cSQL=cSQL+" AND StockLst_ID_Detail="+STR(nID_Detail)
						cSQL=cSQL+" AND ID_Detail_Process="+STR(nID_Detail_Process)
		*				cSQL=cSQL+" AND Removed_PC="+STR(nRemoved_PC,10)
		*				cSQL=cSQL+" AND Removed_Dim1="+STR(nRemoved_Dim1,10,4)
		*				cSQL=cSQL+" AND Removed_Dim2="+STR(nRemoved_Dim2,9,3)
		*				cSQL=cSQL+" AND Removed_Dim3="+STR(nRemoved_Dim3,9,3)
		*		    	cSQL=cSQL+" AND Removed_QTY="+STR(nRemoved_Qty,18,4)
		*		    	cSQL=cSQL+" AND Removed_LBS="+STR(nRemoved_LBS,9,1)
		*		    	cSQL=cSQL+" AND Removed_Paid_Total="+STR(nRemoved_Paid_Total,18,4)
		*		    	cSQL=cSQL+" AND Removed_Total="+STR(nRemoved_Total,18,4)
				    
				    	cSQL=cSQL+" AND Alloy='"+cAlloy+"'"
						cSQL=cSQL+" AND Form='"+cForm+"'"
						cSQL=cSQL+" AND Heat='"+cHeat+"'"
						cSQL=cSQL+" AND Lot='"+cLot+"'"
						cSQL=cSQL+" AND CC='"+cCC+"'"
						cSQL=cSQL+" AND CL='"+cCL+"'"
						cSQL=cSQL+" AND RandLen="+IIF(lRandLen,'1','0')
		
		*				cSQL=cSQL+" AND StkPaid_P="+STR(nStkPaid_P,18,4)
		*				cSQL=cSQL+" AND StkPaid_Total="+STR(nRemoved_Paid_Total,18,4)
								
						cSQL=cSQL+" AND WO="+STR(nWO)
						*cSQL=cSQL+" AND WO_Detail="+STR(nWO_Detail)
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpSales_Stock_ID' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpSales_Stock_ID' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpSales_Stock_ID' )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpSales_Stock_ID' )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Stock_ID")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_Stock_ID")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL , ThisForm.nConnHandle,nSQLEXEC,'tmpSales_Stock_ID')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						ENDIF
		
						IF USED('tmpSales_Stock_ID')
							IF RECCOUNT('tmpSales_Stock_ID') > 0
								nSales_Stock_ID = PrepareSQLnum(tmpSales_Stock_ID.ID,'Sales_Stock_ID',-3)
							ENDIF
							USE IN tmpSales_Stock_ID
						ENDIF
		
						
					ENDIF
				ENDIF
				
				****
				IF ThisForm.nWO > 0
					PRIVATE lOutSource
					lOutSource = is_WO(ThisForm.nWO,ThisForm.nConnhandle,'OutSource')
					
					IF lOutSource 
						PRIVATE nMess, cMess
						cMess = "This Stock Edit was for a WO "+ALLTRIM(STR(nWO))+CHR(13)+"Is this stock going to outside processing?"
						nMess = MESSAGEBOX(cMess,3+32,"OutSource ?")
						
						*Insert into OutSource
						cSQL = "INSERT INTO dbo.WO_OutSource "
						cSQL = cSQL + "([WO]"
				      	cSQL = cSQL + ",[SOitem]"
				*      	cSQL = cSQL + ",[Converter]"
				*      	cSQL = cSQL + ",[ConvertPOi]"
				      	cSQL = cSQL + ",[ConvertSent]"
				      	cSQL = cSQL + ",[Stock_TBL]"
				      	cSQL = cSQL + ",[Stock_ID]"
				      	cSQL = cSQL + ",[Stock_ID_D]"
				      	cSQL = cSQL + ",[Stock_ID_D_P]"
				      	cSQL = cSQL + ",[Stock_QTY]"
				      	cSQL = cSQL + ",[Stock_PU]"
				      	
				      	cSQL = cSQL + ",[Sales_Detail_ID]"
				      	cSQL = cSQL + ",[Sales_Stock_ID]"
				      	cSQL = cSQL + ",[StockEdit]"
						cSQL = cSQL + ") VALUES ("
						
						cSQL = cSQL + " "+STR(ThisForm.nWO)
				      	cSQL = cSQL + ",'"+cSOitem+"'"
				*      	cSQL = cSQL + ",[Converter]
				*      	cSQL = cSQL + ",[ConvertPOi]
				
				      	*cSQL = cSQL + ",GetDate()"
				      	cSQL = cSQL + ",'"+TTOC(dtGetDate)+"'"
				      	
				      	cSQL = cSQL + ",'"+cTBL+"'"
				      	cSQL = cSQL + ","+STR(nID)
				      	cSQL = cSQL + ","+STR(nID_Detail)
				      	cSQL = cSQL + ","+STR(nID_Detail_Process)
				      	cSQL = cSQL + ","+STR(nStockLst_QTY)
				      	cSQL = cSQL + ","+STR(nStockLst_PU)
				      	
				      	cSQL = cSQL + ",0"	&&[Sales_Detail_ID]
				      	cSQL = cSQL + ","+STR(nSales_Stock_ID)
				      	cSQL = cSQL + ",'"+TTOC(dtGetDate)+"'"
						cSQL = cSQL + ")"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'' )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'' )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						ENDIF
						
					ENDIF
				ENDIF
		
			ENDSCAN  &&tmpStkSum
		ENDIF
		
		************************************************************************************************************************************
		*  dbo.Sales_Detail 
		************************************************************************************************************************************
		
		IF lOK
			*Collect Old Stock for dbo.Sales_Detail
			PRIVATE nSalesNum
			nSalesNum = VAL(cSOitem)
			
			PRIVATE nQuoted_PC,nQuoted_Dim1,nQuoted_Dim2,nQuoted_Dim3,nQuoted_LBS,nQuoted_Qty
			*Default to tmpStkSum, if found in Allquotes, Overwrite.
			
			SELECT tmpStkSum
		
			SCAN
				*Collect AllQuotes SOitem data
				IF USED('tmpAQpc')
					USE IN tmpAQpc
				ENDIF
				SELECT 0
				
				*IF cSOitem != Proper_SO_item('')
				IF nWO = 0
					cSQL = "SELECT [Pieces] AS PC, [Thck] AS Dim1, [Sz2] AS Dim2, [Sz3] AS Dim3, [Weight]"
					cSQL = cSQL + ",ISNULL(dbo.f_Get_QTY_SOitem(SOitem),0) AS Quoted_QTY, cWeight"
					cSQL = cSQL + ",Form, dbo.f_GetWeightDisk(Pieces,Alloy,Form,Thck,Sz2,Sz3) AS DiskLBS"
					cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				*ENDIF
				*IF nWO > 0
				ELSE
					cSQL = "SELECT [sPieces] AS PC, [sThck] AS Dim1, [sSz2] AS Dim2, [sSz3] AS Dim3, [sWeight] AS [Weight]"
					cSQL = cSQL + ",ISNULL(dbo.f_Get_QTY_SOitem(SOitem),0) as Quoted_QTY "
					cSQL = cSQL + ",sWeight AS cWeight "
					cSQL = cSQL + ",sForm AS Form, dbo.f_GetWeightDisk(sPieces,sAlloy,sForm,sThck,sSz2,sSz3) AS DiskLBS "
					cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) "
					cSQL = cSQL + " WHERE WO = "+STR(nWO) 
				ENDIF		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'tmpAQpc' )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQpc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAQpc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpAQpc')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					nQuoted_Dim1 = 0
					IF USED('tmpAQpc')
						IF RECCOUNT('tmpAQpc')>0
							nQuoted_PC	= PrepareSQLnum(tmpAQpc.PC,'PC',-3)
							nQuoted_Dim1= PrepareSQLnum(tmpAQpc.Dim1,'Dim1',10,4)
							nQuoted_Dim2= PrepareSQLnum(tmpAQpc.Dim2,'Dim2',9,3)
							nQuoted_Dim3= PrepareSQLnum(tmpAQpc.Dim3,'Dim3',9,3)
							nQuoted_LBS	= PrepareSQLnum(tmpAQpc.Weight,'Weight',9,1)
							nQuoted_Qty	= PrepareSQLnum(tmpAQpc.Quoted_QTY,'Quoted_QTY',-5)
							nQuoted_LBS	= PrepareSQLnum(tmpAQpc.cWeight,'cWeight',-5)
							cQuoted_Form= PrepareSQLtxt(tmpAQpc.Form,'Form',2)
							IF cQuoted_Form = '80'
								nQuoted_LBS = PrepareSQLnum(tmpAQpc.DiskLBS,'DiskLBS',-5)
							ENDIF
						ENDIF
						USE IN tmpAQpc
					ENDIF
					
					*WAIT WINDOW cSOitem NOWAIT
					
					IF (Proper_SO_Item(cSOitem) != Proper_SO_Item('') OR nWO > 0 ) 
						*get Sales_Detail_ID
						
						cSQLi = "EXEC dbo.p_Sales_Detail_ins @SOitem='"+cSOitem+"', @WO="+STR(nWO)
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpSales_Detail_ID')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpSales_Detail_ID')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpSales_Detail_ID")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpSales_Detail_ID")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							IF NOT SQLEXECError(cSQLi,ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_Detail_ID')
								RecordError(nSQLEXEC,"SQL Error" ,"Proc_StockLst:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO(),cSQL )
								TrackError("Could not EXEC dbo.p_Sales_Detail_ins","p_Sales_Detail_ins","Proc_StockLst:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1),LINENO())
							ELSE
								nSQLEXEC = 1
							ENDIF
						ENDIF
						IF nSQLEXEC > 0
							IF USED("tmpSales_Detail_ID")
								nSales_Detail_ID = PrepareSQLnum(tmpSales_Detail_ID.Exp,'Sales_Detail_ID',-3)
								USE IN tmpSales_Detail_ID
							ENDIF
						ENDIF
						*****************
						
						IF nSales_Detail_ID > 0
							*Update
							PRIVATE cSQLid
							cSQLid = "UPDATE dbo.Sales_Detail SET "
							cSQLid = cSQLid+ " SOitem='"+cSOitem+"'"
							cSQLid = cSQLid+ ",SalesNum="+STR(nSalesNum) 
							*cSQLid = cSQLid+ ",Invoice="
							cSQLid = cSQLid+ ",WO="+STR(nWO)
							
							cSQLid = cSQLid+ ",Quoted_PC="+STR(nQuoted_PC,10,0)	&&Quoted_PC
							cSQLid = cSQLid+ ",Quoted_Dim1="+STR(nQuoted_Dim1,10,4)	&&Quoted_Dim1
							cSQLid = cSQLid+ ",Quoted_Dim2="+STR(nQuoted_Dim2,9,3)	&&Quoted_Dim2
							cSQLid = cSQLid+ ",Quoted_LBS="+STR(nQuoted_LBS,9,1)	&&Quoted_LBS
							cSQLid = cSQLid+ ",Quoted_Qty="+STR(nQuoted_Qty,18,4)	&&Quoted_Qty
		
							cSQLid = cSQLid+ ",StockLst_Qty="+STR(nNewStk_QTY,18,4)	&&StockLst_Qty
							cSQLid = cSQLid+ ",StockLst_P="+STR(nStockLst_P,18,4)		&&StockLst_P
							cSQLid = cSQLid+ ",StockLst_Total="+STR(nStockLst_Total,18,4)	&&StockLst_Total
							cSQLid = cSQLid+ ",StockLst_PU="+STR(nStockLst_PU)			&&StockLst_PU
		
							
							cSQLid = cSQLid+ ",StockLst_PC="+STR(nNewStk_PC,10)		&&StockLst_PC
							cSQLid = cSQLid+ ",StockLst_Dim1="+STR(nNewStk_Dim1,10,4)	&&StockLst_Dim1
							cSQLid = cSQLid+ ",StockLst_Dim2="+STR(nNewStk_Dim2,9,3)	&&StockLst_Dim2
							cSQLid = cSQLid+ ",StockLst_Dim3="+STR(nNewStk_Dim3,9,3)	&&StockLst_Dim3
						    cSQLid = cSQLid+ ",StockLst_LBS="+STR(nNewStk_LBS,9,1)	&&StockLst_LBS
		
							cSQLid = cSQLid+ ",Alloy='"+cAlloy+"'"
							cSQLid = cSQLid+ ",Form='"+cForm+"'"
							cSQLid = cSQLid+ ",Heat='"+cHeat+"'"
							cSQLid = cSQLid+ ",Lot='"+cLot+"'"
						    cSQLid = cSQLid+ ",CC='"+cCC+"'"
						    cSQLid = cSQLid+ ",CL='"+cCL+"'"
		
							cSQLid = cSQLid+ ",TBL='"+IIF(cTBL="S","S",IIF(cTBL="B","B","W"))+"'"
							cSQLid = cSQLid+ ",StockLst_ID="+STR(nID)
							cSQLid = cSQLid+ ",StockLst_ID_Detail="+STR(nID_Detail)
							cSQLid = cSQLid+ ",ID_Detail_Process="+STR(nID_Detail_Process)
							cSQLid = cSQLid+ ",ID_Sales_Stock="+STR(nSales_Stock_ID)
						    *cSQLid = cSQLid+ ",StockEdit=GetDate()"
						    cSQLid = cSQLid + ",StockEdit='"+TTOC(dtGetDate)+"'"
						    
							cSQLid = cSQLid+ ",StkPaid_P="+STR(nStkPaid_P,18,4)
							cSQLid = cSQLid+ ",StkPaid_Total="+STR(nStkPaid_Total,18,4)
							cSQLid = cSQLid+ ",UserEdit='"+cUserEdit+"'"
							cSQLid = cSQLid+ " WHERE ID="+STR(nSales_Detail_ID )
							
						ELSE
							*insert
							PRIVATE cSQLid
							cSQLid = "INSERT INTO dbo.Sales_Detail ("
							cSQLid = cSQLid+ " SOitem"   
							cSQLid = cSQLid+ ",SalesNum"
							*cSQLid = cSQLid+ ",Invoice"
							cSQLid = cSQLid+ ",WO"
							
							cSQLid = cSQLid+ ",Quoted_PC"
							cSQLid = cSQLid+ ",Quoted_Dim1"
							cSQLid = cSQLid+ ",Quoted_Dim2"
							cSQLid = cSQLid+ ",Quoted_LBS"
							cSQLid = cSQLid+ ",Quoted_Qty"
							
							cSQLid = cSQLid+ ",StockLst_Qty"
							cSQLid = cSQLid+ ",StockLst_P"
							cSQLid = cSQLid+ ",StockLst_Total"
							cSQLid = cSQLid+ ",StockLst_PU"
							
							cSQLid = cSQLid+ ",StockLst_PC"
							cSQLid = cSQLid+ ",StockLst_Dim1"
							cSQLid = cSQLid+ ",StockLst_Dim2"
							cSQLid = cSQLid+ ",StockLst_Dim3"
						    cSQLid = cSQLid+ ",StockLst_LBS"
		
							cSQLid = cSQLid+ ",Alloy"
							cSQLid = cSQLid+ ",Form"
							cSQLid = cSQLid+ ",Heat"
							cSQLid = cSQLid+ ",Lot"
						    cSQLid = cSQLid+ ",CC"
						    cSQLid = cSQLid+ ",CL"
		
							cSQLid = cSQLid+ ",TBL"
							cSQLid = cSQLid+ ",StockLst_ID"
							cSQLid = cSQLid+ ",StockLst_ID_Detail"
							cSQLid = cSQLid+ ",ID_Detail_Process"
							cSQLid = cSQLid+ ",ID_Sales_Stock"
						    cSQLid = cSQLid+ ",StockEdit"
						    
							cSQLid = cSQLid+ ",StkPaid_P"
							cSQLid = cSQLid+ ",StkPaid_Total"
							cSQLid = cSQLid+ ",UserEdit"
		
							cSQLid = cSQLid+ ") VALUES ("
							cSQLid = cSQLid+ "'"+cSOitem+"'"
							cSQLid = cSQLid+ ","+STR(nSalesNum) 
							*cSQLid = cSQLid+ ","+STR(nInvoice)
							cSQLid = cSQLid+ ","+STR(nWO)
							
							cSQLid = cSQLid+ ","+STR(nQuoted_PC,10,0)	&&Quoted_PC
							cSQLid = cSQLid+ ","+STR(nQuoted_Dim1,10,4)	&&Quoted_Dim1
							cSQLid = cSQLid+ ","+STR(nQuoted_Dim2,9,3)	&&Quoted_Dim2
							cSQLid = cSQLid+ ","+STR(nQuoted_LBS,9,1)	&&Quoted_LBS
							cSQLid = cSQLid+ ","+STR(nQuoted_Qty,18,4)	&&Quoted_Qty
		
							cSQLid = cSQLid+ ","+STR(nNewStk_QTY,18,4)	&&StockLst_Qty
							cSQLid = cSQLid+ ","+STR(nStockLst_P,18,4)		&&StockLst_P
							cSQLid = cSQLid+ ","+STR(nStockLst_Total,18,4)	&&StockLst_Total
							cSQLid = cSQLid+ ","+STR(nStockLst_PU)			&&StockLst_PU
		
							cSQLid = cSQLid+ ","+STR(nNewStk_PC,10)		&&StockLst_PC
							cSQLid = cSQLid+ ","+STR(nNewStk_Dim1,10,4)	&&StockLst_Dim1
							cSQLid = cSQLid+ ","+STR(nNewStk_Dim2,9,3)	&&StockLst_Dim2
							cSQLid = cSQLid+ ","+STR(nNewStk_Dim3,9,3)	&&StockLst_Dim3
						    cSQLid = cSQLid+ ","+STR(nNewStk_LBS,9,1)	&&StockLst_LBS
		
							cSQLid = cSQLid+ ",'"+cAlloy+"'"
							cSQLid = cSQLid+ ",'"+cForm+"'"
							cSQLid = cSQLid+ ",'"+cHeat+"'"
							cSQLid = cSQLid+ ",'"+cLot+"'"
						    cSQLid = cSQLid+ ",'"+cCC+"'"
						    cSQLid = cSQLid+ ",'"+cCL+"'"
						    
							cSQLid = cSQLid+ ",'"+IIF(cTBL="S","S",IIF(cTBL="B","B","W"))+"'"
							cSQLid = cSQLid+ ","+STR(nID)
							cSQLid = cSQLid+ ","+STR(nID_Detail)
							cSQLid = cSQLid+ ","+STR(nID_Detail_Process)
							cSQLid = cSQLid+ ","+STR(nSales_Stock_ID)
						    *cSQLid = cSQLid+ ",GetDate()" &&StockEdit
						    cSQLid = cSQLid + ",'"+TTOC(dtGetDate)+"'"
						    		
							cSQLid = cSQLid+ ","+STR(nStkPaid_P,18,4)
							cSQLid = cSQLid+ ","+STR(nStkPaid_Total,18,4)
							cSQLid = cSQLid+ ",'"+cUserEdit+"'"
							
							cSQLid = cSQLid+ ")"
							
						ENDIF
						IF nOrig_Dim1 = 0 &&run check here to fill cSQLid.
							IF lScrap
								TrackError("Not saved to dbo.Sales_Detail. "+CHR(13)+cSQLid,"No Orig_Dim1 value --Scrap.",PROGRAM(),LINENO(1))
							ELSE
								TrackError("Not saved to dbo.Sales_Detail. "+CHR(13)+IIF(lConsumed,"Detail was Consumed!"+CHR(13),"")+cSQLid,"No Orig_Dim1 value.",PROGRAM(),LINENO(1))
							ENDIF
						ELSE
		
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid  )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid  )
								ENDDO
							ENDIF
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF
							IF nSQLEXEC < 0
								SQLEXECError(cSQLid, ThisForm.nConnHandle,nSQLEXEC)
								RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLid )
								*lOK = .F.
							ENDIF
							
						ENDIF
						
					ENDIF
				ENDIF
				
				*nSales_Detail_ID 
				
				IF ThisForm.nWO > 0 AND nSales_Detail_ID > 0
					PRIVATE lOutSource
					lOutSource = is_WO(ThisForm.nWO,ThisForm.nConnhandle,'OutSource')
					
					IF lOutSource 	
						*Update OutSource
						cSQL = "UPDATE dbo.WO_OutSource "
						cSQL = cSQL + " SET Sales_Detail_ID ="+STR(nSales_Detail_ID)
						cSQL = cSQL + " WHERE "
				      	cSQL = cSQL + " Stock_TBL='"+cTBL+"'"
				      	cSQL = cSQL + " AND Stock_ID="+STR(nID)
				      	cSQL = cSQL + " AND Stock_ID_D="+STR(nID_Detail)
				      	cSQL = cSQL + " AND Stock_ID_D_P="+STR(nID_Detail_Process)
				      	cSQL = cSQL + " AND	Stock_QTY="+STR(nStockLst_QTY)
				      	cSQL = cSQL + " AND	Stock_PU="+STR(nStockLst_PU)
				      	*cSQL = cSQL + " AND StockEdit='"+TTOC(dtGetDate)+"'"
				      	cSQL = cSQL + " AND StockEdit='"+TTO_SQL_C(dtGetDate)+"'"
				      	cSQL = cSQL + " AND Sales_Detail_ID = 0 "
				      	
				      	nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC)
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL)
							*lOK = .F.
						ENDIF
						
				   ENDIF
				ENDIF  
				
				
			ENDSCAN
			ThisForm.txtRecNo3.Value	= RECNO('tmpStkSum')
			
		ENDIF
		
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE savestocklstedit_to_sales_stock
		PARAMETERS cSOitem,nID,nID_Detail,nID_Detail_Process,cTBL,nQTY_NEW,nPC_NEW,nDim1_NEW,nDim2_NEW,nDim3_NEW,lRandLen,cWhat
		*SaveStockLstEdit_to_Sales_Stock()
		
		IF VARTYPE(nID) != "N"
			TrackError( "Bad Parameter", "nID", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		IF VARTYPE(cWhat) != "C"
			TrackError( "Bad Parameter", "cWhat", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		PRIVATE nID, nID_Detail_Process
		nID					= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3,0)
		PRIVATE nWO, nWO_Detail, cUserEdit
		nWO		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3,0)
		nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3)
		cUserEdit	= PrepareSQLtxt(ThisForm.edtUserEdit.Value,'UserEdit',-1)
		
		PRIVATE cSOitem,cPOitem,cTBL,nID_Detail
		cSOitem	= ThisForm.cSOitem
		cPOitem = ThisForm.cPOitem
		cTBL	= ThisForm.cTBL
		nID_Detail = ThisForm.nID_Detail
		
		nQTY_NEW	= PrepareSQLnum(nQTY_NEW,'QTY',18,4) &&*Use negative QTY to reverse the remove
		nPC_NEW		= PrepareSQLnum(nPC_NEW,'PC',-3)
		nDim1_NEW	= PrepareSQLnum(nDim1_NEW,'Dim1',18,4)
		nDim2_NEW	= PrepareSQLnum(nDim2_NEW,'Dim2',17,3)
		nDim3_NEW	= PrepareSQLnum(nDim3_NEW,'Dim3',17,3)
		
		*****************************
		*Get current Stock Master: Data alloy,Form,Heat,Lot,CC,CL
		PRIVATE lOK
		lOK = .T.
		
		IF USED('tmpAlloyFormCC')
			USE IN tmpAlloyFormCC
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "SELECT M.Alloy,M.Form,M.Heat,M.Lot,M.CC,M.CL,M.Paid "
		IF UPPER(cTbl) = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Master M  WITH(NOLOCK)"
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D WITH(NOLOCK) ON D.ID = m.ID "
		ELSE
			cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK)"
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D WITH(NOLOCK) ON D.ID = m.ID "
		ENDIF
		cSQL = cSQL + " WHERE D.ID_Detail = "+ALLTRIM(STR(nID_Detail))
			
		PRIVATE cAlloy, cForm, cHeat, cLot, cCC, cCL, lRandLen
		cAlloy	= ''
		cForm	= ''
		cHeat	= ''
		cLot	= ''
		cCC		= ''
		cCL		= ''
		lRandLen = .F.
		
		PRIVATE nStkPaid_P, nStkPaid_Total, nMasterPaid
		nStkPaid_P = 0
		nStkPaid_Total = 0
		nMasterPaid = 0
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloyFormCC')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyFormCC")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpAlloyFormCC")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpAlloyFormCC')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpAlloyFormCC')
				IF RECCOUNT("tmpAlloyFormCC") > 0
					cAlloy	= tmpAlloyFormCC.Alloy
					cForm	= PrepareSQLtxt(tmpAlloyFormCC.Form,'form',2)
					cHeat	= PrepareSQLtxt(tmpAlloyFormCC.Heat,'Heat',50)
					cLot	= PrepareSQLtxt(tmpAlloyFormCC.Lot,'Lot',10)
					cCC		= tmpAlloyFormCC.CC
					cCL		= tmpAlloyFormCC.CL
					nStkPaid_P 	= PrepareSQLnum(tmpAlloyFormCC.Paid,'Paid',-5)
					IF cLot =  '0         '
						cLot = ''
					ENDIF
				ENDIF
				USE IN tmpAlloyFormCC
			ENDIF
		ENDIF
		
		*****************************************************
		PRIVATE nStockLst_Qty,nStockLst_P,nStockLst_Total,nStockLst_PU
		nStockLst_Qty	= PrepareSQLnum( ThisForm.txtQTY.Value,'StockLst_Qty',18,4)
		IF nStockLst_Qty = 0
			nStockLst_Qty	= PrepareSQLnum( ThisForm.txtS_QTY.Value,'StockLst_Qty',18,4)
		ENDIF
		
		nStockLst_P		= PrepareSQLnum( ThisForm.txtS_P.Value,'StockLst_P',18,4) &&current Price per unit
		
		* - removed BS code on 11/01/2019, never to mix CostValue with _P again.
		*!*	PRIVATE nStock_Price
		*!*	IF nStockLst_P = 0
		*!*		nStock_Price		= PrepareSQLnum( ThisForm.txtCostValue.Value,'CostValue',18,4) &&CostValue - depricated
		*!*		IF nStock_Price > 0
		*!*			nStockLst_P = nStock_Price 
		*!*			ThisForm.txtS_P.Value = nStock_Price 
		*!*		ENDIF
		*!*	ENDIF
		
		nStockLst_Total	= nStockLst_Qty * nStockLst_P
		
		nStockLst_PU	= PrepareSQLnum(ThisForm.txtS_PU.Value,'S_PU',-1)
		IF nStockLst_PU = 0
			IF NOT EMPTY(cForm)
				nStockLst_PU	= getPUfromForm( cForm, ThisForm.nConnHandle )
			ENDIF
		ENDIF
		
		****************************
		PRIVATE nSigDim  &&0 Pc, 1 QTY, 2 Dim2, 3 Dim3, 4-,5-, 6 dim2*3
		nSigDim = getSigDim(cForm,ThisForm.nConnHandle)
		PRIVATE nStockLst_LBS
		nStockLst_LBS = 0
		
		PRIVATE nStkBack
		nStkBack = 0
		
		*****************************************************
		*PRIVATE nStk_PC,nStk_Dim1,nStk_Dim2,nStk_Dim3,nStk_QTY,nStk_LBS
		*nStk_PC		= PrepareSQLnum( ThisForm.txtPC.Value,'Pc',-3)
		*nStk_Dim1	= PrepareSQLnum( ThisForm.txtDim1.Value,'Dim1',18,4)
		*nStk_Dim2	= PrepareSQLnum( ThisForm.txtDim2.Value,'Dim2',17,3)
		*nStk_Dim3	= PrepareSQLnum( ThisForm.txtDim3.Value,'Dim3',17,3)
		*nStk_QTY	= 0
		*nStk_LBS	= 0
		
		*****************************************************
		*WAIT WINDOW cSOitem NOWAIT
		IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
			*Check Alloy in selected Stock to Quote SOitem
			PRIVATE cQAlloy, cQForm, cQCC, cQCL, nQDim1
			cQAlloy	= ''
			cQForm	= ''
			cQCC	= ''
			cQCL	= ''
			nQDim1	= 0
		
			cSQL = "SELECT Alloy,Form,CC,CL,Thck,Sz2,Sz3 "
			cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQAlloyFormCC')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQAlloyFormCC")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQAlloyFormCC")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpQAlloyFormCC')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				IF USED('tmpQAlloyFormCC')
					IF RECCOUNT("tmpQAlloyFormCC") > 0
						cQAlloy	= tmpQAlloyFormCC.Alloy
						cQForm	= PrepareSQLtxt(tmpQAlloyFormCC.Form,'Form',2)
						cQCC	= tmpQAlloyFormCC.CC
						cQCL	= tmpQAlloyFormCC.CL
						nQDim1	= tmpQAlloyFormCC.Thck
						
						&&See save code in SaveStockLstEdit_to_Sales_Stock()
						PRIVATE cMess				
						*reportConsumed_Ordered
						IF cQAlloy != cAlloy
							cMess = "Consumed Stock does not match Sales Order:"+cSOitem+CHR(13)
							cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
							cMess = cMess + " Form Picked:"+cForm+"  Ordered:"+cQForm+CHR(13)
							cMess = cMess + " Condition Code Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
							cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
							cMess = cMess + " Not Allowed to SAVE:Alloy"+CHR(13)
							
							cMess = cMess + " TBL="+cTBL+" ID_Detail="+ALLTRIM(STR(nID_Detail))+"."+CHR(13)
							
							TrackMess(LEFT(cMess,254))
							TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
							RecordTest('Record Test Data.', PROGRAM(), LINENO(1), cMess+CHR(13)+cSQL)
							MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE Alloy")
							lOK =.F.
						ENDIF
		
						IF cForm = '40' AND tmpQAlloyFormCC.Form = '80' 
							*Normally Form 80 is from Plate, but can be from bar!!!
							cQForm	= cForm
						ENDIF
						IF cForm = '10' AND tmpQAlloyFormCC.Form = '80' 
							cQForm	= cForm
						ENDIF
						
						IF cQForm != cForm AND lOK =.T.
							cMess = "Consumed Stock does not match Sales Order:"+cSOitem+CHR(13)
							cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
							cMess = cMess + " Form Picked:"+cForm+"  Ordered:"+cQForm+CHR(13)
							cMess = cMess + " Condition Code Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
							cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
							
							cMess = cMess + " TBL="+cTBL+" ID_Detail="+ALLTRIM(STR(nID_Detail))+"."+CHR(13)
							
							IF CheckSOforProduction(cSOitem,ThisForm.nConnHandle)
								*Production is allowed to change product form.
							ELSE
								IF NOT (cQForm = '0' OR cQForm = '21' OR cQForm = '22' OR cQForm = '51' OR cQForm = '52' OR cQForm = '53' OR cQForm = '80' OR  cQForm = '90' OR cQForm = '95' OR cQForm = '96' OR cQForm = '97' OR cQForm = '98' OR cQForm = '99' )	
									cMess = cMess + " Allowed to SAVE:Form"+CHR(13)
									TrackMess(LEFT(cMess,254))
									TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
									RecordTest('Record Test Data.',PROGRAM(),LINENO(1),"Consumed Stock does not match Sales Order "+CHR(13)+cMess+CHR(13)+cSQL)
									MESSAGEBOX(cMess,16,"Allowed to SAVE:Form")
									lOK =.T.
								ELSE
									cMess = cMess + " Allowed to SAVE:Form"+CHR(13)
									TrackMess(LEFT(cMess,254))
									*TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
									*MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE!")
									*lOK =.F.				
									TrackError(cMess+CHR(13)+cSQL,"Consumed Stock does not match Sales Order",PROGRAM(),LINENO(1))
									RecordTest('Record Test Data.',PROGRAM(),LINENO(1),"Consumed Stock does not match Sales Order "+CHR(13)+cMess+CHR(13)+cSQL)
									MESSAGEBOX(cMess,16,"Allowed to SAVE!")
									lOK =.T.	
		
								ENDIF				
							ENDIF
						ENDIF
					ENDIF
					
					USE IN tmpQAlloyFormCC
					
					IF NOT lOK
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****************************************************
		*PRIVATE nStkPaid_P
		IF nStkPaid_P = 0
			nStkPaid_P = getInvoiceValue_ID_Detail( nID_Detail,cTBL,ThisForm.nConnHandle )
		ENDIF
		
		
		*******************
		*Check tmpStkSum
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpStkSum') < 1
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		
		*******************
		
		*Get current Stock Detail
		PRIVATE nStockLst_P
		nStockLst_P = 0
		PRIVATE nPU_OLD,nPc_Old,nDim1_OLD,nDim2_OLD,nDim3_OLD,nQTY_OLD,nS_P,nStockLst_PU
		nPU_OLD		= 0
		nPc_Old		= 0
		nDim1_OLD	= 0
		nDim2_OLD	= 0
		nDim3_OLD	= 0
		nQTY_OLD	= 0
		nS_P		= 0
		nStockLst_PU= 0
		PRIVATE nPC_DIF, nDim1_DIF, nDim2_DIF, nDim3_DIF, nWeight_DIF
		nPc_DIF 	= 0
		nDim1_DIF	= 0
		nDim2_DIF 	= 0
		nDim3_DIF	= 0
		nWeight_DIF	= 0
		
		*	nStkBack = 0
		
		IF USED("tmpStkOrig")
			USE IN tmpStkOrig
		ENDIF
		SELECT 0
		IF UPPER(cTbl) = "S"
			cSQL = "SELECT PC,Dim1,Dim2,Dim3,Weight,S_QTY,S_P,S_PU,InvoiceValue"
			cSQL = cSQL + " ,StockLst_Master.Paid " 
			cSQL = cSQL + " FROM dbo.StockLst_Detail WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master WITH(NOLOCK) ON StockLst_Detail.ID = StockLst_Master.ID "
			cSQL = cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		ELSE
			cSQL = "SELECT PC,Dim1,Dim2,Dim3,Weight,S_QTY,S_P,S_PU,InvoiceValue"
			cSQL = cSQL + " ,BrokerLst_Master.Paid "
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail WITH(NOLOCK) "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master WITH(NOLOCK) ON BrokerLst_Detail.ID = BrokerLst_Master.ID "
			cSQL = cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkOrig' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkOrig' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkOrig')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStkOrig')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkOrig")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStkOrig")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle ,nSQLEXEC, 'tmpStkOrig')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpStkOrig')
				IF RECCOUNT("tmpStkOrig") > 0
					
					nStockLst_P			= PrepareSQLnum( tmpStkOrig.S_P,'S_P',-5)
					nPU_OLD 			= getPUfromForm( cForm,ThisForm.nConnHandle )
					nPc_OLD				= PrepareSQLnum( tmpStkOrig.Pc,'Pc',-3)
					nDim1_OLD			= PrepareSQLnum( tmpStkOrig.Dim1,'Dim1',-5)
					nDim2_OLD			= PrepareSQLnum( tmpStkOrig.Dim2,'Dim2',17,3)
					nDim3_OLD			= PrepareSQLnum( tmpStkOrig.Dim3,'Dim3',17,3)
					nQTY_OLD			= PrepareSQLnum( tmpStkOrig.S_QTY,'S_QTY',-5)
					nS_P				= PrepareSQLnum( tmpStkOrig.S_P,'S_P',-5)
					nStockLst_PU		= PrepareSQLnum( tmpStkOrig.S_PU,'S_PU',-1)
					nStkPaid_P			= PrepareSQLnum( tmpStkOrig.InvoiceValue,'InvoiceValue',-5)
					nMasterPaid			= PrepareSQLnum( tmpStkOrig.Paid,'Paid',-5)
					
					IF nStkPaid_P = 0
						nStkPaid_P = nMasterPaid
					ENDIF
					
					nPc_DIF			= nPc_OLD   - nPc_NEW
					nQTY_DIFF		= nQTY_OLD  - nQTY_NEW
					
					DO CASE
					*Can Dim1 be changed, ex fasteners can only change Pc
					*nDim1_DIF		= nDim1_OLD - nDim1_NEW
					CASE nSigDim = 0
						*PC/ Item/ bolt
						nDim2_DIF	= 0
						nDim3_DIF	= 0
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= nStkPaid_P * nPc_DIF &&nStkPaid_P, nStkPaid_Total
					CASE nSigDim = 1
						nDim2_DIF	= 0
						nDim3_DIF	= 0
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= nStkPaid_P * nPc_DIF
					CASE nSigDim = 2
						*Bar
						nDim2_DIF	= nDim2_OLD - nDim2_NEW
						nDim3_DIF	= 0
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= nStkPaid_P * nStockLst_LBS
					CASE nSigDim = 3
						*Flat bar/ Pipe
						nDim2_DIF 	= 0
						nDim3_DIF	= nDim3_OLD - nDim3_NEW
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_OLD, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_OLD, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= IIF(nDim3_DIF < .1, 0, nStkPaid_P * nDim3_DIF / 12)
					CASE nSigDim = 6
						*Plate/ Sheet
						nDim2_DIF	= nDim2_OLD - nDim2_NEW
						nDim3_DIF	= nDim3_OLD - nDim3_NEW
						*nStockLst_LBS	= CalcWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStockLst_LBS	= GetWeight(nPc_DIF, cAlloy, cForm, nDim1_OLD, nDim2_DIF, nDim3_DIF, ThisForm.nConnHandle)
						nStkPaid_Total	= nStkPaid_P * nStockLst_LBS
					ENDCASE
					
					lOK = .T.
				ENDIF
				USE IN tmpStkOrig
			ENDIF
		ENDIF
		
		PRIVATE nRDS_Paid_Total 
		nRDS_Paid_Total = 0
		
		*******************
		*Check tmpStkSum
		IF NOT USED('tmpStkSum')
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		IF RECCOUNT('tmpStkSum') < 1
			MESSAGEBOX("Please Enter each item removed from this Detail record",16,"Need a Remove Summary")
			RETURN .F.
		ENDIF
		
		**************************************************************************************************************************************
		*  dbo.Sales_Stock
		**************************************************************************************************************************************
		
		PRIVATE cSQLid, nSales_Stock_ID
		PRIVATE nRemoved_PC,nRemoved_Dim1,nRemoved_Dim2,nRemoved_Dim3,nRemoved_Qty,nRemoved_LBS,nRemoved_Paid_Total,nRemoved_Total
		
		PRIVATE cMess, nMess, lUpdateSS
		cMess = ''
		nMess = 0
		lUpdateSS = .F.
		
		IF lOK
			SELECT tmpStkSum
			SCAN
			
				nRemoved_PC		= PrepareSQLnum(tmpStkSum.PCs,'PC',-3)
				nRemoved_Dim1	= PrepareSQLnum(tmpStkSum.Dim1,'Dim1',10,4)
				nRemoved_Dim2	= PrepareSQLnum(tmpStkSum.Dim2,'Dim2',9,4)
				nRemoved_Dim3	= PrepareSQLnum(tmpStkSum.Dim3,'Dim3',9,4)
				nRemoved_Qty	= PrepareSQLnum(tmpStkSum.QTY,'QTY',18,4)
				nRemoved_LBS	= PrepareSQLnum(tmpStkSum.Weight,'Weight',8,1)
				nRemoved_Paid_Total	= nRemoved_Qty * nStkPaid_P
				nRemoved_Total	= nRemoved_Qty * nStockLst_P
				nStockLst_Total = nRemoved_Qty * nStockLst_P
		
				
				**
				IF nRemoved_LBS = 0
					DO CASE
					CASE nStockLst_PU = 1
						nRemoved_LBS	= nRemoved_Qty
					CASE nStockLst_PU = 2
						*Calc /FT weight
					 	*nRemoved_LBS = CalcWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					 	nRemoved_LBS = GetWeight(nRemoved_PC, cAlloy, cForm, nRemoved_Dim1, nRemoved_Dim2, nRemoved_Dim3, ThisForm.nConnHandle)
					CASE nStockLst_PU = 3
						*Calc /PC Weight
					 	*nSale_LBS = GetWeight(nStk_PC, cAlloy, cForm, nStk_Dim1, nStk_Dim2, nStk_Dim3, ThisForm.nConnHandle)
					 	*No weight chart ready fasteners/fittings
						nRemoved_LBS	= nRemoved_PC
					OTHERWISE
						nRemoved_LBS= 0
					ENDCASE
				ENDIF
				**
				
				*******************
				*a SO can be shipped to the customer.  A WO modifying or Consuming Stock will not ship to a customer
				*Check for PackingSlip that was created before Shop Stock Edit!!
				PRIVATE cSQL, nSQLEXEC 
				*WAIT WINDOW cSOitem NOWAIT
				IF cSOitem = Proper_SO_item('')
					IF nWO = 0
						MESSAGEBOX("No WorkOrder or SOitem",16,"Error")
						TrackError("No WorkOrder or SOitem","No WorkOrder or SOitem",PROGRAM(),LINENO(1))
					ENDIF
				ELSE
					IF USED('tmpSales_StockP')
						USE IN tmpSales_StockP
					ENDIF
					SELECT 0
		
					cSQL = "SELECT PackingSli,PS_PC,PS_Form,PS_Dim1,PS_Dim2,PS_Dim3,PS_Lbs,WO,Heat,Lot "
					cSQL = cSQL + " ,StockLst_QTY,StockLst_P,StockLst_Total,StockLst_PC"
					cSQL = cSQL + " ,StockLst_Dim1,StockLst_Dim2,StockLst_Dim3,StockLst_LBS,ID "
					cSQL = cSQL + " FROM dbo.Sales_Stock WITH(NOLOCK) "
					cSQL = cSQL + " WHERE SOitem = '"+cSOitem+"'"
					cSQL = cSQL + " AND ISNULL(StockEdit,0) = 0"
					cSQL = cSQL + " AND ISNULL(PackingSli,0)>0 "
					cSQL = cSQL + " AND ISNULL(Removed_Qty,0) = 0"  &&No Removed QTY entered. Needs to be updated
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP' )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP' )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSales_StockP')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_StockP")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSales_StockP")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpSales_StockP')
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
						lOK =.F.
					ENDIF
		
		
					*SCAN tmpStkSum
					IF USED('tmpSales_StockP')
						IF RECCOUNT('tmpSales_StockP')>0
							*SCAN
							cMess = "Found similar in PackingSlip"+CHR(13)+"Could this have already been Shipped ?"+CHR(13)
							cMess = cMess + ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Dim1,'PS_Dim1',10,4),10,4))
							cMess = cMess + " X "+ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Dim2,'PS_Dim2',9,3),9,3))
							cMess = cMess + " X "+ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Dim3,'PS_Dim3',9,3),9,3))+CHR(13)
							
							cMess = cMess + " "+ALLTRIM( STR( PrepareSQLnum(tmpSales_StockP.PS_Lbs,'PS_Lbs',9,1),9,1))+"Lbs. "
							cMess = cMess + "  SOitem '"+cSOitem+"'"+CHR(13)
							cMess = cMess + " Heat: "+ALLTRIM( PrepareSQLtxt(tmpSales_StockP.Heat,'Heat',50) )
							IF NOT EMPTY(PrepareSQLtxt(tmpSales_StockP.Lot,'Lot',10))
								cMess = cMess + " Lot: "+ALLTRIM( PrepareSQLtxt(tmpSales_StockP.Lot,'Lot',10) )
							ENDIF
							
							nMess = MESSAGEBOX(cMess,4+32,"Update using this PackingSlip Data?")
							IF nMess = 6
								lUpdateSS = .T.
														
								*Get Master,Detail,Process for ID_Detail
								IF USED('tmpStk_QTY')
									USE IN tmpStk_QTY
								ENDIF
								
								SELECT 0
								
								cSQL = "SELECT S_QTY, S_P ,S_Total "
								cSQL = cSQL + ",PC,Dim1,Dim2,Dim3,[Weight]"
								cSQL = cSQL + ",D.ID, D.ID_Detail, M.Lot"
								cSQL = cSQL + ",ISNULL(P.PO_item,'') AS PO_item "
								cSQL = cSQL + ",ISNULL(P.ID_Detail_Process,0) AS ID_Detail_Process "
								DO CASE
								CASE cTBL = "S"
									cSQL = cSQL + ",'S' AS TBL, D.WO "
									cSQL = cSQL + " FROM dbo.StockLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.Stocklst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
								CASE cTBL = "B"
									cSQL = cSQL + ",'B' AS TBL, 0 AS WO "
									cSQL = cSQL + " FROM dbo.BrokerLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.Brokerlst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
								CASE cTBL = "W"
									cSQL = cSQL + ",'W' AS TBL, 0 AS WO "
									cSQL = cSQL + " FROM dbo.WIPLst_Master M WITH(NOLOCK) "
									cSQL = cSQL + " INNER JOIN dbo.WIPlst_Detail D WITH(NOLOCK) ON M.ID=D.ID "
									cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P WITH(NOLOCK) ON D.ID_Detail = P.ID_Detail "
								ENDCASE
								cSQL = cSQL + " WHERE D.ID_Detail="+STR(nID_Detail)
								cSQL = cSQL + " AND ( ISNULL(P.Process_ID,'SELECTED')='SELECTED' OR ISNULL(P.Process_ID,'')='PARTSELECT' )"
											
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY' )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY' )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY')
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY')
									ENDDO
								ENDIF
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStk_QTY")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStk_QTY")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF
								IF nSQLEXEC < 0
									SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, 'tmpStk_QTY')
									RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
									lOK =.F.
								ENDIF
		
								IF USED('tmpStk_QTY')
									IF RECCOUNT('tmpStk_QTY')>0
										*nID_Detail_Process = 0
										
										cSQL = "UPDATE dbo.Sales_Stock SET "
										cSQL = cSQL + " StockLst_LBS="+STR(PrepareSQLnum(tmpStk_QTY.S_QTY,'S_QTY',-5),18,4)
										cSQL = cSQL + ",StockLst_POitem ='"+PrepareSQLtxt(tmpStk_QTY.PO_item,'PO_item',12)+"'"					
		*								cSQL = cSQL + ",Edited,Added,Consumed,StockBack"
										cSQL = cSQL + ",StockEdit=GetDate()"
										cSQL = cSQL + ",TBL='"+tmpStk_QTY.TBL+"'"
										cSQL = cSQL + ",StockLst_ID="+STR(PrepareSQLnum(tmpStk_QTY.ID,'Master_ID',-3))
										cSQL = cSQL + ",StockLst_ID_Detail="+STR(PrepareSQLnum(tmpStk_QTY.ID_Detail,'D_Detail',-3))
										cSQL = cSQL + ",ID_Detail_Process="+STR(PrepareSQLnum(tmpStk_QTY.ID_Detail_Process,'ID_Detail_Process',-3))
										
										cSQL = cSQL + ",Lot='"+PrepareSQLtxt(tmpStk_Qty.Lot,'Lot',10)+"'"
										
			*							cSQL = cSQL + ",Orig_PC="+STR(PrepareSQLnum(tmpStk_QTY.PC,'PC',10),10)
			*							cSQL = cSQL + ",Orig_Dim1="+STR(PrepareSQLnum(tmpStk_QTY.Dim1,'Dim1',10,4),10,4)
			*							cSQL = cSQL + ",Orig_Dim2="+STR(PrepareSQLnum(tmpStk_QTY.Dim2,'Dim2',9,3),9,3)
			*							cSQL = cSQL + ",Orig_Dim3="+STR(PrepareSQLnum(tmpStk_QTY.Dim3,'Dim3',9,3),9,3)
			*							cSQL = cSQL + ",Orig_LBS="+STR(PrepareSQLnum(tmpStk_QTY.Weight,'Weight',9,1),9,1)
		
										cSQL = cSQL + ",Left_PC=0"		&&+STR(PrepareSQLnum(tmpStk_QTY.PC,'PC',10),10)
										cSQL = cSQL + ",Left_Dim1=0"	&&+STR(PrepareSQLnum(tmpStk_QTY.Dim1,'Dim1',10,4),10,4)
										cSQL = cSQL + ",Left_Dim2=0"	&&+STR(PrepareSQLnum(tmpStk_QTY.Dim2,'Dim2',9,3),9,3)
										cSQL = cSQL + ",Left_Dim3=0"	&&+STR(PrepareSQLnum(tmpStk_QTY.Dim3,'Dim3',9,3),9,3)
										cSQL = cSQL + ",Left_LBS=0"		&&+STR(PrepareSQLnum(tmpStk_QTY.Weight,'Weight',9,1),9,1)
										cSQL = cSQL + ",Left_QTY=0"		&&+STR(PrepareSQLnum(tmpStk_QTY.S_QTY,'QTY',-5),18,4)
										
										cSQL = cSQL + ",StkPaid_P="+STR(PrepareSQLnum(tmpStk_QTY.S_P,'S_P',-5),18,4)
										cSQL = cSQL + ",StkPaid_Total="+STR(PrepareSQLnum(tmpStk_QTY.S_Total,'S_Total',-5),18,4)
										
										cSQL = cSQL + ",WO="+STR(PrepareSQLnum(tmpStk_QTY.WO,'WO',-3))
										*cSQL = cSQL + ",UserEdit='"+cUserEdit+"'"
										cSQL = cSQL + " WHERE ID = "+STR(PrepareSQLnum(tmpSales_StockP.ID,'ID',-3))
										
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL' TIMEOUT 1
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
										ENDDO
										IF nSQLEXEC < 0 &&Try again!
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL 2' TIMEOUT 1
												nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
											ENDDO
										ENDIF
										IF nSQLEXEC < 0 &&Try again!
											nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL 2' TIMEOUT 1
												nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
												
												IF nSQLEXEC < 0
													IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
														nSQLEXEC = 0
													ENDIF
												ENDIF
											ENDDO
										ENDIF
										IF nSQLEXEC < 0
											SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC, '')
											RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
											lOK =.F.
										ENDIF
		
									ENDIF
									USE IN tmpStk_QTY
								ENDIF
							ENDIF				
							
						ENDIF
					ENDIF
					USE IN 'tmpSales_StockP'
				ENDIF
				******************************************************
		
				nSales_Stock_ID = Check_PS_Entry(cSOitem,nWO,ThisForm.nConnHandle)
				
				*******************
				*Get Orig Dims
				PRIVATE nOrig_PC, nOrig_Dim1, nOrig_Dim2, nOrig_Dim3, nOrig_QTY, nOrig_LBS
				nOrig_PC	= 0
				nOrig_Dim1	= 0
				nOrig_Dim2	= 0
				nOrig_Dim3	= 0
				nOrig_QTY	= 0
				nOrig_LBS	= 0
				
				cSQL = "SELECT PC, Dim1, Dim2, Dim3, S_QTY AS [QTY], S_QTY AS [LBS] "
				DO CASE
				CASE cTbl = "S"
					cSQL = cSQL + " FROM dbo.StockLst_Detail WITH(NOLOCK) "
				CASE cTBL = "B"
					cSQL = cSQL + " FROM dbo.BrokerLst_Detail WITH(NOLOCK) "
				CASE cTBL = "W"
					cSQL = cSQL + " FROM dbo.WIPLst_Detail WITH(NOLOCK) "
				ENDCASE
				cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
					
				IF USED('tmpStk_QTY')
					USE IN tmpStk_QTY
				ENDIF
					
				SELECT 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStk_QTY' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
