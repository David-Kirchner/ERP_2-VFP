	PROCEDURE consumeqty
		PARAMETERS pWhat
		*ThisForm.ConsumeQTY()
		pWhat = PrepareSQLtxt(pWhat,'What',10)
		
		PRIVATE nDetail_PC, nDetail_Weight, nDetail_QTY
		nDetail_PC	= 0
		nDetail_Weight = 0
		nDetail_QTY = 0
		PRIVATE nQTYLeft, nWeightLeft, nPCLeft
		nQTYLeft = 0
		nWeightLeft = 0
		nPCLeft = 0
		PRIVATE nProcessPCs, nProcessPU, nProcessQTY, nProcessPounds, nProcessO_QTY
		nProcessPCs = 0
		nProcessPU = 0
		nProcessQTY = 0
		nProcessO_QTY = 0
		nProcessPounds = 0
		PRIVATE cProcessForm, nProcessDim2, nProcessDim3
		cProcessForm	= ''
		nProcessDim2	= 0
		nProcessDim3	= 0
		
		PRIVATE lAllowSub
		lAllowSub = .F.
		
		PRIVATE cTbl
		cTbl = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		
		PRIVATE nID, nID_Detail, nID_Detail_Process
		nID					= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail			= PrepareSQLnum(THISFORM.txtID_Detail.VALUE,'ID_Detail',-3,0)
		nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3,0)
		
		PRIVATE cSOitem, nWO, nWO_Detail, cUserEdit
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		*WAIT WINDOW cSOitem NOWAIT
		cSOitem	= Proper_SO_Item(cSOItem)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		nWO_Detail	= PrepareSQLnum(ThisForm.nWO_Detail,'WO_Detail',-3)
		cUserEdit	= PrepareSQLtxt(ThisForm.edtUserEdit.Value,'UserEdit',-1)
		
		IF nID = 0
			TrackError("No ID "+STR(13)+"pWhat= "+pWhat,"No ID",PROGRAM(),LINENO(0))
			RETURN .F.
		ENDIF
		IF nID_Detail = 0
			TrackError("No ID_Detail "+STR(13)+"pWhat= "+pWhat,"No ID_Detail",PROGRAM(),LINENO(0))
			RETURN .F.
		ENDIF
		IF nID_Detail_Process = 0
			TrackError("No ID_Detail_Process "+STR(13)+"pWhat= "+pWhat,"No ID_Detail_Process",PROGRAM(),LINENO(0))
			RETURN .F.
		ENDIF
		
		**********************************
		*Get Thck with SOitem  
		
		IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
			*Does Dim1 match?
			PRIVATE nCurrDim1, nSOiDim1
			nCurrDim1 = PrepareSQLnum(ThisForm.txtDim11.Value,'Dim1',10,4)
			nSOiDim1 = 0
		
			IF USED('tmpSO_Dim1')
				USE IN tmpSO_Dim1
			ENDIF
			SELECT 0
			cSQL = "SELECT Thck FROM dbo.AllQuotes WITH(NOLOCK) WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Dim1' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Dim1' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Dim1' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_Dim1' )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_Dim1")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_Dim1")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 1
				SQLEXECError(cSQLu,ThisForm.nConnHandle,nSQLEXEC,'tmpSO_Dim1')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLu )
			ELSE 
				IF USED('tmpSO_Dim1')
					IF RECCOUNT('tmpSO_Dim1') > 0
						nSOiDim1 = tmpSO_Dim1.Thck
					ENDIF
				 	USE IN tmpSO_Dim1
				ENDIF
			ENDIF
			
		ENDIF
		
		****************************************************************
		*Get Process QTY, Weight and O_QTY   *Read in data of Process
		*compare to consumed QTY and Weight.
		
		PRIVATE cSQL
		cSQL="SELECT AllowSub,PU,QTY,Pounds,Ordered_QTY"
		cSQL=cSQL+",Prc_Form,Prc_PCs,Prc_Dim1,Prc_Dim2,Prc_Dim3 " && use this new data ???
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process "
		ENDCASE
		cSQL=cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		cSQL=cSQL + " AND ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		
		IF USED("tmpProcessWeight")
			USE IN tmpProcessWeight
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessWeight')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessWeight')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessWeight' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcessWeight' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessWeight")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcessWeight")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpProcessWeight')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpProcessWeight')
				IF RECCOUNT('tmpProcessWeight')>0
					lAllowSub		= PrepareSQLLogic(tmpProcessWeight.AllowSub,'AllowSub',.F.)
					nProcessPU		= PrepareSQLnum(tmpProcessWeight.PU,'PU',-1)
					nProcessQTY		= PrepareSQLnum(tmpProcessWeight.QTY,'QTY',-3)
					nProcessO_QTY	= PrepareSQLnum(tmpProcessWeight.Ordered_QTY,'O_QTY',-3)
					nProcessPounds	= PrepareSQLnum(tmpProcessWeight.Pounds,'Pounds',7,1)
					cProcessForm	= PrepareSQLtxt(tmpProcessWeight.Prc_Form,'Form',2)
					nProcessPCs		= PrepareSQLnum(tmpProcessWeight.Prc_PCs,'PCs',-3)
					nProcessDim1	= PrepareSQLnum(tmpProcessWeight.Prc_Dim1,'Dim1',10,4)
					nProcessDim2	= PrepareSQLnum(tmpProcessWeight.Prc_Dim2,'Dim2',9,3)
					nProcessDim3	= PrepareSQLnum(tmpProcessWeight.Prc_Dim3,'Dim3',9,3)
					
					IF nProcessPU = 0 AND LEN(cProcessForm)>1
						nProcessPU = GetPUfromForm(cProcessForm,ThisForm.nConnHandle)
					ENDIF
					
				ENDIF
				USE IN tmpProcessWeight
			ENDIF
		ENDIF
		
		****************************************************************
		*Get Lst Detail Pc, nDetail_Weight, nDetail_QTY - Subtract for consumed PC.
		PRIVATE cSQL
		cSQL="SELECT PC, Weight, S_Qty "  &&Pc,Weight ,S_QTY,S_P,S_Total "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Detail "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Detail "
		ENDCASE
		cSQL=cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		
		IF USED("tmpDetail_PC")
			USE IN tmpDetail_PC
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_PC')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_PC')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_PC' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_PC' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_PC")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_PC")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpDetail_PC')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED('tmpDetail_PC')
				IF RECCOUNT('tmpDetail_PC')>0
					nDetail_PC		= PrepareSQLnum(tmpDetail_PC.PC,'PC',-3)
					nDetail_Weight	= PrepareSQLnum(tmpDetail_PC.Weight,'Pounds',9,1)
					nDetail_QTY		= PrepareSQLnum(tmpDetail_PC.S_Qty,'QTY',-5)
				ENDIF
				USE IN tmpDetail_PC
			ENDIF
		ENDIF
		
		
		****************************************************************
		*Get Remove Stock Summ totals
		*compare to consumed QTY and PC.
		SELECT tmpStkSum
		SET TALK OFF
		
		PRIVATE nRemove_PC_Total, nRemove_LBS_Total, nRemove_QTY_Total
		SUM PCs		TO nRemove_PC_Total
		SUM Weight	TO nRemove_LBS_Total
		SUM QTY		TO nRemove_QTY_Total
		
		nRemove_PC_Total	= PrepareSQLnum(nRemove_PC_Total,'PC',-3)
		nRemove_LBS_Total	= PrepareSQLnum(nRemove_LBS_Total,'Pounds',8,1)
		nRemove_QTY_Total	= PrepareSQLnum(nRemove_QTY_Total,'QTY',18,4)
		
		***************************************************************
		PRIVATE nCurRec, nRecNo3
		nCurRec = RECNO('tmpStkSum')
		nRecNo3	= PrepareSQLnum(ThisForm.txtRecNo3.Value,'RecNo',-3)
		
		IF nCurRec <> nRecNo3
			IF nRecNo3 > 0 
				IF nRecNo3 <= RECCOUNT('tmpStkSum')
					GOTO nRecNo3 
				ENDIF
			ENDIF
		ENDIF
		
		***************************************************************
		*PriceUnit 1=$/#, 2= $/FT, 3= $/PC
		DO CASE
		CASE nProcessPU = 1
			IF nProcessPCs = 0
				*Just assume 1pc with many pounds
				nProcessPCs = 1
			ENDIF
		CASE nProcessPU = 2
			IF nProcessPCs = 0
				*Just assume 1pc with many Feet
				nProcessPCs = 1
			ENDIF
		CASE nProcessPU = 3
			IF nProcessPCs = 0
				IF nProcessQTY > 0
					nProcessPCs = nProcessQTY
				ENDIF
			ENDIF
		ENDCASE
		
		***
		PRIVATE nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3
		nDPieces	= PrepareSQLnum(ThisForm.txtPC1.Value,'Pieces',-3)
		cDAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cDForm	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		nDSize1	= PrepareSQLnum(ThisForm.txtDim11.Value,'DIM11',10,4)
		nDSize2	= PrepareSQLnum(ThisForm.txtDim21.Value,'DIM21',9,3)
		nDSize3	= PrepareSQLnum(ThisForm.txtDim31.Value,'DIM31',9,3)
		
		IF EMPTY(nDetail_Weight)
			nDetail_Weight = GetWeight(nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3, ThisForm.nConnHandle)
		ENDIF
		IF EMPTY(nDetail_QTY)
			nDetail_QTY = GetUnitQty(nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3, ThisForm.nConnHandle)
		ENDIF
		
		***
		*check QTY and Pounds are good Calculated Vs Detail stored.	
		PRIVATE nCalc_LBS, nCalc_QTY, nMess
		nCalc_LBS = GetWeight(nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3, ThisForm.nConnHandle)
		nCalc_QTY = GetUnitQty(nDPieces, cDAlloy, cDForm, nDSize1, nDSize2, nDSize3, ThisForm.nConnHandle)
		
		PRIVATE cDDescript, cMess, nMess
		cDDescript = DescriptionMetricReport(nDPieces, cDForm, nDSize1, nDSize2, nDSize3, nDetail_Weight,.F.,.F.,'','','',ThisForm.nConnHandle )
		cMess = ''
		nMess = 0
		
		IF (nDetail_QTY+10)*.8 > (nCalc_QTY+10) OR (nDetail_QTY+10) < (nCalc_QTY+10)*.8
			*fix
			cMess = "Detail QTY is : "+ALLTRIM(STR(nDetail_QTY))+" and Calculeted QTY is : "+ALLTRIM(STR(nCalc_QTY))+" "+CHR(13)
			cMess = cMess + cDDescript+" "+CHR(13)+"Continue with consume?"
			nMess = MESSAGEBOX(cMess,4+32,"Continue?") 
			IF nMess = 6
			
			ENDIF
			RecordTest('Record Test Data.',PROGRAM(), LINENO(1), cMess +" "+CHR(13)+"Answered with "+STR(nMess,1))
		ENDIF
		
		IF (nDetail_Weight+10)*.8 > (nCalc_LBS+10) OR (nDetail_Weight+10) < (nCalc_LBS+10)*.8
			*fix
			IF nProcessPCs = 1
				cMess = "Detail LBS is : "+ALLTRIM(STR(nDetail_Weight))+" and Calculeted LBS is : "+ALLTRIM(STR(nCalc_LBS))+" "+CHR(13)
				cMess = cMess + cDDescript+" "+CHR(13)+"Continue with consume?"
				nMess = MESSAGEBOX(cMess,4+32,"Continue?") 
				IF nMess = 6
				
				ENDIF
				RecordTest('Record Test Data.', PROGRAM(), LINENO(1), cMess +" "+CHR(13)+"Answered with "+STR(nMess,1))
			ENDIF
		ENDIF
		
		***
		
		IF UPPER(pWhat) = "CONSUME"
			nQTYLeft	= 0
			nWeightLeft	= 0
			nPCLeft  	= 0
		ELSE
			IF nRemove_QTY_Total > 0
				nQTYLeft = nDetail_QTY - nRemove_QTY_Total
			ELSE
				nQTYLeft = nDetail_QTY - nProcessO_QTY 
			ENDIF
			IF nQTYLeft < 1
				nQTYLeft = 1
			ENDIF
			***
			IF nRemove_LBS_Total > 0
				nWeightLeft	= nDetail_Weight - nRemove_LBS_Total
			ELSE
				nWeightLeft	= nDetail_Weight - nProcessPounds 
			ENDIF
			IF nWeightLeft < 1
				nWeightLeft = 1
			ENDIF
			***
			IF nRemove_PC_Total > 0
				nPCLeft = nDetail_PC - nRemove_PC_Total
			ELSE
				nPCLeft = nDetail_PC - nProcessPCs
			ENDIF
			IF nPCLeft < 1
				nPCLeft = 1
			ENDIF
			***
		ENDIF
		
		***********************************
		IF VARTYPE(aConsumeQTY) = "U"
			PUBLIC ARRAY aConsumeQTY(14)
		ENDIF
		
		aConsumeQTY(1) = nQTYLeft
		aConsumeQTY(2) = nWeightLeft
		aConsumeQTY(3) = nPCLeft  
		
		aConsumeQTY(4) = nDetail_QTY 
		aConsumeQTY(5) = nDetail_Weight
		aConsumeQTY(6) = nDetail_PC
		
		aConsumeQTY(7) = nRemove_QTY_Total
		aConsumeQTY(8) = nRemove_PC_Total
		aConsumeQTY(9) = nRemove_LBS_Total
		
		aConsumeQTY(10) = nProcessQTY
		aConsumeQTY(11) = nProcessO_QTY
		aConsumeQTY(12) = nProcessPCs
		aConsumeQTY(13) = nProcessPounds
		aConsumeQTY(14) = lAllowSub
		
		*******************************************
		PRIVATE nCntProcess
		nCntProcess = 0
		
		*Check to see if other Details are there 
		*then send Email report of other SO's that also use this Detail
		
		cSQLsID = "SELECT COUNT(*) AS Cntd "
		DO CASE
		CASE cTBL = "S"
			cSQLsID = cSQLsID + " FROM dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQLsID = cSQLsID + " FROM dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQLsID = cSQLsID + " FROM dbo.WIPLst_Process "
		ENDCASE
		
		cSQLsID = cSQLsID + " WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		cSQLsID = cSQLsID + " AND ( NOT ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		
		*WAIT WINDOW cSOitem NOWAIT
		IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
			cSQLsID = cSQLsID + " AND ( SOitem != dbo.f_ProperSOitem('"+cSOitem +"')"
			cSQLsID = cSQLsID + " AND dbo.f_getSalesNum_SOitem(SOitem)>0 )"
			
			IF nWO > 0
				cSQLsID = cSQLsID + " OR NOT WO="+STR(nWO)+" )"
			ELSE
				cSQLsID = cSQLsID + " ) "
			ENDIF
		ELSE
			IF nWO > 0
				cSQLsID = cSQLsID + " OR NOT WO="+STR(nWO)+" )"
			ELSE
				cSQLsID = cSQLsID + " ) "
			ENDIF
		ENDIF
		
		* cSQLsID = cSQLsID + ") "
		
		IF USED("tmp")
			USE IN tmp
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, 'tmp')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, 'tmp')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, 'tmp' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, 'tmp' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, "tmp")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLsID, "tmp")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLsID, ThisForm.nConnHandle,nSQLEXEC,'tmp')
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLsID )
		ELSE
			
			****************************
			*Find other SO's that are also used on this Detail
			IF USED("tmp")
				IF tmp.Cntd > 0
					nCntProcess = tmp.Cntd
							
					*cSQLsID 
					IF nCntProcess > 100
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Too many counted in Query:"+CHR(13)+cSQLsID)
						*Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'HPA App Alert',"Too many in Query:"+CHR(13)+cSQLsID+CHR(13)+"Modify_StockLst_Detail.ConsumeQTY()  Line:"+ALLTRIM(STR( LINENO(1) )) ,ThisForm.nConnHandle,.T.,.F.)
					ENDIF
		
				ENDIF
				USE IN tmp
			ENDIF
		ENDIF
		
		****************************
		IF nCntProcess = 0
			RETURN .T.
		ENDIF
		
		
		*Collect SO and WO for Email
		PRIVATE cSOitemtmpProcess, nWOtmpProcess
		PRIVATE cSOitemS, cSOitemS_HTML
		cSOitemS = ''
		cSOitemS_HTML = ''
		
			
		cSQL = "SELECT dbo.f_ProperSOitem(SOitem) AS [SOitem], ISNULL(WO,0) AS WO "
		DO CASE
		CASE cTbl = "S"
			cSQL = cSQL +" FROM dbo.StockLst_Process "
		CASE cTbl = "B"
			cSQL = cSQL +" FROM dbo.BrokerLst_Process "
		CASE cTbl = "W"
			cSQL = cSQL +" FROM dbo.WIPLst_Process "
		ENDCASE
		cSQL = cSQL +" WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
		cSQL = cSQL +" AND ( NOT ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
			
		IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
			cSQL = cSQL +" AND ( (SOitem != dbo.f_ProperSOitem('"+cSOitem +"')"
			cSQL = cSQL +" AND dbo.f_getSalesNum_SOitem(SOitem)>0  )"
			IF nWO > 0
				cSQL = cSQL +" OR ( ISNULL(WO,0) != "+STR(nWO)+" AND ISNULL(WO,0) != ISNULL(WO,0) )"
			ELSE
				cSQL = cSQL +") "
			ENDIF
		ELSE
			IF nWO > 0
				cSQL = cSQL +" AND ( ISNULL(WO,0) != "+STR(nWO)+" AND ISNULL(WO,0) != ISNULL(WO,0) )"
			ELSE
				cSQL = cSQL +") "
			ENDIF				
		ENDIF		
		cSQL = cSQL +" )"
		
		IF USED("tmpProcess")
			USE IN tmpProcess
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProcess')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcess")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProcess")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle,nSQLEXEC,'tmpProcess')	
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ENDIF
		
		IF USED('tmpProcess')	
			IF RECCOUNT('tmpProcess') > 0
				
				SCAN
					cSOitemtmpProcess = PrepareSQLtxt(tmpProcess.SOitem,"SOitem",10)
					IF NOT cSOitemtmpProcess = Proper_SO_item("")
						IF VAL(cSOitem) > 0
							IF EMPTY(cSOitemS)
								cSOitemS = ALLTRIM(cSOitemtmpProcess)
								cSOitemS_HTML = HTML_SOitem(cSOitemtmpProcess,.F.)+" "+get_Description("SOitem",cSOitemtmpProcess,ThisForm.nConnHandle)
							ELSE
								cSOitemS = cSOitemS + "," +ALLTRIM(cSOitemtmpProcess)
								cSOitemS_HTML = cSOitemS_HTML+CHR(13)+", "+HTML_SOitem(cSOitemtmpProcess,.F.)+" "+get_Description("SOitem",cSOitemtmpProcess,ThisForm.nConnHandle)
							ENDIF
						ENDIF
					ENDIF
					
					nWOtmpProcess = PrepareSQLnum(tmpProcess.WO,'WO',-3)
					IF nWOtmpProcess > 0
						IF EMPTY(cSOitemS)
							cSOitemS = ALLTRIM(STR(nWOtmpProcess))
							cSOitemS_HTML = HTML_WO(nWOtmpProcess,.F.)+" "+get_Description("WO",nWOtmpProcess,ThisForm.nConnHandle)
						ELSE
							cSOitemS = cSOitemS + "," +ALLTRIM(STR(nWOtmpProcess))
							cSOitemS_HTML = cSOitemS_HTML+CHR(13)+", "+HTML_WO(nWOtmpProcess,.F.)+" "+get_Description("WO",nWOtmpProcess,ThisForm.nConnHandle)
						ENDIF
					ENDIF
					
					IF LEN(cSOitemS) > 250
						EXIT
					ENDIF
				ENDSCAN
			ENDIF
			USE IN 'tmpProcess'
		ENDIF			
		
		*UPPER(pWhat) = "CONSUME" OR "SAVE"
		IF UPPER(pWhat) = "CONSUME"
		
			lOK = MESSAGEBOX("This Detail Item will be removed!"+CHR(13);
			  +ALLTRIM(STR(nCntProcess))+" Other Sales Order Items or Work Order Items listed use this StockLst Detail"+CHR(13);
			  +cSOitemS+CHR(13);
			  +"Are you still sure you want to consume? (Y/N)"+CHR(13)+CHR(13);
			  +"An Email will be sent to those Sales Reps who wanted this stock.",4+16,"Continue to consume?")=6
			  
			  *+"If an Inventory Correction is pending for this Detail, that will also be removed!"+CHR(13);
		  
			IF lOK
				PRIVATE cBody
				cBody = "This ID_Detail:"+ALLTRIM(STR(nID_Detail))+" will be consumed!"+CHR(13)
				IF Proper_SO_item(cSOitem) != Proper_SO_item('')
					cBody = cBody + " by SOitem :"+HTML_SOitem(cSOitem,.F.)+" "
					cBody = cBody + " "+get_Description("SOitem",cSOitem,ThisForm.nConnHandle)+CHR(13)
				ENDIF
				IF nWO > 0
					cBody = cBody + " by WorkOrder :"+HTML_WO(nWO,.F.)
					cBody = cBody + " "+get_Description("WO",nWO,ThisForm.nConnHandle)+CHR(13)
				ENDIF
				cBody = cBody + ALLTRIM(STR(nCntProcess))+" other items were to use this StockLst Detail."+CHR(13)
				cBody = cBody + "Messed up SOitem's:"+CHR(13)+cSOitemS_HTML+CHR(13)
				
				TrackMess(LEFT(cBody,254))
				cBody = cBody + " "+ALLTRIM(SYS(0))+"." +CHR(13)+"Modify_StockLst_Detail.ConsumeQTY()   Line:"+ALLTRIM(STR( LINENO(1) ))
				cBody = cBody + CHR(13)+cSQL 
				
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cBody )
				*Send_HTML_Email( 'David.Kirchner@SpaceAlloysUSA.com',get_Server_Email(),'HPA App Alert',cBody,ThisForm.nConnHandle,.T.,.F.)
			ELSE
				RETURN .F.
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE consumestock
		PARAMETER lScrap
		*ThisForm.ConsumeStock(lScrap)
		
		IF VARTYPE(lScrap) != "L"
			lScrap = .F.
		ENDIF
		
		***************
		PRIVATE lOK, cSOitem, nWO, cPOitem
		lOK = .T.
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		cPOitem = ThisForm.cPOitem
		
		
		*****************
		PRIVATE nID, nID_Detail, nID_Detail_Process
		nID					= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail			= PrepareSQLnum(THISFORM.txtID_Detail.VALUE,'ID_Detail',-3,0)
		nID_Detail_Process	= PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3,0)
		
		IF nID = 0 OR nID_Detail = 0
			MESSAGEBOX("Can not Change!",4,"Lost ID!")
			TRACKMESS(PROGRAM()+CHR(13)+" -Consume- Cannot because of bad ID:"+STR(nID)+" or ID_Detail:"+STR(nID_Detail)+" lScrap="+IIF(lScrap,'T','F')+" SOitem="+cSOitem+" WO:"+STR(nWO) )
			RETURN .F.
		ENDIF
		
		PRIVATE cTbl
		cTbl = PrepareSQLtxt(ThisForm.txtTbl.Value,'TBL',1)
		
		IF TYPE("cTbl") <> "C"
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			TrackError("Cannot Consume. ID:"+STR(nID)+", ID_Detail:"+STR(nID_Detail)+CHR(13)+"Scrap="+IIF(lScrap,'T','F')+" SOitem="+cSOitem+" WO:"+STR(nWO) ,"Lost Table 'cTBL' ",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF EMPTY(cTbl)
			MESSAGEBOX("Can not Change!",4,"Lost 'Tbl' !")
			TrackError("Cannot Consume. ID:"+STR(nID)+", ID_Detail:"+STR(nID_Detail)+CHR(13)+"Scrap="+IIF(lScrap,'T','F')+" SOitem="+cSOitem+" WO:"+STR(nWO) ,"Lost Table 'cTBL' ",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		
		*********************************
		*WAIT WINDOW cSOitem NOWAIT
		IF Proper_SO_Item(cSOitem) = Proper_SO_Item('') AND nWO = 0
			MESSAGEBOX("Need a SO or WO to account for this stock change!",0+48,"Cannot proceed.")
			TrackError("Cannot Consume."+CHR(13)+"Scrap="+IIF(lScrap,'T','F')+" SOitem="+cSOitem+" WO:"+STR(nWO) ,"Need a SO or WO to account for this stock change!",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		*********************************
		PRIVATE nCmpltAfterConsProc
		nCmpltAfterConsProc = 0
		IF nID_Detail < 1
			MESSAGEBOX("No ID_Detail to Delete\Consume",16,"Error")
			TrackError("Cannot Consume.  ID:"+STR(nID)+", ID_Detail:"+STR(nID_Detail)+CHR(13)+"Scrap="+IIF(lScrap,'T','F')+" SOitem="+cSOitem+" WO:"+STR(nWO),"No ID_Detail to Delete\Consume",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		**********************************
		*Check that Process QTY and Pounds are close
		PRIVATE nCalcQTY, nCalcLBS, nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, nStockLst_PU
		nPieces	= PrepareSQLnum(ThisForm.txtPC3.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.txtForm3.Value,'Form',2)
		nSize1	= PrepareSQLnum(ThisForm.txtDim13.Value,'DIM1',10,4)
		nSize2	= PrepareSQLnum(ThisForm.txtDim23.Value,'DIM2',9,3)
		nSize3	= PrepareSQLnum(ThisForm.txtDim33.Value,'DIM3',9,3)
		nStockLst_PU = PrepareSQLnum(ThisForm.txtS_PU.Value,'PU',-1)
		
		nCalcQTY = GetUnitQty(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		*nCalcLBS = CalcWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		nCalcLBS = GetWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		
		***
		DO CASE 
		CASE nStockLst_PU = 1
			***Check QTY is like LBS
			IF (nCalcQTY+10)*.7 > (nCalcLBS+10) 
				MESSAGEBOX("The Detail Item QTY:"+ALLTRIM(STR(nCalcQTY))+CHR(13)+" is not like the"+CHR(13)+"Detail LBS:"+ALLTRIM(STR(nCalcLBS))+"."+CHR(13)+CHR(13)+"Edit and try to Add to Summary again.",48,"Warning!")
				ThisForm.txtQTY3.SetFocus()
				
				TrackError( "The Detail Item QTY:"+ALLTRIM(STR(nCalcQTY))+CHR(13)+" is not like the"+CHR(13)+"Detail LBS:"+ALLTRIM(STR(nCalcLBS))+"."+CHR(13)+CHR(13)+"Edit and try to Add to Summary again.","QTY Pounds mismatch WARNING",PROGRAM(),LINENO(1))
				RecordTest('Record Test Data.',PROGRAM(), LINENO(1), "The Detail Item QTY:"+ALLTRIM(STR(nCalcQTY))+CHR(13)+" is not like the"+CHR(13)+"Detail LBS:"+ALLTRIM(STR(nCalcLBS))+"."+CHR(13)+CHR(13)+"Edit and try to Add to Summary again.")
				
				*RETURN .F.	--too early to enable this
			ENDIF
		CASE nStockLst_PU = 2
			*Check PC
		CASE nStockLst_PU = 3
			*Check FT
		ENDCASE
		***
		**********************************
		PRIVATE cSQL, nSQLEXEC, cSQLdID
		PRIVATE nMess, cMess
		cMess = "Are you sure you want to "+IIF(lScrap,'SCRAP','CONSUME')+" this Detail Item?"+CHR(13)
		cMess = cMess +"This Detail Item will no longer be listed!"
		*WAIT WINDOW cSOitem NOWAIT
		IF NOT Proper_SO_Item(cSOitem) = Proper_SO_Item('')
			cMess = cMess +CHR(13)+"This SO-item '"+cSOitem+"' will be charged for the cost"
			cMess = cMess + CHR(13)+"left in this detail item."
		ENDIF
		
		nMess = MESSAGEBOX(cMess,4+32,"Confirm Consume?")
			
		IF nMess=6
			*CONSUME	*IIF(lScrap,'SCRAP','CONSUME')
			
			lOK = ThisForm.ConsumeQTY('CONSUME')  &&Creates ARRAY aConsumeQTY(14)
			IF NOT lOK 
				RETURN .F.
			ENDIF
			PRIVATE nQTYLeft, nWeightLeft, nPCLeft, nDetail_QTY, nDetail_Weight, nDetail_PC
			PRIVATE nRemove_QTY_Total, nRemove_PC_Total, nRemove_LBS_Total, nProcessQTY, nProcessO_QTY, nProcessPC, nProcessPounds, lAllowSub		
			
			*PUBLIC ARRAY aConsumeQTY(14)
			nQTYLeft 	= aConsumeQTY(1)
			nWeightLeft = aConsumeQTY(2)
			nPCLeft  	= aConsumeQTY(3)
			nDetail_QTY	= aConsumeQTY(4)
			nDetail_Weight	= aConsumeQTY(5)
			nDetail_PC 		= aConsumeQTY(6)
			nRemove_QTY_Total 	= aConsumeQTY(7)
			nRemove_PC_Total	= aConsumeQTY(8)
			nRemove_LBS_Total 	= aConsumeQTY(9)
			nProcessQTY 	= aConsumeQTY(10)
			nProcessO_QTY = aConsumeQTY(11)
			nProcessPC		= aConsumeQTY(12)
			nProcessPounds	= aConsumeQTY(13)
			lAllowSub		= aConsumeQTY(14)
			
			IF lOK
				lOK = ThisForm.SaveStockLstEdit_tmpStkSum(.T.,lScrap )
			ENDIF
		
		**************************
			PRIVATE nReceivingID, nS_QTY, nS_P, nStkCost
			nReceivingID = 0
			nS_QTY	= 0
			nS_P	= 0
			nStkCost= 0
			
			IF lOK 
		
				IF USED("tmpID_Detail_Qty")
					USE IN tmpID_Detail_Qty
				ENDIF
				SELECT 0
		
				cSQL = "SELECT ReceivingID, S_QTY, S_P, S_Total FROM "
				DO CASE
				CASE cTBL = "S"
					cSQL = cSQL + " dbo.StockLst_Detail "
				CASE cTBL = "B"
					cSQL = cSQL + " dbo.BrokerLst_Detail "
				CASE cTBL = "W"
					cSQL = cSQL + " dbo.WIPLst_Detail "
				ENDCASE
				cSQL = cSQL + " WHERE ID_Detail ="+STR(nID_Detail)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpID_Detail_Qty")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpID_Detail_Qty")
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Qty')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpID_Detail_Qty')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Qty")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Qty")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpID_Detail_Qty")
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ENDIF
				IF USED('tmpID_Detail_Qty')
					IF RECCOUNT('tmpID_Detail_Qty') > 0
						nReceivingID = PrepareSQLnum(tmpID_Detail_Qty.ReceivingID,'ReceivingID',-3)
						nS_QTY	= PrepareSQLnum(tmpID_Detail_Qty.S_QTY,'S_QTY',-3)
						nS_P	= PrepareSQLnum(tmpID_Detail_Qty.S_P,'S_P',-3)
						nStkCost= PrepareSQLnum(tmpID_Detail_Qty.S_Total ,'S_Total',-3)
					ENDIF
					USE IN tmpID_Detail_Qty
				ENDIF
			ENDIF
			
		***************************				
			IF lOK 
				ThisForm.Modify_StockLst_Detail( "DEL" )		&&Changes Screen
				ThisForm.Modify_StockLst_How = "DELETE"
		
		
				PRIVATE cMess
				cMess = "Will this Consume complete this "+CHR(13)
				cMess = cMess + "Process "+ALLTRIM(STR(nID_Detail_Process))+" ?"+CHR(13)
				cMess = cMess + STR(aConsumeQTY(4),10,1)+" Detail QTY   "+CHR(13)
				cMess = cMess + STR(aConsumeQTY(10),10,1)+" Process QTY   "+CHR(13)
				cMess = cMess + STR(aConsumeQTY(1),10,1)+" QTY Left 	"+CHR(13)+CHR(13)
				cMess = cMess + STR(aConsumeQTY(5),10,1)+" Detail Weight "+CHR(13)
				*cMess = cMess + STR(aConsumeQTY(13),10,1)+" Process LBS   "+CHR(13)
				cMess = cMess + STR(aConsumeQTY(9),10,1)+" Remove LBS   "+CHR(13)+CHR(13)
					
				nCmpltAfterConsProc = MESSAGEBOX(cMess,4+32,"Process Completed?")
				
				*nWeightLeft	=  nDetail_Weight - nProcessPounds 
				*nPCLeft  	= nProcessPC - nDetail_PC
				IF nCmpltAfterConsProc = 6	&&Yes
					* Under weight should be checked only when the SOitem is listed as complete, not just the process as complete.  
					* Mutiple consume is possible and not worth the alert
					* Charge last of Inventory to this SOitem
					*nACreturn = AccountingCosting( m.nID1, m.nID_Detail, cSOitem, ThisForm.nConnHandle )
				ELSE
					*Process not Complete - Double check
					IF nProcessPounds > 0 AND nDetail_Weight > 0 
						*Over weight
						*AND nWeightLeft > 10 
						IF nProcessPounds  < nDetail_Weight AND nWeightLeft > 10   &&what is being shipped is more than process weight requested.
							PRIVATE cBody
							cBody = "What is being consumed has covered the process weight requested."+CHR(13)+"Are you sure this change complete this Process ?"+CHR(13)+"Process request Weight:"+ALLTRIM(STR(nProcessPounds))+CHR(13)+"Consumed Weight:"+ALLTRIM(STR(nDetail_Weight))
							*cSOitem
							nCmpltAfterConsProc = MESSAGEBOX(cBody,4+16,"Double check - Process Completed?")
							cBody = "ConsumeStock."+CHR(13)+cBody+CHR(13)+"On double check, "+ALLTRIM(SYS(0))+" answered:"+IIF(nCmpltAfterConsProc=6,"Yes","No")
							cBody = cBody+CHR(13)+"by SO item '"+HTML_SOitem(cSOitem,.F.)
							cBody = cBody+CHR(13)+"Detail_Weight="+ALLTRIM(STR( PrepareSQLnum(nDetail_Weight,'Detail_Weight'-3) ))
							cBody = cBody+CHR(13)+"Detail_PC="+ALLTRIM(STR( PrepareSQLnum(nDetail_PC,'Detail_PC',-3) ))
							cBody = cBody+CHR(13)+ALLTRIM(SYS(0))+"."+CHR(13)+"Modify_StockLst_Detail.ConsumeStock()  Line:"+ALLTRIM(STR( LINENO(1) ))
							cBody = cBody + CHR(13)+cSQL 
							
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cBody )
							*Send_HTML_Email( 'Admin@SpaceAlloysUSA.com', get_Server_Email() ,'HPA App Alert',cBody ,ThisForm.nConnHandle,.T.,.F.)
						ENDIF				
					ENDIF
				ENDIF
				
				IF nCmpltAfterConsProc = 6
					
					ThisForm.Modify_StockLst_How = "DONE"
					DO CASE
					CASE cTBL = "S"
						IF nWO > 0
							*Could use ThisForm.cPOitem 
							cPOitem = getWorkOrder_POitem( nWO, ThisForm.nConnHandle)					
							
							cMess = "This Consume of Stock is for a"+CHR(13)
							cMess = cMess + "WO '"+STR(nWO)+"'" +CHR(13)
							IF NOT Proper_PO_Item(cPOitem) = Proper_PO_Item('')
								cMess = cMess + "and PO '"+cPOitem+"'" +CHR(13)+CHR(13)
							ENDIF
							cMess = cMess + CHR(13)+"'Work In Process' (WIP) is for holding WO metal."+CHR(13)
							cMess = cMess + "This removed stock to be kept in the WIP"
							*cMess = cMess + "Do you want the removed stock to be kept in the WIP?"
							*nMess = MESSAGEBOX(cMess,4,"Copy this Stock Detail into the WIP?")
							MESSAGEBOX(cMess,4,"Copy this Stock Detail into the WIP")
							
							*	IF nMess = 6
								IF ThisForm.Copy_Stock_WIP(cTBL)
								
								ENDIF
							*	ENDIF
							*ENDIF
						ENDIF		
							
						ThisForm.Modify_StockLst_Detail_Report(nID_Detail_Process)
					CASE cTBL = "B"
						IF nWO > 0
							*Could use ThisForm.cPOitem 
							cPOitem = getWorkOrder_POitem( nWO, ThisForm.nConnHandle)					
							
							cMess = "This Consume incoming Stock is for a"+CHR(13)
							cMess = cMess + "WO '"+STR(nWO)+"'" +CHR(13)
							IF NOT Proper_PO_Item(cPOitem) = Proper_PO_Item('')
								cMess = cMess + "and PO '"+cPOitem+"'" +CHR(13)+CHR(13)
							ENDIF
							cMess = cMess + CHR(13)+"'Work In Process' (WIP) is for holding WO data."+CHR(13)
							cMess = cMess + "This removed stock to be kept in the WIP"
							*cMess = cMess + "Do you want the removed stock to be kept in the WIP?"
							*nMess = MESSAGEBOX(cMess,4,"Copy this Stock Detail into the WIP?")
							MESSAGEBOX(cMess,4,"Copy this Stock Detail into the WIP")
							
							*	IF nMess = 6
								IF ThisForm.Copy_Stock_WIP(cTBL)
								
								ENDIF
							*	ENDIF
							*ENDIF
						ENDIF		
		
						ThisForm.Modify_BrokerLst_Detail_Report(nID_Detail_Process)
					CASE cTBL = "W"
						IF nWO > 0
						ENDIF	
						
						ThisForm.Modify_BrokerLst_Detail_Report(nID_Detail_Process)
					ENDCASE			
					
					*ThisForm.Visible = .F.
					ThisForm.Visible = .F.
					
					***************************
				ELSE
					*A New process with the remaining QTY will be created
					* the old process is going to be deleted.
					*See Partial_ID_Detail_Process
					
					*Good
					ThisForm.Modify_StockLst_How = "DONE"
					IF cTBL = "S"
						ThisForm.Modify_StockLst_Detail_Report(nID_Detail_Process)
					ENDIF
					*ThisForm.Visible = .F.
					ThisForm.Visible = .F.
		
				ENDIF
				
				********************************************
				PRIVATE lConsume
				lConsume = .T.
				IF lOK 
					ThisForm.Partial_ID_Detail_Process(lConsume)  &&Uses the ARRAY aConsumeQTY(12)
				ENDIF
				
				********************************************
				
				IF lOK 
					IF NOT Remove_Lst_Detail_by_ID_Detail(cTBL,nID_Detail, ThisForm.nConnHandle, 'Modify_StockLst_Edit', 'Consume' )
						lOK =.F.
					ENDIF
				ENDIF
				
				********************************************
				
				IF lOK
					*Remove orphened Corrections
					DO CASE
					CASE cTBL = "S"
						cSQLdID = "DELETE FROM dbo.StockLst_Process WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
					CASE cTBL = "B"
						cSQLdID = "DELETE FROM dbo.BrokerLst_Process WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
					CASE cTBL = "W"
						cSQLdID = "DELETE FROM dbo.WIPLst_Process WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
					ENDCASE
					
					IF NOT EMPTY( cSOitem )
						cSQLdID = cSQLdID +" AND NOT ( (Process_ID = 'SELECTED' OR Process_ID = 'PARTSELECT' ) "
						IF nWO > 0
							cSQLdID = cSQLdID +" AND ([SOitem] = '"+cSOitem+"' "
							cSQLdID = cSQLdID +" OR [WO] = "+ALLTRIM(STR(nWO))+" ))"
						ELSE
							cSQLdID = cSQLdID +" AND [SOitem] = '"+cSOitem+"' )"
						ENDIF
					ENDIF
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID )
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQLdID, ThisForm.nConnHandle,nSQLEXEC )
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLdID)
						*SQLROLLBACK(ThisForm.nConnHandle)
						
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Consume Stock Error."+CHR(13)+cSQLdID )
						*Send_HTML_Email( 'Admin@SpaceAlloysUSA.com', get_Server_Email(),'HPA App Alert',"Consume Stock Error."+CHR(13)+cSQLdID+CHR(13)+ALLTRIM(SYS(0))+"." +CHR(13)+"Modify_StockLst_Detail.ConsumeStock()  Line:"+ALLTRIM(STR( LINENO(1) )),ThisForm.nConnHandle,.T.,.F.)
						lOK =.F.
					ELSE	
						***************************************************
						******** Count Details, if non found DELETE master	
						
						DO CASE
						CASE cTBL = "S"
							cSQLdID = "SELECT COUNT(*) AS Cntd FROM dbo.StockLst_Detail "
						CASE cTBL = "B"
							cSQLdID = "SELECT COUNT(*) AS Cntd FROM dbo.BrokerLst_Detail "
						CASE cTBL = "W"
							cSQLdID = "SELECT COUNT(*) AS Cntd FROM dbo.WIPLst_Detail "
						ENDCASE	
						cSQLdID  = cSQLdID + " WHERE ID = "+ALLTRIM(STR(nID))
						
						IF USED("tmp")
							USE IN tmp
						ENDIF
						SELECT 0
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, 'tmp' )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, 'tmp' )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, 'tmp' )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, 'tmp' )
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, "tmp")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, "tmp")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQLdID, ThisForm.nConnHandle ,nSQLEXEC, 'tmp')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLdID)
							*SQLROLLBACK(ThisForm.nConnHandle)
							
							RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Consume Stock Error."+CHR(13)+cSQLdID)
							*Send_HTML_Email( 'Admin@SpaceAlloysUSA.com', get_Server_Email(),'HPA App Alert',"Consume Stock Error."+CHR(13)+cSQLdID+CHR(13)+ALLTRIM(SYS(0))+"."+CHR(13)+"Modify_StockLst_Detail.ConsumeStock()  Line:"+ALLTRIM(STR( LINENO(1) )) ,ThisForm.nConnHandle,.T.,.F.)
							lOK =.F.
						ELSE
							IF tmp.Cntd = 0
								*Delete Master
								DO CASE
								CASE cTBL = "S"
									cSQLdID = "DELETE FROM dbo.StockLst_Master WHERE ID = "+ALLTRIM(STR(nID))
								CASE cTBL = "B"
									cSQLdID = "DELETE FROM dbo.BrokerLst_Master WHERE ID = "+ALLTRIM(STR(nID))
								CASE cTBL = "W"
									cSQLdID = "DELETE FROM dbo.WIPLst_Master WHERE ID = "+ALLTRIM(STR(nID))
								ENDCASE
								
								
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID )
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID )
								ENDDO
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID )
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID )
									ENDDO
								ENDIF
								IF nSQLEXEC < 0 &&Try again!
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, "")
									DO WHILE nSQLEXEC = 0
										WAIT WINDOW 'SQL 2' TIMEOUT 1
										nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLdID, "")
										
										IF nSQLEXEC < 0
											IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
												nSQLEXEC = 0
											ENDIF
										ENDIF
									ENDDO
								ENDIF 
								IF nSQLEXEC < 0
									SQLEXECError(cSQLdID, ThisForm.nConnHandle,nSQLEXEC)
									RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLdID)
									*SQLROLLBACK(ThisForm.nConnHandle)
									RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Consume Stock Error."+CHR(13)+cSQLdID )
									*Send_HTML_Email( 'Admin@SpaceAlloysUSA.com',get_Server_Email(),'HPA App Alert',"Consume Stock Error."+CHR(13)+cSQLdID+CHR(13)+ALLTRIM(SYS(0))+"."+CHR(13)+"Modify_StockLst_Detail.ConsumeStock()   Line:"+ALLTRIM(STR( LINENO(1) )) ,ThisForm.nConnHandle,.T.,.F.)
									lOK =.F.
								ENDIF
							ELSE
								*Did not Delete Master because a Detail exists
								*RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Did not Delete Master because a Detail exists!"+CHR(13)+cSQLdID )
							ENDIF
						ENDIF
						IF USED("tmp")
							USE IN tmp
						ENDIF
					ENDIF
				
				*****************
				
		
				ENDIF
			ENDIF			
				
		ENDIF
		
		*NO AccountingCosting( 
		*SOitem needs to be Costed for ID_Detail full QTY!
		
		IF lOK
			IF nCmpltAfterConsProc = 6
				PRIVATE cProcess_ID
				cProcess_ID = PrepareSQLtxt(ThisForm.txtProcess_ID.Value,'Process_ID',10)
				IF UPPER(cProcess_ID) = "NOT2HPA"
					*Simulate a Packing slip data
					*Stock will not touch HPA	
					
					DO FORM Forms\DirectShip WITH cSOitem, ThisForm.cPOitem, nWO, cTBL, nID_Detail_Process
					*, nID_Detail, nID_Detail_Process
			
				ENDIF
			ENDIF
		ENDIF
		
		IF lOK
			*Done with tmpStkSum
			ThisForm.Hide_StkSum(.T.)
		ENDIF
		
		
		RETURN lOK
		
	ENDPROC

	PROCEDURE copy_stock_wip		&& Copy_Stock_WIP
		PARAMETERS cTBL
		*ThisForm.Copy_Stock_WIP()
		*Copy to WIP
		*Then delete Detail
		
		PRIVATE nID, nID_Detail, nWO
		nID			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3,0)
		nID_Detail	= PrepareSQLnum(THISFORM.txtID_Detail.VALUE,'ID_Detail',-3,0)
		nWO 		= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		*cTBL is Parameter
		*cTBL		= PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		
		IF nID = 0
			RETURN .F.
		ENDIF
		
		IF nID_Detail = 0
			RETURN .F.
		ENDIF
		
		IF nWO = 0
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		************************
		*Check for nID_From in Master First, Then try ID
		PRIVATE nID_FoundFromID, nNewWIP_ID, lFound_FROM_Stock, lOK
		nID_FoundFromID = 0
		nNewWIP_ID = 0
		lFound_FROM_Stock = .F.
		lOK	= .T.
		
		IF USED("tmpM_ID")
			USE IN tmpM_ID
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ID FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Master "
		CASE cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Master "
		CASE cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Master "
		ENDCASE
		cSQL = cSQL + " WITH(NOLOCK) " &&could be in transaction lock
		cSQL = cSQL + " WHERE From_ID ="+STR(nID)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpM_ID")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpM_ID")
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpM_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpM_ID")
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpM_ID")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpM_ID")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "tmpM_ID")
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			lOK	= .F.
		ENDIF
		IF USED('tmpM_ID')
			IF RECCOUNT('tmpM_ID') > 0
			
				lFound_FROM_Stock = .T.
				*(PrepareSQLnum(tmpM_ID.ID,'ID',-3)) > 0
				
				IF cTBL = "W"
					nID_FoundFromID = PrepareSQLnum(tmpM_ID.ID,'ID',-3) 
				ENDIF
				
			ENDIF
			USE IN tmpM_ID
		ENDIF
		
		**********************************
		*IF NOT lFound_FROM_Stock
		*	RETURN .F.
		*ENDIF
		
		IF NOT lOK
			RETURN .F.
		ENDIF
		
		**********************************
		*Not sure of the consequences of finding a From_ID !?!
		*The only From_ID that is important is WIP has a new ID and the From_ID would link back to the StockLst ID
		*After working the metal, if it is put back in Stock, it will have a new ID, but should hold onto the From_ID number for tracking Stock changes.
		**********************************
		
		IF nID_FoundFromID = 0
			*Not found, Insert Master WIP
			cSQL = "INSERT INTO dbo.WIPLst_Master "
			cSQL = cSQL + "([Alloy]"
		    cSQL = cSQL + ",[Form]"
		    cSQL = cSQL + ",[CC]"
		    cSQL = cSQL + ",[CL]"
		    cSQL = cSQL + ",[Size]"
		    cSQL = cSQL + ",[Cond]"
		    cSQL = cSQL + ",[MWeight]"
		    cSQL = cSQL + ",[Specs]"
		    cSQL = cSQL + ",[Heat]"
		    cSQL = cSQL + ",[Lot]"
		    cSQL = cSQL + ",[Paid]"
		    cSQL = cSQL + ",[PO_item]"
		    cSQL = cSQL + ",[PoDueDate]"
		    cSQL = cSQL + ",[Mill]"
		    cSQL = cSQL + ",[StkDate]"
		    cSQL = cSQL + ",[History]"
		    cSQL = cSQL + ",[Num]"
		    cSQL = cSQL + ",[POStatus]"
		    cSQL = cSQL + ",[BrandName]"
		    cSQL = cSQL + ",[FROM_ID]"
		    cSQL = cSQL + ",[Melt]"
		*    cSQL = cSQL + ",[ID]"
		    cSQL = cSQL + ",[mS_QTY]"
		    cSQL = cSQL + ",[WO_Detail]"
		    cSQL = cSQL + ",[ProjID])"
		    ******************************
		    cSQL = cSQL + " SELECT "
		    cSQL = cSQL + " [Alloy]"
		    cSQL = cSQL + ",[Form]"
		    cSQL = cSQL + ",[CC]"
		    cSQL = cSQL + ",[CL]"
		    cSQL = cSQL + ",[Size]"
		    cSQL = cSQL + ",[Cond]"
		    cSQL = cSQL + ",0 AS [MWeight]"
		    cSQL = cSQL + ",[Specs]"
		    cSQL = cSQL + ",[Heat]"
		    cSQL = cSQL + ",[Lot]"
		    cSQL = cSQL + ",[Paid]"
		    cSQL = cSQL + ",'' AS [PO_item]"
		    cSQL = cSQL + ",CAST('' AS SmallDateTime) AS [PoDueDate]"
		    cSQL = cSQL + ",[Mill]"
		    cSQL = cSQL + ",[StkDate]"
		    cSQL = cSQL + ",'' AS [History]"
		    cSQL = cSQL + ",0 AS [Num]"
		    cSQL = cSQL + ",'A' AS [POStatus]"
		    cSQL = cSQL + ",[BrandName]"
		    cSQL = cSQL + ","+STR(nID)+" AS [FROM_ID]"
		    cSQL = cSQL + ",[Melt]"
		*    cSQL = cSQL + ",[ID]"
		    cSQL = cSQL + ",0 AS [mS_QTY]"
		    cSQL = cSQL + ",[WO_Detail]"
		    cSQL = cSQL + ",[ProjID]"
		    DO CASE
		    CASE cTBL = "S"
		    	cSQL = cSQL + " FROM dbo.StockLst_Master "
		    CASE cTBL = "B"
		    	cSQL = cSQL + " FROM dbo.BrokerLst_Master "
		    CASE cTBL = "W"
		    	*Does not make sense
		    ENDCASE
		    cSQL = cSQL + " WITH(NOLOCK) " &&could be in transaction lock
		    cSQL = cSQL + " WHERE ID = "+STR(nID)  
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "")
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "")
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				lOK	= .F.
			ELSE
				*Retreive new WIP nID
				IF USED("tmpID_WIP")
					USE IN tmpID_WIP
				ENDIF
				SELECT 0
				
				PRIVATE cSQLid
				cSQLid = "SELECT ID FROM dbo.WIPLst_Master "
				cSQLid = cSQLid + " WITH(NOLOCK) " &&could be in transaction lock
				cSQLid = cSQLid + " WHERE From_ID = "+STR(nID)
				  
				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQLid, "tmpID_WIP")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQLid, "tmpID_WIP")
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP")
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLid, "tmpID_WIP")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLid, ThisForm.nConnhandle, nSQLEXEC, "tmpID_WIP")
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLid )
					lOK	= .F.
				ENDIF
				IF USED('tmpID_WIP')
					IF RECCOUNT('tmpID_WIP') > 0
						nNewWIP_ID = PrepareSQLnum(tmpID_WIP.ID,'ID',-3)
						*nID_FoundFromID = PrepareSQLnum(tmpID_WIP.ID,'ID',-3)
					
						**************************************
						*Track
						*TrackMess(cSQL+ CHR(13)+PROGRAM() )
						*TrackMess(cSQLid+ CHR(13)+PROGRAM() )
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQL) 
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),cSQLid) 
					ENDIF
					USE IN tmpID_WIP
				ENDIF
			ENDIF
		ENDIF
			
