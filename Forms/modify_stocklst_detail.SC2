	PROCEDURE adddetailsum
		*ThisForm.AddDetailSum()
		
		PRIVATE nPCs, nDim1, nDim2, nDim3, nR_QTY, nWeight
		nPCs	= PrepareSQLnum(ThisForm.txtPC3.Value,'Pc',-3)
		nDim1	= PrepareSQLnum(ThisForm.txtDim13.Value,'Dim1',8,3)
		nDim2	= PrepareSQLnum(ThisForm.txtDim23.Value,'Dim2',8,3) 
		nDim3	= PrepareSQLnum(ThisForm.txtDim33.Value,'Dim3',8,3)
		nR_QTY	= PrepareSQLnum(ThisForm.txtQTY3.Value,'QTY',18,4)
		nWeight	= PrepareSQLnum(ThisForm.txtWeight3.Value,'Weight',8,1)
		
		PRIVATE nDPCs, nDSize_H, nDSize_L, nDDim1, nDDim2, nDDim3, nDQTY, nDWeight
		nDPCs		= PrepareSQLnum(ThisForm.txtPc1.Value,'Pc',-3)
		nDSize_H	= PrepareSQLnum(ThisForm.txtSize_H1.Value,'Size_H',-5)
		nDDim1		= PrepareSQLnum(ThisForm.txtDim11.Value,'Dim1',-5)
		nDSize_L	= PrepareSQLnum(ThisForm.txtSize_L1.Value,'Size_L',-5)
		nDDim2		= PrepareSQLnum(ThisForm.txtDim21.Value,'Dim2',-5)
		nDDim3		= PrepareSQLnum(ThisForm.txtDim31.Value,'Dim3',-5)
		nDQTY		= PrepareSQLnum(ThisForm.txtQTY.Value,'QTY',-5)
		nDWeight	= PrepareSQLnum(ThisForm.txtWeight1.Value,'Weight',8,1)
		
		PRIVATE cAlloy, cForm, nStockLst_PU 
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		nStockLst_PU = PrepareSQLnum(ThisForm.txtS_PU.Value,'PU',-1)
			
		*******************
		PRIVATE nCalcD_QTY, nCalcD_LBS
		nCalcD_QTY	= GetUnitQty(nDPCs, cAlloy, cForm, nDDim1, nDDim2, nDDim3, ThisForm.nConnHandle)
		*nCalcD_LBS	= CalcWeight(nDPCs, cAlloy, cForm, nDDim1, nDDim2, nDDim3, ThisForm.nConnHandle)
		nCalcD_LBS	= GetWeight(nDPCs, cAlloy, cForm, nDDim1, nDDim2, nDDim3, ThisForm.nConnHandle)
		
		IF nDQTY = 0
			nDQTY = nCalcD_QTY
		ENDIF
		IF nDWeight = 0
			nDWeight = nCalcD_LBS
		ENDIF
		
		*******************
		PRIVATE nCalc_QTY, nCalc_Weight
		nCalc_QTY	 = GetUnitQty(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		*nCalc_Weight = CalcWeight(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		nCalc_Weight = GetWeight(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		
		IF nR_QTY = 0
			nR_QTY = nCalc_QTY
		ENDIF
		IF nWeight = 0
			nWeight = nCalc_Weight
		ENDIF
		
		*******************
		PRIVATE lPassQTY
		lPassQTY = .T.
		
		PRIVATE cMess, cMess_ID
		cMess = ''
		
		PRIVATE nID,nID_Detail,nID_Detail_Process
		nID 			= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		nID_Detail		= PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		nID_Detail_Process = PrepareSQLnum(ThisForm.txtID_Detail_Process.Value,'ID_Detail_Process',-3)
		
		cMess_ID = "ID: "+ALLTRIM(STR(nID))+"     "+"nID_Detail: "+ALLTRIM(STR(nID_Detail))+"     "+"nID_Detail_Process : "+ALLTRIM(STR(nID_Detail_Process )) +CHR(13)
		cMess_ID = cMess_ID + "Alloy:"+ALLTRIM(cAlloy)+" Form: "+cForm+" nPCs: "+ALLTRIM(STR(nPCs)) +CHR(13)
		cMess_ID = cMess_ID + "nDim1: "+ALLTRIM(STR(nDim1,10,3))+" nDim2: "+ALLTRIM(STR(nDim2,10,3))+" nDim3: "+ALLTRIM(STR(nDim3,10,3))+" "+CHR(13)+" nR_QTY: "+ALLTRIM(STR(nR_QTY))+" nWeight: "+ALLTRIM(STR(nWeight))
		
		IF (nR_QTY+10)*.5 > (nCalc_QTY+10) OR (nR_QTY+10) < (nCalc_QTY+10)*.5
			cMess = "The Remove Item QTY:"+ALLTRIM(STR(nR_QTY))+CHR(13)+"does not match the calculated QTY:"+ALLTRIM(STR(nCalc_QTY))+"."
			MESSAGEBOX(cMess,48,"Warning!")
			*TrackError(cMess_ID+CHR(13)+cMess ,"QTY mismatch",PROGRAM(),LINENO(1) )
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1), "QTY mismatch "+CHR(13)+cMess_ID+" "+CHR(13)+cMess)
			lPassQTY = .T.		&&lPassQTY = .F.
		ELSE
			lPassQTY = .T.	
		ENDIF
		
		IF NOT lPassQTY 
			IF (nWeight+10)*.5 > (nCalc_Weight+10) OR (nWeight+10) < (nCalc_Weight+10)*.5
				cMess = "The Remove Item Pounds:"+ALLTRIM(STR(nWeight))+CHR(13)+"does not match the calculated Pounds:"+ALLTRIM(STR(nCalc_Weight))+"."
				*Already warned about QTY
				*MESSAGEBOX(cMess,48,"Warning!")
				*TrackError( cMess_ID+CHR(13)+cMess ,"Pounds mismatch",PROGRAM(),LINENO(1))
				RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "Pounds mismatch "+CHR(13)+cMess_ID+" "+CHR(13)+cMess)
			ENDIF
		ELSE
			*IF lPassQTY then do not wory about Pounds
		ENDIF
		
		*******************
		IF nDQTY = 0
			nDQTY = nCalcD_QTY
		ENDIF
		IF nWeight = 0
			nWeight = nCalc_Weight
			*nDWeight = nCalcD_Weight
		ENDIF
		
		IF (nDQTY+10)*.5 > (nCalcD_QTY+10) OR (nDQTY+10) < (nCalcD_QTY+10)*.5 
			cMess = "The Detail Item QTY:"+ALLTRIM(STR(nDQTY))+CHR(13)+"does not match the calculated Detail QTY:"+ALLTRIM(STR(nCalcD_QTY))+"."
			MESSAGEBOX(cMess,48,"Warning!")
			*TrackError(cMess_ID+CHR(13)+" "+cMess,"QTY mismatch",PROGRAM(),LINENO(1))
			RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "QTY mismatch "+CHR(13)+cMess_ID+" "+CHR(13)+" "+cMess)
			
			nDQTY = nCalcD_QTY
			lPassQTY = .T. 		&&lPassQTY = .F.
		ELSE
			lPassQTY = .T.
		ENDIF
		
		IF NOT lPassQTY 
			IF (nDWeight+10)*.5 > (nCalcD_LBS+10) OR (nDWeight+10) < (nCalcD_LBS+10)*.5
				cMess = "The Detail Item Pounds:"+ALLTRIM(STR(nDWeight))+CHR(13)+"does not match the calculated Detail Pounds:"+ALLTRIM(STR(nCalcD_LBS))+"."
				*Already warned about QTY
				*MESSAGEBOX(cMess,48,"Warning!")
				*TrackError( cMess_ID+CHR(13)+cMess ,"Pounds mismatch",PROGRAM(),LINENO(1))
				RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "Pounds mismatch "+CHR(13)+cMess_ID+" "+CHR(13)+cMess)
				nWeight = nCalcD_LBS
				nDWeight = nCalcD_LBS
			ENDIF
		ELSE
			*IF lPassQTY then do not wory about Pounds
			IF (nDWeight+10)*.5 > (nCalcD_LBS+10) OR (nDWeight+10) < (nCalcD_LBS+10)*.5
				nWeight = nCalcD_LBS
				nDWeight = nCalcD_LBS
			ENDIF
		ENDIF
		
		**********************
		
		IF NOT USED('tmpStkSum')
			PRIVATE cFileName
			cFileName = SYS(3)
			SELECT 0
			SET SAFETY OFF
			IF "\MEM" $ SYS(2003)
				CREATE TABLE (SYS(5)+SYS(2003)+"\"+(cFileName) ) FREE ;
				( PCs N(10), Dim1 N(9,4), Dim2 N(8,3), Dim3 N(8,3), QTY N(18,4), Weight N(8,1)	 )
			
				USE (SYS(5)+SYS(2003)+"\"+cFileName) EXCL ALIAS tmpStkSum
			ELSE
				CREATE TABLE (SYS(5)+SYS(2003)+"\MEM\"+(cFileName) ) FREE ;
				( PCs N(10), Dim1 N(9,4), Dim2 N(8,3), Dim3 N(8,3), QTY N(18,4), Weight N(8,1)	 )
			
				USE (SYS(5)+SYS(2003)+"\MEM\"+cFileName) EXCL ALIAS tmpStkSum
			ENDIF
				 
			 ThisForm.cmdEditSum.Enabled = .T.
			 ThisForm.cmdDelSum.Enabled = .T.
		ELSE
			ThisForm.grdSummary.RecordSource=''
		ENDIF
		
		***********************
		*Check Data
		
		***SigDim
		PRIVATE cForm
		cForm = ShowSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		
		PRIVATE nSigDim  &&0 Pc, 1 QTY, 2 Dim2, 3 Dim3, 4-,5-, 6 dim2*3
		nSigDim = getSigDim(cForm,ThisForm.nConnHandle)
		
		DO CASE
		CASE nSigDim = 0
		CASE nSigDim = 1
			IF nDim1 <= 0
				MESSAGEBOX("The FORM type requires a Dim1 value.",48,"Cannot Add.")
				RETURN .F.
			ENDIF
		CASE nSigDim = 2
			IF nDim1 <= 0
				MESSAGEBOX("The FORM type requires a Dim1 value.",48,"Cannot Add.")
				RETURN .F.
			ENDIF
			IF nDim2 <= 0
				MESSAGEBOX("The FORM type requires a Dim2 value.",48,"Cannot Add.")
				RETURN .F.
			ENDIF
		CASE nSigDim = 3
			IF nDim1 <= 0
				MESSAGEBOX("The FORM type requires a Dim1 value.",48,"Cannot Add.")
				RETURN .F.
			ENDIF
			IF nDim2 <= 0
				MESSAGEBOX("The FORM type requires a Dim2 value.",48,"Cannot Add.")
				RETURN .F.
			ENDIF
			IF nDim3 <= 0
				MESSAGEBOX("The FORM type requires a Dim3 value.",48,"Cannot Add.")
				RETURN .F.
			ENDIF
		CASE nSigDim = 6
			IF nDim2 <= 0
				MESSAGEBOX("The FORM type requires a Dim2 value.",48,"Cannot Add.")
				RETURN .F.
			ENDIF
			IF nDim3 <= 0
				MESSAGEBOX("The FORM type requires a Dim3 value.",48,"Cannot Add.")
				RETURN .F.
			ENDIF
		OTHERWISE
			
		ENDCASE
		
		***
		*Error check!
		IF ThisForm.JustGotHere = .F.
			DO CASE 
			CASE nStockLst_PU = 1
				***Check QTY is not larger than the Detail QTY
				IF (nR_QTY+10)*.5 > (nDQTY+10) 
					cMess = "The Remove Item QTY:"+ALLTRIM(STR(nR_QTY))+CHR(13)+"cannot be larger than the"+CHR(13)+"StockLst Detail QTY:"+ALLTRIM(STR(nDQTY))+"."+CHR(13)+CHR(13)+"Edit and try to Add to Summary again."
					MESSAGEBOX(cMess,48,"Warning!")
					*TrackError( cMess_ID+CHR(13)+cMess ,"QTY mismatch",PROGRAM(),LINENO(1))
					RecordTest('Record Test Data.',PROGRAM(), LINENO(1), "QTY mismatch "+CHR(13)+cMess_ID+" "+CHR(13)+cMess)
					*RETURN .F.
				ENDIF
				IF (nWeight+10)*.5 > (nDWeight+10) 
					cMess = "The Remove Item Pounds:"+ALLTRIM(STR(nWeight))+CHR(13)+"cannot be larger than the"+CHR(13)+"StockLst Detail Pounds:"+ALLTRIM(STR(nDWeight))+"."+CHR(13)+CHR(13)+"Edit and try to Add to Summary again."
					MESSAGEBOX(cMess,48,"Warning!")
					*TrackError( cMess_ID+CHR(13)+cMess ,"Pounds mismatch",PROGRAM(),LINENO(1))
					RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "Pounds mismatch "+CHR(13)+cMess_ID+" "+CHR(13)+cMess)
					*RETURN .F.
				ENDIF
			CASE nStockLst_PU = 2
				*Check PC 	--PU of 2 means this must be exact PC!
				IF nPCs > nDPCs
					cMess = "The Remove PC:"+ALLTRIM(STR(nPCs))+CHR(13)+"cannot be larger than the"+CHR(13)+"StockLst Detail PC:"+ALLTRIM(STR(nDPCs))+"."+CHR(13)+CHR(13)+"Edit and try to Add to Summary again."
					MESSAGEBOX(cMess,48,"Warning!")
					*TrackError( cMess_ID+CHR(13)+cMess ,"PC mismatch",PROGRAM(),LINENO(1))
					RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "Pieces mismatch "+CHR(13)+cMess_ID+" "+CHR(13)+cMess)
					*RETURN .F.
				ENDIF
			CASE nStockLst_PU = 3
				*Check FT
				IF (nR_QTY+10)*.5 > (nDQTY+10) 
					cMess = "The Remove Item QTY:"+ALLTRIM(STR(nR_QTY))+CHR(13)+"cannot be larger than the"+CHR(13)+"StockLst Detail QTY:"+ALLTRIM(STR(nDQTY))+"."+CHR(13)+CHR(13)+"Edit and try to Add to Summary again."
					MESSAGEBOX(cMess,48,"Warning!")
					*TrackError( cMess_ID+CHR(13)+" "+cMess ,"QTY Feet mismatch",PROGRAM(),LINENO(1))
					RecordTest('Record Test Data.', PROGRAM(), LINENO(1), "QTY Feet mismatch "+CHR(13)+cMess_ID+" "+CHR(13)+cMess)
					*RETURN .F.
				ENDIF
			ENDCASE
		ENDIF
		ThisForm.JustGotHere = .F.
		***
		
		***********************
		**SAVE
		
		IF USED('tmpStkSum')
		
			SELECT tmpStkSum
			INSERT INTO tmpStkSum (PCs, Dim1, Dim2, Dim3, QTY, Weight) ;
				VALUES (nPCs, nDim1, nDim2, nDim3, nR_QTY, nWeight)
			
			GO TOP
			
			ThisForm.cmdDelSum.Enabled = .T.
			ThisForm.cmdEditSum.Enabled = .T.
			
			ThisForm.grdSummary.RecordSource = 'tmpStkSum'
			ThisForm.grdSummary.Refresh
			
			***************************************************************
			ThisForm.txtRecNo3.Value = RECNO('tmpStkSum')
			
		ENDIF
		
		ThisForm.EnterWeight3 = .F.
		ThisForm.EnterQTY3 = .F.
		
	ENDPROC

	PROCEDURE calcstockdetailweight
		*ThisForm.CalcStockDetailWeight()
		* update Weight and QTY on first line of dimms
		*depricated ThisForm.Calc_StockDetail_0
		
		PRIVATE nCalcWeight, nPieces, cAlloy, cForm, nSize1, nSize2, nSize3
		PRIVATE nQTY, nPounds, nCalc_QTY, nCalcWeight 
		nPieces	= PrepareSQLnum(ThisForm.txtPC.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		nSize1	= PrepareSQLnum(ThisForm.txtDim1.Value,'DIM11',10,4)
		nSize2	= PrepareSQLnum(ThisForm.txtDim2.Value,'DIM21',9,3)
		nSize3	= PrepareSQLnum(ThisForm.txtDim3.Value,'DIM31',9,3)
		nQTY	= PrepareSQLnum(ThisForm.txtQTY.Value,'QTY',-5)
		nPounds	= PrepareSQLnum(ThisForm.txtWeight.Value,'Pounds',9,1)
		
		nCalc_QTY	 = GetUnitQty(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		*nCalcWeight = CalcWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		nCalcWeight = GetWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		
		IF nQTY = 0
			nQTY = nCalc_QTY
			ThisForm.txtQTY.Value = nQTY
		ENDIF
		IF nPounds = 0
			nPounds = nCalcWeight
			ThisForm.txtWeight.Value = nPounds
		ENDIF
		
		IF (nQTY+10)*.8 > (nCalc_QTY+10) OR (nQTY+10) < (nCalc_QTY+10)*.8
			*fix
			nQTY = nCalc_QTY
			ThisForm.txtQTY.Value = nQTY
		ENDIF
		
		IF (nPounds+10)*.8 > (nCalcWeight+10) OR (nPounds+10) < (nCalcWeight+10)*.8
			*fix
			nPounds = nCalcWeight
			ThisForm.txtWeight.Value = nPounds
		ENDIF
		
		
		IF nCalcWeight > 0
			ThisForm.lblCalcPounds.Caption = ALLTRIM(STR(nPounds))+"#"
		ELSE
			ThisForm.lblCalcPounds.Caption = ''
		ENDIF
		
		
		nPieces	= PrepareSQLnum(ThisForm.txtPC1.Value,'Pieces',-3)
		cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
		cForm	= PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2)
		nSize1	= PrepareSQLnum(ThisForm.txtDim11.Value,'DIM11',10,4)
		nSize2	= PrepareSQLnum(ThisForm.txtDim21.Value,'DIM21',9,3)
		nSize3	= PrepareSQLnum(ThisForm.txtDim31.Value,'DIM31',9,3)
		
		*nCalcWeight = CalcWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		nCalcWeight = GetWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		
		IF nCalcWeight > 0
			ThisForm.txtWeight.Value = nCalcWeight
			ThisForm.lblCalcPounds.Caption = ALLTRIM(STR(nCalcWeight))+"#"
		ELSE
			ThisForm.lblCalcPounds.Caption = ''
		ENDIF
	ENDPROC

