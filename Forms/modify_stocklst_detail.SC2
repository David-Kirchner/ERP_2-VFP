	PROCEDURE Init
		PARAMETERS pTBL, pID_Detail, pID_Detail_Process, pSOitem, pPOitem, pWO, pWO_Detail, pRID, pHeat
		
		**DO FORM Forms\modify_stock4order WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO, nWO_Detail, nRID, cHeat
		*DO FORM Forms\Modify_Stocklst_Detail WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO, nWO_Detail, nRID, cHeat
		*DO FORM Forms\Modify_Stocklst_Detail WITH "S", 30440, 125503, '', '  504500-01', 1021
		
		IF VARTYPE(pTBL) != "C"
			TrackError("Error","TableName parameter Not Found",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF VARTYPE(pID_Detail) != "N"
			TrackError("Error","pID_Detail parameter Not Found",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		IF VARTYPE(pID_Detail_Process) != "N"
			TrackError("Error","pID_Detail_Process parameter Not Found",PROGRAM(),LINENO(1))
			RETURN .F.
		ENDIF
		
		
		
		IF VARTYPE(pTBL) = "C"
			ThisForm.cTBL = pTBL
			ThisForm.TxtTbl.Value = pTBL
		ELSE
			ThisForm.cTBL = ''
			ThisForm.txtTBL.Value = ''
		ENDIF
		
		IF VARTYPE(pID_Detail) = "N"
			ThisForm.nID_Detail = pID_Detail
			ThisForm.txtID_Detail.Value = pID_Detail
			
			PRIVATE nID	
			nID = Get_ID_by_ID_Detail(pID_Detail, ThisForm.cTBL, ThisForm.nConnHandle)
			ThisForm.txtID.Value = nID
		ENDIF
		IF VARTYPE(pID_Detail_Process) = "N"
			ThisForm.nID_Detail_Process = pID_Detail_Process
			ThisForm.txtID_Detail_Process.Value = pID_Detail_Process
		ENDIF
		IF VARTYPE(pSOitem) = "C"
			ThisForm.cSOitem = pSOitem
			ThisForm.txtSOitem.Value = pSOitem
		ENDIF
		IF VARTYPE(pPOitem) = "C"
			ThisForm.cPOitem = pPOitem
			ThisForm.txtPOitem.Value = pPOitem
		ENDIF
		
		IF VARTYPE(pWO) = "N"
			ThisForm.txtWO.Value = PrepareSQLnum(pWO,'WO',-3)
			ThisForm.nWO = PrepareSQLnum(pWO,'WO',-3)
			
			ThisForm.chkMarkInvCheck.Visible = .F.
		ENDIF
		
		IF VARTYPE(pWO_Detail) = "N"
			*ThisForm.txtWO_Detail.Value = pWO_Detail
			ThisForm.nWO_Detail = PrepareSQLnum(pWO_Detail,'WO_Detail',-3)
			
			ThisForm.chkMarkInvCheck.Visible = .F.
		ENDIF
		
		ThisForm.EnterWeight1 	= .F.
		ThisForm.EnterS_QTY 	= .F.
		ThisForm.EnterWeight3 	= .F.
		ThisForm.EnterQTY3 		= .F.
		
		IF NOT EMPTY(ALLTRIM(ThisForm.cTBL))
			ThisForm.GetByID_Detail_Process(ThisForm.cTBL)
		ELSE
			TrackError("Could not find cTBL value?","Could not find cTBL value?",Program(),LINENO())
		ENDIF
		
		ThisForm.RefreshForm()
		
		ThisForm.AddDetailSum()
		
		*ThisForm.Visible = .T.
		*ThisForm.AlwaysOnTop = .T.
		*ThisForm.AlwaysOnTop = .F.
		**ThisForm.txtPC3.SetFocus
		*ThisForm.cmdAddSum.SetFocus
		ThisForm.cmdDone.SetFocus
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_QUOTES ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ UPPER( SET("PROCEDURE") )
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF SET('SAFETY') = "ON"
			SET SAFETY OFF
		ENDIF
		
		PUBLIC ARRAY aConsumeQTY(14)
		
		
	ENDPROC

	PROCEDURE modify_brokerlst_detail_report
		PARAMETER pID_Detail_Process, pSOItem
		*ThisForm.Modify_BrokerLst_Detail_Report
		*Modify_BrokerLst_Detail_Report(m.ID_Detail_Process, m.SOItem)
		
		**********************************
		**********************************
		RETURN .T.
		
		
		
		
		
		
		
		
		
		
		
		PRIVATE cSOitem, nWO
		cSOitem	= PrepareSQLtxt(ThisForm.txtSOItem.Value,"SOitem",10)
		nWO = PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		
		**********************************
		**********************************
		
		IF VARTYPE(pID_Detail_Process) != 'N'
			pID_Detail_Process = 0
		ENDIF
		
		PRIVATE nMess
		nMess = 6
		
		PRIVATE nBE, nAE, nAD, nDL, nChange
		nChange = 0
		*****Just this Process
		PRIVATE cSQL
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		*
		
		IF pID_Detail_Process > 0
			cSQL = "SELECT SUM(ProcessValue) AS TotProc "
			cSQL = cSQL+" FROM dbo.[AR.BrokerLst_Detail_History] WITH(NOLOCK) "
			cSQL = cSQL+" WHERE ID_Detail_Process = "+ STR(pID_Detail_Process)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
				RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
			ELSE
				SELECT tmpDetail_Process_Report
				nChange = tmpDetail_Process_Report.TotProc
		
				IF ISNULL(nChange)
					nChange = 0
				ENDIF
				nChange = -( nChange )
				IF nChange = 0 
		*			MESSAGEBOX("There was no cost, or change in cost to apply to this order item from this Process."+CHR(13)+;
						"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
				ELSE
		*			MESSAGEBOX("The cost to apply to this order item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process."+CHR(13)+;
						"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
				ENDIF
			ENDIF
		
			IF USED("tmpDetail_Process_Report")
				USE IN tmpDetail_Process_Report
			ENDIF
		ENDIF
		
		******** Look for Other Process on this pSOItem
		IF TYPE("pSOitem") = "C"
			IF !EMPTY(pSOItem)
				SELECT 0
				
				cSQL =  "SELECT SUM(ProcessValue) AS TotProc "
				cSQL = cSQL+" FROM dbo.[AR.BrokerLst_Detail_History]  WITH(NOLOCK)"
				cSQL = cSQL + " WHERE ID_Detail_Process IN (SELECT ID_Detail_Process FROM dbo.BrokerLst_process "
				*cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pSOItem + "'))"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pSOItem + "'))"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpDetail_Process_Report')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDetail_Process_Report")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					SELECT tmpDetail_Process_Report
					nChange = tmpDetail_Process_Report.TotProc
					IF ISNULL(nChange)
						nChange = 0
					ENDIF
					nChange = -( nChange )
					IF nChange = 0
						* First zero Message was enough
					ELSE
		*				nMess = MESSAGEBOX("The cost to apply to this Sales Order Item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process.",4+32,"Sales Order Item Total")
					ENDIF
					
		*********** Update Sales Record!!!
					IF nMess = 6 &&Yes 
						IF TYPE("pSOItem") = "C"
					
							*UPDATE HPA!Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)
							IF Proper_SO_Item(pSOItem) != Proper_SO_Item("")
								Save_ItemCostinSales( nChange, pSOitem, ThisForm.nConnHandle )
							ELSE
								RecordError(0,"Not Associated with a Sales Order Item!",PROGRAM(),LINENO(1),"UPDATE Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)","frmShop_BrokerLst_Edit.Modify_BrokerLst_Detail_Report")
							ENDIF				
						ELSE
							RecordError(0,"Not Associated with a Sales Order Item!",PROGRAM(),LINENO(1),"UPDATE Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)","frmShop_BrokerLst_Edit.Modify_BrokerLst_Detail_Report")
						ENDIF
					ENDIF
				ENDIF &&nSQLEXEC
			ELSE
				MESSAGEBOX('Could NOT Calc for SOitem',0,"Empty SOitem!")
			ENDIF &&!EMPTY(pSOItem)
		ELSE
			MESSAGEBOX('Could NOT Calc for SOitem',0,"Empty SOitem!")
		ENDIF &&TYPE("pSOitem") = "C"
			
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		
	ENDPROC

