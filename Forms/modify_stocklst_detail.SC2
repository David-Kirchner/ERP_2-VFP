			cSQL = cSQL + ",[Location]"
			cSQL = cSQL + ",[FloorStatus]"
			cSQL = cSQL + ",[Class]"
			cSQL = cSQL + ",[Unit]"
			cSQL = cSQL + ",[RandLen]"
			cSQL = cSQL + ",[InvCheck]"
			cSQL = cSQL + ",[ID]"
			*    cSQL = cSQL + ",[ID_Detail]"
			cSQL = cSQL + ",[ReceivingID]"
			cSQL = cSQL + ",[InvoiceValue]"
			cSQL = cSQL + ",[LiveCheck]"
			cSQL = cSQL + ",[AccountingCheck]"
			cSQL = cSQL + ",[Quarantine]"
			cSQL = cSQL + ",[S_QTY]"
			cSQL = cSQL + ",[S_P]"
			cSQL = cSQL + ",[S_Total]"
			cSQL = cSQL + ",[S_PU]"
			cSQL = cSQL + ",[Prime]"
			cSQL = cSQL + ",[WO] )"
		
			cSQL = cSQL + " SELECT "
			cSQL = cSQL + " [Size_H]"
			cSQL = cSQL + ",[Size_L]"
			cSQL = cSQL + ",[PC]"
			cSQL = cSQL + ",[Dim1]"
			cSQL = cSQL + ",[Dim2]"
			cSQL = cSQL + ",[Dim3]"
			cSQL = cSQL + ",[Length]"
			cSQL = cSQL + ",[Weight]"
			cSQL = cSQL + ",[CostValue]"
			cSQL = cSQL + ",[Descript]"
			cSQL = cSQL + ",''" &&[Location]"
			cSQL = cSQL + ",''" &&[FloorStatus]"
			cSQL = cSQL + ",''" &&[Class]"
			cSQL = cSQL + ",''" &&[Unit]"
			cSQL = cSQL + ",[RandLen]"
			cSQL = cSQL + ",''" &&[InvCheck]"
			cSQL = cSQL + ","+STR(nNewWIP_ID)  &&[ID]"
			*    cSQL = cSQL + ",[ID_Detail]"
			cSQL = cSQL + ",''" &&[ReceivingID]"
			cSQL = cSQL + ",[InvoiceValue]"
			cSQL = cSQL + ",0" &&[LiveCheck]"
			cSQL = cSQL + ",0" &&[AccountingCheck]"
			cSQL = cSQL + ",0" &&[Quarantine]"
			cSQL = cSQL + ",[S_QTY]"
			cSQL = cSQL + ",[S_P]"
			cSQL = cSQL + ",[S_Total]"
			cSQL = cSQL + ",[S_PU]"
			cSQL = cSQL + ",[Prime]"
			cSQL = cSQL + ","+STR(nWO)
			DO CASE
