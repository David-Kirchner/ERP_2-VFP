	PROCEDURE trackuseredit
		PARAMETERS cMess
		*Thisform.TrackUserEdit(cMess)
		
		cMess = PrepareSQLtxt(cMess,'UserEdit',-1)
		
		PRIVATE cMessOld
		*cMessOld = PrepareSQLtxt(ThisForm.edtUserEdit.Value,'UserEdit',-1)
		cMessOld = ShowSQLtxt(ThisForm.edtUserEdit.Value,'UserEdit',-1)
		
		IF LEN( cMessOld ) = 0
			ThisForm.edtUserEdit.Value = cMess
		ELSE
			ThisForm.edtUserEdit.Value = cMess +". " + CHR(13) + cMessOld
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpSO_Dim1')
			USE IN tmpSO_Dim1
		ENDIF
		IF USED("tmpProcessWeight")
			USE IN tmpProcessWeight
		ENDIF
		IF USED("tmpDetailWeight")
