							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, "")
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					lOK	= .F.
				ELSE
					
					**************************************
					*Track
					*TrackMess(cSQL + CHR(13)+PROGRAM() )
					RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not move to WIP list."+CHR(13)+cSQL)
				ENDIF
			ELSE
				RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not move to WIP list.")
				TrackError("Could not INSERT INTO dbo.WIPLst_Process","ID_Detail was 0",PROGRAM(),LINENO(1))
			ENDIF
		ENDIF
		
		
		IF lOK
			WAIT WINDOW "Successfully made the WIP record." NOWAIT
		ELSE
			WAIT WINDOW "WIP record Failed to be made." TIMEOUT 1
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not move to WIP list.")
			RETURN .F.
		ENDIF
		
		*********************************************
		*now delete the Detail and Process
		
		IF NOT Remove_Lst_Detail_by_ID_Detail(cTBL,nID_Detail, ThisForm.nConnHandle, 'Copy_Stock_WIP', 'WO '+ALLTRIM(STR(nWO)) )
			lOK =.F.
			RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Could not move to WIP list.")
		ENDIF
		
		
		RETURN lOK
		
		
	ENDPROC

	PROCEDURE getbyid_detail_process
		PARAMETER pTbl
		*ThisForm.GetByID_Detail_Process()
		*Also used in Shop_StockLst_Edit
		
		IF VARTYPE(pTbl) != "C"
			TrackError("Bad parameter pTbl- Possible Error","VARTYPE(pTBL)="+VARTYPE(cTbl),PROGRAM(),LINENO(1))
		ENDIF
		
		PRIVATE cTbl
		cTbl = pTbl 
		ThisForm.txtTbl.Value = cTBL
		
		PRIVATE cSQLpID, nSQLEXEC, cSQLmpID 
		** may have to check History!
		cSQLpID = "SELECT D.Size_H,D.Size_L,D.PC,D.DIM1,D.DIM2,D.DIM3,D.Length,D.Weight,D.CostValue,D.Descript,D.[Location],D.FloorStatus,D.Class"
		cSQLpID = cSQLpID + ",D.ID,D.ID_Detail"
		cSQLpID = cSQLpID + ",P.SoItem"
		cSQLpID = cSQLpID + ",P.PO_Item, D.ReceivingID, D.InvoiceValue, D.S_QTY, D.S_P, D.S_PU"
		cSQLpID = cSQLpID + ",M.Alloy,m.Form,D.Prime,P.Process_ID"
		cSQLpID = cSQLpID + ",P.QTY, P.Pounds, P.Ordered_QTY "
		cSQLpID = cSQLpID + ",P.Prc_Form, P.Prc_PCs, P.Prc_Dim1, P.Prc_Dim2, P.Prc_Dim3 "
		DO CASE
		CASE cTBL = "S"
			cSQLpID = cSQLpID + " FROM dbo.StockLst_Process P"
			cSQLpID = cSQLpID + " INNER JOIN dbo.StockLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQLpID = cSQLpID + " INNER JOIN dbo.StockLst_Master M ON M.ID = D.ID "
		CASE cTBL = "B"
			cSQLpID = cSQLpID + " FROM dbo.BrokerLst_Process P"
			cSQLpID = cSQLpID + " INNER JOIN dbo.BrokerLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQLpID = cSQLpID + " INNER JOIN dbo.BrokerLst_Master M ON M.ID = D.ID "
		CASE cTBL = "W"
			cSQLpID = cSQLpID + " FROM dbo.WIPLst_Process P"
			cSQLpID = cSQLpID + " INNER JOIN dbo.WIPLst_Detail D ON P.ID_Detail = D.ID_Detail "
			cSQLpID = cSQLpID + " INNER JOIN dbo.WIPLst_Master M ON M.ID = D.ID "
		ENDCASE
		
		cSQLpID = cSQLpID + " WHERE P.ID_Detail_Process = "+ALLTRIM(STR(ThisForm.nID_Detail_Process))
		
		ThisForm.txtHeat.Visible = .F.
		ThisForm.lblHeat.Visible = .F.
		
		IF USED("StockLst_Detail_P")
			SELECT StockLst_Detail_P
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'StockLst_Detail_P')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'StockLst_Detail_P')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'StockLst_Detail_P')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, 'StockLst_Detail_P')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, "StockLst_Detail_P")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLpID, "StockLst_Detail_P")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQLpID, ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_P' )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLpID)
		ELSE
			PRIVATE cMess
			IF USED("StockLst_Detail_P")
				SELECT StockLst_Detail_P
				GO TOP
				IF StockLst_Detail_P.ID = 0
					* Found a blank!
					LOCATE FOR ID > 0  
				ENDIF
				IF StockLst_Detail_P.ID > 0		
					*PC,DIM1,DIM2,DIM3,Length,Weight,CostValue,[Location],FloorStatus,Class,Unit
					
					ThisForm.txtPc.Value = PrepareSQLnum(StockLst_Detail_P.PC,'Pc',-3)
					ThisForm.txtDIM1.Value = PrepareSQLnum(StockLst_Detail_P.DIM1,'Dim1',-5)
					ThisForm.txtDIM2.Value = PrepareSQLnum(StockLst_Detail_P.DIM2,'Dim2',-5)
					ThisForm.txtDIM3.Value = PrepareSQLnum(StockLst_Detail_P.DIM3,'Dim3',-5)
		
					ThisForm.txtQTY.Value 	 = PrepareSQLnum(StockLst_Detail_P.S_QTY,'QTY',-5)
					ThisForm.txtWeight.Value = PrepareSQLnum(StockLst_Detail_P.Weight,'Weight',9,1)
					ThisForm.txtCostValue.Value = PrepareSQLnum(StockLst_Detail_P.CostValue,'CostValue',-5)
					ThisForm.txtLocation.Value = ShowSQLtxt(StockLst_Detail_P.Location,'Location',10)
					ThisForm.txtFloorStatus.Value = ShowSQLtxt(StockLst_Detail_P.FloorStatus,'FloorStatus',1)
					ThisForm.txtClass.Value = ShowSQLtxt(StockLst_Detail_P.Class,'Class',1)
					
					PRIVATE cForm, nS_PU
					cForm = ShowSQLtxt(StockLst_Detail_P.Form,'Form',2)
					nS_PU = PrepareSQLnum(StockLst_Detail_P.S_PU,'S_PU',-1)
					
					IF nS_PU = 0
						nS_PU = GetPUfromForm(cForm, ThisForm.nConnHandle)  
					ENDIF
					ThisForm.txtS_PU.Value = PrepareSQLtxt(nS_PU,'S_PU',1)
		
					ThisForm.txtSize_H.Value = PrepareSQLnum(StockLst_Detail_P.Size_H,'Size_H',9,4)
					ThisForm.txtSize_L.Value = PrepareSQLnum(StockLst_Detail_P.Size_L,'Size_L',9,4)
					ThisForm.txtDescript.Value = ShowSQLtxt(StockLst_Detail_P.Descript,'Descript',20)
					
					ThisForm.txtID.Value = PrepareSQLnum(StockLst_Detail_P.ID,'ID',-3)
					ThisForm.txtID_Detail.Value = PrepareSQLnum(StockLst_Detail_P.ID_Detail,'ID_Detail',-3)
					ThisForm.nID_Detail			= PrepareSQLnum(StockLst_Detail_P.ID_Detail,'ID_Detail',-3)
					ThisForm.txtID_Detail_Process.Value = PrepareSQLnum(ThisForm.nID_Detail_Process,'ID_Detail_Process',-3)
					ThisForm.txtSOitem.Value  = ShowSQLtxt(StockLst_Detail_P.SOitem,'SOitem',10)
					ThisForm.txtPOitem.Value = ShowSQLtxt(StockLst_Detail_P.PO_Item,'POItem',12)
					
					ThisForm.txtPc1.Value = PrepareSQLnum(StockLst_Detail_P.PC,'Pc',-3)
					ThisForm.txtDIM11.Value = PrepareSQLnum(StockLst_Detail_P.DIM1,'Dim1',-5)
					ThisForm.txtDIM21.Value = PrepareSQLnum(StockLst_Detail_P.DIM2,'Dim2',-5)
					ThisForm.txtDIM31.Value = PrepareSQLnum(StockLst_Detail_P.DIM3,'Dim3',-5)
					ThisForm.txtLength1.Value = ShowSQLtxt(StockLst_Detail_P.Length,'Length',160)
					ThisForm.txtWeight1.Value = PrepareSQLnum(StockLst_Detail_P.Weight,'Weight',9,1)
					
					*ThisForm.txtPc2.Value = PrepareSQLnum(StockLst_Detail_P.pPc,'pPc',-3)
					ThisForm.txtPc2.Value = PrepareSQLnum(StockLst_Detail_P.PC,'Pc',-3)
					
					ThisForm.txtDIM22.Value = 0
					ThisForm.txtDIM32.Value = 0
					ThisForm.txtWeight2.Value = 0
					*ThisForm.txtWeight2.Value = PrepareSQLnum(StockLst_Detail_P.pWeight,'pWeight',-5)
					
					ThisForm.txtForm3.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_Form,'Form',2)
					ThisForm.txtPC3.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_PCs,'PCS',10)
					
					ThisForm.txtDim13.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_Dim1,'DIM1',10,4)
					IF ThisForm.txtDim13.Value <= 0
						ThisForm.txtDim13.Value		= PrepareSQLnum(StockLst_Detail_P.DIM1,'DIM1',10,4)
					ENDIF
					ThisForm.txtDim23.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_Dim2,'DIM2',9,3)
					ThisForm.txtDim33.Value		= PrepareSQLnum(StockLst_Detail_P.Prc_Dim3,'DIM3',9,3)
					ThisForm.txtQTY3.Value		= PrepareSQLnum(StockLst_Detail_P.QTY,'QTY',-5)
					ThisForm.txtWeight3.Value	= PrepareSQLnum(StockLst_Detail_P.Pounds,'Weight',9,1)
		
		*			ThisForm.txtLocation1.Value = IIF( ISNULL(StockLst_Detail_P.[Location]),'',StockLst_Detail_P.[Location])
					ThisForm.cmbLocation1.Value = ShowSQLtxt(StockLst_Detail_P.Location,'Location',10)
					ThisForm.txtFloorStatus1.Value = ShowSQLtxt(StockLst_Detail_P.FloorStatus,'FloorStatus',1)
					ThisForm.txtClass1.Value = ShowSQLtxt(StockLst_Detail_P.Class,'Class',1)
		
					ThisForm.txtSize_H1.Value = PrepareSQLnum(StockLst_Detail_P.Size_H,'Size_H',9,4)
					ThisForm.txtSize_L1.Value = PrepareSQLnum(StockLst_Detail_P.Size_L,'Size_L',9,4)
					ThisForm.txtDescript1.Value = ShowSQLtxt(StockLst_Detail_P.Descript,'Descript',20)
					ThisForm.chkPrime.Value		= PrepareSQLchk(StockLst_Detail_P.Prime,'Prime',.F.)
					
					ThisForm.txtAlloy1.Value = ShowSQLtxt(StockLst_Detail_P.Alloy,'Alloy',12)
					ThisForm.txtForm1.Value = cForm
					
					PRIVATE nReceivingID
					nReceivingID = PrepareSQLnum(StockLst_Detail_P.ReceivingID,'ReceivingID',-3)
					IF nReceivingID = 0
						nReceivingID = getReceivingIDHistory_ID_Detail(ThisForm.nID_Detail, cTBL, ThisForm.nConnHandle)
					ENDIF
					
					ThisForm.txtReceivingID.Value = nReceivingID
					
					IF ThisForm.txtReceivingID.Value = 0
		*				TrackError("Bad ReceivingID - Possible Error","nReceivingID=0 TBL="+cTbl+" ID_Detail_Process="+ALLTRIM(STR(ThisForm.nID_Detail_Process)) ,PROGRAM(),LINENO(1))
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1), "No ReceivingID "+CHR(13)+"nReceivingID=0 TBL="+cTbl+" ID_Detail_Process="+ALLTRIM(STR(ThisForm.nID_Detail_Process))+" "+CHR(13)+cSQLpID+CHR(10)+CHR(13)+"SELECT [When] FROM  dbo.[AR.Stocklst_Detail_History] WHERE [What] = 'ADD' AND ID_Detail_Process = "+ALLTRIM(STR(ThisForm.nID_Detail_Process)) )
					ENDIF
					
					PRIVATE nCostValue, nInvoiceValue, nS_QTY
					nCostValue		= PrepareSQLnum(StockLst_Detail_P.CostValue,'CostValue',-5)
					nInvoiceValue	= PrepareSQLnum(StockLst_Detail_P.InvoiceValue,'InvoiceValue',-5)
					nS_QTY			= PrepareSQLnum(StockLst_Detail_P.S_QTY,'QTY',-5)
					IF nInvoiceValue = 0
						nInvoiceValue = nCostValue * nS_QTY
					ENDIF
					ThisForm.txtInvoiceValue.Value	= nInvoiceValue
					
					ThisForm.txtProcess_ID.Value	= PrepareSQLtxt(StockLst_Detail_P.Process_ID,'Process_ID',10)
					
					PRIVATE m.nS_QTY, m.nS_P 
					m.nS_QTY = PrepareSQLnum(StockLst_Detail_P.S_QTY,'S_QTY',-5)
					m.nS_P	= PrepareSQLnum(StockLst_Detail_P.S_P,'S_P',-5)
					ThisForm.txtS_QTY.Value = IIF( m.nS_QTY=0,PrepareSQLnum(ThisForm.txtWeight1.Value,'S_QTY',9,1),m.nS_QTY)
					*ThisForm.txtS_P.Value = IIF( m.nS_P=0,PrepareSQLnum(ThisForm.txtCostValue.Value,'S_P',-5),m.nS_P)
					ThisForm.txtS_P.Value = PrepareSQLnum(StockLst_Detail_P.S_P,'S_P',-5)
					
					ThisForm.Calc_StockDetail_0()
					ThisForm.Calc_StockDetail_1()
					*ThisForm.Calc_StockDetail_3()  && done later in method
					
					ThisForm.Visible = .T.
					*ThisForm.RefreshForm()
					ThisForm.txtPc.SetFocus()
					
					ThisForm.getSalesProcess()
					
					IF cTbl = "S"
						*Get Heat from Master************
						cSQLmpID = "SELECT Heat FROM dbo.StockLst_Master WITH(NOLOCK) WHERE ID = "+ALLTRIM(STR(StockLst_Detail_P.ID))
		
						IF USED("StockLst_Detail_P")
							SELECT StockLst_Detail_P
						ELSE
							SELECT 0
						ENDIF
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, 'StockLst_M_P')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, 'StockLst_M_P')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, 'StockLst_M_P')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, 'StockLst_M_P')
							ENDDO
						ENDIF
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, "StockLst_M_P")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLmpID, "StockLst_M_P")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQLmpID, ThisForm.nConnHandle, nSQLEXEC, 'StockLst_M_P')
							RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQLmpID)
						ELSE
							IF USED("StockLst_M_P")
								ThisForm.txtHeat.Value = IIF( ISNULL(StockLst_M_P.HEAT),'',StockLst_M_P.Heat)
								ThisForm.txtHeat.Visible = .T.
								ThisForm.lblHeat.Visible = .T.
							ENDIF
						ENDIF
					ENDIF
					IF USED("StockLst_M_P")
						USE IN StockLst_M_P
					ENDIF
		
				ELSE
		
					IF MESSAGEBOX("Did not find the Process!"+CHR(13)+"Do you want to remove this bad Process now?",4,"Process points to missing stock!") = 6	
						IF Remove_ID_Detail_Process(ThisForm.nID_Detail_Process, "","", cTbl,ThisForm.nConnHandle,'CORRECTION')
						
							ThisForm.Release
							RETURN TO MASTER
						ENDIF			
						*IF NOT EMPTY(ThisForm.ID_Detail_Process_Name)
						*	HIDE WINDOW (ThisForm.ID_Detail_Process_Name)
						*ENDIF
					ELSE
						ThisForm.Visible = .T.
						ThisForm.RefreshForm()
						ThisForm.txtPc.SetFocus()
					ENDIF
				ENDIF
			ELSE
				cMess = "The 'Marked Inventory Detail Item' is gone."+CHR(13)+;
					"Select a new Inventory Detail item from the StockLst window."+CHR(13)+;
					"Double click to add the new Process"+CHR(13)
				cMess = cMess + "ID_Detail_Process:"+ALLTRIM(STR(ThisForm.nID_Detail_process))+CHR(13)+CHR(13)
		
				IF MESSAGEBOX(cMess+"Do you want to remove this bad Process now?",4,"Process points to missing stock!") = 6	
					IF Remove_ID_Detail_Process(ThisForm.nID_Detail_Process, "","", cTbl ,ThisForm.nConnHandle,'CORRECTION')
						ThisForm.Release
					ENDIF
					*IF NOT EMPTY(ThisForm.ID_Detail_Process_Name)
					*	HIDE WINDOW (ThisForm.ID_Detail_Process_Name)
					*ENDIF
				ELSE
					ThisForm.Visible = .T.
					ThisForm.RefreshForm()
					ThisForm.txtPc.SetFocus()
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("StockLst_Detail_P")
			USE IN StockLst_Detail_P
		ENDIF
		
		
		***************************************
		*fill in txtPC3 what is left to be Removed
		*Check PartSelect, Then SOitem in AllQuotes then WorkOrder
		
		***************************************
		*Fill Process 3 data
		PRIVATE cSQL, nSQLEXEC, nID_Detail 
		nID_Detail = PrepareSQLnum(ThisForm.txtID_Detail.Value,'ID_Detail',-3)
		
		PRIVATE npPcs, npSize1, npSize2, npSize3, nQTY3, npWeight 
		npPcs	= PrepareSQLnum(ThisForm.txtPC3.Value,'Peices',10)
		npSize1	= PrepareSQLnum(ThisForm.txtDim13.Value,'DIM1',10,4)
		npSize2	= PrepareSQLnum(ThisForm.txtDim23.Value,'DIM2',9,3)
		npSize3	= PrepareSQLnum(ThisForm.txtDim33.Value,'DIM3',9,3)
		npQTY3	= PrepareSQLnum(ThisForm.txtQTY3.Value,'QTY',18,4)
		npWeight = PrepareSQLnum(ThisForm.txtWeight3.Value,'Weight',7,1)
		
		*!*	*******************
		*!*	PRIVATE nCalcD_QTY, nCalcD_LBS
		*!*	nCalcD_QTY	= GetUnitQty(nDPCs, cAlloy, cForm, nDDim1, nDDim2, nDDim3, ThisForm.nConnHandle)
		*!*	nCalcD_LBS	= GetWeight(nDPCs, cAlloy, cForm, nDDim1, nDDim2, nDDim3, ThisForm.nConnHandle)
		
		*!*	*******************
		*!*	PRIVATE nCalc_QTY, nCalc_Weight
		*!*	nCalc_QTY	 = GetUnitQty(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		*!*	nCalc_Weight = CalcWeight(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		*!*	nCalc_Weight = GetWeight(nPCs, cAlloy, cForm, nDim1, nDim2, nDim3, ThisForm.nConnHandle)
		
		
		IF npSize2 = 0	&&Fix Process Dims
			IF Proper_SO_Item(ThisForm.cSOitem) != Proper_SO_Item('') AND ThisForm.nWO = 0
			
				IF USED("tmpSOitemDesc")
					SELECT tmpSOitemDesc
				ELSE
					SELECT 0
				ENDIF
				cSQL = "SELECT Pieces,Thck,Sz2,Sz3,Q_Qty,cWeight"
				cSQL = cSQL + " FROM dbo.AllQuotes WITH(NOLOCK) "
				cSQL = cSQL + " WHERE SOitem = '"+ThisForm.cSOitem+"'"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitemDesc' )
					RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
				ELSE
					IF USED("tmpSOitemDesc")
						IF RECCOUNT("tmpSOitemDesc") > 0
		
							ThisForm.txtPC3.Value	= tmpSOitemDesc.Pieces
							ThisForm.txtDim13.Value	= tmpSOitemDesc.Thck
							ThisForm.txtDim23.Value	= tmpSOitemDesc.Sz2
							ThisForm.txtDim33.Value	= tmpSOitemDesc.Sz3
							ThisForm.txtQTY3.Value	= tmpSOitemDesc.Q_Qty		&&Filled with Process Data
							ThisForm.txtWeight3.Value	= tmpSOitemDesc.cWeight	&&Filled with Process Data
		
						ENDIF
					ENDIF
				ENDIF
			ELSE
				IF ThisForm.nWO > 0
		
					PRIVATE cSQL, nSQLEXEC 
		
					IF USED("tmpSOitemDesc")
						SELECT tmpSOitemDesc
					ELSE
						SELECT 0
					ENDIF
					cSQL = "SELECT sPieces,sThck,sSz2,sSz3,sWeight,sWeight"
					cSQL = cSQL + " FROM dbo.WorkOrder WITH(NOLOCK) "
					cSQL = cSQL + " WHERE WO = "+STR(ThisForm.nWO)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitemDesc')
						ENDDO
					ENDIF
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSOitemDesc")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSOitemDesc' )
						RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
					ELSE
						IF USED("tmpSOitemDesc")
							IF RECCOUNT("tmpSOitemDesc") > 0
		
								ThisForm.txtPC3.Value	= tmpSOitemDesc.sPieces
								ThisForm.txtDim13.Value	= tmpSOitemDesc.sThck
								ThisForm.txtDim23.Value	= tmpSOitemDesc.sSz2
								ThisForm.txtDim33.Value	= tmpSOitemDesc.sSz3
								ThisForm.txtQTY3.Value	= tmpSOitemDesc.sWeight
								ThisForm.txtWeight3.Value	= tmpSOitemDesc.sWeight
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			**Check new numbers
			PRIVATE nCalcQTY, nCalcLBS, nPieces, cAlloy, cForm, nSize1, nSize2, nSize3
			nPieces	= PrepareSQLnum(ThisForm.txtPC3.Value,'Pieces',-3)
			cAlloy	= PrepareSQLtxt(ThisForm.txtAlloy1.Value,'Alloy',12)
			cForm	= Proper_Form(PrepareSQLtxt(ThisForm.txtForm1.Value,'Form',2))
			nSize1	= PrepareSQLnum(ThisForm.txtDim13.Value,'DIM1',10,4)
			nSize2	= PrepareSQLnum(ThisForm.txtDim23.Value,'DIM2',9,3)
			nSize3	= PrepareSQLnum(ThisForm.txtDim33.Value,'DIM3',9,3)
		
			nCalcQTY = GetUnitQty(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
			*nCalcLBS = CalcWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
			nCalcLBS = GetWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
			
			ThisForm.txtQTY3.Value	  = nCalcQTY 
			ThisForm.txtWeight3.Value = nCalcLBS 
		ENDIF
		
		ThisForm.Calc_StockDetail_3() &&no tmpStkSum 
		
		ThisForm.EnterWeight3 = .F.
		ThisForm.EnterQTY3 = .F.
	ENDPROC

	PROCEDURE getsalesprocess
		*ThisForm.GetSalesProcess()
		*Also used in Shop_StockLst_Edit
		
		ThisForm.ShowSalesProcess(.F.)
		
		IF USED("tmpSalesProcess")
			SELECT tmpSalesProcess
		ELSE
			SELECT 0
		ENDIF
		
		PRIVATE cSOitem
		cSOitem	= ThisForm.cSOitem
		
		PRIVATE cSQL
		cSQL = "SELECT Inv,GFM,Roll,Press,Mach,CG,Plasma,WJet "
		cSQL=cSQL+" FROM dbo.Sales WITH(NOLOCK) "
		cSQL=cSQL+" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesProcess')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesProcess')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesProcess')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSalesProcess')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesProcess")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSalesProcess")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSalesProcess' )
			RecordError(nSQLEXEC,'SQL Error',PROGRAM(),LINENO(1), cSQL )
		ELSE
			IF USED("tmpSalesProcess")
				SELECT tmpSalesProcess
				GO TOP
				IF RECCOUNT('tmpSalesProcess') > 0
		
					*ThisForm.txtPc.Value = IIF( ISNULL(tmpSalesProcess.PC),'',tmpSalesProcess.PC)
					ThisForm.chkINV.Value		= tmpSalesProcess.INV
					ThisForm.lblSOitem.Caption	= cSOitem
					ThisForm.chkGFM.Value		= tmpSalesProcess.GFM
					ThisForm.chkRoll.Value		= tmpSalesProcess.Roll
					ThisForm.chkPress.Value		= tmpSalesProcess.Press
					ThisForm.chkMach.Value		= tmpSalesProcess.Mach
					ThisForm.chkCG.Value		= tmpSalesProcess.CG
					ThisForm.chkPlasma.Value	= tmpSalesProcess.Plasma
					ThisForm.chkWJet.Value		= tmpSalesProcess.WJet
					
					ThisForm.ShowSalesProcess(.T.)			
				ENDIF
			ENDIF
		ENDIF			
	ENDPROC

