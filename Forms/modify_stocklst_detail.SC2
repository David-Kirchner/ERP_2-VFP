		*********************************
		*get the New ID_Detail
		PRIVATE nNewWIP_ID_Detail
		nNewWIP_ID_Detail = 0
		IF lOK
			IF USED("tmpWIP_ID_Detail")
				USE IN tmpWIP_ID_Detail
			ENDIF
			SELECT 0
		
			cSQL = "SELECT TOP 1 ID_Detail "
			cSQL = cSQL + " FROM dbo.WIPLst_Detail "
			cSQL = cSQL + " WITH(NOLOCK) " &&could be in transaction lock
			cSQL = cSQL + " WHERE ID="+STR(nNewWIP_ID)
			cSQL = cSQL + " AND WO="+STR(nWO) 
			cSQL = cSQL + " ORDER BY ID_Detail DESC "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, "tmpWIP_ID_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
