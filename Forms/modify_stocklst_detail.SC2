		*nCalcWeight = CalcWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		nCalcWeight = GetWeight(nPieces, cAlloy, cForm, nSize1, nSize2, nSize3, ThisForm.nConnHandle)
		
		IF nQTY = 0
			nQTY = nCalc_QTY
			ThisForm.txtQTY.Value = nQTY
		ENDIF
		IF nPounds = 0
			nPounds = nCalcWeight
			ThisForm.txtWeight.Value = nPounds
		ENDIF
		
		IF (nQTY+10)*.8 > (nCalc_QTY+10) OR (nQTY+10) < (nCalc_QTY+10)*.8
			*fix
