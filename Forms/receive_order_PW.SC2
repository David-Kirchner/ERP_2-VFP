	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdReceivedSO.Click
		PRIVATE nSO
		nSO = PrepareSQLnum(ThisForm.txtSO.Value,'SalesNum',-3)
		
		IF nSO < 1
			MESSAGEBOX("Need a Sales Order Number",0+48,"Number too small")
			ThisForm.lblPastSO.Caption = ""
			RETURN
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT COUNT(*) as CNT FROM dbo.Sales_No WHERE SalesNum ="+STR(nSO)
		
		IF USED("CountSO")
			SELECT CountSO
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'CountSO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'CountSO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CountSO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CountSO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'CountSO')
		ENDIF
		
		
		IF USED("CountSO")
			IF CountSO.CNT = 0
				MESSAGEBOX( "Did not Find the SO:"+ALLTRIM(STR(nSO)),0+48,"Not Found!")
				ThisForm.lblPastSO.Caption = "SO "+ALLTRIM(STR(nSO))+" not found!"
			ELSE
				*Check to See if Already Marked as ShopRecv
				cSQL = "SELECT COUNT(*) as CNT FROM dbo.Sales_No WHERE SalesNum ="+STR(nSO)+" AND ShopRecv = '1'"
		
				IF USED("CountSOr")
					SELECT CountSOr
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'CountSOr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'CountSOr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CountSOr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CountSOr")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'CountSOr')
				ENDIF
				
				IF USED("CountSOr")
					IF CountSOr.CNT = 0
						*Found SalesNo, not marked.
						*Get SO info to Display
						
						cSQL = "SELECT Q.Company, Q.SalesP, Q.SaleDate "
						cSQL = cSQL + " ,SN.Amendment, SN.ShopRecv, SN.Changing, SN.PrintedSO "
						cSQL = cSQL + " FROM dbo.AllQuotes Q "
						cSQL = cSQL + " INNER JOIN dbo.Sales_No SN ON Q.SalesNum = SN.SalesNum "
						cSQL = cSQL + " WHERE Q.SalesNum = "+STR(nSO)
						
						IF USED("AllQuotesSO")
							USE IN AllQuotesSO
						ENDIF
						
						SELECT 0
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AllQuotesSO')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'AllQuotesSO')
						ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "AllQuotesSO")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "AllQuotesSO")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'AllQuotesSO')
						ENDIF
						
						PRIVATE cCompany, cSalesP, cSaleDate
						cCompany = ""
						cSalesP = ""
						cSaleDate = ""
						PRIVATE nAmendment, lShopRecv, lChanging, lPrintedSO
						nAmendment	=  0
						lShopRecv	= .F.
						lChanging	= .F.
						lPrintedSO	= .F.
						
						IF USED("AllQuotesSO")
							IF RECCOUNT('AllQuotesSO') > 0
								cCompany = PrepareSQLtxt(AllQuotesSO.Company,'Company',30)
								cSalesP = PrepareSQLtxt(AllQuotesSO.SalesP,'SalesP',1)
								cSaleDate = ShowSQLtxt(AllQuotesSO.SaleDate,'SaleDate')
								nAmendment	= PrepareSQLnum(AllQuotesSO.Amendment,'Amendment',-3)
								lShopRecv	= PrepareSQLlogic(AllQuotesSO.ShopRecv,'ShopRecv',.F.)
								lChanging	= PrepareSQLlogic(AllQuotesSO.Changing,'Changing',.F.)
								lPrintedSO	= PrepareSQLlogic(AllQuotesSO.PrintedSO,'PrintedSO',.F.)
							ENDIF
							USE IN AllQuotesSO
						ENDIF
						
						PRIVATE cText
						cText = "Are you sure you want to mark as Receive?"+CHR(13)
						cText = cText + CHR(13) + "          SO:"+ALLTRIM(STR(nSO))
						cText = cText + CHR(13) + "   Amendment:"+ALLTRIM(STR(nAmendment))
						IF NOT EMPTY(cCompany)
							cText = cText + CHR(13)+"     Company:"+cCompany 
						ENDIF
						IF NOT EMPTY(cSalesP)
							cText = cText + CHR(13)+"      SalesP:"+cSalesP 
						ENDIF
						IF lShopRecv
							cText = cText + CHR(13) + "Shop Received"
						ELSE
							cText = cText + CHR(13) + "Not Shop Received"
						ENDIF
						
						IF lChanging
							cText = cText + CHR(13) + "Changing"
						ELSE
							cText = cText + CHR(13) + "NOT Changing"
						ENDIF
						
						IF lPrintedSO
							cText = cText + CHR(13) + "Printed SO"
						ELSE
							cText = cText + CHR(13) + "NOT Printed SO"
						ENDIF
						
						IF LEN(cSaleDate) > 0
							cText = cText + CHR(13)+"  SaleDate:"+cSaleDate
						ENDIF
						
						IF MESSAGEBOX(cText,4+32,"Found unmarked SO")=6 &&Yes
							*Mark SO
							
							cSQL = "UPDATE dbo.Sales_No SET ShopRecv = '1', Changing='0' WHERE SalesNum = "+STR(nSO)
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
							ENDIF					
							
							PRIVATE nAmendment
							nAmendment = Get_Amendment_Sales_No( nSO, ThisForm.nConnHandle)
							Track_Sales_No_Chng( "ReceiveSO ShopRecv", nSO, .T., nAmendment )
						
							ThisForm.txtSO.Value = 0
							ThisForm.lblPastSO.Caption = "Marked SO "+ALLTRIM(STR(nSO))+"!"
						ENDIF
					ELSE
						*Found SalesNo and already marked!
						MESSAGEBOX("Found SO:"+ALLTRIM(STR(nSO))+CHR(13)+"But it is already marked as Received by shop.",0+64,"Already marked")
						ThisForm.lblPastSO.Caption = "SO "+ALLTRIM(STR(nSO))+" was already received!"
					ENDIF
					USE IN CountSOr
				ELSE
					MESSAGEBOX( "Did not Find the SO and ShopRecv, Possible SQL error.",0+48,"Not Found!")
					ThisForm.lblPastSO.Caption = "SO "+ALLTRIM(STR(nSO))+" not found!"
				ENDIF	
			ENDIF
			USE IN CountSO
		ELSE
			MESSAGEBOX( "Did not Find the SO, Possible SQL error.",0+48,"Not Found!")
			ThisForm.lblPastSO.Caption = "SO "+ALLTRIM(STR(nSO))+" not found!"
		ENDIF
		
		ThisForm.txtSO.SetFocus
	ENDPROC

	PROCEDURE cmdReceiveWO.Click
		PRIVATE nWorkOrder
		nWorkOrder = PrepareSQLnum(ThisForm.txtWorkOrder.Value,'WorkOrder',-3)
		
		IF nWorkOrder < 1
			MESSAGEBOX("Need a Work Order Number",0+48,"Number too small")
			ThisForm.lblPastSO.Caption = ""
			RETURN
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT COUNT(*) as CNT FROM dbo.WorkOrder WHERE WO ="+STR(nWorkOrder)
		
		IF USED("CountSO")
			SELECT CountSO
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'CountSO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'CountSO')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CountSO")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CountSO")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'CountSO')
		ENDIF
		
		
		IF USED("CountSO")
			IF CountSO.CNT = 0
				MESSAGEBOX( "Did not Find the WO :"+ALLTRIM(STR(nWorkOrder)),0+48,"Not Found!")
				ThisForm.lblPastSO.Caption = "WO "+ALLTRIM(STR(nWorkOrder))+" not found!"
			ELSE
				*Check to See if Already Marked as ShopRecv
				cSQL = "SELECT COUNT(*) as CNT FROM dbo.WorkOrder WHERE WO ="+STR(nWorkOrder)+" AND ShopRecv = '1'"
		
				IF USED("CountSOr")
					SELECT CountSOr
				ELSE
					SELECT 0
				ENDIF
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'CountSOr')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'CountSOr')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CountSOr")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "CountSOr")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'CountSOr')
				ENDIF
				
				IF USED("CountSOr")
					IF CountSOr.CNT = 0
						*Found WorkOrder, not marked.
						*Get SO info to Display
						
						cSQL = "SELECT sAlloy, Descript, SalesRep, DueDate "
						cSQL = cSQL + " ,Amendment, ShopRecv, Changing, PrintedWO "
						cSQL = cSQL + " FROM dbo.WorkOrder WHERE WO ="+STR(nWorkOrder)
						
						IF USED("tmpWO_WO")
							SELECT tmpWO_WO
						ELSE
							SELECT 0
						ENDIF
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_WO')
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWO_WO')
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_WO")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpWO_WO")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpWO_WO')
						ENDIF
						
						PRIVATE csAlloy, cDescript, cfCondLevel
						csAlloy		= ''
						cDescript	= ''
						fCondLevel	= ''
						
		
						PRIVATE cSalesRep,cDueDate 
						cSalesRep = ""
						cDueDate = ""
						PRIVATE nAmendment, lShopRecv, lChanging, lPrintedWO
						nAmendment	=  0
						lShopRecv	= .F.
						lChanging	= .F.
						lPrintedWO	= .F.
						
						IF USED("tmpWO_WO")
							IF RECCOUNT('tmpWO_WO') > 0
								csAlloy		= ShowSQLtxt(tmpWO_WO.sAlloy,'Alloy',12)
								cDescript	= ShowSQLtxt(tmpWO_WO.Descript,'Descript',100)
		
								cSalesRep 	= PrepareSQLtxt(tmpWO_WO.SalesRep,'SalesRep',20)
								cDueDate 	= ShowSQLtxt(tmpWO_WO.DueDate,'DueDate')
								nAmendment	= PrepareSQLnum(tmpWO_WO.Amendment,'Amendment',-3)
								lShopRecv	= PrepareSQLlogic(tmpWO_WO.ShopRecv,'ShopRecv',.F.)
								lChanging	= PrepareSQLlogic(tmpWO_WO.Changing,'Changing',.F.)
								lPrintedWO	= PrepareSQLlogic(tmpWO_WO.PrintedWO,'PrintedWO',.F.)
							ENDIF
							
							USE IN tmpWO_WO
						ENDIF
						
						PRIVATE cText
						cText = "Are you sure you want to mark as Received?"+CHR(13)
						cText = cText + CHR(13) + "   WorkOrder:"+ALLTRIM(STR(nWorkOrder))
						cText = cText + CHR(13) + "   Amendment:"+ALLTRIM(STR(nAmendment))
						IF NOT EMPTY(csAlloy)
							cText = cText + CHR(13)+"Alloy:"+csAlloy
						ENDIF
		*				IF NOT EMPTY(fCondLevel)
		*					cText = cText + CHR(13)+"  fCondLevel:"+fCondLevel
		*				ENDIF
						IF LEN(cDescript) > 0
							cText = cText + CHR(13)+"Descript:"+cDescript
						ENDIF
						IF LEN(cSalesRep) > 0
							cText = cText + CHR(13)+"Sales Rep:"+cSalesRep 
						ENDIF
						IF lShopRecv
							cText = cText + CHR(13) + "Shop Received"
						ELSE
							cText = cText + CHR(13) + "Not Shop Received"
						ENDIF
						
						IF lChanging
							cText = cText + CHR(13) + "Changing"
						ELSE
							cText = cText + CHR(13) + "NOT Changing"
						ENDIF
						
						IF lPrintedWO
							cText = cText + CHR(13) + "Printed WO"
						ELSE
							cText = cText + CHR(13) + "NOT Printed WO"
						ENDIF
						
						IF LEN(cDueDate) > 0
							cText = cText + CHR(13)+"  Due Date:"+cDueDate 
						ENDIF
						
						IF MESSAGEBOX(cText,4+32,"Found unmarked SO")=6 &&Yes
							*********************************
							*Mark WO
							
							cSQL = "UPDATE dbo.WorkOrder SET ShopRecv='1', Changing='0' WHERE WO ="+STR(nWorkOrder)
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
								RETURN .F.
							ENDIF					
							
							ThisForm.txtSO.Value = 0
							ThisForm.txtWorkOrder.Value = 0
							
							ThisForm.lblPastSO.Caption = "Marked WorkOrder "+ALLTRIM(STR(nWorkOrder))+"!"
							
							*********************************
							*Mark WO_Detail
							
							cSQL = "UPDATE dbo.WorkOrder_Detail SET fPRecv='1', fMod='0' WHERE WO ="+STR(nWorkOrder)
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
							ENDDO
							IF nSQLEXEC < 0 &&Try again!
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								DO WHILE nSQLEXEC = 0
									WAIT WINDOW 'SQL 2' TIMEOUT 1
									nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
									
									IF nSQLEXEC < 0
										IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
											nSQLEXEC = 0
										ENDIF
									ENDIF
								ENDDO
							ENDIF 
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
								RETURN .F.
							ENDIF					
							*********************************
						ENDIF
					ELSE
						*Found SalesNo and already marked!
						MESSAGEBOX("Found WO:"+ALLTRIM(STR(nWorkOrder))+CHR(13)+"But it is already marked as Received by shop.",0+64,"Already marked")
						ThisForm.lblPastSO.Caption = "WO "+ALLTRIM(STR(nWorkOrder))+" was already received!"
					ENDIF
					USE IN CountSOr
				ELSE
					MESSAGEBOX( "Did not Find the WO and ShopRecv, Possible SQL error.",0+48,"Not Found!")
					ThisForm.lblPastSO.Caption = "WO "+ALLTRIM(STR(nWorkOrder))+" not found!"
				ENDIF	
			ENDIF
			USE IN CountSO
		ELSE
			MESSAGEBOX( "Did not Find the WO, Possible SQL error.",0+48,"Not Found!")
			ThisForm.lblPastSO.Caption = "WO "+ALLTRIM(STR(nWorkOrder))+" not found!"
		ENDIF
		
		ThisForm.txtSO.SetFocus
	ENDPROC

	PROCEDURE txtSO.Valid
		PRIVATE cText
		cText = This.Value
		
		IF NOT EMPTY(cText)
		*	ThisForm.cmdReceivedSO.Click
		ENDIF
	ENDPROC

	PROCEDURE txtWorkOrder.Valid
		PRIVATE cText
		cText = This.Value
		
		IF NOT EMPTY(cText)
		*	ThisForm.cmdReceivedWO.Click
		ENDIF
	ENDPROC

ENDDEFINE
