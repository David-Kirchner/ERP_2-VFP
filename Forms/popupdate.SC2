		DataSource = .NULL.
		Height = 0
		Left = 0
		Name = "Dataenvironment"
		Top = 0
		Width = 0
	*</PropValue>

ENDDEFINE

DEFINE CLASS frmpopupdate AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdReturn" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Caldatepicker1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtweeks" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdAddWeeks" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdResetDate" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: dreturndate
	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth.ico
		AlwaysOnTop = .T.
		AutoCenter = .T.
		BorderStyle = 0
		Caption = "Pick Date"
		Closable = .F.
		ControlBox = .F.
		Desktop = .F.
		DoCreate = .T.
		dreturndate = 
		Height = 65
		MDIForm = .F.
		Name = "frmPopupDate"
		ShowTips = .T.
		Width = 231
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'Caldatepicker1' AS caldatepicker WITH ;
		Left = 12, ;
		Name = "Caldatepicker1", ;
		TabIndex = 1, ;
		Top = 9, ;
		txtDate.Name = "txtDate", ;
		cmdCalendar.Name = "cmdCalendar"
		*< END OBJECT: ClassLib="..\libs\vfpcalendar.vcx" BaseClass="control" />

	ADD OBJECT 'cmdAddWeeks' AS commandbutton WITH ;
		Caption = "Add weeks", ;
		Height = 23, ;
		Left = 132, ;
		Name = "cmdAddWeeks", ;
		TabIndex = 5, ;
		Top = 36, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdResetDate' AS commandbutton WITH ;
		Caption = "Reset Date", ;
		Height = 23, ;
		Left = 12, ;
		Name = "cmdResetDate", ;
		TabIndex = 3, ;
		Top = 36, ;
		Width = 76
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdReturn' AS commandbutton WITH ;
		Caption = "Return", ;
		Height = 27, ;
		Left = 132, ;
		Name = "cmdReturn", ;
		TabIndex = 2, ;
		Top = 7, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'txtweeks' AS textbox WITH ;
		Alignment = 3, ;
		Format = "", ;
		Height = 23, ;
		Left = 96, ;
		MaxLength = 4, ;
		Name = "txtweeks", ;
		TabIndex = 4, ;
		Top = 36, ;
		Value = 0, ;
		Width = 31
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Destroy
		IF "VFPCALENDAR" $ SET("CLASSLIB")
			RELEASE CLASSLIB "LIBS\VFPCALENDAR"
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pStartDate, pCaption, nTop, nLeft
		
		*Replaced by olecalendar
		
		PRIVATE dStartDate
		dStartDate = DATE()
		
		IF TYPE("pStartDate") = "D"
			IF pStartDate != CTOD('')
				dStartDate = pStartDate
			ENDIF
		ENDIF
		
		IF TYPE("pStartDate") = "T"
			IF pStartDate != CTOT('')
				dStartDate = TTOD(pStartDate)
			ENDIF
		ENDIF
		ThisForm.dReturnDate = dStartDate
		
		IF VARTYPE(pCaption) = "C"
			This.Caption = pCaption
		ENDIF
		
		IF VARTYPE(nTop) = "N"
			ThisForm.Top = nTop
		ENDIF
		
		IF VARTYPE(nLeft) = "N"
			ThisForm.Left = nLeft
		ENDIF
		
		IF NOT "VFPCALENDAR" $ SET("CLASSLIB")
			SET CLASSLIB TO LIBS\VFPcalendar ADDITIVE
		ENDIF
		
		IF "VFPCALENDAR" $ SET("CLASSLIB")
			WAIT WINDOW "SET CLASSLIB TO LIBS\VFPcalendar ADDITIVE" NOWAIT
		ELSE
			MESSAGEBOX("SET CLASSLIB TO LIBS\VFPcalendar ADDITIVE",16,"Failed!")
		ENDIF
		
		ThisForm.Caldatepicker1.Value = dStartDate
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE Unload
		RETURN ThisForm.dReturnDate
	ENDPROC

	PROCEDURE cmdAddWeeks.Click
		PRIVATE nWeeks, dDatePicked, dReturnDate
		
		nWeeks = PrepareSQLnum(ThisForm.txtweeks.Value,'Weeks',-2)
		dDatePicked = PrepareSQLdate(ThisForm.Caldatepicker1.Value,'Date')
		
		IF nWeeks = 0
			MESSAGEBOX("Weeks number field is empty!",64,"Cannot Add Weeks to Date")
			RETURN .F.
		ENDIF
		
		PRIVATE nDays
		nDays = nWeeks * 7
		
		dReturnDate = dDatePicked + nDays
		ThisForm.Caldatepicker1.Value = dReturnDate 
		
	ENDPROC

	PROCEDURE cmdResetDate.Click
		ThisForm.Caldatepicker1.Value = DATE()
		
	ENDPROC

	PROCEDURE cmdReturn.Click
		PRIVATE dReturnDate
		PRIVATE nYear,nDay,nMonth
		
		dReturnDate	= ThisForm.Caldatepicker1.Value
		*dReturnDate = ShowSQLdate(ThisForm.Caldatepicker1.Value)
		
		*!*	IF nYear > 0 AND nDay > 0 AND nMonth > 0
		*!*		dReturnDate = DATE(nYear,nMonth,nDay)
		*!*	ENDIF
		
		IF TYPE("dReturnDate") = "D"
			ThisForm.dReturnDate = dReturnDate
		ENDIF
		
		ThisForm.Release
		
	ENDPROC

ENDDEFINE
