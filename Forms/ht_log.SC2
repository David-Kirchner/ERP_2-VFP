	PROCEDURE txtTestItemPO.Valid
		PRIVATE nTestItemPO, nTestPO
		nTestPO		= PrepareSQLnum(ThisForm.txtTestPO.Value,'TestPO',9)
		nTestItemPO = PREPARESQLnum(ThisForm.txtTestItemPO.Value,'TestItemPO',2)
		
		IF !EMPTY(nTestPO) AND !EMPTY(nTestItemPO)
			ThisForm.txtTestPoItem.Value = Proper_PO_Item( STR(nTestPO)+"-"+STR(nTestItemPO,2,0) )
		*	REPLACE TestPOitem WITH STR(TestPO,9,0)+"-"+IIF(nTestItemPO<10,"0","")+Alltrim(STR(nTestItemPO,2,0))
		ENDIF
	ENDPROC

	PROCEDURE txtTestItemPO.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE txtTestpo.Valid
		PRIVATE nTestItemPO, nTestPO
		nTestPO		= PrepareSQLnum(ThisForm.txtTestPO.Value,'TestPO',9)
		nTestItemPO = PREPARESQLnum(ThisForm.txtTestItemPO.Value,'TestItemPO',2)
		
		IF !EMPTY(nTestPO) AND !EMPTY(nTestItemPO)
			ThisForm.txtTestPoItem.Value = Proper_PO_Item( STR(nTestPO)+"-"+STR(nTestItemPO,2,0) )
		*	REPLACE TestPOitem WITH STR(TestPO,9,0)+"-"+IIF(nTestItemPO<10,"0","")+Alltrim(STR(nTestItemPO,2,0))
		ENDIF
	ENDPROC

	PROCEDURE txtTestpo.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE txtTestPoItem.When
		RETURN ThisForm.isediting
	ENDPROC

	PROCEDURE txtTestsent.When
		PRIVATE nID
		nID = ThisForm.txtID.Value
		
		IF NOT USED('HT_Log')
			ThisForm.Load_Log(nID)
		ENDIF
		
		SELECT HT_Log
		IF ThisForm.isediting
			IF NOT EMPTY(HT_Log.testpo) AND EMPTY(HT_Log.testsent)
				REPLACE HT_Log.Testsent WITH DATE()
			ENDIF
			RETURN .T.
		ELSE	
			RETURN .F.
		ENDIF
		
	ENDPROC

	PROCEDURE txtWO_Detail.When
		RETURN ThisForm.isediting
	ENDPROC

