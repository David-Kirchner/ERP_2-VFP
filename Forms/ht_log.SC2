	PROCEDURE cmdAddTC.Click
		PRIVATE nID, nLot, nLotID, cLotID
		nID	= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		IF nID < 1
			MESSAGEBOX("Did not find the ID to Update")
			RETURN
		ENDIF
		nLot = PrepareSQLnum(ThisForm.txtLot.Value,'ID',-3)
		nLotID = PrepareSQLnum(ThisForm.Lots.Caption,'Lots',-3)
		IF nLot > 0
			IF nLotID = 0
				cLotID = ALLTRIM(STR(nLot))
			ELSE
				IF nLotID = 1
					cLotID = ALLTRIM(STR(nLot))
				ELSE
					cLotID = ALLTRIM(STR(nLot))+"-"+ALLTRIM(STR(nLotID))
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Did not find the Lot to Update")
			RETURN
		ENDIF
		
		
		DO FORM \Forms\ThermalCoupleUseAdd.scx WITH 'H',nID,nLot,nLotID
		
		SELECT HT_Log
		
	ENDPROC

	PROCEDURE cmdBalloy.Message
		RETURN 'Locate a record of the same alloy.'
	ENDPROC

	PROCEDURE cmdBalloy.Valid
		SELECT HT_Log
		Private cAlloyName
		cAlloyName = HT_Log.Alloyname
		
		BROWSE FOR alloyname = cAlloyName
		SCATTER MEMO MEMVAR
		
		ThisForm.Refresh_Log()
		
	ENDPROC

	PROCEDURE cmdBrow.Message
		RETURN 'Browse for records.'
	ENDPROC

	PROCEDURE cmdBrow.Valid
		SELECT HT_Log
		browse
		ThisForm.Refresh_Log()
		
	ENDPROC

	PROCEDURE cmdCert.Valid
		SELECT HT_Log
		ThisForm.AlwaysOnTop = .F.
		DO FORM 'Forms\ERP_CERTS' WITH HT_Log.Heat, HT_Log.Lot, "HT"
		
		SELECT HT_Log
		
		
	ENDPROC

	PROCEDURE cmdChartData.Click
		PRIVATE nID, nLot, nLotID, cLotID
		nID	= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		
		IF nID < 1
			MESSAGEBOX("Did not find the ID to Update")
			RETURN
		ENDIF
		nLot = PrepareSQLnum(ThisForm.txtLot.Value,'ID',-3)
		nLotID = PrepareSQLnum(ThisForm.Lots.Caption,'Lots',-3)
		IF nLot > 0
			IF nLotID = 0
				cLotID = ALLTRIM(STR(nLot))
			ELSE
				IF nLotID = 1
					cLotID = ALLTRIM(STR(nLot))
				ELSE
					cLotID = ALLTRIM(STR(nLot))+"-"+ALLTRIM(STR(nLotID))
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Did not find the Lot to Update")
			RETURN
		ENDIF
		
		PRIVATE cFileName, cFileContents
		cFileName = ''
		
		IF This.Caption = "Add"
			*Get File
			***breaks over 240 Character!!
			cFileName = GETFILE("CSV" , "Find the Chart Data", "Find", 0 , "Chart Data as CSV")
			IF VARTYPE(cFileName) = "C"
				IF NOT ".CSV" $ cFileName
					MESSAGEBOX("Must Choose a CSV file")
					RETURN
				ENDIF
				IF FILE(cFileName)
		
					Local nFileHandle,nSize,cString
					nFileHandle = FOPEN(cFileName)
					* Seek to end of file to determine number of bytes in the file.
					nSize =  FSEEK(nFileHandle, 0, 2)     && Move pointer to EOF
					IF nSize <= 0
						* If file is empty, display an error message.
						WAIT WINDOW "This file is empty!" NOWAIT
						RETURN
					ELSE
						* If file is not empty, store the file's contents in memory
						* and display the text in the main Visual FoxPro window.
						= FSEEK(nFileHandle, 0, 0)      && Move pointer to BOF
						cFileContents = FREAD(nFileHandle, nSize)
					ENDIF
					= FCLOSE(nFileHandle)         && Close the file
		
					cFileContents  = STRTRAN(cFileContents ,"'","''")
					
					PRIVATE cSQL
					cSQL = "UPDATE dbo.HT_Log SET "
					cSQL = cSQL + " ChartData = '1'"
					cSQL = cSQL + " WHERE ID="+STR(nID)
		
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
					ELSE
											
						cSQL = "INSERT INTO dbo.Log_Charts ([Log],[LogID],[Lot],[LotID],[ChartData]) VALUES ("
						cSQL = cSQL + "'R'"
						cSQL = cSQL + ","+ALLTRIM(STR(nID))
						cSQL = cSQL + ","+ALLTRIM(STR(nLot))
						cSQL = cSQL + ","+ALLTRIM(STR(nLotID))
						cSQL = cSQL + ",'"+cFileContents+"'"
						cSQL = cSQL + " )"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
						ELSE
							WAIT WINDOW 'Updated!' NOWAIT
							This.Caption = "Export"
							UPDATE HT_Log SET ChartData = .T.
						ENDIF
		
					ENDIF
				ENDIF
			ENDIF
		
		ELSE
			*Export
			*Get File
		
			***breaks over 240 Character!!
			Local nFileHandle
			
		*	cFileName = GETFILE("CSV" , "Name for Chart Data?", "Find", 0 , "Chart Data as CSV")
			IF NOT EMPTY(cFileName)
				IF NOT ".CSV" $ UPPER(cFileName)
					cFileName = cFileName + ".CSV"
				ENDIF
				IF FILE(cFileName)
					nFileHandle = FOPEN(cFileName,11)
					IF nFileHandle < 0
						WAIT 'Cannot open or create output file' WINDOW NOWAIT
					ELSE
						IF USED('Log_Charts')
							USE IN Log_Charts
						ENDIF
						SELECT 0
						
						cSQL = "SELECT [ChartData] FROM dbo.Log_Charts WHERE "
						*[ChartData]
						cSQL = cSQL + "[Log]='R'"
						cSQL = cSQL + " AND [LogID]="+ALLTRIM(STR(nID))
						cSQL = cSQL + " AND [Lot]="+ALLTRIM(STR(nLot))
						cSQL = cSQL + " AND [LotID]="+ALLTRIM(STR(nLotID))
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'Log_Charts' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL,'Log_Charts'  )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'Log_Charts' )
						ELSE
							IF USED('Log_Charts')
								IF VARTYPE(Log_Charts.ChartData) = "C"
									= FWRITE(nFileHandle, Log_Charts.ChartData )
								ENDIF
								USE IN Log_Charts
							ENDIF
						ENDIF
						
						= FCLOSE(nFileHandle)         && Close the file
						MESSAGEBOX("File is Ready")
					ENDIF
				ELSE
					
					nFileHandle= FCREATE(cFileName,0)
					IF nFileHandle < 0
						WAIT 'Cannot open or create output file' WINDOW NOWAIT
					ELSE
						IF USED('Log_Charts')
							USE IN Log_Charts
						ENDIF
						SELECT 0
						
						cSQL = "SELECT [ChartData] FROM dbo.Log_Charts WHERE "
						*[ChartData]
						cSQL = cSQL + "[Log]='R'"
						cSQL = cSQL + " AND [LogID]="+ALLTRIM(STR(nID))
						cSQL = cSQL + " AND [Lot]="+ALLTRIM(STR(nLot))
						cSQL = cSQL + " AND [LotID]="+ALLTRIM(STR(nLotID))
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'Log_Charts' )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL,'Log_Charts'  )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'Log_Charts' )
						ELSE
							IF USED('Log_Charts')
								IF VARTYPE(Log_Charts.ChartData) = "C"
									= FWRITE(nFileHandle, Log_Charts.ChartData )
								ENDIF
								USE IN Log_Charts
							ENDIF
						ENDIF
						= FCLOSE(nFileHandle)         && Close the file
						MESSAGEBOX("Created File C:\Program Files\HPA\"+cFileName,0+64,'New file Ready' )
					ENDIF
				ENDIF
				
			ELSE
		
				cFileName = "HT_Log "+cLotID+".CSV"
				nFileHandle= FCREATE(cFileName,0)
				*nFileHandle = FOPEN(cFileName,11)
				IF nFileHandle < 0
					WAIT 'Cannot open or create output file' WINDOW NOWAIT
				ELSE
				
					IF USED('Log_Charts')
						USE IN Log_Charts
					ENDIF
					SELECT 0
					
					cSQL = "SELECT * FROM dbo.Log_Charts WHERE "
					*[ChartData]
					cSQL = cSQL + "[Log]='R'"
					cSQL = cSQL + " AND [LogID]="+ALLTRIM(STR(nID))
					cSQL = cSQL + " AND [Lot]="+ALLTRIM(STR(nLot))
					cSQL = cSQL + " AND [LotID]="+ALLTRIM(STR(nLotID))
		
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL,'Log_Charts' )
		
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL,'Log_Charts'  )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Log_Charts")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC,'Log_Charts' )
					ELSE
						IF USED('Log_Charts')
							IF VARTYPE(Log_Charts.ChartData) = "C"
								*= FWRITE(nFileHandle, Log_Charts.ChartData )
								nBytesWritten = FPUTS(nFileHandle, Log_Charts.ChartData )
							ENDIF
							USE IN Log_Charts
						ENDIF
					ENDIF
					
					
					= FCLOSE(nFileHandle)         && Close the file
					MESSAGEBOX("Created File "+cFileName+" in C:\Program Files\HPA ",0+64,'New file Ready' )
				ENDIF
		
			ENDIF
		
		ENDIF
	ENDPROC

	PROCEDURE cmdClone.Valid
		SELECT HT_Log
		IF !ThisForm.isediting &&add record
			ThisForm.isediting=.T.
			ThisForm.IsAdding=.T.
			ThisForm.cmdEdit.Caption="Save"
			ThisForm.cmdDel.Caption="Abort"
			ThisForm.cmdTop.enabled = .F.
			ThisForm.cmdPrev.enabled = .F.
			ThisForm.cmdNext.enabled = .F.
			ThisForm.cmdEnd.enabled = .F.
			ThisForm.cmdSeeAll.enabled = .F.
			ThisForm.cmdCert.enabled = .F.
			ThisForm.cmdSO.enabled = .F.
			ThisForm.cmdRA.enabled = .F.
		*	ThisForm.cmdSsheet.enabled = .F.
			ThisForm.cmdBrow.enabled = .F.
			ThisForm.cmdReport.enabled = .F.	
			ThisForm.cmdBalloy.enabled = .F.	
			ThisForm.cmdClone.enabled = .F.	
			ThisForm.cmdAdd.enabled = .F.	
			ThisForm.cmdPrint.enabled = .F.	
			ThisForm.cmdClose.enabled = .F.	
			ThisForm.cmdStockLst.Enabled = .F.
		
		*	SCATTER MEMVAR MEMO    && NO BLANK TO CLONE
		*	INSERT INTO HT_Log FROM MEMVAR
		*	_CUROBJ=1
		*	m.countlot = 0
			
			ThisForm.txtLot.Value = 0
			ThisForm.txtDate.Value 		= DATE()
			ThisForm.txtID.Value		= 0
			ThisForm.DupLots()	&&*ThisForm.Lots.Caption		
			
			*ThisForm.Refresh_Log()
			MESSAGEBOX("Cloned record is ready to edit"+CHR(13)+"Click Lot to get next lot number",0+48,"Record Ready, showing old Lot.")
		*	WAIT WINDOW 'RECORD IS READY TO MODIFY' NOWAIT
			
			ThisForm.txtAlloyName.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE cmdClose.Valid
		THISFORM.Release
		m.bailout=.T.	&&this is needed if used with FoxApp
		
		
	ENDPROC

	PROCEDURE cmdDel.Valid
		SELECT HT_Log
		IF ThisForm.isediting 	&&cancel record
			IF ThisForm.IsAdding
		*		=TABLEREVERT()
				GO BOTTOM 
				ThisForm.Refresh_Log()
				ThisForm.Refresh
			ENDIF
			
			ThisForm.isediting=.F.
			ThisForm.IsAdding=.F.
		*	UNLOCK
		
			this.Caption="\<Delete"
			ThisForm.cmdEdit.Caption="\<Edit"
			ThisForm.cmdTop.enabled = .T.
			ThisForm.cmdPrev.enabled = .T.
			ThisForm.cmdNext.enabled = .T.
			ThisForm.cmdEnd.enabled = .T.
			ThisForm.cmdSeeAll.enabled = .T.
			ThisForm.cmdCert.enabled = .T.
			ThisForm.cmdSO.enabled = .T.
			ThisForm.cmdRA.enabled = .T.
		*	ThisForm.cmdSsheet.enabled = .T.
			ThisForm.cmdBrow.enabled = .T.
			ThisForm.cmdReport.enabled = .T.
			ThisForm.cmdBalloy.enabled = .T.
			ThisForm.cmdClone.enabled = .T.
			ThisForm.cmdAdd.enabled = .T.
			ThisForm.cmdPrint.enabled = .T.
			ThisForm.cmdClose.enabled = .T.
			ThisForm.cmdStockLst.Enabled = .T.
		
			WAIT WINDOW 'Cancelled' NOWAIT
			thisform.Refresh
		
		ELSE
			SELECT HT_Log 
			IF MESSAGEBOX("Are ou sure you want to Delete?",32,"Delete LOT") !=6
				RETURN -1
			ENDIF
			
		
			IF NOT HavePermission('DeleteMFGlog',.T.)
				MESSAGEBOX('You are not allowed to Delete')
				RETURN -1
			ENDIF
		
			
			PRIVATE nID, cSQL, nSQLEXEC 
			nID = ThisForm.txtID.Value
			
			IF nID > 0
				cSQL = "DELETE FROM dbo.HT_Log WHERE ID ="+STR(nID)
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC )
				ELSE
					WAIT WINDOW 'Deleted record!' NOWAIT
					ThisForm.Load_Log()			
				ENDIF
				
			ENDIF
		
		*		IF EOF()
		*			WAIT WINDOW 'End of file.' NOWAIT
		*			GO BOTTOM
		*		ENDIF
			
		
			
			thisform.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE cmdEdit.Valid
		SELECT HT_Log
		
		IF !ThisForm.isediting &&edit record
			*Start Editing
			IF EOF() OR BOF()
				WAIT WINDOW 'End of File' NOWAIT
				RETURN
			ENDIF
		
			ThisForm.GetLatestData()
		
				ThisForm.isediting=.T.
				this.Caption="Save"
				ThisForm.cmdDel.Caption="Abort"
				ThisForm.cmdTop.enabled = .F.
				ThisForm.cmdPrev.enabled = .F.
				ThisForm.cmdNext.enabled = .F.
				ThisForm.cmdEnd.enabled = .F.
				ThisForm.cmdSeeAll.enabled = .F.
				ThisForm.cmdCert.enabled = .F.
				ThisForm.cmdSO.enabled = .F.
				ThisForm.cmdRA.enabled = .F.
		*		ThisForm.cmdSsheet.enabled = .F.
				ThisForm.cmdBrow.enabled = .F.
				ThisForm.cmdReport.enabled = .F.
				ThisForm.cmdBalloy.enabled = .F.
				ThisForm.cmdClone.enabled = .F.
				ThisForm.cmdAdd.enabled = .F.
				ThisForm.cmdPrint.enabled = .F.
				ThisForm.cmdClose.enabled = .F.
				ThisForm.cmdStockLst.Enabled = .F.
				
				ThisForm.txtAlloyname.SetFocus
				thisform.Refresh
				RETURN
		
		ELSE
			*SAVE!
			
		
			IF ThisForm.CheckSave()
				IF ThisForm.Save_Log()
					
					this.Caption="Ed\<it"
					ThisForm.cmdDel.Caption="\<Delete"
					ThisForm.cmdTop.enabled = .T.
					ThisForm.cmdPrev.enabled = .T.
					ThisForm.cmdNext.enabled = .T.
					ThisForm.cmdEnd.enabled = .T.
					ThisForm.cmdSeeAll.enabled = .T.
					ThisForm.cmdCert.enabled = .T.
					ThisForm.cmdSO.enabled = .T.
					ThisForm.cmdRA.enabled = .T.
				*	ThisForm.cmdSsheet.enabled = .T.
					ThisForm.cmdBrow.enabled = .T.
					ThisForm.cmdReport.enabled = .T.
					ThisForm.cmdBalloy.enabled = .T.
					ThisForm.cmdClone.enabled = .T.
					ThisForm.cmdAdd.enabled = .T.
					ThisForm.cmdPrint.enabled = .T.
					ThisForm.cmdClose.enabled = .T.
					ThisForm.cmdStockLst.Enabled = .T.
						
					ThisForm.isediting=.F.
					ThisForm.IsAdding=.F.
					thisform.Refresh
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

