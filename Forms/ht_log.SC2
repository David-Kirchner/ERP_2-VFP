	PROCEDURE cmdEnd.Valid
		IF USED('HT_Log')
			SELECT HT_Log
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened.",0+48,"Reload table")
			ThisForm.Load_Log()
		ENDIF
		
		GO BOTTOM
		WAIT WINDOW 'End of File' NOWAIT
		
		ThisForm.Refresh_Log()
		ThisForm.Refresh
	ENDPROC

	PROCEDURE cmdNext.Valid
		IF USED('HT_Log')
			SELECT HT_Log
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened.",0+48,"Reload table")
			ThisForm.Load_Log()
		ENDIF
		
		IF !EOF()
			SKIP 1
		ENDIF
		IF EOF()
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM
		ENDIF
		ThisForm.Refresh_Log()
		*ThisForm.DupLots()
		ThisForm.Refresh
		
	ENDPROC

	PROCEDURE cmdPrev.Valid
		IF USED('HT_Log')
			SELECT HT_Log
		ELSE
			MESSAGEBOX("Lost table!!!"+CHR(13)+"Table will be re opened.",0+48,"Reload table")
			ThisForm.Load_Log()
		ENDIF
		
		IF !BOF()
			SKIP -1
		ENDIF
		IF BOF()
			WAIT WINDOW 'Top of file - Use See All for more!' NOWAIT
			GO TOP
		ENDIF
		ThisForm.Refresh_Log()
		*ThisForm.DupLots()
		Thisform.refresh
	ENDPROC

	PROCEDURE cmdPrint.Valid
		SELECT HT_Log
		PRIVATE curgrec
		curgrec = RECNO('HT_Log')
		REPORT FORM reports\HT_Log RECORD (curgrec) TO PRINT PROMPT NOCONSOLE
		SELECT HT_Log
		GO curgrec
		RETURN
		
	ENDPROC

	PROCEDURE cmdRA.Valid
		SELECT HT_Log
		DO CASE
		*CASE FILE('\program files\VFP\GFM\Forms\RedArea.scx')
		*	DO FORM '\program files\VFP\GFM\Forms\RedArea'
		*CASE FILE('\program files\VFP\GFM\RedArea.EXE')
		*	DO '\program files\VFP\GFM\RedArea.EXE'
		CASE FILE('Forms\RedArea.SCX')
			DO Forms\RedArea
		OTHERWISE
			redarea=LOCFILE("redarea","EXE","Find Reduction of Area")
			IF "REDAREA" $ UPPER(redarea)
				DO (redarea)
			ELSE
				WAIT WINDOW 'Reduction of Area Program not found' NOWAIT
			ENDIF
		ENDCASE
		SELECT HT_Log
		
	ENDPROC

