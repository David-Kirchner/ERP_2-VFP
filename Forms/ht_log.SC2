	PROCEDURE txtSalesnum.Valid
		SELECT HT_Log
		PRIVATE nSalesNum,nItemSO
		nSalesNum = This.Value
		nItemSO = ThisForm.txtItemSO.Value
		
		IF nSalesNum > 0 AND nItemSO > 0
			SELECT HT_Log
			REPLACE SOItem WITH Proper_So_Item( STR(nSalesNum)+"-"+IIF(nItemSO <10,"0"+STR(nItemSO ,1,0), STR(nItemSO ,2,0) ))
		ENDIF
	ENDPROC

	PROCEDURE txtSalesnum.When
		RETURN ThisForm.isediting
	ENDPROC

