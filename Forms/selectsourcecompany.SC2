	PROCEDURE Init
		*DO FORM Forms\SelectSourceCompany TO cReturnValue
		*ThisForm.cReturnValue = SourcePH.Person+SourcePH.Company+SourcePH.Phone+SourcePH.fax+SourcePH.email+SourcePH.email2
		
		ThisForm.oldAlias = ALIAS()
		
		IF USED('SourcePH')
			USE IN SourcePH
		ENDIF
		
		SELECT 0
		cSQL = "SELECT * FROM dbo.SourcePH ORDER BY Company"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"SourcePH")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'SourcePH')
		ENDIF
		
		IF NOT USED('SourcePH')
			MESSAGEBOX( "Could not loading the SourcePH table.","Program Error")
			RETURN ""
		ENDIF
		
		SELECT sourceph
		*SET ORDER TO Company
		
		ThisForm.grdSourceCompany.RecordSource = "SourcePH"
		ThisForm.grdSourceCompany.Company.ControlSource = "SourcePH.Company"
		ThisForm.grdSourceCompany.Person.ControlSource  = "SourcePH.Person"
		ThisForm.grdSourceCompany.Phone.ControlSource   = "SourcePH.Phone"
		ThisForm.grdSourceCompany.Fax.ControlSource     = "SourcePH.Fax"
		ThisForm.grdSourceCompany.Email.ControlSource   = "SourcePH.Email"
		ThisForm.grdSourceCompany.Email2.ControlSource  = "SourcePH.Email2"
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		*IF VARTYPE(gnConnHandle) = "N"
		*	ThisForm.CloseConn = .F.
		*	ThisForm.nConnHandle = gnConnHandle
		*ELSE
			ThisForm.CloseConn = .T.
			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		*ENDIF
		
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseConn
			= SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		
		
		IF NOT EMPTY(ThisForm.oldAlias)
			IF USED(ThisForm.oldAlias)
				SELECT (ThisForm.oldAlias)
			ENDIF
		ENDIF
		
		RETURN THISFORM.cReturnValue
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturnValue = ""
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdCompanySources.Click
		PRIVATE cCompany
		cCompany = ShowSQLtxt(SourcePH.Company,'Company',30)
		
		ThisForm.grdSourceCompany.RecordSource = ""
		IF USED('SourcePH')
			USE IN SourcePH
		ENDIF
		
		DO FORM Forms\SourcePH WITH cCompany
		
		SELECT 0
		cSQL = "SELECT * FROM dbo.SourcePH ORDER BY Company"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle,cSQL,"SourcePH")
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'SourcePH')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "SourcePH")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'SourcePH')
		ENDIF
		
		IF NOT USED('SourcePH')
			MESSAGEBOX( "Could not loading the SourcePH table.","Program Error")
			RETURN ""
		ENDIF
		
		SELECT sourceph
		*SET ORDER TO Company
		
		ThisForm.grdSourceCompany.RecordSource = "SourcePH"
		IF VARTYPE(ThisForm.grdSourceCompany.Company.ControlSource) = "C"
			ThisForm.grdSourceCompany.Company.ControlSource = "SourcePH.Company"
			ThisForm.grdSourceCompany.Person.ControlSource  = "SourcePH.Person"
			ThisForm.grdSourceCompany.Phone.ControlSource   = "SourcePH.Phone"
			ThisForm.grdSourceCompany.Fax.ControlSource     = "SourcePH.Fax"
			ThisForm.grdSourceCompany.Email.ControlSource   = "SourcePH.Email"
			ThisForm.grdSourceCompany.Email2.ControlSource  = "SourcePH.Email2"
		ELSE
			ThisForm.grdSourceCompany.Column1.ControlSource = "SourcePH.Company"
			ThisForm.grdSourceCompany.Column2.ControlSource  = "SourcePH.Person"
			ThisForm.grdSourceCompany.Column3.ControlSource   = "SourcePH.Phone"
			ThisForm.grdSourceCompany.Column4.ControlSource     = "SourcePH.Fax"
			ThisForm.grdSourceCompany.Column5.ControlSource   = "SourcePH.Email"
			ThisForm.grdSourceCompany.Column6.ControlSource  = "SourcePH.Email2"
		ENDIF
	ENDPROC

	PROCEDURE cmdSelectCompany.Click
		ThisForm.cReturnValue = SourcePH.Person+SourcePH.Company+SourcePH.Phone+SourcePH.fax+SourcePH.email+SourcePH.email2
		ThisForm.Release
	ENDPROC

	PROCEDURE Combo1.Valid
		PRIVATE nNearestRecord
		
		SELECT SourcePH 
		LOCATE FOR Company = This.Value
		*SEEK (This.Value) IN SourcePH &&ORDER 'Company'
		nNearestRecord = RECNO()
		
		IF nNearestRecord <= RECCOUNT()
			GOTO (nNearestRecord)
		ELSE 
			GOTO BOTTOM
		ENDIF
		
		ThisForm.grdSourceCompany.Refresh()
		*ThisForm.grdSourceCompany.SetFocus()
	ENDPROC

ENDDEFINE
