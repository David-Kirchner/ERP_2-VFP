	PROCEDURE editfields		&& Show or hide
		Parameter pShow
		
		IF TYPE('pShow') = 'L'
			IF pShow
				ThisForm.txtID.Visible = .T.
				ThisForm.lblDayFraction.Visible = .t.
				ThisForm.cmbDispNames.Visible = .t.
				ThisForm.oleDatePicker.Visible = .t.
				ThisForm.spnHours.Visible = .t.
				ThisForm.cmbVacaType.Visible = .T.
				ThisForm.cmdClear.Visible = .T.
			ELSE
				ThisForm.txtID.Visible = .F.
				ThisForm.lblDayFraction.Visible = .F.
				ThisForm.cmbDispNames.Visible = .F.
				ThisForm.oleDatePicker.Visible = .F.
				ThisForm.spnHours.Visible = .F.
				ThisForm.cmbVacaType.Visible = .F.
				
				ThisForm.txtID.Value = ""
				
				ThisForm.cmdClear.Visible = .F.
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		Parameter pEmployee
		
		SET PROCEDURE TO Quotes\Progs\Vacation ADDITIVE
		
		SELECT Vacation
		
		ThisForm.dispnamefilter = ""
		IF TYPE('pEmployee') = "C"
			IF pEmployee <> "(Select Employee)"
				ThisForm.dispnamefilter = ALLTRIM(pEmployee)
				ThisForm.cmbAllEmployees.value = ThisForm.dispnamefilter
			ENDIF
		ENDIF
		
		IF USED('tmpVacation')
			USE IN tmpVacation
		ENDIF
		
		ThisForm.RefreshGrd()
	ENDPROC

	PROCEDURE Load
		SET SAFETY OFF
		
		IF NOT USED('Vacation')
			USE HPA!Vacation SHARED IN 0
		ENDIF
		
		SELECT Vacation
		SET ORDER TO TAG VacaDate
	ENDPROC

	PROCEDURE refreshdays		&& visible, days summary
		PRIVATE pDate, pEmployee
		pDate = DATE()
		pEmployee = ThisForm.dispnamefilter
		
		IF EMPTY(ThisForm.dispnamefilter)
			ThisForm.lblAvail.Visible = .F.
			ThisForm.txtAvailable.Visible = .F.
			ThisForm.lblTaken.Visible = .F.
			ThisForm.txtTaken.Visible = .F.
			ThisForm.lblLeft.Visible = .F.
			ThisForm.txtLeft.Visible = .F.
			ThisForm.lblPersonal.Visible = .F.
			ThisForm.txtPersonal.Visible = .F.
			ThisForm.lblSick.Visible = .F.
			ThisForm.txtSick.Visible = .F.
			
			ThisForm.txtAvailable.Caption = ""
			ThisForm.txtTaken.Caption = ""
			ThisForm.txtLeft.Caption = ""
			ThisForm.txtSick.Caption = ""
		ELSE
			ThisForm.lblAvail.Visible = .T.
			ThisForm.txtAvailable.Visible = .T.
			ThisForm.lblTaken.Visible = .T.
			ThisForm.txtTaken.Visible = .T.
			ThisForm.lblLeft.Visible = .T.
			ThisForm.txtLeft.Visible = .T.
			ThisForm.lblPersonal.Visible = .T.
			ThisForm.txtPersonal.Visible = .T.
			ThisForm.lblSick.Visible = .T.
			ThisForm.txtSick.Visible = .T.
			
			ThisForm.txtAvailable.Caption = VacationTimeAllowed(pDate, pEmployee)
			ThisForm.txtTaken.Caption = VacationTimeUsed(pDate, pEmployee)
			ThisForm.txtLeft.Caption = ALLTRIM(STR( DaysVacationLeft(pDate, pEmployee) ))
			ThisForm.txtPersonal.Caption = PersonalTimeUsed(pDate, pEmployee)
			ThisForm.txtSick.Caption = SickTimeUsed(pDate, pEmployee)
		ENDIF
		
	ENDPROC

	PROCEDURE refreshgrd
		ThisForm.grdVacation.RecordSource = SPACE(0)
		IF USED('tmpVacation')
			USE IN tmpVacation
		ENDIF
		
		IF EMPTY(ThisForm.dispnamefilter)
			ThisForm.grdVacation.RecordSource = "Select id,vacatype,dispname,vacadate,hours FROM Vacation WHERE YEAR(vacadate)="+ThisForm.cYear+" AND !DELETED() NOCONSOLE INTO CURSOR tmpVacation"
		ELSE
		
		*	ThisForm.grdVacation.RecordSourceType = 0
			mDispName = ThisForm.dispnamefilter
			mSQL = "Select id,vacatype,dispname,vacadate,hours FROM Vacation WHERE DispName = '"
			mSQL = mSQL + (mDispName)+"'"+" AND "
			mSQL = mSQL + " YEAR(vacadate)="+ThisForm.cYear
			mSQL = mSQL +" AND !DELETED() NOCONSOLE INTO CURSOR tmpVacation"
		*	mSQL = "Select id,vacaype,dispname,vacadate,hours FROM Vacation WHERE DispName = '"+ThisForm.dispnamefilter+"' AND !DELETED() NOCONSOLE INTO CURSOR tmpVacation"
			ThisForm.grdVacation.RecordSource = mSQL
		ENDIF
		ThisForm.RefreshDays()
		ThisForm.grdVacation.Refresh()
		
	ENDPROC

	PROCEDURE Unload
		IF USED('Vacation')
			USE IN Vacation
		ENDIF
		
		IF USED('tmpVacation')
			USE IN tmpVacation
		ENDIF
		
	ENDPROC

	PROCEDURE cmbAllEmployees.Init
		#DEFINE ALLEMPLOYEE_LOC "(All)"
		this.clear
		this.additem(ALLEMPLOYEE_LOC)
		
		LOCAL aEmployees,cEmployee
		DIMENSION aEmployees[1]
		
		SELECT dispname FROM employees WHERE Active1 AND !DELETED() INTO array aEmployees
		
		FOR EACH m.cEmployee IN aEmployees
			IF !EMPTY(m.cEmployee)
				this.additem(m.cEmployee)
			ENDIF
		ENDFOR
		
		THIS.VALUE = ALLEMPLOYEE_LOC
		
	ENDPROC

	PROCEDURE cmbAllEmployees.InteractiveChange
		LOCAL cDisplayValue
		PRIVATE mSQL
		THISFORM.LockScreen = .T.
		
		ThisForm.grdVacation.RecordSource = ""
		SELECT Vacation
		
		IF THIS.Value = "(All)"
			ThisForm.dispnamefilter = ""
		ELSE
			ThisForm.dispnamefilter = AllTrim(This.Value)
		ENDIF
		
		ThisForm.RefreshGrd()
		THISFORM.LockScreen = .F.
		
	ENDPROC

	PROCEDURE cmbDispNames.Init
		LOCAL aDispNames,cDispName
		DIMENSION aDispNames[1]
		
		SELECT dispname FROM Employees INTO array aDispNames
		
		FOR EACH m.cDispName IN aDispNames
			IF !EMPTY(m.cDispName)
					this.additem(m.cDispName)
			ENDIF
		ENDFOR
		
		THIS.VALUE = aDispNames[1]
		
	ENDPROC

	PROCEDURE cmbVacaType.Init
		This.Value = "V"
	ENDPROC

	PROCEDURE cmdAdd.Click
		Private lnID
		Private mVacaType,mDispname,mVacaDate,mDayFraction
		
		Private lcHoliday, mSave, lcHoliday, lcVacationAns
		
		
		DO CASE
		CASE This.Caption = "Add"
			Thisform.editfields(.t.)
			This.Caption = "Save"
			If ThisForm.cmbAllEmployees.Value = "(All)"
				Thisform.cmbAllEmployees.SetFocus
			Else
				Thisform.cmbDispNames.Value = ThisForm.cmbAllEmployees.Value
				Thisform.cmbVacaType.SetFocus
			Endif
		
			ldDate=DATE()
			Thisform.oleDatePicker.Day   = DAY(ldDate)
			Thisform.oleDatePicker.Month = MONTH(ldDate)
			Thisform.oleDatePicker.Year  = YEAR(ldDate)
		
		
		CASE This.Caption = "Save"
		*	SAVE
			mDispname = ALLTRIM(ThisForm.cmbDispNames.Value)
			mVacaDate = CTOD(STR(ThisForm.oleDatePicker.Month)+"/"+STR(ThisForm.oleDatePicker.Day)+"/"+STR(ThisForm.oleDatePicker.Year))
			mDayFraction = ThisForm.spnHours.Value
			mVacaType = ThisForm.cmbVacaType.Value
		
		**	check values
			mSave = .T.
		*	Check DispName
			If NOT IsEmployee(mDispname)
				Messagebox( mDispname+" is not a vaild Employee name.",0,"Cannot save")
				mSave = .F.
			Endif
		*	Validate Holiday
			lcHoliday = IsHoliday(mVacaDate)
			Do CASE
			Case lcHoliday = "NO"
			Case lcHoliday = "NoDate"
				Messagebox( "Bad date",0,"Cannot save")
				mSave = .F.
			Otherwise
				Messagebox( mDispname+" can not take off holiday "+lcHoliday+".",0,"This date is already listed as a company holiday.")
				mSave = .F.
			Endcase
		
		*	Validate Vacation Time left
			lnVacationLeft = DaysVacationLeft(mVacaDate,mDispname)
			IF lnVacationLeft < 1
				MESSAGEBOX( mDispname+" can not take off more vacation days.",0,"No vacation time left to give.")
				mSave = .F.
			ENDIF
			
		*	Validate on Vacation
			lcVacationAns = IsVacationDay(mVacaDate,mDispname)
			Do CASE
			Case lcVacationAns = "NO"
			Case lcVacationAns = "NoEmployee"
				mSave = .F.
			Otherwise && lcVacationAns = "YES"
				Messagebox( "Date is already being used as vacation."+CHR(10)+CHR(13)+mDispname+" can not take off this day again."+DTOC(mVacaDate)+".",0,"Cannot Save.")
				mSave = .F.
			Endcase
		
			If mSave
				Thisform.editfields(.F.)
				This.Caption = "Add"
		
				lnID = NextVacationID()
		
				Insert INTO Vacation (id,VacaType,dispname,vacadate,hours) VALUES (lnID,mVacaType,mDispname,mVacaDate,mDayFraction)
		
				Thisform.RefreshGrd()
				
				ThisForm.editfields(.F.)
				This.Caption = "Add"
			Endif
		CASE This.Caption = "Update"
			lnID = VAL(ThisForm.txtID.Value)
			mDispname = ALLTRIM(ThisForm.cmbDispNames.Value)
			mVacaDate = CTOD(STR(ThisForm.oleDatePicker.Month)+"/"+STR(ThisForm.oleDatePicker.Day)+"/"+STR(ThisForm.oleDatePicker.Year))
			mDayFraction = ThisForm.spnHours.Value
			mVacaType = ThisForm.cmbVacaType.Value
		
		**	check values
			mSave = .T.
		*	Check DispName
			If NOT IsEmployee(mDispname)
				Messagebox( mDispname+" is not a vaild Employee name.",0,"Cannot save")
				mSave = .F.
			Endif
		*	Validate Holiday
			lcHoliday = IsHoliday(mVacaDate)
			Do CASE
			Case lcHoliday = "NO"
			Case lcHoliday = "NoDate"
				Messagebox( "Bad date",0,"Cannot save")
				mSave = .F.
			Otherwise
				Messagebox( mDispname+" can not take off holiday "+lcHoliday+".",0,"This date is already listed as a company holiday.")
				mSave = .F.
			Endcase
		*	Validate Vacation Time left
		*	Validate on Vacation
			lcVacationAns = IsVacationDay(mVacaDate,mDispname)
			Do CASE
			Case lcVacationAns = "NO"
			Case lcVacationAns = "NoEmployee"
				mSave = .F.
			Otherwise && lcVacationAns = "YES"
		*		Messagebox( "Date is already being used as vacation."+CHR(10)+CHR(13)+mDispname+" can not take off this day again."+DTOC(mVacaDate)+".",0,"Cannot Save.")
		*		mSave = .F.
			Endcase
		
		
			If mSave
				Thisform.editfields(.F.)
				This.Caption = "Add"
		
				UPDATE Vacation SET VacaType=mVacaType, dispname=mDispname, vacadate=mVacaDate, hours=mDayFraction WHERE id=lnID
		
				Thisform.RefreshGrd()
				
				ThisForm.editfields(.F.)
				This.Caption = "Add"
			Endif
		
		ENDCASE
		
	ENDPROC

	PROCEDURE cmdClear.Click
		ThisForm.editfields(.F.)
		ThisForm.cmdAdd.Caption = "Add"
	ENDPROC

	PROCEDURE cmdDelete.Click
		PRIVATE lnSelctedID, aID
		
		lnSelctedID = tmpVacation.id
		SELECT id from vacation WHERE id = lnSelctedID and !Deleted() INTO ARRAY aID
		
		IF TYPE('aID') = 'N'
			DELETE FROM Vacation WHERE id = lnSelctedID
		ELSE
			SELECT id from vacation WHERE id = lnSelctedID and Deleted() INTO ARRAY aID
			IF TYPE('aID') = 'N'
				SELECT Vacation
				RECALL FOR id = lnSelctedID
			ENDIF
		ENDIF
		
		ThisForm.refreshgrd()
		
	ENDPROC

	PROCEDURE cmdEdit.Click
		PRIVATE lnID
		Private mDispname,mVacaDate,mDayFraction
		PRIVATE ldDate
		
		IF ThisForm.cmdAdd.Caption = "Save" OR ThisForm.cmdAdd.Caption = "Update"
			messagebox("Clear text first",0,"Data present")
			RETURN .F.
		ELSE
			*Edit
			ThisForm.cmbAllEmployees.Value = tmpVacation.DispName
			ThisForm.cmbAllEmployees.InteractiveChange()
		ENDIF
		
		ThisForm.cmdAdd.Caption = "Update"
		
		ThisForm.txtID.Value = ALLTRIM(STR(tmpVacation.ID))
		ThisForm.cmbDispNames.Value = tmpVacation.DispName
		ldDate=tmpVacation.VacaDate
		ThisForm.oleDatePicker.Day   = DAY(ldDate)
		ThisForm.oleDatePicker.Month = MONTH(ldDate)
		ThisForm.oleDatePicker.Year  = YEAR(ldDate)
		
		ThisForm.spnHours.Value = tmpVacation.hours
		ThisForm.cmbVacaType.Value = tmpVacation.VacaType
			
		ThisForm.editfields(.T.)
		
		ThisForm.cmbDispNames.SetFocus
	ENDPROC

	PROCEDURE cmdEditEmp.Click
		DO FORM Forms\EmployeeMaint WITH ThisForm.cmbAllEmployees.Value
		
		#DEFINE ALLEMPLOYEE_LOC "(All)"
		ThisForm.cmbAllEmployees.clear
		ThisForm.cmbAllEmployees.additem(ALLEMPLOYEE_LOC)
		
		LOCAL aEmployees,cEmployee
		DIMENSION aEmployees[1]
		
		SELECT dispname FROM employee WHERE Active1 AND !DELETED() INTO array aEmployees
		
		FOR EACH m.cEmployee IN aEmployees
			IF !EMPTY(m.cEmployee)
				ThisForm.cmbAllEmployees.additem(m.cEmployee)
			ENDIF
		ENDFOR
		
		ThisForm.cmbAllEmployees.VALUE = ThisForm.dispnamefilter
		
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE Combo1.Init
		PRIVATE nYear, nCurrYear
		nCurrYear = YEAR( DATE() )
		
		IF nCurrYear > 2000
			FOR nYear = 2000 TO nCurrYear
				this.additem(ALLTRIM(STR(nYear)))
			ENDFOR
			This.Value = ALLTRIM(STR(nCurrYear))
			ThisForm.cYear = ALLTRIM(STR(nCurrYear))
		ELSE
			this.additem('2000')
			This.Value = '2000'
			ThisForm.cYear = '2000'
		ENDIF
	ENDPROC

	PROCEDURE Combo1.InteractiveChange
		ThisForm.cYear = This.Value
		ThisForm.RefreshGRD()
	ENDPROC

ENDDEFINE
