DEFINE CLASS frmthermalcoupleuseadd AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSave" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdExit" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Grid1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: closeconnection
		*p: creturntcname
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		BorderStyle = 1
		Caption = ""
		ClipControls = .F.
		Closable = .F.
		closeconnection = .F.
		ControlBox = .F.
		creturntcname =  
		DataSession = 2
		DoCreate = .T.
		HalfHeightCaption = .T.
		Height = 200
		Left = 24
		MDIForm = .T.
		Name = "frmThermalCoupleUseAdd"
		nconnhandle = 0
		Top = 13
		Width = 300
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdExit' AS commandbutton WITH ;
		Caption = "Exit", ;
		Height = 27, ;
		Left = 121, ;
		Name = "cmdExit", ;
		Top = 169, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdSave' AS commandbutton WITH ;
		Caption = "Select", ;
		Height = 27, ;
		Left = 29, ;
		Name = "cmdSave", ;
		Top = 169, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Grid1' AS grid WITH ;
		ColumnCount = -1, ;
		DeleteMark = .F., ;
		Height = 150, ;
		Left = 1, ;
		Name = "Grid1", ;
		ReadOnly = .T., ;
		RecordMark = .F., ;
		Top = 18, ;
		Width = 298
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'Label1' AS label WITH ;
		Caption = "Thermal Couple Names", ;
		FontBold = .T., ;
		FontSize = 12, ;
		Height = 17, ;
		Left = 12, ;
		Name = "Label1", ;
		Top = 0, ;
		Width = 228
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Destroy
		IF ThisForm.CloseConnection
			SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETERS pHPAName, nConn
		
		PRIVATE cHPAName
		IF VARTYPE(pHPAName) = "C"
			cHPAName = pHPAName
		ELSE
			cHPAName = ''
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF VARTYPE(nConn) = "N"
			ThisForm.nConnHandle= nConn
		ELSE
			nConn = get_SQLSTRINGCONNECT()
			ThisForm.nConnHandle= nConn
			ThisForm.CloseConnection = .T.
		ENDIF
		
		
		IF USED('tmpTCNames')
			USE IN tmpTCNames
		ENDIF
		SELECT 0
		
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT DISTINCT HPAName FROM dbo.ThermalCoupleName"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTCNames' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTCNames' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTCNames")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTCNames")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpTCNames' )
		ENDIF
		
		IF NOT EMPTY(cHPAName)
			LOCATE FOR HPAName = cHPAName
			IF NOT FOUND()
				GO Bottom
				IF RECCOUNT() > 5
					SKIP -5
				ENDIF
			ENDIF
		ELSE
			GO Bottom
			IF RECCOUNT() > 5
				SKIP -5
			ELSE
				GO TOP
			ENDIF
		ENDIF
		
		IF USED('tmpTCNames')
			ThisForm.Grid1.RecordSource='tmpTCNames'
		ENDIF
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_SQL.prg ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE Unload
		RETURN This.cReturnTCname
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.creturntcname = ' '
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSave.Click
		ThisForm.creturntcname = tmpTCNames.HPAName 
		ThisForm.Release
		
			
		
	ENDPROC

ENDDEFINE
