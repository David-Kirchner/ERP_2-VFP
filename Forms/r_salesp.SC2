	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE getlateshipmentsdata
	ENDPROC

	PROCEDURE getsalesorderdata
		*ThisForm.GetSalesOrderData()
		
		
		
		PRIVATE cSQL
		
		cSQL="SELECT * FROM dbo.SO_SalesP_YearQuarter "
		cSQL=cSQL+" ORDER BY YearQ DESC, SalesTotal DESC"
		
		IF USED('tmpSO_SalesP')
			USE IN tmpSO_SalesP
		ENDIF
		
		SELECT 0
		PRIVATE nSQLEXEC, lGood
		lGood = .T.
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_SalesP')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSO_SalesP')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_SalesP")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSO_SalesP")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSO_SalesP')
		ENDIF
		
	ENDPROC

	PROCEDURE getshipmentsdata		&& From cmdShowReport.Click
		*ThisForm.GetShipmentsData()
		
		*!*	SELECT TOP 100 PERCENT
		*!*	dbo.[f_YearQuarter](allquotes.inqdate) AS YearQ
		*!*	, SalesP
		*!*	, 'Quotes' = SUM( 1 )
		*!*	, 'QuoteTotal' = SUM(ISNULL(AllQuotes.Lotp,AllQuotes.cLotp))
		*!*	, 'Sales' = SUM( CASE WHEN allquotes.SalesNum > 0 Then 1 ELSE 0 END )
		*!*	, 'SalesTotal' = SUM( Sales.ItemSale )
		*!*	, 'Broker' = SUM( CASE WHEN allquotes.SalesNum > 0 AND AllQuotes.HpaPO > 0 Then 1 ELSE 0 END )
		*!*	, 'BrokerTotal' = SUM(CASE WHEN allquotes.SalesNum > 0 AND AllQuotes.HpaPO > 0 THEN Sales.ItemSale ELSE 0 END)
		
		*!*	FROM dbo.allquotes allquotes LEFT OUTER JOIN dbo.Sales ON allquotes.SOitem = Sales.Soitem
		
		*!*	WHERE (allquotes.services=0) AND YEAR(allquotes.inqdate) >= ( YEAR(GetDate()) - 3)
		*!*	GROUP BY dbo.[f_YearQuarter](allquotes.inqdate)
		*!*	, SalesP
		*!*	HAVING SUM(AllQuotes.Lotp) > 5000
		
		
		PRIVATE cSQL
		
		cSQL="SELECT * FROM dbo.AllQuotes_SalesP_YearQuarter "
		cSQL=cSQL+" ORDER BY YearQ DESC, SalesTotal DESC"
		
		IF USED('tmpShipments')
			USE IN tmpShipments
		ENDIF
		
		SELECT 0
		PRIVATE nSQLEXEC, lGood
		lGood = .T.
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpShipments')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL0, 'tmpShipments')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShipments")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpShipments")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLExecError(cSQL0, ThisForm.nConnHandle, nSQLEXEC, 'tmpShipments')
		ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_Setup" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE Unload
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmdEport_SOSalesP.Click
		ThisForm.GetSalesOrderData()
		
		IF USED('tmpSO_SalesP')
			SELECT tmpSO_SalesP
			IF "\MEM" $ SYS(2003)
				EXPORT TO SYS(5)+SYS(2003)+"\"+"SO_SalesP_ByQuarter" TYPE XL5
			ELSE
				EXPORT TO SYS(5)+SYS(2003)+"\MEM\"+"SO_SalesP_ByQuarter" TYPE XL5
			ENDIF
			MESSAGEBOX( "Open 'SO_SalesP_ByQuarter.xls' in Excel"+CHR(13)+"Look in your "+SYS(5)+SYS(2003)+"\MEM"+" directory.",0+64,"Exported")
		ENDIF
		
		
		IF USED('tmpSO_SalesP')
			USE IN tmpSO_SalesP
		ENDIF
		
	ENDPROC

	PROCEDURE cmdExport_SalesP.Click
		ThisForm.GetShipmentsData()
		
		IF USED('tmpShipments')
			SELECT tmpShipments
			IF "\MEM" $ SYS(2003)
				EXPORT TO SYS(5)+SYS(2003)+"\"+"SalesP_ByQuarter" TYPE XL5
			ELSE
				EXPORT TO SYS(5)+SYS(2003)+"\MEM\"+"SalesP_ByQuarter" TYPE XL5
			ENDIF
			
			MESSAGEBOX( "Open 'SalesP_ByQuarter.xls' in Excel"+CHR(13)+"Look in your "+SYS(5)+SYS(2003)+"\"+" directory.",0+64,"Exported")
		ENDIF
		
		
		IF USED('tmpShipments')
			USE IN tmpShipments
		ENDIF
		
	ENDPROC

	PROCEDURE cmdPrint_SalesP.Click
		
		ThisForm.GetShipmentsData()
		
		IF USED('tmpShipments')
			SELECT tmpShipments
			REPORT FORM reports\r_SalesP.frx TO PRINTER PROMPT
		ENDIF
		
		IF USED('tmpShipments')
			USE IN tmpShipments
		ENDIF
		
	ENDPROC

	PROCEDURE cmdPrint_SOSalesP.Click
		
