	PROCEDURE cmdSearch.Click
		PRIVATE cSearch, nSearchLen 
		
		cSearch = PrepareSQLtxt(ThisForm.txtSearch.Value,'CustID',20)
		
		IF NOT EMPTY(cSearch)
			
			ThisForm.cmdOweHPA.Caption = "View All"
			ThisForm.grdCustomer_List.RecordSource = ""
		
			IF USED('Customer_List')
				USE IN Customer_List
			ENDIF
			SELECT 0
			
			DO WHILE LEN(cSearch) > 0
				cSQL="SELECT * FROM [Customer_List] WHERE [CustomerID] LIKE '%"+cSearch+"%' ORDER BY [CustomerID]"
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
		
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Customer_List' )
				ENDIF
				IF RECCOUNT("Customer_List") > 0
					EXIT
				ENDIF
		
				cSearch = LEFT( cSearch, LEN(cSearch) -1 )
				
				DO WHILE RIGHT(cSearch,1) = "'"
					cSearch = LEFT( cSearch, LEN(cSearch) -1 )
					IF LEN(cSearch) = 0
						EXIT
					ENDIF
				ENDDO
				ThisForm.txtSearch.Value = cSearch
				
				IF LEN(cSearch) <= 2
					EXIT
				ENDIF
			ENDDO
			
			ThisForm.grdCustomer_List.RecordSource = "Customer_List"
			ThisForm.grdCustomer_List.Column1.Width = 60
			
			*ThisForm.grdCustomer_List.AfterRowColChange
			ThisForm.Customer_List_Change()
		
		
		ENDIF
	ENDPROC

	PROCEDURE cmdSearchCompany.Click
		PRIVATE cSearch, nSearchLen 
		
		cSearch = PrepareSQLtxt(ThisForm.txtSearchCompany.Value,'Company',100)
		
