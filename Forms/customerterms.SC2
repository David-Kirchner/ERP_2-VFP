		ENDIF
	ENDPROC

	PROCEDURE cmdUList.Click
		
		cText = "http://www.bis.doc.gov/Enforcement/UnverifiedList/unverified_parties.html"
		
		
		PRIVATE loHyperlink 
		loHyperlink = CREATEOBJECT("Hyperlink")
		loHyperlink.navigateto(cText)
		RELEASE loHyperlink 
		
	ENDPROC

	PROCEDURE cmdUpdateTable.Click
		IF MESSAGEBOX("Are you sure you want to update the current 'Customer' table?",4+32,"Ready to UPDATE?") = 6
			ThisForm.ImportPeachCustomer_list()
			*CALLS: ImportPeachtreeCustomerTerms_SQL(nConn) &&Proc_SQL
			
			IF USED('Customer_List')
				IF VARTYPE(ThisForm.grdCustomer_List) = "O"
					ThisForm.grdCustomer_List.RecordSource = "Customer_List"
					ThisForm.grdCustomer_List.Column1.Width = 60
				ENDIF	
			ENDIF
		
		ENDIF
	ENDPROC

