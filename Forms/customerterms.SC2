	PROCEDURE grdCustomer_List.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.Customer_List_Change()
		
	ENDPROC

	PROCEDURE txtSearch.Valid
		IF !EMPTY(THIS.Value)
			ThisForm.cmdSearch.Click()
		ENDIF
	ENDPROC

	PROCEDURE txtSearchCompany.Valid
		IF !EMPTY(THIS.Value)
			ThisForm.cmdSearchCompany.Click()
		ENDIF
	ENDPROC

