	PROCEDURE cmdEdit.Click
		IF THIS.CAPTION = "Owe HPA Report"
			ThisForm.grdCustomer_List.RecordSource = ""
			IF USED('Customer_List')
				USE IN Customer_List
			ENDIF
			SELECT 0
			cSQL="SELECT * FROM [Customer_List] WHERE [CurrentBalance]>0 ORDER BY [CurrentBalance] DESC"
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Customer_List' )
			ENDIF
			ThisForm.grdCustomer_List.RecordSource = "Customer_List"
			ThisForm.grdCustomer_List.SetFocus
			
			This.Caption = "View All"
		ELSE
			ThisForm.grdCustomer_List.RecordSource = ""
			IF USED('Customer_List')
				USE IN Customer_List
			ENDIF
			SELECT 0
			cSQL="SELECT * FROM [Customer_List] ORDER BY [CustomerName]"
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
		
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Customer_List' )
			ENDIF
			ThisForm.grdCustomer_List.RecordSource = "Customer_List"
			ThisForm.grdCustomer_List.SetFocus
			
			This.Caption = "Owe HPA Report"
		ENDIF
	ENDPROC

