	PROCEDURE customer_list_change
		*ThisForm.Customer_List_Change()
		
		ThisForm.txtCustomerName.Refresh
		ThisForm.txtTelephone.Refresh
		ThisForm.txtAddr1.Refresh
		ThisForm.txtAddr2.Refresh
		ThisForm.txtCity.Refresh
		ThisForm.txtState.Refresh
		ThisForm.txtZip.Refresh
		ThisForm.txtCountry.Refresh
		
		ThisForm.edtCredit_Info.Refresh
		ThisForm.edtMisc_Info.Refresh
		
		ThisForm.txtPricingLevel.Refresh
		ThisForm.txtDueDays.Refresh
		ThisForm.txtCreditLimit.Refresh
		Thisform.txtResales_Tax.Refresh
		ThisForm.txtCurrentBalance.Refresh
		
		IF Customer_List.Prepaid 
			ThisForm.txtPrePaid.Value = "Prepaid"
		ELSE
			ThisForm.txtPrePaid.Value = ""
		ENDIF
		
		ThisForm.txtPrePaid.Refresh
		ThisForm.txtTermsType.Refresh
		
		IF Customer_List.InActive
			ThisForm.chkInActive.Value = 1
			ThisForm.chkInActive.Visible = .T.
		ELSE
			ThisForm.chkInActive.Value = 0
			ThisForm.chkInActive.Visible = .F.
		ENDIF
		
		IF Customer_List.StandTerms
			ThisForm.chkStandTerms.Value = 1
			ThisForm.chkStandTerms.Visible = .T.
		ELSE
			ThisForm.chkStandTerms.Value = 0
			ThisForm.chkStandTerms.Visible = .F.
		ENDIF
		
		IF NOT Customer_List.CODTerms 
			ThisForm.txtCODTerms.Value = " "
		ELSE
			ThisForm.txtCODTerms.Value = "COD Only"
		ENDIF
		ThisForm.txtCODTerms.Refresh
		
		ThisForm.chkStandTerms.Refresh
		ThisForm.chkInActive.Refresh
		
		*cPayType = ShowPaymentTypeText(nPayType)
		PRIVATE nType
		nType = VAL(Customer_List.Type)
		ThisForm.txtPayType.Value = nType 
		
		DO CASE
		CASE nType = 1
			ThisForm.txtTermsType.Value = "Domestic Open"
		CASE nType = 2
			ThisForm.txtTermsType.Value = "Domestic COD"
		CASE nType = 3
			ThisForm.txtTermsType.Value = "Domestic PrePay"
		CASE nType = 4
			ThisForm.txtTermsType.Value = "Canada Open"
		CASE nType = 5
			ThisForm.txtTermsType.Value = "Canada COD"
		CASE nType = 6
			ThisForm.txtTermsType.Value = "Canada PrePay"
		CASE nType = 7
			ThisForm.txtTermsType.Value = "International Open"
		CASE nType = 8
			ThisForm.txtTermsType.Value = "International COD"
		CASE nType = 9
			ThisForm.txtTermsType.Value = "International PrePay"
		OTHERWISE
			ThisForm.txtTermsType.Value = "Customer Type ? "
		ENDCASE
		
		
		
		
		
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE importpeachcustomer_list
		**code is used in CustomerTerms.prg in CustomerTerms.pjx at My Projects\Visual FoxPro Projects\CusstomerTerms
		**also in HPA\Forms\CustomerTerms.scx Method ImportPeachCustomerTerms
		*ThisForm.ImportPeachCustomer_List()
		IF VARTYPE(ThisForm.grdCustomer_List) = "O"
			ThisForm.grdCustomer_List.RecordSource = ""
		ENDIF
		*ThisForm.grdCustomer_List.RecordSource
		
		***********************************
		*Proc_SQL:ImportPeachtreeCustomerTerms_SQL
		***********************************
		PRIVATE lReturn
		lReturn = ImportPeachtreeCustomerTerms_SQL(ThisForm.nConnHandle) &&Proc_SQL
		IF NOT lReturn
			MESSAGEBOX("The table dbo.[CUSTOMER TERMS] is empty.",0+48,"Nothing to import")
			RETURN .F.
		ENDIF
		
		***********************
		
		WAIT WINDOW "Loading dbo.[Customer_List]" NOWAIT
		 
		cSQL="SELECT * FROM dbo.[Customer_List] READUNCOMMITTED ORDER BY [CustomerName]"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Customer_List' )
			messagebox("SQL Error"+CHR(13)+"Could not load Data!",0,"SQL Error")
		ENDIF
		
		IF NOT USED('Customer_List')
			MESSAGEBOX("Error getting Customer_List",0+16,"Cannot continue")
			EXIT
		ENDIF
		
		WAIT CLEAR
		
		IF USED('Customer_List')
			*Moved to the Click button
			IF VARTYPE(ThisForm.grdCustomer_List) = "O"
				ThisForm.grdCustomer_List.RecordSource = "Customer_List"
				ThisForm.grdCustomer_List.Column1.Width = 60
			
			ENDIF	
		ENDIF
			
			
		*CREATE CURSOR tmpCustomer_List ([CustomerID] [char](20) NULL,[CustomerName] [varchar](40) NULL,[Inactive] [bit] NULL,[Contact] [char](20) NULL,[Addr1] [varchar](30) NULL,[Addr2] [varchar](30) NULL,[City] [varchar](20) NULL,[St] [char](2) NULL,[Zip] [varchar](12) NULL,[Country] [varchar](15) NULL,[Type] [char](1) NULL,[Telephone] [varchar](20) NULL,[Fax] [varchar](20) NULL,[SalesRep] [varchar](20) NULL,[ResaleNo] [varchar](20) NULL,[PricingLevel] [money] NULL,[StandTerms] [bit] NULL,[CODTerms] [bit] NULL,[Prepaid] [bit] NULL,[TermsType] [varchar](10) NULL,[DueDays] [int] NULL,[DiscountDays] [int] NULL,[DiscountPct] [int] NULL,[CreditLimit] [money] NULL,[CREDIT_INFO] [varchar](254) NULL,[MISC_INFO] [varchar](254) NULL,[CustomerSince] [datetime] NULL,[LastInvoice] [datetime] NULL,[CurrentBalance] [money] NULL)
		WAIT CLEAR 
		RETURN .T.
	ENDPROC

	PROCEDURE Init
		PARAMETER pCompany, pCustomerID
		
		PRIVATE cSQL
		PRIVATE cCompany, cCustomerID,lSkipNameCheck 
		ThisForm.Company = ""
		ThisForm.CustomerID = ""
		lSkipNameCheck = .F.
		
		IF TYPE('pCompany') = "C"
			ThisForm.Company = pCompany	
			ThisForm.txtSearchCompany.Value = pCompany	
		ENDIF
		
		IF VARTYPE(pCustomerID) = "C"
			ThisForm.CustomerID = pCustomerID
			
			IF NOT EMPTY( pCustomerID )
				LOCATE FOR CustomerID = pCustomerID 
				lSkipNameCheck = .T.
			ENDIF
		ENDIF
		
		SELECT Customer_List
		
		IF NOT lSkipNameCheck 
			LOCATE FOR UPPER(LEFT(CustomerName,4)) = UPPER(LEFT(ThisForm.Company ,4))
			IF NOT FOUND()
				LOCATE FOR UPPER(LEFT(ThisForm.Company ,5)) $ UPPER(CustomerName)
				IF NOT FOUND()
					LOCATE FOR UPPER(LEFT(ThisForm.Company ,3)) $ UPPER(CustomerName)
				ELSE
					IF NOT FOUND()
						LOCATE FOR LEFT(CustomerName,1) = LEFT(ThisForm.Company ,1)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		IF FILE(GetCustomerTermsImportPath()+"CUSTOMER TERMS and List.CSV")	
			ThisForm.Caption = ThisForm.Caption + " - Accounting: "+ DtoC(FDATE(GetCustomerTermsImportPath()+"CUSTOMER TERMS and List.CSV",0))
		ENDIF
		
		
		
		IF "NO SQL DATA" $ UPPER(ThisForm.Caption)
		*	ThisForm.cmdUpdateTable.Visible = .F.
		*	ThisForm.shpUpdateTable.Visible = .F.
		ELSE
			IF FILE(GetCustomerTermsImportPath()+"CUSTOMER TERMS and List.CSV")	
				dCustomerTerms = FDATE(GetCustomerTermsImportPath()+"CUSTOMER TERMS and List.CSV",0)
				IF ThisForm.dCUSTOMER_ListDate > dCustomerTerms 
		*			ThisForm.cmdUpdateTable.Visible = .F.
					ThisForm.shpUpdateTable.Visible = .F.
				ENDIF
			ENDIF
		ENDIF
		
		IF FILE(GetCustomerTermsImportPath()+"CUSTOMER TERMS and List.CSV")
			ThisForm.lblSQLdata.Caption = GetCustomerTermsImportPath()+CHR(13)+"CUSTOMER TERMS and List.CSV"
		ELSE
			ThisForm.lblSQLdata.Caption = GetCustomerTermsImportPath()+"CUSTOMER TERMS and List.CSV"+" --not FOUND!"
		ENDIF
			
		ThisForm.lblExportDate.Caption = "Last Accounting EXPORT was "+ TtoC(ThisForm.dCUSTOMER_ListDate)
					
		ThisForm.grdCustomer_List.RecordSource = "Customer_List"
		ThisForm.grdCustomer_List.Column1.Width = 60
		ThisForm.grdCustomer_List.SetFocus
		
	ENDPROC

	PROCEDURE Load
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT ()
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF USED("Customer_List")
			USE IN Customer_List
		ENDIF
		
		WAIT WINDOW "Loading dbo.[Customer_List]" NOWAIT
		
		*cSQL="SELECT * FROM [Customer_List] WHERE [CustomerName] Like '%"+STRTRAN(ALLTRIM(cCompany),"'","''")+"' ORDER BY [CustomerName]"
		cSQL="SELECT * FROM dbo.[Customer_List] READUNCOMMITTED ORDER BY [CustomerName]"
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Customer_List' )
			messagebox("SQL Error"+CHR(13)+"Could not load Data!",0,"SQL Error")
		ENDIF
		
		IF NOT USED('Customer_List')
			MESSAGEBOX("Error getting Customer_List",0+16,"Cannot continue")
			EXIT
		ENDIF
		
		WAIT CLEAR
		
		IF RECCOUNT('Customer_List') = 0
			IF FILE(GetCustomerTermsImportPath()+"CUSTOMER TERMS and List.CSV") .OR. FILE(GetCustomerTermsImportPath()+"HPA App Export.CSV")
				IF ThisForm.ImportPeachCustomer_List()
					*Try to reload
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
			
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF
					IF nSQLEXEC < 0
						SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Customer_List' )
						MESSAGEBOX("SQL Error"+CHR(13)+"Could not load Data!",0,"SQL Error")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		****************
		IF USED('tmpCUSTOMER_ListDate')
			USE IN tmpCUSTOMER_ListDate
		ENDIF
		SELECT 0
		
		cSQL="SELECT TOP 1 dtDATE AS dtDate FROM dbo.Customer_List"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCUSTOMER_ListDate')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCUSTOMER_ListDate')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCUSTOMER_ListDate")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCUSTOMER_ListDate")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCUSTOMER_ListDate' )
		ELSE	
			
		ENDIF
		ThisForm.dCUSTOMER_ListDate = DATE()
		IF USED('tmpCUSTOMER_ListDate')
			IF VARTYPE(tmpCUSTOMER_ListDate.dtDate) = "T"
				IF NOT EMPTY(tmpCUSTOMER_ListDate.dtDate)
					ThisForm.Caption = ThisForm.Caption + " - Last time this data was updated "+ TtoC(tmpCUSTOMER_ListDate.dtDate)
		
					ThisForm.dCUSTOMER_ListDate = tmpCUSTOMER_ListDate.dtDate
				ENDIF
			ENDIF	
			IF VARTYPE(tmpCUSTOMER_ListDate.dtDate) = "D"
				IF NOT EMPTY(tmpCUSTOMER_ListDate.dtDate)
					ThisForm.Caption = ThisForm.Caption + " - Last time this data was updated "+ DtoC(tmpCUSTOMER_ListDate.dtDate)
						
					ThisForm.dCUSTOMER_ListDate = tmpCUSTOMER_ListDate.dtDate
				ENDIF
			ENDIF	
		
			USE IN tmpCUSTOMER_ListDate
		ENDIF
		
		
		****************
		PRIVATE lHasTermsTbl
		lHasTermsTbl = .F.
		IF USED('tmpHasTermsTbl')
			USE IN tmpHasTermsTbl
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, ;
			"SELECT CASE WHEN OBJECT_ID(N'dbo.[CUSTOMER TERMS]','U') IS NOT NULL THEN 1 ELSE 0 END AS ok", ;
			'tmpHasTermsTbl')
		IF nSQLEXEC > 0 AND USED('tmpHasTermsTbl') AND tmpHasTermsTbl.ok = 1
			lHasTermsTbl = .T.
		ENDIF
		IF USED('tmpHasTermsTbl')
			USE IN tmpHasTermsTbl
		ENDIF
		
		IF lHasTermsTbl
		IF USED('tmpCustomerDate')
			USE IN tmpCustomerDate
		ENDIF
		SELECT 0
		
		cSQL="SELECT TOP 1 dtDate FROM dbo.[CUSTOMER TERMS]"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCustomerDate')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCustomerDate')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCustomerDate")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCustomerDate")
		
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLExecError( cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCustomerDate' )
		ELSE	
			
		ENDIF
		
		IF USED('tmpCustomerDate')
			IF VARTYPE(tmpCustomerDate.dtDate) = "D" OR VARTYPE(tmpCustomerDate.dtDate) = "T"
				IF NOT EMPTY(tmpCustomerDate.dtDate)
					ThisForm.Caption = ThisForm.Caption + " - Import Data: "+ PrepareSQLdateTime(tmpCustomerDate.dtDate,'dtDate', .F.,.T.)
				ELSE
					IF RECCOUNT('tmpCustomerDate') > 0
						ThisForm.Caption = ThisForm.Caption + " - No SQL data to import! "
						*ThisForm.cmdUpdateTable.Visible = .F.
					ENDIF
				ENDIF
			ENDIF	
			USE IN tmpCustomerDate
		ENDIF
		
		ENDIF
		
		SELECT Customer_List
	ENDPROC

	PROCEDURE Unload
		IF USED("Customer_List")
			USE IN Customer_List
		ENDIF
		
		 = SQLDISCONNECT(ThisForm.nConnHandle )
		 
	ENDPROC

