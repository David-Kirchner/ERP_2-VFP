DEFINE CLASS dataenvironment AS dataenvironment 
 	*< CLASSDATA: Baseclass="dataenvironment" Timestamp="" Scale="" Uniqueid="" ClassIcon="2" />

	*<PropValue>
		DataSource = .NULL.
		Height = 0
		Left = 0
		Name = "Dataenvironment"
		Top = 0
		Width = 0
	*</PropValue>

ENDDEFINE

DEFINE CLASS frmchoosealloysources AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtAlloy" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdOK" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: closealloys
		*p: connhandle
		*p: creturnvalue
	*</DefinedPropArrayMethod>

	*<PropValue>
		AlwaysOnTop = .T.
		AutoCenter = .T.
		Caption = "Choose the Alloy"
		connhandle = 0
		creturnvalue = ""
		DataSession = 2
		DoCreate = .T.
		Height = 83
		MaxButton = .F.
		MDIForm = .T.
		MinButton = .F.
		Name = "frmChooseAlloySources"
		Width = 224
		WindowState = 0
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdOK' AS commandbutton WITH ;
		Caption = "OK", ;
		Height = 27, ;
		Left = 30, ;
		Name = "cmdOK", ;
		Top = 45, ;
		Width = 168
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Label1' AS label WITH ;
		Alignment = 1, ;
		Caption = "Alloy", ;
		Height = 17, ;
		Left = 10, ;
		Name = "Label1", ;
		Top = 14, ;
		Width = 40
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'txtAlloy' AS textbox WITH ;
		Height = 23, ;
		Left = 69, ;
		Name = "txtAlloy", ;
		SelectOnEntry = .T., ;
		Top = 11, ;
		Width = 132
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		PARAMETER cInAlloy
		
		IF TYPE("cInAlloy") = "C"
			ThisForm.txtAlloy.Value = cInAlloy
		ELSE
			ThisForm.txtAlloy.Value = ""
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.Connhandle = get_SQLSTRINGCONNECT()
	ENDPROC

	PROCEDURE Load
		IF USED("Alloys")
			ThisForm.CloseAlloys = .F.
		ELSE
			*USE Alloys IN 0 SHARED
			ThisForm.CloseAlloys = .T.
			
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF ThisForm.CloseAlloys
			IF USED("Alloys")
				USE IN Alloys
			ENDIF
		ENDIF
		
		IF ThisForm.Connhandle > 0
			SQLDISCONNECT(ThisForm.Connhandle)
		ENDIF
		
		RETURN This.cReturnValue
	ENDPROC

	PROCEDURE cmdOK.Click
		ThisForm.cReturnValue = ALLTRIM(ThisForm.txtAlloy.Value)
		ThisForm.Release
		
	ENDPROC

	PROCEDURE txtAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisForm.Connhandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
		
		
	ENDPROC

	PROCEDURE txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

ENDDEFINE
