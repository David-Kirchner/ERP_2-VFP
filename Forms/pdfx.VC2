		encryptdocument = .F.
		FRXDataSession = -1
		Height = 23
		lcanaddnotes = .F.
		lcancopy = .T.
		lcanedit = .F.
		lcanprint = .T.
		lencryptdocument = .F.
		ListenerType = 2
		lopenviewer = .F.
		mergedocument = .F.
		mergedocumentname = 
		Name = "pdfasimagelistener"
		nencryptionlevel = 5
		npageheight = 0
		oimagescollection = .NULL.
		opage = .NULL.
		oprogress = .F.
		oregistry = .F.
