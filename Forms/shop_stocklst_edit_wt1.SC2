		ThisForm.Visible = .F.
		
		ThisFormset.frmShop_StockLst_Edit.Visible = .T.
		ThisFormset.frmShop_StockLst_Edit.txtWO.SetFocus
	ENDPROC

	PROCEDURE frmChooseWO.cmdSelect.Click
		PRIVATE nWO
		
