	PROCEDURE frmModiProcess.AllowSub1.Valid
		DO CASE 
		CASE This.Value = "Y"
		CASE This.Value = "T"
			This.Value = "Y"
		CASE This.Value = "N"
		CASE This.Value = "F"
			This.Value = "N"
		OTHERWISE
			MESSAGEBOX("Allow Subtitue stock (Y/N)"+CHR(13)+CHR(13)+;
			"No if SalesPerson has cleared this specific Stock item with customer."+;
			"Yes, subtitue if a better item is available. Sold Generic item.",0+32,"Bad response")
		ENDCASE
	ENDPROC

	PROCEDURE frmModiProcess.cmdClose.Click
		ThisForm.Visible = .F.
	ENDPROC

	PROCEDURE frmModiProcess.cmdModifyStockLst.Click
		
		PRIVATE cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
		IF This.Caption = "Modify StockLst"
			cTBL = 'S'
		ELSE
			cTBL = 'B'
		ENDIF
		
		DO CASE
		CASE This.Caption = "Modify StockLst"
			cTBL = "S"
		CASE This.Caption = "Modify BrokerLst"
			cTBL = "B"
		CASE This.Caption = "Modify WIPLst"
			cTBL = "W"
		OTHERWISE
			MESSAGEBOX("Save Modify StockLst button was not like 'Modify StockLst'!",0+16,"Aborting Save!")
			TrackMess("Save Modify StockLst button was not like 'Modify StockLst'!"+CHR(13)+" frmModiProcess.cmdModifyStockLst.Click()")
			RETURN .F.
		ENDCASE
		
		nID_Detail			= PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
		nID_Detail_Process	= PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		cSOitem				= PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		cPOitem				= PrepareSQLtxt(ThisForm.POitem1.Value,'POitem',12)
		nWO					= PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		
		ThisFormSet.StockLst_ID_Detail	= nID_Detail
		ThisFormSet.ID_Detail_Process	= nID_Detail_Process
		
		PRIVATE nWO_Detail, nRID, cHeat
		nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		nRID		= PrepareSQLnum(ThisForm.txtfReceivingID.Value,'ReceivingID',-3)
		cHeat		= getHeat_from_RID(nRID,ThisFormSet.nConnHandle)
		
		DO FORM Forms\Modify_Stocklst_Detail WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO, nWO_Detail, nRID, cHeat
		*DO FORM Forms\Modify_Stocklst_Detail WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
		
		*ThisFormSet.RefreshStockLst('', cTBL)	
		ThisFormSet.RefreshTmpQuotes()
		*ThisFormSet.StockLstProcesses(nID_Detail, 'SOitem', "SHOW")
		ThisFormSet.frmStockLstProcesses.Visible = .F.
		
	ENDPROC

	PROCEDURE frmModiProcess.cmdModifyStockLst.When
		PRIVATE lReceiving
		PRIVATE cPOitem
		lReceiving = .F.
		IF ThisForm.cmdReceiving.Enabled
			
			cPOitem = ThisForm.POItem1.Value
			IF NOT EMPTY(cPOitem)
				IF VAL(cPOitem) > 0
					lReceiving = .T.	
				ENDIF
			ENDIF
		ENDIF
		
		
		
		IF lReceiving
			IF MESSAGEBOX("There is no receiving record for this PO and Process."+CHR(13)+"Are you sure you want to 'Modify' ?"+CHR(13)+CHR(13)+"If you consume you will not be able to enter a receiving record.",4+32,"No Receiving Record.")=6
				RETURN .T.
			ELSE
				RETURN .F.
			ENDIF
		ELSE
			RETURN .T.
		ENDIF
		
	ENDPROC

	PROCEDURE frmModiProcess.cmdReceiving.Click
		PRIVATE cPOitem
		cPOitem = ThisForm.POitem1.Value
		
		IF VARTYPE(cPOitem) = "C"
			ThisFormSet.Stocklst_ID			= PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
			ThisFormSet.Stocklst_ID_Detail	= PrepareSQLnum(ThisForm.ID_Detail1,'ID_Detail',-3)
			ThisFormSet.StockLst_TBL		= SUBSTR(ThisForm.lblCreateStockLstProcess.Caption,5,1)
			
			PRIVATE cTBL, nID_Detail, cHeat
			cTBL	= UPPER(ThisFormSet.StockLst_TBL)
			nID_Detail	= ThisFormSet.Stocklst_ID_Detail
			cHeat = ''
			IF nID_Detail > 0 AND NOT EMPTY(cTBL)
				IF cTBL = "S"
					DO FORM Forms\Receive_Edit WITH 'Stk_Detail', nID_Detail ,cHeat
				ELSE
					DO FORM Forms\Receive_Edit WITH 'Brk_Detail', nID_Detail ,cHeat
				ENDIF
			ELSE
				MESSAGEBOX("Did not get Stock ID_Detail")
			ENDIF
			*ThisFormSet.ReceivingLoad(cPOitem)
			
		ENDIF
	ENDPROC

	PROCEDURE frmModiProcess.cmdSave.Click
		PRIVATE cSQLi, nSQLEXEC 
		PRIVATE nID_Detail,cSalesPerson,dStartDate,dDueDate
		PRIVATE cAllowSub,npWeight,npQTY,npPc,cSOitem,nWO,cProcess_ID,cProcessor,cComment
		PRIVATE cPO_Item, cTBL
		*frmModiProcess
		nID_Detail	 	= PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail', -3,0 )
		cSalesPerson 	= PrepareSQLtxt(ThisForm.SalesPerson1.Value,'SalesPerson',20)
		dStartdate	 	= PrepareSQLdate(ThisForm.StartDate1.Value,'StartDate')
		dDueDate 		= PrepareSQLdate(ThisForm.DueDate1.Value,'DueDate')
		cAllowSub 		= PrepareSQLtxt(ThisForm.AllowSub1.Value,'AllowSub',1)
		nPU				= PrepareSQLnum(ThisForm.PU1.Value,'PU',-1)
		nQTY			= PrepareSQLnum(ThisForm.QTY1.Value,'QTY',18,4)
		npWeight 		= PrepareSQLnum(ThisForm.pWeight1.Value,'pWeight',9,1)
		
		cSOitem 		= Proper_SO_Item(ThisForm.SOitem1.Value)
		nWO				= PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		cProcess_ID 	= PrepareSQLtxt(ThisForm.Process_ID1.Value,'Process_ID',10)
		cProcessor		= PrepareSQLtxt(ThisForm.Processor1.Value,'Processor',20)
		cComment 		= PrepareSQLtxt(ThisForm.Comment1.Value,'Comment',100)
		cPO_Item		= ""
		
		PRIVATE nReceivingID
		nReceivingID = 0 &&This is the Create Process
		
		
		***~Check DATA
		
		DO CASE
		CASE ThisForm.cmdModifyStockLst.Caption = "Modify StockLst"
			cTBL = "S"
		CASE ThisForm.cmdModifyStockLst.Caption = "Modify BrokerLst"
			cTBL = "B"
		CASE ThisForm.cmdModifyStockLst.Caption = "Modify WIPLst"
			cTBL = "W"
		OTHERWISE
			MESSAGEBOX("Save Caption was not like 'Modify StockLst'!",0+16,"Aborting Save!")
			TrackMess("Save Caption was not like 'Modify StockLst'!"+CHR(13)+" frmShop_StockLst_Edit:frmModi_Process.cmdSave.Click()")
			RETURN .F.
		ENDCASE
		
		
		IF ThisForm.ogSOitem.Value = 2
			*INV Correction
			cSalesPerson	= PrepareSQLtxt(LEFT(SUBSTR(SYS(0),AT("#",SYS(0))+1),20),'SalesPerson',20)
			cAllowSub		= "N"
			npWeight		= 0
			*npPc			= 0
			dStartDate		= DATE()
			dDueDate		= DATE()
			cSOitem			= ""
			cPO_Item		= ""
			cProcess_ID		= "CORRECTION"  &&Used in Searches, DO NOT change
			cProcessor		= PrepareSQLtxt( LEFT(SYS(0),20),'Processor',20)  &&+" "+DTOC(date())+" "+time()
		ENDIF
		
		************************************
		* Make sure Sales is not listed as Cmplt
		* Sales Update Trigger will DELETE this process if Sales is CMPLT
		
		cSQL = "UPDATE dbo.Sales SET [cmplt] = 0 "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
		ENDIF
		
		************************************
		* Make sure PurchaseOrder is not listed as Delivered
		* PurchaseOrder Update trigger will DELETE this Process if PO is Delivered
		
		cSQL = "UPDATE dbo.PurchaseOrder SET Delivered = 0 "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
		ENDIF
		
		*****************************************
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		*Save Process
		*p_StockLst_Process_ins
		DO CASE
		CASE cTBL = "S"
			cSQLi = "EXEC dbo.p_StockLst_Process_ins6 "
		CASE cTBL = "B"
			cSQLi = "EXEC dbo.p_BrokerLst_Process_ins6 "	
		CASE cTBL = "W"
			cSQLi = "EXEC dbo.p_WIPLst_Process_ins6 "
		ENDCASE
		cSQLi = cSQLi + " @ID_Detail = "+STR(nID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@Startdate = '"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"
		
		*cSQLi = cSQLi + ",@pPc = "+STR(npPc)
		
		cSQLi = cSQLi + ",@PU = "+STR(nPU)
		cSQLi = cSQLi + ",@QTY = "+STR(nQTY)
		cSQLi = cSQLi + ",@Pounds = "+STR(npWeight,9,1)
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@WO = "+STR(nWO)
		cSQLi = cSQLi + ",@PO_Item = '"+cPO_Item+"'"
		cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"
		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		cSQLi = cSQLi + ",@ReceivingID = "+STR(nReceivingID)
		
		
		nTran = SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisFormSet.nConnHandle,nSQLEXEC,'tmpID_Detail_Process')
			TrackError("p_StockLst_Process_ins", "Could not EXEC dbo.p_StockLst_Process_ins "+CHR(13)+cSQLi,"Shop_StockLst_Edit.ModiProcess.cmdSave()",LINENO())
			nTran = SQLROLLBACK(ThisFormSet.nConnHandle)
			nTran = SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
			RETURN
		ELSE
			nTran = SQLCOMMIT(ThisFormSet.nConnHandle)
			nTran = SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		ENDIF	
		
		IF USED('tmpID_Detail_Process')
			ThisForm.ID_Detail_Process1.Value = PrepareSQLnum(tmpID_Detail_Process.Exp,'ID_Detail_Process',-3)
			ThisFormSet.ID_Detail_Process	  = PrepareSQLnum(tmpID_Detail_Process.Exp,'ID_Detail_Process',-3)
			
			USE IN tmpID_Detail_Process
		ELSE
			ThisForm.ID_Detail_Process1.Value = 0
			ThisFormSet.ID_Detail_Process	  = 0
		ENDIF	
		
		ThisForm.ID_Detail_Process1.Refresh
		ThisForm.ID_Detail_Process1.Visible = .T.
			
		IF NOT ( EMPTY(cSOitem) OR Proper_SO_Item(cSOitem) = Proper_SO_item("") )
			*UPDATE Sales SET prcp = .T. WHERE SOitem = (m.SOitem)  &&Has trigger to delete Cmplt Processes!!!!
			Update_PrcpPrcdinSales( .T.,.F.,cSOitem,ThisFormSet.nConnHandle )
			* && Has trigger to delete Cmplt Processes!!!!
		ENDIF
		
		This.Enabled = .F.
		ThisForm.ogSOitem.Enabled = .F.
		ThisForm.cmdModifyStockLst.Enabled = .T.
		THISFORM.cmdShowStockLst.Enabled = .T.
		*THISFORM.cmdEditStockLst.Enabled = .T.
		ThisForm.lblStartDate1.Enabled = .F.
		ThisForm.lblDueDate1.Enabled = .F.
		ThisForm.Visible = .F.
				
		IF cProcess_ID	= "CORRECTION"
			
			PRIVATE nID_Detail_Process, cPOitem
		*	cTBL				= PrepareSQLtxt(tmpProcess.TBL,'TBL',1)
		*	nID_Detail			= PrepareSQLnum(ThisForm.ID_Detail1.Value.ID_Detail,'ID_Detail',-3)
			nID_Detail_Process	= PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		*	cSOitem				= PrepareSQLtxt(tmpProcess.SOitem,'SOitem',10)
			cPOitem				= PrepareSQLtxt(tmpProcess.PO_item,'POitem',12)
		*	nWO					= PrepareSQLnum(tmpProcess.WO,'WO',-3)
		
			PRIVATE nWO_Detail, cHeat
			nWO_Detail	= PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
			cHeat		= getHeat_from_RID(nReceivingID,ThisFormSet.nConnHandle)
		
			ThisFormSet.StockLst_ID_Detail = nID_Detail
			*DO FORM Forms\Modify_Stocklst_Detail WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
			DO FORM Forms\Modify_Stocklst_Detail WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO, nWO_Detail, nReceivingID, cHeat
			*ThisFormSet.RefreshStockLst('', cTBL)
			ThisFormSet.RefreshTmpQuotes()
			*ThisFormSet.StockLstProcesses(nID_Detail, 'SOitem', "SHOW")
			ThisFormSet.frmStockLstProcesses.Visible = .F.
		ELSE
			*IF ThisFormSet.frmStockLst.Visible
				ThisFormSet.StockLst_ID_Detail = nID_Detail
				*ThisFormSet.RefreshStockLst("RELOAD",IIF(cTbl = "S","StockLst ","BrokerLst") )
			*ENDIF
				
			ThisFormSet.RefreshtmpQuotes()
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmModiProcess.cmdShowStockLst.Click
		PRIVATE nID_Detail
		nID_Detail = ThisForm.ID_Detail1.Value
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisForm.txtTBL.Value,'TBL',1)
		
		IF NOT USED("vStockLst_SQL")
			*ThisFormSet.StockLst_ID_Detail = nID_Detail
			IF ThisFormSet.SetSelectedID_Detail('ID_Detail',nID_Detail,cTBL)
			ENDIF
			ThisFormSet.RefreshStockLst()
		ENDIF
		
		SELECT vStockLst_SQL
		LOCATE FOR ID_Detail = nID_Detail
		
		ThisFormSet.frmStockLst.grdStockLst.Visible = .T.
		ThisFormSet.frmStockLst.Visible = .T.
		ThisFormSet.RefreshStockStatus()
		ThisFormSet.frmStockStatus.Visible = .T.
		
		ThisFormSet.frmStockLst.grdStockLst.Refresh
		ThisFormSet.frmStockLst.grdStockLst.SetFocus()
		
	ENDPROC

	PROCEDURE frmModiProcess.lblDueDate1.Click
		PRIVATE m.dDate1,m.dDate2
		
		m.dDate1 = ThisForm.DueDATE1.Value
		
		DO FORM "forms\popupdate.scx" WITH m.dDate1 TO m.dDate2
		ThisForm.DueDATE1.Value = m.dDate2
		
		ThisForm.DueDATE1.Refresh
	ENDPROC

	PROCEDURE frmModiProcess.lblstartDate1.Click
		PRIVATE m.dDate1,m.dDate2
		m.dDate1 = ThisForm.StartDATE1.Value
		DO FORM "forms\popupdate.scx" WITH m.dDate1 TO m.dDate2
		
		ThisForm.StartDATE1.Value = m.dDate2
		ThisForm.StartDATE1.Refresh
		
		
	ENDPROC

	PROCEDURE frmModiProcess.ogSOitem.InteractiveChange
		DO CASE
		CASE This.Value = 1
			ThisForm.SOITEM1.VISIBLE = .T.
			ThisForm.WO1.VISIBLE = .T.
			ThisForm.PO_ITEM1.VISIBLE = .T.
			ThisForm.lblSalesPerson1.Visible = .T.
			ThisForm.SalesPerson1.Visible = .T.
			ThisForm.lblstartDate1.Visible = .T.
			ThisForm.StartDate1.Visible = .T.
			ThisForm.lblDueDate1.Visible = .T.
			ThisForm.DueDate1.Visible = .T.
			ThisForm.lblAllowSub.VISIBLE = .T.
			ThisForm.AllowSub1.VISIBLE = .T.
			ThisForm.lblWeight1.Visible = .T.
			ThisForm.pWeight1.Visible = .T.
			ThisForm.lblQTY.Visible = .T.
			ThisForm.QTY1.Visible = .T.
			ThisForm.PU1.Visible = .T.
			ThisForm.lblProcess_ID1.Visible = .T.
			ThisForm.Process_ID1.Visible = .T.
			ThisForm.lblProcessor1.Visible = .T.
			ThisForm.Processor1.Visible = .T.
		CASE This.Value = 2
			ThisForm.SOITEM1.VISIBLE = .F.
			ThisForm.WO1.VISIBLE = .F.
			ThisForm.PO_ITEM1.VISIBLE = .F.
			ThisForm.lblSalesPerson1.Visible = .F.
			ThisForm.SalesPerson1.Visible = .F.
			ThisForm.lblstartDate1.Visible = .F.
			ThisForm.StartDate1.Visible = .F.
			ThisForm.lblDueDate1.Visible = .F.
			ThisForm.DueDate1.Visible = .F.
			ThisForm.lblAllowSub.VISIBLE = .F.
			ThisForm.AllowSub1.VISIBLE = .F.
			ThisForm.lblWeight1.Visible = .F.
			ThisForm.pWeight1.Visible = .F.
			ThisForm.lblQTY.Visible = .F.
			ThisForm.QTY1.Visible = .F.
			ThisForm.PU1.Visible = .F.
			ThisForm.lblProcess_ID1.Visible = .F.
			ThisForm.Process_ID1.Visible = .F.
			ThisForm.lblProcessor1.Visible = .F.
			ThisForm.Processor1.Visible = .F.
		ENDCASE
	ENDPROC

	PROCEDURE frmQuote.Refresh
		*********************************************************************************
		** CHANGES HERE MUST BE REPLICATED TO PurchaseOrder and PackingSlip
		** Form Changes must be made to Proc_Quotes.prg **
		*********************************************************************************
		
		IF NOT USED('tmpSO')
			TrackError("tmpSO not Found","tmpSO not Found","Shop_StockLst_Edit:frmQuote.Refresh",LINENO())
			ThisFormSet.RefreshTmpQuotes()
		ENDIF 
		
		IF USED('tmpSO')
			DO CASE
			*10,Bar,11,Flat Bar,12,Hex Bar,13,Square Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,
			*40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
			CASE tmpSO.Form = "10" &&Bar
				This.LBLTHCK1.Caption = "Dia:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .F.
				This.LBLSZ31.Caption = ""
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Bar"
			CASE tmpSO.Form = "11" &&Flat Bar
				This.LBLTHCK1.Caption = "Bar:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Flat Bar"
			CASE tmpSO.Form = "12" &&Hex Bar
				This.LBLTHCK1.Caption = "Hex:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .F.
				This.LBLSZ31.Caption = ""
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Hex Bar"
			CASE tmpSO.Form = "20" &&Wire Spool
				This.LBLTHCK1.Caption = "Dia:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "Pounds Spool"
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Wire"
			CASE tmpSO.Form = "21" &&Wire Cuts
				This.LBLTHCK1.Caption = "Dia:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = ["Cuts]
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Cut Wire"
			CASE tmpSO.Form = "30" &&Coated Electrodes
				This.LBLTHCK1.Caption = "Dia:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = ["CE]
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Pound Can"
			CASE tmpSO.Form = "40" &&Plate Sheet
				This.LBLTHCK1.Caption = "Thck:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Plate/Sheet"
			CASE tmpSO.Form = "51" &&Strip
				This.LBLTHCK1.Caption = "Thck:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Pounds Strip"
			CASE tmpSO.Form = "60" && Tube
				This.LBLTHCK1.Caption = "OD"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "Wall"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Tube"
			CASE tmpSO.Form = "65" && Pipe
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Pipe"
			CASE tmpSO.Form = "66" && Nipple
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Nipple"
			CASE tmpSO.Form = "67" &&Elbow
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "Deg"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Elbow"
			CASE tmpSO.Form = "68" &&Tee
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .F.
				This.LBLSZ31.Caption = ""
				This.SZ31.Enabled = .F.
				This.SZ31.Visible = .F.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Tee"
			CASE tmpSO.Form = "69" && Reducer
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "IPS"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "SCH"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Reducer"
			*60 Pipe, 65 Tube, 66 Nipple, 67 Elbow, 68 Tee, 69 Reducer, 70 Fittings, 72 Flange, 75 Fasteners, 80 Disk 	
			CASE tmpSO.Form = "70" &&Fittings
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Fittings"
			CASE tmpSO.Form = "71" &&Coupling
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "LBS"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "X Lg"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Coupling"
			CASE tmpSO.Form = "72" &&Flange
				This.LBLTHCK1.Caption = "IPS"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "SCH"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = " - Lb"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Flange"
			CASE tmpSO.Form = "75" &&Fasteners
				This.LBLTHCK1.Caption = ""
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "-"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Long"
			CASE tmpSO.Form = "80" &&Disk
				This.LBLTHCK1.Caption = "Thck:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "OD:"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "ID:"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .T.
				This.LBLSZ41.Caption = "Disk"
			CASE tmpSO.Form = "90"
				This.LBLTHCK1.Caption = "Mach:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .F.
				This.LBLSZ41.Caption = ""
			OTHERWISE &&
				This.LBLTHCK1.Caption = "Thck:"
				This.LBLSZ21.Visible = .T.
				This.LBLSZ21.Caption = "X"
				This.SZ21.Visible = .T.
				This.LBLSZ31.Visible = .T.
				This.LBLSZ31.Caption = "  X"
				This.SZ31.Enabled = .T.
				This.SZ31.Visible = .T.
				This.LBLSZ41.Visible = .F.
				This.LBLSZ41.Caption = ""
			ENDCASE
		
		ENDIF
	ENDPROC

