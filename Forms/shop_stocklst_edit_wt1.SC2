	PROCEDURE frmStockLst.cmbAlloy.Init
		*#DEFINE ALLAlloy_LOC "(All)"
		this.clear
		*this.additem(ALLAlloy_LOC)
		
		IF NOT USED("vStockLst_SQL")
			ThisFormSet.RefreshStockLst()
		ENDIF
		
		LOCAL aAlloys,cAlloy
		DIMENSION aAlloys[1]
		
		SELECT DISTINCT alloy FROM vStockLst_SQL WHERE !EMPTY(alloy) ORDER BY Alloy INTO array aAlloys
		
		FOR EACH m.cAlloy IN aAlloys
			IF !EMPTY(m.cAlloy)
				this.additem(m.cAlloy)
			ENDIF
		ENDFOR
		
		*THIS.VALUE = ALLAlloy_LOC
		*THIS.VALUE = aAlloys(1)
		
	ENDPROC

	PROCEDURE frmStockLst.cmbAlloy.InteractiveChange
		PRIVATE cAlloy, cCC, nCurrentRecord
		
		cAlloy	= This.Value
		cCC		= ThisForm.cmbCC.Value
		nCurrentRecord = RECNO('vStockLst_SQL')
		
		SELECT vStockLst_SQL
		SEEK cAlloy IN vStockLst_SQL ORDER Alloy
		
		IF NOT FOUND('vStockLst_SQL')
			WAIT WINDOW 'Not found!'
			IF RECCOUNT('vStockLst_SQL') <= nCurrentRecord 
				GOTO nCurrentRecord 
			ENDIF
		ELSE
			ThisForm.cmbCC.Value = vStockLst_SQL.CC
			ThisForm.cmbCL.Value = vStockLst_SQL.CL
		ENDIF
		
		ThisForm.grdStockLst.Refresh
	ENDPROC

	PROCEDURE frmStockLst.cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		This.Value = "1"
		
	ENDPROC

	PROCEDURE frmStockLst.cmbCC.InteractiveChange
		PRIVATE cAlloy, cForm, nThck, cCC, nCurrentRecord, nSize
		
		cAlloy	= ThisForm.cmbAlloy.Value
		cForm 	= ThisForm.cmbForm.Value
		*nThck	= PrepareSQLnum(vStockLst_SQL.Size,'Thck',9,3)
		cCC		= This.Value
		nCurrentRecord = RECNO('vStockLst_SQL')
		nSize		= vStockLst_SQL.Size
		*+STR(nSize,9,3)
		PRIVATE cFormSort, nCCSortValue, cCCSort
		cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisFormSet.nConnHandle),2,0))
		nCCSortValue = CCSortValue( cCC, ThisFormSet.nConnHandle)
		cCCSort = STR(nCCSortValue,2,0)
		
		PRIVATE nBestItem 
		nBestItem = RECNO('vStockLst_SQL')
		
		SELECT vStockLst_SQL
		*Check with Alloy, Form, CC
		
		LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC 
		IF NOT FOUND('vStockLst_SQL')
		
			*Check with Alloy, Form, CCSort
			SEEK cAlloy+cForm+cCCSort IN vStockLst_SQL ORDER AlloyFrmCC
			*SEEK cAlloy+cFormSort+cCCSort+STR(nThck,9,3) ORDER AlFmsCCSz IN vStockLst_SQL
			IF NOT FOUND('vStockLst_SQL')
				*Check with Alloy, FormSort, CCSort
				SEEK cAlloy+cFormSort+cCCSort IN vStockLst_SQL ORDER AlFmsCCs
				
				IF NOT FOUND('vStockLst_SQL')
					*LOCATE cAlloy+cCC 
					LOCATE FOR Alloy=cAlloy AND CC = cCC
					IF NOT FOUND('vStockLst_SQL')
						*LOCATE cAlloy+CCSortValue 
						LOCATE FOR Alloy=cAlloy AND CCSortValue = nCCSortValue
						IF NOT FOUND('vStockLst_SQL')
							WAIT WINDOW 'Not found!'
							GOTO nCurrentRecord 
						ENDIF
					
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		*ThisForm.cmdSearch.Visible = .T.
		ThisForm.grdStockLst.Refresh
	ENDPROC

	PROCEDURE frmStockLst.cmbCC.Valid
		ThisFormSet.ReloadCL()
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Value,'CC',1)
		ThisFormSet.frmStockLst.cmbCL.Value = Default_CL_CC(cCC,ThisFormSet.nConnHandle)
		
	ENDPROC

