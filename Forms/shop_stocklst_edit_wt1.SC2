			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		*This.ColumnCount = ALEN(aConditionCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		
		*this.addListitem("(All Employees)",1,1)
		*this.addListitem("*",1,2)
		nLoopCount = 1
		*nLoopCount = 0
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
		*		nLoopCount = nLoopCount + 1
				IF LEN(ALLTRIM(cc1)) > 1
					
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = "*"
		This.Value = "1"
		
	ENDPROC

	PROCEDURE frmStockLst.cmbCL.InteractiveChange
		PRIVATE cAlloy, cForm, cCC, cCL, nCurrentRecord, nSize
		
		cAlloy	= ThisForm.cmbAlloy.Value
		cForm 	= ThisForm.cmbForm.Value
		cCC		= ThisForm.cmbCC.Value
		cCL		= This.Value
		
		nCurrentRecord = RECNO('vStockLst_SQL')
		nSize		= vStockLst_SQL.Size
		nThck		= vStockLst_SQL.Size
		*+STR(nSize,9,3)
		PRIVATE cFormSort, nCCSortValue, cCCSort
		cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisFormSet.nConnHandle),2,0))
		nCCSortValue = CCSortValue( cCC, ThisFormSet.nConnHandle)
		cCCSort = STR(nCCSortValue,2,0)
		PRIVATE nBestItem 
		nBestItem = RECNO('vStockLst_SQL')
		
		SELECT vStockLst_SQL
		*Check with Alloy, Form, CC
		SEEK cAlloy+cFormSort+cCC+cCL+STR(nThck,9,3) ORDER AlFmsCLSz IN vStockLst_SQL
		IF NOT FOUND('vStockLst_SQL')
		
			LOCATE FOR Alloy=cAlloy AND Form=cForm AND CC=cCC AND CL=cCL
			IF FOUND('vStockLst_SQL')
		
				*Check with Alloy, Form, CCSort
				SEEK cAlloy+cForm+cCCSort IN vStockLst_SQL ORDER AlloyFrmCC
				IF NOT FOUND('vStockLst_SQL')
					*Check with Alloy, FormSort, CCSort
					SEEK cAlloy+cFormSort+cCCSort IN vStockLst_SQL ORDER AlFmsCCs
					
					IF NOT FOUND('vStockLst_SQL')
						*LOCATE cAlloy+cCC 
						LOCATE FOR Alloy=cAlloy AND CC = cCC
						IF NOT FOUND('vStockLst_SQL')
							*LOCATE cAlloy+CCSortValue 
							LOCATE FOR Alloy=cAlloy AND CCSortValue = nCCSortValue
							IF NOT FOUND('vStockLst_SQL')
								WAIT WINDOW 'Not found!'
								GOTO nCurrentRecord 
							ENDIF
						
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		*ThisForm.cmdSearch.Visible = .T.
		ThisForm.grdStockLst.Refresh
	ENDPROC

	PROCEDURE frmStockLst.cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			USE IN FormCode
		ENDIF
		
		SELECT 0
		
		*this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
		
			IF RECCOUNT('FormCode') = 0
				*Load again
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'FormCode')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'FormCode')
				ENDDO
			ENDIF
			
			IF RECCOUNT('FormCode') = 0
				SELECT '' AS FormNumber,'' AS FormDescription FROM FormCode INTO ARRAY aFormCode
			ELSE
				SELECT FormNumber,FormDescription FROM FormCode INTO ARRAY aFormCode
			ENDIF
				
			
			USE IN FormCode
		ENDIF
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		
		This.ColumnCount = 2
		This.NumberOfElements = nArrayCount
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
		
		This.Value = '10'
		
	ENDPROC

	PROCEDURE frmStockLst.cmbForm.InteractiveChange
		PRIVATE cAlloy, cForm, cCC, cCL, nCurrentRecord
		
		cAlloy	= ThisForm.cmbAlloy.Value
		cForm	= This.Value
		cCC		= ThisForm.cmbCC.Value
		cCL		= ThisForm.cmbCL.Value
		
		nCurrentRecord = RECNO('vStockLst_SQL')
		
		SELECT vStockLst_SQL
		PRIVATE cFormSort
		cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisFormSet.nConnHandle),2,0))
		
		PRIVATE cCCSort
		cCCSort = STR( CCSortValue( cCC, ThisFormSet.nConnHandle),2,0)
		
		SEEK cAlloy+cFormSort+cCCSort IN vStockLst_SQL ORDER AlFmsCCs
		IF NOT FOUND('vStockLst_SQL')
			*Just Alloy and Form
			*SEEK cAlloy+cFormSort IN vStockLst_SQL ORDER AlloyFrmS
			*LOCATE FOR Alloy = cAlloy AND STR(CCSort,2,0) = cCCsort
			LOCATE FOR Alloy = cAlloy AND FormSort = VAL(cFormSort)
			
			IF NOT FOUND('vStockLst_SQL')
				
				WAIT WINDOW 'Not found!'
				SELECT vStockLst_SQL
				IF RECCOUNT('vStockLst_SQL') >=  nCurrentRecord 
					GOTO nCurrentRecord 
				ELSE
					LOCATE FOR Alloy = cAlloy
				ENDIF
			ENDIF
		ENDIF
		
		*ThisForm.cmdSearch.Visible = .T.
		ThisForm.grdStockLst.Refresh
	ENDPROC

	PROCEDURE frmStockLst.cmbForm.Valid
		*RowSource=10,Bar,11,Flat Bar,12,Hex Bar,20,Wire Spool,21,Wire Cut,30,Coat Elect,40,Plate/Sheet,51,Strip,60,Tube,65,Pipe,66,Nipple,67,Elbow,68,Tee,69,Reducer,70,Fittings,72,Flange,75,Fastener,80,Disk
		PRIVATE cAlloy, cForm, cCC, cCL
		cAlloy = vStockLst_SQL.Alloy
		cForm = This.Value
		cCC	= This.Parent.cmbCC.Value
		cCL	= This.Parent.cmbCL.Value
		
		*!*	IF NOT ThisForm.OrderAlloyForm
		*!*		SELECT vStockLst_SQL
		*!*		ThisForm.OrderAlloyForm = .T.
		*!*	ENDIF
		
		PRIVATE cFormSort
		cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisFormSet.nConnHandle),2,0))
		PRIVATE cCCSort
		cCCSort = STR( CCSortValue( cCC, ThisFormSet.nConnHandle),2,0)
		
		SELECT vStockLst_SQL
		SEEK cAlloy+cFormSort+cCCSort IN vStockLst_SQL ORDER AlFmsCCs
		
		IF NOT FOUND('vStockLst_SQL')
			LOCATE FOR Alloy = cAlloy AND FormSort = VAL(cFormSort)
			
			IF NOT FOUND("vStockLst_SQL")
				SEEK cAlloy IN vStockLst_SQL ORDER Alloy
			ENDIF
		ENDIF
		
		*ThisForm.grdStockLst.SetFocus &&Cannot run from Valid
		
	ENDPROC

	PROCEDURE frmStockLst.cmd1Inch.Click
		PRIVATE cAlloy, cForm, cCC, cCL, nLastRec
		cAlloy = PrepareSQLtxt(vStockLst_SQL.Alloy,'Alloy',12)
		cForm  = PrepareSQLtxt(vStockLst_SQL.Form,'Form',2)
		cCC = PrepareSQLtxt(vStockLst_SQL.CC,'CC',1)
		cCL = PrepareSQLtxt(vStockLst_SQL.CL,'CL',1)
		nLastRec = 0
		
		PRIVATE cFormSort, nCCSortValue, cCCSort
		cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisFormSet.nConnHandle),2,0))
		nCCSortValue = CCSortValue( cCC, ThisFormSet.nConnHandle) 
		cCCSort = STR(nCCSortValue,2,0)
		
		SELECT vStockLst_SQL
		SEEK cAlloy+cForm+cCCSort+STR(1,9,3) IN vStockLst_SQL ORDER StockLstC
		
		IF NOT FOUND("vStockLst_SQL")
		
			SEEK cAlloy+cFormSort+cCCSort+STR(1,9,3) IN vStockLst_SQL ORDER AlFmsCCsS
			
			IF FOUND("vStockLst_SQL")
				SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort) and CCSortValue = VAL(cCCSort)
				
				DO WHILE vStockLst_SQL.Alloy = (cAlloy) ;
						AND vStockLst_SQL.FormSort = VAL(cFormSort) ;
						AND vStockLst_SQL.CCSortValue = VAL(cCCSort) ;
						AND vStockLst_SQL.Size < 1
					nLastRec = RECNO()
					SKIP IN vStockLst_SQL
				ENDDO
		
				SET FILTER TO
			ELSE
				SEEK cAlloy+cFormSort+cCCSort  IN vStockLst_SQL ORDER AlFmsCCs
				IF FOUND("vStockLst_SQL")
					SET FILTER TO Alloy = (cAlloy) and FormSort = VAL(cFormSort) AND CCSortValue = VAL(cCCSort)
		
					DO WHILE vStockLst_SQL.Alloy = (cAlloy) ;
							AND vStockLst_SQL.FormSort = VAL(cFormSort) ;
							AND vStockLst_SQL.CCSortValue = VAL(cCCSort) ;
							AND vStockLst_SQL.Size < 1
						nLastRec = RECNO()
						SKIP IN vStockLst_SQL
					ENDDO
		
					SET FILTER TO
				ENDIF		
			ENDIF
		ENDIF
		
		IF nLastRec > 0
			GOTO nLastRec
		ENDIF
		
		ThisForm.grdStockLst.Refresh
		ThisForm.grdStockLst.SetFocus
	ENDPROC

