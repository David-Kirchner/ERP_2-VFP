	PROCEDURE getwo_detail
		PARAMETER pWO
		*ThisFormSet.GetWO_Detail()
		
		IF TYPE("pWO") != "C"
			TrackError("Need WO","Need WO","Receiving.GetWO_Detail()",LINENO() )
			MESSAGEBOX("Need WO",0,"GetWO_Detail()" )
			RETURN
		ENDIF
		IF EMPTY(pWO)
			TrackError("Need WO","Need WO","Receiving.GetWO_Detail()",LINENO() )
			MESSAGEBOX("Need WO",0,"GetWO_Detail()" )
			RETURN
		ENDIF
		
		**check HpaPO
		PRIVATE nItemPO, nHpaPo, cPOitem
		cPOitem = Proper_PO_Item( pHPAPoItem )
		nItemPO = Proper_PO_Item_Item(cPOitem)
		nHpaPo	= Proper_PO_Item_PO(cPOitem)
		
		IF nHpaPo = 0
			MESSAGEBOX("No PO to show!",0,"No PO")
			RETURN
		ENDIF
		
		PRIVATE nPOcnt 
		nPOcnt = 0
		
		IF nItemPo = 0
			*Guess at Item
			nPOcnt = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle )
			IF nPOcnt = 0
				MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
				RETURN
			ENDIF
			IF Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle, "FORSTOCK" ) = 0
				*Not for Stock!!!
			ENDIF
			IF nPOcnt = 1
				*Must be only one
				nItemPo = GetMaxItemforPO( nHpaPo, ThisFormSet.nConnHandle )
		*		SELECT PoItem FROM PurchaseOrder WHERE HpaPo = nHpaPo INTO ARRAY aPoItem
				*ThisForm.pf.pg_Add.txtHpaPOItem.Value = nItemPo
				ThisFormset.frmReceiving.txtHPAPOitem.Value = nItemPO
			ENDIF
			IF nPOcnt > 1
				*Show list of Item to Choose
				PRIVATE cPoItem
				DO FORM Forms\ChoosePOitem WITH nHpaPo TO cPoItem
				IF TYPE("cPoItem") = "C"
					IF NOT EMPTY("cPoItem")
						pHPAPoItem = cPoItem
						SET DECIMAL TO 0
		*				nHpaPo = VAL( LEFT(pHPAPoItem,9) )
						nItemPo = VAL( RIGHT(pHPAPoItem,2) )
						SET DECIMAL TO nDec
						IF EMPTY( ThisFormset.frmReceiving.txtHpaPOItem.Value )
							ThisFormset.frmReceiving.txtHpaPOItem.Value = nItemPo
						ENDIF
					ELSE
						MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
						RETURN	
					ENDIF		
				ELSE
					MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
					RETURN	
				ENDIF
			ENDIF
		ENDIF
		
		***Look at PurchaseOrder to back fill ThisFormset.frmReceiving-Not PO RecvStock
		PRIVATE cSOitem, cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, lRandLen, cDispAlloy, nStandSize, cMisc_purch
		PRIVATE nSalesNum, nItemSo, cDescription, nWeight
		
		cSQL = "SELECT SOitem, Company, Alloy, Form, Order_Qty, Pieces, Thck, Sz2, Sz3, Cond_Spec, Heat, RandLen, DispAlloy, StandSize, misc_purch "
		cSQL = cSQl + ",StockLst_QTY,StockLst_P,Pounds,Order_PU "
		cSQL = cSQl + " FROM dbo.PurchaseOrder WHERE PoItem = dbo.f_ProperPOitem('"+pHPAPoItem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOp')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOp' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOp' )
		ENDIF
		
		IF USED('tmpPOp')
			PRIVATE cSOitem, cCompany, cAlloy, cForm, nPieces, nThck, nSz2,	nSz3, cCond_Spec 
			PRIVATE cHeat, lRandLen, nStandSize
			
			cSOitem = Proper_SO_Item(tmpPOp.SOitem)
		
			PRIVATE nDec
			nDec = SET("DECIMAL")
			SET DECIMAL TO 0
			IF NOT ( EMPTY(cSOitem) OR Proper_SO_Item(cSOitem) = Proper_SO_item("") )
				nSalesNum = VAL( LEFT(cSOitem,7) )
				ThisFormset.frmReceiving.txtSOnum.Value = nSalesNum
				nItemSo = VAL( RIGHT(cSOitem,2) )
				ThisFormset.frmReceiving.txtSOItem.Value = nItemSo	
			ENDIF
			SET DECIMAL TO nDec
			*
			cCompany = PrepareSQLtxt(tmpPOp.Company,'Company',30)
			IF !EMPTY(cCompany)
				IF !EMPTY(ThisFormset.frmReceiving.txtVendor.Value)
					IF ThisFormset.frmReceiving.txtVendor.Value != cCompany
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Vendor '"+ALLTRIM(ThisFormset.frmReceiving.txtVendor.Value)+"' with '"+Alltrim(cCompany)+"?",4+32,"Purchase Order Table has Vendor listed differently.") = 6
							ThisFormset.frmReceiving.txtVendor.Value = cCompany
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtVendor.Value = ShowSQLtxt(cCompany,'Company',30)
				ENDIF
			ENDIF
			*
			cAlloy = PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
			IF !EMPTY(cAlloy)
				IF !EMPTY(ThisFormset.frmReceiving.txtAlloy.Value)
					IF ThisFormset.frmReceiving.txtAlloy.Value != cAlloy
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Alloy '"+ALLTRIM(ThisFormset.frmReceiving.txtAlloy.Value)+"' with '"+Alltrim(cAlloy)+"?",4+32,"Purchase Order Table has Alloy listed differently.") = 6
							ThisFormset.frmReceiving.txtAlloy.Value = cAlloy
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtAlloy.Value = cAlloy
				ENDIF
			ENDIF
			*
			cForm = PrepareSQLtxt(tmpPOp.Form,'form',2)
			nPieces = PrepareSQLnum(tmpPOp.Pieces,'Pieces',11,3)
			IF nPieces > 0
				IF !EMPTY(ThisFormset.frmReceiving.txtPieces.Value)
					IF ThisFormset.frmReceiving.txtPieces.Value != nPieces 
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Pieces '"+ALLTRIM(STR(ThisFormset.frmReceiving.txtPieces.Value))+"' with '"+Alltrim(STR(nPieces))+"?",4+32,"Purchase Order Table has Alloy listed differently.") = 6
							ThisFormset.frmReceiving.txtPieces.Value = nPieces
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtPieces.Value = nPieces
				ENDIF
			ENDIF
			*
			nThck = PrepareSQLnum(tmpPOp.Thck,'Thck',10,4)
			nSz2 = PrepareSQLnum(tmpPOp.Sz2,'Sz2',10,3)
			nSz3 = PrepareSQLnum(tmpPOp.Sz3,'Sz3',10,3)
			cCond_Spec = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-1)
			IF !EMPTY(cCond_Spec)
				IF !EMPTY(ThisFormset.frmReceiving.edtSpecs.Value)
					IF ThisFormset.frmReceiving.edtSpecs.Value != cCond_Spec
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Specs '"+ALLTRIM(ThisFormset.frmReceiving.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cCond_Spec)+"?",4+32,"Purchase Order Table has Specs listed differently.") = 6
							ThisFormset.frmReceiving.edtSpecs.Value = cCond_Spec
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.edtSpecs.Value = cCond_Spec
				ENDIF
			ENDIF
			*
			cHeat = PrepareSQLtxt(tmpPOp.Heat,'Heat',40)
			IF !EMPTY(cHeat)
				IF !EMPTY( ALLTRIM(ThisFormset.frmReceiving.txtHeat.Value ))
					IF ThisFormset.frmReceiving.txtHeat.Value != cHeat
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Heat '"+ALLTRIM(ThisFormset.frmReceiving.txtHeat.Value)+"'"+CHR(13)+" with '"+Alltrim(cHeat)+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
							ThisFormset.frmReceiving.txtHeat.Value = cHeat
						ELSE
							*Keep the Receiving Heat
							PRIVATE cRecvHeat
							cRecvHeat = PrepareSQLtxt(ThisFormset.frmReceiving.txtHeat.Value,'Heat',50)
							IF NOT EMPTY(cRecvHeat)
								cHeat = cRecvHeat
								ThisFormset.frmReceiving.txtHeat.Value = cRecvHeat
							ENDIF
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtHeat.Value = cHeat
				ENDIF
			ENDIF
			*
			lRandLen = PrepareSQLlogic(tmpPOp.RandLen,'RandLen')
			nStandSize = PrepareSQLnum(tmpPOp.StandSize,'StandSize',10,4)
			**
			PRIVATE nOrder_PU
			nOrder_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
			IF nOrder_PU = 0
				*Use old way
				nOrder_PU = GetPUfromForm( cForm, ThisFormSet.nConnHandle )
			ENDIF
			
			*FormUnitPrice('10') FormUnitCaption('10')
			PRIVATE cPriceUnit
			cPriceUnit = FormUnitPrice(cForm)
			ThisFormset.frmReceiving.lblPriceUnit.Caption = cPriceUnit 
			
			nStockLst_Qty = PrepareSQLnum(tmpPOp.StockLst_Qty,'StockLst_QTY',-5)
			IF nStockLst_Qty > 0
				IF ThisFormset.frmReceiving.txtBillW.Value > 0
					IF ThisFormset.frmReceiving.txtBillW.Value != nStockLst_Qty
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormset.frmReceiving.txtBillW.Value))+"'"+CHR(13)+" with '"+Alltrim(STR(nStockLst_Qty))+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
							ThisFormset.frmReceiving.txtBillW.Value = nStockLst_Qty
						ELSE 
							nStockLst_Qty = PrepareSQLnum(ThisFormset.frmReceiving.txtBillW.Value,'StockLst_QTY',-5)
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtBillW.Value = nStockLst_Qty
				ENDIF
			ENDIF
			*
			nPounds = PrepareSQLnum(tmpPOp.Pounds,'Pounds',9,1)
			IF nPounds > 0
				IF cPriceUnit = "LB"
					IF ThisFormset.frmReceiving.txtBillW.Value > 0
						IF ThisFormset.frmReceiving.txtBillW.Value != nPounds
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormset.frmReceiving.txtBillW.Value))+"'"+CHR(13)+" with '"+Alltrim(STR(nPounds))+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
								ThisFormset.frmReceiving.txtBillW.Value = nPounds
							ENDIF
						ENDIF
					ELSE
						ThisFormset.frmReceiving.txtBillW.Value = nPounds
					ENDIF
				ENDIF
			ENDIF
			*	
		
		*!*		nOrder_Qty = tmpPOp.Order_Qty
		*!*		IF nOrder_Qty > 0
		*!*			IF ThisFormset.frmReceiving.txtBillW.Value > 0
		*!*				IF ThisFormset.frmReceiving.txtBillW.Value != nOrder_Qty
		*!*					IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormset.frmReceiving.txtBillW.Value))+"'"+CHR(13)+" with '"+Alltrim(STR(nOrder_Qty))+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
		*!*						ThisFormset.frmReceiving.txtBillW.Value = nOrder_Qty
		*!*					ENDIF
		*!*				ENDIF
		*!*			ELSE
		*!*				ThisFormset.frmReceiving.txtBillW.Value = nOrder_Qty
		*!*			ENDIF
		*!*		ENDIF
			*
			cMisc_purch = PrepareSQLtxt(tmpPOp.misc_purch,'Misc_Purch',-1)
			IF !EMPTY(cMisc_purch)
				IF !EMPTY(ThisFormset.frmReceiving.edtSpecs.Value)
					IF ThisFormset.frmReceiving.edtSpecs.Value != cMisc_purch
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Spec '"+ALLTRIM(ThisFormset.frmReceiving.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cMisc_purch)+"?",4+32,"Purchase Order Table has Spec listed differently.") = 6
							ThisFormset.frmReceiving.edtSpecs.Value = cMisc_purch
						ELSE
							IF EMPTY(ThisFormset.frmReceiving.edtComments.Value)
								IF MESSAGEBOX("Do you want to save this line "+CHR(13)+Alltrim(cMisc_purch)+CHR(13)+" to the Comment field? ",4+32,"Save info") = 6
									ThisFormset.frmReceiving.edtComments.Value = cMisc_purch
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.edtSpecs.Value = cMisc_purch
				ENDIF
			ENDIF
			*
			cDescription = ''
			IF !EMPTY(cAlloy) AND !EMPTY(cForm) AND nThck > 0
				cDescription = ItemDescriptionMetric(cForm, nThck, nSZ2, nSZ3, nPounds, lRandLen, .F.,'','','' ) 
			*	ItemDescriptionMetric(Quotes.Form, Quotes.Thck, Quotes.SZ2, Quotes.SZ3, Quotes.Weight, Quotes.RandLen, Quotes.Metric, Quotes.Sz1orig, Quotes.Sz2orig, Quotes.Sz3orig) 
			ENDIF
			IF !EMPTY(cDescription)
				IF !EMPTY(ThisFormset.frmReceiving.edtDescription.Value)
					IF ThisFormset.frmReceiving.edtDescription.Value != cDescription
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Description '"+ALLTRIM(ThisFormset.frmReceiving.edtDescription.Value)+"'"+CHR(13)+" with '"+Alltrim(cDescription)+"?",4+32,"Purchase Order Table has Description listed differently.") = 6
							ThisFormset.frmReceiving.edtDescription.Value = cDescription
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.edtDescription.Value = cDescription
				ENDIF
			ENDIF
			
		***********************************
		*** FROM RecStockGetByPOitem
		*** GetFromReceiving
		*************************************************
		
			IF USED("cntReceiving2")
				USE IN cntReceiving2
			ENDIF
		
			cSQL = "SELECT ID, Heat FROM dbo.Receiving "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			SELECT 0  
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntReceiving2')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'cntReceiving2')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntReceiving2')
				RETURN
			ENDIF
			IF USED('cntReceiving2')
				IF RECCOUNT('cntReceiving2') > 0
		
					*CHOOSE Receiving POitem Details
					PRIVATE nReceivingID
					nReceivingID = 0
					
					IF VARTYPE(cntReceiving2.Heat)="C"
						cHeat = ShowSQLtxt(cntReceiving2.Heat,'HEAT',50)
					ENDIF
					
					DO FORM Forms\ChooseReceivingDetails WITH pHPAPoItem,cHeat TO nReceivingID
					
					IF TYPE("nReceivingID")="N"
						IF nReceivingID > 0
							*ThisForm.ReceivingID = nReceivingID
							
							ThisFormset.frmReceiving.txtReceivingID.Value = nReceivingID
							ThisFormset.frmReceiving.txtReceivingID.refresh
							
							IF USED("tmpReceivingPOi")
								USE IN tmpReceivingPOi
							ENDIF
		
							cSQL = "SELECT * "
							cSQL = cSQL + " FROM dbo.Receiving "
							cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
							
							
							SELECT 0  
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceivingPOi')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpReceivingPOi')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpReceivingPOi')
								RETURN
							ENDIF
							IF USED('tmpReceivingPOi')
								ThisFormset.frmReceiving.txtHeat.Value		= ShowSQLtxt(tmpReceivingPOi.Heat,'Heat',50,.F.,.T.)
								ThisFormset.frmReceiving.chkCert.Value		= PrepareSQLchk(tmpReceivingPOi.Cert,'Cert')
								ThisFormset.frmReceiving.txtPieces.Value	= PrepareSQLnum(tmpReceivingPOi.Pieces,'Pieces',10,0)
								ThisFormset.frmReceiving.edtDescription.Value = ShowSQLtxt(tmpReceivingPOi.Description,'Descript',20,.F.,.T.)
								ThisFormset.frmReceiving.edtSpecs.Value		= ShowSQLtxt(tmpReceivingPOi.Specs,'Specs',160)
								ThisFormset.frmReceiving.edtComments.Value	= ShowSQLtxt(tmpReceivingPOi.Comments,'Receipt',-1)
								ThisFormset.frmReceiving.txtInit.Value		= ShowSQLtxt(tmpReceivingPOi.Init,'INIT',10)
								ThisFormset.frmReceiving.txtDate.Value		= ShowSQLdate(tmpReceivingPOi.Date,'Date')
								ThisFormset.frmReceiving.chkPass.Value		= PrepareSQLchk(tmpReceivingPOi.Pass,'Pass')
								ThisFormset.frmReceiving.chkGoodPapers.Value	= PrepareSQLchk(tmpReceivingPOi.GoodPapers,'GoodPapers')
								
								ThisFormset.frmReceiving.txtActualW.Value	= PrepareSQLnum(tmpReceivingPOi.ActualW,'Weight',9,1)
								ThisFormset.frmReceiving.txtBillW.Value		= PrepareSQLnum(tmpReceivingPOi.BillW,'Weight',9,1)
								
								ThisFormset.frmReceiving.txtVendor.Value	= ShowSQLtxt(tmpReceivingPOi.Vendor,'Vendor',30)
								ThisFormset.frmReceiving.txtRMA_No.Value	= PrepareSQLnum(tmpReceivingPOi.RMA_No,'RMA_No',-3)
								ThisFormset.frmReceiving.txtRejectPC.Value	= PrepareSQLnum(tmpReceivingPOi.RejectPC,'RejectPC',-3)
								ThisFormset.frmReceiving.txtRejectReason.Value	= ShowSQLtxt(tmpReceivingPOi.RejectReason,'RejectReason',255)
								
								ThisFormset.frmReceiving.txtAlloy.SetFocus()
								
								USE IN tmpReceivingPOi
								
							ENDIF
		
						ENDIF
		
					ENDIF
				ENDIF	
			USE IN cntReceiving2
			ENDIF	
		ENDIF
		
		
		
	ENDPROC

