	PROCEDURE getby_receivingid
		PARAMETERS pID
		*ThisFormSet.GetBy_ReceivingID()
		
		PRIVATE nReceivingID
		nReceivingID = 0
		
		IF TYPE("pID") = "U"
			nReceivingID = 0
		ENDIF
		IF TYPE("pID") = "C"
			nReceivingID = VAL(pID)
		ELSE
			nReceivingID = pID
		ENDIF
		IF VARTYPE(nReceivingID) != "N"
			TrackError("bad variable","nReceivingID is not a NUMBER","Receiving:SaveAdd",LINENO())
			nReceivingID = 0
		ENDIF
		
		IF nReceivingID < 1
			MESSAGEBOX("No pReceivingID for GetBy_ReceivingID( pReceivingID )",0,"Parameter Error")
			\Progs\ErrorHandlerlog(0,"No pReceivingID for GetBy_ReceivingID( pReceivingID )","Parameter Error","frmShop_StockLst_Edit.GetBy_ReceivingID",7)
			RETURN
		ENDIF
		
		
		IF USED('tmpReceivingPOitem')
			USE IN tmpReceivingPOitem
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "SELECT * FROM dbo.Receiving "
		cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceivingPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceivingPOitem')
		ENDDO
		IF nSQLEXEC < 1
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpReceivingPOitem')
			RETURN
		ENDIF
		
		
		IF USED('tmpReceivingPOitem')
			GO TOP
			
			ThisFormSet.frmReceiving.txtWO.Value		= PrepareSQLnum(tmpReceivingPOitem.WO,'WO',-3)
			ThisFormSet.frmReceiving.txtWO_Detail.Value	= PrepareSQLnum(tmpReceivingPOitem.WO_Detail,'WO_Detail',-3)
			
			ThisFormSet.frmReceiving.txtReceived.Value = PrepareSQLDate(tmpReceivingPOitem.Received,'Received')
			
			ThisFormSet.frmReceiving.txtHpaPONum.Value 	= LEFT(tmpReceivingPOitem.POitem,AT("-",tmpReceivingPOitem.POitem)-1)
			ThisFormSet.frmReceiving.txtHpaPOItem.Value = ALLTRIM(STR(VAL(RIGHT(tmpReceivingPOitem.POitem,LEN(tmpReceivingPOitem.POitem )-AT("-",tmpReceivingPOitem.POitem)))))
			ThisFormSet.frmReceiving.txtSOnum.Value		= LEFT(tmpReceivingPOitem.SOitem,AT("-",tmpReceivingPOitem.SOitem)-1)
			ThisFormSet.frmReceiving.txtSOitem.Value	= ALLTRIM(STR(VAL(RIGHT(tmpReceivingPOitem.SOitem,LEN(tmpReceivingPOitem.SOitem)-AT("-",tmpReceivingPOitem.SOitem)))))
						
			ThisFormSet.frmReceiving.txtAlloy.Value	= tmpReceivingPOitem.Alloy
			ThisFormSet.frmReceiving.txtHeat.Value	= tmpReceivingPOitem.Heat
			ThisFormSet.frmReceiving.chkCert.Value	= IIF(tmpReceivingPOitem.Cert,1,0)
			ThisFormSet.frmReceiving.txtPieces.Value	= tmpReceivingPOitem.Pieces
			ThisFormSet.frmReceiving.edtDescription.Value = tmpReceivingPOitem.Description
			ThisFormSet.frmReceiving.edtSpecs.Value		= tmpReceivingPOitem.Specs
			ThisFormSet.frmReceiving.edtComments.Value 	= tmpReceivingPOitem.Comments
			ThisFormSet.frmReceiving.txtInit.Value		= tmpReceivingPOitem.Init
			ThisFormSet.frmReceiving.txtDate.Value		= DTOC(tmpReceivingPOitem.Date)
			ThisFormSet.frmReceiving.chkPass.Value		= IIF(tmpReceivingPOitem.Pass,1,0)
			ThisFormSet.frmReceiving.chkGoodPapers.Value = IIF(tmpReceivingPOitem.GoodPapers,1,0)
			ThisFormSet.frmReceiving.txtActualW.Value	= tmpReceivingPOitem.ActualW
			ThisFormSet.frmReceiving.txtBillW.Value		= tmpReceivingPOitem.BillW
			ThisFormSet.frmReceiving.txtVendor.Value	= tmpReceivingPOitem.Vendor
			ThisFormSet.frmReceiving.txtReceivingID.Value		= tmpReceivingPOitem.ID
			ThisFormSet.frmReceiving.txtRejectPC.Value	= tmpReceivingPOitem.RejectPC
			ThisFormSet.frmReceiving.txtRejectReason.Value= tmpReceivingPOitem.RejectReason
			ThisFormSet.frmReceiving.txtRMA_No.Value		= tmpReceivingPOitem.RMA_No
			
			ThisFormset.frmReceiving.txtID.Value		= PrepareSQLnum(tmpReceivingPOitem.ID,'ID',-3)
			ThisFormset.frmReceiving.txtID_Detail.Value	= PrepareSQLnum(tmpReceivingPOitem.ID_Detail,'ID_Detail',-3)
			ThisFormset.frmReceiving.txtTBL.Value		= PrepareSQLtxt(tmpReceivingPOitem.StockTable,'TBL',1)
		
		
			ThisForm.nRMA = PrepareSQLnum(tmpReceivingPOitem.RMA_No,'RMA',-3)
			
			IF USED('tmpReceivingPOitem')
				USE IN tmpReceivingPOitem
			ENDIF
			
			ThisFormSet.frmReceiving.Edit1.Value = "Retrieved ID "+ALLTRIM(STR(nReceivingID))+" for Edit."+CHR(13)+ThisForm.pf.pg_Add.Edit1.Value
			ThisFormSet.frmReceiving.Refresh
			
		ENDIF
	ENDPROC

	PROCEDURE getfromreceiving		&& Used in Receving - POitem Valid
		PARAMETER pHPAPoItem, pcHeat
		*ThisFormset.GetFromReceiving(cPOitem,cHeat)
		*returns .F. if did not get a receiving record.
		
		IF TYPE("pHPAPoItem") != "C"
			RETURN
			*pHPAPo = ''
		ENDIF
		
		PRIVATE cAndHeat, nID
		IF TYPE("pcHeat") != "C"
			cAndHeat = ""
		ELSE
			IF NOT EMPTY(pcHeat)
			 	cAndHeat = " AND HEAT = '"+ALLTRIM(pcHeat)+"' "
			 ELSE
			 	cAndHeat = ""
			 ENDIF
		ENDIF
		nID = PrepareSQLnum(ThisFormset.frmReceiving.txtReceivingID.Value,'ID',-3,0)
		
		***********************************
		*** FROM RecStockGetByPOitem
		*** GetPOitemDetail
		***********************************
		IF USED('tmpReceivingPOitem')
			USE IN tmpReceivingPOitem
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		*cSQL = "SELECT Heat,Cert,Pieces,Description,Specs,Comments,Init,Date,ActualW,BillW,Vendor,pass,ID FROM dbo.Receiving "
		cSQL = "SELECT * FROM dbo.Receiving "
		cSQL = cSQL + " WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+pHPAPoItem+"')"
		cSQL = cSQL + cAndHeat
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceivingPOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceivingPOitem')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpReceivingPOitem')
			RETURN .F.
		ENDIF
		PRIVATE cDescription, lFoundOnetoEdit, nCurRec, nRecords, nRID 
		cDescription = ''
		lFoundOnetoEdit = .F.
		nCurRec = 0
		nRecords = 0
		
		IF USED('tmpReceivingPOitem')
			GO TOP
			IF VARTYPE(tmpReceivingPOitem.Description) = "C"
				cDescription = ALLTRIM(LEFT(tmpReceivingPOitem.Description, 40))
			ENDIF
			
			IF TYPE("tmpReceivingPOitem.Heat")="C" &&Heat
				IF !EMPTY(tmpReceivingPOitem.Heat)
					IF !EMPTY(pcHeat)
						IF nID > 0
							PRIVATE nMess
							nMess = MESSAGEBOX("There is allready a receiving record with this"+CHR(13)+"Heat= '"+ALLTRIM(pcHeat)+"'"+CHR(13)+cDescription+CHR(13)+CHR(13)+"Do you want to load this data?",4,"Overwrite current Data?") 
							IF nMess = 7
								*NO, do not overwrite
								ThisFormSet.ReceivingResetaddvars()
								
								RETURN .F.
							ENDIF
						ELSE
							*ID is 0, NEW
						ENDIF
					ELSE
						PRIVATE cEditNextRecord 
						cEditNextRecord = CHR(13)+"edit the next RECORD or"
						
						SELECT tmpReceivingPOitem
						nRecords = RECCOUNT()
						SCAN
						nCurRec = RECNO()
						cDescription = ALLTRIM(STR(tmpReceivingPOitem.Pieces))+"Pc "
						cDescription = cDescription + ALLTRIM(LEFT(tmpReceivingPOitem.Description, 40))
						cDescription = cDescription + " Heat:"+tmpReceivingPOitem.Heat
						
						nRID = tmpReceivingPOitem.ID
						IF nRecords > nCurRec
							cEditNextRecord = CHR(13)+"edit the next RECORD or"
						ELSE
							cEditNextRecord = ""
						ENDIF
						IF MESSAGEBOX("There is allready a receiving record. Record "+ALLTRIM(STR(nCurRec))+"/"+ALLTRIM(STR(nRecords))+"."+CHR(13)+cDescription+CHR(13)+CHR(13)+"Do you want to edit this data?"+CHR(13)+CHR(13)+"Answer No and you will get a chance to"+cEditNextRecord+CHR(13)+"create a new Receiving record.",4,"Edit old Data?") = 6
							*Edit this one
							lFoundOnetoEdit = .T.
							EXIT
						ELSE
							IF nRecords = nCurRec
								IF MESSAGEBOX("Are you sure you want to create"+CHR(13)+"another receiving record"+CHR(13)+"for this same PO item?"+CHR(13)+" ",4,"Create new receiving record?") = 6
									ThisFormset.frmReceiving.txtReceivingID.Value = 0
									RETURN .F.
								ENDIF
							ENDIF
						ENDIF
						ENDSCAN
						
						IF lFoundOnetoEdit 
							IF MESSAGEBOX("Found a Receiving Record for this PO item"+CHR(13)+"Do you want to Edit this old receive?"+CHR(13)+"Answer No to be able to ADD another receive to this Po item.",4+32,"Edit old Receive?")=6
								ThisFormSet.GetBy_ReceivingID(nRID)
								RETURN .T.
							ELSE
								ThisFormset.frmReceiving.txtReceivingID.Value = 0			
							ENDIF
						ELSE
							ThisFormset.frmReceiving.txtReceivingID.Value = 0
							ThisFormSet.ReceivingResetAddVars()
							RETURN .F.
						ENDIF
		
					ENDIF
				ENDIF
			ENDIF
		
			
			ThisFormset.frmReceiving.txtHeat.Value = PrepareSQLtxt(tmpReceivingPOitem.Heat,'Heat',30)
			ThisFormset.frmReceiving.chkCert.Value = PrepareSQLchk(tmpReceivingPOitem.Cert,'Cert')
			ThisFormset.frmReceiving.txtPieces.Value = PrepareSQLnum(tmpReceivingPOitem.Pieces,'Pieces',-3)
			ThisFormset.frmReceiving.edtDescription.Value = PrepareSQLtxt(tmpReceivingPOitem.Description,'Description',-1)
			ThisFormset.frmReceiving.edtSpecs.Value = PrepareSQLtxt(tmpReceivingPOitem.Specs,'Specs',-1)
			ThisFormset.frmReceiving.edtComments.Value = PrepareSQLtxt(tmpReceivingPOitem.Comments,'Comments',-1)
			ThisFormset.frmReceiving.txtInit.Value = PrepareSQLtxt(tmpReceivingPOitem.Init,'Init',10)
			ThisFormset.frmReceiving.txtDate.Value = DTOC(PrepareSQLdate(tmpReceivingPOitem.Date,'Date'))
			ThisFormset.frmReceiving.chkPass.Value = PrepareSQLchk(tmpReceivingPOitem.Pass,'Pass')
			ThisFormset.frmReceiving.chkGoodPapers.Value = PrepareSQLchk(tmpReceivingPOitem.GoodPapers,'GoodPapers')
		
			PRIVATE nActualW
			nActualW = PrepareSQLnum(ThisFormset.frmReceiving.txtActualW.Value,'ActualW',9,1)
			IF PrepareSQLnum(tmpReceivingPOitem.ActualW,'ActualW',9,1) > 0 AND nActualW < 2
				ThisFormset.frmReceiving.txtActualW.Value = PrepareSQLnum(tmpReceivingPOitem.ActualW,'ActualW',9,1)
			ENDIF
			PRIVATE nBillW
			nBillW = PrepareSQLnum(ThisFormset.frmReceiving.txtBillW.Value,'BillW',9,1)
			IF PrepareSQLnum(tmpReceivingPOitem.BillW,'BillW',9,1) > 0 AND nBillW < 2
				ThisFormset.frmReceiving.txtBillW.Value = PrepareSQLnum(tmpReceivingPOitem.BillW,'BillW',9,1)
			ENDIF
		
			ThisFormset.frmReceiving.txtVendor.Value = PrepareSQLtxt(tmpReceivingPOitem.Vendor,'Vendor',30,.F.,.T.)
			
			ThisFormset.frmReceiving.txtReceivingID.Value = PrepareSQLnum(tmpReceivingPOitem.ID,'ID',-3)
			
			ThisFormSet.frmReceiving.txtID_.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Master,'ID_Master',-3)
			ThisFormSet.frmReceiving.txtTBL.Value = PrepareSQLtxt(tmpReceivingPOitem.StockTable,'StockTable',1)
			ThisFormSet.frmReceiving.txtID_Detail.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Detail,'ID_Detail',-3)
			ThisFormSet.frmReceiving.txtID_Detail_Process.Value = PrepareSQLnum(tmpReceivingPOitem.ID_Detail_Process,'ID_Detail_Process',-3)
				
			IF USED('tmpReceivingPOitem')
				USE IN tmpReceivingPOitem
			ENDIF
			
			*ThisFormset.frmReceiving.Edit1.Value = ThisFormset.frmReceiving.Edit1.Value+CHR(13)+"Retrieved PO item "+pHPAPoItem+" for edit."
			ThisFormset.frmReceiving.Refresh	
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE getpoform_poitem
		*!*	*ThisFormSet.getPOForm_POitem()
		
		*!*	*********** Get from PurchaseOrder
		*!*	*ThisForm.ReceivingID
		*!*	PRIVATE lCheckPO
		*!*	lCheckPO = .T.
		
		*!*	IF USED('tmpPO1')
		*!*		USE IN tmpPO1
		*!*	ENDIF
		*!*	SELECT 0
		
		*!*	cSQL = "SELECT Form, CC, Cond_Spec, StandSize, Pieces "
		*!*	cSQL = cSQL + " ,Thck, Sz2, Sz3, RandLen, Cert "
		*!*	cSQL = cSQL + " ,StockLst_P, Order_Qty, Pounds, StockLst_QTY "
		*!*	cSQL = cSQL + " ,dbo.f_BestDate( dbo.f_BestDate(Due_Min,Due_Max), dbo.f_BestDate(HPA_Due_Min,HPA_Due_Max) ) AS PODueDate"
		*!*	cSQL = cSQL + " FROM dbo.PurchaseOrder "
		*!*	cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+ThisFormSet.POitem+"')"
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPO1')
		
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPO1' )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPO1' )
		*!*	ENDIF
		
		*!*	IF USED('tmpPO1')
		*!*		IF RECCOUNT('tmpPO1') > 0
		*!*			
		*!*			ThisFormset.frmRecvStock.cmbForm.Value	= tmpPO1.Form
		*!*	*		ThisFormset.frmRecvStock.FormCaptions()
		*!*			ThisFormSet.PORecvFormCaption()
		*!*			ThisFormset.frmRecvStock.cmbCC.Value	= tmpPO1.CC
		*!*			ThisFormset.frmRecvStock.Cond1.Value	= RIGHT(ALLTRIM(tmpPO1.Cond_Spec),20)
		*!*			ThisFormset.frmRecvStock.Size1.Value	= tmpPO1.StandSize
		*!*			ThisFormset.frmRecvStock.PC1.Value		= tmpPO1.Pieces
		*!*			ThisFormset.frmRecvStock.DIM11.Value	= tmpPO1.Thck
		*!*			ThisFormset.frmRecvStock.DIM21.Value	= tmpPO1.Sz2
		*!*			ThisFormset.frmRecvStock.DIM31.Value	= tmpPO1.Sz3
		*!*			ThisFormset.frmRecvStock.chkRandLen.Value	= IIF(tmpPO1.RandLen,1,0)
		*!*			ThisFormset.frmRecvStock.chkCert.Value	= IIF(tmpPO1.Cert,1,0)
		*!*			
		*!*			ThisFormset.frmRecvStock.CostValue1.Value 	= PrepareSQLnum(tmpPO1.StockLst_P,'StockLst_P',-5)
		*!*			ThisFormset.frmRecvStock.S_P.Value			= PrepareSQLnum(tmpPO1.StockLst_P,'StockLst_P',-5)
		*!*				
		*!*			ThisForm.Pounds1.Value 	= tmpPO1.Pounds
		*!*			ThisForm.S_QTY.Value 	= tmpPO1.StockLst_QTY	
		*!*			
		*!*			ThisFormset.frmRecvStock.PODueDate1.Value = tmpPO1.PODueDate
		*!*			IF GetPUfromForm(tmpPO1.Form, ThisFormSet.nConnHandle) = 1
		*!*				ThisFormset.frmRecvStock.Weight1.Value	= PrepareSQLnum(tmpPO1.StockLst_QTY,'StockLst_QTY',-5)
		*!*			ELSE
		*!*				*Object is like Fitting, Fastener or sold per foot like Pipe or Tubing.
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		USE IN tmpPO1
		*!*	ELSE
		*!*		MESSAGEBOX("PO data was not found!"+CHR(13)+"Please check data before saving"+CHR(13)+"Usually more data has been automatically filled in.",0,"Missing Data.")
		*!*	ENDIF
		*!*		
		
	ENDPROC

	PROCEDURE getpoitemdetail		&& Used by Receiving
		PARAMETER pHPAPoItem
		*ThisFormSet.GetPOitemDetail()
		
		IF TYPE("pHPAPoItem") != "C"
			TrackError("Need PO Item","Need SO Item","Receiving.getPoItemDetail()",LINENO() )
			MESSAGEBOX("Need Po Item",0,"getPoItemDetail()" )
			RETURN
		ENDIF
		IF EMPTY(pHPAPoItem)
			TrackError("Need PO Item","Need SO Item","Receiving.getPoItemDetail()",LINENO() )
			MESSAGEBOX("Need Po Item",0,"getPoItemDetail()" )
			RETURN
		ENDIF
		
		**check HpaPO
		PRIVATE nItemPO, nHpaPo, cPOitem
		cPOitem = Proper_PO_Item( pHPAPoItem )
		nItemPO = Proper_PO_Item_Item(cPOitem)
		nHpaPo	= Proper_PO_Item_PO(cPOitem)
		
		IF nHpaPo = 0
			MESSAGEBOX("No PO to show!",0,"No PO")
			RETURN
		ENDIF
		
		PRIVATE nPOcnt 
		nPOcnt = 0
		
		IF nItemPo = 0
			*Guess at Item
			nPOcnt = Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle )
			IF nPOcnt = 0
				MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
				RETURN
			ENDIF
			IF Count_HPAPOinPurchaseOrder( nHpaPo, ThisFormSet.nConnHandle, "FORSTOCK" ) = 0
				*Not for Stock!!!
			ENDIF
			IF nPOcnt = 1
				*Must be only one
				nItemPo = GetMaxItemforPO( nHpaPo, ThisFormSet.nConnHandle )
		*		SELECT PoItem FROM PurchaseOrder WHERE HpaPo = nHpaPo INTO ARRAY aPoItem
				*ThisForm.pf.pg_Add.txtHpaPOItem.Value = nItemPo
				ThisFormset.frmReceiving.txtHPAPOitem.Value = nItemPO
			ENDIF
			IF nPOcnt > 1
				*Show list of Item to Choose
				PRIVATE cPoItem
				DO FORM Forms\ChoosePOitem WITH nHpaPo TO cPoItem
				IF TYPE("cPoItem") = "C"
					IF NOT EMPTY("cPoItem")
						pHPAPoItem = cPoItem
						SET DECIMAL TO 0
		*				nHpaPo = VAL( LEFT(pHPAPoItem,9) )
						nItemPo = VAL( RIGHT(pHPAPoItem,2) )
						SET DECIMAL TO nDec
						IF EMPTY( ThisFormset.frmReceiving.txtHpaPOItem.Value )
							ThisFormset.frmReceiving.txtHpaPOItem.Value = nItemPo
						ENDIF
					ELSE
						MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
						RETURN	
					ENDIF		
				ELSE
					MESSAGEBOX("Nothing to return for that PO",0,"No PO items")
					RETURN	
				ENDIF
			ENDIF
		ENDIF
		
		***Look at PurchaseOrder to back fill ThisFormset.frmReceiving-Not PO RecvStock
		PRIVATE cSOitem, cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, lRandLen, cDispAlloy, nStandSize, cMisc_purch
		PRIVATE nSalesNum, nItemSo, cDescription, nWeight
		
		cSQL = "SELECT SOitem, Company, Alloy, Form, Order_Qty, Pieces, Thck, Sz2, Sz3, Cond_Spec, Heat, RandLen, DispAlloy, StandSize, misc_purch "
		cSQL = cSQl + ",StockLst_QTY,StockLst_P,Pounds,Order_PU "
		cSQL = cSQl + " FROM dbo.PurchaseOrder WHERE PoItem = dbo.f_ProperPOitem('"+pHPAPoItem+"')"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOp')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOp' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOp' )
		ENDIF
		
		IF USED('tmpPOp')
			PRIVATE cSOitem, cCompany, cAlloy, cForm, nPieces, nThck, nSz2,	nSz3, cCond_Spec 
			PRIVATE cHeat, lRandLen, nStandSize
			
			cSOitem = Proper_SO_Item(tmpPOp.SOitem)
		
			PRIVATE nDec
			nDec = SET("DECIMAL")
			SET DECIMAL TO 0
			IF NOT ( EMPTY(cSOitem) OR Proper_SO_Item(cSOitem) = Proper_SO_item("") )
				nSalesNum = VAL( LEFT(cSOitem,7) )
				ThisFormset.frmReceiving.txtSOnum.Value = nSalesNum
				nItemSo = VAL( RIGHT(cSOitem,2) )
				ThisFormset.frmReceiving.txtSOItem.Value = nItemSo	
			ENDIF
			SET DECIMAL TO nDec
			*
			cCompany = PrepareSQLtxt(tmpPOp.Company,'Company',30)
			IF !EMPTY(cCompany)
				IF !EMPTY(ThisFormset.frmReceiving.txtVendor.Value)
					IF ThisFormset.frmReceiving.txtVendor.Value != cCompany
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Vendor '"+ALLTRIM(ThisFormset.frmReceiving.txtVendor.Value)+"' with '"+Alltrim(cCompany)+"?",4+32,"Purchase Order Table has Vendor listed differently.") = 6
							ThisFormset.frmReceiving.txtVendor.Value = cCompany
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtVendor.Value = ShowSQLtxt(cCompany,'Company',30)
				ENDIF
			ENDIF
			*
			cAlloy = PrepareSQLtxt(tmpPOp.Alloy,'Alloy',12)
			IF !EMPTY(cAlloy)
				IF !EMPTY(ThisFormset.frmReceiving.txtAlloy.Value)
					IF ThisFormset.frmReceiving.txtAlloy.Value != cAlloy
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Alloy '"+ALLTRIM(ThisFormset.frmReceiving.txtAlloy.Value)+"' with '"+Alltrim(cAlloy)+"?",4+32,"Purchase Order Table has Alloy listed differently.") = 6
							ThisFormset.frmReceiving.txtAlloy.Value = cAlloy
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtAlloy.Value = cAlloy
				ENDIF
			ENDIF
			*
			cForm = PrepareSQLtxt(tmpPOp.Form,'form',2)
			nPieces = PrepareSQLnum(tmpPOp.Pieces,'Pieces',11,3)
			IF nPieces > 0
				IF !EMPTY(ThisFormset.frmReceiving.txtPieces.Value)
					IF ThisFormset.frmReceiving.txtPieces.Value != nPieces 
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Pieces '"+ALLTRIM(STR(ThisFormset.frmReceiving.txtPieces.Value))+"' with '"+Alltrim(STR(nPieces))+"?",4+32,"Purchase Order Table has Alloy listed differently.") = 6
							ThisFormset.frmReceiving.txtPieces.Value = nPieces
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtPieces.Value = nPieces
				ENDIF
			ENDIF
			*
			nThck = PrepareSQLnum(tmpPOp.Thck,'Thck',10,4)
			nSz2 = PrepareSQLnum(tmpPOp.Sz2,'Sz2',10,3)
			nSz3 = PrepareSQLnum(tmpPOp.Sz3,'Sz3',10,3)
			cCond_Spec = PrepareSQLtxt(tmpPOp.Cond_Spec,'Cond_Spec',-1)
			IF !EMPTY(cCond_Spec)
				IF !EMPTY(ThisFormset.frmReceiving.edtSpecs.Value)
					IF ThisFormset.frmReceiving.edtSpecs.Value != cCond_Spec
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Specs '"+ALLTRIM(ThisFormset.frmReceiving.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cCond_Spec)+"?",4+32,"Purchase Order Table has Specs listed differently.") = 6
							ThisFormset.frmReceiving.edtSpecs.Value = cCond_Spec
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.edtSpecs.Value = cCond_Spec
				ENDIF
			ENDIF
			*
			cHeat = PrepareSQLtxt(tmpPOp.Heat,'Heat',40)
			IF !EMPTY(cHeat)
				IF !EMPTY( ALLTRIM(ThisFormset.frmReceiving.txtHeat.Value ))
					IF ThisFormset.frmReceiving.txtHeat.Value != cHeat
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Heat '"+ALLTRIM(ThisFormset.frmReceiving.txtHeat.Value)+"'"+CHR(13)+" with '"+Alltrim(cHeat)+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
							ThisFormset.frmReceiving.txtHeat.Value = cHeat
						ELSE
							*Keep the Receiving Heat
							PRIVATE cRecvHeat
							cRecvHeat = PrepareSQLtxt(ThisFormset.frmReceiving.txtHeat.Value,'Heat',50)
							IF NOT EMPTY(cRecvHeat)
								cHeat = cRecvHeat
								ThisFormset.frmReceiving.txtHeat.Value = cRecvHeat
							ENDIF
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtHeat.Value = cHeat
				ENDIF
			ENDIF
			*
			lRandLen = PrepareSQLlogic(tmpPOp.RandLen,'RandLen')
			nStandSize = PrepareSQLnum(tmpPOp.StandSize,'StandSize',10,4)
			**
			PRIVATE nOrder_PU
			nOrder_PU = PrepareSQLnum(tmpPOp.Order_PU,'Order_PU',-1)
			IF nOrder_PU = 0
				*Use old way
				nOrder_PU = GetPUfromForm( cForm, ThisFormSet.nConnHandle )
			ENDIF
			
			*FormUnitPrice('10') FormUnitCaption('10')
			PRIVATE cPriceUnit
			cPriceUnit = FormUnitPrice(cForm)
			ThisFormset.frmReceiving.lblPriceUnit.Caption = cPriceUnit 
			
			nStockLst_Qty = PrepareSQLnum(tmpPOp.StockLst_Qty,'StockLst_QTY',-5)
			IF nStockLst_Qty > 0
				IF ThisFormset.frmReceiving.txtBillW.Value > 0
					IF ThisFormset.frmReceiving.txtBillW.Value != nStockLst_Qty
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormset.frmReceiving.txtBillW.Value))+"'"+CHR(13)+" with '"+Alltrim(STR(nStockLst_Qty))+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
							ThisFormset.frmReceiving.txtBillW.Value = nStockLst_Qty
						ELSE 
							nStockLst_Qty = PrepareSQLnum(ThisFormset.frmReceiving.txtBillW.Value,'StockLst_QTY',-5)
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.txtBillW.Value = nStockLst_Qty
				ENDIF
			ENDIF
			*
			nPounds = PrepareSQLnum(tmpPOp.Pounds,'Pounds',9,1)
			IF nPounds > 0
				IF cPriceUnit = "LB"
					IF ThisFormset.frmReceiving.txtBillW.Value > 0
						IF ThisFormset.frmReceiving.txtBillW.Value != nPounds
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormset.frmReceiving.txtBillW.Value))+"'"+CHR(13)+" with '"+Alltrim(STR(nPounds))+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
								ThisFormset.frmReceiving.txtBillW.Value = nPounds
							ENDIF
						ENDIF
					ELSE
						ThisFormset.frmReceiving.txtBillW.Value = nPounds
					ENDIF
				ENDIF
			ENDIF
			*	
		
		*!*		nOrder_Qty = tmpPOp.Order_Qty
		*!*		IF nOrder_Qty > 0
		*!*			IF ThisFormset.frmReceiving.txtBillW.Value > 0
		*!*				IF ThisFormset.frmReceiving.txtBillW.Value != nOrder_Qty
		*!*					IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormset.frmReceiving.txtBillW.Value))+"'"+CHR(13)+" with '"+Alltrim(STR(nOrder_Qty))+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
		*!*						ThisFormset.frmReceiving.txtBillW.Value = nOrder_Qty
		*!*					ENDIF
		*!*				ENDIF
		*!*			ELSE
		*!*				ThisFormset.frmReceiving.txtBillW.Value = nOrder_Qty
		*!*			ENDIF
		*!*		ENDIF
			*
			cMisc_purch = PrepareSQLtxt(tmpPOp.misc_purch,'Misc_Purch',-1)
			IF !EMPTY(cMisc_purch)
				IF !EMPTY(ThisFormset.frmReceiving.edtSpecs.Value)
					IF ThisFormset.frmReceiving.edtSpecs.Value != cMisc_purch
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Spec '"+ALLTRIM(ThisFormset.frmReceiving.edtSpecs.Value)+"'"+CHR(13)+" with '"+Alltrim(cMisc_purch)+"?",4+32,"Purchase Order Table has Spec listed differently.") = 6
							ThisFormset.frmReceiving.edtSpecs.Value = cMisc_purch
						ELSE
							IF EMPTY(ThisFormset.frmReceiving.edtComments.Value)
								IF MESSAGEBOX("Do you want to save this line "+CHR(13)+Alltrim(cMisc_purch)+CHR(13)+" to the Comment field? ",4+32,"Save info") = 6
									ThisFormset.frmReceiving.edtComments.Value = cMisc_purch
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.edtSpecs.Value = cMisc_purch
				ENDIF
			ENDIF
			*
			cDescription = ''
			IF !EMPTY(cAlloy) AND !EMPTY(cForm) AND nThck > 0
				cDescription = ItemDescriptionMetric(cForm, nThck, nSZ2, nSZ3, nPounds, lRandLen, .F.,'','','' ) 
			*	ItemDescriptionMetric(Quotes.Form, Quotes.Thck, Quotes.SZ2, Quotes.SZ3, Quotes.Weight, Quotes.RandLen, Quotes.Metric, Quotes.Sz1orig, Quotes.Sz2orig, Quotes.Sz3orig) 
			ENDIF
			IF !EMPTY(cDescription)
				IF !EMPTY(ThisFormset.frmReceiving.edtDescription.Value)
					IF ThisFormset.frmReceiving.edtDescription.Value != cDescription
						IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Description '"+ALLTRIM(ThisFormset.frmReceiving.edtDescription.Value)+"'"+CHR(13)+" with '"+Alltrim(cDescription)+"?",4+32,"Purchase Order Table has Description listed differently.") = 6
							ThisFormset.frmReceiving.edtDescription.Value = cDescription
						ENDIF
					ENDIF
				ELSE
					ThisFormset.frmReceiving.edtDescription.Value = cDescription
				ENDIF
			ENDIF
			
		***********************************
		*** FROM RecStockGetByPOitem
		*** GetFromReceiving
		*************************************************
		
			IF USED("cntReceiving2")
				USE IN cntReceiving2
			ENDIF
		
			cSQL = "SELECT ID, Heat FROM dbo.Receiving "
			cSQL = cSQL + " WHERE POitem = dbo.f_ProperPOitem('"+cPOitem+"')"
		
			SELECT 0  
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntReceiving2')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'cntReceiving2')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntReceiving2')
				RETURN
			ENDIF
			IF USED('cntReceiving2')
				IF RECCOUNT('cntReceiving2') > 0
		
					*CHOOSE Receiving POitem Details
					PRIVATE nReceivingID
					nReceivingID = 0
					
					IF VARTYPE(cntReceiving2.Heat)="C"
						cHeat = ShowSQLtxt(cntReceiving2.Heat,'HEAT',50)
					ENDIF
					
					DO FORM Forms\ChooseReceivingDetails WITH pHPAPoItem,cHeat TO nReceivingID
					
					IF TYPE("nReceivingID")="N"
						IF nReceivingID > 0
							*ThisForm.ReceivingID = nReceivingID
							
							ThisFormset.frmReceiving.txtReceivingID.Value = nReceivingID
							ThisFormset.frmReceiving.txtReceivingID.refresh
							
							IF USED("tmpReceivingPOi")
								USE IN tmpReceivingPOi
							ENDIF
		
							cSQL = "SELECT * "
							cSQL = cSQL + " FROM dbo.Receiving "
							cSQL = cSQL + " WHERE ID = "+STR(nReceivingID)
							
							
							SELECT 0  
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpReceivingPOi')
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpReceivingPOi')
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpReceivingPOi')
								RETURN
							ENDIF
							IF USED('tmpReceivingPOi')
								ThisFormset.frmReceiving.txtHeat.Value		= ShowSQLtxt(tmpReceivingPOi.Heat,'Heat',50,.F.,.T.)
								ThisFormset.frmReceiving.chkCert.Value		= PrepareSQLchk(tmpReceivingPOi.Cert,'Cert')
								ThisFormset.frmReceiving.txtPieces.Value	= PrepareSQLnum(tmpReceivingPOi.Pieces,'Pieces',10,0)
								ThisFormset.frmReceiving.edtDescription.Value = ShowSQLtxt(tmpReceivingPOi.Description,'Descript',20,.F.,.T.)
								ThisFormset.frmReceiving.edtSpecs.Value		= ShowSQLtxt(tmpReceivingPOi.Specs,'Specs',160)
								ThisFormset.frmReceiving.edtComments.Value	= ShowSQLtxt(tmpReceivingPOi.Comments,'Receipt',-1)
								ThisFormset.frmReceiving.txtInit.Value		= ShowSQLtxt(tmpReceivingPOi.Init,'INIT',10)
								ThisFormset.frmReceiving.txtDate.Value		= ShowSQLdate(tmpReceivingPOi.Date,'Date')
								ThisFormset.frmReceiving.chkPass.Value		= PrepareSQLchk(tmpReceivingPOi.Pass,'Pass')
								ThisFormset.frmReceiving.chkGoodPapers.Value	= PrepareSQLchk(tmpReceivingPOi.GoodPapers,'GoodPapers')
								
								ThisFormset.frmReceiving.txtActualW.Value	= PrepareSQLnum(tmpReceivingPOi.ActualW,'Weight',9,1)
								ThisFormset.frmReceiving.txtBillW.Value		= PrepareSQLnum(tmpReceivingPOi.BillW,'Weight',9,1)
								
								ThisFormset.frmReceiving.txtVendor.Value	= ShowSQLtxt(tmpReceivingPOi.Vendor,'Vendor',30)
								ThisFormset.frmReceiving.txtRMA_No.Value	= PrepareSQLnum(tmpReceivingPOi.RMA_No,'RMA_No',-3)
								ThisFormset.frmReceiving.txtRejectPC.Value	= PrepareSQLnum(tmpReceivingPOi.RejectPC,'RejectPC',-3)
								ThisFormset.frmReceiving.txtRejectReason.Value	= ShowSQLtxt(tmpReceivingPOi.RejectReason,'RejectReason',255)
								
								ThisFormset.frmReceiving.txtAlloy.SetFocus()
								
								USE IN tmpReceivingPOi
								
							ENDIF
		
						ENDIF
		
					ENDIF
				ENDIF	
			USE IN cntReceiving2
			ENDIF	
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE getsalesprocess		&& Edit Sales process' after all process done.
		*ThisFormSet.GetSalesProcess()
		
	ENDPROC

	PROCEDURE getsoitemdetail
		PARAMETERS pSOitem
		*ThisFormSet.GetSoItemDetail(cSOitem)
		
		IF TYPE("pSOitem") != "C"
			TrackError("Need SO Item","Need SO Item","Shop_StockLst_Edit.getSoItemDetail",LINENO() )
			MESSAGEBOX("Need So Item",0,"getSoItemDetail()" )
			RETURN
		ENDIF
		
		IF EMPTY(pcSoItem)
			TrackError("Need SO Item","Need SO Item","Shop_StockLst_Edit.getSoItemDetail",LINENO() )
			MESSAGEBOX("Need So Item",0,"getSoItemDetail()" )
			RETURN
		ENDIF
		
		PRIVATE cSoItem
		cSoItem = pcSoItem
		
		PRIVATE cSQL, nSQLExec
		IF USED("tmpSOitem")
			USE IN tmpSOitem
		ENDIF
		
		PRIVATE cSOitem, cCompany, cAlloy, cForm, nPieces, nThck, nSz2, nSz3, cCond_Spec, cHeat, lRandLen, cDispAlloy , nOrder_Qty, cMisc_purch
		PRIVATE nSalesNum, nItemSo, cDescription, nPounds
		
		cSQL = "SELECT "
		cSQL = cSQL + "AQ.SOitem, AQ.Company, AQ.Alloy, AQ.Pieces, AQ.Weight "
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(AQ.Pieces, AQ.Form, AQ.Thck, AQ.SZ2, AQ.SZ3, AQ.Weight, AQ.RandLen, AQ.Metric, AQ.Sz1orig, AQ.Sz2orig, AQ.Sz3orig) AS DescriptM "
		
		cSQL = cSQL + ",SS.Alloy AS SSAlloy, SS.Pieces AS SSPieces, SS.Weight AS SSWeight"
		cSQL = cSQL + ",dbo.f_DescriptionMetricReport(SS.Pieces, SS.Form, SS.Thck, SS.SZ2, SS.SZ3, SS.Weight, SS.RandLen, SS.Metric, '', '', '') AS SSDescriptM "
		
		cSQL = cSQL + " FROM dbo.AllQuotes AQ "
		cSQL = cSQL + " LEFT OUTER JOIN dbo.StartingStock SS ON SS.AllQuotes_ID = AQ.ID "
		cSQL = cSQL + " WHERE AQ.SOitem = dbo.f_ProperSOitem('"+pcSoItem+"')"
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSOitem')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSOitem' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSOitem' )
		ENDIF
		
		IF USED('tmpSOitem')
			IF RECCOUNT('tmpSOitem') > 0	
				IF TYPE("tmpSOitem.SOitem") = "C"
					cSOitem = tmpSOitem.SOitem
				ELSE
					cSOitem = ''
				ENDIF
		
				PRIVATE nDec
				nDec = SET("DECIMAL")
				SET DECIMAL TO 0
				IF NOT ( EMPTY(cSOitem) OR Proper_SO_Item(cSOitem) = Proper_SO_item("") )
					nSalesNum = VAL( LEFT(cSOitem,7) )
					ThisFormSet.frmReceiving.txtSOnum.Value = nSalesNum
					nItemSo = VAL( RIGHT(cSOitem,2) )
					ThisFormSet.frmReceiving.txtSOitem.Value = nItemSO
				ENDIF
				SET DECIMAL TO nDec
				
				cCompany = ShowSQLtxt(tmpSOitem.Company,'Company',30)
				
				IF !EMPTY(cCompany)
					IF !EMPTY(ThisFormSet.frmReceiving.txtVendor.Value)
						IF ThisFormSet.frmReceiving.txtVendor.Value != cCompany
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Vendor '"+ALLTRIM(ThisFormSet.frmReceiving.txtVendor.Value)+"' with '"+Alltrim(cCompany)+"?",4+32,"Purchase Order Table has Vendor listed differently.") = 6
								ThisFormSet.frmReceiving.txtVendor.Value = cCompany
							ENDIF
						ENDIF
					ELSE
						ThisFormSet.frmReceiving.txtVendor.Value = cCompany
					ENDIF
				ENDIF
				
				PRIVATE lHasSS
				lHasSS = .F.
				IF NOT EMPTY(tmpSOitem.SSDescriptM)
					lHasSS = .T.
				ENDIF
				
				IF lHasSS 
					cAlloy = PrepareSQLtxt(tmpSOitem.SSAlloy,'Alloy',12)
				ELSE
					cAlloy = PrepareSQLtxt(tmpSOitem.Alloy,'Alloy',12)
				ENDIF
		
				IF !EMPTY(cAlloy)
					IF !EMPTY(ThisFormSet.frmReceiving.txtAlloy.Value)
						IF ThisFormSet.frmReceiving.txtAlloy.Value != cAlloy
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Alloy '"+ALLTRIM(ThisFormSet.frmReceiving.txtAlloy.Value)+"' with '"+Alltrim(cAlloy)+"?",4+32,"Purchase Order Table has Alloy listed differently.") = 6
								ThisFormSet.frmReceiving.txtAlloy.Value = cAlloy
							ENDIF
						ENDIF
					ELSE
						ThisFormSet.frmReceiving.txtAlloy.Value = cAlloy
					ENDIF
				ENDIF
				***
				
				IF lHasSS 
					nPieces = PrepareSQLnum(tmpSOitem.SSPieces,'SSPieces',-3)
				ELSE
					nPieces = PrepareSQLnum(tmpSOitem.Pieces,'Pieces',-3)
				ENDIF
				
				IF nPieces > 0
					IF !EMPTY(ThisFormSet.frmReceiving.txtPieces.Value)
						IF ThisFormSet.frmReceiving.txtPieces.Value != nPieces 
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Pieces '"+ALLTRIM(STR(ThisFormSet.frmReceiving.txtPieces.Value))+"' with '"+Alltrim(STR(nPieces))+"?",4+32,"Purchase Order Table has Alloy listed differently.") = 6
								ThisFormSet.frmReceiving.txtPieces.Value = nPieces
							ENDIF
						ENDIF
					ELSE
						ThisFormSet.frmReceiving.txtPieces.Value = nPieces
					ENDIF
				ENDIF
				***
				
				IF lHasSS 
					nOrder_Qty = PrepareSQLnum(tmpSOitem.SSWeight,'SSWeight',9,1)
				ELSE
					nOrder_Qty = PrepareSQLnum(tmpSOitem.Weight,'Weight',9,1)
				ENDIF
				
				IF nOrder_Qty > 0
					IF ThisFormSet.frmReceiving.txtBillW.Value > 0
						IF ThisFormSet.frmReceiving.txtBillW.Value != nOrder_Qty
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormSet.frmReceiving.txtBillW.Value))+"'"+CHR(13)+" with '"+Alltrim(STR(nOrder_Qty))+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
								ThisFormSet.frmReceiving.txtBillW.Value = nOrder_Qty
							ENDIF
						ENDIF
					ELSE
						ThisFormSet.frmReceiving.txtBillW.Value = nOrder_Qty
					ENDIF
				ENDIF
				
				***
				IF lHasSS
					nPounds = PrepareSQLnum(tmpSOitem.SSWeight,'SSWeight',9,1)
				ELSE
					nPounds = PrepareSQLnum(tmpSOitem.Weight,'Weight',9,1)
				ENDIF
				
		
				IF nPounds > 0
					IF ThisFormSet.frmReceiving.txtBillW.Value > 0
						IF ThisFormSet.frmReceiving.txtBillW.Value != nPounds 
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Bill Weight '"+ALLTRIM(STR(ThisFormSet.frmReceiving.txtBillW.Value))+"'"+CHR(13)+" with '"+Alltrim(STR(nPounds ))+"?",4+32,"Purchase Order Table has Heat listed differently.") = 6
								ThisFormSet.frmReceiving.txtBillW.Value = nPounds 
							ENDIF
						ENDIF
					ELSE
						ThisFormSet.frmReceiving.txtBillW.Value = nPounds 
					ENDIF
				ENDIF
				***
				IF lHasSS
					cDescription = PrepareSQLtxt(tmpSOitem.SSDescriptM,'SSDescriptM',-1)
				ELSE
					cDescription = PrepareSQLtxt(tmpSOitem.DescriptM,'DescriptM',-1)
				ENDIF
				
		
				IF !EMPTY(cDescription)
					IF !EMPTY(ThisFormSet.frmReceiving.edtDescription.Value)
						IF ThisFormSet.frmReceiving.edtDescription.Value != cDescription
							IF MESSAGEBOX("Do you want to replace the "+CHR(13)+"Description '"+ALLTRIM(ThisFormSet.frmReceiving.edtDescription.Value)+"'"+CHR(13)+" with '"+Alltrim(cDescription)+"?",4+32,"Purchase Order Table has Description listed differently.") = 6
								ThisFormSet.frmReceiving.edtDescription.Value = cDescription
							ENDIF
						ENDIF
					ELSE
						ThisFormSet.frmReceiving.edtDescription.Value = cDescription
					ENDIF
				ENDIF
				***
				
			ELSE
				MESSAGEBOX("Could not find SO#"+ALLTRIM(cSoItem),0,"Please check you number and try again.")
				
			ENDIF
			
			USE IN tmpSOitem
		ENDIF
		
		
	ENDPROC

