	PROCEDURE frmReceiving.txtAlloy.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryAlloy 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryAlloy  = ''
		
		IF !EMPTY(lcSearchStr)
			lcTryAlloy = SearchAlloyStandard(lcSearchStr, ThisFormSet.nConnHandle )
			IF NOT EMPTY(lcTryAlloy)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryAlloy,1,lnInsertionPt)
					THIS.VALUE=lcTryAlloy
					THIS.FORECOLOR = RGB(0,0,0)
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE frmReceiving.txtAlloy.Valid
		PRIVATE pCurAlloy,cAlloyStandard
		pCurAlloy= ALLTRIM(This.Value)
		
		IF NOT EMPTY(pcuralloy)
			cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisFormSet.nConnHandle )
			
			IF NOT EMPTY(cAlloyStandard)
				This.Value = cAlloyStandard
				THIS.FORECOLOR = RGB(0,0,0)
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmReceiving.txtDate.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE("dDate") = "C"
				dDate = CtoD(ALLTRIM(This.Value))
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
				This.Value = DATE()
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmReceiving.txtHeat.Valid
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat 
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		cHeat = PrepareSQLtxt(This.Value,'Heat',50)
		
		IF NOT EMPTY(cHeat) 
			IF nItemPo < 1 OR nHpaPo < 1
				*Only run here if bad POitem
				IF MESSAGEBOX("Do you want to look for a PO that used this heat number?"+CHR(13)+"(No) if you have no PO!",4+32,"Look up PO?") = 6
					PRIVATE nReceivingID
					nReceivingID	= ThisForm.txtReceivingID.Value
					*nReceivingID	= Receiving.ID
					
					IF nItemPo = 0
						ThisFormSet.ChoosePOitemLoad(nHpaPo)
					ELSE
						IF nHpaPo > 0 AND EMPTY(cHeat) 
							ThisFormSet.GetPoItemDetail(cPOitem)
						ELSE
							ThisFormSet.GetFromReceiving(cPOitem,cHeat)
						ENDIF
					ENDIF
					
					IF USED('Receiving')
						SELECT Receiving
						LOCATE FOR ID = nReceivingID
					ENDIF
						
				ENDIF
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmReceiving.txtHpaPOItem.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID > 0
			RETURN .T.
		ENDIF
		
		
		
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat 
		nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		cHeat 	= PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50)
		
		
		****
		IF nItemPo = 0 AND nHpaPo > 0
			*Choose a HPApo
			ThisFormSet.ChoosePOitemLoad(nHPApo)
			*Refresh
			nHpaPo  = PrepareSQLnum(ThisForm.txtHpaPONum.Value,'HPApo',-3)
			nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
			cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		ENDIF			
		
		IF nItemPo = 0
			ThisFormSet.ChoosePOitemLoad(nHpaPo)
		ELSE
			IF nHpaPo > 0 AND nItemPo > 0
				IF EMPTY(cHeat) 
					ThisFormSet.GetPoItemDetail(cPOitem)
				ELSE
					ThisFormSet.GetFromReceiving(cPOitem,cHeat)
				ENDIF
			ENDIF
		ENDIF	
		
	ENDPROC

	PROCEDURE frmReceiving.txtHpaPONum.Valid
		PRIVATE nReceivingID
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		IF nReceivingID > 0
			RETURN .T.
		ENDIF
		
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat
		nHpaPo  = PrepareSQLnum(This.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(ThisForm.txtHpaPOItem.Value,'ItemPO',2,0)
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',50))
		
		IF nItemPo = 0
			ThisFormSet.ChoosePOitemLoad(nHpaPo)
		ELSE
			IF nHpaPo > 0 AND nItemPo > 0
				IF EMPTY(cHeat) 
					ThisFormSet.GetPoItemDetail(cPOitem)
				ELSE
					ThisFormSet.GetFromReceiving(cPOitem,cHeat)
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE frmReceiving.txtReceived.Valid
		PRIVATE dDate
		dDate = This.Value
		
		IF !EMPTY(This.Value)
			IF TYPE('dDate') = "C"
				dDate = CtoD(ALLTRIM(This.Value))
			ENDIF
				
		
			IF TYPE("dDate") != "D"
				MESSAGEBOX("Must be VALID date",0,"Bad Date")
