	PROCEDURE isprocess_of_so
		*IsProcess_Of_SO()
		
		PRIVATE cSOitem, nWO, lFoundSOiWO
		cSOitem	= PrepareSQLtxt(ThisFormset.frmStockLstProcesses.SOitem1.Value,'SOitem',10)
		nWO		= PrepareSQLnum(ThisformSet.frmStockLstProcesses.WO1.Value,'WO',-3)
		lFoundSOiWO = .F.
		
		PRIVATE nCurrRec
		nCurrec = RECNO('tmpSO')
		*******************
		IF cSOitem = PrepareSQLtxt(tmpSO.SOitem,'SOitem',10) 
			ThisFormset.frmStockLstProcesses.LBLSOITEM1.BackColor = RGB(0,255,0)
			lFoundSOiWO = .T.
		ELSE
			IF RECNO('tmpSO') > 0 AND cSOitem != Proper_SO_Item('')
				SELECT tmpSO
				LOCATE FOR SOitem = cSOitem
		
				IF FOUND()
					ThisFormset.frmStockLstProcesses.LBLSOITEM1.BackColor = RGB(0,255,0)
					 lFoundSOiWO = .T.
				ELSE
					ThisFormset.frmStockLstProcesses.LBLSOITEM1.BackColor = RGB(236,233,216)
					
					IF nCurrec > 0 AND nCurrec <= RECCOUNT('tmpSO')
						GOTO (nCurrec)
					ENDIF
				ENDIF
			ELSE
				ThisFormset.frmStockLstProcesses.LBLSOITEM1.BackColor = RGB(236,233,216)
			ENDIF
		ENDIF
		
		*******************
		IF nWO = PrepareSQLnum(tmpSO.WO,'WO',-3)
			ThisFormset.frmStockLstProcesses.lblWO.BackColor = RGB(0,255,0)
			lFoundSOiWO = .T.
		ELSE
			IF RECNO('tmpSO') > 0 AND cSOitem != Proper_SO_Item('')
				SELECT tmpSO
				LOCATE FOR SOitem = cSOitem
		
				IF FOUND()
					ThisFormset.frmStockLstProcesses.lblWO.BackColor = RGB(0,255,0)
					lFoundSOiWO = .T.
				ELSE
					ThisFormset.frmStockLstProcesses.lblWO.BackColor = RGB(236,233,216)
					IF nCurrec > 0 AND nCurrec <= RECCOUNT('tmpSO')
						GOTO (nCurrec)
					ENDIF
				ENDIF
			ELSE
				ThisFormset.frmStockLstProcesses.lblWO.BackColor = RGB(236,233,216)
			ENDIF
		ENDIF
		
		*******************
		IF lFoundSOiWO = .T.
			ThisFormset.frmStockLstProcesses.cmdProcess.Visible = .T.
			ThisFormset.frmStockLstProcesses.cmdRemoveProcess.Visible = .T.
		ELSE
			ThisFormset.frmStockLstProcesses.cmdProcess.Visible = .F.
			ThisFormset.frmStockLstProcesses.cmdRemoveProcess.Visible = .F.
		ENDIF
		
		************************
		*cmdReceive.Visible
		************************
		*Done in ThisFormSet.RefreshStockLstProcesses()
		*!*	PRIVATE cProcess_ID
		*!*	cProcess_ID = UPPER(ShowSQLtxt(tmpProcess.Process_ID,'Process_ID',10))
		*!*	IF cProcess_ID = "INCOMING" OR Process_ID = 'NOT2HPA' OR cProcess_ID = "PARTRECV"
		*!*		ThisFormset.frmStockLstProcesses.cmdReceive.Visible = .T.
		*!*	ELSE
		*!*		ThisFormset.frmStockLstProcesses.cmdReceive.Visible = .F.
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE Load
		IF NOT "HPA.VCX" $ SET("CLASSLIB")
			SET CLASSLIB TO LIBS\HPA.vcx ADDITIVE
		ENDIF
		
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		IF NOT "PROC_HPA" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		*******************************************
		ThisFormSet.StockLst_ID_Detail = 0
		*ThisFormSet.RefreshStockLst("LOAD","StockLst")
		
		*******************************************
		
		PRIVATE cSQL, nSQLEXEC
		
		
		IF USED('Sales')
			ThisFormSet.CloseSales = .F.
		ELSE
			*Modify_StockLst_Detail_Report will update the Sales Costing
			SELECT 0
			cSQL = "SELECT * FROM dbo.Sales "
			cSQL = cSQL +" WHERE 0>0"
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Sales')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'Sales' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'Sales')
			ENDIF
				
			ThisFormSet.CloseSales = .T.
		ENDIF
		*******************************************
		
		
		SELECT 0
		cSQLq="SELECT *, 0 AS Prc, 0 AS Bkr FROM dbo.AllQuotes WHERE 0>0"
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLq, 'tmpQuotes')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLq, 'tmpQuotes')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQLq, ThisFormSet.nConnHandle,nSQLEXEC,'tmpQuotes')
		ELSE
			SELECT 0
		*	SELECT Company,Alloy,Form,Prc,Bkr,Pieces,Thck,Sz2,Sz3,Weight,Descript,Comments,LeadTime,SaleDate,Q.SOitem,ShipDate,inv,gfm,roll,mach,cg,plasma,cert,heat;
		*	  ,S.ShipDue,S.Shipped,S.Qshipped,S.QBackOrder,S.Cncld,S.Cmplt ;
		*	  ,P_LB,P_PC,P_FT,LotP,Cuts,OtherP,OtherFld,RandLen,Services,Metric,Q.SalesP ;
		*	  ,S.prcp,S.prcd,S.pckd,S.Urgent ;
		*	  FROM tmpQuotes Q, Sales S WHERE Q.SOitem = S.SOitem INTO CURSOR tmpSO ORDER BY Q.SOitem
			  
			cSQL = "SELECT Company,Alloy,Form,CC,0 AS Prc,0 AS Bkr,Pieces,Thck,Sz2,Sz3,Weight"
			cSQL = cSQL +",CONVERT(CHAR(50), Descript) AS Descript"
			cSQL = cSQL +",CONVERT(CHAR(33), Comments) AS Comments"
			cSQL = cSQL +",LeadTime,SaleDate,Q.SOitem,ShipDate,inv,gfm,roll,mach,cg,plasma,cert,heat"
			cSQL = cSQL +",S.ShipDue,S.Shipped,S.Qshipped,S.QBackOrder,S.Cncld,S.Cmplt"
			cSQL = cSQL +",' ' AS POitem"
			cSQL = cSQL +",P_LB,P_PC,P_FT,LotP,Cuts,OtherP,OtherFld,RandLen,Services,Metric,Q.SalesP,Q.Cover"
			cSQL = cSQL +",S.prcp,S.prcd,S.pckd,S.Urgent"
			cSQL = cSQL +",ISNULL(S.WO,0) AS WO, ISNULL(Q.Q_Qty,0) AS QTY, dbo.f_GetFormPU(Q.Form) AS PU"
			cSQL = cSQL + ",S.Item,Q.CL,Q.Pieces AS PC "
			cSQL = cSQL +" FROM dbo.ALLQuotes Q "
			cSQL = cSQL +" INNER JOIN Sales S ON Q.SOitem = S.SOitem "
			cSQL = cSQL +" WHERE 0>0"
		
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSO' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle,nSQLEXEC,'tmpSO')
			ENDIF
			
		ENDIF
		
		*******************************************
		SELECT 0
		PRIVATE cSQLp 
		cSQLp = "SELECT *,' ' AS Tbl FROM dbo.StockLst_Process WHERE 0>0"
		*UNION SELECT * FROM dbo.BrokerLst_Process WHERE 0>0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLp, 'tmpProcess')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLp, 'tmpProcess')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQLp, ThisFormSet.nConnHandle,nSQLEXEC,'tmpProcess')
		ENDIF
		
		*******************************************
		PUBLIC ARRAY aVisibleForms(15,2)
	ENDPROC

	PROCEDURE modifystocklst
		*ThisFormSet.ModifyStockLst()  &&Check to see if CONSUMED and finds next Best
		
		PRIVATE nID_Detail, cTBL, nID_Detail_Process
		nID_Detail	= PrepareSQLnum( ThisFormSet.Stocklst_ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.ID_Detail_Process,'ID_Detail_Process',-3)
			
		
		PRIVATE cSQL
		cSQL = "SELECT COUNT(*) AS CNTD "
		DO CASE 
			CASE cTBL = "S"
				cSQL = cSQL + " FROM dbo.StockLst_Process "
			CASE cTBL = "B"
				cSQL = cSQL + " FROM dbo.BrokerLst_Process "
			CASE cTBL = "W"
				cSQL = cSQL + " FROM dbo.WIPLst_Process "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				IF tmpProcess2.CNTD > 0
				
					ThisFormSet.ModifyStockLst_ID_Detail_Process()
					
					RETURN
				ENDIF
				USE IN tmpProcess2
			ENDIF
		ENDIF
		
		**********************
										
		cSQL = "SELECT COUNT(*) AS CNTD "
		DO CASE 
			CASE cTBL = "S"
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
			CASE cTBL = "B"
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
			CASE cTBL = "W"
				cSQL = cSQL + " FROM dbo.WIPLst_Detail "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				IF tmpProcess2.CNTD > 0
				
					ThisFormSet.ModifyStockLst_ID_Detail()
					
					RETURN
				ENDIF
				USE IN tmpProcess2
			ENDIF
		ENDIF
		
		*********************************
										
		cSQL = "SELECT ID "
		DO CASE 
			CASE cTBL = "S"
				cSQL = cSQL + " FROM HPAlloy_Archive.dbo.StockLst_Detail_History "
			CASE cTBL = "B"
				cSQL = cSQL + " FROM HPAlloy_Archive.dbo.BrokerLst_Detail_History "
			CASE cTBL = "W"
				cSQL = cSQL + " FROM HPAlloy_Archive.dbo.WIPLst_Detail_History "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				IF tmpProcess2.ID  > 0
					ThisFormSet.Stocklst_ID_Detail = 0
					ThisFormSet.Stocklst_ID = PrepareSQLnum(tmpProcess2.ID,'ID',-3)
					
					ThisFormSet.ModifyStockLst_ID()
					
					RETURN
				ENDIF
				USE IN tmpProcess2
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE modifystocklst_id
		*ThisFormSet.ModifyStockLst_ID()
		
		PRIVATE nID, nID_Detail, cTBL, nID_Detail_Process
		nID		= PrepareSQLnum( ThisFormSet.Stocklst_ID,'ID',-3)
		nID_Detail	= PrepareSQLnum(ThisFormSet.Stocklst_ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.ID_Detail_Process,'ID_Detail_Process',-3)
		
		PRIVATE nSalesNum, nItem, cSOitem, nQTY
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		nQTY		= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.Qty1.Value ,'S_QTY ',-5)
		IF nQTY = 0
			nQTY		= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.pWeight1.Value ,'S_QTY ',-5)
		ENDIF
		
		
		PRIVATE cSQL
		cSQL = "SELECT M.Alloy, M.Form, M.CC, M.CL "
		cSQL = cSQL + ",M.Size,Dim1,Dim2,Dim3,PC,Weight,S_QTY,RandLen "
		cSQL = cSQL + ",M.Heat,M.Lot "
		cSQL = cSQL + ",P.QTY, P.Pounds, P.PO_item "
		DO CASE 
		CASE cTBL = "S"
			cSQL = cSQL + ",StockLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.StockLst_Process "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail ON StockLst_Detail.ID_Detail = StockLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M ON M.ID = StockLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON StockLst_Detail.ID_Detail = P.ID_Detail "
		CASE cTBL = "B"
			cSQL = cSQL + ",BrokerLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail ON BrokerLst_Detail.ID_Detail = BrokerLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M ON M.ID = BrokerLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON BrokerLst_Detail.ID_Detail = P.ID_Detail "
		CASE cTBL = "W"
			cSQL = cSQL + ",WIPLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.WIPLst_Process "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail ON WIPLst_Detail.ID_Detail = WIPLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M ON M.ID = WIPLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON WIPLst_Detail.ID_Detail = P.ID_Detail "
		ENDCASE
		
		cSQL = cSQL + " WHERE M.ID = "+STR(nID)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				
				PRIVATE cAlloy, cForm, nThck, cCC, cCL
				cAlloy = PrepareSQLtxt(tmpProcess2.Alloy,'Alloy',12,.T.)
				cForm  = Proper_Form(PrepareSQLtxt(tmpProcess2.Form,'Form',2,.T.))
				cCC	   = PrepareSQLtxt(tmpProcess2.CC,'CC',1)
				cCL	   = PrepareSQLtxt(tmpProcess2.CL,'CL',1)
				
				PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL ,cPO_item
				nThck	= PrepareSQLnum(tmpProcess2.Dim1,'Thck',9,3)
				nSz2	= PrepareSQLnum(tmpProcess2.Dim2,'Sz2',9,3)
				nSz3	= PrepareSQLnum(tmpProcess2.Dim3,'Sz3',9,3)
				nPC		= PrepareSQLnum(tmpProcess2.PC,'PC',-3)
				nLBS	= PrepareSQLnum(tmpProcess2.Weight,'Weight',7,1)
				lRL		= PrepareSQLlogic(tmpProcess2.RandLen,'RandLen')
				cPO_item= PrepareSQLtxt(tmpProcess2.PO_item,'PO_item',12)
				
				PRIVATE cHeatLot
				cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpProcess2.Heat)+" "+ALLTRIM(tmpProcess2.Lot),'HeatLot',60)
						
				PRIVATE nSalesNum
				nSalesNum = nID_Detail  &&"Browse_ID_Detail"
				
				PRIVATE pID_Detail		
				pID_Detail = nID_Detail  
				
				USE IN tmpProcess2
				
			 	ThisFormSet.VisibleForms()
			 	ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
									
				DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE_ID_Detail",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPO_item  TO pID_Detail
				*		pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem TO ID_Detail
				
				ThisFormSet.VisibleFormsReset()
				
			ENDIF
			IF USED("tmpProcess2")
				USE IN tmpProcess2
			ENDIF
		ELSE
			MESSAGEBOX("Did not Selected material beloning to ID_Detail_Process = "+STR(nID_Detail_Process),16,"Did not Find!")
			TrackError("Wrong ID_Detail_Process.","No Selected material beloning to ID_Detail_Process = "+STR(nID_Detail_Process)+" TBL:"+cTBL,"frmShop_StockLst_Edit.Modify_StockLst_Detail_Report",LINENO())
		ENDIF
		
		
	ENDPROC

	PROCEDURE modifystocklst_id_detail
		*ThisFormSet.ModifyStockLst_ID_Detail()
		
		PRIVATE nID, nID_Detail, cTBL, nID_Detail_Process
		nID			= PrepareSQLnum( ThisFormSet.Stocklst_ID,'ID',-3)
		nID_Detail	= PrepareSQLnum( ThisFormSet.Stocklst_ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.ID_Detail_Process,'ID_Detail_Process',-3)
		
		PRIVATE nSalesNum, nItem, cSOitem, nQTY
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		nQTY		= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.Qty1.Value ,'S_QTY ',-5)
		IF nQTY = 0
			nQTY		= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.pWeight1.Value ,'S_QTY ',-5)
		ENDIF
		
		
		PRIVATE cSQL
		cSQL = "SELECT Alloy, Form, CC, CL "
		cSQL = cSQL + ",Size,Dim1,Dim2,Dim3,PC,Weight,S_QTY,RandLen "
		cSQL = cSQL + ",Heat,Lot "
		cSQL = cSQL + ",P.QTY, P.Pounds, P.PO_item "
		DO CASE 
		CASE cTBL = "S"
			cSQL = cSQL + ",StockLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.StockLst_Detail "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master ON StockLst_Master.ID = StockLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON StockLst_Detail.ID_Detail = P.ID_Detail "
		CASE cTBL = "B"
			cSQL = cSQL + ",BrokerLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail ON BrokerLst_Detail.ID_Detail = BrokerLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master ON BrokerLst_Master.ID = BrokerLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON BrokerLst_Detail.ID_Detail = P.ID_Detail "
		CASE cTBL = "W"
			cSQL = cSQL + ",WIPLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.WIPLst_Detail ON WIPLst_Detail.ID_Detail = WIPLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master ON WIPLst_Master.ID = WIPLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON WIPLst_Detail.ID_Detail = P.ID_Detail "
		ENDCASE
		
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		*cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID = 'PARTSELECT') "
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				
				PRIVATE cAlloy, cForm, nThck, cCC, cCL
				cAlloy = PrepareSQLtxt(tmpProcess2.Alloy,'Alloy',12,.T.)
				cForm  = Proper_Form(PrepareSQLtxt(tmpProcess2.Form,'Form',2,.T.))
				cCC	   = PrepareSQLtxt(tmpProcess2.CC,'CC',1)
				cCL	   = PrepareSQLtxt(tmpProcess2.CL,'CL',1)
				
				PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL ,cPO_item
				nThck	= PrepareSQLnum(tmpProcess2.Dim1,'Thck',9,3)
				nSz2	= PrepareSQLnum(tmpProcess2.Dim2,'Sz2',9,3)
				nSz3	= PrepareSQLnum(tmpProcess2.Dim3,'Sz3',9,3)
				nPC		= PrepareSQLnum(tmpProcess2.PC,'PC',-3)
				nLBS	= PrepareSQLnum(tmpProcess2.Weight,'Weight',7,1)
				lRL		= PrepareSQLlogic(tmpProcess2.RandLen,'RandLen')
				cPO_item= PrepareSQLtxt(tmpProcess2.PO_item,'PO_item',12)	&&tmpSO holds Process PO WHERE 'SELECTED' OR SP.Process_ID = 'PARTSELECT'
				
				PRIVATE cHeatLot
				cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpProcess2.Heat)+" "+ALLTRIM(tmpProcess2.Lot),'HeatLot',60)
						
				PRIVATE nSalesNum
				nSalesNum = nID_Detail  &&"Browse_ID_Detail"
				
				PRIVATE pID_Detail		
				pID_Detail = nID_Detail 
				
				USE IN tmpProcess2
				
				ThisFormSet.VisibleForms()
				ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
				
				DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE_ID_Detail",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPO_item  TO pID_Detail
				*		pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem TO ID_Detail
				
				ThisFormSet.VisibleFormsReset()
				
			ENDIF
			IF USED("tmpProcess2")
				USE IN tmpProcess2
			ENDIF
		ELSE
			MESSAGEBOX("Did not Selected material beloning to ID_Detail = "+STR(nID_Detail),16,"Did not Find!")
			TrackError("Wrong ID_Detail.","No Selected material beloning to ID_Detail = "+STR(nID_Detail)+" TBL:"+cTBL,"frmShop_StockLst_Edit.ModifyStockLst_ID_Detail",LINENO())
		ENDIF
		
		
	ENDPROC

	PROCEDURE modifystocklst_id_detail_process
		*ThisFormSet.ModifyStockLst_ID_Detail_Process()
		
		PRIVATE nID, nID_Detail, cTBL, nID_Detail_Process
		nID			= PrepareSQLnum( ThisFormSet.Stocklst_ID,'ID',-3)
		nID_Detail	= PrepareSQLnum( ThisFormSet.Stocklst_ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.ID_Detail_Process,'ID_Detail_Process',-3)
		
		PRIVATE nSalesNum, nItem, cSOitem
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		
		
		PRIVATE cSQL
		cSQL = "SELECT Alloy, Form, CC, CL "
		cSQL = cSQL + ",Size,Dim1,Dim2,Dim3,PC,Weight,S_QTY,RandLen "
		cSQL = cSQL + ",Heat,Lot "
		cSQL = cSQL + ",P.QTY, P.Pounds, P.PO_item "
		DO CASE 
		CASE cTBL = "S"
			cSQL = cSQL + ",StockLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.StockLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail ON StockLst_Detail.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master ON StockLst_Master.ID = StockLst_Detail.ID "
		CASE cTBL = "B"
			cSQL = cSQL + ",BrokerLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail ON BrokerLst_Detail.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master ON BrokerLst_Master.ID = BrokerLst_Detail.ID "
		CASE cTBL = "W"
			cSQL = cSQL + ",WIPLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail ON WIPLst_Detail.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master ON WIPLst_Master.ID = WIPLst_Detail.ID "
		ENDCASE
		
		cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_Detail_Process)
		*cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID = 'PARTSELECT') "
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				
				PRIVATE cAlloy, cForm, nThck, cCC, cCL
				cAlloy = PrepareSQLtxt(tmpProcess2.Alloy,'Alloy',12,.T.)
				cForm  = Proper_Form(PrepareSQLtxt(tmpProcess2.Form,'Form',2,.T.))
				cCC	   = PrepareSQLtxt(tmpProcess2.CC,'CC',1)
				cCL	   = PrepareSQLtxt(tmpProcess2.CL,'CL',1)
				
				PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL, cPO_Item, nQTY
				nThck	= PrepareSQLnum(tmpProcess2.Dim1,'Thck',9,3)
				nSz2	= PrepareSQLnum(tmpProcess2.Dim2,'Sz2',9,3)
				nSz3	= PrepareSQLnum(tmpProcess2.Dim3,'Sz3',9,3)
				nPC		= PrepareSQLnum(tmpProcess2.PC,'PC',-3)
				nLBS	= PrepareSQLnum(tmpProcess2.Weight,'Weight',7,1)
				lRL		= PrepareSQLlogic(tmpProcess2.RandLen,'RandLen')
				cPO_item= PrepareSQLtxt(tmpProcess2.PO_item,'PO_item',12)	&&tmpSO holds Process PO WHERE 'SELECTED' OR SP.Process_ID = 'PARTSELECT'
				
				nQTY	= PrepareSQLnum(tmpProcess2.QTY ,'QTY',-5)
				IF nQTY = 0
					nQTY	= PrepareSQLnum(tmpProcess2.Pounds,'QTY',-5)
				ENDIF
				IF nQTY = 0
					nQTY	= PrepareSQLnum(tmpProcess2.S_QTY,'QTY',-5)
				ENDIF
				
				PRIVATE cHeatLot
				cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpProcess2.Heat)+" "+ALLTRIM(tmpProcess2.Lot),'HeatLot',60)
									
				PRIVATE nSalesNum
				nSalesNum = nID_Detail  &&"Browse_ID_Detail"
				
				PRIVATE pID_Detail		
