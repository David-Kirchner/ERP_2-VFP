		ThisFormSet.frmQuote.Left = 0
		
		ThisFormSet.frmStockLst.Visible = .F.
		ThisFormSet.frmStockLst.Top = 350
		ThisFormSet.frmStockLst.Left = 0
		
		ThisFormSet.frmStockStatus.Visible = .F.
		ThisFormSet.frmStockStatus.Top = ThisFormSet.frmShop_StockLst_Edit.Top &&355
		ThisFormSet.frmStockStatus.Left = ThisFormSet.frmShop_StockLst_Edit.Left + ThisFormSet.frmShop_StockLst_Edit.Width+10 &&600
		
		ThisFormSet.frmModiProcess.Visible = .F.
		ThisFormSet.frmModiProcess.Top = 50
		ThisFormSet.frmModiProcess.LEFT = 550
		
		
		ThisFormSet.frmStockLstProcesses.Visible = .F.
		ThisFormSet.frmStockLstProcesses.Top = 0
		ThisFormSet.frmStockLstProcesses.LEFT = 625
		
		
		*ThisFormSet.frmReceiving.Visible = .F.
		*ThisFormSet.frmReceiving.Top = 300
		*ThisFormSet.frmReceiving.LEFT = 300
		
		ThisFormSet.frmSimiliarOrdersProcess.Top = 433
		ThisFormSet.frmSimiliarSales.Top = 433
		
	ENDPROC

