	PROCEDURE frmStockLst.cmdShowPrc.Click
		
		IF This.Caption = "Show Prc"
			IF vStockLst_SQL.Prc > 0
				*ThisFormSet.Create_StockLst_Process( vStockLst_SQL.ID, vStockLst_SQL.ID_Detail, 'NOEDIT', "S" )
				*ThisFormSet.StockLstProcesses(vStockLst_SQL.ID_Detail, 'NOEDIT' )
				THISFORMSET.Processes(vStockLst_SQL.ID_Detail)
		
			ELSE
				MESSAGEBOX( "No StockLst Process to Show!",0,"No PRC")
			ENDIF
		ELSE
			*Show Bkr
			IF vStockLst_SQL.Bkr > 0
				*ThisFormSet.Create_StockLst_Process( vStockLst_SQL.ID, vStockLst_SQL.ID_Detail, 'NOEDIT', "B" )
				*ThisFormSet.StockLstProcesses(vStockLst_SQL.ID_Detail, 'NOEDIT' )
				THISFORMSET.Processes(vStockLst_SQL.ID_Detail)
		
			ELSE
				MESSAGEBOX( "No Broker Process to Show!",0,"No PRC")
			ENDIF
		ENDIF
	ENDPROC

