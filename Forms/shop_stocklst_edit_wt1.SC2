				USE IN tmpProcess2
				
			 	ThisFormSet.VisibleForms()
			 	ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
									
				DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE_ID_Detail",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPO_item TO pID_Detail
				*		pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem TO ID_Detail
				
				ThisFormSet.VisibleFormsReset()
				
			ENDIF
			IF USED("tmpProcess2")
				USE IN tmpProcess2
			ENDIF	
		ELSE
			MESSAGEBOX("Did not Selected material beloning to ID_Detail_Process = "+STR(nID_Detail_Process),16,"Did not Find!")
			TrackError("Wrong ID_Detail_Process.","No Selected material beloning to ID_Detail_Process = "+STR(nID_Detail_Process)+" TBL:"+cTBL,"frmShop_StockLst_Edit.Modify_StockLst_Detail_Report",LINENO())
		ENDIF
		
		
	ENDPROC

	PROCEDURE modify_brokerlst_detail_report
		PARAMETER pID_Detail_Process, pSOItem
		*ThisFormSet.Modify_BrokerLst_Detail_Report
		*Modify_BrokerLst_Detail_Report(m.ID_Detail_Process, m.SOItem)
		
		**********************************
		**********************************
		RETURN .T.
		**********************************
		**********************************
		
		IF VARTYPE(pID_Detail_Process) != 'N'
			pID_Detail_Process = 0
		ENDIF
		
		PRIVATE nMess
		nMess = 6
		
		PRIVATE nBE, nAE, nAD, nDL, nChange
		nChange = 0
		*****Just this Process
		PRIVATE cSQL
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		*
		
		IF pID_Detail_Process > 0
			cSQL =  "SELECT SUM(ProcessValue) AS TotProc FROM HPAlloy_Archive.dbo.BrokerLst_Detail_History WHERE ID_Detail_Process = "+ STR(pID_Detail_Process)
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
			ELSE
				SELECT tmpDetail_Process_Report
				nChange = tmpDetail_Process_Report.TotProc
		
				IF ISNULL(nChange)
					nChange = 0
				ENDIF
				nChange = -( nChange )
				IF nChange = 0 
		*			MESSAGEBOX("There was no cost, or change in cost to apply to this order item from this Process."+CHR(13)+;
						"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
				ELSE
		*			MESSAGEBOX("The cost to apply to this order item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process."+CHR(13)+;
						"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
				ENDIF
			ENDIF
		
			IF USED("tmpDetail_Process_Report")
				USE IN tmpDetail_Process_Report
			ENDIF
		ENDIF
		
		******** Look for Other Process on this pSOItem
		IF TYPE("pSOitem") = "C"
			IF !EMPTY(pSOItem)
		
				cSQL =  "SELECT SUM(ProcessValue) AS TotProc FROM HPAlloy_Archive.dbo.BrokerLst_Detail_History "
				cSQL = cSQL + " WHERE ID_Detail_Process IN (SELECT ID_Detail_Process FROM dbo.BrokerLst_process "
				*cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pSOItem + "'))"
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pSOItem + "'))"
				
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
				ELSE
					SELECT tmpDetail_Process_Report
					nChange = tmpDetail_Process_Report.TotProc
					IF ISNULL(nChange)
						nChange = 0
					ENDIF
					nChange = -( nChange )
					IF nChange = 0
						* First zero Message was enough
					ELSE
		*				nMess = MESSAGEBOX("The cost to apply to this Sales Order Item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process.",4+32,"Sales Order Item Total")
					ENDIF
					
		*********** Update Sales Record!!!
					IF nMess = 6 &&Yes 
						IF TYPE("pSOItem") = "C"
					
							*UPDATE HPA!Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)
							Save_ItemCostinSales( nChange, pSOitem, ThisFormSet.nConnHandle )
							
						ELSE
							*\Progs\ErrorHandlerlog(0,"Not Associated with a Sales Order Item!","UPDATE Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)","frmShop_BrokerLst_Edit.Modify_BrokerLst_Detail_Report",LINENO())
							TrackError("Not Associated with a Sales Order Item!",cSQL,"frmShop_StockLst_Edit.Modify_BrokerLst_Detail_Report",LINENO())
						ENDIF
					ENDIF
				ENDIF &&nSQLEXEC
			ELSE
				MESSAGEBOX('Could NOT Calc for SOitem',0,"Empty SOitem!")
			ENDIF &&!EMPTY(pSOItem)
		ELSE
			MESSAGEBOX('Could NOT Calc for SOitem',0,"Empty SOitem!")
		ENDIF &&TYPE("pSOitem") = "C"
			
		IF USED("tmpDetail_Process_Report")
			USE IN tmpDetail_Process_Report
		ENDIF
		
	ENDPROC

	PROCEDURE modify_stocklst_detail
		
		
	ENDPROC

	PROCEDURE modify_stocklst_detail_report		&& Cost of Goods Sold
		PARAMETER pSOItem
		*PARAMETER pID_Detail_Process, pSOItem
		*Modify_StockLst_Detail_Report(m.ID_Detail_Process, m.SOItem)
		
		IF VARTYPE(pID_Detail_Process) != 'N'
			pID_Detail_Process = 0
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = PrepareSQLtxt(pSOitem,'SOitem',10)
		IF Proper_SO_item(cSOitem) = Proper_SO_item('')
			TrackError("No PARAMETER SOitem","Not Associated with a Sales Order Item!","frmShop_StockLst_Edit.Modify_StockLst_Detail_Report",LINENO())
			RETURN .F.
		ENDIF
		
		PRIVATE nStkCost
		nStkCost = getStkCost_SOitem(cSOitem, ThisFormSet.nConnHandle)
		*getStkCost_SOitem uses f_CalcStkCost_SOitem
		*	--Get from Sales_Detail when Complete &&Sales.Cmplt = 1
		*   SELECT @StkCost = SUM(SD.StockLst_Qty * SD.StockLst_P ) 
		*		FROM dbo.Sales_Detail SD WHERE SD.SOitem =dbo.ProperSO(@SOitem)
		*	--Get from StockLst_Detail, StockLst_Process when not Complete
		*	SELECT @StkCost = SUM(SP.QTY * SD.S_P )
		*		FROM dbo.StockLst_Process SP INNER JOIN dbo.StockLst_Detail SD ON SD.ID_Detail = SP.ID_Detail 
		*		WHERE SP.SOitem =dbo.ProperSO(@SOitem)
		
		Save_ItemCostinSales( nStkCost, cSOitem, ThisFormSet.nConnHandle )
		
		RETURN
		
		
		
		
		
		
		
		
		
		
		
		
		*!*	PRIVATE cSQL
		*!*	IF USED("tmpDetail_Process_Report")
		*!*		USE IN tmpDetail_Process_Report
		*!*	ENDIF
		
		*!*	IF pID_Detail_Process > 0
		*!*		cSQL =  "SELECT SUM(ProcessValue) AS TotProc FROM HPAlloy_Archive.dbo.StockLst_Detail_History WHERE ID_Detail_Process = "+ STR(pID_Detail_Process)
		*!*		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
		*!*		ELSE
		*!*			SELECT tmpDetail_Process_Report
		*!*			nChange = tmpDetail_Process_Report.TotProc
		
		*!*			IF ISNULL(nChange)
		*!*				nChange = 0
		*!*			ENDIF
		*!*			nChange = -( nChange )
		*!*			IF nChange = 0 
		*!*	*			MESSAGEBOX("There was no cost, or change in cost to apply to this order item from this Process."+CHR(13)+;
		*!*					"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
		*!*			ELSE
		*!*	*			MESSAGEBOX("The cost to apply to this order item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process."+CHR(13)+;
		*!*					"This total is only for this 'PROCESS'",0+48,"Order Item 'PROCESS' Total")
		*!*			ENDIF
		*!*		ENDIF
		
		*!*		IF USED("tmpDetail_Process_Report")
		*!*			USE IN tmpDetail_Process_Report
		*!*		ENDIF
		*!*	ENDIF
		
		*!*	******** Look for Other Process on this pSOItem
		*!*	IF TYPE("pSOitem") = "C"
		*!*		IF !EMPTY(pSOItem)
		
		*!*			cSQL =  "SELECT SUM(ProcessValue) AS TotProc FROM HPAlloy_Archive.dbo.StockLst_Detail_History "
		*!*			cSQL = cSQL + " WHERE ID_Detail_Process IN (SELECT ID_Detail_Process FROM dbo.StockLst_process "
		*!*			*cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pSOItem + "'))"
		*!*			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+pSOItem + "'))"
		*!*			
		*!*			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpDetail_Process_Report' )
		*!*			ENDDO
		*!*			IF nSQLEXEC < 0
		*!*				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpDetail_Process_Report')
		*!*			ELSE
		*!*				SELECT tmpDetail_Process_Report
		*!*				nChange = tmpDetail_Process_Report.TotProc
		*!*				IF ISNULL(nChange)
		*!*					nChange = 0
		*!*				ENDIF
		*!*				nChange = -( nChange )
		*!*				IF nChange = 0
		*!*					* First zero Message was enough
		*!*				ELSE
		*!*	*				nMess = MESSAGEBOX("The cost to apply to this Sales Order Item is $"+ALLTRIM(STR(nChange,9,2))+" from this Process.",4+32,"Sales Order Item Total")
		*!*				ENDIF
		*!*				
		*!*	*********** Update Sales Record!!!
		*!*				IF nMess = 6 &&Yes 
		*!*					IF TYPE("pSOItem") = "C"
		*!*				
		*!*						*UPDATE HPA!Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)
		*!*						Save_ItemCostinSales( nChange, pSOitem, ThisFormSet.nConnHandle )
		*!*						*Save_ItemCostinSales( nItemCost, SOitem, ThisFormSet.nConnHandle )
		*!*					ELSE
		*!*						*\Progs\ErrorHandlerlog(0,"Not Associated with a Sales Order Item!","UPDATE Sales SET ItemCost = (nChange) WHERE SOitem = (pSOItem)","frmShop_StockLst_Edit.Modify_stockLst_Detail_Report",LINENO())
		*!*						TrackError("Not Associated with a Sales Order Item!",cSQL,"frmShop_StockLst_Edit.Modify_StockLst_Detail_Report",LINENO())
		*!*					ENDIF
