	PROCEDURE saveadd_purchaseorder
		PARAMETERS nReceivingID,cPOItem,cComments,dReceived,cInit,cHeat,lCert,cSOitem,cVendor,cComments,nPieces,nRMA,lalready_Saved,nActualW,lFoundStockUpdateReceiving 
		*ThisForm.SaveAdd_PurchaseOrder
		
		IF VARTYPE(nReceivingID) != "N"		
			*TrackError("bad parameter","nReceivingID is not a NUMBER","Shop_StockLst_Edit:SaveAdd_PurchaseOrder",LINENO())
			nReceivingID = 0
		ELSE
			IF nReceivingID = 0
				*TrackError("Bad Parameter","nReceivingID is 0","Receiving:SaveAdd_PurchaseOrder",LINENO(1))
				TrackMess("nReceivingID is 0"+CHR(13)+"Bad Parameter"+CHR(13)+"Receiving:SaveAdd_PurchaseOrder")
			ENDIF
		ENDIF
			
		IF VARTYPE(lFoundStockUpdateReceiving) != "L"
			lFoundStockUpdateReceiving = .F.
		ENDIF
		
		PRIVATE nItemPO,nHPAPO,nSalesNum,nItemSo
		nItemPO	= VAL(RIGHT(cPOitem,2))
		nHPAPO	= VAL(LEFT(cPOitem,AT('-',cPOitem)-1 ))
		nSalesNum	= VAL(LEFT(cSOitem,AT('-',cSOitem)-1 ))
		nItemSo	= VAL(RIGHT(cSOitem,2))
		
		*Mark PO
		PRIVATE lRollBack
		lRollBack = .F.
		
		PRIVATE nCntPOitem,nCntSOitem 
		nCntPOitem = 0
		nCntSOitem = 0
		
		*****************
		IF USED('cntPO')
			USE IN cntPO
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.PurchaseOrder "
		cSQL = cSQL + " WHERE POitem = '"+cPOItem+"'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntPO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'cntPO' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'cntPO' )
		ENDIF
		
		IF USED('cntPO')
			nCntPOitem = cntPO.CNTD
			USE IN cntPO
		ENDIF
		*****************
		PRIVATE cHeatCombined
		cHeatCombined = cHeat
		
		IF nCntPOitem > 0	
			*Add new heat to heat list
			IF USED('tmpPOHeat')
				USE IN tmpPOHeat
			ENDIF
		
			SELECT 0
			cSQL = "SELECT Heat FROM dbo.PurchaseOrder "
			cSQL = cSQL + " WHERE POitem = '"+cPOItem+"'"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOHeat')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpPOHeat' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOHeat' )
			ENDIF
		
			IF USED('tmpPOHeat')
				IF VARTYPE(tmpPOHeat.Heat) = "C"
					IF NOT EMPTY(tmpPOHeat.Heat)
						IF NOT UPPER(cHeat) $ UPPER(tmpPOHeat.Heat)
							IF EMPTY(cHeat)
								cHeatCombined = PrepareSQLtxt(tmpPOHeat.Heat,'Heat',30,.F.,.T.)
							ELSE
								cHeatCombined = ALLTRIM(cHeat)+","+ALLTRIM(PrepareSQLtxt(tmpPOHeat.Heat,'Heat',30,.F.,.T.))
							ENDIF
						ENDIF
					ENDIF
				ELSE
					*Null Heat found!
				ENDIF
				USE IN tmpPOHeat
			ENDIF
		ENDIF
		
		********************
		IF nCntPOitem = 0	
			*Check for SO- Allow if has SO
			IF USED('tmpCountSO')
				USE IN tmpCountSO
			ENDIF
		
			cSQL = "SELECT COUNT(*) AS cntd FROM dbo.Sales "
			cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountSO')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpCountSO' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountSO' )
			ENDIF
		
			IF USED('tmpCountSO')
				IF NOT EOF('tmpCountSO')
					IF tmpCountSO.cntd > 0
						nCntSOitem = tmpCountSO.cntd
					ENDIF
				ENDIF
				USE IN tmpCountSO
			ENDIF	
			
			IF nCntSOitem = 0
				*Did not find that PO in PurchaseOrder!
				*And now, did not find a SO!  RollBack
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" or SOitem:"+ALLTRIM(cSOitem)+" -Cound not find either! #Rollback")
				MESSAGEBOX("Receiving ID:"+ALLTRIM(STR(nReceivingID))+" is for POitem:"+ALLTRIM(cPOitem)+" or SOitem:"+ALLTRIM(cSOitem)+" -Cound not find either! #Rollback"+CHR(13)+"Please check that you typed the right PO or SO!",0,"PO or SO item not found!")
				*Do not add to PurchaseOrder
				*POitem is check early in receiving
				lRollBack = .T.
			ENDIF
		ENDIF
		
		********************
		IF nCntPOitem > 0	
		
			PRIVATE cSQLu
			cSQLu = "UPDATE dbo.PurchaseOrder SET "
			cSQLu = cSQLu + " Receipt ='"+cComments+"'"
			cSQLu = cSQLu + ",Received ='"+IIF(EMPTY(dReceived),'',DTOC(dReceived))+"'"		
			cSQLu = cSQLu + ",ReceivedBy ='"+cInit+"'"
			cSQLu = cSQLu + ",Heat ='"+cHeatCombined+"'"
			cSQLu = cSQLu + ",Delivered=1"
			cSQLu = cSQLu + ",Cert="+IIF(lCert,'1','0')
			cSQLu = cSQLu + " WHERE PoItem = dbo.f_ProperPOitem('"+cPOItem+"')"
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLu )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLu )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQLu, ThisFormSet.nConnHandle, nSQLEXEC )
			ELSE
				lPOSaveLst = .T.
				TrackMess( "Receiving ID:"+ALLTRIM(STR(nReceivingID))+" updated POitem:"+ALLTRIM(cPOitem)+" in PurchaseOrders to Delivered.")
			ENDIF
		ENDIF	
		
		********************
		IF NOT lRollBack
			*Done in ReceivingSaveAdd where nReceivingID can be used.
			*Remove_Incoming_Process(cPOitem,nPieces,nActualW,ThisFormSet.nConnHandle,1)
		ENDIF
		
		********************
		IF lRollBack
			RETURN .F.
		ENDIF
		
		*ThisFormSet.RefreshReceiving()
		
		********************		
		IF nCntPOitem > 0	
		*	ThisFormSet.ReportReceivedtoOrdered(cPOitem)
			*ThisFormset.ReceivingRefreshReceiving()
			
			IF lalready_Saved
				IF lFoundStockUpdateReceiving 
					ThisFormSet.ReceivePOStockLst( cPOitem, nReceivingID, cHeat, nRMA ) 
				ELSE
					ThisFormSet.ReceivePOStockLst( cPOitem, nReceivingID, cHeat, nRMA ) 
				ENDIF
			ELSE
				ThisFormSet.ReceivePOStockLst( cPOitem, nReceivingID, cHeat, nRMA ) 
			ENDIF
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE setselectedid_detail
		PARAMETERS pWhat,pItem,pTBL
		*ThisFormSet.SetSelectedID_Detail('SOitem',cSOitem,'S')
		*Sets ThisFormSet.StockLst_ID_Detail from Incoming or Selected Process
		
		IF VARTYPE(pWhat) != 'C'
			RETURN .F.
		ENDIF
		
		IF NOT ( pWhat = "SOitem" OR pWhat = "ID_Detail" OR pWhat = "WO" )
			RETURN .F.
		ENDIF
		
		PRIVATE cTBL
		cTBL = UPPER(pTBL)
		
		PRIVATE cSOitem, nID_Detail,nWO
		cSOitem = Proper_SO_item('')
		nID_Detail = 0
		nWO = 0
		
		IF pWhat = "SOitem"
			cSOitem = Proper_SO_item(pItem)
			IF cSOitem = Proper_SO_item('')
				RETURN .F.
			ENDIF
		ENDIF
		IF pWhat = "ID_Detail"
			nID_Detail = PrepareSQLnum(pItem,'ID_Detail',-3)
			IF nID_Detail = 0
				RETURN .F.
			ENDIF
		ENDIF
		IF pWhat = "WO"
			nWO = PrepareSQLnum(pItem,'WO',-3)
			IF nWO = 0
				RETURN .F.
			ENDIF
		ENDIF
			
		PRIVATE lReturn
		lReturn = .F.
		
		**************************
		
		IF pWhat = "SOitem" OR pWhat = "WO"
			PRIVATE cSQL, nSQLEXEC
		
			IF USED('tmpSelectSTK')
				USE IN tmpSelectSTK
			ELSE
				SELECT 0
			ENDIF
		
		
			cSQL = "SELECT ID_Detail "
			IF ThisFormSet.StockLst_TBL = 'S'
				cSQL = cSQL +" FROM dbo.StockLst_Process SP "
			ELSE
				cSQL = cSQL +" FROM dbo.BrokerLst_Process SP "
			ENDIF
			IF pWhat = "SOitem"
				cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			ELSE 
				IF pWhat = "WO"
					cSQL = cSQL +" WHERE WO = "+STR(nWO)
				ELSE
					TrackError("Could not select from cSOitem or nWO","cSOitem='"+cSOitem+"'  WO="+ALLTRIM(STR(nWO))+"!","Shop_StockLst_Edit.SetSelectedID_Detail()",LINENO())
					RETURN .F.
				ENDIF
			ENDIF
			cSQL = cSQL +" AND (SP.Process_ID = 'SELECTED' OR SP.Process_ID = 'INCOMING' OR SP.Process_ID = 'NOT2HPA' OR SP.Process_ID = 'PARTRECV' OR SP.Process_ID = 'PARTSELECT' ) "
			cSQL = cSQL +" ORDER BY SP.Process_ID,AllowSub "
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSelectSTK')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSelectSTK' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSelectSTK')
			ENDIF
		
			IF USED('tmpSelectSTK')
				IF RECCOUNT('tmpSelectSTK') > 0
					ThisFormSet.StockLst_ID_Detail = tmpSelectSTK.ID_Detail
					nID_Detail = tmpSelectSTK.ID_Detail
					lReturn = .T.
				ENDIF
				USE IN tmpSelectSTK
			ENDIF
		ENDIF
		
		**************************
		
		IF pWhat = "ID_Detail"
			ThisFormSet.StockLst_ID_Detail = nID_Detail
			lReturn = .T.
		ENDIF
		
		**************************
		
		*!*	IF USED('vStockLst_SQL')
		*!*		SELECT vStockLst_SQL
		*!*		LOCATE FOR ID_Detail = nID_Detail
		*!*		IF NOT FOUND('vStockLst_SQL')
		*!*			*
		*!*			IF USED('tmpSO')
		*!*				PRIVATE cAlloy, cForm, nThck
		*!*				cAlloy	= PrepareSQLtxt(tmpSO.Alloy,'Alloy',12)
		*!*				cForm	= PrepareSQLtxt(tmpSO.Form,'Form',2)
		*!*				nThck	= PrepareSQLnum(tmpSO.Thck,'Thck',10,4)
		*!*				
		*!*				LOCATE FOR Alloy = cAlloy AND Form = cForm
		*!*				IF FOUND()
		*!*					ThisFormSet.StockLst_ID_Detail = vStockLst_SQL.ID_Detail
		*!*					
		*!*					LOCATE FOR Alloy = cAlloy AND Form = cForm AND Size >= nThck 
		*!*					IF FOUND()
		*!*						ThisFormSet.StockLst_ID_Detail = vStockLst_SQL.ID_Detail
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*			lReturn = .F.
		*!*		ENDIF
		*!*	ENDIF
		
		**************************
		
		RETURN lReturn
	ENDPROC

	PROCEDURE set_alfmsccss
		PARAMETERS pTBL,pID_Detail
		*ThisFormSet.Set_AlFmsCCsS
		
		
		
		ThisFormSet.AlFmsCCsS = cAlloy+cFormSort+STR(nCCSortValue,2,0)+STR(nSize,9,3)
	ENDPROC

	PROCEDURE showsalesprocess		&& ShowSalesProcess
		PARAMETERS lShow
		*ThisFormSet.ShowSalesProcess
		
	ENDPROC

	PROCEDURE showstocklst
		*ThisFormSet.ShowStockLst()  &&Check to see if CONSUMED and finds next Best
		
		PRIVATE nID_Detail, cTBL, nID_Detail_Process
		nID_Detail	= PrepareSQLnum( ThisFormSet.Stocklst_ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.ID_Detail_Process,'ID_Detail_Process',-3)
			
		
		PRIVATE cSQL
		cSQL = "SELECT COUNT(*) AS CNTD "
		DO CASE 
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				IF tmpProcess2.CNTD > 0
				
					ThisFormSet.ShowStockLst_ID_Detail_Process()
					
					USE IN tmpProcess2	
					RETURN
				ENDIF
			ENDIF
		ENDIF
		
		IF USED('tmpProcess2')
			USE IN tmpProcess2
		ENDIF
		
		**********************
										
		cSQL = "SELECT COUNT(*) AS CNTD "
		DO CASE 
			CASE cTBL = "S"
				cSQL = cSQL + " FROM dbo.StockLst_Detail "
			CASE cTBL = "B"
				cSQL = cSQL + " FROM dbo.BrokerLst_Detail "
			CASE cTBL = "W"
				cSQL = cSQL + " FROM dbo.WIPLst_Detail "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				IF tmpProcess2.CNTD > 0
				
					ThisFormSet.ShowStockLst_ID_Detail()
					
					USE IN tmpProcess2
					RETURN
					
				ENDIF
			ENDIF
		ENDIF
		IF USED('tmpProcess2')
			USE IN tmpProcess2
		ENDIF
		
		*********************************
										
		cSQL = "SELECT ID "
		DO CASE 
			CASE cTBL = "S"
				cSQL = cSQL + " FROM HPAlloy_Archive.dbo.StockLst_Detail_History "
			CASE cTBL = "B"
				cSQL = cSQL + " FROM HPAlloy_Archive.dbo.BrokerLst_Detail_History "
			CASE cTBL = "W"
				cSQL = cSQL + " FROM HPAlloy_Archive.dbo.WIPLst_Detail_History "
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				IF tmpProcess2.ID  > 0
					ThisFormSet.Stocklst_ID_Detail = 0
					ThisFormSet.Stocklst_ID = PrepareSQLnum(tmpProcess2.ID,'ID',-3)
					
					ThisFormSet.ShowStockLst_ID()
					
					USE IN tmpProcess2	
					RETURN
				ENDIF
			ENDIF
		ENDIF
		IF USED('tmpProcess2')
			USE IN tmpProcess2
		ENDIF
		
		
	ENDPROC

	PROCEDURE showstocklst_id
		*ThisFormSet.ShowStockLst_ID()
		
		PRIVATE nID, nID_Detail, cTBL, nID_Detail_Process
		nID		= PrepareSQLnum( ThisFormSet.Stocklst_ID,'ID',-3)
		nID_Detail	= PrepareSQLnum(ThisFormSet.Stocklst_ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.ID_Detail_Process,'ID_Detail_Process',-3)
		
		***********
		IF nID > 0
			SELECT vStockLst_SQL
			LOCATE FOR ID = nID
			
			IF FOUND('vStockLst_SQL')
				
				ThisFormSet.frmStockLst.grdStockLst.Visible = .T.
				ThisFormSet.frmStockLst.Visible = .T.
				ThisFormSet.RefreshStockStatus()
				ThisFormSet.frmStockStatus.Visible = .T.
		
				ThisFormSet.frmStockLst.grdStockLst.Refresh
				ThisFormSet.frmStockLst.grdStockLst.SetFocus()
			ELSE
				MESSAGEBOX("ID was not found in vStockLst_SQL",48,"No ID find")
			ENDIF
		ELSE
			MESSAGEBOX( "No ID was not found in ThisFormSet.Stocklst_ID",48,"No ThisFormSet.Stocklst_ID" )
		ENDIF
		
		RETURN
		**************
			
		
		PRIVATE nSalesNum, nItem, cSOitem, nQTY
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		nQTY		= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.Qty1.Value ,'S_QTY ',-5)
		IF nQTY = 0
			nQTY		= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.pWeight1.Value ,'S_QTY ',-5)
		ENDIF
		
		
		PRIVATE cSQL
		cSQL = "SELECT M.Alloy, M.Form, M.CC, M.CL "
		cSQL = cSQL + ",M.Size,Dim1,Dim2,Dim3,PC,Weight,S_QTY,RandLen "
		cSQL = cSQL + ",M.Heat,M.Lot "
		cSQL = cSQL + ",P.QTY, P.Pounds, P.PO_item "
		DO CASE 
		CASE cTBL = "S"
			cSQL = cSQL + ",StockLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.StockLst_Process "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail ON StockLst_Detail.ID_Detail = StockLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master M ON M.ID = StockLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON StockLst_Detail.ID_Detail = P.ID_Detail "
		CASE cTBL = "B"
			cSQL = cSQL + ",BrokerLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail ON BrokerLst_Detail.ID_Detail = BrokerLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master M ON M.ID = BrokerLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON BrokerLst_Detail.ID_Detail = P.ID_Detail "
		CASE cTBL = "W"
			cSQL = cSQL + ",WIPLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.WIPLst_Process "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail ON WIPLst_Detail.ID_Detail = WIPLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master M ON M.ID = WIPLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON WIPLst_Detail.ID_Detail = P.ID_Detail "
		ENDCASE
		
		cSQL = cSQL + " WHERE M.ID = "+STR(nID)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				
				PRIVATE cAlloy, cForm, nThck, cCC, cCL
				cAlloy = PrepareSQLtxt(tmpProcess2.Alloy,'Alloy',12,.T.)
				cForm  = Proper_Form(PrepareSQLtxt(tmpProcess2.Form,'Form',2,.T.))
				cCC	   = PrepareSQLtxt(tmpProcess2.CC,'CC',1)
				cCL	   = PrepareSQLtxt(tmpProcess2.CL,'CL',1)
				
				PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL ,cPO_item
				nThck	= PrepareSQLnum(tmpProcess2.Dim1,'Thck',9,3)
				nSz2	= PrepareSQLnum(tmpProcess2.Dim2,'Sz2',9,3)
				nSz3	= PrepareSQLnum(tmpProcess2.Dim3,'Sz3',9,3)
				nPC		= PrepareSQLnum(tmpProcess2.PC,'PC',-3)
				nLBS	= PrepareSQLnum(tmpProcess2.Weight,'Weight',7,1)
				lRL		= PrepareSQLlogic(tmpProcess2.RandLen,'RandLen')
				cPO_item= PrepareSQLtxt(tmpProcess2.PO_item,'PO_item',12)
				
				PRIVATE cHeatLot
				cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpProcess2.Heat)+" "+ALLTRIM(tmpProcess2.Lot),'HeatLot',60)
						
				PRIVATE nSalesNum
				nSalesNum = nID_Detail  &&"Browse_ID_Detail"
				
				PRIVATE pID_Detail		
				pID_Detail = nID_Detail  
				
				USE IN tmpProcess2
				
			 	ThisFormSet.VisibleForms()
			 	ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
									
				DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE_ID_Detail",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPO_item  TO pID_Detail
				*		pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem TO ID_Detail
				
				ThisFormSet.VisibleFormsReset()
				
			ENDIF
			IF USED("tmpProcess2")
				USE IN tmpProcess2
			ENDIF
		ELSE
			MESSAGEBOX("Did not Selected material beloning to ID_Detail_Process = "+STR(nID_Detail_Process),16,"Did not Find!")
			TrackError("Wrong ID_Detail_Process.","No Selected material beloning to ID_Detail_Process = "+STR(nID_Detail_Process)+" TBL:"+cTBL,"frmShop_StockLst_Edit.Modify_StockLst_Detail_Report",LINENO())
		ENDIF
		
		
	ENDPROC

	PROCEDURE showstocklst_id_detail
		*ThisFormSet.ShowStockLst_ID_Detail()
		
		PRIVATE nID, nID_Detail, cTBL, nID_Detail_Process
		nID			= PrepareSQLnum( ThisFormSet.Stocklst_ID,'ID',-3)
		nID_Detail	= PrepareSQLnum( ThisFormSet.Stocklst_ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.ID_Detail_Process,'ID_Detail_Process',-3)
		
		***********
		IF nID_Detail > 0
			SELECT vStockLst_SQL
			LOCATE FOR ID_Detail = nID_Detail
			
			IF FOUND('vStockLst_SQL')
				
				ThisFormSet.frmStockLst.grdStockLst.Visible = .T.
				ThisFormSet.frmStockLst.Visible = .T.
				ThisFormSet.RefreshStockStatus()
				ThisFormSet.frmStockStatus.Visible = .T.
		
				ThisFormSet.frmStockLst.grdStockLst.Refresh
				ThisFormSet.frmStockLst.grdStockLst.SetFocus()
			ELSE
				MESSAGEBOX("ID_Detail was not found in vStockLst_SQL",48,"No ID_Detail find")
			ENDIF
		ELSE
			MESSAGEBOX( "No ID_Detail was not found in ThisFormSet.Stocklst_ID_Detail",48,"No ThisFormSet.Stocklst_ID_Detail" )
		ENDIF
		
		RETURN
		**************
		
		PRIVATE nSalesNum, nItem, cSOitem, nQTY
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		nQTY		= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.Qty1.Value ,'S_QTY ',-5)
		IF nQTY = 0
			nQTY		= PrepareSQLnum(ThisFormSet.frmStockLstProcesses.pWeight1.Value ,'S_QTY ',-5)
		ENDIF
		
		
		PRIVATE cSQL
		cSQL = "SELECT Alloy, Form, CC, CL "
		cSQL = cSQL + ",Size,Dim1,Dim2,Dim3,PC,Weight,S_QTY,RandLen "
		cSQL = cSQL + ",Heat,Lot "
		cSQL = cSQL + ",P.QTY, P.Pounds, P.PO_item "
		DO CASE 
		CASE cTBL = "S"
			cSQL = cSQL + ",StockLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.StockLst_Detail "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master ON StockLst_Master.ID = StockLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.StockLst_Process P ON StockLst_Detail.ID_Detail = P.ID_Detail "
		CASE cTBL = "B"
			cSQL = cSQL + ",BrokerLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail ON BrokerLst_Detail.ID_Detail = BrokerLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master ON BrokerLst_Master.ID = BrokerLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.BrokerLst_Process P ON BrokerLst_Detail.ID_Detail = P.ID_Detail "
		CASE cTBL = "W"
			cSQL = cSQL + ",WIPLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.WIPLst_Detail ON WIPLst_Detail.ID_Detail = WIPLst_Process.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master ON WIPLst_Master.ID = WIPLst_Detail.ID "
			cSQL = cSQL + " LEFT OUTER JOIN dbo.WIPLst_Process P ON WIPLst_Detail.ID_Detail = P.ID_Detail "
		ENDCASE
		
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				
				PRIVATE cAlloy, cForm, nThck, cCC, cCL
				cAlloy = PrepareSQLtxt(tmpProcess2.Alloy,'Alloy',12,.T.)
				cForm  = Proper_Form(PrepareSQLtxt(tmpProcess2.Form,'Form',2,.T.))
				cCC	   = PrepareSQLtxt(tmpProcess2.CC,'CC',1)
				cCL	   = PrepareSQLtxt(tmpProcess2.CL,'CL',1)
				
				PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL, cPO_item
				nThck	= PrepareSQLnum(tmpProcess2.Dim1,'Thck',9,3)
				nSz2	= PrepareSQLnum(tmpProcess2.Dim2,'Sz2',9,3)
				nSz3	= PrepareSQLnum(tmpProcess2.Dim3,'Sz3',9,3)
				nPC		= PrepareSQLnum(tmpProcess2.PC,'PC',-3)
				nLBS	= PrepareSQLnum(tmpProcess2.Weight,'Weight',7,1)
				lRL		= PrepareSQLlogic(tmpProcess2.RandLen,'RandLen')
				cPO_item= PrepareSQLtxt(tmpProcess2.PO_item,'PO_item',12)
				
				PRIVATE cHeatLot
				cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpProcess2.Heat)+" "+ALLTRIM(tmpProcess2.Lot),'HeatLot',60)
						
				PRIVATE nSalesNum
				nSalesNum = nID_Detail  &&"Browse_ID_Detail"
				
				PRIVATE pID_Detail		
				pID_Detail = nID_Detail 
				
				USE IN tmpProcess2
				
			 	ThisFormSet.VisibleForms()
			 	ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
									
				DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE_ID_Detail",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPO_item TO pID_Detail
				*		pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem TO ID_Detail
				
				ThisFormSet.VisibleFormsReset()
				
			ENDIF
			IF USED("tmpProcess2")
				USE IN tmpProcess2
			ENDIF
		ELSE
			MESSAGEBOX("Did not Selected material beloning to ID_Detail = "+STR(nID_Detail),16,"Did not Find!")
			TrackError("Wrong ID_Detail.","No Selected material beloning to ID_Detail = "+STR(nID_Detail)+" TBL:"+cTBL,"frmShop_StockLst_Edit.ShowStockLst_ID_Detail",LINENO())
		ENDIF
		
		
	ENDPROC

	PROCEDURE showstocklst_id_detail_process
		*ThisFormSet.ShowStockLst_ID_Detail_Process()
		
		PRIVATE nID, nID_Detail, cTBL, nID_Detail_Process
		nID			= PrepareSQLnum( ThisFormSet.Stocklst_ID,'ID',-3)
		nID_Detail	= PrepareSQLnum( ThisFormSet.Stocklst_ID_Detail,'ID_Detail',-3)
		cTBL		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		nID_Detail_Process	= PrepareSQLnum(ThisFormSet.ID_Detail_Process,'ID_Detail_Process',-3)
		
		***********
		PRIVATE nGetID_Detail
		nGetID_Detail = 0
		
		IF nID_Detail_Process > 0
			*Get ID_Detail from nID_Detail_Process 
			nGetID_Detail = GetID_Detail_With_ID_Detail_Process( nID_Detail_Process, cTBL, ThisFormSet.nConnhandle )
		ENDIF
		
		IF nGetID_Detail > 0
			
			SELECT vStockLst_SQL
			LOCATE FOR ID_Detail = nGetID_Detail
			
			IF FOUND('vStockLst_SQL')
				
				ThisFormSet.frmStockLst.grdStockLst.Visible = .T.
				ThisFormSet.frmStockLst.Visible = .T.
				ThisFormSet.RefreshStockStatus()
				ThisFormSet.frmStockStatus.Visible = .T.
		
				ThisFormSet.frmStockLst.grdStockLst.Refresh
				ThisFormSet.frmStockLst.grdStockLst.SetFocus()
			ELSE
				MESSAGEBOX("ID_Detail_Process was not found in vStockLst_SQL",48,"No ID_Detail_Process find")
			ENDIF
		ELSE
			MESSAGEBOX( "No ID_Detail_Process was not found in ThisFormSet.Stocklst_ID_Detail_Process",48,"No ThisFormSet.Stocklst_ID_Detail_Process" )
		ENDIF
		
		RETURN
		**************
		
		PRIVATE nSalesNum, nItem, cSOitem
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		
		
		PRIVATE cSQL
		cSQL = "SELECT Alloy, Form, CC, CL "
		cSQL = cSQL + ",Size,Dim1,Dim2,Dim3,PC,Weight,S_QTY,RandLen "
		cSQL = cSQL + ",Heat,Lot "
		cSQL = cSQL + ",P.QTY, P.Pounds, P.PO_item "
		DO CASE 
		CASE cTBL = "S"
			cSQL = cSQL + ",StockLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.StockLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail ON StockLst_Detail.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master ON StockLst_Master.ID = StockLst_Detail.ID "
		CASE cTBL = "B"
			cSQL = cSQL + ",BrokerLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.BrokerLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail ON BrokerLst_Detail.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master ON BrokerLst_Master.ID = BrokerLst_Detail.ID "
		CASE cTBL = "W"
			cSQL = cSQL + ",WIPLst_Detail.ID_Detail "
			cSQL = cSQL + " FROM dbo.WIPLst_Process P "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Detail ON WIPLst_Detail.ID_Detail = P.ID_Detail "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master ON WIPLst_Master.ID = WIPLst_Detail.ID "
		ENDCASE
		
		cSQL = cSQL + " WHERE P.ID_Detail_Process = "+STR(nID_Detail_Process)
		
		IF USED("tmpProcess2")
			SELECT tmpProcess2
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpProcess2')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess2')
		ENDIF
		IF USED('tmpProcess2')
			IF RECCOUNT('tmpProcess2') > 0
				
				PRIVATE cAlloy, cForm, nThck, cCC, cCL
				cAlloy = PrepareSQLtxt(tmpProcess2.Alloy,'Alloy',12,.T.)
				cForm  = Proper_Form(PrepareSQLtxt(tmpProcess2.Form,'Form',2,.T.))
				cCC	   = PrepareSQLtxt(tmpProcess2.CC,'CC',1)
				cCL	   = PrepareSQLtxt(tmpProcess2.CL,'CL',1)
				
				PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL, cPO_item, nQTY
				nThck	= PrepareSQLnum(tmpProcess2.Dim1,'Thck',9,3)
				nSz2	= PrepareSQLnum(tmpProcess2.Dim2,'Sz2',9,3)
				nSz3	= PrepareSQLnum(tmpProcess2.Dim3,'Sz3',9,3)
				nPC		= PrepareSQLnum(tmpProcess2.PC,'PC',-3)
				nLBS	= PrepareSQLnum(tmpProcess2.Weight,'Weight',7,1)
				lRL		= PrepareSQLlogic(tmpProcess2.RandLen,'RandLen')
				cPO_item = PrepareSQLtxt(tmpProcess2.PO_item,'PO_item',12)	&& holds Process POitem 
		
				nQTY	= PrepareSQLnum(tmpProcess2.QTY ,'QTY',-5)
				IF nQTY = 0
					nQTY	= PrepareSQLnum(tmpProcess2.Pounds,'QTY',-5)
				ENDIF
				IF nQTY = 0
					nQTY	= PrepareSQLnum(tmpProcess2.S_QTY,'QTY',-5)
				ENDIF
				
				PRIVATE cHeatLot
				cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpProcess2.Heat)+" "+ALLTRIM(tmpProcess2.Lot),'HeatLot',60)
									
				PRIVATE nSalesNum
				nSalesNum = nID_Detail  &&"Browse_ID_Detail"
				
				PRIVATE pID_Detail		
				pID_Detail = nID_Detail  
			
				USE IN tmpProcess2
				
			 	ThisFormSet.VisibleForms()
			 	ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
									
				DO FORM Forms\StockLst_SQL_Quotes WITH "BROWSE_ID_Detail",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPO_item TO pID_Detail
				*		pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem TO ID_Detail
		
				ThisFormSet.VisibleFormsReset()
				
			ENDIF
			IF USED("tmpProcess2")
				USE IN tmpProcess2
			ENDIF	
		ELSE
			MESSAGEBOX("Did not Selected material beloning to ID_Detail_Process = "+STR(nID_Detail_Process),16,"Did not Find!")
			TrackError("Wrong ID_Detail_Process.","No Selected material beloning to ID_Detail_Process = "+STR(nID_Detail_Process)+" TBL:"+cTBL,"frmShop_StockLst_Edit.Modify_StockLst_Detail_Report",LINENO())
		ENDIF
		
		
	ENDPROC

	PROCEDURE stocklstprocesses		&& StockLst Processes
		PARAMETER pID, pType, pWhat
		*THISFORMSET.StockLstProcesses(pID, pType, pWhat)
		*pID_Detail,"ID_DETAIL","CORRECTION"
		*0,'',"SHOW"
		*nID_Detail, "ID_DETAIL", "INCOMING"
		*THISFORMSET.StockLstProcesses(nID_Detail, "ID_DETAIL", "SHOW")
		
		*Use THISFORMSET.Processes() to Just show the Process' on StockLst, NO "CORRECTION"
		
		PRIVATE nID, cType, cWhat
		nID		= PrepareSQLnum(pID,'ID',-3)
		cType	= UPPER(PrepareSQLtxt(pType,'Type',15))
		cWhat	= UPPER(PrepareSQLtxt(pWhat,'What',15))
		
		
		
		THISFORMSET.frmStockLstProcesses.VISIBLE = .F.
		
		PRIVATE nID_Detail_Process, nID_Detail, lhaveID_Detail 
		nID_Detail = 0
		lHaveID_Detail = .F.
		
		IF pType = "ID_DETAIL"
			IF pID_Detail > 0
				nID_Detail = nID
				lhaveID_Detail = .T.
			ELSE
				nID_Detail = 0
				lHaveID_Detail = .F.
			ENDIF
		ENDIF
		
		IF NOT USED('tmpSO')
			MESSAGEBOX("Cannot Show Processes without a Sales Order \ Work Order!",0+16,'No SO or WO!')
			RETURN .F.
		ENDIF
		
		PRIVATE cSOitem, nWO, cSQLp 
		cSOitem = Proper_SO_Item(tmpSO.SOitem)
		nWO = PrepareSQLnum(tmpSO.WO,'WO',-3)
		cSQLp = ''
		
		IF USED("tmpProcess")
			USE IN tmpProcess
		ENDIF
		
		IF cWhat = "CORRECTION"
			*a Process without an Order!
			IF nID_Detail > 0
				cSQLp = "SELECT *, 'S' AS Tbl FROM dbo.StockLst_Process WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))+" AND Process_ID = 'CORRECTION' AND WO=0"
				IF nWO > 0
					cSQLp = cSQLp +" UNION "
					cSQLp = cSQLp + "SELECT *, 'S' AS Tbl FROM dbo.StockLst_Process WHERE WO = "+ALLTRIM(STR(nWO))+" AND Process_ID = 'CORRECTION'"
				ENDIF
			ELSE
				IF nWO > 0
					cSQLp = "SELECT *, 'S' AS Tbl FROM dbo.StockLst_Process WHERE WO = "+ALLTRIM(STR(nWO))+" AND Process_ID = 'CORRECTION'"
				ELSE
					MESSAGEBOX("No Process Found"+CHR(13)+"Select stock to make a process!",64,"No Process")
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			*cWhat = "SHOW"
			
			*StockSide
			IF Proper_SO_item(cSOitem)!= Proper_SO_item('')
				cSQLp = "SELECT *, 'S' AS Tbl FROM dbo.StockLst_Process WHERE SOitem = dbo.f_ProperSOitem('" + cSOitem + "') AND WO=0"
			ENDIF
			
			IF nWO > 0
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = "SELECT *, 'S' AS Tbl FROM dbo.StockLst_Process WHERE WO="+STR(nWO)
			ENDIF
			
			IF nID_Detail > 0
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = "SELECT *, 'S' AS Tbl FROM dbo.StockLst_Process WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
			ENDIF
			
			*Broker Side
			IF Proper_SO_item(cSOitem)!= Proper_SO_item('')
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = cSQLp +"SELECT *, 'B' AS Tbl FROM dbo.BrokerLst_Process WHERE SOitem = dbo.f_ProperSOitem('" + cSOitem + "') AND WO=0"
			ENDIF
			
			IF nWO > 0
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = cSQLp +"SELECT *, 'B' AS Tbl FROM dbo.BrokerLst_Process WHERE WO="+STR(nWO)
			ENDIF
			
			IF nID_Detail > 0
				IF NOT EMPTY(cSQLp)
					cSQLp = cSQLp +" UNION "	
				ENDIF
				cSQLp = cSQLp +"SELECT *, 'B' AS Tbl FROM dbo.BrokerLst_Process WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
			ENDIF
			
			IF NOT EMPTY(cSQLp)
				cSQLp = cSQLp +" ORDER BY Tbl DESC "
			ENDIF
		
			********
		ENDIF
		
		SELECT 0
		nSQLEXEC = SQLEXEC( THISFORMSET.nConnHandle, cSQLp, 'tmpProcess' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLp, 'tmpProcess' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError( cSQLp, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess' )
		ELSE
			IF USED('tmpProcess')
				IF RECCOUNT('tmpProcess') > 0
					*		SELECT tmpProcess
					nID_Detail_Process = PrepareSQLnum(tmpProcess.ID_Detail_Process,'ID_Detail_Process',-3)
		
					ThisFormSet.Stocklst_ID_Detail	= tmpProcess.ID_Detail
					ThisFormSet.StockLst_TBL		= tmpProcess.TBL
					ThisFormSet.ID_Detail_Process	= tmpProcess.ID_Detail_Process
					ThisFormSet.Stocklst_ID			= Get_ID_with_ID_Detail(tmpProcess.ID_Detail, tmpProcess.TBL, ThisFormSet.nConnHandle)
					ThisFormSet.Tbl_Process 		= tmpProcess.TBL
					
					IF !ThisFormSet.Check_ID_Detail_Process()
						*ThisFormSet.ID_Detail_Process was not found
						MESSAGEBOX("No Process Found"+CHR(13)+"Select stock to make a process!",64,"No Process")
						RETURN .F.
					ENDIF
				ELSE
					MESSAGEBOX("No Process Found"+CHR(13)+"Select stock to make a process!",64,"No Process")
					RETURN .F.
				ENDIF	
				**nID_Detail is Private localy, but overloaded
			ELSE
				MESSAGEBOX("No Process Found"+CHR(13)+"Select stock to make a process!",64,"No Process")
				RETURN .F.
			ENDIF	
		ENDIF
		
		
		IF USED("tmpProcess")
			IF RECCOUNT("tmpProcess") > 0
				SELECT tmpProcess
				
				
				THISFORMSET.frmStockLstProcesses.VISIBLE = .T.
				
				ThisFormSet.RefreshStockLstProcesses()
				
		
				*ThisFormset.frmStockLstProcesses.cmdProcess.Visible = .F.
				*ThisFormset.frmStockLstProcesses.cmdRemoveProcess.Visible = .F.
				
				ThisFormSet.IsProcess_of_SO()
		
				THISFORMSET.frmStockLstProcesses.VISIBLE = .T.
				
				ThisFormSet.ID_Detail_Process = tmpProcess.ID_Detail_process
				ThisFormSet.Tbl_Process = tmpProcess.Tbl
				
			ELSE  
				*No records
				*Check to see if done!
				IF tmpSO.Cmplt OR (!tmpSO.prcP AND tmpSO.prcD )
					IF MESSAGEBOX("No Process left for this SalesOrder Item"+CHR(13)+CHR(13)+;
					  "This SO item is marked as 'COMPLETE'"+CHR(13)+CHR(13)+;
					  "Do you want to 'ADD' a new process to this item?"+CHR(13)+CHR(13)+"If (Yes), find stock and click"+CHR(13)+"'Mark Current Record For This Order'",4+32+256,"No Process... Complete!") = 6
					  
						IF ThisFormSet.frmStockStatus.Visible 
							ThisFormSet.frmStockStatus.Visible = .F.
							ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
							ThisFormSet.frmSimiliarSales.Visible = .F.
						ENDIF
						ThisFormset.frmShop_StockLst_Edit.cmdInv.Click
					ELSE
						*IF MESSAGEBOX("Do you still want try to see the StockLst now?",4+48,"This is not a Process for this SO.")=6
						*	*Show Stock
						*	ThisFormSet.frmStockLst.Visible = .T.
						*ELSE
						*	*Just Show Process'
						*	*THISFORMSET.Processes(pID_Detail)  &&cannot Show for 0
						*ENDIF
					ENDIF
				ELSE
					IF pID_Detail > 0
						IF MESSAGEBOX("No Process for this SO Item"+CHR(13)+;
						  "Select from StockLst, Mark to create a process! "+CHR(13)+" or just Double Click stock."+CHR(13)+;
						  "'Inventory Corrections' can be made to StockLst."+;
						  CHR(13)+CHR(13)+"Do you still want to TRY to see the StockLst process now?"+CHR(13)+;
						  "Answer No to start to make a stockLst process.",4+48,+;
						  "Select stock then create a process.") = 6
						  
						  *Show Process anyways
						  THISFORMSET.Processes(pID_Detail)
						  
						ELSE  
							IF ThisFormSet.frmStockStatus.Visible 
								ThisFormSet.frmStockStatus.Visible = .F.
								ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
								ThisFormSet.frmSimiliarSales.Visible = .F.
							ENDIF
							ThisFormset.frmShop_StockLst_Edit.cmdInv.Click
						ENDIF
					ELSE  &&Not not ask when ID_Detail is 0
						MESSAGEBOX("No Process for this SO Item"+CHR(13)+;
						  "Select from StockLst, Mark to create a process! "+CHR(13)+" or just Double Click stock."+CHR(13)+;
						  "'Inventory Corrections' can be made to StockLst.",0+48,"Select stock then create a process.")
					
						IF ThisFormSet.frmStockStatus.Visible 
							ThisFormSet.frmStockStatus.Visible = .F.
							ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
							ThisFormSet.frmSimiliarSales.Visible = .F.
						ENDIF
						ThisFormset.frmShop_StockLst_Edit.cmdInv.Click
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE stocklst_dynbc_po
	ENDPROC

	PROCEDURE stocklst_process_del_correction
		PARAMETER pID, pID_Detail
		*ThisFormSet.StockLst_Process_DEL_Correction()
		
		PRIVATE nID_Detail_OLD, nStockLst_Detail_SOitem,cSOitem
		nID_Detail_OLD = 0
		nStockLst_Detail_SOitem = 0
		cSOitem = PrepareSQLtxt(tmpSO.SOitem,'SOitem',10)
		
		PRIVATE cSQLn, cSQLd, nSQLEXEC, nAns, cTBL, cTable
		DO CASE
		CASE ThisFormSet.StockLst_TBL = 'B'
			cTBL = "B"
			cTable = "BrokerLst"
		CASE ThisFormSet.StockLst_TBL = 'S'
			cTBL = "S"
			cTable = "StockLst "
		CASE ThisFormSet.StockLst_TBL = 'W'
			cTBL = "W"
			cTable = "WIPLst "
		OTHERWISE
			MESSAGEBOX("StockLst_Process_DEL_Correction did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("StockLst_Process_DEL_Correction did not recognize Table Name","StockLst_Process_DEL_Correction did not recognize Table Name","frmShop_StockLst_Edit.StockLst_Process_DEL_Correction",LINENO())
			RETURN .F.	
		ENDCASE
		
		***********
		*check to see if a Correction Process is for this SOitem
		cSQLn = "SELECT COUNT(*) AS counted FROM "
		DO CASE
		CASE cTBL = "S"
			cSQLn = cSQLn + " dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQLn = cSQLn + " dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQLn = cSQLn + " dbo.WIPLst_Process "
		ENDCASE
		cSQLn = cSQLn + " WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+" AND Process_ID = 'CORRECTION'"
		IF USED("StockLst_Detail_Count")
			SELECT StockLst_Detail_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQLn, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Detail_Count')
			*Just Create a new Process
			*THISFORMSET.Create_StockLst_Process(pID,pID_Detail,"",cTBL)
		ENDIF
		IF USED('StockLst_Detail_Count')
			IF StockLst_Detail_Count.Counted > 0
				IF pType = "CORRECTION"
					*Found a Correction Process
		
					nAns = MESSAGEBOX("The "+IIF(cTbl = "S",'StockLst',IIF(cTBL="B",'BrokerLst','WIPLst'))+" Detail has already been marked for a Correction Process."+CHR(13)+;
					"Do want to remove this Correction Process? (Y)"+CHR(13)+CHR(13)+;
					"Answer 'Yes' to remove this Correction Process."+CHR(13)+;
					"Answer 'No' to edit the Correction Process."+CHR(13)+;
					"or 'Cancel'.",3+32,"Found Correction Process.")
					
					IF nAns = 6 &&Yes
						*Remove old Process
						DO CASE
						CASE cTBL = "S"
							cSQLd = "DELETE FROM dbo.StockLst_Process  WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+" AND Process_ID = 'CORRECTION'"
						CASE cTBL = "B"
							cSQLd = "DELETE FROM dbo.BrokerLst_Process  WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+" AND Process_ID = 'CORRECTION'"
						CASE cTBL = "W"
							cSQLd = "DELETE FROM dbo.WIPLst_Process  WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+" AND Process_ID = 'CORRECTION'"
						ENDCASE
						
						nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
						ENDDO
						IF nSQLEXEC < 0
							*Could not Delete
							SQLEXECError(cSQLd, ThisFormSet.nConnHandle, nSQLEXEC, '')
						ELSE
							*Update History with 'SUBED'
							cSQLd = "UPDATE HPAlloy_Archive.dbo."+IIF(cTBL = "S","StockLst","BrokerLst")+"_Process_History SET [WHAT]='SUBED' WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))+ " AND [What] = 'DELETE' "+" AND Process_ID = 'CORRECTION'"
							nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLd, ThisFormSet.nConnHandle, nSQLEXEC, '')
							ENDIF
							
							THISFORMSET.frmStockLstProcesses.Visible = .F.
							THISFORMSET.frmModiProcess.Visible = .F.
							
							ThisFormSet.RefreshTmpQuotes()
							ThisFormSet.StockLst_ID_Detail = pID_Detail
							*ThisFormSet.RefreshStockLst("RELOAD")
							
							WAIT WINDOW "DELETED Correction process." NOWAIT
						ENDIF
					ENDIF
					IF nAns = 7
						*Just Show Process
						THISFORMSET.StockLstProcesses(pID_Detail,"ID_Detail","CORRECTION")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE sumprocess
		*ThisFormSet.SumProcess()
		PRIVATE nID_DetailS_QTY, nSOS_QTY, nWOS_QTY
		nID_DetailS_QTY = 0
		nSOS_QTY = 0
		nWOS_QTY = 0
		
		PRIVATE nSOitemQTY, nSOiSelQTY, nWOQTY, nPartSelect_QTY 
		nSOitemQTY = 0
		nSOiSelQTY = 0
		nWOQTY = 0
		nPartSelect_QTY = 0
		
		PRIVATE nID_Detail,cSOitem,nWO,nQTY, cTBL
		nID_Detail = PrepareSQLnum(ThisFormSet.frmModiProcess.ID_Detail1.Value,'ID_Detail',-3)
		cSOitem	= PrepareSQLtxt(ThisFormSet.frmModiProcess.SOitem1.Value,'SOitem',10)
		nWO =  PrepareSQLnum(ThisFormSet.frmModiProcess.WO1.Value,'WO',-3)
		nQTY = PrepareSQLnum(ThisFormSet.frmModiProcess.QTY1.Value,'StockLst_QTY',-5)
		IF THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
			cTBL = 'S'
		ELSE
			cTBL = 'B'
		ENDIF
		
		
		***
		IF USED("cntStockQty")
			USE IN cntStockQty
		ENDIF
		
		DO CASE
		CASE cTBL = "S"
			cSQL = "SELECT S_QTY FROM dbo.StockLst_Detail "
		CASE cTBL = "B"
			cSQL = "SELECT S_QTY FROM dbo.BrokerLst_Detail "
		CASE cTBL = "W"
			cSQL = "SELECT S_QTY FROM dbo.WIPLst_Detail "
		OTHERWISE
			MESSAGEBOX("SumProcess did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("SumProcess did not recognize Table Name","SumProcess did not recognize Table Name","frmShop_StockLst_Edit.SumProcess",LINENO())
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail = "+STR(nID_Detail)+""
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
		ENDDO
		
		IF nSQLEXEC < 1
			SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
		ELSE
			IF USED('cntStockQty')
				IF RECCOUNT('cntStockQty') > 0
					nID_DetailS_QTY = cntStockQty.S_QTY
				ENDIF
				USE IN cntStockQty
			ENDIF
		ENDIF
		
		***
		IF cSOitem	!= Proper_SO_Item('')
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
			
			cSQL = "SELECT SUM(D.S_QTY) AS S_QTY FROM "
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
			OTHERWISE
				MESSAGEBOX("SumProcess did not recognize Table Name",0+16,"Aborting Save!")
				TrackError("SumProcessdid not recognize Table Name","SumProcessdid not recognize Table Name","frmShop_StockLst_Edit.SumProcess",LINENO())
				RETURN .F.
			ENDCASE
			cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
		
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nSOS_QTY = cntStockQty.S_QTY
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		IF nWO > 0
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
			
			cSQL = "SELECT SUM(D.S_QTY) AS S_QTY FROM "
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
			OTHERWISE
				MESSAGEBOX("SumProcess did not recognize Table Name",0+16,"Aborting Save!")
				TrackError("SumProcess did not recognize Table Name","SumProcess did not recognize Table Name","frmShop_StockLst_Edit.SumProcess ",LINENO())
				RETURN .F.
			ENDCASE
			
			IF cSOitem	!= Proper_SO_Item('')
				cSQL = cSQL + " WHERE NOT P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID = 'PARTSELECT' )"
			ELSE
				IF nWO > 0
					cSQL = cSQL + " WHERE P.WO = "+STR(nWO)+""
					cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID = 'PARTSELECT' )"
				ELSE
					cSQL =  'SELECT 0 AS S_QTY'
					*cSQL = cSQL + " WHERE Process_ID = 'SELECTED'"
				ENDIF
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
		
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nWOS_QTY = cntStockQty.S_QTY
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		IF cSOitem	!= Proper_SO_Item('')
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
		
			cSQL = "SELECT Quoted_QTY FROM dbo.Sales "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
		
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nSOitemQTY = cntStockQty.Quoted_QTY
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		
		
		***
		
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
			
			cSQL = "SELECT SUM(S_QTY) AS S_QTY FROM "
			DO CASE
			CASE cTBL = "S"
				cSQL = cSQL + " dbo.StockLst_Detail D "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "B"
				cSQL = cSQL + " dbo.BrokerLst_Detail D  "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Process P ON D.ID_Detail = P.ID_Detail "
			CASE cTBL = "W"
				cSQL = cSQL + " dbo.WIPLst_Detail D  "
				cSQL = cSQL + " INNER JOIN dbo.WIPLst_Process P ON D.ID_Detail = P.ID_Detail "
			OTHERWISE
				MESSAGEBOX("SumProcess did not recognize Table Name",0+16,"Aborting Save!")
				TrackError("SumProcess did not recognize Table Name","SumProcess did not recognize Table Name","frmShop_StockLst_Edit.SumProcess ",LINENO())
				RETURN .F.
			ENDCASE
			
			cSQL = cSQL + " WHERE P.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL + " AND ( P.Process_ID = 'SELECTED' OR P.Process_ID = 'PARTSELECT' )"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
		
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nSOiSelQTY = cntStockQty.S_QTY
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		
		***
		IF nWO > 0
			IF USED("cntStockQty")
				USE IN cntStockQty
			ENDIF
		
			cSQL = "SELECT sWeight FROM dbo.WorkOrder "
			cSQL = cSQL + " WHERE WO = "+STR(nWO)
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
			ENDDO
		
			IF nSQLEXEC < 1
				SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
			ELSE
				IF USED('cntStockQty')
					IF RECCOUNT('cntStockQty') > 0
						nWOQTY = cntStockQty.sWeight
					ENDIF
					USE IN cntStockQty
				ENDIF
			ENDIF
		ENDIF
		***
		IF USED("cntStockQty")
			USE IN cntStockQty
		ENDIF
		
		cSQL = "SELECT QTY FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		OTHERWISE
			MESSAGEBOX("RefreshStockStatus did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("RefreshStockStatus did not recognize Table Name","RefreshStockStatus did not recognize Table Name","frmShop_StockLst_Edit.RefreshStockStatus",LINENO())
			RETURN .F.
		ENDCASE
		
		IF nWO > 0	
			cSQL = cSQL + " WHERE WO = "+STR(nWO)+""
			cSQL = cSQL + " AND Process_ID = 'PARTSELECT'"
		ELSE
			IF cSOitem	!= Proper_SO_Item('')
				cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL + " AND Process_ID = 'PARTSELECT'"
			ELSE
				*No WO or SOitem
				cSQL = "SELECT 0 AS QTY"
			ENDIF
		ENDIF
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'cntStockQty')
		ENDDO
		
		IF nSQLEXEC < 1
			SQLExecError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'cntStockQty')
		ELSE
			IF USED('cntStockQty')
				IF RECCOUNT('cntStockQty') > 0
					nPartSelect_QTY = cntStockQty.QTY
				ENDIF
				USE IN cntStockQty
			ENDIF
		ENDIF
		
		***
		
		
		ThisFormSet.frmModiProcess.txtSOitemQTY.Value = nSOitemQTY
		ThisFormSet.frmModiProcess.txtSOS_QTY.Value = nSOS_QTY
		
		ThisformSet.frmModiProcess.txtWOQTY.Value = nWOQTY 
		ThisFormSet.frmModiProcess.txtWOS_QTY.Value = nWOS_QTY
		
		ThisFormSet.frmModiProcess.txtID_DetailS_QTY.Value = nID_DetailS_QTY
		
		IF nID_DetailS_QTY > nQTY 
			ThisFormSet.frmModiProcess.txtID_DetailS_QTY.DisabledForeColor = RGB(255,0,0)
		ENDIF
		
		ThisFormSet.frmModiProcess.txtPPbalance.Value = nPartSelect_QTY 
		
		
	ENDPROC

	PROCEDURE Unload
		IF ThisFormSet.CloseSales 
			IF USED("Sales")
				USE IN Sales
			ENDIF
		ENDIF
		
		IF USED("tmpProcess")
			USE IN tmpProcess 
		ENDIF
		IF USED("tmpSO")
			USE IN tmpSO
		ENDIF
		IF USED("tmpQuotes")
			USE IN tmpQuotes
		ENDIF
		
		
		= SQLDISCONNECT( ThisFormSet.nConnHandle )
		
		
	ENDPROC

