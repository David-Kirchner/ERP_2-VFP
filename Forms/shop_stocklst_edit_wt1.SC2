	PROCEDURE remove_id_detail_process
		PARAMETER pID_Detail_Process, pSOitem, pTbl
		*Remove_ID_Detail_Process(m.ID_Detail_Process,cSOitem,cTbl,cWhat)
		*Also used in WorkOrder
		
		PRIVATE cSQLd, nSQLEXEC, nID_Detail_Process
		PRIVATE cSOitem, cTbl
		
		IF TYPE("pSOitem") = "C"
			cSOitem = pSOitem
		ELSE
			IF NOT EMPTY(tmpSO.SOitem)
				cSOitem = tmpSO.SOitem
			ELSE
				cSOitem = " "
			ENDIF
		ENDIF
		
		IF TYPE("pTbl") = "C"
			cTbl = pTbl
		ELSE
			cTbl = ''
		ENDIF
		*IF EMPTY(cTbl) OR cTBL = ""
		*	cTbl = 'S'
		*ENDIF
		
		IF NOT ( cTBL = "S" OR cTBL = "B" OR cTBL = "W" )
			MESSAGEBOX("Remove_ID_Detail_Process did not recognize Table Name",0+16,"Aborting Remove_ID_Detail_Process!")
			TrackError("Remove_ID_Detail_Process did not recognize Table Name","Remove_ID_Detail_Process did not recognize Table Name '"+cTBL+"'.","frmShop_StockLst_Edit.Remove_ID_Detail_Process",LINENO())
			RETURN .F.
		ENDIF
		
		IF VARTYPE(cWhat) != "C"
			cWhat = ""
		ENDIF
		
		
		IF TYPE("pID_Detail_Process") = "N"
			nID_Detail_Process = pID_Detail_Process
		
			IF Remove_ID_Detail_Process(nID_Detail_Process, cSOitem, cTbl, ThisFormSet.nConnHandle, cWhat)
				IF NOT EMPTY(ThisFormSet.ID_Detail_Process_Name)
					HIDE WINDOW (ThisFormSet.ID_Detail_Process_Name)
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX("Function: Remove_ID_Detail_Process()"+CHR(13)+"No pID_Detail_Process, pSOitem or pTbl Parameter!",0,"Error")
			\Progs\ErrorHandlerlog(0,"No pID_Detail_Process, pSOitem or pTbl Parameter","No pID_Detail_Process, pSOitem or pTbl Parameter","frmShop_StockLst_Edit.Remove_ID_Detail_Process",LINENO())
		ENDIF
	ENDPROC

	PROCEDURE reportamendmentver
		*ThisFormSet.ReportAmendmentVer()
		
		PRIVATE nWO, nSO
		nWO	= PrepareSQLnum(ThisFormSet.nWorkOrder,'WO',-3)
		nSO	= PrepareSQLnum(ThisFormSet.SalesNum,'SO',-3)
		
		PRIVATE cSQL 
		cSQL = ''
		
		IF USED('tmpSO_NoAmend')
			SELECT tmpSO_NoAmend
		ELSE
			SELECT 0
		ENDIF
		IF nSO>0
			cSQL = "SELECT Amendment "
			cSQL = cSQL + " FROM dbo.Sales_No WHERE SalesNum ="+ALLTRIM(STR(nSO))
		ENDIF
		IF nWO>0
			cSQL = "SELECT MAX(fRev) AS Amendment  "
			cSQL = cSQL + " FROM dbo.WorkOrder_Detail WHERE WO ="+ALLTRIM(STR(nWO))
		ENDIF
		
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_NoAmend')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpSO_NoAmend')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpSO_NoAmend')
		ENDIF
		
		PRIVATE nAmendment
		nAmendment = 0
		IF USED('tmpSO_NoAmend')
			IF ISNULL(tmpSO_NoAmend.Amendment)
				nAmendment = 0
			ELSE
				nAmendment = PrepareSQLnum(tmpSO_NoAmend.Amendment,'Amendment',-1)
				IF nSO>0
					ThisFormSet.frmShop_StockLst_Edit.lblAmendment.Caption = ALLTRIM(STR(nAmendment))
					IF nAmendment > 1
						MESSAGEBOX("The current SO Version is "+ALLTRIM(STR(nAmendment))+"."+CHR(13)+"Make sure you have the correct SO paper work version.",32,"Check Version")
					ENDIF
				ENDIF
				IF nWO>0
					ThisFormSet.frmShop_StockLst_Edit.lblAmendment.Caption = ALLTRIM(STR(nAmendment))
					IF nAmendment > 1
						MESSAGEBOX("The current WO Version is "+ALLTRIM(STR(nAmendment))+"."+CHR(13)+"Make sure you have the correct WO paper work version.",32,"Check Version")
					ENDIF
				ENDIF
				
			ENDIF
			USE IN tmpSO_NoAmend	
		ENDIF
		
	ENDPROC

