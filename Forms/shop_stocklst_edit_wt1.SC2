	PROCEDURE frmStockLst.grdStockLst.clmLot.txtLot.DblClick
		*ThisFormSet.Check_StockLst_Process(vStockLst_SQL.ID,vStockLst_SQL.ID_Detail)
		PRIVATE cLOT, lGFM
		cLOT = vStockLst_SQL.lot
		IF TYPE("cLot")= "C"
			cLot = UPPER( ALLTRIM( cLot ))
		ELSE
			cLot = ""
		ENDIF
		
		lGFM = .T.
		
		DO CASE
		CASE "HPAG" $ UPPER(cLot)
			lGFM = .T.
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		CASE "G" $ UPPER(cLot)
			lGFM = .T.
			cLot = RIGHT( cLot , LEN(cLot)-(AT("G",cLot)))
		CASE "HPAR" $ UPPER(cLot)
			lGFM = .F.
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		CASE "R" $ UPPER(cLot)
			lGFM = .F.
			cLot = RIGHT( cLot , LEN(cLot)-(AT("R",cLot)))
		ENDCASE
		
		
		IF lGFM
			IF VAL(cLOT) > 0
				DO FORM FORMS\ShowvGFMLog WITH INT( VAL(cLot) )
			ENDIF
		ELSE
			IF VAL(cLOT) > 0
				DO FORM FORMS\showvROLLlog.scx WITH INT( VAL(cLot) )
			ENDIF
		ENDIF
	ENDPROC

