	PROCEDURE frmStockLstProcesses.AllowSub1.Valid
		DO CASE
		CASE ISNULL(This.Value)
			RETURN .T.
		CASE EMPTY(This.Value)
			RETURN .T.
		CASE UPPER(This.Value) = "N"
			RETURN .T.
		CASE UPPER(This.Value) = "Y"
			RETURN .T.
		CASE UPPER(This.Value) = "T" 
			This.Value = "Y"
			RETURN .T.
		CASE UPPER(This.Value) = "F"
			This.Value = "N"
			RETURN .T.
		OTHERWISE		
			RETURN .F.
		ENDCASE
	ENDPROC

	PROCEDURE frmStockLstProcesses.cmdBackWard.Click
		PRIVATE lShowSTK
		lShowSTK = .F.
		
		SELECT tmpProcess
		IF !BOF("tmpProcess")
			SKIP -1 IN tmpProcess
			lShowSTK = .T.
		ENDIF
		IF BOF("tmpProcess")
			WAIT WINDOW 'Top of file' NOWAIT
			GO TOP IN tmpProcess
		ENDIF
		
		DO CASE 
		CASE tmpProcess.Tbl = "S"
			ThisForm.lblStockLstProcesses.Caption = "Stock List Processes"
			THISFORM.cmdShowStockLst.Enabled = .T.
			THISFORM.cmdProcess.Caption = "Modify Stock List"
			ThisForm.cmdShowStockLst.Caption = "Show Stock List"
			THISFORM.cmdEditStockLst.Enabled = .T.
		CASE tmpProcess.Tbl = "B"
			ThisForm.lblStockLstProcesses.Caption = "Broker List Prosesses"
			THISFORM.cmdShowStockLst.Enabled = .T.
			THISFORM.cmdProcess.Caption = "Modify Broker List"
			ThisForm.cmdShowStockLst.Caption = "Show Broker List"
			THISFORM.cmdEditStockLst.Enabled = .T.
		CASE tmpProcess.Tbl = "W"
			ThisForm.lblStockLstProcesses.Caption = "WIP List Prosesses"
			THISFORM.cmdShowStockLst.Enabled = .T.
			THISFORM.cmdProcess.Caption = "Modify WIP List"
			ThisForm.cmdShowStockLst.Caption = "Show WIP List"
			THISFORM.cmdEditStockLst.Enabled = .T.
		OTHERWISE
			TrackError("Missing Table","Table 'tmpProcess.TBL' was not Found.","frmShop_StockLst_Edit:frmStockLstProcesses.cmbBackWard.Click",LINENO())
		ENDCASE
		
		
		ThisFormSet.ID_Detail_Process = tmpProcess.ID_Detail_process
		ThisFormSet.Tbl_Process = tmpProcess.Tbl
		
		ThisFormSet.RefreshStockLstProcesses()
		
		ThisFormSet.IsProcess_of_SO()
		
		ThisForm.refresh
		THISFORMSET.frmStockLstProcesses.txtRec.Value = RECNO("tmpProcess")
		
		ThisFormSet.Check_ID_Detail_Process()
		
		
		ThisFormSet.frmStockStatus.Visible = .F.
		ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
		ThisFormSet.frmSimiliarSales.Visible = .F.
		*ThisFormSet.ShowStockLst()  &&Check to see if CONSUMED and finds next Best
		*ThisFormSet.ShowStockLst_ID_Detail_Process()
		
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.cmdEditStockLst.Click
		PRIVATE lShow
		lShow = .T.
		
		
		IF NOT lShow
			ThisFormSet.frmStockStatus.Visible = .F.
			ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
			ThisFormSet.frmSimiliarSales.Visible = .F.
			MESSAGEBOX("Could not Show StockLst",16,"No StockLst")
		ELSE
			ThisFormSet.ModifyStockLst()  &&Check to see if CONSUMED and finds next Best
			*ThisFormSet.ShowStockLst_ID_Detail_Process()
		ENDIF
		
	ENDPROC

