		*!*	ENDIF &&TYPE("pSOitem") = "C"
		*!*		
		*!*	IF USED("tmpDetail_Process_Report")
		*!*		USE IN tmpDetail_Process_Report
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE partialship_id_detail_process
		PARAMETERS pnID_Detail_Process, pnID_Detail, pSOitem, pcTbl, pConnHandle, pnWeightLeft, pnPCLeft, plAllowSub, pnPFT
		*PartialShip_ID_Detail_Process(nID_Detail_Process, nID_Detail,pSOitem,cTbl, nConnHandle, nWeightLeft, nPCLeft)	
		*ThisFormSet.PartialShip_ID_Detail_Process()
		
		*Reset current process to lesser value (to what was Shipped!)
		*Complete current process AS 'Shipped' 
		*create a new as 'PartSelect' process with balance values -Could not program!!!
		*"A New process with the remaining pcs will be created"+CHR(13)+"so the old process can be removed!"
		
		PRIVATE nID_Detail_Process
		IF VARTYPE(pnID_Detail_Process) = 'N'
			nID_Detail_Process = pnID_Detail_Process
		ELSE
			RETURN 0
		ENDIF
		
		PRIVATE nID_Detail
		IF VARTYPE(pnID_Detail) = 'N'
			nID_Detail= pnID_Detail
		ELSE
			RETURN 0
		ENDIF
		
		PRIVATE cSOitem
		IF TYPE("pSOitem") = "C"
			cSOitem = pSOitem
		ELSE
			cSOitem = " "
		ENDIF
		
		PRIVATE cTbl
		IF TYPE("pTbl") = "C"
			cTbl = pTbl
		ELSE
			cTbl = ''
		ENDIF
		IF EMPTY(cTbl) OR cTBL = ""
			cTbl = 'S'
		ENDIF
		
		
		PRIVATE nWeightLeft, nPCLeft, lAllowSub, nPFT
		IF VARTYPE(pnWeightLeft)="N" OR VARTYPE(pnWeightLeft) = "Y"
			nWeightLeft = pnWeightLeft
		ELSE
			nWeightLeft = 0
		ENDIF
		IF VARTYPE(pnPCLeft)="N" OR VARTYPE(pnPCLeft) = "Y"
			nPCLeft = pnPCLeft
		ELSE
			nPCLeft = 0
		ENDIF
		IF VARTYPE(pnPFT)="N" OR VARTYPE(pnPFT) = "Y"
			nPFT = pnPFT
		ELSE
			nPFT = 0
		ENDIF
		IF VARTYPE(plAllowSub)="L"
			lAllowSub = plAllowSub
		ELSE
			lAllowSub = .T.
		ENDIF
		 
		 
		 
		PRIVATE lNewConn, nConn
		lNewConn  =.F.
		IF VARTYPE(pConnHandle) = "N"
			IF pConnHandle > 0
				nConn = pConnHandle
			ELSE
				nConn = get_SQLSTRINGCONNECT()
				lNewConn = .T.
			ENDIF
		ELSE
			nConn= get_SQLSTRINGCONNECT()
			lNewConn = .T.
		ENDIF
		nConn = CheckSQLConnection(nConn)
		
		PRIVATE cAlias 
		cAlias = ALIAS()
		
		PRIVATE cSQL, nSQLEXEC
		**********************************************************************
		*Get nWeightShipped, nPCShipped before Deleteing
		*PRIVATE nWeightShipped, nPCShipped
		*nWeightShipped = 0
		*nPCShipped = 0
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		PRIVATE cSalesPerson,dStartDate,dDueDate,cPOitem,cProcess_ID,cProcessor,cComment
		cSQL = "SELECT SalesPerson,StartDate,DueDate,PO_item,Comment FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		OTHERWISE
			MESSAGEBOX("RefreshStockStatus did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("RefreshStockStatus did not recognize Table Name","RefreshStockStatus did not recognize Table Name","frmShop_StockLst_Edit.RefreshStockStatus",LINENO())
			RETURN .F.
		ENDCASE
		
		cSQL = cSQL + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		
		nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpID_Detail_Process")
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL, "tmpID_Detail_Process")
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, nConn, nSQLEXEC, "tmpID_Detail_Process")
		ELSE
			IF USED("tmpID_Detail_Process")
				IF RECCOUNT("tmpID_Detail_Process")>0
					cSalesPerson	= tmpID_Detail_Process.SalesPerson
					dStartDate		= tmpID_Detail_Process.StartDate
					dDueDate		= tmpID_Detail_Process.DueDate
					cPOitem			= tmpID_Detail_Process.PO_item 
					*cProcess_ID
					*cProcessor
					cComment		= tmpID_Detail_Process.Comment
				ENDIF
				USE IN tmpID_Detail_Process
			ENDIF
		ENDIF
		
		**********************************************************************
		*Remove_ID_Detail_Process(m.ID_Detail_Process,cSOitem,cTbl,cWhat)
		
		IF Remove_ID_Detail_Process(nID_Detail_Process, cSOitem, cTbl, ThisFormSet.nConnHandle, 'Sell Stock')
			IF NOT EMPTY(ThisFormSet.ID_Detail_Process_Name)
				HIDE WINDOW (ThisFormSet.ID_Detail_Process_Name)
			ENDIF
		ENDIF
		
		*************************************************************************
		*!*	PRIVATE cSQLd
		*!*	IF cTbl = 'S'
		*!*		cSQLd = "DELETE FROM dbo.StockLst_Process WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		*!*	ELSE
		*!*		cSQLd = "DELETE FROM dbo.BrokerLst_Process WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))
		*!*	ENDIF
		
		*!*	nSQLEXEC = SQLEXEC(nConn , cSQLd)
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(nConn , cSQLd)
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQLd, nConn , nSQLEXEC, '')
		*!*	ELSE
		
		*	WAIT WINDOW "Deleted Consumed Process!" NOWAIT
		
		*!*		**************************************************************************
		*!*		*Save new 'Balance Due' Process
		*!*		lAllowSub = .T.
		*!*		cProcess_ID = 'PartSelect'
		*!*		cProcessor = ""
		*!*		cComment = PrepareSQLtxt("Selected Stock was consumed, more stock is needed to finish:"+cComment,'Comment,100)
		*!*		
		*!*		IF cTbl ="B"
		*!*			cSQLi = "EXEC dbo.p_BrokerLst_Process_ins "
		*!*		ELSE
		*!*			cSQLi = "EXEC dbo.p_StockLst_Process_ins "
		*!*		ENDIF
		*!*		cSQLi = cSQLi + " @ID_Detail = "+STR(nID_Detail)+""
		*!*		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesperson+"'"
		*!*		cSQLi = cSQLi + ",@StartDate = '"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
		*!*		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		*!*		cSQLi = cSQLi + ",@AllowSub = 'Y'"
		*!*		cSQLi = cSQLi + ",@pWeight = "+STR(nWeightLeft,18,4)
		*!*		cSQLi = cSQLi + ",@pPc = "+STR(nPCLeft)
		*!*		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		*!*		cSQLi = cSQLi + ",@PO_Item = '"+cPOitem+"'"
		*!*		cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"
		*!*		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		*!*		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"	
		*!*		
		*!*		nSQLEXEC = SQLEXEC(nConn, cSQLi)
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(nConn, cSQLi)
		*!*		ENDDO
		*!*		IF nSQLEXEC < 0
		*!*			SQLEXECError(cSQLi, nConn, nSQLEXEC, '')
		*!*		ENDIF
		
		*	MESSAGEBOX("The Sales Order item is only partailly complete."+CHR(13)+"Please create a new process that would finish this order"+CHR(13)+"or have the SalesPerson order more material and then mark that PO as a process against it.",64,"Remember to enter the next process to complete this SOitem.")
			
		*ENDIF
		
		IF lNewConn 
			SQLDISCONNECT(nConn )
		ENDIF
		
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE processes		&& StockLst and BrokerLst Processes
		PARAMETER pID_Detail
		
		*THISFORMSET.Processes(ID_Detail)
		*Depricated
		*This Shows Process no mater what SO
		*Use StockLstProcesses() to Check by SO
		
		
		ThisFormSet.frmStockLstProcesses.VISIBLE = .F.
		
		PRIVATE nID_Detail_Process, nID_Detail, lHaveID_Detail
		lHaveID_Detail = .F.
		nID_Detail = 0
		
		IF TYPE("pID_Detail") = "N"
			IF pID_Detail > 0
				nID_Detail = pID_Detail
				lHaveID_Detail = .T.
			ENDIF
		ENDIF
		
		PRIVATE cSOitem, cSQLp, cTBL
		cSOitem = Proper_SO_Item(tmpSO.SOitem)
		cSQLp = ''
		cTBL = "S"
		
		IF lHaveID_Detail
			
			IF USED("tmpProcess")
				USE IN tmpProcess
			ENDIF
			IF nID_Detail > 0
				cSQLp = "SELECT *, 'S' AS Tbl FROM dbo.StockLst_Process WHERE ID_Detail = "+ALLTRIM(STR(nID_Detail))
			ELSE
				MESSAGEBOX("No Process Found"+CHR(13)+"Select stock to make a process!",64,"No Process")
				RETURN .F.
			ENDIF
				
			SELECT 0
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQLp, 'tmpProcess' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLp, 'tmpProcess' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError( cSQLp, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpProcess')
			ELSE
		*		SELECT tmpProcess
				nID_Detail_Process = PrepareSQLnum(tmpProcess.ID_Detail_Process,'ID_Detail_Process',-3)
				ThisFormset.frmStockLstProcesses.ID_Detail_Process1.Value = nID_Detail_Process
				
				ThisFormSet.Stocklst_ID_Detail	= tmpProcess.ID_Detail
				ThisFormSet.StockLst_TBL		= tmpProcess.TBL
				ThisFormSet.ID_Detail_Process	= tmpProcess.ID_Detail_Process
				ThisFormSet.Stocklst_ID			= Get_ID_with_ID_Detail(tmpProcess.ID_Detail, tmpProcess.TBL, ThisFormSet.nConnHandle)
				ThisFormSet.Tbl_Process 		= tmpProcess.TBL
				
				IF !ThisFormSet.Check_ID_Detail_Process()
					RETURN .F.
				ENDIF
				
				**nID_Detail is Private localy, but overloaded
			ENDIF
		ELSE
			*No ID_Detail 
		ENDIF
		
		
		IF USED("tmpProcess")
			IF RECCOUNT("tmpProcess") > 0
				SELECT tmpProcess
				
				IF lHaveID_Detail 
					LOCATE FOR ID_Detail = nID_Detail
					IF NOT FOUND("tmpProcess")
						MESSAGEBOX("Did not find ID_Detail="+ALLTRIM(STR(nID_Detail))+CHR(13)+"Record moved to top.",0,"ID_Detail not found" )
						GO TOP
					ENDIF
				ENDIF
				
				ThisFormSet.frmStockLstProcesses.SOITEM1.Refresh
				ThisFormSet.frmStockLstProcesses.WO1.Refresh
				ThisFormSet.frmStockLstProcesses.PO_Item1.Refresh
				ThisFormSet.frmStockLstProcesses.SalesPerson1.Refresh
				ThisFormSet.frmStockLstProcesses.StartDate1.Refresh
				ThisFormSet.frmStockLstProcesses.DueDate1.Refresh
				ThisFormSet.frmStockLstProcesses.AllowSub1.Refresh
				ThisFormSet.frmStockLstProcesses.pWeight1.Refresh
				ThisFormSet.frmStockLstProcesses.QTY1.Refresh
				ThisFormSet.frmStockLstProcesses.PU1.Refresh
				ThisFormSet.frmStockLstProcesses.Process_ID1.Refresh
				ThisFormSet.frmStockLstProcesses.Processor1.Refresh
				ThisFormSet.frmStockLstProcesses.Comment1.Refresh
				
				DO CASE 
				CASE tmpProcess.Tbl = "S"
					ThisFormSet.frmStockLstProcesses.lblStockLstProcesses.Caption = "Stock List Processes"
					ThisFormSet.frmStockLstProcesses.cmdShowStockLst.Enabled = .T.
					ThisFormSet.frmStockLstProcesses.cmdProcess.Caption = "Modify Stock List"
					ThisFormSet.frmStockLstProcesses.cmdShowStockLst.Caption = "Show Stock List"
					ThisFormSet.frmStockLstProcesses.cmdEditStockLst.Enabled = .T.
				CASE tmpProcess.Tbl = "B"
					ThisFormSet.frmStockLstProcesses.lblStockLstProcesses.Caption = "Broker List Prosesses"
					ThisFormSet.frmStockLstProcesses.cmdShowStockLst.Enabled = .T.
					ThisFormSet.frmStockLstProcesses.cmdProcess.Caption = "Modify Broker List"
					ThisFormSet.frmStockLstProcesses.cmdShowStockLst.Caption = "Show Broker List"
					ThisFormSet.frmStockLstProcesses.cmdEditStockLst.Enabled = .T.
				CASE tmpProcess.Tbl = "W"
					ThisFormSet.frmStockLstProcesses.lblStockLstProcesses.Caption = "WIP List Prosesses"
					ThisFormSet.frmStockLstProcesses.cmdShowStockLst.Enabled = .T.
					ThisFormSet.frmStockLstProcesses.cmdProcess.Caption = "Modify WIP List"
					ThisFormSet.frmStockLstProcesses.cmdShowStockLst.Caption = "Show WIP List"
					ThisFormSet.frmStockLstProcesses.cmdEditStockLst.Enabled = .T.
				OTHERWISE
					TrackError("Missing Table","Table 'tmpProcess.TBL' was not Found.","frmShop_StockLst_Edit:Process()",LINENO())
				ENDCASE
		
				IF RECCOUNT("tmpProcess") > 1
					ThisFormSet.frmStockLstProcesses.lblOF.Visible = .T.
					ThisFormSet.frmStockLstProcesses.txtRec.Visible = .T.
					ThisFormSet.frmStockLstProcesses.txtRec.Value = 1
					ThisFormSet.frmStockLstProcesses.txtTot.Visible = .T.
					ThisFormSet.frmStockLstProcesses.txtTot.Value = RECCOUNT("tmpProcess")
					
					ThisFormSet.frmStockLstProcesses.cmdBackWard.Visible = .T.
					ThisFormSet.frmStockLstProcesses.cmdForWard.Visible = .T.
				ELSE
					ThisFormSet.frmStockLstProcesses.lblOF.Visible = .F.
					ThisFormSet.frmStockLstProcesses.txtRec.Visible = .F.
					ThisFormSet.frmStockLstProcesses.txtTot.Visible = .F.
		
					ThisFormSet.frmStockLstProcesses.cmdBackWard.Visible = .F.
					ThisFormSet.frmStockLstProcesses.cmdForWard.Visible = .F.
					
				ENDIF
				
				*ThisFormset.frmStockLstProcesses.cmdProcess.Visible = .F.
				*ThisFormset.frmStockLstProcesses.cmdRemoveProcess.Visible = .F.
						
				ThisFormSet.frmStockLstProcesses.VISIBLE = .T.
				
				ThisFormSet.frmStockLstProcesses.Refresh
				
				ThisFormSet.IsProcess_of_SO()
				
		*		ThisFormSet.ID_Detail_Process 	= tmpProcess.ID_Detail_process
		*		ThisFormSet.Tbl_Process 		= tmpProcess.Tbl
		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE processhistory
		PARAMETER pID_Detail
		*THISFORMSET.ProcessHistory(ID_Detail)
		* Shows Process History
		
		IF VARTYPE(pID_Detail) != "N"
			RETURN .F.
		ENDIF
		
		PRIVATE nID_Detail
		nID_Detail = pID_Detail
		
		PRIVATE cSQL
		
		
		IF USED("tmpPrcHist")
			ThisFormSet.frmStockLstProcessHistory.grdProcessHistory.RecordSource = ""
			USE IN tmpPrcHist
		ENDIF
		
		
			cSQL = "SELECT [what],[when],Process_ID,'S' AS Tbl,SOitem,PO_item,[comment]"
			cSQL = cSQL + " FROM HPAlloy_Archive.dbo.StockLst_Process_History "
			cSQL = cSQL + " WHERE ID_Detail = "+ALLTRIM(STR(pID_Detail))
			cSQL = cSQL + " AND [what] != 'BEFOREEDIT'"
			cSQL = cSQL + " ORDER BY [When] DESC"
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC( THISFORMSET.nConnHandle, cSQL, 'tmpPrcHist' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpPrcHist' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPrcHist')
		ENDIF
		
		
		
		IF USED("tmpPrcHist")
			IF RECCOUNT("tmpPrcHist") > 0
				SELECT tmpPrcHist
				
				ThisFormSet.frmStockLstProcessHistory.grdProcessHistory.RecordSource = "tmpPrcHist"
				
				THISFORMSET.frmStockLstProcessHistory.VISIBLE = .T.
				THISFORMSET.frmStockLstProcessHistory.AlwaysOnTop = .T.
				THISFORMSET.frmStockLstProcessHistory.AlwaysOnTop = .F.
				ThisFormSet.frmStockLstProcessHistory.grdProcessHistory.SetFocus
				
			ENDIF
			*USE IN tmpPrcHist
		ENDIF
		
	ENDPROC

	PROCEDURE receivepostocklst
		PARAMETER pPOitem, pnReceivingID, pHeat, nRMA, cSOitem, nWO_Detail
		*ThisFormSet.ReceivePOStockLst( purchaseorder.poitem ,pnReceivingID, cHeat, nRMA, cSOitem, nWO_Detail ) 
		
		*Called By:ThisFormSet.SaveAdd_PurchaseOrder
		
		
		*Checks Stock and Broker, sends to RecvStockLoad()
		*Relays pnReceivingID 
		IF TYPE("pnReceivingID") != "N"		
			TrackError("bad parameter","pnReceivingID was passed a parameter that was not a NUMBER","Shop_StockLst_Edit:ReceivePOStockLst",LINENO())
			pnReceivingID = 0
		ENDIF
		
		IF VARTYPE(pPoItem) != "C"
			pPoItem = ""
		ENDIF
		PRIVATE cPOitem
		cPOitem = pPoItem
		
		IF VARTYPE(cHeat) != "C"
			cHeat = ""
		ENDIF
		cHeat = ALLTRIM(cHeat)
		
		IF VARTYPE(nRMA) != "N"
			nRMA = 0
		ENDIF
		PRIVATE lRMA
		lRMA = .F.
		IF nRMA > 0
			lRMA = RMA_Exists( nRMA, ThisFormSet.nConnHandle)	
		ENDIF
		
		IF VARTYPE(cSOitem) != "C"
			cSOitem = ''
		ENDIF
		
		IF VARTYPE(nWO_Detail) != "N"
			nWO_Detail= 0
		ENDIF
		
		*Update StockLst
		************************** StockLst SQL
		
		PRIVATE cSQL_Master_PO, nID_Master, nID_Detail
		nID_Master = 0
		nID_Detail = 0
		PRIVATE nBkrMastCnt, nBkrMastCntRid
		nStkMastCntRid = 0
		nBkrMastCntRid = 0
		PRIVATE nStkMastCnt, nBkrMastCnt 
		nStkMastCnt = 0
		nBkrMastCnt = 0
		
		*IF pnReceivingID = 0
		*	pnReceivingID = PrepareSQLnum(ThisFormSet.frmRecvStock.txtReceivingID.Value,'ReceivingID',-3)
		*ENDIF
		
		*****************
		PRIVATE nID, nID_Detail, cTBL
		nID			= PrepareSQLnum(ThisFormSet.Stocklst_ID,'ID',-3)
		nID_Detail	= PrepareSQLnum(ThisFormSet.Stocklst_ID_Detail,'ID_Detail',-3)
		cTBL 		= PrepareSQLtxt(ThisFormSet.StockLst_TBL,'TBL',1)
		
		*Check to See Tbl ID ANd ID_Detail are Good
		
		IF USED("StkMastCnt")
			USE IN StkMastCnt
		ENDIF
		
		IF UPPER(cTBL) = "S"
			cSQL = "SELECT ReceivingID FROM dbo.StockLst_Detail "
			cSQL = cSQL + " WHERE ID_Detail ="+ALLTRIM(STR(nID_Detail))
			cSQL = cSQL + " AND ID = "+ALLTRIM(STR(nID))
		*	IF pnReceivingID > 0
		*		cSQL = cSQL + " AND ReceivingID ="+ALLTRIM(STR(pnReceivingID))
		*	ENDIF
		ELSE
			cSQL = "SELECT ReceivingID FROM dbo.BrokerLst_Detail "
			cSQL = cSQL + " WHERE ID_Detail ="+ALLTRIM(STR(nID_Detail))
			cSQL = cSQL + " AND ID = "+ALLTRIM(STR(nID))
		*	IF pnReceivingID > 0
		*		cSQL = cSQL + " AND ReceivingID ="+ALLTRIM(STR(pnReceivingID))
		*	ENDIF
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC( ThisFormset.nConnHandle, cSQL , 'StkMastCnt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL , 'StkMastCnt')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL ,ThisFormSet.nConnHandle, nSQLEXEC, 'StkMastCnt')
		ELSE
			IF USED('StkMastCnt')
				IF RECCOUNT('StkMastCnt')>0
					
					nID_Master = nID
					
					IF pnReceivingID < 1
						*Use the ID_Detail Receive Number
						IF PrepareSQLnum(StkMastCnt.ReceivingID,'ReceivingID',-3) > 0
							pnReceivingID = StkMastCnt.ReceivingID 
						ENDIF
					ENDIF
					
					
					IF pnReceivingID > 0
						IF UPPER(cTBL) = "S"
							nStkMastCntRid = 1
							nStkMastCnt = 1
						ELSE
							nBkrMastCntRid = 1
							nBkrMastCnt = 1
						ENDIF
					ENDIF
				ENDIF
				USE IN StkMastCnt
			ENDIF
		ENDIF
		
		*******************
		IF pnReceivingID > 0
			IF nStkMastCntRid + nBkrMastCntRid = 0
				* Check StockLst_Detail for Receiving ID
				
				*Could be used for RMA
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
		
				cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Detail "
				cSQL_S_Master_PO = cSQL_S_Master_PO + " WHERE ReceivingID = "+ALLTRIM(STR( pnReceivingID ))
				
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisFormset.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL_S_Master_PO,ThisFormSet.nConnHandle, nSQLEXEC, 'StkMastCnt')
					nStkMastCntRid = 0
				ELSE
					nStkMastCntRid = StkMastCnt.Cntd 
					IF nStkMastCntRid > 0
						nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,'StockLst',ThisFormSet.nConnHandle)
						nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,'StockLst',ThisFormSet.nConnHandle)
					ENDIF
				ENDIF
				IF USED("StkMastCnt")
					USE IN StkMastCnt
				ENDIF
					
				*********************Check BrokerLst_Detail for Receiving ID	
				IF USED("BkrMastCnt")
					USE IN BkrMastCnt
				ENDIF
		
				cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.BrokerLst_Detail "
				cSQL_S_Master_PO = cSQL_S_Master_PO + " WHERE ReceivingID = "+ALLTRIM(STR( pnReceivingID ))
				
				SELECT 0
				nSQLEXEC = SQLEXEC( ThisFormset.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL_S_Master_PO, ThisFormSet.nConnHandle, nSQLEXEC, 'BkrMastCnt')
					nBkrMastCntRid = 0
				ELSE
					nBkrMastCntRid = BkrMastCnt.Cntd 
					IF nBkrMastCntRid > 0
						nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,'BrokerLst',ThisFormSet.nConnHandle)
						nID_Master = Get_ID_Master_by_ReceivingID(pnReceivingID,'BrokerLst',ThisFormSet.nConnHandle)
					ENDIF
				ENDIF
		
				IF USED("BkrMastCnt")
					USE IN BkrMastCnt
				ENDIF
			ENDIF
		ELSE
			*Why is there no pnReceivingID!!!!
			TrackError("No pnReceivingID!","No pnReceivingID","Shop_StockLst_Edit:ReceivePOStockLst",LINENO())
		ENDIF
		
		***********************
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCntRid + nBkrMastCntRid = 0
				*No Detail record have ReceivingID
				*Look by POitem - 
		
				IF Proper_PO_Item(pPoItem) != Proper_PO_Item("")
					*Lst_Detail Does not have ReceivingID
					cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd  FROM dbo.StockLst_Master "
					cSQL_S_Master_PO = cSQL_S_Master_PO+" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_S_Master_PO = cSQL_S_Master_PO+" AND ( POStatus NOT LIKE 'A' AND Heat='Due In' )"
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormset.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_S_Master_PO,ThisFormSet.nConnHandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd 
						IF nStkMastCnt > 0
							nID_Master = get_ID_Master_with_POitem(pPoItem,'StockLst',ThisFormSet.nConnHandle,cHeat,.T.,pnReceivingID)
							nID_Detail = get_ID_Detail_by_ReceivingID(pnReceivingID,'StockLst',ThisFormSet.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'StockLst',ThisFormSet.nConnHandle,.T.)
							ENDIF
			*				nID_Detail = ThisFormSet.StockLst_ID_Detail
			*				nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisFormSet.nConnHandle)
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL_B_Master_PO = "SELECT COUNT(ID) AS Cntd FROM dbo.BrokerLst_Master "
					cSQL_B_Master_PO = cSQL_B_Master_PO+" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_B_Master_PO = cSQL_B_Master_PO+" AND ( POStatus NOT LIKE 'A' AND Heat='Due In' )"
					*OR POStatus IS NULL )"
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormset.nConnHandle, cSQL_B_Master_PO, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_B_Master_PO,ThisFormSet.nConnHandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd 
						IF nBkrMastCnt > 0
							nID_Master = get_ID_Master_with_POitem(pPoItem,'BrokerLst',ThisFormset.nConnHandle,cHeat,.T.,pnReceivingID)
							nID_Detail = get_ID_Detail_by_ReceivingID(pnReceivingID,'BrokerLst',ThisFormSet.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'BrokerLst',ThisFormSet.nConnHandle,.T.)
							ENDIF
			*				nID_Detail = ThisFormSet.StockLst_ID_Detail
			*				nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisFormSet.nConnHandle)
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
				ENDIF
			ELSE
				*Why is there no pnReceivingID!!!!
				*TrackError("No pnReceivingID!"+"","No pnReceivingID","Shop_StockLst_Edit:ReceivePOStockLst()",LINENO())
			ENDIF
		ENDIF
		
		**************************
		
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCnt + nBkrMastCnt + nStkMastCntRid + nBkrMastCntRid = 0
				*No Detail record has ReceivingID
				*Look by POitem - 
		
				IF Proper_PO_Item(pPoItem) != Proper_PO_Item("   0-01") AND Proper_PO_Item(pPoItem) != Proper_PO_Item("   0-00")
					*Lst_Detail Does not have ReceivingID
					cSQL_S_Master_PO = "SELECT COUNT(ID) AS Cntd  FROM dbo.StockLst_Master WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_S_Master_PO = cSQL_S_Master_PO+" AND ( POStatus = 'A' AND Heat='Due In' )"
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormset.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL_S_Master_PO, 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_S_Master_PO,ThisFormSet.nConnHandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd 
						IF nStkMastCnt > 0
							nID_Master = get_ID_Master_with_POitem(pPoItem,'StockLst',ThisFormSet.nConnHandle,cHeat,.T.,pnReceivingID)
							nID_Detail = get_ID_Detail_by_ReceivingID(pnReceivingID,'StockLst',ThisFormSet.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'StockLst',ThisFormSet.nConnHandle,.T.)
							ENDIF
						*	nID_Detail = ThisFormSet.StockLst_ID_Detail
						*	nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisFormSet.nConnHandle)
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL_B_Master_PO = "SELECT COUNT(ID) AS Cntd  FROM dbo.BrokerLst_Master "
					cSQL_B_Master_PO = cSQL_B_Master_PO+" WHERE dbo.f_ProperPOitem(PO_Item) = dbo.f_ProperPOitem('"+pPoItem+"')"
					cSQL_B_Master_PO = cSQL_B_Master_PO+" AND ( POStatus = 'A' AND Heat='Due In' )"
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormset.nConnHandle, cSQL_B_Master_PO, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQL_S_Master_PO, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL_B_Master_PO,ThisFormSet.nConnHandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd 
						IF nBkrMastCnt > 0
							nID_Master = get_ID_Master_with_POitem(pPoItem,'BrokerLst',ThisFormSet.nConnHandle,cHeat,.T.,pnReceivingID)
							nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,'BrokerLst',ThisFormSet.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_POitem(pPoItem,'BrokerLst',ThisFormSet.nConnHandle,.T.)
							ENDIF
							*nID_Detail = ThisFormSet.StockLst_ID_Detail
							*nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisFormSet.nConnHandle)
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		**************************
		
		IF NOT lRMA &&RMA does not have PO!
			IF nStkMastCnt + nBkrMastCnt + nStkMastCntRid + nBkrMastCntRid = 0
				*No Detail record have ReceivingID
				*Look by WO_Detail
		
				*IF Proper_PO_Item(pPoItem) = Proper_PO_Item("") 
				IF nWO_Detail > 0
					*Lst_Detail Does not have ReceivingID
					cSQL = "SELECT COUNT(ID) AS Cntd FROM dbo.StockLst_Master "
					cSQL = cSQL+" WHERE WO_Detail="+STR(nWO_Detail)
		
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL , 'StkMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'StkMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL ,ThisFormSet.nConnHandle, nSQLEXEC, 'StkMastCnt')
						nStkMastCnt = 0
					ELSE
						nStkMastCnt = StkMastCnt.Cntd 
						IF nStkMastCnt > 0
							nID_Master = get_ID_Master_with_WO_Detail(nWO_Detail,'StockLst',ThisFormSet.nConnHandle)
							nID_Detail = get_ID_Detail_by_ReceivingID(pnReceivingID,'StockLst',ThisFormSet.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_WO_Detail(nWO_Detail,'StockLst',ThisFormSet.nConnHandle)
							ENDIF
							*nID_Detail = ThisFormSet.StockLst_ID_Detail
							*nID_Master = Get_ID_by_ID_Detail(nID_Detail,'S',ThisFormSet.nConnHandle)
						ENDIF
					ENDIF
					IF USED("StkMastCnt")
						USE IN StkMastCnt
					ENDIF
		
					*********************
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
		
					cSQL = "SELECT COUNT(ID) AS Cntd  FROM dbo.BrokerLst_Master "
					cSQL = cSQL +" WHERE WO_Detail="+STR(nWO_Detail)
		
					SELECT 0
					nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'BkrMastCnt')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'BkrMastCnt')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'BkrMastCnt')
						nBkrMastCnt = 0
					ELSE
						nBkrMastCnt = BkrMastCnt.Cntd 
						IF nBkrMastCnt > 0
							nID_Master = get_ID_Master_with_WO_Detail(nWO_Detail,'BrokerLst',ThisFormSet.nConnHandle)
							nID_Detail = Get_ID_Detail_by_ReceivingID(pnReceivingID,'BrokerLst',ThisFormSet.nConnHandle)
							IF nID_Detail = 0
								nID_Detail = get_ID_Detail_with_WO_Detail(nWO_Detail,'BrokerLst',ThisFormSet.nConnHandle,.T.)
							ENDIF
							*nID_Detail = ThisForm.ID_Detail
							*nID_Master = Get_ID_by_ID_Detail(nID_Detail,'B',ThisFormSet.nConnHandle)
						ENDIF
					ENDIF
		
					IF USED("BkrMastCnt")
						USE IN BkrMastCnt
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
		**************************
		PRIVATE nMess
		nMess = 0
		
		*IF NOT lRMA 
		IF nRMA = 0
		
			DO CASE 
			CASE nStkMastCntRid > 0
		*		nMess = MESSAGEBOX("Please use the default PO Receive Stock (Y)"+CHR(13)+"if this has errors Answer (N)o",4+32,"Use Default Add Stock")
		*		IF nMess = 6
					DO FORM Forms\PORecvStock WITH pPOitem, 'StockLst', pnReceivingID, nRMA, nID_Detail, cHeat, nID_Master 
		*                             			   pPOitem,    pLst,    pnReceivingID, pnRMA, pnID_Detail, cHeat, pnID_Master
					*					PARAMETER  pPOitem,    pLst,    pnReceivingID, pnRMA, pnID_Detail, cHeat, pnID_Master 
		*		ELSE
		*			ThisFormSet.RecvStockLoad( pPOitem, ThisFormSet.nConnHandle, 'StockLst ', pnReceivingID, nRMA, nID_Detail, nID_Master  )
		*		ENDIF
			CASE nBkrMastCntRid > 0
		*		nMess = MESSAGEBOX("Please use the default PO Receive Stock (Y)"+CHR(13)+"if this has errors Answer (N)o",4+32,"Use Default Add Stock")
		*		IF nMess = 6
					DO FORM Forms\PORecvStock WITH pPOitem, 'BrokerLst', pnReceivingID, nRMA, nID_Detail, cHeat, nID_Master
					*						PARAMETER pPOitem, pLst, pnReceivingID, pnRMA, pnID_Detail, cHeat, pnID_Master 
		*		ELSE
		*			ThisFormSet.RecvStockLoad( pPOitem, ThisFormSet.nConnHandle, 'BrokerLst', pnReceivingID, nRMA, nID_Detail, nID_Master  )
		*		ENDIF
			CASE nStkMastCnt > 0
				SetReceivingID_in_Detail( pPOitem, nID_Detail, ThisFormSet.nConnHandle, 'StockLst', pnReceivingID, .F. )
				
		*		nMess = MESSAGEBOX("Please use the default PO Receive Stock (Y)"+CHR(13)+"if this has errors Answer (N)o",4+32,"Use Default Add Stock")
		*		IF nMess = 6
					DO FORM Forms\PORecvStock WITH pPOitem, 'StockLst', pnReceivingID, nRMA, nID_Detail, cHeat, nID_Master 
					*						PARAMETER pPOitem, pLst, pnReceivingID, pnRMA, pnID_Detail, cHeat, pnID_Master 
		*		ELSE
		*			ThisFormSet.RecvStockLoad( pPOitem, ThisFormSet.nConnHandle, 'StockLst ', pnReceivingID, nRMA, nID_Detail, nID_Master  )
		*		ENDIF
			CASE nBkrMastCnt > 0
				SetReceivingID_in_Detail( pPOitem, nID_Detail, ThisFormSet.nConnHandle, 'BrokerLst', pnReceivingID, .F. )
				
		*		nMess = MESSAGEBOX("Please use the default PO Receive Stock (Y)"+CHR(13)+"if this has errors Answer (N)o",4+32,"Use Default Add Stock")
		*		IF nMess = 6
					DO FORM Forms\PORecvStock WITH pPOitem, 'BrokerLst', pnReceivingID, nRMA, nID_Detail, cHeat, nID_Master 
					*						PARAMETER pPOitem, pLst, pnReceivingID, pnRMA, pnID_Detail, cHeat, pnID_Master 
		*		ELSE
		*			ThisFormSet.RecvStockLoad( pPOitem, ThisFormSet.nConnHandle, 'BrokerLst', pnReceivingID, nRMA, nID_Detail, nID_Master  )
		*		ENDIF
			OTHERWISE
			
				*Is this a Lab Test?
				PRIVATE nCountPOitem 
				nCountPOitem = PO_POitem_Cnt( cPOitem, ThisFormset.nConnHandle, "NOTRECEIVE" )
				*Only counts if Services = 0 AND ConvServ = 0 AND Equipment = 0 
				IF nCountPOitem > 0
					*ThisFormSet.RecvStockLoad( pPOitem, ThisFormSet.nConnHandle, 'StockLst ', pnReceivingID, nRMA, nID_Detail, nID_Master  )
					DO FORM Forms\PORecvStock WITH pPOitem, 'StockLst', pnReceivingID, nRMA     , 0       , cHeat, 0
					*						PARAMETER pPOitem, pLst,    pnReceivingID, pnRMA, pnID_Detail, cHeat, pnID_Master 
				
					cMess = "ReceivePOStockLst(POitem,ReceivingID,Heat,RMA)."+CHR(13)
					cMess = cMess+"Could not find a Master with ( POStatus NOT LIKE 'A' OR POStatus IS NULL ) "
					cMess = cMess+CHR(13)+"or Detail WHERE ReceivingID="
					cMess = cMess+STR(pnReceivingID)+CHR(13) 
					cMess = cMess+" POitem='"+pPOitem+"'"
					cMess = cMess+", Heat='"+ALLTRIM(cHeat)+"'"
					cMess = cMess+", RMA"+ALLTRIM(STR(nRMA))
					
					*TrackError("nStkMastCntRid Not Found",cMess,"frmShop_StockLst_Edit.ReceivePOStockLst",LINENO() )
					TrackMess(cMess)
				ELSE
					*DO FORM Forms\PoRecvStock_PRE WITH pPOitem, pnReceivingID, cHeat
					
					PRIVATE cTableName 
					cTableName = 'StockLst'
					*Probably not the First receive, Check to see if for StockLst
					IF Count_POitem_StockLst ( cPOitem, 'S', ThisFormSet.nConnHandle ) > 0
						cTableName = 'StockLst'
					ELSE
						IF Count_POitem_StockLst ( cPOitem, 'B', ThisFormSet.nConnHandle ) > 0
							cTableName = 'BrokerLst'
						ENDIF
					ENDIF
					
					nMess = MESSAGEBOX("The PO item 'INCOMING' OR 'PARTRECV' OR 'NOT2HPA' mark is missing."+CHR(13)+CHR(13)+"This is most like a receive for '"+cTableName+"' table."+CHR(13)+"Is this correct ? (Y)",3+32,"Save to "+cTableName )
					IF nMess != 6 &&No,Canc
					
						cTableName = IIF(cTableName = 'StockLst', 'BrokerLst', 'StockLst' )
						nMess = MESSAGEBOX("Would you rather receive to '"+cTableName+"' table?",3+32,"Save to "+cTableName )
						
						IF nMess!= 6
							*Must cancel!
							RETURN .F.
						ENDIF
						
					ENDIF
					
					DO FORM Forms\PORecvStock WITH pPOitem, cTableName, pnReceivingID, nRMA,  nID_Detail, cHeat, nID_Master 
					*					PARAMETER  pPOitem,    pLst,    pnReceivingID, pnRMA, pnID_Detail,cHeat, pnID_Master 
				ENDIF
			ENDCASE
			
		ELSE
			*ThisForm.frmRecvStock.txtWhatDo.Value = "Add"
			*Check for RMA **
			*Check Process to see if PO found in Broker or StockLst
			*********************
				
			*Will this Returned Stock be listed on Inventory?
			IF MESSAGEBOX("Will this Returned Material need to be relisted on Stock List?",4,"Open Stock Receive screen?") = 6
				*
				*Is Master ID Still in Stock.
				*return needs a new ID_Detail
				*
				nID_Detail = 0
				nID_Master = 0
				
				IF USED('tmpHist')
					USE IN tmpHist
				ENDIF
				
				SELECT 0
				cSQL = "SELECT Distinct M.ID,D.ID_Detail,M.Heat "
				cSQL = cSQL + " FROM HPAlloy_Archive.dbo.StockLst_Process_History P "
				cSQL = cSQL + " INNER JOIN HPAlloy_Archive.dbo.Stocklst_Detail_History D ON D.ID_Detail = P.ID_Detail "
				cSQL = cSQL + " INNER JOIN HPAlloy_Archive.dbo.Stocklst_Master_History M ON M.ID = D.ID "
				cSQL = cSQL + " WHERE P.SOitem = '"+cSOitem+"'"
				cSQL = cSQL + " AND M.Heat = '"+ALLTRIM(cHeat)+"'"
		
				nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL , 'tmpHist')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpHist')
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL , ThisFormSet.nConnHandle, nSQLEXEC, 'tmpHist')
				ENDIF
				IF USED('tmpHist')
					IF RECCOUNT('tmpHist') > 0
						nID_Master = tmpHist.ID
						*nID_Detail = tmpHist.ID_Detail
					ENDIF
					USE IN tmpHist
				ENDIF
			
				*
				*ThisFormSet.RecvStockLoad( pPOitem, ThisFormSet.nConnHandle, 'StockLst ', pnReceivingID, nRMA, nID_Detail, nID_Master  )
				DO FORM Forms\PORecvStock WITH pPOitem, 'StockLst', pnReceivingID, nRMA, nID_Detail, cHeat, nID_Master 
				*					PARAMETER  pPOitem,     pLst,   pnReceivingID, pnRMA, pnID_Detail, cHeat, pnID_Master 
			ENDIF
		ENDIF
		
		IF USED('Receiving')
			SELECT Receiving
		ENDIF
		RETURN .T.
		
	ENDPROC

	PROCEDURE receivingchecksave
		*ThisFormSet.ReceivingCheckSave()
		
		PRIVATE lReady2Save
		lReady2Save = .T.
		
		IF EMPTY(ThisFormset.frmReceiving.edtDescription.Value)
			lReady2Save = .F.
			MESSAGEBOX( "No Valid Description", 0+32,"Cannot Save")
		ENDIF
		
		PRIVATE dReceived
		dReceived	= PrepareSQLdate(ThisFormset.frmReceiving.txtReceived.Value,'Received')
		*dReceived	= PrepareSQLdate(ThisForm.pf.pg_Add.txtReceived.Value,'Received')
		
		IF dReceived + 1000 < DATE() OR dReceived - 1000 > DATE()
			*Not within 1000 Days, Reset.
			dReceived = CTOD("  /  /  ")
		ENDIF
		
		IF dReceived = CTOD("  /  /  ")
			IF MESSAGEBOX( "Do you want to set today as the Received date?",4+32,"Date") = 6
				ThisFormset.frmReceiving.txtReceived.Value = DATE()
				*dReceived	= PrepareSQLdate(ThisFormset.frmReceiving.txtReceived.Value,'Received')
				dReceived	= DATE()
			ELSE
				ThisFormset.frmReceiving.txtReceived.Value = DATE()
				lReady2Save = .F.
				RETURN lReady2Save 
			ENDIF
		ENDIF
		
		*************
		PRIVATE  nReceivingID
		nReceivingID = ThisFormset.frmReceiving.txtReceivingID.Value
		
		IF TYPE("nReceivingID") != "N"
			PRIVATE cMess
			PRIVATE cPOitem, nHpaPo, nItemPo
			nHpaPo		= PrePareSQLnum(ThisFormSet.frmReceiving.txtHpaPONum.Value,'HPAPO',-3,0)
			nItemPo		= PrePareSQLnum(ThisFormSet.frmReceiving.txtHpaPOItem.Value,'ItemPO',2,0)
			IF nItemPo	= 0
				nItemPo = 1
			ENDIF
			cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
			PRIVATE cSOitem, nSalesNum, nItemSo
			nSalesNum	= PrePareSQLnum(ThisFormSet.frmReceiving.txtSONum.Value,'SalesNum',-3)
			nItemSo 	= PrePareSQLnum(ThisFormSet.frmReceiving.txtSOItem.Value,'SOitem',2,0)
			cSOitem 	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		
			PRIVATE nRMA,cAlloy,cHeat,cDescription
			nRMA		= PrepareSQLnum(ThisFormSet.frmReceiving.txtRMA_No.Value,'RMA',-3)
			cAlloy		= PrepareSQLtxt(ThisFormSet.frmReceiving.txtAlloy.Value,'Alloy',12,.F.)
			cHeat		= PrepareSQLtxt(ThisFormSet.frmReceiving.txtHeat.Value,'Heat',30,.f.)
			cDescription= PrepareSQLtxt(ThisFormSet.frmReceiving.edtDescription.Value,'Description',-1,.F.)
			
			cMess = "nReceivingID is 0"+CHR(13)
			cMess = cMess + "SOitem "+ALLTRIM(ShowSQLtxt(cSOitem,'SOitem',12))+CHR(13)
			cMess = cMess + "POitem "+ALLTRIM(ShowSQLtxt(cPOitem,'POitem',12))+CHR(13)
			cMess = cMess + "RMA "+ALLTRIM(STR(nRMA))+CHR(13)
			cMess = cMess + "Alloy "+ALLTRIM(ShowSQLtxt(cAlloy,'Alloy',12))+CHR(13)
			cMess = cMess + "Heat "+ALLTRIM(ShowSQLtxt(cHeat,'Heat',30))+CHR(13)
			cMess = cMess + "Desc "+ALLTRIM(LEFT(ShowSQLtxt(cDescription,'Desc',20),20))
			
			*TrackError("bad parameter",ShowSQLtxt(cMess,'cMess',-1),"Shop_StockLst_Edit:frmReceiving:cmdAdd-CheckSave",LINENO())
			TrackMess("bad parameter"+CHR(13)+ShowSQLtxt(cMess,'cMess',-1)+CHR(13)+"Shop_StockLst_Edit:frmReceiving:cmdAdd-CheckSave")
			nReceivingID = 0
			ThisFormset.frmReceiving.txtReceivingID.Value = 0
		ENDIF
		IF EMPTY(nReceivingID)
			nReceivingID = 0
		ENDIF
		*****
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		PRIVATE cSOitem, nSalesNum, nItemSo, nWO_Detail
		PRIVATE nRMA,cAlloy,cHeat,cDescription
		
		nHpaPo		= PrepareSQLnum(ThisFormSet.frmReceiving.txtHpaPONum.Value,'HPAPO',10,0)
		nItemPo		= PrepareSQLnum(ThisFormSet.frmReceiving.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo	= 0
			nItemPo = 1
		ENDIF
		cPOitem		= Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		
		nSalesNum	= PrepareSQLnum(ThisFormSet.frmReceiving.txtSONum.Value,'SalesNum',10,0)
		nItemSo 	= PrepareSQLnum(ThisFormSet.frmReceiving.txtSOItem.Value,'SOitem',2,0)
		cSOitem 	= Proper_SO_Item( ALLTRIM(STR(nSalesNum))+"-"+STR(nItemSo,2,0) )
		
		nWO_Detail	= PrepareSQLnum(ThisFormSet.frmReceiving.txtWO_Detail.Value,'WO_Detail',10,0)
		
		cAlloy		= PrepareSQLtxt(ThisFormSet.frmReceiving.txtAlloy.Value,'Alloy',12,.F.)
		cHeat		= PrepareSQLtxt(ThisFormSet.frmReceiving.txtHeat.Value,'Heat',30,.f.)
		cDescription= PrepareSQLtxt(ThisFormSet.frmReceiving.edtDescription.Value,'Description',-1,.F.)
		
		nRMA		= PrepareSQLnum(ThisFormSet.frmReceiving.txtRMA_No.Value,'RMA',3)
		
		*************************
		*Check Heat
		IF EMPTY(cHeat)
			IF MESSAGEBOX("No Heat was Entered."+CHR(13)+"If this is OK answer (Y)."+CHR(13)+"If you want to go back"+CHR(13)+"and enter the Heat, answer(N)",16+4,"Continue...") != 6
				lReady2Save = .F.
			ENDIF
		ENDIF
		
		*************************
		IF TYPE("nReceivingID") != "N"
			PRIVATE cMess
				
			cMess = "nReceivingID is 0"+CHR(13)
			cMess = cMess + "SOitem "+ALLTRIM(ShowSQLtxt(cSOitem,'SOitem',12))+CHR(13)
			cMess = cMess + "POitem "+ALLTRIM(ShowSQLtxt(cPOitem,'POitem',12))+CHR(13)
			cMess = cMess + "RMA "+ALLTRIM(STR(nRMA))+CHR(13)
			cMess = cMess + "Alloy "+ALLTRIM(ShowSQLtxt(cAlloy,'Alloy',12))+CHR(13)
			cMess = cMess + "Heat "+ALLTRIM(ShowSQLtxt(cHeat,'Heat',30))+CHR(13)
			cMess = cMess + "Desc "+ALLTRIM(LEFT(ShowSQLtxt(cDescription,'Desc',20),20))
			
			TrackMess("bad parameter"+CHR(13)+ShowSQLtxt(cMess,'cMess',-1)+CHR(13)+"Shop_StockLst_Edit:frmReceiving:cmdAdd-CheckSave")
			nReceivingID = 0
			ThisFormset.frmReceiving.txtReceivingID.Value = 0
			*lReady2Save = .F.
		ENDIF
		IF EMPTY(nReceivingID)
			nReceivingID = 0
		ENDIF
		
		*************************
		IF lReady2Save 
			IF nSalesNum> 0
				IF nItemSo <= 0
					*Problem
					MESSAGEBOX("Sales Order is "+ALLTRIM(STR(nSalesNum))+"."+CHR(13)+"Cannot save with item of "+ALLTRIM(STR(nItemSo))+"!",48,"Bad Item Number")
					lReady2Save = .F.
				ENDIF
			ENDIF
		ENDIF
		
		*************
		PRIVATE lFoundSOitem
		lFoundSOitem = .F.
		
		*************
		*Check to see if this receive does not need a po.
		*The SalesOrder is quotes.services, Conversion Service Only- customers material.
		PRIVATE lFoundConvServ 
		lFoundConvServ = .F.
		IF lReady2Save
			IF cSOitem 	!= Proper_SO_Item("")
				*Found SOitem
				
				IF USED('tmpCountSO_ServiceOnly')
					USE IN tmpCountSO_ServiceOnly
				ENDIF
				
				SELECT 0
				cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.AllQuotes "
				cSQL = cSQL +" WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
				cSQL = cSQL +" AND ISNULL(Services,0) = 1"
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountSO_ServiceOnly' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL,'tmpCountSO_ServiceOnly' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL ,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountSO_ServiceOnly')
				ENDIF
				
				IF USED('tmpCountSO_ServiceOnly')
					IF RECCOUNT('tmpCountSO_ServiceOnly')>0
						IF tmpCountSO_ServiceOnly.Cntd>0
							lFoundConvServ = .T.
						ENDIF
					ENDIF
					USE IN tmpCountSO_ServiceOnly
				ENDIF
				
			ENDIF
		ENDIF
		
		*************
		PRIVATE lFoundWO_Detail
		lFoundWO_Detail = .F.
		
		*Check to see if this receive uses a WO_Detail
		IF nWO_Detail>0
			*have WO_Detail
			
			IF USED('tmpCountWO_Detail')
				USE IN tmpCountWO_Detail
			ENDIF
			
			SELECT 0
			cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.WO_Detail "
			cSQL = cSQL +" WHERE WO_Detail="+STR(nWO_Detail)
			
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpCountWO_Detail' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL,'tmpCountWO_Detail' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL ,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCountWO_Detail')
			ENDIF
			
			IF USED('tmpCountWO_Detail')
				IF RECCOUNT('tmpCountWO_Detail')>0
					lFoundSOitem = .T.
					IF tmpCountWO_Detail.Cntd>0
						lFoundWO_Detail = .T.
					ENDIF
				ENDIF
				USE IN tmpCountWO_Detail
			ENDIF
			
		ENDIF
		
		*************
		*Check from RMA
		*ThisForm.nRMA = 0  &&Reset, Should only have been set as INIT Parameter
		
		PRIVATE nRMA_No, nRMAcnt
		nRMA_No		= 0 &&PrepareSQLnum(ThisForm.pf.pg_Add.txtRMA_No.Value,'RMA_No',-3)
		nRMAcnt	= 0
		
		*************
		*Check POitem
		IF lReady2Save
			IF NOT lFoundConvServ &&Do not check for PO if lFoundConvServ 
				IF nHpaPo > 0
					IF nItemPo <= 0
						*Problem
						MESSAGEBOX("HPA PO is "+ALLTRIM(STR(nHpaPo))+"."+CHR(13)+"Cannot save with item of "+ALLTRIM(STR(nItemPo))+"!",48,"Bad Item Number")
						lReady2Save = .F.
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*!*	*************
		*!*	*Check RMA stuff
		*!*	IF lReady2Save
		*!*		IF nRMAcnt > 0
		*!*			*Get the SO data to check Alloy,etc
		*!*			IF nSalesNum=0 OR nItemSo=0
		*!*				MESSAGEBOX("Cannot save as an RMA with no SO "+ALLTRIM(STR(nSalesNum))+CHR(13)+" or Item "+ALLTRIM(STR(nItemPo))+"!",48,"Bad SO Item Number")
		*!*				lReady2Save = .F.
		*!*			ENDIF
		*!*			
		*!*			IF lReady2Save 
		*!*				IF USED('tmpQuote_Sales')
		*!*					USE IN tmpQuote_Sales
		*!*				ENDIF
		*!*				
		*!*				cSQL = "SELECT S.StockLst_Qty,S.StockLst_PC,S.StockLst_LBS,S.Alloy,S.Form,S.Heat,S.CC,S.StockEdit,S.Reconciled  "
		*!*				cSQL = cSQL + " ,AllQuotes.Company "
		*!*				cSQL = cSQL + " FROM dbo.Sales_Stock S "
		*!*				cSQL = cSQL + " INNER JOIN dbo.AllQuotes  ON AllQuotes.SOitem = S.SOitem "
		*!*				cSQL = cSQL + " WHERE S.SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		*!*		
		*!*			
		*!*				SELECT 0
		*!*				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQuote_Sales' )
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle,  cSQL, 'tmpQuote_Sales' )
		*!*				ENDDO
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpQuote_Sales')
		*!*				ENDIF
		*!*				
		*!*				IF USED('tmpQuote_Sales')
		*!*					IF RECCOUNT('tmpQuote_Sales') >  0
		*!*						*Check Alloy, Pc, Weight
		*!*						IF ALLTRIM(cAlloy) != ALLTRIM(tmpQuote_Sales.Alloy)
		*!*							MESSAGEBOX("Receive Alloy "+ALLTRIM(cAlloy)+" does not match SO Alloy "+ALLTRIM(tmpQuote_Sales.Alloy)+"!",48,"Bad SO Item Number")
		*!*							lReady2Save = .F.
		*!*						ENDIF
		*!*					ELSE
		*!*						MESSAGEBOX("Cannot save as an RMA with bad SO Item "+ALLTRIM(cSOitem)+"!",48,"Bad SO Item Number")
		*!*						lReady2Save = .F.
		*!*					ENDIF
		*!*					USE IN tmpQuote_Sales
		*!*				ENDIF
		
		*!*			ENDIF
		*!*		ENDIF
		*!*	ENDIF
		
		
		*************
		*Check POitem2
		IF lReady2Save 
			IF nRMAcnt = 0   
				*Do not need to check for PO on RMA
				IF NOT lFoundSOitem  &&Do not to check on PO because it hase a good SOitem
					IF NOT lFoundWO_Detail  &&Do not to check on PO because it hase a good WO_Detail
						IF NOT lFoundConvServ &&Do not check for PO if lFoundConvServ 
							PRIVATE nCntPOitem 
							nCntPOitem = Count_POIteminPurchaseOrder( cPOItem, ThisFormSet.nConnHandle )
							IF nCntPOitem < 1
								TrackError("Did not find POitem: "+ALLTRIM(cPOitem),"You cannot save this receive with that POitem!","frmShop_StockLst_Edit:ReceivingCheckSave",LINENO())
								MESSAGEBOX("Did not find POitem: "+ALLTRIM(cPOitem)+CHR(13)+"You cannot save this receive with that POitem!"+CHR(13)+CHR(13)+"Only a Sales Order as a conversion service is allowed."+CHR(13)+"Have Salesman mark as a service.",16,"No Save")
								lReady2Save = .F.
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		*****
		RETURN lReady2Save
	ENDPROC

	PROCEDURE receivingload
		PARAMETER pcPOitem
		*ThisFormSet.ReceivingLoad(cPOitem)
		*Depricated use Form Receive_Edit
		RETURN .F.
		
		PRIVATE nID, nID_Detail, cStockLst, cTBL
		nID			= 0
		nID_Detail	= 0
		cTableName = ''
		cTBL = ''
		
		
		ThisFormSet.ReceivingResetAddvars()
		
		ThisFormSet.frmReceiving.Visible = .T.
		
		IF ThisFormSet.Stocklst_ID_Detail > 0
			nID			= ThisFormSet.Stocklst_ID
			nID_Detail	= ThisFormSet.Stocklst_ID_Detail
			cTBL		= ThisFormSet.StockLst_TBL
		ENDIF
		
		IF nID = 0 AND nID_Detail > 0 AND NOT ( EMPTY(cTBL) OR cTBL = "" )
			nID =  GetIDfromID_Detail( nID_Detail, cTBL, ThisFormSet.nConnhandle )
		ENDIF
		
		ThisFormSet.frmReceiving.txtID.Value = nID
		ThisFormSet.frmReceiving.txtID_Detail.Value = nID_Detail
		ThisFormSet.frmReceiving.txtTBL.Value	= cTBL
		***
		ThisFormSet.Stocklst_ID			= PrepareSQLnum(ThisFormset.frmReceiving.txtID.Value,'ID',-3)
		ThisFormSet.Stocklst_ID_Detail	= PrepareSQLnum(ThisFormset.frmReceiving.txtID_Detail.Value,'ID_Detail',-3)
		ThisFormSet.StockLst_TBL 		= PrepareSQLtxt(ThisFormset.frmReceiving.txtTBL.Value,'TBL',1)
		***
		PRIVATE cSQL, nSQLEXEC 
		
		ThisFormSet.frmReceiving.txtDescript.Value = ''
		IF !( EMPTY(cTBL) OR cTBL = "") AND nID_Detail > 0
		
			IF USED("tmpTable")
				USE IN tmpTable
			ENDIF
			SELECT 0
			
			cSQL = "SELECT dbo.f_DescriptCL(M.Alloy,M.CC,M.CL,M.Form,D.Dim1, D.Dim2, D.Dim3,D.Weight,D.RandLen) AS Descript "
			IF cTBL = 'S'
				cSQL = cSQL + " FROM dbo.StockLst_Master M "
				cSQL = cSQL + " INNER JOIN dbo.StockLst_Detail D ON M.ID = D.ID "
			ELSE
				cSQL = cSQL + " FROM dbo.BrokerLst_Master M "
				cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Detail D ON M.ID = D.ID "
			ENDIF
			cSQL = cSQL + " WHERE D.ID_Detail ="+STR(nID_Detail)
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpTable')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpTable')
			ELSE
				IF USED('tmpTable')
					IF RECCOUNT('tmpTable') > 0
						ThisFormSet.frmReceiving.txtDescript.Value = tmpTable.Descript 
					ENDIF
					USE IN 'tmpTable'
				ENDIF
			ENDIF
		ENDIF
		***
		IF TYPE("pcPOitem") != "C"
			pcPOitem = ''
		ENDIF
		
		PRIVATE cPOitem
		cPOitem = Proper_PO_Item( pcPOitem )
		
		PRIVATE nItemPO, nPO
		nItemPO = Proper_PO_Item_Item(cPOitem)
		nPO		= Proper_PO_Item_PO(cPOitem)
		
		IF cPOitem != Proper_PO_Item( "" )
			ThisFormSet.frmReceiving.Caption = "Receiving PO Item:"+cPOitem
			ThisFormset.frmReceiving.lblHpaPOnum.BorderStyle = 0
			
			IF nPo > 0
				ThisFormSet.GetPoItemDetail(cPOitem)
			ENDIF
			
			ThisFormset.frmReceiving.txtHpaPONum.Value = nPO
			ThisFormset.frmReceiving.txtHpaPOItem.Value = nItemPO
		ELSE
			ThisFormSet.frmReceiving.Caption = "Receiving "
			ThisFormset.frmReceiving.lblHpaPOnum.BorderStyle = 1
		ENDIF
		
	ENDPROC

	PROCEDURE receivingrefreshreceiving
		*ThisForm.ReceivingRefreshReceiving()
		
		*!*	*ThisForm.pf.pgEdit.grdReceiving.RecordSource = ""
		*!*	ThisFormSet.frmReceiving.txtWO_Detail.Value = 0
		*!*	ThisFormSet.frmReceiving.txtReceivingID.Value = 0
		*!*	ThisFormSet.frmReceiving.txtReceived.Value = ''
		*!*	ThisFormSet.frmReceiving.txtHpaPOnum.Value = 0
		*!*	ThisFormSet.frmReceiving.txtHpaPOItem.Value = 0
		*!*	ThisFormSet.frmReceiving.txtSOnum.Value = 0
		*!*	ThisFormSet.frmReceiving.txtSOitem.Value = 0
		
		*!*	ThisFormSet.frmReceiving.txtAlloy.Value = ''
		*!*	ThisFormSet.frmReceiving.txtHeat.Value = ''
		*!*	ThisFormSet.frmReceiving.chkCert.Value = 0
		*!*	ThisFormSet.frmReceiving.txtPieces.Value = 0
		*!*	ThisFormSet.frmReceiving.edtDescription.Value = ''
		*!*	ThisFormSet.frmReceiving.edtSpecs.Value = ''
		*!*	ThisFormSet.frmReceiving.edtComments.Value = ''
		*!*	ThisFormSet.frmReceiving.txtInit.Value = ''
		*!*	ThisFormSet.frmReceiving.txtDate.Value = ''
		*!*	ThisFormSet.frmReceiving.chkPass.Value = 0
		*!*	ThisFormSet.frmReceiving.chkGoodPapers.Value = 0
		*!*	ThisFormSet.frmReceiving.txtActualW.Value = ''
		*!*	ThisFormSet.frmReceiving.txtBillW.Value = ''
		*!*	ThisFormSet.frmReceiving.txtRejectPC.Value = ''
		*!*	ThisFormSet.frmReceiving.txtRejectReason.Value = ''
		*!*	ThisFormSet.frmReceiving.txtVendor.Value = ''
		*!*	ThisFormSet.frmReceiving.txtRMA_No.Value = 0
		*!*	*ThisFormSet.frmReceiving.chkCancel.Value = ''
		
		*!*	PRIVATE nCurrRecvID
		*!*	nCurrRecvID = 0
		*!*	IF USED('Receiving')	
		*!*		nCurrRecvID = Receiving.ID
		*!*		USE IN Receiving
		*!*	ENDIF
		
		*!*	*USE HPA!Receiving SHARED IN 0
		*!*	cSQL = "SELECT * FROM dbo.Receiving ORDER BY ID"
		*!*		
		*!*	SELECT 0
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Receiving')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Receiving')
		*!*	ENDDO
		
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'Receiving')
		*!*		RETURN
		*!*	ELSE
		*!*		SELECT Receiving
		*!*		INDEX ON Received TAG RecvDate
		*!*		INDEX ON POitem TAG POitem
		*!*		INDEX ON INT(VAL(LEFT(PoItem,9))) TAG HPAPO
		*!*		INDEX ON INT(VAL(LEFT(SoItem,7))) TAG SalesNum
		*!*		INDEX ON UPPER(Vendor) TAG UppVendor
		*!*		INDEX ON UPPER(HEAT) TAG UppHeat
		*!*		INDEX ON SOitem TAG SOitem
		*!*		INDEX ON ID_Master TAG ID_Master
		*!*		INDEX ON ID TAG rID
		*!*		SET ORDER TO TAG rID
		*!*		
		*!*		IF nCurrRecvID > 0
		*!*			SEEK nCurrRecvID ORDER TAG rID
		*!*		ENDIF
		*!*		SET ORDER TO RecvDate
		*!*	ENDIF
		
		
		*!*	ThisForm.pf.pgEdit.grdReceiving.RecordSource = "Receiving"
		
		
		*!*	ThisForm.pf.pgEdit.txtReceived.ControlSource = "Receiving.Received"
		*!*	ThisForm.pf.pgEdit.txtPOitem.ControlSource = "Receiving.POitem"
		*!*	ThisForm.pf.pgEdit.txtSOitem.ControlSource = "Receiving.SOitem"
		*!*	ThisForm.pf.pgEdit.txtVendor.ControlSource = "Receiving.Vendor"
		*!*	ThisForm.pf.pgEdit.txtAlloy.ControlSource = "Receiving.Alloy"
		*!*	ThisForm.pf.pgEdit.txtHeat.ControlSource = "Receiving.Heat"
		*!*	ThisForm.pf.pgEdit.chkCert.ControlSource = "Receiving.Cert"
		*!*	ThisForm.pf.pgEdit.edtDescription.ControlSource = "Receiving.Description"
		*!*	ThisForm.pf.pgEdit.txtInit.ControlSource = "Receiving.Init"
		*!*	ThisForm.pf.pgEdit.txtDate.ControlSource = "Receiving.Date"
		*!*	ThisForm.pf.pgEdit.chkPass.ControlSource = "Receiving.Pass"
		*!*	ThisForm.pf.pgEdit.edtSpecs.ControlSource = "Receiving.Specs"
		*!*	ThisForm.pf.pgEdit.txtActualW.ControlSource = "Receiving.ActualW"
		*!*	ThisForm.pf.pgEdit.edtComments.ControlSource = "Receiving.Comments"
		*!*	ThisForm.pf.pgEdit.txtBillW.ControlSource = "Receiving.Billw"
		*!*	ThisForm.pf.pgEdit.chkCancel.ControlSource = "Receiving.Cancelled"
		*!*	ThisForm.pf.pgEdit.txtRejectPC.ControlSource = "Receiving.RejectPC"
		*!*	ThisForm.pf.pgEdit.txtRejectReason.ControlSource = "Receiving.RejectReason"
		
		*!*	ThisForm.pf.pgBrowse.GridBR.RecordSource = "Receiving"
		
		*!*	ThisForm.SetGridReceiving()
		
		*!*	ThisForm.RefreshEditTab()
		IF USED('Receiving')
			SELECT Receiving
		ENDIF
	ENDPROC

	PROCEDURE receivingreload
		*ThisFormSet.ReceivingReLoad()
		
		*!*	ThisForm.pf.pgEdit.grdReceiving.RecordSource = ''
		*!*	ThisForm.pf.pgBrowse.GridBR.RecordSource = ''
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('Receiving')	
			USE IN Receiving
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.Receiving "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Receiving')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'Receiving')
		ENDDO
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'Receiving')
			RETURN
		ELSE
			SELECT Receiving
			INDEX ON Received TAG RecvDate
			INDEX ON POitem TAG POitem
			INDEX ON INT(VAL(LEFT(PoItem,9))) TAG HPAPO
			INDEX ON INT(VAL(LEFT(SoItem,7))) TAG SalesNum
			INDEX ON UPPER(Vendor) TAG UppVendor
			INDEX ON UPPER(HEAT) TAG UppHeat
			INDEX ON SOitem TAG SOitem
			INDEX ON ID_Master TAG ID_Master
			INDEX ON ID TAG rID
		ENDIF
		SET ORDER TO TAG rID
		
		ThisFormSet.frmReceiving.txtID_Detail_Process.Value = 0
		
		*!*	ThisForm.pf.pgEdit.grdReceiving.RecordSource = 'Receiving'
		*!*	ThisForm.pf.pgBrowse.GridBR.RecordSource = 'Receiving'
		*!*	ThisForm.SetGridReceiving()
		
	ENDPROC

