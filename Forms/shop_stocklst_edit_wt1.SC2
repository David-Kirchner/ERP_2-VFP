	ENDPROC

	PROCEDURE frmChooseSO.cmdSelect.Click
		PRIVATE cSOitem, cSO
		cSOitem = Proper_SO_Item(OpenSales.SOitem)
		cSO = ALLTRIM(STR( OpenSales.SalesNum ))
		
		ThisForm.Visible = .F.
		IF NOT ( EMPTY(cSOitem) OR Proper_SO_Item(cSOitem) = Proper_SO_item("") )
			ThisFormset.frmShop_StockLst_Edit.txtSO.Value = cSO
			ThisFormset.frmShop_StockLst_Edit.txtSO.SetFocus()
			*ThisFormset.frmShop_StockLst_Edit.cmdStart.Click
			*ThisFormset.frmShop_StockLst_Edit.cmdStart.setFocus()
		ELSE
			MESSAGEBOX( "None Selected",0+16,"Error" )
			ThisForm.Visible = .T.
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmChooseWO.cmdCancel.Click
