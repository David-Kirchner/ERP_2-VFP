	PROCEDURE frmStockLstProcesses.cmdProcess.Click
		IF RECCOUNT('tmpProcess') > 1
			SELECT tmpProcess
			PRIVATE nRecord
			nRecord = RECNO('tmpProcess')
		
			LOCATE FOR UPPER(process_id) = "INCOMING " OR UPPER(Process_ID) = "NOT2HPA" &&OR UPPER(process_id) = "PARTRECV"
			IF FOUND()
				IF nRecord = RECNO('tmpProcess')
					IF NOT PO_POitem_Cnt(tmpProcess.PO_item,ThisFormSet.nConnhandle,'ConvServ') = 1
						MESSAGEBOX("There is an 'INCOMING' process OR 'Process_ID' = 'NOT2HPA'."+CHR(13)+"Please Receive material first!"+CHR(13)+"Click the Receive button again when 'Process_ID' is 'INCOMING' OR 'Process_ID' = 'NOT2HPA'.",0+48,"Cannot continue.")
						RETURN .F.
					ENDIF		
				ELSE
					IF NOT PO_POitem_Cnt(tmpProcess.PO_item,ThisFormSet.nConnhandle,'ConvServ') = 1
						MESSAGEBOX("There is an 'INCOMING' process OR 'Process_ID' = 'NOT2HPA'."+CHR(13)+"Please Receive material first!"+CHR(13)+"Use <> to find Incoming process!"+CHR(13)+"Click the Receive button again when 'Process_ID' is 'INCOMING' OR 'Process_ID' = 'NOT2HPA'.",0+48,"Cannot continue.")
						RETURN .F.
					ENDIF
				ENDIF
			ENDIF
			
			LOCATE FOR UPPER(process_id) = "PARTRECV"
			IF FOUND()
				MESSAGEBOX("There is an 'PARTRECV' process."+CHR(13)+"You may need to Receive material first!"+CHR(13)+"Use <> to find PARTRECV process!",0+48,"Warning")
			ENDIF
			
			
			GOTO nRecord
		ENDIF
		
		ThisFormSet.ID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		ThisFormSet.Tbl_Process = tmpProcess.Tbl
		*ThisFormSet.ID_Detail_Process_Name = ThisForm.Name
		
		ThisFormSet.Stocklst_ID			= 0 &&PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		ThisFormSet.Stocklst_ID_Detail	= PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3)
		ThisFormSet.StockLst_TBL		= ThisForm.TBL.Value
		
		IF ThisFormSet.nWorkOrder > 0
			PRIVATE cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
			cTBL		= ThisFormSet.StockLst_TBL
			nID_Detail	= ThisFormSet.Stocklst_ID_Detail
			nID_Detail_Process = ThisFormSet.ID_Detail_Process
			cSOitem		= PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
			cPOitem		= PrepareSQLtxt(ThisForm.PO_Item1.Value,'POitem',12)
			nWO			= ThisFormSet.nWorkOrder
			
			DO FORM Forms\Modify_Stocklst_Detail WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
			
			ThisFormSet.RefreshTmpQuotes()
			*ThisFormSet.StockLstProcesses(nID_Detail, 'SOitem', "SHOW")
			ThisFormSet.frmStockLstProcesses.Visible = .F.
			This.Visible = .F.
			
			RETURN .T.
		ENDIF
		
		
		
		PRIVATE lLoadReceiving
		lLoadReceiving = .F.
		
		lLoadReceiving = ThisFormSet.CheckReceivingID_Detail_process( ThisFormSet.ID_Detail_Process, ThisFormSet.Tbl_Process, tmpProcess.PO_Item )
		IF lLoadReceiving
			*Count ....Lst_Process WHERE ID_Detail_Process =
			*AND Process_ID='INCOMING'
			*Found to be Incoming
			
			
		ELSE
			**Added this check 2007-02
			lLoadReceiving = ThisFormSet.CheckReceiving_POitem( ThisFormSet.Tbl_Process, tmpProcess.PO_Item )
			IF lLoadReceiving 
				*Count Receiving Where POitem = 
				
				MESSAGEBOX("Did not find an 'INCOMING' OR 'NOT2HPA' process in "+IIF(ThisFormSet.Tbl_Process="S","StockLst_Process","BrokerLst_Process")+"."+CHR(13)+"Found 'received' record in [Receiving] for POitem '"+tmpProcess.PO_Item+"'",0+64,"Nothing to do!")
				
			ELSE
				PRIVATE cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
				cTBL				= PrepareSQLtxt(tmpProcess.TBL,'TBL',1)
				nID_Detail			= PrepareSQLnum(tmpProcess.ID_Detail,'ID_Detail',-3)
				nID_Detail_Process	= PrepareSQLnum(tmpProcess.ID_Detail_Process,'ID_Detail_Process',-3)
				cSOitem				= PrepareSQLtxt(tmpProcess.SOitem,'SOitem',10)
				cPOitem				= PrepareSQLtxt(tmpProcess.PO_item,'POitem',12)
				nWO					= PrepareSQLnum(tmpProcess.WO,'WO',-3)
		
				ThisFormSet.StockLst_ID_Detail = nID_Detail
				
				DO FORM Forms\Modify_Stocklst_Detail WITH cTBL, nID_Detail, nID_Detail_Process, cSOitem, cPOitem, nWO
				
				ThisFormSet.RefreshTmpQuotes()
				*ThisFormSet.StockLstProcesses(nID_Detail, 'SOitem', "SHOW")
				ThisFormSet.frmStockLstProcesses.Visible = .F.
				
				ThisFormSet.RefreshStockLst("REFRESH", cTBL )
				
				This.Visible = .F.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.cmdReceive.Click
		ThisForm.Visible = .f.
		
		
		PRIVATE cPOitem
		cPOitem = PrepareSQLtxt(thisForm.PO_Item1.Value,'POitem',12)
		
		ThisFormSet.ID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
