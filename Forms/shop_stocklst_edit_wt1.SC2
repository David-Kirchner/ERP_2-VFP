	PROCEDURE frmReceiving.cmdAdd.Valid
		PRIVATE lReady2Save
		lReady2Save = .T.
		lReady2Save = ThisFormSet.ReceivingCheckSave()
		IF lReady2Save
			IF ThisFormSet.ReceivingSaveAdd("ADD")
				ThisFormSet.ReceivingUnload()
			ELSE
				RETURN .F.
			ENDIF
		ELSE
			RETURN .F.
		ENDIF
		
		
		ThisForm.Visible = .F.
		
		RETURN .T.
	ENDPROC

	PROCEDURE frmReceiving.cmdClear.Click
		ThisFormSet.ReceivingResetAddVars()	
		*This.Parent.cmdAdd.Caption = "\<Save"
		
		*This.Parent.txtHpapo.Enabled = .T.
		*This.Parent.txtItempo.Enabled = .T.
		
		ThisForm.Refresh
		ThisForm.txtHpaPONum.SetFocus
	ENDPROC

	PROCEDURE frmReceiving.cmdClone.Valid
		PRIVATE lReady2Save, nReceivingID
		lReady2Save = .T.
		lReady2Save = ThisFormSet.ReceivingCheckSave()
		nReceivingID = PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		
		PRIVATE cPOitem, nHpaPo, nItemPo
		nHpaPo = ThisForm.txtHpaPONum.Value
		IF TYPE("nHpaPo") = "C"
			nHpaPo = VAL(nHpaPo)
		ENDIF
		nItemPo = ThisForm.txtHpaPOItem.Value
		IF TYPE("nItemPo") = "C"
			nItemPo = VAL(nItemPo)
		ENDIF
		
		cPOitem = Proper_PO_item( STR(nHPApo,9,0)+"-"+STR(nItemPo,2,0) )
		
		IF EMPTY(This.Parent.edtDescription.Value)
			lReady2Save = .F.
			MESSAGEBOX( "No Valid Description", 0,"Cannot Save")
		ENDIF
		IF EMPTY(This.Parent.txtHeat.Value)
			lReady2Save = .F.
			MESSAGEBOX( "No Valid Heat"+CHR(13)+"Must not be blank", 0,"Cannot Save")
		ENDIF
		
		IF lReady2Save
		
			PRIVATE cHeat
			cHeat = PrepareSQLtxt(ThisForm.txtHeat.Value,"Heat",30)
		
			IF ThisFormSet.ReceivingSaveAdd("ADDCLONE")
				
			ELSE
				RETURN .F.
			ENDIF
			
			ThisForm.txtHpaPONum.Value = nHpaPo
			ThisForm.txtHpaPOItem.Value = nItemPo 
		ELSE
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE frmReceiving.lblChooseReceivingID.Click
		PRIVATE cPOitem, nHpaPo, nItemPo, nReceiveID
		nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(This.Parent.txtHpaPOItem.Value,'ItemPO',2,0)
		IF nItemPo = 0
			nItemPo = 1
		ENDIF
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		
		nReceiveID = 0
		
		IF nHPAPO > 0
			DO FORM Forms\ChooseReceivingID WITH cPOitem, "POitem" TO nReceiveID
			IF nReceiveID > 0
				This.Parent.txtReceivingID.Value = nReceiveID
				IF MESSAGEBOX("Here is a chance to overwrite the Receive screen data."+CHR(13)+"Do you want to Overwrite this data?",4+32+256,"Replace Data") = 6
					ThisFormSet.GetBy_ReceivingID(nReceiveID)
				ENDIF
			ELSE
				WAIT WINDOW "No Change to Receiving ID" NOWAIT
			ENDIF	
		ELSE
			MESSAGEBOX("Please enter the HPA PO / POitem to start!",0+48,"No PO number!")
		ENDIF
	ENDPROC

	PROCEDURE frmReceiving.lblHpaPOnum.Click
		PRIVATE cPOitem, nHpaPo, nItemPo, cHeat
		nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HPApo',-3)
		nItemPo = PrepareSQLnum(This.Parent.txtHpaPOItem.Value,'ItemPO',2,0)
		
		cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
		cHeat= ALLTRIM(PrepareSQLtxt(This.Parent.txtHeat.Value,'Heat',50))
		
		*IF nItemPo = 0 
			IF nHpaPo > 0
				*Choose a HPApo
				ThisForm.ChoosePOitemLoad(nHPApo)
			ELSE
				ThisForm.ChoosePOitemLoad(0)
			ENDIF
		
			*Refresh
			nHpaPo = PrepareSQLnum(This.Parent.txtHpaPONum.Value,'HPApo',-3)
			nItemPo = PrepareSQLnum(This.Value,'ItemPO',2,0)
			cPOitem = Proper_PO_Item( ALLTRIM(STR(nHPApo))+"-"+STR(nItemPo,2,0) )
				
		
			IF nItemPo = 0
				ThisFormSet.ChoosePOitemLoad(nHpaPo)
			ELSE
				IF nHpaPo > 0 AND nItemPo > 0
					IF EMPTY(cHeat) 
						ThisForm.GetPoItemDetail(cPOitem)
					ELSE
						ThisForm.GetFromReceiving(cPOitem,cHeat)
					ENDIF
				ENDIF
			ENDIF
		**
			
		*IF This.BorderStyle = 1
		
			IF nItemPo = 0
				ThisFormSet.ChoosePOitemLoad(nHpaPo)
				RETURN
			ELSE
				IF nHpaPo > 0 AND EMPTY(cHeat) 
					ThisFormSet.GetPoItemDetail(cPOitem)
				ELSE
					ThisFormSet.GetFromReceiving(cPOitem,cHeat)
				ENDIF
			ENDIF
		*ENDIF
		
	ENDPROC

	PROCEDURE frmReceiving.lblOrderdate.Click
		PRIVATE m.dDate1,m.dDate2
		
		m.dDate1 = ThisForm.txtReceived.Value
		DO FORM "forms\popupdate.scx" WITH m.dDate1 TO m.dDate2
		ThisForm.txtReceived.Value = m.dDate2
		ThisForm.txtReceived.Refresh
		ThisForm.txtReceived.SetFocus
		
		
	ENDPROC

