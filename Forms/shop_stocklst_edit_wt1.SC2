		*lLoadReceiving = ThisFormSet.CheckReceivingID_Detail_Process( ThisFormSet.ID_Detail_Process, ThisFormSet.ID_Detail_Process, tmpProcess.PO_Item ) 
		*CALLS: DO FORM Forms\Receive_Edit WITH 'Brk_Detail', nID_Detail ,cHeat
		
		IF lLoadReceiving
			*Count ....Lst_Process WHERE ID_Detail_Process =
			*AND Process_ID='INCOMING'
			*Found to be Incoming
			
		
		ELSE
			**Added this check 2007-02
			lLoadReceiving = ThisFormSet.CheckReceiving_POitem( ThisFormSet.Tbl_Process, tmpProcess.PO_Item )
			*CALLS: DO FORM Forms\Receive_Edit WITH 'Brk_Detail', nID_Detail ,cHeat
			
			IF lLoadReceiving 
				*Count Receiving Where POitem = 
				MESSAGEBOX("Did not find an 'INCOMING' OR 'NOT2HPA' OR 'PARTRECV' process in "+IIF(ThisFormSet.Tbl_Process="S","StockLst_Process","BrokerLst_Process")+"."+CHR(13)+"Found 'received' record in [Receiving] for POitem '"+tmpProcess.PO_Item+"'",0+64,"Nothing to do!")
			ELSE
				
				*ThisFormSet.ReceivingLoad(cPOitem)
				*ThisFormSet.ReceivingSaveAdd("ADD")
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.cmdRemoveProcess.Click
		*frmStockLstProcess.cmdRemoveProcess.click
		PRIVATE cTBL 
		cTBL = ThisFormSet.Tbl_Process
		
		IF MESSAGEBOX("Are you sure you want to remove this Process?",4+32,"Remove?") = 6
			*Remove Process
			ThisFormSet.ID_Detail_Process = ThisForm.ID_Detail_Process1.Value
			ThisFormSet.Tbl_Process = tmpProcess.Tbl
		
			PRIVATE cSQLn, cSQLd, nID_Detail_Process
			nID_Detail_Process = ThisFormSet.ID_Detail_Process
		
		
			*Check to see if a process 
			cSQLn = "SELECT COUNT(*) AS counted FROM "
			DO CASE
			CASE cTBL = "S"
				cSQLn = cSQLn + " dbo.StockLst_Process "
			CASE cTBL = "B"
				cSQLn = cSQLn + " dbo.BrokerLst_Process "
			CASE cTBL = "W"
				cSQLn = cSQLn + " dbo.WIPLst_Process "
			OTHERWISE
				MESSAGEBOX("cmdRemoveProcess.click did not recognize Table Name",0+16,"Aborting Save!")
				TrackError("cmdRemoveProcess.click did not recognize Table Name","cmdRemoveProcess.click did not recognize Table Name","frmShop_StockLst_Edit.cmdRemoveProcess.click",LINENO())
				RETURN .F.
			ENDCASE
			cSQLn = cSQLn + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+""
		
			IF USED("StockLst_Detail_Count")
				SELECT StockLst_Detail_Count
			ELSE
				SELECT 0
			ENDIF
		
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLn , 'StockLst_Detail_Count')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn , 'StockLst_Detail_Count')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQLn, ThisFormSet.nConnHandle,nSQLEXEC, 'StockLst_Detail_Count')
			ELSE
				IF StockLst_Detail_Count.Counted > 0
				
					*Remove old Process
					cSQLd = "DELETE FROM "
					DO CASE
					CASE cTBL = "S"
						cSQLd = cSQLd + " dbo.StockLst_Process "
					CASE cTBL = "B"
						cSQLd = cSQLd + " dbo.BrokerLst_Process "
					CASE cTBL = "W"
						cSQLd = cSQLd + " dbo.WIPLst_Process "
					ENDCASE
					cSQLd = cSQLd  + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+""
					 
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
					ENDDO
					IF nSQLEXEC < 0
						*Could not Delete
						SQLEXECError(cSQLd, ThisFormSet.nConnHandle,nSQLEXEC)
					ELSE
						DO CASE
						CASE cTBL = "S"
							cSQLd = "UPDATE HPAlloy_Archive.dbo.StockLst_Process_History "
						CASE cTBL = "B"
							cSQLd = "UPDATE HPAlloy_Archive.dbo.BrokerLst_Process_History "
						CASE cTBL = "W"
							cSQLd = "UPDATE HPAlloy_Archive.dbo.WIPLst_Process_History "
						ENDCASE
						cSQLd = cSQLd + " SET [WHAT]='SUBED' WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process))+ " AND [What] = 'DELETE' "
						
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
						ENDDO
						IF nSQLEXEC < 0
							SQLEXECError(cSQLd, ThisFormSet.nConnHandle,nSQLEXEC)
						ENDIF
						
						ThisFormSet.RefreshTmpQuotes()  &&grdSO
						
						WAIT WINDOW "Deleted 'INCOMING' process." NOWAIT
					ENDIF
				ENDIF
			ENDIF
		
			***End Process
			ThisForm.Visible = .F.
			ThisFormSet.RefreshTmpQuotes()
		ENDIF
	ENDPROC

	PROCEDURE frmStockLstProcesses.cmdShowStockLst.Click
		**********************************
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisForm.tbl.Value,'TBL',1)
		PRIVATE nID_Detail
		nID_Detail = PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail',-3)
		
		IF ThisFormSet.SetSelectedID_Detail('ID_Detail',nID_Detail,cTBL)
			**Should already be set!
		ENDIF
		**********************************
		
		DO CASE
		CASE cTBL = "S"
			ThisFormSet.RefreshStockLst("REFRESH",'StockLst ')
		CASE cTBL = "B"
			ThisFormSet.RefreshStockLst("REFRESH",'BrokerLst ')
		CASE cTBL = "W"
			ThisFormSet.RefreshStockLst("REFRESH",'WIPLst ')
		ENDCASE
		
		IF USED('vStockLst_SQL')
			SELECT vStockLst_SQL
		
			ThisFormSet.frmStockLst.grdStockLst.Visible = .T.
			ThisFormSet.frmStockLst.Visible = .T.
			ThisFormSet.RefreshStockStatus()
			ThisFormSet.frmStockStatus.Visible = .T.
		
			ThisFormSet.frmStockLst.grdStockLst.Refresh
			ThisFormSet.frmStockLst.grdStockLst.SetFocus()
		ELSE
			MESSAGEBOX("Table 'vStockLst_SQL' not found!",0,"SQL: Error")
		ENDIF 
	ENDPROC

	PROCEDURE frmStockLstProcesses.LBLDUEDATE1.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(ThisForm.DueDATE1.Value)
			dDate1 = ThisForm.DueDATE1.Value 
		ELSE
			dDate1 = DATE()+10
		ENDIF
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.DueDATE1.Value = dDate2
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.lblPOitem.Click
		PRIVATE cPOitem, nMessn nWO
		cPOitem = PrepareSQLtxt(ThisForm.PO_ITEM1.Value,'POitem',12)
		nWO		= PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		
		IF ThisForm.cmdReceive.Visible
			MESSAGEBOX("Is this the POitem:"+ALLTRIM(cPOitem)+CHR(13)+"allready has a create 'INCOMING' OR 'NOT2HPA' OR 'PARTRECV' process.",0,"Cannot Create Process")
			RETURN
		ENDIF
		
		nMess = MESSAGEBOX("Is this the POitem:"+ALLTRIM(cPOitem)+CHR(13)+"or WO:"+ALLTRIM(STR(nWO))+CHR(13)+"you want to create an 'INCOMING' OR 'NOT2HPA' process for?",4+32,"Create new INCOMING Process")
		
		IF nMess <> 6
			RETURN
		ENDIF
		
		PRIVATE cSQLi, nSQLEXEC 
		PRIVATE nID_Detail,cSalesPerson,dStartDate,dDueDate
		PRIVATE cAllowSub,npWeight,cSOitem,nWO,cProcess_ID,cProcessor,cComment
		PRIVATE cTbl
		
		nID_Detail	 	= PrepareSQLnum(ThisForm.ID_Detail.Value,'ID_Detail', -3,0 )
		cSalesPerson 	= PrepareSQLtxt(ThisForm.SalesPerson1.Value,'SalesPerson',20)
		dStartdate	 	= PrepareSQLdate(ThisForm.StartDate1.Value,'StartDate') &&DATE()
		dDueDate 		= PrepareSQLdate(ThisForm.DueDate1.Value,'DueDate')
		cAllowSub 		= PrepareSQLtxt(ThisForm.AllowSub1.Value,'AllowSub',1)
		nPU				= PrepareSQLnum(ThisForm.PU1.Value,'PU',-1)
		nQTY			= PrepareSQLnum(ThisForm.QTY1.Value,'QTY',18,4)
		npWeight 		= PrepareSQLnum(ThisForm.pWeight1.Value,'pWeight',9,1)
		cSOitem 		= Proper_SO_Item(ThisForm.SOitem1.Value)
		nWO				= PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		cProcess_ID 	= "INCOMING"
		cProcessor		= PrepareSQLtxt(ThisForm.Processor1.Value,'Processor',20)
		cComment 		= "ReCreated Incoming: "+PrepareSQLtxt(ThisForm.Comment1.Value,'Comment',100)
		cTBL			= PrepareSQLtxt(ThisForm.TBL.Value,'TBL',1)
		***~Check DATA
		
		
		IF USED('tmpProcess')
			PRIVATE nRecnum
			nRecNum = RECNO('tmpProcess')
			
			SELECT tmpProcess
			IF nWO > 0
				IF Proper_PO_item(cPOitem) = Proper_PO_item('')
					LOCATE FOR WO = nWO AND ( Process_ID = "INCOMING" OR Process_ID = "NOT2HPA" OR Process_ID = "PARTRECV" )
				ELSE
					LOCATE FOR WO = nWO AND PO_item = cPOitem AND ( Process_ID = "INCOMING" OR Process_ID = "NOT2HPA" OR Process_ID = "PARTRECV" )
				ENDIF
			ELSE
				LOCATE FOR PO_item = cPOitem AND ( Process_ID = "INCOMING" OR Process_ID = "NOT2HPA" OR Process_ID = "PARTRECV" )
			ENDIF
			
			IF FOUND('tmpProcess')
				MESSAGEBOX("Is this the POitem:"+ALLTRIM(cPOitem)+CHR(13)+"or WO:"+ALLTRIM(STR(nWO))+CHR(13)+"allready has a create 'INCOMING' OR 'NOT2HPA' OR 'PARTRECV' process.",0,"Cannot Create Process")
				
				IF nRecNum > 0
					GOTO nRecNum
				ELSE
					GO TOP
				ENDIF
				
				RETURN
				
			ENDIF
		ENDIF
		
		
		************************************
		* Make sure Sales is not listed as Cmplt
		* Sales Update Trigger will DELETE this process if Sales is CMPLT
		IF Proper_SO_item(cSOitem) != Proper_SO_item('')
			cSQL = "UPDATE dbo.Sales SET [cmplt] = 0 "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		************************************
		* Make sure PurchaseOrder is not listed as Delivered
		* PurchaseOrder Update trigger will DELETE this Process if PO is Delivered
		IF Proper_SO_item(cSOitem) != Proper_SO_item('')
			cSQL = "UPDATE dbo.PurchaseOrder SET Delivered = 0 "
			cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
			ENDIF
		ENDIF
		
		*****************************************
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		*Save Process
		*p_StockLst_Process_ins
		IF cTbl = "B"
			cSQLi = "EXEC dbo.p_BrokerLst_Process_ins6 "
		ELSE
			cSQLi = "EXEC dbo.p_StockLst_Process_ins6 "
		ENDIF
		cSQLi = cSQLi + " @ID_Detail = "+STR(nID_Detail)+""
		cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
		cSQLi = cSQLi + ",@Startdate = '"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
		cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
		cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"
		cSQLi = cSQLi + ",@PU = "+STR(nPU)
		cSQLi = cSQLi + ",@QTY = "+STR(nQTY)
		cSQLi = cSQLi + ",@Pounds = "+STR(npWeight,9,1)
		cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
		cSQLi = cSQLi + ",@WO = "+STR(nWO)
		cSQLi = cSQLi + ",@PO_Item = '"+cPOItem+"'"
		cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"
		cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
		cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
		cSQLi = cSQLi + ",@ReceivingID = 0"
		
		
		nTran = SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		ENDDO
		
		IF nSQLEXEC < 0
			*retry
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
		ENDIF
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi, ThisFormSet.nConnHandle,nSQLEXEC,'tmpID_Detail_Process')
			TrackError("p_StockLst_Process_ins","Could not EXEC dbo.p_StockLst_Process_ins","Shop_StockLst_Edit.ModiProcess.cmdSave()",LINENO())
			nTran = SQLROLLBACK(ThisFormSet.nConnHandle)
			nTran = SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
			RETURN
		ELSE
			nTran = SQLCOMMIT(ThisFormSet.nConnHandle)
			nTran = SQLSETPROP(ThisFormSet.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		ENDIF	
		
		IF USED('tmpID_Detail_Process')
			IF RECCOUNT('tmpID_Detail_Process')>0
			
				ThisForm.ID_Detail_Process1.Value = tmpID_Detail_Process.Exp
				ThisFormSet.ID_Detail_Process	  = tmpID_Detail_Process.Exp
				USE IN tmpID_Detail_Process
					
		*		ThisForm.ID_Detail_Process1.Refresh
		*		ThisForm.ID_Detail_Process1.Visible = .T.
					
				IF Proper_SO_item(cSOitem) != Proper_SO_item('')
					*UPDATE Sales SET prcp = .T. WHERE SOitem = (m.SOitem)  &&Has trigger to delete Cmplt Processes!!!!
					Update_PrcpPrcdinSales( .T.,.F.,cSOitem,ThisFormSet.nConnHandle )
					* && Has trigger to delete Cmplt Processes!!!!
				ENDIF
		
				*This.Enabled = .F.
				*ThisForm.ogSOitem.Enabled = .F.
				*ThisForm.cmdModifyStockLst.Enabled = .T.
				*THISFORM.cmdShowStockLst.Enabled = .T.
				*THISFORM.cmdEditStockLst.Enabled = .T.
				*ThisForm.lblStartDate1.Enabled = .F.
				*ThisForm.lblDueDate1.Enabled = .F.
				*ThisForm.Visible = .F.
						
		
		*		IF ThisFormSet.frmStockLst.Visible
					ThisFormSet.StockLst_ID_Detail = nID_Detail
					*ThisFormSet.RefreshStockLst("RELOAD",IIF(cTbl = "S","StockLst ","BrokerLst") )
		*		ENDIF
					
				ThisFormSet.RefreshtmpQuotes()
				
				ThisFormSet.StockLstProcesses(nID_Detail, "ID_Detail", "INCOMING")
				
				MESSAGEBOX("Created Incoming Process",0,"Done")
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.LBLSOITEM1.Click
		PRIVATE vcSOitem, cSOitem, nSO
		cSOitem = PrepareSQLtxt(This.Parent.SOITEM1.Value,'SOitem',10)
		nSO = VAL(cSOitem)
		
		DO FORM Forms\Select_SO-item WITH nSO TO vcSOitem
		
		PRIVATE cText
		cText = ''
		IF VARTYPE(vcSOitem) = "C"
			IF NOT Proper_SO_item(vcSOitem) = Proper_SO_item('')
				vcSOitem = Proper_SO_item('')
			ENDIF
		ENDIF
		IF NOT Proper_SO_item(cSOitem) = Proper_SO_item('')
			IF Proper_SO_item(cSOitem) = Proper_SO_item(vcSOitem)
				*Allready there.
			ELSE
				cText = "New SOitem="+ALLTRIM(vcSOitem)+"!"
				cText = cText +CHR(13)+"Old SOitem="+ALLTRIM(cSOitem)+"!"
				IF MESSAGEBOX("Do you wish to replace the SOitem?"+CHR(13)+cText,4+32,"Change SO data") = 6
					*needs permision , verified.
					
					This.Parent.SOItem1.Value = vcSOitem
					
					TrackError("Info","User wished to replace the SOitem. "+cText,"StockLst_Process",LINENO())
					TrackMess( "User wished to replace the SOitem. "+cText )
				ENDIF
			ENDIF
		ENDIF
		
		IF vcSOitem = Proper_SO_item('')
			cText = "Old SOitem="+ALLTRIM(cSOitem)+"!"
			IF MESSAGEBOX("Do you wish to Erase this?"+CHR(13)+cText,4+32,"Remove SO data") = 6
				This.Parent.SOItem1.Value = ""
				
				TrackError("Info","User wished to erase the SOitem. "+cText,"StockLst_Process",LINENO())
				TrackMess( "User wished to erase the SOitem. "+cText )
				
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.LBLSTARTDATE1.Click
		PRIVATE dDate1, dDate2
		
		IF !EMPTY(ThisForm.STARTDATE1.Value)
			dDate1 = ThisForm.STARTDATE1.Value 
		ELSE
			dDate1 = DATE()+10
		ENDIF
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		
		ThisForm.STARTDATE1.Value = dDate2
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.lblWO.Click
		PRIVATE vnWO, nWO
		This.Parent
		nWO = PrepareSQLnum(This.Parent.WO1.Value,'WO',10)
		PRIVATE cSOitem, cPOitem 
		cSOitem = PrepareSQLtxt(This.Parent.SOITEM1.Value,'SOitem',10)
		cPOitem = PrepareSQLtxt(This.Parent.PO_Item1.Value,'POitem',12)
		
		DO FORM Forms\Select_WorkOrder WITH cSOitem, cPOitem TO vnWO
		
		PRIVATE cText
		cText = ''
		
		IF VARTYPE(vnWO) = "N"
			vcWO = 0
		ENDIF
		
		
		IF nWO = vnWO AND vnWO > 0
			*Allready there.
		ELSE
			cText = "New WO="+ALLTRIM(STR(vnWO))+"!"
			cText = cText +CHR(13)+"Old WO="+ALLTRIM(STR(nWO))+"!"
			IF MESSAGEBOX("Do you wish to replace the WO?"+CHR(13)+cText,4+32,"Change WO data") = 6
				*needs permision , verified.
				
				ThisForm.txtWO.Value = vnWO
							
				TrackError("Info","User wished to replace the WO. "+cText,"shop_stocklst_edit.StockLst_Process",LINENO())
				TrackMess( "User wished to replace the WO. "+cText )
		
			ENDIF
		ENDIF
		
		
		IF vnWO = 0
			cText = "Old WO="+ALLTRIM(STR(nWO))+"!"
			IF MESSAGEBOX("Do you wish to Remove this WO?"+CHR(13)+cText,4+32,"Remove WO data") = 6
				This.Parent.WO1.Value = 0
				
				TrackError("Info","User wished to Remove the WO. "+cText,"shop_stocklst_edit.StockLst_Process",LINENO())
				TrackMess( "User wished to Remove the WO. "+cText )
		
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE frmStockLstProcesses.txtRec.Valid
		
		
	ENDPROC

