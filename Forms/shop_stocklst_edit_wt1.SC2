		ThisFormSet.nStockLst_ID = 0
		*Not safe to keep ID
	ENDPROC

	PROCEDURE frmShop_StockLst_Edit.cmdBkr.Click
		IF NOT USED('tmpSO')
			MESSAGEBOX("Cannot continue without a Sales Order",0+16,"No SO!")
			RETURN .F.
		ENDIF
		
		*******************************************************
		PRIVATE lCheckForIncoming
		lCheckForIncoming = .F.
		
		PRIVATE cAlloy, cForm, nThck, cCC, cCL
		cAlloy = PrepareSQLtxt(tmpSO.Alloy,'Alloy',12,.T.)
		cForm  = Proper_Form(PrepareSQLtxt(tmpSO.Form,'Form',2,.T.))
		cCC	   = PrepareSQLtxt(tmpSO.CC,'CC',1)
		cCL	   = PrepareSQLtxt(tmpSO.CL,'CL',1)
		
		PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL, cPOitem 
		nThck	= PrepareSQLnum(tmpSO.Thck,'Thck',9,3) &&nThck	= PrepareSQLnum(tmpSO.Dim1,'Thck',9,3)
		nSz2	= PrepareSQLnum(tmpSO.Sz2,'Sz2',9,3)	&&nSz2	= PrepareSQLnum(tmpSO.Dim2,'Sz2',9,3)
		nSz3	= PrepareSQLnum(tmpSO.Sz3,'Sz3',9,3)	&&nSz3	= PrepareSQLnum(tmpSO.Dim3,'Sz3',9,3)
		nPC		= PrepareSQLnum(tmpSO.PC,'PC',-3)
		nLBS	= PrepareSQLnum(tmpSO.Weight,'Weight',7,1)
		lRL		= PrepareSQLlogic(tmpSO.RandLen,'RandLen')
		cPOitem = PrepareSQLtxt(tmpSO.POitem,'POitem',12)	&&tmpSO holds PO WHERE 'SELECTED' OR SP.Process_ID = 'PARTSELECT'
		
		******************************************************
		IF EMPTY(cPOitem)	
			*A Broker without a PO!  This is wrong
			*Find the POitem
			
			ThisFormSet.VisibleForms()
			ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
			ThisFormSet.frmQuote.Top = ThisFormSet.frmQuote.Top + 150
		
			MESSAGEBOX("This Broker does not have a PO!"+CHR(13)+"This is impossible."+CHR(13)+"Please reconnect the PO item to this Sales Order"+CHR(13)+"next, a window will open to select the correct PO item",0+64,"Find correct PO item.")
			DO FORM Forms\SelectPO_item WITH ThisFormSet.SalesNum TO cPOitem
			
			ThisFormSet.frmQuote.Top = ThisFormSet.frmQuote.Top - 150
			ThisFormSet.VisibleFormsReset()
		
			cPOitem = PrepareSQLtxt(cPOitem,'POitem',12)
			IF EMPTY(cPOitem)
				MESSAGEBOX("Please have the Sales man correct the PO for this Brokered Sales Order.",0,"Cannot continue.")
				RETURN .F.
			ELSE
				*Shop will still be allowed to mark as 'SELECTED'
				*If shop does 'SELECT' check for 'INCOMING' OR cProcess_ID = "NOT2HPA"  because that may also be screwed up.
				lCheckForIncoming = .T.
			ENDIF
		ENDIF
		******************************************************
		
		PRIVATE cHeatLot
		*cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpSO.Heat)+" "+ALLTRIM(tmpSO.Lot),'HeatLot',60)
		cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpSO.Heat),'HeatLot',60)
		
		PRIVATE nSalesNum, nItem, cSOitem, nQTY
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		nQTY		= PrepareSQLnum(tmpSO.Qty ,'S_QTY ',-5)
		
		PRIVATE cTBL,nID_Detail
		cTBL = 'B'
		nID_Detail = 0
		
		ThisFormSet.VisibleForms()
		ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
		ThisFormSet.frmQuote.Visible = .F.
									
		DO FORM  Forms\StockLst_SQL_Quotes WITH "SELECT",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPOitem TO nID_Detail
		*DO FORM Forms\StockLst_SQL_Quotes WITH pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem TO ID_Detail
		
		IF PrepareSQLnum(nID_Detail,'ID_Detail',-3) > 0
			IF lCheckForIncoming = .T.
				*The POitem was lost from the SalesNo. 
				*POitem was just 'SELECTED' 
				*Add 'INCOMING TO Process if Needed.
				IF StockLst_Process_Count_POitem( cPOitem, cTBL, ThisFormSet.nConnHandle, 'INCOMING') = 0
					*Create an INCOMING Process
					
					IF Receiving_CreateProcess(cTBL,cSOitem,cPOitem,0,nID_Detail,'INCOMING','Created Process for POitem:'+cPOitem )
					ENDIF
					
				ENDIF
			ENDIF
		ENDIF
		
		ThisFormSet.VisibleFormsReset()
									
		ThisFormSet.RefreshTmpQuotes()
		
		RETURN
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		********************************************************
		PRIVATE lShow
		lShow = .T.
		
		PRIVATE nWO, cSOitem
		nWO = PrepareSQLnum(tmpSO.WO,'WO',-3)
		cSOitem = PrepareSQLtxt(tmpSO.SOitem,'SOitem',10)
		
		IF LEFT(ThisFormSet.frmStockLst.Caption,9) = "StockLst "
			IF ThisFormSet.frmStockLst.Visible
				lShow = .T.	
			ELSE
				lShow = .T.
			ENDIF
		ENDIF
		IF LEFT(ThisFormSet.frmStockLst.Caption,9) = "BrokerLst"
			IF ThisFormSet.frmStockLst.Visible
				lShow = .F.	
			ELSE
				lShow = .T.
			ENDIF
		ENDIF
		
		ThisFormSet.StockLst_TBL = 'B'
		ThisFormSet.Stocklst_ID = 0
		ThisFormSet.Stocklst_ID_Detail = 0
		
		
		IF NOT lShow
			ThisFormSet.frmStockLst.Visible = .F.
			ThisFormSet.frmStockStatus.Visible = .F.
			ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
			ThisFormSet.frmSimiliarSales.Visible = .F.
			*ThisFormset.frmStockLst.cmdMark.Visible = .T.
			*ThisFormset.frmStockLst.cmdInvCorrection.Visible = .T.
			*ThisFormset.frmStockLst.cmdShowPrc.Caption = "Show Prc"
		ELSE
			
			ThisFormSet.frmStockLst.Caption = "BrokerLst"
		*	ThisFormset.frmStockLst.cmdMark.Visible = .T.
		*	ThisFormset.frmStockLst.cmdInvCorrection.Visible = .T.
			ThisFormset.frmStockLst.cmdShowPrc.Caption = "Show Bkr"
			
			IF ThisFormSet.SetSelectedID_Detail('SOitem',tmpSO.SOitem,"B")
				*Sets ThisFormSet.StockLst_ID_Detail from Incoming or Selected Process
			ELSE
				PRIVATE cMess 
				IF tmpSO.Bkr > 0
					cMess = "SOitem:"+ALLTRIM(tmpSO.SOitem)+" shows "+ALLTRIM(STR(tmpSO.Bkr))+" process,"+CHR(13)+" But none where found to show in BrokerLst."
					MESSAGEBOX(cMess,48,"Exact STK not found!") 
				ELSE
					cMess = "SOitem:"+ALLTRIM(tmpSO.SOitem)+" shows NO Bkr process"
					MESSAGEBOX(cMess,48,"Just showing Bkr list!") 
				ENDIF
			ENDIF
		
			ThisFormSet.RefreshStockLst("RELOAD","BrokerLst")
			
			PRIVATE nBestItem, nThckplus, nThckMinus 
			PRIVATE cAlloy, cForm, nThck, cCC, cCL
		
			cAlloy = PrepareSQLtxt(tmpSO.Alloy,'Alloy',12,.T.)
			cForm  = Proper_Form(PrepareSQLtxt(tmpSO.Form,'Form',2,.T.))
			nThck  = PrepareSQLnum(tmpSO.Thck,'Thck',9,3)
			cCC	   = PrepareSQLtxt(tmpSO.CC,'CC',1)
			cCL	   = PrepareSQLtxt(tmpSO.CL,'CL',1)
			
			PRIVATE cFormSort, cCCSort, nCCSortValue
			cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisFormSet.nConnHandle),2,0))
			nCCSortValue = CCSortValue( cCC, ThisFormSet.nConnHandle) 
			cCCSort = STR(nCCSortValue,2,0)
		
			SELECT vStockLst_SQL
			
			IF !EMPTY(cAlloy) AND !EMPTY(cFormSort) AND !EMPTY(cCCSort) AND !EMPTY(nThck)
				*Find Alloy, Form, CC and Thickness
				SET ORDER TO TAG AlFmsCCsS
				SEEK cAlloy+cFormSort+cCCSort+STR(nThck,9,3) IN vStockLst_SQL ORDER AlFmsCCsS
				nBestItem =RECNO('vStockLst_SQL')
				IF nBestItem > RECCOUNT('vStockLst_SQL')
					*Check to see if a fraction under
					nThckplus = nThck+.001
					SEEK cAlloy+cFormSort+cCCSort+STR(nThckplus, 9,3)
					nBestItem =RECNO('vStockLst_SQL')
					IF nBestItem > RECCOUNT('vStockLst_SQL')
					*Check to see if a fraction over
						nThckMinus = nThck-.001
						SEEK cAlloy+cFormSort+cCCSort+STR(nThckMinus, 9,3)
						nBestItem =RECNO('vStockLst_SQL')
		
						IF nBestItem > RECCOUNT('vStockLst_SQL')
							*Check to see if under
							nThckplus = nThck+.1
							SEEK cAlloy+cFormSort+cCCSort+STR(nThckplus, 9,3)
							nBestItem =RECNO('vStockLst_SQL')
							IF nBestItem > RECCOUNT('vStockLst_SQL')
							*Check to see if over
								nThckMinus = nThck-.1
								SEEK cAlloy+cFormSort+cCCSort+STR(nThckMinus, 9,3)
								nBestItem =RECNO('vStockLst_SQL')
							ENDIF	
						ENDIF
		
					ENDIF	
				ENDIF
			ELSE
				nBestItem = RECCOUNT('vStockLst_SQL')+1
			ENDIF
		
			IF nBestItem > RECCOUNT('vStockLst_SQL')
				IF !EMPTY(cAlloy) AND !EMPTY(cForm) AND !EMPTY(nThck)
					SET ORDER TO TAG StockLstC
					SEEK cAlloy+cForm+STR(nThck,9,3)
					nBestItem =RECNO('vStockLst_SQL')
					IF nBestItem > RECCOUNT('vStockLst_SQL')
						*Check to see if a fraction under
						nThckplus = nThck+.001
						SEEK cAlloy+cForm+STR(nThckplus, 9,3)
						nBestItem =RECNO('vStockLst_SQL')
						IF nBestItem > RECCOUNT('vStockLst_SQL')
						*Check to see if a fraction over
							nThckMinus = nThck-.001
							SEEK cAlloy+cForm+STR(nThckMinus, 9,3)
							nBestItem =RECNO('vStockLst_SQL')
		
							IF nBestItem > RECCOUNT('vStockLst_SQL')
								*Check to see if under
								nThckplus = nThck+.1
								SEEK cAlloy+cForm+STR(nThckplus, 9,3)
								nBestItem =RECNO('vStockLst_SQL')
								IF nBestItem > RECCOUNT('vStockLst_SQL')
								*Check to see if over
									nThckMinus = nThck-.1
									SEEK cAlloy+cForm+STR(nThckMinus, 9,3)
									nBestItem =RECNO('vStockLst_SQL')
								ENDIF	
							ENDIF
		
						ENDIF	
					ENDIF
				ELSE
					nBestItem = RECCOUNT('vStockLst_SQL')+1
				ENDIF
			ENDIF
			
			IF nBestItem > RECCOUNT('vStockLst_SQL')
				*did not find all
				*Find Alloy and Form
				IF !EMPTY(cAlloy) AND !EMPTY(cForm)
					*SET ORDER TO TAG AlloyFrmS
					*SEEK cAlloy+cFormSort IN vStockLst_SQL ORDER AlloyFrmS
					LOCATE FOR Alloy = cAlloy AND FormSort = VAL(cFormSort)
					nBestItem =RECNO()
					IF FOUND('vStockLst_SQL')
						nBestItem =RECNO()
						SET ORDER TO TAG StockLstC
						SET FILTER TO Alloy = cAlloy AND FormSort = VAL(cFormSort)
						
						GO TOP
						DO WHILE NOT EOF()
							IF nThck < Size
								* IF The thickness you search is Greater than the Stocklist Size,
								* exit- use the previous records number as Best
								EXIT
							ENDIF
							nBestItem =RECNO('vStockLst_SQL')
							SKIP
						ENDDO
						SET FILTER TO 
						GOTO nBestItem
					ENDIF
				ELSE
					nBestItem = RECCOUNT('vStockLst_SQL')+1
				ENDIF
			ENDIF
		
		
			IF nBestItem > RECCOUNT('vStockLst_SQL')
				*find alloy
				IF !EMPTY(cAlloy)
					SET ORDER TO TAG alloy
					SEEK cAlloy
					nBestItem =RECNO()
					SET ORDER TO TAG StockLstC
					
					IF FOUND('vStockLst_SQL')
						*Found Alloy - get nearest Form!
						DO WHILE NOT EOF('vStockLst_SQL')
							SKIP
							IF vStockLst_SQL.Alloy != cAlloy
								EXIT
							ENDIF
							IF vStockLst_SQL.Form > cForm 
								EXIT
							ENDIF
						ENDDO
						SKIP -1
					ENDIF
				ENDIF
				nBestItem =RECNO('vStockLst_SQL')
			ENDIF
			IF nBestItem > RECCOUNT('vStockLst_SQL')
				*did not find alloy
			*	SET ORDER TO TAG alloy
				SEEK LEFT(cAlloy,3)
			*	SET ORDER TO TAG vStockLst_SQL
			*	nBestItem =RECNO()
			ELSE
				ThisFormSet.frmStockLst.grdStockLst.SetFocus()
			ENDIF
		
			*set order to &&tag vStockLst_SQL
			
			*ThisFormSet.Refresh
			ThisFormSet.frmStockLst.grdStockLst.Visible = .T.
			ThisFormSet.frmStockLst.Visible = .T.
		*	ThisFormSet.frmStockStatus.Visible = .T.
			ThisFormSet.frmStockLst.grdStockLst.Refresh
		ENDIF
		*!*		IF ThisFormSet.SetSelectedID_Detail('SOitem',cSOitem,"B")
		*!*			*Sets ThisFormSet.StockLst_ID_Detail from Incoming or Selected Process
		*!*		ELSE
		*!*			PRIVATE cMess 
		*!*			IF tmpSO.Bkr > 0
		*!*				IF nWO > 0
		*!*					cMess = "WO:"+ALLTRIM(nWO)
		*!*				ELSE
		*!*					cMess = "SOitem:"+ALLTRIM(cSOitem)
		*!*				ENDIF
		*!*				
		*!*				cMess = cMess+" shows "+ALLTRIM(STR(tmpSO.Bkr))+" process,"+CHR(13)+"But none where found to show in BrokerLst."
		*!*				MESSAGEBOX(cMess,48,"Exact Stock not found!") 
		*!*			ELSE
		*!*				cMess = "SOitem:"+ALLTRIM(tmpSO.SOitem)+" has NO Broker List process"
		*!*				MESSAGEBOX(cMess,48,"Just showing Broker list!") 
		*!*			ENDIF
		*!*		ENDIF
		
		*!*		
		
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE frmShop_StockLst_Edit.cmdInv.Click
		IF NOT USED('tmpSO')
			MESSAGEBOX("Cannot continue without a Sales Order \ Work Order",0+16,"No SO\WO!")
			RETURN .F.
		ENDIF
		
		*******************************************************
		PRIVATE lCheckForIncoming
		lCheckForIncoming = .F.
		
		PRIVATE cAlloy, cForm, nThck, cCC, cCL
		cAlloy = PrepareSQLtxt(tmpSO.Alloy,'Alloy',12,.T.)
		cForm  = Proper_Form(PrepareSQLtxt(tmpSO.Form,'Form',2,.T.))
		cCC	   = PrepareSQLtxt(tmpSO.CC,'CC',1)
		cCL	   = PrepareSQLtxt(tmpSO.CL,'CL',1)
		
		PRIVATE nThck,nSz2,nSz3,nPC,nLBS,lRL, cPO_item
		nThck	= PrepareSQLnum(tmpSO.Thck,'Thck',9,3) &&nThck	= PrepareSQLnum(tmpSO.Dim1,'Thck',9,3)
		nSz2	= PrepareSQLnum(tmpSO.Sz2,'Sz2',9,3)	&&nSz2	= PrepareSQLnum(tmpSO.Dim2,'Sz2',9,3)
		nSz3	= PrepareSQLnum(tmpSO.Sz3,'Sz3',9,3)	&&nSz3	= PrepareSQLnum(tmpSO.Dim3,'Sz3',9,3)
		nPC		= PrepareSQLnum(tmpSO.PC,'PC',-3)
		nLBS	= PrepareSQLnum(tmpSO.Weight,'Weight',7,1)
		lRL		= PrepareSQLlogic(tmpSO.RandLen,'RandLen')
		cPO_item= PrepareSQLtxt(tmpSO.POitem,'POitem',12)	&&tmpSO holds PO WHERE 'SELECTED' OR SP.Process_ID = 'PARTSELECT'
		
		******************************************************
		*IF EMPTY(cPO_item)	
		*	Broker needs a PO check!!!
		*	lCheckForIncoming = .T.
		*ENDIF
		******************************************************
		
		PRIVATE cHeatLot
		*cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpSO.Heat)+" "+ALLTRIM(tmpSO.Lot),'HeatLot',60)
		cHeatLot	= PrepareSQLtxt( ALLTRIM(tmpSO.Heat),'HeatLot',60)
		
		PRIVATE nSalesNum, nItem, cSOitem, nQTY
		nSalesNum 	= ThisFormSet.SalesNum
		nItem		= PrepareSQLnum(ThisFormSet.frmShop_StockLst_Edit.lblItem.Caption,'Item',-1)
		cSOitem		= PrepareSQLtxt( STR(nSalesNum)+"-"+STR(nItem,2,0),'SOitem',10 )
		nQTY		= PrepareSQLnum(tmpSO.Qty ,'S_QTY ',-5)
		
		PRIVATE cTBL,nID_Detail
		cTBL = 'S'
		nID_Detail = 0
		
		ThisFormSet.VisibleForms()
		ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
		ThisFormSet.frmQuote.Visible = .F.
									
		DO FORM  Forms\StockLst_SQL_Quotes WITH "SELECT",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,cPO_item TO nID_Detail
		*DO FORM Forms\StockLst_SQL_Quotes WITH pFunction,pTBL,pAlloy,pForm,pCC,pCL,pThck,pSz2,pSz3,pSOItem,pSalesNum,pPC,pLBS,pHeatLot,pQTY,pRL,pPOitem
		
		IF PrepareSQLnum(nID_Detail,'ID_Detail',-3) > 0
			*IF lCheckForIncoming = .T.
			*	*The POitem was lost from the SalesNo. 
			*	*POitem was just 'SELECTED' 
			*	*Add 'INCOMING TO Process if Needed.
			*	IF StockLst_Process_Count_POitem( cPOitem, cTBL, ThisFormSet.nConnHandle, 'INCOMING') = 0
			*		*Create an INCOMING Process
			*		
			*		IF Receiving_CreateProcess(cTBL,cSOitem,cPOitem,0,nID_Detail,'INCOMING','Created Process for POitem:'+cPOitem )
			*		ENDIF
			*		
			*	ENDIF		
			*ENDIF
		ENDIF
		
		ThisFormSet.VisibleFormsReset()
		
		ThisFormSet.RefreshTmpQuotes()
		
		RETURN
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		********************************************************
		PRIVATE lShow
		lShow = .T.
		
		PRIVATE cTbl
		IF LEFT(ThisFormSet.frmStockLst.Caption,9) = "StockLst "
			cTbl = "S"
			IF ThisFormSet.frmStockLst.Visible
				lShow = .F.	
			ELSE
				lShow = .T.
			ENDIF
		ENDIF
		IF LEFT(ThisFormSet.frmStockLst.Caption,9) = "BrokerLst"
			cTbl = "B"
			IF ThisFormSet.frmStockLst.Visible
				lShow = .T.	
			ELSE
				lShow = .T.
			ENDIF
		ENDIF
		
		ThisFormSet.StockLst_TBL = cTbl
		ThisFormSet.Stocklst_ID = 0
		ThisFormSet.Stocklst_ID_Detail = 0
		
		
		IF NOT lShow
			ThisFormSet.frmStockLst.Visible = .F.
			ThisFormSet.frmStockStatus.Visible = .F.
			ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
			ThisFormSet.frmSimiliarSales.Visible = .F.
			
		ELSE
			ThisFormSet.frmStockLst.Caption = "StockLst "
		*	ThisFormset.frmStockLst.cmdMark.Visible = .T.
		*	ThisFormset.frmStockLst.cmdInvCorrection.Visible = .T.
			ThisFormset.frmStockLst.cmdShowPrc.Caption = "Show Prc"
			
			IF ThisFormSet.SetSelectedID_Detail('SOitem',tmpSO.SOitem,"S")
				*Sets ThisFormSet.StockLst_ID_Detail from Incoming or Selected Process
			ELSE
				PRIVATE cMess 
				IF tmpSO.Prc > 0
					cMess = "SOitem:"+ALLTRIM(tmpSO.SOitem)+" shows "+ALLTRIM(STR(tmpSO.Prc))+" process,"+CHR(13)+"But none where found to show in StockLst."
					MESSAGEBOX(cMess,48,"Exact STK not found!")
				ELSE
					cMess = "SOitem:"+ALLTRIM(tmpSO.SOitem)+" shows NO Inv process."+CHR(13)+"Mark a process in the StockLst."
					MESSAGEBOX(cMess,48,"Exact STK not found!")	
				ENDIF
			ENDIF
			
			ThisFormSet.RefreshStockLst("RELOAD","StockLst " )
			ThisFormSet.RefreshStockStatus()
			
			IF ThisFormSet.StockLst_ID_Detail = vStockLst_SQL.ID_Detail
				** Found best STK- Do not move!!!
			ELSE
				
				PRIVATE cAlloy, cForm, nThck, cCC, cCL, nCurrentRecord, nSize
		
				cAlloy = PrepareSQLtxt(tmpSO.Alloy,'Alloy',12,.T.)
				cForm  = Proper_Form(PrepareSQLtxt(tmpSO.Form,'Form',2,.T.))
				nThck  = PrepareSQLnum(tmpSO.Thck,'Thck',9,3)
				cCC	   = PrepareSQLtxt(tmpSO.CC,'CC',1)
				cCL	   = PrepareSQLtxt(tmpSO.CL,'CL',1)
				nCurrentRecord = RECNO('vStockLst_SQL')
				nSize	= vStockLst_SQL.Size
				
				PRIVATE FormSort, nCCSortValue, cCCSort
				cFormSort = ALLTRIM(STR(GetFormSort(cForm,ThisFormSet.nConnHandle),2,0))
				nCCSortValue = CCSortValue( cCC, ThisFormSet.nConnHandle) 
				cCCSort = STR(nCCSortValue,2,0)
				PRIVATE nBestItem 
				nBestItem = RECNO('vStockLst_SQL')
				
				IF USED('vStockLst_SQL')
					SELECT vStockLst_SQL
			
					SEEK cAlloy+cFormSort+cCC+CL+STR(nThck,9,3) ORDER AlFmsCLSz IN vStockLst_SQL
					IF NOT FOUND('vStockLst_SQL')
						
						LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC AND CL=cCL
						IF FOUND('vStockLst_SQL')
							*Search for best Size match.
							
							nBestItem = RECNO()
							SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC AND CL=cCL
							
							GO TOP
							DO WHILE NOT EOF()
								IF nThck < Size
									* IF The thickness you search is Greater than the Stocklist Size,
									* exit- use the previous records number as Best
									EXIT
								ENDIF
								nBestItem = RECNO('vStockLst_SQL')
								SKIP
							ENDDO
							SET FILTER TO 
							GOTO nBestItem
						ELSE
						
							LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC 
							IF FOUND('vStockLst_SQL')
								*Search for best Size match.
								
								nBestItem = RECNO()
								SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) AND CC=cCC 
								
								GO TOP
								DO WHILE NOT EOF()
									IF nThck < Size
										* IF The thickness you search is Greater than the Stocklist Size,
										* exit- use the previous records number as Best
										EXIT
									ENDIF
									nBestItem = RECNO('vStockLst_SQL')
									SKIP
								ENDDO
								SET FILTER TO 
								GOTO nBestItem
							ELSE
							
								LOCATE FOR Alloy=cAlloy AND FormSort=VAL(cFormSort) 
								IF FOUND('vStockLst_SQL')
									*Search for best Size match.
									
									nBestItem = RECNO()
									SET FILTER TO Alloy=cAlloy AND FormSort=VAL(cFormSort) 
									
									GO TOP
									DO WHILE NOT EOF()
										IF nThck < Size
											* IF The thickness you search is Greater than the Stocklist Size,
											* exit- use the previous records number as Best
											EXIT
										ENDIF
										nBestItem = RECNO('vStockLst_SQL')
										SKIP
									ENDDO
									SET FILTER TO 
									GOTO nBestItem	
									
									WAIT WINDOW "CL and CC not Found!" TIMEOUT 1
									
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		*!*				IF !EMPTY(cAlloy) AND !EMPTY(cFormSort ) AND !EMPTY(cCCSort) AND !EMPTY(nThck)
		*!*					*Find Alloy, Form, CC and Thickness
		*!*					SET ORDER TO TAG AlFmsCCsS  
		*!*					SEEK cAlloy+cFormSort+cCCSort+STR(nThck,9,3) IN vStockLst_SQL ORDER AlFmsCCsS
		*!*					
		*!*					nBestItem =RECNO('vStockLst_SQL')
		*!*					IF nBestItem > RECCOUNT('vStockLst_SQL')
		*!*						*Check to see if a fraction under
		*!*						nThckplus = nThck+.001
		*!*						SEEK cAlloy+cFormSort+cCCSort+STR(nThckplus, 9,3) IN vStockLst_SQL ORDER AlFmsCCsS
		*!*						nBestItem =RECNO('vStockLst_SQL')
		*!*						IF nBestItem > RECCOUNT('vStockLst_SQL')
		*!*						*Check to see if a fraction over
		*!*							nThckMinus = nThck-.001
		*!*							SEEK cAlloy+cFormSort+cCCSort+STR(nThckMinus, 9,3) IN vStockLst_SQL ORDER AlFmsCCsS
		*!*							nBestItem =RECNO('vStockLst_SQL')
		
		*!*							IF nBestItem > RECCOUNT('vStockLst_SQL')
		*!*								*Check to see if under
		*!*								nThckplus = nThck+.1
		*!*								SEEK cAlloy+cFormSort+cCCSort+STR(nThckplus, 9,3) IN vStockLst_SQL ORDER AlFmsCCsS
		*!*								nBestItem =RECNO('vStockLst_SQL')
		*!*								IF nBestItem > RECCOUNT('vStockLst_SQL')
		*!*								*Check to see if over
		*!*									nThckMinus = nThck-.1
		*!*									SEEK cAlloy+cFormSort+cCCSort+STR(nThckMinus, 9,3) IN vStockLst_SQL ORDER AlFmsCCsS
		*!*									nBestItem =RECNO('vStockLst_SQL')
		*!*									
		*!*								ELSE
		*!*									*Check to see if 2 Decimal
		*!*									nThckplus = nThck
		*!*									SEEK cAlloy+cFormSort+cCCSort+STR(ROUND(nThckplus,2), 9,3) IN vStockLst_SQL ORDER AlFmsCCsS
		*!*									nBestItem =RECNO('vStockLst_SQL')
		*!*									IF nBestItem > RECCOUNT('vStockLst_SQL')
		*!*									*Check to see if 1 Decimal
		*!*										nThckMinus = nThck
		*!*										SEEK cAlloy+cFormSort+cCCSort+STR(ROUND(nThckMinus,1), 9,3) IN vStockLst_SQL ORDER AlFmsCCsS
		*!*										nBestItem =RECNO('vStockLst_SQL')
		*!*									ENDIF
		*!*								ENDIF	
		*!*							ENDIF
		
		*!*						ENDIF	
		*!*					ENDIF
		*!*				ELSE
		*!*					nBestItem = RECCOUNT('vStockLst_SQL')+1
		*!*				ENDIF
		
		*!*				IF nBestItem > RECCOUNT('vStockLst_SQL')
		*!*					IF !EMPTY(cAlloy) AND !EMPTY(cFormSort) AND !EMPTY(nThck)
		*!*						*Find Alloy, Form and CC
		*!*						*SET ORDER TO TAG AlFmsCCsS
		*!*						SEEK cAlloy+cForm+cCCSort ORDER AlFmsCCs IN vStockLst_SQL 
		*!*						IF FOUND('vStockLst_SQL')
		*!*							nBestItem =RECNO('vStockLst_SQL')
		*!*						ELSE
		*!*							nBestItem = RECCOUNT('vStockLst_SQL')+1
		*!*						ENDIF
		*!*					ELSE
		*!*						nBestItem = RECCOUNT('vStockLst_SQL')+1
		*!*					ENDIF
		*!*				ENDIF
		*!*					
		*!*				IF nBestItem > RECCOUNT('vStockLst_SQL')
		*!*					*did not find 
		*!*					*Find Alloy and Form
		*!*					IF !EMPTY(cAlloy) AND !EMPTY(cForm)
		*!*						*SET ORDER TO TAG AlloyFrmS
		*!*						LOCATE FOR Alloy = cAlloy AND FormSort = VAL(cFormSort)
		*!*						*SEEK cAlloy+cFormSort
		*!*						nBestItem =RECNO()
		*!*						IF FOUND('vStockLst_SQL')
		*!*							nBestItem =RECNO()
		*!*							SET ORDER TO TAG StockLstC
		*!*							SET FILTER TO Alloy = cAlloy AND FormSort = VAL(cFormSort)
		*!*							GO TOP
		*!*							DO WHILE NOT EOF()
		*!*								IF nThck < Size
		*!*									* IF The thickness you search is Greater than the Stocklist Size,
		*!*									* exit- use the previous records number as Best
		*!*									EXIT
		*!*								ENDIF
		*!*								nBestItem =RECNO('vStockLst_SQL')
		*!*								SKIP
		*!*							ENDDO
		*!*							SET FILTER TO 
		*!*							GOTO nBestItem
		*!*						ENDIF
		*!*					ELSE
		*!*						nBestItem = RECCOUNT('vStockLst_SQL')+1
		*!*					ENDIF
		*!*				ENDIF
		
		
		*!*				IF nBestItem > RECCOUNT('vStockLst_SQL')
		*!*					*find alloy
		*!*					IF !EMPTY(cAlloy)
		*!*						SET ORDER TO TAG Alloy
		*!*						SEEK cAlloy
		*!*						nBestItem =RECNO()
		*!*						SET ORDER TO TAG StockLstC
		*!*						
		*!*						IF FOUND('vStockLst_SQL')
		*!*							*Found Alloy - get nearest Form!
		*!*							DO WHILE NOT EOF('vStockLst_SQL')
		*!*								SKIP
		*!*								IF vStockLst_SQL.Alloy != cAlloy
		*!*									EXIT
		*!*								ENDIF
		*!*								*IF vStockLst_SQL.Form > cForm 
		*!*								IF vStockLst_SQL.FormSort > VAL(cFormSort)
		*!*									EXIT
		*!*								ENDIF
		*!*							ENDDO
		*!*							SKIP -1
		*!*						ENDIF
		*!*					ENDIF
		*!*					nBestItem =RECNO('vStockLst_SQL')
		*!*				ENDIF
		*!*				IF nBestItem > RECCOUNT('vStockLst_SQL')
		*!*					*did not find alloy
		*!*				*	SET ORDER TO TAG alloy
		*!*					SEEK LEFT(cAlloy,3)
		*!*				*	SET ORDER TO TAG vStockLst_SQL
		*!*				*	nBestItem =RECNO()
		*!*				ENDIF
		*!*				
		*!*				*********************************
		*!*				** End of Find by Alloy Form ....
		*!*			ENDIF
		*!*		ENDIF	
			
			*set order to &&tag vStockLst_SQL
			*ThisFormSet.Refresh
			ThisFormSet.frmStockLst.grdStockLst.Visible = .T.
			ThisFormSet.frmStockLst.Visible = .T.
			ThisFormSet.RefreshStockStatus()
			ThisFormSet.frmStockStatus.Visible = .T.
			ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
			ThisFormSet.frmSimiliarSales.Visible = .F.
			ThisFormSet.frmStockLst.grdStockLst.Refresh
			ThisFormSet.frmStockLst.grdStockLst.SetFocus()
				
		ENDIF
		
		*!*	ELSE
		*!*		PRIVATE nWO, cSOitem
		*!*		nWO = PrepareSQLnum(tmpSO.WO,'WO',-3)
		*!*		cSOitem = PrepareSQLtxt(tmpSO.SOitem,'SOitem',10)
		*!*		
		*!*		PRIVATE pWhat,pItem
		*!*		IF nWO > 0
		*!*			pWhat	= "WO"
		*!*			pItem	= nWO
		*!*		ELSE
		*!*			IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
		*!*				pWhat	= "SOitem"
		*!*				pItem	= cSOitem
		*!*			ELSE
		*!*				*pWhat 	= ''
		*!*				*pItem	= 0
		*!*				*TrackError("Could not select Inventory from SOitem or WO","cSOitem='"+cSOitem+"'  WO="+ALLTRIM(STR(nWO))+"!","Shop_StockLst_Edit.cmdInv.Click()",LINENO())
		*!*				***********
		*!*				pWhat 	= ''
		*!*				pItem	= 0
		*!*				MESSAGEBOX("Could not select Inventory from SOitem or WO"+CHR(13)+"Going to the bottom of the StockLst.",48,"Browse")
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		*!*		*IF ThisFormSet.SetSelectedID_Detail('SOitem',tmpSO.SOitem,"S")
		*!*		IF ThisFormSet.SetSelectedID_Detail(pWhat,pItem,cTBL)
		*!*			*Sets ThisFormSet.StockLst_ID_Detail from Incoming or Selected Process
		*!*		ELSE
		*!*			PRIVATE cMess 
		*!*			IF tmpSO.Prc > 0
		*!*				IF nWO > 0
		*!*					cMess = "WO:"+ALLTRIM(STR(nWO))
		*!*				ELSE
		*!*					cMess = "SOitem:"+ALLTRIM(cSOitem)
		*!*				ENDIF
		*!*				cMess = cMess+" shows "+ALLTRIM(STR(tmpSO.Prc))+" process,"+CHR(13)+"But none where found to show in StockLst."
		*!*				MESSAGEBOX(cMess,48,"Exact STOCK not found!")
		*!*			ELSE
		*!*				IF nWO > 0
		*!*					cMess = "WO:"+ALLTRIM(STR(nWO))
		*!*				ELSE
		*!*					cMess = "SOitem:"+ALLTRIM(cSOitem)
		*!*				ENDIF
		*!*				cMess = cMess+" shows NO Inv process."+CHR(13)+"Mark a process in the StockLst."
		*!*				MESSAGEBOX(cMess,48,"Exact STOCK not found!")	
		*!*			ENDIF
		*!*		ENDIF
		*!*		
		
		*!*		********************************
		*!*		ThisFormSet.RefreshStockStatus()
		*!*		********************************
		*!*		
		*!*		
		*!*		PRIVATE cAlloy, cForm, nThck, cCC, cCL
		
		*!*		cAlloy = PrepareSQLtxt(tmpSO.Alloy,'Alloy',12,.T.)
		*!*		cForm  = Proper_Form(PrepareSQLtxt(tmpSO.Form,'Form',2,.T.))
		*!*		nThck  = PrepareSQLnum(tmpSO.Thck,'Thck',9,3)
		*!*		cCC	   = PrepareSQLtxt(tmpSO.CC,'CC',1)
		*!*		cCL	   = PrepareSQLtxt(tmpSO.CL,'CL',1)
		*!*		
		*!*		PRIVATE nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,cTBL,nQTY,lRL
		*!*		nSz2	= PrepareSQLnum(tmpSO.Sz2,'Sz2',9,3)
		*!*		nSz3	= PrepareSQLnum(tmpSO.Sz3,'Sz3',9,3)
		*!*		cSOItem	= PrepareSQLtxt(tmpSO.SOitem,'SOitem',10)
		*!*		IF nWO > 0
		*!*			nSalesNum	= nWO
		*!*		ELSE
		*!*			nSalesNum = ThisFormSet.Salesnum
		*!*		ENDIF
		*!*		nPC		= PrepareSQLnum(tmpSO.Pieces,'Pieces',-3)
		*!*		nLBS	= PrepareSQLnum(tmpSO.Weight,'Weight',7,1)
		*!*		cHeatLot	= PrepareSQLtxt(tmpSO.Heat,'Heat',50)
		*!*		*cTBL 	= ThisFormSet.StockLst_TBL 
		*!*		cTBL = 'S'	&&User clicked INV not Broker
		*!*		nQTY	= PrepareSQLnum(tmpSO.QTY,'QTY',-5)
		*!*		lRL		= PrepareSQLlogic(tmpSO.RandLen,'RandLen')
		*!*		
		*!*		PRIVATE pID_Detail		
		*!*		IF nWO > 0
		*!*			*"Mark Stock for this WorkOrder"
		*!*			DO FORM Forms\StockLst_SQL_Quotes WITH "SEL_WO",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,'' TO pID_Detail
		*!*		ELSE
		*!*			ThisFormSet.RefreshStockStatus()
		*!*			ThisFormSet.frmStockStatus.Visible = .T.
		
		*!*			*"Mark Stock for this Sales Order"
		*!*			DO FORM Forms\StockLst_SQL_Quotes WITH "SELECT",cTBL,cAlloy,cForm,cCC,cCL,nThck,nSz2,nSz3,cSOItem,nSalesNum,nPC,nLBS,cHeatLot,nQTY,lRL,'' TO pID_Detail
		*!*			
		*!*		ENDIF	
		
		*!*		ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
		*!*		ThisFormSet.frmSimiliarSales.Visible = .F.
		*!*		
		*!*		IF PrepareSQLnum(pID_Detail,'ID_Detail',-3) > 0
		*!*			*Select returned an ID_Detail
		*!*			ThisFormSet.RefreshTmpQuotes()
		*!*		ENDIF
		*!*	ENDIF
		
	ENDPROC

