		ThisFormSet.frmShop_StockLst_Edit.grdSO.SETFOCUS
	ENDPROC

	PROCEDURE frmShop_StockLst_Edit.cmdSvc.Click
		*No material or evan Customer Material, SOitem Service is DONE.
		
		IF NOT USED('tmpSO')
			MESSAGEBOX("Cannot continue without a Sales Order",0+16,"No SO!")
			RETURN .F.
		ENDIF
		
		
		PRIVATE m.SOitem
		m.SOitem = Proper_SO_Item(tmpSO.SOitem)
		PRIVATE nSalesNum
		nSalesNum = ThisFormSet.SalesNum
		
		IF nSalesNum < 1
			MESSAGEBOX("No Sales Order Found",4+32,"Cannot continue")
			RETURN .F.
		ENDIF
		
		IF PrepareSQLbit(tmpSO.Cmplt,'Cmplt') = 1
			MESSAGEBOX("SOitem "+ALLTRIM(m.SOitem)+" is allready complete!",4+32,"Allready Complete")
			RETURN .F.
		ENDIF
		
		****
		*Is SOitem allready marked as complete?
		PRIVATE lS_Cancelled
		lS_Cancelled = .F.
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpScmplt')
			USE IN tmpScmplt
		ENDIF
		
		SELECT 0
		cSQL = "SELECT cncld FROM dbo.Sales "
		cSQL = cSQL + " WHERE SalesNum = "+STR(nSalesNum)
		cSQL = cSQL + " AND TYP = 'C'"
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpScmplt')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpScmplt' )
		ENDDO
		IF nSQLEXEC < 0
			lOK = .F.
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpScmplt')
		ENDIF
		IF USED('tmpScmplt')
			IF RECCOUNT('tmpScmplt') > 0
				lS_Cancelled	= PrepareSQLlogic(tmpScmplt.cncld,'cncld')
			ENDIF
			USE IN tmpScmplt
		ENDIF
		
		
		IF lS_Cancelled
			IF MESSAGEBOX("Do you want to un COMPLETE this 'Conversion' SOitem "+ALLTRIM(m.SOitem)+"?",4+32,"UM Mark as Complete")=6
			
				cSQL = "UPDATE dbo.Sales SET cmplt = 0"
				cSQL = cSQL + " WHERE SalesNum = "+ThisFormSet.SalesNum
				cSQL = cSQL + " AND TYP = 'C'"
				
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, '' )
				ENDDO
				IF nSQLEXEC < 0
					lOK = .F.
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, '')
				ENDIF
				
				RETURN .T.
			ELSE
			
				RETURN .F.
			ENDIF
		ENDIF
		*********************
		
		IF MESSAGEBOX("Are you sure you want to mark this SOitem "+ALLTRIM(m.SOitem)+" as DONE?"+CHR(13)+CHR(13)+"Use this option if there are no:"+CHR(13)+"No edits to Stock List."+CHR(13)+"No Packing Slip will be needed!"+CHR(13)+CHR(13)+"If you need a Packing Slip"+CHR(13)+"Do NOT mark as Complete here! Answer (N) here."+CHR(13)+"and use the Packing Slip program to mark as Complete.",4+32,"Mark as Complete")!=6
			*+CHR(13)+"No PackingSlip will be needed!"
			RETURN .F.
		ENDIF
		
		*Look for Stock or Broker Process!
		cSQLn = "SELECT COUNT(*) AS counted FROM dbo.StockLst_Process WHERE SOitem = dbo.f_ProperSOitem('"+m.SOitem+"')"
		cSQLn = cSQLn + " UNION "
		cSQLn = "SELECT COUNT(*) AS counted FROM dbo.BrokerLst_Process WHERE SOitem = dbo.f_ProperSOitem('"+m.SOitem+"')"
		*cSQLn = cSQLn + " UNION "
		*cSQLn = "SELECT COUNT(*) AS counted FROM dbo.WIPLst_Process WHERE SOitem = dbo.f_ProperSOitem('"+m.SOitem+"')"
		
		IF USED("StockLst_Detail_Count")
			SELECT StockLst_Detail_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQLn, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Detail_Count')
			*Just Create a new Process
			*THISFORMSET.Create_StockLst_Process(pID,pID_Detail,"",cTBL)
		ELSE
			IF USED("StockLst_Detail_Count")
				IF StockLst_Detail_Count.Counted > 0
					USE IN StockLst_Detail_Count
					MESSAGEBOX("Found Stock or Brokered material selected for this SOitem!"+CHR(13)+"Work on those Process' first!",0,"Cannot process SOitem as done.")
			*		\Progs\ErrorHandlerlog(0,"No pID_Detail_Process, pSOitem or pTbl Parameter","No pID_Detail_Process, pSOitem or pTbl Parameter","frmShop_StockLst_Edit.Remove_ID_Detail_Process",LINENO())
					RETURN .F.
				ELSE
					USE IN StockLst_Detail_Count
				ENDIF
			ENDIF
		ENDIF	
		
		ThisFormSet.StockLst_TBL = ' '
		ThisFormSet.Stocklst_ID = 0
		ThisFormSet.Stocklst_ID_Detail = 0
		
		*Mark table Sales as in progess and processing Done for this SOitem!
		
		
		*Update_PrcpPrcdinSales( .T., .T., m.SOitem, ThisFormSet.nConnHandle ) Changed 3/9/15
		Update_PrcpPrcdinSales( .F., .T., m.SOitem, ThisFormSet.nConnHandle ) &&Proc_SQL
		
		
		*PRCP=Process in Progress, PRCD=Processing Done
		Update_CmpltPrcdinSales( .T., m.SOitem, ThisFormSet.nConnHandle ) &&Proc_SQL
		
		ThisFormSet.RefreshtmpQuotes()
		
		
		*AccountingCosting( m.nID1, m.nID_Detail, cSOitem, ThisFormSet.nConnHandle )
		
		*cSQLi = "EXEC dbo.p_StockLst_Detail_ins2 "
		*cSQLid = "INSERT INTO dbo.StockLst_Process_Detail ("
		
		
		*IF MESSAGEBOX("Did this "+cTableName+" edit complete the selected process?"+CHR(13)+"Answer 'Yes' and the 'Process' will show as complete."+CHR(13)+"Answer 'Yes' for Inventory correction."+CHR(13)+"Answer 'No' when the SO item is not done.",4,"Process Complete?") = 6
			*Yes
		*THISFORMSET.Remove_ID_Detail_Process(m.nID_Detail_Process,cSOitem,cTbl)  &&Check for Excess metal to Stock!
			
		*ThisFormSet.RefreshtmpQuotes()
			*ThisForm.cmdDone.Click()
			
		ThisFormSet.Modify_StockLst_How = "DONE"
			
		IF ThisFormSet.frmStockLstProcesses.Visible
			ThisFormSet.frmStockLstProcesses.Visible = .F.
		ENDIF
		
		IF ThisFormSet.frmModiProcess.Visible
			ThisFormSet.frmModiProcess.Visible = .F.
			ThisFormSet.frmShop_StockLst_Edit.grdSO.SetFocus()
		ENDIF
		
		*ThisFormSet.StockLst_ID_Detail = nID_Detail
		*ThisFormSet.RefreshStockLst("Refresh", cTableName )
		
		ThisForm.Refresh
		ThisForm.grdSO.Refresh
		
		
			
	ENDPROC

