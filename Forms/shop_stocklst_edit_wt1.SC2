	PROCEDURE changestocklst
		*ThisFormSet.ChangeStockLst()
		
		ThisFormset.frmStockLst.cmbAlloy.Value = vStockLst_SQL.Alloy
		ThisFormset.frmStockLst.cmbCC.Value = vStockLst_SQL.CC
		ThisFormset.frmStockLst.cmbCL.Value = vStockLst_SQL.CL
		
		PRIVATE nDim1,nDim2,nDim3,nWeight,cLength,cForm
		nDim1	= PrepareSQLnum(vStockLst_SQL.dim1,'Dim1',18,4)
		nDim2	= PrepareSQLnum(vStockLst_SQL.dim2,'Dim2',18,4)
		nDim3	= PrepareSQLnum(vStockLst_SQL.dim3,'Dim3',18,4)
		nWeight = PrepareSQLnum(vStockLst_SQL.Weight,'Weight',18,4)
		cLength = PrepareSQLtxt(vStockLst_SQL.Length,'Length',160)
		cForm	= PrepareSQLtxt(vStockLst_SQL.Form,'Form',2)
		
		
		PRIVATE nSize_L, nSize_H, cSpecs, cHeat, cLot, nCostValue, cLocation
		nSize_L	= PrepareSQLnum(vStockLst_SQL.Size_L,'Size_L',9,4)
		nSize_H	= PrepareSQLnum(vStockLst_SQL.Size_H,'Size_H',9,4)
		cSpecs	= PrepareSQLtxt(vStockLst_SQL.Specs,'Specs',160)
		cHeat	= PrepareSQLtxt(vStockLst_SQL.Heat,'Heat',50)
		cLot	= PrepareSQLtxt(vStockLst_SQL.Lot,'Lot',10)
		nCostValue	= PrepareSQLnum(vStockLst_SQL.CostValue,'CostValue',-5)
		cLocation = PrepareSQLtxt(vStockLst_SQL.Location,'Location',10)
		
		PRIVATE cDescription
		cDescription = ""
		IF nDim2 > 0 OR nDim3 > 0
			IF vStockLst_SQL.pc > 0
				IF vStockLst_SQL.pc = 1
					cDescription = "1 pc "
				ELSE
					cDescription = ALLTRIM(STR(vStockLst_SQL.PC)) + "pcs "
				ENDIF
			ENDIF	
				
				cDescription = cDescription + ItemDescriptionMetric( cForm, nDim1, nDim2, nDim3, nWeight, vStockLst_SQL.RandLen, .F.,'','','' )
		
		*	IF nDim2 > 0	
		*		cDescription = cDescription + REMOVE0(nDim2,9,3)+[" ]
		*	ENDIF
		*	IF nDim3 > 0
		*		cDescription = cDescription + "x " + REMOVE0(nDim3,9,3) + [" ]
		*	ENDIF
		ELSE
			cDescription = REMOVE0(nDim1,9,4)+[" ]	
		ENDIF
		
		
		
		IF !ISNULL(cLength)
			IF LEN(ALLTRIM(cLength)) > 0
				IF cLength = "Listing created"
					cDescription = cDescription + " :Due in "
				ELSE
					cDescription = cDescription + " :"+ALLTRIM( cLength ) + " "
				ENDIF
			ENDIF
		ENDIF
		
		
		IF !ISNULL(nWeight)
			IF nWeight > 0
				PRIVATE nForm
				nForm = VAL(cForm)
				IF nForm > 50
					IF nForm > 65
						cDescription = cDescription + "~" + REMOVE0(nWeight,18,4)+"Pc"
					ELSE
						cDescription = cDescription + "~" + REMOVE0(nWeight,18,4)+"Ft"
					ENDIF
				ELSE
					cDescription = cDescription + "~" + REMOVE0(nWeight,18,4)+"Lbs"
				ENDIF
			ENDIF
		ENDIF
		
		*ThisForm.txtDimensions.Value = REMOVE0(STR(nDim1,9,4))+[" x ]+REMOVE0(STR(nDim2,9,3))+[" x ]+REMOVE0(STR(nDim3,9,3))+[" :]+cLength+" "+ALLTRIM(STR(nWeight,8,1))+"Lbs"
		ThisFormset.frmStockLst.txtDimensions.Value = cDescription
		ThisFormset.frmStockLst.txtDimensions.Refresh
		*********
		IF vStockLst_SQL.Prc > 0 OR vStockLst_SQL.Bkr > 0
			ThisFormset.frmStockLst.cmdShowPrc.Visible = .T.
			IF vStockLst_SQL.Prc > 0 
				ThisFormset.frmStockLst.cmdShowPrc.Caption = "Show Prc"
			ELSE
				*vStockLst_SQL.Bkr > 0
				ThisFormset.frmStockLst.cmdShowPrc.Caption = "Show Bkr"
			ENDIF
		ELSE
			ThisFormset.frmStockLst.cmdShowPrc.Visible = .F.
		ENDIF
		
		*********
		* POStatus ='D' Due, 'P' Partial, OR 'W' Waiting for Bill, 'A' Accounted - do not edit
		IF nSize_H > 0
			IF nSize_L > 0
				ThisFormset.frmStockLst.lblMics.Caption = "Mics. "+STR(nSize_L,9,4)+"/"+STR(nSize_H,9,4)
			ELSE
				ThisFormset.frmStockLst.lblMics.Caption = "Mics. "+STR(nSize_H,9,4)+" High"
			ENDIF
		ELSE
			IF nSize_L > 0
				ThisFormset.frmStockLst.lblMics.Caption = "Mics. "+STR(nSize_L,9,4)+" Low"
			ELSE
				ThisFormset.frmStockLst.lblMics.Caption = "No Mic."
			ENDIF
		ENDIF
		*********
		ThisFormset.frmStockLst.lblDescribe.Caption = ""
		IF !EMPTY(cSpecs)
			ThisFormset.frmStockLst.lblDescribe.Caption = "Spec "+ALLTRIM( cSpecs )
		ENDIF
		ThisFormset.frmStockLst.lblDescribe.Caption = ThisFormset.frmStockLst.lblDescribe.Caption + ":Heat "+ ALLTRIM( cHeat )
		IF !EMPTY(cLot) AND (cLot != "0")
			ThisFormset.frmStockLst.lblDescribe.Caption = ThisFormset.frmStockLst.lblDescribe.Caption + ":Lot "+ ALLTRIM( cLot) 
		ENDIF
		
		ThisFormset.frmStockLst.lblCostValue.Caption = "$"+ALLTRIM( STR( nCostValue, 9,4) )
		*********
		IF vStockLst_SQL.PO_item = tmpSO.POitem ;
				 AND Proper_PO_Item(vStockLst_SQL.PO_item) != Proper_PO_Item("");
				 AND Proper_PO_Item(tmpSO.POitem) != Proper_PO_Item("") 
				 
			*nColor = RGB( 0,128,255 ) &&Blue
			WAIT WINDOW 'BLUE means this stock line was bought for this Purchase Order.' NOWAIT
			ThisFormset.frmStockLst.txtDimensions.BackColor = RGB( 0,128,255 )
			ThisFormset.frmStockLst.txtDimensions.DisabledBackColor = RGB( 0,128,255 )
		ELSE
			IF Is_ID_Detail_SELECTED_SOitem(vStockLst_SQL.ID_Detail,tmpSO.SOitem,ThisFormSet.StockLst_TBL,ThisFormSet.nConnhandle)
				WAIT WINDOW 'BLUE means this stock line was bought for this Sales Order.' NOWAIT
				ThisFormset.frmStockLst.txtDimensions.BackColor = RGB( 0,128,255 )
				ThisFormset.frmStockLst.txtDimensions.DisabledBackColor = RGB( 0,128,255 )
			ELSE
				ThisFormset.frmStockLst.txtDimensions.BackColor = RGB( 236,233,216 )
				ThisFormset.frmStockLst.txtDimensions.DisabledBackColor = RGB( 236,233,216 )
			ENDIF
		ENDIF
		*********
		ThisFormset.frmStockLst.lblLocation.Caption = cLocation
		*********
		ThisFormSet.Stocklst_ID = vStockLst_SQL.ID
		ThisFormSet.Stocklst_ID_Detail = vStockLst_SQL.ID_Detail
		
		*********
		ThisFormSet.frmStockLst.lblMelt.Caption = PrepareSQLtxt(vStockLst_SQL.Melt,'Melt',7)
		
		*****************************************
		PRIVATE cExtra
		cExtra=''
		
		IF vStockLst_SQL.Quarantine 
			cExtra = "Quarentine"
		ELSE
			IF vStockLst_SQL.Prc > 0
				IF NOT ISNULL(vStockLst_SQL.cPODueDate)
					cExtra = "Prc Against"
				ELSE
					cExtra = "Prc Against Late"
				ENDIF
			ELSE
				IF vStockLst_SQL.ReceivingID = 0
					IF ISNULL(vStockLst_SQL.InvCheck)
						cExtra = "Due In"
					ELSE
						IF vStockLst_SQL.InvCheck < DATE()-400
							cExtra = "Due In"
						ENDIF
						IF CTOD(vStockLst_SQL.cInvCheck) = DATE()+1
							cExtra = "Wanted!"
						ENDIF
						IF CTOD(vStockLst_SQL.cInvCheck) = DATE()+2
							cExtra = "Vendor Stock"
						ENDIF
						IF vStockLst_SQL.FloorStatus = 'X'
							cExtra = "eXcess Stck"
						ENDIF
					ENDIF
				ENDIF
				IF vStockLst_SQL.POStatus = "P" 
					cExtra = "Partial Receive"
				ENDIF
			ENDIF
		ENDIF
		ThisFormset.frmStockLst.txtExtra.Value = cExtra
		
	ENDPROC

	PROCEDURE checkquote_selectedstock
		PARAMETERS cSOitem
		*ThisFormSet.CheckQuote_SelectedStock(SOitem)
		PRIVATE lOK
		lOK =.T.
		
		*Check Alloy,Form in selected Stock to Quote
		PRIVATE cQAlloy, cQForm, cQCC, nQDim1
		cQAlloy	= ''
		cQForm	= ''
		cQCC	= ''
		nQDim1	= 0
		
		cSQL = "SELECT Alloy,Form,CC,Thck,Sz2,Sz3 "
		cSQL = cSQL + " FROM dbo.AllQuotes "
		cSQL = cSQL + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpQAlloyFormCC' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle ,nSQLEXEC, 'tmpQAlloyFormCC')
		ELSE
			IF USED('tmpQAlloyFormCC')
				IF RECCOUNT("tmpQAlloyFormCC") > 0
					cQAlloy	= tmpQAlloyFormCC.Alloy
					cQForm	= Proper_Form(tmpQAlloyFormCC.Form)
					cQCC	= tmpQAlloyFormCC.CC
					nQDim1	= tmpQAlloyFormCC.Thck
					
					
					PRIVATE cMess
					*reportConsumed_Ordered
					IF cQAlloy != cAlloy 
						cMess = "Consumed Stock does not match Sales Order:"+cSOitem+CHR(13)
						cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
						cMess = cMess + " Form Picked:"+cForm+"           Ordered:"+cQForm+CHR(13)
						cMess = cMess + " Condition Code  Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
						cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
						cMess = cMess + " Not Allowed to SAVE:Alloy"+CHR(13)
						TrackMess(cMess)
						MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE:Alloy")
						lOK =.F.
					ENDIF
		
					IF cForm = '40' AND cQForm = '80' 
						*Normally Form 80 is from Plate, but can be from bar!!!
						cQForm	= cForm
					ENDIF
					IF cForm = '10' AND cQForm = '80' 
						cQForm	= cForm
					ENDIF
					
					IF cQForm != cForm AND lOK =.T.
						cMess = "Consumed Stock does not match Sales Order:"+cSOitem+CHR(13)
						cMess = cMess + "Alloy Picked:"+cAlloy+"  Ordered:"+cQAlloy+CHR(13)
						cMess = cMess + " Form Picked:"+cForm+"            Ordered:"+cQForm+CHR(13)
						cMess = cMess + " Condition Code  Picked:"+cCC+"  Ordered:"+cQCC+CHR(13)
						cMess = cMess + " Condition Level Picked:"+cCL+"  Ordered:"+cQCL+CHR(13)
						
						IF CheckSOforProduction(cSOitem,ThisFormSet.nConnHandle)
							*Production is allowed to change product form.
						ELSE
							IF NOT (cQForm = '0' OR cQForm = '21' OR cQForm = '22' OR cQForm = '51' OR cQForm = '52' OR cQForm = '53' OR cQForm = '80' OR  cQForm = '90' OR cQForm = '95' OR cQForm = '96' OR cQForm = '97' OR cQForm = '98' OR cQForm = '99' )	
								cMess = cMess + " Allowed to SAVE: Form"+CHR(13)
								TrackMess(cMess)
								TrackError("Consumed Stock does not match Sales Order",cMess,"frmShopStockLst_Edit:Sales_Detail_ConsumeStock",LINENO(1))
								MESSAGEBOX(cMess,16,"Allowed to SAVE: Form")
								lOK =.T.
							ELSE
								cMess = cMess + " Allowed to SAVE: Form"+CHR(13)
								TrackMess(cMess)
								*TrackError("Consumed Stock does not match Sales Order",cMess,"frmShopStockLst_Edit:Sales_Detail_ConsumeStock",LINENO(1))
								*MESSAGEBOX(cMess,16,"Error- Not Allowed to SAVE!")
								*lOK =.F.				
								TrackError("Consumed Stock does not match Sales Order",cMess,"frmShopStockLst_Edit:Sales_Detail_ConsumeStock",LINENO(1))
								MESSAGEBOX(cMess,16,"Allowed to SAVE!")
								lOK =.T.	
		
							ENDIF				
						ENDIF
					ENDIF
				ENDIF
				
				USE IN tmpQAlloyFormCC
				
		*		IF NOT lOK
		*			RETURN .F.
		*		ENDIF
			ENDIF
		ENDIF
		
		RETURN lOK
	ENDPROC

	PROCEDURE checkreceivingid_detail_process		&& Look for Receiving record before Modify Stock
		PARAMETER pnID_Detail_process, pcTBL, pcPO_Item
		*ThisFormSet.CheckReceivingID_Detail_process( ID_Detail_process, pcTbl, pcPO_Item )
		
		IF TYPE("pnID_Detail_process") != "N"
			\Progs\ErrorHandlerlog(0,"No pnID_Detail_process ","ThisFormSet.CheckReceivingID_Detail_process( pnID_Detail_process, cTBL)","frmShop_StockLst_Edit.CheckReceivingID_Detail_process",LINENO())
			RETURN .F.
		ENDIF
		IF VARTYPE(pcTbl) != "C"
			TrackError("Bad parameter pTbl- Possible Error","VARTYPE(pTBL)="+VARTYPE(cTbl),"Shop_StockLst_Edit:CheckReceivingID_Detail_process",LINENO())
			\Progs\ErrorHandlerlog(0,"No Tbl_process ","ThisFormSet.CheckReceivingID_Detail_process( pnID_Detail_process, cTBL)","frmShop_StockLst_Edit.CheckReceivingID_Detail_process",LINENO())
			RETURN .F.
		ENDIF
		IF VARTYPE(pcPO_Item) !="C"
			pcPO_Item = ""
		ENDIF
		
		
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(pcTBL,'TBL',1)
		
		*!*	SELECT COUNT(*) FROM dbo.StockLst_Process WHERE ID_Detail_Process = 16573 AND Process_ID='INCOMING'
		*!*	SELECT COUNT(*) FROM 
		*!*	dbo.StockLst_Process P
		*!*	, dbo.StockLst_Detail D
		*!*	, dbo.StockLst_Master M
		*!*	, dbo.Receiving R
		*!*	WHERE P.ID_Detail_Process = 16573
		*!*	AND p.ID_Detail = D.ID_Detail
		*!*	AND D.ID = M.ID
		*!*	AND M.ID = R.ID_Master
		
		PRIVATE cSQL
		cSQL = "SELECT COUNT(*) AS [Counted] FROM "
		
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		OTHERWISE
			MESSAGEBOX("CheckReceivingID_Detail_process did not recognize Table Name",0+16,"Aborting Save!")
			TrackMess("CheckReceivingID_Detail_process did not recognize Table Name"+CHR(13)+" frmShop_StockLst_Edit:CheckReceivingID_Detail_process")
			RETURN .F.
		ENDCASE
		
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(pnID_Detail_process)
		cSQL = cSQL + " AND ( Process_ID = 'INCOMING' OR Process_ID = 'NOT2HPA' OR Process_ID = 'PARTRECV' )"
		
		IF USED("StockLst_Process_Count")
			SELECT StockLst_Process_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'StockLst_Process_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL , 'StockLst_Process_Count')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'StockLst_Process_Count')
		ENDIF
		
		PRIVATE cHeat
		cHeat=''
		
		IF USED('StockLst_Process_Count')	
			IF StockLst_Process_Count.Counted > 0
				USE IN StockLst_Process_Count
				
			*- Must Receive first
				WAIT window "Must Receive first!" NOWAIT
		
				*Start Receive Process...
				ThisFormSet.ModifyStockLstAfterReceive = .T.
				
			
				IF pnID_Detail_process > 0
					DO CASE
					CASE cTBL = "S"
						DO FORM Forms\Receive_Edit WITH 'S_Process', pnID_Detail_process ,cHeat
					CASE cTBL = "B"
						DO FORM Forms\Receive_Edit WITH 'B_Process', pnID_Detail_process ,cHeat
					CASE cTBL = "W"
						DO FORM Forms\Receive_Edit WITH 'W_Process', pnID_Detail_process ,cHeat
					ENDCASE
				ELSE
					DO FORM Forms\Receive_Edit WITH 'POitem', pcPO_Item ,cHeat
				ENDIF
				
				
				RETURN .T.
			ENDIF
		ENDIF
		
		*Incoming process may have been removed, Aborted receive will still delete process!
		*Check Receiving for PO!
		*A WO PO may be used to remove Stock to Send to Converter.  Material is Removed not Received.
		
		IF pcPO_Item = Proper_PO_Item('')
			RETURN .F.	
		ENDIF
		
		cSQL = "SELECT COUNT(*) AS [Counted] FROM dbo.Receiving WHERE POitem =  dbo.f_ProperPOitem('"+pcPO_Item+"')"
		
		IF USED("cntReceivingPOi")
			SELECT cntReceivingPOi
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'cntReceivingPOi')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL , 'cntReceivingPOi')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'cntReceivingPOi')
		ENDIF
		
		
		IF USED('cntReceivingPOi')	
			IF cntReceivingPOi.Counted = 0
				USE IN cntReceivingPOi
				
			*-  Must Receive first
				PRIVATE nMess
				
				nMess = MESSAGEBOX("Did not find a Receiving entry for this PO-item."+CHR(13)+"Receive this PO-item first! (Y/N)"+CHR(13)+"Answer (N) to skip the receive.",4,"Receive PO now?") 
				IF nMess != 6
					RETURN .F.
				ENDIF
				
				*Start Receive Process...
				* ID_Detail_process, pcTbl, pcPO_Item
				
				IF pnID_Detail_process > 0
					DO CASE
					CASE cTBL = "S"
						DO FORM Forms\Receive_Edit WITH 'S_Process', pnID_Detail_process ,cHeat
					CASE cTBL = "B"
						DO FORM Forms\Receive_Edit WITH 'B_Process', pnID_Detail_process ,cHeat
					CASE cTBL = "W"
						DO FORM Forms\Receive_Edit WITH 'W_Process', pnID_Detail_process ,cHeat
					ENDCASE
				ELSE
					DO FORM Forms\Receive_Edit WITH 'POitem', pcPO_Item ,cHeat
				ENDIF
				
				
				ThisFormSet.ModifyStockLstAfterReceive = .T.
				
				*ThisFormSet.ReceivingLoad(pcPO_Item)
				RETURN .T.
			ENDIF
		ENDIF
		
		
		RETURN .F.
	ENDPROC

	PROCEDURE checkreceiving_poitem		&& Try POitem in Receiving search for 'INCOMING' failes.
		PARAMETER pcTbl, pcPO_Item
		*ThisFormSet.CheckReceiving_POItem( pcTbl, pcPO_Item )
		
		IF VARTYPE(pcTbl) != "C"
			\Progs\ErrorHandlerlog(0,"No Tbl_process ","ThisFormSet.CheckReceiving_POItem( pcTbl, pcPO_Item)","frmShop_StockLst_Edit.CheckReceiving_POItem",LINENO())
			RETURN .F.
		ENDIF
		
		IF VARTYPE(pcPO_Item) != "C"
			pcPO_Item = ''
		ENDIF
		
		IF EMPTY(pcPO_Item)
			RETURN .F.
		ENDIF
		
		IF Proper_PO_Item(pcPO_Item) = Proper_PO_Item(0)
			RETURN .F.
		ENDIF
		
		*!*	SELECT COUNT(*) FROM 
		*!*	dbo.StockLst_Process P
		*!*	, dbo.StockLst_Detail D
		*!*	, dbo.StockLst_Master M
		*!*	, dbo.Receiving R
		*!*	WHERE P.ID_Detail_Process = 16573
		*!*	AND p.ID_Detail = D.ID_Detail
		*!*	AND D.ID = M.ID
		*!*	AND M.ID = R.ID_Master
		
		cSQL = "SELECT COUNT(*) AS [Counted] FROM dbo.Receiving WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+pcPO_Item+"')"
		
		IF USED("Receiving_Count")
			SELECT Receiving_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'Receiving_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL , 'Receiving_Count')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, 'Receiving_Count')
		ENDIF
		
		IF USED('Receiving_Count')	
			IF Receiving_Count.Counted = 0
				USE IN Receiving_Count
				
				*- Must Receive first
				WAIT window "Must Receive first!" NOWAIT
		
				*Start Receive Process...
				ThisFormSet.ModifyStockLstAfterReceive = .T.
				
				PRIVATE cHeat
				cHeat=''
				DO FORM Forms\Receive_Edit WITH 'POitem', pcPO_Item, cHeat
				*ThisFormSet.ReceivingLoad(pcPO_Item)
				
				RETURN .F.
			ENDIF
			USE IN Receiving_Count	
		ENDIF
		
		RETURN .T.
		
	ENDPROC

	PROCEDURE check_id_detail_process
		*ThisFormSet.Check_ID_Detail_Process()
		
		*Is this process exists? 
		PRIVATE nID_Detail_Process
		nID_Detail_Process = ThisFormSet.ID_Detail_Process
		
		IF nID_Detail_Process = 0
			RETURN .F.
		ENDIF
		PRIVATE cTBL,lReturn 
		cTBL = ThisFormSet.Tbl_Process
		lReturn = .F.
		
		PRIVATE cSQL, nSQLEXEC 
		IF USED("CntProcess")
			USE IN CntProcess
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		OTHERWISE
			MESSAGEBOX("Check_ID_Detail_Process did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("Check_ID_Detail_Process did not recognize Table Name","Check_ID_Detail_Process did not recognize Table Name","frmShop_StockLst_Edit.Check_ID_Detail_Process",LINENO())
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process= "+ALLTRIM(STR(nID_Detail_Process))
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'CntProcess' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'CntProcess' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError( cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'CntProcess')
		ENDIF
		IF USED('CntProcess')
			IF RECCOUNT('CntProcess') > 0
				IF CntProcess.CNTD > 0
					lReturn = .T.
				ENDIF
			ENDIF
			USE IN CntProcess
		ENDIF
		
		IF NOT lReturn 
			IF MESSAGEBOX("Do you want to remove this bad Process now?",4,"Process points to missing stock!") = 6	
				IF Remove_ID_Detail_Process(ThisFormSet.ID_Detail_Process, '', cTbl,ThisFormSet.nConnHandle,'CORRECTION')
					IF TYPE("ThisFormSet.frmStockLstProcesses") = "O"
						ThisFormSet.frmStockLstProcesses.Visible = .F.
					ENDIF
				ENDIF				
			ENDIF
		ENDIF
		
		RETURN lReturn 
	ENDPROC

	PROCEDURE check_stocklst_process
		PARAMETER pID, pID_Detail
		*ThisFormSet.Check_StockLst_Process(vStockLst_SQL.ID,vStockLst_SQL.ID_Detail)
		*StockLst_Process_DEL_Correction
		
		PRIVATE nID_Detail_OLD, nStockLst_Detail_SOitem,cSOitem
		nID_Detail_OLD = 0
		nStockLst_Detail_SOitem = 0
		cSOitem = PrepareSQLtxt(tmpSO.SOitem,'SOitem',10)
		
		PRIVATE cSQLn, cSQLd, nSQLEXEC, nAns, cStockTableInit, cTable
		
		DO CASE
		CASE LEFT(ThisFormSet.frmStockLst.Caption,8) = "StockLst"
			cStockTableInit = "S"
			cTable = "StockLst "
			cTBL = "S"
		CASE LEFT(ThisFormSet.frmStockLst.Caption,9) = "BrokerLst"
			cStockTableInit = "B"
			cTable = "BrokerLst"
			cTBL = "B"
		CASE LEFT(ThisFormSet.frmStockLst.Caption,6) = "WIPLst"
			cStockTableInit = "W"
			cTable = "WIPLst"
			cTBL = "W"
		OTHERWISE
			MESSAGEBOX("Check_StockLst_Process did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("Check_StockLst_Process did not recognize Table Name","Check_StockLst_Process did not recognize Table Name "+LEFT(ThisFormSet.frmStockLst.Caption,9) ,"frmShop_StockLst_Edit.Check_StockLst_Process ",LINENO())
			RETURN .F.
		ENDCASE
		
		
		DO CASE
		CASE cTBL = "S"
			cSQLn = "SELECT COUNT(*) AS counted FROM dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQLn = "SELECT COUNT(*) AS counted FROM dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQLn = "SELECT COUNT(*) AS counted FROM dbo.WIPLst_Process "
		ENDCASE
		cSQLn = cSQLn + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		* AND ID_Detail = "+STR(pID_Detail)
		
		IF USED("StockLst_Detail_Count")
			SELECT StockLst_Detail_Count
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_Count')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQLn, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Detail_Count')
			*Just Create a new Process
			*THISFORMSET.Create_StockLst_Process(pID,pID_Detail,"",cTBL)
		ENDIF
		IF USED('StockLst_Detail_Count')
			IF StockLst_Detail_Count.Counted > 0
				PRIVATE nMess
				nMess = 6
		*********************************************************************************************		
				IF StockLst_Detail_Count.Counted > 1
					nMess = MESSAGEBOX("Found "+ALLTRIM(STR(StockLst_Detail_Count.Counted))+" Processes."+CHR(13)+"You will scan thru all of them and are given a chance to delete each."+CHR(13)+"(wish to DELETE a process)"+CHR(13)+CHR(13)+"Do you have a process to delete?",4+32,"Delete a process.")
				ENDIF
				
				IF nMess = 6  &&continue with delete scan.
				
					*Counted a process for this SOitem
					IF USED("StockLst_Detail_SOitem")
						USE IN StockLst_Detail_SOitem
					ENDIF
					SELECT 0
					
					*dbo.StockLst_Process dbo.BrokerLst_Process
					cSQLn = "SELECT ID_Detail "
					cSQLn = cSQLn + ",ID_Detail_Process"
					cSQLn = cSQLn + ",SOItem"
					cSQLn = cSQLn + ",SalesPerson"
					cSQLn = cSQLn + ",StartDate"
					cSQLn = cSQLn + ",PWeight"
					cSQLn = cSQLn + ",QTY"
					cSQLn = cSQLn + ",Comment"
					cSQLn = cSQLn + ",DueDate"
					cSQLn = cSQLn + ",PO_item"
					cSQLn = cSQLn + ",AllowSub"
					cSQLn = cSQLn + ",ISNULL(WO,0) AS WO "
					cSQLn = cSQLn + ",ISNULL(WO_Detail,0) AS WO_Detail "
					cSQLn = cSQLn + ",ISNULL(QTY_Due,0) AS QTY_Due "
					DO CASE
					CASE cTBL = "S"
						cSQLn = cSQLn + " ,'S' AS Lst"
						cSQLn = cSQLn + " FROM dbo.StockLst_Process "
					CASE cTBL = "B"
						cSQLn = cSQLn + " ,'B' AS Lst"
						cSQLn = cSQLn + " FROM dbo.BrokerLst_Process "
					CASE cTBL = "W"
						cSQLn = cSQLn + " ,'W' AS Lst"
						cSQLn = cSQLn + " FROM dbo.WIPLst_Process "
					ENDCASE
					cSQLn = cSQLn + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			*			cSQLn = cSQLn + " AND AllowSub = 'Y' "
					*cSQLn = cSQLn + " AND ID_Detail = "+ALLTRIM(STR(pID_Detail))  &&Do to not use here!
		
					nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_SOitem')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLn, 'StockLst_Detail_SOitem')
					ENDDO
					IF nSQLEXEC < 0
						SQLEXECError(cSQLn, ThisFormSet.nConnHandle, nSQLEXEC, 'StockLst_Detail_SOitem')
					ELSE
						IF RECCOUNT('StockLst_Detail_SOitem') > 0
							*Found SOitem process that are allowed to SUB
							
							nStockLst_Detail_SOitem = RECCOUNT('StockLst_Detail_SOitem')
							SELECT StockLst_Detail_SOitem
							
			********************************************************
							SCAN  &&SOitem  AND AllowSub = 'Y' 
								nID_Detail_OLD = PrepareSQLnum(StockLst_Detail_SOitem.ID_Detail,'ID_Detail',-3)
								IF nID_Detail_OLD < 1
									LOOP
								ENDIF
								
								IF RECCOUNT('StockLst_Detail_SOitem') > 1
									WAIT WINDOW "ID_Detail:"+ALLTRIM(STR(nID_Detail_OLD))+". Record number "+ALLTRIM(STR(RECNO('StockLst_Detail_SOitem')))+" of "+ALLTRIM(STR(nStockLst_Detail_SOitem))+" records." NOWAIT
								ENDIF
		
								
			 					PRIVATE nID,_Detail_Process pSOItem, pSalesPerson, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem
			 					nID_Detail_Process	= PrepareSQLnum(StockLst_Detail_SOitem.ID_Detail_Process,'ID_Detail_Process',-3)
			 					pSOItem		= PrepareSQLtxt(StockLst_Detail_SOitem.SOItem,'SOItem',10)
			 					pSalesPerson= PrepareSQLtxt(StockLst_Detail_SOitem.SalesPerson,'SalesPerson',20)
			 					pSalesDate	= PrepareSQLdate(StockLst_Detail_SOitem.StartDate,'StartDate')
			 					pLBS		= PrepareSQLnum(StockLst_Detail_SOitem.PWeight,'PWeight',-5)
			 					pQTY		= PrepareSQLnum(StockLst_Detail_SOitem.QTY,'QTY',-5)
			 					pComment	= PrepareSQLtxt(StockLst_Detail_SOitem.Comment,'Comment',100)
			 					pShipDue	= PrepareSQLdate(StockLst_Detail_SOitem.DueDate,'DueDate')
			 					pLst		= PrepareSQLtxt(StockLst_Detail_SOitem.Lst,'Lst',1)
			 					pPoItem		= PrepareSQLtxt(StockLst_Detail_SOitem.PO_item,'POitem',12)
			 					
			 					PRIVATE cAllowSub, lAllowSub, nWO, nWO_Detail, nQTY_Due
			 					cAllowSub = PrepareSQLtxt(StockLst_Detail_SOitem.AllowSub,'AllowSub',1)
			 					lAllowSub = IIF(cAllowSub = "N",.F.,.T.)
			 					nWO 		= PrepareSQLnum(StockLst_Detail_SOitem.WO,'WO',-3)
			 					nWO_Detail	= PrepareSQLnum(StockLst_Detail_SOitem.WO_Detail,'WO_Detail',-3)
			 					nQTY_Due	= PrepareSQLnum(StockLst_Detail_SOitem.QTY_Due,'QTY_Due',-5)
			 					
			 					PRIVATE nReturnCode 
			 					nReturnCode = 0
			 					IF lAllowSub 
				 					
			 						ThisFormSet.VisibleForms()
			 						ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
									*ThisFormSet.frmQuote.Visible = .F.
									
									DO FORM forms\Stocklst_Process.scx WITH "DELETE", nID_Detail_Process, pSOItem, pSalesPerson, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, nWO  TO nReturnCode 
									*								PARAMETER cWhatDo, nID,               pSOItem,   pSalesP,    pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO
									
									ThisFormSet.VisibleFormsReset()
								ELSE
								
									**Not Allowed to Sub!
									nAns = MESSAGEBOX("The Sales Person has researched this Stock Item and knows this is what the Customer needs."+CHR(13)+;
										"Do you have permission to override their decision?"+CHR(13)+CHR(13)+;
										"Answer 'Yes' to SUBSTITUTE material that the sales person choose."+CHR(13)+;
										"Answer 'No' to leave the old process as is "+CHR(13)+;
										"and ADD a new process."+CHR(13)+CHR(13)+;
										"or 'Cancel' to not mark current record "+CHR(13)+;
										"(not add a new process).",3+16+512,"Salesman has marked as not to allow SUB.")
										
									IF nAns = 6
										*Record that SalesMan Has been over ridden 
										TrackMess("SalesMan's stock choice has been overridden for SOitem = "+cSOitem+", OLD ID_Detail = "+ALLTRIM(STR(nID_Detail_OLD))+" AND NEW ID_Detail = "+ALLTRIM(STR(pID_Detail)) )
										Save_SOitem_Status( cSOitem, VAL(cSOitem), "Stock Swap", "SalesMan's stock choice has been overridden for D_Detail ="+ALLTRIM(STR(pID_Detail)), ThisFormSet.nConnHandle )
										
										*Remove old Process
										cSQLd = "DELETE FROM "
										DO CASE
										CASE cTBL = "S"
											cSQLd = cSQLd + " dbo.StockLst_Process "
										CASE cTBL = "B"
											cSQLd = cSQLd + " dbo.BrokerLst_Process "
										CASE cTBL = "W"
											cSQLd = cSQLd + " dbo.WIPLst_Process "
										ENDCASE
										cSQLd = cSQLd + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
										cSQLd = cSQLd + " AND ID_Detail = "+ALLTRIM(STR(nID_Detail_OLD))
										cSQLd = cSQLd + " AND AllowSub <> 'Y' "
										
										nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
										DO WHILE nSQLEXEC = 0
											WAIT WINDOW 'SQL' TIMEOUT 1
											nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
										ENDDO
										IF nSQLEXEC < 0
											*Could not Delete
											*Update History as SUBED
											SQLEXECError(cSQLd, ThisFormSet.nConnHandle, nSQLEXEC, '')
											cSQLd = "UPDATE "
											DO CASE
											CASE cTBL = "S"
												cSQLd = cSQLd + " HPAlloy_Archive.dbo.StockLst_Process_History "
											CASE cTBL = "B"
												cSQLd = cSQLd + " HPAlloy_Archive.dbo.BrokerLst_Process_History "
											CASE cTBL = "W"
												cSQLd = cSQLd + " HPAlloy_Archive.dbo.WIPLst_Process_History "
											ENDCASE
											cSQLd = cSQLd + " SET [WHAT]='SUBED' "
											cSQLd = cSQLd + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
											cSQLd = cSQLd + " AND [What] = 'DELETE' "
											cSQLd = cSQLd + " AND ID_Detail = "+ALLTRIM(STR(nID_Detail_OLD)) &&Added back 8/6/2015
		
											nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL' TIMEOUT 1
												nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
											ENDDO
											IF nSQLEXEC < 0
												SQLEXECError(cSQLd, ThisFormSet.nConnHandle, nSQLEXEC, '')
											ENDIF
		
											*Just Create a new Process
											THISFORMSET.Create_StockLst_Process(pID,pID_Detail,"SHOW",cTBL)
										ELSE
											*deleted -Add description to History
											cSQLd = "UPDATE "
											DO CASE
											CASE cTBL = "S"
												cSQLd = cSQLd + " HPAlloy_Archive.dbo.StockLst_Process_History "
											CASE cTBL = "B"
												cSQLd = cSQLd + " HPAlloy_Archive.dbo.BrokerLst_Process_History "
											CASE cTBL = "W"
												cSQLd = cSQLd + " HPAlloy_Archive.dbo.WIPLst_Process_History "
											ENDCASE
											cSQLd = cSQLd + " SET [WHAT]='SUBED'"
											cSQLd = cSQLd + " WHERE SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
											cSQLd = cSQLd + " AND [What] = 'DELETE' "
											cSQLd = cSQLd + " AND ID_Detail = "+ALLTRIM(STR(nID_Detail_OLD)) &&Added back 8/6/2015
											
											nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
											DO WHILE nSQLEXEC = 0
												WAIT WINDOW 'SQL' TIMEOUT 1
												nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQLd )
											ENDDO
											IF nSQLEXEC < 0
												SQLEXECError(cSQLd, ThisFormSet.nConnHandle, nSQLEXEC, '')
											ENDIF
											
											THISFORMSET.frmStockLstProcesses.Visible = .F.
											THISFORMSET.frmModiProcess.Visible = .F.
		
											*Deleted, Now Create New Process
											THISFORMSET.Create_StockLst_Process(pID,pID_Detail,"SHOW",cTBL)
										ENDIF
									ENDIF
		
								ENDIF
								
								
								**************************************************************
								IF nReturnCode = 0
									*Aborted.
									*Ask to Add
									nAns = MESSAGEBOX("You aborted the 'DELETE' process."+CHR(13)+;
										"Do you want to Abort this 'Add Process'?"+CHR(13)+;
										"Answer 'Yes' to NOT add a new material process."+CHR(13)+;
										"Answer 'No' to leave the old process as is "+CHR(13)+;
										"and ADD a new process."+CHR(13)+CHR(13)+;
										"or 'Cancel' to not add a new process.",3+16+512,"Salesman has marked as not to allow SUB.")
		
		
									IF nANS = 7
										THISFORMSET.Create_StockLst_Process(pID,pID_Detail,'SHOW',cTBL)
									ENDIF
								ENDIF
								
								IF nReturnCode = -2
									*Cold not delete process
									*Create a new Process
									THISFORMSET.Create_StockLst_Process(pID,pID_Detail,'SHOW',cTBL)
								ENDIF
									
								IF nReturnCode = -3
									*Deleted 
									*Create a new Process
									THISFORMSET.frmStockLstProcesses.Visible = .F.
									THISFORMSET.frmModiProcess.Visible = .F.
									
									ThisFormSet.RefreshTmpQuotes()
									ThisFormSet.StockLst_ID_Detail = pID_Detail
									ThisFormSet.RefreshStockLst("RELOAD")
									*ThisFormSet.ChangeStockLst()
									
									THISFORMSET.Create_StockLst_Process(pID,pID_Detail,'SHOW',cTBL)
								ENDIF
								
							ENDSCAN			
			********************************************************
							
						ENDIF
					ENDIF
				ELSE	&&Ans No to Delete
					*Just Create a new Process
					THISFORMSET.Create_StockLst_Process(pID,pID_Detail,"SHOW",cTBL)		
				ENDIF	
			ELSE
				*No Prc For this Order Item
				*Just Create a new Process, Process not for this order!
				THISFORMSET.Create_StockLst_Process(pID,pID_Detail,"SHOW",cTBL)
			ENDIF
		ENDIF
		IF USED("StockLst_Detail_SOitem")
			USE IN StockLst_Detail_SOitem
		ENDIF
		IF USED("StockLst_Detail_SOitem_Sub")
			USE IN StockLst_Detail_SOitem_Sub
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE choosepoitemload		&& Loads Form frmChoosePOitem
		PARAMETER pnHpaPo
		*ThisFormSet.ChoosePOitemLoad(nHPApo)
		
		*ThisFormSet.frmReceiving.Visible = .F.
		
		Private nHpaPo
		IF TYPE("pnHpaPo") = "N"
			nHpaPo = pnHpaPo
		ELSE
			nHpaPo = 0
		ENDIF
		
		IF USED("tmpPOitems")
			USE IN tmpPOitems
		ENDIF
		
		IF nHpaPo > 0
			ThisFormSet.frmChoosePOitem.Caption = ThisFormSet.frmChoosePOitem.Caption+" for PO# "+ALLTRIM(STR( nHpaPo ))
			
			cSQL = "SELECT POitem,SoItem,dbo.f_SalesPDescription(SalesP,Cover) AS SalesMan,Company,Alloy,Pieces"
			cSQL = cSQL + ",dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Order_Qty,RandLen ) AS Description"
			cSQL = cSQL + ",Cond_Spec,heat,OrderDate"
			cSQL = cSQL + ",Received,delivered,cancelled FROM dbo.PurchaseOrder " &&INTO CURSOR tmpPOitems;
			cSQL = cSQL + " WHERE HpaPo = "+STR(nHpaPo)
			  
		ELSE
			ThisFormSet.frmChoosePOitem.Caption = "Choose PO item"
			*SELECT All
			cSQL = "SELECT POitem,SoItem,dbo.f_SalesPDescription(SalesP,Cover) AS SalesMan,Company,Alloy,Pieces"
			cSQL = cSQL + ",dbo.f_ItemDescription(Form,Thck,Sz2,Sz3,Order_Qty,RandLen) AS Description,Cond_Spec,heat,OrderDate"
			cSQL = cSQL + ",Received,delivered,cancelled FROM dbo.PurchaseOrder " &&INTO CURSOR tmpPOitems ORDER BY POitem
			 
		ENDIF
		
		IF USED("tmpPOitems")
			SELECT tmpPOitems 
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOitems')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpPOitems')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpPOitems')
		ENDIF
		
		IF USED("tmpPOitems")
			SELECT tmpPOitems
			GO BOTTOM
			IF RECCOUNT() > 10
			 	SKIP -10
			ENDIF 
		ENDIF
		
		ThisFormSet.frmChoosePOitem.grdChoosePOitem.RecordSource = "tmpPOitems"
		*ThisForm.grdChoosePOitem.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		ThisFormSet.frmChoosePOitem.txtAlloy.Value = tmpPOitems.Alloy
		ThisFormSet.frmChoosePOitem.txtDescription.Value = tmpPOitems.Description
		
		
		*ThisForm.grid.SetFocus
		
		IF ThisFormSet.frmChoosePOitem.Top > 1000
			ThisFormSet.frmChoosePOitem.Top = 300
		ENDIF
		
		IF RECCOUNT("tmpPOitems") = 1
			ThisFormset.frmChoosePOitem.cmdSelect.Click()
		ELSE
			ThisFormSet.frmChoosePOitem.Visible = .T.
			IF RECCOUNT("tmpPOitems") = 0
				MESSAGEBOX("Sorry, PO number not Found",32,"No records to Show!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE chooseso
		*ThisFormSet.ChooseSO
		
		ThisFormSet.frmStockLstProcesses.Visible = .F.
		ThisFormSet.frmModiProcess.Visible = .F.
		ThisFormSet.frmColorStandards.Visible = .F.
		ThisFormSet.frmStockLst.Visible = .F.
		ThisFormSet.frmStockStatus.Visible = .F.
		ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
		ThisFormSet.frmSimiliarSales.Visible = .F.
		*ThisFormSet.frmQuote.Visible = .F.
		
		ThisFormset.frmChooseSO.Top = 30
		ThisFormset.frmChooseSO.Left = 2
		ThisFormset.frmChooseSO.grdOpensales.RecordSource = ""
		
		IF USED("OpenSales")
			USE IN OpenSales
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT S.SOitem, S.ShipDue,S.Shipped,S.Qshipped,S.QBackOrder,S.prcp,S.Urgent,S.SalesNum "
		cSQL = cSQL +" FROM dbo.Sales S "
		cSQL = cSQL +" WHERE ISNULL(S.Cncld,0)=0 "
		*cSQL = cSQL +" AND ISNULL(S.prcp,0)!=0 "
		*cSQL = cSQL +" AND ISNULL(S.prcd,0)!=0 "
		cSQL = cSQL +" AND ISNULL(S.Cmplt,0)=0 "
		cSQL = cSQL +" ORDER BY ISNULL(S.Urgent,' '), ShipDue "
		  
		
		** S.prcp  Process in Progress
		** S.pckd  Process Packaged
		** S.prcd  Process Done
			  
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'OpenSales')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'OpenSales' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'OpenSales')
		ENDIF
		  
		ThisFormset.frmChooseSO.grdOpensales.RecordSource = "OPENSALES"
			  
		ThisFormset.frmChooseSO.grdOpensales.Refresh
		ThisFormset.frmChooseSO.Visible = .T.
		ThisFormset.frmChooseSO.grdOpensales.SetFocus()
		
		ThisFormSet.frmShop_StockLst_Edit.txtWO.Visible = .F.
		ThisFormSet.frmShop_StockLst_Edit.lblWO.Visible = .F.
		
		***********
		IF USED("tmpSerBase")
			USE IN tmpSerBase
		ENDIF
		SELECT 0
		
		cSQL = "SELECT serverproperty('MachineName') AS [Server] ,DB_NAME() AS [Database]"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSerBase')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSerBase')
		ENDDO
		IF nSQLEXEC < 0
		*	SQLEXECError(cSQL, gnConnHandle,nSQLEXEC, 'tmpSerBase')
			 RecordError(1, 'SQL Error', 'frmQuotes.ShowProcess', 1, "Could not'SELECT serverproperty('MachineName')")
			 MESSAGEBOX("Could not'SELECT serverproperty('MachineName')",16,"SQL Error")
		ELSE
			IF USED("tmpSerBase")
				IF VARTYPE(tmpSerBase.Server) = "C"
					ThisFormset.frmChooseSO.lblServer.Caption = tmpSerBase.Server
					ThisFormset.frmChooseSO.lblDatabase.Caption = tmpSerBase.Database
				ELSE
					ThisFormset.frmChooseSO.lblServer.Caption = ' '
					ThisFormset.frmChooseSO.lblDatabase.Caption = ' ' 
				ENDIF
				USE IN tmpSerBase			
			ELSE
				ThisFormset.frmChooseSO.lblServer.Caption = ' '
				ThisFormset.frmChooseSO.lblDatabase.Caption = ' ' 
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE choosewo
		*ThisFormSet.ChooseWO
		
		ThisFormSet.frmStockLstProcesses.Visible = .F.
		ThisFormSet.frmModiProcess.Visible = .F.
		ThisFormSet.frmColorStandards.Visible = .F.
		ThisFormSet.frmStockStatus.Visible = .F.
		ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
		ThisFormSet.frmSimiliarSales.Visible = .F.
		*ThisFormSet.frmQuote.Visible = .F.
		
		ThisFormset.frmChooseWO.Top = 30
		ThisFormset.frmChooseWO.Left = 2
		ThisFormset.frmChooseWO.grdOpenWO.RecordSource = ""
		
		IF USED("OpenWO")
			USE IN OpenWO
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		*cSQL = "SELECT S.SOitem, S.ShipDue,S.Shipped,S.Qshipped,S.QBackOrder,S.prcp,S.Urgent,S.SalesNum "
		cSQL = "SELECT WO,StartDate,sAlloy,Descript,SOitem,POitem,DueDate"
		cSQL = cSQL +" FROM dbo.WorkOrder "
		cSQL = cSQL +" WHERE ISNULL(Cncld,0)=0 "
		cSQL = cSQL +" ORDER BY ISNULL(StartDate,' ')"
		  
		
		** S.prcp  Process in Progress
		** S.pckd  Process Packaged
		** S.prcd  Process Done
			  
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'OpenWO')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'OpenWO' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'OpenWO')
		ENDIF
		  
		*ThisFormset.frmChooseSO.grdOpensales.RecordSource = "OPENSALES"
		ThisFormset.frmChooseWO.grdOpenWO.RecordSource = "OpenWO"
			  
		ThisFormset.frmChooseWO.grdOpenWO.Refresh
		ThisFormset.frmChooseWO.Visible = .T.
		ThisFormset.frmChooseWO.grdOpenWO.SetFocus()
		
		***********
		IF USED("tmpSerBase")
			USE IN tmpSerBase
		ENDIF
		SELECT 0
		
		cSQL = "SELECT ServerProperty('MachineName') AS [Server] ,DB_NAME() AS [Database]"
		
		nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSerBase')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisFormSet.nConnHandle, cSQL, 'tmpSerBase')
		ENDDO
		IF nSQLEXEC < 0
		*	SQLEXECError(cSQL, gnConnHandle,nSQLEXEC, 'tmpSerBase')
			 RecordError(1, 'SQL Error', 'frmQuotes.ShowProcess', 1, "Could not'SELECT serverproperty('MachineName')")
			 MESSAGEBOX("Could not'SELECT serverproperty('MachineName')",16,"SQL Error")
		ELSE
			IF USED("tmpSerBase")
				IF VARTYPE(tmpSerBase.Server) = "C"
					ThisFormset.frmChooseWO.lblServer.Caption = tmpSerBase.Server
					ThisFormset.frmChooseWO.lblDatabase.Caption = tmpSerBase.Database
				ELSE
					ThisFormset.frmChooseWO.lblServer.Caption = ' '
					ThisFormset.frmChooseWO.lblDatabase.Caption = ' ' 
				ENDIF
				USE IN tmpSerBase			
			ELSE
				ThisFormset.frmChooseWO.lblServer.Caption = ' '
				ThisFormset.frmChooseWO.lblDatabase.Caption = ' ' 
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE create_stocklst_process
		PARAMETER pID, pID_Detail, pShow, pTBL
		**ThisFormSet.Create_StockLst_Process( ID, ID_Detail, 'NOEDIT', "S" )
		PRIVATE lShow, cSQL, nSQLEXEC 
		lShow = .F.
		
		IF TYPE("pShow") = "C"
			IF pShow = "NOEDIT"
				lShow = .T.
			ENDIF
		ELSE
			pShow = " "
		ENDIF
		
		IF TYPE("pShow")!="C"
			pShow = " "
		ENDIF
		
		PRIVATE cTBL
		IF TYPE("pTBL") != "C"
			cTBL = ""
		ELSE
			cTBL = pTBL
		ENDIF
		
		IF NOT cTBL $ "SBW"
			MESSAGEBOX("Create_StockLst_Process did not recognize Table Name",0+16,"Aborting Save!")
			TrackError("Create_StockLst_Process did not recognize Table Name","Create_StockLst_Process did not recognize Table Name","frmShop_StockLst_Edit.Create_StockLst_Process",LINENO())
			RETURN .F.
		ENDIF
		
		m.ID_Detail_Process = 0
		THISFORMSET.frmModiProcess.ID_Detail_Process1.Value = 0
		
		IF TYPE("pID") = "N" AND TYPE("pID_Detail") = "N"
		
			IF pID = 0
				RecordError(1, "Trouble!"+CHR(13)+"Parameter pID is 0", 'frmShop_stockLst_Edit:Create_StockLst_Process', 51, "ID was set to 0")
			ENDIF
			IF pID_Detail = 0
				RecordError(1, "Trouble!"+CHR(13)+"Paramter pID_Detail is 0", 'frmShop_stockLst_Edit:Create_StockLst_Process', 55, "ID_Detail was set to 0")
			ENDIF
			
			THISFORMSET.frmModiProcess.ID1.VALUE = pID
			IF pID_Detail > 0
				THISFORMSET.frmModiProcess.ID_Detail1.VALUE = pID_Detail
				ThisFormSet.StockLst_ID_Detail = pID_Detail
			ELSE
				THISFORMSET.frmModiProcess.ID_Detail1.VALUE = 0
				ThisFormSet.StockLst_ID_Detail = 0
			ENDIF
			
			IF lShow
				IF USED("tmpID_Detail_Process")
					USE IN tmpID_Detail_Process
				ENDIF
				SELECT 0
				
				DO CASE
				CASE cTBL = "S"
					cSQL = "SELECT * FROM dbo.StockLst_Process "
				CASE cTBL = "B"
					cSQL = "SELECT * FROM dbo.BrokerLst_Process "
				CASE cTBL = "W"
					cSQL = "SELECT * FROM dbo.WIPLst_Process "
				ENDCASE
				cSQL = cSQL + " WHERE ID_Detail="+STR(pID_Detail)
				
				nSQLEXEC = SQLEXEC(THISFORMset.nConnHandle, cSQL, 'tmpID_Detail_Process' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpID_Detail_Process' )
				ENDDO
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				ELSE
					THISFORMSET.frmModiProcess.SOitem1.VALUE 	= tmpID_Detail_Process.SOitem
					THISFORMSET.frmModiProcess.POitem1.VALUE 	= tmpID_Detail_Process.PO_item
					THISFORMSET.frmModiProcess.SalesPerson1.VALUE=tmpID_Detail_Process.SalesPerson
					THISFORMSET.frmModiProcess.StartDate1.VALUE = tmpID_Detail_Process.StartDATE
					THISFORMSET.frmModiProcess.DueDate1.VALUE 	= tmpID_Detail_Process.DueDATE
					THISFORMSET.frmModiProcess.AllowSub1.VALUE 	= tmpID_Detail_Process.AllowSub
					THISFORMSET.frmModiProcess.pWeight1.VALUE 	= tmpID_Detail_Process.pWeight
					THISFORMSET.frmModiProcess.QTY1.VALUE 		= tmpID_Detail_Process.QTY
					THISFORMSET.frmModiProcess.PU1.VALUE 		= tmpID_Detail_Process.PU
					THISFORMSET.frmModiProcess.Process_ID1.VALUE= tmpID_Detail_Process.Process_ID
					THISFORMSET.frmModiProcess.Processor1.VALUE	= tmpID_Detail_Process.Processor
					THISFORMSET.frmModiProcess.Comment1.VALUE	= tmpID_Detail_Process.Comment
					THISFORMSET.frmModiProcess.ogSOitem.Value	= IIF(EMPTY(tmpID_Detail_Process.SOitem), 2, 1)
					THISFORMSET.frmModiProcess.ID_Detail_Process1.Value  = tmpID_Detail_Process.ID_Detail_Process
					
					THISFORMSET.frmModiProcess.ogSOitem.Enabled = .F.
					THISFORMSET.frmModiProcess.cmdSave.Enabled = .F.
		
					THISFORMSET.frmModiProcess.cmdShowStockLst.Enabled = .F.
		
					DO CASE
					CASE cTBL = "S"
						ThisFormSet.frmModiProcess.txtTBL.Value = "S"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Show StockLst Process"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .F.
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
					CASE cTBL = "B"
						ThisFormSet.frmModiProcess.txtTBL.Value = "B"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Show BrokerLst Process"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .T.
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify BrokerLst"
					CASE cTBL = "W"
						ThisFormSet.frmModiProcess.txtTBL.Value = "W"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Show WIPLst Process"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .T.
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify WIPLst"
					ENDCASE			
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .F.
					THISFORMSET.frmModiProcess.lblStartDate1.Enabled = .T.
					THISFORMSET.frmModiProcess.lblDueDate1.Enabled = .T.
					
		*			ThisFormSet.StockLstProcesses(pID, pType, pWhat)  --Refresh window
					
					IF USED("tmpID_Detail_Process")
						USE IN tmpID_Detail_Process
					ENDIF
				ENDIF
			ELSE
				DO CASE
				CASE pShow = "CORRECTION"
					ThisFormset.frmModiProcess.ogSOitem.Value = 2
					ThisFormset.frmModiProcess.ogSOitem.Enabled = .F.
					ThisFormset.frmModiProcess.ogSOitem.Refresh
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .F.
					ThisFormset.frmModiProcess.SOITEM1.VISIBLE = .F.
					ThisFormset.frmModiProcess.WO1.VISIBLE = .F.
					THISFORMSET.frmModiProcess.POitem1.Visible = .F.
					ThisFormset.frmModiProcess.lblSalesPerson1.Visible = .F.
					ThisFormset.frmModiProcess.SalesPerson1.Visible = .F.
					ThisFormset.frmModiProcess.lblstartDate1.Visible = .F.
					ThisFormset.frmModiProcess.StartDate1.Visible = .F.
					ThisFormset.frmModiProcess.lblDueDate1.Visible = .F.
					ThisFormset.frmModiProcess.DueDate1.Visible = .F.
					ThisFormset.frmModiProcess.lblAllowSub.VISIBLE = .F.
					ThisFormset.frmModiProcess.AllowSub1.VISIBLE = .F.
					ThisFormset.frmModiProcess.lblWeight1.Visible = .F.
					ThisFormset.frmModiProcess.pWeight1.Visible = .F.
					ThisFormset.frmModiProcess.lblQTY.Visible = .F.
					ThisFormset.frmModiProcess.QTY1.Visible = .F.
					ThisFormset.frmModiProcess.PU1.Visible = .F.
					ThisFormset.frmModiProcess.lblProcess_ID1.Visible = .F.
					ThisFormset.frmModiProcess.Process_ID1.Visible = .F.
					ThisFormset.frmModiProcess.lblProcessor1.Visible = .F.
					ThisFormset.frmModiProcess.Processor1.Visible = .F.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .F.
					THISFORMSET.frmModiProcess.cmdSave.Enabled = .T.
					THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .F.
					THISFORMSET.frmModiProcess.cmdShowStockLst.Enabled = .F.
					
					DO CASE
					CASE cTBL = "S"
						ThisFormSet.frmModiProcess.txtTBL.Value = "S"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create StockLst Correction"
					CASE cTBL = "B"
						ThisFormSet.frmModiProcess.txtTBL.Value = "B"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify BrokerLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create BrokerLst Correction"
					CASE cTBL = "W"
						ThisFormSet.frmModiProcess.txtTBL.Value = "W"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify WIPLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create WIPLst Correction"
					ENDCASE
		
					
				CASE pShow = 'NOEDIT'
					THISFORMSET.frmModiProcess.ogSOitem.Enabled = .T.
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .T.
					
					ThisFormset.frmModiProcess.SOITEM1.VISIBLE = .T.
					ThisFormset.frmModiProcess.WO1.VISIBLE = .T.
					THISFORMSET.frmModiProcess.POitem1.Visible = .T.
					ThisFormset.frmModiProcess.lblSalesPerson1.Visible = .T.
					ThisFormset.frmModiProcess.SalesPerson1.Visible = .T.
					ThisFormset.frmModiProcess.lblstartDate1.Visible = .T.
					ThisFormset.frmModiProcess.StartDate1.Visible = .T.
					ThisFormset.frmModiProcess.lblDueDate1.Visible = .T.
					ThisFormset.frmModiProcess.DueDate1.Visible = .T.
					ThisFormset.frmModiProcess.lblAllowSub.VISIBLE = .T.
					ThisFormset.frmModiProcess.AllowSub1.VISIBLE = .T.
					ThisFormset.frmModiProcess.lblWeight1.Visible = .T.
					ThisFormset.frmModiProcess.pWeight1.Visible = .T.
					ThisFormset.frmModiProcess.lblQTY.Visible = .T.
					ThisFormset.frmModiProcess.QTY1.Visible = .T.
					ThisFormset.frmModiProcess.PU1.Visible = .T.
					ThisFormset.frmModiProcess.lblProcess_ID1.Visible = .T.
					ThisFormset.frmModiProcess.Process_ID1.Visible = .T.
					ThisFormset.frmModiProcess.lblProcessor1.Visible = .T.
					ThisFormset.frmModiProcess.Processor1.Visible = .T.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.
		
					THISFORMSET.frmModiProcess.cmdSave.Enabled = .T.
					THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .F.
					THISFORMSET.frmModiProcess.cmdShowStockLst.Enabled = .F.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.			
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .F.
					
					DO CASE
					CASE cTBL = "S"
						ThisFormSet.frmModiProcess.txtTBL.Value = "S"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "StockLst Process"
					CASE cTBL = "B"
						ThisFormSet.frmModiProcess.txtTBL.Value = "B"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify BrokerLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "BrokerLst Process"
					CASE cTBL = "W"
						ThisFormSet.frmModiProcess.txtTBL.Value = "W"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify WIPLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "WIPLst Process"
					ENDCASE
		
					
				OTHERWISE
					*The standard 
					*NOT  "CORRECTION" nor 'NOEDIT'
					THISFORMSET.frmModiProcess.SOitem1.VALUE 	= tmpSO.SOitem
					THISFORMSET.frmModiProcess.WO1.VALUE 		= tmpSO.WO
					THISFORMSET.frmModiProcess.POitem1.VALUE 	= tmpSO.POitem
					THISFORMSET.frmModiProcess.SalesPerson1.VALUE = SalesPDescription(tmpSO.SalesP,tmpSO.Cover)
					THISFORMSET.frmModiProcess.StartDate1.VALUE = DATE()
					THISFORMSET.frmModiProcess.DueDate1.VALUE 	= tmpSO.ShipDue
					THISFORMSET.frmModiProcess.AllowSub1.VALUE 	= 'Y'
					THISFORMSET.frmModiProcess.pWeight1.VALUE 	= tmpSO.Weight
					THISFORMSET.frmModiProcess.QTY1.VALUE 		= tmpSO.QTY
					THISFORMSET.frmModiProcess.PU1.VALUE 		= tmpSO.PU
					
					THISFORMSET.frmModiProcess.Process_ID1.VALUE = "SELECTED"
					THISFORMSET.frmModiProcess.Processor1.VALUE	= ShowSQLtxt(SUBSTR(SYS(0),AT("#",SYS(0))+1),'Processor',20)
					THISFORMSET.frmModiProcess.Comment1.VALUE	= ShowSQLtxt(ALLTRIM(STR(tmpSO.Pieces))+"Pc "+ItemDescriptionMetric(tmpSO.Form, tmpSO.Thck, tmpSO.SZ2, tmpSO.SZ3, tmpSO.Weight, .F., .F.,'','','' ),'Comment',100)
		
					THISFORMSET.frmModiProcess.ogSOitem.Value = 1
					THISFORMSET.frmModiProcess.ogSOitem.Enabled = .T.
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .T.
					
					ThisFormset.frmModiProcess.SOITEM1.VISIBLE = .T.
					ThisFormset.frmModiProcess.WO1.VISIBLE = .T.
					THISFORMSET.frmModiProcess.POitem1.Visible = .T.
					ThisFormset.frmModiProcess.lblSalesPerson1.Visible = .T.
					ThisFormset.frmModiProcess.SalesPerson1.Visible = .T.
					ThisFormset.frmModiProcess.lblstartDate1.Visible = .T.
					ThisFormset.frmModiProcess.StartDate1.Visible = .T.
					ThisFormset.frmModiProcess.lblDueDate1.Visible = .T.
					ThisFormset.frmModiProcess.DueDate1.Visible = .T.
					ThisFormset.frmModiProcess.lblAllowSub.VISIBLE = .T.
					ThisFormset.frmModiProcess.AllowSub1.VISIBLE = .T.
					ThisFormset.frmModiProcess.lblWeight1.Visible = .T.
					ThisFormset.frmModiProcess.pWeight1.Visible = .T.
					ThisFormset.frmModiProcess.lblQTY.Visible = .T.
					ThisFormset.frmModiProcess.QTY1.Visible = .T.
					ThisFormset.frmModiProcess.PU1.Visible = .T.
					ThisFormset.frmModiProcess.lblProcess_ID1.Visible = .T.
					ThisFormset.frmModiProcess.Process_ID1.Visible = .T.
					ThisFormset.frmModiProcess.lblProcessor1.Visible = .T.
					ThisFormset.frmModiProcess.Processor1.Visible = .T.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.
		
					THISFORMSET.frmModiProcess.cmdSave.Enabled = .T.
					THISFORMSET.frmModiProcess.cmdModifyStockLst.Enabled = .F.
					THISFORMSET.frmModiProcess.cmdShowStockLst.Enabled = .F.
					ThisFormset.frmModiProcess.lblProjFinishDate.Visible = .T.			
					THISFORMSET.frmModiProcess.ogSOitem.Visible = .F.
					
					*Set at beginning
					*ThisFormSet.frmModiProcess.ID1.Value =  pID
					*ThisFormSet.frmModiProcess.ID_Detail1.Value = pID_Detail
					*ThisFormSet.frmModiProcess.ID_Detail_Process1.Value = *
					*Set to 0 to Create!
					
					DO CASE
					CASE cTBL = "S"
						ThisFormSet.frmModiProcess.txtTBL.Value = "S"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify StockLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create StockLst Process"
					CASE cTBL = "B"
						ThisFormSet.frmModiProcess.txtTBL.Value = "B"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify BrokerLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create BrokerLst Process"
					CASE cTBL = "W"
						ThisFormSet.frmModiProcess.txtTBL.Value = "W"
						THISFORMSET.frmModiProcess.cmdModifyStockLst.Caption = "Modify WIPLst"
						THISFORMSET.frmModiProcess.lblCreateStockLstProcess.Caption = "Create WIPLst Process"
					ENDCASE
				ENDCASE
			ENDIF
		
			THISFORMSET.frmModiProcess.VISIBLE = .T.
			
			ThisFormSet.SumProcess()
			
			THISFORMSET.frmModiProcess.StartDate1.SETFOCUS()
		ELSE
			MESSAGEBOX("no ID or ID_Detail for Create_StockLst_Process()",0+16,'No Parameters')
		ENDIF
		
		
		
		**Check for correct SO
		PRIVATE nSO
		nSO = ThisFormset.frmShop_StockLst_Edit.txtSO.Value
		IF VARTYPE(nSO) = "C"
			nSO = VAL(nSO)
		ENDIF
		IF VARTYPE(nSO) != "N"
			nSO = 0
		ENDIF
		
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		SELECT 0
		
		DO CASE
		CASE cTBL = "S"
			cSQL = "SELECT COUNT(*) AS cnt FROM dbo.StockLst_Process "
		CASE cTBL = "B"
			cSQL = "SELECT COUNT(*) AS cnt FROM dbo.BrokerLst_Process "
		CASE cTBL = "W"
			cSQL = "SELECT COUNT(*) AS cnt FROM dbo.WIPLst_Process "
		ENDCASE
		cSQL = cSQL+ " WHERE SOitem LIKE '%"+ALLTRIM(STR(nSO))+"-%'"
		cSQL = cSQL+ " AND ID_Detail="+STR(pID_Detail)
		
		nSQLEXEC = SQLEXEC(THISFORMset.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpID_Detail_Process' )
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
		ENDIF
		IF USED("tmpID_Detail_Process")
			IF VARTYPE(tmpID_Detail_Process.cnt) = "N"
				IF tmpID_Detail_Process.cnt > 0
					*Found that SO and ID_Detail
				ELSE
					*MESSAGEBOX("This Process does not contain the Sales Order you started with.",0+48,"Warning, not SO:"+ALLTRIM(STR(nSO)))
					WAIT WINDOW "This Process does not contain the Sales Order you started with!" NOWAIT
				ENDIF
			ENDIF
			USE IN tmpID_Detail_Process
		ENDIF
		
		*Check for Receiving Record
		PRIVATE cPOitem 
		cPOitem = THISFORMSET.frmModiProcess.POitem1.VALUE
		IF VARTYPE(cPOitem) != "C"
			cPOitem = ""
		ENDIF
		
		IF NOT EMPTY(cPOitem )
			IF USED("tmpCntReceiving")
				USE IN tmpCntReceiving
			ENDIF
			SELECT 0
		
			cSQL = "SELECT COUNT(*) AS cnt FROM dbo.Receiving "
			cSQL = cSQL+ " WHERE dbo.f_ProperPOitem(POitem) = dbo.f_ProperPOitem('"+cPOitem+"')"
		
		
			nSQLEXEC = SQLEXEC(THISFORMset.nConnHandle, cSQL, 'tmpCntReceiving' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORMSET.nConnHandle, cSQL, 'tmpCntReceiving' )
			ENDDO
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpCntReceiving')
			ENDIF
			IF USED("tmpCntReceiving")
				IF VARTYPE(tmpCntReceiving.cnt) = "N"
					IF tmpCntReceiving.cnt > 0
						*Found PO in Receiving
						ThisFormset.frmModiProcess.cmdReceiving.Enabled = .F.
					ELSE
						ThisFormset.frmModiProcess.cmdReceiving.Enabled = .T.
						MESSAGEBOX("This 'Process / PO' number "+CHR(13)+"does not contain Receiving Record.",0+48,"Warning, not RECEIVED")
					ENDIF
				ENDIF
				USE IN tmpCntReceiving
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Destroy
		*frmShop_StockLst_Edit
		
		IF TYPE("ThisFormSet.frmQuote") = "O"
			ThisFormSet.frmQuote.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmStockLst") = "O"
			ThisFormSet.frmStockLst.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmModiProcess") = "O"
			ThisFormSet.frmModiProcess.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmStockLstProcesses") = "O"
			ThisFormSet.frmStockLstProcesses.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmChooseSO") = "O"
			ThisFormSet.frmChooseSO.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmColorStandards") = "O"
			ThisFormSet.frmColorStandards.Release
		ENDIF
		
		*IF TYPE("ThisFormSet.frmReceiving") = "O"
		*	ThisFormSet.frmReceiving.Release
		*ENDIF
		
		IF TYPE("ThisFormSet.frmChoosePOitem") = "O"
			ThisFormSet.frmChoosePOitem.Release
		ENDIF
		
		*IF TYPE("ThisFormSet.frmRecvStock") = "O"
		*	ThisFormSet.frmRecvStock.Release
		*ENDIF
		
		IF TYPE("ThisFormSet.frmStockStatus") = "O"
			ThisFormSet.frmStockStatus.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmStockLstProcessHistory") = "O"
			ThisFormSet.frmStockLstProcessHistory.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmSimiliarSales") = "O"
			ThisFormSet.frmSimiliarSales.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmSimiliarOrdersProcess") = "O"
			ThisFormSet.frmSimiliarOrdersProcess.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmRecollectCerts") = "O"
			ThisFormSet.frmRecollectCerts.Release
		ENDIF
		
		IF TYPE("ThisFormSet.frmCerts") = "O"
			ThisFormSet.frmCerts.Release
		ENDIF
		
		**
		IF VARTYPE(HPA_Menu) = "O"  &&
			HPA_Menu.WindowState = 0
		ENDIF
		**
		
	ENDPROC

	PROCEDURE disappear
		PARAMETER lHide
		*ThisFormSet.Disappear( .T. )
		
		IF TYPE("lHide") = "L"
			IF lHide
				ThisFormSet.frmShop_StockLst_Edit.Visible = .F.
				ThisFormSet.frmQuote.Visible = .F.
				ThisFormSet.frmStockLst.Visible = .F.
				ThisFormSet.frmStockStatus.Visible = .F.
				ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
				ThisFormSet.frmSimiliarSales.Visible = .F.
				ThisFormSet.frmModiProcess.Visible = .F.
				ThisFormSet.frmStockLstProcesses.Visible = .F.
				ThisFormSet.frmChooseSO.Visible = .F.
				ThisFormSet.frmColorStandards.Visible = .F.
		*		ThisFormSet.frmReceiving.Visible = .F.
			ELSE
				ThisFormSet.frmShop_StockLst_Edit.Visible = .T.
				ThisFormSet.frmQuote.Visible = .T.
				ThisFormSet.frmStockLst.Visible = .F.
				ThisFormSet.frmStockStatus.Visible = .F.
				ThisFormSet.frmSimiliarOrdersProcess.Visible = .F.
				ThisFormSet.frmSimiliarSales.Visible = .F.
				ThisFormSet.frmModiProcess.Visible = .F.
				ThisFormSet.frmStockLstProcesses.Visible = .F.
				ThisFormSet.frmChooseSO.Visible = .F.
				ThisFormSet.frmColorStandards.Visible = .F.
		*		ThisFormSet.frmReceiving.Visible = .T.
			
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE dynamicbackcolor_alloy
		PRIVATE nColor
		*DynamicBackColor_Alloy()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		DO CASE
		CASE tmpSO.INV 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		OTHERWISE 
			nColor = RGB( 255,255,128 )  &&Yellow - Due In
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamicbackcolor_bkr
		PRIVATE nColor
		*DynamicBackColor_Bkr
		*Called from grdSO.clmBrk.DynamicBackColor()
		DO CASE
		CASE tmpSO.CnCld 
			nColor = RGB( 0, 0, 0 )  &&Black
		CASE tmpSO.Cmplt
			nColor = RGB( 192, 220, 192 )  &&GREEN
			
		CASE tmpSO.prcp AND !tmpSO.prcd
			nColor = RGB( 255, 255, 128 ) &&YELLOW
			
		CASE !tmpSO.prcp AND tmpSO.prcd
			nColor = RGB( 255,128,64 ) &&ORANGE
			
		CASE tmpSO.pckd
			nColor = RGB( 255, 0, 0 ) &&RED
			
		CASE tmpSO.Bkr > 0
			*Has Process
			nColor = RGB( 128, 255, 255 ) &&Lt Blue
			
		OTHERWISE
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamicbackcolor_form
		PRIVATE nColor
		*DynamicBackColor_Form
		
		DO CASE
		CASE tmpSO.GFM
			nColor = RGB( 0, 128, 128 )  &&Dk GREEN
		CASE tmpSO.Roll
			nColor = RGB( 192, 220, 192 )  &&GREEN
		CASE tmpSO.Mach
			nColor = RGB( 255,128,64 ) &&ORANGE
		CASE tmpSO.CG
			nColor = RGB( 128,255,255 ) &&Lt Blue
		CASE tmpSO.Plasma	
			nColor = RGB( 255,128,255 ) &&Violet
		OTHERWISE
			*nColor = RGB( 192,192,192 ) &&Grey
			nColor = RGB( 255,255,255 ) &&White
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamicbackcolor_prc
		PRIVATE nColor
		*DynamicBackColor_PRC
		
		*Called from grdSO.clmPrc.DynamicBackColor()
		
		*PRCP = Process in Progress
		*PRCD = Processing Done
		*PCKD = Item has been Packaged
		
		DO CASE
		CASE tmpSO.CnCld 
			nColor = RGB( 0, 0, 0 )  &&Black
			*Cancelled
			
		CASE tmpSO.Cmplt
			*Not Cancelled
			nColor = RGB( 192, 220, 192 )  &&GREEN
			*Complete
			
		CASE tmpSO.pckd
			*Not Cancelled, Not Complete
			nColor = RGB( 255, 0, 0 ) &&RED
			*Packed
			
		CASE !tmpSO.prcp AND tmpSO.prcd 
			*Not Cancelled, Not Complete, Not Packed
			nColor = RGB( 255,128,64 ) &&ORANGE
			*Packing
			
		CASE tmpSO.prcp AND !tmpSO.prcd 
			*Not Cancelled, Not Complete, Not Packed
			nColor = RGB( 255, 255, 128 ) &&YELLOW
			*In Progress
			
		CASE tmpSO.Prc > 0
			*Has Process
			nColor = RGB( 128, 255, 255 ) &&Lt Blue
			
		OTHERWISE
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		*	
		*	nColor = RGB( 128, 128, 128 )  &&Grey
		*	nColor = RGB( 255,128,64 ) &&ORANGE
		*	nColor = RGB( 255, 255, 128 ) &&YELLOW
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynamic_back_color_invcheck
	ENDPROC

	PROCEDURE dynbc_frmchoosepoitem_grid		&& Fomr frmChoosePOitem
		PRIVATE nColor
		*DynBC_frmChoosePOitem_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		CASE tmpPOitems.cancelled
			nColor = RGB( 255, 0, 0 ) &&RED	
		CASE tmpPOitems.delivered
			nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

