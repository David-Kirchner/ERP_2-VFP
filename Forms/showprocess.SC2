	PROCEDURE delete_rtr_detail		&& A Deleted Process will auto mark the rtr_Detail as Finished. Remove from rtr_Detail table so tigger [StockLst_Process_Delete]
		*ThisForm.Delete_rtr_Detail()
		*TrackError("Did not get a TBL","cTBL:"+pTBL+"  nID_Detail="+STR(nID_Detail),"ShowProcess:Init",LINENO(1))
		
		PRIVATE cTBL, nID_Detail_Process, nWO, cSOitem, cPOitem
		cTBL			= PrepareSQLtxt(ThisForm.TBL1.Value,'TBL',1)
		nID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		*nWO 			= PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		*cSOitem			= PrepareSQLtxt(ThisForm.SOITEM1.Value,'SOitem',10)
		*cPOitem			= PrepareSQLtxt(ThisForm.POITEM1.Value,'POitem',12)
		
		
		PRIVATE cSQL, nSQLEXEC
			
		cSQL = "DELETE FROM dbo.rtr_Detail "
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " WHERE TBL = 'S' "
		CASE cTBL = "B"
			cSQL = cSQL + " WHERE TBL = 'B' "
		CASE cTBL = "W"
			cSQL = cSQL + " WHERE TBL = 'W' "
		OTHERWISE
			TrackError("Did not get a TBL","cTBL:"+cTBL+"  ID_Detail_Process="+STR(nID_Detail_Process),"ShowProcess:Delete_rtr_Detail()",LINENO(1))
		ENDCASE
		cSQL = cSQL + " AND ID_Detail_Process = "+STR(nID_Detail_Process)
		cSQL = cSQL + " AND [Finished] = 0"	&&Do not remove Finished=1
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, '' )
			RETURN .F.
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE Init
		PARAMETER pID_Detail, pTBL, pSalesNum
		*DO FORM Forms\ShowProcess WITH ID_Detail,cTBL,nSalesNum
		*DO FORM Forms\ShowProcess WITH 45991,"S",135514
		* Only Pass SalesNum if you want to limit display to that SalesNum
		
		*Renamed From frmShowStockLstProcess
		
		PRIVATE nID_Detail,cTBL
		
		IF TYPE("pID_Detail")="N"
			nID_Detail = pID_Detail
		ELSE
			nID_Detail = 0
		ENDIF
		IF VARTYPE(pTBL) != "C"
			pTBL = "S"
		ENDIF
		pTBL = UPPER(pTBL)
		ThisForm.cTBL = pTBL
		
		PRIVATE nSalesNum
		nSalesNum = 0
		IF VARTYPE(pSalesNum) = 'N'
			nSalesNum = pSalesNum 
		ENDIF
			
			
		***********************
		
		PRIVATE cSQL, nSQLEXEC
		
		IF nSalesNum > 0
			ThisForm.nSalesNum = nSalesNum 
		ENDIF
		
		*DO CASE
		*CASE nSalesNum > 0
		*	ThisForm.nSalesNum = nSalesNum 
		*	cSQL = "SELECT *,'S' AS TBL FROM dbo.StockLst_Process WITH(NOLOCK) WHERE SOitem LIKE '%"+ALLTRIM(STR(nSalesNum))+"-%'"
		*	cSQL = cSQL + " UNION "	
		*	cSQL = cSQL + "SELECT *,'B' AS TBL FROM dbo.BrokerLst_Process WITH(NOLOCK) WHERE SOitem LIKE '%"+ALLTRIM(STR(nSalesNum))+"-%'"
		*	cSQL = cSQL + " UNION "	
		*	cSQL = cSQL + "SELECT *,'W' AS TBL FROM dbo.WIPLst_Process WITH(NOLOCK) WHERE SOitem LIKE '%"+ALLTRIM(STR(nSalesNum))+"-%'"
		*CASE nID_Detail > 0
		IF nID_Detail > 0
			DO CASE
			CASE pTBL = "S"
				cSQL = "SELECT *,'S' AS TBL FROM dbo.StockLst_Process WITH(NOLOCK) WHERE ID_Detail = "+STR(nID_Detail)
			CASE pTBL = "B"
				cSQL = "SELECT *,'B' AS TBL FROM dbo.BrokerLst_Process WITH(NOLOCK) WHERE ID_Detail = "+STR(nID_Detail)
			CASE pTBL = "W"
				cSQL = "SELECT *,'W' AS TBL FROM dbo.WIPLst_Process WITH(NOLOCK) WHERE ID_Detail = "+STR(nID_Detail)
			OTHERWISE
				TrackError("Did not get a TBL","cTBL:"+pTBL+"  nID_Detail="+STR(nID_Detail),"ShowProcess:Init",LINENO(1))
			ENDCASE
		*OTHERWISE
		ELSE
			cSQL = "SELECT *,'S' AS TBL FROM dbo.StockLst_Process "
		ENDIF
		*ENDCASE
		
		
		
		IF USED("StockLst_Process")
			SELECT StockLst_Process
		ELSE
			SELECT 0
		ENDIF
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StockLst_Process')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StockLst_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Process' )
			RETURN
		ENDIF
		*SOitem,PO_item,SalesPerson,StartDate,DueDate,Comment,Process_ID,Processor,[AllowSub]
		*,[PWeight],[PPc],[PFT] 	-depricated
		*,[PU],[QTY],[Pounds]		-new
		*,ID_Detail,ID_Detail_Process,ReceivingID
		
		SELECT StockLst_Process
		*INDEX ON SOitem TAG SOitem
		GO TOP
		SCATTER MEMVAR 
		This.Refresh
		
		PUBLIC ARRAY gaProcess(1)
		IF RECCOUNT('StockLst_Process') > 0
			*SELECT SOitem FROM StockLst_Process INTO ARRAY gaProcess ORDER BY SOitem 
			SELECT ID_Detail_Process FROM StockLst_Process INTO ARRAY gaProcess ORDER BY ID_Detail_Process
			
			SELECT StockLst_Process
			GO TOP
		ELSE
			gaProcess(1) = "None"
		ENDIF
		
		ThisForm.lstItems.RowSource = "gaProcess"
		ThisForm.lstItems.ColumnCount = ALEN(gaProcess,1)
		
		IF ALEN(gaProcess,1) > 0
			IF VARTYPE(gaProcess(1)) != "N"
				gaProcess(1) = "None"
			ENDIF
			
			ThisForm.lstItems.Value = gaProcess(1)
			ThisForm.lstItems.SetFocus
			
		ENDIF
		
		IF nSalesNum > 0
			ThisForm.Height = 556
			
			IF nID_Detail = 0
				MESSAGEBOX("Show Process' for Sales Order "+STR(nSalesNum)+CHR(13)+"Problem:"+CHR(13)+"The Detail record was not found."+CHR(13)+"Showing All Process' in Stock List.",48,"Not Found!")
				ThisForm.lblProcess.Caption = "ALL Process "
				ThisForm.Height = 420
			ENDIF
			
			ThisForm.Show_Order_Process()
		ELSE
		
		ENDIF
		
		ThisForm.Refresh_StockLst_Process()
		
		********************************
		
		ThisForm.AlwaysOnTop = .T.
		ThisForm.AlwaysOnTop = .F.
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE refresh_stocklst_process
		*ThisForm.Refresh_StockLst_Process()
		
		*ThisForm.lstItems.Value = StockLst_Process.SOitem
		*ThisForm.lstItems.Value = StockLst_Process.ID_Detail_Process
		
		SCATTER MEMVAR
		
		ThisForm.Refresh
		PRIVATE nID_Detail, nWO
		nID_Detail = PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
		nWO  = PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		
		*IF ( nID_Detail = 0 AND ThisForm.nSalesNum = 0 ) AND nWO = 0
		IF nID_Detail = 0
			*RecordError(0, "Lost ID_Detail", PROGRAM(), LINENO(1), "Refresh_StockLst_Process, Cannot Query with no ID_Detail" )  &&Common
			MESSAGEBOX("No ID_Detail",16,"Error")
			RETURN .F.
		ENDIF
		
		PRIVATE MasterLB,MasterProcLB,DetailLB,DetailProcLB
		MasterLB		= 0
		MasterProcLB	= 0
		DetailLB		= 0
		DetailProcLB	= 0
		
		IF USED('tmpTVF_Process')
			USE IN tmpTVF_Process
		ENDIF
		
		SELECT 0
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(ThisForm.TBL1.Value,'TBL',-1)
		
		*!*	DO CASE
		*!*	CASE nSalesNum > 0
		*!*		ThisForm.nSalesNum = nSalesNum 
		*!*		cSQL = "SELECT *,'S' AS TBL FROM dbo.StockLst_Process WHERE SOitem LIKE '%"+ALLTRIM(STR(nSalesNum))+"-%'"
		*!*		cSQL = cSQL + " UNION "	
		*!*		cSQL = cSQL + "SELECT *,'B' AS TBL FROM dbo.BrokerLst_Process WHERE SOitem LIKE '%"+ALLTRIM(STR(nSalesNum))+"-%'"
		*!*		cSQL = cSQL + " UNION "	
		*!*		cSQL = cSQL + "SELECT *,'W' AS TBL FROM dbo.WIPLst_Process WHERE SOitem LIKE '%"+ALLTRIM(STR(nSalesNum))+"-%'"
		*!*	CASE nID_Detail > 0
		*!*		DO CASE
		*!*		CASE pTBL = "S"
		*!*			cSQL = "SELECT *,'S' AS TBL FROM dbo.StockLst_Process WHERE ID_Detail = "+STR(nID_Detail)
		*!*		CASE pTBL = "B"
		*!*			cSQL = "SELECT *,'B' AS TBL FROM dbo.BrokerLst_Process WHERE ID_Detail = "+STR(nID_Detail)
		*!*		CASE pTBL = "W"
		*!*			cSQL = "SELECT *,'W' AS TBL FROM dbo.WIPLst_Process WHERE ID_Detail = "+STR(nID_Detail)
		*!*		OTHERWISE
		*!*			TrackError("Did not get a TBL","cTBL:"+pTBL+"  nID_Detail="+STR(nID_Detail),"ShowProcess:Init",LINENO(1))
		*!*		ENDCASE
		*!*	OTHERWISE
		*!*		cSQL = "SELECT *,'S' AS TBL FROM dbo.StockLst_Process "
		*!*	ENDCASE
		
		
		DO CASE	&&Table-Valued Function
		CASE cTBL = "S"
			cSQL = "SELECT * FROM dbo.TVF_Stock_Process_QTY("+STR(nID_Detail)+");"
			*cSQL = "EXEC dbo.p_Process_QTY "+STR(m.ID_Detail)
			*nMasterLBS,nMasterQTY,nDetailLBS,nDetailQTY,nMProcLBS,nMProcQTY,nDProcLBS,nDProcQTY
		CASE cTBL = "B"
			cSQL = "SELECT * FROM dbo.TVF_Broker_Process_QTY("+STR(nID_Detail)+");"
			*cSQL = "EXEC dbo.p_BrokerLst_Process_QTY "+STR(m.ID_Detail)
		CASE cTBL = "W"
			cSQL = "SELECT * FROM dbo.TVF_WIP_Process_QTY("+STR(nID_Detail)+");"
			*cSQL = "EXEC dbo.p_WIP_Process_QTY "+STR(m.ID_Detail)
		OTHERWISE
			RecordTest('Record Test Data.', "ShowStockLstProcess.refresh_StockLst_Process()", LINENO(1), "cTBL not found "+CHR(13)+"SELECT * FROM dbo.TVF_Stock_Process_QTY("+STR(ID_Detail)+");" )
		ENDCASE
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpTVF_Process' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpTVF_Process' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTVF_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTVF_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTVF_Process")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpTVF_Process")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF  
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpTVF_Process' )
		ELSE
			IF USED('tmpTVF_Process')
				IF RECCOUNT('tmpTVF_Process') > 0
					
					PRIVATE nMasterQTY, nDetailQTY, nDSelectedQTY, nMSelectedQTY, nDNoSubQTY
					nMasterQTY	= PrepareSQLnum(tmpTVF_Process.MasterQTY,'MasterQTY',-3)
					nDetailQTY	= PrepareSQLnum(tmpTVF_Process.DetailQTY,'DetailQTY',-3)
					nDSelectedQTY	= PrepareSQLnum(tmpTVF_Process.DSelectedQTY,'DSelectedQTY',-3)
					nMSelectedQTY	= PrepareSQLnum(tmpTVF_Process.MSelectedQTY,'MSelectedQTY',-3)
					nDNoSubQTY	= PrepareSQLnum(tmpTVF_Process.DNoSubQTY,'DNoSubQTY',-3)
					
					ThisForm.lblMasterQTY.Caption = ALLTRIM(STR(nMasterQTY))
					ThisForm.lblMSelectedQTY.Caption = ALLTRIM(STR(nMSelectedQTY))
					
					ThisForm.lblDetailQTY.Caption = ALLTRIM(STR(nDetailQTY))
					ThisForm.lblDSelectedQTY.Caption = ALLTRIM(STR(nDSelectedQTY))
					ThisForm.lblMSelectedQTY.Caption = ALLTRIM(STR(nMSelectedQTY))
					
					ThisForm.lblDNoSubQTY.Caption = ALLTRIM(STR(nDNoSubQTY))
					
					***
		*!*				ThisForm.lblMasterBalance.Caption = ALLTRIM(STR(nMasterLBS-nMProcLBS))
		*!*				IF (nMasterLBS-nMProcLBS) < 0
		*!*					ThisForm.lblMasterBalance.ForeColor = RGB(255,0,0)
		*!*				ELSE
		*!*					ThisForm.lblMasterBalance.ForeColor = RGB(0,0,0)
		*!*				ENDIF
		*!*				**
		*!*				ThisForm.lblMasterBQTY.Caption = ALLTRIM(STR(nMasterQTY-nMProcQTY))
		*!*				IF (nMasterQTY-nMProcQTY) < 0
		*!*					ThisForm.lblMasterBQTY.ForeColor = RGB(255,0,0)
		*!*				ELSE
		*!*					ThisForm.lblMasterBQTY.ForeColor = RGB(0,0,0)
		*!*				ENDIF
		*!*				***
		*!*				IF NOT ISNULL(nDetailLBS) AND NOT ISNULL(nDProcLBS)
		*!*					ThisForm.lblDetailBalance.Caption = ALLTRIM(STR(nDetailLBS - nDProcLBS))
		*!*					IF (nDetailLBS - nDProcLBS) < 0
		*!*						ThisForm.lblDetailBalance.ForeColor = RGB(255,0,0)
		*!*					ELSE
		*!*						ThisForm.lblDetailBalance.ForeColor = RGB(0,0,0)
		*!*					ENDIF
		*!*				ELSE
		*!*					ThisForm.lblDetailBalance.Caption = ''
		*!*				ENDIF
		*!*				**
		*!*				IF NOT ISNULL(nDetailQTY) AND NOT ISNULL(nDProcQTY)
		*!*					ThisForm.lblDetailBQTY.Caption = ALLTRIM(STR(nDetailQTY - nDProcQTY))
		*!*					IF (nDetailQTY - nDProcQTY) < 0
		*!*						ThisForm.lblDetailBQTY.ForeColor = RGB(255,0,0)
		*!*					ELSE
		*!*						ThisForm.lblDetailBQTY.ForeColor = RGB(0,0,0)
		*!*					ENDIF
		*!*				ELSE
		*!*					ThisForm.lblDetailBQTY.Caption = ''
		*!*				ENDIF
					***
				ENDIF
				USE IN tmpTVF_Process
			ENDIF
		ENDIF
		
		*************************************************
		ThisForm.txtStock1.Value = ''
		IF USED('tmpStock')
			USE IN tmpStock
		ENDIF
		
		SELECT 0
		
		cSQL = "SELECT SM.Alloy, dbo.f_DescriptionMetricReport(PC, Form, Dim1, Dim2, Dim3, Weight, RandLen, 0, '', '', '') AS Descript"
		cSQL = cSQL + ",CC,CL,SD.S_QTY, SM.Heat, SM.lot, Length, Specs "
		
		DO CASE
		CASE cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Detail SD "
			cSQL = cSQL + " INNER JOIN dbo.StockLst_Master SM ON SD.ID = SM.ID "
		CASE cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail SD "
			cSQL = cSQL + " INNER JOIN dbo.BrokerLst_Master SM ON SD.ID = SM.ID "
		CASE cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Detail SD "
			cSQL = cSQL + " INNER JOIN dbo.WIPLst_Master SM ON SD.ID = SM.ID "
		ENDCASE
		cSQL = cSQL + " WHERE SD.ID_Detail = "+STR(StockLst_Process.ID_Detail)
			
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStock' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'tmpStock' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStock")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStock")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStock' )
		ELSE
			IF USED('tmpStock')
				IF RECCOUNT('tmpStock') > 0
					PRIVATE cMess
					cMess = ALLTRIM(tmpStock.Alloy)+" "
					cMess = cMess + ALLTRIM(tmpStock.Descript)+" "
					cMess = cMess + ALLTRIM(tmpStock.CC)+""
					cMess = cMess + ALLTRIM(tmpStock.CL)+" "
					cMess = cMess + "QTY:"+ALLTRIM( Remove0(tmpStock.S_QTY,10,0))+" "
					cMess = cMess + ALLTRIM(tmpStock.Heat)+" "
					cMess = cMess + ALLTRIM(tmpStock.Lot)+" "
					cMess = cMess + ALLTRIM(tmpStock.Length)+" "
					cMess = cMess + ALLTRIM(tmpStock.Specs)+" "
					
					ThisForm.txtStock1.Value = cMess
				ENDIF
				USE IN tmpStock
			ENDIF
		ENDIF
		
		SELECT StockLst_Process
	ENDPROC

	PROCEDURE show_order_process
		*ThisForm.Show_Order_Process()
		*Collect all process for this Order
		ThisForm.lblOrderProcess.Visible = .T.
		ThisForm.grd_Order_Process.Visible = .T.
		
		ThisForm.grd_Order_Process.RecordSource = ''
		
		IF USED("tmpOrder_Process")
			USE IN tmpOrder_Process
		ENDIF
		
		*!*	PRIVATE cSOitem
		*!*	cSOitem = PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		*!*	PRIVATE cInqNumP
		*!*	*ThisForm.WhatDo = "QUOTE"
		*!*	cInqNumP = PrepareSQLtxt(ThisForm.cInqNumP,'InqNumP',9)
		*!*	PRIVATE nWO
		*!*	nWO = PrepareSQLnum(ThisForm.nWO,'WO',-3)
		*!*	PRIVATE nWO_Detail
		*!*	nWO_Detail = PrepareSQLnum(ThisForm.txtWO_Detail.Value,'WO_Detail',-3)
		
		cSQL = "SELECT CAST(QTY AS INT) AS QTY, [AllowSub] AS [Sub], SOitem, WO, DueDate "
		cSQL = cSQL + ""
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " FROM dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " FROM dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " FROM dbo.WIPLst_Process "
		OTHERWISE
			TrackError("Did not get a TBL"," TBL:"+ThisForm.cTBL,"StockLst_Process:ShowID_Detail",LINENO(1) )
		ENDCASE
		
		cSQL = cSQL + " WHERE SOitem LIKE '%"+ALLTRIM(STR(ThisForm.nSalesNum))+"-%'"
		
		* and not the SO/WO listed here?
		*IF lSQLwhere 
			*Found atleast 1
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrder_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOrder_Process')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrder_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOrder_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 	
			IF nSQLEXEC < 0
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpOrder_Process')
			ELSE
				IF USED("tmpOrder_Process")
					ThisForm.grd_Order_Process.RecordSource = 'tmpOrder_Process'
					ThisForm.grd_Order_Process.Refresh
				ENDIF
			ENDIF
		*ENDIF
	ENDPROC

	PROCEDURE Unload
		SQLDISCONNECT(ThisForm.nConnHandle)
		
		IF NOT EMPTY( ThisForm.PrevTable )
			IF USED( ThisForm.PrevTable )
				SELECT (ThisForm.PrevTable)
			ENDIF
		ENDIF
		
		*IF WEXIST("frmStockLst_SQL_Quotes")
		*	ACTIVATE WINDOW frmStockLst_SQL_Quotes
		*ENDIF
		
	ENDPROC

	PROCEDURE AllowSub1.Valid
		DO CASE
		CASE ISNULL(This.Value)
			RETURN .T.
		CASE EMPTY(This.Value)
			RETURN .T.
		CASE UPPER(This.Value) = "N"
			RETURN .T.
		CASE UPPER(This.Value) = "Y"
			RETURN .T.
		CASE UPPER(This.Value) = "T" 
			This.Value = "Y"
			RETURN .T.
		CASE UPPER(This.Value) = "F"
			This.Value = "N"
			RETURN .T.
		OTHERWISE		
			RETURN .F.
		ENDCASE
	ENDPROC

	PROCEDURE cmdDelete.Valid
		*cmdDelete.Valid -Unselect
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail_Process
		
		PRIVATE nID_Detail_Process
		nID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		
		PRIVATE lExit
		lExit = .F.
		
		IF nID_Detail_Process = 0
			MESSAGEBOX("Cannot Remove"+CHR(13)+"Lost ID_Detail_Process.",0,"No record")
			RETURN .F.
		ENDIF
		
		PRIVATE cMach_User, cLoginUserName
		cMach_User = SYS(0)
		cLoginUserName = ALLTRIM( RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 ))
		
		IF USED('tmpDelProcess')
			USE IN tmpDelProcess
		ENDIF
		SELECT 0
		
		cSQL = "SELECT * FROM "
		DO CASE
		CASE ThisForm.cTBL = "S"
			cSQL = cSQL + " dbo.StockLst_Process "
		CASE ThisForm.cTBL = "B"
			cSQL = cSQL + " dbo.BrokerLst_Process "
		CASE ThisForm.cTBL = "W"
			cSQL = cSQL + " dbo.WIPLst_Process "
		OTHERWISE
			TrackError("Did not get a TBL","ThisForm.cTBL:"+ThisForm.cTBL+"  ID_Detail_Process="+STR(nID_Detail_Process),"ShowProcess:cmdDelete.Valid()",LINENO(1))
			MESSAGEBOX("Do not have a valid a TBL"+CHR(13)+"ThisForm.cTBL:"+ThisForm.cTBL,16,"Cannot continue.")
			RETURN .F.
		ENDCASE
		cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process )
		*cSQL = cSQL + " AND ( SalesPerson = '"+cLoginUserName+"' OR Processor = '"+cLoginUserName+"')"
		*cSQL = cSQL + " AND ( Process_ID = 'SELECTED' OR Process_ID='PARTSELECT' )"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, 'tmpDelProcess')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, 'tmpDelProcess')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDelProcess")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpDelProcess")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, 'tmpDelProcess' )
			RETURN .F.
		ENDIF
		
		IF USED('tmpDelProcess')
			
			IF RECCOUNT('tmpDelProcess') > 0
				*see if User has Permission to delete Process
				
				PRIVATE cSalesPerson, cProcessor
				cSalesPerson = PrepareSQLtxt(tmpDelProcess.SalesPerson,'SalesPerson',20) 
				cProcessor	 = PrepareSQLtxt(tmpDelProcess.Processor,'Processor',20) 
				
				IF cLoginUserName = cSalesPerson OR cLoginUserName = cProcessor
					*good
				ELSE
					IF HavePermission('CompleteSO')  
						&&the CompleteSO is used as administrative permission
						&& EditStockLst is not well used.
						*good
					ELSE
						RecordTest("Record Test Data.", PROGRAM(), LINENO(1),"Delete Process: "+CHR(13)+"cLoginUserName is '"+cLoginUserName+"' Process SalesPerson = '"+cSalesPerson+"' and Processor = '"+cProcessor+"'." +CHR(13)+cSQL )
					ENDIF
				ENDIF
		
					
				*A Deleted Process will auto mark the rtr_Detail as Finished.
				*Remove from rtr_Detail table so tigger [StockLst_Process_Delete] 
				*does not have Router.dbo.p_rtr_Select_Material_Done 
				*mark the rtr_Detail as FINSIHED
				
				IF ThisForm.Delete_rtr_Detail()
					
					DO CASE 
					CASE ThisForm.cTBL = 'S'
						cSQL = "DELETE FROM dbo.StockLst_Process " 
					CASE ThisForm.cTBL = 'B'
						cSQL = "DELETE FROM dbo.BrokerLst_Process " 
					CASE ThisForm.cTBL = 'W'
						cSQL = "DELETE FROM dbo.WIPLst_Process " 
					ENDCASE
					cSQL = cSQL + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process)
					
					nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC )
					ELSE
		
						MESSAGEBOX("Window will now close"+CHR(13)+"to refresh data."+CHR(13)+"Open 'Show Process' again to see current data.",48,"Deleted!")
						lExit = .T.
					ENDIF
				ELSE
					MESSAGEBOX("Could not Delete the rtr_Detail.",48,"No Delete")		
					
				ENDIF
			ELSE
				*Counted = 0
				MESSAGEBOX("Did not find any record you have PERMISSION to Delete."+CHR(13)+""+cLoginUserName+" was tried as either SalesPerson or Processor."+CHR(13)+"Have the SalesPerson Remove.",48,"No Delete")
			ENDIF
			USE IN tmpDelProcess
		ENDIF
		
		
		IF lExit 
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE cmdEdit.Valid
		PRIVATE nReturn
		nReturn = 0 &&ID_Detail_Process
		
		PRIVATE nID_Detail_Process, nID_Detail, nWO
		nID_Detail_Process = PrepareSQLnum(ThisForm.ID_Detail_Process1.Value,'ID_Detail_Process',-3)
		nID_Detail = PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
		nWO		= PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		
		IF nID_Detail_Process> 0
			DO CASE
			CASE StockLst_Process.TBL = "S"
		*                                          cWhatDo, pID_D_P      , pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO, pID_Detail, pInqNumP, pWO_Detail
				DO FORM Forms\StockLst_Process WITH "EDIT",nID_Detail_Process,   '',''     , ''        ,    0,    0,       '',   ''   ,'StockLst','',   nWO, nID_Detail,       '',  0 TO nReturn
			CASE StockLst_Process.TBL = "B"
				DO FORM Forms\StockLst_Process WITH "EDIT",nID_Detail_Process,'','','',0,0,'','','BrokerLst','',nWO,nID_Detail,'',0 TO nReturn
			CASE StockLst_Process.TBL = "W"
				DO FORM Forms\StockLst_Process WITH "EDIT",nID_Detail_Process,'','','',0,0,'','','WIPLst','',nWO,nID_Detail,'',0 TO nReturn
			ENDCASE
			MESSAGEBOX("Window will now close"+CHR(13)+"to refresh data."+CHR(13)+"Open 'Show Process' again to see current data.",48,"Process Edited!")
			ThisForm.Release
		ENDIF
	ENDPROC

	PROCEDURE cmdNext.Click
		SELECT StockLst_Process 
		IF !EOF('StockLst_Process')
			SKIP 1 IN StockLst_Process 
			ThisForm.lstItems.Value = ThisForm.lstItems.Value + 1
		ENDIF
		IF EOF('StockLst_Process')
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN StockLst_Process 
		ENDIF
		
		ThisForm.Refresh_StockLst_Process()
	ENDPROC

	PROCEDURE cmdPrev.Click
		
		SELECT StockLst_Process 
		IF !BOF('StockLst_Process')
			SKIP -1 IN StockLst_Process 
			ThisForm.lstItems.Value = ThisForm.lstItems.Value - 1
		ENDIF
		IF EOF('StockLst_Process')
			WAIT WINDOW 'End of File' NOWAIT
			GO BOTTOM IN StockLst_Process 
		ENDIF
		
		
		ThisForm.Refresh_StockLst_Process()
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdShowSO.Click
		PRIVATE cSOitem, nSalesNum
		
		cSOitem = PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		nSalesNum = PrepareSQLnum(cSOitem,'SalesNum',-3)
		
		IF nSalesNum > 0
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink =  HTML_SO(nSalesNum,.T.)
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
		
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		ENDIF
	ENDPROC

	PROCEDURE cmdShowWO.Click
		PRIVATE nWO
		nWO = PrepareSQLnum(ThisForm.WO1.Value,'WO',-3)
		
		IF nWO > 0
			PRIVATE m.loHyperlink,m.cHyperLink
			m.cHyperLink =  HTML_WO(nWO,.T.)
			m.loHyperlink = CREATEOBJECT("Hyperlink")
			m.loHyperlink.navigateto(m.cHyperLink)
			RELEASE m.loHyperlink
		
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		ELSE
			MESSAGEBOX("Cannot Show",0,"No WO")
		ENDIF
		
	ENDPROC

	PROCEDURE lstItems.Click
		*PRIVATE cSOitem
		*cSOitem = This.Value
		*SEEK cSOitem ORDER SOitem IN StockLst_Process
		
		PRIVATE nID_Detail_Process
		nID_Detail_Process = PrepareSQLnum(gaProcess(This.Value),'ID_Detail_Process',-3)
		
		SELECT StockLst_Process
		LOCATE FOR ID_Detail_Process = nID_Detail_Process 
		*SEEK nID_Detail_Process ORDER ID_Detail_Process IN StockLst_Process
		
		IF FOUND("StockLst_Process")
			SELECT StockLst_Process
			ThisForm.Refresh_Stocklst_Process()
			
		ELSE
			SCATTER MEMVAR BLANK 
			
			ThisForm.Refresh
		ENDIF
		
	ENDPROC

	PROCEDURE POitem1.Click
		PRIVATE loIE, cPOitem
		cPOitem = PrepareSQLtxt(This.Value,'POitem',12)
		IF Proper_PO_Item_PO(cPOitem) > 0
			PRIVATE cHyperLink 
			cHyperLink = HTML_POitem(cPOitem,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cHyperLink)
			RELEASE loHyperlink
				
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
			*loIE.Navigate(get_Report_Server()+"%2fHPA+Purchasing+Reports%2fPurchaseOrders&rs:Command=Render&hpapo="+ALLTRIM(STR(nPO)) )
		ENDIF
		
	ENDPROC

	PROCEDURE SOITEM1.DblClick
		PRIVATE loIE, nSO
		nSO = PrepareSQLnum(This.Value,'SalesNum',-3)
		IF nSO > 0
			PRIVATE cHyperLink 
			cHyperLink = HTML_SO_Status(nSO,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cHyperLink)
			RELEASE loHyperlink
				
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
			*loIE.Navigate(get_Report_Server()+"%2fHPA+Sales+Reports%2fSalesOrders&rs:Command=Render&soNum="+ALLTRIM(STR(nSO)) )
		ENDIF
		
	ENDPROC

	PROCEDURE WO1.DblClick
		PRIVATE loIE, nWO
		nWO = PrepareSQLnum(This.Value,'WorkOrder',-3)
		IF nWO > 0
			
			PRIVATE cHyperLink 
			cHyperLink = HTML_WO(nWO,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		
		ENDIF
		
	ENDPROC

	PROCEDURE WO_Detail1.DblClick
		PRIVATE loIE, nWO_Detail
		nWO_Detail= PrepareSQLnum(This.Value,'WO_Detail',-3)
		IF nWO_Detail> 0
			PRIVATE cHyperLink 
			cHyperLink = HTML_WO_Detail(nWO_Detail,.T.)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(cHyperLink)
			RELEASE loHyperlink
		
			WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		
		ENDIF
		
	ENDPROC

ENDDEFINE
