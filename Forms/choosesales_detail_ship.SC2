	PROCEDURE dynamicbackcolor_grid
		PRIVATE nColor
		*DynamicBackColor_Grid()
		
		*nColor = RGB( 0, 0, 0 )  &&Black
		*nColor = RGB( 128, 128, 128 )  &&Grey
		*nColor = RGB( 255, 0, 0 ) &&RED
		*nColor = RGB( 192, 220, 192 )  &&GREEN
		*nColor = RGB( 255,128,64 ) &&ORANGE
		*nColor = RGB( 255, 255, 128 ) &&YELLOW
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		
		*IIF(!EMPTY(POitem),RGB(255,255,128),IIF(!EMPTY(SalesP),RGB(255,130,130),RGB(255,255,255)))
		*IIF(tmpPOitems.cancelled,,RGB( 255, 0, 0 ),IIF(tmpPOitems.delivered,RGB( 128, 128, 128 ),RGB( 255, 255, 255 )))
		DO CASE
		*CASE tmpChooseSales_Detail.cancelled
		CASE DELETED(tmpChooseSales_Detail)
			nColor = RGB( 255, 0, 0 ) &&RED	
		*CASE tmpChooseSales_Detail.Cancelled
		*	nColor = RGB( 128, 128, 128 )  &&Grey
		OTHERWISE 
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDCASE
		
		RETURN nColor
	ENDPROC

	PROCEDURE dynbc_choosepoitem_grid		&& ChoosePOitem
	ENDPROC

	PROCEDURE Init
		PARAMETER pSOitem, pPackingSli
		*DO FORM Forms\chooseSales_Detail_Ship WITH cSOitem, nPackingSli
		*DO FORM Forms\chooseSales_Detail_Ship WITH ' 88720-01',0
		IF VARTYPE(pSOitem) != "C"
			MESSAGEBOX("No Parameter SOitem for FORM frmChoose_Sales_Detail_Ship",16,"Abort")
			RETURN 
		ENDIF
		
		PRIVATE cSOitem
		cSOitem = Proper_SO_item('')
		
		IF VARTYPE(pSOitem) = "C"
			ThisForm.Caption = ThisForm.Caption+" for SOitem: "+ALLTRIM(pSOitem)
			cSOitem = Proper_SO_item(pSOitem)
		ENDIF
		
		PRIVATE nPackingSli
		nPackingSli = 0
		
		IF VARTYPE(pPackingSli) = 'N'
			nPackingSli = pPackingSli
		ENDIF
		
		IF USED("tmpChooseSales_Detail")	
			USE IN tmpChooseSales_Detail
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC 
		*cSQL = "SELECT * FROM dbo.Sales_Stock WHERE "
		cSQL = "SELECT * FROM dbo.Sales_Detail WITH(NOLOCK) WHERE "
		cSQL = cSQL + " SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
		IF nPackingSli > 0
		*	cSQL = cSQL + " AND PackingSli = "+ALLTRIM(STR(nPackingSli))
		ENDIF
			
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpChooseSales_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpChooseSales_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseSales_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpChooseSales_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpChooseSales_Detail')
		ENDIF
		
		ThisForm.grid.RecordSource = "tmpChooseSales_Detail"
		*ThisForm.grid.Column1.DynamicBackColor = ThisForm.DynamicBackColor_Grid()
		
		*ThisForm.grid.SetFocus
		PRIVATE nRecCount
		nRecCount = RECCOUNT("tmpChooseSales_Detail")
		DO CASE
		CASE nRecCount = 0
			MESSAGEBOX("Sorry, SO Item not Found:"+cSOitem,32,"No records to Show!")
			ThisForm.cmdCancel.Click
		CASE nRecCount = 1
			ThisForm.txtSOitem.Value 		= cSOitem 
			ThisForm.txtPackingSli.Value 	= nPackingSli 
		
			IF ThisForm.cmdSelect.Click()
				RETURN
			ENDIF
			
		CASE nRecCount > 7
			GO BOTTOM
			SKIP -6
		OTHERWISE
			GO BOTTOM
		ENDCASE
		
		
		ThisForm.txtSOitem.Value 		= cSOitem 
		ThisForm.txtPackingSli.Value 	= nPackingSli 
		
		ThisForm.txtDescription.Value	= tmpChooseSales_Detail.Descript
		ThisForm.txtHeat.Value 			= tmpChooseSales_Detail.Heat
		ThisForm.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpChooseSales_Detail.StockLst_QTY,'StockLst_QTY',-3)
		ThisForm.txtStockLst_PC.Value 	= PrepareSQLnum(tmpChooseSales_Detail.StockLst_PC,'StockLst_PC',-3)
		ThisForm.txtStockLst_Dim1.Value = PrepareSQLnum(tmpChooseSales_Detail.StockLst_Dim1,'StockLst_Dim1',10,4)
		ThisForm.txtStockLst_LBS.Value 	= PrepareSQLnum(tmpChooseSales_Detail.StockLst_LBS,'StockLst_LBS',9,1)
		
		ThisForm.txtShipped.Value		= PrepareSQLdate(tmpChooseSales_Detail.Shipped,'Shipped')
		ThisForm.chkReconciled.Value	= PrepareSQLchk(tmpChooseSales_Detail.Reconciled,'Reconciled')
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		IF NOT "PROC_SETUP" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		ThisForm.OrigTable = ALIAS()
		
	ENDPROC

	PROCEDURE Unload
		
		IF USED("tmpChooseSales_Detail")	
			USE IN tmpChooseSales_Detail
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdCancel.Click
		PRIVATE cHoldNumber
		cHoldNumber = ""
		ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSelect.Click
		PRIVATE cHoldNumber
		cHoldNumber = STR(tmpChooseSales_Detail.ID)
		ThisForm.HoldNumber = cHoldNumber 
		
		PRIVATE cSOitem, nPackingSli,cHeat,cMess
		cSOitem 	= PrepareSQLtxt(ThisForm.txtSOitem.Value,'SOitem',10)
		nPackingSli = PrepareSQLnum(ThisForm.txtPackingSli.Value,'PackingSli',-3)
		*nPackingSli is largest INT minus Seconds from midnight as a temp number untill a real PackingSli number is incremented.
		cHeat = ''
		
		PRIVATE lOk
		lOK = .T.
		
		IF Proper_SO_item(cSOitem) = Proper_SO_item('')	
			MESSAGEBOX("No SOitem!",16,"Cannot Mark!")
		*	RETURN .F.
			lOK = .F.
		ENDIF
		IF nPackingSli < 1
			MESSAGEBOX("No PackingSli!",16,"Cannot Mark!")
			*RETURN .F.
			lOK = .F.
		ENDIF
		
			
		PRIVATE cSQL,nSQLEXEC 
		IF lOK
			SELECT tmpChooseSales_Detail
			SCAN
				IF PrepareSQLlogic(tmpChooseSales_Detail.Reconciled,'Reconciled')
					LOOP
				ENDIF
				IF PrepareSQLdate(tmpChooseSales_Detail.Shipped,'Shipped') > PrepareSQLdate('01/01/2000','Shipped')
					LOOP
				ENDIF
				IF DELETED('tmpChooseSales_Detail')
					LOOP
				ENDIF
				
				cHeat =  PrepareSQLtxt(tmpChooseSales_Detail.Heat,'Heat',50)
				cHeat =  ALLTRIM(UPPER(Heat))
		
				IF USED('tmpPSItem')
					cMess = ''
					SELECT tmpPSItem
					LOCATE FOR ALLTRIM(UPPER(Heat)) = cHeat
					IF FOUND('tmpPSItem')
						cMess = "Found Heat:'"+cHeat+"' in chooseSales_Detail_Ship."+CHR(13)
						cMess = cMess + " PackingSli="+ALLTRIM(STR(m.nPackingSli))+CHR(13)
						cMess = cMess + " Sales_Detail.ID="+ALLTRIM(STR(tmpChooseSales_Detail.ID))
					ELSE
						**TRY smaller Heat
						LOCATE FOR LEFT(ALLTRIM(UPPER(Heat)),10) = LEFT(cHeat,10)
						IF FOUND('tmpPSItem')
							cMess = "Close find for Heat:'"+LEFT(cHeat,10)+"' in chooseSales_Detail_Ship."+CHR(13)
							cMess = cMess + " PackingSli="+ALLTRIM(STR(m.nPackingSli))+CHR(13)
							cMess = cMess + " Sales_Detail.ID="+ALLTRIM(STR(tmpChooseSales_Detail.ID))
						ELSE
							cMess = "Did NOT find Heat:'"+LEFT(cHeat,10)+"' in chooseSales_Detail_Ship."+CHR(13)
							cMess = cMess + " PackingSli="+ALLTRIM(STR(m.nPackingSli))+CHR(13)
							cMess = cMess + " Sales_Detail.ID="+ALLTRIM(STR(tmpChooseSales_Detail.ID))				
						ENDIF
					
					ENDIF
					TrackMess(cMess)
					
					SELECT tmpChooseSales_Detail
				ENDIF
				
				cSQL = "UPDATE dbo.Sales_Detail SET "
				*cSQL = cSQL+" Shipped='"+IIF(EMPTY(dShipDate),'',DTOC(dShipDate) )+"'"
				cSQL = cSQL+" Shipped=GetDate()"
				cSQL = cSQL+",PackingSli="+ALLTRIM(STR(m.nPackingSli))
				cSQL = cSQL+" WHERE ID="+ALLTRIM(STR(tmpChooseSales_Detail.ID))
		
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL)
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL)
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC)
				ELSE
					WAIT WINDOW "Saved PackingSli to Sales_Detail" NOWAIT
					lOK = .T.
					*ThisForm.Release
				ENDIF
			ENDSCAN
		ENDIF	
		
		IF lOK 
			ThisForm.Release
			RETURN
		ENDIF
					
		RETURN lOK
		
	ENDPROC

	PROCEDURE Grid.AfterRowColChange
		LPARAMETERS nColIndex
		
		ThisForm.txtDescription.Value	= tmpChooseSales_Detail.Descript
		ThisForm.txtHeat.Value 			= tmpChooseSales_Detail.Heat
		ThisForm.txtStockLst_QTY.Value 	= PrepareSQLnum(tmpChooseSales_Detail.StockLst_QTY,'StockLst_QTY',-3)
		ThisForm.txtStockLst_PC.Value 	= PrepareSQLnum(tmpChooseSales_Detail.StockLst_PC,'StockLst_PC',-3)
		ThisForm.txtStockLst_Dim1.Value = PrepareSQLnum(tmpChooseSales_Detail.StockLst_Dim1,'StockLst_Dim1',10,4)
		ThisForm.txtStockLst_LBS.Value 	= PrepareSQLnum(tmpChooseSales_Detail.StockLst_LBS,'StockLst_LBS',9,1)
		
		ThisForm.txtShipped.Value		= PrepareSQLdate(tmpChooseSales_Detail.Shipped,'Shipped')
		ThisForm.chkReconciled.Value	= PrepareSQLchk(tmpChooseSales_Detail.Reconciled,'Reconciled')
	ENDPROC

ENDDEFINE
