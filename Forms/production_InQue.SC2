	PROCEDURE findorder
		*ThisForm.FindOrder()
		
		ThisForm.txtOType_Num.Value = ''
		
		PRIVATE cTypeName
		cTypeName = ThisForm.cmbOT.Value
		PRIVATE cOrder,nOrder,cOType_Num
		cOrder = ''
		nOrder = 0
		cOType_Num = ''
		
		DO CASE 
		CASE cTypeName = "GFM Log"
		CASE cTypeName = "Heat Treat Log"
		CASE cTypeName = "LakeErie Log"
		CASE cTypeName = "Maintenance"
			nOrder = PrepareSQLnum(ThisForm.txtOrder.Value,'Maintenance',-3)
			cOType_Num = 'MT'+STR(nOrder)
		CASE cTypeName = "PO Item"
			cOrder = PrepareSQLtxt(ThisForm.txtOrder.Value,'POitem',12)
			IF AT('-',cOrder) = 0
				MESSAGEBOX("PO item requires an -Item",16,"Cannot continue")
				RETURN .F.
			ENDIF
			cOType_Num = 'PI'+cOrder
		CASE cTypeName = "Purchase Order"
			nOrder = PrepareSQLnum(ThisForm.txtOrder.Value,'HPAPO',-3)
			cOType_Num = 'PO'+STR(nOrder)
		CASE cTypeName = "Return Merchandise Authorization"
			nOrder = PrepareSQLnum(ThisForm.txtOrder.Value,'RMA',-3)
			cOType_Num = 'RA'+STR(nOrder)
		CASE cTypeName = "RMA Detail"
			nOrder = PrepareSQLnum(ThisForm.txtOrder.Value,'RMAD',-3)
			cOType_Num = 'RD'+STR(nOrder)
		
		CASE cTypeName = "Roll Log"
		
		CASE cTypeName = "Sales Order"
			nOrder = PrepareSQLnum(ThisForm.txtOrder.Value,'SalesOrder',-3)
			cOType_Num = 'SO'+STR(nOrder)
		CASE cTypeName = "SO Item"
			cOrder = PrepareSQLtxt(ThisForm.txtOrder.Value,'SOitem',10)
			IF AT('-',cOrder) = 0
				MESSAGEBOX("PO item requires an -Item",16,"Cannot continue")
				RETURN .F.
			ENDIF
			cOType_Num = 'SI'+cOrder
			
		CASE cTypeName = "Swage Log"
		
		CASE cTypeName = "Wire Log"
		
		CASE cTypeName = "WO Detail"
			nOrder = PrepareSQLnum(ThisForm.txtOrder.Value,'WO_Detail',-3)
			cOType_Num = 'WD'+STR(nOrder)
		CASE cTypeName = "WorkOrder"
			nOrder = PrepareSQLnum(ThisForm.txtOrder.Value,'WorkOrder',-3)
			cOType_Num = 'WO'+STR(nOrder)
		OTHERWISE
			
		ENDCASE
		
		*PRINT [dbo].[f_rtr_OType_Num_OrderTypeID] (1,1110)
		*PRINT dbo.f_rtr_OType_Num('WO',1110)
		
		IF LEN(cOType_Num) < 4
			MESSAGEBOX("Did not find Order Type",16,"Cannot continue.")
			RETURN
		ENDIF
		
		
		************************
		*See if already on Board
		PRIVATE cSQL, nSQLEXEC
		
		IF USED('tmpSched')
			USE IN tmpSched
		ENDIF
		
		
		SELECT 0
		cSQL = "SELECT * "
		cSQL = cSQL+" FROM dbo.rtr_Schedule WITH(NOLOCK) "
		cSQL = cSQL+" WHERE OType_Num = '"+cOType_Num +"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSched')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSched')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSched")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSched")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpSched')
		ENDIF
		
		IF USED('tmpSched')
			IF RECCOUNT('tmpSched') > 0
				PRIVATE lOnBoard, lClosed, nPosition, dtLastTouch, dDateOnBoard, dDateClosed
				lOnBoard	= PrepareSQLlogic(tmpSched.OnBoard,'OnBoard')
				lClosed		= PrepareSQLlogic(tmpSched.Closed,'Closed')
				nPosition	= PrepareSQLnum(tmpSched.Position,'Position',-3)
				dtLastTouch	= PrepareSQLdateTime(tmpSched.LastTouch,'LastTouch')
				dDateOnBoard= PrepareSQLdate(tmpSched.DateOnBoard,'DateOnBoard')
				dDateClosed	= PrepareSQLdate(tmpSched.DateClosed,'DateClosed')
				
				PRIVATE cMess
				cMess = "Order '"+ALLTRIM(cOType_Num)+"' was found on Production table."+CHR(13)
				IF lClosed
					IF NOT DTOC(dDateClosed)="  /  /  "
						cMess = cMess + "The schedule was Closed on '"+ALLTRIM(DTOC(dDateClosed))+"'"+CHR(13)
					ENDIF
				ENDIF
				IF lOnBoard
					IF NOT DTOC(dDateOnBoard)="  /  /  "
						cMess = cMess + "Placed on Production Schedule '"+ALLTRIM(DTOC(dDateOnBoard))+"'"+CHR(13)
					ENDIF
					cMess = cMess + "Current Position is "+ALLTRIM(STR(nPosition))+CHR(13)
				ENDIF
				IF NOT TTOC(dtLastTouch)="  /  /  "
					cMess = cMess + "The last time this was touched was '"+ALLTRIM(TTOC(dtLastTouch))+"'"+CHR(13)
				ENDIF
				
				MESSAGEBOX(cMess,64,"test")
				
				This.edtMess.Value = cMess
				
			ENDIF
			USE IN tmpSched
		ENDIF
		
		*****************
		*See if OType_Num is Valid
		PRIVATE lValid
		lValid = .F.
		
		IF USED('tmpOT_Num_Valid')
			USE IN tmpOT_Num_Valid
		ENDIF
		
		SELECT 0
		cSQL = "SELECT [dbo].[f_OT_Num_Valid]('"+cOType_Num +"') AS [Valid] "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOT_Num_Valid')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpOT_Num_Valid')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOT_Num_Valid")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOT_Num_Valid")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpOT_Num_Valid')
		ENDIF
		
		IF USED('tmpOT_Num_Valid')
			IF RECCOUNT('tmpOT_Num_Valid') > 0
				lValid = PrepareSQLlogic(tmpOT_Num_Valid.Valid,'Valid')
			ENDIF
			USE IN tmpOT_Num_Valid
		ENDIF
		
		IF NOT lValid
			MESSAGEBOX("The Order & Number was not found!",16,"Cannot Continue")
			RETURN .F.
		ENDIF
		
		******************
		*test to ThisForm.nSched_Type
		*
		
		
		
		
		*****************
		*Get OType_Num Description
		PRIVATE cOT_Descript
		cOT_Descript = ''
		
		IF USED('tmpOT_Num_Valid')
			USE IN tmpOT_Num_Valid
		ENDIF
		
		SELECT 0
		cSQL = "SELECT [dbo].[f_OT_Descript]('"+cOType_Num+"') AS [OT_Descript] "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOT_Num_Valid')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpOT_Num_Valid')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOT_Num_Valid")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOT_Num_Valid")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpOT_Num_Valid')
		ENDIF
		
		IF USED('tmpOT_Num_Valid')
			IF RECCOUNT('tmpOT_Num_Valid') > 0
				cOT_Descript = PrepareSQLtxt(tmpOT_Num_Valid.OT_Descript,'OT_Descript',100)
			ENDIF
			USE IN tmpOT_Num_Valid
		ENDIF
		
		IF LEN(cOT_Descript) = 0
			MESSAGEBOX("The Order & Number was not found!",16,"Cannot Continue")
			RETURN .F.
		ELSE
			ThisForm.txtOType_Num.Value = cOType_Num
			ThisForm.txtOT_Descript.Value = cOT_Descript
			ThisForm.cmdSelect.SetFocus
			
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS nSched_Type 
		*DO FORM Forms\Production_InQue WITH nSched_Type TO cReturnOType_Num
		
		ThisForm.nSched_Type = PrepareSQLnum(nSched_Type,'Sched_Type',-1)
		** USE nSched_Type for verify correct OType is used.
		
		IF ThisForm.nSched_Type = 0
		*	TrackError("ThisForm.nSched_Type = 0","ThisForm.nSched_Type was set to 1", PROGRAM(), LINENO(1))
			ThisForm.nSched_Type = 1
		ENDIF
		
		****************************************************
		**load data
		PRIVATE cSQL, nSQLEXEC 
		
		IF USED('tmpProd_Board')
			ThisForm.grdInQue.RecordSource = ''
			USE IN tmpProd_Board
		ENDIF
		
		cSQL = "SELECT Pd.Position, Pd.OType_Num "
		cSQL = cSQL + " ,dbo.f_OT_StartDate(Pd.OType_Num) AS StartDate "
		cSQL = cSQL + " ,dbo.f_OT_DueDate(Pd.OType_Num) AS DueDate "
		cSQL = cSQL + " ,dbo.f_OT_Descript(Pd.OType_Num) AS Descript "
		cSQL = cSQL + " ,Pd.ID"
		*cSQL = cSQL + ", Pd.Sched_Type"
		
		cSQL = cSQL + " FROM dbo.rtr_Schedule Pd "
		*cSQL = cSQL + " INNER JOIN (SELECT DISTINCT Oper_ID,Sched_Type FROM dbo.OTracking_Job) Job "
		*cSQL = cSQL + "   ON Pd.Oper_ID = Job.Oper_ID "
		*cSQL = cSQL + " WHERE Job.Sched_Type = "+STR(m.nSched_Type)
		cSQL = cSQL + " WHERE Pd.Sched_Type = "+STR(ThisForm.nSched_Type)
		cSQL = cSQL + " AND Pd.InQue = 1 "
		cSQL = cSQL + " ORDER BY Pd.dateInQue "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProd_Board')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpProd_Board')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProd_Board")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProd_Board")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpProd_Board')
		ENDIF
		
		
		PRIVATE m.nBoardID, m.nRecIdex
		m.nBoardID = 0
		m.nRecIdex = 0
		
		IF USED('tmpProd_Board')
			IF RECCOUNT('tmpProd_Board') > 0 
				ThisForm.cmdRemove.Visible = .T.
				
				SELECT tmpProd_Board
			ELSE
				ThisForm.cmdRemove.Visible = .F.
			ENDIF
		ELSE
			ThisForm.cmdRemove.Visible = .F.
		ENDIF
												*Proc_ERP
		ThisForm.Caption = ThisForm.Caption+" "+Board_Sched_Type(ThisForm.nSched_Type)
		
		ThisForm.Visible = .T.
		
		ThisForm.grdInQue.RecordSource = 'tmpProd_Board'
		*Position, ID, OType_Num ,Descript
		
		ThisForm.RefreshGRD()
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		*IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
		*	SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		*ENDIF
		
		ThisForm.nConnHandle = get_SQLstringCONNECT()
		
		
	ENDPROC

	PROCEDURE refreshgrd
		*ThisForm.RefreshGRD()
		
		ThisForm.grdInQue.Refresh()
		
		ThisForm.txtBoardID.Value = tmpProd_Board.ID
		ThisForm.txtDescript.Value = tmpProd_Board.Descript 
		ThisForm.txtHPA.Value = ''
		ThisForm.txtHeat.Value = ''
	ENDPROC

	PROCEDURE refreshscreen
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDeltaH, nDeltaW
		nDeltaH = ThisForm.Height - 334
		nDeltaW = ThisForm.Width - 403
		
		ThisForm.grdInQue.Height= 200 + nDeltaH 
		ThisForm.grdInQue.Width	= 390 + nDeltaW
		
	ENDPROC

	PROCEDURE scanned
		*ThisForm.Scanned()
		
		PRIVATE cScan
		cScan = PrepareSQLtxt(ThisForm.txtScan.Value,'Scan',15)
		
		PRIVATE cOType, cOrder, cTypeName 
		cOType = LEFT(cScan,2)
		cOrder = SUBSTR(cScan,3,13)
		
		DO CASE 
		CASE cOType = "WO"
			cTypeName = "WorkOrder"
		CASE cOType = "SO"
			cTypeName = "Sales Order"
		CASE cOType = "PI"
			cTypeName = "PO Item"
		CASE cOType = "SI"
			cTypeName = "SO Item"
		CASE cOType = "WD"
			cTypeName = "WO Detail"
		CASE cOType = "MT"
			cTypeName = "Maintenance"
		CASE cOType = "PO"
			cTypeName = "Purchase Order"
		CASE cOType = "RA"
			cTypeName = "Return Merchandise Authorization"
		CASE cOType = "RD"
			cTypeName = "RMA Detail"
		ENDCASE
		
		ThisForm.cmbOT.Value = cTypeName 
		ThisForm.txtOrder.Value	= cOrder 
		
		ThisForm.FindOrder()
		
	ENDPROC

	PROCEDURE Unload
		*IF USED('tmpOper_ID')
		*	USE IN tmpOper_ID
		*ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN THISFORM.cReturn
	ENDPROC

	PROCEDURE cmbOT.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpOT_OT')
			USE IN tmpOT_OT
		ENDIF
		
		this.clear
		
		SELECT 0
		cSQL = "SELECT DISTINCT TypeName FROM dbo.OTracking_OrderType WITH(NOLOCK) ORDER BY TypeName"
		*cSQL = cSQL " WHERE Sched_Type = "+STR(ThisForm.nSched_Type)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpOT_OT')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpOT_OT')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOT_OT")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpOT_OT")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpOT_OT')
		ENDIF
		
		IF USED('tmpOT_OT')
			*SELECT * FROM tmpOT_OT INTO ARRAY aOT_OT
			SCAN
				This.AddListItem(tmpOT_OT.TypeName)
			ENDSCAN
			
			USE IN tmpOT_OT
			
		ENDIF
		
		This.Value = "SO Item"
		
	ENDPROC

	PROCEDURE cmdCancel.Click
		ThisForm.cReturn = ''
		ThisForm.Release
		
	ENDPROC

	PROCEDURE cmdFind.Click
		IF NOT EMPTY(ThisForm.txtOrder.Value)
			ThisForm.FindOrder()
		ELSE
			MESSAGEBOX("No Number Found",16,"No Data")
			ThisForm.txtOrder.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSelect.Click
		
		PRIVATE cOType_Num 
		cOType_Num = PrepareSQLtxt(ThisForm.txtOType_Num.Value,'OType_Num',15)
		
		ThisForm.cReturn = cOType_Num
		
		ThisForm.Release
		
		
	ENDPROC

	PROCEDURE txtScan.InteractiveChange
		IF NOT EMPTY(This.Value)
			ThisForm.Scanned()
		ENDIF
	ENDPROC

ENDDEFINE
