	ADD OBJECT 'lblCustID' AS label WITH ;
		Alignment = 1, ;
		BackStyle = 0, ;
		Caption = "CustID", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 2, ;
		Name = "lblCustID", ;
		TabIndex = 1, ;
		Top = 18, ;
		Width = 137
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Init
		PARAMETER pCode, cTable
		*DO FORM Forms\IND_Type WITH 1001,'SOLDADDR'
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		ThisForm.nCode = 0
		
		DO CASE
		CASE TYPE("pCode") = "N"
			ThisForm.nCode = pCode
			ThisForm.cCode = ''
		CASE TYPE("pCode") = "C"
			ThisForm.nCode = 0
			ThisForm.cCode = pCode
		OTHERWISE
			MESSAGEBOX("Bad Parameter - No Address Code",16,"Error")
			RETURN .F.
		ENDCASE
		
		PRIVATE nIND_Type
		IF TYPE("cTable") != "C"
			MESSAGEBOX("Bad Parameter-cTable",16,"Error")
			RETURN .F.
		ELSE
			ThisForm.cTable = cTable
			DO CASE
			CASE UPPER(cTable) = "VENDOR"
				cCompany = getVendor_Company_VendCode(ThisForm.nCode, ThisForm.nConnHandle)
				ThisForm.lblCompany.Caption = cCompany
				nIND_Type = getIND_Type( cTable, ThisForm.nCode, ThisForm.nConnHandle)
				ThisForm.lblCustID.Caption = 'Vendor'
			CASE UPPER(cTable) = "SOLDADDR"
				cCompany = GetCompanyfromSoldAddr(ThisForm.nCode, ThisForm.nConnHandle)
				ThisForm.lblCompany.Caption = cCompany
				nIND_Type = getIND_Type( cTable, ThisForm.nCode, ThisForm.nConnHandle)
				ThisForm.lblCustID.Caption = getCustID_SoldAddr(ThisForm.nCode, ThisForm.nConnHandle)
			CASE UPPER(cTable) = "CUSTOMER_LIST_NOTES"
				cCompany = GetCompanyfromCustID(pCode,ThisForm.nConnHandle)
				ThisForm.lblCompany.Caption = cCompany
				nIND_Type = getIND_Type( cTable, pCode,ThisForm.nConnHandle)
				ThisForm.lblCustID.Caption = pCode
			OTHERWISE
				MESSAGEBOX("Bad Parameter - Table",16,"Error")
				RETURN .F.
			ENDCASE
		ENDIF
		
		************************
			
		IF USED('tmpIND_Type')
			USE IN tmpIND_Type
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		cSQL = "EXEC dbo.p_IND_Type "+STR(nIND_Type)+""
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpIND_Type')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpIND_Type' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpIND_Type")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpIND_Type")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpIND_Type' )
		ENDIF
		
		IF USED('tmpIND_Type')
			ThisForm.chkConsumer.Value	= tmpIND_Type.Consumer
			ThisForm.chkCompetitor.Value= tmpIND_Type.Competitor
			ThisForm.chkCorrosion.Value	= tmpIND_Type.Corrosion
			ThisForm.chkWear.Value		= tmpIND_Type.Wear
			ThisForm.chkHighTemp.Value	= tmpIND_Type.HighTemp
			ThisForm.chkAeroSpace.Value	= tmpIND_Type.AeroSpace
			ThisForm.chkChemical.Value	= tmpIND_Type.Chemical
			ThisForm.chkOil.Value		= tmpIND_Type.Oil
			ThisForm.chkPharm.Value		= tmpIND_Type.Pharm
			ThisForm.chkMilitary.Value	= tmpIND_Type.Military
			ThisForm.chkNuclear.Value	= tmpIND_Type.Nuclear
			
			ThisForm.chkMedical.Value	= tmpIND_Type.Medical &&211
			ThisForm.chkFood.Value		= tmpIND_Type.Food  &&228
			ThisForm.chkService.Value	= tmpIND_Type.Service &&245			
			ThisForm.chkConversion.Value= tmpIND_Type.Conversion &&261
			ThisForm.chkFabricator.Value	= tmpIND_Type.Fabricator &&278
			ThisForm.chkGovSub.Value	= tmpIND_Type.Gov_Sub
			ThisForm.chkGov.Value		= tmpIND_Type.Government 
			ThisForm.chkHydro.Value		= tmpIND_Type.Hydro	
		ELSE
			RETURN .F.
		ENDIF
		
		
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes.prg ADDITIVE
		ENDIF
		
		ThisForm.OrigTable = ALIAS()
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpIND_Type')
			USE IN tmpIND_Type
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		RETURN ThisForm.HoldNumber
	ENDPROC

	PROCEDURE cmdCancel.Click
		*PRIVATE cHoldNumber
		*cHoldNumber = ""
		*ThisForm.HoldNumber = cHoldNumber 
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdUpdate.Click
		PRIVATE nIND_number
		nIND_number = 0
		
		IF ThisForm.chkConsumer.Value	
			nIND_number = nIND_number + 1
		ENDIF
		IF ThisForm.chkCompetitor.Value
			nIND_number = nIND_number + 2
		ENDIF
		IF ThisForm.chkCorrosion.Value	
			nIND_number = nIND_number + 4
		ENDIF
		IF ThisForm.chkWear.Value		
			nIND_number = nIND_number + 8
		ENDIF
		IF ThisForm.chkHighTemp.Value	
			nIND_number = nIND_number + 16
		ENDIF
		IF ThisForm.chkAeroSpace.Value	
			nIND_number = nIND_number + 32
		ENDIF
		IF ThisForm.chkChemical.Value	
			nIND_number = nIND_number + 64
		ENDIF
		IF ThisForm.chkOil.Value		
			nIND_number = nIND_number + 128
		ENDIF
		IF ThisForm.chkPharm.Value		
			nIND_number = nIND_number + 256
		ENDIF
		IF ThisForm.chkMilitary.Value	
			nIND_number = nIND_number + 512
		ENDIF
		IF ThisForm.chkNuclear.Value	
			nIND_number = nIND_number + 1024
		ENDIF
		IF ThisForm.chkConversion.Value	
			nIND_number = nIND_number + 2048
		ENDIF
		IF ThisForm.chkService.Value	
			nIND_number = nIND_number + 4096
		ENDIF
		IF ThisForm.chkMedical.Value	
			nIND_number = nIND_number + 8192
		ENDIF
		IF ThisForm.chkFabricator.Value	
			nIND_number = nIND_number + 16384
		ENDIF
		IF ThisForm.chkFood.Value	
			nIND_number = nIND_number + 32768
		ENDIF
		IF ThisForm.chkGovSub.Value	
			nIND_number = nIND_number + 65536
		ENDIF
		IF ThisForm.chkGov.Value	
			nIND_number = nIND_number + 131072
		ENDIF
		IF ThisForm.chkHydro.Value	
			nIND_number = nIND_number + 262114
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		DO CASE 
		CASE UPPER(ThisForm.cTable) = "VENDOR"
			*cSQL = "UPDATE dbo.Vendor SET vendor_type = "+ALLTRIM(STR(nIND_number))+" ,LastEdit=GetDate() WHERE VendCode = "+ALLTRIM(STR(nCode))
			cSQL = "UPDATE dbo.Vendor SET Ind_Type = "+ALLTRIM(STR(nIND_number))+" ,LastEdit=GetDate() WHERE VendCode = "+ALLTRIM(STR(ThisForm.nCode))
		CASE UPPER(ThisForm.cTable) = "SOLDADDR"
			cSQL = "UPDATE dbo.SoldAddr SET IND_Type = "+ALLTRIM(STR(nIND_number))+" ,LastEdit=GetDate() WHERE SoldCode = "+ALLTRIM(STR(ThisForm.nCode))
			
		CASE UPPER(ThisForm.cTable) = "CUSTOMER_LIST_NOTES"
			IF Have_Customer_List_Notes(ThisForm.cCode,ThisForm.nConnHandle)
				cSQL = "UPDATE dbo.Customer_List_Notes SET IND_Type = "+ALLTRIM(STR(nIND_number))+" WHERE CustomerID = '"+ThisForm.cCode+"'"
			ELSE
				cSQL = "INSERT INTO dbo.Customer_List_Notes (IND_Type,Notes,CustomerID) VALUES ( "+ALLTRIM(STR(nIND_number))+",'','"+ThisForm.cCode+"'" +");"
			ENDIF
		ENDCASE
		
		ThisForm.nConnHandle = CheckSQLConnection(ThisForm.nConnHandle)
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
		ELSE
			IF UPPER(ThisForm.cTable) = "SOLDADDR"
				IF LEN(ThisForm.cCode) > 0
					*Use by CustID, depricate by SoldAddr
					IF NOT Have_Customer_List_Notes(ThisForm.cCode,ThisForm.nConnHandle)
						cSQL = "INSERT INTO dbo.Customer_List_Notes (IND_Type,Notes,CustomerID) VALUES ( "+ALLTRIM(STR(nIND_number))+",'','"+ThisForm.cCode+"'" +");"
						
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
						ENDIF
						
					ENDIF
				ENDIF
			ENDIF
			WAIT WINDOW "Successfully Saved" TIMEOUT 1
			ThisForm.Release
		ENDIF
	ENDPROC

ENDDEFINE
