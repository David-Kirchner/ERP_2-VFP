DEFINE CLASS formset AS formset 
 	*< CLASSDATA: Baseclass="formset" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="frmNoNoiseCount" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="frmNoNoiseCount.cmdQuit" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: getnonoisecnt
		*m: refreshnonoisecnt
		*p: nconnhandle
	*</DefinedPropArrayMethod>

	*<PropValue>
		Icon = graphics\earth.ico
		AutoRelease = .T.
		DataSession = 1
		Name = "Formset"
		nconnhandle = 0
	*</PropValue>

	ADD OBJECT 'frmNoNoiseCount' AS form WITH ;
		Caption = "NoNoise Company name and Count", ;
		ControlBox = .F., ;
		DoCreate = .T., ;
		Left = 46, ;
		Name = "frmNoNoiseCount", ;
		Top = 19
		*< END OBJECT: BaseClass="form" />

	ADD OBJECT 'frmNoNoiseCount.cmdQuit' AS commandbutton WITH ;
		Caption = "Quit", ;
		Height = 27, ;
		Left = 252, ;
		Name = "cmdQuit", ;
		TabIndex = 6, ;
		Top = 216, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />
	
	PROCEDURE getnonoisecnt
		*ThisFormSet.GetNoNoiseCNT()
		
		
		IF USED("tmpNoNoiseCNT")
			SELECT tmpNoNoiseCNT
		ELSE
			SELECT 0
		ENDIF
		
		ThisFormSet.frmStockListMins.grdStockLst.RecordSource=""
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT NoNoiseName, Count(NoNoiseName) AS CNT FROM dbo.ShipAddr "
		cSQL = cSQL + " WHERE [inactive]=0 "
		cSQL = cSQL + " Group by NoNoiseName "
		cSQL = cSQL + " ORDER BY Count(NoNoiseName) DESC "
		
		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpNoNoiseCNT')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL , 'tmpNoNoiseCNT')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC, 'tmpNoNoiseCNT')
		ELSE
			SELECT tmpNoNoiseCNT
			IF RECCOUNT('tmpNoNoiseCNT') > 0
				
				ThisFormSet.frmStockListMins.grdStockLst.RecordSource = "tmpNoNoiseCNT"
				
			ENDIF
		ENDIF
		
		ThisFormSet.RefreshNoNoiseCNT()
	ENDPROC

	PROCEDURE Init
		
		*!*	PRIVATE cSQL, nSQLEXEC
		*!*	cSQL = "DELETE FROM dbo.Stocklst_Vendor WHERE RemoveDate <= GetDate()"
		
		*!*	nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL )
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisFormSet.nConnHandle, nSQLEXEC )
		*!*	ENDIF
		
		*ThisFormSet.GetStockLst_Wants()
		
		*ThisFormSet.frmMenu.AlwaysOnTop = .T.
	ENDPROC

	PROCEDURE Load
		
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		ThisFormSet.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisFormSet.nConnHandle < 0
			MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
	ENDPROC

	PROCEDURE refreshnonoisecnt
	ENDPROC

	PROCEDURE Unload
		
		 = SQLDISCONNECT(ThisFormSet.nConnHandle)
	ENDPROC

	PROCEDURE frmNoNoiseCount.cmdQuit.Click
		ThisForm.Release
		ThisFormSet.Release
		
	ENDPROC

ENDDEFINE
