	PROCEDURE Init
		PARAMETER pLot, pAlloy
		PRIVATE nLot
		nLot = 0
		
		IF USED('vRollLog')
			USE IN vRollLog
		ENDIF
		
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		nLot = PrepareSQLnum(pLot,'Lot',-3)
		PRIVATE cAlloy
		cAlloy = PrepareSQLtxt(pAlloy,'Alloy',12)
		
		PRIVATE nConn
		nConn = get_SQLSTRINGCONNECT()
		
		SELECT 0
		*USE HPA!vRollLog
		
		cSQL = "SELECT * FROM dbo.ROLL_Log "
		IF nLot > 0
			cSQL = cSQL + " WHERE LOT = "+STR(nLot)
		ELSE
			IF NOT EMPTY(cAlloy)
				cSQL=cSQL+" WHERE AlloyName = '"+cAlloy+"'"
			ELSE		
				cSQL = cSQL + " " &&All
			ENDIF
		ENDIF
		
		
		SELECT 0
		nSQLEXEC = SQLEXEC(nConn, cSQL, 'vRollLog')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(nConn, cSQL, 'vRollLog')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(nConn, cSQL, "vRollLog")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT tmpPOItems
				nSQLEXEC = SQLEXEC(nConn, cSQL, "vRollLog")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,nConn, nSQLEXEC, 'vRollLog')
		ENDIF
		
		SQLDISCONNECT(nConn)
		
		IF NOT USED('vRollLog')
			RETURN .F.
		ENDIF
		
		ThisForm.Passed.value = IIF(passed,1,0)
		ThisForm.Passed.refresh
		
		ThisForm.Chart.value = IIF(Chart,1,0)
		ThisForm.Chart.refresh
		ThisForm.AlwaysOnTop = .T.
		ThisForm.AlwaysOnTop = .F.
		
	ENDPROC

	PROCEDURE Load
		IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
			RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
		ENDIF
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('vRollLog')
			USE IN vRollLog
		ENDIF
		
		IF WEXIST("frmStockLst_SQL_Quotes")
			ACTIVATE WINDOW frmStockLst_SQL_Quotes
		ENDIF
		
	ENDPROC

	PROCEDURE ALLOYNAME1.When
		Return .F.
	ENDPROC

	PROCEDURE BHN1.When
		Return .F.
	ENDPROC

	PROCEDURE Chart.When
		Return .F.
	ENDPROC

	PROCEDURE cmdPrintLog.Click
		PRIVATE curgrec
		PRIVATE curAlias
		
		curAlias = ALIAS()
		
		IF !USED('vRollLog')
			WAIT WINDOW "Error, Can not print from Roll Log."
			RETURN
		ENDIF
		
		*m.curgrec = RECNO('vRollLog')
		*REPORT FORM reports\gfmlog RECORD (m.curgrec) TO PRINT PROMPT NOCONSOLE
		
		SELECT vRollLog
		REPORT FORM reports\Roll_Log TO PRINT PROMPT NOCONSOLE
		
		SELECT (curAlias)
		*GO m.curgrec
		RETURN
		
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
	ENDPROC

