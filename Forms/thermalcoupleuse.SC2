	PROCEDURE Destroy
		SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE Init
		PARAMETER pStartWith
		
		IF TYPE("pStartWith") = "N"
			PRIVATE nUseID 
			nUseID = pStartWith
			IF nUseID > 0
				SELECT ThermalCoupleUse
				LOCATE FOR UseID= nUseID
				
				IF NOT FOUND()
					MESSAGEBOX("UseID "+ALLTRIM(STR(nUseID))+" was not found",0,"UseID not found!")
				ENDIF	
			ENDIF
		ENDIF
		IF TYPE("pStartWith") = "C"
			SELECT ThermalCoupleUse
			LOCATE FOR UPPER(HPAName) = UPPER(ALLTRIM( pStartWith))
			
			IF NOT FOUND()
				MESSAGEBOX("HPAName "+ALLTRIM(pStartWith)+" was not found",0,"HPAName not found!")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_SQL.prg ADDITIVE
		ENDIF
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('ThermalCoupleUse')	
			USE IN ThermalCoupleUse
		ENDIF
		
		cSQL = "SELECT * FROM dbo.ThermalCoupleUse"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'ThermalCoupleUse')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'ThermalCoupleUse')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ThermalCoupleUse")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ThermalCoupleUse")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'ThermalCoupleUse')
		ELSE
		
		
		ENDIF
	ENDPROC

	PROCEDURE refreshtable
		PARAMETERS pRecNo
		*ThisForm.RefreshTable( RECNO('ThermalCoupleUse') )
		IF VARTYPE(pRecNo) != "N"
			pRecNo = 0
		ENDIF
		
		IF USED('ThermalCoupleUse')	
			USE IN ThermalCoupleUse
		ENDIF
		
		cSQL = "SELECT * FROM dbo.ThermalCoupleUse"
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'ThermalCoupleUse')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'ThermalCoupleUse')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ThermalCoupleUse")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ThermalCoupleUse")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'ThermalCoupleUse')
		ENDIF
		
		DO CASE
		CASE pRecNo = -1
			GO BOTTOM
		CASE pRecNo = 0
			* do not move
		CASE pRecNo <= RECCOUNT('ThermalCoupleUse')
			GOTO pRecNo
		ENDCASE
	ENDPROC

	PROCEDURE resetform
		*ThisForm.ResetForm
		
		ThisForm.USEID1.Value = 0
		ThisForm.HPAName1.Value = ''
		ThisForm.Used1.Value = DATE()
		ThisForm.Temp1.Value = 0
		ThisForm.Hours1.Value = 0
	ENDPROC

	PROCEDURE saveadd
		PARAMETERS pWhat
		*ThisForm.SaveAdd()  'Add' 'Save'
		
		IF VARTYPE( pWhat ) != 'C'
			pWhat = ''
		ENDIF
		
		IF EMPTY(pWhat)
			RETURN .F.
		ENDIF
		
		
		IF UPPER(pWhat) = "ADD"
			PRIVATE nUseID, cHPAName, dUsed, nTemp, nHours
		
			*nUseID = ThisForm.UseID1.Value
			cHPAName	= PrepareSQLtxt(ThisForm.HPAName1.Value,'HPAName',50)
			dUsed		= PrepareSQLdate(ThisForm.Used1.Value,'USED')
			nTemp		= PrepareSQLnum(ThisForm.Temp1.Value,'Temp',-2)
			nHours		= PrepareSQLnum(ThisForm.Hours1.Value,'Hours',-1)
		*	lInactive	= PrepareSQLchk(ThisForm.Inactive1.Value,'Inactive')
		
			cSQL = "INSERT INTO dbo.ThermalCoupleUse ("
			cSQL = cSQL + "[HPAName], [Used], [Temp], [Hours]) VALUES ("
			cSQL = cSQL + " '"+ cHPAName+"'"
			cSQL = cSQL + ",'"+ DTOC(dUsed)+"'"
			cSQL = cSQL + ","+ STR(nTemp)+""
			cSQL = cSQL + ","+ STR(nHours)+""
			cSQL = cSQL + ")"
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC )
			ENDIF
			
			*************Reload********
			ThisForm.RefreshTable(-1)
			
		ENDIF
		IF UPPER(pWhat) = "SAVE"
			PRIVATE nRecNum
			nRecnum = RECNO()
			
			PRIVATE nUseID, cHPAName, dUsed, nTemp, nHours
		
			nUseID		= PrepareSQLnum(ThisForm.UseID1.Value,'UseID',-3)
			cHPAName	= PrepareSQLtxt(ThisForm.HPAName1.Value,'HPAName',50)
			dUsed		= PrepareSQLdate(ThisForm.Used1.Value,'Used')
			nTemp		= PrepareSQLnum(ThisForm.Temp1.Value,'Temp',-2)
			nHours		= PrepareSQLnum(ThisForm.Hours1.Value,'Hours',-1)
		
			cSQL = "UPDATE dbo.ThermalCoupleUse SET "
			cSQL = cSQL + " HPAName='"+ cHPAName+"'"
			cSQL = cSQL + ",Used='"+ DTOC(dUsed)+"'"
			cSQL = cSQL + ",Temp="+ STR(nTemp)+""
			cSQL = cSQL + ",Hours="+STR(nHours)+""
			cSQL = cSQL + " WHERE UseID = "+ALLTRIM(STR(nUseID))
			
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC )
			ENDIF
			
			*************Reload********
			ThisForm.RefreshTable(nRecnum )
		ENDIF
	ENDPROC

	PROCEDURE Unload
		IF USED('ThermalCoupleUse')	
			USE IN ThermalCoupleUse
		ENDIF
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdAdd.Click
		#DEFINE OPT_CANCEL			0
		#DEFINE OPT_ADD_PARENT		1
		#DEFINE OPT_ADD_CHILD		2
		#DEFINE OPT_ADD_BOTH		3
		#DEFINE MB_Q_YESNO			36
		#DEFINE MB_A_YES			6
		#DEFINE C_KEYFLDNOUPDATE_LOC	"The field relating the grid's view to the parent data source is not updatable. "+;
			"Do you just want to add a new record to the parent table?"
		#DEFINE C_BADCHILDKEY_LOC		"The fields relating the parent and child tables are not the same data type. "+;
			"Do you just want to add a new record to the parent table?"
		#DEFINE C_NOCHILDUPDATE_LOC		"The child data source is a view and does not send updates. "+;
			"Do you just want to add a new record to the parent table?"
		#DEFINE C_NOOBJ_LOC		"Failed create the Add Record form class. Check or reinstall your WIZSTYLE.VCX file."
		#DEFINE C_NOUPDATE_LOC	"You cannot add a new record because the view(s) selected does not send updates."
		#DEFINE C_NOUPDATE2_LOC	"You cannot add a new record because the view(s) selected does not send updates and the child data source has a primary key."
		
		LOCAL oSearchDlog,oAddRec,cChildAlias,cPapaAlias,i,lPrimeKey
		LOCAL cPapaKey,cChildKey,nSaveSess,oRel,cTagName,lBadViewKey,nSaveRec,nSaveRec2
		LOCAL lBadChildKey,lUpdatableParentKey,lNoSendParentUpdates,lNoSendChildUpdates
		
		DO CASE
		CASE THIS.Parent.EditMode
		
			** Code for saving record
			*THIS.Parent.UpdateRows()
			ThisForm.SaveAdd("Save")
		
		CASE EMPTY(THIS.Parent.GridRef)		&& not using Grid object
		
			** Code for adding record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
		*	APPEND BLANK
			ThisForm.SaveAdd("Add")
		OTHERWISE
		
			** Code for adding record
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
			lPrimeKey = .F.					&&is child key primary index
			
			ThisForm.SaveAdd("Add")
		
		ENDCASE
		
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = THIS.Parent.EditMode
		THIS.Parent.TopFile = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE BUTTONSET1.cmdDelete.Click
		IF MESSAGEBOX( "Are you sure you want to Delete?",4+32,"DELETE") != 6
			RETURN .F.
		ENDIF
		
		PRIVATE nUseID
		nUseID = ThisForm.UseID1.Value
		
		*!*	IF Count_pSoldAddrinSales_No( nVendCode, THISFORM.nConnHandle) > 0
		*!*		MESSAGEBOX( 'You cannot delete this Address!'+CHR(13)+"This address has a SalesOrder history to it!",16,'Not allowed')
		*!*		RETURN
		*!*	ENDIF
			
		
		PRIVATE nSQLEXEC, cSQL
		cSQL = "DELETE FROM dbo.ThermalCoupleUse WHERE UseID = "+STR(nUseID)
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'ThermalCoupleUse')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'ThermalCoupleUse')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ThermalCoupleUse")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "ThermalCoupleUse")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'ThermalCoupleUse')
		ELSE
			ThisForm.RefreshTable( RECNO('ThermalCoupleUse') )
			MESSAGEBOX('Deleted ThermalCoupleUse UseID= '+ALLTRIM(STR(nUseID))+'!',48,'Deleted')
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE BUTTONSET1.cmdEdit.Click
		** Reverting record
		IF THIS.Parent.EditMode
			* Go back to original place
			SELECT (THIS.Parent.OldAlias)
			IF RECCOUNT() < THIS.Parent.OldRec	&&added record at EOF()
				GO TOP
			ELSE
				GO THIS.Parent.OldRec
			ENDIF
		ELSE
		
			* Check to see if view allows updates
			
			THIS.Parent.OldAlias = ALIAS()	&&save alias in case reverting
			THIS.Parent.OldRec = RECNO()	&&save record in case reverting
		ENDIF
		
		** Editing record
		THIS.Parent.EditMode = !THIS.Parent.EditMode
		THIS.Parent.AddMode = .F.
		THISFORM.LockScreen = .T.
		THIS.Parent.ButtonRefresh()
		THIS.Parent.NavRefresh()
		THISFORM.LockScreen = .F.
		
		*DODEFAULT( ) 
		
		*ThisForm.SaveAdd('Edit')  
		
		
	ENDPROC

	PROCEDURE LBLUSED1.Click
		PRIVATE dDate1,dDate2
		
		dDate1 = ThisForm.USED1.Value
		DO FORM "forms\popupdate.scx" WITH dDate1 TO dDate2
		IF VARTYPE(dDate2) = "T"
			dDate2 = TTOD(dDate2)
		ENDIF
		IF VARTYPE(dDate2) != "D"
			dDate2 = CTOD('')
		ENDIF
		ThisForm.USED1.Value = dDate2
	ENDPROC

ENDDEFINE
