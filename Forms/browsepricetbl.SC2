	PROCEDURE getalloysurcharge
		*getAlloySurcharge()
		
		IF USED('tmpAlloySurcharge')
			USE IN tmpAlloySurcharge
		ENDIF
		
		PRIVATE cAlloy
		cAlloy = pricetable.Alloy
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT dbo.f_Alloy_Surcharge('"+cAlloy+"')"
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpAlloySurcharge')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpAlloySurcharge')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloySurcharge')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpAlloySurcharge')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpAlloySurcharge' )
		ENDIF
		
		ThisForm.txtSurcharge.Value = 0
		
		IF USED('tmpAlloySurcharge')
			SELECT tmpAlloySurcharge
			IF RECCOUNT('tmpAlloySurcharge') > 0
		*		IF VARTYPE('tmpAlloySurcharge.EXP')='N'
					ThisForm.txtSurcharge.Value = tmpAlloySurcharge.EXP
		*		ENDIF
			ENDIF
			USE IN tmpAlloySurcharge
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pAlloy,pForm,pCC,pCL,pThck
		PRIVATE nBestItem, cAlloy
		*DO FORM Forms\BrowsePriceTBL WITH Quotes.alloy, lcInvForm, Quotes.CC, Quotes.CL, Quotes.thck
		ThisForm.OrigTable = ALIAS()
		
		IF TYPE('pAlloy') = "C"
			DO CASE
			CASE pAlloy = "NI60 HS"
				cAlloy = "NITRONIC 60"
			CASE pAlloy = "NI50 HS"
				cAlloy = "NITRONIC 50"
			OTHERWISE 
				cAlloy = pAlloy	
			ENDCASE
			ThisForm.txtAlloy.Value = cAlloy	
		ELSE
			ThisForm.txtAlloy.Value = SPACE(12)
		ENDIF
		
		
		IF TYPE('pForm') = "C"
			ThisForm.cmbForm.Value = pForm
		ELSE
			ThisForm.cmbForm.Value = SPACE(2)
		ENDIF
		
		IF TYPE('pCC') = "C"
			ThisForm.cmbCC.Value = pCC
		ELSE
			ThisForm.cmbCC.Value = '1'
		ENDIF
		
		IF TYPE('pCL') = "C"
			ThisForm.cmbCL.Value = pCL
		ELSE
			ThisForm.cmbCL.Value = ' '
		ENDIF
		
		IF TYPE('pThck') = "N"
			ThisForm.txtThck.Value = pThck
		ELSE
			ThisForm.txtThck.Value = 0
		ENDIF
		
		IF !EMPTY(ThisForm.txtAlloy.Value)
			ThisForm.cmdSearch.Click
		ENDIF
		
		ThisForm.getAlloySurcharge()
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		ThisForm.Load_PriceTable()
		
		
	ENDPROC

	PROCEDURE load_pricetable
		PARAMETERS pWhat
		*ThisForm.Load_PriceTable()
		
		IF VARTYPE(pWhat) != "C"
			pWhat = ""
		ENDIF
		
		
		IF UPPER(pWhat) ="REFRESH"
		*	ThisForm.frmRMA.pf1.pgEdit.Grid1.RecordSource = ''
		*	ThisForm.frmRMA.pf1.pgBrowse.GridBR.RecordSource = ''
			
			IF USED('PriceTable')
				USE IN PriceTable
			ENDIF
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		IF NOT USED('PriceTable')
			SELECT 0
			
			cSQL = "SELECT alloy,form,CC,CL"
		    cSQL = cSQL+",[Size]"
		    cSQL = cSQL+",[w0],[w5],[w10],[w25]"
		    cSQL = cSQL+",[w50],[w100],[w200]"
		    cSQL = cSQL+",[w500],[w1000],[w2000],[wBase],[ActivePric]"
		*    cSQL = cSQL+",[size2],[size3],[wBASE],[Size],pt_id"
		    cSQL = cSQL+" FROM dbo.PriceTable "
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PriceTable')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PriceTable')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PriceTable')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'PriceTable')
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'PriceTable' )
			ENDIF
		
		ENDIF
		
		IF USED('PriceTable')
			SELECT PriceTable 
		
			INDEX ON alloy+form+CC TAG 'alloyformC' &&OF PriceTable 
			INDEX ON Alloy+Form TAG 'alloyform'  &&OF PriceTable 
			INDEX ON UPPER(Alloy) TAG 'UPPAlloy'  &&OF PriceTable 
			INDEX ON alloy+form+CC+LTRIM(STR(Size,9,4)) TAG 'PriceT'  &&OF PriceTable 
			
			TRY	
				SET ORDER TO TAG 'PriceT' OF PriceTable 
			CATCH
				MESSAGEBOX("Error with Index",0+16,"Error")
			ENDTRY
			
			GO TOP
			IF UPPER(pWhat) ="REFRESH"
			
			ENDIF
		
		ELSE
			MESSAGEBOX('Failed to load PriceTable',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

	PROCEDURE Resize
		PRIVATE nDeltaW ,nDeltaH
		nDeltaW = ThisForm.Width - 888 
		nDeltaH = ThisForm.Height - 291
		
		
		ThisForm.grdPriceTBL.Width = 888 + nDeltaW 
		ThisForm.grdPriceTBL.Height = 240 + nDeltaH
		
		ThisForm.Shape1.Top = 250 + nDeltaH
		ThisForm.lblAlloy.Top = 252 + nDeltaH
		ThisForm.lblForm.Top = 252 + nDeltaH
		ThisForm.lblCC.Top = 252 + nDeltaH
		ThisForm.lblThck.Top = 252 + nDeltaH
		
		ThisForm.txtAlloy.Top = 264 + nDeltaH
		ThisForm.cmbForm.Top = 264 + nDeltaH
		ThisForm.cmbCC.Top = 264 + nDeltaH
		ThisForm.txtThck.Top = 264 + nDeltaH
		
		ThisForm.cmdSearch.Top = 258 + nDeltaH
		ThisForm.cmdDone.Top = 258 + nDeltaH
	ENDPROC

	PROCEDURE Unload
		IF USED('PriceTable')
			USE IN PriceTable
		ENDIF
		
		cOrigTable = ThisForm.OrigTable
		IF NOT EMPTY(cOrigTable)
			IF USED(cOrigTable)
				SELECT (cOrigTable)
			ENDIF
		ENDIF
		
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE updatesearch
		ThisForm.txtAlloy.Value = PriceTable.Alloy
		ThisForm.cmbForm.Value	= PriceTable.Form
		ThisForm.cmbCC.Value	= PriceTable.CC
		ThisForm.cmbCL.Value	= PriceTable.CL	
		
	ENDPROC

	PROCEDURE cmbCC.GotFocus
		ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisForm.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
		
		
	ENDPROC

	PROCEDURE cmbCC.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionCode')
			SELECT ConditionCode
		ELSE
			SELECT 0
		ENDIF
		
		*this.clear
		cSQL="SELECT [cc],[text] FROM dbo.ConditionCode"
		cSQL = cSQL + " WHERE ISNULL(inActive,0) = 0"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionCode')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionCode')
		ENDIF
		
		DIMENSION aConditionCode(1,2)
		aConditionCode(1,1) = "1"
		aConditionCode(1,2) = "Anneal"
		
		IF USED('ConditionCode')
			SELECT * FROM ConditionCode INTO ARRAY aConditionCode
			
			USE IN ConditionCode
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionCode)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionCode
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = Quotes.CC
		
		
	ENDPROC

	PROCEDURE cmbCC.InteractiveChange
		PRIVATE cCC
		cCC		= PrepareSQLtxt(This.Value,'CC',1)
		
		This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
		ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		ThisForm.CL = PrepareSQLtxt(This.Parent.cmbCL.Value,'CL',1)
	ENDPROC

	PROCEDURE cmbCC.LostFocus
		PRIVATE cCC
		cCC = PrepareSQLtxt(This.Value,'CC',1)
		
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		This.Parent.cmbCL.Clear
		
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		cSQL=cSQL+" WHERE [CC]='"+cCC+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = ""
		
		IF USED('ConditionLevel')
			cCL1 = PrepareSQLtxt(ConditionLevel.CL,'CL',1)
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ELSE 
			*did not find a CL
			cCL1 = ''
		ENDIF
		
		This.Parent.cmbCL.ColumnCount = 2
		This.Parent.cmbCL.NumberOfElements=ALEN(aConditionLevel)
		This.Parent.cmbCL.BoundColumn = 1
		This.Parent.cmbCL.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					This.Parent.cmbCL.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		This.Parent.cmbCL.Value = cCL1
		
		IF ThisForm.CC != PrepareSQLtxt(This.Value,'CC',1)
			ThisForm.CC = PrepareSQLtxt(This.Value,'CC',1)
		*	This.Parent.cmbCL.Value = ''
			This.Parent.cmbCL.Value = Default_CL_CC(cCC,ThisForm.nConnHandle)
			This.Parent.cmbCL.Refresh
		ENDIF
	ENDPROC

	PROCEDURE cmbCL.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('ConditionLevel')
			SELECT ConditionLevel
		ELSE
			SELECT 0
		ENDIF
		
		*this.clear
		cSQL="SELECT [CL],[text] FROM dbo.ConditionLevel"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'ConditionLevel')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'ConditionLevel')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'ConditionLevel')
		ENDIF
		
		DIMENSION aConditionLevel(1,2)
		aConditionLevel(1,1) = ""
		aConditionLevel(1,2) = " "
		
		IF USED('ConditionLevel')
			SELECT * FROM ConditionLevel INTO ARRAY aConditionLevel
			
			USE IN ConditionLevel
		ENDIF
		
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aConditionLevel)
		This.BoundColumn = 1
		This.ColumnWidths = "10,115"
		
		nLoopCount = 1
		
		FOR EACH cc1 IN aConditionLevel
			IF !EMPTY(cc1)
				IF LEN(ALLTRIM(cc1)) > 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,2)
				ELSE
					nLoopCount = nLoopCount + 1
					this.addListitem(ALLTRIM(cc1),nLoopCount,1)
				ENDIF
			ENDIF
		ENDFOR
		
		*This.Value = Quotes.CL
		
		
	ENDPROC

	PROCEDURE cmbForm.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('FormCode')
			USE IN FormCode
		ENDIF
		
		SELECT 0
		
		*this.clear
		cSQL="SELECT [FormNumber],[FormDescription] FROM dbo.Forms"
		cSQL = cSQL + " WHERE LEN(FormNumber) > 0 AND LEN(FormDescription) > 0"
		cSQL = cSQL + " ORDER BY [FormNumber] ASC"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'FormCode')
		ENDIF
		
		DIMENSION aFormCode(1,2)
		
		IF USED('FormCode')
		
			IF RECCOUNT('FormCode') = 0
				*Load again
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'FormCode')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'FormCode')
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
			ENDIF
			
			IF RECCOUNT('FormCode') = 0
				SELECT '' AS FormNumber,'' AS FormDescription FROM FormCode INTO ARRAY aFormCode
			ELSE
				SELECT FormNumber,FormDescription FROM FormCode INTO ARRAY aFormCode
			ENDIF
				
			
			USE IN FormCode
		ENDIF
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aFormCode,1)
		
		This.ColumnCount = 2
		This.NumberOfElements = nArrayCount
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		FOR I = 1 TO nArrayCount
			this.addListitem(aFormCode(I, 1),I,1)
			this.addListitem(aFormCode(I, 2),I,2)
		ENDFOR
	ENDPROC

	PROCEDURE cmdDone.Click
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdSearch.Click
		PRIVATE nBestItem, nThckplus, nThckMinus 
		PRIVATE cAlloy, cForm, cCC, nThck
		
		cAlloy = ThisForm.txtAlloy.Value
		cForm  = ThisForm.cmbForm.Value
		cCC	   = ThisForm.cmbCC.Value
		nThck  = ThisForm.txtThck.Value
		
		SELECT PriceTable
		*INDEX ON alloy+form+CC+LTRIM(STR(Size,9,4)) TAG 'PriceT' OF PriceTable 
		IF "\MEM" $ SYS(2003)
			INDEX ON alloy+form+CC+LTRIM(STR(Size,9,4)) TO SYS(5)+SYS(2003)+"\PriceT"
			INDEX ON alloy+form+CC                      TO SYS(5)+SYS(2003)+"\alloyformC" ADDITIVE 
		ELSE
			INDEX ON alloy+form+CC+LTRIM(STR(Size,9,4)) TO SYS(5)+SYS(2003)+"\MEM\PriceT"
			INDEX ON alloy+form+CC                      TO SYS(5)+SYS(2003)+"\MEM\alloyformC" ADDITIVE 
		ENDIF
		
		TRY	
			SET ORDER TO PriceT
		CATCH
		*	MESSAGEBOX("Error with Index",0+16,"Error")
			TrackError("SET ORDER TO PriceT","SET ORDER TO PriceT "+" Only one instance can be run at a time. "+"Error with Index File","BrowsePriceTable.cmdSearch.Click()",LINENO(1) )
		ENDTRY
		
		IF !EMPTY(cAlloy) AND !EMPTY(cForm) AND !EMPTY(cCC) AND !EMPTY(nThck)
			SET ORDER TO PriceT
			SEEK LEFT(cAlloy,12)+cForm+cCC+STR(nThck,9,3)
			nBestItem =RECNO()
			IF nBestItem > RECCOUNT('PriceTable')
				*Check to see if a fraction under
				nThckplus = nThck+.001
				SEEK LEFT(cAlloy,12)+cForm+cCC+STR(nThckplus, 9,3)
				nBestItem =RECNO('PriceTable')
				IF nBestItem > RECCOUNT('PriceTable')
				*Check to see if a fraction over
					nThckMinus = nThck-.001
					SEEK LEFT(cAlloy,12)+cForm+cCC+STR(nThckMinus, 9,3)
					nBestItem =RECNO('PriceTable')
				ENDIF	
			ENDIF
		ELSE
			nBestItem = RECCOUNT()+1
		ENDIF
		
		IF nBestItem > RECCOUNT()
			*did not find all
			*Find Alloy and Form and CC
			IF !EMPTY(cAlloy) AND !EMPTY(cForm) AND !EMPTY(cCC)
				
				SET ORDER TO alloyformC
				SEEK LEFT(cAlloy,12)+cForm+cCC
				nBestItem =RECNO()
				IF FOUND('PriceTable')
					nBestItem =RECNO()
					SET ORDER TO PriceT
					SET FILTER TO Alloy = (cAlloy) AND FORM = (cForm) AND CC=(cCC)
					GO TOP
					DO WHILE NOT EOF()
						IF nThck < PriceTable.Size
							* IF The thickness you search is Greater than the Stocklist Size,
							* exit- use the previous records number as Best
							EXIT
						ENDIF
						nBestItem =RECNO()
						SKIP
					ENDDO
					SET FILTER TO 
					GOTO nBestItem
				ENDIF
			ELSE
				nBestItem = RECCOUNT()+1
			ENDIF
		ENDIF
		
		IF nBestItem > RECCOUNT()
			*did not find all
			*Find Alloy and Form
			IF !EMPTY(cAlloy) AND !EMPTY(cForm)
			
				IF "\MEM" $ SYS(2003)
					INDEX ON alloy+form TO SYS(5)+SYS(2003)+"\alloyform" ADDITIVE 
				ELSE
					INDEX ON alloy+form TO SYS(5)+SYS(2003)+"\MEM\alloyform" ADDITIVE 
				ENDIF
				SET ORDER TO alloyform
				SEEK LEFT(cAlloy,12)+cForm
				nBestItem =RECNO()
				IF FOUND('PriceTable')
					nBestItem =RECNO()
					SET ORDER TO PriceT
					SET FILTER TO Alloy = (cAlloy) AND FORM = (cForm)
					GO TOP
					DO WHILE NOT EOF()
						IF nThck < PriceTable.Size
							* IF The thickness you search is Greater than the Stocklist Size,
							* exit- use the previous records number as Best
							EXIT
						ENDIF
						nBestItem =RECNO()
						SKIP
					ENDDO
					SET FILTER TO 
					GOTO nBestItem
				ENDIF
			ELSE
				nBestItem = RECCOUNT()+1
			ENDIF
		ENDIF
		
		IF nBestItem > RECCOUNT()
			*find alloy
			IF !EMPTY(cAlloy)
				IF "\MEM" $ SYS(2003)
					INDEX ON UPPER(Alloy) TO SYS(5)+SYS(2003)+"\UPPAlloy" ADDITIVE 
				ELSE
					INDEX ON UPPER(Alloy) TO SYS(5)+SYS(2003)+"\MEM\UPPAlloy" ADDITIVE 
				ENDIF
				SET ORDER TO UPPAlloy
				SEEK UPPER(LEFT(cAlloy,12)) IN PriceTable
			ENDIF
			nBestItem =RECNO()
		ENDIF
		
		IF nBestItem > RECCOUNT()
			*did not find alloy
			IF !EMPTY(cAlloy)
				SET ORDER TO UPPAlloy
				SEEK LEFT(cAlloy,3) IN PriceTable
			ENDIF
		ELSE
			ThisForm.grdpricetbl.SetFocus()
		ENDIF
		
		SELECT PriceTable
		SET ORDER TO PriceT
		
		ThisForm.Refresh
	ENDPROC

	PROCEDURE grdPriceTBL.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.getAlloySurcharge()
		ThisForm.UpdateSearch()
	ENDPROC

	PROCEDURE txtAlloy.InteractiveChange
		lnInsertionPt = this.SelStart
		lcSearchStr = substr(this.value,1,lnInsertionPt)
		IF !empty(lcSearchStr)
			=seek(upper(lcSearchStr),"PriceTable","UppAlloy")
			IF found("PriceTable")
				this.VALUE=PriceTable.Alloy
				This.ForeColor = RGB(0,0,0)
			ELSE
				**No replacement
				this.value=lcSearchStr
				This.ForeColor = RGB(255,0,0)
			ENDIF
		ELSE
			this.value=space(0)
		ENDIF
		this.selstart = lnInsertionPt
		
	ENDPROC

	PROCEDURE txtAlloy.LostFocus
		=insmode(.T.)
	ENDPROC

ENDDEFINE
