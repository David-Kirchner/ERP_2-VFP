	PROCEDURE cmdCancel.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE cmdChange.Click
		WITH THISFORM
			.cntBackGroundColor.BACKCOLOR=GETCOLOR(.cntBackGroundColor.BACKCOLOR)
		ENDWITH
		
	ENDPROC

	PROCEDURE cmdOk.Click
		THISFORM.Hide()
	ENDPROC

	PROCEDURE cmdPickUpReport.Click
		LOCAL loNULL
		
		ON ERROR loNULL = .NULL.
		THISFORM.txtLocalization.VALUE=GETFILE('DBF')
		ON ERROR
		
	ENDPROC

	PROCEDURE txtLocalization.InteractiveChange
		WITH THIS
		*!*		IF EMPTY(THISFORM.txtOutputPath.VALUE)
				THISFORM.txtOutputPath.VALUE = ADDBS(JUSTPATH(.VALUE))
		*!*		ENDIF
			
		*!*		IF EMPTY(THISFORM.txtOutputFileName.VALUE)
				THISFORM.txtOutputFileName.VALUE = JUSTSTEM(.VALUE)
		*!*		ENDIF
			
		ENDWITH
		
	ENDPROC

	PROCEDURE txtLocalization.ProgrammaticChange
		THIS.INTERACTIVECHANGE()
		
	ENDPROC

ENDDEFINE
