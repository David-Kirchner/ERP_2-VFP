	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER cScanName
		
		IF TYPE("cScanName") = "C"
			IF cScanName != "(Scan Name)"
				SELECT PRC_Equipment
				SEEK UPPER(cScanName) ORDER UppScanName
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_SQL.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
		PRIVATE nSQLEXEC, cSQL
		IF USED('PRC_Equipment')	
			USE IN PRC_Equipment
		ENDIF
		
		*USE HPA!Receiving SHARED IN 0
		cSQL = "SELECT * FROM dbo.PRC_Equipment WITH(NOLOCK) "
			
		SELECT 0
		nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'PRC_Equipment')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(THISFORM.nConnHandle, cSQL, 'PRC_Equipment')
		ENDDO
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'PRC_Equipment')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PRC_Equipment")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "PRC_Equipment")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, THISFORM.nConnHandle, nSQLEXEC, 'PRC_Equipment')
		ELSE
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT(ThisForm.nConnHandle)
		
		IF USED('PRC_Equipment')	
			USE IN PRC_Equipment
		ENDIF
	ENDPROC

	PROCEDURE BUTTONSET1.cmdAdd.Click
		PRIVATE cCaption
		cCaption = This.Caption
		DODEFAULT()
		
		IF cCaption = "Add"
			ThisForm.ID1.Value = VAL( NewID("PRC_Equipment") )
		ENDIF
	ENDPROC

