	PROCEDURE deletelocation
		
		PRIVATE cLocation, cDescription
		cLocation	= PrepareSQLtxt(ThisForm.txtLocation.Value,'Location',10)
		cDescription= PrepareSQLtxt(ThisForm.edtDescription.Value,'Decription',-1)
		
		IF LEN(cLocation) = 0
			MESSAGEBOX("You cannot delete this Location!",48,"Cannot Delete!")
			RETURN .F.
		ENDIF
		
		IF EMPTY(cLocation)
			MESSAGEBOX("You cannot delete this Location!"+CHR(13)+"Location empty",48,"Cannot Delete!")
			RETURN .F.
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		PRIVATE lFoundLocation, nFoundCount
		lFoundLocation = .F.
		nFoundCount = 0
		
		IF USED('tmpCntdStockLst_Location')
			USE IN tmpCntdStockLst_Location
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.StockLst_Detail"
		cSQL = cSQL + " WHERE Location = '"+cLocation+"'"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntdStockLst_Location')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntdStockLst_Location')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntdStockLst_Location")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntdStockLst_Location")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCntdStockLst_Location')
			RETURN .F.
		ELSE
			IF USED('tmpCntdStockLst_Location')
				IF VARTYPE(tmpCntdStockLst_Location.CNTD) = "N"
					lFoundLocation = ( tmpCntdStockLst_Location.CNTD > 0 )
					nFoundCount = tmpCntdStockLst_Location.CNTD
				ENDIF
				USE IN tmpCntdStockLst_Location
			ENDIF
		ENDIF
		
		IF lFoundLocation 
			MESSAGEBOX("Location '"+ALLTRIM(cLocation)+"' is being used in StockLst ("+ALLTRIM(STR(nFoundCount))+") Times."+CHR(13)+"Cannot Delete."+CHR(10)+CHR(10)+"Edit this location and save with the correct Location Name."+CHR(10)+CHR(10)+"That would remove this name and"+CHR(10)+"update the StockLst to use the new name.",48,"Cannot Delete!")
		ELSE
			cSQL = "DELETE FROM dbo.StockLst_Location "
			cSQL = cSQL + " WHERE [Location] = '"+cLocation+"'"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
				RETURN .F.
			ELSE
				ThisForm.GetSQLData()
				RETURN .T.
			ENDIF	
		ENDIF
	ENDPROC

	PROCEDURE getsqldata
		PARAMETERS pWhat
		
		*ThisForm.GetSQLData
		IF VARTYPE(pWhat) != "C"
			pWhat = ''
		ENDIF
		
		ThisForm.grdLocation.RecordSource = ""
		
		IF USED("tmpStockLst_Location")
			SELECT tmpStockLst_Location
		ELSE
			SELECT 0
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT [Location], SUBSTRING(Description,1,50) AS [DESCR], Description, MaxLBS FROM dbo.StockLst_Location "
		*cSQL="SELECT DISTINCT [Location] FROM dbo.StockLst_Detail WHERE NOT ( [Location] LIKE '%&%' OR [Location] LIKE '%/%' OR [Location] LIKE '%,%') ORDER BY [Location]"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Location')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Location')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Location")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Location")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Location')
		ELSE
			IF USED("tmpStockLst_Location")
				
				ThisForm.grdLocation.RecordSource = "tmpStockLst_Location"
				IF pWhat = "INIT"
				
				ELSE
					SELECT tmpStockLst_Location
					INDEX ON Location TAG Location
					SET ORDER TO TAG Location
					SEEK pWhat
					
					ThisForm.grdLocation.Column1.ControlSource = 'tmpStockLst_Location.Location'
					ThisForm.grdLocation.Column2.ControlSource = 'tmpStockLst_Location.Descr'
				ENDIF
				
					
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		ThisForm.GetSQLData("INIT")
	ENDPROC

	PROCEDURE Load
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		
	ENDPROC

	PROCEDURE refreshdata
		*ThisForm.RefreshData()
		ThisForm.txtLocation.Value = tmpStockLst_Location.Location
		ThisForm.edtDescription.Value = tmpStockLst_Location.Description
		
		ThisForm.txtCurrentLBS.Value = LBS_Location(tmpStockLst_Location.Location,ThisForm.nConnhandle)  
		ThisForm.txtMaxLbs.Value = PrepareSQLnum(tmpStockLst_Location.MaxLBS,'MaxLBS',-3) 
		
		ThisForm.txtCurrRec.Value = Location_CNT(tmpStockLst_Location.Location,ThisForm.nConnhandle)  
	ENDPROC

	PROCEDURE savelocation
		*ThisForm.SaveLocation
		
		PRIVATE cLocation, cDescription, nMaxLBS
		cLocation	= PrepareSQLtxt(ThisForm.txtLocation.Value,'Location',10)
		cDescription= PrepareSQLtxt(ThisForm.edtDescription.Value,'Decription',-1)
		nMaxLBS		= PrepareSQLnum(ThisForm.txtMaxLbs.Value,'MaxLBS',-3)
		
		PRIVATE cLocationOld, cDescriptionOld
		cLocationOld 	= PrepareSQLtxt(tmpStockLst_Location.Location,'Location',10)
		cDescriptionOld = PrepareSQLtxt(tmpStockLst_Location.Description,'Decription',-1)
		
		PRIVATE cSQL, nSQLEXEC
		IF LEN(cLocation) = 0
			MESSAGEBOX("You cannot save a blank location.",48,"No SAVE!")
			RETURN .F.
		ENDIF
		*******************************
		
		*Location has changed!
		PRIVATE lFoundLocation 
		lFoundLocation = .F.
		
		IF USED('tmpCntdStockLst_Location')
			USE IN tmpCntdStockLst_Location
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(*) AS CNTD FROM dbo.StockLst_Location "
		cSQL = cSQL + " WHERE RTRIM([Location]) = RTRIM('"+cLocation+"')"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntdStockLst_Location')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCntdStockLst_Location')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntdStockLst_Location")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCntdStockLst_Location")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCntdStockLst_Location')
			RETURN .F.
		ELSE
			IF USED('tmpCntdStockLst_Location')
				IF VARTYPE(tmpCntdStockLst_Location.CNTD) = "N"
					lFoundLocation = ( tmpCntdStockLst_Location.CNTD > 0 )
				ENDIF
				USE IN tmpCntdStockLst_Location
			ENDIF
		ENDIF
		
		
		
		*******************************
		IF ThisForm.cWhat = "Edit"
		*IF cLocationOld = cLocation 
			IF NOT lFoundLocation 
				MESSAGEBOX( "Did not find the location to Edit/Rename",0+48,"Nothing to Save")
				*Nothing to do
				RETURN .F.
			ENDIF
			IF NOT EMPTY(cLocation)
				*UPDATE Description, same location
			
				cSQL = "UPDATE dbo.StockLst_Location "
				cSQL = cSQL + " SET [Description] = '"+ALLTRIM(cDescription)+"'"
				cSQL = cSQL + " ,MaxLBS = "+STR(nMaxLBS)
				cSQL = cSQL + " WHERE [Location] = '"+cLocation+"'"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
					RETURN .F.
				ELSE
					ThisForm.GetSQLData(cLocation)
					RETURN .T.
				ENDIF
			ELSE
				WAIT WINDOW "Nothing to Save" NOWAIT
				*Nothing to do
				RETURN .T.
			ENDIF
			RETURN .T.
		ENDIF
		
		*******************
		IF ThisForm.cWhat = "Add"
			IF lFoundLocation 
				MESSAGEBOX("That location already exists."+CHR(13)+"Cannot Add again",0+48,"Nothing to Save")
				RETURN .F.
			ENDIF
			
			IF cDescriptionOld != cDescription AND NOT EMPTY(cLocation)
				*INSERT Description, same location
			
				cSQL = "INSERT INTO dbo.StockLst_Location ([Description],[MaxLBS],[Location]) VALUES "
				cSQL = cSQL + "('"+ALLTRIM(cDescription)+"'"
				cSQL = cSQL + " ,"+STR(nMaxLBS)
				cSQL = cSQL + ",'"+cLocation+"'"+")"
			
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
					RETURN .F.
				ELSE
					ThisForm.GetSQLData(cLocation)
					RETURN .T.
				ENDIF
			ENDIF
		ENDIF
		
		
		*************
		
		*Is Location a new Add?
		IF NOT lFoundLocation 	
			*Insert
			IF LEN(cDescription) < 1
				cDescription = ' '
			ENDIF
			cSQL = "INSERT INTO dbo.StockLst_Location ([Location],[MaxLBS],[Description])"
			cSQL = cSQL + " VALUES ('"+cLocation+"'"
			cSQL = cSQL + ","+STR(nMaxLBS)
			cSQL = cSQL + ",'"+cLocation+"'"+")"
		
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
				RETURN .F.
			ELSE
				WAIT WINDOW "Saved StockLst Location." TIMEOUT 1
				ThisForm.GetSQLData(cLocation)
				RETURN .T.
			ENDIF	
			
		ELSE
			IF NOT EMPTY(cLocationOld)
				*Is location a rename for StockLst?
				*	1. If location was named to an exiting location name
				*	then Update StockLst with new location name
				*	and Delete the old location name from StockLst_Location
				*	*ask what Description to use!
			
				IF MESSAGEBOX("This save will update the StockLst_Detail table to list location as '"+ALLTRIM(cLocation)+"' when they where listed as '"+ALLTRIM(cLocationOld)+"'."+CHR(10)+CHR(10)+"Check the 'description' after the location name update.",4+64,"Are you sure you want to update this location?") = 6
					
					cSQL = "UPDATE dbo.StockLst_Detail "
					cSQL = cSQL + " SET [Location] = '"+cLocation+"'"
					cSQL = cSQL + " ,[Description] = '"+ALLTRIM(cDescription)+"'"
					cSQL = cSQL + " ,MaxLBS = "+STR(nMaxLBS)
					cSQL = cSQL + " WHERE [Location] = '"+cLocationOld+"'"
				
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC < 0
						SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
						RETURN .F.
					ELSE
						WAIT WINDOW "Renamed location on StockLst table." TIMEOUT 1
					ENDIF
				
					IF LEN(cDescription) < 1
						cDescription = ' '
					ENDIF
					
					*Check to see if cLocation already exists
					IF NOT lFoundLocation 
						cSQL = "UPDATE dbo.StockLst_Location SET [Location]='"+cLocation+"'"
						cSQL = cSQL + ",[Description]='"+ALLTRIM(cDescription)+"'"
						cSQL = cSQL + " ,MaxLBS = "+STR(nMaxLBS)
						cSQL = cSQL + " WHERE [Location] = '"+cLocationOld+"'"
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
						ENDDO
						IF nSQLEXEC < 0 &&Try again!
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL 2' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
								
								IF nSQLEXEC < 0
									IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
										nSQLEXEC = 0
									ENDIF
								ENDIF
							ENDDO
						ENDIF 
						IF nSQLEXEC < 0
							SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC )
							RETURN .F.
						ELSE
							ThisForm.GetSQLData(cLocation)
							WAIT WINDOW "Renamed location on StockLst_Location table." TIMEOUT 1
							RETURN .T.
						ENDIF
					ENDIF
					
				ENDIF		
			ELSE
				RETURN .F.
			ENDIF	
		ENDIF	
		
		RETURN .T.
		
		
		
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
	ENDPROC

	PROCEDURE cmdAdd.Click
		IF This.Caption = "Add"
			*Add
			ThisForm.txtLocation.Enabled = .T.
			ThisForm.edtDescription.Enabled = .T.
			ThisForm.txtMaxLbs.Enabled = .T.
			
			ThisForm.txtLocation.Value = ''
			ThisForm.edtDescription.Value = ''
			ThisForm.txtMaxLbs.Value = 0
			
			ThisForm.cWhat = "Add"
			This.Caption = "Save"
			ThisForm.cmdEdit.Caption = "Cancel"
			ThisForm.cmdDelete.Enabled = .F.
			ThisForm.grdLocation.Enabled = .F.
			
			ThisForm.cmdTiptonC.Enabled = .F.
			ThisForm.cmdTiptonR.Enabled = .F.
			ThisForm.cmdTiptonS.Enabled = .F.
			ThisForm.cmdWindfall.Enabled = .F.
			ThisForm.cmdWindfallC.Enabled = .F.
			ThisForm.cmdWindfallE.Enabled = .F.
			ThisForm.cmdWindfallS.Enabled = .F.
			ThisForm.cmdWindfallW.Enabled = .F.
			
			ThisForm.txtLocation.SetFocus
		ELSE
			*Save
			IF ThisForm.SaveLocation()
				ThisForm.txtLocation.Enabled = .F.
				ThisForm.edtDescription.Enabled = .F.
				ThisForm.txtMaxLbs.Enabled = .F.
				
				ThisForm.cWhat = ""
				This.Caption = "Add"
				ThisForm.cmdEdit.Caption = "Edit"
				ThisForm.cmdDelete.Enabled = .T.
				ThisForm.grdLocation.Enabled = .T.
				
				ThisForm.cmdTiptonC.Enabled = .T.
				ThisForm.cmdTiptonR.Enabled = .T.
				ThisForm.cmdTiptonS.Enabled = .T.
				ThisForm.cmdWindfall.Enabled = .T.
				ThisForm.cmdWindfallC.Enabled = .T.
				ThisForm.cmdWindfallE.Enabled = .T.
				ThisForm.cmdWindfallS.Enabled = .T.
				ThisForm.cmdWindfallW.Enabled = .T.
			
				ThisForm.grdLocation.SetFocus
			ENDIF	
		ENDIF
	ENDPROC

	PROCEDURE cmdDelete.Click
		PRIVATE nCurrRecs
		nCurrRecs = Location_CNT(tmpStockLst_Location.Location,ThisForm.nConnhandle)  
		
		IF nCurrRecs > 0
			MESSAGEBOX("This location is still being Used."+CHR(13)+ALLTRIM(STR(nCurrRecs))+" Records" +CHR(13)+"Cannot Delete",0+16,"Cannot Delete")
		ELSE
			ThisForm.DeleteLocation()
		ENDIF
		
		ThisForm.cWhat = ""
		ThisForm.grdLocation.SetFocus
	ENDPROC

	PROCEDURE cmdEdit.Click
		IF This.Caption = "Edit"
			*Edit
			PRIVATE cLocation
			cLocation	= PrepareSQLtxt(ThisForm.txtLocation.Value,'Location',10)
			
			IF LEN(cLocation) = 0
				MESSAGEBOX("You cannot EDIT this Location!",48,"Cannot EDIT!")
			ELSE
		
				ThisForm.txtLocation.Enabled = .T.
				ThisForm.edtDescription.Enabled = .T.
				ThisForm.txtMaxLbs.Enabled = .T.
				
				IF LEN(PrepareSQLtxt(ThisForm.edtDescription.Value,'Decription',-1)) = 0
					ThisForm.edtDescription.Value = ""
				ENDIF
				
				This.Caption = "Cancel"
				ThisForm.cWhat = "Edit"
				ThisForm.cmdAdd.Caption = "Save"
				ThisForm.cmdDelete.Enabled = .F.
				ThisForm.grdLocation.Enabled = .F.
				
				ThisForm.cmdTiptonC.Enabled = .F.
				ThisForm.cmdTiptonR.Enabled = .F.
				ThisForm.cmdTiptonS.Enabled = .F.
				ThisForm.cmdWindfall.Enabled = .F.
				ThisForm.cmdWindfallC.Enabled = .F.
				ThisForm.cmdWindfallE.Enabled = .F.
				ThisForm.cmdWindfallS.Enabled = .F.
				ThisForm.cmdWindfallW.Enabled = .F.
					
				ThisForm.edtDescription.SetFocus
			ENDIF	
		ELSE
			*Cancel
			ThisForm.txtLocation.Enabled = .F.
			ThisForm.edtDescription.Enabled = .F.
			ThisForm.txtMaxLbs.Enabled = .F.
			
			ThisForm.txtLocation.Value = tmpStockLst_Location.Location
			ThisForm.edtDescription.Value = tmpStockLst_Location.Description
			
			ThisForm.cWhat = ""
			This.Caption = "Edit"
			ThisForm.cmdAdd.Caption = "Add"
			ThisForm.cmdDelete.Enabled = .T.
			ThisForm.grdLocation.Enabled = .T.
			
			ThisForm.cmdTiptonC.Enabled = .T.
			ThisForm.cmdTiptonR.Enabled = .T.
			ThisForm.cmdTiptonS.Enabled = .T.
			ThisForm.cmdWindfall.Enabled = .T.
			ThisForm.cmdWindfallC.Enabled = .T.
			ThisForm.cmdWindfallE.Enabled = .T.
			ThisForm.cmdWindfallS.Enabled = .T.
			ThisForm.cmdWindfallW.Enabled = .T.
		
			ThisForm.grdLocation.SetFocus
		ENDIF
	ENDPROC

	PROCEDURE cmdQuit.Click
		ThisForm.Release
		
	ENDPROC

