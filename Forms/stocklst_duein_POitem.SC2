	PROCEDURE lblSaveIDDetailRecv.Click
		PRIVATE nID, nID_Detail, nReceiveID, cTBL
		nID = PrepareSQLnum(ThisForm.txtSD_ID_Master.Value,'Master_ID',-3)
		nReceiveID = PrepareSQLnum(ThisForm.txtR_ID.Value,'ReceiveID',-3)
		cTBL = PrepareSQLtxt(ThisForm.txtStockTable.Value,'TBL',1)
		
		
		PRIVATE lOK, nStockLst_ID
		lOK = .T.
		nStockLst_ID = 0
		
		IF nID*nReceiveID > 0
			IF EMPTY(cTBL)
				cTBL = 'S'
			ENDIF
			
			nID_Detail = Get_top_ID_Detail_from_ID( nID, cTBL, ThisForm.nConnHandle )
		
			IF USED('tmpUpdt_Rcv')
				USE IN tmpUpdt_Rcv
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC 
		
			SELECT 0
			cSQL = "UPDATE dbo.Receiving "
			cSQL = cSQL+" SET ID_Master ="+STR(nID)
			IF nID_Detail>0
				cSQL = cSQL+", ID_Detail="+STR(nID_Detail)
			ENDIF
			cSQL = cSQL+" WHERE ID = "+STR(nReceiveID)
		
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpUpdt_Rcv' )
				lOK = .F.
			ENDIF
			
			IF lOK
				cSQL = "SELECT ID_Master, ID_Detail "
				cSQL = cSQL+" FROM dbo.Receiving "
				cSQL = cSQL+" WHERE ID = "+STR(nReceiveID)
		
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpUpdt_Rcv' )
					lOK = .F.
				ENDIF
				
				
				IF USED('tmpUpdt_Rcv')
					SELECT tmpUpdt_Rcv 
					IF RECCOUNT('tmpUpdt_Rcv')>0
						nStockLst_ID = PrepareSQLnum(tmpUpdt_Rcv.ID_Master,"ID_Master",-3)	
						IF nStockLst_ID > 0
							ThisForm.txtSD_ID_Master.Value = nStockLst_ID 
							ThisForm.txtR_ID_Detail.Value = PrepareSQLnum(tmpUpdt_Rcv.ID_Detail,"ID_Detail",-3)	
							MESSAGEBOX("Saved",0,"SQL")
						ENDIF
					ENDIF
					
					USE IN tmpUpdt_Rcv 
				ENDIF
			ENDIF		
		ELSE
			MESSAGEBOX("Bad ID and WO_Detail",0,"No work")
		ENDIF
	ENDPROC

