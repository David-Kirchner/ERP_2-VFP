	PROCEDURE show_soitem
		PARAMETER cSOitem
		*ThisForm.Show_SOitem(cSOitem)
		
		IF USED('tmpSOitem')
			USE IN tmpSOitem
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT SOitem, Cncld, Cmplt, Shipped "
		cSQL = cSQL+" FROM dbo.Sales WITH(NOLOCK) WHERE SOitem='"+cSOitem+"'"
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitem')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSOitem')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSOitem')
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpSOitem' )
		ENDIF
		
		ThisForm.chkSO_Cmplt.Value = .F.
		ThisForm.chkSO_Canc.Value = .F.
		ThisForm.lblSOitem.Caption = " SOitem "
		ThisForm.lblshipped.Caption = 'shipped'
		
		IF USED('tmpSOitem')
			IF RECCOUNT('tmpSOitem')>0
				ThisForm.chkSO_Cmplt.Value = PrepareSQLchk(tmpSOitem.cmplt,'cmplt')
				ThisForm.chkSO_Canc.Value = PrepareSQLchk(tmpSOitem.cncld,'cncld')
				ThisForm.lblSOitem.Caption = PrepareSQLtxt(tmpSOitem.SOitem,'SOitem',10)
				ThisForm.lblshipped.Caption = IIF(ISNULL(tmpSOitem.shipped),'',PrepareSQLdate( tmpSOitem.shipped,'Shipped',.F.,.T. ))
				
			ENDIF
			USE IN tmpSOitem
		ENDIF
		
		
		
		SELECT Stock_DI
	ENDPROC

	PROCEDURE Unload
		IF USED('Stock_DI')
			USE IN Stock_DI
		ENDIF
	ENDPROC

	PROCEDURE cmdDel_DueIn.Click
		PRIVATE nID, nID2
		nID = PrepareSQLnum(ThisForm.txtSM_ID.Value,'Master_ID',-3)
		
		IF messagebox("Are you sure you want to delete ID "+ALLTRIM(STR(nID))+"? ",4,"Delete") =6
			SELECT Stock_DI
			SKIP 1
			nID2 = PrepareSQLnum(Stock_DI.SM_ID,'Master_ID',-3)
		
			PRIVATE cTBL,cFrom,cWhy
			cTBL = 'S'
			cFrom = "StockLst_DueIn"
			cWhy = "Remove stray DueIn"
			IF Remove_Lst_ID (cTBL,nID,ThisForm.nConnHandle,.T.,cFrom,cWhy)
				*PARAMETER pTBL, pID, pConnHandle, plForceDelete,pFrom,pWhy
				*SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
			
				WAIT WINDOW 'Complete' TIMEOUT 1
				MESSAGEBOX("Deleted",0,"Done")
				
				ThisForm.Load_Inventory_Due_In(nID2)
				ThisForm.Refresh_Screen()
				ThisForm.grdStk_MID.SetFocus()
				
			ELSE
				WAIT WINDOW 'Failed to remove'
			ENDIF
		ELSE
		
		ENDIF
	ENDPROC

	PROCEDURE cmdDone.Click
		
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdID_GO.Click
		PRIVATE nSTK_ID, nCurrID
		nSTK_ID = PrepareSQLnum(ThisForm.txtStk_ID.Value,'ID',-3)
		nCurrID = Stock_DI.SM_ID
		
		IF nStk_ID > 0
			SELECT Stock_DI
			LOCATE FOR SM_ID=nStk_ID
			IF FOUND('Stock_DI')
				ThisForm.grdSTK_MID.Refresh
				ThisForm.Refresh_Screen()
			ELSE
				LOCATE FOR SM_ID=nCurrID 
				MESSAGEBOX(ALLTRIM(STR(nStk_ID ))+" ID not found",0,"Not found",5)
				
			ENDIF
		ENDIF
	ENDPROC

