	PROCEDURE refreshsd_id_lot
		*!*	PARAMETERS cLot
		
		*!*	*ThisForm.RefreshSD_ID_Lot(cLot)
		*!*	IF USED('tmpSD_Lot')
		*!*		USE IN tmpSD_Lot
		*!*	ENDIF
		
		*!*	PRIVATE cSQL, nSQLEXEC 
		
		*!*	SELECT 0
		
		*!*	cSQL = "SELECT DISTINCT StockLst_ID"
		*!*	*cSQL = cSQL+",StockLst_ID_Detail "
		*!*	cSQL = cSQL+" FROM dbo.Sales_Detail SD WITH(NOLOCK) "
		*!*	cSQL = cSQL+" WHERE Lot = '"+cLot+"'"
		*!*	cSQL = cSQL+" ORDER BY StockLst_ID DESC "
		
		
		*!*	nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSD_Lot')
		*!*	DO WHILE nSQLEXEC = 0
		*!*		WAIT WINDOW 'SQL' TIMEOUT 1
		*!*		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSD_Lot')
		*!*	ENDDO
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSD_Lot')
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSD_Lot')
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF
		*!*	IF nSQLEXEC < 0
		*!*		SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpSD_Lot' )
		*!*	ENDIF
		
		*!*	ThisForm.txtSD_ID_Master.Value	= 0
		*!*	ThisForm.txtSD_ID_Detail.Value	= 0
		
		
		*!*	ThisForm.lblSD_ID_Lot.Visible = .F.
		
		*!*	ThisForm.lblSeeAllID.Visible = .F.
		*!*	ThisForm.lblSaveIDDetailRecv.Visible = .F.
		*!*	ThisForm.lblSaveIDDetailWOD.Visible = .F.
		
		*!*	PRIVATE nStockLst_ID 
		*!*	IF USED('tmpSD_Lot')
		*!*		IF RECCOUNT('tmpSD_Lot')>0
		*!*			SELECT tmpSD_Lot 
		*!*			*GO TOP
		*!*			IF RECCOUNT('tmpSD_Lot')>0
		*!*				nStockLst_ID = PrepareSQLnum(tmpSD_Lot.StockLst_ID,"StockLst_ID",-3)	
		*!*				IF nStockLst_ID > 0
		*!*					ThisForm.txtSD_ID_Master.Value = nStockLst_ID 
		*!*					ThisForm.txtSD_ID_Master.SetFocus
		*!*				
		*!*					*ThisForm.txtSD_ID_Detail.Value = PrepareSQLnum(tmpSD_Lot.StockLst_ID_Detail,"ID_Detail",-3)
		*!*					
		*!*					
		*!*					*cmbSD_ID_Lot
		*!*					DIMENSION aGroup_ID(1)
		*!*					SELECT DISTINCT StockLst_ID ;
		*!*					 FROM tmpSD_Lot;
		*!*					 ORDER BY StockLst_ID DESC;
		*!*					 INTO ARRAY aGroup_ID
		*!*					
		*!*					* ORDER BY StockLst_ID DESC
		*!*					
		*!*					ThisForm.cmbSD_ID_Lot.Visible = .T.
		*!*					ThisForm.cmbSD_ID_Lot.NumberOfElements = ALEN(aGroup_ID,1)
		*!*					ThisForm.cmbSD_ID_Lot.Value = 1	&&nStockLst_ID 
		
		*!*					ThisForm.lblSD_ID_Lot.Visible = .T.
		*!*					ThisForm.lblSeeAllID.Visible = .T.
		*!*					
		*!*					IF PrepareSQLnum(ThisForm.txtR_ID.Value,'RID',-3) > 0
		*!*						ThisForm.lblSaveIDDetailRecv.Visible = .T.
		*!*					ENDIF
		*!*					IF PrepareSQLnum(ThisForm.txtWD_WO_Detail.Value,'WO_Detail',-3) > 0
		*!*						ThisForm.lblSaveIDDetailWOD.Visible = .T.
		*!*					ENDIF
		*!*				ENDIF
		*!*			ENDIF
		*!*			
		*!*			USE IN tmpSD_Lot 
		*!*		ELSE
		*!*			MESSAGEBOX("No Lot '"+ALLTRIM(cLot)+"' found in Sales Detail",0,"Not Found")
		*!*		ENDIF
		*!*	ELSE
		*!*		MESSAGEBOX("No Lot '"+ALLTRIM(cLot)+"' found in Sales Detail",0,"Not Found")
		*!*	ENDIF
		*!*		
	ENDPROC

	PROCEDURE refresh_rh_id
		PARAMETERS cR_Heat
		*ThisForm.Refresh_RH_ID(cR_Heat)
		
		PRIVATE nRL_ID
		nRL_ID = 0
		
		IF USED('tmpRL_ID')
			USE IN tmpRL_ID
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT ID "
		cSQL = cSQL+" FROM dbo.StockLst_Master "
		cSQL = cSQL+" WHERE Heat='"+cR_Heat+"'"
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRL_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRL_ID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRL_ID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRL_ID')
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpRL_ID' )
		ENDIF
		
		
		
		IF USED('tmpRL_ID')
			IF RECCOUNT('tmpRL_ID') > 0
				nRL_ID = tmpRL_ID.ID
			ENDIF
			USE IN tmpRL_ID
		ENDIF
		
		RETURN nRL_ID
	ENDPROC

	PROCEDURE refresh_rl_id
		PARAMETERS cR_Lot
		*ThisForm.Refresh_RL_ID(cR_Lot)
		
		PRIVATE nRL_ID
		nRL_ID = 0
		
		IF USED('tmpRL_ID')
			USE IN tmpRL_ID
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT ID "
		cSQL = cSQL+" FROM dbo.StockLst_Master "
		cSQL = cSQL+" WHERE dbo.f_ProperLot(Lot)=dbo.f_ProperLot('"+ALLTRIM(cR_Lot)+"')"
		cSQL = cSQL+" UNION "
		cSQL = "SELECT ID "
		cSQL = cSQL+" FROM dbo.Ar_Stocklst_Master_History  "
		cSQL = cSQL+" WHERE dbo.f_ProperLot(Lot)=dbo.f_ProperLot('"+ALLTRIM(cR_Lot)+"')"
		cSQL = cSQL+" AND [What] = 'DELETE    '"
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRL_ID')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpRL_ID')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRL_ID')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpRL_ID')
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpRL_ID' )
		ENDIF
		
		
		
		IF USED('tmpRL_ID')
			IF RECCOUNT('tmpRL_ID') > 0
				nRL_ID = tmpRL_ID.ID
			ENDIF
			USE IN tmpRL_ID
		ENDIF
		
		
		RETURN nRL_ID
	ENDPROC

	PROCEDURE refresh_screen
		*ThisForm.Refresh_Screen()
		
		SELECT Stock_DI
		
		ThisForm.txtSM_ID.Value 	= PrepareSQLnum(Stock_DI.SM_ID,'SM_ID',-3)
		ThisForm.txtSD_ID.Value 	= PrepareSQLnum(Stock_DI.SD_ID,'SD_ID',-3)
		ThisForm.txtR_ID.Value		= PrepareSQLnum(Stock_DI.R_ID,'R_ID',-3)
		ThisForm.txtR2_ID.Value		= PrepareSQLnum(Stock_DI.R2_ID,'R_ID',-3)
		
		ThisForm.txtAlloy.Value		= ShowSQLtxt(Stock_DI.Alloy,'Alloy',12)
		ThisForm.txtForm.Value		= ShowSQLtxt(Stock_DI.Form,'Form',2)
		ThisForm.txtMill.Value		= ShowSQLtxt(Stock_DI.Mill,'Mill',10)
		
		ThisForm.txtDescriptID.Value = ShowSQLtxt(Stock_DI.DescriptID,'DescriptID',25)
		Thisform.txtStkDate.Value	= IIF(ISNULL(Stock_DI.SMI_When),'',Stock_DI.SMI_When)
		Thisform.txtHistory.Value	= ShowSQLtxt(Stock_DI.History,'History',20)
		
		ThisForm.txtSM_Heat.Value	= ShowSQLtxt(Stock_DI.SM_Heat,'Heat',50)
		ThisForm.txtSD_Heat.Value	= ShowSQLtxt(Stock_DI.SD_Heat,'Heat',50)
		ThisForm.txtR_Heat.Value	= ShowSQLtxt(Stock_DI.R_Heat,'Heat',50)
		ThisForm.txtR2_Heat.Value	= ShowSQLtxt(Stock_DI.R2_Heat,'Heat',50)
		
		ThisForm.txtSM_Lot.Value	= ShowSQLtxt(Stock_DI.SM_Lot,'Lot',10)
		Thisform.txtSD_Lot.Value	= ShowSQLtxt(Stock_DI.SD_Lot,'Lot',10)
		Thisform.txtR_Lot.Value		= ShowSQLtxt(Stock_DI.R_Lot,'Lot',10)
		Thisform.txtR2_Lot.Value	= ShowSQLtxt(Stock_DI.R2_Lot,'Lot',10)
		
		ThisForm.txtR_WO_Detail.Value 	= PrepareSQLnum(Stock_DI.R_WO_Detail,'WO_Detail',-3)
		ThisForm.txtR2_WO_Detail.Value 	= PrepareSQLnum(Stock_DI.R2_WO_Detail,'WO_Detail',-3)
		
		ThisForm.txtR_ID_Master.Value	= PrepareSQLnum(Stock_DI.R_ID_Master,'ID_Master',-3)
		ThisForm.txtR2_ID_Master.Value	= PrepareSQLnum(Stock_DI.R2_ID_Master,'ID_Master',-3)
		
		ThisForm.txtR_ID_Detail.Value	= PrepareSQLnum(Stock_DI.R_ID_Detail,'ID_Detail',-3)
		ThisForm.txtR2_ID_Detail.Value	= PrepareSQLnum(Stock_DI.R2_ID_Detail,'ID_Detail',-3)
		
		ThisForm.chkP_Cmplt.Value		= PrepareSQLchk(Stock_DI.P_Cmplt,'P_Cmplt',.F.)
		ThisForm.chkP_Cancelled.Value	= PrepareSQLchk(Stock_DI.P_Cancelled,'Cancelled',.F.)
		ThisForm.lblPOitem.Caption		= PrepareSQLtxt(Stock_DI.POItem,'POitem',12)
		ThisForm.chkP_Services.Value	= PrepareSQLchk(Stock_DI.P_Services,'Services',.F.)
		ThisForm.chkP_ConvServ.Value	= PrepareSQLchk(Stock_DI.P_ConvServ,'ConvServ',.F.)
		ThisForm.chkP_Equipment.Value	= PrepareSQLchk(Stock_DI.P_Equipment,'Equipment',.F.)
		
		ThisForm.txtSD_RID.Value		= PrepareSQLnum(Stock_DI.SD_RID,'RID',-3)
		
		ThisForm.txtStockTable.Value	= ShowSQLtxt(Stock_DI.R_TBL,'TBL',1)
		ThisForm.txtStockTable2.Value	= ShowSQLtxt(Stock_DI.R2_TBL,'TBL',1)
		
		ThisForm.txtMWeight.Value	= PrepareSQLnum(Stock_DI.MWeight,'Weight',-3)
		ThisForm.txtR_R_QTY .Value	= PrepareSQLnum(Stock_DI.R_R_QTY,'R_QTY ',-3)
		ThisForm.txtR2_R_QTY .Value	= PrepareSQLnum(Stock_DI.R2_R_QTY,'R_QTY ',-3)
		ThisForm.txtSD_S_QTY .Value	= PrepareSQLnum(Stock_DI.SD_S_QTY,'S_QTY',-3)
		*SD_Weight
		
		IF ThisForm.txtR_ID.Value>0 
			*Enable Recv
			ThisForm.txtR_Heat.Enabled = .T.
			ThisForm.txtR_Lot.Enabled = .T.
			ThisForm.txtR_ID_Master.Enabled = .T.
			ThisForm.txtR_ID_Detail.Enabled = .T.
			ThisForm.txtR_WO_Detail.Enabled = .T.
			ThisForm.txtR_R_QTY.Enabled = .T.
			ThisForm.txtR_ID.Enabled = .T.
		ELSE
			ThisForm.txtR_Heat.Enabled = .F.
			ThisForm.txtR_Lot.Enabled = .F.
			ThisForm.txtR_ID_Master.Enabled = .F.
			ThisForm.txtR_ID_Detail.Enabled = .F.
			ThisForm.txtR_WO_Detail.Enabled = .F.
			ThisForm.txtR_R_QTY.Enabled = .F.
			ThisForm.txtR_ID.Enabled = .F.
		ENDIF	
			
		IF ThisForm.txtR2_ID.Value>0 
			*Enable Recv
			ThisForm.txtR2_Heat.Enabled = .T.
			ThisForm.txtR2_Lot.Enabled = .T.
			ThisForm.txtR2_ID_Master.Enabled = .T.
			ThisForm.txtR2_ID_Detail.Enabled = .T.
			ThisForm.txtR2_WO_Detail.Enabled = .T.
			ThisForm.txtR2_R_QTY.Enabled = .T.
			ThisForm.txtR2_ID.Enabled = .T.
		ELSE
			ThisForm.txtR2_Heat.Enabled = .F.
			ThisForm.txtR2_Lot.Enabled = .F.
			ThisForm.txtR2_ID_Master.Enabled = .F.
			ThisForm.txtR2_ID_Detail.Enabled = .F.
			ThisForm.txtR2_WO_Detail.Enabled = .F.
			ThisForm.txtR2_R_QTY.Enabled = .F.
			ThisForm.txtR2_ID.Enabled = .F.
		ENDIF	
		
		IF ThisForm.txtSD_ID.Value > 0
			*enable SD
			ThisForm.txtSD_Heat.Enabled = .T.
			ThisForm.txtSD_S_QTY.Enabled = .T.
			ThisForm.txtSD_RID.Enabled = .T.
			ThisForm.txtSD_ID.Enabled = .T.
		ELSE
			ThisForm.txtSD_Heat.Enabled = .F.
			ThisForm.txtSD_S_QTY.Enabled = .F.
			ThisForm.txtSD_RID.Enabled = .F.
			ThisForm.txtSD_ID.Enabled = .F.
		ENDIF		
		
		
		ThisForm.lblSeeAllID.Visible = .F.
		ThisForm.grdSD_ID_Lot.Visible = .F.
		ThisForm.lblSaveIDDetailRecv.Visible = .F.
		ThisForm.lblSaveIDDetailWOD.Visible = .F.
		
		*Shows the Counts
		ThisForm.Count_ID_Detail( PrepareSQLnum(Stock_DI.SM_ID,'SM_ID',-3) )
		ThisForm.Show_SOitem( PrepareSQLtxt(Stock_DI.P_SOitem,'SOitem',10) )
		
		ThisForm.txtSD_ID_Master.Value	= 0
		ThisForm.txtSD_ID_Detail.Value	= ThisForm.Count_ID_Detail( PrepareSQLnum(Stock_DI.SM_ID,'SM_ID',-3) )
		
		ThisForm.lblSeeAllID.Visible = .F.
		ThisForm.lblSaveIDDetailRecv.Visible = .F.
		ThisForm.lblSaveIDDetailWOD.Visible = .F.
		
		ThisForm.Load_Duplicates()
		
		
		
	ENDPROC

	PROCEDURE refresh_sd_id_bylot
		PARAMETERS cLot
		*ThisForm.Refresh_SD_ID_byLot(cLot)
		
		ThisForm.grdSD_ID_Lot.Visible = .F.
		IF USED('tmpSD_ID_Lot')
			ThisForm.grdSD_ID_Lot.RecordSource = ''
			USE IN tmpSD_ID_Lot
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT "
		cSQL = cSQL+"( SELECT Count(*) FROM Sales_Detail WITH(NOLOCK) WHERE StockLst_ID = t.StockLst_ID ) AS CNT"
		cSQL = cSQL+" , t.StockLst_ID AS ID "
		cSQL = cSQL+" , (SELECT TOP 1 StockLst_ID_Detail FROM Sales_Detail WITH(NOLOCK) WHERE StockLst_ID = t.StockLst_ID ) AS ID_Detail"
		cSQL = cSQL+" , ISNULL((SELECT TOP 1 SOitem FROM Sales_Detail WITH(NOLOCK) WHERE StockLst_ID = t.StockLst_ID AND SOitem IS NOT NULL ),'') AS SOitem"
		cSQL = cSQL+" FROM ( "
		cSQL = cSQL+" SELECT DISTINCT StockLst_ID "
		cSQL = cSQL+"  FROM dbo.Sales_Detail SD WITH(NOLOCK) "
		cSQL = cSQL+" WHERE Lot = '"+cLot+"'"
		cSQL = cSQL+"  ) t "
		cSQL = cSQL+" ORDER BY CNT DESC, StockLst_ID "
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSD_ID_Lot')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSD_ID_Lot')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSD_ID_Lot')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSD_ID_Lot')
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpSD_ID_Lot' )
		ENDIF
		
		ThisForm.txtSD_ID_Master.Value	= 0
		ThisForm.txtSD_ID_Detail.Value	= 0
		
		
		*ThisForm.lblSD_ID_Lot.Visible = .F.
		
		ThisForm.lblSeeAllID.Visible = .F.
		ThisForm.lblSaveIDDetailRecv.Visible = .F.
		ThisForm.lblSaveIDDetailRecv2.Visible = .F.
		ThisForm.lblSaveIDDetailWOD.Visible = .F.
		
		PRIVATE nStockLst_ID 
		IF USED('tmpSD_ID_Lot')
			IF RECCOUNT('tmpSD_ID_Lot')>0
				SELECT tmpSD_ID_Lot 
				*GO TOP
				IF RECCOUNT('tmpSD_ID_Lot')>0
					nStockLst_ID = PrepareSQLnum(tmpSD_ID_Lot.ID,"StockLst_ID",-3)	
					IF nStockLst_ID > 0
						ThisForm.txtSD_ID_Master.Value = tmpSD_ID_Lot.ID
						ThisForm.txtSD_ID_Detail.Value = tmpSD_ID_Lot.ID_Detail
		
					
						ThisForm.grdSD_ID_Lot.Visible = .T.
						ThisForm.grdSD_ID_Lot.RecordSource = 'tmpSD_ID_Lot'
						
						ThisForm.txtSD_ID_Detail.Value = PrepareSQLnum(tmpSD_ID_Lot.ID_Detail,"ID_Detail",-3)
						*ThisForm.lblSD_ID_Lot.Visible = .T.
						ThisForm.lblSeeAllID.Visible = .T.
						ThisForm.lblSeeAllID.Visible = .F.
		
						IF PrepareSQLnum(ThisForm.txtR_ID.Value,'RID',-3) > 0
							ThisForm.lblSaveIDDetailRecv.Visible = .T.
						ENDIF
						IF PrepareSQLnum(ThisForm.txtR2_ID.Value,'RID',-3) > 0
							ThisForm.lblSaveIDDetailRecv2.Visible = .T.
						ENDIF
						IF PrepareSQLnum(ThisForm.txtWD_WO_Detail.Value,'WO_Detail',-3) > 0
							ThisForm.lblSaveIDDetailWOD.Visible = .T.
						ENDIF
						
					ENDIF
				ENDIF
				
				*USE IN tmpSD_ID_Lot 
			ELSE
				MESSAGEBOX("No Lot '"+ALLTRIM(cLot)+"' found in Sales Detail",0,"Not Found")
			ENDIF
		ELSE
			MESSAGEBOX("No Lot '"+ALLTRIM(cLot)+"' found in Sales Detail",0,"Not Found")
		ENDIF
			
	ENDPROC

