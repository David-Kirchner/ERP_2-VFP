	PROCEDURE lblSaveIDDetailWOD.Click
		PRIVATE nID, nID_Detail, nWO_Detail, nfReceivingID 
		nID = PrepareSQLnum(ThisForm.txtSD_ID_Master.Value,'Master_ID',-3)
		nID_Detail = PrepareSQLnum(ThisForm.txtSD_ID_Detail.Value,'ID_Detail',-3)
		nfReceivingID = Get_ReceivingID_from_ID_Detail( nID_Detail, 'S', ThisForm.nConnHandle )
		*nReceiveID = Get_ReceivingID_from_ID_Detail('S',nID_Detail,
		
		nWO_Detail = PrepareSQLnum(ThisForm.txtWD_WO_Detail.Value,'WO_Detail',-3)
		
		PRIVATE lOK, nID_Detail 
		lOK = .T.
		
		IF nID*nWO_Detail > 0
			
		
			IF nID_Detail < 1
				RETURN 
			ENDIF
			
			IF USED('tmpUpdt_Rcv')
				USE IN tmpUpdt_Rcv
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC 
		
			SELECT 0
			cSQL = "UPDATE dbo.WorkOrder_Detail "
			cSQL = cSQL+" SET fID_Detail ="+STR(nID_Detail)
			IF nfReceivingID > 0
				cSQL = cSQL+" ,fReceivingID ="+STR(nfReceivingID)
			ENDIF
			cSQL = cSQL+" WHERE WO_Detail = "+STR(nWO_Detail)
		
		
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpUpdt_Rcv' )
				lOK = .F.
			ENDIF
			
			IF lOK
				cSQL = "SELECT fID_Detail, fReceivingID "
				cSQL = cSQL+" FROM dbo.WorkOrder_Detail "
				cSQL = cSQL+" WHERE WO_Detail = "+STR(nWO_Detail)
		
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpUpdt_Rcv')
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpUpdt_Rcv' )
					lOK = .F.
				ENDIF
				
				
				IF USED('tmpUpdt_Rcv')
					SELECT tmpUpdt_Rcv 
					IF RECCOUNT('tmpUpdt_Rcv')>0
						nID_Detail = PrepareSQLnum(tmpUpdt_Rcv.fID_Detail,"ID_Detail",-3)	
						IF nID_Detail > 0
							ThisForm.txtWD_fID.Value = nID
							ThisForm.txtWD_fID.Refresh
							
							ThisForm.txtfID_Detail.Value = nID_Detail 				
							ThisForm.txtfID_Detail.Refresh
							
							ThisForm.txtfReceivingID.Value = PrepareSQLnum(tmpUpdt_Rcv.fReceivingID,"RID",-3)	
							ThisForm.txtfReceivingID.Refresh
							MESSAGEBOX("Saved",0,"SQL")
						ENDIF
					ELSE
						MESSAGEBOX("Did not Save",0,"Did not Save.")
					ENDIF
					
					USE IN tmpUpdt_Rcv 
				ELSE
					MESSAGEBOX("Did not Save",0,"Did not Save.")
				ENDIF
			ENDIF		
		ELSE
			MESSAGEBOX("Bad ID and WO_Detail",0,"No work")
		ENDIF
	ENDPROC

	PROCEDURE lblSeeAllID.Click
		PRIVATE nID, nCount, nCountTot
		
		PRIVATE nCurrID
		IF USED('tmpSD_ID_Lot')
			nCurrID = tmpSD_ID_Lot.ID
			GO TOP
			SCAN
				PRIVATE m.loHyperlink,m.cHyperLink
				m.cHyperLink = HTML_Stock_ID('S',tmpSD_ID_Lot.ID,.T.)
				m.loHyperlink = CREATEOBJECT("Hyperlink")
				m.loHyperlink.navigateto(m.cHyperLink)
				RELEASE m.loHyperlink
				
				
			ENDSCAN
			LOCATE FOR StockLst_ID = nCurrID 
			
			ThisForm.txtSD_ID_Master.Value = tmpSD_ID_Lot.ID
			ThisForm.txtSD_ID_Detail.Value = tmpSD_ID_Lot.ID_Detail
		ENDIF	
		
	ENDPROC

	PROCEDURE lblSeeAllID.DblClick
		PRIVATE nID, nCount, nCountTot
		
		*!*	nCount = 1
		*!*	nCountTot = ALEN(aGroup_ID,1)
		
		*!*	DO WHILE nCount <= nCountTot 
		
		*!*		nID = aGroup_ID(nCount)
		
		*!*		IF nID > 0
		
		PRIVATE nCurrID
		IF USED('tmpSD_ID_Lot')
			nCurrID = tmpSD_ID_Lot.ID
			GO TOP
			SCAN
				PRIVATE m.loHyperlink,m.cHyperLink
				m.cHyperLink = HTML_Stock_ID('S',tmpSD_ID_Lot.ID,.T.)
				m.loHyperlink = CREATEOBJECT("Hyperlink")
				m.loHyperlink.navigateto(m.cHyperLink)
				RELEASE m.loHyperlink
				
				
			ENDSCAN
			LOCATE FOR StockLst_ID = nCurrID 
		ENDIF	
				*WAIT WINDOW "Look for a blinking Internet Explorer to see the report! - This can take time!" NOWAIT
		*!*		ENDIF
		*!*		
		*!*		nCount = nCount + 1
		*!*	ENDDO
		
	ENDPROC

