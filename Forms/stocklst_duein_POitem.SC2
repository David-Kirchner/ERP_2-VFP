	PROCEDURE count_id_detail
		PARAMETER nStockLst_ID
		*ThisForm.Count_ID_Detail(nStockLst_ID)
		
		IF USED('tmpCNT_ID_Detail')
			USE IN tmpCNT_ID_Detail
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT COUNT(ID_Detail) AS CNT "
		cSQL = cSQL+" FROM dbo.StockLst_Detail WITH(NOLOCK) WHERE ID="+STR(nStockLst_ID)
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCNT_ID_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCNT_ID_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_ID_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_ID_Detail')
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpCNT_ID_Detail' )
		ENDIF
		
		ThisForm.lblID_Detail_CNT.Caption = "CNT "
		IF USED('tmpCNT_ID_Detail')
			IF RECCOUNT('tmpCNT_ID_Detail')>0
				ThisForm.lblID_Detail_CNT.Caption = "CNT "+ALLTRIM(STR(PrepareSQLnum(tmpCNT_ID_Detail.CNT,"CNT",-3)	))
			ENDIF
			USE IN tmpCNT_ID_Detail
		ENDIF
		
		**********************************
		IF USED('tmpCNT_ID_D_P')
			USE IN tmpCNT_ID_D_P
		ENDIF
		SELECT 0
		
		cSQL = "SELECT COUNT(ID_Detail) AS CNT FROM dbo.StockLst_Process WITH(NOLOCK) "
		cSQL = cSQL+" WHERE ID_Detail IN "
		cSQL = cSQL+" (SELECT DISTINCT ID_Detail FROM dbo.StockLst_Detail WITH(NOLOCK) WHERE ID="+STR(nStockLst_ID)+")"
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCNT_ID_D_P')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpCNT_ID_D_P')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_ID_D_P')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCNT_ID_D_P')
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'tmpCNT_ID_D_P' )
		ENDIF
		
		
		ThisForm.lblProcess_CNT.Caption = "CNT "
		ThisForm.lblProcess_CNT.BackColor=RGB(240,240,240)
		
		IF USED('tmpCNT_ID_D_P')
			IF RECCOUNT('tmpCNT_ID_D_P')>0
				ThisForm.lblProcess_CNT.Caption = "CNT "+ALLTRIM(STR(PrepareSQLnum(tmpCNT_ID_D_P.CNT,"CNT",-3)	))
				IF PrepareSQLnum(tmpCNT_ID_D_P.CNT,"CNT",-3) > 0
					ThisForm.lblProcess_CNT.BackColor=RGB(240,0,0)
				ENDIF
			ENDIF
			USE IN tmpCNT_ID_D_P
		ENDIF
		
		
		SELECT Stock_DI
	ENDPROC

	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		
		
		ThisForm.Load_Inventory_Due_In(0)
		ThisForm.Refresh_Screen()
		
		
	ENDPROC

	PROCEDURE Load
		SET TALK OFF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE load_duplicates
		*ThisForm.Load_Duplicates()
		*Refresh when Due In ID_Master has changed
		
		ThisForm.RefreshGroup_ID()
		
		
		PRIVATE nSM_ID, nWD_fID, nR_ID_Master
		nSM_ID		= PrepareSQLnum(Stock_DI.SM_ID,'SM_ID',-3)
		*nWD_fID		= PrepareSQLnum(Stock_DI.WD_fID,'ID',-3)
		nR_ID_Master= PrepareSQLnum(Stock_DI.R_ID_Master,'ID_Master',-3)
		
		*********** check for other SM IDs
		*IF nWD_fID > 0 AND nWD_fID <> nSM_ID
		*	*look at SM for this other nWD_fID 
		*	*ThisForm.SearchSM_WD_fID(nWD_fID)
		*	IF ThisForm.Search_ID_Master(nWD_fID) > 0
		*		ThisForm.txtWD_fID.ForeColor = RGB(0,0,255)
		*	ENDIF
		*ENDIF
		IF nR_ID_Master > 0 AND nR_ID_Master <> nSM_ID &&AND nR_ID_Master<> nWD_fID 
			*look at SM for this other nR_ID_Master
			IF ThisForm.Search_ID_Master(nR_ID_Master) > 0
				ThisForm.txtR_ID_Master.ForeColor = RGB(0,0,255)
			ENDIF
		ENDIF
		*********** check for SM ID History
		IF nSM_ID> 0 
			*look at SMH for this nSM_ID
		ENDIF
		*IF nWD_fID > 0 
		*	*look at SMH for this nWD_fID 
		*ENDIF
		IF nR_ID_Master > 0 
			*look at SMH for this nR_ID_Master
		ENDIF
		
		
		***********************************************
		
		PRIVATE cSM_Heat, cWO_Heat, cWDfHeat, cSD_Heat, cR_Heat
		cSM_Heat	= ShowSQLtxt(Stock_DI.SM_Heat,'Heat',50)
		*cWO_Heat	= ShowSQLtxt(Stock_DI.WO_Heat,'Heat',50)
		*cWDfHeat	= ShowSQLtxt(Stock_DI.fHeat,'Heat',50)
		cSD_Heat	= ShowSQLtxt(Stock_DI.SD_Heat,'Heat',50)
		cR_Heat		= ShowSQLtxt(Stock_DI.R_Heat,'Heat',50)
		cR2_Heat	= ShowSQLtxt(Stock_DI.R2_Heat,'Heat',50)
		
		*ThisForm.txtRH_ID.Value = 0
		*ThisForm.txtRH_ID_Detail.Value = 0
		
		*********** check for other SM Heat
		*IF LEN(cWO_Heat) > 0 AND cWO_Heat <> cSM_Heat
		*	*look at SM for this other Heat cWO_Heat
		*ENDIF
		*IF LEN(cWDfHeat) > 0 AND cWDfHeat <> cSM_Heat AND cWO_Heat <> cSM_Heat
		*	*look at SM for this other Heat cWDfHeat
		*ENDIF
		*IF LEN(cWDfHeat) > 0 AND cWDfHeat <> cSM_Heat AND cWDfHeat<> cSM_Heat AND cWO_Heat <> cSM_Heat
		*	*look at SM for this other Heat cWDfHeat
		*ENDIF
		IF LEN(cSD_Heat) > 0 AND cSD_Heat <> cSM_Heat &&AND cWDfHeat <> cSM_Heat AND cWDfHeat<> cSM_Heat AND cWO_Heat <> cSM_Heat
			*look at SM for this other Heat cSD_Heat
		ENDIF
		IF LEN(cR_Heat) > 0 AND IIF(LEN(cSM_Heat)>0, cR_Heat <> cSM_Heat, .T.)
			*ThisForm.txtRH_ID.Value = Thisform.Refresh_RH_ID(cR_Heat)	
			*look at SM for this other Heat cR_Heat
		ENDIF
		IF LEN(cR2_Heat) > 0 AND IIF(LEN(cSM_Heat)>0, cR2_Heat <> cSM_Heat, .T.)
			*ThisForm.txtRH_ID.Value = Thisform.Refresh_RH_ID(cR_Heat)	
			*look at SM for this other Heat cR_Heat
		ENDIF
		
		***********************************************
		
		PRIVATE cSM_Lot, cWDfLot, cWDFinishLot, cR_Lot
		cSM_Lot		= ShowSQLtxt(Stock_DI.SM_Lot,'Lot',10)
		cSD_Lot		= ShowSQLtxt(Stock_DI.SD_Lot,'Lot',10)
		*cWDfLot		= ShowSQLtxt(Stock_DI.fLot,'Lot',10)
		*cWDFinishLot = ShowSQLtxt(Stock_DI.FinishLot,'Lot',10)
		cR_Lot		= ShowSQLtxt(Stock_DI.R_Lot,'Lot',10)
		cR2_Lot		= ShowSQLtxt(Stock_DI.R2_Lot,'Lot',10)
		
		*ThisForm.txtRL_ID.Value = 0
		*ThisForm.txtWDL_ID.Value = 0
		*ThisForm.txtWDfL_ID.Value = 0
		
		*********** check for other SM Lot cSM_Lot
		IF LEN(cSM_Lot) > 0
			*look at SM for other records with this lot
		ENDIF
		*IF LEN(cWDfLot) > 0 AND IIF(LEN(cSM_Lot)>0,cWDfLot <> cWDfLot,.T.)
		*	*look at SM for other records with this lot cWDfLot
		*	ThisForm.txtWDL_ID.Value = Thisform.Refresh_RL_ID(cWDfLot)
		*ENDIF
		*IF LEN(cWDFinishLot) > 0 AND IIF(LEN(cSM_Lot)>0,cWDFinishLot <> cSM_Lot,.T.)
		*	*look at SM for other records with this lot cWDFinishLot 
		*	ThisForm.txtWDfL_ID.Value = Thisform.Refresh_RL_ID(cWDFinishLot)
		*ENDIF
		IF LEN(cR_Lot) > 0 AND IIF(LEN(cSM_Lot)>0,cR_Lot <> cSM_Lot,.T.)
			*look at SM for other records with this lot cR_Lot
			ThisForm.txtRL_ID.Value = Thisform.Refresh_RL_ID(cR_Lot)
		ENDIF
		IF LEN(cR2_Lot) > 0 AND IIF(LEN(cSM_Lot)>0,cR2_Lot <> cSM_Lot,.T.)
			*look at SM for other records with this lot cR_Lot
			ThisForm.txtRL_ID.Value = Thisform.Refresh_RL_ID(cR2_Lot)
		ENDIF
		
		***********************************************
		
		
		PRIVATE nSM_WO_Detail, nWD_WO_Detail, nR_WO_Detail
		*nSM_WO_Detail	= PrepareSQLnum(Stock_DI.SM_WO_Detail,'WO_Detail',-3)
		*nWD_WO_Detail	= PrepareSQLnum(Stock_DI.WD_WO_Detail,'WO_Detail',-3)
		nR_WO_Detail	= PrepareSQLnum(Stock_DI.R_WO_Detail,'WO_Detail',-3)
		nR2_WO_Detail	= PrepareSQLnum(Stock_DI.R2_WO_Detail,'WO_Detail',-3)
		
		*********** check for other SM WO_Detail
		*IF nWD_WO_Detail > 0 AND nWD_WO_Detail <> nSM_WO_Detail
		*	*look at SM for this nWD_WO_Detail 
		*ENDIF
		IF nR_WO_Detail > 0 
			*look at SM for this nR_WO_Detail 
		ENDIF
		IF nR2_WO_Detail > 0 
			*look at SM for this nR_WO_Detail 
		ENDIF
		
		***********************************************
		
		
		
	ENDPROC

	PROCEDURE load_inventory_due_in
		PARAMETERS nNum
		*ThisForm.Load_Inventory_Due_In(0)
		
		IF USED('Stock_DI')
			ThisForm.grdStk_MID.RecordSource = ''
			
			SELECT Stock_DI
			SET FILTER TO
			
			USE IN Stock_DI
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC 
		
		SELECT 0
		
		cSQL = "SELECT SM.ID AS SM_ID, SM.Alloy, SM.Form, SM.Heat AS SM_Heat "
		cSQL = cSQL+", SM.Mill, SM.History, SM.WO_Detail AS SM_WO_Detail, SM.MWeight "
		cSQL = cSQL+", SM.DescriptID, SM.Lot AS SM_Lot"
		cSQL = cSQL+", SMI.[When] AS SMI_When "
		
		cSQL = cSQL+", SD.ID AS SD_ID, SD.Weight AS SD_Weight, SD.S_QTY AS SD_S_QTY "
		cSQL = cSQL+",(SELECT TOP 1 Heat FROM dbo.Sales_Detail WITH(NOLOCK) WHERE PO_item = SM.PO_item) as SD_Heat "
		cSQL = cSQL+",(SELECT TOP 1 Lot FROM dbo.Sales_Detail WITH(NOLOCK) WHERE PO_item = SM.PO_item) as SD_Lot "
		cSQL = cSQL+", SD.ReceivingID AS SD_RID, SD.ID_Detail AS SD_ID_Detail"
		
		cSQL = cSQL+", (SELECT TOP 1 ID FROM dbo.Receiving R WITH(NOLOCK) WHERE SM.PO_item = R.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS R_ID "
		cSQL = cSQL+", (SELECT TOP 1 ID_Master FROM dbo.Receiving R WITH(NOLOCK) WHERE SM.PO_item = R.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS R_ID_Master "
		cSQL = cSQL+", (SELECT TOP 1 ID_Detail FROM dbo.Receiving R WITH(NOLOCK) WHERE SM.PO_item = R.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS R_ID_Detail "
		cSQL = cSQL+", (SELECT TOP 1 R_QTY FROM dbo.Receiving R WITH(NOLOCK) WHERE SM.PO_item = R.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS R_R_QTY "
		cSQL = cSQL+", (SELECT TOP 1 Heat FROM dbo.Receiving R WITH(NOLOCK) WHERE SM.PO_item = R.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS R_Heat "
		cSQL = cSQL+", (SELECT TOP 1 Lot FROM dbo.Receiving R WITH(NOLOCK) WHERE SM.PO_item = R.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS R_Lot "
		cSQL = cSQL+", (SELECT TOP 1 StockTable FROM dbo.Receiving R WITH(NOLOCK) WHERE SM.PO_item = R.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS R_TBL "
		cSQL = cSQL+", (SELECT TOP 1 WO_Detail FROM dbo.Receiving R WITH(NOLOCK) WHERE SM.PO_item = R.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS R_WO_Detail "
		
		cSQL = cSQL+", (SELECT TOP 1 ID FROM dbo.Receiving R WITH(NOLOCK) WHERE SD.ReceivingID = R.ID AND ISNULL(SD.ReceivingID,0)>0  ) AS R2_ID "
		cSQL = cSQL+", (SELECT TOP 1 ID_Master FROM dbo.Receiving R WITH(NOLOCK) WHERE SD.ReceivingID = R.ID AND ISNULL(SD.ReceivingID,0)>0  ) AS R2_ID_Master "
		cSQL = cSQL+", (SELECT TOP 1 ID_Detail FROM dbo.Receiving R WITH(NOLOCK) WHERE SD.ReceivingID = R.ID AND ISNULL(SD.ReceivingID,0)>0 ) AS R2_ID_Detail "
		cSQL = cSQL+", (SELECT TOP 1 R_QTY FROM dbo.Receiving R WITH(NOLOCK) WHERE SD.ReceivingID = R.ID AND ISNULL(SD.ReceivingID,0)>0 ) AS R2_R_QTY "
		cSQL = cSQL+", (SELECT TOP 1 Heat FROM dbo.Receiving R WITH(NOLOCK) WHERE SD.ReceivingID = R.ID AND ISNULL(SD.ReceivingID,0)>0 ) AS R2_Heat "
		cSQL = cSQL+", (SELECT TOP 1 Lot FROM dbo.Receiving R WITH(NOLOCK) WHERE SD.ReceivingID = R.ID AND ISNULL(SD.ReceivingID,0)>0 ) AS R2_Lot "
		cSQL = cSQL+", (SELECT TOP 1 StockTable FROM dbo.Receiving R WITH(NOLOCK) WHERE SD.ReceivingID = R.ID AND ISNULL(SD.ReceivingID,0)>0 ) AS R2_TBL "
		cSQL = cSQL+", (SELECT TOP 1 WO_Detail FROM dbo.Receiving R WITH(NOLOCK) WHERE SD.ReceivingID = R.ID AND ISNULL(SD.ReceivingID,0)>0 ) AS R2_WO_Detail "
		
		*cSQL = cSQL+", (SELECT TOP 1 P.cmplt FROM dbo.PurchaseOrder P WITH(NOLOCK) WHERE SM.PO_item = P.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS P_Cmplt "
		*cSQL = cSQL+", (SELECT TOP 1 P.Cancelled FROM dbo.PurchaseOrder P WITH(NOLOCK) WHERE SM.PO_item = P.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS P_Cancelled "
		*cSQL = cSQL+", (SELECT TOP 1 P.Delivered FROM dbo.PurchaseOrder P WITH(NOLOCK) WHERE SM.PO_item = P.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS P_Delivered "
		
		*cSQL = cSQL+", (SELECT TOP 1 P.Services FROM dbo.PurchaseOrder P WITH(NOLOCK) WHERE SM.PO_item = P.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS P_Services "
		*cSQL = cSQL+", (SELECT TOP 1 P.ConvServ FROM dbo.PurchaseOrder P WITH(NOLOCK) WHERE SM.PO_item = P.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS P_ConvServ "
		*cSQL = cSQL+", (SELECT TOP 1 P.Equipment FROM dbo.PurchaseOrder P WITH(NOLOCK) WHERE SM.PO_item = P.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS P_Equipment "
		
		*cSQL = cSQL+", (SELECT TOP 1 SOitem FROM dbo.PurchaseOrder P WITH(NOLOCK) WHERE SM.PO_item = P.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')  ) AS P_SOitem "
		cSQL = cSQL+",P.cmplt AS P_Cmplt,P.Cancelled AS P_Cancelled,P.Delivered AS P_Delivered, P.POitem AS POitem "
		cSQL = cSQL+",P.Services AS P_Services,P.ConvServ AS P_ConvServ,P.Equipment AS P_Equipment,P.SOitem AS P_SOitem "
		
		cSQL = cSQL+" FROM dbo.StockLst_Master SM WITH(NOLOCK)"
		cSQL = cSQL+" inner join dbo.PurchaseOrder P WITH(NOLOCK) ON SM.PO_item = P.POitem AND SM.PO_item <> dbo.f_ProperPOitem('') "
		cSQL = cSQL+" inner join dbo.StockLst_Detail SD WITH(NOLOCK) ON SM.ID = SD.ID "
		cSQL = cSQL+" left outer join dbo.StockLst_Master_Inserted SMI WITH(NOLOCK) ON SM.ID = SMI.Master_ID "
		  
		*cSQL = cSQL+" FROM dbo.StockLst_Master SM WITH(NOLOCK) "
		*cSQL = cSQL+" inner join dbo.PurchaseOrder P WITH(NOLOCK) ON SM.PO_item = P.POitem AND SM.PO_item <> dbo.f_ProperPOitem('')"
		*cSQL = cSQL+" inner join dbo.StockLst_Detail SD WITH(NOLOCK) ON SM.ID = SD.ID "
		*cSQL = cSQL+" left outer join dbo.StockLst_Master SMI WITH(NOLOCK) ON SM.ID = SMI.ID "
		
		cSQL = cSQL+" WHERE SM.ID IN "
		cSQL = cSQL+" ( "
		cSQL = cSQL+" SELECT DISTINCT SM.ID "
		cSQL = cSQL+" FROM dbo.StockLst_Master SM WITH(NOLOCK) "
		cSQL = cSQL+" WHERE SM.Heat like 'Due In%' "
		cSQL = cSQL+" AND LEN(ISNULL(SM.PO_item,'')) > 0 "
		
		cSQL = cSQL+" ) "
		cSQL = cSQL+" ORDER BY SM.ID "
		
		
		
		
		nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Stock_DI')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Stock_DI')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Stock_DI')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Stock_DI')
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, 'Stock_DI' )
		ENDIF
		
		
		
		IF USED('Stock_DI')
			SELECT Stock_DI 
		
			IF nNum > 0
				LOCATE FOR SM_ID = nNum
			ENDIF
			
		*	IF ThisForm.cmdShowOnlyComplete.Caption = "Show only Complete"
		
		*IF ThisForm.Show_complete
		*	SET FILTER TO fCmplt = ThisForm.Show_complete
		*	ELSE
		*	
		*ENDIF
		
		*	INDEX ON alloy+form+CC TAG 'alloyformC' &&OF Stock_DI 
		*	TRY	
		*		SET ORDER TO TAG 'PriceT' OF Stock_DI 
		*	CATCH
		*		MESSAGEBOX("Error with Index",0+16,"Error")
		*	ENDTRY
			
		*	GO TOP
			ThisForm.Visible = .T.
			
			*ThisForm.grdStk_MID.ColumnCount = 1
			
			ThisForm.grdStk_MID.StockID.ControlSource = Stock_DI.SM_ID
			ThisForm.grdStk_MID.StockID.Header1.Caption = "Stk ID"
			ThisForm.grdStk_MID.RecordSource = 'Stock_DI'
		
			ThisForm.grdStk_MID.Refresh
			*ThisForm.Refresh_Screen()
			ThisForm.Show_Cmplt_btn()
			
			PRIVATE cRec
			cRec = ALLTRIM(STR( RECCOUNT('Stock_DI') ))
			cRec = "Records " + cRec
			ThisForm.lblRecords.Caption = cRec 
			
		ELSE
			MESSAGEBOX('Failed to load Stock_DI',0+16,"Error")
			RETURN .F.	
		ENDIF
		
		
	ENDPROC

