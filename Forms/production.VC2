	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		IF NOT "PROC_WO" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_WO ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
		ENDIF
	ENDPROC

	PROCEDURE refreshgrd
		*ThisForm.RefreshGRD()
		
		ThisForm.grdBoard.Refresh()
		
		ThisForm.txtBoardID.Value = tmpProd_Board.ID
		ThisForm.txtDescript.Value = tmpProd_Board.Descript 
		ThisForm.txtHPA.Value = ''
		ThisForm.txtHeat.Value = ''
	ENDPROC

	PROCEDURE refresh_prod_board
		PARAMETERS cWindow
		*!*	*ThisForm.Refresh_Prod_Board("ROTARY FORGE")
		*!*	PRIVATE m.nSched_Type
		*!*	m.nSched_Type = 0
		
		
		
		*!*	IF m.nSched_Type > 0
		*!*		ThisForm.nSched_Type = m.nSched_Type
		*!*	ELSE
		*!*		m.nSched_Type = ThisForm.nSched_Type
		*!*	ENDIF
			
		PRIVATE cSQL, nSQLEXEC 
		IF USED('tmpProd_Board')
			ThisForm.grdBoard.RecordSource = ''
			USE IN tmpProd_Board
		ENDIF
		
		cSQL = "SELECT Pd.Position, Pd.OType_Num "
		cSQL = cSQL + " ,dbo.f_OT_StartDate(Pd.OType_Num) AS StartDate "
		cSQL = cSQL + " ,dbo.f_OT_DueDate(Pd.OType_Num) AS DueDate "
		cSQL = cSQL + " ,dbo.f_OT_Descript(Pd.OType_Num) AS Descript "
		cSQL = cSQL + " ,Pd.ID"
		*cSQL = cSQL + ", Pd.Sched_Type"
		
		cSQL = cSQL + " FROM dbo.rtr_Schedule Pd "
		*cSQL = cSQL + " INNER JOIN (SELECT DISTINCT Oper_ID,Sched_Type FROM dbo.OTracking_Job) Job "
		*cSQL = cSQL + "   ON Pd.Oper_ID = Job.Oper_ID "
		*cSQL = cSQL + " WHERE Job.Sched_Type = "+STR(m.nSched_Type)
		cSQL = cSQL + " WHERE Pd.Sched_Type = "+STR(ThisForm.nSched_Type)
		cSQL = cSQL + " AND Pd.OnBoard = 1 "
		cSQL = cSQL + " ORDER BY Pd.Position "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProd_Board')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpProd_Board')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProd_Board")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProd_Board")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpProd_Board')
		ENDIF
		
		
		PRIVATE m.nBoardID, m.nRecIdex
		m.nBoardID = 0
		m.nRecIdex = 0
		
		IF USED('tmpProd_Board')
			IF RECCOUNT('tmpProd_Board') > 0 
				ThisForm.cmdRemove.Visible = .T.
				
				SELECT tmpProd_Board
				INDEX ON [Position] TAG PositionID
				SET ORDER TO PositionID
				GO TOP
				
				m.nBoardID = PrepareSQLnum(tmpProd_Board.ID,'ID',-3)
				ThisForm.lstBoard.Clear
				
				ThisForm.lstBoard.Visible = .T.	
				SCAN
					m.nRecIdex = RECNO('tmpProd_Board')
					*ThisForm.lstBoard.AddItem(STR(tmpProd_Board.Position,1)	, m.nRecIdex, 1)
					ThisForm.lstBoard.AddItem(STR(tmpProd_Board.Position,1))
					*ThisForm.lstBoard.AddItem(STR(tmpProd_Board.ID,10)		, m.nRecIdex, 2)
					ThisForm.lstBoard.List[ThisForm.lstBoard.NewIndex, 2] = STR(tmpProd_Board.ID,10)
						
				ENDSCAN
				
				GO TOP
			ELSE
				ThisForm.cmdRemove.Visible = .F.
			ENDIF
		ELSE
			ThisForm.cmdRemove.Visible = .F.
		ENDIF
							*Proc_ERP
		ThisForm.Caption = Board_Sched_Type(ThisForm.nSched_Type)
		
		ThisForm.Visible = .T.
		ThisForm.lstBoard.Value = STR(m.nBoardID)
		
		ThisForm.grdBoard.RecordSource = 'tmpProd_Board'
		*Position, ID, OType_Num ,Descript
		
		ThisForm.RefreshGRD()
		ThisForm.LstBoard.SetFocus
		
	ENDPROC

	PROCEDURE saveboardpos
		*ThisForm.SaveBoardPos()
		
		THISFORM.LockScreen = .T.
		*read current lst
		PRIVATE cSQL, nSQLEXEC 
		LOCAL m.nCnt, m.cCurrID, m.cBoardID
		m.cCurrID = PrepareSQLnum(ThisForm.txtBoardID.Value,'BoardID',-3)
		
		FOR m.nCnt = 1 TO ThisForm.lstBoard.ListCount
			IF ThisForm.lstBoard.Selected(m.nCnt)  && Is item selected?
				m.cCurrID = ThisForm.lstBoard.List(m.nCnt,2)
			ENDIF
			m.cBoardID = ThisForm.lstBoard.List(m.nCnt,2)
			
			*Update SQL
			cSQL = "UPDATE dbo.rtr_Schedule SET "
			cSQL = cSQL + " Position = "+STR(m.nCnt)
			cSQL = cSQL + ",[LastTouch] = GetDate() "
			cSQL = cSQL + " WHERE ID="+m.cBoardID
			
			
			*SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			ENDIF
		
		ENDFOR
		
		***********************************
		*re read SQL
		
		ThisForm.Refresh_Prod_Board()
		
		SELECT tmpProd_Board
		LOCATE FOR ID = VAL(m.cCurrID)
		
		ThisForm.lstBoard.Refresh
		ThisForm.grdBoard.Refresh
		
		THISFORM.LockScreen = .F.
	ENDPROC

	PROCEDURE selectid		&& Set Focus to PdID
		PARAMETERS pPdID
		*ThisForm.SelectID()
		
		PRIVATE nPdID
		IF VARTYPE(pPdID) = "N"
			nPdID = pPdID
		ELSE
			nPdID = 0
		ENDIF
		
		IF nPdID = 0
			RETURN
		ENDIF
		
		IF NOT USED('tmpProd_Board')
			RETURN
		ENDIF
		
		PRIVATE nCurrRec, lFound
		nCurrRec = RECNO('tmpProd_Board')
		lFound = .F.
		
		SELECT tmpProd_Board
		
		LOCATE FOR ID = nPdID 
		IF FOUND('tmpProd_Board')
			lFound = .T.
		ELSE
			IF nCurrRec <= RECNO('tmpProd_Board')
				GOTO nCurrRec
			ENDIF
		ENDIF
		
		IF lFound
			*ThisForm.grdBoard.SetFocus
			ThisForm.RefreshGRD() 
		ENDIF
	ENDPROC

	PROCEDURE Unload
		
		*IF USED('PurchaseOrder')
		*	USE IN PurchaseOrder 
		*ENDIF
		
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
	ENDPROC

	PROCEDURE cmdAddInQue.Click
		
		PRIVATE m.nBoardID, m.nNewPos
		m.nBoardID = 0 &&Get the new BoardID
		m.nNewPos = 0	&&Get new Position
		
		PRIVATE m.cReturnOType_Num
		
		*Open Window to get the new Order that meets type Sched_Type
		DO FORM Forms\Production_InQue WITH ThisForm.nSched_Type TO m.cReturnOType_Num
		
		*wait for window to release
		
		PRIVATE lOK
		lOK = .T.
		
		IF lOK 
			*Refresh board
			ThisForm.SaveBoardPos()
			
			IF VARTYPE(m.cReturnOType_Num) = "C"
				SELECT tmpProd_Board
				LOCATE FOR OType_Num = m.cReturnOType_Num
				IF FOUND('tmpProd_Board')
					ThisForm.lstBoard.Value = tmpProd_Board.ID
					ThisForm.RefreshGRD() &&tmpProd_Board
				ENDIF
			ENDIF
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE cmdAddScan.Click
		
		PRIVATE m.nBoardID, m.nNewPos
		m.nBoardID = 0 &&Get the new BoardID
		m.nNewPos = 0	&&Get new Position
		
		PRIVATE m.cReturnOType_Num
		
		*Open Window to get the new Order that meets type Sched_Type
		DO FORM Forms\Production_Scan WITH ThisForm.nSched_Type TO m.cReturnOType_Num
		
		*wait for window to release
		
		IF NOT VARTYPE(m.cReturnOType_Num) = "C"
			MESSAGEBOX("Did not get a Order Number to place on Board.",16,"Cannot Add to Board")
			RETURN .F.
		ENDIF
		
		***********************************
		*Check OrderType
		PRIVATE cOT
		cOT = LEFT(m.cReturnOType_Num,2)
		DO CASE
		CASE cOT = "WO"
		CASE cOT = "SO"
		CASE cOT = "PI"
		CASE cOT = "SI"
		CASE cOT = "WD"
		CASE cOT = "MT"
		CASE cOT = "PO"
		CASE cOT = "RA"
		CASE cOT = "RD"
		OTHERWISE
			MESSAGEBOX("This Order Type was not programed. "+cOT,16,"Cannot Add to Board")	
			TrackError("This Order Type was not programed. "+cOT,"Do Case: This Order Type was not programed. "+cOT, PROGRAM(), LINENO(1))
			RETURN .F.
		ENDCASE
		
		PRIVATE lOK
		lOK = .T.
		*Transfer direction to Sched_Type based!
		DO CASE
		CASE ThisForm.nSched_Type = 1
			lOK = ThisForm.Insert_Sched1(m.cReturnOType_Num)
		CASE ThisForm.nSched_Type = 2
			lOK = ThisForm.Insert_Sched2(m.cReturnOType_Num)
		CASE ThisForm.nSched_Type = 3
			lOK = ThisForm.Insert_Sched3(m.cReturnOType_Num)
		CASE ThisForm.nSched_Type = 4
			lOK = ThisForm.Insert_Sched4(m.cReturnOType_Num)
		CASE ThisForm.nSched_Type = 5
			lOK = ThisForm.Insert_Sched5(m.cReturnOType_Num)
		CASE ThisForm.nSched_Type = 6
			lOK = ThisForm.Insert_Sched6(m.cReturnOType_Num)
		CASE ThisForm.nSched_Type = 7
			lOK = ThisForm.Insert_Sched7(m.cReturnOType_Num)
		CASE ThisForm.nSched_Type = 8
			lOK = ThisForm.Insert_Sched8(m.cReturnOType_Num)
		CASE ThisForm.nSched_Type = 9
			lOK = ThisForm.Insert_Sched9(m.cReturnOType_Num)
		CASE ThisForm.nSched_Type = 10
			lOK = ThisForm.Insert_Sched10(m.cReturnOType_Num)
		ENDCASE
		
		IF lOK 
			*Refresh board
			ThisForm.SaveBoardPos()
		ENDIF
		
		
	ENDPROC

	PROCEDURE cmdRemove.Click
		THISFORM.LockScreen = .T.
		nCnt = 1
		DO WHILE nCnt <= THIS.Parent.lstSelected.ListCount
			IF THIS.Parent.lstSelected.Selected(nCnt)
				THIS.Parent.lstSource.AddItem(THIS.Parent.lstSelected.List(nCnt))
				THIS.Parent.lstSelected.RemoveItem(nCnt)
			ELSE
				nCnt = nCnt + 1
			ENDIF
		ENDDO
		THISFORM.LockScreen = .F.
		
		ThisForm.SaveBoardPos()
		
	ENDPROC

	PROCEDURE cmdReportServer.Click
		PRIVATE m.cOType_Num, m.cHyperLink 
		m.cOType_Num = tmpProd_Board.OType_Num
		m.cHyperLink = ''
		
		DO CASE
		CASE LEFT(m.cOType_Num,2) = "WO"
			m.cHyperLink = HTML_WO(VAL(SUBSTR(m.cOType_Num,3,10)),.T.)
		CASE LEFT(m.cOType_Num,2) = "SO"
			m.cHyperLink = HTML_SO(VAL(SUBSTR(m.cOType_Num,3,10)),.T.)
		CASE LEFT(m.cOType_Num,2) = "PI"
			m.cHyperLink = HTML_POitem(Proper_PO_Item( SUBSTR(m.cOType_Num,3,12) ),.T.)
		CASE LEFT(m.cOType_Num,2) = "SI"
			m.cHyperLink = HTML_SOitem(Proper_SO_Item( SUBSTR(m.cOType_Num,3,10) ),.T.)
		CASE LEFT(m.cOType_Num,2) = "WD"
			m.cHyperLink = HTML_WO_Detail(VAL(SUBSTR(m.cOType_Num,3,10)),.T.)
		CASE LEFT(m.cOType_Num,2) = "MT"
		CASE LEFT(m.cOType_Num,2) = "PO"
			m.cHyperLink = HTML_PO(VAL(SUBSTR(m.cOType_Num,3,10)),.T.)
		CASE LEFT(m.cOType_Num,2) = "RA"
		CASE LEFT(m.cOType_Num,2) = "RD"
		ENDCASE
		*HTML_SOitem HTML_SO HTML_SO_Status HTML_POitem HTML_PO 
		*HTML_WO HTML_WO_Detail HTML_WO_Status
		
		IF LEN(m.cHyperLink) > 0
			PRIVATE loHyperlink
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		
			MESSAGEBOX("Look for a Report Server window in your browser.",0,"Report is waiting")
		ELSE
			MESSAGEBOX("Did not get a Web page on Report Server to goto",0+16,"No Report")
		ENDIF
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
		IF VARTYPE(ThisFormSet.frmProd_Schedule) = "O"
			ThisFormSet.frmProd_Schedule.cmdQuit.SetFocus
		ENDIF
		
	ENDPROC

	PROCEDURE cmdRTR.Click
		PRIVATE m.cOType_Num, m.nTop, m.nLeft, m.cCaption
		m.cOType_Num = tmpProd_Board.OType_Num
		m.nTop	= 0
		m.nLeft	= 0
		m.cCaption	= ''
		
		DO CASE
		CASE LEFT(m.cOType_Num,2) = "WO"
			DO FORM Forms\Router WITH "EDIT","WO",VAL(SUBSTR(m.cOType_Num,3,10)) ,nTop, nLeft, cCaption
		CASE LEFT(m.cOType_Num,2) = "SO"
			MESSAGEBOX("There is no OType=SO programmed."+CHR(13)+"Use SOitem",16,"Cannot open Router")
		CASE LEFT(m.cOType_Num,2) = "PI"
			DO FORM Forms\Router WITH "EDIT","POitem",Proper_PO_Item( SUBSTR(m.cOType_Num,3,12) ) ,nTop, nLeft, cCaption
		CASE LEFT(m.cOType_Num,2) = "SI"
			DO FORM Forms\Router WITH "EDIT","SOitem",Proper_SO_Item( SUBSTR(m.cOType_Num,3,10) ) ,nTop, nLeft, cCaption
		CASE LEFT(m.cOType_Num,2) = "WD"
			DO FORM Forms\Router WITH "EDIT","WO_Detail",VAL(SUBSTR(m.cOType_Num,3,10)) ,nTop, nLeft, cCaption
		CASE LEFT(m.cOType_Num,2) = "MT"
			MESSAGEBOX("There is no OType=MT programmed.",16,"Cannot open Router")
		CASE LEFT(m.cOType_Num,2) = "PO"
			MESSAGEBOX("There is no OType=PO programmed."+CHR(13)+"Use POitem",16,"Cannot open Router")
		CASE LEFT(m.cOType_Num,2) = "RA"
			MESSAGEBOX("There is no OType=RA programmed.",16,"Cannot open Router")
		CASE LEFT(m.cOType_Num,2) = "RD"
			MESSAGEBOX("There is no OType=RD programmed.",16,"Cannot open Router")
		OTHERWISE
			MESSAGEBOX("There is no OType",16,"Cannot open Router")
		ENDCASE
	ENDPROC

	PROCEDURE cmdSavePosition.Click
		ThisForm.SaveBoardPos()
		
	ENDPROC

	PROCEDURE grdBoard.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.RefreshGRD() &&tmpProd_Board
	ENDPROC

	PROCEDURE lstBoard.DblClick
		THIS.Parent.lstSource.AddItem(This.List(This.ListIndex))
		This.RemoveItem(This.ListIndex)
		
	ENDPROC

	PROCEDURE lstBoard.DragDrop
		LPARAMETERS oSource, nXCoord, nYCoord
		IF oSource.Name != THIS.Name
			THIS.Parent.cmdAdd.Click
		ENDIF
	ENDPROC

	PROCEDURE lstBoard.DragOver
		LPARAMETERS oSource, nXCoord, nYCoord, nState
		DO CASE
			CASE nState = 0 && Enter
				oSource.DragIcon = THIS.Parent.CanDropIcon
			CASE nState = 1 && Leave
				oSource.DragIcon = THIS.Parent.NoDropIcon
		ENDCASE
		
	ENDPROC

	PROCEDURE lstBoard.GotFocus
		ThisForm.RefreshGRD()
	ENDPROC

	PROCEDURE lstBoard.InteractiveChange
		*ThisForm.RefreshGRD()
	ENDPROC

	PROCEDURE lstBoard.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode = 63 AND nShiftAltCtrl = 1
			THIS.Parent.SelectAll(THIS)
		ENDIF
	ENDPROC

	PROCEDURE lstBoard.MouseDown
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		THIS.Parent.MouseX = nXCoord
		THIS.Parent.MouseY = nYCoord
		
	ENDPROC

	PROCEDURE lstBoard.MouseMove
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		IF nButton = 1 && Left Mouse
			IF ABS(nXCoord - THIS.Parent.MouseX) > THIS.Parent.DragThreshold OR ;
					ABS(nYCoord - THIS.Parent.MouseY) > THIS.Parent.DragThreshold
				THIS.Drag
			ENDIF
		ENDIF
		
		
	ENDPROC

ENDDEFINE
