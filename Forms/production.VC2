	PROCEDURE Init
		ThisForm.CanDropIcon = 'c:\program files (x86)\hpa\graphics\dragmove.cur'
		ThisForm.NoDropIcon = 'c:\program files (x86)\hpa\graphics\nodrop01.cur'
		
		
	ENDPROC

	PROCEDURE insert_sched1		&& Rotary Forge
		PARAMETERS cOType_Num
		*ThisForm.Insert_Sched1(m.cReturnOType_Num)
		*Rotary Forge
		
		*Check OrderType
		PRIVATE cOT
		cOT = LEFT(cOType_Num,2)
		DO CASE
		*CASE cOT = "WO"
		*CASE cOT = "SO"
		CASE cOT = "PI"
		CASE cOT = "SI"
		CASE cOT = "WD"
		*CASE cOT = "MT"
		*CASE cOT = "PO"
		*CASE cOT = "RA"
		*CASE cOT = "RD"
		OTHERWISE
			MESSAGEBOX("This Order Type was not programed for this Production Schedule. "+cOT,16,"Cannot Add to Board")	
			TrackError("This Order Type was not programed. "+cOT,"Do Case: This Order Type was not programed. "+cOT, PROGRAM(), LINENO(1))
			RETURN .F.
		ENDCASE
		
		
		***********************************
		* what type of Oper_ID - show list that Sched_Type can do!
		
		PRIVATE nOper_ID
		nOper_ID = 525
		
		
		***********************************
		*INSERT
		
		**
		*collect data
		PRIVATE nPosition,nWO_Detail,cSOitem,cPOitem
		nPosition = GetNext_Sched_Position(ThisForm.nSched_Type,ThisForm.nConnHandle)
		nWO_Detail = IIF(cOT="WD",VAL(SUBSTR(m.cReturnOType_Num,3,10)),0)
		cSOitem	= IIF(cOT="SI",SUBSTR(m.cReturnOType_Num,3,10),'')
		cPOitem	= IIF(cOT="PI",SUBSTR(m.cReturnOType_Num,3,12),'')
		
		PRIVATE cSQL, nSQLEXEC 
		
		cSQL = "INSERT INTO dbo.rtr_Schedule "
		cSQL = cSQL + "(Position"
		cSQL = cSQL + ",Oper_ID"
		cSQL = cSQL + ",WO_Detail"
		cSQL = cSQL + ",[SOitem]"
		cSQL = cSQL + ",[POitem]"
		cSQL = cSQL + ",[OnBoard]"
		cSQL = cSQL + ",[InQue]"
		cSQL = cSQL + ",[Closed]"
		cSQL = cSQL + ",[OType_Num]"
		cSQL = cSQL + ",[Sched_Type]"
		cSQL = cSQL + ",[dateOnBoard]"
		cSQL = cSQL + ") VALUES ( "
		
		cSQL = cSQL + STR(nPosition)
		cSQL = cSQL + ","+STR(nOper_ID)
		cSQL = cSQL + ","+STR(nWO_Detail)
		cSQL = cSQL + ",'"+cSOitem+"'"
		cSQL = cSQL + ",'"+cPOitem+"'"
		cSQL = cSQL + ",1"	&&lOnBoard
		cSQL = cSQL + ",0"	&&lInQue
		cSQL = cSQL + ",0"	&&lClosed
		cSQL = cSQL + ",'"+cOType_Num+"'"
		cSQL = cSQL + ","+STR(nSched_Type)
		cSQL = cSQL + ",GetDate()"	&&dtdateOnBoard
		cSQL = cSQL + ") "
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpProd_Board')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpProd_Board')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProd_Board")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpProd_Board")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpProd_Board')
		ENDIF
		
		
		
	ENDPROC

