	PROCEDURE Load
		IF !DBUSED('MAIL')
			OPEN DATABASE E:\Quotes\MAIL.DBC SHARED
			IF NOT 'MAIL.DBC' $ DBC()
				OPEN DATABASE LOCFILE('MAIL.dbc','DBC',"Locate the HPA file!") SHARED
			ENDIF
		ENDIF
		IF !USED('ForeignMail')
			USE MAIL!ForeignMail SHARED IN 0
		ENDIF
		SELECT ForeignMail
		SET ORDER TO UPPCOMP
			
	ENDPROC

	PROCEDURE Unload
		IF USED('ForeignMail')
			USE IN ForeignMail
		ENDIF
		*USES Private Data Sesion
		CLOSE DATABASES ALL
	ENDPROC

	PROCEDURE cmdPack.Click
		PRIVATE msbx
		msbx = MESSAGEBOX("Are you ready to PACK this Table",32+4,"Removing deleted Records")
		IF msbx = 6 &&YES
			thisform.Grid2.RecordSource = ""
			SELECT ForeignMail
			IF FLOCK()
				USE MAIL!ForeignMail EXCLUSIVE
				SET talk on
				PACK
				USE MAIL!ForeignMail SHARED
				GO TOP
			ELSE
				WAIT WINDOW "Could not lock file to pack"
			ENDIF
			thisform.Grid2.RecordSource = "ForeignMail"
			thisform.Grid2.Refresh
			thisform.Name1.Refresh
			thisform.COMPANY1.Refresh
			thisform.Address1.Refresh
			thisform.City1.Refresh
			thisform.State1.Refresh
			thisForm.Country1.Refresh
			thisform.Zip1.Refresh
			thisform.Phone1.Refresh
		
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSearch.Click
		ThisForm.Fcompany.Enabled = .T.
	ENDPROC

	PROCEDURE Fcompany.GotFocus
		ThisForm.oldorder = ORDER()
		SET ORDER TO TAG UPPCOMP
		
	ENDPROC

	PROCEDURE Fcompany.InteractiveChange
		lnInsertionPt = this.SelStart
		lcSearchStr = substr(this.value,1,lnInsertionPt)
		if !empty(lcSearchStr)
			=seek(upper(lcSearchStr),"ForeignMail","UPPCOMP")
			if found("ForeignMail")
				THIS.VALUE=ForeignMail.Company
				=insmode(.f.)
			else
				this.value=lcSearchStr
				=insmode(.t.)
			endif
		else
			this.value=space(0)
		endif
		this.selstart = lnInsertionPt
		
		
	ENDPROC

	PROCEDURE Fcompany.LostFocus
		=insmode(.T.)
		IF NOT EMPTY(ThisForm.oldorder)
			SET ORDER TO (ThisForm.oldorder)
		ENDIF
		
		ThisForm.Name1.Refresh
		ThisForm.COMPANY1.Refresh
		ThisForm.Address1.Refresh
		ThisForm.City1.Refresh
		ThisForm.State1.Refresh
		ThisForm.Country1.Refresh
		ThisForm.Zip1.Refresh
		ThisForm.Phone1.Refresh
		
		
		ThisForm.Grid2.Refresh
		
	ENDPROC

	PROCEDURE Grid2.AfterRowColChange
		LPARAMETERS nColIndex
		
