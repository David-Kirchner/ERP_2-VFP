	PROCEDURE deleteprocess
		*ThisForm.DeleteProcess()
		*Remove by ID_Detail_Process not SOitem!!
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		
		PRIVATE cSOitem, nID_Detail_Process_OLD
		cSOitem	= PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		nID_Detail_Process_OLD	= ThisForm.ID_Detail_process
		
		PRIVATE cStockTableInit
		IF ThisForm.Lst = "StockLst" 
			cStockTableInit = "S"
		ELSE
			cStockTableInit = "B"
		ENDIF
		
		
		IF USED("StockLst_Detail_SOitem_Sub")
			USE IN StockLst_Detail_SOitem_Sub
		ENDIF
		SELECT 0
		
		IF nID_Detail_Process_OLD < 1
			ThisForm.ID_Detail_process = -2
			RETURN .F.
		ENDIF
		
		cSQLn = "SELECT COUNT(*) AS counted FROM "
		IF ThisForm.Lst = "StockLst"  &&*dbo.StockLst_Process dbo.BrokerLst_Process
			cSQLn = cSQLn + "dbo.StockLst_Process "
		ELSE
			cSQLn = cSQLn + "dbo.BrokerLst_Process "
		ENDIF
		*cSQLn = cSQLn + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"') "
		cSQLn = cSQLn + " WHERE AllowSub = 'Y' "
		cSQLn = cSQLn + " AND ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process_OLD))
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle , cSQLn, 'StockLst_Detail_SOitem_Sub')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLn, 'StockLst_Detail_SOitem_Sub')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQLn, ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_SOitem_Sub')
		
		ELSE
			
			IF USED('StockLst_Detail_SOitem_Sub')
				IF RECCOUNT('StockLst_Detail_SOitem_Sub') > 0
					IF StockLst_Detail_SOitem_Sub.counted > 1
						TrackError(cSQLn, "Counted more than 1 to DELETE!",'StockLst_Process.DeleteProcess',LINENO() )
					ENDIF
					IF StockLst_Detail_SOitem_Sub.counted >= 1
					
						*Remove old Process
		
						PRIVATE cSQLd 
						cSQLd = ""
						IF cStockTableInit = "S"
							cSQLd = cSQLd + "DELETE FROM dbo.StockLst_Process "
						ELSE
							cSQLd = cSQLd + "DELETE FROM dbo.BrokerLst_Process "
						ENDIF
						*cSQLd = cSQLd + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"') "
						cSQLd = cSQLd + " WHERE ID_Detail_Process = "+STR(nID_Detail_Process_OLD)
		
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
						ENDDO
						IF nSQLEXEC < 0
							*Could not Delete
							ThisForm.ID_Detail_process = -2
							
							SQLEXECError(cSQLd, ThisForm.nConnHandle, nSQLEXEC, '')
							*dbo.StockLst_Process_History dbo.BrokerLst_Process_History
							cSQLd = ""
							IF cStockTableInit = "S"
								cSQLd = cSQLd + "UPDATE HPAlloy_Archive.dbo.StockLst_Process_History "
							ELSE
								cSQLd = cSQLd + "UPDATE HPAlloy_Archive.dbo.BrokerLst_Process_History "
							ENDIF
							cSQLd = cSQLd + " SET [WHAT]='SUBED' "
							*cSQLd = cSQLd + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
							cSQLd = cSQLd + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process_OLD))
							cSQLd = cSQLd + " AND [What] = 'DELETE' "
		
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLd, ThisForm.nConnHandle, nSQLEXEC, '')
							ENDIF
						ELSE
							*Deleted
							ThisForm.ID_Detail_process = -3
							
							cSQLd = ""
							IF cStockTableInit = "S"
								cSQLd = cSQLd + "UPDATE HPAlloy_Archive.dbo.StockLst_Process_History "
							ELSE
								cSQLd = cSQLd + "UPDATE HPAlloy_Archive.dbo.BrokerLst_Process_History "
							ENDIF
							cSQLd = cSQLd + " SET [WHAT]='SUBED' "
							*cSQLd = cSQLd + " WHERE SOitem = dbo.ProperSO('"+cSOitem+"')"
							cSQLd = cSQLd + " WHERE ID_Detail_Process = "+ALLTRIM(STR(nID_Detail_Process_OLD))
							cSQLd = cSQLd + " AND [What] = 'DELETE' "
							
							nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
							DO WHILE nSQLEXEC = 0
								WAIT WINDOW 'SQL' TIMEOUT 1
								nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLd )
							ENDDO
							IF nSQLEXEC < 0
								SQLEXECError(cSQLd, ThisForm.nConnHandle, nSQLEXEC, '')
							ENDIF
						ENDIF
					ENDIF	
				ELSE
					ThisForm.ID_Detail_process = -2				
				ENDIF
			ELSE
				ThisForm.ID_Detail_process = -2
			ENDIF
		ENDIF
		
		
		*USE ThisForm.ID_Detail_process to return sucsess codes!
		RETURN lOK
	ENDPROC

	PROCEDURE getbyid		&& Fill MemVar with ID_Detail_Process
		*ThisForm.GetByID()
		PRIVATE cSQL, nSQLEXEC
		
		IF ThisForm.Lst = "StockLst"
			cSQL = "SELECT * FROM dbo.StockLst_Process WHERE ID_Detail_Process = "+STR(ThisForm.ID_Detail_Process)
		ELSE
			cSQL = "SELECT * FROM dbo.BrokerLst_Process WHERE ID_Detail_Process = "+STR(ThisForm.ID_Detail_Process)
		ENDIF
		
		IF USED("tmpStockLst_Process")
			SELECT tmpStockLst_Process
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Process')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Process')
		ELSE
			IF USED("tmpStockLst_Process")
				PRIVATE nS_PU, nQTY, nPounds
				nS_PU	= PrepareSQLnum(tmpStockLst_Process.PU,'StockLst_PU',-1)
				nQTY	= PrepareSQLnum(tmpStockLst_Process.QTY,'StockLst_QTY',-5)
				nPounds	= PrepareSQLnum(tmpStockLst_Process.Pounds,'Pounds',7,1)
				
				PRIVATE cTBL
				IF ThisForm.Lst = "StockLst"
					cTBL = "S"
				ELSE
					cTBL = "B"
				ENDIF
		
				IF nS_PU = 0
					nS_PU = getPUfromID_Detail(ThisForm.ID_Detail,cTBL,ThisForm.nConnHandle)
				ENDIF
				******
				
				IF nQTY = 0
					IF nPounds = 0
						*No Units!!!
					ELSE
						nQTY = nPounds
					ENDIF
				ELSE
					IF nPounds = 0
						nPounds = nQTY 
					ELSE
						*nQTY and NPounds have value
					ENDIF
				ENDIF
				*******
				
				ThisForm.ID_Detail 			= PrepareSQLnum(tmpStockLst_Process.ID_Detail,'ID_Detail',-3)
				ThisForm.ID_Detail_Process1.Value = ThisForm.ID_Detail_Process
				ThisForm.SOitem1.Value		= Proper_SO_Item(PrepareSQLtxt(tmpStockLst_Process.SOitem,'SOitem',10))
				ThisForm.PO_item1.Value		= Proper_PO_Item(PrepareSQLtxt(tmpStockLst_Process.PO_item,'PO_Item',12))
				ThisForm.SalesPerson1.Value = PrepareSQLtxt(tmpStockLst_Process.SalesPerson,'SalesPerson',20)
				ThisForm.StartDate1.Value	= PrepareSQLdate(tmpStockLst_Process.StartDate,'StartDate')
				ThisForm.DueDate1.Value		= PrepareSQLdate(tmpStockLst_Process.DueDate,'DueDate')
				ThisForm.chkAllowSub.Value	= IIF(tmpStockLst_Process.AllowSub="Y",1,0 )
				ThisForm.S_PU.Value			= nS_PU
				ThisForm.QTY1.Value			= nQTY
				ThisForm.Pounds1.Value		= nPounds
				ThisForm.Process_ID1.Value	= PrepareSQLtxt(tmpStockLst_Process.Process_ID,'Process_ID',10)
				ThisForm.Processor1.Value	= PrepareSQLtxt(tmpStockLst_Process.Processor,'Processor',20)
				ThisForm.Comment1.Value		= PrepareSQLtxt(tmpStockLst_Process.COMMENT,'Comment',100)
				
				*Data Check
				
				
			ELSE
				THISFORM.InitMemVar()
			ENDIF
		ENDIF
		
		IF USED("tmpStockLst_Process")
			USE IN tmpStockLst_Process
		ENDIF
		
	ENDPROC

	PROCEDURE getbywo
		PARAMETERS nEdit
		*ThisForm.GetByWO()
		PRIVATE lEditWO
		lEditWO = PrepareSQLlogic(nEdit,'Edit')
		PRIVATE cDescript, cTBL
		IF ThisForm.Lst = "StockLst"
			cTBL = "S"
		ELSE
			cTBL = "B"
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.WorkOrder WHERE WO = "+STR(ThisForm.nWO)
		
		IF USED("tmpWorkOrder")
			SELECT tmpWorkOrder
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWorkOrder')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpWorkOrder')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle , nSQLEXEC, 'tmpWorkOrder')
		ELSE
			IF USED("tmpWorkOrder")
		*!*		ThisForm.ID_Detail 			= PrepareSQLnum(tmpWorkOrder.ID_Detail,'ID_Detail',-3) &&Already set
		*!*		ThisForm.ID_Detail_Process1.Value = ThisForm.ID_Detail_Process
				IF lEditWO 
					ThisForm.SOitem1.Value		= Proper_SO_Item(PrepareSQLtxt(tmpWorkOrder.SOitem,'SOitem',10))
					ThisForm.PO_item1.Value		= Proper_PO_Item(PrepareSQLtxt(tmpWorkOrder.POitem,'POItem',12))
					ThisForm.SalesPerson1.Value = PrepareSQLtxt(tmpWorkOrder.SalesRep,'SalesRep',20)
					ThisForm.StartDate1.Value	= PrepareSQLdate(tmpWorkOrder.StartDate,'StartDate')
					ThisForm.DueDate1.Value		= PrepareSQLdate(tmpWorkOrder.DueDate,'DueDate')
					ThisForm.chkAllowSub.Value	= 0
					nPU = GetPUfromForm(tmpWorkOrder.sForm, ThisForm.nConnHandle)
					ThisForm.S_PU.Value			= PrepareSQLnum(nPU,'StockLst_PU',-1)
					ThisForm.QTY1.Value			= PrepareSQLnum(tmpWorkOrder.sWeight,'Pounds',7,1)
					ThisForm.Pounds1.Value		= PrepareSQLnum(tmpWorkOrder.sWeight,'Pounds',7,1)
							*SELECTED, INCOMING, Shipped, CORRECTION, SUBED,CANCELLED
					ThisForm.Process_ID1.Value	= "SELECTED"
					ThisForm.Processor1.Value	= RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
					
					cDescript = get_Descripton_ID_Detail( ThisForm.ID_Detail, cTBL, ThisForm.nConnHandle, .T. )
					
					ThisForm.Comment1.Value		= PrepareSQLtxt("WO#"+ALLTRIM(STR(ThisForm.nWO))+" for "+cDescript,'Descript',100)
		
					IF ThisForm.StartDate1.Value > ThisForm.DueDate1.Value
						ThisForm.DueDate1.Value = ThisForm.StartDate1.Value 
					ENDIF
				ELSE
					*EDIT
					PRIVATE dWODueDate , dDueDate
					dWODueDate = PrepareSQLdate(tmpWorkOrder.StartDate,'StartDate')
					dDueDate = PrepareSQLdate(ThisForm.DueDate1.Value,'DueDate')
					
					ThisForm.chkAllowSub.Value	= 0
					nPU = GetPUfromForm(tmpWorkOrder.sForm, ThisForm.nConnHandle)
					ThisForm.S_PU.Value			= PrepareSQLnum(nPU,'StockLst_PU',-1)
					nsWeight = PrepareSQLnum(tmpWorkOrder.sWeight,'Pounds',7,1)
					IF nsWeight > 0
						ThisForm.QTY1.Value			= nsWeight 
						ThisForm.Pounds1.Value		= nsWeight 
					ENDIF
							*SELECTED, INCOMING, Shipped, CORRECTION, SUBED,CANCELLED
					ThisForm.Process_ID1.Value	= "SELECTED"
					ThisForm.Processor1.Value	= RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
		
					cDescript = get_Descripton_ID_Detail( ThisForm.ID_Detail, cTBL, ThisForm.nConnHandle, .T. )
					ThisForm.Comment1.Value		= PrepareSQLtxt("WO#"+ALLTRIM(STR(ThisForm.nWO))+" for "+cDescript,'Descript',100)
					
					IF EMPTY( dDueDate )
						ThisForm.DueDate1.Value = dWODueDate 
					ELSE
						IF NOT EMPTY( dWODueDate )
							IF dWODueDate <> dDueDate 
								IF MESSAGEBOX("Do you want to replace the DueDate of "+DTOC(dDueDate)+CHR(13)+"with "+DTOC(dWODueDate)+"?",4+32,"Replace?")=6
									ThisForm.DueDate1.Value = dWODueDate 
								ENDIF
							ENDIF
						ENDIF
					ENDIF
					
				ENDIF
				
			ELSE
				IF lEditWO 
					THISFORM.InitMemVar()
				ENDIF
			ENDIF
		ENDIF
		
		IF USED("tmpWorkOrder")
			USE IN tmpWorkOrder
		ENDIF
		
	ENDPROC

	PROCEDURE getfrompoitem
		PARAMETER pPoItem
		*ThisForm.GetFromPOitem
		
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT * FROM dbo.PurchaseOrder WHERE POitem = dbo.f_ProperPOitem('"+pPoItem+"')"
		
		
		IF USED("tmpPO")
			USE IN tmpPO
		ENDIF
		SELECT 0
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpPO')
		ENDDO
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpPO')
		ELSE
			IF USED("tmpPO")
				ThisForm.txtAlloy.Value = PrepareSQLtxt(tmpPO.Alloy,'Alloy',12)
				PRIVATE cDescription
				PRIVATE lRL, lMetric, nSz1orig, nSz2orig, nSz3orig
				lRL = .F.
				lMetric = .F.
				nSz1orig = ''
				nSz2orig = ''
				nSz3orig = ''
				 
				cDescription = ItemDescriptionMetric(tmpPO.Form,tmpPO.Thck,tmpPO.SZ2,tmpPO.SZ3, tmpPO.Order_Qty, lRL, lMetric, nSz1orig, nSz2orig, nSz3orig)
				ThisForm.txtDescript.Value = cDescription
				
				ThisForm.txtHeat.Value = PrepareSQLtxt(tmpSO.Heat,'Heat',35)
				
				IF PrepareSQLnum(ThisForm.txtS_P.Value,'P_LB',9,4) = 0
					ThisForm.txtS_P.Value = PrepareSQLnum(tmpSO.p_lb,'P_LB',9,4)
				ENDIF
				*Qty
				*S_PU
				
				USE IN tmpPO
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO
		*DO forms\stocklst_process.scx WITH cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO
		
		IF TYPE('cWhatDo') = "C"
			DO CASE
			CASE cWhatDo= "ADD_SOLD"
				ThisForm.WhatDo = "ADD_SOLD"
			CASE cWhatDo= "ADD_WO"
				ThisForm.WhatDo = "ADD_WO"
			CASE cWhatDo= "ADD"
				ThisForm.WhatDo = "ADD"
			CASE cWhatDo== "EDIT_WO"
				ThisForm.WhatDo = "EDIT_WO"
			CASE cWhatDo== "EDIT"
				ThisForm.WhatDo = "EDIT"
			CASE cWhatDo= "DELETE"
				ThisForm.WhatDo = "DELETE"
			OTHERWISE
				MESSAGEBOX("Need PARAMETER: cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO" )
				TrackError("Error","Need PARAMETER: cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO","StockLst_Process.Init",LINENO() )
				CANC
			ENDCASE
		ELSE
			MESSAGEBOX("Need PARAMETER: cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO" )
			TrackError("Error","Need PARAMETER: cWhatDo, nID, pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pLst, pPoItem, pWO" ,"StockLst_Process.Init",LINENO() )
			CANC
		ENDIF
		
		*!*	ThisForm.lAllowSub = .T.
		*!*	IF VARTYPE(plAllowSub) = "L"
		*!*		IF plAllowSub
		*!*			ThisForm.lAllowSub = .T.
		*!*		ELSE
		*!*			ThisForm.lAllowSub = .F.
		*!*		ENDIF
		*!*	ENDIF
		
		IF TYPE("nID") = "N"
			IF ThisForm.WhatDo = "ADD_WO"
				ThisForm.ID_Detail = nID
				ThisForm.ShowStockLst_Detail( nID )
			ENDIF
			IF ThisForm.WhatDo = "ADD_SOLD"
				ThisForm.ID_Detail = nID
				ThisForm.ShowStockLst_Detail( nID )
			ENDIF
			IF ThisForm.WhatDo == "ADD" 
				ThisForm.ID_Detail = nID
				ThisForm.ShowStockLst_Detail( nID )
			ENDIF
			IF ThisForm.WhatDo = "EDIT_WO" 
				ThisForm.ID_Detail_Process = nID
			ENDIF
			IF ThisForm.WhatDo == "EDIT" OR ThisForm.WhatDo = "DELETE"
				ThisForm.ID_Detail_Process = nID
			ENDIF
		ELSE
			ThisForm.ID_Detail = 0
			ThisForm.ID_Detail_Process = 0
		ENDIF
		
		*Sign with WorkOrder
		IF TYPE("pWO") = "N"
			ThisForm.nWO = PrepareSQLnum(pWO,'WO',-3)
			ThisForm.chkAllowSub.Value = 0
		ELSE
			ThisForm.nWO = 0
		ENDIF
		ThisForm.txtWO.Value = ThisForm.nWO
		
		IF TYPE("pLst") = "U"
			pLst = "StockLst"
		ENDIF
		IF TYPE("pLst") != "C"
			pLst = "StockLst"
		ENDIF
		IF EMPTY("pLst")
			pLst = "StockLst"
		ENDIF
		
		IF pLst = "StockLst" OR pLst = "S"
			ThisForm.txtLst.Value = "StockLst"
			ThisForm.Lst 		  = "StockLst"
		ELSE
			ThisForm.txtLst.Value = "BrokerLst"
			ThisForm.Lst 		  = "BrokerLst"
		ENDIF
		
		DO CASE
		CASE ThisForm.WhatDo = "ADD_SOLD"
			ThisForm.SoldMemVar(pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pPoItem)
		CASE ThisForm.WhatDo = "ADD_WO"
			ThisForm.GetByWO(1)
		CASE ThisForm.WhatDo = "ADD" 
			ThisForm.InitMemVar()
		CASE ThisForm.WhatDo = "EDIT_WO"
			ThisForm.GetByID()
			ThisForm.GetByWO(0)
		CASE ThisForm.WhatDo == "EDIT"
			ThisForm.GetByID()
		CASE ThisForm.WhatDo = "DELETE"
			ThisForm.GetByID()
			ThisForm.InitDelete()
		ENDCASE
		
		
	ENDPROC

	PROCEDURE initdelete
		*InitDelete()
		ThisForm.cmdSave.Caption = "Delete"
		ThisForm.lblDeleteProcess.Visible = .T.
		
		ThisForm.SOitem1.Enabled	= .F.
		ThisForm.PO_item1.Enabled	= .F.
		ThisForm.SalesPerson1.Enabled	= .F.
		ThisForm.StartDate1.Enabled	= .F.
		ThisForm.DueDate1.Enabled	= .F.
		ThisForm.Pounds1.Enabled	= .F.
		ThisForm.chkAllowSub.Enabled	= .F.
		ThisForm.QTY1.Enabled		= .F.
		ThisForm.S_PU.Enabled		= .F.
		ThisForm.Process_id1.Enabled	= .F.
		ThisForm.Processor1.Enabled	= .F.
		ThisForm.Comment1.Enabled	= .F.
	ENDPROC

	PROCEDURE initmemvar		&& Initilze MemVar blank
		*initMemVar
		ThisForm.ID_Detail_Process1.Value = 0
		ThisForm.SOitem1.Value		= SPACE(10)
		ThisForm.PO_item1.Value		= SPACE(12)
		ThisForm.SalesPerson1.Value = SPACE(20)
		ThisForm.StartDate1.Value	= DATE()
		ThisForm.DueDate1.Value		= CTOD("  /  /  ")
		ThisForm.Pounds1.Value		= 0
		ThisForm.chkAllowSub.Value	= 1
		ThisForm.QTY1.Value			= 0
		ThisForm.S_PU.Value			= 0
		ThisForm.Process_id1.Value	= SPACE(10)
		ThisForm.Processor1.Value	= SPACE(20)
		ThisForm.Comment1.Value		= SPACE(100)
		ThisForm.txtWO.Value = ThisForm.nWO
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_HPA" $ SET("PROCEDURE")  &&Added for when Quotes is run without HPA menu.
			SET PROCEDURE TO Progs\Proc_HPA ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "PROC_QUOTES" $ UPPER( SET("PROCEDURE") )	
			SET PROCEDURE TO Progs\PROC_QUOTES ADDITIVE
		ENDIF
		
	ENDPROC

	PROCEDURE saveprocess
		*ThisForm.SaveProcess()
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		PRIVATE cSOitem, cPO_item, cSalesPerson
		PRIVATE dStartDate, dDueDate, nS_P, lAllowSub
		PRIVATE nQTY, nS_PU, cProcess_ID, cProcessor, cComment
		PRIVATE cAllowSub, nWO
		
		cSOitem		= PrepareSQLtxt(ThisForm.SOitem1.Value,'SOitem',10)
		cPO_Item 	= PrepareSQLtxt(ThisForm.PO_Item1.Value,'POItem',12)
		cSalesPerson= PrepareSQLtxt(ThisForm.SalesPerson1.Value,'SalesPerson',20)
		dStartDate 	= PrepareSQLdate(ThisForm.StartDate1.Value,'StartDate')
		dDueDate 	= PrepareSQLdate(ThisForm.DueDate1.Value,'DueDate')
		*nS_P		= PrepareSQLnum(ThisForm.txtS_P.Value,'StockLst_P',-5)
		nPounds		= PrepareSQLnum(ThisForm.Pounds1.Value,'Pounds',9,1)
		lAllowSub 	= PrepareSQLchk(ThisForm.chkAllowSub.Value,'AllowSub')
		nQTY		= PrepareSQLnum(ThisForm.QTY1.Value,'StockLst_QTY',-5)
		nS_PU		= PrepareSQLnum(ThisForm.S_PU.Value,'StockLst_PU',-1)
		cProcess_ID = PrepareSQLtxt(ThisForm.PROCESS_ID1.Value,'Process_ID',10)
		cProcessor	= PrepareSQLtxt(ThisForm.PROCESSOR1.Value,'Processor',20)
		cComment	= PrepareSQLtxt(ThisForm.Comment1.Value,'Comment',100)
		cAllowSub 	= IIF(lAllowSub,'Y','N')
		nWO			= PrepareSQLnum(ThisForm.txtWO.Value,'WO',-3)
		
		cSOitem		= Proper_SO_Item(cSOitem)
		cPO_item	= Proper_PO_Item(cPO_item)
		
		*Test mevar
		IF TYPE('cPO_Item') != "C"
			cPO_Item = ""
		ENDIF
		
		IF ThisForm.WhatDo = "ADD_WO" 
			*check to see if a SO has allready marked a process, and add WO number!
			IF Proper_SO_Item(cSOitem) != Proper_SO_Item('')
				IF USED('cntLst')
					USE IN cntLst
				ENDIF
				
				SELECT 0
				
				IF ThisForm.Lst = "StockLst"
					cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.StockLst_Process "
				ELSE
					cSQL = "SELECT COUNT(*) AS Cntd FROM dbo.BrokerLst_Process "
				ENDIF
				cSQL = cSQL + " WHERE SOitem=dbo.f_ProperSOitem('"+cSOitem+"')"
				
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntLst')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'cntLst')
				ENDDO
				
				IF USED('cntLst')
					IF RECCOUNT('cntLst') > 0
						IF cntLst.Cntd > 0
						
						ENDIF
					ENDIF
					USE IN cntLst
				ENDIF
				
			ENDIF
		ENDIF
		
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ENDIF
		
		IF THISFORM.WhatDo = "ADD_SOLD" OR ThisForm.WhatDo = "ADD_WO" OR ThisForm.WhatDo == "ADD"
		
			cProcess_ID = "SELECTED"
			*p_StockLst_Process_ins
			IF ThisForm.Lst = "StockLst"
				cSQLi = "EXEC p_StockLst_Process_ins4 "
			ELSE
				cSQLi = "EXEC p_BrokerLst_Process_ins4 "
			ENDIF
			cSQLi = cSQLi + "@ID_Detail = "+STR(THISFORM.ID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+cSalesPerson+"'"
			cSQLi = cSQLi + ",@StartDate = '"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQLi = cSQLi + ",@AllowSub = '"+cAllowSub+"'"
			cSQLi = cSQLi + ",@PU= "+STR(nS_PU,1)
			cSQLi = cSQLi + ",@QTY= "+STR(nQTY,18,4)
			cSQLi = cSQLi + ",@Pounds = "+STR(nPounds,9,1)
			cSQLi = cSQLi + ",@SOitem = '"+cSOitem+"'"
			cSQLi = cSQLi + ",@PO_Item = '"+cPO_Item+"'"
			cSQLi = cSQLi + ",@Process_ID = '"+cProcess_ID+"'"
			cSQLi = cSQLi + ",@Processor = '"+cProcessor+"'"
			cSQLi = cSQLi + ",@Comment = '"+cComment+"'"
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			
			IF nSQLEXEC < 0
				*retry
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			
			IF nSQLEXEC < 1
				SQLExecError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				TrackError("Could not EXEC p_StockLst_Process_ins4","p_StockLst_Process_ins4","StockLst_Process.cmdSave()",LINENO())
				lOK = .F.
			ELSE
		
				=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpID_Detail_Process")
					ThisForm.ID_Detail_Process = tmpID_Detail_Process.exp		
					USE IN tmpID_Detail_Process
				ELSE
					ThisForm.ID_Detail_Process = 0
				ENDIF
		
			ENDIF
			
		ENDIF
		IF THISFORM.WhatDo = "EDIT_WO" OR THISFORM.WhatDo == "EDIT"
			IF ThisForm.Lst = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Process SET "
			ELSE
				cSQL = "UPDATE dbo.BrokerLst_Process SET "
			ENDIF
		*	cSQL = cSQL+ "ID_Detail="
		*	cSQL = cSQL+ ""+STR(THISFORM.ID_Detail)+","
			cSQL = cSQL+ " SOitem = dbo.f_ProperSOitem('"+cSOitem+"')"
			cSQL = cSQL+ ",PO_item = dbo.f_ProperPOitem('"+cPO_Item+"')"
			cSQL = cSQL+ ",SalesPerson='"+cSalesPerson+"'"
			cSQL = cSQL+ ",StartDate='"+IIF(EMPTY(dStartDate),'',DTOC(dStartDate))+"'"
			cSQL = cSQL+ ",DueDate='"+IIF(EMPTY(dDueDate),'',DTOC(dDueDate))+"'"
			cSQL = cSQL+ ",Comment='"+cComment+"'"
			cSQL = cSQL+ ",Process_ID='"+cProcess_id+"'"
			cSQL = cSQL+ ",Processor='"+cProcessor+"'"
			cSQL = cSQL+ ",AllowSub='"+cAllowSub+"'"
			*pWeight, pPc, pFt, 
			cSQL = cSQL+ ",PU="+STR(nS_PU)+""
			cSQL = cSQL+ ",QTY="+STR(nQTY,18,4)+""
			cSQL = cSQL+ ",Pounds="+STR(nPounds,9,1)+""
		
			cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(THISFORM.ID_Detail_Process)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0
				SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				lOK = .F.
			ELSE
				=SQLCOMMIT(ThisForm.nConnHandle)
			ENDIF
		ENDIF
		
		*** ADD nWO info
		IF ThisForm.ID_Detail_Process > 0
			IF nWO > 0
				IF ThisForm.Lst = "StockLst"
					cSQL = "UPDATE dbo.StockLst_Process SET "
				ELSE
					cSQL = "UPDATE dbo.BrokerLst_Process SET "
				ENDIF
				cSQL = cSQL+ " WO="+STR(nWO)
				cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(THISFORM.ID_Detail_Process)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0
					SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				ENDIF
			ENDIF
		ENDIF
		
		RETURN lOK
	ENDPROC

	PROCEDURE showstocklst_detail
		PARAMETER pnID_Detail
		*ThisForm.ShowStockLst_Detail( nID )
		
		IF TYPE("pnID_Detail") != "N"
			RETURN .F.
		ENDIF
		
		IF USED("tmpStockLstD")
			USE IN tmpStockLstD
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "SELECT m.Alloy,m.Specs,m.Heat,d.Descript, d.S_P, d.S_PU "
		IF ThisForm.Lst = "StockLst"
			cSQL = cSQL + " FROM dbo.StockLst_Detail d, dbo.StockLst_Master m "
		ELSE
			cSQL = cSQL + " FROM dbo.BrokerLst_Detail d, dbo.BrokerLst_Master m "
		ENDIF	
		cSQL = cSQL + "WHERE d.ID_Detail = "+STR(pnID_Detail)+" AND d.ID = m.ID"
		
		SELECT 0
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
		ENDDO
		IF nSQLEXEC < 0
			SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstD')
		ELSE
			IF USED("tmpStockLstD")
				ThisForm.txtAlloy.Value		= ShowSQLtxt(tmpStockLstD.Alloy,'Alloy',12)
				ThisForm.txtSpecs.Value		= ShowSQLtxt(tmpStockLstD.Specs,'Specs',160)
				ThisForm.txtHeat.Value		= ShowSQLtxt(tmpStockLstD.Heat,'Heat',50)
				ThisForm.txtDescript.Value	= ShowSQLtxt(tmpStockLstD.Descript,'Descript',20)
				ThisForm.txtS_P.Value		= PrepareSQLnum(tmpStockLstD.S_P,'S_P',-5)
				ThisForm.S_PU.Value			= PrepareSQLnum(tmpStockLstD.S_PU,'S_PU',-1)
		
				ThisForm.txtAlloy.Visible	= .T.
				ThisForm.txtSpecs.Visible	= .T.
				ThisForm.txtHeat.Visible	= .T.
				ThisForm.txtDescript.Visible	= .T.
				ThisForm.txtS_P.Visible	= .T.
				
				ThisForm.lblAlloy.Visible	= .T.
				ThisForm.lblSpecs.Visible	= .T.
				ThisForm.lblHeat.Visible	= .T.
				ThisForm.lblDescript.Visible	= .T.
				ThisForm.lblPrice.Visible	= .T.
			ENDIF
		ENDIF
		
		IF USED("tmpStockLstD")
			USE IN tmpStockLstD
		ENDIF
		
	ENDPROC

	PROCEDURE soldmemvar
		PARAMETER pSOItem, pSalesP, pSalesDate, pLBS, pQTY, pComment, pShipDue, pPoItem
		*ThisForm.SoldMemVar()
		
		IF TYPE("pSOitem") = "C"
			IF Proper_PO_item(pSOitem) != Proper_PO_item('')
				ThisForm.SOitem1.Value = pSOitem
				ThisForm.SOITEM1.Enabled = .F.
				
				ThisForm.PO_ITEM1.Enabled = .F.
				
			ELSE
				ThisForm.SOitem1.Value = SPACE(10)
			ENDIF
		ELSE
			ThisForm.SOitem1.Value = SPACE(10)
		ENDIF
		
		IF TYPE("pSalesP") = "C"
			IF NOT EMPTY(pSalesP)
				ThisForm.SalesPerson1.Value = SalesPDescription(pSalesP,'')
				
			ELSE
				ThisForm.SalesPerson1.Value = SPACE(20)
			ENDIF
		ELSE
			ThisForm.SalesPerson1.Value = SPACE(20)
		ENDIF
		
		IF TYPE("pSalesDate") = "D"
			IF pSalesDate>CTOD("01/01/1900")
				ThisForm.StartDate1.Value = pSalesDate
			ELSE
				ThisForm.StartDate1.Value = DATE()
			ENDIF
		ELSE
			IF TYPE("pSalesDate") = "T"
				IF pSalesDate>CTOD("01/01/1900")
					ThisForm.StartDate1.Value = TTOD(pSalesDate)
				ELSE
					ThisForm.StartDate1.Value = DATE()
				ENDIF
			ELSE
				ThisForm.StartDate1.Value= DATE()
			ENDIF
		ENDIF
		
		IF TYPE("pShipDue") = "D"
			IF pShipDue>CTOD("01/01/1900")
				ThisForm.DueDate1.Value = pShipDue
			ELSE
				ThisForm.DueDate1.Value = CTOD("  /  /  ")
			ENDIF
		ELSE
			IF TYPE("pShipDue") = "T"
				IF pShipDue>CTOD("01/01/1900")
					ThisForm.DueDate1.Value = TTOD(pShipDue)
				ELSE
					ThisForm.DueDate1.Value = CTOD("  /  /  ")
				ENDIF
			ELSE
				ThisForm.DueDate1.Value = CTOD("  /  /  ")
			ENDIF
		ENDIF
		
		
		ThisForm.chkAllowSub.Value = 1
		
		IF TYPE("pLBS") = "N"
			IF NOT EMPTY(pLBS)
				ThisForm.Pounds1.Value = pLBS
			ELSE
				ThisForm.Pounds1.Value = 0
			ENDIF
		ELSE
			ThisForm.Pounds1.Value = 0
		ENDIF
		
		IF VARTYPE(pQTY) = "N" OR VARTYPE(pQTY) = "Y"
			IF NOT EMPTY(pQTY)
				ThisForm.Qty1.Value = pQTY
			ELSE
				ThisForm.Qty1.Value = 0
			ENDIF
		ELSE
			ThisForm.Qty1.Value = 0
		ENDIF
		
		IF TYPE("pPOitem") = "C"
			IF NOT EMPTY(pPOitem)
				ThisForm.PO_Item1.Value = pPOitem
				GetFromPOitem(pPOitem)
			ELSE
				ThisForm.PO_Item1.Value = SPACE(11)
			ENDIF
		ELSE
			ThisForm.PO_Item1.Value = SPACE(11)
		ENDIF
		
		
		*!*	IF NOT EMPTY(pPU)
		*!*		ThisForm.PU1.Value = pPU
		*!*	ELSE
		*!*		ThisForm.PU1.Value = 0
		*!*	ENDIF
		
		*!*	IF NOT EMPTY(pQTY)
		*!*		ThisForm.QTY1.Value = pQTY
		*!*	ELSE
		*!*		ThisForm.QTY1.Value = 0
		*!*	ENDIF
			
			
		*****
		ThisForm.Process_id1.Value = "SELECTED"
		ThisForm.PROCESS_ID1.Enabled = .F.
		
		ThisForm.Processor1.Value = SPACE(20)
		ThisForm.PROCESSOR1.Enabled = .F.
		
		IF TYPE("pComment") = "C"
			IF NOT EMPTY(pComment)
				ThisForm.Comment1.Value = pComment
			ELSE
				ThisForm.Comment1.Value = SPACE(100)
			ENDIF
		ELSE
			ThisForm.Comment1.Value = SPACE(100)
		ENDIF
		
		m.ID_Detail_Process = 0
		ThisForm.ID_Detail_Process1.Value = 0
		
		IF EMPTY(ThisForm.SALESPERSON1.Value)
			PRIVATE cMach_User 
			cMach_User = SYS(0)
			ThisForm.SALESPERSON1.Value = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
		ENDIF
	ENDPROC

	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		
		RETURN ThisForm.ID_Detail_process
	ENDPROC

	PROCEDURE cmdAbort.Click
		ThisForm.ID_Detail_Process = 0
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdReport.Click
		*DO FORM Forms\StockLst_Detail_History WITH 0, ThisForm.ID_Detail_Process1.Value, 0, ThisForm.Lst, 0
		DO FORM Forms\StockLst_Detail_History WITH ThisForm.ID_Detail_Process1.Value, ThisForm.Lst
		*Parameter SOitem, Process
		
		
	ENDPROC

	PROCEDURE cmdSave.Click
		PRIVATE lOK
		lOK = .T.
		
		IF THIS.Caption = "Save"
			lOK = ThisForm.SaveProcess()
		ENDIF
		IF THIS.Caption = "Delete"
			lOK = ThisForm.DeleteProcess()
		ENDIF
			
		**Could not Delete		ThisForm.ID_Detail_process = -2
		*Deleted			ThisForm.ID_Detail_process = -3
		
		IF lOK 
			THISFORM.RELEASE
		ENDIF
		
	ENDPROC

	PROCEDURE lblPO_Item.Click
		DO FORM Forms\SelectPO_Item TO vcPOitem
		
		PRIVATE cText
		cText = ''
		IF VARTYPE(vcPOitem) = "C"
			IF NOT EMPTY(vcPOitem)
				ThisForm.PO_Item1.Value = vcPOitem
				cText = CHR(10)+CHR(13)+"POitem="+ALLTRIM(vcPOitem)+"!"
				cText = cText +CHR(10)+CHR(13)+"Otherwise this POitem will be saved with this StockLst Selection."
			ENDIF
		ENDIF
		
		IF MESSAGEBOX("Do you wish to Erase this?"+cText,4+32,"Remove data") = 6
			ThisForm.PO_Item1.Value = ""
		ENDIF
	ENDPROC

	PROCEDURE LBLSALESPERSON1.Click
		PRIVATE cMach_User 
		cMach_User = SYS(0)
		ThisForm.SALESPERSON1.Value = RIGHT( cMach_User, LEN(cMach_User)-AT("#",cMach_User)-1 )
	ENDPROC

	PROCEDURE SOITEM1.Valid
		PRIVATE nSalesNum, nItem, cSOitem
		
		cSOitem = This.Value
		nSalesNum = VAL( LEFT( cSOitem, 7) )
		nItem = VAL( RIGHT( cSOitem, 2) )
		IF nSalesNum > 0
			IF nItem > 0
				IF AT("-",cSOitem) < 4
					MESSAGEBOX("Sales Number Item not correct!"+CHR(13)+"Did not Find Hyphen '-' .",0,"SO item Error")
				ENDIF
			ELSE
				MESSAGEBOX("Sales Number Item not correct!",0,"SO item Error")
			ENDIF
		ELSE
			MESSAGEBOX("Sales Number not correct!",0,"SO item Error")
		ENDIF
	ENDPROC

ENDDEFINE
