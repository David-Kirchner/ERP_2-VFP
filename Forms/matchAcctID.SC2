	PROCEDURE cmdRemoveCustomerID.Click
		PRIVATE cCompany, nID, cCustomer
		cCompany 	= QuickCompany.Company
		*nID			= QuickCompany.ID
		nID 	= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		cCustomer	= QuickCompany.Customer
		
		
		IF MESSAGEBOX("Are you sure you want to remove CustID:"+ALLTRIM(cCustomer)+CHR(13)+" from Company:"+ALLTRIM(cCompany)  ,4+32,"Remove CustomerID") = 6
			
			*cSQL = "UPDATE dbo.QuickCompany SET Customer='' WHERE ID ="+STR(nID)
			cSQL = "UPDATE dbo.QuickCompany SET Customer='' WHERE Customer = '"+cCustomer+"'"
			cSQL = cSQL + " AND Company = '"+PrepareSQLtxt(cCompany,'Company',30)+"'"
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL  )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC  )
			ENDIF
			
			cMess = "Do you want to remove all the Quotes "+CHR(13)+"that have this 'Accounting' Customer ID?"
			cMess = cMess + CHR(13)+"and same Company, Phone, Country, and Fax!"
			
			IF MESSAGEBOX(cMess,4+32,"Update Customer in AllQuotes") = 6
		
				cSQL = "UPDATE dbo.AllQuotes "
				cSQL = cSQL + " SET CustID=QC.Customer "
				cSQL = cSQL + " FROM dbo.QuickCompany QC "
				cSQL = cSQL + " WHERE AllQuotes.Company = QC.Company "
				cSQL = cSQL + " AND AllQuotes.Phone = QC.Phone "
				cSQL = cSQL + " AND AllQuotes.CountryC = QC.CountryC "
				cSQL = cSQL + " AND AllQuotes.Fax = QC.Fax "
				cSQL = cSQL + " AND QC.Customer = '"+cCustomer+"'"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, '' )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '' )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC  )
				ENDIF
			ENDIF
		
			ThisForm.Refresh_Quickcompany(nID)
		
		ELSE
			WAIT WINDOW "No Change made!" NOWAIT
		ENDIF
		
		*ThisForm.grdCustomer_List.Refresh
		*ThisForm.Refresh_Customer_List_TXT()
	ENDPROC

