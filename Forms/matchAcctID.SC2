	PROCEDURE txtSearchCustomerList.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryString 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryString  = ''
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE cCL_Company
		cCL_Company = ''
		
		IF USED('tmpCL_Company')
			USE IN tmpCL_Company
		ENDIF
		
		IF !EMPTY(lcSearchStr)
		*	lcTryString = SearchAlloyStandard(lcSearchStr, gnConnHandle )
			cSQL = "SELECT CustomerName FROM dbo.Customer_List WHERE CustomerName LIKE '"+lcSearchStr+"%'"
			SELECT 0
				
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCL_Company')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpCL_Company')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCL_Company")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpCL_Company")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpCL_Company')
			ENDIF
		
		
			IF USED("tmpCL_Company")
				IF NOT EOF('tmpCL_Company')
					cCL_Company = tmpCL_Company.CustomerName
				ENDIF
				USE IN tmpCL_Company
			ENDIF
		
			IF NOT EMPTY(cCL_Company)
			
				IF UPPER(lcSearchStr) = SUBSTR(cCL_Company,1,lnInsertionPt)
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(0,0,0)
					
					SELECT Customer_List 
					SEEK cCL_Company ORDER TAG CustomerNa IN Customer_List
					
					ThisForm.grdCustomer_List.Refresh
					ThisForm.Refresh_customer_list_txt('ShowOnly')
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE txtSearchCustomerList.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE txtSearchQuickCompany.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryString 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryString  = ''
		
		PRIVATE cSQL, nSQLEXEC 
		PRIVATE cQCompany
		cQCompany = ''
		
		IF USED('tmpQ_Company')
			USE IN tmpQ_Company
		ENDIF
		
		IF !EMPTY(lcSearchStr)
		*	lcTryString = SearchAlloyStandard(lcSearchStr, gnConnHandle )
			cSQL = "SELECT Company FROM dbo.QuickCompany WHERE Company LIKE '"+lcSearchStr+"%'"
			SELECT 0
				
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQ_Company')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQ_Company')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQ_Company")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQ_Company")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpQ_Company')
			ENDIF
		
		
			IF USED("tmpQ_Company")
				IF NOT EOF('tmpQ_Company')
					cQCompany = tmpQ_Company.Company 
				ENDIF
				USE IN tmpQ_Company
			ENDIF
		
			IF NOT EMPTY(cQCompany)
			
				IF UPPER(lcSearchStr) = SUBSTR(cQCompany,1,lnInsertionPt)
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(0,0,0)
					
					SELECT QuickCompany
					SEEK cQCompany ORDER TAG Company IN QuickCompany
					
