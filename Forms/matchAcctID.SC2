	PROCEDURE Init
		PARAMETERS pcCustID, pcCompany
		
		*DO FORM forms\MatchCustomerID WITH cCustID, cCompany
		
		
		
		WAIT WINDOW 'Customer_List' NOWAIT
		ThisForm.Refresh_Customer_List()
		WAIT WINDOW 'QuickCompany' NOWAIT
		ThisForm.Refresh_QuickCompany()
		WAIT CLEAR
		
		PRIVATE lFoundParameter
		lFoundParameter = .F.
		
		IF VARTYPE(pcCustID) = "C"
			IF NOT EMPTY(pcCustID)
				ThisForm.txtCustomerID.Value = pcCustID
				ThisForm.txtCustomerID.Visible = .T.
				
				SEEK pcCustID ORDER TAG CustomerID IN Customer_List
				IF FOUND('Customer_List')
					ThisForm.Refresh_Customer_List_txt()
					lFoundParameter = .T.
				ELSE
					SEEK pcCustID ORDER TAG Customer IN QuickCompany
					IF FOUND('QuickCompany')
						ThisForm.Refresh_QuickCompany_txt()
						lFoundParameter = .T.
					ENDIF		
				ENDIF
				
			ENDIF
		ENDIF
		
		
		****************		
		IF NOT lFoundParameter
			IF VARTYPE(pcCompany) = "C"
				IF NOT EMPTY(pcCompany)
					ThisForm.txtpCustomerName.Value = pcCompany 
					ThisForm.txtpCustomerName.Visible = .T.
				
					SEEK pcCompany ORDER TAG Company IN QuickCompany
					IF FOUND('QuickCompany')
						ThisForm.Refresh_QuickCompany_txt()
						lFoundParameter = .T.
					ELSE
		
						SEEK pcCompany ORDER TAG CustomerNa IN Customer_List
						IF FOUND('Customer_List')
							ThisForm.Refresh_Customer_List_txt()
							lFoundParameter = .T.
						ELSE
							
							SELECT Customer_List
							LOCATE FOR LEFT(CustomerName,4) = LEFT(pcCompany,4)
							
							IF FOUND('Customer_List')
								ThisForm.Refresh_Customer_List_txt()
								lFoundParameter = .T.
							ELSE
								LOCATE FOR LEFT(CustomerName,1) = LEFT(pcCompany,1)
								IF FOUND('Customer_List')
									ThisForm.Refresh_Customer_List_txt()
									lFoundParameter = .T.
								ENDIF
							ENDIF
							
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF	
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
	ENDPROC

	PROCEDURE quickcompany_dynamic_back_color
		PRIVATE nColor
		*QuickCompany_Dynamic_Back_Color()
		
		*nColor = RGB( 255, 255, 255 ) &&WHITE
		*IIF(ISNULL(QuickCompany.Customer),RGB( 255, 255, 255 ),RGB( 128,255,128 ))
		
		IF NOT ISNULL(QuickCompany.Customer)
			nColor = RGB( 128,255,128 ) &&Green
		ELSE
			nColor = RGB( 255, 255, 255 ) &&WHITE
		ENDIF
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE refreshquickcompanynotes
		PARAMETERS pcCustomer
		*ThisForm.RefreshQuickCompanyNotes()
		
		ThisForm.QuickCompanyNotes.Visible = .F.
		
		PRIVATE nID
		nID = 0
		
		IF VARTYPE(pcCustomer) != 'C'
			IF VARTYPE(pcCustomer) = 'N'
				nID = pcCustomer
			ENDIF
			pcCustomer = ''
		ENDIF
		
		IF USED('QuickCompanyNotes')
			USE IN QuickCompanyNotes
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT QuickCompany.Notes"
		cSQL = cSQL + " FROM dbo.QuickCompany "
		IF nID > 0
			cSQL = cSQL + " WHERE ID = "+STR(nID)
		ELSE
			PRIVATE cCustomer 
			cCustomer = PrepareSQLtxt(pcCustomer,'Customer',20)
			cSQL = cSQL + " WHERE Customer = '"+ALLTRIM(pcCustomer)+"'"
		ENDIF
		cSQL = cSQL + " AND Notes IS NOT NULL"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'QuickCompanyNotes')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'QuickCompanyNotes' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "QuickCompanyNotes")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "QuickCompanyNotes")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'QuickCompanyNotes' )
		ENDIF
		
		
		PRIVATE cNotes
		IF USED('QuickCompanyNotes')
			IF nID > 0
				IF NOT ISNULL(QuickCompanyNotes.Notes) 
					IF NOT EMPTY(QuickCompanyNotes.Notes) 
						ThisForm.QuickCompanyNotes.Value = QuickCompanyNotes.Notes
					ENDIF
				ENDIF
			ELSE
				cNotes = ""
				SELECT QuickCompanyNotes
				DO WHILE NOT EOF()
					IF NOT ISNULL(QuickCompanyNotes.Notes)
						IF NOT EMPTY(QuickCompanyNotes.Notes)  
							cNotes = cNotes + ALLTRIM(QuickCompanyNotes.Notes)
						ENDIF
					ENDIF
					SKIP
				ENDDO
				ThisForm.QuickCompanyNotes.Value = cNotes
			ENDIF
			USE IN QuickCompanyNotes
		ENDIF
		
		
		IF NOT EMPTY(ThisForm.QuickCompanyNotes.Value)
			ThisForm.QuickCompanyNotes.Visible = .T.
		ENDIF
		*ThisForm.QuickCompanyNotes.Refresh			
	ENDPROC

	PROCEDURE refresh_customer_list
		*ThisForm.Refresh_Customer_List()
		ThisForm.grdCustomer_List.RecordSource = ''
		IF USED('Customer_List')
			USE IN Customer_List
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		*cSQL = "SELECT * FROM dbo.Customer_List ORDER BY Customer"
		cSQL = "SELECT CL.* "
		*cSQL = cSQL + ", dbo.f_GetLastCall_CustomerID(CL.CustomerID) AS [LastCall]"
		*cSQL = cSQL + ", LEFT(dbo.f_GetWho_CustomerID(CL.CustomerID),30) AS [Who]"
		cSQL = cSQL + " FROM dbo.Customer_List CL "
		cSQL = cSQL + " ORDER BY CustomerID"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'Customer_List')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'Customer_List' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "Customer_List")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'Customer_List' )
		ENDIF
		
		IF USED('Customer_List')
		
			INDEX ON CustomerID TAG CustomerID
			INDEX ON CustomerName TAG CustomerNa
		*	INDEX ON LastCall TAG LastCall
			
			DO CASE
			CASE ThisForm.ogCustomer_List.Value = 1
				SET ORDER TO TAG CustomerID
			CASE ThisForm.ogCustomer_List.Value = 2
				SET ORDER TO TAG CustomerNa
			CASE ThisForm.ogCustomer_List.Value = 3
		*		SET ORDER TO TAG LastCall
			ENDCASE	
			
			ThisForm.grdCustomer_List.RecordSource = 'Customer_List'
			ThisForm.grdCustomer_List.Visible = .T.
		ELSE
			ThisForm.grdCustomer_List.Visible = .F.
		ENDIF
	ENDPROC

	PROCEDURE refresh_customer_list_txt
		PARAMETERS pWhat
		*ThisForm.Refresh_Customer_List_TXT('ShowOnly')
		SELECT Customer_List
		
		
		ThisForm.txtCustomerName.Value = Customer_List.CustomerName
		ThisForm.txtCustomerID.Value = Customer_List.CustomerID
		ThisForm.txtAddr1.Value = Customer_List.Addr1
		ThisForm.txtAddr2.Value = Customer_List.Addr2
		ThisForm.txtCity.Value = Customer_List.City
		ThisForm.txtST.Value = Customer_List.ST
		ThisForm.txtCountry.Value = Customer_List.Country
		
		ThisForm.chkStandTerms.Value = Customer_List.StandTerms
		ThisForm.chkCODTerms.Value = Customer_List.CODTerms
		ThisForm.chkPrePaid.Value = Customer_List.PrePaid
		
		ThisForm.txtTelePhone.Value = Customer_List.TelePhone
		
		ThisForm.txtCredit_Info.Value = Customer_List.Credit_Info
		ThisForm.txtMisc_Info.Value = Customer_List.Misc_Info
		ThisForm.txtCreditLimit.Value = Customer_List.CreditLimit
		
		ThisForm.txtCustomerSince.Value = Customer_List.CustomerSince
		ThisForm.txtLastInvoice.Value = Customer_List.LastInvoice
		
		ThisForm.txtWho.Value 	= GetWho_CustomerID( Customer_List.CustomerID, ThisForm.nConnHandle )
		ThisForm.txtLastCall.Value = DTOC(GetLastCall_CustomerID( Customer_List.CustomerID, ThisForm.nConnHandle ))
		
		
		PRIVATE nQuickCompanyID
		nQuickCompanyID = QuickCompany.AcctingID
		
		IF VARTYPE(pWhat) = 'C'
			IF pWhat = 'ShowOnly'
				*Do not move in QuickCompany
				RETURN
			ENDIF
		ENDIF
		
		PRIVATE nQuickCompany_No
		nQuickCompany_No = RECNO('QuickCompany')
		SEEK (Customer_List.CustomerID) ORDER TAG Customer IN QuickCompany
		ThisForm.grdQuickCompany.Refresh
		
		*******************
		IF NOT USED('tmpQC_1')
			ThisForm.Refresh_QuickCompany_TXT(Customer_List.CustomerID)
		ENDIF
		
		IF USED('tmpQC_1')	
			IF RECCOUNT('tmpQC_1')>0
				*ThisForm.Refresh_quickcompany_txt()
				ThisForm.txtQCustomer.Value = tmpQC_1.Customer
				ThisForm.txtQuickCompany.Value = tmpQC_1.Company
				ThisForm.txtName.Value = tmpQC_1.Name
				ThisForm.txtPhone.Value = tmpQC_1.Phone
				ThisForm.txtPhone_Ext.Value = tmpQC_1.Phone_Ext
				ThisForm.txtCountryC.Value = tmpQC_1.countryc
				ThisForm.txtLastEdit.Value = tmpQC_1.LastEdit
				ThisForm.txtID.Value = PrepareSQLnum(tmpQC_1.ID,'ID',-3)
				
				ThisForm.cmbPU.Value = tmpQC_1.PU
				
				ThisForm.QuickCompanyNotes.Value = ShowSQLtxt(tmpQC_1.Notes,'Notes',-3)
			ELSE
				ThisForm.txtQCustomer.Value = ''
				ThisForm.txtQuickCompany.Value = ''
				ThisForm.txtName.Value = ''
				ThisForm.txtPhone.Value = ''
				ThisForm.txtPhone_Ext.Value = ''
				ThisForm.txtCountryC.Value = ''
				ThisForm.txtLastEdit.Value = ''
				ThisForm.txtID.Value = 0
				
				ThisForm.cmbPU.Value = ''
				
				ThisForm.QuickCompanyNotes.Value = ''
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE refresh_quickcompany
		PARAMETERS pnID
		
		*ThisForm.Refresh_QuickCompany()
		ThisForm.grdQuickCompany.RecordSource = ''
		
		IF USED('QuickCompany')
			SELECT QuickCompany
			IF pnID = -1
				IF NOT BOF('QuickCompany')	
					SKIP -1
					*pnID = QuickCompany.ID
					pnID = PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
				ENDIF
			ENDIF
			USE IN QuickCompany
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT DISTINCT QC.Customer,QC.Company,QC.[Name],QC.[email], QC.[Phone] ,QC.[ID]"
		cSQL = cSQL + ",(SELECT CustomerID FROM dbo.Customer_List WHERE CustomerID = QC.Customer ) AS AcctingID "
		cSQL = cSQL + " FROM dbo.QuickCompany QC "
		cSQL = cSQL + " ORDER BY QC.Company, QC.[Name], QC.[email] "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'QuickCompany')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'QuickCompany' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "QuickCompany")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "QuickCompany")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'QuickCompany' )
		ENDIF
		
		IF USED('QuickCompany')
		
			INDEX ON Customer TAG Customer
			INDEX ON Company TAG Company
		*	INDEX ON CustomerID TAG CustomerID
			
			DO CASE
			CASE ThisForm.ogQuickCompany.Value = 1
				SET ORDER TO TAG Customer
			CASE ThisForm.ogQuickCompany.Value = 2
				SET ORDER TO TAG Company
			CASE ThisForm.ogQuickCompany.Value = 3
		*		SET ORDER TO TAG CustomerID
			ENDCASE	
			
			IF VARTYPE(pnID) = "N"
				LOCATE FOR ID = pnID
			ENDIF
			ThisForm.grdQuickCompany.RecordSource = 'QuickCompany'
			ThisForm.grdQuickCompany.Visible = .T.
			
			*ThisForm.grdQuickCompany.SetAll("dynamicbackcolor", "IIF(ISNULL(QuickCompany.Customer),RGB( 255, 255, 255 ),RGB( 128,255,128 ))", "Column")
			ThisForm.grdQuickCompany.SetAll("dynamicbackcolor", "IIF(ISNULL(QuickCompany.Customer),RGB( 255, 255, 255 ),IIF(EMPTY(QuickCompany.Customer),RGB( 255, 255, 255 ),RGB( 128,255,128 )))", "Column")
			
		ELSE
			ThisForm.grdQuickCompany.Visible = .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE refresh_quickcompany_txt
		PARAMETERS pWhat
		*ThisForm.Refresh_QuickCompany_TXT()
			
		SELECT QuickCompany
		
		PRIVATE cCustomer,cCompany,cName,cEmail
		cCustomer	= PrepareSQLtxt(QuickCompany.Customer,'Customer',20)
		cCompany	= PrepareSQLtxt(QuickCompany.Company,'Company',30)
		cName		= PrepareSQLtxt(QuickCompany.Name,'Name',25)
		cEmail		= PrepareSQLtxt(QuickCompany.Email,'Email',60)
		PRIVATE cCustID
		cCustID = ''
		
		
		IF VARTYPE(pWhat) = 'C'
			IF pWhat != 'ShowOnly'
				*Customer_List.CustomerID was sent
				cCustID = PrepareSQLtxt(pWhat,'CustomerID ',20)
			ENDIF
		ENDIF
		
		IF USED('tmpQC_1')
			USE IN tmpQC_1
		ENDIF
		
		SELECT 0
		PRIVATE cSQL, nSQLEXEC
		
		cSQL = "SELECT TOP 1 QC.* "
		cSQL = cSQL + " FROM dbo.QuickCompany QC "
		IF LEN(cCustID) = 0
			cSQL = cSQL + " WHERE QC.Customer = '"+cCustomer+"'"
			cSQL = cSQL + " AND QC.Company = '"+cCompany+"'"
			cSQL = cSQL + " AND QC.Name = '"+cName+"'"
			cSQL = cSQL + " AND QC.Email = '"+cEmail+"'"
		ELSE
			cSQL = cSQL + " WHERE QC.Customer = '"+cCustID+"'"
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpQC_1')
		
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpQC_1' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQC_1")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpQC_1")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF
		IF nSQLEXEC < 0
			SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpQC_1' )
		ENDIF
		
		IF USED('tmpQC_1')
			ThisForm.txtQCustomer.Value = tmpQC_1.Customer
			ThisForm.txtQuickCompany.Value = ShowSQLtxt(tmpQC_1.Company,'Company',30)
			ThisForm.txtName.Value = tmpQC_1.Name
			ThisForm.txtPhone.Value = tmpQC_1.Phone
			ThisForm.txtPhone_Ext.Value = tmpQC_1.Phone_Ext
			ThisForm.txtCountryC.Value = tmpQC_1.countryc
			ThisForm.txtLastEdit.Value = tmpQC_1.LastEdit
			ThisForm.txtID.Value = tmpQC_1.ID
			
			ThisForm.cmbPU.Value = tmpQC_1.PU
			
			ThisForm.QuickCompanyNotes.Value = ShowSQLtxt(tmpQC_1.Notes,'Notes',-3)
			*ThisForm.RefreshQuickCompanyNotes(tmpQC_1.ID)
			
			IF EMPTY(ShowSQLtxt(tmpQC_1.Company,'Company',30))
				*Search for CustID
				
				IF NOT EMPTY(tmpQC_1.Company)
					cCustID = GetCustomerIDCustomer(tmpQC_1.Company,ThisForm.nConnHandle)  
					IF NOT EMPTY(cCustID)
						ThisForm.txtTryCustID.Value = cCustID
					ELSE
						ThisForm.txtTryCustID.Value = ''
					ENDIF
				ELSE
					ThisForm.txtTryCustID.Value = ''
				ENDIF
			ELSE
				ThisForm.txtTryCustID.Value = tmpQC_1.Customer
			ENDIF
			
		ELSE
			ThisForm.txtQuickCompany.Value = ''
			ThisForm.txtQCustomer.Value = ''
			ThisForm.txtName.Value = ''
			ThisForm.txtPhone.Value = ''
			ThisForm.txtPhone_Ext.Value = ''
			ThisForm.txtCountryC.Value = ''
			ThisForm.txtLastEdit.Value = ''
			ThisForm.txtID.Value = 0
			
			ThisForm.cmbPU.Value = ''
			
			ThisForm.QuickCompanyNotes.Value = ''
			ThisForm.txtTryCustID.Value = ''
		ENDIF
		
		
			
		
		
		IF VARTYPE(pWhat) = 'C'
			IF pWhat = 'ShowOnly'
				*Do not move in Customer_List
				RETURN
			ENDIF
		ENDIF
		
		PRIVATE nCustomer_List_No
		nCustomer_List_No = RECNO('Customer_List')
		
		IF NOT EMPTY(QuickCompany.Customer)
		
			SEEK (QuickCompany.Customer) ORDER TAG CustomerID IN Customer_List
			IF FOUND('Customer_List')
				*ThisForm.Refresh_Customer_List_txt()
				*ThisForm.cmdCopyCustomerID.Enabled = .F.
			ELSE
				IF nCustomer_List_No <= RECCOUNT('Customer_List')
					GOTO nCustomer_List_No IN Customer_List
				ENDIF
				*ThisForm.cmdCopyCustomerID.Enabled = .T.
			ENDIF
		ELSE
			IF NOT EMPTY(cCustID)
			
				SEEK (cCustID) ORDER TAG CustomerID IN Customer_List
				
				IF NOT FOUND('Customer_List')
					IF nCustomer_List_No <= RECCOUNT('Customer_List')
						GOTO nCustomer_List_No IN Customer_List
					ENDIF
				ENDIF
			
			ELSE
				*Check by Company not CustID
				SEEK (QuickCompany.Company) ORDER TAG CustomerNa IN Customer_List
				
				IF NOT FOUND('Customer_List')
					IF nCustomer_List_No <= RECCOUNT('Customer_List')
						GOTO nCustomer_List_No IN Customer_List
					ENDIF
				ENDIF
				
			ENDIF	
		ENDIF
		
		ThisForm.Refresh_Customer_List_TXT('ShowOnly')
		
	ENDPROC

	PROCEDURE Unload
		IF USED('Customer_List')
			USE IN Customer_List
		ENDIF
		
		IF USED('QuickCompany')
			USE IN QuickCompany
		ENDIF
		
		IF USED('ShipAddr')
			USE IN ShipAddr
		ENDIF
		
		IF USED('SoldAddr')
			USE IN SoldAddr
		ENDIF
		
		
		= SQLDISCONNECT(ThisForm.nConnHandle)
	ENDPROC

	PROCEDURE cmbPU.Valid
		
		PRIVATE nQCID, nPU
		nQCID = QuickCompany.ID
		nQCID = PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		nPU	= PrepareSQLnum(ThisForm.cmbPU.Value,'PU',1)
		
		IF nPU >= 0 AND nPU < 6
			cSQL = "UPDATE dbo.QuickCompany SET PU="+STR(nPU)+" WHERE ID ="+STR(nQCID)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, '' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC  )
			ENDIF
			
		ENDIF
	ENDPROC

	PROCEDURE cmdCopyCustomerID.Click
		PRIVATE cQCCompany, nQCID, cQCCustomer, cQCPhone
		cQCCompany 	= QuickCompany.Company
		*nQCID		= QuickCompany.ID
		nQCID 		= PrepareSQLnum(ThisForm.txtID.Value,'ID',-3)
		cQCCustomer	= QuickCompany.Customer
		cQCPhone	= STRTRAN(QuickCompany.Phone,'-','')
		
		PRIVATE cCLCustomer, cCLCustomerName, cCLPhone
		cCLCustomer		= PrepareSQLtxt(Customer_List.CustomerID,'Customer',20)
		cCLCustomerName	= PrepareSQLtxt(Customer_List.CustomerName,'CustomerName',30)
		cCLPhone		= PrepareSQLtxt(STRTRAN(Customer_List.Telephone,'-',''),'Phone',10)
		
		PRIVATE cMess
		IF NOT EMPTY(ALLTRIM(cCLCustomer))
			cMess = "Are you sure you want to store "+CHR(13)+"'CustomerID="+ALLTRIM(cCLCustomer)+"'"+CHR(13)+"where 'Company="+ALLTRIM(cQCCompany)+CHR(13)+"equals 'CustomerName="+ALLTRIM(cCLCustomerName)+"'" 
		ELSE
			cMess = "Are you sure you want to overwrite "+CHR(13)+"'CustomerID="+ALLTRIM(cQCCustomer)+CHR(13)+"with 'CustomerID="+ALLTRIM(cCLCustomer)+"'"+CHR(13)+"where 'Company="+ALLTRIM(cQCCompany)+CHR(13)+"equals 'CustomerName="+ALLTRIM(cCLCustomerName)+"'" 
		ENDIF
		
		cMess = cMess +CHR(13)+CHR(13)+"Only the ONE record across from Customer List will be updated in Quick Company!"
		
		IF MESSAGEBOX(cMess,4+32,"Copy Customer to Quick Company") = 6
			cSQL = "UPDATE dbo.QuickCompany SET Customer='"+cCLCustomer+"' WHERE ID ="+STR(nQCID)
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC  )
			ENDIF
			
		*!*		PRIVATE lPhone 
		*!*		lPhone = .F.
		*!*		
		*!*		cMess = "Do you want to update all the Quotes with this "+CHR(13)+"'Accounting' CustomerID?"+CHR(13)+CHR(13)+"Only Quotes with this same Company name '"+ALLTRIM(cQCCompany )+"'"+CHR(13)
		*!*		IF NOT EMPTY(cCLPhone) AND NOT EMPTY(cQCPhone)
		*!*			IF LEFT(cCLPhone,6) = LEFT(cQCPhone,6)
		*!*				cMess = cMess+"and Phone number '"+LEFT(cCLPhone,6)+"' will be updated."
		*!*				lPhone = .T.
		*!*			ENDIF	
		*!*		ENDIF
			
			IF MESSAGEBOX("Do again, Update with All of AllQuotes?" ,4+32, "Update CustomerID in AllQuotes") = 6
		
				cSQL = "UPDATE dbo.AllQuotes "
				cSQL = cSQL + " SET CustID=QC.Customer "
				cSQL = cSQL + " FROM dbo.QuickCompany QC "
				cSQL = cSQL + " WHERE AllQuotes.Company = QC.Company "
		*		IF lPhone
		*			cSQL = cSQL + " AND LEFT(AllQuotes.Phone,6) = LEFT(QC.Phone,6) "
				cSQL = cSQL + " AND AllQuotes.Phone = QC.Phone "
		*		ENDIF
				cSQL = cSQL + " AND AllQuotes.CountryC = QC.CountryC "
				cSQL = cSQL + " AND AllQuotes.Fax = QC.Fax "
				cSQL = cSQL + " AND QC.Customer = '"+cCLCustomer+"'"
				
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL  )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC  )
				ENDIF
			ENDIF
		
			ThisForm.Refresh_Quickcompany(-1)  &&go to previous -1
		
		ELSE
			WAIT WINDOW "No Change made!" NOWAIT
		ENDIF
		
		*ThisForm.grdCustomer_List.Refresh
		*ThisForm.Refresh_Customer_List_TXT()
	ENDPROC

	PROCEDURE cmdFindCompany.Click
		PRIVATE nCustomer_ListSort
		nCustomer_ListSort = ThisForm.ogCustomer_List.Value
		IF nCustomer_ListSort != 2
			SELECT Customer_List
			SET ORDER TO TAG CustomerNa
			ThisForm.ogCustomer_List.Value = 2
			ThisForm.grdCustomer_List.Refresh
		ENDIF
		
		PRIVATE cCompany, cCustomer
		cCompany = QuickCompany.Company
		cCustomer = QuickCompany.Customer
		
		SELECT Customer_List 
		SEEK cCustomer ORDER TAG CustomerID
		
		IF NOT FOUND('Customer_List')
		
			LOCATE FOR CustomerName = cCompany 
		
			IF NOT FOUND()
				LOCATE FOR ALLTRIM(CustomerName) = ALLTRIM(cCompany )
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerName,10) = LEFT(cCompany,10)
			ENDIF
		**********************************************************************************	
			*Do a SQL check
			IF USED('tmpSearchCustomer_List')
				USE IN tmpSearchCustomer_List
			ENDIF
		
			SELECT 0
			PRIVATE cSQL, nSQLEXEC
		
			cSQL = "SELECT CustomerID "
			cSQL = cSQL + " FROM dbo.Customer_List CL "
			cSQL = cSQL + " WHERE dbo.f_CompanyStandard(CustomerName) "
			cSQL = cSQL + " = dbo.f_CompanyStandard('"+cCompany+"')"
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearchCustomer_List')
		
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpSearchCustomer_List' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearchCustomer_List")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearchCustomer_List")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL, ThisForm.nConnHandle, nSQLEXEC, 'tmpSearchCustomer_List' )
			ENDIF
		
			IF USED('tmpSearchCustomer_List')
				IF NOT EOF('tmpSearchCustomer_List')
					cCustomerID = tmpSearchCustomer_List.CustomerID
					SELECT Customer_List
					SEEK cCustomer ORDER TAG CustomerID
				ENDIF
				USE IN tmpSearchCustomer_List
				SELECT Customer_List
			ENDIF
		**********************************************************************************	
			
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerName,8) = LEFT(cCompany,8)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerName,6) = LEFT(cCompany,6)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerName,5) = LEFT(cCompany,5)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerName,4) = LEFT(cCompany,4)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerName,3) = LEFT(cCompany,3)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerName,2) = LEFT(cCompany,2)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerName,1) = LEFT(cCompany,1)
			ENDIF
		ENDIF
		
		ThisForm.grdCustomer_List.Refresh
		ThisForm.Refresh_Customer_List_TXT('ShowOnly')
	ENDPROC

