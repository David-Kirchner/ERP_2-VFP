					ThisForm.Refresh_quickcompany_txt('ShowOnly')
		
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

