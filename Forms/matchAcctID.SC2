	PROCEDURE txtpCustomer.Click
		*!*	PRIVATE nCustomer_ListSort
		*!*	nCustomer_ListSort = ThisForm.ogCustomer_List.Value
		*!*	IF nCustomer_ListSort != 2
		*!*		SELECT Customer_List
		*!*		SET ORDER TO TAG CustomerNa
		*!*		ThisForm.ogCustomer_List.Value = 2
		*!*		ThisForm.grdCustomer_List.Refresh
		*!*	ENDIF
		
		PRIVATE cCustomer
		cCustomer = This.Value
		
		SELECT Customer_List 
		SEEK cCustomer ORDER TAG CustomerID
		
		IF NOT FOUND('Customer_List')
		
			LOCATE FOR CustomerID  = cCustomer  
		
			IF NOT FOUND()
				LOCATE FOR ALLTRIM(CustomerID ) = ALLTRIM(cCustomer  )
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerID ,10) = LEFT(cCustomer ,10)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerID ,8) = LEFT(cCustomer ,8)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerID ,6) = LEFT(cCustomer ,6)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerID ,5) = LEFT(cCustomer ,5)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerID ,4) = LEFT(cCustomer ,4)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerID ,3) = LEFT(cCustomer ,3)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerID ,2) = LEFT(cCustomer ,2)
			ENDIF
			IF NOT FOUND()
				LOCATE FOR LEFT(CustomerID ,1) = LEFT(cCustomer ,1)
			ENDIF
		ENDIF
		
		ThisForm.grdCustomer_List.Refresh
		ThisForm.Refresh_Customer_List_TXT()
	ENDPROC

