		Case nSearch_in = 10
			cSQL_field = "form "
			ThisForm.oGrp_search_how.optEquals.Enabled = .T.
			ThisForm.oGrp_search_how.optContains.Enabled = .T.
			ThisForm.oGrp_search_how.optBetween.Enabled = .T.
			ThisForm.txt_search_text.MaxLength = 2
			ThisForm.txt_search_max.MaxLength = 2
			ThisForm.txt_search_text.InputMask = '99'
			ThisForm.txt_search_max.InputMask  = '99'
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 11
			cSQL_field = "thck "
			ThisForm.oGrp_search_how.optEquals.Enabled = .T.
			ThisForm.oGrp_search_how.optContains.Enabled = .F.
			ThisForm.oGrp_search_how.optBetween.Enabled = .T.
			ThisForm.txt_search_text.MaxLength = 7
			ThisForm.txt_search_max.MaxLength = 7
			ThisForm.txt_search_text.InputMask = 'XXXXXXX'
			ThisForm.txt_search_max.InputMask  = 'XXXXXXX'
			ThisForm.lIsNumber = .T.
		Case nSearch_in = 12
			cSQL_field = "email "
			ThisForm.oGrp_search_how.optEquals.Enabled = .F.
			ThisForm.oGrp_search_how.optContains.Enabled = .T.
			ThisForm.oGrp_search_how.Value = 2
			
			ThisForm.oGrp_search_how.optBetween.Enabled = .F.
			ThisForm.txt_search_text.MaxLength = 25
			ThisForm.txt_search_max.MaxLength = 25
			ThisForm.txt_search_text.InputMask = 'XXXXXXXXXXXXXXXXXXXXXXXX'
			ThisForm.txt_search_max.InputMask  = 'XXXXXXXXXXXXXXXXXXXXXXXX'
			ThisForm.txt_search_max.Enabled = .F.
			ThisForm.lIsNumber = .F.
		ENDCASE
		
		ThisForm.SearchedEmail = .F. &&reset here- after the search it is set to .T.
		
		IF ThisForm.lIsNumber != lWasNumber
			*Changed 
			*ThisForm.txt_search_text.value = ""
		ENDIF
	ENDPROC

	PROCEDURE ogrp_search_in.Valid
		ThisForm.txt_search_text.setfocus
	ENDPROC

	PROCEDURE ogView.oAll.Valid
		ThisForm.cmdSelect.Enabled = .T.
		ThisForm.cmdSelect.Visible = .T.
		ThisForm.Grid1.RecordSource = ""
		ThisForm.Grid1.Enabled = .F.
		ThisForm.Grid1.Visible = .F.
		*ThisForm.SelectRecordDisplay("OFF")
		*ThisForm.txt_search_text.SetFocus
		IF NOT EMPTY(ThisForm.txt_search_text.Value)
			*Check to see if correct type of variable 
			ThisForm.cmdcmdSearch.Click()
		ENDIF
		ThisForm.txt_search_text.setfocus
	ENDPROC

	PROCEDURE ogView.oSalesP.Valid
		ThisForm.cmdSelect.Enabled = .T.
		ThisForm.cmdSelect.Visible = .T.
		ThisForm.Grid1.RecordSource = ""
		ThisForm.Grid1.Refresh()
		ThisForm.SelectRecordDisplay("OFF")
		IF NOT EMPTY(ThisForm.txt_search_text.Value)
			ThisForm.cmdcmdSearch.Click()
		ENDIF
		ThisForm.txt_search_text.SetFocus
	ENDPROC

	PROCEDURE txt_search_text.Valid
		PRIVATE  m.txt
		m.txt = ""
		
		
		
		DO CASE 
		CASE ThisForm.Search_In = 1
		*	cSQL_field = "company "
		CASE ThisForm.Search_In = 2
		*	cSQL_field = "name "
		CASE ThisForm.Search_In = 3
		*	cSQL_field = "alloy "
		
			PRIVATE pCurAlloy,cAlloyStandard
			pCurAlloy= ALLTRIM(This.Value)
		
			IF NOT EMPTY(pcuralloy)
				cAlloyStandard = GetAlloyStandard( pCurAlloy, ThisForm.nConnHandle )
				
				IF NOT EMPTY(cAlloyStandard)
					This.Value = cAlloyStandard
					THIS.FORECOLOR = RGB(0,0,0)
					RETURN .T.
				ELSE
					THIS.FORECOLOR = RGB(255,128,128)
					RETURN .F.
				ENDIF
				
			ENDIF
		
		CASE ThisForm.Search_In = 4
		*	cSQL_field = "PO_NUM "
		CASE ThisForm.Search_In = 5
		*	cSQL_field = "SalesNum "
			ThisForm.lIsNumber = .T.
		CASE ThisForm.Search_In = 6
		*	cSQL_field = "phone "
		CASE ThisForm.Search_In = 7
		*	cSQL_field = "HPApo "
			ThisForm.lIsNumber = .T.
		CASE ThisForm.Search_In = 8
		*	cSQL_field = "descript "
		CASE ThisForm.Search_In = 9
		*	cSQL_field = "comment "
		CASE ThisForm.Search_In = 10
		*	cSQL_field = "form "
		*	FormDescription( pcFormNumber, Zform )
		 m.txt = FormDescription( This.Value )
		 IF !EMPTY( m.txt)
		 	Wait WINDOW m.txt NOWAIT
		 ELSE
		 	m.txt = FormDescription( '01' )
		 	MESSAGEBOX( m.txt, 0 ,"Form")
		 ENDIF
		CASE ThisForm.Search_In = 11
		*	cSQL_field = "thck "
			ThisForm.lIsNumber = .T.
		
		CASE ThisForm.Search_In = 12
		*	cSQL_field = "eMail "
			ThisForm.lIsNumber = .F.
		ENDCASE
		
		
		
		
	ENDPROC

ENDDEFINE
