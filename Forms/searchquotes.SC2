	PROCEDURE oGrp_search_how.InteractiveChange
		PRIVATE  nSearch_how
		nSearch_how = This.Value
		
		Do Case
		Case nSearch_how = 1
			*Equals
			ThisForm.txt_search_max.Enabled = .F.
			ThisForm.txt_search_text.SetFocus()
		Case nSearch_how = 2
			*Contains
			ThisForm.txt_search_max.Enabled = .F.
			ThisForm.txt_search_text.SetFocus()
		Case nSearch_how = 3
			*Between
			ThisForm.txt_search_max.Enabled = .T.
			ThisForm.txt_search_max.SetFocus()
		ENDCASE
		
	ENDPROC

	PROCEDURE ogrp_search_in.InteractiveChange
		PRIVATE  nSearch_in, cSQL_field
		nSearch_in = This.Value
		
		PRIVATE lWasNumber
		lWasNumber = ThisForm.lIsNumber
		
		ThisForm.Search_in = nSearch_in
		ThisForm.txt_search_max.Value = ''
		ThisForm.txt_search_max.Enabled = .F.
		
		Do Case
		Case nSearch_in = 1
			cSQL_field = "company "
			ThisForm.oGrp_search_how.optEquals.Enabled = .T.
			ThisForm.oGrp_search_how.optContains.Enabled = .T.
			ThisForm.oGrp_search_how.optBetween.Enabled = .T.
			ThisForm.txt_search_text.MaxLength = 30
			ThisForm.txt_search_max.MaxLength = 30
			ThisForm.txt_search_text.InputMask = 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
			ThisForm.txt_search_max.InputMask  = 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 2
			cSQL_field = "name "
			ThisForm.oGrp_search_how.optEquals.Enabled = .T.
			ThisForm.oGrp_search_how.optContains.Enabled = .T.
			ThisForm.oGrp_search_how.optBetween.Enabled = .T.
			ThisForm.txt_search_text.MaxLength = 25
			ThisForm.txt_search_max.MaxLength = 25
