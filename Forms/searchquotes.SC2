	PROCEDURE getsql_field		&& Return Field from
		
		*"QUOTES"
		Do Case
		Case nSearch_in = 1
			cSQL_field = "company "
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 2
			cSQL_field = "name "
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 3
			cSQL_field = "alloy "
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 4
			cSQL_field = "PO_NUM "
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 5
			cSQL_field = "SalesNum "
			ThisForm.lIsNumber = .T.
		Case nSearch_in = 6
			cSQL_field = "phone "
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 7
			cSQL_field = "hpapo "
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 8
			cSQL_field = "descript "
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 9
			cSQL_field = "comments "
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 10
			cSQL_field = "form "
			ThisForm.lIsNumber = .F.
		Case nSearch_in = 11
			cSQL_field = "thck "
			ThisForm.lIsNumber = .T.
		Case nSearch_in = 12
			cSQL_field = "email "
			ThisForm.lIsNumber = .F.
		Endcase
		
		
		Return cSQL_field
		
	ENDPROC

	PROCEDURE getsql_where		&& Compose the WHERE string.
		PARAMETER pSQL_Field
		*GetSQL_Where()
		
		PRIVATE cSearchText,cSearchMax
		cSearchText = ALLTRIM(ThisForm.txt_search_text.Value)
		cSearchMax	= ALLTRIM(ThisForm.txt_search_max.Value)
		
		*ThisForm.lIsNumber = ThisForm.IsFieldNumber( pSQL_field )
		
		IF ThisForm.lIsNumber
			nDecimal = SET("DECIMAL")
			SET DECIMALS TO 4
			
			DO CASE
			CASE nSearch_how = 1
				IF pSQL_field = "thck "
					cSQL_where = pSQL_field + " = " + STR(VAL(cSearchText),9,4)
				ELSE
					cSQL_where = pSQL_field + " = " + STR(VAL(cSearchText))
				ENDIF
			CASE nSearch_how = 2
				IF pSQL_field = "thck "
					cSQL_where = pSQL_field + " LIKE '" + STR(VAL(cSearchText),9,4) + "%'"
				ELSE
					cSQL_where = pSQL_field + " LIKE '" + STR(VAL(cSearchText)) + "%'"
				ENDIF
				*.cSQL_where = cSearchText + " $ " + pSQL_field 
			CASE  nSearch_how = 3
				IF VAL(cSearchMax) < VAL(cSearchText)
					MESSAGEBOX( "Enter the lower value first, when searching BETWEEN",0+48,"Min is greater than Max.")
				ENDIF
				IF pSQL_field = "thck "
					cSQL_where = pSQL_field + " >= " + STR(VAL(cSearchText),9,4) + " AND " + pSQL_field + " <= " + STR(VAL(cSearchMax),9,4)
				ELSE
					cSQL_where = pSQL_field + " >= " + STR(VAL(cSearchText)) + " AND " + pSQL_field + " <= " + STR(VAL(cSearchMax))
				ENDIF
			ENDCASE
			
			SET DECIMALS TO nDecimal
		ELSE
			cSearchText = STRTRAN(cSearchText,"'","''")
			DO CASE
			CASE nSearch_how = 1
				*.cSQL_where = " " + pSQL_field + " = '" + cSearchText +"'"
		  		  cSQL_where = " " + pSQL_field + " LIKE '" + cSearchText +"%'"
			CASE nSearch_how = 2
				*.cSQL_where = '"' + cSearchText + '" $ UPPER(' + pSQL_field + ")"
				  cSQL_where = " " + pSQL_field + " LIKE '%" + cSearchText +"%'"
			CASE  nSearch_how = 3
				cSQL_where = pSQL_field + " >= '" + cSearchText + "' AND "+ pSQL_field + " <= '" + cSearchMax + "'"	
			ENDCASE
		ENDIF
		
		RETURN cSQL_where
	ENDPROC

	PROCEDURE Init
		PARAMETERS cText, cInitCompany
		*Do Forms\SearchQuotes WITH "QUOTES","" TO cInqnumP
		
		IF TYPE('cText') = "L"
			WAIT WINDOW "No parameter, using QUOTES as default"
			cText = "QUOTES"
		ENDIF
		
		This.Caption = This.Caption + " "+ cText
		This.cSearchTable = cText
		
		IF TYPE('cInitCompany') = "C"
			ThisForm.txt_search_text.Value = ALLTRIM(cInitCompany)
		ENDIF
		
		PUBLIC cCurrentDBF
		cCurrentDBF = ALIAS()
		
		IF VARTYPE(gcSalesp)!="C"
			PUBLIC gcSalesp
			IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
				RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
				IF TYPE("SALESP") = "C"
					gcSalesp = SALESP
				ELSE
					gcSalesp = ""
				ENDIF
			ELSE
				IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
					RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
					IF TYPE("SALESP") = "C"
						gcSalesp = SALESP
					ELSE
						gcSalesp = ""
					ENDIF
				ELSE
					IF USED("Quotes")
						gcSalesp = Quotes.SalesP
					ELSE
						gcSalesp = ""
					ENDIF
				ENDIF
			ENDIF
		ELSE
			IF EMPTY(gcSalesp)
				IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
					RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
					IF TYPE("SALESP") = "C"
						gcSalesp = SALESP
					ELSE
						gcSalesp = ""
					ENDIF
				ELSE
					IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
						RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
						IF TYPE("SALESP") = "C"
							gcSalesp = SALESP
						ELSE
							gcSalesp = ""
						ENDIF
					ELSE
						IF USED("Quotes")
							gcSalesp = Quotes.SalesP
						ELSE
							gcSalesp = ""
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		*!*	IF TYPE("ThisForm.nConnHandle") = "N"
		*!*		IF ThisForm.nConnHandle > 0
		*!*			ThisForm.lSetConn = .F.
		*!*		ELSE
		*!*			ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		*!*			ThisForm.lSetConn = .T.
		*!*		ENDIF		
		*!*	ELSE
		*!*		PUBLIC ThisForm.nConnHandle
		*!*		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
				ThisForm.lSetConn = .T.
		*!*	ENDIF
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
		ENDIF
		
		
		
		IF This.cSearchTable = "QUOTES"
			THISFORM.ogView.VALUE = 1
		ELSE
			THISFORM.ogView.VALUE = 2
		ENDIF
					
		IF TYPE('cInitCompany') = 'C'
			IF NOT EMPTY(ThisForm.txt_search_text.Value)
				ThisForm.cmdcmdSearch.Click
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE isfieldnumber		&& Logic, is this field to be treated as a number.
		PARAMETER pSQL_Field
		ThisForm.lIsNumber = .F.
		cSQL_field = UPPER( pSQL_field )
		DO CASE
			CASE cSQL_field = "COMPANY"
			CASE cSQL_field = "NAME"
			CASE cSQL_field = "ALLOY"
			CASE cSQL_field = "PO_NUM"
			CASE cSQL_field = "SALESNUM"
				ThisForm.lIsNumber = .T.
			CASE cSQL_field = "PHONE"
			CASE cSQL_field = "FAX"
			CASE cSQL_field = "DESCRIPT"
			CASE cSQL_field = "COMMENT"
			CASE cSQL_field = "FORM"
			CASE cSQL_field = "THCK"
				ThisForm.lIsNumber = .T.
			CASE cSQL_field = "HPAPO"
				ThisForm.lIsNumber = .T.		
		EndCase
		
		RETURN ThisForm.lIsNumber
	ENDPROC

	PROCEDURE Load
		
		IF NOT "QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "Proc_ERP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_ERP ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
	ENDPROC

	PROCEDURE quotes_dynamic_back_color
		PRIVATE nColor
		
		nColor = RGB( 255, 0, 0 ) &&RED
		
		
		RETURN nColor
	ENDPROC

	PROCEDURE Resize
		ThisForm.Grid1.Height = This.Height - ThisForm.shpOverAllBox.Height - 16
		*- 89 &&252 - 361 - 97 = 89
		ThisForm.Grid1.Width = This.Width - 12 &&609 - 621 = 12
	ENDPROC

	PROCEDURE searchnow
		PRIVATE cSQL_field, cSQL_where
		*nSearch_in
		cSQL_field = ThisForm.GetSQL_field()
		cSQL_where = ThisForm.GetSQL_where( cSQL_field )  
		*nSearch_in = THISFORM.oGrp_search_in.VALUE
		
		IF NOT EMPTY(ThisForm.editHoldAnd.Value)
			cSQL_where = cSQL_where + ThisForm.editHoldAnd.Value
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		SELECT 0
		DO CASE
		CASE UPPER(ThisForm.cSearchTable) = "ALLQUOTES"
			ThisForm.Grid1.RecordSource = ''
			cSQL="SELECT * FROM dbo.AllQuotes WHERE " + cSQL_where 
			*cSQL="SELECT * FROM dbo.AllQuotes WHERE " + cSQL_where + " ORDER BY " + cSQL_field + ",InqDate DESC "
			cSQL=cSQL + " ORDER BY InqDate DESC "
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, 'tmpSearch')
			ENDIF
			IF NOT USED('tmpSearch')
				ThisForm.Grid1.Enabled = .F.
				ThisForm.Grid1.Visible = .T.
				RETURN .F.
			ENDIF
			IF RECCOUNT('tmpSearch') > 0
				ThisForm.Grid1.Enabled = .T.
				ThisForm.Grid1.RecordSourceType = 1
				ThisForm.SetSortOrder()
				ThisForm.Grid1.RecordSource = 'tmpSearch'
				ThisForm.Grid1.Visible = .T.
				ThisForm.Grid1.Refresh()
				
				ThisForm.nReturnKey = tmpSearch.InqnumP
				ThisForm.cmdSelect.Enabled = .T.
				
				ThisForm.SetSortOrder()
				
			ELSE
				ThisForm.Grid1.Enabled = .F.
				ThisForm.cmdSelect.Enabled = .F.
				
				IF cSQL_field = "hpapo "
					PRIVATE nHPApo
					nHPApo = PrepareSQLnum(ThisForm.txt_search_text.Value,'HPApo',-3)
					IF Count_HPAPOinPurchaseOrder( nHpaPo, ThisForm.nConnHandle ) > 0
						MESSAGEBOX("This ERP PO was found,"+CHR(13)+"but not it is not associated with a Quote."+CHR(13)+"Please use PurchaseOrder program to view PO.",0+48,"Not Found")
					ENDIF
				ENDIF
			ENDIF
		CASE UPPER(ThisForm.cSearchTable) = "QUOTES"
			ThisForm.Grid1.RecordSource = ''
			IF EMPTY(gcSalesp)
				IF FILE(SYS(5)+SYS(2003) +"\SalesP.MEM")
					RESTORE FROM (SYS(5)+SYS(2003) +"\SalesP.MEM") ADDITIVE
					IF TYPE("SALESP") = "C"
						gcSalesp = SALESP
					ENDIF
				ELSE
					IF FILE(SYS(5)+SYS(2003) +"\MEM\SalesP.MEM")
						RESTORE FROM (SYS(5)+SYS(2003) +"\MEM\SalesP.MEM") ADDITIVE
						IF TYPE("SALESP") = "C"
							gcSalesp = SALESP
						ENDIF
					ELSE
						IF USED("Quotes")
							gcSalesp = Quotes.SalesP
						ELSE
							WAIT WINDOW "Enter your Inital! Type the Inital!" TO gcSalesp
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			cSQL ="SELECT * FROM dbo.AllQuotes WHERE SalesP = '"+ALLTRIM(gcSalesp)+"' AND " 
			cSQL = cSQL + cSQL_where 
			cSQL = cSQL + " ORDER BY InqDate DESC "
				
			IF ThisForm.ogrp_search_in.Value = 12
				IF ThisForm.SearchedEmail = .F.
					cSearchText = ALLTRIM(PrepareSQLtxt(THISFORM.txt_search_text.VALUE,'search_text',25))
					*Proc_ERP
					RFQ_EmailLog_TO(cSearchText,ThisForm.nConnHandle)
					ThisForm.SearchedEmail = .T.
				ENDIF
			ENDIF
			
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle, 'tmpSearch')
			ENDIF
			
			IF NOT USED('tmpSearch')
				ThisForm.Grid1.Enabled = .F.
				ThisForm.Grid1.Visible = .T.
				ThisForm.nReturnKey = "-"
				ThisForm.cmdSelect.Enabled = .F.
				
				RETURN .F.
			ENDIF
			IF RECCOUNT('tmpSearch') > 0
				ThisForm.Grid1.Enabled = .T.
				ThisForm.Grid1.RecordSourceType = 1
				ThisForm.SetSortOrder()
				ThisForm.Grid1.RecordSource = 'tmpSearch'
				ThisForm.Grid1.Visible = .T.
				ThisForm.Grid1.Refresh()
				ThisForm.nReturnKey = tmpSearch.InqnumP
				ThisForm.cmdSelect.Enabled = .T.
				
				ThisForm.SetSortOrder()
				
			ELSE
				ThisForm.Grid1.Enabled = .F.
				ThisForm.nReturnKey = "-"
				ThisForm.cmdSelect.Enabled = .F.
				
			ENDIF
		
		OTHERWISE
		*	cSQL_statement = "SELECT * FROM HPA!" + ThisForm.cSearchTable + " WHERE " + cSQL_where + " ORDER BY " + cSQL_field + ",InqDate DESC" + " NOCONSOLE INTO CURSOR tmpSearch"
			ThisForm.Grid1.Enabled = .F.
			ThisForm.Grid1.Visible = .T.
			ThisForm.nReturnKey = "-"
			ThisForm.cmdSelect.Enabled = .F.
		ENDCASE
		
		RETURN .T.
	ENDPROC

	PROCEDURE selectrecorddisplay
		Parameter cState
		IF cState = "ON"
		  IF ThisForm.ogView.Value = 2
		    ThisForm.cmdSelect.Enabled = .T.
			ThisForm.nReturnKey = ""
			ThisForm.cmdSelect.Visible = .T.
		  ELSE
			ThisForm.cmdSelect.Visible = .T.
			ThisForm.cmdSelect.Enabled = .T.
		  ENDIF
		ENDIF
		IF cState = "OFF"
			IF ThisForm.cmdSelect.Visible
				ThisForm.cmdSelect.Enabled = .F.
				This.nReturnKey = ""
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE setsortorder
		PRIVATE nCC
		
		
		IF NOT USED('tmpSearch')
			PRIVATE cSQL_field, cSQL_where
		
			cSQL_field = ThisForm.GetSQL_field()
			cSQL_where = ThisForm.GetSQL_where( cSQL_field )  
		
			IF NOT EMPTY(ThisForm.editHoldAnd.Value)
				cSQL_where = cSQL_where + ThisForm.editHoldAnd.Value
			ENDIF
		
			PRIVATE cSQL, nSQLEXEC 
			cSQL = "SELECT * FROM dbo.AllQuotes WHERE " + cSQL_where + " ORDER BY " + cSQL_field + ",InqDate DESC "
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpSearch')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpSearch")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF
			IF nSQLEXEC < 0
				SQLExecError(cSQL, ThisForm.nConnHandle,'tmpSearch')
			ENDIF
		ENDIF
		
		IF USED('tmpSearch')
			SELECT tmpSearch
			AFIELDS(ArrayFields ,"tmpSearch")
			nCC = ALEN( ArrayFields, 1 )
			ThisForm.Grid1.ColumnCount = nCC
		
			FOR i = 1 TO nCC
				cSTR = "ThisForm.Grid1.Column"+ALLTRIM(STR( i ))+".Header1.Caption"
				&cSTR = ArrayFields( i, 1)
			ENDFOR
		ENDIF
	ENDPROC

	PROCEDURE sortgrid
		PARAMETER pControlSource 
		
		PRIVATE nCurrRec, cField, cSafety
		cSafety = SET("SAFETY")
		SET SAFETY OFF
		cField = RIGHT( pControlSource, LEN(pControlSource) - AT(".", pControlSource ) )
		SELECT tmpSearch
		nCurrRec = RECNO('tmpSearch')
		
		*ThisForm.Grid1.RecordSource = ''
		
		IF ORDER() != UPPER(cField)
		*	INDEX ON &cField TO tmpSearch ASCENDING 
			INDEX ON &cField TAG &cField ASCENDING 
		ELSE
		*	INDEX ON &cField TO tmpSearch DESCENDING 
			INDEX ON &cField TAG &cField DESCENDING 	
		ENDIF
		*SET ORDER TO tmpSearch
		SET ORDER TO TAG &cField 
		
		*GOTO RECORD nCurrRec IN tmpSearch
		
		*ThisForm.Grid1.RecordSource = 'tmpSearch'
		
		ThisForm.Grid1.Refresh
		IF cSAFETY = "ON"
			SET SAFETY ON
		ENDIF
		
		
	ENDPROC

	PROCEDURE Unload
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		
		IF NOT EMPTY(cCurrentDBF)
			SELECT (cCurrentDBF)
		ENDIF
		
		IF ThisForm.lSetConn
			=SQLDISCONNECT(ThisForm.nConnHandle)
		ENDIF
		
		RETURN This.nReturnKey
	ENDPROC

	PROCEDURE cmdAddAnd.Click
		PRIVATE cSQL_field,cSearchText,nSearch_in,nSearch_how,cSQL_Add
		
		cSearchText = ALLTRIM(ThisForm.txt_search_text.Value)
		IF EMPTY(cSearchText)
			WAIT WINDOW "Enter the text to search for!"
			RETURN
		ENDIF
		
		nSearch_in = ThisForm.oGrp_search_in.Value
		nSearch_how = ThisForm.oGrp_search_how.Value
		
		cSQL_field = ThisForm.GetSQL_field()
		cSQL_Add = " AND " + ThisForm.GetSQL_where( cSQL_field ) 
		
		ThisForm.editHoldAnd.Value = ThisForm.editHoldAnd.Value + cSQL_Add 
		ThisForm.txt_search_text.Value = ''
		ThisForm.txt_search_max.Value = ''
	ENDPROC

	PROCEDURE cmdClearHold.Click
		ThisForm.editHoldAnd.Value = ""
		ThisForm.editHoldAnd.Refresh()
	ENDPROC

	PROCEDURE cmdcmdSearch.Click
		
		*Reset Selected row
		THISFORM.SelectRecordDisplay("OFF")
		
		PRIVATE cSearchText, nSearch_in, nSearch_how, cSearchTextOrig
		cSearchText = UPPER(ALLTRIM(THISFORM.txt_search_text.VALUE))
		nSearch_in = THISFORM.oGrp_search_in.VALUE
		nSearch_how = THISFORM.oGrp_search_how.VALUE
		cSearchTextOrig = cSearchText
		
		IF THISFORM.ogView.VALUE = 1
			THISFORM.cSearchTable = "Quotes"
		ELSE
			THISFORM.cSearchTable = "AllQuotes"
			*.IF NOT USED('AllQuotes')
			*.	USE HPA!Allquotes IN 0 SHARED
			*.ENDIF
			*.SELECT Allquotes
		ENDIF
		
		PRIVATE tmpSearchCount 
		DO CASE
		CASE nSearch_in = 5
			*5 SO 
			WAIT WINDOW "Searching for Sales No" NOWAIT
			*force All
			ThisForm.ogView.Value = 2
			THISFORM.cSearchTable = "AllQuotes"
			
			THISFORM.txt_search_text.VALUE = cSearchText
			IF PrepareSQLnum(cSearchText,'SalesNum',-3) > 0
				IF THISFORM.searchNow()
					WAIT WINDOW "DONE, Searching for Sales No" NOWAIT
				ENDIF
			ELSE
				THISFORM.txt_search_text.VALUE = '0'
			ENDIF
		CASE nSearch_in = 7
			*7 HPAPO
			WAIT WINDOW "Searching for ERP PO" NOWAIT
			*force All
			ThisForm.ogView.Value = 2
			THISFORM.cSearchTable = "AllQuotes"
			
			THISFORM.txt_search_text.VALUE = cSearchText
			IF PrepareSQLnum(cSearchText,'SalesNum',-3) > 0
				IF THISFORM.searchNow()
					WAIT WINDOW "DONE, Searching for ERP PO" NOWAIT
				ENDIF
			ELSE
				THISFORM.txt_search_text.VALUE = '0'
			ENDIF
			
		CASE nSearch_in = 3 OR nSearch_in = 4 OR nSearch_in = 5 OR nSearch_in = 10 
			*do not loop down the search
			*3 Alloy
			*4 PO
			*5 SO 
			*7 ERP PO
			*8 Desc
			*9 Comment
			*10 Form
			*11 THCK 
			*12 eMail
			THISFORM.txt_search_text.VALUE = cSearchText
			THISFORM.searchNow()
		OTHERWISE
			IF NOT ISNULL(cSearchText)
				THISFORM.SearchNow()
				IF LEN(cSearchText) > 0
					tmpSearchCount = 0
					IF USED('tmpSearch')
						tmpSearchCount = RECCOUNT("tmpSearch") 
					ENDIF
		
					DO WHILE tmpSearchCount = 0 ;
					  AND LEN(cSearchText) > 0 
						THISFORM.txt_search_text.VALUE = cSearchText
						THISFORM.searchNow()
						cSearchText = SUBSTR(cSearchText ,1, LEN(cSearchText )-1 )
						IF USED('tmpSearch')
							tmpSearchCount = RECCOUNT("tmpSearch") 
						ELSE
							tmpSearchCount = 0
						ENDIF
					ENDDO
				ELSE
					THISFORM.txt_search_text.VALUE = cSearchTextOrig
				ENDIF
		
			ENDIF
		ENDCASE
		
	ENDPROC

	PROCEDURE cmdExit.Click
		ThisForm.nReturnKey = "-"
		ThisForm.Release
	ENDPROC

	PROCEDURE cmdORadd.Click
		PRIVATE cSQL_field,cSearchText,nSearch_in,nSearch_how,cSQL_Add
		
		cSearchText = ALLTRIM(ThisForm.txt_search_text.Value)
		IF EMPTY(cSearchText)
			WAIT WINDOW "Enter the text to search for!"
			RETURN
		ENDIF
		
		nSearch_in = ThisForm.oGrp_search_in.Value
		nSearch_how = ThisForm.oGrp_search_how.Value
		
		cSQL_field = ThisForm.GetSQL_field()
		cSQL_Add = " OR " + ThisForm.GetSQL_where( cSQL_field ) 
		
		ThisForm.editHoldAnd.Value = ThisForm.editHoldAnd.Value + cSQL_Add 
		ThisForm.txt_search_text.Value = ''
		ThisForm.txt_search_max.Value = ''
	ENDPROC

	PROCEDURE cmdSelect.Click
		IF USED('tmpSearch')
			USE IN tmpSearch
		ENDIF
		
		WAIT WINDOW ThisForm.nReturnKey NOWAIT
		
		ThisForm.Release
		
	ENDPROC

