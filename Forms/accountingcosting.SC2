DEFINE CLASS frmaccountingcosting AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Edit1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdReturn" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />

	*<PropValue>
		Icon = graphics\earth.ico
		Caption = "Accounting Costing - Write down rules."
		DoCreate = .T.
		Height = 455
		Left = 0
		Name = "frmAccountingCosting"
		ShowTips = .T.
		Top = 0
		Width = 701
	*</PropValue>

	ADD OBJECT 'cmdReturn' AS commandbutton WITH ;
		Caption = "Return", ;
		Height = 27, ;
		Left = 592, ;
		Name = "cmdReturn", ;
		Top = 425, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Edit1' AS editbox WITH ;
		Height = 408, ;
		Left = 12, ;
		Name = "Edit1", ;
		Top = 12, ;
		Width = 684
		*< END OBJECT: BaseClass="editbox" />

	ADD OBJECT 'Label1' AS label WITH ;
		Caption = "PROC_SQL:AccountingCosting ", ;
		Height = 17, ;
		Left = 24, ;
		Name = "Label1", ;
		Top = 429, ;
		Width = 360
		*< END OBJECT: BaseClass="label" />
	
	PROCEDURE Init
		PRIVATE v
		
		v = "IF cAlloy = '6B' OR cAlloy = '6BH' "+CHR(13)
		v=v+"	IF cForm = '10'"+CHR(13)
		v=v+"		DO CASE"+CHR(13)
		v=v+"		CASE nDim1 <= 1"+CHR(13)
		v=v+"			IF nDim2 < 12"+CHR(13)
		v=v+"				lWriteOff = .T."+CHR(13)
		v=v+"			ENDIF"+CHR(13)
		v=v+"		CASE nDim1 > 1 AND nDim1 <= 6"+CHR(13)
		v=v+"			IF nDim2 < 3"+CHR(13)
		v=v+"				lWriteOff = .T."+CHR(13)
		v=v+"			ENDIF"+CHR(13)
		v=v+"		CASE nDim1 > 6"+CHR(13)
		v=v+"			IF nDim2 < 1"+CHR(13)
		v=v+"				lWriteOff = .T."+CHR(13)
		v=v+"			ENDIF"+CHR(13)
		v=v+"		ENDCASE"+CHR(13)
		v=v+"	ENDIF"+CHR(13)
		v=v+"	IF cForm = '40'"+CHR(13)
		v=v+"		IF nDim2 < 1 OR nDim3 < 1"+CHR(13)
		v=v+"			lWriteOff = .T."+CHR(13)
		v=v+"		ENDIF"+CHR(13)
		v=v+"		IF nDim2 * nDim3 < 10"+CHR(13)
		v=v+"			lWriteOff = .T."+CHR(13)
		v=v+"		ENDIF"+CHR(13)
		v=v+"	ENDIF"+CHR(13)
		v=v+"ELSE Not 6B or 6BH"+CHR(13)
		v=v+"	IF cForm = '10'"+CHR(13)
		v=v+"		DO CASE"+CHR(13)
		v=v+"		CASE nDim1 <= 1"+CHR(13)
		v=v+"			IF nDim2 < 48"+CHR(13)
		v=v+"				lWriteOff = .T."+CHR(13)
		v=v+"			ENDIF"+CHR(13)
		v=v+"		CASE nDim1 > 1 AND nDim1 <= 6"+CHR(13)
		v=v+"			IF nDim2 < 24"+CHR(13)
		v=v+"				lWriteOff = .T."+CHR(13)
		v=v+"			ENDIF"+CHR(13)
		v=v+"		CASE nDim1 > 6"+CHR(13)
		v=v+"			IF nDim2 < 6"+CHR(13)
		v=v+"				lWriteOff = .T."+CHR(13)
		v=v+"			ENDIF"+CHR(13)
		v=v+"		ENDCASE"+CHR(13)
		v=v+"		IF NOT lWriteOff "+CHR(13)
		v=v+"			*IF Item was Bought for order check to see if drops are to be written against order"+CHR(13)
		v=v+"			IF NOT ( ISNULL(cPOitem) AND ISNULL(pSOitem) )"+CHR(13)
		v=v+"				*Check Purchased for this order"+CHR(13)
		v=v+"				IF Purchased4Order( cPOitem, pSOitem, nConn )"+CHR(13)
		v=v+"					lWriteOff = PurchasedWriteOff( cAlloy, cForm, nDim1 )"+CHR(13)
		v=v+"				ENDIF"+CHR(13)
		v=v+"			ENDIF"+CHR(13)
		v=v+"		ENDIF"+CHR(13)
		v=v+"	ENDIF"+CHR(13)
		v=v+"	IF cForm = '40'"+CHR(13)
		v=v+"		IF nDim2 < 2 OR nDim3 < 2"+CHR(13)
		v=v+"			lWriteOff = .T."+CHR(13)
		v=v+"		ENDIF"+CHR(13)
		v=v+"		IF ( nDim2 * nDim3 ) < 144"+CHR(13)
		v=v+"			lWriteOff = .T."+CHR(13)
		v=v+"		ENDIF"+CHR(13)
		v=v+"		IF NOT lWriteOff "+CHR(13)
		v=v+"			IF NOT ISNULL(cPOitem) OR NOT ISNULL(pSOitem) "+CHR(13)
		v=v+"				*Check Purchased for this order"+CHR(13)
		v=v+"				IF Purchased4Order( cPOitem, pSOitem, nConn )"+CHR(13)
		v=v+"					lWriteOff = PurchasedWriteOff( cAlloy, cForm, nDim1 )"+CHR(13)
		v=v+"				ENDIF"+CHR(13)
		v=v+"			ENDIF"+CHR(13)
		v=v+"		ENDIF"+CHR(13)
		v=v+"	ENDIF"+CHR(13)
		v=v+"ENDIF"+CHR(13)
		
		
		ThisForm.Edit1.Value = v
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF 
	ENDPROC

	PROCEDURE cmdReturn.Click
		ThisForm.Release
		
	ENDPROC

ENDDEFINE
