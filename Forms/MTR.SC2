		ThisForm.txtForm.Value = "10"
		ThisForm.txtThck.Value = "1"
		ThisForm.txtHeat.Value = "L12C"
		ThisForm.txtUNS.Value = "N10276"
	ENDPROC

	PROCEDURE frmScanMTR.txtAlloy.Valid
		PRIVATE cAlloy
		cAlloy = This.Value
		IF LEN(cAlloy) > 0
			ThisForm.SvrDir_UNS.Value = GetMTR_UNS( cAlloy, ThisFormSet.nConnHandle)
		ENDIF
	ENDPROC

