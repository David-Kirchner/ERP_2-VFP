	PROCEDURE Destroy
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE Init
		PARAMETER pAlloy,pForm,pThck,pHeat,pLot,pnID,pnConn
		*DO FORM "forms\MTR.scx" WITH 'C-276','40',2.5,'Z12345','',0,0
		*DO FORM "forms\MTR.scx" WITH pAlloy,pForm,pThck,pHeat,pLot,pnID,pnConn
		
		**************************************************************************
		
		PUBLIC nCertImage1
		nCertImage1 = ''
		PUBLIC ARRAY aCertImage(1)
		
		
		IF TYPE("pAlloy")="C"
			ThisFormSet.frmScanMTR.txtAlloy.Value = pAlloy
		ELSE
			ThisFormSet.frmScanMTR.txtAlloy.Value = ""
		ENDIF
		
		IF TYPE("pForm")="C"
			ThisFormSet.frmScanMTR.txtForm.Value = pForm
		ELSE
			ThisFormSet.frmScanMTR.txtForm.Value = ""
		ENDIF
		
		IF TYPE("pThck")="N"
			ThisFormSet.frmScanMTR.txtThck.Value = pThck
		ELSE
			ThisFormSet.frmScanMTR.txtThck.Value = 0.0000
		ENDIF
		
		IF TYPE("pHeat")="C"
			ThisFormSet.frmScanMTR.txtHeat.Value = pHeat
		ELSE
			ThisFormSet.frmScanMTR.txtHeat.Value = ""
		ENDIF
		
		IF TYPE("pLot")="C"
			ThisFormSet.frmScanMTR.txtLot.Value = pLot
		ELSE
			ThisFormSet.frmScanMTR.txtLot.Value = ""
		ENDIF
		
		IF TYPE("pnID")="N"
			ThisFormSet.nStockLst_ID = pnID
		ELSE
			ThisFormSet.nStockLst_ID = 0
		ENDIF
		************
		IF TYPE("pnConn")="N"
			IF pnConn > 0
				ThisFormSet.nConnHandle= pnConn
				ThisFormSet.CloseConnection = .F.
			ELSE
				ThisFormSet.nConnHandle= get_SQLSTRINGCONNECT()
				ThisFormSet.CloseConnection = .T.
			ENDIF
		ELSE
			ThisFormSet.nConnHandle= get_SQLSTRINGCONNECT()
			ThisFormSet.CloseConnection = .T.
		ENDIF
		
		IF ThisFormSet.nConnHandle< 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			RETURN .F.
			ThisFormSet.frmScanMTR.Release
		ENDIF
		
		************
		IF TYPE("pAlloy")="C"
			IF LEN(pAlloy) > 0
				IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
					SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
				ENDIF 
				
				ThisFormSet.frmScanMTR.SvrDir_UNS.Value = GetMTR_UNS( pAlloy, ThisFormSet.nConnHandle)
			ENDIF
		ENDIF
		************
		
		*ThisFormSet.frmScanMTR.Desktop = .T.
		*ThisFormSet.frmScanMTR_Scans.Desktop = .T.
		
		
		ThisFormSet.frmScanMTR.AlwaysOnTop = .T.
		ThisFormSet.frmScanMTR.AlwaysOnTop = .F.
		*ThisFormSet.frmMTR_Scans.AlwaysOnTop = .T.
		*ThisFormSet.frmMTR_Scans.AlwaysOnTop = .F.
		
		IF NOT EMPTY(ThisFormSet.frmScanMTR.txtHeat.Value) AND NOT EMPTY(ThisFormSet.frmScanMTR.txtThck.Value) AND NOT EMPTY(ThisFormSet.frmScanMTR.txtForm.Value) AND NOT EMPTY(ThisFormSet.frmScanMTR.txtAlloy.Value)
			ThisFormSet.frmScanMTR.cmdSearch.Click
		ENDIF
		
		*Set to True in properties, turened off after displayed.
		ThisFormSet.frmScanMTR.AlwaysOnTop = .F.
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Quotes ADDITIVE
		ENDIF 
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		
		
	ENDPROC

	PROCEDURE Unload
		IF ThisFormSet.CloseConnection 
			= SQLDISCONNECT( ThisFormSet.nConnHandle )
		ENDIF
		
		IF WEXIST("frmStockLst_SQL_Maint")
			ACTIVATE WINDOW frmStockLst_SQL_Maint
		ENDIF
		
		IF WEXIST("frmStockLst_SQL_Quotes")
			ACTIVATE WINDOW frmStockLst_SQL_Quotes
		ENDIF
		
		
	ENDPROC

	PROCEDURE frmScanMTR.cmdERPCert.Click
		
		PRIVATE cHeat,nLot,cLot,cType
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',40))
		cLot	= ALLTRIM(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		
		IF "HPA " $ UPPER(cLot)
			cLot = SUBSTR(UPPER(cLot),AT("HPA ",UPPER(cLot))+4)
		ENDIF
		IF "HPA" $ UPPER(cLot)
			cLot = SUBSTR(UPPER(cLot),AT("HPA",UPPER(cLot))+3)
		ENDIF
		
		DO CASE 
		CASE cLot = "G"
			cType = "GFM"
			nLot  = VAL(SUBSTR(cLot,AT("G",UPPER(cLot))+1))
		CASE cLot = "R"
			cType = "ROLL"
			nLot  = VAL(SUBSTR(cLot,AT("R",UPPER(cLot))+1))
		CASE cLot = "L"
			cType = "LakeErie"
			nLot  = VAL(SUBSTR(cLot,AT("L",UPPER(cLot))+1))
		OTHERWISE
			cType = ''
			nLot  = VAL(ALLTRIM(cLot))
		ENDCASE
			
			
		*DO FORMS\Certs WITH cHEAT, nLOT, cType
		DO FORM forms\SQL_certs.scx WITH cHEAT, cLOT, cType
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE frmScanMTR.cmdOpen.Click
		
		RUN EXPLORER "\\Turkey\CERTIFICATION.RAP\"
	ENDPROC

	PROCEDURE frmScanMTR.cmdOpenAlloy.Click
		PRIVATE cSvrDir_UNS 
		cSvrDir_UNS = GetMTR_UNS(ThisForm.txtAlloy.Value, ThisFormSet.nConnHandle) &&"\\DL380PG8\HPAScans\Certifications\"+cUNS
		
		IF NOT EMPTY(cSvrDir_UNS )
			*cUNSAlloyDrw  = ThisForm.SvrDir_UNS.Value
			RUN EXPLORER &cSvrDir_UNS 
		ELSE
			*RUN EXPLORER "\\Turkey\CERTIFICATION.RAP\"
			RUN EXPLORER "\\FileServer\HPAScans\Certification\"
		ENDIF
		
	ENDPROC

	PROCEDURE frmScanMTR.cmdQuit.Click
		ThisFormSet.Release
		
		*ThisForm.Release
	ENDPROC

	PROCEDURE frmScanMTR.cmdSaveLoc.Click
		PRIVATE cLocation,cFileName
		cLocation = PrepareSQLtxt(ThisForm.txtLocation.Value,'Location',-1)
		cFileName = PrepareSQLtxt(ThisForm.txtFileName.Value,'FileName',-1)
		
		*IF "\\DL380PG8\" $ cLocation
		IF "\\FileServer\" $ cLocation
			*MESSAGEBOX("Only use text past Alloy.FLD",0+64,"No Save")
			*RETURN .F.
			*remove extra
			*\\DL380PG8\HPAScans\Certifications\
			*\\Turkey\CERTIFICATION.RAP\S31277.DRW\27-7MO.FLD\40 0.125 HW1357WR CN28A.DOC
			cLocation = RIGHT(cLocation,LEN(cLocation)-AT('Certifications\',cLocation)-15)
			ThisForm.txtLocation.Value = cLocation
		ENDIF
		
		PRIVATE cAlloy,cCertAlloy
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cCertAlloy = CertName(cAlloy)
		
		PRIVATE cUNS,cSvrDir_UNS 
		cUNS = PrepareSQLtxt(ThisForm.txtUNS.Value,'UNS',6)
		IF EMPTY(cUNS)
			cUNS =  GetUNS( cAlloy, ThisFormSet.nConnHandle)
		ENDIF
		cSvrDir_UNS = GetMTR_UNS(cAlloy, ThisFormSet.nConnHandle) &&"\\DL380PG8\HPAScans\Certifications\"+cUNS	
		*cUNSAlloyDrw = "\\Turkey\CERTIFICATION.RAP\"+cUNS+".DRW\"+cCertAlloy+".FLD"
		ThisForm.SvrDir_UNS.Value = cSvrDir_UNS
		
		cLocation = RIGHT(cSvrDir_UNS,LEN(cSvrDir_UNS)-AT('Certifications\',cSvrDir_UNS)-15)
		ThisForm.txtLocation.Value = cLocation
			
		IF AT("\",cLocation) > 0
			cLocation = SUBSTR(cLocation,AT("\",cLocation)+1 )
		ENDIF
		
		IF NOT DIRECTORY( cSvrDir_UNS )
			MESSAGEBOX("This location is not VALID"+CHR(13)+"Edit table dbo.Alloy field MTR_UNS",0+64,"No Save")
			RETURN .F.
		ENDIF
		
		*cTestLocation = cSvrDir_UNS +IIF( LEFT(cTestFile,1)="\",cTestFile,"\"+cTestFile)
		IF NOT UPPER(cLocation) $ UPPER(cSvrDir_UNS )
			MESSAGEBOX("This location is not Found in the table dbo.Alloy field MTR_UNS",0+64,"No Save")
			RETURN .F.
		ENDIF	
		
		IF NOT ".PDF" $ UPPER(cFileName)
			cFileName = IIF( LEFT(cFileName,1)="\",cFileName,"\"+cFileName+".PDF")
		ENDIF
		
		IF NOT FILE( cSvrDir_UNS+"\"+cFileName )
			MESSAGEBOX("File is not VALID",0+64,"No Save")
			RETURN .F.
		ENDIF
		
		
		PRIVATE cForm,nThck,cThck,cHeat,cLot,nStockLst_ID
		cForm	= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,4)
		cThck 	= STR(nThck,8,3)
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',40))
		cLot	= ALLTRIM(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		nStockLst_ID = PrepareSQLnum(ThisFormSet.nStockLst_ID,'ID',-3)
		
		IF nStockLst_ID = 0
			MESSAGEBOX("Sorry, cannot save.",0+64,'Missing nStockLst_ID ')
			RETURN .F.
		ENDIF
		
		IF NOT UPPER(cCertAlloy) $ UPPER(cLocation)
			MESSAGEBOX("Sorry, Alloy '"+ALLTRIM(cCertAlloy)+"' not Found in Location.",0+64,'Bad Alloy')
			RecordError( 0, 'Bad Alloy', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Sorry, Alloy '"+ALLTRIM(cCertAlloy)+"' not Found in Location "+cLocation )
			RETURN .F.
		ENDIF
		
		IF NOT UPPER(cUNS) $ UPPER(cLocation)
			MESSAGEBOX("Sorry, UNS '"+ALLTRIM(cUNS)+"' not Found in Location.",0+64,'Bad UNS')
			RecordError( 0, 'Bad UNS', "Proc_SQL:"+PROGRAM()+" @"+PROGRAM(PROGRAM(-1)-1), LINENO(),"Sorry, UNS '"+ALLTRIM(cUNS)+"' not Found in Location "+cLocation )
			RETURN .F.
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		cSQL = "INSERT INTO dbo.MTR_Loc ("
		cSQL = cSQL + "Alloy,Form,Size,Heat,Lot,UNS,Location,FileName,StockLst_ID) VALUES ("
		cSQL = cSQL + " '"+cAlloy+"'"
		cSQL = cSQL + ",'"+cForm+"'"
		cSQL = cSQL + ", "+STR(nThck,9,3)
		cSQL = cSQL + ",'"+cHeat+"'"
		cSQL = cSQL + ",'"+cLot+"'"
		cSQL = cSQL + ",'"+cUNS+"'"
		cSQL = cSQL + ",'"+cLocation+"'"
		cSQL = cSQL + ",'"+cFileName+"'"
		cSQL = cSQL + ", "+STR(nStockLst_ID)
		cSQL = cSQL + ")"
		
		
		nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF nSQLEXEC < 0
			PRIVATE nMess
			nMess = MESSAGEBOX("Could not be saved!"+CHR(13)+"Duplicates can not be saved."+CHR(13)+"Do you want to remove the other location"+CHR(13)+"And Try to Save again?",4+64,"No Save")
			IF nMess = 6
				cSQLd = "DELETE FROM dbo.MTR_Loc WHERE"
				cSQLd = cSQLd + " UNS='"+cUNS+"'"
				cSQLd = cSQLd + " AND Form='"+cForm+"'"
				cSQLd = cSQdL + " AND Size="+STR(nThck,9,3)
				cSQLd = cSQLd + " AND Heat='"+cHeat+"'"
				cSQLd = cSQLd + " AND Lot='"+cLot+"'"
		
				nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQLd )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQLd )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQLd, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQLd,ThisFormSet.nConnHandle, nSQLEXEC, '')
				ELSE
				
					*Go back to cSQL
					nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisFormset.nConnHandle, cSQL )
					ENDDO
					IF nSQLEXEC < 0 &&Try again!
						nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
						DO WHILE nSQLEXEC = 0
							WAIT WINDOW 'SQL 2' TIMEOUT 1
							nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "")
							
							IF nSQLEXEC < 0
								IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
									nSQLEXEC = 0
								ENDIF
							ENDIF
						ENDDO
					ENDIF 
					IF nSQLEXEC > 0
						WAIT WINDOW "Saved!" NOWAIT
						ThisForm.txtLocation.Value = cLocation
						ThisForm.txtFileName.Value = cFileName
						ThisForm.txtComment.Value = 'Saved new location:'+cLocation
					ELSE
						ThisForm.txtLocation.Value = ''
						ThisForm.txtFileName.Value = ''
						ThisForm.txtComment.Value = "Cannot Update Location Record."
					ENDIF
				ENDIF
			ENDIF
		ELSE
			WAIT WINDOW "Saved!" NOWAIT
			ThisForm.txtLocation.Value = cLocation
			ThisForm.txtFileName.Value = cFileName
			ThisForm.txtComment.Value = 'Saved new location:'+cLocation
		ENDIF
		
	ENDPROC

	PROCEDURE frmScanMTR.cmdSearch.Click
		PRIVATE lOK, lFoundFile
		lOK = .T.
		lFoundFile = .F.
		
		ThisForm.txtComment.Value = ""
		ThisForm.txtLocation.Value = ''
		ThisForm.txtFileName.Value = ''
		
		PRIVATE cAlloy,cCertAlloy
		cAlloy = PrepareSQLtxt(ThisForm.txtAlloy.Value,'Alloy',12)
		cCertAlloy = CertName(cAlloy)
		ThisForm.txtCertAlloy.Value = cCertAlloy
		
		PRIVATE cForm,nThck,cHeat,cThck,cLot
		cForm	= PrepareSQLtxt(ThisForm.txtForm.Value,'Form',2)
		nThck	= PrepareSQLnum(ThisForm.txtThck.Value,'Thck',9,4)
		cHeat	= ALLTRIM(PrepareSQLtxt(ThisForm.txtHeat.Value,'Heat',40))
		cLot	= ALLTRIM(PrepareSQLtxt(ThisForm.txtLot.Value,'Lot',10))
		IF cLot='0'
			cLot = ''
		ENDIF
		
		PRIVATE cUNS,cSvrDir_UNS,cFormThicknessHeat,cFormThicknessHeat2 
		cUNS 		= ALLTRIM(ThisForm.txtUNS.Value)
		cSvrDir_UNS		= ""
		
		IF LEN(cUNS)=0
			cUNS =  GetUNS( cAlloy, ThisFormSet.nConnHandle)
		ENDIF
		IF LEN(cUNS)>0
			ThisForm.txtUNS.Value = cUNS
			WAIT WINDOW "UNS:"+cUNS NOWAIT
		ELSE
			MESSAGEBOX("Could not find the UNS for Alloy:"+cAlloy,0+64,"Bad Alloy UNS")
			ThisForm.txtComment.Value = "Could not find the UNS for Alloy:"+cAlloy
			lOK = .F.
		**	RETURN .F.
		ENDIF
		
		IF lOK
			*cUNSDrw = "\\Turkey\CERTIFICATION.RAP\"+cUNS+".DRW"
			*cUNSDrw = "\\DL380PG8\HPAScans\Certifications\"+cUNS+".DRW"
			*\\FileServer
			cSvrDir_UNS = GetMTR_UNS(cAlloy, ThisFormSet.nConnHandle) &&"\\DL380PG8\HPAScans\Certifications\"+cUNS
			
			IF DIRECTORY( cSvrDir_UNS )
				lOK = .T.
			ELSE
				ThisForm.txtComment.Value = "Did not Find UNS Folder "+cSvrDir_UNS 
				lOK = .F.
				MESSAGEBOX("Did not Find UNS Folder "+cSvrDir_UNS,0,"Not in \\DL380PG8\HPAScans\Certifications\")
				**RETURN .F.
			ENDIF
		ENDIF
		*ThisFormSet.SvrDir_UNS= ''
		
		*!*	IF lOK
		*!*		*Find Alloy Drawer
		*!*		*cUNSAlloyDrw = "\\Turkey\CERTIFICATION.RAP\"+cUNS+".DRW\"+cCertAlloy+".FLD"
		*!*		cUNSAlloyDrw = cSvrDir_UNS+""
		*!*		ThisFormSet.cUNSAlloyDrw = cUNSAlloyDrw 
		*!*		ThisForm.SvrDir_UNS.Value = cUNSAlloyDrw 
		*!*		
		*!*		IF DIRECTORY( cUNSAlloyDrw  )
		*!*			WAIT WINDOW "Found UNS\Alloy Drawer "+cUNSAlloyDrw  NOWAIT
		*!*			lOK = .T.
		*!*		ELSE
		*!*			ThisForm.txtComment.Value = "Did not Find UNS\Alloy Drawer "+cUNSAlloyDrw  
		*!*			IF EMPTY(cCertAlloy)
		*!*				MESSAGEBOX("SQL Alloy table does not have a 'CertName' entry for this alloy! "+cAlloy+CHR(13)+"Use 'HPA-Maintanence-Alloy Standard' to add the CertName!",0,"Could not find.")
		*!*			ELSE
		*!*				MESSAGEBOX("Did not Find UNS\Alloy Drawer "+cUNSAlloyDrw,0,"Not in MTR")
		*!*			ENDIF
		*!*			lOK = .F.
		*!*			RETURN .F.
		*!*		ENDIF
		*!*	ENDIF
		
		PRIVATE cFormThicknessHeat,cFormThicknessHeatLot,cFormThicknessHeat2 
		cFormThicknessHeat = ""
		cFormThicknessHeatLot = ""
		cFormThicknessHeat2 = ""
		
		PRIVATE cSQL, nSQLEXEC
		********************
		IF lOK
			PRIVATE nStockLst_ID
			nStockLst_ID = PrepareSQLnum(ThisFormSet.nStockLst_ID,'ID',-3)
			
			IF nStockLst_ID  > 0
		
				cSQL = "SELECT Location FROM dbo.MTR_Loc WHERE "
				cSQL = cSQL + " StockLst_ID="+STR(nStockLst_ID)
		
				IF USED('tmpMTR_Loc')
					USE IN tmpMTR_Loc
				ENDIF
		
				SELECT 0
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMTR_Loc')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMTR_Loc')
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMTR_Loc")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMTR_Loc")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpMTR_Loc')
				ELSE
					IF USED('tmpMTR_Loc')
						IF VARTYPE(tmpMTR_Loc.Location) = 'C'
							 IF NOT EMPTY(tmpMTR_Loc.Location)
								cFormThicknessHeatLot = tmpMTR_Loc.Location
								cFormThicknessHeat    = tmpMTR_Loc.Location
								WAIT WINDOW "Looking for Directory:"+cFormThicknessHeatLot NOWAIT
								IF DIRECTORY( cFormThicknessHeatLot )
									ThisForm.txtComment.Value = "SQL Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
									ThisForm.txtLocation.Value = tmpMTR_Loc.Location
									lOK = .T.
									lFoundFile =.T.
								ENDIF
								WAIT CLEAR
							ENDIF
						ENDIF
					USE IN tmpMTR_Loc
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		********************
		
		IF lOK AND !lFoundFile
			*Find Form Thickness Heat Lot
			IF LEN(cLot) > 0
				cThck = Remove0(nThck,9,4)
				IF nThck < 1
					IF LEFT(cThck,1) != '0'
						cThck = "0"+cThck
					ENDIF
				ENDIF
				cFormThicknessHeatLot = cSvrDir_UNS + "\"+cForm+" "+cThck +" "+cHeat+" "+cLot+".PDF"
				WAIT WINDOW "Looking for Directory:"+cFormThicknessHeatLot NOWAIT
				IF DIRECTORY( cFormThicknessHeatLot )
					ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
					WAIT WINDOW ThisForm.txtComment.Value NOWAIT
					lFoundFile = .T.
				ELSE
					cFormThicknessHeatLot2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,3) +" "+cHeat+" "+cLot+".PDF"
					IF DIRECTORY( cFormThicknessHeatLot2 )
						cFormThicknessHeatLot = cFormThicknessHeatLot2
						ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
						WAIT WINDOW ThisForm.txtComment.Value NOWAIT
						lFoundFile = .T.
					ELSE
						cFormThicknessHeatLot2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,2) +" "+cHeat+" "+cLot+".PDF"
						IF DIRECTORY( cFormThicknessHeatLot2 )
							cFormThicknessHeatLot = cFormThicknessHeatLot2
							ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
							WAIT WINDOW ThisForm.txtComment.Value NOWAIT
							lFoundFile  = .T.
						ELSE	
							cFormThicknessHeatLot2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,1) +" "+cHeat+" "+cLot+".PDF"
							IF DIRECTORY( cFormThicknessHeatLot2 )
								cFormThicknessHeatLot = cFormThicknessHeatLot2
								ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
								WAIT WINDOW ThisForm.txtComment.Value NOWAIT
								lFoundFile = .T.
							ELSE	
								cFormThicknessHeatLot2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,0) +" "+cHeat+" "+cLot+".PDF"
								IF DIRECTORY( cFormThicknessHeatLot2 )
									cFormThicknessHeatLot = cFormThicknessHeatLot2
									ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
									WAIT WINDOW ThisForm.txtComment.Value NOWAIT
									lFoundFile = .T.
								ELSE	
									cFormThicknessHeatLot2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,3)+"0" +" "+cHeat+" "+cLot+".PDF"
									IF DIRECTORY( cFormThicknessHeatLot2 )
										cFormThicknessHeatLot = cFormThicknessHeatLot2
										ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
										WAIT WINDOW ThisForm.txtComment.Value NOWAIT
										lFoundFile = .T.
									ELSE
										cFormThicknessHeatLot2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,2)+"0"  +" "+cHeat+" "+cLot+".PDF"
										IF DIRECTORY( cFormThicknessHeatLot2 )
											cFormThicknessHeatLot = cFormThicknessHeatLot2
											ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
											WAIT WINDOW ThisForm.txtComment.Value NOWAIT
											lFoundFile = .T.
										ELSE	
											cFormThicknessHeatLot2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,1)+"0"  +" "+cHeat+" "+cLot+".PDF"
											IF DIRECTORY( cFormThicknessHeatLot2 )
												cFormThicknessHeatLot = cFormThicknessHeatLot2
												ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
												WAIT WINDOW ThisForm.txtComment.Value NOWAIT
												lFoundFile = .T.
											ELSE	
												cFormThicknessHeatLot2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,0)+".0"  +" "+cHeat+" "+cLot+".PDF"
												IF DIRECTORY( cFormThicknessHeatLot2 )
													cFormThicknessHeatLot = cFormThicknessHeatLot2
													ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
													WAIT WINDOW ThisForm.txtComment.Value NOWAIT
													lFoundFile = .T.
												ELSE	
													cFormThicknessHeat2Lot  = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,2)+"00"  +" "+cHeat+cLot+".PDF"
													IF DIRECTORY( cFormThicknessHeat2Lot  )
														cFormThicknessHeatLot = cFormThicknessHeat2Lot 
														ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
														WAIT WINDOW ThisForm.txtComment.Value NOWAIT
														lFoundFile = .T.
													ELSE	
														cFormThicknessHeat2Lot  = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,1)+"00"  +" "+cHeat+cLot+".PDF"
														IF DIRECTORY( cFormThicknessHeat2Lot  )
															cFormThicknessHeatLot = cFormThicknessHeat2Lot 
															ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
															WAIT WINDOW ThisForm.txtComment.Value NOWAIT
															lFoundFile = .T.
														ELSE	
															cFormThicknessHeat2Lot  = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,0)+".00"  +" "+cHeat+cLot+".PDF"
															IF DIRECTORY( cFormThicknessHeat2Lot  )
																cFormThicknessHeatLot = cFormThicknessHeat2Lot 
																ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot 
																WAIT WINDOW ThisForm.txtComment.Value NOWAIT
																lFoundFile = .T.
															ELSE								
																MESSAGEBOX("Did not Find with Lot number:"+cLot+CHR(13)+"UNS,Form,Thickness,Heat,Lot"+CHR(13)+cFormThicknessHeatLot+CHR(13)+"Be carefull to manually check Heat/Lot.",64,"Lot not found")
		*														lFoundFile = .F.
		*														*RETURN .F.
		*														RUN EXPLORER &cSvrDir_UNS
															ENDIF
														ENDIF
													ENDIF
												ENDIF
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
		
			ENDIF
		ENDIF
		
		
		*************************************
		IF lOK AND !lFoundFile 
			*Find Form Thickness Heat - No Lot
			cThck = Remove0(nThck,9,4)
			IF nThck < 1
				IF LEFT(cThck,1) != '0'
					cThck = "0"+cThck
				ENDIF
			ENDIF
			*? cThck
			cFormThicknessHeat = cSvrDir_UNS + "\"+cForm+" "+cThck +" "+cHeat+".PDF"
			
			IF FILE( cFormThicknessHeat )
				ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
				WAIT WINDOW ThisForm.txtComment.Value NOWAIT
				lFoundFile = .T.
			ELSE
				cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,3) +" "+cHeat+".PDF"
				IF FILE( cFormThicknessHeat2 )
					cFormThicknessHeat = cFormThicknessHeat2
					ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
					WAIT WINDOW ThisForm.txtComment.Value NOWAIT
					lFoundFile = .T.
				ELSE
					cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,2) +" "+cHeat+".PDF"
					IF FILE( cFormThicknessHeat2 )
						cFormThicknessHeat = cFormThicknessHeat2
						ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
						WAIT WINDOW ThisForm.txtComment.Value NOWAIT
						lFoundFile = .T.
					ELSE	
						cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,1) +" "+cHeat+".PDF"
						IF FILE( cFormThicknessHeat2 )
							cFormThicknessHeat = cFormThicknessHeat2
							ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
							WAIT WINDOW ThisForm.txtComment.Value NOWAIT
							lFoundFile = .T.
						ELSE	
							cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,0) +" "+cHeat+".PDF"
							IF FILE( cFormThicknessHeat2 )
								cFormThicknessHeat = cFormThicknessHeat2
								ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
								WAIT WINDOW ThisForm.txtComment.Value NOWAIT
								lFoundFile = .T.
							ELSE	
							
								cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,3)+"0" +" "+cHeat+".PDF"
								IF FILE( cFormThicknessHeat2 )
									cFormThicknessHeat = cFormThicknessHeat2
									ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
									WAIT WINDOW ThisForm.txtComment.Value NOWAIT
									lFoundFile = .T.
								ELSE
									cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,2)+"0"  +" "+cHeat+".PDF"
									IF FILE( cFormThicknessHeat2 )
										cFormThicknessHeat = cFormThicknessHeat2
										ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
										WAIT WINDOW ThisForm.txtComment.Value NOWAIT
										lFoundFile = .T.
									ELSE	
										cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,1)+"0"  +" "+cHeat+".PDF"
										IF FILE( cFormThicknessHeat2 )
											cFormThicknessHeat = cFormThicknessHeat2
											ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
											WAIT WINDOW ThisForm.txtComment.Value NOWAIT
											lFoundFile = .T.
										ELSE	
											cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,0)+".0"  +" "+cHeat+".PDF"
											IF FILE( cFormThicknessHeat2 )
												cFormThicknessHeat = cFormThicknessHeat2
												ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
												WAIT WINDOW ThisForm.txtComment.Value NOWAIT
												lFoundFile = .T.
											ELSE	
											
												cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,2)+"00"  +" "+cHeat+".PDF"
												IF FILE( cFormThicknessHeat2 )
													cFormThicknessHeat = cFormThicknessHeat2
													ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
													WAIT WINDOW ThisForm.txtComment.Value NOWAIT
													lFoundFile = .T.
												ELSE	
													cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,1)+"00"  +" "+cHeat+".PDF"
													IF FILE( cFormThicknessHeat2 )
														cFormThicknessHeat = cFormThicknessHeat2
														ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
														WAIT WINDOW ThisForm.txtComment.Value NOWAIT
														lFoundFile = .T.
													ELSE	
														cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,0)+".00"  +" "+cHeat+".PDF"
														IF FILE( cFormThicknessHeat2 )
															cFormThicknessHeat = cFormThicknessHeat2
															ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat 
															WAIT WINDOW ThisForm.txtComment.Value NOWAIT
															lFoundFile = .T.
														ELSE									
															ThisForm.txtComment.Value = "Did not Find UNS,Form,Thickness,Heat "+cFormThicknessHeat 
															lOK = .F.
															*RETURN .F.
															*RUN EXPLORER &cSvrDir_UNS
														ENDIF
													ENDIF
												ENDIF
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		WAIT Clear
		
		IF NOT ( lOK OR lFoundFile ) AND LEN(cLot) > 0
			*Look up in SQL with LOT
			
			PRIVATE cSQL, nSQLEXEC
			cSQL = "SELECT Location FROM dbo.MTR_Loc WHERE "
			cSQL = cSQL + " UNS='"+cUNS+"'"
			cSQL = cSQL + " AND Form='"+cForm+"'"
			cSQL = cSQL + " AND Size="+STR(nThck,9,3)
			cSQL = cSQL + " AND Heat='"+cHeat+"'"
			cSQL = cSQL + " AND Lot='"+cLot+"'"
			
			IF USED('tmpMTR_Loc')
				USE IN tmpMTR_Loc
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMTR_Loc')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMTR_Loc')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMTR_Loc")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpMTR_Loc")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpMTR_Loc')
				lOK = .F.
			ELSE
				IF USED('tmpMTR_Loc')
					IF VARTYPE(tmpMTR_Loc.Location) = 'C'
						 
						cFormThicknessHeatLot = tmpMTR_Loc.Location
						cFormThicknessHeat    = tmpMTR_Loc.Location
						
						IF FILE( cFormThicknessHeatLot )
							ThisForm.txtComment.Value = "SQL Found UNS, Form, Thickness, Heat, Lot "+cFormThicknessHeatLot
							ThisForm.txtLocation.Value = tmpMTR_Loc.Location
							lOK = .T.
							lFoundFile = .T.
						ENDIF
						
					ENDIF
				USE IN tmpMTR_Loc
				ENDIF
			ENDIF
		ENDIF
		
		IF NOT (lOK OR lFoundFile) AND LEN(cHeat) > 0
			*Look up in SQL - No Lot
			
			cSQL = "SELECT Location FROM dbo.MTR_Loc WHERE "
			cSQL = cSQL + " UNS='"+cUNS+"'"
			cSQL = cSQL + " AND Form='"+cForm+"'"
			cSQL = cSQL + " AND Size="+STR(nThck,9,3)
			cSQL = cSQL + " AND Heat='"+cHeat+"'"
			
			IF USED('tmpMTR_Loc')
				USE IN tmpMTR_Loc
			ENDIF
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMTR_Loc')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, 'tmpMTR_Loc')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpMTR_Loc")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisFormSet.nConnHandle, cSQL, "tmpMTR_Loc")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisFormSet.nConnHandle, nSQLEXEC, 'tmpMTR_Loc')
				lOK = .F.
			ELSE
				IF USED('tmpMTR_Loc')
					IF VARTYPE(tmpMTR_Loc.Location) = 'C'
		
						cFormThicknessHeatLot = tmpMTR_Loc.Location
						cFormThicknessHeat    = tmpMTR_Loc.Location
						
						IF FILE( cFormThicknessHeatLot )
							ThisForm.txtComment.Value = "SQL Found UNS, Form, Thickness, Heat, NO_Lot "+cFormThicknessHeatLot
							ThisForm.txtLocation.Value = tmpMTR_Loc.Location
							ThisForm.txtFileName.Value = tmpMTR_Loc.Location
							lFoundFile = .T.
							lOK = .T.
						ENDIF
							
					ENDIF		
					USE IN tmpMTR_Loc
				ENDIF
			ENDIF
		ENDIF
		
		
		*************************************
		IF lOK AND !lFoundFile AND AT("-",cHeat) > 0
			*Find Form Thickness Heat - No Lot 
			*remove -2C Etc from heat! DropLot
			
			PRIVATE cDropLot 
			cDropLot = RIGHT(cHeat, LEN(cHeat) - AT("-",cHeat))
			cHeat = LEFT(cHeat, AT("-",cHeat)-1)
		
			cFormThicknessHeat = cSvrDir_UNS + "\"+cForm+" "+cThck +" "+cHeat+".PDF"
			
			IF FILE( cFormThicknessHeat )
				ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot
				WAIT WINDOW ThisForm.txtComment.Value NOWAIT
				lFoundFile = .T.
			ELSE
				cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,3) +" "+cHeat+".PDF"
				IF FILE( cFormThicknessHeat2 )
					cFormThicknessHeat = cFormThicknessHeat2
					ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot 
					WAIT WINDOW ThisForm.txtComment.Value NOWAIT
					lFoundFile = .T.
				ELSE
					cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,2) +" "+cHeat+".PDF"
					IF FILE( cFormThicknessHeat2 )
						cFormThicknessHeat = cFormThicknessHeat2
						ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
						WAIT WINDOW ThisForm.txtComment.Value NOWAIT
						lFoundFile = .T.
					ELSE	
						cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,1) +" "+cHeat+".PDF"
						IF FILE( cFormThicknessHeat2 )
							cFormThicknessHeat = cFormThicknessHeat2
							ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
							WAIT WINDOW ThisForm.txtComment.Value NOWAIT
							lFoundFile = .T.
						ELSE	
							cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,0) +" "+cHeat+".PDF"
							IF FILE( cFormThicknessHeat2 )
								cFormThicknessHeat = cFormThicknessHeat2
								ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
								WAIT WINDOW ThisForm.txtComment.Value NOWAIT
								lFoundFile = .T.
							ELSE	
							
								cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,3)+"0" +" "+cHeat+".PDF"
								IF FILE( cFormThicknessHeat2 )
									cFormThicknessHeat = cFormThicknessHeat2
									ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
									WAIT WINDOW ThisForm.txtComment.Value NOWAIT
									lFoundFile = .T.
								ELSE
									cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,2)+"0"  +" "+cHeat+".PDF"
									IF FILE( cFormThicknessHeat2 )
										cFormThicknessHeat = cFormThicknessHeat2
										ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
										WAIT WINDOW ThisForm.txtComment.Value NOWAIT
										lFoundFile = .T.
									ELSE	
										cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,1)+"0"  +" "+cHeat+".PDF"
										IF FILE( cFormThicknessHeat2 )
											cFormThicknessHeat = cFormThicknessHeat2
											ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
											WAIT WINDOW ThisForm.txtComment.Value NOWAIT
											lFoundFile = .T.
										ELSE	
											cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,0)+".0"  +" "+cHeat+".PDF"
											IF FILE( cFormThicknessHeat2 )
												cFormThicknessHeat = cFormThicknessHeat2
												ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
												WAIT WINDOW ThisForm.txtComment.Value NOWAIT
												lFoundFile = .T.
											ELSE	
											
												cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,2)+"00"  +" "+cHeat+".PDF"
												IF FILE( cFormThicknessHeat2 )
													cFormThicknessHeat = cFormThicknessHeat2
													ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
													WAIT WINDOW ThisForm.txtComment.Value NOWAIT
													lFoundFile = .T.
												ELSE	
													cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,1)+"00"  +" "+cHeat+".PDF"
													IF FILE( cFormThicknessHeat2 )
														cFormThicknessHeat = cFormThicknessHeat2
														ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
														WAIT WINDOW ThisForm.txtComment.Value NOWAIT
														lFoundFile = .T.
													ELSE	
														cFormThicknessHeat2 = cSvrDir_UNS + "\"+cForm+" "+Remove0(nThck,9,0)+".00"  +" "+cHeat+".PDF"
														IF FILE( cFormThicknessHeat2 )
															cFormThicknessHeat = cFormThicknessHeat2
															ThisForm.txtComment.Value = "Found UNS, Form, Thickness, Heat "+cFormThicknessHeat+" -NOT "+cDropLot  
															WAIT WINDOW ThisForm.txtComment.Value NOWAIT
															lFoundFile = .T.
														ELSE									
															ThisForm.txtComment.Value = "Did not Find UNS,Form,Thickness,Heat "+cFormThicknessHeat 
															lOK = .F.
															*RETURN .F.
															*RUN EXPLORER &cSvrDir_UNS
														ENDIF
													ENDIF
												ENDIF
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		WAIT Clear
		
		
		*************************************
		
		
		PRIVATE nCntFoundHeat, i, i2
		nCntFoundHeat = 0
		i = 0
		i2 = 0
		
		IF !lFoundFile 
			*IF ADIR(aDirectory, cSvrDir_UNS+"\*.PDF", "D" ) > 0
			IF ADIR(aDirectory, cSvrDir_UNS, "*.PDF" ) > 0
				FOR i = 1 TO ALEN(aDirectory,1)
					IF cHeat $ aDirectory(i,1)
						nCntFoundHeat = nCntFoundHeat + 1
						DIMENSION aFoundHeat(nCntFoundHeat)
						aFoundHeat(nCntFoundHeat) = aDirectory(i,1)
						
					ENDIF
				ENDFOR
				
				IF nCntFoundHeat > 0
					FOR i2 = 1 TO nCntFoundHeat 
						IF MESSAGEBOX("Did not find match for your heat."+CHR(13)+"Do you think this is your document?"+CHR(13)+aFoundHeat(i2)+CHR(13)+"Folder "+ALLTRIM(STR(i2))+" of "+ALLTRIM(STR(nCntFoundHeat)),4+32,"Found Similar") = 6
							cFormThicknessHeat =  cSvrDir_UNS+"\"+aFoundHeat(i2)
							cFormThicknessHeatLot = cSvrDir_UNS+"\"+aFoundHeat(i2)
							ThisForm.txtComment.Value = "UNS, Form, Thickness, Heat "+cFormThicknessHeat
							WAIT WINDOW ThisForm.txtComment.Value NOWAIT
							
							lFoundFile = .T.
							lOK = .T.
							EXIT
						ENDIF
					ENDFOR
				ENDIF
			ENDIF
		ENDIF
		*************************************
		
		
		IF !lFoundFile 
			MESSAGEBOX(ThisForm.txtComment.Value +CHR(13)+"An Explorer window will now open so you can search for the cert."+CHR(13)+"Also try the Dead Cert folder.",0+64,"Not Found")
			RUN EXPLORER &cSvrDir_UNS
		ENDIF
		
		PRIVATE cLocation, cFileName 
		IF lOK AND lFoundFile 
			*IF "\\DL380PG8\" $ cFormThicknessHeat
			IF "\\FileServer\" $ cFormThicknessHeat
				cLocation = RIGHT(cFormThicknessHeat,LEN(cFormThicknessHeat)-AT('Certifications\',cFormThicknessHeat)-15)
			ENDIF
			IF LEFT(cLocation,1) = "\"
				cLocation = RIGHT(cLocation, LEN(cLocation)-1)
			ENDIF
			IF AT("\",cLocation) > 0
				cLocation = LEFT(cLocation,AT("\",cLocation)-1)
			ENDIF
			cFileName = RIGHT(cFormThicknessHeat, LEN(cFormThicknessHeat)-AT(cLocation,cFormThicknessHeat)-LEN(cLocation) )
			
			ThisForm.txtLocation.Value = cLocation 
			ThisForm.txtFileName.Value = cFileName 
			
			* Do this at the start of your app
			DECLARE INTEGER ShellExecute IN shell32.dll ;
			  INTEGER hndWin, ;
			  STRING cAction, ;
			  STRING cFileName, ;
			  STRING cParams, ;
			  STRING cDir, ;
			  INTEGER nShowWin
		
			* Do this when you want to display the PDF
			*lcFile = "c:\PDF\NyFile.PDF"
			ShellExecute(0, "open", cFormThicknessHeat, "", "", 3) 
			
		ENDIF
		
		*!*	IF lOK AND lFoundFile 
		*!*	*cFile = "\\Turkey\CERTIFICATION.RAP\N10276.DRW\c-276.FLD\10 0.5 E1268-1AFA.DOC\ORIG0001.TIF,\\Turkey\CERTIFICATION.RAP\N10276.DRW\c-276.FLD\10 0.5 E1268-1AFA.DOC\ORIG0002.TIF"
		
		*!*		**
		*!*		IF EMPTY(cFormThicknessHeat)
		*!*			IF NOT EMPTY(cFormThicknessHeatLot)
		*!*				cFormThicknessHeat = cFormThicknessHeatLot
		*!*			ELSE
		*!*				TrackError("Error","MTR:CmdSearch.Click 440: cFormThicknessHeat and cFormThicknessHeatLot are empty!","cmdSearch.Click",LINENO(1))
		*!*			ENDIF
		*!*		ENDIF
		*!*		PRIVATE nFilesPDF,nFilesTIF,nFilesJPG
		*!*		nFilesPDF = ADIR(aFilesPDF,cFormThicknessHeat)
		*!*	*	nFilesTIF = ADIR(aFilesTIF,cFormThicknessHeat+'\ORIG*.TIF')
		*!*	*	nFilesJPG = ADIR(aFilesJPG,cFormThicknessHeat+'\ORIG*.JPG')
		*!*		
		*!*		IF nFilesPDF > 0 &&nFilesTIF + nFilesJPG > 0
		*!*			ThisFormset.frmMTR_Scans.lstCertImages.Clear
		*!*			
		*!*			FOR i = 1 TO nFilesPDF 
		*!*				DIMENSION aCertImage(i)
		*!*				aCertImage(i) = aFilesPDF(i,1)
		*!*				ThisFormset.frmMTR_Scans.lstCertImages.AddItem(aFilesPDF(i,1))
		*!*				ThisFormset.frmMTR_Scans.lstCertImages.Refresh
		*!*			ENDFOR
		*!*			
		*!*			
		*!*			ThisFormSet.frmMTR_Scans.Visible = .T.
		*!*			ThisFormSet.frmMTR_Scans.Enabled = .T.
		*!*			ThisFormSet.frmMTR_Scans.AlwaysOnTop = .T.
		*!*			
		*!*			ThisFormSet.frmMTR_Scans.lstCertImages.Visible = .T.
		*!*			ThisFormset.frmMTR_Scans.lstCertImages.NumberOfElements = nFilesPDF
		*!*			*IF nFilesTIF > 0
		*!*				ThisFormset.frmMTR_Scans.lstCertImages.Value = aFilesPDF(1,1)
		*!*			*ELSE
		*!*			*	ThisFormset.frmMTR_Scans.lstCertImages.Value = aFilesJPG(1,1)
		*!*			*ENDIF
		*!*			ThisFormset.frmMTR_Scans.lstCertImages.Refresh
		*!*			ThisFormSet.frmMTR_Scans.lstCertImages.Enabled = .T.
		*!*			ThisFormset.frmMTR_Scans.lstCertImages.SetFocus
		
		*!*			ThisFormSet.nCurrentpage = 1
		*!*			
		*!*			ThisFormset.frmMTR_Scans.txtUJC.Value = cFormThicknessHeat
		*!*			*ThisFormset.frmMTR_Scans.Image1.Picture = cFormThicknessHeat+"\"+ThisFormset.frmMTR_Scans.lstCertImages.Value
		*!*			ThisFormset.frmMTR_Scans.Image1.Picture = cFormThicknessHeat
		*!*		ELSE
		*!*		
		*!*			ThisFormSet.frmMTR_Scans.Visible = .F.
		*!*			ThisFormSet.frmMTR_Scans.Enabled = .F.
		*!*	*		ThisFormSet.frmMTR_Scans.AlwaysOnTop = .F.
		*!*		
		*!*		ENDIF
		
		
		*!*	ELSE
		*!*		ThisFormSet.frmMTR_Scans.Visible = .F.
		*!*		ThisFormSet.frmMTR_Scans.Enabled = .F.
		*!*		ThisFormSet.frmMTR_Scans.AlwaysOnTop = .F.
		*!*	ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE frmScanMTR.cmdTest.Click
		
		*!*	ThisForm.txtAlloy.Value = "C-276"
		*!*	ThisForm.txtForm.Value = "10"
		*!*	ThisForm.txtThck.Value = ".5"
