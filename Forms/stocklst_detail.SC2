				ThisForm.Descript1.Value	= ''
				ThisForm.Length1.Value		= ''
				ThisForm.CostValue1.Value	= IIF(ISNULL(tmpStockLst.Paid),0,tmpStockLst.Paid)
				ThisForm.S_P.Value			= 0
				ThisForm.InvoiceValue1.Value	= 0
				ThisForm.FloorStatus1.Value	= ''
				ThisForm.cmbFloorStatus.Value	= ''
				ThisForm.Class1.Value		= ''
				ThisForm.cmbClass.Value	= ''
				ThisForm.Location1.Value 	= ' '
				ThisForm.cmbLocation1.Value	= ' '
		
				ThisForm.chkRandLen.Value	= 0
				ThisForm.chkPrime.Value	= 0
				ThisForm.InvCheck1.Value	= CTOD('')
				ThisForm.chkMarkInvCheck.Value	= 0
				ThisForm.chkMarkInvMiss.Value	= 0
				ThisForm.chkQuarantine.Value		= 0
			ELSE
				MESSAGEBOX("Did not retrieve Master data."+CHR(13)+"Setting to default values.",0+16,"SQL error")
				THISFORM.InitMemVar()
			ENDIF
		ENDIF
		
		IF USED("tmpStockLst")
			USE IN tmpStockLst
		ENDIF
		
		
	ENDPROC

