	PROCEDURE DIM11.Valid
		IF This.Value > 0
			IF ThisForm.Size_H1.Value > 0
				IF ThisForm.Size_H1.Value < This.Value
					Wait Window  "The High Tolerance is usually above the Dim 1." nowait
				ENDIF
			ENDIF
			IF ThisForm.Size_L1.Value > 0
				IF ThisForm.Size_L1.Value > This.Value
					Wait Window  "The Low Tolerance is usually below the Dim 1." NOWAIT
				ENDIF
			ENDIF
			ThisForm.GetWeight()
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The Dim 1 is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

