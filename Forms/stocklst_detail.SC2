	PROCEDURE lblReportRack.Click
		*
		PRIVATE cAlloy,cForm,nSize
		cAlloy	= ''
		cForm	= ''
		nSize	= PrepareSQLnum(ThisForm.Dim11.Value,9,3)
		
		*Get Form and Alloy
		PRIVATE cSQL, nSQLEXEC, cAlias
		DO CASE
		CASE ThisForm.txtLst.Value = "S" 
			cSQL = "SELECT Form, Alloy FROM dbo.StockLst_Master WHERE ID = "+ STR(ThisForm.ID1)
		CASE ThisForm.txtLst.Value = "B" 
			cSQL = "SELECT Form, Alloy FROM dbo.BrokerLst_Master WHERE ID = "+ STR(ThisForm.ID1)
		CASE ThisForm.txtLst.Value = "W" 
			cSQL = "SELECT Form, Alloy FROM dbo.WIPLst_Master WHERE ID = "+ STR(ThisForm.ID1)
		ENDCASE
		
		cAlias = ALIAS()
		IF USED("tmpStockLstAF")
			SELECT tmpStockLstAF
		ELSE 
			SELECT 0
		ENDIF
		
		IF LEN(cSQL) > 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstAF')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstAF')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstAF')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstAF')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstAF")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstAF")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Process,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstAF')
			ELSE
				IF USED("tmpStockLstAF")
					cAlloy	= tmpStockLstAF.Alloy
					cForm	= tmpStockLstAF.Form
					USE IN tmpStockLstAF
				ENDIF
			ENDIF
			IF NOT EMPTY(cAlias)
				IF USED(cAlias)
					SELECT (cAlias)
				ENDIF
			ENDIF
		
		
			*cHyperLink = HTML_Inv_Rack("625","10",.375,.T.)
		
			PRIVATE loHyperlink,m.cHyperLink
			m.cHyperLink = HTML_Inv_Rack(cAlloy,cForm,nSize,.T.) &&lReturnURL --not URL is an HTML code.
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			MESSAGEBOX("Cannot find without a Master ID",0,"Done")
		ENDIF
	ENDPROC

