	PROCEDURE checkdata
		*ThisForm.CheckData
		
		
		PRIVATE m.lnWeight, m.S_QTY, m.lcLocation
		m.lnWeight		= PrepareSQLnum(ThisForm.Pounds1.Value,'Pounds',18,4)
		m.S_QTY			= PrepareSQLnum(ThisForm.S_QTY.Value,'S_QTY',18,4)
		m.lcLocation	= PrepareSQLtxt(ThisForm.cmbLocation1.Value,'Location',10)
		
		*Check_Rack_Weight(m.lcLocation)
		*dbo.[f_LBS_At_Location]
		*dbo.[f_MaxLBS_Location]
		
		****************
		*!*	PRIVATE m.lnID_Detail
		*!*	m.lnID_Detail	= PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
		*!*		
		*!*	PRIVATE nMax_P, M.S_PU, cMess
		*!*	m.S_PU	= GetPUfromForm(cForm, ThisForm.nConnHandle)
		
		*!*	nMax_P = get_Max_P_fromPU (M.S_PU, ThisForm.nConnHandle)
		*!*	IF nMax_P < m.S_P
		*!*		cMess = "The Curr ACCT$ per Unit is too high"+CHR(13)+ALLTRIM(STR(m.S_P))+" is greater than the allowed "+ALLTRIM(STR(nMax_P))
		*!*		
		*!*		MESSAGEBOX(cMess,0+48,"Accouting issue")
		*!*		cMess = cMess +CHR(13)+"ID_Detail = "+STR(m.lnID_Detail)+" in "+ThisForm.Lst
		*!*		cMess = cMess +CHR(13)+"S_P was "+ALLTRIM(STR(m.S_P,18,4))
		*!*		cMess = cMess +CHR(13)+"S_P was set to "+ALLTRIM(STR(nMax_P)) +" so it will save"
		*!*		TrackError(cMess,"Accouting issue", PROGRAM(), LINENO(1))
		*!*		m.S_P = nMax_P 
		*!*	ENDIF
		
		
		PRIVATE m.lnID, m.lnID_Detail, m.lnPC, m.lnSize_H, m.lnDim1, m.lnSize_L, m.lnDim2, m.lnDim3
		PRIVATE m.lnWeight, m.lcDescript, m.lcLength, m.lnCostValue, m.lnInvoiceValue
		PRIVATE m.lcFloorStatus, m.lcClass, m.lcLocation
		PRIVATE m.lnRandLen, m.llRandLen, m.lnPrime, m.llPrime
		PRIVATE m.nReceivingID, m.llMarkInvCheck, llMarkInvMiss, llQuarantine
		PRIVATE m.nS_QTY, m.S_P, m.S_Total, m.S_PU
		
		m.lnID			= PrepareSQLnum(ThisForm.ID,'ID',-3)
		m.lnID_Detail	= PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
		m.lnPC			= PrepareSQLnum(ThisForm.PC1.Value,'PC',-3)	
		m.lnSize_H		= PrepareSQLnum(ThisForm.Size_H1.Value,'Size_H',9,4)
		m.lnDim1		= PrepareSQLnum(ThisForm.Dim11.Value,'Dim1',18,4)
		m.lnSize_L		= PrepareSQLnum(ThisForm.Size_L1.Value,'Size_L',9,4)
		m.lnDim2		= PrepareSQLnum(ThisForm.Dim21.Value,'Dim2',18,4)
		m.lnDim3		= PrepareSQLnum(ThisForm.Dim31.Value,'Dim3',18,4)
		m.lnWeight		= PrepareSQLnum(ThisForm.Pounds1.Value,'Pounds',18,4)
		m.lcDescript	= PrepareSQLtxt(ThisForm.Descript1.Value,'Descript',20)
		m.lcLength		= PrepareSQLtxt(ThisForm.Length1.Value,'Length1',160)
		m.lnCostValue	= PrepareSQLnum(ThisForm.CostValue1.Value,'CostValue',-5)
		m.S_P			= PrepareSQLnum(ThisForm.S_P.Value,'S_P',18,4)
		m.lnInvoiceValue= PrepareSQLnum(ThisForm.InvoiceValue1.Value,'InvoiceValue',-5)
		*!*	IF VARTYPE(lnCostValue) = "Y"
		*!*		lnCostValue = MTON(lnCostValue)
		*!*	ENDIF
		*!*	IF VARTYPE(lnInvoiceValue) = "Y"
		*!*		lnInvoiceValue = MTON(lnInvoiceValue)
		*!*	ENDIF
		m.lcFloorStatus	= PrepareSQLtxt(ThisForm.FloorStatus1.Value,'FloorStatus',1)
		m.lcClass		= PrepareSQLtxt(ThisForm.Class1.Value,'Class',1)
		m.lcLocation	= PrepareSQLtxt(ThisForm.cmbLocation1.Value,'Location',10)
		m.llRandLen		= PrepareSQLchk(ThisForm.chkRandLen.Value,'RandLen',.F.)
		m.llPrime		= PrepareSQLchk(ThisForm.chkPrime.Value,'Prime',.F.)
		m.nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		*ThisForm.InvCheck1.Value	= IIF(ISNULL(tmpStockLst_Detail.InvCheck),CTOD(''),TTOD(tmpStockLst_Detail.InvCheck))
		m.llMarkInvCheck	= PrepareSQLchk(ThisForm.chkMarkInvCheck.Value,'MarkInvCheck',.F.)
		m.llMarkInvMiss		= PrepareSQLchk(ThisForm.chkMarkInvMiss.Value,'MarkInvMiss',.F.)
		llQuarantine		= PrepareSQLchk(ThisForm.chkQuarantine.Value,'Quarantine',.F.)
		
		m.nS_QTY			= PrepareSQLnum(ThisForm.S_QTY.Value,'S_QTY',18,4)
		
		m.S_Total		= m.nS_QTY * m.S_P
		
		PRIVATE cForm
		cForm = getFormbyMasterID( ThisForm.ID, ThisForm.txtLst.Value, ThisForm.nConnHandle)
		m.S_PU	= GetPUfromForm(cForm, ThisForm.nConnHandle)
		
		PRIVATE cMess
		cMess = ""
		PRIVATE lOKtoSave
		lOKtoSave = .T.
		
		IF m.lnID < 1
			cMess = cMess + "No Master ID!, Cannot Save!"+CHR(10)+CHR(13)
			lOKtoSave = .F.
		ENDIF
		
		
		PRIVATE nMax_P
		nMax_P = get_Max_P_fromPU (M.S_PU, ThisForm.nConnHandle)
		IF nMax_P < m.S_P
			cMess = "The Curr ACCT$ per Unit is too high"+CHR(13)+ALLTRIM(STR(m.S_P))+" is greater than the allowed "+ALLTRIM(STR(nMax_P)) + CHR(10)
			
			MESSAGEBOX(cMess,0+48,"Accouting issue")
			cMess = cMess +CHR(13)+"ID_Detail = "+STR(m.lnID_Detail)+" in "+ThisForm.Lst
			cMess = cMess +CHR(13)+"S_P was "+ALLTRIM(STR(m.S_P,18,4))
			cMess = cMess +CHR(13)+"S_P was set to "+ALLTRIM(STR(nMax_P)) +" so it will save"
			
			TrackError(cMess,"Accouting issue", PROGRAM(), LINENO(1))
			m.S_P = nMax_P 
			m.S_Total = m.nS_QTY * M.S_P
			*lOKtoSave = .F.
		ENDIF
		
		PRIVATE nCalcWeight, cItemDescript 
		nCalcWeight = 0
		nCalcWeight = CalcDetailPricingUnits(m.lnID,ThisForm.cTBL,m.lnPC,m.lnDim1,m.lnDim2,m.lnDim3,ThisForm.nConnHandle)
		cItemDescript = ItemDescription(cForm, m.lnDim1, m.lnDim2, m.lnDim3, m.nS_QTY, m.llRandLen) &&Proc_Quotes    &&get_Description("SOitem")
		cMess = cMess +CHR(13)+cItemDescript  + CHR(10)+CHR(13)
		
		***********************************************
		** This is Weight based check - S_Qty is better!
		
		IF m.S_PU = 1
			*Check Weight
		
			IF m.lnWeight <= 0
				IF nCalcWeight < 2
					 m.lnWeight = nCalcWeight 
				ELSE
					IF nCalcWeight > 0
						cMess = cMess +"Calculated 'Pricing with Units' "+CHR(13)+"for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1)) + CHR(10)+CHR(13)
						cMess = cMess +"You cannot save with a Weight/Pricing Unit of 0."+CHR(13)
					ENDIF
					*lOKtoSave = .F.
					*lOKtoSave = .T.
				ENDIF
			ELSE
				DO CASE
				CASE (lnWeight+20) > (nCalcWeight+20)*1.3
					IF m.llRandLen AND ThisForm.chkRandLen.Caption = 'With Skeleton'
						*ITs OK to be over with a Skeleton rem			
					ELSE
						IF VAL(cForm) >= 80
							IF nCalcWeight > 0
								cMess = "Calculated 'Pricing with Units' "+CHR(13)+"for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1)) + CHR(10)+CHR(13)
								cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
								cMess = cMess +"This form is allowed to be SAVED!"+CHR(13)
							ENDIF
							*lOKtoSave = .T.
						ELSE
							IF nCalcWeight > 0
								cMess = "Calculated 'Pricing with Units' "+CHR(13)+"for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1)) + CHR(10)+CHR(13)
								cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
								cMess = cMess +"is more than 30% off! "+CHR(13)
								*IF ThisForm.chkRandLen.Caption = 'With Skeleton'
								*	cMess = cMess +"You may need to Enable 'With Skeleton'!"+CHR(13)
								IF NOT m.llRandLen
									cMess = cMess +"You may need to Enable 'Random Length'!"+CHR(13)
									cMess = cMess +"You may NOT be allowed to SAVE!"+CHR(13)
									lOKtoSave = .F.
								ENDIF
							ENDIF
							*lOKtoSave = .F.
							*lOKtoSave = .T.
						ENDIF
					ENDIF
				CASE (nCalcWeight+20) > (lnWeight+20)*1.3
					IF nCalcWeight > 0
						cMess = "Calculated 'Pricing with Units' "+CHR(13)+"for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1)) + CHR(10)+CHR(13)
						cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
						cMess = cMess +"is more than 30% less than Calculated!"+CHR(13)+"You are NOT be allowed to SAVE!"+CHR(13)
						*lOKtoSave = .F.
					ENDIF
					*lOKtoSave = .T.
				CASE (lnWeight+20) > (nCalcWeight+20)*1.1 
					IF m.llRandLen 
					*AND ThisForm.chkRandLen.Caption = 'With Skeleton'
						*ITs OK to be over with a Skeleton rem			
						*lOKtoSave = .T.
					ELSE
						IF VAL(cForm) >= 80
							IF nCalcWeight > 0
								cMess = "Calculated 'Pricing with Units' "+CHR(13)+"for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1)) + CHR(10)+CHR(13)
								cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
								cMess = cMess +"is more than 10% off!"+CHR(13)
								cMess = cMess +"This form is allowed to be SAVED!"+CHR(13)
							ENDIF
							*lOKtoSave = .T.
						ELSE
							IF nCalcWeight > 0
								cMess = "Calculated 'Pricing with Units' "+CHR(13)+"for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1)) + CHR(10)+CHR(13)
								cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
								cMess = cMess +"is more than 10% off!"+CHR(13)
								*IF ThisForm.chkRandLen.Caption = 'With Skeleton'
								IF NOT m.llRandLen
									*cMess = cMess +"You may need to Enable 'With Skeleton'!"+CHR(13)
									cMess = cMess +"You may need to Enable 'Random Length'!"+CHR(13)
									cMess = cMess +"You may NOT be allowed to SAVE!"+CHR(13)
									*lOKtoSave = .F.
								ENDIF
							ENDIF
							*lOKtoSave = .T.
						ENDIF
					ENDIF
				CASE (nCalcWeight+30) > (lnWeight+30)*1.1
					IF nCalcWeight > 0
						cMess = "Calculated 'Pricing with Units' "+CHR(13)+"for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1)) + CHR(10)+CHR(13)
						cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
						cMess = cMess +"is more than 10% less than Calculated!"+CHR(13)
					ENDIF
					*lOKtoSave = .T.
				ENDCASE
			ENDIF
		ENDIF
		
		**************************************************************************
		IF m.S_PU = 2
			*Per Ft	
			PRIVATE nFtLen, nSigDim
			nFtLen = 0
			nSigDim = getSigDim(cForm, ThisForm.nConnHandle)
			IF nSigDim = 2
				nFtLen = IIF(m.lnPC<1,1,m.lnPC) * m.lnDim2/12
			ENDIF
			IF nSigDim = 3
				nFtLen = IIF(m.lnPC<1,1,m.lnPC) * m.lnDim3/12
			ENDIF
							
			IF nFtLen > 0
				IF (m.nS_QTY*99+5) > (nFtLen*99+5)*1.3
					cMess = "Feet for this Detail item is "+ALLTRIM(STR(nFtLen))+CHR(13)
					cMess = cMess +"Your entered Quantity Feet of "+ALLTRIM(STR(m.nS_QTY))+" for Inventory pricing." + CHR(10)+CHR(13)
					cMess = cMess +"Is more than 30% Off!"+CHR(13)
					cMess = cMess +"You will NOT be allowed to SAVE!"+CHR(13)
					lOKtoSave = .F.
				ELSE
					IF (m.nS_QTY*99+5) > (nFtLen*99+5)*1.1
						cMess = "Feet for this Detail item is "+ALLTRIM(STR(nFtLen))+CHR(13)
						cMess = cMess +"Your entered Quantity Feet of "+ALLTRIM(STR(nS_QTY))+" for Inventory pricing." + CHR(10)+CHR(13)
						cMess = cMess +"Is more than 10% Off!"+CHR(13)
						cMess = cMess +"You may not be allowed to SAVE!"+CHR(13)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
		**************************************************************************
		IF m.S_PU = 3
			*Per PC
			IF m.lnPC > 0
				IF m.nS_QTY <> m.lnPC
					cMess = "Pc for this Detail item is "+ALLTRIM(STR(m.lnPC))+CHR(13)
					cMess = cMess +"Your entered Quantity Pieces of "+ALLTRIM(STR(nS_QTY))+" for Inventory pricing." + CHR(10)+CHR(13)
					cMess = cMess +"These must be the same!"+CHR(13)
					cMess = cMess +"You will NOT be allowed to SAVE!"+CHR(13)
					lOKtoSave = .F.
				ENDIF
			ENDIF
		
		ENDIF
		
		*******************************************************************************************************************
		IF VARTYPE(cMess) <> "C"
			*has not been used, initialize here
			cMess = ' '
		ENDIF
		
		***********
		*This Check is S_QTY based
		*Check this form has Correct dims
		PRIVATE lhas_Tol 
		lhas_Tol = isForm_Tolerance(cForm, ThisForm.nConnHandle)
		IF lhas_Tol
			IF m.lnSize_H + m.lnSize_L <=0	
				cMess1 = "Form "+cForm+" requires Tolerances!" + CHR(10)
		*		TrackError(cMess1,"Check that this form has Correct Tolerances", PROGRAM(), LINENO(1))
		*		cMess = cMess + cMess1 + CHR(13)
		*		lOKtoSave = .F.
			ENDIF
		ENDIF
		
		PRIVATE nPO_QTY
		nPO_QTY = CalcDetailPricingUnits(m.lnID,ThisForm.cTBL,m.lnPC,m.lnDim1,m.lnDim2,m.lnDim3,ThisForm.nConnHandle)
		
		PRIVATE nPU, nSigDim 
		nPU = GetPUfromForm(cForm, ThisForm.nConnHandle)
		nSigDim = getSigDim(cForm, ThisForm.nConnHandle)
		
		DO CASE
		CASE nSigDim = 2
			m.lnDim3 = 0
			IF m.lnDim2 <= 0
				cMess1 = "Form "+cForm+" requires a Second dimmension "+ALLTRIM(This.Parent.lblSz2.Caption)+". ID_Detail:"+ALLTRIM(STR(m.lnID_Detail)) + CHR(10)
				MESSAGEBOX(cMess1,64,"Form does not match!")
				*TrackError(cMess1,"Form does not match for FORM!","StockLst_Detail.cmdSave.Click()",LINENO(1))
				cMess = cMess + cMess1 + CHR(13)
				TrackError(cMess,cMess1, PROGRAM(), LINENO(1))
				lOKtoSave = .F.
				RETURN .F.
			ENDIF
		CASE nSigDim = 3
			IF m.lnDim3 <= 0
				cMess1 = "Form "+cForm+" requires a Third dimmension "+ALLTRIM(This.Parent.lblSz3.Caption)+". ID_Detail:"+ALLTRIM(STR(m.lnID_Detail)) + CHR(10)
				MESSAGEBOX(cMess1,64,"Form does not match!")
				*TrackError(cMess1,"Form does not match for FORM!","StockLst_Detail.cmdSave.Click()",LINENO(1))
				cMess = cMess + cMess1 + CHR(13)
				TrackError(cMess,cMess1, PROGRAM(), LINENO(1))
				lOKtoSave = .F.
				RETURN .F.
			ENDIF
		CASE nSigDim = 6
			IF m.lnDim2 <= 0 OR m.lnDim3 <= 0
				cMess1 = "Form "+cForm+" requires a Second "+ALLTRIM(This.Parent.lblSz2.Caption)+CHR(13)+"and Third dimmension "+ALLTRIM(This.Parent.lblSz3.Caption)+". ID_Detail:"+ALLTRIM(STR(m.lnID_Detail)) + CHR(10)
				MESSAGEBOX(cMess1,64,"Form does not match!")
				*TrackError(cMess1,"Form does not match for FORM!","StockLst_Detail.cmdSave.Click()",LINENO(1))
				cMess = cMess + cMess1 + CHR(13)
				TrackError(cMess,cMess1, PROGRAM(), LINENO(1))
				lOKtoSave = .F.
				RETURN .F.
			ENDIF
		ENDCASE	
		
		*********
			
		DO CASE 
		CASE nPU = 0
		CASE nPU = 1
			*Pounds -QTY does not Match Listed 
			*use nCalcWeight or QTY
			IF nCalcWeight < 1
				nCalcWeight = nPO_QTY 
			ENDIF
			
			IF ((nPO_QTY+10)*1.1 < nCalcWeight+10) OR ((nCalcWeight+10)*1.1 < nPO_QTY+10)
				*Why is nCalcWeight not nPO_QTY?
				* use nPO_QTY
				nCalcWeight = nPO_QTY 
			ENDIF
			
			IF ((m.nS_QTY+10)*1.1 < nCalcWeight+10) OR ((nCalcWeight+10)*1.1 < m.nS_QTY+10) AND m.nS_QTY > 10
				IF ((m.nS_QTY+10)*1.3 < nCalcWeight+10) OR ((nCalcWeight+10)*1.3 < m.nS_QTY+10)
					cMess1 = "Your QTY does not Match!"+CHR(13)+"Listed   = "+ALLTRIM(STR(nCalcWeight))+CHR(13)+"Calculate = "+ALLTRIM(STR(m.nS_QTY))+CHR(13)+" ID_Detail:"+ALLTRIM(STR(m.lnID_Detail))
					IF m.llRandLen
						cMess1 = cMess1 +CHR(10)+CHR(13)+ "But the Random Length check mark will"+CHR(13)+" ALLOW this QTY to be SAVED!"+ CHR(13)+"You will have one more chance to stop the save."
						MESSAGEBOX(cMess1,64,"QTY does not match!")
						*TrackError(cMess1,"QTY does not match for FORM!","StockLst_Detail.cmdSave.Click()",LINENO(1))
						cMess = cMess + +CHR(13)+ "But the Random Length check mark will"+CHR(13)+" ALLOW this QTY to be SAVED!" + CHR(13)
					ELSE
						cMess1 = cMess1+CHR(10)+CHR(13)+"Should this be Random Lengths?"
						MESSAGEBOX(cMess1,64,"QTY does not match!")
						*TrackError(cMess1,"QTY does not match for FORM!","StockLst_Detail.cmdSave.Click()",LINENO(1))
						cMess = cMess + cMess1 + CHR(13)
						TrackError(cMess,"", PROGRAM(), LINENO(1))
						lOKtoSave = .F.
						RETURN .F.
					ENDIF
				ELSE
					cMess1 = "Your QTY does not Match!"+CHR(13)+"Listed   = "+ALLTRIM(STR(nCalcWeight))+CHR(13)+"Calculate = "+ALLTRIM(STR(m.nS_QTY))+CHR(13)+"  ID_Detail:"+ALLTRIM(STR(m.lnID_Detail))
					MESSAGEBOX(cMess1+CHR(13)+cItemDescript ,64,"QTY does not match!")
					
					cMess = cMess + cMess1 + CHR(13)
				ENDIF
			ENDIF
			***
		CASE nPU = 2
			*FT - QTY Feet does not Match Calculated Feet
			PRIVATE nFtLen
			nFtLen = 0
			IF nSigDim = 2
				nFtLen = IIF(m.lnPC<1,1,m.lnPC) * m.lnDim2/12
			ENDIF
			IF nSigDim = 3
				nFtLen = IIF(m.lnPC<1,1,m.lnPC) * m.lnDim3/12
			ENDIF
			
			IF ((m.nS_QTY+100)*1.1 < nFtLen+100) OR ((nFtLen+100)*1.1 < m.nS_QTY+100)  AND m.nS_QTY > 10
				IF nSigDim = 2
					cMess1 = "Your QTY Feet does not Match Calculated Feet."+CHR(13)+"Pieces x Sz2 /12! ID_Detail:"+ALLTRIM(STR(m.lnID_Detail))
					MESSAGEBOX(cMess1+CHR(13)+"CANNOT SAVE!",0,"Stock Vs Order does not match.")	
					
					cMess = cMess + cMess1 + CHR(13)
					TrackError(cMess,"Your QTY Feet does not Match Calculated Feet", PROGRAM(), LINENO(1))
					lOKtoSave = .F.
					RETURN .F.
				ENDIF
				IF nSigDim = 3
					cMess1 = "Your QTY Feet does not Match Calculated Feet."+CHR(13)+"Pieces x Sz3 /12! ID_Detail:"+ALLTRIM(STR(m.lnID_Detail))
					MESSAGEBOX(cMess1+CHR(13)+"CANNOT SAVE!",0,"Stock Vs Order does not match.")
		
					cMess = cMess + cMess1 + CHR(13)
					TrackError(cMess,"Your QTY Feet does not Match Calculated Feet", PROGRAM(), LINENO(1))
					lOKtoSave = .F.
					RETURN .F.
				ENDIF
			ENDIF
			***
		CASE nPU = 3
			*PC - QTY Pieces does not Match Pieces
			IF ((m.nS_QTY+10)*1.1 < m.lnPC+10) OR ((m.lnPC+10)*1.1 < m.nS_QTY+10)
				cMess1 = "Your QTY Pieces does not Match Pieces!" +CHR(13)+"Listed   = "+ALLTRIM(STR(m.lnPC))+CHR(13)+"[Quantity] = "+ALLTRIM(STR(m.nS_QTY))+CHR(13)+"for ID_Detail:"+ALLTRIM(STR(m.lnID_Detail))
				MESSAGEBOX(cMess1+CHR(13)+"CANNOT SAVE!",0,"QTY needs to match for PCs this FORM.")
				
				cMess = cMess + cMess1 + CHR(13)
				TrackError(cMess,"PC - QTY Pieces does not Match Pieces", PROGRAM(), LINENO(1))
				lOKtoSave = .F.
				RETURN .F.
			ENDIF
			***
		CASE nPU = 4
			*Lot
		OTHERWISE
		ENDCASE
		
		**********************************************
		*Check for Changes in m.lnCostValue
		PRIVATE cTBL
		DO CASE
		CASE ThisForm.Lst = "StockLst"
			cTBL = "S"
		CASE ThisForm.Lst = "BrokerLst"
			cTBL = "B"
		CASE ThisForm.Lst = "WIPLst"
		ENDCASE
		
		ThisForm.Visible = .F.
		
		IF CheckChangeDetailPrice( m.lnID_Detail, m.lnCostValue, m.S_P, cTBL, ThisForm.nConnHandle, "StockLst_Detail")
			*calls DO FORM Forms\StockLst_Detail_Cost
			*lOKtoSave = .F.  -Should be OK to Save
		ELSE
			*ThisForm.S_P.BackColor = RGB(255,255,128)
		ENDIF
		ThisForm.Visible = .T.
		
		
		
		
		*******************
		
		PRIVATE nACreturn 
		nACreturn = -1
		
		IF m.lnCostValue > 0 AND ThisForm.cTBL = "S"
			nACreturn = AccountingCosting( m.lnID, m.lnID_Detail, '', ThisForm.nConnHandle )
			*AccountingCosting(pID, pID_Detail, pSOitem, pConn)
			DO CASE
			CASE nACreturn = -4
				*No ID_Detail
			CASE nACreturn = -3
				MESSAGEBOX("Dimensions are not entered properly."+CHR(13)+"Is 'Length' being used instead of 'Dim2'?",0,"'AccountingCosting' returned Error")
			CASE nACreturn = -2
				MESSAGEBOX("Could not find Alloy or Form in Master.",0,"'AccountingCosting' returned Error")
			CASE nACreturn = -1
				MESSAGEBOX("No ID_Detail.",0,"'AccountingCosting' returned Error")
			CASE nACreturn = 0
				*Zero Cost
				m.lnCostValue = 0
				WAIT WINDOW "This drop confirms to the 'Zero out Cost' rules." NOWAIT
			CASE nACreturn = 1
				*Keep sames Cost
			CASE nACreturn < -4
				*Error
				MESSAGEBOX("Error: "+STR(nACreturn),0,"'AccountingCosting' returned Error")
			ENDCASE
		ENDIF
		
		**********************
		*RETURN lOKtoSave 
		**************************************************************************
		*End of Data Check
		IF lOKtoSave
			IF NOT EMPTY( cMess )
				IF MESSAGEBOX( "Save?"+CHR(13)+cMess+CHR(13)+"Do you still want to save?",4,"Data has been changed.") = 6
					RETURN .T.
				ELSE
					RETURN .F.
				ENDIF
			ENDIF
		ELSE
			TrackError( cMess+CHR(13)+"OKtoSave is False.","StockLst Data Check is bad", PROGRAM(), LINENO(1))
			MESSAGEBOX( cMess+CHR(13)+"OKtoSave is False.", 0 ,"Check Data: Cannot Save!") 
			RETURN .F.
		ENDIF
		
		
	ENDPROC

	PROCEDURE clonedetail
		PARAMETERS pID_Detail
		*ThisForm.CloneDetail()
		
		PRIVATE nID_Detail
		IF VARTYPE(pID_Detail) != "N"
			pID_Detail = 0
		ENDIF
		
		IF pID_Detail = 0
			MESSAGEBOX("Could not clone!."+CHR(13)+"ID_Detail is empty",0+16,"No ID_Detail in 'CloneDetail()'")
			RETURN -1
		ELSE
			nID_Detail = pID_Detail
		ENDIF
		
		PRIVATE cSQL, nSQLEXEC
		
		DO CASE
		CASE ThisForm.cTBL	= "S" 
			cSQL = "SELECT * FROM dbo.StockLst_Detail WHERE ID_Detail = "+	STR(nID_Detail)
		CASE ThisForm.cTBL	= "B" 
			cSQL = "SELECT * FROM dbo.BrokerLst_Detail WHERE ID_Detail = "+ STR(nID_Detail)
		CASE ThisForm.cTBL	= "W" 
			cSQL = "SELECT * FROM dbo.WIPLst_Detail WHERE ID_Detail = "+ STR(nID_Detail)
		ENDCASE
		
		IF USED("tmpStockLstD")
			SELECT tmpStockLstD
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLstD')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstD")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLstD")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL_Process,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLstD')
		ELSE
			IF USED("tmpStockLstD")
				THISFORM.ID_Detail 			= nID_Detail
				THISFORM.ID 				= tmpStockLstD.ID
				ThisForm.ID1.Value			= tmpStockLstD.ID
				ThisForm.ID_Detail1.Value	= tmpStockLstD.ID_Detail
				ThisForm.PC1.Value			= PrepareSQLnum(tmpStockLstD.Pc,'Pc',-3)
				ThisForm.Size_H1.Value		= PrepareSQLnum(tmpStockLstD.Size_H,'Size_H',9,4)
				ThisForm.Dim11.Value		= PrepareSQLnum(tmpStockLstD.Dim1,'Dim1',18,4)
				ThisForm.Size_L1.Value		= PrepareSQLnum(tmpStockLstD.Size_L,'Size_L',9,4)
				ThisForm.Dim21.Value		= PrepareSQLnum(tmpStockLstD.Dim2,'Dim2',18,4)
				ThisForm.Dim31.Value		= PrepareSQLnum(tmpStockLstD.Dim3,'Dim3',18,4)
				ThisForm.Pounds1.Value		= PrepareSQLnum(tmpStockLstD.Weight,'Weight',18,4)
				
				ThisForm.Descript1.Value	= PrepareSQLtxt(tmpStockLstD.Descript,'Descript',20)
				ThisForm.Length1.Value		= PrepareSQLtxt(tmpStockLstD.Length,'Length',160)
				ThisForm.CostValue1.Value	= PrepareSQLnum(tmpStockLstD.CostValue,'CostValue',-5)
				ThisForm.S_P.Value			= PrepareSQLnum(tmpStockLstD.S_P,'S_P',-5)
				ThisForm.InvoiceValue1.Value= PrepareSQLnum(tmpStockLstD.InvoiceValue,'InvoiceValue',-5)
				ThisForm.FloorStatus1.Value	= PrepareSQLtxt(tmpStockLstD.FloorStatus,'FloorStatus',1)
				ThisForm.cmbFloorStatus.Value= PrepareSQLtxt(tmpStockLstD.FloorStatus,'FloorStatus',1)
				ThisForm.Class1.Value		= PrepareSQLtxt(tmpStockLstD.Class,'Class',1)
				ThisForm.cmbClass.Value		= PrepareSQLtxt(tmpStockLstD.Class,'Class',1)
				ThisForm.Location1.Value	= PrepareSQLtxt(tmpStockLstD.Location,'Location',10)
				ThisForm.cmbLocation1.Value	= PrepareSQLtxt(tmpStockLstD.Location,'Location',10)
			
				ThisForm.chkRandLen.Value	= PrepareSQLchk(tmpStockLstD.RandLen,'RandLen')
				ThisForm.chkPrime.Value		= PrepareSQLchk(tmpStockLstD.Prime,'Prime')
				ThisForm.InvCheck1.Value	= PrepareSQLdate(tmpStockLstD.InvCheck,'InvCheck')
				ThisForm.chkMarkInvCheck.Value	= 0
				ThisForm.chkMarkInvMiss.Value	= 0
				ThisForm.chkQuarantine.Value	= PrepareSQLchk(tmpStockLstD.Quarantine,'Quarantine')
			ELSE
				MESSAGEBOX("Did not retrieve Detail data."+CHR(13)+"Setting to default values.",0+16,"SQL error")
				THISFORM.InitMemVar()
			ENDIF
		ENDIF
		
		IF USED("tmpStockLstD")
			USE IN tmpStockLstD
		ENDIF
		
		
	ENDPROC

	PROCEDURE copyfromrid		&& CopyFromRid
		PARAMETERS pReceivingID
		*ThisForm.CopyFromRid(pReceivingID)
		
		PRIVATE cSQL, nSQLEXEC
			
		DO CASE
		CASE ThisForm.cTBL	= "S" 
			cSQL = "SELECT * FROM dbo.StockLst_Detail WHERE ReceivingID = "+STR(pReceivingID)
		CASE ThisForm.cTBL	= "B" 
			cSQL = "SELECT * FROM dbo.BrokerLst_Detail WHERE ReceivingID = "+STR(pReceivingID)
		CASE ThisForm.cTBL	= "W" 
			cSQL = "SELECT * FROM dbo.WIPLst_Detail WHERE ReceivingID = "+STR(pReceivingID)
		ENDCASE
		
		IF USED("tmpStockLst_Detail")
			SELECT tmpStockLst_Detail
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst_Detail')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst_Detail")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst_Detail')
		ELSE
			IF USED("tmpStockLst_Detail")
				THISFORM.ID_Detail 			= PrepareSQLnum(tmpStockLst_Detail.ID_Detail,'ID_Detail',-3)
				THISFORM.ID 				= PrepareSQLnum(tmpStockLst_Detail.ID,'ID',-3)
		
				ThisForm.ID1.Value			= PrepareSQLnum(tmpStockLst_Detail.ID,'ID',-3)
				ThisForm.ID_Detail1.Value	= PrepareSQLnum(tmpStockLst_Detail.ID_Detail,'ID_Detail',-3)
				ThisForm.PC1.Value			= PrepareSQLnum(tmpStockLst_Detail.PC,'PC',-3)
				ThisForm.Size_H1.Value		= PrepareSQLnum(tmpStockLst_Detail.Size_H,'Size_H',-5)
				ThisForm.Dim11.Value		= PrepareSQLnum(tmpStockLst_Detail.Dim1,'Dim1',-5)
				ThisForm.Size_L1.Value		= PrepareSQLnum(tmpStockLst_Detail.Size_L,'Size_L',-5)
				ThisForm.Dim21.Value		= PrepareSQLnum(tmpStockLst_Detail.Dim2,'Dim2',-5)
				ThisForm.Dim31.Value		= PrepareSQLnum(tmpStockLst_Detail.Dim3,'Dim3',-5)
				ThisForm.chkRandLen.Value	= PrepareSQLchk(tmpStockLst_Detail.RandLen,'RandLen')
				ThisForm.chkPrime.Value		= PrepareSQLchk(tmpStockLst_Detail.Prime,'Prime')
				ThisForm.S_QTY.Value		= PrepareSQLnum(tmpStockLst_Detail.S_QTY,'S_QTY',-5)
				ThisForm.Pounds1.Value		= PrepareSQLnum(tmpStockLst_Detail.Weight,'Weight',-5)
				ThisForm.Descript1.Value	= PrepareSQLtxt(tmpStockLst_Detail.Descript,'Descript',20)
				ThisForm.Length1.Value		= PrepareSQLtxt(tmpStockLst_Detail.Length,'Length',160)
				ThisForm.CostValue1.Value	= PrepareSQLnum(tmpStockLst_Detail.CostValue,'CostValue',-5)
				ThisForm.S_P.Value			= PrepareSQLnum(tmpStockLst_Detail.S_P,'S_P',-5)
				ThisForm.InvoiceValue1.Value	= PrepareSQLnum(tmpStockLst_Detail.InvoiceValue,'InvoiceValue',-5)
				
				ThisForm.S_QTY.Value		= PrepareSQLnum(tmpStockLst_Detail.S_QTY,'S_QTY',-5)
		*!*			IF NOT ISNULL(tmpStockLst_Detail.S_QTY)
		*!*				** use QTY
		*!*				IF tmpStockLst_Detail.S_QTY = tmpStockLst_Detail.S_P  &&Had mistakenly saved S as QTY!!!! untill 9/11/2015
		*!*					*Use Weight to fill QTY
		*!*					ThisForm.S_QTY.Value		= IIF(ISNULL(tmpStockLst_Detail.Weight),0,tmpStockLst_Detail.Weight)
		*!*				ELSE
		*!*					* use the correct S_QTY
		*!*					ThisForm.S_QTY.Value		= IIF(ISNULL(tmpStockLst_Detail.S_P),0,tmpStockLst_Detail.S_P)
		*!*				ENDIF
		*!*			ELSE	
		*!*				*Use Weight to fill QTY
		*!*				ThisForm.S_QTY.Value		= IIF(ISNULL(tmpStockLst_Detail.Weight),0,tmpStockLst_Detail.Weight)
		*!*			ENDIF
				ThisForm.Pounds1.Value		= PrepareSQLnum(tmpStockLst_Detail.Weight,'Weight',-5)
				
						
				ThisForm.Descript1.Value	= PrepareSQLtxt(tmpStockLst_Detail.Descript,'Descript',20)
				ThisForm.Length1.Value		= PrepareSQLtxt(tmpStockLst_Detail.Length,'Length',160)
				ThisForm.CostValue1.Value	= PrepareSQLnum(tmpStockLst_Detail.CostValue,'CostValue',-5)
				ThisForm.S_P.Value			= PrepareSQLnum(tmpStockLst_Detail.S_P,'S_P',-5)
				ThisForm.InvoiceValue1.Value	= PrepareSQLnum(tmpStockLst_Detail.InvoiceValue,'InvoiceValue',-5)
				
				ThisForm.FloorStatus1.Value		= PrepareSQLtxt(tmpStockLst_Detail.FloorStatus,'FloorStatus',1)
				ThisForm.cmbFloorStatus.Value	= PrepareSQLtxt(tmpStockLst_Detail.FloorStatus,'FloorStatus',1)
				ThisForm.Class1.Value		= PrepareSQLtxt(tmpStockLst_Detail.CLASS,'Class',1)
				ThisForm.cmbClass.Value		= PrepareSQLtxt(tmpStockLst_Detail.CLASS,'Class',1)
				ThisForm.Location1.Value	= PrepareSQLtxt(tmpStockLst_Detail.Location,'Location',10)
				ThisForm.cmbLocation1.Value	= PrepareSQLtxt(tmpStockLst_Detail.Location,'Location',10)
		
				ThisForm.chkRandLen.Value	= PrepareSQLchk(tmpStockLst_Detail.RandLen,'RandLen')
				ThisForm.chkPrime.Value		= PrepareSQLchk(tmpStockLst_Detail.Prime,'Prime')
				
				ThisForm.txtReceivingID.Value	= PrepareSQLnum(tmpStockLst_Detail.ReceivingID,'ReceivingID',-3)
				ThisForm.InvCheck1.Value		= PrepareSQLdate(tmpStockLst_Detail.InvCheck,'InvCheck')
				ThisForm.chkMarkInvCheck.Value	= 0
				ThisForm.chkMarkInvMiss.Value	= 0
				ThisForm.chkQuarantine.Value		= PrepareSQLchk(tmpStockLst_Detail.Quarantine,'Quarantine')
				
			ELSE
