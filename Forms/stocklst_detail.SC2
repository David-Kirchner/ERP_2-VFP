	PROCEDURE Unload
		= SQLDISCONNECT( ThisForm.nConnHandle )
		
		*RELEASE ARRAY gaUnit()
		RETURN ThisForm.ID_Detail
	ENDPROC

	PROCEDURE BrkDim11.GotFocus
		this.InputMask = "999999999999999.9999"
	ENDPROC

	PROCEDURE BrkDim11.LostFocus
		this.InputMask = "999,999,999,999,999.9999"
	ENDPROC

	PROCEDURE BrkDim11.Valid
		IF This.Value > 0
			IF ThisForm.BrkSize_H1.Value > 0
				IF ThisForm.BrkSize_H1.Value < This.Value
					Wait Window  "The High Tolerance is usually above the Dim 1." nowait
				ENDIF
			ENDIF
			IF ThisForm.BrkSize_L1.Value > 0
				IF ThisForm.BrkSize_L1.Value > This.Value
					Wait Window  "The Low Tolerance is usually below the Dim 1." NOWAIT
				ENDIF
			ENDIF
			ThisForm.GetBrkWeight()
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The Dim 1 is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE BrkDim21.GotFocus
		this.InputMask = "999999999999999.9999"
	ENDPROC

	PROCEDURE BrkDim21.LostFocus
		this.InputMask = "999,999,999,999,999.9999"
	ENDPROC

	PROCEDURE BrkDim21.Valid
		PRIVATE nBrkDim2, nDim2
		nBrkDim2 = PrepareSQLnum(This.Value,'DIM2',18,4)
		
		PRIVATE cForm
		cForm = getFormbyMasterID( ThisForm.ID, ThisForm.cTBL, ThisForm.nConnHandle)
		
		IF usesForm_Dim2(cForm, ThisForm.nConnHandle)
		*IF RequireSZ2LBS(cForm,ThisForm.nConnHandle)
			IF nBrkDim2 > 0
				IF ThisForm.nOrigDim2 > 0
					ThisForm.Dim21.Value = ThisForm.nOrigDim2 - nBrkDim2
					ThisForm.Pounds1.Value = ThisForm.nOrigDim2 - nBrkDim2
				ENDIF
			ELSE	
				IF ThisForm.nOrigDim2 > 0
					ThisForm.Dim21.Value = ThisForm.nOrigDim2
					ThisForm.Pounds1.Value = ThisForm.nOrigDim2 
				ENDIF
			ENDIF
		
			ThisForm.BrkWeight1.Value = nBrkDim2
		ENDIF
	ENDPROC

	PROCEDURE BrkDim31.GotFocus
		this.InputMask = "999999999999999.9999"
	ENDPROC

	PROCEDURE BrkDim31.LostFocus
		this.InputMask = "999,999,999,999,999.9999"
	ENDPROC

	PROCEDURE BrkDim31.Valid
		PRIVATE nBrkDim3, nDim3
		nBrkDim3 = PrepareSQLnum(This.Value,'DIM3',18,4)
		
		PRIVATE cForm
		cForm = getFormbyMasterID( ThisForm.ID, ThisForm.txtLst.Value, ThisForm.nConnHandle)
		
		IF RequireSZ3LBS(cForm,ThisForm.nConnHandle)
			IF nBrkDim3 > 0
				IF ThisForm.nOrigDim3 > 0
					ThisForm.Dim31.Value = ThisForm.nOrigDim3 - nBrkDim3
					ThisForm.Pounds1.Value = ThisForm.nOrigWeight - nBrkDim3
				ENDIF
			ELSE	
				IF ThisForm.nOrigDim3 > 0
					ThisForm.Dim31.Value = ThisForm.nOrigDim3
					ThisForm.Pounds1.Value = ThisForm.nOrigWeight 
				ENDIF
			ENDIF
		
			ThisForm.BrkWeight1.Value = nBrkDim3
		ENDIF
	ENDPROC

	PROCEDURE BrkPC1.Valid
		PRIVATE nBrkPC, nPC
		nBrkPC = PrepareSQLnum(This.Value,'PC',-3)	
		nPC = PrepareSQLnum(ThisForm.PC1.Value,'PC',-3)	
		 
		IF nBrkPC > 0
			IF ThisForm.nOrigPC > 0
				ThisForm.PC1.Value = ThisForm.nOrigPC - nBrkPC 
				ThisForm.GetWeight()
			ENDIF
		ELSE	
			IF ThisForm.nOrigPC > 0
				ThisForm.PC1.Value = ThisForm.nOrigPC 
				ThisForm.GetWeight()
			ENDIF
		ENDIF
		
		ThisForm.GetBrkWeight()
	ENDPROC

	PROCEDURE BrkSize_H1.GotFocus
		this.InputMask = "99,999.9999"
	ENDPROC

	PROCEDURE BrkSize_H1.LostFocus
		this.InputMask = "999,999.9999"
	ENDPROC

	PROCEDURE BrkSize_H1.Valid
		IF This.Value > 0
			IF ThisForm.BrkDIM11.Value > 0
				IF ThisForm.BrkDIM11.Value > This.Value
					WAIT WINDOW "The High Tolerance is usually higher than the Dim 1" NOWAIT
					*,0,"Caution")
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The High Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE BrkSize_L1.GotFocus
		this.InputMask = "99,999.9999"
	ENDPROC

	PROCEDURE BrkSize_L1.LostFocus
		this.InputMask = "999,999.9999"
	ENDPROC

	PROCEDURE BrkSize_L1.Valid
		IF This.Value > 0
			IF ThisForm.DIM11.Value > 0
				IF ThisForm.DIM11.Value < This.Value
					WAIT WINDOW "The Low Tolerance is usually below the Dim 1" NOWAIT
				ENDIF
			ENDIF
		ELSE
			IF This.Value < 0
				MESSAGEBOX( "The Low Tolerance is not be be negative.",0,"Error")
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE BrkWeight1.GotFocus
		this.InputMask = "99999999.99"
	ENDPROC

	PROCEDURE BrkWeight1.LostFocus
		this.InputMask = "99,999,999.99"
	ENDPROC

	PROCEDURE BrkWeight1.Valid
		PRIVATE nBrkWeight, nDim2
		nBrkWeight = PrepareSQLnum(This.Value,'Weight',18,4)
		 
		IF nBrkWeight > 0
			IF ThisForm.nOrigWeight > 0
				ThisForm.Pounds1.Value = ThisForm.nOrigWeight - nBrkWeight
			ENDIF
		ELSE	
			IF ThisForm.nOrigWeight > 0
				ThisForm.Pounds1.Value = ThisForm.nOrigWeight 
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE chkMarkInvCheck.Click
		PRIVATE cSQL, nSQLEXEC, lOK, cSQLi
		lOK = .T.
		
		******************************
		PRIVATE m.lnID
		PRIVATE m.llMarkInvCheck
		
		m.lnID				= THISFORM.ID
		m.llMarkInvCheck	= PrepareSQLchk(ThisForm.chkMarkInvCheck.Value,'MarkInvCheck',.F.)
		
		*******************
		IF m.lnID = 0
			MESSAGEBOX("Master ID is 0"+CHR(13)+"Something has gone wrong."+CHR(13)+"This Detail with no Master will not be able to be saved!",0+16,"Error -Abort")
			RETURN -1
		ENDIF
		*******************
		
		DO CASE 
		CASE THISFORM.WhatDo = "ADD" OR THISFORM.WhatDo = "CLONE"
			WAIT WINDOW "This change will be recorded when you 'SAVE'" NOWAIT
			
		CASE THISFORM.WhatDo = "EDIT"
			IF ThisForm.Lst = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Detail SET "
			ELSE
				cSQL = "UPDATE dbo.BrokerLst_Detail SET "
			ENDIF
			cSQL = cSQL+ "InvCheck=GETDATE()"
			cSQL = cSQL+ " WHERE ID_Detail="+STR(THISFORM.ID_Detail)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				MESSAGEBOX("Could not update at this time",16,"Error.")
			ELSE
				ThisForm.InvCheck1.Value = DATE()
				MESSAGEBOX("The 'InvCheck' field now has todays date."+CHR(13)+"Todays DATE was recorded to this Detail record!"+CHR(13)+CHR(13)+"If that is all you need to edit,"+CHR(13)+"Please ABORT as another SAVE will create 2 extra history records."+CHR(13)+"Every StockLst change is recorded.",0,"Todays DATE was recorded to this Detail!")
			ENDIF
		ENDCASE
		
	ENDPROC

	PROCEDURE chkMarkInvMiss.Click
		IF THIS.Value > 0
			IF ThisForm.chkMarkInvCheck.Value = 1
				MESSAGEBOX("Unmarking the 'Inventory Checked' mark",0+64,'Set to Missing')
				ThisForm.chkMarkInvCheck.Value = 0
				RETURN
			ENDIF
		ENDIF
		
		
		PRIVATE cSQL, nSQLEXEC
		PRIVATE m.lnID
		PRIVATE llMarkInvMiss
		
		m.lnID				= THISFORM.ID
		m.llMarkInvMiss		= PrepareSQLchk(ThisForm.chkMarkInvMiss.Value,'MarkInvMiss',.F.)
		
		*******************
		IF m.lnID = 0
			MESSAGEBOX("Master ID is 0"+CHR(13)+"Something has gone wrong."+CHR(13)+"This Detail with no Master will not be able to be saved!",0+16,"Error -Abort")
			RETURN -1
		ENDIF
		*******************
		
		DO CASE 
		CASE THISFORM.WhatDo = "ADD" OR THISFORM.WhatDo = "CLONE"
			WAIT WINDOW "This change will be recorded when you 'SAVE'" NOWAIT
			
		CASE THISFORM.WhatDo = "EDIT"
			IF m.llMarkInvMiss
				IF ThisForm.Lst = "StockLst"
					cSQL = "UPDATE dbo.StockLst_Detail SET "
				ELSE
					cSQL = "UPDATE dbo.BrokerLst_Detail SET "
				ENDIF
			
				cSQL = cSQL+ " InvCheck=''"		&&Will show AS '1900-01-01 00:00:00.000'
				cSQL = cSQL+ " WHERE ID_Detail="+STR(THISFORM.ID_Detail)
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					MESSAGEBOX("Could not Save",16,"Error")
				ELSE
					WAIT WINDOW "Saved MISSING to detail record." NOWAIT
					MESSAGEBOX("The 'InvCheck' field is now empty."+CHR(13)+"If that is all you need to edit,"+CHR(13)+"Please ABORT as another SAVE will create 2 extra history records."+CHR(13)+"Every StockLst change is recorded.",0,"Saved")
				ENDIF
			ELSE
				WAIT WINDOW "The only way to mark as NOT Missing is to mark as 'Inventory Checked'." NOWAIT
			ENDIF
		ENDCASE
		
	ENDPROC

	PROCEDURE chkQuarantine.Click
		PRIVATE cSQL, nSQLEXEC
		PRIVATE m.lnID
		PRIVATE llQuarantine
		
		m.lnID				= THISFORM.ID
		llQuarantine		= PrepareSQLchk(ThisForm.chkQuarantine.Value,'Quarantine',.F.)
		
		*******************
		IF m.lnID = 0
			MESSAGEBOX("Master ID is 0"+CHR(13)+"Something has gone wrong."+CHR(13)+"This Detail with no Master will not be able to be saved!",0+16,"Error -Abort")
			RETURN -1
		ENDIF
		*******************
		
		DO CASE 
		CASE THISFORM.WhatDo = "ADD" OR THISFORM.WhatDo = "CLONE"
			WAIT WINDOW "This change will be recorded when you 'SAVE'" NOWAIT
			
		CASE THISFORM.WhatDo = "EDIT"
			IF ThisForm.Lst = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Detail SET "
			ELSE
				cSQL = "UPDATE dbo.BrokerLst_Detail SET "
			ENDIF
			cSQL = cSQL+ "Quarantine="+IIF(llQuarantine,'1','0')+""
			cSQL = cSQL+ " WHERE ID_Detail="+STR(THISFORM.ID_Detail)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				MESSAGEBOX("Could not save",16,"Error")
			ELSE
				WAIT WINDOW "Saved QUARANTINE to detail record." NOWAIT
				MESSAGEBOX("Quarantine field is marked."+CHR(13)+"If that is all you need to edit,"+CHR(13)+"Please ABORT as another SAVE will create 2 extra history records."+CHR(13)+"Every StockLst change is recorded.",0,"Saved")
			ENDIF
		ENDCASE
		
	ENDPROC

	PROCEDURE CLASS1.Click
		*H Hold, C Consumed
	ENDPROC

	PROCEDURE cmbClass.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('tmpStockClass')
			SELECT tmpStockClass
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [Value],[Definition] FROM dbo.StockLst_Definition WHERE [Table] = 'StockLst_Detail' AND [Column]='Class' "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockClass')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'tmpStockClass')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockClass')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT tmpStockFloorStatus
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockClass')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockClass")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockClass")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'tmpStockClass')
		ENDIF
		
		DIMENSION a_Class(1,2)
		
		IF USED('tmpStockClass')
			SELECT LEFT(Value,1), IIF(Definition="Empty",SPACE(50),Definition) FROM tmpStockClass INTO ARRAY a_Class
			
			USE IN tmpStockClass
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(a_Class)+2
		This.BoundColumn = 1
		This.ColumnWidths = "20,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(a_Class,1)
		*Add a Blank
		this.addListitem(" ",1,1)
		this.addListitem(" ",1,2)
		
		FOR I = 1 TO nArrayCount
			this.addListitem(a_Class(I, 1),I+1,1)
			this.addListitem(a_Class(I, 2),I+1,2)
		ENDFOR
	ENDPROC

	PROCEDURE cmbClass.LostFocus
		ThisForm.Class1.Value = This.Value
		ThisForm.Class1.FORECOLOR = RGB(0,0,0)
	ENDPROC

