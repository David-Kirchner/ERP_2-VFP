	ENDPROC

	PROCEDURE formstext
		*PARAMETERS
		*ThisForm.FormsText()
		
		*Get Form and Alloy
		PRIVATE cSQL, nSQLEXEC, cAlias
		
		DO CASE
		CASE ThisForm.cTBL	= "S" 
			cSQL = "SELECT Form, Alloy FROM dbo.StockLst_Master WHERE ID = "+ STR(THISFORM.ID)
		CASE ThisForm.cTBL	= "B" 
			cSQL = "SELECT Form, Alloy FROM dbo.BrokerLst_Master WHERE ID = "+ STR(THISFORM.ID)
		CASE ThisForm.cTBL	= "W" 
			cSQL = "SELECT Form, Alloy FROM dbo.WIPLst_Master WHERE ID = "+ STR(THISFORM.ID)
		ENDCASE
		
		cAlias = ALIAS()
		IF USED("tmpStockLst")
			SELECT tmpStockLst
		ELSE
			SELECT 0
		ENDIF
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 1
			SQLEXECError(cSQL_Process,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst')
		ELSE
			IF USED("tmpStockLst")
				cAlloy	= tmpStockLst.Alloy
				cForm	= tmpStockLst.FORM
				USE IN tmpStockLst
			ENDIF
		ENDIF
		
		
		IF NOT EMPTY(cForm)
			PRIVATE lCurrentTable
			lCurrentTable = ALIAS()
			IF GetFormCaptions(cForm,ThisForm.nConnHandle)
				IF USED('tmpFormCaptions')
					ThisForm.lblSz1.Caption		= RTRIM(tmpFormCaptions.txt1)
					ThisForm.lblSz2.Caption 	= RTRIM(tmpFormCaptions.txt2)
					ThisForm.lblSz2.Visible 	= tmpFormCaptions.lblSz2Vis
					ThisForm.lblSz3.Caption 	= RTRIM(tmpFormCaptions.txt3)
					ThisForm.lblSz3.Visible 	= tmpFormCaptions.lblSz3Vis
					ThisForm.Dim31.Visible 		= tmpFormCaptions.use3rdDim
					ThisForm.lblSz3.Enabled 	= tmpFormCaptions.Sz3Enable
					ThisForm.lblSz4.Caption		= RTRIM(tmpFormCaptions.txt4)
					ThisForm.lblSz4.Visible 	= tmpFormCaptions.lblSz4Vis
		
					USE IN tmpFormCaptions
				ELSE
					TrackMess( "tmpFormCaptions is not used!"+" EnterOrder.RefreshPOscreen()")
				ENDIF
			ELSE
				TrackMess("GetFormCaptions returned False!"+" EnterOrder.RefreshPOscreen()")
			ENDIF
			IF NOT EMPTY(lCurrentTable)
				IF USED(lCurrentTable)
					SELECT (lCurrentTable)
				ENDIF
			ENDIF
			
			This.lblFormDescription.Caption = FormDescription(cForm)
		ENDIF
		
		
		********
		IF NOT EMPTY(cAlias)
			IF USED(cAlias)
				SELECT (cAlias)
			ENDIF
		ENDIF
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE getbrkweight
		*ThisForm.GetBrkWeight()
		PRIVATE nPieces, cAlloy, cForm, nThickness, nSize2, nSize3
		PRIVATE nCalcWeight
		
		nPieces		= ThisForm.BrkPC1.Value
		cAlloy	= ''
		cForm	= ''
		nThickness	= ThisForm.BrkDIM11.Value
		nSize2		= ThisForm.BrkDIM21.Value
		nSize3		= ThisForm.BrkDIM31.Value
		
		
		IF NOT EMPTY(nThickness) AND NOT EMPTY(nSize2) AND NOT EMPTY(THISFORM.ID)
			*Get Form and Alloy
			PRIVATE cSQL, nSQLEXEC, cAlias
		
			DO CASE
			CASE ThisForm.cTBL	= "S" 
				cSQL = "SELECT Form, Alloy FROM dbo.StockLst_Master WHERE ID = "+ STR(THISFORM.ID)
			CASE ThisForm.cTBL	= "B" 
				cSQL = "SELECT Form, Alloy FROM dbo.BrokerLst_Master WHERE ID = "+ STR(THISFORM.ID)
			CASE ThisForm.cTBL	= "W" 
				cSQL = "SELECT Form, Alloy FROM dbo.WIPLst_Master WHERE ID = "+ STR(THISFORM.ID)
			ENDCASE	
			
			cAlias = ALIAS()
			IF USED("tmpStockLst")
				SELECT tmpStockLst
			ELSE 
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Process,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst')
			ELSE
				IF USED("tmpStockLst")
					cAlloy	= tmpStockLst.Alloy
					cForm	= tmpStockLst.Form
					USE IN tmpStockLst
				ENDIF
			ENDIF
			IF NOT EMPTY(cAlias)
				IF USED(cAlias)
					SELECT (cAlias)
				ENDIF
			ENDIF
			
		ENDIF
		
		
		IF NOT EMPTY(cAlloy) AND NOT EMPTY(cForm)
			IF EMPTY(nPieces)
				nPieces = 1
			ENDIF
			nCalcWeight = CalcWeight(nPieces, cAlloy, cForm, nThickness, nSize2, nSize3, ThisForm.nConnHandle )
			ThisForm.lblCalcWeight.Caption = "Est "+ALLTRIM(STR(nCalcWeight ))+" Lbs"
		ELSE
			ThisForm.lblCalcWeight.Caption = ''
		ENDIF
		
		IF NOT EMPTY(cForm)
			PRIVATE cPrice, nFT, nUnit
			cPrice = ''
			nFt = 0
			nUnit = 0
			
			cPrice = FormUnitPrice( cForm, ThisForm.nConnHandle )
			IF cPrice = "PC"
				IF nPieces > 0
					ThisForm.BrkWEIGHT1.Value = nPieces
					ThisForm.BrkWEIGHT1.Refresh
				ENDIF
			ENDIF
			IF cPrice = "FT"
				IF nPieces > 0
					IF nSize3 > 0
						ThisForm.BrkWEIGHT1.Value = ROUND(nPieces * nSize3 / 12,0)
						ThisForm.BrkWEIGHT1.Refresh
					ENDIF
				ENDIF
			ENDIF
		
			IF cPrice = "LB"
				IF nPieces > 0
			*		ThisForm.Pounds1.Value = nCalcWeight 
			*		ThisForm.Pounds1.Refresh
				ENDIF
			ENDIF
		ENDIF
		
		
		
	ENDPROC

