		ThisForm.Release
	ENDPROC

	PROCEDURE cmdBrkSave.Click
		PRIVATE cSQL, nSQLEXEC, lOK, cSQLi
		lOK = .T.
		
		******************************
		PRIVATE m.lnID, m.lnPC, m.lnSize_H, m.lnDim1, m.lnSize_L, m.lnDim2, m.lnDim3
		PRIVATE m.lnWeight, m.lcDescript, m.lcLength, m.lnCostValue, m.lnInvoiceValue, m.lnS_P, m.lnS_QTY
		PRIVATE m.lcFloorStatus, m.lcClass, m.lcLocation
		PRIVATE m.lnRandLen, m.llRandLen, m.lnPrime, m.llPrime
		PRIVATE m.nReceivingID, m.llMarkInvCheck, llMarkInvMiss, llQuarantine
		
		m.lnID			= PrepareSQLnum(THISFORM.ID,'ID',-3)
		m.lnPC			= PrepareSQLnum(ThisForm.PC1.Value,'PC',-3)	
		m.lnSize_H		= PrepareSQLnum(ThisForm.Size_H1.Value,'Size_H',9,4)
		m.lnDim1		= PrepareSQLnum(ThisForm.Dim11.Value,'Dim1',18,4)
		m.lnSize_L		= PrepareSQLnum(ThisForm.Size_L1.Value,'Size_L',9,4)
		m.lnDim2		= PrepareSQLnum(ThisForm.Dim21.Value,'Dim2',18,4)
		m.lnDim3		= PrepareSQLnum(ThisForm.Dim31.Value,'Dim3',18,4)
		m.lnS_QTY		= PrepareSQLnum(ThisForm.S_QTY.Value,'S_QTY',18,4)
		m.lnWeight		= PrepareSQLnum(ThisForm.Pounds1.Value,'Weight',9,1)
		m.lcDescript	= PrepareSQLtxt(ThisForm.Descript1.Value,'Descript',20)
		m.lcLength		= PrepareSQLtxt(ThisForm.Length1.Value,'Length1',160)
		m.lnCostValue	= PrepareSQLnum(ThisForm.CostValue1.Value,'CostValue',18,4)
		m.lnS_P			= PrepareSQLnum(ThisForm.S_P.Value,'S_P',18,4)
		m.lnInvoiceValue= PrepareSQLnum(ThisForm.InvoiceValue1.Value,'InvoiceValue',18,4)
		m.lcFloorStatus	= PrepareSQLtxt(ThisForm.FloorStatus1.Value,'FloorStatus',1)
		m.lcClass		= PrepareSQLtxt(ThisForm.Class1.Value,'Class',1)
		m.lcLocation	= PrepareSQLtxt(ThisForm.cmbLocation1.Value,'Location',10)
		m.llRandLen		= PrepareSQLchk(ThisForm.chkRandLen.Value,'RandLen',.F.)
		m.llPrime		= PrepareSQLchk(ThisForm.chkPrime.Value,'Prime',.F.)
		m.nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		*ThisForm.InvCheck1.Value	= IIF(ISNULL(tmpStockLst_Detail.InvCheck),CTOD(''),TTOD(tmpStockLst_Detail.InvCheck))
		m.llMarkInvCheck	= PrepareSQLchk(ThisForm.chkMarkInvCheck.Value,'MarkInvCheck',.F.)
		m.llMarkInvMiss		= PrepareSQLchk(ThisForm.chkMarkInvMiss.Value,'MarkInvMiss',.F.)
		llQuarantine		= PrepareSQLchk(ThisForm.chkQuarantine.Value,'Quarantine',.F.)
		
		******************************
		**Check data
		Private cMess
		cMess = ""
		PRIVATE lOKtoSave
		lOKtoSave = .T.
		*!*	**Check Data
		
		PRIVATE cForm
		cForm = getFormbyMasterID( ThisForm.ID, ThisForm.txtLst.Value, ThisForm.nConnHandle)
				
		IF m.lnID < 1
			cMess = cMess + "No Master ID!, Cannot Save!"+CHR(13)
		ENDIF
		
		IF VARTYPE(lnCostValue) = "Y"
			lnCostValue = MTON(lnCostValue)
		ENDIF
		IF VARTYPE(lnInvoiceValue) = "Y"
			lnInvoiceValue = MTON(lnInvoiceValue)
		ENDIF
		
		PRIVATE nPUnit 
		*nPUnit = PrepareSQLnum(m.lcUnit,'Unit',-1)
		*GetPUfromForm
		
		PRIVATE m.lnS_Total, cUnit4, lnS_PU 
		m.lnS_Total = m.lnS_QTY * m.lnS_P	
		
		cUnit4 = getPricingUnitbyID(m.lnID, ThisForm.cTBL, ThisForm.nConnHandle)
		IF LEN(cUnit4)>0
			cUnit4 = ""	&&GetUNITfromFORM(cForm, nConn)
		ENDIF
		m.lnS_PU = Get_nPU_from_cUnit(cUnit4)
		
		*Check Weight
		PRIVATE nCalcWeight, cItemDescript 
		nCalcWeight = 0
		nCalcWeight = CalcDetailPricingUnits(m.lnID,ThisForm.cTBL,m.lnPC,m.lnDim1,m.lnDim2,m.lnDim3,ThisForm.nConnHandle)
		cItemDescript = ItemDescription(cForm, m.lnDim1, m.lnDim2, m.lnDim3, m.lnS_QTY, m.llRandLen) &&Proc_Quotes    &&get_Description("SOitem")
		** m.lnDim1, m.lnDim2, m.lnDim3 ,m.lnS_QTY, m.lnWeight
		cMess = cMess+CHR(13)+cItemDescript +CHR(13)
		
		
		IF m.lnWeight <= 0
			IF nCalcWeight < 2
				 m.lnWeight = nCalcWeight 
			ELSE
				cMess = cMess +"Calculated 'Pricing Units' for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1))+CHR(13)
				cMess = cMess +"You cannot save with a Weight/Pricing Unit of 0."+CHR(13)
				lOKtoSave = .F.
			ENDIF
		ELSE
			DO CASE
			CASE lnWeight > nCalcWeight*1.3
				IF m.llRandLen AND ThisForm.chkRandLen.Caption = 'With Skeleton'
					*ITs OK to be over with a Skeleton rem			
				ELSE
					IF VAL(cForm) >= 80
						cMess = "Calculated 'Pricing Units' for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1))+CHR(13)
						cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
						cMess = cMess +"This form is allowed to be SAVED!"+CHR(13)
						*lOKtoSave = .T.
					ELSE
						cMess = "Calculated 'Pricing Units' for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1))+CHR(13)
						cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
						cMess = cMess +"is more than 30% off! You NOT be allowed to SAVE!"+CHR(13)
						IF ThisForm.chkRandLen.Caption = 'With Skeleton'
							cMess = cMess +"You may need to Enable 'With Skeleton'!"+CHR(13)
						ENDIF
						*lOKtoSave = .F.
					ENDIF
				ENDIF
			CASE nCalcWeight > lnWeight*1.3
				cMess = "Calculated 'Pricing Units' for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1))+CHR(13)
				cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
				cMess = cMess +"is more than 30% less than Calculated!"+CHR(13)+"You NOT be allowed to SAVE!"+CHR(13)
				lOKtoSave = .F.
			CASE lnWeight > nCalcWeight*1.1 
				IF m.llRandLen AND ThisForm.chkRandLen.Caption = 'With Skeleton'
					*ITs OK to be over with a Skeleton rem			
					*lOKtoSave = .T.
				ELSE
					IF VAL(cForm) >= 80
						cMess = "Calculated 'Pricing Units' for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1))+CHR(13)
						cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
						cMess = cMess +"is more than 10% off!"+CHR(13)
						cMess = cMess +"This form is allowed to be SAVED!"+CHR(13)
					*	lOKtoSave = .T.
					ELSE
						cMess = "Calculated 'Pricing Units' for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1))+CHR(13)
						cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
						cMess = cMess +"is more than 10% off!"+CHR(13)
						IF ThisForm.chkRandLen.Caption = 'With Skeleton'
							cMess = cMess +"You may need to Enable 'With Skeleton'!"+CHR(13)
						ENDIF
					*	lOKtoSave = .T.
					ENDIF
				ENDIF
			CASE nCalcWeight > lnWeight*1.1
					cMess = "Calculated 'Pricing Units' for this Detail item is "+ALLTRIM(STR(nCalcWeight,10,1))+CHR(13)
					cMess = cMess +"Your entered Weight/Pricing Unit of "+ALLTRIM(STR(lnWeight,10,1))+""+CHR(13)
					cMess = cMess +"is more than 10% less than Calculated!"+CHR(13)
					*lOKtoSave = .T.
			ENDCASE
		ENDIF
		
		******************************************
		*End of Data Check
		******************************************
		
		IF lOKtoSave
			IF NOT EMPTY( cMess )
				IF MESSAGEBOX( cMess+CHR(13)+"Do you still want to save?",4,"Data has been changed.") != 6
					TrackError(cMess,"End of Data Check", PROGRAM(), LINENO(1))
					RETURN -1
				ENDIF
			ENDIF
		ELSE
			MESSAGEBOX( cMess, 64 ,"BKR Cannot Save!") 
			TrackError(cMess,"End of Data Check", PROGRAM(), LINENO(1))
			RETURN -1
		ENDIF
		
		*******************
		IF m.lnID = 0
			MESSAGEBOX("Master ID is 0"+CHR(13)+"Something has gone wrong."+CHR(13)+"This Detail with no Master will not be able to be saved!",0+16,"Error -Abort")
			TrackError(cMess,"End of Data Check, Something has gone wrong", PROGRAM(), LINENO(1))
			RETURN -1
		ENDIF
		*******************
		
		PRIVATE nACreturn 
		nACreturn = -1
		
		IF m.lnCostValue > 0 AND ThisForm.cTBL = "S"
			nACreturn = AccountingCosting( THISFORM.ID, ThisForm.ID_Detail, '', ThisForm.nConnHandle )
			*AccountingCosting(pID, pID_Detail, pSOitem, pConn)
			DO CASE
			CASE nACreturn = -4
				*No ID_Detail
			CASE nACreturn = -3
				MESSAGEBOX("Dimensions are not entered properly."+CHR(13)+"Is 'Length' being used instead of 'Dim2'?",0,"'AccountingCosting' returned Error")
			CASE nACreturn = -2
				MESSAGEBOX("Could not find Alloy or Form in Master.",0,"'AccountingCosting' returned Error")
			CASE nACreturn = -1
				MESSAGEBOX("No ID_Detail.",0,"'AccountingCosting' returned Error")
			CASE nACreturn = 0
				*Zero Cost
				m.lnCostValue = 0
				WAIT WINDOW "This drop confirms to the 'Zero out Cost' rules." NOWAIT
			CASE nACreturn = 1
				*Keep sames Cost
			CASE nACreturn < -4
				*Error
				MESSAGEBOX("Error: "+STR(nACreturn),0,"'AccountingCosting' returned Error")
			ENDCASE
		ENDIF
		
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		
		PRIVATE m.ID_Detail_Process
		m.ID_Detail_Process = ThisForm.GetID_Detail_Process(m.lnID)
		
		
		**********************
		
		IF ThisForm.Lst = "StockLst"
			cSQL = "UPDATE dbo.StockLst_Detail SET "
		ELSE
			cSQL = "UPDATE dbo.BrokerLst_Detail SET "
		ENDIF
		cSQL = cSQL+ "ID="+STR(m.lnID)+""
		cSQL = cSQL+ ",PC="+STR(IIF(ISNULL(m.lnPC),0,m.lnPC))+""
		cSQL = cSQL+ ",Size_H="+STR(IIF(ISNULL(m.lnSize_H),0,m.lnSize_H),9,4)+""
		cSQL = cSQL+ ",Dim1="+STR(IIF(ISNULL(m.lnDim1),0,m.lnDim1),18,4)+""
		cSQL = cSQL+ ",Size_L="+STR(IIF(ISNULL(m.lnSize_L),0,m.lnSize_L),9,4)+""
		cSQL = cSQL+ ",Dim2="+STR(IIF(ISNULL(m.lnDim2),0,m.lnDim2),18,4)+""
		cSQL = cSQL+ ",Dim3="+STR(IIF(ISNULL(m.lnDim3),0,m.lnDim3),18,4)+""
		cSQL = cSQL+ ",Weight="+STR(IIF(ISNULL(m.lnWeight),0,m.lnWeight),18,4)+""
		cSQL = cSQL+ ",Descript='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcDescript),"",m.lcDescript),"'","''"))+"'"
		cSQL = cSQL+ ",Length='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcLength),"",m.lcLength),"'","''"))+"'"
		cSQL = cSQL+ ",CostValue="+STR(IIF(ISNULL(m.lnCostValue),0,m.lnCostValue),18,4)+""
		cSQL = cSQL+ ",InvoiceValue="+STR(IIF(ISNULL(m.lnInvoiceValue),0,m.lnInvoiceValue),18,4)+""
		*cSQL = cSQL+ ",Unit='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcUnit),"",m.lcUnit),"'","''"))+"'"
		cSQL = cSQL+ ",FloorStatus='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcFloorStatus),"",m.lcFloorStatus),"'","''"))+"'"
		cSQL = cSQL+ ",class='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcClass),"",m.lcClass),"'","''"))+"'"
		cSQL = cSQL+ ",[Location]='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcLocation),"",m.lcLocation),"'","''"))+"'"
		cSQL = cSQL+ ",RandLen="+IIF(m.llRandLen,'1','0')+""	&&BIT
		IF m.llMarkInvMiss
			cSQL = cSQL+ ",InvCheck=''"
		ELSE
			IF m.llMarkInvCheck
				cSQL = cSQL+ ",InvCheck=GETDATE()"
			ENDIF
		ENDIF
		IF nReceivingID > 0
			cSQL = cSQL+ ",ReceivingID="+STR(nReceivingID)+""	
		ENDIF
		cSQL = cSQL+ ",Quarantine="+IIF(llQuarantine,'1','0')+""
		cSQL = cSQL+ ",S_QTY="+STR(IIF(ISNULL(m.lnS_QTY),0,m.lnS_QTY),18,4)+""
		cSQL = cSQL+ ",S_P="+STR(IIF(ISNULL(m.lnS_P),0,m.lnS_P),18,4)+""
		cSQL = cSQL+ ",S_Total="+STR(IIF(ISNULL(m.lnS_Total),0,m.lnS_Total),18,4)+""
		cSQL = cSQL+ ",S_PU="+STR( IIF(ISNULL(m.lnS_PU),0,m.lnS_PU) )+""
		cSQL = cSQL+ ",Prime="+IIF(m.llPrime,'1','0')+""	&&BIT
		
		
		cSQL  = cSQL+ " WHERE ID_Detail="+STR(THISFORM.ID_Detail)
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
			lOK = .F.
		ELSE
			*=SQLCOMMIT(ThisForm.nConnHandle)
		ENDIF
		
		****************
		PRIVATE m.lnBrkPC, m.lnBrkSize_H, m.lnBrkDim1, m.lnBrkSize_L, m.lnBrkDim2, m.lnBrkDim3
		PRIVATE m.lnBrkWeight, m.lcDescript
		PRIVATE m.lnBrkRandLen, m.llBrkRandLen
		PRIVATE m.lnBrkPrime, m.llBrkPrime
		
		m.lnBrkPC		= PrepareSQLnum(ThisForm.BrkPC1.Value,'PC',-3)	
		m.lnBrkSize_H	= PrepareSQLnum(ThisForm.BrkSize_H1.Value,'Size_H',9,4)
		m.lnBrkDim1		= PrepareSQLnum(ThisForm.BrkDim11.Value,'Dim1',18,4)
		m.lnBrkSize_L	= PrepareSQLnum(ThisForm.BrkSize_L1.Value,'Size_L',9,4)
		m.lnBrkDim2		= PrepareSQLnum(ThisForm.BrkDim21.Value,'Dim2',18,4)
		m.lnBrkDim3		= PrepareSQLnum(ThisForm.BrkDim31.Value,'Dim3',18,4)
		m.lnBrkWeight	= PrepareSQLnum(ThisForm.BrkWeight1.Value,'Weight',18,4)
		m.lcBrkDescript	= PrepareSQLtxt(ThisForm.BrkDescript1.Value,'Descript',20)
		m.llBrkRandLen	= PrepareSQLchk(ThisForm.BrkchkRandLen.Value,'RandLen',.F.)
		m.llBrkPrime	= PrepareSQLchk(ThisForm.BrkchkPrime.Value,'Prime',.F.)
		****************
		
		IF USED("StockLst_Detail_ins")
			USE IN StockLst_Detail_ins
		ENDIF
		SELECT 0
		
		IF ThisForm.Lst = "StockLst"
			cSQLi = "EXEC dbo.p_StockLst_Detail_insRid4 "
		ELSE
			cSQLi = "EXEC dbo.p_BrokerLst_Detail_insRid4 "
		ENDIF
		cSQLi = cSQLi+ " @size_h	= "+STR(IIF(ISNULL(m.lnBrkSize_H),0,m.lnBrkSize_H),9,4)	&&decimal(9, 4),
		cSQLi = cSQLi+ ",@size_l = "+STR(IIF(ISNULL(m.lnBrkSize_L),0,m.lnBrkSize_L),9,4)	&&decimal(9, 4),
		cSQLi = cSQLi+ ",@pc = "+STR(IIF(ISNULL(m.lnBrkPC),0,m.lnBrkPC))					&&INT
		cSQLi = cSQLi+ ",@dim1 = "+STR(IIF(ISNULL(m.lnBrkDim1),0,m.lnBrkDim1),18,4)		&&decimal(18, 4),
		cSQLi = cSQLi+ ",@dim2 = "+STR(IIF(ISNULL(m.lnBrkDim2),0,m.lnBrkDim2),18,4)		&&decimal(18, 4),
		cSQLi = cSQLi+ ",@dim3 = "+STR(IIF(ISNULL(m.lnBrkDim3),0,m.lnBrkDim3),18,4)		&&decimal(18, 4),
		cSQLi = cSQLi+ ",@length =''"	&&varchar(160),
		cSQLi = cSQLi+ ",@weight = "+STR(IIF(ISNULL(m.lnBrkWeight),0,m.lnBrkWeight),18,4)		&&decimal(18,8),
		cSQLi = cSQLi+ ",@costvalue	= "+STR(IIF(ISNULL(m.lnCostValue),0,m.lnCostValue),9,4)	&&money
		cSQLi = cSQLi+ ",@descript =''"	&&varchar(20),
		cSQLi = cSQLi+ ",@location ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcLocation)," ",m.lcLocation),"'","''"))+"'"	&&varchar(10),
		cSQLi = cSQLi+ ",@floorstatus ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcFloorStatus)," ",m.lcFloorStatus),"'","''"))+"'"	&&char(1),
		cSQLi = cSQLi+ ",@class	 ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcClass)," ",m.lcClass),"'","''"))+"'"		&&char(1),
		cSQLi = cSQLi+ ",@RandLen = "+(IIF(m.llBrkRandLen,'1','0'))+""	&&BIT
		*cSQLi = cSQLi+ ",@Prime = "+(IIF(m.llBrkPrime,'1','0'))+""	&&BIT  Not in Procedure!
		cSQLi = cSQLi+ ",@id ="+STR(m.lnID)		&&int
		cSQLi = cSQLi+ ",@ID_Detail_Process ="+STR(m.ID_Detail_Process)		&&int
		cSQLi = cSQLi+ ",@ReceivingID ="+STR(nReceivingID)		&&int
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins')
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "StockLst_Detail_ins")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "StockLst_Detail_ins")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_ins')
			=SQLROLLBACK(ThisForm.nConnHandle)
			lOK = .F.
		ELSE
			THISFORM.ID_Detail = StockLst_Detail_ins.exp
					
			=SQLCOMMIT(ThisForm.nConnHandle)	
			IF USED("StockLst_Detail_ins")
				USE IN StockLst_Detail_ins
			ENDIF
			*ThisForm.RefreshStockLst()
			*ADD Receive Process to History
		*	ThisForm.ProcessAddReceive(m.lnBrkWeight, m.lnBrkPC)
			
		ENDIF
		
		**********
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		
		IF lOK 
			ThisForm.RELEASE 
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSave.Click
		PRIVATE cSQL, nSQLEXEC, lOK, cSQLi, lRollBack
		lOK = .T.
		lRollBack = .F.
		
		lOK = ThisForm.CheckData()
		
		IF NOT lOK
			RETURN .F.
		ENDIF
		
		******************************
		PRIVATE m.lnID, m.lnID_Detail, m.lnPC, m.lnSize_H, m.lnDim1, m.lnSize_L, m.lnDim2, m.lnDim3
		PRIVATE m.lnWeight, m.lcDescript, m.lcLength, m.lnCostValue, m.lnInvoiceValue
		PRIVATE m.lcFloorStatus, m.lcClass, m.lcLocation
		PRIVATE m.lnRandLen, m.llRandLen, m.lnPrime, m.llPrime
		PRIVATE m.nReceivingID, m.llMarkInvCheck, llMarkInvMiss, llQuarantine
		PRIVATE m.S_QTY, m.S_P, m.S_Total, m.S_PU
		
		m.lnID			= PrepareSQLnum(ThisForm.ID,'ID',-3)
		m.lnID_Detail	= PrepareSQLnum(ThisForm.ID_Detail1.Value,'ID_Detail',-3)
		m.lnPC			= PrepareSQLnum(ThisForm.PC1.Value,'PC',-3)	
		m.lnSize_H		= PrepareSQLnum(ThisForm.Size_H1.Value,'Size_H',9,4)
		m.lnDim1		= PrepareSQLnum(ThisForm.Dim11.Value,'Dim1',18,4)
		m.lnSize_L		= PrepareSQLnum(ThisForm.Size_L1.Value,'Size_L',9,4)
		m.lnDim2		= PrepareSQLnum(ThisForm.Dim21.Value,'Dim2',18,4)
		m.lnDim3		= PrepareSQLnum(ThisForm.Dim31.Value,'Dim3',18,4)
		m.lnWeight		= PrepareSQLnum(ThisForm.Pounds1.Value,'Pounds',18,4)
		m.lcDescript	= PrepareSQLtxt(ThisForm.Descript1.Value,'Descript',20)
		m.lcLength		= PrepareSQLtxt(ThisForm.Length1.Value,'Length1',160)
		m.lnCostValue	= PrepareSQLnum(ThisForm.CostValue1.Value,'CostValue',-5)
		m.S_P			= PrepareSQLnum(ThisForm.S_P.Value,'S_P',18,4)
		m.lnInvoiceValue= PrepareSQLnum(ThisForm.InvoiceValue1.Value,'InvoiceValue',-5)
		*!*	IF VARTYPE(lnCostValue) = "Y"
		*!*		lnCostValue = MTON(lnCostValue)
		*!*	ENDIF
		*!*	IF VARTYPE(lnInvoiceValue) = "Y"
		*!*		lnInvoiceValue = MTON(lnInvoiceValue)
		*!*	ENDIF
		m.lcFloorStatus	= PrepareSQLtxt(ThisForm.FloorStatus1.Value,'FloorStatus',1)
		m.lcClass		= PrepareSQLtxt(ThisForm.Class1.Value,'Class',1)
		m.lcLocation	= PrepareSQLtxt(ThisForm.cmbLocation1.Value,'Location',10)
		m.llRandLen		= PrepareSQLchk(ThisForm.chkRandLen.Value,'RandLen',.F.)
		m.llPrime		= PrepareSQLchk(ThisForm.chkPrime.Value,'Prime',.F.)
		m.nReceivingID	= PrepareSQLnum(ThisForm.txtReceivingID.Value,'ReceivingID',-3)
		*ThisForm.InvCheck1.Value	= IIF(ISNULL(tmpStockLst_Detail.InvCheck),CTOD(''),TTOD(tmpStockLst_Detail.InvCheck))
		m.llMarkInvCheck	= PrepareSQLchk(ThisForm.chkMarkInvCheck.Value,'MarkInvCheck',.F.)
		m.llMarkInvMiss		= PrepareSQLchk(ThisForm.chkMarkInvMiss.Value,'MarkInvMiss',.F.)
		llQuarantine		= PrepareSQLchk(ThisForm.chkQuarantine.Value,'Quarantine',.F.)
		
		m.S_QTY			= PrepareSQLnum(ThisForm.S_QTY.Value,'S_QTY',18,4)
		
		m.S_Total		= m.S_QTY * m.S_P
		PRIVATE cForm
		cForm = getFormbyMasterID( ThisForm.ID, ThisForm.txtLst.Value, ThisForm.nConnHandle)
		m.S_PU	= GetPUfromForm(cForm, ThisForm.nConnHandle)
		*m.S_PU = getPricingUnitbyID(m.lnID,cTBL,ThisForm.nConnHandle)
		
		**********************************
		IF m.lnID < 1
			*cMess = cMess + "No Master ID!, Cannot Save!"+CHR(13)
			RETURN .F.
		ENDIF
		
		
		*******************
		
		ThisForm.nConnHandle = CheckSQLConnection(ThisForm.nConnHandle)
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 2)  && 1Auto 2Manual transactions
		
		PRIVATE m.ID_Detail_Process
		m.ID_Detail_Process = ThisForm.GetID_Detail_Process(m.lnID)
		
		DO CASE 
		CASE THISFORM.WhatDo = "ADD" OR THISFORM.WhatDo = "CLONE"
			IF m.llMarkInvMiss
				MESSAGEBOX("Since you are adding this, the 'Inventory Check Date' will be recorded as today."+CHR(13)+"Please edit this detail if this item you just added to the inventory, actually does not exist and edit/set to 'Not Found'!",0+48,"Saving as 'Stock Found', Edit again to set as 'Not Found'!")
			ENDIF
			
			IF USED("StockLst_Detail_ins")
				USE IN StockLst_Detail_ins
			ENDIF
			SELECT 0
			
			IF ThisForm.Lst = "StockLst"
				cSQLi = "EXEC dbo.p_StockLst_Detail_insRid5 "
			ELSE
				cSQLi = "EXEC dbo.p_BrokerLst_Detail_insRid5 "
			ENDIF
			cSQLi = cSQLi+ " @size_h = "+STR(IIF(ISNULL(m.lnSize_H),0,m.lnSize_H),9,4)	&&decimal(9, 4),
			cSQLi = cSQLi+ ",@size_l = "+STR(IIF(ISNULL(m.lnSize_L),0,m.lnSize_L),9,4)	&&decimal(9, 4),
			cSQLi = cSQLi+ ",@pc = "+STR(IIF(ISNULL(m.lnPC),0,m.lnPC))					&&INT
			cSQLi = cSQLi+ ",@dim1 = "+STR(IIF(ISNULL(m.lnDim1),0,m.lnDim1),18,4)		&&decimal(18, 4),
			cSQLi = cSQLi+ ",@dim2 = "+STR(IIF(ISNULL(m.lnDim2),0,m.lnDim2),18,4)		&&decimal(18, 4),
			cSQLi = cSQLi+ ",@dim3 = "+STR(IIF(ISNULL(m.lnDim3),0,m.lnDim3),18,4)		&&decimal(18, 4),
			cSQLi = cSQLi+ ",@length ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcLength)," ",m.lcLength),"'","''"))+"'"		&&varchar(160),
			cSQLi = cSQLi+ ",@weight = "+STR(IIF(ISNULL(m.lnWeight),0,m.lnWeight),18,4)		&&decimal(18,8),
			cSQLi = cSQLi+ ",@costvalue	= "+STR(IIF(ISNULL(m.lnCostValue),0,m.lnCostValue),9,4)	&&money
			cSQLi = cSQLi+ ",@descript ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcDescript)," ",m.lcDescript),"'","''"))+"'"	&&varchar(20),
			cSQLi = cSQLi+ ",@location ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcLocation)," ",m.lcLocation),"'","''"))+"'"	&&varchar(10),
			cSQLi = cSQLi+ ",@floorstatus ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcFloorStatus)," ",m.lcFloorStatus),"'","''"))+"'"	&&char(1),
			cSQLi = cSQLi+ ",@class	 ='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcClass)," ",m.lcClass),"'","''"))+"'"		&&char(1),
			cSQLi = cSQLi+ ",@RandLen = "+(IIF(m.llRandLen,'1','0'))+""	&&BIT
			cSQLi = cSQLi+ ",@ID ="+STR(m.lnID)		&&int
			cSQLi = cSQLi+ ",@ID_Detail_Process="+STR(m.ID_Detail_Process)		&&int
			cSQLi = cSQLi+ ",@ReceivingID ="+STR(nReceivingID)		&&int
			cSQLi = cSQLi+ ",@S_QTY="+STR(m.S_QTY,18,4)
			cSQLi = cSQLi+ ",@S_P="+STR(m.S_P,18,4)
			cSQLi = cSQLi+ ",@S_TOTAL="+STR(m.S_Total,18,4)
			cSQLi = cSQLi+ ",@S_PU="+STR(m.S_PU)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'StockLst_Detail_ins' )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "StockLst_Detail_ins")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "StockLst_Detail_ins")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'StockLst_Detail_ins')
				=SQLROLLBACK(ThisForm.nConnHandle)
				lOK = .F.
				lRollBack = .T.
			ELSE
				THISFORM.ID_Detail = PrepareSQLnum(StockLst_Detail_ins.exp,'ID_Detail',-3)
				ThisForm.ID_Detail1.Value	= ThisForm.ID_Detail
				
				*=SQLCOMMIT(ThisForm.nConnHandle)	
				IF USED("StockLst_Detail_ins")
					USE IN StockLst_Detail_ins
				ENDIF
				
				*ThisForm.RefreshStockLst()
				*ADD Receive Process to History
		
				PRIVATE pMessMemo
				pMessMemo = "This data is for test, Save Detail!."+CHR(13)
				
				IF THISFORM.WhatDo = "ADD" 
					pMessMemo = pMessMemo + "THISFORM.WhatDo = 'ADD'" + CHR(13)
				ENDIF
				IF THISFORM.WhatDo = "CLONE"
					pMessMemo = pMessMemo + "THISFORM.WhatDo = 'CLONE'" + CHR(13)
				ENDIF
				pMessMemo = pMessMemo + cSQLi + CHR(13)
		
				RecordTest('Record Test Data.', PROGRAM(), LINENO(1), pMessMemo)
				
				ThisForm.ProcessAddReceive(m.lnWeight, m.lnPC)
				
			ENDIF
			
		CASE THISFORM.WhatDo = "EDIT"
			IF ThisForm.Lst = "StockLst"
				cSQL = "UPDATE dbo.StockLst_Detail SET "
			ELSE
				cSQL = "UPDATE dbo.BrokerLst_Detail SET "
			ENDIF
			*cSQL = cSQL+ "ID="+STR(m.lnID)+","
			cSQL = cSQL+ "PC="+STR(IIF(ISNULL(m.lnPC),0,m.lnPC))+""
			cSQL = cSQL+ ",Size_H="+STR(IIF(ISNULL(m.lnSize_H),0,m.lnSize_H),9,4)+""
			cSQL = cSQL+ ",Dim1="+STR(IIF(ISNULL(m.lnDim1),0,m.lnDim1),18,4)+""
			cSQL = cSQL+ ",Size_L="+STR(IIF(ISNULL(m.lnSize_L),0,m.lnSize_L),9,4)+""
			cSQL = cSQL+ ",Dim2="+STR(IIF(ISNULL(m.lnDim2),0,m.lnDim2),18,4)+""
			cSQL = cSQL+ ",Dim3="+STR(IIF(ISNULL(m.lnDim3),0,m.lnDim3),18,4)+""
			cSQL = cSQL+ ",Weight="+STR(IIF(ISNULL(m.lnWeight),0,m.lnWeight),18,4)+""
			cSQL = cSQL+ ",Descript='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcDescript),"",m.lcDescript),"'","''"))+"'"
			cSQL = cSQL+ ",Length='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcLength),"",m.lcLength),"'","''"))+"'"
			cSQL = cSQL+ ",CostValue="+STR(IIF(ISNULL(m.lnCostValue),0,m.lnCostValue),18,4)+""
			cSQL = cSQL+ ",InvoiceValue="+STR(IIF(ISNULL(m.lnInvoiceValue),0,m.lnInvoiceValue),18,4)+""
		*	cSQL = cSQL+ ",Unit=''" Depricated
			cSQL = cSQL+ ",FloorStatus='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcFloorStatus),"",m.lcFloorStatus),"'","''"))+"'"
			cSQL = cSQL+ ",class='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcClass),"",m.lcClass),"'","''"))+"'"
			cSQL = cSQL+ ",Location='"+ALLTRIM(STRTRAN(IIF(ISNULL(m.lcLocation),"",m.lcLocation),"'","''"))+"'"
			cSQL = cSQL+ ",RandLen="+IIF(m.llRandLen,'1','0')+""	&&BIT
			IF m.llMarkInvMiss
				cSQL = cSQL+ ",InvCheck=''"
			ELSE
				IF m.llMarkInvCheck
					cSQL = cSQL+ ",InvCheck=GETDATE()"
				ENDIF
			ENDIF
			cSQL = cSQL+ ",ReceivingID="+STR(nReceivingID)+""	
			cSQL = cSQL+ ",Quarantine="+IIF(llQuarantine,'1','0')+""
			cSQL = cSQL+ ",S_QTY="+STR(m.S_QTY,18,4)
			cSQL = cSQL+ ",S_P="+STR(m.S_P,18,4)
			cSQL = cSQL+ ",S_TOTAL="+STR(m.S_Total,18,4)
			cSQL = cSQL+ ",S_PU="+STR(m.S_PU)
			cSQL = cSQL+ ",Prime="+IIF(m.llPrime,'1','0')+""	&&BIT
			cSQL = cSQL+ " WHERE ID_Detail="+STR(m.lnID_Detail)
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
			ENDDO
			IF nSQLEXEC < 0 &&Try again!1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
				lOK = .F.
				lRollBack = .T.
			ELSE
				RecordTest('Record Test Data.', PROGRAM(), LINENO(1),cSQL)
				*TRACKMESS(cSQL)
				*=SQLCOMMIT(ThisForm.nConnHandle)
			ENDIF
		CASE THISFORM.WhatDo = "VIEW"
		CASE THISFORM.WhatDo = "BREAK"
		ENDCASE
		
		**********************************
		IF lRollBack 
			=SQLROLLBACK(ThisForm.nConnHandle)
			lOK  = .F.
			MESSAGEBOX('Nothing has been saved!',0+16,"Rollback")
		ELSE
			=SQLCOMMIT(ThisForm.nConnHandle)
		ENDIF
		
		= SQLSETPROP(ThisForm.nConnHandle, 'Transactions', 1)  && 1Auto 2Manual transactions
		
		**********************************
		IF lOK 
			ThisForm.RELEASE 
		ENDIF
		
	ENDPROC

	PROCEDURE cmdSaveToStock.Click
		
		PRIVATE nID,nID_Detail, cTbl
		nID 		= ThisForm.ID1.Value
		nID_Detail	= ThisForm.ID_Detail1.Value
		cTbl 		= ThisForm.txtLst.Value
		
		PRIVATE nNewID_Master
		DO CASE
		CASE ThisForm.cTBL	= "B"
			nNewID_Master = Move_BrokerLst_StockLst( nID, nID_Detail, ThisForm.nConnHandle )
		CASE ThisForm.cTBL	= "W"
			nNewID_Master = Move_WIPLst_StockLst( nID, nID_Detail, ThisForm.nConnHandle )
		ENDCASE
		
		IF nNewID_Master  > 0
		
			*ThisForm.ID_Detail = Get_ID_by_ID_Detail( nNewID_Master, 'StockLst',ThisForm.nConnHandle )
			ThisForm.ID_Detail = getHighestID_DetailbyID( nNewID_Master, 'StockLst',ThisForm.nConnHandle )
			ThisForm.ID_Detail = ABS(ThisForm.ID_Detail)
			
			ThisForm.RELEASE
		ELSE
			TrackError("TBL "+cTBL+", ID="+ALLTRIM(STR(nID))+ ", ID_Detail= "+ALLTRIM(STR(nID_Detail))+"Move Failed to Stock Table","Move Failed!", PROGRAM(), LINENO(1))
			MESSAGEBOX("Move Failed!",0,"Error" )
		ENDIF
		
		
		
		
	ENDPROC

