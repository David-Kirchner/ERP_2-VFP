	PROCEDURE cmbLocation1.Init
		PRIVATE cSQL, nSQLEXEC, nLoopCount
		
		IF USED('StandLocation')
			SELECT StandLocation
		ELSE
			SELECT 0
		ENDIF
		
		this.clear
		cSQL="SELECT [Location], SUBSTRING(Description,1,20) AS DESCR FROM dbo.StockLst_Location "
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StandLocation')
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC( ThisForm.nConnHandle, cSQL, 'StandLocation')
		ENDDO
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StandLocation' )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'StandLocation' )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StandLocation")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "StandLocation")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQL,ThisForm.nConnHandle,nSQLEXEC, 'StandLocation')
			MESSAGEBOX("Could not save.",16,"Error")
		ENDIF
		
		DIMENSION aStandLocation(1,2)
		
		IF USED('StandLocation')
			SELECT Location, IIF(ISNULL(DESCR)," ",DESCR) FROM StandLocation INTO ARRAY aStandLocation
			
			USE IN StandLocation
		ENDIF
		
		*This.ColumnCount = ALEN(aFormCode,2)
		This.ColumnCount = 2
		This.NumberOfElements=ALEN(aStandLocation)
		This.BoundColumn = 1
		This.ColumnWidths = "80,115"
		
		
		PRIVATE nArrayCount
		nArrayCount = ALEN(aStandLocation,1)
		FOR I = 1 TO nArrayCount
			this.addListitem(aStandLocation(I, 1),I,1)
			this.addListitem(aStandLocation(I, 2),I,2)
		ENDFOR
	ENDPROC

