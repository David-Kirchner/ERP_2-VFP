		nSales_Detail_ID = 0
		cTBL = PrepareSQLtxt(ThisForm.txtLst.Value,'TBL',1,.F.,.T.)
		
		
		PRIVATE cPOitem
		cPOitem = get_POitem_StockLstID(nID,nSales_Detail_ID,cTBL,ThisForm.nConnHandle)
		
		IF Proper_PO_Item(cPOitem) != Proper_PO_Item("")
			
			ThisForm.AlwaysOnTop = .F.
			PRIVATE nLeft
			nLeft = ThisForm.Left
			IF nLeft > 200
				ThisForm.Left = 0
			ENDIF
			DO FORM Forms\ShowPO WITH cPOitem
			ThisForm.AlwaysOnTop = .T.
			IF nLeft > 200
				ThisForm.Left = nLeft
			ENDIF
		ELSE
			MESSAGEBOX("PO item not Found",0,"Cannot Show POitem")
		ENDIF
		
	ENDPROC

