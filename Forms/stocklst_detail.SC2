	PROCEDURE Location1.InteractiveChange
		PRIVATE lnInsertionPt, lcSearchStr, lcTryLocation 
		lnInsertionPt = THIS.SELSTART
		lcSearchStr = SUBSTR(THIS.VALUE,1,lnInsertionPt)
		lcTryLocation = ''
		
		IF !EMPTY(lcSearchStr)
			*Progs\Proc_SQL\SearchLocation() dbo.StockLst_Location
			lcTryLocation = SearchLocation(lcSearchStr, ThisForm.nConnHandle)
			IF NOT EMPTY(lcTryLocation)		
				IF UPPER(lcSearchStr) = SUBSTR(lcTryLocation,1,lnInsertionPt)
					THIS.VALUE=lcTryLocation
					THIS.FORECOLOR = RGB(0,0,0)
					
					ThisForm.txtCurrentLBS.Value = LBS_Location(lcSearchStr,ThisForm.nConnhandle)  
					ThisForm.txtMaxLbs.Value = MaxLBS_Location(lcSearchStr,ThisForm.nConnhandle) 
		
				ELSE
					THIS.VALUE=lcSearchStr
					THIS.FORECOLOR = RGB(255,0,0)
					
					ThisForm.txtCurrentLBS.Value = 0  
					ThisForm.txtMaxLbs.Value = 0
				ENDIF
			ELSE
		*		*No replacement
				THIS.VALUE=lcSearchStr
				THIS.FORECOLOR = RGB(255,0,0)
				
				*ThisForm.txtCurrentLBS.Value = 0  
				*ThisForm.txtMaxLbs.Value = 0
					
			ENDIF
		ELSE
			THIS.VALUE=SPACE(0)
		ENDIF
		THIS.SELSTART = lnInsertionPt
	ENDPROC

	PROCEDURE Location1.LostFocus
		=insmode(.T.)
	ENDPROC

	PROCEDURE Location1.Valid
		PRIVATE pCurLoc,cLocation
		pCurLoc = ALLTRIM(This.Value)
		
		IF NOT EMPTY(pCurLoc)
			cLocation = SearchLocation( pCurLoc, ThisForm.nConnHandle )
			
			IF NOT EMPTY(cLocation)
				This.Value = cLocation
				THIS.FORECOLOR = RGB(0,0,0)
				
				ThisForm.cmbLocation1.Value = cLocation
				ThisForm.cmbLocation1.Refresh
				RETURN .T.
			ELSE
				THIS.FORECOLOR = RGB(255,128,128)
				RETURN .F.
			ENDIF
			
		ENDIF
		
		
	ENDPROC

