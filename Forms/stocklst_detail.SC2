	PROCEDURE getid_detail_process
		PARAMETER pID
		*ThisForm.GetID_Detail_Process(m.lnID)
		
		PRIVATE cSQLi, nSQLEXEC, lOK
		lOK = .T.
		PRIVATE m.cPO_Item
		PRIVATE m.cSalesPerson
		PRIVATE m.dtStartDate
		PRIVATE	m.dDueDate
		PRIVATE m.nAllowSub
		Private m.nWeight
		PRIVATE m.nPC
		PRIVATE m.nQTY
		PRIVATE m.cSOitem
		PRIVATE m.cProcess_ID
		PRIVATE m.nProcessor
		PRIVATE m.cComment
		PRIVATE m.nID_Detail, m.nMasterID
		PRIVATE m.nID_Detail_Process
		
		m.cPO_Item		= ''
		m.cSalesPerson	= ''
		m.dtStartDate	= DATETIME()
		m.dDueDate		= DATE()
		m.nAllowSub		= 'N'
		m.nWeight		= PrepareSQLnum(ThisForm.Pounds1.Value,'Pounds',8,1)
		m.nPC			= PrepareSQLnum(ThisForm.PC1.Value,'PC',-3)
		m.nQTY			= PrepareSQLnum(ThisForm.S_QTY.Value,'S_QTY',-5)
		m.cSOitem		= ''
		m.cProcess_ID	= "RECEIVED"
		m.cProcessor	= ''
		m.cComment		= 'Added a Detail'
		
		IF ThisForm.ID_DETAIL1.Value > 0
			m.nID_Detail	= ThisForm.ID_DETAIL1.Value
			ThisForm.ID_DETAIL = ThisForm.ID_DETAIL1.Value
		ELSE
			m.nID_Detail	= 0
		ENDIF
		m.nID_Detail_Process = 0
		
		
		DO CASE
		CASE ThisForm.Lst= "StockLst"
			cTBL = "S"
		CASE ThisForm.Lst= "BrokerLst"
			cTBL = "B"
		CASE ThisForm.Lst= "WIPLst"
			cTBL = "W"
		ENDCASE
			
		PRIVATE cPrc_Form, nPrc_PCs, nPrc_Dim1, nPrc_Dim2, nPrc_Dim3
		cPrc_Form	= ''
		nPrc_PCs	= 0
		nPrc_Dim1	= 0
		nPrc_Dim2	= 0
		nPrc_Dim3	= 0
		
		IF m.nID_Detail > 0 AND THISFORM.WhatDo = "ADD"
			SELECT 0
			Get_Stock_Detail(cTBL,m.nID_Detail,ThisForm.nConnHandle)
			IF USED('tmpStock_Detail_Dim')
				cPrc_Form	= PrepareSQLtxt(tmpStock_Detail_Dim.Form,'Form',2)
				nPrc_PCs	= PrepareSQLnum(tmpStock_Detail_Dim.PC,'Pieces',-3)
				nPrc_Dim1	= PrepareSQLnum(tmpStock_Detail_Dim.Dim1,'Dim1',10,4)
				nPrc_Dim2	= PrepareSQLnum(tmpStock_Detail_Dim.Dim2,'Dim2',9,3)
				nPrc_Dim3	= PrepareSQLnum(tmpStock_Detail_Dim.Dim3,'Dim3',9,3)
		
				USE IN tmpStock_Detail_Dim
			ENDIF
		ENDIF
		
		IF LEN(cPrc_Form) = 0
			*get form from ID_Detail
			m.nMasterID = GetIDfromID_Detail( m.nID_Detail, cTBL, ThisForm.nConnHandle)
			cPrc_Form = getFormbyMasterID( m.nMasterID, cTBL, ThisForm.nConnHandle)
		ENDIF
		m.nPU = GetPUfromForm(cPrc_Form, ThisForm.nConnHandle)
		
		*************
		IF USED("tmpID_Detail_Process")
			USE IN tmpID_Detail_Process
		ELSE
			SELECT 0
		ENDIF
		
		IF THISFORM.WhatDo = "ADD"
		
		
			
		*	cSQLi = "EXEC dbo.p_Lst_Process_ins2 "
		*	cSQLi = cSQLi + " @TBL='"+cTBL+"'"
		*	cSQLi = cSQLi + ",@SOitem = '"+m.cSOitem+"'"
		*	cSQLi = cSQLi + ",@PO_Item = '"+m.cPO_Item+"'"
		*	cSQLi = cSQLi + ",@salesperson = '"+m.cSalesPerson+"'"
		*	cSQLi = cSQLi + ",@startdate = '"+IIF(EMPTY(m.dtStartDate),TTOC(DATETIME()),TTOC(m.dtStartDate))+"'"
		*	cSQLi = cSQLi + ",@duedate = '"+IIF(EMPTY(m.dDueDate),'',DTOC(m.dDueDate))+"'"
		*	cSQLi = cSQLi + ",@comment = '"+m.cComment+"'"
		*	cSQLi = cSQLi + ",@process_id = '"+m.cProcess_ID+"'"
		*	cSQLi = cSQLi + ",@processor = '"+m.cProcessor+"'"
		*	cSQLi = cSQLi + ",@AllowSub = '"+m.nAllowSub+"'"
		*	cSQLi = cSQLi + ",@PU=0"
		*	cSQLi = cSQLi + ",@QTY=0"
		*	cSQLi = cSQLi + ",@Pounds = "+STR(m.nWeight,18,4)
		*	cSQLi = cSQLi + ",@ID_Detail = "+STR(m.nID_Detail)+""
		*	cSQLi = cSQLi + ",@ReceivingID=0"	
		*	cSQLi = cSQLi + ",@WO = 0"
		*	cSQLi = cSQLi + ",@WO_Detail = 0"
			
		*************************************
			*Save NEW Process with Process_ID
		
			cSQLi = "EXEC dbo.p_Lst_Process_ins "
		
			cSQLi = cSQLi + " @TBL = '"+cTBL+"'"
			cSQLi = cSQLi + ",@ID_Detail = "+STR(m.nID_Detail)+""
			cSQLi = cSQLi + ",@SalesPerson = '"+m.cSalesPerson+"'"
			cSQLi = cSQLi + ",@StartDate = '"+IIF(EMPTY(m.dtStartDate),TTOC(DATETIME()),TTOC(m.dtStartDate))+"'"	
			cSQLi = cSQLi + ",@DueDate = '"+IIF(EMPTY(m.dDueDate),DTOC(DATE()),DTOC(m.dDueDate))+"'" 
			cSQLi = cSQLi + ",@AllowSub = '"+m.nAllowSub+"'"
			cSQLi = cSQLi + ",@PU	="+STR(m.nPU)
			cSQLi = cSQLi + ",@QTY	="+STR(m.nQTY,18,4)
			cSQLi = cSQLi + ",@Pounds ="+STR(m.nWeight,9,1)
		
			cSQLi = cSQLi + ",@SOitem = '"+m.cSOitem+"'"
			cSQLi = cSQLi + ",@PO_item = '"+m.cPO_Item+"'"
			cSQLi = cSQLi + ",@WO	= "+STR(0)+""
			cSQLi = cSQLi + ",@WO_Detail= "+STR(0)+""
		
			cSQLi = cSQLi + ",@Process_ID = '"+PrepareSQLtxt(m.cProcess_ID,'Process_ID',10)+"'"
			cSQLi = cSQLi + ",@Processor = '"+PrepareSQLtxt(m.cProcessor,'User',20)+"'"
			cSQLi = cSQLi + ",@Comment = '"+PrepareSQLtxt(m.cComment,'Comment',100)+"'"	
			cSQLi = cSQLi + ",@ReceivingID ="+STR(0)
			
			cSQLi = cSQLi + ",@Prc_Form = '"+cPrc_Form+"'"
			cSQLi = cSQLi + ",@Prc_PCs = "+STR(nPrc_PCs)
			cSQLi = cSQLi + ",@Prc_Dim1 = "+STR(nPrc_Dim1)
			cSQLi = cSQLi + ",@Prc_Dim2 = "+STR(nPrc_Dim2)
			cSQLi = cSQLi + ",@Prc_Dim3 = "+STR(nPrc_Dim3)
		
			cSQLi = cSQLi + ",@Ordered_QTY = "+STR(0)
			cSQLi = cSQLi + ",@Ordered_P = "+STR(0)
		
		
			
			SELECT 0
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "tmpID_Detail_Process")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLExecError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, 'tmpID_Detail_Process')
				TrackError("Could not EXEC dbo.p_Lst_Process_ins ","p_Lst_Process_ins ","StockLst_Detail.GetID_Detail_Process()",LINENO(1))
				MESSAGEBOX("Could not Save.",16,"Error")
			ELSE
				=SQLCOMMIT(ThisForm.nConnHandle)
				IF USED("tmpID_Detail_Process")
					m.nID_Detail_Process = tmpID_Detail_Process.exp		
					USE IN tmpID_Detail_Process
				ELSE
					m.nID_Detail_Process = 0
				ENDIF
				
				IF m.nID_Detail_Process  > 0
					*Adjust fields not in INSERT Proc 
					
		*!*				cSQL = "UPDATE "		
		*!*				DO CASE
		*!*				CASE cTBL = "S"
		*!*					cSQL = cSQL + " dbo.StockLst_Process "
		*!*				CASE cTBL = "B"
		*!*					cSQL = cSQL + " dbo.BrokerLst_Process "
		*!*				CASE cTBL = 'W'
		*!*					cSQL = cSQL + " dbo.WIPLst_Process "
		*!*				ENDCASE		
		*!*						
		*!*				cSQL = cSQL + " SET PU="+STR(nPU)
		*!*				cSQL = cSQL + ",QTY="+STR(nProcessQTY)
		*!*				cSQL = cSQL + ",Pounds="+STR(nPounds)
		*!*				cSQL = cSQL + ",ReceivingID=0"
		*!*				cSQL = cSQL + ",WO="+STR(nWO)
		
		*!*				cSQL = cSQL + " WHERE ID_Detail_Process ="+STR(m.nID_Detail_Process)
		*!*				
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, '')
		*!*				DO WHILE nSQLEXEC = 0
		*!*					WAIT WINDOW 'SQL' TIMEOUT 1
		*!*					nSQLEXEC = SQLEXEC(ThisForm.nConnhandle, cSQL, '')
		*!*				ENDDO
		*!*		IF nSQLEXEC < 0 &&Try again!
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		*!*			DO WHILE nSQLEXEC = 0
		*!*				WAIT WINDOW 'SQL 1' TIMEOUT 1
		*!*				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, 'tmpID_Detail_Process')
		*!*			ENDDO
		*!*		ENDIF
		*!*	IF nSQLEXEC < 0 &&Try again!
		*!*		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*		DO WHILE nSQLEXEC = 0
		*!*			WAIT WINDOW 'SQL 2' TIMEOUT 1
		*!*			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpID_Detail_Process")
		*!*			
		*!*			IF nSQLEXEC < 0
		*!*				IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
		*!*					nSQLEXEC = 0
		*!*				ENDIF
		*!*			ENDIF
		*!*		ENDDO
		*!*	ENDIF 
		*!*				IF nSQLEXEC < 0
		*!*					SQLEXECError(cSQL, ThisForm.nConnhandle, nSQLEXEC, '')
		*!*					lOK = .F.
		*!*				ENDIF
		
				ENDIF
			ENDIF
		ENDIF
		
		IF THISFORM.WhatDo = "EDIT" OR THISFORM.WhatDo = "BREAK"
			m.nID_Detail_Process = GET_ID_Detail_Process_with_ID_Detail_PO_SO(nID_Detail,ThisForm.Lst,cSOItem,cPO_item,ThisForm.nConnHandle)
			
			IF m.nID_Detail_Process > 0
				IF ThisForm.Lst = "StockLst"
					cSQL = "UPDATE dbo.StockLst_Process SET "
				ELSE
					cSQL = "UPDATE dbo.BrokerLst_Process SET "
				ENDIF
				cSQL = cSQL+ " SOitem=dbo.f_ProperSOitem('"+m.cSOitem+"')"
				cSQL = cSQL+ ",PO_item=dbo.f_ProperPOitem('"+m.cPO_Item+"')"
				cSQL = cSQL+ ",SalesPerson='"+m.cSalesPerson+"'"
				cSQL = cSQL+ ",startdate='"+IIF(EMPTY(m.dtStartDate),TTOC(DATETIME()),TTOC(m.dtStartDate))+"'"
				cSQL = cSQL+ ",DueDate='"+IIF(EMPTY(m.dDueDate),'',DTOC(m.dDueDate))+"'"
				cSQL = cSQL+ ",Comment='"+m.cComment+"'"
				cSQL = cSQL+ ",Process_ID='"+m.cProcess_ID+"'"
				cSQL = cSQL+ ",Processor='"+m.cProcessor+"'"
				cSQL = cSQL+ ",AllowSub='"+m.nAllowSub+"'"
		*		cSQL = cSQL+ ",pWeight="+STR(m.nWeight,18,4)+""
				cSQL = cSQL+ ",Pounds="+STR(m.nWeight,18,4)+""
		*		cSQL = cSQL+ ",pPc="+STR(m.nPC)+""
				cSQL = cSQL+ ",QTY="+STR(m.nQTY)+""
		
				cSQL = cSQL+ ",ID_Detail="+STR(m.nID_Detail)+""
				cSQL = cSQL+ " WHERE ID_Detail_Process="+STR(m.nID_Detail_Process)
			**	why is  m.nID_Detail_Process 0
		
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
				ENDDO
				IF nSQLEXEC < 0 &&Try again!1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 1' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL )
					ENDDO
				ENDIF
				IF nSQLEXEC < 0 &&Try again!
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
					DO WHILE nSQLEXEC = 0
						WAIT WINDOW 'SQL 2' TIMEOUT 1
						nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "")
						
						IF nSQLEXEC < 0
							IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
								nSQLEXEC = 0
							ENDIF
						ENDIF
					ENDDO
				ENDIF 
				IF nSQLEXEC < 0
					SQLExecError(cSQL,ThisForm.nConnHandle, nSQLEXEC, '')
					lOK = .F.
				ELSE
					=SQLCOMMIT(ThisForm.nConnHandle)
				ENDIF
			ENDIF
		ENDIF
		
		RETURN m.nID_Detail_Process
		
	ENDPROC

	PROCEDURE getweight		&& Call CalcWeight
		PARAMETERS pWhat
		*ThisForm.GetWeight("POUNDS")
		
		IF VARTYPE(pWhat) = "L"
			pWhat = ""
		ENDIF
		
		PRIVATE nPieces, cAlloy, cForm, nThickness, nSize2, nSize3
		PRIVATE nCalcWeight
		
		nPieces		= ThisForm.PC1.Value
		cAlloy		= ''
		cForm		= ''
		nThickness	= ThisForm.DIM11.Value
		nSize2		= ThisForm.DIM21.Value
		nSize3		= ThisForm.DIM31.Value
		
		
		IF NOT EMPTY(nThickness) AND NOT EMPTY(nSize2) AND NOT EMPTY(THISFORM.ID)
			*Get Form and Alloy
			PRIVATE cSQL, nSQLEXEC, cAlias
			IF ThisForm.Lst = "StockLst"
				
			ELSE
				
			ENDIF
			DO CASE
			CASE ThisForm.cTBL	= "S" 
				cSQL = "SELECT Form, Alloy FROM dbo.StockLst_Master WHERE ID = "+ STR(THISFORM.ID)
			CASE ThisForm.cTBL	= "B" 
				cSQL = "SELECT Form, Alloy FROM dbo.BrokerLst_Master WHERE ID = "+ STR(THISFORM.ID)
			CASE ThisForm.cTBL	= "W" 
				cSQL = "SELECT Form, Alloy FROM dbo.WIPLst_Master WHERE ID = "+ STR(THISFORM.ID)
			ENDCASE
		
			cAlias = ALIAS()
			IF USED("tmpStockLst")
				SELECT tmpStockLst
			ELSE 
				SELECT 0
			ENDIF
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpStockLst')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpStockLst")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL_Process,ThisForm.nConnHandle, nSQLEXEC, 'tmpStockLst')
			ELSE
				IF USED("tmpStockLst")
					cAlloy	= tmpStockLst.Alloy
					cForm	= tmpStockLst.Form
					USE IN tmpStockLst
				ENDIF
			ENDIF
			IF NOT EMPTY(cAlias)
				IF USED(cAlias)
					SELECT (cAlias)
				ENDIF
			ENDIF
			
		ENDIF
		
		
		IF NOT EMPTY(cAlloy) AND NOT EMPTY(cForm)
			IF EMPTY(nPieces)
				nPieces = 1
			ENDIF
			nCalcWeight = CalcWeight(nPieces, cAlloy, cForm, nThickness, nSize2, nSize3, ThisForm.nConnHandle )
			ThisForm.lblCalcWeight.Caption = "Est "+ALLTRIM(STR(nCalcWeight ))+" Lbs"
		ELSE
			ThisForm.lblCalcWeight.Caption = ''
		ENDIF
		
		IF NOT EMPTY(cForm)
			PRIVATE cPriceUnit, nFT, nUnit
			cPriceUnit = ''
			nFt = 0
			nUnit = 0
			
			cPriceUnit = FormUnitPrice( cForm, ThisForm.nConnHandle )
			
			*ThisForm.lblS_PU.Caption = GetPUfromForm( cForm, ThisForm.nConnHandle)
			ThisForm.lblUnit.Caption = cPriceUnit
			
			*********************************
			IF pWhat = "S_QTY"
				IF cPriceUnit = "LB"
					IF nCalcWeight > 0
						ThisForm.S_QTY.Value = nCalcWeight 
						ThisForm.S_QTY.Refresh
					ENDIF	
				ENDIF
		
				IF cPriceUnit = "FT"
					IF nPieces > 0
						
						PRIVATE nFtLen, nSigDim
						nFtLen = 0
						nSigDim = getSigDim(cForm, ThisForm.nConnHandle)
						IF nSigDim = 2
							nFtLen = IIF(nPieces<1,1,nPieces) * nSize2/12
						ENDIF
						IF nSigDim = 3
							nFtLen = IIF(nPieces<1,1,nPieces) * nSize3/12
						ENDIF
										
						IF nFtLen > 0
							ThisForm.S_QTY.Value = ROUND(nFtLen ,0)
							ThisForm.S_QTY.Refresh
						ENDIF
					ENDIF
				ENDIF
				
				IF cPriceUnit = "PC"
					IF nPieces > 0
						ThisForm.S_QTY.Value = nPieces
						ThisForm.S_QTY.Refresh
					ENDIF
				ENDIF
			ENDIF
			
			*********************************
			IF pWhat = "POUNDS"
				IF nPieces > 0
					ThisForm.Pounds1.Value = nCalcWeight 
					ThisForm.Pounds1.Refresh
				ENDIF
			ENDIF
			*********************************
		ENDIF
		
		
		
		
		
		
	ENDPROC

	PROCEDURE Init
		PARAMETER cWhatDo, pID_Detail, nProcessID, pLst, pReceivingID
		*DO FORM Forms\StockLst_Detail WITH cEdit, nID_Detail, nProcessID, 'StockLst', nRID
		*DO FORM Forms\StockLst_Detail WITH 'EDIT', 100, 0, 'StockLst', 0
		*DO FORM Forms\StockLst_Detail WITH 'EDIT', 55210, 0, 'StockLst', 28668
		
		IF VARTYPE(cWhatDo) = "C"
			DO CASE
			CASE cWhatDo= "ADD"
				ThisForm.WhatDo = "ADD"
			CASE cWhatDo= "CLONE"
				ThisForm.WhatDo = "CLONE"
			CASE cWhatDo= "EDIT"
				ThisForm.WhatDo = "EDIT"
			CASE cWhatDo= "VIEW"
				ThisForm.WhatDo = "VIEW"		
			CASE cWhatDo= "BREAK"
				ThisForm.WhatDo = "BREAK"
			CASE cWhatDo= "RESTORE"	&&called from StockLst Hitory, used to restore deleted stock
				ThisForm.WhatDo = "RESTORE"
			OTHERWISE
				MESSAGEBOX("Need PARAMETER: 'EDIT', nID_Detail",0,"ERROR")
				RETURN
			ENDCASE
		ELSE
			MESSAGEBOX("Need PARAMETER: like WhatDo = 'EDIT'",0,"ERROR")
			TrackError("Need PARAMETER: like WhatDo = [EDIT]","Need PARAMETER: like WhatDo = [EDIT]", PROGRAM(), LINENO(1))
			RETURN .F.
		ENDIF
		
		
		IF VARTYPE(pID_Detail) = "N"
			DO CASE
			CASE ThisForm.WhatDo = "ADD"
				ThisForm.ID = pID_Detail
				ThisForm.ID_Detail = 0
			CASE ThisForm.WhatDo = "CLONE"
				ThisForm.ID_Detail = pID_Detail
			CASE ThisForm.WhatDo = "EDIT"
				ThisForm.ID_Detail= pID_Detail
			CASE ThisForm.WhatDo = "VIEW"
				ThisForm.ID_Detail= pID_Detail
		
			CASE ThisForm.WhatDo = "BREAK"
				ThisForm.ID_Detail= pID_Detail
			ENDCASE
		ELSE
			ThisForm.ID_Detail = 0
			nID = 0
		ENDIF
		
		
		IF TYPE("pLst") = "U"
			pLst = "StockLst"
		ENDIF
		IF TYPE("pLst") != "C"
			pLst = "StockLst"
		ENDIF
		
		PRIVATE cTBL
		cTBL = PrepareSQLtxt(pLst,'TBL',1,.F.,.T.)
		DO CASE
		CASE cTBL  = "S"
			ThisForm.txtLst.Value = "StockLst"
			ThisForm.Lst 		  = "StockLst"
			ThisForm.cTBL			= "S"
		CASE cTBL  = "B"
			ThisForm.txtLst.Value = "BrokerLst"
			ThisForm.Lst 		  = "BrokerLst"
			ThisForm.cTBL			= "B"
			ThisForm.cmdSaveToStock.Visible = .T.
		
		CASE cTBL  = "W"
			ThisForm.txtLst.Value = "WIPLst"
			ThisForm.Lst 		  = "WIPLst"
			ThisForm.cTBL			= "W"
			ThisForm.cmdSaveToStock.Visible = .T.
		ENDCASE
		
		IF TYPE("pReceivingID") != "N"
			pReceivingID = 0
		ENDIF
		ThisForm.txtReceivingID.Value = pReceivingID
		
		DO CASE
		CASE ThisForm.WhatDo = "ADD"
			IF pReceivingID > 0
				ThisForm.CopyFromRid(pReceivingID)
			ELSE
				ThisForm.GetByID()
			ENDIF
			
		CASE ThisForm.WhatDo = "CLONE"
			ThisForm.CloneDetail(pID_Detail)
			
		CASE ThisForm.WhatDo = "EDIT"
			ThisForm.GetByID_Detail()
			ThisForm.chkQuarantine.Visible = .T.
			
		CASE ThisForm.WhatDo = "VIEW"
			ThisForm.GetByID_Detail()
			ThisForm.chkQuarantine.Visible = .T.
			ThisForm.cmdAbort.Caption = "Done"
			ThisForm.cmdSave.Visible = .F.
			
		CASE ThisForm.WhatDo = "BREAK"
			ThisForm.GetByID_Detail()
			
		ENDCASE
		
		IF TYPE("nProcessID") = "N"
			ThisForm.nProcessID = nProcessID
		ELSE
			ThisForm.nProcessID = 0
		ENDIF
		
		ThisForm.lblFormDescription.Caption = ''
		ThisForm.lblCalcWeight.Caption = ''
		ThisForm.lblUnit.Caption = ''
		
		
		ThisForm.FormsText()
		
		*If Admin, Show Edit!
		IF HavePermission('EditStockLstCostValue',.F.)
			ThisForm.CostValue1.Enabled = .T.
			ThisForm.S_P.Enabled = .T.
			ThisForm.InvoiceValue1.Enabled = .T.
			ThisForm.FloorStatus1.Visible = .T.
			ThisForm.cmbFloorStatus.Enabled = .T.
			ThisForm.lblExcess.Visible = .T.
			ThisForm.cmbClass.Enabled = .T.
		ELSE
			ThisForm.CostValue1.Enabled = .F.
			ThisForm.S_P.Enabled = .F.
			ThisForm.InvoiceValue1.Enabled = .F.
			ThisForm.FloorStatus1.Visible = .F.
			ThisForm.cmbFloorStatus.Enabled = .F.
			ThisForm.lblExcess.Visible = .F.
			ThisForm.cmbClass.Enabled = .F.
		ENDIF
		
		IF ThisForm.WhatDo = "BREAK"
			ThisForm.ShowBreakScreen()
		ELSE
			This.Width = 618
		ENDIF
		
		ThisForm.RefreshBook_P()
		
	ENDPROC

	PROCEDURE initmemvar
		ThisForm.ID1.Value			= THISFORM.ID
		ThisForm.ID_Detail1.Value	= THISFORM.ID_Detail
		*ThisForm.txtReceivingID.Value = 
		
		ThisForm.PC1.Value		= 1	
		ThisForm.Size_H1.Value	= 0
		ThisForm.Dim11.Value	= 0
		ThisForm.Size_L1.Value	= 0	
		ThisForm.Dim21.Value	= 0	
		ThisForm.Dim31.Value	= 0
		ThisForm.Pounds1.Value	= 0
		ThisForm.S_QTY.Value	= 0
		ThisForm.Descript1.Value= ""
		ThisForm.Length1.Value	= ""
		ThisForm.CostValue1.Value	= 0
		ThisForm.S_P.Value			= 0
		ThisForm.InvoiceValue1.Value	= 0
		ThisForm.FloorStatus1.Value		=""
		ThisForm.cmbFloorStatus.Value	= ''
		ThisForm.Class1.Value		= ""
		ThisForm.cmbClass.Value	= ''
		ThisForm.Location1.Value	= " "
		ThisForm.cmbLocation1.Value	= " "
		
		ThisForm.chkRandLen.Value  	= 0
		ThisForm.chkPrime.Value	= 0
		ThisForm.InvCheck1.Value	= CTOD('')
		ThisForm.chkMarkInvCheck.Value	= 0
		ThisForm.chkMarkInvMiss.Value	= 0
		ThisForm.chkQuarantine.Value		= 0
		
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SQL" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_SQL ADDITIVE
		ENDIF
		IF NOT "PROC_SETUP" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_Setup ADDITIVE
		ENDIF
		IF NOT "PROC_STOCKLST" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
			SET PROCEDURE TO Progs\Proc_StockLst ADDITIVE
		ENDIF
		
		ThisForm.nConnHandle = get_SQLSTRINGCONNECT()
		
		IF ThisForm.nConnHandle < 0
			= MESSAGEBOX('Cannot make connection', 16, 'SQL Connect Error')
			QUIT
		ENDIF
		
		IF NOT "Proc_ERP" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\Proc_ERP.prg ADDITIVE
		ENDIF
		IF NOT "PROC_QUOTES" $ SET("PROCEDURE")
			SET PROCEDURE TO Progs\PROC_QUOTES.prg ADDITIVE
		ENDIF
		
		*!*	PUBLIC gaUnit(4)
		*!*	gaUnit(1) = " "
		*!*	gaUnit(2) = "$/#"
		*!*	gaUnit(3) = "$/FT"
		*!*	gaUnit(4) = "$/PC"
		
	ENDPROC

	PROCEDURE processaddreceive		&& ProcessAddReceive
		PARAMETERS nWeight, nPC
		*ThisForm.ProcessAddReceive(nWeight, nPC)
		*cmdSave.Click()
		
		IF TYPE("nWeight") = "C"
			nWeight = VAL(nWeight)
		ENDIF
		IF TYPE("nWeight") != "N"
			nWeight = 0
		ENDIF
		IF TYPE("nPC") = "C"
			nPC = VAL(nPC)
		ENDIF
		IF TYPE("nPC") != "N"
			nPC = 0
		ENDIF
		
		PRIVATE m.cSalesPerson, m.dtStartDate, m.dDueDate
		PRIVATE m.cAllowSub, m.nWeight, m.nPc, m.cSOitem, m.cPO_Item
		PRIVATE m.cProcess_ID, m.cProcessor, m.cComment
		
		m.cSalesPerson	= ''
		m.dtStartDate	= DATETIME()
		m.dDueDate		= DATE()
		m.cAllowSub		= 'N'
		m.nWeight		= 0
		m.nPc			= 0
		m.cSOitem		= ''
		m.cPO_Item		= ''
		m.cProcess_ID	= "RECEIVED"
		m.cProcessor 	= SYS(0)
		m.cProcessor 	= ALLTRIM(RIGHT( m.cProcessor , LEN(m.cProcessor ) - AT('#',m.cProcessor ) - 1 ))
		m.cComment		= "Found Stock"
		
		PRIVATE nID_Detail
		*nReceivingID = ThisForm.txtReceivingID.Value
		*ThisForm.txtTable1.Value
		nID_Detail = THISFORM.ID_Detail
		
		
		cSQLi = "INSERT INTO dbo.Ar_"+ALLTRIM(ThisForm.txtLst.Value)+"_Process_History (What,SOitem,PO_Item,salesperson,startdate"
		cSQLi = cSQLi + ",duedate,comment,process_id,processor,AllowSub"
		*cSQLi = cSQLi + ",pWeight,pPc"
		cSQLi = cSQLi + ",ID_Detail"
		*cSQLi = cSQLi + ,Validated"
		cSQLi = cSQLi + ") VALUES ("
		cSQLi = cSQLi + "'"+m.cProcess_ID+"'"
		cSQLi = cSQLi + ",'"+STRTRAN(m.cSOitem,"'","''")+"'"
		cSQLi = cSQLi + ",'"+STRTRAN(m.cPO_Item,"'","''")+"'"
		cSQLi = cSQLi + ",'"+STRTRAN(m.cSalesPerson,"'","''")+"'"
		cSQLi = cSQLi + ",'"+IIF(EMPTY(m.dtStartDate),TTOC(DATETIME()),TTOC(m.dtStartDate))+"'"
		cSQLi = cSQLi + ",'"+IIF(EMPTY(m.dDueDate),'',DTOC(m.dDueDate))+"'"
		cSQLi = cSQLi + ",'"+STRTRAN(m.cComment,"'","''")+"'"
		cSQLi = cSQLi + ",'"+STRTRAN(m.cProcess_ID,"'","''")+"'"
		cSQLi = cSQLi + ",'"+STRTRAN(m.cProcessor,"'","''")+"'"
		cSQLi = cSQLi + ",'"+STRTRAN(m.cAllowSub,"'","''")+"'"
		*cSQLi = cSQLi + ","+STR(m.nWeight,18,4)
		*cSQLi = cSQLi + ","+STR(m.nPc)
		cSQLi = cSQLi + ","+ALLTRIM(STR(nID_Detail))+""
		*cSQLi = cSQLi + ",'F'"
		cSQLi = cSQLi + ")"
		
		nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		DO WHILE nSQLEXEC = 0
			WAIT WINDOW 'SQL' TIMEOUT 1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
		ENDDO
		IF nSQLEXEC < 0 &&Try again!1
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 1' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi )
			ENDDO
		ENDIF
		IF nSQLEXEC < 0 &&Try again!
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL 2' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQLi, "")
				
				IF nSQLEXEC < 0
					IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
						nSQLEXEC = 0
					ENDIF
				ENDIF
			ENDDO
		ENDIF 
		IF nSQLEXEC < 0
			SQLEXECError(cSQLi,ThisForm.nConnHandle, nSQLEXEC, '')
		ELSE
		
			******************************************
		*!*		** Testing, TrackMess
		*!*		PRIVATE pMessMemo
		*!*		*     (    INT, C(254),    C(254),      INT,      MEMO)
		*!*		pMessMemo = "This data is for test, Save Detail!."+CHR(13)
		*!*		pMessMemo = pMessMemo + CHR(13)
		*!*		pMessMemo = pMessMemo + cSQLi + CHR(13)
		
		*!*		RecordTest('Record Test Data.', PROGRAM(), LINENO(1), pMessMemo)
		*!*		
			******************************************************
			*Send Email
			PRIVATE cTBL, cURL, cMess, pcEmailSubject 
			cTBL = get_TBL(ThisForm.txtLst.Value)
			cURL = HTML_Stock_ID_Detail(cTBL, nID_Detail, .T.)
			
			cMess = "A "+TableName_TBL(cTBL)+" Addition has occured."
			**********
			MESSAGEBOX(cMess,64,"Sending this message as Email")
			
			pcEmailSubject = cMess
			cMess = cMess + CHR(10)+CHR(13) + " ID_Detail "+STR(nID_Detail)+" was listed as Found Stock"
			cMess = cMess + CHR(13) + " "
			cMess = cMess + CHR(10)+CHR(13) + "To see the Detail reocord, click here."
			cMess = cMess + CHR(13) + HTML_Stock_ID_Detail(cTBL, nID_Detail, .T.)
			
			***
			PRIVATE cUserName,cEmail, pcEmailTo, pcEmailFrom, pcEmailSubject
			cUserName = RIGHT( SYS(0), LEN(SYS(0))-AT("#",SYS(0))-1 )
			cEmail = AppSetup_Get_Email(cUserName)
			pcEmailTo = "Plant.Manager@SpaceAlloysUSA.com; David.Kirchner@SpaceAlloysUSA.com"
			IF NOT EMPTY(cEmail)
				IF NOT EMPTY(pcEmailTo)
					pcEmailTo = pcEmailTo + ";" + cEmail
				ELSE
					pcEmailTo = cEmail
				ENDIF
			ENDIF
			pcEmailFrom = cEmail 
			pcEmailSubject = "Found Stock"
			
			
			lOK = Send_HTML_Email(pcEmailTo, pcEmailFrom, pcEmailSubject, pcEmailText, ThisForm.nConnHandle, .T., .F.)
		*	lSendThisEmail = Alert_Receive_Check("ID_Detail",cOrderNumber,ThisForm.nConnHandle)
			
			
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE refreshbook_p
		*ThisForm.RefreshBook_P()
		ThisForm.txtBook_P.Value = 0
		IF ThisForm.Lst = "StockLst"
			PRIVATE nBook_P
			nBook_P = 0
		
			PRIVATE cSQL, nSQLEXEC
			*dbo.f_GetPrice_ID_Detail
		
			
			IF USED("tmpBook_P")
				SELECT tmpBook_P
			ELSE
				SELECT 0
			ENDIF
		
			cSQL = "SELECT dbo.f_GetPrice_ID_Detail("+STR(THISFORM.ID_Detail)+") AS Book_P "
		
			nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpBook_P')
			DO WHILE nSQLEXEC = 0
				WAIT WINDOW 'SQL' TIMEOUT 1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpBook_P')
			ENDDO
			IF nSQLEXEC < 0 &&Try again!1
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpBook_P')
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 1' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, 'tmpBook_P')
				ENDDO
			ENDIF
			IF nSQLEXEC < 0 &&Try again!
				nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpBook_P")
				DO WHILE nSQLEXEC = 0
					WAIT WINDOW 'SQL 2' TIMEOUT 1
					nSQLEXEC = SQLEXEC(ThisForm.nConnHandle, cSQL, "tmpBook_P")
					
					IF nSQLEXEC < 0
						IF MESSAGEBOX("SQL FAILED!"+CHR(13)+"Do you want to try again?",4+48,"ERROR") = 6
							nSQLEXEC = 0
						ENDIF
					ENDIF
				ENDDO
			ENDIF 
			IF nSQLEXEC < 0
				SQLEXECError(cSQL,ThisForm.nConnHandle, nSQLEXEC, 'tmpBook_P')
			ELSE
				IF USED("tmpBook_P")
					ThisForm.txtBook_P.Value = tmpBook_P.Book_P
					
					USE IN tmpBook_P
				ENDIF
			ENDIF
			
		ENDIF
		IF ThisForm.txtBook_P.Value > 0	
			ThisForm.lblBookPricing.Visible = .T.
			ThisForm.txtBook_P.Visible = .T.
			ThisForm.lblBook_PU.Visible = .T.
		ELSE
			ThisForm.lblBookPricing.Visible = .F.
			ThisForm.txtBook_P.Visible = .F.
			ThisForm.lblBook_PU.Visible = .F.
		ENDIF
	ENDPROC

