	PROCEDURE InvoiceValue1.DblClick
		PRIVATE nID, cPOitem, nHPAPO
		nID = PrepareSQLnum(ThisForm.ID1.Value,'ID',-3)
		*IF ThisForm.Lst = "StockLst"
		cPOitem = get_POitem_StockLstID(nID,0,'StockLst',ThisForm.nConnHandle)
		*get_POitem_StockLstID 
		
		nHPAPO = VAL(cPOitem)
		
		*IF nHPAPO > 0
		*	DO FORM forms\Purchase_Invoices WITH nHPAPO
		*ELSE
		*	MESSAGE("No ERP PO found")
		*ENDIF
		
		*Show PO on Repoert Server
		
		IF nHPApo > 0
			PRIVATE cHyperLink
			cHyperLink = HTML_PO(nHPApo,.T.)
		
			IF LEN(cHyperLink)>0
		
				PRIVATE loHyperlink
				loHyperlink = CREATEOBJECT("Hyperlink")
				loHyperlink.navigateto(cHyperLink)
				RELEASE loHyperlink
		
			ELSE
				MESSAGEBOX("No Hyperlink",16,"Cannot show PO")
			ENDIF
		ELSE
			MESSAGEBOX("No ERP PO number",16,"Cannot show PO")
		ENDIF
		
	ENDPROC

