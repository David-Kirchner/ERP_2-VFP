	PROCEDURE addvactiondate
		PARAMETER pDay,pMonth,pYear,pEmployee
		*ThisForm.AddVactionDate(This.day,This.Month,This.year,ThisForm.cmbAllEmployees.Value)
		*pDay,pMonth,pYear,pEmployee
		PRIVATE lnAdd, lnVacationID, ldVacationDate, lcVacationDate
		PRIVATE lcVacaType, lcDisplayName, lcHoliday
		
		
		IF IsNull(pDay) OR IsNull(pMonth) OR IsNull(pYear) 
			messagebox("Select a date first!",0,"No Date")
			RETURN -1
		ENDIF
		ldVacationDate = CTOD(STR(pMonth)+"/"+STR(pDay)+"/"+STR(pYear))
		lcVacationDate = DTOC(ldVacationDate)
		
		
		IF IsNull(pEmployee) 
			MESSAGEBOX("No Employee.",0,"No Employee")
			RETURN -1
		ENDIF
		
		IF (pEmployee) = "(Select Employee)"
			*ALLEMPLOYEE_LOC = "(Select Employee)"
			MESSAGEBOX("Select Employee First.",0,"No Employee.")
			RETURN -1
		ENDIF
		lcDisplayName = ALLTRIM(pEmployee)
		
		*Validate Holiday
		lcHoliday = IsHoliday(ldVacationDate)
		DO CASE
		CASE lcHoliday = "NO"
		CASE lcHoliday = "NoDate"
		OTHERWISE
			MESSAGEBOX( lcDisplayName+" can not take off holiday "+lcHoliday+".",0,"This date is already listed as a company holiday.")
			RETURN -1
		ENDCASE
		*Validate Vacation Time left
		*Validate on Vacation
		lcVacationAns = IsVacationDay(ldVacationDate,pEmployee)
		DO CASE
		CASE lcVacationAns = "NO"
		OTHERWISE && lcVacationAns = "YES"
			IF MESSAGEBOX( "Do you wish to unmark this date '"+lcVacationDate +"' for "+lcDisplayName+"?",4+32,"Date is already being used as vacation.") = 6
				ThisForm.RemoveVacationDate(pDay,pMonth,pYear,pEmployee)	
			ENDIF
			RETURN -1
		ENDCASE
		*Validate Add
		lnAdd = MESSAGEBOX("Mark "+lcDisplayName+CHR(10)+CHR(13)+" for vacation on "+CHR(10)+CHR(13);
		+lcVacationDate +".",4+32,"Confirm")
		*+ALLTRIM(STR(pMonth))+"/"+ALLTRIM(STR(pDay))+"/"+ALLTRIM(STR(pYear))+".",4+32,"Confirm")
		
		IF lnAdd = 6
			*Add
			lcVacaType="V"
			ThisForm.lstVacation.rowsourcetype = 0
			lnVacationID = NextVacationID()
			INSERT INTO Vacation (id,Vacatype,DispName,vacadate,hours) VALUES (lnVacationID,lcVacaType,lcDisplayName,ldVacationDate, 0)
			
			ThisForm.lstVacation.rowsource = "SELECT DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = UPPER(ALLTRIM(lcDisplayName)) AND MONTH(vacadate)=gMONTH AND YEAR(vacadate)=gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.rowsourcetype = 3
		*	ThisForm.lstVacation.Requery  Can not ReQuery with a Varible in the SQL string!!!!!!!!!!
		*	ThisForm.lstVacation.Refresh
			ThisForm.SetCalendar()
		ENDIF
		
		RETURN 0
	ENDPROC

	PROCEDURE Destroy
		IF USED('tempHoliday')
			USE IN tempHoliday
		ENDIF
		
		IF USED('TempVacationDays')
			USE IN TempVacationDays
		ENDIF
		
		IF VARTYPE(ERP_Menu) = "O"  &&
			ERP_Menu.WindowState = 0
		ENDIF

	ENDPROC

	PROCEDURE Init
		PUBLIC gDate, gDay, gMonth, gyear
		
		mDate = DATE()
		ThisForm.oleCal.SetCMDay = DAY(mDATE)
		ThisForm.oleCal.MonthIN = MONTH(mDATE)
		ThisForm.oleCal.YearIN  = YEAR(mDATE)
		
		ThisForm.oleCal.SetCMColor="A"
		ThisForm.oleCal.SetCM
		
		gDate  = mDate
		gDay   = DAY(mDATE)
		gMonth = MONTH(mDATE)
		gYear  = YEAR(mDATE)
		
		ThisForm.lblYear.Caption  = STR(gYear)
		ThisForm.lblMonth.Caption = CMONTH(mDATE)
		
		SET PROCEDURE TO Progs\Vacation ADDITIVE
		
		ThisForm.lstHolidays.RowSource = "SELECT DtoC(holidate) AS dayoff, holiday FROM holiday WHERE MONTH(holidate) = gMONTH AND YEAR(holidate) = gYEAR AND !DELETED() ORDER BY holidate INTO CURSOR tempHoliday" 
		ThisForm.lstHolidays.RowSourceType = 3
		
		
		ThisForm.lstVacation.rowsourcetype = 3
		ThisForm.lstVacation.rowsource = "SELECT DISTINCT DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() AND VacaType='V' ORDER BY vacadate INTO CURSOR TempVacationDays"
		
		
		ThisForm.SetCalendar()
		*ThisForm.cmbMonth.Value = CMONTH(gDate)
		
		ThisForm.cmdPrintEmp.Visible = .F.
		ThisForm.cmdPrintMonth.Visible = .F.
	ENDPROC

	PROCEDURE Load
		set safety off
		
		m.currdbc = IIF(EMPTY(DBC()),"",DBC())
		
	ENDPROC

	PROCEDURE nextmonth
		gMonth = gMonth + 1
		IF gMonth > 12
			gMonth = 1
			gYear = gYear + 1
		ENDIF
		
		DO CASE 
		CASE gMonth = 2
			IF gDay > 28
				gDay = 28
			ENDIF
		CASE INLIST(gMonth,4,6,9,11)
			*30 Days
			IF gDay > 30
				gDay = 30
			ENDIF
		OTHERWISE
			*31 Days
		ENDCASE
		
		
		gDate = CTOD(STR(gMonth)+"/"+STR(gDay)+"/"+STR(gYear))
		ThisForm.oleCal.SetCMDay = DAY(gDATE)
		ThisForm.oleCal.MonthIN = MONTH(gDATE)
		ThisForm.oleCal.YearIN  = YEAR(gDATE)
		
		*ThisForm.oleCal.SetCMColor="A"
		*ThisForm.oleCal.SetCM
		
		ThisForm.lblYear.Caption  = ALLTRIM(STR(gYear))
		ThisForm.lblMonth.Caption = CMONTH(gDATE)
		ThisForm.cmbMonth.Value = CMONTH(gDATE)
		
		ThisForm.lstVacation.Requery
		ThisForm.lstHolidays.Requery
		ThisForm.SetCalendar()
	ENDPROC

	PROCEDURE nextyear
		*WAIT WINDOW 'Next YEAR' NOWAIT
		gYear = ThisForm.oleCal.YearIN + 1
		ThisForm.oleCal.YearIN = gYear
		ThisForm.lblYear.Caption  = ALLTRIM(STR(gYear))
		ThisForm.SetCalendar()
	ENDPROC

	PROCEDURE prevmonth
		gMonth = gMonth - 1
		IF gMonth < 1
			gMonth = 12
			gYear = gYear - 1
		ENDIF
		
		DO CASE 
		CASE gMonth = 2
			IF gDay > 28
				gDay = 28
			ENDIF
		CASE INLIST(gMonth,4,6,9,11)
			*30 Days
			IF gDay > 30
				gDay = 30
			ENDIF
		OTHERWISE
			*31 Days
		ENDCASE
		
		
		gDate = CTOD(STR(gMonth)+"/"+STR(gDay)+"/"+STR(gYear))
		ThisForm.oleCal.SetCMDay = DAY(gDATE)
		ThisForm.oleCal.MonthIN = MONTH(gDATE)
		ThisForm.oleCal.YearIN  = YEAR(gDATE)
		
		*ThisForm.oleCal.SetCMColor="A"
		*ThisForm.oleCal.SetCM
		
		ThisForm.lblYear.Caption  = ALLTRIM(STR(gYear))
		ThisForm.lblMonth.Caption = CMONTH(gDATE)
		ThisForm.cmbMonth.Value = CMONTH(gDATE)
		
		ThisForm.lstVacation.Requery
		ThisForm.lstHolidays.Requery
		ThisForm.SetCalendar()
	ENDPROC

	PROCEDURE prevyear
		*WAIT WINDOW 'Prev Year' NOWAIT
		gYear = ThisForm.oleCal.YearIN - 1
		ThisForm.oleCal.YearIN = gYear
		ThisForm.lblYear.Caption  = ALLTRIM(STR(gYear))
		ThisForm.SetCalendar()
	ENDPROC

	PROCEDURE refreshdays
		PRIVATE ldDate, lcEmployee
		ldDate = DATE()
		lcEmployee = ThisForm.cmbAllEmployees.Value
		
		
		IF EMPTY(lcEmployee) OR lcEmployee = "(Select Employee)"
			ThisForm.lblAvail.Visible = .F.
			ThisForm.txtAvailable.Visible = .F.
			ThisForm.lblTaken.Visible = .F.
			ThisForm.txtTaken.Visible = .F.
			ThisForm.lblLeft.Visible = .F.
			ThisForm.txtLeft.Visible = .F.
			ThisForm.lblPersonal.Visible = .F.
			ThisForm.txtPersonal.Visible = .F.
			ThisForm.lblSick.Visible = .F.
			ThisForm.txtSick.Visible = .F.
			
			ThisForm.txtAvailable.Caption = ""
			ThisForm.txtTaken.Caption = ""
			ThisForm.txtLeft.Caption = ""
			ThisForm.txtSick.Caption = ""
		ELSE
			ThisForm.lblAvail.Visible = .T.
			ThisForm.txtAvailable.Visible = .T.
			ThisForm.lblTaken.Visible = .T.
			ThisForm.txtTaken.Visible = .T.
			ThisForm.lblLeft.Visible = .T.
			ThisForm.txtLeft.Visible = .T.
			ThisForm.lblPersonal.Visible = .T.
			ThisForm.txtPersonal.Visible = .T.
			ThisForm.lblSick.Visible = .T.
			ThisForm.txtSick.Visible = .T.
			
			ThisForm.txtAvailable.Caption = VacationTimeAllowed(ldDate , lcEmployee)
			ThisForm.txtTaken.Caption = VacationTimeUsed(ldDate , lcEmployee)
			ThisForm.txtLeft.Caption = ALLTRIM(STR( DaysVacationLeft(ldDate , lcEmployee) ))
			ThisForm.txtPersonal.Caption = PersonalTimeUsed(ldDate , lcEmployee)
			ThisForm.txtSick.Caption = SickTimeUsed(ldDate , lcEmployee)
		ENDIF
		
	ENDPROC

	PROCEDURE removevacationdate
		PARAMETER pDay,pMonth,pYear,pEmployee
		*ThisForm.RemoveVacationDate(day,Month,year,Employee)
		*pDay,pMonth,pYear,pEmployee
		PRIVATE lnAdd, lnVacationID, ldVacationDate, lcVacationDate
		PRIVATE lcVacaType, lcDisplayName, lcHoliday
		
		
		IF IsNull(pDay) OR IsNull(pMonth) OR IsNull(pYear) 
			messagebox("Select a date first!",0,"No Date")
			RETURN -1
		ENDIF
		ldVacationDate = CTOD(STR(pMonth)+"/"+STR(pDay)+"/"+STR(pYear))
		lcVacationDate = DTOC(ldVacationDate)
		
		
		IF IsNull(pEmployee) 
			MESSAGEBOX("No Employee.",0,"No Employee")
			RETURN -1
		ENDIF
		
		IF (pEmployee) = "(Select Employee)"
			*ALLEMPLOYEE_LOC = "(Select Employee)"
			MESSAGEBOX("Select Employee First.",0,"No Employee.")
			RETURN -1
		ENDIF
		lcDisplayName = ALLTRIM(pEmployee)
		
		
		*Validate on Vacation
		lcVacationAns = IsVacationDay(ldVacationDate,pEmployee)
		DO CASE
		CASE lcVacationAns = "YES"
			IF MESSAGEBOX( "Do you wish to unmark this date '"+lcVacationDate +"' for "+lcDisplayName+"?",4+32,"Date is already being used as vacation.") = 6
				ThisForm.RemoveVactionDate(pDay,pMonth,pYear,pEmployee)	
			ENDIF
		ENDCASE
		
		*Validate Remove
		lnAdd = MESSAGEBOX("Unmark "+lcDisplayName+CHR(10)+CHR(13)+" for vacation on "+CHR(10)+CHR(13);
		+lcVacationDate +".",4+32,"Confirm")
		*+ALLTRIM(STR(pMonth))+"/"+ALLTRIM(STR(pDay))+"/"+ALLTRIM(STR(pYear))+".",4+32,"Confirm")
		
		IF lnAdd = 6
			*Add
			lcVacaType="V"
			ThisForm.lstVacation.rowsourcetype = 0
		*	lnVacationID = NextVacationID()
		*	INSERT INTO Vacation (id,Vacatype,DispName,vacadate,hours) VALUES (lnVacationID,lcVacaType,lcDisplayName,ldVacationDate, 0)
			DELETE FROM VACATION WHERE ID = (lnVacationID) AND ;
			Vacatype = (lcVacaType) AND ;
			DispName = (lcDisplayName) AND ;
			vacadate = (ldVacationDate)
			
			ThisForm.lstVacation.rowsource = "SELECT DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = UPPER(ALLTRIM(lcDisplayName)) AND MONTH(vacadate)=gMONTH AND YEAR(vacadate)=gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.rowsourcetype = 3
		*	ThisForm.lstVacation.Requery  Can not ReQuery with a Varible in the SQL string!!!!!!!!!!
		*	ThisForm.lstVacation.Refresh
			ThisForm.SetCalendar()
		ENDIF
		
		RETURN 0
	ENDPROC

	PROCEDURE setcalendar		&& Show Colors
		PRIVATE mCurrTable
		mCurrTable = alias()
		wait window 'RESET' NOWAIT
		*RESET
		*THISFORM.LockScreen = .T.
		
		LOCAL loTherm, lcTask, lnPercent, lnSeconds
		loTherm = NewObject("_thermometer","\Program Files\Microsoft Visual Studio\VFP98\FFC\_therm","","Clearing Calendar")
		lcTask = 'Completing: '
		
		loTherm.Show()
		FOR I = 1 TO 49
			ThisForm.oleCal.SetCMDay = I
			ThisForm.oleCal.SetCMColor="A"
			ThisForm.oleCal.SetCM	
			lnPercent = I/50 * 100
			loTherm.Update(lnPercent ) &&,lcTask+" "+TRANS(lnPercent))
		NEXT I
		loTherm.Complete()
		*THISFORM.LockScreen = .F.
		
		wait window 'Vacation Days' NOWAIT
		
		*"SELECT DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = UPPER(ALLTRIM(THIS.Value)) AND MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR ORDER BY vacadate INTO CURSOR TempVacationDays"
		IF USED('TempVacationDays')
			SELECT TempVacationDays
			SCAN
			
			ThisForm.oleCal.SetCMDay = DAY(CTOD(DaysOff))
			DO CASE 
			CASE TempVacationDays.t = "V"
				ThisForm.oleCal.SetCMColor="B"
			CASE TempVacationDays.t = "S"
				ThisForm.oleCal.SetCMColor="C"
			CASE TempVacationDays.t = "P"
				ThisForm.oleCal.SetCMColor="D"
			ENDCASE
				
			ThisForm.oleCal.SetCM
			ENDSCAN
		ENDIF
		wait window 'Holidays' NOWAIT
		*"SELECT DtoC(holidate) AS dayoff, holiday FROM holiday WHERE MONTH(holidate) = gMONTH AND YEAR(holidate) = gYEAR ORDER BY holidate INTO CURSOR tempHoliday" 
		IF USED('tempHoliday')
			SELECT tempHoliday
			SCAN
				ThisForm.oleCal.SetCMDay = DAY(CTOD(dayoff))
				ThisForm.oleCal.SetCMColor="H"
				ThisForm.oleCal.SetCM
			ENDSCAN
		ENDIF
		
		IF !EMPTY(mCurrTable )
			SELECT (mCurrTable) 
		ENDIF
		
		*THISFORM.LockScreen = .F.
		wait clear
	ENDPROC

	PROCEDURE setlstholidays
	ENDPROC

	PROCEDURE setlstvacation
		IF ThisForm.cmbAllEmployees.Value = "(Select Employee)"
			ThisForm.lstVacation.rowsourcetype = 0
			ThisForm.lstVacation.rowsource = "SELECT DISTINCT DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() AND VacaType='V' ORDER BY vacadate INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.rowsourcetype = 3
		ELSE
			ThisForm.lstVacation.rowsourcetype = 0
			mSQL = "SELECT DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = '"
			mSQL = mSQL + UPPER(ALLTRIM(THIS.Value))
			mSQL = mSQL + "' AND MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.rowsource = mSQL
		    *SELECT STR(1/ 1-DayFraction)+' '+DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = UPPER(ALLTRIM(THIS.Value)) AND YEAR(vacadate) = gYEAR INTO CURSOR TempVacationDays
			ThisForm.lstVacation.rowsourcetype = 3
		ENDIF
	ENDPROC

	PROCEDURE setmonthto		&& Pass Month as Character
		Parameter cTextMonth
		
		IF TYPE('cTextMonth') <> "C"
			RETURN
		ENDIF
		
		FOR i = 1 to 12
			cDate = ALLTRIM(STR(i))+"/1/00"
			IF CMONTH(CTOD(cDate)) = cTextMonth
				gMonth = i
			ENDIF
		NEXT i
		
		DO CASE 
		CASE gMonth = 2
			IF gDay > 28
				gDay = 28
			ENDIF
		CASE INLIST(gMonth,4,6,9,11)
			*30 Days
			IF gDay > 30
				gDay = 30
			ENDIF
		OTHERWISE
			*31 Days
		ENDCASE
		
		gDate = CTOD(STR(gMonth)+"/"+STR(gDay)+"/"+STR(gYear))
		
		ThisForm.oleCal.SetCMDay = DAY(gDATE)
		ThisForm.oleCal.MonthIN = MONTH(gDATE)
		ThisForm.oleCal.YearIN  = YEAR(gDATE)
		
		*ThisForm.oleCal.SetCMColor="A"
		*ThisForm.oleCal.SetCM
		
		ThisForm.lblYear.Caption  = STR(gYear)
		ThisForm.lblMonth.Caption = CMONTH(gDATE)
		
		ThisForm.lstVacation.Requery
		ThisForm.lstHolidays.Requery
		ThisForm.SetCalendar()
		
	ENDPROC

	PROCEDURE cmbAllEmployees.Init
		this.clear
		this.additem("(Select Employee)")
		
		LOCAL aEmployees,cEmployee
		DIMENSION aEmployees[1]
		
		SELECT dispname FROM employees WHERE Active1 AND !DELETED() INTO array aEmployees
		
		FOR EACH m.cEmployee IN aEmployees
			IF !EMPTY(m.cEmployee)
					this.additem(m.cEmployee)
			ENDIF
		ENDFOR
		
		THIS.VALUE = "(Select Employee)"
	ENDPROC

	PROCEDURE cmbAllEmployees.InteractiveChange
		LOCAL cDisplayValue, mSQL, mValue
		THISFORM.LockScreen = .T.
		IF THIS.Value = "(Select Employee)"
			ThisForm.lstVacation.rowsourcetype = 0
			ThisForm.lstVacation.rowsource = "SELECT DISTINCT DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() AND VacaType='V' ORDER BY vacadate INTO CURSOR TempVacationDays"
			ThisForm.lstVacation.rowsourcetype = 3
		ELSE
			ThisForm.lstVacation.rowsourcetype = 0
			mSQL = "SELECT DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = '"
			mValue = UPPER(ALLTRIM(THIS.Value))
			mSQL = mSQL + (mValue)
			mSQL = mSQL + "' AND MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
		
			ThisForm.lstVacation.rowsource = mSQL
			*"SELECT DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = UPPER(ALLTRIM(THIS.Value)) AND MONTH(vacadate) = gMONTH AND YEAR(vacadate) = gYEAR AND !DELETED() ORDER BY vacadate INTO CURSOR TempVacationDays"
		    *SELECT STR(1/ 1-DayFraction)+' '+DTOC(vacadate) AS DaysOff, VacaType AS T FROM vacation  WHERE UPPER(ALLTRIM(vacation.DispName)) = UPPER(ALLTRIM(THIS.Value)) AND YEAR(vacadate) = gYEAR INTO CURSOR TempVacationDays
			ThisForm.lstVacation.rowsourcetype = 3
		ENDIF
		THISFORM.LockScreen = .F.
		ThisForm.SetCalendar()
		ThisForm.RefreshDays()
	ENDPROC

	PROCEDURE cmbMonth.Init
		This.Clear
		
		FOR i = 1 to 12
		cDate = ALLTRIM(STR(i))+"/1/00"
		This.AddItem(CMONTH(CTOD(cDate)))
		NEXT i
		
		This.Value = CMONTH(DATE())
	ENDPROC

	PROCEDURE cmbMonth.InteractiveChange
		IF THIS.Value <> CMONTH(gDATE)
			ThisForm.SetMonthTo(This.Value)
		ENDIF
	ENDPROC

	PROCEDURE cmdAddVaca.Click
		ThisForm.AddVactionDate(ThisForm.oleCal.day,ThisForm.oleCal.Month,ThisForm.oleCal.year,ThisForm.cmbAllEmployees.Value)
		
		ThisForm.SetCalendar()
	ENDPROC

	PROCEDURE cmdBackup.Click
			ThisForm.lstVacation.Requery
			ThisForm.lstVacation.Refresh
		
		
		IF USED('Employees')
			SELECT Employees
			COPY TO c:\Employees
		ENDIF
		
		IF USED('Holiday')
			SELECT Holiday
			COPY TO C:\Holiday
		ENDIF
		
		IF USED('Vacation')
			SELECT Vacation
			COPY TO C:\Vacation
		ENDIF
		
		WAIT WINDOW 'Saved...' NOWAIT
	ENDPROC

