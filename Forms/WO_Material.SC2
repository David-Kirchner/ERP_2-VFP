	PROCEDURE ApplyLayout
		LOCAL llSplit
		llSplit = (This.cShape = "S")
		This.lblDetails.Visible = llSplit
		This.grdDetails.Visible = llSplit
		This.lblPool.Visible = llSplit
		IF llSplit
			This.lblShape.Caption = "SPLIT"
			This.lblShape.BackColor = RGB(255,200,120)
			This.lblSteps.Top = 210
			This.grdSteps.Top = 228
			This.grdSteps.Height = 240
			* Columns(2) = WO_Detail (FoxBin often drops Column.Name = clm*)
			IF This.grdSteps.ColumnCount >= 2
				This.grdSteps.Columns(2).Width = 70
			ENDIF
		ELSE
			This.lblShape.Caption = "LINEAR"
			This.lblShape.BackColor = RGB(180,220,180)
			This.lblSteps.Top = 72
			This.grdSteps.Top = 90
			This.grdSteps.Height = 370
			IF This.grdSteps.ColumnCount >= 2
				This.grdSteps.Columns(2).Width = 0
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE ClearCursors
		IF USED("csrWOHdr")
			USE IN csrWOHdr
		ENDIF
		IF USED("csrWODet")
			USE IN csrWODet
		ENDIF
		IF USED("csrWOSteps")
			USE IN csrWOSteps
		ENDIF
		IF USED("csrWOSO")
			USE IN csrWOSO
		ENDIF
		CREATE CURSOR csrWOHdr (wo I, woshape C(1), descript C(100), cmplt L, cncld L, stkconsumed L, ;
			grablb N(9,1), grabheat C(50), grablot C(10), grabtbl C(1), grabid_detail I, ;
			poolclosed L, branchlb N(9,1), scraplb N(9,1), remnantlb N(9,1), accountedlb N(9,1), unaccountedlb N(9,1))
		CREATE CURSOR csrWODet (wo_detail I, detailrole C(1), alloy C(12), form C(2), thck N(10,4), ;
			sz2 N(9,3), currentlot C(10), branchstartlb N(9,1), fweight N(9,1), fdescript C(100), ;
			finishm C(20), finishlot I, sizeinfo C(80))
		CREATE CURSOR csrWOSteps (seq I, wo_detail I, processcode C(20), processcaption C(40), ;
			lot C(10), startlb N(9,1), endlb N(9,1), losslb N(9,1), pctofgrab N(9,2), pctofstep N(9,2), ;
			changesproperties L)
		CREATE CURSOR csrWOSO (soitem C(10), wo_detail I, lbplanned N(9,1))
	ENDPROC

	PROCEDURE ConfigureGrids
		* Bind via Columns(n) — SCX/FoxBin round-trip does not keep Column1.Name = "clmRole".
		WITH This.grdDetails
			.RecordSource = "csrWODet"
			.ColumnCount = 6
			.Columns(1).ControlSource = "csrWODet.detailrole"
			.Columns(1).Width = 50
			.Columns(1).Header1.Caption = "Role"
			.Columns(2).ControlSource = "csrWODet.wo_detail"
			.Columns(2).Width = 80
			.Columns(2).Header1.Caption = "WO_Detail"
			.Columns(3).ControlSource = "csrWODet.sizeinfo"
			.Columns(3).Width = 220
			.Columns(3).Header1.Caption = "Alloy / Form / Size"
			.Columns(4).ControlSource = "csrWODet.currentlot"
			.Columns(4).Width = 80
			.Columns(4).Header1.Caption = "Lot"
			.Columns(5).ControlSource = "csrWODet.branchstartlb"
			.Columns(5).Width = 80
			.Columns(5).Header1.Caption = "Start Lb"
			.Columns(6).ControlSource = "csrWODet.fdescript"
			.Columns(6).Width = 200
			.Columns(6).Header1.Caption = "Finish / notes"
		ENDWITH
		WITH This.grdSteps
			.RecordSource = "csrWOSteps"
			.ColumnCount = 9
			.Columns(1).ControlSource = "csrWOSteps.seq"
			.Columns(1).Width = 40
			.Columns(1).Header1.Caption = "Seq"
			.Columns(2).ControlSource = "csrWOSteps.wo_detail"
			.Columns(2).Width = 70
			.Columns(2).Header1.Caption = "Detail"
			.Columns(3).ControlSource = "csrWOSteps.processcaption"
			.Columns(3).Width = 140
			.Columns(3).Header1.Caption = "Process"
			.Columns(4).ControlSource = "csrWOSteps.lot"
			.Columns(4).Width = 70
			.Columns(4).Header1.Caption = "Lot"
			.Columns(5).ControlSource = "csrWOSteps.startlb"
			.Columns(5).Width = 70
			.Columns(5).Header1.Caption = "Start Lb"
			.Columns(6).ControlSource = "csrWOSteps.endlb"
			.Columns(6).Width = 70
			.Columns(6).Header1.Caption = "End Lb"
			.Columns(7).ControlSource = "csrWOSteps.losslb"
			.Columns(7).Width = 70
			.Columns(7).Header1.Caption = "Loss Lb"
			.Columns(8).ControlSource = "csrWOSteps.pctofgrab"
			.Columns(8).Width = 70
			.Columns(8).Header1.Caption = "% Grab"
			.Columns(9).ControlSource = "csrWOSteps.pctofstep"
			.Columns(9).Width = 70
			.Columns(9).Header1.Caption = "% Step"
		ENDWITH
		WITH This.grdSO
			.RecordSource = "csrWOSO"
			.ColumnCount = 3
			.Columns(1).ControlSource = "csrWOSO.soitem"
			.Columns(1).Width = 100
			.Columns(1).Header1.Caption = "SOitem"
			.Columns(2).ControlSource = "csrWOSO.wo_detail"
			.Columns(2).Width = 80
			.Columns(2).Header1.Caption = "WO_Detail"
			.Columns(3).ControlSource = "csrWOSO.lbplanned"
			.Columns(3).Width = 80
			.Columns(3).Header1.Caption = "Lb planned"
		ENDWITH
	ENDPROC

	PROCEDURE Destroy
		IF USED("csrWOHdr")
			USE IN csrWOHdr
		ENDIF
		IF USED("csrWODet")
			USE IN csrWODet
		ENDIF
		IF USED("csrWOSteps")
			USE IN csrWOSteps
		ENDIF
		IF USED("csrWOSO")
			USE IN csrWOSO
		ENDIF
		IF USED("tmpWOHdr")
			USE IN tmpWOHdr
		ENDIF
		IF USED("tmpWODet")
			USE IN tmpWODet
		ENDIF
		IF USED("tmpWOSteps")
			USE IN tmpWOSteps
		ENDIF
		IF USED("tmpWOSO")
			USE IN tmpWOSO
		ENDIF
		IF VARTYPE(ERP_Menu) = "O"
			ERP_Menu.WindowState = 0
		ENDIF
	ENDPROC

	PROCEDURE FilterStepsToDetail
		LOCAL lnDet, lcFilt
		IF NOT USED("csrWOSteps")
			RETURN
		ENDIF
		IF This.cShape # "S" OR NOT USED("csrWODet") OR EOF("csrWODet")
			This.nFilterDetail = 0
			SELECT csrWOSteps
			SET FILTER TO
			GO TOP
			This.grdSteps.Refresh()
			RETURN
		ENDIF
		lnDet = csrWODet.wo_detail
		This.nFilterDetail = lnDet
		* Literal filter — local lnDet is out of scope on later grdSteps.Refresh()
		lcFilt = "wo_detail = " + ALLTRIM(STR(lnDet))
		SELECT csrWOSteps
		SET FILTER TO &lcFilt
		GO TOP
		This.grdSteps.Refresh()
		This.lblSteps.Caption = "Process steps for WO_Detail " + ALLTRIM(STR(lnDet))
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tnWO
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO PROGS\proc_setup ADDITIVE
		ENDIF
		This.ClearCursors()
		This.nConnHandle = get_SQLSTRINGCONNECT()
		IF This.nConnHandle < 1
			MESSAGEBOX("Could not connect to SQL.", 16, "WO Material")
			RETURN .F.
		ENDIF
		This.ConfigureGrids()
		This.ApplyLayout()
		IF VARTYPE(tnWO) = "N" AND tnWO > 0
			This.txtWO.Value = tnWO
			This.LoadWO(tnWO)
		ENDIF
	ENDPROC

	PROCEDURE Load
		IF NOT "PROC_SETUP" $ UPPER(SET("PROCEDURE"))
			SET PROCEDURE TO PROGS\proc_setup ADDITIVE
		ENDIF
		SET PROCEDURE TO PROGS\WO_Material ADDITIVE
		This.ClearCursors()
	ENDPROC

	PROCEDURE LoadWO
		LPARAMETERS tnWO
		LOCAL lcSQL, lnRet, lcShape, lnGrab, lnUnacc, lcPool
		IF VARTYPE(tnWO) # "N" OR tnWO < 1
			MESSAGEBOX("Enter a Work Order number.", 48, "WO Material")
			RETURN
		ENDIF
		This.nWO = INT(tnWO)
		This.ClearCursors()
		
		IF USED("tmpWOHdr")
			USE IN tmpWOHdr
		ENDIF
		lcSQL = "SELECT * FROM dbo.v_WO_Material_Header WITH (NOEXPAND) WHERE WO = " + ALLTRIM(STR(This.nWO))
		* NOEXPAND may fail on non-indexed view — use plain SELECT
		lcSQL = "SELECT * FROM dbo.v_WO_Material_Header WHERE WO = " + ALLTRIM(STR(This.nWO))
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpWOHdr")
		IF lnRet < 1
			MESSAGEBOX("Could not load WO header."+CHR(13)+ ;
				"Run Config\24 and Config\25 WO Material SQL if views are missing.", 48, "WO Material")
			RETURN
		ENDIF
		IF RECCOUNT("tmpWOHdr") = 0
			USE IN tmpWOHdr
			MESSAGEBOX("WO " + ALLTRIM(STR(This.nWO)) + " not found.", 48, "WO Material")
			RETURN
		ENDIF
		SELECT csrWOHdr
		ZAP
		INSERT INTO csrWOHdr (wo, woshape, descript, cmplt, cncld, stkconsumed, grablb, grabheat, grablot, ;
			grabtbl, grabid_detail, poolclosed, branchlb, scraplb, remnantlb, accountedlb, unaccountedlb) ;
			VALUES (tmpWOHdr.WO, ALLTRIM(tmpWOHdr.WO_Shape), ALLTRIM(NVL(tmpWOHdr.Descript,"")), ;
				NVL(tmpWOHdr.Cmplt,.F.), NVL(tmpWOHdr.Cncld,.F.), NVL(tmpWOHdr.StkConsumed,.F.), ;
				NVL(tmpWOHdr.GrabLb,0), ALLTRIM(NVL(tmpWOHdr.GrabHeat,"")), ALLTRIM(NVL(tmpWOHdr.GrabLot,"")), ;
				ALLTRIM(NVL(tmpWOHdr.GrabTBL,"")), NVL(tmpWOHdr.GrabID_Detail,0), NVL(tmpWOHdr.PoolClosed,.F.), ;
				NVL(tmpWOHdr.BranchLb,0), NVL(tmpWOHdr.ScrapLb,0), NVL(tmpWOHdr.RemnantLb,0), ;
				NVL(tmpWOHdr.AccountedLb,0), NVL(tmpWOHdr.UnaccountedLb,0))
		USE IN tmpWOHdr
		SELECT csrWOHdr
		GO TOP
		lcShape = UPPER(ALLTRIM(csrWOHdr.woshape))
		IF EMPTY(lcShape)
			lcShape = "L"
		ENDIF
		This.cShape = lcShape
		This.lblGrab.Caption = "Grab Heat " + ALLTRIM(csrWOHdr.grabheat) + "  Lot " + ALLTRIM(csrWOHdr.grablot) + ;
			"  " + ALLTRIM(STR(csrWOHdr.grablb,9,1)) + " lb  TBL=" + ALLTRIM(csrWOHdr.grabtbl) + ;
			"  ID_Detail=" + ALLTRIM(STR(csrWOHdr.grabid_detail)) + ;
			IIF(csrWOHdr.stkconsumed, "  Consumed", "") + IIF(csrWOHdr.cmplt, "  Complete", "")
		IF lcShape = "S"
			lnUnacc = csrWOHdr.unaccountedlb
			lcPool = "POOL  Grab " + ALLTRIM(STR(csrWOHdr.grablb,9,1)) + ;
				"  Branches " + ALLTRIM(STR(csrWOHdr.branchlb,9,1)) + ;
				"  Scrap " + ALLTRIM(STR(csrWOHdr.scraplb,9,1)) + ;
				"  Remnant " + ALLTRIM(STR(csrWOHdr.remnantlb,9,1)) + ;
				"  Unaccounted " + ALLTRIM(STR(lnUnacc,9,1)) + " lb"
			IF ABS(lnUnacc) > 1
				lcPool = lcPool + "  ** OUT OF ±1 lb **"
				This.lblPool.BackColor = RGB(255,180,180)
			ELSE
				This.lblPool.BackColor = RGB(255,230,180)
			ENDIF
			This.lblPool.Caption = lcPool
		ELSE
			This.lblPool.Caption = ""
		ENDIF
		This.ApplyLayout()
		
		* Details
		IF USED("tmpWODet")
			USE IN tmpWODet
		ENDIF
		lcSQL = "SELECT WO_Detail, ISNULL(DetailRole,'F') AS DetailRole, ISNULL(fAlloy,'') AS Alloy, "
		lcSQL = lcSQL + "ISNULL(fForm,'') AS Form, ISNULL(fThck,0) AS Thck, ISNULL(fSz2,0) AS Sz2, "
		lcSQL = lcSQL + "ISNULL(CurrentLot,ISNULL(fLot,'')) AS CurrentLot, "
		lcSQL = lcSQL + "ISNULL(BranchStartLb,ISNULL(fWeight,0)) AS BranchStartLb, ISNULL(fWeight,0) AS fWeight, "
		lcSQL = lcSQL + "ISNULL(fDescript,'') AS fDescript, ISNULL(FinishM,'') AS FinishM, ISNULL(FinishLot,0) AS FinishLot "
		lcSQL = lcSQL + "FROM dbo.WorkOrder_Detail WITH (NOLOCK) WHERE WO = " + ALLTRIM(STR(This.nWO))
		lcSQL = lcSQL + " AND ISNULL(fCncld,0)=0 ORDER BY ISNULL(BranchSeq,999), WO_Detail"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpWODet")
		IF lnRet > 0 AND USED("tmpWODet")
			SELECT tmpWODet
			SCAN
				INSERT INTO csrWODet (wo_detail, detailrole, alloy, form, thck, sz2, currentlot, branchstartlb, ;
					fweight, fdescript, finishm, finishlot, sizeinfo) VALUES ;
					(tmpWODet.WO_Detail, ALLTRIM(tmpWODet.DetailRole), ALLTRIM(tmpWODet.Alloy), ALLTRIM(tmpWODet.Form), ;
					tmpWODet.Thck, tmpWODet.Sz2, ALLTRIM(tmpWODet.CurrentLot), tmpWODet.BranchStartLb, tmpWODet.fWeight, ;
					ALLTRIM(tmpWODet.fDescript), ALLTRIM(tmpWODet.FinishM), tmpWODet.FinishLot, ;
					ALLTRIM(tmpWODet.Alloy)+" "+ALLTRIM(tmpWODet.Form)+" "+ALLTRIM(STR(tmpWODet.Thck,10,4))+ ;
					" / "+ALLTRIM(STR(tmpWODet.Sz2,9,3)))
			ENDSCAN
			USE IN tmpWODet
		ENDIF
		
		* Steps
		IF USED("tmpWOSteps")
			USE IN tmpWOSteps
		ENDIF
		lcSQL = "SELECT Seq, WO_Detail, ProcessCode, ISNULL(ProcessCaption,ProcessCode) AS ProcessCaption, "
		lcSQL = lcSQL + "ISNULL(Lot,'') AS Lot, StartLb, EndLb, LossLb, PctOfGrab, PctOfStep, ChangesProperties "
		lcSQL = lcSQL + "FROM dbo.v_WO_Material_Steps WHERE WO = " + ALLTRIM(STR(This.nWO))
		lcSQL = lcSQL + " ORDER BY WO_Detail, Seq"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpWOSteps")
		IF lnRet < 1
			* Fallback if view missing: empty steps OK
		ELSE
			IF USED("tmpWOSteps")
				SELECT tmpWOSteps
				SCAN
					INSERT INTO csrWOSteps (seq, wo_detail, processcode, processcaption, lot, startlb, endlb, ;
						losslb, pctofgrab, pctofstep, changesproperties) VALUES ;
						(tmpWOSteps.Seq, tmpWOSteps.WO_Detail, ALLTRIM(tmpWOSteps.ProcessCode), ;
						ALLTRIM(tmpWOSteps.ProcessCaption), ALLTRIM(tmpWOSteps.Lot), ;
						NVL(tmpWOSteps.StartLb,0), NVL(tmpWOSteps.EndLb,0), NVL(tmpWOSteps.LossLb,0), ;
						NVL(tmpWOSteps.PctOfGrab,0), NVL(tmpWOSteps.PctOfStep,0), NVL(tmpWOSteps.ChangesProperties,.F.))
				ENDSCAN
				USE IN tmpWOSteps
			ENDIF
		ENDIF
		
		* Linked SOs
		IF USED("tmpWOSO")
			USE IN tmpWOSO
		ENDIF
		lcSQL = "SELECT s.SOitem, s.WO_Detail, s.LbPlanned FROM dbo.WorkOrder_Detail_SO s WITH (NOLOCK) "
		lcSQL = lcSQL + "INNER JOIN dbo.WorkOrder_Detail d ON d.WO_Detail = s.WO_Detail "
		lcSQL = lcSQL + "WHERE d.WO = " + ALLTRIM(STR(This.nWO)) + " ORDER BY s.SOitem"
		lnRet = SQLEXEC(This.nConnHandle, lcSQL, "tmpWOSO")
		IF lnRet > 0 AND USED("tmpWOSO")
			SELECT tmpWOSO
			SCAN
				INSERT INTO csrWOSO (soitem, wo_detail, lbplanned) VALUES ;
					(ALLTRIM(tmpWOSO.SOitem), tmpWOSO.WO_Detail, NVL(tmpWOSO.LbPlanned,0))
			ENDSCAN
			USE IN tmpWOSO
		ENDIF
		
		This.ConfigureGrids()
		This.nFilterDetail = 0
		SELECT csrWOSteps
		SET FILTER TO
		IF This.cShape = "S" AND USED("csrWODet") AND RECCOUNT("csrWODet") > 0
			SELECT csrWODet
			GO TOP
			This.FilterStepsToDetail()
		ELSE
			This.lblSteps.Caption = "Process steps (pounds) — LINEAR progress"
			SELECT csrWOSteps
			GO TOP
		ENDIF
		This.grdDetails.Refresh()
		This.grdSteps.Refresh()
		This.grdSO.Refresh()
	ENDPROC

	PROCEDURE cmdClose.Click
		ThisForm.Release()
	ENDPROC

	PROCEDURE cmdLoad.Click
		This.LoadWO(INT(VAL(TRANSFORM(This.txtWO.Value))))
	ENDPROC

	PROCEDURE grdDetails.AfterRowColChange
		LPARAMETERS nColIndex
		ThisForm.FilterStepsToDetail()
	ENDPROC

	PROCEDURE txtWO.Valid
		* Allow Tab / Enter to load
		RETURN .T.
	ENDPROC

ENDDEFINE
