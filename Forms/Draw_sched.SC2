	PROCEDURE addrow
		PARAMETERS nCurrRow
		*ThisForm.AddRow()
		
		IF nCurrRow = 1
			ThisForm.txtDia9.Value	= PrepareSQLnum(ThisForm.txtDia8.Value,'Dia',5,3)
			ThisForm.txtCW9.Value	= PrepareSQLnum(ThisForm.txtCW8.Value,'CW',3,1)
			ThisForm.chkAnn9.Value	= ThisForm.chkAnn8.Value
			
			ThisForm.txtDia8.Value	= PrepareSQLnum(ThisForm.txtDia7.Value,'Dia',5,3)
			ThisForm.txtCW8.Value	= PrepareSQLnum(ThisForm.txtCW7.Value,'CW',3,1)
			ThisForm.chkAnn8.Value	= ThisForm.chkAnn7.Value
			
			ThisForm.txtDia7.Value	= PrepareSQLnum(ThisForm.txtDia6.Value,'Dia',5,3)
			ThisForm.txtCW7.Value	= PrepareSQLnum(ThisForm.txtCW6.Value,'CW',3,1)
			ThisForm.chkAnn7.Value	= ThisForm.chkAnn6.Value
			
			ThisForm.txtDia6.Value	= PrepareSQLnum(ThisForm.txtDia5.Value,'Dia',5,3)
			ThisForm.txtCW6.Value	= PrepareSQLnum(ThisForm.txtCW5.Value,'CW',3,1)
			ThisForm.chkAnn6.Value	= ThisForm.chkAnn5.Value
			
			ThisForm.txtDia5.Value	= PrepareSQLnum(ThisForm.txtDia4.Value,'Dia',5,3)
			ThisForm.txtCW5.Value	= PrepareSQLnum(ThisForm.txtCW4.Value,'CW',3,1)
			ThisForm.chkAnn5.Value	= ThisForm.chkAnn4.Value
			
			ThisForm.txtDia4.Value	= PrepareSQLnum(ThisForm.txtDia3.Value,'Dia',5,3)
			ThisForm.txtCW4.Value	= PrepareSQLnum(ThisForm.txtCW3.Value,'CW',3,1)
			ThisForm.chkAnn4.Value	= ThisForm.chkAnn3.Value
		
			ThisForm.txtDia3.Value	= PrepareSQLnum(ThisForm.txtDia2.Value,'Dia',5,3)
			ThisForm.txtCW3.Value	= PrepareSQLnum(ThisForm.txtCW2.Value,'CW',3,1)
			ThisForm.chkAnn3.Value	= ThisForm.chkAnn2.Value
		
			ThisForm.txtDia2.Value	= PrepareSQLnum(ThisForm.txtDia1.Value,'Dia',5,3)
			ThisForm.txtCW2.Value	= PrepareSQLnum(ThisForm.txtCW1.Value,'CW',3,1)
			ThisForm.chkAnn2.Value	= ThisForm.chkAnn1.Value
			
			ThisForm.txtDia1.Value	= 0.000
			ThisForm.txtCW1.Value	= 0.0
			ThisForm.lblRA1.Caption	= ''
			
		ENDIF
		
		IF nCurrRow = 2
			ThisForm.txtDia9.Value	= PrepareSQLnum(ThisForm.txtDia8.Value,'Dia',5,3)
			ThisForm.txtCW9.Value	= PrepareSQLnum(ThisForm.txtCW8.Value,'CW',3,1)
			ThisForm.chkAnn9.Value	= ThisForm.chkAnn8.Value
			
			ThisForm.txtDia8.Value	= PrepareSQLnum(ThisForm.txtDia7.Value,'Dia',5,3)
			ThisForm.txtCW8.Value	= PrepareSQLnum(ThisForm.txtCW7.Value,'CW',3,1)
			ThisForm.chkAnn8.Value	= ThisForm.chkAnn7.Value
			
			ThisForm.txtDia7.Value	= PrepareSQLnum(ThisForm.txtDia6.Value,'Dia',5,3)
			ThisForm.txtCW7.Value	= PrepareSQLnum(ThisForm.txtCW6.Value,'CW',3,1)
			ThisForm.chkAnn7.Value	= ThisForm.chkAnn6.Value
			
			ThisForm.txtDia6.Value	= PrepareSQLnum(ThisForm.txtDia5.Value,'Dia',5,3)
			ThisForm.txtCW6.Value	= PrepareSQLnum(ThisForm.txtCW5.Value,'CW',3,1)
			ThisForm.chkAnn6.Value	= ThisForm.chkAnn5.Value
			
