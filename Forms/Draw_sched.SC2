	PROCEDURE txtCW1.Valid
		PRIVATE nDia0, nDia1, nCW
		nDia0 = PrepareSQLnum(ThisForm.txtStartDia.Value,'StratDia',5,3)
		nDia1 = PrepareSQLnum(ThisForm.txtDia1.Value,'Dia',5,3)
		nCW	  = PrepareSQLnum(This.Value,'CW',3,1)
		
		IF nDia0 > 0 AND nDia1 = 0 AND nCW > 0
			*CW = (nA1-nA2)/nA1 * 100
			*CW/100 = (nA1-nA2)/nA1
			*nA1*CW/100 = nA1-nA2
			*nA1*CW/100 - nA1 = -nA2
			*nA2 = nA1*CW/100 + nA1 
			
			*nDia1*nDia1 = nDia0*nDia0*nCW/100 - (nDia0*nDia0)
			nDia1 = SQRT((nDia0*nDia0) - (nDia0*nDia0*nCW)/100 )
			ThisForm.txtDia1.Value = PrepareSQLnum(nDia1,'Dia',5,3)
			
		ENDIF
			
		ThisForm.CalcAll()
		
	ENDPROC

	PROCEDURE txtCW1.When
		RETURN ThisForm.IsEditing
	ENDPROC

