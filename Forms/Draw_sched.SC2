	PROCEDURE backcolor_dia
		PARAMETERS nD1, nD2
		
		IF nD1 = 0
			RETURN RGB(255,255,255) &&White
		ELSE
		
			IF nD1 > nD2
				RETURN RGB(255,255,255) &&White
			ELSE
				RETURN RGB(240,0,0) &&Red
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE calcall
		*ThisForm.CalcAll()
		
		PRIVATE nStartDia, nDia1, nDia2, nDia3, nDia4, nDia5, nDia6, nDia7, nDia8, nDia9
		nStartDia = PrepareSQLnum(ThisForm.txtStartDia.Value,'StartDia',4,3)
		nDia1 = PrepareSQLnum(ThisForm.txtDia1.Value,'Dia',4,3)
		nDia2 = PrepareSQLnum(ThisForm.txtDia2.Value,'Dia',4,3)
		nDia3 = PrepareSQLnum(ThisForm.txtDia3.Value,'Dia',4,3)
		nDia4 = PrepareSQLnum(ThisForm.txtDia4.Value,'Dia',4,3)
		nDia5 = PrepareSQLnum(ThisForm.txtDia5.Value,'Dia',4,3)
		nDia6 = PrepareSQLnum(ThisForm.txtDia6.Value,'Dia',4,3)
		nDia7 = PrepareSQLnum(ThisForm.txtDia7.Value,'Dia',4,3)
		nDia8 = PrepareSQLnum(ThisForm.txtDia8.Value,'Dia',4,3)
		nDia9 = PrepareSQLnum(ThisForm.txtDia9.Value,'Dia',4,3)
		
		
		ThisForm.txtStartDia.BackColor = ThisForm.BackColor_Dia(nStartDia,nDia1)
		ThisForm.txtDia1.BackColor = ThisForm.BackColor_Dia(nDia1,nDia2)
		ThisForm.txtDia2.BackColor = ThisForm.BackColor_Dia(nDia2,nDia3)
		ThisForm.txtDia3.BackColor = ThisForm.BackColor_Dia(nDia3,nDia4)
		ThisForm.txtDia4.BackColor = ThisForm.BackColor_Dia(nDia4,nDia5)
		ThisForm.txtDia5.BackColor = ThisForm.BackColor_Dia(nDia5,nDia6)
		ThisForm.txtDia6.BackColor = ThisForm.BackColor_Dia(nDia6,nDia7)
		ThisForm.txtDia7.BackColor = ThisForm.BackColor_Dia(nDia7,nDia8)
		ThisForm.txtDia8.BackColor = ThisForm.BackColor_Dia(nDia8,nDia9)
		ThisForm.txtDia9.BackColor = ThisForm.BackColor_Dia(nDia9,0)
		
		
		PRIVATE nAng1, nAng2, nAng3, nAng4, nAng5, nAng6, nAng7, nAng8, nAng9
		nAng1 = PrepareSQLnum(ThisForm.txtAng1.Value,'Angle',-1)
		nAng2 = PrepareSQLnum(ThisForm.txtAng2.Value,'Angle',-1)
		nAng3 = PrepareSQLnum(ThisForm.txtAng3.Value,'Angle',-1)
		nAng4 = PrepareSQLnum(ThisForm.txtAng4.Value,'Angle',-1)
		nAng5 = PrepareSQLnum(ThisForm.txtAng5.Value,'Angle',-1)
		nAng6 = PrepareSQLnum(ThisForm.txtAng6.Value,'Angle',-1)
		nAng7 = PrepareSQLnum(ThisForm.txtAng7.Value,'Angle',-1)
		nAng8 = PrepareSQLnum(ThisForm.txtAng8.Value,'Angle',-1)
		nAng9 = PrepareSQLnum(ThisForm.txtAng9.Value,'Angle',-1)
		
		PRIVATE lAnneal
		PRIVATE lAnn1, lAnn2, lAnn3, lAnn4, lAnn5, lAnn6, lAnn7, lAnn8, lAnn9
		lAnn1 = PrepareSQLlogic(ThisForm.chkAnn1.Value,'Ann')
		lAnn2 = PrepareSQLlogic(ThisForm.chkAnn2.Value,'Ann')
		lAnn3 = PrepareSQLlogic(ThisForm.chkAnn3.Value,'Ann')
		lAnn4 = PrepareSQLlogic(ThisForm.chkAnn4.Value,'Ann')
		lAnn5 = PrepareSQLlogic(ThisForm.chkAnn5.Value,'Ann')
		lAnn6 = PrepareSQLlogic(ThisForm.chkAnn6.Value,'Ann')
		lAnn7 = PrepareSQLlogic(ThisForm.chkAnn7.Value,'Ann')
		lAnn8 = PrepareSQLlogic(ThisForm.chkAnn8.Value,'Ann')
		lAnn9 = PrepareSQLlogic(ThisForm.chkAnn9.Value,'Ann')
		
		IF lAnn1=.T. OR lAnn2=.T. OR lAnn3=.T. OR lAnn4=.T. OR lAnn5=.T. OR lAnn6=.T. OR lAnn7=.T. OR lAnn8=.T. OR lAnn9=.T. 
			lAnneal  = .T.
		ELSE
			lAnneal  = .F.
		ENDIF
		
		
		PRIVATE nCW1,nCW2,nCW3,nCW4,nCW5,nCW6,nCW7,nCW8,nCW9
		nCW1 = Reduction_of_Area_D(nStartDia,nDia1)*100
		*nCW1 = ThisForm.CalcCW(nStartDia,nDia1)
		ThisForm.txtCW1.Value = ROUND(nCW1,1)
		nCW2 = Reduction_of_Area_D(nDia1,nDia2)*100
		ThisForm.txtCW2.Value = ROUND(nCW2,1)
		nCW3 = Reduction_of_Area_D(nDia2,nDia3)*100
		ThisForm.txtCW3.Value = ROUND(nCW3,1)
		nCW4 = Reduction_of_Area_D(nDia3,nDia4)*100
		ThisForm.txtCW4.Value = ROUND(nCW4,1)
		nCW5 = Reduction_of_Area_D(nDia4,nDia5)*100
		ThisForm.txtCW5.Value = ROUND(nCW5,1)
		nCW6 = Reduction_of_Area_D(nDia5,nDia6)*100
		IF nCW6 = 100
			? nCW6
		ENDIF
		ThisForm.txtCW6.Value = ROUND(nCW6,1)
		nCW7 = Reduction_of_Area_D(nDia6,nDia7)*100
		ThisForm.txtCW7.Value = ROUND(nCW7,1)
		nCW8 = Reduction_of_Area_D(nDia7,nDia8)*100
		ThisForm.txtCW8.Value = ROUND(nCW8,1)
		nCW9 = Reduction_of_Area_D(nDia8,nDia9)*100
		ThisForm.txtCW9.Value = ROUND(nCW9,1)
		
		PRIVATE nRA1, nRA2, nRA3, nRA4, nRA5, nRA6, nRA7, nRA8, nRA9
		PRIVATE nBegDia
		nBegDia = nStartDia
		nRA1 = Reduction_of_Area_D(nBegDia,nDia1)*100
		IF lAnn1 
			nBegDia = nDia1
		ENDIF
		nRA2 = Reduction_of_Area_D(nBegDia,nDia2)*100
		IF lAnn2 
			nBegDia = nDia2
		ENDIF
		nRA3 = Reduction_of_Area_D(nBegDia,nDia3)*100
		IF lAnn3 
			nBegDia = nDia3
		ENDIF
		nRA4 = Reduction_of_Area_D(nBegDia,nDia4)*100
		IF lAnn4 
			nBegDia = nDia4
		ENDIF
		nRA5 = Reduction_of_Area_D(nBegDia,nDia5)*100
		IF lAnn5 
			nBegDia = nDia5
		ENDIF
		nRA6 = Reduction_of_Area_D(nBegDia,nDia6)*100
		IF lAnn6 
			nBegDia = nDia6
		ENDIF
		nRA7 = Reduction_of_Area_D(nBegDia,nDia7)*100
		IF lAnn7 
			nBegDia = nDia7
		ENDIF
		nRA8 = Reduction_of_Area_D(nBegDia,nDia8)*100
		IF lAnn8 
			nBegDia = nDia8
		ENDIF
		nRA9 = Reduction_of_Area_D(nBegDia,nDia9)*100
		
		*IF lAnn9
		*	nBegDia = nDia9
		*	nRA9 = Reduction_of_Area_D(nBegDia,nDia9)
		*ENDIF
		
		
		
		
		ThisForm.lblRA1.Caption = ''
		ThisForm.lblRA2.Caption = ''
		ThisForm.lblRA3.Caption = ''
		ThisForm.lblRA4.Caption = ''
		ThisForm.lblRA5.Caption = ''
		ThisForm.lblRA6.Caption = ''
		ThisForm.lblRA7.Caption = ''
		ThisForm.lblRA8.Caption = ''
		ThisForm.lblRA9.Caption = ''
		
		ThisForm.lblRATot.Caption = ''
		
		IF nStartDia > 0
			IF nDia1 > 0 
				ThisForm.lblRA1.Caption = STR(nRA1,4,1)
			ENDIF
			IF nDia2 > 0 
				ThisForm.lblRA2.Caption = STR(nRA2,4,1)
			ENDIF
			IF nDia3 > 0 
				ThisForm.lblRA3.Caption = STR(nRA3,4,1)
			ENDIF
			IF nDia4 > 0 
				ThisForm.lblRA4.Caption = STR(nRA4,4,1)
			ENDIF
			IF nDia5 > 0 
				ThisForm.lblRA5.Caption = STR(nRA5,4,1)
			ENDIF
			IF nDia6 > 0 
				ThisForm.lblRA6.Caption = STR(nRA6,4,1)
			ENDIF
			IF nDia7 > 0 
				ThisForm.lblRA7.Caption = STR(nRA7,4,1)
			ENDIF
			IF nDia8 > 0 
				ThisForm.lblRA8.Caption = STR(nRA8,4,1)
			ENDIF
			IF nDia9 > 0 
				ThisForm.lblRA9.Caption = STR(nRA9,4,1)
			ENDIF
			***
			
			
			PRIVATE nRA_Total
		*	nRA_Total = ThisForm.Calc_RA_tot(nStartDia, nDia1, nDia2, nDia3, nDia4, nDia5, nDia6, nDia7, nDia8, nDia9) * 100
			nRA_Total = 0
			nBeginDia = nStartDia
			
			IF nDia9 > 0
				nRA_Total = Reduction_of_Area_D(nStartDia,nDia9)*100
			ELSE
				IF nDia8 > 0
					nRA_Total = Reduction_of_Area_D(nStartDia,nDia8)*100
				ELSE
					IF nDia7 > 0
						nRA_Total = Reduction_of_Area_D(nStartDia,nDia7)*100
					ELSE
						IF nDia6 > 0
							nRA_Total = Reduction_of_Area_D(nStartDia,nDia6)*100
						ELSE
							IF nDia5 > 0
								nRA_Total = Reduction_of_Area_D(nStartDia,nDia5)*100
							ELSE
								IF nDia4 > 0
									nRA_Total = Reduction_of_Area_D(nStartDia,nDia4)*100
								ELSE
									IF nDia3 > 0
										nRA_Total = Reduction_of_Area_D(nStartDia,nDia3)*100
									ELSE
										IF nDia2 > 0
											nRA_Total = Reduction_of_Area_D(nStartDia,nDia2)*100
										ELSE
											IF nDia1 > 0
												nRA_Total = Reduction_of_Area_D(nStartDia,nDia1) *100
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			
			ThisForm.lblRATot.Caption = STR(nRA_Total,4,1)
		
		ELSE
		
			
		ENDIF
		
		
	ENDPROC

	PROCEDURE calccw		&& Calc CW Percentage
		PARAMETERS nD1, nD2
		*ThisForm.CalcCW(Beg,End)
		*PROC Reduction_of_Area_D(D1,D2)
		
		IF nD1 = 0
			RETURN 0
		ELSE
			IF nD1 > nD2 AND nD2 > 0
				PRIVATE nA1, nA2
				nA1 = nD1*nD1
				nA2 = nD2*nD2
				RETURN (nA1-nA2)/nA1 * 100
			ELSE
				RETURN 0
			ENDIF
		ENDIF
	ENDPROC

	PROCEDURE calc_delta
		PARAMETERS nDia0, nDia1, nAngle
		*ThisForm.Calc_Delta()
		
		PRIVATE nDelta
		
	ENDPROC

	PROCEDURE calc_ra_tot		&& Calc_RA_tot
		PARAMETERS nStartDia, nDia1, nDia2, nDai3, nDia4, nDia5, nDia6, nDia7, nDia8, nDia9, lAnneal  
		*ThisForm.Calc_RA_Tot()
		
		PRIVATE nBeginDia
		
		IF nStartDia > 0
			nBeginDia = nStartDia
		ELSE
			RETURN 0
		ENDIF
		*Work backwards, use highest Dia and return Beg-End/Beg
		IF nDia9 > 0
			RETURN (nBeginDia - nDia9 ) / nBeginDia 
		ENDIF
		IF nDia8 > 0
			RETURN (nBeginDia - nDia8 ) / nBeginDia 
		ENDIF
		IF nDia7 > 0
			RETURN (nBeginDia - nDia7 ) / nBeginDia 
		ENDIF
		IF nDia6 > 0
			RETURN (nBeginDia - nDia6 ) / nBeginDia 
		ENDIF
		IF nDia5 > 0
			RETURN (nBeginDia - nDia5 ) / nBeginDia 
		ENDIF
		IF nDia4 > 0
			RETURN (nBeginDia - nDia4 ) / nBeginDia 
		ENDIF
		IF nDia3 > 0
			RETURN (nBeginDia - nDia3 ) / nBeginDia 
		ENDIF
		IF nDia2 > 0
			RETURN (nBeginDia - nDia2 ) / nBeginDia 
		ENDIF
		IF nDia1 > 0
			RETURN (nBeginDia - nDia1 ) / nBeginDia 
		ENDIF
		
		RETURN 0
	ENDPROC

	PROCEDURE checksave
		*ThisForm.CheckSave()
		PRIVATE nStartDia, nDia1, nDia2, nDia3, nDia4, nDia5, nDia6, nDia7, nDia8, nDia9
		nStartDia = PrepareSQLnum(ThisForm.txtStartDia.Value,'StartDia',4,3)
		nDia1 = PrepareSQLnum(ThisForm.txtDia1.Value,'Dia',4,3)
		nDia2 = PrepareSQLnum(ThisForm.txtDia2.Value,'Dia',4,3)
		nDia3 = PrepareSQLnum(ThisForm.txtDia3.Value,'Dia',4,3)
		nDia4 = PrepareSQLnum(ThisForm.txtDia4.Value,'Dia',4,3)
		nDia5 = PrepareSQLnum(ThisForm.txtDia5.Value,'Dia',4,3)
		nDia6 = PrepareSQLnum(ThisForm.txtDia6.Value,'Dia',4,3)
		nDia7 = PrepareSQLnum(ThisForm.txtDia7.Value,'Dia',4,3)
		nDia8 = PrepareSQLnum(ThisForm.txtDia8.Value,'Dia',4,3)
		nDia9 = PrepareSQLnum(ThisForm.txtDia9.Value,'Dia',4,3)
		
		PRIVATE nAng1, nAng2, nAng3, nAng4, nAng5, nAng6, nAng7, nAng8, nAng9
		nAng1 = PrepareSQLnum(ThisForm.txtAng1.Value,'Angle',-1)
		nAng2 = PrepareSQLnum(ThisForm.txtAng2.Value,'Angle',-1)
		nAng3 = PrepareSQLnum(ThisForm.txtAng3.Value,'Angle',-1)
		nAng4 = PrepareSQLnum(ThisForm.txtAng4.Value,'Angle',-1)
		nAng5 = PrepareSQLnum(ThisForm.txtAng5.Value,'Angle',-1)
		nAng6 = PrepareSQLnum(ThisForm.txtAng6.Value,'Angle',-1)
		nAng7 = PrepareSQLnum(ThisForm.txtAng7.Value,'Angle',-1)
