	PROCEDURE Destroy
		IF USED('tmp_DS')
			USE IN tmp_DS
		ENDIF
		
		
		*!*	IF ThisForm.OpenedERPCert AND DBUSED('ERPCert')
		*!*		SET DATABASE TO ERPCert
		*!*		CLOSE DATABASES 
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE Init
		PARAMETERS pID, pMach, pLot
		
		PRIVATE nID,cMach,nLot
		nID = PrepareSQLnum(pID,'ID',-3)
		cMach = PrepareSQLtxt(pMach,'Machine',10)
		nLot = PrepareSQLnum(pLot,'Lot',-3)
		
		
		ThisForm.init_form9()
		
		ThisForm.Load_Log(nID)
		*CALLS ThisForm.Refresh_Log()
		
		IF nID = 0
			*try Machine Lot
			IF nLot > 0 AND LEN(cMach)>1
				LOCATE FOR Machine = cMach AND Lot = nLot
				IF FOUND()
					ThisForm.Refresh_Log()
				ELSE
					MESSAGEBOX("Cound not find Machine "+cMach+CHR(13)+" Lot:"+ALLTRIM(STR(nLot))+CHR(13)+"Please create.",0,"Not found")
					GO TOP
					*IF MESSAGEBOX("Do you want to Add?
					*save for when user is ready to create a Schedule
					ThisForm.cMach = cMach
					ThisForm.nLot = nLot
				ENDIF
			ENDIF
		ENDIF
		
		
	ENDPROC

