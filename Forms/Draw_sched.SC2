	PROCEDURE cmdEdit.Click
		IF This.Caption = 'Edit'
			ThisForm.IsEditing = .T.
			ThisForm.cmdAdd.Visible = .F.
			ThisForm.cmdAddCopy.Visible = .F.
			
			ThisForm.cmdSave.Visible = .T.
			ThisForm.cmdSaveCopy.Visible = .T.
			ThisForm.cmdPrint.Visible = .F.
			
			ThisForm.cmbFinishM.Enabled = .T.
			ThisForm.txtFinishLot.Enabled = .T.
			ThisForm.cmdReturn.Enabled = .F.
			
			ThisForm.Refresh_Log()
			*CALLS:ThisForm.CalcAll()
			This.Caption = 'Abort'
			
			ThisForm.txtStartDia.Setfocus()
		ELSE
			*This.Caption = 'Abort'
			ThisForm.IsAdding = .F.
			ThisForm.IsEditing = .F.
		
			ThisForm.cmdAdd.Visible = .T.
			ThisForm.cmdAddCopy.Visible = .T.
			ThisForm.cmdSave.Visible = .F.	
			ThisForm.cmdSaveCopy.Visible = .F.
			ThisForm.cmdPrint.Visible = .T.
		
			ThisForm.cmbFinishM.Enabled = .F.
			ThisForm.txtFinishLot.Enabled = .F.
			ThisForm.cmdReturn.Enabled = .T.
			
			This.Caption = 'Edit'
			
			ThisForm.Load_Log(-1)
		ENDIF
	ENDPROC

	PROCEDURE cmdFinishshow.Click
		PRIVATE cMach, nLot, cLot, cAlloy,nfThick 
		cMach 	= PrepareSQLtxt(ThisForm.cmbFinishM.Value,'Mach',20)
		nLot	= PrepareSQLnum(ThisForm.txtFinishLot.Value,'Lot',-3)
		cLot	= PrepareSQLtxt(ThisForm.txtFinishLot.Value,'Lot',10)
		*cAlloy	= PrepareSQLtxt(ThisForm.txtfAlloy.Value,'Alloy',12)
		*nfThick = PrepareSQLnum(ThisForm.txtfThck.Value,'Thck',10,4)
		
		IF EMPTY(cMach)
			MESSAGEBOX("You must Declare the Maching before inserting a new LOT",16,"Unknown machine")
			RETURN .F.
		ENDIF
		*!*	IF nfThick=0 OR EMPTY(cAlloy)
		*!*		MESSAGEBOX("Please fill in more the 'Finish' WO_Detail so a good insert log can be made.",16,"Unknown machine")
		*!*		RETURN .F.
		*!*	ENDIF
		
		DO CASE
		*Conversion_Log
		*Draw_Log
		CASE UPPER(LEFT(cMach,1)) = "D"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAD",cLot)+3))
		*GFMLog
		CASE UPPER(LEFT(cMach,1)) = "G"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAG",cLot)+3))
		*HT_Lot
		*LakeErie_log
		CASE UPPER(LEFT(cMach,1)) = "L"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAL",cLot)+3))
		*Roll_log
		CASE UPPER(LEFT(cMach,1)) = "R"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAR",cLot)+3))
		*Swage_log	
		CASE UPPER(LEFT(cMach,1)) = "S"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAS",cLot)+3))
		*Wire_log
		CASE UPPER(LEFT(cMach,1)) = "W"
			cLot = RIGHT( cLot , LEN(cLot)-(AT("HPAW",cLot)+3))
		OTHERWISE
			MESSAGEBOX("Unknown Machine",16,"Unknown machine")
			RETURN .F.
		ENDCASE
		
		
		PRIVATE loHyperlink,m.cHyperLink
		m.cHyperLink = HTML_MFG_Log(cMach,nLot,.T.)
		
		IF NOT EMPTY(m.cHyperLink)
			loHyperlink = CREATEOBJECT("Hyperlink")
			loHyperlink.navigateto(m.cHyperLink)
			RELEASE loHyperlink
		ELSE
			WAIT WINDOW "No Report to display" NOWAIT
		ENDIF
		
		
		
		
	ENDPROC

	PROCEDURE cmdPrint.Click
		SELECT tmp_DS
		PRIVATE nID
		nID = tmp_DS.ID
		
		IF nID > 0
		
			SELECT 0
			SELECT * FROM tmp_DS WHERE ID = nID INTO CURSOR Draw_Sched
		
			IF RECCOUNT('Draw_Sched') > 0
			
				IF NOT "PROC_DRAW" $ SET("PROCEDURE")  &&Added for when Quotes is run without ERP menu.
					SET PROCEDURE TO Progs\Proc_Draw ADDITIVE
				ENDIF
				
				*REPORT FORM "c:\program files (x86)\hpa\reports\draw_sched.frx"  FOR ID=nID
				REPORT FORM reports\draw_sched PreView
				*REPORT FORM reports\draw_sched NOCONSOLE TO PRINTER PROMPT
				
				USE IN Draw_Sched
				SELECT tmp_DS
			ENDIF
		ENDIF
		
		
		*NOT NULL(Ang1 +Ang2 +Ang3 +Ang4 +Ang5 +Ang6 +Ang7 +Ang8 +Ang9)
	ENDPROC

